//! `ply hash` — every definition and test under the hash content addressing keys it by, grouped by
//! the module that declares it. The grouping is the one thing here that could be mistaken for part
//! of a hash, so the listing says it is not.

import env (env)
import compiler.unit (shipped)
import std.random (entropy)
import std.time (time)
import builder (builder)
import args (Flags, style_of)
import program (Program, ModuleView, Tables, load_program, published, tables_of, modules_of,
                deps_of, closure_of, hash_of, short_of, own_tests)
import report (Answer, ok_code, count_of, indent, refused)
import std.term (Style, bold, dim, plain)
import compiler.front (View)
import compiler.hash (TheFn, TheItem, Which, hex, no_hashes, no_refs)
import compiler.infer (DefInfo, TestInfo)
import std.fs (fs)
import std.json (Json, Null, Str, Bool, Number, Array, object, string_or_null, strings)
import sources (File)
import std.string (join)

pub fn note() -> String =
  "module names, imports and `pub` are erased by normalization: moving a definition between modules changes no hash"

fn blank() -> String = "------------"

fn edges(
  tables: Tables,
  deps: Bool,
  which: Which,
  entry: List<{ key: String, value: Json }>,
) -> List<{ key: String, value: Json }> / {abort.raise} =
  if !deps { entry } else {
    push(push(entry, { key: "deps", value: strings(deps_of(tables, which)) }), {
      key: "closure",
      value: strings(closure_of(tables, which)),
    })
  }

fn definition_json(tables: Tables, deps: Bool, def_info: DefInfo) -> Json / {abort.raise} = {
  let hash = hash_of(tables, def_info.name);
  object(
    edges(tables, deps, TheFn(def_info.name), [
      { key: "name", value: Str(string_of_bytes_lossy(def_info.name)) },
      { key: "module", value: Str(string_of_bytes_lossy(def_info.module)) },
      { key: "simple_name", value: Str(string_of_bytes_lossy(def_info.simple_name)) },
      { key: "hash", value: string_or_null(hash) },
      {
        key: "short",
        value: string_or_null(match hash { Some(h) -> Some(short_of(h)), None -> None }),
      },
    ]),
  )
}

fn test_hash(analysis: View, index: Int) -> Option<String> / {abort.raise} =
  match list_at(analysis.hashes.tests, index) {
    Some(h) -> Some(string_of_bytes_lossy(hex(h))),
    None -> None,
  }

fn test_json(
  analysis: View,
  tables: Tables,
  deps: Bool,
  test_info: TestInfo,
) -> Json / {abort.raise} =
  object(
    edges(tables, deps, TheItem(test_info.key), [
      { key: "index", value: Number(decimal_of_int(test_info.index)) },
      { key: "key", value: Str(string_of_bytes_lossy(test_info.key)) },
      { key: "name", value: Str(string_of_bytes_lossy(test_info.name)) },
      { key: "module", value: Str(string_of_bytes_lossy(test_info.module)) },
      { key: "hash", value: string_or_null(test_hash(analysis, test_info.index)) },
    ]),
  )

fn module_json(mo: ModuleView) -> Json =
  object([{ key: "name", value: Str(mo.name) }, { key: "file", value: Str(mo.path) }])

// --- The listing ------------------------------------------------------------

fn edge_lines(
  style: Style,
  tables: Tables,
  which: Which,
  lines: List<String>,
) -> List<String> / {abort.raise} = {
  let named = deps_of(tables, which);
  let reached = closure_of(tables, which);
  let with_deps = if len(named) == 0 { lines } else {
    push(lines, indent() ++ "                " ++ dim(style, "deps:") ++ " " ++ join(named, ", "))
  };
  if len(reached) == 0 { with_deps } else {
    push(
      with_deps,
      indent() ++ "                " ++ dim(style, "closure:") ++ " " ++ join(reached, ", "),
    )
  }
}

fn quoted(name: String) -> String = "\"" ++ name ++ "\""

fn def_lines(
  style: Style,
  tables: Tables,
  deps: Bool,
  lines: List<String>,
  def_info: DefInfo,
) -> List<String> / {abort.raise} = {
  let hash = match hash_of(tables, def_info.name) { Some(h) -> short_of(h), None -> blank() };
  let said = push(
    lines,
    indent() ++ "  " ++ dim(style, hash) ++ "  " ++ string_of_bytes_lossy(def_info.simple_name),
  );
  if deps { edge_lines(style, tables, TheFn(def_info.name), said) } else { said }
}

fn test_lines(
  style: Style,
  analysis: View,
  tables: Tables,
  deps: Bool,
  lines: List<String>,
  test_info: TestInfo,
) -> List<String> / {abort.raise} = {
  let hash = match test_hash(analysis, test_info.index) { Some(h) -> short_of(h), None -> blank() };
  let said = push(
    lines,
    indent() ++ "  " ++ dim(style, hash) ++ "  " ++ dim(style, "test") ++ " "
      ++ quoted(string_of_bytes_lossy(test_info.name)),
  );
  if deps { edge_lines(style, tables, TheItem(test_info.key), said) } else { said }
}

fn module_lines(
  style: Style,
  analysis: View,
  tables: Tables,
  deps: Bool,
  defs: List<DefInfo>,
  tests: List<TestInfo>,
  lines: List<String>,
  mo: ModuleView,
) -> List<String> / {abort.raise} = {
  let head = push(push(lines, ""), indent() ++ bold(style, mo.name) ++ " " ++ dim(style, mo.path));
  let mine = filter(defs, |def_info: DefInfo| string_of_bytes_lossy(def_info.module) == mo.name);
  let after_defs = fold(mine, head, |acc: List<String>, def_info: DefInfo|
    def_lines(style, tables, deps, acc, def_info));
  let its_tests = filter(tests, |test_info: TestInfo|
    string_of_bytes_lossy(test_info.module) == mo.name);
  fold(its_tests, after_defs, |acc: List<String>, test_info: TestInfo|
    test_lines(style, analysis, tables, deps, acc, test_info))
}

fn tally(style: Style, analysis: View, defs: Int, tests: Int) -> List<String> / {abort.raise} = {
  let modules = len(analysis.outlines);
  [
    "",
    indent() ++ count_of(defs, "definition") ++ " · " ++ count_of(tests, "test") ++ " · "
      ++ count_of(modules, "module"),
    indent() ++ dim(style, note()),
  ]
}

fn answered(
  style: Style,
  flags: Flags,
  program: Program,
  analysis: View,
) -> Answer / {abort.raise} = {
  let tables: Tables = tables_of(analysis.hashes);
  let defs = published(analysis);
  let views = modules_of(program, analysis);
  let own = own_tests(program, analysis);
  let listed = fold(views, [], |acc: List<String>, mo: ModuleView|
    module_lines(style, analysis, tables, flags.deps, defs, own, acc, mo));
  {
    json: object([
      { key: "command", value: Str("hash") },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
      { key: "root", value: Str(flags.root) },
      { key: "files", value: Array(map(program.files, |file: File| Str(file.path))) },
      { key: "modules", value: Array(map(views, module_json)) },
      { key: "module_is_hashed", value: Bool(false) },
      { key: "note", value: Str(note()) },
      {
        key: "definitions",
        value: Array(map(defs, |def_info: DefInfo| definition_json(tables, flags.deps, def_info))),
      },
      {
        key: "tests",
        value: Array(
          map(own, |test_info: TestInfo| test_json(analysis, tables, flags.deps, test_info)),
        ),
      },
      { key: "diagnostics", value: Array([]) },
    ]),
    lines: fold(
      tally(style, analysis, len(analysis.hashes.defs), len(own)),
      listed,
      |acc: List<String>, l: String| push(acc, l),
    ),
    errs: [],
    code: ok_code(),
  }
}

pub fn run(
  flags: Flags,
) -> Answer / {shipped.answer, env.reused[sys], builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise, diverges, shipped.reached} = {
  let loaded: Program = load_program(flags.paths);
  match loaded.view {
    None -> refused(style_of(flags), "hash", loaded.diags, loaded.places),
    Some(w) -> answered(style_of(flags), flags, loaded, w),
  }
}

// --- Tests ------------------------------------------------------------------

/// `m.two` calling `m.one`, and an effect `m.one` nothing performs.
fn a_table() -> Tables =
  {
    defs: map_new(),
    own: map_new(),
    specs: map_new(),
    hashes: {
      ..no_hashes(),
      refs: {
        ..no_refs(),
        names: [b"m.one", b"m.two", b"m.one"],
        decls: [false, false, true],
        edges: [[], [0], []],
        fns: map_of_entries([{ key: b"m.one", value: 0 }, { key: b"m.two", value: 1 }]),
        declared: map_of_entries([{ key: b"m.one", value: [2] }]),
      },
    },
  }

test "the note names what the grouping is not" {
  assert(string_contains(note(), "changes no hash"));
  assert_eq(blank(), "------------")
}

test "a name list is comma-separated, as the listing prints it" {
  assert_eq(join([], ", "), "");
  assert_eq(join(["m.one"], ", "), "m.one");
  assert_eq(join(["m.one", "m.two"], ", "), "m.one, m.two")
}

test "`--deps` adds the references and the closure, the definition's own and not its namesake's" {
  let line = |which: Which| map(edge_lines(plain(), a_table(), which, []), string_trim);
  assert_eq(line(TheFn(b"m.two")), ["deps: m.one", "closure: m.one, m.two"]);
  assert_eq(line(TheFn(b"m.one")), ["closure: m.one"]);
  assert_eq(line(TheFn(b"m.absent")), [])
}

test "a test is listed under its quoted name" { assert_eq(quoted("two is two"), "\"two is two\"") }
