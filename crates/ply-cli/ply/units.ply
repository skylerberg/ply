//! A program made into the unit the runtime enters. The emitter's answers kept between runs are
//! read from the toolchain's cache, the rest are asked of the emitter here, in this program, and the
//! C is assembled over all of them and compiled here into a library: the runtime is handed the
//! library and compiles nothing.

import compiler.front (BakedRow)
import compiler.load (every_root, LoadedAnalysis)
import compiler.resolve (Diag, error_at)
import compiler.cc
import compiler.cc (compilers, toolchain, TooWide)
import compiler.parsing (no_module, dummy_span)
import compiler.unit (Baked, Dropped, Emission, Made, shipped, baked_key, emitted, emitter_identity,
                      held, kept_value, read_kept, write_kept)
import env (env)
import sources
import std.fs (fs)
import std.process (process)
import std.random (entropy)
import std.time (time)
import std.path (below_root)

/// A unit's C, and what it was made of, which says what each root runs.
pub type Emitted = { text: Bytes, made: Made }

/// A command asks for the unit a run enters, and for the library its C compiles into; what answers
/// is `emitting`'s, which `main` runs every command under, or a handler of the asker's own. The C
/// is a function of what is asked, and the library of the C and the compiler, so the effect is a
/// deterministic one, whatever the answering keeps.
pub effect emit {
  read unit(front: LoadedAnalysis, offered: List<Bytes>) -> Result<Emitted, List<Diag>>
  /// The library `text`, a unit's C, compiles into under `profile`, `development` or `release`:
  /// its path, which the runtime opens.
  read compiled(text: Bytes, profile: String) -> Result<String, List<Diag>>
}

fn emitted_of(
  front: LoadedAnalysis,
  offered: List<Bytes>,
  emission: Result<Emission, Bytes>,
) -> Result<Emitted, List<Diag>> / {abort.raise} =
  match held(front.dump, offered, emission) {
    Err(diags) -> Err(diags),
    Ok(text) ->
      Ok({
        text: text,
        made: match emission { Ok(e) -> e.produced.made, Err(_) -> { bodies: [], offered: [] } },
      }),
  }

/// What emitting a unit here reaches: the runtime it is compiled against, this program's own
/// definitions, the emitter's among them, the answers and objects kept between runs under the
/// toolchain's cache, the compilers, and what the environment asks to be told of it.
pub effect set Emits = {shipped.runtime, shipped.definitions, env.bodies[sys], env.var[sys], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, time.elapsed_ms, process.err[proc], compilers.read[cc], compilers.write[cc], compilers.read[tcc], compilers.write[tcc], toolchain.read, toolchain.write}

fn kept_dir() -> String / {env.bodies[sys], abort.raise} = below_root(env.bodies[sys]())

fn texts(front: LoadedAnalysis) -> List<Bytes> =
  front.files.map(|f: { path: String, name: String, text: Bytes }| f.text)

/// What a developer asks of emission through the environment: `PLY_C_ONLY` and `PLY_C_SKIP` narrow
/// what is offered, `PLY_C_REFUSALS` says what the unit took and refused, and `PLY_C_PHASES` what
/// the emitter was asked and what was read back.
type Knobs = { only: Option<List<String>>, skip: List<String>, refusals: Bool, phases: Bool }

fn listed(text: String) -> List<String> = text.split(",").filter(|s: String| s != "")

fn knobs() -> Knobs / {env.var[sys]} =
  {
    only: match env.var[sys]("PLY_C_ONLY") { Some(t) -> Some(listed(t)), None -> None },
    skip: match env.var[sys]("PLY_C_SKIP") { Some(t) -> listed(t), None -> [] },
    refusals: env.var[sys]("PLY_C_REFUSALS") != None,
    phases: env.var[sys]("PLY_C_PHASES") != None,
  }

/// `offered` with only the definitions `PLY_C_ONLY` names, and none under a prefix `PLY_C_SKIP` names.
fn narrowed(k: Knobs, offered: List<Bytes>) -> List<Bytes> / {abort.raise} =
  offered.filter(|n: Bytes| {
    let name = String::of_bytes(n);
    let wanted = match k.only {
      None -> true,
      Some(names) -> names.filter(|w: String| w == name).len() > 0,
    };
    wanted && k.skip.filter(|prefix: String| name.starts_with(prefix)).len() == 0
  })

fn told(
  k: Knobs,
  offered: Int,
  emission: Result<Emission, Bytes>,
  identity: Bytes,
  ms: Int,
) -> Unit / {process.err[proc], abort.raise} =
  match emission {
    Err(_) -> (),
    Ok(e) -> {
      if k.refusals {
        e.produced.dropped.fold((), |_: Unit, d: Dropped|
          process.err[proc](
            "C backend refused `" ++ String::of_bytes(d.function) ++ "`: "
              ++ String::of_bytes(d.construct),
          ));
        process.err[proc](
          "C backend took " ++ e.produced.taken.len().to_string() ++ " of " ++ offered.to_string()
            ++ " definitions",
        )
      };
      if k.phases {
        process.err[proc](
          "phases: emitter " ++ String::of_bytes(identity) ++ ", " ++ e.kept.to_string()
            ++ " answers read back, "
            ++ e.asked.to_string()
            ++ " asked of it, "
            ++ ms.to_string()
            ++ "ms",
        )
      }
    },
  }

// --- What a build kept of a `const` definition -----------------------------------

/// The values kept of the `const` definitions among `wanted`. One with none kept is left to its
/// body, which answers the same: a build keeps each before anything runs, and a program no build
/// kept the values of, a mutant among them, runs without.
fn kept_values(
  rows: List<BakedRow>,
  wanted: List<Bytes>,
  runtime: Bytes,
  emitter: Bytes,
  dir: String,
) -> List<Baked> / {fs.read[abs], fs.write[abs], time.now_ms, abort.raise} =
  if rows.len() == 0 { [] } else {
    let offered = wanted.fold(Map::new(), |acc: Map<Bytes, Bool>, n: Bytes| acc.insert(n, true));
    rows.fold([], |acc: List<Baked>, row: BakedRow|
      if !offered.contains(row.name) { acc } else {
        match kept_value[abs](dir, baked_key(runtime, emitter, row.hash)) {
          Some(text) -> acc.push({ name: row.name, text: text }),
          None -> acc,
        }
      })
  }

/// The unit over `offered`, its C as the runtime compiles it, with the emitter's answers kept under
/// the toolchain's cache.
fn unit_of(
  front: LoadedAnalysis,
  offered: List<Bytes>,
) -> Result<Emitted, List<Diag>> / {shipped.runtime, shipped.definitions, env.bodies[sys], env.var[sys], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, time.elapsed_ms, process.err[proc], abort.raise} = {
  let k = knobs();
  let wanted = narrowed(k, offered);
  let identity = emitter_identity(shipped.definitions());
  let runtime = shipped.runtime();
  let dir = kept_dir();
  let started = time.elapsed_ms();
  let emission = emitted(
    runtime,
    front.dump,
    texts(front),
    front.inputs,
    wanted,
    identity,
    |key: Bytes| read_kept[abs](dir, key),
    |key: Bytes, bytes: Bytes| write_kept[abs](dir, key, bytes),
    kept_values(front.dump.baked, wanted, runtime.identity, identity, dir),
  );
  told(k, wanted.len(), emission, identity, time.elapsed_ms() - started);
  emitted_of(front, wanted, emission)
}

/// A unit's C alone, for whoever only enters it.
pub fn text_of(r: Result<Emitted, List<Diag>>) -> Result<Bytes, List<Diag>> =
  match r { Ok(e) -> Ok(e.text), Err(diags) -> Err(diags) }

/// The whole program's unit, every root it offers, and what it was made of.
pub fn whole_emitted(front: LoadedAnalysis) -> Result<Emitted, List<Diag>> / {emit.unit} =
  emit.unit(front, every_root(front))

/// The whole program's unit, as the runtime compiles it.
pub fn whole(front: LoadedAnalysis) -> Result<Bytes, List<Diag>> / {emit.unit} =
  text_of(whole_emitted(front))

/// The library the whole program's unit compiles into under `profile`, or none for a run that
/// executes nothing.
pub fn wanted(
  front: LoadedAnalysis,
  build: Bool,
  profile: String,
) -> Result<Option<String>, List<Diag>> / {emit.unit, emit.compiled} =
  if !build { Ok(None) } else {
    match whole(front) {
      Err(diags) -> Err(diags),
      Ok(text) -> match library(text, profile) { Ok(l) -> Ok(Some(l)), Err(diags) -> Err(diags) },
    }
  }

/// The library `text` compiles into under `profile`, where there is a text.
pub fn library_of(
  text: Option<Bytes>,
  profile: String,
) -> Result<Option<String>, List<Diag>> / {emit.compiled} =
  match text {
    None -> Ok(None),
    Some(t) -> match library(t, profile) { Ok(l) -> Ok(Some(l)), Err(diags) -> Err(diags) },
  }

/// `body` with every unit it asks for emitted and compiled here, the emitter's answers and the
/// objects kept under the toolchain's cache.
pub fn emitting<a | e>(
  body: () -> a / {emit.unit, emit.compiled | e},
) -> a / {abort.raise, Emits | e} =
  handle {
    body()
  } with {
    emit.unit(front, offered) -> unit_of(front, offered),
    emit.compiled(text, profile) -> compiled_of(text, profile),
  }

/// The library a unit's text compiles into under `profile`.
pub fn library(
  text: Bytes,
  profile: String = "development",
) -> Result<String, List<Diag>> / {emit.compiled} = emit.compiled(text, profile)

/// The library an emitted unit compiles into under `profile`.
pub fn library_over(
  r: Result<Emitted, List<Diag>>,
  profile: String = "development",
) -> Result<String, List<Diag>> / {emit.compiled} =
  match r { Ok(e) -> library(e.text, profile), Err(diags) -> Err(diags) }

// --- Compiling a unit ---------------------------------------------------------------

/// Which compiler a profile compiles with, and at what level.
/// `PLY_C_PROFILE` wins over the flag. `development` compiles fast for code that runs slowly enough:
/// tcc where it is installed, else `cc -O0`; `release` is `cc -O2`. `PLY_CC` names `cc`'s program and
/// is used whatever the profile, and `PLY_CC_OPT` names the level.
fn chosen(profile: String) -> { tcc: Bool, level: String } / {compilers.found[tcc], env.var[sys]} = {
  let release = match env.var[sys]("PLY_C_PROFILE") {
    Some(p) -> p == "release",
    None -> profile == "release",
  };
  let level = match env.var[sys]("PLY_CC_OPT") {
    Some(o) -> o,
    None -> if release { "-O2" } else { "-O0" },
  };
  {
    tcc: !release && env.var[sys]("PLY_CC") == None && compilers.found[tcc]() != None,
    level: level,
  }
}

fn unbuildable(why: String) -> Diag =
  error_at(b"E0450", no_module(), dummy_span(), Bytes::of_string(why), b"", [
    b"the C backend shells out to `cc`; `PLY_CC` names another compiler",
  ])

/// `text` compiled into a library the toolchain's cache keeps: an object for each part not compiled
/// before, and a link where the cache holds none of them together. tcc lays out no veneers, so a unit
/// too wide for its direct calls to span compiles with `cc`.
fn compiled_of(
  text: Bytes,
  profile: String,
) -> Result<String, List<Diag>> / {compilers.read[cc], compilers.write[cc], compilers.read[tcc], compilers.write[tcc], toolchain.read, toolchain.write, env.var[sys], abort.raise} = {
  let choice = chosen(profile);
  let built = if !choice.tcc { cc::library[cc](choice.level, cc::library_flags(), text) } else {
    match cc::library[tcc](choice.level, cc::library_flags(), text, false) {
      Err(TooWide) -> cc::library[cc](choice.level, cc::library_flags(), text),
      by_tcc -> by_tcc,
    }
  };
  match built { Ok(path) -> Ok(path), Err(why) -> Err([unbuildable(cc::why_unbuilt(why))]) }
}
