// A program made into the unit the runtime compiles and enters. The emitter's answers kept between
// runs are read from the toolchain's cache, the rest are asked of the emitter here, in this
// program, and the C is assembled over all of them: the runtime is handed C and compiles nothing
// it was not handed.

import compiler.load (every_root, LoadedAnalysis)
import compiler.resolve (Diag)
import compiler.unit (Dropped, Emission, Made, shipped, emitted, emitter_identity, held, read_kept,
                      write_kept)
import env (env)
import sources (under_abs)
import std.fs (fs)
import std.process (process)
import std.random (entropy)
import std.time (time)

// A unit's C as the runtime compiles it, and what it was made of, which says what each root runs.
pub type Emitted = { text: Bytes, made: Made }

// A command asks for the unit a run enters; what answers is `emitting`'s, which `main` runs every
// command under, or a handler of the asker's own. The C is a function of what is asked, so the
// effect is a deterministic one, whatever the answering keeps.
pub effect emit {
  read unit(front: LoadedAnalysis, offered: List<Bytes>) -> Result<Emitted, List<Diag>>
}

fn emitted_of(
  front: LoadedAnalysis,
  offered: List<Bytes>,
  emission: Result<Emission, Bytes>,
) -> Result<Emitted, List<Diag>> / {abort.raise} =
  match held(front.dump, offered, emission) {
    Err(diags) -> Err(diags),
    Ok(text) ->
      Ok({
        text: text,
        made: match emission { Ok(e) -> e.produced.made, Err(_) -> { bodies: [], offered: [] } },
      }),
  }

// What emitting a unit here reaches: the runtime it is compiled against, this program's own
// definitions, the emitter's among them, the answers kept between runs under the toolchain's cache,
// and what the environment asks to be told of it.
pub effect set Emits = {shipped.runtime, shipped.definitions, env.bodies[sys], env.var[sys], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, time.elapsed_ms, process.err[proc]}

fn kept_dir() -> String / {env.bodies[sys], abort.raise} = under_abs(env.bodies[sys]())

fn texts(front: LoadedAnalysis) -> List<Bytes> =
  map(front.files, |f: { path: String, name: String, text: Bytes }| f.text)

// What a developer asks of emission through the environment: `PLY_C_ONLY` and `PLY_C_SKIP` narrow
// what is offered, `PLY_C_REFUSALS` says what the unit took and refused, and `PLY_C_PHASES` what
// the emitter was asked and what was read back.
type Knobs = { only: Option<List<String>>, skip: List<String>, refusals: Bool, phases: Bool }

fn listed(text: String) -> List<String> / {abort.raise} =
  filter(string_split(text, ","), |s: String| s != "")

fn knobs() -> Knobs / {env.var[sys], abort.raise} =
  {
    only: match env.var[sys]("PLY_C_ONLY") { Some(t) -> Some(listed(t)), None -> None },
    skip: match env.var[sys]("PLY_C_SKIP") { Some(t) -> listed(t), None -> [] },
    refusals: env.var[sys]("PLY_C_REFUSALS") != None,
    phases: env.var[sys]("PLY_C_PHASES") != None,
  }

// `offered` with only the definitions `PLY_C_ONLY` names, and none under a prefix `PLY_C_SKIP` names.
fn narrowed(k: Knobs, offered: List<Bytes>) -> List<Bytes> / {abort.raise} =
  filter(offered, |n: Bytes| {
    let name = string_of_bytes(n);
    let wanted = match k.only {
      None -> true,
      Some(names) -> len(filter(names, |w: String| w == name)) > 0,
    };
    wanted && len(filter(k.skip, |prefix: String| string_starts_with(name, prefix))) == 0
  })

fn told(
  k: Knobs,
  offered: Int,
  emission: Result<Emission, Bytes>,
  identity: Bytes,
  ms: Int,
) -> Unit / {process.err[proc], abort.raise} =
  match emission {
    Err(_) -> (),
    Ok(e) -> {
      if k.refusals {
        fold(e.produced.dropped, (), |_: Unit, d: Dropped|
          process.err[proc](
            "C backend refused `" ++ string_of_bytes(d.function) ++ "`: "
              ++ string_of_bytes(d.construct),
          ));
        process.err[proc](
          "C backend took " ++ int_to_string(len(e.produced.taken)) ++ " of "
            ++ int_to_string(offered)
            ++ " definitions",
        )
      };
      if k.phases {
        process.err[proc](
          "phases: emitter " ++ string_of_bytes(identity) ++ ", " ++ int_to_string(e.kept)
            ++ " answers read back, "
            ++ int_to_string(e.asked)
            ++ " asked of it, "
            ++ int_to_string(ms)
            ++ "ms",
        )
      }
    },
  }

// The unit over `offered`, its C as the runtime compiles it, with the emitter's answers kept under
// the toolchain's cache.
fn unit_of(
  front: LoadedAnalysis,
  offered: List<Bytes>,
) -> Result<Emitted, List<Diag>> / {Emits, abort.raise} = {
  let k = knobs();
  let wanted = narrowed(k, offered);
  let identity = emitter_identity(shipped.definitions());
  let dir = kept_dir();
  let started = time.elapsed_ms();
  let emission = emitted(
    shipped.runtime(),
    front.dump,
    texts(front),
    wanted,
    identity,
    |key: Bytes| read_kept[abs](dir, key),
    |key: Bytes, bytes: Bytes| write_kept[abs](dir, key, bytes),
  );
  told(k, len(wanted), emission, identity, time.elapsed_ms() - started);
  emitted_of(front, wanted, emission)
}

// A unit's C alone, for whoever only enters it.
pub fn text_of(r: Result<Emitted, List<Diag>>) -> Result<Bytes, List<Diag>> =
  match r { Ok(e) -> Ok(e.text), Err(diags) -> Err(diags) }

// The whole program's unit, every root it offers, and what it was made of.
pub fn whole_emitted(front: LoadedAnalysis) -> Result<Emitted, List<Diag>> / {emit.unit} =
  emit.unit(front, every_root(front))

// The whole program's unit, as the runtime compiles it.
pub fn whole(front: LoadedAnalysis) -> Result<Bytes, List<Diag>> / {emit.unit} =
  text_of(whole_emitted(front))

// The unit a run executes in, or none for a run that executes nothing.
pub fn wanted(
  front: LoadedAnalysis,
  build: Bool,
) -> Result<Option<Bytes>, List<Diag>> / {emit.unit} =
  if !build { Ok(None) }
  else { match whole(front) { Ok(text) -> Ok(Some(text)), Err(diags) -> Err(diags) } }

// `body` with every unit it asks for emitted here, the emitter's answers kept under the
// toolchain's cache.
pub fn emitting<a | e>(body: () -> a / {emit.unit | e}) -> a / {abort.raise, Emits | e} =
  handle { body() } with { emit.unit(front, offered) -> unit_of(front, offered) }

// `body` with every unit it asks for emitted afresh and kept nowhere: for a program that drives
// another and has no toolchain cache of its own.
pub fn emitting_fresh<a | e>(
  body: () -> a / {emit.unit | e},
) -> a / {abort.raise, shipped.runtime | e} =
  handle { body() } with { emit.unit(front, offered) -> fresh(front, offered) }

fn fresh(
  front: LoadedAnalysis,
  offered: List<Bytes>,
) -> Result<Emitted, List<Diag>> / {shipped.runtime, abort.raise} =
  emitted_of(
    front,
    offered,
    emitted(
      shipped.runtime(),
      front.dump,
      texts(front),
      offered,
      b"",
      |_: Bytes| None,
      |_: Bytes, _: Bytes| (),
    ),
  )
