//! Where a project keeps its store, and the stamps that say which toolchain filed what it holds.

import std.fs (fs)
import std.hash (blake3)
import compiler.hash (hex)
import compiler.resolve (Diag)
import compiler.unit (identity_of, unit_roots)
import paths
import semantics
import store.engine (Warning, Unreadable, Corrupt, OtherVersion)
import store.tables (Stamps)

/// Where a load keeps its store: `.ply-cache` in the project root, under the root's own label, with
/// the root as the machine spells the files it keys.
pub type Place = { label: String, dir: String, root: String, stamps: Stamps }

pub fn place_of(paths: List<paths::Resolved>, stamps: Stamps) -> Place =
  match list_at(paths, 0) {
    Some(r) ->
      {
        label: r.label,
        dir: paths::in_root(r, ".ply-cache").path,
        root: if r.label == "cwd" { r.spelling } else { "/" ++ r.spelling },
        stamps: stamps,
      },
    None -> { label: "cwd", dir: ".ply-cache", root: ".", stamps: stamps },
  }

/// The definitions a pass or a claim's evidence is a function of besides its own key: the runs that
/// decide and file them, and what makes the unit they run in.
fn verdict_roots() -> List<Bytes> =
  fold(
    unit_roots(),
    [b"tests.selected", b"prove.run", b"review.run"],
    |acc: List<Bytes>, r: Bytes| push(acc, r),
  )

/// The definitions a pass filed under the code its test ran is a function of besides that code: the
/// run that decides one test's verdict, what concludes whether its pass is filed, what assembles the
/// unit from the bodies a code digests, and what names a test's code. The emitter that makes the
/// bodies is not among them, so a compiler that makes the same code again moves nothing.
fn code_roots() -> List<Bytes> =
  [
    b"tests.ran_job",
    b"suite.conclude.concluded",
    b"unit.produce",
    b"unit.held",
    b"units.emitted_of",
    b"tests.codes_of",
  ]

/// The launcher lays two files beside the shipped modules: `stamps`, the runtime's side of each
/// group as `name digest` lines, and `definitions`, each definition of this program and its hash.
pub fn shipped_stamps() -> Stamps / {fs.read_file[shipped], abort.raise} =
  match ((fs.read_file[shipped]("stamps"), fs.read_file[shipped]("definitions"))) {
    (Some(stamps), Some(definitions)) ->
      stamped(stamps_of(string_of_bytes_lossy(stamps)), definitions),
    _ ->
      panic(
        "the shipped modules' directory carries no stamps or no definitions; the launcher lays both out beside the modules",
      ),
  }

/// A group's stamp: the runtime's side of it and the program's, which is the definitions that
/// compute what the group holds. A pass is also what its test's hash means.
pub fn stamped(launched: Stamps, definitions: Bytes) -> Stamps / {abort.raise} = {
  let over = |parts: List<Bytes>|
    string_of_bytes(
      hex(blake3(bytes_concat_all(map(parts, |part: Bytes| bytes_concat(part, b"\x00"))))),
    );
  {
    runtime: over([
      b"ply.stamp.runtime.4",
      bytes_of_string(launched.runtime),
      identity_of(definitions, verdict_roots()),
      bytes_of_string(semantics::version()),
    ]),
    code: over([
      b"ply.stamp.code.1",
      bytes_of_string(launched.runtime),
      identity_of(definitions, code_roots()),
      bytes_of_string(semantics::version()),
    ]),
  }
}

pub fn stamps_of(text: String) -> Stamps =
  fold(string_split(text, "\n"), { runtime: "", code: "" }, |s: Stamps, line: String|
    match string_split(line, " ") { ["runtime", digest] -> { ..s, runtime: digest }, _ -> s })

fn warning(code: Bytes, message: String, notes: List<String>) -> Diag =
  {
    code: code,
    notes: len(notes),
    labels: [],
    text: b"",
    message: bytes_of_string(message),
    notes_text: map(notes, bytes_of_string),
    severity: b"warning",
    fixes: [],
  }

/// The store's own account of what it degraded past, in the codes a report names them by.
pub fn diags_of(ws: List<Warning>) -> List<Diag> =
  map(ws, |w: Warning|
    match w.trouble {
      Unreadable ->
        warning(b"W0601", w.message, [
          "this run is unaffected; the next one will do this work again",
        ]),
      Corrupt ->
        warning(b"W0602", "the cache is corrupt: " ++ w.message, [
          "whatever needed it is recomputed, and `ply cache compact` rewrites the data file",
        ]),
      OtherVersion -> warning(b"W0603", w.message, ["the store is rebuilt as this run files"]),
    })

pub fn unreadable_value(why: String) -> Diag =
  warning(b"W0602", "the cache is corrupt: a filed value does not read back: " ++ why, [
    "that entry is treated as absent, and what it answered for is checked again",
  ])

// --- Tests ------------------------------------------------------------------

/// Every root a stamp names and one definition none does, each under a hash of its own, with
/// `moved` under another.
fn definitions_with(moved: Bytes) -> Bytes / {abort.raise} = {
  let roots = fold(code_roots(), verdict_roots(), |acc: List<Bytes>, r: Bytes| push(acc, r));
  fold(push(roots, b"other.unrelated"), b"", |acc: Bytes, root: Bytes|
    bytes_concat_all([
      acc,
      root,
      b" ",
      if root == moved { b"moved" } else { hex(blake3(root)) },
      b"\n",
    ]))
}

test "a group's stamp moves with a definition that computes what it holds, and with no other" {
  let launched = { runtime: "runtime", code: "" };
  let now = stamped(launched, definitions_with(b""));
  assert_eq(stamped(launched, definitions_with(b"other.unrelated")), now);
  let deciding = stamped(launched, definitions_with(b"tests.selected"));
  assert(deciding.runtime != now.runtime, Some("a verdict's root moved and its stamp did not"));
  let another = stamped({ ..launched, runtime: "another" }, definitions_with(b""));
  assert(another.runtime != now.runtime, Some("the runtime moved and its stamp did not"));
  assert(another.code != now.code, Some("the runtime moved and the code passes' stamp did not"))
}

// What makes a unit moves the passes keyed by test and leaves those keyed by the code a test ran;
// what decides a test's verdict moves both.
test "the code passes' stamp moves with what decides a verdict, and not with what makes the code" {
  let launched = { runtime: "runtime", code: "" };
  let now = stamped(launched, definitions_with(b""));
  let emitter = stamped(launched, definitions_with(b"unit.emitted"));
  assert(emitter.runtime != now.runtime, Some("the emitter moved and the passes' stamp did not"));
  assert_eq(emitter.code, now.code);
  assert_eq(stamped(launched, definitions_with(b"tests.selected")).code, now.code);
  let running = stamped(launched, definitions_with(b"tests.ran_job"));
  assert(running.code != now.code, Some("what decides a verdict moved and the stamp did not"));
  let concluding = stamped(launched, definitions_with(b"suite.conclude.concluded"));
  assert(concluding.code != now.code, Some("what files a pass moved and the stamp did not"));
  let assembling = stamped(launched, definitions_with(b"unit.produce"));
  assert(assembling.code != now.code, Some("what places the bodies moved and the stamp did not"))
}

test "the shipped modules' stamps are read a name to a line, and a line naming nothing is passed over" {
  assert_eq(stamps_of("evaluator aa\nruntime bb\n"), { runtime: "bb", code: "" });
  assert_eq(stamps_of("other cc\n"), { runtime: "", code: "" })
}
