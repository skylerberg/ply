// `ply prove` — every obligation the project carries, and the tier it was discharged at. What a
// claim is worth is the prover's answer; which claims are asked for, how each one reads, and
// whether a run of them is a failure are decided here.

import args (Flags, from_argv, style_of)
import claims
import proof.rules (Congruence)
import config_schema
import program (Timed, front_of, is_shipped, no_front, timed_load, timed_uncached)
import proof.obligation (Binding, Defect, Evidence, Frame, Gap, Held, NoCaseKept, Outcome, Proof,
                         Pure, Raised, ReachesHost, Refuted, Sampled, Unattempted, Unsatisfiable,
                         Vacuous, frame_summary)
import proof.decide (Static)
import proof.keys (prove_key)
import proof.evidence (evidence_text)
import std.bytes (bytes_of_hex, hex_of)
import proof.world (Built, World, world_of)
import claims (Claimed, Collected, Options, prover, Claim, Collection, Discharged, discharge_runs,
               Refusal, Row, Verdicts, Broken, Trouble, Unbound, a_claim, a_counter, a_fault, a_loc,
               a_place, a_plan, also, at_tier, claimed_part, code_of, collected_part, collection_of,
               coverage_json, coverage_lines, decided, defect_of, diagnostics_of, held_of, joined,
               no_statics, no_world, nth, num, obligation_json, once_each, own_claims, plan_json,
               proved, quantifier, refusal, refuted_of, rendered, row_head, rows_of, seconds,
               Statics, statics_of, unattempted_of, under, vacuous_of)
import proof.obligation (Coverage, Ensures, Example, Fresh, FromProof, Kind, Law, Property, Proved,
                         Tier, reason_word)
import builder (builder)
import cache (store, Front)
import std.fs (fs)
import std.time (time)
import compiler.resolve (Diag)
import diagnostic (Place, all_to_json)
import report (Answer, ind, ok_code, schema_version, count_of, plural, warned_lines)
import signature (fill, width)
import std.json (Json, Str, Bool, Number, Array, object, to_string)
import std.value (VInt, VList)
import style (Style, dim, red, green)

// --- Which claims are asked for ----------------------------------------------

// `--filter` is a substring of the owner's name, so one definition's claims can be worked on
// without discharging the rest of the project every time.
fn wanted_of(cs: List<Claim>, flags: Flags) -> List<Int> =
  fold(range(0, len(cs)), [], |acc: List<Int>, i: Int|
    match list_at(cs, i) {
      None -> acc,
      Some(c) -> if !flags.filtered || string_contains(c.owner, flags.filter) { push(acc, i) }
      else { acc },
    })

// --- The lines a reader reads ------------------------------------------------

fn summary_line(s: Style, rows: List<Row>, ms: Decimal) -> String = {
  let head = ind() ++ count_of(len(rows), "obligation") ++ " · "
    ++ int_to_string(at_tier(rows, Proved))
    ++ " proved · "
    ++ int_to_string(at_tier(rows, Property))
    ++ " property · "
    ++ int_to_string(at_tier(rows, Example))
    ++ " example";
  let gaps = unattempted_of(rows);
  let counted = if gaps > 0 { head ++ " · " ++ int_to_string(gaps) ++ " unattempted" }
  else { head };
  let faulted = if defect_of(rows) > 0 { counted ++ " · " ++ defects_word(rows) } else { counted };
  faulted ++ "   " ++ dim(s, "(" ++ seconds(ms) ++ "s)")
}

fn defects_word(rows: List<Row>) -> String = count_of(defect_of(rows), "defect") ++ " in Ply"

// A refutation is a fact about the program, so it is written out in full: the point it fails at,
// what that point was shrunk from, and the frame the claim is made under.
fn detail_lines(s: Style, r: Row) -> List<String> =
  match r.outcome {
    Refuted(cx) ->
      [
        under() ++ quantifier(r.claim, cx.bindings) ++ "  →  " ++ rendered(cx.bindings),
        under()
          ++ dim(
            s,
            "shrank from " ++ rendered(cx.original) ++ " in " ++ int_to_string(cx.shrinks) ++ " "
              ++ plural(cx.shrinks, "step")
              ++ " · root "
              ++ int_to_string(cx.root)
              ++ " · case "
              ++ int_to_string(cx.case),
          ),
        under() ++ dim(s, "frame: " ++ frame_summary(r.claim.frame)),
      ],
    Unattempted(gap) -> match gap {
      Raised(raise) -> if len(raise.bindings) == 0 { [] }
      else { [under() ++ dim(s, "shrunk to " ++ rendered(raise.bindings))] },
      _ -> [],
    },
    // Where Ply failed, which is what a report of the defect needs to reproduce it.
    Defect(f) -> if len(f.bindings) == 0 { [] }
    else { [under() ++ dim(s, "at " ++ rendered(f.bindings))] },
    _ -> [],
  }

// The declared atoms a body never touched: an `ensures` over a row wider than the body is a
// weaker claim than it looks, which is what `--explain` is read for.
fn weakened_frame(c: Claim) -> List<String> =
  match c.kind {
    Law(_) -> [],
    Ensures(_) -> if len(c.unperformed) == 0 { [] } else {
      fill(
        "frame covers, body never touches: ",
        "  ",
        c.unperformed,
        "",
        width() - string_len(under()),
      )
    },
  }

fn explained_lines(s: Style, flags: Flags, r: Row) -> List<String> =
  if !flags.explain { [] } else {
    also(
      [under() ++ dim(s, "from: " ++ reason_word(r.reason))],
      map(weakened_frame(r.claim), |line: String| under() ++ dim(s, line)),
    )
  }

fn row_lines(s: Style, flags: Flags, places: List<Place>, r: Row) -> List<String> =
  also(also([row_head(s, r, places)], detail_lines(s, r)), explained_lines(s, flags, r))

fn tally_line(s: Style, rows: List<Row>, ms: Decimal) -> String = {
  let held = int_to_string(held_of(rows)) ++ " held";
  let refuted = refuted_of(rows);
  let vacuous = vacuous_of(rows);
  let clock = " (" ++ seconds(ms) ++ "s)";
  let claimed = also(
    if refuted > 0 { [int_to_string(refuted) ++ " refuted"] } else { [] },
    if vacuous > 0 { [int_to_string(vacuous) ++ " vacuous"] } else { [] },
  );
  let parts = if defect_of(rows) > 0 { push(claimed, defects_word(rows)) } else { claimed };
  if len(parts) == 0 { ind() ++ green(s, held) ++ clock }
  else { ind() ++ red(s, joined(parts, ", ")) ++ ", " ++ held ++ clock }
}

fn filtered_lines(s: Style, filtered_out: Int) -> List<String> =
  if filtered_out > 0 { [ind() ++ dim(s, int_to_string(filtered_out) ++ " filtered out")] }
  else { [] }

fn lines_of(
  s: Style,
  flags: Flags,
  c: Collection,
  rows: List<Row>,
  v: Verdicts,
  filtered_out: Int,
  warnings: List<Diag>,
) -> List<String> = {
  let head = also(
    also(
      also(coverage_lines(s, v.coverage, v.specified, flags.explain), [
        summary_line(s, rows, v.duration_ms),
      ]),
      filtered_lines(s, filtered_out),
    ),
    [""],
  );
  let listed = fold(rows, head, |acc: List<String>, r: Row|
    also(acc, row_lines(s, flags, c.places, r)));
  also(also(listed, warned_lines(s, warnings)), ["", tally_line(s, rows, v.duration_ms)])
}

// --- The document ------------------------------------------------------------

fn summary_json(rows: List<Row>) -> Json =
  object([
    { key: "obligations", value: num(len(rows)) },
    { key: "proved", value: num(at_tier(rows, Proved)) },
    { key: "property", value: num(at_tier(rows, Property)) },
    { key: "example", value: num(at_tier(rows, Example)) },
    { key: "refuted", value: num(refuted_of(rows)) },
    { key: "vacuous", value: num(vacuous_of(rows)) },
    { key: "unattempted", value: num(unattempted_of(rows)) },
    { key: "defect", value: num(defect_of(rows)) },
  ])

fn document(
  c: Collection,
  rows: List<Row>,
  v: Verdicts,
  code: Int,
  filtered_out: Int,
  warnings: List<Diag>,
) -> Json =
  object([
    { key: "schema_version", value: num(schema_version()) },
    { key: "command", value: Str("prove") },
    { key: "ok", value: Bool(code == ok_code()) },
    { key: "exit_code", value: num(code) },
    { key: "specified", value: num(v.specified) },
    { key: "coverage", value: coverage_json(v.coverage) },
    { key: "plan", value: plan_json(c.plan) },
    { key: "cached", value: num(v.cached) },
    { key: "filtered_out", value: num(filtered_out) },
    { key: "duration_ms", value: Number(v.duration_ms) },
    { key: "summary", value: summary_json(rows) },
    {
      key: "obligations",
      value: Array(
        map(rows, |r: Row|
          obligation_json(r, c.places, match v.reaches { Some(_) -> true, None -> false })),
      ),
    },
    { key: "diagnostics", value: all_to_json(diagnostics_of(rows), c.places) },
    { key: "warnings", value: all_to_json(warnings, c.places) },
  ])

// --- The answer ---------------------------------------------------------------

fn answered(
  s: Style,
  flags: Flags,
  c: Collection,
  rows: List<Row>,
  v: Verdicts,
  filtered_out: Int,
) -> Answer = {
  // A lazy read and a later flush can each report the same unreadable file.
  let warnings = once_each(also(c.warnings, v.warnings));
  let code = code_of(rows);
  {
    json: document(c, rows, v, code, filtered_out, warnings),
    lines: lines_of(s, flags, c, rows, v, filtered_out, warnings),
    errs: [],
    code: code,
  }
}

// `--reach` asks the static tier about every claim the run reports on, whether the cache or a
// discharge answered it, so a cached run reports what a fresh one does.
fn asked<| e>(
  s: Style,
  flags: Flags,
  c: Collection,
  use_cache: Bool,
  statics: Statics,
  discharge: (Collection, List<Int>, List<Static>) -> Result<Discharged, Refusal> / e,
) -> Answer / {prover.record[claims], prover.cached[claims] | e} = {
  let wanted = wanted_of(c.claims, flags);
  match decided(
      c,
      wanted,
      use_cache,
      statics,
      flags.reach,
      |runs: List<Int>, settled: List<Static>| discharge(c, runs, settled),
    ) {
    Err(why) -> refusal(s, "prove", why),
    Ok(v) -> answered(s, flags, c, rows_of(c.claims, wanted, v), v, len(c.claims) - len(wanted)),
  }
}

pub fn run(
  flags: Flags,
  options: Options,
) -> Answer / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shelf], fs.read_file[shelf], time.elapsed_ms, time.elapsed_us, prover.configure[claims], prover.collected[claims], prover.record[claims], prover.cached[claims], prover.prepared[claims], prover.judged[claims], prover.interleaved[claims], prover.ended[claims], store.known[cache], store.file[cache]} = {
  let s: Style = style_of(flags);
  let t: Timed = if options.no_incremental { timed_uncached(flags.paths) }
  else { timed_load(flags.paths) };
  match t.program.whole {
    // A load refusal is the same kind of answer the machine's own refusals are, so it
    // reads through the one renderer: nothing was proved, and the diagnostics say why.
    None -> refusal(s, "prove", Broken({ diags: t.program.diags, places: t.program.places })),
    Some(w) -> match config_schema::refusal(w, options.config.schema) {
      Some(d) -> refusal(s, "prove", Unbound({ diags: [d], places: t.program.places })),
      None -> {
        // The shipped modules' claims are the toolchain's, unless the run asks for them too.
        let built: Built = world_of(w, |m: Bytes|
          options.std || !is_shipped(string_of_bytes_lossy(m)));
        prove_over(
          s,
          flags,
          options,
          front_of(t, w),
          built.world,
          own_claims(w, built),
          statics_of(w, built.world),
          discharge_runs,
        )
      },
    },
  }
}

// The run itself, over the front end `run` loaded, the claims it built from it, the static prover
// over them, and what discharges what is left.
fn prove_over<| e>(
  s: Style,
  flags: Flags,
  options: Options,
  front: Front,
  world: World,
  mine: Claimed,
  statics: Statics,
  discharge: (Collection, List<Int>, List<Static>) -> Result<Discharged, Refusal> / e,
) -> Answer / {prover.configure[claims], prover.collected[claims], prover.record[claims], prover.cached[claims] | e} = {
  prover.configure[claims](options, front, world);
  match prover.collected[claims]() {
    Err(why) -> refusal(s, "prove", why),
    Ok(got) ->
      asked(s, flags, collection_of(got, mine, options), !options.no_cache, statics, discharge),
  }
}

// --- Tests ------------------------------------------------------------------

// One definition per claim's owner, each carrying no spec of its own.
fn a_collection(cs: List<Claim>) -> Collection =
  {
    places: [a_place()],
    warnings: [],
    claims: cs,
    defs: map(cs, |c: Claim| { name: c.owner, hash: Some(c.key), specs: [] }),
    laws: [],
    plan: a_plan(),
    host: false,
    world: no_world(),
    lanes: None,
  }

// What the runtime answers a fixture's collection with, and what the fixture built of it.
fn got_of(c: Result<Collection, Refusal>) -> Result<Collected, Refusal> =
  match c { Ok(x) -> Ok(collected_part(x)), Err(why) -> Err(why) }

fn mine_of(c: Result<Collection, Refusal>) -> Claimed =
  match c {
    Ok(x) -> claimed_part(x),
    Err(_) -> { claims: [], defs: [], laws: [], warnings: [], world: no_world() },
  }

fn verdicts(outcomes: List<Outcome>) -> Discharged =
  { outcomes: outcomes, duration_ms: decimal_of_int(0), warnings: [] }

fn proved_over(
  flags: Flags,
  c: Result<Collection, Refusal>,
  v: Result<Discharged, Refusal>,
) -> Answer = held_over(flags, c, v, [None, None])

// The same, with the cache holding `held` under each claim's bare key and its plan's.
fn held_over(
  flags: Flags,
  c: Result<Collection, Refusal>,
  v: Result<Discharged, Refusal>,
  held: List<Option<String>>,
) -> Answer = reached_over(flags, c, v, held, None)

// The same, with the static tier answering `reach` for every claim it is asked about.
fn reached_over(
  flags: Flags,
  c: Result<Collection, Refusal>,
  v: Result<Discharged, Refusal>,
  held: List<Option<String>>,
  reach: Option<claims::Reach>,
) -> Answer =
  handle {
    prove_over(
      style_of(flags),
      flags,
      claims::no_options(),
      no_front(),
      no_world(),
      mine_of(c),
      no_statics(reach),
      |_c: Collection, runs: List<Int>, _settled: List<Static>| ran(v, runs),
    )
  } with {
    prover.configure[claims](options, front, world) -> (),
    prover.collected[claims]() -> got_of(c),
    prover.cached[claims](keys) ->
      map(range(0, len(keys)), |j: Int|
        filed_text(held_word(held, j), filed_under(c, v, nth(keys, j)))),
    prover.record[claims](entries) -> [],
  }

fn bare() -> Flags = from_argv("prove", [])

fn one_claim() -> List<Claim> = [a_claim("m.one", Ensures(0))]

fn one_proved() -> List<Outcome> = [proved([Congruence], 2)]

test "the coverage line leads, the tally closes, and a run where every claim holds is exit 0" {
  let answer = proved_over(bare(), Ok(a_collection(one_claim())), Ok(verdicts(one_proved())));
  assert_eq(answer.code, 0);
  assert_eq(answer.errs, []);
  assert_eq(nth(answer.lines, 0), "   1 definition · 1 carry an obligation · 0 do not");
  assert_eq(
    nth(answer.lines, 1),
    "   1 obligation · 1 proved · 0 property · 0 example   (0.00s)",
  );
  assert_eq(nth(answer.lines, 2), "");
  assert_eq(
    nth(answer.lines, 3),
    "   ✓ proved      m.one ensures #0                         congruence · 2 steps",
  );
  assert_eq(nth(answer.lines, 4), "");
  assert_eq(nth(answer.lines, 5), "   1 held (0.00s)")
}

test "a refuted claim is exit 1, and says where it fails and what it was shrunk from" {
  let answer = proved_over(
    bare(),
    Ok(a_collection(one_claim())),
    Ok(verdicts([Refuted(a_counter())])),
  );
  assert_eq(answer.code, 1);
  assert_eq(nth(answer.lines, 1), "   1 not covered by a claim that holds: m.one");
  assert_eq(
    nth(answer.lines, 4),
    "   ✗ refuted     m.one ensures #0                         m.ply:1:4",
  );
  assert_eq(nth(answer.lines, 5), "       forall (xs: List<Int>)  →  xs = [0, 0]");
  assert_eq(nth(answer.lines, 6), "       shrank from xs = [7, 9] in 2 steps · root 0 · case 11");
  assert_eq(nth(answer.lines, 7), "       frame: pure");
  assert_eq(nth(answer.lines, len(answer.lines) - 1), "   1 refuted, 0 held (0.00s)")
}

// A runtime that holds a draw for every claim, and whose every walk settles on the empty list.
// A fixture's discharge: the outcomes it was handed, one per claim of the collection, for the claims
// at these collection indices.
fn ran(v: Result<Discharged, Refusal>, runs: List<Int>) -> Result<Discharged, Refusal> =
  match v {
    Err(why) -> Err(why),
    Ok(d) ->
      Ok({
        ..d,
        outcomes: fold(runs, [], |out: List<Outcome>, i: Int|
          match list_at(d.outcomes, i) { Some(o) -> push(out, o), None -> out }),
      }),
  }

// What a fixture's cache holds under a key: the evidence the fixture's outcome for the claim the key
// names holds, under its bare key or its plan's.
fn held_word(held: List<Option<String>>, j: Int) -> Option<String> =
  match list_at(held, j) { Some(word) -> word, None -> None }

// What a key holds, as text of the kind the fixture says it holds: the claim's own evidence when it is
// of that kind, a stand-in otherwise, and something no discharge files for anything else.
fn filed_text(word: Option<String>, e: Option<Evidence>) -> Option<String> =
  match word {
    None -> None,
    Some(w) ->
      Some(if w == "proof" {
        evidence_text(match e {
          Some(Proof(c)) -> Proof(c),
          _ -> Proof({ rules: [Congruence], steps: 2, guard_satisfiable: true, sorts: [] }),
        })
      } else if w == "sample" {
        evidence_text(match e {
          Some(Sampled(c)) -> Sampled(c),
          _ -> Sampled({ generated: 200, kept: 200, rejected: 0, roots: [0], instantiations: [] }),
        })
      } else { "not evidence" }),
  }

fn filed_under(
  c: Result<Collection, Refusal>,
  v: Result<Discharged, Refusal>,
  key: String,
) -> Option<Evidence> =
  match ((c, v)) {
    (Ok(x), Ok(d)) -> {
      let digest = claims::plan_digest_of(x.plan);
      fold(range(0, len(x.claims)), None, |found: Option<Evidence>, i: Int|
        match found {
          Some(_) -> found,
          None -> match ((list_at(x.claims, i), list_at(d.outcomes, i))) {
            (Some(claim), Some(Held(h))) -> if claim.key == key
                || hex_of(prove_key(bytes_of_hex(claim.key), digest)) == key { Some(h.evidence) }
            else { None },
            _ -> None,
          },
        })
    },
    _ -> None,
  }

// A guard that admits nothing makes its claim say nothing, which is a failure as a refutation is.
test "a vacuous claim is exit 1, however the guard was found to admit nothing" {
  let unsatisfiable = proved_over(
    bare(),
    Ok(a_collection(one_claim())),
    Ok(verdicts([Vacuous({ guard: a_loc(), why: Unsatisfiable })])),
  );
  assert_eq(unsatisfiable.code, 1);
  assert_eq(nth(unsatisfiable.lines, len(unsatisfiable.lines) - 1), "   1 vacuous, 0 held (0.00s)");
  let unkept = proved_over(
    bare(),
    Ok(a_collection(one_claim())),
    Ok(verdicts([Vacuous({ guard: a_loc(), why: NoCaseKept(200) })])),
  );
  assert_eq(unkept.code, 1);
  assert(string_contains(to_string(unkept.json), "\"ok\":false"))
}

// A gap is not a failure: nothing was established, and nothing was refuted either.
test "an obligation nothing could attempt is counted, reported and still exit 0" {
  let answer = proved_over(
    bare(),
    Ok(a_collection(one_claim())),
    Ok(verdicts([Unattempted(ReachesHost("{db.read[u]}"))])),
  );
  assert_eq(answer.code, 0);
  assert_eq(nth(answer.lines, 1), "   1 not covered by a claim that holds: m.one");
  assert(string_contains(nth(answer.lines, 2), "1 unattempted"));
  assert(
    string_contains(
      nth(answer.lines, 4),
      "reaches the host ({db.read[u]}); run `ply prove --host`",
    ),
  );
  let text = to_string(answer.json);
  assert(string_contains(text, "\"gap_kind\":\"reaches_host\""));
  assert(string_contains(text, "W0604"))
}

test "a claim Ply failed on is a defect in Ply and exit 1, never the program's gap" {
  let answer = proved_over(
    bare(),
    Ok(a_collection(one_claim())),
    Ok(verdicts([Defect(a_fault())])),
  );
  assert_eq(answer.code, 1);
  assert_eq(
    nth(answer.lines, 2),
    "   1 obligation · 0 proved · 0 property · 0 example · 1 defect in Ply   (0.00s)",
  );
  assert(
    string_contains(
      nth(answer.lines, 4),
      "Ply failed rather than the program, so this is a defect in Ply: the compiled tier declined to enter `m.law`",
    ),
  );
  assert_eq(nth(answer.lines, 5), "       at b = true");
  assert_eq(nth(answer.lines, len(answer.lines) - 1), "   1 defect in Ply, 0 held (0.00s)");
  let text = to_string(answer.json);
  assert(string_contains(text, "\"outcome\":\"defect\""));
  assert(string_contains(text, "\"defect\":1"));
  assert(string_contains(text, "\"unattempted\":0"));
  assert(string_contains(text, "\"code\":\"E0505\""));
  assert(string_contains(text, "\"ok\":false"));
  assert(!string_contains(text, "W0604"));
  assert(!string_contains(text, "\"gap\""))
}

test "`--filter` decides what is discharged at all, and says how much it left out" {
  let two = [a_claim("m.one", Ensures(0)), a_claim("m.two", Ensures(0))];
  let answer = proved_over(
    from_argv("prove", ["--filter=two"]),
    Ok(a_collection(two)),
    Ok(verdicts(also(one_proved(), one_proved()))),
  );
  assert_eq(len(filter(answer.lines, |l: String| string_contains(l, "m.two ensures #0"))), 1);
  assert_eq(len(filter(answer.lines, |l: String| string_contains(l, "m.one ensures #0"))), 0);
  // What was left out was not established either, so its definition is listed as not covered.
  assert_eq(nth(answer.lines, 1), "   1 not covered by a claim that holds: m.one");
  assert_eq(nth(answer.lines, 3), "   1 filtered out")
}

test "the object keys off `command` and `exit_code`, and carries the plan it ran under" {
  let answer = proved_over(
    from_argv("prove", ["--json"]),
    Ok(a_collection(one_claim())),
    Ok(verdicts(one_proved())),
  );
  let text = to_string(answer.json);
  assert(string_contains(text, "\"command\":\"prove\""));
  assert(string_contains(text, "\"schema_version\":1"));
  assert(string_contains(text, "\"exit_code\":0"));
  assert(string_contains(text, "\"ok\":true"));
  assert(string_contains(text, "\"specified\":1"));
  assert(string_contains(text, "\"cases\":200"));
  assert(string_contains(text, "\"tier\":\"proved\""));
  assert(string_contains(text, "\"outcome\":\"proved\""));
  assert(string_contains(text, "\"label\":\"m.one ensures #0\""))
}

test "`--explain` says where each answer came from, and what the frame covers untouched" {
  let wide = { ..a_claim("m.wide", Ensures(0)), unperformed: ["db.read[rows]"] };
  let answer = held_over(
    from_argv("prove", ["--explain"]),
    Ok(a_collection([wide])),
    Ok(verdicts(one_proved())),
    [Some("proof"), None],
  );
  assert_eq(nth(answer.lines, 4), "       from: cached proof");
  assert_eq(nth(answer.lines, 5), "       frame covers, body never touches: db.read[rows]")
}

fn sampled() -> List<Outcome> =
  [
    Held({
      tier: Property,
      evidence: Sampled({ generated: 200, kept: 200, rejected: 0, roots: [0], instantiations: [] }),
    }),
  ]

// What the static tier alone answers is a measurement a run asks for, of every claim it reports on:
// a claim the cache answered is asked like one a discharge answered.
test "under `--reach` each obligation carries what the static tier answered and where it stopped" {
  let reach = {
    decision: "open",
    steps: 12,
    blockers: [{ kind: "division", about: None }, { kind: "recursive_call", about: Some("m.f") }],
  };
  let said = "\"reach\":{\"blockers\":[{\"about\":null,\"kind\":\"division\"},{\"about\":\"m.f\",\"kind\":\"recursive_call\"}],\"decision\":\"open\",\"steps\":12}";
  let asked = from_argv("prove", ["--json", "--reach"]);
  let fresh = reached_over(
    asked,
    Ok(a_collection(one_claim())),
    Ok(verdicts(sampled())),
    [None, None],
    Some(reach),
  );
  assert(string_contains(to_string(fresh.json), said));
  let cached = reached_over(
    asked,
    Ok(a_collection(one_claim())),
    Ok(verdicts(sampled())),
    [None, Some("sample")],
    Some(reach),
  );
  assert(string_contains(to_string(cached.json), "\"cached\":1"));
  assert(string_contains(to_string(cached.json), said));
  // Unasked, no claim carries a reach at all.
  let unasked = proved_over(
    from_argv("prove", ["--json"]),
    Ok(a_collection(one_claim())),
    Ok(verdicts(one_proved())),
  );
  assert(!string_contains(to_string(unasked.json), "\"reach\""))
}

test "a sample under its plan's key is read back as a cached sample, and counted as one" {
  let answer = held_over(
    from_argv("prove", ["--explain", "--json"]),
    Ok(a_collection(one_claim())),
    Ok(verdicts(sampled())),
    [None, Some("sample")],
  );
  assert(len(filter(answer.lines, |l: String| l == "       from: cached sample")) == 1);
  assert(string_contains(to_string(answer.json), "\"cached\":1"));
  assert(string_contains(to_string(answer.json), "\"warnings\":[]"))
}

test "an entry under the wrong key is refused, and the refusal is a warning the run reports" {
  let answer = held_over(
    from_argv("prove", ["--explain", "--json"]),
    Ok(a_collection(one_claim())),
    Ok(verdicts(one_proved())),
    [None, Some("proof")],
  );
  assert(len(filter(answer.lines, |l: String| l == "       from: cache refused")) == 1);
  let text = to_string(answer.json);
  assert(string_contains(text, "\"cached\":0"));
  assert(string_contains(text, "W0602"));
  assert(
    string_contains(text, "holds a proof under a plan key for `abcdef012345`; it was discarded"),
  )
}

test "a program that does not load is the load's own refusal, tallied and exit 2" {
  let d: Diag = {
    code: b"E0201",
    notes: 0,
    labels: [],
    text: b"",
    message: b"type mismatch",
    notes_text: [],
    severity: b"error",
    fixes: [],
  };
  let answer = proved_over(bare(), Err(Broken({ diags: [d], places: [] })), Ok(verdicts([])));
  assert_eq(answer.code, 2);
  assert_eq(answer.lines, []);
  assert_eq(answer.errs, ["Error[E0201]: type mismatch", "   compilation failed (1 error)"])
}

test "a binding that does not match the program is a start-up failure naming no line" {
  let d: Diag = {
    code: b"E0412",
    notes: 0,
    labels: [],
    text: b"",
    message: b"no database was configured",
    notes_text: [],
    severity: b"error",
    fixes: [],
  };
  let answer = proved_over(
    bare(),
    Ok(a_collection(one_claim())),
    Err(Unbound({ diags: [d], places: [] })),
  );
  assert_eq(answer.code, 2);
  assert_eq(answer.errs, [
    "Error[E0412]: no database was configured",
    "   no host handler was bound (1 error)",
  ]);
  assert(string_contains(to_string(answer.json), "\"binding\":\"host\""))
}

test "a cache that would not open at all is reported without a compilation tally" {
  let d: Diag = {
    code: b"E0501",
    notes: 0,
    labels: [],
    text: b"",
    message: b"could not open the cache",
    notes_text: [],
    severity: b"error",
    fixes: [],
  };
  let answer = proved_over(bare(), Err(Trouble({ diags: [d], places: [] })), Ok(verdicts([])));
  assert_eq(answer.code, 2);
  assert_eq(answer.errs, ["Error[E0501]: could not open the cache"])
}
