//! `ply prove` — every obligation the project carries, and the tier it was discharged at. What a
//! claim is worth is the prover's answer; which claims are asked for, how each one reads, and
//! whether a run of them is a failure are decided here.

import compiler.unit (shipped)
import compiler.load (LoadedAnalysis)
import std.random (entropy)
import args (Flags, from_argv, kept, style_of, root_of)
import literals (literal, unsettled)
import claims
import env (env)
import results
import proof.rules (Congruence)
import config_schema
import configuration
import machine
import units
import units (emit)
import program (Timed, load_diagnostics, front_of, owned_of, no_front, timed_load, timed_uncached)
import proof.obligation (Binding, Defect, Evidence, Frame, Gap, Held, NoCaseKept, Outcome, Outgrown,
                         Proof, Pure, Raised, ReachesHost, Refuted, Sampled, Unattempted,
                         Unsatisfiable, Vacuous, frame_summary, plural)
import proof.fit (outgrowth, table)
import proof.decide (Static)
import proof.keys (prove_key)
import proof.evidence (evidence_bytes)
import std.bytes (bytes_of_hex, hex_of)
import proof.world (Built, World, world_of)
import claims (Claimed, Collected, Options, prover, proofs, Claim, Collection, Discharged,
               discharge_runs, Refusal, Row, Verdicts, Broken, Trouble, Unbound, a_claim, a_counter,
               outgrown_of, a_fault, a_loc, a_place, a_plan, at_tier, claimed_part, code_of,
               collected_part, collection_of, coverage_json, coverage_lines, decided, defect_of,
               diagnostics_of, held_of, no_statics, no_world, obligation_json, once_each,
               own_claims, plan_json, proved, quantifier, refusal, refuted_of, rendered, row_head,
               rows_of, seconds, Statics, statics_of, unattempted_of, under, vacuous_of)
import proof.obligation (Coverage, Ensures, Example, Fitted, Fresh, FromProof, Kind, Law, Property,
                         Proved, Tier, reason_word)
