// `ply cache` — what the store under `.ply-cache` holds, and what clearing or compacting it did.
// Opening, locking, sweeping and flushing a store is the Rust side's: a reader of the on-disk
// format written here would be a second implementation of it. Everything below decides what the
// four subcommands say, in both forms, and what they exit with.

import args (Flags, no_flags, style_of)
import compiler.resolve (Diag)
import diagnostic (all_to_json, all_to_text)
import report (Answer, ind, ok_code, compile_error, count_of, plural, warning_lines)
import std.json (Json, Null, Str, Bool, Number, Array, Member, object, to_string)
import style (Style, plain, bold, dim, green, yellow)

// The store this project keeps, as the Rust side opens and works it. One operation per subcommand:
// the action has already run when the program performs it, so what comes back is what was done.
pub nondet effect store {
  read  statistics[r]() -> Result<Stats, Refusal>
  read  matches[r]()    -> Result<Matches, Refusal>
  write compacted[r]()  -> Result<Compacted, Refusal>
  write cleared[r]()    -> Result<Cleared, Refusal>
}

// --- What the Rust side answers with ----------------------------------------

// Why an action did not finish.
pub type Refusal = {
  // `None` when no store opened at all, which is the one refusal with no cache to name.
  directory: Option<String>,
  diags: List<Diag>,
  warnings: List<Diag>,
}

pub type Stats = {
  directory: String,
  // What the store degraded past on the way here; every subcommand reports them.
  warnings: List<Diag>,
  runtime_version: String,
  frontend_version: String,
  prover_version: String,
  root: String,
  results_file: String,
  frontend_file: String,
  frontend_data_file: String,
  // Whole microseconds; the report prints milliseconds.
  open_us: Int,
  results: Int,
  definitions_seen: Int,
  results_bytes: Int,
  obligations: Int,
  reviews: Int,
  sources: Int,
  defs: Int,
  decls: Int,
  bodies: Int,
  index_bytes: Int,
  data_bytes: Int,
  // `None` when the store cannot say which data bytes no index record names.
  garbage_bytes: Option<Int>,
}

pub type Pruned = { sources: Int, defs: Int, decls: Int, bodies: Int }

pub type Compacted = {
  directory: String,
  warnings: List<Diag>,
  files_kept: Int,
  dropped: Pruned,
  bytes_before: Int,
  bytes_after: Int,
  // The result cache, which compaction leaves alone.
  results: Int,
}

pub type Cleared = { directory: String, warnings: List<Diag>, cleared: Int }

pub type Kind = | AFn | AType | AnEffect | ATest(Bool)

pub type Witness = { name: String, hash: String }

pub type Body = { encoding: Int, bytes: Int }

pub type Variant = { name: String, fields: List<String> }

pub type Operation = {
  mode: String,
  name: String,
  resource: Bool,
  params: List<String>,
  ret: String,
}

// `Unrecorded` is a half-pruned cache, or slots written for other names.
pub type Interface =
  | OfFn(String)
  | OfType(Int, List<Variant>)
  | OfEffect(Bool, List<Operation>)
  | OfTest(Bool)
  | Unrecorded

pub type Outcome = | Passed | Failed(String)

pub type Entry = {
  // A definition's program-wide name, or a test's name as it was written.
  name: String,
  kind: Kind,
  hash: String,
  file: String,
  // `None` once the file has been edited: a stored span is a range into the bytes as cached.
  location: Option<String>,
  stale: Bool,
  interface: Interface,
  footprint: Option<List<String>>,
  witness: List<Witness>,
  body: Option<Body>,
  outcome: Option<Outcome>,
}

pub type Matches = { directory: String, warnings: List<Diag>, entries: List<Entry> }

// --- Small things -----------------------------------------------------------

fn at<a>(xs: List<a>, i: Int, spare: a) -> a = match list_at(xs, i) { Some(x) -> x, None -> spare }

fn appended<a>(head: List<a>, tail: List<a>) -> List<a> = fold(tail, head, |acc: List<a>, x: a| push(acc, x))

fn repeated(text: String, n: Int) -> String = fold(range(0, n), "", |acc: String, i: Int| acc ++ text)

fn joined(parts: List<String>, sep: String) -> String =
  fold(range(0, len(parts)), "", |acc: String, i: Int|
    if i == 0 { at(parts, i, "") } else { acc ++ sep ++ at(parts, i, "") })

fn padded(text: String, width: Int) -> String =
  if string_len(text) >= width { text } else { text ++ repeated(" ", width - string_len(text)) }

fn yes_no(flag: Bool) -> String = if flag { "yes" } else { "no" }

fn num(n: Int) -> Json = Number(decimal_of_int(n))

fn opt_num(v: Option<Int>) -> Json = match v { Some(n) -> num(n), None -> Null }

fn opt_str(v: Option<String>) -> Json = match v { Some(s) -> Str(s), None -> Null }

fn strings(xs: List<String>) -> Json = Array(map(xs, |x: String| Str(x)))

// --- Fixed point ------------------------------------------------------------
// Every number a report rounds is counted in whole units first, so a size and a share read the
// same on every machine.

fn pow10(places: Int) -> Int = fold(range(0, places), 1, |acc: Int, i: Int| acc * 10)

fn pow1024(k: Int) -> Int = fold(range(0, k), 1, |acc: Int, i: Int| acc * 1024)

fn zeros(n: Int, width: Int) -> String = {
  let digits = int_to_string(n);
  repeated("0", width - string_len(digits)) ++ digits
}

// `scaled` counts 10^places of a unit; this writes it as that unit with `places` decimals.
fn fixed(scaled: Int, places: Int) -> String = {
  let unit = pow10(places);
  int_to_string(scaled / unit) ++ "." ++ zeros(scaled % unit, places)
}

fn decimal(text: String) -> Json =
  match decimal_of_string(text) { Some(d) -> Number(d), None -> num(0) }

fn units() -> List<String> = ["B", "KB", "MB", "GB"]

// The largest unit `n` fills, capped at the last one named.
fn unit_of(n: Int) -> Int = fold(range(1, 4), 0, |acc: Int, k: Int| if n >= pow1024(k) { k } else { acc })

// A size as a person reads it: bytes exactly, and two decimals of the largest unit above that.
fn size_text(n: Int) -> String = {
  let unit = unit_of(n);
  let divisor = pow1024(unit);
  if unit == 0 { int_to_string(n) ++ " B" }
  else { fixed((n * 100 + divisor / 2) / divisor, 2) ++ " " ++ at(units(), unit, "B") }
}

// `part` of `whole`, counted in `per` of them; a whole of nothing is a share of nothing.
fn share(part: Int, whole: Int, per: Int) -> Int =
  if whole == 0 { 0 } else { (part * per + whole / 2) / whole }

// Suggested, never done: dropping an interface costs a recheck, and dead code tends to come back.
fn compact_suggested(st: Stats) -> Bool =
  match st.garbage_bytes { None -> false, Some(g) -> st.data_bytes > 0 && g * 2 > st.data_bytes }

// --- The refusals -----------------------------------------------------------

// One shape for every cache command, so an agent can key off `action` and `exit_code`.
fn stopped(s: Style, action: String, why: Refusal) -> Answer = {
  let head: List<Member> =
    [{ key: "command", value: Str("cache") },
     { key: "action", value: Str(action) },
     { key: "ok", value: Bool(false) },
     { key: "exit_code", value: num(compile_error()) },
     { key: "diagnostics", value: all_to_json(why.diags, []) }];
  // A store that never opened has no cache to name and raised no warning on the way.
  let body =
    match why.directory {
      None -> head,
      Some(dir) -> appended(head, [{ key: "directory", value: Str(dir) },
                                   { key: "warnings", value: all_to_json(why.warnings, []) }]),
    };
  { json: object(body), lines: warning_lines(s, why.warnings),
    errs: all_to_text(s, why.diags, []), code: compile_error() }
}

// `ply test` and `ply prove` fill the cache; a name no run has checked is simply not in it.
fn nothing_cached(query: String) -> Diag =
  { code: b"E0101", notes: 2, labels: [], text: b"",
    message: bytes_of_string("nothing cached under `" ++ query ++ "`"),
    notes_text: [b"a definition appears here only after a run that checked it: try `ply check` first",
                 b"the query is a program-wide name, a simple name, or a hash prefix of 4+ hex digits"],
    severity: b"error", fixes: [] }

// --- `ply cache stats` ------------------------------------------------------

fn frontend_json(st: Stats) -> Json = {
  let ratio =
    match st.garbage_bytes {
      None -> Null,
      Some(g) -> decimal(fixed(share(g, st.data_bytes, 1000000), 6)),
    };
  object([{ key: "sources", value: num(st.sources) },
          { key: "definitions", value: num(st.defs) },
          { key: "declarations", value: num(st.decls) },
          { key: "bodies", value: num(st.bodies) },
          { key: "index_bytes", value: num(st.index_bytes) },
          { key: "data_bytes", value: num(st.data_bytes) },
          { key: "garbage_bytes", value: opt_num(st.garbage_bytes) },
          { key: "garbage_ratio", value: ratio },
          { key: "compact_suggested", value: Bool(compact_suggested(st)) }])
}

fn stats_json(st: Stats) -> Json =
  object([{ key: "command", value: Str("cache") },
          { key: "action", value: Str("stats") },
          { key: "ok", value: Bool(true) },
          { key: "exit_code", value: num(ok_code()) },
          { key: "runtime_version", value: Str(st.runtime_version) },
          { key: "frontend_version", value: Str(st.frontend_version) },
          { key: "root", value: Str(st.root) },
          { key: "directory", value: Str(st.directory) },
          { key: "results_file", value: Str(st.results_file) },
          { key: "frontend_file", value: Str(st.frontend_file) },
          { key: "frontend_data_file", value: Str(st.frontend_data_file) },
          { key: "open_ms", value: decimal(fixed(st.open_us, 3)) },
          { key: "entries", value: num(st.results) },
          { key: "definitions_seen", value: num(st.definitions_seen) },
          { key: "results_bytes", value: num(st.results_bytes) },
          { key: "prover_version", value: Str(st.prover_version) },
          { key: "obligations", value: num(st.obligations) },
          { key: "reviews", value: num(st.reviews) },
          { key: "frontend", value: frontend_json(st) },
          { key: "warnings", value: all_to_json(st.warnings, []) }])

fn reclaimable(s: Style, st: Stats) -> String =
  match st.garbage_bytes {
    None -> dim(s, "— (this store cannot say what is unreachable)"),
    Some(g) ->
      dim(s, size_text(g) ++ " (" ++ int_to_string(share(g, st.data_bytes, 100)) ++ "%)"),
  }

fn stats_lines(s: Style, st: Stats) -> List<String> = {
  let opened = fixed(share(st.open_us, 1000, 100), 2) ++ "ms";
  let head =
    [ind() ++ dim(s, st.directory),
     ind() ++ "opened in " ++ bold(s, opened),
     ind() ++ "runtime " ++ st.runtime_version ++ " · " ++ bold(s, int_to_string(st.results))
       ++ " cached " ++ plural(st.results, "result") ++ " · " ++ count_of(st.definitions_seen, "definition")
       ++ " seen · " ++ dim(s, size_text(st.results_bytes)),
     ind() ++ "prover " ++ st.prover_version ++ " · " ++ bold(s, int_to_string(st.obligations))
       ++ " discharged " ++ plural(st.obligations, "obligation") ++ " · "
       ++ int_to_string(st.reviews) ++ " accepted " ++ plural(st.reviews, "review"),
     ind() ++ "front end " ++ st.frontend_version ++ " · " ++ bold(s, int_to_string(st.sources)) ++ " "
       ++ plural(st.sources, "file") ++ " · " ++ count_of(st.defs, "definition") ++ " · "
       ++ count_of(st.decls, "declaration") ++ " · " ++ count_of(st.bodies, "body"),
     ind() ++ "  index " ++ dim(s, size_text(st.index_bytes)) ++ " · data "
       ++ dim(s, size_text(st.data_bytes)) ++ " · reclaimable " ++ reclaimable(s, st)];
  let advised =
    if compact_suggested(st) {
      push(head, ind() ++ "  "
                 ++ yellow(s, "more than half the data file is unreachable; run `ply cache compact`"))
    } else { head };
  // A hybrid program earns a real cache entry, which a reader could mistake for corruption.
  if st.results == 0 { advised }
  else { push(advised, ind() ++ "  " ++ dim(s, "a result entry is one proven configuration, not one test")) }
}

// --- `ply cache compact` ----------------------------------------------------

fn reclaimed(c: Compacted) -> Int =
  if c.bytes_before > c.bytes_after { c.bytes_before - c.bytes_after } else { 0 }

fn compact_json(c: Compacted) -> Json =
  object([{ key: "command", value: Str("cache") },
          { key: "action", value: Str("compact") },
          { key: "ok", value: Bool(true) },
          { key: "exit_code", value: num(ok_code()) },
          { key: "directory", value: Str(c.directory) },
          { key: "files_kept", value: num(c.files_kept) },
          { key: "dropped", value: object([{ key: "sources", value: num(c.dropped.sources) },
                                           { key: "definitions", value: num(c.dropped.defs) },
                                           { key: "declarations", value: num(c.dropped.decls) },
                                           { key: "bodies", value: num(c.dropped.bodies) }]) },
          { key: "bytes_before", value: num(c.bytes_before) },
          { key: "bytes_after", value: num(c.bytes_after) },
          { key: "reclaimed_bytes", value: num(reclaimed(c)) },
          { key: "results", value: num(c.results) },
          { key: "warnings", value: all_to_json(c.warnings, []) }])

fn compact_lines(s: Style, c: Compacted) -> List<String> = {
  let d = c.dropped;
  let head = [ind() ++ green(s, "compacted") ++ " " ++ dim(s, c.directory)];
  // Only when something live was dropped; four zeroes would read as though nothing happened.
  let pruned =
    if d.sources + d.defs + d.decls + d.bodies == 0 { head }
    else {
      push(head, ind() ++ "  dropped " ++ count_of(d.sources, "file") ++ " · "
                 ++ count_of(d.defs, "definition") ++ " · " ++ count_of(d.decls, "declaration")
                 ++ " · " ++ count_of(d.bodies, "body"))
    };
  let sized =
    if reclaimed(c) == 0 {
      push(pruned, ind() ++ "  " ++ size_text(c.bytes_after) ++ " · " ++ dim(s, "nothing to reclaim"))
    } else {
      push(pruned, ind() ++ "  " ++ size_text(c.bytes_before) ++ " → " ++ size_text(c.bytes_after)
                   ++ " (" ++ bold(s, size_text(reclaimed(c))) ++ " reclaimed)")
    };
  push(sized, ind() ++ "  " ++ dim(s, "the result cache is untouched, so no test re-runs"))
}

// --- `ply cache clear` ------------------------------------------------------

fn clear_json(c: Cleared) -> Json =
  object([{ key: "command", value: Str("cache") },
          { key: "action", value: Str("clear") },
          { key: "ok", value: Bool(true) },
          { key: "exit_code", value: num(ok_code()) },
          { key: "directory", value: Str(c.directory) },
          { key: "cleared", value: num(c.cleared) },
          { key: "warnings", value: all_to_json(c.warnings, []) }])

fn clear_lines(s: Style, c: Cleared) -> List<String> =
  [ind() ++ green(s, "cleared") ++ " " ++ int_to_string(c.cleared) ++ " cached "
   ++ plural(c.cleared, "result") ++ " from " ++ dim(s, c.directory)]

// --- `ply cache inspect` ----------------------------------------------------

type Field = { label: String, value: String }

// As the reference prints a test's name: the bytes, with the ones that would close the quotes escaped.
fn quoted(text: String) -> String = {
  let b = bytes_of_string(text);
  string_of_bytes_lossy(bytes_concat_all([b"\"",
    bytes_concat_all(map(range(0, bytes_len(b)), |i: Int| {
      let c = bytes_at(b, i);
      if c == 34 { b"\\\"" } else if c == 92 { b"\\\\" } else if c == 10 { b"\\n" }
      else if c == 13 { b"\\r" } else if c == 9 { b"\\t" } else { bytes_slice(b, i, i + 1) }
    })), b"\""]))
}

fn short(hash: String) -> String =
  if string_len(hash) < 12 { hash } else { string_slice(hash, 0, 12) }

fn kind_text(k: Kind) -> String =
  match k {
    AFn -> "fn",
    AType -> "type",
    AnEffect -> "effect",
    ATest(nd) -> if nd { "test/nondet" } else { "test" },
  }

fn title_of(e: Entry) -> String = match e.kind { ATest(_) -> quoted(e.name), _ -> e.name }

fn where_of(e: Entry) -> String =
  match e.location {
    Some(l) -> l,
    None -> if e.stale { e.file ++ " (edited since)" } else { e.file },
  }

fn variant_text(v: Variant) -> String =
  if len(v.fields) == 0 { v.name } else { v.name ++ "(" ++ joined(v.fields, ", ") ++ ")" }

fn operation_text(o: Operation) -> String = {
  let resource = if o.resource { "[r]" } else { "" };
  o.mode ++ " " ++ o.name ++ resource ++ "(" ++ joined(o.params, ", ") ++ ") -> " ++ o.ret
}

fn braced(atoms: List<String>) -> String = "{" ++ joined(atoms, ", ") ++ "}"

// The label is blank on continuation lines, so a multi-variant type reads as one block.
fn listed(label: String, values: List<String>) -> List<Field> =
  map(range(0, len(values)), |i: Int|
    { label: if i == 0 { label } else { "" }, value: at(values, i, "") })

fn rows_of(e: Entry) -> List<Field> = {
  let shape =
    match e.interface {
      OfFn(ty) -> [{ label: "type", value: ty }],
      OfType(parameters, variants) ->
        appended([{ label: "parameters", value: int_to_string(parameters) }],
                 listed("variants", map(variants, variant_text))),
      OfEffect(nd, ops) ->
        appended([{ label: "nondet", value: yes_no(nd) }],
                 listed("operations", map(ops, operation_text))),
      OfTest(nd) -> [{ label: "nondet", value: yes_no(nd) }],
      Unrecorded -> [{ label: "interface", value: "— nothing cached under this hash for this name" }],
    };
  match e.footprint {
    Some(atoms) -> push(shape, { label: "footprint", value: braced(atoms) }),
    None -> shape,
  }
}

fn not_a_test(e: Entry) -> String =
  match e.interface {
    OfTest(nd) ->
      if nd { "— `test/nondet` is never cached" }
      else { "— not proven at this hash, so it runs next time" },
    _ -> "— not a test",
  }

fn result_line(e: Entry) -> String =
  match e.outcome {
    Some(Passed) -> "passed — this hash will not re-run",
    Some(Failed(message)) -> "failed: " ++ message,
    None -> not_a_test(e),
  }

fn witness_line(e: Entry) -> String =
  if len(e.witness) == 0 { "— mentions nothing this cache had to record" }
  else { joined(map(e.witness, |w: Witness| w.name ++ " → " ++ short(w.hash)), ", ") }

fn body_line(e: Entry) -> String =
  match e.body {
    Some(b) -> count_of(b.bytes, "byte") ++ " (encoding " ++ int_to_string(b.encoding) ++ ")",
    None -> "— not stored, so this definition cannot join a hybrid",
  }

fn under(label: String, value: String) -> String = ind() ++ "  " ++ padded(label, 10) ++ " " ++ value

fn entry_lines(s: Style, e: Entry) -> List<String> = {
  let head = ind() ++ bold(s, title_of(e)) ++ "  " ++ dim(s, short(e.hash)) ++ "  " ++ kind_text(e.kind)
             ++ "  " ++ dim(s, where_of(e));
  let shape = fold(rows_of(e), [head], |acc: List<String>, f: Field| push(acc, under(f.label, f.value)));
  appended(shape, [under("witness", witness_line(e)), under("body", body_line(e)),
                   under("result", result_line(e))])
}

fn interface_json(i: Interface) -> Json =
  match i {
    OfFn(ty) -> object([{ key: "type", value: Str(ty) }]),
    OfType(parameters, variants) ->
      object([{ key: "parameters", value: num(parameters) },
              { key: "variants", value: strings(map(variants, variant_text)) }]),
    OfEffect(nd, ops) ->
      object([{ key: "nondet", value: Bool(nd) },
              { key: "operations", value: strings(map(ops, operation_text)) }]),
    OfTest(nd) -> object([{ key: "nondet", value: Bool(nd) }]),
    Unrecorded -> Null,
  }

fn footprint_json(f: Option<List<String>>) -> Json =
  match f { Some(atoms) -> strings(atoms), None -> Null }

fn body_json(b: Option<Body>) -> Json =
  match b {
    Some(v) -> object([{ key: "encoding", value: num(v.encoding) }, { key: "bytes", value: num(v.bytes) }]),
    None -> Null,
  }

fn entry_json(e: Entry) -> Json =
  object([{ key: "name", value: Str(title_of(e)) },
          { key: "hash", value: Str(short(e.hash)) },
          { key: "kind", value: Str(kind_text(e.kind)) },
          { key: "file", value: Str(e.file) },
          { key: "location", value: opt_str(e.location) },
          { key: "stale", value: Bool(e.stale) },
          { key: "interface", value: interface_json(e.interface) },
          { key: "footprint", value: footprint_json(e.footprint) },
          { key: "witness", value: Array(map(e.witness, |w: Witness|
              object([{ key: "name", value: Str(w.name) },
                      { key: "hash", value: Str(w.hash) }]))) },
          { key: "body", value: body_json(e.body) },
          { key: "result", value: Str(result_line(e)) }])

// Independent of the store's iteration order, so the report is the same twice running.
fn before(a: Entry, b: Entry) -> Bool =
  match compare_values(a.name, b.name) {
    Less -> true,
    Greater -> false,
    Equal ->
      match compare_values(a.hash, b.hash) {
        Less -> true,
        Greater -> false,
        Equal -> match compare_values(a.file, b.file) { Less -> true, _ -> false },
      },
  }

fn ordered(xs: List<Entry>) -> List<Entry> =
  fold(xs, [], |acc: List<Entry>, x: Entry| {
    let n = len(acc);
    let i = fold(range(0, n), n, |p: Int, j: Int|
      if p < n { p } else if before(x, at(acc, j, x)) { j } else { p });
    appended(push(map(range(0, i), |j: Int| at(acc, j, x)), x),
             map(range(i, n), |j: Int| at(acc, j, x)))
  })

fn inspect_json(query: String, m: Matches, entries: List<Entry>) -> Json =
  object([{ key: "command", value: Str("cache") },
          { key: "action", value: Str("inspect") },
          { key: "ok", value: Bool(true) },
          { key: "exit_code", value: num(ok_code()) },
          { key: "query", value: Str(query) },
          { key: "directory", value: Str(m.directory) },
          { key: "matches", value: Array(map(entries, entry_json)) },
          { key: "warnings", value: all_to_json(m.warnings, []) }])

fn inspect_lines(s: Style, query: String, entries: List<Entry>) -> List<String> = {
  let body = fold(entries, [], |acc: List<String>, e: Entry|
    appended(if len(acc) == 0 { acc } else { push(acc, "") }, entry_lines(s, e)));
  if len(entries) < 2 { body }
  else {
    appended(body, ["", ind() ++ dim(s, count_of(len(entries), "entry") ++ " matched `" ++ query ++ "`")])
  }
}

// --- The command ------------------------------------------------------------

fn stats_answer(s: Style, answer: Result<Stats, Refusal>) -> Answer =
  match answer {
    Err(why) -> stopped(s, "stats", why),
    Ok(st) -> { json: stats_json(st), lines: appended(warning_lines(s, st.warnings), stats_lines(s, st)),
                errs: [], code: ok_code() },
  }

fn compact_answer(s: Style, answer: Result<Compacted, Refusal>) -> Answer =
  match answer {
    Err(why) -> stopped(s, "compact", why),
    Ok(c) -> { json: compact_json(c), lines: appended(warning_lines(s, c.warnings), compact_lines(s, c)),
               errs: [], code: ok_code() },
  }

fn clear_answer(s: Style, answer: Result<Cleared, Refusal>) -> Answer =
  match answer {
    Err(why) -> stopped(s, "clear", why),
    Ok(c) -> { json: clear_json(c), lines: appended(warning_lines(s, c.warnings), clear_lines(s, c)),
               errs: [], code: ok_code() },
  }

fn matched(s: Style, query: String, m: Matches) -> Answer = {
  let entries = ordered(m.entries);
  if len(entries) == 0 {
    stopped(s, "inspect", { directory: Some(m.directory), diags: [nothing_cached(query)],
                            warnings: m.warnings })
  } else {
    { json: inspect_json(query, m, entries),
      lines: appended(warning_lines(s, m.warnings), inspect_lines(s, query, entries)),
      errs: [], code: ok_code() }
  }
}

fn inspect_answer(s: Style, query: String, answer: Result<Matches, Refusal>) -> Answer =
  match answer {
    Err(why) -> stopped(s, "inspect", why),
    Ok(m) -> matched(s, query, m),
  }

// `clap` has already refused a word that is not one of the four, so the last arm is `inspect`.
pub fn run(flags: Flags) -> Answer
  / {store.statistics[cache], store.matches[cache], store.compacted[cache], store.cleared[cache]} = {
  let s: Style = style_of(flags);
  if flags.action == "stats" { stats_answer(s, store.statistics[cache]()) }
  else if flags.action == "compact" { compact_answer(s, store.compacted[cache]()) }
  else if flags.action == "clear" { clear_answer(s, store.cleared[cache]()) }
  else { inspect_answer(s, flags.query, store.matches[cache]()) }
}

// --- Tests ------------------------------------------------------------------

fn no_stats() -> Stats =
  { directory: "/p/.ply-cache", warnings: [], runtime_version: "0.16.0", frontend_version: "0.26.0",
    prover_version: "0.7.0", root: "/p", results_file: "/p/.ply-cache/results.json",
    frontend_file: "/p/.ply-cache/frontend.idx",
    frontend_data_file: "/p/.ply-cache/frontend.dat", open_us: 0, results: 0, definitions_seen: 0,
    results_bytes: 0, obligations: 0, reviews: 0, sources: 0, defs: 0, decls: 0, bodies: 0,
    index_bytes: 0, data_bytes: 0, garbage_bytes: None }

fn an_entry() -> Entry =
  { name: "m.active", kind: AFn, hash: "9f2c1a4e8b03c7d5e6f70819a2b3c4d5", file: "m.ply",
    location: Some("m.ply:4:1"), stale: false, interface: OfFn("(Int) -> List<Int>"),
    footprint: None, witness: [], body: None, outcome: None }

test "a size is exact in bytes and two decimals above that" {
  assert_eq(size_text(0), "0 B");
  assert_eq(size_text(999), "999 B");
  assert_eq(size_text(1024), "1.00 KB");
  assert_eq(size_text(12750000), "12.16 MB")
}

test "a half-wasted data file is where compaction starts being suggested" {
  let half: Stats = {..no_stats(), data_bytes: 1000, garbage_bytes: Some(400)};
  assert(!compact_suggested(half));
  assert(compact_suggested({..half, garbage_bytes: Some(501)}));
  // An unmeasurable share is not a reason to suggest anything.
  assert(!compact_suggested({..half, garbage_bytes: None}))
}

test "the statistics read as four lines and the sizes under them" {
  let st: Stats =
    {..no_stats(), open_us: 1234, results: 2, definitions_seen: 3, results_bytes: 2048,
     obligations: 1, reviews: 0, sources: 1, defs: 4, decls: 1, bodies: 4, index_bytes: 512,
     data_bytes: 1000, garbage_bytes: Some(250)};
  let lines = stats_lines(plain(), st);
  assert_eq(at(lines, 0, ""), "   /p/.ply-cache");
  assert_eq(at(lines, 1, ""), "   opened in 1.23ms");
  assert_eq(at(lines, 2, ""), "   runtime 0.16.0 · 2 cached results · 3 definitions seen · 2.00 KB");
  assert_eq(at(lines, 3, ""), "   prover 0.7.0 · 1 discharged obligation · 0 accepted reviews");
  assert_eq(at(lines, 4, ""), "   front end 0.26.0 · 1 file · 4 definitions · 1 declaration · 4 bodies");
  assert_eq(at(lines, 5, ""), "     index 512 B · data 1000 B · reclaimable 250 B (25%)");
  assert_eq(at(lines, 6, ""), "     a result entry is one proven configuration, not one test")
}

test "a store that cannot say what is unreachable says so instead of a figure" {
  let lines = stats_lines(plain(), {..no_stats(), index_bytes: 1, data_bytes: 2});
  assert_eq(at(lines, 5, ""),
            "     index 1 B · data 2 B · reclaimable — (this store cannot say what is unreachable)");
  // Nothing cached, so the note about what an entry counts is withheld.
  assert_eq(len(lines), 6)
}

test "compaction that dropped nothing and reclaimed nothing still says what it did" {
  let c: Compacted =
    { directory: "/p/.ply-cache", warnings: [], files_kept: 1,
      dropped: { sources: 0, defs: 0, decls: 0, bodies: 0 }, bytes_before: 900, bytes_after: 900,
      results: 2 };
  assert_eq(compact_lines(plain(), c),
            ["   compacted /p/.ply-cache",
             "     900 B · nothing to reclaim",
             "     the result cache is untouched, so no test re-runs"]);
  let swept: Compacted = {..c, dropped: { sources: 1, defs: 2, decls: 0, bodies: 2 }, bytes_after: 400};
  assert_eq(compact_lines(plain(), swept),
            ["   compacted /p/.ply-cache",
             "     dropped 1 file · 2 definitions · 0 declarations · 2 bodies",
             "     900 B → 400 B (500 B reclaimed)",
             "     the result cache is untouched, so no test re-runs"])
}

test "clearing names the count it discarded and where from" {
  assert_eq(clear_lines(plain(), { directory: "/p/.ply-cache", warnings: [], cleared: 1 }),
            ["   cleared 1 cached result from /p/.ply-cache"]);
  assert_eq(clear_lines(plain(), { directory: "/p/.ply-cache", warnings: [], cleared: 0 }),
            ["   cleared 0 cached results from /p/.ply-cache"])
}

test "a function's entry prints its resolved type rather than a serialization" {
  let e: Entry = {..an_entry(), footprint: Some(["m.db.read[users]"])};
  assert_eq(entry_lines(plain(), e),
            ["   m.active  9f2c1a4e8b03  fn  m.ply:4:1",
             "     type       (Int) -> List<Int>",
             "     footprint  {m.db.read[users]}",
             "     witness    — mentions nothing this cache had to record",
             "     body       — not stored, so this definition cannot join a hybrid",
             "     result     — not a test"])
}

test "an edited file withholds a line and column rather than guessing" {
  let stale: Entry = {..an_entry(), location: None, stale: true};
  assert_eq(at(entry_lines(plain(), stale), 0, ""),
            "   m.active  9f2c1a4e8b03  fn  m.ply (edited since)")
}

test "an effect declaration is one row per operation, and a type one per variant" {
  let ops = [{ mode: "read", name: "now", resource: false, params: [], ret: "Int" },
             { mode: "write", name: "set", resource: true, params: ["Int"], ret: "Unit" }];
  let e: Entry = {..an_entry(), name: "m.wall", kind: AnEffect, interface: OfEffect(true, ops)};
  assert_eq(rows_of(e),
            [{ label: "nondet", value: "yes" },
             { label: "operations", value: "read now() -> Int" },
             { label: "", value: "write set[r](Int) -> Unit" }]);
  let shape: Entry =
    {..an_entry(), name: "m.Shape", kind: AType,
     interface: OfType(1, [{ name: "Circle", fields: ["Int"] }, { name: "Empty", fields: [] }])};
  assert_eq(rows_of(shape),
            [{ label: "parameters", value: "1" },
             { label: "variants", value: "Circle(Int)" },
             { label: "", value: "Empty" }])
}

test "a half-pruned cache says the interface is missing rather than printing nothing" {
  assert_eq(rows_of({..an_entry(), interface: Unrecorded}),
            [{ label: "interface", value: "— nothing cached under this hash for this name" }])
}

test "a test's result line says whether this very hash is proven" {
  let unproven: Entry = {..an_entry(), name: "one is one", kind: ATest(false), interface: OfTest(false)};
  assert_eq(result_line(unproven), "— not proven at this hash, so it runs next time");
  assert_eq(result_line({..unproven, kind: ATest(true), interface: OfTest(true)}),
            "— `test/nondet` is never cached");
  assert_eq(result_line({..unproven, outcome: Some(Passed)}), "passed — this hash will not re-run");
  assert_eq(result_line({..unproven, outcome: Some(Failed("1 != 2"))}), "failed: 1 != 2");
  assert_eq(title_of(unproven), "\"one is one\"");
  assert_eq(kind_text(ATest(true)), "test/nondet")
}

test "a name declared twice is ordered by name, then hash, then file" {
  let alpha: Entry = {..an_entry(), name: "alpha.shared", hash: "bb", file: "alpha.ply"};
  let beta: Entry = {..an_entry(), name: "beta.shared", hash: "aa", file: "beta.ply"};
  let twin: Entry = {..an_entry(), name: "alpha.shared", hash: "aa", file: "alpha.ply"};
  assert_eq(map(ordered([beta, alpha, twin]), |e: Entry| e.hash), ["aa", "bb", "aa"]);
  assert_eq(map(ordered([alpha, twin, beta]), |e: Entry| e.name),
            ["alpha.shared", "alpha.shared", "beta.shared"])
}

test "a second match is separated by a blank line and counted under both" {
  let one: Entry = {..an_entry(), name: "alpha.shared", file: "alpha.ply"};
  let two: Entry = {..an_entry(), name: "beta.shared", file: "beta.ply"};
  let lines = inspect_lines(plain(), "shared", [one, two]);
  assert_eq(at(lines, 5, "?"), "");
  assert_eq(at(lines, len(lines) - 1, ""), "   2 entries matched `shared`");
  assert_eq(len(inspect_lines(plain(), "shared", [one])), 5)
}

// The run's own answer, over a store the test hands it in place of the Rust side.
fn answered_over(flags: Flags, answer: Result<Stats, Refusal>, hits: Result<Matches, Refusal>,
                 swept: Result<Compacted, Refusal>, emptied: Result<Cleared, Refusal>) -> Answer =
  handle {
    run(flags)
  } with {
    store.statistics[cache]() -> answer,
    store.matches[cache]() -> hits,
    store.compacted[cache]() -> swept,
    store.cleared[cache]() -> emptied,
  }

fn nowhere() -> Refusal = { directory: None, diags: [], warnings: [] }

fn flags_of(action: String, query: String, json: Bool) -> Flags =
  {..no_flags(), action: action, query: query, json: json}

fn only_stats(flags: Flags, st: Stats) -> Answer =
  answered_over(flags, Ok(st), Err(nowhere()), Err(nowhere()), Err(nowhere()))

test "the action picks the subcommand, and its object keys off `command` and `action`" {
  let answer = only_stats(flags_of("stats", "", true), {..no_stats(), results: 2, data_bytes: 8});
  assert_eq(answer.code, 0);
  assert_eq(answer.errs, []);
  let text = to_string(answer.json);
  assert(string_contains(text, "\"command\":\"cache\""));
  assert(string_contains(text, "\"action\":\"stats\""));
  assert(string_contains(text, "\"exit_code\":0"));
  assert(string_contains(text, "\"entries\":2"));
  assert(string_contains(text, "\"compact_suggested\":false"));
  assert(string_contains(text, "\"runtime_version\":\"0.16.0\""))
}

test "a store that never opened is exit 2 and names no cache" {
  let why: Refusal =
    { directory: None,
      diags: [{ code: b"E0502", notes: 0, labels: [], text: b"",
                message: b"could not open a cache under `/p`", notes_text: [], severity: b"error",
                fixes: [] }],
      warnings: [] };
  let answer = answered_over(flags_of("clear", "", false), Err(why), Err(why), Err(why), Err(why));
  assert_eq(answer.code, 2);
  assert_eq(answer.lines, []);
  assert_eq(answer.errs, ["Error[E0502]: could not open a cache under `/p`"]);
  assert(!string_contains(to_string(answer.json), "\"directory\""))
}

test "a refusal after the store opened names the cache and carries its warnings" {
  let why: Refusal =
    { directory: Some("/p/.ply-cache"),
      diags: [{ code: b"E0502", notes: 0, labels: [], text: b"",
                message: b"could not compact the cache at `/p/.ply-cache`", notes_text: [],
                severity: b"error", fixes: [] }],
      warnings: [{ code: b"W0603", notes: 0, labels: [], text: b"",
                   message: b"the front-end cache was discarded", notes_text: [],
                   severity: b"warning", fixes: [] }] };
  let answer = answered_over(flags_of("compact", "", false), Err(why), Err(why), Err(why), Err(why));
  assert_eq(answer.code, 2);
  assert_eq(answer.lines, ["   warning: the front-end cache was discarded"]);
  let text = to_string(answer.json);
  assert(string_contains(text, "\"action\":\"compact\""));
  assert(string_contains(text, "\"directory\":\"/p/.ply-cache\""));
  assert(string_contains(text, "\"W0603\""))
}

test "inspecting a name nothing cached is E0101 and exits two" {
  let empty: Matches = { directory: "/p/.ply-cache", warnings: [], entries: [] };
  let answer =
    answered_over(flags_of("inspect", "no_such_thing", false), Err(nowhere()), Ok(empty),
                  Err(nowhere()), Err(nowhere()));
  assert_eq(answer.code, 2);
  assert_eq(answer.lines, []);
  assert_eq(answer.errs,
            ["Error[E0101]: nothing cached under `no_such_thing`",
             "  = a definition appears here only after a run that checked it: try `ply check` first",
             "  = the query is a program-wide name, a simple name, or a hash prefix of 4+ hex digits"])
}

test "a match is one object under `matches`, with the hash shortened and the type resolved" {
  let hits: Matches = { directory: "/p/.ply-cache", warnings: [], entries: [an_entry()] };
  let answer =
    answered_over(flags_of("inspect", "active", true), Err(nowhere()), Ok(hits), Err(nowhere()),
                  Err(nowhere()));
  assert_eq(answer.code, 0);
  let text = to_string(answer.json);
  assert(string_contains(text, "\"query\":\"active\""));
  assert(string_contains(text, "\"name\":\"m.active\""));
  assert(string_contains(text, "\"hash\":\"9f2c1a4e8b03\""));
  assert(string_contains(text, "\"kind\":\"fn\""));
  assert(string_contains(text, "\"stale\":false"));
  assert(string_contains(text, "\"type\":\"(Int) -> List<Int>\""))
}
