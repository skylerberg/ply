// The runtime's machines, as the one capability the program's commands drive: a label's machine
// loads the target rooted at a path, binds the hosts an entry may reach, enters it, and tears
// the binding down, and every answer crosses as a value. `run` drives a whole program this way;
// the other commands' batches are their own effects over the same thread.

import cmdline
import cmdline (Parsed, has, nth_of, parse_nat, value, values_of)
import compiler.resolve (Diag)
import diagnostic (Place)
import entry (Main, Module)
import std.json (Json)

// What the Rust side loads, binds, enters and tears down, in that order and each once. The
// binding lives on the thread the entry runs on, which is why binding and entering are two
// operations: what a run may reach has to be disclosed before it reaches any of it.
pub nondet effect machine {
  write configure[m](options: Options) -> Unit
  read load[m](root: String) -> Result<Target, Refusal>
  read reload[m]() -> Result<Target, Refusal>
  read bound[m](entry: String) -> Result<Bound, Refusal>
  write enter[m]() -> Ended
  write drop[m]() -> Unit
}

// --- What a machine is configured with ----------------------------------------

// The host a run binds, and how: every group of §14's flags as a value. The program parses and
// validates; the machine reads typed fields. This is the one record every machine-driving
// command shares; each reads the subset its command takes.
pub type TlsCred = { name: String, cert: String, key: String }
pub type Named = { name: String, path: String }

pub type DbOpts = {
  url: Option<String>,
  pool: Option<Int>,
  acquire_ms: Option<Int>,
  statement_ms: Option<Int>,
  idle_txn_ms: Option<Int>,
  connect_ms: Option<Int>,
  statement_cache: Option<Int>,
  schema: Option<String>,
}

pub type ConfigOpts = { set: List<String>, files: List<String>, schema: Option<String> }
pub type TraceOpts = { sink: String, level: String }

pub type Options = {
  host: Bool,
  // `--json`: stdout is the one document's, so the entry's own lines go to stderr.
  json: Bool,
  tls: List<TlsCred>,
  trust: List<String>,
  fs: List<Named>,
  exec: List<Named>,
  db: DbOpts,
  config: ConfigOpts,
  trace: TraceOpts,
  drain_ms: Int,
  drain_lead_ms: Int,
  steps: Int,
  timeout: Int,
  seed: Option<String>,
  backend: Option<String>,
  profile: String,
  argv: List<String>,
  cache: Bool,
}

pub fn no_options() -> Options =
  {
    host: false,
    json: false,
    tls: [],
    trust: [],
    fs: [],
    exec: [],
    db: {
      url: None,
      pool: None,
      acquire_ms: None,
      statement_ms: None,
      idle_txn_ms: None,
      connect_ms: None,
      statement_cache: None,
      schema: None,
    },
    config: { set: [], files: [], schema: None },
    trace: { sink: "json", level: "info" },
    drain_ms: 30000,
    drain_lead_ms: 0,
    steps: 0,
    timeout: 0,
    seed: None,
    backend: None,
    profile: "development",
    argv: [],
    cache: false,
  }

// --- What the Rust side answers with ----------------------------------------

pub type Refusal = {
  diags: List<Diag>,
  places: List<Place>,
  // The file the refusal is about, when a `.plyx` was named and is not one. A program that does
  // not compile is refused over its own sources instead, and names no file here.
  artifact: Option<String>,
}

// What this run runs: a project the front end loaded, or an artifact opened from a file.
pub type Target = | Project(Program) | Deployed(Artifact)

pub type Program = {
  // The root the load was rooted at, as a report prints it.
  root: String,
  files: List<String>,
  places: List<Place>,
  mains: List<Main>,
  modules: List<Module>,
}

pub type Artifact = {
  path: String,
  digest: String,
  entry: String,
  definitions: Int,
  // Whether the container carries a compiled unit this runtime can enter.
  unit: Bool,
  warnings: List<Diag>,
}

// What the binding discloses before anything runs. A hermetic run discloses nothing, because
// there is nothing it could reach.
pub type Bound = {
  hermetic: Bool,
  operations: Int,
  digest: String,
  // The banner each facility that discloses one writes for itself.
  config: Option<String>,
  trace: Option<String>,
  database: Option<String>,
  // Only a run with `--host` listens for a signal.
  signals: Option<Signals>,
  warnings: List<Diag>,
}

pub type Signals = { names: List<String>, lead_ms: Int, drain_ms: Int }

// What the machine reused. `in_place` is `None` when nothing was updated at all, which is not a
// ratio of zero.
pub type Counters = { updates: Int, updates_in_place: Int, in_place: Option<Decimal>, cycles: Int }

// What was in flight when a signal asked the run to stop; `None` when nobody asked.
pub type Stopping = {
  signal: Option<String>,
  listeners: Int,
  connections: Int,
  scopes: Int,
  elapsed_ms: Int,
}

// What the run was given to stop in, and what the teardown did with it.
pub type Teardown = {
  lead_ms: Int,
  drain_ms: Int,
  transactions_rolled_back: Int,
  connections_closed: Int,
  spans_abandoned: Int,
  problems: List<String>,
}

pub type Trace = { events: Int, spans: Int, abandoned: Int, flushed: Bool }

// What the entry did, once the binding is torn down.
pub type Ended = {
  // The code `process.exit` asked for: the program chose it and returned no value.
  exit: Option<Int>,
  // The value the entry answered with, as the reference prints it.
  value: Option<String>,
  raised: Option<Diag>,
  counters: Counters,
  // A cycle among escaped values is never collected, so only this run can report it.
  cycles: List<Diag>,
  stopping: Option<Stopping>,
  teardown: Teardown,
  trace: Option<Trace>,
  handshakes: List<String>,
  // The host's own disclosure documents, placed under the keys this report gives them.
  hosts: Json,
  configuration: Json,
}

// --- The options record, built from the parsed line -----------------------------------------

fn opt_text(p: Parsed, long: String) -> Option<String> = value(p, long)

fn opt_int(p: Parsed, long: String) -> Option<Int> =
  match value(p, long) { Some(v) -> parse_nat(v), None -> None }

fn int_of(p: Parsed, long: String, default: Int) -> Int =
  match opt_int(p, long) { Some(n) -> n, None -> default }

// `--tls api=cert.pem,key.pem` as a credential record.
fn creds(p: Parsed) -> List<TlsCred> =
  map(values_of(p, "tls"), |text: String|
    match cut_pair(text) {
      Some(pair) -> match pair {
        (name, paths) -> match split_once(paths, ",") {
          Some(pp) -> match pp { (cert, key) -> { name: name, cert: cert, key: key } },
          None -> { name: name, cert: "", key: "" },
        },
      },
      None -> { name: "", cert: "", key: "" },
    })

fn named_paths(p: Parsed, long: String) -> List<Named> =
  map(values_of(p, long), |text: String|
    match cut_pair(text) {
      Some(pair) -> match pair { (name, path) -> { name: name, path: path } },
      None -> { name: "", path: "" },
    })

// `NAME=VALUE`: the pair on the first `=`.
fn cut_pair(text: String) -> Option<(String, String)> =
  match cmdline::cut_once(text, "=") { Some(cut) -> Some((cut.head, cut.tail)), None -> None }

fn split_once(text: String, sep: String) -> Option<(String, String)> =
  match cmdline::cut_once(text, sep) { Some(cut) -> Some((cut.head, cut.tail)), None -> None }

// The whole options record, from the parsed line. Each command's machine reads the subset its
// flags cover; the parser already refused a flag the command does not take.
pub fn options_from(p: Parsed) -> Options =
  {
    host: has(p, "host"),
    json: has(p, "json"),
    tls: creds(p),
    trust: values_of(p, "trust"),
    fs: named_paths(p, "fs"),
    exec: named_paths(p, "exec"),
    db: {
      url: opt_text(p, "db"),
      pool: opt_int(p, "db-pool"),
      acquire_ms: opt_int(p, "db-acquire-ms"),
      statement_ms: opt_int(p, "db-statement-ms"),
      idle_txn_ms: opt_int(p, "db-idle-txn-ms"),
      connect_ms: opt_int(p, "db-connect-ms"),
      statement_cache: opt_int(p, "db-statement-cache"),
      schema: opt_text(p, "db-schema"),
    },
    config: {
      set: values_of(p, "set"),
      files: values_of(p, "config"),
      schema: opt_text(p, "config-schema"),
    },
    trace: {
      sink: match value(p, "trace") { Some(s) -> s, None -> "json" },
      level: match value(p, "trace-level") { Some(l) -> l, None -> "info" },
    },
    drain_ms: int_of(p, "drain-ms", 30000),
    drain_lead_ms: int_of(p, "drain-lead-ms", 0),
    steps: int_of(p, "steps", 0),
    timeout: int_of(p, "timeout", 0),
    seed: opt_text(p, "seed"),
    backend: opt_text(p, "backend"),
    profile: match value(p, "profile") { Some(pr) -> pr, None -> "development" },
    argv: p.argv,
    cache: true,
  }
