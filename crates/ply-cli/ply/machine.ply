// The runtime's machines, as the one capability the program's commands drive: a label's machine
// loads the target rooted at a path, binds the hosts an entry may reach, enters it, and tears
// the binding down, and every answer crosses as a value. `run` drives a whole program this way;
// the other commands' batches are their own effects over the same thread.

import cmdline
import cmdline (Parsed, has, nth_of, parse_nat, value, values_of)
import cache (Front)
import compiler.resolve (Diag)
import diagnostic (Place, Raised)
import entry (Main, Module)
import std.json (Json)
import std.value (Value)

// What the Rust side loads, binds, enters and tears down, in that order and each once. The
// binding lives on the thread the entry runs on, which is why binding and entering are two
// operations: what a run may reach has to be disclosed before it reaches any of it.
pub nondet effect machine {
  write configure[m](options: Options) -> Unit
  // `keep` is the key the front is filed under once the load holds, for a later run of the same
  // closure to take in place of its front end.
  read load[m](root: String, front: Option<Front>, keep: Option<String>) -> Result<Target, Refusal>
  // The load an earlier run filed under the walk's key, over this run's own files; `None` when
  // nothing readable is filed there, and the label is left for a load over a front end.
  read reuse[m](root: String, walked: Walked) -> Option<Target>
  read reload[m](front: Front) -> Result<Target, Refusal>
  read bound[m](entry: String) -> Result<Bound, Refusal>
  write enter[m]() -> Ended
  read call[m](name: String, args: List<Value>) -> Result<Value, Raised>
  read accounting[m]() -> Accounting
  write drop[m]() -> Unit
}

// A run's walk as `reuse` takes it: the key it hashes to with the toolchain, the modules it read,
// the root's and then each dependency's, and the manifests. A front end places the shelf it
// pulled between the two, and the filed answer says which modules those were.
pub type Walked = { key: String, modules: List<Place>, manifests: List<Place> }

// What the machine measured since it was last asked: the calls the runtime counted, the wall
// clock those calls took, and the reuse counters they left behind. Reading it resets it.
pub type Accounting = { steps: Int, micros: Int, counters: Counters }

// --- What a machine is configured with ----------------------------------------

// The host a run binds, and how: every group of §14's flags as a value. The program parses and
// validates; the machine reads typed fields. This is the one record every machine-driving
// command shares; each reads the subset its command takes.
pub type TlsCred = { name: String, cert: String, key: String }
pub type Named = { name: String, path: String }

pub type ConfigOpts = { set: List<String>, files: List<String>, schema: Option<String> }

// The search a simulated test or law runs, as §9's flags say it: every field is in the key of what
// it proves. `roots` are the seeds searched, from `from` up to but not including `to`.
pub type SimOpts = {
  seed: Option<String>,
  mode: String,
  roots: Option<{ from: Int, to: Int }>,
  budget: Option<Int>,
  steps: Option<Int>,
  measure_reduction: Bool,
}
pub type TraceOpts = { sink: String, level: String }

pub type Options = {
  host: Bool,
  // `--json`: stdout is the one document's, so the entry's own lines go to stderr.
  json: Bool,
  tls: List<TlsCred>,
  trust: List<String>,
  fs: List<Named>,
  exec: List<Named>,
  // The privileged families `--allow` granted the program this run drives, by name; a host lends
  // only what the program declares.
  allow: List<String>,
  config: ConfigOpts,
  trace: TraceOpts,
  drain_ms: Int,
  drain_lead_ms: Int,
  steps: Int,
  timeout: Int,
  seed: Option<String>,
  profile: String,
  argv: List<String>,
}

/// Every default a machine-driving command takes when its flags say nothing. One record, so a
/// program that is not the CLI — a benchmark, a harness, a corpus module — can drive a machine
/// without inventing a second copy of the defaults, and the CLI's own parse below spreads over it.
pub fn default_options() -> Options =
  {
    host: false,
    json: false,
    tls: [],
    trust: [],
    fs: [],
    exec: [],
    allow: [],
    config: { set: [], files: [], schema: None },
    trace: { sink: "json", level: "info" },
    drain_ms: 30000,
    drain_lead_ms: 0,
    steps: 0,
    timeout: 0,
    seed: None,
    profile: "development",
    argv: [],
  }

// --- Tests ------------------------------------------------------------------

test "the defaults are one record" {
  assert_eq(default_options().profile, "development");
  assert_eq(default_options().steps, 0);
  assert_eq(default_options().drain_ms, 30000);
  assert_eq(default_options().trace.level, "info")
}

// --- What the Rust side answers with ----------------------------------------

pub type Refusal = {
  diags: List<Diag>,
  places: List<Place>,
  // The file the refusal is about, when a `.plyx` was named and is not one. A program that does
  // not compile is refused over its own sources instead, and names no file here.
  artifact: Option<String>,
}

// What this run runs: a project the front end loaded, or an artifact opened from a file.
pub type Target = | Project(Program) | Deployed(Artifact)

pub type Program = {
  // The root the load was rooted at, as a report prints it.
  root: String,
  files: List<String>,
  places: List<Place>,
  mains: List<Main>,
  modules: List<Module>,
}

pub type Artifact = {
  path: String,
  digest: String,
  entry: String,
  definitions: Int,
  // Whether the container carries a compiled unit this runtime can enter.
  unit: Bool,
  warnings: List<Diag>,
}

// What the binding discloses before anything runs. A hermetic run discloses nothing, because
// there is nothing it could reach.
pub type Bound = {
  hermetic: Bool,
  operations: Int,
  digest: String,
  // The banner each facility that discloses one writes for itself.
  config: Option<String>,
  trace: Option<String>,
  // Only a run with `--host` listens for a signal.
  signals: Option<Signals>,
  warnings: List<Diag>,
}

pub type Signals = { names: List<String>, lead_ms: Int, drain_ms: Int }

// What the machine reused. `in_place` is `None` when nothing was updated at all, which is not a
// ratio of zero.
pub type Counters = { updates: Int, updates_in_place: Int, in_place: Option<Decimal>, cycles: Int }

// What was in flight when a signal asked the run to stop; `None` when nobody asked.
pub type Stopping = {
  signal: Option<String>,
  listeners: Int,
  connections: Int,
  scopes: Int,
  elapsed_ms: Int,
}

// What the run was given to stop in, and what the teardown did with it.
pub type Teardown = {
  lead_ms: Int,
  drain_ms: Int,
  transactions_rolled_back: Int,
  connections_closed: Int,
  spans_abandoned: Int,
  problems: List<String>,
}

pub type Trace = { events: Int, spans: Int, abandoned: Int, flushed: Bool }

// What the entry did, once the binding is torn down.
pub type Ended = {
  // The code `process.exit` asked for: the program chose it and returned no value.
  exit: Option<Int>,
  value: Option<Value>,
  raised: Option<Raised>,
  counters: Counters,
  // A cycle among escaped values is never collected, so only this run can report it.
  cycles: List<Diag>,
  stopping: Option<Stopping>,
  teardown: Teardown,
  trace: Option<Trace>,
  handshakes: List<String>,
  // The host's own disclosure documents, placed under the keys this report gives them.
  hosts: Json,
  configuration: Json,
}

// --- The options record, built from the parsed line -----------------------------------------

// The simulation flags as one record: `--sim-roots FROM..TO`, or `--seeds N` from seed 0.
pub fn sim_options_from(p: Parsed) -> SimOpts =
  {
    seed: value(p, "seed"),
    mode: match value(p, "sim") { Some(v) -> v, None -> "dpor" },
    roots: match value(p, "sim-roots") {
      Some(text) -> cmdline::range_of(text),
      None -> match opt_int(p, "seeds") { Some(n) -> Some({ from: 0, to: n }), None -> None },
    },
    budget: opt_int(p, "sim-budget"),
    steps: opt_int(p, "sim-steps"),
    measure_reduction: has(p, "measure-reduction"),
  }

// What a run searches when no flag says otherwise.
pub fn no_sim_options() -> SimOpts =
  { seed: None, mode: "dpor", roots: None, budget: None, steps: None, measure_reduction: false }

fn opt_text(p: Parsed, long: String) -> Option<String> = value(p, long)

fn opt_int(p: Parsed, long: String) -> Option<Int> =
  match value(p, long) { Some(v) -> parse_nat(v), None -> None }

fn int_of(p: Parsed, long: String, default: Int) -> Int =
  match opt_int(p, long) { Some(n) -> n, None -> default }

// `--tls api=cert.pem,key.pem` as a credential record.
fn creds(p: Parsed) -> List<TlsCred> =
  map(values_of(p, "tls"), |text: String|
    match cut_pair(text) {
      Some(pair) -> match pair {
        (name, paths) -> match split_once(paths, ",") {
          Some(pp) -> match pp { (cert, key) -> { name: name, cert: cert, key: key } },
          None -> { name: name, cert: "", key: "" },
        },
      },
      None -> { name: "", cert: "", key: "" },
    })

fn named_paths(p: Parsed, long: String) -> List<Named> =
  map(values_of(p, long), |text: String|
    match cut_pair(text) {
      Some(pair) -> match pair { (name, path) -> { name: name, path: path } },
      None -> { name: "", path: "" },
    })

// `NAME=VALUE`: the pair on the first `=`.
fn cut_pair(text: String) -> Option<(String, String)> =
  match cmdline::cut_once(text, "=") { Some(cut) -> Some((cut.head, cut.tail)), None -> None }

fn split_once(text: String, sep: String) -> Option<(String, String)> =
  match cmdline::cut_once(text, sep) { Some(cut) -> Some((cut.head, cut.tail)), None -> None }

// The whole options record, from the parsed line. Each command's machine reads the subset its
// flags cover; the parser already refused a flag the command does not take.
pub fn options_from(p: Parsed) -> Options =
  {
    ..default_options(),
    host: has(p, "host"),
    json: has(p, "json"),
    tls: creds(p),
    trust: values_of(p, "trust"),
    fs: named_paths(p, "fs"),
    exec: named_paths(p, "exec"),
    allow: values_of(p, "allow"),
    config: {
      set: values_of(p, "set"),
      files: values_of(p, "config"),
      schema: opt_text(p, "config-schema"),
    },
    trace: {
      sink: match value(p, "trace") { Some(s) -> s, None -> default_options().trace.sink },
      level: match value(p, "trace-level") { Some(l) -> l, None -> default_options().trace.level },
    },
    drain_ms: int_of(p, "drain-ms", default_options().drain_ms),
    drain_lead_ms: int_of(p, "drain-lead-ms", default_options().drain_lead_ms),
    steps: int_of(p, "steps", default_options().steps),
    timeout: int_of(p, "timeout", default_options().timeout),
    seed: opt_text(p, "seed"),
    profile: match value(p, "profile") { Some(pr) -> pr, None -> default_options().profile },
    argv: p.argv,
  }
