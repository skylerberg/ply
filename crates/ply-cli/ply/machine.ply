// The runtime's machines, as the one capability the program's commands drive: a label's machine
// loads the target rooted at a path, binds the hosts an entry may reach, enters it, and tears
// the binding down, and every answer crosses as a value. `run` drives a whole program this way;
// the other commands' batches are their own effects over the same thread.

import compiler.resolve (Diag)
import diagnostic (Place)
import entry (Main, Module)
import std.json (Json)

// What the Rust side loads, binds, enters and tears down, in that order and each once. The
// binding lives on the thread the entry runs on, which is why binding and entering are two
// operations: what a run may reach has to be disclosed before it reaches any of it.
pub nondet effect machine {
  read load[m](root: String) -> Result<Target, Refusal>
  read reload[m]() -> Result<Target, Refusal>
  read bound[m](entry: String) -> Result<Bound, Refusal>
  write enter[m]() -> Ended
  write drop[m]() -> Unit
}

// --- What the Rust side answers with ----------------------------------------

pub type Refusal = {
  diags: List<Diag>,
  places: List<Place>,
  // The file the refusal is about, when a `.plyx` was named and is not one. A program that does
  // not compile is refused over its own sources instead, and names no file here.
  artifact: Option<String>,
}

// What this run runs: a project the front end loaded, or an artifact opened from a file.
pub type Target = | Project(Program) | Deployed(Artifact)

pub type Program = {
  // The root the load was rooted at, as a report prints it.
  root: String,
  files: List<String>,
  places: List<Place>,
  mains: List<Main>,
  modules: List<Module>,
}

pub type Artifact = {
  path: String,
  digest: String,
  entry: String,
  definitions: Int,
  // Whether the container carries a compiled unit this runtime can enter.
  unit: Bool,
  warnings: List<Diag>,
}

// What the binding discloses before anything runs. A hermetic run discloses nothing, because
// there is nothing it could reach.
pub type Bound = {
  hermetic: Bool,
  operations: Int,
  digest: String,
  // The banner each facility that discloses one writes for itself.
  config: Option<String>,
  trace: Option<String>,
  database: Option<String>,
  // Only a run with `--host` listens for a signal.
  signals: Option<Signals>,
  warnings: List<Diag>,
}

pub type Signals = { names: List<String>, lead_ms: Int, drain_ms: Int }

// What the machine reused. `in_place` is `None` when nothing was updated at all, which is not a
// ratio of zero.
pub type Counters = { updates: Int, updates_in_place: Int, in_place: Option<Decimal>, cycles: Int }

// What was in flight when a signal asked the run to stop; `None` when nobody asked.
pub type Stopping = {
  signal: Option<String>,
  listeners: Int,
  connections: Int,
  scopes: Int,
  elapsed_ms: Int,
}

// What the run was given to stop in, and what the teardown did with it.
pub type Teardown = {
  lead_ms: Int,
  drain_ms: Int,
  transactions_rolled_back: Int,
  connections_closed: Int,
  spans_abandoned: Int,
  problems: List<String>,
}

pub type Trace = { events: Int, spans: Int, abandoned: Int, flushed: Bool }

// What the entry did, once the binding is torn down.
pub type Ended = {
  // The code `process.exit` asked for: the program chose it and returned no value.
  exit: Option<Int>,
  // The value the entry answered with, as the reference prints it.
  value: Option<String>,
  raised: Option<Diag>,
  counters: Counters,
  // A cycle among escaped values is never collected, so only this run can report it.
  cycles: List<Diag>,
  stopping: Option<Stopping>,
  teardown: Teardown,
  trace: Option<Trace>,
  handshakes: List<String>,
  // The host's own disclosure documents, placed under the keys this report gives them.
  hosts: Json,
  configuration: Json,
}
