// `ply.lock` — the closure a build resolved, pinned by each package's own sources. A package is
// pinned by what it is (its name, its version, and the BLAKE3 digest of the modules it contributed)
// and never by where it was found, so moving a dependency keeps its pin and editing one breaks it.
//
// The digest is the front end's: `pins_of` in `compiler.pkg` reads it off the package judgments
// that decide what a package *is*, so there is one answer to "what did this build use" and the
// lockfile only records it. This module reads, checks and writes that record.

import diagnostic (Place)
import env (env)
import paths
import paths (Resolved, Rooted, in_root, read_file)
import report (Answer, ok_code, schema_version)
import compiler.pkg
import compiler.resolve (Diag, diag1)
import std.fs (fs, mem_of, mem_read, mem_resolved)
import std.json (Json, Member, Number, Str, JsonCodec, error_to_string, field, int_json, list_json,
                 object, optional_field, parse, string_json, to_string)
import std.path (join)

// One package as the front end pins it, as text, because the file is JSON.
pub type Pinned = { name: String, version: String, digest: String }

// The front end's answer carries bytes — it crosses as frames — so the boundary converts once,
// here, rather than at every caller.
pub fn from_front(ps: List<pkg::Pinned>) -> List<Pinned> =
  map(ps, |p: pkg::Pinned|
    {
      name: string_of_bytes_lossy(p.name),
      version: string_of_bytes_lossy(p.version),
      digest: string_of_bytes_lossy(p.digest),
    })

/// One package as the file records it: its pin and, for a registry package, the digest of the
/// archive it was fetched as, which the next fetch of that version must match.
pub type Entry = { name: String, version: String, digest: String, archive: Option<String> }

/// A registry package's archive, as `ply resolve` fetched and checked it.
pub type Archived = { name: String, version: String, archive: String }

pub type Lock = { version: Int, packages: List<Entry> }

derive eq for Pinned
derive eq for Entry
derive eq for Archived
derive eq for Lock

pub fn pin_of(e: Entry) -> Pinned = { name: e.name, version: e.version, digest: e.digest }

// `archive` is written only for a registry package: a lock over path and git dependencies holds no
// field it does not use.
fn entry_json() -> JsonCodec<Entry> =
  {
    encode: |e: Entry|
      object(
        fold(
          match e.archive { None -> [], Some(a) -> [{ key: "archive", value: Str(a) }] },
          [
            { key: "name", value: Str(e.name) },
            { key: "version", value: Str(e.version) },
            { key: "digest", value: Str(e.digest) },
          ],
          |acc: List<Member>, m: Member| push(acc, m),
        ),
      ),
    decode: |j: Json|
      match field(j, "name", string_json()) {
        Err(e) -> Err(e),
        Ok(name) -> match field(j, "version", string_json()) {
          Err(e) -> Err(e),
          Ok(version) -> match field(j, "digest", string_json()) {
            Err(e) -> Err(e),
            Ok(digest) -> match optional_field(j, "archive", string_json()) {
              Err(e) -> Err(e),
              Ok(archive) -> Ok({ name: name, version: version, digest: digest, archive: archive }),
            },
          },
        },
      },
  }

fn lock_json() -> JsonCodec<Lock> =
  {
    encode: |l: Lock|
      object([
        { key: "version", value: Number(decimal_of_int(l.version)) },
        { key: "packages", value: list_json(entry_json()).encode(l.packages) },
      ]),
    decode: |j: Json|
      match field(j, "version", int_json()) {
        Err(e) -> Err(e),
        Ok(version) -> match field(j, "packages", list_json(entry_json())) {
          Err(e) -> Err(e),
          Ok(packages) -> Ok({ version: version, packages: packages }),
        },
      },
  }

// The format this file writes. A lock from another version is refused rather than half-read.
pub fn format() -> Int = 1

// Beside the package's `ply.pkg`, whichever file in its directory the path named.
pub fn path_of(r: Resolved) -> Rooted = in_root(r, "ply.lock")

// --- Reading -------------------------------------------------------------------

fn decoded(text: String) -> Result<Lock, String> =
  match parse(bytes_of_string(text)) {
    Err(e) -> Err(error_to_string(e)),
    Ok(j) -> match lock_json().decode(j) {
      Err(e) -> Err(error_to_string(e)),
      Ok(lock) -> Ok(lock),
    },
  }

/// The lock at the root, or `None` when the project has none. `Err` is a lock that cannot be read:
/// a file the run must not ignore, since what it pins is what it would otherwise trust.
pub fn read(r: Resolved) -> Result<Option<Lock>, String> / {fs.read_file[cwd], fs.read_file[abs]} =
  match read_file(path_of(r)) {
    None -> Ok(None),
    Some(bytes) -> match decoded(string_of_bytes_lossy(bytes)) {
      Err(why) -> Err(why),
      Ok(lock) -> if lock.version != format() {
        Err(
          "`ply.lock` is format " ++ int_to_string(lock.version)
            ++ ", and this `ply` writes format "
            ++ int_to_string(format()),
        )
      } else { Ok(Some(lock)) },
    },
  }

/// What the lock says about one package, when it says anything.
pub fn entry_of(lock: Lock, name: String) -> Option<Entry> =
  fold(lock.packages, None, |found: Option<Entry>, e: Entry|
    match found { Some(_) -> found, None -> if e.name == name { Some(e) } else { None } })

// --- The judgment ----------------------------------------------------------------

// What is wrong with the lock, as a diagnostic over the project's root: a pinned package the run
// found different bytes for, or a lock nothing can read.
pub fn refused(r: Resolved, why: String) -> Diag =
  diag1(
    b"E0139",
    outside(),
    { start: 0, end: 0 },
    bytes_of_string("`ply.lock` could not be read: " ++ why),
    b"the lockfile is not one this `ply` wrote",
    [b"delete it to pin what is on disk now, or restore it from version control"],
  )

pub fn mismatch(r: Resolved, name: String, pinned: Entry, found: Pinned) -> Diag =
  diag1(
    b"E0138",
    outside(),
    { start: 0, end: 0 },
    bytes_of_string(
      "`" ++ name ++ "` is not what `ply.lock` pins: " ++ pinned.digest
        ++ " was pinned, and the sources here are "
        ++ found.digest,
    ),
    b"a pinned dependency changed",
    [
      bytes_of_string(
        "`ply.lock` pins " ++ name ++ " " ++ pinned.version ++ "; this tree holds "
          ++ found.version,
      ),
      b"delete its entry from `ply.lock` to pin what is on disk now, once you have checked what changed",
    ],
  )

fn outside() -> Int = 4294967295

/// Verifies a build's closure against the lock: every pinned package must be the one this run
/// found. A package the lock does not mention is not an error — a write records it.
pub fn verified(r: Resolved, lock: Lock, pins: List<Pinned>) -> Result<(), Diag> =
  fold(pins, Ok(()), |acc: Result<(), Diag>, found: Pinned|
    match acc {
      Err(d) -> Err(d),
      Ok(_) -> match entry_of(lock, found.name) {
        None -> Ok(()),
        Some(pinned) -> if pinned.digest == found.digest { Ok(()) }
        else { Err(mismatch(r, found.name, pinned, found)) },
      },
    })

// --- Writing -----------------------------------------------------------------------

/// The lock a run's closure pins, with every package the closure holds and no stale entries: what
/// `ply build` writes, so a lock can only ever describe a build that happened. A package the lock
/// already records under the same digest keeps its entry, archive and all; one `archives` names is
/// recorded with the archive `ply resolve` fetched it as.
pub fn text(lock: Option<Lock>, pins: List<Pinned>, archives: List<Archived>) -> String = {
  let entries = map(pins, |p: Pinned| entry_for(lock, archives, p));
  to_string(lock_json().encode({ version: format(), packages: sorted(entries) })) ++ "\n"
}

fn entry_for(lock: Option<Lock>, archives: List<Archived>, p: Pinned) -> Entry = {
  let fetched = fold(archives, None, |found: Option<String>, a: Archived|
    match found {
      Some(_) -> found,
      None -> if a.name == p.name && a.version == p.version { Some(a.archive) } else { None },
    });
  let recorded = match lock { None -> None, Some(l) -> entry_of(l, p.name) };
  match fetched {
    Some(archive) -> { name: p.name, version: p.version, digest: p.digest, archive: Some(archive) },
    None -> match recorded {
      Some(e) -> if e.digest == p.digest && e.version == p.version { e } else { fresh(p) },
      None -> fresh(p),
    },
  }
}

fn fresh(p: Pinned) -> Entry = { name: p.name, version: p.version, digest: p.digest, archive: None }

// By name, so two runs that pinned the same closure write the same file and a diff is a change in
// the closure rather than in a walk order.
fn sorted(entries: List<Entry>) -> List<Entry> =
  fold(entries, [], |acc: List<Entry>, p: Entry| {
    let n = len(acc);
    let i = fold(range(0, n), n, |at_i: Int, j: Int|
      if at_i < n { at_i } else if name_lt(p.name, at(acc, j).name) { j } else { at_i });
    inserted(acc, i, p)
  })

fn inserted(entries: List<Entry>, i: Int, p: Entry) -> List<Entry> = {
  let before = fold(range(0, i), [], |acc: List<Entry>, j: Int| push(acc, at(entries, j)));
  let after = fold(range(i, len(entries)), [], |acc: List<Entry>, j: Int|
    push(acc, at(entries, j)));
  fold(after, push(before, p), |acc: List<Entry>, x: Entry| push(acc, x))
}

// `String` has no ordered comparison: bytes do, and a name's bytes are its order.
fn name_lt(a: String, b: String) -> Bool =
  match compare(bytes_of_string(a), bytes_of_string(b)) { Less -> true, _ -> false }

fn at<a>(xs: List<a>, i: Int) -> a =
  match list_at(xs, i) { Some(x) -> x, None -> panic("an index the list does not hold") }

// --- Tests ------------------------------------------------------------------

fn a_pin(name: String, version: String, digest: String) -> Pinned =
  { name: name, version: version, digest: digest }

fn an_entry(name: String, version: String, digest: String, archive: Option<String>) -> Entry =
  { name: name, version: version, digest: digest, archive: archive }

test "a lock is written sorted by name, so a walk order cannot change it" {
  let pins = [a_pin("zebra", "1.0.0", "b3:z"), a_pin("alpha", "0.2.0", "b3:a")];
  let text = text(None, pins, []);
  assert(string_contains(text, "\"name\":\"alpha\""));
  // `string_find` raises when the needle is absent, which is itself the failure this test means.
  assert(string_find(text, "\"alpha\"") < string_find(text, "\"zebra\""))
}

test "a lock round-trips through the format it writes" {
  let pins = [a_pin("lib", "0.1.0", "b3:1f2e")];
  match decoded(text(None, pins, [])) {
    Err(why) -> panic(why),
    Ok(lock) -> {
      assert_eq(lock.version, 1);
      assert_eq(lock.packages, [an_entry("lib", "0.1.0", "b3:1f2e", None)])
    },
  }
}

test "only a registry package records an archive, and a path package's entry holds three fields" {
  let text = text(None, [a_pin("lib", "0.1.0", "b3:1f"), a_pin("orders", "0.2.0", "b3:9a")], [
    { name: "orders", version: "0.2.0", archive: "b3:77" },
  ]);
  assert_eq(
    text,
    "{\"packages\":[{\"digest\":\"b3:1f\",\"name\":\"lib\",\"version\":\"0.1.0\"},{\"archive\":\"b3:77\",\"digest\":\"b3:9a\",\"name\":\"orders\",\"version\":\"0.2.0\"}],\"version\":1}\n",
  );
  match decoded(text) {
    Err(why) -> panic(why),
    Ok(lock) ->
      assert_eq(lock.packages, [
        an_entry("lib", "0.1.0", "b3:1f", None),
        an_entry("orders", "0.2.0", "b3:9a", Some("b3:77")),
      ]),
  }
}

test "a pinned package whose sources moved is refused, and one the lock does not hold is not" {
  let lock: Lock = { version: 1, packages: [an_entry("lib", "0.1.0", "b3:old", None)] };
  let r: Resolved = {
    label: "cwd",
    spelling: ".",
    display: ".",
    inside: ".",
    absolute: ".",
    machine: ".",
  };
  match verified(r, lock, [a_pin("lib", "0.1.0", "b3:new")]) {
    Ok(_) -> panic("a changed dependency was trusted"),
    Err(d) -> assert_eq(d.code, b"E0138"),
  };
  match verified(r, lock, [a_pin("lib", "0.1.0", "b3:old")]) {
    Ok(_) -> (),
    Err(_) -> panic("the same dependency was refused"),
  };
  // A package the lock does not mention is recorded, not refused.
  match verified(r, lock, [a_pin("other", "0.1.0", "b3:x")]) {
    Ok(_) -> (),
    Err(_) -> panic("an unpinned package was refused"),
  }
}

test "a file argument's lock is the `ply.lock` in its directory, and that is the one read" {
  let pinned = text(None, [a_pin("lib", "0.1.0", "b3:1f")], []);
  let disk = mem_of([
    { path: "w/app/main.ply", body: b"fn main() -> Int = 1" },
    { path: "w/app/ply.lock", body: bytes_of_string(pinned) },
  ]);
  let r = handle {
    paths::resolve("app/main.ply")
  } with {
    env.pwd[sys]() -> "/w",
    fs.resolved[cwd](p) -> mem_resolved(disk, join("w", p)),
    fs.resolved[abs](p) -> panic("nothing here leaves the working directory"),
  };
  assert_eq(path_of(r), { label: "cwd", path: "app/ply.lock" });
  let found = handle {
    read(r)
  } with {
    fs.read_file[cwd](p) -> mem_read(disk, join("w", p)),
    fs.read_file[abs](p) -> panic("nothing here leaves the working directory"),
  };
  match found {
    Ok(Some(lock)) -> assert_eq(lock.packages, [an_entry("lib", "0.1.0", "b3:1f", None)]),
    _ -> panic("the lock beside the file was not the one read"),
  }
}

test "writing a lock keeps what the closure still holds and drops what it left" {
  let before: Lock = {
    version: 1,
    packages: [
      an_entry("gone", "0.1.0", "b3:g", None),
      an_entry("lib", "0.1.0", "b3:old", None),
      an_entry("orders", "0.2.0", "b3:o", Some("b3:77")),
    ],
  };
  let text = text(
    Some(before),
    [
      a_pin("lib", "0.1.0", "b3:old"),
      a_pin("new", "0.2.0", "b3:n"),
      a_pin("orders", "0.2.0", "b3:o"),
    ],
    [],
  );
  match decoded(text) {
    Err(why) -> panic(why),
    Ok(lock) ->
      assert_eq(lock.packages, [
        an_entry("lib", "0.1.0", "b3:old", None),
        an_entry("new", "0.2.0", "b3:n", None),
        an_entry("orders", "0.2.0", "b3:o", Some("b3:77")),
      ]),
  }
}

test "an archive is kept only for the sources it was fetched as" {
  let before: Lock = { version: 1, packages: [an_entry("orders", "0.2.0", "b3:o", Some("b3:77"))] };
  // The sources moved or the version did: the old archive no longer describes what is pinned.
  let moved = text(Some(before), [a_pin("orders", "0.2.0", "b3:other")], []);
  assert(!string_contains(moved, "b3:77"));
  let raised = text(Some(before), [a_pin("orders", "0.3.0", "b3:o3")], [
    { name: "orders", version: "0.3.0", archive: "b3:88" },
  ]);
  assert(string_contains(raised, "\"archive\":\"b3:88\""));
  assert(!string_contains(raised, "b3:77"))
}
