//! `ply keygen PATH` — an Ed25519 key pair to sign what `ply build` writes: the secret key at PATH,
//! readable by its owner alone, and its public key at PATH.pub. A key file already there is never
//! written over. The seed is drawn sealed and written through `fs.write_secret`, so it is never a
//! plain value of this program.

import args (Flags, style_of)
import std.cli (Parsed)
import paths
import report (Answer, indent, ok_code, reported)
import signing (fresh_seed, public_text, unkeyed, write_seed)
import std.term (bold, green)
import std.bytes (hex_of)
import std.ed25519
import std.fs (fs, Missing)
import std.json (Bool, Number, Str, object)
import std.random (entropy)
import std.list (at_or)

pub type Options = { path: String }

pub fn options_from(parsed: Parsed) -> Options = { path: at_or(parsed.positionals, 0, "") }

pub fn run(
  flags: Flags,
  opts: Options,
) -> Answer / {entropy.secret, fs.kind[cwd], fs.kind[abs], fs.write_file[cwd], fs.write_file[abs], fs.write_secret[cwd], fs.write_secret[abs], abort.raise} = {
  let s = style_of(flags);
  let public_path = opts.path ++ ".pub";
  let secret = paths::spelled(opts.path);
  let public = paths::spelled(public_path);
  if paths::kind(secret) != Missing {
    reported(
      s,
      "keygen",
      [unkeyed(opts.path, "is already there, and a key is never written over")],
      [],
    )
  } else if paths::kind(public) != Missing {
    reported(
      s,
      "keygen",
      [unkeyed(public_path, "is already there, and a key is never written over")],
      [],
    )
  } else {
    let seed = fresh_seed();
    let key = ed25519::public_key(seed);
    if !write_seed(secret, seed) {
      reported(s, "keygen", [unkeyed(opts.path, "cannot be written")], [])
    } else if !paths::write_file(public, bytes_of_string(public_text(key))) {
      reported(s, "keygen", [unkeyed(public_path, "cannot be written")], [])
    } else {
      {
        json: object([
          { key: "command", value: Str("keygen") },
          { key: "ok", value: Bool(true) },
          { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
          { key: "secret", value: Str(opts.path) },
          { key: "public", value: Str(public_path) },
          { key: "key", value: Str(hex_of(key)) },
        ]),
        lines: [
          indent() ++ green(s, "generated") ++ " " ++ opts.path ++ " · " ++ public_path,
          indent() ++ bold(s, "public") ++ " " ++ hex_of(key),
        ],
        errs: [],
        code: ok_code(),
      }
    }
  }
}
