// `ply keygen PATH` — an Ed25519 key pair to sign what `ply build` writes: the secret key at PATH,
// readable by its owner alone, and its public key at PATH.pub. A key file already there is never
// written over.

import args (Flags, style_of)
import cmdline (Parsed, nth_of)
import paths (Rooted)
import paths
import report (Answer, ind, ok_code, reported)
import signing (fresh_seed, public_text, secret_text, unkeyed)
import style (bold, green)
import std.bytes (hex_of)
import std.ed25519
import std.fs (fs, Missing, Mode)
import std.json (Bool, Number, Str, object)
import std.random (entropy)

pub type Opts = { path: String }

pub fn options_from(p: Parsed) -> Opts = { path: nth_of(p.positionals, 0, "") }

fn private() -> Mode =
  {
    owner: { read: true, write: true, execute: false },
    group: { read: false, write: false, execute: false },
    other: { read: false, write: false, execute: false },
  }

fn restricted(at: Rooted) -> Bool / {fs.set_mode[cwd], fs.set_mode[abs]} =
  if at.label == "cwd" { fs.set_mode[cwd](at.path, private()) }
  else { fs.set_mode[abs](at.path, private()) }

// The secret's file is made private before the secret is in it.
fn kept_secret(
  at: Rooted,
  text: String,
) -> Bool / {fs.write_file[cwd], fs.write_file[abs], fs.set_mode[cwd], fs.set_mode[abs]} =
  paths::write_file(at, b"") && restricted(at) && paths::write_file(at, bytes_of_string(text))

pub fn run(
  flags: Flags,
  opts: Opts,
) -> Answer / {entropy.next, fs.kind[cwd], fs.kind[abs], fs.write_file[cwd], fs.write_file[abs], fs.set_mode[cwd], fs.set_mode[abs]} = {
  let s = style_of(flags);
  let public_path = opts.path ++ ".pub";
  let secret = paths::spelled(opts.path);
  let public = paths::spelled(public_path);
  if paths::kind(secret) != Missing {
    reported(
      s,
      "keygen",
      [unkeyed(opts.path, "is already there, and a key is never written over")],
      [],
    )
  } else if paths::kind(public) != Missing {
    reported(
      s,
      "keygen",
      [unkeyed(public_path, "is already there, and a key is never written over")],
      [],
    )
  } else {
    let seed = fresh_seed();
    let key = ed25519::public_key(seed);
    if !kept_secret(secret, secret_text(seed)) {
      reported(s, "keygen", [unkeyed(opts.path, "cannot be written")], [])
    } else if !paths::write_file(public, bytes_of_string(public_text(key))) {
      reported(s, "keygen", [unkeyed(public_path, "cannot be written")], [])
    } else {
      {
        json: object([
          { key: "command", value: Str("keygen") },
          { key: "ok", value: Bool(true) },
          { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
          { key: "secret", value: Str(opts.path) },
          { key: "public", value: Str(public_path) },
          { key: "key", value: Str(hex_of(key)) },
        ]),
        lines: [
          ind() ++ green(s, "generated") ++ " " ++ opts.path ++ " · " ++ public_path,
          ind() ++ bold(s, "public") ++ " " ++ hex_of(key),
        ],
        errs: [],
        code: ok_code(),
      }
    }
  }
}
