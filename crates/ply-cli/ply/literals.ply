//! What a load enters before anything runs: its tagged literals' parsers, its `const` definitions
//! and its statements. `tag"text"` is the call `tag::literal("text")`, and one with holes the call
//! of `tag::compile` on the texts around them, and a load that checked has not yet run either: here
//! each one the run's own modules hold is entered on a machine of its own, under a step budget, and
//! what its parser answers is the literal's verdict. A verdict is a function of the parser and the
//! texts, so it is kept under the hash of all the parser reaches and the texts, in the toolchain's
//! cache. A `const` definition is entered the same way, handed nothing: what it answers is kept
//! there too, as the text a unit holds a value by, under the hash of all the definition reaches,
//! and every unit emitted after holds the value in place of the body. A statement a call runs is
//! computed the same way and judged by `statements`.

import compiler.exprs (TaggedPart)
import compiler.front (Analysis, TaggedSite, Within, tagged_sites, ConstSite, const_sites)
import compiler.hash (TheFn, hex, reach)
import compiler.interface (sized)
import compiler.lexer (utf8_len)
import compiler.load (every_root, LoadedAnalysis)
import compiler.parsing (Span, no_module)
import compiler.resolve (Diag, Label, error_at, error_with_labels, label_at)
import compiler.unit (read_kept, write_kept, shipped, emitter_identity, stored_root)
import diagnostic (Place, shown)
import env (env)
import machine (machine, Called, default_options, unconfigured)
import program (Timed, front_of)
import sources (under_abs)
import statements
import statements (Asking, Judgement, Unjudged, asking, judged, judgement_key, judgement_bin,
                   misfits, schemas_refused)
import std.bin
import std.fs (fs)
import std.hash (blake3)
import std.list (at, concat, contains)
import std.random (entropy)
import std.time (time)
import std.value (Value, VBytes, VCtor, VInt, VList, VRecord, VStr, render, field_named)
import units (emit, text_of, baked_key, kept_value, keep_value)

/// The calls a literal's parser may make before the check gives up on it.
pub fn step_budget() -> Int = 10000000

/// The calls a `const` definition may make before the build gives up on it.
pub fn const_budget() -> Int = 100000000

/// The bytes of text a `const` definition's value may be kept as.
pub fn const_room() -> Int = 16777216

/// What a parser said of its texts. `Rejected` is its own `Err`: which text, where in it in
/// characters, and why. `Raised` is a parser that raised instead of answering, and `Spent` one the
/// budget stopped. A `const` definition is `Accepted` once its value is kept, `RaisedAt` where its
/// raise has a place in the program, and `Oversize`, with the bytes its value's text takes, where
/// those are past `const_room`.
pub type Verdict =
  | Accepted
  | Rejected({ part: Int, offset: Int, message: String })
  | Raised(String)
  | Spent
  | Oversize(Int)
  | RaisedAt({ message: String, module: Int, start: Int, end: Int })

derive bin for Verdict

/// A parser, by its program-wide name and the hash of all it reaches, and what to hand it: one
/// text as it is, or the several around a literal's holes as a list. A `const` definition is asked
/// the same way and handed nothing, so it has no parts.
pub type Asked = { callee: Bytes, hash: Bytes, parts: List<Bytes> }

/// What a command asks of its tagged literals' parsers, its `const` definitions and its statements.
/// What answers is `settling`, which `main` runs every command under, or a handler of the asker's
/// own. A verdict is a function of what is asked, so the effect is a deterministic one, whatever
/// the answering keeps.
pub effect literal {
  /// In `asked`'s order; or what kept the definitions from being entered at all.
  read verdicts(timed: Timed, analysis: Analysis, root: String, asked: List<Asked>) -> Result<List<Verdict>, List<Diag>>
  /// Each statement of `asked` judged against the schema it is held to, in `asked`'s order; or what
  /// kept the definitions from being entered at all.
  read statements(timed: Timed, analysis: Analysis, root: String, asked: List<statements::Asked>) -> Result<List<Judgement>, List<Diag>>
}

// --- Asking -----------------------------------------------------------------------

fn asked_of(site: TaggedSite) -> Asked =
  { callee: site.callee, hash: site.hash, parts: map(site.parts, |part: TaggedPart| part.text) }

fn distinct(sites: List<TaggedSite>) -> List<Asked> =
  fold(sites, [], |acc: List<Asked>, site: TaggedSite|
    if contains(acc, asked_of(site)) { acc } else { push(acc, asked_of(site)) })

fn verdict_for(asked: List<Asked>, verdicts: List<Verdict>, site: TaggedSite) -> Option<Verdict> =
  fold(range(0, len(asked)), None, |found: Option<Verdict>, i: Int|
    match found {
      Some(_) -> found,
      None -> if list_at(asked, i) == Some(asked_of(site)) { list_at(verdicts, i) } else { None },
    })

/// How many bytes of `src` spell the character at `i`: an escape is one character, and so is a
/// brace, which a tagged literal's text writes twice.
fn spelled_width(src: Bytes, i: Int, end: Int) -> Int / {abort.raise} =
  if i + 1 >= end { utf8_len(bytes_at(src, i)) }
  else if bytes_at(src, i) == 123 || bytes_at(src, i) == 125 { 2 }
  else if bytes_at(src, i) != 92 { utf8_len(bytes_at(src, i)) }
  else if bytes_at(src, i + 1) != 117 { 2 } else {
    iterate(i + 2, end - i, |j: Int|
      if j >= end { Stop(end - i) }
      else if bytes_at(src, j) == 125 { Stop(j + 1 - i) }
      else { Continue(j + 1) })
  }

/// Where character `offset` of a text of a tagged literal is written: `quoted` is the text with
/// what opens and closes it, a quote or the brace of a hole, and the character past the last is
/// what closes it. Nowhere for an offset the text does not have.
pub fn spelled_at(src: Bytes, quoted: Span, offset: Int) -> Option<Span> / {abort.raise} = {
  let end = quoted.end - 1;
  if offset < 0 || quoted.start + 1 > end || quoted.end > bytes_len(src) { None } else {
    iterate(
      { i: quoted.start + 1, left: offset },
      end - quoted.start + 1,
      |s: { i: Int, left: Int }|
        if s.i >= end { Stop(if s.left == 0 { Some({ start: end, end: end + 1 }) } else { None }) }
        else {
          let width = spelled_width(src, s.i, end);
          if s.left == 0 { Stop(Some({ start: s.i, end: s.i + width })) }
          else { Continue({ i: s.i + width, left: s.left - 1 }) }
        },
    )
  }
}

fn holed(site: TaggedSite) -> Bool = len(site.parts) > 1

fn spelled(site: TaggedSite) -> Bytes =
  bytes_concat_all([b"`", site.tag, if holed(site) { b"::compile`" } else { b"::literal`" }])

fn ran(site: TaggedSite) -> Bytes =
  if holed(site) {
    bytes_concat_all([
      b"the check ran `",
      site.callee,
      b"` on the texts around the holes, as every `",
      site.tag,
      b"\"..{h}..\"` here is `",
      site.tag,
      b"::fill` called on what `",
      site.tag,
      b"::compile([\"..\", \"..\"])` answers and on its holes",
    ])
  } else {
    bytes_concat_all([
      b"the check ran `",
      site.callee,
      b"` on the text, as every `",
      site.tag,
      b"\"..\"` here is the call `",
      site.tag,
      b"::literal(\"..\")`",
    ])
  }

/// The literal's string, quotes included.
fn string_of(site: TaggedSite) -> Span =
  match ((list_at(site.parts, 0), list_at(site.parts, len(site.parts) - 1))) {
    (Some(first), Some(last)) -> { start: first.quoted.start, end: last.quoted.end },
    _ -> site.span,
  }

/// Where a parser's refusal lands: the character it names in the text it names, the whole hole
/// for the offset just past a text a hole follows, and the whole string for a place it has not.
fn refused_at(src: Bytes, site: TaggedSite, part: Int, offset: Int) -> Span / {abort.raise} =
  match list_at(site.parts, part) {
    None -> string_of(site),
    Some(text) -> match spelled_at(src, text.quoted, offset) {
      None -> string_of(site),
      Some(span) -> match list_at(site.parts, part + 1) {
        Some(next) -> if span.start != text.quoted.end - 1 { span }
        else { { start: span.start, end: next.quoted.start + 1 } },
        None -> span,
      },
    },
  }

fn refusal(
  places: List<Place>,
  site: TaggedSite,
  verdict: Verdict,
) -> Option<Diag> / {abort.raise} =
  match verdict {
    Accepted -> None,
    Oversize(_) -> None,
    RaisedAt(_) -> None,
    Rejected(why) -> {
      let src = match list_at(places, site.module) { Some(place) -> place.text, None -> b"" };
      Some(
        error_at(
          b"E0153",
          site.module,
          refused_at(src, site, why.part, why.offset),
          bytes_concat(spelled(site), b" refuses this literal"),
          bytes_of_string(why.message),
          [ran(site)],
        ),
      )
    },
    Raised(message) ->
      Some(
        error_at(
          b"E0154",
          site.module,
          site.span,
          bytes_concat_all([spelled(site), b" raised on this literal: ", bytes_of_string(message)]),
          b"its parser gave no answer",
          [ran(site), b"a parser answers `Err` of a text it refuses, saying where and why"],
        ),
      ),
    Spent ->
      Some(
        error_at(
          b"E0154",
          site.module,
          site.span,
          bytes_concat_all([
            spelled(site),
            b" did not answer this literal within ",
            bytes_of_string(int_to_string(step_budget())),
            b" calls",
          ]),
          b"its parser gave no answer",
          [ran(site), b"that is the budget a check gives each literal"],
        ),
      ),
  }

fn asked_const(site: ConstSite) -> Asked = { callee: site.name, hash: site.hash, parts: [] }

fn is_const(a: Asked) -> Bool = len(a.parts) == 0

fn budget_of(a: Asked) -> Int = if is_const(a) { const_budget() } else { step_budget() }

fn const_refused(
  site: ConstSite,
  code: Bytes,
  what: Bytes,
  also: List<Label>,
  notes: List<Bytes>,
) -> Diag =
  error_with_labels(
    code,
    bytes_concat_all([b"`", site.name, b"` is `const`, and ", what]),
    concat(
      [label_at(site.module, site.span, true, b"a build evaluates this and keeps its value")],
      also,
    ),
    notes,
  )

fn const_raised(site: ConstSite, message: String, also: List<Label>) -> Diag =
  const_refused(
    site,
    b"E0157",
    bytes_concat(b"raised when the build evaluated it: ", bytes_of_string(message)),
    also,
    [
      b"a build evaluates a `const fn` before anything runs and keeps what it answers, so its body has to answer: for every file it embeds, as that file reads now",
    ],
  )

fn const_refusal(site: ConstSite, verdict: Verdict) -> Option<Diag> / {abort.raise} =
  match verdict {
    Accepted -> None,
    Rejected(_) -> None,
    Raised(message) -> Some(const_raised(site, message, [])),
    RaisedAt(r) ->
      Some(
        const_raised(site, r.message, [
          label_at(r.module, { start: r.start, end: r.end }, false, b"raised here"),
        ]),
      ),
    Spent ->
      Some(
        const_refused(
          site,
          b"E0158",
          bytes_concat_all([
            b"did not answer within ",
            bytes_of_string(int_to_string(const_budget())),
            b" calls",
          ]),
          [],
          [b"that is the budget a build gives each `const fn`"],
        ),
      ),
    Oversize(n) ->
      Some(
        const_refused(
          site,
          b"E0158",
          bytes_concat_all([
            b"its value takes ",
            bytes_of_string(int_to_string(n)),
            b" bytes kept, past the ",
            bytes_of_string(int_to_string(const_room())),
            b" a build keeps",
          ]),
          [],
          [
            b"a unit holds a `const fn`'s value whole: keep the table smaller, or build it when run",
          ],
        ),
      ),
  }

/// What refuses a load before anything of it runs: each tagged literal of the run's own modules its
/// parser does not accept, at the place in its text the parser names; each `const` definition the
/// program holds that a build could not evaluate and keep; and what the check finds wrong with each
/// statement the run's own modules run. Nothing at all, and nothing asked, where the program writes
/// none of them.
pub fn unsettled(
  timed: Timed,
  analysis: Analysis,
  root: String,
) -> List<Diag> / {literal.verdicts, literal.statements, abort.raise} =
  concat(literal_refusals(timed, analysis, root), statement_refusals(timed, analysis, root))

fn statement_refusals(
  timed: Timed,
  analysis: Analysis,
  root: String,
) -> List<Diag> / {literal.statements, abort.raise} = {
  let asks = filter(asking(analysis), |a: Asking| a.site.module < len(timed.program.files));
  let refused = schemas_refused(asks);
  if len(asks) == 0 { refused } else {
    match literal.statements(timed, analysis, root, map(asks, |a: Asking| a.asked)) {
      Err(diags) -> concat(refused, diags),
      Ok(judgements) ->
        fold(range(0, len(asks)), refused, |acc: List<Diag>, i: Int|
          match list_at(judgements, i) {
            Some(j) -> concat(acc, misfits(at(asks, i), j)),
            None -> acc,
          }),
    }
  }
}

fn literal_refusals(
  timed: Timed,
  analysis: Analysis,
  root: String,
) -> List<Diag> / {literal.verdicts, abort.raise} = {
  let sites = filter(tagged_sites(analysis), |site: TaggedSite|
    site.module < len(timed.program.files));
  let consts = const_sites(analysis.mods, analysis.hashes);
  if len(sites) == 0 && len(consts) == 0 { [] } else {
    let parsers = distinct(sites);
    let asked = concat(parsers, map(consts, asked_const));
    match literal.verdicts(timed, analysis, root, asked) {
      Err(diags) -> diags,
      Ok(verdicts) -> {
        let literals = fold(sites, [], |acc: List<Diag>, site: TaggedSite|
          match verdict_for(parsers, verdicts, site) {
            None -> acc,
            Some(verdict) -> match refusal(timed.program.places, site, verdict) {
              Some(diag) -> push(acc, diag),
              None -> acc,
            },
          });
        fold(range(0, len(consts)), literals, |acc: List<Diag>, i: Int|
          match list_at(verdicts, len(parsers) + i) {
            None -> acc,
            Some(verdict) -> match const_refusal(at(consts, i), verdict) {
              Some(diag) -> push(acc, diag),
              None -> acc,
            },
          })
      },
    }
  }
}

// --- Answering --------------------------------------------------------------------

fn verdict_of(called: Called) -> Verdict / {abort.raise} =
  match called.answer {
    Err(raised) -> {
      let diag = shown(raised);
      if diag.code == b"E0503" { Spent } else { Raised(string_of_bytes_lossy(diag.message)) }
    },
    Ok(value) -> match value {
      VCtor(name, args) -> if name == "Ok" { Accepted } else {
        match list_at(args, 0) {
          Some(VRecord(fields)) -> match ((
              field_named(fields, "offset"),
              field_named(fields, "message"),
            )) {
            (Some(VInt(offset)), Some(VStr(message))) ->
              Rejected({
                part: match field_named(fields, "part") { Some(VInt(part)) -> part, _ -> 0 },
                offset: offset,
                message: message,
              }),
            _ -> Raised("it answered " ++ render(value)),
          },
          _ -> Raised("it answered " ++ render(value)),
        }
      },
      _ -> Raised("it answered " ++ render(value)),
    },
  }

/// A `const` definition's answer, as its stored root gave it: the text of its value, kept only where
/// a build has room for it.
fn value_of(called: Called) -> Judged / {abort.raise} =
  match called.answer {
    Err(raised) -> {
      let diag = shown(raised);
      let message = string_of_bytes_lossy(diag.message);
      let placed = filter(diag.labels, |l: Label| l.primary && l.module != no_module());
      {
        verdict: if diag.code == b"E0503" { Spent } else {
          match list_at(placed, 0) {
            Some(l) -> RaisedAt({ message: message, module: l.module, start: l.start, end: l.end }),
            None -> Raised(message),
          }
        },
        value: None,
      }
    },
    Ok(VBytes(text)) -> if bytes_len(text) > const_room() {
      { verdict: Oversize(bytes_len(text)), value: None }
    } else { { verdict: Accepted, value: Some(text) } },
    Ok(value) -> { verdict: Raised("its stored root answered " ++ render(value)), value: None },
  }

fn handed(a: Asked) -> Value = {
  let texts = map(a.parts, |text: Bytes| VStr(string_of_bytes_lossy(text)));
  match texts { [text] -> text, _ -> VList(texts) }
}

/// What entering the definitions `names` enters of the program: all they reach.
fn entering(analysis: Analysis, names: List<Bytes>) -> Within / {abort.raise} =
  { owners: reach(analysis.hashes, map(names, |n: Bytes| TheFn(n))).fns, tests: map_new() }

fn callees(asked: List<Asked>) -> List<Bytes> =
  fold(asked, [], |acc: List<Bytes>, a: Asked|
    if contains(acc, a.callee) { acc } else { push(acc, a.callee) })

/// What entering one definition said: its verdict, and for a `const` definition a build can keep,
/// the text of its value.
type Judged = { verdict: Verdict, value: Option<Bytes> }

/// `asked` entered on a machine loaded for them alone: a unit of the definitions they reach, each
/// call under `steps`. A parser is handed its texts; a `const` definition is entered through its
/// stored root, which hands back its value as text.
fn entered(
  front: LoadedAnalysis,
  analysis: Analysis,
  root: String,
  asked: List<Asked>,
  steps: Int,
) -> Result<List<Judged>, List<Diag>> / {emit.unit, machine.configure[literals], machine.load[literals], machine.bound[literals], machine.call[literals], machine.drop[literals], abort.raise} =
  if len(asked) == 0 { Ok([]) } else {
    let names = callees(asked);
    let reached = reach(analysis.hashes, map(names, |n: Bytes| TheFn(n))).fns;
    let offered = concat(
      filter(every_root(front), |n: Bytes| map_contains(reached, n)),
      map(filter(asked, is_const), |a: Asked| stored_root(a.callee)),
    );
    match text_of(emit.unit(front, offered)) {
      Err(diags) -> Err(diags),
      Ok(unit) -> {
        machine.configure[literals]({ ..default_options(), steps: steps });
        let answered = match machine.load[literals](root, front, unit) {
          Err(refused) -> Err(refused.diags),
          Ok(_) -> match machine.bound[literals](
              string_of_bytes_lossy(at(names, 0)),
              unconfigured(),
            ) {
            Err(refused) -> Err(refused.diags),
            Ok(_) ->
              Ok(
                map(asked, |a: Asked|
                  if is_const(a) {
                    value_of(
                      machine.call[literals](string_of_bytes_lossy(stored_root(a.callee)), []),
                    )
                  } else {
                    {
                      verdict: verdict_of(
                        machine.call[literals](string_of_bytes_lossy(a.callee), [handed(a)]),
                      ),
                      value: None,
                    }
                  }),
              ),
          },
        };
        machine.drop[literals]();
        answered
      },
    }
  }

/// What a verdict is a function of: the toolchain that entered the definition, the budget, the
/// definition by the hash of all it reaches, and the texts.
fn verdict_key(stamp: String, version: String, a: Asked) -> Bytes / {abort.raise} =
  hex(
    blake3(
      bytes_concat_all([
        sized(b"ply literal verdict 1"),
        sized(hex(bin::shape_digest(verdict_bin()))),
        sized(bytes_of_string(stamp)),
        sized(bytes_of_string(version)),
        sized(bytes_of_string(int_to_string(budget_of(a)))),
        sized(a.hash),
        sized(bytes_of_string(int_to_string(len(a.parts)))),
        bytes_concat_all(map(a.parts, sized)),
      ]),
    ),
  )

/// `value` is the key a `const` definition's value is kept under, which a unit finds it by.
type Sought = { asked: Asked, key: Bytes, value: Bytes, kept: Option<Verdict> }

/// `body` with every verdict it asks for read from the toolchain's cache, and the definitions of the
/// rest entered once and their verdicts kept there, a `const` definition's value beside its own:
/// the parsers on one machine and the `const` definitions on another, each under its budget.
pub fn settling<a | e>(
  body: () -> a / {literal.verdicts, literal.statements | e},
) -> a / {emit.unit, machine.configure[literals], machine.load[literals], machine.bound[literals], machine.call[literals], machine.drop[literals], shipped.runtime, shipped.definitions, env.bodies[sys], env.shipped_digest[sys], env.binary_version[sys], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise | e} =
  handle {
    body()
  } with {
    literal.statements(timed, analysis, root, asked) ->
      judgements(under_abs(env.bodies[sys]()), root, timed, analysis, asked),
    literal.verdicts(timed, analysis, root, asked) -> {
      let dir = under_abs(env.bodies[sys]());
      let stamp = env.shipped_digest[sys]();
      let version = env.binary_version[sys]();
      let runtime = shipped.runtime().identity;
      let emitter = emitter_identity(shipped.definitions());
      let sought = map(asked, |a: Asked| {
        let key = verdict_key(stamp, version, a);
        let value = if is_const(a) { baked_key(runtime, emitter, a.hash) } else { b"" };
        let verdict = match read_kept[abs](dir, key) {
          None -> None,
          Some(bytes) -> match bin::decode(bytes, verdict_bin()) {
            Ok(v) -> Some(v),
            Err(_) -> None,
          },
        };
        {
          asked: a,
          key: key,
          value: value,
          // An accepted `const` definition stands only while its value is still kept.
          kept: if is_const(a) && verdict == Some(Accepted) && kept_value[abs](dir, value) == None {
            None
          } else { verdict },
        }
      });
      let open = filter(sought, |s: Sought| s.kept == None);
      if len(open) == 0 { Ok(settled(sought, [])) } else {
        let front = front_of(
          timed,
          analysis,
          Some(entering(analysis, callees(map(open, |s: Sought| s.asked)))),
        );
        let parsers = filter(open, |s: Sought| !is_const(s.asked));
        let consts = filter(open, |s: Sought| is_const(s.asked));
        let over = |some: List<Sought>, steps: Int|
          entered(front, analysis, root, map(some, |s: Sought| s.asked), steps);
        match over(parsers, step_budget()) {
          Err(diags) -> Err(diags),
          Ok(parsed) -> match over(consts, const_budget()) {
            Err(diags) -> Err(diags),
            Ok(evaluated) -> {
              let judged = concat(parsed, evaluated);
              let entries = concat(parsers, consts);
              fold(range(0, len(entries)), (), |_: Unit, i: Int|
                match list_at(judged, i) {
                  None -> (),
                  Some(j) -> {
                    let s = at(entries, i);
                    match j.value { Some(text) -> keep_value[abs](dir, s.value, text), None -> () };
                    // A place is this load's, which an edit elsewhere moves under the same hash.
                    match j.verdict {
                      RaisedAt(_) -> (),
                      v -> write_kept[abs](dir, s.key, bin::encode(v, verdict_bin())),
                    }
                  },
                });
              Ok(
                settled(
                  sought,
                  map(open, |s: Sought|
                    fold(range(0, len(entries)), Spent, |found: Verdict, i: Int|
                      if at(entries, i).key == s.key {
                        match list_at(judged, i) { Some(j) -> j.verdict, None -> found }
                      } else { found })),
                ),
              )
            },
          },
        }
      }
    },
  }

/// A statement asked after, the key its judgement is kept under, and the judgement kept there.
type Keyed = { asked: statements::Asked, key: Bytes, kept: Option<Judgement> }

/// Each statement's judgement: the one kept for it, or the one the statements not kept were judged
/// to, in their order.
fn judgements(
  dir: String,
  root: String,
  timed: Timed,
  analysis: Analysis,
  asked: List<statements::Asked>,
) -> Result<List<Judgement>, List<Diag>> / {emit.unit, machine.configure[literals], machine.load[literals], machine.bound[literals], machine.call[literals], machine.drop[literals], env.shipped_digest[sys], env.binary_version[sys], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} = {
  let stamp = env.shipped_digest[sys]();
  let version = env.binary_version[sys]();
  let keyed = map(asked, |a: statements::Asked| {
    let key = judgement_key(stamp, version, step_budget(), a);
    {
      asked: a,
      key: key,
      kept: match read_kept[abs](dir, key) {
        None -> None,
        Some(bytes) -> match bin::decode(bytes, judgement_bin()) {
          Ok(j) -> Some(j),
          Err(_) -> None,
        },
      },
    }
  });
  let open = filter(keyed, |k: Keyed| k.kept == None);
  if len(open) == 0 { Ok(map(keyed, |k: Keyed| match k.kept { Some(j) -> j, None -> Unjudged })) }
  else {
    match judged(
        |within: Within| front_of(timed, analysis, Some(within)),
        analysis,
        root,
        step_budget(),
        map(open, |k: Keyed| k.asked),
      ) {
      Err(diags) -> Err(diags),
      Ok(found) -> {
        fold(range(0, len(open)), (), |_: Unit, i: Int|
          match list_at(found, i) {
            Some(j) -> write_kept[abs](dir, at(open, i).key, bin::encode(j, judgement_bin())),
            None -> (),
          });
        Ok(
          fold(
            keyed,
            { out: [], next: 0 },
            |acc: { out: List<Judgement>, next: Int }, k: Keyed|
              match k.kept {
                Some(j) -> { out: push(acc.out, j), next: acc.next },
                None ->
                  {
                    out: push(acc.out, match list_at(found, acc.next) {
                      Some(j) -> j,
                      None -> Unjudged,
                    }),
                    next: acc.next + 1,
                  },
              },
          ).out,
        )
      },
    }
  }
}

/// Each verdict sought, in order: the one kept, or the next of `found`, which holds the rest's.
fn settled(sought: List<Sought>, found: List<Verdict>) -> List<Verdict> =
  fold(sought, { out: [], next: 0 }, |acc: { out: List<Verdict>, next: Int }, s: Sought|
    match s.kept {
      Some(v) -> { out: push(acc.out, v), next: acc.next },
      None ->
        {
          out: match list_at(found, acc.next) { Some(v) -> push(acc.out, v), None -> acc.out },
          next: acc.next + 1,
        },
    }).out

// --- Tests ------------------------------------------------------------------

fn a_site(text: Bytes) -> TaggedSite =
  {
    module: 0,
    span: { start: 0, end: 5 + bytes_len(text) },
    tag: b"hex",
    parts: [{ text: text, quoted: { start: 3, end: 5 + bytes_len(text) } }],
    callee: b"hex.literal",
    hash: b"h",
  }

test "a character of a literal's text is placed where its source spells it" {
  let src = b"hex\"a\\n\\u{e9}\xc3\xa9z\"";
  let quoted = { start: 3, end: bytes_len(src) };
  assert_eq(spelled_at(src, quoted, 0), Some({ start: 4, end: 5 }));
  assert_eq(spelled_at(src, quoted, 1), Some({ start: 5, end: 7 }));
  assert_eq(spelled_at(src, quoted, 2), Some({ start: 7, end: 13 }));
  assert_eq(spelled_at(src, quoted, 3), Some({ start: 13, end: 15 }));
  assert_eq(spelled_at(src, quoted, 4), Some({ start: 15, end: 16 }));
  // One past the text is its closing quote, where a text that ends too soon is refused.
  assert_eq(spelled_at(src, quoted, 5), Some({ start: 16, end: 17 }));
  assert_eq(spelled_at(src, quoted, 6), None);
  assert_eq(spelled_at(src, quoted, 0 - 1), None);
  // A brace of the text is written twice, and is one character of it.
  let braced = b"hex\"a{{}}z\"";
  let all = { start: 3, end: bytes_len(braced) };
  assert_eq(spelled_at(braced, all, 1), Some({ start: 5, end: 7 }));
  assert_eq(spelled_at(braced, all, 2), Some({ start: 7, end: 9 }));
  assert_eq(spelled_at(braced, all, 3), Some({ start: 9, end: 10 }))
}

test "a parser's answer is read as its verdict, and a spent budget is told from a raise" {
  let answered = |v: Value| verdict_of({ answer: Ok(v), warnings: [] });
  assert_eq(answered(VCtor("Ok", [VInt(1)])), Accepted);
  assert_eq(
    answered(
      VCtor("Err", [
        VRecord([{ name: "message", value: VStr("odd") }, { name: "offset", value: VInt(2) }]),
      ]),
    ),
    Rejected({ part: 0, offset: 2, message: "odd" }),
  );
  assert_eq(
    answered(
      VCtor("Err", [
        VRecord([
          { name: "message", value: VStr("odd") },
          { name: "offset", value: VInt(2) },
          { name: "part", value: VInt(1) },
        ]),
      ]),
    ),
    Rejected({ part: 1, offset: 2, message: "odd" }),
  );
  assert_eq(answered(VInt(1)), Raised("it answered 1"))
}

test "a refused literal is placed inside its text, and one past it at the whole literal" {
  let site = a_site(b"abz");
  let places = [{ path: "main.ply", text: b"hex\"abz\"" }];
  let labelled = |verdict: Verdict|
    match refusal(places, site, verdict) {
      Some(d) -> match list_at(d.labels, 0) {
        Some(l) -> Some({ code: d.code, start: l.start, end: l.end }),
        None -> None,
      },
      None -> None,
    };
  assert_eq(labelled(Accepted), None);
  assert_eq(
    labelled(Rejected({ part: 0, offset: 2, message: "not a hex digit" })),
    Some({ code: b"E0153", start: 6, end: 7 }),
  );
  assert_eq(
    labelled(Rejected({ part: 0, offset: 40, message: "too short" })),
    Some({ code: b"E0153", start: 3, end: 8 }),
  );
  assert_eq(labelled(Spent), Some({ code: b"E0154", start: 0, end: 8 }));
  assert_eq(labelled(Raised("boom")), Some({ code: b"E0154", start: 0, end: 8 }))
}

test "a refusal of a literal with holes is placed in the text it names, or on the hole after it" {
  let src = b"sh\"ab {x} cd{y}\"";
  let site = {
    module: 0,
    span: { start: 0, end: bytes_len(src) },
    tag: b"sh",
    parts: [
      { text: b"ab ", quoted: { start: 2, end: 7 } },
      { text: b" cd", quoted: { start: 8, end: 13 } },
      { text: b"", quoted: { start: 14, end: 16 } },
    ],
    callee: b"sh.compile",
    hash: b"h",
  };
  assert_eq(refused_at(src, site, 0, 1), { start: 4, end: 5 });
  assert_eq(refused_at(src, site, 1, 2), { start: 11, end: 12 });
  // Just past a text is the hole that follows it, braces and all, or the closing quote.
  assert_eq(refused_at(src, site, 0, 3), { start: 6, end: 9 });
  assert_eq(refused_at(src, site, 1, 3), { start: 12, end: 15 });
  assert_eq(refused_at(src, site, 2, 0), { start: 15, end: 16 });
  // A text or a character the literal has not is the whole string.
  assert_eq(refused_at(src, site, 3, 0), { start: 2, end: 16 });
  assert_eq(refused_at(src, site, 1, 9), { start: 2, end: 16 });
  assert_eq(handed(asked_of(site)), VList([VStr("ab "), VStr(" cd"), VStr("")]));
  assert_eq(handed(asked_of(a_site(b"ab"))), VStr("ab"))
}

test "verdicts kept come back in the order they were sought, the rest from what was found" {
  let a: Asked = { callee: b"m.literal", hash: b"h", parts: [b"a"] };
  let sought = [
    { asked: a, key: b"1", value: b"", kept: None },
    { asked: a, key: b"2", value: b"", kept: Some(Accepted) },
    { asked: a, key: b"3", value: b"", kept: None },
  ];
  assert_eq(settled(sought, [Spent, Raised("x")]), [Spent, Accepted, Raised("x")])
}

test "a `const` definition's answer is its value's text, kept only where a build has room" {
  let answered = |v: Value| value_of({ answer: Ok(v), warnings: [] });
  assert_eq(answered(VBytes(b"78")), { verdict: Accepted, value: Some(b"78") });
  assert_eq(answered(VInt(1)).verdict, Raised("its stored root answered 1"));
  let site = { module: 0, span: { start: 9, end: 14 }, name: b"m.table", hash: b"h" };
  let refused = |verdict: Verdict|
    match const_refusal(site, verdict) {
      Some(d) -> match list_at(d.labels, 0) {
        Some(l) -> Some({ code: d.code, start: l.start, end: l.end }),
        None -> None,
      },
      None -> None,
    };
  assert_eq(refused(Accepted), None);
  assert_eq(refused(Raised("boom")), Some({ code: b"E0157", start: 9, end: 14 }));
  let placed = const_refusal(site, RaisedAt({ message: "boom", module: 1, start: 3, end: 4 }));
  assert_eq(
    match placed {
      Some(d) -> map(d.labels, |l: Label| (l.module, l.start, l.primary)),
      None -> [],
    },
    [(0, 9, true), (1, 3, false)],
  );
  assert_eq(refused(Spent), Some({ code: b"E0158", start: 9, end: 14 }));
  assert_eq(refused(Oversize(const_room() + 1)), Some({ code: b"E0158", start: 9, end: 14 }))
}

test "a `const` definition is asked with no text, under its own budget" {
  let a = asked_const({ module: 0, span: { start: 0, end: 1 }, name: b"m.table", hash: b"h" });
  assert(is_const(a));
  assert_eq(budget_of(a), const_budget());
  assert_eq(budget_of({ ..a, parts: [b"x"] }), step_budget());
  assert(verdict_key("b3:a", "0.1.0", a) != verdict_key("b3:a", "0.1.0", { ..a, hash: b"g" }))
}

test "a verdict is kept under the toolchain, the parser's hash and the text" {
  let a: Asked = { callee: b"m.literal", hash: b"h", parts: [b"a"] };
  let key = verdict_key("b3:a", "0.1.0", a);
  assert_eq(verdict_key("b3:a", "0.1.0", { ..a, callee: b"n.literal" }), key);
  assert(verdict_key("b3:b", "0.1.0", a) != key);
  assert(verdict_key("b3:a", "0.2.0", a) != key);
  assert(verdict_key("b3:a", "0.1.0", { ..a, hash: b"g" }) != key);
  assert(verdict_key("b3:a", "0.1.0", { ..a, parts: [b"b"] }) != key);
  // The texts around a hole are not the one text they would join to.
  assert(
    verdict_key("b3:a", "0.1.0", { ..a, parts: [b"a", b"b"] })
      != verdict_key("b3:a", "0.1.0", { ..a, parts: [b"ab"] }),
  );
  assert(
    verdict_key("b3:a", "0.1.0", { ..a, parts: [b"a", b"b"] })
      != verdict_key("b3:a", "0.1.0", { ..a, parts: [b"ab", b""] }),
  )
}
