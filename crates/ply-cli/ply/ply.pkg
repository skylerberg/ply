import std.pkg (Manifest)

// The `ply` program itself: the root package of its own build. Its closure is std and the compiler,
// which are built in, plus the suite, which owns what a run *decides* -- the keys a result is filed
// under, which tests re-run, why a failure happened, and what a program's claims cover.
fn package() -> Manifest = {
  name: "cli",
  version: { major: 0, minor: 1, patch: 0 },
  prefix: None,
  runtime: { major: 0, minor: 16, patch: 0 },
  dependencies: [
    {
      name: "suite",
      prefix: None,
      min: { major: 0, minor: 1, patch: 0 },
      source: Path("../../ply-test/ply"),
    },
  ],
  entry: None,
}
