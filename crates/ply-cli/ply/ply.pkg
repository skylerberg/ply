import std.pkg (Manifest)

// The `ply` program itself: the root package of its own build, depending on nothing the
// shelf does not already grant (std and compiler are the built-in packages).
fn package() -> Manifest = {
  name: "cli",
  version: { major: 0, minor: 1, patch: 0 },
  prefix: None,
  runtime: { major: 0, minor: 16, patch: 0 },
  dependencies: [],
  entry: None,
}
