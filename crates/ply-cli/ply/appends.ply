//! Where an update (`push`, `list_set`, `array_set`) copies, before the program runs: `ply check
//! --costs` reads it out, and a `reuse fn` whose body copies is refused with it.

import compiler.costs (Report, Costed, Site, Unkept, Priced, Costing, costs, cost_keys, priced_of,
                       report_bin)
import compiler.embed (EmbedAt, EmbedFile)
import compiler.front (Analysis, View, Outline, Outlined, OFn, analyse_pulling_std_with, no_rows,
                       written_form, Analysed, Refused)
import compiler.hash (hex)
import compiler.resolve (Source, ParsedModule, Diag, PackageDeps, error_at, error_at_and)
import compiler.parsing (Span, no_module)
import compiler.unit (identity_of, read_kept, shipped, write_kept)
import diagnostic (Place, spot_of)
import env (env)
import program (Program, is_shipped, whole_of)
import report (indent)
import sources (under_abs)
import std.term (Style, bold, dim, red, green, yellow, plain)
import std.bin
import std.fs (fs)
import std.hash (blake3)
import std.random (entropy)
import std.time (time)
import std.string (repeat)
import std.list (at, concat, take)
import proof.obligation (plural)

/// Where the verdict column starts: wide enough for `stdlib.ply:1234:56`.
fn location_width() -> Int = 22

/// A command asks for the cost checker's report on a program; what answers is `pricing`'s, which
/// `main` runs every command under, or a handler of the asker's own. The report is a function of the
/// program's text, of the checker, and of the front end, whose analysis it reads; so the effect is a
/// deterministic one, whatever the answering keeps. What the answering walked and lowered to make it
/// is the answering's, and holds nothing to keep.
pub effect priced {
  read report(p: Priced) -> Costing
}

/// Only the run's own updates: a dependency's are costed when it is the package checked.
pub fn costs_of(program: Program, analysis: Analysis) -> Costing / {priced.report, abort.raise} = {
  let srcs = map(range(0, len(analysis.mods)), |i: Int|
    match list_at(program.places, i) { Some(place) -> place.text, None -> b"" });
  let c = priced.report(priced_of(analysis, srcs));
  {
    ..c,
    report: { ..c.report, defs: filter(c.report.defs, |d: Costed| d.module < len(program.files)) },
  }
}

/// A `reuse fn` whose promise the cost checker cannot show, and a `returns` clause it cannot show of
/// its body, as the diagnostics a run is refused with; nothing at all when none of the run's own
/// modules writes either.
pub fn broken_promises(program: Program, view: View) -> List<Diag> / {priced.report, abort.raise} =
  if !promised(program, view) { [] } else {
    match whole_of(program) {
      Err(ds) -> ds,
      Ok(w) -> {
        let r = costs_of(program, w).report;
        if !r.ok { [unresolved()] } else {
          fold(r.unkept, promises(r), |acc: List<Diag>, u: Unkept| push(acc, unkept_returns(u)))
        }
      },
    }
  }

/// The definitions a report is a function of besides the program: the checker's entry, and the
/// front end's, whose check read the facts the checker costs bodies by.
fn checker_roots() -> List<Bytes> =
  [b"costs.costs", b"costs.cost_keys", b"front.analyse_pulling_std_with"]

/// What a report is a function of beyond the checker, `identity`: every module's name and text, the
/// packages and which each module is in, and what each module embeds.
fn costs_key(
  identity: Bytes,
  names: List<Bytes>,
  srcs: List<Bytes>,
  pkgs: List<PackageDeps>,
  module_packages: List<Int>,
  shipped: Int,
  embeds: List<EmbedAt>,
) -> Bytes / {abort.raise} = {
  let n = |i: Int| bytes_of_string(int_to_string(i));
  let read = |e: EmbedAt|
    match e.read {
      Ok(files) ->
        bytes_concat_all(
          map(files, |f: EmbedFile| bytes_concat_all([f.name, b"\x00", blake3(f.bytes)])),
        ),
      Err(why) -> bytes_concat(b"!", why),
    };
  hex(
    blake3(
      bytes_concat_all([
        b"ply.costs.1\x00",
        hex(bin::shape_digest(report_bin())),
        b"\x00",
        identity,
        b"\x00",
        bytes_concat_all(
          map(range(0, len(names)), |i: Int|
            bytes_concat_all([
              match list_at(names, i) { Some(x) -> x, None -> b"" },
              b"\x00",
              match list_at(srcs, i) { Some(x) -> blake3(x), None -> b"" },
            ])),
        ),
        b"\x00",
        bytes_concat_all(
          map(pkgs, |p: PackageDeps|
            bytes_concat_all([
              p.prefix,
              b"(",
              bytes_concat_all(map(p.deps, |d: Bytes| bytes_concat(d, b","))),
              b")",
            ])),
        ),
        b"\x00",
        bytes_concat_all(map(module_packages, |k: Int| bytes_concat(n(k), b","))),
        b"\x00",
        n(shipped),
        b"\x00",
        bytes_concat_all(
          map(embeds, |e: EmbedAt|
            bytes_concat_all([e.module, b"\x00", e.key, b"\x00", read(e), b"\x00"])),
        ),
      ]),
    ),
  )
}

/// What a report is a function of in each module's text. A shipped module's bodies are never
/// walked, so of it only what the program holds counts: the hashes of its definitions and
/// declarations the load kept, which a function the program does not reach is not among, and its
/// form. Any other module's text counts whole.
fn keyed_sources(a: Analysis, srcs: List<Bytes>) -> List<Bytes> / {abort.raise} = {
  let owner = |name: Bytes| {
    let dot = fold(range(0, bytes_len(name)), 0 - 1, |acc: Int, i: Int|
      if bytes_at(name, i) == 46 { i } else { acc });
    if dot < 0 { b"" } else { bytes_slice(name, 0, dot) }
  };
  let held = fold(
    concat(a.hashes.defs, a.hashes.decls),
    map_new(),
    |acc: Map<Bytes, List<Bytes>>, d: { name: Bytes, hash: Bytes }| {
      let m = owner(d.name);
      map_insert(
        acc,
        m,
        push(
          match map_get(acc, m) { Some(xs) -> xs, None -> [] },
          bytes_concat_all([d.name, b" ", d.hash, b"\n"]),
        ),
      )
    },
  );
  map(range(0, len(a.mods)), |i: Int| {
    let m = at(a.mods, i);
    let src = match list_at(srcs, i) { Some(x) -> x, None -> b"" };
    if !is_shipped(string_of_bytes_lossy(m.name)) { src } else {
      bytes_concat_all(
        concat(
          [b"shipped\x00", written_form(m.module, src), b"\x00"],
          match map_get(held, m.name) { Some(xs) -> xs, None -> [] },
        ),
      )
    }
  })
}

/// `body` with every cost report it asks for kept under the toolchain's cache, as the emitter's
/// answers are: a program whose every text stands takes its report whole, and any other has each of
/// its modules' walks taken back as `costs` finds them still answering.
pub fn pricing<a | e>(
  body: () -> a / {priced.report | e},
) -> a / {abort.raise, shipped.definitions, env.bodies[sys], fs.read[abs], fs.write[abs], entropy.next, time.now_ms | e} =
  handle {
    body()
  } with {
    priced.report(p) -> {
      let dir = under_abs(env.bodies[sys]());
      let identity = identity_of(shipped.definitions(), checker_roots());
      let a = p.analysis;
      let key = costs_key(
        identity,
        map(a.mods, |m: ParsedModule| m.name),
        keyed_sources(a, p.srcs),
        a.packages,
        a.module_packages,
        len(a.packages),
        a.embeds,
      );
      let kept = match read_kept[abs](dir, key) {
        Some(bytes) -> match bin::decode(bytes, report_bin()) { Ok(r) -> Some(r), Err(_) -> None },
        None -> None,
      };
      match kept {
        Some(r) -> { report: r, kept: [], walked: 0, lowered: 0 },
        None -> {
          let keys = cost_keys(p, identity);
          let c = costs(
            p,
            map(keys, |k: Bytes| if bytes_len(k) == 0 { None } else { read_kept[abs](dir, k) }),
          );
          fold(range(0, len(keys)), (), |_: Unit, i: Int|
            match list_at(c.kept, i) {
              Some(Some(bytes)) -> match list_at(keys, i) {
                Some(k) -> write_kept[abs](dir, k, bytes),
                None -> (),
              },
              _ -> (),
            });
          write_kept[abs](dir, key, bin::encode(c.report, report_bin()));
          { ..c, kept: [] }
        },
      }
    },
  }

/// `body` with every cost report worked out afresh and kept nowhere: for a program that drives
/// another and has no toolchain cache of its own.
pub fn pricing_fresh<a | e>(body: () -> a / {priced.report | e}) -> a / {abort.raise | e} =
  handle { body() } with { priced.report(p) -> { ..costs(p), kept: [] } }

/// Whether one of the run's own modules writes a `reuse fn` or a `returns` clause, so the promise
/// check can be skipped.
pub fn promised(program: Program, view: View) -> Bool =
  fold(take(view.outlines, len(program.files)), false, |any: Bool, o: Outline|
    any
      || fold(o.items, false, |a: Bool, it: Outlined|
        a || (match it { OFn(f) -> f.reuse || f.returns, _ -> false })))

fn unkept_returns(u: Unkept) -> Diag =
  error_at(
    b"E0148",
    u.module,
    { start: u.start, end: u.end },
    bytes_concat_all([
      b"`",
      u.name,
      b"` says it returns ",
      u.said,
      b", and its body answers ",
      u.answers,
    ]),
    b"the clause",
    [
      b"a caller in another package reads this clause in place of the body: write what the body answers, or change the body",
    ],
  )

// --- The listing ------------------------------------------------------------------

fn basename(path: String) -> String = {
  let parts = string_split(path, "/");
  match list_at(parts, len(parts) - 1) { Some(last) -> last, None -> path }
}

fn located(places: List<Place>, module: Int, offset: Int) -> String / {abort.raise} =
  match list_at(places, module) {
    None -> "<unknown>",
    Some(place) -> {
      let spot = spot_of(place.text, offset);
      basename(place.path) ++ ":" ++ int_to_string(spot.line) ++ ":" ++ int_to_string(spot.col)
    },
  }

fn counted(d: Costed, verdict: Bytes) -> Int =
  fold(d.sites, 0, |acc: Int, s: Site| if s.verdict == verdict { acc + 1 } else { acc })

fn worded(n: Int, word: String, said: String) -> String =
  if n == 0 { said }
  else if said == "" { int_to_string(n) ++ " " ++ word }
  else { said ++ ", " ++ int_to_string(n) ++ " " ++ word }

fn tally(d: Costed) -> String =
  worded(
    counted(d, b"unknown"),
    "unknown",
    worded(counted(d, b"copies"), "COPIES", worded(counted(d, b"reuses"), "reuses", "")),
  )

fn kind_of(d: Costed) -> String =
  if d.kind == b"test" { " (test)" } else if d.kind == b"law" { " (law)" } else { "" }

fn painted(style: Style, verdict: Bytes) -> String =
  if verdict == b"reuses" { green(style, "reuses ") }
  else if verdict == b"copies" { red(style, "COPIES ") }
  else { yellow(style, "unknown") }

fn site_lines(
  style: Style,
  places: List<Place>,
  d: Costed,
  lines: List<String>,
  site: Site,
) -> List<String> / {abort.raise} = {
  let at = located(places, d.module, site.start);
  let pad = if string_len(at) >= location_width() { 0 } else { location_width() - string_len(at) };
  let said = push(
    lines,
    "    " ++ at ++ repeat(" ", pad) ++ "  " ++ painted(style, site.verdict) ++ "  "
      ++ string_of_bytes_lossy(site.reason),
  );
  if bytes_len(site.fix) == 0 { said } else {
    push(
      said,
      "    " ++ repeat(" ", location_width()) ++ "  " ++ repeat(" ", 7) ++ "  "
        ++ dim(style, "fix: " ++ string_of_bytes_lossy(site.fix)),
    )
  }
}

fn def_lines(
  style: Style,
  places: List<Place>,
  lines: List<String>,
  d: Costed,
) -> List<String> / {abort.raise} = {
  let head = push(
    push(lines, ""),
    "  " ++ bold(style, string_of_bytes_lossy(d.label)) ++ dim(style, kind_of(d)) ++ "  "
      ++ dim(style, tally(d)),
  );
  fold(d.sites, head, |acc: List<String>, site: Site| site_lines(style, places, d, acc, site))
}

fn total(report: Report, verdict: Bytes) -> Int =
  fold(report.defs, 0, |acc: Int, d: Costed| acc + counted(d, verdict))

fn summary(report: Report) -> String / {abort.raise} = {
  let reuses = total(report, b"reuses");
  let copies = total(report, b"copies");
  let undecided = total(report, b"unknown");
  int_to_string(reuses + copies + undecided) ++ " updates: " ++ int_to_string(reuses) ++ " reuse, "
    ++ int_to_string(copies)
    ++ " copy, "
    ++ int_to_string(undecided)
    ++ " undecided — "
    ++ int_to_string(report.rounds)
    ++ " "
    ++ plural(report.rounds, "round")
}

/// The whole report, or the one line a program that updates nothing gets.
pub fn report_lines(
  style: Style,
  places: List<Place>,
  report: Report,
) -> List<String> / {abort.raise} =
  if len(report.defs) == 0 { ["", indent() ++ dim(style, "no updates: nothing to cost")] } else {
    push(
      push(
        fold(report.defs, [""], |acc: List<String>, d: Costed| def_lines(style, places, acc, d)),
        "",
      ),
      "  " ++ dim(style, summary(report)),
    )
  }

// --- The promise ------------------------------------------------------------------

/// The program resolved once for the front end, so a pass that cannot resolve it is Ply's fault.
pub fn unresolved() -> Diag =
  error_at(
    b"E0505",
    no_module(),
    { start: 0, end: 0 },
    b"the compiler could not say where this program's updates copy: it did not resolve in the cost pass",
    b"no update was costed, so no promise is claimed kept",
    [b"this is Ply's fault: the compiler's own `costs.ply` is what failed here"],
  )

fn unkept(d: Costed, promise: Span, site: Site) -> Diag = {
  let held = if site.op == b"array_set" { b"array" } else { b"list" };
  let what = if site.verdict == b"copies" { bytes_concat(b"copies its ", held) }
  else { bytes_concat(b"cannot be shown to reuse its ", held) };
  let note = if bytes_len(site.fix) == 0 {
    b"no edit inside this body removes the copy; the promise cannot be kept as written, so either restructure the update or drop `reuse`"
  } else { bytes_concat(b"fix: ", site.fix) };
  error_at_and(
    b"E0127",
    d.module,
    { start: site.start, end: site.end },
    bytes_concat_all([
      b"`",
      d.name,
      b"` is a `reuse fn`, and this `",
      site.op,
      b"` ",
      what,
      b": ",
      site.reason,
    ]),
    b"this update",
    d.module,
    promise,
    b"the promise",
    [note],
  )
}

/// Each `reuse fn`'s updates must reuse, except of its own parameter.
pub fn promises(report: Report) -> List<Diag> =
  fold(report.defs, [], |acc: List<Diag>, d: Costed|
    match d.reuse {
      None -> acc,
      Some(promise) ->
        fold(d.sites, acc, |diags: List<Diag>, site: Site|
          if site.verdict == b"reuses" || site.param >= 0 { diags }
          else { push(diags, unkept(d, promise, site)) }),
    })

// --- Tests ------------------------------------------------------------------

test "a cost report's key moves with the checker, a module's text, the packages and an embed" {
  let srcs = [b"fn f() -> Int = 1", b"fn g() -> Int = 2"];
  let embedded = |bytes: Bytes|
    [{ module: b"m", key: b"file:x", read: Ok([{ name: b"", bytes: bytes }]) }];
  let key = |identity: Bytes, texts: List<Bytes>, module_packages: List<Int>, embeds: List<EmbedAt>|
    costs_key(identity, [b"m", b"n"], texts, [], module_packages, 1, embeds);
  let base = key(b"c", srcs, [0, 0], []);
  assert_eq(key(b"c", srcs, [0, 0], []), base);
  assert(key(b"d", srcs, [0, 0], []) != base, None);
  assert(key(b"c", [b"fn f() -> Int = 1", b"fn g() -> Int = 3"], [0, 0], []) != base, None);
  assert(key(b"c", srcs, [0, 1], []) != base, None);
  assert(key(b"c", srcs, [0, 0], embedded(b"1")) != key(b"c", srcs, [0, 0], embedded(b"2")), None)
}

test "a cost report stands over a shipped module that gained what the program does not reach" {
  let user: Source = { name: b"m", src: b"import std.x (f)\npub fn use() -> Int = f()\n" };
  let keyed = |x: Bytes|
    match analyse_pulling_std_with([user], [{ name: b"std.x", src: x }], [], []).out {
      Analysed(a) ->
        keyed_sources(
          a,
          map(a.mods, |m: ParsedModule| if m.name == b"std.x" { x } else { user.src }),
        ),
      Refused(_) -> panic("the program checks"),
    };
  let base = keyed(b"pub fn f() -> Int = 1\n");
  assert_eq(keyed(b"pub fn f() -> Int = 1\n\npub fn g() -> Int = 2\n"), base);
  assert(keyed(b"pub fn f() -> Int = 2\n") != base, Some("what the program reaches moved"))
}

fn place() -> List<Place> = [{ path: "src/m.ply", text: b"fn f() -> Int = 1\nfn g() -> Int = 2\n" }]

fn site(verdict: Bytes, reason: Bytes, fix: Bytes, param: Int) -> Site =
  { start: 18, end: 29, op: b"push", verdict: verdict, reason: reason, fix: fix, param: param }

fn costed(kind: Bytes, sites: List<Site>, reuse: Option<Span>) -> Costed =
  {
    kind: kind,
    module: 0,
    module_name: b"m",
    name: b"grow",
    label: b"m.grow",
    reuse: reuse,
    sites: sites,
  }

test "a definition's tally names only the verdicts it has, in one order" {
  assert_eq(tally(costed(b"fn", [site(b"reuses", b"", b"", 0 - 1)], None)), "1 reuses");
  assert_eq(
    tally(
      costed(
        b"fn",
        [
          site(b"reuses", b"", b"", 0 - 1),
          site(b"copies", b"", b"", 0 - 1),
          site(b"unknown", b"", b"", 0 - 1),
        ],
        None,
      ),
    ),
    "1 reuses, 1 COPIES, 1 unknown",
  );
  assert_eq(tally(costed(b"fn", [], None)), "")
}

test "a program that updates nothing is told so on one line" {
  assert_eq(report_lines(plain(), place(), { ok: true, rounds: 1, defs: [], unkept: [] }), [
    "",
    "   no updates: nothing to cost",
  ])
}

test "a site is placed by its file's base name and the verdict column does not move" {
  let r: Report = {
    ok: true,
    rounds: 2,
    defs: [costed(b"fn", [site(b"copies", b"read again", b"bind it first", 0 - 1)], None)],
    unkept: [],
  };
  assert_eq(report_lines(plain(), place(), r), [
    "",
    "",
    "  m.grow  1 COPIES",
    "    m.ply:2:1               COPIES   read again",
    "                                     fix: bind it first",
    "",
    "  1 updates: 0 reuse, 1 copy, 0 undecided — 2 rounds",
  ])
}

test "a `reuse fn` is refused for a copy its own body causes and for nothing else" {
  let promise = Some({ start: 0, end: 5 });
  let kept: Report = {
    ok: true,
    rounds: 1,
    defs: [costed(b"fn", [site(b"reuses", b"fine", b"", 0 - 1)], promise)],
    unkept: [],
  };
  assert_eq(promises(kept), []);
  // An update of the definition's own parameter is the caller's business, not this body's.
  let caller: Report = {
    ok: true,
    rounds: 1,
    defs: [costed(b"fn", [site(b"copies", b"a caller keeps it", b"", 0)], promise)],
    unkept: [],
  };
  assert_eq(promises(caller), []);
  let broken: Report = {
    ok: true,
    rounds: 1,
    defs: [costed(b"fn", [site(b"copies", b"read again", b"`map_update`", 0 - 1)], promise)],
    unkept: [],
  };
  let raised = promises(broken);
  assert_eq(len(raised), 1);
  let d = match list_at(raised, 0) { Some(x) -> x, None -> panic("one diagnostic") };
  assert_eq(d.code, b"E0127");
  assert_eq(d.message, b"`grow` is a `reuse fn`, and this `push` copies its list: read again");
  assert_eq(d.notes_text, [b"fix: `map_update`"]);
  assert_eq(len(d.labels), 2);
  // A body nothing can be done about says so rather than naming an edit.
  let hopeless: Report = {
    ok: true,
    rounds: 1,
    defs: [costed(b"fn", [site(b"unknown", b"a call", b"", 0 - 1)], promise)],
    unkept: [],
  };
  assert_eq(map(promises(hopeless), |x: Diag| x.message), [
    b"`grow` is a `reuse fn`, and this `push` cannot be shown to reuse its list: a call",
  ]);
  let array: Report = {
    ok: true,
    rounds: 1,
    defs: [
      costed(b"fn", [{ ..site(b"copies", b"read again", b"", 0 - 1), op: b"array_set" }], promise),
    ],
    unkept: [],
  };
  assert_eq(map(promises(array), |x: Diag| x.message), [
    b"`grow` is a `reuse fn`, and this `array_set` copies its array: read again",
  ])
}

test "a definition with no promise is costed and never refused" {
  let r: Report = {
    ok: true,
    rounds: 1,
    defs: [costed(b"fn", [site(b"copies", b"read again", b"", 0 - 1)], None)],
    unkept: [],
  };
  assert_eq(promises(r), [])
}

test "a `returns` clause its body does not keep is refused where it is written" {
  let d = unkept_returns({
    module: 0,
    module_name: b"m",
    name: b"m.pick",
    start: 40,
    end: 42,
    said: b"its parameter `ys`",
    answers: b"its parameter `xs`",
  });
  assert_eq(d.code, b"E0148");
  assert_eq(
    d.message,
    b"`m.pick` says it returns its parameter `ys`, and its body answers its parameter `xs`",
  )
}
