/// One atom of a test's footprint, as a scheduler compares them and as the printer spells it.
pub type Printed = { atom: Atom, text: String }

/// The options record, built from the parsed line.
pub fn options_from(p: Parsed, root: String) -> Options / {abort.raise} = {
  let machine_options = machine::options_from(p);
  {
    path: root,
    json: has(p, "json"),
    explain: has(p, "explain"),
    no_cache: has(p, "no-cache"),
    filters: values_of(p, "filter"),
    jobs: match value(p, "jobs") { Some(v) -> parse_nat(v), None -> None },
    steps: match value(p, "steps") {
      Some(v) -> match parse_nat(v) { Some(n) -> n, None -> 0 },
      None -> 1000000000,
    },
    timeout: match value(p, "timeout") {
      Some(v) -> match parse_nat(v) { Some(n) -> n, None -> 0 },
      None -> 60000,
    },
    bisect: match value(p, "bisect") { Some(v) -> v, None -> "auto" },
    bisect_budget: match value(p, "bisect-budget") {
      Some(v) -> match parse_nat(v) { Some(n) -> n, None -> 0 },
      None -> 64,
    },
    coverage: has(p, "coverage"),
    mutate: value(p, "mutate"),
    mutate_budget: match value(p, "mutate-budget") {
      Some(v) -> match parse_nat(v) { Some(n) -> n, None -> 0 },
      None -> 64,
    },
    profile: machine_options.profile,
    watch: has(p, "watch"),
    std: has(p, "std"),
    host: machine_options.host,
    tls: machine_options.tls,
    trust: machine_options.trust,
    fs: machine_options.fs,
    exec: machine_options.exec,
    allow: machine_options.allow,
    config: machine_options.config,
    sim: machine::sim_options_from(p),
  }
}

pub type Refusal = { diags: List<Diag>, places: List<Place> }

/// Whole microseconds, as the clock the runner reads counts them: every reading in both forms is
/// printed from the same integer, so a line and its document cannot disagree by a rounding.
pub type Phases = { read_us: Int, front_us: Int, write_back_us: Int }

pub type ModuleView = { name: String, file: String }

/// How the runtime is asked for one of the run's tests: the test of the loaded program it is, by
/// index and by key, and over cases the case. `unlisted` is why a test's cases could not be listed,
/// which is then how the test ends.
pub type Entry = { test: Int, of: String, case: Option<Chosen>, unlisted: Option<Unlisted> }

/// One test still in scope, and what the store said about it. `test` is a reserved word, so a
/// single one of them is a case.
pub type Case = {
  index: Int,
  entry: Entry,
  key: String,
  name: String,
  module: String,
  nondet: Bool,
  /// `None` when the front end produced no hash, which is what `unhashed` means.
  hash: Option<String>,
  footprint: String,
  /// Every atom of the footprint: which of them another test could contend over is the suite's.
  atoms: List<Printed>,
  /// Something in its closure entered a `simulate` region, so it is searched and keyed on the plan.
  seeded: Bool,
}

/// What the program decided about a run: the reason for each test, the roots a seeded one still owes,
/// which tests run, the classes they share, and the summary over them. The report reads all of it
/// from here rather than from the runtime, which no longer decides any of it.
pub type Decided = {
  /// The search every seeded test is keyed on, and the options document's account of it.
  search: Search,
  sim: Json,
  // Each by its test's index: a run reports on thousands, and every line asks of one.
  reasons: Map<Int, Reason>,
  owed: Map<Int, Int>,
  runs: List<Int>,
  running: Map<Int, Bool>,
  /// Which class each running test landed in.
  at: Map<Int, Int>,
  classes: List<Group>,
  parallelism: Parallelism,
}

fn reason_of(decided: Decided, index: Int) -> Reason =
  match map_get(decided.reasons, index) { Some(reason) -> reason, None -> Cached }

fn runs_test(decided: Decided, index: Int) -> Bool = map_contains(decided.running, index)

/// The read whose move brought a cached test back, when one did.
fn moved_of(decided: Decided, index: Int) -> Option<String> =
  match reason_of(decided, index) { Changed(what) -> Some(what), _ -> None }

/// The same over the tests this run reports on, which `--filter` may have narrowed.
fn selected_count(program: Program, decided: Decided) -> Int =
  len(filter(program.cases, |case: Case| runs_test(decided, case.index)))

fn cached_count(program: Program, decided: Decided) -> Int =
  len(program.cases) - selected_count(program, decided)

/// The cached tests a pass answered by the code they compile to rather than by their own key.
fn by_code_count(program: Program, decided: Decided) -> Int =
  len(filter(program.cases, |case: Case| reason_of(decided, case.index) == SameCode))

/// What the program decided about the conflict graph: the classes it coloured, the summary over
/// them, and which class each test landed in — which is only the tests that run, since a class is
/// what a test *shares a worker* with.
fn group_of(decided: Decided, index: Int) -> Option<Int> = map_get(decided.at, index)

fn owed_of(decided: Decided, index: Int) -> Int =
  match map_get(decided.owed, index) { Some(owed) -> owed, None -> 0 }

/// A class's footprint is the union of its tests', printed as one footprint is.
fn group_of_class(analysis: Analysis, class: List<Int>) -> Group / {abort.raise} =
  {
    tests: class,
    footprint: footprint_text(
      canonical(
        fold(class, [], |acc: List<types::Atom>, i: Int|
          match test_at(analysis, i) { Some(t) -> concat(acc, t.footprint), None -> acc }),
      ),
    ),
  }

/// The footprint's atoms, unprinted.
fn atoms_of(case: Case) -> List<Atom> = map(case.atoms, |printed: Printed| printed.atom)

/// The atoms another test could contend over, printed.
fn shared_texts(case: Case) -> List<String> =
  map(filter(case.atoms, |printed: Printed| len(shared([printed.atom])) > 0), |printed: Printed|
    printed.text)

/// The shared footprint, as the printer spells a footprint.
fn shared_of(case: Case) -> String = "{" ++ join(shared_texts(case), ", ") ++ "}"

/// The classes the named tests share, coloured from the atoms each row carries.
fn classes_of(program: Program, runs: List<Int>) -> List<List<Int>> / {abort.raise} =
  group_by_conflict(scheduled_of(program, set_of(runs)))

/// The tests of `running` the run reports on, as the scheduler colours them.
fn scheduled_of(program: Program, running: Map<Int, Bool>) -> List<Scheduled> =
  map(filter(program.cases, |case: Case| map_contains(running, case.index)), |case: Case|
    { index: case.index, contends: shared(atoms_of(case)) })

/// The classes over every test the run reports on, when a pass will re-run any of them: only a
/// mutation does, so a run without one colours nothing it will not use.
fn every_of(program: Program, options: Options) -> List<List<Int>> / {abort.raise} =
  match options.mutate {
    None -> [],
    Some(_) -> classes_of(program, map(program.cases, |case: Case| case.index)),
  }

/// What the binding reaching some tests makes of each test the run reports on.
fn reported(reaches: List<Int>, case: Case) -> { atoms: List<Atom>, host: Bool } =
  { atoms: atoms_of(case), host: covers(reaches, case.index) }

fn counts_of(program: Program, reaches: List<Int>) -> Counts =
  counts(map(program.cases, |case: Case| reported(reaches, case)))

/// The whole decision, as the report reads it: a reason per test, what each seeded one still owes,
/// which tests run, and the classes they share.
fn decided_of(
  program: Program,
  decisions: List<Decision>,
  search: Search,
  sim: Json,
  groups: List<Group>,
  classes: List<List<Int>>,
) -> Decided / {abort.raise} = {
  let runs = filter(to_run(decisions), |i: Int| case_of(program, i) != None);
  let running = set_of(runs);
  {
    search: search,
    sim: sim,
    reasons: fold(decisions, map_new(), |acc: Map<Int, Reason>, x: Decision|
      if map_contains(acc, x.case.index) { acc } else { map_insert(acc, x.case.index, x.reason) }),
    owed: fold(decisions, map_new(), |acc: Map<Int, Int>, x: Decision|
      if !x.case.seeded || map_contains(acc, x.case.index) { acc } else {
        map_insert(acc, x.case.index, match x.case.owed {
          Some(roots) -> len(roots),
          None -> len(search.roots),
        })
      }),
    runs: runs,
    running: running,
    at: flattened(classes),
    classes: groups,
    parallelism: parallelism(
      map(program.cases, |case: Case| shared(atoms_of(case))),
      scheduled_of(program, running),
      classes,
    ),
  }
}

/// Each class's number, for the members it holds: a class is what a test shares a worker with.
fn flattened(classes: List<List<Int>>) -> Map<Int, Int> =
  fold(range(0, len(classes)), map_new(), |acc: Map<Int, Int>, i: Int|
    fold(at_or(classes, i, []), acc, |a: Map<Int, Int>, index: Int|
      if map_contains(a, index) { a } else { map_insert(a, index, i) }))

pub type Group = { tests: List<Int>, footprint: String }

/// How much of the corpus is trivially parallel, and what the rest costs.
pub type Parallelism = {
  total: Int,
  isolated: Int,
  shared: Int,
  region_contended: Int,
  scheduled: Int,
  groups: Int,
  shared_groups: Int,
}

pub type Program = {
  /// The root the load was rooted at, as a report prints it.
  root: String,
  files: List<String>,
  places: List<Place>,
  modules: List<ModuleView>,
  incremental: Bool,
  phases: Phases,
  /// Every test in the run's scope, filtered out or not: what "no `test` items" is decided over.
  declared: Int,
  /// The tests still in scope, in ascending index order.
  cases: List<Case>,
  /// Where each of `cases` is among them, by its index.
  positions: Map<Int, Int>,
  filtered_out: Int,
  warnings: List<Diag>,
  /// What the machine was configured with, placed under the key this report gives it.
  options: Json,
  /// The runtime stamp a pass is filed under beside its test's hash; `None` when the run files none.
  filed_under: Option<String>,
}

pub type Backend = {
  /// Which backend answered.
  name: String,
  fragment: Int,
  offered: Int,
  entered: Int,
  declined: Int,
  converted_in: Int,
  converted_out: Int,
  /// Absent unless the provider compiled something: analysis is paid once, code generation per worker.
  units: Option<Int>,
  analysis_nanos: Option<Int>,
  codegen_nanos: Option<Int>,
}

/// What a search run beside the pruned one explored; `bounded` when a spent budget or a failure
/// stopped it first.
pub type Cost = { explored: Int, bounded: Bool, rendered: String }

/// What one test's search did. Absent, never zeroed, on a test that reached no `simulate` region.
pub type Explored = {
  explored: Int,
  exhaustive: Bool,
  exhausted: Bool,
  /// `--measure-reduction` only: the same search blind to the order spawns and joins impose, and the
  /// same search unpruned.
  blind: Option<Cost>,
  naive: Option<Cost>,
  /// Tenths, so one division answers both the line and the document.
  reduction_tenths: Option<Int>,
  steps: Int,
  virtual_time_ns: Int,
  failing_seed: Option<String>,
}

pub type Outcome = {
  index: Int,
  name: String,
  hash: Option<String>,
  duration_us: Int,
  /// `passed`, `failed`, `panicked` or `abandoned`.
  status: String,
  diagnostic: Option<Raised>,
  search: Option<Explored>,
  /// `None` when nothing was written: a spent budget or an unobserved search proved nothing.
  cached: Option<Bool>,
  /// The operations the test performed, handled ones included, over every interleaving it ran.
  performs: Int,
}

pub type Culprit = { names: List<String>, at: Option<ModuleSpan> }

/// What a failure's cause came to. The runtime sends this whole shape — a program that searched
/// answers with its own verdict, and the document publishes whichever side decided.
pub type Bisect = {
  conclusive: Bool,
  requested: Bool,
  reason: String,
  culprits: List<Culprit>,
  verdict: String,
  skipped: Option<String>,
  confidence: String,
  groups: List<List<String>>,
  search: SearchStats,
}

pub type Site = { task: String, definition: Option<String>, access: String, at: Option<ModuleSpan> }

/// The two steps whose reordering at scheduling point `step` flipped a passing interleaving to this
/// one.
pub type Race = { left: Site, right: Site, step: Int }

/// One failure as the runtime reports it: what happened, and the facts its cause is decided from.
pub type Failed = {
  key: String,
  /// The label as the source wrote it.
  name: String,
  diagnostic: Raised,
  /// Two of the gate's facts; the mode is this run's own flag.
  defect: Bool,
  host: Bool,
  /// `None` when the test never passed, so there is no earlier definition set to compare against.
  search: Option<Evident>,
  /// The definitions in the closure the store has never seen pass, each with its current hash.
  suspects: List<{ name: String, hash: Option<String> }>,
  /// Nothing in this test's closure changed, which is not the same as nothing being ranked.
  unchanged: Bool,
  seed: Option<String>,
  race: Option<Race>,
  module: Option<String>,
  test_hash: Option<String>,
  nondet: Option<Bool>,
  status: Option<String>,
  /// The atoms the test's footprint declares.
  declared: Option<List<String>>,
}

/// One failure as a report shows it: the runtime's account, and what this program decided about its
/// cause.
pub type Fault = {
  key: String,
  name: String,
  diagnostic: Diag,
  defect: Bool,
  bisect: Bisect,
  /// Ranked, most likely first.
  suspects: List<Suspect>,
  unchanged: Bool,
  seed: Option<String>,
  race: Option<Race>,
  /// The command that replays the failing interleaving.
  replay: Option<String>,
  module: Option<String>,
  test_hash: Option<String>,
  nondet: Option<Bool>,
  status: Option<String>,
  declared: Option<List<String>>,
}

pub type Summary = { passed: Int, failed: Int, abandoned: Int, cached: Int, duration_us: Int }

pub type Simulated = {
  simulated: Int,
  total: Int,
  seeds: Int,
  interleavings: Int,
  exhaustive: Int,
  exhausted: Int,
  failed: Int,
}

pub type RunReport = {
  hermetic: Bool,
  /// `hermetic` or `host`.
  label: String,
  operations: Int,
  digest: String,
  handshakes: List<String>,
  hosts: Json,
  /// The tests this binding can reach, by index, ascending.
  reaches: List<Int>,
  workers: Int,
  backend: Option<Backend>,
  results: List<Outcome>,
  failures: List<Failed>,
  summary: Summary,
  simulation: Simulated,
  /// Not warnings: every later run believes an escaped cache entry.
  escapes: List<Diag>,
  warnings: List<Diag>,
  mutants: Option<Mutants>,
  coverage: Option<Coverage>,
  spent: Spent,
}

/// Where a run's time went, in microseconds of its clock: before the load began, then each phase
/// after it. The load's own phases are `Phases`.
pub type Spent = {
  before_us: Int,
  promises_us: Int,
  store_us: Int,
  selection_us: Int,
  handoff_us: Int,
  unit_us: Int,
  bind_us: Int,
  tests_us: Int,
  conclude_us: Int,
}

fn no_spent() -> Spent =
  {
    before_us: 0,
    promises_us: 0,
    store_us: 0,
    selection_us: 0,
    handoff_us: 0,
    unit_us: 0,
    bind_us: 0,
    tests_us: 0,
    conclude_us: 0,
  }

// --- Small things -----------------------------------------------------------

fn opt_bool(v: Option<Bool>) -> Json = match v { Some(b) -> Bool(b), None -> Null }

fn covers(xs: List<Int>, wanted: Int) -> Bool = len(filter(xs, |x: Int| x == wanted)) > 0

fn no_group() -> Group = { tests: [], footprint: "" }

fn no_culprit() -> Culprit = { names: [], at: None }

// --- Fixed point ------------------------------------------------------------

fn ms_tenths(us: Int) -> String / {abort.raise} = fixed_point((us + 50) / 100, 1)

fn ms_hundredths(us: Int) -> String / {abort.raise} = fixed_point((us + 5) / 10, 2)

fn ms_thousandths(us: Int) -> String / {abort.raise} = fixed_point(us, 3)

fn secs_hundredths(us: Int) -> String / {abort.raise} = fixed_point((us + 5000) / 10000, 2)

fn ns_as_ms_tenths(ns: Int) -> String / {abort.raise} = fixed_point((ns + 50000) / 100000, 1)

/// Per mille is tenths of a percent, so one division answers both digits.
fn share(part: Int, total: Int) -> String / {abort.raise} =
  pad_left(fixed_point(if total == 0 { 0 } else { part * 1000 / total }, 1), 5, " ") ++ "%"

fn millis(us: Int) -> Json / {abort.raise} =
  Number(option_unwrap_or(decimal_of_string(ms_thousandths(us)), decimal_of_int(0)))

// --- Naming and placing -----------------------------------------------------

/// The label in a single-module run, `<module>.<label>` otherwise.
fn display_of(program: Program, case: Case) -> String =
  if len(program.modules) > 1 { case.key } else { case.name }

fn short_of(hash: Option<String>) -> String / {abort.raise} =
  match hash { Some(h) -> string_slice(h, 0, 12), None -> repeat("-", 12) }

fn dim_place(style: Style, places: List<Place>, a: Option<ModuleSpan>) -> String / {abort.raise} =
  match a {
    None -> "",
    Some(spot) -> match located(places, spot) {
      Some(text) -> "   " ++ dim(style, text),
      None -> "",
    },
  }

fn primary_of(diag: Diag) -> Option<Label> =
  fold(diag.labels, None, |acc: Option<Label>, label: Label|
    match acc { Some(_) -> acc, None -> if label.primary { Some(label) } else { None } })

fn label_at(label: Label) -> ModuleSpan =
  { module: label.module, start: label.start, end: label.end }

fn location_json(places: List<Place>, diag: Diag) -> Json / {abort.raise} =
  match primary_of(diag) { None -> Null, Some(l) -> place_json(places, label_at(l)) }

fn one_diagnostic(diag: Diag, places: List<Place>) -> Json / {abort.raise} =
  match all_to_json([diag], places) { Array(xs) -> at_or(xs, 0, Null), other -> other }

// --- What the selection decided ---------------------------------------------

/// The document spells a reason as one word, so the halves of a name are joined rather than spaced.
fn keyed(reason: String) -> String / {abort.raise} = join(string_split(reason, " "), "_")

fn why(reason: String) -> String =
  if reason == "new" { "this hash has never gone green, so nothing is known about it" }
  else if reason == "changed" {
    "something its last pass read has changed since, so that pass no longer answers for it"
  } else if reason == "previous failure" {
    "the cache holds a failure, and a failure is never trusted"
  } else if reason == "cached" {
    "this exact hash already passed; re-running cannot reveal anything new"
  } else if reason == "same code" {
    "this hash is new, but the code it compiles to already passed; re-running cannot reveal anything new"
  } else { "no hash was produced, so the cache cannot answer for it" }

/// `region`, `shared` or `host`: a socket lives outside every region, so a host-backed test is not
/// isolated.
fn isolated_as(reaches: List<Int>, case: Case) -> String =
  isolation_word(isolation_of(reported(reaches, case)))

// --- The head ---------------------------------------------------------------
// Printed before a test runs, so it says only what the selection and the binding decided.

/// What the binding says before a test runs: which tests it reaches, and how many run at once.
type Opening = { hermetic: Bool, operations: Int, digest: String, reaches: List<Int>, workers: Int }

fn workers_of(options: Options, hosted: Hosted) -> Int =
  match options.jobs { Some(n) -> if n > 0 { n } else { hosted.cores }, None -> hosted.cores }

fn opening_of(options: Options, program: Program, hosted: Hosted) -> Opening =
  {
    hermetic: hosted.hermetic,
    operations: hosted.operations,
    digest: hosted.digest,
    reaches: filter(hosted.reaches, |i: Int| case_of(program, i) != None),
    workers: workers_of(options, hosted),
  }

fn selected_line(style: Style, program: Program, decided: Decided) -> String / {abort.raise} =
  indent() ++ bold(style, "selected") ++ " "
    ++ bold(style, int_to_string(selected_count(program, decided)))
    ++ " of "
    ++ int_to_string(len(program.cases))
    ++ " ("
    ++ int_to_string(cached_count(program, decided))
    ++ " cached"
    ++ (match by_code_count(program, decided) {
      0 -> "",
      n -> ", " ++ int_to_string(n) ++ " by code",
    })
    ++ ")"

fn group_line(decided: Decided, workers: Int) -> List<String> / {abort.raise} =
  if len(decided.classes) == 0 { [] } else {
    [indent() ++ count_of(len(decided.classes), "group") ++ " · " ++ count_of(workers, "worker")]
  }

fn isolated_line(style: Style, c: Counts) -> List<String> / {abort.raise} =
  if c.total == 0 { [] } else {
    let contending = if c.shared == 0 { "" }
    else { dim(style, " · " ++ count_of(c.shared, "test") ++ " can contend") };
    [
      indent() ++ bold(style, "isolated") ++ " " ++ bold(style, int_to_string(c.isolated)) ++ " of "
        ++ int_to_string(c.total)
        ++ contending,
    ]
  }

fn binding_lines(style: Style, o: Opening, c: Counts) -> List<String> / {abort.raise} =
  if o.hermetic { [] } else {
    [
      indent() ++ bold(style, "host") ++ " " ++ bold(style, int_to_string(c.host)) ++ " of "
        ++ int_to_string(c.total)
        ++ " · "
        ++ dim(style, "cached by what each read"),
      indent()
        ++ dim(
          style,
          "binding host · " ++ count_of(o.operations, "operation") ++ " · " ++ o.digest,
        ),
    ]
  }

/// What the tests' connections came to, which only the run itself knows.
fn handshake_lines(style: Style, report: RunReport) -> List<String> / {abort.raise} =
  if report.hermetic { [] }
  else { map(report.handshakes, |line: String| indent() ++ dim(style, line)) }

/// `simulated: 3 of 47 · 61 interleavings · 3 exhaustive`.
fn simulation_line(style: Style, report: RunReport) -> List<String> / {abort.raise} =
  if report.simulation.simulated == 0 { [] } else {
    let c = report.simulation;
    let head = "simulated: " ++ int_to_string(c.simulated) ++ " of " ++ int_to_string(c.total)
      ++ " · "
      ++ count_of(c.interleavings, "interleaving");
    let thorough = if c.exhaustive == 0 { head }
    else { head ++ " · " ++ int_to_string(c.exhaustive) ++ " exhaustive" };
    let spent = if c.exhausted == 0 { thorough }
    else { thorough ++ " · " ++ int_to_string(c.exhausted) ++ " budget spent, not cached" };
    [indent() ++ bold(style, spent)]
  }

/// Apart from the entry counts: analysis is paid once, code generation per worker.
fn compiled_line(style: Style, b: Backend) -> List<String> / {abort.raise} =
  match b.units {
    None -> [],
    Some(units) ->
      [
        indent()
          ++ dim(
            style,
            "compiled " ++ int_to_string(units) ++ " unit(s) in "
              ++ ns_as_ms_tenths(match b.codegen_nanos { Some(n) -> n, None -> 0 })
              ++ "ms, after "
              ++ ns_as_ms_tenths(match b.analysis_nanos { Some(n) -> n, None -> 0 })
              ++ "ms deciding what to compile",
          ),
      ],
  }

fn backend_lines(style: Style, report: RunReport) -> List<String> / {abort.raise} =
  match report.backend {
    None -> [],
    Some(b) ->
      concat(
        [
          indent() ++ bold(style, "backend") ++ " " ++ bold(style, b.name) ++ " · "
            ++ int_to_string(b.entered)
            ++ " of "
            ++ int_to_string(b.offered)
            ++ " offers entered · "
            ++ int_to_string(b.declined)
            ++ " declined · "
            ++ int_to_string(b.fragment)
            ++ " in the fragment",
        ],
        compiled_line(style, b),
      ),
  }

fn bypass_lines(style: Style, flags: Flags) -> List<String> / {abort.raise} =
  if !flags.no_cache { [] }
  else { [indent() ++ dim(style, "--no-cache: results were neither read nor recorded")] }

fn filtered_lines(style: Style, program: Program) -> List<String> / {abort.raise} =
  if program.filtered_out == 0 { [] }
  else { [indent() ++ dim(style, "--filter hid " ++ count_of(program.filtered_out, "test"))] }

fn head_lines(
  style: Style,
  flags: Flags,
  program: Program,
  decided: Decided,
  o: Opening,
) -> List<String> / {abort.raise} = {
  let c = counts_of(program, o.reaches);
  concat(
    concat(
      concat(
        concat(
          concat([selected_line(style, program, decided)], group_line(decided, o.workers)),
          isolated_line(style, c),
        ),
        binding_lines(style, o, c),
      ),
      bypass_lines(style, flags),
    ),
    filtered_lines(style, program),
  )
}

/// The report as far as it goes before a test runs: the head, what `--explain` can say of the
/// selection, and the blank line the results follow.
fn opening_lines(
  style: Style,
  flags: Flags,
  program: Program,
  decided: Decided,
  o: Opening,
) -> List<String> / {abort.raise} =
  concat(
    concat(head_lines(style, flags, program, decided, o), if flags.explain {
      explain_lines(style, program, o.reaches, decided)
    } else { [] }),
    if len(decided.classes) == 0 { [] } else { [""] },
  )

/// What the run itself came to, under its results: the connections, the backend and the search.
fn run_lines(style: Style, report: RunReport) -> List<String> / {abort.raise} =
  concat(
    concat(handshake_lines(style, report), backend_lines(style, report)),
    simulation_line(style, report),
  )

// --- Where the time went ----------------------------------------------------

type Phase = { label: String, us: Int }

/// Longest first, so what dominated a run is read first, and ties stay in the order measured.
fn ordered(rows: List<Phase>) -> List<Phase> =
  fold(rows, [], |acc: List<Phase>, p: Phase|
    concat(push(filter(acc, |q: Phase| q.us >= p.us), p), filter(acc, |q: Phase| q.us < p.us)))

fn phase_rows(phases: Phases) -> List<Phase> =
  ordered([
    { label: "read", us: phases.read_us },
    { label: "front", us: phases.front_us },
    { label: "write back", us: phases.write_back_us },
  ])

fn phase_total(phases: Phases) -> Int = phases.read_us + phases.front_us + phases.write_back_us

fn phase_line(style: Style, phase: Phase, total: Int) -> String / {abort.raise} =
  indent() ++ "  " ++ pad_right(phase.label, 11, " ") ++ " "
    ++ pad_left(ms_hundredths(phase.us), 8, " ")
    ++ "ms "
    ++ dim(style, share(phase.us, total))

fn phase_lines(style: Style, phases: Phases) -> List<String> / {abort.raise} = {
  let total = phase_total(phases);
  concat(
    concat(
      ["", indent() ++ bold(style, "front-end time")],
      map(phase_rows(phases), |phase: Phase| phase_line(style, phase, total)),
    ),
    [
      indent() ++ "  " ++ pad_right("total", 11, " ") ++ " "
        ++ pad_left(ms_hundredths(total), 8, " ")
        ++ "ms",
    ],
  )
}

fn run_rows(phases: Phases, x: Spent) -> List<Phase> =
  [
    { label: "before", us: x.before_us },
    { label: "load", us: phase_total(phases) },
    { label: "promises", us: x.promises_us },
    { label: "store", us: x.store_us },
    { label: "selection", us: x.selection_us },
    { label: "handoff", us: x.handoff_us },
    { label: "unit", us: x.unit_us },
    { label: "bind", us: x.bind_us },
    { label: "tests", us: x.tests_us },
    { label: "conclude", us: x.conclude_us },
  ]

fn run_total(phases: Phases, x: Spent) -> Int =
  fold(run_rows(phases, x), 0, |n: Int, phase: Phase| n + phase.us)

fn run_phase_lines(style: Style, phases: Phases, x: Spent) -> List<String> / {abort.raise} = {
  let total = run_total(phases, x);
  concat(
    concat(
      ["", indent() ++ bold(style, "run time")],
      map(ordered(run_rows(phases, x)), |phase: Phase| phase_line(style, phase, total)),
    ),
    [
      indent() ++ "  " ++ pad_right("total", 11, " ") ++ " "
        ++ pad_left(ms_hundredths(total), 8, " ")
        ++ "ms",
    ],
  )
}

fn run_phases_json(phases: Phases, x: Spent) -> Json / {abort.raise} =
  object(
    push(map(run_rows(phases, x), |phase: Phase| { key: phase.label, value: millis(phase.us) }), {
      key: "total",
      value: millis(run_total(phases, x)),
    }),
  )

// --- `--explain` ------------------------------------------------------------

fn explain_atoms(iso: String, case: Case) -> String =
  if iso == "region" { "" } else if contends_only_over_regions(atoms_of(case)) {
    " " ++ shared_of(case) ++ " (region labels)"
  } else { " " ++ shared_of(case) }

fn case_line(
  style: Style,
  program: Program,
  reaches: List<Int>,
  case: Case,
  decided: Decided,
) -> String / {abort.raise} = {
  let iso = isolated_as(reaches, case);
  let reason = word(reason_of(decided, case.index));
  let verb = if runs_test(decided, case.index) { bold(style, "run ") } else { dim(style, "skip") };
  indent() ++ verb ++ " " ++ dim(style, short_of(case.hash)) ++ " " ++ pad_right(reason, 16, " ")
    ++ " "
    ++ pad_right(display_of(program, case), 40, " ")
    ++ " "
    ++ dim(
      style,
      "isolation: " ++ iso ++ explain_atoms(iso, case)
        ++ (if case.seeded { " · searched" } else { "" })
        ++ (match moved_of(decided, case.index) {
          Some(what) -> " · moved: " ++ what,
          None -> "",
        }),
    )
}

/// What a pass is filed under.
fn key_lines(style: Style, program: Program) -> List<String> / {abort.raise} = {
  let filed = match program.filed_under {
    Some(stamp) ->
      "a pass is filed under its test's hash and the runtime stamp " ++ short_of(Some(stamp))
        ++ ", and under the code the test ran, with what its run read",
    None -> "no pass is filed: `--no-cache` reads and writes none",
  };
  ["", indent() ++ dim(style, "key"), indent() ++ "  " ++ dim(style, filed)]
}

fn reasons_seen(program: Program, decided: Decided) -> List<String> =
  fold(program.cases, [], |acc: List<String>, case: Case| {
    let reason = word(reason_of(decided, case.index));
    if contains(acc, reason) { acc } else { push(acc, reason) }
  })

fn why_lines(style: Style, program: Program, decided: Decided) -> List<String> / {abort.raise} = {
  let seen = reasons_seen(program, decided);
  if len(seen) == 0 { [] } else {
    concat(
      ["", indent() ++ dim(style, "why")],
      map(seen, |reason: String|
        indent() ++ "  " ++ pad_right(reason, 16, " ") ++ " " ++ dim(style, why(reason))),
    )
  }
}

fn owed_line(
  style: Style,
  program: Program,
  case: Case,
  decided: Decided,
) -> List<String> / {abort.raise} =
  if owed_of(decided, case.index) == len(decided.search.roots) { [] } else {
    [
      indent() ++ "  "
        ++ dim(
          style,
          display_of(program, case) ++ ": " ++ int_to_string(owed_of(decided, case.index)) ++ " of "
            ++ count_of(len(decided.search.roots), "seed")
            ++ " still owed; the rest already passed on their own",
        ),
    ]
  }

/// What the seeded tests will search, and what each of them still owes.
fn search_lines(style: Style, program: Program, decided: Decided) -> List<String> / {abort.raise} = {
  let seeded = filter(program.cases, |case: Case| case.seeded);
  if len(seeded) == 0 { [] } else {
    let head = [
      "",
      indent() ++ dim(style, "search"),
      indent() ++ "  "
        ++ dim(
          style,
          decided.search.mode ++ " · " ++ count_of(len(decided.search.roots), "seed")
            ++ " · budget "
            ++ int_to_string(decided.search.budget)
            ++ " · steps "
            ++ int_to_string(decided.search.steps),
        ),
      indent() ++ "  "
        ++ dim(
          style,
          int_to_string(len(seeded)) ++ " of " ++ count_of(len(program.cases), "test")
            ++ " keyed on this plan and never on their bare hash",
        ),
    ];
    fold(seeded, head, |acc: List<String>, case: Case|
      concat(acc, owed_line(style, program, case, decided)))
  }
}

/// Grouped like any other test, but a host-backed test is never free.
fn group_tally(style: Style, c: Counts, decided: Decided) -> String / {abort.raise} = {
  let hosted = if c.host == 0 { "" }
  else { " · " ++ int_to_string(c.host) ++ " host-backed and never free" };
  let regioned = if decided.parallelism.region_contended == 0 { "" } else {
    " · " ++ int_to_string(decided.parallelism.region_contended)
      ++ " of them only over a region label"
  };
  indent() ++ "  "
    ++ dim(
      style,
      int_to_string(c.isolated) ++ " of " ++ int_to_string(c.total)
        ++ " region-isolated and free · "
        ++ count_of(decided.parallelism.shared_groups, "group")
        ++ " for the "
        ++ int_to_string(c.shared)
        ++ " shared "
        ++ plural(c.shared, "test")
        ++ regioned
        ++ hosted,
    )
}

fn named_of(program: Program, index: Int) -> String =
  match case_of(program, index) { Some(case) -> display_of(program, case), None -> "" }

fn group_block(
  style: Style,
  program: Program,
  decided: Decided,
  lines: List<String>,
  i: Int,
) -> List<String> / {abort.raise} = {
  let g: Group = at_or(decided.classes, i, no_group());
  let head = push(
    lines,
    indent() ++ "  group " ++ int_to_string(i) ++ " · " ++ count_of(len(g.tests), "test") ++ " · "
      ++ dim(style, g.footprint),
  );
  fold(g.tests, head, |acc: List<String>, index: Int| {
    let named = named_of(program, index);
    if named == "" { acc } else { push(acc, indent() ++ "    " ++ named) }
  })
}

fn concurrency_lines(
  style: Style,
  program: Program,
  c: Counts,
  decided: Decided,
) -> List<String> / {abort.raise} =
  if len(decided.classes) == 0 { [] } else {
    fold(
      range(0, len(decided.classes)),
      ["", indent() ++ dim(style, "concurrency groups"), group_tally(style, c, decided)],
      |acc: List<String>, i: Int| group_block(style, program, decided, acc, i),
    )
  }

fn explain_lines(
  style: Style,
  program: Program,
  reaches: List<Int>,
  dec: Decided,
) -> List<String> / {abort.raise} =
  concat(
    concat(
      concat(
        concat(
          concat(
            [""],
            map(program.cases, |case: Case| case_line(style, program, reaches, case, dec)),
          ),
          concat(why_lines(style, program, dec), key_lines(style, program)),
        ),
        search_lines(style, program, dec),
      ),
      concurrency_lines(style, program, counts_of(program, reaches), dec),
    ),
    phase_lines(style, program.phases),
  )

// --- One test's line --------------------------------------------------------

fn glyph_of(status: String) -> String =
  if status == "passed" { "✓" }
  else if status == "failed" { "✗" }
  else if status == "panicked" { "!" }
  else { "–" }

fn word_of(status: String) -> String =
  if status == "passed" { "ok" }
  else if status == "failed" { "FAIL" }
  else if status == "panicked" { "PANIC" }
  else { "GAVE UP" }

fn painted_glyph(style: Style, status: String) -> String / {abort.raise} = {
  let glyph = glyph_of(status);
  if status == "passed" { green(style, glyph) }
  else if status == "failed" { red(style, glyph) }
  else if status == "panicked" { yellow(style, glyph) }
  else { dim(style, glyph) }
}

/// A styled mark is one glyph wide whatever escapes it carries, so the column is measured over the
/// word rather than over the paint.
fn marked(style: Style, status: String) -> String / {abort.raise} =
  if styles(style) { painted_glyph(style, status) } else { pad_right(word_of(status), 7, " ") }

fn result_name(program: Program, outcome: Outcome) -> String =
  match case_of(program, outcome.index) {
    Some(case) -> display_of(program, case),
    None -> outcome.name,
  }

/// Over the tests the run will run, since their lines are printed as their groups finish.
fn name_column(program: Program, decided: Decided) -> Int = {
  let widest = fold(decided.classes, 0, |acc: Int, g: Group|
    fold(g.tests, acc, |most: Int, index: Int| {
      let n = string_len(named_of(program, index));
      if n > most { n } else { most }
    }));
  if widest < 24 { 24 } else if widest > 64 { 64 } else { widest }
}

fn result_line(
  style: Style,
  program: Program,
  outcome: Outcome,
  width: Int,
) -> String / {abort.raise} =
  indent() ++ marked(style, outcome.status) ++ " "
    ++ pad_right(result_name(program, outcome), width, " ")
    ++ " "
    ++ pad_left(ms_tenths(outcome.duration_us), 8, " ")
    ++ "ms"

/// A bounded naive count makes the ratio a lower bound.
fn reduction_part(e: Explored, naive: Cost) -> List<String> / {abort.raise} =
  match e.reduction_tenths {
    None -> [],
    Some(tenths) ->
      [
        (if naive.bounded { ">= " } else { "" }) ++ fixed_point((tenths + 5) / 10, 0)
          ++ "× reduction",
      ],
  }

/// What one test's search did, under its result line.
fn search_parts(e: Explored) -> List<String> / {abort.raise} = {
  let head = [count_of(e.explored, "interleaving")];
  let thorough = if e.exhaustive { push(head, "exhaustive") } else { head };
  let spent = if e.exhausted { push(thorough, "budget spent — not cached") } else { thorough };
  let blind = match e.blind { None -> spent, Some(b) -> push(spent, "blind " ++ b.rendered) };
  match e.naive {
    None -> blind,
    Some(naive) -> concat(push(blind, "naive " ++ naive.rendered), reduction_part(e, naive)),
  }
}

fn result_lines(
  style: Style,
  program: Program,
  outcomes: List<Outcome>,
  width: Int,
) -> List<String> / {abort.raise} =
  fold(outcomes, [], |acc: List<String>, outcome: Outcome| {
    let listed = push(acc, result_line(style, program, outcome, width));
    match outcome.search {
      None -> listed,
      Some(e) -> push(listed, indent() ++ "    " ++ dim(style, join(search_parts(e), " · "))),
    }
  })

// --- The summary ------------------------------------------------------------

/// `host` sits beside `cached`: a host-backed pass stands only while what it read does.
fn summary_line(style: Style, report: RunReport, counted: Counts) -> String / {abort.raise} = {
  let c = report.summary;
  let failures = int_to_string(c.failed) ++ " failed";
  let passes = int_to_string(c.passed) ++ " passed";
  let hosted = if counted.host == 0 { "" }
  else { dim(style, ", " ++ int_to_string(counted.host) ++ " host-backed") };
  let given_up = if c.abandoned == 0 { "" }
  else { yellow(style, ", " ++ int_to_string(c.abandoned) ++ " abandoned") };
  indent() ++ (if c.failed > 0 { red(style, failures) } else { dim(style, failures) }) ++ ", "
    ++ (if c.passed > 0 { green(style, passes) } else { dim(style, passes) })
    ++ ", "
    ++ int_to_string(c.cached)
    ++ " cached"
    ++ hosted
    ++ given_up
    ++ " ("
    ++ secs_hundredths(c.duration_us)
    ++ "s)"
}

// --- One failure ------------------------------------------------------------

fn culprit_line(
  style: Style,
  places: List<Place>,
  c: Culprit,
  first: Bool,
) -> String / {abort.raise} =
  "  " ++ red(style, if first { "culprit:" } else { "        " }) ++ " " ++ join(c.names, " + ")
    ++ dim_place(style, places, c.at)

/// The culprit before the diff: the culprit is the answer.
fn bisect_lines(style: Style, places: List<Place>, b: Bisect) -> List<String> / {abort.raise} =
  if b.conclusive {
    push(
      fold(range(0, len(b.culprits)), [], |acc: List<String>, i: Int|
        push(acc, culprit_line(style, places, at_or(b.culprits, i, no_culprit()), i == 0))),
      "    " ++ dim(style, b.reason),
    )
  }
  // Silent when no bisection was asked for.
  else if !b.requested { [] }
  else { ["  " ++ dim(style, "no culprit:") ++ " " ++ b.reason] }

fn note_lines(style: Style, diag: Diag) -> List<String> / {abort.raise} =
  map(diag.notes_text, |n: Bytes| "  " ++ dim(style, "=") ++ " " ++ string_of_bytes_lossy(n))

/// A deadlock's cycle lives only in its secondary labels.
fn secondary_lines(style: Style, places: List<Place>, diag: Diag) -> List<String> / {abort.raise} =
  map(filter(diag.labels, |label: Label| !label.primary), |label: Label|
    "    " ++ string_of_bytes_lossy(label.text) ++ dim_place(style, places, Some(label_at(label))))

fn at_lines(style: Style, places: List<Place>, diag: Diag) -> List<String> / {abort.raise} =
  match primary_of(diag) {
    None -> [],
    Some(l) -> match located(places, label_at(l)) {
      None -> [],
      Some(text) -> ["    at " ++ dim(style, text)],
    },
  }

fn site_line(style: Style, places: List<Place>, site: Site, first: Bool) -> String / {abort.raise} =
  "  " ++ yellow(style, if first { "race:" } else { "     " }) ++ " " ++ site.task ++ "  "
    ++ (match site.definition { Some(d) -> d, None -> "-" })
    ++ "   "
    ++ site.access
    ++ dim_place(style, places, site.at)

fn race_lines(style: Style, places: List<Place>, fault: Fault) -> List<String> / {abort.raise} =
  match fault.race {
    None -> [],
    Some(race) ->
      [site_line(style, places, race.left, true), site_line(style, places, race.right, false)],
  }

fn replay_lines(style: Style, fault: Fault) -> List<String> / {abort.raise} =
  match fault.replay {
    None -> [],
    Some(command) -> ["  " ++ dim(style, "replay:") ++ " " ++ command],
  }

/// The repro, which is a seed rather than a stack trace.
fn seed_lines(style: Style, places: List<Place>, fault: Fault) -> List<String> / {abort.raise} =
  match fault.seed {
    None -> [],
    Some(seed) ->
      concat(
        concat(["  " ++ dim(style, "seed:") ++ " " ++ seed], race_lines(style, places, fault)),
        replay_lines(style, fault),
      ),
  }

fn described(x: Suspect) -> String =
  match x.change { Some(c) -> x.name ++ " (" ++ kind_word(c) ++ ")", None -> x.name }

fn suspect_lines(style: Style, fault: Fault) -> List<String> / {abort.raise} = {
  let rest = map(filter(fault.suspects, |x: Suspect| !x.culprit), described);
  if len(rest) > 0 { ["  " ++ yellow(style, "suspects:") ++ " " ++ join(rest, ", ")] }
  else if fault.unchanged {
    ["  " ++ dim(style, "suspects: none — nothing in this test's closure changed")]
  } else { [] }
}

fn failure_lines(style: Style, places: List<Place>, fault: Fault) -> List<String> / {abort.raise} =
  concat(
    concat(
      concat(
        concat(
          concat(
            concat(concat([bold(style, fault.key)], bisect_lines(style, places, fault.bisect)), [
              "  " ++ string_of_bytes_lossy(fault.diagnostic.message),
            ]),
            at_lines(style, places, fault.diagnostic),
          ),
          secondary_lines(style, places, fault.diagnostic),
        ),
        note_lines(style, fault.diagnostic),
      ),
      seed_lines(style, places, fault),
    ),
    suspect_lines(style, fault),
  )

fn failure_blocks(
  style: Style,
  program: Program,
  faults: List<Fault>,
) -> List<String> / {abort.raise} =
  fold(faults, [], |acc: List<String>, fault: Fault|
    concat(
      push(acc, ""),
      map(failure_lines(style, program.places, fault), |l: String| indent() ++ l),
    ))

/// A test the clock stopped: no culprit, no suspects, nothing to bisect — the machine ran out of
/// patience, and what the test would have decided is still unknown.
fn abandoned_lines(
  style: Style,
  places: List<Place>,
  outcome: Outcome,
) -> List<String> / {abort.raise} = {
  let head = [bold(style, outcome.name) ++ " " ++ yellow(style, "abandoned")];
  match outcome.diagnostic {
    None -> head,
    Some(r) -> {
      let d = shown(r);
      concat(
        concat(push(head, "  " ++ string_of_bytes_lossy(d.message)), at_lines(style, places, d)),
        note_lines(style, d),
      )
    },
  }
}

fn abandoned_blocks(
  style: Style,
  program: Program,
  report: RunReport,
) -> List<String> / {abort.raise} =
  fold(
    filter(report.results, |outcome: Outcome| outcome.status == "abandoned"),
    [],
    |acc: List<String>, outcome: Outcome|
      concat(
        push(acc, ""),
        map(abandoned_lines(style, program.places, outcome), |l: String| indent() ++ l),
      ),
  )

// --- Coverage and mutants ---------------------------------------------------

fn unreached_lines(style: Style, names: List<String>) -> List<String> / {abort.raise} =
  map(names, |n: String| indent() ++ indent() ++ dim(style, n ++ ": no test reaches it"))

fn coverage_lines(style: Style, report: RunReport) -> List<String> / {abort.raise} =
  match report.coverage {
    None -> [],
    Some(c) ->
      concat(
        [
          indent() ++ bold(style, "coverage") ++ " "
            ++ int_to_string(c.definitions - len(c.unreached))
            ++ " of "
            ++ int_to_string(c.definitions)
            ++ " definitions reached by a test",
        ],
        unreached_lines(style, c.unreached),
      ),
  }

fn survivor_line(style: Style, places: List<Place>, m: Survivor) -> String / {abort.raise} = {
  let spot = match m.at {
    None -> "",
    Some(a) -> match located(places, a) { Some(text) -> text, None -> "" },
  };
  indent() ++ indent() ++ red(style, m.definition) ++ " survives `" ++ m.from ++ "` -> `" ++ m.to
    ++ "` at "
    ++ dim(style, spot)
}

fn mutant_lines(style: Style, program: Program, report: RunReport) -> List<String> / {abort.raise} =
  match report.mutants {
    None -> [],
    Some(m) -> {
      let tally = int_to_string(m.killed) ++ " killed, " ++ int_to_string(m.survived)
        ++ " survived, "
        ++ int_to_string(m.skipped)
        ++ " skipped"
        ++ (if m.budget_spent { ", budget spent" } else { "" });
      concat(
        concat(
          [indent() ++ bold(style, "mutants") ++ " " ++ bold(style, tally)],
          unreached_lines(style, m.unreached),
        ),
        map(m.survivors, |x: Survivor| survivor_line(style, program.places, x)),
      )
    },
  }

fn no_tests_note(flags: Flags, program: Program) -> String =
  if program.declared == 0 { "no `test` items in this program" } else if len(flags.filters) > 0 {
    "no test key contains a `--filter` substring; nothing was verified"
  } else { "nothing to report" }

// --- The document -----------------------------------------------------------

/// A case of a test over cases says so: the test it is a case of, and its place and identity there.
fn case_of_json(case: Case) -> List<Member> / {abort.raise} =
  match case.entry.case {
    None -> [],
    Some(c) ->
      [
        {
          key: "case",
          value: object([
            { key: "at", value: int(c.at) },
            { key: "identity", value: Str(hex_of(c.identity)) },
            { key: "of", value: Str(case.entry.of) },
          ]),
        },
      ],
  }

fn case_json(report: RunReport, case: Case, decided: Decided) -> Json / {abort.raise} =
  object(
    concat(case_of_json(case), [
      { key: "index", value: int(case.index) },
      { key: "key", value: Str(case.key) },
      { key: "name", value: Str(case.name) },
      { key: "module", value: Str(case.module) },
      { key: "hash", value: string_or_null(case.hash) },
      { key: "nondet", value: Bool(case.nondet) },
      { key: "selected", value: Bool(runs_test(decided, case.index)) },
      { key: "reason", value: Str(keyed(word(reason_of(decided, case.index)))) },
      { key: "why", value: Str(why(word(reason_of(decided, case.index)))) },
      { key: "moved", value: string_or_null(moved_of(decided, case.index)) },
      { key: "group", value: int_or_null(group_of(decided, case.index)) },
      { key: "footprint", value: Str(case.footprint) },
      { key: "isolation", value: Str(isolated_as(report.reaches, case)) },
      // Whether this test reaches the binding.
      { key: "host", value: Bool(covers(report.reaches, case.index)) },
      { key: "shared_atoms", value: strings(shared_texts(case)) },
      // The same atoms unprinted, as the scheduler compares them, and whether the test is handed a
      // seed: what a program re-colouring the run needs, without parsing a printed atom.
      { key: "contends", value: Array(map(shared(atoms_of(case)), atom_json)) },
      { key: "seeded", value: Bool(case.seeded) },
      // Footprint atoms this binary answers from what it ships, which no pass key covers.
    ]),
  )

fn atom_json(a: Atom) -> Json =
  object([
    { key: "effect", value: Str(a.effect) },
    { key: "resource", value: Str(a.resource) },
    { key: "writes", value: Bool(a.writes) },
  ])

fn group_json(decided: Decided, i: Int) -> Json = {
  let g: Group = at_or(decided.classes, i, no_group());
  object([
    { key: "index", value: int(i) },
    { key: "tests", value: Array(map(g.tests, |x: Int| int(x))) },
    { key: "footprint", value: Str(g.footprint) },
  ])
}

fn cost_json(v: Option<Cost>) -> Json =
  match v {
    None -> Null,
    Some(c) ->
      object([
        { key: "explored", value: int(c.explored) },
        { key: "bounded", value: Bool(c.bounded) },
        { key: "rendered", value: Str(c.rendered) },
      ]),
  }

fn search_json(e: Explored) -> Json / {abort.raise} =
  object([
    { key: "explored", value: int(e.explored) },
    { key: "exhaustive", value: Bool(e.exhaustive) },
    { key: "exhausted", value: Bool(e.exhausted) },
    { key: "blind", value: cost_json(e.blind) },
    { key: "naive", value: cost_json(e.naive) },
    {
      key: "reduction",
      value: match e.reduction_tenths {
        Some(t) ->
          Number(option_unwrap_or(decimal_of_string(fixed_point(t, 1)), decimal_of_int(0))),
        None -> Null,
      },
    },
    { key: "steps", value: int(e.steps) },
    { key: "virtual_time_ns", value: int(e.virtual_time_ns) },
    { key: "failing_seed", value: string_or_null(e.failing_seed) },
  ])

fn case_of(program: Program, index: Int) -> Option<Case> =
  match map_get(program.positions, index) {
    Some(place) -> list_at(program.cases, place),
    None -> None,
  }

/// Where each case is among `cases`, by its index; the first of an index stands for it.
fn placed_cases(cases: List<Case>) -> Map<Int, Int> =
  fold(range(0, len(cases)), map_new(), |acc: Map<Int, Int>, place: Int|
    match list_at(cases, place) {
      Some(case) -> if map_contains(acc, case.index) { acc }
      else { map_insert(acc, case.index, place) },
      None -> acc,
    })

fn outcome_json(program: Program, outcome: Outcome, d: Decided) -> Json / {abort.raise} = {
  let named = case_of(program, outcome.index);
  object([
    { key: "index", value: int(outcome.index) },
    { key: "key", value: match named { Some(c) -> Str(c.key), None -> Null } },
    { key: "name", value: Str(match named { Some(c) -> c.name, None -> outcome.name }) },
    { key: "module", value: match named { Some(c) -> Str(c.module), None -> Null } },
    { key: "hash", value: string_or_null(outcome.hash) },
    { key: "group", value: int(match group_of(d, outcome.index) { Some(g) -> g, None -> 0 }) },
    { key: "status", value: Str(outcome.status) },
    { key: "duration_ms", value: millis(outcome.duration_us) },
    {
      key: "diagnostic",
      value: match outcome.diagnostic {
        Some(r) -> one_diagnostic(shown(r), program.places),
        None -> Null,
      },
    },
    // Absent, never zeroed, when no region was reached.
    { key: "simulation", value: match outcome.search { Some(e) -> search_json(e), None -> Null } },
    { key: "cached", value: opt_bool(outcome.cached) },
    { key: "performs", value: int(outcome.performs) },
  ])
}

/// A place as the artifact carries one: the source and the byte range.
fn span_json(a: Option<ModuleSpan>) -> Json =
  match a {
    None -> Null,
    Some(at) ->
      object([
        { key: "source", value: int(at.module) },
        { key: "start", value: int(at.start) },
        { key: "end", value: int(at.end) },
      ]),
  }

fn site_json(x: Site) -> Json =
  object([
    { key: "task", value: Str(x.task) },
    { key: "definition", value: string_or_null(x.definition) },
    { key: "access", value: Str(x.access) },
    { key: "span", value: span_json(x.at) },
  ])

fn race_json(v: Option<Race>) -> Json =
  match v {
    None -> Null,
    Some(race) ->
      object([
        { key: "at", value: int(race.step) },
        { key: "left", value: site_json(race.left) },
        { key: "right", value: site_json(race.right) },
      ]),
  }

/// The failure artifact: what failed and where, whether it is Ply's fault, how to replay it, and the
/// cause this program decided, led by the culprit.
fn fault_json(program: Program, fault: Fault) -> Json / {abort.raise} =
  object([
    { key: "key", value: Str(fault.key) },
    { key: "name", value: Str(fault.name) },
    { key: "diagnostic", value: one_diagnostic(fault.diagnostic, program.places) },
    // Whether to go and read the program or go and report a bug in Ply.
    { key: "defect", value: Bool(fault.defect) },
    { key: "seed", value: string_or_null(fault.seed) },
    { key: "replay", value: string_or_null(fault.replay) },
    // Only when the search actually observed the flip.
    { key: "race", value: race_json(fault.race) },
    { key: "culprit", value: culprit_json(fault.bisect) },
    { key: "suspects", value: Array(map(fault.suspects, suspect_json)) },
    { key: "module", value: string_or_null(fault.module) },
    { key: "test_hash", value: string_or_null(fault.test_hash) },
    { key: "nondet", value: opt_bool(fault.nondet) },
    { key: "status", value: string_or_null(fault.status) },
    { key: "location", value: location_json(program.places, fault.diagnostic) },
    {
      key: "footprint",
      value: object([{ key: "declared", value: strings_or_null(fault.declared) }]),
    },
  ])

/// The verdict as the document carries it: what to change, how sure the system is, and how it
/// found out. Built here rather than read from the runtime's copy of the row, because a program
/// that searched is the side that decided.
fn culprit_json(b: Bisect) -> Json =
  object([
    { key: "verdict", value: Str(b.verdict) },
    { key: "skipped", value: string_or_null(b.skipped) },
    { key: "confidence", value: Str(b.confidence) },
    { key: "definitions", value: Array(map(b.culprits, |c: Culprit| Str(at_or(c.names, 0, "")))) },
    {
      key: "groups",
      value: Array(map(b.groups, |g: List<String>| Array(map(g, |n: String| Str(n))))),
    },
    { key: "reason", value: Str(b.reason) },
    {
      key: "search",
      value: object([
        { key: "candidates", value: int(b.search.candidates) },
        { key: "clusters", value: int(b.search.clusters) },
        { key: "evaluated", value: int(b.search.evaluated) },
        { key: "cached", value: int(b.search.cached) },
        { key: "memoized", value: int(b.search.memoized) },
        { key: "unresolved", value: int(b.search.unresolved) },
        { key: "exhausted", value: Bool(b.search.exhausted) },
      ]),
    },
  ])

fn suspect_json(x: Suspect) -> Json =
  object([
    { key: "name", value: Str(x.name) },
    {
      key: "change",
      value: string_or_null(match x.change { Some(c) -> Some(kind_word(c)), None -> None }),
    },
    { key: "hash", value: string_or_null(x.hash) },
    { key: "before", value: string_or_null(x.before) },
    { key: "culprit", value: Bool(x.culprit) },
  ])

fn parallelism_json(v: Parallelism) -> Json =
  object([
    { key: "total", value: int(v.total) },
    { key: "isolated", value: int(v.isolated) },
    { key: "shared", value: int(v.shared) },
    { key: "region_contended", value: int(v.region_contended) },
    { key: "scheduled", value: int(v.scheduled) },
    { key: "groups", value: int(v.groups) },
    { key: "shared_groups", value: int(v.shared_groups) },
  ])

fn phases_json(phases: Phases) -> Json / {abort.raise} =
  object([
    { key: "read", value: millis(phases.read_us) },
    { key: "front", value: millis(phases.front_us) },
    { key: "write_back", value: millis(phases.write_back_us) },
    { key: "total", value: millis(phase_total(phases)) },
  ])

fn selection_json(program: Program, report: RunReport, decided: Decided) -> Json / {abort.raise} = {
  let c = counts_of(program, report.reaches);
  object([
    { key: "total", value: int(len(program.cases)) },
    { key: "selected", value: int(selected_count(program, decided)) },
    { key: "cached", value: int(cached_count(program, decided)) },
    { key: "by_code", value: int(by_code_count(program, decided)) },
    { key: "filtered_out", value: int(program.filtered_out) },
    { key: "filed_under", value: string_or_null(program.filed_under) },
    {
      key: "groups",
      value: Array(map(range(0, len(decided.classes)), |i: Int| group_json(decided, i))),
    },
    // A host-backed test counts only under `host`, since it is not isolated.
    { key: "isolated", value: int(c.isolated) },
    { key: "shared", value: int(c.shared) },
    { key: "host", value: int(c.host) },
    { key: "parallelism", value: parallelism_json(decided.parallelism) },
    {
      key: "tests",
      value: Array(map(program.cases, |case: Case| case_json(report, case, decided))),
    },
  ])
}

fn summary_json(c: Summary) -> Json / {abort.raise} =
  object([
    { key: "passed", value: int(c.passed) },
    { key: "failed", value: int(c.failed) },
    { key: "abandoned", value: int(c.abandoned) },
    { key: "cached", value: int(c.cached) },
    { key: "duration_ms", value: millis(c.duration_us) },
  ])

fn simulated_json(c: Simulated) -> Json =
  object([
    { key: "simulated", value: int(c.simulated) },
    { key: "seeds", value: int(c.seeds) },
    { key: "interleavings", value: int(c.interleavings) },
    { key: "exhaustive", value: int(c.exhaustive) },
    { key: "exhausted", value: int(c.exhausted) },
    { key: "failed", value: int(c.failed) },
  ])

fn backend_json(report: RunReport) -> Json =
  match report.backend {
    None -> Null,
    Some(b) ->
      object([
        { key: "name", value: Str(b.name) },
        { key: "fragment", value: int(b.fragment) },
        { key: "offered", value: int(b.offered) },
        { key: "analysis_nanos", value: int_or_null(b.analysis_nanos) },
        { key: "codegen_nanos", value: int_or_null(b.codegen_nanos) },
        { key: "units", value: int_or_null(b.units) },
        { key: "entered", value: int(b.entered) },
        { key: "declined", value: int(b.declined) },
        { key: "converted_in", value: int(b.converted_in) },
        { key: "converted_out", value: int(b.converted_out) },
      ]),
  }

/// The two documents `--coverage` and `--mutate` add, each written by the pass that measured it.
fn extra_documents(report: RunReport) -> List<Member> = {
  let covered = match report.coverage {
    None -> [],
    Some(c) -> [{ key: "coverage", value: c.json }],
  };
  match report.mutants {
    None -> covered,
    Some(m) -> push(covered, { key: "mutants", value: m.json }),
  }
}

/// Bumped whenever a field in the failure artifact changes meaning or leaves.
fn artifact_schema() -> Int = 6

fn document(
  flags: Flags,
  program: Program,
  report: RunReport,
  faults: List<Fault>,
  warnings: List<Diag>,
  ok: Bool,
  decided: Decided,
) -> Json / {abort.raise} =
  object(
    concat(
      [
        { key: "command", value: Str("test") },
        { key: "schema_version", value: int(artifact_schema()) },
        {
          key: "front_end",
          value: object([
            { key: "incremental", value: Bool(program.incremental) },
            { key: "phases", value: phases_json(program.phases) },
          ]),
        },
        { key: "phases", value: run_phases_json(program.phases, report.spent) },
        { key: "ok", value: Bool(ok) },
        { key: "exit_code", value: int(if ok { ok_code() } else { run_failed() }) },
        { key: "root", value: Str(program.root) },
        { key: "files", value: strings(program.files) },
        {
          key: "modules",
          value: Array(
            map(program.modules, |m: ModuleView|
              object([{ key: "name", value: Str(m.name) }, { key: "file", value: Str(m.file) }])),
          ),
        },
        { key: "filters", value: Array(map(flags.filters, |f: String| Str(f))) },
        { key: "no_cache", value: Bool(flags.no_cache) },
        { key: "binding", value: Str(report.label) },
        { key: "hosts", value: report.hosts },
        { key: "workers", value: int(report.workers) },
        { key: "options", value: with_sim(program.options, decided.sim) },
        { key: "simulation", value: simulated_json(report.simulation) },
        { key: "backend", value: backend_json(report) },
        { key: "selection", value: selection_json(program, report, decided) },
        { key: "summary", value: summary_json(report.summary) },
        {
          key: "results",
          value: Array(
            map(report.results, |outcome: Outcome| outcome_json(program, outcome, decided)),
          ),
        },
        { key: "failures", value: Array(map(faults, |f: Fault| fault_json(program, f))) },
        // Not a warning: every later run believes an escaped entry.
        { key: "diagnostics", value: all_to_json(report.escapes, program.places) },
        { key: "warnings", value: all_to_json(warnings, program.places) },
      ],
      extra_documents(report),
    ),
  )

// --- The answer -------------------------------------------------------------

/// A test failed, was abandoned, a pass escaped into the cache, or a mutant lived.
fn run_failed() -> Int = 1

fn survived(report: RunReport) -> Bool =
  match report.mutants { Some(m) -> m.survived > 0, None -> false }

fn green_run(report: RunReport) -> Bool =
  report.summary.failed == 0 && report.summary.abandoned == 0 && len(report.escapes) == 0
    && !survived(report)

fn printed(lines: List<String>) -> Unit / {process.out[proc]} =
  fold(lines, (), |_: Unit, line: String| process.out[proc](line))

fn nothing_lines(style: Style, flags: Flags, program: Program) -> List<String> / {abort.raise} =
  if len(program.cases) > 0 { [] }
  else { ["", indent() ++ dim(style, no_tests_note(flags, program))] }

/// The report after its results, which were printed as their groups finished.
fn closing_lines(
  style: Style,
  flags: Flags,
  program: Program,
  report: RunReport,
  faults: List<Fault>,
  warnings: List<Diag>,
) -> List<String> / {abort.raise} =
  fold(
    [
      if flags.explain { run_phase_lines(style, program.phases, report.spent) } else { [] },
      [""],
      run_lines(style, report),
      [summary_line(style, report, counts_of(program, report.reaches))],
      warned_lines(style, report.escapes),
      failure_blocks(style, program, faults),
      abandoned_blocks(style, program, report),
      nothing_lines(style, flags, program),
      warned_lines(style, warnings),
      coverage_lines(style, report),
      mutant_lines(style, program, report),
    ],
    [],
    |acc: List<String>, part: List<String>| concat(acc, part),
  )

/// A lazy read and a later flush can each report the same unreadable file.
fn collected(program: Program, report: RunReport) -> List<Diag> =
  fold(concat(program.warnings, report.warnings), [], |acc: List<Diag>, d: Diag|
    if len(filter(acc, |x: Diag| x.code == d.code && x.message == d.message)) > 0 { acc }
    else { push(acc, d) })

fn answered(
  style: Style,
  flags: Flags,
  program: Program,
  report: RunReport,
  faults: List<Fault>,
  decided: Decided,
) -> Answer / {abort.raise} = {
  let warnings = collected(program, report);
  let ok = green_run(report);
  {
    json: document(flags, program, report, faults, warnings, ok, decided),
    lines: closing_lines(style, flags, program, report, faults, warnings),
    errs: [],
    code: if ok { ok_code() } else { run_failed() },
  }
}

/// A registration that does not match the program is a start-up failure: nothing ran.
fn unbound(style: Style, refusal: Refusal) -> Answer / {abort.raise} = {
  let tally = indent() ++ red(style, "no host handler was bound") ++ " ("
    ++ count_of(len(refusal.diags), "error")
    ++ ")";
  {
    json: object([
      { key: "command", value: Str("test") },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: int(compile_error()) },
      { key: "binding", value: Str("host") },
      { key: "diagnostics", value: all_to_json(refusal.diags, refusal.places) },
    ]),
    lines: [],
    errs: push(all_to_text(style, refusal.diags, refusal.places), tally),
    code: compile_error(),
  }
}

// --- The load ---------------------------------------------------------------

/// One report, the load a watching run's next report may reuse, and what that load embedded, which
/// a watching run reads again whether or not the load held.
pub type Iteration = { answer: Answer, held: Option<Timed>, embeds: List<Embed> }

pub fn run(
  flags: Flags,
  options: Options,
  argv: Option<List<String>>,
) -> Answer / {process.out[proc], builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, tester.configure[corpus], tester.unit[corpus], tester.bound[corpus], tester.hosted[corpus], tester.ended[corpus], tester.cases[corpus], tester.executed[corpus], tester.interleaved[corpus], tester.moved[corpus], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.var[sys], env.pwd[sys], tester.schema[corpus], env.vars[sys], fs.resolved[cwd], fs.resolved[abs], emit.unit, priced.report, literal.verdicts, abort.raise, diverges, shipped.reached} =
  iterated(flags, options, None, argv).answer

/// A save that changed no file's text is the last report's load again, with nothing re-derived.
fn loaded(
  flags: Flags,
  options: Options,
  held: Option<Timed>,
  project: Project,
  started: Int,
) -> Timed / {builder.git[vcs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], fs.read_file[abs], entropy.next, time.now_ms, abort.raise, shipped.reached} = {
  let reused = match held {
    Some(t) -> if unmoved(project, t.program) { Some(t) } else { None },
    None -> None,
  };
  match reused {
    Some(t) -> { ..t, read_ms: 0, front_ms: 0, file_ms: 0 },
    None -> if options.no_cache {
      timed_uncached_over(flags.paths, project, started, flags.verify_deps, options.std)
    } else {
      timed_over(flags.paths, project, started, verify: flags.verify_deps, every: options.std)
    },
  }
}

/// One report over the tree as it is now; `held` is the load the last one ran against. `argv`, where
/// it is given, is the command line a run that ran nothing keeps its answer under for the next.
pub fn iterated(
  flags: Flags,
  options: Options,
  held: Option<Timed>,
  argv: Option<List<String>>,
) -> Iteration / {process.out[proc], builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, tester.configure[corpus], tester.unit[corpus], tester.bound[corpus], tester.hosted[corpus], tester.ended[corpus], tester.cases[corpus], tester.executed[corpus], tester.interleaved[corpus], tester.moved[corpus], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.var[sys], env.pwd[sys], tester.schema[corpus], env.vars[sys], fs.resolved[cwd], fs.resolved[abs], emit.unit, priced.report, literal.verdicts, abort.raise, diverges, shipped.reached} = {
  let s: Style = style_of(flags);
  let begun = time.elapsed_us();
  let started = time.elapsed_ms();
  let project = load_resolved(flags.paths);
  let keys = match argv {
    Some(line) -> if held == None && keeps_answer(options) {
      let program = answers::program();
      Some({
        key: answers::key_of(program, line, project),
        alone: map(alone_lines(line, flags.filters), |a: { filter: String, line: List<String> }|
          { filter: a.filter, key: answers::key_of(program, a.line, project) }),
      })
    } else { None },
    None -> None,
  };
  match match keys { Some(k) -> replayed(flags, options, k.key, project, begun), None -> None } {
    Some(answer) -> { answer: answer, held: None, embeds: project.embeds },
    None -> if flags.kept {
      let unanswered = match keys {
        Some(k) -> if len(k.alone) == 0 { flags.filters } else {
          map(
            filter(k.alone, |a: { filter: String, key: String }|
              replayed({ ..flags, json: true }, options, a.key, project, begun) == None),
            |a: { filter: String, key: String }| a.filter,
          )
        },
        None -> flags.filters,
      };
      {
        answer: unkept(flags, unanswered, match keys {
          Some(k) -> len(k.alone) > 0,
          None -> false,
        }),
        held: None,
        embeds: project.embeds,
      }
    } else {
      let t: Timed = loaded(flags, options, held, project, started);
      over_load(flags, options, s, t, begun, match keys {
        Some(k) -> if viewed_whole(t.program) {
          Some({
            key: k.key,
            views: viewed_text(t.program.viewed),
            passes: [],
            after: false,
            alone: k.alone,
          })
        } else { None },
        None -> None,
      })
    },
  }
}

/// What `--kept` answers where no kept answer of the whole run stands. A run of several `--filter`s
/// asked each what a run of it alone kept, and `unanswered` holds those nothing kept answers: exit 0
/// where every one was answered. Exit 4 otherwise, and nothing loaded or run.
fn unkept(flags: Flags, unanswered: List<String>, apart: Bool) -> Answer = {
  let code = if apart && len(unanswered) == 0 { ok_code() } else { unkept_code() };
  {
    json: object([
      { key: "command", value: Str("test") },
      { key: "ok", value: Bool(code == ok_code()) },
      { key: "exit_code", value: int(code) },
      { key: "kept", value: Bool(code == ok_code()) },
      { key: "unanswered", value: strings(unanswered) },
    ]),
    lines: [],
    errs: if flags.json || code == ok_code() { [] } else {
      [
        indent()
          ++ (if apart { "nothing kept answers these filters: " ++ join(unanswered, ", ") } else {
            "nothing kept answers this run: none was kept for this command line, or a pass or shipped definition it took moved"
          }),
      ]
    },
    code: code,
  }
}

fn unkept_code() -> Int = 4

/// Where a run keeps its answer for the next run over the same command (`answers`): the key, its
/// load's views of the shipped modules, and the keys of the passes it took. `after` is an answer
/// selected again after the run filed its passes, which the store's warnings on opening are not in.
/// `alone` is, for a run of several `--filter`s, each with the key a run of it alone keeps under.
type Keeping = {
  key: String,
  views: Bytes,
  passes: List<String>,
  after: Bool,
  alone: List<{ filter: String, key: String }>,
}

/// Each `--filter` of a run of several with the command line a run of it alone spells: every other
/// `--filter` and its value left out.
fn alone_lines(
  line: List<String>,
  filters: List<String>,
) -> List<{ filter: String, line: List<String> }> / {abort.raise} =
  if len(filters) < 2 { [] } else {
    map(filters, |f: String|
      {
        filter: f,
        line: fold(
          range(0, len(line)),
          { out: [], skip: false },
          |acc: { out: List<String>, skip: Bool }, i: Int|
            if acc.skip { { ..acc, skip: false } }
            else if at_or(line, i, "") == "--filter" && at_or(line, i + 1, "") != f {
              { ..acc, skip: true }
            } else { { ..acc, out: push(acc.out, at_or(line, i, "")) } },
        ).out,
      })
  }

/// The embeds the tests in `scope` reach, as a kept answer holds them: one asked for by a definition,
/// test or law the tests reach, and always one a dependency asks for, one an item that declares no
/// name asks for, and one no item of its module is found asking for.
fn reached_embeds(
  p: program::Program,
  analysis: Analysis,
  scope: Scope,
) -> List<answers::Embedding> / {abort.raise} = {
  let keys = fold(scope.visible, [], |acc: List<Bytes>, i: Int|
    match test_at(analysis, i) { Some(t) -> push(acc, t.key), None -> acc });
  let walked = reach(analysis.hashes, map(keys, |k: Bytes| TheItem(k)));
  let named = fold(keys, map_merge(walked.fns, walked.decls), |acc: Map<Bytes, Bool>, k: Bytes|
    map_insert(acc, k, true));
  let texts = fold(p.files, map_new(), |acc: Map<Bytes, Bytes>, f: File|
    map_insert(acc, bytes_of_string(f.module), f.text));
  let asking = fold(
    p.embeds,
    map_new(),
    |acc: Map<Bytes, List<{ name: Option<Bytes>, wants: List<EmbedWant> }>>, e: Embed|
      if e.embedded.root != p.pkgs.root || map_contains(acc, e.embedded.module) { acc } else {
        match map_get(texts, e.embedded.module) {
          None -> acc,
          Some(text) -> match parse_all([{ name: e.embedded.module, src: text }]) {
            [parsed, ..] -> map_insert(acc, e.embedded.module, wants_by_item(parsed.module.module)),
            [] -> acc,
          },
        }
      },
  );
  let reached = |e: Embedded|
    e.root != p.pkgs.root
      || (match map_get(asking, e.module) {
        None -> true,
        Some(items) -> {
          let wanting = filter(items, |item: { name: Option<Bytes>, wants: List<EmbedWant> }|
            fold(item.wants, false, |hit: Bool, w: EmbedWant|
              hit || (w.path == e.want.path && w.dir == e.want.dir)));
          len(wanting) == 0
            || fold(
              wanting,
              false,
              |hit: Bool, item: { name: Option<Bytes>, wants: List<EmbedWant> }|
                hit
                  || (match item.name {
                    None -> true,
                    Some(n) -> map_contains(named, qualify(e.module, n)),
                  }),
            )
        },
      });
  map(filter(p.embeds, |e: Embed| reached(e.embedded)), |e: Embed|
    answers::embedding_of(e.embedded))
}

/// A run whose answer the next may take: one that consults the store, answers once and as a plain
/// run does, and reads no configuration file the key does not cover.
fn keeps_answer(options: Options) -> Bool =
  !options.no_cache && !options.watch && !options.explain && !options.coverage
    && options.mutate == None
    && len(options.config.files) == 0
    && options.config.schema == None

/// Whether the load read each shipped module it pulled for what the program reaches, so its views
/// hold all the program takes of them: a load that cut gives a view of every module it pulled, and
/// one it read only for an embed is in the hash of what embeds it.
fn viewed_whole(p: program::Program) -> Bool =
  p.reached && (len(p.viewed) > 0 || len(p.shipping.read) == 0)

/// The keys of the passes that answer each test in scope.
fn answered_by(answering: List<List<String>>, scope: Scope) -> List<String> =
  fold(scope.visible, [], |acc: List<String>, i: Int|
    concat(acc, match list_at(answering, i) { Some(ks) -> ks, None -> [] }))

/// Every test in scope taken from a pass filed under its own key, or under each root's.
fn all_cached(decisions: List<Decision>, scope: Scope) -> Bool = {
  let visible = set_of(scope.visible);
  fold(decisions, true, |all: Bool, d: Decision|
    all && (!map_contains(visible, d.case.index) || d.reason == Cached))
}

fn unwarned(answer: Answer) -> Bool =
  match answer.json {
    Object(members) -> match map_get(members, "warnings") {
      Some(Array(ws)) -> len(ws) == 0,
      _ -> false,
    },
    _ -> false,
  }

/// The answer a run kept under `key`, where it answers this one: every pass it took still stands,
/// its load's views of the shipped modules still hold and each embed its tests reach in `project`
/// reads as it did. A text run prints what that one printed before its answer.
fn replayed(
  flags: Flags,
  options: Options,
  key: String,
  project: Project,
  begun: Int,
) -> Option<Answer> / {time.elapsed_us, process.out[proc], fs.list_dir[shipped], fs.read_file[shipped], tester.configure[corpus], tester.ended[corpus], tester.moved[corpus], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.var[sys], env.pwd[sys], abort.raise} = {
  tester.configure[corpus](options);
  let found = results::with_ledger(results::store_for(flags.paths, false), || {
    match list_at(ledger.passes([key]), 0) {
      Some(Some(bytes)) -> match answers::decoded(bytes) {
        None -> None,
        Some(k) -> if !answers::embeds_stand(k.embeds, project) { None } else {
          let viewed = views::split(k.views).viewed;
          let held = ledger.passes(k.passes);
          let now = views::now_for(push(views::viewed_in(traces_of(held)), viewed));
          let stands = views::moved(now, viewed) == None
            && fold(held, true, |all: Bool, h: Option<Bytes>|
              all && h != None && standing(now, h) == Some(Stands));
          if stands { Some(k) } else { None }
        },
      },
      _ -> None,
    }
  });
  tester.ended[corpus]();
  match found {
    None -> None,
    Some(k) -> match parse_string(k.json) {
      Err(_) -> None,
      Ok(json) -> {
        if !flags.json { printed(k.opening) };
        Some({
          json: match json {
            Object(members) ->
              Object(
                map_insert(
                  members,
                  "front_end",
                  object([
                    { key: "incremental", value: Bool(true) },
                    {
                      key: "phases",
                      value: phases_json({
                        read_us: time.elapsed_us() - begun,
                        front_us: 0,
                        write_back_us: 0,
                      }),
                    },
                    { key: "reused", value: Bool(true) },
                    { key: "key", value: Str(key) },
                  ]),
                ),
              ),
            other -> other,
          },
          lines: k.lines,
          errs: k.errs,
          code: k.code,
        })
      },
    },
  }
}

fn over_load(
  flags: Flags,
  options: Options,
  s: Style,
  t: Timed,
  begun: Int,
  keeping: Option<Keeping>,
) -> Iteration / {process.out[proc], builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, tester.configure[corpus], tester.unit[corpus], tester.bound[corpus], tester.hosted[corpus], tester.ended[corpus], tester.executed[corpus], tester.interleaved[corpus], tester.moved[corpus], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.var[sys], env.pwd[sys], tester.schema[corpus], env.vars[sys], fs.resolved[cwd], fs.resolved[abs], emit.unit, priced.report, abort.raise, shipped.reached, literal.verdicts, tester.cases[corpus]} =
  match t.program.whole {
    // Every diagnostic, as `check` refuses: an error is the whole answer, so the shipped-module
    // filter a successful load applies to warnings is not applied here.
    None ->
      {
        answer: refused(s, "test", load_diagnostics(t.program), t.program.places),
        held: None,
        embeds: t.program.embeds,
      },
    Some(w) -> match config_schema::refusal(w, options.config.schema) {
      Some(d) ->
        {
          answer: unbound(s, { diags: [d], places: t.program.places }),
          held: None,
          embeds: t.program.embeds,
        },
      None ->
        {
          answer: tests_over(flags, s, options, t, w, begun, keeping),
          held: Some(t),
          embeds: t.program.embeds,
        },
    },
  }

/// How the tree stamps now, one line per `.ply` file the paths name, or `None` when the walk could
/// not read what it was given: a walk that failed has seen nothing, and a watcher told the tree is
/// empty stops noticing saves to it.
pub fn stamped(
  rs: List<paths::Resolved>,
) -> Option<List<String>> / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], abort.raise} = {
  let found = walk::sweep(rs);
  if len(found.errors) > 0 { None } else {
    Some(
      map_fold(found.files, [], |acc: List<String>, shown: String, rooted: paths::Rooted|
        push(
          acc,
          shown ++ " " ++ stamp_part(paths::modified_ms(rooted)) ++ " "
            ++ stamp_part(paths::file_size(rooted)),
        )),
    )
  }
}

fn stamp_part(n: Option<Int>) -> String = match n { Some(x) -> int_to_string(x), None -> "-" }

/// The root a report names: the directory a path names, or the one holding the file it names.
fn root_of(rs: List<paths::Resolved>) -> String / {fs.kind[cwd], fs.kind[abs], abort.raise} =
  match list_at(rs, 0) {
    None -> ".",
    Some(r) -> match paths::kind(paths::rooted(r)) {
      File -> {
        let dir = parent(r.machine);
        if dir == "" { "." } else { dir }
      },
      _ -> r.machine,
    },
  }

// --- What the loaded tree tells a selector ------------------------------------

fn test_at(analysis: Analysis, i: Int) -> Option<TestInfo> = list_at(analysis.checked.tests, i)

fn hash_at(analysis: Analysis, i: Int) -> Option<String> / {abort.raise} =
  match list_at(analysis.hashes.tests, i) { Some(h) -> Some(hex_of(h)), None -> None }

/// Something in its closure entered a `simulate` region, so it reads a seed and is searched.
fn seeded_of(atoms: List<types::Atom>) -> Bool =
  fold(atoms, false, |found: Bool, a: types::Atom| found || a.effect == b"sim")

/// Each test of the run, as the selector keys it: one the tree declares, or one case of it.
fn rows_of(analysis: Analysis) -> List<Row> / {abort.raise} =
  fold(range(0, len(analysis.checked.tests)), [], |acc: List<Row>, i: Int|
    match test_at(analysis, i) {
      None -> acc,
      Some(t) ->
        push(acc, {
          index: i,
          label: string_of_bytes_lossy(t.name),
          name: string_of_bytes_lossy(t.key),
          module: string_of_bytes_lossy(t.module),
          hash: hash_at(analysis, i),
          seeded: seeded_of(t.footprint),
          nondet: t.nondet,
        }),
    })

/// The order the runtime holds a footprint's atoms in: by effect, then resource, a named one first
/// and every label last, then mode and operation.
fn resource_rank(r: types::Resource) -> Int =
  match r { RNamed(_) -> 0, RVar(_) -> 1, RSingleton -> 2, RAny -> 3 }

fn mode_rank(m: type_syntax::Mode) -> Int = match m { MRead -> 0, MWrite -> 1, _ -> 2 }

fn atom_before(a: types::Atom, b: types::Atom) -> Bool =
  if a.effect != b.effect { compare(a.effect, b.effect) == Less }
  else if resource_rank(a.resource) != resource_rank(b.resource) {
    resource_rank(a.resource) < resource_rank(b.resource)
  } else if a.resource != b.resource {
    match ((a.resource, b.resource)) {
      (RNamed(x), RNamed(y)) -> compare(x, y) == Less,
      (RVar(x), RVar(y)) -> x < y,
      _ -> false,
    }
  } else if mode_rank(a.mode) != mode_rank(b.mode) { mode_rank(a.mode) < mode_rank(b.mode) } else {
    match ((a.op, b.op)) {
      (None, Some(_)) -> true,
      (Some(x), Some(y)) -> compare(x, y) == Less,
      _ -> false,
    }
  }

/// The atoms ascending, each once.
fn canonical(atoms: List<types::Atom>) -> List<types::Atom> = {
  let sorted = sort_by(atoms, atom_before);
  fold(sorted, [], |acc: List<types::Atom>, a: types::Atom|
    match list_at(acc, len(acc) - 1) {
      Some(last) -> if last == a { acc } else { push(acc, a) },
      None -> push(acc, a),
    })
}

fn footprint_text(atoms: List<types::Atom>) -> String / {abort.raise} =
  "{" ++ join(atom_texts(atoms), ", ") ++ "}"

fn mode_writes(m: type_syntax::Mode) -> Bool = match m { MWrite -> true, _ -> false }

fn case_view(analysis: Analysis, i: Int, test_info: TestInfo) -> Case / {abort.raise} = {
  let atoms = canonical(test_info.footprint);
  let texts = atom_texts(atoms);
  {
    index: i,
    entry: entry_of(i, string_of_bytes_lossy(test_info.key)),
    key: string_of_bytes_lossy(test_info.key),
    name: string_of_bytes_lossy(test_info.name),
    module: string_of_bytes_lossy(test_info.module),
    nondet: test_info.nondet,
    hash: hash_at(analysis, i),
    footprint: footprint_text(atoms),
    atoms: map(range(0, len(atoms)), |j: Int|
      match list_at(atoms, j) {
        Some(a) ->
          {
            atom: {
              effect: string_of_bytes_lossy(a.effect),
              resource: string_of_bytes_lossy(types::resource_text(a.resource)),
              writes: mode_writes(a.mode),
            },
            text: at_or(texts, j, ""),
          },
        None -> { atom: { effect: "", resource: "", writes: false }, text: "" },
      }),
    seeded: seeded_of(test_info.footprint),
  }
}

/// Which tests a run reports on: the package being loaded — a dependency's tests are its own to run,
/// and a shipped module's are in scope only under `--std` — narrowed by `--filter` to the keys that
/// contain one of its substrings.
type Scope = { visible: List<Int>, out: List<Int>, filtered_out: Int }

fn root_modules(analysis: Analysis) -> Map<String, Bool> =
  fold(range(0, len(analysis.mods)), map_new(), |acc: Map<String, Bool>, i: Int|
    match ((list_at(analysis.mods, i), list_at(analysis.module_packages, i))) {
      (Some(m), Some(pkg)) -> if pkg == 0 { map_insert(acc, string_of_bytes_lossy(m.name), true) }
      else { acc },
      _ -> acc,
    })

fn scope_of(analysis: Analysis, options: Options) -> Scope = {
  let packaged = len(analysis.packages) > 0;
  let root = root_modules(analysis);
  let in_scope = |t: TestInfo|
    (if packaged { map_contains(root, string_of_bytes_lossy(t.module)) }
      else { !is_shipped(string_of_bytes_lossy(t.module)) })
      || (options.std && is_shipped(string_of_bytes_lossy(t.module)));
  let matches = |t: TestInfo| kept(options.filters, string_of_bytes_lossy(t.key));
  fold(
    range(0, len(analysis.checked.tests)),
    { visible: [], out: [], filtered_out: 0 },
    |acc: Scope, i: Int|
      match test_at(analysis, i) {
        None -> acc,
        Some(t) -> if !in_scope(t) { { ..acc, out: push(acc.out, i) } }
        else if matches(t) { { ..acc, visible: push(acc.visible, i) } }
        else { { ..acc, filtered_out: acc.filtered_out + 1 } },
      },
  )
}

/// A diagnostic raised inside a module that ships with `ply` is its maintainers', not this
/// program's.
fn in_shipped(analysis: Analysis, diag: Diag) -> Bool =
  match primary_of(diag) {
    None -> false,
    Some(l) -> match list_at(analysis.mods, l.module) {
      Some(m) -> is_shipped(string_of_bytes_lossy(m.name)),
      None -> false,
    },
  }

/// What the report says about the load, the tests in scope, and the options it ran under.
fn program_of(
  options: Options,
  timed: Timed,
  analysis: Analysis,
  entries: List<Entry>,
  root: String,
  scope: Scope,
  opened: List<Diag>,
  filed_under: Option<String>,
) -> Program / {abort.raise} = {
  let cases = fold(scope.visible, [], |acc: List<Case>, i: Int|
    match test_at(analysis, i) {
      Some(test_info) -> {
        let view = case_view(analysis, i, test_info);
        push(acc, { ..view, entry: at_or(entries, i, view.entry) })
      },
      None -> acc,
    });
  {
    root: root,
    filed_under: filed_under,
    files: map(timed.program.places, |place: Place| place.path),
    places: timed.program.places,
    modules: map(modules_of(timed.program, analysis), |m: { name: String, path: String }|
      { name: m.name, file: m.path }),
    incremental: timed.cached,
    phases: {
      read_us: timed.read_ms * 1000,
      front_us: timed.front_ms * 1000,
      write_back_us: timed.file_ms * 1000,
    },
    declared: len(scope.visible) + scope.filtered_out,
    cases: cases,
    positions: placed_cases(cases),
    filtered_out: scope.filtered_out,
    warnings: concat(
      opened,
      filter(load_diagnostics(timed.program), |diag: Diag| !in_shipped(analysis, diag)),
    ),
    options: object([
      {
        key: "bisect",
        value: Str(mode_word(match mode_parse(options.bisect) { Some(m) -> m, None -> Auto })),
      },
      { key: "bisect_budget", value: int(options.bisect_budget) },
    ]),
  }
}

// --- The run ----------------------------------------------------------------

/// A query naming nothing is wrong whatever the run does, and a `reuse fn` whose promise the cost
/// checker cannot show stops it as under `ply check`; both refuse before anything runs.
fn tests_over(
  flags: Flags,
  style: Style,
  options: Options,
  timed: Timed,
  analysis: Analysis,
  begun: Int,
  keeping: Option<Keeping>,
) -> Answer / {process.out[proc], builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_us, tester.configure[corpus], tester.unit[corpus], tester.bound[corpus], tester.hosted[corpus], tester.ended[corpus], tester.cases[corpus], tester.executed[corpus], tester.interleaved[corpus], tester.moved[corpus], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.var[sys], env.pwd[sys], tester.schema[corpus], env.vars[sys], fs.resolved[cwd], fs.resolved[abs], emit.unit, priced.report, literal.verdicts, abort.raise, shipped.reached} = {
  let aimed: Result<Option<List<DefInfo>>, Diag> = match options.mutate {
    Some(query) -> match targets(analysis, query) { Ok(defs) -> Ok(Some(defs)), Err(d) -> Err(d) },
    None -> Ok(None),
  };
  match aimed {
    Err(d) -> refused(style, "test", [d], timed.program.places),
    Ok(targeted) -> {
      let loaded_at = time.elapsed_us();
      let unkept = broken_promises(timed.program, analysis);
      let broken = if len(unkept) > 0 { unkept } else { unsettled(timed, analysis, options.path) };
      let promised_at = time.elapsed_us();
      let spent = { ..no_spent(), before_us: begun, promises_us: promised_at - loaded_at };
      if len(broken) > 0 { refused(style, "test", broken, timed.program.places) }
      else { selected(flags, style, options, timed, analysis, targeted, spent, keeping) }
    },
  }
}

fn selected(
  flags: Flags,
  style: Style,
  options: Options,
  timed: Timed,
  analysis: Analysis,
  targeted: Option<List<DefInfo>>,
  spent: Spent,
  keeping: Option<Keeping>,
) -> Answer / {process.out[proc], builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_us, tester.configure[corpus], tester.unit[corpus], tester.bound[corpus], tester.hosted[corpus], tester.ended[corpus], tester.cases[corpus], tester.executed[corpus], tester.interleaved[corpus], tester.moved[corpus], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.var[sys], env.pwd[sys], tester.schema[corpus], env.vars[sys], fs.resolved[cwd], fs.resolved[abs], emit.unit, abort.raise, shipped.reached} = {
  let configuring = time.elapsed_us();
  tester.configure[corpus](options);
  results::with_ledger(results::store_for(flags.paths, options.no_cache), || {
    let opened = if options.no_cache { [] } else { ledger.opened() };
    let handing = time.elapsed_us();
    let handed = front_of(timed, analysis);
    let listing = time.elapsed_us();
    // Which tests there are is the tables' to say, so each test over cases lists its own first.
    match listed(handed, over_cases(analysis, options)) {
      Err(diags) -> {
        tester.ended[corpus]();
        unbound(style, { diags: diags, places: timed.program.places })
      },
      Ok(found) ->
        decided_run(
          flags,
          style,
          options,
          timed,
          ranged(analysis, found.cases),
          handed,
          found.unit,
          opened,
          targeted,
          { ..spent, store_us: handing - configuring, handoff_us: listing - handing },
          listing,
          keeping,
        ),
    }
  })
}

/// The run over the tests as listing left them. `built` is the unit listing built and bound as
/// the first, when anything was listed: the run's tests then run in it. `listing` is when listing
/// began.
fn decided_run(
  flags: Flags,
  style: Style,
  options: Options,
  timed: Timed,
  over: Ranged,
  handed: LoadedAnalysis,
  built: Option<Emitted>,
  opened: List<Diag>,
  targeted: Option<List<DefInfo>>,
  spent: Spent,
  listing: Int,
  keeping: Option<Keeping>,
) -> Answer / {process.out[proc], builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.read_file[cwd], fs.read_file[abs], fs.resolved[cwd], fs.resolved[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_us, env.pwd[sys], env.vars[sys], tester.unit[corpus], tester.bound[corpus], tester.hosted[corpus], tester.ended[corpus], tester.executed[corpus], tester.interleaved[corpus], tester.moved[corpus], tester.schema[corpus], ledger.opened, ledger.passes, ledger.code_passes, ledger.seen, ledger.baselines, ledger.bodies, ledger.interfaces, ledger.filed, emit.unit, abort.raise, shipped.reached} = {
  let analysis = over.analysis;
  let selecting = time.elapsed_us();
  let scope = scope_of(analysis, options);
  let filed_under = if options.no_cache { None } else { Some(shipped_stamps().runtime) };
  let p = program_of(
    options,
    timed,
    analysis,
    over.entries,
    root_of(flags.paths),
    scope,
    opened,
    filed_under,
  );
  // Which tests run is the program's to say, and so is every key the store is asked about or a
  // pass is filed under: the runtime answers what the store holds and does what it is told.
  let searching = machine::sim_plan_of(options.sim);
  let search = search_of(searching);
  let asked = cases_of(rows_of(analysis), search, options.no_cache);
  let first = decide(asked.cases);
  let building = time.elapsed_us();
  // What a test runs is the unit's to say, so a run that would execute anything emits it before
  // deciding: a test nothing answered by its own key may be answered by its code.
  let emitted = match built {
    Some(e) -> Ok(Some(e)),
    None -> unit_for(handed, len(to_run(first)) > 0 || options.config.schema != None),
  };
  match emitted {
    Err(diags) -> {
      tester.ended[corpus]();
      unbound(style, { diags: diags, places: p.places })
    },
    Ok(unit) -> {
      let keyed = match unit {
        Some(e) -> if options.no_cache { map_new() }
        else { code_keys(first, codes_of(handed, e, over.entries), search) },
        None -> map_new(),
      };
      let answered = by_code(first, passed_by_code(first, keyed), search);
      let decisions = answered.decisions;
      // Which tests may share a worker is the program's to say, from the atoms each row carries.
      let visible = set_of(scope.visible);
      let classes = classes_of(p, filter(to_run(decisions), |i: Int| map_contains(visible, i)));
      let decided = decided_of(
        p,
        decisions,
        search,
        sim_json(searching, options.sim),
        map(classes, |class: List<Int>| group_of_class(analysis, class)),
        classes,
      );
      // A run that executes nothing builds no unit, unless a schema has constants to enter or a
      // table had cases to list.
      let build = len(decided.runs) > 0 || options.config.schema != None;
      let text = match unit { Some(e) -> if build { Some(e.text) } else { None }, None -> None };
      let bound_unit = match built {
        Some(_) -> Ok(0),
        None -> tester.unit[corpus](handed, text, true),
      };
      match bound_unit {
        Err(diags) -> {
          tester.ended[corpus]();
          unbound(style, { diags: diags, places: p.places })
        },
        Ok(_) -> {
          let binding = time.elapsed_us();
          match configuration::opened_by(options.host, options.config, |name: String|
              tester.schema[corpus](name)) {
            Err(diags) -> {
              tester.ended[corpus]();
              unbound(style, { diags: diags, places: p.places })
            },
            Ok(r) -> match tester.bound[corpus](configuration::configured(r.configuration)) {
              Err(diags) -> {
                tester.ended[corpus]();
                unbound(style, { diags: diags, places: p.places })
              },
              Ok(_) -> {
                let bound = time.elapsed_us();
                let answer = concluded_run(
                  flags,
                  style,
                  options,
                  p,
                  timed,
                  analysis,
                  over.judged,
                  scope,
                  decisions,
                  decided,
                  keyed,
                  {
                    refiled: answered.refiled,
                    // A `--json` answer is kept from selecting again, below.
                    kept: if flags.json { None } else {
                      match keeping {
                        Some(k) -> Some({ ..k, passes: answered_by(asked.answering, scope) }),
                        None -> None,
                      }
                    },
                  },
                  searching,
                  r.warnings,
                  targeted,
                  {
                    ..spent,
                    selection_us: building - selecting,
                    unit_us: selecting - listing + binding - building,
                    bind_us: bound - binding,
                  },
                );
                // A green run filed every pass it ran, so selecting again answers what the next run
                // would, which reads a cache this one wrote and says nothing of it: that answer is
                // the one kept.
                match keeping {
                  Some(k) -> if flags.json && answer.code == ok_code() {
                    let again = cases_of(rows_of(analysis), search, false);
                    let settled = decide(again.cases);
                    if all_cached(settled, scope) {
                      let kept_as = |f: Flags, o: Options, sc: Scope, key: String| {
                        let next = program_of(
                          o,
                          { ..timed, program: { ..timed.program, cache_warnings: [] } },
                          analysis,
                          over.entries,
                          root_of(flags.paths),
                          sc,
                          [],
                          filed_under,
                        );
                        let _ = concluded_run(
                          f,
                          style,
                          o,
                          next,
                          timed,
                          analysis,
                          over.judged,
                          sc,
                          settled,
                          decided_of(next, settled, search, sim_json(searching, o.sim), [], []),
                          map_new(),
                          {
                            refiled: [],
                            kept: Some({
                              ..k,
                              key: key,
                              passes: answered_by(again.answering, sc),
                              after: true,
                              alone: [],
                            }),
                          },
                          searching,
                          r.warnings,
                          targeted,
                          spent,
                        );
                        ()
                      };
                      kept_as(flags, options, scope, k.key);
                      // Each `--filter` of several kept apart too, as a run of it alone answers.
                      fold(k.alone, (), |u: Unit, a: { filter: String, key: String }| {
                        let o = { ..options, filters: [a.filter] };
                        kept_as({ ..flags, filters: [a.filter] }, o, scope_of(analysis, o), a.key)
                      })
                    }
                  },
                  None -> (),
                };
                tester.ended[corpus]();
                answer
              },
            },
          }
        },
      }
    },
  }
}

// --- A test over cases --------------------------------------------------------

/// The tests over cases this run reports on, whatever `--filter` says: a filter reads a case's
/// label, which only its listing knows.
fn over_cases(analysis: Analysis, options: Options) -> List<Int> =
  filter(scope_of(analysis, { ..options, filters: [] }).visible, |i: Int|
    match test_at(analysis, i) { Some(t) -> t.cases, None -> false })

/// What listing found: the unit it built and bound to list in, which the run's tests then run in,
/// and each asked test's cases or why they could not be listed.
type Listing = { unit: Option<Emitted>, cases: Map<Int, Result<List<Listed>, Unlisted>> }

fn listed(
  handed: LoadedAnalysis,
  asked: List<Int>,
) -> Result<Listing, List<Diag>> / {tester.unit[corpus], tester.cases[corpus], emit.unit} =
  if len(asked) == 0 { Ok({ unit: None, cases: map_new() }) } else {
    match whole_emitted(handed) {
      Err(diags) -> Err(diags),
      Ok(e) -> match tester.unit[corpus](handed, Some(e.text), true) {
        Err(diags) -> Err(diags),
        Ok(unit) ->
          Ok({
            unit: Some(e),
            cases: fold(
              asked,
              map_new(),
              |acc: Map<Int, Result<List<Listed>, Unlisted>>, i: Int|
                map_insert(acc, i, tester.cases[corpus](unit, i)),
            ),
          }),
      },
    }
  }

/// The run's tests, each case of a test over cases a test of its own: its label is its name, and its
/// test's hash and its identity make its hash. In `analysis` a case reaches what its test does, its
/// table among it, which is what covers a definition; in `judged` it reaches only what it runs,
/// which is what a failure of it is suspected against. `entries` is how the runtime is asked for
/// each, by the index it has here.
type Ranged = { analysis: Analysis, judged: Analysis, entries: List<Entry> }

type Ranging = {
  tests: List<TestInfo>,
  hashes: List<Bytes>,
  entries: List<Entry>,
  starts: Map<Bytes, List<Int>>,
  runs: Map<Bytes, List<Int>>,
}

/// `key` starting where it did and at `reached` besides.
fn starting(
  starts: Map<Bytes, List<Int>>,
  key: Bytes,
  reached: Option<List<Int>>,
) -> Map<Bytes, List<Int>> =
  match reached {
    None -> starts,
    Some(vs) ->
      map_insert(
        starts,
        key,
        concat(match map_get(starts, key) { Some(held) -> held, None -> [] }, vs),
      ),
  }

fn entry_of(index: Int, key: String) -> Entry = { test: index, of: key, case: None, unlisted: None }

fn ranged(
  analysis: Analysis,
  cases: Map<Int, Result<List<Listed>, Unlisted>>,
) -> Ranged / {abort.raise} = {
  let tests = analysis.checked.tests;
  let plain = map(range(0, len(tests)), |i: Int|
    entry_of(i, match list_at(tests, i) { Some(t) -> string_of_bytes_lossy(t.key), None -> "" }));
  if map_len(cases) == 0 { { analysis: analysis, judged: analysis, entries: plain } } else {
    // Every test hashed, or none is: a hash is read by the index its test has.
    let hashed = len(analysis.hashes.tests) == len(tests);
    let walked = fold(
      range(0, len(tests)),
      {
        tests: [],
        hashes: [],
        entries: [],
        starts: analysis.hashes.refs.items,
        runs: analysis.hashes.refs.items,
      },
      |acc: Ranging, i: Int|
        match ((list_at(tests, i), list_at(plain, i))) {
          (Some(t), Some(whole)) -> {
            let hash = at_or(analysis.hashes.tests, i, b"");
            match map_get(cases, i) {
              Some(Ok(listing)) ->
                fold(range(0, len(listing)), acc, |a: Ranging, k: Int|
                  match list_at(listing, k) {
                    None -> a,
                    Some(c) -> {
                      let key = qualify(t.module, bytes_of_string(c.label));
                      {
                        tests: push(a.tests, {
                          ..t,
                          name: bytes_of_string(c.label),
                          key: key,
                          index: len(a.tests),
                        }),
                        hashes: push(a.hashes, case_hash(hash, c.identity)),
                        entries: push(a.entries, {
                          ..whole,
                          case: Some({ at: k, identity: c.identity }),
                        }),
                        starts: starting(a.starts, key, map_get(analysis.hashes.refs.items, t.key)),
                        runs: starting(a.runs, key, map_get(analysis.hashes.refs.cases, t.key)),
                      }
                    },
                  }),
              other ->
                {
                  ..acc,
                  tests: push(acc.tests, { ..t, index: len(acc.tests) }),
                  hashes: push(acc.hashes, hash),
                  entries: push(acc.entries, match other {
                    Some(Err(why)) -> { ..whole, unlisted: Some(why) },
                    _ -> whole,
                  }),
                },
            }
          },
          _ -> acc,
        },
    );
    let reaching = |starts: Map<Bytes, List<Int>>|
      {
        ..analysis,
        checked: { ..analysis.checked, tests: walked.tests },
        hashes: {
          ..analysis.hashes,
          tests: if hashed { walked.hashes } else { [] },
          refs: { ..analysis.hashes.refs, items: starts },
        },
      };
    { analysis: reaching(walked.starts), judged: reaching(walked.runs), entries: walked.entries }
  }
}

/// The unit a run would execute in, or none for a run that would execute nothing.
fn unit_for(
  front: LoadedAnalysis,
  wanted: Bool,
) -> Result<Option<Emitted>, List<Diag>> / {emit.unit} =
  if !wanted { Ok(None) }
  else { match whole_emitted(front) { Ok(e) -> Ok(Some(e)), Err(diags) -> Err(diags) } }

/// Each test's code by index: the digest of what its root runs in the unit, and for a case its
/// identity with it.
fn codes_of(
  front: LoadedAnalysis,
  emitted: Emitted,
  entries: List<Entry>,
) -> Map<Int, String> / {abort.raise} = {
  let ran = codes(emitted.made);
  let roots = test_roots(front.dump);
  fold(range(0, len(entries)), map_new(), |acc: Map<Int, String>, i: Int|
    match list_at(entries, i) {
      None -> acc,
      Some(entry) -> match map_get(ran, at_or(roots, entry.test, b"")) {
        None -> acc,
        Some(code) ->
          map_insert(
            acc,
            i,
            hex_of(match entry.case { Some(c) -> case_hash(code, c.identity), None -> code }),
          ),
      },
    })
}

/// The tests the store holds a pass for under the code they run that still stands, each with the
/// trace it stands on.
fn passed_by_code(
  decisions: List<Decision>,
  keyed: Map<Int, String>,
) -> Map<Int, Bytes> / {ledger.code_passes, tester.moved[corpus], fs.list_dir[shipped], fs.read_file[shipped], abort.raise} = {
  let asked = asked_by_code(decisions, keyed);
  let answers = if len(asked) == 0 { [] }
  else { ledger.code_passes(map(asked, |a: { index: Int, key: String }| a.key)) };
  let now = views::now_for(views::viewed_in(traces_of(answers)));
  fold(range(0, len(asked)), map_new(), |acc: Map<Int, Bytes>, i: Int|
    match list_at(answers, i) {
      Some(Some(trace)) -> if standing(now, Some(trace)) == Some(Stands) {
        map_insert(acc, at_or(asked, i, { index: 0 - 1, key: "" }).index, trace)
      } else { acc },
      _ -> acc,
    })
}

/// What the binding came to, its reach said of the run's tests: a case is reached as its test is.
fn hosted_over(program: Program) -> Hosted / {tester.hosted[corpus]} = {
  let hosted = tester.hosted[corpus]();
  let reached = set_of(hosted.reaches);
  {
    ..hosted,
    reaches: map(
      filter(program.cases, |case: Case| map_contains(reached, case.entry.test)),
      |case: Case| case.index,
    ),
  }
}

/// The run itself, what it establishes, filed, and what it is asked after: a mutation of a green
/// run, and the cause of every failure. `judged` is the tests as a pass is recorded and a failure
/// suspected: a case reaching only what it runs.
fn concluded_run(
  flags: Flags,
  style: Style,
  options: Options,
  program: Program,
  timed: Timed,
  analysis: Analysis,
  judged: Analysis,
  scope: Scope,
  decisions: List<Decision>,
  decided: Decided,
  keyed: Map<Int, String>,
  // The passes refiled under their own keys, and where the run keeps its answer.
  keeps: { refiled: List<Pass>, kept: Option<Keeping> },
  searching: plan::Plan,
  configured: List<Diag>,
  targeted: Option<List<DefInfo>>,
  spent: Spent,
) -> Answer / {process.out[proc], builder.git[vcs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_us, tester.unit[corpus], tester.hosted[corpus], tester.executed[corpus], tester.interleaved[corpus], ledger.opened, ledger.passes, ledger.seen, ledger.baselines, ledger.bodies, ledger.interfaces, ledger.filed, emit.unit, abort.raise, shipped.reached} = {
  let refiled = keeps.refiled;
  let kept = keeps.kept;
  // What the next run answers: this run's notices of its cache and its store are not in it.
  let after = match kept { Some(k) -> k.after, None -> false };
  let asked = {
    plan: searching,
    measuring: options.sim.measure_reduction,
    lanes: match options.jobs { Some(n) -> if n > 0 { Some(n) } else { None }, None -> None },
  };
  let narrowing = narrowed(decisions, decided.search.roots);
  // The head and each group's results are printed as they are known, so a long run shows its
  // progress and its first failure; the document `--json` writes waits for the whole run.
  let shown = !flags.json;
  let width = name_column(program, decided);
  let opening = if shown {
    opening_lines(
      style,
      flags,
      program,
      decided,
      opening_of(options, program, hosted_over(program)),
    )
  } else { [] };
  if shown { printed(opening) };
  let started = time.elapsed_us();
  let done = flat_map(decided.classes, |group: Group| {
    let ran = ran_class(
      map(group.tests, |i: Int| job_of(program, 0, i, narrowing, searching)),
      asked,
    );
    if shown {
      printed(result_lines(style, program, map(ran, |d: Done| ran_outcome(analysis, d)), width))
    };
    ran
  });
  let elapsed = time.elapsed_us() - started;
  let hosted = hosted_over(program);
  let h = hashes_of(judged);
  let running = set_of(decided.runs);
  let by_test = fold(done, map_new(), |acc: Map<Int, Done>, d: Done| map_insert(acc, d.test, d));
  let c: Concluded<Raised> = conclude::concluded(
    conclude_tests(analysis),
    h,
    {
      groups: map(decided.classes, |group: Group| group.tests),
      filed: fold(
        filed(decisions, decided.search),
        map_new(),
        |acc: Map<Int, List<String>>, e: { index: Int, keys: List<String> }|
          if map_contains(running, e.index) { map_insert(acc, e.index, e.keys) } else { acc },
      ),
      codes: map_fold(keyed, map_new(), |acc: Map<Int, List<String>>, i: Int, k: String|
        if map_contains(running, i) { map_insert(acc, i, [k]) } else { acc }),
      reasons: fold(decisions, map_new(), |acc: Map<Int, Reason>, d: Decision|
        map_insert(acc, d.case.index, d.reason)),
      out_of_scope: scope.out,
    },
    if options.no_cache { map_new() } else { seen_of(h) },
    map(done, conclusion_of),
  );
  let said = if options.no_cache { [] } else {
    filing_said(
      ledger.filed({ ..c.filing, passes: concat(c.filing.passes, refiled) }),
      "could not write the test cache: ",
      "the run itself is valid; every test will simply be re-run next time",
    )
  };
  let stored = if after { [] } else { said };
  let r = mutated(
    timed,
    analysis,
    program,
    ran_of(
      options,
      program,
      analysis,
      h,
      decided,
      hosted,
      c,
      by_test,
      elapsed,
      concat(configured, stored),
    ),
    options,
    asked,
    targeted,
  );
  // After the run is filed, since a pass recorded now is a valid baseline for another's failure.
  let found = diagnosed_all(options, timed, judged, program, c, by_test, r.failures);
  let cause = decided_faults({ ..r, failures: found.failures }, found.benches, diagnosing(options));
  let proved = if options.no_cache || len(cause.proved) == 0 { [] } else {
    filing_said(
      ledger.filed({
        passes: map(cause.proved, |key: String| { key: key, trace: b"" }),
        codes: [],
        records: [],
        seen: [],
      }),
      "could not write what the bisection's mixtures proved: ",
      "every verdict stands; the next bisection runs those mixtures again",
    )
  };
  let lazily = if options.no_cache || after { [] } else { ledger.opened() };
  let concluding = time.elapsed_us() - started - elapsed;
  let answer = answered(
    style,
    flags,
    program,
    {
      ..r,
      failures: found.failures,
      warnings: concat(concat(r.warnings, proved), lazily),
      spent: { ..spent, tests_us: elapsed, conclude_us: concluding },
    },
    cause.faults,
    decided,
  );
  match kept {
    Some(k) -> if len(decided.runs) == 0 && answer.code == ok_code() && unwarned(answer)
        && all_cached(decisions, scope) {
      let _ = ledger.filed({
        passes: [
          {
            key: k.key,
            trace: answers::encoded({
              opening: opening,
              lines: answer.lines,
              errs: answer.errs,
              code: answer.code,
              json: to_string(answer.json),
              passes: k.passes,
              views: k.views,
              embeds: reached_embeds(timed.program, analysis, scope),
            }),
          },
        ],
        codes: [],
        records: [],
        seen: [],
      });
      ()
    },
    None -> (),
  };
  answer
}

/// What writing to the store had to say, its own failure first.
fn filing_said(f: Filed, unflushed: String, note: String) -> List<Diag> =
  match f.unflushed {
    None -> f.warnings,
    Some(why) -> concat([diag_of("warning", "W0601", unflushed ++ why, [], [note])], f.warnings),
  }

/// The search a seeded test's key is computed against, as the selector reads one.
fn search_of(p: plan::Plan) -> Search / {abort.raise} =
  {
    mode: plan::mode_word(p.mode),
    roots: map(p.roots, |r: U64| int_of_u64(r)),
    budget: p.budget,
    steps: p.steps,
    path: p.path,
  }

/// The whole plan, as the document's options carry it: every field is in a seeded test's key.
fn sim_json(p: plan::Plan, sim: machine::SimulationOptions) -> Json / {abort.raise} =
  object([
    { key: "budget", value: int(p.budget) },
    { key: "measure_reduction", value: Bool(sim.measure_reduction) },
    { key: "mode", value: Str(plan::mode_word(p.mode)) },
    {
      key: "roots",
      value: Array(
        map(p.roots, |r: U64|
          Number(option_unwrap_or(decimal_of_string(plan::u64_text(r)), decimal_of_int(0)))),
      ),
    },
    {
      key: "seed",
      value: match sim.seed {
        Some(text) -> match plan::parse_seed(text) {
          Some(seed) -> Str(plan::seed_text(seed)),
          None -> Null,
        },
        None -> Null,
      },
    },
    { key: "seeds", value: int(len(p.roots)) },
    { key: "steps", value: int(p.steps) },
  ])

fn with_sim(options: Json, sim: Json) -> Json =
  match options { Object(members) -> Object(map_insert(members, "sim", sim)), other -> other }

/// What the run's searches are asked: the plan a seeded test searches, whether to measure what the
/// pruning saved, and how many lanes run tests at once — one per test when `--jobs` names none.
type Asked = { plan: plan::Plan, measuring: Bool, lanes: Option<Int> }

/// One test to run in one unit, how that unit is asked for it, and the plan it searches when it is
/// seeded.
type Job = { unit: Int, test: Int, entry: Entry, search: Option<plan::Plan> }

/// How one test ended, what running it cost, and what its search explored, when it searched and every
/// interleaving of it entered a region.
type Done = {
  test: Int,
  status: String,
  failure: Option<Raised>,
  usage: Usage,
  /// What every run of it read between them, `None` when no trace stands in for one.
  trace: Option<Bytes>,
  searched: Option<{ exploration: Exploration, seeds: Int }>,
}

/// A seeded test searches the roots it still owes; any other runs once.
fn job_of(
  program: Program,
  unit: Int,
  index: Int,
  narrowing: List<{ index: Int, roots: List<Int> }>,
  searching: plan::Plan,
) -> Job / {abort.raise} =
  match case_of(program, index) {
    None -> { unit: unit, test: index, entry: entry_of(index, ""), search: None },
    Some(c) ->
      {
        unit: unit,
        test: index,
        entry: c.entry,
        search: if !c.seeded { None } else {
          match filter(narrowing, |n: { index: Int, roots: List<Int> }| n.index == index) {
            [owed, ..] -> Some({ ..searching, roots: map(owed.roots, |r: Int| u64_of_int(r)) }),
            [] -> Some(searching),
          }
        },
      },
  }

/// One class's tests at once: each in a lane of its own, or dealt across the lanes `--jobs` names,
/// a lane's tests in turn, answered in the class's order.
fn ran_class(
  jobs: List<Job>,
  asked: Asked,
) -> List<Done> / {tester.executed[corpus], tester.interleaved[corpus], abort.raise} = {
  let lanes = machine::dealt(jobs, asked.lanes);
  machine::undealt(ran_lanes(lanes, asked.measuring, 0, len(lanes), 64))
}

/// Halves under a `parallel` block until one lane is left, so lanes run at once; each lane answers
/// with its tests' in turn. `room` is the halvings left, and 64 take any length to one.
fn ran_lanes(
  lanes: List<List<Job>>,
  measuring: Bool,
  lo: Int,
  hi: Int,
  room: Int,
) -> List<List<Done>> / {tester.executed[corpus], tester.interleaved[corpus], abort.raise} =
  if hi - lo <= 0 { [] } else if hi - lo == 1 || room <= 0 {
    fold(range(lo, hi), [], |lanes_done: List<List<Done>>, i: Int|
      match list_at(lanes, i) {
        Some(lane) ->
          push(
            lanes_done,
            fold(lane, [], |out: List<Done>, j: Job| push(out, ran_job(j, measuring))),
          ),
        None -> lanes_done,
      })
  } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel {
      ran_lanes(lanes, measuring, lo, mid, room - 1),
      ran_lanes(lanes, measuring, mid, hi, room - 1),
    };
    concat(halves._0, halves._1)
  }

/// What a search's runs come to between them: what they cost and read, and whether one of them
/// never entered a region, which makes the whole search no search.
type Swept = { usage: Usage, trace: Option<Bytes>, unobserved: Bool }

/// A test once, or a seeded one searched an interleaving at a time. One whose cases could not be
/// listed ends as the listing did.
fn ran_job(
  j: Job,
  measuring: Bool,
) -> Done / {tester.executed[corpus], tester.interleaved[corpus], abort.raise} =
  match j.entry.unlisted {
    Some(why) ->
      {
        test: j.test,
        status: why.status,
        failure: Some(why.failure),
        usage: no_usage(),
        trace: None,
        searched: None,
      },
    None -> ran_listed(j, measuring),
  }

fn ran_listed(
  j: Job,
  measuring: Bool,
) -> Done / {tester.executed[corpus], tester.interleaved[corpus], abort.raise} =
  match j.search {
    None -> {
      let e: Executed = tester.executed[corpus](j.unit, j.entry.test, j.entry.case);
      {
        test: j.test,
        status: e.status,
        failure: e.failure,
        usage: e.usage,
        trace: e.trace,
        searched: None,
      }
    },
    Some(p) -> {
      // A search re-runs the whole test, so any host operation runs once per interleaving.
      let again = plan::re_executes(p) || measuring;
      let run = |st: Swept, seed: Seed| {
        let one = tester.interleaved[corpus](
          j.unit,
          j.entry.test,
          j.entry.case,
          seed,
          p.steps,
          again,
        );
        {
          run: one.run,
          state: {
            usage: sum_usage(st.usage, one.usage),
            trace: joined_trace(st.trace, one.trace),
            unobserved: st.unobserved || !one.observed,
          },
        }
      };
      let begun: Swept = { usage: no_usage(), trace: Some(b""), unobserved: false };
      let kept = if measuring { search::measure_keeping(p, begun, run) }
      else { search::explore_keeping(p, Exact, begun, run) };
      let explored = kept.explored;
      {
        test: j.test,
        status: match explored.failure {
          None -> "passed",
          // A recording that names no schedule, or a replay that took another, is Ply's fault.
          Some(fl) -> match search::run_failure(fl) {
            Some(fell) -> fell.status,
            None -> "panicked",
          },
        },
        failure: match explored.failure { Some(fl) -> Some(stopped(fl)), None -> None },
        usage: kept.state.usage,
        trace: kept.state.trace,
        searched: if kept.state.unobserved { None }
        else { Some({ exploration: explored.exploration, seeds: len(plan::normalized(p).roots) }) },
      }
    },
  }

fn reproduce(seed: Seed) -> String / {abort.raise} =
  "reproduce with `--sim once --seed " ++ plan::seed_text(seed)
    ++ "`, and report it with the test's source"

fn spanned(span: { module: Int, start: Int, end: Int }, said: String) -> Label =
  {
    module: span.module,
    start: span.start,
    end: span.end,
    primary: true,
    text: bytes_of_string(said),
  }

/// Why a search stopped at a seed, as the diagnostic a report prints: the run's own failure, or the
/// defect a recording that names no schedule, or a replay that took another, is.
fn stopped(fl: Failure<InterleavingFailure>) -> Raised / {abort.raise} =
  match search::run_failure(fl) {
    Some(fell) -> { ..fell.failure, diag: noted(fell.failure.diag, fl.notes) },
    None -> {
      let d = match fl.cause {
        Diverged(x) ->
          diag_of(
            "error",
            "E0415",
            "replaying seed " ++ plan::seed_text(x.seed)
              ++ " did not reproduce the recorded schedule",
            [spanned(x.span, "this scheduling point")],
            [
              x.what,
              "a simulated run must be a pure function of its definition set and its seed; this is a defect in Ply rather than in the program under test",
              reproduce(x.seed),
            ],
          ),
        Unscheduled(x) ->
          diag_of(
            "error",
            "E0505",
            "the scheduler recorded a step that does not describe a schedule",
            [spanned(x.span, "this step")],
            [x.what, reproduce(x.seed)],
          ),
        _ -> diag_of("error", "E0505", "a search stopped at a failure it does not hold", [], []),
      };
      { diag: noted(d, fl.notes), values: [] }
    },
  }

// --- What the run establishes ------------------------------------------------

fn hashes_of(analysis: Analysis) -> Hashes / {abort.raise} =
  {
    defs: by_name(analysis.hashes.defs),
    decls: by_name(analysis.hashes.decls),
    closure: |keys: List<String>| {
      let reached = reach(analysis.hashes, map(keys, |k: String| TheItem(bytes_of_string(k))));
      {
        fns: map(map_keys(reached.fns), string_of_bytes_lossy),
        decls: map(map_keys(reached.decls), string_of_bytes_lossy),
      }
    },
  }

fn conclude_tests(analysis: Analysis) -> List<conclude::Test> / {abort.raise} =
  fold(range(0, len(analysis.checked.tests)), [], |acc: List<conclude::Test>, i: Int|
    match test_at(analysis, i) {
      Some(t) ->
        push(acc, {
          index: i,
          key: string_of_bytes_lossy(t.key),
          seeded: seeded_of(t.footprint),
          hash: hash_at(analysis, i),
        }),
      None -> acc,
    })

/// Whether the store had seen each definition before this run, which a failure is suspected against.
fn seen_of(h: Hashes) -> Map<String, Bool> / {ledger.seen} = {
  let hashes = map_values(h.defs);
  let answers = ledger.seen(hashes);
  fold(range(0, len(hashes)), map_new(), |acc: Map<String, Bool>, i: Int|
    match ((list_at(hashes, i), list_at(answers, i))) {
      (Some(hash), Some(known)) -> map_insert(acc, hash, known),
      _ -> acc,
    })
}

fn conclusion_of(done: Done) -> conclude::Ran<Raised> =
  {
    index: done.test,
    status: done.status,
    failure: done.failure,
    host: done.usage.host,
    trace: done.trace,
    searched: match done.searched {
      Some(x) ->
        Some({
          explored: x.exploration.explored,
          exhaustive: x.exploration.exhaustive,
          exhausted: x.exploration.exhausted,
          failed: x.exploration.failure != None,
        }),
      None -> None,
    },
    seeds: match done.searched { Some(x) -> x.seeds, None -> 0 },
  }

fn done_at(done: Map<Int, Done>, index: Int) -> Option<Done> = map_get(done, index)

fn cost_of(c: Option<search::Cost>) -> Option<Cost> =
  match c {
    None -> None,
    Some(x) ->
      Some({
        explored: x.explored,
        bounded: x.bounded,
        rendered: (if x.bounded { ">= " } else { "" }) ++ int_to_string(x.explored),
      }),
  }

/// How many times more an unpruned search would have run, in tenths, rounded half up.
fn tenths_of(e: Exploration) -> Option<Int> / {abort.raise} =
  match e.naive {
    None -> None,
    Some(naive) -> if e.explored > 0 { Some((naive.explored * 20 + e.explored) / (2 * e.explored)) }
    else { None },
  }

fn explored_of(e: Exploration) -> Explored / {abort.raise} =
  {
    explored: e.explored,
    exhaustive: e.exhaustive,
    exhausted: e.exhausted,
    blind: cost_of(e.blind),
    naive: cost_of(e.naive),
    reduction_tenths: tenths_of(e),
    steps: e.steps,
    virtual_time_ns: e.virtual_time,
    failing_seed: match e.failure { Some(seed) -> Some(plan::seed_text(seed)), None -> None },
  }

fn exploration_of(done: Map<Int, Done>, index: Int) -> Option<Exploration> =
  match done_at(done, index) {
    Some(d) -> match d.searched { Some(x) -> Some(x.exploration), None -> None },
    None -> None,
  }

fn site_of(x: search::RaceSite) -> Site =
  {
    task: "@" ++ int_to_string(x.task),
    definition: x.definition,
    access: x.access,
    at: if x.span.module == no_module() { None } else { Some(x.span) },
  }

/// A test as its group ran it, which is all its result line says; the conclusion adds the failure
/// and what was filed.
fn ran_outcome(analysis: Analysis, done: Done) -> Outcome / {abort.raise} =
  {
    index: done.test,
    name: match test_at(analysis, done.test) {
      Some(t) -> string_of_bytes_lossy(t.name),
      None -> "",
    },
    hash: hash_at(analysis, done.test),
    duration_us: done.usage.duration_us,
    status: done.status,
    diagnostic: None,
    search: match done.searched { Some(x) -> Some(explored_of(x.exploration)), None -> None },
    cached: None,
    performs: done.usage.performs,
  }

fn outcome_of(
  analysis: Analysis,
  done: Map<Int, Done>,
  outcome: conclude::Outcome<Raised>,
) -> Outcome / {abort.raise} = {
  let d = done_at(done, outcome.index);
  {
    index: outcome.index,
    name: match test_at(analysis, outcome.index) {
      Some(t) -> string_of_bytes_lossy(t.name),
      None -> "",
    },
    hash: hash_at(analysis, outcome.index),
    duration_us: match d { Some(x) -> x.usage.duration_us, None -> 0 },
    status: outcome.status,
    diagnostic: outcome.failure,
    search: match exploration_of(done, outcome.index) {
      Some(e) -> Some(explored_of(e)),
      None -> None,
    },
    cached: match outcome.recorded { Some(rec) -> Some(written(rec)), None -> None },
    performs: match d { Some(x) -> x.usage.performs, None -> 0 },
  }
}

fn failed_of(
  analysis: Analysis,
  h: Hashes,
  done: Map<Int, Done>,
  failed: conclude::Failed<Raised>,
) -> Failed / {abort.raise} = {
  let t = test_at(analysis, failed.index);
  let e = exploration_of(done, failed.index);
  {
    key: failed.key,
    name: match t { Some(x) -> string_of_bytes_lossy(x.name), None -> failed.key },
    diagnostic: failed.failure,
    defect: failed.defect,
    host: failed.host,
    search: None,
    suspects: map(failed.suspects, |name: String|
      {
        name: name,
        hash: match map_get(h.defs, name) { Some(x) -> Some(x), None -> map_get(h.decls, name) },
      }),
    unchanged: len(failed.suspects) == 0,
    seed: match e {
      Some(x) -> match x.failure { Some(seed) -> Some(plan::seed_text(seed)), None -> None },
      None -> None,
    },
    race: match e {
      Some(x) -> match x.race {
        Some(race) -> Some({ left: site_of(race.left), right: site_of(race.right), step: race.at }),
        None -> None,
      },
      None -> None,
    },
    module: match t { Some(x) -> Some(string_of_bytes_lossy(x.module)), None -> None },
    test_hash: hash_at(analysis, failed.index),
    nondet: match t { Some(x) -> Some(x.nondet), None -> None },
    status: match done_at(done, failed.index) { Some(d) -> Some(d.status), None -> None },
    declared: match t { Some(x) -> Some(atom_texts(canonical(x.footprint))), None -> None },
  }
}

/// A pass a later hermetic run would believe, filed for a run that reached the host without the
/// binding it ran under, and a backend that silently declined every call: each is a run that is
/// green over a seam nothing reached.
fn escapes_of(
  hosted: Hosted,
  analysis: Analysis,
  c: Concluded<Raised>,
  done: Map<Int, Done>,
) -> List<Diag> / {abort.raise} = {
  let unbound = |index: Int|
    match done_at(done, index) {
      Some(d) ->
        d.usage.host
          && (match d.trace {
            Some(trace) -> !string_contains("\n" ++ string_of_bytes_lossy(trace), "\nbinding\t"),
            None -> false,
          }),
      None -> false,
    };
  let filed_host = if hosted.hermetic { [] } else {
    fold(c.outcomes, [], |acc: List<Diag>, outcome: conclude::Outcome<Raised>| {
      let wrote = match outcome.recorded { Some(rec) -> written(rec), None -> false };
      if !wrote || !unbound(outcome.index) { acc } else {
        push(
          acc,
          diag_of(
            "error",
            "E0505",
            "`"
              ++ (match test_at(analysis, outcome.index) {
                Some(t) -> string_of_bytes_lossy(t.name),
                None -> "",
              })
              ++ "` reached the host, and its pass was written without the binding it ran under",
            [],
            [
              "a pass that reached the host answers only for the binding it ran under",
              "run `ply cache clear`: an entry written here would be believed by a later hermetic run",
              "this is Ply's fault — the runner and the tester disagree about what this test reached",
            ],
          ),
        )
      }
    })
  };
  let b = hosted.backend;
  if b.unbuilt == 0 { filed_host } else {
    push(
      filed_host,
      diag_of(
        "error",
        "E0505",
        int_to_string(b.unbuilt) ++ " thread(s) could not build the `" ++ b.name
          ++ "` backend, and every call they were offered was declined",
        [],
        [
          "the backend was built once before the run started, so this cannot be a host that has no code generator",
          "this is Ply's fault — a run that installs a backend and silently does not have one is green over a seam nothing reached",
        ],
      ),
    )
  }
}

fn notice_of(n: conclude::Notice) -> Diag =
  match n {
    StaleIndex(x) ->
      diag_of(
        "warning",
        "E0505",
        "a run named test " ++ int_to_string(x.index) ++ ", but the module defines "
          ++ int_to_string(x.declared),
        [],
        ["the choice was made against another program; the stale index was skipped"],
      ),
    UnobservedSearch(key) ->
      diag_of(
        "warning",
        "E0505",
        "`" ++ key ++ "` reads a simulation seed, but the run reported no search",
        [],
        [
          "the test passed and its result was not cached, so it re-runs next time",
          "this is a defect in Ply rather than in the test; please report it",
        ],
      ),
  }

fn ran_of(
  options: Options,
  program: Program,
  analysis: Analysis,
  h: Hashes,
  decided: Decided,
  hosted: Hosted,
  c: Concluded<Raised>,
  done: Map<Int, Done>,
  elapsed: Int,
  said: List<Diag>,
) -> RunReport / {abort.raise} = {
  let ordered = fold(c.outcomes, [], |acc: List<Done>, outcome: conclude::Outcome<Raised>|
    match done_at(done, outcome.index) { Some(d) -> push(acc, d), None -> acc });
  let teardown = fold(ordered, [], |acc: List<Diag>, d: Done| concat(acc, d.usage.teardown));
  let b = hosted.backend;
  {
    hermetic: hosted.hermetic,
    label: hosted.label,
    operations: hosted.operations,
    digest: hosted.digest,
    handshakes: hosted.handshakes,
    hosts: hosted.hosts,
    reaches: filter(hosted.reaches, |i: Int| case_of(program, i) != None),
    workers: match options.jobs {
      Some(n) -> if n > 0 { n } else { hosted.cores },
      None -> hosted.cores,
    },
    backend: Some({
      name: b.name,
      fragment: b.fragment,
      offered: b.offered,
      entered: map_fold(done, 0, |n: Int, i: Int, d: Done| n + d.usage.entries),
      declined: map_fold(done, 0, |n: Int, i: Int, d: Done| n + d.usage.declines),
      converted_in: b.converted_in,
      converted_out: b.converted_out,
      units: b.units,
      analysis_nanos: b.analysis_nanos,
      codegen_nanos: b.codegen_nanos,
    }),
    results: map(c.outcomes, |outcome: conclude::Outcome<Raised>|
      outcome_of(analysis, done, outcome)),
    failures: map(c.failures, |failed: conclude::Failed<Raised>|
      failed_of(analysis, h, done, failed)),
    summary: {
      passed: c.passed,
      failed: c.failed,
      abandoned: c.abandoned,
      cached: cached_count(program, decided),
      duration_us: elapsed,
    },
    simulation: c.simulation,
    escapes: escapes_of(hosted, analysis, c, done),
    warnings: concat(concat(teardown, map(c.notices, notice_of)), said),
    mutants: None,
    coverage: if options.coverage { Some(coverage(analysis)) } else { None },
    spent: no_spent(),
  }
}

/// A green run's mutants, judged up to the budget; a red run's survivors would say nothing.
fn mutated(
  timed: Timed,
  analysis: Analysis,
  program: Program,
  report: RunReport,
  options: Options,
  asked: Asked,
  targeted: Option<List<DefInfo>>,
) -> RunReport / {builder.git[vcs], fs.list_dir[shipped], fs.read_file[shipped], tester.unit[corpus], tester.executed[corpus], tester.interleaved[corpus], emit.unit, abort.raise, shipped.reached} =
  match targeted {
    None -> report,
    Some(defs) -> if !green_run(report) { report } else {
      let queue = queued(timed.program.places, analysis, defs);
      let every = every_of(program, options);
      let judged = map(range(0, min(options.mutate_budget, len(queue.mutants))), |id: Int|
        judged_mutant(timed, analysis, program, queue, id, every, asked));
      {
        ..report,
        mutants: Some(
          mutants(
            timed.program.places,
            analysis,
            queue,
            judged,
            len(queue.mutants) > options.mutate_budget,
          ),
        ),
      }
    },
  }

/// The tests that reach a mutant, in the classes every test the run reports on was coloured into: a
/// subset of a class shares nothing either. Every seed of the plan is owed, and nothing is filed.
fn judged_mutant(
  timed: Timed,
  analysis: Analysis,
  program: Program,
  queue: Queue,
  id: Int,
  every: List<List<Int>>,
  asked: Asked,
) -> Judged / {tester.unit[corpus], tester.executed[corpus], tester.interleaved[corpus], emit.unit, abort.raise, shipped.reached} =
  match list_at(queue.mutants, id) {
    None ->
      { id: id, verdict: "unresolved", why: "no mutant " ++ int_to_string(id) ++ " was queued" },
    Some(m) -> match built(timed.program, analysis, m.mutation) {
      Err(j) -> { ..j, id: id },
      Ok(unit) -> {
        let classes = filter(
          map(every, |class: List<Int>| filter(class, |i: Int| contains(m.tests, i))),
          |class: List<Int>| len(class) > 0,
        );
        let statuses = flat_map(classes, |class: List<Int>|
          map(
            ran_class(map(class, |i: Int| job_of(program, unit, i, [], asked.plan)), {
              ..asked,
              measuring: false,
            }),
            |done: Done| done.status,
          ));
        let expected = fold(classes, 0, |n: Int, class: List<Int>| n + len(class));
        let judged = |verdict: String, why: String| { id: id, verdict: verdict, why: why };
        if contains(statuses, "failed") { judged("killed", "") }
        else if contains(statuses, "panicked") {
          judged("unresolved", "Ply failed running the tests")
        } else if len(filter(statuses, |s: String| s == "passed")) == expected {
          judged("survived", "")
        } else { judged("unresolved", "not every test answered") }
      },
    },
  }

/// What the store holds for each test, asked under the keys this program computes: the key its
/// result is filed under, and — for a seeded test whose plan is answered root by root — each
/// root's own. A run that bypasses the cache asks nothing and finds nothing.
/// Each test's case, and the keys whose passes answer it where one does: its own, or each root's.
type Selection = { cases: List<select::Case>, answering: List<List<String>> }

fn cases_of(
  rows: List<Row>,
  search: Search,
  bypassed: Bool,
) -> Selection / {ledger.passes, tester.moved[corpus], fs.list_dir[shipped], fs.read_file[shipped], abort.raise} = {
  let ask = |keys: List<String>|
    if bypassed { map(keys, |k: String| None) } else { ledger.passes(keys) };
  let digest = digest_of(search);
  let keys = map(rows, |r: Row| key_of(r, digest));
  let filed = ask(
    fold(keys, [], |acc: List<String>, k: Option<String>|
      match k { Some(key) -> push(acc, key), None -> acc }),
  );
  let rooted = map(rows, |r: Row|
    match r.hash {
      Some(h) -> if answers_per_root(r, search) { Some(seed_keys(h, search.roots, [])) }
      else { None },
      None -> None,
    });
  let seeded = map(rooted, |ks: Option<List<String>>|
    match ks { Some(xs) -> Some(ask(xs)), None -> None });
  let now = views::now_for(
    views::viewed_in(
      traces_of(
        fold(seeded, filed, |acc: List<Option<Bytes>>, o: Option<List<Option<Bytes>>>|
          match o { Some(xs) -> concat(acc, xs), None -> acc }),
      ),
    ),
  );
  let answers = map(filed, |held: Option<Bytes>| standing(now, held));
  // A keyed row's answer is the next one, in the order the keys were asked.
  let held = fold(
    keys,
    { at: 0, out: [] },
    |st: { at: Int, out: List<Option<Held>> }, k: Option<String>|
      match k {
        None -> { ..st, out: push(st.out, None) },
        Some(_) -> { at: st.at + 1, out: push(st.out, at_or(answers, st.at, None)) },
      },
  ).out;
  let owed = map(seeded, |o: Option<List<Option<Bytes>>>|
    match o {
      Some(xs) ->
        Some(owed_roots(search.roots, map(xs, |held: Option<Bytes>| standing(now, held)))),
      None -> None,
    });
  {
    cases: map(range(0, len(rows)), |i: Int|
      select::case_of(
        at_or(rows, i, no_row()),
        at_or(keys, i, None),
        at_or(held, i, None),
        at_or(owed, i, None),
      )),
    answering: map(range(0, len(rows)), |i: Int|
      match ((at_or(keys, i, None), at_or(held, i, None))) {
        (Some(key), Some(Stands)) -> [key],
        (Some(_), None) -> match ((at_or(rooted, i, None), at_or(owed, i, None))) {
          (Some(ks), Some([])) -> ks,
          _ -> [],
        },
        _ -> [],
      }),
  }
}

fn traces_of(held: List<Option<Bytes>>) -> List<Bytes> =
  fold(held, [], |acc: List<Bytes>, h: Option<Bytes>|
    match h { Some(trace) -> push(acc, trace), None -> acc })

/// What a filed pass says now: it stands while every read its trace holds answers as it did, and
/// every view of a shipped module it holds stands against `now`.
fn standing(
  now: views::Now,
  held: Option<Bytes>,
) -> Option<Held> / {tester.moved[corpus], abort.raise} =
  match held {
    None -> None,
    Some(trace) -> if trace == b"" { Some(Stands) } else {
      let split = views::split(trace);
      match tester.moved[corpus](split.rest) {
        Some(what) -> Some(Moved(what)),
        None -> match views::moved(now, split.viewed) {
          None -> Some(Stands),
          Some(what) -> Some(Moved(what)),
        },
      }
    },
  }

fn no_row() -> Row =
  { index: 0, label: "", name: "", module: "", hash: None, seeded: false, nondet: false }

// --- What decided each cause -------------------------------------------------

/// Each failure's facts, read once the run is filed, and the bench its mixtures are tried on. A test
/// that never passed, or a run that bypassed the cache, has no baseline and so no facts, and a case
/// of a test over cases has facts and no bench.
fn diagnosed_all(
  options: Options,
  timed: Timed,
  analysis: Analysis,
  program: Program,
  c: Concluded<Raised>,
  done: Map<Int, Done>,
  failures: List<Failed>,
) -> { failures: List<Failed>, benches: List<Option<Bench>> } / {ledger.baselines, ledger.interfaces, ledger.bodies, abort.raise} =
  if options.no_cache || len(failures) == 0 {
    { failures: failures, benches: map(failures, |f: Failed| None) }
  } else {
    let records = ledger.baselines(map(failures, |f: Failed| f.key));
    if fold(records, true, |none: Bool, r: Option<conclude::PassRecord>| none && r == None) {
      { failures: failures, benches: map(failures, |f: Failed| None) }
    } else {
      let tree = trials::program_of(timed.program, analysis);
      fold(
        range(0, len(failures)),
        { failures: [], benches: [] },
        |acc: { failures: List<Failed>, benches: List<Option<Bench>> }, i: Int|
          match ((list_at(failures, i), list_at(records, i), list_at(c.failures, i))) {
            (Some(f), Some(Some(record)), Some(cf)) -> {
              let seed = match exploration_of(done, cf.index) {
                Some(e) -> match e.failure { Some(s) -> s, None -> { root: 0u64, path: [] } },
                None -> { root: 0u64, path: [] },
              };
              let of_cases = match case_of(program, cf.index) {
                Some(case) -> case.entry.case != None,
                None -> false,
              };
              let d = diagnosed(tree, f.key, f.test_hash, record, f.diagnostic, seed, of_cases);
              {
                failures: push(acc.failures, { ..f, search: Some(d.evident) }),
                benches: push(acc.benches, d.bench),
              }
            },
            (Some(f), _, _) ->
              { failures: push(acc.failures, f), benches: push(acc.benches, None) },
            _ -> acc,
          },
      )
    }
  }

/// Every failure's cause, decided before anything renders one, and the keys of the mixtures that
/// went green, which the store keeps.
fn decided_faults(
  report: RunReport,
  benches: List<Option<Bench>>,
  asked: Diagnosing,
) -> { faults: List<Fault>, proved: List<String> } / {ledger.passes, tester.unit[corpus], tester.interleaved[corpus], emit.unit, abort.raise} =
  with_cell[proofs]([]) { held -> {
    let faults = flat_map(range(0, len(report.failures)), |i: Int|
      match list_at(report.failures, i) {
        None -> [],
        Some(f) ->
          [
            fault_of(f, asked, |keys: List<DefKey>, filed: Option<String>|
              match list_at(benches, i) {
                Some(Some(b)) -> {
                  let tried: Tried = trial(b, keys, filed);
                  match tried.proved {
                    Some(k) -> cell_set(held, push(cell_get(held), k)),
                    None -> (),
                  };
                  tried.trial
                },
                _ -> unresolved_trial(MissingBody),
              }),
          ],
      });
    { faults: faults, proved: cell_get(held) }
  } }

/// What this run's flags ask of a cause: the search mode and the trial budget.
type Diagnosing = { bisect: Mode, budget: Budget }

fn diagnosing(options: Options) -> Diagnosing =
  {
    bisect: match mode_parse(options.bisect) { Some(m) -> m, None -> Auto },
    budget: { max_trials: Some(options.bisect_budget) },
  }

/// One failure's cause. The gate, the change set, the search over it and the ranking of the
/// suspects are `suite.diagnose`'s, over the facts the run read and `tried`, which builds and runs
/// one mixture at a time.
fn fault_of<| e>(
  failed: Failed,
  asked: Diagnosing,
  tried: (List<DefKey>, Option<String>) -> Trial / e,
) -> Fault / {abort.raise | e} = {
  let diff = match failed.search { Some(e) -> Some(classified(e.facts)), None -> None };
  let evidence: Evidence = {
    nondet: match failed.nondet { Some(x) -> x, None -> false },
    defect: failed.defect,
    host: failed.host,
    suspects: failed.suspects,
    baseline: match failed.search { Some(_) -> true, None -> false },
  };
  let a: Attribution = diagnose(
    evidence,
    asked,
    match diff { Some(d) -> Some(d.delta), None -> None },
    match diff { Some(d) -> len(d.unclassified), None -> 0 },
    match diff { Some(d) -> !d.test_unclassified, None -> true },
    |d: Delta, flipped: List<Int>| {
      let keys = flipped_keys(d, flipped);
      tried(keys, mixture_filed(failed, keys))
    },
    match failed.search { Some(e) -> e.absent, None -> None },
  );
  let places = match failed.search { Some(e) -> e.at, None -> [] };
  {
    key: failed.key,
    name: failed.name,
    diagnostic: shown(failed.diagnostic),
    defect: failed.defect,
    bisect: bisect_of(a.bisection, places),
    suspects: a.suspects,
    unchanged: failed.unchanged,
    seed: failed.seed,
    race: failed.race,
    replay: match failed.seed { Some(seed) -> replay_of(seed, failed.name), None -> None },
    module: failed.module,
    test_hash: failed.test_hash,
    nondet: failed.nondet,
    status: failed.status,
    declared: failed.declared,
  }
}

/// The command that replays one interleaving of one test, spelled for a shell to read back as
/// these words; none for a name no shell word can carry.
fn replay_of(seed: String, name: String) -> Option<String> =
  shell_join(["ply", "test", "--seed", seed, "--filter", name])

/// A mixture's pass is filed under the test as it is now and as it last passed, the definitions
/// taken, and the interleaving the failure took.
fn mixture_filed(failed: Failed, keys: List<DefKey>) -> Option<String> / {abort.raise} =
  match failed.search {
    None -> None,
    Some(e) -> match e.facts.own.after {
      None -> None,
      Some(now) ->
        Some(
          hex_of(
            mixture_key(bytes_of_hex(now), bytes_of_hex(e.facts.own.before), keys, failed.seed),
          ),
        ),
    },
  }

/// A verdict as the report carries it, with the place of the first of each group's definitions.
fn bisect_of(verdict: Bisection, places: List<{ name: String, at: Option<ModuleSpan> }>) -> Bisect =
  {
    conclusive: is_conclusive(verdict),
    // Silent when no bisection was asked for.
    requested: match verdict.verdict { NotAttempted(NotRequested) -> false, _ -> true },
    reason: verdict.reason,
    culprits: map(verdict.groups, |group: List<String>|
      { names: group, at: first_at(places, group) }),
    verdict: verdict_word(verdict.verdict),
    skipped: match verdict_skipped(verdict.verdict) {
      Some(why) -> Some(skipped_word(why)),
      None -> None,
    },
    confidence: confidence_word(verdict.confidence),
    groups: verdict.groups,
    search: verdict.search,
  }

/// Where the first of a group's definitions is: the runtime knows the places and this side knows only
/// the names.
fn first_at(
  at: List<{ name: String, at: Option<ModuleSpan> }>,
  names: List<String>,
) -> Option<ModuleSpan> =
  fold(names, None, |found: Option<ModuleSpan>, name: String|
    match found {
      Some(_) -> found,
      None -> match filter(at, |e: { name: String, at: Option<ModuleSpan> }| e.name == name) {
        [] -> None,
        hits -> at_at(hits, 0),
      },
    })

fn at_at(hits: List<{ name: String, at: Option<ModuleSpan> }>, i: Int) -> Option<ModuleSpan> =
  match list_at(hits, i) { Some(hit) -> hit.at, None -> None }

// --- Tests ------------------------------------------------------------------

fn a_place() -> List<Place> =
  [{ path: "m.ply", text: b"test \"two is two\" { assert_eq(1 + 1, 2) }\n" }]

fn no_phases() -> Phases = { read_us: 0, front_us: 0, write_back_us: 0 }

fn a_hash() -> String = "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"

fn a_key(index: Int, label: String, answered: Bool, seeded: Bool, unstable: Bool) -> select::Case =
  {
    index: index,
    label: label,
    name: "m." ++ label,
    module: "m",
    hash: Some(a_hash()),
    cache_key: Some(a_hash()),
    seeded: seeded,
    nondet: unstable,
    cached: if answered { Some(Stands) } else { None },
    owed: None,
  }

fn a_search() -> Search = { mode: "dpor", roots: [0], budget: 256, steps: 100000, path: [] }

fn a_case(index: Int, name: String) -> Case =
  {
    index: index,
    entry: entry_of(index, "m." ++ name),
    key: "m." ++ name,
    name: name,
    module: "m",
    nondet: false,
    hash: Some(a_hash()),
    footprint: "{}",
    atoms: [],
    seeded: false,
  }

/// The decision a fixture's keys imply: the reasons come from `decide`, so a fixture that wants a
/// cached test says its key was answered rather than naming the reason. The classes are the ones the
/// decision's own runs make, with a placeholder rendering — a fixture reads the shape, not the atoms.
fn a_decided(program: Program, keys: List<select::Case>) -> Decided / {abort.raise} = {
  let decisions = decide(keys);
  let classes = classes_of(program, to_run(decisions));
  decided_of(
    program,
    decisions,
    a_search(),
    Null,
    map(classes, |class: List<Int>| { tests: class, footprint: "{}" }),
    classes,
  )
}

fn an_opening() -> Opening = { hermetic: true, operations: 0, digest: "", reaches: [], workers: 4 }

fn a_program(cases: List<Case>) -> Program =
  {
    root: "/p",
    files: ["m.ply"],
    places: a_place(),
    modules: [{ name: "m", file: "m.ply" }],
    incremental: true,
    phases: no_phases(),
    declared: len(cases),
    cases: cases,
    positions: placed_cases(cases),
    filtered_out: 0,
    warnings: [],
    options: Null,
    filed_under: Some("aabbccddeeff00112233"),
  }

fn an_outcome(index: Int, name: String, status: String) -> Outcome =
  {
    index: index,
    name: name,
    hash: None,
    duration_us: 1500,
    status: status,
    diagnostic: None,
    search: None,
    cached: Some(true),
    performs: 0,
  }

fn a_run(results: List<Outcome>, failed: Int) -> RunReport =
  {
    hermetic: true,
    label: "hermetic",
    operations: 0,
    digest: "",
    handshakes: [],
    hosts: Null,
    reaches: [],
    workers: 4,
    backend: None,
    results: results,
    failures: [],
    summary: {
      passed: len(filter(results, |outcome: Outcome| outcome.status == "passed")),
      failed: failed,
      abandoned: len(filter(results, |outcome: Outcome| outcome.status == "abandoned")),
      cached: 0,
      duration_us: 20000,
    },
    simulation: {
      simulated: 0,
      total: len(results),
      seeds: 0,
      interleavings: 0,
      exhaustive: 0,
      exhausted: 0,
      failed: 0,
    },
    escapes: [],
    warnings: [],
    mutants: None,
    coverage: None,
    spent: no_spent(),
  }

fn no_bisect() -> Bisect =
  {
    conclusive: false,
    requested: false,
    reason: "",
    culprits: [],
    verdict: "not_attempted",
    skipped: Some("not_requested"),
    confidence: "none",
    groups: [],
    search: {
      candidates: 0,
      clusters: 0,
      evaluated: 0,
      cached: 0,
      memoized: 0,
      unresolved: 0,
      exhausted: false,
    },
  }

fn a_fault() -> Fault =
  {
    key: "m.two is two",
    name: "two is two",
    diagnostic: error_with_labels(b"E0502", b"assertion failed", [], []),
    defect: false,
    bisect: no_bisect(),
    suspects: [],
    unchanged: false,
    seed: None,
    race: None,
    replay: None,
    module: Some("m"),
    test_hash: None,
    nondet: Some(false),
    status: Some("failed"),
    declared: None,
  }

fn a_suspect(name: String) -> Suspect =
  { name: name, hash: None, before: None, change: None, culprit: false }

/// A failure the runtime reports with two edits since its test last passed.
fn a_failed(defect: Bool, host: Bool, absent: Option<Skipped>) -> Failed =
  {
    key: "m.two is two",
    name: "two is two",
    diagnostic: { diag: error_with_labels(b"E0501", b"assertion failed", [], []), values: [] },
    defect: defect,
    host: host,
    search: Some({
      facts: {
        own: { name: "m.two is two", before: "01", after: Some("02"), rehashed: Some("01") },
        rows: [
          {
            name: "m.a",
            ns: Value,
            before: Some("a1"),
            after: Some("a2"),
            rehashed: Some("a2"),
            stable: None,
            kept: false,
            renamed: false,
            component: [],
            referrers: [],
          },
          {
            name: "m.b",
            ns: Value,
            before: Some("b1"),
            after: Some("b2"),
            rehashed: Some("b2"),
            stable: None,
            kept: false,
            renamed: false,
            component: [],
            referrers: [],
          },
        ],
      },
      absent: absent,
      at: [],
    }),
    suspects: [{ name: "m.a", hash: Some("a2") }, { name: "m.b", hash: Some("b2") }],
    unchanged: false,
    seed: None,
    race: None,
    module: Some("m"),
    test_hash: None,
    nondet: Some(false),
    status: Some("failed"),
    declared: None,
  }

/// The verdict on one failure, from mixtures that fail exactly when they take `m.b`.
fn caused(failed: Failed) -> Bisect / {abort.raise} =
  fault_of(
    failed,
    { bisect: Auto, budget: { max_trials: Some(64) } },
    |keys: List<DefKey>, filed: Option<String>| taking_b_fails(keys),
  ).bisect

fn taking_b_fails(keys: List<DefKey>) -> Trial =
  if len(filter(keys, |k: DefKey| k.name == "m.b")) > 0 { a_failure() } else { a_pass() }

test "a green run is exit 0, and the head says what was selected of what before a test runs" {
  let p = a_program([a_case(0, "one"), a_case(1, "two")]);
  let keys = [a_key(0, "one", false, false, false), a_key(1, "two", true, false, false)];
  let opening = opening_lines(plain(), from_argv("test", []), p, a_decided(p, keys), an_opening());
  assert_eq(opening, [
    "   selected 1 of 2 (1 cached)",
    "   1 group · 4 workers",
    "   isolated 2 of 2",
    "",
  ]);
  let answer = answered(
    plain(),
    from_argv("test", []),
    p,
    a_run([an_outcome(0, "one", "passed")], 0),
    [],
    a_decided(p, keys),
  );
  assert_eq(answer.code, 0);
  // The head and the results went out as the run went; the answer is what follows them.
  assert(!contains(answer.lines, "   selected 1 of 2 (1 cached)"));
  assert_eq(filter(answer.lines, |l: String| string_starts_with(l, "   ok ")), []);
  assert_eq(answer.errs, [])
}

test "a failure is exit 1 and the culprit is printed before the diff" {
  let p = a_program([a_case(0, "two is two")]);
  let keys = [a_key(0, "two is two", false, false, false)];
  let culprit = {
    ..a_fault(),
    bisect: {
      ..no_bisect(),
      conclusive: true,
      requested: true,
      reason: "narrowed to one body",
      culprits: [{ names: ["m.total"], at: None }],
    },
  };
  let answer = answered(
    plain(),
    from_argv("test", []),
    p,
    a_run([an_outcome(0, "two is two", "failed")], 1),
    [culprit],
    a_decided(p, keys),
  );
  assert_eq(answer.code, 1);
  assert(contains(answer.lines, "   m.two is two"));
  assert(contains(answer.lines, "     culprit: m.total"));
  assert(contains(answer.lines, "       narrowed to one body"));
  assert(contains(answer.lines, "     assertion failed"))
}

test "a bisection nobody asked for says nothing, and one that failed says why" {
  assert_eq(bisect_lines(plain(), a_place(), no_bisect()), []);
  assert_eq(
    bisect_lines(plain(), a_place(), {
      ..no_bisect(),
      requested: true,
      reason: "no baseline to compare",
    }),
    ["  no culprit: no baseline to compare"],
  )
}

test "the runtime's marks decide whether a failure is searched, and a search names the edit" {
  assert_eq(caused(a_failed(false, false, None)).groups, [["m.b"]]);
  // A defect in Ply and a run that reached the host are refused before any mixture is tried.
  let defect = caused(a_failed(true, false, None));
  assert_eq(defect.skipped, Some("panicked"));
  assert_eq(defect.search.evaluated, 0);
  let host = caused(a_failed(false, true, None));
  assert_eq(host.skipped, Some("host"));
  assert_eq(host.search.evaluated, 0);
  // Two edits need a mixture to tell apart, so a store that cannot build one is the reason.
  let pruned = caused(a_failed(false, false, Some(NoBodies)));
  assert_eq(pruned.skipped, Some("no_bodies"));
  assert_eq(pruned.search.evaluated, 0)
}

test "a test the clock stopped is abandoned rather than judged, and the run is not a success" {
  let p = a_program([a_case(0, "slow")]);
  let keys = [a_key(0, "slow", false, false, false)];
  let stopped = {
    ..an_outcome(0, "slow", "abandoned"),
    diagnostic: Some({
      diag: error_with_labels(b"E0504", b"the run was abandoned", [], [b"raise the clock"]),
      values: [],
    }),
  };
  let answer = answered(
    plain(),
    from_argv("test", []),
    p,
    a_run([stopped], 0),
    [],
    a_decided(p, keys),
  );
  assert_eq(answer.code, 1);
  assert(contains(answer.lines, "   slow abandoned"));
  assert(contains(answer.lines, "     the run was abandoned"));
  assert(contains(answer.lines, "     = raise the clock"))
}

// A pass a later hermetic run would believe is not a warning: the run is red over it.
test "an escaped cache entry fails the run even with every test green" {
  let p = a_program([a_case(0, "one")]);
  let keys = [a_key(0, "one", false, false, false)];
  let escaped = {
    ..a_run([an_outcome(0, "one", "passed")], 0),
    escapes: [error_with_labels(b"E0001", b"`m.one` can reach the host binding", [], [])],
  };
  assert_eq(answered(plain(), from_argv("test", []), p, escaped, [], a_decided(p, keys)).code, 1)
}

test "a mutant no test kills fails the run and is named with what it changed" {
  let p = a_program([a_case(0, "one")]);
  let keys = [a_key(0, "one", false, false, false)];
  let mutated = {
    ..a_run([an_outcome(0, "one", "passed")], 0),
    mutants: Some({
      killed: 2,
      survived: 1,
      skipped: 0,
      budget_spent: false,
      unreached: [],
      survivors: [{ definition: "m.total", from: "+", to: "-", at: None }],
      json: Null,
    }),
  };
  let answer = answered(plain(), from_argv("test", []), p, mutated, [], a_decided(p, keys));
  assert_eq(answer.code, 1);
  assert(contains(answer.lines, "   mutants 2 killed, 1 survived, 0 skipped"));
  assert(contains(answer.lines, "      m.total survives `+` -> `-` at "))
}

test "the mark is a word in a plain run and one glyph in a styled one" {
  assert_eq(marked(plain(), "passed"), "ok     ");
  assert_eq(marked(plain(), "failed"), "FAIL   ");
  assert_eq(marked(plain(), "panicked"), "PANIC  ");
  assert_eq(marked(plain(), "abandoned"), "GAVE UP");
  assert_eq(bytes_of_string(marked(ansi(), "passed")), b"\x1b[32m\xe2\x9c\x93\x1b[0m")
}

test "a result line pads the name to the column and the reading to one decimal" {
  let p = a_program([a_case(0, "two is two")]);
  let keys = [a_key(0, "two is two", false, false, false)];
  assert_eq(
    result_line(plain(), p, an_outcome(0, "two is two", "passed"), 24),
    "   ok      two is two                    1.5ms",
  )
}

// The column never narrows below 24 and never widens past 64, so long names still line up.
test "the name column is the widest name the run will run, clamped" {
  let column = |names: List<String>| {
    let p = a_program(map(range(0, len(names)), |i: Int| a_case(i, at_or(names, i, ""))));
    name_column(
      p,
      a_decided(
        p,
        map(range(0, len(names)), |i: Int| a_key(i, at_or(names, i, ""), false, false, false)),
      ),
    )
  };
  assert_eq(column([]), 24);
  assert_eq(column(["short", repeat("x", 30)]), 30);
  assert_eq(column([repeat("x", 90)]), 64);
  let p = a_program([a_case(0, repeat("x", 40)), a_case(1, "two")]);
  let cached_long = a_decided(p, [
    a_key(0, repeat("x", 40), true, false, false),
    a_key(1, "two", false, false, false),
  ]);
  assert_eq(name_column(p, cached_long), 24)
}

test "the summary counts what was decided and how long it took" {
  let p = a_program([a_case(0, "one")]);
  let r = a_run([an_outcome(0, "one", "passed")], 0);
  assert_eq(
    summary_line(plain(), r, counts_of(p, r.reaches)),
    "   0 failed, 1 passed, 0 cached (0.02s)",
  );
  let hosted = { ..r, reaches: [0] };
  assert(
    string_contains(summary_line(plain(), hosted, counts_of(p, hosted.reaches)), "1 host-backed"),
  )
}

test "a reason is spaced in the line and joined in the document" {
  assert_eq(keyed(word(PreviousFailure)), "previous_failure");
  assert_eq(keyed(word(New)), "new");
  assert_eq(word(Changed("the file `a.ply`")), "changed");
  assert_eq(word(Unhashed), "unhashed")
}

test "`--explain` says why each test ran, once per reason, and how the groups formed" {
  let p = a_program([a_case(0, "one"), a_case(1, "two")]);
  let keys = [a_key(0, "one", false, false, false), a_key(1, "two", true, false, false)];
  let lines = explain_lines(plain(), p, [], a_decided(p, keys));
  assert(string_contains(at_or(lines, 1, ""), "run  abcdef012345 new "));
  assert(string_contains(at_or(lines, 1, ""), "isolation: region"));
  assert(string_contains(at_or(lines, 2, ""), "skip abcdef012345 cached "));
  assert(contains(lines, "   why"));
  assert(contains(lines, "   concurrency groups"));
  // One class, holding the one test that runs: a cached test shares a worker with nobody.
  assert(contains(lines, "     group 0 · 1 test · {}"));
  assert(contains(lines, "       one"))
}

// What `shipped` answers is the binary's, so a test reading it is cached across a change to it.
test "`--explain` says what a pass is filed under and what moved under a changed one" {
  let p = a_program([a_case(0, "one"), a_case(1, "two")]);
  let keys = [
    { ..a_key(0, "one", false, false, false), cached: Some(Moved("the file `a.ply` under `cwd`")) },
    a_key(1, "two", false, false, false),
  ];
  let lines = explain_lines(plain(), p, [], a_decided(p, keys));
  assert(string_contains(at_or(lines, 1, ""), " changed "));
  assert(string_contains(at_or(lines, 1, ""), " · moved: the file `a.ply` under `cwd`"));
  assert(!string_contains(at_or(lines, 2, ""), "moved"));
  assert(contains(lines, "   key"));
  assert(
    contains(
      lines,
      "     a pass is filed under its test's hash and the runtime stamp aabbccddeeff, and under the code the test ran, with what its run read",
    ),
  );
  let uncached = explain_lines(plain(), { ..p, filed_under: None }, [], a_decided(p, keys));
  assert(contains(uncached, "     no pass is filed: `--no-cache` reads and writes none"));
  let text = to_string(
    answered(plain(), from_argv("test", ["--json"]), p, a_run([], 0), [], a_decided(p, keys)).json,
  );
  assert(string_contains(text, "\"filed_under\":\"aabbccddeeff00112233\""));
  assert(string_contains(text, "\"moved\":\"the file `a.ply` under `cwd`\""))
}

test "the document keys off `command` and `exit_code` and names the schema it publishes" {
  let p = a_program([a_case(0, "one")]);
  let keys = [a_key(0, "one", false, false, false)];
  let text = to_string(
    answered(
      plain(),
      from_argv("test", ["--json"]),
      p,
      a_run([an_outcome(0, "one", "passed")], 0),
      [],
      a_decided(p, keys),
    ).json,
  );
  assert(string_contains(text, "\"command\":\"test\""));
  assert(string_contains(text, "\"exit_code\":0"));
  assert(string_contains(text, "\"schema_version\":6"));
  assert(string_contains(text, "\"binding\":\"hermetic\""));
  assert(string_contains(text, "\"root\":\"/p\""));
  assert(string_contains(text, "\"duration_ms\":1.5"));
  assert(string_contains(text, "\"reason\":\"new\""))
}

// The seed a test reads is handed to it alone, so it is no atom another test contends over.
test "a test's contended atoms are in the document unprinted, beside whether it is seeded" {
  let c = {
    ..a_case(0, "one"),
    atoms: [
      { atom: { effect: "cell", resource: "users", writes: true }, text: "cell.write[users]" },
      { atom: { effect: "sim", resource: "", writes: false }, text: "sim.read" },
    ],
    seeded: true,
  };
  let text = to_string(
    case_json(a_run([], 0), c, a_decided(a_program([c]), [a_key(0, "one", false, false, false)])),
  );
  assert(
    string_contains(
      text,
      "\"contends\":[{\"effect\":\"cell\",\"resource\":\"users\",\"writes\":true}]",
    ),
  );
  assert(string_contains(text, "\"seeded\":true"));
  assert(string_contains(text, "\"shared_atoms\":[\"cell.write[users]\"]"))
}

// Everything a reader or an agent needs to act on a failure is in its artifact: what failed, whether
// it is Ply's fault, how to replay it, where the race was, and the cause, led by the culprit.
test "a failure's artifact says what failed, how to replay it, and what caused it" {
  let p = a_program([a_case(0, "two is two")]);
  let site = { task: "t1", definition: Some("m.bump"), access: "write", at: None };
  let raced = {
    ..a_fault(),
    seed: Some("0:1.0"),
    replay: replay_of("0:1.0", "two is two"),
    race: Some({ left: site, right: { ..site, task: "t2" }, step: 3 }),
    suspects: [{ ..a_suspect("m.bump"), change: Some(Edited), culprit: true }],
  };
  let text = to_string(fault_json(p, raced));
  assert(string_contains(text, "\"key\":\"m.two is two\""));
  assert(string_contains(text, "\"name\":\"two is two\""));
  assert(string_contains(text, "\"defect\":false"));
  assert(string_contains(text, "\"module\":\"m\""));
  assert(string_contains(text, "\"status\":\"failed\""));
  assert(string_contains(text, "\"nondet\":false"));
  assert(string_contains(text, "\"replay\":\"ply test --seed 0:1.0 --filter 'two is two'\""));
  assert(string_contains(text, "\"at\":3"));
  assert(string_contains(text, "\"task\":\"t2\""));
  assert(string_contains(text, "\"change\":\"edited\""));
  assert(string_contains(text, "\"culprit\":true"));
  // A test that searched nothing has no seed, so nothing replays it and no race is named.
  let plain_fault = to_string(fault_json(p, a_fault()));
  assert(string_contains(plain_fault, "\"replay\":null"));
  assert(string_contains(plain_fault, "\"race\":null"))
}

test "a program with no tests at all says so, and one narrowed to none says that instead" {
  let empty = { ..a_program([]), declared: 0 };
  assert(
    contains(
      answered(plain(), from_argv("test", []), empty, a_run([], 0), [], a_decided(empty, [])).lines,
      "   no `test` items in this program",
    ),
  );
  let hidden = { ..a_program([]), declared: 3, filtered_out: 3 };
  assert(
    contains(
      answered(
        plain(),
        from_argv("test", ["--filter=none"]),
        hidden,
        a_run([], 0),
        [],
        a_decided(hidden, []),
      ).lines,
      "   no test key contains a `--filter` substring; nothing was verified",
    ),
  )
}

test "a suspect is named with what changed" {
  assert_eq(described(a_suspect("m.total")), "m.total");
  assert_eq(described({ ..a_suspect("m.total"), change: Some(Edited) }), "m.total (edited)")
}

test "the repro is a seed and the command that replays it" {
  let f = { ..a_fault(), seed: Some("0:0.1.0.2"), replay: replay_of("0:0.1.0.2", "two is two") };
  assert_eq(seed_lines(plain(), a_place(), f), [
    "  seed: 0:0.1.0.2",
    "  replay: ply test --seed 0:0.1.0.2 --filter 'two is two'",
  ])
}

test "a replay is one command whatever the test is called" {
  assert_eq(
    replay_of("0:1", "it's \"$HOME\" `now`"),
    Some("ply test --seed 0:1 --filter 'it'\\''s \"$HOME\" `now`'"),
  );
  assert_eq(replay_of("0:1", "plain"), Some("ply test --seed 0:1 --filter plain"));
  assert_eq(replay_of("0:1", "a\0b"), None)
}

test "a search says what it explored and what a blind and an unpruned one would have cost" {
  let e: Explored = {
    explored: 12,
    exhaustive: true,
    exhausted: false,
    blind: Some({ explored: 30, bounded: false, rendered: "30" }),
    naive: Some({ explored: 120, bounded: false, rendered: "120" }),
    reduction_tenths: Some(100),
    steps: 8,
    virtual_time_ns: 0,
    failing_seed: None,
  };
  assert_eq(
    join(search_parts(e), " · "),
    "12 interleavings · exhaustive · blind 30 · naive 120 · 10× reduction",
  );
  let doc = to_string(search_json(e));
  assert(string_contains(doc, "\"blind\":{\"bounded\":false,\"explored\":30,\"rendered\":\"30\"}"));
  assert(
    string_contains(doc, "\"naive\":{\"bounded\":false,\"explored\":120,\"rendered\":\"120\"}"),
  );
  let unmeasured = { ..e, blind: None, naive: None, reduction_tenths: None };
  assert_eq(join(search_parts(unmeasured), " · "), "12 interleavings · exhaustive");
  assert(string_contains(to_string(search_json(unmeasured)), "\"blind\":null"))
}

test "the simulation line counts the searches and says a spent budget out loud" {
  let quiet = a_run([], 0);
  assert_eq(simulation_line(plain(), quiet), []);
  let counted = {
    simulated: 3,
    total: 47,
    seeds: 3,
    interleavings: 61,
    exhaustive: 3,
    exhausted: 0,
    failed: 0,
  };
  assert_eq(simulation_line(plain(), { ..quiet, simulation: counted }), [
    indent() ++ "simulated: 3 of 47 · 61 interleavings · 3 exhaustive",
  ]);
  let spent = {
    ..counted,
    simulated: 1,
    total: 1,
    interleavings: 256,
    exhaustive: 0,
    exhausted: 1,
  };
  assert_eq(simulation_line(plain(), { ..quiet, simulation: spent }), [
    indent() ++ "simulated: 1 of 1 · 256 interleavings · 1 budget spent, not cached",
  ])
}

test "a phase reading is two decimals of a millisecond, longest phase first" {
  assert_eq(phase_lines(plain(), { ..no_phases(), read_us: 2000, front_us: 98000 }), [
    "",
    "   front-end time",
    "     front          98.00ms  98.0%",
    "     read            2.00ms   2.0%",
    "     write back      0.00ms   0.0%",
    "     total         100.00ms",
  ])
}

test "a run's time is its load and every phase after it, longest first" {
  let load = { ..no_phases(), front_us: 2000 };
  let spent = { ..no_spent(), before_us: 1000, handoff_us: 5000, tests_us: 2000 };
  assert_eq(run_total(load, spent), 10000);
  assert_eq(run_phase_lines(plain(), load, spent), [
    "",
    "   run time",
    "     handoff         5.00ms  50.0%",
    "     load            2.00ms  20.0%",
    "     tests           2.00ms  20.0%",
    "     before          1.00ms  10.0%",
    "     promises        0.00ms   0.0%",
    "     store           0.00ms   0.0%",
    "     selection       0.00ms   0.0%",
    "     unit            0.00ms   0.0%",
    "     bind            0.00ms   0.0%",
    "     conclude        0.00ms   0.0%",
    "     total          10.00ms",
  ])
}

// A socket lives outside every region, so a test the binding can reach is neither isolated nor
// cached, whatever its footprint says.
test "a test the binding can reach is host rather than isolated" {
  let c = a_case(0, "one");
  let hermetic = a_run([], 0);
  assert_eq(isolated_as(hermetic.reaches, c), "region");
  assert_eq(isolated_as([0], c), "host");
  // A test is shared exactly when one of the atoms the row carries can be contended over, and a
  // seed it reads is not one of them.
  let fs_write = {
    atom: { effect: "fs", resource: "/tmp/x", writes: true },
    text: "fs.write[/tmp/x]",
  };
  let seed = { atom: { effect: "sim", resource: "", writes: false }, text: "sim.read" };
  assert_eq(isolated_as(hermetic.reaches, { ..c, atoms: [seed] }), "region");
  assert_eq(isolated_as(hermetic.reaches, { ..c, atoms: [seed, fs_write] }), "shared");
  assert_eq(shared_of({ ..c, atoms: [seed, fs_write] }), "{fs.write[/tmp/x]}")
}

// Contention a rename would remove is what losing the fork costs, so `--explain` names it, and a
// test that also reaches a real resource is not blamed on its label.
test "`--explain` names and counts the tests that contend only over a region label" {
  let cell = |label: String|
    {
      atom: { effect: "cell", resource: label, writes: true },
      text: "cell.write[" ++ label ++ "]",
    };
  let ledger = {
    atom: { effect: "db", resource: "ledger", writes: true },
    text: "db.write[ledger]",
  };
  let labelled = { ..a_case(0, "one"), atoms: [cell("users")] };
  let mixed = { ..a_case(1, "two"), atoms: [cell("orders"), ledger] };
  assert_eq(explain_atoms("shared", labelled), " {cell.write[users]} (region labels)");
  assert_eq(explain_atoms("shared", mixed), " {cell.write[orders], db.write[ledger]}");
  assert_eq(explain_atoms("region", a_case(2, "three")), "");
  let p = a_program([labelled, mixed, a_case(2, "three")]);
  let keys = [
    a_key(0, "one", false, false, false),
    a_key(1, "two", false, false, false),
    a_key(2, "three", false, false, false),
  ];
  let r = a_run([], 0);
  assert_eq(
    group_tally(plain(), counts_of(p, r.reaches), a_decided(p, keys)),
    indent()
      ++ "  1 of 3 region-isolated and free · 1 group for the 2 shared tests · 1 of them only over a region label",
  )
}

// Only a run that re-runs every test whatever the cache held needs classes over all of them.
test "classes over every test are coloured only for a mutation" {
  let cell = |label: String|
    {
      atom: { effect: "cell", resource: label, writes: true },
      text: "cell.write[" ++ label ++ "]",
    };
  let p = a_program([
    { ..a_case(0, "one"), atoms: [cell("a")] },
    { ..a_case(1, "two"), atoms: [cell("a")] },
    a_case(2, "three"),
  ]);
  let options = options_from(parsed(["test"]), "/p");
  assert_eq(every_of(p, options), []);
  assert_eq(every_of(p, { ..options, mutate: Some("*") }), [[0, 2], [1]])
}

test "a bound run says how many tests reach the host and what it bound, and after the run what it shook hands on" {
  let o = { ..an_opening(), hermetic: false, operations: 7, digest: "b3:aabbccddeeff" };
  let c = { total: 3, isolated: 1, shared: 0, host: 2 };
  assert_eq(binding_lines(plain(), o, c), [
    "   host 2 of 3 · cached by what each read",
    "   binding host · 7 operations · b3:aabbccddeeff",
  ]);
  assert_eq(binding_lines(plain(), an_opening(), c), []);
  let bound = {
    ..a_run([], 0),
    hermetic: false,
    handshakes: ["handshakes: 1 completed, 0 refused"],
  };
  assert_eq(handshake_lines(plain(), bound), ["   handshakes: 1 completed, 0 refused"]);
  assert_eq(handshake_lines(plain(), a_run([], 0)), [])
}

test "a label is bare in a single-module run and qualified across several" {
  let one = a_program([a_case(0, "same")]);
  let c = at_or(one.cases, 0, a_case(0, ""));
  assert_eq(display_of(one, c), "same");
  let two = {
    ..one,
    modules: [{ name: "alpha", file: "alpha.ply" }, { name: "beta", file: "beta.ply" }],
  };
  assert_eq(display_of(two, c), "m.same")
}

// A deadlock's cycle lives only in its secondary labels, so each is printed where it points.

test "a failure's other labels are printed under it, each with its own place" {
  let d = error_with_labels(
    b"E0414",
    b"these tasks are deadlocked",
    [
      { module: 0, start: 0, end: 4, primary: true, text: b"here" },
      { module: 0, start: 5, end: 16, primary: false, text: b"waits on `b`" },
    ],
    [],
  );
  assert_eq(at_lines(plain(), a_place(), d), ["    at m.ply:1:1"]);
  assert_eq(secondary_lines(plain(), a_place(), d), ["    waits on `b`   m.ply:1:6"])
}

test "a bounded naive count makes the ratio a lower bound" {
  let e: Explored = {
    explored: 12,
    exhaustive: false,
    exhausted: false,
    blind: Some({ explored: 40, bounded: false, rendered: "40" }),
    naive: Some({ explored: 4096, bounded: true, rendered: ">= 4096" }),
    reduction_tenths: Some(3413),
    steps: 8,
    virtual_time_ns: 0,
    failing_seed: None,
  };
  assert_eq(
    join(search_parts(e), " · "),
    "12 interleavings · blind 40 · naive >= 4096 · >= 341× reduction",
  )
}

test "every reason has an explanation of its own" {
  let lines = map(
    map([New, Changed(""), PreviousFailure, Cached, SameCode, Unhashed], |r: Reason| word(r)),
    why,
  );
  assert_eq(
    len(
      filter(range(0, 6), |i: Int|
        len(filter(range(0, 6), |j: Int| at_or(lines, i, "") == at_or(lines, j, ""))) == 1),
    ),
    6,
  )
}

test "a load that refuses tallies its errors and binds nothing" {
  let answer = refused(plain(), "test", [error_with_labels(b"E0201", b"type mismatch", [], [])], [
  ]);
  assert_eq(answer.code, 2);
  assert_eq(answer.errs, ["Error[E0201]: type mismatch", "   compilation failed (1 error)"])
}

test "a binding that does not match the program is a start-up failure naming no line" {
  let answer = unbound(plain(), {
    diags: [error_with_labels(b"E0412", b"a nondet effect in a det test", [], [])],
    places: [],
  });
  assert_eq(answer.code, 2);
  assert_eq(answer.errs, [
    "Error[E0412]: a nondet effect in a det test",
    "   no host handler was bound (1 error)",
  ])
}

test "a seeded test searches the roots it still owes, and any other runs once" {
  let p = a_program([a_case(0, "plain"), { ..a_case(1, "seeded"), seeded: true }]);
  let searching = plan::random(4);
  assert_eq(job_of(p, 0, 0, [], searching), {
    unit: 0,
    test: 0,
    entry: entry_of(0, "m.plain"),
    search: None,
  });
  assert_eq(job_of(p, 0, 1, [], searching).search, Some(searching));
  assert_eq(job_of(p, 2, 1, [{ index: 1, roots: [2, 3] }], searching), {
    unit: 2,
    test: 1,
    entry: entry_of(1, "m.seeded"),
    search: Some({ ..searching, roots: [2u64, 3u64] }),
  })
}

test "the search a seeded test is keyed on is the plan the flags name, and the document says it" {
  let p = machine::sim_plan_of({
    ..machine::no_sim_options(),
    mode: "random",
    roots: Some({ from: 0, to: 3 }),
  });
  assert_eq(search_of(p), { mode: "random", roots: [0, 1, 2], budget: 1, steps: 100000, path: [] });
  let seeded = { ..machine::no_sim_options(), seed: Some("0x10:2") };
  let doc = to_string(with_sim(object([]), sim_json(machine::sim_plan_of(seeded), seeded)));
  assert(string_contains(doc, "\"seed\":\"16:2\""));
  assert(string_contains(doc, "\"mode\":\"once\""));
  assert(string_contains(doc, "\"roots\":[16]"))
}

// --- Footprints over real programs --------------------------------------------

fn analysed_as(name: String, src: String) -> Analysis / {abort.raise} =
  match analyse(parse_all([{ name: bytes_of_string(name), src: bytes_of_string(src) }])) {
    Analysed(w) -> w,
    Refused(_) -> panic("the fixture checks"),
  }

fn compiled(src: String) -> Analysis / {abort.raise} = analysed_as("", src)

fn cases_of_whole(analysis: Analysis) -> List<Case> / {abort.raise} =
  fold(range(0, len(analysis.checked.tests)), [], |acc: List<Case>, i: Int|
    match test_at(analysis, i) { Some(t) -> push(acc, case_view(analysis, i, t)), None -> acc })

/// The classes every test of a program is coloured into, as a run that executes them all colours them.
fn coloured(analysis: Analysis) -> List<List<Int>> / {abort.raise} = {
  let cases = cases_of_whole(analysis);
  classes_of(a_program(cases), map(cases, |case: Case| case.index))
}

fn texts_of_case(analysis: Analysis, i: Int) -> List<String> / {abort.raise} =
  match list_at(cases_of_whole(analysis), i) {
    Some(c) -> map(c.atoms, |printed: Printed| printed.text),
    None -> [],
  }

fn a_store() -> String =
  "effect store {\n  read  all[r]() -> Int\n  write save[r](n: Int) -> Unit\n}\n"

fn precise() -> String =
  a_store()
    ++ "fn list_items() -> Int / {store.read[items]} = store.all[items]()\nfn place_order() -> Int / {store.write[orders]} { store.save[orders](1); 2 }\ntest \"items\" { assert_eq(list_items(), 0) }\ntest \"orders\" { assert_eq(place_order(), 2) }\n"

fn aliased() -> String =
  a_store()
    ++ "effect set Desk = {store.read[items], store.write[orders]}\nfn list_items() -> Int / {Desk} = store.all[items]()\nfn place_order() -> Int / {Desk} { store.save[orders](1); 2 }\ntest \"items\" { assert_eq(list_items(), 0) }\ntest \"orders\" { assert_eq(place_order(), 2) }\n"

test "precise rows leave two endpoints nothing to contend over, and one broad set serialises them" {
  assert_eq(coloured(compiled(precise())), [[0, 1]]);
  assert_eq(coloured(compiled(aliased())), [[0], [1]])
}

test "the atoms that serialise them are the set's expansion, and an alias only ever widens" {
  let broad = texts_of_case(compiled(aliased()), 0);
  let narrow = texts_of_case(compiled(precise()), 0);
  assert(len(filter(broad, |t: String| string_ends_with(t, "store.write[orders]"))) > 0);
  assert(len(filter(broad, |t: String| string_contains(t, "Desk"))) == 0);
  assert(len(filter(narrow, |t: String| string_ends_with(t, "store.write[orders]"))) == 0);
  assert(fold(narrow, true, |ok: Bool, t: String| ok && contains(broad, t)))
}

fn cell_test(label: String, i: Int) -> String =
  "test \"contender " ++ label ++ " " ++ int_to_string(i) ++ "\" { let seen = with_cell[" ++ label
    ++ "]("
    ++ int_to_string(i)
    ++ ") { c -> { cell_set(c, cell_get(c) * 7); cell_get(c) } }; assert_eq(touches_"
    ++ label
    ++ "(seen), "
    ++ int_to_string(i * 7)
    ++ ") }\n"

fn toucher(label: String) -> String =
  "fn touches_" ++ label ++ "(n: Int) -> Int / {cell.read[" ++ label ++ "], cell.write[" ++ label
    ++ "]} = n\n"

test "tests naming one region label all conflict, and tests on distinct labels never do" {
  let one = fold(range(0, 3), toucher("table"), |acc: String, i: Int| acc ++ cell_test("table", i));
  assert_eq(coloured(compiled(one)), [[0], [1], [2]]);
  let apart = fold(range(0, 3), "", |acc: String, i: Int| {
    let label = "table" ++ int_to_string(i);
    acc ++ toucher(label) ++ cell_test(label, i)
  });
  assert_eq(coloured(compiled(apart)), [[0, 1, 2]])
}

test "an effect whose name merely resembles a region's names a real resource" {
  let w = compiled(
    "effect cells {\n  write put[rows](v: Int) -> Unit\n}\ntest \"one\" { cells.put[rows](1) }\ntest \"two\" { cells.put[rows](2) }\n",
  );
  assert_eq(texts_of_case(w, 0), ["cells.put[rows]"]);
  assert_eq(coloured(w), [[0], [1]])
}

test "a region label beside a real write does not launder the write" {
  let w = compiled(
    "effect db {\n  read  get[users]() -> Int\n  write put[users](v: Int) -> Unit\n}\nfn touches(n: Int) -> Int / {cell.read[table]} = n\ntest \"cell only\" { let seen = with_cell[table](1) { c -> cell_get(c) }; assert_eq(touches(seen), 1) }\ntest \"cell and a real write\" { let seen = with_cell[table](1) { c -> cell_get(c) }; db.put[users](touches(seen)) }\ntest \"a real read\" { assert_eq(db.get[users](), 0) }\n",
  );
  assert_eq(texts_of_case(w, 1), ["cell.read[table]", "db.put[users]"]);
  // Two readers of one region label share a worker; a writer and a reader of `users` do not.
  assert_eq(coloured(w), [[0, 1], [2]])
}

test "a test whose regions discharge their cells contends over nothing" {
  let w = compiled(
    "test \"users cell\" { with_cell[users](1) { c -> assert_eq(cell_get(c), 1) } }\ntest \"orders cell\" { with_cell[orders](2) { c -> assert_eq(cell_get(c), 2) } }\ntest \"pure\" { assert_eq(1, 1) }\n",
  );
  assert_eq(map(cases_of_whole(w), |case: Case| case.footprint), ["{}", "{}", "{}"]);
  assert_eq(coloured(w), [[0, 1, 2]])
}

test "a program cannot declare either effect the scheduler reads a name of" {
  let refused = |name: String|
    match analyse(
        parse_all([
          {
            name: b"",
            src: bytes_of_string(
              "effect " ++ name ++ " {\n  write put[users](v: Int) -> Unit\n}\ntest \"claim\" { "
                ++ name
                ++ ".put[users](1) }\n",
            ),
          },
        ]),
      ) {
      Analysed(_) -> false,
      Refused(_) -> true,
    };
  assert(refused("cell"));
  assert(refused("sim"))
}

test "a test that reads a seed is searched, and one that does not runs once" {
  let w = compiled(
    "test \"once\" { assert_eq(1, 1) }\ntest \"searched\" { let n = simulate { task.join(task.spawn(|| 1)) }; assert_eq(n, 1) }\n",
  );
  assert_eq(map(cases_of_whole(w), |case: Case| case.seeded), [false, true]);
  assert_eq(map(rows_of(w), |row: Row| row.seeded), [false, true])
}

test "a run reports on the tests `--filter` keeps, and counts the ones it hid" {
  let w = analysed_as(
    "m",
    "test \"alpha\" { assert_eq(1, 1) }\ntest \"beta\" { assert_eq(2, 2) }\ntest \"gamma\" { assert_eq(3, 3) }\n",
  );
  let options = options_from(parsed(["test", "--filter", "alpha"]), "/p");
  let scope = scope_of(w, options);
  assert_eq(scope.visible, [0]);
  assert_eq(scope.filtered_out, 2);
  assert_eq(scope.out, []);
  let either = options_from(parsed(["test", "--filter", "m.gam", "--filter", "alpha"]), "/p");
  assert_eq(scope_of(w, either).visible, [0, 2]);
  assert_eq(scope_of(w, options_from(parsed(["test"]), "/p")).visible, [0, 1, 2])
}

// --- What a search's cost reads as --------------------------------------------

test "a bounded count renders as a lower bound, and a reduction needs the naive search" {
  assert_eq(
    cost_of(Some({ explored: 4096, bounded: true })),
    Some({ explored: 4096, bounded: true, rendered: ">= 4096" }),
  );
  assert_eq(cost_of(None), None);
  let e: Exploration = {
    explored: 12,
    exhaustive: true,
    exhausted: false,
    naive: None,
    blind: None,
    steps: 8,
    virtual_time: 0,
    failure: None,
    race: None,
  };
  assert_eq(tenths_of(e), None);
  assert_eq(tenths_of({ ..e, naive: Some({ explored: 120, bounded: false }) }), Some(100));
  // Rounded half up to a tenth: 40 / 12 is 3.33.
  assert_eq(tenths_of({ ..e, naive: Some({ explored: 40, bounded: false }) }), Some(33));
  assert_eq(tenths_of({ ..e, explored: 0, naive: Some({ explored: 40, bounded: false }) }), None);
  assert_eq(
    explored_of({ ..e, failure: Some({ root: 7u64, path: [1, 0] }) }).failing_seed,
    Some("7:1.0"),
  )
}

// --- What a watching run stamps -----------------------------------------------

test "a tree stamps one line per `.ply` file, and a walk that fails stamps nothing" {
  let tree = mem_of([
    { path: "m.ply", body: b"fn m() -> Int = 1" },
    { path: "notes.txt", body: b"x" },
    { path: "sub/deep.ply", body: b"fn d() -> Int = 2" },
  ]);
  let walked = |rs: List<paths::Resolved>|
    handle {
      stamped(rs)
    } with {
      fs.kind[cwd](p) -> mem_kind(tree, p),
      fs.kind[abs](p) -> panic("nothing here leaves the working directory"),
      fs.list_dir[cwd](p) -> mem_list(tree, p),
      fs.list_dir[abs](p) -> panic("nothing here leaves the working directory"),
      fs.modified_ms[cwd](p) -> mem_modified(tree, p),
      fs.modified_ms[abs](p) -> panic("nothing here leaves the working directory"),
      fs.file_size[cwd](p) -> mem_size(tree, p),
      fs.file_size[abs](p) -> panic("nothing here leaves the working directory"),
    };
  match walked([paths::here()]) {
    Some(lines) -> {
      assert_eq(len(lines), 2);
      assert(string_starts_with(at_or(lines, 0, ""), "m.ply "));
      assert(string_ends_with(at_or(lines, 0, ""), " 17"));
      assert(string_starts_with(at_or(lines, 1, ""), "sub/deep.ply "))
    },
    None -> panic("a readable tree stamps"),
  };
  assert_eq(walked([paths::at_cwd("gone")]), None)
}

/// A program with a test over cases, over stand-ins for the two shipped modules its item reads
/// through.
fn ranging() -> Analysis / {abort.raise} =
  match analyse_pulling_std_with(
      [
        {
          name: b"m",
          src: b"fn table() -> List<Int> = [1, 2]\nfn held(n: Int) -> Bool = n > 0\ntest \"plain\" { assert(held(1)) }\ntest \"holds {n}\" for n: Int in table() { assert(held(n)) }\n",
        },
      ],
      [
        {
          name: b"std.cases",
          src: b"pub type Table<a> = List<a>\npub fn listed<a | e>(t: List<a>, l: (a) -> String / e) -> List<{ label: String, identity: Bytes }> / e where derivable(hash, a) = map(t, |c: a| { label: l(c), identity: b\"\" })\npub fn chosen<a>(t: List<a>, at: Int, d: Bytes) -> a / {abort.raise} where derivable(hash, a) = panic(\"\")\n",
        },
        { name: b"std.show", src: b"pub fn display<a>(x: a) -> String = \"\"\n" },
      ],
      [],
      [],
    ).out {
    Analysed(w) -> w,
    Refused(_) -> panic("the fixture checks"),
  }

test "a case is a test of its own: its label names it, its test's hash and its identity key it, and it runs no table" {
  let whole = ranging();
  let over = ranged(
    whole,
    map_insert(
      map_new(),
      1,
      Ok([{ label: "holds 1", identity: b"one" }, { label: "holds 2", identity: b"two" }]),
    ),
  );
  assert_eq(map(over.analysis.checked.tests, |t: TestInfo| t.key), [
    b"m.plain",
    b"m.holds 1",
    b"m.holds 2",
  ]);
  assert_eq(map(over.analysis.checked.tests, |t: TestInfo| t.index), [0, 1, 2]);
  assert_eq(map(over.entries, |e: Entry| e.test), [0, 1, 1]);
  assert_eq(map(over.entries, |e: Entry| e.of), ["m.plain", "m.holds {n}", "m.holds {n}"]);
  assert_eq(map(over.entries, |e: Entry| e.case), [
    None,
    Some({ at: 0, identity: b"one" }),
    Some({ at: 1, identity: b"two" }),
  ]);
  let hashes = over.analysis.hashes.tests;
  assert_eq(list_at(hashes, 0), list_at(whole.hashes.tests, 0));
  assert_eq(list_at(hashes, 1), Some(case_hash(at_or(whole.hashes.tests, 1, b""), b"one")));
  assert(list_at(hashes, 1) != list_at(hashes, 2), None);
  // A case reaches its table where a definition is covered, and not where a failure is suspected.
  let reached = |a: Analysis| map_keys(reach(a.hashes, [TheItem(b"m.holds 1")]).fns);
  assert(
    contains(reached(over.analysis), b"m.table") && contains(reached(over.analysis), b"m.held"),
  );
  assert(!contains(reached(over.judged), b"m.table") && contains(reached(over.judged), b"m.held"))
}

test "a test whose cases could not be listed stays one test, and ends as the listing did" {
  let whole = ranging();
  let why = {
    status: "failed",
    failure: { diag: diag_of("error", "E0502", "division by zero", [], []), values: [] },
  };
  let over = ranged(whole, map_insert(map_new(), 1, Err(why)));
  assert_eq(map(over.analysis.checked.tests, |t: TestInfo| t.key), [b"m.plain", b"m.holds {n}"]);
  assert_eq(over.analysis.hashes.tests, whole.hashes.tests);
  let p = a_program(
    map(cases_of_whole(over.analysis), |case: Case|
      { ..case, entry: at_or(over.entries, case.index, case.entry) }),
  );
  let ended = handle {
    ran_job(job_of(p, 0, 1, [], plan::random(1)), false)
  } with {
    tester.executed[corpus](unit, index, case) -> panic("a test with no cases was run"),
    tester.interleaved[corpus](unit, index, case, seed, steps, again) ->
      panic("a test with no cases was searched"),
  };
  assert_eq(ended.status, "failed");
  assert_eq(ended.failure, Some(why.failure));
  // A program with no test over cases in scope is asked for nothing, and is itself.
  assert_eq(ranged(whole, map_new()).entries, [entry_of(0, "m.plain"), entry_of(1, "m.holds {n}")])
}
