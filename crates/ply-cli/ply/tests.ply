// `ply test` — which tests this run had to execute, what each of them did, and what the run
// exits with. The load, the store, the compiled backend, the host binding, the worker pool, the
// per-test unwind catching and the building of a mixture are the Rust side's: a front end is not a
// value a program can hold, a Rust unwind is not a Ply value, and the store's on-disk format has one
// reader. Which tests run, the keys each result is read and filed under, the classes they share and
// why a failure happened are decided here, from what the runtime answers, along with everything
// said about all of it, in both forms, and the code it exits with.

import args (Flags, from_argv, style_of)
import builder (builder)
import cache (store, Front)
import std.fs (fs)
import std.time (time)
import cmdline
import cmdline (Parsed, Run, has, parse, value, values_of)
import config_schema
import surface
import machine
import compiler.resolve (Diag, Label)
import diagnostic (Place, Raised, Spot, shown, spot_of, all_to_json, all_to_text)
import entry (At, no_module)
import program (Timed, front_of, is_shelved, modules_of, timed_load, timed_uncached)
import report (Answer, ind, ok_code, compile_error, count_of, plural, refused, warned_lines)
import std.json (Json, Object, Null, Str, Bool, Number, Array, Member, object, to_string)
import style (Style, plain, bold, dim, green, red, yellow)
// What a test's footprint makes it — shared, isolated or host — and the classes the tests that run
// share are the suite's, from the atoms each row carries and the tests the binding reaches.
import suite.schedule (Atom, Counts, contends_only_over_regions, counts, group_by_conflict,
                       isolation_of, isolation_word, parallelism, shared)
// The keys a mixture's result is filed under are the suite's, like every other test result's.
import suite.keys (mixture_key)
// What decides a cause: the change set, the search over it, and the verdict it reaches.
import suite.bisect (Auto, Bisection, Budget, Mode, NoBodies, NotAttempted, NotRequested,
                     SearchStats, Skipped, Trial, a_failure, a_pass, confidence_word, is_conclusive,
                     mode_parse, skipped_word, verdict_skipped, verdict_word)
import suite.delta (Delta, DefKey, Edited, Facts, Value, classified, flipped_keys, kind_word,
                    ns_word)
import suite.diagnose (Attribution, Evidence, Suspect, diagnose)
import suite.select
import suite.select (Cached, Decision, New, Nondet, PreviousFailure, Reason, Row, Search, Unhashed,
                     answers_per_root, decide, digest_of, filed, key_of, narrowed, owed_roots,
                     seed_keys, to_run, word)
import std.bytes (bytes_of_hex, hex_of)
import sim.plan
import sim.plan (Seed)
import sim.recording (Interleaving)
import sim.search
import sim.search (Exploration, Failure)

// What the Rust side loads, binds and runs, in that order and each once per report. A run that
// refuses at either of the first two ran nothing, which is why binding and running are two
// operations rather than one. `stamped` is the tree as a walk finds it now, which is how a
// watching run decides there is another report to write; the walk is the host's and the deciding
// is not. It answers `None` when a directory would not be read, which a watcher must not read as
// a tree that has not moved.
// The front end this run is against, as the machine reads it: the compiler's answer, every source
// it names in the order their ids run, the package roots the store files a dependency's sources
// under, and what this side's own load cost. `ply test` walks the tree and runs the compiler in
// order to report on both, so it hands the answer over rather than letting the machine repeat it.
// What the test run is configured with: the report flags, the machine's budgets and bounds, and
// the host it may bind — the program parses the line and hands the record over.
pub type Options = {
  path: String,
  json: Bool,
  explain: Bool,
  no_cache: Bool,
  filters: List<String>,
  jobs: Option<Int>,
  steps: Int,
  timeout: Int,
  bisect: String,
  bisect_budget: Int,
  coverage: Bool,
  mutate: Option<String>,
  mutate_budget: Int,
  profile: String,
  watch: Bool,
  std: Bool,
  host: Bool,
  tls: List<machine::TlsCred>,
  trust: List<String>,
  fs: List<machine::Named>,
  // The programs a test's `process.spawn` may start, and the families the tests are lent.
  exec: List<machine::Named>,
  allow: List<String>,
  config: machine::ConfigOpts,
  sim: machine::SimOpts,
}

// One atom of a test's footprint, as a scheduler compares them and as the printer spells it.
pub type Printed = { atom: Atom, text: String }

pub nondet effect tester {
  write configure[corpus](options: Options, front: Front) -> Unit
  read loaded[r]() -> Result<Program, Refusal>
  read bound[r]() -> Result<Unit, Refusal>
  read stamped[r]() -> Option<List<String>>
  // What a selector computes a selection from, before anything runs: each test's own hash and the
  // definitions' hashes.
  read keys[r]() -> List<Row>
  read hashed[r]() -> List<Hashed>
  // The printed union of a set of tests' footprints. The program colours the graph; rendering a
  // colour is the compiler's, since only its printer can keep a label variable off a name.
  read footprint[r](tests: List<Int>) -> String
  // What the store holds under each of these keys. Every key is the program's: this is the only
  // side that encodes one.
  read outcomes[r](keys: List<String>) -> List<Option<String>>
  // What the program decided to run: which tests, the classes they share, the reason for every
  // test, and the keys each pass is filed under. Stated before the binding, because whether a unit
  // has to be built at all is a function of it.
  write chosen[r](choice: Choice) -> Unit
  // The run begins. A test runs in a unit, on whichever thread asks: unit 0 is the loaded program,
  // and each mutant `mutant` builds is another.
  write started[r]() -> Unit
  // One test run once, and how it ended: `passed`, `failed`, `panicked` or `abandoned`.
  read executed[r](unit: Int, index: Int) -> String
  // One interleaving of a seeded test, the one `seed` names, as the runtime recorded it.
  read interleaved[r](unit: Int, index: Int, seed: Seed, steps: Int, re_executed: Bool) -> Interleaving<Fell>
  // What the run came to, filed under the keys the program named, given how its searches settled
  // each seeded test.
  write concluded[r](searched: List<Settled>) -> Ran
  // The mutants of the `--mutate` targets that some test reaches, cheapest first.
  read mutated[r]() -> Queue
  // The unit a mutant's tests run in, or the verdict a mutant that does not build already is.
  write mutant[r](id: Int) -> Result<Int, Judgement>
  // What the program judged each mutant it ran, and whether its budget stopped it short.
  write mutation[r](judged: List<Judged>, budget_spent: Bool) -> Mutants
  // One mixture of one failure: a set of definitions to take from the post-edit side, and the key
  // its pass is filed under, which a pass already there answers without building anything.
  read trial[r](failure: Int, keys: List<{ name: String, ns: String }>, filed: Option<String>) -> Trial
  // Writes what the mixtures proved since the run, whose own write came before them, and answers
  // what storing it had to say.
  write record[r]() -> List<Diag>
}

// One run's decision, as the runtime reads it back.
pub type Choice = {
  // Test indices to execute, ascending.
  runs: List<Int>,
  // The reason for every test the keys row named, indexed by test index.
  reasons: List<String>,
  // Concurrency classes over `runs`.
  groups: List<List<Int>>,
  // Every key each running test's pass is filed under.
  filed: List<{ index: Int, keys: List<String> }>,
}

// A failed run whose diagnostic the runtime holds, by its id, and how a report classes it.
pub type Fell = { id: Int, status: String }

// How the program's search settled one seeded test: what it explored, why it stopped at a failure,
// and how many roots it started from.
pub type Settled = {
  test: Int,
  exploration: Exploration,
  failure: Option<Failure<Fell>>,
  seeds: Int,
}

// Each mutant beside the tests that reach it, and why there are none when the query no longer names
// a definition.
pub type Queue = { mutants: List<Queued>, refused: List<Diag> }

pub type Queued = { id: Int, tests: List<Int> }

// A mutant's verdict: `killed`, `survived`, `skipped` or `unresolved`, and why when it is either of
// the last two.
pub type Judgement = { verdict: String, why: String }

pub type Judged = { id: Int, verdict: String, why: String }

// One definition or test the loaded tree declares, and its hash.
pub type Hashed = { name: String, hash: String, test: Bool }

// --- What the Rust side answers with ----------------------------------------

// The options record, built from the parsed line.
pub fn options_from(p: Parsed, root: String) -> Options = {
  let machine_options = machine::options_from(p);
  {
    path: root,
    json: has(p, "json"),
    explain: has(p, "explain"),
    no_cache: has(p, "no-cache"),
    filters: values_of(p, "filter"),
    jobs: match value(p, "jobs") { Some(v) -> cmdline::parse_nat(v), None -> None },
    steps: match value(p, "steps") {
      Some(v) -> match cmdline::parse_nat(v) { Some(n) -> n, None -> 0 },
      None -> 1000000000,
    },
    timeout: match value(p, "timeout") {
      Some(v) -> match cmdline::parse_nat(v) { Some(n) -> n, None -> 0 },
      None -> 60000,
    },
    bisect: match value(p, "bisect") { Some(v) -> v, None -> "auto" },
    bisect_budget: match value(p, "bisect-budget") {
      Some(v) -> match cmdline::parse_nat(v) { Some(n) -> n, None -> 0 },
      None -> 64,
    },
    coverage: has(p, "coverage"),
    mutate: value(p, "mutate"),
    mutate_budget: match value(p, "mutate-budget") {
      Some(v) -> match cmdline::parse_nat(v) { Some(n) -> n, None -> 0 },
      None -> 64,
    },
    profile: machine_options.profile,
    watch: has(p, "watch"),
    std: has(p, "std"),
    host: machine_options.host,
    tls: machine_options.tls,
    trust: machine_options.trust,
    fs: machine_options.fs,
    exec: machine_options.exec,
    allow: machine_options.allow,
    config: machine_options.config,
    sim: machine::sim_options_from(p),
  }
}

pub type Refusal = { diags: List<Diag>, places: List<Place> }

// Whole microseconds, as the clock the runner reads counts them: every reading in both forms is
// printed from the same integer, so a line and its document cannot disagree by a rounding.
pub type Phases = { read_us: Int, front_us: Int, write_back_us: Int }

pub type ModuleView = { name: String, file: String }

// One test still in scope, and what the store said about it. `test` is a reserved word, so a
// single one of them is a case.
pub type Case = {
  index: Int,
  key: String,
  name: String,
  module: String,
  nondet: Bool,
  // `None` when the front end produced no hash, which is what `unhashed` means.
  hash: Option<String>,
  footprint: String,
  // Every atom of the footprint: which of them another test could contend over is the suite's.
  atoms: List<Printed>,
  // Something in its closure entered a `simulate` region, so it is searched and keyed on the plan.
  seeded: Bool,
}

// What the program decided about a run: the reason for each test, the roots a seeded one still owes,
// which tests run, the classes they share, and the summary over them. The report reads all of it
// from here rather than from the runtime, which no longer decides any of it.
pub type Decided = {
  // The search every seeded test is keyed on, and the options document's account of it.
  search: Search,
  sim: Json,
  reasons: List<{ index: Int, reason: Reason }>,
  owed: List<{ index: Int, owed: Int }>,
  runs: List<Int>,
  /// Which class each running test landed in.
  at: List<{ index: Int, group: Int }>,
  classes: List<Group>,
  parallelism: Parallelism,
}

fn reason_of(d: Decided, index: Int) -> Reason =
  match filter(d.reasons, |e: { index: Int, reason: Reason }| e.index == index) {
    [] -> Cached,
    hits -> at(hits, 0, { index: index, reason: Cached }).reason,
  }

fn runs_test(d: Decided, index: Int) -> Bool = contains_int(d.runs, index)

fn contains_int(xs: List<Int>, x: Int) -> Bool =
  fold(xs, false, |found: Bool, y: Int| found || y == x)

// The same over the tests this run reports on, which `--filter` may have narrowed.
fn selected_count(p: Program, d: Decided) -> Int =
  len(filter(p.cases, |c: Case| contains_int(d.runs, c.index)))

fn cached_count(p: Program, d: Decided) -> Int = len(p.cases) - selected_count(p, d)

// What the program decided about the conflict graph: the classes it coloured, the summary over
// them, and which class each test landed in — which is only the tests that run, since a class is
// what a test *shares a worker* with.
fn group_of(d: Decided, index: Int) -> Option<Int> =
  match filter(d.at, |e: { index: Int, group: Int }| e.index == index) {
    [] -> None,
    hits -> Some(at(hits, 0, { index: index, group: 0 }).group),
  }

fn owed_of(d: Decided, index: Int) -> Int =
  match filter(d.owed, |e: { index: Int, owed: Int }| e.index == index) {
    [] -> 0,
    hits -> at(hits, 0, { index: index, owed: 0 }).owed,
  }

// One class's rendering is the printer's, so it is asked for rather than assembled.
fn with_footprint(acc: List<Group>, class: List<Int>) -> List<Group> / {tester.footprint[corpus]} =
  push(acc, { tests: class, footprint: tester.footprint[corpus](class) })

// The footprint's atoms, unprinted.
fn atoms_of(c: Case) -> List<Atom> = map(c.atoms, |x: Printed| x.atom)

// The atoms another test could contend over, printed.
fn shared_texts(c: Case) -> List<String> =
  map(filter(c.atoms, |x: Printed| len(shared([x.atom])) > 0), |x: Printed| x.text)

// The shared footprint, as the printer spells a footprint.
fn shared_of(c: Case) -> String = "{" ++ joined(shared_texts(c), ", ") ++ "}"

/// The classes the named tests share, coloured from the atoms each row carries.
fn classes_of(p: Program, runs: List<Int>) -> List<List<Int>> =
  group_by_conflict(
    map(filter(p.cases, |c: Case| contains_int(runs, c.index)), |c: Case|
      { index: c.index, contends: shared(atoms_of(c)) }),
  )

// The classes over every test the run reports on, when a pass will re-run any of them: only a
// mutation does, so a run without one colours nothing it will not use.
fn every_of(p: Program, options: Options) -> List<List<Int>> =
  match options.mutate { None -> [], Some(_) -> classes_of(p, map(p.cases, |c: Case| c.index)) }

// What the binding reaching some tests makes of each test the run reports on.
fn reported(r: Ran, c: Case) -> { atoms: List<Atom>, host: Bool } =
  { atoms: atoms_of(c), host: covers(r.reaches, c.index) }

fn counts_of(p: Program, r: Ran) -> Counts = counts(map(p.cases, |c: Case| reported(r, c)))

/// The whole decision, as the report reads it: a reason per test, what each seeded one still owes,
/// which tests run, and the classes they share.
fn decided_of(
  p: Program,
  decisions: List<Decision>,
  search: Search,
  sim: Json,
  groups: List<Group>,
  classes: List<List<Int>>,
) -> Decided = {
  let runs = to_run(decisions);
  {
    search: search,
    sim: sim,
    reasons: map(decisions, |x: Decision| { index: x.case.index, reason: x.reason }),
    owed: fold(decisions, [], |acc: List<{ index: Int, owed: Int }>, x: Decision|
      if !x.case.seeded { acc } else {
        push(acc, {
          index: x.case.index,
          owed: match x.case.owed { Some(roots) -> len(roots), None -> len(search.roots) },
        })
      }),
    runs: runs,
    at: flattened(classes),
    classes: groups,
    parallelism: parallelism(
      map(p.cases, |c: Case| shared(atoms_of(c))),
      map(filter(p.cases, |c: Case| contains_int(runs, c.index)), |c: Case|
        { index: c.index, contends: shared(atoms_of(c)) }),
      classes,
    ),
  }
}

// Each class's number, for the members it holds: a class is what a test shares a worker with.
fn flattened(classes: List<List<Int>>) -> List<{ index: Int, group: Int }> =
  flat_map(range(0, len(classes)), |i: Int|
    map(at(classes, i, []), |index: Int| { index: index, group: i }))

// The callback's row is the caller's: this runs a search that performs the trial operation, so a
// pure `(a) -> List<b>` would refuse it.
fn flat_map<a, b | e>(xs: List<a>, f: (a) -> List<b> / e) -> List<b> / e =
  fold(xs, [], |acc: List<b>, x: a| fold_into(acc, f(x)))

fn fold_into<a>(acc: List<a>, xs: List<a>) -> List<a> =
  fold(xs, acc, |out: List<a>, x: a| push(out, x))

pub type Group = { tests: List<Int>, footprint: String }

// How much of the corpus is trivially parallel, and what the rest costs.
pub type Parallelism = {
  total: Int,
  isolated: Int,
  shared: Int,
  region_contended: Int,
  scheduled: Int,
  groups: Int,
  shared_groups: Int,
}

pub type Program = {
  // The root the load was rooted at, as a report prints it.
  root: String,
  files: List<String>,
  places: List<Place>,
  modules: List<ModuleView>,
  incremental: Bool,
  phases: Phases,
  // Every test the program declares, which is what "no `test` items" is decided over.
  declared: Int,
  // The tests still in scope, in ascending index order.
  cases: List<Case>,
  filtered_out: Int,
  warnings: List<Diag>,
  // What the machine was configured with, placed under the key this report gives it.
  options: Json,
}

pub type Backend = {
  // Which backend answered.
  name: String,
  fragment: Int,
  offered: Int,
  entered: Int,
  declined: Int,
  converted_in: Int,
  converted_out: Int,
  // Absent unless the provider compiled something: analysis is paid once, code generation per worker.
  units: Option<Int>,
  analysis_nanos: Option<Int>,
  codegen_nanos: Option<Int>,
}

// What a search run beside the pruned one explored; `bounded` when a spent budget or a failure
// stopped it first.
pub type Cost = { explored: Int, bounded: Bool, rendered: String }

// What one test's search did. Absent, never zeroed, on a test that reached no `simulate` region.
pub type Explored = {
  explored: Int,
  exhaustive: Bool,
  exhausted: Bool,
  // `--measure-reduction` only: the same search blind to the order spawns and joins impose, and the
  // same search unpruned.
  blind: Option<Cost>,
  naive: Option<Cost>,
  // Tenths, so one division answers both the line and the document.
  reduction_tenths: Option<Int>,
  steps: Int,
  virtual_time_ns: Int,
  failing_seed: Option<String>,
}

pub type Outcome = {
  index: Int,
  name: String,
  hash: Option<String>,
  duration_us: Int,
  // `passed`, `failed`, `panicked` or `abandoned`.
  status: String,
  diagnostic: Option<Raised>,
  search: Option<Explored>,
  // `None` when nothing was written: a spent budget or an unobserved search proved nothing.
  cached: Option<Bool>,
  // The operations the test performed, handled ones included, over every interleaving it ran.
  performs: Int,
}

pub type Culprit = { names: List<String>, at: Option<At> }

// What a failure's cause came to. The runtime sends this whole shape — a program that searched
// answers with its own verdict, and the document publishes whichever side decided.
pub type Bisect = {
  conclusive: Bool,
  requested: Bool,
  reason: String,
  culprits: List<Culprit>,
  verdict: String,
  skipped: Option<String>,
  confidence: String,
  groups: List<List<String>>,
  search: SearchStats,
}

pub type Site = { task: String, definition: Option<String>, access: String, at: Option<At> }

// The two steps whose reordering at scheduling point `step` flipped a passing interleaving to this
// one.
pub type Race = { left: Site, right: Site, step: Int }

// What a failure's cause is decided from, when the test passed before: the facts its change set is
// classified from, why no mixture can be tried when none can, and where each name the facts mention
// is.
pub type Evident = {
  facts: Facts,
  absent: Option<Skipped>,
  at: List<{ name: String, at: Option<At> }>,
}

// One failure as the runtime reports it: what happened, and the facts its cause is decided from.
pub type Failed = {
  key: String,
  // The label as the source wrote it.
  name: String,
  diagnostic: Raised,
  // Two of the gate's facts; the mode is this run's own flag.
  defect: Bool,
  host: Bool,
  // `None` when the test never passed, so there is no earlier definition set to compare against.
  search: Option<Evident>,
  // The definitions in the closure the store has never seen pass, each with its current hash.
  suspects: List<{ name: String, hash: Option<String> }>,
  // Nothing in this test's closure changed, which is not the same as nothing being ranked.
  unchanged: Bool,
  seed: Option<String>,
  race: Option<Race>,
  module: Option<String>,
  test_hash: Option<String>,
  nondet: Option<Bool>,
  status: Option<String>,
  // The atoms the test's footprint declares.
  declared: Option<List<String>>,
}

// One failure as a report shows it: the runtime's account, and what this program decided about its
// cause.
pub type Fault = {
  key: String,
  name: String,
  diagnostic: Diag,
  defect: Bool,
  bisect: Bisect,
  // Ranked, most likely first.
  suspects: List<Suspect>,
  unchanged: Bool,
  seed: Option<String>,
  race: Option<Race>,
  // The command that replays the failing interleaving.
  replay: Option<String>,
  module: Option<String>,
  test_hash: Option<String>,
  nondet: Option<Bool>,
  status: Option<String>,
  declared: Option<List<String>>,
}

pub type Mutant = { definition: String, from: String, to: String, at: Option<At> }

pub type Mutants = {
  killed: Int,
  survived: Int,
  skipped: Int,
  budget_spent: Bool,
  unreached: List<String>,
  survivors: List<Mutant>,
  json: Json,
}

pub type Coverage = { definitions: Int, unreached: List<String>, json: Json }

pub type Summary = { passed: Int, failed: Int, abandoned: Int, cached: Int, duration_us: Int }

pub type Simulated = {
  simulated: Int,
  total: Int,
  seeds: Int,
  interleavings: Int,
  exhaustive: Int,
  exhausted: Int,
  failed: Int,
}

pub type Ran = {
  hermetic: Bool,
  // `hermetic` or `host`.
  label: String,
  operations: Int,
  digest: String,
  handshakes: List<String>,
  hosts: Json,
  // The tests this binding can reach, by index, ascending.
  reaches: List<Int>,
  workers: Int,
  backend: Option<Backend>,
  results: List<Outcome>,
  failures: List<Failed>,
  summary: Summary,
  simulation: Simulated,
  // Not warnings: every later run believes an escaped cache entry.
  escapes: List<Diag>,
  warnings: List<Diag>,
  mutants: Option<Mutants>,
  coverage: Option<Coverage>,
}

// --- Small things -----------------------------------------------------------

fn at<a>(xs: List<a>, i: Int, spare: a) -> a = match list_at(xs, i) { Some(x) -> x, None -> spare }

fn appended<a>(head: List<a>, tail: List<a>) -> List<a> =
  fold(tail, head, |acc: List<a>, x: a| push(acc, x))

fn repeated(text: String, n: Int) -> String =
  fold(range(0, n), "", |acc: String, i: Int| acc ++ text)

fn joined(parts: List<String>, sep: String) -> String =
  fold(range(0, len(parts)), "", |acc: String, i: Int|
    if i == 0 { at(parts, i, "") } else { acc ++ sep ++ at(parts, i, "") })

fn padded(text: String, width: Int) -> String =
  if string_len(text) >= width { text } else { text ++ repeated(" ", width - string_len(text)) }

fn aligned(text: String, width: Int) -> String =
  if string_len(text) >= width { text } else { repeated(" ", width - string_len(text)) ++ text }

fn num(n: Int) -> Json = Number(decimal_of_int(n))

fn opt_num(v: Option<Int>) -> Json = match v { Some(n) -> num(n), None -> Null }

fn opt_str(v: Option<String>) -> Json = match v { Some(s) -> Str(s), None -> Null }

fn opt_bool(v: Option<Bool>) -> Json = match v { Some(b) -> Bool(b), None -> Null }

fn strings(xs: List<String>) -> Json = Array(map(xs, |x: String| Str(x)))

fn opt_strings(v: Option<List<String>>) -> Json = match v { Some(xs) -> strings(xs), None -> Null }

fn covers(xs: List<Int>, wanted: Int) -> Bool = len(filter(xs, |x: Int| x == wanted)) > 0

fn said(lines: List<String>, wanted: String) -> Bool =
  len(filter(lines, |l: String| l == wanted)) > 0

fn no_group() -> Group = { tests: [], footprint: "" }

fn no_culprit() -> Culprit = { names: [], at: None }

// --- Fixed point ------------------------------------------------------------

fn pow10(k: Int) -> Int = fold(range(0, k), 1, |acc: Int, i: Int| acc * 10)

fn zeroed(text: String, width: Int) -> String =
  if string_len(text) >= width { text } else { repeated("0", width - string_len(text)) ++ text }

fn fixed(scaled: Int, digits: Int) -> String = {
  let unit = pow10(digits);
  let whole = scaled / unit;
  if digits == 0 { int_to_string(whole) }
  else { int_to_string(whole) ++ "." ++ zeroed(int_to_string(scaled - whole * unit), digits) }
}

fn ms1(us: Int) -> String = fixed((us + 50) / 100, 1)

fn ms2(us: Int) -> String = fixed((us + 5) / 10, 2)

fn ms3(us: Int) -> String = fixed(us, 3)

fn secs2(us: Int) -> String = fixed((us + 5000) / 10000, 2)

fn nanos_ms1(ns: Int) -> String = fixed((ns + 50000) / 100000, 1)

// Per mille is tenths of a percent, so one division answers both digits.
fn share(part: Int, total: Int) -> String =
  aligned(fixed(if total == 0 { 0 } else { part * 1000 / total }, 1), 5) ++ "%"

fn decimal(text: String) -> Decimal =
  match decimal_of_string(text) { Some(d) -> d, None -> decimal_of_int(0) }

fn millis(us: Int) -> Json = Number(decimal(ms3(us)))

// --- Naming and placing -----------------------------------------------------

// The label in a single-module run, `<module>.<label>` otherwise.
fn display_of(p: Program, c: Case) -> String = if len(p.modules) > 1 { c.key } else { c.name }

fn short_of(hash: Option<String>) -> String =
  match hash { Some(h) -> string_slice(h, 0, 12), None -> repeated("-", 12) }

// `path:line:col`, one-based, as every other command prints a place.
fn located(places: List<Place>, a: At) -> Option<String> =
  if a.module == no_module() { None } else {
    match list_at(places, a.module) {
      None -> None,
      Some(place) -> {
        let spot: Spot = spot_of(place.text, a.start);
        Some(place.path ++ ":" ++ int_to_string(spot.line) ++ ":" ++ int_to_string(spot.col))
      },
    }
  }

fn dim_place(s: Style, places: List<Place>, a: Option<At>) -> String =
  match a {
    None -> "",
    Some(spot) -> match located(places, spot) { Some(text) -> "   " ++ dim(s, text), None -> "" },
  }

fn primary_of(d: Diag) -> Option<Label> =
  fold(d.labels, None, |acc: Option<Label>, l: Label|
    match acc { Some(_) -> acc, None -> if l.primary { Some(l) } else { None } })

fn label_at(l: Label) -> At = { module: l.module, start: l.start, end: l.end }

// Line and column rather than byte offsets, for editors.
fn place_json(places: List<Place>, a: At) -> Json =
  if a.module == no_module() { Null } else {
    match list_at(places, a.module) {
      None -> Null,
      Some(place) -> {
        let from: Spot = spot_of(place.text, a.start);
        let to: Spot = spot_of(place.text, a.end);
        object([
          { key: "file", value: Str(place.path) },
          { key: "line", value: num(from.line) },
          { key: "column", value: num(from.col) },
          { key: "end_line", value: num(to.line) },
          { key: "end_column", value: num(to.col) },
        ])
      },
    }
  }

fn location_json(places: List<Place>, d: Diag) -> Json =
  match primary_of(d) { None -> Null, Some(l) -> place_json(places, label_at(l)) }

fn one_diagnostic(d: Diag, places: List<Place>) -> Json =
  match all_to_json([d], places) { Array(xs) -> at(xs, 0, Null), other -> other }

// --- What the selection decided ---------------------------------------------

// The document spells a reason as one word, so the halves of a name are joined rather than spaced.
fn keyed(reason: String) -> String = joined(string_split(reason, " "), "_")

fn why(reason: String) -> String =
  if reason == "new" { "this hash has never gone green, so nothing is known about it" }
  else if reason == "nondet" { "`test/nondet` always runs and is never cached" }
  else if reason == "previous failure" {
    "the cache holds a failure, and a failure is never trusted"
  } else if reason == "cached" {
    "this exact hash already passed; re-running cannot reveal anything new"
  } else { "no hash was produced, so the cache cannot answer for it" }

// `region`, `shared` or `host`: a socket lives outside every region, so a host-backed test is
// neither isolated nor cached.
fn isolated_as(r: Ran, c: Case) -> String = isolation_word(isolation_of(reported(r, c)))

// --- The head ---------------------------------------------------------------

fn selected_line(s: Style, p: Program, d: Decided) -> String =
  ind() ++ bold(s, "selected") ++ " " ++ bold(s, int_to_string(selected_count(p, d))) ++ " of "
    ++ int_to_string(len(p.cases))
    ++ " ("
    ++ int_to_string(cached_count(p, d))
    ++ " cached)"

fn group_line(d: Decided, r: Ran) -> List<String> =
  if len(d.classes) == 0 { [] }
  else { [ind() ++ count_of(len(d.classes), "group") ++ " · " ++ count_of(r.workers, "worker")] }

fn isolated_line(s: Style, c: Counts) -> List<String> =
  if c.total == 0 { [] } else {
    let contending = if c.shared == 0 { "" }
    else { dim(s, " · " ++ count_of(c.shared, "test") ++ " can contend") };
    [
      ind() ++ bold(s, "isolated") ++ " " ++ bold(s, int_to_string(c.isolated)) ++ " of "
        ++ int_to_string(c.total)
        ++ contending,
    ]
  }

fn binding_lines(s: Style, r: Ran, c: Counts) -> List<String> =
  if r.hermetic { [] } else {
    let head = [
      ind() ++ bold(s, "host") ++ " " ++ bold(s, int_to_string(c.host)) ++ " of "
        ++ int_to_string(c.total)
        ++ " · "
        ++ dim(s, "not cached"),
      ind()
        ++ dim(s, "binding host · " ++ count_of(r.operations, "operation") ++ " · " ++ r.digest),
    ];
    appended(head, map(r.handshakes, |line: String| ind() ++ dim(s, line)))
  }

// `simulated: 3 of 47 · 61 interleavings · 3 exhaustive`.
fn simulation_line(s: Style, r: Ran) -> List<String> =
  if r.simulation.simulated == 0 { [] } else {
    let c = r.simulation;
    let head = "simulated: " ++ int_to_string(c.simulated) ++ " of " ++ int_to_string(c.total)
      ++ " · "
      ++ count_of(c.interleavings, "interleaving");
    let thorough = if c.exhaustive == 0 { head }
    else { head ++ " · " ++ int_to_string(c.exhaustive) ++ " exhaustive" };
    let spent = if c.exhausted == 0 { thorough }
    else { thorough ++ " · " ++ int_to_string(c.exhausted) ++ " budget spent, not cached" };
    [ind() ++ bold(s, spent)]
  }

// Apart from the entry counts: analysis is paid once, code generation per worker.
fn compiled_line(s: Style, b: Backend) -> List<String> =
  match b.units {
    None -> [],
    Some(units) ->
      [
        ind()
          ++ dim(
            s,
            "compiled " ++ int_to_string(units) ++ " unit(s) in "
              ++ nanos_ms1(match b.codegen_nanos { Some(n) -> n, None -> 0 })
              ++ "ms, after "
              ++ nanos_ms1(match b.analysis_nanos { Some(n) -> n, None -> 0 })
              ++ "ms deciding what to compile",
          ),
      ],
  }

fn backend_lines(s: Style, r: Ran) -> List<String> =
  match r.backend {
    None -> [],
    Some(b) ->
      appended(
        [
          ind() ++ bold(s, "backend") ++ " " ++ bold(s, b.name) ++ " · "
            ++ int_to_string(b.entered)
            ++ " of "
            ++ int_to_string(b.offered)
            ++ " offers entered · "
            ++ int_to_string(b.declined)
            ++ " declined · "
            ++ int_to_string(b.fragment)
            ++ " in the fragment",
        ],
        compiled_line(s, b),
      ),
  }

fn bypass_lines(s: Style, flags: Flags) -> List<String> =
  if !flags.no_cache { [] }
  else { [ind() ++ dim(s, "--no-cache: results were neither read nor recorded")] }

fn filtered_lines(s: Style, p: Program) -> List<String> =
  if p.filtered_out == 0 { [] }
  else { [ind() ++ dim(s, "--filter hid " ++ count_of(p.filtered_out, "test"))] }

fn head_lines(s: Style, flags: Flags, p: Program, r: Ran, d: Decided) -> List<String> = {
  let c = counts_of(p, r);
  appended(
    appended(
      appended(
        appended(
          appended(
            appended(appended([selected_line(s, p, d)], group_line(d, r)), isolated_line(s, c)),
            binding_lines(s, r, c),
          ),
          simulation_line(s, r),
        ),
        backend_lines(s, r),
      ),
      bypass_lines(s, flags),
    ),
    filtered_lines(s, p),
  )
}

// --- Where the time went ----------------------------------------------------

type Phase = { label: String, us: Int }

// Longest first, so what dominated a run is read first, and ties stay in the order measured.
fn ordered(rows: List<Phase>) -> List<Phase> =
  fold(rows, [], |acc: List<Phase>, p: Phase|
    appended(push(filter(acc, |q: Phase| q.us >= p.us), p), filter(acc, |q: Phase| q.us < p.us)))

fn phase_rows(f: Phases) -> List<Phase> =
  ordered([
    { label: "read", us: f.read_us },
    { label: "front", us: f.front_us },
    { label: "write back", us: f.write_back_us },
  ])

fn phase_total(f: Phases) -> Int = f.read_us + f.front_us + f.write_back_us

fn phase_line(s: Style, p: Phase, total: Int) -> String =
  ind() ++ "  " ++ padded(p.label, 11) ++ " " ++ aligned(ms2(p.us), 8) ++ "ms "
    ++ dim(s, share(p.us, total))

fn phase_lines(s: Style, f: Phases) -> List<String> = {
  let total = phase_total(f);
  appended(
    appended(
      ["", ind() ++ bold(s, "front-end time")],
      map(phase_rows(f), |p: Phase| phase_line(s, p, total)),
    ),
    [ind() ++ "  " ++ padded("total", 11) ++ " " ++ aligned(ms2(total), 8) ++ "ms"],
  )
}

// --- `--explain` ------------------------------------------------------------

fn explain_atoms(iso: String, c: Case) -> String =
  if iso == "region" { "" }
  else if contends_only_over_regions(atoms_of(c)) { " " ++ shared_of(c) ++ " (region labels)" }
  else { " " ++ shared_of(c) }

fn case_line(s: Style, p: Program, r: Ran, c: Case, d: Decided) -> String = {
  let iso = isolated_as(r, c);
  let reason = word(reason_of(d, c.index));
  let verb = if runs_test(d, c.index) { bold(s, "run ") } else { dim(s, "skip") };
  ind() ++ verb ++ " " ++ dim(s, short_of(c.hash)) ++ " " ++ padded(reason, 16) ++ " "
    ++ padded(display_of(p, c), 40)
    ++ " "
    ++ dim(
      s,
      "isolation: " ++ iso ++ explain_atoms(iso, c) ++ (if c.seeded { " · searched" } else { "" }),
    )
}

fn reasons_seen(p: Program, d: Decided) -> List<String> =
  fold(p.cases, [], |acc: List<String>, c: Case| {
    let reason = word(reason_of(d, c.index));
    if said(acc, reason) { acc } else { push(acc, reason) }
  })

fn why_lines(s: Style, p: Program, d: Decided) -> List<String> = {
  let seen = reasons_seen(p, d);
  if len(seen) == 0 { [] } else {
    appended(
      ["", ind() ++ dim(s, "why")],
      map(seen, |reason: String| ind() ++ "  " ++ padded(reason, 16) ++ " " ++ dim(s, why(reason))),
    )
  }
}

fn owed_line(s: Style, p: Program, c: Case, d: Decided) -> List<String> =
  if owed_of(d, c.index) == len(d.search.roots) { [] } else {
    [
      ind() ++ "  "
        ++ dim(
          s,
          display_of(p, c) ++ ": " ++ int_to_string(owed_of(d, c.index)) ++ " of "
            ++ count_of(len(d.search.roots), "seed")
            ++ " still owed; the rest already passed on their own",
        ),
    ]
  }

// What the seeded tests will search, and what each of them still owes.
fn search_lines(s: Style, p: Program, d: Decided) -> List<String> = {
  let seeded = filter(p.cases, |c: Case| c.seeded);
  if len(seeded) == 0 { [] } else {
    let head = [
      "",
      ind() ++ dim(s, "search"),
      ind() ++ "  "
        ++ dim(
          s,
          d.search.mode ++ " · " ++ count_of(len(d.search.roots), "seed") ++ " · budget "
            ++ int_to_string(d.search.budget)
            ++ " · steps "
            ++ int_to_string(d.search.steps),
        ),
      ind() ++ "  "
        ++ dim(
          s,
          int_to_string(len(seeded)) ++ " of " ++ count_of(len(p.cases), "test")
            ++ " keyed on this plan and never on their bare hash",
        ),
    ];
    fold(seeded, head, |acc: List<String>, c: Case| appended(acc, owed_line(s, p, c, d)))
  }
}

// Grouped like any other test, but a host-backed test is never free.
fn group_tally(s: Style, c: Counts, d: Decided) -> String = {
  let hosted = if c.host == 0 { "" }
  else { " · " ++ int_to_string(c.host) ++ " host-backed and never free" };
  let regioned = if d.parallelism.region_contended == 0 { "" } else {
    " · " ++ int_to_string(d.parallelism.region_contended) ++ " of them only over a region label"
  };
  ind() ++ "  "
    ++ dim(
      s,
      int_to_string(c.isolated) ++ " of " ++ int_to_string(c.total)
        ++ " region-isolated and free · "
        ++ count_of(d.parallelism.shared_groups, "group")
        ++ " for the "
        ++ int_to_string(c.shared)
        ++ " shared "
        ++ plural(c.shared, "test")
        ++ regioned
        ++ hosted,
    )
}

fn named_of(p: Program, index: Int) -> String =
  fold(p.cases, "", |acc: String, c: Case| if c.index == index { display_of(p, c) } else { acc })

fn group_block(s: Style, p: Program, d: Decided, lines: List<String>, i: Int) -> List<String> = {
  let g: Group = at(d.classes, i, no_group());
  let head = push(
    lines,
    ind() ++ "  group " ++ int_to_string(i) ++ " · " ++ count_of(len(g.tests), "test") ++ " · "
      ++ dim(s, g.footprint),
  );
  fold(g.tests, head, |acc: List<String>, index: Int| {
    let named = named_of(p, index);
    if named == "" { acc } else { push(acc, ind() ++ "    " ++ named) }
  })
}

fn concurrency_lines(s: Style, p: Program, c: Counts, d: Decided) -> List<String> =
  if len(d.classes) == 0 { [] } else {
    fold(
      range(0, len(d.classes)),
      ["", ind() ++ dim(s, "concurrency groups"), group_tally(s, c, d)],
      |acc: List<String>, i: Int| group_block(s, p, d, acc, i),
    )
  }

fn explain_lines(s: Style, p: Program, r: Ran, dec: Decided) -> List<String> =
  appended(
    appended(
      appended(
        appended(
          appended([""], map(p.cases, |c: Case| case_line(s, p, r, c, dec))),
          why_lines(s, p, dec),
        ),
        search_lines(s, p, dec),
      ),
      concurrency_lines(s, p, counts_of(p, r), dec),
    ),
    phase_lines(s, p.phases),
  )

// --- One test's line --------------------------------------------------------

fn glyph_of(status: String) -> String =
  if status == "passed" { "✓" }
  else if status == "failed" { "✗" }
  else if status == "panicked" { "!" }
  else { "–" }

fn word_of(status: String) -> String =
  if status == "passed" { "ok" }
  else if status == "failed" { "FAIL" }
  else if status == "panicked" { "PANIC" }
  else { "GAVE UP" }

fn painted_glyph(s: Style, status: String) -> String = {
  let glyph = glyph_of(status);
  if status == "passed" { green(s, glyph) }
  else if status == "failed" { red(s, glyph) }
  else if status == "panicked" { yellow(s, glyph) }
  else { dim(s, glyph) }
}

// A styled mark is one glyph wide whatever escapes it carries, so the column is measured over the
// word rather than over the paint.
fn marked(s: Style, status: String) -> String =
  if s.styled { painted_glyph(s, status) } else { padded(word_of(status), 7) }

fn result_name(p: Program, o: Outcome) -> String =
  fold(p.cases, o.name, |acc: String, c: Case|
    if c.index == o.index { display_of(p, c) } else { acc })

fn name_column(p: Program, r: Ran) -> Int = {
  let widest = fold(r.results, 0, |acc: Int, o: Outcome| {
    let n = string_len(result_name(p, o));
    if n > acc { n } else { acc }
  });
  if widest < 24 { 24 } else if widest > 64 { 64 } else { widest }
}

fn result_line(s: Style, p: Program, o: Outcome, width: Int) -> String =
  ind() ++ marked(s, o.status) ++ " " ++ padded(result_name(p, o), width) ++ " "
    ++ aligned(ms1(o.duration_us), 8)
    ++ "ms"

// A bounded naive count makes the ratio a lower bound.
fn reduction_part(e: Explored, naive: Cost) -> List<String> =
  match e.reduction_tenths {
    None -> [],
    Some(tenths) ->
      [(if naive.bounded { ">= " } else { "" }) ++ fixed((tenths + 5) / 10, 0) ++ "× reduction"],
  }

// What one test's search did, under its result line.
fn search_parts(e: Explored) -> List<String> = {
  let head = [count_of(e.explored, "interleaving")];
  let thorough = if e.exhaustive { push(head, "exhaustive") } else { head };
  let spent = if e.exhausted { push(thorough, "budget spent — not cached") } else { thorough };
  let blind = match e.blind { None -> spent, Some(b) -> push(spent, "blind " ++ b.rendered) };
  match e.naive {
    None -> blind,
    Some(naive) -> appended(push(blind, "naive " ++ naive.rendered), reduction_part(e, naive)),
  }
}

fn result_lines(s: Style, p: Program, r: Ran) -> List<String> = {
  let width = name_column(p, r);
  fold(r.results, [], |acc: List<String>, o: Outcome| {
    let listed = push(acc, result_line(s, p, o, width));
    match o.search {
      None -> listed,
      Some(e) -> push(listed, ind() ++ "    " ++ dim(s, joined(search_parts(e), " · "))),
    }
  })
}

// --- The summary ------------------------------------------------------------

// `host` sits beside `cached` so "0 cached" is not misread as selection working.
fn summary_line(s: Style, r: Ran, counted: Counts) -> String = {
  let c = r.summary;
  let failures = int_to_string(c.failed) ++ " failed";
  let passes = int_to_string(c.passed) ++ " passed";
  let hosted = if counted.host == 0 { "" }
  else { dim(s, ", " ++ int_to_string(counted.host) ++ " host-backed and not cached") };
  let given_up = if c.abandoned == 0 { "" }
  else { yellow(s, ", " ++ int_to_string(c.abandoned) ++ " abandoned") };
  ind() ++ (if c.failed > 0 { red(s, failures) } else { dim(s, failures) }) ++ ", "
    ++ (if c.passed > 0 { green(s, passes) } else { dim(s, passes) })
    ++ ", "
    ++ int_to_string(c.cached)
    ++ " cached"
    ++ hosted
    ++ given_up
    ++ " ("
    ++ secs2(c.duration_us)
    ++ "s)"
}

// --- One failure ------------------------------------------------------------

fn culprit_line(s: Style, places: List<Place>, c: Culprit, first: Bool) -> String =
  "  " ++ red(s, if first { "culprit:" } else { "        " }) ++ " " ++ joined(c.names, " + ")
    ++ dim_place(s, places, c.at)

// The culprit before the diff: the culprit is the answer.
fn bisect_lines(s: Style, places: List<Place>, b: Bisect) -> List<String> =
  if b.conclusive {
    push(
      fold(range(0, len(b.culprits)), [], |acc: List<String>, i: Int|
        push(acc, culprit_line(s, places, at(b.culprits, i, no_culprit()), i == 0))),
      "    " ++ dim(s, b.reason),
    )
  }
  // Silent when no bisection was asked for.
  else if !b.requested { [] }
  else { ["  " ++ dim(s, "no culprit:") ++ " " ++ b.reason] }

fn note_lines(s: Style, d: Diag) -> List<String> =
  map(d.notes_text, |n: Bytes| "  " ++ dim(s, "=") ++ " " ++ string_of_bytes_lossy(n))

// A deadlock's cycle lives only in its secondary labels.
fn secondary_lines(s: Style, places: List<Place>, d: Diag) -> List<String> =
  map(filter(d.labels, |l: Label| !l.primary), |l: Label|
    "    " ++ string_of_bytes_lossy(l.text) ++ dim_place(s, places, Some(label_at(l))))

fn at_lines(s: Style, places: List<Place>, d: Diag) -> List<String> =
  match primary_of(d) {
    None -> [],
    Some(l) -> match located(places, label_at(l)) {
      None -> [],
      Some(text) -> ["    at " ++ dim(s, text)],
    },
  }

fn site_line(s: Style, places: List<Place>, site: Site, first: Bool) -> String =
  "  " ++ yellow(s, if first { "race:" } else { "     " }) ++ " " ++ site.task ++ "  "
    ++ (match site.definition { Some(d) -> d, None -> "-" })
    ++ "   "
    ++ site.access
    ++ dim_place(s, places, site.at)

fn race_lines(s: Style, places: List<Place>, f: Fault) -> List<String> =
  match f.race {
    None -> [],
    Some(race) -> [site_line(s, places, race.left, true), site_line(s, places, race.right, false)],
  }

fn replay_lines(s: Style, f: Fault) -> List<String> =
  match f.replay { None -> [], Some(command) -> ["  " ++ dim(s, "replay:") ++ " " ++ command] }

// The repro, which is a seed rather than a stack trace.
fn seed_lines(s: Style, places: List<Place>, f: Fault) -> List<String> =
  match f.seed {
    None -> [],
    Some(seed) ->
      appended(
        appended(["  " ++ dim(s, "seed:") ++ " " ++ seed], race_lines(s, places, f)),
        replay_lines(s, f),
      ),
  }

fn described(x: Suspect) -> String =
  match x.change { Some(c) -> x.name ++ " (" ++ kind_word(c) ++ ")", None -> x.name }

fn suspect_lines(s: Style, f: Fault) -> List<String> = {
  let rest = map(filter(f.suspects, |x: Suspect| !x.culprit), described);
  if len(rest) > 0 { ["  " ++ yellow(s, "suspects:") ++ " " ++ joined(rest, ", ")] }
  else if f.unchanged {
    ["  " ++ dim(s, "suspects: none — nothing in this test's closure changed")]
  } else { [] }
}

fn failure_lines(s: Style, places: List<Place>, f: Fault) -> List<String> =
  appended(
    appended(
      appended(
        appended(
          appended(
            appended(appended([bold(s, f.key)], bisect_lines(s, places, f.bisect)), [
              "  " ++ string_of_bytes_lossy(f.diagnostic.message),
            ]),
            at_lines(s, places, f.diagnostic),
          ),
          secondary_lines(s, places, f.diagnostic),
        ),
        note_lines(s, f.diagnostic),
      ),
      seed_lines(s, places, f),
    ),
    suspect_lines(s, f),
  )

fn failure_blocks(s: Style, p: Program, faults: List<Fault>) -> List<String> =
  fold(faults, [], |acc: List<String>, f: Fault|
    appended(push(acc, ""), map(failure_lines(s, p.places, f), |l: String| ind() ++ l)))

// A test the clock stopped: no culprit, no suspects, nothing to bisect — the machine ran out of
// patience, and what the test would have decided is still unknown.
fn abandoned_lines(s: Style, places: List<Place>, o: Outcome) -> List<String> = {
  let head = [bold(s, o.name) ++ " " ++ yellow(s, "abandoned")];
  match o.diagnostic {
    None -> head,
    Some(r) -> {
      let d = shown(r);
      appended(
        appended(push(head, "  " ++ string_of_bytes_lossy(d.message)), at_lines(s, places, d)),
        note_lines(s, d),
      )
    },
  }
}

fn abandoned_blocks(s: Style, p: Program, r: Ran) -> List<String> =
  fold(
    filter(r.results, |o: Outcome| o.status == "abandoned"),
    [],
    |acc: List<String>, o: Outcome|
      appended(push(acc, ""), map(abandoned_lines(s, p.places, o), |l: String| ind() ++ l)),
  )

// --- Coverage and mutants ---------------------------------------------------

fn unreached_lines(s: Style, names: List<String>) -> List<String> =
  map(names, |n: String| ind() ++ ind() ++ dim(s, n ++ ": no test reaches it"))

fn coverage_lines(s: Style, r: Ran) -> List<String> =
  match r.coverage {
    None -> [],
    Some(c) ->
      appended(
        [
          ind() ++ bold(s, "coverage") ++ " " ++ int_to_string(c.definitions - len(c.unreached))
            ++ " of "
            ++ int_to_string(c.definitions)
            ++ " definitions reached by a test",
        ],
        unreached_lines(s, c.unreached),
      ),
  }

fn survivor_line(s: Style, places: List<Place>, m: Mutant) -> String = {
  let spot = match m.at {
    None -> "",
    Some(a) -> match located(places, a) { Some(text) -> text, None -> "" },
  };
  ind() ++ ind() ++ red(s, m.definition) ++ " survives `" ++ m.from ++ "` -> `" ++ m.to ++ "` at "
    ++ dim(s, spot)
}

fn mutant_lines(s: Style, p: Program, r: Ran) -> List<String> =
  match r.mutants {
    None -> [],
    Some(m) -> {
      let tally = int_to_string(m.killed) ++ " killed, " ++ int_to_string(m.survived)
        ++ " survived, "
        ++ int_to_string(m.skipped)
        ++ " skipped"
        ++ (if m.budget_spent { ", budget spent" } else { "" });
      appended(
        appended(
          [ind() ++ bold(s, "mutants") ++ " " ++ bold(s, tally)],
          unreached_lines(s, m.unreached),
        ),
        map(m.survivors, |x: Mutant| survivor_line(s, p.places, x)),
      )
    },
  }

fn no_tests_note(flags: Flags, p: Program) -> String =
  if p.declared == 0 { "no `test` items in this program" } else if len(flags.filters) > 0 {
    "no test key contains a `--filter` substring; nothing was verified"
  } else { "nothing to report" }

// --- The document -----------------------------------------------------------

fn case_json(r: Ran, c: Case, d: Decided) -> Json =
  object([
    { key: "index", value: num(c.index) },
    { key: "key", value: Str(c.key) },
    { key: "name", value: Str(c.name) },
    { key: "module", value: Str(c.module) },
    { key: "hash", value: opt_str(c.hash) },
    { key: "nondet", value: Bool(c.nondet) },
    { key: "selected", value: Bool(runs_test(d, c.index)) },
    { key: "reason", value: Str(keyed(word(reason_of(d, c.index)))) },
    { key: "why", value: Str(why(word(reason_of(d, c.index)))) },
    { key: "group", value: opt_num(group_of(d, c.index)) },
    { key: "footprint", value: Str(c.footprint) },
    { key: "isolation", value: Str(isolated_as(r, c)) },
    // Whether this test reaches the binding, and so always runs uncached.
    { key: "host", value: Bool(covers(r.reaches, c.index)) },
    { key: "shared_atoms", value: strings(shared_texts(c)) },
    // The same atoms unprinted, as the scheduler compares them, and whether the test is handed a
    // seed: what a program re-colouring the run needs, without parsing a printed atom.
    { key: "contends", value: Array(map(shared(atoms_of(c)), atom_json)) },
    { key: "seeded", value: Bool(c.seeded) },
  ])

fn atom_json(a: Atom) -> Json =
  object([
    { key: "effect", value: Str(a.effect) },
    { key: "resource", value: Str(a.resource) },
    { key: "writes", value: Bool(a.writes) },
  ])

fn group_json(d: Decided, i: Int) -> Json = {
  let g: Group = at(d.classes, i, no_group());
  object([
    { key: "index", value: num(i) },
    { key: "tests", value: Array(map(g.tests, |x: Int| num(x))) },
    { key: "footprint", value: Str(g.footprint) },
  ])
}

fn cost_json(v: Option<Cost>) -> Json =
  match v {
    None -> Null,
    Some(c) ->
      object([
        { key: "explored", value: num(c.explored) },
        { key: "bounded", value: Bool(c.bounded) },
        { key: "rendered", value: Str(c.rendered) },
      ]),
  }

fn search_json(e: Explored) -> Json =
  object([
    { key: "explored", value: num(e.explored) },
    { key: "exhaustive", value: Bool(e.exhaustive) },
    { key: "exhausted", value: Bool(e.exhausted) },
    { key: "blind", value: cost_json(e.blind) },
    { key: "naive", value: cost_json(e.naive) },
    {
      key: "reduction",
      value: match e.reduction_tenths { Some(t) -> Number(decimal(fixed(t, 1))), None -> Null },
    },
    { key: "steps", value: num(e.steps) },
    { key: "virtual_time_ns", value: num(e.virtual_time_ns) },
    { key: "failing_seed", value: opt_str(e.failing_seed) },
  ])

fn case_of(p: Program, index: Int) -> Option<Case> =
  fold(p.cases, None, |acc: Option<Case>, c: Case|
    match acc { Some(_) -> acc, None -> if c.index == index { Some(c) } else { None } })

fn outcome_json(p: Program, o: Outcome, d: Decided) -> Json = {
  let named = case_of(p, o.index);
  object([
    { key: "index", value: num(o.index) },
    { key: "key", value: match named { Some(c) -> Str(c.key), None -> Null } },
    { key: "name", value: Str(match named { Some(c) -> c.name, None -> o.name }) },
    { key: "module", value: match named { Some(c) -> Str(c.module), None -> Null } },
    { key: "hash", value: opt_str(o.hash) },
    { key: "group", value: num(match group_of(d, o.index) { Some(g) -> g, None -> 0 }) },
    { key: "status", value: Str(o.status) },
    { key: "duration_ms", value: millis(o.duration_us) },
    {
      key: "diagnostic",
      value: match o.diagnostic { Some(r) -> one_diagnostic(shown(r), p.places), None -> Null },
    },
    // Absent, never zeroed, when no region was reached.
    { key: "simulation", value: match o.search { Some(e) -> search_json(e), None -> Null } },
    { key: "cached", value: opt_bool(o.cached) },
    { key: "performs", value: num(o.performs) },
  ])
}

// A place as the artifact carries one: the source and the byte range.
fn span_json(a: Option<At>) -> Json =
  match a {
    None -> Null,
    Some(at) ->
      object([
        { key: "source", value: num(at.module) },
        { key: "start", value: num(at.start) },
        { key: "end", value: num(at.end) },
      ]),
  }

fn site_json(x: Site) -> Json =
  object([
    { key: "task", value: Str(x.task) },
    { key: "definition", value: opt_str(x.definition) },
    { key: "access", value: Str(x.access) },
    { key: "span", value: span_json(x.at) },
  ])

fn race_json(v: Option<Race>) -> Json =
  match v {
    None -> Null,
    Some(race) ->
      object([
        { key: "at", value: num(race.step) },
        { key: "left", value: site_json(race.left) },
        { key: "right", value: site_json(race.right) },
      ]),
  }

// The failure artifact: what failed and where, whether it is Ply's fault, how to replay it, and the
// cause this program decided, led by the culprit.
fn fault_json(p: Program, f: Fault) -> Json =
  object([
    { key: "key", value: Str(f.key) },
    { key: "name", value: Str(f.name) },
    { key: "diagnostic", value: one_diagnostic(f.diagnostic, p.places) },
    // Whether to go and read the program or go and report a bug in Ply.
    { key: "defect", value: Bool(f.defect) },
    { key: "seed", value: opt_str(f.seed) },
    { key: "replay", value: opt_str(f.replay) },
    // Only when the search actually observed the flip.
    { key: "race", value: race_json(f.race) },
    { key: "culprit", value: culprit_json(f.bisect) },
    { key: "suspects", value: Array(map(f.suspects, suspect_json)) },
    { key: "module", value: opt_str(f.module) },
    { key: "test_hash", value: opt_str(f.test_hash) },
    { key: "nondet", value: opt_bool(f.nondet) },
    { key: "status", value: opt_str(f.status) },
    { key: "location", value: location_json(p.places, f.diagnostic) },
    { key: "footprint", value: object([{ key: "declared", value: opt_strings(f.declared) }]) },
  ])

// The verdict as the document carries it: what to change, how sure the system is, and how it
// found out. Built here rather than read from the runtime's copy of the row, because a program
// that searched is the side that decided.
fn culprit_json(b: Bisect) -> Json =
  object([
    { key: "verdict", value: Str(b.verdict) },
    { key: "skipped", value: opt_str(b.skipped) },
    { key: "confidence", value: Str(b.confidence) },
    { key: "definitions", value: Array(map(b.culprits, |c: Culprit| Str(at(c.names, 0, "")))) },
    {
      key: "groups",
      value: Array(map(b.groups, |g: List<String>| Array(map(g, |n: String| Str(n))))),
    },
    { key: "reason", value: Str(b.reason) },
    {
      key: "search",
      value: object([
        { key: "candidates", value: num(b.search.candidates) },
        { key: "clusters", value: num(b.search.clusters) },
        { key: "evaluated", value: num(b.search.evaluated) },
        { key: "cached", value: num(b.search.cached) },
        { key: "memoized", value: num(b.search.memoized) },
        { key: "unresolved", value: num(b.search.unresolved) },
        { key: "exhausted", value: Bool(b.search.exhausted) },
      ]),
    },
  ])

fn suspect_json(x: Suspect) -> Json =
  object([
    { key: "name", value: Str(x.name) },
    {
      key: "change",
      value: opt_str(match x.change { Some(c) -> Some(kind_word(c)), None -> None }),
    },
    { key: "hash", value: opt_str(x.hash) },
    { key: "before", value: opt_str(x.before) },
    { key: "culprit", value: Bool(x.culprit) },
  ])

fn parallelism_json(v: Parallelism) -> Json =
  object([
    { key: "total", value: num(v.total) },
    { key: "isolated", value: num(v.isolated) },
    { key: "shared", value: num(v.shared) },
    { key: "region_contended", value: num(v.region_contended) },
    { key: "scheduled", value: num(v.scheduled) },
    { key: "groups", value: num(v.groups) },
    { key: "shared_groups", value: num(v.shared_groups) },
  ])

fn phases_json(f: Phases) -> Json =
  object([
    { key: "read", value: millis(f.read_us) },
    { key: "front", value: millis(f.front_us) },
    { key: "write_back", value: millis(f.write_back_us) },
    { key: "total", value: millis(phase_total(f)) },
  ])

fn selection_json(p: Program, r: Ran, d: Decided) -> Json = {
  let c = counts_of(p, r);
  object([
    { key: "total", value: num(len(p.cases)) },
    { key: "selected", value: num(selected_count(p, d)) },
    { key: "cached", value: num(cached_count(p, d)) },
    { key: "filtered_out", value: num(p.filtered_out) },
    { key: "groups", value: Array(map(range(0, len(d.classes)), |i: Int| group_json(d, i))) },
    // A host-backed test counts only under `host`, since it is not isolated.
    { key: "isolated", value: num(c.isolated) },
    { key: "shared", value: num(c.shared) },
    { key: "host", value: num(c.host) },
    { key: "parallelism", value: parallelism_json(d.parallelism) },
    { key: "tests", value: Array(map(p.cases, |x: Case| case_json(r, x, d))) },
  ])
}

fn summary_json(c: Summary) -> Json =
  object([
    { key: "passed", value: num(c.passed) },
    { key: "failed", value: num(c.failed) },
    { key: "abandoned", value: num(c.abandoned) },
    { key: "cached", value: num(c.cached) },
    { key: "duration_ms", value: millis(c.duration_us) },
  ])

fn simulated_json(c: Simulated) -> Json =
  object([
    { key: "simulated", value: num(c.simulated) },
    { key: "seeds", value: num(c.seeds) },
    { key: "interleavings", value: num(c.interleavings) },
    { key: "exhaustive", value: num(c.exhaustive) },
    { key: "exhausted", value: num(c.exhausted) },
    { key: "failed", value: num(c.failed) },
  ])

fn backend_json(r: Ran) -> Json =
  match r.backend {
    None -> Null,
    Some(b) ->
      object([
        { key: "name", value: Str(b.name) },
        { key: "fragment", value: num(b.fragment) },
        { key: "offered", value: num(b.offered) },
        { key: "analysis_nanos", value: opt_num(b.analysis_nanos) },
        { key: "codegen_nanos", value: opt_num(b.codegen_nanos) },
        { key: "units", value: opt_num(b.units) },
        { key: "entered", value: num(b.entered) },
        { key: "declined", value: num(b.declined) },
        { key: "converted_in", value: num(b.converted_in) },
        { key: "converted_out", value: num(b.converted_out) },
      ]),
  }

// The two documents `--coverage` and `--mutate` add, each written by the pass that measured it.
fn extra_documents(r: Ran) -> List<Member> = {
  let covered = match r.coverage { None -> [], Some(c) -> [{ key: "coverage", value: c.json }] };
  match r.mutants { None -> covered, Some(m) -> push(covered, { key: "mutants", value: m.json }) }
}

// Bumped whenever a field in the failure artifact changes meaning or leaves.
fn artifact_schema() -> Int = 6

fn document(
  flags: Flags,
  p: Program,
  r: Ran,
  faults: List<Fault>,
  warnings: List<Diag>,
  ok: Bool,
  d: Decided,
) -> Json =
  object(
    appended(
      [
        { key: "command", value: Str("test") },
        { key: "schema_version", value: num(artifact_schema()) },
        {
          key: "front_end",
          value: object([
            { key: "incremental", value: Bool(p.incremental) },
            { key: "phases", value: phases_json(p.phases) },
          ]),
        },
        { key: "ok", value: Bool(ok) },
        { key: "exit_code", value: num(if ok { ok_code() } else { run_failed() }) },
        { key: "root", value: Str(p.root) },
        { key: "files", value: strings(p.files) },
        {
          key: "modules",
          value: Array(
            map(p.modules, |m: ModuleView|
              object([{ key: "name", value: Str(m.name) }, { key: "file", value: Str(m.file) }])),
          ),
        },
        { key: "filters", value: Array(map(flags.filters, |f: String| Str(f))) },
        { key: "no_cache", value: Bool(flags.no_cache) },
        { key: "binding", value: Str(r.label) },
        { key: "hosts", value: r.hosts },
        { key: "workers", value: num(r.workers) },
        { key: "options", value: with_sim(p.options, d.sim) },
        { key: "simulation", value: simulated_json(r.simulation) },
        { key: "backend", value: backend_json(r) },
        { key: "selection", value: selection_json(p, r, d) },
        { key: "summary", value: summary_json(r.summary) },
        { key: "results", value: Array(map(r.results, |o: Outcome| outcome_json(p, o, d))) },
        { key: "failures", value: Array(map(faults, |f: Fault| fault_json(p, f))) },
        // Not a warning: every later run believes an escaped entry.
        { key: "diagnostics", value: all_to_json(r.escapes, p.places) },
        { key: "warnings", value: all_to_json(warnings, p.places) },
      ],
      extra_documents(r),
    ),
  )

// --- The answer -------------------------------------------------------------

// A test failed, was abandoned, a pass escaped into the cache, or a mutant lived.
fn run_failed() -> Int = 1

fn survived(r: Ran) -> Bool = match r.mutants { Some(m) -> m.survived > 0, None -> false }

fn green_run(r: Ran) -> Bool =
  r.summary.failed == 0 && r.summary.abandoned == 0 && len(r.escapes) == 0 && !survived(r)

fn explained(s: Style, flags: Flags, p: Program, r: Ran, d: Decided) -> List<String> =
  if !flags.explain { [] } else { explain_lines(s, p, r, d) }

fn listed(s: Style, p: Program, r: Ran) -> List<String> =
  if len(r.results) == 0 { [] } else { appended([""], result_lines(s, p, r)) }

fn nothing_lines(s: Style, flags: Flags, p: Program) -> List<String> =
  if len(p.cases) > 0 { [] } else { ["", ind() ++ dim(s, no_tests_note(flags, p))] }

fn lines_of(
  s: Style,
  flags: Flags,
  p: Program,
  r: Ran,
  faults: List<Fault>,
  warnings: List<Diag>,
  d: Decided,
) -> List<String> =
  appended(
    appended(
      appended(
        appended(
          appended(
            appended(
              appended(
                appended(
                  appended(head_lines(s, flags, p, r, d), explained(s, flags, p, r, d)),
                  listed(s, p, r),
                ),
                ["", summary_line(s, r, counts_of(p, r))],
              ),
              warned_lines(s, r.escapes),
            ),
            failure_blocks(s, p, faults),
          ),
          abandoned_blocks(s, p, r),
        ),
        nothing_lines(s, flags, p),
      ),
      warned_lines(s, warnings),
    ),
    appended(coverage_lines(s, r), mutant_lines(s, p, r)),
  )

// A lazy read and a later flush can each report the same unreadable file.
fn collected(p: Program, r: Ran) -> List<Diag> =
  fold(appended(p.warnings, r.warnings), [], |acc: List<Diag>, d: Diag|
    if len(filter(acc, |x: Diag| x.code == d.code && x.message == d.message)) > 0 { acc }
    else { push(acc, d) })

fn answered(s: Style, flags: Flags, p: Program, r: Ran, faults: List<Fault>, d: Decided) -> Answer = {
  let warnings = collected(p, r);
  let ok = green_run(r);
  {
    json: document(flags, p, r, faults, warnings, ok, d),
    lines: lines_of(s, flags, p, r, faults, warnings, d),
    errs: [],
    code: if ok { ok_code() } else { run_failed() },
  }
}

// A registration that does not match the program is a start-up failure: nothing ran.
fn unbound(s: Style, refusal: Refusal) -> Answer = {
  let tally = ind() ++ red(s, "no host handler was bound") ++ " ("
    ++ count_of(len(refusal.diags), "error")
    ++ ")";
  {
    json: object([
      { key: "command", value: Str("test") },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: num(compile_error()) },
      { key: "binding", value: Str("host") },
      { key: "diagnostics", value: all_to_json(refusal.diags, refusal.places) },
    ]),
    lines: [],
    errs: push(all_to_text(s, refusal.diags, refusal.places), tally),
    code: compile_error(),
  }
}

pub fn run(
  flags: Flags,
  options: Options,
) -> Answer / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shelf], fs.read_file[shelf], time.elapsed_ms, time.elapsed_us, tester.configure[corpus], tester.loaded[corpus], tester.bound[corpus], tester.footprint[corpus], tester.outcomes[corpus], tester.chosen[corpus], tester.keys[corpus], tester.started[corpus], tester.executed[corpus], tester.interleaved[corpus], tester.concluded[corpus], tester.mutated[corpus], tester.mutant[corpus], tester.mutation[corpus], tester.trial[corpus], tester.record[corpus], store.known[cache], store.file[cache]} = {
  let s: Style = style_of(flags);
  let t: Timed = if options.no_cache { timed_uncached(flags.paths) }
  else { timed_load(flags.paths) };
  match t.program.whole {
    // Every diagnostic, as `check` refuses: an error is the whole answer, so the shelved-module
    // filter a successful load applies to warnings is not applied here.
    None -> refused(s, "test", t.program.diags, t.program.places),
    Some(w) -> match config_schema::refusal(w, options.config.schema) {
      Some(d) -> unbound(s, { diags: [d], places: t.program.places }),
      None -> tests_over(flags, s, options, front_of(t, w)),
    },
  }
}

// The run itself, over the front end `run` loaded.
fn tests_over(
  flags: Flags,
  s: Style,
  options: Options,
  front: Front,
) -> Answer / {tester.configure[corpus], tester.loaded[corpus], tester.bound[corpus], tester.footprint[corpus], tester.outcomes[corpus], tester.chosen[corpus], tester.keys[corpus], tester.started[corpus], tester.executed[corpus], tester.interleaved[corpus], tester.concluded[corpus], tester.mutated[corpus], tester.mutant[corpus], tester.mutation[corpus], tester.trial[corpus], tester.record[corpus]} = {
  tester.configure[corpus](options, front);
  match tester.loaded[corpus]() {
    Err(refusal) -> refused(s, "test", refusal.diags, refusal.places),
    Ok(p) -> {
      // Which tests run is the program's to say, and so is every key the store is asked about or a
      // pass is filed under: the runtime answers what the store holds and does what it is told.
      let searching = machine::sim_plan_of(options.sim);
      let search = search_of(searching);
      let decisions = decide(cases_of(tester.keys[corpus](), search));
      // Which tests may share a worker is the program's to say, from the atoms each row carries;
      // only the rendering of a class is the printer's.
      let classes = classes_of(p, to_run(decisions));
      let decided = decided_of(
        p,
        decisions,
        search,
        sim_json(searching, options.sim),
        fold(classes, [], with_footprint),
        classes,
      );
      tester.chosen[corpus]({
        runs: decided.runs,
        reasons: map(decided.reasons, |e: { index: Int, reason: Reason }| word(e.reason)),
        groups: classes,
        filed: filed(decisions, search),
      });
      match tester.bound[corpus]() {
        Err(refusal) -> unbound(s, refusal),
        Ok(_) -> {
          tester.started[corpus]();
          let asked = {
            plan: searching,
            measuring: options.sim.measure_reduction,
            lanes: match options.jobs {
              Some(n) -> if n > 0 { Some(n) } else { None },
              None -> None,
            },
          };
          let narrowing = narrowed(decisions, search.roots);
          let searched = flat_map(classes, |class: List<Int>|
            settled_of(
              ran_class(map(class, |i: Int| job_of(p, 0, i, narrowing, searching)), asked),
            ));
          let r = mutated(p, tester.concluded[corpus](searched), options, asked);
          // The run is over, so the runtime can be asked about mixtures of what it found; every
          // failure's cause is decided here, before anything renders one.
          let faults = decided_faults(r, diagnosing(options));
          let stored = tester.record[corpus]();
          answered(s, flags, p, { ..r, warnings: appended(r.warnings, stored) }, faults, decided)
        },
      }
    },
  }
}

// --- The run ----------------------------------------------------------------

// The search a seeded test's key is computed against, as the selector reads one.
fn search_of(p: plan::Plan) -> Search =
  {
    mode: plan::mode_word(p.mode),
    roots: map(p.roots, |r: U64| int_of_u64(r)),
    budget: p.budget,
    steps: p.steps,
    path: p.path,
  }

// The whole plan, as the document's options carry it: every field is in a seeded test's key.
fn sim_json(p: plan::Plan, sim: machine::SimOpts) -> Json =
  object([
    { key: "budget", value: num(p.budget) },
    { key: "measure_reduction", value: Bool(sim.measure_reduction) },
    { key: "mode", value: Str(plan::mode_word(p.mode)) },
    { key: "roots", value: Array(map(p.roots, |r: U64| Number(decimal(plan::u64_text(r))))) },
    {
      key: "seed",
      value: match sim.seed {
        Some(text) -> match plan::parse_seed(text) {
          Some(seed) -> Str(plan::seed_text(seed)),
          None -> Null,
        },
        None -> Null,
      },
    },
    { key: "seeds", value: num(len(p.roots)) },
    { key: "steps", value: num(p.steps) },
  ])

fn with_sim(options: Json, sim: Json) -> Json =
  match options { Object(members) -> Object(map_insert(members, "sim", sim)), other -> other }

// What the run's searches are asked: the plan a seeded test searches, whether to measure what the
// pruning saved, and how many lanes run tests at once — one per test when `--jobs` names none.
type Asked = { plan: plan::Plan, measuring: Bool, lanes: Option<Int> }

// One test to run in one unit, and the plan it searches when it is seeded.
type Job = { unit: Int, test: Int, search: Option<plan::Plan> }

// How one test ended, and how its search settled when it searched.
type Done = { test: Int, status: String, settled: Option<Settled> }

// A seeded test searches the roots it still owes; any other runs once.
fn job_of(
  p: Program,
  unit: Int,
  index: Int,
  narrowing: List<{ index: Int, roots: List<Int> }>,
  searching: plan::Plan,
) -> Job =
  {
    unit: unit,
    test: index,
    search: match case_of(p, index) {
      Some(c) -> if !c.seeded { None } else {
        match filter(narrowing, |n: { index: Int, roots: List<Int> }| n.index == index) {
          [owed, ..] -> Some({ ..searching, roots: map(owed.roots, |r: Int| u64_of_int(r)) }),
          [] -> Some(searching),
        }
      },
      None -> None,
    },
  }

fn settled_of(done: List<Done>) -> List<Settled> =
  fold(done, [], |acc: List<Settled>, d: Done|
    match d.settled { Some(st) -> push(acc, st), None -> acc })

// One class's tests at once: each in a lane of its own, or dealt across the lanes `--jobs` names,
// a lane's tests in turn, answered in the class's order.
fn ran_class(
  jobs: List<Job>,
  asked: Asked,
) -> List<Done> / {tester.executed[corpus], tester.interleaved[corpus]} = {
  let lanes = machine::dealt(jobs, asked.lanes);
  machine::undealt(ran_lanes(lanes, asked.measuring, 0, len(lanes)))
}

// Halves under a `parallel` block until one lane is left, so lanes run at once; each lane answers
// with its tests' in turn.
fn ran_lanes(
  lanes: List<List<Job>>,
  measuring: Bool,
  lo: Int,
  hi: Int,
) -> List<List<Done>> / {tester.executed[corpus], tester.interleaved[corpus]} =
  if hi - lo <= 0 { [] } else if hi - lo == 1 {
    match list_at(lanes, lo) {
      Some(lane) -> [fold(lane, [], |out: List<Done>, j: Job| push(out, ran_job(j, measuring)))],
      None -> [],
    }
  } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel {
      ran_lanes(lanes, measuring, lo, mid),
      ran_lanes(lanes, measuring, mid, hi),
    };
    appended(halves._0, halves._1)
  }

// A test once, or a seeded one searched an interleaving at a time.
fn ran_job(
  j: Job,
  measuring: Bool,
) -> Done / {tester.executed[corpus], tester.interleaved[corpus]} =
  match j.search {
    None -> { test: j.test, status: tester.executed[corpus](j.unit, j.test), settled: None },
    Some(p) -> {
      // A search re-runs the whole test, so any host operation runs once per interleaving.
      let again = plan::re_executes(p) || measuring;
      let run = |seed: Seed| tester.interleaved[corpus](j.unit, j.test, seed, p.steps, again);
      let explored = if measuring { search::measure_reduction(p, run) }
      else { search::explore(p, run) };
      {
        test: j.test,
        status: match explored.failure {
          None -> "passed",
          // A recording that names no schedule, or a replay that took another, is Ply's fault.
          Some(fl) -> match search::ran_failure(fl) {
            Some(fell) -> fell.status,
            None -> "panicked",
          },
        },
        settled: Some({
          test: j.test,
          exploration: explored.exploration,
          failure: explored.failure,
          seeds: len(plan::normalized(p).roots),
        }),
      }
    },
  }

// A green run's mutants, judged up to the budget; a red run's survivors would say nothing.
fn mutated(
  p: Program,
  r: Ran,
  options: Options,
  asked: Asked,
) -> Ran / {tester.mutated[corpus], tester.mutant[corpus], tester.mutation[corpus], tester.executed[corpus], tester.interleaved[corpus]} =
  match options.mutate {
    None -> r,
    Some(_) -> if !green_run(r) { r } else {
      let queue = tester.mutated[corpus]();
      if len(queue.refused) > 0 { { ..r, escapes: appended(r.escapes, queue.refused) } } else {
        let every = every_of(p, options);
        let judged = map(take_first(queue.mutants, options.mutate_budget), |m: Queued|
          judged_mutant(p, m, every, asked));
        {
          ..r,
          mutants: Some(
            tester.mutation[corpus](judged, len(queue.mutants) > options.mutate_budget),
          ),
        }
      }
    },
  }

// The tests that reach a mutant, in the classes every test the run reports on was coloured into: a
// subset of a class shares nothing either. Every seed of the plan is owed, and nothing is filed.
fn judged_mutant(
  p: Program,
  m: Queued,
  every: List<List<Int>>,
  asked: Asked,
) -> Judged / {tester.mutant[corpus], tester.executed[corpus], tester.interleaved[corpus]} =
  match tester.mutant[corpus](m.id) {
    Err(j) -> { id: m.id, verdict: j.verdict, why: j.why },
    Ok(unit) -> {
      let classes = filter(
        map(every, |class: List<Int>| filter(class, |i: Int| contains_int(m.tests, i))),
        |class: List<Int>| len(class) > 0,
      );
      let statuses = flat_map(classes, |class: List<Int>|
        map(
          ran_class(map(class, |i: Int| job_of(p, unit, i, [], asked.plan)), {
            ..asked,
            measuring: false,
          }),
          |d: Done| d.status,
        ));
      let expected = fold(classes, 0, |n: Int, class: List<Int>| n + len(class));
      let judged = |verdict: String, why: String| { id: m.id, verdict: verdict, why: why };
      if said(statuses, "failed") { judged("killed", "") }
      else if said(statuses, "panicked") { judged("unresolved", "Ply failed running the tests") }
      else if len(filter(statuses, |w: String| w == "passed")) == expected {
        judged("survived", "")
      } else { judged("unresolved", "not every test answered") }
    },
  }

fn take_first<a>(xs: List<a>, n: Int) -> List<a> =
  fold(range(0, min(n, len(xs))), [], |out: List<a>, i: Int|
    match list_at(xs, i) { Some(x) -> push(out, x), None -> out })

/// What the store holds for each test, asked under the keys this program computes: the key its
/// result is filed under, and — for a seeded test whose plan is answered root by root — each
/// root's own.
fn cases_of(rows: List<Row>, search: Search) -> List<select::Case> / {tester.outcomes[corpus]} = {
  let digest = digest_of(search);
  let keys = map(rows, |r: Row| key_of(r, digest));
  let answers = tester.outcomes[corpus](
    fold(keys, [], |acc: List<String>, k: Option<String>|
      match k { Some(key) -> push(acc, key), None -> acc }),
  );
  // A keyed row's answer is the next one, in the order the keys were asked.
  let held = fold(
    keys,
    { at: 0, out: [] },
    |st: { at: Int, out: List<Option<String>> }, k: Option<String>|
      match k {
        None -> { ..st, out: push(st.out, None) },
        Some(_) -> { at: st.at + 1, out: push(st.out, answer_at(answers, st.at)) },
      },
  ).out;
  map(range(0, len(rows)), |i: Int| {
    let r: Row = at(rows, i, no_row());
    let owed = match r.hash {
      Some(h) -> if answers_per_root(r, search) {
        Some(owed_roots(search.roots, tester.outcomes[corpus](seed_keys(h, search.roots, []))))
      } else { None },
      None -> None,
    };
    select::case_of(r, at(keys, i, None), answer_at(held, i), owed)
  })
}

fn answer_at(answers: List<Option<String>>, i: Int) -> Option<String> =
  match list_at(answers, i) { Some(answer) -> answer, None -> None }

fn no_row() -> Row =
  { index: 0, label: "", name: "", module: "", hash: None, seeded: false, nondet: false }

// --- What decided each cause -------------------------------------------------

/// Every failure's cause, decided before anything renders one.
fn decided_faults(r: Ran, asked: Diagnosing) -> List<Fault> / {tester.trial[corpus]} =
  flat_map(range(0, len(r.failures)), |i: Int|
    match list_at(r.failures, i) { None -> [], Some(f) -> [fault_of(f, i, asked)] })

// What this run's flags ask of a cause: the search mode and the trial budget.
type Diagnosing = { bisect: Mode, budget: Budget }

fn diagnosing(options: Options) -> Diagnosing =
  {
    bisect: match mode_parse(options.bisect) { Some(m) -> m, None -> Auto },
    budget: { max_trials: Some(options.bisect_budget) },
  }

/// One failure's cause. The gate, the change set, the search over it and the ranking of the
/// suspects are `suite.diagnose`'s, over the facts the runtime handed over and a closure that asks
/// it for one mixture at a time.
fn fault_of(f: Failed, index: Int, asked: Diagnosing) -> Fault / {tester.trial[corpus]} = {
  let diff = match f.search { Some(e) -> Some(classified(e.facts)), None -> None };
  let evidence: Evidence = {
    nondet: match f.nondet { Some(x) -> x, None -> false },
    defect: f.defect,
    host: f.host,
    suspects: f.suspects,
    baseline: match f.search { Some(_) -> true, None -> false },
  };
  let a: Attribution = diagnose(
    evidence,
    asked,
    match diff { Some(d) -> Some(d.delta), None -> None },
    match diff { Some(d) -> len(d.unclassified), None -> 0 },
    match diff { Some(d) -> !d.test_unclassified, None -> true },
    |d: Delta, flipped: List<Int>| {
      let keys = flipped_keys(d, flipped);
      tester.trial[corpus](
        index,
        map(keys, |k: DefKey| { name: k.name, ns: ns_word(k.ns) }),
        mixture_filed(f, keys),
      )
    },
    match f.search { Some(e) -> e.absent, None -> None },
  );
  let places = match f.search { Some(e) -> e.at, None -> [] };
  {
    key: f.key,
    name: f.name,
    diagnostic: shown(f.diagnostic),
    defect: f.defect,
    bisect: bisect_of(a.bisection, places),
    suspects: a.suspects,
    unchanged: f.unchanged,
    seed: f.seed,
    race: f.race,
    replay: match f.seed { Some(seed) -> Some(replay_of(seed, f.name)), None -> None },
    module: f.module,
    test_hash: f.test_hash,
    nondet: f.nondet,
    status: f.status,
    declared: f.declared,
  }
}

// The command that replays one interleaving of one test.
fn replay_of(seed: String, name: String) -> String =
  "ply test --seed " ++ seed ++ " --filter \"" ++ name ++ "\""

// A mixture's pass is filed under the test as it is now and as it last passed, the definitions
// taken, and the interleaving the failure took.
fn mixture_filed(f: Failed, keys: List<DefKey>) -> Option<String> =
  match f.search {
    None -> None,
    Some(e) -> match e.facts.own.after {
      None -> None,
      Some(now) ->
        Some(
          hex_of(mixture_key(bytes_of_hex(now), bytes_of_hex(e.facts.own.before), keys, f.seed)),
        ),
    },
  }

// A verdict as the report carries it, with the place of the first of each group's definitions.
fn bisect_of(verdict: Bisection, places: List<{ name: String, at: Option<At> }>) -> Bisect =
  {
    conclusive: is_conclusive(verdict),
    // Silent when no bisection was asked for.
    requested: match verdict.verdict { NotAttempted(NotRequested) -> false, _ -> true },
    reason: verdict.reason,
    culprits: map(verdict.groups, |group: List<String>|
      { names: group, at: first_at(places, group) }),
    verdict: verdict_word(verdict.verdict),
    skipped: match verdict_skipped(verdict.verdict) {
      Some(why) -> Some(skipped_word(why)),
      None -> None,
    },
    confidence: confidence_word(verdict.confidence),
    groups: verdict.groups,
    search: verdict.search,
  }

// Where the first of a group's definitions is: the runtime knows the places and this side knows only
// the names.
fn first_at(at: List<{ name: String, at: Option<At> }>, names: List<String>) -> Option<At> =
  fold(names, None, |found: Option<At>, name: String|
    match found {
      Some(_) -> found,
      None -> match filter(at, |e: { name: String, at: Option<At> }| e.name == name) {
        [] -> None,
        hits -> at_at(hits, 0),
      },
    })

fn at_at(hits: List<{ name: String, at: Option<At> }>, i: Int) -> Option<At> =
  match list_at(hits, i) { Some(hit) -> hit.at, None -> None }

// --- Tests ------------------------------------------------------------------

fn a_diag(code: Bytes, message: Bytes, labels: List<Label>, notes: List<Bytes>) -> Diag =
  {
    code: code,
    notes: len(notes),
    labels: labels,
    text: b"",
    message: message,
    notes_text: notes,
    severity: b"error",
    fixes: [],
  }

fn a_place() -> List<Place> =
  [{ path: "m.ply", text: b"test \"two is two\" { assert_eq(1 + 1, 2) }\n" }]

fn no_phases() -> Phases = { read_us: 0, front_us: 0, write_back_us: 0 }

fn a_hash() -> String = "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"

fn a_key(index: Int, label: String, answered: Bool, seeded: Bool, unstable: Bool) -> select::Case =
  {
    index: index,
    label: label,
    name: "m." ++ label,
    module: "m",
    hash: Some(a_hash()),
    cache_key: Some(a_hash()),
    seeded: seeded,
    nondet: unstable,
    cached: if answered { Some("passed") } else { None },
    owed: None,
  }

fn a_search() -> Search = { mode: "dpor", roots: [0], budget: 256, steps: 100000, path: [] }

fn parsed(argv: List<String>) -> Parsed =
  match parse(surface::spec("0.0.0-test"), argv) { Run(p) -> p, _ -> panic("the line parses") }

fn a_case(index: Int, name: String) -> Case =
  {
    index: index,
    key: "m." ++ name,
    name: name,
    module: "m",
    nondet: false,
    hash: Some(a_hash()),
    footprint: "{}",
    atoms: [],
    seeded: false,
  }

/// The decision a fixture's keys imply: the reasons come from `decide`, so a fixture that wants a
/// cached test says its key was answered rather than naming the reason. The classes are the ones the
/// decision's own runs make, with a placeholder rendering — a fixture reads the shape, not the atoms.
fn a_decided(p: Program, keys: List<select::Case>) -> Decided = {
  let decisions = decide(keys);
  let classes = classes_of(p, to_run(decisions));
  decided_of(
    p,
    decisions,
    a_search(),
    Null,
    map(classes, |class: List<Int>| { tests: class, footprint: "{}" }),
    classes,
  )
}

fn a_program(cases: List<Case>) -> Program =
  {
    root: "/p",
    files: ["m.ply"],
    places: a_place(),
    modules: [{ name: "m", file: "m.ply" }],
    incremental: true,
    phases: no_phases(),
    declared: len(cases),
    cases: cases,
    filtered_out: 0,
    warnings: [],
    options: Null,
  }

fn an_outcome(index: Int, name: String, status: String) -> Outcome =
  {
    index: index,
    name: name,
    hash: None,
    duration_us: 1500,
    status: status,
    diagnostic: None,
    search: None,
    cached: Some(true),
    performs: 0,
  }

fn a_run(results: List<Outcome>, failed: Int) -> Ran =
  {
    hermetic: true,
    label: "hermetic",
    operations: 0,
    digest: "",
    handshakes: [],
    hosts: Null,
    reaches: [],
    workers: 4,
    backend: None,
    results: results,
    failures: [],
    summary: {
      passed: len(filter(results, |o: Outcome| o.status == "passed")),
      failed: failed,
      abandoned: len(filter(results, |o: Outcome| o.status == "abandoned")),
      cached: 0,
      duration_us: 20000,
    },
    simulation: {
      simulated: 0,
      total: len(results),
      seeds: 0,
      interleavings: 0,
      exhaustive: 0,
      exhausted: 0,
      failed: 0,
    },
    escapes: [],
    warnings: [],
    mutants: None,
    coverage: None,
  }

fn no_bisect() -> Bisect =
  {
    conclusive: false,
    requested: false,
    reason: "",
    culprits: [],
    verdict: "not_attempted",
    skipped: Some("not_requested"),
    confidence: "none",
    groups: [],
    search: {
      candidates: 0,
      clusters: 0,
      evaluated: 0,
      cached: 0,
      memoized: 0,
      unresolved: 0,
      exhausted: false,
    },
  }

fn a_fault() -> Fault =
  {
    key: "m.two is two",
    name: "two is two",
    diagnostic: a_diag(b"E0502", b"assertion failed", [], []),
    defect: false,
    bisect: no_bisect(),
    suspects: [],
    unchanged: false,
    seed: None,
    race: None,
    replay: None,
    module: Some("m"),
    test_hash: None,
    nondet: Some(false),
    status: Some("failed"),
    declared: None,
  }

fn a_suspect(name: String) -> Suspect =
  { name: name, hash: None, before: None, change: None, culprit: false }

// A failure the runtime reports with two edits since its test last passed.
fn a_failed(defect: Bool, host: Bool, absent: Option<Skipped>) -> Failed =
  {
    key: "m.two is two",
    name: "two is two",
    diagnostic: { diag: a_diag(b"E0501", b"assertion failed", [], []), values: [] },
    defect: defect,
    host: host,
    search: Some({
      facts: {
        own: { name: "m.two is two", before: "01", after: Some("02"), rehashed: Some("01") },
        rows: [
          {
            name: "m.a",
            ns: Value,
            before: Some("a1"),
            after: Some("a2"),
            rehashed: Some("a2"),
            stable: None,
            kept: false,
            renamed: false,
            component: [],
            referrers: [],
          },
          {
            name: "m.b",
            ns: Value,
            before: Some("b1"),
            after: Some("b2"),
            rehashed: Some("b2"),
            stable: None,
            kept: false,
            renamed: false,
            component: [],
            referrers: [],
          },
        ],
      },
      absent: absent,
      at: [],
    }),
    suspects: [{ name: "m.a", hash: Some("a2") }, { name: "m.b", hash: Some("b2") }],
    unchanged: false,
    seed: None,
    race: None,
    module: Some("m"),
    test_hash: None,
    nondet: Some(false),
    status: Some("failed"),
    declared: None,
  }

// The verdict on one failure, from a runtime whose mixtures fail exactly when they take `m.b`.
fn caused(f: Failed) -> Bisect =
  handle {
    fault_of(f, 0, { bisect: Auto, budget: { max_trials: Some(64) } }).bisect
  } with {
    tester.trial[corpus](failure, keys, filed) -> taking_b_fails(keys),
  }

fn taking_b_fails(keys: List<{ name: String, ns: String }>) -> Trial =
  if len(filter(keys, |k: { name: String, ns: String }| k.name == "m.b")) > 0 { a_failure() }
  else { a_pass() }

test "a green run is exit 0, and the head says what was selected of what" {
  let p = a_program([a_case(0, "one"), a_case(1, "two")]);
  let keys = [a_key(0, "one", false, false, false), a_key(1, "two", true, false, false)];
  let answer = answered(
    plain(),
    from_argv("test", []),
    p,
    a_run([an_outcome(0, "one", "passed")], 0),
    [],
    a_decided(p, keys),
  );
  assert_eq(answer.code, 0);
  assert_eq(at(answer.lines, 0, ""), "   selected 1 of 2 (1 cached)");
  assert_eq(at(answer.lines, 1, ""), "   1 group · 4 workers");
  assert_eq(answer.errs, [])
}

test "a failure is exit 1 and the culprit is printed before the diff" {
  let p = a_program([a_case(0, "two is two")]);
  let keys = [a_key(0, "two is two", false, false, false)];
  let culprit = {
    ..a_fault(),
    bisect: {
      ..no_bisect(),
      conclusive: true,
      requested: true,
      reason: "narrowed to one body",
      culprits: [{ names: ["m.total"], at: None }],
    },
  };
  let answer = answered(
    plain(),
    from_argv("test", []),
    p,
    a_run([an_outcome(0, "two is two", "failed")], 1),
    [culprit],
    a_decided(p, keys),
  );
  assert_eq(answer.code, 1);
  assert(said(answer.lines, "   m.two is two"));
  assert(said(answer.lines, "     culprit: m.total"));
  assert(said(answer.lines, "       narrowed to one body"));
  assert(said(answer.lines, "     assertion failed"))
}

test "a bisection nobody asked for says nothing, and one that failed says why" {
  assert_eq(bisect_lines(plain(), a_place(), no_bisect()), []);
  assert_eq(
    bisect_lines(plain(), a_place(), {
      ..no_bisect(),
      requested: true,
      reason: "no baseline to compare",
    }),
    ["  no culprit: no baseline to compare"],
  )
}

test "the runtime's marks decide whether a failure is searched, and a search names the edit" {
  assert_eq(caused(a_failed(false, false, None)).groups, [["m.b"]]);
  // A defect in Ply and a run that reached the host are refused before any mixture is tried.
  let defect = caused(a_failed(true, false, None));
  assert_eq(defect.skipped, Some("panicked"));
  assert_eq(defect.search.evaluated, 0);
  let host = caused(a_failed(false, true, None));
  assert_eq(host.skipped, Some("host"));
  assert_eq(host.search.evaluated, 0);
  // Two edits need a mixture to tell apart, so a store that cannot build one is the reason.
  let pruned = caused(a_failed(false, false, Some(NoBodies)));
  assert_eq(pruned.skipped, Some("no_bodies"));
  assert_eq(pruned.search.evaluated, 0)
}

test "a test the clock stopped is abandoned rather than judged, and the run is not a success" {
  let p = a_program([a_case(0, "slow")]);
  let keys = [a_key(0, "slow", false, false, false)];
  let stopped = {
    ..an_outcome(0, "slow", "abandoned"),
    diagnostic: Some({
      diag: a_diag(b"E0504", b"the run was abandoned", [], [b"raise the clock"]),
      values: [],
    }),
  };
  let answer = answered(
    plain(),
    from_argv("test", []),
    p,
    a_run([stopped], 0),
    [],
    a_decided(p, keys),
  );
  assert_eq(answer.code, 1);
  assert(said(answer.lines, "   slow abandoned"));
  assert(said(answer.lines, "     the run was abandoned"));
  assert(said(answer.lines, "     = raise the clock"))
}

// A pass a later hermetic run would believe is not a warning: the run is red over it.
test "an escaped cache entry fails the run even with every test green" {
  let p = a_program([a_case(0, "one")]);
  let keys = [a_key(0, "one", false, false, false)];
  let escaped = {
    ..a_run([an_outcome(0, "one", "passed")], 0),
    escapes: [a_diag(b"E0001", b"`m.one` can reach the host binding", [], [])],
  };
  assert_eq(answered(plain(), from_argv("test", []), p, escaped, [], a_decided(p, keys)).code, 1)
}

test "a mutant no test kills fails the run and is named with what it changed" {
  let p = a_program([a_case(0, "one")]);
  let keys = [a_key(0, "one", false, false, false)];
  let mutated = {
    ..a_run([an_outcome(0, "one", "passed")], 0),
    mutants: Some({
      killed: 2,
      survived: 1,
      skipped: 0,
      budget_spent: false,
      unreached: [],
      survivors: [{ definition: "m.total", from: "+", to: "-", at: None }],
      json: Null,
    }),
  };
  let answer = answered(plain(), from_argv("test", []), p, mutated, [], a_decided(p, keys));
  assert_eq(answer.code, 1);
  assert(said(answer.lines, "   mutants 2 killed, 1 survived, 0 skipped"));
  assert(said(answer.lines, "      m.total survives `+` -> `-` at "))
}

test "the mark is a word in a plain run and one glyph in a styled one" {
  assert_eq(marked(plain(), "passed"), "ok     ");
  assert_eq(marked(plain(), "failed"), "FAIL   ");
  assert_eq(marked(plain(), "panicked"), "PANIC  ");
  assert_eq(marked(plain(), "abandoned"), "GAVE UP");
  assert_eq(bytes_of_string(marked({ styled: true }, "passed")), b"\x1b[32m\xe2\x9c\x93\x1b[0m")
}

test "a result line pads the name to the column and the reading to one decimal" {
  let p = a_program([a_case(0, "two is two")]);
  let keys = [a_key(0, "two is two", false, false, false)];
  assert_eq(
    result_line(plain(), p, an_outcome(0, "two is two", "passed"), 24),
    "   ok      two is two                    1.5ms",
  )
}

// The column never narrows below 24 and never widens past 64, so long names still line up.
test "the name column is the widest name, clamped" {
  let p = a_program([]);
  assert_eq(name_column(p, a_run([], 0)), 24);
  assert_eq(name_column(p, a_run([an_outcome(0, repeated("x", 30), "passed")], 0)), 30);
  assert_eq(name_column(p, a_run([an_outcome(0, repeated("x", 90), "passed")], 0)), 64)
}

test "the summary counts what was decided and how long it took" {
  let p = a_program([a_case(0, "one")]);
  let r = a_run([an_outcome(0, "one", "passed")], 0);
  assert_eq(summary_line(plain(), r, counts_of(p, r)), "   0 failed, 1 passed, 0 cached (0.02s)");
  let hosted = { ..r, reaches: [0] };
  assert(
    string_contains(
      summary_line(plain(), hosted, counts_of(p, hosted)),
      "1 host-backed and not cached",
    ),
  )
}

test "a reason is spaced in the line and joined in the document" {
  assert_eq(keyed(word(PreviousFailure)), "previous_failure");
  assert_eq(keyed(word(New)), "new");
  assert_eq(word(Nondet), "nondet");
  assert_eq(word(Unhashed), "unhashed")
}

test "`--explain` says why each test ran, once per reason, and how the groups formed" {
  let p = a_program([a_case(0, "one"), a_case(1, "two")]);
  let keys = [a_key(0, "one", false, false, false), a_key(1, "two", true, false, false)];
  let lines = explain_lines(plain(), p, a_run([], 0), a_decided(p, keys));
  assert(string_contains(at(lines, 1, ""), "run  abcdef012345 new "));
  assert(string_contains(at(lines, 1, ""), "isolation: region"));
  assert(string_contains(at(lines, 2, ""), "skip abcdef012345 cached "));
  assert(said(lines, "   why"));
  assert(said(lines, "   concurrency groups"));
  // One class, holding the one test that runs: a cached test shares a worker with nobody.
  assert(said(lines, "     group 0 · 1 test · {}"));
  assert(said(lines, "       one"))
}

test "the document keys off `command` and `exit_code` and names the schema it publishes" {
  let p = a_program([a_case(0, "one")]);
  let keys = [a_key(0, "one", false, false, false)];
  let text = to_string(
    answered(
      plain(),
      from_argv("test", ["--json"]),
      p,
      a_run([an_outcome(0, "one", "passed")], 0),
      [],
      a_decided(p, keys),
    ).json,
  );
  assert(string_contains(text, "\"command\":\"test\""));
  assert(string_contains(text, "\"exit_code\":0"));
  assert(string_contains(text, "\"schema_version\":6"));
  assert(string_contains(text, "\"binding\":\"hermetic\""));
  assert(string_contains(text, "\"root\":\"/p\""));
  assert(string_contains(text, "\"duration_ms\":1.5"));
  assert(string_contains(text, "\"reason\":\"new\""))
}

// The seed a test reads is handed to it alone, so it is no atom another test contends over.
test "a test's contended atoms are in the document unprinted, beside whether it is seeded" {
  let c = {
    ..a_case(0, "one"),
    atoms: [
      { atom: { effect: "cell", resource: "users", writes: true }, text: "cell.write[users]" },
      { atom: { effect: "sim", resource: "", writes: false }, text: "sim.read" },
    ],
    seeded: true,
  };
  let text = to_string(
    case_json(a_run([], 0), c, a_decided(a_program([c]), [a_key(0, "one", false, false, false)])),
  );
  assert(
    string_contains(
      text,
      "\"contends\":[{\"effect\":\"cell\",\"resource\":\"users\",\"writes\":true}]",
    ),
  );
  assert(string_contains(text, "\"seeded\":true"));
  assert(string_contains(text, "\"shared_atoms\":[\"cell.write[users]\"]"))
}

// Everything a reader or an agent needs to act on a failure is in its artifact: what failed, whether
// it is Ply's fault, how to replay it, where the race was, and the cause, led by the culprit.
test "a failure's artifact says what failed, how to replay it, and what caused it" {
  let p = a_program([a_case(0, "two is two")]);
  let site = { task: "t1", definition: Some("m.bump"), access: "write", at: None };
  let raced = {
    ..a_fault(),
    seed: Some("0:1.0"),
    replay: Some(replay_of("0:1.0", "two is two")),
    race: Some({ left: site, right: { ..site, task: "t2" }, step: 3 }),
    suspects: [{ ..a_suspect("m.bump"), change: Some(Edited), culprit: true }],
  };
  let text = to_string(fault_json(p, raced));
  assert(string_contains(text, "\"key\":\"m.two is two\""));
  assert(string_contains(text, "\"name\":\"two is two\""));
  assert(string_contains(text, "\"defect\":false"));
  assert(string_contains(text, "\"module\":\"m\""));
  assert(string_contains(text, "\"status\":\"failed\""));
  assert(string_contains(text, "\"nondet\":false"));
  assert(string_contains(text, "\"replay\":\"ply test --seed 0:1.0 --filter \\\"two is two\\\"\""));
  assert(string_contains(text, "\"at\":3"));
  assert(string_contains(text, "\"task\":\"t2\""));
  assert(string_contains(text, "\"change\":\"edited\""));
  assert(string_contains(text, "\"culprit\":true"));
  // A test that searched nothing has no seed, so nothing replays it and no race is named.
  let plain_fault = to_string(fault_json(p, a_fault()));
  assert(string_contains(plain_fault, "\"replay\":null"));
  assert(string_contains(plain_fault, "\"race\":null"))
}

test "a program with no tests at all says so, and one narrowed to none says that instead" {
  let empty = { ..a_program([]), declared: 0 };
  assert(
    said(
      answered(plain(), from_argv("test", []), empty, a_run([], 0), [], a_decided(empty, [])).lines,
      "   no `test` items in this program",
    ),
  );
  let hidden = { ..a_program([]), declared: 3, filtered_out: 3 };
  assert(
    said(
      answered(
        plain(),
        from_argv("test", ["--filter=none"]),
        hidden,
        a_run([], 0),
        [],
        a_decided(hidden, []),
      ).lines,
      "   no test key contains a `--filter` substring; nothing was verified",
    ),
  )
}

test "a suspect is named with what changed" {
  assert_eq(described(a_suspect("m.total")), "m.total");
  assert_eq(described({ ..a_suspect("m.total"), change: Some(Edited) }), "m.total (edited)")
}

test "the repro is a seed and the command that replays it" {
  let f = {
    ..a_fault(),
    seed: Some("0:0.1.0.2"),
    replay: Some(replay_of("0:0.1.0.2", "two is two")),
  };
  assert_eq(seed_lines(plain(), a_place(), f), [
    "  seed: 0:0.1.0.2",
    "  replay: ply test --seed 0:0.1.0.2 --filter \"two is two\"",
  ])
}

test "a search says what it explored and what a blind and an unpruned one would have cost" {
  let e: Explored = {
    explored: 12,
    exhaustive: true,
    exhausted: false,
    blind: Some({ explored: 30, bounded: false, rendered: "30" }),
    naive: Some({ explored: 120, bounded: false, rendered: "120" }),
    reduction_tenths: Some(100),
    steps: 8,
    virtual_time_ns: 0,
    failing_seed: None,
  };
  assert_eq(
    joined(search_parts(e), " · "),
    "12 interleavings · exhaustive · blind 30 · naive 120 · 10× reduction",
  );
  let doc = to_string(search_json(e));
  assert(string_contains(doc, "\"blind\":{\"bounded\":false,\"explored\":30,\"rendered\":\"30\"}"));
  assert(
    string_contains(doc, "\"naive\":{\"bounded\":false,\"explored\":120,\"rendered\":\"120\"}"),
  );
  let unmeasured = { ..e, blind: None, naive: None, reduction_tenths: None };
  assert_eq(joined(search_parts(unmeasured), " · "), "12 interleavings · exhaustive");
  assert(string_contains(to_string(search_json(unmeasured)), "\"blind\":null"))
}

test "the simulation line counts the searches and says a spent budget out loud" {
  let quiet = a_run([], 0);
  assert_eq(simulation_line(plain(), quiet), []);
  let counted = {
    simulated: 3,
    total: 47,
    seeds: 3,
    interleavings: 61,
    exhaustive: 3,
    exhausted: 0,
    failed: 0,
  };
  assert_eq(simulation_line(plain(), { ..quiet, simulation: counted }), [
    ind() ++ "simulated: 3 of 47 · 61 interleavings · 3 exhaustive",
  ]);
  let spent = {
    ..counted,
    simulated: 1,
    total: 1,
    interleavings: 256,
    exhaustive: 0,
    exhausted: 1,
  };
  assert_eq(simulation_line(plain(), { ..quiet, simulation: spent }), [
    ind() ++ "simulated: 1 of 1 · 256 interleavings · 1 budget spent, not cached",
  ])
}

test "a phase reading is two decimals of a millisecond, longest phase first" {
  assert_eq(phase_lines(plain(), { ..no_phases(), read_us: 2000, front_us: 98000 }), [
    "",
    "   front-end time",
    "     front          98.00ms  98.0%",
    "     read            2.00ms   2.0%",
    "     write back      0.00ms   0.0%",
    "     total         100.00ms",
  ])
}

// A socket lives outside every region, so a test the binding can reach is neither isolated nor
// cached, whatever its footprint says.
test "a test the binding can reach is host rather than isolated" {
  let c = a_case(0, "one");
  let hermetic = a_run([], 0);
  assert_eq(isolated_as(hermetic, c), "region");
  assert_eq(isolated_as({ ..hermetic, reaches: [0] }, c), "host");
  // A test is shared exactly when one of the atoms the row carries can be contended over, and a
  // seed it reads is not one of them.
  let fs_write = {
    atom: { effect: "fs", resource: "/tmp/x", writes: true },
    text: "fs.write[/tmp/x]",
  };
  let seed = { atom: { effect: "sim", resource: "", writes: false }, text: "sim.read" };
  assert_eq(isolated_as(hermetic, { ..c, atoms: [seed] }), "region");
  assert_eq(isolated_as(hermetic, { ..c, atoms: [seed, fs_write] }), "shared");
  assert_eq(shared_of({ ..c, atoms: [seed, fs_write] }), "{fs.write[/tmp/x]}")
}

// Contention a rename would remove is what losing the fork costs, so `--explain` names it, and a
// test that also reaches a real resource is not blamed on its label.
test "`--explain` names and counts the tests that contend only over a region label" {
  let cell = |label: String|
    {
      atom: { effect: "cell", resource: label, writes: true },
      text: "cell.write[" ++ label ++ "]",
    };
  let ledger = {
    atom: { effect: "db", resource: "ledger", writes: true },
    text: "db.write[ledger]",
  };
  let labelled = { ..a_case(0, "one"), atoms: [cell("users")] };
  let mixed = { ..a_case(1, "two"), atoms: [cell("orders"), ledger] };
  assert_eq(explain_atoms("shared", labelled), " {cell.write[users]} (region labels)");
  assert_eq(explain_atoms("shared", mixed), " {cell.write[orders], db.write[ledger]}");
  assert_eq(explain_atoms("region", a_case(2, "three")), "");
  let p = a_program([labelled, mixed, a_case(2, "three")]);
  let keys = [
    a_key(0, "one", false, false, false),
    a_key(1, "two", false, false, false),
    a_key(2, "three", false, false, false),
  ];
  let r = a_run([], 0);
  assert_eq(
    group_tally(plain(), counts_of(p, r), a_decided(p, keys)),
    ind()
      ++ "  1 of 3 region-isolated and free · 1 group for the 2 shared tests · 1 of them only over a region label",
  )
}

// Only a run that re-runs every test whatever the cache held needs classes over all of them.
test "classes over every test are coloured only for a mutation" {
  let cell = |label: String|
    {
      atom: { effect: "cell", resource: label, writes: true },
      text: "cell.write[" ++ label ++ "]",
    };
  let p = a_program([
    { ..a_case(0, "one"), atoms: [cell("a")] },
    { ..a_case(1, "two"), atoms: [cell("a")] },
    a_case(2, "three"),
  ]);
  let options = options_from(parsed(["test"]), "/p");
  assert_eq(every_of(p, options), []);
  assert_eq(every_of(p, { ..options, mutate: Some("*") }), [[0, 2], [1]])
}

test "a bound run says how many tests reach the host, what it bound and what it shook hands on" {
  let bound = {
    ..a_run([], 0),
    hermetic: false,
    label: "host",
    operations: 7,
    digest: "b3:aabbccddeeff",
    handshakes: ["handshakes: 1 completed, 0 refused"],
  };
  let c = { total: 3, isolated: 1, shared: 0, host: 2 };
  assert_eq(binding_lines(plain(), bound, c), [
    "   host 2 of 3 · not cached",
    "   binding host · 7 operations · b3:aabbccddeeff",
    "   handshakes: 1 completed, 0 refused",
  ]);
  assert_eq(binding_lines(plain(), a_run([], 0), c), [])
}

test "a label is bare in a single-module run and qualified across several" {
  let one = a_program([a_case(0, "same")]);
  let c = at(one.cases, 0, a_case(0, ""));
  assert_eq(display_of(one, c), "same");
  let two = {
    ..one,
    modules: [{ name: "alpha", file: "alpha.ply" }, { name: "beta", file: "beta.ply" }],
  };
  assert_eq(display_of(two, c), "m.same")
}

// A deadlock's cycle lives only in its secondary labels, so each is printed where it points.

test "a failure's other labels are printed under it, each with its own place" {
  let d = a_diag(
    b"E0414",
    b"these tasks are deadlocked",
    [
      { module: 0, start: 0, end: 4, primary: true, text: b"here" },
      { module: 0, start: 5, end: 16, primary: false, text: b"waits on `b`" },
    ],
    [],
  );
  assert_eq(at_lines(plain(), a_place(), d), ["    at m.ply:1:1"]);
  assert_eq(secondary_lines(plain(), a_place(), d), ["    waits on `b`   m.ply:1:6"])
}

test "a bounded naive count makes the ratio a lower bound" {
  let e: Explored = {
    explored: 12,
    exhaustive: false,
    exhausted: false,
    blind: Some({ explored: 40, bounded: false, rendered: "40" }),
    naive: Some({ explored: 4096, bounded: true, rendered: ">= 4096" }),
    reduction_tenths: Some(3413),
    steps: 8,
    virtual_time_ns: 0,
    failing_seed: None,
  };
  assert_eq(
    joined(search_parts(e), " · "),
    "12 interleavings · blind 40 · naive >= 4096 · >= 341× reduction",
  )
}

test "every reason has an explanation of its own" {
  let lines = map(["new", "nondet", "previous failure", "cached", "unhashed"], why);
  assert_eq(len(lines), 5);
  assert_eq(
    len(
      filter(range(0, 5), |i: Int|
        len(filter(range(0, 5), |j: Int| at(lines, i, "") == at(lines, j, ""))) == 1),
    ),
    5,
  )
}

test "a load that refuses tallies its errors and binds nothing" {
  let answer = refused(plain(), "test", [a_diag(b"E0201", b"type mismatch", [], [])], []);
  assert_eq(answer.code, 2);
  assert_eq(answer.errs, ["Error[E0201]: type mismatch", "   compilation failed (1 error)"])
}

test "a binding that does not match the program is a start-up failure naming no line" {
  let answer = unbound(plain(), {
    diags: [a_diag(b"E0412", b"a nondet effect in a det test", [], [])],
    places: [],
  });
  assert_eq(answer.code, 2);
  assert_eq(answer.errs, [
    "Error[E0412]: a nondet effect in a det test",
    "   no host handler was bound (1 error)",
  ])
}

test "a seeded test searches the roots it still owes, and any other runs once" {
  let p = a_program([a_case(0, "plain"), { ..a_case(1, "seeded"), seeded: true }]);
  let searching = plan::random(4);
  assert_eq(job_of(p, 0, 0, [], searching), { unit: 0, test: 0, search: None });
  assert_eq(job_of(p, 0, 1, [], searching).search, Some(searching));
  assert_eq(job_of(p, 2, 1, [{ index: 1, roots: [2, 3] }], searching), {
    unit: 2,
    test: 1,
    search: Some({ ..searching, roots: [2u64, 3u64] }),
  })
}

test "the search a seeded test is keyed on is the plan the flags name, and the document says it" {
  let p = machine::sim_plan_of({
    ..machine::no_sim_options(),
    mode: "random",
    roots: Some({ from: 0, to: 3 }),
  });
  assert_eq(search_of(p), { mode: "random", roots: [0, 1, 2], budget: 1, steps: 100000, path: [] });
  let seeded = { ..machine::no_sim_options(), seed: Some("0x10:2") };
  let doc = to_string(with_sim(object([]), sim_json(machine::sim_plan_of(seeded), seeded)));
  assert(string_contains(doc, "\"seed\":\"16:2\""));
  assert(string_contains(doc, "\"mode\":\"once\""));
  assert(string_contains(doc, "\"roots\":[16]"))
}
