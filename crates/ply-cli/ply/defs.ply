//! `ply defs` — every definition of the program with its place, hash, signature and footprint.

import compiler.front (viewed_text)
import compiler.unit (shipped)
import std.random (entropy)
import std.time (time)
import answers
import builder (builder)
import args (Flags, kept, no_flags, style_of)
import env (env)
import program (Program, Tables, Timed, published, tables_of, location_of, place_of, is_shipped,
                hash_of, own_of, deps_of, specs_of, short_of, timed_over)
import sources (Embed, load_resolved)
import report (Answer, schema_version, ok_code, count_of, indent, refused)
import style (Style, bold, dim)
import compiler.hash (no_hashes)
import compiler.infer (DefInfo)
import compiler.termination (Ends, unknown_summary)
import compiler.types (TyCon, TyFn, row_text, scheme_text)
import std.fs (fs)
import std.json (Json, Null, Str, Bool, Number, Array, Object, object, parse_string, string_or_null,
                 to_string)

pub fn scheme_of(def_info: DefInfo) -> String / {abort.raise} =
  string_of_bytes_lossy(scheme_text(def_info.scheme))

pub fn footprint_of(def_info: DefInfo) -> String / {abort.raise} =
  string_of_bytes_lossy(row_text({ atoms: def_info.footprint, tail: None }))

pub fn performed_of(def_info: DefInfo) -> String / {abort.raise} =
  string_of_bytes_lossy(row_text({ atoms: def_info.performed, tail: None }))

fn wanted(flags: Flags, def_info: DefInfo) -> Bool =
  !is_shipped(string_of_bytes_lossy(def_info.module))
    && kept(flags.filters, string_of_bytes_lossy(def_info.name))

fn file_of(p: Program, def_info: DefInfo) -> Json =
  match place_of(p, def_info.at) { Some(place) -> Str(place.path), None -> Null }

fn definition_json(program: Program, tables: Tables, def_info: DefInfo) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(string_of_bytes_lossy(def_info.name)) },
    { key: "module", value: Str(string_of_bytes_lossy(def_info.module)) },
    { key: "simple_name", value: Str(string_of_bytes_lossy(def_info.simple_name)) },
    { key: "location", value: string_or_null(location_of(program, def_info.at)) },
    { key: "file", value: file_of(program, def_info) },
    { key: "start", value: Number(decimal_of_int(def_info.at.span.start)) },
    { key: "end", value: Number(decimal_of_int(def_info.at.span.end)) },
    { key: "hash", value: string_or_null(hash_of(tables, def_info.name)) },
    { key: "own", value: string_or_null(own_of(tables, def_info.name)) },
    { key: "type", value: Str(scheme_of(def_info)) },
    { key: "footprint", value: Str(footprint_of(def_info)) },
    { key: "performed", value: Str(performed_of(def_info)) },
    { key: "specs", value: Number(decimal_of_int(specs_of(tables, def_info.name))) },
    { key: "deps", value: Array(map(deps_of(tables, def_info.name), |n: String| Str(n))) },
  ])

fn short_or_blank(tables: Tables, def_info: DefInfo) -> String / {abort.raise} =
  match hash_of(tables, def_info.name) { Some(h) -> short_of(h), None -> "" }

fn place_or_blank(p: Program, def_info: DefInfo) -> String / {abort.raise} =
  match location_of(p, def_info.at) { Some(l) -> l, None -> "" }

fn text_lines(
  style: Style,
  program: Program,
  tables: Tables,
  defs: List<DefInfo>,
) -> List<String> / {abort.raise} =
  fold(defs, [""], |acc: List<String>, def_info: DefInfo|
    push(
      push(
        acc,
        indent() ++ dim(style, short_or_blank(tables, def_info)) ++ "  "
          ++ bold(style, string_of_bytes_lossy(def_info.name))
          ++ "  "
          ++ dim(style, place_or_blank(program, def_info)),
      ),
      indent() ++ indent() ++ scheme_of(def_info) ++ " / " ++ footprint_of(def_info),
    ))

fn answered(
  style: Style,
  program: Program,
  tables: Tables,
  defs: List<DefInfo>,
) -> Answer / {abort.raise} =
  {
    json: object([
      { key: "command", value: Str("defs") },
      { key: "schema_version", value: Number(decimal_of_int(schema_version())) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
      {
        key: "definitions",
        value: Array(map(defs, |def_info: DefInfo| definition_json(program, tables, def_info))),
      },
      { key: "diagnostics", value: Array([]) },
    ]),
    lines: push(
      push(text_lines(style, program, tables, defs), ""),
      indent() ++ count_of(len(defs), "definition"),
    ),
    errs: [],
    code: ok_code(),
  }

/// The listing `argv` asks for, taken back where an earlier run of the same command line kept it and
/// it still stands, else listed from a load and kept beside its views and the embeds it read.
pub fn run(
  flags: Flags,
  argv: List<String>,
) -> Answer / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], env.var[sys], env.pwd[sys], time.elapsed_ms, entropy.next, time.now_ms, abort.raise, diverges, shipped.reached} = {
  let started = time.elapsed_ms();
  let project = load_resolved(flags.paths);
  let key = answers::key_of(answers::program(), argv, project);
  match match answers::kept_standing(flags.paths, key, project) {
      Some(k) -> match parse_string(k.json) {
        Ok(Object(members)) ->
          Some({
            json: Object(
              map_insert(
                members,
                "front_end",
                object([{ key: "reused", value: Bool(true) }, { key: "key", value: Str(key) }]),
              ),
            ),
            lines: k.lines,
            errs: k.errs,
            code: k.code,
          }),
        _ -> None,
      },
      None -> None,
    } {
    Some(answer) -> answer,
    None -> {
      let t: Timed = timed_over(flags.paths, project, started);
      let loaded: Program = t.program;
      match loaded.whole {
        None -> refused(style_of(flags), "defs", loaded.diags, loaded.places),
        Some(w) -> {
          let answer = answered(
            style_of(flags),
            loaded,
            tables_of(w.hashes),
            filter(published(w), |def_info: DefInfo| wanted(flags, def_info)),
          );
          if loaded.reached {
            answers::keep(flags.paths, key, {
              opening: [],
              lines: answer.lines,
              errs: answer.errs,
              code: answer.code,
              json: to_string(answer.json),
              passes: [],
              views: viewed_text(loaded.viewed),
              embeds: map(project.embeds, |e: Embed| answers::embedding_of(e.embedded)),
            })
          };
          answer
        },
      }
    },
  }
}

// --- Tests ------------------------------------------------------------------

fn nullary(name: Bytes, module: Bytes, simple: Bytes) -> DefInfo =
  {
    name: name,
    module: module,
    simple_name: simple,
    scheme: {
      ty_vars: [],
      row_vars: [],
      label_vars: [],
      ty: TyFn({
        params: [],
        ret: TyCon({ name: b"Int", args: [] }),
        effects: { atoms: [], tail: None },
      }),
    },
    footprint: [],
    performed: [],
    scaling: [],
    repeats: [],
    bounded: [],
    tail_bounded: false,
    ending: Ends,
    summary: unknown_summary(),
    row_aliases: [],
    constraints: [],
    spec: [],
    at: { module: 0, span: { start: 20, end: 40 } },
  }

fn flags_of(filters: List<String>) -> Flags = { ..no_flags(), filters: filters }

test "only the program's own definitions are listed, and `--filter` cuts by program-wide name" {
  let mine = nullary(b"m.three", b"m", b"three");
  let shipped = nullary(b"std.json.to_string", b"std.json", b"to_string");
  assert(wanted(flags_of([]), mine));
  assert(!wanted(flags_of([]), shipped));
  assert(wanted(flags_of(["thr"]), mine));
  assert(!wanted(flags_of(["two"]), mine))
}

test "a definition with no row and no variables prints the way the reference prints it" {
  let d = nullary(b"m.two", b"m", b"two");
  assert_eq(scheme_of(d), "() -> Int");
  assert_eq(footprint_of(d), "{}");
  assert_eq(performed_of(d), "{}")
}

test "a listing opens and closes with a blank line and ends on the tally" {
  let p: Program = {
    files: [],
    places: [{ path: "m.ply", text: b"fn two() -> Int = 1\n" }],
    diags: [],
    cache_warnings: [],
    whole: None,
    pkgs: { root: b"", manifest: None, supplied: [] },
    through: [],
    embeds: [],
    shipping: { read: [], unread: [], data: [], asked: [] },
    reached: true,
    viewed: [],
  };
  let tables: Tables = {
    defs: map_new(),
    own: map_new(),
    deps: map_new(),
    specs: map_new(),
    hashes: no_hashes(),
  };
  let answer = answered(style_of(flags_of([])), p, tables, [nullary(b"m.two", b"m", b"two")]);
  assert_eq(answer.code, 0);
  assert_eq(answer.lines, [
    "",
    "     m.two  m.ply:2:1",
    "      () -> Int / {}",
    "",
    "   1 definition",
  ])
}
