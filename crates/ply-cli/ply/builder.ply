// The `builder` effect: what `ply build` asks the Rust side for. The declarations live in a
// module of their own because two commands ask: `ply build` builds, and the walk every command
// takes fetches the git dependencies it meets. Each answer is what that step did, so the program
// never holds a front end, a compiled unit or a file handle.

import diagnostic (Place)
import lock (Pinned)
import compiler.plyx (Head, Section)
import compiler.resolve (Diag)
import entry (At, Main, Module)

pub nondet effect builder {
  read loaded[r](root: String) -> Result<Loaded, Refusal>
  read made[r](entry: String, startup: List<String>, reaches: Bool) -> Result<Made, Refusal>
  // The artifact `--diff` names, read before the program was entered; only `--diff` asks.
  read previous[r](diff: Option<String>) -> Result<Previous, Refusal>
  write stored[r](path: String, body: Bytes) -> Result<Unit, Refusal>
  // A library's unit: every definition of the package's own modules, compiled with no entry.
  read unit[r](names: List<String>) -> Result<Compiled, Refusal>
  // A git dependency's tree: fetched once per project, and answered by the directory it is in.
  read git[r](root: String, key: String) -> Result<String, Refusal>
}

// What the unit op answers: the head fields every container records, and one section's payload.
pub type Compiled = { head: Head, count: Int, payload: Bytes }

// `places` is filled by the load alone, whose labels point into the program's own files.
pub type Refusal = { diags: List<Diag>, places: List<Place> }

// One definition `--entry`, `--config-schema` or `--db-schema` may name; a shipped module's are
// already out.
pub type Def = { name: String, simple: String, module: String, at: At, arity: Int }

pub type Loaded = {
  // The root the load was rooted at, as a report prints it.
  root: String,
  defs: List<Def>,
  // What a build with no `--entry` picks its entry from: the question `ply run` asks, asked here
  // of the same lists and answered by `entry` for both.
  mains: List<Main>,
  modules: List<Module>,
  places: List<Place>,
  // Each dependency as the front end pinned it: what `ply.lock` records.
  pins: List<Pinned>,
  // `None` when the running binary cannot be measured, which never fails a build.
  binary_bytes: Option<Int>,
  version: String,
}

pub type Named = { name: String, hash: String }

// One definition and what it reaches, restricted to the artifact; only `--diff` asks for these,
// and they are the largest thing that crosses.
pub type Reach = { name: String, reaches: List<String> }

pub type Made = {
  entry: String,
  entry_hash: String,
  startup: List<String>,
  head: Head,
  sections: List<Section>,
  definitions: Int,
  names: List<Named>,
  unit: Bool,
  reaches: List<Reach>,
  warnings: List<Diag>,
}

pub type Previous = { digest: String, names: List<Named>, warnings: List<Diag> }
