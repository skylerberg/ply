// The `builder` effect: `ply build` reads back the program it builds, which `build` answers from
// the front end it is handed, and the walk every command takes asks for the git dependencies it
// meets, which `vcs` fetches.

import compiler.load (LoadedAnalysis)
import diagnostic (Place)
import lock (Pinned)
import compiler.resolve (Diag)
import entry (Main, Module)

pub nondet effect builder {
  // The program a front end's answer describes, as a build reports and pins it.
  read loaded[r](root: String, front: LoadedAnalysis) -> Result<Loaded, Refusal>
  // A git dependency's tree, by the directory it is in: fetched once per project, and `None` when
  // it could not be.
  read git[r](root: String, key: String) -> Option<String>
}

// `places` is filled by the load alone, whose labels point into the program's own files.
pub type Refusal = { diags: List<Diag>, places: List<Place> }

pub type Loaded = {
  // The root the load was rooted at, as a report prints it.
  root: String,
  // What a build with no `--entry` picks its entry from: the question `ply run` asks, asked here
  // of the same lists and answered by `entry` for both.
  mains: List<Main>,
  modules: List<Module>,
  places: List<Place>,
  // Each dependency as the front end pinned it: what `ply.lock` records.
  pins: List<Pinned>,
  // `None` when the running binary cannot be measured, which never fails a build.
  binary_bytes: Option<Int>,
  version: String,
}
