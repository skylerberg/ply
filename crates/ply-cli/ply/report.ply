// What a command answers with: one JSON document for `--json`, the lines it would print instead,
// and the code the run exits with. One shape for every command, so an agent can key off `command`
// and `exit_code`.

import compiler.resolve (Diag)
import diagnostic (Place, all_to_json, all_to_text, errors_of)
import std.json (Json, Str, Bool, Number, object)
import style (Style, plain, dim, red, yellow)

// Lines for stdout, lines for stderr, and the code. None of them end in a newline.
pub type Answer = { json: Json, lines: List<String>, errs: List<String>, code: Int }

pub fn ind() -> String = "   "

pub fn schema_version() -> Int = 1

pub fn ok_code() -> Int = 0

pub fn compile_error() -> Int = 2

pub fn plural(n: Int, word: String) -> String =
  if n == 1 { word }
  else if string_ends_with(word, "y") && !ends_in_vowel(string_slice(word, 0, string_len(word) - 1)) {
    string_slice(word, 0, string_len(word) - 1) ++ "ies"
  } else { word ++ "s" }

fn ends_in_vowel(stem: String) -> Bool =
  string_ends_with(stem, "a") || string_ends_with(stem, "e") || string_ends_with(stem, "i") ||
  string_ends_with(stem, "o") || string_ends_with(stem, "u")

pub fn count_of(n: Int, word: String) -> String = int_to_string(n) ++ " " ++ plural(n, word)

fn severity_label(s: Style, severity: Bytes) -> String =
  if severity == b"error" { red(s, "error") }
  else if severity == b"warning" { yellow(s, "warning") }
  else { dim(s, "note") }

// Cache and scheduling trouble is one indented line each, not a full report.
pub fn warning_lines(s: Style, ds: List<Diag>) -> List<String> =
  fold(ds, [], |acc: List<String>, d: Diag|
    fold(d.notes_text, push(acc, ind() ++ severity_label(s, d.severity) ++ ": "
                                 ++ string_of_bytes_lossy(d.message)),
         |a: List<String>, n: Bytes|
           push(a, ind() ++ "  " ++ dim(s, "=") ++ " " ++ string_of_bytes_lossy(n))))

// Diagnostics in the command's own shape, and always exit 2.
pub fn reported(s: Style, command: String, diags: List<Diag>, places: List<Place>) -> Answer =
  { json: object([{ key: "command", value: Str(command) },
                  { key: "ok", value: Bool(false) },
                  { key: "exit_code", value: Number(decimal_of_int(compile_error())) },
                  { key: "diagnostics", value: all_to_json(diags, places) }]),
    lines: [],
    errs: all_to_text(s, diags, places),
    code: compile_error() }

// A program that did not load: the same, with the tally the load prints under it.
pub fn refused(s: Style, command: String, diags: List<Diag>, places: List<Place>) -> Answer = {
  let answer: Answer = reported(s, command, diags, places);
  let errors = len(errors_of(diags));
  let tally = ind() ++ red(s, "compilation failed") ++ " (" ++ count_of(errors, "error") ++ ")";
  {..answer, errs: push(answer.errs, tally)}
}

// --- Tests ------------------------------------------------------------------

test "a plural is the word for one and the word plus `s` otherwise, with `y` becoming `ies`" {
  assert_eq(plural(1, "definition"), "definition");
  assert_eq(plural(2, "definition"), "definitions");
  assert_eq(plural(0, "module"), "modules");
  assert_eq(plural(2, "entry"), "entries");
  assert_eq(plural(2, "day"), "days");
  assert_eq(count_of(1, "error"), "1 error");
  assert_eq(count_of(3, "test"), "3 tests")
}

test "a refusal is exit 2, one JSON document, and the count on the last line" {
  let d: Diag = { code: b"E0201", notes: 0, labels: [], text: b"", message: b"type mismatch",
                  notes_text: [], severity: b"error", fixes: [] };
  let answer = refused(plain(), "defs", [d], []);
  assert_eq(answer.code, 2);
  assert_eq(answer.lines, []);
  assert_eq(answer.errs, ["Error[E0201]: type mismatch", "   compilation failed (1 error)"])
}

test "a warning is one indented line, and each note one under it" {
  let d: Diag = { code: b"W0611", notes: 1, labels: [], text: b"", message: b"fn `m.dead` is never used",
                  notes_text: [b"delete it or export it"], severity: b"warning", fixes: [] };
  assert_eq(warning_lines(plain(), [d]),
            ["   warning: fn `m.dead` is never used", "     = delete it or export it"])
}
