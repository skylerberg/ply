// The command line, as the Rust side spells it. `clap` has already refused an unknown flag and
// every value it takes travels in the flag's own word, so a word that is not a flag named here is
// a positional path.

import cmdline
import cmdline (Parsed, has, nth_of, value)
import paths
import paths (Resolved)
import surface
import std.path (strip_dot)
import style (Style)

pub type Flags = {
  check: Bool,
  json: Bool,
  all: Bool,
  deps: Bool,
  types: Bool,
  costs: Bool,
  explain: Bool,
  color: Bool,
  digest: Bool,
  no_cache: Bool,
  watch: Bool,
  // What the load was rooted at, as the Rust side would print it; the paths below are relative to it.
  root: String,
  // The subcommand `clap` parsed, for a command that has them.
  action: String,
  query: String,
  filter: String,
  filtered: Bool,
  // The digest of the modules this binary ships, which is the binary's own fact, not the tree's.
  shipped_digest: String,
  // `None` is the flag left off, which is never what an empty value means.
  entry: Option<String>,
  config_schema: Option<String>,
  db_schema: Option<String>,
  out: Option<String>,
  profile: Option<String>,
  diff: Option<String>,
  paths: List<Resolved>,
  // Words spelled like flags that no arm above claims. A path is never one of these: `--` is how
  // a path that begins with `-` is written.
  unknown: List<String>,
}

pub fn no_flags() -> Flags =
  {
    check: false,
    json: false,
    all: false,
    deps: false,
    types: false,
    costs: false,
    explain: false,
    color: false,
    digest: false,
    no_cache: false,
    watch: false,
    root: ".",
    action: "",
    query: "",
    filter: "",
    filtered: false,
    shipped_digest: "",
    entry: None,
    config_schema: None,
    db_schema: None,
    out: None,
    profile: None,
    diff: None,
    paths: [],
    unknown: [],
  }

pub fn style_of(f: Flags) -> Style = { styled: f.color }

fn value_of(arg: String, key: String) -> String =
  string_slice(arg, string_len(key), string_len(arg))

fn one(acc: Flags, arg: String) -> Flags =
  if arg == "--check" { { ..acc, check: true } }
  else if arg == "--json" { { ..acc, json: true } }
  else if arg == "--all" { { ..acc, all: true } }
  else if arg == "--deps" { { ..acc, deps: true } }
  else if arg == "--digest" { { ..acc, digest: true } }
  else if arg == "--no-cache" { { ..acc, no_cache: true } }
  else if arg == "--watch" { { ..acc, watch: true } }
  else if arg == "--types" { { ..acc, types: true } }
  else if arg == "--costs" { { ..acc, costs: true } }
  else if arg == "--explain" { { ..acc, explain: true } }
  else if arg == "--color=always" { { ..acc, color: true } }
  else if arg == "--color=never" { { ..acc, color: false } }
  else { carried(acc, arg) }

// A flag whose value travels in its own word, else the positional path a bare word is.
fn carried(acc: Flags, arg: String) -> Flags =
  if string_starts_with(arg, "--root=") { { ..acc, root: value_of(arg, "--root=") } }
  else if string_starts_with(arg, "--action=") { { ..acc, action: value_of(arg, "--action=") } }
  else if string_starts_with(arg, "--query=") { { ..acc, query: value_of(arg, "--query=") } } else if string_starts_with(
      arg,
      "--shipped-digest=",
    ) { { ..acc, shipped_digest: value_of(arg, "--shipped-digest=") } } else if string_starts_with(
      arg,
      "--filter=",
    ) { { ..acc, filter: value_of(arg, "--filter="), filtered: true } }
  else if string_starts_with(arg, "--entry=") { { ..acc, entry: Some(value_of(arg, "--entry=")) } } else if string_starts_with(
      arg,
      "--config-schema=",
    ) { { ..acc, config_schema: Some(value_of(arg, "--config-schema=")) } } else if string_starts_with(
      arg,
      "--db-schema=",
    ) { { ..acc, db_schema: Some(value_of(arg, "--db-schema=")) } }
  else if string_starts_with(arg, "--out=") { { ..acc, out: Some(value_of(arg, "--out=")) } }
  else if string_starts_with(arg, "--output=") { { ..acc, out: Some(value_of(arg, "--output=")) } }
  else if string_starts_with(arg, "--diff=") { { ..acc, diff: Some(value_of(arg, "--diff=")) } }
  else if names(machine_bool(), arg) || fused_machine(arg) { acc }
  else if string_starts_with(arg, "-") && arg != "-" { { ..acc, unknown: push(acc.unknown, arg) } }
  else { as_path(acc, arg) }

// `--jobs=4` and the like: known, read by the machine, and nothing to this program.
fn fused_machine(arg: String) -> Bool =
  fold(machine_valued(), false, |acc: Bool, f: String| acc || string_starts_with(arg, f ++ "="))

fn as_path(acc: Flags, arg: String) -> Flags = acc

// The flags whose value may stand in the next word instead of their own. A word here is never a
// path, so the word after it is never read as one either.
pub fn valued() -> List<String> =
  [
    "--root",
    "--action",
    "--query",
    "--shipped-digest",
    "--filter",
    "--entry",
    "--config-schema",
    "--db-schema",
    "--out",
    "--output",
    "--diff",
    "--color",
  ]

// Flags that configure the machine this program runs on rather than the report it writes. The
// parser must know them to read a line at all — a value of theirs is not a path — though the
// program itself reads none of them. `ply-cli-tests` holds these lists against what `clap`
// declares, so a flag added on either side cannot go missing here.
pub fn machine_valued() -> List<String> =
  [
    "--backend",
    "--bisect",
    "--bisect-budget",
    "--config",
    "--db",
    "--db-acquire-ms",
    "--db-connect-ms",
    "--db-idle-txn-ms",
    "--db-pool",
    "--db-statement-cache",
    "--db-statement-ms",
    "--drain-lead-ms",
    "--drain-ms",
    "--exec",
    "--fs",
    "--jobs",
    "--mutate",
    "--mutate-budget",
    "--profile",
    "--prove-budget",
    "--prove-cases",
    "--prove-roots",
    "--prove-steps",
    "--seed",
    "--seeds",
    "--set",
    "--show",
    "--shrink-budget",
    "--sim",
    "--sim-budget",
    "--sim-steps",
    "--steps",
    "--timeout",
    "--tls",
    "--trace",
    "--trace-level",
    "--trust",
    "--with",
  ]

pub fn machine_bool() -> List<String> =
  [
    "--accept",
    "--changed",
    "--coverage",
    "--host",
    "--measure-reduction",
    "--no-incremental",
    "--std",
    "--verify",
  ]

fn names(list: List<String>, want: String) -> Bool =
  fold(list, false, |acc: Bool, s: String| acc || s == want)

// Whether a word is a flag that takes the word after it, which a reader looking for the command
// word must skip along with the flag itself.
pub fn takes_value(arg: String) -> Bool =
  names(valued(), arg) || names(machine_valued(), arg)
    || (match long_of(arg) { Some(_) -> true, None -> false })

// The long spelling a short flag stands for. `-o` is `--output` to `clap`, which the Rust side
// re-encodes as `--out`; both names reach this parser and mean the same field.
fn long_of(arg: String) -> Option<String> = if arg == "-o" { Some("--out") } else { None }

// Where the reading has got to: the flags so far, a flag still owed its value, and whether `--`
// has been passed, after which every word is a path whatever it looks like.
type Reading = { flags: Flags, owed: Option<String>, ended: Bool }

// A value in the next word is read as the word it would have been fused into, so a flag is
// spelled out in one place however it was written.
fn step(r: Reading, arg: String) -> Reading =
  match r.owed {
    Some(key) -> { ..r, flags: one(r.flags, key ++ "=" ++ arg), owed: None },
    None -> if r.ended { { ..r, flags: as_path(r.flags, arg) } }
    else if arg == "--" { { ..r, ended: true } } else {
      match long_of(arg) {
        Some(long) -> { ..r, owed: Some(long) },
        None -> if names(valued(), arg) || names(machine_valued(), arg) { { ..r, owed: Some(arg) } }
        else { { ..r, flags: one(r.flags, arg) } },
      }
    },
  }

// A flag left owed a value at the end of the line is dropped; refusing it is the same work as
// refusing an unknown flag, and belongs with it.
pub fn read(args: List<String>) -> Flags =
  fold(args, { flags: no_flags(), owed: None, ended: false }, |r: Reading, arg: String|
    step(r, arg)).flags

// --- Tests ------------------------------------------------------------------

test "`-o`, `--out` and `--output` name one field, however they are written" {
  let short = read(["-o", "out.plyx"]);
  assert_eq(short.out, Some("out.plyx"));
  assert_eq(short.paths, []);
  // `--output` is what `clap` calls it and `--out` is what the Rust side re-encodes it to; a
  // parser that knew only one of them would refuse the other.
  assert_eq(read(["--output", "out.plyx"]).out, Some("out.plyx"));
  assert_eq(read(["--output=out.plyx"]).out, Some("out.plyx"));
  assert_eq(read(["--out", "out.plyx"]).out, Some("out.plyx"));
  assert_eq(read(["--output", "out.plyx"]).unknown, [])
}

test "a value that looks like a flag is still that flag's value" {
  let flags = read(["--filter", "--json"]);
  assert_eq(flags.filter, "--json");
  assert(!flags.json)
}

test "colour is the Rust side's answer, since a program has no terminal to ask" {
  assert(!style_of(read([])).styled);
  assert(style_of(read(["--color=always"])).styled);
  assert(!style_of(read(["--color=always", "--color=never"])).styled)
}

test "the flags a report widens itself with are read like any other" {
  let flags = read(["--types", "--costs", "--explain", "--no-cache", "--watch"]);
  assert(flags.types);
  assert(flags.costs);
  assert(flags.explain);
  assert(flags.no_cache);
  assert(flags.watch);
  let bare = read([]);
  assert(!bare.types);
  assert(!bare.costs);
  assert(!bare.explain);
  assert(!bare.no_cache);
  assert(!bare.watch)
}

test "a flag that takes a value carries it in its own word" {
  let flags = read([
    "--root=/tmp/p",
    "--action=stats",
    "--query=m.two",
    "--filter=thr",
    "--deps",
    "--all",
    "--digest",
    "--shipped-digest=b3:1f2e3d4c5b6a",
  ]);
  assert_eq(flags.root, "/tmp/p");
  assert_eq(flags.action, "stats");
  assert_eq(flags.query, "m.two");
  assert_eq(flags.filter, "thr");
  assert_eq(flags.shipped_digest, "b3:1f2e3d4c5b6a");
  assert(flags.filtered);
  assert(flags.deps);
  assert(flags.all);
  assert(flags.digest);
  assert_eq(flags.paths, [])
}

test "an empty value is a value, not a missing one" {
  let flags = read(["--filter="]);
  assert(flags.filtered);
  assert_eq(flags.filter, "");
  assert_eq(flags.paths, []);
  assert_eq(read(["--entry="]).entry, Some(""))
}

test "the flags a build is named with are absent until they are written" {
  let bare = read([]);
  assert_eq(bare.entry, None);
  assert_eq(bare.config_schema, None);
  assert_eq(bare.db_schema, None);
  assert_eq(bare.out, None);
  assert_eq(bare.diff, None);
  let flags = read([
    "--entry=app.serve",
    "--config-schema=m.spec",
    "--db-schema=m.tables",
    "--out=dist/app.plyx",
    "--diff=old.plyx",
  ]);
  assert_eq(flags.entry, Some("app.serve"));
  assert_eq(flags.config_schema, Some("m.spec"));
  assert_eq(flags.db_schema, Some("m.tables"));
  assert_eq(flags.out, Some("dist/app.plyx"));
  assert_eq(flags.diff, Some("old.plyx"));
  assert_eq(flags.paths, [])
}

// --- The adapter: a parsed line as the Flags the commands read -----------------------------

// What the parser's positionals mean depends on the command: a query command's first is the name
// it looks up, and every command's path is the last one standing.
fn query_of(command: String, p: Parsed) -> String =
  if command == "doc" || command == "show" || command == "callers" || command == "replace" {
    nth_of(p.positionals, 0, "")
  } else if command == "explain" { nth_of(p.positionals, 0, "") }
  else if command == "cache" && nth_of(p.path, 1, "") == "inspect" { nth_of(p.positionals, 0, "") }
  else if command == "std" { match value(p, "show") { Some(m) -> m, None -> "" } }
  else { "" }

pub fn from_parsed(p: Parsed, styled: Bool, root: String, resolved: List<Resolved>) -> Flags = {
  let command = nth_of(p.path, 0, "");
  {
    check: has(p, "check"),
    json: has(p, "json"),
    all: has(p, "all"),
    deps: has(p, "deps"),
    types: has(p, "types"),
    costs: has(p, "costs"),
    explain: has(p, "explain"),
    color: styled,
    digest: has(p, "digest"),
    no_cache: has(p, "no-cache"),
    watch: has(p, "watch"),
    root: root,
    action: match nth_of(p.path, 1, "") {
      "" -> if has(p, "verify") { "verify" } else if has(p, "accept") { "accept" } else { "" },
      sub -> sub,
    },
    query: query_of(command, p),
    filter: match value(p, "filter") { Some(f) -> f, None -> "" },
    filtered: has(p, "filter"),
    shipped_digest: "",
    entry: value(p, "entry"),
    config_schema: value(p, "config-schema"),
    db_schema: value(p, "db-schema"),
    out: match value(p, "output") {
      Some(o) -> Some(o),
      None -> if command == "replace" { value(p, "with") } else { value(p, "out") },
    },
    profile: value(p, "profile"),
    diff: value(p, "diff"),
    paths: resolved,
    unknown: [],
  }
}

// The Flags for a test's line, parsed as the launcher parses it: the command word leads, as on
// the line itself.
pub fn from_argv(command: String, argv: List<String>) -> Flags =
  match cmdline::parse(
      surface::spec("0.0.0-test"),
      fold(argv, [command], |acc: List<String>, w: String| push(acc, w)),
    ) {
    cmdline::Run(p) ->
      from_parsed(p, false, ".", map(p.positionals, |spelling: String| paths::at_cwd(spelling))),
    _ -> no_flags(),
  }
