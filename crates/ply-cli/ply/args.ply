//! The command line as the commands read it. `std.cli` has already refused an unknown flag and
//! parsed every value into its flag, so this module is only the adapter from that parse to the
//! `Flags` record the commands take, and an entry that builds one from a test's argument list.

import std.cli
import std.cli (Parsed, has, value, values_of)
import paths
import paths (Resolved, Rooted)
import surface
import style (Style)
import std.list (at_or)

pub type Flags = {
  check: Bool,
  json: Bool,
  all: Bool,
  deps: Bool,
  types: Bool,
  costs: Bool,
  explain: Bool,
  /// `ply prove --reach`: ask the static tier about every obligation the run reports on.
  reach: Bool,
  color: Bool,
  digest: Bool,
  no_cache: Bool,
  /// `ply test --kept`: answer only from a kept answer, loading nothing.
  kept: Bool,
  watch: Bool,
  /// `--workspace`: the run is repeated for every package the path reaches by a path dependency.
  workspace: Bool,
  /// `--verify-deps`: the load reads every dependency from source and holds what was published to it.
  verify_deps: Bool,
  /// What the load was rooted at, as the launcher resolved it; the paths below are relative to it.
  root: String,
  /// The subcommand a command that has them was parsed with.
  action: String,
  query: String,
  /// Every `--filter` substring, in order; a command whose flag is not repeatable has at most one.
  filters: List<String>,
  /// `None` is the flag left off, which is never what an empty value means.
  entry: Option<String>,
  config_schema: Option<String>,
  out: Option<String>,
  profile: Option<String>,
  diff: Option<String>,
  /// `--sign`: the secret key file a build signs what it writes with.
  sign: Option<String>,
  /// `--require-signer`: the public key files an artifact must be signed by one of.
  signers: List<String>,
  paths: List<Resolved>,
}

pub fn no_flags() -> Flags =
  {
    check: false,
    json: false,
    all: false,
    deps: false,
    types: false,
    costs: false,
    explain: false,
    reach: false,
    color: false,
    digest: false,
    no_cache: false,
    kept: false,
    watch: false,
    workspace: false,
    verify_deps: false,
    root: ".",
    action: "",
    query: "",
    filters: [],
    entry: None,
    config_schema: None,
    out: None,
    profile: None,
    diff: None,
    sign: None,
    signers: [],
    paths: [],
  }

pub fn style_of(flags: Flags) -> Style = { styled: flags.color }

/// Whether `--filter` keeps `key`: no filter keeps everything, and any one substring keeps it.
pub fn kept(filters: List<String>, key: String) -> Bool =
  len(filters) == 0 || fold(filters, false, |hit: Bool, f: String| hit || string_contains(key, f))

// --- The adapter: a parsed line as the Flags the commands read -----------------------------

/// What the parser's positionals mean depends on the command: a query command's first is the name
/// it looks up, and every command's path is the last one standing.
fn query_of(command: String, p: Parsed) -> String =
  if command == "doc" || command == "show" || command == "callers" || command == "replace"
      || command == "why" { at_or(p.positionals, 0, "") }
  else if command == "explain" { at_or(p.positionals, 0, "") }
  else if command == "cache" && at_or(p.path, 1, "") == "inspect" { at_or(p.positionals, 0, "") }
  else if command == "std" { match value(p, "show") { Some(m) -> m, None -> "" } }
  else { "" }

pub fn from_parsed(parsed: Parsed, styled: Bool, root: String, resolved: List<Resolved>) -> Flags = {
  let command = at_or(parsed.path, 0, "");
  {
    check: has(parsed, "check"),
    json: has(parsed, "json"),
    all: has(parsed, "all"),
    deps: has(parsed, "deps"),
    types: has(parsed, "types"),
    costs: has(parsed, "costs"),
    explain: has(parsed, "explain"),
    reach: has(parsed, "reach"),
    color: styled,
    digest: has(parsed, "digest"),
    no_cache: has(parsed, "no-cache"),
    kept: has(parsed, "kept"),
    watch: has(parsed, "watch"),
    workspace: has(parsed, "workspace"),
    verify_deps: has(parsed, "verify-deps"),
    root: root,
    action: match at_or(parsed.path, 1, "") {
      "" -> if has(parsed, "verify") { "verify" }
      else if has(parsed, "accept") { "accept" }
      else { "" },
      sub -> sub,
    },
    query: query_of(command, parsed),
    filters: values_of(parsed, "filter"),
    entry: value(parsed, "entry"),
    config_schema: value(parsed, "config-schema"),
    out: match value(parsed, "output") {
      Some(o) -> Some(o),
      None -> if command == "replace" { value(parsed, "with") } else { value(parsed, "out") },
    },
    profile: value(parsed, "profile"),
    diff: value(parsed, "diff"),
    sign: value(parsed, "sign"),
    signers: values_of(parsed, "require-signer"),
    paths: resolved,
  }
}

/// The Flags for a test's line, parsed as the launcher parses it: the command word leads, as on
/// the line itself, and every path is spelled under the working directory as given.
pub fn from_argv(command: String, argv: List<String>) -> Flags / {abort.raise} =
  match cli::parse(
      surface::spec("0.0.0-test"),
      fold(argv, [command], |acc: List<String>, w: String| push(acc, w)),
    ) {
    cli::Run(p) ->
      from_parsed(p, false, ".", map(p.positionals, |spelling: String| paths::at_cwd(spelling))),
    _ -> no_flags(),
  }

pub fn root_of(flags: Flags) -> Resolved =
  match list_at(flags.paths, 0) { Some(r) -> r, None -> paths::here() }

// --- Tests ------------------------------------------------------------------

test "colour is the launcher's answer, since a program has no terminal to ask" {
  assert(!style_of(no_flags()).styled);
  assert(style_of({ ..no_flags(), color: true }).styled)
}

test "a build's named flags reach the fields they name, however they are written" {
  assert_eq(from_argv("build", ["--output=out.plyx"]).out, Some("out.plyx"));
  assert_eq(from_argv("build", ["-o", "out.plyx"]).out, Some("out.plyx"));
  assert_eq(from_argv("build", ["--entry="]).entry, Some(""));
  let named = from_argv("build", [
    "--entry=app.serve",
    "--config-schema=m.spec",
    "--diff=old.plyx",
  ]);
  assert_eq(named.entry, Some("app.serve"));
  assert_eq(named.config_schema, Some("m.spec"));
  assert_eq(named.diff, Some("old.plyx"))
}

test "a query command's first positional is the name it looks up" {
  assert_eq(from_argv("doc", ["std.json"]).query, "std.json");
  assert_eq(from_argv("std", ["--show", "std.hash"]).query, "std.hash");
  assert_eq(from_argv("std", []).query, "");
  assert_eq(from_argv("explain", ["E0001"]).query, "E0001")
}

test "a line the parser refuses leaves the defaults rather than half a set of flags" {
  let refused = from_argv("build", ["--nope"]);
  assert_eq(refused.entry, None);
  assert(!refused.json);
  assert_eq(refused.paths, [])
}

test "`ply test`'s `--filter` repeats, and a key any one of them matches is kept" {
  let filters = from_argv("test", ["--filter", "a.", "--filter", "b.x"]).filters;
  assert_eq(filters, ["a.", "b.x"]);
  assert(kept(filters, "b.xy"));
  assert(!kept(filters, "c.x"));
  assert(kept([], "c.x"))
}
