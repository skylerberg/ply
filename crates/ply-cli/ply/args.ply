// The command line, as the Rust side spells it. `clap` has already refused an unknown flag and
// every value it takes travels in the flag's own word, so a word that is not a flag named here is
// a positional path.

import std.path (strip_dot)
import style (Style)

pub type Flags = {
  check: Bool,
  json: Bool,
  all: Bool,
  deps: Bool,
  types: Bool,
  costs: Bool,
  explain: Bool,
  color: Bool,
  digest: Bool,
  no_cache: Bool,
  watch: Bool,
  // What the load was rooted at, as the Rust side would print it; the paths below are relative to it.
  root: String,
  // The subcommand `clap` parsed, for a command that has them.
  action: String,
  query: String,
  filter: String,
  filtered: Bool,
  // The digest of the modules this binary ships, which is the binary's own fact, not the tree's.
  shipped_digest: String,
  // `None` is the flag left off, which is never what an empty value means.
  entry: Option<String>,
  config_schema: Option<String>,
  db_schema: Option<String>,
  out: Option<String>,
  diff: Option<String>,
  paths: List<String>,
}

pub fn no_flags() -> Flags =
  {
    check: false,
    json: false,
    all: false,
    deps: false,
    types: false,
    costs: false,
    explain: false,
    color: false,
    digest: false,
    no_cache: false,
    watch: false,
    root: ".",
    action: "",
    query: "",
    filter: "",
    filtered: false,
    shipped_digest: "",
    entry: None,
    config_schema: None,
    db_schema: None,
    out: None,
    diff: None,
    paths: [],
  }

pub fn style_of(f: Flags) -> Style = { styled: f.color }

fn value_of(arg: String, key: String) -> String =
  string_slice(arg, string_len(key), string_len(arg))

fn one(acc: Flags, arg: String) -> Flags =
  if arg == "--check" { { ..acc, check: true } }
  else if arg == "--json" { { ..acc, json: true } }
  else if arg == "--all" { { ..acc, all: true } }
  else if arg == "--deps" { { ..acc, deps: true } }
  else if arg == "--digest" { { ..acc, digest: true } }
  else if arg == "--no-cache" { { ..acc, no_cache: true } }
  else if arg == "--watch" { { ..acc, watch: true } }
  else if arg == "--types" { { ..acc, types: true } }
  else if arg == "--costs" { { ..acc, costs: true } }
  else if arg == "--explain" { { ..acc, explain: true } }
  else if arg == "--color=always" { { ..acc, color: true } }
  else if arg == "--color=never" { { ..acc, color: false } }
  else { carried(acc, arg) }

// A flag whose value travels in its own word, else the positional path a bare word is.
fn carried(acc: Flags, arg: String) -> Flags =
  if string_starts_with(arg, "--root=") { { ..acc, root: value_of(arg, "--root=") } }
  else if string_starts_with(arg, "--action=") { { ..acc, action: value_of(arg, "--action=") } }
  else if string_starts_with(arg, "--query=") { { ..acc, query: value_of(arg, "--query=") } } else if string_starts_with(
      arg,
      "--shipped-digest=",
    ) { { ..acc, shipped_digest: value_of(arg, "--shipped-digest=") } } else if string_starts_with(
      arg,
      "--filter=",
    ) { { ..acc, filter: value_of(arg, "--filter="), filtered: true } }
  else if string_starts_with(arg, "--entry=") { { ..acc, entry: Some(value_of(arg, "--entry=")) } } else if string_starts_with(
      arg,
      "--config-schema=",
    ) { { ..acc, config_schema: Some(value_of(arg, "--config-schema=")) } } else if string_starts_with(
      arg,
      "--db-schema=",
    ) { { ..acc, db_schema: Some(value_of(arg, "--db-schema=")) } }
  else if string_starts_with(arg, "--out=") { { ..acc, out: Some(value_of(arg, "--out=")) } }
  else if string_starts_with(arg, "--diff=") { { ..acc, diff: Some(value_of(arg, "--diff=")) } }
  else { as_path(acc, arg) }

fn as_path(acc: Flags, arg: String) -> Flags = { ..acc, paths: push(acc.paths, strip_dot(arg)) }

// The flags whose value may stand in the next word instead of their own. A word here is never a
// path, so the word after it is never read as one either.
fn valued() -> List<String> =
  [
    "--root",
    "--action",
    "--query",
    "--shipped-digest",
    "--filter",
    "--entry",
    "--config-schema",
    "--db-schema",
    "--out",
    "--diff",
    "--color",
  ]

fn names(list: List<String>, want: String) -> Bool =
  fold(list, false, |acc: Bool, s: String| acc || s == want)

// The long spelling a short flag stands for.
fn long_of(arg: String) -> Option<String> = if arg == "-o" { Some("--out") } else { None }

// Where the reading has got to: the flags so far, a flag still owed its value, and whether `--`
// has been passed, after which every word is a path whatever it looks like.
type Reading = { flags: Flags, owed: Option<String>, ended: Bool }

// A value in the next word is read as the word it would have been fused into, so a flag is
// spelled out in one place however it was written.
fn step(r: Reading, arg: String) -> Reading =
  match r.owed {
    Some(key) -> { ..r, flags: one(r.flags, key ++ "=" ++ arg), owed: None },
    None -> if r.ended { { ..r, flags: as_path(r.flags, arg) } }
    else if arg == "--" { { ..r, ended: true } } else {
      match long_of(arg) {
        Some(long) -> { ..r, owed: Some(long) },
        None -> if names(valued(), arg) { { ..r, owed: Some(arg) } }
        else { { ..r, flags: one(r.flags, arg) } },
      }
    },
  }

// A flag left owed a value at the end of the line is dropped; refusing it is the same work as
// refusing an unknown flag, and belongs with it.
pub fn read(args: List<String>) -> Flags =
  fold(args, { flags: no_flags(), owed: None, ended: false }, |r: Reading, arg: String|
    step(r, arg)).flags

// --- Tests ------------------------------------------------------------------

test "a flag's value may stand in the next word as well as in its own" {
  let fused = read(["--filter=thr", "--root=/w", "--out=a.plyx", "--color=never"]);
  let spaced = read(["--filter", "thr", "--root", "/w", "--out", "a.plyx", "--color", "never"]);
  assert_eq(spaced.filter, fused.filter);
  assert_eq(spaced.root, fused.root);
  assert_eq(spaced.out, fused.out);
  assert_eq(spaced.color, fused.color);
  // The value is never mistaken for a path, whichever way it was written.
  assert_eq(spaced.paths, []);
  assert_eq(fused.paths, [])
}

test "`-o` is `--out`, and takes the word after it" {
  let short = read(["-o", "out.plyx"]);
  assert_eq(short.out, Some("out.plyx"));
  assert_eq(short.paths, [])
}

test "after `--` every word is a path, whatever it looks like" {
  let flags = read(["--json", "--", "--json", "-o", "m.ply"]);
  assert(flags.json);
  assert_eq(flags.paths, ["--json", "-o", "m.ply"]);
  // The `-o` past `--` took no value with it.
  assert_eq(flags.out, None)
}

test "a value that looks like a flag is still that flag's value" {
  let flags = read(["--filter", "--json"]);
  assert_eq(flags.filter, "--json");
  assert(!flags.json)
}

test "the flags are read in any order and every other word is a path, with `./` stripped" {
  let flags = read(["--json", "./a.ply", "--check", "b/c.ply"]);
  assert(flags.check);
  assert(flags.json);
  assert_eq(flags.paths, ["a.ply", "b/c.ply"]);
  let bare = read([]);
  assert(!bare.check);
  assert(!bare.json);
  assert_eq(bare.paths, []);
  assert_eq(bare.root, ".")
}

test "colour is the Rust side's answer, since a program has no terminal to ask" {
  assert(!style_of(read([])).styled);
  assert(style_of(read(["--color=always"])).styled);
  assert(!style_of(read(["--color=always", "--color=never"])).styled)
}

test "the flags a report widens itself with are read like any other" {
  let flags = read(["--types", "--costs", "--explain", "--no-cache", "--watch"]);
  assert(flags.types);
  assert(flags.costs);
  assert(flags.explain);
  assert(flags.no_cache);
  assert(flags.watch);
  let bare = read([]);
  assert(!bare.types);
  assert(!bare.costs);
  assert(!bare.explain);
  assert(!bare.no_cache);
  assert(!bare.watch)
}

test "a flag that takes a value carries it in its own word" {
  let flags = read([
    "--root=/tmp/p",
    "--action=stats",
    "--query=m.two",
    "--filter=thr",
    "--deps",
    "--all",
    "--digest",
    "--shipped-digest=b3:1f2e3d4c5b6a",
  ]);
  assert_eq(flags.root, "/tmp/p");
  assert_eq(flags.action, "stats");
  assert_eq(flags.query, "m.two");
  assert_eq(flags.filter, "thr");
  assert_eq(flags.shipped_digest, "b3:1f2e3d4c5b6a");
  assert(flags.filtered);
  assert(flags.deps);
  assert(flags.all);
  assert(flags.digest);
  assert_eq(flags.paths, [])
}

test "an empty value is a value, not a missing one" {
  let flags = read(["--filter="]);
  assert(flags.filtered);
  assert_eq(flags.filter, "");
  assert_eq(flags.paths, []);
  assert_eq(read(["--entry="]).entry, Some(""))
}

test "the flags a build is named with are absent until they are written" {
  let bare = read([]);
  assert_eq(bare.entry, None);
  assert_eq(bare.config_schema, None);
  assert_eq(bare.db_schema, None);
  assert_eq(bare.out, None);
  assert_eq(bare.diff, None);
  let flags = read([
    "--entry=app.serve",
    "--config-schema=m.spec",
    "--db-schema=m.tables",
    "--out=dist/app.plyx",
    "--diff=old.plyx",
  ]);
  assert_eq(flags.entry, Some("app.serve"));
  assert_eq(flags.config_schema, Some("m.spec"));
  assert_eq(flags.db_schema, Some("m.tables"));
  assert_eq(flags.out, Some("dist/app.plyx"));
  assert_eq(flags.diff, Some("old.plyx"));
  assert_eq(flags.paths, [])
}
