import std.term (Always, Auto, Never, decide, styles)

/// The environment the program runs in, lent by the launcher: the variables, whether the streams
/// are terminals, the working directory, the binary's own version and shipped digest, where
/// `ply run` and `ply check` file what they reuse, and where the emitter's answers are kept. A
/// program that is a tool asks these; a user program reads configuration, not the environment.
pub nondet effect env {
  read var[e](name: String) -> Option<String>
  /// Every variable, which a run's configuration reads once before anything is bound.
  read vars[e]() -> List<{ name: String, value: String }>
  read terminal[e](stream: String) -> Bool
  read binary_version[e]() -> String
  /// The running binary's size, or `None` when it cannot be measured, which never fails a build.
  read binary_bytes[e]() -> Option<Int>
  read pwd[e]() -> String
  /// The digest the launcher gates the committed `ply` runnable on; `ply bootstrap` writes it
  /// beside that runnable.
  read shipped_digest[e]() -> String
  /// The digest the launcher gates the committed builder on, which `ply bootstrap` writes beside it.
  read builder_digest[e]() -> String
  /// The directory `ply run` and `ply check` file what they reuse in, which the toolchain sweeps.
  read reused[e]() -> String
  /// The directory the emitter's answers are kept in between runs, which the toolchain sweeps.
  read bodies[e]() -> String
}

/// Colour and the marks, decided where the terminal can be asked, by `std.term`'s rule: the
/// flag first, then `FORCE_COLOR`, then `NO_COLOR`, then `CLICOLOR_FORCE`, then whether standard
/// output is a terminal that is not `dumb`.
pub fn styled(choice: Option<String>) -> Bool / {env.var[sys], env.terminal[sys]} =
  styles(
    decide(
      match choice { Some("always") -> Always, Some("never") -> Never, _ -> Auto },
      env.terminal[sys]("stdout"),
      {
        no_color: env.var[sys]("NO_COLOR"),
        force_color: env.var[sys]("FORCE_COLOR"),
        clicolor_force: env.var[sys]("CLICOLOR_FORCE"),
        term: env.var[sys]("TERM"),
        colorterm: env.var[sys]("COLORTERM"),
      },
    ),
  )
