// The environment the program runs in, lent by the launcher: the variables, whether the streams
// are terminals, the working directory, and the binary's own version and shipped digest. A
// program that is a tool asks these; a user program reads configuration, not the environment.
pub nondet effect env {
  read var[e](name: String) -> Option<String>
  read terminal[e](stream: String) -> Bool
  read binary_version[e]() -> String
  read pwd[e]() -> String
  // The digest the launcher gates the committed `ply` artifact on; the program's own build
  // writes it beside that artifact.
  read shipped_digest[e]() -> String
}

// Colour and the marks, decided where the terminal can be asked: `auto` is styled only on a
// terminal with NO_COLOR unset.
pub fn styled(choice: Option<String>) -> Bool / {env.var[sys], env.terminal[sys]} =
  match choice {
    Some("always") -> true,
    Some("never") -> false,
    _ -> env.terminal[sys]("stdout") && no_color(),
  }

fn no_color() -> Bool / {env.var[sys]} =
  match env.var[sys]("NO_COLOR") { Some(_) -> false, None -> true }
