// Colour, decided by the Rust side and carried in `--color=`: a program has no terminal to ask.

pub type Style = { styled: Bool }

pub fn plain() -> Style = { styled: false }

fn esc() -> String = string_of_bytes(b"\x1b")

fn paint(s: Style, code: String, text: String) -> String =
  if s.styled { esc() ++ "[" ++ code ++ "m" ++ text ++ esc() ++ "[0m" } else { text }

pub fn bold(s: Style, text: String) -> String = paint(s, "1", text)

pub fn dim(s: Style, text: String) -> String = paint(s, "2", text)

pub fn red(s: Style, text: String) -> String = paint(s, "31", text)

// --- Tests ------------------------------------------------------------------

test "an unstyled run writes the text and nothing around it" {
  assert_eq(bold(plain(), "E0001"), "E0001");
  assert_eq(dim(plain(), "at"), "at");
  assert_eq(red(plain(), "error"), "error")
}

test "a styled run wraps the text in the code it was asked for" {
  let on: Style = { styled: true };
  assert_eq(bytes_of_string(bold(on, "x")), b"\x1b[1mx\x1b[0m");
  assert_eq(bytes_of_string(dim(on, "x")), b"\x1b[2mx\x1b[0m");
  assert_eq(bytes_of_string(red(on, "x")), b"\x1b[31mx\x1b[0m")
}
