// Colour, decided by the Rust side and carried in `--color=`: a program has no terminal to ask.

pub type Style = { styled: Bool }

pub fn plain() -> Style = { styled: false }

fn escape_char() -> String / {abort.raise} = string_of_bytes(b"\x1b")

fn paint(style: Style, code: String, text: String) -> String =
  if style.styled { escape_char() ++ "[" ++ code ++ "m" ++ text ++ escape_char() ++ "[0m" }
  else { text }

pub fn bold(style: Style, text: String) -> String = paint(style, "1", text)

pub fn dim(style: Style, text: String) -> String = paint(style, "2", text)

pub fn red(style: Style, text: String) -> String = paint(style, "31", text)

pub fn green(style: Style, text: String) -> String = paint(style, "32", text)

pub fn yellow(style: Style, text: String) -> String = paint(style, "33", text)

// --- Tests ------------------------------------------------------------------

test "an unstyled run writes the text and nothing around it" {
  assert_eq(bold(plain(), "E0001"), "E0001");
  assert_eq(dim(plain(), "at"), "at");
  assert_eq(red(plain(), "error"), "error");
  assert_eq(green(plain(), "checked"), "checked");
  assert_eq(yellow(plain(), "warning"), "warning")
}

test "a styled run wraps the text in the code it was asked for" {
  let on: Style = { styled: true };
  assert_eq(bytes_of_string(bold(on, "x")), b"\x1b[1mx\x1b[0m");
  assert_eq(bytes_of_string(dim(on, "x")), b"\x1b[2mx\x1b[0m");
  assert_eq(bytes_of_string(red(on, "x")), b"\x1b[31mx\x1b[0m");
  assert_eq(bytes_of_string(green(on, "x")), b"\x1b[32mx\x1b[0m");
  assert_eq(bytes_of_string(yellow(on, "x")), b"\x1b[33mx\x1b[0m")
}
