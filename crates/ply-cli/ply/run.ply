//! `ply run` — one entry point evaluated, what is disclosed about the run before it starts, and
//! what is reported once it is over. The load, the host binding and the entry itself are the Rust
//! side's: a front end is not a value a program can hold, an entry does not nest on the thread
//! this program is itself running on, and a binding holding a connection pool does not cross one.
//! Everything below decides which entry runs, what is disclosed and when, what both forms say,
//! and the code the run exits with.
//!
//! A deployed artifact runs the program its runnable holds once every part of it agrees, rather
//! than a source tree, so it is a second shape of the same report: the same keys wherever the two
//! agree, the file and its digest where they do not.
//!
//! A run of sources walks them first and hashes what it read: when an earlier run of the same
//! closure filed its front end's answer under that key, the machine takes it, and this run runs no
//! front end at all. Either way the machine is handed the same answer over this run's own files,
//! so the run reports the same whichever it was.

import std.random (entropy)
import appends (broken_promises, priced)
import literals (literal, unsettled)
import args (Flags, from_argv, style_of, root_of)
import compiler.front (View)
import config_schema
import configuration
import configuration (Configuration, Resolution)
import std.config (SInt, SSecret)
import compiler.resolve (Diag, Label)
import diagnostic (Place, Raised, Spot, shown, spot_of, all_to_json, all_to_text)
import entries
import entry (Main, Module, entry_point)
import env (env)
import paths
import program (Timed, front_of, timed_over, usable)
import builder (builder)
import reused (Toolchain, entry_at, file, short, touched, walked)
import sources
import units
import units (emit)
import sources (load_resolved)
import std.fs (fs)
import std.time (time)
import report (Answer, indent, ok_code, compile_error, count_of, refused, warned_lines)
import std.json (Json, Null, Str, Bool, Number, Array, Member, Object, object, to_string, int,
                 string_or_null, strings)
import std.value (Value, VInt, VUnit, render)
import std.process (process, Captured, captured, out_step, err_step)
import std.term (Style, dim, plain, red)
import signing (provenance_of, public_of, signatures_path, unkeyed)
import std.signed (signed_of, vouched_by)
import std.list (at_or, concat)
import compiler.plyx (digest_of, digest_text, domain, library_domain)
import compiler.resolve (error_at)
import compiler.unit (shipped)
import deployed

// The machine the run drives is the runtime's; the effect is `machine`'s. The `root` it loads is
// the path the line named, or `.`.

import machine (Artifact, Deployed, Bound, Counters, Ended, Options, Program, Project, Refusal,
                Signals, Stopping, Target, Teardown, Trace, WalkKey, machine, program_of)
import std.string (join)
import compiler.parsing (no_module)

// --- Small things -----------------------------------------------------------

/// `main` raised, which is the one failure a run of a checked program can have.
fn failed() -> Int = 1

/// The drain deadline expired with requests still in flight.
fn drain_incomplete() -> Int = 3

/// `m.main` is declared by `m`: a definition's name is its module's and its own.
fn module_of(name: String) -> String = {
  let parts = string_split(name, ".");
  join(map(range(0, len(parts) - 1), |i: Int| at_or(parts, i, "")), ".")
}

/// An artifact's spans point into text printed at build time, which no reader wrote, so it places
/// nothing.
fn places_of(target: Target) -> List<Place> =
  match target { Project(p) -> p.places, Deployed(_) -> [] }

// --- Which entry runs -------------------------------------------------------

/// An artifact was closed over its entry point at build time; there is nothing left to choose.
fn entry_of(target: Target) -> Result<String, Diag> / {abort.raise} =
  match target {
    Project(p) -> match entry_point(p.mains, p.modules) { Ok(m) -> Ok(m.name), Err(d) -> Err(d) },
    Deployed(a) -> Ok(a.entry),
  }

// --- What is disclosed before the entry runs ---------------------------------

/// The one line that says what this run may reach, and each facility's own under it.
fn binding_lines(style: Style, bound: Bound, c: Configuration) -> List<String> / {abort.raise} =
  if bound.hermetic { [] } else {
    let head = [
      indent()
        ++ dim(
          style,
          "binding host · " ++ count_of(bound.operations, "operation") ++ " · " ++ bound.digest,
        ),
    ];
    let configured = if configuration::opened(c) {
      push(head, indent() ++ dim(style, "config      " ++ configuration::banner(c)))
    } else { head };
    match bound.trace {
      Some(banner) -> push(configured, indent() ++ dim(style, "trace       " ++ banner)),
      None -> configured,
    }
  }

/// An artifact says what it is: a program has its files, and this has a digest and a count.
fn program_lines(style: Style, target: Target) -> List<String> =
  match target {
    Project(_) -> [],
    Deployed(a) ->
      [
        indent()
          ++ dim(
            style,
            "program " ++ a.digest ++ " · " ++ int_to_string(a.definitions) ++ " definitions",
          ),
      ],
  }

/// `--drain-ms` should exceed the program's own `body_timeout_ms + write_timeout_ms`, which this
/// run cannot see, so it is printed for comparison by eye.
fn signal_lines(style: Style, bound: Bound) -> List<String> =
  match bound.signals {
    None -> [],
    Some(g) ->
      [
        indent()
          ++ dim(
            style,
            "shutdown    signals " ++ join(g.names, " ") ++ " · lead " ++ int_to_string(g.lead_ms)
              ++ "ms · drain "
              ++ int_to_string(g.drain_ms)
              ++ "ms · second signal exits 130/143",
          ),
      ],
  }

fn wrote(lines: List<String>, i: Int) -> Unit / {process.out[proc]} =
  if i >= len(lines) { () } else {
    process.out[proc](at_or(lines, i, ""));
    wrote(lines, i + 1)
  }

fn warned(lines: List<String>, i: Int) -> Unit / {process.err[proc]} =
  if i >= len(lines) { () } else {
    process.err[proc](at_or(lines, i, ""));
    warned(lines, i + 1)
  }

/// Written while the entry is still ahead of the run: a disclosure made afterwards discloses
/// nothing. `--json` promises stdout to the one object, so a run that makes that promise says
/// none of this aloud and carries all of it in the document instead.
fn disclosed(
  style: Style,
  flags: Flags,
  target: Target,
  bound: Bound,
  resolution: Resolution,
) -> Unit / {process.out[proc], process.err[proc], abort.raise} =
  if flags.json { () } else {
    warned(all_to_text(style, resolution.warnings, places_of(target)), 0);
    wrote(
      concat(binding_lines(style, bound, resolution.configuration), program_lines(style, target)),
      0,
    );
    warned(signal_lines(style, bound), 0)
  }

// --- What is reported once it is over ----------------------------------------

/// An expired drain is the configuration's fault: a warning, and exit 3 says requests were lost.
fn drained(diag: Diag) -> Bool = diag.code == b"W0608"

/// An abandoned run raised nothing: the clock stopped it where it stood.
fn abandoned(diag: Diag) -> Bool = diag.code == b"W0612"

fn expired_of(e: Ended) -> Bool = match e.raised { Some(r) -> drained(r.diag), None -> false }

/// Handshakes completed and refused, which a run only knows once it is over.
fn handshake_lines(style: Style, e: Ended) -> List<String> =
  map(e.handshakes, |line: String| indent() ++ dim(style, line))

fn stopped_line(style: Style, g: Stopping, w: Teardown) -> String =
  indent()
    ++ dim(
      style,
      "stopping    signal " ++ (match g.signal { Some(n) -> n, None -> "none" }) ++ " · lead "
        ++ int_to_string(w.lead_ms)
        ++ "ms · drain "
        ++ int_to_string(w.drain_ms)
        ++ "ms · "
        ++ int_to_string(g.listeners)
        ++ " listener(s) closed · "
        ++ int_to_string(g.connections)
        ++ " connection(s) in flight",
    )

fn drain_line(style: Style, g: Stopping, expired: Bool) -> String =
  indent()
    ++ dim(
      style,
      (if expired { "abandoned" } else { "drained  " }) ++ "     " ++ int_to_string(g.elapsed_ms)
        ++ "ms since the signal",
    )

fn teardown_line(style: Style, w: Teardown) -> String =
  indent()
    ++ dim(
      style,
      "teardown    " ++ int_to_string(w.spans_left_open) ++ " span(s) left open · sink flushed",
    )

fn trace_lines(style: Style, e: Ended) -> List<String> =
  match e.trace {
    None -> [],
    Some(c) ->
      [
        indent()
          ++ dim(
            style,
            "trace       " ++ int_to_string(c.events) ++ " event(s) · " ++ int_to_string(c.spans)
              ++ " span(s) · "
              ++ int_to_string(c.abandoned)
              ++ " abandoned · "
              ++ (if c.flushed { "flushed" } else { "not flushed" }),
          ),
      ],
  }

/// Nothing when nobody asked the service to stop.
fn stop_lines(style: Style, e: Ended) -> List<String> =
  match e.stopping {
    None -> [],
    Some(g) ->
      concat(
        [
          stopped_line(style, g, e.teardown),
          drain_line(style, g, expired_of(e)),
          teardown_line(style, e.teardown),
        ],
        trace_lines(style, e),
      ),
  }

fn primary_of(diag: Diag) -> Option<Label> = {
  let start: Option<Label> = None;
  fold(diag.labels, start, |acc: Option<Label>, label: Label|
    match acc { Some(_) -> acc, None -> if label.primary { Some(label) } else { None } })
}

fn spotted(places: List<Place>, label: Label) -> Option<String> / {abort.raise} =
  if label.module == no_module() { None } else {
    match list_at(places, label.module) {
      None -> None,
      Some(p) -> {
        let at: Spot = spot_of(p.text, label.start);
        Some(p.path ++ ":" ++ int_to_string(at.line) ++ ":" ++ int_to_string(at.col))
      },
    }
  }

/// Where the raise happened, for a reader with the file open.
fn raised_at(style: Style, target: Target, diag: Diag) -> List<String> / {abort.raise} =
  if drained(diag) || abandoned(diag) { [] } else {
    match primary_of(diag) {
      None -> [],
      Some(l) -> match spotted(places_of(target), l) {
        None -> [],
        Some(at) -> [indent() ++ red(style, "raised at") ++ " " ++ at],
      },
    }
  }

// --- The document -----------------------------------------------------------

/// What the run was over: a program has a root and its files, an artifact a file and a digest.
fn identity(target: Target) -> List<Member> =
  match target {
    Project(p) -> [{ key: "root", value: Str(p.root) }, { key: "files", value: strings(p.files) }],
    Deployed(a) ->
      [
        { key: "artifact", value: Str(a.path) },
        { key: "digest", value: Str(a.digest) },
        { key: "definitions", value: int(a.definitions) },
      ],
  }

fn counters_json(c: Counters) -> Json =
  object([
    { key: "updates", value: int(c.updates) },
    { key: "updates_in_place", value: int(c.updates_in_place) },
    { key: "in_place", value: match c.in_place { Some(d) -> Number(d), None -> Null } },
    { key: "cycles", value: int(c.cycles) },
  ])

/// One shape whether or not anybody asked the run to stop, so a deployment reads one `shutdown`
/// block whichever form it shipped.
fn shutdown_json(e: Ended) -> Json =
  object([
    { key: "requested", value: Bool(match e.stopping { Some(_) -> true, None -> false }) },
    {
      key: "signal",
      value: match e.stopping { Some(g) -> string_or_null(g.signal), None -> Null },
    },
    { key: "drain_ms", value: int(e.teardown.drain_ms) },
    { key: "drain_lead_ms", value: int(e.teardown.lead_ms) },
    { key: "spans_left_open", value: int(e.teardown.spans_left_open) },
  ])

fn document(
  target: Target,
  en: String,
  bound: Bound,
  resolution: Resolution,
  e: Ended,
  ok: Bool,
  code: Int,
  diags: List<Diag>,
) -> Json / {abort.raise} =
  object(
    concat(
      concat(
        [
          { key: "command", value: Str("run") },
          { key: "ok", value: Bool(ok) },
          { key: "exit_code", value: int(code) },
        ],
        identity(target),
      ),
      [
        { key: "entry", value: Str(en) },
        { key: "module", value: Str(module_of(en)) },
        { key: "binding", value: Str(if bound.hermetic { "hermetic" } else { "host" }) },
        { key: "counters", value: counters_json(e.counters) },
        { key: "hosts", value: e.hosts },
        { key: "value", value: match e.value { Some(v) -> Str(render(v)), None -> Null } },
        {
          key: "configuration",
          value: configuration::report_json(configuration::report(resolution.configuration)),
        },
        { key: "shutdown", value: shutdown_json(e) },
        { key: "diagnostics", value: all_to_json(diags, places_of(target)) },
      ],
    ),
  )

// --- The answer -------------------------------------------------------------

/// Everything the run has to say about itself that is not the entry's own answer.
fn noted(resolution: Resolution, e: Ended) -> List<Diag> =
  concat(concat(resolution.warnings, e.cycles), e.warnings)

/// The program chose its code and returned no value, so none is printed.
fn exited(
  style: Style,
  target: Target,
  en: String,
  bound: Bound,
  resolution: Resolution,
  e: Ended,
  code: Int,
) -> Answer / {abort.raise} =
  {
    json: document(target, en, bound, resolution, e, code == ok_code(), code, noted(resolution, e)),
    lines: handshake_lines(style, e),
    errs: concat(
      concat(all_to_text(style, e.cycles, places_of(target)), stop_lines(style, e)),
      warned_lines(style, e.warnings),
    ),
    code: code,
  }

fn answered(
  style: Style,
  target: Target,
  en: String,
  bound: Bound,
  resolution: Resolution,
  e: Ended,
) -> Answer / {abort.raise} =
  {
    json: document(target, en, bound, resolution, e, true, ok_code(), noted(resolution, e)),
    lines: concat(handshake_lines(style, e), [
      indent() ++ (match e.value { Some(v) -> render(v), None -> "" }),
    ]),
    errs: concat(
      concat(all_to_text(style, e.cycles, places_of(target)), stop_lines(style, e)),
      warned_lines(style, e.warnings),
    ),
    code: ok_code(),
  }

fn raised(
  style: Style,
  target: Target,
  en: String,
  bound: Bound,
  resolution: Resolution,
  e: Ended,
  diag: Diag,
) -> Answer / {abort.raise} = {
  let code = if drained(diag) { drain_incomplete() } else { failed() };
  {
    json: document(target, en, bound, resolution, e, false, code, push(noted(resolution, e), diag)),
    lines: [],
    errs: concat(
      concat(
        concat(
          concat(all_to_text(style, e.cycles, places_of(target)), stop_lines(style, e)),
          all_to_text(style, [diag], places_of(target)),
        ),
        raised_at(style, target, diag),
      ),
      warned_lines(style, e.warnings),
    ),
    code: code,
  }
}

fn ended(
  style: Style,
  target: Target,
  en: String,
  bound: Bound,
  resolution: Resolution,
  e: Ended,
) -> Answer / {abort.raise} =
  match e.exit {
    Some(code) -> exited(style, target, en, bound, resolution, e, code),
    None -> match e.raised {
      None -> answered(style, target, en, bound, resolution, e),
      Some(r) -> raised(style, target, en, bound, resolution, e, shown(r)),
    },
  }

/// A `.plyx` that is not one is refused about the file: there is no program to tally errors over.
fn unread(style: Style, path: String, why: Refusal) -> Answer / {abort.raise} =
  {
    json: object([
      { key: "command", value: Str("run") },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: int(compile_error()) },
      { key: "artifact", value: Str(path) },
      { key: "diagnostics", value: all_to_json(why.diags, why.places) },
    ]),
    lines: [],
    errs: all_to_text(style, why.diags, why.places),
    code: compile_error(),
  }

fn unloaded(style: Style, why: Refusal) -> Answer / {abort.raise} =
  match why.artifact {
    None -> refused(style, "run", why.diags, why.places),
    Some(path) -> unread(style, path, why),
  }

/// The entry point is named before anything is bound, so nothing ran and nothing is tallied.
fn unentered(style: Style, target: Target, diag: Diag) -> Answer / {abort.raise} =
  {
    json: object(
      concat(
        concat(
          [
            { key: "command", value: Str("run") },
            { key: "ok", value: Bool(false) },
            { key: "exit_code", value: int(compile_error()) },
          ],
          identity(target),
        ),
        [{ key: "diagnostics", value: all_to_json([diag], places_of(target)) }],
      ),
    ),
    lines: [],
    errs: all_to_text(style, [diag], places_of(target)),
    code: compile_error(),
  }

/// A registration that does not match the program is a start-up failure: nothing ran.
fn unbound(style: Style, why: Refusal) -> Answer / {abort.raise} = {
  let tally = indent() ++ red(style, "no host handler was bound") ++ " ("
    ++ count_of(len(why.diags), "error")
    ++ ")";
  {
    json: object([
      { key: "command", value: Str("run") },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: int(compile_error()) },
      { key: "binding", value: Str("host") },
      { key: "diagnostics", value: all_to_json(why.diags, why.places) },
    ]),
    lines: [],
    errs: push(all_to_text(style, why.diags, why.places), tally),
    code: compile_error(),
  }
}

/// A configuration that did not resolve refuses the run before anything is bound; one that did is
/// what the binding answers from.
fn started(
  style: Style,
  flags: Flags,
  target: Target,
  en: String,
  cfg: Result<Resolution, List<Diag>>,
) -> Answer / {machine.bound[run], machine.enter[run], process.out[proc], process.err[proc], abort.raise} =
  match cfg {
    Err(diags) -> unbound(style, { diags: diags, places: places_of(target), artifact: None }),
    Ok(r) -> match machine.bound[run](en, configuration::configured(r.configuration)) {
      Err(why) -> unbound(style, why),
      Ok(b) -> {
        disclosed(style, flags, target, b, r);
        ended(style, target, en, b, r, machine.enter[run]())
      },
    },
  }

fn chosen(
  style: Style,
  flags: Flags,
  target: Target,
  cfg: Result<Resolution, List<Diag>>,
) -> Answer / {machine.bound[run], machine.enter[run], process.out[proc], process.err[proc], abort.raise} =
  match entry_of(target) {
    Err(d) -> unentered(style, target, d),
    Ok(en) -> started(style, flags, target, en, cfg),
  }

/// The configuration a run binds, read once its target loaded, whose own unit enters the schema.
fn configured_over(
  target: Result<Target, Refusal>,
  options: Options,
) -> Result<Resolution, List<Diag>> / {machine.schema[run], env.vars[sys], env.pwd[sys], fs.resolved[cwd], fs.resolved[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match target {
    Err(_) -> Ok({ configuration: configuration::unopened(), warnings: [] }),
    Ok(_) ->
      configuration::opened_by(options.host, options.config, |name: String|
        machine.schema[run](name)),
  }

pub fn run(
  flags: Flags,
  options: Options,
) -> Answer / {shipped.answer, builder.git[vcs], env.binary_version[sys], env.shipped_digest[sys], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, machine.configure[run], machine.load[run], machine.opened[run], machine.reuse[run], machine.bound[run], machine.enter[run], process.out[proc], process.err[proc], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, machine.schema[run], env.vars[sys], env.pwd[sys], fs.resolved[cwd], fs.resolved[abs], emit.unit, env.reused[sys], machine.filed[run], shipped.definitions, shipped.runtime, priced.report, literal.verdicts, literal.statements, abort.raise, diverges, shipped.reached} = {
  let s: Style = style_of(flags);
  // An artifact is not a program to analyse: what it holds is its own definitions, and the front
  // end never sees it. Only sources are a load this side runs, so only their schema is resolved
  // here; an artifact's is the one its build shipped.
  if is_artifact(root_of(flags).machine) {
    match config_schema::misspelled(options.config.schema) {
      Some(d) -> unbound(s, { diags: [d], places: [], artifact: None }),
      None -> match signer_refusal(flags) {
        Some(d) ->
          unread(s, root_of(flags).machine, {
            diags: [d],
            places: [],
            artifact: Some(root_of(flags).machine),
          }),
        None -> {
          machine.configure[run](options);
          let target = deployed_target(root_of(flags).machine, artifact_bytes(flags));
          over(s, flags, target, configured_over(target, options))
        },
      },
    }
  } else { sourced(s, flags, options) }
}

/// An artifact read back and held to itself here, and the program its runnable holds loaded by the
/// machine. A library is a package to depend on, and nothing to run.
fn deployed_target(
  path: String,
  bytes: Option<Bytes>,
) -> Result<Target, Refusal> / {machine.opened[run], shipped.definitions, shipped.runtime, abort.raise} =
  if string_ends_with(path, ".plyz") {
    Err({ diags: [a_library(path)], places: [], artifact: None })
  } else {
    match bytes {
      None -> Err({ diags: [deployed::unreadable(path)], places: [], artifact: Some(path) }),
      Some(b) -> match deployed::opened(path, b) {
        Err(d) -> Err({ diags: [d], places: [], artifact: Some(path) }),
        Ok(o) -> match machine.opened[run](path, o.runnable, o.entry, o.closure, o.names) {
          Err(why) -> Err(why),
          Ok(_) ->
            Ok(
              Deployed({
                path: path,
                digest: o.digest,
                entry: o.entry,
                definitions: o.definitions,
              }),
            ),
        },
      },
    }
  }

fn a_library(path: String) -> Diag =
  error_at(
    b"E0443",
    no_module(),
    { start: 0, end: 0 },
    bytes_of_string("`" ++ path ++ "` is a library, and nothing to run"),
    b"not a program",
    [
      b"a `.plyz` is a package: declare it in a `ply.pkg` and depend on it",
      b"`ply build` writes a program's artifact as a `.plyx`",
    ],
  )

/// Read here, so the machine reads no file of its own.
fn artifact_bytes(flags: Flags) -> Option<Bytes> / {fs.read_file[cwd], fs.read_file[abs]} =
  match list_at(flags.paths, 0) { Some(r) -> paths::read_file(paths::rooted(r)), None -> None }

// --- `--require-signer` ---------------------------------------------------------------

fn unsigned(path: String, why: String) -> Diag =
  error_at(
    b"E0460",
    no_module(),
    { start: 0, end: 0 },
    bytes_of_string("the artifact `" ++ path ++ "` " ++ why),
    b"not signed by a key `--require-signer` trusts",
    [
      b"`ply build --sign KEY` signs what it builds, in `<artifact>.sig` beside it; `--require-signer` names the public key files a run trusts",
    ],
  )

fn trusted_keys(
  files: List<String>,
) -> Result<List<Bytes>, Diag> / {fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  fold(files, Ok([]), |acc: Result<List<Bytes>, Diag>, path: String|
    match acc {
      Err(d) -> Err(d),
      Ok(keys) -> match paths::read_file(paths::spelled(path)) {
        None -> Err(unkeyed(path, "cannot be read")),
        Some(b) -> match public_of(string_of_bytes_lossy(b)) {
          Ok(k) -> Ok(push(keys, k)),
          Err(why) -> Err(unkeyed(path, "does not hold a public key: " ++ why)),
        },
      },
    })

fn signatures_of(flags: Flags) -> Option<Bytes> / {fs.read_file[cwd], fs.read_file[abs]} =
  match list_at(flags.paths, 0) {
    Some(r) -> {
      let at = paths::rooted(r);
      paths::read_file({ ..at, path: signatures_path(at.path) })
    },
    None -> None,
  }

/// An artifact `--require-signer` holds to its keys runs only when one of them signed its digest.
fn signer_refusal(
  flags: Flags,
) -> Option<Diag> / {fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  if len(flags.signers) == 0 { None } else {
    let path = root_of(flags).machine;
    match trusted_keys(flags.signers) {
      Err(d) -> Some(d),
      Ok(keys) -> match artifact_bytes(flags) {
        // The machine refuses a file it cannot read, as it would without a signer to ask for.
        None -> None,
        Some(bytes) -> {
          let into = if string_ends_with(path, ".plyz") { library_domain() } else { domain() };
          let digest = match digest_of(into, bytes) { Some(d) -> digest_text(d), None -> "" };
          match signatures_of(flags) {
            None ->
              Some(
                unsigned(
                  path,
                  "carries no signatures: `" ++ signatures_path(path) ++ "` is not there",
                ),
              ),
            Some(b) -> match signed_of(b) {
              None -> Some(unsigned(path, "has signatures beside it that do not read")),
              Some(g) -> match provenance_of(g.payload) {
                None ->
                  Some(unsigned(path, "has signatures beside it over nothing a build vouches for")),
                Some(what) -> if what.digest != digest {
                  Some(
                    unsigned(
                      path,
                      "is " ++ digest ++ ", and its signatures vouch for " ++ what.digest,
                    ),
                  )
                } else {
                  match vouched_by(g, keys) {
                    Some(_) -> None,
                    None -> Some(unsigned(path, "is signed by no key `--require-signer` names")),
                  }
                },
              },
            },
          }
        },
      },
    }
  }

/// Whether a path names a built artifact rather than sources. `ply build` writes them, and the
/// container they hold is `compiler.plyx`'s, so the spelling lives beside the writer.
fn is_artifact(path: String) -> Bool =
  string_ends_with(path, ".plyx") || string_ends_with(path, ".plyz")

/// A run of sources: the walk, then the machine over the answer an earlier run of the same closure
/// filed under what the walk hashes to, or over this run's own front end when none is filed or the
/// one filed does not read.
fn sourced(
  style: Style,
  flags: Flags,
  options: Options,
) -> Answer / {shipped.answer, builder.git[vcs], env.binary_version[sys], env.shipped_digest[sys], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, machine.configure[run], machine.load[run], machine.reuse[run], machine.bound[run], machine.enter[run], process.out[proc], process.err[proc], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, machine.schema[run], env.vars[sys], env.pwd[sys], fs.resolved[cwd], fs.resolved[abs], emit.unit, env.reused[sys], machine.filed[run], priced.report, literal.verdicts, literal.statements, abort.raise, diverges, shipped.reached} = {
  let started = time.elapsed_ms();
  let project: sources::Project = load_resolved(flags.paths);
  let tools: Toolchain = { stamp: env.shipped_digest[sys](), version: env.binary_version[sys]() };
  let walk: WalkKey = walked(tools, project, options.config.schema);
  machine.configure[run](options);
  let asked = time.elapsed_ms();
  let kept: Option<Target> = if usable(project) {
    match entry_at(walk.key) {
      None -> None,
      Some(filed) -> match entries::taken(filed) {
        None -> None,
        Some(k) -> match machine.reuse[run](root_of(flags).machine, walk, k.front) {
          Some(read) -> Some(program_of(read, k.entries.mains, k.entries.modules)),
          None -> None,
        },
      },
    }
  } else { None };
  match kept {
    Some(t) -> {
      touched(walk.key);
      let l = {
        reused: true,
        key: walk.key,
        read_ms: asked - started,
        front_ms: 0,
        file_ms: 0,
        load_ms: time.elapsed_ms() - asked,
      };
      loaded_over(style, flags, Ok(t), configured_over(Ok(t), options), l)
    },
    None -> built(style, flags, options, project, walk.key, started),
  }
}

/// This run's own front end, and the machine over its answer, filed under the walk's key once the
/// load holds.
fn built(
  style: Style,
  flags: Flags,
  options: Options,
  project: sources::Project,
  key: String,
  started: Int,
) -> Answer / {shipped.answer, fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, machine.load[run], machine.bound[run], machine.enter[run], process.out[proc], process.err[proc], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, machine.schema[run], env.vars[sys], env.pwd[sys], fs.resolved[cwd], fs.resolved[abs], emit.unit, env.reused[sys], machine.filed[run], priced.report, literal.verdicts, literal.statements, abort.raise, shipped.reached} = {
  let t: Timed = timed_over(flags.paths, project, started);
  match t.program.view {
    // A load refusal, in the shape the machine's own refusals take: nothing ran, and the
    // diagnostics say why.
    None -> unloaded(style, { diags: t.program.diags, places: t.program.places, artifact: None }),
    Some(w) -> match config_schema::refusal(w, options.config.schema) {
      Some(d) -> unbound(style, { diags: [d], places: t.program.places, artifact: None }),
      None -> match broken_promises(t.program, w) {
        [] -> match unsettled(t, w, root_of(flags).machine) {
          [] -> loaded_built(style, flags, options, t, w, key),
          refused -> unloaded(style, { diags: refused, places: t.program.places, artifact: None }),
        },
        broken -> unloaded(style, { diags: broken, places: t.program.places, artifact: None }),
      },
    },
  }
}

/// The machine over a front end this run checked, filed under the walk's key once the load holds.
fn loaded_built(
  style: Style,
  flags: Flags,
  options: Options,
  timed: Timed,
  view: View,
  key: String,
) -> Answer / {time.elapsed_ms, machine.load[run], machine.schema[run], machine.bound[run], machine.enter[run], process.out[proc], process.err[proc], env.vars[sys], env.pwd[sys], fs.resolved[cwd], fs.resolved[abs], fs.read_file[cwd], fs.read_file[abs], emit.unit, env.reused[sys], machine.filed[run], fs.write[abs], entropy.next, time.now_ms, abort.raise} = {
  let asked = time.elapsed_ms();
  let front = front_of(timed, view);
  let emitted = units::whole(front);
  let offered = entries::of_front(front);
  let target = match emitted {
    Err(diags) -> Err({ diags: diags, places: timed.program.places, artifact: None }),
    Ok(unit) -> match machine.load[run](root_of(flags).machine, front, unit) {
      Ok(read) -> Ok(program_of(read, offered.mains, offered.modules)),
      Err(why) -> Err(why),
    },
  };
  let l = {
    reused: false,
    key: key,
    read_ms: timed.read_ms,
    front_ms: timed.front_ms,
    file_ms: timed.file_ms,
    load_ms: time.elapsed_ms() - asked,
  };
  match ((target, emitted)) {
    (Ok(_), Ok(unit)) -> match machine.filed[run](front, unit) {
      Some(entry) -> {
        let _ = file(key, entries::kept(offered, entry));
        ()
      },
      None -> (),
    },
    _ -> (),
  };
  loaded_over(style, flags, target, configured_over(target, options), l)
}

/// The run over the target the machine loaded, or the machine's refusal of it.
fn over(
  s: Style,
  flags: Flags,
  target: Result<Target, Refusal>,
  cfg: Result<Resolution, List<Diag>>,
) -> Answer / {machine.bound[run], machine.enter[run], process.out[proc], process.err[proc], abort.raise} =
  match target { Err(why) -> unloaded(s, why), Ok(t) -> chosen(s, flags, t, cfg) }

/// The same over sources, saying where the load's time went when `--explain` asks: aloud before
/// the entry runs, or in the one document under `--json`.
fn loaded_over(
  style: Style,
  flags: Flags,
  target: Result<Target, Refusal>,
  cfg: Result<Resolution, List<Diag>>,
  l: Loading,
) -> Answer / {machine.bound[run], machine.enter[run], process.out[proc], process.err[proc], abort.raise} =
  match target {
    Err(why) -> unloaded(style, why),
    Ok(t) -> {
      if flags.explain && !flags.json { process.err[proc](loading_line(style, l)) };
      explained(flags, l, chosen(style, flags, t, cfg))
    },
  }

// --- Where a load's time went --------------------------------------------------

/// A load over sources: whether its front end ran or the answer an earlier run filed under its key
/// was taken, and what each phase cost.
type Loading = {
  reused: Bool,
  key: String,
  read_ms: Int,
  front_ms: Int,
  file_ms: Int,
  load_ms: Int,
}

fn millis(n: Int) -> String = int_to_string(n) ++ "ms"

fn loading_line(style: Style, l: Loading) -> String / {abort.raise} = {
  let phases = if l.reused { ["read " ++ millis(l.read_ms), "load " ++ millis(l.load_ms)] } else {
    [
      "read " ++ millis(l.read_ms),
      "front " ++ millis(l.front_ms),
      "write back " ++ millis(l.file_ms),
      "load " ++ millis(l.load_ms),
    ]
  };
  indent()
    ++ dim(
      style,
      "front end   " ++ (if l.reused { "reused " } else { "built " }) ++ short(l.key) ++ " · "
        ++ join(phases, " · "),
    )
}

fn loading_json(l: Loading) -> Json =
  object([
    { key: "reused", value: Bool(l.reused) },
    { key: "key", value: Str(l.key) },
    {
      key: "phases",
      value: object([
        { key: "read", value: int(l.read_ms) },
        { key: "front", value: int(l.front_ms) },
        { key: "write_back", value: int(l.file_ms) },
        { key: "load", value: int(l.load_ms) },
      ]),
    },
  ])

fn explained(flags: Flags, l: Loading, answer: Answer) -> Answer =
  if !(flags.explain && flags.json) { answer } else {
    match answer.json {
      Object(members) ->
        { ..answer, json: Object(map_insert(members, "front_end", loading_json(l))) },
      _ -> answer,
    }
  }

// --- Tests ------------------------------------------------------------------

fn a_main() -> Main =
  { name: "m.main", module: "m", path: "m.ply", at: { module: 0, start: 3, end: 7 } }

fn a_program() -> Target =
  Project({
    root: "/p",
    files: ["m.ply"],
    places: [{ path: "m.ply", text: b"fn main() -> Int = 42\n" }],
    mains: [a_main()],
    modules: [{ name: "m", path: "m.ply", at: { module: 0, start: 22, end: 22 } }],
  })

fn an_artifact() -> Target =
  Deployed({ path: "m.plyx", digest: "b3:1f2e3d4c5b6a", entry: "m.main", definitions: 3 })

fn hermetic() -> Bound = { hermetic: true, operations: 0, digest: "", trace: None, signals: None }

fn a_binding() -> Bound =
  {
    hermetic: false,
    operations: 7,
    digest: "b3:aabbccddeeff",
    trace: Some("json on stderr · info"),
    signals: Some({ names: ["SIGINT", "SIGTERM"], lead_ms: 0, drain_ms: 30000 }),
  }

fn no_counters() -> Counters = { updates: 0, updates_in_place: 0, in_place: None, cycles: 0 }

fn no_teardown() -> Teardown = { lead_ms: 0, drain_ms: 30000, spans_left_open: 0 }

fn answered_with(value: Value) -> Ended =
  {
    exit: None,
    value: Some(value),
    raised: None,
    counters: no_counters(),
    cycles: [],
    warnings: [],
    stopping: None,
    teardown: no_teardown(),
    trace: None,
    handshakes: [],
    hosts: Null,
  }

fn unvalued(diag: Diag) -> Raised = { diag: diag, values: [] }

fn a_diag(code: Bytes, message: Bytes, labels: List<Label>) -> Diag =
  {
    code: code,
    notes: 0,
    labels: labels,
    text: b"",
    message: message,
    notes_text: [],
    severity: b"error",
    fixes: [],
  }

fn nothing() -> Refusal = { diags: [], places: [], artifact: None }

/// The run's own answer over a load, a binding and an entry the test hands it in place of the Rust
/// side, with whatever it wrote on either stream captured beside it.
type RunCapture = { answer: Answer, out: List<String>, err: List<String> }

fn ran_over(
  flags: Flags,
  t: Result<Target, Refusal>,
  b: Result<Bound, Refusal>,
  e: Ended,
) -> RunCapture / {abort.raise} = ran_loaded(flags, t, Ok(unconfigured()), b, e, None)

fn unconfigured() -> Resolution = { configuration: configuration::unopened(), warnings: [] }

/// Two keys the schema declares, one of them secret, both from the environment.
fn configured_desk() -> Resolution / {abort.raise} =
  match configuration::sources_of([], [], [
      { name: "PORT", value: "8137" },
      { name: "TOKEN", value: "t" },
    ]) {
    Err(_) -> panic("the fixture's sources read"),
    Ok(sources) -> match configuration::resolved(
        sources,
        Some({
          function: "m.spec",
          keys: [
            { name: "PORT", shape: SInt, required: true, default: None },
            { name: "TOKEN", shape: SSecret, required: true, default: None },
          ],
        }),
      ) {
      Err(_) -> panic("the fixture resolves"),
      Ok(r) -> r,
    },
  }

/// The same over sources, whose load `l` says where the time went, when there is one to say.
fn ran_loaded(
  flags: Flags,
  t: Result<Target, Refusal>,
  cfg: Result<Resolution, List<Diag>>,
  b: Result<Bound, Refusal>,
  e: Ended,
  l: Option<Loading>,
) -> RunCapture / {abort.raise} =
  with_cell[twin](captured([])) { io -> {
    let answer: Answer = handle {
      match l {
        None -> over(plain(), flags, t, cfg),
        Some(l) -> loaded_over(plain(), flags, t, cfg, l),
      }
    } with {
      machine.bound[run](named, config) -> b,
      machine.enter[run]() -> e,
      process.out[proc](text) -> cell_set(io, out_step(cell_get(io), text)),
      process.err[proc](text) -> cell_set(io, err_step(cell_get(io), text)),
    };
    let said: Captured = cell_get(io);
    { answer: answer, out: said.out, err: said.err }
  } }

fn bare() -> Flags / {abort.raise} = from_argv("run", [])

fn as_json() -> Flags / {abort.raise} = from_argv("run", ["--json"])

test "a value the entry answered with is one indented line and exit 0" {
  let ran = ran_over(bare(), Ok(a_program()), Ok(hermetic()), answered_with(VInt(42)));
  assert_eq(ran.answer.code, 0);
  assert_eq(ran.answer.lines, ["   42"]);
  assert_eq(ran.answer.errs, []);
  assert_eq(ran.out, []);
  assert_eq(ran.err, [])
}

test "the object keys off `command` and `exit_code`, and names the entry and its module" {
  let text = to_string(
    ran_over(as_json(), Ok(a_program()), Ok(hermetic()), answered_with(VInt(42))).answer.json,
  );
  assert(string_contains(text, "\"command\":\"run\""));
  assert(string_contains(text, "\"exit_code\":0"));
  assert(string_contains(text, "\"entry\":\"m.main\""));
  assert(string_contains(text, "\"module\":\"m\""));
  assert(string_contains(text, "\"binding\":\"hermetic\""));
  assert(string_contains(text, "\"value\":\"42\""));
  assert(string_contains(text, "\"root\":\"/p\""));
  assert(string_contains(text, "\"files\":[\"m.ply\"]"))
}

// What a run may reach is disclosed while the entry is still ahead of it, so it goes out on the
// stream as the program runs rather than in the answer collected after it.
test "a bound run discloses what it may reach before the entry is entered" {
  let ran = ran_loaded(
    bare(),
    Ok(a_program()),
    Ok(configured_desk()),
    Ok(a_binding()),
    answered_with(VInt(42)),
    None,
  );
  assert_eq(ran.out, [
    "   binding host · 7 operations · b3:aabbccddeeff",
    "   config      2 keys · 2 environment · 1 secret (values not shown)",
    "   trace       json on stderr · info",
  ]);
  assert_eq(ran.err, [
    "   shutdown    signals SIGINT SIGTERM · lead 0ms · drain 30000ms · second signal exits 130/143",
  ]);
  assert_eq(ran.answer.lines, ["   42"])
}

test "`--json` promises stdout to the one object, so nothing else is written at all" {
  let ran = ran_over(as_json(), Ok(a_program()), Ok(a_binding()), answered_with(VInt(42)));
  assert_eq(ran.out, []);
  assert_eq(ran.err, []);
  assert(string_contains(to_string(ran.answer.json), "\"binding\":\"host\""))
}

test "a hermetic run discloses nothing, because there is nothing it could reach" {
  let ran = ran_over(bare(), Ok(a_program()), Ok(hermetic()), answered_with(VUnit));
  assert_eq(ran.out, []);
  assert_eq(ran.err, [])
}

test "a raise is exit 1, and says where it was raised for a reader with the file open" {
  let raise = {
    ..answered_with(VInt(42)),
    value: None,
    raised: Some(
      unvalued(
        a_diag(b"E0501", b"nope", [
          { module: 0, start: 19, end: 21, primary: true, text: b"here" },
        ]),
      ),
    ),
  };
  let ran = ran_over(bare(), Ok(a_program()), Ok(hermetic()), raise);
  assert_eq(ran.answer.code, 1);
  assert_eq(ran.answer.lines, []);
  assert_eq(at_or(ran.answer.errs, 0, ""), "Error[E0501]: nope");
  assert_eq(at_or(ran.answer.errs, len(ran.answer.errs) - 1, ""), "   raised at m.ply:1:20")
}

test "a raise shows the values it carries, rendered where its text names them" {
  let raise = {
    ..answered_with(VInt(42)),
    value: None,
    raised: Some({ diag: a_diag(b"E0501", b"expected \x010\x02", []), values: [VInt(3)] }),
  };
  let ran = ran_over(bare(), Ok(a_program()), Ok(hermetic()), raise);
  assert_eq(at_or(ran.answer.errs, 0, ""), "Error[E0501]: expected 3")
}

test "an expired drain is exit 3, and is not attributed to a line of the program" {
  let expired = {
    ..answered_with(VUnit),
    value: None,
    raised: Some(unvalued(a_diag(b"W0608", b"the drain deadline expired", []))),
  };
  let ran = ran_over(bare(), Ok(a_program()), Ok(a_binding()), expired);
  assert_eq(ran.answer.code, 3);
  assert_eq(len(filter(ran.answer.errs, |l: String| string_contains(l, "raised at"))), 0)
}

test "a program that chose its own exit code is answered with that code and no value" {
  let chose = { ..answered_with(VUnit), exit: Some(7), value: None };
  let ran = ran_over(bare(), Ok(a_program()), Ok(hermetic()), chose);
  assert_eq(ran.answer.code, 7);
  assert_eq(ran.answer.lines, []);
  let text = to_string(ran_over(as_json(), Ok(a_program()), Ok(hermetic()), chose).answer.json);
  assert(string_contains(text, "\"exit_code\":7"));
  assert(string_contains(text, "\"ok\":false"));
  assert(string_contains(text, "\"value\":null"))
}

test "a stopped run says what was in flight, how long the drain took, and what it left open" {
  let stopped = {
    ..answered_with(VUnit),
    stopping: Some({ signal: Some("SIGTERM"), listeners: 1, connections: 2, elapsed_ms: 40 }),
    teardown: { ..no_teardown(), spans_left_open: 1 },
    trace: Some({ events: 9, spans: 4, abandoned: 2, flushed: true }),
  };
  let ran = ran_over(bare(), Ok(a_program()), Ok(a_binding()), stopped);
  assert_eq(ran.answer.errs, [
    "   stopping    signal SIGTERM · lead 0ms · drain 30000ms · 1 listener(s) closed · 2 connection(s) in flight",
    "   drained       40ms since the signal",
    "   teardown    1 span(s) left open · sink flushed",
    "   trace       9 event(s) · 4 span(s) · 2 abandoned · flushed",
  ])
}

test "the shutdown block counts the spans left open, as the warning that named them did" {
  let finished = {
    ..answered_with(VInt(3)),
    warnings: [left_open()],
    teardown: { ..no_teardown(), spans_left_open: 2 },
  };
  let text = to_string(ran_over(as_json(), Ok(a_program()), Ok(hermetic()), finished).answer.json);
  assert(string_contains(text, "\"spans_left_open\":2"))
}

/// What the runtime warns of when an entry ends with `reserving` open inside `order`.
fn left_open() -> Diag =
  {
    ..a_diag(b"W0609", b"2 spans were still open when their task or the entry point ended: `reserving` on `orders`, `order` on `orders`", []),
    notes: 1,
    notes_text: [b"each was closed `Abandoned` and written"],
    severity: b"warning",
  }

fn warned_of_spans() -> List<String> =
  [
    "",
    "   warning: 2 spans were still open when their task or the entry point ended: `reserving` on `orders`, `order` on `orders`",
    "     = each was closed `Abandoned` and written",
  ]

test "spans an entry left open are warned of on stderr under its answer, and its exit 0 stands" {
  let finished = { ..answered_with(VInt(3)), warnings: [left_open()] };
  let ran = ran_over(bare(), Ok(a_program()), Ok(hermetic()), finished);
  assert_eq(ran.answer.code, 0);
  assert_eq(ran.answer.lines, ["   3"]);
  assert_eq(ran.answer.errs, warned_of_spans());
  let text = to_string(ran_over(as_json(), Ok(a_program()), Ok(hermetic()), finished).answer.json);
  assert(string_contains(text, "\"code\":\"W0609\""));
  assert(string_contains(text, "\"exit_code\":0"))
}

test "a raise that left spans open is said first, and the spans after where it was raised" {
  let finished = {
    ..answered_with(VUnit),
    value: None,
    raised: Some(
      unvalued(
        a_diag(b"E0502", b"boom", [
          { module: 0, start: 19, end: 21, primary: true, text: b"here" },
        ]),
      ),
    ),
    warnings: [left_open()],
  };
  let ran = ran_over(bare(), Ok(a_program()), Ok(hermetic()), finished);
  assert_eq(ran.answer.code, 1);
  let errs = ran.answer.errs;
  assert_eq(at_or(errs, 0, ""), "Error[E0502]: boom");
  assert_eq(at_or(errs, len(errs) - 4, ""), "   raised at m.ply:1:20");
  assert_eq(map(range(len(errs) - 3, len(errs)), |i: Int| at_or(errs, i, "")), warned_of_spans())
}

test "an artifact says which file it ran, its digest, and what it carries" {
  let ran = ran_over(bare(), Ok(an_artifact()), Ok(hermetic()), answered_with(VInt(42)));
  assert_eq(ran.out, ["   program b3:1f2e3d4c5b6a · 3 definitions"]);
  let text = to_string(
    ran_over(as_json(), Ok(an_artifact()), Ok(hermetic()), answered_with(VInt(42))).answer.json,
  );
  assert(string_contains(text, "\"artifact\":\"m.plyx\""));
  assert(string_contains(text, "\"digest\":\"b3:1f2e3d4c5b6a\""));
  assert(string_contains(text, "\"definitions\":3"));
  assert(string_contains(text, "\"entry\":\"m.main\""))
}

test "a program that does not load is the load's own refusal with the tally under it" {
  let why: Refusal = {
    diags: [a_diag(b"E0201", b"type mismatch", [])],
    places: [],
    artifact: None,
  };
  let ran = ran_over(bare(), Err(why), Err(nothing()), answered_with(VUnit));
  assert_eq(ran.answer.code, 2);
  assert_eq(ran.answer.lines, []);
  assert_eq(ran.answer.errs, [
    "Error[E0201]: type mismatch",
    indent() ++ "compilation failed (1 error)",
  ])
}

test "a file that is not an artifact is refused about the file and tallies nothing" {
  let why: Refusal = {
    diags: [a_diag(b"E0443", b"not a program at all", [])],
    places: [],
    artifact: Some("junk.plyx"),
  };
  let text = to_string(
    ran_over(as_json(), Err(why), Err(nothing()), answered_with(VUnit)).answer.json,
  );
  assert(string_contains(text, "\"artifact\":\"junk.plyx\""));
  assert(string_contains(text, "\"E0443\""));
  let ran = ran_over(bare(), Err(why), Err(nothing()), answered_with(VUnit));
  assert_eq(ran.answer.code, 2);
  assert_eq(ran.answer.errs, ["Error[E0443]: not a program at all"])
}

test "a program with no `main` is refused over its own files before anything is bound" {
  let empty = Project({
    root: "/p",
    files: ["m.ply"],
    places: [],
    mains: [],
    modules: [{ name: "m", path: "m.ply", at: { module: 0, start: 18, end: 18 } }],
  });
  let ran = ran_over(as_json(), Ok(empty), Err(nothing()), answered_with(VUnit));
  assert_eq(ran.answer.code, 2);
  let text = to_string(ran.answer.json);
  assert(string_contains(text, "\"root\":\"/p\""));
  assert(string_contains(text, "\"E0101\""))
}

test "a binding that does not match the program is a start-up failure naming no line" {
  let why: Refusal = {
    diags: [a_diag(b"E0412", b"a nondet effect in a det test", [])],
    places: [],
    artifact: None,
  };
  let ran = ran_over(bare(), Ok(a_program()), Err(why), answered_with(VUnit));
  assert_eq(ran.answer.code, 2);
  assert_eq(ran.answer.errs, [
    "Error[E0412]: a nondet effect in a det test",
    indent() ++ "no host handler was bound (1 error)",
  ]);
  assert(
    string_contains(
      to_string(ran_over(as_json(), Ok(a_program()), Err(why), answered_with(VUnit)).answer.json),
      "\"binding\":\"host\"",
    ),
  )
}

test "what the machine reused is a count and a ratio, and no ratio at all over nothing" {
  let reused = {
    ..answered_with(VInt(42)),
    counters: { updates: 4, updates_in_place: 3, in_place: decimal_of_string("0.75"), cycles: 0 },
  };
  let text = to_string(ran_over(as_json(), Ok(a_program()), Ok(hermetic()), reused).answer.json);
  assert(string_contains(text, "\"updates\":4"));
  assert(string_contains(text, "\"updates_in_place\":3"));
  assert(string_contains(text, "\"in_place\":0.75"));
  let over_nothing = to_string(
    ran_over(as_json(), Ok(a_program()), Ok(hermetic()), answered_with(VInt(42))).answer.json,
  );
  assert(string_contains(over_nothing, "\"in_place\":null"))
}

test "a definition's module is its name without its own last segment" {
  assert_eq(module_of("m.main"), "m");
  assert_eq(module_of("store.orders.main"), "store.orders")
}

fn a_key() -> String = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn a_reuse() -> Loading =
  { reused: true, key: a_key(), read_ms: 9, front_ms: 0, file_ms: 0, load_ms: 41 }

fn a_build() -> Loading =
  { reused: false, key: a_key(), read_ms: 7, front_ms: 1774, file_ms: 44, load_ms: 1392 }

fn explaining() -> Flags / {abort.raise} = from_argv("run", ["--explain"])

fn loaded(flags: Flags, l: Loading) -> RunCapture / {abort.raise} =
  ran_loaded(
    flags,
    Ok(a_program()),
    Ok(unconfigured()),
    Ok(a_binding()),
    answered_with(VInt(42)),
    Some(l),
  )

test "a run over a reused front end answers exactly as one over a front end it ran" {
  assert_eq(loaded(bare(), a_reuse()), loaded(bare(), a_build()));
  assert_eq(loaded(as_json(), a_reuse()), loaded(as_json(), a_build()));
  assert_eq(
    loaded(bare(), a_reuse()),
    ran_over(bare(), Ok(a_program()), Ok(a_binding()), answered_with(VInt(42))),
  )
}

test "`--explain` says whether the front end ran, under which key, and where the time went" {
  let reused = loaded(explaining(), a_reuse());
  assert_eq(
    at_or(reused.err, 0, ""),
    "   front end   reused b3:0123456789ab · read 9ms · load 41ms",
  );
  let built = loaded(explaining(), a_build());
  assert_eq(
    at_or(built.err, 0, ""),
    "   front end   built b3:0123456789ab · read 7ms · front 1774ms · write back 44ms · load 1392ms",
  );
  // Said before the entry runs, ahead of what the binding discloses on the same stream.
  assert_eq(at_or(built.err, 1, ""), at_or(loaded(bare(), a_build()).err, 0, ""));
  assert_eq(built.answer, loaded(bare(), a_build()).answer)
}

test "`--json --explain` carries the load in the one document and says nothing aloud" {
  let ran = loaded(from_argv("run", ["--json", "--explain"]), a_reuse());
  assert_eq(ran.out, []);
  assert_eq(ran.err, []);
  let text = to_string(ran.answer.json);
  assert(string_contains(text, "\"front_end\":{\"key\":\"" ++ a_key() ++ "\""));
  assert(string_contains(text, "\"phases\":{\"front\":0,\"load\":41,\"read\":9,\"write_back\":0}"));
  assert(string_contains(text, "\"reused\":true"));
  assert(!string_contains(to_string(loaded(as_json(), a_reuse()).answer.json), "front_end"))
}

test "a load the machine refused says nothing about where its time went" {
  let why: Refusal = {
    diags: [a_diag(b"E0201", b"type mismatch", [])],
    places: [],
    artifact: None,
  };
  let ran = ran_loaded(
    explaining(),
    Err(why),
    Ok(unconfigured()),
    Err(nothing()),
    answered_with(VUnit),
    Some(a_build()),
  );
  assert_eq(ran.err, []);
  assert_eq(ran.answer.code, 2)
}
