// `ply run` — one entry point evaluated, what is disclosed about the run before it starts, and
// what is reported once it is over. The load, the host binding and the entry itself are the Rust
// side's: a front end is not a value a program can hold, an entry does not nest on the thread
// this program is itself running on, and a binding holding a connection pool does not cross one.
// Everything below decides which entry runs, what is disclosed and when, what both forms say,
// and the code the run exits with.
//
// A deployed artifact runs out of its own verified definitions rather than a source tree, so it
// is a second shape of the same report: the same keys wherever the two agree, the file and its
// digest where they do not.

import args (Flags, read, style_of)
import compiler.resolve (Diag, Label)
import diagnostic (Place, Spot, spot_of, all_to_json, all_to_text)
import entry (Main, Module, entry_point, no_module)
import report (Answer, ind, ok_code, compile_error, count_of, refused, warning_lines)
import std.json (Json, Null, Str, Bool, Number, Array, Member, object, to_string)
import std.process (process, Captured, captured, out_step, err_step)
import style (Style, dim, red)

// The machine the run drives is the runtime's; the effect is `machine`'s. The `root` it loads is
// the path the line named, or `.`.

import machine (Artifact, Deployed, Bound, Counters, Ended, Program, Project, Refusal, Signals,
                Stopping, Target, Teardown, Trace, machine)

// --- Small things -----------------------------------------------------------

// The target's root is the line's first positional, or the working directory.
fn root_of(flags: Flags) -> String =
  match list_at(flags.paths, 0) { Some(path) -> path, None -> "." }

// `main` raised, which is the one failure a run of a checked program can have.
fn failed() -> Int = 1

// The drain deadline expired with requests still in flight.
fn drain_incomplete() -> Int = 3

fn nth(xs: List<String>, i: Int) -> String = match list_at(xs, i) { Some(x) -> x, None -> "" }

fn joined(parts: List<String>, sep: String) -> String =
  fold(range(0, len(parts)), "", |acc: String, i: Int|
    if i == 0 { nth(parts, i) } else { acc ++ sep ++ nth(parts, i) })

fn also<a>(head: List<a>, tail: List<a>) -> List<a> =
  fold(tail, head, |acc: List<a>, x: a| push(acc, x))

fn num(n: Int) -> Json = Number(decimal_of_int(n))

fn text_or_null(v: Option<String>) -> Json = match v { Some(s) -> Str(s), None -> Null }

fn texts(xs: List<String>) -> Json = Array(map(xs, |x: String| Str(x)))

// `m.main` is declared by `m`: a definition's name is its module's and its own.
fn module_of(name: String) -> String = {
  let parts = string_split(name, ".");
  joined(map(range(0, len(parts) - 1), |i: Int| nth(parts, i)), ".")
}

// An artifact's spans point into text printed at build time, which no reader wrote, so it places
// nothing.
fn places_of(t: Target) -> List<Place> = match t { Project(p) -> p.places, Deployed(_) -> [] }

// What opening the target itself had to say: a container from another version, a unit left aside.
fn told_of(t: Target) -> List<Diag> = match t { Project(_) -> [], Deployed(a) -> a.warnings }

// --- Which entry runs -------------------------------------------------------

// An artifact was closed over its entry point at build time; there is nothing left to choose.
fn entry_of(t: Target) -> Result<String, Diag> =
  match t {
    Project(p) -> match entry_point(p.mains, p.modules) { Ok(m) -> Ok(m.name), Err(d) -> Err(d) },
    Deployed(a) -> Ok(a.entry),
  }

// --- What is disclosed before the entry runs ---------------------------------

// The one line that says what this run may reach, and each facility's own under it.
fn binding_lines(s: Style, b: Bound) -> List<String> =
  if b.hermetic { [] } else {
    let head = [
      ind()
        ++ dim(s, "binding host · " ++ count_of(b.operations, "operation") ++ " · " ++ b.digest),
    ];
    let configured = match b.config {
      Some(banner) -> push(head, ind() ++ dim(s, "config      " ++ banner)),
      None -> head,
    };
    let traced = match b.trace {
      Some(banner) -> push(configured, ind() ++ dim(s, "trace       " ++ banner)),
      None -> configured,
    };
    match b.database { Some(line) -> push(traced, ind() ++ dim(s, line)), None -> traced }
  }

// An artifact says what it is: a program has its files, and this has a digest and a count.
fn program_lines(s: Style, t: Target) -> List<String> =
  match t {
    Project(_) -> [],
    Deployed(a) ->
      [
        ind()
          ++ dim(
            s,
            "program " ++ a.digest ++ " · " ++ int_to_string(a.definitions) ++ " definitions · "
              ++ (if a.unit { "compiled unit embedded" }
              else { "no compiled unit: compiled from its bodies at each run" }),
          ),
      ],
  }

// `--drain-ms` should exceed the program's own `body_timeout_ms + write_timeout_ms`, which this
// run cannot see, so it is printed for comparison by eye.
fn signal_lines(s: Style, b: Bound) -> List<String> =
  match b.signals {
    None -> [],
    Some(g) ->
      [
        ind()
          ++ dim(
            s,
            "shutdown    signals " ++ joined(g.names, " ") ++ " · lead "
              ++ int_to_string(g.lead_ms)
              ++ "ms · drain "
              ++ int_to_string(g.drain_ms)
              ++ "ms · second signal exits 130/143",
          ),
      ],
  }

fn wrote(lines: List<String>, i: Int) -> Unit / {process.out[proc]} =
  if i >= len(lines) { () } else {
    process.out[proc](nth(lines, i));
    wrote(lines, i + 1)
  }

fn warned(lines: List<String>, i: Int) -> Unit / {process.err[proc]} =
  if i >= len(lines) { () } else {
    process.err[proc](nth(lines, i));
    warned(lines, i + 1)
  }

// Written while the entry is still ahead of the run: a disclosure made afterwards discloses
// nothing. `--json` promises stdout to the one object, so a run that makes that promise says
// none of this aloud and carries all of it in the document instead.
fn disclosed(
  s: Style,
  flags: Flags,
  t: Target,
  b: Bound,
) -> Unit / {process.out[proc], process.err[proc]} =
  if flags.json { () } else {
    warned(all_to_text(s, b.warnings, places_of(t)), 0);
    wrote(also(also(warning_lines(s, told_of(t)), binding_lines(s, b)), program_lines(s, t)), 0);
    warned(signal_lines(s, b), 0)
  }

// --- What is reported once it is over ----------------------------------------

// An expired drain is the configuration's fault: a warning, and exit 3 says requests were lost.
fn drained(d: Diag) -> Bool = d.code == b"W0608"

// An abandoned run raised nothing: the clock stopped it where it stood.
fn abandoned(d: Diag) -> Bool = d.code == b"W0612"

fn expired_of(e: Ended) -> Bool = match e.raised { Some(d) -> drained(d), None -> false }

// Handshakes completed and refused, which a run only knows once it is over.
fn handshake_lines(s: Style, e: Ended) -> List<String> =
  map(e.handshakes, |line: String| ind() ++ dim(s, line))

fn stopped_line(s: Style, g: Stopping, w: Teardown) -> String =
  ind()
    ++ dim(
      s,
      "stopping    signal " ++ (match g.signal { Some(n) -> n, None -> "none" }) ++ " · lead "
        ++ int_to_string(w.lead_ms)
        ++ "ms · drain "
        ++ int_to_string(w.drain_ms)
        ++ "ms · "
        ++ int_to_string(g.listeners)
        ++ " listener(s) closed · "
        ++ int_to_string(g.connections)
        ++ " connection(s) in flight · "
        ++ int_to_string(g.scopes)
        ++ " transaction(s) open",
    )

fn drain_line(s: Style, g: Stopping, expired: Bool) -> String =
  ind()
    ++ dim(
      s,
      (if expired { "abandoned" } else { "drained  " }) ++ "     " ++ int_to_string(g.elapsed_ms)
        ++ "ms since the signal",
    )

fn teardown_lines(s: Style, w: Teardown) -> List<String> =
  also(
    [
      ind()
        ++ dim(
          s,
          "teardown    " ++ int_to_string(w.transactions_rolled_back)
            ++ " transaction(s) rolled back, none committed · "
            ++ int_to_string(w.connections_closed)
            ++ " connection(s) closed rather than returned · "
            ++ int_to_string(w.spans_abandoned)
            ++ " span(s) abandoned · sink flushed",
        ),
    ],
    map(w.problems, |p: String| ind() ++ dim(s, "warning[W0606]: " ++ p)),
  )

fn trace_lines(s: Style, e: Ended) -> List<String> =
  match e.trace {
    None -> [],
    Some(c) ->
      [
        ind()
          ++ dim(
            s,
            "trace       " ++ int_to_string(c.events) ++ " event(s) · " ++ int_to_string(c.spans)
              ++ " span(s) · "
              ++ int_to_string(c.abandoned)
              ++ " abandoned · "
              ++ (if c.flushed { "flushed" } else { "not flushed" }),
          ),
      ],
  }

// Nothing when nobody asked the service to stop.
fn stop_lines(s: Style, e: Ended) -> List<String> =
  match e.stopping {
    None -> [],
    Some(g) ->
      also(
        also(
          [stopped_line(s, g, e.teardown), drain_line(s, g, expired_of(e))],
          teardown_lines(s, e.teardown),
        ),
        trace_lines(s, e),
      ),
  }

fn primary_of(d: Diag) -> Option<Label> = {
  let start: Option<Label> = None;
  fold(d.labels, start, |acc: Option<Label>, l: Label|
    match acc { Some(_) -> acc, None -> if l.primary { Some(l) } else { None } })
}

fn spotted(places: List<Place>, l: Label) -> Option<String> =
  if l.module == no_module() { None } else {
    match list_at(places, l.module) {
      None -> None,
      Some(p) -> {
        let at: Spot = spot_of(p.text, l.start);
        Some(p.path ++ ":" ++ int_to_string(at.line) ++ ":" ++ int_to_string(at.col))
      },
    }
  }

// Where the raise happened, for a reader with the file open.
fn raised_at(s: Style, t: Target, d: Diag) -> List<String> =
  if drained(d) || abandoned(d) { [] } else {
    match primary_of(d) {
      None -> [],
      Some(l) -> match spotted(places_of(t), l) {
        None -> [],
        Some(at) -> [ind() ++ red(s, "raised at") ++ " " ++ at],
      },
    }
  }

// --- The document -----------------------------------------------------------

// What the run was over: a program has a root and its files, an artifact a file and a digest.
fn identity(t: Target) -> List<Member> =
  match t {
    Project(p) -> [{ key: "root", value: Str(p.root) }, { key: "files", value: texts(p.files) }],
    Deployed(a) ->
      [
        { key: "artifact", value: Str(a.path) },
        { key: "digest", value: Str(a.digest) },
        { key: "definitions", value: num(a.definitions) },
      ],
  }

fn counters_json(c: Counters) -> Json =
  object([
    { key: "updates", value: num(c.updates) },
    { key: "updates_in_place", value: num(c.updates_in_place) },
    { key: "in_place", value: match c.in_place { Some(d) -> Number(d), None -> Null } },
    { key: "cycles", value: num(c.cycles) },
  ])

// One shape whether or not anybody asked the run to stop, so a deployment reads one `shutdown`
// block whichever form it shipped.
fn shutdown_json(e: Ended) -> Json =
  object([
    { key: "requested", value: Bool(match e.stopping { Some(_) -> true, None -> false }) },
    { key: "signal", value: match e.stopping { Some(g) -> text_or_null(g.signal), None -> Null } },
    { key: "drain_ms", value: num(e.teardown.drain_ms) },
    { key: "drain_lead_ms", value: num(e.teardown.lead_ms) },
    { key: "transactions_rolled_back", value: num(e.teardown.transactions_rolled_back) },
    { key: "connections_closed", value: num(e.teardown.connections_closed) },
    { key: "spans_abandoned", value: num(e.teardown.spans_abandoned) },
    { key: "problems", value: texts(e.teardown.problems) },
  ])

fn document(
  t: Target,
  en: String,
  b: Bound,
  e: Ended,
  ok: Bool,
  code: Int,
  diags: List<Diag>,
) -> Json =
  object(
    also(
      also(
        [
          { key: "command", value: Str("run") },
          { key: "ok", value: Bool(ok) },
          { key: "exit_code", value: num(code) },
        ],
        identity(t),
      ),
      [
        { key: "entry", value: Str(en) },
        { key: "module", value: Str(module_of(en)) },
        { key: "binding", value: Str(if b.hermetic { "hermetic" } else { "host" }) },
        { key: "counters", value: counters_json(e.counters) },
        { key: "hosts", value: e.hosts },
        { key: "value", value: text_or_null(e.value) },
        { key: "configuration", value: e.configuration },
        { key: "shutdown", value: shutdown_json(e) },
        { key: "diagnostics", value: all_to_json(diags, places_of(t)) },
      ],
    ),
  )

// --- The answer -------------------------------------------------------------

// Everything the run has to say about itself that is not the entry's own answer.
fn noted(t: Target, b: Bound, e: Ended) -> List<Diag> = also(also(told_of(t), b.warnings), e.cycles)

// The program chose its code and returned no value, so none is printed.
fn exited(s: Style, t: Target, en: String, b: Bound, e: Ended, code: Int) -> Answer =
  {
    json: document(t, en, b, e, code == ok_code(), code, noted(t, b, e)),
    lines: handshake_lines(s, e),
    errs: also(all_to_text(s, e.cycles, places_of(t)), stop_lines(s, e)),
    code: code,
  }

fn answered(s: Style, t: Target, en: String, b: Bound, e: Ended) -> Answer =
  {
    json: document(t, en, b, e, true, ok_code(), noted(t, b, e)),
    lines: also(handshake_lines(s, e), [ind() ++ (match e.value { Some(v) -> v, None -> "" })]),
    errs: also(all_to_text(s, e.cycles, places_of(t)), stop_lines(s, e)),
    code: ok_code(),
  }

fn raised(s: Style, t: Target, en: String, b: Bound, e: Ended, d: Diag) -> Answer = {
  let code = if drained(d) { drain_incomplete() } else { failed() };
  {
    json: document(t, en, b, e, false, code, push(noted(t, b, e), d)),
    lines: [],
    errs: also(
      also(
        also(all_to_text(s, e.cycles, places_of(t)), stop_lines(s, e)),
        all_to_text(s, [d], places_of(t)),
      ),
      raised_at(s, t, d),
    ),
    code: code,
  }
}

fn ended(s: Style, t: Target, en: String, b: Bound, e: Ended) -> Answer =
  match e.exit {
    Some(code) -> exited(s, t, en, b, e, code),
    None -> match e.raised {
      None -> answered(s, t, en, b, e),
      Some(d) -> raised(s, t, en, b, e, d),
    },
  }

// A `.plyx` that is not one is refused about the file: there is no program to tally errors over.
fn unread(s: Style, path: String, why: Refusal) -> Answer =
  {
    json: object([
      { key: "command", value: Str("run") },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: num(compile_error()) },
      { key: "artifact", value: Str(path) },
      { key: "diagnostics", value: all_to_json(why.diags, why.places) },
    ]),
    lines: [],
    errs: all_to_text(s, why.diags, why.places),
    code: compile_error(),
  }

fn unloaded(s: Style, why: Refusal) -> Answer =
  match why.artifact {
    None -> refused(s, "run", why.diags, why.places),
    Some(path) -> unread(s, path, why),
  }

// The entry point is named before anything is bound, so nothing ran and nothing is tallied.
fn unentered(s: Style, t: Target, d: Diag) -> Answer =
  {
    json: object(
      also(
        also(
          [
            { key: "command", value: Str("run") },
            { key: "ok", value: Bool(false) },
            { key: "exit_code", value: num(compile_error()) },
          ],
          identity(t),
        ),
        [{ key: "diagnostics", value: all_to_json([d], places_of(t)) }],
      ),
    ),
    lines: [],
    errs: all_to_text(s, [d], places_of(t)),
    code: compile_error(),
  }

// A registration that does not match the program is a start-up failure: nothing ran.
fn unbound(s: Style, why: Refusal) -> Answer = {
  let tally = ind() ++ red(s, "no host handler was bound") ++ " ("
    ++ count_of(len(why.diags), "error")
    ++ ")";
  {
    json: object([
      { key: "command", value: Str("run") },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: num(compile_error()) },
      { key: "binding", value: Str("host") },
      { key: "diagnostics", value: all_to_json(why.diags, why.places) },
    ]),
    lines: [],
    errs: push(all_to_text(s, why.diags, why.places), tally),
    code: compile_error(),
  }
}

fn started(
  s: Style,
  flags: Flags,
  t: Target,
  en: String,
) -> Answer / {machine.bound[run], machine.enter[run], process.out[proc], process.err[proc]} =
  match machine.bound[run](en) {
    Err(why) -> unbound(s, why),
    Ok(b) -> {
      disclosed(s, flags, t, b);
      ended(s, t, en, b, machine.enter[run]())
    },
  }

fn chosen(
  s: Style,
  flags: Flags,
  t: Target,
) -> Answer / {machine.bound[run], machine.enter[run], process.out[proc], process.err[proc]} =
  match entry_of(t) { Err(d) -> unentered(s, t, d), Ok(en) -> started(s, flags, t, en) }

pub fn run(
  flags: Flags,
) -> Answer / {machine.load[run], machine.bound[run], machine.enter[run], process.out[proc], process.err[proc]} = {
  let s: Style = style_of(flags);
  match machine.load[run](root_of(flags)) {
    Err(why) -> unloaded(s, why),
    Ok(t) -> chosen(s, flags, t),
  }
}

// --- Tests ------------------------------------------------------------------

fn a_main() -> Main =
  { name: "m.main", module: "m", path: "m.ply", at: { module: 0, start: 3, end: 7 } }

fn a_program() -> Target =
  Project({
    root: "/p",
    files: ["m.ply"],
    places: [{ path: "m.ply", text: b"fn main() -> Int = 42\n" }],
    mains: [a_main()],
    modules: [{ name: "m", path: "m.ply", at: { module: 0, start: 22, end: 22 } }],
  })

fn an_artifact() -> Target =
  Deployed({
    path: "m.plyx",
    digest: "b3:1f2e3d4c5b6a",
    entry: "m.main",
    definitions: 3,
    unit: true,
    warnings: [],
  })

fn hermetic() -> Bound =
  {
    hermetic: true,
    operations: 0,
    digest: "",
    config: None,
    trace: None,
    database: None,
    signals: None,
    warnings: [],
  }

fn a_binding() -> Bound =
  {
    hermetic: false,
    operations: 7,
    digest: "b3:aabbccddeeff",
    config: Some("2 keys · 1 secret"),
    trace: Some("json on stderr · info"),
    database: Some("database postgres://db/app · 3 operations · configured by --db"),
    signals: Some({ names: ["SIGINT", "SIGTERM"], lead_ms: 0, drain_ms: 30000 }),
    warnings: [],
  }

fn no_counters() -> Counters = { updates: 0, updates_in_place: 0, in_place: None, cycles: 0 }

fn no_teardown() -> Teardown =
  {
    lead_ms: 0,
    drain_ms: 30000,
    transactions_rolled_back: 0,
    connections_closed: 0,
    spans_abandoned: 0,
    problems: [],
  }

fn answered_with(value: String) -> Ended =
  {
    exit: None,
    value: Some(value),
    raised: None,
    counters: no_counters(),
    cycles: [],
    stopping: None,
    teardown: no_teardown(),
    trace: None,
    handshakes: [],
    hosts: Null,
    configuration: Null,
  }

fn a_diag(code: Bytes, message: Bytes, labels: List<Label>) -> Diag =
  {
    code: code,
    notes: 0,
    labels: labels,
    text: b"",
    message: message,
    notes_text: [],
    severity: b"error",
    fixes: [],
  }

fn nothing() -> Refusal = { diags: [], places: [], artifact: None }

// The run's own answer over a load, a binding and an entry the test hands it in place of the Rust
// side, with whatever it wrote on either stream captured beside it.
type Ran = { answer: Answer, out: List<String>, err: List<String> }

fn ran_over(flags: Flags, t: Result<Target, Refusal>, b: Result<Bound, Refusal>, e: Ended) -> Ran =
  with_cell[twin](captured([])) { io -> {
    let answer: Answer = handle {
      run(flags)
    } with {
      machine.load[run](_root) -> t,
      machine.bound[run](named) -> b,
      machine.enter[run]() -> e,
      process.out[proc](text) -> cell_set(io, out_step(cell_get(io), text)),
      process.err[proc](text) -> cell_set(io, err_step(cell_get(io), text)),
    };
    let said: Captured = cell_get(io);
    { answer: answer, out: said.out, err: said.err }
  } }

fn bare() -> Flags = read([])

fn as_json() -> Flags = read(["--json"])

test "a value the entry answered with is one indented line and exit 0" {
  let ran = ran_over(bare(), Ok(a_program()), Ok(hermetic()), answered_with("42"));
  assert_eq(ran.answer.code, 0);
  assert_eq(ran.answer.lines, ["   42"]);
  assert_eq(ran.answer.errs, []);
  assert_eq(ran.out, []);
  assert_eq(ran.err, [])
}

test "the object keys off `command` and `exit_code`, and names the entry and its module" {
  let text = to_string(
    ran_over(as_json(), Ok(a_program()), Ok(hermetic()), answered_with("42")).answer.json,
  );
  assert(string_contains(text, "\"command\":\"run\""));
  assert(string_contains(text, "\"exit_code\":0"));
  assert(string_contains(text, "\"entry\":\"m.main\""));
  assert(string_contains(text, "\"module\":\"m\""));
  assert(string_contains(text, "\"binding\":\"hermetic\""));
  assert(string_contains(text, "\"value\":\"42\""));
  assert(string_contains(text, "\"root\":\"/p\""));
  assert(string_contains(text, "\"files\":[\"m.ply\"]"))
}

// What a run may reach is disclosed while the entry is still ahead of it, so it goes out on the
// stream as the program runs rather than in the answer collected after it.
test "a bound run discloses what it may reach before the entry is entered" {
  let ran = ran_over(bare(), Ok(a_program()), Ok(a_binding()), answered_with("42"));
  assert_eq(ran.out, [
    "   binding host · 7 operations · b3:aabbccddeeff",
    "   config      2 keys · 1 secret",
    "   trace       json on stderr · info",
    "   database postgres://db/app · 3 operations · configured by --db",
  ]);
  assert_eq(ran.err, [
    "   shutdown    signals SIGINT SIGTERM · lead 0ms · drain 30000ms · second signal exits 130/143",
  ]);
  assert_eq(ran.answer.lines, ["   42"])
}

test "`--json` promises stdout to the one object, so nothing else is written at all" {
  let ran = ran_over(as_json(), Ok(a_program()), Ok(a_binding()), answered_with("42"));
  assert_eq(ran.out, []);
  assert_eq(ran.err, []);
  assert(string_contains(to_string(ran.answer.json), "\"binding\":\"host\""))
}

test "a hermetic run discloses nothing, because there is nothing it could reach" {
  let ran = ran_over(bare(), Ok(a_program()), Ok(hermetic()), answered_with("()"));
  assert_eq(ran.out, []);
  assert_eq(ran.err, [])
}

test "a raise is exit 1, and says where it was raised for a reader with the file open" {
  let raise = {
    ..answered_with("42"),
    value: None,
    raised: Some(
      a_diag(b"E0501", b"nope", [{ module: 0, start: 19, end: 21, primary: true, text: b"here" }]),
    ),
  };
  let ran = ran_over(bare(), Ok(a_program()), Ok(hermetic()), raise);
  assert_eq(ran.answer.code, 1);
  assert_eq(ran.answer.lines, []);
  assert_eq(nth(ran.answer.errs, 0), "Error[E0501]: nope");
  assert_eq(nth(ran.answer.errs, len(ran.answer.errs) - 1), "   raised at m.ply:1:20")
}

test "an expired drain is exit 3, and is not attributed to a line of the program" {
  let expired = {
    ..answered_with("()"),
    value: None,
    raised: Some(a_diag(b"W0608", b"the drain deadline expired", [])),
  };
  let ran = ran_over(bare(), Ok(a_program()), Ok(a_binding()), expired);
  assert_eq(ran.answer.code, 3);
  assert_eq(len(filter(ran.answer.errs, |l: String| string_contains(l, "raised at"))), 0)
}

test "a program that chose its own exit code is answered with that code and no value" {
  let chose = { ..answered_with("()"), exit: Some(7), value: None };
  let ran = ran_over(bare(), Ok(a_program()), Ok(hermetic()), chose);
  assert_eq(ran.answer.code, 7);
  assert_eq(ran.answer.lines, []);
  let text = to_string(ran_over(as_json(), Ok(a_program()), Ok(hermetic()), chose).answer.json);
  assert(string_contains(text, "\"exit_code\":7"));
  assert(string_contains(text, "\"ok\":false"));
  assert(string_contains(text, "\"value\":null"))
}

test "a stopped run says what was in flight, how long the drain took, and what it rolled back" {
  let stopped = {
    ..answered_with("()"),
    stopping: Some({
      signal: Some("SIGTERM"),
      listeners: 1,
      connections: 2,
      scopes: 1,
      elapsed_ms: 40,
    }),
    teardown: {
      ..no_teardown(),
      transactions_rolled_back: 1,
      connections_closed: 2,
      spans_abandoned: 3,
      problems: ["a sink would not flush"],
    },
    trace: Some({ events: 9, spans: 4, abandoned: 1, flushed: true }),
  };
  let ran = ran_over(bare(), Ok(a_program()), Ok(a_binding()), stopped);
  assert_eq(ran.answer.errs, [
    "   stopping    signal SIGTERM · lead 0ms · drain 30000ms · 1 listener(s) closed · 2 connection(s) in flight · 1 transaction(s) open",
    "   drained       40ms since the signal",
    "   teardown    1 transaction(s) rolled back, none committed · 2 connection(s) closed rather than returned · 3 span(s) abandoned · sink flushed",
    "   warning[W0606]: a sink would not flush",
    "   trace       9 event(s) · 4 span(s) · 1 abandoned · flushed",
  ])
}

test "an artifact says which file it ran, its digest, and what it carries" {
  let ran = ran_over(bare(), Ok(an_artifact()), Ok(hermetic()), answered_with("42"));
  assert_eq(ran.out, ["   program b3:1f2e3d4c5b6a · 3 definitions · compiled unit embedded"]);
  let text = to_string(
    ran_over(as_json(), Ok(an_artifact()), Ok(hermetic()), answered_with("42")).answer.json,
  );
  assert(string_contains(text, "\"artifact\":\"m.plyx\""));
  assert(string_contains(text, "\"digest\":\"b3:1f2e3d4c5b6a\""));
  assert(string_contains(text, "\"definitions\":3"));
  assert(string_contains(text, "\"entry\":\"m.main\""))
}

test "an artifact whose unit this runtime cannot enter says so and still runs" {
  let aside = a_diag(b"E0444", b"the artifact's compiled unit was built for another runtime", []);
  let stale = Deployed({
    path: "m.plyx",
    digest: "b3:aaa",
    entry: "m.main",
    definitions: 1,
    unit: false,
    warnings: [{ ..aside, severity: b"warning" }],
  });
  let ran = ran_over(bare(), Ok(stale), Ok(hermetic()), answered_with("42"));
  assert_eq(
    nth(ran.out, 0),
    "   warning: the artifact's compiled unit was built for another runtime",
  );
  assert(string_contains(nth(ran.out, 1), "no compiled unit"));
  assert_eq(ran.answer.code, 0)
}

test "a program that does not load is the load's own refusal with the tally under it" {
  let why: Refusal = {
    diags: [a_diag(b"E0201", b"type mismatch", [])],
    places: [],
    artifact: None,
  };
  let ran = ran_over(bare(), Err(why), Err(nothing()), answered_with(""));
  assert_eq(ran.answer.code, 2);
  assert_eq(ran.answer.lines, []);
  assert_eq(ran.answer.errs, [
    "Error[E0201]: type mismatch",
    ind() ++ "compilation failed (1 error)",
  ])
}

test "a file that is not an artifact is refused about the file and tallies nothing" {
  let why: Refusal = {
    diags: [a_diag(b"E0443", b"not a program at all", [])],
    places: [],
    artifact: Some("junk.plyx"),
  };
  let text = to_string(
    ran_over(as_json(), Err(why), Err(nothing()), answered_with("")).answer.json,
  );
  assert(string_contains(text, "\"artifact\":\"junk.plyx\""));
  assert(string_contains(text, "\"E0443\""));
  let ran = ran_over(bare(), Err(why), Err(nothing()), answered_with(""));
  assert_eq(ran.answer.code, 2);
  assert_eq(ran.answer.errs, ["Error[E0443]: not a program at all"])
}

test "a program with no `main` is refused over its own files before anything is bound" {
  let empty = Project({
    root: "/p",
    files: ["m.ply"],
    places: [],
    mains: [],
    modules: [{ name: "m", path: "m.ply", at: { module: 0, start: 18, end: 18 } }],
  });
  let ran = ran_over(as_json(), Ok(empty), Err(nothing()), answered_with(""));
  assert_eq(ran.answer.code, 2);
  let text = to_string(ran.answer.json);
  assert(string_contains(text, "\"root\":\"/p\""));
  assert(string_contains(text, "\"E0101\""))
}

test "a binding that does not match the program is a start-up failure naming no line" {
  let why: Refusal = {
    diags: [a_diag(b"E0431", b"no database was configured", [])],
    places: [],
    artifact: None,
  };
  let ran = ran_over(bare(), Ok(a_program()), Err(why), answered_with(""));
  assert_eq(ran.answer.code, 2);
  assert_eq(ran.answer.errs, [
    "Error[E0431]: no database was configured",
    ind() ++ "no host handler was bound (1 error)",
  ]);
  assert(
    string_contains(
      to_string(ran_over(as_json(), Ok(a_program()), Err(why), answered_with("")).answer.json),
      "\"binding\":\"host\"",
    ),
  )
}

test "what the machine reused is a count and a ratio, and no ratio at all over nothing" {
  let reused = {
    ..answered_with("42"),
    counters: { updates: 4, updates_in_place: 3, in_place: decimal_of_string("0.75"), cycles: 0 },
  };
  let text = to_string(ran_over(as_json(), Ok(a_program()), Ok(hermetic()), reused).answer.json);
  assert(string_contains(text, "\"updates\":4"));
  assert(string_contains(text, "\"updates_in_place\":3"));
  assert(string_contains(text, "\"in_place\":0.75"));
  let over_nothing = to_string(
    ran_over(as_json(), Ok(a_program()), Ok(hermetic()), answered_with("42")).answer.json,
  );
  assert(string_contains(over_nothing, "\"in_place\":null"))
}

test "a definition's module is its name without its own last segment" {
  assert_eq(module_of("m.main"), "m");
  assert_eq(module_of("store.orders.main"), "store.orders")
}
