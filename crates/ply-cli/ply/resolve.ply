// `ply resolve` — write the lockfile from the manifest closure. This is the deliberate act that
// accepts a dependency whose sources moved: a build refuses one (`E0138`) and points here, and what
// this writes is the closure it just read, so a lock can only ever describe a closure that was
// loaded. It is also the one command that asks a registry: the registry dependencies the closure
// selects are fetched into the project's cache first, and every later walk reads them there.

import std.random (entropy)
import std.time (time)
import builder (builder)
import args (Flags, style_of)
import env (env)
import lock
import lock (Archived, Pinned, from_front, path_of, text)
import paths (Resolved, displayed, here, write_file)
import program (Program, load_program)
import remote
import report (Answer, indent, ok_code, count_of, refused, reported)
import sources (load_resolved)
import style (Style, bold, green, plain)
import compiler.resolve (Diag, error_at)
import signing (public_of, unkeyed)
import std.bin
import std.bytes (hex_of)
import std.fs (fs)
import std.json (Json, Array, Bool, Member, Null, Number, Str, object, to_string)
import std.net (net)
import std.pkg (Attestation, attestation_bin, attested)
import std.signed (countersigned, signed_bytes, signed_of, vouched_by)
import std.ed25519
import semantics
import paths

// The root the command was pointed at, as the resolved path the lock is written under.
fn root_of(flags: Flags) -> Resolved =
  match list_at(flags.paths, 0) { Some(r) -> r, None -> here() }

fn outside() -> Int = 4294967295

fn unwritable(path: String) -> Diag =
  error_at(
    b"E0502",
    outside(),
    { start: 0, end: 0 },
    bytes_of_string("could not write `" ++ path ++ "`"),
    b"the lockfile was not written",
    [b"check the directory's permissions, or point `ply resolve` at another project"],
  )

fn archived_of(archives: List<Archived>, pin: Pinned) -> Option<Archived> =
  fold(archives, None, |found: Option<Archived>, a: Archived|
    match found {
      Some(_) -> found,
      None -> if a.name == pin.name && a.version == pin.version { Some(a) } else { None },
    })

// --- Attestations --------------------------------------------------------------------
// A registry dependency's attestation is believed only when a key `PLY_ATTESTERS` names signed it,
// for the archive the lock pins, under this `ply`'s semantics: whichever build ran it.

fn attesters_variable() -> String = "PLY_ATTESTERS"

// The public key files `PLY_ATTESTERS` names, separated as `PATH` separates directories.
fn attesters() -> Result<List<Bytes>, Diag> / {env.var[sys], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match env.var[sys](attesters_variable()) {
    None -> Ok([]),
    Some(text) ->
      fold(string_split(text, ":"), Ok([]), |acc: Result<List<Bytes>, Diag>, path: String|
        match acc {
          Err(d) -> Err(d),
          Ok(keys) -> if path == "" { Ok(keys) } else {
            match paths::read_file(paths::spelled(path)) {
              None -> Err(unkeyed(path, "cannot be read")),
              Some(b) -> match public_of(string_of_bytes_lossy(b)) {
                Ok(k) -> Ok(push(keys, k)),
                Err(why) -> Err(unkeyed(path, "does not hold a public key: " ++ why)),
              },
            }
          },
        }),
  }

type Vouched = { signer: Option<Bytes>, attestation: Attestation }

fn vouched(a: Archived, keys: List<Bytes>) -> Option<Vouched> / {abort.raise} =
  match a.attestation {
    None -> None,
    Some(b) -> match signed_of(b) {
      None -> None,
      Some(doc) -> match bin::decode(doc.payload, attestation_bin()) {
        Err(_) -> None,
        Ok(x) -> if x.archive != a.archive || x.semantics != semantics::version() { None }
        else { Some({ signer: vouched_by(doc, keys), attestation: x }) },
      },
    },
  }

fn held(v: Vouched) -> Bool = v.signer != None && attested(v.attestation)

fn count(n: Int) -> Json = Number(decimal_of_int(n))

fn vouched_json(v: Option<Vouched>) -> Json / {abort.raise} =
  match v {
    None -> Null,
    Some(x) ->
      object([
        { key: "attested", value: Bool(held(x)) },
        { key: "trusted", value: Bool(x.signer != None) },
        { key: "signer", value: match x.signer { Some(k) -> Str(hex_of(k)), None -> Null } },
        { key: "checked", value: Bool(x.attestation.checked) },
        { key: "promises", value: Bool(x.attestation.promises) },
        {
          key: "tests",
          value: object([
            { key: "passed", value: count(x.attestation.tests.passed) },
            { key: "failed", value: count(x.attestation.tests.failed) },
          ]),
        },
        {
          key: "proofs",
          value: object([
            { key: "proved", value: count(x.attestation.proofs.proved) },
            { key: "property", value: count(x.attestation.proofs.property) },
            { key: "example", value: count(x.attestation.proofs.example) },
            { key: "refuted", value: count(x.attestation.proofs.refuted) },
            { key: "unattempted", value: count(x.attestation.proofs.unattempted) },
          ]),
        },
        { key: "builder", value: Str(x.attestation.builder) },
      ]),
  }

fn one(pin: Pinned, archived: Option<Archived>, keys: List<Bytes>) -> String =
  pin.name ++ " " ++ pin.version ++ " · " ++ pin.digest
    ++ (match archived {
      Some(a) ->
        " · registry"
          ++ (match vouched(a, keys) {
            None -> "",
            Some(v) -> if held(v) { " · attested" } else { " · not attested" },
          }),
      None -> "",
    })

// The head names the lock and how many packages it pins. `--json` prints the object instead.
fn lines(style: Style, pins: List<Pinned>, path: String) -> List<String> =
  [indent() ++ green(style, "resolved") ++ " " ++ count_of(len(pins), "package") ++ " · " ++ path]

fn json_of(
  pins: List<Pinned>,
  archives: List<Archived>,
  keys: List<Bytes>,
  path: String,
  code: Int,
  wrote: Bool,
) -> Json / {abort.raise} =
  object([
    { key: "command", value: Str("resolve") },
    { key: "ok", value: Bool(code == ok_code()) },
    { key: "exit_code", value: Number(decimal_of_int(code)) },
    { key: "lockfile", value: Str(path) },
    { key: "written", value: Bool(wrote) },
    {
      key: "packages",
      value: Array(
        map(pins, |pin: Pinned|
          object(
            fold(
              match archived_of(archives, pin) {
                None -> [],
                Some(a) ->
                  [
                    { key: "archive", value: Str(a.archive) },
                    { key: "interface", value: Bool(a.interface) },
                    { key: "attestation", value: vouched_json(vouched(a, keys)) },
                  ],
              },
              [
                { key: "name", value: Str(pin.name) },
                { key: "version", value: Str(pin.version) },
                { key: "digest", value: Str(pin.digest) },
              ],
              |acc: List<Member>, m: Member| push(acc, m),
            ),
          )),
      ),
    },
  ])

// One line per package under the head: what the lock records, written down where a person can read
// it without opening the file.
fn answered(
  style: Style,
  pins: List<Pinned>,
  archives: List<Archived>,
  keys: List<Bytes>,
  path: String,
  code: Int,
  wrote: Bool,
  more: Bool,
) -> Answer = {
  let body: List<String> = map(pins, |pin: Pinned|
    indent() ++ "  " ++ one(pin, archived_of(archives, pin), keys));
  {
    json: json_of(pins, archives, keys, path, code, wrote),
    lines: append_lines(lines(style, pins, path), if more { body } else { [] }),
    errs: [],
    code: code,
  }
}

fn append_lines(a: List<String>, b: List<String>) -> List<String> =
  fold(b, a, |acc: List<String>, x: String| push(acc, x))

pub fn run(
  flags: Flags,
) -> Answer / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shelf], fs.read_file[shelf], fs.write_file[cwd], fs.write_file[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.var[sys], net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.create_dir[abs], fs.remove[abs], fs.rename[abs], abort.raise} = {
  let s = style_of(flags);
  let r = root_of(flags);
  // The lock is read before anything is fetched: the archive digests it pins are what a registry's
  // answer for a pinned version is checked against.
  match attesters() {
    Err(d) -> reported(s, "resolve", [d], []),
    Ok(keys) -> match lock::read(r) {
      Err(why) -> reported(s, "resolve", [lock::refused(r, why)], []),
      Ok(existing) -> match remote::resolved(load_resolved(flags.paths), existing) {
        Err(d) -> reported(s, "resolve", [d], []),
        Ok(archives) -> pinned(s, flags, r, archives, keys),
      },
    },
  }
}

fn pinned(
  style: Style,
  flags: Flags,
  resolved: Resolved,
  archives: List<Archived>,
  keys: List<Bytes>,
) -> Answer / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shelf], fs.read_file[shelf], fs.write_file[cwd], fs.write_file[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} = {
  let loaded: Program = load_program(flags.paths);
  match loaded.whole {
    None -> refused(style, "resolve", loaded.diags, loaded.places),
    Some(w) -> {
      let pins = from_front(w.pins);
      let at = path_of(resolved);
      let body = bytes_of_string(text(None, pins, archives));
      if !write_file(at, body) {
        reported(style, "resolve", [unwritable(displayed(at))], loaded.places)
      } else { answered(style, pins, archives, keys, displayed(at), ok_code(), true, !flags.json) }
    },
  }
}

// --- Tests ------------------------------------------------------------------

fn a_pin(name: String, version: String, digest: String) -> Pinned =
  { name: name, version: version, digest: digest }

test "a resolve names what it pinned, one line per package" {
  let pins = [a_pin("lib", "0.1.0", "b3:1f2e3d4c5b6a"), a_pin("base", "0.0.1", "b3:99aa")];
  let answer = answered(
    plain(),
    pins,
    [{ name: "base", version: "0.0.1", archive: "b3:77", interface: false, attestation: None }],
    [],
    "app/ply.lock",
    ok_code(),
    true,
    true,
  );
  assert_eq(answer.code, 0);
  assert_eq(answer.lines, [
    "   resolved 2 packages · app/ply.lock",
    "     lib 0.1.0 · b3:1f2e3d4c5b6a",
    "     base 0.0.1 · b3:99aa · registry",
  ])
}

test "the json answer carries every pin, and `--json` prints no lines" {
  let pins = [a_pin("lib", "0.1.0", "b3:1f2e3d4c5b6a")];
  let text = to_string(
    json_of(
      pins,
      [{ name: "lib", version: "0.1.0", archive: "b3:77", interface: true, attestation: None }],
      [],
      "app/ply.lock",
      ok_code(),
      true,
    ),
  );
  assert(string_contains(text, "\"command\":\"resolve\""));
  assert(string_contains(text, "\"lockfile\":\"app/ply.lock\""));
  assert(string_contains(text, "\"written\":true"));
  assert(string_contains(text, "\"name\":\"lib\""));
  assert(string_contains(text, "\"digest\":\"b3:1f2e3d4c5b6a\""));
  assert(string_contains(text, "\"archive\":\"b3:77\""));
  assert(string_contains(text, "\"interface\":true"));
  assert_eq(lines(plain(), pins, "app/ply.lock"), ["   resolved 1 package · app/ply.lock"])
}

test "a project with no dependencies resolves to an empty lock" {
  let answer = answered(plain(), [], [], [], "ply.lock", ok_code(), true, false);
  assert_eq(answer.lines, ["   resolved 0 packages · ply.lock"])
}

fn a_seed(n: Int) -> Bytes / {abort.raise} =
  bytes_concat_all(map(range(0, 32), |i: Int| byte_of_int((i + n) % 256)))

fn an_attestation(builder: String, semantics: String) -> Attestation =
  {
    name: "orders",
    version: { major: 0, minor: 1, patch: 0 },
    archive: "b3:77",
    semantics: semantics,
    builder: builder,
    checked: true,
    promises: true,
    tests: { passed: 2, failed: 0 },
    proofs: { proved: 1, property: 0, example: 0, fitted: 0, refuted: 0, unattempted: 0 },
  }

fn archived_with(a: Attestation) -> Archived / {abort.raise} =
  {
    name: "orders",
    version: "0.1.0",
    archive: "b3:77",
    interface: false,
    attestation: Some(
      signed_bytes(
        countersigned({ payload: bin::encode(a, attestation_bin()), signatures: [] }, a_seed(1)),
      ),
    ),
  }

test "an attestation another build signed is believed under these semantics, and never under others" {
  let key = ed25519::public_key(a_seed(1));
  let other_build = archived_with(an_attestation("ply 9.9.9", semantics::version()));
  match vouched(other_build, [key]) {
    None -> panic("an attestation under these semantics was not read"),
    Some(v) -> assert(held(v)),
  };
  assert(match vouched(other_build, []) { Some(v) -> !held(v), None -> false });
  assert_eq(vouched(archived_with(an_attestation("ply 9.9.9", "elsewhere")), [key]), None);
  assert_eq(vouched({ ..other_build, archive: "b3:88" }, [key]), None)
}
