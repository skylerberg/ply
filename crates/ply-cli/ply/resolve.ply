// `ply resolve` — write the lockfile from the manifest closure. This is the deliberate act that
// accepts a dependency whose sources moved: a build refuses one (`E0138`) and points here, and what
// this writes is the closure it just read, so a lock can only ever describe a closure that was
// loaded. It is also the one command that asks a registry: the registry dependencies the closure
// selects are fetched into the project's cache first, and every later walk reads them there.

import std.random (entropy)
import std.time (time)
import builder (builder)
import args (Flags, style_of)
import env (env)
import lock
import lock (Archived, Pinned, from_front, path_of, text)
import paths (Resolved, displayed, here, write_file)
import program (Program, load_program)
import remote
import report (Answer, ind, ok_code, count_of, refused, reported)
import sources (load_resolved)
import style (Style, bold, green, plain)
import compiler.resolve (Diag, diag1)
import std.fs (fs)
import std.json (Json, Array, Bool, Member, Number, Str, object, to_string)
import std.net (net)

// The root the command was pointed at, as the resolved path the lock is written under.
fn root_of(flags: Flags) -> Resolved =
  match list_at(flags.paths, 0) { Some(r) -> r, None -> here() }

fn outside() -> Int = 4294967295

fn unwritable(path: String) -> Diag =
  diag1(
    b"E0502",
    outside(),
    { start: 0, end: 0 },
    bytes_of_string("could not write `" ++ path ++ "`"),
    b"the lockfile was not written",
    [b"check the directory's permissions, or point `ply resolve` at another project"],
  )

fn archived_of(archives: List<Archived>, p: Pinned) -> Option<Archived> =
  fold(archives, None, |found: Option<Archived>, a: Archived|
    match found {
      Some(_) -> found,
      None -> if a.name == p.name && a.version == p.version { Some(a) } else { None },
    })

fn archive_of(archives: List<Archived>, p: Pinned) -> Option<String> =
  match archived_of(archives, p) { Some(a) -> Some(a.archive), None -> None }

fn one(p: Pinned, archive: Option<String>) -> String =
  p.name ++ " " ++ p.version ++ " · " ++ p.digest
    ++ (match archive { Some(_) -> " · registry", None -> "" })

// The head names the lock and how many packages it pins. `--json` prints the object instead.
fn lines(s: Style, pins: List<Pinned>, path: String) -> List<String> / {abort.raise} =
  [ind() ++ green(s, "resolved") ++ " " ++ count_of(len(pins), "package") ++ " · " ++ path]

fn json_of(
  pins: List<Pinned>,
  archives: List<Archived>,
  path: String,
  code: Int,
  wrote: Bool,
) -> Json =
  object([
    { key: "command", value: Str("resolve") },
    { key: "ok", value: Bool(code == ok_code()) },
    { key: "exit_code", value: Number(decimal_of_int(code)) },
    { key: "lockfile", value: Str(path) },
    { key: "written", value: Bool(wrote) },
    {
      key: "packages",
      value: Array(
        map(pins, |p: Pinned|
          object(
            fold(
              match archived_of(archives, p) {
                None -> [],
                Some(a) ->
                  [
                    { key: "archive", value: Str(a.archive) },
                    { key: "interface", value: Bool(a.interface) },
                  ],
              },
              [
                { key: "name", value: Str(p.name) },
                { key: "version", value: Str(p.version) },
                { key: "digest", value: Str(p.digest) },
              ],
              |acc: List<Member>, m: Member| push(acc, m),
            ),
          )),
      ),
    },
  ])

// One line per package under the head: what the lock records, written down where a person can read
// it without opening the file.
fn answered(
  s: Style,
  pins: List<Pinned>,
  archives: List<Archived>,
  path: String,
  code: Int,
  wrote: Bool,
  more: Bool,
) -> Answer / {abort.raise} = {
  let body: List<String> = map(pins, |p: Pinned| ind() ++ "  " ++ one(p, archive_of(archives, p)));
  {
    json: json_of(pins, archives, path, code, wrote),
    lines: append_lines(lines(s, pins, path), if more { body } else { [] }),
    errs: [],
    code: code,
  }
}

fn append_lines(a: List<String>, b: List<String>) -> List<String> =
  fold(b, a, |acc: List<String>, x: String| push(acc, x))

pub fn run(
  flags: Flags,
) -> Answer / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shelf], fs.read_file[shelf], fs.write_file[cwd], fs.write_file[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.var[sys], net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], fs.create_dir[abs], fs.remove[abs], fs.rename[abs], abort.raise} = {
  let s = style_of(flags);
  let r = root_of(flags);
  // The lock is read before anything is fetched: the archive digests it pins are what a registry's
  // answer for a pinned version is checked against.
  match lock::read(r) {
    Err(why) -> reported(s, "resolve", [lock::refused(r, why)], []),
    Ok(existing) -> match remote::resolved(load_resolved(flags.paths), existing) {
      Err(d) -> reported(s, "resolve", [d], []),
      Ok(archives) -> pinned(s, flags, r, archives),
    },
  }
}

fn pinned(
  s: Style,
  flags: Flags,
  r: Resolved,
  archives: List<Archived>,
) -> Answer / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shelf], fs.read_file[shelf], fs.write_file[cwd], fs.write_file[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} = {
  let loaded: Program = load_program(flags.paths);
  match loaded.whole {
    None -> refused(s, "resolve", loaded.diags, loaded.places),
    Some(w) -> {
      let pins = from_front(w.pins);
      let at = path_of(r);
      let body = bytes_of_string(text(None, pins, archives));
      if !write_file(at, body) {
        reported(s, "resolve", [unwritable(displayed(at))], loaded.places)
      } else { answered(s, pins, archives, displayed(at), ok_code(), true, !flags.json) }
    },
  }
}

// --- Tests ------------------------------------------------------------------

fn a_pin(name: String, version: String, digest: String) -> Pinned =
  { name: name, version: version, digest: digest }

test "a resolve names what it pinned, one line per package" {
  let pins = [a_pin("lib", "0.1.0", "b3:1f2e3d4c5b6a"), a_pin("base", "0.0.1", "b3:99aa")];
  let answer = answered(
    plain(),
    pins,
    [{ name: "base", version: "0.0.1", archive: "b3:77", interface: false }],
    "app/ply.lock",
    ok_code(),
    true,
    true,
  );
  assert_eq(answer.code, 0);
  assert_eq(answer.lines, [
    "   resolved 2 packages · app/ply.lock",
    "     lib 0.1.0 · b3:1f2e3d4c5b6a",
    "     base 0.0.1 · b3:99aa · registry",
  ])
}

test "the json answer carries every pin, and `--json` prints no lines" {
  let pins = [a_pin("lib", "0.1.0", "b3:1f2e3d4c5b6a")];
  let text = to_string(
    json_of(
      pins,
      [{ name: "lib", version: "0.1.0", archive: "b3:77", interface: true }],
      "app/ply.lock",
      ok_code(),
      true,
    ),
  );
  assert(string_contains(text, "\"command\":\"resolve\""));
  assert(string_contains(text, "\"lockfile\":\"app/ply.lock\""));
  assert(string_contains(text, "\"written\":true"));
  assert(string_contains(text, "\"name\":\"lib\""));
  assert(string_contains(text, "\"digest\":\"b3:1f2e3d4c5b6a\""));
  assert(string_contains(text, "\"archive\":\"b3:77\""));
  assert(string_contains(text, "\"interface\":true"));
  assert_eq(lines(plain(), pins, "app/ply.lock"), ["   resolved 1 package · app/ply.lock"])
}

test "a project with no dependencies resolves to an empty lock" {
  let answer = answered(plain(), [], [], "ply.lock", ok_code(), true, false);
  assert_eq(answer.lines, ["   resolved 0 packages · ply.lock"])
}
