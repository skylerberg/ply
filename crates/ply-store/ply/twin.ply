// The store's tests run over an in-memory tree: `std.fs`'s twin as the label `mem`, a counting
// entropy and a fixed clock, so every run is the same.

import std.fs (fs, MemFs, mem_read, mem_read_at, mem_list, mem_kind, mem_resolved, mem_exists,
               mem_size, mem_modified, mem_write, mem_append, mem_create_dir, mem_remove,
               mem_rename, mem_sync, mem_lock, mem_unlock)
import std.random (entropy)
import std.time (time)

pub type Twin<a> = { value: a, tree: MemFs }

// Runs `go` over an in-memory tree as the label `mem`, with a counting entropy and a fixed clock.
pub fn on_twin<a>(
  tree: MemFs,
  go: () -> a / {fs.read[mem], fs.write[mem], entropy.next, time.now_ms},
) -> Twin<a> =
  with_cell[disk](tree) { t ->
    with_cell[draws](0) { n -> {
      let value = handle {
        go()
      } with {
        fs.read_file[mem](p) -> mem_read(cell_get(t), p),
        fs.read_at[mem](p, o, l) -> mem_read_at(cell_get(t), p, o, l),
        fs.list_dir[mem](p) -> mem_list(cell_get(t), p),
        fs.kind[mem](p) -> mem_kind(cell_get(t), p),
        fs.resolved[mem](p) -> mem_resolved(cell_get(t), p),
        fs.exists[mem](p) -> mem_exists(cell_get(t), p),
        fs.file_size[mem](p) -> mem_size(cell_get(t), p),
        fs.modified_ms[mem](p) -> mem_modified(cell_get(t), p),
        fs.write_file[mem](p, b) -> {
          let w = mem_write(cell_get(t), p, b);
          cell_set(t, w.fs);
          w.ok
        },
        fs.append[mem](p, b) -> {
          let w = mem_append(cell_get(t), p, b);
          cell_set(t, w.fs);
          w.at
        },
        fs.create_dir[mem](p) -> {
          let w = mem_create_dir(cell_get(t), p);
          cell_set(t, w.fs);
          w.ok
        },
        fs.remove[mem](p) -> {
          let w = mem_remove(cell_get(t), p);
          cell_set(t, w.fs);
          w.ok
        },
        fs.rename[mem](a, b) -> {
          let w = mem_rename(cell_get(t), a, b);
          cell_set(t, w.fs);
          w.ok
        },
        fs.sync[mem](p) -> mem_sync(cell_get(t), p),
        fs.lock[mem](p) -> {
          let w = mem_lock(cell_get(t), p);
          cell_set(t, w.fs);
          w.ok
        },
        fs.unlock[mem](p) -> {
          let w = mem_unlock(cell_get(t), p);
          cell_set(t, w.fs);
          w.ok
        },
        entropy.next() -> {
          cell_set(n, cell_get(n) + 1);
          cell_get(n)
        },
        time.now_ms() -> 1000,
      };
      { value: value, tree: cell_get(t) }
    } }
  }
