// What `ply` keeps between runs, as tables over the engine. Every record is a `derive bin` type, so
// the store's schema is the digest of their shapes and changing one starts the store afresh.

import std.bin
import std.fs (fs, mem_empty)
import std.random (entropy)
import std.time (time)
import std.bytes (hex_of)
import compiler.front (body_key)
import engine (Store, Found, Hit, Miss, Bad, Warning, Trouble, Corrupt, Unreadable, OtherVersion,
               open, get, put, drop, keys, flush, compact, stats, warn, messages, pending)
import twin (on_twin)
import upstream (Upstream, read_entry, entry_keys, publish, mark_live)
import std.hash (blake3)
import std.path (segments)

// --- Tables -----------------------------------------------------------------

fn t_sources() -> Int = 1
fn t_defs() -> Int = 2
fn t_decls() -> Int = 3
fn t_bodies() -> Int = 4
fn t_passed() -> Int = 5
fn t_pass_records() -> Int = 6
fn t_seen() -> Int = 7
fn t_evidence() -> Int = 8
fn t_reviews() -> Int = 9
fn t_shipped() -> Int = 10
fn t_stamps() -> Int = 11
fn t_loads() -> Int = 12
fn t_priors() -> Int = 13
fn t_code_passes() -> Int = 14

// --- Records ----------------------------------------------------------------

// A byte range in one source file, as a span degrades to outside the run that made it.
pub type FileSpan = { start: Int, end: Int }

pub type DefKind = | KFn | KType | KEffect

// A variant of a `type`, or an operation of an `effect`.
pub type Member = { name: String, span: FileSpan }

// `check` is the key the definition's interface is filed under: its hash with each reference to
// another package read as that definition's contract.
pub type DefEntry = {
  name: String,
  hash: Bytes,
  check: Bytes,
  span: FileSpan,
  kind: DefKind,
  members: List<Member>,
}

// `row` is what the front end filed for the test, which it reads back and the store does not.
pub type TestEntry = { name: String, hash: Bytes, nondet: Bool, span: FileSpan, row: Bytes }

// What one file declared when it was last checked, and the hash of the bytes it was checked as.
// `module` is the program-wide name it was checked under, which the file alone does not say.
pub type Fingerprint = {
  key: String,
  content: Bytes,
  module: String,
  defs: List<DefEntry>,
  tests: List<TestEntry>,
}

pub type Body = { encoding: Int, bytes: Bytes }

// The definitions a test last passed against: functions and declarations apart, since a `fn` and a
// `type` may share a name.
pub type PassRecord = { test_hash: Bytes, closure: Map<String, Bytes>, decls: Map<String, Bytes> }

type Named<a> = { name: String, value: a }

// What a human last accepted for a definition: its hash, and its own clauses' and laws' keys.
pub type Review = { def: Bytes, specs: List<Bytes> }

// The build the versioned groups were filed by: its front end's digest, its runtime's, and the one
// a pass filed under the code its test ran answers to, which no compiler change moves.
pub type Stamps = { frontend: String, runtime: String, code: String }

derive bin for FileSpan
derive bin for DefKind
derive bin for Member
derive bin for DefEntry
derive bin for TestEntry
derive bin for Fingerprint
derive bin for Body
derive bin for PassRecord
derive bin for Named
derive bin for Review
derive bin for Stamps

// Every stored record's shape, so a store written under another encoding of any of them is not read.
pub fn schema() -> Bytes / {abort.raise} =
  bytes_concat_all([
    bin::shape_digest(fingerprint_bin()),
    bin::shape_digest(body_bin()),
    bin::shape_digest(named_bin(pass_record_bin())),
    bin::shape_digest(named_bin(review_bin())),
    bin::shape_digest(stamps_bin()),
    bin::shape_digest(bin::bytes_bin()),
    bin::shape_digest(bin::string_bin()),
  ])

// --- Opening ----------------------------------------------------------------

pub type Package = { root: String, identity: String }

// One run's view of the store: the engine's, how this run's paths are keyed, and the upstream it
// shares passes and evidence with, whose passes it read when it attached; passes filed under code
// are shared under a schema of their own, which a compiler change leaves where it was.
pub type Cache = {
  store: Store,
  root: String,
  packages: List<Package>,
  stamps: Stamps,
  upstream: Option<Upstream>,
  shared: Map<Bytes, Bool>,
  code_upstream: Option<Upstream>,
  code_shared: Map<Bytes, Bool>,
}

pub fn open_cache<[r]>(
  dir: String,
  root: String,
  packages: List<Package>,
  stamps: Stamps,
) -> Cache / {fs.read[r], abort.raise} =
  {
    store: stamped[r](open[r](dir, schema()), stamps),
    root: root,
    packages: packages,
    stamps: stamps,
    upstream: None,
    shared: map_new(),
    code_upstream: None,
    code_shared: map_new(),
  }

fn stamps_key() -> Bytes = named_key("stamps")

// A versioned group of tables, and the stamp its entries were filed under.
type Group = { what: String, was: String, now: String, tables: List<Int> }

fn groups(was: Stamps, now: Stamps) -> List<Group> =
  [
    {
      what: "the front end's entries",
      was: was.frontend,
      now: now.frontend,
      tables: [t_sources(), t_defs(), t_decls(), t_loads(), t_priors()],
    },
    {
      what: "the test results and discharged obligations",
      was: was.runtime,
      now: now.runtime,
      tables: [t_passed(), t_pass_records(), t_seen(), t_evidence()],
    },
    {
      what: "the passes filed under the code their tests ran",
      was: was.code,
      now: now.code,
      tables: [t_code_passes()],
    },
  ]

fn emptied(s: Store, g: Group) -> Store / {abort.raise} =
  fold(g.tables, s, |s1: Store, t: Int| fold(keys(s1, t), s1, |s2: Store, k: Bytes| drop(s2, t, k)))

fn restamped(store: Store, now: Stamps) -> Store / {abort.raise} =
  put(store, t_stamps(), stamps_key(), bin::encode(now, stamps_bin()))

fn short_stamp(stamp: String) -> String / {abort.raise} =
  if string_len(stamp) > 12 { "b3:" ++ string_slice(stamp, 0, 12) } else { stamp }

type Stamped = | Known(Stamps) | Unstamped | Garbled

// Groups filed under other stamps are dropped, each warned once; unreadable stamps drop them all.
fn stamped<[r]>(s: Store, now: Stamps) -> Store / {fs.read[r], abort.raise} = {
  let was = match get[r](s, t_stamps(), stamps_key()) {
    Hit(bytes) -> match bin::decode(bytes, stamps_bin()) { Ok(st) -> Known(st), Err(_) -> Garbled },
    Miss -> Unstamped,
    Bad(_) -> Garbled,
  };
  let all = groups(now, now);
  let dropped = |why: Trouble, message: String|
    restamped(warn(fold(all, s, emptied), why, message), now);
  match was {
    Known(st) -> if st == now { s } else {
      restamped(
        fold(filter(groups(st, now), |g: Group| g.was != g.now), s, |s1: Store, g: Group|
          warn(
            emptied(s1, g),
            OtherVersion,
            g.what ++ " were filed by another build (" ++ short_stamp(g.was) ++ "; this one is "
              ++ short_stamp(g.now)
              ++ "), so they are filed again",
          )),
        now,
      )
    },
    Unstamped -> if fold(all, true, |none: Bool, g: Group|
        none && fold(g.tables, true, |n: Bool, t: Int| n && len(keys(s, t)) == 0)) { s } else {
      dropped(OtherVersion, "the store names no stamps for its entries; they are filed again")
    },
    Garbled -> dropped(Corrupt, "the store's stamps do not read back; its entries are filed again"),
  }
}

// Passes published there answer here; what this run learns is published back unless `publish` is
// off. The upstream is reached under a label of its own, since it is rarely under the project.
pub fn with_upstream<[u]>(
  cache: Cache,
  root: String,
  publish: Bool,
) -> Cache / {fs.read[u], abort.raise} = {
  let under = |stamp: String|
    { root: root, schema: blake3(schema() ++ bytes_of_string(stamp)), publish: publish };
  let up = under(cache.stamps.runtime);
  let code_up = under(cache.stamps.code);
  {
    ..cache,
    upstream: Some(up),
    shared: published_keys[u](up, t_passed()),
    code_upstream: Some(code_up),
    code_shared: published_keys[u](code_up, t_code_passes()),
  }
}

fn published_keys<[u]>(up: Upstream, table: Int) -> Map<Bytes, Bool> / {fs.read[u], abort.raise} =
  fold(entry_keys[u](up, table), map_new(), |m: Map<Bytes, Bool>, k: Bytes| map_insert(m, k, true))

type Put = { table: Int, key: Bytes, payload: Bytes }

fn published_failures(n: Int, root: String) -> String =
  (if n == 1 { "1 entry" } else { int_to_string(n) ++ " entries" })
    ++ " could not be published to the upstream store `"
    ++ root
    ++ "`; this run is unaffected"

fn puts_in(store: Store, tables: List<Int>) -> List<Put> / {abort.raise} =
  map_fold(store.puts, [], |acc: List<Put>, sl: Bytes, payload: Bytes|
    if fold(tables, false, |hit: Bool, t: Int| hit || t == bytes_at(sl, 0)) {
      push(acc, {
        table: bytes_at(sl, 0),
        key: bytes_slice(sl, 1, bytes_len(sl)),
        payload: payload,
      })
    } else { acc })

pub fn flush_cache<[r]>(
  cache: Cache,
) -> Cache / {fs.read[r], fs.write[r], entropy.next, time.now_ms, abort.raise} =
  {
    ..cache,
    store: flush[r](if pending(cache.store) == 0 { cache.store }
    else { current[r](cache.store, cache.stamps) }),
  }

// Whatever a flush writes goes under this build's stamps.
fn current<[r]>(store: Store, now: Stamps) -> Store / {fs.read[r], abort.raise} =
  match get[r](store, t_stamps(), stamps_key()) {
    Hit(b) -> if b == bin::encode(now, stamps_bin()) { store } else { restamped(store, now) },
    _ -> restamped(store, now),
  }

type Published = { failed: Int, known: Map<Bytes, Bool> }

// Each of `puts` the upstream does not hold, published there; `known` is what it holds of `passes`.
fn published_to<[u]>(
  up: Upstream,
  puts: List<Put>,
  known: Map<Bytes, Bool>,
  passes: Int,
) -> Published / {fs.read[u], fs.write[u], entropy.next, time.now_ms, abort.raise} = {
  let fresh = filter(puts, |p: Put| p.table != passes || !map_contains(known, p.key));
  {
    failed: fold(fresh, 0, |n: Int, p: Put|
      if publish[u](up, p.table, p.key, p.payload) { n } else { n + 1 }),
    known: fold(fresh, known, |m: Map<Bytes, Bool>, p: Put|
      if p.table == passes { map_insert(m, p.key, true) } else { m }),
  }
}

// The local write comes first, so an upstream that cannot be reached never costs a run its own record.
pub fn flush_shared<[r], [u]>(
  cache: Cache,
) -> Cache / {fs.read[r], fs.write[r], fs.read[u], fs.write[u], entropy.next, time.now_ms, abort.raise} = {
  let shared = puts_in(cache.store, [t_passed(), t_evidence()]);
  let coded = puts_in(cache.store, [t_code_passes()]);
  let flushed = flush_cache[r](cache);
  match ((cache.upstream, cache.code_upstream)) {
    (Some(up), Some(code_up)) -> if !up.publish { flushed } else {
      let a = published_to[u](up, shared, flushed.shared, t_passed());
      let b = published_to[u](code_up, coded, flushed.code_shared, t_code_passes());
      // A merge keeps the schemas runs published under, so one this run read from stays too.
      let _live = mark_live[u](up);
      let _code_live = mark_live[u](code_up);
      let out = { ..flushed, shared: a.known, code_shared: b.known };
      let failed = a.failed + b.failed;
      if failed == 0 { out }
      else { { ..out, store: warn(out.store, Unreadable, published_failures(failed, up.root)) } }
    },
    _ -> flushed,
  }
}

pub fn warnings(cache: Cache) -> List<Warning> = cache.store.warnings

fn noted(cache: Cache, why: String) -> Cache = { ..cache, store: warn(cache.store, Corrupt, why) }

fn named_key(name: String) -> Bytes = blake3(bytes_of_string(name))

// A record read back: what it holds, or a warning that it did not decode and is treated as absent.
pub type Read<a> = { value: Option<a>, cache: Cache }

fn read<a, [r]>(
  cache: Cache,
  table: Int,
  key: Bytes,
  codec: bin::BinCodec<a>,
  what: String,
) -> Read<a> / {fs.read[r], abort.raise} =
  match get[r](cache.store, table, key) {
    Miss -> { value: None, cache: cache },
    Bad(why) -> { value: None, cache: noted(cache, damaged(what, why)) },
    Hit(bytes) -> match bin::decode(bytes, codec) {
      Ok(v) -> { value: Some(v), cache: cache },
      Err(e) -> { value: None, cache: noted(cache, damaged(what, bin::error_to_string(e))) },
    },
  }

fn damaged(what: String, why: String) -> String =
  "a stored " ++ what ++ " is damaged (" ++ why ++ "); it is treated as absent"

fn write<a>(
  cache: Cache,
  table: Int,
  key: Bytes,
  codec: bin::BinCodec<a>,
  value: a,
) -> Cache / {abort.raise} =
  { ..cache, store: put(cache.store, table, key, bin::encode(value, codec)) }

// A write of what is already there is no write, so a run that changed nothing flushes nothing.
fn renew<a, [r]>(
  cache: Cache,
  table: Int,
  key: Bytes,
  codec: bin::BinCodec<a>,
  value: a,
) -> Cache / {fs.read[r], abort.raise} =
  match get[r](cache.store, table, key) {
    Hit(old) -> if old == bin::encode(value, codec) { cache }
    else { write(cache, table, key, codec, value) },
    _ -> write(cache, table, key, codec, value),
  }

// --- Keying -----------------------------------------------------------------

fn joined(parts: List<String>) -> String =
  fold(range(0, len(parts)), "", |acc: String, i: Int|
    match list_at(parts, i) { Some(p) -> if i == 0 { p } else { acc ++ "/" ++ p }, None -> acc })

// The segments of `path` past `root`, when `root` is a prefix of it.
fn inside(root: String, path: String) -> Option<List<String>> / {abort.raise} = {
  let r = segments(root);
  let p = segments(path);
  if len(r) > len(p)
      || !fold(range(0, len(r)), true, |ok: Bool, i: Int| ok && list_at(r, i) == list_at(p, i)) {
    None
  } else {
    Some(map(range(len(r), len(p)), |i: Int| match list_at(p, i) { Some(x) -> x, None -> "" }))
  }
}

// `/`-separated with `.` dropped; `None` for a path that climbs out or names the root itself.
fn key_of(parts: List<String>) -> Option<String> =
  if len(parts) == 0 || fold(parts, false, |up: Bool, x: String| up || x == "..") { None }
  else { Some(joined(parts)) }

// A dependency's file is keyed by the package's identity, so its entry holds wherever the package
// is checked out; the project's own by its path inside the root, or as written when it is relative.
pub fn source_key(cache: Cache, path: String) -> Option<String> / {abort.raise} =
  match fold(cache.packages, None, |acc: Option<Option<String>>, p: Package|
      match acc {
        Some(_) -> acc,
        None -> match inside(p.root, path) {
          Some(parts) ->
            Some(match key_of(parts) { Some(k) -> Some(p.identity ++ "/" ++ k), None -> None }),
          None -> None,
        },
      }) {
    Some(k) -> k,
    None -> match inside(cache.root, path) {
      Some(parts) -> key_of(parts),
      None -> if string_starts_with(path, "/") { None } else { key_of(segments(path)) },
    },
  }

// --- The front end ----------------------------------------------------------

pub fn fingerprint<[r]>(
  cache: Cache,
  key: String,
) -> Read<Fingerprint> / {fs.read[r], abort.raise} = {
  let got = read[r](cache, t_sources(), named_key(key), fingerprint_bin(), "fingerprint");
  match got.value {
    Some(f) -> if f.key == key { got } else { { value: None, cache: got.cache } },
    None -> got,
  }
}

pub fn put_fingerprint<[r]>(cache: Cache, f: Fingerprint) -> Cache / {fs.read[r], abort.raise} =
  renew[r](cache, t_sources(), named_key(f.key), fingerprint_bin(), f)

pub fn forget_source(cache: Cache, key: String) -> Cache / {abort.raise} =
  { ..cache, store: drop(cache.store, t_sources(), named_key(key)) }

// Every source key the store holds, ascending, read from the fingerprints themselves.
pub fn source_keys<[r]>(cache: Cache) -> Read<List<String>> / {fs.read[r], abort.raise} = {
  let walked = fold(
    keys(cache.store, t_sources()),
    { found: map_new(), cache: cache },
    |acc: { found: Map<String, Bool>, cache: Cache }, k: Bytes| {
      let got = read[r](acc.cache, t_sources(), k, fingerprint_bin(), "fingerprint");
      match got.value {
        Some(f) -> { found: map_insert(acc.found, f.key, true), cache: got.cache },
        None -> { found: acc.found, cache: got.cache },
      }
    },
  );
  { value: Some(map_keys(walked.found)), cache: walked.cache }
}

// What the front end filed for one name under one hash, keyed by both: two definitions may share a
// hash, and each keeps its own interface.
fn pair_key(hash: Bytes, name: String) -> Bytes = blake3(hash ++ bytes_of_string(name))

fn interface_of<[r]>(
  cache: Cache,
  table: Int,
  hash: Bytes,
  name: String,
) -> Read<Bytes> / {fs.read[r], abort.raise} =
  match get[r](cache.store, table, pair_key(hash, name)) {
    Miss -> { value: None, cache: cache },
    Bad(why) -> { value: None, cache: noted(cache, damaged("interface", why)) },
    Hit(bytes) -> { value: Some(bytes), cache: cache },
  }

fn put_interface<[r]>(
  cache: Cache,
  table: Int,
  hash: Bytes,
  name: String,
  value: Bytes,
) -> Cache / {fs.read[r], abort.raise} = {
  let k = pair_key(hash, name);
  match get[r](cache.store, table, k) {
    Hit(old) -> if old == value { cache }
    else { { ..cache, store: put(cache.store, table, k, value) } },
    _ -> { ..cache, store: put(cache.store, table, k, value) },
  }
}

pub fn def_of<[r]>(
  cache: Cache,
  hash: Bytes,
  name: String,
) -> Read<Bytes> / {fs.read[r], abort.raise} = interface_of[r](cache, t_defs(), hash, name)

pub fn decl_of<[r]>(
  cache: Cache,
  hash: Bytes,
  name: String,
) -> Read<Bytes> / {fs.read[r], abort.raise} = interface_of[r](cache, t_decls(), hash, name)

pub fn put_def<[r]>(
  cache: Cache,
  hash: Bytes,
  name: String,
  value: Bytes,
) -> Cache / {fs.read[r], abort.raise} = put_interface[r](cache, t_defs(), hash, name, value)

pub fn put_decl<[r]>(
  cache: Cache,
  hash: Bytes,
  name: String,
  value: Bytes,
) -> Cache / {fs.read[r], abort.raise} = put_interface[r](cache, t_decls(), hash, name, value)

pub fn body<[r]>(cache: Cache, hash: Bytes) -> Read<Body> / {fs.read[r], abort.raise} = {
  let got = read[r](cache, t_bodies(), hash, body_bin(), "body");
  match got.value {
    Some(b) -> if body_key(b.bytes) == Some(hash) { got } else {
      { value: None, cache: noted(got.cache, damaged("body", "its envelope names another hash")) }
    },
    None -> got,
  }
}

// A body whose envelope does not name `hash` is not filed: it could never be read back.
// A body is keyed by a digest of itself, so a different body already there means its encoding
// depends on something the hash does not cover: the one stored is kept and the run warned.
pub fn put_body<[r]>(cache: Cache, hash: Bytes, b: Body) -> Cache / {fs.read[r], abort.raise} =
  if body_key(b.bytes) != Some(hash) { cache } else {
    match get[r](cache.store, t_bodies(), hash) {
      Hit(old) -> if old == bin::encode(b, body_bin()) { cache } else {
        noted(
          cache,
          "two different bodies were stored for definition `" ++ string_slice(hex_of(hash), 0, 12)
            ++ "`; the one already stored is kept",
        )
      },
      _ -> write(cache, t_bodies(), hash, body_bin(), b),
    }
  }

// --- Test results -----------------------------------------------------------

fn passed_in<[r]>(
  cache: Cache,
  table: Int,
  shared: Map<Bytes, Bool>,
  key: Bytes,
) -> Read<Bool> / {fs.read[r], abort.raise} =
  match get[r](cache.store, table, key) {
    Hit(_) -> { value: Some(true), cache: cache },
    Miss -> { value: Some(map_contains(shared, key)), cache: cache },
    Bad(why) ->
      { value: Some(map_contains(shared, key)), cache: noted(cache, damaged("result", why)) },
  }

fn keys_in(cache: Cache, table: Int, shared: Map<Bytes, Bool>) -> List<Bytes> / {abort.raise} =
  map_keys(
    fold(keys(cache.store, table), shared, |m: Map<Bytes, Bool>, k: Bytes| map_insert(m, k, true)),
  )

pub fn passed<[r]>(cache: Cache, key: Bytes) -> Read<Bool> / {fs.read[r], abort.raise} =
  passed_in[r](cache, t_passed(), cache.shared, key)

pub fn put_passed(cache: Cache, key: Bytes) -> Cache / {abort.raise} =
  { ..cache, store: put(cache.store, t_passed(), key, b"") }

// Every key a pass is filed under here or in the upstream, read from the index alone.
pub fn passed_keys(cache: Cache) -> List<Bytes> / {abort.raise} =
  keys_in(cache, t_passed(), cache.shared)

// A pass filed under the code its test ran, here or in the upstream.
pub fn passed_code<[r]>(cache: Cache, key: Bytes) -> Read<Bool> / {fs.read[r], abort.raise} =
  passed_in[r](cache, t_code_passes(), cache.code_shared, key)

pub fn put_passed_code(cache: Cache, key: Bytes) -> Cache / {abort.raise} =
  { ..cache, store: put(cache.store, t_code_passes(), key, b"") }

pub fn passed_code_keys(cache: Cache) -> List<Bytes> / {abort.raise} =
  keys_in(cache, t_code_passes(), cache.code_shared)

// Every definition hash this store has seen pass, read from the index alone.
pub fn seen_keys(cache: Cache) -> List<Bytes> / {abort.raise} = keys(cache.store, t_seen())

pub fn pass_record<[r]>(
  cache: Cache,
  label: String,
) -> Read<PassRecord> / {fs.read[r], abort.raise} = {
  let got = read[r](
    cache,
    t_pass_records(),
    named_key(label),
    named_bin(pass_record_bin()),
    "pass record",
  );
  match got.value {
    Some(n) -> { value: if n.name == label { Some(n.value) } else { None }, cache: got.cache },
    None -> { value: None, cache: got.cache },
  }
}

pub fn put_pass_record<[r]>(
  cache: Cache,
  label: String,
  record: PassRecord,
) -> Cache / {fs.read[r], abort.raise} =
  renew[r](cache, t_pass_records(), named_key(label), named_bin(pass_record_bin()), {
    name: label,
    value: record,
  })

pub fn knows_definition<[r]>(cache: Cache, hash: Bytes) -> Bool / {fs.read[r], abort.raise} =
  match get[r](cache.store, t_seen(), hash) { Hit(_) -> true, _ -> false }

pub fn observe_definition(cache: Cache, hash: Bytes) -> Cache / {abort.raise} =
  { ..cache, store: put(cache.store, t_seen(), hash, b"") }

// --- The prover -------------------------------------------------------------

pub fn evidence<[r]>(cache: Cache, key: Bytes) -> Read<Bytes> / {fs.read[r], abort.raise} =
  read[r](cache, t_evidence(), key, bin::bytes_bin(), "evidence")

// The local entry, or else the upstream's.
pub fn evidence_shared<[r], [u]>(
  cache: Cache,
  key: Bytes,
) -> Read<Bytes> / {fs.read[r], fs.read[u], abort.raise} = {
  let local = evidence[r](cache, key);
  match local.value {
    Some(_) -> local,
    None -> match cache.upstream {
      None -> local,
      Some(up) -> match read_entry[u](up, t_evidence(), key) {
        Hit(payload) -> match bin::decode(payload, bin::bytes_bin()) {
          Ok(v) -> { value: Some(v), cache: local.cache },
          Err(e) ->
            {
              value: None,
              cache: noted(local.cache, damaged("upstream evidence", bin::error_to_string(e))),
            },
        },
        Miss -> local,
        Bad(why) -> { value: None, cache: noted(local.cache, damaged("upstream evidence", why)) },
      },
    },
  }
}

pub fn put_evidence(cache: Cache, key: Bytes, encoded: Bytes) -> Cache / {abort.raise} =
  write(cache, t_evidence(), key, bin::bytes_bin(), encoded)

pub fn review<[r]>(cache: Cache, def: String) -> Read<Review> / {fs.read[r], abort.raise} = {
  let got = read[r](cache, t_reviews(), named_key(def), named_bin(review_bin()), "review");
  match got.value {
    Some(n) -> { value: if n.name == def { Some(n.value) } else { None }, cache: got.cache },
    None -> { value: None, cache: got.cache },
  }
}

pub fn put_review(cache: Cache, def: String, r: Review) -> Cache / {abort.raise} =
  write(cache, t_reviews(), named_key(def), named_bin(review_bin()), { name: def, value: r })

// --- The shipped modules ----------------------------------------------------

fn shipped_key() -> Bytes = named_key("shipped")

pub fn shipped_digest<[r]>(cache: Cache) -> Read<String> / {fs.read[r], abort.raise} =
  read[r](cache, t_shipped(), shipped_key(), bin::string_bin(), "shipped modules' digest")

pub fn put_shipped_digest(cache: Cache, d: String) -> Cache / {abort.raise} =
  write(cache, t_shipped(), shipped_key(), bin::string_bin(), d)

// --- The last filing ------------------------------------------------------------

fn load_key() -> Bytes = named_key("load")

// The digest of everything the last filing's load read: a load that reads the same has nothing new
// to file.
pub fn filed_load<[r]>(cache: Cache) -> Read<Bytes> / {fs.read[r], abort.raise} =
  read[r](cache, t_loads(), load_key(), bin::bytes_bin(), "last filing's load")

pub fn put_filed_load<[r]>(cache: Cache, digest: Bytes) -> Cache / {fs.read[r], abort.raise} =
  renew[r](cache, t_loads(), load_key(), bin::bytes_bin(), digest)

fn priors_key() -> Bytes = named_key("priors")

// What the last filing's hashing answered for each node it hashed, as the front end encodes it,
// with the bodies left to the bodies table: a later load hashes a node again only where it moved.
pub fn filed_priors<[r]>(cache: Cache) -> Read<Bytes> / {fs.read[r], abort.raise} =
  read[r](cache, t_priors(), priors_key(), bin::bytes_bin(), "last filing's hashing")

pub fn put_filed_priors<[r]>(cache: Cache, encoded: Bytes) -> Cache / {fs.read[r], abort.raise} =
  renew[r](cache, t_priors(), priors_key(), bin::bytes_bin(), encoded)

// --- Upkeep -----------------------------------------------------------------

pub type Counts = {
  sources: Int,
  defs: Int,
  decls: Int,
  bodies: Int,
  passed: Int,
  pass_records: Int,
  seen: Int,
  evidence: Int,
  reviews: Int,
}

pub fn counts(cache: Cache) -> Counts / {abort.raise} =
  {
    sources: len(keys(cache.store, t_sources())),
    defs: len(keys(cache.store, t_defs())),
    decls: len(keys(cache.store, t_decls())),
    bodies: len(keys(cache.store, t_bodies())),
    passed: len(keys(cache.store, t_passed())),
    pass_records: len(keys(cache.store, t_pass_records())),
    seen: len(keys(cache.store, t_seen())),
    evidence: len(keys(cache.store, t_evidence())),
    reviews: len(keys(cache.store, t_reviews())),
  }

pub type Pruned = { sources: Int, defs: Int, decls: Int, bodies: Int }

// What the walk has found alive: bodies by hash, interfaces by their name and hash.
type Live = { hashes: Map<Bytes, Bool>, pairs: Map<Bytes, Bool> }

type Walk = { live: Live, cache: Cache, dropped: Int }

fn alive(live: Live, name: String, hash: Bytes) -> Live =
  {
    hashes: map_insert(live.hashes, hash, true),
    pairs: map_insert(live.pairs, pair_key(hash, name), true),
  }

fn reached(live: Live, names: Map<String, Bytes>) -> Live =
  map_fold(names, live, |l: Live, name: String, hash: Bytes| alive(l, name, hash))

// Drops the fingerprints of files outside `keep` and every interface and body that neither a
// surviving fingerprint nor a pass record reaches. Call only once every file of the program is known.
pub fn prune<[r]>(
  cache: Cache,
  keep: List<String>,
) -> { pruned: Pruned, cache: Cache } / {fs.read[r], abort.raise} = {
  let kept = fold(keep, map_new(), |m: Map<String, Bool>, k: String| map_insert(m, k, true));
  let kept_keys = map_fold(kept, map_new(), |m: Map<Bytes, Bool>, k: String, v: Bool|
    map_insert(m, named_key(k), true));
  let stray = fold(keys(cache.store, t_sources()), false, |any: Bool, k: Bytes|
    any || !map_contains(kept_keys, k));
  let refiled = map_fold(cache.store.puts, false, |any: Bool, sl: Bytes, p: Bytes|
    any || bytes_at(sl, 0) == t_sources());
  // Nothing can have become unreachable when every file was kept and none was filed again.
  if !stray && !refiled { { pruned: { sources: 0, defs: 0, decls: 0, bodies: 0 }, cache: cache } }
  else {
    let walked = fold(
      keys(cache.store, t_sources()),
      { live: { hashes: map_new(), pairs: map_new() }, cache: cache, dropped: 0 },
      |acc: Walk, k: Bytes| {
        let got = read[r](acc.cache, t_sources(), k, fingerprint_bin(), "fingerprint");
        match got.value {
          Some(f) -> if map_contains(kept, f.key) {
            {
              live: fold(f.defs, acc.live, |l: Live, d: DefEntry|
                alive(alive(l, d.name, d.hash), d.name, d.check)),
              cache: got.cache,
              dropped: acc.dropped,
            }
          } else {
            {
              live: acc.live,
              cache: { ..got.cache, store: drop(got.cache.store, t_sources(), k) },
              dropped: acc.dropped + 1,
            }
          },
          None ->
            {
              live: acc.live,
              cache: { ..got.cache, store: drop(got.cache.store, t_sources(), k) },
              dropped: acc.dropped + 1,
            },
        }
      },
    );
    let roots = fold(keys(walked.cache.store, t_pass_records()), walked, |acc: Walk, k: Bytes| {
      let got = read[r](
        acc.cache,
        t_pass_records(),
        k,
        named_bin(pass_record_bin()),
        "pass record",
      );
      match got.value {
        Some(n) ->
          {
            live: reached(reached(acc.live, n.value.closure), n.value.decls),
            cache: got.cache,
            dropped: acc.dropped,
          },
        None -> { ..acc, cache: got.cache },
      }
    });
    let swept = fold(
      [t_defs(), t_decls(), t_bodies()],
      { cache: roots.cache, gone: [] },
      |acc: { cache: Cache, gone: List<Int> }, t: Int| {
        let live = if t == t_bodies() { roots.live.hashes } else { roots.live.pairs };
        let dead = filter(keys(acc.cache.store, t), |k: Bytes| !map_contains(live, k));
        {
          cache: {
            ..acc.cache,
            store: fold(dead, acc.cache.store, |store: Store, k: Bytes| drop(store, t, k)),
          },
          gone: push(acc.gone, len(dead)),
        }
      },
    );
    let gone = |i: Int| match list_at(swept.gone, i) { Some(n) -> n, None -> 0 };
    {
      pruned: { sources: walked.dropped, defs: gone(0), decls: gone(1), bodies: gone(2) },
      cache: swept.cache,
    }
  }
}

pub type Match =
  | MatchDef({ key: String, entry: DefEntry })
  | MatchTest({ key: String, entry: TestEntry })

fn simple_name(name: String) -> String / {abort.raise} = {
  let parts = string_split(name, ".");
  match list_at(parts, len(parts) - 1) { Some(x) -> x, None -> name }
}

// Four to sixty-four hex digits, in either case.
fn hex_prefix(q: String) -> Option<String> / {abort.raise} = {
  let lower = string_lower(q);
  if string_len(lower) < 4 || string_len(lower) > 64 { None }
  else if fold(range(0, string_len(lower)), true, |ok: Bool, i: Int|
      ok && string_contains("0123456789abcdef", string_slice(lower, i, i + 1))) { Some(lower) }
  else { None }
}

fn hash_matches(hash: Bytes, prefix: Option<String>) -> Bool / {abort.raise} =
  match prefix { Some(p) -> string_starts_with(hex_of(hash), p), None -> false }

// A program-wide name, a name as its module wrote it, or a prefix of a hash's hex.
pub fn lookup<[r]>(cache: Cache, query: String) -> Read<List<Match>> / {fs.read[r], abort.raise} = {
  let prefix = hex_prefix(query);
  fold(
    keys(cache.store, t_sources()),
    { value: Some([]), cache: cache },
    |acc: Read<List<Match>>, k: Bytes| {
      let got = read[r](acc.cache, t_sources(), k, fingerprint_bin(), "fingerprint");
      let held = match acc.value { Some(xs) -> xs, None -> [] };
      match got.value {
        None -> { value: Some(held), cache: got.cache },
        Some(f) -> {
          let defs = fold(f.defs, held, |xs: List<Match>, d: DefEntry|
            if d.name == query || simple_name(d.name) == query || hash_matches(d.hash, prefix) {
              push(xs, MatchDef({ key: f.key, entry: d }))
            } else { xs });
          let tests = fold(f.tests, defs, |xs: List<Match>, t: TestEntry|
            if t.name == query || hash_matches(t.hash, prefix) {
              push(xs, MatchTest({ key: f.key, entry: t }))
            } else { xs });
          { value: Some(tests), cache: got.cache }
        },
      }
    },
  )
}

pub type Usage = { counts: Counts, data_bytes: Int, live_bytes: Int }

pub fn usage(cache: Cache) -> Usage / {abort.raise} = {
  let s = stats(cache.store);
  { counts: counts(cache), data_bytes: s.data_bytes, live_bytes: s.live_bytes }
}

pub fn compact_cache<[r]>(
  cache: Cache,
) -> Cache / {fs.read[r], fs.write[r], entropy.next, time.now_ms, abort.raise} =
  { ..cache, store: compact[r](cache.store) }

// --- Tests ------------------------------------------------------------------

fn h(name: String) -> Bytes = bytes_blake3(bytes_of_string(name))

fn built() -> Stamps = { frontend: "frontend", runtime: "runtime", code: "code" }

fn span() -> FileSpan = { start: 0, end: 4 }

fn entry(name: String) -> DefEntry =
  { name: name, hash: h(name), check: h(name), span: span(), kind: KFn, members: [] }

fn print(key: String, defs: List<String>) -> Fingerprint =
  {
    key: key,
    content: h(key),
    module: "m",
    defs: map(defs, entry),
    tests: [{ name: "t", hash: h(key ++ ".t"), nondet: false, span: span(), row: b"row" }],
  }

fn solo(payload: Bytes) -> Body / {abort.raise} = { encoding: 7, bytes: byte_of_int(0) ++ payload }

fn key_of_body(b: Body) -> Bytes / {abort.raise} =
  match body_key(b.bytes) { Some(k) -> k, None -> b"" }

fn record(names: List<String>) -> PassRecord =
  {
    test_hash: h("t"),
    closure: fold(names, map_new(), |m: Map<String, Bytes>, n: String| map_insert(m, n, h(n))),
    decls: map_new(),
  }

test "every table round-trips through a flush and a reopen" {
  let b = solo(b"body bytes");
  let run = on_twin(mem_empty(), || {
    let c0 = open_cache[mem]("cache", "", [], built());
    let c1 = put_fingerprint(c0, print("a.ply", ["m.f"]));
    let c2 = put_def[mem](put_def[mem](c1, h("same"), "m.f", b"F"), h("same"), "m.g", b"G");
    let c3 = put_body(put_decl[mem](c2, h("ty"), "m.T", b"T"), key_of_body(b), b);
    let c4 = put_pass_record(
      observe_definition(put_passed(c3, h("result")), h("m.f")),
      "m.t",
      record(["m.f"]),
    );
    let c5 = put_shipped_digest(
      put_review(put_evidence(c4, h("claim"), b"evidence"), "m.f", {
        def: h("m.f"),
        specs: [h("s")],
      }),
      "b3:000000000000",
    );
    let c = flush_cache[mem](c5);
    let r = open_cache[mem]("cache", "", [], built());
    assert_eq(fingerprint[mem](r, "a.ply").value, Some(print("a.ply", ["m.f"])));
    assert_eq(def_of[mem](r, h("same"), "m.f").value, Some(b"F"));
    assert_eq(def_of[mem](r, h("same"), "m.g").value, Some(b"G"));
    assert_eq(def_of[mem](r, h("same"), "m.h").value, None);
    assert_eq(decl_of[mem](r, h("ty"), "m.T").value, Some(b"T"));
    assert_eq(body[mem](r, key_of_body(b)).value, Some(b));
    assert_eq(passed[mem](r, h("result")).value, Some(true));
    assert_eq(passed[mem](r, h("other")).value, Some(false));
    assert(knows_definition[mem](r, h("m.f")));
    assert_eq(pass_record[mem](r, "m.t").value, Some(record(["m.f"])));
    assert_eq(evidence[mem](r, h("claim")).value, Some(b"evidence"));
    assert_eq(review[mem](r, "m.f").value, Some({ def: h("m.f"), specs: [h("s")] }));
    assert_eq(shipped_digest[mem](r).value, Some("b3:000000000000"));
    assert_eq(source_keys[mem](r).value, Some(["a.ply"]));
    assert_eq(counts(r).defs, 2);
    warnings(c)
  });
  assert_eq(run.value, [])
}

test "a body is filed only under the hash its envelope names" {
  let b = solo(b"x");
  let member = {
    encoding: 7,
    bytes: bytes_concat_all([byte_of_int(1), b"\x02\x00\x00\x00", b"group"]),
  };
  assert_eq(body_key(member.bytes), Some(blake3(blake3(b"group") ++ b"\x02\x00\x00\x00")));
  assert_eq(body_key(b"\x07"), None);
  let run = on_twin(mem_empty(), || {
    let c = put_body(
      put_body(open_cache[mem]("cache", "", [], built()), h("wrong"), b),
      key_of_body(member),
      member,
    );
    let r = open_cache[mem]("cache", "", [], built());
    let flushed = flush_cache[mem](c);
    let again = open_cache[mem]("cache", "", [], built());
    [
      body[mem](again, h("wrong")).value == None,
      body[mem](again, key_of_body(member)).value == Some(member),
    ]
  });
  assert_eq(run.value, [true, true])
}

test "prune keeps what the kept files and the pass records reach, and drops the rest" {
  let run = on_twin(mem_empty(), || {
    let c0 = open_cache[mem]("cache", "", [], built());
    let c1 = put_fingerprint(
      put_fingerprint(c0, print("a.ply", ["m.a"])),
      print("gone.ply", ["m.gone"]),
    );
    let c2 = put_pass_record(c1, "m.t", record(["m.passed"]));
    let c3 = fold(["m.a", "m.gone", "m.passed", "m.orphan"], c2, |cache: Cache, n: String|
      put_def[mem](cache, h(n), n, b"v"));
    let c4 = put_body(c3, key_of_body(solo(b"orphan")), solo(b"orphan"));
    let p = prune[mem](flush_cache[mem](c4), ["a.ply"]);
    let after = open_cache[mem]("cache", "", [], built());
    let kept = flush_cache[mem](p.cache);
    let r = open_cache[mem]("cache", "", [], built());
    {
      pruned: p.pruned,
      sources: source_keys[mem](r).value,
      defs: map(["m.a", "m.gone", "m.passed", "m.orphan"], |n: String|
        def_of[mem](r, h(n), n).value != None),
    }
  });
  assert_eq(run.value.pruned, { sources: 1, defs: 2, decls: 0, bodies: 1 });
  assert_eq(run.value.sources, Some(["a.ply"]));
  assert_eq(run.value.defs, [true, false, true, false])
}

test "lookup finds a definition by its name, its simple name and a prefix of its hash" {
  let run = on_twin(mem_empty(), || {
    let c = flush_cache[mem](
      put_fingerprint(open_cache[mem]("cache", "", [], built()), print("a.ply", ["m.f", "m.g"])),
    );
    let names = |q: String|
      match lookup[mem](c, q).value {
        Some(ms) ->
          map(ms, |m: Match|
            match m { MatchDef(d) -> d.entry.name, MatchTest(t) -> "test " ++ t.entry.name }),
        None -> [],
      };
    [
      names("m.f"),
      names("g"),
      names(string_slice(hex_of(h("m.g")), 0, 6)),
      names("t"),
      names("nothing"),
    ]
  });
  assert_eq(run.value, [["m.f"], ["m.g"], ["m.g"], ["test t"], []])
}

test "a project's file is keyed by its path inside the root, a dependency's by its identity" {
  let c = {
    store: open_free(),
    root: "proj",
    packages: [{ root: "proj/vendor/lib", identity: "b3:lib" }],
    stamps: built(),
    upstream: None,
    shared: map_new(),
    code_upstream: None,
    code_shared: map_new(),
  };
  assert_eq(source_key(c, "proj/src/./a.ply"), Some("src/a.ply"));
  assert_eq(source_key(c, "proj/vendor/lib/x.ply"), Some("b3:lib/x.ply"));
  assert_eq(source_key(c, "other/b.ply"), Some("other/b.ply"));
  assert_eq(source_key(c, "/elsewhere/b.ply"), None);
  assert_eq(source_key(c, "proj/../b.ply"), None);
  assert_eq(source_key(c, "proj"), None)
}

fn open_free() -> Store / {abort.raise} =
  on_twin(mem_empty(), || {
    let s = open[mem]("cache", schema());
    flush[mem](s)
  }).value

test "the schema is a function of the stored shapes alone" {
  assert_eq(schema(), schema());
  assert_eq(bytes_len(schema()), 7 * 32)
}

test "two runs filing different entries both keep theirs" {
  let run = on_twin(mem_empty(), || {
    let a = put_fingerprint(open_cache[mem]("cache", "", [], built()), print("a.ply", ["m.a"]));
    let b = put_fingerprint(open_cache[mem]("cache", "", [], built()), print("b.ply", ["m.b"]));
    let a1 = flush_cache[mem](a);
    let b1 = flush_cache[mem](b);
    source_keys[mem](open_cache[mem]("cache", "", [], built())).value
  });
  assert_eq(run.value, Some(["a.ply", "b.ply"]))
}

test "filing what is already filed writes nothing, and a second body for one hash is refused" {
  let b = solo(b"body");
  let run = on_twin(mem_empty(), || {
    let c0 = put_body(
      put_def(
        put_fingerprint(open_cache[mem]("cache", "", [], built()), print("a.ply", ["m.f"])),
        h("m.f"),
        "m.f",
        b"F",
      ),
      key_of_body(b),
      b,
    );
    let c1 = flush_cache[mem](c0);
    let again = put_body(
      put_def(
        put_fingerprint(open_cache[mem]("cache", "", [], built()), print("a.ply", ["m.f"])),
        h("m.f"),
        "m.f",
        b"F",
      ),
      key_of_body(b),
      b,
    );
    let pruned = prune(again, ["a.ply"]);
    let other = put_body(pruned.cache, key_of_body(b), { encoding: 8, bytes: b.bytes });
    { pending: pending(other.store), warned: len(warnings(other)) }
  });
  assert_eq(run.value, { pending: 0, warned: 1 })
}

test "an upstream's passes and evidence answer here, and what this run learns is published there" {
  let run = on_twin(mem_empty(), || {
    let a = with_upstream[mem](open_cache[mem]("one/cache", "one", [], built()), "shared", true);
    let a1 = flush_shared[mem, mem](
      put_evidence(put_passed(a, h("pass")), h("claim"), b"evidence"),
    );
    let b = with_upstream[mem](open_cache[mem]("two/cache", "two", [], built()), "shared", true);
    let lonely = open_cache[mem]("three/cache", "three", [], built());
    [
      passed[mem](b, h("pass")).value == Some(true),
      evidence_shared[mem, mem](b, h("claim")).value == Some(b"evidence"),
      passed[mem](lonely, h("pass")).value == Some(false),
      passed[mem](b, h("other")).value == Some(false),
      warnings(a1) == [],
    ]
  });
  assert_eq(run.value, [true, true, true, true, true])
}

test "a pass filed under the code its test ran outlives another runtime stamp, and goes with its own" {
  let run = on_twin(mem_empty(), || {
    let a = open_cache[mem]("cache", "", [], built());
    let _filed = flush_cache[mem](put_passed_code(put_passed(a, h("result")), h("code")));
    let moved = open_cache[mem]("cache", "", [], { ..built(), runtime: "another" });
    let recoded = open_cache[mem]("cache", "", [], {
      ..built(),
      runtime: "another",
      code: "another",
    });
    [
      passed[mem](moved, h("result")).value,
      passed_code[mem](moved, h("code")).value,
      passed_code[mem](recoded, h("code")).value,
    ]
  });
  assert_eq(run.value, [Some(false), Some(true), Some(false)])
}

test "a pass filed under its code is shared under a schema of its own, which another runtime reads" {
  let run = on_twin(mem_empty(), || {
    let a = with_upstream[mem](open_cache[mem]("one/cache", "one", [], built()), "shared", true);
    let _published = flush_shared[mem, mem](put_passed_code(put_passed(a, h("pass")), h("code")));
    let b = with_upstream[mem](
      open_cache[mem]("two/cache", "two", [], { ..built(), runtime: "another" }),
      "shared",
      true,
    );
    [passed[mem](b, h("pass")).value, passed_code[mem](b, h("code")).value]
  });
  assert_eq(run.value, [Some(false), Some(true)])
}

test "a publishing run marks every schema it used live, and a read-only one marks none" {
  let lives = |publish: Bool|
    on_twin(mem_empty(), || {
      let a = with_upstream[mem](
        open_cache[mem]("one/cache", "one", [], built()),
        "shared",
        publish,
      );
      let _flushed = flush_shared[mem, mem](a);
      match fs.list_dir[mem]("shared/v2") {
        Some(dirs) -> len(filter(dirs, |d: String| fs.exists[mem]("shared/v2/" ++ d ++ "/live"))),
        None -> 0,
      }
    }).value;
  assert_eq(lives(true), 2);
  assert_eq(lives(false), 0)
}

test "a read-only upstream answers and is not written" {
  let run = on_twin(mem_empty(), || {
    let a = with_upstream[mem](open_cache[mem]("one/cache", "one", [], built()), "shared", false);
    let a1 = flush_shared[mem, mem](put_passed(a, h("pass")));
    let b = with_upstream[mem](open_cache[mem]("two/cache", "two", [], built()), "shared", true);
    passed[mem](b, h("pass")).value
  });
  assert_eq(run.value, Some(false))
}

test "two runs publishing one pass race harmlessly, and an unwritable upstream is a warning" {
  let run = on_twin(mem_empty(), || {
    let a = with_upstream[mem](open_cache[mem]("one/cache", "one", [], built()), "shared", true);
    let b = with_upstream[mem](open_cache[mem]("two/cache", "two", [], built()), "shared", true);
    let a1 = flush_shared[mem, mem](put_passed(a, h("pass")));
    let b1 = flush_shared[mem, mem](put_passed(b, h("pass")));
    let blocked = fs.write_file[mem]("blocked", b"a file where the upstream should be");
    let c = with_upstream[mem](
      open_cache[mem]("three/cache", "three", [], built()),
      "blocked",
      true,
    );
    let c1 = flush_shared[mem, mem](put_passed(c, h("mine")));
    let again = open_cache[mem]("three/cache", "three", [], built());
    {
      clean: warnings(a1) == [] && warnings(b1) == [],
      warned: messages(warnings(c1)),
      kept: passed[mem](again, h("mine")).value,
    }
  });
  assert(run.value.clean);
  assert_eq(run.value.warned, [
    "1 entry could not be published to the upstream store `blocked`; this run is unaffected",
  ]);
  assert_eq(run.value.kept, Some(true))
}

test "entries filed under another build's stamp are dropped group by group, and said once" {
  let run = on_twin(mem_empty(), || {
    let c0 = put_passed(
      put_fingerprint(open_cache[mem]("cache", "", [], built()), print("a.ply", ["m.f"])),
      h("t"),
    );
    let c1 = put_review(c0, "m.f", { def: h("m.f"), specs: [] });
    let written = flush_cache[mem](c1);
    let moved = { ..built(), frontend: "elsewhere" };
    let r = open_cache[mem]("cache", "", [], moved);
    let warned = messages(r.store.warnings);
    let refiled = flush_cache[mem](open_cache[mem]("cache", "", [], moved));
    {
      warned: warned,
      fingerprint: fingerprint[mem](r, "a.ply").value == None,
      passed: passed[mem](r, h("t")).value,
      review: review[mem](r, "m.f").value != None,
      later: messages(open_cache[mem]("cache", "", [], moved).store.warnings),
    }
  });
  assert_eq(run.value.warned, [
    "the front end's entries were filed by another build (frontend; this one is elsewhere), so they are filed again",
  ]);
  assert(run.value.fingerprint);
  assert_eq(run.value.passed, Some(true));
  assert(run.value.review);
  assert_eq(run.value.later, [])
}

test "a pass or a claim's evidence filed by another runtime is not believed" {
  let run = on_twin(mem_empty(), || {
    let c0 = put_evidence(
      put_passed(
        put_fingerprint(open_cache[mem]("cache", "", [], built()), print("a.ply", ["m.f"])),
        h("t"),
      ),
      h("claim"),
      b"evidence",
    );
    let written = flush_cache[mem](c0);
    let r = open_cache[mem]("cache", "", [], { ..built(), runtime: "another runtime" });
    {
      warned: len(messages(r.store.warnings)),
      fingerprint: fingerprint[mem](r, "a.ply").value != None,
      passed: passed[mem](r, h("t")).value,
      evidence: evidence[mem](r, h("claim")).value,
    }
  });
  assert_eq(run.value.warned, 1);
  assert(run.value.fingerprint);
  assert_eq(run.value.passed, Some(false));
  assert_eq(run.value.evidence, None)
}

test "an upstream answers only the runtime that published to it" {
  let run = on_twin(mem_empty(), || {
    let a = with_upstream[mem](open_cache[mem]("one/cache", "one", [], built()), "shared", true);
    let published = flush_shared[mem, mem](put_passed(a, h("pass")));
    let same = with_upstream[mem](open_cache[mem]("two/cache", "two", [], built()), "shared", true);
    let other = with_upstream[mem](
      open_cache[mem]("three/cache", "three", [], { ..built(), runtime: "another runtime" }),
      "shared",
      true,
    );
    [passed[mem](same, h("pass")).value, passed[mem](other, h("pass")).value]
  });
  assert_eq(run.value, [Some(true), Some(false)])
}
