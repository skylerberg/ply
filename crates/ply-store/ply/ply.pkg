import std.pkg (Manifest)

// The store: what `ply` keeps between runs in `.ply-cache`, read and written here, so no Rust
// touches the directory. One data file of frames, found through one index rewritten whole.
fn package() -> Manifest = {
  name: "store",
  version: { major: 0, minor: 1, patch: 0 },
  prefix: None,
  runtime: { major: 0, minor: 16, patch: 0 },
  dependencies: [],
  entry: None,
}
