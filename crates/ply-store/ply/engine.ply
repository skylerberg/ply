// The engine: frames appended to one data file and found through one index of sorted sections,
// rewritten whole. It knows a table by its number and a key as 32 bytes, never what a payload means.

import std.fs (fs, mem_empty)
import std.random (entropy)
import std.time (time)
import std.bytes (u32_le, u64_le)
import twin (on_twin)

// --- Layout -----------------------------------------------------------------

// Moves whenever the bytes on disk change meaning; a store in another format reads as empty.
pub fn format() -> Int = 1

pub fn key_width() -> Int = 32

fn data_name() -> String = "store.dat"
fn index_name() -> String = "store.idx"
fn lock_name() -> String = "store.lock"
fn temp_suffix() -> String = ".tmp"
fn data_magic() -> Bytes = b"PLYSTDAT"
fn index_magic() -> Bytes = b"PLYSTIDX"

// Magic, format, nonce, schema.
fn data_header() -> Int = 60

// Magic, format, nonce, data length, schema, checksum, table count.
fn index_header() -> Int = 104

// Table, count, offset of the first record.
fn table_width() -> Int = 16

// Key, frame offset, payload length.
fn record_width() -> Int = 44

// Table, payload length, checksum.
fn frame_header() -> Int = 13

fn path(dir: String, name: String) -> String = if dir == "" { name } else { dir ++ "/" ++ name }

fn u32_at(b: Bytes, at: Int) -> Int = int_of_u32(bytes_u32_le(b, at))

fn u64_at(b: Bytes, at: Int) -> Int = u32_at(b, at) | u32_at(b, at + 4) << 32

// --- The store --------------------------------------------------------------

pub type Section = { table: Int, count: Int, start: Int }

// What one run holds: the index it read, and what it put and dropped since, which a read sees first.
pub type Store = {
  dir: String,
  schema: Bytes,
  nonce: Bytes,
  data_len: Int,
  index: Bytes,
  sections: List<Section>,
  puts: Map<Bytes, Bytes>,
  drops: Map<Bytes, Bool>,
  warnings: List<Warning>,
}

// What a warning reports: the store could not be read or written, held something that did not
// verify, or was written in another format or for other stored types.
pub type Trouble = | Unreadable | Corrupt | OtherVersion

pub type Warning = { trouble: Trouble, message: String }

pub type Found = | Hit(Bytes) | Miss | Bad(String)

type Disk = { nonce: Bytes, data_len: Int, index: Bytes, sections: List<Section> }

type Problem = { trouble: Trouble, why: String }

type Loaded = | Valid(Disk) | Cold | Unusable(Problem)

fn corrupt(why: String) -> Problem = { trouble: Corrupt, why: why }

fn foreign(why: String) -> Problem = { trouble: OtherVersion, why: why }

fn empty_disk() -> Disk = { nonce: b"", data_len: 0, index: b"", sections: [] }

fn with_disk(dir: String, schema: Bytes, d: Disk, warnings: List<Warning>) -> Store =
  {
    dir: dir,
    schema: schema,
    nonce: d.nonce,
    data_len: d.data_len,
    index: d.index,
    sections: d.sections,
    puts: map_new(),
    drops: map_new(),
    warnings: warnings,
  }

// One warning per distinct reason, however often a run meets it.
pub fn warn(s: Store, trouble: Trouble, message: String) -> Store =
  { ..s, warnings: noted(s.warnings, { trouble: trouble, message: message }) }

fn noted(ws: List<Warning>, w: Warning) -> List<Warning> =
  if fold(ws, false, |seen: Bool, x: Warning| seen || x == w) { ws } else { push(ws, w) }

pub fn messages(ws: List<Warning>) -> List<String> = map(ws, |w: Warning| w.message)

fn starts_empty(p: Problem) -> Warning =
  {
    trouble: p.trouble,
    message: match p.trouble {
      OtherVersion ->
        "the store was written by another version (" ++ p.why ++ "); this run starts empty",
      _ -> "the store is unreadable (" ++ p.why ++ "); this run starts empty",
    },
  }

// `schema` names every stored type's encoding; a store written under another is read as empty.
pub fn open<[r]>(dir: String, schema: Bytes) -> Store / {fs.read[r]} = {
  let digest = bytes_blake3(schema);
  match load[r](dir, digest) {
    Valid(d) -> with_disk(dir, digest, d, []),
    Cold -> with_disk(dir, digest, empty_disk(), []),
    Unusable(p) -> with_disk(dir, digest, empty_disk(), [starts_empty(p)]),
  }
}

fn load<[r]>(dir: String, schema: Bytes) -> Loaded / {fs.read[r]} =
  match fs.read_file[r](path(dir, index_name())) {
    None -> Cold,
    Some(idx) -> match parse_index(idx, schema) {
      Err(p) -> Unusable(p),
      Ok(d) -> match data_problem[r](dir, d, schema) { None -> Valid(d), Some(p) -> Unusable(p) },
    },
  }

fn parse_index(b: Bytes, schema: Bytes) -> Result<Disk, Problem> =
  if bytes_len(b) < index_header() || bytes_slice(b, 0, 8) != index_magic() {
    Err(corrupt("the index is not a store index"))
  } else if u32_at(b, 8) != format() {
    Err(
      foreign(
        "the index is in format " ++ int_to_string(u32_at(b, 8)) ++ ", not "
          ++ int_to_string(format()),
      ),
    )
  } else if bytes_slice(b, 36, 68) != schema {
    Err(foreign("the index was written for other stored types"))
  } else if bytes_blake3(bytes_slice(b, index_header(), bytes_len(b))) != bytes_slice(b, 68, 100) {
    Err(corrupt("the index does not match its checksum"))
  } else if u64_at(b, 28) < data_header() { Err(corrupt("the index vouches for no data file")) }
  else {
    let count = u32_at(b, 100);
    let records = index_header() + count * table_width();
    if records > bytes_len(b) { Err(corrupt("the index's tables run past its end")) } else {
      match sections_from(b, 0, count, records, 0 - 1, []) {
        Err(why) -> Err(why),
        Ok(secs) ->
          Ok({ nonce: bytes_slice(b, 12, 28), data_len: u64_at(b, 28), index: b, sections: secs }),
      }
    }
  }

fn sections_from(
  b: Bytes,
  i: Int,
  count: Int,
  records: Int,
  last: Int,
  acc: List<Section>,
) -> Result<List<Section>, Problem> =
  if i == count { Ok(acc) } else {
    let at = index_header() + i * table_width();
    let sec = { table: u32_at(b, at), count: u32_at(b, at + 4), start: u64_at(b, at + 8) };
    if sec.table <= last { Err(corrupt("the index's tables are out of order")) }
    else if sec.start < records || sec.start + sec.count * record_width() > bytes_len(b) {
      Err(corrupt("a table lies outside the index"))
    } else { sections_from(b, i + 1, count, records, sec.table, push(acc, sec)) }
  }

fn data_problem<[r]>(dir: String, d: Disk, schema: Bytes) -> Option<Problem> / {fs.read[r]} = {
  let file = path(dir, data_name());
  match fs.read_at[r](file, 0, data_header()) {
    None -> Some(corrupt("the data file is missing")),
    Some(h) -> if bytes_len(h) < data_header() || bytes_slice(h, 0, 8) != data_magic() {
      Some(corrupt("the data file is not a store's"))
    } else if bytes_slice(h, 12, 28) != d.nonce {
      Some(corrupt("the data file is not the one the index was written with"))
    } else if u32_at(h, 8) != format() || bytes_slice(h, 28, 60) != schema {
      Some(foreign("the data file was written for other stored types"))
    } else {
      match fs.file_size[r](file) {
        Some(n) -> if n < d.data_len {
          Some(corrupt("the data file is shorter than the index vouches for"))
        } else { None },
        None -> Some(corrupt("the data file is missing")),
      }
    },
  }
}

// --- Reading ----------------------------------------------------------------

fn slot(table: Int, key: Bytes) -> Bytes = byte_of_int(table) ++ key

fn section_of(secs: List<Section>, table: Int) -> Option<Section> =
  fold(secs, None, |acc: Option<Section>, s: Section|
    match acc { Some(_) -> acc, None -> if s.table == table { Some(s) } else { None } })

fn record_at(sec: Section, i: Int) -> Int = sec.start + i * record_width()

fn key_at(index: Bytes, sec: Section, i: Int) -> Bytes =
  bytes_slice(index, record_at(sec, i), record_at(sec, i) + key_width())

fn lower_bound(index: Bytes, sec: Section, key: Bytes, lo: Int, hi: Int) -> Int =
  if lo >= hi { lo } else {
    let mid = lo + (hi - lo) / 2;
    if compare_values(key_at(index, sec, mid), key) == Less {
      lower_bound(index, sec, key, mid + 1, hi)
    } else { lower_bound(index, sec, key, lo, mid) }
  }

fn located(index: Bytes, table: Int, sections: List<Section>, key: Bytes) -> Option<Int> =
  match section_of(sections, table) {
    None -> None,
    Some(sec) -> {
      let i = lower_bound(index, sec, key, 0, sec.count);
      if i < sec.count && key_at(index, sec, i) == key { Some(record_at(sec, i)) } else { None }
    },
  }

pub fn get<[r]>(s: Store, table: Int, key: Bytes) -> Found / {fs.read[r]} =
  match map_get(s.puts, slot(table, key)) {
    Some(payload) -> Hit(payload),
    None -> if map_contains(s.drops, slot(table, key)) { Miss } else {
      match located(s.index, table, s.sections, key) {
        None -> Miss,
        Some(at) ->
          frame_at[r](
            s.dir,
            s.data_len,
            table,
            u64_at(s.index, at + key_width()),
            u32_at(s.index, at + key_width() + 8),
          ),
      }
    },
  }

fn checksum(head: Bytes, payload: Bytes) -> Bytes = bytes_slice(bytes_blake3(head ++ payload), 0, 8)

fn frame(table: Int, payload: Bytes) -> Bytes = {
  let head = byte_of_int(table) ++ u32_le(bytes_len(payload));
  bytes_concat_all([head, checksum(head, payload), payload])
}

fn frame_at<[r]>(
  dir: String,
  data_len: Int,
  table: Int,
  offset: Int,
  len: Int,
) -> Found / {fs.read[r]} =
  if offset < data_header() || offset + frame_header() + len > data_len {
    Bad("an index entry points outside the data file")
  } else {
    match fs.read_at[r](path(dir, data_name()), offset, frame_header() + len) {
      None -> Bad("the data file could not be read"),
      Some(b) -> if bytes_len(b) != frame_header() + len {
        Bad("the data file ends inside a frame")
      } else if bytes_at(b, 0) != table || u32_at(b, 1) != len {
        Bad("an index entry does not name its frame")
      } else {
        let payload = bytes_slice(b, frame_header(), frame_header() + len);
        if checksum(bytes_slice(b, 0, 5), payload) != bytes_slice(b, 5, frame_header()) {
          Bad("a frame does not match its checksum")
        } else { Hit(payload) }
      },
    }
  }

// Every key the table holds, ascending, what this run put and dropped included.
pub fn keys(s: Store, table: Int) -> List<Bytes> = {
  let on_disk = match section_of(s.sections, table) {
    None -> [],
    Some(sec) -> map(range(0, sec.count), |i: Int| key_at(s.index, sec, i)),
  };
  let kept = fold(on_disk, map_new(), |acc: Map<Bytes, Bool>, k: Bytes|
    if map_contains(s.drops, slot(table, k)) { acc } else { map_insert(acc, k, true) });
  map_keys(
    map_fold(s.puts, kept, |acc: Map<Bytes, Bool>, sl: Bytes, p: Bytes|
      if bytes_at(sl, 0) == table { map_insert(acc, bytes_slice(sl, 1, bytes_len(sl)), true) }
      else { acc }),
  )
}

pub type Stats = { entries: List<{ table: Int, count: Int }>, data_bytes: Int, live_bytes: Int }

// What the index on disk names, so `data_bytes - live_bytes` is what compaction reclaims.
pub fn stats(s: Store) -> Stats = {
  let live = fold(
    s.sections,
    if s.data_len == 0 { 0 } else { data_header() },
    |acc: Int, sec: Section|
      fold(range(0, sec.count), acc, |n: Int, i: Int|
        n + frame_header() + u32_at(s.index, record_at(sec, i) + key_width() + 8)),
  );
  {
    entries: map(s.sections, |sec: Section| { table: sec.table, count: sec.count }),
    data_bytes: s.data_len,
    live_bytes: live,
  }
}

// --- Writing ----------------------------------------------------------------

fn checked(table: Int, key: Bytes) -> Bytes =
  if table < 0 || table > 255 { panic("a store table is numbered 0 to 255") }
  else if bytes_len(key) != key_width() { panic("a store key is 32 bytes") }
  else { slot(table, key) }

// Kept by the next `flush`; until then this store's reads see it.
pub fn put(s: Store, table: Int, key: Bytes, payload: Bytes) -> Store = {
  let sl = checked(table, key);
  { ..s, puts: map_insert(s.puts, sl, payload), drops: map_remove(s.drops, sl) }
}

pub fn drop(s: Store, table: Int, key: Bytes) -> Store = {
  let sl = checked(table, key);
  { ..s, puts: map_remove(s.puts, sl), drops: map_insert(s.drops, sl, true) }
}

pub fn pending(s: Store) -> Int = map_len(s.puts) + map_len(s.drops)

fn not_kept(s: Store, why: String) -> Store =
  warn(s, Unreadable, why ++ "; this run's entries were not kept")

fn fresh_nonce() -> Bytes / {entropy.next, time.now_ms} =
  bytes_slice(bytes_blake3(u64_le(entropy.next()) ++ u64_le(time.now_ms())), 0, 16)

fn data_head(nonce: Bytes, schema: Bytes) -> Bytes =
  bytes_concat_all([data_magic(), u32_le(format()), nonce, schema])

// Read, merge and write under the lock, so two runs flushing one store keep each other's entries.
pub fn flush<[r]>(s: Store) -> Store / {fs.read[r], fs.write[r], entropy.next, time.now_ms} =
  if pending(s) == 0 { s }
  else if !fs.create_dir[r](s.dir) { not_kept(s, "the store's directory could not be made") }
  else if !fs.lock[r](path(s.dir, lock_name())) {
    not_kept(s, "another run holds the store's lock")
  } else {
    sweep[r](s.dir);
    let written = locked_flush[r](s);
    if fs.unlock[r](path(s.dir, lock_name())) { written }
    else { warn(written, Unreadable, "the store's lock could not be released") }
  }

// Every temp file is stale under the lock: only its holder writes one.
fn sweep<[r]>(dir: String) -> Unit / {fs.read[r], fs.write[r]} =
  match fs.list_dir[r](dir) {
    None -> (),
    Some(names) ->
      fold(names, (), |u: Unit, name: String|
        if string_starts_with(name, "store.") && string_ends_with(name, temp_suffix()) {
          if fs.remove[r](path(dir, name)) { () } else { () }
        } else { () }),
  }

type Base = { disk: Option<Disk>, warnings: List<Warning> }

// The store on disk now, which another run may have written since this one opened it.
fn base<[r]>(s: Store) -> Base / {fs.read[r], fs.write[r], entropy.next, time.now_ms} =
  match load[r](s.dir, s.schema) {
    Valid(d) -> { disk: Some(d), warnings: s.warnings },
    Cold -> started[r](s.dir, s.schema, s.warnings),
    Unusable(p) -> started[r](s.dir, s.schema, noted(s.warnings, starts_empty(p))),
  }

fn started<[r]>(
  dir: String,
  schema: Bytes,
  warnings: List<Warning>,
) -> Base / {fs.write[r], entropy.next, time.now_ms} = {
  let nonce = fresh_nonce();
  let file = path(dir, data_name());
  if fs.write_file[r](file, data_head(nonce, schema)) && fs.sync[r](file) {
    {
      disk: Some({ nonce: nonce, data_len: data_header(), index: b"", sections: [] }),
      warnings: warnings,
    }
  } else { { disk: None, warnings: warnings } }
}

type Placed = { slot: Bytes, at: Int, len: Int }
type Batch = { frames: List<Bytes>, size: Int, placed: List<Placed> }

fn batch_of(puts: Map<Bytes, Bytes>) -> Batch =
  map_fold(puts, { frames: [], size: 0, placed: [] }, |acc: Batch, sl: Bytes, payload: Bytes| {
    let f = frame(bytes_at(sl, 0), payload);
    {
      frames: push(acc.frames, f),
      size: acc.size + bytes_len(f),
      placed: push(acc.placed, { slot: sl, at: acc.size, len: bytes_len(payload) }),
    }
  })

fn locked_flush<[r]>(s: Store) -> Store / {fs.read[r], fs.write[r], entropy.next, time.now_ms} = {
  let b = base[r](s);
  let s1 = { ..s, warnings: b.warnings };
  match b.disk {
    None -> not_kept(s1, "the store's data file could not be started"),
    Some(d) -> {
      let batch = batch_of(s.puts);
      let file = path(s.dir, data_name());
      let landed = if batch.size == 0 { Some(d.data_len) }
      else { fs.append[r](file, bytes_concat_all(batch.frames)) };
      match landed {
        None -> not_kept(s1, "the store's data file could not be written"),
        Some(at) -> if batch.size > 0 && !fs.sync[r](file) {
          not_kept(s1, "the store's data file could not be synced")
        } else {
          let moved = map(batch.placed, |p: Placed| { slot: p.slot, at: at + p.at, len: p.len });
          let tables = merged(d, s.drops, moved);
          let index = index_bytes(
            d.nonce,
            if batch.size == 0 { d.data_len } else { at + batch.size },
            s.schema,
            tables,
          );
          published[r](s1, index)
        },
      }
    },
  }
}

// Writes the index beside its place, then renames it there, so a reader sees the old or the new.
fn published<[r]>(s: Store, index: Bytes) -> Store / {fs.write[r]} = {
  let tmp = path(s.dir, index_name() ++ temp_suffix());
  if fs.write_file[r](tmp, index) && fs.sync[r](tmp)
      && fs.rename[r](tmp, path(s.dir, index_name())) {
    match parse_index(index, s.schema) {
      Ok(d) -> {
        let fresh = with_disk(s.dir, s.schema, d, s.warnings);
        if s.dir == "" || fs.sync[r](s.dir) { fresh }
        else { warn(fresh, Unreadable, "the store's directory could not be synced") }
      },
      Err(why) -> not_kept(s, "the index this run wrote does not read back (" ++ why.why ++ ")"),
    }
  } else { not_kept(s, "the store's index could not be written") }
}

type New = { key: Bytes, record: Bytes }
type Table = { table: Int, records: List<Bytes> }

fn record(key: Bytes, at: Int, len: Int) -> Bytes = bytes_concat_all([key, u64_le(at), u32_le(len)])

fn table_ids(secs: List<Section>, placed: List<Placed>) -> List<Int> =
  map_keys(
    fold(
      placed,
      fold(secs, map_new(), |m: Map<Int, Bool>, s: Section| map_insert(m, s.table, true)),
      |m: Map<Int, Bool>, p: Placed| map_insert(m, bytes_at(p.slot, 0), true),
    ),
  )

// Each table's records, the old and the new merged in key order: a new one replaces an old one with
// its key, and a dropped key is left out.
fn merged(d: Disk, drops: Map<Bytes, Bool>, placed: List<Placed>) -> List<Table> =
  map(table_ids(d.sections, placed), |t: Int| {
    let news = fold(placed, [], |acc: List<New>, p: Placed|
      if bytes_at(p.slot, 0) != t { acc } else {
        let key = bytes_slice(p.slot, 1, bytes_len(p.slot));
        push(acc, { key: key, record: record(key, p.at, p.len) })
      });
    let sec = match section_of(d.sections, t) {
      Some(x) -> x,
      None -> { table: t, count: 0, start: 0 },
    };
    { table: t, records: merge_from(d.index, drops, sec, news, 0, 0, []) }
  })

fn keep_old(
  index: Bytes,
  drops: Map<Bytes, Bool>,
  sec: Section,
  i: Int,
  out: List<Bytes>,
) -> List<Bytes> =
  if map_contains(drops, slot(sec.table, key_at(index, sec, i))) { out }
  else { push(out, bytes_slice(index, record_at(sec, i), record_at(sec, i) + record_width())) }

fn merge_from(
  index: Bytes,
  drops: Map<Bytes, Bool>,
  sec: Section,
  news: List<New>,
  i: Int,
  j: Int,
  out: List<Bytes>,
) -> List<Bytes> =
  match list_at(news, j) {
    None -> if i >= sec.count { out }
    else { merge_from(index, drops, sec, news, i + 1, j, keep_old(index, drops, sec, i, out)) },
    Some(n) -> if i >= sec.count {
      merge_from(index, drops, sec, news, i, j + 1, push(out, n.record))
    } else {
      let order = compare_values(key_at(index, sec, i), n.key);
      if order == Less {
        merge_from(index, drops, sec, news, i + 1, j, keep_old(index, drops, sec, i, out))
      } else if order == Equal {
        merge_from(index, drops, sec, news, i + 1, j + 1, push(out, n.record))
      } else { merge_from(index, drops, sec, news, i, j + 1, push(out, n.record)) }
    },
  }

type Dir = { start: Int, entries: List<Bytes> }

fn index_bytes(nonce: Bytes, data_len: Int, schema: Bytes, tables: List<Table>) -> Bytes = {
  let kept = filter(tables, |t: Table| len(t.records) > 0);
  let first = index_header() + len(kept) * table_width();
  let dir = fold(kept, { start: first, entries: [] }, |acc: Dir, t: Table|
    {
      start: acc.start + len(t.records) * record_width(),
      entries: push(
        acc.entries,
        bytes_concat_all([u32_le(t.table), u32_le(len(t.records)), u64_le(acc.start)]),
      ),
    });
  let body = bytes_concat_all([
    bytes_concat_all(dir.entries),
    bytes_concat_all(map(kept, |t: Table| bytes_concat_all(t.records))),
  ]);
  bytes_concat_all([
    index_magic(),
    u32_le(format()),
    nonce,
    u64_le(data_len),
    schema,
    bytes_blake3(body),
    u32_le(len(kept)),
    body,
  ])
}

// --- Compaction -------------------------------------------------------------

type Copied = { frames: List<Bytes>, size: Int, tables: List<Table>, dropped: Int }

// The live frames copied into a fresh data file, so what replaced or dropped entries left is gone.
pub fn compact<[r]>(s0: Store) -> Store / {fs.read[r], fs.write[r], entropy.next, time.now_ms} = {
  let s = flush[r](s0);
  if pending(s) > 0 { s } else if !fs.lock[r](path(s.dir, lock_name())) {
    warn(s, Unreadable, "another run holds the store's lock; it was not compacted")
  } else {
    sweep[r](s.dir);
    let done = locked_compact[r](s);
    if fs.unlock[r](path(s.dir, lock_name())) { done }
    else { warn(done, Unreadable, "the store's lock could not be released") }
  }
}

fn locked_compact<[r]>(s: Store) -> Store / {fs.read[r], fs.write[r], entropy.next, time.now_ms} =
  match load[r](s.dir, s.schema) {
    Cold -> s,
    Unusable(p) -> { ..s, warnings: noted(s.warnings, starts_empty(p)) },
    Valid(d) -> {
      let copied = fold(
        d.sections,
        { frames: [], size: data_header(), tables: [], dropped: 0 },
        |acc: Copied, sec: Section| copy_table[r](s.dir, d, sec, acc),
      );
      let nonce = fresh_nonce();
      let data = bytes_concat_all([data_head(nonce, s.schema), bytes_concat_all(copied.frames)]);
      let index = index_bytes(nonce, copied.size, s.schema, copied.tables);
      let dtmp = path(s.dir, data_name() ++ temp_suffix());
      let itmp = path(s.dir, index_name() ++ temp_suffix());
      let s1 = if copied.dropped == 0 { s }
      else { warn(s, Corrupt, "compaction dropped entries that did not verify") };
      if fs.write_file[r](dtmp, data) && fs.sync[r](dtmp) && fs.write_file[r](itmp, index)
          && fs.sync[r](itmp)
          && fs.rename[r](dtmp, path(s.dir, data_name()))
          && fs.rename[r](itmp, path(s.dir, index_name())) {
        match parse_index(index, s.schema) {
          Ok(nd) -> with_disk(s.dir, s.schema, nd, s1.warnings),
          Err(p) ->
            warn(s1, Corrupt, "the index compaction wrote does not read back (" ++ p.why ++ ")"),
        }
      } else { warn(s1, Unreadable, "the store could not be compacted") }
    },
  }

fn copy_table<[r]>(dir: String, d: Disk, sec: Section, acc0: Copied) -> Copied / {fs.read[r]} = {
  let walked = fold(
    range(0, sec.count),
    { frames: acc0.frames, size: acc0.size, records: [], dropped: acc0.dropped },
    |acc: { frames: List<Bytes>, size: Int, records: List<Bytes>, dropped: Int }, i: Int| {
      let at = record_at(sec, i);
      let len = u32_at(d.index, at + key_width() + 8);
      match frame_at[r](dir, d.data_len, sec.table, u64_at(d.index, at + key_width()), len) {
        Hit(payload) -> {
          let f = frame(sec.table, payload);
          {
            frames: push(acc.frames, f),
            size: acc.size + bytes_len(f),
            records: push(acc.records, record(key_at(d.index, sec, i), acc.size, len)),
            dropped: acc.dropped,
          }
        },
        _ -> { ..acc, dropped: acc.dropped + 1 },
      }
    },
  );
  {
    frames: walked.frames,
    size: walked.size,
    tables: push(acc0.tables, { table: sec.table, records: walked.records }),
    dropped: walked.dropped,
  }
}

// --- Tests ------------------------------------------------------------------

fn k(name: String) -> Bytes = bytes_blake3(bytes_of_string(name))

fn schema_a() -> Bytes = b"schema a"

fn hit(f: Found) -> Bytes =
  match f { Hit(b) -> b, Miss -> b"<miss>", Bad(why) -> bytes_of_string(why) }

fn all(xs: List<List<Warning>>) -> List<String> =
  fold(xs, [], |acc: List<String>, x: List<Warning>|
    fold(x, acc, |a: List<String>, w: Warning| push(a, w.message)))

fn missed(f: Found) -> Bool = match f { Miss -> true, _ -> false }

test "what a store puts it reads at once, and again after a flush and a reopen" {
  let run = on_twin(mem_empty(), || {
    let s0 = open[mem]("cache", schema_a());
    assert_eq(s0.warnings, []);
    let s1 = put(put(put(s0, 1, k("a"), b"alpha"), 2, k("a"), b"other table"), 1, k("b"), b"beta");
    assert_eq(hit(get[mem](s1, 1, k("a"))), b"alpha");
    let s2 = flush[mem](s1);
    assert_eq(s2.warnings, []);
    assert_eq(pending(s2), 0);
    let s3 = open[mem]("cache", schema_a());
    assert_eq(hit(get[mem](s3, 1, k("a"))), b"alpha");
    assert_eq(hit(get[mem](s3, 1, k("b"))), b"beta");
    assert_eq(hit(get[mem](s3, 2, k("a"))), b"other table");
    assert(missed(get[mem](s3, 1, k("c"))));
    assert_eq(len(keys(s3, 1)), 2);
    assert_eq(map(stats(s3).entries, |e: { table: Int, count: Int }| e.count), [2, 1]);
    messages(s3.warnings)
  });
  assert_eq(run.value, [])
}

test "a drop and a replacement hold across a flush" {
  let run = on_twin(mem_empty(), || {
    let s1 = flush[mem](
      put(put(open[mem]("cache", schema_a()), 1, k("a"), b"one"), 1, k("b"), b"two"),
    );
    let s2 = flush[mem](put(drop(s1, 1, k("a")), 1, k("b"), b"three"));
    assert(missed(get[mem](s2, 1, k("a"))));
    let s3 = open[mem]("cache", schema_a());
    assert(missed(get[mem](s3, 1, k("a"))));
    assert_eq(hit(get[mem](s3, 1, k("b"))), b"three");
    assert_eq(keys(s3, 1), [k("b")]);
    messages(s3.warnings)
  });
  assert_eq(run.value, [])
}

test "two runs flushing one store keep each other's entries, and the later wins a shared key" {
  let run = on_twin(mem_empty(), || {
    let a = put(put(open[mem]("cache", schema_a()), 1, k("mine"), b"a"), 1, k("both"), b"from a");
    let b = put(put(open[mem]("cache", schema_a()), 1, k("theirs"), b"b"), 1, k("both"), b"from b");
    let a1 = flush[mem](a);
    let b1 = flush[mem](b);
    let c = open[mem]("cache", schema_a());
    assert_eq(hit(get[mem](c, 1, k("mine"))), b"a");
    assert_eq(hit(get[mem](c, 1, k("theirs"))), b"b");
    assert_eq(hit(get[mem](c, 1, k("both"))), b"from b");
    all([a1.warnings, b1.warnings, c.warnings])
  });
  assert_eq(run.value, [])
}

test "a torn append past what the index vouches for is never read and is written over" {
  let run = on_twin(mem_empty(), || {
    let s1 = flush[mem](put(open[mem]("cache", schema_a()), 1, k("a"), b"kept"));
    match fs.append[mem]("cache/store.dat", b"\x01\x05\x00\x00\x00half") { _ -> () };
    let s2 = open[mem]("cache", schema_a());
    assert_eq(s2.warnings, []);
    assert_eq(hit(get[mem](s2, 1, k("a"))), b"kept");
    let s3 = flush[mem](put(s2, 1, k("b"), b"after"));
    let s4 = open[mem]("cache", schema_a());
    assert_eq(hit(get[mem](s4, 1, k("a"))), b"kept");
    assert_eq(hit(get[mem](s4, 1, k("b"))), b"after");
    all([s1.warnings, s3.warnings, s4.warnings])
  });
  assert_eq(run.value, [])
}

test "a frame that does not verify is a miss with its reason, never a half-read value" {
  let run = on_twin(mem_empty(), || {
    let s1 = flush[mem](put(open[mem]("cache", schema_a()), 1, k("a"), b"payload"));
    let data = match fs.read_file[mem]("cache/store.dat") { Some(b) -> b, None -> b"" };
    let n = bytes_len(data);
    let broken = bytes_slice(data, 0, n - 1) ++ b"X";
    assert(fs.write_file[mem]("cache/store.dat", broken));
    get[mem](open[mem]("cache", schema_a()), 1, k("a"))
  });
  assert_eq(run.value, Bad("a frame does not match its checksum"))
}

test "a store written under another schema, or missing its data file, opens empty and says why" {
  let run = on_twin(mem_empty(), || {
    let s1 = flush[mem](put(open[mem]("cache", schema_a()), 1, k("a"), b"x"));
    let other = open[mem]("cache", b"schema b");
    assert(missed(get[mem](other, 1, k("a"))));
    assert(fs.remove[mem]("cache/store.dat"));
    let gone = open[mem]("cache", schema_a());
    assert(missed(get[mem](gone, 1, k("a"))));
    let again = flush[mem](put(gone, 1, k("b"), b"y"));
    assert_eq(hit(get[mem](open[mem]("cache", schema_a()), 1, k("b"))), b"y");
    all([other.warnings, gone.warnings])
  });
  assert_eq(run.value, [
    "the store was written by another version (the index was written for other stored types); this run starts empty",
    "the store is unreadable (the data file is missing); this run starts empty",
  ])
}

test "a run that cannot take the lock writes nothing and says so" {
  let run = on_twin(mem_empty(), || {
    assert(fs.create_dir[mem]("cache"));
    assert(fs.lock[mem]("cache/store.lock"));
    let s = flush[mem](put(open[mem]("cache", schema_a()), 1, k("a"), b"x"));
    assert_eq(pending(s), 1);
    assert(missed(get[mem](open[mem]("cache", schema_a()), 1, k("a"))));
    messages(s.warnings)
  });
  assert_eq(run.value, ["another run holds the store's lock; this run's entries were not kept"])
}

test "compaction keeps the live frames, reclaims the rest, and sweeps a stale temp" {
  let run = on_twin(mem_empty(), || {
    let s1 = flush[mem](
      put(put(open[mem]("cache", schema_a()), 1, k("a"), b"first"), 1, k("b"), b"gone"),
    );
    let s2 = flush[mem](drop(put(s1, 1, k("a"), b"second"), 1, k("b")));
    assert(stats(s2).data_bytes > stats(s2).live_bytes);
    assert(fs.write_file[mem]("cache/store.idx.tmp", b"left by a crash"));
    let s3 = compact[mem](s2);
    assert_eq(stats(s3).data_bytes, stats(s3).live_bytes);
    assert(s3.nonce != s2.nonce);
    assert(!fs.exists[mem]("cache/store.idx.tmp"));
    let s4 = open[mem]("cache", schema_a());
    assert_eq(hit(get[mem](s4, 1, k("a"))), b"second");
    assert(missed(get[mem](s4, 1, k("b"))));
    all([s3.warnings, s4.warnings])
  });
  assert_eq(run.value, [])
}

test "an index that does not match its checksum opens empty and is replaced by the next flush" {
  let run = on_twin(mem_empty(), || {
    let s1 = flush[mem](put(open[mem]("cache", schema_a()), 1, k("a"), b"x"));
    let idx = match fs.read_file[mem]("cache/store.idx") { Some(b) -> b, None -> b"" };
    let n = bytes_len(idx);
    let flipped = byte_of_int(bytes_at(idx, n - 4) ^ 1);
    assert(
      fs.write_file[mem](
        "cache/store.idx",
        bytes_concat_all([bytes_slice(idx, 0, n - 4), flipped, bytes_slice(idx, n - 3, n)]),
      ),
    );
    let s2 = open[mem]("cache", schema_a());
    assert(missed(get[mem](s2, 1, k("a"))));
    let s3 = flush[mem](put(s2, 1, k("b"), b"y"));
    let s4 = open[mem]("cache", schema_a());
    assert_eq(hit(get[mem](s4, 1, k("b"))), b"y");
    all([s2.warnings, s4.warnings])
  });
  assert_eq(run.value, [
    "the store is unreadable (the index does not match its checksum); this run starts empty",
  ])
}

fn at_least(ws: List<Warning>) -> Warning =
  match list_at(ws, 0) { Some(w) -> w, None -> { trouble: Corrupt, message: "none" } }

test "a warning says whether the store was another version's, damaged, or out of reach" {
  let run = on_twin(mem_empty(), || {
    let s1 = flush[mem](put(open[mem]("cache", schema_a()), 1, k("a"), b"x"));
    let other = open[mem]("cache", b"schema b");
    assert(fs.remove[mem]("cache/store.dat"));
    let gone = open[mem]("cache", schema_a());
    assert(fs.lock[mem]("cache/store.lock"));
    let held = flush[mem](put(gone, 1, k("b"), b"y"));
    map(push(held.warnings, at_least(other.warnings)), |w: Warning| w.trouble)
  });
  assert_eq(run.value, [Corrupt, Unreadable, OtherVersion])
}
