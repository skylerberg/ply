// A store shared between checkouts and machines: one file per entry, holding the entry's frame,
// under a directory other runs write too. A key names its bytes, so a racing write is the same
// write, and an entry lands by a rename, so a reader sees all of it or none. There is no lock.

import std.fs (fs, mem_empty)
import std.random (entropy)
import std.time (time)
import std.bytes (hex_of, bytes_of_hex)
import engine (Found, Hit, Miss, Bad, frame, unframe, fresh_nonce)
import twin (on_twin)

// `schema` is the digest of the stored types, so a build with other ones misses rather than
// misreads. A read-only upstream answers but is never written.
pub type Upstream = { root: String, schema: Bytes, publish: Bool }

fn table_dir(u: Upstream, table: Int) -> String =
  u.root ++ "/v2/" ++ string_slice(hex_of(u.schema), 0, 16) ++ "/" ++ int_to_string(table)

fn shard_of(u: Upstream, table: Int, key: Bytes) -> String =
  table_dir(u, table) ++ "/" ++ string_slice(hex_of(key), 0, 2)

fn place(u: Upstream, table: Int, key: Bytes) -> String =
  shard_of(u, table, key) ++ "/" ++ hex_of(key)

pub fn read_entry<[r]>(u: Upstream, table: Int, key: Bytes) -> Found / {fs.read[r], abort.raise} =
  match fs.read_file[r](place(u, table, key)) { None -> Miss, Some(b) -> unframe(table, b) }

fn is_key_name(name: String) -> Bool =
  string_len(name) == 64
    && fold(range(0, 64), true, |ok: Bool, i: Int|
      ok && string_contains("0123456789abcdef", string_slice(name, i, i + 1)))

// Every key published under the table; an unreadable directory holds none.
pub fn entry_keys<[r]>(u: Upstream, table: Int) -> List<Bytes> / {fs.read[r], abort.raise} =
  match fs.list_dir[r](table_dir(u, table)) {
    None -> [],
    Some(shards) ->
      fold(shards, [], |acc: List<Bytes>, shard: String|
        match fs.list_dir[r](table_dir(u, table) ++ "/" ++ shard) {
          None -> acc,
          Some(names) ->
            fold(names, acc, |keys: List<Bytes>, name: String|
              if is_key_name(name) { push(keys, bytes_of_hex(name)) } else { keys }),
        }),
  }

// Lands by a rename from a temp beside it; an entry already there is the same bytes, so it stays.
pub fn publish<[r]>(
  u: Upstream,
  table: Int,
  key: Bytes,
  payload: Bytes,
) -> Bool / {fs.read[r], fs.write[r], entropy.next, time.now_ms, abort.raise} =
  if !u.publish || fs.exists[r](place(u, table, key)) { true }
  else if !fs.create_dir[r](shard_of(u, table, key)) { false } else {
    let temp = place(u, table, key) ++ "." ++ hex_of(fresh_nonce()) ++ ".tmp";
    if fs.write_file[r](temp, frame(table, payload)) && fs.rename[r](temp, place(u, table, key)) {
      true
    } else { if fs.remove[r](temp) { false } else { false } }
  }

// --- Tests ------------------------------------------------------------------

fn up(publish: Bool) -> Upstream =
  { root: "shared", schema: bytes_blake3(b"schema"), publish: publish }

fn k(name: String) -> Bytes = bytes_blake3(bytes_of_string(name))

test "what one run publishes another reads, keyed and verified" {
  let run = on_twin(mem_empty(), || {
    let wrote = publish[mem](up(true), 8, k("claim"), b"evidence")
      && publish[mem](up(true), 5, k("pass"), b"");
    let again = publish[mem](up(true), 8, k("claim"), b"evidence");
    [
      wrote && again,
      read_entry[mem](up(true), 8, k("claim")) == Hit(b"evidence"),
      read_entry[mem](up(true), 5, k("pass")) == Hit(b""),
      read_entry[mem](up(true), 8, k("other")) == Miss,
      entry_keys[mem](up(true), 5) == [k("pass")],
      entry_keys[mem](up(true), 6) == [],
    ]
  });
  assert_eq(run.value, [true, true, true, true, true, true])
}

test "a read-only upstream answers and is never written" {
  let run = on_twin(mem_empty(), || {
    let ok = publish[mem](up(false), 5, k("pass"), b"");
    [ok, entry_keys[mem](up(true), 5) == [], fs.exists[mem]("shared") == false]
  });
  assert_eq(run.value, [true, true, true])
}

test "an entry under other stored types is a miss, and a damaged one says why" {
  let run = on_twin(mem_empty(), || {
    let wrote = publish[mem](up(true), 8, k("claim"), b"evidence");
    let other = { root: "shared", schema: bytes_blake3(b"another"), publish: true };
    let path = place(up(true), 8, k("claim"));
    let bytes = match fs.read_file[mem](path) { Some(b) -> b, None -> b"" };
    let damaged = fs.write_file[mem](path, bytes_slice(bytes, 0, bytes_len(bytes) - 1) ++ b"?");
    [read_entry[mem](other, 8, k("claim")), read_entry[mem](up(true), 8, k("claim"))]
  });
  assert_eq(run.value, [Miss, Bad("a frame does not match its checksum")])
}
