//! A program checked a few definitions at a time, as queries the memo store keeps: a module is read
//! for its owners, the items one name owns; each group of owners that mention one another round a
//! cycle is checked against the entries its text names; and `entry` answers what one module shows
//! under one name. A module's answer is its groups' put together. A group reads entries, never
//! another owner's text, so an edit stops at the first definition whose entry comes out as it was.

import std.bin
import std.hash (blake3)
import std.bytes
import std.list
import std.fs
import std.fs (fs)
import memo
import memo (memo, memo_keep, Held, Query, Record, Run, Tally, answer, nothing_held, over_held,
             ran_total, ran_for, restored_for, started, tallies)
import memo_files
import packs
import unit (definition_hash)
import exports (Entry, Exports, HashEntry, Hashes, Placed, InRoot, InPackage, ShippedModule,
                Reading, Mention, OwnerRead, OwnerSource, ItemAt, Imported, imported_bin,
                group_imports, checked_against, exports_of, hashes_by_owner, hash_owners,
                named_node, needed_by, wanted_in, entry_bin, exports_bin, hash_entry_bin,
                hashes_bin, placed_bin, mention_bin, owner_read_bin, module_scope, owner_reads,
                owner_mentions, owner_groups, group_needs, group_source_from, entry_head,
                mention_key, unplaced_imports, laid_items, checked_owner, needed_through, head_of,
                called_of, of_any, reaching, signing_read, owner_tokens, signing_tokens,
                call_cycles)
import owned
import types (tables_joined)
import front (Analysis, AnalysisOutcome, Analysed, Refused, Pulled, Embedded, ShippedData, Rows,
              KnownDefRow, KnownTestRow, Published, embeds_wanted, module_embeds_wanted,
              known_def_row_bin, shipped_wants_of, rows_of, no_rows, rows_kept, rows_read, analyse,
              analyse_with, published, staged_pulling_std_with, analyse_pulling_std_with, of_module,
              ModuleFacts, ModuleShape, ModuleTables, Frame, TableReads, View, Outline,
              module_facts, no_shape, no_module_tables, module_shape_bin, tables_kept, tables_read,
              answered_program, answered_load, pulled_next, view_of, functions_of, tests_of,
              view_over, view_dump, faceted, dump_of, walked_facts_bin, squats, embedded_bin,
              shipped_data_bin, read_outline, named_imports, Outlined, OTest, OLaw, ShippedWants,
              shipped_wants_bin)
import items (Module, Item, IType, ILaw, ImportDecl, INames, header, parse, parse_started,
              import_decl_bin, homes_called, homes_declaring, is_written)
import derive (dotted)
import diagnostics (ParsedSource, parse_all, parse_at, parse_from, placed)
import interface (imported, blanked)
import embed (EmbedFile, EmbedRead, EmbedWant, ItemWants, embed_key, want_of_key, wants_by_item)
import pkg (PackageSources, Judged, judged, judged_bin, placeless, place_token, package_sources_bin)
import resolve (Source, ParsedModule, Diag, Label, backticked, diag_bin, error_at, import_binder,
                path_span, import_module_name, source_bin, qualify)
import parsing (Ident, Span, ParseDiag, ParseStart, span_bin, dummy_span, start)
import lexer (Token)
import infer (DefInfo, TestInfo, walk_order, Walks, Only)
import hash (Fixed, FixedTest, FixedLaw, Fixing, NodeRef, Shapes, Shape, no_fixing, module_forms,
             hashed_forms, fixing_bin, shapes_bin, fixed_bin, pin_key, joined_forms, body_key,
             checked_body)
import pages (Page, Pages, documented, pages_bin)
import std.gen

/// Where a module of the load's own packages is: its package (0 the root, then each dependency in
/// the order the load's packages list them) and its name there. Where its file is, is no part of it.
pub type Placing = { package: Int, relative: Bytes }

/// A module a query is asked of, by its name in the program, whether the toolchain ships it, and
/// whether a shipped one is read with its tests and laws, as a load of the standard library's own
/// tests reads it, rather than as a module that imports it reads it.
pub type Named = { module: Bytes, shipped: Bool, tested: Bool }

/// An entry a query is asked for: the module's, under `name`, or under every name for none.
pub type EntryNamed = { module: Bytes, shipped: Bool, tested: Bool, name: Bytes }

/// What an embed read: its files, or why it read none.
pub type Embedding = { files: List<{ name: Bytes, bytes: Bytes }>, refused: Option<Bytes> }

/// What a module answers checked: what it shows its importers, the errors that refuse it, the
/// warnings it holds, how many definitions and tests it checked, and the rows they published. A label points into the module
/// at module 0; one that pointed into a module it imports is left out.
pub type ModuleAnswer = {
  refused: List<Diag>,
  warnings: List<Diag>,
  defs: Int,
  tests: Int,
  /// What each of its definitions and tests published, as `rows_kept` keeps it: what an analysis of
  /// the whole program takes in place of checking them again.
  rows: Bytes,
  /// The modules its imports name that there are: a module whose import refused it may be refused
  /// for that alone.
  imports: List<Bytes>,
  /// What its check said of its shape, which every load assembled from its modules' answers reads.
  shape: ModuleShape,
  /// What its check said of its own declarations, as `tables_kept` keeps it: what a load reads
  /// only where its command reads the check's tables.
  tables: Bytes,
}

derive bin for Placing
derive bin for Named
derive bin for EntryNamed
derive bin for Embedding
derive bin for ModuleAnswer

// --- What the queries read of the world ------------------------------------------------------

/// The load's packages, which the root's manifest and its dependencies decide.
pub fn layout_kind() -> Bytes = b"layout"

/// Where a module of the load's own packages is, by its name; nothing for one they do not hold.
pub fn module_kind() -> Bytes = b"module"

/// A file's text, by its path.
pub fn text_kind() -> Bytes = b"text"

/// A shipped module's text, by its name; nothing for one the toolchain does not ship.
pub fn shipped_kind() -> Bytes = b"shipped"

/// Whether the toolchain ships a module, by its name: empty for one it ships, nothing for one it does
/// not. What a module that imports it reads to find it, so an edit to its text moves no importer.
pub fn shipped_there_kind() -> Bytes = b"shipped there"

/// A data file the shipped modules hold, by its name among them.
pub fn data_kind() -> Bytes = b"data"

/// What a module of the load's own packages embeds, by `embed_at`.
pub fn embed_kind() -> Bytes = b"embed"

/// The names of the shipped modules there are, which a module whose import names nothing lists.
pub fn shipped_names_kind() -> Bytes = b"shipped names"

/// What an embed of `module`, in the package at `root`, is read under.
pub fn embed_at(root: Bytes, module: Bytes, key: Bytes) -> Bytes =
  Bytes::concat_all([root, b"\x00", module, b"\x00", key])

/// What a run's queries have decoded of the answers they read, by each answer's digest: an answer
/// thousands of checks read is decoded for the first of them.
pub effect decode {
  /// The entries decoded of the answer `query` gave under `digest`, where a body held them.
  read entries(query: Bytes, digest: Bytes) -> Option<List<Entry>>
  /// Holds `entries` as what the answer `query` gave under `digest` decodes to.
  write hold_entries(query: Bytes, digest: Bytes, entries: List<Entry>) -> Unit
  /// The context decoded of the answer under `digest`, where a body held it.
  read context(digest: Bytes) -> Option<Context>
  /// Holds `context` as what the answer under `digest` decodes to.
  write hold_context(digest: Bytes, context: Context) -> Unit
  /// Holds `parse` as what the module `named` encodes the name of parses to, until it is taken.
  write hold_parse(named: Bytes, parse: ModuleParse) -> Unit
  /// What is held of the module `named` encodes the name of, which is then held no longer.
  write take_parse(named: Bytes) -> Option<ModuleParse>
}

/// A module's text parsed: as it is written, and as a check reads it, its derives expanded.
pub type ModuleParse = { raw: Module, given: ParsedSource }

/// What a query's body performs: it reads through `memo`, and holds what it decodes.
pub effect set Answering = {memo.read, decode.read, decode.write}

/// What a run of these queries over a store performs.
pub effect set Driving = {memo_keep.read, memo_keep.write, decode.read, decode.write}

/// A query of this module.
pub type CheckQuery = Query<| {decode.read, decode.write}>

/// `work` with what its queries decode held for as long as it runs.
pub fn decoding_once<a | e>(work: () -> a / {decode.read, decode.write | e}) -> a / e =
  handle {
    work()
  } with {
    var entries: Map<Bytes, List<Entry>> = Map::new(),
    var contexts: Map<Bytes, Context> = Map::new(),
    var parses: Map<Bytes, ModuleParse> = Map::new(),
    decode.entries(query, digest) -> entries.get(query.concat(digest)),
    decode.hold_entries(query, digest, es) -> {
      entries = entries.insert(query.concat(digest), es);
    },
    decode.context(digest) -> contexts.get(digest),
    decode.hold_context(digest, c) -> {
      contexts = contexts.insert(digest, c);
    },
    decode.hold_parse(named, p) -> {
      parses = parses.insert(named, p);
    },
    decode.take_parse(named) -> {
      let p = parses.get(named);
      if p != None {
        parses = parses.remove(named);
      };
      p
    },
  }

/// `source`, its parse begun as `s`, parsed: as it is written, and as a check reads it.
fn parsed(source: Source, s: ParseStart) -> ModuleParse / {abort.raise} = {
  let read = parse_started(s);
  { raw: read.node, given: parse_from(0, source, read) }
}

/// The parse of `source`, the text the module `named` names reads as: the one its read held, where
/// that was of this text, else a parse of it. It is held no longer: a run checks a module whole
/// once, and a parse is most of what a run would hold of a module.
fn parse_taken(named: Named, source: Source) -> ModuleParse / {decode.write, abort.raise} =
  match decode.take_parse(bin::encode(named, named_bin())) {
    Some(p) -> if p.given.src == source.src { p } else { parsed(source, start(source.src)) },
    None -> parsed(source, start(source.src)),
  }

/// The context of the module `named` names, decoded once a run.
fn context_once(named: Named) -> Context / {Answering, abort.raise} = {
  let input = bin::encode(named, named_bin());
  let digest = memo.head(context_query(), input);
  match decode.context(digest) {
    Some(c) -> c,
    None -> {
      let c = decoded(
        match memo.held(digest) { Some(b) -> b, None -> memo.ask(context_query(), input) },
        context_bin(),
        "a module's context",
      );
      decode.hold_context(digest, c);
      c
    },
  }
}

/// The entries the answer `query` gives for `input` holds, as `decoding` reads them of its bytes,
/// decoded once a run.
fn entries_once(
  query: Bytes,
  input: Bytes,
  decoding: (Bytes) -> List<Entry> / {abort.raise},
) -> List<Entry> / {Answering, abort.raise} = {
  let digest = memo.head(query, input);
  match decode.entries(query, digest) {
    Some(es) -> es,
    None -> {
      let es = decoding(match memo.held(digest) { Some(b) -> b, None -> memo.ask(query, input) });
      decode.hold_entries(query, digest, es);
      es
    },
  }
}

fn decoded<a>(b: Bytes, codec: bin::BinCodec<a>, what: String) -> a / {abort.raise} =
  match bin::decode(b, codec) {
    Ok(x) -> x,
    Err(e) -> panic("a query read " ++ what ++ " it cannot decode: " ++ e.message),
  }

fn placing_of(module: Bytes) -> Option<Placing> / {memo.read, abort.raise} =
  match memo.world(module_kind(), module) {
    Some(b) -> Some(decoded(b, placing_bin(), "a module's place")),
    None -> None,
  }

fn shipped_text(module: Bytes) -> Option<Bytes> / {memo.read} = memo.world(shipped_kind(), module)

fn shipped_there(module: Bytes) -> Bool / {memo.read} =
  memo.world(shipped_there_kind(), module) != None

/// The load's packages, judged and placeless: what their manifests say, never where they are.
fn layout() -> Judged / {memo.read, abort.raise} =
  match memo.world(layout_kind(), b"") {
    Some(b) -> decoded(b, judged_bin(), "the load's packages"),
    None -> no_packages(),
  }

fn no_packages() -> Judged = { packages: [], diags: [] }

/// What a load's staging reads of `j`'s packages, each at its place: the modules it holds are each
/// staging's own.
fn pkgs_of(j: Judged) -> PackageSources =
  {
    root: place_token(0),
    manifest: None,
    supplied: range(1, j.packages.len()).map(|k: Int|
      { root: place_token(k), manifest: None, modules: [] }),
  }

fn prefix_in(j: Judged, package: Int) -> Bytes =
  if package <= 0 { b"" } else { match j.packages.at(package) { Some(p) -> p.prefix, None -> b"" } }

// --- Imports --------------------------------------------------------------------------------

fn has_dot(name: Bytes) -> Bool = name.index_of(b".") != None

/// The module an import of `module`, which stands where `placed` says and is shipped as `shipped`
/// says, names, as the resolver finds it: a dependency's bare import names its own package's
/// module, a shipped compiler module's its sibling's, and any other the module of its name, the
/// load's own before a shipped one.
fn target_of(
  module: Bytes,
  shipped: Bool,
  prefix: Bytes,
  package: Int,
  d: ImportDecl,
) -> Named / {memo.read, abort.raise} = {
  let name = dotted(d);
  if shipped {
    let sibling = b"compiler.".concat(name);
    if module.starts_with(b"compiler.") && !has_dot(name) && shipped_there(sibling) {
      { module: sibling, shipped: true, tested: false }
    } else { { module: name, shipped: true, tested: false } }
  } else {
    let sibling = Bytes::concat_all([prefix, b".", name]);
    if package > 0 && prefix.len() > 0 && !has_dot(name) {
      { module: sibling, shipped: false, tested: false }
    } else if package > 0 && prefix.len() > 0 && placing_of(sibling) != None {
      { module: sibling, shipped: false, tested: false }
    } else if placing_of(name) != None { { module: name, shipped: false, tested: false } }
    else { { module: name, shipped: true, tested: false } }
  }
}

/// Whether the module of `name` that a module of the load's own packages reads is a shipped one.
fn shipped_for(asker_shipped: Bool, name: Bytes) -> Bool / {memo.read, abort.raise} =
  asker_shipped || placing_of(name) == None

fn entries_of(
  asker_shipped: Bool,
  module: Bytes,
  name: Bytes,
) -> List<Entry> / {Answering, abort.raise} =
  entries_once(
    entry_query(),
    bin::encode(
      { module: module, shipped: shipped_for(asker_shipped, module), tested: false, name: name },
      entry_named_bin(),
    ),
    |b: Bytes|
      decoded(b, bin::list_bin(bin::bytes_bin()), "entries").map(|e: Bytes|
        decoded(e, entry_bin(), "an entry")),
  )

fn entry_bytes_of(
  asker_shipped: Bool,
  module: Bytes,
  name: Bytes,
) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.ask(
      entry_query(),
      bin::encode(
        { module: module, shipped: shipped_for(asker_shipped, module), tested: false, name: name },
        entry_named_bin(),
      ),
    ),
    bin::list_bin(bin::bytes_bin()),
    "entries",
  )

// --- The queries ----------------------------------------------------------------------------

pub fn module_query() -> Bytes = b"module"

pub fn entry_query() -> Bytes = b"entry"

/// A module as a query reads it: its text, parsed alone and with its statements expanded, the
/// modules its imports name that there are, where it stands, and all else its check reads beside the
/// entries it names.
type ModuleRead = {
  source: Source,
  tokens: List<Token>,
  raw: Module,
  parsed: ParsedModule,
  names: List<Bytes>,
  present: List<Bytes>,
  placed: Placed,
  reading: Reading,
}

fn placed_by(p: Option<Placing>) -> Placed =
  match p {
    None -> ShippedModule,
    Some(x) -> if x.package == 0 { InRoot } else { InPackage(x.package, x.relative) },
  }

/// `module` as `asked` names it read, or nothing where there is no such module.
fn module_read(asked: Named) -> Option<ModuleRead> / {memo.read, decode.write, abort.raise} = {
  let module = asked.module;
  let shipped = asked.shipped;
  let placing = if shipped { None } else { placing_of(module) };
  // A shipped module is read as a module that imports it reads it, its tests and laws blanked, unless
  // it is asked after with them.
  let text = if shipped {
    match shipped_text(module) {
      Some(t) -> Some(if asked.tested { t } else { imported(t) }),
      None -> None,
    }
  } else { match placing { Some(_) -> memo.world(text_kind(), module), None -> None } };
  match text {
    None -> None,
    Some(src) -> {
      let source = { name: module, src: src };
      let lexed = start(src);
      let read = parsed(source, lexed);
      // Held for the check of the module whole, which follows its read where it is checked whole.
      decode.hold_parse(bin::encode(asked, named_bin()), read);
      let raw = read.raw;
      let given = read.given;
      let parsed = given.module;
      let j = if shipped { no_packages() } else { layout() };
      let pkgs = pkgs_of(j);
      let package = match placing { Some(p) -> p.package, None -> 0 - 1 };
      let prefix = prefix_in(j, package);
      let targets = raw.imports.map(|d: ImportDecl| target_of(module, shipped, prefix, package, d));
      let imported_there = targets.filter(|t: Named|
        if t.shipped { shipped_there(t.module) } else { placing_of(t.module) != None });
      let homes = homes_called(module, lexed.input, || homes_declaring(shipped_text)).filter(
        |h: Bytes| shipped_there(h) && !imported_there.any(|t: Named| t.module == h),
      );
      let present = imported_there;
      // An import that names nothing is refused with the shipped modules there are.
      let unread = if present.len() == targets.len() { [] } else {
        match memo.world(shipped_names_kind(), b"") {
          Some(b) -> decoded(b, bin::list_bin(bin::bytes_bin()), "the shipped modules' names"),
          None -> [],
        }
      };
      let root = place_token(if package < 0 { 0 } else { package });
      let embeds = if shipped { [] } else {
        module_embeds_wanted(root, source, raw).map(|e: Embedded| {
          let read = match memo.world(embed_kind(), embed_at(root, module, embed_key(e.want))) {
            None -> Err(b"no file is there"),
            Some(b) -> {
              let got = decoded(b, embedding_bin(), "an embed");
              match got.refused {
                Some(why) -> Err(why),
                None ->
                  Ok(
                    got.files.map(|f: { name: Bytes, bytes: Bytes }|
                      { name: f.name, bytes: f.bytes }),
                  ),
              }
            },
          };
          { ..e, read: read }
        })
      };
      let wants = if shipped { shipped_wants_of(source, raw) } else { { texts: [], data: [] } };
      let whole = wants.texts.fold([], |acc: List<Source>, n: Bytes|
        match shipped_text(n) { Some(t) -> acc.push({ name: n, src: t }), None -> acc });
      let data = wants.data.fold([], |acc: List<ShippedData>, n: Bytes|
        match memo.world(data_kind(), n) {
          Some(b) -> acc.push({ name: n, bytes: b }),
          None -> acc,
        });
      Some({
        source: source,
        tokens: lexed.input.tokens,
        raw: raw,
        parsed: parsed,
        names: targets.map(|t: Named| t.module),
        present: present.map(|t: Named| t.module).concat(homes),
        placed: placed_by(placing),
        reading: {
          pkgs: pkgs,
          judged: if shipped { None } else { Some(j) },
          tested: !shipped || asked.tested,
          unread: unread,
          whole: whole,
          data: data,
          embeds: embeds,
          given: [given],
        },
      })
    },
  }
}

/// Where each module of `modules` stands, as a module asked as `shipped` reads it.
fn places_of(shipped: Bool, modules: List<Bytes>) -> Map<Bytes, Placed> / {memo.read, abort.raise} =
  modules.fold(Map::new(), |acc: Map<Bytes, Placed>, m: Bytes|
    acc.insert(m, if shipped { ShippedModule } else { placed_by(placing_of(m)) }))

fn placing_in(places: Map<Bytes, Placed>) -> (Bytes) -> Placed / {abort.raise} =
  |m: Bytes| match places.get(m) { Some(x) -> x, None -> ShippedModule }

pub fn imports_query() -> Bytes = b"imports"

/// One import of a module: the module it names, and where in the module's text the name stands.
type ImportOf = { named: Named, span: Span }

type ImportsOf = { imports: List<ImportOf> }

derive bin for ImportOf
derive bin for ImportsOf

/// The modules a module's written imports name that there are, read as `Named` says: what the
/// order its load checks its modules in reads, off the module's header alone.
pub fn imports_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, named_bin(), "a module's name");
  let module = asked.module;
  let placing = if asked.shipped { None } else { placing_of(module) };
  let text = if asked.shipped { shipped_text(module) }
  else { match placing { Some(_) -> memo.world(text_kind(), module), None -> None } };
  bin::encode(
    {
      imports: match text {
        None -> [],
        Some(src) -> {
          let raw = match header(src) { Some(m) -> m, None -> parse(src).node };
          let package = match placing { Some(p) -> p.package, None -> 0 - 1 };
          let prefix = if asked.shipped { b"" } else { prefix_in(layout(), package) };
          raw.imports.fold([], |acc: List<ImportOf>, d: ImportDecl| {
            let t = target_of(module, asked.shipped, prefix, package, d);
            let there = if t.shipped { shipped_there(t.module) }
            else { placing_of(t.module) != None };
            if there { acc.push({ named: t, span: path_span(d) }) } else { acc }
          })
        },
      },
    },
    imports_of_bin(),
  )
}

fn absent(module: Bytes) -> ModuleAnswer / {abort.raise} =
  {
    refused: [],
    warnings: [],
    defs: 0,
    tests: 0,
    rows: rows_kept(no_rows()),
    imports: [],
    shape: no_shape(module),
    tables: tables_kept(no_module_tables()),
  }

/// What hashing a module fixed: each owner's hash entry, and each of its nodes, tests and laws,
/// which a load of the whole program takes in place of hashing them again. A module whose reading
/// refuses it fixes nothing.
pub type HashAnswer = { hashes: Hashes, owners: Map<Bytes, List<Bytes>>, fixing: Fixing }

derive bin for HashAnswer

// --- A module checked a group of owners at a time ------------------------------------------------
// A module is read once for its owners, what each mentions and the groups they check in. Each group
// is checked against the entries its members' text mentions, so an edit to one owner checks its
// group again, and a group that reads an entry checks again only where that entry moved. A module's
// answer and its hashing are its groups', put together.

/// An owner of a module: the module as `Named` reads it, and the owner by its name there.
pub type OwnerNamed = { module: Bytes, shipped: Bool, tested: Bool, owner: Bytes }

/// Owners of a module that check together, each by its name there, in the order of their names.
pub type GroupNamed = { module: Bytes, shipped: Bool, tested: Bool, owners: List<Bytes> }

/// What a check of a module reads of it beside its text: its imports placed nowhere, the module each
/// names, those of them there are, and its setting.
pub type Context = {
  imports: List<ImportDecl>,
  targets: List<Bytes>,
  present: List<Bytes>,
  setting: Setting,
}

/// What a check of any group of a module's owners reads of the module beside their own text and
/// imports: where the module stands, and what else its check reads.
pub type Setting = {
  placed: Placed,
  pkgs: PackageSources,
  judged: Option<Judged>,
  tested: Bool,
  unread: List<Bytes>,
  whole: List<Source>,
  data: List<ShippedData>,
  embeds: List<Embedded>,
}

/// One owner as a check of its group reads it: its own text, and what it mentions.
pub type OwnerFacts = { read: OwnerRead, mentions: List<Mention> }

/// A module read for its owners: whether there is such a module, its text, each owner's facts
/// encoded apart, where its items stand left out of them and beside them, in the order its first
/// item stands, the groups they check in, each after every
/// group it mentions, each owner's shape encoded as its facts are ([`signing_read`]) and the groups the
/// shapes sign in, the owners of each name it declares, what a check of any group reads of it
/// beside their text, its shape as its text alone says it, its functions in the order a check of it
/// walks them, and what a check of the whole of it reads of the modules it imports.
pub type OwnersAnswer = {
  found: Bool,
  text: Bytes,
  owners: List<{ owner: Bytes, facts: Bytes, starts: List<Int> }>,
  groups: List<List<Bytes>>,
  shapes: List<{ owner: Bytes, facts: Bytes }>,
  signing: List<List<Bytes>>,
  declared: Map<Bytes, List<Bytes>>,
  context: Context,
  shape: ModuleShape,
  order: List<Bytes>,
  wanted: List<Mention>,
  publishing: Map<Bytes, List<Mention>>,
  refusing: Bool,
}

/// What hashing fixed of a group of owners: each owner's hash entry, and each node, test and law.
pub type GroupHashes = { entries: Map<Bytes, HashEntry>, fixing: Fixing }

derive bin for OwnerNamed
derive bin for GroupNamed
derive bin for Setting
derive bin for Context
derive bin for OwnerFacts
derive bin for OwnersAnswer
derive bin for GroupHashes

pub fn owners_query() -> Bytes = b"owners"

pub fn owner_query() -> Bytes = b"owner"

pub fn unit_of_query() -> Bytes = b"unit of"

pub fn calls_query() -> Bytes = b"calls"

pub fn cycles_query() -> Bytes = b"cycles"

pub fn group_of_query() -> Bytes = b"group of"

pub fn shape_query() -> Bytes = b"shape"

pub fn sign_unit_query() -> Bytes = b"sign unit of"

pub fn context_query() -> Bytes = b"context"

pub fn setting_query() -> Bytes = b"setting"

pub fn group_imports_query() -> Bytes = b"group imports"

pub fn published_query() -> Bytes = b"published"

pub fn sees_query() -> Bytes = b"sees"

pub fn wants_query() -> Bytes = b"wants"

pub fn declared_query() -> Bytes = b"declared"

pub fn group_query() -> Bytes = b"group"

pub fn owner_entry_query() -> Bytes = b"owner entry"

pub fn shown_query() -> Bytes = b"shown"

pub fn signatures_query() -> Bytes = b"signatures"

pub fn signature_query() -> Bytes = b"signature"

pub fn signed_query() -> Bytes = b"signed"

pub fn typed_query() -> Bytes = b"typed"

pub fn group_hash_query() -> Bytes = b"group hash"

pub fn owner_hash_query() -> Bytes = b"owner hash"

fn module_named(o: OwnerNamed) -> Named = { module: o.module, shipped: o.shipped, tested: o.tested }

fn owners_read(named: Named) -> OwnersAnswer / {memo.read, abort.raise} =
  decoded(
    memo.ask(owners_query(), bin::encode(named, named_bin())),
    owners_answer_bin(),
    "a module's owners",
  )

fn no_context() -> Context =
  {
    imports: [],
    targets: [],
    present: [],
    setting: {
      placed: ShippedModule,
      pkgs: { root: b"", manifest: None, supplied: [] },
      judged: None,
      tested: false,
      unread: [],
      whole: [],
      data: [],
      embeds: [],
    },
  }

fn reading_of(c: Setting) -> Reading =
  {
    pkgs: c.pkgs,
    judged: c.judged,
    tested: c.tested,
    unread: c.unread,
    whole: c.whole,
    data: c.data,
    embeds: c.embeds,
    given: [],
  }

/// The modules `m`'s imports resolve to, hidden ones among them, each once: what a load reads of
/// what the module imports.
fn resolved_imports(m: ModuleRead) -> List<Bytes> =
  m.names.concat(m.parsed.module.imports.drop(m.raw.imports.len()).map(dotted)).fold(
    [],
    |acc: List<Bytes>, n: Bytes|
      if acc.contains(n) || (!m.present.contains(n) && m.names.contains(n)) { acc }
      else { acc.push(n) },
  )

/// A module read for its owners, read as `Named` says.
pub fn owners_answer(input: Bytes) -> Bytes / {memo.read, decode.write, abort.raise} = {
  let asked = decoded(input, named_bin(), "a module's name");
  let read = match module_read(asked) {
    None ->
      {
        found: false,
        text: b"",
        owners: [],
        groups: [],
        shapes: [],
        signing: [],
        declared: Map::new(),
        context: no_context(),
        shape: no_shape(asked.module),
        order: [],
        wanted: [],
        publishing: Map::new(),
        refusing: false,
      },
    Some(m) -> {
      let module = m.source.name;
      let scope = module_scope(m.parsed, m.raw, m.names);
      let reads = owner_reads(m.parsed, m.raw, m.source.src);
      let mentions = reads.fold(Map::new(), |acc: Map<Bytes, List<Mention>>, o: OwnerRead|
        acc.insert(
          o.owner,
          owner_mentions(module, scope, o, m.source.src, owner_tokens(m.tokens, o)),
        ));
      let imported = resolved_imports(m);
      let items = wants_by_item(m.parsed.module);
      let shapes = reads.map(|o: OwnerRead| signing_read(m.raw, o));
      let shape_mentions = range(0, reads.len()).fold(
        Map::new(),
        |acc: Map<Bytes, List<Mention>>, k: Int| {
          let o = reads.get(k);
          let lexed = signing_tokens(m.raw, m.tokens, o);
          acc.insert(o.owner, owner_mentions(module, scope, shapes.get(k), m.source.src, lexed))
        },
      );
      {
        found: true,
        text: m.source.src,
        owners: reads.map(|o: OwnerRead|
          {
            owner: o.owner,
            // Where its items stand is the module's to know: an edit above it moves nothing of it.
            facts: bin::encode(
              {
                read: { ..o, starts: o.starts.map(|_: Int| 0) },
                mentions: match mentions.get(o.owner) { Some(ms) -> ms, None -> [] },
              },
              owner_facts_bin(),
            ),
            starts: o.starts,
          }),
        groups: owner_groups(module, scope, reads.map(|o: OwnerRead| o.owner), mentions),
        shapes: shapes.map(|o: OwnerRead|
          {
            owner: o.owner,
            facts: bin::encode(
              {
                read: { ..o, starts: o.starts.map(|_: Int| 0) },
                mentions: match shape_mentions.get(o.owner) { Some(ms) -> ms, None -> [] },
              },
              owner_facts_bin(),
            ),
          }),
        signing: owner_groups(module, scope, reads.map(|o: OwnerRead| o.owner), shape_mentions),
        declared: scope.written.owners,
        context: {
          imports: unplaced_imports(m.raw),
          targets: m.names,
          present: m.present,
          setting: {
            placed: m.placed,
            pkgs: m.reading.pkgs,
            judged: m.reading.judged,
            tested: m.reading.tested,
            unread: m.reading.unread,
            whole: m.reading.whole,
            data: m.reading.data,
            embeds: m.reading.embeds,
          },
        },
        shape: {
          outline: {
            let o = read_outline(m.parsed);
            // A module read without its tests and laws outlines none, those its statements make among them.
            if m.reading.tested { o } else {
              {
                ..o,
                items: o.items.filter(|x: Outlined|
                  match x { OTest(_) -> false, OLaw(_) -> false, _ -> true }),
              }
            }
          },
          imports: imported,
          named: named_imports(m.parsed, imported),
          written: m.parsed.module.imports.map(import_module_name).concat(
            m.present.filter(|p: Bytes| !m.names.contains(p)),
          ),
          embeds: [],
          embed_items: if items.fold(false, |b: Bool, x: ItemWants| b || x.wants.len() > 0) {
            items
          } else { [] },
          tagged: [],
          statements: [],
          consts: [],
        },
        order: walk_order(m.parsed),
        wanted: wanted_in(m.parsed, m.raw, m.source.src, m.tokens, m.names),
        // What the module publishes for each `opaque` type is its whole text's to say: a check of
        // the type's group alone sees only the functions that group reads.
        publishing: m.parsed.module.items.fold(
          Map::new(),
          |acc: Map<Bytes, List<Mention>>, item: Item|
            match item {
              IType(d) -> match d.opaque {
                Some(op) ->
                  acc.insert(
                    d.name.name,
                    op.answer.concat(op.take).map(|f: Bytes| { module: module, name: f }),
                  ),
                None -> acc,
              },
              _ -> acc,
            },
        ),
        // Its text, or its imports alone: one naming no module there is, or two binding one name.
        refusing: m.reading.given.fold(false, |b: Bool, g: ParsedSource|
            b || g.diags.fold(false, |c: Bool, d: Diag| c || d.severity == b"error"))
          || m.present.len() < m.names.len()
          || colliding(m.raw.imports).len() > 0,
      }
    },
  };
  offered_projections(asked, read);
  bin::encode(read, owners_answer_bin())
}

/// One owner of a module, read as `OwnerNamed` says: its text and what it mentions; nothing for an
/// owner the module does not hold.
pub fn owner_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, owner_named_bin(), "an owner's name");
  let named = module_named(asked);
  let read = owners_head(named);
  match memo.offered() {
    Some(o) -> o,
    None -> {
      let r = owners_under(named, read);
      offered_owners(named, r, Some(asked.owner));
      owner_facts_in(r, asked.owner)
    },
  }
}

/// The modules a module can see beside itself, read as `Named` says: each it imports, directly
/// or through others, in the order of their names. A function of a type one of them declares, or
/// the module itself, is what a call on a value in it may call.
pub fn sees_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, named_bin(), "a module's name");
  let context = decoded(memo.ask(context_query(), input), context_bin(), "a module's context");
  let seen = context.present.fold(Map::new(), |acc: Map<Bytes, Bool>, m: Bytes|
    sees_of({ module: m, shipped: shipped_for(named.shipped, m), tested: false }).fold(
      acc.insert(m, true),
      |a: Map<Bytes, Bool>, below: Bytes| a.insert(below, true),
    ));
  bin::encode(seen.keys(), bin::list_bin(bin::bytes_bin()))
}

fn sees_of(named: Named) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.ask(sees_query(), bin::encode(named, named_bin())),
    bin::list_bin(bin::bytes_bin()),
    "the modules a module can see",
  )

pub fn answering_query() -> Bytes = b"answering"

/// The modules a module can see that declare a function of one of their types under a name, read
/// as `EntryNamed` says, in the order of their names: what a call of that name on a value in the
/// module may call beside the module's own. An import the module gains or loses moves it only
/// where one of those came or went.
pub fn answering_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, entry_named_bin(), "an entry's name");
  bin::encode(
    sees_of({ module: asked.module, shipped: asked.shipped, tested: asked.tested }).filter(
      |m: Bytes| declared_of(m, shipped_for(asked.shipped, m), false, of_any(asked.name)).len() > 0,
    ),
    bin::list_bin(bin::bytes_bin()),
  )
}

fn answering_of(named: Named, name: Bytes) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.ask(
      answering_query(),
      bin::encode(
        { module: named.module, shipped: named.shipped, tested: named.tested, name: name },
        entry_named_bin(),
      ),
    ),
    bin::list_bin(bin::bytes_bin()),
    "the modules that answer a name called on a value",
  )

/// What `called`, names a text of the module `named` names calls on a value, may call in the
/// modules it can see.
fn answered(named: Named, called: List<Bytes>) -> List<Mention> / {memo.read, abort.raise} =
  called.fold([], |acc: List<Mention>, n: Bytes| acc.concat(called_of(answering_of(named, n), [n])))

/// What a module publishes for an `opaque` type an owner of it declares, read as `OwnerNamed` says:
/// each function that answers one and each that takes one; none for any other owner.
pub fn published_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, owner_named_bin(), "an owner's name");
  let named = module_named(asked);
  let read = owners_head(named);
  match memo.offered() {
    Some(o) -> o,
    None -> {
      let r = owners_under(named, read);
      offered_published(named, r, Some(asked.owner));
      bin::encode(
        match r.publishing.get(asked.owner) { Some(ms) -> ms, None -> [] },
        bin::list_bin(mention_bin()),
      )
    },
  }
}

/// The group an owner of a module checks in, read as `OwnerNamed` says.
pub fn unit_of_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, owner_named_bin(), "an owner's name");
  let named = module_named(asked);
  let read = owners_head(named);
  match memo.offered() {
    Some(o) -> o,
    None -> {
      let r = owners_under(named, read);
      offered_units(named, r, Some(asked.owner));
      bin::encode(group_holding(r, asked.owner), bin::list_bin(bin::bytes_bin()))
    },
  }
}

/// The owners of its module an owner's walked bodies call, in the order of their names and itself
/// left out, read as `OwnerNamed` says: what its walk left, read for nothing else, so a body edited
/// without a call added or dropped answers as before.
pub fn calls_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, owner_named_bin(), "an owner's name");
  let named = module_named(asked);
  bin::encode(
    called_owners(
      asked.owner,
      owned::called_names(asked.module, walk_of(named, asked.owner)),
      |n: Bytes| declared_of(asked.module, asked.shipped, asked.tested, n),
    ),
    bin::list_bin(bin::bytes_bin()),
  )
}

/// The owners that declare `names`, as `declared` answers each name's, in the order of their
/// names and `owner` left out.
fn called_owners<| e>(
  owner: Bytes,
  names: List<Bytes>,
  declared: (Bytes) -> List<Bytes> / {abort.raise | e},
) -> List<Bytes> / {abort.raise | e} =
  sorted_bytes(
    names.fold([], |acc: List<Bytes>, n: Bytes|
      declared(n).fold(acc, |a: List<Bytes>, o: Bytes|
        if o == owner || a.contains(o) { a } else { a.push(o) })),
  )

fn calls_of(named: Named, owner: Bytes) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.ask(calls_query(), owner_at(named, owner)),
    bin::list_bin(bin::bytes_bin()),
    "what an owner calls",
  )

/// The groups of the unit `GroupNamed` names: its owners cut into those whose walked bodies call
/// one another round a cycle, each group after every group it calls. A unit of one owner is one
/// group; nothing for owners their module no longer holds as a unit.
pub fn cycles_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, group_named_bin(), "a unit's names");
  let named = { module: asked.module, shipped: asked.shipped, tested: asked.tested };
  bin::encode(
    if !current_unit(asked) { [] }
    else if asked.owners.len() < 2 { [asked.owners] }
    else { call_cycles(asked.owners, asked.owners.map(|o: Bytes| calls_of(named, o))) },
    bin::list_bin(bin::list_bin(bin::bytes_bin())),
  )
}

fn cycles_of(unit: GroupNamed) -> List<List<Bytes>> / {memo.read, abort.raise} =
  decoded(
    memo.ask(cycles_query(), bin::encode(unit, group_named_bin())),
    bin::list_bin(bin::list_bin(bin::bytes_bin())),
    "a unit's groups",
  )

/// The owners an owner of a module is checked with, itself among them, read as `OwnerNamed` says:
/// its unit where that is the owner alone, and otherwise the group of its unit that holds it.
pub fn group_of_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, owner_named_bin(), "an owner's name");
  let unit = unit_named_of(asked);
  bin::encode(
    if unit.owners.len() < 2 { unit.owners } else {
      cycles_of(unit).fold([], |acc: List<Bytes>, g: List<Bytes>|
        if g.contains(asked.owner) { g } else { acc })
    },
    bin::list_bin(bin::bytes_bin()),
  )
}

/// One owner of a module as a signing of it reads it, read as `OwnerNamed` says: its text with
/// each body cut and what that text mentions, encoded as an owner's facts are; nothing for an
/// owner the module does not hold.
pub fn shape_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, owner_named_bin(), "an owner's name");
  let named = module_named(asked);
  let read = owners_head(named);
  match memo.offered() {
    Some(o) -> o,
    None -> {
      let r = owners_under(named, read);
      offered_shapes(named, r, Some(asked.owner));
      shape_in(r, asked.owner)
    },
  }
}

/// The owners an owner of a module signs with, itself among them, read as `OwnerNamed` says: those
/// whose shapes mention one another round a cycle.
pub fn sign_unit_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, owner_named_bin(), "an owner's name");
  let named = module_named(asked);
  let read = owners_head(named);
  match memo.offered() {
    Some(o) -> o,
    None -> {
      let r = owners_under(named, read);
      offered_signing(named, r, Some(asked.owner));
      bin::encode(signing_with(r, asked.owner), bin::list_bin(bin::bytes_bin()))
    },
  }
}

/// What a check of any group of a module's owners reads of the module beside their text, read as
/// `Named` says.
pub fn context_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, named_bin(), "a module's name");
  let read = owners_head(named);
  match memo.offered() {
    Some(o) -> o,
    None -> bin::encode(owners_under(named, read).context, context_bin()),
  }
}

/// What a check of any group of a module's owners reads of the module beside their own text and
/// imports, read as `Named` says.
pub fn setting_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, named_bin(), "a module's name");
  let read = owners_head(named);
  match memo.offered() {
    Some(o) -> o,
    None -> bin::encode(owners_under(named, read).context.setting, setting_bin()),
  }
}

/// What a module embeds of the shipped modules, read as `Named` says: what a load ships beside the
/// shipped modules it pulls, read off the module's setting rather than its text.
pub fn wants_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let setting = decoded(memo.ask(setting_query(), input), setting_bin(), "a module's setting");
  bin::encode(
    {
      texts: setting.whole.map(|s: Source| s.name),
      data: setting.data.map(|d: ShippedData| d.name),
    },
    shipped_wants_bin(),
  )
}

/// What a group of a module's owners reads of the module's imports, read as `GroupNamed` says.
pub fn group_imports_answer(input: Bytes) -> Bytes / {Answering, abort.raise} = {
  let asked = decoded(input, group_named_bin(), "a group's names");
  if !current(asked) { bin::encode([], bin::list_bin(imported_bin())) } else {
    let named = { module: asked.module, shipped: asked.shipped, tested: asked.tested };
    let context = context_once(named);
    let members = asked.owners.map(|o: Bytes| owner_facts(named, o));
    bin::encode(
      group_imports(
        asked.module,
        members.map(|f: OwnerFacts| f.read),
        members.fold([], |acc: List<Mention>, f: OwnerFacts| acc.concat(f.mentions)),
        context.imports,
        context.targets,
      ),
      bin::list_bin(imported_bin()),
    )
  }
}

/// The owners of a name a module declares, read as `EntryNamed` says: every owner for none.
pub fn declared_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, entry_named_bin(), "an entry's name");
  let named = { module: asked.module, shipped: asked.shipped, tested: asked.tested };
  let read = owners_head(named);
  match memo.offered() {
    Some(o) -> o,
    // A call on a value asks this of every module it can see, most of which declare nothing so
    // named: that is read off the module's names, not its whole read.
    None -> if asked.name != b"" && !names_of(named).contains(asked.name) {
      bin::encode([], bin::list_bin(bin::bytes_bin()))
    } else {
      let r = owners_under(named, read);
      offered_declared(named, r, Some(asked.name));
      bin::encode(declared_in(r, asked.name), bin::list_bin(bin::bytes_bin()))
    },
  }
}

pub fn names_query() -> Bytes = b"names"

/// The names a module declares an owner under, read as `Named` says, in their order.
pub fn names_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, named_bin(), "a module's name");
  let read = owners_head(named);
  match memo.offered() {
    Some(o) -> o,
    None -> bin::encode(owners_under(named, read).declared.keys(), bin::list_bin(bin::bytes_bin())),
  }
}

fn names_of(named: Named) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.ask(names_query(), bin::encode(named, named_bin())),
    bin::list_bin(bin::bytes_bin()),
    "the names a module declares",
  )

/// The digest of a module read for its owners as `named` says: the read a projection of it makes. A
/// projection the read offered is taken whole, so the read's own bytes are fetched only for one it
/// did not ([`owners_under`]).
fn owners_head(named: Named) -> Bytes / {memo.read, abort.raise} =
  memo.head(owners_query(), bin::encode(named, named_bin()))

/// The module read for its owners as `named` says, which [`owners_head`] answered `digest` for.
fn owners_under(named: Named, digest: Bytes) -> OwnersAnswer / {memo.read, abort.raise} =
  owners_of(match memo.held(digest) { Some(b) -> b, None -> owners_asked(named) })

fn owners_asked(named: Named) -> Bytes / {memo.read, abort.raise} =
  memo.ask(owners_query(), bin::encode(named, named_bin()))

fn owners_of(b: Bytes) -> OwnersAnswer / {abort.raise} =
  decoded(b, owners_answer_bin(), "a module's owners")

fn owner_facts_in(read: OwnersAnswer, owner: Bytes) -> Bytes =
  read.owners.fold(b"", |acc: Bytes, o: { owner: Bytes, facts: Bytes, starts: List<Int> }|
    if o.owner == owner { o.facts } else { acc })

fn group_holding(read: OwnersAnswer, owner: Bytes) -> List<Bytes> =
  read.groups.fold([], |acc: List<Bytes>, g: List<Bytes>| if g.contains(owner) { g } else { acc })

fn shape_in(read: OwnersAnswer, owner: Bytes) -> Bytes =
  read.shapes.fold(b"", |acc: Bytes, o: { owner: Bytes, facts: Bytes }|
    if o.owner == owner { o.facts } else { acc })

fn signing_with(read: OwnersAnswer, owner: Bytes) -> List<Bytes> =
  read.signing.fold([], |acc: List<Bytes>, g: List<Bytes>| if g.contains(owner) { g } else { acc })

fn declared_in(read: OwnersAnswer, name: Bytes) -> List<Bytes> =
  if name == b"" { read.owners.map(|o: { owner: Bytes, facts: Bytes, starts: List<Int> }| o.owner) }
  else { match read.declared.get(name) { Some(os) -> os, None -> [] } }

/// Offers what each projection of `read`, a module read for its owners as `named` says, answers:
/// what a run that read the module again asks of each owner and name of it is then taken, not
/// decoded out of the whole read.
fn offered_projections(named: Named, read: OwnersAnswer) -> Unit / {memo.read, abort.raise} = {
  memo.offer(
    context_query(),
    bin::encode(named, named_bin()),
    bin::encode(read.context, context_bin()),
  );
  memo.offer(
    setting_query(),
    bin::encode(named, named_bin()),
    bin::encode(read.context.setting, setting_bin()),
  );
  memo.offer(
    names_query(),
    bin::encode(named, named_bin()),
    bin::encode(read.declared.keys(), bin::list_bin(bin::bytes_bin())),
  );
  offered_published(named, read, None);
  offered_owners(named, read, None);
  offered_units(named, read, None);
  offered_shapes(named, read, None);
  offered_signing(named, read, None);
  offered_declared(named, read, None)
}

fn owner_at(named: Named, owner: Bytes) -> Bytes / {abort.raise} =
  bin::encode(
    { module: named.module, shipped: named.shipped, tested: named.tested, owner: owner },
    owner_named_bin(),
  )

/// Offers what the `published` projection of `read`, a module read as `named` says, answers for
/// each owner but `except`: a projection that decoded the whole read leaves the rest to be taken.
fn offered_published(
  named: Named,
  read: OwnersAnswer,
  except: Option<Bytes>,
) -> Unit / {memo.read, abort.raise} =
  read.publishing.fold((), |_: Unit, owner: Bytes, ms: List<Mention>|
    if except == Some(owner) { () } else {
      memo.offer(
        published_query(),
        owner_at(named, owner),
        bin::encode(ms, bin::list_bin(mention_bin())),
      )
    })

/// [`offered_published`] for the `owner` projection.
fn offered_owners(
  named: Named,
  read: OwnersAnswer,
  except: Option<Bytes>,
) -> Unit / {memo.read, abort.raise} =
  read.owners.fold((), |_: Unit, o: { owner: Bytes, facts: Bytes, starts: List<Int> }|
    if except == Some(o.owner) { () }
    else { memo.offer(owner_query(), owner_at(named, o.owner), o.facts) })

/// [`offered_published`] for the `unit of` projection.
fn offered_units(
  named: Named,
  read: OwnersAnswer,
  except: Option<Bytes>,
) -> Unit / {memo.read, abort.raise} =
  read.owners.fold((), |_: Unit, o: { owner: Bytes, facts: Bytes, starts: List<Int> }|
    if except == Some(o.owner) { () } else {
      memo.offer(
        unit_of_query(),
        owner_at(named, o.owner),
        bin::encode(group_holding(read, o.owner), bin::list_bin(bin::bytes_bin())),
      )
    })

/// [`offered_published`] for the `shape` projection.
fn offered_shapes(
  named: Named,
  read: OwnersAnswer,
  except: Option<Bytes>,
) -> Unit / {memo.read, abort.raise} =
  read.shapes.fold((), |_: Unit, o: { owner: Bytes, facts: Bytes }|
    if except == Some(o.owner) { () }
    else { memo.offer(shape_query(), owner_at(named, o.owner), o.facts) })

/// [`offered_published`] for the `sign unit of` projection.
fn offered_signing(
  named: Named,
  read: OwnersAnswer,
  except: Option<Bytes>,
) -> Unit / {memo.read, abort.raise} =
  read.shapes.fold((), |_: Unit, o: { owner: Bytes, facts: Bytes }|
    if except == Some(o.owner) { () } else {
      memo.offer(
        sign_unit_query(),
        owner_at(named, o.owner),
        bin::encode(signing_with(read, o.owner), bin::list_bin(bin::bytes_bin())),
      )
    })

/// [`offered_published`] for the `declared` projection: each name the module declares, and every
/// owner under the empty name.
fn offered_declared(
  named: Named,
  read: OwnersAnswer,
  except: Option<Bytes>,
) -> Unit / {memo.read, abort.raise} =
  read.declared.keys().push(b"").fold((), |_: Unit, name: Bytes|
    if except == Some(name) { () } else {
      memo.offer(
        declared_query(),
        bin::encode(
          { module: named.module, shipped: named.shipped, tested: named.tested, name: name },
          entry_named_bin(),
        ),
        bin::encode(declared_in(read, name), bin::list_bin(bin::bytes_bin())),
      )
    })

fn declared_of(
  module: Bytes,
  shipped: Bool,
  tested: Bool,
  name: Bytes,
) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.ask(
      declared_query(),
      bin::encode(
        { module: module, shipped: shipped, tested: tested, name: name },
        entry_named_bin(),
      ),
    ),
    bin::list_bin(bin::bytes_bin()),
    "a name's owners",
  )

fn owner_facts(named: Named, owner: Bytes) -> OwnerFacts / {memo.read, abort.raise} =
  decoded(
    memo.ask(
      owner_query(),
      bin::encode(
        { module: named.module, shipped: named.shipped, tested: named.tested, owner: owner },
        owner_named_bin(),
      ),
    ),
    owner_facts_bin(),
    "an owner's facts",
  )

/// The group of owners `asked` names checked, beside where its items stand as [`group_source`] lays
/// them: what a check of their own text alone against the entries it mentions answers, or what a
/// check of their whole module offered for it. A group of one owner is walked and settled in one
/// check. One of several is a unit: each owner is walked alone ([`typed_answer_of`]) and the unit
/// settled from what those walks left, so an edit to one body walks one owner.
pub fn group_answer_of(input: Bytes) -> Bytes / {Answering, abort.raise} = {
  let asked = decoded(input, group_named_bin(), "a group's names");
  if !current(asked) { owned::group_kept(owned::no_group()) } else {
    let named = { module: asked.module, shipped: asked.shipped, tested: asked.tested };
    let alone = unit_named_of({
        module: asked.module,
        shipped: asked.shipped,
        tested: asked.tested,
        owner: asked.owners.at_or(0, b""),
      }).owners.len(
      )
      < 2;
    match taken_whole(asked) {
      Some(o) -> {
        reads_of(
          named,
          asked.owners,
          asked.owners.fold([], |acc: List<Mention>, x: Bytes|
            acc.concat(owner_facts(named, x).mentions)),
          imports_of(asked),
          // A unit's group stands on its members' walks, which take what the same check offered.
          if alone { entire } else { beside(called_by(named, asked)) },
        );
        o
      },
      None -> {
        let members = asked.owners.map(|o: Bytes| owner_facts(named, o));
        match refused_sibling(asked, members) {
          Some(o) -> owned::group_kept(waiting(asked, o)),
          None -> if alone {
            let answer = cut_of(
              asked.module,
              unit_checked(named, members, imports_of(asked), entire, no_bodies),
            );
            offered_forms(group_query(), asked, members.map(|f: OwnerFacts| f.read), answer);
            owned::group_kept(answer)
          } else { owned::group_kept(group_settled(named, asked, members)) },
        }
      },
    }
  }
}

/// An owner of `asked`'s module outside its unit, which a member mentions, whose group refuses and
/// so shows no entry. A check against the module without it would refuse too, and its module's
/// answer says what a check of it whole says whenever a group refuses.
fn refused_sibling(
  asked: GroupNamed,
  members: List<OwnerFacts>,
) -> Option<Bytes> / {Answering, abort.raise} = {
  let at = |o: Bytes|
    { module: asked.module, shipped: asked.shipped, tested: asked.tested, owner: o };
  let unit = unit_named_of(at(asked.owners.at_or(0, b""))).owners;
  members.fold([], |acc: List<Mention>, f: OwnerFacts| acc.concat(f.mentions)).fold(
    None,
    |found: Option<Bytes>, m: Mention|
      match found {
        Some(_) -> found,
        None -> if m.module != asked.module && m.module != b"" { None } else {
          declared_of(asked.module, asked.shipped, asked.tested, m.name).find(|o: Bytes|
            !unit.contains(o) && (match owner_entry_of(at(o)) { Some(_) -> false, None -> true }))
        },
      },
  )
}

/// What a group answers that waits on `owner`, whose group refuses: no member's entry, and a
/// refusal its module's answer takes the whole check's place of, unchecked.
fn waiting(asked: GroupNamed, owner: Bytes) -> owned::GroupAnswer / {abort.raise} =
  {
    ..owned::no_group(),
    refused: [
      error_at(
        b"E0505",
        0,
        dummy_span(),
        Bytes::concat_all([
          backticked(asked.owners, b", "),
          b" waits on `",
          owner,
          b"`, which does not check, and a check of `",
          asked.module,
          b"` whole refuses nothing",
        ]),
        b"the check was put off",
        [b"this is Ply's fault, not the program's"],
      ),
    ],
  }

/// How a check reads an owner of its module that is none of its members: by the entry it shows
/// any reader; by that entry less its rows, as its signing shows it, which waits on no body; or by
/// the entry its group's record shows, which carries no digest of what it reaches.
type Sibling = | Entire | Signed | Settled

fn entire(_: Bytes) -> Sibling = Entire

fn signed(_: Bytes) -> Sibling = Signed

/// A check of some owners of a module, and its source.
type UnitCheck = { reads: List<OwnerRead>, source: OwnerSource, out: { pulled: Pulled, at: Int } }

/// What a check hands itself of its bodies, given its source: nothing where it walks every one.
type Handing = (OwnerSource) -> Option<(Int) -> Walks / {abort.raise}> / {abort.raise}

fn no_bodies(_: OwnerSource) -> Option<(Int) -> Walks / {abort.raise}> = None

/// A check that walks the functions `walked` names and no other, and settles nothing.
fn walking(walked: List<Bytes>) -> Handing = |_: OwnerSource| Some(|_: Int| Only(walked))

/// `members`, owners of the module `named` names, checked together through the imports `imported`
/// against what they read, and again with what the modules of `opaque` types publish where that
/// refuses, which only says why a use of one is refused. `sibling` says how each other owner of
/// the module is read, and `handing` is what the check is handed of its bodies.
fn unit_checked(
  named: Named,
  members: List<OwnerFacts>,
  imported: List<Imported>,
  sibling: (Bytes) -> Sibling,
  handing: Handing,
) -> UnitCheck / {Answering, abort.raise} = {
  let checked_of = |published: Bool| {
    let c = owners_check(named, members, imported, published, sibling);
    let source = group_source_from(named.module, c.reads, c.imported, c.needed);
    {
      reads: c.reads,
      source: source,
      out: checked_owner(
        source,
        c.setting.placed,
        placing_in(c.places),
        reading_of(c.setting),
        walks: handing(source),
      ),
    }
  };
  let first = checked_of(false);
  match first.out.pulled.out { Analysed(_) -> first, Refused(_) -> checked_of(true) }
}

/// What `c` answered of the owners of `module` it checked, each place counted from where their own
/// text starts.
fn cut_of(module: Bytes, c: UnitCheck) -> owned::GroupAnswer / {abort.raise} =
  owned::group_answer(
    c.out.pulled.out,
    c.out.at,
    c.source.source.src,
    module,
    c.reads,
    c.source.items,
    |x: ItemAt| c.source.offset + x.from,
  )

fn imports_of(asked: GroupNamed) -> List<Imported> / {memo.read, abort.raise} =
  decoded(
    memo.ask(group_imports_query(), bin::encode(asked, group_named_bin())),
    bin::list_bin(imported_bin()),
    "a group's imports",
  )

/// The owners of its module, itself left out, that the group `asked` calls: what its members'
/// walks left.
fn called_by(named: Named, asked: GroupNamed) -> List<Bytes> / {memo.read, abort.raise} =
  asked.owners.fold([], |acc: List<Bytes>, o: Bytes|
    calls_of(named, o).fold(acc, |a: List<Bytes>, c: Bytes|
      if asked.owners.contains(c) || a.contains(c) { a } else { a.push(c) }))

/// How a group that calls `called` reads each other owner of its module: one it calls by what
/// that owner's group settled, which its own settling reads, and any other by its signature.
fn beside(called: List<Bytes>) -> (Bytes) -> Sibling =
  |o: Bytes| if called.contains(o) { Settled } else { Signed }

/// A group of a unit of several owners settled: each member's walk, any of which refusing refuses
/// the group with what every walk refused; then a check of the group's text that is handed those
/// bodies and walks none, whose answer takes from each walk what only a walk makes.
fn group_settled(
  named: Named,
  asked: GroupNamed,
  members: List<OwnerFacts>,
) -> owned::GroupAnswer / {Answering, abort.raise} = {
  let walked = asked.owners.map(|o: Bytes| { owner: o, typed: walk_of(named, o) });
  let refused = owned::walk_refusals(walked, laid_items(members.map(|f: OwnerFacts| f.read)));
  if refused.len() > 0 { { ..owned::no_group(), refused: refused } } else {
    let c = unit_checked(
      named,
      members,
      imports_of(asked),
      beside(called_by(named, asked)),
      |source: OwnerSource| Some(owned::handed_bodies(walked, source.items, source.offset)),
    );
    owned::settled_answer(cut_of(asked.module, c), walked, c.source.items)
  }
}

fn walk_of(named: Named, owner: Bytes) -> owned::TypedAnswer / {memo.read, abort.raise} =
  decoded(
    memo.ask(
      typed_query(),
      bin::encode(
        { module: named.module, shipped: named.shipped, tested: named.tested, owner: owner },
        owner_named_bin(),
      ),
    ),
    owned::typed_answer_bin(),
    "an owner's walk",
  )

/// What each owner of the sign unit `asked` names shows what reads it, less the rows its settling
/// answers: its entry as a check of the unit's shapes cuts it, which binds each function by its
/// signature and walks none, or as a check of its whole module offered it. It reads no body, so an
/// edit to one leaves it standing. Nothing for owners their module no longer signs together.
pub fn signatures_answer(input: Bytes) -> Bytes / {Answering, abort.raise} = {
  let asked = decoded(input, group_named_bin(), "a sign unit's names");
  if !signing(asked) { bin::encode({ shown: [], refused: [] }, owned::signed_unit_bin()) } else {
    let named = { module: asked.module, shipped: asked.shipped, tested: asked.tested };
    let offered = taken_whole(asked);
    let members = asked.owners.map(|o: Bytes| shape_of(named, o));
    let context = context_once(named);
    let imported = group_imports(
      asked.module,
      members.map(|f: OwnerFacts| f.read),
      members.fold([], |acc: List<Mention>, f: OwnerFacts| acc.concat(f.mentions)),
      context.imports,
      context.targets,
    );
    match offered {
      Some(o) -> {
        reads_of(
          named,
          asked.owners,
          members.fold([], |acc: List<Mention>, f: OwnerFacts| acc.concat(f.mentions)),
          imported,
          signed,
        );
        o
      },
      None ->
        bin::encode(
          owned::signed_unit(
            cut_of(asked.module, unit_checked(named, members, imported, signed, walking([]))),
          ),
          owned::signed_unit_bin(),
        ),
    }
  }
}

/// Whether `g` names owners their module signs together.
fn signing(g: GroupNamed) -> Bool / {memo.read, abort.raise} =
  match g.owners {
    [] -> false,
    [o, ..] ->
      sign_unit_of({ module: g.module, shipped: g.shipped, tested: g.tested, owner: o }).owners
        == g.owners,
  }

fn sign_unit_of(o: OwnerNamed) -> GroupNamed / {memo.read, abort.raise} =
  {
    module: o.module,
    shipped: o.shipped,
    tested: o.tested,
    owners: decoded(
      memo.ask(sign_unit_query(), bin::encode(o, owner_named_bin())),
      bin::list_bin(bin::bytes_bin()),
      "an owner's sign unit",
    ),
  }

fn shape_of(named: Named, owner: Bytes) -> OwnerFacts / {memo.read, abort.raise} =
  decoded(memo.ask(shape_query(), owner_at(named, owner)), owner_facts_bin(), "an owner's shape")

/// The entry an owner shows a walk of another owner of its module, read as `OwnerNamed` says: what
/// it shows any reader, less its rows, with the digest of all that reaches. Empty for an owner whose
/// signing refuses.
pub fn signature_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, owner_named_bin(), "an owner's name");
  let alone = memo.ask(signed_query(), input);
  if alone.len() == 0 { b"" } else {
    reaching(alone, reach_of(asked, sign_unit_of(asked), alone, signed_query(), signature_query()))
  }
}

/// The entry an owner's signing shows, read as `OwnerNamed` says, with no digest of what it
/// reaches: empty for an owner whose signing refuses.
pub fn signed_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, owner_named_bin(), "an owner's name");
  match owned::group_shown(
      memo.ask(signatures_query(), bin::encode(sign_unit_of(asked), group_named_bin())),
    ).get(
      asked.owner,
    ) {
    Some(entry) -> entry,
    None -> b"",
  }
}

/// What a walk of one owner of a unit answers, read as `OwnerNamed` says: its own text checked
/// against what the signature of each other owner of its module shows and the entries of whatever
/// else it mentions, its functions walked and nothing settled; or what a check of its whole module
/// offered for it. It reads no other owner's body and nothing of which owners check together.
/// Nothing for an owner that is the whole of its group, which that group's check walks.
pub fn typed_answer_of(input: Bytes) -> Bytes / {Answering, abort.raise} = {
  let asked = decoded(input, owner_named_bin(), "an owner's name");
  let named = module_named(asked);
  let g = unit_named_of(asked);
  if g.owners.len() < 2 { bin::encode(owned::no_typed(), owned::typed_answer_bin()) } else {
    let offered = taken_whole(g);
    let facts = owner_facts(named, asked.owner);
    let context = context_once(named);
    let imported = group_imports(
      asked.module,
      [facts.read],
      facts.mentions,
      context.imports,
      context.targets,
    );
    match offered {
      Some(o) -> {
        reads_of(named, [asked.owner], facts.mentions, imported, signed);
        o
      },
      None -> {
        let c = unit_checked(
          named,
          [facts],
          imported,
          signed,
          walking(facts.read.names.map(|n: Bytes| qualify(asked.module, n))),
        );
        bin::encode(
          owned::typed_answer(
            c.out.pulled.out,
            c.out.at,
            c.source.source.src,
            asked.module,
            facts.read,
            c.source.items,
            |x: ItemAt| c.source.offset + x.from,
          ),
          owned::typed_answer_bin(),
        )
      },
    }
  }
}

/// What a check of the whole module offered for the group `asked`, where it offered one. Every
/// group asks `whole` of its module first, so a run settling marks decides for the module, with
/// each entry it names settled, before it reaches any group of it.
fn taken_whole(asked: GroupNamed) -> Option<Bytes> / {memo.read, abort.raise} = {
  memo.head(
    whole_query(),
    bin::encode(
      { module: asked.module, shipped: asked.shipped, tested: asked.tested },
      named_bin(),
    ),
  );
  memo.offered()
}

pub fn whole_query() -> Bytes = b"whole"

/// Nothing, read as `Named` says, once a check of the module whole has offered each of its groups
/// what it answers, where enough of them must be checked again ([`whole_pays`]): what that check
/// reads is this record's, not any group's, and what it answers moves nothing that reads it. It
/// reads each entry the module names of the modules it imports whether it checks or not, so it is
/// asked again whenever a group of the module may be.
pub fn whole_answer(input: Bytes) -> Bytes / {Answering, abort.raise} = {
  let named = decoded(input, named_bin(), "a module's name");
  let read = owners_read(named);
  if read.found {
    let called = read.wanted.fold([], |acc: List<Bytes>, m: Mention|
      if m.module == b"" { acc.push(m.name) } else { acc });
    let seen = answered(named, called);
    read.wanted.concat(seen).fold((), |_: Unit, m: Mention|
      if m.module == b"" { () } else {
        memo.head(
          entry_query(),
          bin::encode(
            {
              module: m.module,
              shipped: shipped_for(named.shipped, m.module),
              tested: false,
              name: m.name,
            },
            entry_named_bin(),
          ),
        );
        ()
      });
    offered_whole(named, read, groups_named(named, read), false);
    ()
  };
  b""
}

/// What a check of `owners` of the module `named` names stands on, read without checking them: what
/// a record a check of the whole module offered reads. `mentions` is what their texts mention and
/// `imported` what they read through, and `sibling` says how each other owner of the module is
/// read. Each entry it names carries the digest of all the entry reaches, so the entries those
/// name are not read.
fn reads_of(
  named: Named,
  owners: List<Bytes>,
  mentions: List<Mention>,
  imported: List<Imported>,
  sibling: (Bytes) -> Sibling,
) -> Unit / {memo.read, abort.raise} = {
  memo.ask(setting_query(), bin::encode(named, named_bin()));
  let targets = imported.map(|x: Imported| x.target).push(named.module);
  let selected = imported.fold([], |acc: List<Mention>, x: Imported|
    match x.decl.kind {
      INames(ns) -> acc.concat(ns.map(|n: Ident| { module: x.target, name: n.name })),
      _ -> acc,
    });
  let written = selected.concat(mentions);
  // What the owners call on a value they read of every module their own can see.
  let called = written.fold([], |acc: List<Bytes>, m: Mention|
    if m.module == b"" && !acc.contains(m.name) { acc.push(m.name) } else { acc });
  let all = written.concat(answered(named, called));
  let modules = all.fold(Map::new(), |acc: Map<Bytes, Bool>, m: Mention|
    if m.module == b"" { acc } else if m.module == named.module {
      if !owners.contains(m.name) {
        declared_of(m.module, named.shipped, named.tested, m.name).fold((), |_: Unit, o: Bytes|
          if !owners.contains(o) { sibling_read(named, o, sibling(o)) })
      };
      acc
    } else {
      let found = entry_bytes_of(named.shipped, m.module, m.name);
      // A name a module could declare for the functions of its types says nothing of whether
      // the module is there.
      if found.len() == 0 && !targets.contains(m.module) && !m.name.starts_with(b"::") {
        entry_bytes_of(named.shipped, m.module, b"");
        ()
      };
      if found.len() == 0 && m.name.starts_with(b"::") { acc } else { acc.insert(m.module, true) }
    });
  places_of(named.shipped, modules.keys());
  ()
}

/// Another owner of the module `named` names, read as `how` says for what it shows and all that
/// reaches. What its group settled carries no digest of what it reaches; its signature does.
fn sibling_read(named: Named, owner: Bytes, how: Sibling) -> Unit / {memo.read, abort.raise} = {
  let at = bin::encode(
    { module: named.module, shipped: named.shipped, tested: named.tested, owner: owner },
    owner_named_bin(),
  );
  match how {
    Entire -> memo.head(owner_entry_query(), at),
    Signed -> memo.head(signature_query(), at),
    Settled -> {
      memo.head(shown_query(), at);
      memo.head(signature_query(), at)
    },
  };
  ()
}

/// What a check of a group of owners reads: the entries it needs, by module and owner, where each
/// module it reads stands, what else it reads of its module, and its members as their module writes
/// them.
type GroupCheck = {
  needed: Map<Bytes, Map<Bytes, Entry>>,
  imported: List<Imported>,
  places: Map<Bytes, Placed>,
  setting: Setting,
  reads: List<OwnerRead>,
}

/// What a check of `members`, owners of the module `named` names, together reads through the
/// imports `imported`, with what the modules of `opaque` types it names publish for them where
/// `published` says: what a check that refuses follows to say why.
fn owners_check(
  named: Named,
  members: List<OwnerFacts>,
  imported: List<Imported>,
  published: Bool,
  sibling: (Bytes) -> Sibling,
) -> GroupCheck / {Answering, abort.raise} = {
  let asked = {
    module: named.module,
    shipped: named.shipped,
    tested: named.tested,
    owners: members.map(|f: OwnerFacts| f.read.owner),
  };
  let setting = decoded(
    memo.ask(setting_query(), bin::encode(named, named_bin())),
    setting_bin(),
    "a module's setting",
  );
  let reads = members.map(|f: OwnerFacts| f.read);
  // A name a member declares is read as the group's own text writes it; any other owner declaring
  // it, by its own entry.
  let entries = |module: Bytes, n: Bytes|
    if module == asked.module {
      declared_of(module, asked.shipped, asked.tested, n).fold([], |acc: List<Entry>, o: Bytes|
        if asked.owners.contains(o) { acc } else {
          let at_o = { module: module, shipped: asked.shipped, tested: asked.tested, owner: o };
          match match sibling(o) {
              Entire -> owner_entry_of(at_o),
              Signed -> signature_of(at_o),
              Settled -> shown_of(at_o),
            } {
            Some(e) -> acc.push(e),
            None -> acc,
          }
        })
    } else { entries_of(asked.shipped, module, n) };
  let needed = group_needs(
    asked.module,
    reads,
    members.fold([], |acc: List<Mention>, f: OwnerFacts| acc.concat(f.mentions)),
    imported,
    entries,
    head_of,
    |module: Bytes, owner: Bytes|
      if !published || module == asked.module { [] }
      else { published_for(asked.shipped, asked.module, module, owner) },
    |n: Bytes| answering_of(named, n),
  );
  {
    needed: needed,
    imported: imported,
    places: places_of(asked.shipped, needed.keys().filter(|m: Bytes| m != asked.module)),
    setting: setting,
    reads: reads,
  }
}

/// Whether `g` names a group its module checks together: a record kept for a group an edit split,
/// merged or emptied is settled without checking it.
fn current(g: GroupNamed) -> Bool / {memo.read, abort.raise} =
  match g.owners {
    [] -> false,
    [o, ..] ->
      group_named_of({ module: g.module, shipped: g.shipped, tested: g.tested, owner: o }).owners
        == g.owners,
  }

fn group_named_of(o: OwnerNamed) -> GroupNamed / {memo.read, abort.raise} =
  {
    module: o.module,
    shipped: o.shipped,
    tested: o.tested,
    owners: decoded(
      memo.ask(group_of_query(), bin::encode(o, owner_named_bin())),
      bin::list_bin(bin::bytes_bin()),
      "an owner's group",
    ),
  }

/// Whether `g` names a unit of its module: owners whose texts mention one another round a cycle.
fn current_unit(g: GroupNamed) -> Bool / {memo.read, abort.raise} =
  match g.owners {
    [] -> false,
    [o, ..] ->
      unit_named_of({ module: g.module, shipped: g.shipped, tested: g.tested, owner: o }).owners
        == g.owners,
  }

fn unit_named_of(o: OwnerNamed) -> GroupNamed / {memo.read, abort.raise} =
  {
    module: o.module,
    shipped: o.shipped,
    tested: o.tested,
    owners: decoded(
      memo.ask(unit_of_query(), bin::encode(o, owner_named_bin())),
      bin::list_bin(bin::bytes_bin()),
      "an owner's unit",
    ),
  }

fn group_of(g: GroupNamed) -> owned::GroupAnswer / {memo.read, abort.raise} =
  owned::group_whole(
    decoded(
      memo.ask(group_query(), bin::encode(g, group_named_bin())),
      owned::kept_group_bin(),
      "a group's answer",
    ),
  )

/// The entry an owner of a module shows as its group's record keeps it, read as `OwnerNamed` says,
/// with no digest of what it reaches: empty for a test, a law, or an owner whose group refuses.
pub fn shown_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, owner_named_bin(), "an owner's name");
  match owned::group_shown(
      memo.ask(group_query(), bin::encode(group_named_of(asked), group_named_bin())),
    ).get(
      asked.owner,
    ) {
    Some(entry) -> entry,
    None -> b"",
  }
}

/// The entry an owner of a module shows what reads it, read as `OwnerNamed` says: empty for a test,
/// a law, or an owner whose group refuses.
pub fn owner_entry_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, owner_named_bin(), "an owner's name");
  let alone = memo.ask(shown_query(), input);
  if alone.len() == 0 { b"" } else {
    reaching(
      alone,
      reach_of(asked, unit_named_of(asked), alone, shown_query(), owner_entry_query()),
    )
  }
}

/// A walk of what an entry reaches: the entries of its own group it reaches, by owner and each
/// encoded, and the digest each other entry it names reaches, or whether a module it names that
/// declares nothing so named declares anything at all.
type Reached = {
  local: Map<Bytes, Bytes>,
  outside: Map<Bytes, Bytes>,
  seen: Map<Bytes, Bool>,
  work: List<Mention>,
}

/// The digest of every entry `alone`, the entry of `asked`, reaches through what it mentions, and
/// of where its module stands: those of `g`, the owners it is made with, as the query `inside`
/// shows them, each other one of its module by the `reach` of what `beyond` shows, and another
/// module's by its own. An edit moves it exactly where it moves one of those entries, so a check
/// that reads an entry need not read what the entry reaches.
fn reach_of(
  asked: OwnerNamed,
  g: GroupNamed,
  alone: Bytes,
  inside: Bytes,
  beyond: Bytes,
) -> Bytes / {memo.read, abort.raise} = {
  let walked = iterate(
    {
      local: Map::new().insert(asked.owner, alone),
      outside: Map::new(),
      seen: Map::new(),
      work: entry_head(alone).mentions,
    },
    1000000,
    |s: Reached|
      match s.work {
        [] -> Stop(s),
        [m, ..rest] -> if s.seen.contains(mention_key(m)) { Continue({ ..s, work: rest }) } else {
          let at = { ..s, seen: s.seen.insert(mention_key(m), true), work: rest };
          Continue(if m.module == b"" {
            // What its text calls on a value, of each module its own can see.
            {
              ..at,
              work: at.work.concat(
                called_of(answering_of(module_named(asked), m.name).push(asked.module), [m.name]),
              ),
            }
          } else if m.module == asked.module {
            declared_of(m.module, asked.shipped, asked.tested, m.name).fold(
              at,
              |acc: Reached, o: Bytes|
                if acc.local.contains(o) { acc } else if g.owners.contains(o) {
                  let x = memo.ask(
                    inside,
                    bin::encode(
                      { module: m.module, shipped: asked.shipped, tested: asked.tested, owner: o },
                      owner_named_bin(),
                    ),
                  );
                  if x.len() == 0 { acc } else {
                    {
                      ..acc,
                      local: acc.local.insert(o, x),
                      work: acc.work.concat(entry_head(x).mentions),
                    }
                  }
                } else {
                  let b = memo.ask(
                    beyond,
                    bin::encode(
                      { module: m.module, shipped: asked.shipped, tested: asked.tested, owner: o },
                      owner_named_bin(),
                    ),
                  );
                  if b.len() == 0 { acc }
                  else { { ..acc, outside: acc.outside.insert(o, entry_head(b).reach) } }
                },
            )
          } else {
            let found = entry_bytes_of(asked.shipped, m.module, m.name);
            if found.len() == 0 {
              // No function of a type so named there is nothing reached, whatever else it holds.
              if m.name.starts_with(b"::") { at } else {
                let any = entry_bytes_of(asked.shipped, m.module, b"").len() > 0;
                {
                  ..at,
                  outside: at.outside.insert(b"there ".concat(m.module), if any { b"1" }
                  else { b"" }),
                }
              }
            } else {
              found.fold(at, |acc: Reached, b: Bytes| {
                let h = entry_head(b);
                {
                  ..acc,
                  outside: acc.outside.insert(
                    Bytes::concat_all([m.module, b".", h.owner]),
                    h.reach,
                  ),
                }
              })
            }
          })
        },
      },
  );
  blake3(
    bin::encode(
      [
        if asked.shipped { b"" }
        else { bin::encode(placed_by(placing_of(asked.module)), placed_bin()) },
        bin::encode(walked.local, bin::map_bin(bin::bytes_bin(), bin::bytes_bin())),
        bin::encode(walked.outside, bin::map_bin(bin::bytes_bin(), bin::bytes_bin())),
      ],
      bin::list_bin(bin::bytes_bin()),
    ),
  )
}

/// The entry an owner shows what reads it, read as `OwnerNamed` says: none for a test, a law, or an
/// owner whose group refuses.
fn signature_of(o: OwnerNamed) -> Option<Entry> / {Answering, abort.raise} =
  match entries_once(signature_query(), bin::encode(o, owner_named_bin()), |b: Bytes|
      if b.len() == 0 { [] } else { [decoded(b, entry_bin(), "an entry")] }) {
    [e, ..] -> Some(e),
    [] -> None,
  }

fn shown_of(o: OwnerNamed) -> Option<Entry> / {Answering, abort.raise} =
  match entries_once(shown_query(), bin::encode(o, owner_named_bin()), |b: Bytes|
      if b.len() == 0 { [] } else { [decoded(b, entry_bin(), "an entry")] }) {
    [e, ..] -> Some(e),
    [] -> None,
  }

fn owner_entry_of(o: OwnerNamed) -> Option<Entry> / {Answering, abort.raise} =
  match entries_once(owner_entry_query(), bin::encode(o, owner_named_bin()), |b: Bytes|
      if b.len() == 0 { [] } else { [decoded(b, entry_bin(), "an entry")] }) {
    [e, ..] -> Some(e),
    [] -> None,
  }

/// The entries a module shows under a name, each encoded, read as `EntryNamed` says: under every
/// name for none.
pub fn entry_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, entry_named_bin(), "an entry's name");
  bin::encode(
    declared_of(asked.module, asked.shipped, asked.tested, asked.name).fold(
      [],
      |acc: List<Bytes>, o: Bytes| {
        let e = memo.ask(
          owner_entry_query(),
          bin::encode(
            { module: asked.module, shipped: asked.shipped, tested: asked.tested, owner: o },
            owner_named_bin(),
          ),
        );
        if e.len() == 0 { acc } else { acc.push(e) }
      },
    ),
    bin::list_bin(bin::bytes_bin()),
  )
}

/// Each group of `read`, a module's owners, beside the group's name.
fn groups_named(named: Named, read: OwnersAnswer) -> List<GroupNamed> =
  read.groups.map(|g: List<Bytes>|
    { module: named.module, shipped: named.shipped, tested: named.tested, owners: g })

/// Each owner's facts in `read`, where its items stand in the module among them.
fn facts_of(read: OwnersAnswer) -> Map<Bytes, OwnerFacts> / {abort.raise} =
  read.owners.fold(
    Map::new(),
    |acc: Map<Bytes, OwnerFacts>, o: { owner: Bytes, facts: Bytes, starts: List<Int> }| {
      let f = decoded(o.facts, owner_facts_bin(), "an owner's facts");
      acc.insert(o.owner, { ..f, read: { ..f.read, starts: o.starts } })
    },
  )

/// What a check of a whole module offered: why it refused, or the answer of each group the store
/// held none of, by its encoded name.
type Offered = { refused: Option<List<Diag>>, answers: Map<Bytes, owned::GroupAnswer> }

/// How many groups checked with their module cost what one checked alone does: a group alone reads
/// again, of every entry it reaches, what its module's check reads once.
fn alone_costs() -> Int = 16

/// Whether `missing` of a module's `groups` are checked sooner by one check of the whole module than
/// each alone.
fn whole_pays(missing: Int, groups: Int) -> Bool = missing > 1 && missing * alone_costs() >= groups

/// Offers each group of `read` what a check of the whole module answers of it, where enough of them
/// must be checked again ([`whole_pays`]): a module checked from nothing, or after an edit that
/// moved most of it, is checked once, not a group at a time. Every group is offered its answer, so
/// one an answer made later in the run moves takes it too, and each as `whole`'s, whichever query
/// asked: `whole` reaches this check and nothing else, so a group's answer does not move with how a
/// module is put together. A module whose check refuses offers nothing, since each group of it
/// answers for itself; why it refused is worked out where `explaining` asks, and is empty elsewhere.
fn offered_whole(
  named: Named,
  read: OwnersAnswer,
  groups: List<GroupNamed>,
  explaining: Bool,
) -> Offered / {Answering, abort.raise} = {
  // A unit of several owners stands on its cut into groups, which stands on each member's walk.
  let missing = groups.fold(Map::new(), |acc: Map<Bytes, Bool>, g: GroupNamed| {
    let at_g = bin::encode(g, group_named_bin());
    if memo.kept(if g.owners.len() < 2 { group_query() } else { cycles_query() }, at_g) { acc }
    else { acc.insert(at_g, true) }
  });
  if !whole_pays(missing.len(), groups.len()) { { refused: None, answers: Map::new() } } else {
    let facts = facts_of(read);
    let module = named.module;
    let parse = parse_taken(named, { name: module, src: read.text });
    let checked = checked_whole(named, read, false, [parse.given]);
    match checked.pulled.out {
      Refused(ds) -> if !explaining { { refused: Some([]), answers: Map::new() } } else {
        let why = checked_whole(named, read, true, [parse.given]);
        {
          refused: Some(match why.pulled.out {
            Refused(more) -> more.map(|d: Diag| own_labels(d, why.at)),
            Analysed(_) -> ds.map(|d: Diag| own_labels(d, checked.at)),
          }),
          answers: Map::new(),
        }
      },
      Analysed(w) -> {
        let said = owned::said_of(w, checked.at, read.text, read: Some(parse.raw));
        let read_of = |o: Bytes|
          match facts.get(o) {
            Some(f) -> f.read,
            None -> panic("a group's owner is the module's"),
          };
        let walked = offered_walks(
          named,
          said,
          read.signing,
          groups.filter(|g: GroupNamed| g.owners.len() > 1).map(|g: GroupNamed|
            g.owners.map(read_of)),
        );
        // Each unit's groups, cut as `cycles` cuts them from the walks this check offers.
        let cut = groups.fold(
          [],
          |acc: List<{ unit: GroupNamed, owners: List<Bytes> }>, unit: GroupNamed|
            acc.concat(
              (if unit.owners.len() < 2 { [unit.owners] } else {
                call_cycles(
                  unit.owners,
                  unit.owners.map(|o: Bytes|
                    match walked.get(o) {
                      Some(t) ->
                        called_owners(o, owned::called_names(module, t), |n: Bytes|
                          declared_in(read, n)),
                      None -> [],
                    }),
                )
              }).map(|owners: List<Bytes>| { unit: unit, owners: owners }),
            ),
        );
        let laid = cut.map(|g: { unit: GroupNamed, owners: List<Bytes> }| {
          let members = g.owners.map(read_of);
          { members: members, items: laid_items(members) }
        });
        let answers = owned::said_groups(said, module, laid, |x: ItemAt| x.to);
        let kept = owned::groups_kept(answers);
        {
          refused: None,
          answers: range(0, cut.len()).fold(
            Map::new(),
            |acc: Map<Bytes, owned::GroupAnswer>, i: Int| {
              let unit = cut.get(i).unit;
              let g = { ..unit, owners: cut.get(i).owners };
              let at_g = bin::encode(g, group_named_bin());
              let answer = answers.get(i);
              memo.offer_as(whole_query(), group_query(), at_g, kept.get(i));
              if unit.owners.len() < 2 {
                offered_forms(whole_query(), g, laid.get(i).members, answer)
              };
              if missing.contains(bin::encode(unit, group_named_bin())) { acc.insert(at_g, answer) }
              else { acc }
            },
          ),
        }
      },
    }
  }
}

/// Offers each of `signing`, the module's sign units, its signing, and each member of each of
/// `units`, those of several owners, its walk, as the check of their whole module that `said` what
/// it did answers them, and answers the walks by owner: a group's record stands on those, so the
/// first edit to one body walks that owner and no other.
fn offered_walks(
  named: Named,
  said: owned::Said,
  signing: List<List<Bytes>>,
  units: List<List<OwnerRead>>,
) -> Map<Bytes, owned::TypedAnswer> / {memo.read, abort.raise} = {
  let members = units.fold([], |acc: List<OwnerRead>, u: List<OwnerRead>| acc.concat(u));
  let walked = owned::said_typed(said, named.module, members, |x: ItemAt| x.to);
  signing.fold((), |_: Unit, s: List<Bytes>|
    memo.offer_as(
      whole_query(),
      signatures_query(),
      bin::encode(
        { module: named.module, shipped: named.shipped, tested: named.tested, owners: s },
        group_named_bin(),
      ),
      bin::encode(owned::signed_shown(said, s), owned::signed_unit_bin()),
    ));
  range(0, members.len()).fold(Map::new(), |acc: Map<Bytes, owned::TypedAnswer>, k: Int| {
    let o = members.get(k).owner;
    memo.offer_as(
      whole_query(),
      typed_query(),
      owner_at(named, o),
      bin::encode(walked.get(k), owned::typed_answer_bin()),
    );
    acc.insert(o, walked.get(k))
  })
}

/// What `module` publishes for its owner `owner`, as a check of the module `own`, shipped where
/// `shipped` says, reads it: the functions that answer or take an `opaque` type it declares. Only
/// another module's are followed: a module builds its own `opaque` types, so its check never names
/// them, and two of its groups that refuse would each wait on the other's entry.
fn published_for(
  shipped: Bool,
  own: Bytes,
  module: Bytes,
  owner: Bytes,
) -> List<Mention> / {memo.read, abort.raise} =
  decoded(
    memo.ask(
      published_query(),
      bin::encode(
        {
          module: module,
          shipped: if module == own { shipped } else { shipped_for(shipped, module) },
          tested: false,
          owner: owner,
        },
        owner_named_bin(),
      ),
    ),
    bin::list_bin(mention_bin()),
    "what a module publishes",
  )

/// `read`, a module read as `named` says, checked whole against the entries it names, with what
/// the modules of `opaque` types it names publish for them where `published` says: what a check
/// that refuses follows to say why.
fn checked_whole(
  named: Named,
  read: OwnersAnswer,
  published: Bool,
  // A parse of the module's text, where the caller has one.
  given: List<ParsedSource>,
) -> { pulled: Pulled, at: Int } / {Answering, abort.raise} = {
  let deps = needed_through(
    |d: Bytes, n: Bytes| entries_of(named.shipped, d, n),
    head_of,
    read.wanted,
    read.context.present,
    |module: Bytes, owner: Bytes|
      if !published || module == named.module { [] }
      else { published_for(named.shipped, named.module, module, owner) },
    |n: Bytes| answering_of(named, n),
  );
  checked_against(
    { name: named.module, src: read.text },
    read.context.setting.placed,
    deps,
    placing_in(places_of(named.shipped, deps.keys())),
    { ..reading_of(read.context.setting), given: given },
  )
}

/// `d` with only its labels into the module at `at`, each moved to module 0.
fn own_labels(d: Diag, at: Int) -> Diag =
  {
    ..d,
    labels: d.labels.fold([], |acc: List<Label>, l: Label|
      if l.module == at { acc.push({ ..l, module: 0 }) } else { acc }),
  }

/// What a module answers checked, read as `Named` says: its groups' answers put together.
pub fn module_answer(input: Bytes) -> Bytes / {Answering, abort.raise} = {
  let named = decoded(input, named_bin(), "a module's name");
  let read = owners_read(named);
  bin::encode(
    if !read.found { absent(named.module) } else {
      let groups = groups_named(named, read);
      let offered = offered_whole(named, read, groups, true);
      let whole = match offered.refused { Some(ds) -> ds, None -> [] };
      // No group's answer is part of a refusal's: a module its whole check refuses asks none.
      if whole.len() > 0 { refused_for(named.module, read, whole) } else {
        let facts = facts_of(read);
        let placed = groups.fold([], |acc: List<owned::Placed>, unit: GroupNamed|
          acc.concat(
            (if unit.owners.len() < 2 { [unit.owners] } else { cycles_of(unit) }).map(
              |owners: List<Bytes>| {
                let g = { ..unit, owners: owners };
                {
                  items: laid_items(
                    owners.map(|o: Bytes|
                      match facts.get(o) {
                        Some(f) -> f.read,
                        None -> panic("a group's owner is the module's"),
                      }),
                  ),
                  // Asked for the module's reads; the whole check's answer is not decoded again.
                  answer: {
                    let at_g = bin::encode(g, group_named_bin());
                    match offered.answers.get(at_g) {
                      Some(a) -> {
                        memo.ask(group_query(), at_g);
                        a
                      },
                      None -> group_of(g),
                    }
                  },
                }
              },
            ),
          ));
        let a = owned::assembled(
          named.module,
          read.shape,
          read.order,
          placed,
          read.context.setting.placed == InRoot
            || (read.context.setting.placed == ShippedModule && read.context.setting.tested),
        );
        let header = decoded(
          memo.ask(header_query(), input),
          bin::list_bin(diag_bin()),
          "a header's refusals",
        );
        // A module whose text or any group refuses says what a check of it whole says, which names
        // each error once and none another explains.
        let refused = if !read.refusing && a.refused.len() == 0 { header } else {
          let checked = checked_whole(named, read, true, []);
          let said = match checked.pulled.out {
            Refused(ds) -> ds.map(|d: Diag| own_labels(d, checked.at)),
            Analysed(_) -> [],
          };
          if said.len() > 0 { said } else { header.concat(a.refused) }
        };
        if refused.len() > 0 { refused_for(named.module, read, refused) } else {
          {
            imports: read.context.present,
            refused: [],
            warnings: a.warnings,
            defs: a.defs,
            tests: a.tests,
            rows: rows_kept(a.rows),
            shape: a.facts.shape,
            tables: tables_kept(a.facts.tables),
          }
        }
      }
    },
    module_answer_bin(),
  )
}

/// What `module`, read as `read`, answers refused for `refused`: nothing but why, what it imports
/// and the imports it writes.
fn refused_for(
  module: Bytes,
  read: OwnersAnswer,
  refused: List<Diag>,
) -> ModuleAnswer / {abort.raise} =
  {
    ..absent(module),
    refused: refused,
    imports: read.context.present,
    shape: { ..no_shape(module), written: read.shape.written },
  }

pub fn header_text_query() -> Bytes = b"header text"

pub fn header_query() -> Bytes = b"header"

/// A module's text up to the end of its last written import, each import that selects no name
/// blanked at the offsets it had, read as `Named` says: empty for one that selects no name of
/// another, which no check of its imports alone can refuse.
pub fn header_text_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, named_bin(), "a module's name");
  // As the module is read: a shipped one an importer reads without its tests and laws, and the
  // imports only they make.
  let text = if asked.shipped {
    match shipped_text(asked.module) {
      Some(t) -> Some(if asked.tested { t } else { imported(t) }),
      None -> None,
    }
  } else {
    match placing_of(asked.module) {
      Some(_) -> memo.world(text_kind(), asked.module),
      None -> None,
    }
  };
  match text {
    None -> b"",
    Some(src) -> match header(src) {
      None -> b"",
      Some(m) -> {
        let written = m.imports.filter(is_written);
        if !written.fold(false, |b: Bool, d: ImportDecl| b || selecting(d)) { b"" } else {
          blanked(
            src.slice(0, max_of(written.map(|d: ImportDecl| d.span.end))),
            written.filter(|d: ImportDecl| !selecting(d)).map(|d: ImportDecl| d.span),
          )
        }
      },
    },
  }
}

fn max_of(xs: List<Int>) -> Int = xs.fold(0, |m: Int, x: Int| if x > m { x } else { m })

fn selecting(d: ImportDecl) -> Bool = match d.kind { INames(_) -> true, _ -> false }

/// The module names more than one of `imports` binds, which their module refuses alone.
fn colliding(imports: List<ImportDecl>) -> Map<Bytes, Bool> / {abort.raise} = {
  let counted = imports.fold(Map::new(), |acc: Map<Bytes, Int>, d: ImportDecl|
    match import_binder(d) {
      Some(b) -> acc.insert(b, match acc.get(b) { Some(n) -> n + 1, None -> 1 }),
      None -> acc,
    });
  counted.fold(Map::new(), |acc: Map<Bytes, Bool>, b: Bytes, n: Int|
    if n > 1 { acc.insert(b, true) } else { acc })
}

/// What a module's imports alone refuse, read as `Named` says: each name one selects that its
/// module does not declare, at its place. A group of the module writes only the imports it reads.
pub fn header_answer(input: Bytes) -> Bytes / {Answering, abort.raise} = {
  let asked = decoded(input, named_bin(), "a module's name");
  let prefix = memo.ask(header_text_query(), input);
  bin::encode(
    if prefix.len() == 0 { [] } else {
      let context = context_once(asked);
      let selections = range(0, min(context.imports.len(), context.targets.len())).fold(
        [],
        |acc: List<{ module: Bytes, names: List<Bytes> }>, k: Int|
          match context.imports.get(k).kind {
            INames(ns) ->
              acc.push({ module: context.targets.get(k), names: ns.map(|n: Ident| n.name) }),
            _ -> acc,
          },
      );
      // A name each module there exports refuses nothing, so only a header that selects another is
      // checked; one an edit to a selected definition leaves exported is not checked again.
      let all_exported = selections.fold(
        true,
        |b: Bool, x: { module: Bytes, names: List<Bytes> }|
          b && context.present.contains(x.module)
            && x.names.fold(true, |c: Bool, n: Bytes| c && exported(asked.shipped, x.module, n)),
      );
      if all_exported { [] } else {
        // A check reads a module only through the entries named to it, so each selected module is
        // named with all it exports, which a refusal of a name it does not export lists.
        let exports_of = |m: Bytes|
          if !context.present.contains(m) { [] } else {
            let read = owners_of(
              owners_asked({ module: m, shipped: shipped_for(asked.shipped, m), tested: false }),
            );
            read.declared.keys().filter(|n: Bytes| exported(asked.shipped, m, n))
          };
        let deps = needed_by(
          |d: Bytes, n: Bytes| entries_of(asked.shipped, d, n),
          selections.fold([], |acc: List<Mention>, x: { module: Bytes, names: List<Bytes> }|
            acc.concat(
              x.names.concat(exports_of(x.module)).map(|n: Bytes| { module: x.module, name: n }),
            )),
          selections.map(|x: { module: Bytes, names: List<Bytes> }| x.module).filter(|m: Bytes|
            context.present.contains(m)),
          |_: Bytes| [],
        );
        let places = places_of(asked.shipped, deps.keys());
        let checked = checked_against(
          { name: asked.module, src: prefix },
          context.setting.placed,
          deps,
          placing_in(places),
          reading_of(context.setting),
        );
        match checked.pulled.out {
          Analysed(_) -> [],
          Refused(ds) ->
            ds.map(|d: Diag|
              {
                ..d,
                labels: d.labels.filter(|l: Label| l.module == checked.at).map(|l: Label|
                  { ..l, module: 0 }),
              }),
        }
      }
    },
    bin::list_bin(diag_bin()),
  )
}

pub fn exported_query() -> Bytes = b"exported"

/// Whether a module exports a name, read as `EntryNamed` says: whether an owner declaring it shows
/// it, `pub`, to what imports the module. A constructor of an `opaque` type is shown to none.
pub fn exported_answer(input: Bytes) -> Bytes / {Answering, abort.raise} = {
  let asked = decoded(input, entry_named_bin(), "an entry's name");
  let shown = declared_of(asked.module, asked.shipped, asked.tested, asked.name).fold(
    false,
    |b: Bool, o: Bytes|
      b
        || (match owner_entry_of({
            module: asked.module,
            shipped: asked.shipped,
            tested: asked.tested,
            owner: o,
          }) {
          Some(e) ->
            e.text.starts_with(b"pub ") && !(o != asked.name && e.text.starts_with(b"pub opaque ")),
          None -> false,
        }),
  );
  if shown { b"1" } else { b"" }
}

fn exported(shipped: Bool, module: Bytes, name: Bytes) -> Bool / {memo.read, abort.raise} =
  memo.ask(
      exported_query(),
      bin::encode(
        { module: module, shipped: shipped_for(shipped, module), tested: false, name: name },
        entry_named_bin(),
      ),
    ).len(
    )
    > 0

/// What hashing fixed of a group of owners, read as `GroupNamed` says: their forms filled from what
/// hashing fixed of each node outside the group they reference.
pub fn group_hash_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, group_named_bin(), "a group's names");
  if !current_unit(asked) {
    bin::encode(
      { entries: Map::new(), fixing: { nodes: [], tests: [], laws: [] } },
      group_hashes_bin(),
    )
  } else {
    let h = group_hash_inputs(asked);
    let held = h.fixed.fold(Map::new(), |acc: Map<Bytes, Bool>, f: Fixed|
      acc.insert(pin_key(f.name, f.decl), true));
    // A node it reads that hashing fixed nothing of, one whose own group refuses, leaves it unhashed,
    // as a load that refuses hashes nothing.
    if h.forms.nodes.fold(false, |b: Bool, x: Shape|
        b || (match x.form { None -> !held.contains(pin_key(x.name, x.decl)), Some(_) -> false })) {
      bin::encode(
        { entries: Map::new(), fixing: { nodes: [], tests: [], laws: [] } },
        group_hashes_bin(),
      )
    } else {
      let fixing = hashed_forms(h.forms, h.fixed);
      bin::encode(
        { entries: hashes_by_owner(asked.module, fixing.nodes, h.fns).entries, fixing: fixing },
        group_hashes_bin(),
      )
    }
  }
}

/// What hashing the group `asked`, a current one, reads: the forms its check made, what hashing
/// fixed of each node outside it they reference, and the owner of each function its members declare.
fn group_hash_inputs(
  asked: GroupNamed,
) -> { forms: Shapes, fixed: List<Fixed>, fns: Map<Bytes, Bytes> } / {memo.read, abort.raise} = {
  let g = decoded(
    memo.ask(group_forms_query(), bin::encode(asked, group_named_bin())),
    group_forms_bin(),
    "a group's forms",
  );
  let forms = g.forms;
  let fixed = forms.nodes.fold([], |acc: List<Fixed>, s: Shape|
    match s.form {
      Some(_) -> acc,
      None -> {
        let m = named_node(s.name);
        let shipped = if m.module == asked.module { asked.shipped }
        else { shipped_for(asked.shipped, m.module) };
        let tested = if m.module == asked.module { asked.tested } else { false };
        declared_of(m.module, shipped, tested, m.name).fold(acc, |a: List<Fixed>, o: Bytes|

          // A member whose group refused has no form here, and its hash is this one: it leaves
          // the unit unhashed.
          if m.module == asked.module && asked.owners.contains(o) { a } else {
            let e = memo.ask(
              owner_hash_query(),
              bin::encode(
                { module: m.module, shipped: shipped, tested: tested, owner: o },
                owner_named_bin(),
              ),
            );
            if e.len() == 0 { a }
            else { a.concat(decoded(e, hash_entry_bin(), "a hash entry").fixed) }
          })
      },
    });
  { forms: forms, fixed: fixed, fns: g.fns }
}

pub fn group_forms_query() -> Bytes = b"group forms"

/// What hashing reads of a group of owners: the forms its check made of them, and the owner of each
/// name they declare.
type GroupForms = { forms: Shapes, fns: Map<Bytes, Bytes> }

derive bin for GroupForms

/// What hashing reads of a group of owners, read as `GroupNamed` says, which the rest of its answer
/// and its members' text leave be.
pub fn group_forms_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, group_named_bin(), "a group's names");
  let named = { module: asked.module, shipped: asked.shipped, tested: asked.tested };
  if !current_unit(asked) {
    bin::encode({ forms: owned::no_group().forms, fns: Map::new() }, group_forms_bin())
  } else if asked.owners.len() < 2 {
    let answer = memo.ask(group_query(), input);
    let reads = asked.owners.map(|o: Bytes| owner_facts(named, o).read);
    match memo.offered() {
      Some(o) -> o,
      None -> forms_of(reads, decoded(answer, owned::kept_group_bin(), "a group's answer").rest),
    }
  } else {
    formed(
      asked.owners.map(|o: Bytes| owner_facts(named, o).read),
      joined_forms(
        cycles_of(asked).map(|g: List<Bytes>|
          decoded(
            memo.ask(group_query(), bin::encode({ ..asked, owners: g }, group_named_bin())),
            owned::kept_group_bin(),
            "a group's answer",
          ).rest.forms),
      ),
    )
  }
}

/// What hashing reads of `a`, the answer of a group whose members read as `reads`.
fn forms_of(reads: List<OwnerRead>, a: owned::GroupAnswer) -> Bytes / {abort.raise} =
  formed(reads, a.forms)

/// What hashing reads of the unit whose members read as `reads` and whose forms are `forms`.
fn formed(reads: List<OwnerRead>, forms: Shapes) -> Bytes / {abort.raise} =
  bin::encode(
    {
      forms: forms,
      fns: reads.fold(Map::new(), |acc: Map<Bytes, Bytes>, r: OwnerRead|
        r.names.fold(acc, |m: Map<Bytes, Bytes>, n: Bytes| m.insert(n, r.owner))),
    },
    group_forms_bin(),
  )

/// Offers what hashing reads of `a`, the answer of the group `g` whose members read as `reads`,
/// which a run asking it next then takes without decoding the answer again: under the definition
/// of the query `by`, which reaches the check that made `a`.
fn offered_forms(
  by: Bytes,
  g: GroupNamed,
  reads: List<OwnerRead>,
  a: owned::GroupAnswer,
) -> Unit / {memo.read, abort.raise} =
  memo.offer_as(by, group_forms_query(), bin::encode(g, group_named_bin()), forms_of(reads, a))

fn group_hashes_of(g: GroupNamed) -> GroupHashes / {memo.read, abort.raise} =
  decoded(
    memo.ask(group_hash_query(), bin::encode(g, group_named_bin())),
    group_hashes_bin(),
    "a group's hashing",
  )

/// What hashing fixed of an owner of a module, read as `OwnerNamed` says: empty for an owner that
/// fixes nothing.
pub fn owner_hash_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, owner_named_bin(), "an owner's name");
  match group_hashes_of(unit_named_of(asked)).entries.get(asked.owner) {
    Some(e) -> bin::encode(e, hash_entry_bin()),
    None -> b"",
  }
}

/// What hashing a module fixed, read as `Named` says: its groups' hashing put together.
pub fn hashes_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, named_bin(), "a module's name");
  let read = owners_read(named);
  let hashed = groups_named(named, read).map(group_hashes_of);
  bin::encode(
    {
      hashes: {
        module: named.module,
        entries: hashed.fold(Map::new(), |acc: Map<Bytes, HashEntry>, h: GroupHashes|
          h.entries.fold(acc, |a: Map<Bytes, HashEntry>, o: Bytes, e: HashEntry| a.insert(o, e))),
      },
      owners: read.declared,
      fixing: {
        nodes: hashed.fold([], |acc: List<Fixed>, h: GroupHashes| acc.concat(h.fixing.nodes)),
        tests: hashed.fold([], |acc: List<FixedTest>, h: GroupHashes| acc.concat(h.fixing.tests)),
        laws: hashed.fold([], |acc: List<FixedLaw>, h: GroupHashes| acc.concat(h.fixing.laws)),
      },
    },
    hash_answer_bin(),
  )
}

pub fn hashes_query() -> Bytes = b"hashes"

pub fn documented_query() -> Bytes = b"documented"

/// The laws of the module `lawful` names that reference each definition, by its program-wide
/// name: what hashing fixed of a law holds what its sentence references, once checked. A law that
/// does not check references nothing.
fn laws_referencing(lawful: Named) -> Map<Bytes, List<Bytes>> / {memo.read, abort.raise} = {
  let read = owners_read(lawful);
  read.owners.fold(
    Map::new(),
    |acc: Map<Bytes, List<Bytes>>, o: { owner: Bytes, facts: Bytes, starts: List<Int> }|
      if !o.owner.starts_with(b"law ") { acc } else {
        let law = o.owner.slice(4, o.owner.len());
        let hashed = group_hashes_of({
          module: lawful.module,
          shipped: lawful.shipped,
          tested: lawful.tested,
          owners: group_holding(read, o.owner),
        });
        hashed.fixing.laws.fold(acc, |by: Map<Bytes, List<Bytes>>, l: FixedLaw|
          l.refs.fold(by, |a: Map<Bytes, List<Bytes>>, r: NodeRef| {
            let held = match a.get(r.name) { Some(laws) -> laws, None -> [] };
            if r.decl || held.contains(law) { a } else { a.insert(r.name, held.push(law)) }
          }))
      },
  )
}

/// What a module documents, read as `Named` says: a page for it and for each name it declares, read
/// off its whole text and off what its check and its hashing answered. A shipped module that writes
/// a law is read with its tests for what its laws reference, which a module importing it never
/// reads. A module there is none of documents nothing.
pub fn documented_answer(input: Bytes) -> Bytes / {memo.read, decode.write, abort.raise} = {
  let asked = decoded(input, named_bin(), "a module's name");
  bin::encode(
    match module_read({ ..asked, tested: true }) {
      None -> { pages: [] },
      Some(m) -> {
        let checked = decoded(
          memo.ask(module_query(), input),
          module_answer_bin(),
          "a module's answer",
        );
        let hashed = decoded(
          memo.ask(hashes_query(), input),
          hash_answer_bin(),
          "a module's hashing",
        );
        documented(m.parsed, m.source.src, {
          defs: tables_answered(checked).defs,
          hashes: hashed.fixing.nodes.fold(Map::new(), |acc: Map<Bytes, Bytes>, f: Fixed|
            if f.decl { acc } else { acc.insert(f.name, f.hash) }),
          // Only a module that writes a law is read with its tests for this.
          laws: if m.raw.items.fold(false, |b: Bool, item: Item|
              b || (match item { ILaw(_) -> true, _ -> false })) {
            laws_referencing({ ..asked, tested: asked.tested || asked.shipped })
          } else { Map::new() },
        })
      },
    },
    pages_bin(),
  )
}

pub fn declaring_query() -> Bytes = b"declaring"

/// The shipped modules under the package `input` names that document each simple name, by that
/// name: where a name that leads with no module is looked for without asking every module of the
/// package what it documents.
pub fn declaring_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let shipped = match memo.world(shipped_names_kind(), b"") {
    Some(b) -> decoded(b, bin::list_bin(bin::bytes_bin()), "the shipped modules' names"),
    None -> [],
  };
  let under = input.concat(b".");
  bin::encode(
    shipped.filter(|m: Bytes| m == input || m.starts_with(under)).fold(
      Map::new(),
      |acc: Map<Bytes, List<Bytes>>, m: Bytes|
        decoded(
          memo.ask(
            documented_query(),
            bin::encode({ module: m, shipped: true, tested: false }, named_bin()),
          ),
          pages_bin(),
          "a module's pages",
        ).pages.fold(acc, |by: Map<Bytes, List<Bytes>>, page: Page| {
          let simple = Bytes::of_string(page.simple);
          let held = match by.get(simple) { Some(ms) -> ms, None -> [] };
          if page.simple == "" || held.contains(m) { by } else { by.insert(simple, held.push(m)) }
        }),
    ),
    declaring_bin(),
  )
}

fn declaring_bin() -> bin::BinCodec<Map<Bytes, List<Bytes>>> =
  bin::map_bin(bin::bytes_bin(), bin::list_bin(bin::bytes_bin()))

/// Each query a load asks, by its name, beside the definition that answers it, whose hash its records
/// are kept under.
pub fn queries() -> List<{ name: Bytes, definition: Bytes, body: (Bytes) -> Bytes / {Answering, abort.raise} }> =
  [
    { name: owners_query(), definition: b"checking.owners_answer", body: owners_answer },
    { name: owner_query(), definition: b"checking.owner_answer", body: owner_answer },
    { name: unit_of_query(), definition: b"checking.unit_of_answer", body: unit_of_answer },
    { name: calls_query(), definition: b"checking.calls_answer", body: calls_answer },
    { name: cycles_query(), definition: b"checking.cycles_answer", body: cycles_answer },
    { name: group_of_query(), definition: b"checking.group_of_answer", body: group_of_answer },
    { name: shape_query(), definition: b"checking.shape_answer", body: shape_answer },
    { name: sign_unit_query(), definition: b"checking.sign_unit_answer", body: sign_unit_answer },
    { name: context_query(), definition: b"checking.context_answer", body: context_answer },
    { name: setting_query(), definition: b"checking.setting_answer", body: setting_answer },
    { name: wants_query(), definition: b"checking.wants_answer", body: wants_answer },
    { name: whole_query(), definition: b"checking.whole_answer", body: whole_answer },
    { name: published_query(), definition: b"checking.published_answer", body: published_answer },
    { name: sees_query(), definition: b"checking.sees_answer", body: sees_answer },
    { name: answering_query(), definition: b"checking.answering_answer", body: answering_answer },
    {
      name: group_imports_query(),
      definition: b"checking.group_imports_answer",
      body: group_imports_answer,
    },
    { name: declared_query(), definition: b"checking.declared_answer", body: declared_answer },
    { name: names_query(), definition: b"checking.names_answer", body: names_answer },
    { name: group_query(), definition: b"checking.group_answer_of", body: group_answer_of },
    {
      name: signatures_query(),
      definition: b"checking.signatures_answer",
      body: signatures_answer,
    },
    { name: signature_query(), definition: b"checking.signature_answer", body: signature_answer },
    { name: signed_query(), definition: b"checking.signed_answer", body: signed_answer },
    { name: typed_query(), definition: b"checking.typed_answer_of", body: typed_answer_of },
    {
      name: owner_entry_query(),
      definition: b"checking.owner_entry_answer",
      body: owner_entry_answer,
    },
    { name: shown_query(), definition: b"checking.shown_answer", body: shown_answer },
    { name: entry_query(), definition: b"checking.entry_answer", body: entry_answer },
    { name: module_query(), definition: b"checking.module_answer", body: module_answer },
    { name: imports_query(), definition: b"checking.imports_answer", body: imports_answer },
    {
      name: header_text_query(),
      definition: b"checking.header_text_answer",
      body: header_text_answer,
    },
    { name: header_query(), definition: b"checking.header_answer", body: header_answer },
    { name: exported_query(), definition: b"checking.exported_answer", body: exported_answer },
    {
      name: group_forms_query(),
      definition: b"checking.group_forms_answer",
      body: group_forms_answer,
    },
    {
      name: group_hash_query(),
      definition: b"checking.group_hash_answer",
      body: group_hash_answer,
    },
    {
      name: owner_hash_query(),
      definition: b"checking.owner_hash_answer",
      body: owner_hash_answer,
    },
    { name: hashes_query(), definition: b"checking.hashes_answer", body: hashes_answer },
    {
      name: documented_query(),
      definition: b"checking.documented_answer",
      body: documented_answer,
    },
    { name: declaring_query(), definition: b"checking.declaring_answer", body: declaring_answer },
  ]

// --- Asking a program's modules -------------------------------------------------------------

/// A module of a load's own packages: its name in its package, and its text.
pub type OwnFile = { module: Bytes, text: Bytes }

/// A package of a load's own: the key it is judged by, its manifest's text, and its modules.
pub type OwnPackage = { root: Bytes, manifest: Option<Bytes>, files: List<OwnFile> }

/// What the world holds for the queries of a load: its packages, where each of its own modules is
/// and its text, and the names of its own modules in the order a load places them.
pub type World = {
  layout: Bytes,
  places: Map<Bytes, Bytes>,
  texts: Map<Bytes, Bytes>,
  own: List<Bytes>,
  deps: List<Bytes>,
}

fn embedding_of(read: EmbedRead) -> Embedding =
  match read {
    Ok(files) ->
      { files: files.map(|f: EmbedFile| { name: f.name, bytes: f.bytes }), refused: None },
    Err(why) -> { files: [], refused: Some(why) },
  }

/// The world of a load of `root` and `deps`. Its packages are what their manifests say, judged, and
/// its modules what they are named and hold: where a package or a file is, is no part of it.
pub fn world_of(root: OwnPackage, deps: List<OwnPackage>) -> World / {abort.raise} = {
  let j = judged(
    {
      root: root.root,
      manifest: root.manifest,
      supplied: deps.map(|p: OwnPackage| { root: p.root, manifest: p.manifest, modules: [] }),
    },
    root.files.map(|f: OwnFile| f.module),
  );
  let placed = range(0, deps.len() + 1).fold(
    [],
    |acc: List<{ name: Bytes, placing: Placing, text: Bytes }>, k: Int| {
      let p = if k == 0 { root } else { deps.get(k - 1) };
      let prefix = prefix_in(j, k);
      p.files.fold(acc, |a: List<{ name: Bytes, placing: Placing, text: Bytes }>, f: OwnFile|
        a.push({
          name: if prefix.len() == 0 { f.module }
          else { Bytes::concat_all([prefix, b".", f.module]) },
          placing: { package: k, relative: f.module },
          text: f.text,
        }))
    },
  );
  {
    layout: bin::encode(placeless(j), judged_bin()),
    places: placed.fold(
      Map::new(),
      |acc: Map<Bytes, Bytes>, x: { name: Bytes, placing: Placing, text: Bytes }|
        acc.insert(x.name, bin::encode(x.placing, placing_bin())),
    ),
    texts: placed.fold(
      Map::new(),
      |acc: Map<Bytes, Bytes>, x: { name: Bytes, placing: Placing, text: Bytes }|
        acc.insert(x.name, x.text),
    ),
    own: placed.map(|x: { name: Bytes, placing: Placing, text: Bytes }| x.name),
    deps: range(1, deps.len() + 1).map(|k: Int| prefix_in(j, k)),
  }
}

/// Whether a load that read one file of its root package and the modules it imports, as `w` holds
/// them, looks at the place `at` of `kind`: any place but a module's, and a module's of one it read,
/// of one of `absent`, which it looked for and did not find, or of a package it read whole. Another
/// module of the root's is not there for it, nor gone.
pub fn walked_covers(w: World, absent: List<Bytes>, kind: Bytes, at: Bytes) -> Bool =
  if kind != text_kind() && kind != module_kind() && kind != embed_kind() { true } else {
    let module = if kind != embed_kind() { at }
    else { match at.split(b"\x00").at(1) { Some(m) -> m, None -> at } };
    w.places.contains(module) || absent.contains(module)
      || w.deps.fold(false, |b: Bool, p: Bytes|
        b || (p.len() > 0 && module.starts_with(p.concat(b"."))))
  }

/// Whether a run that reads no project, only what the toolchain ships, looks at a place of `kind`:
/// a project's packages, modules, files and embeds are not there for it, nor gone, so it leaves
/// standing what a load of a project kept in the store it shares.
pub fn shipped_covers(kind: Bytes) -> Bool =
  kind != layout_kind() && kind != module_kind() && kind != text_kind() && kind != embed_kind()

/// Where the module `module`, by its name in the program, is among `w`'s packages.
pub fn world_placing(w: World, module: Bytes) -> Option<Placing> / {abort.raise} =
  match w.places.get(module) {
    Some(b) -> Some(decoded(b, placing_bin(), "a module's place")),
    None -> None,
  }

/// What the module of `w` that `at` names embeds, read through `reader`, which is handed the module's
/// package, its name there and what it asks for: nothing for a module `w` does not hold.
fn embedded_at<| e>(
  w: World,
  reader: (Int, Bytes, EmbedWant) -> EmbedRead / {abort.raise | e},
  at: Bytes,
) -> Option<Bytes> / {abort.raise | e} = {
  let parts = at.split(b"\x00");
  match ((parts.at(1), parts.at(2))) {
    (Some(module), Some(key)) -> match world_placing(w, module) {
      None -> None,
      Some(p) -> {
        Some(
          bin::encode(
            embedding_of(reader(p.package, p.relative, want_of_key(key))),
            embedding_bin(),
          ),
        )
      },
    },
    _ -> None,
  }
}

/// What `w` holds as `kind` reads it at `at`, a shipped module's text and whether there is one, a
/// data file's bytes, the shipped modules there are and what a module embeds as `shipped`, `data`,
/// `names` and `reader` answer them.
pub fn looked<| e>(
  w: World,
  shipped: (Bytes) -> Option<Bytes> / {abort.raise | e},
  data: (Bytes) -> Option<Bytes> / {abort.raise | e},
  names: () -> List<Bytes> / {abort.raise | e},
  reader: (Int, Bytes, EmbedWant) -> EmbedRead / {abort.raise | e},
  kind: Bytes,
  at: Bytes,
) -> Option<Bytes> / {abort.raise | e} =
  if kind == layout_kind() { Some(w.layout) } else if kind == shipped_names_kind() {
    Some(bin::encode(names(), bin::list_bin(bin::bytes_bin())))
  } else if kind == module_kind() { w.places.get(at) }
  else if kind == text_kind() { w.texts.get(at) }
  else if kind == shipped_kind() { shipped(at) }
  else if kind == shipped_there_kind() { match shipped(at) { Some(_) -> Some(b""), None -> None } }
  else if kind == data_kind() { data(at) }
  else if kind == embed_kind() { embedded_at(w, reader, at) }
  else { None }

/// The evaluator's line of the `stamps` the launcher lays beside the shipped modules: what an answer
/// computed by running a query is a function of besides the query's own definitions.
pub fn evaluator_of(stamps: Bytes) -> Bytes / {abort.raise} =
  stamps.split(b"\n").fold(b"", |acc: Bytes, line: Bytes|
    if line.starts_with(b"evaluator ") { line.slice(10, line.len()) } else { acc })

/// The queries, each under the hash its definition has in the program `definitions` lists and the
/// stamp of the evaluator that runs it.
pub fn registry(definitions: Bytes, evaluator: Bytes) -> Map<Bytes, CheckQuery> / {abort.raise} =
  queries().fold(
    Map::new(),
    |acc: Map<Bytes, CheckQuery>, q: { name: Bytes, definition: Bytes, body: (Bytes) -> Bytes / {Answering, abort.raise} }|
      acc.insert(q.name, {
        name: q.name,
        hash: match definition_hash(definitions, q.definition) {
          Some(h) -> blake3(Bytes::concat_all([h, b"\x00", evaluator])),
          None ->
            panic(
              "the program holds no definition `" ++ String::of_bytes_lossy(q.definition) ++ "`",
            ),
        },
        body: q.body,
      }),
  )

/// The queries, each under its name for a hash: what a run that keeps nothing asks.
pub fn fresh_registry() -> Map<Bytes, CheckQuery> =
  queries().fold(
    Map::new(),
    |acc: Map<Bytes, CheckQuery>, q: { name: Bytes, definition: Bytes, body: (Bytes) -> Bytes / {Answering, abort.raise} }|
      acc.insert(q.name, { name: q.name, hash: q.name, body: q.body }),
  )

/// A module of a load, by its name in the program, and what it answered.
pub type Answered = { module: Bytes, answer: ModuleAnswer }

/// What `a` says its module's definitions and tests published.
pub fn rows_answered(a: ModuleAnswer) -> Rows / {abort.raise} = rows_read(a.rows)

/// What `a` says its module's check said of its declarations.
pub fn tables_answered(a: ModuleAnswer) -> ModuleTables / {abort.raise} = tables_read(a.tables)

/// What `a` says its module's check said of it: its shape and its tables.
pub fn facts_answered(a: ModuleAnswer) -> ModuleFacts / {abort.raise} =
  { shape: a.shape, tables: tables_answered(a) }

/// The program `frame` holds, its check's tables read as `reads` says from what `answers` says each
/// of its modules answered: none for a module that answers nothing.
pub fn view_answered(
  frame: Frame,
  reads: TableReads,
  answers: Map<Bytes, ModuleAnswer>,
) -> View / {abort.raise} =
  view_over(
    frame,
    reads,
    frame.outlines.map(|o: Outline|
      match answers.get(o.name) { Some(a) -> tables_answered(a), None -> no_module_tables() }),
  )

/// What a load's modules answered: its own, then each shipped module it pulled, and those in the
/// order it pulled them.
pub type Asking = { answers: List<Answered>, pulled: List<Bytes> }

/// What each of `own`, the load's own modules, answers checked, and each shipped module they pull,
/// asked of `qs` over a run: each round, every shipped module a module answered so far imports as
/// written, and each of `asked` from the first, each read with its tests where `tested` says. Where
/// the own modules import one another in a cycle, no module is checked, since none has an order to
/// be checked in: what answers is the module whose import closes each cycle, refused for it. An own
/// module that imports one that refused, or one left unchecked for that, is not checked either: a
/// load that refuses says only what [`refused_first`] keeps, and its answer is an absent module's
/// with its imports.
pub fn asked_all(
  qs: Map<Bytes, CheckQuery>,
  own: List<Bytes>,
  asked: List<Bytes>,
  tested: Bool,
  run: Run,
) -> { run: Run, value: Asking } / {Driving, abort.raise} = {
  let cycles = cycles_among(qs, run, own);
  if cycles.refused.len() > 0 {
    { run: cycles.run, value: { answers: cycles.refused, pulled: [] } }
  } else {
    let ask = |r: Run, named: Named| {
      let a = answer(qs, r, module_query(), bin::encode(named, named_bin()));
      {
        run: a.run,
        answered: {
          module: named.module,
          answer: decoded(a.output, module_answer_bin(), "a module's answer"),
        },
      }
    };
    let ordered = dependencies_first(
      qs,
      cycles.run,
      own.map(|n: Bytes| { module: n, shipped: false, tested: false }),
    );
    let asked_own = ordered.order.fold(
      { run: ordered.run, answered: Map::new(), written: Map::new(), stopped: Map::new() },
      |acc: { run: Run, answered: Map<Bytes, Answered>, written: Map<Bytes, List<Bytes>>, stopped: Map<Bytes, Bool> }, n: Named| {
        let imports = match ordered.edges.get(n.module) { Some(ms) -> ms, None -> [] };
        if imports.fold(false, |b: Bool, m: Bytes| b || acc.stopped.contains(m)) {
          {
            ..acc,
            answered: acc.answered.insert(n.module, {
              module: n.module,
              answer: { ..absent(n.module), imports: imports },
            }),
            stopped: acc.stopped.insert(n.module, true),
          }
        } else {
          let a = ask(acc.run, n);
          {
            run: a.run,
            answered: acc.answered.insert(n.module, a.answered),
            written: acc.written.insert(n.module, a.answered.answer.shape.written),
            stopped: if a.answered.answer.refused.len() == 0 { acc.stopped }
            else { acc.stopped.insert(n.module, true) },
          }
        }
      },
    );
    let first = {
      run: asked_own.run,
      answers: own.map(|n: Bytes|
        match asked_own.answered.get(n) {
          Some(a) -> a,
          None -> panic("each own module is answered"),
        }),
      written: asked_own.written,
    };
    let listed = shipped_listed().fold(Map::new(), |acc: Map<Bytes, Bool>, n: Bytes|
      acc.insert(n, true));
    let users = own.fold(Map::new(), |acc: Map<Bytes, Bool>, n: Bytes| acc.insert(n, true));
    let pulled = iterate(
      { run: first.run, answers: first.answers, written: first.written, read: own, pulled: [] },
      listed.len() + 2,
      |x: { run: Run, answers: List<Answered>, written: Map<Bytes, List<Bytes>>, read: List<Bytes>, pulled: List<Bytes> }| {
        let fresh = pulled_next(users, x.read, x.written, listed, asked);
        if fresh.len() == 0 { Stop(x) } else {
          Continue(
            fresh.fold(
              { ..x, read: x.read.concat(fresh), pulled: x.pulled.concat(fresh) },
              |acc: { run: Run, answers: List<Answered>, written: Map<Bytes, List<Bytes>>, read: List<Bytes>, pulled: List<Bytes> }, n: Bytes| {
                let a = ask(acc.run, { module: n, shipped: true, tested: tested });
                {
                  ..acc,
                  run: a.run,
                  answers: acc.answers.push(a.answered),
                  written: acc.written.insert(n, a.answered.answer.shape.written),
                }
              },
            ),
          )
        }
      },
    );
    { run: pulled.run, value: { answers: pulled.answers, pulled: pulled.pulled } }
  }
}

/// The shipped modules there are, as the world names them.
fn shipped_listed() -> List<Bytes> / {memo_keep.read, abort.raise} =
  match memo_keep.now(shipped_names_kind(), b"") {
    Some(b) -> decoded(b, bin::list_bin(bin::bytes_bin()), "the shipped modules' names"),
    None -> [],
  }

/// The queries whose answers of a shipped module the toolchain ships, which a load cannot cheaply
/// make again: the module read for its owners, the check of it whole, which every group of it asks
/// first and which checks the module for a load that holds none of its groups, the signing of each
/// sign unit, the walk of each owner of a unit of several, what it calls and how each unit is cut
/// into groups, each group's check and hashing, the module's answer and hashing put together, what
/// a module of the standard library documents, and which of them declare each name. What one owner
/// or one name answers is read off those.
pub fn shipped_queries() -> List<Bytes> =
  [
    owners_query(),
    whole_query(),
    signatures_query(),
    typed_query(),
    calls_query(),
    cycles_query(),
    group_query(),
    group_hash_query(),
    module_query(),
    hashes_query(),
    wants_query(),
    documented_query(),
    declaring_query(),
  ]

/// What a load asks of each of `shipped`, the shipped modules, of `qs` over a run: its answer and its
/// hashing, which ask all the rest, and of the standard library which of its modules declare each
/// name, which asks each what it documents: what `ply doc` reads wherever it runs.
pub fn shipped_all(
  qs: Map<Bytes, CheckQuery>,
  shipped: List<Bytes>,
  run: Run,
) -> Run / {Driving, abort.raise} = {
  let ordered = dependencies_first(
    qs,
    run,
    shipped.map(|m: Bytes| { module: m, shipped: true, tested: false }),
  );
  declaring_in(
    qs,
    b"std",
    ordered.order.fold(ordered.run, |r: Run, named: Named|
      [module_query(), hashes_query(), wants_query()].fold(r, |at: Run, query: Bytes|
        answer(qs, at, query, bin::encode(named, named_bin())).run)),
  ).run
}

/// What each of `pulled`, shipped modules a load pulled, read with their tests where `tested` says,
/// embeds of the shipped modules, asked of `qs` over a run, by module.
pub fn wanted_all(
  qs: Map<Bytes, CheckQuery>,
  pulled: List<Bytes>,
  tested: Bool,
  run: Run,
) -> { run: Run, value: Map<Bytes, ShippedWants> } / {Driving, abort.raise} =
  pulled.fold(
    { run: run, value: Map::new() },
    |acc: { run: Run, value: Map<Bytes, ShippedWants> }, m: Bytes| {
      let a = answer(
        qs,
        acc.run,
        wants_query(),
        bin::encode({ module: m, shipped: true, tested: tested }, named_bin()),
      );
      {
        run: a.run,
        value: acc.value.insert(m, decoded(a.output, shipped_wants_bin(), "a module's wants")),
      }
    },
  )

/// What each of `asked` documents, asked of `qs` over a run, in their order.
pub fn documented_all(
  qs: Map<Bytes, CheckQuery>,
  asked: List<Named>,
  run: Run,
) -> { run: Run, value: List<Pages> } / {Driving, abort.raise} =
  asked.fold({ run: run, value: [] }, |acc: { run: Run, value: List<Pages> }, named: Named| {
    let a = answer(qs, acc.run, documented_query(), bin::encode(named, named_bin()));
    { run: a.run, value: acc.value.push(decoded(a.output, pages_bin(), "a module's pages")) }
  })

/// The shipped modules under the package `package` that declare each simple name, asked of `qs`
/// over a run.
pub fn declaring_in(
  qs: Map<Bytes, CheckQuery>,
  package: Bytes,
  run: Run,
) -> { run: Run, value: Map<Bytes, List<Bytes>> } / {Driving, abort.raise} = {
  let a = answer(qs, run, declaring_query(), package);
  { run: a.run, value: decoded(a.output, declaring_bin(), "the modules that declare each name") }
}

/// `modules` in an order that has each after those of them it imports, as each one's imports say,
/// the rest in the order they came: a module answered before what reads it is checked whole, not a
/// group at a time as an importer reaches each. `edges` holds the modules each one imports.
fn dependencies_first(
  qs: Map<Bytes, CheckQuery>,
  run: Run,
  modules: List<Named>,
) -> { run: Run, order: List<Named>, edges: Map<Bytes, List<Bytes>> } / {Driving, abort.raise} = {
  let read = modules.fold(
    { run: run, edges: Map::new() },
    |acc: { run: Run, edges: Map<Bytes, List<Bytes>> }, n: Named| {
      let a = answer(qs, acc.run, imports_query(), bin::encode(n, named_bin()));
      {
        run: a.run,
        edges: acc.edges.insert(
          n.module,
          decoded(a.output, imports_of_bin(), "a module's imports").imports.map(|i: ImportOf|
            i.named.module),
        ),
      }
    },
  );
  let among = modules.fold(Map::new(), |acc: Map<Bytes, Bool>, n: Named|
    acc.insert(n.module, true));
  let order = iterate(
    { placed: Map::new(), left: modules, out: [] },
    modules.len() + 2,
    |x: { placed: Map<Bytes, Bool>, left: List<Named>, out: List<Named> }| {
      let ready = x.left.filter(|n: Named|
        List::fold(
          match read.edges.get(n.module) { Some(es) -> es, None -> [] },
          true,
          |b: Bool, m: Bytes| b && (m == n.module || !among.contains(m) || x.placed.contains(m)),
        ));
      if ready.len() == 0 { Stop(x.out.concat(x.left)) } else {
        let placed = ready.fold(x.placed, |acc: Map<Bytes, Bool>, n: Named|
          acc.insert(n.module, true));
        let left = x.left.filter(|n: Named| !placed.contains(n.module));
        if left.len() == 0 { Stop(x.out.concat(ready)) }
        else { Continue({ placed: placed, left: left, out: x.out.concat(ready) }) }
      }
    },
  );
  { run: read.run, order: order, edges: read.edges }
}

/// What refuses a load's packages before any of its modules is read: each root module that claims a
/// built-in package's prefix, labelled at its place, beside `listed`, the shipped modules there are;
/// each manifest that does not check, and each judgment of the graph they make, labelled at its
/// manifest's place, which follows the load's `modules` modules. `root_modules` names the root
/// package's, first among the load's.
pub fn packages_refused(
  pkgs: PackageSources,
  root_modules: List<Bytes>,
  modules: Int,
  listed: List<Bytes>,
) -> List<Diag> / {abort.raise} =
  squats(root_modules, listed).map(|sd: { slot: Int, diag: ParseDiag }|
    placed(0 - sd.slot - 1, sd.diag)).concat(
    judged(pkgs, root_modules).diags.map(|sd: { slot: Int, diag: ParseDiag }|
      placed(modules + sd.slot, sd.diag)),
  )

/// What hashing fixed of each of `own`, the load's own modules, and of `shipped`, the shipped modules
/// it pulls, asked of `qs` over a run: what a load assembled from its modules' answers takes in place
/// of hashing the program.
pub fn hashed_all(
  qs: Map<Bytes, CheckQuery>,
  own: List<Bytes>,
  shipped: List<Bytes>,
  tested: Bool,
  run: Run,
) -> { run: Run, value: Fixing } / {Driving, abort.raise} =
  own.map(|n: Bytes| { module: n, shipped: false, tested: false }).concat(
    shipped.map(|n: Bytes| { module: n, shipped: true, tested: tested }),
  ).fold({ run: run, value: no_fixing() }, |acc: { run: Run, value: Fixing }, named: Named| {
    let a = answer(qs, acc.run, hashes_query(), bin::encode(named, named_bin()));
    let f = decoded(a.output, hash_answer_bin(), "a module's hashing").fixing;
    {
      run: a.run,
      value: {
        nodes: acc.value.nodes.concat(f.nodes),
        tests: acc.value.tests.concat(f.tests),
        laws: acc.value.laws.concat(f.laws),
      },
    }
  })

/// The cycles `own` import one another in, each refused at the import that closes it: the cycle
/// read from its least module, and closed by the module before it.
fn cycles_among(
  qs: Map<Bytes, CheckQuery>,
  run: Run,
  own: List<Bytes>,
) -> { run: Run, refused: List<Answered> } / {Driving, abort.raise} = {
  let read = own.fold(
    { run: run, edges: Map::new() },
    |acc: { run: Run, edges: Map<Bytes, List<ImportOf>> }, m: Bytes| {
      let a = answer(
        qs,
        acc.run,
        imports_query(),
        bin::encode({ module: m, shipped: false, tested: false }, named_bin()),
      );
      {
        run: a.run,
        edges: acc.edges.insert(
          m,
          decoded(a.output, imports_of_bin(), "a module's imports").imports.filter(|i: ImportOf|
            !i.named.shipped),
        ),
      }
    },
  );
  let edges = read.edges;
  let next = |m: Bytes|
    List::map(match edges.get(m) { Some(es) -> es, None -> [] }, |i: ImportOf| i.named.module);
  // Every module `from` reaches, ascending by the path that first reached it.
  let paths = |from: Bytes|
    iterate(
      { seen: Map::new(), frontier: next(from).map(|n: Bytes| { at: n, path: [from] }) },
      own.len() + 2,
      |x: { seen: Map<Bytes, List<Bytes>>, frontier: List<{ at: Bytes, path: List<Bytes> }> }|
        if x.frontier.len() == 0 { Stop(x.seen) } else {
          Continue(
            x.frontier.fold(
              { seen: x.seen, frontier: [] },
              |y: { seen: Map<Bytes, List<Bytes>>, frontier: List<{ at: Bytes, path: List<Bytes> }> }, f: { at: Bytes, path: List<Bytes> }|
                if y.seen.contains(f.at) { y } else {
                  {
                    seen: y.seen.insert(f.at, f.path),
                    frontier: y.frontier.concat(
                      next(f.at).map(|n: Bytes| { at: n, path: f.path.push(f.at) }),
                    ),
                  }
                },
            ),
          )
        },
    );
  let refused = own.sort_by(|a: Bytes, b: Bytes|
    match compare_values(a, b) { Greater -> false, _ -> true }).fold(
    { done: Map::new(), out: [] },
    |acc: { done: Map<Bytes, Bool>, out: List<Answered> }, m: Bytes|
      if acc.done.contains(m) { acc } else {
        match paths(m).get(m) {
          None -> acc,
          Some(path) -> {
            let closing = path.get(path.len() - 1);
            let span = List::fold(
              match edges.get(closing) { Some(es) -> es, None -> [] },
              dummy_span(),
              |s: Span, i: ImportOf| if i.named.module == m { i.span } else { s },
            );
            let diag = if path.len() == 1 {
              error_at(
                b"E0109",
                0,
                span,
                Bytes::concat_all([b"module `", m, b"` imports itself"]),
                b"a module cannot import itself",
                [b"every name a module declares is already in scope in its own file"],
              )
            } else {
              error_at(
                b"E0109",
                0,
                span,
                Bytes::concat_all([
                  b"module cycle: ",
                  backticked(path, b" -> "),
                  b" -> `",
                  m,
                  b"`",
                ]),
                b"this import closes the cycle",
                [
                  b"each of these has to be checked before the next, and the last before the first, so there is no order to check them in",
                  b"move what they share into a module that all of them import",
                ],
              )
            };
            {
              done: path.fold(acc.done, |d: Map<Bytes, Bool>, p: Bytes| d.insert(p, true)),
              out: acc.out.push({
                module: closing,
                answer: { ..absent(closing), refused: [diag] },
              }),
            }
          },
        }
      },
  ).out;
  { run: read.run, refused: refused }
}

/// The hash of `name`, a definition of the load's own module `module`, as hashing that module fixed
/// it: nothing where the module does not define it.
pub fn entry_hash(
  qs: Map<Bytes, CheckQuery>,
  run: Run,
  module: Bytes,
  name: Bytes,
) -> { run: Run, hash: Option<Bytes> } / {Driving, abort.raise} =
  if module.len() == 0 { { run: run, hash: None } } else {
    let a = answer(
      qs,
      run,
      hashes_query(),
      bin::encode({ module: module, shipped: false, tested: false }, named_bin()),
    );
    let hashed = decoded(a.output, hash_answer_bin(), "a module's hashing");
    {
      run: a.run,
      hash: hashed.fixing.nodes.fold(None, |acc: Option<Bytes>, f: Fixed|
        if !f.decl && f.name == name { Some(f.hash) } else { acc }),
    }
  }

/// The warnings of the first `root` of `answers`, the modules of the load's root package, each
/// labelled at its module's place among them.
pub fn root_warnings(answers: List<Answered>, root: Int) -> List<Diag> =
  range(0, root).fold([], |acc: List<Diag>, i: Int|
    match answers.at(i) {
      None -> acc,
      Some(a) ->
        acc.concat(
          a.answer.warnings.map(|d: Diag|
            { ..d, labels: d.labels.map(|l: Label| { ..l, module: i }) }),
        ),
    })

/// Each of `answers` refused for what its own text says: one that imports a refused module may be
/// refused for that alone, which the refusal of that module says.
pub fn refused_first(answers: List<Answered>) -> List<Answered> = {
  let refused = answers.fold(Map::new(), |acc: Map<Bytes, Bool>, a: Answered|
    if a.answer.refused.len() > 0 { acc.insert(a.module, true) } else { acc });
  answers.filter(|a: Answered|
    a.answer.refused.len() > 0
      && !a.answer.imports.fold(false, |b: Bool, m: Bytes| b || refused.contains(m)))
}

// --- Tests ----------------------------------------------------------------------------------

/// What an answer says, to compare one with another: a refusal by the code and message of each
/// error, sorted, since a load refuses by each module's own; an analysis by what it publishes.
type Said = | Refusing(List<Bytes>) | Publishing(Published)

fn said(outcome: AnalysisOutcome) -> Said / {abort.raise} =
  match outcome {
    Refused(ds) ->
      Refusing(
        ds.map(|d: Diag| Bytes::concat_all([d.code, b": ", d.message])).sort_by(
          |a: Bytes, b: Bytes| match compare_values(a, b) { Greater -> false, _ -> true },
        ),
      ),
    Analysed(_) -> Publishing(published(outcome)),
  }

fn nothing_embedded(package: Int, module: Bytes, want: EmbedWant) -> EmbedRead =
  Err(b"no file is there")

/// `work` run over `held` as [`over_held`] runs it, with what its queries decode held meanwhile.
fn over_decoding<a | e>(
  held: Held,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {Driving, abort.raise},
) -> { held: Held, value: a } / {abort.raise | e} =
  over_held(held, read, world, look, || decoding_once(work))

/// `sources` answered through the module queries over `held`, as a load assembles them: refused by
/// the errors of each module no refused import explains, else analysed whole, each definition and
/// test taken as its module's answer published it.
fn answered_over(
  held: Held,
  sources: List<Source>,
) -> { held: Held, run: Run, outcome: AnalysisOutcome, fixing: Fixing, answers: List<Answered> } / {abort.raise} =
  answered_under(fresh_registry(), held, sources)

/// [`answered_over`] under the queries `qs`.
fn answered_under(
  qs: Map<Bytes, CheckQuery>,
  held: Held,
  sources: List<Source>,
) -> { held: Held, run: Run, outcome: AnalysisOutcome, fixing: Fixing, answers: List<Answered> } / {abort.raise} = {
  let w = world_alone(sources);
  let done = over_decoding(
    held,
    packs::no_pack,
    b"",
    |kind: Bytes, at: Bytes| looked_alone(w, kind, at),
    || asked_alone(qs, w),
  );
  {
    held: done.held,
    run: done.value.run,
    fixing: done.value.fixing,
    answers: done.value.answers,
    outcome: outcome_of(sources, done.value.answers),
  }
}

/// The world a load of `sources` and nothing else reads.
fn world_alone(sources: List<Source>) -> World / {abort.raise} =
  world_of(
    { root: b"", manifest: None, files: sources.map(|s: Source| { module: s.name, text: s.src }) },
    [],
  )

/// What `w` holds at a place, for a load that ships and embeds nothing.
fn looked_alone(w: World, kind: Bytes, at: Bytes) -> Option<Bytes> / {abort.raise} = {
  let none = |name: Bytes| None;
  looked(w, none, none, || [], nothing_embedded, kind, at)
}

/// Each module of `w` asked of `qs` over a run of its own, and hashed where none refuses.
fn asked_alone(
  qs: Map<Bytes, CheckQuery>,
  w: World,
) -> { run: Run, answers: List<Answered>, fixing: Fixing } / {Driving, abort.raise} = {
  let all = asked_all(qs, w.own, [], false, started(qs));
  if refused_first(all.value.answers).len() > 0 {
    { run: all.run, answers: all.value.answers, fixing: no_fixing() }
  } else {
    let fixed = hashed_all(qs, w.own, all.value.pulled, false, all.run);
    { run: fixed.run, answers: all.value.answers, fixing: fixed.value }
  }
}

/// What a load makes of `answers`, what each module of `sources` answered.
fn outcome_of(sources: List<Source>, answers: List<Answered>) -> AnalysisOutcome / {abort.raise} =
  match refused_first(answers) {
    [] ->
      analyse_with(
        parse_all(sources),
        answers.fold(no_rows(), |acc: Rows, a: Answered| {
          let r = rows_answered(a.answer);
          {
            defs: acc.defs.concat(r.defs),
            tests: acc.tests.concat(r.tests),
            types: tables_joined(acc.types, r.types),
          }
        }),
      ),
    first -> Refused(first.fold([], |acc: List<Diag>, a: Answered| acc.concat(a.answer.refused))),
  }

/// Who else keeps the store a session's steps are answered through: nobody; a run of the same
/// step that starts as each step first looks at the world and ends before it; or nobody, each
/// step answered by a `ply` of other queries than the step before it.
type Company = | Alone | Raced | Turns

/// `sources` answered as [`answered_over`] answers them, through the memo store kept in `tree`'s
/// files, as the `nth` step of a session in `company`.
fn answered_in(
  tree: fs::MemFs,
  sources: List<Source>,
  company: Company,
  nth: Int,
) -> { tree: fs::MemFs, run: Run, outcome: AnalysisOutcome, fixing: Fixing } / {abort.raise} = {
  let w = world_alone(sources);
  // A query no module asks: its hash alone tells one `ply` from another.
  let qs = fresh_registry().insert(b"spare", {
    name: b"spare",
    hash: if company == Turns && nth % 2 == 1 { b"odd" } else { b"even" },
    body: |input: Bytes| input,
  });
  let done = fs::on_mem[abs](tree, ||
    handle {
      memo_files::kept[abs](
        "s",
        packs::no_pack,
        b"",
        |kind: Bytes, at: Bytes| {
          if raced.first() {
            memo_files::kept[abs](
              "s",
              packs::no_pack,
              b"",
              |k: Bytes, a: Bytes| looked_alone(w, k, a),
              || decoding_once(|| asked_alone(qs, w).run),
            );
            ()
          };
          looked_alone(w, kind, at)
        },
        || decoding_once(|| asked_alone(qs, w)),
      )
    } with {
      var begun = company != Raced,
      raced.first() -> {
        let first = !begun;
        begun = true;
        first
      },
    });
  {
    tree: done.tree,
    run: done.value.run,
    fixing: done.value.fixing,
    outcome: outcome_of(sources, done.value.answers),
  }
}

/// Whether a raced session's rival has yet to begin: the first look begins it.
effect raced {
  write first() -> Bool
}

/// The steps whose answer through the store's files, kept from step to step in `company`, is not
/// the one the store held in memory answers, which the fresh one is held to above. Alone, a step
/// also runs the bodies the store in memory runs and no other.
fn files_apart(steps: List<Step>, company: Company) -> List<Bytes> / {abort.raise} =
  range(0, steps.len()).fold(
    { tree: fs::mem_of([]), held: nothing_held(), off: [] },
    |s: { tree: fs::MemFs, held: Held, off: List<Bytes> }, i: Int| {
      let step = steps.get(i);
      let filed = answered_in(s.tree, step.sources, company, i);
      let held = answered_over(s.held, step.sources);
      let agrees = said(filed.outcome) == said(held.outcome) && filed.fixing == held.fixing
        && (company != Alone || ran_total(filed.run) == ran_total(held.run));
      { tree: filed.tree, held: held.held, off: if agrees { s.off } else { s.off.push(step.what) } }
    },
  ).off

// --- Through a session of edits -------------------------------------------------------------
// Each step is answered through the store the steps before it kept and again from nothing, which must
// agree. A load refuses by each module's own errors, more than a whole analysis stopping at its first
// failing phase may report, so that one decides only whether a program checks and what it publishes.

type Step = { what: Bytes, sources: List<Source> }

/// The steps whose answer through the memo store, kept from step to step, is not the fresh one.
fn disagreements(steps: List<Step>) -> List<Bytes> / {abort.raise} =
  steps.fold(
    { held: nothing_held(), inputs: Map::new(), hashes: Map::new(), off: [] },
    |s: { held: Held, inputs: Map<Bytes, Bytes>, hashes: Map<Bytes, Bytes>, off: List<Bytes> }, step: Step| {
      let warm = answered_over(s.held, step.sources);
      let now = said(warm.outcome);
      let whole = said(analyse(parse_all(step.sources)));
      let fresh = answered_over(nothing_held(), step.sources);
      let agrees = now == said(fresh.outcome) && warm.fixing == fresh.fixing
        && (match whole {
          Publishing(_) -> now == whole,
          Refusing(_) -> match now { Refusing(_) -> true, Publishing(_) -> false },
        });
      // The groups the edit checks again are those whose check reads otherwise, each once; none where
      // modules import one another in a cycle, which checks no module.
      let inputs = match inputs_over(fresh.held, step.sources, b"group inputs") {
        Some(i) -> i,
        None -> s.inputs,
      };
      // Likewise the groups it hashes again. A load that refuses asks for no hashing of its own, so
      // what is hashed again is what a run settles: the hashing of each module hashed before, which
      // asks each group the module holds now, a group new to it among them, and each group whose hash
      // one of those reads. A group that is gone is hashed anew where it comes back.
      let refused = match fresh.outcome { Refused(_) -> true, Analysed(_) -> false };
      let asked = ran_for(warm.run, group_hash_query()).fold(
        Map::new(),
        |acc: Map<Bytes, Bool>, k: Bytes| acc.insert(k, true),
      );
      let hashed_modules = s.hashes.fold(Map::new(), |acc: Map<Bytes, Bool>, k: Bytes, _: Bytes|
        acc.insert(decoded(k, group_named_bin(), "a group's names").module, true));
      let now_hashes = match inputs_over(fresh.held, step.sources, b"hash inputs") {
        Some(h) -> if refused {
          h.fold(Map::new(), |acc: Map<Bytes, Bytes>, k: Bytes, v: Bytes|
            if asked.contains(k)
                || hashed_modules.contains(
                  decoded(k, group_named_bin(), "a group's names").module,
                ) { acc.insert(k, v) }
            else { acc })
        } else { h },
        None -> s.hashes,
      };
      let hashes = now_hashes;
      // A group runs once, or twice where the edit gives it something new to read: its height in
      // the store, which orders a run's settling, is from before it read that.
      // Where the groups run are not those whose reads moved, each once or twice: which were, and
      // which ran.
      let off_by = |was: Map<Bytes, Bytes>, now: Map<Bytes, Bytes>, query: Bytes| {
        let ran = ran_for(warm.run, query).filter(|k: Bytes| now.contains(k));
        let times = ran.fold(Map::new(), |acc: Map<Bytes, Int>, k: Bytes|
          acc.insert(k, match acc.get(k) { Some(n) -> n + 1, None -> 1 }));
        let moved = sorted_bytes(now.keys().filter(|k: Bytes| was.get(k) != now.get(k)));
        // A record taken back from before an edit undone moves its answer with no body run.
        let back = restored_for(warm.run, query).filter(|k: Bytes|
          moved.contains(k) && !times.contains(k));
        let thrice = sorted_bytes(
          times.fold([], |acc: List<Bytes>, k: Bytes, n: Int|
            if n > 2 { acc.push(k) } else { acc }),
        );
        if moved != sorted_bytes(times.keys().concat(back)) || thrice != [] {
          Some(
            Bytes::concat_all([
              b": moved ",
              groups_shown(moved),
              b", ran ",
              groups_shown(sorted_bytes(times.keys())),
              if thrice == [] { b"" } else { b", more than twice ".concat(groups_shown(thrice)) },
            ]),
          )
        } else { None }
      };
      {
        held: warm.held,
        inputs: inputs,
        hashes: hashes,
        off: if !agrees {
          s.off.push(Bytes::concat_all([step.what, fixing_apart(warm.fixing, fresh.fixing)]))
        } else {
          match off_by(s.inputs, inputs, group_query()) {
            Some(why) -> s.off.push(Bytes::concat_all([step.what, b" (work)", why])),
            None -> match off_by(s.hashes, now_hashes, group_hash_query()) {
              Some(why) -> s.off.push(Bytes::concat_all([step.what, b" (hash work)", why])),
              None -> s.off,
            },
          }
        },
      }
    },
  ).off

/// Each of `groups`, encoded group names, as its module and owners.
fn groups_shown(groups: List<Bytes>) -> Bytes / {abort.raise} =
  Bytes::join(
    groups.map(|b: Bytes| {
      let g = decoded(b, group_named_bin(), "a group's names");
      Bytes::concat_all([g.module, b"[", Bytes::join(g.owners, b" "), b"]"])
    }),
    b", ",
  )

/// Where `warm`'s hashing and `fresh`'s part: each node either fixes otherwise, by name.
fn fixing_apart(warm: Fixing, fresh: Fixing) -> Bytes = {
  let by = |f: Fixing|
    f.nodes.fold(Map::new(), |acc: Map<Bytes, Bytes>, x: Fixed| acc.insert(x.name, x.hash));
  let w = by(warm);
  let c = by(fresh);
  let names = sorted_bytes(
    w.fold(c, |acc: Map<Bytes, Bytes>, k: Bytes, v: Bytes| acc.insert(k, v)).keys(),
  );
  let apart = names.filter(|n: Bytes| w.get(n) != c.get(n));
  if apart.len() == 0 { b"" }
  else { Bytes::concat_all([b" (hashes of ", Bytes::join(apart, b", "), b")"]) }
}

fn sorted_bytes(xs: List<Bytes>) -> List<Bytes> =
  xs.sort_by(|a: Bytes, b: Bytes| match compare_values(a, b) { Greater -> false, _ -> true })

/// What a check of the group `input` names reads, as one digest: what an edit must check it again
/// where it moves, and nothing else. Nothing for a group its module no longer checks together.
fn group_check_of(asked: GroupNamed, published: Bool) -> GroupCheck / {Answering, abort.raise} = {
  let named = { module: asked.module, shipped: asked.shipped, tested: asked.tested };
  owners_check(
    named,
    asked.owners.map(|o: Bytes| owner_facts(named, o)),
    imports_of(asked),
    published,
    entire,
  )
}

fn group_inputs_answer(input: Bytes) -> Bytes / {Answering, abort.raise} = {
  let asked = decoded(input, group_named_bin(), "a group's names");
  if !current(asked) { b"" } else {
    let of = |c: GroupCheck| {
      let source = group_source_from(asked.module, c.reads, c.imported, c.needed);
      Bytes::concat_all([
        bin::encode(source.source.src, bin::bytes_bin()),
        bin::encode(
          source.deps,
          bin::map_bin(bin::bytes_bin(), bin::map_bin(bin::bytes_bin(), entry_bin())),
        ),
        bin::encode(source.rows, bin::list_bin(known_def_row_bin())),
        bin::encode(source.fixed, bin::list_bin(fixed_bin())),
        bin::encode(c.setting, setting_bin()),
        bin::encode(c.places, bin::map_bin(bin::bytes_bin(), placed_bin())),
      ])
    };
    let refused = group_of(asked).refused.len() > 0;
    blake3(
      of(group_check_of(asked, false)).concat(if refused { of(group_check_of(asked, true)) }
      else { b"" }),
    )
  }
}

/// What hashing the group `input` names reads, as one digest. Nothing for a group its module no
/// longer checks together.
fn hash_inputs_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let asked = decoded(input, group_named_bin(), "a group's names");
  if !current_unit(asked) { b"" } else {
    let h = group_hash_inputs(asked);
    blake3(
      Bytes::concat_all([
        bin::encode(h.forms, shapes_bin()),
        bin::encode(h.fixed, bin::list_bin(fixed_bin())),
        bin::encode(h.fns, bin::map_bin(bin::bytes_bin(), bin::bytes_bin())),
      ]),
    )
  }
}

/// What each group of each of `sources`' modules reads, by the group's encoded name, as the query
/// `probe` digests it over `held`, which answered them all: none where modules import one another in
/// a cycle.
fn inputs_over(
  held: Held,
  sources: List<Source>,
  probe: Bytes,
) -> Option<Map<Bytes, Bytes>> / {abort.raise} = {
  let w = world_of(
    { root: b"", manifest: None, files: sources.map(|s: Source| { module: s.name, text: s.src }) },
    [],
  );
  let none = |name: Bytes| None;
  over_decoding(
    held,
    packs::no_pack,
    b"",
    |kind: Bytes, at: Bytes| looked(w, none, none, || [], nothing_embedded, kind, at),
    || {
      let qs = fresh_registry().insert(b"group inputs", {
        name: b"group inputs",
        hash: b"group inputs",
        body: group_inputs_answer,
      }).insert(b"hash inputs", {
        name: b"hash inputs",
        hash: b"hash inputs",
        body: hash_inputs_answer,
      });
      let cycles = cycles_among(qs, started(qs), w.own);
      if cycles.refused.len() > 0 { None } else {
        Some(
          w.own.fold(
            { run: cycles.run, out: Map::new() },
            |acc: { run: Run, out: Map<Bytes, Bytes> }, m: Bytes| {
              let named = bin::encode({ module: m, shipped: false, tested: false }, named_bin());
              let o = answer(qs, acc.run, owners_query(), named);
              decoded(o.output, owners_answer_bin(), "a module's owners").groups.fold(
                { run: o.run, out: acc.out },
                |a: { run: Run, out: Map<Bytes, Bytes> }, g: List<Bytes>| {
                  let unit = bin::encode(
                    { module: m, shipped: false, tested: false, owners: g },
                    group_named_bin(),
                  );
                  // A unit of several owners checks a group a cycle of its calls; it hashes whole.
                  let cut = if probe != b"group inputs" || g.len() < 2 {
                    { run: a.run, groups: [g] }
                  } else {
                    let c = answer(qs, a.run, cycles_query(), unit);
                    {
                      run: c.run,
                      groups: decoded(
                        c.output,
                        bin::list_bin(bin::list_bin(bin::bytes_bin())),
                        "a unit's groups",
                      ),
                    }
                  };
                  cut.groups.fold(
                    { run: cut.run, out: a.out },
                    |b: { run: Run, out: Map<Bytes, Bytes> }, owners: List<Bytes>| {
                      let key = bin::encode(
                        { module: m, shipped: false, tested: false, owners: owners },
                        group_named_bin(),
                      );
                      let i = answer(qs, b.run, probe, key);
                      { run: i.run, out: b.out.insert(key, i.output) }
                    },
                  )
                },
              )
            },
          ).out,
        )
      }
    },
  ).value
}

fn step(what: Bytes, sources: List<Source>) -> Step = { what: what, sources: sources }

/// Every occurrence of `from` in module `name`, as `to`.
fn edited(
  sources: List<Source>,
  name: Bytes,
  from: Bytes,
  to: Bytes,
) -> List<Source> / {abort.raise} =
  sources.map(|source: Source|
    if source.name != name { source } else if source.src.index_of(from) == None {
      panic("the fixture drifted: the text to edit is not there")
    } else { { name: source.name, src: Bytes::join(source.src.split(from), to) } })

fn with_module(sources: List<Source>, name: Bytes, src: Bytes) -> List<Source> =
  sources.filter(|source: Source| source.name != name).push({ name: name, src: src })

fn without(sources: List<Source>, name: Bytes) -> List<Source> =
  sources.filter(|source: Source| source.name != name)

/// A change a session makes to the shop fixture. An edit turns each change it names on, or off again,
/// so every list of edits is a session the fixture renders, an error or a missing module among them.
type Change =
  | LeafBody
  | LeafSignature
  | LeafPrivate
  | LeafError
  | LeafImportsCore
  | LeafReformatted
  | LeafDeleted
  | CoreRenamed
  | CoreBody
  | CoreResultType
  | TypeRenamed
  | EffectRenamed
  | TwiceMoved
  | DoubledRemoved
  | ShopBody
  | ShopImportsLeaf
  | DefaultEdited
  | TestAdded
  | ExtraAdded
  | ExtraBody
  | TwinAdded

fn either(on: List<Change>, change: Change, yes: Bytes, no: Bytes) -> Bytes =
  if on.contains(change) { yes } else { no }

fn twice_text() -> Bytes = b"pub fn twice<a>(x: a, f: (a) -> a) -> a = f(f(x))\n"

fn shop_core(on: List<Change>) -> Bytes = {
  let money = either(on, TypeRenamed, b"Cost", b"Money");
  Bytes::concat_all([
    b"pub type ",
    money,
    b" = Int\npub type Item =\n  | Book(String, ",
    money,
    b")\n  | Note(String)\npub effect ",
    either(on, EffectRenamed, b"ledger", b"db"),
    b" {\n  read get[r](key: Int) -> Int\n  write put[r](key: Int, value: Int) -> Int\n}\npub fn price(i: Item) -> ",
    either(on, CoreResultType, b"Int", money),
    b" =\n  match i {\n    Book(_, p) -> p",
    either(on, CoreBody, b" + 0", b""),
    b",\n    Note(_) -> 0,\n  }\n",
    either(on, TwiceMoved, b"", twice_text()),
    b"pub fn ",
    either(on, CoreRenamed, b"title", b"label"),
    b"(i: Item) -> String =\n  match i {\n    Book(t, _) -> t,\n    Note(t) -> t,\n  }\npub fn shade(n: Int = ",
    either(on, DefaultEdited, b"2", b"1"),
    b") -> Int = n\ntest \"a note is free\" {\n  assert_eq(price(Note(\"n\")), 0)\n}\n",
    either(
      on,
      TestAdded,
      b"test \"a book costs its price\" {\n  assert_eq(price(Book(\"b\", 2)), 2)\n}\n",
      b"",
    ),
  ])
}

fn shop_shop(on: List<Change>) -> Bytes = {
  let db = either(on, EffectRenamed, b"ledger", b"db");
  Bytes::concat_all([
    b"import core\n",
    if on.contains(ShopImportsLeaf) || on.contains(TwiceMoved) { b"import leaf\n" } else { b"" },
    b"fn total(items: List<core::Item>) -> Int =\n  items.fold(0, |acc, i: core::Item| acc + core::price(i)",
    either(on, ShopBody, b" + 0", b""),
    b")\n",
    either(
      on,
      DoubledRemoved,
      b"",
      Bytes::concat_all([
        b"fn doubled(n: Int) -> Int = ",
        either(on, TwiceMoved, b"leaf", b"core"),
        b"::twice(n, |x: Int| x + x)\n",
      ]),
    ),
    b"fn stored(k: Int) -> Int / {core::",
    db,
    b".read[cart]} = core::",
    db,
    b".get[cart](k)\nfn shaded() -> Int = core::shade()\ntest \"shipped modules adds up\" {\n  assert_eq(total([core::Book(\"b\", 3), core::Note(\"n\")]), 3)\n}\n",
  ])
}

fn shop_leaf(on: List<Change>) -> Bytes =
  Bytes::concat_all([
    either(on, LeafImportsCore, b"import core\n\n", b""),
    either(on, LeafReformatted, b"// a comment\n", b""),
    either(on, LeafPrivate, b"", b"pub "),
    either(on, LeafReformatted, b"fn  one", b"fn one"),
    b"() -> Int = ",
    if on.contains(LeafError) { b"\"1\"" }
    else if on.contains(LeafImportsCore) { b"core::price(core::Note(\"n\")) + 1" }
    else { b"1" },
    b"\npub fn two",
    either(on, LeafSignature, b"(k: Int) -> Int = one() + k", b"() -> Int = one() + one()"),
    either(on, LeafBody, b" + 0", b""),
    b"\n",
    either(on, TwiceMoved, twice_text(), b""),
  ])

fn shop_extra(on: List<Change>) -> Bytes =
  Bytes::concat_all([
    b"import leaf\npub fn four() -> Int = leaf::two(",
    either(on, LeafSignature, b"2", b""),
    b") + ",
    either(on, ExtraBody, b"3", b"2"),
    b"\n",
  ])

/// The shop fixture with the changes `on` made: a twin is a module whose text is the leaf's.
fn rendered(on: List<Change>) -> List<Source> = {
  let leaf = shop_leaf(on);
  let present = |change: Change, sources: List<Source>|
    if on.contains(change) { sources } else { [] };
  [
    [{ name: b"core", src: shop_core(on) }, { name: b"shop", src: shop_shop(on) }],
    if on.contains(LeafDeleted) { [] } else { [{ name: b"leaf", src: leaf }] },
    present(ExtraAdded, [{ name: b"extra", src: shop_extra(on) }]),
    present(TwinAdded, [{ name: b"twin", src: leaf }]),
  ].flatten(
  )
}

fn shop() -> List<Source> = rendered([])

/// The steps of a session from the fixture cold, each edit turning its changes on or off.
fn session(edits: List<List<Change>>) -> List<Step> =
  edits.fold(
    { on: [], steps: [step(b"cold", shop())] },
    |s: { on: List<Change>, steps: List<Step> }, edit: List<Change>| {
      let on = edit.fold(s.on, |acc: List<Change>, c: Change|
        if acc.contains(c) { acc.filter(|d: Change| d != c) } else { acc.push(c) });
      {
        on: on,
        steps: s.steps.push(step(Bytes::of_string(s.steps.len().to_string()), rendered(on))),
      }
    },
  ).steps

test "an answer through the store is the fresh one through every kind of edit a session makes" {
  let s0 = shop();
  let s1 = edited(s0, b"leaf", b"one() + one()", b"one() + one() + 0");
  let s2 = edited(
    s1,
    b"leaf",
    b"pub fn two() -> Int = one() + one() + 0",
    b"pub fn two(k: Int) -> Int = one() + k",
  );
  let s3 = edited(s2, b"leaf", b"pub fn one()", b"fn one()");
  let broken = edited(s3, b"leaf", b"fn one() -> Int = 1", b"fn one() -> Int = \"1\"");
  let s4 = edited(s3, b"core", b"pub fn label(", b"pub fn title(");
  let s5 = edited(s4, b"core", b"Book(_, p) -> p,", b"Book(_, p) -> p + 0,");
  let s6 = edited(s5, b"shop", b"acc + core::price(i)", b"acc + core::price(i) + 0");
  let s7 = edited(s6, b"shop", b"import core\n", b"import core\nimport leaf\n");
  let s8 = with_module(s6, b"extra", b"import leaf\npub fn four() -> Int = leaf::two(2) + 2\n");
  let s9 = edited(s8, b"extra", b"+ 2\n", b"+ 3\n");
  let s10 = edited(s9, b"leaf", b"one() + k", b"one() + k + 0");
  let s11 = edited(
    edited(
      s10,
      b"leaf",
      b"fn one() -> Int = 1",
      b"import core\n\nfn one() -> Int = core::price(core::Note(\"n\")) + 1",
    ),
    b"core",
    b"Book(_, p) -> p + 0,",
    b"Book(_, p) -> p + 1,",
  );
  let s12 = without(s11, b"extra");
  let s13 = edited(s12, b"core", b"Money", b"Cost");
  let s14 = edited(
    edited(s13, b"core", b"effect db", b"effect ledger"),
    b"shop",
    b"core::db.",
    b"core::ledger.",
  );
  assert_eq(
    disagreements([
      step(b"cold", s0),
      step(b"unchanged", s0),
      step(b"a body edit in a leaf", s1),
      step(b"a signature edit in a leaf", s2),
      step(b"`pub` removed in a leaf", s3),
      step(b"a type error", broken),
      step(b"the error undone", s3),
      step(b"a rename in a module another imports", s4),
      step(b"a body edit in a module another imports", s5),
      step(b"a body edit in a module that imports another", s6),
      step(b"an import added", s7),
      step(b"an import removed", s6),
      step(b"a file added", s8),
      step(b"an edit to the added file", s9),
      step(b"an edit to the leaf the added file imports", s10),
      step(b"an import added to a module edited with the one it now imports", s11),
      step(b"the added file deleted", s12),
      step(b"a type renamed", s13),
      step(b"an effect renamed", s14),
      step(b"unchanged again", s14),
    ]),
    [],
  )
}

test "moving, removing and re-signing definitions leaves an answer through the store the fresh one" {
  let s0 = shop();
  let twice = b"pub fn twice<a>(x: a, f: (a) -> a) -> a = f(f(x))\n";
  let moved = edited(
    edited(
      edited(
        edited(s0, b"core", twice, b""),
        b"leaf",
        b"pub fn one()",
        twice.concat(b"pub fn one()"),
      ),
      b"shop",
      b"import core",
      b"import core\nimport leaf",
    ),
    b"shop",
    b"core::twice",
    b"leaf::twice",
  );
  let removed = edited(
    edited(s0, b"shop", b"fn doubled(n: Int) -> Int = core::twice(n, |x: Int| x + x)\n", b""),
    b"core",
    twice,
    b"",
  );
  let spare = with_module(s0, b"spare", b"pub fn spare() -> Int = 9\n");
  let referenced = with_module(s0, b"extra", b"import leaf\npub fn three() -> Int = leaf::two()\n");
  assert_eq(
    disagreements([
      step(b"cold", s0),
      step(b"a definition moved between modules", moved),
      step(b"back", s0),
      step(b"a definition removed outright", removed),
      step(b"back again", s0),
      step(
        b"a dependency's signature changed",
        edited(s0, b"core", b"pub fn price(i: Item) -> Money =", b"pub fn price(i: Item) -> Int ="),
      ),
      step(b"reformatted", edited(s0, b"leaf", b"pub fn one()", b"// a comment\npub fn  one()")),
      step(b"an unreferenced file", spare),
      step(b"deleted", s0),
      step(b"a file importing the leaf", referenced),
      step(b"the leaf deleted under it", without(referenced, b"leaf")),
      step(b"the leaf restored", referenced),
    ]),
    [],
  )
}

test "names shared, declarations alike and tests edited leave an answer through the store the fresh one" {
  let peel = b"pub type Thing = | Wrap(Int)\npub fn peel(t: Thing) -> Int = match t { Wrap(n) -> n }\n";
  let shared = [{ name: b"a", src: peel }, { name: b"b", src: peel }];
  let look = b"pub effect db { read get[r](key: Int) -> Int }\npub fn look(k: Int) -> Int / {db.read[t]} = db.get[t](k)\n";
  // The capability `pick` does not handle is the one its row writes.
  let pick = |m: Bytes|
    Bytes::concat_all([
      b"import x\nimport y\npub fn pick(k: Int) -> Int / {",
      if m == b"x" { b"y" } else { b"x" },
      b"::db.read[t]} =\n  handle x::look(k) + y::look(k) with { ",
      m,
      b"::db.get[t](j) -> j, }\n",
    ]);
  let alike = [
    { name: b"x", src: look },
    { name: b"y", src: look },
    { name: b"z", src: b"pub fn plain() -> Int = 7\n" },
    { name: b"w", src: pick(b"x") },
  ];
  let alias = [
    { name: b"alias", src: b"pub type Cents = Int\npub fn zero() -> Cents = 0\n" },
    { name: b"user", src: b"import alias\nfn take() -> alias::Cents = alias::zero()\n" },
    { name: b"lone", src: b"fn lone() -> Int = 1\n" },
  ];
  let tested = b"fn f() -> Int = 1\ntest \"f is one\" { assert_eq(f(), 1) }\n";
  let palette = b"pub type Color = Red | Green\npub fn paint(what: String, shade: Color = Red) -> String =\n  match shade {\n    Red -> what.concat(\" red\"),\n    Green -> what.concat(\" green\"),\n  }\n";
  let wall = b"import palette\npub fn wall() -> String = palette::paint(\"wall\")\npub fn given() -> String = palette::paint(\"wall\", palette::Green)\ntest \"the default crosses the module boundary\" {\n  assert_eq(wall(), \"wall red\")\n}\n";
  let painted = [{ name: b"palette", src: palette }, { name: b"wall", src: wall }];
  assert_eq(
    disagreements([
      step(b"two definitions sharing a hash", shared),
      step(b"warm", shared),
      step(b"identically declared effects", alike),
      step(b"warm", alike),
      step(b"the handler switched to the other capability", with_module(alike, b"w", pick(b"y"))),
      step(
        b"an unrelated edit",
        with_module(with_module(alike, b"w", pick(b"y")), b"z", b"pub fn plain() -> Int = 8\n"),
      ),
      step(b"a type alias", alias),
      step(b"warm", alias),
      step(b"an unrelated edit", with_module(alias, b"lone", b"fn lone() -> Int = 2\n")),
      step(b"a test", [{ name: b"m", src: tested }]),
      step(b"a test added", [
        { name: b"m", src: tested.concat(b"test \"twice\" { assert_eq(f() + f(), 2) }\n") },
      ]),
      step(b"a test with a body already present", [
        { name: b"m", src: tested.concat(b"test \"still one\" { assert_eq(f(), 1) }\n") },
      ]),
      step(b"a cross-module default", painted),
      step(
        b"the default edited",
        edited(painted, b"palette", b"shade: Color = Red", b"shade: Color = Green"),
      ),
    ]),
    [],
  )
}

fn performer(module: Bytes) -> Bytes =
  Bytes::concat_all([
    b"import ",
    module,
    b"\npub fn look(k: Int) -> Int / {",
    module,
    b"::db.read[t]} = ",
    module,
    b"::db.get[t](k)\ntest \"looks\" { handle { assert_eq(look(1), 0) } with { ",
    module,
    b"::db.get[t](k) -> 0 } }\n",
  ])

fn effect_decl() -> Bytes = b"pub effect db { read get[r](key: Int) -> Int }\n"

test "a structurally identical effect appearing, renamed or deleted leaves an answer through the store the fresh one" {
  let one = [{ name: b"x", src: effect_decl() }, { name: b"p", src: performer(b"x") }];
  let twins = [
    { name: b"a", src: effect_decl() },
    { name: b"x", src: effect_decl() },
    { name: b"p", src: performer(b"a") },
  ];
  let survivors = [
    { name: b"a", src: effect_decl() },
    { name: b"x", src: effect_decl() },
    { name: b"p", src: performer(b"x") },
  ];
  assert_eq(
    disagreements([
      step(b"cold", one),
      step(b"warm", one),
      step(b"an identical effect appeared", with_module(one, b"a", effect_decl())),
      step(b"twins", twins),
      step(
        b"the twin renamed to sort first",
        with_module(twins, b"x", b"pub effect audit { read get[r](key: Int) -> Int }\n"),
      ),
      step(b"survivors", survivors),
      step(b"the module that ranked first deleted", without(survivors, b"a")),
    ]),
    [],
  )
}

test "reordering, relabelling and re-exporting leave an answer through the store the fresh one" {
  let ops = |first: Bytes, second: Bytes|
    [
      {
        name: b"m",
        src: Bytes::concat_all([
          b"pub effect db {\n  ",
          first,
          b"\n  ",
          second,
          b"\n}\npub fn f() -> Int = 1\n",
        ]),
      },
    ];
  let get = b"read get[r](key: Int) -> Int";
  let put = b"write put[r](key: Int, value: String) -> Unit";
  let variants = |body: Bytes| [{ name: b"m", src: b"pub type T =\n".concat(body) }];
  let labelled = |label: Bytes|
    [
      {
        name: b"m",
        src: Bytes::concat_all([
          b"fn f() -> Int = 1\ntest \"",
          label,
          b"\" { assert_eq(f(), 1) }\n",
        ]),
      },
    ];
  let exported = [
    { name: b"a", src: b"pub fn one() -> Int = 1\n" },
    { name: b"b", src: b"import a\nfn two() -> Int = a::one() + a::one()\n" },
  ];
  assert_eq(
    disagreements([
      step(b"operations", ops(get, put)),
      step(b"the operations reordered", ops(put, get)),
      step(b"variants", variants(b"  | A(Int)\n  | B(String)\n")),
      step(b"the variants reordered", variants(b"  | B(String)\n  | A(Int)\n")),
      step(b"a test", labelled(b"f is one")),
      step(b"its label changed", labelled(b"f is really one")),
      step(b"and the run after that", labelled(b"f is really one")),
      step(b"an exported name", exported),
      step(b"its `pub` removed", with_module(exported, b"a", b"fn one() -> Int = 1\n")),
      step(
        b"a selective import",
        with_module(exported, b"b", b"import a (one)\nfn two() -> Int = one() + one()\n"),
      ),
      step(b"back to a module import", exported),
    ]),
    [],
  )
}

test "an opaque type's module edited and undone leaves an answer through the store the fresh one" {
  let lib = b"pub opaque type Count = new { n: Int }\n\npub fn zero() -> Count = { n: 0 }\n\npub fn next(c: Count) -> Count = { n: c.n + 1 }\n\npub fn value(c: Count) -> Int = c.n\n";
  let s0 = [
    { name: b"lib", src: lib },
    {
      name: b"app",
      src: b"import lib\n\npub fn two() -> Int = lib::value(lib::next(lib::next(lib::zero())))\n\ntest \"two steps\" {\n  assert_eq(two(), 2)\n}\n",
    },
  ];
  let at = |what: Bytes, text: Bytes|
    [step(what, with_module(s0, b"lib", text)), step(what.concat(b", undone"), s0)];
  assert_eq(
    disagreements(
      [step(b"cold", s0)].concat(
        at(b"a function added", lib.concat(b"\npub fn gate_added() -> Int = 7\n")).concat(
          at(
            b"a body that now raises",
            Bytes::join(lib.split(b"= { n: 0 }"), b"= panic(\"x\")"),
          ).concat(
            at(
              b"a function made private",
              Bytes::join(lib.split(b"pub fn zero"), b"fn zero"),
            ).concat(
              at(
                b"a public function renamed",
                Bytes::join(lib.split(b"pub fn zero()"), b"pub fn zero_moved()"),
              ).concat(
                at(
                  b"a function removed",
                  Bytes::join(lib.split(b"\npub fn value(c: Count) -> Int = c.n\n"), b"\n"),
                ).concat(
                  at(
                    b"a test added",
                    lib.concat(b"\ntest \"the gate's test\" {\n  assert(true)\n}\n"),
                  ).concat(
                    // Every function that builds one refuses, each in a group of its own.
                    at(
                      b"a field added",
                      Bytes::join(lib.split(b"new { n: Int }"), b"new { n: Int, m: Int }"),
                    ),
                  ),
                ),
              ),
            ),
          ),
        ),
      ),
    ),
    [],
  )
}

// `said` reads `say`, whose module refuses while its body panics, so its module is checked a group
// at a time when it comes back; its test is labelled as it is named, and hashes apart from it.
test "a test labelled as the function it tests hashes apart from it, through a refusal and back" {
  let s0 = [
    {
      name: b"lib",
      src: b"pub effect log {\n  write emit(Bytes) -> Unit\n  read peek() -> Int\n}\n\npub fn say(b: Bytes) -> Unit / {log.write} = log.emit(b)\n",
    },
    {
      name: b"app",
      src: b"import lib\n\npub fn said() -> Int =\n  handle {\n    lib::say(b\"a\");\n    2\n  } with {\n    lib::log.emit(_) -> (),\n  }\n\ntest \"said\" {\n  assert_eq(said(), 2)\n}\n",
    },
  ];
  assert_eq(
    disagreements([
      step(b"cold", s0),
      step(b"a body that now panics", edited(s0, b"lib", b"= log.emit(b)", b"= panic(\"x\")")),
      step(b"and undone", s0),
    ]),
    [],
  )
}

test "edits undone, modules renamed and files emptied leave an answer through the store the fresh one" {
  let s0 = shop();
  let leaf2 = b"pub fn one() -> Int = 1\npub fn two() -> Int = one() + 1\n";
  let aliased = edited(
    edited(s0, b"shop", b"import core", b"import core as c"),
    b"shop",
    b"core::",
    b"c::",
  );
  assert_eq(
    disagreements([
      step(b"cold", s0),
      step(b"a body edited", with_module(s0, b"leaf", leaf2)),
      step(b"and reverted", s0),
      step(
        b"a definition added",
        with_module(s0, b"leaf", shop_leaf([]).concat(b"pub fn three() -> Int = two() + one()\n")),
      ),
      step(b"and deleted", s0),
      step(b"a module renamed", with_module(without(s0, b"leaf"), b"frond", shop_leaf([]))),
      step(b"and renamed back", s0),
      step(b"an imported module deleted", without(s0, b"core")),
      step(b"and restored", s0),
      step(b"a comment", with_module(s0, b"leaf", b"// a note\n".concat(shop_leaf([])))),
      step(b"an import aliased", aliased),
      step(b"the alias removed", s0),
      step(b"an empty module", with_module(s0, b"empty", b"")),
      step(b"which gained a definition", with_module(s0, b"empty", b"pub fn now() -> Int = 1\n")),
      step(b"and went away", s0),
      step(b"a nested module beside a flat one", [
        { name: b"a", src: b"pub fn x() -> Int = 1\n" },
        { name: b"a.b", src: b"pub fn y() -> Int = 2\n" },
      ]),
      step(b"the nested module changed", [
        { name: b"a", src: b"pub fn x() -> Int = 1\n" },
        { name: b"a.b", src: b"pub fn y() -> Int = 3\n" },
      ]),
    ]),
    [],
  )
}

test "a module fixed after it refused beside a renamed import answers as it does fresh" {
  let off = disagreements(session([[LeafError, CoreRenamed], [LeafError]]));
  assert(off.len() == 0, Some(String::of_bytes_lossy(Bytes::join(off, b"; "))))
}

test "a leaf deleted beside an error, moved twice and deleted again answers as it does fresh" {
  let off = disagreements(
    session([[LeafDeleted, LeafError], [TwiceMoved, LeafDeleted], [LeafError]]),
  );
  assert(off.len() == 0, Some(String::of_bytes_lossy(Bytes::join(off, b"; "))))
}

test "an effect renamed beside a test, a type renamed as a definition moves, then renamed back answers as it does fresh" {
  let off = disagreements(
    session([[EffectRenamed, TestAdded], [TypeRenamed, TwiceMoved], [TypeRenamed, ShopBody]]),
  );
  assert(off.len() == 0, Some(String::of_bytes_lossy(Bytes::join(off, b"; "))))
}

test "a session of renames, an error fixed and a twin added answers as it does fresh" {
  let off = disagreements(
    session([
      [CoreRenamed],
      [EffectRenamed, DefaultEdited, DefaultEdited, DefaultEdited, DefaultEdited, TestAdded],
      [
        TypeRenamed,
        DefaultEdited,
        CoreResultType,
        LeafError,
        LeafPrivate,
        TestAdded,
        DefaultEdited,
        LeafError,
      ],
      [
        CoreRenamed,
        CoreBody,
        DefaultEdited,
        EffectRenamed,
        LeafImportsCore,
        TwinAdded,
        LeafError,
        LeafError,
        CoreResultType,
        LeafPrivate,
        LeafBody,
        ExtraAdded,
        ShopBody,
        TypeRenamed,
        CoreRenamed,
      ],
    ]),
  );
  assert(off.len() == 0, Some(String::of_bytes_lossy(Bytes::join(off, b"; "))))
}

test "a core body edited, then renamed beside a test added, answers as it does fresh" {
  let off = disagreements(session([[CoreBody], [CoreRenamed, TestAdded]]));
  assert(off.len() == 0, Some(String::of_bytes_lossy(Bytes::join(off, b"; "))))
}

/// A `Change` as a test draws one.
fn changes() -> gen::Gen<Change> =
  gen::elements([
    LeafBody,
    LeafSignature,
    LeafPrivate,
    LeafError,
    LeafImportsCore,
    LeafReformatted,
    LeafDeleted,
    CoreRenamed,
    CoreBody,
    CoreResultType,
    TypeRenamed,
    EffectRenamed,
    TwiceMoved,
    DoubledRemoved,
    ShopBody,
    ShopImportsLeaf,
    DefaultEdited,
    TestAdded,
    ExtraAdded,
    ExtraBody,
    TwinAdded,
  ])

/// A `Named` as a test draws one.
fn nameds() -> gen::Gen<Named> =
  gen::map3(gen::bytes(), gen::bool(), gen::bool(), |module: Bytes, shipped: Bool, tested: Bool|
    { module: module, shipped: shipped, tested: tested })

/// A `EntryNamed` as a test draws one.
fn entry_nameds() -> gen::Gen<EntryNamed> =
  gen::map4(
    gen::bytes(),
    gen::bool(),
    gen::bool(),
    gen::bytes(),
    |module: Bytes, shipped: Bool, tested: Bool, name: Bytes|
      { module: module, shipped: shipped, tested: tested, name: name },
  )

/// A `Embedding` as a test draws one.
fn embeddings() -> gen::Gen<Embedding> =
  gen::map2(
    gen::list(
      gen::map2(gen::bytes(), gen::bytes(), |name: Bytes, bytes: Bytes|
        { name: name, bytes: bytes }),
    ),
    gen::option_of(gen::bytes()),
    |files: List<{ name: Bytes, bytes: Bytes }>, refused: Option<Bytes>|
      { files: files, refused: refused },
  )

/// A `Placing` as a test draws one.
fn placings() -> gen::Gen<Placing> =
  gen::map2(gen::any_int(), gen::bytes(), |package: Int, relative: Bytes|
    { package: package, relative: relative })

// Each case checks a program afresh at every step, so a dozen sessions is what a run pays for.
test "an answer through the store is the fresh one at every step of a drawn session of edits" {
  gen::check(
    gen::and_then(gen::int_between(1, 3), |steps: Int|
      gen::list_of_length(gen::list_of(changes(), 3), steps)),
    |edits: List<List<Change>>| { disagreements(session(edits)) == [] },
    cases: 12,
  )
}

test "the store's files answer a drawn session as the store in memory does, whoever else keeps them" {
  gen::check(
    gen::and_then(gen::int_between(1, 3), |steps: Int|
      gen::list_of_length(gen::list_of(changes(), 3), steps)),
    |edits: List<List<Change>>| {
      let steps = session(edits);
      files_apart(steps, Alone) == [] && files_apart(steps, Raced) == []
        && files_apart(steps, Turns) == []
    },
    cases: 4,
  )
}

fn chain_lib(label: Bytes) -> Bytes =
  Bytes::concat_all([
    b"pub effect log { write note[r](msg: String) -> Int }\npub fn base(n: Int) -> Int / {log.note[",
    label,
    b"]} = log.note[",
    label,
    b"](\"n\") + n\npub fn mid(n: Int) -> Int / {log.note[",
    label,
    b"]} = base(n) + 1\n",
  ])

test "a row that moves under a caller leaves an answer through the store the fresh one" {
  let before = [
    { name: b"lib", src: chain_lib(b"a") },
    {
      name: b"top",
      src: b"import lib\npub fn top(n: Int) -> Int / {lib::log.write[a]} = lib::mid(n) + 1\n",
    },
  ];
  let after = [
    { name: b"lib", src: chain_lib(b"b") },
    {
      name: b"top",
      src: b"import lib\npub fn top(n: Int) -> Int / {lib::log.write[b]} = lib::mid(n) + 2\n",
    },
  ];
  assert_eq(
    disagreements([step(b"cold", before), step(b"the row moved under a checked caller", after)]),
    [],
  );
  // A caller whose written row the moved one outgrows is refused through the store as it is fresh.
  let stale = [
    { name: b"lib", src: chain_lib(b"a") },
    {
      name: b"top",
      src: b"import lib\npub fn top(n: Int) -> Int / {lib::log.note[a]} = lib::mid(n) + 1\n",
    },
  ];
  let moved = with_module(stale, b"lib", chain_lib(b"b"));
  assert_eq(disagreements([step(b"cold", stale), step(b"the callee's row moved", moved)]), []);
  let kept = answered_over(answered_over(nothing_held(), stale).held, moved);
  assert(match kept.outcome { Refused(_) -> true, Analysed(_) -> false })
}

test "`keep` written on an imported function, or dropped, leaves an answer through the store the fresh one" {
  let lib = |param: Bytes|
    { name: b"lib", src: Bytes::concat_all([b"pub fn hold(h: ", param, b") -> Int = h(0)\n"]) };
  let app = {
    name: b"app",
    src: b"import lib\npub fn go(g: (Int) -> Int) -> Int = lib::hold(g)\n",
  };
  let lent = [lib(b"(Int) -> Int"), app];
  let kept = [lib(b"keep (Int) -> Int"), app];
  assert_eq(
    disagreements([step(b"cold", lent), step(b"keep written", kept), step(b"keep dropped", lent)]),
    [],
  );
  // The caller lends what `keep` now holds, so it is refused where it was not.
  let warm = answered_over(answered_over(nothing_held(), lent).held, kept);
  assert(match warm.outcome { Refused(_) -> true, Analysed(_) -> false })
}

test "an unused selectively imported name deleted is refused through the store as it is fresh" {
  let s0 = [
    { name: b"lib", src: b"pub fn used() -> Int = 1\npub fn spare() -> Int = 2\n" },
    { name: b"app", src: b"import lib (used, spare)\nfn go() -> Int = used()\n" },
  ];
  let gone = with_module(s0, b"lib", b"pub fn used() -> Int = 1\n");
  assert_eq(
    disagreements([step(b"cold", s0), step(b"warm", s0), step(b"the name deleted", gone)]),
    [],
  );
  match answered_over(answered_over(nothing_held(), s0).held, gone).outcome {
    Analysed(_) -> panic("an import of a deleted name checked"),
    Refused(ds) -> assert(ds.fold(false, |acc: Bool, diag: Diag| acc || diag.code == b"E0101")),
  }
}

test "a narrowed annotation and a relabelled resource leave an answer through the store the fresh one" {
  let narrowing = |row: Bytes|
    [
      {
        name: b"m",
        src: Bytes::concat_all([
          b"pub effect db { read get[r](key: Int) -> Int }\npub fn look(k: Int) -> Int / ",
          row,
          b" = db.get[a](k)\n",
        ]),
      },
    ];
  let labelled = |label: Bytes|
    [
      {
        name: b"m",
        src: Bytes::concat_all([
          b"pub effect db { read get[r](key: Int) -> Int }\npub fn look(k: Int) -> Int / {db.read[",
          label,
          b"]} = db.get[",
          label,
          b"](k)\n",
        ]),
      },
      {
        name: b"u",
        src: Bytes::concat_all([
          b"import m\nfn use_it() -> Int / {m::db.read[",
          label,
          b"]} = m::look(1)\n",
        ]),
      },
    ];
  let renamed = |ty: Bytes|
    [
      {
        name: b"a",
        src: Bytes::concat_all([
          b"pub type ",
          ty,
          b" = | Mk(Int)\npub fn mk() -> ",
          ty,
          b" = Mk(1)\n",
        ]),
      },
      {
        name: b"b",
        src: Bytes::concat_all([b"import a\npub fn get() -> a::", ty, b" = a::mk()\n"]),
      },
      { name: b"c", src: b"import b\npub fn top() -> Bool = { b::get(); true }\n" },
    ];
  assert_eq(
    disagreements([
      step(b"a wide annotation", narrowing(b"{db.read[a], db.read[b]}")),
      step(b"the annotation narrowed", narrowing(b"{db.read[a]}")),
      step(b"a resource", labelled(b"a")),
      step(b"the resource relabelled", labelled(b"z")),
      step(b"a type", renamed(b"T")),
      step(b"the type renamed two modules away", renamed(b"Renamed")),
    ]),
    [],
  )
}

test "the order an answer publishes in is the same through the store as fresh" {
  let s0 = [
    {
      name: b"app",
      src: b"import lib\npub effect audit { write note[log](m: Int) -> Unit }\npub type Wrapped = | Wrap(Int) | Empty\nfn second() -> Int = lib::base()\nfn first() -> Int = second()\n",
    },
    {
      name: b"lib",
      src: b"pub effect db { read get[t](k: Int) -> Int }\npub type Row = | Cell(Int)\npub fn base() -> Int = 1\n",
    },
  ];
  assert_eq(disagreements([step(b"cold", s0), step(b"warm", s0)]), [])
}

fn performing(extra: List<Source>) -> List<Source> =
  extra.concat([
    { name: b"core", src: b"pub effect db {\n  read get[r](key: Int) -> Int\n}\n" },
    {
      name: b"shop",
      src: b"import core\npub fn touch(k: Int) -> Int / {core::db.read[cart]} = core::db.get[cart](k)\ntest \"touch is handled\" {\n  assert_eq(handle touch(1) with { core::db.get[cart](k) -> k + 1, }, 2)\n}\n",
    },
  ])

/// A row names its effects by name, so a new declaration that looks like one must not be taken
/// for it: the answer through the store stays the fresh one.
fn seeded_agrees(before: List<Source>, after: List<Source>) -> Bool / {abort.raise} =
  disagreements([step(b"before", before), step(b"after", after)]) == []

test "adding a look-alike effect keeps an answer through the store the fresh one" {
  let alike = [{ name: b"aaa", src: b"pub effect alpha {\n  read get[r](key: Int) -> Int\n}\n" }];
  assert(seeded_agrees(performing([]), performing([])));
  assert(seeded_agrees(performing([]), performing(alike)))
}

test "adding an unrelated effect keeps an answer through the store the fresh one" {
  let other = [{ name: b"aaa", src: b"pub effect alpha {\n  write put(key: Int) -> Int\n}\n" }];
  assert(seeded_agrees(performing([]), performing(other)))
}

// --- What a store keeps reads back ------------------------------------------------------------

/// Every answer the query `name` kept over a check of a small program, as its body wrote it.
fn kept_answers(name: Bytes) -> List<Bytes> / {abort.raise} = {
  let held = fixed_over(nothing_held(), layered(b"pub fn step(n: Int) -> Int = n + 1\n"), []).held;
  memo::current(held).fold([], |acc: List<Bytes>, _key: Bytes, r: Record|
    if r.query != name { acc }
    else { match held.outputs.get(r.output) { Some(out) -> acc.push(out), None -> acc } })
}

/// Whether there are `answers`, and each reads by `codec` as a value that writes its bytes again.
fn read_back<a>(answers: List<Bytes>, codec: bin::BinCodec<a>) -> Bool / {abort.raise} =
  answers.len() > 0
    && answers.fold(true, |ok: Bool, b: Bytes| {
      let value = decoded(b, codec, "a kept answer");
      ok && bin::encode(value, codec) == b && bin::round_trips(value, codec)
    })

test "a module's answer reads back as it was filed" {
  assert(read_back(kept_answers(module_query()), module_answer_bin()))
}

test "a module read for its owners reads back as it was filed" {
  assert(read_back(kept_answers(owners_query()), owners_answer_bin()))
}

test "what hashing fixed of a group reads back as it was filed" {
  assert(read_back(kept_answers(group_hash_query()), group_hashes_bin()))
}

test "a module's imports read back as they were filed" {
  assert(read_back(kept_answers(imports_query()), imports_of_bin()))
}

test "a module's hashes read back as they were filed" {
  assert(read_back(kept_answers(hashes_query()), hash_answer_bin()))
}

test "what a module query is asked reads back as it was asked" {
  gen::check4(
    nameds(),
    entry_nameds(),
    embeddings(),
    placings(),
    |n: Named, e: EntryNamed, m: Embedding, p: Placing| {
      bin::round_trips(n, named_bin()) && bin::round_trips(e, entry_named_bin())
        && bin::round_trips(m, embedding_bin())
        && bin::round_trips(p, placing_bin())
    },
  )
}

// --- What an edit runs again ------------------------------------------------------------------

/// How many times the run ran the body of the query `name`.
fn ran_of(run: Run, name: Bytes) -> Int =
  tallies(run).fold(0, |n: Int, t: Tally| if t.query == name { t.ran } else { n })

/// Each group the run ran the body of the query `name` for, a group's check or its hashing.
fn groups_ran(run: Run, name: Bytes) -> List<GroupNamed> / {abort.raise} =
  ran_for(run, name).map(|b: Bytes| decoded(b, group_named_bin(), "a group's names"))

fn group_in(module: Bytes, owners: List<Bytes>) -> GroupNamed =
  { module: module, shipped: false, tested: false, owners: owners }

/// What a load answered: each module's answer, what hashing fixed of each, the warnings its root
/// modules answered, and what each read of a pack below it answered, in order.
type Load = {
  held: Held,
  run: Run,
  answers: List<Answered>,
  fixing: Fixing,
  warnings: List<Diag>,
  fetched: List<Bytes>,
}

/// What each module of `sources`, and each of `shipped` they pull, answered through `held`.
fn fixed_over(held: Held, sources: List<Source>, shipped: List<Source>) -> Load / {abort.raise} =
  fixed_beside(held, None, sources, shipped)

/// [`fixed_over`] with `packed` below `held`, as a pack the load does not trust: it lists no shipped
/// files the pack was made over.
fn fixed_beside(
  held: Held,
  packed: Option<packs::Written>,
  sources: List<Source>,
  shipped: List<Source>,
) -> Load / {abort.raise} = {
  let w = world_of(
    { root: b"", manifest: None, files: sources.map(|s: Source| { module: s.name, text: s.src }) },
    [],
  );
  let texts = shipped.fold(Map::new(), |acc: Map<Bytes, Bytes>, s: Source|
    acc.insert(s.name, s.src));
  let held_text = |name: Bytes| texts.get(name);
  let names = shipped.map(|s: Source| s.name);
  handle {
    let done = over_decoding(
      held,
      |path: String, offset: Int, len: Int| {
        let found = packs::frame_in(packed, path, offset, len);
        match found { Some(b) -> fetching.fetched(b), None -> () };
        found
      },
      b"",
      |kind: Bytes, at: Bytes|
        looked(w, held_text, held_text, || names, nothing_embedded, kind, at),
      || {
        let qs = fresh_registry();
        let all = asked_all(qs, w.own, [], false, started(qs));
        let fixed = hashed_all(qs, w.own, all.value.pulled, false, all.run);
        {
          run: fixed.run,
          answers: all.value.answers,
          fixing: fixed.value,
          warnings: root_warnings(all.value.answers, sources.len()),
        }
      },
    );
    {
      held: done.held,
      run: done.value.run,
      answers: done.value.answers,
      fixing: done.value.fixing,
      warnings: done.value.warnings,
    }
  } with {
    var fetched: List<Bytes> = [],
    fetching.fetched(b) -> {
      fetched = fetched.push(b);
    },
    return d ->
      {
        held: d.held,
        run: d.run,
        answers: d.answers,
        fixing: d.fixing,
        warnings: d.warnings,
        fetched: fetched,
      },
  }
}

/// Each frame of the pack a load fetched.
effect fetching {
  write fetched(b: Bytes) -> Unit
}

/// Cycles, an effect, a specification, a law, a cost, a test over cases and an `opaque` type, across
/// modules.
fn hashed_fixture() -> List<Source> =
  [
    {
      name: b"base",
      src: b"pub effect tick { write beat() -> Unit }\npub opaque type Coin = new { cents: Int }\npub fn coin(n: Int) -> Coin = { cents: n }\npub fn cents(c: Coin) -> Int = c.cents\npub fn even(n: Int) -> Bool / { tick.write } = if n <= 0 { true } else { tick.beat(); odd(n - 1) }\nfn odd(n: Int) -> Bool / { tick.write } = if n <= 0 { false } else { even(n - 1) }\nfn spare() -> Int = 3\npub fn half(n: Int) -> Int requires n >= 0 ensures result <= n = n / 2\nlaw \"halving shrinks\" forall (n: Int) where n >= 0 { half(n) <= n }\npub fn width(b: Bytes) -> Int\n  cost b.len()\n= b.len()\n",
    },
    {
      name: b"app",
      src: b"import base\npub fn worth(n: Int) -> Int = base::cents(base::coin(base::half(n)))\ntest \"worth\" { assert_eq(worth(4), 2) }\n",
    },
  ]

test "a program hashed from its modules' answers hashes as it does hashed whole, and warns alike" {
  [shop(), hashed_fixture()].fold((), |u: Unit, sources: List<Source>| {
    let fixed = fixed_over(nothing_held(), sources, []);
    match ((
        staged_pulling_std_with(sources, []).hashed,
        staged_pulling_std_with(sources, [], fixed: fixed.fixing).hashed,
      )) {
      (Ok(whole), Ok(taken)) -> {
        assert_eq(taken.hashes, whole.hashes);
        assert_eq(taken.unused, []);
        assert_eq(owned::told(fixed.warnings), owned::told(whole.unused))
      },
      _ -> panic("the fixture hashes"),
    }
  })
}

test "a program's tables made from its modules' answers are the tables of its check whole" {
  [shop(), hashed_fixture(), faceted(), faceted().reverse()].fold(
    (),
    |u: Unit, sources: List<Source>| {
      let fixed = fixed_over(nothing_held(), sources, []);
      match analyse_pulling_std_with(sources, [], no_rows()).out {
        Refused(_) -> panic("the fixture checks"),
        Analysed(w) -> {
          let answered = answered_program(
            fixed.answers.map(|a: Answered| facts_answered(a.answer)),
            fixed.fixing,
            Map::new(),
            true,
            true,
            w.warnings,
            w.manifest,
            w.packages,
            w.pins,
            w.module_packages,
            w.embeds,
          );
          assert_eq(answered.view.checked.defs, w.checked.defs);
          assert_eq(answered.view.frame.tagged, view_of(w).frame.tagged);
          assert_eq(answered.view, view_of(w));
          let made = view_dump(answered.view, None);
          let whole = dump_of(Analysed(w));
          assert_eq(made.defs, whole.defs);
          assert_eq(made.tests, whole.tests);
          assert_eq(made.effects, whole.effects);
          assert_eq(made.ctors, whole.ctors);
          assert_eq(made.hashes, whole.hashes);
          assert_eq(made.keys, whole.keys);
          assert_eq(made.emitter_roots, whole.emitter_roots);
          assert_eq(made.rows, whole.rows);
          let walked = |b: Bytes|
            match bin::decode(b, walked_facts_bin()) {
              Ok(w) -> w,
              Err(_) -> panic("walked facts decode"),
            };
          let a = walked(made.walked);
          let b = walked(whole.walked);
          assert_eq(a.pure, b.pure);
          assert_eq(a.orders, b.orders);
          assert_eq(a.loose.label_sites, b.loose.label_sites);
          assert_eq(a.loose.updates, b.loose.updates);
          assert_eq(a.loose.ops, b.loose.ops);
          assert_eq(a.loose.refs, b.loose.refs);
          assert_eq(a.loose.operands, b.loose.operands);
          assert_eq(a.loose.tries, b.loose.tries);
          assert_eq(a.loose.typed, b.loose.typed);
          assert_eq(a.loose.types, b.loose.types);
          assert_eq(made.walked, whole.walked);
          assert_eq(made, whole)
        },
      }
    },
  )
}

/// A program, and a shipped module it reaches in part: a generic over a numeric type, a tagged
/// literal's parser, what a type states, a call on a value naming an argument, and functions
/// nothing reaches.
fn pulling() -> { user: List<Source>, shipped: List<Source> } =
  {
    user: [
      {
        name: b"main",
        src: b"import std.shapes\nimport std.shapes (origin, far, Tag, size)\npub fn main() -> Int = far(origin()) + size(0 - 1) + shapes\"two\"\npub fn named(t: Tag) -> String = \"{t}\"\npub fn ranked(t: Tag) -> Int = t.rank(more: 2)\ntest \"sized\" { assert_eq(size(0 - 3), 3) }\n",
      },
    ],
    shipped: [
      {
        name: b"std.shapes",
        src: b"pub type Point = { x: Int, y: Int }\npub fn origin() -> Point = { x: 0, y: 0 }\npub fn far(p: Point) -> Int requires p.x >= 0 = p.x + helper(p)\nfn helper(p: Point) -> Int = p.y\nfn spare() -> Int = 5\npub fn unreached() -> Int requires spare() > 0 = spare()\npub type Tag = | A | B\nfn tag_text(t: Tag) -> String = match t { A -> \"a\", B -> \"b\" }\nshow for Tag by tag_text\npub fn Tag::rank(t: Tag, by: Int = 1, more: Int = 0) -> Int = match t { A -> by, B -> by + more }\npub fn size<a>(n: a) -> a where numeric(a) = { let zero: a = numeric_of_int(0); if n < zero { zero - n } else { n } }\npub fn spare_size<a>(n: a) -> a where numeric(a) = n\npub fn literal(text: String) -> Result<Int, { message: String, offset: Int }> = if text == \"two\" { Ok(2) } else { Err({ message: \"not two\", offset: 0 }) }\ntest \"shipped\" { let t = A; assert_eq(far(origin()), t.rank(by: 0)) }\n",
      },
    ],
  }

test "a program assembled from its modules' answers, a shipped module's among them, is the program checked whole" {
  let f = pulling();
  let w = world_of(
    { root: b"", manifest: None, files: f.user.map(|s: Source| { module: s.name, text: s.src }) },
    [],
  );
  let texts = f.shipped.fold(Map::new(), |acc: Map<Bytes, Bytes>, s: Source|
    acc.insert(s.name, s.src));
  let held = |name: Bytes| texts.get(name);
  let names = f.shipped.map(|s: Source| s.name);
  // As a program reads a shipped module, cut to its reach; and as a run over the standard library's
  // own tests reads it, whole and with its tests.
  [{ tested: false, reached: true }, { tested: true, reached: false }].fold(
    (),
    |u: Unit, mode: { tested: Bool, reached: Bool }| {
      let done = over_decoding(
        nothing_held(),
        packs::no_pack,
        b"",
        |kind: Bytes, at: Bytes| looked(w, held, held, || names, nothing_embedded, kind, at),
        || {
          let qs = fresh_registry();
          let all = asked_all(
            qs,
            w.own,
            if mode.tested { names } else { [] },
            mode.tested,
            started(qs),
          );
          let fixed = hashed_all(qs, w.own, all.value.pulled, mode.tested, all.run);
          { answers: all.value.answers, pulled: all.value.pulled, fixing: fixed.value }
        },
      ).value;
      let loaded = answered_load(
        f.user.map(|s: Source| s.name),
        { root: b"", manifest: None, supplied: [] },
        done.answers.fold(Map::new(), |acc: Map<Bytes, ModuleShape>, a: Answered|
          acc.insert(a.module, a.answer.shape)),
        done.fixing,
        done.pulled,
        names,
        texts,
        true,
        mode.reached,
        root_warnings(done.answers, f.user.len()),
      );
      match analyse_pulling_std_with(f.user, f.shipped, no_rows(), reached: mode.reached).out {
        Refused(_) -> panic("the fixture checks"),
        Analysed(whole) -> {
          let view = view_of(whole);
          let assembled = view_answered(
            loaded.frame,
            loaded.reads,
            done.answers.fold(Map::new(), |acc: Map<Bytes, ModuleAnswer>, a: Answered|
              acc.insert(a.module, a.answer)),
          );
          assert_eq(loaded.pulled, [b"std.shapes"]);
          assert_eq(assembled.checked.tests.len(), if mode.tested { 2 } else { 1 });
          assert_eq(loaded.frame.outlines, view.frame.outlines);
          assert_eq(assembled.checked.defs, view.checked.defs);
          assert_eq(assembled.checked.facts, view.checked.facts);
          assert_eq(assembled.checked, view.checked);
          // The call on a value stores what its check found, which a hashing before it has not.
          match staged_pulling_std_with(f.user, f.shipped, reached: mode.reached).hashed {
            Ok(h) ->
              assert(
                checked_body(body_named(h.hashes.bodies, b"main.ranked"), Map::new())
                  != body_named(view.frame.hashes.bodies, b"main.ranked"),
              ),
            Err(_) -> panic("the fixture hashes"),
          };
          assert_eq(loaded.frame.hashes, view.frame.hashes);
          assert_eq(assembled, view);
          assert_eq(functions_of(loaded.frame), assembled.checked.defs.len());
          assert_eq(tests_of(loaded.frame, 1), 1);
          assert_eq(view_dump(assembled, None), dump_of(Analysed(whole)))
        },
      }
    },
  )
}

/// The stored body `bodies` holds of `name`.
fn body_named(bodies: List<{ name: Bytes, body: Bytes }>, name: Bytes) -> Bytes / {abort.raise} =
  match bodies.find(|b: { name: Bytes, body: Bytes }| b.name == name) {
    Some(b) -> b.body,
    None -> panic("no body is stored of " ++ String::of_bytes_lossy(name)),
  }

test "a body that calls on a value stores what its check found, read whole or answered module by module" {
  // Alone, and after a module it imports, which a check of it against its imports places first.
  [
    [
      {
        name: b"m",
        src: b"pub type T = | T(Int)\nfn T::size(t: T) -> Int = match t { T(n) -> n }\npub fn f(t: T) -> Int = t.size()\n",
      },
    ],
    [
      {
        name: b"low",
        src: b"pub type T = | T(Int)\npub fn T::size(t: T) -> Int = match t { T(n) -> n }\npub fn T::scaled(t: T, by: Int = 2, plus: Int = 0) -> Int = t.size() * by + plus\n",
      },
      { name: b"m", src: b"import low\npub fn f(t: low::T) -> Int = t.scaled(plus: 3)\n" },
    ],
  ].fold((), |u: Unit, sources: List<Source>| {
    let answered = fixed_over(nothing_held(), sources, []).fixing.nodes.fold(
      b"",
      |acc: Bytes, x: Fixed| if x.name == b"m.f" { x.body } else { acc },
    );
    match analyse_pulling_std_with(sources, [], no_rows()).out {
      Refused(_) -> panic("the fixture checks"),
      Analysed(w) -> assert_eq(body_named(w.hashes.bodies, b"m.f"), answered),
    };
    // Hashed before the check, the body is filed under no hash until the check says what it calls.
    match staged_pulling_std_with(sources, []).hashed {
      Ok(h) -> {
        let unchecked = body_named(h.hashes.bodies, b"m.f");
        assert_eq(body_key(unchecked), None);
        assert(checked_body(unchecked, Map::new()) != answered)
      },
      Err(_) -> panic("the fixture hashes"),
    }
  })
}

fn layered(lib: Bytes) -> List<Source> =
  [
    { name: b"lib", src: lib },
    { name: b"app", src: b"import lib\npub fn go(n: Int) -> Int = lib::step(n) + 1\n" },
    { name: b"aside", src: b"pub fn alone() -> Int = 7\n" },
  ]

test "a run over an unchanged program runs no query again" {
  let sources = layered(b"pub fn step(n: Int) -> Int = n + 1\n");
  let cold = answered_over(nothing_held(), sources);
  assert_eq(ran_of(cold.run, module_query()), 3);
  assert_eq(ran_total(answered_over(cold.held, sources).run), 0)
}

// A body's summary says what its answer is in terms of its arguments, which an importer's check
// reads: an edit that leaves the summary alone leaves every importer's answer standing.
test "a body edit checks its own definition again and none that reads it" {
  let before = layered(b"pub fn step(n: Int) -> Int = n * 3\n");
  let after = layered(b"pub fn step(n: Int) -> Int = n * 4\n");
  let warm = answered_over(answered_over(nothing_held(), before).held, after);
  assert_eq(groups_ran(warm.run, group_query()), [group_in(b"lib", [b"step"])]);
  assert_eq(ran_of(warm.run, module_query()), 1);
  assert_eq(said(warm.outcome), said(analyse(parse_all(after))))
}

/// Two functions that call one another, so one unit, and a third that calls into it. `base` is
/// what `even` answers at zero, and `step` the parameter `odd` counts down.
fn paired(base: Bytes, step: Bytes) -> List<Source> =
  [
    {
      name: b"lib",
      src: Bytes::concat_all([
        b"pub fn even(n: Int) -> Bool = if n <= 0 { ",
        base,
        b" } else { odd(n - 1) }\n\npub fn odd(",
        step,
        b": Int) -> Bool = if ",
        step,
        b" <= 0 { false } else { even(",
        step,
        b" - 1) }\n\npub fn both(n: Int) -> Bool = even(n) || odd(n)\n",
      ]),
    },
  ]

/// Each owner the run ran the body of the query `name` for.
fn owners_ran(run: Run, name: Bytes) -> List<Bytes> / {abort.raise} =
  ran_for(run, name).map(|b: Bytes| decoded(b, owner_named_bin(), "an owner's name").owner)

test "a group that refused and is mended checks nothing again, each record taken back" {
  let source = |body: Bytes|
    [
      {
        name: b"lib",
        src: Bytes::concat_all([
          b"pub fn base(n: Int) -> Int = ",
          body,
          b"\n\npub fn over(n: Int) -> Int = base(n) + 1\n\npub fn top(n: Int) -> Int = over(n) * 2\n\n",
          b"pub fn apart(n: Int) -> Int = n - 1\n",
        ]),
      },
    ];
  let cold = answered_over(nothing_held(), source(b"n + 1"));
  let broken = answered_over(cold.held, source(b"n + true"));
  assert_eq(said(broken.outcome), said(analyse(parse_all(source(b"n + true")))));
  let mended = answered_over(broken.held, source(b"n + 1"));
  assert_eq(said(mended.outcome), said(cold.outcome));
  assert_eq(groups_ran(mended.run, group_query()), [])
}

test "a group that reads one that refuses waits for it unchecked, and its module says what a check of it whole says" {
  let source = |body: Bytes|
    [
      {
        name: b"lib",
        src: Bytes::concat_all([
          b"pub fn base(n: Int) -> Int = ",
          body,
          b"\n\npub fn over(n: Int) -> Int = base(n) + 1\n\npub fn top(n: Int) -> Int = over(n) * 2\n\n",
          b"pub fn apart(n: Int) -> Int = n - 1\n",
        ]),
      },
    ];
  let cold = answered_over(nothing_held(), source(b"n + 1"));
  let broken = answered_over(cold.held, source(b"n + true"));
  assert_eq(said(broken.outcome), said(analyse(parse_all(source(b"n + true")))));
  let waiting = memo::current(broken.held).fold([], |acc: List<Bytes>, _key: Bytes, r: Record|
    if r.query != group_query() { acc } else {
      match broken.held.outputs.get(r.output) {
        None -> acc,
        Some(out) -> {
          let a = owned::group_whole(decoded(out, owned::kept_group_bin(), "a group's answer"));
          if a.refused.any(|d: Diag| d.message.index_of(b" waits on ") != None) {
            acc.concat(decoded(r.input, group_named_bin(), "a group's names").owners)
          } else { acc }
        },
      }
    });
  assert_eq(waiting.sort(), [b"over", b"top"])
}

test "a unit whose group refuses is hashed without asking its own members' hashes" {
  let keyed = |name: Bytes, statement: Bytes, more: Bytes|
    [
      {
        name: b"lib",
        src: Bytes::concat_all([
          b"pub type Tag =\n  | Tag(Int)",
          more,
          b"\n\npub fn ",
          name,
          b"(t: Tag) -> Int =\n  match t {\n    Tag(n) -> n,\n  }\n\n",
          statement,
          b"\n\npub fn tagged(n: Int) -> Tag = Tag(n)\n",
        ]),
      },
      {
        name: b"app",
        src: b"import lib\n\npub fn same(a: lib::Tag, b: lib::Tag) -> Bool = a == b\n",
      },
    ];
  let fixture = keyed(b"tag_key", b"key for Tag by tag_key", b"");
  assert_eq(
    disagreements([
      step(b"a type keyed by its function", fixture),
      step(
        b"a variant its function does not match",
        keyed(b"tag_key", b"key for Tag by tag_key", b" | Other"),
      ),
      step(b"back", fixture),
      step(b"the function renamed", keyed(b"tag_key_moved", b"key for Tag by tag_key", b"")),
      step(b"back again", fixture),
      step(b"the statement dropped", keyed(b"tag_key", b"", b"")),
      step(b"and back", fixture),
    ]),
    [],
  )
}

test "a body edited in a unit of owners that call one another walks that owner alone, and the unit is settled again" {
  let before = paired(b"true", b"n");
  let cold = answered_over(nothing_held(), before);
  assert_eq(said(cold.outcome), said(analyse(parse_all(before))));
  let after = paired(b"n == 0", b"n");
  let warm = answered_over(cold.held, after);
  assert_eq(owners_ran(warm.run, typed_query()), [b"even"]);
  assert(groups_ran(warm.run, group_query()).contains(group_in(b"lib", [b"even", b"odd"])));
  assert_eq(said(warm.outcome), said(analyse(parse_all(after))));
  // A signature its sibling reads walks the sibling too.
  let renamed = paired(b"n == 0", b"left");
  let again = answered_over(warm.held, renamed);
  let rewalked = owners_ran(again.run, typed_query());
  assert(rewalked.len() == 2 && rewalked.contains(b"even") && rewalked.contains(b"odd"));
  assert_eq(said(again.outcome), said(analyse(parse_all(renamed))));
  // And one walk that refuses refuses the unit with what a fresh check says of it.
  let broken = paired(b"n", b"left");
  assert_eq(said(answered_over(again.held, broken).outcome), said(analyse(parse_all(broken))))
}

/// `paired`'s unit with a `Count` handed along, which holds a `Step`: `even` names neither type,
/// only `odd` and `made`, whose signatures name `Count`. `more` is what else a `Step` may be. The
/// functions after them are enough that a few groups to check again are checked each alone.
fn counted(more: Bytes) -> List<Source> =
  [
    {
      name: b"lib",
      src: range(0, 80).fold(
        Bytes::concat_all([
          b"pub type Step = | Step(Int)",
          more,
          b"\n\npub type Count = | Count(Step)\n\npub fn made(n: Int) -> Count = Count(Step(n))\n\n",
          b"pub fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1, made(n)) }\n\n",
          b"pub fn odd(n: Int, _c: Count) -> Bool = if n <= 0 { false } else { even(n - 1) }\n",
        ]),
        |src: Bytes, i: Int|
          Bytes::concat_all([
            src,
            b"\npub fn pad",
            Bytes::of_string(i.to_string()),
            b"() -> Int = 0\n",
          ]),
      ),
    },
  ]

test "a walk taken from a check of its whole module is made again when what a sibling's signature reaches moves" {
  let before = counted(b"");
  let cold = answered_over(nothing_held(), before);
  assert_eq(said(cold.outcome), said(analyse(parse_all(before))));
  // Every signature `even` reads is as it was: only what they reach moved.
  let after = counted(b" | Rest");
  let warm = answered_over(cold.held, after);
  assert(owners_ran(warm.run, typed_query()).contains(b"even"));
  assert_eq(said(warm.outcome), said(analyse(parse_all(after))))
}

/// Two types whose `len` each call `len` on a value: one unit by what their texts mention, and
/// two groups by what their bodies call. `stack` is what `Stack::len` answers of its list, and
/// `queue` what `Queue::len` answers of its front.
fn lengths(stack: Bytes, queue: Bytes) -> List<Source> =
  [
    {
      name: b"lib",
      src: Bytes::concat_all([
        b"pub type Stack = | Stack(List<Int>)\n\npub type Queue = | Queue(List<Int>, List<Int>)\n\n",
        b"pub fn Stack::len(s: Stack) -> Int = match s { Stack(xs) -> ",
        stack,
        b" }\n\npub fn Queue::len(q: Queue) -> Int = match q { Queue(f, b) -> ",
        queue,
        b" + b.len() }\n",
      ]),
    },
  ]

test "owners that only mention one another are a unit of groups: a body edited walks its owner, settles its group and signs nothing" {
  let before = lengths(b"xs.len()", b"f.len()");
  let cold = answered_over(nothing_held(), before);
  assert_eq(said(cold.outcome), said(analyse(parse_all(before))));
  let after = lengths(b"xs.len() + 0", b"f.len()");
  let warm = answered_over(cold.held, after);
  assert_eq(owners_ran(warm.run, typed_query()), [b"Stack::len"]);
  assert_eq(groups_ran(warm.run, group_query()), [group_in(b"lib", [b"Stack::len"])]);
  assert_eq(ran_of(warm.run, signatures_query()), 0);
  assert_eq(ran_of(warm.run, cycles_query()), 0);
  assert_eq(said(warm.outcome), said(analyse(parse_all(after))));
  // A call added from one group into the other cuts the unit again and walks the caller alone.
  let calling = lengths(b"xs.len() + 0", b"Stack(f).len()");
  let called = answered_over(warm.held, calling);
  assert_eq(owners_ran(called.run, typed_query()), [b"Queue::len"]);
  assert_eq(ran_of(called.run, cycles_query()), 1);
  assert_eq(said(called.outcome), said(analyse(parse_all(calling))));
  // What the called group settles is its caller's to read: the caller is not walked again.
  let moved = lengths(b"0", b"Stack(f).len()");
  let settled = answered_over(called.held, moved);
  assert_eq(owners_ran(settled.run, typed_query()), [b"Stack::len"]);
  assert_eq(said(settled.outcome), said(analyse(parse_all(moved))))
}

test "a definition added above another checks itself and no other" {
  let cold = answered_over(nothing_held(), layered(b"pub fn step(n: Int) -> Int = n + 1\n"));
  let above = layered(b"pub fn first() -> Int = 1\n\npub fn step(n: Int) -> Int = n + 1\n");
  let warm = answered_over(cold.held, above);
  assert_eq(groups_ran(warm.run, group_query()), [group_in(b"lib", [b"first"])]);
  assert_eq(said(warm.outcome), said(analyse(parse_all(above))))
}

test "a signature edit checks the definitions that read it again, and no other" {
  let cold = answered_over(nothing_held(), layered(b"pub fn step(n: Int) -> Int = n + 1\n"));
  let widened = b"pub fn step(n: Int, by: Int = 1) -> Int = n + by\n";
  let warm = answered_over(cold.held, layered(widened));
  assert_eq(groups_ran(warm.run, group_query()), [
    group_in(b"lib", [b"step"]),
    group_in(b"app", [b"go"]),
  ]);
  assert_eq(ran_of(warm.run, module_query()), 2);
  assert_eq(said(warm.outcome), said(analyse(parse_all(layered(widened)))))
}

/// A type with a function of its own, a module that answers a value of it, and `app`, which
/// imports that module alone.
fn shaped(shapes: Bytes, app: Bytes) -> List<Source> =
  [
    { name: b"shapes", src: shapes },
    { name: b"made", src: b"import shapes (Shape, Square)\npub fn made() -> Shape = Square(2)\n" },
    { name: b"app", src: app },
  ]

fn shapes_src() -> Bytes =
  b"pub type Shape = | Square(Int)\npub fn Shape::area(s: Shape) -> Int = match s { Square(n) -> n * n }\n"

fn grown_src() -> Bytes =
  b"pub fn Shape::grown(s: Shape, by: Int) -> Shape = match s { Square(n) -> Square(n + by) }\n"

fn sized_src() -> Bytes =
  b"import made\npub fn size() -> Int = made::made().area()\n\npub fn two() -> Int = [made::made(), made::made()].len()\n"

test "a function added to a type checks itself alone, and one re-signed the definitions that call it on a value" {
  let cold = answered_over(nothing_held(), shaped(shapes_src(), sized_src()));
  let added = answered_over(cold.held, shaped(shapes_src().concat(grown_src()), sized_src()));
  assert_eq(groups_ran(added.run, group_query()), [group_in(b"shapes", [b"Shape::grown"])]);
  let resigned = edited(
    shaped(shapes_src().concat(grown_src()), sized_src()),
    b"shapes",
    b"area(s: Shape) -> Int = match s",
    b"area(of: Shape) -> Int = match of",
  );
  let warm = answered_over(added.held, resigned);
  assert_eq(groups_ran(warm.run, group_query()), [
    group_in(b"shapes", [b"Shape::area"]),
    group_in(b"app", [b"size"]),
  ]);
  assert_eq(said(warm.outcome), said(analyse(parse_all(resigned))));
  assert(match warm.outcome { Analysed(_) -> true, Refused(_) -> false })
}

test "a call on a value leaves an answer through the store the fresh one as its type's functions come, change and go" {
  let s0 = shaped(shapes_src(), sized_src());
  let s1 = edited(s0, b"shapes", b"Square(n) -> n * n", b"Square(n) -> n * n + 0");
  let s2 = edited(
    s1,
    b"shapes",
    b"area(s: Shape) -> Int = match s",
    b"area(of: Shape) -> Int = match of",
  );
  let s3 = edited(s2, b"app", b"made::made().area()", b"made::made().grown(1).area()");
  let s4 = edited(s3, b"shapes", b"pub fn Shape::area", grown_src().concat(b"pub fn Shape::area"));
  let s5 = edited(s4, b"shapes", b"by: Int) -> Shape", b"by: Int) -> Int");
  let s6 = with_module(
    s4,
    b"named",
    b"import shapes (Shape, Square)\npub fn unit() -> Int = Shape::area(Shape::grown(Square(0), 1))\n",
  );
  assert_eq(
    disagreements([
      step(b"cold", s0),
      step(b"a body edit to a type's function", s1),
      step(b"a type's function re-signed", s2),
      step(b"a call of a function its type has not", s3),
      step(b"the function added", s4),
      step(b"the function answering another type", s5),
      step(b"a module naming the functions through the type", s6),
      step(b"the function gone again", edited(s6, b"shapes", grown_src(), b"")),
      step(b"unchanged", edited(s6, b"shapes", grown_src(), b"")),
    ]),
    [],
  )
}

/// What a check through the store refuses of `user` over the shipped modules `shipped`.
fn refused_over(user: List<Source>, shipped: List<Source>) -> List<Bytes> / {abort.raise} =
  fixed_over(nothing_held(), user, shipped).answers.fold([], |acc: List<Bytes>, a: Answered|
    acc.concat(a.answer.refused.map(|d: Diag| d.message)))

test "a module a language type's home module imports names the type's functions and reads no home module" {
  assert_eq(
    refused_over(
      [{ name: b"main", src: b"import std.bytes\npub fn main(b: Bytes) -> Bytes = b.twice()\n" }],
      [
        {
          name: b"std.bytes",
          src: b"import std.radix\npub fn Bytes::twice(b: Bytes) -> Bytes = radix::joined(b, b)\n",
        },
        {
          name: b"std.radix",
          src: b"pub fn joined(a: Bytes, b: Bytes) -> Bytes = Bytes::concat_all([a, b])\n",
        },
      ],
    ),
    [],
  )
}

test "a transparent function read from another module calls what its own module can see" {
  assert_eq(
    refused_over(
      [
        {
          name: b"main",
          src: b"import std.picks\npub fn main(xs: List<Int>) -> Option<Int> = picks::pick(xs)\n",
        },
      ],
      [
        {
          name: b"std.list",
          src: b"pub fn List::second<a>(xs: List<a>) -> Option<a> = xs.at(1)\n",
        },
        {
          name: b"std.picks",
          src: b"import std.list\npub transparent fn pick(xs: List<Int>) -> Option<Int> = xs.second()\n",
        },
      ],
    ),
    [],
  )
}

test "a call on a value reads a home module through any import of it, or none" {
  let shipped = [
    {
      name: b"std.bytes",
      src: b"pub fn Bytes::twice(b: Bytes) -> Bytes = b.concat(b)\n\npub fn other(b: Bytes) -> Bytes = b\n",
    },
    {
      name: b"std.through",
      src: b"import std.bytes\n\npub fn same(b: Bytes) -> Bytes = b.twice()\n",
    },
  ];
  let main = |imports: Bytes|
    [{ name: b"main", src: imports.concat(b"pub fn main(b: Bytes) -> Bytes = b.twice()\n") }];
  assert_eq(refused_over(main(b"import std.bytes\n"), shipped), []);
  assert_eq(refused_over(main(b"import std.bytes (other)\n"), shipped), []);
  assert_eq(refused_over(main(b"import std.bytes as held\n"), shipped), []);
  assert_eq(refused_over(main(b"import std.through\n"), shipped), []);
  // A module outside the library reads it with no import at all.
  assert_eq(refused_over(main(b""), shipped), [])
}

test "a group checked against entries reads what a function it calls on a value settled, though its text names nothing of that function's module" {
  assert_eq(
    refused_over(
      [
        {
          name: b"main",
          src: b"import std.list\npub fn total(xs: List<Int>) -> Int =\n  match xs.rest() { Some(t) -> 1 + total(t), None -> 0 }\n",
        },
      ],
      [
        {
          name: b"std.list",
          src: b"pub fn List::rest<a>(xs: List<a>) -> Option<List<a>> =\n  match xs { [] -> None, [_, ..tail] -> Some(tail) }\n",
        },
      ],
    ),
    [],
  )
}

test "a shipped module is read as itself among the modules that stand in for what it reads" {
  assert_eq(
    refused_over(
      [
        {
          name: b"main",
          src: b"import std.words (words)\npub fn main() -> Int = words(\"a\").len()\n",
        },
      ],
      [
        {
          name: b"std.words",
          src: b"import std.parts\n\npub fn words(s: String) -> List<String> = words_from(s)\n\nfn words_from(s: String) -> List<String> = parts::split(s)\n",
        },
        { name: b"std.parts", src: b"pub fn split(s: String) -> List<String> = [s]\n" },
      ],
    ),
    [],
  )
}

test "a language type's function is found in a module that names a constructor as the type is named" {
  assert_eq(
    refused_over(
      [
        {
          name: b"main",
          src: b"import std.float\n\npub type Value = | Float(Float) | Text(String)\n\npub fn main() -> Value = Float(Float::least())\n",
        },
      ],
      [{ name: b"std.float", src: b"pub fn Float::least() -> Float = 0.0\n" }],
    ),
    [],
  )
}

fn tables_of(
  answers: List<Answered>,
) -> List<{ module: Bytes, tables: ModuleTables }> / {abort.raise} =
  answers.map(|a: Answered| { module: a.module, tables: tables_answered(a.answer) })

fn spread(lib: Bytes) -> List<Source> =
  [
    { name: b"lib", src: lib },
    {
      name: b"app",
      src: b"import lib\npub fn go(n: Int) -> Int = lib::step(n) + 1\n\npub fn again(n: Int) -> Int = lib::step(n) * 2\n\npub fn other() -> Int = 7\n",
    },
  ]

test "the groups a signature edit moves in one module are checked again, and no other" {
  let cold = answered_over(nothing_held(), spread(b"pub fn step(n: Int) -> Int = n + 1\n"));
  let widened = spread(b"pub fn step(n: Int, by: Int = 1) -> Int = n + by\n");
  let warm = answered_over(cold.held, widened);
  let ran = groups_ran(warm.run, group_query());
  assert_eq(ran.len(), 3);
  assert(ran.contains(group_in(b"app", [b"go"])));
  assert(ran.contains(group_in(b"app", [b"again"])));
  assert_eq(said(warm.outcome), said(analyse(parse_all(widened))));
  assert_eq(tables_of(warm.answers), tables_of(answered_over(nothing_held(), widened).answers));
  assert_eq(warm.answers, answered_over(nothing_held(), widened).answers)
}

/// Whether the record `held` keeps of the group `g` took what a check of its whole module offered
/// through `whole`: such a record reads the definition of the query that offered it.
fn took_whole(held: Held, g: GroupNamed) -> Bool / {abort.raise} =
  memo::current(held).fold(false, |found: Bool, _: Bytes, r: memo::Record|
    found
      || (r.query == group_query() && r.input == bin::encode(g, group_named_bin())
      && r.reads.fold(false, |any: Bool, read: memo::Read|
        any
          || (match read {
            memo::World(_, at, _) -> at == whole_query(),
            memo::Asked(_, _, _) -> false,
          }))))

test "an edit that moves one group of a module checks it alone, and one that moves more checks the module once" {
  let app = b"import lib\npub fn go(n: Int) -> Int = lib::step(n) + 2\n\npub fn again(n: Int) -> Int = lib::step(n) * 2\n\npub fn other() -> Int = 7\n";
  let over = |lib: Bytes| [{ name: b"lib", src: lib }, { name: b"app", src: app }];
  let cold = answered_over(nothing_held(), spread(b"pub fn step(n: Int) -> Int = n + 1\n"));
  let one = answered_over(cold.held, over(b"pub fn step(n: Int) -> Int = n + 1\n"));
  assert_eq(groups_ran(one.run, group_query()), [group_in(b"app", [b"go"])]);
  assert(!took_whole(one.held, group_in(b"app", [b"go"])));
  // The check of `app` that decided so read `step`'s entry, so it decides again when that moves.
  let widened = over(b"pub fn step(n: Int, by: Int = 1) -> Int = n + by\n");
  let more = answered_over(one.held, widened);
  // A record is its group's last run, so one that reads `whole`'s definition took its offer then.
  let ran = groups_ran(more.run, group_query());
  assert(!ran.contains(group_in(b"app", [b"other"])));
  assert(took_whole(more.held, group_in(b"app", [b"go"])));
  assert(took_whole(more.held, group_in(b"app", [b"again"])));
  assert_eq(more.answers, answered_over(nothing_held(), widened).answers)
}

/// Whether the record `held` keeps of `module`'s answer under the query hash `hash` read an entry:
/// only a check of the module whole, made while it was answered, reads one.
fn checked_whole_in(held: Held, hash: Bytes, module: Bytes) -> Bool / {abort.raise} =
  memo::current(held).fold(false, |found: Bool, _: Bytes, r: memo::Record|
    found
      || (r.query == hash
      && r.input == bin::encode({ module: module, shipped: false, tested: false }, named_bin())
      && r.reads.fold(false, |any: Bool, read: memo::Read|
        any
          || (match read {
            memo::Asked(name, _, _) -> name == entry_query(),
            memo::World(_, _, _) -> false,
          }))))

test "where only what puts a module together is defined anew, its groups stand and it is not checked again" {
  let sources = spread(b"pub fn step(n: Int) -> Int = n + 1\n");
  let cold = answered_over(nothing_held(), sources);
  assert(checked_whole_in(cold.held, module_query(), b"app"));
  let anew = b"module, defined anew";
  let qs = fresh_registry().fold(
    Map::new(),
    |acc: Map<Bytes, CheckQuery>, n: Bytes, q: CheckQuery|
      acc.insert(n, if n == module_query() { { ..q, hash: anew } } else { q }),
  );
  // Every query's hash names the run's stamp, so the store vouches for nothing to this one.
  let warm = answered_under(qs, cold.held, sources);
  assert_eq([ran_of(warm.run, module_query()), ran_of(warm.run, group_query())], [2, 0]);
  assert(!checked_whole_in(warm.held, anew, b"app"));
  assert_eq(warm.answers, cold.answers)
}

/// A module whose `go` and `again` read `lib::step` and `base`, an owner of their own module,
/// beside an owner that reads none of them.
fn leaning(lib: Bytes) -> List<Source> =
  [
    { name: b"lib", src: lib },
    {
      name: b"app",
      src: b"import lib\npub fn go(n: Int) -> Int = lib::step(n) + base()\n\npub fn again(n: Int) -> Int = lib::step(n) * 2 + base()\n\npub fn base() -> Int = 1\n\npub fn aside() -> Int = 7\n",
    },
  ]

/// Whether `held` keeps a check of a module whole that asked for a group of that module or for an
/// owner's entry there: a group asks for that check, so the check would wait on what waits on it.
fn whole_asked_its_own(held: Held) -> Bool / {abort.raise} =
  memo::current(held).fold(false, |found: Bool, _: Bytes, r: memo::Record|
    found
      || (r.query == whole_query()
      && {
        let module = decoded(r.input, named_bin(), "a module's name").module;
        r.reads.fold(false, |own: Bool, read: memo::Read|
          own
            || (match read {
              memo::Asked(name, input, _) ->
                (name == owner_entry_query()
                  && decoded(input, owner_named_bin(), "an owner's name").module == module)
                  || (name == group_query()
                  && decoded(input, group_named_bin(), "a group's names").module == module),
              memo::World(_, _, _) -> false,
            }))
      }))

test "a check of a module whole that a group asks for reads nothing of the module's groups" {
  let cold = answered_over(nothing_held(), leaning(b"pub fn step(n: Int) -> Int = n + 1\n"));
  let widened = leaning(b"pub fn step(n: Int, by: Int = 1) -> Int = n + by\n");
  let warm = answered_over(cold.held, widened);
  let ran = groups_ran(warm.run, group_query());
  assert(ran.contains(group_in(b"app", [b"go"])));
  assert(ran.contains(group_in(b"app", [b"again"])));
  assert(!ran.contains(group_in(b"app", [b"aside"])));
  assert(!whole_asked_its_own(warm.held));
  assert_eq(warm.answers, answered_over(nothing_held(), widened).answers)
}

fn staled(inner: Bytes, first: Bytes, go: Bytes) -> List<Source> =
  [
    {
      name: b"lib",
      src: Bytes::concat_all([inner, b"\n\npub fn step(n: Int) -> Int = inner(n) + 1\n"]),
    },
    {
      name: b"zed",
      src: Bytes::concat_all([
        b"import lib\nfn seed() -> Int = 1\n\nfn sprout() -> Int = seed() + 1\n\n",
        first,
        b"\n\nfn shown(n: Int) -> Int = lib::step(n)\n\n",
        go,
        b"\n",
      ]),
    },
  ]

// `go` reads `lib::step`, which answers anew and so marks `shown`, a group of its own module
// that stood when `first` and `go` were found stale, before `go` reads it.
test "a group that goes stale while its module's others are checked is checked after them" {
  let before = staled(
    b"fn inner(n: Int) -> Int = n + 1",
    b"pub fn first() -> Int = sprout() + 1",
    b"pub fn go(n: Int) -> Int = lib::step(0) + shown(n)",
  );
  let after = staled(
    b"fn inner(n: Int) -> Int = n + 2",
    b"pub fn first() -> Int = sprout() + 2",
    b"pub fn go(n: Int) -> Int = lib::step(1) + shown(n)",
  );
  let warm = answered_over(answered_over(nothing_held(), before).held, after);
  assert_eq(said(warm.outcome), said(analyse(parse_all(after))));
  assert_eq(warm.answers, answered_over(nothing_held(), after).answers)
}

test "a test edited beside a definition it calls answers what a fresh check answers" {
  let before = [
    {
      name: b"m",
      src: b"fn scale(n: Int) -> Int = n * 2\nfn other(n: Int) -> Int = n + 1\n\ntest \"doubles\" { assert_eq(scale(2) + other(0), 5) }\n",
    },
  ];
  let after = [
    {
      name: b"m",
      src: b"fn scale(n: Int) -> Int = n * 2\nfn other(n: Int) -> Int = 1 + n\n\ntest \"doubles\" { assert_eq(scale(2) + other(0), 9) }\n",
    },
  ];
  let warm = answered_over(answered_over(nothing_held(), before).held, after);
  assert_eq(tables_of(warm.answers), tables_of(answered_over(nothing_held(), after).answers));
  assert_eq(warm.answers, answered_over(nothing_held(), after).answers)
}

test "groups an edit breaks together each say why, as a fresh check says" {
  let cold = answered_over(nothing_held(), spread(b"pub fn step(n: Int) -> Int = n + 1\n"));
  let narrowed = spread(b"pub fn step(n: Int, by: Int) -> Int = n + by\n");
  let warm = answered_over(cold.held, narrowed);
  assert_eq(said(warm.outcome), said(analyse(parse_all(narrowed))))
}

test "a definition added is checked and hashed alone" {
  let cold = fixed_over(nothing_held(), layered(b"pub fn step(n: Int) -> Int = n + 1\n"), []);
  let added = layered(b"pub fn step(n: Int) -> Int = n + 1\npub fn twice(n: Int) -> Int = n * 2\n");
  let warm = fixed_over(cold.held, added, []);
  assert_eq(groups_ran(warm.run, group_query()), [group_in(b"lib", [b"twice"])]);
  assert_eq(groups_ran(warm.run, group_hash_query()), [group_in(b"lib", [b"twice"])]);
  assert_eq(ran_of(warm.run, hashes_query()), 1);
  assert_eq(warm.fixing, fixed_over(nothing_held(), added, []).fixing)
}

test "a body edit hashes the definitions that call it again, and no other" {
  let cold = fixed_over(nothing_held(), layered(b"pub fn step(n: Int) -> Int = n * 3\n"), []);
  let edited = layered(b"pub fn step(n: Int) -> Int = n * 4\n");
  let warm = fixed_over(cold.held, edited, []);
  assert_eq(groups_ran(warm.run, group_query()), [group_in(b"lib", [b"step"])]);
  assert_eq(groups_ran(warm.run, group_hash_query()), [
    group_in(b"lib", [b"step"]),
    group_in(b"app", [b"go"]),
  ]);
  assert_eq(ran_of(warm.run, hashes_query()), 2);
  assert_eq(warm.fixing, fixed_over(nothing_held(), edited, []).fixing)
}

test "a definition added to a shipped module checks and hashes no module that imports it again" {
  let user = [
    {
      name: b"main",
      src: b"import std.shapes\npub fn main() -> Int = shapes::far(shapes::origin())\n",
    },
  ];
  let shapes = |more: Bytes|
    [
      {
        name: b"std.shapes",
        src: b"pub type Point = { x: Int, y: Int }\npub fn origin() -> Point = { x: 0, y: 0 }\npub fn far(p: Point) -> Int = p.x + p.y\n".concat(
          more,
        ),
      },
    ];
  let cold = fixed_over(nothing_held(), user, shapes(b""));
  let added = shapes(b"pub fn spare() -> Int = 5\n");
  let warm = fixed_over(cold.held, user, added);
  assert_eq(ran_of(warm.run, module_query()), 1);
  assert_eq(ran_of(warm.run, hashes_query()), 1);
  assert_eq(warm.fixing, fixed_over(nothing_held(), user, added).fixing)
}

/// What a toolchain that ships `shipped` answers of them, as the store its pack is cut from holds it.
fn shipped_held(shipped: List<Source>) -> Held / {abort.raise} = {
  let texts = shipped.fold(Map::new(), |acc: Map<Bytes, Bytes>, s: Source|
    acc.insert(s.name, s.src));
  let held_text = |name: Bytes| texts.get(name);
  let names = shipped.map(|s: Source| s.name);
  let nowhere = world_of({ root: b"", manifest: None, files: [] }, []);
  over_decoding(
    nothing_held(),
    packs::no_pack,
    b"",
    |kind: Bytes, at: Bytes|
      looked(nowhere, held_text, held_text, || names, nothing_embedded, kind, at),
    || {
      let qs = fresh_registry();
      shipped_all(qs, names, started(qs));
      ()
    },
  ).held
}

/// The pack cut from `held`: what it holds of the queries a pack carries, over shipped files a
/// load does not list.
fn pack_of(held: Held) -> Option<packs::Written> / {abort.raise} =
  Some(
    memo::packed_of(
      {
        ..held,
        records: memo::current(held).fold(
          Map::new(),
          |acc: Map<Bytes, Record>, k: Bytes, r: Record|
            if shipped_queries().contains(r.query) { acc.insert(k, r) } else { acc },
        ),
      },
      fresh_registry(),
      b"the shipped files",
    ),
  )

// A bootstrap's builder is loaded so: over a checkout whose shipped modules are not all the pack's.
test "a load over a pack it does not trust checks no shipped module the pack still answers for" {
  let user = [
    {
      name: b"main",
      src: b"import std.a (two)\npub fn main() -> Int = two()\n\npub fn more() -> Int = two() + 1\n",
    },
  ];
  let shipped = |aside: Bytes|
    [
      {
        name: b"std.a",
        src: b"import std.b (one)\n\npub fn two() -> Int = one() + one()\n\npub fn three() -> Int = two() + one()\n",
      },
      { name: b"std.b", src: b"pub fn one() -> Int = 1\n\npub fn none() -> Int = 0\n" },
      { name: b"std.aside", src: aside },
    ];
  let packed = pack_of(shipped_held(shipped(b"pub fn spare() -> Int = 3\n")));
  let moved = shipped(b"pub fn spare() -> Int = 4\n");
  let load = fixed_beside(nothing_held(), packed, user, moved);
  assert_eq(
    ran_for(load.run, whole_query()).map(|b: Bytes|
      decoded(b, named_bin(), "a module's name").module),
    [b"main"],
  );
  assert_eq(groups_ran(load.run, group_query()).map(|g: GroupNamed| g.module), [b"main", b"main"]);
  assert_eq(load.answers, fixed_over(nothing_held(), user, moved).answers)
}

// Each owner of a module asks what the module's read says of it, and the read answers for them all.
test "a load fetches a module's read from a pack for what the read offered nothing of, not once an owner" {
  let owners = 24;
  let shipped = [
    {
      name: b"std.many",
      src: Bytes::concat_all(
        range(0, owners).map(|i: Int|
          Bytes::of_string(f"pub fn f{i.to_string()}() -> Int = {i.to_string()} + 1\n\n")),
      ),
    },
  ];
  let held = shipped_held(shipped);
  let read = memo::current(held).fold(b"", |found: Bytes, _: Bytes, r: Record|
    if r.query == owners_query() { r.output } else { found });
  let read_bytes = match held.outputs.get(read) { Some(o) -> o, None -> b"" };
  let user = [{ name: b"main", src: b"import std.many (f0)\npub fn main() -> Int = f0()\n" }];
  let load = fixed_beside(nothing_held(), pack_of(held), user, shipped);
  let fetches = load.fetched.filter(|b: Bytes| b == read_bytes).len();
  assert(fetches > 0, Some("the read is short enough to be kept inside its record"));
  assert(fetches < owners, Some(f"the read was fetched {fetches.to_string()} times"))
}

test "a load over a pack walks no owner of a shipped module" {
  let shipped = [
    {
      name: b"std.pair",
      src: b"pub fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\n\npub fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n\npub fn both(n: Int) -> Bool = even(n) || odd(n)\n",
    },
  ];
  let user = [{ name: b"main", src: b"import std.pair (both)\npub fn main() -> Bool = both(3)\n" }];
  let load = fixed_beside(nothing_held(), pack_of(shipped_held(shipped)), user, shipped);
  assert_eq(ran_for(load.run, typed_query()), []);
  assert_eq(load.answers, fixed_over(nothing_held(), user, shipped).answers)
}

test "modules that import one another in a cycle are refused through the store as they are fresh" {
  let cycle = [
    { name: b"a", src: b"import b\npub fn a() -> Int = b::b()\n" },
    { name: b"b", src: b"import a\npub fn b() -> Int = a::a()\n" },
    { name: b"c", src: b"import a\npub fn c() -> Int = a::a()\n" },
  ];
  let itself = [{ name: b"me", src: b"import me\npub fn f() -> Int = 1\n" }];
  assert_eq(
    disagreements([
      step(b"a cycle", cycle),
      step(b"warm", cycle),
      step(b"a module importing itself", itself),
      step(b"the cycle broken", with_module(cycle, b"b", b"pub fn b() -> Int = 1\n")),
    ]),
    [],
  )
}

test "a shipped module's imports are checked as an importer reads it, without what only its tests import" {
  let user = [{ name: b"main", src: b"import std.a (two)\npub fn main() -> Int = two()\n" }];
  let shipped = [
    {
      name: b"std.a",
      src: b"import std.b (one)\nimport std.c (spare)\n\npub fn two() -> Int = one() + one()\ntest \"spared\" { assert_eq(spare(), 3) }\n",
    },
    { name: b"std.b", src: b"pub fn one() -> Int = 1\n" },
    { name: b"std.c", src: b"pub fn spare() -> Int = 3\n" },
  ];
  let f = fixed_over(nothing_held(), user, shipped);
  assert_eq(f.answers.fold([], |acc: List<Diag>, a: Answered| acc.concat(a.answer.refused)), [])
}

// `main` reads `pick`, whose group refuses, so its own refusal says nothing a fix to `pick` would not.
test "a module refuses with what its refusing groups say, and nothing a group reading them says" {
  let sources = [
    {
      name: b"app",
      src: b"fn pick() -> Int = missing()\n\nfn read() -> Int = 1\n\nfn main() -> Int = pick() + read()\n",
    },
  ];
  let f = fixed_over(nothing_held(), sources, []);
  assert_eq(
    f.answers.fold([], |acc: List<Bytes>, a: Answered|
      acc.concat(a.answer.refused.map(|d: Diag| d.message))),
    [b"unknown name `missing`"],
  )
}

test "a load that refuses checks no module that imports a refused one, and no group of a module its whole check refuses" {
  let sources = [
    { name: b"lib", src: b"pub fn broken() -> Int = missing()\n\npub fn fine() -> Int = 1\n" },
    { name: b"app", src: b"import lib\npub fn go() -> Int = lib::fine()\n" },
    { name: b"top", src: b"import app\npub fn main() -> Int = app::go()\n" },
    { name: b"aside", src: b"pub fn alone() -> Int = nothing()\n\npub fn other() -> Int = 2\n" },
  ];
  let cold = answered_over(nothing_held(), sources);
  assert_eq(sorted_bytes(refused_first(cold.answers).map(|a: Answered| a.module)), [
    b"aside",
    b"lib",
  ]);
  assert_eq(ran_of(cold.run, module_query()), 2);
  assert_eq(ran_of(cold.run, group_query()), 0);
  let mended = with_module(
    with_module(sources, b"lib", b"pub fn broken() -> Int = 3\n\npub fn fine() -> Int = 1\n"),
    b"aside",
    b"pub fn alone() -> Int = 4\n\npub fn other() -> Int = 2\n",
  );
  let warm = answered_over(cold.held, mended);
  assert_eq(ran_of(warm.run, module_query()), 4);
  assert_eq(said(warm.outcome), said(answered_over(nothing_held(), mended).outcome))
}

test "an import that names no module refuses its module, though nothing reads it" {
  let sources = [{ name: b"app", src: b"import nonesuch\npub fn f() -> Int = 1\n" }];
  let f = fixed_over(nothing_held(), sources, []);
  assert_eq(
    f.answers.fold([], |acc: List<Bytes>, a: Answered|
      acc.concat(a.answer.refused.map(|d: Diag| d.code))),
    [b"E0106"],
  )
}

test "two imports that bind one module name refuse their module, though nothing reads either" {
  let sources = [
    { name: b"net", src: b"pub fn x() -> Int = 1\n" },
    { name: b"lib.net", src: b"pub fn y() -> Int = 2\n" },
    { name: b"app", src: b"import net\nimport lib.net\npub fn f() -> Int = 1\n" },
  ];
  let f = fixed_over(nothing_held(), sources, []);
  assert_eq(
    f.answers.fold([], |acc: List<Bytes>, a: Answered|
      acc.concat(a.answer.refused.map(|d: Diag| d.code))),
    [b"E0110"],
  )
}

test "a name a module selects that its module does not declare refuses the module" {
  let sources = [
    { name: b"lib", src: b"pub fn used() -> Int = 1\n" },
    { name: b"app", src: b"import lib (used, gone)\nfn go() -> Int = used()\n" },
  ];
  let f = fixed_over(nothing_held(), sources, []);
  assert_eq(
    f.answers.fold([], |acc: List<Bytes>, a: Answered|
      acc.concat(a.answer.refused.map(|d: Diag| d.code))),
    [b"E0101"],
  )
}
