// The front end's answer for the driver: the errors, or else the warnings and every table it reads, in `diag.ply`'s framing.

import spine (Span, Ident, QName, dummy_span, num)
import lexer (byte_of)
import items (Item, IFn, IType, IEffect, ITest, ILaw, IEffectSet, TDSum, VariantDef, SpecClause,
              SpecKind, SRequires, SEnsures, ImportDecl, Vis, VPub, VPriv, FnDef, LawDef, Binder)
import types (Mode, MRead, MWrite, MBad, AtomExpr)
import exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock, ERecord, ERecordUpdate,
              ETry, EField, EList, EPerform, EHandle, EWithCell, ESimulate, EBad,
              Param, Stmt, SLet, SExpr, MatchArm, RecField, expr_span)
import patterns (Lit, LInt, LStr, LBytes)
import code (Code, NLit, NVar, NUnary, NBinary, NApp, NIf, NBlock, NList, NRecord, NMatch, NPerform, NLabel, NCell,
             NLambda, NSim, NHandle, NField, NUpd, CField, CArm, CClause, CStmt, CLet, CLetPat, CDo,
             CPat, CPatField, PxCtor, PxRecord, PxList, lower_fn, dump)
import tycore (Atom, Resource, RNamed, RSingleton, Scheme, atoms_text, atoms_insert, read_atoms, scheme_text, type_text,
               at, append, take, contains_bytes, contains_int)
import resolve (Source, Mod, Diag, Label, Edit, Fix, Resolved, Resolved_, Failed, Ns, NValue, NEffect, resolve_modules, qualify,
                lookup, find, is_bare, diag1, backticked, import_module_name, path_span)
import hash (Index, Entry, EDef, ETest, ELaw, TestNode, HashOutput, build_index, hash_index, hex, unused,
             Pin, Rehash, Rehashed, rehash_index, Printed, Unprintable, print_bodies)
import infer (Front, Loc, DefInfo, DefConstraint, SpecInfo, TestInfo, LawInfo, LawBinder, EffectInfo, OpInfo, CtorInfo,
              Known, KnownDef, no_known, update_shapes, expanded_mods,
              check_front_with, deriver_text, is_prelude_effect, builtin_schemes, BuiltinDoc, builtin_docs, find_doc)
import diag (Parsed, parse_all, parse_at, outside_every_module, frame, framed, field, flag)
import std.hash (blake3)
import fmt (item_range, replace_item)

fn cat(parts: List<List<Bytes>>) -> List<Bytes> = fold(parts, [], |acc: List<Bytes>, p: List<Bytes>| append(acc, p))

fn joined(xs: List<Bytes>, sep: Bytes) -> Bytes =
  fold(range(0, len(xs)), b"", |acc: Bytes, i: Int| if i == 0 { at(xs, i) } else { bytes_concat_all([acc, sep, at(xs, i)]) })

fn mode_text(m: Mode) -> Bytes = match m { MRead -> b"read", MWrite -> b"write", MBad -> b"" }

fn kind_text(k: SpecKind) -> Bytes = match k { SRequires -> b"requires", SEnsures -> b"ensures" }

// The module index of a span outside every module; a `(0, 0)` span is `dummy_span`.
fn no_module() -> Int = 4294967295

fn span_at(module: Int, s: Span) -> At =
  { module: if s.start == 0 && s.end == 0 { no_module() } else { module }, start: s.start, end: s.end }

fn loc_at(l: Loc) -> At = span_at(l.module, l.span)

fn span_text(module: Int, s: Span) -> Bytes = at_text(span_at(module, s))

// --- What the source wrote ----------------------------------------------------
// What the driver reads from the tree that the checker's tables do not keep.

fn vis_public(v: Vis) -> Bool = match v { VPub -> true, VPriv -> false }

type Written = { public: Bool, reuse: Bool, params: List<Param>, literals: List<Bytes> }

fn no_written() -> Written = { public: false, reuse: false, params: [], literals: [] }

fn fn_written(mods: List<Mod>) -> Map<Bytes, Written> =
  fold(mods, map_new(), |acc: Map<Bytes, Written>, m: Mod|
    fold(m.module.items, acc, |a: Map<Bytes, Written>, it: Item|
      match it {
        IFn(d) -> map_insert(a, qualify(m.name, d.name.name),
                             { public: vis_public(d.vis),
                               reuse: match d.reuse { Some(_) -> true, None -> false },
                               params: d.params,
                               literals: fold(d.spec, [], |lits: List<Bytes>, c: SpecClause|
                                 match c.kind { SRequires -> collect_lits([c.expr], lits), SEnsures -> lits }) }),
        _ -> a,
      }))

fn written_of(m: Map<Bytes, Written>, name: Bytes) -> Written =
  match map_get(m, name) { Some(w) -> w, None -> no_written() }

fn effect_written(mods: List<Mod>) -> Map<Bytes, Bool> =
  fold(mods, map_new(), |acc: Map<Bytes, Bool>, m: Mod|
    fold(m.module.items, acc, |a: Map<Bytes, Bool>, it: Item|
      match it { IEffect(d) -> map_insert(a, qualify(m.name, d.name.name), vis_public(d.vis)), _ -> a }))

// A prelude effect has no source entry and is public.
fn effect_public_of(m: Map<Bytes, Bool>, e: EffectInfo) -> Bool =
  match map_get(m, e.name) { Some(b) -> b, None -> true }

// No table of the checker's holds a `type` declaration, so it is read from the tree.
fn type_rows(mods: List<Mod>) -> List<TypeRow> =
  fold(range(0, len(mods)), [], |acc: List<TypeRow>, i: Int| {
    let m = at(mods, i);
    fold(m.module.items, acc, |a: List<TypeRow>, it: Item|
      match it {
        IType(d) -> push(a, { name: qualify(m.name, d.name.name), module: m.name,
                              simple_name: d.name.name, public: vis_public(d.vis),
                              arity: len(d.params), at: span_at(i, d.span) }),
        _ -> a,
      })
  })

fn test_name_spans(mods: List<Mod>) -> List<Loc> =
  fold(range(0, len(mods)), [], |acc: List<Loc>, i: Int| {
    let m = at(mods, i);
    fold(m.module.items, acc, |a: List<Loc>, it: Item|
      match it { ITest(d) -> push(a, { module: i, span: d.name_span }), _ -> a })
  })

// --- A guard's literals -------------------------------------------------------
// The order seeds the prover's witness search, so it is the stack walk's first-reached order, not sorted.

fn keep(acc: List<Bytes>, x: Bytes) -> List<Bytes> = if contains_bytes(acc, x) { acc } else { push(acc, x) }

fn int_lit(k: Int) -> Bytes = bytes_concat(b"int ", num(k))

fn lit_text(acc: List<Bytes>, l: Lit) -> List<Bytes> =
  match l {
    LInt(k) -> keep(acc, int_lit(k)),
    LStr(s) -> keep(acc, bytes_concat(b"str ", s)),
    LBytes(b) -> keep(acc, bytes_concat(b"bytes ", hex(b))),
    _ -> acc,
  }

// A negated literal is kept negated, as the guard means it; the walk still reaches the literal itself.
fn neg_lit(acc: List<Bytes>, e: Expr) -> List<Bytes> =
  match e { ELit(v) -> match v.lit { LInt(k) -> keep(acc, int_lit(0 - k)), _ -> acc }, _ -> acc }

type Walk = { stack: List<Expr>, acc: List<Bytes> }

fn arm_exprs(s: List<Expr>, arm: MatchArm) -> List<Expr> =
  push(match arm.guard { Some(g) -> push(s, g), None -> s }, arm.body)

fn stmt_exprs(s: List<Expr>, st: Stmt) -> List<Expr> =
  match st { SLet(x) -> push(s, x.value), SExpr(x) -> push(s, x) }

fn field_exprs(s: List<Expr>, f: RecField) -> List<Expr> = push(s, f.value)

fn collect_lits(stack: List<Expr>, acc: List<Bytes>) -> List<Bytes> =
  if len(stack) == 0 { acc } else {
    let e = at(stack, len(stack) - 1);
    let rest = take(stack, len(stack) - 1);
    let step: Walk = match e {
      ELit(v) -> { stack: rest, acc: lit_text(acc, v.lit) },
      EVar(_) -> { stack: rest, acc: acc },
      EBad(_) -> { stack: rest, acc: acc },
      EBinary(v) -> { stack: push(push(rest, v.lhs), v.rhs), acc: acc },
      EUnary(v) -> { stack: push(rest, v.operand),
                     acc: if v.op == b"neg" { neg_lit(acc, v.operand) } else { acc } },
      ELambda(v) -> { stack: push(rest, v.body), acc: acc },
      EApp(v) -> { stack: append(push(rest, v.func), v.args), acc: acc },
      EIf(v) -> { stack: push(push(push(rest, v.cond), v.then_branch), v.else_branch), acc: acc },
      EMatch(v) -> { stack: fold(v.arms, push(rest, v.scrutinee), arm_exprs), acc: acc },
      EBlock(v) -> { stack: match v.tail { Some(t) -> push(fold(v.stmts, rest, stmt_exprs), t),
                                           None -> fold(v.stmts, rest, stmt_exprs) },
                     acc: acc },
      ERecord(v) -> { stack: fold(v.fields, rest, field_exprs), acc: acc },
      ERecordUpdate(v) -> { stack: fold(v.fields, push(rest, v.base), field_exprs), acc: acc },
      EField(v) -> { stack: push(rest, v.base), acc: acc },
      ETry(v) -> { stack: push(rest, v.operand), acc: acc },
      EList(v) -> { stack: append(rest, v.items), acc: acc },
      EPerform(v) -> { stack: append(rest, v.args), acc: acc },
      EHandle(v) -> { stack: push(rest, v.body), acc: acc },
      EWithCell(v) -> { stack: push(push(rest, v.init), v.body), acc: acc },
      ESimulate(v) -> { stack: push(rest, v.body), acc: acc },
    };
    collect_lits(step.stack, step.acc)
  }

fn law_literals(mods: List<Mod>) -> List<List<Bytes>> =
  fold(mods, [], |acc: List<List<Bytes>>, m: Mod|
    fold(m.module.items, acc, |a: List<List<Bytes>>, it: Item|
      match it {
        ILaw(d) -> push(a, match d.guard { Some(g) -> collect_lits([g], []), None -> [] }),
        _ -> a,
      }))

// --- A module's effect sets ---------------------------------------------------
// An atom whose effect resolves to nothing is dropped; a bare `cell` resolves to itself.

fn has_effect(effects: List<EffectInfo>, name: Bytes) -> Bool =
  fold(effects, false, |acc: Bool, e: EffectInfo| acc || e.name == name)

fn bare_prelude(q: QName) -> Option<Bytes> =
  if is_bare(q) && is_prelude_effect(q.name.name) { Some(q.name.name) } else { None }

fn set_effect(r: Resolved, effects: List<EffectInfo>, module: Int, q: QName) -> Option<Bytes> =
  if is_bare(q) && q.name.name == b"cell" { Some(b"cell") } else {
    let found = if is_bare(q) { lookup(at(r.scopes, module).bound, NEffect, q.name.name) }
                else { find(r, module, NEffect, q) };
    match found {
      Some(b) -> if has_effect(effects, b.qualified) { Some(b.qualified) } else { bare_prelude(q) },
      None -> bare_prelude(q),
    }
  }

fn set_atoms(r: Resolved, effects: List<EffectInfo>, module: Int, xs: List<AtomExpr>) -> List<Atom> =
  fold(xs, [], |acc: List<Atom>, a: AtomExpr|
    match set_effect(r, effects, module, a.eff) {
      Some(eff) -> atoms_insert(acc, { effect: eff,
                                       resource: match a.resource { Some(x) -> RNamed(x.name), None -> RSingleton },
                                       mode: a.mode,
                                       op: match a.op { Some(x) -> Some(x.name), None -> None } }),
      None -> acc,
    })

// One `effect set` of a module: the simple name a row writes, the sets it includes in source
// order, and the expansion as program-wide atoms.
pub type SetView = { name: Bytes, includes: List<Bytes>, atoms: List<Atom> }

pub fn effect_sets_of(r: Resolved, effects: List<EffectInfo>, module: Int, m: Mod) -> List<SetView> =
  fold(m.module.items, [], |acc: List<SetView>, it: Item|
    match it {
      IEffectSet(d) -> push(acc, { name: d.name.name,
                                   includes: map(d.includes, |q: QName| q.name.name),
                                   atoms: set_atoms(r, effects, module, d.expansion) }),
      _ -> acc,
    })

fn set_text(v: SetView) -> Bytes =
  bytes_concat_all([v.name, b" ", joined(v.includes, b","), b" ", atoms_text(v.atoms, b",")])

// --- The rows the dump holds ------------------------------------------------
// A test or a law is framed under its index: its key may hold a space or a newline.

// Program-wide names of everything a module declares, in source order.
pub fn module_items(m: Mod) -> List<Bytes> =
  fold(m.module.items, [], |acc: List<Bytes>, it: Item|
    match it {
      IFn(d) -> push(acc, qualify(m.name, d.name.name)),
      IType(d) -> {
        let named = push(acc, qualify(m.name, d.name.name));
        match d.body {
          TDSum(vs) -> fold(vs, named, |a: List<Bytes>, v: VariantDef| push(a, qualify(m.name, v.name.name))),
          _ -> named,
        }
      },
      IEffect(d) -> push(acc, qualify(m.name, d.name.name)),
      _ -> acc,
    })

// The modules a module imports, each named once, in source order.
pub fn module_imports(m: Mod) -> List<Bytes> =
  fold(m.module.imports, [], |acc: List<Bytes>, d: ImportDecl| {
    let name = joined(map(d.path, |x: Ident| x.name), b".");
    if fold(acc, false, |b: Bool, x: Bytes| b || x == name) { acc } else { push(acc, name) }
  })

fn module_row(i: Int, m: Mod, r: Resolved, effects: List<EffectInfo>) -> ModuleRow = {
  let items = module_items(m);
  let imports = module_imports(m);
  let sets = map(effect_sets_of(r, effects, i, m), set_text);
  { name: m.name, index: i, items: items, imports: imports, sets: sets }
}

fn def_row(d: DefInfo, w: Written) -> DefRow =
  { name: d.name, module: d.module, simple_name: d.simple_name, public: w.public, reuse: w.reuse,
    scheme: scheme_text(d.scheme), footprint: atoms_text(d.footprint, b","),
    performed: atoms_text(d.performed, b","),
    constraints: map(d.constraints, |c: DefConstraint|
      bytes_concat_all([deriver_text(c.deriver), b" ", num(c.param)])),
    internally_effectful: d.internally_effectful,
    row_aliases: d.row_aliases,
    params: map(w.params, |p: Param| { name: p.name.name, at: span_at(d.at.module, p.span) }),
    spec: map(d.spec, |s: SpecInfo| { kind: kind_text(s.kind), index: s.index,
                                      footprint: atoms_text(s.footprint, b","),
                                      at: span_at(d.at.module, s.span) }),
    at: loc_at(d.at), literals: w.literals }

fn test_row(t: TestInfo, name_at: Loc) -> TestRow =
  { key: t.key, name: t.name, module: t.module, index: t.index, nondet: t.nondet,
    footprint: atoms_text(t.footprint, b","), at: loc_at(t.at), name_at: loc_at(name_at) }

fn law_row(l: LawInfo, lits: List<Bytes>) -> LawRow =
  { key: l.key, name: l.name, module: l.module, index: l.index,
    binders: map(l.binders, |b: LawBinder| { name: b.name, at: span_at(l.at.module, b.span),
                                             ty: type_text(b.ty) }),
    has_guard: l.has_guard, host: l.host, footprint: atoms_text(l.footprint, b","),
    at: loc_at(l.at), literals: lits }

fn op_row(module: Int, o: OpInfo) -> OpRow =
  { name: o.name, mode: mode_text(o.mode), resource_param: o.resource_param,
    params: map(o.params, type_text), ret: type_text(o.ret),
    scheme: match o.scheme { Some(sc) -> Some(scheme_text(sc)), None -> None },
    at: span_at(module, o.at.span) }

fn effect_row(e: EffectInfo, public: Bool) -> EffectRow =
  { name: e.name, module: e.module, simple_name: e.simple_name, public: public, nondet: e.nondet,
    ops: map(e.ops, |o: OpInfo| op_row(e.at.module, o)), at: loc_at(e.at) }

fn ctor_row(k: CtorInfo) -> CtorRow =
  { name: k.name, module: k.module, simple_name: k.simple_name, type_name: k.type_name,
    index: k.index, arity: k.arity, fields: map(k.fields, type_text),
    scheme: scheme_text(k.scheme), at: loc_at(k.at) }

// --- The hashes ---------------------------------------------------------------
// A name declared twice (a `fn` and an `effect` alike) is one frame, as the maps merged it.

fn by_name_one(xs: List<{ name: Bytes, hash: Bytes }>) -> Map<Bytes, Bytes> =
  fold(xs, map_new(), |acc: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }| map_insert(acc, x.name, x.hash))

fn by_name_many(xs: List<{ name: Bytes, hashes: List<Bytes> }>) -> Map<Bytes, List<Bytes>> =
  fold(xs, map_new(), |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, hashes: List<Bytes> }| map_insert(acc, x.name, x.hashes))

fn by_name_names(xs: List<{ name: Bytes, names: List<Bytes> }>) -> Map<Bytes, List<Bytes>> =
  fold(xs, map_new(), |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, names: List<Bytes> }| map_insert(acc, x.name, x.names))

// A closure is a set kept as a map, so its names come back in byte order.
fn by_name_closure(xs: List<{ name: Bytes, names: Map<Bytes, Bool> }>) -> Map<Bytes, List<Bytes>> =
  fold(xs, map_new(), |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, names: Map<Bytes, Bool> }|
    map_insert(acc, x.name, map_fold(x.names, [], |ns: List<Bytes>, k: Bytes, v: Bool| push(ns, k))))

type Tables = { defs: Map<Bytes, Bytes>, own: Map<Bytes, Bytes>, decls: Map<Bytes, Bytes>,
                specs: Map<Bytes, List<Bytes>>, spec_texts: Map<Bytes, List<Bytes>>,
                deps: Map<Bytes, List<Bytes>>, closure: Map<Bytes, List<Bytes>> }

fn hash_tables(h: HashOutput) -> Tables =
  { defs: by_name_one(h.defs), own: by_name_one(h.own), decls: by_name_one(h.decls),
    specs: by_name_many(h.specs), spec_texts: by_name_many(h.spec_texts),
    deps: by_name_names(h.deps), closure: by_name_closure(h.closure) }

fn hex_one(m: Map<Bytes, Bytes>, name: Bytes) -> Option<Bytes> =
  match map_get(m, name) { Some(h) -> Some(hex(h)), None -> None }

fn hex_many(m: Map<Bytes, List<Bytes>>, name: Bytes) -> List<Bytes> =
  match map_get(m, name) { Some(hs) -> map(hs, hex), None -> [] }

fn names_of(m: Map<Bytes, List<Bytes>>, name: Bytes) -> List<Bytes> =
  match map_get(m, name) { Some(ns) -> ns, None -> [] }

fn def_hash_row(t: Tables, name: Bytes) -> HashRow =
  { name: name, def: hex_one(t.defs, name), own: hex_one(t.own, name), decl: hex_one(t.decls, name),
    specs: hex_many(t.specs, name), spec_texts: hex_many(t.spec_texts, name),
    deps: names_of(t.deps, name), closure: names_of(t.closure, name) }

fn hash_rows(index: Index, h: HashOutput) -> List<HashFrame> = {
  let t = hash_tables(h);
  let walked = fold(index.order, { seen: map_new(), frames: [] }, |acc: { seen: Map<Bytes, Bool>, frames: List<HashFrame> }, e: Entry|
    match e {
      EDef(v) -> {
        let name = at(index.nodes, v).name;
        match map_get(acc.seen, name) {
          Some(_) -> acc,
          None -> { seen: map_insert(acc.seen, name, true), frames: push(acc.frames, HDef(def_hash_row(t, name))) },
        }
      },
      ETest(i) -> {
        let key = at(index.tests, i).key;
        {..acc, frames: push(acc.frames, HTest({ index: i, key: key, hash: hex(at(h.tests, i)), text: b"",
                                                 deps: names_of(t.deps, key), closure: names_of(t.closure, key) }))}
      },
      ELaw(i) -> {
        let key = at(index.laws, i).key;
        {..acc, frames: push(acc.frames, HLaw({ index: i, key: key, hash: hex(at(h.laws, i)),
                                                text: hex(at(h.law_texts, i)),
                                                deps: names_of(t.deps, key), closure: names_of(t.closure, key) }))}
      },
    });
  walked.frames
}

// A `fn` also names its clauses' kinds in order, so each clause's root can be keyed.
fn ordinal_row(m: Mod) -> OrdinalRow =
  { module: m.name,
    items: fold(m.module.items, [], |acc: List<Bytes>, it: Item|
      match it {
        IFn(d) -> {
          let kinds = if len(d.spec) == 0 { b"" } else { bytes_concat(b" ", joined(map(d.spec, |c: SpecClause| kind_text(c.kind)), b",")) };
          push(acc, bytes_concat_all([b"fn ", qualify(m.name, d.name.name), kinds]))
        },
        ITest(d) -> push(acc, bytes_concat(b"test ", qualify(m.name, d.name))),
        ILaw(d) -> push(acc, bytes_concat(b"law ", qualify(m.name, d.name))),
        _ -> acc,
      }) }

fn tables(warnings: List<Diag>, mods: List<Mod>, r: Resolved, c: Front, index: Index, h: HashOutput) -> Dump = {
  let fns = fn_written(mods);
  let effs = effect_written(mods);
  let names = test_name_spans(mods);
  let lits = law_literals(mods);
  { diags: map(warnings, framed_diag),
    order: map(r.order, |i: Int| at(mods, i).name),
    modules: map(range(0, len(mods)), |i: Int| module_row(i, at(mods, i), r, c.effects)),
    defs: map(c.defs, |d: DefInfo| def_row(d, written_of(fns, d.name))),
    types: type_rows(mods),
    tests: map(range(0, len(c.tests)), |i: Int| test_row(at(c.tests, i), at(names, i))),
    laws: map(range(0, len(c.laws)), |i: Int| law_row(at(c.laws, i), at(lits, i))),
    effects: map(c.effects, |e: EffectInfo| effect_row(e, effect_public_of(effs, e))),
    ctors: map(c.ctors, ctor_row),
    hashes: hash_rows(index, h),
    ordinals: map(mods, ordinal_row),
    bodies: h.bodies,
    test_bodies: h.test_bodies }
}

// Every table the front end holds for a program that checks, for a caller that wants them rather
// than their framing: `ply defs`, `ply hash` and `ply doc` are written against this.
pub type Whole = { mods: List<Mod>, r: Resolved, checked: Front, index: Index, hashes: HashOutput,
                   warnings: List<Diag> }

// A stage that reports stops the rest, so a refusal is the diagnostics of exactly one stage.
pub type Analysis = | Refused(List<Diag>) | Analysed(Whole)

// A definition's or a test's published rows as the last answer wrote them, under the hash it had
// then: the checker takes them wherever this program hashes that item the same, and walks the rest.
pub type KnownDefRow = { name: Bytes, hash: Bytes, footprint: Bytes, performed: Bytes }
pub type KnownTestRow = { key: Bytes, hash: Bytes, footprint: Bytes }

fn still_hashed(now: Map<Bytes, Bytes>, name: Bytes, was: Bytes) -> Bool =
  match map_get(now, name) { Some(h) -> h == was, None -> false }

fn known_defs(now: Map<Bytes, Bytes>, rows: List<KnownDefRow>) -> Map<Bytes, KnownDef> =
  fold(rows, map_new(), |acc: Map<Bytes, KnownDef>, r: KnownDefRow|
    if !still_hashed(now, r.name, r.hash) { acc } else {
      match read_atoms(r.footprint) {
        None -> acc,
        Some(footprint) -> match read_atoms(r.performed) {
          None -> acc,
          Some(performed) -> map_insert(acc, r.name, { footprint: footprint, performed: performed }),
        },
      }
    })

// Every test's hash this run, by the key `<module>.<label>` a row names it under.
fn test_hashes(index: Index, h: HashOutput) -> Map<Bytes, Bytes> =
  fold(range(0, len(index.tests)), map_new(), |acc: Map<Bytes, Bytes>, i: Int|
    map_insert(acc, at(index.tests, i).key, at(h.tests, i)))

// One slot per `test` of each module, in source order, as `check_tests` walks them.
fn known_tests(now: Map<Bytes, Bytes>, mods: List<Mod>, rows: List<KnownTestRow>) -> Map<Bytes, List<Option<List<Atom>>>> = {
  let by_key = fold(rows, map_new(), |acc: Map<Bytes, KnownTestRow>, r: KnownTestRow| map_insert(acc, r.key, r));
  fold(mods, map_new(), |acc: Map<Bytes, List<Option<List<Atom>>>>, m: Mod|
    map_insert(acc, m.name, fold(m.module.items, [], |slots: List<Option<List<Atom>>>, it: Item|
      match it {
        ITest(d) -> push(slots, match map_get(by_key, qualify(m.name, d.name)) {
          None -> None,
          Some(r) -> if still_hashed(now, r.key, r.hash) { read_atoms(r.footprint) } else { None },
        }),
        _ -> slots,
      })))
}

fn taken(mods: List<Mod>, index: Index, h: HashOutput, defs: List<KnownDefRow>, tests: List<KnownTestRow>) -> Known =
  if len(defs) == 0 && len(tests) == 0 { no_known() } else {
    { defs: known_defs(by_name_one(h.defs), defs),
      tests: known_tests(test_hashes(index, h), mods, tests) }
  }

pub fn analyse(parsed: List<Parsed>) -> Analysis = analyse_with(parsed, [], [])

pub fn analyse_with(parsed: List<Parsed>, defs: List<KnownDefRow>, tests: List<KnownTestRow>) -> Analysis = {
  let early = fold(parsed, [], |acc: List<Diag>, p: Parsed| append(acc, p.diags));
  if len(early) > 0 { Refused(early) } else {
    match resolve_modules(map(parsed, |p: Parsed| p.module)) {
      Failed(ds) -> Refused(map(ds, outside_every_module)),
      Resolved_(x) -> {
        let built = build_index(x.mods, x.r);
        if len(built.diags) > 0 { Refused(map(built.diags, outside_every_module)) } else {
          // Hashing reads the tree, not the checker, so what has moved is known before anything is checked.
          let hashes: HashOutput = hash_index(built.index);
          let checked: Front = check_front_with(x.r, x.mods, taken(x.mods, built.index, hashes, defs, tests));
          if !checked.ok { Refused(map(checked.diags, outside_every_module)) }
          else { Analysed({ mods: x.mods, r: x.r, checked: checked, index: built.index,
                            hashes: hashes,
                            warnings: map(unused(built.index), outside_every_module) }) }
        }
      },
    }
  }
}

// Every frame the answer writes, as rows: `read.dump_text` frames them and `read.read_front` is
// its inverse, so a cached answer is the same value a fresh one is.
pub fn dump_of(a: Analysis) -> Dump =
  match a {
    Refused(ds) -> { diags: map(ds, framed_diag), order: [], modules: [], defs: [], types: [], tests: [], laws: [],
                     effects: [], ctors: [], hashes: [], ordinals: [], bodies: [], test_bodies: [] },
    Analysed(w) -> tables(w.warnings, w.mods, w.r, w.checked, w.index, w.hashes),
  }

pub fn front_dump(sources: List<Source>) -> String = front_dump_with(sources, [], [])

// The front end handed the rows the last answer published: what this program hashes the same is
// taken from them, and only what moved is walked.
pub fn front_dump_with(sources: List<Source>, defs: List<KnownDefRow>, tests: List<KnownTestRow>) -> String =
  string_of_bytes(dump_text(dump_of(analyse_with(parse_all(sources), defs, tests))))

// Every builtin's scheme as the checker binds it, its parameter names and its note: one `builtin`
// frame each.
pub fn builtins_dump() -> String = {
  let docs = builtin_docs();
  string_of_bytes(bytes_concat_all(map(builtin_schemes(0, 1, 2, 0), |x: { name: Bytes, sc: Scheme }| {
    let d: BuiltinDoc = match find_doc(docs, x.name) {
      Some(d) -> d,
      None -> { name: x.name, params: [], note: b"" },
    };
    framed(b"builtin", x.name, cat([[field(b"scheme", scheme_text(x.sc))],
                                    map(d.params, |p: Bytes| field(b"param", p)),
                                    [field(b"note", d.note)]]))
  })))
}

fn global(r: Resolved, module: Int, written: Bytes) -> Bytes = {
  let q: QName = match bytes_index_of(written, b"::") {
    Some(i) -> { module: Some({ name: bytes_slice(written, 0, i), span: dummy_span() }),
                 name: { name: bytes_slice(written, i + 2, bytes_len(written)), span: dummy_span() },
                 span: dummy_span() },
    None -> { module: None, name: { name: written, span: dummy_span() }, span: dummy_span() },
  };
  match find(r, module, NValue, q) { Some(b) -> b.qualified, None -> written }
}

fn named_pat(r: Resolved, m: Int, p: CPat) -> CPat =
  match p {
    PxCtor(c) -> PxCtor({ name: global(r, m, c.name), args: map(c.args, |a: CPat| named_pat(r, m, a)) }),
    PxRecord(rc) -> PxRecord({ fields: map(rc.fields, |f: CPatField| { name: f.name, pat: named_pat(r, m, f.pat) }),
                               rest: rc.rest }),
    PxList(l) -> PxList({ items: map(l.items, |i: CPat| named_pat(r, m, i)),
                          rest: match l.rest { Some(x) -> Some(named_pat(r, m, x)), None -> None } }),
    _ -> p,
  }

fn named_fields(r: Resolved, m: Int, fs: List<CField>) -> List<CField> =
  map(fs, |f: CField| { name: f.name, value: named(r, m, f.value) })

fn named_opt(r: Resolved, m: Int, c: Option<Code>) -> Option<Code> =
  match c { Some(x) -> Some(named(r, m, x)), None -> None }

fn named_stmt(r: Resolved, m: Int, s: CStmt) -> CStmt =
  match s {
    CLet(l) -> CLet({ name: l.name, slot: l.slot, value: named(r, m, l.value) }),
    CLetPat(l) -> CLetPat({ span: l.span, pat: named_pat(r, m, l.pat), value: named(r, m, l.value) }),
    CDo(d) -> CDo({ code: named(r, m, d.code) }),
  }

fn named(r: Resolved, m: Int, c: Code) -> Code = {
  let n = |x: Code| named(r, m, x);
  let ns = |xs: List<Code>| map(xs, |x: Code| named(r, m, x));
  let node = match c.node {
    NLit(_) -> c.node,
    NLabel(_) -> c.node,
    NVar(v) -> match v.slot { Some(_) -> c.node, None -> NVar({ name: global(r, m, v.name), slot: None }) },
    NUnary(u) -> NUnary({ op: u.op, operand: n(u.operand) }),
    NBinary(b) -> NBinary({ op: b.op, lhs: n(b.lhs), rhs: n(b.rhs) }),
    NApp(a) -> NApp({ func: n(a.func), args: ns(a.args) }),
    NIf(i) -> NIf({ cond: n(i.cond), then_branch: n(i.then_branch), else_branch: n(i.else_branch) }),
    NBlock(b) -> NBlock({ stmts: map(b.stmts, |s: CStmt| named_stmt(r, m, s)), tail: named_opt(r, m, b.tail) }),
    NList(l) -> NList({ items: ns(l.items) }),
    NRecord(rc) -> NRecord({ fields: named_fields(r, m, rc.fields) }),
    NMatch(x) -> NMatch({ scrutinee: n(x.scrutinee),
                          arms: map(x.arms, |a: CArm| { pat: named_pat(r, m, a.pat), guard: named_opt(r, m, a.guard),
                                                        body: named(r, m, a.body) }) }),
    NPerform(p) -> NPerform({ effect: p.effect, op: p.op, resource: p.resource, label: named_opt(r, m, p.label), args: ns(p.args) }),
    NCell(x) -> NCell({ resource: x.resource, binder: x.binder, slot: x.slot, init: n(x.init), body: n(x.body) }),
    NLambda(l) -> NLambda({ params: l.params, size: l.size, caps: l.caps, body: n(l.body) }),
    NSim(x) -> NSim({ size: x.size, caps: x.caps, body: n(x.body) }),
    NHandle(h) -> NHandle({ body: n(h.body),
                            clauses: map(h.clauses, |k: CClause| { effect: k.effect, op: k.op, resource: k.resource,
                                                                   label: named_opt(r, m, k.label),
                                                                   params: k.params, resume: k.resume, size: k.size,
                                                                   caps: k.caps, body: named(r, m, k.body) }),
                            ret: match h.ret { Some(x) -> Some({ size: x.size, caps: x.caps, body: n(x.body) }), None -> None } }),
    NField(f) -> NField({ base: n(f.base), field: f.field }),
    NUpd(u) -> NUpd({ base: n(u.base), copies: u.copies, sets: named_fields(r, m, u.sets) }),
  };
  { own: c.own, node: node, span: c.span }
}

fn lowered(r: Resolved, m: Int, params: List<Bytes>, e: Expr) -> Bytes =
  match lower_fn(params, [], map_new(), e) { Some(l) -> dump(named(r, m, l.code)), None -> b"" }

fn clause_text(r: Resolved, m: Int, params: List<Bytes>, e: Expr) -> Bytes =
  bytes_concat_all([span_text(m, expr_span(e)), b"\n", lowered(r, m, params, e)])

// `result` takes the slot after the parameters, as the obligation's binders place it.
fn def_claims(r: Resolved, m: Int, module: Bytes, d: FnDef) -> Bytes = {
  let params = map(d.params, |p: Param| p.name.name);
  framed(b"def", qualify(module, d.name.name), cat([
    [field(b"params", num(len(params))), field(b"body", lowered(r, m, params, d.body))],
    map(d.spec, |c: SpecClause| match c.kind {
      SRequires -> field(b"requires", clause_text(r, m, params, c.expr)),
      SEnsures -> field(b"ensures", clause_text(r, m, push(params, b"result"), c.expr)),
    })]))
}

fn law_claims(r: Resolved, m: Int, module: Bytes, index: Int, d: LawDef) -> Bytes = {
  let names = map(d.binders, |b: Binder| b.name.name);
  framed(b"law", num(index), cat([
    [field(b"key", qualify(module, d.name))],
    match d.guard { Some(g) -> [field(b"guard", clause_text(r, m, names, g))], None -> [] },
    [field(b"body", lowered(r, m, names, d.body))]]))
}

type Claimed = { frames: List<Bytes>, laws: Int }

fn claim_frames(mods: List<Mod>, r: Resolved) -> List<Bytes> = {
  let walked = fold(range(0, len(mods)), { frames: [], laws: 0 }, |acc: Claimed, i: Int| {
    let m = at(mods, i);
    fold(m.module.items, acc, |a: Claimed, it: Item|
      match it {
        IFn(d) -> { frames: push(a.frames, def_claims(r, i, m.name, d)), laws: a.laws },
        // A split over a type is sound only with every variant in hand.
        IType(d) -> match d.body {
          TDSum(vs) -> { frames: push(a.frames, framed(b"sum", qualify(m.name, d.name.name), [field(b"variants", num(len(vs)))])),
                         laws: a.laws },
          _ -> a,
        },
        ILaw(d) -> { frames: push(a.frames, law_claims(r, i, m.name, a.laws, d)), laws: a.laws + 1 },
        _ -> a,
      })
  });
  walked.frames
}

pub fn claims_dump(sources: List<Source>) -> String =
  match resolve_modules(map(parse_all(sources), |p: Parsed| p.module)) {
    Failed(_) -> panic("a program the front end checked does not resolve"),
    Resolved_(x) -> match update_shapes(x.r, x.mods) {
      None -> panic("a program the front end checked does not check"),
      Some(shapes) -> string_of_bytes(bytes_concat_all(claim_frames(expanded_mods(x.mods, shapes), x.r))),
    },
  }

pub fn rehash_dump(sources: List<Source>, pins: List<Pin>) -> String =
  match resolve_modules(map(parse_all(sources), |p: Parsed| p.module)) {
    Failed(_) -> panic("a program the front end checked does not resolve"),
    Resolved_(x) -> {
      let r: Rehashed = rehash_index(build_index(x.mods, x.r).index, pins);
      string_of_bytes(bytes_concat_all(cat([
        map(r.nodes, |n: Rehash| framed(b"node", n.name, cat([
          [field(b"ns", if n.decl { b"decl" } else { b"def" }), field(b"fresh", hex(n.fresh)), field(b"table", hex(n.table))],
          if n.component < 0 { [] } else { [field(b"component", num(n.component))] }]))),
        map(range(0, len(r.tests)), |i: Int| framed(b"test", num(i), [field(b"key", at(r.tests, i).key), field(b"hash", hex(at(r.tests, i).hash))]))])))
    },
  }

pub fn print_dump(bodies: List<Bytes>, names: List<{ name: Bytes, hash: Bytes }>, tests: List<Bytes>,
                  relink: List<{ from: Bytes, to: Bytes }>, shipped: List<Bytes>) -> String =
  string_of_bytes(match print_bodies(bodies, names, tests, relink, shipped) {
    Printed(ms) -> bytes_concat_all(map(ms, |m: { module: Bytes, text: Bytes }| framed(b"module", m.module, [m.text]))),
    Unprintable(why) -> framed(b"refused", b"_", cat([[field(b"message", why.message)], map(why.notes, |n: Bytes| field(b"note", n))])),
  })

pub fn item_range_dump(src: Bytes, name: Bytes) -> String =
  string_of_bytes(match item_range(src, name) {
    Ok(r) -> framed(b"range", b"_", [field(b"start", num(r.start)), field(b"end", num(r.end))]),
    Err(why) -> framed(b"refused", b"_", [field(b"message", why)]),
  })

pub fn replace_dump(src: Bytes, name: Bytes, item: Bytes) -> String =
  string_of_bytes(match replace_item(src, name, item) {
    Ok(text) -> framed(b"replaced", b"_", [text]),
    Err(why) -> framed(b"refused", b"_", [field(b"message", why)]),
  })

// --- Pulling in the shipped modules --------------------------------------------
// As the driver places them: after the program's own modules, a round of new imports at a time, each round in byte order.

fn is_std(name: Bytes) -> Bool = name == b"std" || bytes_starts_with(name, b"std.")

// The compiler's own modules, shelved under one reserved root so a program can import the formatter.
// A shelved module names its siblings under that root too: the shelf hands over text, and the
// emitter parses the same text to name a call, so the root is in the source and not in a tree.
fn is_compiler(name: Bytes) -> Bool = name == b"compiler" || bytes_starts_with(name, b"compiler.")

fn is_shipped(name: Bytes) -> Bool = is_std(name) || is_compiler(name)

fn import_at(imports: List<ImportDecl>, name: Bytes) -> Span = {
  let found = fold(imports, None, |acc: Option<Span>, d: ImportDecl|
    match acc { Some(_) -> acc, None -> if import_module_name(d) == name { Some(path_span(d)) } else { None } });
  match found { Some(s) -> s, None -> dummy_span() }
}

fn unknown_shipped(m: Int, at_: Span, name: Bytes, listed: List<Bytes>) -> Diag =
  diag1(b"E0106", m, at_, bytes_concat_all([b"no module named `", name, b"` ships with this compiler"]), b"not found",
        [bytes_concat(b"the stdlib holds: ", backticked(filter(listed, is_std), b", ")),
         b"`ply std` lists them with the digest this binary was built from"])

fn foreign_import(m: Int, at_: Span, importer: Bytes, name: Bytes) -> Diag =
  diag1(b"E0505", m, at_,
        bytes_concat_all([b"the shipped module `", importer, b"` imports `", name, b"`, which this build does not ship"]),
        b"a stdlib module may import only modules that ship with it",
        [b"this is a defect in the compiler's own sources, not in this program",
         b"please report it with the version of `ply` that produced it"])

type Round = { wanted: Map<Bytes, Bytes>, diags: List<Diag> }

fn pull_round(users: Int, shipped: Map<Bytes, Bytes>, listed: List<Bytes>, parsed: List<Parsed>) -> Round = {
  let present = fold(parsed, map_new(), |acc: Map<Bytes, Bool>, p: Parsed| map_insert(acc, p.name, true));
  fold(range(0, len(parsed)), { wanted: map_new(), diags: [] }, |acc: Round, i: Int| {
    let p = at(parsed, i);
    let imports = p.module.module.imports;
    let ships = i >= users;
    fold(imports, acc, |r: Round, d: ImportDecl| {
      let name = import_module_name(d);
      if is_shipped(name) && !map_contains(present, name) {
        match map_get(shipped, name) {
          Some(src) -> {..r, wanted: map_insert(r.wanted, name, src)},
          None -> {..r, diags: push(r.diags, if ships { foreign_import(i, import_at(imports, name), p.name, name) }
                                             else { unknown_shipped(i, import_at(imports, name), name, listed) })},
        }
      } else if ships && !is_shipped(name) { {..r, diags: push(r.diags, foreign_import(i, import_at(imports, name), p.name, name))} }
      else { r }
    })
  })
}

type Pull = { parsed: List<Parsed>, pulled: List<Bytes>, diags: List<Diag> }

fn pulling(users: Int, shipped: Map<Bytes, Bytes>, listed: List<Bytes>, x: Pull) -> Pull = {
  let early = fold(x.parsed, [], |acc: List<Diag>, p: Parsed| append(acc, p.diags));
  if len(early) > 0 { {..x, diags: early} } else {
    let r = pull_round(users, shipped, listed, x.parsed);
    if len(r.diags) > 0 { {..x, diags: r.diags} }
    else if map_len(r.wanted) == 0 { x }
    else {
      pulling(users, shipped, listed, map_fold(r.wanted, x, |acc: Pull, name: Bytes, src: Bytes|
        {..acc, parsed: push(acc.parsed, parse_at(len(acc.parsed), { name: name, src: src })), pulled: push(acc.pulled, name)}))
    }
  }
}

// `analyse` over `user` and the modules of `shipped` it imports, with those named in the order they
// were pulled: a label's module index points into `user` first and then into `pulled`, so a caller
// that renders one needs both lists.
pub type Pulled = { pulled: List<Bytes>, out: Analysis }

pub fn analyse_pulling_std(user: List<Source>, shipped: List<Source>) -> Pulled =
  analyse_pulling_std_with(user, shipped, [], [])

pub fn analyse_pulling_std_with(user: List<Source>, shipped: List<Source>,
                                defs: List<KnownDefRow>, tests: List<KnownTestRow>) -> Pulled = {
  let texts = fold(shipped, map_new(), |acc: Map<Bytes, Bytes>, s: Source| map_insert(acc, s.name, s.src));
  let x = pulling(len(user), texts, map(shipped, |s: Source| s.name), { parsed: parse_all(user), pulled: [], diags: [] });
  { pulled: x.pulled, out: if len(x.diags) > 0 { Refused(x.diags) } else { analyse_with(x.parsed, defs, tests) } }
}

// `front_dump` over `user` and the modules of `shipped` it imports, led by a `pulled` frame naming those in order.
pub fn front_pulling_std(user: List<Source>, shipped: List<Source>) -> String =
  front_pulling_std_with(user, shipped, [], [])

pub fn front_pulling_std_with(user: List<Source>, shipped: List<Source>,
                              defs: List<KnownDefRow>, tests: List<KnownTestRow>) -> String = {
  let x: Pulled = analyse_pulling_std_with(user, shipped, defs, tests);
  let head = framed(b"pulled", b"_", map(x.pulled, |n: Bytes| field(b"module", n)));
  string_of_bytes(bytes_concat(head, dump_text(dump_of(x.out))))
}

// --- The dump as rows, written and read back -----------------------------------

// --- The rows a dump is made of -----------------------------------------------

// A span as a frame writes it: a module index, `no_module` outside every module, and the offsets.
pub type At = { module: Int, start: Int, end: Int }

pub type ModuleRow = { name: Bytes, index: Int, items: List<Bytes>, imports: List<Bytes>, sets: List<Bytes> }

pub type ParamRow = { name: Bytes, at: At }

pub type SpecRow = { kind: Bytes, index: Int, footprint: Bytes, at: At }

pub type DefRow = { name: Bytes, module: Bytes, simple_name: Bytes, public: Bool, reuse: Bool,
                    scheme: Bytes, footprint: Bytes, performed: Bytes, constraints: List<Bytes>,
                    internally_effectful: Bool, row_aliases: List<Bytes>, params: List<ParamRow>,
                    spec: List<SpecRow>, at: At, literals: List<Bytes> }

pub type TypeRow = { name: Bytes, module: Bytes, simple_name: Bytes, public: Bool, arity: Int, at: At }

pub type TestRow = { key: Bytes, name: Bytes, module: Bytes, index: Int, nondet: Bool,
                     footprint: Bytes, at: At, name_at: At }

pub type BinderRow = { name: Bytes, at: At, ty: Bytes }

pub type LawRow = { key: Bytes, name: Bytes, module: Bytes, index: Int, binders: List<BinderRow>,
                    has_guard: Bool, host: Bool, footprint: Bytes, at: At, literals: List<Bytes> }

pub type OpRow = { name: Bytes, mode: Bytes, resource_param: Bool, params: List<Bytes>, ret: Bytes,
                   scheme: Option<Bytes>, at: At }

pub type EffectRow = { name: Bytes, module: Bytes, simple_name: Bytes, public: Bool, nondet: Bool,
                       ops: List<OpRow>, at: At }

pub type CtorRow = { name: Bytes, module: Bytes, simple_name: Bytes, type_name: Bytes, index: Int,
                     arity: Int, fields: List<Bytes>, scheme: Bytes, at: At }

pub type HashRow = { name: Bytes, def: Option<Bytes>, own: Option<Bytes>, decl: Option<Bytes>,
                     specs: List<Bytes>, spec_texts: List<Bytes>, deps: List<Bytes>, closure: List<Bytes> }

// A test's or a law's hash frame, under the index of the item it is about; `text` is a law's
// sentence hash and is empty for a test.
pub type ItemHashRow = { index: Int, key: Bytes, hash: Bytes, text: Bytes,
                         deps: List<Bytes>, closure: List<Bytes> }

pub type HashFrame = | HDef(HashRow) | HTest(ItemHashRow) | HLaw(ItemHashRow)

pub type OrdinalRow = { module: Bytes, items: List<Bytes> }

pub type BodyRow = { name: Bytes, body: Bytes }

// Every frame of a dump, each table in the order it is written.
pub type Dump = { diags: List<Diag>, order: List<Bytes>, modules: List<ModuleRow>, defs: List<DefRow>,
                  types: List<TypeRow>, tests: List<TestRow>, laws: List<LawRow>,
                  effects: List<EffectRow>, ctors: List<CtorRow>, hashes: List<HashFrame>,
                  ordinals: List<OrdinalRow>, bodies: List<BodyRow>, test_bodies: List<Bytes> }

pub fn empty_dump() -> Dump =
  { diags: [], order: [], modules: [], defs: [], types: [], tests: [], laws: [], effects: [],
    ctors: [], hashes: [], ordinals: [], bodies: [], test_bodies: [] }

pub fn has_error(ds: List<Diag>) -> Bool = fold(ds, false, |acc: Bool, d: Diag| acc || d.severity == b"error")

// --- Writing ------------------------------------------------------------------

// A diagnostic as a frame carries it: the frame holds no dedup key, and the note count is the
// notes. What a reader can answer, so what a `Dump` holds.
pub fn framed_diag(d: Diag) -> Diag =
  { code: d.code, notes: len(d.notes_text), labels: d.labels, text: b"", message: d.message,
    notes_text: d.notes_text, severity: d.severity, fixes: d.fixes }

fn at_text(a: At) -> Bytes = bytes_concat_all([num(a.module), b" ", num(a.start), b" ", num(a.end)])

fn module_frame(m: ModuleRow) -> Bytes =
  framed(b"module", m.name, cat([[field(b"index", num(m.index))],
                                 map(m.items, |x: Bytes| field(b"item", x)),
                                 map(m.imports, |x: Bytes| field(b"import", x)),
                                 map(m.sets, |x: Bytes| field(b"effect_set", x))]))

fn def_frame(d: DefRow) -> Bytes =
  framed(b"def", d.name, cat([
    [field(b"module", d.module), field(b"simple_name", d.simple_name), field(b"public", flag(d.public)),
     field(b"reuse", flag(d.reuse)), field(b"scheme", d.scheme), field(b"footprint", d.footprint),
     field(b"performed", d.performed)],
    map(d.constraints, |c: Bytes| field(b"constraint", c)),
    [field(b"internally_effectful", flag(d.internally_effectful))],
    map(d.row_aliases, |a: Bytes| field(b"row_alias", a)),
    map(d.params, |p: ParamRow| field(b"param", bytes_concat_all([p.name, b" ", at_text(p.at)]))),
    map(d.spec, |s: SpecRow| field(b"spec", bytes_concat_all([s.kind, b" ", num(s.index), b" ", s.footprint, b"\n", at_text(s.at)]))),
    [field(b"span", at_text(d.at))],
    map(d.literals, |x: Bytes| field(b"literal", x))]))

fn type_frame(t: TypeRow) -> Bytes =
  framed(b"type", t.name,
    [field(b"module", t.module), field(b"simple_name", t.simple_name), field(b"public", flag(t.public)),
     field(b"arity", num(t.arity)), field(b"span", at_text(t.at))])

fn test_frame(t: TestRow) -> Bytes =
  framed(b"test", num(t.index),
    [field(b"key", t.key), field(b"name", t.name), field(b"module", t.module), field(b"index", num(t.index)),
     field(b"nondet", flag(t.nondet)), field(b"footprint", t.footprint), field(b"span", at_text(t.at)),
     field(b"name_span", at_text(t.name_at))])

fn law_frame(l: LawRow) -> Bytes =
  framed(b"law", num(l.index), cat([
    [field(b"key", l.key), field(b"name", l.name), field(b"module", l.module), field(b"index", num(l.index))],
    map(l.binders, |b: BinderRow| field(b"binder", bytes_concat_all([b.name, b" ", at_text(b.at), b"\n", b.ty]))),
    [field(b"has_guard", flag(l.has_guard)), field(b"host", flag(l.host)), field(b"footprint", l.footprint),
     field(b"span", at_text(l.at))],
    map(l.literals, |x: Bytes| field(b"literal", x))]))

fn op_text(o: OpRow) -> Bytes =
  bytes_concat_all([o.name, b" ", o.mode, b" ", flag(o.resource_param), b" ", num(len(o.params)), b" ",
                    flag(match o.scheme { Some(_) -> true, None -> false }), b" ", at_text(o.at), b"\n",
                    bytes_concat_all(map(o.params, |p: Bytes| bytes_concat(p, b"\n"))),
                    o.ret, b"\n",
                    match o.scheme { Some(sc) -> bytes_concat(sc, b"\n"), None -> b"" }])

fn effect_frame(e: EffectRow) -> Bytes =
  framed(b"effect", e.name, cat([
    [field(b"module", e.module), field(b"simple_name", e.simple_name), field(b"public", flag(e.public)),
     field(b"nondet", flag(e.nondet))],
    map(e.ops, |o: OpRow| field(b"op", op_text(o))),
    [field(b"span", at_text(e.at))]]))

fn ctor_frame(k: CtorRow) -> Bytes =
  framed(b"ctor", k.name, cat([
    [field(b"module", k.module), field(b"simple_name", k.simple_name), field(b"type_name", k.type_name),
     field(b"index", num(k.index)), field(b"arity", num(k.arity))],
    map(k.fields, |t: Bytes| field(b"field", t)),
    [field(b"scheme", k.scheme), field(b"span", at_text(k.at))]]))

fn hex_field(key: Bytes, h: Option<Bytes>) -> List<Bytes> =
  match h { Some(x) -> [field(key, x)], None -> [] }

fn reach_fields(deps: List<Bytes>, closure: List<Bytes>) -> List<Bytes> =
  append(map(deps, |n: Bytes| field(b"dep", n)), map(closure, |n: Bytes| field(b"closure", n)))

fn hash_frame(f: HashFrame) -> Bytes =
  match f {
    HDef(r) -> framed(b"hash", r.name, cat([hex_field(b"def", r.def), hex_field(b"own", r.own),
                                            hex_field(b"decl", r.decl),
                                            map(r.specs, |h: Bytes| field(b"spec", h)),
                                            map(r.spec_texts, |h: Bytes| field(b"spec_text", h)),
                                            reach_fields(r.deps, r.closure)])),
    HTest(r) -> framed(b"testhash", num(r.index),
                       cat([[field(b"key", r.key), field(b"hash", r.hash)], reach_fields(r.deps, r.closure)])),
    HLaw(r) -> framed(b"lawhash", num(r.index),
                      cat([[field(b"key", r.key), field(b"hash", r.hash), field(b"text", r.text)],
                           reach_fields(r.deps, r.closure)])),
  }

fn ordinal_frame(o: OrdinalRow) -> Bytes =
  framed(b"ordinal", o.module, map(o.items, |x: Bytes| field(b"item", x)))

fn table_frames(d: Dump) -> List<Bytes> =
  cat([[framed(b"order", b"_", map(d.order, |m: Bytes| field(b"module", m)))],
       map(d.modules, module_frame),
       map(d.defs, def_frame),
       map(d.types, type_frame),
       map(d.tests, test_frame),
       map(d.laws, law_frame),
       map(d.effects, effect_frame),
       map(d.ctors, ctor_frame),
       map(d.hashes, hash_frame),
       map(d.ordinals, ordinal_frame),
       map(d.bodies, |b: BodyRow| framed(b"body", b.name, [hex(b.body)])),
       map(range(0, len(d.test_bodies)), |i: Int| framed(b"testbody", num(i), [hex(at(d.test_bodies, i))]))])

// The diagnostics lead; an error is the whole answer, so no table follows one.
pub fn dump_frames(d: Dump) -> List<Bytes> = {
  let ds = map(range(0, len(d.diags)), |i: Int| frame(i, at(d.diags, i)));
  if has_error(d.diags) { ds } else { append(ds, table_frames(d)) }
}

// One concatenation over the finished frames; appending per frame is quadratic.
pub fn dump_text(d: Dump) -> Bytes = bytes_concat_all(dump_frames(d))

// --- Reading: the framing -----------------------------------------------------

type Frame = { words: List<Bytes>, body: Bytes, next: Int }

// A decimal count, refused rather than wrapped: no length or index the dump writes needs 19 digits.
fn number_of(b: Bytes) -> Option<Int> =
  if bytes_len(b) == 0 || bytes_len(b) > 18 { None } else {
    fold(range(0, bytes_len(b)), Some(0), |acc: Option<Int>, i: Int|
      match acc {
        None -> None,
        Some(v) -> { let c = bytes_at(b, i); if c < 48 || c > 57 { None } else { Some(v * 10 + (c - 48)) } },
      })
  }

fn signed_of(b: Bytes) -> Option<Int> =
  if bytes_len(b) > 1 && bytes_at(b, 0) == 45 {
    match number_of(bytes_slice(b, 1, bytes_len(b))) { Some(v) -> Some(0 - v), None -> None }
  } else { number_of(b) }

fn unit(b: Bytes, from: Int, what: Bytes) -> Result<Frame, Bytes> =
  match bytes_index_of_from(b, b"\n", from) {
    None -> Err(bytes_concat_all([what, b" header at byte ", num(from), b" never ends"])),
    Some(nl) -> {
      let header = bytes_slice(b, from, nl);
      let words = bytes_split(header, b" ");
      if len(words) == 0 { Err(bytes_concat_all([what, b" header `", header, b"` does not end in a length"])) }
      else {
        match number_of(at(words, len(words) - 1)) {
          None -> Err(bytes_concat_all([what, b" header `", header, b"` does not end in a length"])),
          Some(length) ->
            if nl + 1 + length > bytes_len(b) {
              Err(bytes_concat_all([what, b" `", header, b"` is truncated: ", num(bytes_len(b) - nl - 1),
                                    b" of ", num(length), b" bytes follow it"]))
            } else {
              Ok({ words: take(words, len(words) - 1), body: bytes_slice(b, nl + 1, nl + 1 + length),
                   next: nl + 1 + length })
            },
        }
      }
    },
  }

type KV = { key: Bytes, text: Bytes }

type FieldWalk = { at: Int, acc: List<KV> }

fn fields_of(b: Bytes) -> Result<List<KV>, Bytes> =
  iterate({ at: 0, acc: [] }, bytes_len(b) + 2, |s: FieldWalk|
    if s.at >= bytes_len(b) { Stop(Ok(s.acc)) } else {
      match unit(b, s.at, b"field") {
        Err(e) -> Stop(Err(e)),
        Ok(u) ->
          if len(u.words) == 1 { Continue({ at: u.next, acc: push(s.acc, { key: at(u.words, 0), text: u.body }) }) }
          else { Stop(Err(bytes_concat_all([b"field header `", joined(u.words, b" "), b"` is not `<key> <length>`"]))) },
      }
    })

fn all_of(fs: List<KV>, key: Bytes) -> List<Bytes> =
  fold(fs, [], |acc: List<Bytes>, f: KV| if f.key == key { push(acc, f.text) } else { acc })

fn one_of(what: Bytes, fs: List<KV>, key: Bytes) -> Result<Bytes, Bytes> = {
  let xs = all_of(fs, key);
  if len(xs) == 1 { Ok(at(xs, 0)) }
  else if len(xs) == 0 { Err(bytes_concat_all([what, b" has no `", key, b"`"])) }
  else { Err(bytes_concat_all([what, b" has two `", key, b"` fields"])) }
}

fn opt_of(what: Bytes, fs: List<KV>, key: Bytes) -> Result<Option<Bytes>, Bytes> = {
  let xs = all_of(fs, key);
  if len(xs) == 0 { Ok(None) }
  else if len(xs) == 1 { Ok(Some(at(xs, 0))) }
  else { Err(bytes_concat_all([what, b" has two `", key, b"` fields"])) }
}

// The grammar is the format's version: a field this reader does not know is refused rather than
// dropped, so a dump a later writer wrote never half-reads.
fn known(what: Bytes, fs: List<KV>, keys: List<Bytes>) -> Result<List<KV>, Bytes> =
  fold(fs, Ok(fs), |acc: Result<List<KV>, Bytes>, f: KV|
    match acc {
      Err(e) -> Err(e),
      Ok(kept) -> if contains_bytes(keys, f.key) { Ok(kept) }
                  else { Err(bytes_concat_all([what, b": unknown field `", f.key, b"`"])) },
    })

fn each<a>(xs: List<Bytes>, f: (Bytes) -> Result<a, Bytes>) -> Result<List<a>, Bytes> =
  fold(xs, Ok([]), |acc: Result<List<a>, Bytes>, x: Bytes|
    match acc {
      Err(e) -> Err(e),
      Ok(ys) -> match f(x) { Err(e) -> Err(e), Ok(y) -> Ok(push(ys, y)) },
    })

// One field read whole. The emitter walks an expression by recursion and each `?` expands to a
// `match` wrapping the rest of its block, so a reader that wants ten fields nests ten levels and
// not twenty.
fn fields(what: Bytes, body: Bytes, keys: List<Bytes>) -> Result<List<KV>, Bytes> =
  known(what, fields_of(body)?, keys)

fn flagged(what: Bytes, fs: List<KV>, key: Bytes) -> Result<Bool, Bytes> =
  flag_of(what, key, one_of(what, fs, key)?)

fn counted(what: Bytes, fs: List<KV>, key: Bytes) -> Result<Int, Bytes> =
  number(what, key, one_of(what, fs, key)?)

fn spanned(what: Bytes, fs: List<KV>, key: Bytes) -> Result<At, Bytes> =
  at_of(what, one_of(what, fs, key)?)

fn hashed(what: Bytes, fs: List<KV>, key: Bytes) -> Result<Bytes, Bytes> =
  hash_text(what, key, one_of(what, fs, key)?)

fn hashed_opt(what: Bytes, fs: List<KV>, key: Bytes) -> Result<Option<Bytes>, Bytes> =
  opt_hash(what, key, opt_of(what, fs, key)?)

fn at_index(what: Bytes, fs: List<KV>, want: Int) -> Result<Int, Bytes> =
  indexed(what, one_of(what, fs, b"index")?, want)

fn number(what: Bytes, key: Bytes, text: Bytes) -> Result<Int, Bytes> =
  match number_of(text) {
    Some(v) -> Ok(v),
    None -> Err(bytes_concat_all([what, b": `", key, b"` holds `", text, b"`, not a number"])),
  }

fn flag_of(what: Bytes, key: Bytes, text: Bytes) -> Result<Bool, Bytes> =
  if text == b"1" { Ok(true) }
  else if text == b"0" { Ok(false) }
  else { Err(bytes_concat_all([what, b": `", key, b"` is `", text, b"`, not 0 or 1"])) }

fn hex_value(c: Int) -> Int =
  if c >= 48 && c <= 57 { c - 48 }
  else if c >= 97 && c <= 102 { c - 87 }
  else if c >= 65 && c <= 70 { c - 55 }
  else { 0 - 1 }

fn all_hex(b: Bytes) -> Bool =
  fold(range(0, bytes_len(b)), true, |acc: Bool, i: Int| acc && hex_value(bytes_at(b, i)) >= 0)

fn hash_text(what: Bytes, key: Bytes, text: Bytes) -> Result<Bytes, Bytes> =
  if bytes_len(text) == 64 && all_hex(text) { Ok(text) }
  else { Err(bytes_concat_all([what, b": `", key, b"` holds `", text, b"`, not a hash"])) }

fn unhexed(what: Bytes, h: Bytes) -> Result<Bytes, Bytes> =
  if bytes_len(h) % 2 != 0 { Err(bytes_concat(what, b": an odd number of hex digits")) }
  else if !all_hex(h) { Err(bytes_concat(what, b": a byte that is not a hex digit")) }
  else { Ok(bytes_concat_all(map(range(0, bytes_len(h) / 2), |i: Int|
         byte_of(hex_value(bytes_at(h, 2 * i)) * 16 + hex_value(bytes_at(h, 2 * i + 1)))))) }

fn split_at_byte(b: Bytes, sep: Bytes) -> Option<{ head: Bytes, rest: Bytes }> =
  match bytes_index_of(b, sep) {
    Some(i) -> Some({ head: bytes_slice(b, 0, i), rest: bytes_slice(b, i + bytes_len(sep), bytes_len(b)) }),
    None -> None,
  }

fn at_of(what: Bytes, text: Bytes) -> Result<At, Bytes> = {
  let words = bytes_split(text, b" ");
  if len(words) != 3 { Err(bytes_concat_all([what, b": `", text, b"` is not `<module> <start> <end>`"])) }
  else {
    let ns = fold(words, Some([]), |acc: Option<List<Int>>, w: Bytes|
      match acc {
        None -> None,
        Some(xs) -> match number_of(w) { Some(v) -> Some(push(xs, v)), None -> None },
      });
    match ns {
      None -> Err(bytes_concat_all([what, b": span `", text, b"` holds a word that is not a number"])),
      Some(xs) -> Ok({ module: at(xs, 0), start: at(xs, 1), end: at(xs, 2) }),
    }
  }
}

// --- Reading: the diagnostics -------------------------------------------------

fn read_label(about: Bytes, text: Bytes) -> Result<Label, Bytes> =
  match split_at_byte(text, b"\n") {
    None -> Err(bytes_concat(about, b": a label has no `<module> <start> <end> <0|1>` line")),
    Some(cut) -> {
      let words = bytes_split(cut.head, b" ");
      if len(words) != 4 {
        Err(bytes_concat_all([about, b": label header `", cut.head, b"` is not `<module> <start> <end> <0|1>`"]))
      } else {
        let a = at_of(about, joined([at(words, 0), at(words, 1), at(words, 2)], b" "))?;
        let primary = flag_of(about, b"primary", at(words, 3))?;
        Ok({ module: a.module, start: a.start, end: a.end, primary: primary, text: cut.rest })
      }
    },
  }

fn read_edit(about: Bytes, text: Bytes) -> Result<Edit, Bytes> =
  match split_at_byte(text, b"\n") {
    None -> Err(bytes_concat(about, b": an edit with no text line")),
    Some(cut) -> {
      let a = at_of(about, cut.head)?;
      Ok({ module: a.module, start: a.start, end: a.end, text: cut.rest })
    },
  }

type DiagParts = { labels: List<Label>, notes: List<Bytes>, fixes: List<Fix>, err: Option<Bytes> }

fn diag_part(about: Bytes, acc: DiagParts, f: KV) -> DiagParts =
  match acc.err {
    Some(_) -> acc,
    None ->
      if f.key == b"label" {
        match read_label(about, f.text) {
          Err(e) -> {..acc, err: Some(e)},
          Ok(l) -> {..acc, labels: push(acc.labels, l)},
        }
      } else if f.key == b"note" { {..acc, notes: push(acc.notes, f.text)} }
      else if f.key == b"fix" { {..acc, fixes: push(acc.fixes, { title: f.text, edits: [] })} }
      else if f.key == b"edit" {
        if len(acc.fixes) == 0 { {..acc, err: Some(bytes_concat(about, b": an `edit` before any `fix`"))} }
        else {
          match read_edit(about, f.text) {
            Err(e) -> {..acc, err: Some(e)},
            Ok(e) -> {
              let last: Fix = at(acc.fixes, len(acc.fixes) - 1);
              {..acc, fixes: list_set(acc.fixes, len(acc.fixes) - 1,
                                      { title: last.title, edits: push(last.edits, e) })}
            },
          }
        }
      } else { acc },
  }

fn read_diag(index: Int, body: Bytes) -> Result<Diag, Bytes> = {
  let about = bytes_concat(b"diagnostic ", num(index));
  let fs = fields(about, body, [b"code", b"severity", b"message", b"label", b"note", b"fix",
                                b"edit"])?;
  let code = one_of(about, fs, b"code")?;
  let severity = one_of(about, fs, b"severity")?;
  let message = one_of(about, fs, b"message")?;
  if severity != b"error" && severity != b"warning" {
    Err(bytes_concat_all([about, b": unknown severity `", severity, b"`"]))
  } else {
    let walked = fold(fs, { labels: [], notes: [], fixes: [], err: None },
                      |acc: DiagParts, f: KV| diag_part(about, acc, f));
    match walked.err {
      Some(e) -> Err(e),
      None -> Ok({ code: code, notes: len(walked.notes), labels: walked.labels, text: b"",
                   message: message, notes_text: walked.notes, severity: severity,
                   fixes: walked.fixes }),
    }
  }
}

// --- Reading: one table frame -------------------------------------------------

fn what_of(kind: Bytes, name: Bytes) -> Bytes = bytes_concat_all([kind, b" `", name, b"`"])

fn read_set(what: Bytes, text: Bytes) -> Result<Bytes, Bytes> =
  if len(bytes_split(text, b" ")) == 3 { Ok(text) }
  else { Err(bytes_concat_all([what, b": effect set `", text, b"` is not `<name> <includes> <atoms>`"])) }

fn read_module(name: Bytes, body: Bytes, what: Bytes) -> Result<ModuleRow, Bytes> = {
  let fs = fields(what, body, [b"index", b"item", b"import", b"effect_set"])?;
  let index = counted(what, fs, b"index")?;
  let sets = each(all_of(fs, b"effect_set"), |x: Bytes| read_set(what, x))?;
  Ok({ name: name, index: index, items: all_of(fs, b"item"), imports: all_of(fs, b"import"),
       sets: sets })
}

fn read_constraint(what: Bytes, text: Bytes) -> Result<Bytes, Bytes> =
  match split_at_byte(text, b" ") {
    None -> Err(bytes_concat_all([what, b": constraint `", text, b"` is not `<deriver> <param>`"])),
    Some(cut) ->
      if cut.head != b"json" && cut.head != b"eq" && cut.head != b"ord" {
        Err(bytes_concat_all([what, b": `", cut.head, b"` is not a deriver"]))
      } else {
        match number_of(cut.rest) {
          None -> Err(bytes_concat_all([what, b": constraint `", text, b"` does not name a parameter"])),
          Some(_) -> Ok(text),
        }
      },
  }

fn read_literal(what: Bytes, text: Bytes) -> Result<Bytes, Bytes> =
  match split_at_byte(text, b" ") {
    None -> Err(bytes_concat_all([what, b": literal `", text, b"` is not `<int|str|bytes> <value>`"])),
    Some(cut) ->
      if cut.head == b"str" { Ok(text) }
      else if cut.head == b"int" {
        match signed_of(cut.rest) {
          Some(_) -> Ok(text),
          None -> Err(bytes_concat_all([what, b": literal `", cut.rest, b"` is not an integer"])),
        }
      } else if cut.head == b"bytes" {
        match unhexed(what, cut.rest) { Ok(_) -> Ok(text), Err(e) -> Err(e) }
      } else { Err(bytes_concat_all([what, b": `", cut.head, b"` is not `int`, `str` or `bytes`"])) },
  }

fn read_param(what: Bytes, text: Bytes) -> Result<ParamRow, Bytes> =
  match split_at_byte(text, b" ") {
    None -> Err(bytes_concat_all([what, b": param `", text, b"` is not `<name> <span>`"])),
    Some(cut) -> { let a = at_of(what, cut.rest)?; Ok({ name: cut.head, at: a }) },
  }

fn spec_kind(what: Bytes, text: Bytes) -> Result<Bytes, Bytes> =
  if text == b"requires" || text == b"ensures" { Ok(text) }
  else { Err(bytes_concat_all([what, b": `", text, b"` is not `requires` or `ensures`"])) }

fn read_spec(what: Bytes, text: Bytes) -> Result<SpecRow, Bytes> =
  match split_at_byte(text, b"\n") {
    None -> Err(bytes_concat(what, b": a spec has no span line")),
    Some(cut) -> {
      let words = bytes_split(cut.head, b" ");
      if len(words) != 3 {
        Err(bytes_concat_all([what, b": spec `", cut.head, b"` is not `<kind> <index> <footprint>`"]))
      } else {
        let kind = spec_kind(what, at(words, 0))?;
        let index = number(what, b"spec", at(words, 1))?;
        let a = at_of(what, cut.rest)?;
        Ok({ kind: kind, index: index, footprint: at(words, 2), at: a })
      }
    },
  }

// What a `def` frame says once. Read together so no one reader nests a `?` for every field.
type DefSaid = { module: Bytes, simple: Bytes, public: Bool, reuse: Bool, scheme: Bytes,
                 footprint: Bytes, performed: Bytes, effectful: Bool, at: At }

fn def_said(what: Bytes, fs: List<KV>) -> Result<DefSaid, Bytes> = {
  let module = one_of(what, fs, b"module")?;
  let simple = one_of(what, fs, b"simple_name")?;
  let public = flagged(what, fs, b"public")?;
  let reused = flagged(what, fs, b"reuse")?;
  let scheme = one_of(what, fs, b"scheme")?;
  let footprint = one_of(what, fs, b"footprint")?;
  let performed = one_of(what, fs, b"performed")?;
  let effectful = flagged(what, fs, b"internally_effectful")?;
  let a = spanned(what, fs, b"span")?;
  Ok({ module: module, simple: simple, public: public, reuse: reused, scheme: scheme,
       footprint: footprint, performed: performed, effectful: effectful, at: a })
}

fn read_def(name: Bytes, body: Bytes, what: Bytes) -> Result<DefRow, Bytes> = {
  let fs = fields(what, body,
                  [b"module", b"simple_name", b"public", b"reuse", b"scheme", b"footprint",
                   b"performed", b"constraint", b"internally_effectful", b"row_alias", b"param",
                   b"spec", b"span", b"literal"])?;
  let said = def_said(what, fs)?;
  let constraints = each(all_of(fs, b"constraint"), |c: Bytes| read_constraint(what, c))?;
  let params = each(all_of(fs, b"param"), |p: Bytes| read_param(what, p))?;
  let specs = each(all_of(fs, b"spec"), |x: Bytes| read_spec(what, x))?;
  let literals = each(all_of(fs, b"literal"), |l: Bytes| read_literal(what, l))?;
  Ok({ name: name, module: said.module, simple_name: said.simple, public: said.public,
       reuse: said.reuse, scheme: said.scheme, footprint: said.footprint,
       performed: said.performed, constraints: constraints,
       internally_effectful: said.effectful, row_aliases: all_of(fs, b"row_alias"),
       params: params, spec: specs, at: said.at, literals: literals })
}

fn read_type(name: Bytes, body: Bytes, what: Bytes) -> Result<TypeRow, Bytes> = {
  let fs = fields(what, body, [b"module", b"simple_name", b"public", b"arity", b"span"])?;
  let module = one_of(what, fs, b"module")?;
  let simple = one_of(what, fs, b"simple_name")?;
  let public = flagged(what, fs, b"public")?;
  let arity = counted(what, fs, b"arity")?;
  let a = spanned(what, fs, b"span")?;
  Ok({ name: name, module: module, simple_name: simple, public: public, arity: arity, at: a })
}

fn indexed(what: Bytes, text: Bytes, want: Int) -> Result<Int, Bytes> = {
  let index = number(what, b"index", text)?;
  if index == want { Ok(index) }
  else {
    Err(bytes_concat_all([what, b": `index` is ", num(index), b", but the frame is numbered ", num(want)]))
  }
}

fn read_test(body: Bytes, what: Bytes, want: Int) -> Result<TestRow, Bytes> = {
  let fs = fields(what, body, [b"key", b"name", b"module", b"index", b"nondet", b"footprint",
                               b"span", b"name_span"])?;
  let key = one_of(what, fs, b"key")?;
  let name = one_of(what, fs, b"name")?;
  let module = one_of(what, fs, b"module")?;
  let index = at_index(what, fs, want)?;
  let marked = flagged(what, fs, b"nondet")?;
  let footprint = one_of(what, fs, b"footprint")?;
  let a = spanned(what, fs, b"span")?;
  let name_at = spanned(what, fs, b"name_span")?;
  Ok({ key: key, name: name, module: module, index: index, nondet: marked, footprint: footprint,
       at: a, name_at: name_at })
}

fn read_binder(what: Bytes, text: Bytes) -> Result<BinderRow, Bytes> =
  match split_at_byte(text, b"\n") {
    None -> Err(bytes_concat_all([what, b": binder `", text, b"` has no type line"])),
    Some(cut) ->
      match split_at_byte(cut.head, b" ") {
        None -> Err(bytes_concat_all([what, b": binder `", cut.head, b"` is not `<name> <span>`"])),
        Some(named) -> { let a = at_of(what, named.rest)?; Ok({ name: named.head, at: a, ty: cut.rest }) },
      },
  }

// What a `law` frame says once, beside the binders and literals it repeats.
type LawSaid = { key: Bytes, name: Bytes, module: Bytes, index: Int, has_guard: Bool, host: Bool,
                 footprint: Bytes, at: At }

fn law_said(what: Bytes, fs: List<KV>, want: Int) -> Result<LawSaid, Bytes> = {
  let key = one_of(what, fs, b"key")?;
  let name = one_of(what, fs, b"name")?;
  let module = one_of(what, fs, b"module")?;
  let index = at_index(what, fs, want)?;
  let guarded = flagged(what, fs, b"has_guard")?;
  let hosted = flagged(what, fs, b"host")?;
  let footprint = one_of(what, fs, b"footprint")?;
  let a = spanned(what, fs, b"span")?;
  Ok({ key: key, name: name, module: module, index: index, has_guard: guarded, host: hosted,
       footprint: footprint, at: a })
}

fn read_law(body: Bytes, what: Bytes, want: Int) -> Result<LawRow, Bytes> = {
  let fs = fields(what, body, [b"key", b"name", b"module", b"index", b"binder", b"has_guard",
                               b"host", b"footprint", b"span", b"literal"])?;
  let said = law_said(what, fs, want)?;
  let binders = each(all_of(fs, b"binder"), |b: Bytes| read_binder(what, b))?;
  let literals = each(all_of(fs, b"literal"), |l: Bytes| read_literal(what, l))?;
  Ok({ key: said.key, name: said.name, module: said.module, index: said.index, binders: binders,
       has_guard: said.has_guard, host: said.host, footprint: said.footprint, at: said.at,
       literals: literals })
}

fn read_op(what: Bytes, text: Bytes) -> Result<OpRow, Bytes> =
  if bytes_len(text) == 0 || bytes_at(text, bytes_len(text) - 1) != 10 {
    Err(bytes_concat(what, b": an op's last line does not end"))
  } else {
    let lines = bytes_split(bytes_slice(text, 0, bytes_len(text) - 1), b"\n");
    let head = bytes_split(at(lines, 0), b" ");
    if len(head) != 8 {
      Err(bytes_concat_all([what, b": op `", at(lines, 0),
                            b"` is not `<name> <mode> <resource_param> <param count> <has_scheme> <span>`"]))
    } else {
      let count = number(what, b"op", at(head, 3))?;
      let has_scheme = flag_of(what, b"op", at(head, 4))?;
      let want = 2 + count + (if has_scheme { 1 } else { 0 });
      if len(lines) != want {
        Err(bytes_concat_all([what, b": op `", at(head, 0), b"` declares ", num(count),
                              b" parameter(s) and has ", num(len(lines)), b" line(s), not ", num(want)]))
      } else if at(head, 1) != b"read" && at(head, 1) != b"write" {
        Err(bytes_concat_all([what, b": `", at(head, 1), b"` is not `read` or `write`"]))
      } else {
        let resource_param = flag_of(what, b"op", at(head, 2))?;
        let a = at_of(what, joined([at(head, 5), at(head, 6), at(head, 7)], b" "))?;
        Ok({ name: at(head, 0), mode: at(head, 1), resource_param: resource_param,
             params: map(range(1, 1 + count), |i: Int| at(lines, i)),
             ret: at(lines, count + 1),
             scheme: if has_scheme { Some(at(lines, count + 2)) } else { None },
             at: a })
      }
    }
  }

fn read_effect(name: Bytes, body: Bytes, what: Bytes) -> Result<EffectRow, Bytes> = {
  let fs = fields(what, body, [b"module", b"simple_name", b"public", b"nondet", b"op", b"span"])?;
  let module = one_of(what, fs, b"module")?;
  let simple = one_of(what, fs, b"simple_name")?;
  let public = flagged(what, fs, b"public")?;
  let marked = flagged(what, fs, b"nondet")?;
  let ops = each(all_of(fs, b"op"), |o: Bytes| read_op(what, o))?;
  let a = spanned(what, fs, b"span")?;
  if twice_named(ops) { Err(bytes_concat(what, b" declares one operation twice")) }
  else {
    Ok({ name: name, module: module, simple_name: simple, public: public, nondet: marked,
         ops: ops, at: a })
  }
}

fn twice_named(ops: List<OpRow>) -> Bool = {
  let walked = fold(ops, { seen: map_new(), twice: false },
                    |acc: { seen: Map<Bytes, Bool>, twice: Bool }, o: OpRow|
                      { seen: map_insert(acc.seen, o.name, true),
                        twice: acc.twice || map_contains(acc.seen, o.name) });
  walked.twice
}

fn read_ctor(name: Bytes, body: Bytes, what: Bytes) -> Result<CtorRow, Bytes> = {
  let fs = fields(what, body, [b"module", b"simple_name", b"type_name", b"index", b"arity",
                               b"field", b"scheme", b"span"])?;
  let module = one_of(what, fs, b"module")?;
  let simple = one_of(what, fs, b"simple_name")?;
  let type_name = one_of(what, fs, b"type_name")?;
  let index = counted(what, fs, b"index")?;
  let arity = counted(what, fs, b"arity")?;
  let scheme = one_of(what, fs, b"scheme")?;
  let a = spanned(what, fs, b"span")?;
  Ok({ name: name, module: module, simple_name: simple, type_name: type_name, index: index,
       arity: arity, fields: all_of(fs, b"field"), scheme: scheme, at: a })
}

fn read_hash(name: Bytes, body: Bytes, what: Bytes) -> Result<HashRow, Bytes> = {
  let fs = fields(what, body, [b"def", b"own", b"decl", b"spec", b"spec_text", b"dep",
                               b"closure"])?;
  let def = hashed_opt(what, fs, b"def")?;
  let own = hashed_opt(what, fs, b"own")?;
  let decl = hashed_opt(what, fs, b"decl")?;
  let specs = each(all_of(fs, b"spec"), |h: Bytes| hash_text(what, b"spec", h))?;
  let spec_texts = each(all_of(fs, b"spec_text"), |h: Bytes| hash_text(what, b"spec_text", h))?;
  Ok({ name: name, def: def, own: own, decl: decl, specs: specs, spec_texts: spec_texts,
       deps: all_of(fs, b"dep"), closure: all_of(fs, b"closure") })
}

fn opt_hash(what: Bytes, key: Bytes, h: Option<Bytes>) -> Result<Option<Bytes>, Bytes> =
  match h {
    None -> Ok(None),
    Some(text) -> { let checked = hash_text(what, key, text)?; Ok(Some(checked)) },
  }

// A law carries the hash of its sentence beside the hash of its obligation; a test does not.
fn item_text(what: Bytes, fs: List<KV>, law: Bool) -> Result<Bytes, Bytes> =
  if law { hash_text(what, b"text", one_of(what, fs, b"text")?) } else { Ok(b"") }

fn item_hash_row(what: Bytes, fs: List<KV>, index: Int, key: Bytes, law: Bool) -> Result<ItemHashRow, Bytes> = {
  let h = hashed(what, fs, b"hash")?;
  let text = item_text(what, fs, law)?;
  Ok({ index: index, key: key, hash: h, text: text, deps: all_of(fs, b"dep"),
       closure: all_of(fs, b"closure") })
}

fn read_item_hash(body: Bytes, what: Bytes, index: Int, key: Bytes, law: Bool) -> Result<ItemHashRow, Bytes> = {
  let keys = if law { [b"key", b"hash", b"text", b"dep", b"closure"] }
             else { [b"key", b"hash", b"dep", b"closure"] };
  let fs = fields(what, body, keys)?;
  let written = one_of(what, fs, b"key")?;
  if written != key {
    Err(bytes_concat_all([what, b" is keyed `", written, b"`, but the item it numbers is `", key, b"`"]))
  } else { item_hash_row(what, fs, index, key, law) }
}

fn read_ordinal_item(what: Bytes, text: Bytes) -> Result<Bytes, Bytes> =
  match split_at_byte(text, b" ") {
    None -> Err(bytes_concat_all([what, b": item `", text, b"` is not `<fn|test|law> <name>`"])),
    Some(cut) ->
      if cut.head == b"test" || cut.head == b"law" { Ok(text) }
      else if cut.head == b"fn" {
        match split_at_byte(cut.rest, b" ") {
          None -> Ok(text),
          Some(kinds) ->
            match each(bytes_split(kinds.rest, b","), |k: Bytes| spec_kind(what, k)) {
              Err(e) -> Err(e),
              Ok(_) -> Ok(text),
            },
        }
      } else { Err(bytes_concat_all([what, b": `", cut.head, b"` is not `fn`, `test` or `law`"])) },
  }

// --- Reading: the walk over the frames ----------------------------------------

type Frames = { at: Int, index: Int, leading: Bool, dump: Dump, named: Map<Bytes, Bool>,
              tested: Map<Int, Bool>, lawed: Map<Int, Bool> }

fn numbered(what: Bytes, name: Bytes, want: Int) -> Result<Int, Bytes> =
  if name == num(want) { Ok(want) }
  else { Err(bytes_concat_all([what, b" is numbered out of order; frame ", num(want), b" was expected"])) }

// The test or law a `testhash` or `lawhash` frame is about, which an earlier frame declared.
fn item_index(what: Bytes, name: Bytes, declared: Int, of: Bytes) -> Result<Int, Bytes> =
  match number_of(name) {
    None -> Err(bytes_concat(what, b" is not numbered")),
    Some(i) ->
      if i >= declared {
        Err(bytes_concat_all([what, b" names ", of, b" ", num(i), b", and only ", num(declared), b" were declared"]))
      } else { Ok(i) },
  }

fn missing(seen: Map<Int, Bool>, n: Int) -> Option<Int> =
  fold(range(0, n), None, |acc: Option<Int>, i: Int|
    match acc { Some(_) -> acc, None -> if map_contains(seen, i) { None } else { Some(i) } })

// The frame kinds, in the order their tags number them.
fn frame_kinds() -> List<Bytes> =
  [b"order", b"module", b"def", b"type", b"test", b"law", b"effect", b"ctor",
   b"hash", b"testhash", b"lawhash", b"ordinal", b"body", b"testbody"]

// A kind's tag, or -1 for one this reader does not know. Looked up rather than compared down a
// chain of `else if`, which nests as deeply as the chain is long and is what the emitter walks.
fn frame_tag(kind: Bytes) -> Int = {
  let names = frame_kinds();
  fold(range(0, len(names)), 0 - 1, |acc: Int, i: Int|
    if acc >= 0 || at(names, i) != kind { acc } else { i })
}

fn declared_row(d: Dump, tag: Int, name: Bytes, u: Frame, what: Bytes) -> Result<Dump, Bytes> =
  if tag == 0 {
    let fs = fields(what, u.body, [b"module"])?;
    Ok({..d, order: append(d.order, all_of(fs, b"module"))})
  } else if tag == 1 {
    let row = read_module(name, u.body, what)?;
    Ok({..d, modules: push(d.modules, row)})
  } else if tag == 2 {
    let row = read_def(name, u.body, what)?;
    Ok({..d, defs: push(d.defs, row)})
  } else {
    let row = read_type(name, u.body, what)?;
    Ok({..d, types: push(d.types, row)})
  }

fn item_row(d: Dump, tag: Int, name: Bytes, u: Frame, what: Bytes) -> Result<Dump, Bytes> =
  if tag == 4 {
    let want = numbered(what, name, len(d.tests))?;
    let row = read_test(u.body, what, want)?;
    Ok({..d, tests: push(d.tests, row)})
  } else if tag == 5 {
    let want = numbered(what, name, len(d.laws))?;
    let row = read_law(u.body, what, want)?;
    Ok({..d, laws: push(d.laws, row)})
  } else if tag == 6 {
    let row = read_effect(name, u.body, what)?;
    Ok({..d, effects: push(d.effects, row)})
  } else {
    let row = read_ctor(name, u.body, what)?;
    Ok({..d, ctors: push(d.ctors, row)})
  }

fn bulk_row(d: Dump, tag: Int, name: Bytes, u: Frame, what: Bytes) -> Result<Dump, Bytes> =
  if tag == 11 {
    let fs = fields(what, u.body, [b"item"])?;
    let items = each(all_of(fs, b"item"), |x: Bytes| read_ordinal_item(what, x))?;
    Ok({..d, ordinals: push(d.ordinals, { module: name, items: items })})
  } else if tag == 12 {
    let bytes = unhexed(what, u.body)?;
    Ok({..d, bodies: push(d.bodies, { name: name, body: bytes })})
  } else {
    match numbered(what, name, len(d.test_bodies)) {
      Err(e) -> Err(e),
      Ok(_) -> {
        let bytes = unhexed(what, u.body)?;
        Ok({..d, test_bodies: push(d.test_bodies, bytes)})
      },
    }
  }

// The kinds that only add a row to one table, so the walk's own bookkeeping stays out of them.
fn table_row(moved: Frames, d: Dump, tag: Int, name: Bytes, u: Frame, what: Bytes) -> Result<Frames, Bytes> = {
  let row = if tag < 4 { declared_row(d, tag, name, u, what) }
            else if tag < 8 { item_row(d, tag, name, u, what) }
            else { bulk_row(d, tag, name, u, what) };
  match row { Err(e) -> Err(e), Ok(next) -> Ok({..moved, dump: next}) }
}

// A name is hashed once, and a test's or a law's hash frame names one an earlier frame declared.
fn hashed_row(s: Frames, moved: Frames, tag: Int, name: Bytes, u: Frame, what: Bytes) -> Result<Frames, Bytes> = {
  let d: Dump = s.dump;
  if tag == 8 {
    if map_contains(s.named, name) { Err(bytes_concat(what, b" is written twice")) } else {
      let row = read_hash(name, u.body, what)?;
      Ok({..moved, named: map_insert(s.named, name, true),
                   dump: {..d, hashes: push(d.hashes, HDef(row))}})
    }
  } else if tag == 9 {
    let i = item_index(what, name, len(d.tests), b"test")?;
    if map_contains(s.tested, i) { Err(bytes_concat(what, b" is written twice")) } else {
      let row = read_item_hash(u.body, what, i, at(d.tests, i).key, false)?;
      Ok({..moved, tested: map_insert(s.tested, i, true),
                   dump: {..d, hashes: push(d.hashes, HTest(row))}})
    }
  } else {
    let i = item_index(what, name, len(d.laws), b"law")?;
    if map_contains(s.lawed, i) { Err(bytes_concat(what, b" is written twice")) } else {
      let row = read_item_hash(u.body, what, i, at(d.laws, i).key, true)?;
      Ok({..moved, lawed: map_insert(s.lawed, i, true),
                   dump: {..d, hashes: push(d.hashes, HLaw(row))}})
    }
  }
}

fn table_frame(s: Frames, kind: Bytes, name: Bytes, u: Frame) -> Result<Frames, Bytes> = {
  let what = what_of(kind, name);
  let moved: Frames = { at: u.next, index: s.index + 1, leading: false, dump: s.dump,
                        named: s.named, tested: s.tested, lawed: s.lawed };
  let tag = frame_tag(kind);
  if tag < 0 {
    Err(bytes_concat_all([b"frame ", num(s.index), b": unknown frame kind `", kind, b"`"]))
  } else if tag >= 8 && tag <= 10 { hashed_row(s, moved, tag, name, u, what) }
  else { table_row(moved, s.dump, tag, name, u, what) }
}

fn finish(s: Frames) -> Result<Dump, Bytes> =
  if s.leading {
    if has_error(s.dump.diags) { Ok(s.dump) }
    else { Err(b"the dump ends after the diagnostics, none of which is an error") }
  } else {
    let d: Dump = s.dump;
    match missing(s.tested, len(d.tests)) {
      Some(i) -> Err(bytes_concat_all([b"test ", num(i), b" has no `testhash` frame"])),
      None ->
        match missing(s.lawed, len(d.laws)) {
          Some(i) -> Err(bytes_concat_all([b"law ", num(i), b" has no `lawhash` frame"])),
          None ->
            if len(d.test_bodies) != len(d.tests) {
              Err(bytes_concat_all([num(len(d.test_bodies)), b" testbody frames beside ", num(len(d.tests)), b" tests"]))
            } else { Ok(d) },
        },
    }
  }

fn frame_step(s: Frames, u: Frame) -> Iter<Frames, Result<Dump, Bytes>> =
  if len(u.words) != 2 {
    Stop(Err(bytes_concat_all([b"frame ", num(s.index), b": header `", joined(u.words, b" "),
                               b"` is not `<kind> <name> <length>`"])))
  } else {
    let kind = at(u.words, 0);
    let name = at(u.words, 1);
    if kind == b"diag" {
      if !s.leading {
        Stop(Err(bytes_concat_all([b"frame ", num(s.index), b": a `diag` frame after the diagnostics, which lead the dump"])))
      } else if name != num(len(s.dump.diags)) {
        Stop(Err(bytes_concat_all([b"frame ", num(s.index), b" is numbered ", name, b"; frames are numbered in report order"])))
      } else {
        match read_diag(s.index, u.body) {
          Err(e) -> Stop(Err(e)),
          Ok(g) -> {
            let d: Dump = s.dump;
            Continue({..s, at: u.next, index: s.index + 1, dump: {..d, diags: push(d.diags, g)}})
          },
        }
      }
    } else if s.leading && has_error(s.dump.diags) {
      Stop(Err(b"the dump continues past an error diagnostic, where the front end has no answer"))
    } else {
      match table_frame(s, kind, name, u) { Err(e) -> Stop(Err(e)), Ok(next) -> Continue(next) }
    }
  }

// Whatever the text does not spell exactly is refused: the caller's fallback is to run the front
// end, which is always right, so a wrong answer is the only outcome worth ruling out.
pub fn read_front(text: Bytes) -> Result<Dump, Bytes> =
  iterate({ at: 0, index: 0, leading: true, dump: empty_dump(), named: map_new(),
            tested: map_new(), lawed: map_new() },
          bytes_len(text) + 2,
          |s: Frames|
            if s.at >= bytes_len(text) { Stop(finish(s)) }
            else {
              match unit(text, s.at, b"frame") { Err(e) -> Stop(Err(e)), Ok(u) -> frame_step(s, u) }
            })

// --- Tests ------------------------------------------------------------------

fn program() -> List<Source> =
  [{ name: b"m", src: b"effect log { write emit(Bytes) -> Unit }\ntype Shape = | Dot | Line(Int)\nfn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\ntest \"says\" { say(b\"x\") }" }]

fn holds(dump: String, frame_text: Bytes) -> Bool =
  match bytes_index_of(bytes_of_string(dump), frame_text) { Some(_) -> true, None -> false }

// The index just past `head` in the dump.
fn past(d: Bytes, head: Bytes) -> Int =
  match bytes_index_of(d, head) { Some(i) -> i + bytes_len(head), None -> panic("the dump holds the frame") }

test "a diagnostic ends the dump where diag_dump would" {
  assert_eq(front_dump([{ name: b"m", src: b"fn f() -> Int = \"x\"" }]),
            "diag 0 121\ncode 5\nE0201severity 5\nerrormessage 33\ntype mismatch: function body typelabel 40\n0 16 19 1\nexpected `Int`, found `String`")
}

test "the warnings come first, then the order and the module frame" {
  assert(bytes_starts_with(bytes_of_string(front_dump(program())),
    b"diag 0 98\ncode 5\nW0611severity 7\nwarningmessage 28\ntype `m.Shape` is never usedlabel 20\n0 46 51 1\nnever usedorder _ 10\nmodule 1\nmmodule m 72\nindex 1\n0item 5\nm.logitem 7\nm.Shapeitem 5\nm.Dotitem 6\nm.Lineitem 5\nm.saydef m.say "))
}

fn reachable() -> List<Source> =
  [{ name: b"m", src: b"pub fn api() -> Int = shared()\nfn shared() -> Int = 1\nfn dead() -> Int = deader()\nfn deader() -> Int = 2\nfn tested() -> Int = 3\nfn lawful(x: Int) -> Int = x\nfn positive(x: Int) -> Bool = x > 0\npub fn checked(x: Int) -> Int requires positive(x) = x\ntype Pair = { a: Int }\npub fn make() -> Int = { let f = |x: Int| -> Pair { { a: x } }; f(1).a }\nfn _kept() -> Int = 4\nfn main() -> Int = 5\ntype Unused = | Nothing\ntest \"calls it\" { assert_eq(tested(), 3) }\nlaw \"it is the identity\" forall (x: Int) { lawful(x) == x }" }]

test "only a definition no root reaches is warned, each once" {
  let out = front_dump(reachable());
  assert(holds(out, b"message 25\nfn `m.dead` is never used"));
  assert(holds(out, b"message 27\nfn `m.deader` is never used"));
  assert(holds(out, b"message 29\ntype `m.Unused` is never used"));
  assert(!holds(out, b"diag 3 "));
  assert(holds(out, b"order _ "))
}

test "a definition frames its scheme, footprint and span" {
  assert(holds(front_dump(program()),
    b"def m.say 190\nmodule 1\nmsimple_name 3\nsaypublic 1\n0reuse 1\n0scheme 31\n(Bytes) -> Unit / {m.log.write}footprint 11\nm.log.writeperformed 10\nm.log.emitinternally_effectful 1\n1param 9\nb 0 79 87span 8\n0 72 126"))
}

test "a test is framed by its index and carries its key" {
  assert(holds(front_dump(program()),
    b"test 0 113\nkey 6\nm.saysname 4\nsaysmodule 1\nmindex 1\n0nondet 1\n0footprint 11\nm.log.writespan 9\n0 127 152name_span 9\n0 132 138"))
}

test "an effect frames each operation on its own lines" {
  assert(holds(front_dump(program()),
    b"effect m.log 102\nmodule 1\nmsimple_name 3\nlogpublic 1\n0nondet 1\n0op 36\nemit write 0 1 0 0 13 38\nBytes\nUnit\nspan 6\n0 0 40"))
}

test "a prelude effect is placed outside every module and its operations carry a scheme" {
  assert(holds(front_dump(program()),
    b"effect sim 119\nmodule 0\nsimple_name 3\nsimpublic 1\n1nondet 1\n0op 45\nseed read 0 0 1 4294967295 0 0\nInt\n() -> Int\nspan 14\n4294967295 0 0"))
}

test "a constructor frames its fields and its scheme" {
  assert(holds(front_dump(program()),
    b"ctor m.Line 116\nmodule 1\nmsimple_name 4\nLinetype_name 7\nm.Shapeindex 1\n1arity 1\n1field 3\nIntscheme 16\n(Int) -> m.Shapespan 7\n0 62 71"))
}

test "a hash record carries the definition's hash, its own form and its reach, and the body hashes to it" {
  let d = bytes_of_string(front_dump(program()));
  let def_at = past(d, b"hash m.say 183\ndef 64\n");
  let def_hash = bytes_slice(d, def_at, def_at + 64);
  assert_eq(bytes_slice(d, def_at + 64, def_at + 71), b"own 64\n");
  assert_eq(bytes_slice(d, def_at + 135, def_at + 135 + 52), b"dep 5\nm.logclosure 5\nm.logclosure 5\nm.saytesthash 0 ");
  // A solo body is the kind byte and then exactly the bytes the definition's hash is taken over.
  let body_at = past(d, b"body m.say ");
  let body_end = match bytes_index_of_from(d, b"testbody 0 ", body_at) { Some(i) -> i, None -> panic("the test body follows") };
  let line_end = match bytes_index_of_from(d, b"\n", body_at) { Some(i) -> i, None -> panic("a frame head ends its line") };
  let body = unhex(bytes_slice(d, line_end + 1, body_end));
  assert_eq(bytes_at(body, 0), 0);
  assert_eq(hex(blake3(bytes_slice(body, 1, bytes_len(body)))), def_hash)
}

fn unhex(h: Bytes) -> Bytes = {
  let digit = |c: Int| if c >= 97 { c - 87 } else { c - 48 };
  bytes_concat_all(map(range(0, bytes_len(h) / 2), |i: Int| byte_of(digit(bytes_at(h, 2 * i)) * 16 + digit(bytes_at(h, 2 * i + 1)))))
}

test "the ordinals list every fn, test and law in source order" {
  assert(holds(front_dump(program()), b"ordinal m 34\nitem 8\nfn m.sayitem 11\ntest m.says"))
}

fn specified() -> List<Source> =
  [{ name: b"m", src: b"effect log { write emit(Bytes) -> Unit }\neffect set Io = {log.write}\nfn say(b: Bytes) -> Unit / {Io} = log.emit(b)\nfn inc(x: Int) -> Int requires x > 0 ensures result > x = x + 1\nlaw \"inc grows\" forall (x: Int) where x > 0 { inc(x) > x }" }]

test "a definition frames its row aliases and each clause with its kind, index and span" {
  let out = front_dump(specified());
  assert(holds(out, b"internally_effectful 1\n1row_alias 2\nIoparam 9\nb 0 76 84span 8\n0 69 114"));
  assert(holds(out, b"def m.inc 224\nmodule 1\nmsimple_name 3\nincpublic 1\n0reuse 1\n0scheme 12\n(Int) -> Intfootprint 0\nperformed 0\ninternally_effectful 1\n0param 11\nx 0 122 128spec 21\nrequires 0 \n0 137 151spec 20\nensures 1 \n0 152 170span 9\n0 115 178literal 5\nint 0"));
  assert(holds(out, b"ordinal m 71\nitem 8\nfn m.sayitem 25\nfn m.inc requires,ensuresitem 15\nlaw m.inc grows"))
}

fn written() -> List<Source> =
  [{ name: b"m", src: b"pub type Pair<a, b> = { fst: a, snd: b }\npub effect log { write emit(Bytes) -> Unit }\npub reuse fn keep(xs: List<Int>) -> List<Int> = push(xs, 1)\nlaw \"bounds\" forall (n: Int) where n > -3 && n < 7 { n == n }" }]

test "a definition frames its visibility, its reuse marker and its parameters as written" {
  let out = front_dump(written());
  assert(holds(out, b"simple_name 4\nkeeppublic 1\n1reuse 1\n1scheme "));
  assert(holds(out, b"internally_effectful 1\n0param 12\nxs 0 104 117span"))
}

test "a type frames its arity and its visibility" {
  assert(holds(front_dump(written()), b"module 1\nmsimple_name 4\nPairpublic 1\n1arity 1\n2span "))
}

test "a guard's literals are framed in the search's order, a negation folded" {
  assert(holds(front_dump(written()), b"literal 5\nint 7literal 6\nint -3literal 5\nint 3"))
}

test "a law frames its binders with their spans and types, and its hashes carry the sentence" {
  let out = front_dump(specified());
  assert(holds(out, b"law 0 142\nkey 11\nm.inc growsname 9\ninc growsmodule 1\nmindex 1\n0binder 15\nx 0 203 209\nInthas_guard 1\n1host 1\n0footprint 0\nspan 9\n0 179 237literal 5\nint 0"));
  // An `effect set` with no includes, hence the two spaces.
  assert(holds(out, b"effect_set 15\nIo  m.log.write"));
  let d = bytes_of_string(out);
  let hash_at = past(d, b"lawhash 0 210\nkey 11\nm.inc growshash 64\n");
  assert_eq(bytes_slice(d, hash_at + 64, hash_at + 72), b"text 64\n");
  assert_eq(bytes_slice(d, hash_at + 136, hash_at + 136 + 48), b"dep 5\nm.incclosure 5\nm.incclosure 11\nm.inc grows");
  // Two clauses: two obligation keys and two sentence keys, in source order.
  let spec_at = past(d, b"hash m.inc 455\ndef 64\n");
  assert_eq(bytes_slice(d, spec_at + 64, spec_at + 71), b"own 64\n");
  assert_eq(bytes_slice(d, spec_at + 135, spec_at + 143), b"spec 64\n");
  assert_eq(bytes_slice(d, spec_at + 207, spec_at + 215), b"spec 64\n");
  assert_eq(bytes_slice(d, spec_at + 279, spec_at + 292), b"spec_text 64\n")
}

fn claimed() -> List<Source> =
  [{ name: b"base", src: b"pub fn one() -> Int = 1\npub type Coin = | Heads | Tails" },
   { name: b"app", src: b"import base\nfn two(x: Int) -> Option<Int> requires x > 0 = Some(base::one() + len([x]))\nlaw \"it grows\" forall (x: Int) where x > 0 { two(x) != None }" }]

test "a claim is lowered with each global named program-wide, and a builtin and a prelude constructor as written" {
  let out = claims_dump(claimed());
  assert(holds(out, b"def base.one 25\nparams 1\n0body 8\nblit(i1)sum base.Coin 12\nvariants 1\n2def app.two 152\nparams 1\n1"));
  assert(holds(out, b"body 87\nbapp(bvar(Some,-),bbin(add,bapp(bvar(base.one,-)),bapp(bvar(len,-),blist(ovar(x,0),))))requires 35\n1 51 56\nbbin(gt,ovar(x,0),blit(i0))"));
  assert(holds(out, b"key 12\napp.it growsguard "));
  assert(holds(out, b"bbin(ne,bapp(bvar(app.two,-),ovar(x,0)),bvar(None,-))"))
}

test "a record update reaches a claim as the literal it stands for" {
  let out = claims_dump([{ name: b"m", src: b"pub type P = { a: Int, b: Int }\npub fn bump(p: P) -> P = {..p, b: 3}" }]);
  assert(holds(out, b"upd("))
}

fn shelf() -> List<Source> =
  [{ name: b"std.a", src: b"import std.c\npub fn a() -> Int = 1" }, { name: b"std.b", src: b"pub fn b() -> Int = 2" },
   { name: b"std.c", src: b"pub fn c() -> Int = 3" }, { name: b"std.d", src: b"pub fn d() -> Int = 4" }]

test "the shipped modules a program imports follow it a round at a time, each round in byte order" {
  let out = front_pulling_std([{ name: b"m", src: b"import std.b\nimport std.a\npub fn f() -> Int = 1" }], shelf());
  assert(bytes_starts_with(bytes_of_string(out), b"pulled _ 42\nmodule 5\nstd.amodule 5\nstd.bmodule 5\nstd.corder _ "))
}

test "an import of a module that does not ship is reported at the import, listing the ones that do" {
  assert_eq(front_pulling_std([{ name: b"m", src: b"import std.e\npub fn f() -> Int = 1" }], shelf()),
            "pulled _ 0\ndiag 0 245\ncode 5\nE0106severity 5\nerrormessage 48\nno module named `std.e` ships with this compilerlabel 18\n0 7 12 1\nnot foundnote 52\nthe stdlib holds: `std.a`, `std.b`, `std.c`, `std.d`note 63\n`ply std` lists them with the digest this binary was built from")
}

fn compiler_shelf() -> List<Source> =
  [{ name: b"compiler.a", src: b"import compiler.b (second)\npub fn first() -> Int = second()" },
   { name: b"compiler.b", src: b"pub fn second() -> Int = 1" }]

test "a compiler module the shelf carries is pulled in under the shelf's root" {
  let out = front_pulling_std([{ name: b"m", src: b"import compiler.a (first)\npub fn f() -> Int = first()" }],
                              compiler_shelf());
  assert(bytes_starts_with(bytes_of_string(out), b"pulled _ 40\nmodule 10\ncompiler.amodule 10\ncompiler.border _ "));
  assert(holds(out, b"def compiler.a.first "))
}

test "a shelved module importing outside the shelf is the compiler's own defect" {
  let out = front_pulling_std([{ name: b"m", src: b"import compiler.a (first)\npub fn f() -> Int = first()" }],
                              [{ name: b"compiler.a", src: b"import std.e (e)\npub fn first() -> Int = e()" }]);
  assert(holds(out, b"the shipped module `compiler.a` imports `std.e`, which this build does not ship"))
}

test "a shipped module importing outside the shipped ones is placed in that module, which the answer names" {
  let out = front_pulling_std([{ name: b"m", src: b"import std.x\npub fn f() -> Int = 1" }],
                              [{ name: b"std.x", src: b"import m\npub fn x() -> Int = 1" }]);
  assert(bytes_starts_with(bytes_of_string(out), b"pulled _ 14\nmodule 5\nstd.xdiag 0 "));
  assert(holds(out, b"message 70\nthe shipped module `std.x` imports `m`, which this build does not shiplabel 65\n1 7 8 1\na stdlib module may import only modules that ship with it"))
}

// --- Reading an answer back ---------------------------------------------------

fn dumped(sources: List<Source>) -> Bytes = bytes_of_string(front_dump(sources))

fn mentions(b: Bytes, needle: Bytes) -> Bool =
  match bytes_index_of(b, needle) { Some(_) -> true, None -> false }

// A replacement of the same length, so every frame around it keeps its own.
fn swapped(d: Bytes, from: Bytes, to: Bytes) -> Bytes =
  match bytes_index_of(d, from) {
    Some(i) -> bytes_concat_all([bytes_slice(d, 0, i), to, bytes_slice(d, i + bytes_len(from), bytes_len(d))]),
    None -> panic("the dump holds the text"),
  }

fn refusal(d: Bytes) -> Bytes =
  match read_front(d) { Err(e) -> e, Ok(_) -> panic("the reader was meant to refuse this dump") }

fn at_order(d: Bytes) -> Int =
  match bytes_index_of(d, b"order _ ") { Some(i) -> i, None -> panic("the dump holds the order frame") }

test "the reader answers exactly the rows the writer framed" {
  assert_eq(read_front(dumped(program())), Ok(dump_of(analyse(parse_all(program())))));
  assert_eq(read_front(dumped(specified())), Ok(dump_of(analyse(parse_all(specified())))));
  assert_eq(read_front(dumped(written())), Ok(dump_of(analyse(parse_all(written())))));
  assert_eq(read_front(dumped(reachable())), Ok(dump_of(analyse(parse_all(reachable())))))
}

test "an answer that is an error reads back as the diagnostics it is" {
  let bad = [{ name: b"m", src: b"fn f() -> Int = \"x\"" }];
  assert_eq(read_front(dumped(bad)), Ok(dump_of(analyse(parse_all(bad)))))
}

test "bytes after the last frame are refused rather than passed over" {
  assert(bytes_starts_with(refusal(bytes_concat(dumped(program()), b"and then some")),
                           b"frame header at byte "))
}

test "a frame cut short is refused" {
  let d = dumped(program());
  assert(mentions(refusal(bytes_slice(d, 0, bytes_len(d) - 3)), b"is truncated"))
}

test "a frame kind this reader does not know is refused" {
  assert(mentions(refusal(swapped(dumped(program()), b"def m.say ", b"dxf m.say ")),
                  b"unknown frame kind `dxf`"))
}

// The grammar is the only version this format has: a field a later writer added is refused here.
test "a field this reader does not know is refused" {
  assert(mentions(refusal(swapped(dumped(program()), b"nondet 1\n0", b"nondxt 1\n0")),
                  b"unknown field `nondxt`"))
}

test "a flag that is neither 0 nor 1 is refused" {
  assert(mentions(refusal(swapped(dumped(program()), b"reuse 1\n0", b"reuse 1\n2")), b"not 0 or 1"))
}

test "a hash frame for an item that was never declared is refused" {
  assert(mentions(refusal(swapped(dumped(program()), b"testhash 0 ", b"testhash 1 ")),
                  b"and only 1 were declared"))
}

test "a dump that ends after diagnostics, none of which is an error, is refused" {
  let d = dumped(program());
  assert_eq(refusal(bytes_slice(d, 0, at_order(d))),
            b"the dump ends after the diagnostics, none of which is an error")
}

test "a table after an error diagnostic is refused" {
  let d = dumped(program());
  let bad = dumped([{ name: b"m", src: b"fn f() -> Int = \"x\"" }]);
  assert_eq(refusal(bytes_concat(bad, bytes_slice(d, at_order(d), bytes_len(d)))),
            b"the dump continues past an error diagnostic, where the front end has no answer")
}

type Rows = { defs: List<KnownDefRow>, tests: List<KnownTestRow> }

// What the driver files after a run, built the way it builds it: each published row under the hash
// the definition or test had.
fn rows_of(sources: List<Source>) -> Rows =
  match analyse(parse_all(sources)) {
    Refused(_) -> panic("the program checks"),
    Analysed(w) -> {
      let hashed = by_name_one(w.hashes.defs);
      { defs: map(w.checked.defs, |d: DefInfo|
          { name: d.name, hash: match map_get(hashed, d.name) { Some(x) -> x, None -> b"" },
            footprint: atoms_text(d.footprint, b","), performed: atoms_text(d.performed, b",") }),
        tests: map(range(0, len(w.checked.tests)), |i: Int| {
          let t: TestInfo = at(w.checked.tests, i);
          { key: t.key, hash: at(w.hashes.tests, i), footprint: atoms_text(t.footprint, b",") }
        }) }
    },
  }

fn effectful() -> List<Source> =
  [{ name: b"base", src: b"pub effect log { write emit(Bytes) -> Unit }\npub fn say(b: Bytes) -> Unit / { log.write } = log.emit(b)" },
   { name: b"app", src: b"import base\nfn twice(b: Bytes) -> Unit = base::say(b)\ntest \"says\" { twice(b\"x\") }" }]

test "a definition whose hash has not moved is published from its rows, not from its body" {
  let rows = rows_of(effectful());
  assert(len(rows.defs) > 0);
  assert(len(rows.tests) > 0);
  assert_eq(dump_of(analyse_with(parse_all(effectful()), rows.defs, rows.tests)),
            dump_of(analyse(parse_all(effectful()))))
}

test "rows filed under a hash this program no longer has are walked instead" {
  let rows = rows_of(effectful());
  let stale = map(rows.defs, |r: KnownDefRow| {..r, hash: b"moved", footprint: b"nowhere.read", performed: b"nowhere.read"});
  assert_eq(dump_of(analyse_with(parse_all(effectful()), stale, [])),
            dump_of(analyse(parse_all(effectful()))))
}

