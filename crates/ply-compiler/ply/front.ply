    },
  ]

test "a definition frames its visibility, its reuse marker and its parameters as written" {
  let out = front_dump(written());
  assert(holds(out, b"simple_name 4\nkeeppublic 1\n1reuse 1\n1scheme "));
  assert(holds(out, b"internally_effectful 1\n0param 12\nxs 0 104 117span"))
