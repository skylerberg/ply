fn joined(xs: List<Bytes>, sep: Bytes) -> Bytes / {abort.raise} =
  fold(range(0, len(xs)), b"", |acc: Bytes, i: Int|
    if i == 0 { at(xs, i) } else { bytes_concat_all([acc, sep, at(xs, i)]) })

fn mode_text(m: Mode) -> Bytes = match m { MRead -> b"read", MWrite -> b"write", MBad -> b"" }

fn kind_text(k: SpecKind) -> Bytes = match k { SRequires -> b"requires", SEnsures -> b"ensures" }

// The module index of a span outside every module; a `(0, 0)` span is `dummy_span`.
fn no_module() -> Int = 4294967295

fn span_at(module: Int, s: Span) -> At =
  {
    module: if s.start == 0 && s.end == 0 { no_module() } else { module },
    start: s.start,
    end: s.end,
  }

fn loc_at(l: Loc) -> At = span_at(l.module, l.span)

// --- What the source wrote ----------------------------------------------------
// What the driver reads from the tree that the checker's tables do not keep.

fn vis_public(v: Vis) -> Bool = match v { VPub -> true, VPriv -> false }

type Written = { public: Bool, reuse: Bool, params: List<Param>, literals: List<Bytes> }

fn no_written() -> Written = { public: false, reuse: false, params: [], literals: [] }

fn fn_written(mods: List<Mod>) -> Map<Bytes, Written> / {abort.raise} =
  fold(mods, map_new(), |acc: Map<Bytes, Written>, m: Mod|
    fold(m.module.items, acc, |a: Map<Bytes, Written>, it: Item|
      match it {
        IFn(d) ->
          map_insert(a, qualify(m.name, d.name.name), {
            public: vis_public(d.vis),
            reuse: match d.reuse { Some(_) -> true, None -> false },
            params: d.params,
            literals: fold(d.spec, [], |lits: List<Bytes>, c: SpecClause|
              match c.kind { SRequires -> collect_lits([c.expr], lits), SEnsures -> lits }),
          }),
        _ -> a,
      }))

fn written_of(m: Map<Bytes, Written>, name: Bytes) -> Written =
  match map_get(m, name) { Some(w) -> w, None -> no_written() }

fn effect_written(mods: List<Mod>) -> Map<Bytes, Bool> =
  fold(mods, map_new(), |acc: Map<Bytes, Bool>, m: Mod|
    fold(m.module.items, acc, |a: Map<Bytes, Bool>, it: Item|
      match it {
        IEffect(d) -> map_insert(a, qualify(m.name, d.name.name), vis_public(d.vis)),
        _ -> a,
      }))

// A prelude effect has no source entry and is public.
fn effect_public_of(m: Map<Bytes, Bool>, e: EffectInfo) -> Bool =
  match map_get(m, e.name) { Some(b) -> b, None -> true }

// No table of the checker's holds a `type` declaration, so it is read from the tree.
fn type_rows(mods: List<Mod>) -> List<TypeRow> / {abort.raise} =
  fold(range(0, len(mods)), [], |acc: List<TypeRow>, i: Int| {
    let m = at(mods, i);
    fold(m.module.items, acc, |a: List<TypeRow>, it: Item|
      match it {
        IType(d) ->
          push(a, {
            name: qualify(m.name, d.name.name),
            module: m.name,
            simple_name: d.name.name,
            public: vis_public(d.vis),
            arity: len(d.params),
            at: span_at(i, d.span),
          }),
        _ -> a,
      })
  })

fn test_name_spans(mods: List<Mod>) -> List<Loc> / {abort.raise} =
  fold(range(0, len(mods)), [], |acc: List<Loc>, i: Int| {
    let m = at(mods, i);
    fold(m.module.items, acc, |a: List<Loc>, it: Item|
      match it { ITest(d) -> push(a, { module: i, span: d.name_span }), _ -> a })
  })

// --- A guard's literals -------------------------------------------------------
// The order seeds the prover's witness search, so it is the stack walk's first-reached order, not sorted.

fn keep(acc: List<Bytes>, x: Bytes) -> List<Bytes> =
  if contains_bytes(acc, x) { acc } else { push(acc, x) }

fn int_lit(k: Int) -> Bytes = bytes_concat(b"int ", num(k))

fn lit_text(acc: List<Bytes>, l: Lit) -> List<Bytes> / {abort.raise} =
  match l {
    LInt(k) -> keep(acc, int_lit(k)),
    LStr(s) -> keep(acc, bytes_concat(b"str ", s)),
    LBytes(b) -> keep(acc, bytes_concat(b"bytes ", hex(b))),
    _ -> acc,
  }

// A negated literal is kept negated, as the guard means it; the walk still reaches the literal itself.
fn neg_lit(acc: List<Bytes>, e: Expr) -> List<Bytes> =
  match e { ELit(v) -> match v.lit { LInt(k) -> keep(acc, int_lit(0 - k)), _ -> acc }, _ -> acc }

type Walk = { stack: List<Expr>, acc: List<Bytes> }

fn arm_exprs(s: List<Expr>, arm: MatchArm) -> List<Expr> =
  push(match arm.guard { Some(g) -> push(s, g), None -> s }, arm.body)

fn stmt_exprs(s: List<Expr>, st: Stmt) -> List<Expr> =
  match st {
    SLet(x) -> push(s, x.value),
    SLetElse(x) -> push(push(s, x.value), x.fallback),
    SExpr(x) -> push(s, x),
  }

fn field_exprs(s: List<Expr>, f: RecField) -> List<Expr> = push(s, f.value)

fn collect_lits(stack: List<Expr>, acc: List<Bytes>) -> List<Bytes> / {abort.raise} =
  if len(stack) == 0 { acc } else {
    let e = at(stack, len(stack) - 1);
    let rest = take(stack, len(stack) - 1);
    let step: Walk = match e {
      ELit(v) -> { stack: rest, acc: lit_text(acc, v.lit) },
      EVar(_) -> { stack: rest, acc: acc },
      EBad(_) -> { stack: rest, acc: acc },
      EBinary(v) -> { stack: push(push(rest, v.lhs), v.rhs), acc: acc },
      EUnary(v) ->
        {
          stack: push(rest, v.operand),
          acc: if v.op == b"neg" { neg_lit(acc, v.operand) } else { acc },
        },
      ELambda(v) -> { stack: push(rest, v.body), acc: acc },
      EApp(v) -> { stack: append(push(rest, v.func), v.args), acc: acc },
      EIf(v) -> { stack: push(push(push(rest, v.cond), v.then_branch), v.else_branch), acc: acc },
      EMatch(v) -> { stack: fold(v.arms, push(rest, v.scrutinee), arm_exprs), acc: acc },
      EBlock(v) ->
        {
          stack: match v.tail {
            Some(t) -> push(fold(v.stmts, rest, stmt_exprs), t),
            None -> fold(v.stmts, rest, stmt_exprs),
          },
          acc: acc,
        },
      ERecord(v) -> { stack: fold(v.fields, rest, field_exprs), acc: acc },
      ERecordUpdate(v) -> { stack: fold(v.fields, push(rest, v.base), field_exprs), acc: acc },
      EField(v) -> { stack: push(rest, v.base), acc: acc },
      ETry(v) -> { stack: push(rest, v.operand), acc: acc },
      EList(v) -> { stack: append(rest, v.items), acc: acc },
      EPerform(v) -> { stack: append(rest, v.args), acc: acc },
      EHandle(v) -> { stack: push(rest, v.body), acc: acc },
      EWithCell(v) -> { stack: push(push(rest, v.init), v.body), acc: acc },
      ESimulate(v) -> { stack: push(rest, v.body), acc: acc },
      EParallel(v) -> { stack: append(rest, v.branches), acc: acc },
    };
    collect_lits(step.stack, step.acc)
  }

// The literals these guards are written with, one guard at a time, as `<int|str|bytes> <value>`:
// where a guard's domain is, which a witness search tries first.
pub fn literals_of(guards: List<Expr>) -> List<Bytes> / {abort.raise} =
  fold(guards, [], |acc: List<Bytes>, g: Expr| collect_lits([g], acc))

fn law_literals(mods: List<Mod>) -> List<List<Bytes>> / {abort.raise} =
  fold(mods, [], |acc: List<List<Bytes>>, m: Mod|
    fold(m.module.items, acc, |a: List<List<Bytes>>, it: Item|
      match it {
        ILaw(d) -> push(a, match d.guard { Some(g) -> collect_lits([g], []), None -> [] }),
        _ -> a,
      }))

// --- A module's effect sets ---------------------------------------------------
// An atom whose effect resolves to nothing is dropped; a bare `cell` resolves to itself.

fn has_effect(effects: List<EffectInfo>, name: Bytes) -> Bool =
  fold(effects, false, |acc: Bool, e: EffectInfo| acc || e.name == name)

fn bare_prelude(q: QName) -> Option<Bytes> =
  if is_bare(q) && is_prelude_effect(q.name.name) { Some(q.name.name) } else { None }

fn set_effect(
  r: Resolved,
  effects: List<EffectInfo>,
  module: Int,
  q: QName,
) -> Option<Bytes> / {abort.raise} =
  if is_bare(q) && q.name.name == b"cell" { Some(b"cell") } else {
    let found = if is_bare(q) { lookup(at(r.scopes, module).bound, NEffect, q.name.name) }
    else { find(r, module, NEffect, q) };
    match found {
      Some(b) -> if has_effect(effects, b.qualified) { Some(b.qualified) } else { bare_prelude(q) },
      None -> bare_prelude(q),
    }
  }

fn set_atoms(
  r: Resolved,
  effects: List<EffectInfo>,
  module: Int,
  xs: List<AtomExpr>,
) -> List<Atom> / {abort.raise} =
  fold(xs, [], |acc: List<Atom>, a: AtomExpr|
    match set_effect(r, effects, module, a.eff) {
      Some(eff) ->
        atoms_insert(acc, {
          effect: eff,
          resource: match a.resource { Some(x) -> RNamed(x.name), None -> RSingleton },
          mode: a.mode,
          op: match a.op { Some(x) -> Some(x.name), None -> None },
        }),
      None -> acc,
    })

// One `effect set` of a module: the simple name a row writes, the sets it includes in source
// order, and the expansion as program-wide atoms.
pub type SetView = { name: Bytes, includes: List<Bytes>, atoms: List<Atom> }

// --- Module names -------------------------------------------------------------
// A module is a file: `store/orders.ply` is `store.orders`, relative to the project root. The
// rule lives here rather than with the walk that reads a project, because the front end is what
// names a module to everything downstream of it.

fn start_ok(c: Int) -> Bool = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95

fn continue_ok(c: Int) -> Bool = start_ok(c) || (c >= 48 && c <= 57)

fn ident_ok(segment: String) -> Bool / {abort.raise} = {
  let b = bytes_of_string(segment);
  if bytes_len(b) == 0 { false } else {
    start_ok(bytes_at(b, 0))
      && fold(range(1, bytes_len(b)), true, |ok: Bool, i: Int| ok && continue_ok(bytes_at(b, i)))
  }
}

fn drop_extension(path: String) -> String / {abort.raise} =
  if string_ends_with(path, ".ply") { string_slice(path, 0, string_len(path) - 4) } else { path }

fn dotted(segments: List<String>) -> String =
  fold(range(0, len(segments)), "", |acc: String, i: Int|
    match list_at(segments, i) { Some(s) -> if i == 0 { s } else { acc ++ "." ++ s }, None -> acc })

// The first segment that is not an identifier, which is what a refusal names.
fn bad_segment(segments: List<String>) -> Option<String> / {abort.raise} =
  fold(segments, None, |acc: Option<String>, s: String|
    match acc { Some(_) -> acc, None -> if ident_ok(s) { None } else { Some(s) } })

pub fn module_of(path: String) -> Result<String, String> / {abort.raise} = {
  let segments = string_split(drop_extension(path), "/");
  match bad_segment(segments) {
    Some(s) -> Err("`" ++ s ++ "` is not an identifier"),
    None -> if len(segments) == 0 { Err("it has no name") } else { Ok(dotted(segments)) },
  }
}

pub fn effect_sets_of(
  r: Resolved,
  effects: List<EffectInfo>,
  module: Int,
  m: Mod,
) -> List<SetView> / {abort.raise} =
  fold(m.module.items, [], |acc: List<SetView>, it: Item|
    match it {
      IEffectSet(d) ->
        push(acc, {
          name: d.name.name,
          includes: map(d.includes, |q: QName| q.name.name),
          atoms: set_atoms(r, effects, module, d.expansion),
        }),
      _ -> acc,
    })

// --- The rows the answer holds -----------------------------------------------
// Each type, scheme and footprint numbered as its text names its variables, so two answers about
// one program are equal values however the checker numbered them.

// Program-wide names of everything a module declares, in source order.
pub fn module_items(m: Mod) -> List<Bytes> =
  fold(m.module.items, [], |acc: List<Bytes>, it: Item|
    match it {
      IFn(d) -> push(acc, qualify(m.name, d.name.name)),
      IType(d) -> {
        let named = push(acc, qualify(m.name, d.name.name));
        match d.body {
          TDSum(vs) ->
            fold(vs, named, |a: List<Bytes>, v: VariantDef| push(a, qualify(m.name, v.name.name))),
          _ -> named,
        }
      },
      IEffect(d) -> push(acc, qualify(m.name, d.name.name)),
      _ -> acc,
    })

// The modules a module imports, each named once, in source order.
pub fn module_imports(m: Mod) -> List<Bytes> / {abort.raise} =
  fold(m.module.imports, [], |acc: List<Bytes>, d: ImportDecl| {
    let name = joined(map(d.path, |x: Ident| x.name), b".");
    if fold(acc, false, |b: Bool, x: Bytes| b || x == name) { acc } else { push(acc, name) }
  })

// `imports` names each module this one imports as the program names it, which a dependency's bare
// sibling import does not.
fn module_row(
  i: Int,
  m: Mod,
  r: Resolved,
  effects: List<EffectInfo>,
  names: List<Bytes>,
) -> ModuleRow / {abort.raise} = {
  let items = module_items(m);
  let imports = fold(at(r.imports, i), [], |acc: List<Bytes>, t: Int| {
    let name = at(names, t);
    if fold(acc, false, |b: Bool, x: Bytes| b || x == name) { acc } else { push(acc, name) }
  });
  let sets = effect_sets_of(r, effects, i, m);
  { name: m.name, index: i, items: items, imports: imports, sets: sets, cuts: cuts_of(m) }
}

// --- Stubs ------------------------------------------------------------------
// A module with its bodies blanked, every byte of a cut but a newline a space, so every offset
// holds: what a compiled package ships, and what the emitter reads of a module it does not lower.

// A braced cut keeps `{` and `}` at its ends: an empty block over exactly the body's own span.
pub type Cut = { start: Int, end: Int, braced: Bool }

// Walked even when seeded (rows cannot carry a row tail or a label), or `transparent`, which another
// package's proofs unfold: its body stays in the stub.
fn kept(d: FnDef) -> Bool =
  len(d.generics.effects) > 0 || len(d.generics.labels) > 0
    || (match d.transparent { Some(_) -> true, None -> false })

// A generated definition carries its `derive` item's span, and the item regenerates it.
pub fn cuts_of(m: Mod) -> List<Cut> = {
  let generated = fold(m.derived, map_new(), |acc: Map<Bytes, Bool>, d: Derived|
    map_insert(acc, span_key(d.span), true));
  fold(m.module.items, [], |acc: List<Cut>, it: Item|
    match it {
      IFn(d) -> if map_contains(generated, span_key(d.span)) || kept(d) { acc } else {
        let b = expr_span(d.body);
        if b.end - b.start < 2 { acc }
        else { push(acc, { start: b.start, end: b.end, braced: true }) }
      },
      ITest(d) -> push(acc, { start: d.span.start, end: d.span.end, braced: false }),
      ILaw(d) -> push(acc, { start: d.span.start, end: d.span.end, braced: false }),
      _ -> acc,
    })
}

fn def_row(d: DefInfo, w: Written) -> DefRow / {abort.raise} =
  {
    name: d.name,
    module: d.module,
    simple_name: d.simple_name,
    public: w.public,
    reuse: w.reuse,
    scheme: canonical_scheme(d.scheme),
    footprint: canonical_atoms(d.footprint),
    performed: canonical_atoms(d.performed),
    constraints: d.constraints,
    row_aliases: d.row_aliases,
    params: map(w.params, |p: Param| { name: p.name.name, at: span_at(d.at.module, p.span) }),
    spec: map(d.spec, |s: SpecInfo|
      {
        kind: kind_text(s.kind),
        index: s.index,
        footprint: canonical_atoms(s.footprint),
        at: span_at(d.at.module, s.span),
      }),
    at: loc_at(d.at),
    literals: w.literals,
  }

fn test_row(t: TestInfo, name_at: Loc) -> TestRow / {abort.raise} =
  {
    key: t.key,
    name: t.name,
    module: t.module,
    index: t.index,
    nondet: t.nondet,
    footprint: canonical_atoms(t.footprint),
    at: loc_at(t.at),
    name_at: loc_at(name_at),
  }

fn law_row(l: LawInfo, lits: List<Bytes>) -> LawRow / {abort.raise} =
  {
    key: l.key,
    name: l.name,
    module: l.module,
    index: l.index,
    binders: map(l.binders, |b: LawBinder|
      { name: b.name, at: span_at(l.at.module, b.span), ty: canonical_type(b.ty) }),
    has_guard: l.has_guard,
    host: l.host,
    cost: l.cost,
    footprint: canonical_atoms(l.footprint),
    at: loc_at(l.at),
    literals: lits,
  }

fn op_row(module: Int, o: OpInfo, cr: Carrier) -> OpRow / {abort.raise} =
  {
    name: o.name,
    mode: mode_text(o.mode),
    resource_param: o.resource_param,
    params: map(o.params, canonical_type),
    ret: canonical_type(o.ret),
    scheme: match o.scheme { Some(sc) -> Some(canonical_scheme(sc)), None -> None },
    at: span_at(module, o.at.span),
    carries: map(carries(cr, [], o.params), grounded),
  }

fn effect_row(e: EffectInfo, public: Bool, cr: Carrier) -> EffectRow / {abort.raise} =
  {
    name: e.name,
    module: e.module,
    simple_name: e.simple_name,
    public: public,
    nondet: e.nondet,
    ops: map(e.ops, |o: OpInfo| op_row(e.at.module, o, cr)),
    at: loc_at(e.at),
  }

fn ctor_row(k: CtorInfo) -> CtorRow / {abort.raise} =
  {
    name: k.name,
    module: k.module,
    simple_name: k.simple_name,
    type_name: k.type_name,
    index: k.index,
    arity: k.arity,
    fields: map(k.fields, canonical_type),
    scheme: canonical_scheme(k.scheme),
    at: loc_at(k.at),
  }

// --- The hashes ---------------------------------------------------------------
// A name declared twice (a `fn` and an `effect` alike) is one row, as the maps merged it.

fn by_name_one(xs: List<{ name: Bytes, hash: Bytes }>) -> Map<Bytes, Bytes> =
  fold(xs, map_new(), |acc: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
    map_insert(acc, x.name, x.hash))

fn by_name_many(xs: List<{ name: Bytes, hashes: List<Bytes> }>) -> Map<Bytes, List<Bytes>> =
  fold(xs, map_new(), |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, hashes: List<Bytes> }|
    map_insert(acc, x.name, x.hashes))

fn by_name_names(xs: List<{ name: Bytes, names: List<Bytes> }>) -> Map<Bytes, List<Bytes>> =
  fold(xs, map_new(), |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, names: List<Bytes> }|
    map_insert(acc, x.name, x.names))

// A closure is a set kept as a map, so its names come back in byte order.
fn by_name_closure(xs: List<{ name: Bytes, names: Map<Bytes, Bool> }>) -> Map<Bytes, List<Bytes>> =
  fold(xs, map_new(), |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, names: Map<Bytes, Bool> }|
    map_insert(
      acc,
      x.name,
      map_fold(x.names, [], |ns: List<Bytes>, k: Bytes, v: Bool| push(ns, k)),
    ))

type Tables = {
  defs: Map<Bytes, Bytes>,
  own: Map<Bytes, Bytes>,
  decls: Map<Bytes, Bytes>,
  specs: Map<Bytes, List<Bytes>>,
  spec_texts: Map<Bytes, List<Bytes>>,
  deps: Map<Bytes, List<Bytes>>,
  closure: Map<Bytes, List<Bytes>>,
}

fn hash_tables(h: HashOutput) -> Tables =
  {
    defs: by_name_one(h.defs),
    own: by_name_one(h.own),
    decls: by_name_one(h.decls),
    specs: by_name_many(h.specs),
    spec_texts: by_name_many(h.spec_texts),
    deps: by_name_names(h.deps),
    closure: by_name_closure(h.closure),
  }

fn hex_one(m: Map<Bytes, Bytes>, name: Bytes) -> Option<Bytes> / {abort.raise} =
  match map_get(m, name) { Some(h) -> Some(hex(h)), None -> None }

fn hex_many(m: Map<Bytes, List<Bytes>>, name: Bytes) -> List<Bytes> / {abort.raise} =
  match map_get(m, name) { Some(hs) -> map(hs, hex), None -> [] }

fn names_of(m: Map<Bytes, List<Bytes>>, name: Bytes) -> List<Bytes> =
  match map_get(m, name) { Some(ns) -> ns, None -> [] }

fn def_hash_row(t: Tables, name: Bytes) -> HashRow / {abort.raise} =
  {
    name: name,
    def: hex_one(t.defs, name),
    own: hex_one(t.own, name),
    decl: hex_one(t.decls, name),
    specs: hex_many(t.specs, name),
    spec_texts: hex_many(t.spec_texts, name),
    deps: names_of(t.deps, name),
    closure: names_of(t.closure, name),
  }

fn hash_rows(index: Index, h: HashOutput) -> List<HashFrame> / {abort.raise} = {
  let t = hash_tables(h);
  let walked = fold(
    index.order,
    { seen: map_new(), frames: [] },
    |acc: { seen: Map<Bytes, Bool>, frames: List<HashFrame> }, e: Entry|
      match e {
        EDef(v) -> {
          let name = at(index.nodes, v).name;
          match map_get(acc.seen, name) {
            Some(_) -> acc,
            None ->
              {
                seen: map_insert(acc.seen, name, true),
                frames: push(acc.frames, HDef(def_hash_row(t, name))),
              },
          }
        },
        ETest(i) -> {
          let key = at(index.tests, i).key;
          {
            ..acc,
            frames: push(
              acc.frames,
              HTest({
                index: i,
                key: key,
                hash: hex(at(h.tests, i)),
                text: b"",
                deps: names_of(t.deps, key),
                closure: names_of(t.closure, key),
              }),
            ),
          }
        },
        ELaw(i) -> {
          let key = at(index.laws, i).key;
          {
            ..acc,
            frames: push(
              acc.frames,
              HLaw({
                index: i,
                key: key,
                hash: hex(at(h.laws, i)),
                text: hex(at(h.law_texts, i)),
                deps: names_of(t.deps, key),
                closure: names_of(t.closure, key),
              }),
            ),
          }
        },
      },
  );
  walked.frames
}

// A `fn` also names its clauses' kinds in order, so each clause's root can be keyed.
// --- The emitter's root keys -------------------------------------------------

// One root the emitter caches a compiled body under, and the key it caches it by: a digest of
// what emitting it reads of the rest of the program. `crates/ply-codegen`'s `Source` reads these.
pub type KeyRow = { root: Bytes, key: Bytes }

// The walk's place: the rows so far, this module's test and law ordinals, and which law text the
// next law is keyed by.
type Keying = { out: List<KeyRow>, ordinal: Int, law_ordinal: Int, law_at: Int }

// What emitting a definition reads of it: its parameter and answer types printed with one printer,
// and whether it is pure, so a nullary call can come from the constant table.
fn key_published(d: DefInfo) -> Bytes / {abort.raise} = {
  let (params, ret) = match d.scheme.ty { TyFn(f) -> (f.params, f.ret), other -> ([], other) };
  let printed = fold(
    params,
    { p: printer_new(), texts: [] },
    |acc: { p: Printer, texts: List<Bytes> }, t: Type| {
      let out = print_ty(acc.p, t);
      { p: out.p, texts: push(acc.texts, out.s) }
    },
  );
  let pure = if published_pure(d) { b"true" } else { b"false" };
  bytes_concat_all([
    b"(",
    joined(printed.texts, b", "),
    b") -> ",
    print_ty(printed.p, ret).s,
    b" ",
    pure,
  ])
}

fn key_clause_root(owner: Bytes, kind: Bytes, k: Int) -> Bytes =
  bytes_concat_all([owner, b"#", kind, b"#", num(k)])

fn key_law_root(n: Int, part: Bytes) -> Bytes = bytes_concat_all([b"law#", num(n), b".", part])

fn key_test_root(n: Int) -> Bytes = bytes_concat(b"test#", num(n))

// A digest of what emitting the root hashed under `key` reads of the rest of the program: the
// signature of `owner` (the root, or a clause's definition), the signature of every definition it
// references, and every `type` or `effect` declaration it mentions, sorted by name.
fn key_reads(
  published: Map<Bytes, Bytes>,
  deps: Map<Bytes, List<Bytes>>,
  decls: Map<Bytes, Bytes>,
  key: Bytes,
  owner: Option<Bytes>,
) -> Bytes / {abort.raise} = {
  let owner_text = match owner {
    Some(o) -> match map_get(published, o) { Some(text) -> text, None -> b"" },
    None -> b"",
  };
  let names = match map_get(deps, key) {
    Some(ns) -> map_keys(map_of_entries(map(ns, |n: Bytes| { key: n, value: () }))),
    None -> [],
  };
  let each = map(names, |name: Bytes| {
    let text = match map_get(published, name) { Some(t) -> t, None -> b"" };
    let decl = match map_get(decls, name) { Some(h) -> h, None -> b"" };
    bytes_concat_all([name, b"\x00", text, decl, b"\x00"])
  });
  bytes_slice(hex(blake3(bytes_concat_all(append([owner_text, b"\x00"], each)))), 0, 32)
}

// One `fn`'s clause keys, then its own.
fn key_fn(
  published: Map<Bytes, Bytes>,
  own: Map<Bytes, Bytes>,
  sentences: Map<Bytes, List<Bytes>>,
  deps: Map<Bytes, List<Bytes>>,
  decls: Map<Bytes, Bytes>,
  a: Keying,
  name: Bytes,
  spec: List<SpecClause>,
) -> Keying / {abort.raise} =
  match map_get(own, name) {
    None -> a,
    Some(owner) -> {
      let read = key_reads(published, deps, decls, name, Some(name));
      let sents = match map_get(sentences, name) { Some(s) -> s, None -> [] };
      let clauses = fold(
        range(0, len(spec)),
        { out: a.out, requires: 0, ensures: 0 },
        |b: { out: List<KeyRow>, requires: Int, ensures: Int }, i: Int| {
          let kind = at(spec, i).kind;
          let text = match kind { SRequires -> b"requires", SEnsures -> b"ensures" };
          let k = if kind == SRequires { b.requires } else { b.ensures };
          let sentence = match list_at(sents, i) { Some(s) -> s, None -> owner };
          {
            out: push(b.out, {
              root: key_clause_root(name, text, k),
              key: bytes_concat_all([hex(sentence), b"#", text, b"#", num(k), b"+", read]),
            }),
            requires: if kind == SRequires { b.requires + 1 } else { b.requires },
            ensures: if kind == SEnsures { b.ensures + 1 } else { b.ensures },
          }
        },
      );
      {
        ..a,
        out: push(clauses.out, { root: name, key: bytes_concat_all([hex(owner), b"+", read]) }),
      }
    },
  }

fn root_keys(mods: List<Mod>, c: Front, h: HashOutput) -> List<KeyRow> / {abort.raise} = {
  let own = by_name_one(h.own);
  let sentences = by_name_many(h.spec_texts);
  let deps = by_name_names(h.deps);
  let decls = by_name_one(h.decls);
  // Each signature printed once: a root reads many definitions, and many roots read one.
  let published = map_of_entries(
    map(c.defs, |d: DefInfo| { key: d.name, value: key_published(d) }),
  );
  let laws = c.laws;
  let law_texts = h.law_texts;
  fold(mods, { out: [], ordinal: 0, law_ordinal: 0, law_at: 0 }, |acc: Keying, m: Mod| {
    let walked = fold(
      m.module.items,
      { out: acc.out, ordinal: 0, law_ordinal: 0, law_at: acc.law_at },
      |a: Keying, it: Item|
        match it {
          IFn(d) ->
            key_fn(published, own, sentences, deps, decls, a, qualify(m.name, d.name.name), d.spec),
          ITest(d) -> {
            let name = qualify(m.name, d.name);
            let read = key_reads(published, deps, decls, name, None);
            {
              ..a,
              ordinal: a.ordinal + 1,
              out: push(a.out, {
                root: qualify(m.name, key_test_root(a.ordinal)),
                key: bytes_concat(b"test+", read),
              }),
            }
          },
          ILaw(d) -> {
            let name = qualify(m.name, d.name);
            let keyed = match list_at(law_texts, a.law_at) {
              None -> a,
              Some(text) -> {
                let read = key_reads(published, deps, decls, name, None);
                let guarded = match list_at(laws, a.law_at) {
                  Some(l) -> l.has_guard,
                  None -> false,
                };
                fold(
                  if guarded { [b"guard", b"body"] } else { [b"body"] },
                  a,
                  |b: Keying, part: Bytes| {
                    let row = {
                      root: qualify(m.name, key_law_root(a.law_ordinal, part)),
                      key: bytes_concat_all([hex(text), b"#", part, b"+", read]),
                    };
                    { ..b, out: push(b.out, row) }
                  },
                )
              },
            };
            { ..keyed, law_ordinal: a.law_ordinal + 1, law_at: a.law_at + 1 }
          },
          _ -> a,
        },
    );
    { out: walked.out, ordinal: 0, law_ordinal: 0, law_at: walked.law_at }
  }).out
}

// --- The emitter's roots -----------------------------------------------------

// One root the emitter offers: a definition, a spec clause, a test or a law part, with the arity
// its body is emitted at. `pure` is a definition's published purity, which lets a memo answer for
// it; any other root runs each time. `params` and `answer` say how what it is entered with and
// answers read at the seam. `witnesses` are the type variables whose witnesses lead `params`, which
// an entry from outside fills from what its arguments show of each.
pub type EmitRoot = {
  root: Bytes,
  arity: Int,
  pure: Bool,
  at: At,
  params: List<Carry>,
  answer: Carry,
  witnesses: List<Int>,
}

// The span of a root the tables do not place: a test or law whose check output has no row.
fn no_at() -> At = { module: no_module(), start: 0, end: 0 }

/// One constructor, with its arity and how its fields read over its type's parameters; the
/// emitter orders tags by position here.
type EmitCtor = { name: Bytes, arity: Int, fields: List<Carry> }

// The walk's per-module place and its running place; `ordinal` counts tests, `law_ordinal` laws.
type EmitTables = { fns: List<EmitRoot>, tests: List<EmitRoot>, specs: List<EmitRoot> }
type EmitWalk = {
  fns: List<EmitRoot>,
  tests: List<EmitRoot>,
  specs: List<EmitRoot>,
  ordinal: Int,
  law_ordinal: Int,
}

// The prelude's constructors, then each module's in program order: the order the emitted C
// names tags by, which is not `CheckOutput::ctors`' dependency order.
fn emit_ctors_of(mods: List<Mod>, c: Front, cr: Carrier) -> List<EmitCtor> / {abort.raise} = {
  let prelude = filter(c.ctors, |k: CtorInfo| bytes_len(k.module) == 0);
  let rest = fold(mods, [], |acc: List<CtorInfo>, m: Mod|
    append(acc, filter(c.ctors, |k: CtorInfo| k.module == m.name)));
  map(append(prelude, rest), |k: CtorInfo|
    { name: k.name, arity: k.arity, fields: carries(cr, k.scheme.ty_vars, k.fields) })
}

// --- How a value reads at the compiled seam ------------------------------------

// Compiled code holds a width below 64 bits as a tagged `Int`, so only a value's type tells a `U8`
// from an `Int`; every other word says what it is. A carry is that type, cut to what decides a
// reading: `CPlain` where no width can sit, `CSum` a sum type at its parameters, whose
// constructor's fields read as its declaration types them, and `CVar` a type variable of the
// scheme around it, or a parameter of the declaration, by number. A function's words are never
// read, but a function the prover generated shows what its variables are.
pub type Carry =
  | CPlain
  | CWidth(Int)
  | CList(Carry)
  | CMap(Carry, Carry)
  | CRecord(List<CarriedField>)
  | CSum(List<Carry>)
  | CFn(List<Carry>, Carry)
  | CVar(Int)

pub type CarriedField = { name: Bytes, carry: Carry }

// A fixed width by the runtime's numbering, `ply_eval::INT_TYPES`.
fn width_number(name: Bytes) -> Option<Int> =
  if name == b"U8" { Some(0) }
  else if name == b"U16" { Some(1) }
  else if name == b"U32" { Some(2) }
  else if name == b"U64" { Some(3) }
  else if name == b"I8" { Some(4) }
  else if name == b"I16" { Some(5) }
  else if name == b"I32" { Some(6) }
  else if name == b"I64" { Some(7) }
  else if name == b"U128" { Some(8) }
  else if name == b"I128" { Some(9) }
  else { None }

// Each sum type, and whether it holds a width whatever its parameters are.
type Carrier = { sums: Map<Bytes, Bool> }

fn carrier_of(ctors: List<CtorInfo>) -> Carrier = {
  let held = holding_widths(ctors, []);
  {
    sums: map_of_entries(
      map(ctors, |k: CtorInfo| { key: k.type_name, value: contains_bytes(held, k.type_name) }),
    ),
  }
}

// Grown to a fixpoint: a type may hold a width through itself or through another type.
fn holding_widths(ctors: List<CtorInfo>, held: List<Bytes>) -> List<Bytes> = {
  let grown = fold(ctors, held, |acc: List<Bytes>, k: CtorInfo|
    if contains_bytes(acc, k.type_name) { acc }
    else if fold(k.fields, false, |b: Bool, t: Type| b || reaches_width(t, acc)) {
      push(acc, k.type_name)
    } else { acc });
  if len(grown) == len(held) { held } else { holding_widths(ctors, grown) }
}

// A function is a closure's word, which no reading looks inside.
fn reaches_width(t: Type, held: List<Bytes>) -> Bool =
  match t {
    TyVar(_) -> false,
    TyCon(c) ->
      width_number(c.name) != None || contains_bytes(held, c.name)
        || fold(c.args, false, |b: Bool, a: Type| b || reaches_width(a, held)),
    TyFn(_) -> false,
    TyRecord(fs) -> fold(fs, false, |b: Bool, f: Field| b || reaches_width(f.ty, held)),
  }

fn is_plain(c: Carry) -> Bool = match c { CPlain -> true, _ -> false }

// `t`'s carry, each type variable numbered by its place in `vars`, and one not there past them.
fn carry(cr: Carrier, vars: List<Int>, t: Type) -> Carry / {abort.raise} =
  match t {
    TyVar(v) -> CVar(var_number(vars, v)),
    TyCon(c) -> match width_number(c.name) {
      Some(n) -> CWidth(n),
      None -> {
        let args = carries(cr, vars, c.args);
        let plain = fold(args, true, |b: Bool, a: Carry| b && is_plain(a));
        if (c.name == b"List" || c.name == b"Array") && len(args) == 1 {
          if plain { CPlain } else { CList(at(args, 0)) }
        } else if c.name == b"Map" && len(args) == 2 {
          if plain { CPlain } else { CMap(at(args, 0), at(args, 1)) }
        } else {
          match map_get(cr.sums, c.name) {
            Some(holds) -> if holds || !plain { CSum(args) } else { CPlain },
            None -> CPlain,
          }
        }
      },
    },
    TyFn(f) -> {
      let params = carries(cr, vars, f.params);
      let ret = carry(cr, vars, f.ret);
      if is_plain(ret) && fold(params, true, |b: Bool, p: Carry| b && is_plain(p)) { CPlain }
      else { CFn(params, ret) }
    },
    TyRecord(fs) -> {
      let fields = map(fs, |f: Field| { name: f.name, carry: carry(cr, vars, f.ty) });
      if fold(fields, true, |b: Bool, f: CarriedField| b && is_plain(f.carry)) { CPlain }
      else { CRecord(fields) }
    },
  }

fn carries(cr: Carrier, vars: List<Int>, ts: List<Type>) -> List<Carry> / {abort.raise} =
  map(ts, |t: Type| carry(cr, vars, t))

// An operation's type variable is fixed where it is performed, which its host never sees: a value
// there reads as it is, and the host takes it by its own contract.
fn grounded(c: Carry) -> Carry =
  match c {
    CVar(_) -> CPlain,
    CList(x) -> {
      let g = grounded(x);
      if is_plain(g) { CPlain } else { CList(g) }
    },
    CMap(k, v) -> {
      let gk = grounded(k);
      let gv = grounded(v);
      if is_plain(gk) && is_plain(gv) { CPlain } else { CMap(gk, gv) }
    },
    CRecord(fs) -> {
      let gs = map(fs, |f: CarriedField| { name: f.name, carry: grounded(f.carry) });
      if fold(gs, true, |b: Bool, f: CarriedField| b && is_plain(f.carry)) { CPlain }
      else { CRecord(gs) }
    },
    CSum(ps) -> CSum(map(ps, grounded)),
    CFn(ps, r) -> {
      let gs = map(ps, grounded);
      let gr = grounded(r);
      if is_plain(gr) && fold(gs, true, |b: Bool, p: Carry| b && is_plain(p)) { CPlain }
      else { CFn(gs, gr) }
    },
    other -> other,
  }

fn var_number(vars: List<Int>, v: Int) -> Int / {abort.raise} =
  fold(range(0, len(vars)), len(vars) + v, |acc: Int, i: Int|
    if acc >= len(vars) && at(vars, i) == v { i } else { acc })

// The type variables `ts` name, in the order they first appear.
fn vars_in(ts: List<Type>) -> List<Int> = fold(ts, [], vars_of)

fn vars_of(seen: List<Int>, t: Type) -> List<Int> =
  match t {
    TyVar(v) -> if contains_int(seen, v) { seen } else { push(seen, v) },
    TyCon(c) -> fold(c.args, seen, vars_of),
    TyFn(f) -> vars_of(fold(f.params, seen, vars_of), f.ret),
    TyRecord(fs) -> fold(fs, seen, |acc: List<Int>, f: Field| vars_of(acc, f.ty)),
  }

fn emit_signature(t: Type) -> { params: List<Type>, ret: Type } =
  match t { TyFn(f) -> { params: f.params, ret: f.ret }, other -> { params: [], ret: other } }

// Every root is built here, so what the seam reads of it comes from the types it carries. `vars`
// numbers the type variables those types share.
fn emit_root(
  cr: Carrier,
  vars: List<Int>,
  witnesses: List<Int>,
  root: Bytes,
  params: List<Type>,
  answer: Type,
  labels: Int,
  pure: Bool,
  place: At,
) -> EmitRoot / {abort.raise} = {
  let taken = append(map(witnesses, |w: Int| t_int()), params);
  {
    root: root,
    arity: len(taken) + labels,
    pure: pure,
    at: place,
    params: carries(cr, vars, taken),
    answer: carry(cr, vars, answer),
    witnesses: witnesses,
  }
}

fn emit_proposition(
  cr: Carrier,
  vars: List<Int>,
  witnesses: List<Int>,
  root: Bytes,
  params: List<Type>,
  place: At,
) -> EmitRoot / {abort.raise} =
  emit_root(cr, vars, witnesses, root, params, t_bool(), 0, false, place)

// The type variables a definition's `numeric` and `integer` constraints are about, by its scheme's
// numbering and in its order: the witnesses it takes ahead of its parameters, as its clauses do.
fn witness_vars(def: DefInfo) -> List<Int> =
  fold(def.constraints, [], |acc: List<Int>, c: DefConstraint|
    if !is_predicate(c.deriver) || contains_int(acc, c.param) { acc } else { push(acc, c.param) })

// Every root the emitter offers: the functions in source order, then the tests, then the spec
// clauses and law parts. A label parameter is a trailing `Word` of the emitted body, so an
// arity counts it.
fn emit_roots(mods: List<Mod>, c: Front, cr: Carrier) -> List<EmitRoot> / {abort.raise} = {
  let defs = map_of_entries(map(c.defs, |d: DefInfo| { key: d.name, value: d }));
  let laws = map_of_entries(map(c.laws, |l: LawInfo| { key: l.key, value: l }));
  let tests = map_of_entries(map(c.tests, |t: TestInfo| { key: t.key, value: t }));
  let walked = fold(mods, { fns: [], tests: [], specs: [] }, |acc: EmitTables, m: Mod| {
    let items = fold(
      m.module.items,
      { fns: [], tests: [], specs: [], ordinal: 0, law_ordinal: 0 },
      |a: EmitWalk, it: Item|
        match it {
          IFn(d) -> {
            let name = qualify(m.name, d.name.name);
            match map_get(defs, name) {
              None -> a,
              Some(def) -> {
                let sig = emit_signature(def.scheme.ty);
                let vars = def.scheme.ty_vars;
                let witnesses = witness_vars(def);
                let place = span_at(def.at.module, def.at.span);
                let fn_row = emit_root(
                  cr,
                  vars,
                  witnesses,
                  name,
                  sig.params,
                  sig.ret,
                  len(def.scheme.label_vars),
                  published_pure(def),
                  place,
                );
                let clauses = fold(
                  range(0, len(d.spec)),
                  { rows: [], requires: 0, ensures: 0 },
                  |b: { rows: List<EmitRoot>, requires: Int, ensures: Int }, i: Int| {
                    match at(d.spec, i).kind {
                      SRequires -> {
                        let root = key_clause_root(name, b"requires", b.requires);
                        let row = emit_proposition(cr, vars, witnesses, root, sig.params, place);
                        { rows: push(b.rows, row), requires: b.requires + 1, ensures: b.ensures }
                      },
                      // `ensures` also takes `result`.
                      SEnsures -> {
                        let root = key_clause_root(name, b"ensures", b.ensures);
                        let row = emit_proposition(
                          cr,
                          vars,
                          witnesses,
                          root,
                          push(sig.params, sig.ret),
                          place,
                        );
                        { rows: push(b.rows, row), requires: b.requires, ensures: b.ensures + 1 }
                      },
                    }
                  },
                );
                { ..a, fns: push(a.fns, fn_row), specs: append(a.specs, clauses.rows) }
              },
            }
          },
          ITest(d) -> {
            let place = match map_get(tests, qualify(m.name, d.name)) {
              Some(t) -> span_at(t.at.module, t.at.span),
              None -> no_at(),
            };
            let root = qualify(m.name, key_test_root(a.ordinal));
            let row = emit_root(cr, [], [], root, [], t_unit(), 0, false, place);
            { ..a, tests: push(a.tests, row), ordinal: a.ordinal + 1 }
          },
          ILaw(d) -> {
            let name = qualify(m.name, d.name);
            let law = map_get(laws, name);
            let guarded = match law { Some(l) -> l.has_guard, None -> false };
            let measured = match law { Some(l) -> l.cost, None -> false };
            let binders = match law { Some(l) -> map(l.binders, |b: LawBinder| b.ty), None -> [] };
            let vars = vars_in(binders);
            let place = match law { Some(l) -> span_at(l.at.module, l.at.span), None -> no_at() };
            let rows = map(if guarded { [b"guard", b"body"] } else { [b"body"] }, |part: Bytes| {
              let root = qualify(m.name, key_law_root(a.law_ordinal, part));
              if measured && part == b"body" {
                emit_root(cr, vars, [], root, binders, measure_ty(), 0, false, place)
              } else { emit_proposition(cr, vars, [], root, binders, place) }
            });
            { ..a, specs: append(a.specs, rows), law_ordinal: a.law_ordinal + 1 }
          },
          _ -> a,
        },
    );
    {
      fns: append(acc.fns, items.fns),
      tests: append(acc.tests, items.tests),
      specs: append(acc.specs, items.specs),
    }
  });
  append(append(walked.fns, walked.tests), walked.specs)
}

fn ordinal_row(m: Mod) -> OrdinalRow / {abort.raise} =
  {
    module: m.name,
    items: fold(m.module.items, [], |acc: List<Bytes>, it: Item|
      match it {
        IFn(d) -> {
          let kinds = if len(d.spec) == 0 { b"" }
          else { bytes_concat(b" ", joined(map(d.spec, |c: SpecClause| kind_text(c.kind)), b",")) };
          push(acc, bytes_concat_all([b"fn ", qualify(m.name, d.name.name), kinds]))
        },
        ITest(d) -> push(acc, bytes_concat(b"test ", qualify(m.name, d.name))),
        ILaw(d) -> push(acc, bytes_concat(b"law ", qualify(m.name, d.name))),
        _ -> acc,
      }),
  }

fn tables(
  warnings: List<Diag>,
  mods: List<Mod>,
  r: Resolved,
  c: Front,
  index: Index,
  h: HashOutput,
  packages: List<Pkg>,
  pins: List<Pinned>,
  mod_pkg: List<Int>,
  embeds: List<EmbedAt>,
) -> Dump / {abort.raise} = {
  let fns = fn_written(mods);
  let effs = effect_written(mods);
  let names = test_name_spans(mods);
  let lits = law_literals(mods);
  let cr = carrier_of(c.ctors);
  let mod_names = map(mods, |m: Mod| m.name);
  {
    diags: map(warnings, answered_diag),
    order: map(r.order, |i: Int| at(mods, i).name),
    packages: packages,
    pins: pins,
    mod_pkg: mod_pkg,
    modules: map(range(0, len(mods)), |i: Int| module_row(i, at(mods, i), r, c.effects, mod_names)),
    defs: map(c.defs, |d: DefInfo| def_row(d, written_of(fns, d.name))),
    types: type_rows(mods),
    tests: map(range(0, len(c.tests)), |i: Int| test_row(at(c.tests, i), at(names, i))),
    laws: map(range(0, len(c.laws)), |i: Int| law_row(at(c.laws, i), at(lits, i))),
    effects: map(c.effects, |e: EffectInfo| effect_row(e, effect_public_of(effs, e), cr)),
    ctors: map(c.ctors, ctor_row),
    hashes: hash_rows(index, h),
    hashes_digest: digest(h),
    keys: root_keys(mods, c, h),
    emit_roots: emit_roots(mods, c, cr),
    emit_ctors: emit_ctors_of(mods, c, cr),
    ordinals: map(mods, ordinal_row),
    bodies: h.bodies,
    test_bodies: h.test_bodies,
    embeds: embeds,
    rows: rows_from(c, h),
    walked: bin::encode(walked_of(mods, c), walked_bin()),
  }
}

// Every table the front end holds for a program that checks, for a caller that wants them rather
// than their framing: `ply defs`, `ply hash` and `ply doc` are written against this.
pub type Whole = {
  mods: List<Mod>,
  r: Resolved,
  checked: Front,
  index: Index,
  hashes: HashOutput,
  warnings: List<Diag>,
  // The project's `ply.pkg`, decoded; `None` is the anonymous package.
  manifest: Option<Manifest>,
  // The closure's packages and each module's package, so the emitter and the claims lowerer
  // resolve imports the way the front end did.
  packages: List<Pkg>,
  // What each dependency is, as `ply.lock` pins it.
  pins: List<Pinned>,
  mod_pkg: List<Int>,
  // The modules a compiled package's stubs stand for: their bodies are blanks.
  stubs: List<Bytes>,
  // What each module embeds, for every pass that parses its text again.
  embeds: List<EmbedAt>,
}

// A stage that reports stops the rest, so a refusal is the diagnostics of exactly one stage.
pub type Analysis = | Refused(List<Diag>) | Analysed(Whole)

// A definition's or a test's published rows as the last answer wrote them, under the hash it had
// then: the checker takes them wherever this program hashes that item the same, and walks the rest.
// A row's atoms name their effects, which a hash does not pin — a reference is encoded by the hash
// of what it reaches, so renaming an effect moves nothing. `witness` is the name and hash each of
// those declarations had, and a row whose witness no longer holds is not a row about this program.
pub type Witness = { name: Bytes, hash: Bytes }
pub type KnownDefRow = {
  name: Bytes,
  hash: Bytes,
  witness: List<Witness>,
  footprint: Bytes,
  performed: Bytes,
  scaling: Bytes,
  repeats: List<Int>,
}
pub type KnownTestRow = { key: Bytes, hash: Bytes, witness: List<Witness>, footprint: Bytes }

fn still_hashed(now: Map<Bytes, Bytes>, name: Bytes, was: Bytes) -> Bool =
  match map_get(now, name) { Some(h) -> h == was, None -> false }

fn witnessed(decls: Map<Bytes, Bytes>, witness: List<Witness>) -> Bool =
  fold(witness, true, |acc: Bool, w: Witness| acc && still_hashed(decls, w.name, w.hash))

fn known_defs(
  now: Map<Bytes, Bytes>,
  decls: Map<Bytes, Bytes>,
  rows: List<KnownDefRow>,
) -> Map<Bytes, KnownDef> / {abort.raise} =
  fold(rows, map_new(), |acc: Map<Bytes, KnownDef>, r: KnownDefRow|
    if !still_hashed(now, r.name, r.hash) || !witnessed(decls, r.witness) { acc } else {
      match ((read_atoms(r.footprint), read_atoms(r.performed), read_atoms(r.scaling))) {
        (Some(footprint), Some(performed), Some(scaling)) ->
          map_insert(acc, r.name, {
            footprint: footprint,
            performed: performed,
            scaling: scaling,
            repeats: r.repeats,
          }),
        _ -> acc,
      }
    })

// Every test's hash this run, by the key `<module>.<label>` a row names it under.
fn test_hashes(index: Index, h: HashOutput) -> Map<Bytes, Bytes> / {abort.raise} =
  fold(range(0, len(index.tests)), map_new(), |acc: Map<Bytes, Bytes>, i: Int|
    map_insert(acc, at(index.tests, i).key, at(h.tests, i)))

// One slot per `test` of each module, in source order, as `check_tests` walks them. A test's row
// names its effects exactly as a definition's does, so it is witnessed exactly as one.
fn known_tests(
  now: Map<Bytes, Bytes>,
  decls: Map<Bytes, Bytes>,
  mods: List<Mod>,
  rows: List<KnownTestRow>,
) -> Map<Bytes, List<Option<List<Atom>>>> / {abort.raise} = {
  let by_key = fold(rows, map_new(), |acc: Map<Bytes, KnownTestRow>, r: KnownTestRow|
    map_insert(acc, r.key, r));
  fold(mods, map_new(), |acc: Map<Bytes, List<Option<List<Atom>>>>, m: Mod|
    map_insert(
      acc,
      m.name,
      fold(m.module.items, [], |slots: List<Option<List<Atom>>>, it: Item|
        match it {
          ITest(d) ->
            push(slots, match map_get(by_key, qualify(m.name, d.name)) {
              None -> None,
              Some(r) -> if still_hashed(now, r.key, r.hash) && witnessed(decls, r.witness) {
                read_atoms(r.footprint)
              } else { None },
            }),
          _ -> slots,
        }),
    ))
}

fn taken(
  mods: List<Mod>,
  index: Index,
  h: HashOutput,
  defs: List<KnownDefRow>,
  tests: List<KnownTestRow>,
  root: Int,
) -> Known / {abort.raise} =
  if len(defs) == 0 && len(tests) == 0 { { ..no_known(), root: root } } else {
    {
      defs: known_defs(by_name_one(h.checks), by_name_one(h.decls), defs),
      tests: known_tests(test_hashes(index, h), by_name_one(h.decls), mods, tests),
      root: root,
    }
  }

// --- What the front-end cache files ----------------------------------------------
// The CLI files these after an analysis and hands the rows back to the next one. The store keeps
// them without reading them: a slot under its hash and name, a file's entries under its path. What
// a slot holds beyond the row is what `ply cache inspect` prints.

// Each effect a row names, under the hash its declaration has. A prelude effect is declared by no
// source, so it has no entry and no edit can rename it.
fn row_witness(decls: Map<Bytes, Bytes>, atoms: List<Atom>) -> List<Witness> =
  map_fold(
    fold(atoms, map_new(), |acc: Map<Bytes, Bytes>, a: Atom|
      match map_get(decls, a.effect) { Some(h) -> map_insert(acc, a.effect, h), None -> acc }),
    [],
    |acc: List<Witness>, name: Bytes, hash: Bytes| push(acc, { name: name, hash: hash }),
  )

fn def_known_row(decls: Map<Bytes, Bytes>, d: DefInfo, hash: Bytes) -> KnownDefRow / {abort.raise} =
  {
    name: d.name,
    hash: hash,
    witness: row_witness(decls, append(d.footprint, d.performed)),
    footprint: atoms_text(d.footprint, b","),
    performed: atoms_text(d.performed, b","),
    scaling: atoms_text(d.scaling, b","),
    repeats: d.repeats,
  }

fn test_known_row(
  decls: Map<Bytes, Bytes>,
  t: TestInfo,
  hash: Bytes,
) -> KnownTestRow / {abort.raise} =
  {
    key: t.key,
    hash: hash,
    witness: row_witness(decls, t.footprint),
    footprint: atoms_text(t.footprint, b","),
  }

pub type Rows = { defs: List<KnownDefRow>, tests: List<KnownTestRow> }

pub fn no_rows() -> Rows = { defs: [], tests: [] }

// What an analysis publishes, as the rows the next one is handed, each under the hash it has now.
pub fn rows_of(w: Whole) -> Rows / {abort.raise} = rows_from(w.checked, w.hashes)

// The modules the checker walked whole, by name, and what it read of every body it walked, its
// module indices into `modules`.
pub type Walked = { modules: List<Bytes>, whole: List<Bytes>, facts: EmitFacts }

derive bin for Walked

fn walked_of(mods: List<Mod>, c: Front) -> Walked = {
  let named = |xs: List<Bytes>|
    fold(xs, map_new(), |acc: Map<Bytes, Bool>, n: Bytes| map_insert(acc, n, true));
  let seeded = named(c.seeded);
  let seeded_tests = named(c.seeded_tests);
  let whole = |m: Mod|
    fold(m.module.items, true, |acc: Bool, it: Item|
      acc
        && (match it {
          IFn(d) -> !map_contains(seeded, qualify(m.name, d.name.name)),
          ITest(d) -> !map_contains(seeded_tests, qualify(m.name, d.name)),
          _ -> true,
        }));
  {
    modules: map(mods, |m: Mod| m.name),
    whole: fold(mods, [], |acc: List<Bytes>, m: Mod|
      if whole(m) { push(acc, m.name) } else { acc }),
    facts: c.facts,
  }
}

fn rows_from(c: Front, h: HashOutput) -> Rows / {abort.raise} = {
  let hashed = by_name_one(h.checks);
  let decls = by_name_one(h.decls);
  {
    defs: fold(c.defs, [], |acc: List<KnownDefRow>, d: DefInfo|
      match map_get(hashed, d.name) {
        Some(x) -> push(acc, def_known_row(decls, d, x)),
        None -> acc,
      }),
    tests: map(range(0, len(c.tests)), |i: Int|
      test_known_row(decls, at(c.tests, i), at(h.tests, i))),
  }
}

// The rows a compiled package carries: each definition's counts as its row writes them, which is
// how any other package reads it, so the interface re-derives the same wherever it is cut.
pub fn contracted_rows_of(w: Whole) -> List<KnownDefRow> / {abort.raise} = {
  let infos = fold(w.checked.defs, map_new(), |acc: Map<Bytes, DefInfo>, d: DefInfo|
    map_insert(acc, d.name, d));
  map(rows_of(w).defs, |r: KnownDefRow|
    match map_get(infos, r.name) {
      Some(d) -> {
        let c = written_counts(d.scheme.ty, d.footprint, d.bounded, d.tail_bounded);
        { ..r, scaling: atoms_text(c.scaling, b","), repeats: c.repeats }
      },
      None -> r,
    })
}

pub type FiledSpan = { start: Int, end: Int }

pub type DefInterface = { row: KnownDefRow, scheme: Bytes }

pub type FiledVariant = { name: Bytes, fields: List<Bytes> }

pub type FiledOp = { name: Bytes, mode: Bytes, resource: Bool, params: List<Bytes>, ret: Bytes }

// A `type` has its parameter count and variants, an `effect` its operations and whether it is
// `nondet`.
pub type DeclInterface = {
  effect: Bool,
  arity: Int,
  nondet: Bool,
  variants: List<FiledVariant>,
  ops: List<FiledOp>,
}

// What the store keeps of a definition, a declaration and a test, in the encoding it keeps them in.
derive bin for Witness
derive bin for KnownDefRow
derive bin for KnownTestRow
derive bin for DefInterface
derive bin for FiledVariant
derive bin for FiledOp
derive bin for DeclInterface

pub type FiledDef = { name: Bytes, hash: Bytes, interface: DefInterface }

pub type FiledDecl = { name: Bytes, hash: Bytes, interface: DeclInterface }

pub type FiledMember = { name: Bytes, span: FiledSpan }

// `kind` is `fn`, `type` or `effect`: a name declared in two namespaces has an entry in each.
// `check` is what a `fn`'s interface is filed under; a declaration's is its hash.
pub type FiledEntry = {
  name: Bytes,
  hash: Bytes,
  check: Bytes,
  kind: Bytes,
  span: FiledSpan,
  members: List<FiledMember>,
}

pub type FiledTest = { name: Bytes, hash: Bytes, nondet: Bool, span: FiledSpan, row: KnownTestRow }

// `source` is the module's index among the analysis's modules, and so its file's among the places.
pub type FiledModule = {
  name: Bytes,
  source: Int,
  entries: List<FiledEntry>,
  tests: List<FiledTest>,
}

pub type FiledBody = { hash: Bytes, body: Bytes }

pub type Filing = {
  modules: List<FiledModule>,
  defs: List<FiledDef>,
  decls: List<FiledDecl>,
  bodies: List<FiledBody>,
}

fn filed_span(s: Span) -> FiledSpan = { start: s.start, end: s.end }

// A type's constructors in declaration order, which is each one's index.
fn ctors_of_type(ctors: List<CtorInfo>, name: Bytes) -> List<CtorInfo> = {
  let mine = filter(ctors, |k: CtorInfo| k.type_name == name);
  fold(range(0, len(mine)), [], |acc: List<CtorInfo>, i: Int|
    fold(mine, acc, |a: List<CtorInfo>, k: CtorInfo| if k.index == i { push(a, k) } else { a }))
}

fn filed_op(o: OpInfo) -> FiledOp / {abort.raise} =
  {
    name: o.name,
    mode: mode_text(o.mode),
    resource: o.resource_param,
    params: map(o.params, type_text),
    ret: type_text(o.ret),
  }

type Filers = {
  defs: Map<Bytes, DefInfo>,
  types: Map<Bytes, TypeRow>,
  effects: Map<Bytes, EffectInfo>,
  ctors: List<CtorInfo>,
  hashed: Map<Bytes, Bytes>,
  checked: Map<Bytes, Bytes>,
  decls: Map<Bytes, Bytes>,
}

fn fn_entries(f: Filers, name: Bytes) -> List<FiledEntry> =
  match map_get(f.defs, name) {
    None -> [],
    Some(d) -> match map_get(f.hashed, name) {
      None -> [],
      Some(h) -> match map_get(f.checked, name) {
        None -> [],
        Some(k) ->
          [
            {
              name: name,
              hash: h,
              check: k,
              kind: b"fn",
              span: filed_span(d.at.span),
              members: [],
            },
          ],
      },
    },
  }

fn decl_entries(f: Filers, name: Bytes) -> List<FiledEntry> =
  match map_get(f.decls, name) {
    None -> [],
    Some(h) -> match map_get(f.types, name) {
      Some(t) ->
        [
          {
            name: name,
            hash: h,
            check: h,
            kind: b"type",
            span: { start: t.at.start, end: t.at.end },
            members: map(ctors_of_type(f.ctors, name), |k: CtorInfo|
              { name: k.simple_name, span: filed_span(k.at.span) }),
          },
        ],
      None -> match map_get(f.effects, name) {
        None -> [],
        Some(e) ->
          [
            {
              name: name,
              hash: h,
              check: h,
              kind: b"effect",
              span: filed_span(e.at.span),
              members: map(e.ops, |o: OpInfo| { name: o.name, span: filed_span(o.at.span) }),
            },
          ],
      },
    },
  }

// What a module declares, in source order, each name once.
fn module_entries(f: Filers, m: Mod) -> List<FiledEntry> = {
  let walked = fold(
    module_items(m),
    { seen: map_new(), out: [] },
    |acc: { seen: Map<Bytes, Bool>, out: List<FiledEntry> }, name: Bytes|
      if map_contains(acc.seen, name) { acc } else {
        {
          seen: map_insert(acc.seen, name, true),
          out: append(append(acc.out, fn_entries(f, name)), decl_entries(f, name)),
        }
      },
  );
  walked.out
}

fn tests_by_module(
  tests: List<TestInfo>,
  hashes: List<Bytes>,
  decls: Map<Bytes, Bytes>,
) -> Map<Bytes, List<FiledTest>> / {abort.raise} =
  fold(range(0, len(tests)), map_new(), |acc: Map<Bytes, List<FiledTest>>, i: Int| {
    let t = at(tests, i);
    let h = at(hashes, i);
    let filed = {
      name: t.name,
      hash: h,
      nondet: t.nondet,
      span: filed_span(t.at.span),
      row: test_known_row(decls, t, h),
    };
    map_insert(
      acc,
      t.module,
      push(match map_get(acc, t.module) { Some(xs) -> xs, None -> [] }, filed),
    )
  })

// The encoding a body's bytes are written in beneath their envelope; a body filed under another is
// not read back.
pub fn body_encoding() -> Int = 7

// The hash a stored body is filed under, which its envelope fixes: a definition alone in its
// component is its bytes' hash, and a cycle's member the hash of the cycle's with its class.
pub fn body_key(body: Bytes) -> Option<Bytes> / {abort.raise} = {
  let n = bytes_len(body);
  let tag = if n == 0 { -1 } else { bytes_at(body, 0) };
  if tag == 0 { Some(blake3(bytes_slice(body, 1, n))) } else if tag == 1 && n >= 5 {
    Some(blake3(bytes_concat(blake3(bytes_slice(body, 5, n)), bytes_slice(body, 1, 5))))
  } else { None }
}

fn listed(h: Option<Bytes>) -> List<Bytes> = match h { Some(x) -> [x], None -> [] }

// A name's one body answers for each hash the name has; a `fn` and a declaration sharing a name
// have a body each, and each is filed under the hash it verifies as.
fn filed_bodies(h: HashOutput) -> List<FiledBody> / {abort.raise} = {
  let defs = by_name_one(h.defs);
  let decls = by_name_one(h.decls);
  let counted = fold(
    h.bodies,
    map_new(),
    |acc: Map<Bytes, Int>, b: { name: Bytes, body: Bytes }|
      map_insert(acc, b.name, match map_get(acc, b.name) { Some(n) -> n + 1, None -> 1 }),
  );
  fold(h.bodies, [], |acc: List<FiledBody>, b: { name: Bytes, body: Bytes }| {
    let alone = match map_get(counted, b.name) { Some(n) -> n == 1, None -> false };
    fold(
      append(listed(map_get(defs, b.name)), listed(map_get(decls, b.name))),
      acc,
      |a: List<FiledBody>, hash: Bytes|
        if alone || body_key(b.body) == Some(hash) { push(a, { hash: hash, body: b.body }) }
        else { a },
    )
  })
}

// Everything the front-end cache files after an analysis, as plain data.
pub fn filing(w: Whole) -> Filing / {abort.raise} = {
  let hashed = by_name_one(w.hashes.defs);
  let checked = by_name_one(w.hashes.checks);
  let decls = by_name_one(w.hashes.decls);
  let types = type_rows(w.mods);
  let f: Filers = {
    defs: map_of_entries(map(w.checked.defs, |d: DefInfo| { key: d.name, value: d })),
    types: map_of_entries(map(types, |t: TypeRow| { key: t.name, value: t })),
    effects: map_of_entries(map(w.checked.effects, |e: EffectInfo| { key: e.name, value: e })),
    ctors: w.checked.ctors,
    hashed: hashed,
    checked: checked,
    decls: decls,
  };
  let tests = tests_by_module(w.checked.tests, w.hashes.tests, decls);
  let typed = fold(types, [], |acc: List<FiledDecl>, t: TypeRow|
    match map_get(decls, t.name) {
      None -> acc,
      Some(h) ->
        push(acc, {
          name: t.name,
          hash: h,
          interface: {
            effect: false,
            arity: t.arity,
            nondet: false,
            variants: map(ctors_of_type(w.checked.ctors, t.name), |k: CtorInfo|
              { name: k.simple_name, fields: map(k.fields, type_text) }),
            ops: [],
          },
        }),
    });
  {
    modules: map(range(0, len(w.mods)), |i: Int| {
      let m = at(w.mods, i);
      {
        name: m.name,
        source: i,
        entries: module_entries(f, m),
        tests: match map_get(tests, m.name) { Some(ts) -> ts, None -> [] },
      }
    }),
    // A definition's interface holds while its check key does, which a body edit in a package it
    // depends on leaves alone.
    defs: fold(w.checked.defs, [], |acc: List<FiledDef>, d: DefInfo|
      match map_get(checked, d.name) {
        None -> acc,
        Some(h) ->
          push(acc, {
            name: d.name,
            hash: h,
            interface: { row: def_known_row(decls, d, h), scheme: scheme_text(d.scheme) },
          }),
      }),
    decls: fold(w.checked.effects, typed, |acc: List<FiledDecl>, e: EffectInfo|
      match map_get(decls, e.name) {
        None -> acc,
        Some(h) ->
          push(acc, {
            name: e.name,
            hash: h,
            interface: {
              effect: true,
              arity: 0,
              nondet: e.nondet,
              variants: [],
              ops: map(e.ops, filed_op),
            },
          }),
      }),
    bodies: filed_bodies(w.hashes),
  }
}

// What a load takes from compiled packages in place of their modules' bodies, which are blanks.
// A stub stands in for the module of its name wherever a dependency or the shelf supplies one.
pub type Interfaces = { stubs: List<Source>, defs: List<KnownDefRow>, fixed: List<Fixed> }

pub fn no_interfaces() -> Interfaces = { stubs: [], defs: [], fixed: [] }

fn stubbed(ifaces: Interfaces) -> Map<Bytes, Bytes> =
  fold(ifaces.stubs, map_new(), |acc: Map<Bytes, Bytes>, s: Source| map_insert(acc, s.name, s.src))

fn read_as(stubs: Map<Bytes, Bytes>, s: Source) -> Source =
  match map_get(stubs, s.name) { Some(stub) -> { name: s.name, src: stub }, None -> s }

pub fn analyse(parsed: List<Parsed>) -> Analysis / {abort.raise} = analyse_with(parsed, [], [])

pub fn analyse_with(
  parsed: List<Parsed>,
  defs: List<KnownDefRow>,
  tests: List<KnownTestRow>,
  pkgs: Pkgs = { root: b"", manifest: None, supplied: [] },
  ifaces: Interfaces = { stubs: [], defs: [], fixed: [] },
) -> Analysis / {abort.raise} = {
  let clo = closure(pkgs, map(parsed, |p: Parsed| p.name));
  let stubs = stubbed(ifaces);
  let all = fold(clo.modules, parsed, |acc: List<Parsed>, m: { pkg: Int, src: Source }|
    push(acc, parse_at(len(acc), read_as(stubs, m.src))));
  // The toolchain's own tree loads without its implicit self; this path has no shelf list to
  // check the coverage half of that against, and only the toolchain's listings use it.
  let toolchain = fold(parsed, true, |acc: Bool, p: Parsed| acc && is_std(p.name));
  analyse_closure(all, clo, append(defs, ifaces.defs), tests, len(parsed), toolchain, ifaces)
}

// The packages of a load as the front end's tables take them: the root package first, the
// shelf one past the end, and every module mapped to the package it was parsed from. The
// order is the root's modules, then the closure's dependency modules, then the pulled shelf.
// The built-in packages: every package's implicit dependencies, pulled on demand like the
// shelf but owned as packages — the two the runtime pre-seeds.
pub fn std_pkg() -> Pkg = { prefix: b"std", deps: [] }

pub fn compiler_pkg() -> Pkg = { prefix: b"compiler", deps: [b"std"] }

fn has(xs: List<Bytes>, x: Bytes) -> Bool =
  match xs { [] -> false, [y, ..rest] -> if y == x { true } else { has(rest, x) } }

// The packages of a load as the front end's tables take them: the root package first, then
// the closure's, then the built-in std, with the shelf past the end, and every module mapped
// to the package it was parsed from. The order is the root's modules, then the closure's
// dependency modules, then the pulled toolchain modules.
fn pkg_tables(
  parsed: List<Parsed>,
  root_count: Int,
  clo: Closure,
  toolchain: Bool,
) -> { pkgs: List<Pkg>, mod_pkg: List<Int>, std: Int, compiler: Int, shelf: Int } / {abort.raise} = {
  let std = if toolchain { 0 - 1 } else { len(clo.packages) };
  let compiler = if toolchain { 0 - 1 } else { std + 1 };
  {
    pkgs: if toolchain { map(clo.packages, |p: Package| { prefix: p.prefix, deps: p.deps }) } else {
      push(
        push(map(clo.packages, |p: Package| { prefix: p.prefix, deps: p.deps }), std_pkg()),
        compiler_pkg(),
      )
    },
    // Pulled std publishes as the shelf (its internal imports are qualified), and pulled
    // compiler as its own package, which its bare sibling imports resolve against.
    mod_pkg: map(range(0, len(parsed)), |i: Int|
      if i < root_count { 0 }
      else if i < root_count + len(clo.modules) { at(clo.modules, i - root_count).pkg }
      else if toolchain { len(clo.packages) }
      else if is_compiler(at(parsed, i).name) { std + 1 }
      else { std + 2 }),
    std: std,
    compiler: compiler,
    shelf: if toolchain { len(clo.packages) } else { std + 2 },
  }
}

fn first_segment(name: Bytes) -> Bytes / {abort.raise} =
  match bytes_index_of(name, b".") { None -> name, Some(i) -> bytes_slice(name, 0, i) }

// A root module under a built-in package's prefix, which no user's file may claim; the
// toolchain's own std tree is the one load that may, and it announces itself by covering the
// whole shipped set.
fn std_squats(
  parsed: List<Parsed>,
  root_count: Int,
  toolchain: Bool,
) -> List<{ slot: Int, diag: PDiag }> / {abort.raise} =
  if toolchain { [] } else {
    fold(range(0, root_count), [], |acc: List<{ slot: Int, diag: PDiag }>, i: Int| {
      let n = at(parsed, i).name;
      let seg = first_segment(n);
      if seg != b"std" && seg != b"compiler" { acc } else {
        push(acc, {
          slot: 0 - i - 1,
          diag: pdiag(
            b"E0133",
            bytes_concat_all([b"`", n, b"` would shadow the built-in package `", seg, b"`"]),
            [
              plabel(
                dummy_span(),
                true,
                b"this file claims a module under the toolchain's own prefix",
              ),
            ],
            [
              b"`std` and `compiler` name the modules the toolchain ships; rename the file or the directory",
            ],
          ),
        })
      }
    })
  }

fn analyse_closure(
  parsed: List<Parsed>,
  clo: Closure,
  defs: List<KnownDefRow>,
  tests: List<KnownTestRow>,
  root_count: Int,
  toolchain: Bool,
  ifaces: Interfaces = { stubs: [], defs: [], fixed: [] },
  embeds: List<EmbedAt> = [],
) -> Analysis / {abort.raise} = {
  // The packages' identity reports ahead of anything the program text has to say: manifest
  // and graph diags point one slot past every module, in manifest order.
  let pkg_diags = fold(
    std_squats(parsed, root_count, toolchain),
    clo.diags,
    |acc: List<{ slot: Int, diag: PDiag }>, sd: { slot: Int, diag: PDiag }| push(acc, sd),
  );
  if len(pkg_diags) > 0 {
    Refused(
      map(pkg_diags, |sd: { slot: Int, diag: PDiag }|
        if sd.slot < 0 { placed(0 - sd.slot - 1, sd.diag) }
        else { placed(len(parsed) + sd.slot, sd.diag) }),
    )
  } else {
    let early = fold(parsed, [], |acc: List<Diag>, p: Parsed| append(acc, p.diags));
    if len(early) > 0 { Refused(early) } else {
      let tables = pkg_tables(parsed, root_count, clo, toolchain);
      match resolve_packaged(
          map(parsed, |p: Parsed| p.module),
          tables.pkgs,
          tables.mod_pkg,
          tables.std,
          tables.compiler,
          tables.shelf,
        ) {
        Failed(ds) -> Refused(map(ds, outside_every_module)),
        Resolved_(x) -> {
          let built = build_index(x.mods, x.r);
          if len(built.diags) > 0 { Refused(map(built.diags, outside_every_module)) } else {
            // Hashing reads the tree, not the checker, so what has moved is known before anything is checked.
            let hashes: HashOutput = hash_index_pinned(built.index, ifaces.fixed, tables.mod_pkg);
            let checked: Front = check_front_with(
              x.r,
              x.mods,
              taken(x.mods, built.index, hashes, defs, tests, root_count),
            );
            if !checked.ok { Refused(map(checked.diags, outside_every_module)) } else {
              Analysed({
                mods: x.mods,
                r: x.r,
                checked: checked,
                index: built.index,
                hashes: hashes,
                // A dependency's unused definitions are its own package's to report.
                warnings: map(
                  filter(unused(built.index, ifaces.fixed), |d: Diag|
                    fold(
                      d.labels,
                      false,
                      |b: Bool, l: { module: Int, start: Int, end: Int, primary: Bool, text: Bytes }|
                        b || (l.primary && l.module < root_count),
                    )),
                  outside_every_module,
                ),
                manifest: at(clo.packages, 0).manifest,
                packages: tables.pkgs,
                pins: pins_of(clo, embeds),
                mod_pkg: tables.mod_pkg,
                stubs: map(ifaces.stubs, |s: Source| s.name),
                embeds: embeds,
              })
            }
          }
        },
      }
    }
  }
}

// Every table the answer holds, as rows.
pub fn dump_of(a: Analysis) -> Dump / {abort.raise} =
  match a {
    Refused(ds) ->
      {
        diags: map(ds, answered_diag),
        order: [],
        packages: [],
        pins: [],
        mod_pkg: [],
        modules: [],
        defs: [],
        types: [],
        tests: [],
        laws: [],
        effects: [],
        ctors: [],
        hashes: [],
        hashes_digest: b"",
        keys: [],
        emit_roots: [],
        emit_ctors: [],
        ordinals: [],
        bodies: [],
        test_bodies: [],
        embeds: [],
        rows: { defs: [], tests: [] },
        walked: b"",
      },
    Analysed(w) ->
      tables(
        w.warnings,
        w.mods,
        w.r,
        w.checked,
        w.index,
        w.hashes,
        w.packages,
        w.pins,
        w.mod_pkg,
        w.embeds,
      ),
  }

// A builtin as the checker binds it, the names its parameters are documented under, and the
// witnesses a `numeric` or `integer` constraint has the elaboration pass ahead of them.
pub type BuiltinRow = { name: Bytes, scheme: Scheme, params: List<Bytes>, witnesses: Int }

// Every builtin, in the prelude's order.
pub fn builtin_rows() -> List<BuiltinRow> / {abort.raise} = {
  let docs = builtin_docs();
  let constrained = builtin_constraints();
  map(builtin_schemes(0, 1, 2, 0), |x: { name: Bytes, sc: Scheme }|
    {
      name: x.name,
      scheme: x.sc,
      params: match find_doc(docs, x.name) { Some(d) -> d.params, None -> [] },
      witnesses: fold(constrained, 0, |n: Int, b: { name: Bytes, cs: List<DefConstraint> }|
        if b.name != x.name { n }
        else { len(filter(b.cs, |c: DefConstraint| is_predicate(c.deriver))) }),
    })
}

fn global(r: Resolved, module: Int, written: Bytes) -> Bytes / {abort.raise} = {
  let q: QName = match bytes_index_of(written, b"::") {
    Some(i) ->
      {
        module: Some({ name: bytes_slice(written, 0, i), span: dummy_span() }),
        name: { name: bytes_slice(written, i + 2, bytes_len(written)), span: dummy_span() },
        span: dummy_span(),
      },
    None -> { module: None, name: { name: written, span: dummy_span() }, span: dummy_span() },
  };
  match find(r, module, NValue, q) { Some(b) -> b.qualified, None -> written }
}

fn named_pat(r: Resolved, m: Int, p: CPat) -> CPat / {abort.raise} =
  match p {
    PxCtor(c) ->
      PxCtor({ name: global(r, m, c.name), args: map(c.args, |a: CPat| named_pat(r, m, a)) }),
    PxRecord(rc) ->
      PxRecord({
        fields: map(rc.fields, |f: CPatField| { name: f.name, pat: named_pat(r, m, f.pat) }),
        rest: rc.rest,
      }),
    PxList(l) ->
      PxList({
        items: map(l.items, |i: CPat| named_pat(r, m, i)),
        rest: match l.rest { Some(x) -> Some(named_pat(r, m, x)), None -> None },
      }),
    _ -> p,
  }

fn named_fields(r: Resolved, m: Int, fs: List<CField>) -> List<CField> / {abort.raise} =
  map(fs, |f: CField| { name: f.name, value: named(r, m, f.value) })

fn named_opt(r: Resolved, m: Int, c: Option<Code>) -> Option<Code> / {abort.raise} =
  match c { Some(x) -> Some(named(r, m, x)), None -> None }

fn named_stmt(r: Resolved, m: Int, s: CStmt) -> CStmt / {abort.raise} =
  match s {
    CLet(l) -> CLet({ name: l.name, slot: l.slot, value: named(r, m, l.value) }),
    CLetPat(l) ->
      CLetPat({ span: l.span, pat: named_pat(r, m, l.pat), value: named(r, m, l.value) }),
    CDo(d) -> CDo({ code: named(r, m, d.code) }),
  }

fn named(r: Resolved, m: Int, c: Code) -> Code / {abort.raise} = {
  let n = |x: Code| named(r, m, x);
  let ns = |xs: List<Code>| map(xs, |x: Code| named(r, m, x));
  let node = match c.node {
    NLit(_) -> c.node,
    NLabel(_) -> c.node,
    NVar(v) -> match v.slot {
      Some(_) -> c.node,
      None -> NVar({ name: global(r, m, v.name), slot: None }),
    },
    NUnary(u) -> NUnary({ op: u.op, operand: n(u.operand) }),
    NBinary(b) -> NBinary({ op: b.op, lhs: n(b.lhs), rhs: n(b.rhs) }),
    NApp(a) -> NApp({ func: n(a.func), args: ns(a.args) }),
    NIf(i) ->
      NIf({ cond: n(i.cond), then_branch: n(i.then_branch), else_branch: n(i.else_branch) }),
    NBlock(b) ->
      NBlock({
        stmts: map(b.stmts, |s: CStmt| named_stmt(r, m, s)),
        tail: named_opt(r, m, b.tail),
      }),
    NList(l) -> NList({ items: ns(l.items) }),
    NRecord(rc) -> NRecord({ fields: named_fields(r, m, rc.fields) }),
    NMatch(x) ->
      NMatch({
        scrutinee: n(x.scrutinee),
        arms: map(x.arms, |a: CArm|
          {
            pat: named_pat(r, m, a.pat),
            guard: named_opt(r, m, a.guard),
            body: named(r, m, a.body),
          }),
      }),
    NPerform(p) ->
      NPerform({
        effect: p.effect,
        op: p.op,
        resource: p.resource,
        label: named_opt(r, m, p.label),
        args: ns(p.args),
      }),
    NCell(x) ->
      NCell({
        resource: x.resource,
        binder: x.binder,
        slot: x.slot,
        init: n(x.init),
        body: n(x.body),
      }),
    NLambda(l) -> NLambda({ params: l.params, size: l.size, caps: l.caps, body: n(l.body) }),
    NSim(x) -> NSim({ size: x.size, caps: x.caps, body: n(x.body) }),
    NPar(x) -> NPar({ branches: ns(x.branches) }),
    NHandle(h) ->
      NHandle({
        body: n(h.body),
        clauses: map(h.clauses, |k: CClause|
          {
            effect: k.effect,
            op: k.op,
            resource: k.resource,
            label: named_opt(r, m, k.label),
            params: k.params,
            binds_label: k.binds_label,
            resume: k.resume,
            size: k.size,
            caps: k.caps,
            body: named(r, m, k.body),
          }),
        ret: match h.ret {
          Some(x) -> Some({ size: x.size, caps: x.caps, body: n(x.body) }),
          None -> None,
        },
      }),
    NField(f) -> NField({ base: n(f.base), field: f.field }),
    NUpd(u) -> NUpd({ base: n(u.base), copies: u.copies, sets: named_fields(r, m, u.sets) }),
  };
  { own: c.own, node: node, span: c.span }
}

// What the prover reads of a program: each `fn`'s lowered body and clauses, each sum type's
// variant count, and each law. A body the lowering does not take is `None`, which reads as
// unreached.
pub type Claim =
  | ClaimDef({ name: Bytes, params: Int, body: Option<Code>, spec: List<ClaimClause> })
  | ClaimSum({ name: Bytes, variants: Int })
  | ClaimLaw({ key: Bytes, guard: Option<Lowered>, body: Option<Code> })

// A clause lowered under its binders, and where it is written.
pub type Lowered = { at: At, code: Option<Code> }

pub type ClaimClause = { kind: SpecKind, clause: Lowered }

fn lowered(r: Resolved, m: Int, params: List<Bytes>, e: Expr) -> Option<Code> / {abort.raise} =
  match lower_fn(params, [], map_new(), e) { Some(l) -> Some(named(r, m, l.code)), None -> None }

fn lowered_at(r: Resolved, m: Int, params: List<Bytes>, e: Expr) -> Lowered / {abort.raise} =
  { at: span_at(m, expr_span(e)), code: lowered(r, m, params, e) }

// `result` takes the slot after the parameters, as the obligation's binders place it. An opaque
// definition is claimed by its spec alone: what it promises, not how it is written.
fn def_claim(r: Resolved, m: Int, module: Bytes, d: FnDef, opaque: Bool) -> Claim / {abort.raise} = {
  let params = map(d.params, |p: Param| p.name.name);
  ClaimDef({
    name: qualify(module, d.name.name),
    params: len(params),
    // A `transparent` definition's body is part of what other modules read of it.
    body: if opaque && d.transparent == None { None } else { lowered(r, m, params, d.body) },
    spec: map(d.spec, |c: SpecClause|
      {
        kind: c.kind,
        clause: lowered_at(
          r,
          m,
          match c.kind { SRequires -> params, SEnsures -> push(params, b"result") },
          c.expr,
        ),
      }),
  })
}

fn law_claim(r: Resolved, m: Int, module: Bytes, d: LawDef) -> Claim / {abort.raise} = {
  let names = map(d.binders, |b: Binder| b.name.name);
  ClaimLaw({
    key: qualify(module, d.name),
    guard: match d.guard { Some(g) -> Some(lowered_at(r, m, names, g)), None -> None },
    body: lowered(r, m, names, d.body),
  })
}

fn claims_of(mods: List<Mod>, r: Resolved) -> List<Claim> / {abort.raise} =
  claims_of_modules(mods, r, range(0, len(mods)), |m: Bytes| false)

fn claims_of_modules(
  mods: List<Mod>,
  r: Resolved,
  wanted: List<Int>,
  opaque: (Bytes) -> Bool,
) -> List<Claim> / {abort.raise} =
  fold(wanted, [], |acc: List<Claim>, i: Int| {
    let m = at(mods, i);
    fold(m.module.items, acc, |a: List<Claim>, it: Item|
      match it {
        IFn(d) -> push(a, def_claim(r, i, m.name, d, opaque(m.name))),
        // A split over a type is sound only with every variant in hand.
        IType(d) -> match d.body {
          TDSum(vs) -> push(a, ClaimSum({ name: qualify(m.name, d.name.name), variants: len(vs) })),
          _ -> a,
        },
        ILaw(d) -> push(a, law_claim(r, i, m.name, d)),
        _ -> a,
      })
  })

pub fn claims(
  sources: List<Source>,
  pkgs: List<Pkg> = [],
  mod_pkg: List<Int> = [],
  shelf: Int = 0,
) -> List<Claim> / {abort.raise} = {
  let mods = map(parse_all(sources), |p: Parsed| p.module);
  // The published table ends with the built-in packages; the shelf sits one past them.
  let packaged = if len(pkgs) == 0 { no_pkgs(mods) }
  else { { pkgs: pkgs, mod_pkg: mod_pkg, std: shelf - 2, compiler: shelf - 1, shelf: shelf } };
  match resolve_packaged(
      mods,
      packaged.pkgs,
      packaged.mod_pkg,
      packaged.std,
      packaged.compiler,
      packaged.shelf,
    ) {
    Failed(_) -> panic("a program the front end checked does not resolve"),
    Resolved_(x) -> match elaboration(x.r, x.mods) {
      None -> panic("a program the front end checked does not check"),
      Some(shapes) -> claims_of(updated_mods(x.mods, shapes), x.r),
    },
  }
}

// The claims of the modules at `wanted`, ascending and closed under imports, lowered as `claims`
// lowers them, from a program `analyse` checked: its parse and resolution are reused, and the checker
// walks again only the definitions there that write a record update — the one thing lowering reads
// from it — seeded with every other definition's and test's rows as the next analysis would be.
// A module the run does not own is claimed by its specs, so its source and its stub answer alike.
pub fn claims_in(
  w: Whole,
  wanted: List<Int>,
  owned: (Bytes) -> Bool = |m: Bytes| true,
) -> List<Claim> / {abort.raise} = {
  let stubs = fold(w.stubs, map_new(), |acc: Map<Bytes, Bool>, s: Bytes| map_insert(acc, s, true));
  let walked = fold(wanted, map_new(), |acc: Map<Bytes, Bool>, i: Int| {
    let m = at(w.mods, i);
    fold(m.module.items, acc, |a: Map<Bytes, Bool>, it: Item|
      match it {
        IFn(d) -> if fn_has_update(d) { map_insert(a, qualify(m.name, d.name.name), true) }
        else { a },
        _ -> a,
      })
  });
  let rows = rows_of(w);
  // The analysis held every promise already, so this check of it holds none again.
  let known = taken(
    w.mods,
    w.index,
    w.hashes,
    filter(rows.defs, |r: KnownDefRow| !map_contains(walked, r.name)),
    rows.tests,
    0,
  );
  match elaboration_with(w.r, w.mods, known) {
    None -> panic("a program the front end checked does not check"),
    Some(shapes) ->
      claims_of_modules(updated_mods(w.mods, shapes), w.r, wanted, |m: Bytes|
        map_contains(stubs, m) || !owned(m)),
  }
}

// Every definition and test re-hashed under `pins`. The package tables are the ones the program
// was analysed with — a rehash that resolved with pre-package rules would read a dependency's own
// modules as root ones — and the shelf sits one past the published table, as `claims` has it.
pub fn rehash(
  sources: List<Source>,
  pins: List<Pin>,
  pkgs: List<Pkg> = [],
  mod_pkg: List<Int> = [],
  shelf: Int = 0,
  embeds: List<EmbedAt> = [],
) -> Rehashed / {abort.raise} = {
  let tables = embed_tables(embeds);
  let mods = map(parse_all(sources), |p: Parsed|
    { ..p.module, module: rewritten(tables, p.name, p.module.module).module });
  let packaged = if len(pkgs) == 0 { no_pkgs(mods) }
  else { { pkgs: pkgs, mod_pkg: mod_pkg, std: shelf - 2, compiler: shelf - 1, shelf: shelf } };
  match resolve_packaged(
      mods,
      packaged.pkgs,
      packaged.mod_pkg,
      packaged.std,
      packaged.compiler,
      packaged.shelf,
    ) {
    Failed(_) -> panic("a program the front end checked does not resolve"),
    Resolved_(x) -> rehash_index(build_index(x.mods, x.r).index, pins),
  }
}

// --- Pulling in the shipped modules --------------------------------------------
// As the driver places them: after the program's own modules, a round of new imports at a time, each round in byte order.

fn is_std(name: Bytes) -> Bool = name == b"std" || bytes_starts_with(name, b"std.")

// The compiler's own modules, shelved under one reserved root so a program can import the formatter.
// A shelved module names its siblings under that root too: the shelf hands over text, and the
// emitter parses the same text to name a call, so the root is in the source and not in a tree.
fn is_compiler(name: Bytes) -> Bool = name == b"compiler" || bytes_starts_with(name, b"compiler.")

fn is_shipped(name: Bytes) -> Bool = is_std(name) || is_compiler(name)

fn import_at(imports: List<ImportDecl>, name: Bytes) -> Span / {abort.raise} = {
  let found = fold(imports, None, |acc: Option<Span>, d: ImportDecl|
    match acc {
      Some(_) -> acc,
      None -> if import_module_name(d) == name { Some(path_span(d)) } else { None },
    });
  match found { Some(s) -> s, None -> dummy_span() }
}

fn unknown_shipped(m: Int, at_: Span, name: Bytes, listed: List<Bytes>) -> Diag / {abort.raise} =
  diag1(
    b"E0106",
    m,
    at_,
    bytes_concat_all([b"no module named `", name, b"` ships with this compiler"]),
    b"not found",
    [
      bytes_concat(b"the stdlib holds: ", backticked(filter(listed, is_std), b", ")),
      b"`ply std` lists them with the digest this binary was built from",
    ],
  )

fn foreign_import(m: Int, at_: Span, importer: Bytes, name: Bytes) -> Diag =
  diag1(
    b"E0505",
    m,
    at_,
    bytes_concat_all([
      b"the shipped module `",
      importer,
      b"` imports `",
      name,
      b"`, which this build does not ship",
    ]),
    b"a stdlib module may import only modules that ship with it",
    [
      b"this is a defect in the compiler's own sources, not in this program",
      b"please report it with the version of `ply` that produced it",
    ],
  )

type Round = { wanted: Map<Bytes, Bytes>, diags: List<Diag> }

fn pull_round(
  users: Int,
  shipped: Map<Bytes, Bytes>,
  listed: List<Bytes>,
  parsed: List<Parsed>,
) -> Round / {abort.raise} = {
  let present = fold(parsed, map_new(), |acc: Map<Bytes, Bool>, p: Parsed|
    map_insert(acc, p.name, true));
  fold(range(0, len(parsed)), { wanted: map_new(), diags: [] }, |acc: Round, i: Int| {
    let p = at(parsed, i);
    let imports = p.module.module.imports;
    let ships = i >= users;
    fold(imports, acc, |r: Round, d: ImportDecl| {
      let name = import_module_name(d);
      if is_shipped(name) && !map_contains(present, name) {
        match map_get(shipped, name) {
          Some(src) -> { ..r, wanted: map_insert(r.wanted, name, src) },
          None ->
            {
              ..r,
              diags: push(r.diags, if ships {
                foreign_import(i, import_at(imports, name), p.name, name)
              } else { unknown_shipped(i, import_at(imports, name), name, listed) }),
            },
        }
      } else if ships && !is_shipped(name) {
        // The compiler package's internal import: `compiler.costs` means `compiler.spine`.
        let internal = bytes_concat(b"compiler.", name);
        if map_contains(present, internal) { r } else {
          match map_get(shipped, internal) {
            Some(src) -> { ..r, wanted: map_insert(r.wanted, internal, src) },
            None -> if is_compiler(p.name) { r } else {
              {
                ..r,
                diags: push(r.diags, foreign_import(i, import_at(imports, name), p.name, name)),
              }
            },
          }
        }
      } else { r }
    })
  })
}

type Pull = { parsed: List<Parsed>, pulled: List<Bytes>, diags: List<Diag> }

fn pulling(
  users: Int,
  shipped: Map<Bytes, Bytes>,
  listed: List<Bytes>,
  x: Pull,
) -> Pull / {abort.raise} = {
  let early = fold(x.parsed, [], |acc: List<Diag>, p: Parsed| append(acc, p.diags));
  if len(early) > 0 { { ..x, diags: early } } else {
    let r = pull_round(users, shipped, listed, x.parsed);
    if len(r.diags) > 0 { { ..x, diags: r.diags } }
    else if map_len(r.wanted) == 0 { x } else {
      pulling(
        users,
        shipped,
        listed,
        map_fold(r.wanted, x, |acc: Pull, name: Bytes, src: Bytes|
          {
            ..acc,
            parsed: push(acc.parsed, parse_at(len(acc.parsed), { name: name, src: src })),
            pulled: push(acc.pulled, name),
          }),
      )
    }
  }
}

// `analyse` over `user` and the modules of `shipped` it imports, with those named in the order they
// were pulled: a label's module index points into `user` first and then into `pulled`, so a caller
// that renders one needs both lists.
pub type Pulled = { pulled: List<Bytes>, out: Analysis }

pub fn analyse_pulling_std(user: List<Source>, shipped: List<Source>) -> Pulled / {abort.raise} =
  analyse_pulling_std_with(user, shipped, [], [])

pub fn analyse_pulling_std_with(
  user: List<Source>,
  shipped: List<Source>,
  defs: List<KnownDefRow>,
  tests: List<KnownTestRow>,
  pkgs: Pkgs = { root: b"", manifest: None, supplied: [] },
  ifaces: Interfaces = { stubs: [], defs: [], fixed: [] },
  embeds: List<Embedded> = [],
) -> Pulled / {abort.raise} = {
  let clo = closure(pkgs, map(user, |s: Source| s.name));
  let stubs = stubbed(ifaces);
  let texts = fold(shipped, map_new(), |acc: Map<Bytes, Bytes>, s: Source|
    map_insert(acc, s.name, read_as(stubs, s).src));
  let parsed = fold(
    clo.modules,
    parse_all(user),
    |acc: List<Parsed>, m: { pkg: Int, src: Source }|
      push(acc, parse_at(len(acc), read_as(stubs, m.src))),
  );
  let mentions = append(
    map(user, |s: Source| names_embed(s.src)),
    map(clo.modules, |m: { pkg: Int, src: Source }| names_embed(m.src.src)),
  );
  let written = embedded_all(parsed, own_names(pkgs, user), mentions, embeds);
  let assembled = written.parsed;
  // The toolchain's own tree loads without its implicit self: every root module under `std`
  // with the whole shipped set among them is the built-in package's sources.
  let toolchain = fold(user, true, |acc: Bool, s: Source| acc && is_std(s.name))
    && fold(shipped, true, |acc: Bool, s: Source|
      acc && (!is_std(s.name) || has(map(user, |u: Source| u.name), s.name)));
  let x = pulling(len(assembled), texts, map(shipped, |s: Source| s.name), {
    parsed: assembled,
    pulled: [],
    diags: [],
  });
  {
    pulled: x.pulled,
    out: if len(x.diags) > 0 { Refused(x.diags) } else {
      analyse_closure(
        x.parsed,
        clo,
        append(defs, ifaces.defs),
        tests,
        len(user),
        toolchain,
        ifaces,
        written.at,
      )
    },
  }
}

// --- Embeds ----------------------------------------------------------------------------------

// What the driver read for one embed: the module by its package's root key and its own name in that
// package, what it asked for, and what was read.
pub type Embedded = { root: Bytes, module: Bytes, want: EmbedWant, read: EmbedRead }

fn names_embed(src: Bytes) -> Bool = bytes_index_of(src, b"embed") != None

// What the modules of the package at `root` ask to embed. Only a module whose text names `embed`
// is parsed for it.
pub fn embeds_wanted(root: Bytes, sources: List<Source>) -> List<Embedded> / {abort.raise} =
  fold(sources, [], |acc: List<Embedded>, s: Source|
    if !names_embed(s.src) { acc } else {
      fold(wants_of(parse(s.src).node), acc, |a: List<Embedded>, w: EmbedWant|
        push(a, { root: root, module: s.name, want: w, read: Err(b"not read yet") }))
    })

fn embed_slot(root: Bytes, module: Bytes) -> Bytes = bytes_concat_all([root, b"\x00", module])

// Each parsed module's package root and own name, in the order the program and its dependencies
// were parsed.
fn own_names(pkgs: Pkgs, user: List<Source>) -> List<Bytes> =
  fold(
    pkgs.supplied,
    map(user, |s: Source| embed_slot(pkgs.root, s.name)),
    |acc: List<Bytes>, sp: Supplied|
      fold(sp.modules, acc, |a: List<Bytes>, s: Source| push(a, embed_slot(sp.root, s.name))),
  )

// Every module that names `embed` with its embeds written out, a read that failed as its
// diagnostic, and the reads by each module's name in the program.
fn embedded_all(
  parsed: List<Parsed>,
  slots: List<Bytes>,
  mentions: List<Bool>,
  embeds: List<Embedded>,
) -> { parsed: List<Parsed>, at: List<EmbedAt> } / {abort.raise} = {
  let tables = fold(embeds, map_new(), |acc: Map<Bytes, Map<Bytes, EmbedRead>>, e: Embedded| {
    let slot = embed_slot(e.root, e.module);
    let was = match map_get(acc, slot) { Some(t) -> t, None -> map_new() };
    map_insert(acc, slot, map_insert(was, embed_key(e.want), e.read))
  });
  fold(
    range(0, len(parsed)),
    { parsed: [], at: [] },
    |acc: { parsed: List<Parsed>, at: List<EmbedAt> }, i: Int| {
      let p = at(parsed, i);
      match ((list_at(slots, i), list_at(mentions, i))) {
        (Some(slot), Some(true)) -> {
          let table = match map_get(tables, slot) { Some(t) -> t, None -> map_new() };
          let r = embedded(p.module.module, table, []);
          {
            parsed: push(acc.parsed, {
              ..p,
              module: { ..p.module, module: r.module },
              diags: append(p.diags, map(r.diags, |d: PDiag| placed(i, d))),
            }),
            at: map_fold(table, acc.at, |a: List<EmbedAt>, key: Bytes, read: EmbedRead|
              push(a, { module: p.name, key: key, read: read })),
          }
        },
        _ -> { ..acc, parsed: push(acc.parsed, p) },
      }
    },
  )
}

// The front end's answer as values: the shipped modules pulled in, in the order a label's module
// index counts them after the program's own, and the rows. A refused program's rows are its
// diagnostics alone.
pub type FrontAnswer = { pulled: List<Bytes>, dump: Dump }

// `analyse_pulling_std_with`'s answer as the rows it holds: what the driver reads. The rows handed
// in are the last answer's: what this program hashes the same is taken from them, and only what
// moved is walked.
// The runtime calls this at a fixed arity, so interfaces go through `analyse_pulling_std_with`.
pub fn answer_pulling_std_with(
  user: List<Source>,
  shipped: List<Source>,
  defs: List<KnownDefRow>,
  tests: List<KnownTestRow>,
  pkgs: Pkgs = { root: b"", manifest: None, supplied: [] },
  embeds: List<Embedded> = [],
) -> FrontAnswer / {abort.raise} = {
  let x: Pulled = analyse_pulling_std_with(
    user,
    shipped,
    defs,
    tests,
    pkgs,
    no_interfaces(),
    embeds,
  );
  { pulled: x.pulled, dump: dump_of(x.out) }
}

// `seeded` counts the definitions taken from the rows handed in rather than walked.
pub type RowsAnswer = { pulled: List<Bytes>, dump: Dump, rows: Rows, seeded: Int }

// The same answer and the rows the analysis published, for a driver that keeps them to seed its
// next load of the same program. The runtime calls this at a fixed arity.
pub fn answer_rows_pulling_std_with(
  user: List<Source>,
  shipped: List<Source>,
  defs: List<KnownDefRow>,
  tests: List<KnownTestRow>,
  pkgs: Pkgs,
  embeds: List<Embedded>,
) -> RowsAnswer / {abort.raise} = {
  let x: Pulled = analyse_pulling_std_with(
    user,
    shipped,
    defs,
    tests,
    pkgs,
    no_interfaces(),
    embeds,
  );
  {
    pulled: x.pulled,
    dump: dump_of(x.out),
    rows: match x.out { Analysed(w) -> rows_of(w), Refused(_) -> no_rows() },
    seeded: match x.out { Analysed(w) -> len(w.checked.seeded), Refused(_) -> 0 },
  }
}

// --- The rows an answer is made of ----------------------------------------------
// Types and rows are held as the checker's values.

// A span: a module index, `no_module` outside every module, and the offsets.
pub type At = { module: Int, start: Int, end: Int }

pub type ModuleRow = {
  name: Bytes,
  index: Int,
  items: List<Bytes>,
  imports: List<Bytes>,
  sets: List<SetView>,
  cuts: List<Cut>,
}

pub type ParamRow = { name: Bytes, at: At }

pub type SpecRow = { kind: Bytes, index: Int, footprint: List<Atom>, at: At }

pub type DefRow = {
  name: Bytes,
  module: Bytes,
  simple_name: Bytes,
  public: Bool,
  reuse: Bool,
  scheme: Scheme,
  footprint: List<Atom>,
  performed: List<Atom>,
  constraints: List<DefConstraint>,
  row_aliases: List<Bytes>,
  params: List<ParamRow>,
  spec: List<SpecRow>,
  at: At,
  literals: List<Bytes>,
}

pub type TypeRow = {
  name: Bytes,
  module: Bytes,
  simple_name: Bytes,
  public: Bool,
  arity: Int,
  at: At,
}

pub type TestRow = {
  key: Bytes,
  name: Bytes,
  module: Bytes,
  index: Int,
  nondet: Bool,
  footprint: List<Atom>,
  at: At,
  name_at: At,
}

pub type BinderRow = { name: Bytes, at: At, ty: Type }

pub type LawRow = {
  key: Bytes,
  name: Bytes,
  module: Bytes,
  index: Int,
  binders: List<BinderRow>,
  has_guard: Bool,
  host: Bool,
  cost: Bool,
  footprint: List<Atom>,
  at: At,
  literals: List<Bytes>,
}

// `carries` says how each argument a host handler is given reads at the compiled seam.
pub type OpRow = {
  name: Bytes,
  mode: Bytes,
  resource_param: Bool,
  params: List<Type>,
  ret: Type,
  scheme: Option<Scheme>,
  at: At,
  carries: List<Carry>,
}

pub type EffectRow = {
  name: Bytes,
  module: Bytes,
  simple_name: Bytes,
  public: Bool,
  nondet: Bool,
  ops: List<OpRow>,
  at: At,
}

pub type CtorRow = {
  name: Bytes,
  module: Bytes,
  simple_name: Bytes,
  type_name: Bytes,
  index: Int,
  arity: Int,
  fields: List<Type>,
  scheme: Scheme,
  at: At,
}

pub type HashRow = {
  name: Bytes,
  def: Option<Bytes>,
  own: Option<Bytes>,
  decl: Option<Bytes>,
  specs: List<Bytes>,
  spec_texts: List<Bytes>,
  deps: List<Bytes>,
  closure: List<Bytes>,
}

// A test's or a law's hash row, under the index of the item it is about; `text` is a law's
// sentence hash and is empty for a test.
pub type ItemHashRow = {
  index: Int,
  key: Bytes,
  hash: Bytes,
  text: Bytes,
  deps: List<Bytes>,
  closure: List<Bytes>,
}

pub type HashFrame = | HDef(HashRow) | HTest(ItemHashRow) | HLaw(ItemHashRow)

pub type OrdinalRow = { module: Bytes, items: List<Bytes> }

pub type BodyRow = { name: Bytes, body: Bytes }

// Every table of the front end's answer.
pub type Dump = {
  diags: List<Diag>,
  order: List<Bytes>,
  packages: List<Pkg>,
  pins: List<Pinned>,
  mod_pkg: List<Int>,
  modules: List<ModuleRow>,
  defs: List<DefRow>,
  types: List<TypeRow>,
  tests: List<TestRow>,
  laws: List<LawRow>,
  effects: List<EffectRow>,
  ctors: List<CtorRow>,
  hashes: List<HashFrame>,
  hashes_digest: Bytes,
  keys: List<KeyRow>,
  emit_roots: List<EmitRoot>,
  emit_ctors: List<EmitCtor>,
  ordinals: List<OrdinalRow>,
  bodies: List<BodyRow>,
  test_bodies: List<Bytes>,
  embeds: List<EmbedAt>,
  // What every definition and test published, which spares the emitter a walk of the bodies it
  // does not lower.
  rows: Rows,
  // A `Walked`, in the encoding both programs read with the type: the emitter lowers a body the
  // checker walked without walking it again.
  walked: Bytes,
}

pub fn has_error(ds: List<Diag>) -> Bool =
  fold(ds, false, |acc: Bool, d: Diag| acc || d.severity == b"error")

// A diagnostic as the answer carries it: no dedup key, and the note count is the notes.
pub fn answered_diag(d: Diag) -> Diag =
  {
    code: d.code,
    notes: len(d.notes_text),
    labels: d.labels,
    text: b"",
    message: d.message,
    notes_text: d.notes_text,
    severity: d.severity,
    fixes: d.fixes,
  }

// --- Tests ------------------------------------------------------------------

fn program() -> List<Source> =
  [
    {
      name: b"m",
      src: b"effect log { write emit(Bytes) -> Unit }\ntype Shape = | Dot | Line(Int)\nfn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\ntest \"says\" { say(b\"x\") }",
    },
  ]

test "the emitter's root keys cover every root and no two share one" {
  let src = b"fn pos(x: Int) -> Bool = x > 0\nfn f(x: Int) -> Int requires pos(x) ensures x >= 0 = x\ntest \"t\" { assert_eq(f(1), 1) }\nlaw \"l\" forall (x: Int) { f(x) == x }";
  match analyse(parse_all([{ name: b"m", src: src }])) {
    Refused(_) -> panic("the program checks"),
    Analysed(w) -> {
      let keys = root_keys(w.mods, w.checked, w.hashes);
      assert_eq(map(keys, |k: KeyRow| k.root), [
        b"m.pos",
        b"m.f#requires#0",
        b"m.f#ensures#0",
        b"m.f",
        b"m.test#0",
        b"m.law#0.body",
      ]);
      // No two roots share a key, or a cache would serve one body for another.
      let distinct = map_keys(map_of_entries(map(keys, |k: KeyRow| { key: k.key, value: () })));
      assert_eq(len(distinct), len(keys));
    },
  }
}

test "a root is pure only as a definition with no row and no constraint" {
  let src = b"effect log { write emit(Bytes) -> Unit }\nfn origin() -> Int = 0\nfn hello() -> Unit / { log.write } = log.emit(b\"hi\")\nfn same<a>(x: a, y: a) -> Bool where derivable(eq, a) = x == y\nfn positive(n: Int) -> Int requires n > 0 = n\ntest \"t\" { assert_eq(origin(), 0) }\nlaw \"l\" forall (n: Int) { same(n, n) }";
  let d = dump_of(analyse(parse_all([{ name: b"m", src: src }])));
  assert_eq(map(d.emit_roots, |r: EmitRoot| { root: r.root, pure: r.pure }), [
    { root: b"m.origin", pure: true },
    { root: b"m.hello", pure: false },
    { root: b"m.same", pure: false },
    { root: b"m.positive", pure: true },
    { root: b"m.test#0", pure: false },
    { root: b"m.positive#requires#0", pure: false },
    { root: b"m.law#0.body", pure: false },
  ])
}

test "a root carries a width exactly where a value it is entered with or answers is one" {
  let src = b"fn low_bit(b: U8) -> Int requires int_of_u8(b) < 200 ensures result < 2 = int_of_u8(b & 1u8)\nfn narrow(n: Int) -> U8 / {abort.raise} requires n >= 0 ensures int_of_u8(result) == n = u8_of_int(n)\nfn inc(x: Int) -> Int requires x > 0 ensures result > x = x + 1\ntest \"t\" { assert_eq(inc(1), 2) }\nlaw \"low\" forall (b: U8) where int_of_u8(b) > 0 { low_bit(b) < 2 }\nlaw \"grows\" forall (x: Int) where x > 0 { inc(x) > x }";
  let d = dump_of(analyse(parse_all([{ name: b"m", src: src }])));
  assert_eq(
    map(d.emit_roots, |r: EmitRoot| { root: r.root, params: r.params, answer: r.answer }),
    [
      { root: b"m.low_bit", params: [CWidth(0)], answer: CPlain },
      { root: b"m.narrow", params: [CPlain], answer: CWidth(0) },
      { root: b"m.inc", params: [CPlain], answer: CPlain },
      { root: b"m.test#0", params: [], answer: CPlain },
      { root: b"m.low_bit#requires#0", params: [CWidth(0)], answer: CPlain },
      { root: b"m.low_bit#ensures#0", params: [CWidth(0), CPlain], answer: CPlain },
      { root: b"m.narrow#requires#0", params: [CPlain], answer: CPlain },
      { root: b"m.narrow#ensures#0", params: [CPlain, CWidth(0)], answer: CPlain },
      { root: b"m.inc#requires#0", params: [CPlain], answer: CPlain },
      { root: b"m.inc#ensures#0", params: [CPlain, CPlain], answer: CPlain },
      { root: b"m.law#0.guard", params: [CWidth(0)], answer: CPlain },
      { root: b"m.law#0.body", params: [CWidth(0)], answer: CPlain },
      { root: b"m.law#1.guard", params: [CPlain], answer: CPlain },
      { root: b"m.law#1.body", params: [CPlain], answer: CPlain },
    ],
  )
}

test "a carry follows a width into lists, maps, records, sum types, functions and variables" {
  let src = b"effect probe { write put(xs: List<U8>, n: Int) -> Unit }\ntype Byte = | Byte(U8)\ntype Tree = | Leaf | Node(Tree, I16, Tree)\ntype Pair<a, b> = | Pair(b, a)\ntype Color = | Red | Green\nfn wrap(xs: List<U8>) -> List<Byte> = map(xs, |x: U8| Byte(x))\nfn pick<a>(xs: List<a>, r: { v: I16, n: Int }) -> Option<a> = match xs { [x, ..] -> Some(x), _ -> None }\nfn swap(m: Map<String, I8>) -> Pair<Int, U64> / {abort.raise} = Pair(u64_of_int(1), 0)\nfn plain(c: Color, o: Option<Int>) -> Tree = Leaf\nfn apply<a>(f: (Int) -> a, x: Int) -> a = f(x)\nfn sent(xs: List<U8>) -> Unit / { probe.write } = probe.put(xs, 1)";
  let d = dump_of(analyse(parse_all([{ name: b"m", src: src }])));
  assert_eq(
    map(d.emit_roots, |r: EmitRoot| { root: r.root, params: r.params, answer: r.answer }),
    [
      { root: b"m.wrap", params: [CList(CWidth(0))], answer: CList(CSum([])) },
      {
        root: b"m.pick",
        params: [
          CList(CVar(0)),
          CRecord([{ name: b"n", carry: CPlain }, { name: b"v", carry: CWidth(5) }]),
        ],
        answer: CSum([CVar(0)]),
      },
      { root: b"m.swap", params: [CMap(CPlain, CWidth(4))], answer: CSum([CPlain, CWidth(3)]) },
      // A sum type that holds no width at these parameters reads as it is; one that holds a width
      // through itself does whatever its parameters.
      { root: b"m.plain", params: [CPlain, CPlain], answer: CSum([]) },
      { root: b"m.apply", params: [CFn([CPlain], CVar(0)), CPlain], answer: CVar(0) },
      { root: b"m.sent", params: [CList(CWidth(0))], answer: CPlain },
    ],
  );
  assert_eq(map(effect_named(d, b"m.probe").ops, |o: OpRow| o.carries), [
    [CList(CWidth(0)), CPlain],
  ]);
  let own = filter(d.emit_ctors, |k: EmitCtor| bytes_slice(k.name, 0, 2) == b"m.");
  assert_eq(map(own, |k: EmitCtor| { name: k.name, fields: k.fields }), [
    { name: b"m.Byte", fields: [CWidth(0)] },
    { name: b"m.Leaf", fields: [] },
    { name: b"m.Node", fields: [CSum([]), CWidth(5), CSum([])] },
    { name: b"m.Pair", fields: [CVar(1), CVar(0)] },
    { name: b"m.Red", fields: [] },
    { name: b"m.Green", fields: [] },
  ]);
  let some = filter(d.emit_ctors, |k: EmitCtor| k.name == b"Some");
  assert_eq(map(some, |k: EmitCtor| k.fields), [[CVar(0)]])
}

test "a program's answer holds its warnings, its order, its packages and its modules" {
  let d = dump_of(analyse(parse_all(program())));
  assert_eq(d.diags, [
    {
      code: b"W0611",
      notes: 0,
      labels: [{ module: 0, start: 46, end: 51, primary: true, text: b"never used" }],
      text: b"",
      message: b"type `m.Shape` is never used",
      notes_text: [],
      severity: b"warning",
      fixes: [],
    },
  ]);
  assert_eq(d.order, [b"m"]);
  assert_eq(d.packages, [
    { prefix: b"", deps: [] },
    { prefix: b"std", deps: [] },
    { prefix: b"compiler", deps: [b"std"] },
  ]);
  assert_eq(d.mod_pkg, [0]);
  assert_eq(d.modules, [
    {
      name: b"m",
      index: 0,
      items: [b"m.log", b"m.Shape", b"m.Dot", b"m.Line", b"m.say"],
      imports: [],
      sets: [],
      // `say`'s body and the whole test, which a stub of the module blanks.
      cuts: [{ start: 115, end: 126, braced: true }, { start: 127, end: 152, braced: false }],
    },
  ])
}

fn reachable() -> List<Source> =
  [
    {
      name: b"m",
      src: b"pub fn api() -> Int = shared()\nfn shared() -> Int = 1\nfn dead() -> Int = deader()\nfn deader() -> Int = 2\nfn tested() -> Int = 3\nfn lawful(x: Int) -> Int = x\nfn positive(x: Int) -> Bool = x > 0\npub fn checked(x: Int) -> Int requires positive(x) = x\ntype Pair = { a: Int }\npub fn make() -> Int = { let f = |x: Int| -> Pair { { a: x } }; f(1).a }\nfn _kept() -> Int = 4\nfn main() -> Int = 5\ntype Unused = | Nothing\ntest \"calls it\" { assert_eq(tested(), 3) }\nlaw \"it is the identity\" forall (x: Int) { lawful(x) == x }",
    },
  ]

test "only a definition no root reaches is warned, each once" {
  let d = dump_of(analyse(parse_all(reachable())));
  let said = map(d.diags, |x: Diag| x.message);
  assert(contains_bytes(said, b"fn `m.dead` is never used"));
  assert(contains_bytes(said, b"fn `m.deader` is never used"));
  assert(contains_bytes(said, b"type `m.Unused` is never used"));
  assert_eq(len(said), 3);
  assert(len(d.order) > 0)
}

test "a definition's row holds its scheme, footprint, parameters and span" {
  let say = def_named(dump_of(analyse(parse_all(program()))), b"m.say");
  assert_eq(say.module, b"m");
  assert_eq(say.simple_name, b"say");
  assert(!say.public && !say.reuse);
  assert_eq(scheme_text(say.scheme), b"(Bytes) -> Unit / {m.log.write}");
  assert_eq(atoms_text(say.footprint, b","), b"m.log.write");
  assert_eq(atoms_text(say.performed, b","), b"m.log.emit");
  assert_eq(say.params, [{ name: b"b", at: { module: 0, start: 79, end: 87 } }]);
  assert_eq(say.at, { module: 0, start: 72, end: 126 })
}

test "a test's row is placed by its index and carries its key" {
  assert_eq(dump_of(analyse(parse_all(program()))).tests, [
    {
      key: b"m.says",
      name: b"says",
      module: b"m",
      index: 0,
      nondet: false,
      footprint: [{ effect: b"m.log", resource: RSingleton, mode: MWrite, op: None }],
      at: { module: 0, start: 127, end: 152 },
      name_at: { module: 0, start: 132, end: 138 },
    },
  ])
}

fn effect_named(d: Dump, name: Bytes) -> EffectRow / {abort.raise} =
  match fold(d.effects, None, |acc: Option<EffectRow>, e: EffectRow|
      if e.name == name { Some(e) } else { acc }) {
    Some(e) -> e,
    None -> panic("the answer holds the effect"),
  }

test "an effect's row holds each operation with its mode, its types and its span" {
  let log = effect_named(dump_of(analyse(parse_all(program()))), b"m.log");
  assert_eq(log.module, b"m");
  assert_eq(log.simple_name, b"log");
  assert(!log.public && !log.nondet);
  assert_eq(log.ops, [
    {
      name: b"emit",
      mode: b"write",
      resource_param: false,
      params: [con_named(b"Bytes")],
      ret: con_named(b"Unit"),
      scheme: None,
      at: { module: 0, start: 13, end: 38 },
      carries: [CPlain],
    },
  ]);
  assert_eq(log.at, { module: 0, start: 0, end: 40 })
}

test "a prelude effect is placed outside every module and its operations carry a scheme" {
  let sim = effect_named(dump_of(analyse(parse_all(program()))), b"sim");
  assert_eq(sim.module, b"");
  assert(sim.public);
  assert_eq(sim.at, { module: no_module(), start: 0, end: 0 });
  assert_eq(map(sim.ops, |o: OpRow| o.name), [b"seed"]);
  let seed = at(sim.ops, 0);
  assert_eq(seed.mode, b"read");
  assert_eq(seed.params, []);
  assert_eq(seed.ret, con_named(b"Int"));
  assert_eq(match seed.scheme { Some(sc) -> scheme_text(sc), None -> b"" }, b"() -> Int");
  assert_eq(seed.at, { module: no_module(), start: 0, end: 0 })
}

test "a constructor's row holds its fields and its scheme" {
  let line = filter(dump_of(analyse(parse_all(program()))).ctors, |k: CtorRow| k.name == b"m.Line");
  assert_eq(line, [
    {
      name: b"m.Line",
      module: b"m",
      simple_name: b"Line",
      type_name: b"m.Shape",
      index: 1,
      arity: 1,
      fields: [con_named(b"Int")],
      scheme: {
        ty_vars: [],
        row_vars: [],
        label_vars: [],
        ty: TyFn({
          params: [con_named(b"Int")],
          ret: con_named(b"m.Shape"),
          effects: { atoms: [], tail: None },
        }),
      },
      at: { module: 0, start: 62, end: 71 },
    },
  ])
}

fn def_hash_named(d: Dump, name: Bytes) -> HashRow / {abort.raise} =
  match fold(d.hashes, None, |acc: Option<HashRow>, h: HashFrame|
      match h { HDef(r) -> if r.name == name { Some(r) } else { acc }, _ -> acc }) {
    Some(r) -> r,
    None -> panic("the answer hashes the definition"),
  }

fn body_named(d: Dump, name: Bytes) -> Bytes / {abort.raise} =
  match fold(d.bodies, None, |acc: Option<Bytes>, b: BodyRow|
      if b.name == name { Some(b.body) } else { acc }) {
    Some(b) -> b,
    None -> panic("the answer holds the body"),
  }

test "a hash row carries the definition's hash, its own form and its reach, and the body hashes to it" {
  let d = dump_of(analyse(parse_all(program())));
  let say = def_hash_named(d, b"m.say");
  assert(say.own != None);
  assert_eq(say.deps, [b"m.log"]);
  assert_eq(say.closure, [b"m.log", b"m.say"]);
  // The test's row follows the definition it reaches.
  let order = map(d.hashes, |h: HashFrame|
    match h { HDef(r) -> r.name, HTest(r) -> r.key, HLaw(r) -> r.key });
  let placed = fold(range(0, len(order)), 0 - 1, |acc: Int, j: Int|
    if at(order, j) == b"m.say" { j } else { acc });
  assert_eq(list_at(order, placed + 1), Some(b"m.says"));
  // A solo body is the kind byte and then exactly the bytes the definition's hash is taken over.
  let body = body_named(d, b"m.say");
  assert_eq(bytes_at(body, 0), 0);
  assert_eq(Some(hex(blake3(bytes_slice(body, 1, bytes_len(body))))), say.def)
}

test "the ordinals list every fn, test and law in source order" {
  assert_eq(dump_of(analyse(parse_all(program()))).ordinals, [
    { module: b"m", items: [b"fn m.say", b"test m.says"] },
  ])
}

fn specified() -> List<Source> =
  [
    {
      name: b"m",
      src: b"effect log { write emit(Bytes) -> Unit }\neffect set Io = {log.write}\nfn say(b: Bytes) -> Unit / {Io} = log.emit(b)\nfn inc(x: Int) -> Int requires x > 0 ensures result > x = x + 1\nlaw \"inc grows\" forall (x: Int) where x > 0 { inc(x) > x }",
    },
  ]

test "a definition's row holds its row aliases and each clause with its kind, index and span" {
  let d = dump_of(analyse(parse_all(specified())));
  let say = def_named(d, b"m.say");
  assert_eq(say.row_aliases, [b"Io"]);
  assert_eq(say.params, [{ name: b"b", at: { module: 0, start: 76, end: 84 } }]);
  assert_eq(say.at, { module: 0, start: 69, end: 114 });
  let inc = def_named(d, b"m.inc");
  assert_eq(scheme_text(inc.scheme), b"(Int) -> Int");
  assert_eq(inc.footprint, []);
  assert_eq(inc.params, [{ name: b"x", at: { module: 0, start: 122, end: 128 } }]);
  assert_eq(inc.spec, [
    { kind: b"requires", index: 0, footprint: [], at: { module: 0, start: 137, end: 151 } },
    { kind: b"ensures", index: 1, footprint: [], at: { module: 0, start: 152, end: 170 } },
  ]);
  assert_eq(inc.at, { module: 0, start: 115, end: 178 });
  assert_eq(inc.literals, [b"int 0"]);
  assert_eq(d.ordinals, [
    { module: b"m", items: [b"fn m.say", b"fn m.inc requires,ensures", b"law m.inc grows"] },
  ])
}

// One program with both definitions' rows written as `row`, and the set they may name declared.
fn rows_written_as(row: Bytes) -> List<Source> =
  [
    {
      name: b"m",
      src: bytes_concat_all([
        b"pub effect log { write emit(Bytes) -> Unit }\neffect set Io = {log.write}\n",
        b"pub fn say(b: Bytes) -> Unit / {",
        row,
        b"} = log.emit(b)\npub fn twice(b: Bytes) -> Unit / {",
        row,
        b"} = {\n  say(b);\n  say(b)\n}\n",
      ]),
    },
  ]

fn def_hashes(d: Dump) -> List<{ name: Bytes, def: Option<Bytes> }> =
  fold(d.hashes, [], |acc: List<{ name: Bytes, def: Option<Bytes> }>, f: HashFrame|
    match f { HDef(r) -> push(acc, { name: r.name, def: r.def }), _ -> acc })

// A row alias is spelling: only the provenance a reader is shown says which spelling was written.
test "a row alias and its expansion are one program: the same hashes, bodies and rows" {
  let aliased = rows_written_as(b"Io");
  let expanded = rows_written_as(b"log.write");
  // The published rows, each under its definition's hash.
  assert_eq(rows_of(whole_of(aliased)), rows_of(whole_of(expanded)));
  let a = dump_of(analyse(parse_all(aliased)));
  let e = dump_of(analyse(parse_all(expanded)));
  assert_eq(def_hashes(a), def_hashes(e));
  assert(len(def_hashes(a)) >= 2);
  assert_eq(a.bodies, e.bodies);
  assert_eq(map(a.defs, |d: DefRow| d.row_aliases), [[b"Io"], [b"Io"]]);
  assert_eq(map(e.defs, |d: DefRow| d.row_aliases), [[], []])
}

fn written() -> List<Source> =
  [
    {
      name: b"m",
      src: b"pub type Pair<a, b> = { fst: a, snd: b }\npub effect log { write emit(Bytes) -> Unit }\npub reuse fn keep(xs: List<Int>) -> List<Int> = push(xs, 1)\nlaw \"bounds\" forall (n: Int) where n > -3 && n < 7 { n == n }",
    },
  ]

test "a definition's row holds its visibility, its reuse marker and its parameters as written" {
  let keep = def_named(dump_of(analyse(parse_all(written()))), b"m.keep");
  assert(keep.public && keep.reuse);
  assert_eq(keep.params, [{ name: b"xs", at: { module: 0, start: 104, end: 117 } }])
}

test "a type's row holds its arity and its visibility" {
  assert_eq(
    map(dump_of(analyse(parse_all(written()))).types, |t: TypeRow|
      { name: t.name, module: t.module, public: t.public, arity: t.arity }),
    [{ name: b"m.Pair", module: b"m", public: true, arity: 2 }],
  )
}

test "a guard's literals are in the search's order, a negation folded" {
  assert_eq(map(dump_of(analyse(parse_all(written()))).laws, |l: LawRow| l.literals), [
    [b"int 7", b"int -3", b"int 3"],
  ])
}

test "a law's row holds its binders with their spans and types, and its hashes carry the sentence" {
  let d = dump_of(analyse(parse_all(specified())));
  assert_eq(d.laws, [
    {
      key: b"m.inc grows",
      name: b"inc grows",
      module: b"m",
      index: 0,
      binders: [{ name: b"x", at: { module: 0, start: 203, end: 209 }, ty: con_named(b"Int") }],
      has_guard: true,
      host: false,
      cost: false,
      footprint: [],
      at: { module: 0, start: 179, end: 237 },
      literals: [b"int 0"],
    },
  ]);
  // An `effect set` with no includes.
  assert_eq(map(d.modules, |m: ModuleRow| m.sets), [
    [
      {
        name: b"Io",
        includes: [],
        atoms: [{ effect: b"m.log", resource: RSingleton, mode: MWrite, op: None }],
      },
    ],
  ]);
  let law = match fold(d.hashes, None, |acc: Option<ItemHashRow>, h: HashFrame|
      match h { HLaw(r) -> Some(r), _ -> acc }) {
    Some(r) -> r,
    None -> panic("the law is hashed"),
  };
  assert_eq(law.key, b"m.inc grows");
  assert_eq(bytes_len(law.hash), 64);
  assert_eq(bytes_len(law.text), 64);
  assert_eq(law.deps, [b"m.inc"]);
  assert_eq(law.closure, [b"m.inc", b"m.inc grows"]);
  // Two clauses: two obligation keys and two sentence keys, in source order.
  let inc = def_hash_named(d, b"m.inc");
  assert(inc.own != None);
  assert_eq(len(inc.specs), 2);
  assert_eq(len(inc.spec_texts), 2)
}

fn claimed() -> List<Source> =
  [
    { name: b"base", src: b"pub fn one() -> Int = 1\npub type Coin = | Heads | Tails" },
    {
      name: b"app",
      src: b"import base\nfn two(x: Int) -> Option<Int> requires x > 0 = Some(base::one() + len([x]))\nlaw \"it grows\" forall (x: Int) where x > 0 { two(x) != None }",
    },
  ]

fn code_text(c: Option<Code>) -> Bytes / {abort.raise} = match c { Some(x) -> dump(x), None -> b"" }

test "a claim is lowered with each global named program-wide, and a builtin and a prelude constructor as written" {
  let out = claims(claimed());
  assert_eq(len(out), 4);
  match at(out, 0) {
    ClaimDef(d) -> {
      assert_eq(d.name, b"base.one");
      assert_eq(d.params, 0);
      assert_eq(code_text(d.body), b"blit(i1)");
      assert_eq(d.spec, [])
    },
    _ -> assert(false),
  };
  assert_eq(at(out, 1), ClaimSum({ name: b"base.Coin", variants: 2 }));
  match at(out, 2) {
    ClaimDef(d) -> {
      assert_eq(d.name, b"app.two");
      assert_eq(d.params, 1);
      assert_eq(
        code_text(d.body),
        b"bapp(bvar(Some,-),bbin(add,bapp(bvar(base.one,-)),bapp(bvar(len,-),blist(ovar(x,0),))))",
      );
      assert_eq(map(d.spec, |c: ClaimClause| c.kind), [SRequires]);
      let c = at(d.spec, 0).clause;
      assert_eq(c.at, { module: 1, start: 51, end: 56 });
      assert_eq(code_text(c.code), b"bbin(gt,ovar(x,0),blit(i0))")
    },
    _ -> assert(false),
  };
  match at(out, 3) {
    ClaimLaw(l) -> {
      assert_eq(l.key, b"app.it grows");
      assert(l.guard != None);
      assert_eq(code_text(l.body), b"bblock(bbin(ne,bapp(bvar(app.two,-),ovar(x,0)),bvar(None,-)))")
    },
    _ -> assert(false),
  }
}

test "a record update reaches a claim as the literal it stands for" {
  let out = claims([
    { name: b"m", src: b"pub type P = { a: Int, b: Int }\npub fn bump(p: P) -> P = {..p, b: 3}" },
  ]);
  assert_eq(len(out), 1);
  match at(out, 0) {
    ClaimDef(d) -> assert(bytes_index_of(code_text(d.body), b"upd(") != None),
    _ -> assert(false),
  }
}

test "claims lowered from an analysis are the claims lowered from its sources" {
  let sources = [
    {
      name: b"base",
      src: b"pub type P = { a: Int, b: Int }\npub fn bump(p: P) -> P ensures result.b == 3 = {..p, b: 3}\npub fn same(p: P) -> P = p\npub effect tally { write add[r](n: Int) -> Unit }\npub fn add_twice<[r]>(n: Int) -> Unit / {tally.add[r]} = { tally.add[r](n); tally.add[r](n) }\npub fn keyed<a>(k: a) -> Map<a, Int> where derivable(ord, a) = map_insert(map_new(), k, 1)\n",
    },
    {
      name: b"app",
      src: b"import base\nfn moved(p: base::P) -> Int requires {..p, a: 1}.a == 1 = base::same(p).a\nfn counted() -> Map<Int, Int> / {base::tally.add[c]} = { base::add_twice[c](2); {..base::bump({ a: 0, b: 0 }), a: 1}.a; base::keyed(4) }\nlaw \"bumped\" forall (p: base::P) { base::bump(p) == {..p, b: 3} }\ntest \"updated\" { assert_eq({..base::same({ a: 1, b: 2 }), a: 5}.a, 5) }\n",
    },
  ];
  let w = whole_of(sources);
  assert_eq(claims_in(w, range(0, len(w.mods))), claims(sources))
}

test "a builtin is published with its scheme and the names its parameters are documented under" {
  let rows = filter(builtin_rows(), |r: BuiltinRow| r.name == b"push");
  assert_eq(len(rows), 1);
  assert_eq(at(rows, 0).params, [b"xs", b"x"]);
  match at(rows, 0).scheme.ty { TyFn(f) -> assert_eq(len(f.params), 2), _ -> assert(false) }
}

fn shelf() -> List<Source> =
  [
    { name: b"std.a", src: b"import std.c\npub fn a() -> Int = 1" },
    { name: b"std.b", src: b"pub fn b() -> Int = 2" },
    { name: b"std.c", src: b"pub fn c() -> Int = 3" },
    { name: b"std.d", src: b"pub fn d() -> Int = 4" },
  ]

test "the shipped modules a program imports follow it a round at a time, each round in byte order" {
  let a = answer_pulling_std_with(
    [{ name: b"m", src: b"import std.b\nimport std.a\npub fn f() -> Int = 1" }],
    shelf(),
    [],
    [],
  );
  assert_eq(a.pulled, [b"std.a", b"std.b", b"std.c"]);
  assert_eq(a.dump.diags, []);
  assert(len(a.dump.order) > 0)
}

test "an import of a module that does not ship is reported at the import, listing the ones that do" {
  let a = answer_pulling_std_with(
    [{ name: b"m", src: b"import std.e\npub fn f() -> Int = 1" }],
    shelf(),
    [],
    [],
  );
  assert_eq(a.pulled, []);
  assert_eq(a.dump.diags, [
    {
      code: b"E0106",
      notes: 2,
      labels: [{ module: 0, start: 7, end: 12, primary: true, text: b"not found" }],
      text: b"",
      message: b"no module named `std.e` ships with this compiler",
      notes_text: [
        b"the stdlib holds: `std.a`, `std.b`, `std.c`, `std.d`",
        b"`ply std` lists them with the digest this binary was built from",
      ],
      severity: b"error",
      fixes: [],
    },
  ])
}

fn compiler_shelf() -> List<Source> =
  [
    { name: b"compiler.a", src: b"import compiler.b (second)\npub fn first() -> Int = second()" },
    { name: b"compiler.b", src: b"pub fn second() -> Int = 1" },
  ]

test "a compiler module the shelf carries is pulled in under the shelf's root" {
  let a = answer_pulling_std_with(
    [{ name: b"m", src: b"import compiler.a (first)\npub fn f() -> Int = first()" }],
    compiler_shelf(),
    [],
    [],
  );
  assert_eq(a.pulled, [b"compiler.a", b"compiler.b"]);
  assert_eq(a.dump.diags, []);
  assert_eq(len(filter(a.dump.defs, |r: DefRow| r.name == b"compiler.a.first")), 1)
}

fn messages(d: Dump) -> List<Bytes> = map(d.diags, |x: Diag| x.message)

test "a shelved module importing outside the shelf is the compiler's own defect" {
  let a = answer_pulling_std_with(
    [{ name: b"m", src: b"import compiler.a (first)\npub fn f() -> Int = first()" }],
    [{ name: b"compiler.a", src: b"import std.e (e)\npub fn first() -> Int = e()" }],
    [],
    [],
  );
  assert(
    contains_bytes(
      messages(a.dump),
      b"the shipped module `compiler.a` imports `std.e`, which this build does not ship",
    ),
  )
}

test "a shipped module importing outside the shipped ones is placed in that module, which the answer names" {
  let a = answer_pulling_std_with(
    [{ name: b"m", src: b"import std.x\npub fn f() -> Int = 1" }],
    [{ name: b"std.x", src: b"import m\npub fn x() -> Int = 1" }],
    [],
    [],
  );
  assert_eq(a.pulled, [b"std.x"]);
  let said = filter(a.dump.diags, |d: Diag|
    d.message == b"the shipped module `std.x` imports `m`, which this build does not ship");
  assert_eq(map(said, |d: Diag| d.labels), [
    [
      {
        module: 1,
        start: 7,
        end: 8,
        primary: true,
        text: b"a stdlib module may import only modules that ship with it",
      },
    ],
  ])
}

fn answered() -> List<Source> =
  [
    {
      name: b"base",
      src: b"pub effect log { write emit(Bytes) -> Unit }\npub type Shape = | Dot | Line(Int)\npub fn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\npub fn same(x: Int) -> Int = x",
    },
    { name: b"app", src: b"import base\nimport std.b\npub fn two() -> Int = base::same(2)" },
  ]

fn def_named(d: Dump, name: Bytes) -> DefRow / {abort.raise} =
  match fold(d.defs, None, |acc: Option<DefRow>, r: DefRow|
      if r.name == name { Some(r) } else { acc }) {
    Some(r) -> r,
    None -> panic("the dump holds the definition"),
  }

fn con_named(name: Bytes) -> Type = TyCon({ name: name, args: [] })

test "the answer's rows hold each type and row as the checker's value" {
  let a = answer_pulling_std_with(answered(), shelf(), [], []);
  assert_eq(a.pulled, [b"std.b"]);
  let same = def_named(a.dump, b"base.same");
  assert_eq(same.scheme, {
    ty_vars: [],
    row_vars: [],
    label_vars: [],
    ty: TyFn({
      params: [con_named(b"Int")],
      ret: con_named(b"Int"),
      effects: { atoms: [], tail: None },
    }),
  });
  assert_eq(same.footprint, []);
  let write: Atom = { effect: b"base.log", resource: RSingleton, mode: MWrite, op: None };
  let say = def_named(a.dump, b"base.say");
  assert_eq(
    say.scheme.ty,
    TyFn({
      params: [con_named(b"Bytes")],
      ret: con_named(b"Unit"),
      effects: { atoms: [write], tail: None },
    }),
  );
  assert_eq(say.footprint, [write]);
  assert_eq(
    map(filter(a.dump.ctors, |k: CtorRow| k.name == b"base.Line"), |k: CtorRow| k.fields),
    [[con_named(b"Int")]],
  )
}

test "a refused program's answer is its diagnostics, placed where it went wrong, with no rows" {
  let bad = [{ name: b"m", src: b"fn f() -> Int = \"x\"" }];
  let a = answer_pulling_std_with(bad, [], [], []);
  assert_eq(a.pulled, []);
  assert_eq(a.dump.diags, [
    {
      code: b"E0201",
      notes: 0,
      labels: [
        { module: 0, start: 16, end: 19, primary: true, text: b"expected `Int`, found `String`" },
      ],
      text: b"",
      message: b"type mismatch: function body type",
      notes_text: [],
      severity: b"error",
      fixes: [],
    },
  ]);
  assert_eq(a.dump.order, []);
  assert_eq(a.dump.modules, []);
  assert_eq(a.dump.defs, []);
  assert_eq(a.dump.tests, []);
  assert_eq(a.dump.hashes, [])
}

fn whole_of(sources: List<Source>) -> Whole / {abort.raise} =
  match analyse(parse_all(sources)) { Refused(_) -> panic("the program checks"), Analysed(w) -> w }

fn seeded_of(a: Analysis) -> List<Bytes> / {abort.raise} =
  match a { Refused(_) -> panic("the program checks"), Analysed(w) -> w.checked.seeded }

fn effectful() -> List<Source> =
  [
    {
      name: b"base",
      src: b"pub effect log { write emit(Bytes) -> Unit }\npub fn say(b: Bytes) -> Unit / { log.write } = log.emit(b)",
    },
    {
      name: b"app",
      src: b"import base\nfn twice(b: Bytes) -> Unit / {base::log.write} = base::say(b)\ntest \"says\" { twice(b\"x\") }",
    },
  ]

// The rows an analysis publishes, which number their variables as their texts name them: a seeded
// row and a walked one are then alike, however the checker numbered each.
// What a load answers, all but what its check walked: a seeded load walks less by design.
fn published(a: Analysis) -> Dump / {abort.raise} = { ..dump_of(a), walked: b"" }

// The same definition, with a module of generics checked ahead of it in one of the two programs:
// the checker numbers its variables apart in the two, and the rows do not.
test "two programs alike but for what the checker numbered first publish equal rows" {
  let pick = b"pub fn pick<p, q>(x: p, y: q, f: (p) -> q) -> List<q> = [f(x), y]";
  let alone = [{ name: b"m", src: pick }];
  let behind = [
    { name: b"a", src: b"pub fn first<c, d, e>(x: c, y: d, z: e) -> c = x" },
    { name: b"m", src: pick },
  ];
  let raw = |sources: List<Source>|
    fold(whole_of(sources).checked.defs, None, |acc: Option<Scheme>, d: DefInfo|
      if d.name == b"m.pick" { Some(d.scheme) } else { acc });
  assert(raw(alone) != raw(behind));
  let one = def_named(published(analyse(parse_all(alone))), b"m.pick");
  let two = def_named(published(analyse(parse_all(behind))), b"m.pick");
  assert_eq(one.scheme, two.scheme);
  assert_eq(one.footprint, two.footprint);
  assert_eq(one.scheme.ty_vars, [0, 1])
}

test "a definition whose hash has not moved is published from its rows, not from its body" {
  let rows = rows_of(whole_of(effectful()));
  assert(len(rows.defs) > 0);
  assert(len(rows.tests) > 0);
  let seeded = analyse_with(parse_all(effectful()), rows.defs, rows.tests);
  assert_eq(seeded_of(seeded), [b"base.say", b"app.twice"]);
  assert_eq(published(seeded), published(analyse(parse_all(effectful()))));
  assert_eq(seeded_of(analyse(parse_all(effectful()))), [])
}

test "rows filed under a hash this program no longer has are walked instead" {
  let rows = rows_of(whole_of(effectful()));
  let stale = map(rows.defs, |r: KnownDefRow|
    { ..r, hash: b"moved", footprint: b"nowhere.read", performed: b"nowhere.read" });
  let walked = analyse_with(parse_all(effectful()), stale, []);
  assert_eq(seeded_of(walked), []);
  assert_eq(published(walked), published(analyse(parse_all(effectful()))))
}

// The same program with the effect under another name. An effect is nominal, so `say` and `twice`
// hash differently here and their filed rows — which name the old effect — are not rows about this.
fn renamed() -> List<Source> =
  [
    {
      name: b"base",
      src: b"pub effect trace { write emit(Bytes) -> Unit }\npub fn say(b: Bytes) -> Unit / { trace.write } = trace.emit(b)",
    },
    {
      name: b"app",
      src: b"import base\nfn twice(b: Bytes) -> Unit / {base::trace.write} = base::say(b)\ntest \"says\" { twice(b\"x\") }",
    },
  ]

fn test_footprint_of(a: Analysis, key: Bytes) -> Bytes / {abort.raise} =
  match a {
    Refused(_) -> b"<refused>",
    Analysed(w) ->
      fold(w.checked.tests, b"", |acc: Bytes, t: TestInfo|
        if t.key == key { atoms_text(t.footprint, b",") } else { acc }),
  }

test "a row filed before an effect was renamed is not a row about this program" {
  let rows = rows_of(whole_of(effectful()));
  assert(fold(rows.defs, false, |acc: Bool, r: KnownDefRow| acc || len(r.witness) > 0));
  assert(fold(rows.tests, false, |acc: Bool, r: KnownTestRow| acc || len(r.witness) > 0));
  let seeded = analyse_with(parse_all(renamed()), rows.defs, rows.tests);
  // A test's row names its effects as a definition's does, and goes stale with them.
  assert_eq(test_footprint_of(seeded, b"app.says"), b"base.trace.write");
  assert_eq(published(seeded), published(analyse(parse_all(renamed()))))
}

// A read operation and a write one, so a row that forgot an operation's mode would say so.
fn moded() -> List<Source> =
  [
    {
      name: b"m",
      src: b"pub effect store { read peek[t]() -> Int  write put[t](n: Int) -> Unit }\ntest \"reads\" { handle { assert_eq(store.peek[a](), 1) } with { store.peek[a]() -> 1 } }\ntest \"touches\" { let n = store.peek[b](); store.put[b](n) }",
    },
  ]

test "a test's row read back from the cache has each operation's mode as its declaration gives it" {
  let cold = whole_of(moded());
  let rows = rows_of(cold);
  match analyse_with(parse_all(moded()), rows.defs, rows.tests) {
    Refused(_) -> panic("the seeded program checks"),
    Analysed(warm) ->
      assert_eq(
        map(warm.checked.tests, |t: TestInfo| t.footprint),
        map(cold.checked.tests, |t: TestInfo| t.footprint),
      ),
  }
}

fn held(m: Map<Bytes, Bytes>, name: Bytes) -> Bytes =
  match map_get(m, name) { Some(h) -> h, None -> b"" }

fn footprint_of(a: Analysis, name: Bytes) -> Bytes / {abort.raise} =
  match a {
    Refused(_) -> b"<refused>",
    Analysed(w) ->
      fold(w.checked.defs, b"", |acc: Bytes, d: DefInfo|
        if d.name == name { atoms_text(d.footprint, b",") } else { acc }),
  }

fn performed_of(a: Analysis, name: Bytes) -> Bytes / {abort.raise} =
  match a {
    Refused(_) -> b"<refused>",
    Analysed(w) ->
      fold(w.checked.defs, b"", |acc: Bytes, d: DefInfo|
        if d.name == name { atoms_text(d.performed, b",") } else { acc }),
  }

// `say` writes its row and `quiet` writes none, so neither row handed in unifies and the
// other cannot, in one program and one run.
fn two_effects() -> List<Source> =
  [
    {
      name: b"m",
      src: b"pub effect log { write put() -> Unit }\npub effect other { write put() -> Unit }\npub fn say() -> Unit / {log.write} = log.put()\npub fn quiet(x: Int) -> Int = x",
    },
  ]

// Both rows are hashed and witnessed as the driver files them, and both name the wrong effect.
fn wrong_rows(sources: List<Source>) -> List<KnownDefRow> / {abort.raise} =
  match analyse(parse_all(sources)) {
    Refused(_) -> panic("the program checks"),
    Analysed(w) -> {
      let defs = by_name_one(w.hashes.defs);
      let witness = [{ name: b"m.other", hash: held(by_name_one(w.hashes.decls), b"m.other") }];
      map([b"m.say", b"m.quiet"], |n: Bytes|
        {
          name: n,
          hash: held(defs, n),
          witness: witness,
          footprint: b"m.other.write",
          performed: b"m.other.write",
          scaling: b"",
          repeats: [],
        })
    },
  }

test "a row that will not unify walks the body rather than reporting" {
  let sources = two_effects();
  let seeded = analyse_with(parse_all(sources), wrong_rows(sources), []);
  // Both handed rows contradict what the signatures write, `quiet` writing no `/` and so the empty
  // row. Walking each is the whole answer.
  assert_eq(footprint_of(seeded, b"m.quiet"), b"");
  assert_eq(footprint_of(seeded, b"m.say"), b"m.log.write");
  assert_eq(footprint_of(seeded, b"m.say"), footprint_of(analyse(parse_all(sources)), b"m.say"));
  // A row that was walked past is not counted as one that seeded.
  assert_eq(seeded_of(seeded), [])
}

fn filed_tests(f: Filing) -> List<KnownTestRow> =
  fold(f.modules, [], |acc: List<KnownTestRow>, m: FiledModule|
    append(acc, map(m.tests, |t: FiledTest| t.row)))

fn has_test_row(rows: List<KnownTestRow>, r: KnownTestRow) -> Bool =
  fold(rows, false, |acc: Bool, x: KnownTestRow| acc || x == r)

test "a filing carries exactly the rows the analysis publishes" {
  let w = whole_of(effectful());
  let f = filing(w);
  let rows = rows_of(w);
  assert_eq(map(f.defs, |d: FiledDef| d.interface.row), rows.defs);
  assert_eq(map(f.defs, |d: FiledDef| d.name), map(rows.defs, |r: KnownDefRow| r.name));
  assert_eq(map(f.defs, |d: FiledDef| d.hash), map(rows.defs, |r: KnownDefRow| r.hash));
  assert_eq(len(filed_tests(f)), len(rows.tests));
  assert(
    fold(filed_tests(f), true, |acc: Bool, r: KnownTestRow| acc && has_test_row(rows.tests, r)),
  )
}

test "an analysis seeded from its own filing answers exactly what a fresh one does" {
  let f = filing(whole_of(effectful()));
  let defs = map(f.defs, |d: FiledDef| d.interface.row);
  let seeded = analyse_with(parse_all(effectful()), defs, filed_tests(f));
  assert_eq(len(seeded_of(seeded)), len(defs));
  assert_eq(published(seeded), published(analyse(parse_all(effectful()))));
  // The test is taken from its row too: the row carries the footprint the walk would find.
  assert_eq(test_footprint_of(seeded, b"app.says"), b"base.log.write")
}

// A performed row no body here performs, so a definition published from its row is told from a walked one.
fn probed(body: Bytes) -> List<Source> =
  [
    {
      name: b"base",
      src: bytes_concat_all([
        b"effect probe { read peek() -> Int }\npub fn poke() -> Int / {probe.read} = probe.peek()\npub fn one() -> Int = ",
        body,
        b"\npub fn two() -> Int = 2\npub fn three() -> Int = one() + 1\n",
      ]),
    },
    {
      name: b"app",
      src: b"import base\npub fn four() -> Int = base::one() + 3\npub fn five() -> Int = base::two() + 4\n",
    },
  ]

fn sentinel_rows(w: Whole) -> List<KnownDefRow> / {abort.raise} = {
  let probe = held(by_name_one(w.hashes.decls), b"base.probe");
  let written = fold(w.checked.defs, map_new(), |acc: Map<Bytes, Bytes>, d: DefInfo|
    map_insert(acc, d.name, atoms_text(d.footprint, b",")));
  map(w.hashes.defs, |x: { name: Bytes, hash: Bytes }|
    {
      name: x.name,
      hash: x.hash,
      witness: [{ name: b"base.probe", hash: probe }],
      footprint: held(written, x.name),
      performed: b"base.probe.read",
      scaling: b"",
      repeats: [],
    })
}

test "an edit walks the definitions that depend on it and no others" {
  let rows = sentinel_rows(whole_of(probed(b"1")));
  let kept = analyse_with(parse_all(probed(b"1")), rows, []);
  assert_eq(len(seeded_of(kept)), len(rows));
  assert_eq(performed_of(kept, b"base.one"), b"base.probe.read");
  // One body edited: `one` moves, and with it everything that reaches it, and nothing else.
  let after = analyse_with(parse_all(probed(b"11")), rows, []);
  let seeded = seeded_of(after);
  assert(contains_bytes(seeded, b"base.poke"));
  assert(contains_bytes(seeded, b"base.two"));
  assert(contains_bytes(seeded, b"app.five"));
  assert_eq(len(seeded), 3);
  assert_eq(performed_of(after, b"base.one"), b"");
  assert_eq(performed_of(after, b"base.three"), b"");
  assert_eq(performed_of(after, b"app.four"), b"");
  assert_eq(performed_of(after, b"app.five"), b"base.probe.read")
}

test "seeded from the last answer's filing, an edited program answers what a fresh check does" {
  let before = filing(whole_of(probed(b"1")));
  let rows = map(before.defs, |d: FiledDef| d.interface.row);
  let seeded = analyse_with(parse_all(probed(b"two() + 5")), rows, filed_tests(before));
  assert_eq(published(seeded), published(analyse(parse_all(probed(b"two() + 5")))));
  assert(len(seeded_of(seeded)) > 0)
}

fn performing(extra: List<Source>) -> List<Source> =
  append(extra, [
    { name: b"core", src: b"pub effect db {\n  read get[r](key: Int) -> Int\n}\n" },
    {
      name: b"shop",
      src: b"import core\npub fn touch(k: Int) -> Int / {core::db.read[cart]} = core::db.get[cart](k)\ntest \"touch is handled\" {\n  assert_eq(handle touch(1) with { core::db.get[cart](k) -> k + 1, }, 2)\n}\n",
    },
  ])

// A row names its effects by name, so a new declaration that looks like one must not be taken
// for it: the seeded answer stays the fresh one.
fn seeded_agrees(before: List<Source>, after: List<Source>) -> Bool / {abort.raise} = {
  let f = filing(whole_of(before));
  published(
      analyse_with(parse_all(after), map(f.defs, |d: FiledDef| d.interface.row), filed_tests(f)),
    )
    == published(analyse(parse_all(after)))
}

test "adding a look-alike effect keeps a seeded answer the fresh one" {
  let alike = [{ name: b"aaa", src: b"pub effect alpha {\n  read get[r](key: Int) -> Int\n}\n" }];
  assert(seeded_agrees(performing([]), performing([])));
  assert(seeded_agrees(performing([]), performing(alike)))
}

test "adding an unrelated effect keeps a seeded answer the fresh one" {
  let other = [{ name: b"aaa", src: b"pub effect alpha {\n  write put(key: Int) -> Int\n}\n" }];
  assert(seeded_agrees(performing([]), performing(other)))
}

fn declared() -> List<Source> =
  [
    {
      name: b"m",
      src: b"pub type Shape = | Circle(Int) | Empty\npub nondet effect wall { read now() -> Int\n write set[r](Int) -> Unit }\npub fn even(n: Int) -> Bool = if n == 0 { true } else { odd(n - 1) }\npub fn odd(n: Int) -> Bool = if n == 0 { false } else { even(n - 1) }\ntest \"two is even\" { assert(even(2)) }",
    },
  ]

fn entry_named(f: Filing, name: Bytes) -> FiledEntry / {abort.raise} = {
  let found = fold(f.modules, None, |acc: Option<FiledEntry>, m: FiledModule|
    fold(m.entries, acc, |a: Option<FiledEntry>, e: FiledEntry|
      if e.name == name { Some(e) } else { a }));
  match found { Some(e) -> e, None -> panic("no entry of that name") }
}

fn decl_named(f: Filing, name: Bytes) -> DeclInterface / {abort.raise} = {
  let found = fold(f.decls, None, |acc: Option<DeclInterface>, d: FiledDecl|
    if d.name == name { Some(d.interface) } else { acc });
  match found { Some(i) -> i, None -> panic("no declaration of that name") }
}

test "a module's entries name each item's kind, and a declaration's members in declaration order" {
  let f = filing(whole_of(declared()));
  assert_eq(map(f.modules, |m: FiledModule| m.name), [b"m"]);
  assert_eq(entry_named(f, b"m.even").kind, b"fn");
  assert_eq(entry_named(f, b"m.Shape").kind, b"type");
  assert_eq(map(entry_named(f, b"m.Shape").members, |x: FiledMember| x.name), [
    b"Circle",
    b"Empty",
  ]);
  assert_eq(entry_named(f, b"m.wall").kind, b"effect");
  assert_eq(map(entry_named(f, b"m.wall").members, |x: FiledMember| x.name), [b"now", b"set"]);
  let tests = fold(f.modules, [], |acc: List<FiledTest>, m: FiledModule| append(acc, m.tests));
  assert_eq(map(tests, |t: FiledTest| t.row.key), [b"m.two is even"]);
  let shape = decl_named(f, b"m.Shape");
  assert_eq(shape.arity, 0);
  assert_eq(shape.variants, [
    { name: b"Circle", fields: [b"Int"] },
    { name: b"Empty", fields: [] },
  ]);
  let wall = decl_named(f, b"m.wall");
  assert(wall.effect && wall.nondet);
  assert_eq(wall.ops, [
    { name: b"now", mode: b"read", resource: false, params: [], ret: b"Int" },
    { name: b"set", mode: b"write", resource: true, params: [b"Int"], ret: b"Unit" },
  ])
}

test "every body is filed under the hash it verifies as, a cycle's members included" {
  let w = whole_of(declared());
  let f = filing(w);
  assert(len(f.bodies) > 0);
  assert(fold(f.bodies, true, |acc: Bool, b: FiledBody| acc && body_key(b.body) == Some(b.hash)));
  // One body per hashed name: nothing here declares a name twice.
  assert_eq(len(f.bodies), len(w.hashes.defs) + len(w.hashes.decls));
  let even = held(by_name_one(w.hashes.defs), b"m.even");
  assert(fold(f.bodies, false, |acc: Bool, b: FiledBody| acc || b.hash == even))
}

// --- Seeding through a session of edits -----------------------------------------
// Each step is analysed from nothing and seeded with what the step before it filed: the two answers
// must be one answer, whatever the edit was. A step that does not check files nothing, so the next
// is seeded from the last that did.

type Step = { what: Bytes, sources: List<Source> }

type Session = { rows: Rows, off: List<Bytes> }

fn filed_rows(f: Filing) -> Rows =
  { defs: map(f.defs, |d: FiledDef| d.interface.row), tests: filed_tests(f) }

// The steps whose seeded answer is not the fresh one.
fn disagreements(steps: List<Step>) -> List<Bytes> / {abort.raise} = {
  let walked = fold(steps, { rows: { defs: [], tests: [] }, off: [] }, |s: Session, step: Step| {
    let seeded = analyse_with(parse_all(step.sources), s.rows.defs, s.rows.tests);
    let fresh = analyse(parse_all(step.sources));
    let off = if published(seeded) == published(fresh) { s.off } else { push(s.off, step.what) };
    match seeded {
      Refused(_) -> { rows: s.rows, off: off },
      Analysed(w) -> { rows: filed_rows(filing(w)), off: off },
    }
  });
  walked.off
}

fn step(what: Bytes, sources: List<Source>) -> Step = { what: what, sources: sources }

// Every occurrence of `from` in module `name`, as `to`.
fn edited(
  sources: List<Source>,
  name: Bytes,
  from: Bytes,
  to: Bytes,
) -> List<Source> / {abort.raise} =
  map(sources, |s: Source|
    if s.name != name { s } else if bytes_index_of(s.src, from) == None {
      panic("the fixture drifted: the text to edit is not there")
    } else { { name: s.name, src: joined(bytes_split(s.src, from), to) } })

fn with_module(sources: List<Source>, name: Bytes, src: Bytes) -> List<Source> =
  push(filter(sources, |s: Source| s.name != name), { name: name, src: src })

fn without(sources: List<Source>, name: Bytes) -> List<Source> =
  filter(sources, |s: Source| s.name != name)

fn shop_core() -> Bytes =
  b"pub type Money = Int\npub type Item =\n  | Book(String, Money)\n  | Note(String)\npub effect db {\n  read get[r](key: Int) -> Int\n  write put[r](key: Int, value: Int) -> Int\n}\npub fn price(i: Item) -> Money =\n  match i {\n    Book(_, p) -> p,\n    Note(_) -> 0,\n  }\npub fn twice<a>(x: a, f: (a) -> a) -> a = f(f(x))\npub fn label(i: Item) -> String =\n  match i {\n    Book(t, _) -> t,\n    Note(t) -> t,\n  }\ntest \"a note is free\" {\n  assert_eq(price(Note(\"n\")), 0)\n}\n"

fn shop_shop() -> Bytes =
  b"import core\nfn total(items: List<core::Item>) -> Int =\n  fold(items, 0, |acc, i: core::Item| acc + core::price(i))\nfn doubled(n: Int) -> Int = core::twice(n, |x: Int| x + x)\nfn stored(k: Int) -> Int / {core::db.read[cart]} = core::db.get[cart](k)\ntest \"a shelf adds up\" {\n  assert_eq(total([core::Book(\"b\", 3), core::Note(\"n\")]), 3)\n}\n"

fn shop_leaf() -> Bytes = b"pub fn one() -> Int = 1\npub fn two() -> Int = one() + one()\n"

fn shop() -> List<Source> =
  [
    { name: b"core", src: shop_core() },
    { name: b"shop", src: shop_shop() },
    { name: b"leaf", src: shop_leaf() },
  ]

test "a seeded answer is the fresh one through every kind of edit a session makes" {
  let s0 = shop();
  let s1 = edited(s0, b"leaf", b"one() + one()", b"one() + one() + 0");
  let s2 = edited(
    s1,
    b"leaf",
    b"pub fn two() -> Int = one() + one() + 0",
    b"pub fn two(k: Int) -> Int = one() + k",
  );
  let s3 = edited(s2, b"leaf", b"pub fn one()", b"fn one()");
  let broken = edited(s3, b"leaf", b"fn one() -> Int = 1", b"fn one() -> Int = \"1\"");
  let s4 = edited(s3, b"core", b"pub fn label(", b"pub fn title(");
  let s5 = edited(s4, b"core", b"Book(_, p) -> p,", b"Book(_, p) -> p + 0,");
  let s6 = edited(s5, b"shop", b"acc + core::price(i)", b"acc + core::price(i) + 0");
  let s7 = edited(s6, b"shop", b"import core\n", b"import core\nimport leaf\n");
  let s8 = with_module(s6, b"extra", b"import leaf\npub fn four() -> Int = leaf::two(2) + 2\n");
  let s9 = edited(s8, b"extra", b"+ 2\n", b"+ 3\n");
  let s10 = edited(s9, b"leaf", b"one() + k", b"one() + k + 0");
  let s11 = edited(
    edited(
      s10,
      b"leaf",
      b"fn one() -> Int = 1",
      b"import core\n\nfn one() -> Int = core::price(core::Note(\"n\")) + 1",
    ),
    b"core",
    b"Book(_, p) -> p + 0,",
    b"Book(_, p) -> p + 1,",
  );
  let s12 = without(s11, b"extra");
  let s13 = edited(s12, b"core", b"Money", b"Cost");
  let s14 = edited(
    edited(s13, b"core", b"effect db", b"effect ledger"),
    b"shop",
    b"core::db.",
    b"core::ledger.",
  );
  assert_eq(
    disagreements([
      step(b"cold", s0),
      step(b"unchanged", s0),
      step(b"a body edit in a leaf", s1),
      step(b"a signature edit in a leaf", s2),
      step(b"`pub` removed in a leaf", s3),
      step(b"a type error", broken),
      step(b"the error undone", s3),
      step(b"a rename in a module another imports", s4),
      step(b"a body edit in a module another imports", s5),
      step(b"a body edit in a module that imports another", s6),
      step(b"an import added", s7),
      step(b"an import removed", s6),
      step(b"a file added", s8),
      step(b"an edit to the added file", s9),
      step(b"an edit to the leaf the added file imports", s10),
      step(b"an import added to a module edited with the one it now imports", s11),
      step(b"the added file deleted", s12),
      step(b"a type renamed", s13),
      step(b"an effect renamed", s14),
      step(b"unchanged again", s14),
    ]),
    [],
  )
}

test "moving, removing and re-signing definitions leaves a seeded answer the fresh one" {
  let s0 = shop();
  let twice = b"pub fn twice<a>(x: a, f: (a) -> a) -> a = f(f(x))\n";
  let moved = edited(
    edited(
      edited(
        edited(s0, b"core", twice, b""),
        b"leaf",
        b"pub fn one()",
        bytes_concat(twice, b"pub fn one()"),
      ),
      b"shop",
      b"import core",
      b"import core\nimport leaf",
    ),
    b"shop",
    b"core::twice",
    b"leaf::twice",
  );
  let removed = edited(
    edited(s0, b"shop", b"fn doubled(n: Int) -> Int = core::twice(n, |x: Int| x + x)\n", b""),
    b"core",
    twice,
    b"",
  );
  let spare = with_module(s0, b"spare", b"pub fn spare() -> Int = 9\n");
  let referenced = with_module(s0, b"extra", b"import leaf\npub fn three() -> Int = leaf::two()\n");
  assert_eq(
    disagreements([
      step(b"cold", s0),
      step(b"a definition moved between modules", moved),
      step(b"back", s0),
      step(b"a definition removed outright", removed),
      step(b"back again", s0),
      step(
        b"a dependency's signature changed",
        edited(s0, b"core", b"pub fn price(i: Item) -> Money =", b"pub fn price(i: Item) -> Int ="),
      ),
      step(b"reformatted", edited(s0, b"leaf", b"pub fn one()", b"// a comment\npub fn  one()")),
      step(b"an unreferenced file", spare),
      step(b"deleted", s0),
      step(b"a file importing the leaf", referenced),
      step(b"the leaf deleted under it", without(referenced, b"leaf")),
      step(b"the leaf restored", referenced),
    ]),
    [],
  )
}

test "names shared, declarations alike and tests edited leave a seeded answer the fresh one" {
  let peel = b"pub type Thing = | Wrap(Int)\npub fn peel(t: Thing) -> Int = match t { Wrap(n) -> n }\n";
  let shared = [{ name: b"a", src: peel }, { name: b"b", src: peel }];
  let look = b"pub effect db { read get[r](key: Int) -> Int }\npub fn look(k: Int) -> Int / {db.read[t]} = db.get[t](k)\n";
  // The capability `pick` does not handle is the one its row writes.
  let pick = |m: Bytes|
    bytes_concat_all([
      b"import x\nimport y\npub fn pick(k: Int) -> Int / {",
      if m == b"x" { b"y" } else { b"x" },
      b"::db.read[t]} =\n  handle x::look(k) + y::look(k) with { ",
      m,
      b"::db.get[t](j) -> j, }\n",
    ]);
  let alike = [
    { name: b"x", src: look },
    { name: b"y", src: look },
    { name: b"z", src: b"pub fn plain() -> Int = 7\n" },
    { name: b"w", src: pick(b"x") },
  ];
  let alias = [
    { name: b"alias", src: b"pub type Cents = Int\npub fn zero() -> Cents = 0\n" },
    { name: b"user", src: b"import alias\nfn take() -> alias::Cents = alias::zero()\n" },
    { name: b"lone", src: b"fn lone() -> Int = 1\n" },
  ];
  let tested = b"fn f() -> Int = 1\ntest \"f is one\" { assert_eq(f(), 1) }\n";
  let palette = b"pub type Color = Red | Green\npub fn paint(what: String, shade: Color = Red) -> String =\n  match shade {\n    Red -> string_concat(what, \" red\"),\n    Green -> string_concat(what, \" green\"),\n  }\n";
  let wall = b"import palette\npub fn wall() -> String = palette::paint(\"wall\")\npub fn given() -> String = palette::paint(\"wall\", palette::Green)\ntest \"the default crosses the module boundary\" {\n  assert_eq(wall(), \"wall red\")\n}\n";
  let painted = [{ name: b"palette", src: palette }, { name: b"wall", src: wall }];
  assert_eq(
    disagreements([
      step(b"two definitions sharing a hash", shared),
      step(b"warm", shared),
      step(b"identically declared effects", alike),
      step(b"warm", alike),
      step(b"the handler switched to the other capability", with_module(alike, b"w", pick(b"y"))),
      step(
        b"an unrelated edit",
        with_module(with_module(alike, b"w", pick(b"y")), b"z", b"pub fn plain() -> Int = 8\n"),
      ),
      step(b"a type alias", alias),
      step(b"warm", alias),
      step(b"an unrelated edit", with_module(alias, b"lone", b"fn lone() -> Int = 2\n")),
      step(b"a test", [{ name: b"m", src: tested }]),
      step(b"a test added", [
        { name: b"m", src: bytes_concat(tested, b"test \"twice\" { assert_eq(f() + f(), 2) }\n") },
      ]),
      step(b"a test with a body already present", [
        { name: b"m", src: bytes_concat(tested, b"test \"still one\" { assert_eq(f(), 1) }\n") },
      ]),
      step(b"a cross-module default", painted),
      step(
        b"the default edited",
        edited(painted, b"palette", b"shade: Color = Red", b"shade: Color = Green"),
      ),
    ]),
    [],
  )
}

fn performer(module: Bytes) -> Bytes =
  bytes_concat_all([
    b"import ",
    module,
    b"\npub fn look(k: Int) -> Int / {",
    module,
    b"::db.read[t]} = ",
    module,
    b"::db.get[t](k)\ntest \"looks\" { handle { assert_eq(look(1), 0) } with { ",
    module,
    b"::db.get[t](k) -> 0 } }\n",
  ])

fn effect_decl() -> Bytes = b"pub effect db { read get[r](key: Int) -> Int }\n"

test "a structurally identical effect appearing, renamed or deleted leaves a seeded answer the fresh one" {
  let one = [{ name: b"x", src: effect_decl() }, { name: b"p", src: performer(b"x") }];
  let twins = [
    { name: b"a", src: effect_decl() },
    { name: b"x", src: effect_decl() },
    { name: b"p", src: performer(b"a") },
  ];
  let survivors = [
    { name: b"a", src: effect_decl() },
    { name: b"x", src: effect_decl() },
    { name: b"p", src: performer(b"x") },
  ];
  assert_eq(
    disagreements([
      step(b"cold", one),
      step(b"warm", one),
      step(b"an identical effect appeared", with_module(one, b"a", effect_decl())),
      step(b"twins", twins),
      step(
        b"the twin renamed to sort first",
        with_module(twins, b"x", b"pub effect audit { read get[r](key: Int) -> Int }\n"),
      ),
      step(b"survivors", survivors),
      step(b"the module that ranked first deleted", without(survivors, b"a")),
    ]),
    [],
  )
}

test "reordering, relabelling and re-exporting leave a seeded answer the fresh one" {
  let ops = |first: Bytes, second: Bytes|
    [
      {
        name: b"m",
        src: bytes_concat_all([
          b"pub effect db {\n  ",
          first,
          b"\n  ",
          second,
          b"\n}\npub fn f() -> Int = 1\n",
        ]),
      },
    ];
  let get = b"read get[r](key: Int) -> Int";
  let put = b"write put[r](key: Int, value: String) -> Unit";
  let variants = |body: Bytes| [{ name: b"m", src: bytes_concat(b"pub type T =\n", body) }];
  let labelled = |label: Bytes|
    [
      {
        name: b"m",
        src: bytes_concat_all([
          b"fn f() -> Int = 1\ntest \"",
          label,
          b"\" { assert_eq(f(), 1) }\n",
        ]),
      },
    ];
  let exported = [
    { name: b"a", src: b"pub fn one() -> Int = 1\n" },
    { name: b"b", src: b"import a\nfn two() -> Int = a::one() + a::one()\n" },
  ];
  assert_eq(
    disagreements([
      step(b"operations", ops(get, put)),
      step(b"the operations reordered", ops(put, get)),
      step(b"variants", variants(b"  | A(Int)\n  | B(String)\n")),
      step(b"the variants reordered", variants(b"  | B(String)\n  | A(Int)\n")),
      step(b"a test", labelled(b"f is one")),
      step(b"its label changed", labelled(b"f is really one")),
      step(b"and the run after that", labelled(b"f is really one")),
      step(b"an exported name", exported),
      step(b"its `pub` removed", with_module(exported, b"a", b"fn one() -> Int = 1\n")),
      step(
        b"a selective import",
        with_module(exported, b"b", b"import a (one)\nfn two() -> Int = one() + one()\n"),
      ),
      step(b"back to a module import", exported),
    ]),
    [],
  )
}

test "edits undone, modules renamed and files emptied leave a seeded answer the fresh one" {
  let s0 = shop();
  let leaf2 = b"pub fn one() -> Int = 1\npub fn two() -> Int = one() + 1\n";
  let aliased = edited(
    edited(s0, b"shop", b"import core", b"import core as c"),
    b"shop",
    b"core::",
    b"c::",
  );
  assert_eq(
    disagreements([
      step(b"cold", s0),
      step(b"a body edited", with_module(s0, b"leaf", leaf2)),
      step(b"and reverted", s0),
      step(
        b"a definition added",
        with_module(
          s0,
          b"leaf",
          bytes_concat(shop_leaf(), b"pub fn three() -> Int = two() + one()\n"),
        ),
      ),
      step(b"and deleted", s0),
      step(b"a module renamed", with_module(without(s0, b"leaf"), b"frond", shop_leaf())),
      step(b"and renamed back", s0),
      step(b"an imported module deleted", without(s0, b"core")),
      step(b"and restored", s0),
      step(b"a comment", with_module(s0, b"leaf", bytes_concat(b"// a note\n", shop_leaf()))),
      step(b"an import aliased", aliased),
      step(b"the alias removed", s0),
      step(b"an empty module", with_module(s0, b"empty", b"")),
      step(b"which gained a definition", with_module(s0, b"empty", b"pub fn now() -> Int = 1\n")),
      step(b"and went away", s0),
      step(b"a nested module beside a flat one", [
        { name: b"a", src: b"pub fn x() -> Int = 1\n" },
        { name: b"a.b", src: b"pub fn y() -> Int = 2\n" },
      ]),
      step(b"the nested module changed", [
        { name: b"a", src: b"pub fn x() -> Int = 1\n" },
        { name: b"a.b", src: b"pub fn y() -> Int = 3\n" },
      ]),
    ]),
    [],
  )
}

test "a shuffle of module states leaves a seeded answer the fresh one at every step" {
  let leaves = [
    shop_leaf(),
    bytes_concat(b"// reformatted\n\n", shop_leaf()),
    b"pub fn one() -> Int = 1\npub fn two() -> Int = one() + 1\n",
  ];
  let cores = [
    shop_core(),
    joined(bytes_split(shop_core(), b"Money"), b"Cost"),
    joined(bytes_split(shop_core(), b"pub fn label("), b"pub fn title("),
  ];
  let shops = [
    shop_shop(),
    joined(bytes_split(shop_shop(), b"import core\n"), b"import core\nimport leaf\n"),
    joined(bytes_split(shop_shop(), b"acc + core::price(i)"), b"acc + core::price(i) + 0"),
  ];
  // Each step sets one module to one of its states: which, and to what, cycles through every pair.
  let picks = [
    [0, 1],
    [1, 2],
    [2, 1],
    [0, 2],
    [1, 1],
    [2, 2],
    [0, 0],
    [1, 0],
    [2, 0],
    [0, 1],
    [1, 2],
    [0, 2],
  ];
  let states = fold(picks, [shop()], |acc: List<List<Source>>, p: List<Int>| {
    let now = at(acc, len(acc) - 1);
    let module = at(p, 0);
    let pick = at(p, 1);
    push(acc, if module == 0 { with_module(now, b"leaf", at(leaves, pick)) }
    else if module == 1 { with_module(now, b"core", at(cores, pick)) }
    else { with_module(now, b"shop", at(shops, pick)) })
  });
  assert_eq(disagreements(map(states, |s: List<Source>| step(b"a shuffle step", s))), [])
}

fn chain_lib(label: Bytes) -> Bytes =
  bytes_concat_all([
    b"pub effect log { write note[r](msg: String) -> Int }\npub fn base(n: Int) -> Int / {log.note[",
    label,
    b"]} = log.note[",
    label,
    b"](\"n\") + n\npub fn mid(n: Int) -> Int / {log.note[",
    label,
    b"]} = base(n) + 1\n",
  ])

test "a row that moves under a caller leaves a seeded answer the fresh one" {
  let before = [
    { name: b"lib", src: chain_lib(b"a") },
    {
      name: b"top",
      src: b"import lib\npub fn top(n: Int) -> Int / {lib::log.write[a]} = lib::mid(n) + 1\n",
    },
  ];
  let after = [
    { name: b"lib", src: chain_lib(b"b") },
    {
      name: b"top",
      src: b"import lib\npub fn top(n: Int) -> Int / {lib::log.write[b]} = lib::mid(n) + 2\n",
    },
  ];
  assert_eq(
    disagreements([step(b"cold", before), step(b"the row moved under a checked caller", after)]),
    [],
  );
  // A caller whose written row the moved one outgrows is refused, seeded as it is fresh.
  let stale = [
    { name: b"lib", src: chain_lib(b"a") },
    {
      name: b"top",
      src: b"import lib\npub fn top(n: Int) -> Int / {lib::log.note[a]} = lib::mid(n) + 1\n",
    },
  ];
  let moved = with_module(stale, b"lib", chain_lib(b"b"));
  assert_eq(disagreements([step(b"cold", stale), step(b"the callee's row moved", moved)]), []);
  let seeded = analyse_with(parse_all(moved), filed_rows(filing(whole_of(stale))).defs, []);
  assert(match seeded { Refused(_) -> true, Analysed(_) -> false })
}

test "an unused selectively imported name deleted is refused seeded as it is fresh" {
  let s0 = [
    { name: b"lib", src: b"pub fn used() -> Int = 1\npub fn spare() -> Int = 2\n" },
    { name: b"app", src: b"import lib (used, spare)\nfn go() -> Int = used()\n" },
  ];
  let gone = with_module(s0, b"lib", b"pub fn used() -> Int = 1\n");
  assert_eq(
    disagreements([step(b"cold", s0), step(b"warm", s0), step(b"the name deleted", gone)]),
    [],
  );
  match analyse_with(parse_all(gone), filed_rows(filing(whole_of(s0))).defs, []) {
    Analysed(_) -> panic("an import of a deleted name checked"),
    Refused(ds) -> assert(fold(ds, false, |acc: Bool, d: Diag| acc || d.code == b"E0101")),
  }
}

test "a narrowed annotation and a relabelled resource leave a seeded answer the fresh one" {
  let narrowing = |row: Bytes|
    [
      {
        name: b"m",
        src: bytes_concat_all([
          b"pub effect db { read get[r](key: Int) -> Int }\npub fn look(k: Int) -> Int / ",
          row,
          b" = db.get[a](k)\n",
        ]),
      },
    ];
  let labelled = |label: Bytes|
    [
      {
        name: b"m",
        src: bytes_concat_all([
          b"pub effect db { read get[r](key: Int) -> Int }\npub fn look(k: Int) -> Int / {db.read[",
          label,
          b"]} = db.get[",
          label,
          b"](k)\n",
        ]),
      },
      {
        name: b"u",
        src: bytes_concat_all([
          b"import m\nfn use_it() -> Int / {m::db.read[",
          label,
          b"]} = m::look(1)\n",
        ]),
      },
    ];
  let renamed = |ty: Bytes|
    [
      {
        name: b"a",
        src: bytes_concat_all([
          b"pub type ",
          ty,
          b" = | Mk(Int)\npub fn mk() -> ",
          ty,
          b" = Mk(1)\n",
        ]),
      },
      {
        name: b"b",
        src: bytes_concat_all([b"import a\npub fn get() -> a::", ty, b" = a::mk()\n"]),
      },
      { name: b"c", src: b"import b\npub fn top() -> Bool = { b::get(); true }\n" },
    ];
  assert_eq(
    disagreements([
      step(b"a wide annotation", narrowing(b"{db.read[a], db.read[b]}")),
      step(b"the annotation narrowed", narrowing(b"{db.read[a]}")),
      step(b"a resource", labelled(b"a")),
      step(b"the resource relabelled", labelled(b"z")),
      step(b"a type", renamed(b"T")),
      step(b"the type renamed two modules away", renamed(b"Renamed")),
    ]),
    [],
  )
}

test "the order an answer publishes in is the same seeded as fresh" {
  let s0 = [
    {
      name: b"app",
      src: b"import lib\npub effect audit { write note[log](m: Int) -> Unit }\npub type Wrapped = | Wrap(Int) | Empty\nfn second() -> Int = lib::base()\nfn first() -> Int = second()\n",
    },
    {
      name: b"lib",
      src: b"pub effect db { read get[t](k: Int) -> Int }\npub type Row = | Cell(Int)\npub fn base() -> Int = 1\n",
    },
  ];
  assert_eq(disagreements([step(b"cold", s0), step(b"warm", s0)]), [])
}

// Hashed without being checked, so a program that no longer compiles still has hashes to compare.
fn hash_of(sources: List<Source>, name: Bytes) -> Bytes / {abort.raise} =
  match resolve_modules(map(parse_all(sources), |p: Parsed| p.module)) {
    Failed(_) -> b"",
    Resolved_(x) -> match map_get(
        by_name_one(hash_index(build_index(x.mods, x.r).index).defs),
        name,
      ) {
      Some(h) -> h,
      None -> b"",
    },
  }

test "a map or a set literal and the call it builds are one definition" {
  let lit = [
    {
      name: b"m",
      src: b"pub fn two() -> Map<Int, Int> = #{1: 2, 3: 4}\npub fn s() -> Map<Int, Unit> = #[5]",
    },
  ];
  let call = [
    {
      name: b"m",
      src: b"pub fn two() -> Map<Int, Int> = map_of_entries([{key: 1, value: 2}, {key: 3, value: 4}])\npub fn s() -> Map<Int, Unit> = map_of_entries([{key: 5, value: ()}])",
    },
  ];
  assert(hash_of(lit, b"m.two") != b"");
  assert_eq(hash_of(lit, b"m.two"), hash_of(call, b"m.two"));
  assert_eq(hash_of(lit, b"m.s"), hash_of(call, b"m.s"))
}

test "a qualified name that is not exported moves the hash of everything that names it" {
  let caller = b"import a\npub fn two() -> Int = a::one()";
  let exported = [{ name: b"a", src: b"pub fn one() -> Int = 1" }, { name: b"b", src: caller }];
  let shut = [{ name: b"a", src: b"fn one() -> Int = 1" }, { name: b"b", src: caller }];
  assert(hash_of(exported, b"b.two") != b"");
  // `b.two` no longer compiles, so its hash must not say it still means what it meant while it did.
  assert(hash_of(shut, b"b.two") != hash_of(exported, b"b.two"));
  // `a.one` itself is untouched: `pub` is metadata its own encoding erases.
  assert_eq(hash_of(shut, b"a.one"), hash_of(exported, b"a.one"))
}

test "a project's manifest is checked ahead of the program and carried decoded" {
  let good = analyse_with(parse_all(program()), [], [], {
    root: b".",
    manifest: Some(
      b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"m\", version: {major: 0, minor: 1, patch: 0}, prefix: None, runtime: {major: 0, minor: 1, patch: 0}, dependencies: [], entry: None}",
    ),
    supplied: [],
  });
  match good {
    Refused(ds) -> assert_eq(map(ds, |d: Diag| d.code), []),
    Analysed(w) -> match w.manifest { None -> assert(false), Some(m) -> assert_eq(m.name, "m") },
  };
  let malformed = analyse_with(parse_all(program()), [], [], {
    root: b".",
    manifest: Some(b"fn package() -> Int = 1"),
    supplied: [],
  });
  match malformed {
    Analysed(_) -> assert(false),
    Refused(ds) -> {
      assert_eq(at(ds, 0).code, b"E0129");
      // One module of program text, so the manifest's label points one past it.
      assert_eq(at(at(ds, 0).labels, 0).module, 1)
    },
  };
  match analyse_with(parse_all(program()), [], []) {
    Refused(_) -> assert(false),
    Analysed(w) -> assert_eq(w.manifest, None),
  }
}

// A root package with one path dependency: `lib` grants its prefix, and its modules answer to
// `lib.<name>` for the root that declares it.
fn with_lib(user: List<Source>) -> Pkgs =
  {
    root: b"app",
    manifest: Some(
      b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"app\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [{name: \"lib\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Path(\"../lib\")}], entry: None}",
    ),
    supplied: [
      {
        root: b"lib",
        manifest: Some(
          b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"lib\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}",
        ),
        modules: [
          { name: b"answer", src: b"pub fn answer() -> Int = 42" },
          { name: b"extra", src: b"fn hidden() -> Int = 1" },
        ],
      },
    ],
  }

test "a declared dependency's modules answer under its prefix" {
  let user = [{ name: b"m", src: b"import lib.answer\nfn main() -> Int = answer::answer()" }];
  match analyse_with(parse_all(user), [], [], with_lib(user)) {
    Refused(ds) -> assert_eq(map(ds, |d: Diag| d.code), []),
    Analysed(_) -> assert(true),
  }
}

test "an undeclared dependency's modules refuse, naming holder and importer" {
  let user = [{ name: b"m", src: b"import lib.answer\nfn main() -> Int = answer::answer()" }];
  let pkgs = with_lib(user);
  let undeclared = analyse_with(parse_all(user), [], [], {
    root: b"app",
    manifest: Some(
      b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"app\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}",
    ),
    supplied: pkgs.supplied,
  });
  match undeclared {
    Analysed(_) -> assert(false),
    Refused(ds) -> assert_eq(at(ds, 0).code, b"E0132"),
  }
}

test "a dependency's own imports are siblings of its prefix, not of the root" {
  let user = [{ name: b"m", src: b"import lib.answer\nfn main() -> Int = answer::answer()" }];
  let pkgs = with_lib(user);
  let supplied = [
    {
      root: b"lib",
      manifest: at(pkgs.supplied, 0).manifest,
      modules: [
        { name: b"answer", src: b"import extra\npub fn answer() -> Int = extra::hidden()" },
        { name: b"extra", src: b"fn hidden() -> Int = 1" },
      ],
    },
  ];
  let clo = closure({ ..pkgs, supplied: supplied }, map(user, |s: Source| s.name));
  assert_eq(clo.diags, []);
  assert_eq(map(clo.modules, |m: { pkg: Int, src: Source }| m.src.name), [
    b"lib.answer",
    b"lib.extra",
  ])
}

test "a rehash resolves a dependency's own modules with the program's packages" {
  // The root's module, and the dependency's own module importing a sibling of its prefix.
  let lib = [
    { name: b"answer", src: b"import extra\npub fn answer() -> Int = extra::hidden()" },
    { name: b"extra", src: b"pub fn hidden() -> Int = 1" },
  ];
  let declared = {
    ..with_lib([]),
    supplied: [{ root: b"lib", manifest: at(with_lib([]).supplied, 0).manifest, modules: lib }],
  };
  let user = [{ name: b"m", src: b"import lib.answer\nfn main() -> Int = answer::answer()" }];
  match analyse_pulling_std_with(user, [], [], [], declared).out {
    Refused(ds) -> assert_eq(map(ds, |d: Diag| d.code), []),
    Analysed(w) -> {
      // What a rehash is given: the modules the front end read, in its own order, named as it
      // named them. Only the tables make `lib.answer`'s bare `extra` resolve.
      let sources = append(
        user,
        map(lib, |m: Source| { name: bytes_concat(b"lib.", m.name), src: m.src }),
      );
      let r = rehash(sources, [], w.packages, w.mod_pkg, len(w.packages));
      assert(len(r.nodes) > 0);
      // Each node's hashes are whole digests, which is how the bisector reads them.
      assert_eq(
        filter(r.nodes, |n: Rehash| bytes_len(n.fresh) != 32 || bytes_len(n.table) != 32),
        [],
      )
    },
  }
}

test "a missing dependency manifest is unusable where it is declared" {
  let user = [{ name: b"m", src: b"fn main() -> Int = 1" }];
  let pkgs = with_lib(user);
  let clo = closure(
    { ..pkgs, supplied: [{ root: b"lib", manifest: None, modules: [] }] },
    map(user, |s: Source| s.name),
  );
  assert_eq(at(clo.diags, 0).diag.code, b"E0135")
}

test "a cycle of packages is refused, naming the cycle" {
  let user = [{ name: b"m", src: b"fn main() -> Int = 1" }];
  let manifest_dep = b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"n\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [{name: \"other\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Path(\"../other\")}], entry: None}";
  let clo = closure(
    {
      root: b"a",
      manifest: Some(manifest_dep),
      supplied: [
        { root: b"other", manifest: Some(manifest_dep), modules: [] },
        { root: b"other/other", manifest: Some(manifest_dep), modules: [] },
      ],
    },
    [],
  );
  assert(has_diag(clo.diags, b"E0134"))
}

fn has_diag(diags: List<{ slot: Int, diag: PDiag }>, code: Bytes) -> Bool =
  fold(diags, false, |acc: Bool, sd: { slot: Int, diag: PDiag }| acc || sd.diag.code == code)

// --- Embeds: tests ---------------------------------------------------------------

type Read = { want: EmbedWant, read: EmbedRead }

fn embedding_in(pkgs: Pkgs, user: List<Source>, reads: List<Read>) -> Analysis / {abort.raise} =
  analyse_pulling_std_with(
    user,
    [],
    [],
    [],
    pkgs,
    no_interfaces(),
    map(reads, |r: Read| { root: pkgs.root, module: b"m", want: r.want, read: r.read }),
  ).out

fn embedding(src: Bytes, reads: List<Read>) -> Analysis / {abort.raise} =
  embedding_in({ root: b"r", manifest: None, supplied: [] }, [{ name: b"m", src: src }], reads)

fn a_file(bytes: Bytes) -> Read =
  { want: { path: b"d.txt", dir: false }, read: Ok([{ name: b"", bytes: bytes }]) }

fn checked_whole(a: Analysis) -> Whole / {abort.raise} =
  match a {
    Refused(ds) ->
      panic(
        string_of_bytes_lossy(
          joined(map(ds, |d: Diag| bytes_concat_all([d.code, b": ", d.message])), b"; "),
        ),
      ),
    Analysed(w) -> w,
  }

fn def_hash_in(a: Analysis, name: Bytes) -> Bytes / {abort.raise} =
  match filter(checked_whole(a).hashes.defs, |d: { name: Bytes, hash: Bytes }| d.name == name) {
    [d, ..] -> d.hash,
    [] -> panic("no such definition"),
  }

fn refused_codes(a: Analysis) -> List<Bytes> =
  match a { Refused(ds) -> map(ds, |d: Diag| d.code), Analysed(_) -> [] }

test "an embed is the bytes read for it, and other bytes are another definition" {
  let src = b"fn data() -> Bytes = embed(\"d.txt\")\nfn other() -> Int = 1\n";
  let one = embedding(src, [a_file(b"one")]);
  let two = embedding(src, [a_file(b"two")]);
  assert(def_hash_in(one, b"m.data") != def_hash_in(two, b"m.data"));
  assert_eq(def_hash_in(one, b"m.other"), def_hash_in(two, b"m.other"));
  assert_eq(
    def_hash_in(one, b"m.data"),
    def_hash_in(
      embedding(b"fn data() -> Bytes = b\"one\"\nfn other() -> Int = 1\n", []),
      b"m.data",
    ),
  )
}

test "a directory embed is its files as records, by their paths below it" {
  let src = b"fn tree() -> List<{ name: String, bytes: Bytes }> = embed_dir(\"t\")\n";
  let w = checked_whole(
    embedding(src, [
      {
        want: { path: b"t", dir: true },
        read: Ok([{ name: b"a", bytes: b"1" }, { name: b"b/c", bytes: b"2" }]),
      },
    ]),
  );
  assert_eq(map(w.embeds, |e: EmbedAt| e.key), [b"dir:t"])
}

test "an embed's path is a literal, and an embed nothing could be read for is refused" {
  assert_eq(
    refused_codes(
      embedding(b"fn p() -> String = \"d.txt\"\nfn data() -> Bytes = embed(p())\n", []),
    ),
    [b"E0147"],
  );
  assert_eq(
    refused_codes(
      embedding(b"fn data() -> Bytes = embed(\"d.txt\")\n", [
        { want: { path: b"d.txt", dir: false }, read: Err(b"`d.txt` does not exist") },
      ]),
    ),
    [b"E0146"],
  );
  assert_eq(refused_codes(embedding(b"fn data() -> Bytes = embed(\"d.txt\")\n", [])), [b"E0146"])
}

test "a module that binds `embed` itself calls its own" {
  let w = checked_whole(
    embedding(
      b"fn embed(p: String) -> Bytes = b\"mine\"\nfn data() -> Bytes = embed(\"d.txt\")\n",
      [],
    ),
  );
  assert_eq(w.embeds, [])
}

test "a rehash writes the embeds the answer carries" {
  let sources = [{ name: b"m", src: b"fn data() -> Bytes = embed(\"d.txt\")\n" }];
  let w = checked_whole(
    embedding_in({ root: b"r", manifest: None, supplied: [] }, sources, [a_file(b"one")]),
  );
  assert(len(rehash(sources, [], w.packages, w.mod_pkg, len(w.packages), w.embeds).nodes) > 0)
}

test "a dependency is pinned by what its modules embed as well as by their text" {
  let user = [{ name: b"main", src: b"import lib.answer\nfn main() -> Int = answer::answer()" }];
  let pkgs = with_lib(user);
  let embedding_lib = |read: Option<Bytes>| {
    let lib = at(pkgs.supplied, 0);
    let src = match read {
      Some(_) -> b"pub fn answer() -> Int = bytes_len(embed(\"n.txt\"))",
      None -> b"pub fn answer() -> Int = 42",
    };
    let changed = { ..pkgs, supplied: [{ ..lib, modules: [{ name: b"answer", src: src }] }] };
    let reads = match read {
      Some(b) ->
        [
          {
            root: b"lib",
            module: b"answer",
            want: { path: b"n.txt", dir: false },
            read: Ok([{ name: b"", bytes: b }]),
          },
        ],
      None -> [],
    };
    map(
      checked_whole(
        analyse_pulling_std_with(user, [], [], [], changed, no_interfaces(), reads).out,
      ).pins,
      |p: Pinned| p.digest,
    )
  };
  assert(embedding_lib(Some(b"one")) != embedding_lib(Some(b"two")))
}
