fn span_at(module: Int, span: Span) -> ModuleSpan =
  {
    module: if span.start == 0 && span.end == 0 { no_module() } else { module },
    start: span.start,
    end: span.end,
  }

fn loc_at(location: Location) -> ModuleSpan = span_at(location.module, location.span)

// --- What the source wrote ----------------------------------------------------
// What the driver reads from the tree that the checker's tables do not keep.

type Written = { public: Bool, reuse: Bool, params: List<Param>, literals: List<Bytes> }

fn no_written() -> Written = { public: false, reuse: false, params: [], literals: [] }

fn fn_written(mods: List<ParsedModule>) -> Map<Bytes, Written> / {abort.raise} =
  fold(mods, map_new(), |acc: Map<Bytes, Written>, parsed: ParsedModule|
    fold(parsed.module.items, acc, |a: Map<Bytes, Written>, item: Item|
      match item {
        IFn(d) ->
          map_insert(a, qualify(parsed.name, d.name.name), {
            public: is_pub(d.vis),
            reuse: match d.reuse { Some(_) -> true, None -> false },
            params: d.params,
            literals: fold(d.spec, [], |found: List<Bytes>, clause: SpecClause|
              match clause.kind {
                SRequires -> lits(found, clause.expr),
                SEnsures -> found,
                SCost -> found,
              }),
          }),
        _ -> a,
      }))

fn written_of(m: Map<Bytes, Written>, name: Bytes) -> Written =
  match map_get(m, name) { Some(w) -> w, None -> no_written() }

fn effect_written(mods: List<ParsedModule>) -> Map<Bytes, Bool> =
  fold(mods, map_new(), |acc: Map<Bytes, Bool>, parsed: ParsedModule|
    fold(parsed.module.items, acc, |a: Map<Bytes, Bool>, item: Item|
      match item {
        IEffect(d) -> map_insert(a, qualify(parsed.name, d.name.name), is_pub(d.vis)),
        _ -> a,
      }))

/// A prelude effect has no source entry and is public.
fn effect_public_of(m: Map<Bytes, Bool>, effect_info: EffectInfo) -> Bool =
  match map_get(m, effect_info.name) { Some(b) -> b, None -> true }

/// No table of the checker's holds a `type` declaration, so it is read from the tree.
fn type_rows(mods: List<ParsedModule>) -> List<TypeRow> / {abort.raise} =
  fold(range(0, len(mods)), [], |acc: List<TypeRow>, i: Int| {
    let m = at(mods, i);
    fold(m.module.items, acc, |a: List<TypeRow>, item: Item|
      match item {
        IType(d) ->
          push(a, {
            name: qualify(m.name, d.name.name),
            module: m.name,
            simple_name: d.name.name,
            public: is_pub(d.vis),
            arity: len(d.generics.types),
            at: span_at(i, d.span),
          }),
        _ -> a,
      })
  })

fn test_name_spans(mods: List<ParsedModule>) -> List<Location> / {abort.raise} =
  fold(range(0, len(mods)), [], |acc: List<Location>, i: Int| {
    let m = at(mods, i);
    fold(m.module.items, acc, |a: List<Location>, item: Item|
      match item { ITest(d) -> push(a, { module: i, span: d.name_span }), _ -> a })
  })

// --- A guard's literals -------------------------------------------------------
// The order seeds the prover's witness search, so it is the stack walk's first-reached order, not sorted.

fn int_lit(k: Int) -> Bytes = bytes_concat(b"int ", ascii_of_int(k))

fn lit_text(acc: List<Bytes>, literal: Lit) -> List<Bytes> / {abort.raise} =
  match literal {
    LInt(k) -> push_unique(acc, int_lit(k)),
    LStr(s) -> push_unique(acc, bytes_concat(b"str ", s)),
    LBytes(b) -> push_unique(acc, bytes_concat(b"bytes ", hex(b))),
    _ -> acc,
  }

/// A negated literal is kept negated, as the guard means it; the walk still reaches the literal itself.
fn neg_lit(acc: List<Bytes>, expr: Expr) -> List<Bytes> =
  match expr {
    ELit(v) -> match v.lit { LInt(k) -> push_unique(acc, int_lit(0 - k)), _ -> acc },
    _ -> acc,
  }

/// The literals inside `expr`, each child walked after the ones written after it.
fn lits(acc: List<Bytes>, expr: Expr) -> List<Bytes> / {abort.raise} = {
  let backwards = |a: List<Bytes>, xs: List<Expr>|
    fold(range(0, len(xs)), a, |b: List<Bytes>, k: Int|
      match list_at(xs, len(xs) - 1 - k) { Some(x) -> lits(b, x), None -> b });
  match expr {
    ELit(v) -> lit_text(acc, v.lit),
    EVar(_) -> acc,
    ETagged(v) -> backwards(acc, map(v.holes, |h: Hole| h.value)),
    EBad(_) -> acc,
    EBinary(v) -> lits(lits(acc, v.rhs), v.lhs),
    EUnary(v) -> lits(if v.op == b"neg" { neg_lit(acc, v.operand) } else { acc }, v.operand),
    ELambda(v) -> lits(acc, v.body),
    EApp(v) -> lits(backwards(acc, v.args), v.func),
    EIf(v) -> lits(lits(lits(acc, v.else_branch), v.then_branch), v.cond),
    EMatch(v) -> {
      let n = len(v.arms);
      let armed = fold(range(0, n), acc, |a: List<Bytes>, k: Int|
        match list_at(v.arms, n - 1 - k) {
          Some(arm) -> match arm.guard {
            Some(g) -> lits(lits(a, arm.body), g),
            None -> lits(a, arm.body),
          },
          None -> a,
        });
      lits(armed, v.scrutinee)
    },
    EBlock(v) -> {
      let tailed = match v.tail { Some(t) -> lits(acc, t), None -> acc };
      let n = len(v.stmts);
      fold(range(0, n), tailed, |a: List<Bytes>, k: Int|
        match list_at(v.stmts, n - 1 - k) {
          Some(SLet(x)) -> lits(a, x.value),
          Some(SLetElse(x)) -> lits(lits(a, x.fallback), x.value),
          Some(SExpr(x)) -> lits(a, x),
          None -> a,
        })
    },
    ERecord(v) -> backwards(acc, map(v.fields, |field: RecField| field.value)),
    ERecordUpdate(v) -> lits(backwards(acc, map(v.fields, |field: RecField| field.value)), v.base),
    EField(v) -> lits(acc, v.base),
    ETry(v) -> lits(acc, v.operand),
    EList(v) -> backwards(acc, v.items),
    EPerform(v) -> backwards(acc, v.args),
    EHandle(v) -> lits(acc, v.body),
    EWithCell(v) -> lits(lits(acc, v.body), v.init),
    ESimulate(v) -> lits(acc, v.body),
    EParallel(v) -> backwards(acc, v.branches),
    ETryBlock(v) -> lits(acc, v.body),
  }
}

/// The literals these guards are written with, one guard at a time, as `<int|str|bytes> <value>`:
/// where a guard's domain is, which a witness search tries first.
pub fn literals_of(guards: List<Expr>) -> List<Bytes> / {abort.raise} =
  fold(guards, [], |acc: List<Bytes>, expr: Expr| lits(acc, expr))

/// The definitions a program's schemas are, by program-wide name: what a claim states, which is not
/// itself something to carry one.
pub fn schema_definitions(mods: List<ParsedModule>) -> Map<Bytes, Bool> =
  fold(mods, map_new(), |acc: Map<Bytes, Bool>, parsed: ParsedModule|
    fold(parsed.module.items, acc, |a: Map<Bytes, Bool>, item: Item|
      match item {
        ISchema(d) -> {
          let named = map_insert(a, qualify(parsed.name, d.name.name), true);
          match d.guard {
            Some(_) ->
              map_insert(named, qualify(parsed.name, schema_guard_name(d.name.name)), true),
            None -> named,
          }
        },
        _ -> a,
      }))

/// The schema each instantiation is of, by the law's program-wide name.
pub fn schemas_instantiated(mods: List<ParsedModule>) -> Map<Bytes, Bytes> =
  fold(mods, map_new(), |acc: Map<Bytes, Bytes>, parsed: ParsedModule|
    fold(parsed.module.items, acc, |a: Map<Bytes, Bytes>, item: Item|
      match item {
        ILaw(d) -> match d.of {
          Some(of) -> match of.home {
            Some(home) ->
              map_insert(a, qualify(parsed.name, d.name), qualify(home, of.schema.name.name)),
            None -> a,
          },
          None -> a,
        },
        _ -> a,
      }))

/// The literals a law's guard is written with: its own, or of an instantiation its schema's.
pub fn guard_literals(mods: List<ParsedModule>, law_def: LawDef) -> List<Bytes> / {abort.raise} = {
  let schema = match law_def.of {
    Some(of) -> match home_of(mods, of) {
      Some(home) -> schema_named(at(mods, home).module, of.schema.name.name),
      None -> None,
    },
    None -> None,
  };
  match match schema { Some(s) -> s.guard, None -> law_def.guard } {
    Some(g) -> lits([], g),
    None -> [],
  }
}

fn law_literals(mods: List<ParsedModule>) -> List<List<Bytes>> / {abort.raise} =
  fold(mods, [], |acc: List<List<Bytes>>, parsed: ParsedModule|
    fold(parsed.module.items, acc, |a: List<List<Bytes>>, item: Item|
      match item { ILaw(d) -> push(a, guard_literals(mods, d)), _ -> a }))

// --- A module's effect sets ---------------------------------------------------
// An atom whose effect resolves to nothing is dropped; a bare `cell` resolves to itself.

fn has_effect(effects: List<EffectInfo>, name: Bytes) -> Bool =
  fold(effects, false, |acc: Bool, effect_info: EffectInfo| acc || effect_info.name == name)

fn bare_prelude(qname: QName) -> Option<Bytes> =
  if is_bare(qname) && is_prelude_effect(qname.name.name) { Some(qname.name.name) } else { None }

fn set_effect(
  resolved: Resolved,
  effects: List<EffectInfo>,
  module: Int,
  qname: QName,
) -> Option<Bytes> / {abort.raise} =
  if is_bare(qname) && qname.name.name == b"cell" { Some(b"cell") } else {
    let found = if is_bare(qname) {
      lookup(at(resolved.scopes, module).bound, EffectSpace, qname.name.name)
    } else { find(resolved, module, EffectSpace, qname) };
    match found {
      Some(b) -> if has_effect(effects, b.qualified) { Some(b.qualified) }
      else { bare_prelude(qname) },
      None -> bare_prelude(qname),
    }
  }

fn set_atoms(
  resolved: Resolved,
  effects: List<EffectInfo>,
  module: Int,
  atoms: List<AtomExpr>,
) -> List<Atom> / {abort.raise} =
  fold(atoms, [], |acc: List<Atom>, atom: AtomExpr|
    match set_effect(resolved, effects, module, atom.eff) {
      Some(eff) ->
        atoms_insert(acc, {
          effect: eff,
          resource: match atom.resource { Some(x) -> RNamed(x.name), None -> RSingleton },
          mode: atom.mode,
          op: match atom.op { Some(x) -> Some(x.name), None -> None },
        }),
      None -> acc,
    })

/// One `effect set` of a module: the simple name a row writes, the sets it includes in source
/// order, and the expansion as program-wide atoms.
pub type SetView = { name: Bytes, includes: List<Bytes>, atoms: List<Atom> }

// --- Module names -------------------------------------------------------------
// A module is a file: `store/orders.ply` is `store.orders`, relative to the project root. The
// rule lives here rather than with the walk that reads a project, because the front end is what
// names a module to everything downstream of it.

fn continue_ok(c: Int) -> Bool = is_ident_start(c) || (c >= 48 && c <= 57)

fn ident_ok(segment: String) -> Bool / {abort.raise} = {
  let b = bytes_of_string(segment);
  if bytes_len(b) == 0 { false } else {
    is_ident_start(bytes_at(b, 0))
      && fold(range(1, bytes_len(b)), true, |ok: Bool, i: Int| ok && continue_ok(bytes_at(b, i)))
  }
}

fn drop_extension(path: String) -> String / {abort.raise} =
  if string_ends_with(path, ".ply") { string_slice(path, 0, string_len(path) - 4) } else { path }

fn dotted(segments: List<String>) -> String =
  fold(range(0, len(segments)), "", |acc: String, i: Int|
    match list_at(segments, i) { Some(s) -> if i == 0 { s } else { acc ++ "." ++ s }, None -> acc })

/// The first segment that is not an identifier, which is what a refusal names.
fn bad_segment(segments: List<String>) -> Option<String> / {abort.raise} =
  fold(segments, None, |acc: Option<String>, s: String|
    match acc { Some(_) -> acc, None -> if ident_ok(s) { None } else { Some(s) } })

pub fn module_of(path: String) -> Result<String, String> / {abort.raise} = {
  let segments = string_split(drop_extension(path), "/");
  match bad_segment(segments) {
    Some(s) -> Err("`" ++ s ++ "` is not an identifier"),
    None -> if len(segments) == 0 { Err("it has no name") } else { Ok(dotted(segments)) },
  }
}

pub fn effect_sets_of(
  resolved: Resolved,
  effects: List<EffectInfo>,
  module: Int,
  parsed: ParsedModule,
) -> List<SetView> / {abort.raise} =
  fold(parsed.module.items, [], |acc: List<SetView>, item: Item|
    match item {
      IEffectSet(d) ->
        push(acc, {
          name: d.name.name,
          includes: map(d.includes, |qname: QName| qname.name.name),
          atoms: set_atoms(resolved, effects, module, d.expansion),
        }),
      _ -> acc,
    })

// --- The rows the answer holds -----------------------------------------------
// Each type, scheme and footprint numbered as its text names its variables, so two answers about
// one program are equal values however the checker numbered them.

/// Program-wide names of everything a module declares, in source order.
pub fn module_items(parsed: ParsedModule) -> List<Bytes> =
  fold(parsed.module.items, [], |acc: List<Bytes>, item: Item|
    match item {
      IFn(d) -> push(acc, qualify(parsed.name, d.name.name)),
      IType(d) -> {
        let named = push(acc, qualify(parsed.name, d.name.name));
        match d.body {
          TDSum(vs) ->
            fold(vs, named, |a: List<Bytes>, variant: VariantDef|
              push(a, qualify(parsed.name, variant.name.name))),
          _ -> named,
        }
      },
      IEffect(d) -> push(acc, qualify(parsed.name, d.name.name)),
      _ -> acc,
    })

/// The modules a module imports, each named once, in source order.
pub fn module_imports(parsed: ParsedModule) -> List<Bytes> / {abort.raise} =
  fold(parsed.module.imports, [], |acc: List<Bytes>, decl: ImportDecl| {
    let name = join(map(decl.path, |x: Ident| x.name), b".");
    if fold(acc, false, |b: Bool, x: Bytes| b || x == name) { acc } else { push(acc, name) }
  })

/// `imports` names each module this one imports as the program names it, which a dependency's bare
/// sibling import does not.
fn module_row(
  i: Int,
  parsed: ParsedModule,
  resolved: Resolved,
  effects: List<EffectInfo>,
  names: List<Bytes>,
  stub_cuts: Map<Bytes, List<Cut>>,
) -> ModuleRow / {abort.raise} = {
  let items = module_items(parsed);
  let imports = fold(at(resolved.imports, i), [], |acc: List<Bytes>, t: Int| {
    let name = at(names, t);
    if fold(acc, false, |b: Bool, x: Bytes| b || x == name) { acc } else { push(acc, name) }
  });
  let sets = effect_sets_of(resolved, effects, i, parsed);
  let cuts = match map_get(stub_cuts, parsed.name) { Some(c) -> c, None -> cuts_of(parsed) };
  { name: parsed.name, index: i, items: items, imports: imports, sets: sets, cuts: cuts }
}

// --- Stubs ------------------------------------------------------------------
// A module with its bodies blanked, every byte of a cut but a newline a space, so every offset
// holds: what a compiled package ships, and what the emitter reads of a module it does not lower.

/// A braced cut keeps `{` and `}` at its ends: an empty block over exactly the body's own span. It
/// names the function whose body it blanks, which a stub is read only with a row and a hash for.
pub type Cut = { start: Int, end: Int, braced: Bool, name: Bytes }

derive bin for Cut

/// Walked even when seeded (rows cannot carry a label), or `transparent`, which another package's
/// proofs unfold: its body stays in the stub.
fn keeps_body(def: FnDef) -> Bool =
  len(def.generics.labels) > 0 || (match def.transparent { Some(_) -> true, None -> false })

/// A generated definition carries the span of the item that regenerates it: its `derive`, or the
/// `gen` its sampler is beside.
pub fn cuts_of(parsed: ParsedModule) -> List<Cut> = {
  let derived = fold(parsed.derived, map_new(), |acc: Map<Bytes, Bool>, d: Derived|
    map_insert(acc, span_key(d.span), true));
  let generated = fold(parsed.module.items, derived, |acc: Map<Bytes, Bool>, item: Item|
    match sampler_of(item) {
      Some(_) -> map_insert(acc, span_key(item_span(item)), true),
      None -> acc,
    });
  fold(parsed.module.items, [], |acc: List<Cut>, item: Item|
    match item {
      IFn(d) -> if map_contains(generated, span_key(d.span)) || keeps_body(d) { acc } else {
        let b = expr_span(d.body);
        if b.end - b.start < 2 { acc } else {
          push(acc, {
            start: b.start,
            end: b.end,
            braced: true,
            name: qualify(parsed.name, d.name.name),
          })
        }
      },
      ITest(d) -> push(acc, { start: d.span.start, end: d.span.end, braced: false, name: b"" }),
      ILaw(d) -> push(acc, { start: d.span.start, end: d.span.end, braced: false, name: b"" }),
      _ -> acc,
    })
}

/// The cuts that blank a module's bodies and leave its tests and laws: a stub of a module whose own
/// tests a load still answers for.
pub fn body_cuts_of(parsed: ParsedModule) -> List<Cut> =
  filter(cuts_of(parsed), |cut: Cut| cut.braced)

fn def_row(def_info: DefInfo, w: Written) -> DefRow / {abort.raise} =
  {
    name: def_info.name,
    module: def_info.module,
    simple_name: def_info.simple_name,
    public: w.public,
    reuse: w.reuse,
    footprint: canonical_atoms(def_info.footprint),
    performed: canonical_atoms(def_info.performed),
    constraints: def_info.constraints,
    row_aliases: def_info.row_aliases,
    params: map(w.params, |param: Param|
      { name: param.name.name, at: span_at(def_info.at.module, param.span) }),
    spec: map(def_info.spec, |spec: SpecInfo|
      {
        kind: spec_kind_text(spec.kind),
        index: spec.index,
        footprint: canonical_atoms(spec.footprint),
        at: span_at(def_info.at.module, spec.span),
      }),
    at: loc_at(def_info.at),
    literals: w.literals,
  }

fn test_row(test_info: TestInfo, name_at: Location) -> TestRow / {abort.raise} =
  {
    key: test_info.key,
    name: test_info.name,
    module: test_info.module,
    index: test_info.index,
    nondet: test_info.nondet,
    footprint: canonical_atoms(test_info.footprint),
    at: loc_at(test_info.at),
    name_at: loc_at(name_at),
  }

fn law_row(law_info: LawInfo, lits: List<Bytes>) -> LawRow / {abort.raise} =
  {
    key: law_info.key,
    name: law_info.name,
    module: law_info.module,
    index: law_info.index,
    binders: map(law_info.binders, |b: LawBinder|
      { name: b.name, at: span_at(law_info.at.module, b.span), ty: canonical_type(b.ty) }),
    has_guard: law_info.has_guard,
    host: law_info.host,
    cost: law_info.cost,
    footprint: canonical_atoms(law_info.footprint),
    at: loc_at(law_info.at),
    literals: lits,
  }

fn op_row(module: Int, op_info: OpInfo, cr: Carrier) -> OpRow / {abort.raise} =
  {
    name: op_info.name,
    mode: mode_text(op_info.mode),
    resource_param: op_info.resource_param,
    params: map(op_info.params, canonical_type),
    ret: canonical_type(op_info.ret),
    scheme: match op_info.scheme { Some(sc) -> Some(canonical_scheme(sc)), None -> None },
    at: span_at(module, op_info.at.span),
    carries: map(carries(cr, [], op_info.params), grounded),
  }

fn effect_row(effect_info: EffectInfo, public: Bool, cr: Carrier) -> EffectRow / {abort.raise} =
  {
    name: effect_info.name,
    module: effect_info.module,
    simple_name: effect_info.simple_name,
    public: public,
    nondet: effect_info.nondet,
    ops: map(effect_info.ops, |op_info: OpInfo| op_row(effect_info.at.module, op_info, cr)),
    at: loc_at(effect_info.at),
  }

fn ctor_row(ctor_info: CtorInfo) -> CtorRow / {abort.raise} =
  {
    name: ctor_info.name,
    module: ctor_info.module,
    simple_name: ctor_info.simple_name,
    type_name: ctor_info.type_name,
    index: ctor_info.index,
    arity: ctor_info.arity,
    fields: map(ctor_info.fields, canonical_type),
    scheme: canonical_scheme(ctor_info.scheme),
    at: loc_at(ctor_info.at),
  }

// --- The hashes ---------------------------------------------------------------
// A name declared twice (a `fn` and an `effect` alike) is one row, as the maps merged it.

fn by_name_many(xs: List<{ name: Bytes, hashes: List<Bytes> }>) -> Map<Bytes, List<Bytes>> =
  fold(xs, map_new(), |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, hashes: List<Bytes> }|
    map_insert(acc, x.name, x.hashes))

pub fn by_name_names(xs: List<{ name: Bytes, names: List<Bytes> }>) -> Map<Bytes, List<Bytes>> =
  fold(xs, map_new(), |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, names: List<Bytes> }|
    map_insert(acc, x.name, x.names))

type Tables = {
  defs: Map<Bytes, Bytes>,
  own: Map<Bytes, Bytes>,
  decls: Map<Bytes, Bytes>,
  specs: Map<Bytes, List<Bytes>>,
  spec_texts: Map<Bytes, List<Bytes>>,
  deps: Map<Bytes, List<Bytes>>,
}

fn hash_tables(hashes: HashOutput) -> Tables =
  {
    defs: by_name(hashes.defs),
    own: by_name(hashes.own),
    decls: by_name(hashes.decls),
    specs: by_name_many(hashes.specs),
    spec_texts: by_name_many(hashes.spec_texts),
    deps: by_name_names(hashes.deps),
  }

fn hex_one(m: Map<Bytes, Bytes>, name: Bytes) -> Option<Bytes> / {abort.raise} =
  match map_get(m, name) { Some(h) -> Some(hex(h)), None -> None }

fn hex_many(m: Map<Bytes, List<Bytes>>, name: Bytes) -> List<Bytes> / {abort.raise} =
  match map_get(m, name) { Some(hs) -> map(hs, hex), None -> [] }

fn names_of(m: Map<Bytes, List<Bytes>>, name: Bytes) -> List<Bytes> =
  match map_get(m, name) { Some(ns) -> ns, None -> [] }

fn def_hash_row(tables: Tables, name: Bytes) -> HashRow / {abort.raise} =
  {
    name: name,
    def: hex_one(tables.defs, name),
    own: hex_one(tables.own, name),
    decl: hex_one(tables.decls, name),
    specs: hex_many(tables.specs, name),
    spec_texts: hex_many(tables.spec_texts, name),
    deps: names_of(tables.deps, name),
  }

fn hash_rows(index: Index, hashes: HashOutput) -> List<HashFrame> / {abort.raise} = {
  let t = hash_tables(hashes);
  let walked = fold(
    index.order,
    { seen: map_new(), frames: [] },
    |acc: { seen: Map<Bytes, Bool>, frames: List<HashFrame> }, e: IndexEntry|
      match e {
        DefEntry(v) -> {
          let name = at(index.nodes, v).name;
          match map_get(acc.seen, name) {
            Some(_) -> acc,
            None ->
              {
                seen: map_insert(acc.seen, name, true),
                frames: push(acc.frames, HDef(def_hash_row(t, name))),
              },
          }
        },
        TestEntry(i) -> {
          let key = at(index.tests, i).key;
          {
            ..acc,
            frames: push(
              acc.frames,
              HTest({
                index: i,
                key: key,
                hash: hex(at(hashes.tests, i)),
                text: b"",
                deps: names_of(t.deps, key),
              }),
            ),
          }
        },
        LawEntry(i) -> {
          let key = at(index.laws, i).key;
          {
            ..acc,
            frames: push(
              acc.frames,
              HLaw({
                index: i,
                key: key,
                hash: hex(at(hashes.laws, i)),
                text: hex(at(hashes.law_texts, i)),
                deps: names_of(t.deps, key),
              }),
            ),
          }
        },
      },
  );
  walked.frames
}

// A `fn` also names its clauses' kinds in order, so each clause's root can be keyed.
// --- The emitter's root keys -------------------------------------------------

/// One root the emitter caches a compiled body under, and the key it caches it by: a digest of
/// what emitting it reads of the rest of the program. `crates/ply-codegen`'s `Source` reads these.
pub type KeyRow = { root: Bytes, key: Bytes }

/// The walk's place: the rows so far, this module's test and law ordinals, and which law text the
/// next law is keyed by.
type Keying = { out: List<KeyRow>, ordinal: Int, law_ordinal: Int, law_at: Int }

/// What emitting a definition reads of it: its parameter and answer types printed with one printer,
/// and whether it is pure, so a nullary call can come from the constant table.
fn key_published(def_info: DefInfo) -> Bytes / {abort.raise} = {
  let (params, ret) = match def_info.scheme.ty {
    TyFn(f) -> (f.params, f.ret),
    other -> ([], other),
  };
  let printed = fold(
    params,
    { p: printer_new(), texts: [] },
    |acc: { p: Printer, texts: List<Bytes> }, ty: Type| {
      let out = print_ty(acc.p, ty);
      { p: out.printer, texts: push(acc.texts, out.text) }
    },
  );
  let pure = if published_pure(def_info) { b"true" } else { b"false" };
  bytes_concat_all([
    b"(",
    join(printed.texts, b", "),
    b") -> ",
    print_ty(printed.p, ret).text,
    b" ",
    pure,
  ])
}

fn key_clause_root(owner: Bytes, kind: Bytes, k: Int) -> Bytes =
  bytes_concat_all([owner, b"#", kind, b"#", ascii_of_int(k)])

fn key_law_root(n: Int, part: Bytes) -> Bytes =
  bytes_concat_all([b"law#", ascii_of_int(n), b".", part])

fn key_test_root(n: Int) -> Bytes = bytes_concat(b"test#", ascii_of_int(n))

/// The roots the emitter answers the program's tests by, in its test order: test `i`'s is the `i`th.
pub fn test_roots(dump: Dump) -> List<Bytes> / {abort.raise} =
  filter(map(dump.emitter_roots, |root: EmitterRoot| root.root), is_test_root)

/// A module's name and `test#` with the test's place among the module's: one `#`, digits after it.
fn is_test_root(root: Bytes) -> Bool / {abort.raise} =
  match bytes_split(root, b"#") {
    [named, place] ->
      bytes_ends_with(named, b".test") && bytes_len(place) > 0
        && bytes_position(place, 0, |c: Int| c < 48 || c > 57) == None,
    _ -> false,
  }

/// A digest of what emitting the root hashed under `key` reads of the rest of the program: the
/// signature of `owner` (the root, or a clause's definition), the signature of every definition it
/// references, and every `type` or `effect` declaration it mentions, sorted by name.
fn key_reads(
  published: Map<Bytes, Bytes>,
  deps: Map<Bytes, List<Bytes>>,
  decls: Map<Bytes, Bytes>,
  key: Bytes,
  owner: Option<Bytes>,
) -> Bytes / {abort.raise} = {
  let owner_text = match owner {
    Some(o) -> match map_get(published, o) { Some(text) -> text, None -> b"" },
    None -> b"",
  };
  let names = match map_get(deps, key) {
    Some(ns) -> map_keys(map_of_entries(map(ns, |n: Bytes| { key: n, value: () }))),
    None -> [],
  };
  let each = map(names, |name: Bytes| {
    let text = match map_get(published, name) { Some(t) -> t, None -> b"" };
    let decl = match map_get(decls, name) { Some(h) -> h, None -> b"" };
    bytes_concat_all([name, b"\x00", text, decl, b"\x00"])
  });
  bytes_slice(hex(blake3(bytes_concat_all(concat([owner_text, b"\x00"], each)))), 0, 32)
}

/// One `fn`'s clause keys, then its own.
fn key_fn(
  published: Map<Bytes, Bytes>,
  own: Map<Bytes, Bytes>,
  sentences: Map<Bytes, List<Bytes>>,
  deps: Map<Bytes, List<Bytes>>,
  decls: Map<Bytes, Bytes>,
  a: Keying,
  name: Bytes,
  spec: List<SpecClause>,
) -> Keying / {abort.raise} =
  match map_get(own, name) {
    None -> a,
    Some(owner) -> {
      let read = key_reads(published, deps, decls, name, Some(name));
      let sents = match map_get(sentences, name) { Some(s) -> s, None -> [] };
      let clauses = fold(
        range(0, len(spec)),
        { out: a.out, requires: 0, ensures: 0 },
        |b: { out: List<KeyRow>, requires: Int, ensures: Int }, i: Int| {
          let kind = at(spec, i).kind;
          // A `cost` clause is keyed as the law it becomes.
          if kind == SCost { b } else {
            let text = spec_kind_text(kind);
            let k = if kind == SRequires { b.requires } else { b.ensures };
            let sentence = match list_at(sents, i) { Some(s) -> s, None -> owner };
            {
              out: push(b.out, {
                root: key_clause_root(name, text, k),
                key: bytes_concat_all([
                  hex(sentence),
                  b"#",
                  text,
                  b"#",
                  ascii_of_int(k),
                  b"+",
                  read,
                ]),
              }),
              requires: if kind == SRequires { b.requires + 1 } else { b.requires },
              ensures: if kind == SEnsures { b.ensures + 1 } else { b.ensures },
            }
          }
        },
      );
      {
        ..a,
        out: push(clauses.out, { root: name, key: bytes_concat_all([hex(owner), b"+", read]) }),
      }
    },
  }

fn root_keys(
  mods: List<ParsedModule>,
  checked: CheckOutput,
  hashes: HashOutput,
) -> List<KeyRow> / {abort.raise} = {
  let own = by_name(hashes.own);
  let sentences = by_name_many(hashes.spec_texts);
  let deps = by_name_names(hashes.deps);
  let decls = by_name(hashes.decls);
  // Each signature printed once: a root reads many definitions, and many roots read one.
  let published = map_of_entries(
    map(checked.defs, |d: DefInfo| { key: d.name, value: key_published(d) }),
  );
  let laws = checked.laws;
  let law_texts = hashes.law_texts;
  fold(
    mods,
    { out: [], ordinal: 0, law_ordinal: 0, law_at: 0 },
    |acc: Keying, parsed: ParsedModule| {
      let walked = fold(
        parsed.module.items,
        { out: acc.out, ordinal: 0, law_ordinal: 0, law_at: acc.law_at },
        |a: Keying, item: Item|
          match item {
            IFn(d) ->
              key_fn(
                published,
                own,
                sentences,
                deps,
                decls,
                a,
                qualify(parsed.name, d.name.name),
                d.spec,
              ),
            ITest(d) -> {
              let name = qualify(parsed.name, d.name);
              let read = key_reads(published, deps, decls, name, None);
              let root = qualify(parsed.name, key_test_root(a.ordinal));
              let run = push(a.out, { root: root, key: bytes_concat(b"test+", read) });
              {
                ..a,
                ordinal: a.ordinal + 1,
                out: if d.cases == None { run }
                else { push(run, { root: cases_root(root), key: bytes_concat(b"cases+", read) }) },
              }
            },
            ILaw(d) -> {
              let name = qualify(parsed.name, d.name);
              let keyed = match list_at(law_texts, a.law_at) {
                None -> a,
                Some(text) -> {
                  let read = key_reads(published, deps, decls, name, None);
                  let guarded = match list_at(laws, a.law_at) {
                    Some(l) -> l.has_guard,
                    None -> false,
                  };
                  fold(
                    if guarded { [b"guard", b"body"] } else { [b"body"] },
                    a,
                    |b: Keying, part: Bytes| {
                      let row = {
                        root: qualify(parsed.name, key_law_root(a.law_ordinal, part)),
                        key: bytes_concat_all([hex(text), b"#", part, b"+", read]),
                      };
                      { ..b, out: push(b.out, row) }
                    },
                  )
                },
              };
              { ..keyed, law_ordinal: a.law_ordinal + 1, law_at: a.law_at + 1 }
            },
            _ -> a,
          },
      );
      { out: walked.out, ordinal: 0, law_ordinal: 0, law_at: walked.law_at }
    },
  ).out
}

// --- The emitter's roots -----------------------------------------------------

/// One root the emitter offers: a definition, a spec clause, a test, the listing of a test's cases
/// or a law part, with the arity its body is emitted at. `pure` is a definition's published purity, which lets a memo answer for
/// it; any other root runs each time. `params` and `answer` say how what it is entered with and
/// answers read at the seam. `witnesses` are the type variables whose witnesses lead `params`, which
/// an entry from outside fills from what its arguments show of each.
pub type EmitterRoot = {
  root: Bytes,
  arity: Int,
  pure: Bool,
  at: ModuleSpan,
  params: List<Carry>,
  answer: Carry,
  witnesses: List<Int>,
}

/// The span of a root the tables do not place: a test or law whose check output has no row.
pub fn no_module_span() -> ModuleSpan = { module: no_module(), start: 0, end: 0 }

/// One constructor, with its arity and how its fields read over its type's parameters; the
/// emitter orders tags by position here. `key` and `show` are the functions its type's module
/// states its values are compared and shown through.
pub type EmitterCtor = {
  name: Bytes,
  arity: Int,
  fields: List<Carry>,
  key: Option<Bytes>,
  show: Option<Bytes>,
  /// The functions its type's `numeric` names, in `numeric_ops`' order; none where it states none.
  numeric: List<Bytes>,
}

/// The walk's per-module place and its running place; `ordinal` counts tests, `law_ordinal` laws.
type EmitTables = { fns: List<EmitterRoot>, tests: List<EmitterRoot>, specs: List<EmitterRoot> }
type EmitWalk = {
  fns: List<EmitterRoot>,
  tests: List<EmitterRoot>,
  specs: List<EmitterRoot>,
  ordinal: Int,
  law_ordinal: Int,
}

/// The prelude's constructors, then each module's in program order: the order the emitted C
/// names tags by, which is not `CheckOutput::ctors`' dependency order.
fn emitter_ctors_of(
  mods: List<ParsedModule>,
  checked: CheckOutput,
  cr: Carrier,
) -> List<EmitterCtor> / {abort.raise} = {
  let prelude = filter(checked.ctors, |ctor_info: CtorInfo| bytes_len(ctor_info.module) == 0);
  let rest = fold(mods, [], |acc: List<CtorInfo>, parsed: ParsedModule|
    concat(acc, filter(checked.ctors, |ctor_info: CtorInfo| ctor_info.module == parsed.name)));
  let through = |type_name: Bytes, key: Bool|
    fold(checked.instances, None, |acc: Option<Bytes>, x: InstanceInfo|
      if x.type_name == type_name && (match x.kind { NKey -> key, NShow -> !key, NGen -> false }) {
        Some(x.by)
      } else { acc });
  map(concat(prelude, rest), |ctor_info: CtorInfo|
    {
      name: ctor_info.name,
      arity: ctor_info.arity,
      fields: carries(cr, ctor_info.scheme.ty_vars, ctor_info.fields),
      key: through(ctor_info.type_name, true),
      show: through(ctor_info.type_name, false),
      numeric: fold(checked.numeric_types, [], |acc: List<Bytes>, x: NumericInfo|
        if x.type_name == ctor_info.type_name { x.fns } else { acc }),
    })
}

// --- How a value reads at the compiled seam ------------------------------------

/// Compiled code holds a width below 64 bits as a tagged `Int`, so only a value's type tells a `U8`
/// from an `Int`; every other word says what it is. A carry is that type, cut to what decides a
/// reading: `CPlain` where no width can sit, `CSum` a sum type at its parameters, whose
/// constructor's fields read as its declaration types them, and `CVar` a type variable of the
/// scheme around it, or a parameter of the declaration, by number. A function's words are never
/// read, but a function the prover generated shows what its variables are.
pub type Carry =
  | CPlain
  | CWidth(Int)
  | CList(Carry)
  | CMap(Carry, Carry)
  | CRecord(List<CarriedField>)
  | CSum(List<Carry>)
  | CFn(List<Carry>, Carry)
  | CVar(Int)

pub type CarriedField = { name: Bytes, carry: Carry }

/// A fixed width by the runtime's numbering, `ply_eval::INT_TYPES`.
fn width_number(name: Bytes) -> Option<Int> =
  if name == b"U8" { Some(0) }
  else if name == b"U16" { Some(1) }
  else if name == b"U32" { Some(2) }
  else if name == b"U64" { Some(3) }
  else if name == b"I8" { Some(4) }
  else if name == b"I16" { Some(5) }
  else if name == b"I32" { Some(6) }
  else if name == b"I64" { Some(7) }
  else if name == b"U128" { Some(8) }
  else if name == b"I128" { Some(9) }
  else { None }

/// Each sum type, and whether it holds a width whatever its parameters are.
type Carrier = { sums: Map<Bytes, Bool> }

fn carrier_of(ctors: List<CtorInfo>) -> Carrier = {
  let held = holding_widths(ctors, []);
  {
    sums: map_of_entries(
      map(ctors, |ctor_info: CtorInfo|
        { key: ctor_info.type_name, value: contains(held, ctor_info.type_name) }),
    ),
  }
}

/// Grown to a fixpoint: a type may hold a width through itself or through another type. A round that
/// grows adds a type, so there are no more rounds than types.
fn holding_widths(ctors: List<CtorInfo>, held: List<Bytes>) -> List<Bytes> =
  fold(
    range(0, len(ctors) + 1),
    { held: held, done: false },
    |st: { held: List<Bytes>, done: Bool }, i: Int|
      if st.done { st } else {
        let grown = fold(ctors, st.held, |a: List<Bytes>, ctor_info: CtorInfo|
          if contains(a, ctor_info.type_name) { a }
          else if fold(ctor_info.fields, false, |b: Bool, ty: Type| b || reaches_width(ty, a)) {
            push(a, ctor_info.type_name)
          } else { a });
        { held: grown, done: len(grown) == len(st.held) }
      },
  ).held

/// A function is a closure's word, which no reading looks inside.
fn reaches_width(t: Type, held: List<Bytes>) -> Bool =
  match t {
    TyVar(_) -> false,
    TyCon(c) ->
      width_number(c.name) != None || contains(held, c.name)
        || fold(c.args, false, |b: Bool, a: Type| b || reaches_width(a, held)),
    TyFn(_) -> false,
    TyRecord(fs) -> fold(fs, false, |b: Bool, field: Field| b || reaches_width(field.ty, held)),
    TyNominal(n) ->
      fold(n.fields, false, |b: Bool, field: Field| b || reaches_width(field.ty, held)),
  }

fn is_plain(carry: Carry) -> Bool = match carry { CPlain -> true, _ -> false }

/// `ty`'s carry, each type variable numbered by its place in `vars`, and one not there past them.
fn carry(cr: Carrier, vars: List<Int>, ty: Type) -> Carry / {abort.raise} =
  match ty {
    TyVar(v) -> CVar(var_number(vars, v)),
    TyCon(c) -> match width_number(c.name) {
      Some(n) -> CWidth(n),
      None -> {
        let args = carries(cr, vars, c.args);
        let plain = fold(args, true, |b: Bool, a: Carry| b && is_plain(a));
        if (c.name == b"List" || c.name == b"Array") && len(args) == 1 {
          if plain { CPlain } else { CList(at(args, 0)) }
        } else if c.name == b"Map" && len(args) == 2 {
          if plain { CPlain } else { CMap(at(args, 0), at(args, 1)) }
        } else {
          match map_get(cr.sums, c.name) {
            Some(holds) -> if holds || !plain { CSum(args) } else { CPlain },
            None -> CPlain,
          }
        }
      },
    },
    TyFn(f) -> {
      let params = carries(cr, vars, f.params);
      let ret = carry(cr, vars, f.ret);
      if is_plain(ret) && fold(params, true, |b: Bool, p: Carry| b && is_plain(p)) { CPlain }
      else { CFn(params, ret) }
    },
    TyRecord(fs) -> carry_fields(cr, vars, fs),
    // What is read is the record a `new` record is at run time.
    TyNominal(n) -> carry_fields(cr, vars, n.fields),
  }

fn carry_fields(cr: Carrier, vars: List<Int>, fs: List<Field>) -> Carry / {abort.raise} = {
  let fields = map(fs, |f: Field| { name: f.name, carry: carry(cr, vars, f.ty) });
  if fold(fields, true, |b: Bool, f: CarriedField| b && is_plain(f.carry)) { CPlain }
  else { CRecord(fields) }
}

fn carries(cr: Carrier, vars: List<Int>, tys: List<Type>) -> List<Carry> / {abort.raise} =
  map(tys, |ty: Type| carry(cr, vars, ty))

/// An operation's type variable is fixed where it is performed, which its host never sees: a value
/// there reads as it is, and the host takes it by its own contract.
fn grounded(c: Carry) -> Carry =
  match c {
    CVar(_) -> CPlain,
    CList(x) -> {
      let g = grounded(x);
      if is_plain(g) { CPlain } else { CList(g) }
    },
    CMap(k, v) -> {
      let gk = grounded(k);
      let gv = grounded(v);
      if is_plain(gk) && is_plain(gv) { CPlain } else { CMap(gk, gv) }
    },
    CRecord(fs) -> {
      let gs = map(fs, |f: CarriedField| { name: f.name, carry: grounded(f.carry) });
      if fold(gs, true, |b: Bool, f: CarriedField| b && is_plain(f.carry)) { CPlain }
      else { CRecord(gs) }
    },
    CSum(ps) -> CSum(map(ps, grounded)),
    CFn(ps, r) -> {
      let gs = map(ps, grounded);
      let gr = grounded(r);
      if is_plain(gr) && fold(gs, true, |b: Bool, p: Carry| b && is_plain(p)) { CPlain }
      else { CFn(gs, gr) }
    },
    other -> other,
  }

fn var_number(vars: List<Int>, v: Int) -> Int / {abort.raise} =
  fold(range(0, len(vars)), len(vars) + v, |acc: Int, i: Int|
    if acc >= len(vars) && at(vars, i) == v { i } else { acc })

/// The type variables `tys` name, in the order they first appear.
fn vars_in(tys: List<Type>) -> List<Int> = fold(tys, [], vars_of)

fn vars_of(seen: List<Int>, ty: Type) -> List<Int> =
  match ty {
    TyVar(v) -> if contains(seen, v) { seen } else { push(seen, v) },
    TyCon(c) -> fold(c.args, seen, vars_of),
    TyFn(f) -> vars_of(fold(f.params, seen, vars_of), f.ret),
    TyRecord(fs) -> fold(fs, seen, |acc: List<Int>, f: Field| vars_of(acc, f.ty)),
    TyNominal(n) -> fold(n.args, seen, vars_of),
  }

fn emit_signature(ty: Type) -> { params: List<Type>, ret: Type } =
  match ty { TyFn(f) -> { params: f.params, ret: f.ret }, other -> { params: [], ret: other } }

/// Every root is built here, so what the seam reads of it comes from the types it carries. `vars`
/// numbers the type variables those types share.
fn emit_root(
  cr: Carrier,
  vars: List<Int>,
  witnesses: List<Int>,
  root: Bytes,
  params: List<Type>,
  answer: Type,
  labels: Int,
  pure: Bool,
  place: ModuleSpan,
) -> EmitterRoot / {abort.raise} = {
  let taken = concat(map(witnesses, |w: Int| int_type()), params);
  {
    root: root,
    arity: len(taken) + labels,
    pure: pure,
    at: place,
    params: carries(cr, vars, taken),
    answer: carry(cr, vars, answer),
    witnesses: witnesses,
  }
}

fn emit_proposition(
  cr: Carrier,
  vars: List<Int>,
  witnesses: List<Int>,
  root: Bytes,
  params: List<Type>,
  place: ModuleSpan,
) -> EmitterRoot / {abort.raise} =
  emit_root(cr, vars, witnesses, root, params, bool_type(), 0, false, place)

/// The type variables a definition's `numeric` and `integer` constraints are about, by its scheme's
/// numbering and in its order: the witnesses it takes ahead of its parameters, as its clauses do.
fn witness_vars(def: DefInfo) -> List<Int> =
  fold(def.constraints, [], |acc: List<Int>, c: DefConstraint|
    if !is_predicate(c.deriver) || contains(acc, c.param) { acc } else { push(acc, c.param) })

/// Every root the emitter offers: the functions in source order, then the tests, then the spec
/// clauses, law parts and the roots that list a test's cases. A label parameter is a trailing
/// `Word` of the emitted body, so an arity counts it.
fn emitter_roots(
  mods: List<ParsedModule>,
  checked: CheckOutput,
  cr: Carrier,
) -> List<EmitterRoot> / {abort.raise} = {
  let defs = map_of_entries(map(checked.defs, |d: DefInfo| { key: d.name, value: d }));
  let laws = map_of_entries(map(checked.laws, |l: LawInfo| { key: l.key, value: l }));
  let tests = map_of_entries(map(checked.tests, |t: TestInfo| { key: t.key, value: t }));
  let walked = fold(
    mods,
    { fns: [], tests: [], specs: [] },
    |acc: EmitTables, parsed: ParsedModule| {
      let items = fold(
        parsed.module.items,
        { fns: [], tests: [], specs: [], ordinal: 0, law_ordinal: 0 },
        |a: EmitWalk, item: Item|
          match item {
            IFn(d) -> {
              let name = qualify(parsed.name, d.name.name);
              match map_get(defs, name) {
                None -> a,
                Some(def) -> {
                  let sig = emit_signature(def.scheme.ty);
                  let vars = def.scheme.ty_vars;
                  let witnesses = witness_vars(def);
                  let place = span_at(def.at.module, def.at.span);
                  let fn_row = emit_root(
                    cr,
                    vars,
                    witnesses,
                    name,
                    sig.params,
                    sig.ret,
                    len(def.scheme.label_vars),
                    published_pure(def),
                    place,
                  );
                  let clauses = fold(
                    range(0, len(d.spec)),
                    { rows: [], requires: 0, ensures: 0 },
                    |b: { rows: List<EmitterRoot>, requires: Int, ensures: Int }, i: Int| {
                      match at(d.spec, i).kind {
                        SRequires -> {
                          let root = key_clause_root(name, b"requires", b.requires);
                          let row = emit_proposition(cr, vars, witnesses, root, sig.params, place);
                          { rows: push(b.rows, row), requires: b.requires + 1, ensures: b.ensures }
                        },
                        // `ensures` also takes `result`.
                        SEnsures -> {
                          let root = key_clause_root(name, b"ensures", b.ensures);
                          let row = emit_proposition(
                            cr,
                            vars,
                            witnesses,
                            root,
                            push(sig.params, sig.ret),
                            place,
                          );
                          { rows: push(b.rows, row), requires: b.requires, ensures: b.ensures + 1 }
                        },
                        SCost -> b,
                      }
                    },
                  );
                  { ..a, fns: push(a.fns, fn_row), specs: concat(a.specs, clauses.rows) }
                },
              }
            },
            ITest(d) -> {
              let place = match map_get(tests, qualify(parsed.name, d.name)) {
                Some(t) -> span_at(t.at.module, t.at.span),
                None -> no_module_span(),
              };
              let root = qualify(parsed.name, key_test_root(a.ordinal));
              // Over cases it is entered with a case's place and identity; a second root lists them.
              let taken = if d.cases == None { [] } else { [int_type(), bytes_type()] };
              let row = emit_root(cr, [], [], root, taken, unit_type(), 0, false, place);
              let listed = if d.cases == None { a.specs } else {
                push(
                  a.specs,
                  emit_root(cr, [], [], cases_root(root), [], listing_ty(), 0, false, place),
                )
              };
              { ..a, tests: push(a.tests, row), specs: listed, ordinal: a.ordinal + 1 }
            },
            ILaw(d) -> {
              let name = qualify(parsed.name, d.name);
              let law = map_get(laws, name);
              let guarded = match law { Some(l) -> l.has_guard, None -> false };
              let measured = match law { Some(l) -> l.cost, None -> false };
              let binders = match law {
                Some(l) -> map(l.binders, |b: LawBinder| b.ty),
                None -> [],
              };
              let vars = vars_in(binders);
              let place = match law {
                Some(l) -> span_at(l.at.module, l.at.span),
                None -> no_module_span(),
              };
              let rows = map(
                if guarded { [b"guard", b"body"] } else { [b"body"] },
                |part: Bytes| {
                  let root = qualify(parsed.name, key_law_root(a.law_ordinal, part));
                  if measured && part == b"body" {
                    emit_root(cr, vars, [], root, binders, measure_ty(), 0, false, place)
                  } else { emit_proposition(cr, vars, [], root, binders, place) }
                },
              );
              { ..a, specs: concat(a.specs, rows), law_ordinal: a.law_ordinal + 1 }
            },
            _ -> a,
          },
      );
      {
        fns: concat(acc.fns, items.fns),
        tests: concat(acc.tests, items.tests),
        specs: concat(acc.specs, items.specs),
      }
    },
  );
  concat(concat(walked.fns, walked.tests), walked.specs)
}

fn ordinal_row(parsed: ParsedModule) -> OrdinalRow / {abort.raise} =
  {
    module: parsed.name,
    items: fold(parsed.module.items, [], |acc: List<Bytes>, item: Item|
      match item {
        IFn(d) -> {
          // A `cost` clause is measured through the law it becomes, so it is no clause root.
          let rooted = filter(d.spec, |clause: SpecClause| clause.kind != SCost);
          let kinds = if len(rooted) == 0 { b"" } else {
            bytes_concat(
              b" ",
              join(map(rooted, |clause: SpecClause| spec_kind_text(clause.kind)), b","),
            )
          };
          push(acc, bytes_concat_all([b"fn ", qualify(parsed.name, d.name.name), kinds]))
        },
        ITest(d) -> push(acc, bytes_concat(b"test ", qualify(parsed.name, d.name))),
        ILaw(d) -> push(acc, bytes_concat(b"law ", qualify(parsed.name, d.name))),
        _ -> acc,
      }),
  }

/// The definitions by where they are written: the order the checker takes them in follows what
/// their bodies call, which a module read as a stub does not show.
fn in_place(defs: List<DefInfo>) -> List<DefInfo> =
  sort_by(defs, |a: DefInfo, b: DefInfo|
    if a.at.module != b.at.module { a.at.module < b.at.module }
    else if a.at.span.start != b.at.span.start { a.at.span.start < b.at.span.start }
    else { match compare_values(a.name, b.name) { Greater -> false, _ -> true } })

fn tables(
  warnings: List<Diag>,
  mods: List<ParsedModule>,
  resolved: Resolved,
  checked: CheckOutput,
  index: Index,
  hashes: HashOutput,
  packages: List<PackageDeps>,
  pins: List<Pinned>,
  module_packages: List<Int>,
  embeds: List<EmbedAt>,
  stub_cuts: Map<Bytes, List<Cut>>,
) -> Dump / {abort.raise} = {
  let fns = fn_written(mods);
  let effs = effect_written(mods);
  let names = test_name_spans(mods);
  let lits = law_literals(mods);
  let cr = carrier_of(checked.ctors);
  let mod_names = map(mods, |parsed: ParsedModule| parsed.name);
  {
    diags: map(warnings, answered_diag),
    order: map(resolved.order, |i: Int| at(mods, i).name),
    packages: packages,
    pins: pins,
    module_packages: module_packages,
    modules: map(range(0, len(mods)), |i: Int|
      module_row(i, at(mods, i), resolved, checked.effects, mod_names, stub_cuts)),
    defs: map(in_place(checked.defs), |def_info: DefInfo|
      def_row(def_info, written_of(fns, def_info.name))),
    types: type_rows(mods),
    tests: map(range(0, len(checked.tests)), |i: Int| test_row(at(checked.tests, i), at(names, i))),
    laws: map(range(0, len(checked.laws)), |i: Int| law_row(at(checked.laws, i), at(lits, i))),
    effects: map(checked.effects, |effect_info: EffectInfo|
      effect_row(effect_info, effect_public_of(effs, effect_info), cr)),
    ctors: map(checked.ctors, ctor_row),
    hashes: hash_rows(index, hashes),
    hashes_digest: digest(hashes),
    keys: root_keys(mods, checked, hashes),
    emitter_roots: emitter_roots(mods, checked, cr),
    baked: map(const_sites(mods, hashes), |site: ConstSite| { name: site.name, hash: site.hash }),
    emitter_ctors: emitter_ctors_of(mods, checked, cr),
    ordinals: map(mods, ordinal_row),
    bodies: hashes.bodies,
    test_bodies: hashes.test_bodies,
    embeds: embeds,
    rows: rows_from(checked, hashes),
    walked: bin::encode(walked_of(mods, checked), walked_facts_bin()),
  }
}

/// Every table the front end holds for a program that checks, for a caller that wants them rather
/// than their framing: `ply defs`, `ply hash` and `ply doc` are written against this.
pub type Analysis = {
  mods: List<ParsedModule>,
  r: Resolved,
  checked: CheckOutput,
  index: Index,
  hashes: HashOutput,
  warnings: List<Diag>,
  /// The project's `ply.pkg`, decoded; `None` is the anonymous package.
  manifest: Option<Manifest>,
  /// The closure's packages and each module's package, so the emitter and the claims lowerer
  /// resolve imports the way the front end did.
  packages: List<PackageDeps>,
  /// What each dependency is, as `ply.lock` pins it.
  pins: List<Pinned>,
  module_packages: List<Int>,
  /// The modules a compiled package's stubs stand for: their bodies are blanks. `stub_cuts` are
  /// what each one's source was cut by, and what a module read without its tests and laws is.
  stubs: List<Bytes>,
  stub_cuts: Map<Bytes, List<Cut>>,
  /// What each module embeds, for every pass that parses its text again.
  embeds: List<EmbedAt>,
}

/// A stage that reports stops the rest, so a refusal is the diagnostics of exactly one stage.
pub type AnalysisOutcome = | Refused(List<Diag>) | Analysed(Analysis)

/// A tagged literal of a checked program: where it is, each text of its string as written and as
/// it reads, and the definition its check runs, under the hash of all that definition reaches.
/// One with no hole has one text, which its `literal` is run on; any other has a text more than
/// it has holes, which its `compile` is run on together.
pub type TaggedSite = {
  module: Int,
  span: Span,
  tag: Bytes,
  parts: List<TaggedPart>,
  callee: Bytes,
  hash: Bytes,
}

/// Every tagged literal the root package's modules hold. A module read as its stub holds none: one
/// that writes a tagged literal is never kept as one.
pub fn tagged_sites(analysis: Analysis) -> List<TaggedSite> / {abort.raise} = {
  let hashes = by_name(analysis.hashes.defs);
  fold(range(0, len(analysis.mods)), [], |acc: List<TaggedSite>, i: Int|
    if list_at(analysis.module_packages, i) != Some(0) { acc } else {
      fold(tagged_in(at(analysis.mods, i).module), acc, |sites: List<TaggedSite>, t: Tagged|
        match tagged_target(analysis.index, i, t) {
          None -> sites,
          Some(callee) ->
            push(sites, {
              module: i,
              span: t.span,
              tag: t.tag.name,
              parts: tagged_parts(t),
              callee: callee,
              hash: match map_get(hashes, callee) { Some(h) -> h, None -> b"" },
            }),
        })
    })
}

/// A `const` definition of a checked program: where it is written, and the hash of all it reaches,
/// which a build keeps its value under.
pub type ConstSite = { module: Int, span: Span, name: Bytes, hash: Bytes }

/// Every `const` definition the program holds, whichever package declares it. One in a shipped
/// module that the program does not reach has no hash, and is none of the program's.
pub fn const_sites(
  mods: List<ParsedModule>,
  hashes: HashOutput,
) -> List<ConstSite> / {abort.raise} = {
  let hashed = by_name(hashes.defs);
  fold(range(0, len(mods)), [], |acc: List<ConstSite>, i: Int|
    fold(at(mods, i).module.items, acc, |sites: List<ConstSite>, item: Item|
      match item {
        IFn(d) -> if d.baked == None { sites } else {
          let name = qualify(at(mods, i).name, d.name.name);
          match map_get(hashed, name) {
            Some(h) -> push(sites, { module: i, span: d.name.span, name: name, hash: h }),
            None -> sites,
          }
        },
        _ -> sites,
      }))
}

/// A definition's or a test's published rows as the last answer wrote them, under the check key it
/// had then: the checker takes them wherever the item's own form and what it reads of the rest of
/// the program are what they were, and walks the rest. A row's atoms name effects the item may
/// never mention, which its key does not pin. `effect_hashes` is the name and hash each of those
/// declarations had, and a row whose effects no longer hash so is not a row about this program.
pub type EffectHash = { name: Bytes, hash: Bytes }
pub type KnownDefRow = {
  name: Bytes,
  hash: Bytes,
  effect_hashes: List<EffectHash>,
  footprint: Bytes,
  performed: Bytes,
  scaling: Bytes,
  repeats: List<Int>,
  /// Whether its calls end and how it calls what it is handed, which a stub's blank body cannot say.
  ending: Ending,
  summary: Summary,
  /// What the emitter reads of its body, as `filed_facts` writes it.
  facts: Bytes,
}
/// `owner` is the test as the checker files its sites: its module and its place among the module's.
pub type KnownTestRow = {
  key: Bytes,
  hash: Bytes,
  effect_hashes: List<EffectHash>,
  footprint: Bytes,
  owner: Bytes,
  facts: Bytes,
}

fn still_hashed(now: Map<Bytes, Bytes>, name: Bytes, was: Bytes) -> Bool =
  match map_get(now, name) { Some(h) -> h == was, None -> false }

fn effect_hashes_hold(decls: Map<Bytes, Bytes>, effect_hashes: List<EffectHash>) -> Bool =
  fold(effect_hashes, true, |acc: Bool, entry: EffectHash|
    acc && still_hashed(decls, entry.name, entry.hash))

/// How a row is taken: as it is, under the key it was filed with, or not at all.
type Taking = | TakeWhole | TakeKeyed | TakeNone

fn known_defs(
  rows: List<KnownDefRow>,
  taking: (KnownDefRow) -> Taking / {abort.raise},
) -> Map<Bytes, KnownDef> / {abort.raise} =
  fold(rows, map_new(), |acc: Map<Bytes, KnownDef>, row: KnownDefRow| {
    let how = taking(row);
    if how == TakeNone { acc } else {
      match ((read_atoms(row.footprint), read_atoms(row.performed), read_atoms(row.scaling))) {
        (Some(footprint), Some(performed), Some(scaling)) ->
          map_insert(acc, row.name, {
            key: if how == TakeWhole { None } else { Some(row.hash) },
            footprint: footprint,
            performed: performed,
            scaling: scaling,
            repeats: row.repeats,
            ending: row.ending,
            summary: row.summary,
            facts: row.facts,
          }),
        _ -> acc,
      }
    }
  })

/// One slot per `test` of each module, in source order, as `check_tests` walks them.
fn known_tests(
  mods: List<ParsedModule>,
  rows: List<KnownTestRow>,
  taking: (KnownTestRow) -> Taking / {abort.raise},
) -> Map<Bytes, List<Option<KnownTest>>> / {abort.raise} = {
  let by_key = fold(rows, map_new(), |acc: Map<Bytes, KnownTestRow>, r: KnownTestRow|
    map_insert(acc, r.key, r));
  fold(mods, map_new(), |acc: Map<Bytes, List<Option<KnownTest>>>, parsed: ParsedModule|
    map_insert(
      acc,
      parsed.name,
      fold(parsed.module.items, [], |slots: List<Option<KnownTest>>, item: Item|
        match item {
          ITest(d) ->
            push(slots, match map_get(by_key, qualify(parsed.name, d.name)) {
              None -> None,
              Some(r) -> {
                let how = taking(r);
                if how == TakeNone { None } else {
                  match read_atoms(r.footprint) {
                    None -> None,
                    Some(atoms) ->
                      Some({
                        key: if how == TakeWhole { None } else { Some(r.hash) },
                        footprint: atoms,
                        facts: r.facts,
                      }),
                  }
                }
              },
            }),
          _ -> slots,
        }),
    ))
}

/// What each name says to whoever references it, apart from what its checked rows add: a
/// declaration's hash and a definition's contract, both where a name is in two namespaces.
fn said_of(hashes: HashOutput) -> Map<Bytes, Bytes> =
  fold(
    hashes.contracts,
    by_name(hashes.decls),
    |acc: Map<Bytes, Bytes>, c: { name: Bytes, hash: Bytes }|
      map_insert(acc, c.name, match map_get(acc, c.name) {
        Some(decl) -> bytes_concat(decl, c.hash),
        None -> c.hash,
      }),
  )

/// The rows a load was handed, each under the check key it was filed with, and what the checker
/// keys this program by. A fixed definition's body is a blank, so the row its package carries is
/// matched under the hash it compiled with and taken as it is; it is keyed all the same, so the
/// row filed for it here stands when its module is read from source again.
fn known_from_rows(
  mods: List<ParsedModule>,
  hashes: HashOutput,
  defs: List<KnownDefRow>,
  tests: List<KnownTestRow>,
  root: Int,
  fixed: List<Fixed>,
  texts: List<Bytes>,
  blank: Map<Bytes, Bool>,
) -> Known / {abort.raise} = {
  let decls = by_name(hashes.decls);
  let held = fold(fixed, map_new(), |acc: Map<Bytes, Bytes>, f: Fixed|
    if f.decl { acc } else { map_insert(acc, f.name, f.hash) });
  let written = layouts(mods, texts);
  {
    // A body that holds a foreign site is filed by where another module's text stands, which a
    // key does not say: it is taken only with a stub, which stands while both texts do.
    defs: known_defs(defs, |row: KnownDefRow|
      if !effect_hashes_hold(decls, row.effect_hashes) { TakeNone } else {
        match map_get(held, row.name) {
          Some(h) -> if h == row.hash { TakeWhole } else { TakeNone },
          None -> if foreign_facts(row.facts) { TakeNone } else { TakeKeyed },
        }
      }),
    tests: known_tests(mods, tests, |row: KnownTestRow|
      if effect_hashes_hold(decls, row.effect_hashes) && !foreign_facts(row.facts) { TakeKeyed }
      else { TakeNone }),
    root: root,
    keying: Some({
      own: by_name(hashes.own),
      test_own: hashes.test_texts,
      layout: written.defs,
      test_layout: written.tests,
      reads: by_name_names(hashes.deps),
      said: said_of(hashes),
      blank: blank,
    }),
  }
}

/// The text each definition and each test is written as, digested: a definition's by its name, a
/// test's in the order the tests are checked. A module with no text here has none.
fn layouts(
  mods: List<ParsedModule>,
  texts: List<Bytes>,
) -> { defs: Map<Bytes, Bytes>, tests: List<Bytes> } / {abort.raise} =
  fold(
    range(0, len(mods)),
    { defs: map_new(), tests: [] },
    |acc: { defs: Map<Bytes, Bytes>, tests: List<Bytes> }, i: Int| {
      let parsed = at(mods, i);
      let text = match list_at(texts, i) { Some(t) -> t, None -> b"" };
      let written = |span: Span|
        if span.start < 0 || span.end > bytes_len(text) || span.start > span.end { b"" }
        else { blake3(bytes_slice(text, span.start, span.end)) };
      fold(
        parsed.module.items,
        acc,
        |a: { defs: Map<Bytes, Bytes>, tests: List<Bytes> }, item: Item|
          match item {
            IFn(d) ->
              { ..a, defs: map_insert(a.defs, qualify(parsed.name, d.name.name), written(d.span)) },
            ITest(d) -> { ..a, tests: push(a.tests, written(d.span)) },
            _ -> a,
          },
      )
    },
  )

/// An analysis's own rows, as a second check of the same program takes them: nothing is keyed.
fn known_own(mods: List<ParsedModule>, rows: Rows, root: Int) -> Known / {abort.raise} =
  {
    defs: known_defs(rows.defs, |row: KnownDefRow| TakeWhole),
    tests: known_tests(mods, rows.tests, |row: KnownTestRow| TakeWhole),
    root: root,
    keying: None,
  }

// --- What the front-end cache files ----------------------------------------------
// The CLI files these after an analysis and hands the rows back to the next one. The store keeps
// them without reading them: a slot under its hash and name, a file's entries under its path. What
// a slot holds beyond the row is what `ply cache inspect` prints.

/// Each effect a row names, under the hash its declaration has. A prelude effect is declared by no
/// source, so it has no entry and no edit can rename it.
fn row_effect_hashes(decls: Map<Bytes, Bytes>, atoms: List<Atom>) -> List<EffectHash> =
  map_fold(
    fold(atoms, map_new(), |acc: Map<Bytes, Bytes>, atom: Atom|
      match map_get(decls, atom.effect) {
        Some(h) -> map_insert(acc, atom.effect, h),
        None -> acc,
      }),
    [],
    |acc: List<EffectHash>, name: Bytes, hash: Bytes| push(acc, { name: name, hash: hash }),
  )

fn def_known_row(
  decls: Map<Bytes, Bytes>,
  def_info: DefInfo,
  hash: Bytes,
  read: BodiesRead,
) -> KnownDefRow / {abort.raise} =
  {
    name: def_info.name,
    hash: hash,
    effect_hashes: row_effect_hashes(decls, concat(def_info.footprint, def_info.performed)),
    footprint: atoms_text(def_info.footprint, b","),
    performed: atoms_text(def_info.performed, b","),
    scaling: atoms_text(def_info.scaling, b","),
    repeats: def_info.repeats,
    ending: def_info.ending,
    summary: def_info.summary,
    facts: facts_filed(read, def_info.name, def_info.at.span),
  }

fn test_known_row(
  decls: Map<Bytes, Bytes>,
  test_info: TestInfo,
  hash: Bytes,
  owner: Bytes,
  read: BodiesRead,
) -> KnownTestRow / {abort.raise} =
  {
    key: test_info.key,
    hash: hash,
    effect_hashes: row_effect_hashes(decls, test_info.footprint),
    footprint: atoms_text(test_info.footprint, b","),
    owner: owner,
    facts: facts_filed(read, owner, test_info.at.span),
  }

/// What the emitter reads of each body: what the rows a body was published from held, and what a
/// walk of the rest recorded.
type BodiesRead = { kept: Map<Bytes, Bytes>, walked: Map<Bytes, RootFacts> }

fn bodies_read(checked: CheckOutput) -> BodiesRead =
  {
    kept: fold(checked.kept, map_new(), |acc: Map<Bytes, Bytes>, k: KeptFacts|
      map_insert(acc, k.name, k.facts)),
    walked: facts_by_owner(checked.facts),
  }

/// One body's facts as its row files them: the bytes its last row held where it was published from
/// that, else what this walk recorded, counted from where its definition starts.
fn facts_filed(read: BodiesRead, owner: Bytes, at: Span) -> Bytes / {abort.raise} =
  match map_get(read.kept, owner) {
    Some(filed) -> filed,
    None ->
      filed_facts(match map_get(read.walked, owner) { Some(f) -> f, None -> no_root_facts() }, at),
  }

/// Each test's owner, in the order the tests were checked.
fn test_owners(tests: List<TestInfo>) -> List<Bytes> =
  fold(
    tests,
    { seen: map_new(), out: [] },
    |acc: { seen: Map<Bytes, Int>, out: List<Bytes> }, t: TestInfo| {
      let position = match map_get(acc.seen, t.module) { Some(n) -> n, None -> 0 };
      {
        seen: map_insert(acc.seen, t.module, position + 1),
        out: push(acc.out, test_owner(t.module, position)),
      }
    },
  ).out

pub type Rows = { defs: List<KnownDefRow>, tests: List<KnownTestRow> }

pub fn no_rows() -> Rows = { defs: [], tests: [] }

/// What an analysis publishes, as the rows the next one is handed, each under the hash it has now.
pub fn rows_of(analysis: Analysis) -> Rows / {abort.raise} =
  rows_from(analysis.checked, analysis.hashes)

/// What the emitter reads of a checked program beyond each body's own row: the definitions
/// published pure, each definition's witness order, and the sites of what is walked afresh every
/// time, a clause or a law. Module indices are into `modules`.
pub type WalkedFacts = {
  modules: List<Bytes>,
  pure: List<Bytes>,
  orders: List<WitnessOrder>,
  loose: RootFacts,
}

derive bin for WalkedFacts

fn walked_of(mods: List<ParsedModule>, checked: CheckOutput) -> WalkedFacts =
  {
    modules: map(mods, |parsed: ParsedModule| parsed.name),
    pure: checked.facts.pure,
    orders: checked.facts.elaboration.orders,
    loose: match map_get(facts_by_owner(checked.facts), b"") {
      Some(f) -> f,
      None -> no_root_facts(),
    },
  }

/// What each definition's rows are filed under: the check key the checker gave it, and its hash
/// where the checker had nothing to key it by.
fn check_keys(checked: CheckOutput, hashes: HashOutput) -> Map<Bytes, Bytes> =
  fold(
    checked.checks,
    by_name(hashes.defs),
    |acc: Map<Bytes, Bytes>, c: { name: Bytes, hash: Bytes }| map_insert(acc, c.name, c.hash),
  )

/// A test's, which is its hash where the checker keyed nothing.
fn test_check_key(checked: CheckOutput, hashes: HashOutput, i: Int) -> Bytes / {abort.raise} =
  match list_at(checked.test_checks, i) {
    Some(k) -> if bytes_len(k) > 0 { k } else { at(hashes.tests, i) },
    None -> at(hashes.tests, i),
  }

fn rows_from(checked: CheckOutput, hashes: HashOutput) -> Rows / {abort.raise} = {
  let keyed = check_keys(checked, hashes);
  let decls = by_name(hashes.decls);
  let read = bodies_read(checked);
  let owners = test_owners(checked.tests);
  {
    defs: fold(checked.defs, [], |acc: List<KnownDefRow>, def_info: DefInfo|
      match map_get(keyed, def_info.name) {
        Some(x) -> push(acc, def_known_row(decls, def_info, x, read)),
        None -> acc,
      }),
    tests: map(range(0, len(checked.tests)), |i: Int|
      test_known_row(
        decls,
        at(checked.tests, i),
        test_check_key(checked, hashes, i),
        at(owners, i),
        read,
      )),
  }
}

/// The rows a compiled package carries: each definition's counts as its row writes them, which is
/// how any other package reads it, so the interface re-derives the same wherever it is cut.
pub fn contracted_rows_of(analysis: Analysis) -> List<KnownDefRow> / {abort.raise} = {
  let infos = fold(analysis.checked.defs, map_new(), |acc: Map<Bytes, DefInfo>, d: DefInfo|
    map_insert(acc, d.name, d));
  map(rows_of(analysis).defs, |row: KnownDefRow|
    match map_get(infos, row.name) {
      Some(d) -> {
        let c = written_counts(d.scheme.ty, d.footprint, d.bounded, d.tail_bounded);
        { ..row, scaling: atoms_text(c.scaling, b","), repeats: c.repeats }
      },
      None -> row,
    })
}

pub type FiledSpan = { start: Int, end: Int }

pub type DefInterface = { row: KnownDefRow, scheme: Bytes }

pub type FiledVariant = { name: Bytes, fields: List<Bytes> }

pub type FiledOp = { name: Bytes, mode: Bytes, resource: Bool, params: List<Bytes>, ret: Bytes }

/// A `type` has its parameter count and variants, an `effect` its operations and whether it is
/// `nondet`.
pub type DeclInterface = {
  effect: Bool,
  arity: Int,
  nondet: Bool,
  variants: List<FiledVariant>,
  ops: List<FiledOp>,
}

// What the store keeps of a definition, a declaration and a test, in the encoding it keeps them in.
derive bin for EffectHash
derive bin for KnownDefRow
derive bin for KnownTestRow
derive bin for Rows
derive bin for DefInterface
derive bin for FiledVariant
derive bin for FiledOp
derive bin for DeclInterface

/// `hash` names the definition and `check` what its rows are taken under; its interface is filed
/// under both, for whoever asks what a definition of that hash published.
pub type FiledDef = { name: Bytes, hash: Bytes, check: Bytes, interface: DefInterface }

pub type FiledDecl = { name: Bytes, hash: Bytes, interface: DeclInterface }

pub type FiledMember = { name: Bytes, span: FiledSpan }

/// `kind` is `fn`, `type` or `effect`: a name declared in two namespaces has an entry in each.
/// `check` is what a `fn`'s interface is filed under; a declaration's is its hash.
pub type FiledEntry = {
  name: Bytes,
  hash: Bytes,
  check: Bytes,
  kind: Bytes,
  span: FiledSpan,
  members: List<FiledMember>,
}

pub type FiledTest = { name: Bytes, hash: Bytes, nondet: Bool, span: FiledSpan, row: KnownTestRow }

/// `source` is the module's index among the analysis's modules, and so its file's among the places.
pub type FiledModule = {
  name: Bytes,
  source: Int,
  entries: List<FiledEntry>,
  tests: List<FiledTest>,
}

pub type FiledBody = { hash: Bytes, body: Bytes }

pub type Filing = {
  modules: List<FiledModule>,
  defs: List<FiledDef>,
  decls: List<FiledDecl>,
  bodies: List<FiledBody>,
}

pub fn filed_span(span: Span) -> FiledSpan = { start: span.start, end: span.end }

/// A type's constructors in declaration order, which is each one's index.
fn ctors_of_type(ctors: List<CtorInfo>, name: Bytes) -> List<CtorInfo> = {
  let mine = filter(ctors, |ctor_info: CtorInfo| ctor_info.type_name == name);
  fold(range(0, len(mine)), [], |acc: List<CtorInfo>, i: Int|
    fold(mine, acc, |a: List<CtorInfo>, ctor_info: CtorInfo|
      if ctor_info.index == i { push(a, ctor_info) } else { a }))
}

fn filed_op(op_info: OpInfo) -> FiledOp / {abort.raise} =
  {
    name: op_info.name,
    mode: mode_text(op_info.mode),
    resource: op_info.resource_param,
    params: map(op_info.params, type_text),
    ret: type_text(op_info.ret),
  }

type Filers = {
  defs: Map<Bytes, DefInfo>,
  types: Map<Bytes, TypeRow>,
  effects: Map<Bytes, EffectInfo>,
  ctors: List<CtorInfo>,
  hashed: Map<Bytes, Bytes>,
  checked: Map<Bytes, Bytes>,
  decls: Map<Bytes, Bytes>,
}

fn fn_entries(f: Filers, name: Bytes) -> List<FiledEntry> =
  match map_get(f.defs, name) {
    None -> [],
    Some(d) -> match map_get(f.hashed, name) {
      None -> [],
      Some(h) -> match map_get(f.checked, name) {
        None -> [],
        Some(k) ->
          [
            {
              name: name,
              hash: h,
              check: k,
              kind: b"fn",
              span: filed_span(d.at.span),
              members: [],
            },
          ],
      },
    },
  }

fn decl_entries(f: Filers, name: Bytes) -> List<FiledEntry> =
  match map_get(f.decls, name) {
    None -> [],
    Some(h) -> match map_get(f.types, name) {
      Some(t) ->
        [
          {
            name: name,
            hash: h,
            check: h,
            kind: b"type",
            span: { start: t.at.start, end: t.at.end },
            members: map(ctors_of_type(f.ctors, name), |ctor_info: CtorInfo|
              { name: ctor_info.simple_name, span: filed_span(ctor_info.at.span) }),
          },
        ],
      None -> match map_get(f.effects, name) {
        None -> [],
        Some(e) ->
          [
            {
              name: name,
              hash: h,
              check: h,
              kind: b"effect",
              span: filed_span(e.at.span),
              members: map(e.ops, |op_info: OpInfo|
                { name: op_info.name, span: filed_span(op_info.at.span) }),
            },
          ],
      },
    },
  }

/// What a module declares, in source order, each name once.
fn module_entries(f: Filers, parsed: ParsedModule) -> List<FiledEntry> = {
  let walked = fold(
    module_items(parsed),
    { seen: map_new(), out: [] },
    |acc: { seen: Map<Bytes, Bool>, out: List<FiledEntry> }, name: Bytes|
      if map_contains(acc.seen, name) { acc } else {
        {
          seen: map_insert(acc.seen, name, true),
          out: concat(concat(acc.out, fn_entries(f, name)), decl_entries(f, name)),
        }
      },
  );
  walked.out
}

fn tests_by_module(
  checked: CheckOutput,
  hashes: HashOutput,
  rows: List<KnownTestRow>,
) -> Map<Bytes, List<FiledTest>> / {abort.raise} =
  fold(range(0, len(checked.tests)), map_new(), |acc: Map<Bytes, List<FiledTest>>, i: Int| {
    let t = at(checked.tests, i);
    let filed = {
      name: t.name,
      hash: at(hashes.tests, i),
      nondet: t.nondet,
      span: filed_span(t.at.span),
      row: at(rows, i),
    };
    map_insert(
      acc,
      t.module,
      push(match map_get(acc, t.module) { Some(xs) -> xs, None -> [] }, filed),
    )
  })

/// The encoding a body's bytes are written in beneath their envelope; a body filed under another is
/// not read back.
pub fn body_encoding() -> Int = 7

/// The hash a stored body is filed under, which its envelope fixes: a definition alone in its
/// component is its bytes' hash, and a cycle's member the hash of the cycle's with its class.
pub fn body_key(body: Bytes) -> Option<Bytes> / {abort.raise} = {
  let n = bytes_len(body);
  let tag = if n == 0 { -1 } else { bytes_at(body, 0) };
  if tag == 0 { Some(blake3(bytes_slice(body, 1, n))) } else if tag == 1 && n >= 5 {
    Some(blake3(bytes_concat(blake3(bytes_slice(body, 5, n)), bytes_slice(body, 1, 5))))
  } else { None }
}

fn listed(h: Option<Bytes>) -> List<Bytes> = match h { Some(x) -> [x], None -> [] }

/// A name's one body answers for each hash the name has; a `fn` and a declaration sharing a name
/// have a body each, and each is filed under the hash it verifies as.
fn filed_bodies(hashes: HashOutput) -> List<FiledBody> / {abort.raise} = {
  let defs = by_name(hashes.defs);
  let decls = by_name(hashes.decls);
  let counted = fold(
    hashes.bodies,
    map_new(),
    |acc: Map<Bytes, Int>, b: { name: Bytes, body: Bytes }|
      map_insert(acc, b.name, match map_get(acc, b.name) { Some(n) -> n + 1, None -> 1 }),
  );
  // A module read through what a load kept of it brings no body: the one filed for its hash stands.
  fold(hashes.bodies, [], |acc: List<FiledBody>, b: { name: Bytes, body: Bytes }|
    if bytes_len(b.body) == 0 { acc } else {
      let alone = match map_get(counted, b.name) { Some(n) -> n == 1, None -> false };
      fold(
        concat(listed(map_get(defs, b.name)), listed(map_get(decls, b.name))),
        acc,
        |a: List<FiledBody>, hash: Bytes|
          if alone || body_key(b.body) == Some(hash) { push(a, { hash: hash, body: b.body }) }
          else { a },
      )
    })
}

/// Everything the front-end cache files after an analysis, as plain data.
pub fn filing(analysis: Analysis) -> Filing / {abort.raise} = {
  let hashed = by_name(analysis.hashes.defs);
  let checked = check_keys(analysis.checked, analysis.hashes);
  let decls = by_name(analysis.hashes.decls);
  let types = type_rows(analysis.mods);
  let f: Filers = {
    defs: map_of_entries(
      map(analysis.checked.defs, |def_info: DefInfo| { key: def_info.name, value: def_info }),
    ),
    types: map_of_entries(map(types, |t: TypeRow| { key: t.name, value: t })),
    effects: map_of_entries(
      map(analysis.checked.effects, |effect_info: EffectInfo|
        { key: effect_info.name, value: effect_info }),
    ),
    ctors: analysis.checked.ctors,
    hashed: hashed,
    checked: checked,
    decls: decls,
  };
  let rows = rows_of(analysis);
  let row_of = fold(rows.defs, map_new(), |acc: Map<Bytes, KnownDefRow>, row: KnownDefRow|
    map_insert(acc, row.name, row));
  let tests = tests_by_module(analysis.checked, analysis.hashes, rows.tests);
  let typed = fold(types, [], |acc: List<FiledDecl>, t: TypeRow|
    match map_get(decls, t.name) {
      None -> acc,
      Some(h) ->
        push(acc, {
          name: t.name,
          hash: h,
          interface: {
            effect: false,
            arity: t.arity,
            nondet: false,
            variants: map(ctors_of_type(analysis.checked.ctors, t.name), |ctor_info: CtorInfo|
              { name: ctor_info.simple_name, fields: map(ctor_info.fields, type_text) }),
            ops: [],
          },
        }),
    });
  {
    modules: map(range(0, len(analysis.mods)), |i: Int| {
      let m = at(analysis.mods, i);
      {
        name: m.name,
        source: i,
        entries: module_entries(f, m),
        tests: match map_get(tests, m.name) { Some(ts) -> ts, None -> [] },
      }
    }),
    // A definition's interface holds while its check key does, which a body edit leaves alone
    // wherever what the edited definition publishes does not move.
    defs: fold(analysis.checked.defs, [], |acc: List<FiledDef>, def_info: DefInfo|
      match ((
          map_get(hashed, def_info.name),
          map_get(checked, def_info.name),
          map_get(row_of, def_info.name),
        )) {
        (Some(h), Some(k), Some(row)) ->
          push(acc, {
            name: def_info.name,
            hash: h,
            check: k,
            interface: { row: row, scheme: scheme_text(def_info.scheme) },
          }),
        _ -> acc,
      }),
    decls: fold(analysis.checked.effects, typed, |acc: List<FiledDecl>, effect_info: EffectInfo|
      match map_get(decls, effect_info.name) {
        None -> acc,
        Some(h) ->
          push(acc, {
            name: effect_info.name,
            hash: h,
            interface: {
              effect: true,
              arity: 0,
              nondet: effect_info.nondet,
              variants: [],
              ops: map(effect_info.ops, filed_op),
            },
          }),
      }),
    bodies: filed_bodies(analysis.hashes),
  }
}

/// What a load takes from compiled packages in place of their modules' bodies, which are blanks.
/// A stub stands in for the module of its name wherever a dependency or the shipped modules supply
/// one. What a stub's source was cut by, which the stub's own text no longer shows.
pub type StubCuts = { name: Bytes, cuts: List<Cut> }

pub type Interfaces = {
  stubs: List<Source>,
  cuts: List<StubCuts>,
  defs: List<KnownDefRow>,
  fixed: List<Fixed>,
}

pub fn no_interfaces() -> Interfaces = { stubs: [], cuts: [], defs: [], fixed: [] }

fn stubbed(ifaces: Interfaces) -> Map<Bytes, Bytes> =
  fold(ifaces.stubs, map_new(), |acc: Map<Bytes, Bytes>, source: Source|
    map_insert(acc, source.name, source.src))

fn read_as(stubs: Map<Bytes, Bytes>, source: Source) -> Source =
  match map_get(stubs, source.name) {
    Some(stub) -> { name: source.name, src: stub },
    None -> source,
  }

pub fn analyse(parsed: List<ParsedSource>) -> AnalysisOutcome / {abort.raise} =
  analyse_with(parsed, [], [])

pub fn analyse_with(
  parsed: List<ParsedSource>,
  defs: List<KnownDefRow>,
  tests: List<KnownTestRow>,
  pkgs: PackageSources = { root: b"", manifest: None, supplied: [] },
  ifaces: Interfaces = { stubs: [], cuts: [], defs: [], fixed: [] },
) -> AnalysisOutcome / {abort.raise} = {
  let clo = closure(pkgs, map(parsed, |p: ParsedSource| p.name));
  let stubs = stubbed(ifaces);
  let all = fold(clo.modules, parsed, |acc: List<ParsedSource>, m: { pkg: Int, src: Source }|
    push(acc, { ..parse_at(len(acc), read_as(stubs, m.src)), src: m.src.src }));
  // The toolchain's own tree loads without its implicit self; this path has no shipped modules list
  // to check the coverage half of that against, and only the toolchain's listings use it.
  let toolchain = fold(parsed, true, |acc: Bool, p: ParsedSource| acc && is_std(p.name));
  analyse_closure(all, clo, concat(defs, ifaces.defs), tests, len(parsed), toolchain, ifaces)
}

/// The packages of a load as the front end's tables take them: the root package first, the
/// shipped modules one past the end, and every module mapped to the package it was parsed from. The
/// order is the root's modules, then the closure's dependency modules, then the pulled shipped
/// modules. The built-in packages: every package's implicit dependencies, pulled on demand like the
/// shipped modules but owned as packages — the two the runtime pre-seeds.
pub fn std_pkg() -> PackageDeps = { prefix: b"std", deps: [] }

pub fn compiler_pkg() -> PackageDeps = { prefix: b"compiler", deps: [b"std"] }

/// The packages of a load as the front end's tables take them: the root package first, then
/// the closure's, then the built-in std, with the shipped modules past the end, and every module
/// mapped to the package it was parsed from. The order is the root's modules, then the closure's
/// dependency modules, then the pulled toolchain modules.
fn pkg_tables(
  parsed: List<ParsedSource>,
  root_count: Int,
  clo: Closure,
  toolchain: Bool,
) -> { pkgs: List<PackageDeps>, module_packages: List<Int>, std: Int, compiler: Int, shipped: Int } / {abort.raise} = {
  let std = if toolchain { 0 - 1 } else { len(clo.packages) };
  let compiler = if toolchain { 0 - 1 } else { std + 1 };
  {
    pkgs: if toolchain {
      map(clo.packages, |package: Package| { prefix: package.prefix, deps: package.deps })
    } else {
      push(
        push(
          map(clo.packages, |package: Package| { prefix: package.prefix, deps: package.deps }),
          std_pkg(),
        ),
        compiler_pkg(),
      )
    },
    // Pulled std publishes as the shipped modules (its internal imports are qualified), and pulled
    // compiler as its own package, which its bare sibling imports resolve against.
    module_packages: map(range(0, len(parsed)), |i: Int|
      if i < root_count { 0 }
      else if i < root_count + len(clo.modules) { at(clo.modules, i - root_count).pkg }
      else if toolchain { len(clo.packages) }
      else if is_compiler(at(parsed, i).name) { std + 1 }
      else { std + 2 }),
    std: std,
    compiler: compiler,
    shipped: if toolchain { len(clo.packages) } else { std + 2 },
  }
}

/// A root module under a built-in package's prefix, which no user's file may claim; the
/// toolchain's own std tree is the one load that may, and it announces itself by covering the
/// whole shipped set.
fn std_squats(
  parsed: List<ParsedSource>,
  root_count: Int,
  toolchain: Bool,
) -> List<{ slot: Int, diag: ParseDiag }> / {abort.raise} =
  if toolchain { [] } else {
    fold(range(0, root_count), [], |acc: List<{ slot: Int, diag: ParseDiag }>, i: Int| {
      let n = at(parsed, i).name;
      let seg = first_segment(n);
      if seg != b"std" && seg != b"compiler" { acc } else {
        push(acc, {
          slot: 0 - i - 1,
          diag: parse_diag(
            b"E0133",
            bytes_concat_all([b"`", n, b"` would shadow the built-in package `", seg, b"`"]),
            [
              parse_label(
                dummy_span(),
                true,
                b"this file claims a module under the toolchain's own prefix",
              ),
            ],
            [
              b"`std` and `compiler` name the modules the toolchain ships; rename the file or the directory",
            ],
          ),
        })
      }
    })
  }

/// A load read and hashed with nothing checked: what every definition hashes to is known before
/// any body is walked.
pub type Hashed = {
  mods: List<ParsedModule>,
  r: Resolved,
  index: Index,
  hashes: HashOutput,
  unused: List<Diag>,
  clo: Closure,
  packages: List<PackageDeps>,
  module_packages: List<Int>,
  root_count: Int,
  ifaces: Interfaces,
  embeds: List<EmbedAt>,
  /// Each module's text as its source holds it, a stub's too.
  texts: List<Bytes>,
  /// What a stub's source was cut by, and a module's read with its tests and laws left out.
  cuts: Map<Bytes, List<Cut>>,
}

fn hashed_closure(
  parsed: List<ParsedSource>,
  clo: Closure,
  root_count: Int,
  toolchain: Bool,
  ifaces: Interfaces = { stubs: [], cuts: [], defs: [], fixed: [] },
  embeds: List<EmbedAt> = [],
  priors: List<Prior> = [],
  cuts: List<StubCuts> = [],
) -> Result<Hashed, List<Diag>> / {abort.raise} = {
  // The packages' identity reports ahead of anything the program text has to say: manifest
  // and graph diags point one slot past every module, in manifest order.
  let pkg_diags = fold(
    std_squats(parsed, root_count, toolchain),
    clo.diags,
    |acc: List<{ slot: Int, diag: ParseDiag }>, sd: { slot: Int, diag: ParseDiag }| push(acc, sd),
  );
  if len(pkg_diags) > 0 {
    Err(
      map(pkg_diags, |sd: { slot: Int, diag: ParseDiag }|
        if sd.slot < 0 { placed(0 - sd.slot - 1, sd.diag) }
        else { placed(len(parsed) + sd.slot, sd.diag) }),
    )
  } else {
    let early = fold(parsed, [], |acc: List<Diag>, p: ParsedSource| concat(acc, p.diags));
    if len(early) > 0 { Err(early) } else {
      let tables = pkg_tables(parsed, root_count, clo, toolchain);
      match resolve_packaged(
          map(parsed, |p: ParsedSource| p.module),
          tables.pkgs,
          tables.module_packages,
          tables.std,
          tables.compiler,
          tables.shipped,
        ) {
        ResolveFailed(ds) -> Err(map(ds, outside_every_module)),
        ResolveSucceeded(x) -> {
          let built = build_index(x.mods, x.r);
          if len(built.diags) > 0 { Err(map(built.diags, outside_every_module)) } else {
            // Hashing reads the tree, not the checker, so what has moved is known before anything is checked.
            let hashed = hashed_and_unused(
              built.index,
              ifaces.fixed,
              tables.module_packages,
              priors,
            );
            Ok({
              mods: x.mods,
              r: x.r,
              index: built.index,
              hashes: hashed.hashes,
              unused: hashed.unused,
              clo: clo,
              packages: tables.pkgs,
              module_packages: tables.module_packages,
              root_count: root_count,
              ifaces: ifaces,
              embeds: embeds,
              texts: map(parsed, |p: ParsedSource| p.src),
              cuts: fold(
                concat(ifaces.cuts, cuts),
                map_new(),
                |acc: Map<Bytes, List<Cut>>, c: StubCuts| map_insert(acc, c.name, c.cuts),
              ),
            })
          }
        },
      }
    }
  }
}

fn checked_closure(
  h: Hashed,
  defs: List<KnownDefRow>,
  tests: List<KnownTestRow>,
) -> AnalysisOutcome / {abort.raise} = {
  let checked: CheckOutput = check_front_with(
    h.r,
    h.mods,
    known_from_rows(
      h.mods,
      h.hashes,
      defs,
      tests,
      h.root_count,
      h.ifaces.fixed,
      h.texts,
      fold(h.ifaces.stubs, map_new(), |acc: Map<Bytes, Bool>, stub: Source|
        map_insert(acc, stub.name, true)),
    ),
  );
  if !checked.ok { Refused(map(checked.diags, outside_every_module)) } else {
    Analysed({
      mods: h.mods,
      r: h.r,
      checked: checked,
      index: h.index,
      hashes: h.hashes,
      // A dependency's unused definitions are its own package's to report.
      warnings: map(
        filter(h.unused, |diag: Diag|
          fold(
            diag.labels,
            false,
            |b: Bool, l: { module: Int, start: Int, end: Int, primary: Bool, text: Bytes }|
              b || (l.primary && l.module < h.root_count),
          )),
        outside_every_module,
      ),
      manifest: at(h.clo.packages, 0).manifest,
      packages: h.packages,
      pins: pins_of(h.clo, h.embeds),
      module_packages: h.module_packages,
      stubs: map(h.ifaces.stubs, |source: Source| source.name),
      stub_cuts: h.cuts,
      embeds: h.embeds,
    })
  }
}

fn analyse_closure(
  parsed: List<ParsedSource>,
  clo: Closure,
  defs: List<KnownDefRow>,
  tests: List<KnownTestRow>,
  root_count: Int,
  toolchain: Bool,
  ifaces: Interfaces = { stubs: [], cuts: [], defs: [], fixed: [] },
  embeds: List<EmbedAt> = [],
  priors: List<Prior> = [],
) -> AnalysisOutcome / {abort.raise} =
  match hashed_closure(parsed, clo, root_count, toolchain, ifaces, embeds, priors) {
    Err(diags) -> Refused(diags),
    Ok(h) -> checked_closure(h, defs, tests),
  }

/// Every table the answer holds, as rows.
/// The answer as a program ships it: what a load walked and what it warned of are functions of the
/// caches it read as much as of the program, and a program that checked runs without either.
pub fn shipped_dump(d: Dump) -> Dump = { ..d, diags: [], walked: b"" }

pub fn dump_of(outcome: AnalysisOutcome) -> Dump / {abort.raise} =
  match outcome {
    Refused(ds) ->
      {
        diags: map(ds, answered_diag),
        order: [],
        packages: [],
        pins: [],
        module_packages: [],
        modules: [],
        defs: [],
        types: [],
        tests: [],
        laws: [],
        effects: [],
        ctors: [],
        hashes: [],
        hashes_digest: b"",
        keys: [],
        emitter_roots: [],
        baked: [],
        emitter_ctors: [],
        ordinals: [],
        bodies: [],
        test_bodies: [],
        embeds: [],
        rows: { defs: [], tests: [] },
        walked: b"",
      },
    Analysed(w) ->
      tables(
        w.warnings,
        w.mods,
        w.r,
        w.checked,
        w.index,
        w.hashes,
        w.packages,
        w.pins,
        w.module_packages,
        w.embeds,
        w.stub_cuts,
      ),
  }

/// A builtin as the checker binds it, the names its parameters are documented under, and the
/// witnesses a `numeric` or `integer` constraint has the elaboration pass ahead of them.
pub type BuiltinRow = { name: Bytes, scheme: Scheme, params: List<Bytes>, witnesses: Int }

/// Every builtin, in the prelude's order.
pub fn builtin_rows() -> List<BuiltinRow> / {abort.raise} =
  map(builtins(), |b: Builtin|
    {
      name: b.name,
      scheme: b.scheme,
      params: b.params,
      witnesses: len(filter(b.constraints, |c: DefConstraint| is_predicate(c.deriver))),
    })

fn global_name(r: Resolved, module: Int, written: Bytes) -> Bytes / {abort.raise} = {
  let q: QName = match bytes_index_of(written, b"::") {
    Some(i) ->
      {
        module: Some({ name: bytes_slice(written, 0, i), span: dummy_span() }),
        name: { name: bytes_slice(written, i + 2, bytes_len(written)), span: dummy_span() },
        span: dummy_span(),
      },
    None -> { module: None, name: { name: written, span: dummy_span() }, span: dummy_span() },
  };
  match find(r, module, ValueSpace, q) { Some(b) -> b.qualified, None -> written }
}

fn named_pat(r: Resolved, m: Int, p: CodePattern) -> CodePattern / {abort.raise} =
  match p {
    PxCtor(c) ->
      PxCtor({
        name: global_name(r, m, c.name),
        args: map(c.args, |a: CodePattern| named_pat(r, m, a)),
      }),
    PxRecord(rc) ->
      PxRecord({
        fields: map(rc.fields, |f: CodePatternField| { name: f.name, pat: named_pat(r, m, f.pat) }),
        rest: rc.rest,
      }),
    PxList(l) ->
      PxList({
        items: map(l.items, |i: CodePattern| named_pat(r, m, i)),
        rest: match l.rest { Some(x) -> Some(named_pat(r, m, x)), None -> None },
      }),
    _ -> p,
  }

fn named_fields(
  resolved: Resolved,
  m: Int,
  fs: List<CodeField>,
) -> List<CodeField> / {abort.raise} =
  map(fs, |field: CodeField| { name: field.name, value: named(resolved, m, field.value) })

fn named_opt(r: Resolved, m: Int, c: Option<Code>) -> Option<Code> / {abort.raise} =
  match c { Some(x) -> Some(named(r, m, x)), None -> None }

fn named_stmt(resolved: Resolved, m: Int, stmt: CodeStmt) -> CodeStmt / {abort.raise} =
  match stmt {
    CLet(l) -> CLet({ name: l.name, slot: l.slot, value: named(resolved, m, l.value) }),
    CLetPat(l) ->
      CLetPat({
        span: l.span,
        pat: named_pat(resolved, m, l.pat),
        value: named(resolved, m, l.value),
      }),
    CDo(d) -> CDo({ code: named(resolved, m, d.code) }),
  }

fn named(resolved: Resolved, m: Int, c: Code) -> Code / {abort.raise} = {
  let n = |x: Code| named(resolved, m, x);
  let ns = |codes: List<Code>| map(codes, |x: Code| named(resolved, m, x));
  let node = match c.node {
    NLit(_) -> c.node,
    NLabel(_) -> c.node,
    NVar(v) -> match v.slot {
      Some(_) -> c.node,
      None -> NVar({ name: global_name(resolved, m, v.name), slot: None }),
    },
    NUnary(u) -> NUnary({ op: u.op, operand: n(u.operand) }),
    NBinary(b) -> NBinary({ op: b.op, lhs: n(b.lhs), rhs: n(b.rhs) }),
    NApp(a) -> NApp({ func: n(a.func), args: ns(a.args) }),
    NIf(i) ->
      NIf({ cond: n(i.cond), then_branch: n(i.then_branch), else_branch: n(i.else_branch) }),
    NBlock(b) ->
      NBlock({
        stmts: map(b.stmts, |stmt: CodeStmt| named_stmt(resolved, m, stmt)),
        tail: named_opt(resolved, m, b.tail),
      }),
    NList(l) -> NList({ items: ns(l.items) }),
    NRecord(rc) -> NRecord({ fields: named_fields(resolved, m, rc.fields) }),
    NMatch(x) ->
      NMatch({
        scrutinee: n(x.scrutinee),
        arms: map(x.arms, |a: CodeArm|
          {
            pat: named_pat(resolved, m, a.pat),
            guard: named_opt(resolved, m, a.guard),
            body: named(resolved, m, a.body),
          }),
      }),
    NPerform(p) ->
      NPerform({
        effect: p.effect,
        op: p.op,
        resource: p.resource,
        label: named_opt(resolved, m, p.label),
        args: ns(p.args),
      }),
    NCell(x) ->
      NCell({
        resource: x.resource,
        binder: x.binder,
        slot: x.slot,
        init: n(x.init),
        body: n(x.body),
      }),
    NLambda(l) ->
      NLambda({ params: l.params, size: l.size, captures: l.captures, body: n(l.body) }),
    NSimulate(x) -> NSimulate({ size: x.size, captures: x.captures, body: n(x.body) }),
    NParallel(x) -> NParallel({ branches: ns(x.branches) }),
    NHandle(h) ->
      NHandle({
        body: n(h.body),
        clauses: map(h.clauses, |clause: CodeClause|
          {
            effect: clause.effect,
            op: clause.op,
            resource: clause.resource,
            label: named_opt(resolved, m, clause.label),
            params: clause.params,
            binds_label: clause.binds_label,
            resume: clause.resume,
            size: clause.size,
            captures: clause.captures,
            body: named(resolved, m, clause.body),
          }),
        ret: match h.ret {
          Some(x) -> Some({ size: x.size, captures: x.captures, body: n(x.body) }),
          None -> None,
        },
      }),
    NField(f) -> NField({ base: n(f.base), field: f.field }),
    NUpdate(u) ->
      NUpdate({ base: n(u.base), copies: u.copies, sets: named_fields(resolved, m, u.sets) }),
  };
  { own: c.own, node: node, span: c.span }
}

/// What the prover reads of a program: each `fn`'s lowered body, clauses and `decreases` measure, and
/// whether the checker saw its calls end, or saw them end only by the measures its group states; each
/// sum type's variant count; and each law. A body the lowering does not take is `None`, which reads
/// as unreached.
pub type Claim =
  /// `costed`: the parameters with a cost name, whose names a `cost` clause binds after the parameters.
  | ClaimDef({ name: Bytes, params: Int, costed: List<Int>, body: Option<Code>, spec: List<ClaimClause>, measure: Option<Code>, ends: Bool, stated: Bool })
  | ClaimSum({ name: Bytes, variants: Int })
  | ClaimLaw({ key: Bytes, guard: Option<Lowered>, body: Option<Code>, costs: Option<{ def: Bytes, index: Int }> })

/// A clause lowered under its binders, and where it is written.
pub type Lowered = { at: ModuleSpan, code: Option<Code> }

pub type ClaimClause = { kind: SpecKind, clause: Lowered }

fn lowered(r: Resolved, m: Int, params: List<Bytes>, expr: Expr) -> Option<Code> / {abort.raise} =
  match lower_fn(params, [], map_new(), expr) { Some(l) -> Some(named(r, m, l.code)), None -> None }

fn lowered_at(
  resolved: Resolved,
  m: Int,
  params: List<Bytes>,
  expr: Expr,
) -> Lowered / {abort.raise} =
  { at: span_at(m, expr_span(expr)), code: lowered(resolved, m, params, expr) }

/// `result` takes the slot after the parameters, as the obligation's binders place it. An opaque
/// definition is claimed by its spec alone: what it promises, not how it is written.
fn def_claim(
  resolved: Resolved,
  m: Int,
  module: Bytes,
  def: FnDef,
  opaque: Bool,
  ends: Bool,
  stated: Bool,
) -> Claim / {abort.raise} = {
  let params = map(def.params, |param: Param| param.name.name);
  let costed = filter(range(0, len(def.params)), |i: Int| at(def.params, i).cost != None);
  let cost_names = fold(def.params, [], |acc: List<Bytes>, param: Param|
    match param.cost { Some(k) -> push(acc, k.name), None -> acc });
  // A `transparent` definition's body is part of what other modules read of it.
  let shown = !opaque || def.transparent != None;
  ClaimDef({
    name: qualify(module, def.name.name),
    ends: ends,
    stated: stated,
    params: len(params),
    costed: costed,
    body: if shown { lowered(resolved, m, params, def.body) } else { None },
    measure: match def.decreases {
      Some(e) -> if shown { lowered(resolved, m, params, e) } else { None },
      None -> None,
    },
    spec: map(def.spec, |clause: SpecClause|
      {
        kind: clause.kind,
        clause: lowered_at(
          resolved,
          m,
          match clause.kind {
            SRequires -> params,
            SEnsures -> push(params, b"result"),
            SCost -> concat(params, cost_names),
          },
          clause.expr,
        ),
      }),
  })
}

fn given_opt(c: Option<Code>, given: Map<Int, Code>) -> Option<Code> =
  match c { Some(x) -> Some(given_in(x, given)), None -> None }

fn given_fields(fs: List<CodeField>, given: Map<Int, Code>) -> List<CodeField> =
  map(fs, |field: CodeField| { name: field.name, value: given_in(field.value, given) })

/// What a barrier copies in of what was given is given inside it, where it was copied to.
fn given_past(
  captures: List<Capture>,
  given: Map<Int, Code>,
) -> { captures: List<Capture>, given: Map<Int, Code> } =
  fold(
    captures,
    { captures: [], given: map_new() },
    |acc: { captures: List<Capture>, given: Map<Int, Code> }, capture: Capture|
      match map_get(given, capture.src) {
        Some(c) -> { ..acc, given: map_insert(acc.given, capture.dst, c) },
        None -> { ..acc, captures: push(acc.captures, capture) },
      },
  )

/// `c` with each read of a slot `given` holds replaced by what it holds: closed code, which reads the
/// same wherever it stands.
fn given_in(c: Code, given: Map<Int, Code>) -> Code = {
  let g = |x: Code| given_in(x, given);
  let gs = |codes: List<Code>| map(codes, |x: Code| given_in(x, given));
  match c.node {
    NLit(_) -> c,
    NLabel(_) -> c,
    NVar(v) -> match v.slot {
      Some(s) -> match map_get(given, s) { Some(x) -> x, None -> c },
      None -> c,
    },
    NUnary(u) -> { ..c, node: NUnary({ op: u.op, operand: g(u.operand) }) },
    NBinary(b) -> { ..c, node: NBinary({ op: b.op, lhs: g(b.lhs), rhs: g(b.rhs) }) },
    NApp(a) -> { ..c, node: NApp({ func: g(a.func), args: gs(a.args) }) },
    NIf(i) ->
      {
        ..c,
        node: NIf({
          cond: g(i.cond),
          then_branch: g(i.then_branch),
          else_branch: g(i.else_branch),
        }),
      },
    NBlock(b) ->
      {
        ..c,
        node: NBlock({
          stmts: map(b.stmts, |stmt: CodeStmt|
            match stmt {
              CLet(l) -> CLet({ name: l.name, slot: l.slot, value: g(l.value) }),
              CLetPat(l) -> CLetPat({ span: l.span, pat: l.pat, value: g(l.value) }),
              CDo(d) -> CDo({ code: g(d.code) }),
            }),
          tail: given_opt(b.tail, given),
        }),
      },
    NList(l) -> { ..c, node: NList({ items: gs(l.items) }) },
    NRecord(rc) -> { ..c, node: NRecord({ fields: given_fields(rc.fields, given) }) },
    NMatch(x) ->
      {
        ..c,
        node: NMatch({
          scrutinee: g(x.scrutinee),
          arms: map(x.arms, |a: CodeArm|
            { pat: a.pat, guard: given_opt(a.guard, given), body: g(a.body) }),
        }),
      },
    NPerform(p) ->
      {
        ..c,
        node: NPerform({
          effect: p.effect,
          op: p.op,
          resource: p.resource,
          label: given_opt(p.label, given),
          args: gs(p.args),
        }),
      },
    NCell(x) ->
      {
        ..c,
        node: NCell({
          resource: x.resource,
          binder: x.binder,
          slot: x.slot,
          init: g(x.init),
          body: g(x.body),
        }),
      },
    NLambda(l) -> {
      let past = given_past(l.captures, given);
      {
        ..c,
        node: NLambda({
          params: l.params,
          size: l.size,
          captures: past.captures,
          body: given_in(l.body, past.given),
        }),
      }
    },
    NSimulate(x) -> {
      let past = given_past(x.captures, given);
      {
        ..c,
        node: NSimulate({
          size: x.size,
          captures: past.captures,
          body: given_in(x.body, past.given),
        }),
      }
    },
    NParallel(x) -> { ..c, node: NParallel({ branches: gs(x.branches) }) },
    NHandle(h) ->
      {
        ..c,
        node: NHandle({
          body: g(h.body),
          clauses: map(h.clauses, |clause: CodeClause| {
            let past = given_past(clause.captures, given);
            { ..clause, captures: past.captures, body: given_in(clause.body, past.given) }
          }),
          ret: match h.ret {
            Some(x) -> {
              let past = given_past(x.captures, given);
              Some({ size: x.size, captures: past.captures, body: given_in(x.body, past.given) })
            },
            None -> None,
          },
        }),
      },
    NField(f) -> { ..c, node: NField({ base: g(f.base), field: f.field }) },
    NUpdate(u) ->
      {
        ..c,
        node: NUpdate({ base: g(u.base), copies: u.copies, sets: given_fields(u.sets, given) }),
      },
  }
}

/// The module an instantiation's schema is declared in, once the resolver has found it.
fn home_of(mods: List<ParsedModule>, of: OfSchema) -> Option<Int> =
  match of.home {
    None -> None,
    Some(name) ->
      fold(range(0, len(mods)), None, |found: Option<Int>, i: Int|
        match found {
          Some(_) -> found,
          None -> match list_at(mods, i) {
            Some(m) -> if m.name == name { Some(i) } else { None },
            None -> None,
          },
        }),
  }

fn fn_named(module: Module, name: Bytes) -> Option<FnDef> =
  fold(module.items, None, |found: Option<FnDef>, item: Item|
    match found {
      Some(_) -> found,
      None -> match item { IFn(d) -> if d.name.name == name { Some(d) } else { None }, _ -> None },
    })

/// What an instantiation's guard or body states: its schema's, with what it was given written where
/// the schema names its parameters, so the claim reads, proves and is cited as that law written out.
/// `call` is the schema's definition called with the arguments and then the binders.
fn instantiated(
  mods: List<ParsedModule>,
  r: Resolved,
  m: Int,
  binders: Int,
  of: OfSchema,
  call: Expr,
) -> Option<Code> / {abort.raise} =
  match ((call, home_of(mods, of))) {
    (EApp(a), Some(home)) -> match a.func {
      EVar(callee) -> match fn_named(at(mods, home).module, callee.name.name.name) {
        None -> None,
        Some(def) -> {
          let params = len(def.params) - binders;
          let names = map(def.params, |param: Param| param.name.name);
          let body = lowered(r, home, concat(drop(names, params), take(names, params)), def.body);
          let given = fold(
            range(0, params),
            Some(map_new()),
            |acc: Option<Map<Int, Code>>, k: Int|
              match ((acc, list_at(a.args, k))) {
                (Some(held), Some(arg)) -> match lowered(r, m, [], arg) {
                  Some(c) -> Some(map_insert(held, binders + k, c)),
                  None -> None,
                },
                _ -> None,
              },
          );
          match ((body, given)) {
            (Some(code), Some(held)) -> Some(given_in(code, held)),
            _ -> None,
          }
        },
      },
      _ -> None,
    },
    _ -> None,
  }

/// A law's guard or body as the prover reads it.
fn stating(
  mods: List<ParsedModule>,
  r: Resolved,
  m: Int,
  law_def: LawDef,
  expr: Expr,
) -> Option<Code> / {abort.raise} = {
  let names = map(law_def.binders, |binder: Binder| binder.name.name);
  let written = match law_def.of {
    Some(of) -> instantiated(mods, r, m, len(names), of, expr),
    None -> None,
  };
  match written { Some(_) -> written, None -> lowered(r, m, names, expr) }
}

fn law_claim(
  mods: List<ParsedModule>,
  r: Resolved,
  m: Int,
  module: Bytes,
  law_def: LawDef,
) -> Claim / {abort.raise} =
  ClaimLaw({
    key: qualify(module, law_def.name),
    guard: match law_def.guard {
      Some(g) -> Some({ at: span_at(m, expr_span(g)), code: stating(mods, r, m, law_def, g) }),
      None -> None,
    },
    body: stating(mods, r, m, law_def, law_def.body),
    costs: match law_def.costs {
      Some(c) -> Some({ def: qualify(module, c.def.name), index: c.index }),
      None -> None,
    },
  })

fn claims_of_modules(
  mods: List<ParsedModule>,
  resolved: Resolved,
  wanted: List<Int>,
  opaque: (Bytes) -> Bool,
  ends: Map<Bytes, Bool>,
  stated: Map<Bytes, Bool>,
) -> List<Claim> / {abort.raise} =
  fold(wanted, [], |acc: List<Claim>, i: Int| {
    let m = at(mods, i);
    fold(m.module.items, acc, |a: List<Claim>, item: Item|
      match item {
        IFn(d) -> {
          let name = qualify(m.name, d.name.name);
          push(
            a,
            def_claim(
              resolved,
              i,
              m.name,
              d,
              opaque(m.name),
              map_contains(ends, name),
              map_contains(stated, name),
            ),
          )
        },
        // A split over a type is sound only with every variant in hand.
        IType(d) -> match d.body {
          TDSum(vs) -> push(a, ClaimSum({ name: qualify(m.name, d.name.name), variants: len(vs) })),
          _ -> a,
        },
        ILaw(d) -> push(a, law_claim(mods, resolved, i, m.name, d)),
        _ -> a,
      })
  })

pub fn claims(
  sources: List<Source>,
  pkgs: List<PackageDeps> = [],
  module_packages: List<Int> = [],
  shipped: Int = 0,
) -> List<Claim> / {abort.raise} = {
  let mods = map(parse_all(sources), |parsed: ParsedSource| parsed.module);
  // The published table ends with the built-in packages; the shipped modules sit one past them.
  let packaged = if len(pkgs) == 0 { no_packages(mods) } else {
    {
      pkgs: pkgs,
      module_packages: module_packages,
      std: shipped - 2,
      compiler: shipped - 1,
      shipped: shipped,
    }
  };
  match resolve_packaged(
      mods,
      packaged.pkgs,
      packaged.module_packages,
      packaged.std,
      packaged.compiler,
      packaged.shipped,
    ) {
    ResolveFailed(_) -> panic("a program the front end checked does not resolve"),
    ResolveSucceeded(x) -> match elaborated(x.r, x.mods) {
      None -> panic("a program the front end checked does not check"),
      Some(e) ->
        claims_of_modules(
          updated_mods(x.mods, e.elaboration),
          x.r,
          range(0, len(x.mods)),
          |m: Bytes| false,
          e.ends,
          e.stated,
        ),
    },
  }
}

/// The claims of the modules at `wanted`, ascending and closed under imports, lowered as `claims`
/// lowers them, from a program `analyse` checked: its parse and resolution are reused, and the checker
/// walks again only the definitions there that write a record update — the one thing lowering reads
/// from it — seeded with every other definition's and test's rows as the next analysis would be.
/// A module the run does not own is claimed by its specs, so its source and its stub answer alike.
pub fn claims_in(
  analysis: Analysis,
  wanted: List<Int>,
  owned: (Bytes) -> Bool = |m: Bytes| true,
) -> List<Claim> / {abort.raise} = {
  let stubs = fold(analysis.stubs, map_new(), |acc: Map<Bytes, Bool>, s: Bytes|
    map_insert(acc, s, true));
  let walked = fold(wanted, map_new(), |acc: Map<Bytes, Bool>, i: Int| {
    let m = at(analysis.mods, i);
    fold(m.module.items, acc, |a: Map<Bytes, Bool>, item: Item|
      match item {
        IFn(d) -> if fn_has_update(d) { map_insert(a, qualify(m.name, d.name.name), true) }
        else { a },
        _ -> a,
      })
  });
  let rows = rows_of(analysis);
  // The analysis held every promise already, so this check of it holds none again.
  let known = known_own(
    analysis.mods,
    {
      defs: filter(rows.defs, |row: KnownDefRow| !map_contains(walked, row.name)),
      tests: rows.tests,
    },
    0,
  );
  match elaboration_with(analysis.r, analysis.mods, known) {
    None -> panic("a program the front end checked does not check"),
    Some(shapes) ->
      claims_of_modules(
        updated_mods(analysis.mods, shapes),
        analysis.r,
        wanted,
        |m: Bytes| map_contains(stubs, m) || !owned(m),
        ended(analysis.checked.defs),
        stated(analysis.checked.defs),
      ),
  }
}

/// Every definition and test re-hashed under `pins`. The package tables are the ones the program
/// was analysed with — a rehash that resolved with pre-package rules would read a dependency's own
/// modules as root ones — and the shipped modules sit one past the published table, as `claims` has
/// it.
pub fn rehash(
  sources: List<Source>,
  pins: List<Pin>,
  pkgs: List<PackageDeps> = [],
  module_packages: List<Int> = [],
  shipped: Int = 0,
  embeds: List<EmbedAt> = [],
) -> Rehashed / {abort.raise} = {
  let tables = embed_tables(embeds);
  let mods = map(parse_all(sources), |parsed: ParsedSource|
    { ..parsed.module, module: rewritten(tables, parsed.name, parsed.module.module).module });
  let packaged = if len(pkgs) == 0 { no_packages(mods) } else {
    {
      pkgs: pkgs,
      module_packages: module_packages,
      std: shipped - 2,
      compiler: shipped - 1,
      shipped: shipped,
    }
  };
  match resolve_packaged(
      mods,
      packaged.pkgs,
      packaged.module_packages,
      packaged.std,
      packaged.compiler,
      packaged.shipped,
    ) {
    ResolveFailed(_) -> panic("a program the front end checked does not resolve"),
    ResolveSucceeded(x) -> rehash_index(build_index(x.mods, x.r).index, pins),
  }
}

// --- Pulling in the shipped modules --------------------------------------------
// As the driver places them: after the program's own modules, a round of new imports at a time, each round in byte order.

fn is_std(name: Bytes) -> Bool = name == b"std" || bytes_starts_with(name, b"std.")

/// The compiler's own modules, filed under one reserved root so a program can import the formatter.
/// A shipped module names its siblings under that root too: the shipped modules are handed over as
/// text, and the emitter parses the same text to name a call, so the root is in the source and not
/// in a tree.
fn is_compiler(name: Bytes) -> Bool = name == b"compiler" || bytes_starts_with(name, b"compiler.")

fn is_shipped(name: Bytes) -> Bool = is_std(name) || is_compiler(name)

fn import_at(imports: List<ImportDecl>, name: Bytes) -> Span / {abort.raise} = {
  let found = fold(imports, None, |acc: Option<Span>, decl: ImportDecl|
    match acc {
      Some(_) -> acc,
      None -> if import_module_name(decl) == name { Some(path_span(decl)) } else { None },
    });
  match found { Some(s) -> s, None -> dummy_span() }
}

fn unknown_shipped(m: Int, span: Span, name: Bytes, listed: List<Bytes>) -> Diag / {abort.raise} =
  error_at(
    b"E0106",
    m,
    span,
    bytes_concat_all([b"no module named `", name, b"` ships with this compiler"]),
    b"not found",
    [
      bytes_concat(b"the stdlib holds: ", backticked(filter(listed, is_std), b", ")),
      b"`ply std` lists them with the digest this binary was built from",
    ],
  )

fn foreign_import(m: Int, span: Span, importer: Bytes, name: Bytes) -> Diag =
  error_at(
    b"E0505",
    m,
    span,
    bytes_concat_all([
      b"the shipped module `",
      importer,
      b"` imports `",
      name,
      b"`, which this build does not ship",
    ]),
    b"a stdlib module may import only modules that ship with it",
    [
      b"this is a defect in the compiler's own sources, not in this program",
      b"please report it with the version of `ply` that produced it",
    ],
  )

type Round = { wanted: Map<Bytes, Bytes>, diags: List<Diag> }

type Wanted = { names: Map<Bytes, Bool>, diags: List<Diag> }

/// The shipped modules `parsed` imports and does not hold yet, by name. A user module names one by its
/// root; a shipped one names its siblings in the compiler package bare. `listed` is every shipped
/// module there is, read or not.
fn wanted(users: Int, listed: List<Bytes>, parsed: List<ParsedSource>) -> Wanted / {abort.raise} = {
  let has = fold(listed, map_new(), |acc: Map<Bytes, Bool>, name: Bytes|
    map_insert(acc, name, true));
  let present = fold(parsed, map_new(), |acc: Map<Bytes, Bool>, p: ParsedSource|
    map_insert(acc, p.name, true));
  fold(range(0, len(parsed)), { names: map_new(), diags: [] }, |acc: Wanted, i: Int| {
    let p = at(parsed, i);
    let imports = p.module.module.imports;
    let ships = i >= users;
    fold(imports, acc, |w: Wanted, decl: ImportDecl| {
      let name = import_module_name(decl);
      if is_shipped(name) && !map_contains(present, name) {
        if map_contains(has, name) { { ..w, names: map_insert(w.names, name, true) } } else {
          {
            ..w,
            diags: push(w.diags, if ships {
              foreign_import(i, import_at(imports, name), p.name, name)
            } else { unknown_shipped(i, import_at(imports, name), name, listed) }),
          }
        }
      } else if ships && !is_shipped(name) {
        // The compiler package's internal import: `import parsing` in `compiler.costs` means `compiler.parsing`.
        let internal = bytes_concat(b"compiler.", name);
        if map_contains(present, internal) { w }
        else if map_contains(has, internal) { { ..w, names: map_insert(w.names, internal, true) } }
        else if is_compiler(p.name) { w } else {
          { ..w, diags: push(w.diags, foreign_import(i, import_at(imports, name), p.name, name)) }
        }
      } else { w }
    })
  })
}

fn pull_round(
  users: Int,
  shipped: Map<Bytes, Bytes>,
  listed: List<Bytes>,
  parsed: List<ParsedSource>,
) -> Round / {abort.raise} = {
  let w = wanted(users, listed, parsed);
  map_fold(w.names, { wanted: map_new(), diags: w.diags }, |r: Round, name: Bytes, _: Bool|
    match map_get(shipped, name) {
      Some(src) -> { ..r, wanted: map_insert(r.wanted, name, src) },
      None -> { ..r, diags: push(r.diags, unread_shipped(name)) },
    })
}

fn unread_shipped(name: Bytes) -> Diag =
  error_at(
    b"E0505",
    0,
    dummy_span(),
    bytes_concat_all([b"the shipped module `", name, b"` is pulled and was never read"]),
    b"the load read its shipped modules before it knew what it pulls",
    [b"this is Ply's fault, not the program's"],
  )

/// The shipped modules a load reads, and the names of the rest, of which it reads none.
pub type Shipping = { read: List<Source>, unread: List<Bytes> }

/// What a load of `user` and its package closure pulls, each module read once through `read`: what
/// they import, what those import in turn, and what any of them embeds beside itself. Handed the
/// read ones, and the rest as `unread`, the front end pulls what it would have pulled from every
/// shipped module.
pub fn shipped_pulled<| e>(
  user: List<Source>,
  pkgs: PackageSources,
  listed: List<Bytes>,
  read: (Bytes) -> Option<Bytes> / e,
) -> Shipping / {abort.raise | e} = {
  let clo = closure(pkgs, map(user, |s: Source| s.name));
  let own = concat(user, map(clo.modules, |m: { pkg: Int, src: Source }| m.src));
  let parsed = map(range(0, len(own)), |i: Int| headed_at(i, at(own, i)));
  let found = needing(
    len(own),
    listed,
    read,
    { parsed: parsed, found: [], tried: map_new() },
    len(listed) + 1,
  ).found;
  let held = fold(found, map_new(), |acc: Map<Bytes, Bool>, s: Source|
    map_insert(acc, s.name, true));
  { read: found, unread: filter(listed, |name: Bytes| !map_contains(held, name)) }
}

type Needed = { parsed: List<ParsedSource>, found: List<Source>, tried: Map<Bytes, Bool> }

/// A round of reads at a time, each of what the last round's modules import and nothing read before;
/// `room` bounds the rounds, as each reads at least one module no earlier round did.
fn needing<| e>(
  users: Int,
  listed: List<Bytes>,
  read: (Bytes) -> Option<Bytes> / e,
  x: Needed,
  room: Int,
) -> Needed / {abort.raise | e} = {
  let names = filter(map_keys(wanted(users, listed, x.parsed).names), |name: Bytes|
    !map_contains(x.tried, name));
  if len(names) == 0 || room <= 0 { x } else {
    needing(
      users,
      listed,
      read,
      fold(names, x, |acc: Needed, name: Bytes| {
        let tried = map_insert(acc.tried, name, true);
        match read(name) {
          None -> { ..acc, tried: tried },
          Some(src) -> {
            let source = { name: name, src: src };
            let p = headed_at(len(acc.parsed), source);
            beside(
              listed,
              read,
              { parsed: push(acc.parsed, p), found: push(acc.found, source), tried: tried },
              source,
            )
          },
        }
      }),
      room - 1,
    )
  }
}

/// What a pulled module embeds from beside itself, read once: the prelude beside the compiler's
/// package is one, which no module imports.
fn beside<| e>(
  listed: List<Bytes>,
  read: (Bytes) -> Option<Bytes> / e,
  x: Needed,
  source: Source,
) -> Needed / {abort.raise | e} =
  if !names_embed(source.src) { x } else {
    fold(wants_of(parse(source.src).node), x, |acc: Needed, want: EmbedWant|
      if want.dir { acc } else {
        match shipped_name(source.name, want.path) {
          None -> acc,
          Some(name) -> if map_contains(acc.tried, name) || !list::contains(listed, name) { acc }
          else {
            let tried = map_insert(acc.tried, name, true);
            match read(name) {
              None -> { ..acc, tried: tried },
              Some(src) ->
                { ..acc, found: push(acc.found, { name: name, src: src }), tried: tried },
            }
          },
        }
      })
  }

fn without_last(xs: List<Bytes>) -> List<Bytes> / {abort.raise} =
  fold(range(0, len(xs) - 1), [], |acc: List<Bytes>, i: Int| push(acc, at(xs, i)))

/// The name the shipped modules give what sits at `path` beside the shipped module `module`. They
/// hold a package, and what lies beside its directory, under the package's one root:
/// `../prelude.ply` beside `compiler.infer` is `compiler.prelude`.
fn shipped_name(module: Bytes, path: Bytes) -> Option<Bytes> / {abort.raise} = {
  let walked = fold(
    bytes_split(path, b"/"),
    without_last(bytes_split(module, b".")),
    |dir: List<Bytes>, part: Bytes|
      if part == b"" || part == b"." { dir }
      else if part == b".." { if len(dir) > 1 { without_last(dir) } else { dir } }
      else { push(dir, part) },
  );
  match list_at(walked, len(walked) - 1) {
    None -> None,
    Some(file) -> if len(walked) < 2 || !bytes_ends_with(file, b".ply") { None } else {
      Some(join(push(without_last(walked), bytes_slice(file, 0, bytes_len(file) - 4)), b"."))
    },
  }
}

type Pull = {
  parsed: List<ParsedSource>,
  pulled: List<Bytes>,
  embeds: List<EmbedAt>,
  diags: List<Diag>,
  /// What each module read whole is cut by, where its tests and laws were left out.
  cuts: List<StubCuts>,
}

/// What a module read whole is cut by, noted before its tests and laws are left out: a stub of it
/// blanks them too, and its own cuts are what the stub was made with.
fn uncut(cuts: List<StubCuts>, stubs: Map<Bytes, Bytes>, p: ParsedSource) -> List<StubCuts> =
  if map_contains(stubs, p.name) { cuts }
  else { push(cuts, { name: p.name, cuts: cuts_of(p.module) }) }

/// A module with its tests and laws left out.
fn untested(p: ParsedSource) -> ParsedSource =
  {
    ..p,
    module: {
      ..p.module,
      module: {
        ..p.module.module,
        items: filter(p.module.module.items, |item: Item|
          match item { ITest(_) -> false, ILaw(_) -> false, _ -> true }),
      },
    },
  }

/// `shipped` is each shipped module as the analysis reads it, a stub where it has one, and `whole`
/// the shipped modules as they stand. `room` is how many more rounds may pull: each pulls a shipped
/// module not pulled before.
fn pulling(
  users: Int,
  shipped: Map<Bytes, Bytes>,
  whole: Map<Bytes, Bytes>,
  listed: List<Bytes>,
  stubs: Map<Bytes, Bytes>,
  tested: Bool,
  x: Pull,
  room: Int,
) -> Pull / {abort.raise} = {
  let early = fold(x.parsed, [], |acc: List<Diag>, parsed: ParsedSource| concat(acc, parsed.diags));
  if len(early) > 0 { { ..x, diags: early } } else {
    let r = pull_round(users, shipped, listed, x.parsed);
    if len(r.diags) > 0 { { ..x, diags: r.diags } }
    else if map_len(r.wanted) == 0 { x }
    else if room <= 0 { panic("a shipped module pulled twice") } else {
      pulling(
        users,
        shipped,
        whole,
        listed,
        stubs,
        tested,
        map_fold(r.wanted, x, |acc: Pull, name: Bytes, src: Bytes| {
          let o = shipped_embedded(whole, len(acc.parsed), { name: name, src: src });
          {
            ..acc,
            parsed: push(acc.parsed, if tested { o.parsed } else { untested(o.parsed) }),
            cuts: if tested { acc.cuts } else { uncut(acc.cuts, stubs, o.parsed) },
            pulled: push(acc.pulled, name),
            embeds: concat(acc.embeds, o.embeds),
          }
        }),
        room - 1,
      )
    }
  }
}

fn shipped_read(
  whole: Map<Bytes, Bytes>,
  module: Bytes,
  want: EmbedWant,
) -> EmbedRead / {abort.raise} =
  if want.dir { Err(b"a shipped module embeds a file the shipped modules hold, never a directory") }
  else {
    match shipped_name(module, want.path) {
      None ->
        Err(bytes_concat_all([b"`", want.path, b"` names nothing shipped modules could hold"])),
      Some(name) -> match map_get(whole, name) {
        Some(text) -> Ok([{ name: b"", bytes: text }]),
        None -> Err(bytes_concat_all([b"`", want.path, b"` is not among the shipped modules"])),
      },
    }
  }

/// A pulled module parsed, with what it embeds written out from the shipped modules: no driver reads
/// beside a module that has no file. What it embeds is asked of its text as the shipped modules hold
/// it: read as a stub it has no body left to ask, and the emitter may still lower the whole of it.
fn shipped_embedded(
  whole: Map<Bytes, Bytes>,
  index: Int,
  source: Source,
) -> { parsed: ParsedSource, embeds: List<EmbedAt> } / {abort.raise} = {
  let text = match map_get(whole, source.name) { Some(t) -> t, None -> source.src };
  let p = { ..parse_at(index, source), src: text };
  if !names_embed(text) { { parsed: p, embeds: [] } } else {
    let wants = if text == source.src { wants_of(p.module.module) }
    else { wants_of(parse(text).node) };
    let table = fold(wants, map_new(), |acc: Map<Bytes, EmbedRead>, want: EmbedWant|
      map_insert(acc, embed_key(want), shipped_read(whole, source.name, want)));
    let r = embedded(p.module.module, table, []);
    {
      parsed: {
        ..p,
        module: { ..p.module, module: r.module },
        diags: concat(p.diags, map(r.diags, |diag: ParseDiag| placed(index, diag))),
      },
      embeds: map_fold(table, [], |acc: List<EmbedAt>, key: Bytes, read: EmbedRead|
        push(acc, { module: source.name, key: key, read: read })),
    }
  }
}

/// `analyse` over `user` and the modules of `shipped` it imports, with those named in the order they
/// were pulled: a label's module index points into `user` first and then into `pulled`, so a caller
/// that renders one needs both lists.
pub type Pulled = { pulled: List<Bytes>, out: AnalysisOutcome, viewed: List<ShippedView> }

pub fn analyse_pulling_std(user: List<Source>, shipped: List<Source>) -> Pulled / {abort.raise} =
  analyse_pulling_std_with(user, shipped, [], [])

/// A load read and hashed, the shipped modules it pulled among it, or what refused it before that;
/// and, for a load that read the shipped modules for what the program reaches, what it read of each.
pub type Staged = {
  pulled: List<Bytes>,
  hashed: Result<Hashed, List<Diag>>,
  viewed: List<ShippedView>,
}

/// What a load read of a shipped module it pulled, each part in hex: the digest of the module's
/// text; its form, all that a load keeps of it whatever the program reaches; and each function the
/// program reached, with its hash. A load that reads the module as it now stands, and reaches no
/// other function of it, answers as this one did while its form and each of those hashes stand.
pub type ShippedView = {
  module: Bytes,
  text: Bytes,
  form: Bytes,
  defs: List<{ name: Bytes, hash: Bytes }>,
}

/// `viewed` as a trace holds it: a `shipform` line for each module and a `shipdef` line for each
/// function reached.
pub fn viewed_text(viewed: List<ShippedView>) -> Bytes / {abort.raise} = {
  let line = |parts: List<Bytes>|
    bytes_concat(
      fold(parts, b"", |acc: Bytes, part: Bytes|
        if bytes_len(acc) == 0 { part } else { bytes_concat_all([acc, b"\t", part]) }),
      b"\n",
    );
  bytes_concat_all(
    fold(viewed, [], |acc: List<Bytes>, v: ShippedView|
      fold(
        v.defs,
        push(acc, line([b"shipform", v.module, v.text, v.form])),
        |a: List<Bytes>, d: { name: Bytes, hash: Bytes }|
          push(a, line([b"shipdef", v.module, d.name, d.hash])),
      )),
  )
}

/// What `name` hashes to in a load that hashed.
pub fn staged_hash(staged: Staged, name: Bytes) -> Option<Bytes> =
  match staged.hashed {
    Err(_) -> None,
    Ok(h) ->
      fold(h.hashes.defs, None, |acc: Option<Bytes>, d: { name: Bytes, hash: Bytes }|
        if d.name == name { Some(d.hash) } else { acc }),
  }

pub fn staged_pulling_std_with(
  user: List<Source>,
  shipped: List<Source>,
  pkgs: PackageSources = { root: b"", manifest: None, supplied: [] },
  ifaces: Interfaces = { stubs: [], cuts: [], defs: [], fixed: [] },
  embeds: List<Embedded> = [],
  // What an earlier load of the same program hashed, which this one takes where it stands.
  priors: List<Prior> = [],
  // Whether the program's tests and laws are read. A program to ship is the definition it enters
  // and all that reaches, which is never a test or a law.
  tested: Bool = true,
  // The shipped modules there are and `shipped` does not hold, because this load pulls none of them
  // (`shipped_pulled`).
  unread: List<Bytes> = [],
  // Whether a shipped module is read only for what the program reaches. `ply test --std` reads
  // every one whole, its tests and laws among them, and the toolchain's own tree always does.
  reached: Bool = true,
) -> Staged / {abort.raise} = {
  let clo = closure(pkgs, map(user, |s: Source| s.name));
  let stubs = stubbed(ifaces);
  let texts = fold(shipped, map_new(), |acc: Map<Bytes, Bytes>, s: Source|
    map_insert(acc, s.name, read_as(stubs, s).src));
  let sources = concat(user, map(clo.modules, |m: { pkg: Int, src: Source }| m.src));
  let read = fold(
    range(0, len(sources)),
    { parsed: [], cuts: [] },
    |acc: { parsed: List<ParsedSource>, cuts: List<StubCuts> }, i: Int| {
      let s = at(sources, i);
      let p = { ..parse_at(i, read_as(stubs, s)), src: s.src };
      if tested { { ..acc, parsed: push(acc.parsed, p) } }
      else { { parsed: push(acc.parsed, untested(p)), cuts: uncut(acc.cuts, stubs, p) } }
    },
  );
  let parsed = read.parsed;
  let mentions = concat(
    map(user, |s: Source| names_embed(s.src)),
    map(clo.modules, |m: { pkg: Int, src: Source }| names_embed(m.src.src)),
  );
  let written = embedded_all(parsed, own_names(pkgs, user), mentions, embeds);
  let assembled = written.parsed;
  // The toolchain's own tree loads without its implicit self: every root module under `std`
  // with the whole shipped set among them is the built-in package's sources.
  let listed = concat(map(shipped, |s: Source| s.name), unread);
  let toolchain = fold(user, true, |acc: Bool, s: Source| acc && is_std(s.name))
    && fold(listed, true, |acc: Bool, name: Bytes|
      acc && (!is_std(name) || list::contains(map(user, |u: Source| u.name), name)));
  let whole = fold(shipped, map_new(), |acc: Map<Bytes, Bytes>, s: Source|
    map_insert(acc, s.name, s.src));
  let x = pulling(
    len(assembled),
    texts,
    whole,
    listed,
    stubs,
    tested,
    { parsed: assembled, pulled: [], embeds: [], cuts: read.cuts, diags: [] },
    map_len(texts),
  );
  let hashed = |parsed: List<ParsedSource>|
    hashed_closure(
      parsed,
      clo,
      len(user),
      toolchain,
      ifaces,
      concat(written.at, x.embeds),
      priors,
      x.cuts,
    );
  let whole_load = if len(x.diags) > 0 { Err(x.diags) } else { hashed(x.parsed) };
  match whole_load {
    Err(diags) -> { pulled: x.pulled, hashed: Err(diags), viewed: [] },
    Ok(h) -> if !reached || toolchain { { pulled: x.pulled, hashed: Ok(h), viewed: [] } } else {
      let reach = reach_of(h);
      {
        pulled: x.pulled,
        hashed: match cut_to(x.parsed, h, reach) { None -> Ok(h), Some(cut) -> hashed(cut) },
        viewed: views_of(h, |name: Bytes| map_contains(reach, name)),
      }
    },
  }
}

/// The first shipped module's slot.
fn first_shipped(h: Hashed) -> Int = h.root_count + len(h.clo.modules)

/// The functions a shipped module declares, each by its qualified name: what a load reads only where
/// the program reaches it.
fn shipped_functions(h: Hashed) -> Map<Bytes, Bool> / {abort.raise} =
  fold(range(first_shipped(h), len(h.mods)), map_new(), |acc: Map<Bytes, Bool>, i: Int| {
    let m = at(h.mods, i);
    fold(m.module.items, acc, |a: Map<Bytes, Bool>, item: Item|
      match item { IFn(d) -> map_insert(a, qualify(m.name, d.name.name), true), _ -> a })
  })

/// The functions a program reaches of the shipped modules it pulls: those every other definition
/// reaches, those the tests and laws outside them do, and those behind each name a module outside
/// them imports. A reached definition's specifications are read with it, so what they name is
/// reached too. A function is reached as itself: an effect or a type of its name reached without
/// it leaves it, and what it calls, unread.
fn reach_of(h: Hashed) -> Map<Bytes, Bool> / {abort.raise} = {
  let first = first_shipped(h);
  let candidates = shipped_functions(h);
  let imported = fold(range(0, first), [], |acc: List<Bytes>, i: Int|
    fold(at(h.mods, i).module.imports, acc, |a: List<Bytes>, d: ImportDecl|
      match d.kind {
        INames(names) -> {
          let module = join(map(d.path, |part: Ident| part.name), b".");
          fold(names, a, |b: List<Bytes>, n: Ident| push(b, qualify(module, n.name)))
        },
        _ -> a,
      }));
  // Every type a shipped module declares is read, reached or not, and so is what the module states
  // of it: the type's node holds those functions, and a `gen`'s sampler is what a prover enters.
  let stated = fold(range(first, len(h.mods)), [], |acc: List<Bytes>, i: Int| {
    let m = at(h.mods, i);
    fold(m.module.items, acc, |a: List<Bytes>, item: Item| {
      let typed = match stated_type(item) {
        Some(target) -> push(a, qualify(m.name, target.name)),
        None -> a,
      };
      match sampler_of(item) { Some(name) -> push(typed, qualify(m.name, name)), None -> typed }
    })
  });
  reached_functions(
    h.index,
    h.hashes,
    concat(
      concat(
        fold(h.hashes.defs, [], |acc: List<Bytes>, d: { name: Bytes, hash: Bytes }|
          if map_contains(candidates, d.name) { acc } else { push(acc, d.name) }),
        concat(
          map(filter(h.index.tests, |t: TestNode| t.module < first), |t: TestNode| t.key),
          map(filter(h.index.laws, |l: LawNode| l.module < first), |l: LawNode| l.key),
        ),
      ),
      concat(imported, stated),
    ),
  )
}

/// The module a shipped module's import names: a compiler module names its siblings bare.
fn imported_module(h: Hashed, importer: Bytes, d: ImportDecl) -> Bytes / {abort.raise} = {
  let module = join(map(d.path, |part: Ident| part.name), b".");
  let sibling = bytes_concat(b"compiler.", module);
  if is_compiler(importer)
      && fold(range(first_shipped(h), len(h.mods)), false, |acc: Bool, i: Int|
        acc || at(h.mods, i).name == sibling) { sibling }
  else { module }
}

/// The pulled shipped modules cut to what the program reaches: a function it does not reach, a name
/// imported for one alone, and every test and law are left out, so they are neither checked nor
/// counted, and the program does not depend on them. `None` when nothing is left out.
fn cut_to(
  parsed: List<ParsedSource>,
  h: Hashed,
  reach: Map<Bytes, Bool>,
) -> Option<List<ParsedSource>> / {abort.raise} = {
  let first = first_shipped(h);
  let candidates = shipped_functions(h);
  let wanted = |name: Bytes| !map_contains(candidates, name) || map_contains(reach, name);
  // An imported name still names a type or an effect of the module once its function is left out.
  let declared = fold(h.index.nodes, map_new(), |acc: Map<Bytes, Bool>, n: Node|
    match n.body { NodeFn(_) -> acc, _ -> map_insert(acc, n.name, true) });
  let kept = |p: ParsedSource, item: Item|
    match item {
      IFn(d) -> wanted(qualify(p.name, d.name.name)),
      ITest(_) -> false,
      ILaw(_) -> false,
      _ -> true,
    };
  let imports = |p: ParsedSource|
    map(p.module.module.imports, |d: ImportDecl|
      match d.kind {
        INames(names) -> {
          let module = imported_module(h, p.name, d);
          {
            ..d,
            kind: INames(
              filter(names, |n: Ident| {
                let name = qualify(module, n.name);
                wanted(name) || map_contains(declared, name)
              }),
            ),
          }
        },
        _ -> d,
      });
  let cut = fold(range(first, len(parsed)), false, |acc: Bool, i: Int| {
    let p = at(parsed, i);
    acc || fold(p.module.module.items, false, |b: Bool, item: Item| b || !kept(p, item))
      || imports(p) != p.module.module.imports
  });
  if !cut { None } else {
    Some(
      map(range(0, len(parsed)), |i: Int| {
        let p = at(parsed, i);
        if i < first { p } else {
          {
            ..p,
            module: {
              ..p.module,
              module: {
                ..p.module.module,
                imports: imports(p),
                items: filter(p.module.module.items, |item: Item| kept(p, item)),
              },
            },
          }
        }
      }),
    )
  }
}

/// What a load read of each shipped module it pulled, with each function `read` holds. A function
/// that is not the module's own, one a `derive` writes, is in its form; so is each type and effect
/// with its hash, each module it imports, and each effect set as it is written.
fn views_of(h: Hashed, read: (Bytes) -> Bool) -> List<ShippedView> / {abort.raise} = {
  let first = first_shipped(h);
  let candidates = shipped_functions(h);
  let defs = fold(
    h.hashes.defs,
    map_new(),
    |acc: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }| map_insert(acc, d.name, d.hash),
  );
  let decls = fold(
    h.hashes.decls,
    map_new(),
    |acc: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }| map_insert(acc, d.name, d.hash),
  );
  let nodes = fold(h.index.nodes, map_new(), |acc: Map<Int, List<Node>>, n: Node|
    if n.module < first { acc } else {
      map_insert(
        acc,
        n.module,
        push(match map_get(acc, n.module) { Some(ns) -> ns, None -> [] }, n),
      )
    });
  map(range(first, len(h.mods)), |i: Int| {
    let m = at(h.mods, i);
    let own = match map_get(nodes, i) { Some(ns) -> ns, None -> [] };
    let hash_of = |table: Map<Bytes, Bytes>, name: Bytes|
      match map_get(table, name) { Some(hash) -> hash, None -> b"" };
    let shape = concat(
      concat(
        fold(own, [], |acc: List<Bytes>, n: Node|
          match n.body {
            NodeFn(_) -> if map_contains(candidates, n.name) { acc }
            else { push(acc, bytes_concat(b"derived ", n.name)) },
            _ -> push(acc, bytes_concat_all([b"declared ", n.name, b" ", hash_of(decls, n.name)])),
          }),
        map(m.module.imports, |d: ImportDecl|
          bytes_concat(b"imports ", imported_module(h, m.name, d))),
      ),
      fold(m.module.items, [], |acc: List<Bytes>, item: Item|
        match item {
          IEffectSet(_) -> push(acc, bytes_concat(b"set ", dump_item(item))),
          _ -> acc,
        }),
    );
    {
      module: m.name,
      text: hex(blake3(at(h.texts, i))),
      form: hex(blake3(join(shape, b"\n"))),
      defs: fold(own, [], |acc: List<{ name: Bytes, hash: Bytes }>, n: Node|
        match n.body {
          NodeFn(_) -> if read(n.name) {
            push(acc, { name: n.name, hash: hex(hash_of(defs, n.name)) })
          } else { acc },
          _ -> acc,
        }),
    }
  })
}

/// A module that imports each of `modules`: what pulls them for `shipped_views`.
pub fn shipped_viewer(modules: List<Bytes>) -> Source =
  {
    name: b"viewer",
    src: bytes_concat_all(map(modules, |m: Bytes| bytes_concat_all([b"import ", m, b"\n"]))),
  }

/// What each definition and declaration of every shipped module a load of `modules` pulls hashes
/// to, by name: what a kept package's fixed hashes of a module are held to when its text moved.
/// `shipped` is what `shipped_viewer` pulls; nothing when they do not hash.
pub fn shipped_hashes(
  modules: List<Bytes>,
  shipped: List<Source>,
  unread: List<Bytes> = [],
) -> Map<Bytes, Bytes> / {abort.raise} =
  match staged_pulling_std_with(
      [shipped_viewer(modules)],
      shipped,
      tested: false,
      unread: unread,
      reached: false,
    ).hashed {
    Err(_) -> map_new(),
    Ok(h) ->
      fold(
        concat(h.hashes.defs, h.hashes.decls),
        map_new(),
        |acc: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }| map_insert(acc, d.name, d.hash),
      ),
  }

/// Each shipped module a load of `modules` pulls, read whole, as a view of every function in it: what
/// a view a load reported is held to now. `shipped` is what `shipped_viewer` pulls.
pub fn shipped_views(
  modules: List<Bytes>,
  shipped: List<Source>,
  unread: List<Bytes> = [],
) -> Result<List<ShippedView>, List<Diag>> / {abort.raise} =
  match staged_pulling_std_with(
      [shipped_viewer(modules)],
      shipped,
      tested: false,
      unread: unread,
      reached: false,
    ).hashed {
    Err(diags) -> Err(diags),
    Ok(h) -> Ok(views_of(h, |name: Bytes| true)),
  }

/// A hashed load checked, seeded with the rows a last load published.
pub fn checked_staged(
  staged: Staged,
  defs: List<KnownDefRow>,
  tests: List<KnownTestRow>,
) -> Pulled / {abort.raise} =
  {
    pulled: staged.pulled,
    out: match staged.hashed {
      Err(diags) -> Refused(diags),
      Ok(h) -> checked_closure(h, concat(defs, h.ifaces.defs), tests),
    },
    viewed: staged.viewed,
  }

pub fn analyse_pulling_std_with(
  user: List<Source>,
  shipped: List<Source>,
  defs: List<KnownDefRow>,
  tests: List<KnownTestRow>,
  pkgs: PackageSources = { root: b"", manifest: None, supplied: [] },
  ifaces: Interfaces = { stubs: [], cuts: [], defs: [], fixed: [] },
  embeds: List<Embedded> = [],
  // What an earlier load of the same program hashed, which this one takes where it stands.
  priors: List<Prior> = [],
  unread: List<Bytes> = [],
  reached: Bool = true,
) -> Pulled / {abort.raise} =
  checked_staged(
    staged_pulling_std_with(
      user,
      shipped,
      pkgs,
      ifaces,
      embeds,
      priors,
      unread: unread,
      reached: reached,
    ),
    defs,
    tests,
  )

/// What a load of `user` pins, and nothing more of it: each dependency's name, version and digest,
/// read off the package closure and the embeds the driver read, so no module is parsed. A closure
/// that is refused answers its diagnostics, placed past the program's own modules where a load
/// places its manifests.
pub fn pins_pulling(
  user: List<Source>,
  pkgs: PackageSources,
  embeds: List<Embedded>,
) -> Result<List<Pinned>, List<Diag>> / {abort.raise} = {
  let clo = closure(pkgs, map(user, |source: Source| source.name));
  let sources = concat(user, map(clo.modules, |m: { pkg: Int, src: Source }| m.src));
  if len(clo.diags) > 0 {
    Err(
      map(clo.diags, |sd: { slot: Int, diag: ParseDiag }|
        if sd.slot < 0 { placed(0 - sd.slot - 1, sd.diag) }
        else { placed(len(sources) + sd.slot, sd.diag) }),
    )
  } else {
    let slots = own_names(pkgs, user);
    let tables = embed_reads(embeds);
    let read = fold(range(0, len(sources)), [], |acc: List<EmbedAt>, i: Int| {
      let source = at(sources, i);
      match list_at(slots, i) {
        Some(slot) -> if !names_embed(source.src) { acc } else {
          match map_get(tables, slot) {
            Some(table) ->
              map_fold(table, acc, |a: List<EmbedAt>, key: Bytes, read: EmbedRead|
                push(a, { module: source.name, key: key, read: read })),
            None -> acc,
          }
        },
        None -> acc,
      }
    });
    Ok(pins_of(clo, read))
  }
}

// --- Embeds ----------------------------------------------------------------------------------

/// What the driver read for one embed: the module by its package's root key and its own name in that
/// package, what it asked for, and what was read.
pub type Embedded = { root: Bytes, module: Bytes, want: EmbedWant, read: EmbedRead }

/// Whether `src` may call `embed` or `embed_dir`: the name whole and no import's module, then spaces,
/// then `(`, or a `/` that may open a comment before it. Only a module that may is parsed for what
/// it embeds.
fn names_embed(src: Bytes) -> Bool / {abort.raise} = calls_embed_from(src, 0)

/// An occurrence a round, each past the last.
fn calls_embed_from(src: Bytes, from: Int) -> Bool / {abort.raise} =
  iterate(from, bytes_len(src) + 2, |at: Int|
    match bytes_index_of_from(src, b"embed", at) {
      None -> Stop(false),
      Some(i) -> {
        let whole = (i == 0 || !ident_byte(bytes_at(src, i - 1)))
          && !(i >= 7 && bytes_slice(src, i - 7, i) == b"import ");
        let end = if i + 9 < bytes_len(src) { i + 9 } else { bytes_len(src) };
        let named = if bytes_slice(src, i + 5, end) == b"_dir" { i + 9 } else { i + 5 };
        let next = past_spaces(src, named);
        if whole && next < bytes_len(src)
            && (bytes_at(src, next) == 40 || bytes_at(src, next) == 47) { Stop(true) }
        else { Continue(i + 5) }
      },
    })

fn ident_byte(b: Int) -> Bool =
  (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95

fn past_spaces(src: Bytes, at: Int) -> Int / {abort.raise} =
  if at < bytes_len(src)
      && (bytes_at(src, at) == 32 || bytes_at(src, at) == 9 || bytes_at(src, at) == 10
      || bytes_at(src, at) == 13) { past_spaces(src, at + 1) }
  else { at }

/// Of a module the driver read beside, what `embeds` holds; of a shipped one, what the shipped
/// modules do.
pub fn embeds_now(
  pkgs: PackageSources,
  user: List<Source>,
  shipped: List<Source>,
  embeds: List<Embedded>,
) -> EmbedReader / {abort.raise} = {
  let clo = closure(pkgs, map(user, |s: Source| s.name));
  let names = concat(
    map(user, |s: Source| s.name),
    map(clo.modules, |m: { pkg: Int, src: Source }| m.src.name),
  );
  let slots = own_names(pkgs, user);
  let tables = embed_reads(embeds);
  let beside = fold(
    range(0, len(names)),
    map_new(),
    |acc: Map<Bytes, Map<Bytes, EmbedRead>>, i: Int|
      match list_at(slots, i) {
        None -> acc,
        Some(slot) -> match map_get(tables, slot) {
          Some(table) -> map_insert(acc, at(names, i), table),
          None -> acc,
        },
      },
  );
  let whole = fold(shipped, map_new(), |acc: Map<Bytes, Bytes>, s: Source|
    map_insert(acc, s.name, s.src));
  |module: Bytes, key: Bytes|
    match map_get(beside, module) {
      Some(table) -> match map_get(table, key) {
        Some(read) -> read,
        None -> Err(b"the module asks for no such embed now"),
      },
      None -> if map_contains(whole, module) { shipped_read(whole, module, want_of_key(key)) }
      else { Err(b"the module asks for no such embed now") },
    }
}

/// What the modules of the package at `root` ask to embed. Only a module that may call `embed` is
/// parsed for it.
pub fn embeds_wanted(root: Bytes, sources: List<Source>) -> List<Embedded> / {abort.raise} =
  fold(sources, [], |acc: List<Embedded>, source: Source|
    if !names_embed(source.src) { acc } else {
      fold(wants_of(parse(source.src).node), acc, |a: List<Embedded>, want: EmbedWant|
        push(a, { root: root, module: source.name, want: want, read: Err(b"not read yet") }))
    })

pub fn embed_slot(root: Bytes, module: Bytes) -> Bytes = bytes_concat_all([root, b"\x00", module])

/// Each parsed module's package root and own name, in the order the program and its dependencies
/// were parsed.
fn own_names(pkgs: PackageSources, user: List<Source>) -> List<Bytes> =
  fold(
    pkgs.supplied,
    map(user, |source: Source| embed_slot(pkgs.root, source.name)),
    |acc: List<Bytes>, supplied: Supplied|
      fold(supplied.modules, acc, |a: List<Bytes>, source: Source|
        push(a, embed_slot(supplied.root, source.name))),
  )

/// Every module that names `embed` with its embeds written out, a read that failed as its
/// diagnostic, and the reads by each module's name in the program.
/// What the driver read, by each module's slot and each embed's key.
fn embed_reads(embeds: List<Embedded>) -> Map<Bytes, Map<Bytes, EmbedRead>> =
  fold(embeds, map_new(), |acc: Map<Bytes, Map<Bytes, EmbedRead>>, embed: Embedded| {
    let slot = embed_slot(embed.root, embed.module);
    let was = match map_get(acc, slot) { Some(t) -> t, None -> map_new() };
    map_insert(acc, slot, map_insert(was, embed_key(embed.want), embed.read))
  })

fn embedded_all(
  parsed: List<ParsedSource>,
  slots: List<Bytes>,
  mentions: List<Bool>,
  embeds: List<Embedded>,
) -> { parsed: List<ParsedSource>, at: List<EmbedAt> } / {abort.raise} = {
  let tables = embed_reads(embeds);
  fold(
    range(0, len(parsed)),
    { parsed: [], at: [] },
    |acc: { parsed: List<ParsedSource>, at: List<EmbedAt> }, i: Int| {
      let p = at(parsed, i);
      match ((list_at(slots, i), list_at(mentions, i))) {
        (Some(slot), Some(true)) -> {
          let table = match map_get(tables, slot) { Some(t) -> t, None -> map_new() };
          let r = embedded(p.module.module, table, []);
          {
            parsed: push(acc.parsed, {
              ..p,
              module: { ..p.module, module: r.module },
              diags: concat(p.diags, map(r.diags, |diag: ParseDiag| placed(i, diag))),
            }),
            at: map_fold(table, acc.at, |a: List<EmbedAt>, key: Bytes, read: EmbedRead|
              push(a, { module: p.name, key: key, read: read })),
          }
        },
        _ -> { ..acc, parsed: push(acc.parsed, p) },
      }
    },
  )
}

/// The front end's answer as values: the shipped modules pulled in, in the order a label's module
/// index counts them after the program's own, and the rows. A refused program's rows are its
/// diagnostics alone.
pub type FrontEndAnswer = { pulled: List<Bytes>, dump: Dump }

/// `analyse_pulling_std_with`'s answer as the rows it holds: what the driver reads. The rows handed
/// in are the last answer's: what this program hashes the same is taken from them, and only what
/// moved is walked.
/// The runtime calls this at a fixed arity, so interfaces go through `analyse_pulling_std_with`.
pub fn answer_pulling_std_with(
  user: List<Source>,
  shipped: List<Source>,
  defs: List<KnownDefRow>,
  tests: List<KnownTestRow>,
  pkgs: PackageSources = { root: b"", manifest: None, supplied: [] },
  embeds: List<Embedded> = [],
) -> FrontEndAnswer / {abort.raise} = {
  let x: Pulled = analyse_pulling_std_with(
    user,
    shipped,
    defs,
    tests,
    pkgs,
    no_interfaces(),
    embeds,
  );
  { pulled: x.pulled, dump: dump_of(x.out) }
}

/// `seeded` counts the definitions taken from the rows handed in rather than walked.
pub type RowsAnswer = { pulled: List<Bytes>, dump: Dump, rows: Rows, seeded: Int }

/// The same answer and the rows the analysis published, for a driver that keeps them to seed its
/// next load of the same program. The runtime calls this at a fixed arity.
pub fn answer_rows_pulling_std_with(
  user: List<Source>,
  shipped: List<Source>,
  defs: List<KnownDefRow>,
  tests: List<KnownTestRow>,
  pkgs: PackageSources,
  embeds: List<Embedded>,
) -> RowsAnswer / {abort.raise} = {
  let x: Pulled = analyse_pulling_std_with(
    user,
    shipped,
    defs,
    tests,
    pkgs,
    no_interfaces(),
    embeds,
  );
  {
    pulled: x.pulled,
    dump: dump_of(x.out),
    rows: match x.out { Analysed(w) -> rows_of(w), Refused(_) -> no_rows() },
    seeded: match x.out { Analysed(w) -> len(w.checked.seeded), Refused(_) -> 0 },
  }
}

// --- The rows an answer is made of ----------------------------------------------
// Types and rows are held as the checker's values.

/// A span: a module index, `no_module` outside every module, and the offsets.
pub type ModuleSpan = { module: Int, start: Int, end: Int }

pub type ModuleRow = {
  name: Bytes,
  index: Int,
  items: List<Bytes>,
  imports: List<Bytes>,
  sets: List<SetView>,
  cuts: List<Cut>,
}

pub type ParamRow = { name: Bytes, at: ModuleSpan }

pub type SpecRow = { kind: Bytes, index: Int, footprint: List<Atom>, at: ModuleSpan }

pub type DefRow = {
  name: Bytes,
  module: Bytes,
  simple_name: Bytes,
  public: Bool,
  reuse: Bool,
  footprint: List<Atom>,
  performed: List<Atom>,
  constraints: List<DefConstraint>,
  row_aliases: List<Bytes>,
  params: List<ParamRow>,
  spec: List<SpecRow>,
  at: ModuleSpan,
  literals: List<Bytes>,
}

pub type TypeRow = {
  name: Bytes,
  module: Bytes,
  simple_name: Bytes,
  public: Bool,
  arity: Int,
  at: ModuleSpan,
}

pub type TestRow = {
  key: Bytes,
  name: Bytes,
  module: Bytes,
  index: Int,
  nondet: Bool,
  footprint: List<Atom>,
  at: ModuleSpan,
  name_at: ModuleSpan,
}

pub type BinderRow = { name: Bytes, at: ModuleSpan, ty: Type }

pub type LawRow = {
  key: Bytes,
  name: Bytes,
  module: Bytes,
  index: Int,
  binders: List<BinderRow>,
  has_guard: Bool,
  host: Bool,
  cost: Bool,
  footprint: List<Atom>,
  at: ModuleSpan,
  literals: List<Bytes>,
}

/// `carries` says how each argument a host handler is given reads at the compiled seam.
pub type OpRow = {
  name: Bytes,
  mode: Bytes,
  resource_param: Bool,
  params: List<Type>,
  ret: Type,
  scheme: Option<Scheme>,
  at: ModuleSpan,
  carries: List<Carry>,
}

pub type EffectRow = {
  name: Bytes,
  module: Bytes,
  simple_name: Bytes,
  public: Bool,
  nondet: Bool,
  ops: List<OpRow>,
  at: ModuleSpan,
}

pub type CtorRow = {
  name: Bytes,
  module: Bytes,
  simple_name: Bytes,
  type_name: Bytes,
  index: Int,
  arity: Int,
  fields: List<Type>,
  scheme: Scheme,
  at: ModuleSpan,
}

pub type HashRow = {
  name: Bytes,
  def: Option<Bytes>,
  own: Option<Bytes>,
  decl: Option<Bytes>,
  specs: List<Bytes>,
  spec_texts: List<Bytes>,
  deps: List<Bytes>,
}

/// A test's or a law's hash row, under the index of the item it is about; `text` is a law's
/// sentence hash and is empty for a test.
pub type ItemHashRow = { index: Int, key: Bytes, hash: Bytes, text: Bytes, deps: List<Bytes> }

pub type HashFrame = | HDef(HashRow) | HTest(ItemHashRow) | HLaw(ItemHashRow)

pub type OrdinalRow = { module: Bytes, items: List<Bytes> }

pub type BodyRow = { name: Bytes, body: Bytes }

pub type BakedRow = { name: Bytes, hash: Bytes }

/// Every table of the front end's answer.
pub type Dump = {
  diags: List<Diag>,
  order: List<Bytes>,
  packages: List<PackageDeps>,
  pins: List<Pinned>,
  module_packages: List<Int>,
  modules: List<ModuleRow>,
  defs: List<DefRow>,
  types: List<TypeRow>,
  tests: List<TestRow>,
  laws: List<LawRow>,
  effects: List<EffectRow>,
  ctors: List<CtorRow>,
  hashes: List<HashFrame>,
  hashes_digest: Bytes,
  keys: List<KeyRow>,
  emitter_roots: List<EmitterRoot>,
  /// Each `const` definition, with the hash of all it reaches: what a unit finds its value by.
  baked: List<BakedRow>,
  emitter_ctors: List<EmitterCtor>,
  ordinals: List<OrdinalRow>,
  bodies: List<BodyRow>,
  test_bodies: List<Bytes>,
  embeds: List<EmbedAt>,
  /// What every definition and test published, which spares the emitter a walk of the bodies it
  /// does not lower.
  rows: Rows,
  /// A `WalkedFacts`, in the encoding both programs read with the type: the emitter lowers a body the
  /// checker walked without walking it again.
  walked: Bytes,
}

/// A diagnostic as the answer carries it: no dedup key, and the note count is the notes.
pub fn answered_diag(diag: Diag) -> Diag =
  {
    code: diag.code,
    notes: len(diag.notes_text),
    labels: diag.labels,
    text: b"",
    message: diag.message,
    notes_text: diag.notes_text,
    severity: diag.severity,
    fixes: diag.fixes,
  }

// --- Tests ------------------------------------------------------------------

fn program() -> List<Source> =
  [
    {
      name: b"m",
      src: b"effect log { write emit(Bytes) -> Unit }\ntype Shape = | Dot | Line(Int)\nfn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\ntest \"says\" { say(b\"x\") }",
    },
  ]

test "the emitter's root keys cover every root and no two share one" {
  let src = b"fn pos(x: Int) -> Bool = x > 0\nfn f(x: Int) -> Int requires pos(x) ensures x >= 0 = x\ntest \"t\" { assert_eq(f(1), 1) }\nlaw \"l\" forall (x: Int) { f(x) == x }";
  match analyse(parse_all([{ name: b"m", src: src }])) {
    Refused(_) -> panic("the program checks"),
    Analysed(w) -> {
      let keys = root_keys(w.mods, w.checked, w.hashes);
      assert_eq(map(keys, |k: KeyRow| k.root), [
        b"m.pos",
        b"m.f#requires#0",
        b"m.f#ensures#0",
        b"m.f",
        b"m.test#0",
        b"m.law#0.body",
      ]);
      // No two roots share a key, or a cache would serve one body for another.
      let distinct = map_keys(map_of_entries(map(keys, |k: KeyRow| { key: k.key, value: () })));
      assert_eq(len(distinct), len(keys));
    },
  }
}

test "a root is pure only as a definition with no row and no constraint" {
  let src = b"effect log { write emit(Bytes) -> Unit }\nfn origin() -> Int = 0\nfn hello() -> Unit / { log.write } = log.emit(b\"hi\")\nfn same<a>(x: a, y: a) -> Bool where derivable(eq, a) = x == y\nfn positive(n: Int) -> Int requires n > 0 = n\ntest \"t\" { assert_eq(origin(), 0) }\nlaw \"l\" forall (n: Int) { same(n, n) }";
  let d = dump_of(analyse(parse_all([{ name: b"m", src: src }])));
  assert_eq(map(d.emitter_roots, |root: EmitterRoot| { root: root.root, pure: root.pure }), [
    { root: b"m.origin", pure: true },
    { root: b"m.hello", pure: false },
    { root: b"m.same", pure: false },
    { root: b"m.positive", pure: true },
    { root: b"m.test#0", pure: false },
    { root: b"m.positive#requires#0", pure: false },
    { root: b"m.law#0.body", pure: false },
  ])
}

test "a test's root is the one at its place among the program's tests" {
  let d = dump_of(
    analyse(
      parse_all([
        {
          name: b"a",
          src: b"fn one() -> Int = 1\ntest \"first\" { assert_eq(one(), 1) }\ntest \"second\" { assert_eq(one(), 1) }",
        },
        {
          name: b"b",
          src: b"fn test_like(x: Int) -> Int requires x > 0 = x\ntest \"third\" { assert_eq(test_like(2), 2) }",
        },
      ]),
    ),
  );
  assert_eq(test_roots(d), [b"a.test#0", b"a.test#1", b"b.test#0"]);
  assert_eq(map(d.tests, |t: TestRow| bytes_concat_all([t.module, b".", t.name])), [
    b"a.first",
    b"a.second",
    b"b.third",
  ])
}

test "a root carries a width exactly where a value it is entered with or answers is one" {
  let src = b"fn low_bit(b: U8) -> Int requires int_of_u8(b) < 200 ensures result < 2 = int_of_u8(b & 1u8)\nfn narrow(n: Int) -> U8 / {abort.raise} requires n >= 0 ensures int_of_u8(result) == n = u8_of_int(n)\nfn inc(x: Int) -> Int requires x > 0 ensures result > x = x + 1\ntest \"t\" { assert_eq(inc(1), 2) }\nlaw \"low\" forall (b: U8) where int_of_u8(b) > 0 { low_bit(b) < 2 }\nlaw \"grows\" forall (x: Int) where x > 0 { inc(x) > x }";
  let d = dump_of(analyse(parse_all([{ name: b"m", src: src }])));
  assert_eq(
    map(d.emitter_roots, |root: EmitterRoot|
      { root: root.root, params: root.params, answer: root.answer }),
    [
      { root: b"m.low_bit", params: [CWidth(0)], answer: CPlain },
      { root: b"m.narrow", params: [CPlain], answer: CWidth(0) },
      { root: b"m.inc", params: [CPlain], answer: CPlain },
      { root: b"m.test#0", params: [], answer: CPlain },
      { root: b"m.low_bit#requires#0", params: [CWidth(0)], answer: CPlain },
      { root: b"m.low_bit#ensures#0", params: [CWidth(0), CPlain], answer: CPlain },
      { root: b"m.narrow#requires#0", params: [CPlain], answer: CPlain },
      { root: b"m.narrow#ensures#0", params: [CPlain, CWidth(0)], answer: CPlain },
      { root: b"m.inc#requires#0", params: [CPlain], answer: CPlain },
      { root: b"m.inc#ensures#0", params: [CPlain, CPlain], answer: CPlain },
      { root: b"m.law#0.guard", params: [CWidth(0)], answer: CPlain },
      { root: b"m.law#0.body", params: [CWidth(0)], answer: CPlain },
      { root: b"m.law#1.guard", params: [CPlain], answer: CPlain },
      { root: b"m.law#1.body", params: [CPlain], answer: CPlain },
    ],
  )
}

test "a carry follows a width into lists, maps, records, sum types, functions and variables" {
  let src = b"effect probe { write put(xs: List<U8>, n: Int) -> Unit }\ntype Byte = | Byte(U8)\ntype Tree = | Leaf | Node(Tree, I16, Tree)\ntype Pair<a, b> = | Pair(b, a)\ntype Color = | Red | Green\nfn wrap(xs: List<U8>) -> List<Byte> = map(xs, |x: U8| Byte(x))\nfn pick<a>(xs: List<a>, r: { v: I16, n: Int }) -> Option<a> = match xs { [x, ..] -> Some(x), _ -> None }\nfn swap(m: Map<String, I8>) -> Pair<Int, U64> / {abort.raise} = Pair(u64_of_int(1), 0)\nfn plain(c: Color, o: Option<Int>) -> Tree = Leaf\nfn apply<a>(f: (Int) -> a, x: Int) -> a = f(x)\nfn sent(xs: List<U8>) -> Unit / { probe.write } = probe.put(xs, 1)";
  let d = dump_of(analyse(parse_all([{ name: b"m", src: src }])));
  assert_eq(
    map(d.emitter_roots, |root: EmitterRoot|
      { root: root.root, params: root.params, answer: root.answer }),
    [
      { root: b"m.wrap", params: [CList(CWidth(0))], answer: CList(CSum([])) },
      {
        root: b"m.pick",
        params: [
          CList(CVar(0)),
          CRecord([{ name: b"n", carry: CPlain }, { name: b"v", carry: CWidth(5) }]),
        ],
        answer: CSum([CVar(0)]),
      },
      { root: b"m.swap", params: [CMap(CPlain, CWidth(4))], answer: CSum([CPlain, CWidth(3)]) },
      // A sum type that holds no width at these parameters reads as it is; one that holds a width
      // through itself does whatever its parameters.
      { root: b"m.plain", params: [CPlain, CPlain], answer: CSum([]) },
      { root: b"m.apply", params: [CFn([CPlain], CVar(0)), CPlain], answer: CVar(0) },
      { root: b"m.sent", params: [CList(CWidth(0))], answer: CPlain },
    ],
  );
  assert_eq(map(effect_named(d, b"m.probe").ops, |o: OpRow| o.carries), [
    [CList(CWidth(0)), CPlain],
  ]);
  let own = filter(d.emitter_ctors, |k: EmitterCtor| bytes_slice(k.name, 0, 2) == b"m.");
  assert_eq(map(own, |k: EmitterCtor| { name: k.name, fields: k.fields }), [
    { name: b"m.Byte", fields: [CWidth(0)] },
    { name: b"m.Leaf", fields: [] },
    { name: b"m.Node", fields: [CSum([]), CWidth(5), CSum([])] },
    { name: b"m.Pair", fields: [CVar(1), CVar(0)] },
    { name: b"m.Red", fields: [] },
    { name: b"m.Green", fields: [] },
  ]);
  let some = filter(d.emitter_ctors, |k: EmitterCtor| k.name == b"Some");
  assert_eq(map(some, |k: EmitterCtor| k.fields), [[CVar(0)]])
}

// Two loads of one program walk and warn as their caches let them, and ship one runnable.
test "a shipped answer carries neither what a load walked nor what it warned of" {
  let d = dump_of(analyse(parse_all(program())));
  assert(len(d.diags) > 0, Some("the program warns of something"));
  let shipped = shipped_dump(d);
  assert_eq(shipped.diags, []);
  assert_eq(shipped.walked, b"");
  assert_eq(shipped_dump({ ..d, walked: b"another walk", diags: [] }), shipped)
}

test "a program's answer holds its warnings, its order, its packages and its modules" {
  let d = dump_of(analyse(parse_all(program())));
  assert_eq(d.diags, [
    {
      code: b"W0611",
      notes: 0,
      labels: [{ module: 0, start: 46, end: 51, primary: true, text: b"never used" }],
      text: b"",
      message: b"type `m.Shape` is never used",
      notes_text: [],
      severity: b"warning",
      fixes: [],
    },
  ]);
  assert_eq(d.order, [b"m"]);
  assert_eq(d.packages, [
    { prefix: b"", deps: [] },
    { prefix: b"std", deps: [] },
    { prefix: b"compiler", deps: [b"std"] },
  ]);
  assert_eq(d.module_packages, [0]);
  assert_eq(d.modules, [
    {
      name: b"m",
      index: 0,
      items: [b"m.log", b"m.Shape", b"m.Dot", b"m.Line", b"m.say"],
      imports: [],
      sets: [],
      // `say`'s body and the whole test, which a stub of the module blanks.
      cuts: [
        { start: 115, end: 126, braced: true, name: b"m.say" },
        { start: 127, end: 152, braced: false, name: b"" },
      ],
    },
  ])
}

fn reachable() -> List<Source> =
  [
    {
      name: b"m",
      src: b"pub fn api() -> Int = shared()\nfn shared() -> Int = 1\nfn dead() -> Int = deader()\nfn deader() -> Int = 2\nfn tested() -> Int = 3\nfn lawful(x: Int) -> Int = x\nfn positive(x: Int) -> Bool = x > 0\npub fn checked(x: Int) -> Int requires positive(x) = x\ntype Pair = { a: Int }\npub fn make() -> Int = { let f = |x: Int| -> Pair { { a: x } }; f(1).a }\nfn _kept() -> Int = 4\nfn main() -> Int = 5\ntype Unused = | Nothing\ntest \"calls it\" { assert_eq(tested(), 3) }\nlaw \"it is the identity\" forall (x: Int) { lawful(x) == x }",
    },
  ]

test "only a definition no root reaches is warned, each once" {
  let d = dump_of(analyse(parse_all(reachable())));
  let said = map(d.diags, |diag: Diag| diag.message);
  assert(contains(said, b"fn `m.dead` is never used"));
  assert(contains(said, b"fn `m.deader` is never used"));
  assert(contains(said, b"type `m.Unused` is never used"));
  assert_eq(len(said), 3);
  assert(len(d.order) > 0)
}

test "a definition's row holds its footprint, parameters and span" {
  let say = def_named(dump_of(analyse(parse_all(program()))), b"m.say");
  assert_eq(say.module, b"m");
  assert_eq(say.simple_name, b"say");
  assert(!say.public && !say.reuse);
  assert_eq(
    scheme_text(scheme_named(published(analyse(parse_all(program()))), b"m.say")),
    b"(Bytes) -> Unit / {m.log.write}",
  );
  assert_eq(atoms_text(say.footprint, b","), b"m.log.write");
  assert_eq(atoms_text(say.performed, b","), b"m.log.emit");
  assert_eq(say.params, [{ name: b"b", at: { module: 0, start: 79, end: 87 } }]);
  assert_eq(say.at, { module: 0, start: 72, end: 126 })
}

test "a test's row is placed by its index and carries its key" {
  assert_eq(dump_of(analyse(parse_all(program()))).tests, [
    {
      key: b"m.says",
      name: b"says",
      module: b"m",
      index: 0,
      nondet: false,
      footprint: [{ effect: b"m.log", resource: RSingleton, mode: MWrite, op: None }],
      at: { module: 0, start: 127, end: 152 },
      name_at: { module: 0, start: 132, end: 138 },
    },
  ])
}

fn effect_named(d: Dump, name: Bytes) -> EffectRow / {abort.raise} =
  match fold(d.effects, None, |acc: Option<EffectRow>, e: EffectRow|
      if e.name == name { Some(e) } else { acc }) {
    Some(e) -> e,
    None -> panic("the answer holds the effect"),
  }

test "an effect's row holds each operation with its mode, its types and its span" {
  let log = effect_named(dump_of(analyse(parse_all(program()))), b"m.log");
  assert_eq(log.module, b"m");
  assert_eq(log.simple_name, b"log");
  assert(!log.public && !log.nondet);
  assert_eq(log.ops, [
    {
      name: b"emit",
      mode: b"write",
      resource_param: false,
      params: [named_type(b"Bytes")],
      ret: named_type(b"Unit"),
      scheme: None,
      at: { module: 0, start: 13, end: 38 },
      carries: [CPlain],
    },
  ]);
  assert_eq(log.at, { module: 0, start: 0, end: 40 })
}

test "a prelude effect is placed outside every module and its operations carry a scheme" {
  let sim = effect_named(dump_of(analyse(parse_all(program()))), b"sim");
  assert_eq(sim.module, b"");
  assert(sim.public);
  assert_eq(sim.at, { module: no_module(), start: 0, end: 0 });
  assert_eq(map(sim.ops, |o: OpRow| o.name), [b"seed"]);
  let seed = at(sim.ops, 0);
  assert_eq(seed.mode, b"read");
  assert_eq(seed.params, []);
  assert_eq(seed.ret, named_type(b"Int"));
  assert_eq(match seed.scheme { Some(sc) -> scheme_text(sc), None -> b"" }, b"() -> Int");
  assert_eq(seed.at, { module: no_module(), start: 0, end: 0 })
}

test "a constructor's row holds its fields and its scheme" {
  let line = filter(dump_of(analyse(parse_all(program()))).ctors, |k: CtorRow| k.name == b"m.Line");
  assert_eq(line, [
    {
      name: b"m.Line",
      module: b"m",
      simple_name: b"Line",
      type_name: b"m.Shape",
      index: 1,
      arity: 1,
      fields: [named_type(b"Int")],
      scheme: {
        ty_vars: [],
        row_vars: [],
        label_vars: [],
        ty: TyFn({
          params: [named_type(b"Int")],
          ret: named_type(b"m.Shape"),
          effects: { atoms: [], tail: None },
        }),
      },
      at: { module: 0, start: 62, end: 71 },
    },
  ])
}

fn def_hash_named(d: Dump, name: Bytes) -> HashRow / {abort.raise} =
  match fold(d.hashes, None, |acc: Option<HashRow>, h: HashFrame|
      match h { HDef(r) -> if r.name == name { Some(r) } else { acc }, _ -> acc }) {
    Some(r) -> r,
    None -> panic("the answer hashes the definition"),
  }

fn body_named(d: Dump, name: Bytes) -> Bytes / {abort.raise} =
  match fold(d.bodies, None, |acc: Option<Bytes>, b: BodyRow|
      if b.name == name { Some(b.body) } else { acc }) {
    Some(b) -> b,
    None -> panic("the answer holds the body"),
  }

test "a hash row carries the definition's hash, its own form and its references, and the body hashes to it" {
  let d = dump_of(analyse(parse_all(program())));
  let say = def_hash_named(d, b"m.say");
  assert(say.own != None);
  assert_eq(say.deps, [b"m.log"]);
  // The test's row follows the definition it reaches.
  let order = map(d.hashes, |h: HashFrame|
    match h { HDef(r) -> r.name, HTest(r) -> r.key, HLaw(r) -> r.key });
  let placed = fold(range(0, len(order)), 0 - 1, |acc: Int, j: Int|
    if at(order, j) == b"m.say" { j } else { acc });
  assert_eq(list_at(order, placed + 1), Some(b"m.says"));
  // A solo body is the kind byte and then exactly the bytes the definition's hash is taken over.
  let body = body_named(d, b"m.say");
  assert_eq(bytes_at(body, 0), 0);
  assert_eq(Some(hex(blake3(bytes_slice(body, 1, bytes_len(body))))), say.def)
}

test "the ordinals list every fn, test and law in source order" {
  assert_eq(dump_of(analyse(parse_all(program()))).ordinals, [
    { module: b"m", items: [b"fn m.say", b"test m.says"] },
  ])
}

fn specified() -> List<Source> =
  [
    {
      name: b"m",
      src: b"effect log { write emit(Bytes) -> Unit }\neffect set Io = {log.write}\nfn say(b: Bytes) -> Unit / {Io} = log.emit(b)\nfn inc(x: Int) -> Int requires x > 0 ensures result > x = x + 1\nlaw \"inc grows\" forall (x: Int) where x > 0 { inc(x) > x }",
    },
  ]

test "a definition's row holds its row aliases and each clause with its kind, index and span" {
  let d = dump_of(analyse(parse_all(specified())));
  let say = def_named(d, b"m.say");
  assert_eq(say.row_aliases, [b"Io"]);
  assert_eq(say.params, [{ name: b"b", at: { module: 0, start: 76, end: 84 } }]);
  assert_eq(say.at, { module: 0, start: 69, end: 114 });
  let inc = def_named(d, b"m.inc");
  assert_eq(
    scheme_text(scheme_named(published(analyse(parse_all(specified()))), b"m.inc")),
    b"(Int) -> Int",
  );
  assert_eq(inc.footprint, []);
  assert_eq(inc.params, [{ name: b"x", at: { module: 0, start: 122, end: 128 } }]);
  assert_eq(inc.spec, [
    { kind: b"requires", index: 0, footprint: [], at: { module: 0, start: 137, end: 151 } },
    { kind: b"ensures", index: 1, footprint: [], at: { module: 0, start: 152, end: 170 } },
  ]);
  assert_eq(inc.at, { module: 0, start: 115, end: 178 });
  assert_eq(inc.literals, [b"int 0"]);
  assert_eq(d.ordinals, [
    { module: b"m", items: [b"fn m.say", b"fn m.inc requires,ensures", b"law m.inc grows"] },
  ])
}

/// One program with both definitions' rows written as `row`, and the set they may name declared.
fn rows_written_as(row: Bytes) -> List<Source> =
  [
    {
      name: b"m",
      src: bytes_concat_all([
        b"pub effect log { write emit(Bytes) -> Unit }\neffect set Io = {log.write}\n",
        b"pub fn say(b: Bytes) -> Unit / {",
        row,
        b"} = log.emit(b)\npub fn twice(b: Bytes) -> Unit / {",
        row,
        b"} = {\n  say(b);\n  say(b)\n}\n",
      ]),
    },
  ]

fn def_hashes(d: Dump) -> List<{ name: Bytes, def: Option<Bytes> }> =
  fold(d.hashes, [], |acc: List<{ name: Bytes, def: Option<Bytes> }>, f: HashFrame|
    match f { HDef(r) -> push(acc, { name: r.name, def: r.def }), _ -> acc })

// A row alias is spelling: only the provenance a reader is shown says which spelling was written.
test "a row alias and its expansion are one program: the same hashes, bodies and rows" {
  let aliased = rows_written_as(b"Io");
  let expanded = rows_written_as(b"log.write");
  // The published rows; the key a row is filed under and what it files of its body are by the
  // text the definition is written as.
  let published = |sources: List<Source>| {
    let rows = rows_of(analysis_of(sources));
    {
      defs: map(rows.defs, |row: KnownDefRow| { ..row, hash: b"", facts: b"" }),
      tests: map(rows.tests, |row: KnownTestRow| { ..row, hash: b"", facts: b"" }),
    }
  };
  assert_eq(published(aliased), published(expanded));
  let a = dump_of(analyse(parse_all(aliased)));
  let e = dump_of(analyse(parse_all(expanded)));
  assert_eq(def_hashes(a), def_hashes(e));
  assert(len(def_hashes(a)) >= 2);
  assert_eq(a.bodies, e.bodies);
  assert_eq(map(a.defs, |row: DefRow| row.row_aliases), [[b"Io"], [b"Io"]]);
  assert_eq(map(e.defs, |row: DefRow| row.row_aliases), [[], []])
}

fn written() -> List<Source> =
  [
    {
      name: b"m",
      src: b"pub type Pair<a, b> = { fst: a, snd: b }\npub effect log { write emit(Bytes) -> Unit }\npub reuse fn keep(xs: List<Int>) -> List<Int> = push(xs, 1)\nlaw \"bounds\" forall (n: Int) where n > -3 && n < 7 { n == n }",
    },
  ]

test "a definition's row holds its visibility, its reuse marker and its parameters as written" {
  let keep = def_named(dump_of(analyse(parse_all(written()))), b"m.keep");
  assert(keep.public && keep.reuse);
  assert_eq(keep.params, [{ name: b"xs", at: { module: 0, start: 104, end: 117 } }])
}

test "a type's row holds its arity and its visibility" {
  assert_eq(
    map(dump_of(analyse(parse_all(written()))).types, |t: TypeRow|
      { name: t.name, module: t.module, public: t.public, arity: t.arity }),
    [{ name: b"m.Pair", module: b"m", public: true, arity: 2 }],
  )
}

test "a guard's literals are in the search's order, a negation folded" {
  assert_eq(map(dump_of(analyse(parse_all(written()))).laws, |l: LawRow| l.literals), [
    [b"int 7", b"int -3", b"int 3"],
  ])
}

test "a law's row holds its binders with their spans and types, and its hashes carry the sentence" {
  let d = dump_of(analyse(parse_all(specified())));
  assert_eq(d.laws, [
    {
      key: b"m.inc grows",
      name: b"inc grows",
      module: b"m",
      index: 0,
      binders: [{ name: b"x", at: { module: 0, start: 203, end: 209 }, ty: named_type(b"Int") }],
      has_guard: true,
      host: false,
      cost: false,
      footprint: [],
      at: { module: 0, start: 179, end: 237 },
      literals: [b"int 0"],
    },
  ]);
  // An `effect set` with no includes.
  assert_eq(map(d.modules, |row: ModuleRow| row.sets), [
    [
      {
        name: b"Io",
        includes: [],
        atoms: [{ effect: b"m.log", resource: RSingleton, mode: MWrite, op: None }],
      },
    ],
  ]);
  let law = match fold(d.hashes, None, |acc: Option<ItemHashRow>, h: HashFrame|
      match h { HLaw(r) -> Some(r), _ -> acc }) {
    Some(r) -> r,
    None -> panic("the law is hashed"),
  };
  assert_eq(law.key, b"m.inc grows");
  assert_eq(bytes_len(law.hash), 64);
  assert_eq(bytes_len(law.text), 64);
  assert_eq(law.deps, [b"m.inc"]);
  // Two clauses: two obligation keys and two sentence keys, in source order.
  let inc = def_hash_named(d, b"m.inc");
  assert(inc.own != None);
  assert_eq(len(inc.specs), 2);
  assert_eq(len(inc.spec_texts), 2)
}

fn claimed() -> List<Source> =
  [
    { name: b"base", src: b"pub fn one() -> Int = 1\npub type Coin = | Heads | Tails" },
    {
      name: b"app",
      src: b"import base\nfn two(x: Int) -> Option<Int> requires x > 0 = Some(base::one() + len([x]))\nlaw \"it grows\" forall (x: Int) where x > 0 { two(x) != None }",
    },
  ]

fn code_text(c: Option<Code>) -> Bytes / {abort.raise} = match c { Some(x) -> dump(x), None -> b"" }

test "a claim is lowered with each global named program-wide, and a builtin and a prelude constructor as written" {
  let out = claims(claimed());
  assert_eq(len(out), 4);
  match at(out, 0) {
    ClaimDef(d) -> {
      assert_eq(d.name, b"base.one");
      assert_eq(d.params, 0);
      assert_eq(code_text(d.body), b"blit(i1)");
      assert_eq(d.spec, [])
    },
    _ -> assert(false),
  };
  assert_eq(at(out, 1), ClaimSum({ name: b"base.Coin", variants: 2 }));
  match at(out, 2) {
    ClaimDef(d) -> {
      assert_eq(d.name, b"app.two");
      assert_eq(d.params, 1);
      assert_eq(
        code_text(d.body),
        b"bapp(bvar(Some,-),bbin(add,bapp(bvar(base.one,-)),bapp(bvar(len,-),blist(ovar(x,0),))))",
      );
      assert_eq(map(d.spec, |c: ClaimClause| c.kind), [SRequires]);
      let c = at(d.spec, 0).clause;
      assert_eq(c.at, { module: 1, start: 51, end: 56 });
      assert_eq(code_text(c.code), b"bbin(gt,ovar(x,0),blit(i0))")
    },
    _ -> assert(false),
  };
  match at(out, 3) {
    ClaimLaw(l) -> {
      assert_eq(l.key, b"app.it grows");
      assert(l.guard != None);
      assert_eq(code_text(l.body), b"bblock(bbin(ne,bapp(bvar(app.two,-),ovar(x,0)),bvar(None,-)))")
    },
    _ -> assert(false),
  }
}

test "an instantiation claims its schema's guard and body with what it was given written in place" {
  let out = claims([
    {
      name: b"lib",
      src: b"pub fn limit() -> Int = 100\npub law schema fixed(f: (Int) -> Int, low: Int) forall (x: Int) where x > low && x < limit() { f(x) == x }",
    },
    {
      name: b"app",
      src: b"import lib\nfn id(n: Int) -> Int = n\nlaw \"made\" = lib::fixed(id, 0)\nlaw \"written\" forall (x: Int) where x > 0 && x < lib::limit() { id(x) == x }\nlaw \"through a lambda\" = lib::fixed(|n: Int| id(n), 0)",
    },
  ]);
  let body_of = |key: Bytes|
    fold(out, b"", |found: Bytes, c: Claim|
      match c { ClaimLaw(l) -> if l.key == key { code_text(l.body) } else { found }, _ -> found });
  let guard_of = |key: Bytes|
    fold(out, b"", |found: Bytes, c: Claim|
      match c {
        ClaimLaw(l) -> if l.key != key { found }
        else { match l.guard { Some(g) -> code_text(g.code), None -> b"" } },
        _ -> found,
      });
  assert_eq(body_of(b"app.made"), body_of(b"app.written"));
  assert_eq(guard_of(b"app.made"), guard_of(b"app.written"));
  assert(bytes_index_of(guard_of(b"app.made"), b"lib.limit") != None);
  // A lambda given stands where the parameter was called, so the prover applies it there.
  assert(bytes_index_of(body_of(b"app.through a lambda"), b"lam(") != None);
  assert(bytes_index_of(body_of(b"app.through a lambda"), b"lib.fixed") == None)
}

test "a record update reaches a claim as the literal it stands for" {
  let out = claims([
    { name: b"m", src: b"pub type P = { a: Int, b: Int }\npub fn bump(p: P) -> P = {..p, b: 3}" },
  ]);
  assert_eq(len(out), 1);
  match at(out, 0) {
    ClaimDef(d) -> assert(bytes_index_of(code_text(d.body), b"upd(") != None),
    _ -> assert(false),
  }
}

test "claims lowered from an analysis are the claims lowered from its sources" {
  let sources = [
    {
      name: b"base",
      src: b"pub type P = { a: Int, b: Int }\npub fn bump(p: P) -> P ensures result.b == 3 = {..p, b: 3}\npub fn same(p: P) -> P = p\npub effect tally { write add[r](n: Int) -> Unit }\npub fn add_twice<[r]>(n: Int) -> Unit / {tally.add[r]} = { tally.add[r](n); tally.add[r](n) }\npub fn keyed<a>(k: a) -> Map<a, Int> where derivable(ord, a) = map_insert(map_new(), k, 1)\n",
    },
    {
      name: b"app",
      src: b"import base\nfn moved(p: base::P) -> Int requires {..p, a: 1}.a == 1 = base::same(p).a\nfn counted() -> Map<Int, Int> / {base::tally.add[c]} = { base::add_twice[c](2); {..base::bump({ a: 0, b: 0 }), a: 1}.a; base::keyed(4) }\nlaw \"bumped\" forall (p: base::P) { base::bump(p) == {..p, b: 3} }\ntest \"updated\" { assert_eq({..base::same({ a: 1, b: 2 }), a: 5}.a, 5) }\n",
    },
  ];
  let w = analysis_of(sources);
  assert_eq(claims_in(w, range(0, len(w.mods))), claims(sources))
}

test "a builtin is published with its scheme and the names its parameters are documented under" {
  let rows = filter(builtin_rows(), |r: BuiltinRow| r.name == b"push");
  assert_eq(len(rows), 1);
  assert_eq(at(rows, 0).params, [b"xs", b"x"]);
  match at(rows, 0).scheme.ty { TyFn(f) -> assert_eq(len(f.params), 2), _ -> assert(false) }
}

fn shipped_modules() -> List<Source> =
  [
    { name: b"std.a", src: b"import std.c\npub fn a() -> Int = 1" },
    { name: b"std.b", src: b"pub fn b() -> Int = 2" },
    { name: b"std.c", src: b"pub fn c() -> Int = 3" },
    { name: b"std.d", src: b"pub fn d() -> Int = 4" },
  ]

fn reached_fixture() -> List<Source> =
  [
    {
      name: b"std.r",
      src: b"import std.s (helper, other)\npub fn used() -> Int = helper()\npub fn unused() -> Int = other()\npub fn imported() -> Int = 3\ntest \"r holds\" { assert(used() == 1) }\n",
    },
    { name: b"std.s", src: b"pub fn helper() -> Int = 1\npub fn other() -> Int = 4\n" },
  ]

fn pulled_hashes(p: Pulled) -> List<{ name: Bytes, hash: Bytes }> =
  match p.out { Analysed(w) -> w.hashes.defs, Refused(_) -> [] }

fn def_names(p: Pulled) -> List<Bytes> / {abort.raise} =
  list::sort(map(pulled_hashes(p), |d: { name: Bytes, hash: Bytes }| d.name))

test "a program reads of a shipped module the functions it reaches and the names it imports" {
  let user = [{ name: b"m", src: b"import std.r (used, imported)\npub fn f() -> Int = used()\n" }];
  let cut = analyse_pulling_std_with(user, reached_fixture(), [], []);
  assert_eq(def_names(cut), [b"m.f", b"std.r.imported", b"std.r.used", b"std.s.helper"]);
  let whole = analyse_pulling_std_with(user, reached_fixture(), [], [], reached: false);
  assert_eq(def_names(whole), [
    b"m.f",
    b"std.r.imported",
    b"std.r.unused",
    b"std.r.used",
    b"std.s.helper",
    b"std.s.other",
  ]);
  // What the program reaches is left whole, so it hashes alike either way.
  let hash_of = |p: Pulled, name: Bytes|
    fold(pulled_hashes(p), None, |acc: Option<Bytes>, d: { name: Bytes, hash: Bytes }|
      if d.name == name { Some(d.hash) } else { acc });
  assert_eq(hash_of(cut, b"std.r.used"), hash_of(whole, b"std.r.used"));
  assert(hash_of(cut, b"std.r.used") != None)
}

test "a shipped function is read with what its specifications name" {
  let specified = [
    {
      name: b"std.q",
      src: b"import std.s (helper)\nimport std.s as s\npub fn used(n: Int) -> Int\n  requires n > s::other()\n  ensures result == model(n) + helper()\n= n\nfn model(n: Int) -> Int = n - further()\nfn further() -> Int = 1\npub fn unused() -> Int = 2\n",
    },
    {
      name: b"std.s",
      src: b"pub fn helper() -> Int = 1\npub fn other() -> Int = 4\npub fn idle() -> Int = 5\n",
    },
  ];
  let cut = analyse_pulling_std_with(
    [{ name: b"m", src: b"import std.q\npub fn f() -> Int = q::used(9)\n" }],
    specified,
    [],
    [],
  );
  assert_eq(match cut.out { Analysed(_) -> [], Refused(diags) -> map(diags, |d: Diag| d.code) }, [
  ]);
  assert_eq(def_names(cut), [
    b"m.f",
    b"std.q.further",
    b"std.q.model",
    b"std.q.used",
    b"std.s.helper",
    b"std.s.other",
  ])
}

test "a shipped type is read with what its module states of it, though the program reaches neither" {
  let stating = [
    {
      name: b"std.n",
      src: b"import std.s (helper)\npub type N = | N(Int)\nkey for N by held\nshow for N by written\nnumeric for N by { add: plus, sub: plus, mul: plus, neg: same, of_int: of }\nfn held(n: N) -> Int = match n { N(x) -> x + helper() }\nfn written(n: N) -> String = \"n\"\nfn plus(a: N, b: N) -> N = a\nfn same(a: N) -> N = a\nfn of(n: Int) -> N = N(n)\npub fn unused() -> Int = 2\n",
    },
    { name: b"std.s", src: b"pub fn helper() -> Int = 1\npub fn other() -> Int = 4\n" },
  ];
  // The module is imported and nothing of it is used: the type stands, so its functions do.
  let idle = analyse_pulling_std_with(
    [{ name: b"m", src: b"import std.n\npub fn f() -> Int = 1\n" }],
    stating,
    [],
    [],
  );
  assert_eq(
    match idle.out { Analysed(_) -> [], Refused(diags) -> map(diags, |d: Diag| d.code) },
    [],
  );
  assert_eq(def_names(idle), [
    b"m.f",
    b"std.n.held",
    b"std.n.of",
    b"std.n.plus",
    b"std.n.same",
    b"std.n.written",
    b"std.s.helper",
  ]);
  // Reached only through an operator and a comparison, they are the same functions.
  let used = analyse_pulling_std_with(
    [{ name: b"m", src: b"import std.n (N)\npub fn f(a: N, b: N) -> Bool = a + b == a\n" }],
    stating,
    [],
    [],
  );
  assert_eq(def_names(used), def_names(idle))
}

/// `std.z` declares an effect and a function named `pack`, and an effect, a type and a constructor
/// named `Pack`; `std.y` imports both names for the effect and the type alone.
fn namesakes() -> List<Source> =
  [
    {
      name: b"std.z",
      src: b"pub effect pack {\n  raise refused(at: Int)\n}\npub effect Pack {\n  raise spilled(at: Int)\n}\npub type Pack = | Pack(Int) | Loose\npub fn pack(n: Int) -> Pack = Pack(squeezed(n))\nfn squeezed(n: Int) -> Int = n + deeper()\nfn deeper() -> Int = 1\npub fn try_unpack(p: Pack) -> Int / {pack.refused, Pack.spilled} =\n  match p { Pack(n) -> if n < 0 { pack.refused(n) } else { n }, Loose -> Pack.spilled(0) }\npub fn idle() -> Int = 3\n",
    },
    {
      name: b"std.y",
      src: b"import std.z (pack, Pack, Loose)\npub fn guarded(n: Int) -> Int / {pack.refused} = if n < 0 { pack.refused(n) } else { n }\npub fn loose() -> Pack = Loose\n",
    },
  ]

/// The functions a load of a module importing `imports` holds, read cold and then seeded with the
/// rows and the hashes the cold load filed; what a refused load said in their place.
fn loaded_twice(imports: Bytes) -> List<List<Bytes>> / {abort.raise} = {
  let user = [{ name: b"m", src: bytes_concat(imports, b"\npub fn f() -> Int = 1\n") }];
  let said = |diags: List<Diag>| map(diags, |d: Diag| bytes_concat_all([d.code, b": ", d.message]));
  let cold = analyse_pulling_std_with(user, namesakes(), [], []);
  match cold.out {
    Refused(diags) -> [said(diags)],
    Analysed(w) -> {
      let rows = rows_of(w);
      let warm = analyse_pulling_std_with(
        user,
        namesakes(),
        rows.defs,
        rows.tests,
        priors: w.hashes.priors,
      );
      [
        def_names(cold),
        match warm.out { Refused(diags) -> said(diags), Analysed(_) -> def_names(warm) },
      ]
    },
  }
}

test "a shipped function is read for itself, not for an effect or a type that shares its name" {
  let both = |names: List<Bytes>| [names, names];
  // Nothing of the module is used: its types and effects stand, and no function does.
  assert_eq(loaded_twice(b"import std.z"), both([b"m.f"]));
  // `try_unpack` raises through the effect `pack` and matches the constructor `Pack`.
  assert_eq(loaded_twice(b"import std.z (try_unpack)"), both([b"m.f", b"std.z.try_unpack"]));
  // An imported name is every definition behind it, so the function comes with what it calls.
  assert_eq(
    loaded_twice(b"import std.z (pack)"),
    both([b"m.f", b"std.z.deeper", b"std.z.pack", b"std.z.squeezed"]),
  );
  assert_eq(loaded_twice(b"import std.z (Pack)"), both([b"m.f"]));
  assert_eq(loaded_twice(b"import std.z (Loose)"), both([b"m.f"]));
  assert_eq(loaded_twice(b"import std.z (idle)"), both([b"m.f", b"std.z.idle"]));
  // A shipped module's own import of the name keeps the effect once the function is left out.
  assert_eq(loaded_twice(b"import std.y (guarded)"), both([b"m.f", b"std.y.guarded"]));
  assert_eq(loaded_twice(b"import std.y (loose)"), both([b"m.f", b"std.y.loose"]));
  assert_eq(loaded_twice(b"import std.y"), both([b"m.f"]))
}

test "a shipped type's sampler is read with its generator, though the program reaches neither" {
  let stating = [
    {
      name: b"std.n",
      src: b"import std.gen (Gen, constant)\npub type N = new { n: Int }\ngen for N by drawn\nfn drawn() -> Gen<N> = constant({ n: 1 })\npub fn unused() -> Int = 2\n",
    },
    {
      name: b"std.gen",
      src: b"pub type Gen<a> = | Gen((Int) -> Option<a>)\npub type Sample<a> = { value: Option<a>, record: List<Int>, discards: Int }\npub fn sample<a>(g: Gen<a>, root: Int, key: Bytes, size: Int, replay: Option<List<Int>>) -> Sample<a> = match g { Gen(f) -> { value: f(root), record: [], discards: 0 } }\npub fn elements<a>(xs: List<a>) -> Gen<a> = Gen(|i: Int| list_at(xs, i))\npub fn constant<a>(x: a) -> Gen<a> = Gen(|_i: Int| Some(x))\n",
    },
  ];
  let idle = analyse_pulling_std_with(
    [{ name: b"m", src: b"import std.n\npub fn f() -> Int = 1\n" }],
    stating,
    [],
    [],
  );
  assert_eq(
    match idle.out { Analysed(_) -> [], Refused(diags) -> map(diags, |d: Diag| d.code) },
    [],
  );
  // A prover enters the sampler by name, so it stands wherever its type's module is read.
  assert_eq(def_names(idle), [
    b"m.f",
    b"std.gen.constant",
    b"std.gen.sample",
    b"std.n._sample_N",
    b"std.n.drawn",
  ])
}

test "a stub keeps a gen's statement whole: its sampler has no body there to blank" {
  let src = b"import std.gen (Gen, constant)\npub type N = new { n: Int }\ngen for N by drawn\nfn drawn() -> Gen<N> = { constant({ n: 1 }) }\n";
  let cuts = cuts_of(parse_at(0, { name: b"m", src: src }).module);
  assert_eq(map(cuts, |c: Cut| c.name), [b"m.drawn"])
}

test "a shipped compiler module's bare sibling import keeps only what the program reaches" {
  let user = [{ name: b"m", src: b"import compiler.a (first)\npub fn f() -> Int = first()\n" }];
  let shipped = [
    {
      name: b"compiler.a",
      src: b"import b (second, third)\npub fn first() -> Int = second()\npub fn unused() -> Int = third()\n",
    },
    { name: b"compiler.b", src: b"pub fn second() -> Int = 1\npub fn third() -> Int = 2\n" },
  ];
  let cut = analyse_pulling_std_with(user, shipped, [], []);
  assert_eq(def_names(cut), [b"compiler.a.first", b"compiler.b.second", b"m.f"])
}

fn view_named(views: List<ShippedView>, module: Bytes) -> ShippedView / {abort.raise} =
  match filter(views, |v: ShippedView| v.module == module) {
    [v, ..] -> v,
    [] -> panic("no view of the module"),
  }

fn view_names(v: ShippedView) -> List<Bytes> / {abort.raise} =
  list::sort(map(v.defs, |d: { name: Bytes, hash: Bytes }| d.name))

test "a load's view of a shipped module is its form and the functions the program reached" {
  let user = [{ name: b"m", src: b"import std.r (used, imported)\npub fn f() -> Int = used()\n" }];
  let viewed = analyse_pulling_std_with(user, reached_fixture(), [], []).viewed;
  assert_eq(map(viewed, |v: ShippedView| v.module), [b"std.r", b"std.s"]);
  assert_eq(view_names(view_named(viewed, b"std.r")), [b"std.r.imported", b"std.r.used"]);
  assert_eq(view_names(view_named(viewed, b"std.s")), [b"std.s.helper"]);
  assert_eq(view_named(viewed, b"std.s").text, hex(blake3(at(reached_fixture(), 1).src)));
  // A view is told as text lines, so every part of it is hex.
  let hexed = |b: Bytes|
    bytes_len(b) == 64
      && fold(range(0, 64), true, |ok: Bool, i: Int| {
        let c = bytes_at(b, i);
        ok && ((c >= 48 && c <= 57) || (c >= 97 && c <= 102))
      });
  fold(viewed, (), |u: Unit, v: ShippedView| {
    assert(hexed(v.text) && hexed(v.form), None);
    fold(v.defs, (), |w: Unit, d: { name: Bytes, hash: Bytes }| assert(hexed(d.hash), None))
  });
  assert_eq(analyse_pulling_std_with(user, reached_fixture(), [], [], reached: false).viewed, []);
  // Read whole, a module answers the same form and hashes for each function the view holds.
  match shipped_views([b"std.r"], reached_fixture()) {
    Err(_) -> panic("the shipped modules hash"),
    Ok(now) ->
      fold(viewed, (), |u: Unit, v: ShippedView| {
        let whole = view_named(now, v.module);
        assert_eq(whole.form, v.form);
        assert_eq(whole.text, v.text);
        fold(v.defs, (), |w: Unit, d: { name: Bytes, hash: Bytes }|
          assert(contains(whole.defs, d), Some(string_of_bytes(d.name))))
      }),
  }
}

test "a function nothing reaches leaves a view's form alone and a type moves it" {
  let user = [{ name: b"m", src: b"import std.r (used)\npub fn f() -> Int = used()\n" }];
  let with_s = |text: Bytes|
    view_named(
      analyse_pulling_std_with(
        user,
        [at(reached_fixture(), 0), { name: b"std.s", src: text }],
        [],
        [],
      ).viewed,
      b"std.s",
    );
  let before = with_s(at(reached_fixture(), 1).src);
  let added = with_s(bytes_concat(at(reached_fixture(), 1).src, b"pub fn later() -> Int = 5\n"));
  assert(added.text != before.text, None);
  assert_eq(added.form, before.form);
  assert_eq(added.defs, before.defs);
  let typed = with_s(bytes_concat(at(reached_fixture(), 1).src, b"pub type T = { x: Int }\n"));
  assert(typed.form != before.form, None)
}

test "the shipped modules a program imports follow it a round at a time, each round in byte order" {
  let a = answer_pulling_std_with(
    [{ name: b"m", src: b"import std.b\nimport std.a\npub fn f() -> Int = 1" }],
    shipped_modules(),
    [],
    [],
  );
  assert_eq(a.pulled, [b"std.a", b"std.b", b"std.c"]);
  assert_eq(a.dump.diags, []);
  assert(len(a.dump.order) > 0)
}

test "an import of a module that does not ship is reported at the import, listing the ones that do" {
  let a = answer_pulling_std_with(
    [{ name: b"m", src: b"import std.e\npub fn f() -> Int = 1" }],
    shipped_modules(),
    [],
    [],
  );
  assert_eq(a.pulled, []);
  assert_eq(a.dump.diags, [
    {
      code: b"E0106",
      notes: 2,
      labels: [{ module: 0, start: 7, end: 12, primary: true, text: b"not found" }],
      text: b"",
      message: b"no module named `std.e` ships with this compiler",
      notes_text: [
        b"the stdlib holds: `std.a`, `std.b`, `std.c`, `std.d`",
        b"`ply std` lists them with the digest this binary was built from",
      ],
      severity: b"error",
      fixes: [],
    },
  ])
}

/// `shipped_modules` as a load reads them: each module's text, asked of `read` when it is pulled.
fn shipped_text(name: Bytes) -> Option<Bytes> =
  fold(shipped_modules(), None, |acc: Option<Bytes>, s: Source|
    if s.name == name { Some(s.src) } else { acc })

fn pulled_by(user: List<Source>) -> { shipping: Shipping, asked: List<Bytes> } / {abort.raise} =
  with_cell[asked]([]) { c -> {
    let shipping = shipped_pulled(
      user,
      { root: b"", manifest: None, supplied: [] },
      map(shipped_modules(), |s: Source| s.name),
      |name: Bytes| {
        cell_update(c, |xs: List<Bytes>| push(xs, name));
        shipped_text(name)
      },
    );
    { shipping: shipping, asked: cell_get(c) }
  } }

test "a load reads the shipped modules it imports and what those import, and no other" {
  let p = pulled_by([{ name: b"m", src: b"import std.a\npub fn f() -> Int = 1" }]);
  assert_eq(p.asked, [b"std.a", b"std.c"]);
  assert_eq(map(p.shipping.read, |s: Source| s.name), [b"std.a", b"std.c"]);
  assert_eq(p.shipping.unread, [b"std.b", b"std.d"])
}

test "a load reads a compiler module's bare sibling imports and what it embeds beside its package" {
  let texts = [
    {
      name: b"compiler.fmt",
      src: b"import lexer\npub fn f() -> Bytes = embed(\"../prelude.ply\")\n",
    },
    { name: b"compiler.lexer", src: b"pub fn l() -> Int = 1\n" },
    { name: b"compiler.prelude", src: b"" },
    { name: b"compiler.unit", src: b"pub fn u() -> Int = 2\n" },
  ];
  let s = shipped_pulled(
    [{ name: b"app", src: b"import compiler.fmt\nfn main() -> Unit = ()\n" }],
    { root: b"", manifest: None, supplied: [] },
    map(texts, |t: Source| t.name),
    |name: Bytes|
      fold(texts, None, |acc: Option<Bytes>, t: Source|
        if t.name == name { Some(t.src) } else { acc }),
  );
  assert_eq(map(s.read, |t: Source| t.name), [
    b"compiler.fmt",
    b"compiler.prelude",
    b"compiler.lexer",
  ]);
  assert_eq(s.unread, [b"compiler.unit"])
}

test "handed only what a load reads, the front end pulls and answers as it does over every module" {
  let user = [{ name: b"m", src: b"import std.b\nimport std.a\npub fn f() -> Int = 1" }];
  let p = pulled_by(user);
  let whole = analyse_pulling_std(user, shipped_modules());
  let lazy = analyse_pulling_std_with(user, p.shipping.read, [], [], unread: p.shipping.unread);
  assert_eq(lazy.pulled, whole.pulled);
  assert_eq(dump_of(lazy.out), dump_of(whole.out))
}

test "a module that does not ship is reported listing every one that does, read or not" {
  let user = [{ name: b"m", src: b"import std.e\npub fn f() -> Int = 1" }];
  let p = pulled_by(user);
  assert_eq(p.shipping.read, []);
  let lazy = analyse_pulling_std_with(user, [], [], [], unread: p.shipping.unread);
  let whole = analyse_pulling_std(user, shipped_modules());
  assert_eq(dump_of(lazy.out), dump_of(whole.out))
}

fn compiler_shipped() -> List<Source> =
  [
    { name: b"compiler.a", src: b"import compiler.b (second)\npub fn first() -> Int = second()" },
    { name: b"compiler.b", src: b"pub fn second() -> Int = 1" },
  ]

test "a shipped compiler module is pulled in under the compiler's root" {
  let a = answer_pulling_std_with(
    [{ name: b"m", src: b"import compiler.a (first)\npub fn f() -> Int = first()" }],
    compiler_shipped(),
    [],
    [],
  );
  assert_eq(a.pulled, [b"compiler.a", b"compiler.b"]);
  assert_eq(a.dump.diags, []);
  assert_eq(len(filter(a.dump.defs, |row: DefRow| row.name == b"compiler.a.first")), 1)
}

fn messages(d: Dump) -> List<Bytes> = map(d.diags, |diag: Diag| diag.message)

test "a shipped module importing outside the shipped modules is the compiler's own defect" {
  let a = answer_pulling_std_with(
    [{ name: b"m", src: b"import compiler.a (first)\npub fn f() -> Int = first()" }],
    [{ name: b"compiler.a", src: b"import std.e (e)\npub fn first() -> Int = e()" }],
    [],
    [],
  );
  assert(
    contains(
      messages(a.dump),
      b"the shipped module `compiler.a` imports `std.e`, which this build does not ship",
    ),
  )
}

test "a shipped module importing outside the shipped ones is placed in that module, which the answer names" {
  let a = answer_pulling_std_with(
    [{ name: b"m", src: b"import std.x\npub fn f() -> Int = 1" }],
    [{ name: b"std.x", src: b"import m\npub fn x() -> Int = 1" }],
    [],
    [],
  );
  assert_eq(a.pulled, [b"std.x"]);
  let said = filter(a.dump.diags, |diag: Diag|
    diag.message == b"the shipped module `std.x` imports `m`, which this build does not ship");
  assert_eq(map(said, |diag: Diag| diag.labels), [
    [
      {
        module: 1,
        start: 7,
        end: 8,
        primary: true,
        text: b"a stdlib module may import only modules that ship with it",
      },
    ],
  ])
}

fn answered() -> List<Source> =
  [
    {
      name: b"base",
      src: b"pub effect log { write emit(Bytes) -> Unit }\npub type Shape = | Dot | Line(Int)\npub fn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\npub fn same(x: Int) -> Int = x",
    },
    { name: b"app", src: b"import base\nimport std.b\npub fn two() -> Int = base::same(2)" },
  ]

fn def_named(d: Dump, name: Bytes) -> DefRow / {abort.raise} =
  match fold(d.defs, None, |acc: Option<DefRow>, r: DefRow|
      if r.name == name { Some(r) } else { acc }) {
    Some(r) -> r,
    None -> panic("the dump holds the definition"),
  }

test "the answer's rows hold each type and row as the checker's value" {
  let a = answer_pulling_std_with(answered(), shipped_modules(), [], []);
  assert_eq(a.pulled, [b"std.b"]);
  let same = def_named(a.dump, b"base.same");
  assert_eq(same.footprint, []);
  let write: Atom = { effect: b"base.log", resource: RSingleton, mode: MWrite, op: None };
  let say = def_named(a.dump, b"base.say");
  assert_eq(say.footprint, [write]);
  assert_eq(
    map(filter(a.dump.ctors, |k: CtorRow| k.name == b"base.Line"), |k: CtorRow| k.fields),
    [[named_type(b"Int")]],
  )
}

test "a refused program's answer is its diagnostics, placed where it went wrong, with no rows" {
  let bad = [{ name: b"m", src: b"fn f() -> Int = \"x\"" }];
  let a = answer_pulling_std_with(bad, [], [], []);
  assert_eq(a.pulled, []);
  assert_eq(a.dump.diags, [
    {
      code: b"E0201",
      notes: 0,
      labels: [
        { module: 0, start: 16, end: 19, primary: true, text: b"expected `Int`, found `String`" },
      ],
      text: b"",
      message: b"type mismatch: function body type",
      notes_text: [],
      severity: b"error",
      fixes: [],
    },
  ]);
  assert_eq(a.dump.order, []);
  assert_eq(a.dump.modules, []);
  assert_eq(a.dump.defs, []);
  assert_eq(a.dump.tests, []);
  assert_eq(a.dump.hashes, [])
}

fn analysis_of(sources: List<Source>) -> Analysis / {abort.raise} =
  match analyse(parse_all(sources)) { Refused(_) -> panic("the program checks"), Analysed(w) -> w }

fn seeded_of(outcome: AnalysisOutcome) -> List<Bytes> / {abort.raise} =
  match outcome { Refused(_) -> panic("the program checks"), Analysed(w) -> w.checked.seeded }

fn effectful() -> List<Source> =
  [
    {
      name: b"base",
      src: b"pub effect log { write emit(Bytes) -> Unit }\npub fn say(b: Bytes) -> Unit / { log.write } = log.emit(b)",
    },
    {
      name: b"app",
      src: b"import base\nfn twice(b: Bytes) -> Unit / {base::log.write} = base::say(b)\ntest \"says\" { twice(b\"x\") }",
    },
  ]

type Published = { dump: Dump, schemes: List<{ name: Bytes, scheme: Scheme }> }

/// The rows an analysis publishes, which number their variables as their texts name them: a seeded
/// row and a walked one are then alike, however the checker numbered each. What a load answers, all
/// but what its check walked (a seeded load walks less by design), and every definition's scheme.
fn published(outcome: AnalysisOutcome) -> Published / {abort.raise} =
  {
    dump: { ..dump_of(outcome), walked: b"" },
    schemes: match outcome {
      Refused(_) -> [],
      Analysed(w) ->
        map(w.checked.defs, |def_info: DefInfo|
          { name: def_info.name, scheme: canonical_scheme(def_info.scheme) }),
    },
  }

fn scheme_named(p: Published, name: Bytes) -> Scheme / {abort.raise} =
  match fold(p.schemes, None, |acc: Option<Scheme>, s: { name: Bytes, scheme: Scheme }|
      if s.name == name { Some(s.scheme) } else { acc }) {
    Some(sc) -> sc,
    None -> panic("the analysis checked the definition"),
  }

// The same definition, with a module of generics checked ahead of it in one of the two programs:
// the checker numbers its variables apart in the two, and the rows do not.
test "two programs alike but for what the checker numbered first publish equal rows" {
  let pick = b"pub fn pick<p, q>(x: p, y: q, f: (p) -> q) -> List<q> = [f(x), y]";
  let alone = [{ name: b"m", src: pick }];
  let behind = [
    { name: b"a", src: b"pub fn first<c, d, e>(x: c, y: d, z: e) -> c = x" },
    { name: b"m", src: pick },
  ];
  let raw = |sources: List<Source>|
    fold(analysis_of(sources).checked.defs, None, |acc: Option<Scheme>, def_info: DefInfo|
      if def_info.name == b"m.pick" { Some(def_info.scheme) } else { acc });
  assert(raw(alone) != raw(behind));
  let one = published(analyse(parse_all(alone)));
  let two = published(analyse(parse_all(behind)));
  assert_eq(scheme_named(one, b"m.pick"), scheme_named(two, b"m.pick"));
  assert_eq(def_named(one.dump, b"m.pick").footprint, def_named(two.dump, b"m.pick").footprint);
  assert_eq(scheme_named(one, b"m.pick").ty_vars, [0, 1])
}

test "a definition whose hash has not moved is published from its rows, not from its body" {
  let rows = rows_of(analysis_of(effectful()));
  assert(len(rows.defs) > 0);
  assert(len(rows.tests) > 0);
  let seeded = analyse_with(parse_all(effectful()), rows.defs, rows.tests);
  assert_eq(seeded_of(seeded), [b"base.say", b"app.twice"]);
  assert_eq(published(seeded), published(analyse(parse_all(effectful()))));
  assert_eq(seeded_of(analyse(parse_all(effectful()))), [])
}

/// `around` performs an effect of its own beside its argument's; `bare` performs its argument's alone.
fn generic() -> List<Source> =
  [
    {
      name: b"base",
      src: b"pub effect log { write emit(Bytes) -> Unit }\npub fn around<a | e>(f: () -> a / e) -> a / {log.write | e} = {\n  log.emit(b\"in\");\n  f()\n}\npub fn bare<a | e>(f: () -> a / e) -> a / e = f()",
    },
    {
      name: b"app",
      src: b"import base\nfn twice(b: Bytes) -> Unit / {base::log.write} = base::around(|| base::bare(|| base::log.emit(b)))\ntest \"says\" { twice(b\"x\") }",
    },
  ]

test "a definition generic over a row is published from its rows, ending in the row it writes" {
  let rows = rows_of(analysis_of(generic()));
  let seeded = analyse_with(parse_all(generic()), rows.defs, rows.tests);
  assert_eq(seeded_of(seeded), [b"base.around", b"base.bare", b"app.twice"]);
  assert_eq(published(seeded), published(analyse(parse_all(generic()))))
}

test "rows filed under a hash this program no longer has are walked instead" {
  let rows = rows_of(analysis_of(effectful()));
  let stale = map(rows.defs, |row: KnownDefRow|
    { ..row, hash: b"moved", footprint: b"nowhere.read", performed: b"nowhere.read" });
  let walked = analyse_with(parse_all(effectful()), stale, []);
  assert_eq(seeded_of(walked), []);
  assert_eq(published(walked), published(analyse(parse_all(effectful()))))
}

/// The same program with the effect under another name. An effect is nominal, so `say` and `twice`
/// hash differently here and their filed rows — which name the old effect — are not rows about this.
fn renamed() -> List<Source> =
  [
    {
      name: b"base",
      src: b"pub effect trace { write emit(Bytes) -> Unit }\npub fn say(b: Bytes) -> Unit / { trace.write } = trace.emit(b)",
    },
    {
      name: b"app",
      src: b"import base\nfn twice(b: Bytes) -> Unit / {base::trace.write} = base::say(b)\ntest \"says\" { twice(b\"x\") }",
    },
  ]

fn test_footprint_of(outcome: AnalysisOutcome, key: Bytes) -> Bytes / {abort.raise} =
  match outcome {
    Refused(_) -> b"<refused>",
    Analysed(w) ->
      fold(w.checked.tests, b"", |acc: Bytes, test_info: TestInfo|
        if test_info.key == key { atoms_text(test_info.footprint, b",") } else { acc }),
  }

test "a test's footprint and a law's leave out a raise, which the run answers" {
  let a = analyse(
    parse_all([
      {
        name: b"m",
        src: b"pub effect log { write put(Bytes) -> Unit }\nfn half(n: Int, d: Int) -> Int / {abort.raise} = n / d\ntest \"halves\" { log.put(b\"x\"); assert_eq(half(4, 2), 2) }\nlaw \"whole\" forall (n: Int) { half(n, 1) == n }",
      },
    ]),
  );
  assert_eq(test_footprint_of(a, b"m.halves"), b"m.log.put");
  match a {
    Refused(_) -> panic("the program checks"),
    Analysed(w) -> assert_eq(map(w.checked.laws, |l: LawInfo| l.footprint), [[]]),
  }
}

test "a row filed before an effect was renamed is not a row about this program" {
  let rows = rows_of(analysis_of(effectful()));
  assert(fold(rows.defs, false, |acc: Bool, row: KnownDefRow| acc || len(row.effect_hashes) > 0));
  assert(fold(rows.tests, false, |acc: Bool, row: KnownTestRow| acc || len(row.effect_hashes) > 0));
  let seeded = analyse_with(parse_all(renamed()), rows.defs, rows.tests);
  // A test's row names its effects as a definition's does, and goes stale with them.
  assert_eq(test_footprint_of(seeded, b"app.says"), b"base.trace.write");
  assert_eq(published(seeded), published(analyse(parse_all(renamed()))))
}

/// A read operation and a write one, so a row that forgot an operation's mode would say so.
fn moded() -> List<Source> =
  [
    {
      name: b"m",
      src: b"pub effect store { read peek[t]() -> Int  write put[t](n: Int) -> Unit }\ntest \"reads\" { handle { assert_eq(store.peek[a](), 1) } with { store.peek[a]() -> 1 } }\ntest \"touches\" { let n = store.peek[b](); store.put[b](n) }",
    },
  ]

test "a test's row read back from the cache has each operation's mode as its declaration gives it" {
  let cold = analysis_of(moded());
  let rows = rows_of(cold);
  match analyse_with(parse_all(moded()), rows.defs, rows.tests) {
    Refused(_) -> panic("the seeded program checks"),
    Analysed(warm) ->
      assert_eq(
        map(warm.checked.tests, |test_info: TestInfo| test_info.footprint),
        map(cold.checked.tests, |test_info: TestInfo| test_info.footprint),
      ),
  }
}

fn held(m: Map<Bytes, Bytes>, name: Bytes) -> Bytes =
  match map_get(m, name) { Some(h) -> h, None -> b"" }

fn footprint_of(outcome: AnalysisOutcome, name: Bytes) -> Bytes / {abort.raise} =
  match outcome {
    Refused(_) -> b"<refused>",
    Analysed(w) ->
      fold(w.checked.defs, b"", |acc: Bytes, def_info: DefInfo|
        if def_info.name == name { atoms_text(def_info.footprint, b",") } else { acc }),
  }

/// `say` writes its row and `quiet` writes none, so neither row handed in unifies and the
/// other cannot, in one program and one run.
fn two_effects() -> List<Source> =
  [
    {
      name: b"m",
      src: b"pub effect log { write put() -> Unit }\npub effect other { write put() -> Unit }\npub fn say() -> Unit / {log.write} = log.put()\npub fn quiet(x: Int) -> Int = x",
    },
  ]

/// Both rows are hashed and witnessed as the driver files them, and both name the wrong effect.
fn wrong_rows(sources: List<Source>) -> List<KnownDefRow> / {abort.raise} =
  match analyse(parse_all(sources)) {
    Refused(_) -> panic("the program checks"),
    Analysed(w) -> {
      let defs = by_name(w.checked.checks);
      let witness = [{ name: b"m.other", hash: held(by_name(w.hashes.decls), b"m.other") }];
      map([b"m.say", b"m.quiet"], |n: Bytes|
        {
          name: n,
          hash: held(defs, n),
          effect_hashes: witness,
          footprint: b"m.other.write",
          performed: b"m.other.write",
          scaling: b"",
          repeats: [],
          ending: Ends,
          summary: unknown_summary(),
          facts: filed_facts(no_root_facts(), { start: 0, end: 0 }),
        })
    },
  }

test "a row that will not unify walks the body rather than reporting" {
  let sources = two_effects();
  let seeded = analyse_with(parse_all(sources), wrong_rows(sources), []);
  // Both handed rows contradict what the signatures write, `quiet` writing no `/` and so the empty
  // row. Walking each is the whole answer.
  assert_eq(footprint_of(seeded, b"m.quiet"), b"");
  assert_eq(footprint_of(seeded, b"m.say"), b"m.log.write");
  assert_eq(footprint_of(seeded, b"m.say"), footprint_of(analyse(parse_all(sources)), b"m.say"));
  // A row that was walked past is not counted as one that seeded.
  assert_eq(seeded_of(seeded), [])
}

fn filed_tests(filing: Filing) -> List<KnownTestRow> =
  fold(filing.modules, [], |acc: List<KnownTestRow>, m: FiledModule|
    concat(acc, map(m.tests, |t: FiledTest| t.row)))

fn has_test_row(rows: List<KnownTestRow>, r: KnownTestRow) -> Bool =
  fold(rows, false, |acc: Bool, x: KnownTestRow| acc || x == r)

test "a filing carries exactly the rows the analysis publishes" {
  let w = analysis_of(effectful());
  let f = filing(w);
  let rows = rows_of(w);
  assert_eq(map(f.defs, |d: FiledDef| d.interface.row), rows.defs);
  assert_eq(map(f.defs, |d: FiledDef| d.name), map(rows.defs, |row: KnownDefRow| row.name));
  assert_eq(map(f.defs, |d: FiledDef| d.check), map(rows.defs, |row: KnownDefRow| row.hash));
  assert_eq(len(filed_tests(f)), len(rows.tests));
  assert(
    fold(filed_tests(f), true, |acc: Bool, row: KnownTestRow| acc && has_test_row(rows.tests, row)),
  )
}

test "an analysis seeded from its own filing answers exactly what a fresh one does" {
  let f = filing(analysis_of(effectful()));
  let defs = map(f.defs, |d: FiledDef| d.interface.row);
  let seeded = analyse_with(parse_all(effectful()), defs, filed_tests(f));
  assert_eq(len(seeded_of(seeded)), len(defs));
  assert_eq(published(seeded), published(analyse(parse_all(effectful()))));
  // The test is taken from its row too: the row carries the footprint the walk would find.
  assert_eq(test_footprint_of(seeded, b"app.says"), b"base.log.write")
}

fn probed(body: Bytes) -> List<Source> =
  [
    {
      name: b"base",
      src: bytes_concat_all([
        b"pub fn one() -> Int = ",
        body,
        b"\npub fn two() -> Int = 2\npub fn three() -> Int = one() + 1\n",
      ]),
    },
    {
      name: b"app",
      src: b"import base\npub fn four() -> Int = base::one() + 3\npub fn five() -> Int = base::two() + 4\n",
    },
  ]

test "an edit walks the edited body, and what references it only where what it publishes moved" {
  let rows = rows_of(analysis_of(probed(b"1"))).defs;
  let all = [b"base.one", b"base.two", b"base.three", b"app.four", b"app.five"];
  assert_eq(seeded_of(analyse_with(parse_all(probed(b"1")), rows, [])), all);
  // A body edited to answer what it did: `one` is walked, and nothing that references it.
  assert_eq(seeded_of(analyse_with(parse_all(probed(b"0 + 1")), rows, [])), [
    b"base.two",
    b"base.three",
    b"app.four",
    b"app.five",
  ]);
  // Edited to answer another number, which a caller's ending may read: what references `one` is
  // walked with it, in its package and in the one that imports it, and nothing else.
  assert_eq(seeded_of(analyse_with(parse_all(probed(b"11")), rows, [])), [b"base.two", b"app.five"])
}

/// `leaf` is referenced by `mid` alone, and `mid` by `top`: an edit to `leaf` reaches `top` only
/// through what `mid` publishes.
fn chained(leaf: Bytes) -> List<Source> =
  [
    {
      name: b"m",
      src: bytes_concat_all([
        b"effect probe { read peek() -> Int }\nfn leaf(xs: List<Int>) -> Int = ",
        leaf,
        b"\nfn mid(xs: List<Int>) -> Int = leaf(xs) + 1\npub fn top(xs: List<Int>) -> Int = mid(xs) + 1\ntest \"top\" { assert_eq(top([]), 2) }\n",
      ]),
    },
  ]

fn test_seeded_of(outcome: AnalysisOutcome) -> List<Bytes> / {abort.raise} =
  match outcome { Refused(_) -> panic("the program checks"), Analysed(w) -> w.checked.seeded_tests }

test "a body edit stops at the first definition that publishes what it did" {
  let before = analysis_of(chained(b"len(xs)"));
  let rows = rows_of(before);
  let edited = analyse_with(parse_all(chained(b"len(xs) + 0")), rows.defs, rows.tests);
  assert_eq(seeded_of(edited), [b"m.mid", b"m.top"]);
  // The test references `top` alone, so it is not walked, though its hash moved with the body.
  assert_eq(test_seeded_of(edited), [b"m.top"]);
  match edited {
    Refused(_) -> panic("the program checks"),
    Analysed(w) -> assert(w.hashes.tests != before.hashes.tests),
  };
  assert_eq(published(edited), published(analyse(parse_all(chained(b"len(xs) + 0")))))
}

/// `mid` reads a field of what `leaf` answers and never names its type.
fn shaped(fields: Bytes, built: Bytes) -> List<Source> =
  [
    {
      name: b"m",
      src: bytes_concat_all([
        b"type Shape = { ",
        fields,
        b" }\nfn leaf() -> Shape = { ",
        built,
        b" }\nfn mid() -> Int = leaf().a\npub fn top() -> Int = mid() + 1\n",
      ]),
    },
  ]

test "a caller is walked again when a type its callee's signature names moved" {
  let rows = rows_of(analysis_of(shaped(b"a: Int", b"a: 1"))).defs;
  let edited = analyse_with(parse_all(shaped(b"a: Int, b: Int", b"a: 1, b: 2")), rows, []);
  assert_eq(seeded_of(edited), [b"m.top"])
}

/// `count` ends by descending `n`, or calls itself with what it was handed and says it may not return.
fn counting(again: Bytes, row: Bytes) -> List<Source> =
  [
    {
      name: b"m",
      src: bytes_concat_all([
        b"fn count(n: Int) -> Int",
        row,
        b" = if n <= 0 { 0 } else { count(",
        again,
        b") }\nfn mid(n: Int) -> Int",
        row,
        b" = count(n) + 1\npub fn top(n: Int) -> Int",
        row,
        b" = mid(n) + 1\nfn aside() -> Int = 3\n",
      ]),
    },
  ]

test "a caller is walked again when how its callee's calls end moved" {
  let rows = rows_of(analysis_of(counting(b"n - 1", b""))).defs;
  let edited = analyse_with(parse_all(counting(b"n", b" / {diverges}")), rows, []);
  // `mid` may not return now, and so neither may `top`: each published an ending that moved.
  assert_eq(seeded_of(edited), [b"m.aside"]);
  assert_eq(published(edited), published(analyse(parse_all(counting(b"n", b" / {diverges}")))))
}

/// `spin` and `hop` call each other without descending, and `wait` calls into them; `between` sits
/// between the two members, so a longer one moves `hop` away from `spin`.
fn looping(above: Bytes, between: Bytes) -> List<Source> =
  [
    {
      name: b"m",
      src: bytes_concat_all([
        above,
        b"fn spin(n: Int) -> Int / {diverges} = hop(n + 1)\n",
        between,
        b"fn hop(n: Int) -> Int / {diverges} = spin(n)\npub fn wait(n: Int) -> Int / {diverges} = spin(n)\n",
      ]),
    },
  ]

fn endings(outcome: AnalysisOutcome) -> List<{ name: Bytes, ending: Ending }> / {abort.raise} =
  match outcome {
    Refused(_) -> panic("the program checks"),
    Analysed(w) ->
      map(w.checked.defs, |def_info: DefInfo| { name: def_info.name, ending: def_info.ending }),
  }

test "a seeded ending is where its call is now, however its definitions moved" {
  let rows = rows_of(analysis_of(looping(b"", b""))).defs;
  let moved = looping(b"pub fn aside() -> Int = 3\n", b"pub fn apart() -> Int = 4\n");
  let seeded = analyse_with(parse_all(moved), rows, []);
  assert_eq(seeded_of(seeded), [b"m.spin", b"m.hop", b"m.wait"]);
  assert_eq(endings(seeded), endings(analyse(parse_all(moved))))
}

test "a seeded check files each row under the key a fresh check of the same program does" {
  let before = rows_of(analysis_of(chained(b"len(xs)")));
  let fresh = rows_of(analysis_of(chained(b"len(xs) + 0")));
  match analyse_with(parse_all(chained(b"len(xs) + 0")), before.defs, before.tests) {
    Refused(_) -> panic("the program checks"),
    Analysed(w) -> assert_eq(rows_of(w), fresh),
  }
}

test "seeded from the last answer's filing, an edited program answers what a fresh check does" {
  let before = filing(analysis_of(probed(b"1")));
  let rows = map(before.defs, |d: FiledDef| d.interface.row);
  let seeded = analyse_with(parse_all(probed(b"two() + 5")), rows, filed_tests(before));
  assert_eq(published(seeded), published(analyse(parse_all(probed(b"two() + 5")))));
  assert(len(seeded_of(seeded)) > 0)
}

fn performing(extra: List<Source>) -> List<Source> =
  concat(extra, [
    { name: b"core", src: b"pub effect db {\n  read get[r](key: Int) -> Int\n}\n" },
    {
      name: b"shop",
      src: b"import core\npub fn touch(k: Int) -> Int / {core::db.read[cart]} = core::db.get[cart](k)\ntest \"touch is handled\" {\n  assert_eq(handle touch(1) with { core::db.get[cart](k) -> k + 1, }, 2)\n}\n",
    },
  ])

/// A row names its effects by name, so a new declaration that looks like one must not be taken
/// for it: the seeded answer stays the fresh one.
fn seeded_agrees(before: List<Source>, after: List<Source>) -> Bool / {abort.raise} = {
  let f = filing(analysis_of(before));
  published(
      analyse_with(parse_all(after), map(f.defs, |d: FiledDef| d.interface.row), filed_tests(f)),
    )
    == published(analyse(parse_all(after)))
}

test "adding a look-alike effect keeps a seeded answer the fresh one" {
  let alike = [{ name: b"aaa", src: b"pub effect alpha {\n  read get[r](key: Int) -> Int\n}\n" }];
  assert(seeded_agrees(performing([]), performing([])));
  assert(seeded_agrees(performing([]), performing(alike)))
}

test "adding an unrelated effect keeps a seeded answer the fresh one" {
  let other = [{ name: b"aaa", src: b"pub effect alpha {\n  write put(key: Int) -> Int\n}\n" }];
  assert(seeded_agrees(performing([]), performing(other)))
}

fn declared() -> List<Source> =
  [
    {
      name: b"m",
      src: b"pub type Shape = | Circle(Int) | Empty\npub nondet effect wall { read now() -> Int\n write set[r](Int) -> Unit }\npub fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\npub fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\ntest \"two is even\" { assert(even(2)) }",
    },
  ]

fn entry_named(filing: Filing, name: Bytes) -> FiledEntry / {abort.raise} = {
  let found = fold(filing.modules, None, |acc: Option<FiledEntry>, m: FiledModule|
    fold(m.entries, acc, |a: Option<FiledEntry>, e: FiledEntry|
      if e.name == name { Some(e) } else { a }));
  match found { Some(e) -> e, None -> panic("no entry of that name") }
}

fn decl_named(filing: Filing, name: Bytes) -> DeclInterface / {abort.raise} = {
  let found = fold(filing.decls, None, |acc: Option<DeclInterface>, d: FiledDecl|
    if d.name == name { Some(d.interface) } else { acc });
  match found { Some(i) -> i, None -> panic("no declaration of that name") }
}

test "a module's entries name each item's kind, and a declaration's members in declaration order" {
  let f = filing(analysis_of(declared()));
  assert_eq(map(f.modules, |m: FiledModule| m.name), [b"m"]);
  assert_eq(entry_named(f, b"m.even").kind, b"fn");
  assert_eq(entry_named(f, b"m.Shape").kind, b"type");
  assert_eq(map(entry_named(f, b"m.Shape").members, |x: FiledMember| x.name), [
    b"Circle",
    b"Empty",
  ]);
  assert_eq(entry_named(f, b"m.wall").kind, b"effect");
  assert_eq(map(entry_named(f, b"m.wall").members, |x: FiledMember| x.name), [b"now", b"set"]);
  let tests = fold(f.modules, [], |acc: List<FiledTest>, m: FiledModule| concat(acc, m.tests));
  assert_eq(map(tests, |t: FiledTest| t.row.key), [b"m.two is even"]);
  let shape = decl_named(f, b"m.Shape");
  assert_eq(shape.arity, 0);
  assert_eq(shape.variants, [
    { name: b"Circle", fields: [b"Int"] },
    { name: b"Empty", fields: [] },
  ]);
  let wall = decl_named(f, b"m.wall");
  assert(wall.effect && wall.nondet);
  assert_eq(wall.ops, [
    { name: b"now", mode: b"read", resource: false, params: [], ret: b"Int" },
    { name: b"set", mode: b"write", resource: true, params: [b"Int"], ret: b"Unit" },
  ])
}

test "every body is filed under the hash it verifies as, a cycle's members included" {
  let w = analysis_of(declared());
  let f = filing(w);
  assert(len(f.bodies) > 0);
  assert(fold(f.bodies, true, |acc: Bool, b: FiledBody| acc && body_key(b.body) == Some(b.hash)));
  // One body per hashed name: nothing here declares a name twice.
  assert_eq(len(f.bodies), len(w.hashes.defs) + len(w.hashes.decls));
  let even = held(by_name(w.hashes.defs), b"m.even");
  assert(fold(f.bodies, false, |acc: Bool, b: FiledBody| acc || b.hash == even))
}

// --- Seeding through a session of edits -----------------------------------------
// Each step is analysed from nothing and seeded with what the step before it filed: the two answers
// must be one answer, whatever the edit was. A step that does not check files nothing, so the next
// is seeded from the last that did.

type Step = { what: Bytes, sources: List<Source> }

type Session = { rows: Rows, off: List<Bytes> }

fn filed_rows(filing: Filing) -> Rows =
  { defs: map(filing.defs, |d: FiledDef| d.interface.row), tests: filed_tests(filing) }

/// The steps whose seeded answer is not the fresh one.
fn disagreements(steps: List<Step>) -> List<Bytes> / {abort.raise} = {
  let walked = fold(steps, { rows: { defs: [], tests: [] }, off: [] }, |s: Session, step: Step| {
    let seeded = analyse_with(parse_all(step.sources), s.rows.defs, s.rows.tests);
    let fresh = analyse(parse_all(step.sources));
    let off = if published(seeded) == published(fresh) { s.off } else { push(s.off, step.what) };
    match seeded {
      Refused(_) -> { rows: s.rows, off: off },
      Analysed(w) -> { rows: filed_rows(filing(w)), off: off },
    }
  });
  walked.off
}

fn step(what: Bytes, sources: List<Source>) -> Step = { what: what, sources: sources }

/// Every occurrence of `from` in module `name`, as `to`.
fn edited(
  sources: List<Source>,
  name: Bytes,
  from: Bytes,
  to: Bytes,
) -> List<Source> / {abort.raise} =
  map(sources, |source: Source|
    if source.name != name { source } else if bytes_index_of(source.src, from) == None {
      panic("the fixture drifted: the text to edit is not there")
    } else { { name: source.name, src: join(bytes_split(source.src, from), to) } })

fn with_module(sources: List<Source>, name: Bytes, src: Bytes) -> List<Source> =
  push(filter(sources, |source: Source| source.name != name), { name: name, src: src })

fn without(sources: List<Source>, name: Bytes) -> List<Source> =
  filter(sources, |source: Source| source.name != name)

fn shop_core() -> Bytes =
  b"pub type Money = Int\npub type Item =\n  | Book(String, Money)\n  | Note(String)\npub effect db {\n  read get[r](key: Int) -> Int\n  write put[r](key: Int, value: Int) -> Int\n}\npub fn price(i: Item) -> Money =\n  match i {\n    Book(_, p) -> p,\n    Note(_) -> 0,\n  }\npub fn twice<a>(x: a, f: (a) -> a) -> a = f(f(x))\npub fn label(i: Item) -> String =\n  match i {\n    Book(t, _) -> t,\n    Note(t) -> t,\n  }\ntest \"a note is free\" {\n  assert_eq(price(Note(\"n\")), 0)\n}\n"

fn shop_shop() -> Bytes =
  b"import core\nfn total(items: List<core::Item>) -> Int =\n  fold(items, 0, |acc, i: core::Item| acc + core::price(i))\nfn doubled(n: Int) -> Int = core::twice(n, |x: Int| x + x)\nfn stored(k: Int) -> Int / {core::db.read[cart]} = core::db.get[cart](k)\ntest \"shipped modules adds up\" {\n  assert_eq(total([core::Book(\"b\", 3), core::Note(\"n\")]), 3)\n}\n"

fn shop_leaf() -> Bytes = b"pub fn one() -> Int = 1\npub fn two() -> Int = one() + one()\n"

fn shop() -> List<Source> =
  [
    { name: b"core", src: shop_core() },
    { name: b"shop", src: shop_shop() },
    { name: b"leaf", src: shop_leaf() },
  ]

test "a seeded answer is the fresh one through every kind of edit a session makes" {
  let s0 = shop();
  let s1 = edited(s0, b"leaf", b"one() + one()", b"one() + one() + 0");
  let s2 = edited(
    s1,
    b"leaf",
    b"pub fn two() -> Int = one() + one() + 0",
    b"pub fn two(k: Int) -> Int = one() + k",
  );
  let s3 = edited(s2, b"leaf", b"pub fn one()", b"fn one()");
  let broken = edited(s3, b"leaf", b"fn one() -> Int = 1", b"fn one() -> Int = \"1\"");
  let s4 = edited(s3, b"core", b"pub fn label(", b"pub fn title(");
  let s5 = edited(s4, b"core", b"Book(_, p) -> p,", b"Book(_, p) -> p + 0,");
  let s6 = edited(s5, b"shop", b"acc + core::price(i)", b"acc + core::price(i) + 0");
  let s7 = edited(s6, b"shop", b"import core\n", b"import core\nimport leaf\n");
  let s8 = with_module(s6, b"extra", b"import leaf\npub fn four() -> Int = leaf::two(2) + 2\n");
  let s9 = edited(s8, b"extra", b"+ 2\n", b"+ 3\n");
  let s10 = edited(s9, b"leaf", b"one() + k", b"one() + k + 0");
  let s11 = edited(
    edited(
      s10,
      b"leaf",
      b"fn one() -> Int = 1",
      b"import core\n\nfn one() -> Int = core::price(core::Note(\"n\")) + 1",
    ),
    b"core",
    b"Book(_, p) -> p + 0,",
    b"Book(_, p) -> p + 1,",
  );
  let s12 = without(s11, b"extra");
  let s13 = edited(s12, b"core", b"Money", b"Cost");
  let s14 = edited(
    edited(s13, b"core", b"effect db", b"effect ledger"),
    b"shop",
    b"core::db.",
    b"core::ledger.",
  );
  assert_eq(
    disagreements([
      step(b"cold", s0),
      step(b"unchanged", s0),
      step(b"a body edit in a leaf", s1),
      step(b"a signature edit in a leaf", s2),
      step(b"`pub` removed in a leaf", s3),
      step(b"a type error", broken),
      step(b"the error undone", s3),
      step(b"a rename in a module another imports", s4),
      step(b"a body edit in a module another imports", s5),
      step(b"a body edit in a module that imports another", s6),
      step(b"an import added", s7),
      step(b"an import removed", s6),
      step(b"a file added", s8),
      step(b"an edit to the added file", s9),
      step(b"an edit to the leaf the added file imports", s10),
      step(b"an import added to a module edited with the one it now imports", s11),
      step(b"the added file deleted", s12),
      step(b"a type renamed", s13),
      step(b"an effect renamed", s14),
      step(b"unchanged again", s14),
    ]),
    [],
  )
}

test "moving, removing and re-signing definitions leaves a seeded answer the fresh one" {
  let s0 = shop();
  let twice = b"pub fn twice<a>(x: a, f: (a) -> a) -> a = f(f(x))\n";
  let moved = edited(
    edited(
      edited(
        edited(s0, b"core", twice, b""),
        b"leaf",
        b"pub fn one()",
        bytes_concat(twice, b"pub fn one()"),
      ),
      b"shop",
      b"import core",
      b"import core\nimport leaf",
    ),
    b"shop",
    b"core::twice",
    b"leaf::twice",
  );
  let removed = edited(
    edited(s0, b"shop", b"fn doubled(n: Int) -> Int = core::twice(n, |x: Int| x + x)\n", b""),
    b"core",
    twice,
    b"",
  );
  let spare = with_module(s0, b"spare", b"pub fn spare() -> Int = 9\n");
  let referenced = with_module(s0, b"extra", b"import leaf\npub fn three() -> Int = leaf::two()\n");
  assert_eq(
    disagreements([
      step(b"cold", s0),
      step(b"a definition moved between modules", moved),
      step(b"back", s0),
      step(b"a definition removed outright", removed),
      step(b"back again", s0),
      step(
        b"a dependency's signature changed",
        edited(s0, b"core", b"pub fn price(i: Item) -> Money =", b"pub fn price(i: Item) -> Int ="),
      ),
      step(b"reformatted", edited(s0, b"leaf", b"pub fn one()", b"// a comment\npub fn  one()")),
      step(b"an unreferenced file", spare),
      step(b"deleted", s0),
      step(b"a file importing the leaf", referenced),
      step(b"the leaf deleted under it", without(referenced, b"leaf")),
      step(b"the leaf restored", referenced),
    ]),
    [],
  )
}

test "names shared, declarations alike and tests edited leave a seeded answer the fresh one" {
  let peel = b"pub type Thing = | Wrap(Int)\npub fn peel(t: Thing) -> Int = match t { Wrap(n) -> n }\n";
  let shared = [{ name: b"a", src: peel }, { name: b"b", src: peel }];
  let look = b"pub effect db { read get[r](key: Int) -> Int }\npub fn look(k: Int) -> Int / {db.read[t]} = db.get[t](k)\n";
  // The capability `pick` does not handle is the one its row writes.
  let pick = |m: Bytes|
    bytes_concat_all([
      b"import x\nimport y\npub fn pick(k: Int) -> Int / {",
      if m == b"x" { b"y" } else { b"x" },
      b"::db.read[t]} =\n  handle x::look(k) + y::look(k) with { ",
      m,
      b"::db.get[t](j) -> j, }\n",
    ]);
  let alike = [
    { name: b"x", src: look },
    { name: b"y", src: look },
    { name: b"z", src: b"pub fn plain() -> Int = 7\n" },
    { name: b"w", src: pick(b"x") },
  ];
  let alias = [
    { name: b"alias", src: b"pub type Cents = Int\npub fn zero() -> Cents = 0\n" },
    { name: b"user", src: b"import alias\nfn take() -> alias::Cents = alias::zero()\n" },
    { name: b"lone", src: b"fn lone() -> Int = 1\n" },
  ];
  let tested = b"fn f() -> Int = 1\ntest \"f is one\" { assert_eq(f(), 1) }\n";
  let palette = b"pub type Color = Red | Green\npub fn paint(what: String, shade: Color = Red) -> String =\n  match shade {\n    Red -> string_concat(what, \" red\"),\n    Green -> string_concat(what, \" green\"),\n  }\n";
  let wall = b"import palette\npub fn wall() -> String = palette::paint(\"wall\")\npub fn given() -> String = palette::paint(\"wall\", palette::Green)\ntest \"the default crosses the module boundary\" {\n  assert_eq(wall(), \"wall red\")\n}\n";
  let painted = [{ name: b"palette", src: palette }, { name: b"wall", src: wall }];
  assert_eq(
    disagreements([
      step(b"two definitions sharing a hash", shared),
      step(b"warm", shared),
      step(b"identically declared effects", alike),
      step(b"warm", alike),
      step(b"the handler switched to the other capability", with_module(alike, b"w", pick(b"y"))),
      step(
        b"an unrelated edit",
        with_module(with_module(alike, b"w", pick(b"y")), b"z", b"pub fn plain() -> Int = 8\n"),
      ),
      step(b"a type alias", alias),
      step(b"warm", alias),
      step(b"an unrelated edit", with_module(alias, b"lone", b"fn lone() -> Int = 2\n")),
      step(b"a test", [{ name: b"m", src: tested }]),
      step(b"a test added", [
        { name: b"m", src: bytes_concat(tested, b"test \"twice\" { assert_eq(f() + f(), 2) }\n") },
      ]),
      step(b"a test with a body already present", [
        { name: b"m", src: bytes_concat(tested, b"test \"still one\" { assert_eq(f(), 1) }\n") },
      ]),
      step(b"a cross-module default", painted),
      step(
        b"the default edited",
        edited(painted, b"palette", b"shade: Color = Red", b"shade: Color = Green"),
      ),
    ]),
    [],
  )
}

fn performer(module: Bytes) -> Bytes =
  bytes_concat_all([
    b"import ",
    module,
    b"\npub fn look(k: Int) -> Int / {",
    module,
    b"::db.read[t]} = ",
    module,
    b"::db.get[t](k)\ntest \"looks\" { handle { assert_eq(look(1), 0) } with { ",
    module,
    b"::db.get[t](k) -> 0 } }\n",
  ])

fn effect_decl() -> Bytes = b"pub effect db { read get[r](key: Int) -> Int }\n"

test "a structurally identical effect appearing, renamed or deleted leaves a seeded answer the fresh one" {
  let one = [{ name: b"x", src: effect_decl() }, { name: b"p", src: performer(b"x") }];
  let twins = [
    { name: b"a", src: effect_decl() },
    { name: b"x", src: effect_decl() },
    { name: b"p", src: performer(b"a") },
  ];
  let survivors = [
    { name: b"a", src: effect_decl() },
    { name: b"x", src: effect_decl() },
    { name: b"p", src: performer(b"x") },
  ];
  assert_eq(
    disagreements([
      step(b"cold", one),
      step(b"warm", one),
      step(b"an identical effect appeared", with_module(one, b"a", effect_decl())),
      step(b"twins", twins),
      step(
        b"the twin renamed to sort first",
        with_module(twins, b"x", b"pub effect audit { read get[r](key: Int) -> Int }\n"),
      ),
      step(b"survivors", survivors),
      step(b"the module that ranked first deleted", without(survivors, b"a")),
    ]),
    [],
  )
}

test "reordering, relabelling and re-exporting leave a seeded answer the fresh one" {
  let ops = |first: Bytes, second: Bytes|
    [
      {
        name: b"m",
        src: bytes_concat_all([
          b"pub effect db {\n  ",
          first,
          b"\n  ",
          second,
          b"\n}\npub fn f() -> Int = 1\n",
        ]),
      },
    ];
  let get = b"read get[r](key: Int) -> Int";
  let put = b"write put[r](key: Int, value: String) -> Unit";
  let variants = |body: Bytes| [{ name: b"m", src: bytes_concat(b"pub type T =\n", body) }];
  let labelled = |label: Bytes|
    [
      {
        name: b"m",
        src: bytes_concat_all([
          b"fn f() -> Int = 1\ntest \"",
          label,
          b"\" { assert_eq(f(), 1) }\n",
        ]),
      },
    ];
  let exported = [
    { name: b"a", src: b"pub fn one() -> Int = 1\n" },
    { name: b"b", src: b"import a\nfn two() -> Int = a::one() + a::one()\n" },
  ];
  assert_eq(
    disagreements([
      step(b"operations", ops(get, put)),
      step(b"the operations reordered", ops(put, get)),
      step(b"variants", variants(b"  | A(Int)\n  | B(String)\n")),
      step(b"the variants reordered", variants(b"  | B(String)\n  | A(Int)\n")),
      step(b"a test", labelled(b"f is one")),
      step(b"its label changed", labelled(b"f is really one")),
      step(b"and the run after that", labelled(b"f is really one")),
      step(b"an exported name", exported),
      step(b"its `pub` removed", with_module(exported, b"a", b"fn one() -> Int = 1\n")),
      step(
        b"a selective import",
        with_module(exported, b"b", b"import a (one)\nfn two() -> Int = one() + one()\n"),
      ),
      step(b"back to a module import", exported),
    ]),
    [],
  )
}

test "edits undone, modules renamed and files emptied leave a seeded answer the fresh one" {
  let s0 = shop();
  let leaf2 = b"pub fn one() -> Int = 1\npub fn two() -> Int = one() + 1\n";
  let aliased = edited(
    edited(s0, b"shop", b"import core", b"import core as c"),
    b"shop",
    b"core::",
    b"c::",
  );
  assert_eq(
    disagreements([
      step(b"cold", s0),
      step(b"a body edited", with_module(s0, b"leaf", leaf2)),
      step(b"and reverted", s0),
      step(
        b"a definition added",
        with_module(
          s0,
          b"leaf",
          bytes_concat(shop_leaf(), b"pub fn three() -> Int = two() + one()\n"),
        ),
      ),
      step(b"and deleted", s0),
      step(b"a module renamed", with_module(without(s0, b"leaf"), b"frond", shop_leaf())),
      step(b"and renamed back", s0),
      step(b"an imported module deleted", without(s0, b"core")),
      step(b"and restored", s0),
      step(b"a comment", with_module(s0, b"leaf", bytes_concat(b"// a note\n", shop_leaf()))),
      step(b"an import aliased", aliased),
      step(b"the alias removed", s0),
      step(b"an empty module", with_module(s0, b"empty", b"")),
      step(b"which gained a definition", with_module(s0, b"empty", b"pub fn now() -> Int = 1\n")),
      step(b"and went away", s0),
      step(b"a nested module beside a flat one", [
        { name: b"a", src: b"pub fn x() -> Int = 1\n" },
        { name: b"a.b", src: b"pub fn y() -> Int = 2\n" },
      ]),
      step(b"the nested module changed", [
        { name: b"a", src: b"pub fn x() -> Int = 1\n" },
        { name: b"a.b", src: b"pub fn y() -> Int = 3\n" },
      ]),
    ]),
    [],
  )
}

test "a shuffle of module states leaves a seeded answer the fresh one at every step" {
  let leaves = [
    shop_leaf(),
    bytes_concat(b"// reformatted\n\n", shop_leaf()),
    b"pub fn one() -> Int = 1\npub fn two() -> Int = one() + 1\n",
  ];
  let cores = [
    shop_core(),
    join(bytes_split(shop_core(), b"Money"), b"Cost"),
    join(bytes_split(shop_core(), b"pub fn label("), b"pub fn title("),
  ];
  let shops = [
    shop_shop(),
    join(bytes_split(shop_shop(), b"import core\n"), b"import core\nimport leaf\n"),
    join(bytes_split(shop_shop(), b"acc + core::price(i)"), b"acc + core::price(i) + 0"),
  ];
  // Each step sets one module to one of its states: which, and to what, cycles through every pair.
  let picks = [
    [0, 1],
    [1, 2],
    [2, 1],
    [0, 2],
    [1, 1],
    [2, 2],
    [0, 0],
    [1, 0],
    [2, 0],
    [0, 1],
    [1, 2],
    [0, 2],
  ];
  let states = fold(picks, [shop()], |acc: List<List<Source>>, p: List<Int>| {
    let now = at(acc, len(acc) - 1);
    let module = at(p, 0);
    let pick = at(p, 1);
    push(acc, if module == 0 { with_module(now, b"leaf", at(leaves, pick)) }
    else if module == 1 { with_module(now, b"core", at(cores, pick)) }
    else { with_module(now, b"shop", at(shops, pick)) })
  });
  assert_eq(disagreements(map(states, |sources: List<Source>| step(b"a shuffle step", sources))), [
  ])
}

fn chain_lib(label: Bytes) -> Bytes =
  bytes_concat_all([
    b"pub effect log { write note[r](msg: String) -> Int }\npub fn base(n: Int) -> Int / {log.note[",
    label,
    b"]} = log.note[",
    label,
    b"](\"n\") + n\npub fn mid(n: Int) -> Int / {log.note[",
    label,
    b"]} = base(n) + 1\n",
  ])

test "a row that moves under a caller leaves a seeded answer the fresh one" {
  let before = [
    { name: b"lib", src: chain_lib(b"a") },
    {
      name: b"top",
      src: b"import lib\npub fn top(n: Int) -> Int / {lib::log.write[a]} = lib::mid(n) + 1\n",
    },
  ];
  let after = [
    { name: b"lib", src: chain_lib(b"b") },
    {
      name: b"top",
      src: b"import lib\npub fn top(n: Int) -> Int / {lib::log.write[b]} = lib::mid(n) + 2\n",
    },
  ];
  assert_eq(
    disagreements([step(b"cold", before), step(b"the row moved under a checked caller", after)]),
    [],
  );
  // A caller whose written row the moved one outgrows is refused, seeded as it is fresh.
  let stale = [
    { name: b"lib", src: chain_lib(b"a") },
    {
      name: b"top",
      src: b"import lib\npub fn top(n: Int) -> Int / {lib::log.note[a]} = lib::mid(n) + 1\n",
    },
  ];
  let moved = with_module(stale, b"lib", chain_lib(b"b"));
  assert_eq(disagreements([step(b"cold", stale), step(b"the callee's row moved", moved)]), []);
  let seeded = analyse_with(parse_all(moved), filed_rows(filing(analysis_of(stale))).defs, []);
  assert(match seeded { Refused(_) -> true, Analysed(_) -> false })
}

test "an unused selectively imported name deleted is refused seeded as it is fresh" {
  let s0 = [
    { name: b"lib", src: b"pub fn used() -> Int = 1\npub fn spare() -> Int = 2\n" },
    { name: b"app", src: b"import lib (used, spare)\nfn go() -> Int = used()\n" },
  ];
  let gone = with_module(s0, b"lib", b"pub fn used() -> Int = 1\n");
  assert_eq(
    disagreements([step(b"cold", s0), step(b"warm", s0), step(b"the name deleted", gone)]),
    [],
  );
  match analyse_with(parse_all(gone), filed_rows(filing(analysis_of(s0))).defs, []) {
    Analysed(_) -> panic("an import of a deleted name checked"),
    Refused(ds) -> assert(fold(ds, false, |acc: Bool, diag: Diag| acc || diag.code == b"E0101")),
  }
}

test "a narrowed annotation and a relabelled resource leave a seeded answer the fresh one" {
  let narrowing = |row: Bytes|
    [
      {
        name: b"m",
        src: bytes_concat_all([
          b"pub effect db { read get[r](key: Int) -> Int }\npub fn look(k: Int) -> Int / ",
          row,
          b" = db.get[a](k)\n",
        ]),
      },
    ];
  let labelled = |label: Bytes|
    [
      {
        name: b"m",
        src: bytes_concat_all([
          b"pub effect db { read get[r](key: Int) -> Int }\npub fn look(k: Int) -> Int / {db.read[",
          label,
          b"]} = db.get[",
          label,
          b"](k)\n",
        ]),
      },
      {
        name: b"u",
        src: bytes_concat_all([
          b"import m\nfn use_it() -> Int / {m::db.read[",
          label,
          b"]} = m::look(1)\n",
        ]),
      },
    ];
  let renamed = |ty: Bytes|
    [
      {
        name: b"a",
        src: bytes_concat_all([
          b"pub type ",
          ty,
          b" = | Mk(Int)\npub fn mk() -> ",
          ty,
          b" = Mk(1)\n",
        ]),
      },
      {
        name: b"b",
        src: bytes_concat_all([b"import a\npub fn get() -> a::", ty, b" = a::mk()\n"]),
      },
      { name: b"c", src: b"import b\npub fn top() -> Bool = { b::get(); true }\n" },
    ];
  assert_eq(
    disagreements([
      step(b"a wide annotation", narrowing(b"{db.read[a], db.read[b]}")),
      step(b"the annotation narrowed", narrowing(b"{db.read[a]}")),
      step(b"a resource", labelled(b"a")),
      step(b"the resource relabelled", labelled(b"z")),
      step(b"a type", renamed(b"T")),
      step(b"the type renamed two modules away", renamed(b"Renamed")),
    ]),
    [],
  )
}

test "the order an answer publishes in is the same seeded as fresh" {
  let s0 = [
    {
      name: b"app",
      src: b"import lib\npub effect audit { write note[log](m: Int) -> Unit }\npub type Wrapped = | Wrap(Int) | Empty\nfn second() -> Int = lib::base()\nfn first() -> Int = second()\n",
    },
    {
      name: b"lib",
      src: b"pub effect db { read get[t](k: Int) -> Int }\npub type Row = | Cell(Int)\npub fn base() -> Int = 1\n",
    },
  ];
  assert_eq(disagreements([step(b"cold", s0), step(b"warm", s0)]), [])
}

/// Hashed without being checked, so a program that no longer compiles still has hashes to compare.
fn hash_of(sources: List<Source>, name: Bytes) -> Bytes / {abort.raise} =
  match resolve_modules(map(parse_all(sources), |parsed: ParsedSource| parsed.module)) {
    ResolveFailed(_) -> b"",
    ResolveSucceeded(x) -> match map_get(
        by_name(hash_index(build_index(x.mods, x.r).index).defs),
        name,
      ) {
      Some(h) -> h,
      None -> b"",
    },
  }

test "a map or a set literal and the call it builds are one definition" {
  let lit = [
    {
      name: b"m",
      src: b"pub fn two() -> Map<Int, Int> = #{1: 2, 3: 4}\npub fn s() -> Map<Int, Unit> = #[5]",
    },
  ];
  let call = [
    {
      name: b"m",
      src: b"pub fn two() -> Map<Int, Int> = map_of_entries([{key: 1, value: 2}, {key: 3, value: 4}])\npub fn s() -> Map<Int, Unit> = map_of_entries([{key: 5, value: ()}])",
    },
  ];
  assert(hash_of(lit, b"m.two") != b"");
  assert_eq(hash_of(lit, b"m.two"), hash_of(call, b"m.two"));
  assert_eq(hash_of(lit, b"m.s"), hash_of(call, b"m.s"))
}

test "a qualified name that is not exported moves the hash of everything that names it" {
  let caller = b"import a\npub fn two() -> Int = a::one()";
  let exported = [{ name: b"a", src: b"pub fn one() -> Int = 1" }, { name: b"b", src: caller }];
  let shut = [{ name: b"a", src: b"fn one() -> Int = 1" }, { name: b"b", src: caller }];
  assert(hash_of(exported, b"b.two") != b"");
  // `b.two` no longer compiles, so its hash must not say it still means what it meant while it did.
  assert(hash_of(shut, b"b.two") != hash_of(exported, b"b.two"));
  // `a.one` itself is untouched: `pub` is metadata its own encoding erases.
  assert_eq(hash_of(shut, b"a.one"), hash_of(exported, b"a.one"))
}

test "a project's manifest is checked ahead of the program and carried decoded" {
  let good = analyse_with(parse_all(program()), [], [], {
    root: b".",
    manifest: Some(
      b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"m\", version: {major: 0, minor: 1, patch: 0}, prefix: None, runtime: {major: 0, minor: 1, patch: 0}, dependencies: [], entry: None}",
    ),
    supplied: [],
  });
  match good {
    Refused(ds) -> assert_eq(map(ds, |diag: Diag| diag.code), []),
    Analysed(w) -> match w.manifest { None -> assert(false), Some(m) -> assert_eq(m.name, "m") },
  };
  let malformed = analyse_with(parse_all(program()), [], [], {
    root: b".",
    manifest: Some(b"fn package() -> Int = 1"),
    supplied: [],
  });
  match malformed {
    Analysed(_) -> assert(false),
    Refused(ds) -> {
      assert_eq(at(ds, 0).code, b"E0129");
      // One module of program text, so the manifest's label points one past it.
      assert_eq(at(at(ds, 0).labels, 0).module, 1)
    },
  };
  match analyse_with(parse_all(program()), [], []) {
    Refused(_) -> assert(false),
    Analysed(w) -> assert_eq(w.manifest, None),
  }
}

/// A root package with one path dependency: `lib` grants its prefix, and its modules answer to
/// `lib.<name>` for the root that declares it.
fn with_lib(user: List<Source>) -> PackageSources =
  {
    root: b"app",
    manifest: Some(
      b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"app\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [{name: \"lib\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Path(\"../lib\")}], entry: None}",
    ),
    supplied: [
      {
        root: b"lib",
        manifest: Some(
          b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"lib\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}",
        ),
        modules: [
          { name: b"answer", src: b"pub fn answer() -> Int = 42" },
          { name: b"extra", src: b"fn hidden() -> Int = 1" },
        ],
      },
    ],
  }

test "a declared dependency's modules answer under its prefix" {
  let user = [{ name: b"m", src: b"import lib.answer\nfn main() -> Int = answer::answer()" }];
  match analyse_with(parse_all(user), [], [], with_lib(user)) {
    Refused(ds) -> assert_eq(map(ds, |diag: Diag| diag.code), []),
    Analysed(_) -> assert(true),
  }
}

test "an undeclared dependency's modules refuse, naming holder and importer" {
  let user = [{ name: b"m", src: b"import lib.answer\nfn main() -> Int = answer::answer()" }];
  let pkgs = with_lib(user);
  let undeclared = analyse_with(parse_all(user), [], [], {
    root: b"app",
    manifest: Some(
      b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"app\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}",
    ),
    supplied: pkgs.supplied,
  });
  match undeclared {
    Analysed(_) -> assert(false),
    Refused(ds) -> assert_eq(at(ds, 0).code, b"E0132"),
  }
}

test "a dependency's own imports are siblings of its prefix, not of the root" {
  let user = [{ name: b"m", src: b"import lib.answer\nfn main() -> Int = answer::answer()" }];
  let pkgs = with_lib(user);
  let supplied = [
    {
      root: b"lib",
      manifest: at(pkgs.supplied, 0).manifest,
      modules: [
        { name: b"answer", src: b"import extra\npub fn answer() -> Int = extra::hidden()" },
        { name: b"extra", src: b"fn hidden() -> Int = 1" },
      ],
    },
  ];
  let clo = closure({ ..pkgs, supplied: supplied }, map(user, |source: Source| source.name));
  assert_eq(clo.diags, []);
  assert_eq(map(clo.modules, |m: { pkg: Int, src: Source }| m.src.name), [
    b"lib.answer",
    b"lib.extra",
  ])
}

test "a rehash resolves a dependency's own modules with the program's packages" {
  // The root's module, and the dependency's own module importing a sibling of its prefix.
  let lib = [
    { name: b"answer", src: b"import extra\npub fn answer() -> Int = extra::hidden()" },
    { name: b"extra", src: b"pub fn hidden() -> Int = 1" },
  ];
  let declared = {
    ..with_lib([]),
    supplied: [{ root: b"lib", manifest: at(with_lib([]).supplied, 0).manifest, modules: lib }],
  };
  let user = [{ name: b"m", src: b"import lib.answer\nfn main() -> Int = answer::answer()" }];
  match analyse_pulling_std_with(user, [], [], [], declared).out {
    Refused(ds) -> assert_eq(map(ds, |diag: Diag| diag.code), []),
    Analysed(w) -> {
      // What a rehash is given: the modules the front end read, in its own order, named as it
      // named them. Only the tables make `lib.answer`'s bare `extra` resolve.
      let sources = concat(
        user,
        map(lib, |source: Source| { name: bytes_concat(b"lib.", source.name), src: source.src }),
      );
      let r = rehash(sources, [], w.packages, w.module_packages, len(w.packages));
      assert(len(r.nodes) > 0);
      // Each node's hashes are whole digests, which is how the bisector reads them.
      assert_eq(
        filter(r.nodes, |n: Rehash| bytes_len(n.fresh) != 32 || bytes_len(n.table) != 32),
        [],
      )
    },
  }
}

test "a missing dependency manifest is unusable where it is declared" {
  let user = [{ name: b"m", src: b"fn main() -> Int = 1" }];
  let pkgs = with_lib(user);
  let clo = closure(
    { ..pkgs, supplied: [{ root: b"lib", manifest: None, modules: [] }] },
    map(user, |source: Source| source.name),
  );
  assert_eq(at(clo.diags, 0).diag.code, b"E0135")
}

test "a cycle of packages is refused, naming the cycle" {
  let user = [{ name: b"m", src: b"fn main() -> Int = 1" }];
  let manifest_dep = b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"n\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [{name: \"other\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Path(\"../other\")}], entry: None}";
  let clo = closure(
    {
      root: b"a",
      manifest: Some(manifest_dep),
      supplied: [
        { root: b"other", manifest: Some(manifest_dep), modules: [] },
        { root: b"other/other", manifest: Some(manifest_dep), modules: [] },
      ],
    },
    [],
  );
  assert(has_diag(clo.diags, b"E0134"))
}

fn has_diag(diags: List<{ slot: Int, diag: ParseDiag }>, code: Bytes) -> Bool =
  fold(diags, false, |acc: Bool, sd: { slot: Int, diag: ParseDiag }| acc || sd.diag.code == code)

// --- Embeds: tests ---------------------------------------------------------------

type Read = { want: EmbedWant, read: EmbedRead }

fn embedding_in(
  pkgs: PackageSources,
  user: List<Source>,
  reads: List<Read>,
) -> AnalysisOutcome / {abort.raise} =
  analyse_pulling_std_with(
    user,
    [],
    [],
    [],
    pkgs,
    no_interfaces(),
    map(reads, |r: Read| { root: pkgs.root, module: b"m", want: r.want, read: r.read }),
  ).out

fn embedding(src: Bytes, reads: List<Read>) -> AnalysisOutcome / {abort.raise} =
  embedding_in({ root: b"r", manifest: None, supplied: [] }, [{ name: b"m", src: src }], reads)

fn a_file(bytes: Bytes) -> Read =
  { want: { path: b"d.txt", dir: false }, read: Ok([{ name: b"", bytes: bytes }]) }

fn checked_analysis(outcome: AnalysisOutcome) -> Analysis / {abort.raise} =
  match outcome {
    Refused(ds) ->
      panic(
        string_of_bytes_lossy(
          join(map(ds, |diag: Diag| bytes_concat_all([diag.code, b": ", diag.message])), b"; "),
        ),
      ),
    Analysed(w) -> w,
  }

fn def_hash_in(outcome: AnalysisOutcome, name: Bytes) -> Bytes / {abort.raise} =
  match filter(checked_analysis(outcome).hashes.defs, |d: { name: Bytes, hash: Bytes }|
      d.name == name) {
    [d, ..] -> d.hash,
    [] -> panic("no such definition"),
  }

fn refused_codes(outcome: AnalysisOutcome) -> List<Bytes> =
  match outcome { Refused(ds) -> map(ds, |diag: Diag| diag.code), Analysed(_) -> [] }

test "only a module that may call `embed` is parsed for what it embeds" {
  assert(names_embed(b"embed(\"x\")"));
  assert(names_embed(b"fn f() -> Bytes = embed_dir (\"x\")"));
  assert(names_embed(b"fn f() -> Bytes = embed\n  // why\n  (\"x\")"));
  assert(!names_embed(b"fn embeds() -> Int = 1"));
  assert(!names_embed(b"import embed (EmbedAt, wants_of)\n"));
  assert(!names_embed(b"let embedded = an_embed(1)"));
  assert(!names_embed(b"// what the embed reads"));
  assert(!names_embed(b"x embed"))
}

test "an embed is the bytes read for it, and other bytes are another definition" {
  let src = b"fn data() -> Bytes = embed(\"d.txt\")\nfn other() -> Int = 1\n";
  let one = embedding(src, [a_file(b"one")]);
  let two = embedding(src, [a_file(b"two")]);
  assert(def_hash_in(one, b"m.data") != def_hash_in(two, b"m.data"));
  assert_eq(def_hash_in(one, b"m.other"), def_hash_in(two, b"m.other"));
  assert_eq(
    def_hash_in(one, b"m.data"),
    def_hash_in(
      embedding(b"fn data() -> Bytes = b\"one\"\nfn other() -> Int = 1\n", []),
      b"m.data",
    ),
  )
}

test "a directory embed is its files as records, by their paths below it" {
  let src = b"fn tree() -> List<{ name: String, bytes: Bytes }> = embed_dir(\"t\")\n";
  let w = checked_analysis(
    embedding(src, [
      {
        want: { path: b"t", dir: true },
        read: Ok([{ name: b"a", bytes: b"1" }, { name: b"b/c", bytes: b"2" }]),
      },
    ]),
  );
  assert_eq(map(w.embeds, |embed: EmbedAt| embed.key), [b"dir:t"])
}

test "an embed's path is a literal, and an embed nothing could be read for is refused" {
  assert_eq(
    refused_codes(
      embedding(b"fn p() -> String = \"d.txt\"\nfn data() -> Bytes = embed(p())\n", []),
    ),
    [b"E0147"],
  );
  assert_eq(
    refused_codes(
      embedding(b"fn data() -> Bytes = embed(\"d.txt\")\n", [
        { want: { path: b"d.txt", dir: false }, read: Err(b"`d.txt` does not exist") },
      ]),
    ),
    [b"E0146"],
  );
  assert_eq(refused_codes(embedding(b"fn data() -> Bytes = embed(\"d.txt\")\n", [])), [b"E0146"])
}

test "a module that binds `embed` itself calls its own" {
  let w = checked_analysis(
    embedding(
      b"fn embed(p: String) -> Bytes = b\"mine\"\nfn data() -> Bytes = embed(\"d.txt\")\n",
      [],
    ),
  );
  assert_eq(w.embeds, [])
}

test "a rehash writes the embeds the answer carries" {
  let sources = [{ name: b"m", src: b"fn data() -> Bytes = embed(\"d.txt\")\n" }];
  let w = checked_analysis(
    embedding_in({ root: b"r", manifest: None, supplied: [] }, sources, [a_file(b"one")]),
  );
  assert(
    len(rehash(sources, [], w.packages, w.module_packages, len(w.packages), w.embeds).nodes) > 0,
  )
}

test "the pins read off the closure are the pins an analysis answers, embeds included" {
  let user = [{ name: b"main", src: b"import lib.answer\nfn main() -> Int = answer::answer()" }];
  let pkgs = with_lib(user);
  let lib = at(pkgs.supplied, 0);
  let embedding = {
    ..pkgs,
    supplied: [
      {
        ..lib,
        modules: [
          { name: b"answer", src: b"pub fn answer() -> Int = bytes_len(embed(\"n.txt\"))" },
        ],
      },
    ],
  };
  let reads = [
    {
      root: b"lib",
      module: b"answer",
      want: { path: b"n.txt", dir: false },
      read: Ok([{ name: b"", bytes: b"one" }]),
    },
  ];
  let analysed = checked_analysis(
    analyse_pulling_std_with(user, [], [], [], embedding, no_interfaces(), reads).out,
  ).pins;
  assert_eq(len(analysed), 1);
  assert_eq(pins_pulling(user, embedding, reads), Ok(analysed))
}

test "a dependency is pinned by what its modules embed as well as by their text" {
  let user = [{ name: b"main", src: b"import lib.answer\nfn main() -> Int = answer::answer()" }];
  let pkgs = with_lib(user);
  let embedding_lib = |read: Option<Bytes>| {
    let lib = at(pkgs.supplied, 0);
    let src = match read {
      Some(_) -> b"pub fn answer() -> Int = bytes_len(embed(\"n.txt\"))",
      None -> b"pub fn answer() -> Int = 42",
    };
    let changed = { ..pkgs, supplied: [{ ..lib, modules: [{ name: b"answer", src: src }] }] };
    let reads = match read {
      Some(b) ->
        [
          {
            root: b"lib",
            module: b"answer",
            want: { path: b"n.txt", dir: false },
            read: Ok([{ name: b"", bytes: b }]),
          },
        ],
      None -> [],
    };
    map(
      checked_analysis(
        analyse_pulling_std_with(user, [], [], [], changed, no_interfaces(), reads).out,
      ).pins,
      |pin: Pinned| pin.digest,
    )
  };
  assert(embedding_lib(Some(b"one")) != embedding_lib(Some(b"two")))
}

test "what sits beside a shipped module, or beside its package, is filed under the package's root" {
  assert_eq(shipped_name(b"compiler.infer", b"../prelude.ply"), Some(b"compiler.prelude"));
  assert_eq(shipped_name(b"std.a", b"b.ply"), Some(b"std.b"));
  assert_eq(shipped_name(b"std.a", b"./deep/b.ply"), Some(b"std.deep.b"));
  assert_eq(shipped_name(b"std.deep.a", b"../b.ply"), Some(b"std.b"));
  assert_eq(shipped_name(b"std.a", b"../../b.ply"), Some(b"std.b"));
  assert_eq(shipped_name(b"std.a", b".."), None);
  assert_eq(shipped_name(b"std.a", b"notes.txt"), None)
}

test "a shipped module embeds what the shipped modules hold beside it, and other bytes are another definition" {
  let user = [{ name: b"m", src: b"import std.a\npub fn f() -> Bytes = a::text()" }];
  let embedding = { name: b"std.a", src: b"pub fn text() -> Bytes = embed(\"../note.ply\")" };
  let over = |note: Bytes|
    answer_pulling_std_with(user, [embedding, { name: b"std.note", src: note }], [], []);
  let one = over(b"one");
  assert_eq(one.dump.diags, []);
  assert_eq(one.pulled, [b"std.a"]);
  assert_eq(one.dump.embeds, [
    { module: b"std.a", key: b"file:../note.ply", read: Ok([{ name: b"", bytes: b"one" }]) },
  ]);
  assert(one.dump.hashes_digest != over(b"two").dump.hashes_digest)
}

test "a shipped module read as its stub still answers what the shipped modules' text of it embeds" {
  let whole = fold(
    [
      { name: b"std.a", src: b"pub fn text() -> Bytes = embed(\"note.ply\")" },
      { name: b"std.note", src: b"one" },
    ],
    map_new(),
    |acc: Map<Bytes, Bytes>, s: Source| map_insert(acc, s.name, s.src),
  );
  let stub = shipped_embedded(whole, 0, { name: b"std.a", src: b"pub fn text() -> Bytes = b\"\"" });
  assert_eq(stub.embeds, [
    { module: b"std.a", key: b"file:note.ply", read: Ok([{ name: b"", bytes: b"one" }]) },
  ])
}

test "a shipped module that embeds what the shipped modules do not hold is refused" {
  let a = answer_pulling_std_with(
    [{ name: b"m", src: b"import std.a\npub fn f() -> Bytes = a::text()" }],
    [{ name: b"std.a", src: b"pub fn text() -> Bytes = embed(\"gone.ply\")" }],
    [],
    [],
  );
  assert_eq(map(a.dump.diags, |d: Diag| d.code), [b"E0146"])
}
