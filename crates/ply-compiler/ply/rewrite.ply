// The rewrites over a parsed module: the try operator and the cost law, run with the grammar, and the
// record update, which needs the checker's answer for its base and so runs after the check.

import std.bin
import std.list (at, concat, drop, take)
import parsing (Span, Ident, QName, ParseDiag, Label, span_to, dummy_span, bare, span_key, error_at,
                error_at_and, parse_diag, parse_label, dump_diags, is_bare)
import type_syntax (TypeExpr, TVar, TCon, TFn, TRecord, TUnit, TBad, RowExpr, AtomExpr, Mode, MRead,
                    MWrite, MBad)
import items (Module, Item, IFn, IType, IEffect, ITest, ILaw, IDerive, IEffectSet, FnDef, TypeDef,
              TypeDefBody, TDAlias, TDSum, VariantDef, SpecClause, SRequires, SEnsures, SCost,
              EffectSetDef, ImportDecl, ImportKind, INames, Binder, OpDef, EffectDef, TestDef,
              LawDef, parse, dump_module)
import exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock, ERecord,
              ERecordUpdate, ETry, EField, EList, EPerform, EHandle, EWithCell, ESimulate,
              EParallel, EBad, Stmt, SLet, SLetElse, SExpr, Param, NamedArg, MatchArm, HandleClause,
              ReturnClause, RecField, expr_span)
import patterns (Pattern, PWild, PVar, PLit, PCtor, PRecord, PList, PBad, Lit, LUnit, LInt, LStr,
                 LBool)
import std.bytes (ascii_of_int)

// --- Shared ---------------------------------------------------------------------

fn max_alias_depth() -> Int = 16

// This module's own `type` items; the first declaration of a name wins.
fn collect_types(module: Module) -> List<TypeDef> =
  fold(module.items, [], |acc: List<TypeDef>, item: Item|
    match item {
      IType(d) -> match find_type(acc, d.name.name) { Some(_) -> acc, None -> push(acc, d) },
      _ -> acc,
    })

pub fn find_type(ts: List<TypeDef>, name: Bytes) -> Option<TypeDef> =
  fold(ts, None, |acc: Option<TypeDef>, type_def: TypeDef|
    match acc {
      Some(_) -> acc,
      None -> if type_def.name.name == name { Some(type_def) } else { None },
    })

// Evaluates without calling or performing anything.
pub fn is_pure(e: Expr) -> Bool =
  match e {
    EApp(_) -> false,
    EPerform(_) -> false,
    EHandle(_) -> false,
    EWithCell(_) -> false,
    ESimulate(_) -> false,
    EParallel(v) -> fold(v.branches, true, |acc: Bool, x: Expr| acc && is_pure(x)),
    ETry(_) -> false,
    ELit(_) -> true,
    EVar(_) -> true,
    EBad(_) -> true,
    EBinary(b) -> is_pure(b.lhs) && is_pure(b.rhs),
    EUnary(u) -> is_pure(u.operand),
    ELambda(l) -> is_pure(l.body),
    EIf(i) -> is_pure(i.cond) && is_pure(i.then_branch) && is_pure(i.else_branch),
    EMatch(m) ->
      is_pure(m.scrutinee)
        && fold(m.arms, true, |acc: Bool, arm: MatchArm|
          acc && is_pure(arm.body) && (match arm.guard { None -> true, Some(g) -> is_pure(g) })),
    EBlock(b) ->
      fold(b.stmts, true, |acc: Bool, stmt: Stmt|
          acc
            && (match stmt {
              SLet(l) -> is_pure(l.value),
              SLetElse(l) -> is_pure(l.value) && is_pure(l.fallback),
              SExpr(x) -> is_pure(x),
            }))
        && (match b.tail { None -> true, Some(t) -> is_pure(t) }),
    ERecord(r) -> fold(r.fields, true, |acc: Bool, f: RecField| acc && is_pure(f.value)),
    ERecordUpdate(r) ->
      is_pure(r.base) && fold(r.fields, true, |acc: Bool, f: RecField| acc && is_pure(f.value)),
    EField(f) -> is_pure(f.base),
    EList(l) -> fold(l.items, true, |acc: Bool, x: Expr| acc && is_pure(x)),
  }

// --- Record update -----------------------------------------------------------------------
// `{..b, f: e}` is the literal it stands for. The shape it copies is the checker's answer for the
// base, keyed by the update's span, so this runs after the check and not with the other rewrites.

fn too_deep() -> Bytes =
  bytes_concat_all([b"more than ", ascii_of_int(max_alias_depth()), b" type aliases deep"])

// The literal an update stands for: the base's other fields, in the record's own order, then the
// written ones. A call is bound to a name first, so it runs once however many fields are copied.
fn expand_update(span: Span, base: Expr, written: List<RecField>, names: List<Bytes>) -> Expr = {
  let base_span = expr_span(base);
  let bound: Option<Ident> = match base {
    EApp(_) -> Some({ name: bytes_concat(b"?u", ascii_of_int(base_span.start)), span: base_span }),
    _ -> None,
  };
  let source = match bound { Some(b) -> EVar({ span: base_span, name: bare(b) }), None -> base };
  let copies = filter(names, |n: Bytes|
    !fold(written, false, |seen: Bool, w: RecField| seen || w.name.name == n));
  let copied = map(copies, |n: Bytes| {
    let field = { name: n, span: base_span };
    { name: field, value: EField({ span: base_span, base: source, field: field }) }
  });
  let literal = ERecord({ span: span, fields: concat(copied, written) });
  match bound {
    Some(b) ->
      EBlock({
        span: span,
        tail: Some(literal),
        stmts: [
          SLet({ span: base_span, pat: PVar({ span: base_span, name: b }), ty: None, value: base }),
        ],
      }),
    None -> literal,
  }
}

// Children first, then the node through `f`: a nested update inside a written field expands
// before its owner, and what `f` builds is not visited again.
pub fn map_expr(e: Expr, f: (Expr) -> Expr) -> Expr = {
  let go = |x: Expr| map_expr(x, f);
  let opt = |x: Option<Expr>| match x { None -> None, Some(y) -> Some(map_expr(y, f)) };
  let fields = |fs: List<RecField>| map(fs, |fl: RecField| { name: fl.name, value: go(fl.value) });
  f(match e {
    EBinary(b) -> EBinary({ span: b.span, op: b.op, lhs: go(b.lhs), rhs: go(b.rhs) }),
    EUnary(u) -> EUnary({ span: u.span, op: u.op, operand: go(u.operand) }),
    ELambda(l) -> ELambda({ span: l.span, body: go(l.body), params: l.params, ret: l.ret }),
    EApp(a) ->
      EApp({
        span: a.span,
        func: go(a.func),
        named: map(a.named, |arg: NamedArg|
          { name: arg.name, value: go(arg.value), span: arg.span }),
        args: map(a.args, go),
        labels: a.labels,
      }),
    EIf(i) ->
      EIf({
        span: i.span,
        cond: go(i.cond),
        then_branch: go(i.then_branch),
        else_branch: go(i.else_branch),
      }),
    EMatch(m) ->
      EMatch({
        span: m.span,
        scrutinee: go(m.scrutinee),
        arms: map(m.arms, |arm: MatchArm|
          { pat: arm.pat, guard: opt(arm.guard), body: go(arm.body), span: arm.span }),
      }),
    EBlock(b) ->
      EBlock({
        span: b.span,
        tail: opt(b.tail),
        stmts: map(b.stmts, |stmt: Stmt|
          match stmt {
            SLet(l) -> SLet({ span: l.span, pat: l.pat, ty: l.ty, value: go(l.value) }),
            SLetElse(l) ->
              SLetElse({
                span: l.span,
                pat: l.pat,
                ty: l.ty,
                value: go(l.value),
                fallback: go(l.fallback),
              }),
            SExpr(x) -> SExpr(go(x)),
          }),
      }),
    ERecord(r) -> ERecord({ span: r.span, fields: fields(r.fields) }),
    ERecordUpdate(r) -> ERecordUpdate({ span: r.span, base: go(r.base), fields: fields(r.fields) }),
    EField(fl) -> EField({ span: fl.span, base: go(fl.base), field: fl.field }),
    ETry(t) -> ETry({ span: t.span, operand: go(t.operand) }),
    EList(l) -> EList({ span: l.span, items: map(l.items, go) }),
    EPerform(x) ->
      EPerform({ span: x.span, eff: x.eff, op: x.op, resource: x.resource, args: map(x.args, go) }),
    EHandle(h) ->
      EHandle({
        span: h.span,
        body: go(h.body),
        ret: match h.ret {
          None -> None,
          Some(rc) -> Some({ binder: rc.binder, body: go(rc.body), span: rc.span }),
        },
        clauses: map(h.clauses, |c: HandleClause|
          {
            eff: c.eff,
            op: c.op,
            resource: c.resource,
            every_label: c.every_label,
            label_binder: c.label_binder,
            resume: c.resume,
            body: go(c.body),
            span: c.span,
            params: c.params,
          }),
      }),
    EWithCell(c) ->
      EWithCell({
        span: c.span,
        resource: c.resource,
        init: go(c.init),
        binder: c.binder,
        body: go(c.body),
      }),
    ESimulate(x) -> ESimulate({ span: x.span, body: go(x.body) }),
    EParallel(x) -> EParallel({ span: x.span, branches: map(x.branches, go) }),
    _ -> e,
  })
}

// Every expression an item holds, through `map_expr`.
fn map_item(item: Item, f: (Expr) -> Expr) -> Item = {
  let go = |x: Expr| map_expr(x, f);
  match item {
    IFn(d) ->
      IFn({
        ..d,
        params: map(d.params, |param: Param|
          { ..param, default: match param.default { None -> None, Some(x) -> Some(go(x)) } }),
        spec: map(d.spec, |clause: SpecClause|
          { kind: clause.kind, expr: go(clause.expr), span: clause.span }),
        body: go(d.body),
      }),
    ITest(d) -> ITest({ ..d, body: go(d.body) }),
    ILaw(d) ->
      ILaw({
        ..d,
        guard: match d.guard { None -> None, Some(g) -> Some(go(g)) },
        body: go(d.body),
      }),
    _ -> item,
  }
}

// A span the table does not hold belongs to a program that did not check; the lowering declines it.
fn expanded_update(sh: Map<Bytes, List<Bytes>>, expr: Expr) -> Expr =
  match expr {
    ERecordUpdate(r) -> match map_get(sh, span_key(r.span)) {
      None -> expr,
      Some(names) -> expand_update(r.span, r.base, r.fields, names),
    },
    _ -> expr,
  }

// Every update of a checked module replaced by the literal it stands for.
pub fn expand_record_updates(module: Module, shapes: Map<Bytes, List<Bytes>>) -> Module =
  if !has_update(module) { module } else {
    {
      imports: module.imports,
      items: map(module.items, |item: Item|
        map_item(item, |expr: Expr| expanded_update(shapes, expr))),
    }
  }

// --- Witnesses -----------------------------------------------------------------------------
// A definition with `numeric(a)` or `integer(a)` takes, ahead of its written parameters, an `Int`
// per such parameter naming the type a call instantiates it at, in the order the checker gives.
// Its operators over the parameter read that witness, and every call of it passes one: a type's
// number, or the caller's own.

pub type NumericWitness = | ConcreteWitness(Bytes) | ParamWitness(Bytes)

derive bin for NumericWitness

// No source can spell it, so it never collides with a binder the program wrote.
pub fn witness_param(param: Bytes) -> Bytes = bytes_concat(b"?w_", param)

// The runtime's numbering: its ten widths in order, then `Int`, `Float` and `Decimal`.
pub fn witness_code(name: Bytes) -> Int =
  match fold(range(0, 13), None, |acc: Option<Int>, i: Int|
      match acc {
        Some(_) -> acc,
        None -> match list_at(
            [
              b"U8",
              b"U16",
              b"U32",
              b"U64",
              b"I8",
              b"I16",
              b"I32",
              b"I64",
              b"U128",
              b"I128",
              b"Int",
              b"Float",
              b"Decimal",
            ],
            i,
          ) {
          Some(n) -> if n == name { Some(i) } else { None },
          None -> None,
        },
      }) {
    Some(i) -> i,
    None -> 10,
  }

fn witness_expr(w: NumericWitness, span: Span) -> Expr =
  match w {
    ConcreteWitness(n) -> ELit({ span: span, lit: LInt(witness_code(n)) }),
    ParamWitness(p) -> EVar({ span: span, name: bare({ name: witness_param(p), span: span }) }),
  }

// The runtime's numbering of the operators a witnessed parameter takes; `-` and `~` are 0 and 1.
fn numeric_op_code(op: Bytes) -> Int =
  match fold(range(0, 15), None, |acc: Option<Int>, i: Int|
      match acc {
        Some(_) -> acc,
        None -> match list_at(
            [
              b"add",
              b"sub",
              b"mul",
              b"div",
              b"rem",
              b"lt",
              b"le",
              b"gt",
              b"ge",
              b"bitand",
              b"bitor",
              b"bitxor",
              b"shl",
              b"shr",
              b"ushr",
            ],
            i,
          ) {
          Some(n) -> if n == op { Some(i) } else { None },
          None -> None,
        },
      }) {
    Some(i) -> i,
    None -> 0 - 1,
  }

fn hidden_call(span: Span, name: Bytes, args: List<Expr>) -> Expr =
  EApp({
    span: span,
    func: EVar({ span: span, name: bare({ name: name, span: span }) }),
    named: [],
    args: args,
    labels: [],
  })

fn witnessed(ops: Map<Bytes, Bytes>, refs: Map<Bytes, List<NumericWitness>>, e: Expr) -> Expr =
  match e {
    EBinary(b) -> match map_get(ops, span_key(b.span)) {
      Some(p) -> if b.op == b"eq" || b.op == b"ne" { e } else {
        hidden_call(b.span, b"?numeric_binary", [
          ELit({ span: b.span, lit: LInt(numeric_op_code(b.op)) }),
          witness_expr(ParamWitness(p), b.span),
          b.lhs,
          b.rhs,
        ])
      },
      None -> e,
    },
    EUnary(u) -> match map_get(ops, span_key(u.span)) {
      Some(p) ->
        hidden_call(u.span, b"?numeric_unary", [
          ELit({ span: u.span, lit: LInt(if u.op == b"bitnot" { 1 } else { 0 }) }),
          witness_expr(ParamWitness(p), u.span),
          u.operand,
        ]),
      None -> e,
    },
    EApp(a) -> match a.func {
      EVar(v) -> match map_get(refs, span_key(v.span)) {
        Some(ws) ->
          EApp({
            ..a,
            args: fold(
              a.args,
              map(ws, |w: NumericWitness| witness_expr(w, v.span)),
              |acc: List<Expr>, x: Expr| push(acc, x),
            ),
          }),
        None -> e,
      },
      _ -> e,
    },
    _ -> e,
  }

fn witness_params(orders: Map<Bytes, List<Bytes>>, item: Item) -> Item =
  match item {
    IFn(d) -> match map_get(orders, d.name.name) {
      None -> item,
      Some(ws) ->
        IFn({
          ..d,
          params: fold(
            d.params,
            map(ws, |w: Bytes|
              {
                name: { name: witness_param(w), span: d.name.span },
                ty: Some(
                  TCon({
                    name: bare({ name: b"Int", span: d.name.span }),
                    args: [],
                    span: d.name.span,
                  }),
                ),
                cost: None,
                default: None,
                span: d.name.span,
              }),
            |acc: List<Param>, param: Param| push(acc, param),
          ),
        }),
    },
    _ -> item,
  }

// `orders` holds each witnessed definition's parameters by simple name, as the checker ordered them.
pub fn expand_witnesses(
  module: Module,
  ops: Map<Bytes, Bytes>,
  refs: Map<Bytes, List<NumericWitness>>,
  orders: Map<Bytes, List<Bytes>>,
) -> Module =
  if map_len(ops) == 0 && map_len(refs) == 0 && map_len(orders) == 0 { module } else {
    {
      imports: module.imports,
      items: map(module.items, |item: Item|
        witness_params(orders, map_item(item, |expr: Expr| witnessed(ops, refs, expr)))),
    }
  }

// --- The try operator ------------------------------------------------------------------------

type TryMode = | TryResult | TryOption

// `shadowed` is the note for a module whose own `Ok`/`Err`/`Some`/`None` would capture the expansion.
type TryState = {
  types: List<TypeDef>,
  shadowed: Option<Bytes>,
  diags: List<ParseDiag>,
  mode: Option<TryMode>,
  fresh: Int,
}

type Lift = { operand: Expr, binder: Ident, at: Span }
type Scan = | ScanFound(Lift) | ScanPure | ScanImpure
type Scanned = { state: TryState, scan: Scan, expr: Expr }
type TryOut = { state: TryState, expr: Expr }

fn is_expansion_name(name: Bytes) -> Bool =
  name == b"Ok" || name == b"Err" || name == b"Some" || name == b"None"

fn shadowing_ctor(module: Module) -> Option<Bytes> = {
  let imported = fold(module.imports, None, |acc: Option<Bytes>, d: ImportDecl|
    match acc {
      Some(_) -> acc,
      None -> match d.kind {
        INames(ns) ->
          fold(ns, None, |b: Option<Bytes>, ident: Ident|
            match b {
              Some(_) -> b,
              None -> if is_expansion_name(ident.name) {
                Some(
                  bytes_concat_all([
                    b"this module imports `",
                    ident.name,
                    b"` unqualified, which would capture the `match` `?` expands to; import the module instead and qualify the name, or write the `match` out",
                  ]),
                )
              } else { None },
            }),
        _ -> None,
      },
    });
  match imported {
    Some(_) -> imported,
    None ->
      fold(module.items, None, |acc: Option<Bytes>, item: Item|
        match acc {
          Some(_) -> acc,
          None -> match item {
            IType(d) -> match d.body {
              TDSum(vs) ->
                fold(vs, None, |b: Option<Bytes>, variant: VariantDef|
                  match b {
                    Some(_) -> b,
                    None -> if is_expansion_name(variant.name.name) {
                      Some(
                        bytes_concat_all([
                          b"this module declares its own `",
                          variant.name.name,
                          b"`, which would capture the `match` `?` expands to; rename it, or write the `match` out",
                        ]),
                      )
                    } else { None },
                  }),
              _ -> None,
            },
            _ -> None,
          },
        }),
  }
}

fn unreadable() -> Bytes =
  b"the return type has no head constructor this file can read: a type parameter and a generic alias have none until they are applied"

fn not_result_or_option(head: Bytes) -> Bytes =
  bytes_concat_all([
    b"this function returns `",
    head,
    b"`; `?` binds a `Result` inside a function returning `Result`, or an `Option` inside one returning `Option`, because those are the constructors it expands to",
  ])

fn no_return_type() -> Bytes =
  b"this function writes no `->`, and `?` reads which constructors to name off the written return type; write one"

fn not_in_a_function(what: Bytes) -> Bytes =
  bytes_concat(what, b" has no written return type, and `?` needs one")

fn mode_of(state: TryState, ty: TypeExpr, depth: Int) -> Result<TryMode, Bytes> =
  if depth > max_alias_depth() { Err(too_deep()) } else {
    match ty {
      TCon(c) -> if !is_bare(c.name) {
        Err(
          b"the return type is named through another module, and `?` reads only this file \xe2\x80\x94 a meaning read across a module boundary would go stale in a file that never changed",
        )
      } else if c.name.name.name == b"Result" { Ok(TryResult) }
      else if c.name.name.name == b"Option" { Ok(TryOption) } else {
        let n = c.name.name.name;
        match find_type(state.types, n) {
          None -> Err(not_result_or_option(n)),
          Some(d) -> if len(d.params) > 0 { Err(unreadable()) } else {
            match d.body {
              TDSum(_) -> Err(not_result_or_option(n)),
              TDAlias(inner) -> mode_of(state, inner, depth + 1),
            }
          },
        }
      },
      _ -> Err(unreadable()),
    }
  }

fn mode_for(state: TryState, ret: Option<TypeExpr>) -> Result<TryMode, Bytes> =
  match state.shadowed {
    Some(why) -> Err(why),
    None -> match ret { None -> Err(no_return_type()), Some(ty) -> mode_of(state, ty, 0) },
  }

// The outermost barrier is the one named.
fn under(barrier: Option<Bytes>, what: Bytes) -> Option<Bytes> =
  match barrier { Some(_) -> barrier, None -> Some(what) }

fn fresh_binder(state: TryState, span: Span) -> { state: TryState, binder: Ident } =
  {
    state: { ..state, fresh: state.fresh + 1 },
    binder: { name: bytes_concat(b"?", bytes_of_string(int_to_string(state.fresh))), span: span },
  }

fn var_of(name: Ident) -> Expr = EVar({ span: name.span, name: bare(name) })

fn var_pattern(name: Ident) -> Pattern = PVar({ span: name.span, name: name })

fn ctor_pattern(name: Bytes, args: List<Pattern>, span: Span) -> Pattern =
  PCtor({ span: span, name: bare({ name: name, span: span }), args: args })

// `match operand { <failure>, <success>(pat) -> body }`, failure arm first.
fn wrap(
  state: TryState,
  operand: Expr,
  span: Span,
  pat: Pattern,
  body: Expr,
) -> TryOut / {abort.raise} = {
  let mode = match state.mode {
    Some(m) -> m,
    None -> panic("a mode is established before any lift"),
  };
  match mode {
    TryResult -> {
      let fresh = fresh_binder(state, span);
      let fail_pat = ctor_pattern(b"Err", [var_pattern(fresh.binder)], span);
      let fail_body = EApp({
        span: span,
        func: var_of({ name: b"Err", span: span }),
        args: [var_of(fresh.binder)],
        named: [],
        labels: [],
      });
      {
        state: fresh.state,
        expr: EMatch({
          span: span,
          scrutinee: operand,
          arms: [
            { pat: fail_pat, guard: None, body: fail_body, span: span },
            { pat: ctor_pattern(b"Ok", [pat], span), guard: None, body: body, span: span },
          ],
        }),
      }
    },
    TryOption -> {
      let fail_pat = ctor_pattern(b"None", [], span);
      let fail_body = var_of({ name: b"None", span: span });
      {
        state: state,
        expr: EMatch({
          span: span,
          scrutinee: operand,
          arms: [
            { pat: fail_pat, guard: None, body: fail_body, span: span },
            { pat: ctor_pattern(b"Some", [pat], span), guard: None, body: body, span: span },
          ],
        }),
      }
    },
  }
}

fn purity(pure: Bool) -> Scan = if pure { ScanPure } else { ScanImpure }

type Sequenced = { state: TryState, scan: Scan, exprs: List<Expr> }

// Sub-expressions left to right, stopping at the first `?` and at the first impure one.
fn sequence(state: TryState, parts: List<Expr>) -> Sequenced / {abort.raise} =
  sequence_on({ state: state, scan: ScanPure, exprs: [] }, parts)

// `sequence` going on from where one over the sub-expressions before `parts` stopped.
fn sequence_on(before: Sequenced, parts: List<Expr>) -> Sequenced / {abort.raise} =
  fold(parts, before, |acc: Sequenced, expr: Expr|
    match acc.scan {
      ScanPure -> {
        let o = scan(acc.state, expr);
        { state: o.state, scan: o.scan, exprs: push(acc.exprs, o.expr) }
      },
      _ -> { ..acc, exprs: push(acc.exprs, expr) },
    })

// Lifts the first `?` reachable in evaluation order, leaving its binder in its place.
fn scan(state: TryState, expr: Expr) -> Scanned / {abort.raise} =
  match expr {
    ELit(_) -> { state: state, scan: ScanPure, expr: expr },
    EVar(_) -> { state: state, scan: ScanPure, expr: expr },
    EBad(_) -> { state: state, scan: ScanPure, expr: expr },
    ETry(t) -> {
      let inner = scan(state, t.operand);
      match inner.scan {
        ScanFound(_) ->
          {
            state: inner.state,
            scan: inner.scan,
            expr: ETry({ span: t.span, operand: inner.expr }),
          },
        _ -> {
          let fresh = fresh_binder(inner.state, t.span);
          {
            state: fresh.state,
            scan: ScanFound({ operand: inner.expr, binder: fresh.binder, at: t.span }),
            expr: var_of(fresh.binder),
          }
        },
      }
    },
    EBinary(b) -> {
      let short = b.op == b"and" || b.op == b"or";
      let l = scan(state, b.lhs);
      match l.scan {
        ScanFound(_) ->
          {
            state: l.state,
            scan: l.scan,
            expr: EBinary({ span: b.span, op: b.op, lhs: l.expr, rhs: b.rhs }),
          },
        ScanImpure -> { state: l.state, scan: ScanImpure, expr: expr },
        ScanPure -> if short { { state: l.state, scan: purity(is_pure(b.rhs)), expr: expr } } else {
          let r = scan(l.state, b.rhs);
          {
            state: r.state,
            scan: r.scan,
            expr: EBinary({ span: b.span, op: b.op, lhs: l.expr, rhs: r.expr }),
          }
        },
      }
    },
    EUnary(u) -> {
      let o = scan(state, u.operand);
      { state: o.state, scan: o.scan, expr: EUnary({ span: u.span, op: u.op, operand: o.expr }) }
    },
    EApp(a) -> {
      let o = sequence_on(
        sequence_on(sequence(state, [a.func]), a.args),
        map(a.named, |n: NamedArg| n.value),
      );
      let func = at(o.exprs, 0);
      let args = take(drop(o.exprs, 1), len(a.args));
      let nvals = drop(o.exprs, 1 + len(a.args));
      let named = map(range(0, len(a.named)), |i: Int| {
        let n = at(a.named, i);
        { name: n.name, value: at(nvals, i), span: n.span }
      });
      let rebuilt = EApp({ span: a.span, func: func, named: named, args: args, labels: a.labels });
      match o.scan {
        ScanFound(_) -> { state: o.state, scan: o.scan, expr: rebuilt },
        _ -> { state: o.state, scan: ScanImpure, expr: rebuilt },
      }
    },
    EPerform(p) -> {
      let o = sequence(state, p.args);
      let rebuilt = EPerform({
        span: p.span,
        eff: p.eff,
        op: p.op,
        resource: p.resource,
        args: o.exprs,
      });
      match o.scan {
        ScanFound(_) -> { state: o.state, scan: o.scan, expr: rebuilt },
        _ -> { state: o.state, scan: ScanImpure, expr: rebuilt },
      }
    },
    ERecord(r) -> {
      let o = sequence(state, map(r.fields, |f: RecField| f.value));
      {
        state: o.state,
        scan: o.scan,
        expr: ERecord({
          span: r.span,
          fields: map(range(0, len(r.fields)), |i: Int|
            { name: at(r.fields, i).name, value: at(o.exprs, i) }),
        }),
      }
    },
    EList(l) -> {
      let o = sequence(state, l.items);
      { state: o.state, scan: o.scan, expr: EList({ span: l.span, items: o.exprs }) }
    },
    EField(f) -> {
      let o = scan(state, f.base);
      { state: o.state, scan: o.scan, expr: EField({ span: f.span, base: o.expr, field: f.field }) }
    },
    ERecordUpdate(r) -> {
      let o = sequence_on(sequence(state, [r.base]), map(r.fields, |f: RecField| f.value));
      {
        state: o.state,
        scan: o.scan,
        expr: ERecordUpdate({
          span: r.span,
          base: at(o.exprs, 0),
          fields: map(range(0, len(r.fields)), |i: Int|
            { name: at(r.fields, i).name, value: at(o.exprs, i + 1) }),
        }),
      }
    },
    EIf(i) -> {
      let c = scan(state, i.cond);
      let rebuilt = EIf({
        span: i.span,
        cond: c.expr,
        then_branch: i.then_branch,
        else_branch: i.else_branch,
      });
      match c.scan {
        ScanFound(_) -> { state: c.state, scan: c.scan, expr: rebuilt },
        ScanImpure -> { state: c.state, scan: ScanImpure, expr: rebuilt },
        ScanPure ->
          {
            state: c.state,
            scan: purity(is_pure(i.then_branch) && is_pure(i.else_branch)),
            expr: rebuilt,
          },
      }
    },
    EMatch(m) -> {
      let sc = scan(state, m.scrutinee);
      let rebuilt = EMatch({ span: m.span, scrutinee: sc.expr, arms: m.arms });
      match sc.scan {
        ScanFound(_) -> { state: sc.state, scan: sc.scan, expr: rebuilt },
        ScanImpure -> { state: sc.state, scan: ScanImpure, expr: rebuilt },
        ScanPure ->
          {
            state: sc.state,
            scan: purity(
              fold(m.arms, true, |acc: Bool, arm: MatchArm|
                acc && is_pure(arm.body)
                  && (match arm.guard { None -> true, Some(g) -> is_pure(g) })),
            ),
            expr: rebuilt,
          },
      }
    },
    // A nested block is not entered; a lambda, handler, cell, region, `simulate` or `parallel` is a
    // barrier to `?`.
    _ -> { state: state, scan: purity(is_pure(expr)), expr: expr },
  }

// One `match` per `?` lifted from `expr`'s head, with the rewritten `expr` as the success arm's body.
// `room` is how many `?` are left to lift: each lift takes one away and none is copied.
fn region_cond(state: TryState, expr: Expr, room: Int) -> TryOut / {abort.raise} = {
  let found = scan_head(state, expr);
  match found.scan {
    ScanFound(l) -> {
      let w = wrap(found.state, l.operand, l.at, var_pattern(l.binder), found.expr);
      match w.expr {
        EMatch(m) -> {
          let success = at(m.arms, 1);
          let inner = if room <= 0 { panic(lifted_past()) }
          else { region_cond(w.state, success.body, room - 1) };
          {
            state: inner.state,
            expr: EMatch({
              span: m.span,
              scrutinee: m.scrutinee,
              arms: [
                at(m.arms, 0),
                { pat: success.pat, guard: None, body: inner.expr, span: success.span },
              ],
            }),
          }
        },
        _ -> w,
      }
    },
    _ -> { state: found.state, expr: found.expr },
  }
}

fn scan_head(state: TryState, expr: Expr) -> Scanned / {abort.raise} =
  match expr {
    EIf(i) -> {
      let c = scan(state, i.cond);
      {
        state: c.state,
        scan: c.scan,
        expr: EIf({
          span: i.span,
          cond: c.expr,
          then_branch: i.then_branch,
          else_branch: i.else_branch,
        }),
      }
    },
    EMatch(m) -> {
      let sc = scan(state, m.scrutinee);
      {
        state: sc.state,
        scan: sc.scan,
        expr: EMatch({ span: m.span, scrutinee: sc.expr, arms: m.arms }),
      }
    },
    _ -> scan(state, expr),
  }

fn lifted_past() -> String = "a `?` lifted past the ones written"

// An expression in return position, with `room` as in `region_cond`.
fn ret(state: TryState, expr: Expr, room: Int) -> TryOut / {abort.raise} =
  match expr {
    EBlock(_) -> block(state, expr, room),
    EIf(i) -> {
      let t = ret(state, i.then_branch, room);
      let el = ret(t.state, i.else_branch, room);
      region_cond(
        el.state,
        EIf({ span: i.span, cond: i.cond, then_branch: t.expr, else_branch: el.expr }),
        room,
      )
    },
    EMatch(m) -> {
      let arms = fold(
        m.arms,
        { state: state, arms: [] },
        |acc: { state: TryState, arms: List<MatchArm> }, arm: MatchArm| {
          let b = ret(acc.state, arm.body, room);
          {
            state: b.state,
            arms: push(acc.arms, { pat: arm.pat, guard: arm.guard, body: b.expr, span: arm.span }),
          }
        },
      );
      region_cond(
        arms.state,
        EMatch({ span: m.span, scrutinee: m.scrutinee, arms: arms.arms }),
        room,
      )
    },
    _ -> region_cond(state, expr, room),
  }

// A block in return position: split at the first statement a `?` can be lifted from.
fn block(state: TryState, expr: Expr, room: Int) -> TryOut / {abort.raise} =
  match expr {
    EBlock(b) -> {
      let split = fold(
        range(0, len(b.stmts)),
        { state: state, stmts: b.stmts, tail: b.tail, done: false },
        |acc: { state: TryState, stmts: List<Stmt>, tail: Option<Expr>, done: Bool }, i: Int|
          if acc.done { acc } else {
            let o = split_at(acc.state, acc.stmts, acc.tail, i, at(b.stmts, i), room);
            match o.split {
              None -> { state: o.state, stmts: o.stmts, tail: acc.tail, done: false },
              Some(t) -> { state: o.state, stmts: take(o.stmts, i), tail: Some(t), done: true },
            }
          },
      );
      if split.done {
        { state: split.state, expr: EBlock({ span: b.span, tail: split.tail, stmts: split.stmts }) }
      } else {
        match b.tail {
          None ->
            { state: split.state, expr: EBlock({ span: b.span, tail: None, stmts: split.stmts }) },
          Some(t) -> {
            let o = ret(split.state, t, room);
            {
              state: o.state,
              expr: EBlock({ span: b.span, tail: Some(o.expr), stmts: split.stmts }),
            }
          },
        }
      }
    },
    _ -> panic("only called on a block"),
  }

type Taken = {
  state: TryState,
  stmt: Stmt,
  take: Option<{ operand: Expr, at: Span, pat: Pattern, consumes: Bool }>,
}

// `st` is `stmts`' `i`th as written: only the ones before it are rewritten yet.
fn split_at(
  state: TryState,
  stmts: List<Stmt>,
  tail: Option<Expr>,
  i: Int,
  st: Stmt,
  room: Int,
) -> { state: TryState, stmts: List<Stmt>, split: Option<Expr> } / {abort.raise} = {
  let taken = take_stmt(state, st, room);
  match taken.take {
    None -> { state: taken.state, stmts: list_set(stmts, i, taken.stmt), split: None },
    Some(t) -> {
      let kept = list_set(stmts, i, taken.stmt);
      let rest = drop(kept, if t.consumes { i + 1 } else { i });
      // A consumed statement goes: its binder is now the success arm's pattern.
      let body0 = EBlock({ span: t.at, tail: tail, stmts: rest });
      let body = if room <= 0 { panic(lifted_past()) } else { block(taken.state, body0, room - 1) };
      let w = wrap(body.state, t.operand, t.at, t.pat, body.expr);
      { state: w.state, stmts: kept, split: Some(w.expr) }
    },
  }
}

fn take_stmt(state: TryState, stmt: Stmt, room: Int) -> Taken / {abort.raise} =
  match stmt {
    // Never consumed, since its pattern is not the success arm's. Its `else` block is the block's
    // value, so it is a return position: expanded once, when no `?` is left in the initializer.
    SLetElse(l) -> match l.value {
      ETry(t) -> {
        let fresh = fresh_binder(state, t.span);
        let o = take_try(fresh.state, t.operand, t.span, var_pattern(fresh.binder));
        if o.take.consumes {
          {
            state: o.state,
            stmt: SLetElse({ ..l, value: var_of(fresh.binder) }),
            take: Some({
              operand: o.take.operand,
              at: o.take.at,
              pat: o.take.pat,
              consumes: false,
            }),
          }
        } else {
          {
            state: o.state,
            stmt: SLetElse({ ..l, value: ETry({ span: t.span, operand: o.operand_left }) }),
            take: Some(o.take),
          }
        }
      },
      _ -> {
        let o = scan(state, l.value);
        match o.scan {
          ScanFound(lift) ->
            {
              state: o.state,
              stmt: SLetElse({ ..l, value: o.expr }),
              take: Some({
                operand: lift.operand,
                at: lift.at,
                pat: var_pattern(lift.binder),
                consumes: false,
              }),
            },
          _ -> {
            let f = ret(o.state, l.fallback, room);
            { state: f.state, stmt: SLetElse({ ..l, fallback: f.expr }), take: None }
          },
        }
      },
    },
    SLet(l) -> match l.value {
      ETry(t) -> match l.ty {
        // The annotation stays: the `let` now binds the success arm's binder.
        Some(_) -> {
          let fresh = fresh_binder(state, t.span);
          let o = take_try(fresh.state, t.operand, t.span, var_pattern(fresh.binder));
          if o.take.consumes {
            {
              state: o.state,
              stmt: SLet({ span: l.span, pat: l.pat, ty: l.ty, value: var_of(fresh.binder) }),
              take: Some({
                operand: o.take.operand,
                at: o.take.at,
                pat: o.take.pat,
                consumes: false,
              }),
            }
          } else {
            {
              state: o.state,
              stmt: SLet({
                span: l.span,
                pat: l.pat,
                ty: l.ty,
                value: ETry({ span: t.span, operand: o.operand_left }),
              }),
              take: Some(o.take),
            }
          }
        },
        None -> {
          let o = take_try(state, t.operand, t.span, l.pat);
          {
            state: o.state,
            stmt: SLet({
              span: l.span,
              pat: l.pat,
              ty: None,
              value: ETry({ span: t.span, operand: o.operand_left }),
            }),
            take: Some(o.take),
          }
        },
      },
      _ -> {
        let o = scan(state, l.value);
        match o.scan {
          ScanFound(lift) ->
            {
              state: o.state,
              stmt: SLet({ span: l.span, pat: l.pat, ty: l.ty, value: o.expr }),
              take: Some({
                operand: lift.operand,
                at: lift.at,
                pat: var_pattern(lift.binder),
                consumes: false,
              }),
            },
          _ -> { state: o.state, stmt: stmt, take: None },
        }
      },
    },
    SExpr(v) -> match v {
      ETry(t) -> {
        let o = take_try(state, t.operand, t.span, PWild({ span: v_span(v) }));
        {
          state: o.state,
          stmt: SExpr(ETry({ span: t.span, operand: o.operand_left })),
          take: Some(o.take),
        }
      },
      _ -> {
        let o = scan(state, v);
        match o.scan {
          ScanFound(lift) ->
            {
              state: o.state,
              stmt: SExpr(o.expr),
              take: Some({
                operand: lift.operand,
                at: lift.at,
                pat: var_pattern(lift.binder),
                consumes: false,
              }),
            },
          _ -> { state: o.state, stmt: stmt, take: None },
        }
      },
    },
  }

fn v_span(expr: Expr) -> Span = expr_span(expr)

type TryTaken = {
  state: TryState,
  operand_left: Expr,
  take: { operand: Expr, at: Span, pat: Pattern, consumes: Bool },
}

// An inner `?` in the operand is lifted first and the statement stays; otherwise the statement is consumed.
fn take_try(state: TryState, operand: Expr, span: Span, pat: Pattern) -> TryTaken / {abort.raise} = {
  let o = scan(state, operand);
  match o.scan {
    ScanFound(lift) ->
      {
        state: o.state,
        operand_left: o.expr,
        take: {
          operand: lift.operand,
          at: lift.at,
          pat: var_pattern(lift.binder),
          consumes: false,
        },
      },
    _ ->
      {
        state: o.state,
        operand_left: ELit({ span: span, lit: LUnit }),
        take: { operand: o.expr, at: span, pat: pat, consumes: true },
      },
  }
}

// Refuses and unwraps every `?` left in `expr`: `E0118` when `scope` or `barrier` says why, else `E0119`.
fn sweep(
  state: TryState,
  expr: Expr,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
) -> TryOut / {abort.raise} =
  sweep_within(state, expr, scope, barrier, count_in(expr, typed_lambda))

fn typed_lambda(e: Expr) -> Bool = match e { ELambda(l) -> l.ret != None, _ -> false }

// `room` is how many lambdas with a written return type are left to sweep: the body of one is swept
// after `ret` rewrites it, which copies no lambda.
fn sweep_within(
  state: TryState,
  expr: Expr,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
  room: Int,
) -> TryOut / {abort.raise} =
  match expr {
    ETry(t) -> {
      let d = match barrier {
        Some(what) ->
          error_at(
            b"E0118",
            t.span,
            b"this file gives `?` no meaning here",
            b"no `Result` or `Option` to expand this into",
            [
              bytes_concat_all([
                b"this `?` is inside ",
                what,
                b", which has no written return type of its own. `?` exits the expression it is written in and never a lambda, a handler or a region: name a function with a written `->` and call it",
              ]),
            ],
          ),
        None -> match scope {
          Some(why) ->
            error_at(
              b"E0118",
              t.span,
              b"this file gives `?` no meaning here",
              b"no `Result` or `Option` to expand this into",
              [why],
            ),
          None ->
            error_at(
              b"E0119",
              t.span,
              b"this `?` is not in a position it can be expanded from",
              b"`?` cannot exit from here",
              [
                b"`?` lifts what it unwraps to the head of the statement, or of the return position, it is written in \xe2\x80\x94 so nothing conditional may sit between the two, and everything evaluated before it must be pure. Bind it first: `let a = e?;`",
              ],
            ),
        },
      };
      sweep_inner({ ..state, diags: push(state.diags, d) }, t.operand, scope, barrier, room)
    },
    _ -> sweep_inner(state, expr, scope, barrier, room),
  }

fn sweep_inner(
  state: TryState,
  expr: Expr,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
  room: Int,
) -> TryOut / {abort.raise} =
  match expr {
    ETry(t) -> {
      let o = sweep_within(state, t.operand, scope, barrier, room);
      { state: o.state, expr: ETry({ span: t.span, operand: o.expr }) }
    },
    EBinary(b) -> {
      let l = sweep_within(state, b.lhs, scope, barrier, room);
      let r = sweep_within(l.state, b.rhs, scope, barrier, room);
      { state: r.state, expr: EBinary({ span: b.span, op: b.op, lhs: l.expr, rhs: r.expr }) }
    },
    EUnary(u) -> {
      let o = sweep_within(state, u.operand, scope, barrier, room);
      { state: o.state, expr: EUnary({ span: u.span, op: u.op, operand: o.expr }) }
    },
    ELambda(l) -> match l.ret {
      None -> {
        let o = sweep_within(state, l.body, scope, under(barrier, b"a lambda"), room);
        {
          state: o.state,
          expr: ELambda({ span: l.span, body: o.expr, params: l.params, ret: None }),
        }
      },
      Some(ty) -> match mode_for(state, Some(ty)) {
        Err(why) -> {
          let o = sweep_within(state, l.body, Some(why), None, room);
          {
            state: o.state,
            expr: ELambda({ span: l.span, body: o.expr, params: l.params, ret: Some(ty) }),
          }
        },
        Ok(m) -> {
          let saved = state.mode;
          let r = ret({ ..state, mode: Some(m) }, l.body, tries_in(l.body));
          let s: TryOut = if room <= 0 { panic("a lambda swept past the ones written") }
          else { sweep_within(r.state, r.expr, None, None, room - 1) };
          {
            state: { ..s.state, mode: saved },
            expr: ELambda({ span: l.span, body: s.expr, params: l.params, ret: Some(ty) }),
          }
        },
      },
    },
    EApp(a) -> {
      let f = sweep_within(state, a.func, scope, barrier, room);
      let args = sweep_all(f.state, a.args, scope, barrier, room);
      let named = fold(
        a.named,
        { state: args.state, args: [] },
        |acc: { state: TryState, args: List<NamedArg> }, arg: NamedArg| {
          let o = sweep_within(acc.state, arg.value, scope, barrier, room);
          {
            state: o.state,
            args: push(acc.args, { name: arg.name, value: o.expr, span: arg.span }),
          }
        },
      );
      {
        state: named.state,
        expr: EApp({
          span: a.span,
          func: f.expr,
          named: named.args,
          args: args.exprs,
          labels: a.labels,
        }),
      }
    },
    EIf(i) -> {
      let c = sweep_within(state, i.cond, scope, barrier, room);
      let t = sweep_within(c.state, i.then_branch, scope, barrier, room);
      let el = sweep_within(t.state, i.else_branch, scope, barrier, room);
      {
        state: el.state,
        expr: EIf({ span: i.span, cond: c.expr, then_branch: t.expr, else_branch: el.expr }),
      }
    },
    EMatch(m) -> {
      let sc = sweep_within(state, m.scrutinee, scope, barrier, room);
      let arms = fold(
        m.arms,
        { state: sc.state, arms: [] },
        |acc: { state: TryState, arms: List<MatchArm> }, arm: MatchArm| {
          let g = match arm.guard {
            None -> { state: acc.state, expr: None },
            Some(x) -> {
              let o = sweep_within(acc.state, x, scope, barrier, room);
              { state: o.state, expr: Some(o.expr) }
            },
          };
          let b = sweep_within(g.state, arm.body, scope, barrier, room);
          {
            state: b.state,
            arms: push(acc.arms, { pat: arm.pat, guard: g.expr, body: b.expr, span: arm.span }),
          }
        },
      );
      { state: arms.state, expr: EMatch({ span: m.span, scrutinee: sc.expr, arms: arms.arms }) }
    },
    EBlock(b) -> {
      let stmts = fold(
        b.stmts,
        { state: state, stmts: [] },
        |acc: { state: TryState, stmts: List<Stmt> }, stmt: Stmt|
          match stmt {
            SLet(l) -> {
              let o = sweep_within(acc.state, l.value, scope, barrier, room);
              {
                state: o.state,
                stmts: push(acc.stmts, SLet({ span: l.span, pat: l.pat, ty: l.ty, value: o.expr })),
              }
            },
            SLetElse(l) -> {
              let v = sweep_within(acc.state, l.value, scope, barrier, room);
              let f = sweep_within(v.state, l.fallback, scope, barrier, room);
              {
                state: f.state,
                stmts: push(acc.stmts, SLetElse({ ..l, value: v.expr, fallback: f.expr })),
              }
            },
            SExpr(x) -> {
              let o = sweep_within(acc.state, x, scope, barrier, room);
              { state: o.state, stmts: push(acc.stmts, SExpr(o.expr)) }
            },
          },
      );
      let tl = match b.tail {
        None -> { state: stmts.state, expr: None },
        Some(t) -> {
          let o = sweep_within(stmts.state, t, scope, barrier, room);
          { state: o.state, expr: Some(o.expr) }
        },
      };
      { state: tl.state, expr: EBlock({ span: b.span, tail: tl.expr, stmts: stmts.stmts }) }
    },
    ERecord(r) -> {
      let o = sweep_fields(state, r.fields, scope, barrier, room);
      { state: o.state, expr: ERecord({ span: r.span, fields: o.fields }) }
    },
    ERecordUpdate(r) -> {
      let b = sweep_within(state, r.base, scope, barrier, room);
      let o = sweep_fields(b.state, r.fields, scope, barrier, room);
      { state: o.state, expr: ERecordUpdate({ span: r.span, base: b.expr, fields: o.fields }) }
    },
    EField(f) -> {
      let o = sweep_within(state, f.base, scope, barrier, room);
      { state: o.state, expr: EField({ span: f.span, base: o.expr, field: f.field }) }
    },
    EList(l) -> {
      let o = sweep_all(state, l.items, scope, barrier, room);
      { state: o.state, expr: EList({ span: l.span, items: o.exprs }) }
    },
    EPerform(p) -> {
      let o = sweep_all(state, p.args, scope, barrier, room);
      {
        state: o.state,
        expr: EPerform({ span: p.span, eff: p.eff, op: p.op, resource: p.resource, args: o.exprs }),
      }
    },
    EHandle(h) -> {
      let b = sweep_within(state, h.body, scope, under(barrier, b"a `handle` body"), room);
      let cs = fold(
        h.clauses,
        { state: b.state, clauses: [] },
        |acc: { state: TryState, clauses: List<HandleClause> }, c: HandleClause| {
          let o = sweep_within(
            acc.state,
            c.body,
            scope,
            under(barrier, b"a `handle` clause"),
            room,
          );
          {
            state: o.state,
            clauses: push(acc.clauses, {
              eff: c.eff,
              op: c.op,
              resource: c.resource,
              every_label: c.every_label,
              label_binder: c.label_binder,
              resume: c.resume,
              body: o.expr,
              span: c.span,
              params: c.params,
            }),
          }
        },
      );
      let r = match h.ret {
        None -> { state: cs.state, ret: None },
        Some(rc) -> {
          let o = sweep_within(
            cs.state,
            rc.body,
            scope,
            under(barrier, b"a `handle` return clause"),
            room,
          );
          { state: o.state, ret: Some({ binder: rc.binder, body: o.expr, span: rc.span }) }
        },
      };
      {
        state: r.state,
        expr: EHandle({ span: h.span, body: b.expr, ret: r.ret, clauses: cs.clauses }),
      }
    },
    EWithCell(c) -> {
      let i = sweep_within(state, c.init, scope, barrier, room);
      let b = sweep_within(i.state, c.body, scope, under(barrier, b"a `with_cell` body"), room);
      {
        state: b.state,
        expr: EWithCell({
          span: c.span,
          resource: c.resource,
          init: i.expr,
          binder: c.binder,
          body: b.expr,
        }),
      }
    },
    ESimulate(x) -> {
      let o = sweep_within(state, x.body, scope, under(barrier, b"a `simulate` body"), room);
      { state: o.state, expr: ESimulate({ span: x.span, body: o.expr }) }
    },
    EParallel(x) -> {
      let o = sweep_all(state, x.branches, scope, under(barrier, b"a `parallel` branch"), room);
      { state: o.state, expr: EParallel({ span: x.span, branches: o.exprs }) }
    },
    _ -> { state: state, expr: expr },
  }

fn sweep_all(
  state: TryState,
  exprs: List<Expr>,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
  room: Int,
) -> { state: TryState, exprs: List<Expr> } / {abort.raise} =
  fold(
    exprs,
    { state: state, exprs: [] },
    |acc: { state: TryState, exprs: List<Expr> }, expr: Expr| {
      let o = sweep_within(acc.state, expr, scope, barrier, room);
      { state: o.state, exprs: push(acc.exprs, o.expr) }
    },
  )

fn sweep_fields(
  state: TryState,
  fields: List<RecField>,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
  room: Int,
) -> { state: TryState, fields: List<RecField> } / {abort.raise} =
  fold(
    fields,
    { state: state, fields: [] },
    |acc: { state: TryState, fields: List<RecField> }, field: RecField| {
      let o = sweep_within(acc.state, field.value, scope, barrier, room);
      { state: o.state, fields: push(acc.fields, { name: field.name, value: o.expr }) }
    },
  )

fn try_item(outer: TryState, item: Item) -> { state: TryState, item: Item } / {abort.raise} = {
  let state = { ..outer, fresh: 0, mode: None };
  match item {
    IFn(d) -> {
      let spec: { state: TryState, clauses: List<SpecClause> } = fold(
        d.spec,
        { state: state, clauses: [] },
        |acc: { state: TryState, clauses: List<SpecClause> }, clause: SpecClause| {
          let what = match clause.kind {
            SRequires -> b"a `requires` clause",
            SEnsures -> b"an `ensures` clause",
            SCost -> b"a `cost` clause",
          };
          let o = sweep(acc.state, clause.expr, Some(not_in_a_function(what)), None);
          {
            state: o.state,
            clauses: push(acc.clauses, { kind: clause.kind, expr: o.expr, span: clause.span }),
          }
        },
      );
      let measured: { state: TryState, expr: Option<Expr> } = match d.decreases {
        None -> { state: spec.state, expr: None },
        Some(e) -> {
          let o = sweep(spec.state, e, Some(not_in_a_function(b"a `decreases` clause")), None);
          { state: o.state, expr: Some(o.expr) }
        },
      };
      let body = match mode_for(state, d.ret) {
        Err(why) -> sweep(measured.state, d.body, Some(why), None),
        Ok(m) -> {
          let r = ret({ ..measured.state, mode: Some(m) }, d.body, tries_in(d.body));
          let s: TryOut = sweep(r.state, r.expr, None, None);
          { state: { ..s.state, mode: None }, expr: s.expr }
        },
      };
      {
        state: body.state,
        item: IFn({
          vis: d.vis,
          name: d.name,
          generics: d.generics,
          params: d.params,
          ret: d.ret,
          effects: d.effects,
          constraints: d.constraints,
          spec: spec.clauses,
          returns: d.returns,
          reuse: d.reuse,
          transparent: d.transparent,
          decreases: measured.expr,
          body: body.expr,
          span: d.span,
        }),
      }
    },
    ITest(d) -> {
      let o = sweep(state, d.body, Some(not_in_a_function(b"a `test`")), None);
      {
        state: o.state,
        item: ITest({
          name: d.name,
          name_span: d.name_span,
          is_nondet: d.is_nondet,
          body: o.expr,
          span: d.span,
        }),
      }
    },
    ILaw(d) -> {
      let why = not_in_a_function(b"a `law`");
      let g = match d.guard {
        None -> { state: state, expr: None },
        Some(x) -> {
          let o = sweep(state, x, Some(why), None);
          { state: o.state, expr: Some(o.expr) }
        },
      };
      let b = sweep(g.state, d.body, Some(why), None);
      {
        state: b.state,
        item: ILaw({
          name: d.name,
          name_span: d.name_span,
          host: d.host,
          binders: d.binders,
          guard: g.expr,
          cost: d.cost,
          costs: d.costs,
          body: b.expr,
          span: d.span,
        }),
      }
    },
    _ -> { state: state, item: item },
  }
}

pub fn expand_try(
  module: Module,
  diags: List<ParseDiag>,
) -> { module: Module, diags: List<ParseDiag> } / {abort.raise} = {
  let start = {
    types: collect_types(module),
    shadowed: shadowing_ctor(module),
    diags: diags,
    mode: None,
    fresh: 0,
  };
  let walked = fold(
    module.items,
    { state: start, items: [] },
    |acc: { state: TryState, items: List<Item> }, item: Item| {
      let o = try_item(acc.state, item);
      { state: o.state, items: push(acc.items, o.item) }
    },
  );
  { module: { imports: module.imports, items: walked.items }, diags: walked.state.diags }
}

// --- Running the rewrites --------------------------------------------------------------------

fn has_update(module: Module) -> Bool = any_expr(module, is_update)

fn is_update(expr: Expr) -> Bool = match expr { ERecordUpdate(_) -> true, _ -> false }

// Whether a definition writes a record update anywhere: its body, a clause, or a default.
pub fn fn_has_update(def: FnDef) -> Bool = any_expr({ imports: [], items: [IFn(def)] }, is_update)

fn has_try(m: Module) -> Bool = any_expr(m, |expr: Expr| match expr { ETry(_) -> true, _ -> false })

fn any_expr(module: Module, p: (Expr) -> Bool) -> Bool =
  fold(module.items, false, |acc: Bool, item: Item|
    acc
      || (match item {
        IFn(d) ->
          count_in(d.body, p) > 0
            || fold(d.spec, false, |b: Bool, clause: SpecClause| b || count_in(clause.expr, p) > 0)
            || fold(d.params, false, |b: Bool, param: Param|
              b || (match param.default { None -> false, Some(v) -> count_in(v, p) > 0 })),
        ITest(d) -> count_in(d.body, p) > 0,
        ILaw(d) ->
          count_in(d.body, p) > 0
            || (match d.guard { None -> false, Some(g) -> count_in(g, p) > 0 }),
        _ -> false,
      }))

// How many expressions within `e`, itself included, `p` holds for.
fn count_in(e: Expr, p: (Expr) -> Bool) -> Int = {
  let all = |es: List<Expr>| fold(es, 0, |n: Int, x: Expr| n + count_in(x, p));
  let maybe = |o: Option<Expr>| match o { None -> 0, Some(x) -> count_in(x, p) };
  (if p(e) { 1 } else { 0 })
    + (match e {
      EBinary(b) -> count_in(b.lhs, p) + count_in(b.rhs, p),
      EUnary(u) -> count_in(u.operand, p),
      ELambda(l) ->
        count_in(l.body, p) + fold(l.params, 0, |n: Int, x: Param| n + maybe(x.default)),
      EApp(a) ->
        count_in(a.func, p) + all(a.args)
          + fold(a.named, 0, |n: Int, arg: NamedArg| n + count_in(arg.value, p)),
      EIf(i) -> count_in(i.cond, p) + count_in(i.then_branch, p) + count_in(i.else_branch, p),
      EMatch(m) ->
        count_in(m.scrutinee, p)
          + fold(m.arms, 0, |n: Int, arm: MatchArm| n + count_in(arm.body, p) + maybe(arm.guard)),
      EBlock(b) ->
        fold(b.stmts, 0, |n: Int, stmt: Stmt|
            n
              + (match stmt {
                SLet(l) -> count_in(l.value, p),
                SLetElse(l) -> count_in(l.value, p) + count_in(l.fallback, p),
                SExpr(x) -> count_in(x, p),
              }))
          + maybe(b.tail),
      ERecord(r) -> fold(r.fields, 0, |n: Int, f: RecField| n + count_in(f.value, p)),
      ERecordUpdate(r) ->
        count_in(r.base, p) + fold(r.fields, 0, |n: Int, f: RecField| n + count_in(f.value, p)),
      ETry(t) -> count_in(t.operand, p),
      EField(f) -> count_in(f.base, p),
      EList(l) -> all(l.items),
      EPerform(x) -> all(x.args),
      EHandle(h) ->
        count_in(h.body, p) + fold(h.clauses, 0, |n: Int, c: HandleClause| n + count_in(c.body, p))
          + (match h.ret { None -> 0, Some(rc) -> count_in(rc.body, p) }),
      EWithCell(c) -> count_in(c.init, p) + count_in(c.body, p),
      ESimulate(x) -> count_in(x.body, p),
      EParallel(x) -> all(x.branches),
      _ -> 0,
    })
}

fn tries_in(e: Expr) -> Int = count_in(e, |x: Expr| match x { ETry(_) -> true, _ -> false })

// --- The cost law ----------------------------------------------------------------------------

// A cost law measures its body: at each size it is run at, it holds the steps the body took beside
// the bound they are fitted against. `cost` stays on the law, so the checker and the prover know it
// for one; what it bounds is now in the body, where its binder is in scope. `captured` says what
// would take the call to the builtin `metered` for its own, and the law is refused rather than
// measured with it.
fn measured(law_def: LawDef, captured: Option<Bytes>) -> { law: LawDef, diag: Option<ParseDiag> } =
  match law_def.cost {
    None -> { law: law_def, diag: None },
    Some(bound) -> {
      let at = expr_span(law_def.body);
      let named = |t: Bytes| { name: t, span: at };
      let call = EApp({
        span: at,
        func: EVar({ span: at, name: { module: None, name: named(b"metered"), span: at } }),
        named: [],
        args: [ELambda({ span: at, body: law_def.body, params: [], ret: None })],
        labels: [],
      });
      let binds = fold(law_def.binders, false, |found: Bool, binder: Binder|
        found || binder.name.name == b"metered");
      let why = if binds {
        Some(
          b"this law names its size `metered`, which would capture the call it measures its body with; rename the size",
        )
      } else { captured };
      let steps = match why {
        Some(_) -> EBad({ span: at }),
        None -> EField({ span: at, base: call, field: named(b"steps") }),
      };
      {
        law: {
          ..law_def,
          body: ERecord({
            span: at,
            fields: [
              { name: named(b"bound"), value: bound },
              { name: named(b"steps"), value: steps },
            ],
          }),
        },
        diag: match why {
          None -> None,
          Some(note) ->
            Some(
              error_at(
                b"E0463",
                law_def.name_span,
                b"this cost law cannot measure its body",
                b"a cost law measures its body with the builtin `metered`",
                [note],
              ),
            ),
        },
      }
    },
  }

// A `metered` of the module's own, or one it imports unqualified, would capture the call a cost law
// measures its body with.
fn metered_captured(module: Module) -> Option<Bytes> = {
  let declared = fold(module.items, false, |found: Bool, item: Item|
    found || (match item { IFn(f) -> f.name.name == b"metered", _ -> false }));
  let imported = fold(module.imports, false, |found: Bool, decl: ImportDecl|
    found
      || (match decl.kind {
        INames(ns) ->
          fold(ns, false, |named: Bool, ident: Ident| named || ident.name == b"metered"),
        _ -> false,
      }));
  if declared {
    Some(
      b"this module declares its own `metered`, which would capture the call a cost law measures its body with; rename it",
    )
  } else if imported {
    Some(
      b"this module imports `metered` unqualified, which would capture the call a cost law measures its body with; import the module instead and qualify the name",
    )
  } else { None }
}

fn has_cost_law(module: Module) -> Bool =
  fold(module.items, false, |b: Bool, item: Item|
    b || (match item { ILaw(d) -> d.cost != None, _ -> false }))

fn measured_laws(
  module: Module,
  diags: List<ParseDiag>,
) -> { module: Module, diags: List<ParseDiag> } =
  if !has_cost_law(module) { { module: module, diags: diags } } else {
    let captured = metered_captured(module);
    let walked = fold(
      module.items,
      { items: [], diags: diags },
      |acc: { items: List<Item>, diags: List<ParseDiag> }, item: Item|
        match item {
          ILaw(d) -> {
            let x = measured(d, captured);
            {
              items: push(acc.items, ILaw(x.law)),
              diags: match x.diag { Some(g) -> push(acc.diags, g), None -> acc.diags },
            }
          },
          other -> { ..acc, items: push(acc.items, other) },
        },
    );
    { module: { ..module, items: walked.items }, diags: walked.diags }
  }

// Only when the grammar met a `?` or a cost law. A record update needs the checker's answer for its
// base, so `expand_record_updates` runs later, over a checked program.
pub fn expand(
  module: Module,
  diags: List<ParseDiag>,
) -> { module: Module, diags: List<ParseDiag> } / {abort.raise} = {
  let tried = if has_try(module) { expand_try(module, diags) }
  else { { module: module, diags: diags } };
  let measured = measured_laws(tried.module, tried.diags);
  cost_laws(measured.module, measured.diags)
}

// --- The cost clause ---------------------------------------------------------------------------

// Each `cost` clause is also a cost law over one size, measured where no proof shows the bound:
// every parameter is made of that size before the call, and only the call is metered. A parameter
// of a type nothing here makes raises, which leaves the clause to a proof.
fn cost_laws(module: Module, diags: List<ParseDiag>) -> { module: Module, diags: List<ParseDiag> } = {
  let made = fold(module.items, [], |acc: List<Item>, item: Item|
    match item {
      IFn(d) -> {
        let bounds = filter(d.spec, |c: SpecClause| c.kind == SCost);
        concat(
          acc,
          map(range(0, len(bounds)), |k: Int|
            ILaw(cost_law(d, match list_at(bounds, k) { Some(c) -> c, None -> no_cost() }, k))),
        )
      },
      _ -> acc,
    });
  if len(made) == 0 { { module: module, diags: diags } } else {
    let captured = match metered_captured(module) {
      None -> diags,
      Some(note) ->
        fold(made, diags, |acc: List<ParseDiag>, item: Item|
          match item {
            ILaw(l) ->
              push(
                acc,
                error_at(
                  b"E0463",
                  l.name_span,
                  b"this `cost` bound cannot be measured",
                  b"a bound is measured with the builtin `metered`",
                  [note],
                ),
              ),
            _ -> acc,
          }),
    };
    { module: { ..module, items: concat(module.items, made) }, diags: captured }
  }
}

fn no_cost() -> SpecClause = { kind: SCost, expr: EBad({ span: dummy_span() }), span: dummy_span() }

fn cost_law(d: FnDef, clause: SpecClause, k: Int) -> LawDef = {
  let at = clause.span;
  let ident = |t: Bytes| { name: t, span: at };
  let var = |t: Bytes| EVar({ span: at, name: { module: None, name: ident(t), span: at } });
  let call = |f: Bytes, args: List<Expr>|
    EApp({ span: at, func: var(f), named: [], args: args, labels: [] });
  let taken = fold(d.params, [d.name.name], |acc: List<Bytes>, p: Param|
    match p.cost {
      Some(c) -> push(push(acc, p.name.name), c.name),
      None -> push(acc, p.name.name),
    });
  let size = fresh_name(taken);
  let let_of = |name: Ident, value: Expr|
    SLet({ span: at, pat: PVar({ span: at, name: name }), ty: None, value: value });
  // A function parameter with a cost name is a closure of one step, so its cost name is 1.
  let made = fold(d.params, [], |acc: List<Stmt>, p: Param|
    match ((p.cost, p.ty)) {
      (Some(c), Some(TFn(f))) ->
        push(
          push(acc, let_of(p.name, one_step(f.params, f.ret, at))),
          let_of(c, ELit({ span: at, lit: LInt(1) })),
        ),
      _ -> push(acc, let_of(p.name, made_of(p.ty, var(size), at))),
    });
  let steps = EField({
    span: at,
    base: call(b"metered", [
      ELambda({
        span: at,
        body: call(d.name.name, map(d.params, |p: Param| var(p.name.name))),
        params: [],
        ret: None,
      }),
    ]),
    field: ident(b"steps"),
  });
  {
    name: bytes_concat_all([
      b"cost of ",
      d.name.name,
      if k == 0 { b"" } else { bytes_concat(b" #", ascii_of_int(k + 1)) },
    ]),
    name_span: at,
    host: false,
    binders: [
      {
        name: ident(size),
        ty: TCon({ span: at, name: { module: None, name: ident(b"Int"), span: at }, args: [] }),
        span: at,
      },
    ],
    guard: Some(
      EBinary({ span: at, op: b"gt", lhs: var(size), rhs: ELit({ span: at, lit: LInt(0) }) }),
    ),
    cost: Some(EBlock({ span: at, stmts: made, tail: Some(clause.expr) })),
    costs: Some({ def: d.name, index: k }),
    body: EBlock({
      span: at,
      stmts: made,
      tail: Some(
        ERecord({
          span: at,
          fields: [
            { name: ident(b"bound"), value: clause.expr },
            { name: ident(b"steps"), value: steps },
          ],
        }),
      ),
    }),
    span: at,
  }
}

// A closure that answers a value of `ret` at once, whatever it is given.
fn one_step(params: List<TypeExpr>, ret: TypeExpr, at: Span) -> Expr =
  ELambda({
    span: at,
    body: match ret {
      TUnit(_) -> ELit({ span: at, lit: LUnit }),
      _ -> match element_of(ret, ELit({ span: at, lit: LInt(0) }), at) {
        Some(e) -> e,
        None -> unmade(at),
      },
    },
    params: map(params, |_t: TypeExpr|
      { name: { name: b"_", span: at }, ty: None, cost: None, default: None, span: at }),
    ret: None,
  })

// The first of `n`, `n1`, `n2` ... no parameter or the definition is named.
fn fresh_name(taken: List<Bytes>) -> Bytes =
  fold(range(0, len(taken) + 1), b"", |found: Bytes, i: Int|
    if found != b"" { found } else {
      let name = if i == 0 { b"n" } else { bytes_concat(b"n", ascii_of_int(i)) };
      if fold(taken, false, |hit: Bool, t: Bytes| hit || t == name) { b"" } else { name }
    })

// A value of the parameter's type whose size is `size`: an `Int` is it, and a list, a string, bytes
// or a map holds that many elements.
fn made_of(ty: Option<TypeExpr>, size: Expr, at: Span) -> Expr =
  match ty {
    Some(TCon(t)) -> {
      let ident = |s: Bytes| { name: s, span: at };
      let var = |s: Bytes| EVar({ span: at, name: { module: None, name: ident(s), span: at } });
      let call = |f: Bytes, args: List<Expr>|
        EApp({ span: at, func: var(f), named: [], args: args, labels: [] });
      let indices = call(b"range", [ELit({ span: at, lit: LInt(0) }), size]);
      let each = |body: Expr|
        ELambda({
          span: at,
          body: body,
          params: [{ name: ident(b"i"), ty: None, cost: None, default: None, span: at }],
          ret: None,
        });
      let text = call(b"fold", [
        indices,
        ELit({ span: at, lit: LStr(b"") }),
        ELambda({
          span: at,
          body: EBinary({
            span: at,
            op: b"concat",
            lhs: var(b"s"),
            rhs: ELit({ span: at, lit: LStr(b"a") }),
          }),
          params: [
            { name: ident(b"s"), ty: None, cost: None, default: None, span: at },
            { name: ident(b"i"), ty: None, cost: None, default: None, span: at },
          ],
          ret: None,
        }),
      ]);
      let name = t.name.name.name;
      if t.name.module != None { unmade(at) }
      else if name == b"Int" { size }
      else if name == b"String" { text }
      else if name == b"Bytes" { call(b"bytes_of_string", [text]) } else if name == b"List" {
        match t.args {
          [elem] -> match element_of(elem, var(b"i"), at) {
            Some(e) -> call(b"map", [indices, each(e)]),
            None -> unmade(at),
          },
          _ -> unmade(at),
        }
      } else if name == b"Map" {
        match t.args {
          [key, value] -> match ((
              element_of(key, var(b"i"), at),
              element_of(value, var(b"i"), at),
            )) {
            (Some(kv), Some(vv)) ->
              call(b"fold", [
                indices,
                call(b"map_new", []),
                ELambda({
                  span: at,
                  body: call(b"map_insert", [var(b"m"), kv, vv]),
                  params: [
                    { name: ident(b"m"), ty: None, cost: None, default: None, span: at },
                    { name: ident(b"i"), ty: None, cost: None, default: None, span: at },
                  ],
                  ret: None,
                }),
              ]),
            _ -> unmade(at),
          },
          _ -> unmade(at),
        }
      } else { unmade(at) }
    },
    _ -> unmade(at),
  }

// One element made of its index: a number is it, a string spells it, and a collection is empty.
fn element_of(ty: TypeExpr, index: Expr, at: Span) -> Option<Expr> = {
  let var = |s: Bytes|
    EVar({ span: at, name: { module: None, name: { name: s, span: at }, span: at } });
  let call = |f: Bytes, args: List<Expr>|
    EApp({ span: at, func: var(f), named: [], args: args, labels: [] });
  match ty {
    TVar(_) -> Some(index),
    TCon(t) -> if t.name.module != None { None } else {
      let name = t.name.name.name;
      if name == b"Int" { Some(index) }
      else if name == b"String" { Some(call(b"int_to_string", [index])) }
      else if name == b"Bool" { Some(ELit({ span: at, lit: LBool(true) })) }
      else if name == b"List" { Some(EList({ span: at, items: [] })) }
      else if name == b"Map" { Some(call(b"map_new", [])) }
      else { None }
    },
    _ -> None,
  }
}

fn unmade(at: Span) -> Expr =
  EApp({
    span: at,
    func: EVar({ span: at, name: { module: None, name: { name: b"panic", span: at }, span: at } }),
    named: [],
    args: [
      ELit({
        span: at,
        lit: LStr(b"a `cost` bound is measured only over parameters made of a size"),
      }),
    ],
    labels: [],
  })

pub fn dump_expanded(src: Bytes) -> String / {abort.raise} = {
  let r = parse(src);
  let x = expand(r.node, r.parser.diags);
  string_of_bytes(bytes_concat(dump_module(x.module), dump_diags(x.diags)))
}

// --- Tests ------------------------------------------------------------------

test "a cost law's body is measured with the builtin `metered`, beside its bound" {
  let dumped = dump_expanded(b"law \"l\" forall (n: Int) cost n { n }");
  // `metered` and `steps`, as the dump spells a name.
  assert(string_contains(dumped, "@6d657465726564"));
  assert(string_contains(dumped, "@7374657073"));
  assert(!string_contains(dumped, "E0463"))
}

test "each `cost` clause is also a cost law, over a size no parameter is named, that makes each parameter of it" {
  let dumped = dump_expanded(b"fn f(n: Int, xs: List<Int>) -> Int cost len(xs) cost n = n");
  assert(string_contains(dumped, "@636f7374206f662066"));
  assert(string_contains(dumped, "@636f7374206f662066202332"));
  // `n` is a parameter, so the size is `n1`; `xs` is made with `range` and `map`.
  assert(string_contains(dumped, "@6e31"));
  assert(string_contains(dumped, "@72616e6765"));
  assert(string_contains(dumped, "@6d657465726564"));
  assert(!string_contains(dumped, "E0463"))
}

test "a function parameter with a cost name is made a closure of one step, and its cost name 1" {
  let dumped = dump_expanded(
    b"fn f(xs: List<Int>, g: (Int) -> String cost k) -> Int cost len(xs) * k = 0",
  );
  // The closure answers `int_to_string(0)` whatever it is given; `k` is bound to 1.
  assert(string_contains(dumped, "@696e745f746f5f737472696e67"));
  // The only `1` in the law is the one `k` is bound to.
  assert(string_contains(dumped, "%int;@31"));
  assert(
    !string_contains(
      dumped,
      "@612060636f73746020626f756e64206973206d65617375726564206f6e6c79206f76657220706172616d6574657273206d616465206f6620612073697a65",
    ),
  )
}

test "a `metered` of the module's own, an unqualified import of one, or a size named so is refused" {
  let refused = |src: Bytes| string_contains(dump_expanded(src), "E0463");
  assert(refused(b"fn metered(n: Int) -> Int = n\nlaw \"l\" forall (n: Int) cost n { n }"));
  assert(refused(b"import m (metered)\nlaw \"l\" forall (n: Int) cost n { n }"));
  assert(refused(b"law \"l\" forall (metered: Int) cost metered { metered }"));
  // Only a cost law calls it, so an ordinary law may share a module with one.
  assert(!refused(b"fn metered(n: Int) -> Int = n\nlaw \"l\" forall (n: Int) { metered(n) == n }"))
}

test "a `?` on a `let` splits the block at that statement, failure arm first" {
  assert_eq(
    dump_expanded(b"fn f(n: Int) -> Result<Int, Bytes> = { let x = g(n)?; Ok(x + 1) }"),
    "#0;#1;0:65:fn;%priv;?0;?0;?0;3:4:ident;@66;%gen;#0;#0;#0;#1;5:11:prm;5:6:ident;@6e;?1;8:11:tcon;8:11:qname;?0;8:11:ident;@496e74;#0;?0;?1;16:34:tcon;16:22:qname;?0;16:22:ident;@526573756c74;#2;23:26:tcon;23:26:qname;?0;23:26:ident;@496e74;#0;28:33:tcon;28:33:qname;?0;28:33:ident;@4279746573;#0;?0;#0;#0;37:65:eblk;#0;?1;47:52:emat;47:51:eapp;47:48:evar;47:48:qname;?0;47:48:ident;@67;#1;49:50:evar;49:50:qname;?0;49:50:ident;@6e;#0;#0;#2;47:52:arm;47:52:pctr;47:52:qname;?0;47:52:ident;@457272;#1;47:52:pvar;47:52:ident;@3f30;?0;47:52:eapp;47:52:evar;47:52:qname;?0;47:52:ident;@457272;#1;47:52:evar;47:52:qname;?0;47:52:ident;@3f30;#0;#0;47:52:arm;47:52:pctr;47:52:qname;?0;47:52:ident;@4f6b;#1;43:44:pvar;43:44:ident;@78;?0;47:52:eblk;#0;?1;54:63:eapp;54:56:evar;54:56:qname;?0;54:56:ident;@4f6b;#1;57:62:ebin;%add;57:58:evar;57:58:qname;?0;57:58:ident;@78;61:62:elit;%int;@31;#0;#0;#0;",
  )
}

test "a `?` inside a return-position expression lifts to its head, and an `Option` names `None`" {
  assert_eq(
    dump_expanded(b"fn f(n: Int) -> Option<Int> = Some(g(n)? + 1)"),
    "#0;#1;0:45:fn;%priv;?0;?0;?0;3:4:ident;@66;%gen;#0;#0;#0;#1;5:11:prm;5:6:ident;@6e;?1;8:11:tcon;8:11:qname;?0;8:11:ident;@496e74;#0;?0;?1;16:27:tcon;16:22:qname;?0;16:22:ident;@4f7074696f6e;#1;23:26:tcon;23:26:qname;?0;23:26:ident;@496e74;#0;?0;#0;#0;35:40:emat;35:39:eapp;35:36:evar;35:36:qname;?0;35:36:ident;@67;#1;37:38:evar;37:38:qname;?0;37:38:ident;@6e;#0;#0;#2;35:40:arm;35:40:pctr;35:40:qname;?0;35:40:ident;@4e6f6e65;#0;?0;35:40:evar;35:40:qname;?0;35:40:ident;@4e6f6e65;35:40:arm;35:40:pctr;35:40:qname;?0;35:40:ident;@536f6d65;#1;35:40:pvar;35:40:ident;@3f30;?0;30:45:eapp;30:34:evar;30:34:qname;?0;30:34:ident;@536f6d65;#1;35:44:ebin;%add;35:40:evar;35:40:qname;?0;35:40:ident;@3f30;43:44:elit;%int;@31;#0;#0;#0;",
  )
}

test "a `?` in a function with no written return type is refused and unwrapped" {
  assert_eq(
    dump_expanded(b"fn f(n: Int) = g(n)?"),
    "#0;#1;0:20:fn;%priv;?0;?0;?0;3:4:ident;@66;%gen;#0;#0;#0;#1;5:11:prm;5:6:ident;@6e;?1;8:11:tcon;8:11:qname;?0;8:11:ident;@496e74;#0;?0;?0;?0;#0;#0;15:19:eapp;15:16:evar;15:16:qname;?0;15:16:ident;@67;#1;17:18:evar;17:18:qname;?0;17:18:ident;@6e;#0;#0;#1;!E0118:15:20:1:1;=15:20:1;",
  )
}

test "a `?` on a `let` with a written type keeps the annotation" {
  let out = dump_expanded(
    b"fn f(n: Int) -> Result<Int, Bytes> = { let x: Int = g(n)?; Ok(x + 1) }",
  );
  assert(!string_contains(out, "!E0119"));
  assert(string_contains(out, "@3f30"))
}
