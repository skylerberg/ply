// The rewrites over a parsed module: the try operator, run with the grammar, and the record update,
// which needs the checker's answer for its base and so runs after the check.

import spine (Span, Ident, QName, PDiag, Label, span_to, dummy_span, bare, num, span_key, diag1,
              diag2, pdiag, plabel, dump_diags)
import types (TypeExpr, TVar, TCon, TFn, TRecord, TUnit, TBad, RowExpr, AtomExpr, Mode, MRead,
              MWrite, MBad)
import items (Module, Item, IFn, IType, IEffect, ITest, ILaw, IDerive, IEffectSet, FnDef, TypeDef,
              TypeDefBody, TDAlias, TDSum, VariantDef, SpecClause, SRequires, SEnsures,
              EffectSetDef, ImportDecl, ImportKind, INames, Binder, OpDef, EffectDef, TestDef,
              LawDef, parse, dump_module)
import exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock, ERecord,
              ERecordUpdate, ETry, EField, EList, EPerform, EHandle, EWithCell, ESimulate,
              EParallel, EBad, Stmt, SLet, SLetElse, SExpr, Param, NamedArg, MatchArm, HandleClause,
              ReturnClause, RecField, expr_span)
import patterns (Pattern, PWild, PVar, PLit, PCtor, PRecord, PList, PBad, Lit, LUnit)

// --- Shared ---------------------------------------------------------------------

fn at<a>(xs: List<a>, i: Int) -> a =
  match list_at(xs, i) { Some(x) -> x, None -> panic("an index the rewrite does not hold") }

fn set_at<a>(xs: List<a>, i: Int, v: a) -> List<a> = list_set(xs, i, v)

fn take<a>(xs: List<a>, n: Int) -> List<a> = map(range(0, n), |i: Int| at(xs, i))

fn drop<a>(xs: List<a>, n: Int) -> List<a> = map(range(n, len(xs)), |i: Int| at(xs, i))

fn append<a>(a: List<a>, b: List<a>) -> List<a> = fold(b, a, |acc: List<a>, x: a| push(acc, x))

fn is_bare(q: QName) -> Bool = match q.module { None -> true, Some(_) -> false }

fn max_alias_depth() -> Int = 16

// This module's own `type` items; the first declaration of a name wins.
fn collect_types(m: Module) -> List<TypeDef> =
  fold(m.items, [], |acc: List<TypeDef>, it: Item|
    match it {
      IType(d) -> match find_type(acc, d.name.name) { Some(_) -> acc, None -> push(acc, d) },
      _ -> acc,
    })

fn find_type(ts: List<TypeDef>, name: Bytes) -> Option<TypeDef> =
  fold(ts, None, |acc: Option<TypeDef>, t: TypeDef|
    match acc { Some(_) -> acc, None -> if t.name.name == name { Some(t) } else { None } })

// Evaluates without calling or performing anything.
pub fn is_pure(e: Expr) -> Bool =
  match e {
    EApp(_) -> false,
    EPerform(_) -> false,
    EHandle(_) -> false,
    EWithCell(_) -> false,
    ESimulate(_) -> false,
    EParallel(v) -> fold(v.branches, true, |acc: Bool, x: Expr| acc && is_pure(x)),
    ETry(_) -> false,
    ELit(_) -> true,
    EVar(_) -> true,
    EBad(_) -> true,
    EBinary(b) -> is_pure(b.lhs) && is_pure(b.rhs),
    EUnary(u) -> is_pure(u.operand),
    ELambda(l) -> is_pure(l.body),
    EIf(i) -> is_pure(i.cond) && is_pure(i.then_branch) && is_pure(i.else_branch),
    EMatch(m) ->
      is_pure(m.scrutinee)
        && fold(m.arms, true, |acc: Bool, arm: MatchArm|
          acc && is_pure(arm.body) && (match arm.guard { None -> true, Some(g) -> is_pure(g) })),
    EBlock(b) ->
      fold(b.stmts, true, |acc: Bool, s: Stmt|
          acc
            && (match s {
              SLet(l) -> is_pure(l.value),
              SLetElse(l) -> is_pure(l.value) && is_pure(l.fallback),
              SExpr(x) -> is_pure(x),
            }))
        && (match b.tail { None -> true, Some(t) -> is_pure(t) }),
    ERecord(r) -> fold(r.fields, true, |acc: Bool, f: RecField| acc && is_pure(f.value)),
    ERecordUpdate(r) ->
      is_pure(r.base) && fold(r.fields, true, |acc: Bool, f: RecField| acc && is_pure(f.value)),
    EField(f) -> is_pure(f.base),
    EList(l) -> fold(l.items, true, |acc: Bool, x: Expr| acc && is_pure(x)),
  }

// --- Record update -----------------------------------------------------------------------
// `{..b, f: e}` is the literal it stands for. The shape it copies is the checker's answer for the
// base, keyed by the update's span, so this runs after the check and not with the other rewrites.

fn too_deep() -> Bytes =
  bytes_concat_all([b"more than ", num(max_alias_depth()), b" type aliases deep"])

// The literal an update stands for: the base's other fields, in the record's own order, then the
// written ones. A call is bound to a name first, so it runs once however many fields are copied.
fn expand_update(span: Span, base: Expr, written: List<RecField>, names: List<Bytes>) -> Expr = {
  let base_span = expr_span(base);
  let bound: Option<Ident> = match base {
    EApp(_) -> Some({ name: bytes_concat(b"?u", num(base_span.start)), span: base_span }),
    _ -> None,
  };
  let source = match bound { Some(b) -> EVar({ span: base_span, name: bare(b) }), None -> base };
  let copies = filter(names, |n: Bytes|
    !fold(written, false, |seen: Bool, w: RecField| seen || w.name.name == n));
  let copied = map(copies, |n: Bytes| {
    let field = { name: n, span: base_span };
    { name: field, value: EField({ span: base_span, base: source, field: field }) }
  });
  let literal = ERecord({ span: span, fields: append(copied, written) });
  match bound {
    Some(b) ->
      EBlock({
        span: span,
        tail: Some(literal),
        stmts: [
          SLet({ span: base_span, pat: PVar({ span: base_span, name: b }), ty: None, value: base }),
        ],
      }),
    None -> literal,
  }
}

fn ru_exprs(sh: Map<Bytes, List<Bytes>>, xs: List<Expr>) -> List<Expr> =
  map(xs, |x: Expr| ru_expr(sh, x))

fn ru_fields(sh: Map<Bytes, List<Bytes>>, fs: List<RecField>) -> List<RecField> =
  map(fs, |f: RecField| { name: f.name, value: ru_expr(sh, f.value) })

fn ru_opt(sh: Map<Bytes, List<Bytes>>, e: Option<Expr>) -> Option<Expr> =
  match e { None -> None, Some(x) -> Some(ru_expr(sh, x)) }

fn ru_stmt(sh: Map<Bytes, List<Bytes>>, s: Stmt) -> Stmt =
  match s {
    SLet(l) -> SLet({ span: l.span, pat: l.pat, ty: l.ty, value: ru_expr(sh, l.value) }),
    SLetElse(l) ->
      SLetElse({
        span: l.span,
        pat: l.pat,
        ty: l.ty,
        value: ru_expr(sh, l.value),
        fallback: ru_expr(sh, l.fallback),
      }),
    SExpr(x) -> SExpr(ru_expr(sh, x)),
  }

// Children first, then this node: a nested update inside a written field expands before its owner.
fn ru_expr(sh: Map<Bytes, List<Bytes>>, e: Expr) -> Expr =
  match e {
    EBinary(b) ->
      EBinary({ span: b.span, op: b.op, lhs: ru_expr(sh, b.lhs), rhs: ru_expr(sh, b.rhs) }),
    EUnary(u) -> EUnary({ span: u.span, op: u.op, operand: ru_expr(sh, u.operand) }),
    ELambda(l) ->
      ELambda({ span: l.span, body: ru_expr(sh, l.body), params: l.params, ret: l.ret }),
    EApp(a) ->
      EApp({
        span: a.span,
        func: ru_expr(sh, a.func),
        named: map(a.named, |n: NamedArg|
          { name: n.name, value: ru_expr(sh, n.value), span: n.span }),
        args: ru_exprs(sh, a.args),
        labels: a.labels,
      }),
    EIf(i) ->
      EIf({
        span: i.span,
        cond: ru_expr(sh, i.cond),
        then_branch: ru_expr(sh, i.then_branch),
        else_branch: ru_expr(sh, i.else_branch),
      }),
    EMatch(m) ->
      EMatch({
        span: m.span,
        scrutinee: ru_expr(sh, m.scrutinee),
        arms: map(m.arms, |arm: MatchArm|
          {
            pat: arm.pat,
            guard: ru_opt(sh, arm.guard),
            body: ru_expr(sh, arm.body),
            span: arm.span,
          }),
      }),
    EBlock(b) ->
      EBlock({
        span: b.span,
        tail: ru_opt(sh, b.tail),
        stmts: map(b.stmts, |st: Stmt| ru_stmt(sh, st)),
      }),
    ERecord(r) -> ERecord({ span: r.span, fields: ru_fields(sh, r.fields) }),
    ERecordUpdate(r) -> {
      let base = ru_expr(sh, r.base);
      let fs = ru_fields(sh, r.fields);
      // A span the table does not hold belongs to a program that did not check; the lowering declines it.
      match map_get(sh, span_key(r.span)) {
        None -> ERecordUpdate({ span: r.span, base: base, fields: fs }),
        Some(names) -> expand_update(r.span, base, fs, names),
      }
    },
    EField(f) -> EField({ span: f.span, base: ru_expr(sh, f.base), field: f.field }),
    ETry(t) -> ETry({ span: t.span, operand: ru_expr(sh, t.operand) }),
    EList(l) -> EList({ span: l.span, items: ru_exprs(sh, l.items) }),
    EPerform(p) ->
      EPerform({
        span: p.span,
        eff: p.eff,
        op: p.op,
        resource: p.resource,
        args: ru_exprs(sh, p.args),
      }),
    EHandle(h) ->
      EHandle({
        span: h.span,
        body: ru_expr(sh, h.body),
        ret: match h.ret {
          None -> None,
          Some(rc) -> Some({ binder: rc.binder, body: ru_expr(sh, rc.body), span: rc.span }),
        },
        clauses: map(h.clauses, |c: HandleClause|
          {
            eff: c.eff,
            op: c.op,
            resource: c.resource,
            every_label: c.every_label,
            label_binder: c.label_binder,
            resume: c.resume,
            body: ru_expr(sh, c.body),
            span: c.span,
            params: c.params,
          }),
      }),
    EWithCell(c) ->
      EWithCell({
        span: c.span,
        resource: c.resource,
        init: ru_expr(sh, c.init),
        binder: c.binder,
        body: ru_expr(sh, c.body),
      }),
    ESimulate(x) -> ESimulate({ span: x.span, body: ru_expr(sh, x.body) }),
    EParallel(x) -> EParallel({ span: x.span, branches: ru_exprs(sh, x.branches) }),
    _ -> e,
  }

fn ru_item(sh: Map<Bytes, List<Bytes>>, it: Item) -> Item =
  match it {
    IFn(d) ->
      IFn({
        vis: d.vis,
        name: d.name,
        generics: d.generics,
        params: d.params,
        ret: d.ret,
        effects: d.effects,
        constraints: d.constraints,
        spec: map(d.spec, |c: SpecClause|
          { kind: c.kind, expr: ru_expr(sh, c.expr), span: c.span }),
        returns: d.returns,
        reuse: d.reuse,
        transparent: d.transparent,
        body: ru_expr(sh, d.body),
        span: d.span,
      }),
    ITest(d) ->
      ITest({
        name: d.name,
        name_span: d.name_span,
        is_nondet: d.is_nondet,
        body: ru_expr(sh, d.body),
        span: d.span,
      }),
    ILaw(d) ->
      ILaw({
        name: d.name,
        name_span: d.name_span,
        host: d.host,
        binders: d.binders,
        guard: ru_opt(sh, d.guard),
        body: ru_expr(sh, d.body),
        span: d.span,
      }),
    _ -> it,
  }

// Every update of a checked module replaced by the literal it stands for.
pub fn expand_record_updates(m: Module, shapes: Map<Bytes, List<Bytes>>) -> Module =
  if !has_update(m) { m }
  else { { imports: m.imports, items: map(m.items, |it: Item| ru_item(shapes, it)) } }

// --- The try operator ------------------------------------------------------------------------

type TryMode = | MResult | MOption

// `shadowed` is the note for a module whose own `Ok`/`Err`/`Some`/`None` would capture the expansion.
type TryCx = {
  types: List<TypeDef>,
  shadowed: Option<Bytes>,
  diags: List<PDiag>,
  mode: Option<TryMode>,
  fresh: Int,
}

type Lift = { operand: Expr, binder: Ident, at: Span }
type Scan = | SFound(Lift) | SPure | SImpure
type Scanned = { cx: TryCx, s: Scan, e: Expr }
type TryOut = { cx: TryCx, e: Expr }

fn is_expansion_name(name: Bytes) -> Bool =
  name == b"Ok" || name == b"Err" || name == b"Some" || name == b"None"

fn shadowing_ctor(m: Module) -> Option<Bytes> = {
  let imported = fold(m.imports, None, |acc: Option<Bytes>, d: ImportDecl|
    match acc {
      Some(_) -> acc,
      None -> match d.kind {
        INames(ns) ->
          fold(ns, None, |b: Option<Bytes>, n: Ident|
            match b {
              Some(_) -> b,
              None -> if is_expansion_name(n.name) {
                Some(
                  bytes_concat_all([
                    b"this module imports `",
                    n.name,
                    b"` unqualified, which would capture the `match` `?` expands to; import the module instead and qualify the name, or write the `match` out",
                  ]),
                )
              } else { None },
            }),
        _ -> None,
      },
    });
  match imported {
    Some(_) -> imported,
    None ->
      fold(m.items, None, |acc: Option<Bytes>, it: Item|
        match acc {
          Some(_) -> acc,
          None -> match it {
            IType(d) -> match d.body {
              TDSum(vs) ->
                fold(vs, None, |b: Option<Bytes>, v: VariantDef|
                  match b {
                    Some(_) -> b,
                    None -> if is_expansion_name(v.name.name) {
                      Some(
                        bytes_concat_all([
                          b"this module declares its own `",
                          v.name.name,
                          b"`, which would capture the `match` `?` expands to; rename it, or write the `match` out",
                        ]),
                      )
                    } else { None },
                  }),
              _ -> None,
            },
            _ -> None,
          },
        }),
  }
}

fn unreadable() -> Bytes =
  b"the return type has no head constructor this file can read: a type parameter and a generic alias have none until they are applied"

fn not_result_or_option(head: Bytes) -> Bytes =
  bytes_concat_all([
    b"this function returns `",
    head,
    b"`; `?` binds a `Result` inside a function returning `Result`, or an `Option` inside one returning `Option`, because those are the constructors it expands to",
  ])

fn no_return_type() -> Bytes =
  b"this function writes no `->`, and `?` reads which constructors to name off the written return type; write one"

fn not_in_a_function(what: Bytes) -> Bytes =
  bytes_concat(what, b" has no written return type, and `?` needs one")

fn mode_of(cx: TryCx, t: TypeExpr, depth: Int) -> Result<TryMode, Bytes> =
  if depth > max_alias_depth() { Err(too_deep()) } else {
    match t {
      TCon(c) -> if !is_bare(c.name) {
        Err(
          b"the return type is named through another module, and `?` reads only this file \xe2\x80\x94 a meaning read across a module boundary would go stale in a file that never changed",
        )
      } else if c.name.name.name == b"Result" { Ok(MResult) }
      else if c.name.name.name == b"Option" { Ok(MOption) } else {
        let n = c.name.name.name;
        match find_type(cx.types, n) {
          None -> Err(not_result_or_option(n)),
          Some(d) -> if len(d.params) > 0 { Err(unreadable()) } else {
            match d.body {
              TDSum(_) -> Err(not_result_or_option(n)),
              TDAlias(inner) -> mode_of(cx, inner, depth + 1),
            }
          },
        }
      },
      _ -> Err(unreadable()),
    }
  }

fn mode_for(cx: TryCx, ret: Option<TypeExpr>) -> Result<TryMode, Bytes> =
  match cx.shadowed {
    Some(why) -> Err(why),
    None -> match ret { None -> Err(no_return_type()), Some(ty) -> mode_of(cx, ty, 0) },
  }

// The outermost barrier is the one named.
fn under(barrier: Option<Bytes>, what: Bytes) -> Option<Bytes> =
  match barrier { Some(_) -> barrier, None -> Some(what) }

fn fresh_binder(cx: TryCx, span: Span) -> { cx: TryCx, b: Ident } =
  {
    cx: { ..cx, fresh: cx.fresh + 1 },
    b: { name: bytes_concat(b"?", bytes_of_string(int_to_string(cx.fresh))), span: span },
  }

fn var_of(name: Ident) -> Expr = EVar({ span: name.span, name: bare(name) })

fn var_pattern(name: Ident) -> Pattern = PVar({ span: name.span, name: name })

fn ctor_pattern(name: Bytes, args: List<Pattern>, span: Span) -> Pattern =
  PCtor({ span: span, name: bare({ name: name, span: span }), args: args })

// `match operand { <failure>, <success>(pat) -> body }`, failure arm first.
fn wrap(cx: TryCx, operand: Expr, at_: Span, pat: Pattern, body: Expr) -> TryOut = {
  let mode = match cx.mode { Some(m) -> m, None -> panic("a mode is established before any lift") };
  match mode {
    MResult -> {
      let fb = fresh_binder(cx, at_);
      let fail_pat = ctor_pattern(b"Err", [var_pattern(fb.b)], at_);
      let fail_body = EApp({
        span: at_,
        func: var_of({ name: b"Err", span: at_ }),
        args: [var_of(fb.b)],
        named: [],
        labels: [],
      });
      {
        cx: fb.cx,
        e: EMatch({
          span: at_,
          scrutinee: operand,
          arms: [
            { pat: fail_pat, guard: None, body: fail_body, span: at_ },
            { pat: ctor_pattern(b"Ok", [pat], at_), guard: None, body: body, span: at_ },
          ],
        }),
      }
    },
    MOption -> {
      let fail_pat = ctor_pattern(b"None", [], at_);
      let fail_body = var_of({ name: b"None", span: at_ });
      {
        cx: cx,
        e: EMatch({
          span: at_,
          scrutinee: operand,
          arms: [
            { pat: fail_pat, guard: None, body: fail_body, span: at_ },
            { pat: ctor_pattern(b"Some", [pat], at_), guard: None, body: body, span: at_ },
          ],
        }),
      }
    },
  }
}

fn purity(pure: Bool) -> Scan = if pure { SPure } else { SImpure }

// Sub-expressions left to right, stopping at the first `?` and at the first impure one.
fn sequence(cx: TryCx, parts: List<Expr>) -> { cx: TryCx, s: Scan, xs: List<Expr> } =
  fold(
    parts,
    { cx: cx, s: SPure, xs: [] },
    |acc: { cx: TryCx, s: Scan, xs: List<Expr> }, p: Expr|
      match acc.s {
        SPure -> {
          let o = scan(acc.cx, p);
          { cx: o.cx, s: o.s, xs: push(acc.xs, o.e) }
        },
        _ -> { ..acc, xs: push(acc.xs, p) },
      },
  )

// Lifts the first `?` reachable in evaluation order, leaving its binder in its place.
fn scan(cx: TryCx, e: Expr) -> Scanned =
  match e {
    ELit(_) -> { cx: cx, s: SPure, e: e },
    EVar(_) -> { cx: cx, s: SPure, e: e },
    EBad(_) -> { cx: cx, s: SPure, e: e },
    ETry(t) -> {
      let inner = scan(cx, t.operand);
      match inner.s {
        SFound(_) -> { cx: inner.cx, s: inner.s, e: ETry({ span: t.span, operand: inner.e }) },
        _ -> {
          let fb = fresh_binder(inner.cx, t.span);
          { cx: fb.cx, s: SFound({ operand: inner.e, binder: fb.b, at: t.span }), e: var_of(fb.b) }
        },
      }
    },
    EBinary(b) -> {
      let short = b.op == b"and" || b.op == b"or";
      let l = scan(cx, b.lhs);
      match l.s {
        SFound(_) ->
          { cx: l.cx, s: l.s, e: EBinary({ span: b.span, op: b.op, lhs: l.e, rhs: b.rhs }) },
        SImpure -> { cx: l.cx, s: SImpure, e: e },
        SPure -> if short { { cx: l.cx, s: purity(is_pure(b.rhs)), e: e } } else {
          let r = scan(l.cx, b.rhs);
          { cx: r.cx, s: r.s, e: EBinary({ span: b.span, op: b.op, lhs: l.e, rhs: r.e }) }
        },
      }
    },
    EUnary(u) -> {
      let o = scan(cx, u.operand);
      { cx: o.cx, s: o.s, e: EUnary({ span: u.span, op: u.op, operand: o.e }) }
    },
    EApp(a) -> {
      let o = sequence(cx, append(append([a.func], a.args), map(a.named, |n: NamedArg| n.value)));
      let func = at(o.xs, 0);
      let args = take(drop(o.xs, 1), len(a.args));
      let nvals = drop(o.xs, 1 + len(a.args));
      let named = map(range(0, len(a.named)), |i: Int| {
        let n = at(a.named, i);
        { name: n.name, value: at(nvals, i), span: n.span }
      });
      let rebuilt = EApp({ span: a.span, func: func, named: named, args: args, labels: a.labels });
      match o.s {
        SFound(_) -> { cx: o.cx, s: o.s, e: rebuilt },
        _ -> { cx: o.cx, s: SImpure, e: rebuilt },
      }
    },
    EPerform(p) -> {
      let o = sequence(cx, p.args);
      let rebuilt = EPerform({
        span: p.span,
        eff: p.eff,
        op: p.op,
        resource: p.resource,
        args: o.xs,
      });
      match o.s {
        SFound(_) -> { cx: o.cx, s: o.s, e: rebuilt },
        _ -> { cx: o.cx, s: SImpure, e: rebuilt },
      }
    },
    ERecord(r) -> {
      let o = sequence(cx, map(r.fields, |f: RecField| f.value));
      {
        cx: o.cx,
        s: o.s,
        e: ERecord({
          span: r.span,
          fields: map(range(0, len(r.fields)), |i: Int|
            { name: at(r.fields, i).name, value: at(o.xs, i) }),
        }),
      }
    },
    EList(l) -> {
      let o = sequence(cx, l.items);
      { cx: o.cx, s: o.s, e: EList({ span: l.span, items: o.xs }) }
    },
    EField(f) -> {
      let o = scan(cx, f.base);
      { cx: o.cx, s: o.s, e: EField({ span: f.span, base: o.e, field: f.field }) }
    },
    ERecordUpdate(r) -> {
      let o = sequence(cx, append([r.base], map(r.fields, |f: RecField| f.value)));
      {
        cx: o.cx,
        s: o.s,
        e: ERecordUpdate({
          span: r.span,
          base: at(o.xs, 0),
          fields: map(range(0, len(r.fields)), |i: Int|
            { name: at(r.fields, i).name, value: at(o.xs, i + 1) }),
        }),
      }
    },
    EIf(i) -> {
      let c = scan(cx, i.cond);
      let rebuilt = EIf({
        span: i.span,
        cond: c.e,
        then_branch: i.then_branch,
        else_branch: i.else_branch,
      });
      match c.s {
        SFound(_) -> { cx: c.cx, s: c.s, e: rebuilt },
        SImpure -> { cx: c.cx, s: SImpure, e: rebuilt },
        SPure ->
          { cx: c.cx, s: purity(is_pure(i.then_branch) && is_pure(i.else_branch)), e: rebuilt },
      }
    },
    EMatch(m) -> {
      let sc = scan(cx, m.scrutinee);
      let rebuilt = EMatch({ span: m.span, scrutinee: sc.e, arms: m.arms });
      match sc.s {
        SFound(_) -> { cx: sc.cx, s: sc.s, e: rebuilt },
        SImpure -> { cx: sc.cx, s: SImpure, e: rebuilt },
        SPure ->
          {
            cx: sc.cx,
            s: purity(
              fold(m.arms, true, |acc: Bool, arm: MatchArm|
                acc && is_pure(arm.body)
                  && (match arm.guard { None -> true, Some(g) -> is_pure(g) })),
            ),
            e: rebuilt,
          },
      }
    },
    // A nested block is not entered; a lambda, handler, cell, region, `simulate` or `parallel` is a
    // barrier to `?`.
    _ -> { cx: cx, s: purity(is_pure(e)), e: e },
  }

// One `match` per `?` lifted from `e`'s head, with the rewritten `e` as the success arm's body.
fn region_cond(cx: TryCx, e: Expr) -> TryOut = {
  let found = scan_head(cx, e);
  match found.s {
    SFound(l) -> {
      let w = wrap(found.cx, l.operand, l.at, var_pattern(l.binder), found.e);
      match w.e {
        EMatch(m) -> {
          let success = at(m.arms, 1);
          let inner = region_cond(w.cx, success.body);
          {
            cx: inner.cx,
            e: EMatch({
              span: m.span,
              scrutinee: m.scrutinee,
              arms: [
                at(m.arms, 0),
                { pat: success.pat, guard: None, body: inner.e, span: success.span },
              ],
            }),
          }
        },
        _ -> w,
      }
    },
    _ -> { cx: found.cx, e: found.e },
  }
}

fn scan_head(cx: TryCx, e: Expr) -> Scanned =
  match e {
    EIf(i) -> {
      let c = scan(cx, i.cond);
      {
        cx: c.cx,
        s: c.s,
        e: EIf({ span: i.span, cond: c.e, then_branch: i.then_branch, else_branch: i.else_branch }),
      }
    },
    EMatch(m) -> {
      let sc = scan(cx, m.scrutinee);
      { cx: sc.cx, s: sc.s, e: EMatch({ span: m.span, scrutinee: sc.e, arms: m.arms }) }
    },
    _ -> scan(cx, e),
  }

// An expression in return position.
fn ret(cx: TryCx, e: Expr) -> TryOut =
  match e {
    EBlock(_) -> block(cx, e),
    EIf(i) -> {
      let t = ret(cx, i.then_branch);
      let el = ret(t.cx, i.else_branch);
      region_cond(el.cx, EIf({ span: i.span, cond: i.cond, then_branch: t.e, else_branch: el.e }))
    },
    EMatch(m) -> {
      let arms = fold(
        m.arms,
        { cx: cx, arms: [] },
        |acc: { cx: TryCx, arms: List<MatchArm> }, arm: MatchArm| {
          let b = ret(acc.cx, arm.body);
          {
            cx: b.cx,
            arms: push(acc.arms, { pat: arm.pat, guard: arm.guard, body: b.e, span: arm.span }),
          }
        },
      );
      region_cond(arms.cx, EMatch({ span: m.span, scrutinee: m.scrutinee, arms: arms.arms }))
    },
    _ -> region_cond(cx, e),
  }

// A block in return position: split at the first statement a `?` can be lifted from.
fn block(cx: TryCx, e: Expr) -> TryOut =
  match e {
    EBlock(b) -> {
      let split = fold(
        range(0, len(b.stmts)),
        { cx: cx, stmts: b.stmts, tail: b.tail, done: false },
        |acc: { cx: TryCx, stmts: List<Stmt>, tail: Option<Expr>, done: Bool }, i: Int|
          if acc.done { acc } else {
            let o = split_at(acc.cx, acc.stmts, acc.tail, i);
            match o.split {
              None -> { cx: o.cx, stmts: o.stmts, tail: acc.tail, done: false },
              Some(t) -> { cx: o.cx, stmts: take(o.stmts, i), tail: Some(t), done: true },
            }
          },
      );
      if split.done {
        { cx: split.cx, e: EBlock({ span: b.span, tail: split.tail, stmts: split.stmts }) }
      } else {
        match split.tail {
          None -> { cx: split.cx, e: EBlock({ span: b.span, tail: None, stmts: split.stmts }) },
          Some(t) -> {
            let o = ret(split.cx, t);
            { cx: o.cx, e: EBlock({ span: b.span, tail: Some(o.e), stmts: split.stmts }) }
          },
        }
      }
    },
    _ -> panic("only called on a block"),
  }

type Taken = {
  cx: TryCx,
  stmt: Stmt,
  take: Option<{ operand: Expr, at: Span, pat: Pattern, consumes: Bool }>,
}

fn split_at(
  cx: TryCx,
  stmts: List<Stmt>,
  tail: Option<Expr>,
  i: Int,
) -> { cx: TryCx, stmts: List<Stmt>, split: Option<Expr> } = {
  let st = at(stmts, i);
  let taken = take_stmt(cx, st);
  match taken.take {
    None -> { cx: taken.cx, stmts: set_at(stmts, i, taken.stmt), split: None },
    Some(t) -> {
      let kept = set_at(stmts, i, taken.stmt);
      let rest = drop(kept, if t.consumes { i + 1 } else { i });
      // A consumed statement goes: its binder is now the success arm's pattern.
      let body0 = EBlock({ span: t.at, tail: tail, stmts: rest });
      let body = block(taken.cx, body0);
      let w = wrap(body.cx, t.operand, t.at, t.pat, body.e);
      { cx: w.cx, stmts: kept, split: Some(w.e) }
    },
  }
}

fn take_stmt(cx: TryCx, st: Stmt) -> Taken =
  match st {
    // Never consumed, since its pattern is not the success arm's. Its `else` block is the block's
    // value, so it is a return position: expanded once, when no `?` is left in the initializer.
    SLetElse(l) -> match l.value {
      ETry(t) -> {
        let fb = fresh_binder(cx, t.span);
        let o = take_try(fb.cx, t.operand, t.span, var_pattern(fb.b));
        if o.take.consumes {
          {
            cx: o.cx,
            stmt: SLetElse({ ..l, value: var_of(fb.b) }),
            take: Some({
              operand: o.take.operand,
              at: o.take.at,
              pat: o.take.pat,
              consumes: false,
            }),
          }
        } else {
          {
            cx: o.cx,
            stmt: SLetElse({ ..l, value: ETry({ span: t.span, operand: o.operand_left }) }),
            take: Some(o.take),
          }
        }
      },
      _ -> {
        let o = scan(cx, l.value);
        match o.s {
          SFound(lift) ->
            {
              cx: o.cx,
              stmt: SLetElse({ ..l, value: o.e }),
              take: Some({
                operand: lift.operand,
                at: lift.at,
                pat: var_pattern(lift.binder),
                consumes: false,
              }),
            },
          _ -> {
            let f = ret(o.cx, l.fallback);
            { cx: f.cx, stmt: SLetElse({ ..l, fallback: f.e }), take: None }
          },
        }
      },
    },
    SLet(l) -> match l.value {
      ETry(t) -> match l.ty {
        // The annotation stays: the `let` now binds the success arm's binder.
        Some(_) -> {
          let fb = fresh_binder(cx, t.span);
          let o = take_try(fb.cx, t.operand, t.span, var_pattern(fb.b));
          if o.take.consumes {
            {
              cx: o.cx,
              stmt: SLet({ span: l.span, pat: l.pat, ty: l.ty, value: var_of(fb.b) }),
              take: Some({
                operand: o.take.operand,
                at: o.take.at,
                pat: o.take.pat,
                consumes: false,
              }),
            }
          } else {
            {
              cx: o.cx,
              stmt: SLet({
                span: l.span,
                pat: l.pat,
                ty: l.ty,
                value: ETry({ span: t.span, operand: o.operand_left }),
              }),
              take: Some(o.take),
            }
          }
        },
        None -> {
          let o = take_try(cx, t.operand, t.span, l.pat);
          {
            cx: o.cx,
            stmt: SLet({
              span: l.span,
              pat: l.pat,
              ty: None,
              value: ETry({ span: t.span, operand: o.operand_left }),
            }),
            take: Some(o.take),
          }
        },
      },
      _ -> {
        let o = scan(cx, l.value);
        match o.s {
          SFound(lift) ->
            {
              cx: o.cx,
              stmt: SLet({ span: l.span, pat: l.pat, ty: l.ty, value: o.e }),
              take: Some({
                operand: lift.operand,
                at: lift.at,
                pat: var_pattern(lift.binder),
                consumes: false,
              }),
            },
          _ -> { cx: o.cx, stmt: st, take: None },
        }
      },
    },
    SExpr(v) -> match v {
      ETry(t) -> {
        let o = take_try(cx, t.operand, t.span, PWild({ span: v_span(v) }));
        {
          cx: o.cx,
          stmt: SExpr(ETry({ span: t.span, operand: o.operand_left })),
          take: Some(o.take),
        }
      },
      _ -> {
        let o = scan(cx, v);
        match o.s {
          SFound(lift) ->
            {
              cx: o.cx,
              stmt: SExpr(o.e),
              take: Some({
                operand: lift.operand,
                at: lift.at,
                pat: var_pattern(lift.binder),
                consumes: false,
              }),
            },
          _ -> { cx: o.cx, stmt: st, take: None },
        }
      },
    },
  }

fn v_span(e: Expr) -> Span = expr_span(e)

type TryTaken = {
  cx: TryCx,
  operand_left: Expr,
  take: { operand: Expr, at: Span, pat: Pattern, consumes: Bool },
}

// An inner `?` in the operand is lifted first and the statement stays; otherwise the statement is consumed.
fn take_try(cx: TryCx, operand: Expr, span: Span, pat: Pattern) -> TryTaken = {
  let o = scan(cx, operand);
  match o.s {
    SFound(lift) ->
      {
        cx: o.cx,
        operand_left: o.e,
        take: {
          operand: lift.operand,
          at: lift.at,
          pat: var_pattern(lift.binder),
          consumes: false,
        },
      },
    _ ->
      {
        cx: o.cx,
        operand_left: ELit({ span: span, lit: LUnit }),
        take: { operand: o.e, at: span, pat: pat, consumes: true },
      },
  }
}

// Refuses and unwraps every `?` left in `e`: `E0118` when `scope` or `barrier` says why, else `E0119`.
fn sweep(cx: TryCx, e: Expr, scope: Option<Bytes>, barrier: Option<Bytes>) -> TryOut = {
  let refused = match e {
    ETry(t) -> {
      let d = match barrier {
        Some(what) ->
          diag1(
            b"E0118",
            t.span,
            b"this file gives `?` no meaning here",
            b"no `Result` or `Option` to expand this into",
            [
              bytes_concat_all([
                b"this `?` is inside ",
                what,
                b", which has no written return type of its own. `?` exits the expression it is written in and never a lambda, a handler or a region: name a function with a written `->` and call it",
              ]),
            ],
          ),
        None -> match scope {
          Some(why) ->
            diag1(
              b"E0118",
              t.span,
              b"this file gives `?` no meaning here",
              b"no `Result` or `Option` to expand this into",
              [why],
            ),
          None ->
            diag1(
              b"E0119",
              t.span,
              b"this `?` is not in a position it can be expanded from",
              b"`?` cannot exit from here",
              [
                b"`?` lifts what it unwraps to the head of the statement, or of the return position, it is written in \xe2\x80\x94 so nothing conditional may sit between the two, and everything evaluated before it must be pure. Bind it first: `let a = e?;`",
              ],
            ),
        },
      };
      { cx: { ..cx, diags: push(cx.diags, d) }, e: t.operand }
    },
    _ -> { cx: cx, e: e },
  };
  sweep_inner(refused.cx, refused.e, scope, barrier)
}

fn sweep_inner(cx: TryCx, e: Expr, scope: Option<Bytes>, barrier: Option<Bytes>) -> TryOut =
  match e {
    ETry(t) -> {
      let o = sweep(cx, t.operand, scope, barrier);
      { cx: o.cx, e: ETry({ span: t.span, operand: o.e }) }
    },
    EBinary(b) -> {
      let l = sweep(cx, b.lhs, scope, barrier);
      let r = sweep(l.cx, b.rhs, scope, barrier);
      { cx: r.cx, e: EBinary({ span: b.span, op: b.op, lhs: l.e, rhs: r.e }) }
    },
    EUnary(u) -> {
      let o = sweep(cx, u.operand, scope, barrier);
      { cx: o.cx, e: EUnary({ span: u.span, op: u.op, operand: o.e }) }
    },
    ELambda(l) -> match l.ret {
      None -> {
        let o = sweep(cx, l.body, scope, under(barrier, b"a lambda"));
        { cx: o.cx, e: ELambda({ span: l.span, body: o.e, params: l.params, ret: None }) }
      },
      Some(ty) -> match mode_for(cx, Some(ty)) {
        Err(why) -> {
          let o = sweep(cx, l.body, Some(why), None);
          { cx: o.cx, e: ELambda({ span: l.span, body: o.e, params: l.params, ret: Some(ty) }) }
        },
        Ok(m) -> {
          let saved = cx.mode;
          let r = ret({ ..cx, mode: Some(m) }, l.body);
          let s: TryOut = sweep(r.cx, r.e, None, None);
          {
            cx: { ..s.cx, mode: saved },
            e: ELambda({ span: l.span, body: s.e, params: l.params, ret: Some(ty) }),
          }
        },
      },
    },
    EApp(a) -> {
      let f = sweep(cx, a.func, scope, barrier);
      let args = sweep_all(f.cx, a.args, scope, barrier);
      let named = fold(
        a.named,
        { cx: args.cx, ns: [] },
        |acc: { cx: TryCx, ns: List<NamedArg> }, n: NamedArg| {
          let o = sweep(acc.cx, n.value, scope, barrier);
          { cx: o.cx, ns: push(acc.ns, { name: n.name, value: o.e, span: n.span }) }
        },
      );
      {
        cx: named.cx,
        e: EApp({ span: a.span, func: f.e, named: named.ns, args: args.xs, labels: a.labels }),
      }
    },
    EIf(i) -> {
      let c = sweep(cx, i.cond, scope, barrier);
      let t = sweep(c.cx, i.then_branch, scope, barrier);
      let el = sweep(t.cx, i.else_branch, scope, barrier);
      { cx: el.cx, e: EIf({ span: i.span, cond: c.e, then_branch: t.e, else_branch: el.e }) }
    },
    EMatch(m) -> {
      let sc = sweep(cx, m.scrutinee, scope, barrier);
      let arms = fold(
        m.arms,
        { cx: sc.cx, arms: [] },
        |acc: { cx: TryCx, arms: List<MatchArm> }, arm: MatchArm| {
          let g = match arm.guard {
            None -> { cx: acc.cx, e: None },
            Some(x) -> {
              let o = sweep(acc.cx, x, scope, barrier);
              { cx: o.cx, e: Some(o.e) }
            },
          };
          let b = sweep(g.cx, arm.body, scope, barrier);
          {
            cx: b.cx,
            arms: push(acc.arms, { pat: arm.pat, guard: g.e, body: b.e, span: arm.span }),
          }
        },
      );
      { cx: arms.cx, e: EMatch({ span: m.span, scrutinee: sc.e, arms: arms.arms }) }
    },
    EBlock(b) -> {
      let stmts = fold(
        b.stmts,
        { cx: cx, ss: [] },
        |acc: { cx: TryCx, ss: List<Stmt> }, st: Stmt|
          match st {
            SLet(l) -> {
              let o = sweep(acc.cx, l.value, scope, barrier);
              {
                cx: o.cx,
                ss: push(acc.ss, SLet({ span: l.span, pat: l.pat, ty: l.ty, value: o.e })),
              }
            },
            SLetElse(l) -> {
              let v = sweep(acc.cx, l.value, scope, barrier);
              let f = sweep(v.cx, l.fallback, scope, barrier);
              { cx: f.cx, ss: push(acc.ss, SLetElse({ ..l, value: v.e, fallback: f.e })) }
            },
            SExpr(x) -> {
              let o = sweep(acc.cx, x, scope, barrier);
              { cx: o.cx, ss: push(acc.ss, SExpr(o.e)) }
            },
          },
      );
      let tl = match b.tail {
        None -> { cx: stmts.cx, e: None },
        Some(t) -> {
          let o = sweep(stmts.cx, t, scope, barrier);
          { cx: o.cx, e: Some(o.e) }
        },
      };
      { cx: tl.cx, e: EBlock({ span: b.span, tail: tl.e, stmts: stmts.ss }) }
    },
    ERecord(r) -> {
      let o = sweep_fields(cx, r.fields, scope, barrier);
      { cx: o.cx, e: ERecord({ span: r.span, fields: o.fs }) }
    },
    ERecordUpdate(r) -> {
      let b = sweep(cx, r.base, scope, barrier);
      let o = sweep_fields(b.cx, r.fields, scope, barrier);
      { cx: o.cx, e: ERecordUpdate({ span: r.span, base: b.e, fields: o.fs }) }
    },
    EField(f) -> {
      let o = sweep(cx, f.base, scope, barrier);
      { cx: o.cx, e: EField({ span: f.span, base: o.e, field: f.field }) }
    },
    EList(l) -> {
      let o = sweep_all(cx, l.items, scope, barrier);
      { cx: o.cx, e: EList({ span: l.span, items: o.xs }) }
    },
    EPerform(p) -> {
      let o = sweep_all(cx, p.args, scope, barrier);
      {
        cx: o.cx,
        e: EPerform({ span: p.span, eff: p.eff, op: p.op, resource: p.resource, args: o.xs }),
      }
    },
    EHandle(h) -> {
      let b = sweep(cx, h.body, scope, under(barrier, b"a `handle` body"));
      let cs = fold(
        h.clauses,
        { cx: b.cx, cs: [] },
        |acc: { cx: TryCx, cs: List<HandleClause> }, c: HandleClause| {
          let o = sweep(acc.cx, c.body, scope, under(barrier, b"a `handle` clause"));
          {
            cx: o.cx,
            cs: push(acc.cs, {
              eff: c.eff,
              op: c.op,
              resource: c.resource,
              every_label: c.every_label,
              label_binder: c.label_binder,
              resume: c.resume,
              body: o.e,
              span: c.span,
              params: c.params,
            }),
          }
        },
      );
      let r = match h.ret {
        None -> { cx: cs.cx, r: None },
        Some(rc) -> {
          let o = sweep(cs.cx, rc.body, scope, under(barrier, b"a `handle` return clause"));
          { cx: o.cx, r: Some({ binder: rc.binder, body: o.e, span: rc.span }) }
        },
      };
      { cx: r.cx, e: EHandle({ span: h.span, body: b.e, ret: r.r, clauses: cs.cs }) }
    },
    EWithCell(c) -> {
      let i = sweep(cx, c.init, scope, barrier);
      let b = sweep(i.cx, c.body, scope, under(barrier, b"a `with_cell` body"));
      {
        cx: b.cx,
        e: EWithCell({
          span: c.span,
          resource: c.resource,
          init: i.e,
          binder: c.binder,
          body: b.e,
        }),
      }
    },
    ESimulate(x) -> {
      let o = sweep(cx, x.body, scope, under(barrier, b"a `simulate` body"));
      { cx: o.cx, e: ESimulate({ span: x.span, body: o.e }) }
    },
    EParallel(x) -> {
      let o = sweep_all(cx, x.branches, scope, under(barrier, b"a `parallel` branch"));
      { cx: o.cx, e: EParallel({ span: x.span, branches: o.xs }) }
    },
    _ -> { cx: cx, e: e },
  }

fn sweep_all(
  cx: TryCx,
  xs: List<Expr>,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
) -> { cx: TryCx, xs: List<Expr> } =
  fold(xs, { cx: cx, xs: [] }, |acc: { cx: TryCx, xs: List<Expr> }, x: Expr| {
    let o = sweep(acc.cx, x, scope, barrier);
    { cx: o.cx, xs: push(acc.xs, o.e) }
  })

fn sweep_fields(
  cx: TryCx,
  fs: List<RecField>,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
) -> { cx: TryCx, fs: List<RecField> } =
  fold(fs, { cx: cx, fs: [] }, |acc: { cx: TryCx, fs: List<RecField> }, f: RecField| {
    let o = sweep(acc.cx, f.value, scope, barrier);
    { cx: o.cx, fs: push(acc.fs, { name: f.name, value: o.e }) }
  })

fn try_item(cx0: TryCx, it: Item) -> { cx: TryCx, it: Item } = {
  let cx = { ..cx0, fresh: 0, mode: None };
  match it {
    IFn(d) -> {
      let spec: { cx: TryCx, xs: List<SpecClause> } = fold(
        d.spec,
        { cx: cx, xs: [] },
        |acc: { cx: TryCx, xs: List<SpecClause> }, c: SpecClause| {
          let what = match c.kind {
            SRequires -> b"a `requires` clause",
            SEnsures -> b"an `ensures` clause",
          };
          let o = sweep(acc.cx, c.expr, Some(not_in_a_function(what)), None);
          { cx: o.cx, xs: push(acc.xs, { kind: c.kind, expr: o.e, span: c.span }) }
        },
      );
      let body = match mode_for(cx, d.ret) {
        Err(why) -> sweep(spec.cx, d.body, Some(why), None),
        Ok(m) -> {
          let r = ret({ ..spec.cx, mode: Some(m) }, d.body);
          let s: TryOut = sweep(r.cx, r.e, None, None);
          { cx: { ..s.cx, mode: None }, e: s.e }
        },
      };
      {
        cx: body.cx,
        it: IFn({
          vis: d.vis,
          name: d.name,
          generics: d.generics,
          params: d.params,
          ret: d.ret,
          effects: d.effects,
          constraints: d.constraints,
          spec: spec.xs,
          returns: d.returns,
          reuse: d.reuse,
          transparent: d.transparent,
          body: body.e,
          span: d.span,
        }),
      }
    },
    ITest(d) -> {
      let o = sweep(cx, d.body, Some(not_in_a_function(b"a `test`")), None);
      {
        cx: o.cx,
        it: ITest({
          name: d.name,
          name_span: d.name_span,
          is_nondet: d.is_nondet,
          body: o.e,
          span: d.span,
        }),
      }
    },
    ILaw(d) -> {
      let why = not_in_a_function(b"a `law`");
      let g = match d.guard {
        None -> { cx: cx, e: None },
        Some(x) -> {
          let o = sweep(cx, x, Some(why), None);
          { cx: o.cx, e: Some(o.e) }
        },
      };
      let b = sweep(g.cx, d.body, Some(why), None);
      {
        cx: b.cx,
        it: ILaw({
          name: d.name,
          name_span: d.name_span,
          host: d.host,
          binders: d.binders,
          guard: g.e,
          body: b.e,
          span: d.span,
        }),
      }
    },
    _ -> { cx: cx, it: it },
  }
}

pub fn expand_try(m: Module, diags: List<PDiag>) -> { module: Module, diags: List<PDiag> } = {
  let start = {
    types: collect_types(m),
    shadowed: shadowing_ctor(m),
    diags: diags,
    mode: None,
    fresh: 0,
  };
  let walked = fold(
    m.items,
    { cx: start, items: [] },
    |acc: { cx: TryCx, items: List<Item> }, it: Item| {
      let o = try_item(acc.cx, it);
      { cx: o.cx, items: push(acc.items, o.it) }
    },
  );
  { module: { imports: m.imports, items: walked.items }, diags: walked.cx.diags }
}

// --- Running the rewrites --------------------------------------------------------------------

fn has_update(m: Module) -> Bool = any_expr(m, is_update)

fn is_update(e: Expr) -> Bool = match e { ERecordUpdate(_) -> true, _ -> false }

// Whether a definition writes a record update anywhere: its body, a clause, or a default.
pub fn fn_has_update(d: FnDef) -> Bool = any_expr({ imports: [], items: [IFn(d)] }, is_update)
fn has_try(m: Module) -> Bool = any_expr(m, |e: Expr| match e { ETry(_) -> true, _ -> false })

fn any_expr(m: Module, p: (Expr) -> Bool) -> Bool =
  fold(m.items, false, |acc: Bool, it: Item|
    acc
      || (match it {
        IFn(d) ->
          any_in(d.body, p) || fold(d.spec, false, |b: Bool, c: SpecClause| b || any_in(c.expr, p))
            || fold(d.params, false, |b: Bool, x: Param|
              b || (match x.default { None -> false, Some(v) -> any_in(v, p) })),
        ITest(d) -> any_in(d.body, p),
        ILaw(d) -> any_in(d.body, p) || (match d.guard { None -> false, Some(g) -> any_in(g, p) }),
        _ -> false,
      }))

fn any_in(e: Expr, p: (Expr) -> Bool) -> Bool =
  p(e)
    || (match e {
      EBinary(b) -> any_in(b.lhs, p) || any_in(b.rhs, p),
      EUnary(u) -> any_in(u.operand, p),
      ELambda(l) ->
        any_in(l.body, p)
          || fold(l.params, false, |b: Bool, x: Param|
            b || (match x.default { None -> false, Some(v) -> any_in(v, p) })),
      EApp(a) ->
        any_in(a.func, p) || fold(a.args, false, |b: Bool, x: Expr| b || any_in(x, p))
          || fold(a.named, false, |b: Bool, n: NamedArg| b || any_in(n.value, p)),
      EIf(i) -> any_in(i.cond, p) || any_in(i.then_branch, p) || any_in(i.else_branch, p),
      EMatch(m) ->
        any_in(m.scrutinee, p)
          || fold(m.arms, false, |b: Bool, arm: MatchArm|
            b || any_in(arm.body, p)
              || (match arm.guard { None -> false, Some(g) -> any_in(g, p) })),
      EBlock(b) ->
        fold(b.stmts, false, |acc: Bool, s: Stmt|
            acc
              || (match s {
                SLet(l) -> any_in(l.value, p),
                SLetElse(l) -> any_in(l.value, p) || any_in(l.fallback, p),
                SExpr(x) -> any_in(x, p),
              }))
          || (match b.tail { None -> false, Some(t) -> any_in(t, p) }),
      ERecord(r) -> fold(r.fields, false, |b: Bool, f: RecField| b || any_in(f.value, p)),
      ERecordUpdate(r) ->
        any_in(r.base, p) || fold(r.fields, false, |b: Bool, f: RecField| b || any_in(f.value, p)),
      ETry(t) -> any_in(t.operand, p),
      EField(f) -> any_in(f.base, p),
      EList(l) -> fold(l.items, false, |b: Bool, x: Expr| b || any_in(x, p)),
      EPerform(x) -> fold(x.args, false, |b: Bool, y: Expr| b || any_in(y, p)),
      EHandle(h) ->
        any_in(h.body, p)
          || fold(h.clauses, false, |b: Bool, c: HandleClause| b || any_in(c.body, p))
          || (match h.ret { None -> false, Some(rc) -> any_in(rc.body, p) }),
      EWithCell(c) -> any_in(c.init, p) || any_in(c.body, p),
      ESimulate(x) -> any_in(x.body, p),
      EParallel(x) -> fold(x.branches, false, |b: Bool, y: Expr| b || any_in(y, p)),
      _ -> false,
    })

// Only when the grammar met a `?`. A record update needs the checker's answer for its base, so
// `expand_record_updates` runs later, over a checked program.
pub fn expand(m: Module, diags: List<PDiag>) -> { module: Module, diags: List<PDiag> } =
  if has_try(m) { expand_try(m, diags) } else { { module: m, diags: diags } }

pub fn dump_expanded(src: Bytes) -> String = {
  let r = parse(src);
  let x = expand(r.node, r.p.diags);
  string_of_bytes(bytes_concat(dump_module(x.module), dump_diags(x.diags)))
}

// --- Tests ------------------------------------------------------------------

test "a `?` on a `let` splits the block at that statement, failure arm first" {
  assert_eq(
    dump_expanded(b"fn f(n: Int) -> Result<Int, Bytes> = { let x = g(n)?; Ok(x + 1) }"),
    "#0;#1;0:65:fn;%priv;?0;?0;?0;3:4:ident;@66;%gen;#0;#0;#0;#1;5:11:prm;5:6:ident;@6e;?1;8:11:tcon;8:11:qname;?0;8:11:ident;@496e74;#0;?0;?1;16:34:tcon;16:22:qname;?0;16:22:ident;@526573756c74;#2;23:26:tcon;23:26:qname;?0;23:26:ident;@496e74;#0;28:33:tcon;28:33:qname;?0;28:33:ident;@4279746573;#0;?0;#0;#0;37:65:eblk;#0;?1;47:52:emat;47:51:eapp;47:48:evar;47:48:qname;?0;47:48:ident;@67;#1;49:50:evar;49:50:qname;?0;49:50:ident;@6e;#0;#0;#2;47:52:arm;47:52:pctr;47:52:qname;?0;47:52:ident;@457272;#1;47:52:pvar;47:52:ident;@3f30;?0;47:52:eapp;47:52:evar;47:52:qname;?0;47:52:ident;@457272;#1;47:52:evar;47:52:qname;?0;47:52:ident;@3f30;#0;#0;47:52:arm;47:52:pctr;47:52:qname;?0;47:52:ident;@4f6b;#1;43:44:pvar;43:44:ident;@78;?0;47:52:eblk;#0;?1;54:63:eapp;54:56:evar;54:56:qname;?0;54:56:ident;@4f6b;#1;57:62:ebin;%add;57:58:evar;57:58:qname;?0;57:58:ident;@78;61:62:elit;%int;@31;#0;#0;#0;",
  )
}

test "a `?` inside a return-position expression lifts to its head, and an `Option` names `None`" {
  assert_eq(
    dump_expanded(b"fn f(n: Int) -> Option<Int> = Some(g(n)? + 1)"),
    "#0;#1;0:45:fn;%priv;?0;?0;?0;3:4:ident;@66;%gen;#0;#0;#0;#1;5:11:prm;5:6:ident;@6e;?1;8:11:tcon;8:11:qname;?0;8:11:ident;@496e74;#0;?0;?1;16:27:tcon;16:22:qname;?0;16:22:ident;@4f7074696f6e;#1;23:26:tcon;23:26:qname;?0;23:26:ident;@496e74;#0;?0;#0;#0;35:40:emat;35:39:eapp;35:36:evar;35:36:qname;?0;35:36:ident;@67;#1;37:38:evar;37:38:qname;?0;37:38:ident;@6e;#0;#0;#2;35:40:arm;35:40:pctr;35:40:qname;?0;35:40:ident;@4e6f6e65;#0;?0;35:40:evar;35:40:qname;?0;35:40:ident;@4e6f6e65;35:40:arm;35:40:pctr;35:40:qname;?0;35:40:ident;@536f6d65;#1;35:40:pvar;35:40:ident;@3f30;?0;30:45:eapp;30:34:evar;30:34:qname;?0;30:34:ident;@536f6d65;#1;35:44:ebin;%add;35:40:evar;35:40:qname;?0;35:40:ident;@3f30;43:44:elit;%int;@31;#0;#0;#0;",
  )
}

test "a `?` in a function with no written return type is refused and unwrapped" {
  assert_eq(
    dump_expanded(b"fn f(n: Int) = g(n)?"),
    "#0;#1;0:20:fn;%priv;?0;?0;?0;3:4:ident;@66;%gen;#0;#0;#0;#1;5:11:prm;5:6:ident;@6e;?1;8:11:tcon;8:11:qname;?0;8:11:ident;@496e74;#0;?0;?0;?0;#0;#0;15:19:eapp;15:16:evar;15:16:qname;?0;15:16:ident;@67;#1;17:18:evar;17:18:qname;?0;17:18:ident;@6e;#0;#0;#1;!E0118:15:20:1:1;=15:20:1;",
  )
}

test "a `?` on a `let` with a written type keeps the annotation" {
  let out = dump_expanded(
    b"fn f(n: Int) -> Result<Int, Bytes> = { let x: Int = g(n)?; Ok(x + 1) }",
  );
  assert(!string_contains(out, "!E0119"));
  assert(string_contains(out, "@3f30"))
}
