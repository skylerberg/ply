//! The rewrites over a parsed module: the try operator, run with the grammar; the record update
//! and the `try` block, which need the checker's answer (the base's fields, the raise answered) and
//! so run after the check; and the tagged literal, written out with those two.

import std.bin
import std.list
import parsing (Span, Ident, ParseDiag, Label, span_to, bare, span_key, error_at, error_at_and,
                parse_diag, parse_label, dump_diags, is_bare, positional, starts_upper,
                span_between)
import type_syntax (TypeExpr, TCon, TRecord, TBad, RowExpr, AtomExpr, Mode, MRead, MWrite, MBad,
                    nullary, is_generic)
import items (Module, Item, IFn, IType, IEffect, ITest, ILaw, ISchema, IDerive, IEffectSet, FnDef,
              TypeDef, TypeDefBody, TDAlias, TDSum, VariantDef, SpecClause, SRequires, SEnsures,
              SCost, SSpace, EffectSetDef, ImportDecl, ImportKind, INames, Binder, OpDef, EffectDef,
              TestDef, SchemaDef, schema_guard_name, parse, dump_module, TDNominal)
import exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock, ERecord,
              ERecordUpdate, ETry, EField, EList, EPerform, EHandle, EWithCell, EWithHold,
              ESimulate, EParallel, EBad, ETryBlock, Stmt, SLet, SLetElse, SExpr, Param, NamedArg,
              MatchArm, HandleClause, ReturnClause, RecField, expr_span, ETagged, Tagged,
              tagged_call, tagged_fill, Hole, with_hole_values, slotted, slot_args)
import patterns (Pattern, PWild, PVar, PLit, PCtor, PRecord, PList, PBad, Lit, LUnit, LInt, LStr)
import std.bytes (ascii_of_int)

// --- Shared ---------------------------------------------------------------------

fn max_alias_depth() -> Int = 16

/// This module's own `type` items; the first declaration of a name wins.
fn collect_types(module: Module) -> List<TypeDef> =
  module.items.fold([], |acc: List<TypeDef>, item: Item|
    match item {
      IType(d) -> match find_type(acc, d.name.name) { Some(_) -> acc, None -> acc.push(d) },
      _ -> acc,
    })

pub fn find_type(ts: List<TypeDef>, name: Bytes) -> Option<TypeDef> =
  ts.fold(None, |acc: Option<TypeDef>, type_def: TypeDef|
    match acc {
      Some(_) -> acc,
      None -> if type_def.name.name == name { Some(type_def) } else { None },
    })

/// Evaluates without calling or performing anything.
pub fn is_pure(e: Expr) -> Bool =
  match e {
    EApp(_) -> false,
    EPerform(_) -> false,
    EHandle(_) -> false,
    EWithCell(_) -> false,
    EWithHold(_) -> false,
    ESimulate(_) -> false,
    EParallel(v) -> v.branches.fold(true, |acc: Bool, x: Expr| acc && is_pure(x)),
    ETry(_) -> false,
    ETryBlock(_) -> false,
    ELit(_) -> true,
    ETagged(t) -> t.holes.len() == 0,
    EVar(_) -> true,
    EBad(_) -> true,
    EBinary(b) -> is_pure(b.lhs) && is_pure(b.rhs),
    EUnary(u) -> is_pure(u.operand),
    ELambda(l) -> is_pure(l.body),
    EIf(i) -> is_pure(i.cond) && is_pure(i.then_branch) && is_pure(i.else_branch),
    EMatch(m) ->
      is_pure(m.scrutinee)
        && m.arms.fold(true, |acc: Bool, arm: MatchArm|
          acc && is_pure(arm.body) && (match arm.guard { None -> true, Some(g) -> is_pure(g) })),
    EBlock(b) ->
      b.stmts.fold(true, |acc: Bool, stmt: Stmt|
          acc
            && (match stmt {
              SLet(l) -> is_pure(l.value),
              SLetElse(l) -> is_pure(l.value) && is_pure(l.fallback),
              SExpr(x) -> is_pure(x),
            }))
        && (match b.tail { None -> true, Some(t) -> is_pure(t) }),
    ERecord(r) -> r.fields.fold(true, |acc: Bool, f: RecField| acc && is_pure(f.value)),
    ERecordUpdate(r) ->
      is_pure(r.base) && r.fields.fold(true, |acc: Bool, f: RecField| acc && is_pure(f.value)),
    EField(f) -> is_pure(f.base),
    EList(l) -> l.items.fold(true, |acc: Bool, x: Expr| acc && is_pure(x)),
  }

// --- Record update -----------------------------------------------------------------------
// `{..b, f: e}` is the literal it stands for. The shape it copies is the checker's answer for the
// base, keyed by the update's span, so this runs after the check and not with the other rewrites.

fn too_deep() -> Bytes =
  Bytes::concat_all([b"more than ", ascii_of_int(max_alias_depth()), b" type aliases deep"])

/// The literal an update stands for: the base's other fields, in the record's own order, then the
/// written ones. A call is bound to a name first, so it runs once however many fields are copied.
fn expand_update(span: Span, base: Expr, written: List<RecField>, names: List<Bytes>) -> Expr = {
  let base_span = expr_span(base);
  let bound: Option<Ident> = match base {
    EApp(_) -> Some({ name: b"?u".concat(ascii_of_int(base_span.start)), span: base_span }),
    _ -> None,
  };
  let source = match bound { Some(b) -> EVar({ span: base_span, name: bare(b) }), None -> base };
  let copies = names.filter(|n: Bytes|
    !written.fold(false, |seen: Bool, w: RecField| seen || w.name.name == n));
  let copied = copies.map(|n: Bytes| {
    let field = { name: n, span: base_span };
    { name: field, value: EField({ span: base_span, base: source, field: field }) }
  });
  let literal = ERecord({ span: span, fields: copied.concat(written) });
  match bound {
    Some(b) ->
      EBlock({
        span: span,
        tail: Some(literal),
        stmts: [
          SLet({ span: base_span, pat: PVar({ span: base_span, name: b }), ty: None, value: base }),
        ],
      }),
    None -> literal,
  }
}

/// Children first, then the node through `f`: a nested update inside a written field expands
/// before its owner, and what `f` builds is not visited again.
pub fn map_expr(e: Expr, f: (Expr) -> Expr) -> Expr = {
  let go = |x: Expr| map_expr(x, f);
  let opt = |x: Option<Expr>| match x { None -> None, Some(y) -> Some(map_expr(y, f)) };
  let fields = |fs: List<RecField>| fs.map(|fl: RecField| { name: fl.name, value: go(fl.value) });
  f(match e {
    EBinary(b) -> EBinary({ span: b.span, op: b.op, lhs: go(b.lhs), rhs: go(b.rhs) }),
    EUnary(u) -> EUnary({ span: u.span, op: u.op, operand: go(u.operand) }),
    ELambda(l) -> ELambda({ span: l.span, body: go(l.body), params: l.params, ret: l.ret }),
    EApp(a) ->
      EApp({
        span: a.span,
        func: go(a.func),
        named: a.named.map(|arg: NamedArg|
          { name: arg.name, value: go(arg.value), span: arg.span }),
        args: a.args.map(go),
        labels: a.labels,
      }),
    EIf(i) ->
      EIf({
        span: i.span,
        cond: go(i.cond),
        then_branch: go(i.then_branch),
        else_branch: go(i.else_branch),
      }),
    EMatch(m) ->
      EMatch({
        span: m.span,
        scrutinee: go(m.scrutinee),
        arms: m.arms.map(|arm: MatchArm|
          { pat: arm.pat, guard: opt(arm.guard), body: go(arm.body), span: arm.span }),
      }),
    EBlock(b) ->
      EBlock({
        span: b.span,
        tail: opt(b.tail),
        stmts: b.stmts.map(|stmt: Stmt|
          match stmt {
            SLet(l) -> SLet({ span: l.span, pat: l.pat, ty: l.ty, value: go(l.value) }),
            SLetElse(l) ->
              SLetElse({
                span: l.span,
                pat: l.pat,
                ty: l.ty,
                value: go(l.value),
                fallback: go(l.fallback),
              }),
            SExpr(x) -> SExpr(go(x)),
          }),
      }),
    ERecord(r) -> ERecord({ span: r.span, fields: fields(r.fields) }),
    ERecordUpdate(r) -> ERecordUpdate({ span: r.span, base: go(r.base), fields: fields(r.fields) }),
    EField(fl) -> EField({ span: fl.span, base: go(fl.base), field: fl.field }),
    ETry(t) -> ETry({ span: t.span, operand: go(t.operand) }),
    EList(l) -> EList({ span: l.span, items: l.items.map(go) }),
    EPerform(x) ->
      EPerform({ span: x.span, eff: x.eff, op: x.op, resource: x.resource, args: x.args.map(go) }),
    EHandle(h) ->
      EHandle({
        span: h.span,
        body: go(h.body),
        ret: match h.ret {
          None -> None,
          Some(rc) -> Some({ binder: rc.binder, body: go(rc.body), span: rc.span }),
        },
        clauses: h.clauses.map(|c: HandleClause|
          {
            eff: c.eff,
            op: c.op,
            resource: c.resource,
            every_label: c.every_label,
            label_binder: c.label_binder,
            resume: c.resume,
            body: go(c.body),
            span: c.span,
            params: c.params,
          }),
      }),
    EWithCell(c) ->
      EWithCell({
        span: c.span,
        resource: c.resource,
        init: go(c.init),
        binder: c.binder,
        body: go(c.body),
      }),
    EWithHold(c) ->
      EWithHold({ ..c, acquire: go(c.acquire), release: go(c.release), body: go(c.body) }),
    ESimulate(x) -> ESimulate({ span: x.span, body: go(x.body) }),
    EParallel(x) -> EParallel({ span: x.span, branches: x.branches.map(go) }),
    ETryBlock(t) -> ETryBlock({ ..t, body: go(t.body) }),
    ETagged(t) -> ETagged({ ..t, holes: t.holes.map(|h: Hole| { ..h, value: go(h.value) }) }),
    _ -> e,
  })
}

/// Every expression an item holds, through `map_expr`.
pub fn map_item(item: Item, f: (Expr) -> Expr) -> Item = {
  let go = |x: Expr| map_expr(x, f);
  match item {
    IFn(d) ->
      IFn({
        ..d,
        params: d.params.map(|param: Param|
          { ..param, default: match param.default { None -> None, Some(x) -> Some(go(x)) } }),
        spec: d.spec.map(|clause: SpecClause|
          { kind: clause.kind, expr: go(clause.expr), span: clause.span }),
        body: go(d.body),
      }),
    ITest(d) ->
      ITest({
        ..d,
        cases: match d.cases {
          None -> None,
          Some(c) -> Some({ ..c, table: go(c.table), label: go(c.label) }),
        },
        body: go(d.body),
      }),
    ILaw(d) ->
      ILaw({
        ..d,
        guard: match d.guard { None -> None, Some(g) -> Some(go(g)) },
        body: go(d.body),
      }),
    _ -> item,
  }
}

/// A span the table does not hold belongs to a program that did not check; the lowering declines it.
fn expanded_update(sh: Map<Bytes, List<Bytes>>, expr: Expr) -> Expr =
  match expr {
    ERecordUpdate(r) -> match sh.get(span_key(r.span)) {
      None -> expr,
      Some(names) -> expand_update(r.span, r.base, r.fields, names),
    },
    _ -> expr,
  }

/// Every update of a checked module replaced by the literal it stands for.
pub fn expand_record_updates(module: Module, shapes: Map<Bytes, List<Bytes>>) -> Module =
  if !has_update(module) { module } else {
    {
      ..module,
      items: module.items.map(|item: Item|
        map_item(item, |expr: Expr| expanded_update(shapes, expr))),
    }
  }

// --- Calls on values --------------------------------------------------------------------------
// `e.name(args)` that the checker resolved to a function of the type of `e` runs as the call of
// that function with `e` first, which is all hashing and lowering see of it.

/// The function a call on a value calls: `qualifier::name`, or the bare `name` where `qualifier`
/// is empty; its parameters' `names`, and the `defaults` a call that leaves one out copies.
pub type MemberCallee = {
  qualifier: Bytes,
  name: Bytes,
  names: List<Bytes>,
  defaults: List<Option<Expr>>,
}

/// The arguments the call of `m` on `on` passes, `args` and then `named` put where its
/// parameters are; as written where the checker refused the call.
fn member_passed(m: MemberCallee, on: Expr, args: List<Expr>, named: List<NamedArg>) -> List<Expr> = {
  let written = [on].concat(args);
  if written.len() > m.names.len() { written } else {
    let s = slotted(m.names, m.defaults, written, named);
    if s.missing.len() > 0 { written } else { slot_args(s.slots, written, named) }
  }
}

fn member_var(m: MemberCallee, span: Span) -> Expr =
  EVar({
    span: span,
    name: {
      module: if m.qualifier.len() == 0 { None } else { Some({ name: m.qualifier, span: span }) },
      name: { name: m.name, span: span },
      span: span,
    },
  })

fn member_called(sites: Map<Bytes, MemberCallee>, expr: Expr) -> Expr =
  match expr {
    // A name written through its type. One the parser made (`?show::display` over a hole) can
    // stand at the span of the call it wraps.
    EVar(v) -> match v.name.module {
      None -> expr,
      Some(of) -> if !starts_upper(of.name) { expr } else {
        match sites.get(span_key(v.name.span)) {
          Some(m) -> if m.name.len() == 0 { expr } else { member_var(m, v.span) },
          None -> expr,
        }
      },
    },
    EApp(a) -> match a.func {
      EField(f) -> match sites.get(span_key(a.span)) {
        Some(m) -> if m.name.len() == 0 { expr } else {
          EApp({
            span: a.span,
            func: member_var(m, f.field.span),
            named: [],
            args: member_passed(m, f.base, a.args, a.named),
            labels: a.labels,
          })
        },
        None -> expr,
      },
      _ -> expr,
    },
    EPerform(p) -> match sites.get(span_key(p.span)) {
      Some(m) -> {
        let on = EVar({ span: p.eff.span, name: p.eff });
        let labels = match p.resource { Some(r) -> [r], None -> [] };
        // With no name it is the call of what the binding holds in its field.
        if m.name.len() == 0 {
          EApp({
            span: p.span,
            func: EField({ span: span_to(p.eff.span, p.op.span), base: on, field: p.op }),
            named: [],
            args: p.args,
            labels: labels,
          })
        } else {
          EApp({
            span: p.span,
            func: member_var(m, p.op.span),
            named: [],
            args: member_passed(m, on, p.args, []),
            labels: labels,
          })
        }
      },
      None -> expr,
    },
    _ -> expr,
  }

/// `def` with each call on a value in `sites`, by span, written as the call it is.
pub fn with_member_calls(def: FnDef, sites: Map<Bytes, MemberCallee>) -> FnDef =
  if sites.len() == 0 { def } else {
    match map_item(IFn(def), |expr: Expr| member_called(sites, expr)) { IFn(d) -> d, _ -> def }
  }

/// `module` with each call on a value in `sites`, by span, written as the call of the function
/// of the value's type it is.
pub fn expand_member_calls(module: Module, sites: Map<Bytes, MemberCallee>) -> Module =
  if sites.len() == 0 { module } else {
    {
      ..module,
      items: module.items.map(|item: Item| map_item(item, |expr: Expr| member_called(sites, expr))),
    }
  }

// --- Tagged literals -----------------------------------------------------------------------
// `tag"text"` runs as its call read through `Ok`, which the check that ran the call saw it answer;
// one with holes hands what it read, and the holes, to its tag's `fill`.

fn settled(expr: Expr) -> Expr =
  match expr {
    ETagged(t) -> {
      let held = { name: b"?literal", span: t.span };
      EBlock({
        span: t.span,
        tail: Some(if t.holes.len() == 0 { var_of(held) } else { tagged_fill(t, var_of(held)) }),
        stmts: [
          SLet({
            span: t.span,
            pat: ctor_pattern(b"Ok", [var_pattern(held)], t.span),
            ty: None,
            value: tagged_call(t),
          }),
        ],
      })
    },
    _ -> expr,
  }

fn is_tagged(expr: Expr) -> Bool = match expr { ETagged(_) -> true, _ -> false }

pub fn has_tagged(module: Module) -> Bool = picked_in(module, is_tagged).len() > 0

/// Every tagged literal a module's definitions, tests and laws hold, in the order they are written.
pub fn tagged_in(module: Module) -> List<Tagged> =
  picked_in(module, is_tagged).fold([], |acc: List<Tagged>, e: Expr|
    match e { ETagged(t) -> acc.push(t), _ -> acc })

/// Every expression `wanted` picks among those a module's definitions, tests and laws hold, in the
/// order they are written, one that holds another before it.
pub fn picked_in(module: Module, wanted: (Expr) -> Bool) -> List<Expr> =
  module.items.fold([], |acc: List<Expr>, item: Item|
    match item {
      IFn(d) ->
        d.spec.fold(picked(d.body, wanted, acc), |out: List<Expr>, clause: SpecClause|
          picked(clause.expr, wanted, out)),
      // Over cases, the label and the table are written before the body.
      ITest(d) ->
        picked(d.body, wanted, match d.cases {
          None -> acc,
          Some(c) -> picked(c.table, wanted, picked(c.label, wanted, acc)),
        }),
      // An instantiation's guard is given what its body is, which is picked once, in the body.
      ILaw(d) -> {
        let guarded = match ((d.guard, d.of)) {
          (Some(g), None) -> picked(g, wanted, acc),
          _ -> acc,
        };
        picked(d.body, wanted, guarded)
      },
      _ -> acc,
    })

fn picked(e: Expr, wanted: (Expr) -> Bool, found: List<Expr>) -> List<Expr> = {
  let out = if wanted(e) { found.push(e) } else { found };
  let all = |es: List<Expr>, acc: List<Expr>|
    es.fold(acc, |a: List<Expr>, x: Expr| picked(x, wanted, a));
  let maybe = |o: Option<Expr>, acc: List<Expr>|
    match o { None -> acc, Some(x) -> picked(x, wanted, acc) };
  let fields = |fs: List<RecField>, acc: List<Expr>|
    fs.fold(acc, |a: List<Expr>, f: RecField| picked(f.value, wanted, a));
  match e {
    EBinary(b) -> picked(b.rhs, wanted, picked(b.lhs, wanted, out)),
    EUnary(u) -> picked(u.operand, wanted, out),
    ELambda(l) -> picked(l.body, wanted, out),
    EApp(a) ->
      a.named.fold(all(a.args, picked(a.func, wanted, out)), |acc: List<Expr>, arg: NamedArg|
        picked(arg.value, wanted, acc)),
    EIf(i) ->
      picked(i.else_branch, wanted, picked(i.then_branch, wanted, picked(i.cond, wanted, out))),
    EMatch(m) ->
      m.arms.fold(picked(m.scrutinee, wanted, out), |acc: List<Expr>, arm: MatchArm|
        picked(arm.body, wanted, maybe(arm.guard, acc))),
    EBlock(b) ->
      maybe(
        b.tail,
        b.stmts.fold(out, |acc: List<Expr>, stmt: Stmt|
          match stmt {
            SLet(l) -> picked(l.value, wanted, acc),
            SLetElse(l) -> picked(l.fallback, wanted, picked(l.value, wanted, acc)),
            SExpr(x) -> picked(x, wanted, acc),
          }),
      ),
    ERecord(r) -> fields(r.fields, out),
    ERecordUpdate(r) -> fields(r.fields, picked(r.base, wanted, out)),
    ETry(t) -> picked(t.operand, wanted, out),
    EField(f) -> picked(f.base, wanted, out),
    EList(l) -> all(l.items, out),
    EPerform(x) -> all(x.args, out),
    EHandle(h) -> {
      let clauses = h.clauses.fold(
        picked(h.body, wanted, out),
        |acc: List<Expr>, c: HandleClause| picked(c.body, wanted, acc),
      );
      match h.ret { None -> clauses, Some(rc) -> picked(rc.body, wanted, clauses) }
    },
    EWithCell(c) -> picked(c.body, wanted, picked(c.init, wanted, out)),
    EWithHold(c) ->
      picked(c.body, wanted, picked(c.release, wanted, picked(c.acquire, wanted, out))),
    ESimulate(x) -> picked(x.body, wanted, out),
    EParallel(x) -> all(x.branches, out),
    ETryBlock(t) -> picked(t.body, wanted, out),
    ETagged(t) -> t.holes.fold(out, |acc: List<Expr>, h: Hole| picked(h.value, wanted, acc)),
    ELit(_) -> out,
    EVar(_) -> out,
    EBad(_) -> out,
  }
}

/// Every tagged literal of a checked module replaced by what it runs as.
pub fn expand_tagged(module: Module) -> Module =
  if !has_tagged(module) { module }
  else { { ..module, items: module.items.map(|item: Item| map_item(item, settled)) } }

// --- Witnesses -----------------------------------------------------------------------------
// A definition with `numeric(a)` or `integer(a)` takes, ahead of its written parameters, an `Int`
// per such parameter naming the type a call instantiates it at, in the order the checker gives.
// Its operators over the parameter read that witness, and every call of it passes one: a type's
// number, or the caller's own.

/// `StatedWitness` holds a constructor of a type that states its own arithmetic, by the name the
/// program has it under.
pub type NumericWitness = | ConcreteWitness(Bytes) | ParamWitness(Bytes) | StatedWitness(Bytes)

derive bin for NumericWitness

/// No source can spell it, so it never collides with a binder the program wrote.
pub fn witness_param(param: Bytes) -> Bytes = b"?w_".concat(param)

/// The runtime's numbering: its ten widths in order, then `Int`, `Float` and `Decimal`.
pub fn witness_code(name: Bytes) -> Int =
  match range(0, 13).fold(None, |acc: Option<Int>, i: Int|
      match acc {
        Some(_) -> acc,
        None -> match [
            b"U8",
            b"U16",
            b"U32",
            b"U64",
            b"I8",
            b"I16",
            b"I32",
            b"I64",
            b"U128",
            b"I128",
            b"Int",
            b"Float",
            b"Decimal",
          ].at(
            i,
          ) {
          Some(n) -> if n == name { Some(i) } else { None },
          None -> None,
        },
      }) {
    Some(i) -> i,
    None -> 10,
  }

fn witness_expr(w: NumericWitness, span: Span) -> Expr =
  match w {
    ConcreteWitness(n) -> ELit({ span: span, lit: LInt(witness_code(n)) }),
    ParamWitness(p) -> EVar({ span: span, name: bare({ name: witness_param(p), span: span }) }),
    StatedWitness(ctor) ->
      hidden_call(span, stated_witness_name(), [ELit({ span: span, lit: LStr(ctor) })]),
  }

/// What the elaboration calls for the witness of a type that states its own arithmetic; the
/// emitter writes it, and no runtime holds it.
pub fn stated_witness_name() -> Bytes = b"?stated_witness"

/// The binary operators a witnessed parameter takes, in the runtime's numbering of them.
fn numeric_ops_numbered() -> List<Bytes> =
  [
    b"add",
    b"sub",
    b"mul",
    b"div",
    b"rem",
    b"lt",
    b"le",
    b"gt",
    b"ge",
    b"bitand",
    b"bitor",
    b"bitxor",
    b"shl",
    b"shr",
    b"ushr",
  ]

/// The runtime's numbering of the operators a witnessed parameter takes; `-` and `~` are 0 and 1.
fn numeric_op_code(op: Bytes) -> Int = {
  let ops = numeric_ops_numbered();
  range(0, ops.len()).fold(0 - 1, |acc: Int, i: Int|
    if acc >= 0 { acc } else if ops.at(i) == Some(op) { i } else { acc })
}

/// The expression a witnessed operator was elaborated from where its witness is a parameter of the
/// type `concrete` says it is at, or `e` itself: the elaboration undone where the type is known.
pub fn unwitnessed(e: Expr, concrete: (Bytes) -> Bool) -> Expr =
  match e {
    EApp(a) -> match a.func {
      EVar(v) -> if v.name.name.name == b"?numeric_binary" {
        match a.args {
          [ELit(code), EVar(w), lhs, rhs] -> match code.lit {
            LInt(k) -> match numeric_ops_numbered().at(k) {
              Some(op) -> if concrete(w.name.name.name) {
                EBinary({ span: a.span, op: op, lhs: lhs, rhs: rhs })
              } else { e },
              None -> e,
            },
            _ -> e,
          },
          _ -> e,
        }
      } else if v.name.name.name == b"?numeric_unary" {
        match a.args {
          [ELit(code), EVar(w), operand] -> match code.lit {
            LInt(k) -> if concrete(w.name.name.name) {
              EUnary({
                span: a.span,
                op: if k == 1 { b"bitnot" } else { b"neg" },
                operand: operand,
              })
            } else { e },
            _ -> e,
          },
          _ -> e,
        }
      } else { e },
      _ -> e,
    },
    _ -> e,
  }

fn hidden_call(span: Span, name: Bytes, args: List<Expr>) -> Expr =
  EApp({
    span: span,
    func: EVar({ span: span, name: bare({ name: name, span: span }) }),
    named: [],
    args: args,
    labels: [],
  })

fn witnessed(ops: Map<Bytes, Bytes>, refs: Map<Bytes, List<NumericWitness>>, e: Expr) -> Expr =
  match e {
    EBinary(b) -> match ops.get(span_key(b.span)) {
      Some(p) -> if b.op == b"eq" || b.op == b"ne" { e } else {
        hidden_call(b.span, b"?numeric_binary", [
          ELit({ span: b.span, lit: LInt(numeric_op_code(b.op)) }),
          witness_expr(ParamWitness(p), b.span),
          b.lhs,
          b.rhs,
        ])
      },
      None -> e,
    },
    EUnary(u) -> match ops.get(span_key(u.span)) {
      Some(p) ->
        hidden_call(u.span, b"?numeric_unary", [
          ELit({ span: u.span, lit: LInt(if u.op == b"bitnot" { 1 } else { 0 }) }),
          witness_expr(ParamWitness(p), u.span),
          u.operand,
        ]),
      None -> e,
    },
    EApp(a) -> match a.func {
      EVar(v) -> match refs.get(span_key(v.span)) {
        Some(ws) ->
          EApp({
            ..a,
            args: a.args.fold(
              ws.map(|w: NumericWitness| witness_expr(w, v.span)),
              |acc: List<Expr>, x: Expr| acc.push(x),
            ),
          }),
        None -> e,
      },
      _ -> e,
    },
    _ -> e,
  }

fn witness_params(orders: Map<Bytes, List<Bytes>>, item: Item) -> Item =
  match item {
    IFn(d) -> match orders.get(d.name.name) {
      None -> item,
      Some(ws) ->
        IFn({
          ..d,
          params: d.params.fold(
            ws.map(|w: Bytes|
              {
                name: { name: witness_param(w), span: d.name.span },
                ty: Some(nullary(bare({ name: b"Int", span: d.name.span }))),
                cost: None,
                default: None,
                span: d.name.span,
              }),
            |acc: List<Param>, param: Param| acc.push(param),
          ),
        }),
    },
    _ -> item,
  }

/// `orders` holds each witnessed definition's parameters by simple name, as the checker ordered them.
pub fn expand_witnesses(
  module: Module,
  ops: Map<Bytes, Bytes>,
  refs: Map<Bytes, List<NumericWitness>>,
  orders: Map<Bytes, List<Bytes>>,
) -> Module =
  if ops.len() == 0 && refs.len() == 0 && orders.len() == 0 { module } else {
    {
      ..module,
      items: module.items.map(|item: Item|
        witness_params(orders, map_item(item, |expr: Expr| witnessed(ops, refs, expr)))),
    }
  }

// --- The try block ---------------------------------------------------------------------------
// `try { body }` is the `handle` whose one clause answers `Err` of what the raise carried and whose
// `return` answers `Ok`. Which raise is the checker's to say: a `try` that names none reads it off
// its body's row, and the module writing it may have no name for that effect.

/// A raise by its effect's program-wide name, and how many values it carries.
pub type Answered = { effect: Bytes, op: Bytes, arity: Int }

/// An effect's program-wide name as a clause the lowering writes names it. No source can spell it,
/// so it names the effect the same in every module.
pub fn program_wide(name: Bytes) -> Bytes = b"?".concat(name)

/// The effect a clause names program-wide, for a name `program_wide` wrote; `None` for any other.
pub fn named_program_wide(written: Bytes) -> Option<Bytes> / {abort.raise} =
  if written.starts_with(b"?") { Some(written.slice(1, written.len())) } else { None }

fn carried(binders: List<Ident>, span: Span) -> Expr =
  match binders {
    [] -> ELit({ span: span, lit: LUnit }),
    [one] -> var_of(one),
    _ ->
      ERecord({
        span: span,
        fields: range(0, binders.len()).map(|i: Int|
          match binders.at(i) {
            Some(b) -> { name: positional(i, span), value: var_of(b) },
            None -> { name: positional(i, span), value: ELit({ span: span, lit: LUnit }) },
          }),
      }),
  }

fn answer(ctor: Bytes, value: Expr, span: Span) -> Expr =
  EApp({
    span: span,
    func: var_of({ name: ctor, span: span }),
    named: [],
    args: [value],
    labels: [],
  })

/// A span the table does not hold belongs to a program that did not check; the lowering declines it.
fn expanded_try(answered: Map<Bytes, Answered>, expr: Expr) -> Expr =
  match expr {
    ETryBlock(t) -> match answered.get(span_key(t.span)) {
      None -> expr,
      Some(a) -> {
        let binders = range(0, a.arity).map(|i: Int|
          { name: b"?r".concat(ascii_of_int(i)), span: t.span });
        let returned = { name: b"?v", span: t.span };
        EHandle({
          span: t.span,
          body: t.body,
          ret: Some({
            binder: returned,
            body: answer(b"Ok", var_of(returned), t.span),
            span: t.span,
          }),
          clauses: [
            {
              eff: bare({ name: program_wide(a.effect), span: t.span }),
              op: { name: a.op, span: t.span },
              resource: None,
              every_label: false,
              label_binder: None,
              resume: None,
              body: answer(b"Err", carried(binders, t.span), t.span),
              span: t.span,
              params: binders,
            },
          ],
        })
      },
    },
    _ -> expr,
  }

fn is_try_block(expr: Expr) -> Bool = match expr { ETryBlock(_) -> true, _ -> false }

/// Every `try` of a checked module replaced by the `handle` it stands for.
pub fn expand_try_blocks(module: Module, answered: Map<Bytes, Answered>) -> Module =
  if !any_expr(module, is_try_block) { module } else {
    {
      ..module,
      items: module.items.map(|item: Item|
        map_item(item, |expr: Expr| expanded_try(answered, expr))),
    }
  }

// --- The hold --------------------------------------------------------------------------------
// `with_hold[r](acquire, release) { h -> body }` is a cell of region `r` around a bracket: the
// bracket's acquire runs `acquire` and puts what it answered into the cell, so a cancel takes no
// answer from it, and its release takes that out of the cell and hands it to `release`. The
// builtins it calls have names no source can spell, so no module rebinds them.

fn unwritten_param(name: Bytes, span: Span) -> Param =
  { name: { name: name, span: span }, ty: None, cost: None, default: None, span: span }

fn applied_to(func: Expr, arg: Expr, span: Span) -> Expr =
  EApp({ span: span, func: func, named: [], args: [arg], labels: [] })

fn expanded_hold(expr: Expr) -> Expr =
  match expr {
    EWithHold(h) -> {
      let held = { name: b"?held", span: h.span };
      let acquire = { name: b"?acquire", span: h.span };
      let release = { name: b"?release", span: h.span };
      let thunk = |body: Expr| ELambda({ span: h.span, body: body, params: [], ret: None });
      let over_held = |body: Expr|
        ELambda({
          span: h.span,
          body: body,
          params: [unwritten_param(held.name, h.span)],
          ret: None,
        });
      let bound = |name: Ident, value: Expr|
        SLet({ span: h.span, pat: var_pattern(name), ty: None, value: value });
      let acquired = EApp({ span: h.span, func: var_of(acquire), named: [], args: [], labels: [] });
      let region = EWithCell({
        span: h.span,
        resource: h.resource,
        init: ELit({ span: h.span, lit: LUnit }),
        binder: h.binder,
        body: hidden_call(h.span, b"?hold_bracket", [
          thunk(
            EBlock({
              span: h.span,
              tail: Some(var_of(h.binder)),
              stmts: [SExpr(hidden_call(h.span, b"?hold_put", [var_of(h.binder), acquired]))],
            }),
          ),
          over_held(
            applied_to(var_of(release), hidden_call(h.span, b"?hold_take", [var_of(held)]), h.span),
          ),
          over_held(h.body),
        ]),
      });
      // `acquire` and `release` are written outside the hold's binder, so they are bound outside
      // it: a name either shares with the binder is the one around the region.
      EBlock({
        span: h.span,
        tail: Some(region),
        stmts: [
          bound(acquire, thunk(h.acquire)),
          bound(release, over_held(applied_to(h.release, var_of(held), h.span))),
        ],
      })
    },
    _ -> expr,
  }

fn is_hold(expr: Expr) -> Bool = match expr { EWithHold(_) -> true, _ -> false }

/// Every `with_hold` of a module replaced by the cell and the bracket it stands for.
pub fn expand_holds(module: Module) -> Module =
  if !any_expr(module, is_hold) { module }
  else { { ..module, items: module.items.map(|item: Item| map_item(item, expanded_hold)) } }

// --- What `Ok` and `Err` name ----------------------------------------------------------------
// A `try` is written out as a `handle` that answers `Ok` and `Err`, a tagged literal as a `let`
// read through `Ok`, and `?` as a `match` on either pair. In a module that binds one of those names
// for itself, what is written out would name the module's own, so the form is refused here, with
// the grammar: a body taken from its rows is not checked again, and would run as the other thing.

type Rebound = { name: Bytes, imported: Bool }

/// The first of `names` the module binds for itself: one it imports by name, else a variant or a
/// function it declares.
fn bound_among(module: Module, names: List<Bytes>) -> Option<Rebound> = {
  let imported = module.imports.fold(None, |acc: Option<Rebound>, d: ImportDecl|
    match acc {
      Some(_) -> acc,
      None -> match d.kind {
        INames(ns) ->
          ns.fold(None, |b: Option<Rebound>, ident: Ident|
            match b {
              Some(_) -> b,
              None -> if names.contains(ident.name) { Some({ name: ident.name, imported: true }) }
              else { None },
            }),
        _ -> None,
      },
    });
  match imported {
    Some(_) -> imported,
    None ->
      module.items.fold(None, |acc: Option<Rebound>, item: Item|
        match acc {
          Some(_) -> acc,
          None -> match item {
            IType(d) -> match d.body {
              TDSum(vs) ->
                vs.fold(None, |b: Option<Rebound>, variant: VariantDef|
                  match b {
                    Some(_) -> b,
                    None -> if names.contains(variant.name.name) {
                      Some({ name: variant.name.name, imported: false })
                    } else { None },
                  }),
              _ -> None,
            },
            IFn(d) -> if names.contains(d.name.name) {
              Some({ name: d.name.name, imported: false })
            } else { None },
            _ -> None,
          },
        }),
  }
}

fn uncaptured(span: Span, form: Bytes, lacks: Bytes, own: Rebound, answers: Bytes) -> ParseDiag =
  error_at(
    b"E0118",
    span,
    Bytes::concat_all([b"this file gives ", form, b" no meaning here"]),
    lacks,
    [
      Bytes::concat_all([
        b"this module binds its own `",
        own.name,
        b"`, which would capture ",
        answers,
      ]),
    ],
  )

/// `diags`, and a refusal for every `try` and every tagged literal of a module that binds what it
/// would be written out with.
fn rebound(module: Module, diags: List<ParseDiag>) -> List<ParseDiag> = {
  let tried = match bound_among(module, [b"Ok", b"Err"]) {
    None -> diags,
    Some(own) ->
      picked_in(module, is_try_block).fold(diags, |acc: List<ParseDiag>, e: Expr|
        acc.push(
          uncaptured(
            expr_span(e),
            b"`try`",
            b"no `Result` to answer with",
            own,
            b"the `Ok` and `Err` a `try` answers with; rename it or qualify it, or write the `handle` out",
          ),
        )),
  };
  match bound_among(module, [b"Ok"]) {
    None -> tried,
    Some(own) ->
      tagged_in(module).fold(tried, |acc: List<ParseDiag>, t: Tagged|
        acc.push(
          uncaptured(
            t.span,
            b"a tagged literal",
            b"no `Ok` to read it through",
            own,
            b"the `Ok` a tagged literal is read through; rename it or qualify it, or call `literal` and match on what it answers",
          ),
        )),
  }
}

// --- The try operator ------------------------------------------------------------------------

type TryMode = | TryResult | TryOption

/// `shadowed` is the note for a module whose own `Ok`/`Err`/`Some`/`None` would capture the expansion.
type TryState = {
  types: List<TypeDef>,
  shadowed: Option<Bytes>,
  diags: List<ParseDiag>,
  mode: Option<TryMode>,
  fresh: Int,
}

type Lift = { operand: Expr, binder: Ident, at: Span }
type Scan = | ScanFound(Lift) | ScanPure | ScanImpure
type Scanned = { state: TryState, scan: Scan, expr: Expr }
type TryOut = { state: TryState, expr: Expr }

fn shadowing_ctor(module: Module) -> Option<Bytes> =
  match bound_among(module, [b"Ok", b"Err", b"Some", b"None"]) {
    None -> None,
    Some(own) ->
      Some(if own.imported {
        Bytes::concat_all([
          b"this module imports `",
          own.name,
          b"` unqualified, which would capture the `match` `?` expands to; import the module instead and qualify the name, or write the `match` out",
        ])
      } else {
        Bytes::concat_all([
          b"this module declares its own `",
          own.name,
          b"`, which would capture the `match` `?` expands to; rename it, or write the `match` out",
        ])
      }),
  }

fn unreadable() -> Bytes =
  b"the return type has no head constructor this file can read: a type parameter and a generic alias have none until they are applied"

fn not_result_or_option(head: Bytes) -> Bytes =
  Bytes::concat_all([
    b"this function returns `",
    head,
    b"`; `?` binds a `Result` inside a function returning `Result`, or an `Option` inside one returning `Option`, because those are the constructors it expands to",
  ])

fn no_return_type() -> Bytes =
  b"this function writes no `->`, and `?` reads which constructors to name off the written return type; write one"

fn not_in_a_function(what: Bytes) -> Bytes =
  what.concat(b" has no written return type, and `?` needs one")

fn mode_of(state: TryState, ty: TypeExpr, depth: Int) -> Result<TryMode, Bytes> =
  if depth > max_alias_depth() { Err(too_deep()) } else {
    match ty {
      TCon(c) -> if !is_bare(c.name) {
        Err(
          b"the return type is named through another module, and `?` reads only this file \xe2\x80\x94 a meaning read across a module boundary would go stale in a file that never changed",
        )
      } else if c.name.name.name == b"Result" { Ok(TryResult) }
      else if c.name.name.name == b"Option" { Ok(TryOption) } else {
        let n = c.name.name.name;
        match find_type(state.types, n) {
          None -> Err(not_result_or_option(n)),
          Some(d) -> if is_generic(d.generics) { Err(unreadable()) } else {
            match d.body {
              TDSum(_) -> Err(not_result_or_option(n)),
              TDNominal(_) -> Err(not_result_or_option(n)),
              TDAlias(inner) -> mode_of(state, inner, depth + 1),
            }
          },
        }
      },
      _ -> Err(unreadable()),
    }
  }

fn mode_for(state: TryState, ret: Option<TypeExpr>) -> Result<TryMode, Bytes> =
  match state.shadowed {
    Some(why) -> Err(why),
    None -> match ret { None -> Err(no_return_type()), Some(ty) -> mode_of(state, ty, 0) },
  }

/// The outermost barrier is the one named.
fn under(barrier: Option<Bytes>, what: Bytes) -> Option<Bytes> =
  match barrier { Some(_) -> barrier, None -> Some(what) }

fn fresh_binder(state: TryState, span: Span) -> { state: TryState, binder: Ident } =
  {
    state: { ..state, fresh: state.fresh + 1 },
    binder: { name: b"?".concat(Bytes::of_string(state.fresh.to_string())), span: span },
  }

fn var_of(name: Ident) -> Expr = EVar({ span: name.span, name: bare(name) })

fn var_pattern(name: Ident) -> Pattern = PVar({ span: name.span, name: name })

fn ctor_pattern(name: Bytes, args: List<Pattern>, span: Span) -> Pattern =
  PCtor({ span: span, name: bare({ name: name, span: span }), args: args })

/// `match operand { <failure>, <success>(pat) -> body }`, failure arm first.
fn wrap(
  state: TryState,
  operand: Expr,
  span: Span,
  pat: Pattern,
  body: Expr,
) -> TryOut / {abort.raise} = {
  let mode = match state.mode {
    Some(m) -> m,
    None -> panic("a mode is established before any lift"),
  };
  match mode {
    TryResult -> {
      let fresh = fresh_binder(state, span);
      let fail_pat = ctor_pattern(b"Err", [var_pattern(fresh.binder)], span);
      let fail_body = EApp({
        span: span,
        func: var_of({ name: b"Err", span: span }),
        args: [var_of(fresh.binder)],
        named: [],
        labels: [],
      });
      {
        state: fresh.state,
        expr: EMatch({
          span: span,
          scrutinee: operand,
          arms: [
            { pat: fail_pat, guard: None, body: fail_body, span: span },
            { pat: ctor_pattern(b"Ok", [pat], span), guard: None, body: body, span: span },
          ],
        }),
      }
    },
    TryOption -> {
      let fail_pat = ctor_pattern(b"None", [], span);
      let fail_body = var_of({ name: b"None", span: span });
      {
        state: state,
        expr: EMatch({
          span: span,
          scrutinee: operand,
          arms: [
            { pat: fail_pat, guard: None, body: fail_body, span: span },
            { pat: ctor_pattern(b"Some", [pat], span), guard: None, body: body, span: span },
          ],
        }),
      }
    },
  }
}

fn purity(pure: Bool) -> Scan = if pure { ScanPure } else { ScanImpure }

type Sequenced = { state: TryState, scan: Scan, exprs: List<Expr> }

/// Sub-expressions left to right, stopping at the first `?` and at the first impure one.
fn sequence(state: TryState, parts: List<Expr>) -> Sequenced / {abort.raise} =
  sequence_on({ state: state, scan: ScanPure, exprs: [] }, parts)

/// `sequence` going on from where one over the sub-expressions before `parts` stopped.
fn sequence_on(before: Sequenced, parts: List<Expr>) -> Sequenced / {abort.raise} =
  parts.fold(before, |acc: Sequenced, expr: Expr|
    match acc.scan {
      ScanPure -> {
        let o = scan(acc.state, expr);
        { state: o.state, scan: o.scan, exprs: acc.exprs.push(o.expr) }
      },
      _ -> { ..acc, exprs: acc.exprs.push(expr) },
    })

/// Lifts the first `?` reachable in evaluation order, leaving its binder in its place.
fn scan(state: TryState, expr: Expr) -> Scanned / {abort.raise} =
  match expr {
    ELit(_) -> { state: state, scan: ScanPure, expr: expr },
    EVar(_) -> { state: state, scan: ScanPure, expr: expr },
    EBad(_) -> { state: state, scan: ScanPure, expr: expr },
    ETry(t) -> {
      let inner = scan(state, t.operand);
      match inner.scan {
        ScanFound(_) ->
          {
            state: inner.state,
            scan: inner.scan,
            expr: ETry({ span: t.span, operand: inner.expr }),
          },
        _ -> {
          let fresh = fresh_binder(inner.state, t.span);
          {
            state: fresh.state,
            scan: ScanFound({ operand: inner.expr, binder: fresh.binder, at: t.span }),
            expr: var_of(fresh.binder),
          }
        },
      }
    },
    EBinary(b) -> {
      let short = b.op == b"and" || b.op == b"or";
      let l = scan(state, b.lhs);
      match l.scan {
        ScanFound(_) ->
          {
            state: l.state,
            scan: l.scan,
            expr: EBinary({ span: b.span, op: b.op, lhs: l.expr, rhs: b.rhs }),
          },
        ScanImpure -> { state: l.state, scan: ScanImpure, expr: expr },
        ScanPure -> if short { { state: l.state, scan: purity(is_pure(b.rhs)), expr: expr } } else {
          let r = scan(l.state, b.rhs);
          {
            state: r.state,
            scan: r.scan,
            expr: EBinary({ span: b.span, op: b.op, lhs: l.expr, rhs: r.expr }),
          }
        },
      }
    },
    EUnary(u) -> {
      let o = scan(state, u.operand);
      { state: o.state, scan: o.scan, expr: EUnary({ span: u.span, op: u.op, operand: o.expr }) }
    },
    EApp(a) -> {
      let o = sequence_on(
        sequence_on(sequence(state, [a.func]), a.args),
        a.named.map(|n: NamedArg| n.value),
      );
      let func = o.exprs.get(0);
      let args = o.exprs.drop(1).take(a.args.len());
      let nvals = o.exprs.drop(1 + a.args.len());
      let named = range(0, a.named.len()).map(|i: Int| {
        let n = a.named.get(i);
        { name: n.name, value: nvals.get(i), span: n.span }
      });
      let rebuilt = EApp({ span: a.span, func: func, named: named, args: args, labels: a.labels });
      match o.scan {
        ScanFound(_) -> { state: o.state, scan: o.scan, expr: rebuilt },
        _ -> { state: o.state, scan: ScanImpure, expr: rebuilt },
      }
    },
    EPerform(p) -> {
      let o = sequence(state, p.args);
      let rebuilt = EPerform({
        span: p.span,
        eff: p.eff,
        op: p.op,
        resource: p.resource,
        args: o.exprs,
      });
      match o.scan {
        ScanFound(_) -> { state: o.state, scan: o.scan, expr: rebuilt },
        _ -> { state: o.state, scan: ScanImpure, expr: rebuilt },
      }
    },
    ERecord(r) -> {
      let o = sequence(state, r.fields.map(|f: RecField| f.value));
      {
        state: o.state,
        scan: o.scan,
        expr: ERecord({
          span: r.span,
          fields: range(0, r.fields.len()).map(|i: Int|
            { name: r.fields.get(i).name, value: o.exprs.get(i) }),
        }),
      }
    },
    EList(l) -> {
      let o = sequence(state, l.items);
      { state: o.state, scan: o.scan, expr: EList({ span: l.span, items: o.exprs }) }
    },
    EField(f) -> {
      let o = scan(state, f.base);
      { state: o.state, scan: o.scan, expr: EField({ span: f.span, base: o.expr, field: f.field }) }
    },
    ERecordUpdate(r) -> {
      let o = sequence_on(sequence(state, [r.base]), r.fields.map(|f: RecField| f.value));
      {
        state: o.state,
        scan: o.scan,
        expr: ERecordUpdate({
          span: r.span,
          base: o.exprs.get(0),
          fields: range(0, r.fields.len()).map(|i: Int|
            { name: r.fields.get(i).name, value: o.exprs.get(i + 1) }),
        }),
      }
    },
    EIf(i) -> {
      let c = scan(state, i.cond);
      let rebuilt = EIf({
        span: i.span,
        cond: c.expr,
        then_branch: i.then_branch,
        else_branch: i.else_branch,
      });
      match c.scan {
        ScanFound(_) -> { state: c.state, scan: c.scan, expr: rebuilt },
        ScanImpure -> { state: c.state, scan: ScanImpure, expr: rebuilt },
        ScanPure ->
          {
            state: c.state,
            scan: purity(is_pure(i.then_branch) && is_pure(i.else_branch)),
            expr: rebuilt,
          },
      }
    },
    EMatch(m) -> {
      let sc = scan(state, m.scrutinee);
      let rebuilt = EMatch({ span: m.span, scrutinee: sc.expr, arms: m.arms });
      match sc.scan {
        ScanFound(_) -> { state: sc.state, scan: sc.scan, expr: rebuilt },
        ScanImpure -> { state: sc.state, scan: ScanImpure, expr: rebuilt },
        ScanPure ->
          {
            state: sc.state,
            scan: purity(
              m.arms.fold(true, |acc: Bool, arm: MatchArm|
                acc && is_pure(arm.body)
                  && (match arm.guard { None -> true, Some(g) -> is_pure(g) })),
            ),
            expr: rebuilt,
          },
      }
    },
    ETagged(t) -> {
      let o = sequence(state, t.holes.map(|h: Hole| h.value));
      let rebuilt = ETagged(with_hole_values(t, o.exprs));
      match o.scan {
        ScanFound(_) -> { state: o.state, scan: o.scan, expr: rebuilt },
        _ -> { state: o.state, scan: purity(t.holes.len() == 0), expr: rebuilt },
      }
    },
    // A nested block is not entered; a lambda, handler, cell, region, `simulate` or `parallel` is a
    // barrier to `?`.
    _ -> { state: state, scan: purity(is_pure(expr)), expr: expr },
  }

/// One `match` per `?` lifted from `expr`'s head, with the rewritten `expr` as the success arm's body.
/// `room` is how many `?` are left to lift: each lift takes one away and none is copied.
fn region_cond(state: TryState, expr: Expr, room: Int) -> TryOut / {abort.raise} = {
  let found = scan_head(state, expr);
  match found.scan {
    ScanFound(l) -> {
      let w = wrap(found.state, l.operand, l.at, var_pattern(l.binder), found.expr);
      match w.expr {
        EMatch(m) -> {
          let success = m.arms.get(1);
          let inner = if room <= 0 { panic(lifted_past()) }
          else { region_cond(w.state, success.body, room - 1) };
          {
            state: inner.state,
            expr: EMatch({
              span: m.span,
              scrutinee: m.scrutinee,
              arms: [
                m.arms.get(0),
                { pat: success.pat, guard: None, body: inner.expr, span: success.span },
              ],
            }),
          }
        },
        _ -> w,
      }
    },
    _ -> { state: found.state, expr: found.expr },
  }
}

fn scan_head(state: TryState, expr: Expr) -> Scanned / {abort.raise} =
  match expr {
    EIf(i) -> {
      let c = scan(state, i.cond);
      {
        state: c.state,
        scan: c.scan,
        expr: EIf({
          span: i.span,
          cond: c.expr,
          then_branch: i.then_branch,
          else_branch: i.else_branch,
        }),
      }
    },
    EMatch(m) -> {
      let sc = scan(state, m.scrutinee);
      {
        state: sc.state,
        scan: sc.scan,
        expr: EMatch({ span: m.span, scrutinee: sc.expr, arms: m.arms }),
      }
    },
    _ -> scan(state, expr),
  }

fn lifted_past() -> String = "a `?` lifted past the ones written"

/// An expression in return position, with `room` as in `region_cond`.
fn ret(state: TryState, expr: Expr, room: Int) -> TryOut / {abort.raise} =
  match expr {
    EBlock(_) -> block(state, expr, room),
    EIf(i) -> {
      let t = ret(state, i.then_branch, room);
      let el = ret(t.state, i.else_branch, room);
      region_cond(
        el.state,
        EIf({ span: i.span, cond: i.cond, then_branch: t.expr, else_branch: el.expr }),
        room,
      )
    },
    EMatch(m) -> {
      let arms = m.arms.fold(
        { state: state, arms: [] },
        |acc: { state: TryState, arms: List<MatchArm> }, arm: MatchArm| {
          let b = ret(acc.state, arm.body, room);
          {
            state: b.state,
            arms: acc.arms.push({ pat: arm.pat, guard: arm.guard, body: b.expr, span: arm.span }),
          }
        },
      );
      region_cond(
        arms.state,
        EMatch({ span: m.span, scrutinee: m.scrutinee, arms: arms.arms }),
        room,
      )
    },
    _ -> region_cond(state, expr, room),
  }

/// A block in return position: split at the first statement a `?` can be lifted from.
fn block(state: TryState, expr: Expr, room: Int) -> TryOut / {abort.raise} =
  match expr {
    EBlock(b) -> {
      let split = range(0, b.stmts.len()).fold(
        { state: state, stmts: b.stmts, tail: b.tail, done: false },
        |acc: { state: TryState, stmts: List<Stmt>, tail: Option<Expr>, done: Bool }, i: Int|
          if acc.done { acc } else {
            let o = split_at(acc.state, acc.stmts, acc.tail, i, b.stmts.get(i), room);
            match o.split {
              None -> { state: o.state, stmts: o.stmts, tail: acc.tail, done: false },
              Some(t) -> { state: o.state, stmts: o.stmts.take(i), tail: Some(t), done: true },
            }
          },
      );
      if split.done {
        { state: split.state, expr: EBlock({ span: b.span, tail: split.tail, stmts: split.stmts }) }
      } else {
        match b.tail {
          None ->
            { state: split.state, expr: EBlock({ span: b.span, tail: None, stmts: split.stmts }) },
          Some(t) -> {
            let o = ret(split.state, t, room);
            {
              state: o.state,
              expr: EBlock({ span: b.span, tail: Some(o.expr), stmts: split.stmts }),
            }
          },
        }
      }
    },
    _ -> panic("only called on a block"),
  }

type Taken = {
  state: TryState,
  stmt: Stmt,
  take: Option<{ operand: Expr, at: Span, pat: Pattern, consumes: Bool }>,
}

/// `st` is `stmts`' `i`th as written: only the ones before it are rewritten yet.
fn split_at(
  state: TryState,
  stmts: List<Stmt>,
  tail: Option<Expr>,
  i: Int,
  st: Stmt,
  room: Int,
) -> { state: TryState, stmts: List<Stmt>, split: Option<Expr> } / {abort.raise} = {
  let taken = take_stmt(state, st, room);
  match taken.take {
    None -> { state: taken.state, stmts: stmts.set(i, taken.stmt), split: None },
    Some(t) -> {
      let kept = stmts.set(i, taken.stmt);
      let rest = kept.drop(if t.consumes { i + 1 } else { i });
      // A consumed statement goes: its binder is now the success arm's pattern.
      let body0 = EBlock({ span: t.at, tail: tail, stmts: rest });
      let body = if room <= 0 { panic(lifted_past()) } else { block(taken.state, body0, room - 1) };
      let w = wrap(body.state, t.operand, t.at, t.pat, body.expr);
      { state: w.state, stmts: kept, split: Some(w.expr) }
    },
  }
}

fn take_stmt(state: TryState, stmt: Stmt, room: Int) -> Taken / {abort.raise} =
  match stmt {
    // Never consumed, since its pattern is not the success arm's. Its `else` block is the block's
    // value, so it is a return position: expanded once, when no `?` is left in the initializer.
    SLetElse(l) -> match l.value {
      ETry(t) -> {
        let fresh = fresh_binder(state, t.span);
        let o = take_try(fresh.state, t.operand, t.span, var_pattern(fresh.binder));
        if o.take.consumes {
          {
            state: o.state,
            stmt: SLetElse({ ..l, value: var_of(fresh.binder) }),
            take: Some({
              operand: o.take.operand,
              at: o.take.at,
              pat: o.take.pat,
              consumes: false,
            }),
          }
        } else {
          {
            state: o.state,
            stmt: SLetElse({ ..l, value: ETry({ span: t.span, operand: o.operand_left }) }),
            take: Some(o.take),
          }
        }
      },
      _ -> {
        let o = scan(state, l.value);
        match o.scan {
          ScanFound(lift) ->
            {
              state: o.state,
              stmt: SLetElse({ ..l, value: o.expr }),
              take: Some({
                operand: lift.operand,
                at: lift.at,
                pat: var_pattern(lift.binder),
                consumes: false,
              }),
            },
          _ -> {
            let f = ret(o.state, l.fallback, room);
            { state: f.state, stmt: SLetElse({ ..l, fallback: f.expr }), take: None }
          },
        }
      },
    },
    SLet(l) -> match l.value {
      ETry(t) -> match l.ty {
        // The annotation stays: the `let` now binds the success arm's binder.
        Some(_) -> {
          let fresh = fresh_binder(state, t.span);
          let o = take_try(fresh.state, t.operand, t.span, var_pattern(fresh.binder));
          if o.take.consumes {
            {
              state: o.state,
              stmt: SLet({ span: l.span, pat: l.pat, ty: l.ty, value: var_of(fresh.binder) }),
              take: Some({
                operand: o.take.operand,
                at: o.take.at,
                pat: o.take.pat,
                consumes: false,
              }),
            }
          } else {
            {
              state: o.state,
              stmt: SLet({
                span: l.span,
                pat: l.pat,
                ty: l.ty,
                value: ETry({ span: t.span, operand: o.operand_left }),
              }),
              take: Some(o.take),
            }
          }
        },
        None -> {
          let o = take_try(state, t.operand, t.span, l.pat);
          {
            state: o.state,
            stmt: SLet({
              span: l.span,
              pat: l.pat,
              ty: None,
              value: ETry({ span: t.span, operand: o.operand_left }),
            }),
            take: Some(o.take),
          }
        },
      },
      _ -> {
        let o = scan(state, l.value);
        match o.scan {
          ScanFound(lift) ->
            {
              state: o.state,
              stmt: SLet({ span: l.span, pat: l.pat, ty: l.ty, value: o.expr }),
              take: Some({
                operand: lift.operand,
                at: lift.at,
                pat: var_pattern(lift.binder),
                consumes: false,
              }),
            },
          _ -> { state: o.state, stmt: stmt, take: None },
        }
      },
    },
    SExpr(v) -> match v {
      ETry(t) -> {
        let o = take_try(state, t.operand, t.span, PWild({ span: v_span(v) }));
        {
          state: o.state,
          stmt: SExpr(ETry({ span: t.span, operand: o.operand_left })),
          take: Some(o.take),
        }
      },
      _ -> {
        let o = scan(state, v);
        match o.scan {
          ScanFound(lift) ->
            {
              state: o.state,
              stmt: SExpr(o.expr),
              take: Some({
                operand: lift.operand,
                at: lift.at,
                pat: var_pattern(lift.binder),
                consumes: false,
              }),
            },
          _ -> { state: o.state, stmt: stmt, take: None },
        }
      },
    },
  }

fn v_span(expr: Expr) -> Span = expr_span(expr)

type TryTaken = {
  state: TryState,
  operand_left: Expr,
  take: { operand: Expr, at: Span, pat: Pattern, consumes: Bool },
}

/// An inner `?` in the operand is lifted first and the statement stays; otherwise the statement is consumed.
fn take_try(state: TryState, operand: Expr, span: Span, pat: Pattern) -> TryTaken / {abort.raise} = {
  let o = scan(state, operand);
  match o.scan {
    ScanFound(lift) ->
      {
        state: o.state,
        operand_left: o.expr,
        take: {
          operand: lift.operand,
          at: lift.at,
          pat: var_pattern(lift.binder),
          consumes: false,
        },
      },
    _ ->
      {
        state: o.state,
        operand_left: ELit({ span: span, lit: LUnit }),
        take: { operand: o.expr, at: span, pat: pat, consumes: true },
      },
  }
}

/// Refuses and unwraps every `?` left in `expr`: `E0118` when `scope` or `barrier` says why, else `E0119`.
fn sweep(
  state: TryState,
  expr: Expr,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
) -> TryOut / {abort.raise} =
  sweep_within(state, expr, scope, barrier, count_in(expr, typed_lambda))

fn typed_lambda(e: Expr) -> Bool = match e { ELambda(l) -> l.ret != None, _ -> false }

/// `room` is how many lambdas with a written return type are left to sweep: the body of one is swept
/// after `ret` rewrites it, which copies no lambda.
fn sweep_within(
  state: TryState,
  expr: Expr,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
  room: Int,
) -> TryOut / {abort.raise} =
  match expr {
    ETry(t) -> {
      let d = match barrier {
        Some(what) ->
          error_at(
            b"E0118",
            t.span,
            b"this file gives `?` no meaning here",
            b"no `Result` or `Option` to expand this into",
            [
              Bytes::concat_all([
                b"this `?` is inside ",
                what,
                b", which has no written return type of its own. `?` exits the expression it is written in and never a lambda, a handler or a region: name a function with a written `->` and call it",
              ]),
            ],
          ),
        None -> match scope {
          Some(why) ->
            error_at(
              b"E0118",
              t.span,
              b"this file gives `?` no meaning here",
              b"no `Result` or `Option` to expand this into",
              [why],
            ),
          None ->
            error_at(
              b"E0119",
              t.span,
              b"this `?` is not in a position it can be expanded from",
              b"`?` cannot exit from here",
              [
                b"`?` lifts what it unwraps to the head of the statement, or of the return position, it is written in \xe2\x80\x94 so nothing conditional may sit between the two, and everything evaluated before it must be pure. Bind it first: `let a = e?;`",
              ],
            ),
        },
      };
      sweep_inner({ ..state, diags: state.diags.push(d) }, t.operand, scope, barrier, room)
    },
    _ -> sweep_inner(state, expr, scope, barrier, room),
  }

fn sweep_inner(
  state: TryState,
  expr: Expr,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
  room: Int,
) -> TryOut / {abort.raise} =
  match expr {
    ETry(t) -> {
      let o = sweep_within(state, t.operand, scope, barrier, room);
      { state: o.state, expr: ETry({ span: t.span, operand: o.expr }) }
    },
    EBinary(b) -> {
      let l = sweep_within(state, b.lhs, scope, barrier, room);
      let r = sweep_within(l.state, b.rhs, scope, barrier, room);
      { state: r.state, expr: EBinary({ span: b.span, op: b.op, lhs: l.expr, rhs: r.expr }) }
    },
    EUnary(u) -> {
      let o = sweep_within(state, u.operand, scope, barrier, room);
      { state: o.state, expr: EUnary({ span: u.span, op: u.op, operand: o.expr }) }
    },
    ELambda(l) -> match l.ret {
      None -> {
        let o = sweep_within(state, l.body, scope, under(barrier, b"a lambda"), room);
        {
          state: o.state,
          expr: ELambda({ span: l.span, body: o.expr, params: l.params, ret: None }),
        }
      },
      Some(ty) -> match mode_for(state, Some(ty)) {
        Err(why) -> {
          let o = sweep_within(state, l.body, Some(why), None, room);
          {
            state: o.state,
            expr: ELambda({ span: l.span, body: o.expr, params: l.params, ret: Some(ty) }),
          }
        },
        Ok(m) -> {
          let saved = state.mode;
          let r = ret({ ..state, mode: Some(m) }, l.body, tries_in(l.body));
          let s: TryOut = if room <= 0 { panic("a lambda swept past the ones written") }
          else { sweep_within(r.state, r.expr, None, None, room - 1) };
          {
            state: { ..s.state, mode: saved },
            expr: ELambda({ span: l.span, body: s.expr, params: l.params, ret: Some(ty) }),
          }
        },
      },
    },
    EApp(a) -> {
      let f = sweep_within(state, a.func, scope, barrier, room);
      let args = sweep_all(f.state, a.args, scope, barrier, room);
      let named = a.named.fold(
        { state: args.state, args: [] },
        |acc: { state: TryState, args: List<NamedArg> }, arg: NamedArg| {
          let o = sweep_within(acc.state, arg.value, scope, barrier, room);
          { state: o.state, args: acc.args.push({ name: arg.name, value: o.expr, span: arg.span }) }
        },
      );
      {
        state: named.state,
        expr: EApp({
          span: a.span,
          func: f.expr,
          named: named.args,
          args: args.exprs,
          labels: a.labels,
        }),
      }
    },
    EIf(i) -> {
      let c = sweep_within(state, i.cond, scope, barrier, room);
      let t = sweep_within(c.state, i.then_branch, scope, barrier, room);
      let el = sweep_within(t.state, i.else_branch, scope, barrier, room);
      {
        state: el.state,
        expr: EIf({ span: i.span, cond: c.expr, then_branch: t.expr, else_branch: el.expr }),
      }
    },
    EMatch(m) -> {
      let sc = sweep_within(state, m.scrutinee, scope, barrier, room);
      let arms = m.arms.fold(
        { state: sc.state, arms: [] },
        |acc: { state: TryState, arms: List<MatchArm> }, arm: MatchArm| {
          let g = match arm.guard {
            None -> { state: acc.state, expr: None },
            Some(x) -> {
              let o = sweep_within(acc.state, x, scope, barrier, room);
              { state: o.state, expr: Some(o.expr) }
            },
          };
          let b = sweep_within(g.state, arm.body, scope, barrier, room);
          {
            state: b.state,
            arms: acc.arms.push({ pat: arm.pat, guard: g.expr, body: b.expr, span: arm.span }),
          }
        },
      );
      { state: arms.state, expr: EMatch({ span: m.span, scrutinee: sc.expr, arms: arms.arms }) }
    },
    EBlock(b) -> {
      let stmts = b.stmts.fold(
        { state: state, stmts: [] },
        |acc: { state: TryState, stmts: List<Stmt> }, stmt: Stmt|
          match stmt {
            SLet(l) -> {
              let o = sweep_within(acc.state, l.value, scope, barrier, room);
              {
                state: o.state,
                stmts: acc.stmts.push(SLet({ span: l.span, pat: l.pat, ty: l.ty, value: o.expr })),
              }
            },
            SLetElse(l) -> {
              let v = sweep_within(acc.state, l.value, scope, barrier, room);
              let f = sweep_within(v.state, l.fallback, scope, barrier, room);
              {
                state: f.state,
                stmts: acc.stmts.push(SLetElse({ ..l, value: v.expr, fallback: f.expr })),
              }
            },
            SExpr(x) -> {
              let o = sweep_within(acc.state, x, scope, barrier, room);
              { state: o.state, stmts: acc.stmts.push(SExpr(o.expr)) }
            },
          },
      );
      let tl = match b.tail {
        None -> { state: stmts.state, expr: None },
        Some(t) -> {
          let o = sweep_within(stmts.state, t, scope, barrier, room);
          { state: o.state, expr: Some(o.expr) }
        },
      };
      { state: tl.state, expr: EBlock({ span: b.span, tail: tl.expr, stmts: stmts.stmts }) }
    },
    ERecord(r) -> {
      let o = sweep_fields(state, r.fields, scope, barrier, room);
      { state: o.state, expr: ERecord({ span: r.span, fields: o.fields }) }
    },
    ERecordUpdate(r) -> {
      let b = sweep_within(state, r.base, scope, barrier, room);
      let o = sweep_fields(b.state, r.fields, scope, barrier, room);
      { state: o.state, expr: ERecordUpdate({ span: r.span, base: b.expr, fields: o.fields }) }
    },
    EField(f) -> {
      let o = sweep_within(state, f.base, scope, barrier, room);
      { state: o.state, expr: EField({ span: f.span, base: o.expr, field: f.field }) }
    },
    EList(l) -> {
      let o = sweep_all(state, l.items, scope, barrier, room);
      { state: o.state, expr: EList({ span: l.span, items: o.exprs }) }
    },
    EPerform(p) -> {
      let o = sweep_all(state, p.args, scope, barrier, room);
      {
        state: o.state,
        expr: EPerform({ span: p.span, eff: p.eff, op: p.op, resource: p.resource, args: o.exprs }),
      }
    },
    EHandle(h) -> {
      let b = sweep_within(state, h.body, scope, under(barrier, b"a `handle` body"), room);
      let cs = h.clauses.fold(
        { state: b.state, clauses: [] },
        |acc: { state: TryState, clauses: List<HandleClause> }, c: HandleClause| {
          let o = sweep_within(
            acc.state,
            c.body,
            scope,
            under(barrier, b"a `handle` clause"),
            room,
          );
          {
            state: o.state,
            clauses: acc.clauses.push({
              eff: c.eff,
              op: c.op,
              resource: c.resource,
              every_label: c.every_label,
              label_binder: c.label_binder,
              resume: c.resume,
              body: o.expr,
              span: c.span,
              params: c.params,
            }),
          }
        },
      );
      let r = match h.ret {
        None -> { state: cs.state, ret: None },
        Some(rc) -> {
          let o = sweep_within(
            cs.state,
            rc.body,
            scope,
            under(barrier, b"a `handle` return clause"),
            room,
          );
          { state: o.state, ret: Some({ binder: rc.binder, body: o.expr, span: rc.span }) }
        },
      };
      {
        state: r.state,
        expr: EHandle({ span: h.span, body: b.expr, ret: r.ret, clauses: cs.clauses }),
      }
    },
    EWithCell(c) -> {
      let i = sweep_within(state, c.init, scope, barrier, room);
      let b = sweep_within(i.state, c.body, scope, under(barrier, b"a `with_cell` body"), room);
      {
        state: b.state,
        expr: EWithCell({
          span: c.span,
          resource: c.resource,
          init: i.expr,
          binder: c.binder,
          body: b.expr,
        }),
      }
    },
    EWithHold(c) -> {
      let a = sweep_within(state, c.acquire, scope, barrier, room);
      let r = sweep_within(
        a.state,
        c.release,
        scope,
        under(barrier, b"a `with_hold` release"),
        room,
      );
      let b = sweep_within(r.state, c.body, scope, under(barrier, b"a `with_hold` body"), room);
      { state: b.state, expr: EWithHold({ ..c, acquire: a.expr, release: r.expr, body: b.expr }) }
    },
    ESimulate(x) -> {
      let o = sweep_within(state, x.body, scope, under(barrier, b"a `simulate` body"), room);
      { state: o.state, expr: ESimulate({ span: x.span, body: o.expr }) }
    },
    EParallel(x) -> {
      let o = sweep_all(state, x.branches, scope, under(barrier, b"a `parallel` branch"), room);
      { state: o.state, expr: EParallel({ span: x.span, branches: o.exprs }) }
    },
    ETryBlock(x) -> {
      let o = sweep_within(state, x.body, scope, under(barrier, b"a `try` body"), room);
      { state: o.state, expr: ETryBlock({ ..x, body: o.expr }) }
    },
    ETagged(t) -> {
      let filled = t.holes.fold(
        { state: state, holes: [] },
        |acc: { state: TryState, holes: List<Hole> }, h: Hole| {
          let o = sweep_within(acc.state, h.value, scope, barrier, room);
          { state: o.state, holes: acc.holes.push({ ..h, value: o.expr }) }
        },
      );
      { state: filled.state, expr: ETagged({ ..t, holes: filled.holes }) }
    },
    _ -> { state: state, expr: expr },
  }

fn sweep_all(
  state: TryState,
  exprs: List<Expr>,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
  room: Int,
) -> { state: TryState, exprs: List<Expr> } / {abort.raise} =
  exprs.fold(
    { state: state, exprs: [] },
    |acc: { state: TryState, exprs: List<Expr> }, expr: Expr| {
      let o = sweep_within(acc.state, expr, scope, barrier, room);
      { state: o.state, exprs: acc.exprs.push(o.expr) }
    },
  )

fn sweep_fields(
  state: TryState,
  fields: List<RecField>,
  scope: Option<Bytes>,
  barrier: Option<Bytes>,
  room: Int,
) -> { state: TryState, fields: List<RecField> } / {abort.raise} =
  fields.fold(
    { state: state, fields: [] },
    |acc: { state: TryState, fields: List<RecField> }, field: RecField| {
      let o = sweep_within(acc.state, field.value, scope, barrier, room);
      { state: o.state, fields: acc.fields.push({ name: field.name, value: o.expr }) }
    },
  )

fn try_item(outer: TryState, item: Item) -> { state: TryState, item: Item } / {abort.raise} = {
  let state = { ..outer, fresh: 0, mode: None };
  match item {
    IFn(d) -> {
      let spec: { state: TryState, clauses: List<SpecClause> } = d.spec.fold(
        { state: state, clauses: [] },
        |acc: { state: TryState, clauses: List<SpecClause> }, clause: SpecClause| {
          let what = match clause.kind {
            SRequires -> b"a `requires` clause",
            SEnsures -> b"an `ensures` clause",
            SCost -> b"a `cost` clause",
            SSpace -> b"a `space` clause",
          };
          let o = sweep(acc.state, clause.expr, Some(not_in_a_function(what)), None);
          {
            state: o.state,
            clauses: acc.clauses.push({ kind: clause.kind, expr: o.expr, span: clause.span }),
          }
        },
      );
      let measured: { state: TryState, expr: Option<Expr> } = match d.decreases {
        None -> { state: spec.state, expr: None },
        Some(e) -> {
          let o = sweep(spec.state, e, Some(not_in_a_function(b"a `decreases` clause")), None);
          { state: o.state, expr: Some(o.expr) }
        },
      };
      let body = match mode_for(state, d.ret) {
        Err(why) -> sweep(measured.state, d.body, Some(why), None),
        Ok(m) -> {
          let r = ret({ ..measured.state, mode: Some(m) }, d.body, tries_in(d.body));
          let s: TryOut = sweep(r.state, r.expr, None, None);
          { state: { ..s.state, mode: None }, expr: s.expr }
        },
      };
      {
        state: body.state,
        item: IFn({
          vis: d.vis,
          name: d.name,
          generics: d.generics,
          params: d.params,
          ret: d.ret,
          effects: d.effects,
          constraints: d.constraints,
          spec: spec.clauses,
          returns: d.returns,
          reuse: d.reuse,
          transparent: d.transparent,
          baked: d.baked,
          decreases: measured.expr,
          body: body.expr,
          doc: d.doc,
          span: d.span,
        }),
      }
    },
    ITest(d) -> {
      let why = not_in_a_function(b"a `test`");
      let ranged = match d.cases {
        None -> { state: state, cases: None },
        Some(c) -> {
          let table = sweep(state, c.table, Some(why), None);
          let label = sweep(table.state, c.label, Some(why), None);
          { state: label.state, cases: Some({ ..c, table: table.expr, label: label.expr }) }
        },
      };
      let o = sweep(ranged.state, d.body, Some(why), None);
      { state: o.state, item: ITest({ ..d, cases: ranged.cases, body: o.expr }) }
    },
    ILaw(d) -> {
      let why = not_in_a_function(b"a `law`");
      let g = match d.guard {
        None -> { state: state, expr: None },
        Some(x) -> {
          let o = sweep(state, x, Some(why), None);
          { state: o.state, expr: Some(o.expr) }
        },
      };
      let b = sweep(g.state, d.body, Some(why), None);
      {
        state: b.state,
        item: ILaw({
          name: d.name,
          name_span: d.name_span,
          binders: d.binders,
          guard: g.expr,
          of: d.of,
          body: b.expr,
          span: d.span,
        }),
      }
    },
    ISchema(d) -> {
      let why = not_in_a_function(b"a `law schema`");
      let g = match d.guard {
        None -> { state: state, expr: None },
        Some(x) -> {
          let o = sweep(state, x, Some(why), None);
          { state: o.state, expr: Some(o.expr) }
        },
      };
      let b = sweep(g.state, d.body, Some(why), None);
      { state: b.state, item: ISchema({ ..d, guard: g.expr, body: b.expr }) }
    },
    _ -> { state: state, item: item },
  }
}

pub fn expand_try(
  module: Module,
  diags: List<ParseDiag>,
) -> { module: Module, diags: List<ParseDiag> } / {abort.raise} = {
  let start = {
    types: collect_types(module),
    shadowed: shadowing_ctor(module),
    diags: diags,
    mode: None,
    fresh: 0,
  };
  let walked = module.items.fold(
    { state: start, items: [] },
    |acc: { state: TryState, items: List<Item> }, item: Item| {
      let o = try_item(acc.state, item);
      { state: o.state, items: acc.items.push(o.item) }
    },
  );
  { module: { ..module, items: walked.items }, diags: walked.state.diags }
}

// --- Running the rewrites --------------------------------------------------------------------

fn has_update(module: Module) -> Bool = any_expr(module, is_update)

fn is_update(expr: Expr) -> Bool = match expr { ERecordUpdate(_) -> true, _ -> false }

/// Whether a definition writes a record update anywhere: its body, a clause, or a default.
pub fn fn_has_update(def: FnDef) -> Bool =
  any_expr({ doc: None, imports: [], items: [IFn(def)] }, is_update)

fn has_try(m: Module) -> Bool = any_expr(m, |expr: Expr| match expr { ETry(_) -> true, _ -> false })

fn any_expr(module: Module, p: (Expr) -> Bool) -> Bool =
  module.items.fold(false, |acc: Bool, item: Item|
    acc
      || (match item {
        IFn(d) ->
          count_in(d.body, p) > 0
            || d.spec.fold(false, |b: Bool, clause: SpecClause| b || count_in(clause.expr, p) > 0)
            || d.params.fold(false, |b: Bool, param: Param|
              b || (match param.default { None -> false, Some(v) -> count_in(v, p) > 0 })),
        ITest(d) ->
          count_in(d.body, p) > 0
            || (match d.cases {
              None -> false,
              Some(c) -> count_in(c.table, p) > 0 || count_in(c.label, p) > 0,
            }),
        ILaw(d) ->
          count_in(d.body, p) > 0
            || (match d.guard { None -> false, Some(g) -> count_in(g, p) > 0 }),
        ISchema(d) ->
          count_in(d.body, p) > 0
            || (match d.guard { None -> false, Some(g) -> count_in(g, p) > 0 }),
        _ -> false,
      }))

/// How many expressions within `e`, itself included, `p` holds for.
fn count_in(e: Expr, p: (Expr) -> Bool) -> Int = {
  let all = |es: List<Expr>| es.fold(0, |n: Int, x: Expr| n + count_in(x, p));
  let maybe = |o: Option<Expr>| match o { None -> 0, Some(x) -> count_in(x, p) };
  (if p(e) { 1 } else { 0 })
    + (match e {
      EBinary(b) -> count_in(b.lhs, p) + count_in(b.rhs, p),
      EUnary(u) -> count_in(u.operand, p),
      ELambda(l) -> count_in(l.body, p) + l.params.fold(0, |n: Int, x: Param| n + maybe(x.default)),
      EApp(a) ->
        count_in(a.func, p) + all(a.args)
          + a.named.fold(0, |n: Int, arg: NamedArg| n + count_in(arg.value, p)),
      EIf(i) -> count_in(i.cond, p) + count_in(i.then_branch, p) + count_in(i.else_branch, p),
      EMatch(m) ->
        count_in(m.scrutinee, p)
          + m.arms.fold(0, |n: Int, arm: MatchArm| n + count_in(arm.body, p) + maybe(arm.guard)),
      EBlock(b) ->
        b.stmts.fold(0, |n: Int, stmt: Stmt|
            n
              + (match stmt {
                SLet(l) -> count_in(l.value, p),
                SLetElse(l) -> count_in(l.value, p) + count_in(l.fallback, p),
                SExpr(x) -> count_in(x, p),
              }))
          + maybe(b.tail),
      ERecord(r) -> r.fields.fold(0, |n: Int, f: RecField| n + count_in(f.value, p)),
      ERecordUpdate(r) ->
        count_in(r.base, p) + r.fields.fold(0, |n: Int, f: RecField| n + count_in(f.value, p)),
      ETry(t) -> count_in(t.operand, p),
      EField(f) -> count_in(f.base, p),
      EList(l) -> all(l.items),
      EPerform(x) -> all(x.args),
      EHandle(h) ->
        count_in(h.body, p) + h.clauses.fold(0, |n: Int, c: HandleClause| n + count_in(c.body, p))
          + (match h.ret { None -> 0, Some(rc) -> count_in(rc.body, p) }),
      EWithCell(c) -> count_in(c.init, p) + count_in(c.body, p),
      EWithHold(c) -> count_in(c.acquire, p) + count_in(c.release, p) + count_in(c.body, p),
      ESimulate(x) -> count_in(x.body, p),
      EParallel(x) -> all(x.branches),
      ETryBlock(x) -> count_in(x.body, p),
      ETagged(t) -> t.holes.fold(0, |n: Int, h: Hole| n + count_in(h.value, p)),
      _ -> 0,
    })
}

fn tries_in(e: Expr) -> Int = count_in(e, |x: Expr| match x { ETry(_) -> true, _ -> false })

/// Only when the grammar met a `?` or a law schema. A record update needs the checker's answer for
/// its base, so `expand_record_updates` runs later, over a checked program.
pub fn expand(
  module: Module,
  diags: List<ParseDiag>,
) -> { module: Module, diags: List<ParseDiag> } / {abort.raise} = {
  let tried = if has_try(module) { expand_try(module, diags) }
  else { { module: module, diags: diags } };
  let made = with_schema_fns(tried.module);
  { module: made, diags: rebound(made, tried.diags) }
}

// --- The law schema ----------------------------------------------------------------------------

/// A schema is also the definitions its instantiations call: its body over its parameters and then
/// its binders, and its guard the same as `<name>_where`. Each is `transparent`, so a claim in
/// another package reads the body it instantiates, and may raise or not return, as a law body may,
/// and perform its row parameter, which an instantiation fills. Both carry the schema's doc.
fn schema_fns(d: SchemaDef) -> List<Item> = {
  let at = d.name.span;
  let ident = |t: Bytes| { name: t, span: at };
  let params = d.params.concat(d.binders).map(|b: Binder|
    { name: b.name, ty: Some(b.ty), cost: None, default: None, span: b.span });
  let row = {
    atoms: [
      // As the grammar writes an operation's atom: the checker reads its mode off the declaration.
      {
        eff: bare(ident(b"abort")),
        mode: MWrite,
        op: Some(ident(b"raise")),
        resource: None,
        every: false,
        bounded: false,
        span: at,
      },
    ],
    aliases: [bare(ident(b"diverges"))],
    tail: d.generics.effects.at(0),
    tail_bounded: false,
    span: at,
  };
  let made = |name: Ident, body: Expr|
    IFn({
      vis: d.vis,
      name: name,
      generics: d.generics,
      params: params,
      ret: Some(nullary(bare(ident(b"Bool")))),
      effects: Some(row),
      constraints: [],
      spec: [],
      returns: None,
      reuse: None,
      transparent: Some(at),
      baked: None,
      decreases: None,
      body: body,
      doc: d.doc,
      span: d.span,
    });
  match d.guard {
    None -> [made(d.name, d.body)],
    // In the order a schema writes them, which is the order its expressions are walked in.
    Some(g) -> [made(ident(schema_guard_name(d.name.name)), g), made(d.name, d.body)],
  }
}

fn with_schema_fns(module: Module) -> Module =
  if !module.items.fold(false, |found: Bool, item: Item|
      found || (match item { ISchema(_) -> true, _ -> false })) { module } else {
    {
      ..module,
      items: module.items.fold([], |acc: List<Item>, item: Item|
        match item { ISchema(d) -> acc.push(item).concat(schema_fns(d)), _ -> acc.push(item) }),
    }
  }

pub fn dump_expanded(src: Bytes) -> String / {abort.raise} = {
  let r = parse(src);
  let x = expand(r.node, r.parser.diags);
  String::of_bytes(dump_module(x.module).concat(dump_diags(x.diags)))
}

// --- Tests ------------------------------------------------------------------

test "a `?` on a `let` splits the block at that statement, failure arm first" {
  assert_eq(
    dump_expanded(b"fn f(n: Int) -> Result<Int, Bytes> = { let x = g(n)?; Ok(x + 1) }"),
    "#0;#1;0:65:fn;%priv;?0;?0;?0;3:4:ident;@66;%gen;#0;#0;#0;#1;5:11:prm;5:6:ident;@6e;?1;8:11:tcon;8:11:qname;?0;8:11:ident;@496e74;#0;?0;?1;16:34:tcon;16:22:qname;?0;16:22:ident;@526573756c74;#2;23:26:tcon;23:26:qname;?0;23:26:ident;@496e74;#0;28:33:tcon;28:33:qname;?0;28:33:ident;@4279746573;#0;?0;#0;#0;37:65:eblk;#0;?1;47:52:emat;47:51:eapp;47:48:evar;47:48:qname;?0;47:48:ident;@67;#1;49:50:evar;49:50:qname;?0;49:50:ident;@6e;#0;#0;#2;47:52:arm;47:52:pctr;47:52:qname;?0;47:52:ident;@457272;#1;47:52:pvar;47:52:ident;@3f30;?0;47:52:eapp;47:52:evar;47:52:qname;?0;47:52:ident;@457272;#1;47:52:evar;47:52:qname;?0;47:52:ident;@3f30;#0;#0;47:52:arm;47:52:pctr;47:52:qname;?0;47:52:ident;@4f6b;#1;43:44:pvar;43:44:ident;@78;?0;47:52:eblk;#0;?1;54:63:eapp;54:56:evar;54:56:qname;?0;54:56:ident;@4f6b;#1;57:62:ebin;%add;57:58:evar;57:58:qname;?0;57:58:ident;@78;61:62:elit;%int;@31;#0;#0;#0;",
  )
}

test "a `?` inside a return-position expression lifts to its head, and an `Option` names `None`" {
  assert_eq(
    dump_expanded(b"fn f(n: Int) -> Option<Int> = Some(g(n)? + 1)"),
    "#0;#1;0:45:fn;%priv;?0;?0;?0;3:4:ident;@66;%gen;#0;#0;#0;#1;5:11:prm;5:6:ident;@6e;?1;8:11:tcon;8:11:qname;?0;8:11:ident;@496e74;#0;?0;?1;16:27:tcon;16:22:qname;?0;16:22:ident;@4f7074696f6e;#1;23:26:tcon;23:26:qname;?0;23:26:ident;@496e74;#0;?0;#0;#0;35:40:emat;35:39:eapp;35:36:evar;35:36:qname;?0;35:36:ident;@67;#1;37:38:evar;37:38:qname;?0;37:38:ident;@6e;#0;#0;#2;35:40:arm;35:40:pctr;35:40:qname;?0;35:40:ident;@4e6f6e65;#0;?0;35:40:evar;35:40:qname;?0;35:40:ident;@4e6f6e65;35:40:arm;35:40:pctr;35:40:qname;?0;35:40:ident;@536f6d65;#1;35:40:pvar;35:40:ident;@3f30;?0;30:45:eapp;30:34:evar;30:34:qname;?0;30:34:ident;@536f6d65;#1;35:44:ebin;%add;35:40:evar;35:40:qname;?0;35:40:ident;@3f30;43:44:elit;%int;@31;#0;#0;#0;",
  )
}

test "a `?` in a function with no written return type is refused and unwrapped" {
  assert_eq(
    dump_expanded(b"fn f(n: Int) = g(n)?"),
    "#0;#1;0:20:fn;%priv;?0;?0;?0;3:4:ident;@66;%gen;#0;#0;#0;#1;5:11:prm;5:6:ident;@6e;?1;8:11:tcon;8:11:qname;?0;8:11:ident;@496e74;#0;?0;?0;?0;#0;#0;15:19:eapp;15:16:evar;15:16:qname;?0;15:16:ident;@67;#1;17:18:evar;17:18:qname;?0;17:18:ident;@6e;#0;#0;#1;!E0118:15:20:1:1;=15:20:1;",
  )
}

test "a `?` inside a `try` is refused, as one inside a `handle` is" {
  let out = dump_expanded(b"fn f(n: Int) -> Result<Int, Bytes> = { let r = try { g(n)? }; Ok(1) }");
  assert(out.contains("!E0118"))
}

test "a `try` and a tagged literal are refused where the module binds what they are written out with" {
  let refused = |src: Bytes| dump_expanded(src).contains("!E0118");
  let tried = b"fn f(b: Int) -> Int = match try { digit(b) } { _ -> 1 }";
  let tagged = b"fn f() -> Int = hex\"00\"";
  assert(!refused(tried));
  assert(!refused(tagged));
  assert(refused(b"type Mine = | Err(Int) | Fine\n".concat(tried)));
  assert(refused(b"import m (Ok)\n".concat(tried)));
  assert(refused(b"type Mine = | Ok(Int) | Fine\n".concat(tagged)));
  assert(refused(b"import m (Ok)\n".concat(tagged)));
  assert(refused(b"fn Ok(n: Int) -> Int = n\n".concat(tagged)));
  // A tagged literal is read through `Ok` alone.
  assert(!refused(b"type Mine = | Err(Int) | Fine\n".concat(tagged)));
  // A type imported by name brings no constructor with it.
  assert(!refused(b"import m (Mine)\n".concat(tried)))
}

test "a tagged literal and a `try` in a test's label or its table are read as those in its body are" {
  let over = parse(
    b"test \"t {hex\"01\"}\" for n: Int in [hex\"02\"] { assert(n > hex\"03\") }",
  ).node;
  assert(has_tagged(over));
  assert_eq(tagged_in(over).map(|t: Tagged| t.text), [b"01", b"02", b"03"]);
  let refused = |src: Bytes| dump_expanded(src).contains("!E0118");
  let labelled = b"test \"t {hex\"01\"}\" for n: Int in [1] { () }";
  let tabled = b"test \"t {n}\" for n: Int in [try { g(1) }] { () }";
  assert(!refused(labelled) && !refused(tabled));
  assert(refused(b"type Mine = | Ok(Int) | Fine\n".concat(labelled)));
  assert(refused(b"type Mine = | Err(Int) | Fine\n".concat(tabled)))
}

test "a tagged literal's holes are read as a call's arguments are, and it runs as its tag's `fill`" {
  let holding = b"fn f(n: Int) -> Result<Int, Bytes> = Ok(List::len(sh\"a {g(n)?} {sh\"b\"} {try { sh\"c {n}\" }}\"))";
  // One that holds another is read before it.
  assert_eq(tagged_in(parse(holding).node).map(|t: Tagged| t.text), [b"a ", b"b", b"c "]);
  // A `?` in a hole is lifted to the head of what holds the literal.
  let out = dump_expanded(holding);
  assert(!out.contains(":etry;") && out.contains(":emat;"));
  assert(!out.contains("!E0118") && !out.contains("!E0119"));
  // Each is read through `Ok`, one inside a hole included.
  let nested = b"type Mine = | Ok(Int) | Fine\nfn f(n: Int) -> Int = sh\"a {sh\"b {n}\"}\"";
  assert_eq(dump_expanded(nested).split("!E0118").len(), 3);
  // Written out, its texts go to `compile`, and what that answers to `fill` with the holes.
  let written = String::of_bytes(
    dump_module(expand_tagged(parse(b"fn f(n: Int) -> Int = sh\"a {sh\"b\"}\"").node)),
  );
  assert(!written.contains(":etag;"));
  assert(written.contains("@636f6d70696c65;") && written.contains("@66696c6c;"));
  assert(written.contains("@6c69746572616c;"))
}

test "a `try` the checker read is written out as its `handle`, and one it did not is left" {
  let module = parse(b"fn f(n: Int) -> Int = try { g(n) }").node;
  let written = |answered: Map<Bytes, Answered>|
    String::of_bytes(dump_module(expand_try_blocks(module, answered)));
  let left = written(Map::new());
  assert(left.contains("22:34:etrb;"));
  let out = written(
    Map::new().insert(span_key(span_between(22, 34)), { effect: b"m.p", op: b"bad", arity: 2 }),
  );
  assert(out.contains("22:34:ehnd;"));
  // The clause names its effect program-wide, as `?m.p`, and answers the tuple of what it binds.
  assert(out.contains("@3f6d2e70;"));
  assert(out.contains("@5f31;"));
  assert_eq(named_program_wide(program_wide(b"m.p")), Some(b"m.p"));
  assert_eq(named_program_wide(b"p"), None)
}

test "a `?` on a `let` with a written type keeps the annotation" {
  let out = dump_expanded(
    b"fn f(n: Int) -> Result<Int, Bytes> = { let x: Int = g(n)?; Ok(x + 1) }",
  );
  assert(!out.contains("!E0119"));
  assert(out.contains("@3f30"))
}

test "a schema is also the definitions its instantiations call, `transparent` and under its doc" {
  let x = expand(
    parse(
      b"/// Held.\npub law schema s(f: (Int) -> Int) forall (x: Int) where x > 0 { f(x) == x }\n",
    ).node,
    [],
  );
  let made = x.module.items.fold(
    [],
    |acc: List<{ name: Bytes, params: Int, read: Bool, doc: Bool }>, item: Item|
      match item {
        IFn(d) ->
          acc.push({
            name: d.name.name,
            params: d.params.len(),
            read: d.transparent != None,
            doc: d.doc != None,
          }),
        _ -> acc,
      },
  );
  assert_eq(made, [
    { name: b"s_where", params: 2, read: true, doc: true },
    { name: b"s", params: 2, read: true, doc: true },
  ])
}

test "a tagged literal and a `try` in a schema or in what a law instantiates one with are read once" {
  let schema = b"law schema s(f: (Int) -> Int) forall (x: Int) where x > hex\"01\" { f(x) == hex\"02\" }\n";
  let made = b"law \"l\" = s(|n: Int| n + hex\"03\")\n";
  let over = expand(parse(schema.concat(made)).node, []).module;
  assert_eq(tagged_in(over).map(|t: Tagged| t.text), [b"01", b"02", b"03"]);
  // Once resolved, an instantiation's guard holds the arguments its body does.
  let resolved = over.items.map(|item: Item|
    match item { ILaw(d) -> ILaw({ ..d, guard: Some(d.body) }), _ -> item });
  assert_eq(tagged_in({ ..over, items: resolved }).map(|t: Tagged| t.text), [b"01", b"02", b"03"]);
  let refused = |src: Bytes| dump_expanded(src).contains("!E0118");
  assert(!refused(schema) && !refused(schema.concat(made)));
  assert(refused(b"type Mine = | Ok(Int) | Fine\n".concat(schema)));
  assert(
    refused(
      b"type Mine = | Ok(Int) | Fine\nlaw schema s(f: (Int) -> Int) forall (x: Int) { f(x) == x }\n".concat(
        made,
      ),
    ),
  );
  assert(
    refused(
      b"type Mine = | Ok(Int) | Err(Int)\nlaw schema s(f: (Int) -> Int) forall (x: Int) { try { f(x) } == Mine::Ok(x) }\n",
    ),
  )
}
