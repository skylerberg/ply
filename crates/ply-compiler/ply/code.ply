// The lowered form the code generator reads: slots resolved and ownership marked.

import spine (Span, Ident, QName, dummy_span, num, span_key)
import patterns (Pattern, PWild, PVar, PLit, PCtor, PRecord, PList, PBad, Lit, LInt, LFixed, LBool, LStr, LBytes, LFloat, LDec, LUnit, LBad)
import exprs (HandleClause, MatchArm, Param, Expr, ELit, EVar, EBinary, EUnary, EApp, EIf, EBlock, EList,
              ERecord, EField, ELambda, EMatch, EPerform, EHandle, EWithCell,
              ESimulate, EBad, ERecordUpdate, ETry, Stmt, SLet, SExpr,
              RecField, expr_span)
import items (Module, Item, IFn, parse)
import rewrite (expand)

// How a read takes its value.
pub type Own = | Borrowed | Owned

pub fn own_tag(o: Own) -> Bytes =
  match o { Borrowed -> b"b", Owned -> b"o" }

// One lowered node: what it is, and how the read that produced it takes it.
pub type Code = { own: Own, node: Node, span: Span }

pub type Node =
  | NLit(Lit)
  | NVar({ name: Bytes, slot: Option<Int> })
  | NUnary({ op: Bytes, operand: Code })
  | NBinary({ op: Bytes, lhs: Code, rhs: Code })
  | NApp({ func: Code, args: List<Code> })
  | NIf({ cond: Code, then_branch: Code, else_branch: Code })
  | NBlock({ stmts: List<CStmt>, tail: Option<Code> })
  | NList({ items: List<Code> })
  | NRecord({ fields: List<CField> })
  | NMatch({ scrutinee: Code, arms: List<CArm> })
  // `label` is the read of the label parameter the resource names, when a binder holds it.
  | NPerform({ effect: Bytes, op: Bytes, resource: Bytes, label: Option<Code>, args: List<Code> })
  // One label argument of a call: the field-table entry of a resource named here.
  | NLabel(Bytes)
  | NCell({ resource: Bytes, binder: Bytes, slot: Option<Int>, init: Code, body: Code })
  | NLambda({ params: Int, size: Int, caps: List<Cap>, body: Code })
  | NSim({ size: Int, caps: List<Cap>, body: Code })
  | NHandle({ body: Code, clauses: List<CClause>, ret: Option<CRet> })
  | NField({ base: Code, field: Bytes })
  // `{..b, f: e}`, recognised in a plain literal where some field is `b.<its own name>` for one slot variable `b`.
  | NUpd({ base: Code, copies: List<Bytes>, sets: List<CField> })

pub type CField = { name: Bytes, value: Code }

// A pattern with its binders resolved to slots, so a match writes bindings straight into the window.
pub type CPat =
  | PxWild
  | PxVar({ name: Bytes, slot: Option<Int> })
  | PxLit(Lit)
  | PxCtor({ name: Bytes, args: List<CPat> })
  | PxRecord({ fields: List<CPatField>, rest: Bool })
  | PxList({ items: List<CPat>, rest: Option<CPat> })

pub type CPatField = { name: Bytes, pat: CPat }

pub type CArm = { pat: CPat, guard: Option<Code>, body: Code }

// A free name a barrier copies in on entry: its slot outside, its slot here, and how the copy reads it.
pub type Cap = { src: Int, dst: Int, own: Own }

// A handler clause opens its own barrier: its parameters and `resume` binder take the leading slots.
pub type CClause = { effect: Bytes, op: Bytes, resource: Bytes, label: Option<Code>, params: Int,
                     resume: Bool, size: Int, caps: List<Cap>, body: Code }

pub type CRet = { size: Int, caps: List<Cap>, body: Code }

// `CLet`'s slot is what the ownership pass drops when it walks backwards past the binder.
pub type CStmt =
  | CLet({ name: Bytes, slot: Int, value: Code })
  // `let <pattern> = e`: the value is bound as a whole and the pattern's names read out of it.
  | CLetPat({ span: Span, pat: CPat, value: Code })
  | CDo({ code: Code })

// --- the dump ---------------------------------------------------------------
// `ply_prove::prove::claims` reads this back, so every spelling here is load-bearing.

// A resource a label parameter names is the slot it reads, which stays one comma-free word.
fn res_tag(name: Bytes, label: Option<Code>) -> Bytes =
  match label {
    None -> name,
    Some(c) -> match c.node { NVar(v) -> bytes_concat(b"$", slot_tag(v.slot)), _ -> name },
  }

pub fn dump_lit(l: Lit) -> Bytes =
  match l {
    LInt(n) -> bytes_concat(b"i", num(n)),
    // Lowercased, so the dump has one spelling whatever case the suffix was written in.
    LFixed(name, bits) -> bytes_concat_all([b"x", lower_bytes(name), b":", num(bits)]),
    LBool(b) -> if b { b"T" } else { b"F" },
    LStr(s) -> bytes_concat_all([b"s", num(bytes_len(s)), b":", hex(s)]),
    LBytes(s) -> bytes_concat_all([b"y", num(bytes_len(s)), b":", hex(s)]),
    LFloat(_) -> b"f",
    LDec(r) -> bytes_concat_all([b"d", num(bytes_len(r)), b":", hex(r)]),
    // Parser placeholders: never in a checked program's tree, so they dump as themselves.
    LUnit -> b"u",
    LBad -> b"!",
  }

fn lower_bytes(s: Bytes) -> Bytes =
  fold(range(0, bytes_len(s)), b"", |acc: Bytes, i: Int| {
    let c = bytes_at(s, i);
    bytes_concat(acc, byte_of_int(if c >= 65 && c <= 90 { c + 32 } else { c }))
  })

fn hex_digit(v: Int) -> Bytes =
  bytes_slice(b"0123456789abcdef", v, v + 1)

pub fn hex(s: Bytes) -> Bytes =
  fold(range(0, bytes_len(s)), b"", |acc: Bytes, i: Int| {
    let byte = bytes_at(s, i);
    bytes_concat_all([acc, hex_digit(byte / 16), hex_digit(byte % 16)])
  })

fn slot_tag(s: Option<Int>) -> Bytes =
  match s { Some(n) -> num(n), None -> b"-" }

fn dump_caps(cs: List<Cap>) -> Bytes =
  bytes_concat_all([b"[",
                    fold(cs, b"", |acc: Bytes, c: Cap|
                      bytes_concat_all([acc, num(c.src), b">", num(c.dst), own_tag(c.own), b" "])),
                    b"]"])

pub fn dump_pat(p: CPat) -> Bytes =
  match p {
    PxWild -> b"_",
    PxVar(v) -> bytes_concat_all([b"v:", v.name, b":", slot_tag(v.slot)]),
    PxLit(l) -> bytes_concat(b"l:", dump_lit(l)),
    PxCtor(c) ->
      bytes_concat_all([b"c:", c.name, b"(",
                        fold(c.args, b"", |acc: Bytes, a: CPat| bytes_concat_all([acc, dump_pat(a), b","])),
                        b")"]),
    PxRecord(r) ->
      bytes_concat_all([b"r:(",
                        fold(r.fields, b"", |acc: Bytes, f: CPatField|
                          bytes_concat_all([acc, f.name, b"=", dump_pat(f.pat), b","])),
                        if r.rest { b"..)" } else { b")" }]),
    PxList(l) ->
      bytes_concat_all([b"s:(",
                        fold(l.items, b"", |acc: Bytes, i: CPat| bytes_concat_all([acc, dump_pat(i), b","])),
                        match l.rest { Some(r) -> bytes_concat(b"..", dump_pat(r)), None -> b"" },
                        b")"]),
  }

pub fn dump(c: Code) -> Bytes =
  bytes_concat(own_tag(c.own), dump_node(c.node))

fn dump_node(n: Node) -> Bytes =
  match n {
    NLit(l) -> bytes_concat_all([b"lit(", dump_lit(l), b")"]),
    NVar(v) -> bytes_concat_all([b"var(", v.name, b",", slot_tag(v.slot), b")"]),
    NUnary(u) -> bytes_concat_all([b"un(", u.op, b",", dump(u.operand), b")"]),
    NBinary(b) ->
      bytes_concat_all([b"bin(", b.op, b",", dump(b.lhs), b",", dump(b.rhs), b")"]),
    NApp(a) ->
      bytes_concat_all([b"app(", dump(a.func),
                        fold(a.args, b"", |acc: Bytes, x: Code| bytes_concat_all([acc, b",", dump(x)])),
                        b")"]),
    NIf(i) ->
      bytes_concat_all([b"if(", dump(i.cond), b",", dump(i.then_branch), b",",
                        dump(i.else_branch), b")"]),
    NBlock(b) ->
      bytes_concat_all([b"block(",
                        fold(b.stmts, b"", |acc: Bytes, s: CStmt|
                          bytes_concat(acc, match s {
                            CLet(l) -> bytes_concat_all([b"let(v:", l.name, b":", num(l.slot), b",", dump(l.value), b"),"]),
                            CLetPat(l) -> bytes_concat_all([b"let(", dump_pat(l.pat), b",", dump(l.value), b"),"]),
                            CDo(d) -> bytes_concat_all([b"do(", dump(d.code), b"),"]),
                          })),
                        match b.tail { Some(t) -> dump(t), None -> b"-" },
                        b")"]),
    NList(l) ->
      bytes_concat_all([b"list(",
                        fold(l.items, b"", |acc: Bytes, x: Code| bytes_concat_all([acc, dump(x), b","])),
                        b")"]),
    NRecord(r) ->
      bytes_concat_all([b"rec(",
                        fold(r.fields, b"", |acc: Bytes, fd: CField|
                          bytes_concat_all([acc, fd.name, b"=", dump(fd.value), b","])),
                        b")"]),
    NMatch(m) ->
      bytes_concat_all([b"match(", dump(m.scrutinee),
                        fold(m.arms, b"", |acc: Bytes, a: CArm|
                          bytes_concat_all([acc, b",arm(", dump_pat(a.pat), b",",
                                            match a.guard { Some(g) -> dump(g), None -> b"-" },
                                            b",", dump(a.body), b")"])),
                        b")"]),
    NLabel(n) -> bytes_concat_all([b"label(", n, b")"]),
    NPerform(p) ->
      bytes_concat_all([b"perform(", p.effect, b",", p.op, b",", res_tag(p.resource, p.label),
                        fold(p.args, b"", |acc: Bytes, a: Code| bytes_concat_all([acc, b",", dump(a)])),
                        b")"]),
    NCell(c) ->
      bytes_concat_all([b"cell(", c.resource, b",", c.binder, b",", slot_tag(c.slot), b",",
                        dump(c.init), b",", dump(c.body), b")"]),
    NSim(sm) ->
      bytes_concat_all([b"sim(", num(sm.size), b",", dump_caps(sm.caps), b",", dump(sm.body), b")"]),
    NHandle(h) ->
      bytes_concat_all([b"handle(", dump(h.body),
                        fold(h.clauses, b"", |acc: Bytes, c: CClause|
                          bytes_concat_all([acc, b",cl(", c.effect, b",", c.op, b",", res_tag(c.resource, c.label), b",",
                                            num(c.params), b",", if c.resume { b"true" } else { b"false" },
                                            b",", num(c.size), b",", dump_caps(c.caps), b",",
                                            dump(c.body), b")"])),
                        match h.ret {
                          Some(r) -> bytes_concat_all([b",ret(", num(r.size), b",", dump_caps(r.caps),
                                                       b",", dump(r.body), b")"]),
                          None -> b",-",
                        },
                        b")"]),
    NLambda(l) ->
      bytes_concat_all([b"lam(", num(l.params), b",", num(l.size), b",", dump_caps(l.caps), b",",
                        dump(l.body), b")"]),
    NField(f) -> bytes_concat_all([b"fld(", dump(f.base), b",", f.field, b")"]),
    NUpd(u) -> bytes_concat_all([b"upd(", dump(u.base),
      fold(u.copies, b"", |acc: Bytes, n: Bytes| bytes_concat_all([acc, b",c:", n])),
      fold(u.sets, b"", |acc: Bytes, f: CField|
        bytes_concat_all([acc, b",s:", f.name, b"=", dump(f.value)])), b")"]),
  }

// --- slots ------------------------------------------------------------------
// Forward pass: every binding gets a slot and slot numbers never go back, so a window is sized by
// bindings, not by how many are live at once.

type Bind = { name: Bytes, slot: Int }

// `names` is the barrier's window in order; `scope` is what is visible here, innermost last.
type Frame = { names: List<Bytes>, scope: List<Bind>, caps: List<Cap>, capnames: List<Bytes> }

fn bind(f: Frame, name: Bytes) -> Frame =
  { names: push(f.names, name),
    scope: push(f.scope, { name: name, slot: len(f.names) }),
    caps: f.caps, capnames: f.capnames }

fn find(f: Frame, name: Bytes) -> Option<Int> =
  fold(f.scope, None, |acc: Option<Int>, b: Bind|
    if b.name == name { Some(b.slot) } else { acc })

// The barriers in scope, innermost last. A free name is threaded through every barrier between use and binding.
type Stack = { frames: List<Frame>, labels: List<Bytes>, sites: Map<Bytes, List<Bytes>> }

fn st_top(st: Stack) -> Frame =
  match list_at(st.frames, len(st.frames) - 1) { Some(f) -> f, None -> empty_frame() }

fn empty_frame() -> Frame = { names: [], scope: [], caps: [], capnames: [] }

fn st_at(st: Stack, i: Int) -> Frame =
  match list_at(st.frames, i) { Some(f) -> f, None -> empty_frame() }

fn st_set(st: Stack, i: Int, f: Frame) -> Stack =
  { frames: map(range(0, len(st.frames)), |j: Int| if j == i { f } else { st_at(st, j) }), labels: st.labels, sites: st.sites }

fn st_top_set(st: Stack, f: Frame) -> Stack = st_set(st, len(st.frames) - 1, f)

fn st_push(st: Stack, f: Frame) -> Stack = { frames: push(st.frames, f), labels: st.labels, sites: st.sites }

fn st_pop(st: Stack) -> Stack =
  { frames: map(range(0, len(st.frames) - 1), |j: Int| st_at(st, j)), labels: st.labels, sites: st.sites }

// The depth whose barrier has `name` in scope or already captures it, innermost first.
fn st_depth(st: Stack, name: Bytes) -> Option<Int> =
  fold(range(0, len(st.frames)), None, |acc: Option<Int>, i: Int| {
    let f = st_at(st, i);
    match find(f, name) {
      Some(_) -> Some(i),
      None -> match find_cap(f, name) { Some(_) -> Some(i), None -> acc },
    }
  })

fn slot_in(f: Frame, name: Bytes) -> Option<Int> =
  match find(f, name) { Some(s) -> Some(s), None -> find_cap(f, name) }

// Resolves `name` at the innermost barrier, threading a capture through every barrier between when it is free.
type Resolved = { slot: Option<Int>, st: Stack }

fn resolve(st: Stack, name: Bytes) -> Resolved =
  match st_depth(st, name) {
    None -> { slot: None, st: st },
    Some(d) -> {
      let start = match slot_in(st_at(st, d), name) { Some(s) -> s, None -> 0 };
      fold(range(d + 1, len(st.frames)), { slot: Some(start), st: st },
        |acc: Resolved, i: Int| {
          let f = st_at(acc.st, i);
          let from = match acc.slot { Some(s) -> s, None -> 0 };
          match find_cap(f, name) {
            Some(s) -> { slot: Some(s), st: acc.st },
            None -> {
              let g = capture(f, name, from);
              { slot: find_cap(g, name), st: st_set(acc.st, i, g) }
            },
          }
        })
    },
  }

// A resource a label binder holds is read like any other name, captures threaded and all.
fn label_code(st: Stack, name: Bytes) -> Option<Out> =
  if !has_bytes(st.labels, name) { None } else {
    let r = resolve(st, name);
    Some({ code: { own: Borrowed, span: dummy_span(), node: NVar({ name: name, slot: r.slot }) }, st: r.st })
  }

type Labels = { codes: List<Code>, st: Stack }

// The labels a call fills: this body's own parameter, or a field-table entry of the name.
fn label_args(st: Stack, s: Span) -> Labels =
  fold(match map_get(st.sites, span_key(s)) { Some(xs) -> xs, None -> [] },
       { codes: [], st: st }, |acc: Labels, n: Bytes|
    match label_code(acc.st, n) {
      Some(o) -> { codes: push(acc.codes, o.code), st: o.st },
      None -> { codes: push(acc.codes, { own: Borrowed, span: dummy_span(), node: NLabel(n) }), st: acc.st },
    })

// A block's binders leave scope at its end, but the slots they took are never reused.
fn bind_st(st: Stack, name: Bytes) -> Stack = st_top_set(st, bind(st_top(st), name))

fn unscope(f: Frame, to: Int) -> Frame =
  { names: f.names, scope: take(f.scope, to), caps: f.caps, capnames: f.capnames }

fn unscope_st(st: Stack, to: Int) -> Stack = st_top_set(st, unscope(st_top(st), to))

fn depth_of(st: Stack) -> Int = len(st_top(st).scope)

fn find_cap(f: Frame, name: Bytes) -> Option<Int> =
  fold(range(0, len(f.capnames)), None, |acc: Option<Int>, i: Int|
    if nth_bytes(f.capnames, i) == name {
      match list_at(f.caps, i) { Some(c) -> Some(c.dst), None -> acc }
    } else { acc })

// The own mark is `Borrowed` here; the enclosing barrier's backward pass rewrites it.
fn capture(f: Frame, name: Bytes, src: Int) -> Frame =
  { names: push(f.names, name),
    scope: f.scope,
    caps: push(f.caps, { src: src, dst: len(f.names), own: Borrowed }),
    capnames: push(f.capnames, name) }

fn take(xs: List<Bind>, n: Int) -> List<Bind> =
  fold(range(0, n), [], |acc: List<Bind>, i: Int| push(acc, at(xs, i)))

fn at(xs: List<Bind>, i: Int) -> Bind =
  match list_at(xs, i) { Some(x) -> x, None -> { name: b"", slot: 0 } }

// --- the lowering -----------------------------------------------------------
// `None` for a form not lowered. Every node is built `Borrowed`; `mark` sets ownership.

pub fn covers() -> List<Bytes> =
  [b"literals", b"unary", b"binary", b"if", b"list", b"field", b"application",
   b"records", b"blocks and `let`", b"parameters and their slots",
   b"the ownership marks", b"match, its guards and every pattern form",
   b"perform and with_cell",
   b"a lambda and the names it captures, through any depth of barrier",
   b"handle with its clauses and return arm, and simulate"]

type Out = { code: Code, st: Stack }

fn lower_in(e: Expr, st: Stack) -> Option<Out> =
  match e {
    ELit(x) -> Some({ code: { own: Borrowed, span: expr_span(e), node: NLit(x.lit) }, st: st }),
    // `ERecordUpdate` is written out as a literal before lowering; `as_update` recognises the result.
    EVar(x) -> match x.name.module {
      // A qualified name is a global, never a slot: a module binder cannot be shadowed by a local.
      Some(m) -> Some({
        code: { own: Borrowed, span: expr_span(e),
                node: NVar({ name: bytes_concat_all([m.name, b"::", x.name.name.name]),
                             slot: None }) },
        st: st }),
      None -> {
        let name = x.name.name.name;
        let r = resolve(st, name);
        Some({ code: { own: Borrowed, span: expr_span(e), node: NVar({ name: name, slot: r.slot }) }, st: r.st })
      },
    },
    EUnary(x) -> match lower_in(x.operand, st) {
      Some(o) -> Some({ code: { own: Borrowed, span: expr_span(e), node: NUnary({ op: x.op, operand: o.code }) }, st: o.st }),
      None -> None,
    },
    EBinary(x) -> match lower_in(x.lhs, st) {
      None -> None,
      Some(l) -> match lower_in(x.rhs, l.st) {
        None -> None,
        Some(r) -> Some({ code: { own: Borrowed, span: expr_span(e), node: NBinary({ op: x.op, lhs: l.code, rhs: r.code }) }, st: r.st }),
      },
    },
    EIf(x) -> match lower_in(x.cond, st) {
      None -> None,
      Some(c) -> match lower_in(x.then_branch, c.st) {
        None -> None,
        Some(t) -> match lower_in(x.else_branch, t.st) {
          None -> None,
          Some(el) -> Some({ code: { own: Borrowed, span: expr_span(e), node: NIf({ cond: c.code, then_branch: t.code, else_branch: el.code }) }, st: el.st }),
        },
      },
    },
    EField(x) -> match lower_in(x.base, st) {
      Some(b) -> Some({ code: { own: Borrowed, span: expr_span(e), node: NField({ base: b.code, field: x.field.name }) }, st: b.st }),
      None -> None,
    },
    EList(x) -> match lower_seq(x.items, st) {
      Some(r) -> Some({ code: { own: Borrowed, span: expr_span(e), node: NList({ items: r.codes }) }, st: r.st }),
      None -> None,
    },
    ERecord(x) -> match as_update(x.fields, st) {
      Some(u) -> Some(u),
      None ->
      match lower_seq(map(x.fields, |fd: RecField| fd.value), st) {
        None -> None,
        Some(r) -> Some({
          code: { own: Borrowed, span: expr_span(e), node: NRecord({
            fields: map(range(0, len(x.fields)), |i: Int|
              { name: field_name(x.fields, i), value: nth(r.codes, i) }) }) },
          st: r.st,
        }),
      },
    },
    EApp(x) ->
      if len(x.named) > 0 { None } else {
        match lower_in(x.func, st) {
          None -> None,
          Some(fu) -> match lower_seq(x.args, fu.st) {
            Some(r) -> {
              let ls = label_args(r.st, expr_span(e));
              Some({ code: { own: Borrowed, span: expr_span(e),
                             node: NApp({ func: fu.code, args: fold(ls.codes, r.codes, |acc: List<Code>, cd: Code| push(acc, cd)) }) },
                     st: ls.st })
            },
            None -> None,
          },
        }
      },
    EMatch(x) -> match lower_in(x.scrutinee, st) {
      None -> None,
      Some(sc) -> {
        let depth = depth_of(sc.st);
        let walked = fold(x.arms, { arms: [], st: sc.st, ok: true },
          |acc: ArmAcc, a: MatchArm|
            if !acc.ok { acc } else {
              // Arm binders leave scope at the arm's end; their slots are not reused.
              let pd = depth_of(acc.st);
              let pat = lower_pat(a.pat, acc.st);
              match lower_guard(a.guard, pat.st) {
                None -> { arms: acc.arms, st: acc.st, ok: false },
                Some(g) -> match lower_in(a.body, g.st) {
                  None -> { arms: acc.arms, st: acc.st, ok: false },
                  Some(b) -> { arms: push(acc.arms, { pat: pat.pat, guard: g.code, body: b.code }),
                               st: unscope_st(b.st, pd), ok: true },
                },
              }
            });
        if !walked.ok { None } else {
          Some({ code: { own: Borrowed, span: expr_span(e), node: NMatch({ scrutinee: sc.code, arms: walked.arms }) },
                 st: unscope_st(walked.st, depth) })
        }
      },
    },
    EPerform(x) -> match lower_seq(x.args, st) {
      None -> None,
      Some(r) -> {
        let name = match x.resource { Some(id) -> id.name, None -> b"" };
        let lb = label_code(r.st, name);
        Some({
          code: { own: Borrowed, span: expr_span(e), node: NPerform({
            effect: qname_text(x.eff), op: x.op.name, resource: name,
            label: match lb { Some(o) -> Some(o.code), None -> None },
            args: r.codes }) },
          st: match lb { Some(o) -> o.st, None -> r.st } })
      },
    },
    // The binder is in scope for the body only; the init is evaluated before it exists.
    EWithCell(x) -> match lower_in(x.init, st) {
      None -> None,
      Some(i) -> {
        let depth = depth_of(i.st);
        let inner = bind_st(i.st, x.binder.name);
        match lower_in(x.body, inner) {
          None -> None,
          Some(b) -> Some({
            code: { own: Borrowed, span: expr_span(e), node: NCell({
              resource: x.resource.name, binder: x.binder.name,
              slot: slot_in(st_top(inner), x.binder.name), init: i.code, body: b.code }) },
            st: unscope_st(b.st, depth) }),
        }
      },
    },
    // A lambda opens its own barrier; a name it reads from outside becomes a capture.
    ELambda(x) -> {
      let params = map(x.params, |p: Param| p.name.name);
      let inner = fold(params, { names: [], scope: [], caps: [], capnames: [] }, |g: Frame, n: Bytes| bind(g, n));
      match lower_in(x.body, st_push(st, inner)) {
        None -> None,
        Some(b) -> Some(lam_of(params, b)),
      }
    },
    // `simulate` opens a barrier, as a lambda does, and takes no parameters.
    ESimulate(x) -> match lower_in(x.body, st_push(st, empty_frame())) {
      None -> None,
      Some(b) -> {
        let inner = st_top(b.st);
        Some({ code: { own: Borrowed, span: expr_span(e), node: NSim({ size: len(inner.names), caps: inner.caps,
                                                   body: mark(b.code, []).code }) },
               st: st_pop(b.st) })
      },
    },
    // The body runs in the enclosing barrier; each clause opens its own, led by its parameters and `resume`.
    EHandle(x) -> match lower_in(x.body, st) {
      None -> None,
      Some(b) -> {
        let cls = fold(x.clauses, { clauses: [], st: b.st, ok: true },
          |acc: ClauseAcc, c: HandleClause|
            if !acc.ok { acc } else {
              let names = match c.resume {
                Some(rid) -> push(map(c.params, |i: Ident| i.name), rid.name),
                None -> map(c.params, |i: Ident| i.name),
              };
              let inner = fold(names, empty_frame(), |g: Frame, n: Bytes| bind(g, n));
              // The clause's resource is read where the table is built, outside the clause's own barrier.
              let res = match c.resource { Some(id) -> id.name, None -> b"" };
              let lb = label_code(acc.st, res);
              let outer = match lb { Some(o) -> o.st, None -> acc.st };
              match lower_in(c.body, st_push(outer, inner)) {
                None -> { clauses: acc.clauses, st: acc.st, ok: false },
                Some(cb) -> {
                  let f = st_top(cb.st);
                  { clauses: push(acc.clauses, {
                      effect: qname_text(c.eff), op: c.op.name,
                      resource: res, label: match lb { Some(o) -> Some(o.code), None -> None },
                      params: len(c.params), resume: match c.resume { Some(_) -> true, None -> false },
                      size: len(f.names), caps: f.caps,
                      body: mark(cb.code, []).code }),
                    st: st_pop(cb.st), ok: true }
                },
              }
            });
        if !cls.ok { None } else {
          match x.ret {
            None -> Some({ code: { own: Borrowed, span: expr_span(e), node: NHandle({ body: b.code, clauses: cls.clauses,
                                                                  ret: None }) },
                           st: cls.st }),
            Some(r) -> {
              let inner = bind(empty_frame(), r.binder.name);
              match lower_in(r.body, st_push(cls.st, inner)) {
                None -> None,
                Some(rb) -> {
                  let f = st_top(rb.st);
                  Some({ code: { own: Borrowed, span: expr_span(e), node: NHandle({
                           body: b.code, clauses: cls.clauses,
                           ret: Some({ size: len(f.names), caps: f.caps,
                                       body: mark(rb.code, []).code }) }) },
                         st: st_pop(rb.st) })
                },
              }
            },
          }
        }
      },
    },
    EBlock(x) -> lower_block(x.stmts, x.tail, st),
    _ -> None,
  }

fn field_name(fs: List<RecField>, i: Int) -> Bytes =
  match list_at(fs, i) { Some(fd) -> fd.name.name, None -> b"" }

// Recovers an update from a literal whose copied fields are `b.<own name>` for one slot variable `b`;
// the base is read after every written field, which `mark` has to reflect.
fn as_update(fields: List<RecField>, st: Stack) -> Option<{ code: Code, st: Stack }> = {
  // Two different copied-from variables make this a plain literal.
  let copies = fold(fields, { names: [], bad: false }, |acc: { names: List<Bytes>, bad: Bool }, f: RecField|
    match copy_base(f, st) {
      None -> acc,
      Some(n) -> if len(acc.names) == 0 { { names: [n], bad: acc.bad } }
                 else if nth_bytes(acc.names, 0) == n { acc }
                 else { { names: acc.names, bad: true } },
    });
  if copies.bad { None } else {
    // With no copied field, a record projected from inside a written field is the base whose cells are reused.
    let base = if len(copies.names) == 1 { list_at(copies.names, 0) }
               else { fold(fields, None, |acc: Option<Bytes>, f: RecField|
                        match acc { Some(_) -> acc, None -> if copy_base(f, st) != None { None } else { projected_var(f.value, st, []) } }) };
    match base {
      None -> None,
      Some(name) -> {
        // Walked in field order, so each copy resolves the base, and each capture is numbered, where it stands.
        let walked = fold(fields, Some({ codes: [], st: st }), |acc: Option<Seq>, f: RecField|
          match acc {
            None -> None,
            Some(a) -> if copy_base(f, st) == Some(name) { Some({ codes: a.codes, st: resolve(a.st, name).st }) }
                       else { match lower_in(f.value, a.st) {
                         None -> None,
                         Some(o) -> Some({ codes: push(a.codes, o.code), st: o.st }),
                       } },
          });
        match walked {
          None -> None,
          Some(o) -> match resolve(o.st, name).slot {
            None -> None,
            Some(sl) -> {
              let copied = fold(fields, [], |acc: List<Bytes>, f: RecField|
                match copy_base(f, st) { Some(n) -> if n == name { push(acc, f.name.name) } else { acc }, None -> acc });
              let sets = filter(fields, |f: RecField| copy_base(f, st) != Some(name));
              Some({
                code: { own: Borrowed, span: dummy_span(), node: NUpd({
                  base: { own: Borrowed, span: dummy_span(), node: NVar({ name: name, slot: Some(sl) }) },
                  copies: copied,
                  sets: map(range(0, len(sets)), |i: Int|
                    { name: match list_at(sets, i) { Some(f) -> f.name.name, None -> b"" },
                      value: nth(o.codes, i) }) }) },
                st: o.st })
            },
          },
        }
      },
    }
  }
}

// The bare in-scope variable a field copies from, when the field is `b.<its own name>`.
fn copy_base(f: RecField, st: Stack) -> Option<Bytes> =
  match f.value {
    EField(x) -> if x.field.name != f.name.name { None } else {
      match x.base {
        EVar(v) -> if v.name.module != None { None }
                   else { match st_depth(st, v.name.name.name) { Some(_) -> Some(v.name.name.name), None -> None } },
        _ -> None,
      }
    },
    _ -> None,
  }

// The first in-scope variable a field read projects from inside `e`; a name `e` binds itself is never the base.
fn projected_var(e: Expr, st: Stack, inner: List<Bytes>) -> Option<Bytes> = {
  let first = |xs: List<Expr>| fold(xs, None, |acc: Option<Bytes>, x: Expr|
    match acc { Some(_) -> acc, None -> projected_var(x, st, inner) });
  match e {
    EField(x) -> match x.base {
      EVar(v) -> if v.name.module == None && !has_bytes(inner, v.name.name.name) && st_depth(st, v.name.name.name) != None
                 { Some(v.name.name.name) } else { projected_var(x.base, st, inner) },
      _ -> projected_var(x.base, st, inner),
    },
    EUnary(x) -> projected_var(x.operand, st, inner),
    EBinary(x) -> first([x.lhs, x.rhs]),
    EApp(x) -> first(push_front(x.args, x.func)),
    EIf(x) -> first([x.cond, x.then_branch, x.else_branch]),
    EMatch(x) -> projected_var(x.scrutinee, st, inner),
    EBlock(x) -> {
      let walked = fold(x.stmts, { found: None, inner: inner }, |acc: { found: Option<Bytes>, inner: List<Bytes> }, s: Stmt|
        match acc.found {
          Some(_) -> acc,
          None -> match s {
            SLet(l) -> { found: projected_var(l.value, st, acc.inner), inner: pat_binders(l.pat, acc.inner) },
            SExpr(v) -> { found: projected_var(v, st, acc.inner), inner: acc.inner },
          },
        });
      match walked.found {
        Some(n) -> Some(n),
        None -> match x.tail { Some(t) -> projected_var(t, st, walked.inner), None -> None },
      }
    },
    ERecord(x) -> first(map(x.fields, |f: RecField| f.value)),
    ERecordUpdate(x) -> first(push_front(map(x.fields, |f: RecField| f.value), x.base)),
    ETry(x) -> projected_var(x.operand, st, inner),
    EList(x) -> first(x.items),
    EPerform(x) -> first(x.args),
    EHandle(x) -> projected_var(x.body, st, inner),
    EWithCell(x) -> match projected_var(x.init, st, inner) {
      Some(n) -> Some(n),
      None -> projected_var(x.body, st, push(inner, x.binder.name)),
    },
    _ -> None,
  }
}

fn push_front(xs: List<Expr>, x: Expr) -> List<Expr> = fold(xs, [x], |acc: List<Expr>, y: Expr| push(acc, y))

fn has_bytes(xs: List<Bytes>, x: Bytes) -> Bool = fold(xs, false, |acc: Bool, y: Bytes| acc || y == x)

fn pat_binders(p: Pattern, out: List<Bytes>) -> List<Bytes> =
  match p {
    PVar(v) -> push(out, v.name.name),
    PCtor(c) -> fold(c.args, out, |acc: List<Bytes>, a: Pattern| pat_binders(a, acc)),
    PRecord(r) -> fold(r.fields, out, |acc: List<Bytes>, f: { name: Ident, pat: Pattern }| pat_binders(f.pat, acc)),
    PList(l) -> {
      let items = fold(l.items, out, |acc: List<Bytes>, a: Pattern| pat_binders(a, acc));
      match l.rest { Some(r) -> pat_binders(r, items), None -> items }
    },
    _ -> out,
  }

fn nth(cs: List<Code>, i: Int) -> Code =
  match list_at(cs, i) { Some(c) -> c, None -> { own: Borrowed, span: dummy_span(), node: NLit(LUnit) } }

type Seq = { codes: List<Code>, st: Stack }

fn lower_seq(xs: List<Expr>, st: Stack) -> Option<Seq> =
  fold(xs, Some({ codes: [], st: st }), |acc: Option<Seq>, x: Expr|
    match acc {
      None -> None,
      Some(s) -> match lower_in(x, s.st) {
        Some(o) -> Some({ codes: push(s.codes, o.code), st: o.st }),
        None -> None,
      },
    })

// Pops the lambda's barrier; the stack below keeps the captures threaded into it.
fn lam_of(params: List<Bytes>, b: Out) -> Out = {
  let inner = st_top(b.st);
  { code: { own: Borrowed, span: dummy_span(), node: NLambda({ params: len(params), size: len(inner.names),
                                           caps: inner.caps,
                                           body: mark(b.code, []).code }) },
    st: st_pop(b.st) }
}

type ClauseAcc = { clauses: List<CClause>, st: Stack, ok: Bool }

type ArmAcc = { arms: List<CArm>, st: Stack, ok: Bool }

type GuardOut = { code: Option<Code>, st: Stack }

fn lower_guard(g: Option<Expr>, st: Stack) -> Option<GuardOut> =
  match g {
    None -> Some({ code: None, st: st }),
    Some(e) -> match lower_in(e, st) {
      None -> None,
      Some(o) -> Some({ code: Some(o.code), st: o.st }),
    },
  }

type BlockAcc = { stmts: List<CStmt>, st: Stack, ok: Bool }

fn lower_block(stmts: List<Stmt>, tail: Option<Expr>, st: Stack) -> Option<Out> = {
  let depth = depth_of(st);
  let walked = fold(stmts, { stmts: [], st: st, ok: true },
    |acc: BlockAcc, st: Stmt|
      if !acc.ok { acc } else {
        match st {
          SExpr(e) -> match lower_in(e, acc.st) {
            Some(o) -> { stmts: push(acc.stmts, CDo({ code: o.code })), st: o.st, ok: true },
            None -> { stmts: acc.stmts, st: acc.st, ok: false },
          },
          SLet(l) -> match binder_of(l.pat) {
            None -> match lower_in(l.value, acc.st) {
              None -> { stmts: acc.stmts, st: acc.st, ok: false },
              Some(o) -> {
                let p = lower_pat(l.pat, o.st);
                { stmts: push(acc.stmts, CLetPat({ span: l.span, pat: p.pat, value: o.code })), st: p.st, ok: true }
              },
            },
            Some(name) -> match lower_in(l.value, acc.st) {
              None -> { stmts: acc.stmts, st: acc.st, ok: false },
              Some(o) -> {
                stmts: push(acc.stmts, CLet({ name: name, slot: len(st_top(o.st).names), value: o.code })),
                st: bind_st(o.st, name),
                ok: true,
              },
            },
          },
        }
      });
  if !walked.ok { None } else {
    match tail {
      None -> Some({ code: { own: Borrowed, span: dummy_span(), node: NBlock({ stmts: walked.stmts, tail: None }) },
                     st: unscope_st(walked.st, depth) }),
      Some(t) -> match lower_in(t, walked.st) {
        None -> None,
        Some(o) -> Some({ code: { own: Borrowed, span: dummy_span(), node: NBlock({ stmts: walked.stmts, tail: Some(o.code) }) },
                          st: unscope_st(o.st, depth) }),
      },
    }
  }
}

type PatOut = { pat: CPat, st: Stack }

// Binders take slots in walk order. A bare name may be a nullary constructor, so it takes a slot either way.
fn lower_pat(p: Pattern, st: Stack) -> PatOut =
  match p {
    PWild(_) -> { pat: PxWild, st: st },
    PVar(v) -> {
      let name = v.name.name;
      let g = bind_st(st, name);
      { pat: PxVar({ name: name, slot: slot_in(st_top(g), name) }), st: g }
    },
    PLit(v) -> { pat: PxLit(v.lit), st: st },
    PCtor(c) -> {
      let r = lower_pats(c.args, st);
      { pat: PxCtor({ name: qname_text(c.name), args: r.pats }), st: r.st }
    },
    PRecord(r) -> {
      let walked = fold(r.fields, { pats: [], st: st, names: [] },
        |acc: PatFields, fd: { name: Ident, pat: Pattern }| {
          let o = lower_pat(fd.pat, acc.st);
          { pats: push(acc.pats, o.pat), st: o.st, names: push(acc.names, fd.name.name) }
        });
      { pat: PxRecord({ fields: map(range(0, len(walked.pats)), |i: Int|
                          { name: nth_bytes(walked.names, i), pat: nth_pat(walked.pats, i) }),
                        rest: r.rest }),
        st: walked.st }
    },
    PList(l) -> {
      let r = lower_pats(l.items, st);
      match l.rest {
        None -> { pat: PxList({ items: r.pats, rest: None }), st: r.st },
        Some(rp) -> {
          let o = lower_pat(rp, r.st);
          { pat: PxList({ items: r.pats, rest: Some(o.pat) }), st: o.st }
        },
      }
    },
    PBad(_) -> { pat: PxWild, st: st },
  }

fn lower_pats(ps: List<Pattern>, st: Stack) -> PatSeq =
  fold(ps, { pats: [], st: st }, |acc: PatSeq, p: Pattern| {
    let o = lower_pat(p, acc.st);
    { pats: push(acc.pats, o.pat), st: o.st }
  })

type PatFields = { pats: List<CPat>, st: Stack, names: List<Bytes> }
type PatSeq = { pats: List<CPat>, st: Stack }

fn nth_bytes(xs: List<Bytes>, i: Int) -> Bytes =
  match list_at(xs, i) { Some(x) -> x, None -> b"" }

fn nth_pat(xs: List<CPat>, i: Int) -> CPat =
  match list_at(xs, i) { Some(x) -> x, None -> PxWild }

pub fn qname_text(q: QName) -> Bytes =
  match q.module {
    // `::`, not the source's `.`: the dump must match the Rust side's spelling.
    Some(m) -> bytes_concat_all([m.name, b"::", q.name.name]),
    None -> q.name.name,
  }

// The slots a pattern binds; the ownership pass drops them walking back past it.
pub fn pat_slots(p: CPat) -> List<Int> =
  match p {
    PxWild -> [],
    PxVar(v) -> match v.slot { Some(s) -> [s], None -> [] },
    PxLit(_) -> [],
    PxCtor(c) -> fold(c.args, [], |acc: List<Int>, a: CPat| live_union(acc, pat_slots(a))),
    PxRecord(r) -> fold(r.fields, [], |acc: List<Int>, f: CPatField| live_union(acc, pat_slots(f.pat))),
    PxList(l) -> {
      let items = fold(l.items, [], |acc: List<Int>, i: CPat| live_union(acc, pat_slots(i)));
      match l.rest { Some(r) -> live_union(items, pat_slots(r)), None -> items }
    },
  }

// Only a single-name binder; any other pattern lowers as `CLetPat`.
fn binder_of(p: Pattern) -> Option<Bytes> =
  match p { PVar(id) -> Some(id.name.name), _ -> None }

// --- ownership --------------------------------------------------------------
// Backwards: a read is `Owned` when its slot is not read again after it, else `Borrowed`.
// Liveness is by slot, not name: a shadowed name is two slots that die at different points.

type Marked = { code: Code, live: List<Int> }

fn live_has(live: List<Int>, s: Int) -> Bool =
  fold(live, false, |acc: Bool, x: Int| acc || x == s)

fn live_add(live: List<Int>, s: Int) -> List<Int> =
  if live_has(live, s) { live } else { push(live, s) }

fn live_union(a: List<Int>, b: List<Int>) -> List<Int> =
  fold(b, a, |acc: List<Int>, x: Int| live_add(acc, x))

fn live_drop(live: List<Int>, s: Int) -> List<Int> =
  filter(live, |x: Int| x != s)

// The slot a projection reads through, when its base is a bare variable.
fn base_slot(c: Code) -> Option<Int> =
  match c.node { NVar(v) -> v.slot, _ -> None }

pub fn mark(c: Code, live: List<Int>) -> Marked =
  match c.node {
    NLit(_) -> { code: c, live: live },
    NLabel(_) -> { code: c, live: live },
    NVar(v) -> match v.slot {
      None -> { code: c, live: live },
      Some(s) -> {
        code: { own: if live_has(live, s) { Borrowed } else { Owned }, node: c.node, span: c.span },
        live: live_add(live, s),
      },
    },
    // The base is read after every written field, so backwards it is marked first.
    NUpd(u) -> {
      let s = match base_slot(u.base) { Some(x) -> x, None -> -1 };
      let owned = s >= 0 && !live_has(live, s);
      let base = { own: if owned { Owned } else { Borrowed }, node: u.base.node, span: u.base.span };
      let after = if s < 0 { live } else { live_add(live, s) };
      let r = mark_seq(map(u.sets, |f: CField| f.value), after);
      { code: { own: Borrowed, span: c.span, node: NUpd({ base: base, copies: u.copies,
          sets: map(range(0, len(u.sets)), |i: Int|
            { name: match list_at(u.sets, i) { Some(f) -> f.name, None -> b"" },
              value: nth(r.codes, i) }) }) },
        live: r.live }
    },
    NUnary(u) -> {
      let o = mark(u.operand, live);
      { code: { own: Borrowed, span: c.span, node: NUnary({ op: u.op, operand: o.code }) }, live: o.live }
    },
    NBinary(b) -> {
      let r = mark(b.rhs, live);
      let l = mark(b.lhs, r.live);
      { code: { own: Borrowed, span: c.span, node: NBinary({ op: b.op, lhs: l.code, rhs: r.code }) },
        live: l.live }
    },
    // The base is marked here so the node stays `Borrowed`: a last read may move the record out, never a field.
    NField(fd) -> match base_slot(fd.base) {
      None -> {
        let b = mark(fd.base, live);
        { code: { own: Borrowed, span: c.span, node: NField({ base: b.code, field: fd.field }) },
          live: b.live }
      },
      Some(s) -> {
        let base = { own: if live_has(live, s) { Borrowed } else { Owned }, node: fd.base.node, span: fd.base.span };
        { code: { own: Borrowed, span: c.span, node: NField({ base: base, field: fd.field }) },
          live: live_add(live, s) }
      },
    },
    // Every arm sees the same future, and each arm's binders die at the arm.
    // Walked last arm first: a failing guard goes on to the later arms, whose tests read the subject again,
    // so they and whatever the subject was read from are its future too.
    NMatch(m) -> {
      let subject = mark(m.scrutinee, []).live;
      let marked = fold(rev_arms(m.arms), { arms: [], live: [] },
        |acc: ArmMark, a: CArm| {
          let b = mark(a.body, live);
          let g: GuardMark = match a.guard {
            None -> { guard: None, live: b.live },
            Some(gc) -> {
              let later = if len(acc.arms) == 0 { acc.live } else { live_union(acc.live, subject) };
              let gm = mark(gc, live_union(b.live, later));
              { guard: Some(gm.code), live: gm.live }
            },
          };
          let after = fold(pat_slots(a.pat), g.live, |x: List<Int>, s: Int| live_drop(x, s));
          { arms: push(acc.arms, { pat: a.pat, guard: g.guard, body: b.code }),
            live: live_union(acc.live, after) }
        });
      let sc = mark(m.scrutinee, marked.live);
      { code: { own: Borrowed, span: c.span, node: NMatch({ scrutinee: sc.code, arms: rev_arms(marked.arms) }) },
        live: sc.live }
    },
    // The body was marked when lowered; the captures are reads of this barrier where the closure is made.
    NLambda(l) -> {
      let w = mark_caps(l.caps, live);
      { code: { own: Borrowed, span: c.span, node: NLambda({ params: l.params, size: l.size,
                                               caps: w.caps, body: l.body }) },
        live: w.live }
    },
    // Captures are reads of this barrier on entry, as a lambda's are.
    NSim(sm) -> {
      let w = mark_caps(sm.caps, live);
      { code: { own: Borrowed, span: c.span, node: NSim({ size: sm.size, caps: w.caps, body: sm.body }) },
        live: w.live }
    },
    NHandle(h) -> {
      let cls = fold(h.clauses, { caps: [], live: live },
        |acc: CapMark, c: CClause| {
          let w = mark_caps(c.caps, acc.live);
          { caps: acc.caps, live: w.live }
        });
      let marked = map(h.clauses, |c: CClause| c);
      let b = mark(h.body, cls.live);
      { code: { own: Borrowed, span: c.span, node: NHandle({ body: b.code, clauses: marked, ret: h.ret }) },
        live: b.live }
    },
    NPerform(p) -> {
      let r = mark_seq(p.args, live);
      let lb = match p.label { Some(x) -> { code: Some(mark(x, r.live).code), live: mark(x, r.live).live }, None -> { code: None, live: r.live } };
      { code: { own: Borrowed, span: c.span, node: NPerform({ effect: p.effect, op: p.op, resource: p.resource,
                                                label: lb.code, args: r.codes }) },
        live: lb.live }
    },
    // The binder dies at the `with_cell`, as a `let`'s does at its `let`.
    NCell(cl) -> {
      let b = mark(cl.body, live);
      let after = match cl.slot { None -> b.live, Some(s) -> live_drop(b.live, s) };
      let i = mark(cl.init, after);
      { code: { own: Borrowed, span: c.span, node: NCell({ resource: cl.resource, binder: cl.binder, slot: cl.slot,
                                             init: i.code, body: b.code }) },
        live: i.live }
    },
    NIf(i) -> {
      let t = mark(i.then_branch, live);
      let e = mark(i.else_branch, live);
      let cnd = mark(i.cond, live_union(t.live, e.live));
      { code: { own: Borrowed, span: c.span, node: NIf({ cond: cnd.code, then_branch: t.code, else_branch: e.code }) },
        live: cnd.live }
    },
    NList(l) -> {
      let r = mark_seq(l.items, live);
      { code: { own: Borrowed, span: c.span, node: NList({ items: r.codes }) }, live: r.live }
    },
    NRecord(rc) -> {
      let r = mark_seq(map(rc.fields, |fd: CField| fd.value), live);
      { code: { own: Borrowed, span: c.span, node: NRecord({ fields: map(range(0, len(rc.fields)), |i: Int|
          { name: cfield_name(rc.fields, i), value: nth(r.codes, i) }) }) },
        live: r.live }
    },
    NApp(a) -> {
      let args = mark_seq(a.args, live);
      let fu = mark(a.func, args.live);
      { code: { own: Borrowed, span: c.span, node: NApp({ func: fu.code, args: args.codes }) },
        live: fu.live }
    },
    NBlock(b) -> {
      let after = match b.tail {
        None -> { code: { own: Borrowed, span: dummy_span(), node: NLit(LUnit) }, live: live },
        Some(t) -> mark(t, live),
      };
      let walked = fold(rev_stmts(b.stmts), { codes: [], live: after.live },
        |acc: Seq2, st: CStmt|
          match st {
            CDo(d) -> { let m = mark(d.code, acc.live);
                        { codes: push(acc.codes, CDo({ code: m.code })), live: m.live } },
            // The binder dies at its `let`: nothing before it can read the slot.
            CLet(l) -> { let m = mark(l.value, live_drop(acc.live, l.slot));
                         { codes: push(acc.codes, CLet({ name: l.name, slot: l.slot, value: m.code })),
                           live: m.live } },
            CLetPat(l) -> {
              let dropped = fold(pat_slots(l.pat), acc.live, |x: List<Int>, sl: Int| live_drop(x, sl));
              let m = mark(l.value, dropped);
              { codes: push(acc.codes, CLetPat({ span: l.span, pat: l.pat, value: m.code })),
                live: m.live } },
          });
      { code: { own: Borrowed, span: c.span, node: NBlock({ stmts: rev_stmts(walked.codes),
                                              tail: match b.tail { None -> None, Some(_) -> Some(after.code) } }) },
        live: walked.live }
    },
  }

type CapMark = { caps: List<Cap>, live: List<Int> }

// A capture reads the enclosing barrier's slot, `Owned` when nothing after it wants that slot.
fn mark_caps(caps: List<Cap>, live: List<Int>) -> CapMark = {
  let walked = fold(rev_caps(caps), { caps: [], live: live },
    |acc: CapMark, cp: Cap|
      { caps: push(acc.caps, { src: cp.src, dst: cp.dst,
                               own: if live_has(acc.live, cp.src) { Borrowed } else { Owned } }),
        live: live_add(acc.live, cp.src) });
  { caps: rev_caps(walked.caps), live: walked.live }
}

type ArmMark = { arms: List<CArm>, live: List<Int> }

type GuardMark = { guard: Option<Code>, live: List<Int> }

type Seq2 = { codes: List<CStmt>, live: List<Int> }

fn cfield_name(fs: List<CField>, i: Int) -> Bytes =
  match list_at(fs, i) { Some(fd) -> fd.name, None -> b"" }

fn mark_seq(xs: List<Code>, live: List<Int>) -> MarkedSeq = {
  let walked = fold(rev_codes(xs), { codes: [], live: live },
    |acc: MarkedSeq, x: Code| {
      let m = mark(x, acc.live);
      { codes: push(acc.codes, m.code), live: m.live }
    });
  { codes: rev_codes(walked.codes), live: walked.live }
}

type MarkedSeq = { codes: List<Code>, live: List<Int> }

fn rev_codes(xs: List<Code>) -> List<Code> =
  map(range(0, len(xs)), |i: Int| nth(xs, len(xs) - 1 - i))

fn rev_caps(xs: List<Cap>) -> List<Cap> =
  map(range(0, len(xs)), |i: Int|
    match list_at(xs, len(xs) - 1 - i) { Some(x) -> x, None -> { src: 0, dst: 0, own: Borrowed } })

fn rev_arms(xs: List<CArm>) -> List<CArm> =
  map(range(0, len(xs)), |i: Int|
    match list_at(xs, len(xs) - 1 - i) { Some(x) -> x, None -> { pat: PxWild, guard: None, body: { own: Borrowed, span: dummy_span(), node: NLit(LUnit) } } })

fn rev_stmts(xs: List<CStmt>) -> List<CStmt> =
  map(range(0, len(xs)), |i: Int|
    match list_at(xs, len(xs) - 1 - i) { Some(x) -> x, None -> CDo({ code: { own: Borrowed, span: dummy_span(), node: NLit(LUnit) } }) })

// --- the module entry ------------------------------------------------------

// `L;n;`, then one record per lowered function; a function not lowered is skipped and counted.

pub type LowerOut = { dump: Bytes, lowered: Int, skipped: Int }

// One function body: slots resolved forwards, then ownership marked backwards.
// `params` ends with `labels`, the hidden trailing parameters a label-generic definition takes.
pub fn lower_fn(params: List<Bytes>, labels: List<Bytes>, sites: Map<Bytes, List<Bytes>>, body: Expr) -> Option<{ code: Code, size: Int }> = {
  let start = fold(params, { names: [], scope: [], caps: [], capnames: [] }, |f: Frame, p: Bytes| bind(f, p));
  match lower_in(body, { frames: [start], labels: labels, sites: sites }) {
    None -> None,
    Some(o) -> Some({ code: mark(o.code, []).code, size: len(st_top(o.st).names) }),
  }
}

pub fn lower_module(src: Bytes) -> LowerOut = {
  let r = parse(src);
  let x = expand(r.node, r.p.uses_sets, r.p.diags);
  fold(x.module.items, { dump: b"L;1;", lowered: 0, skipped: 0 },
    |acc: LowerOut, it: Item|
      match it {
        IFn(d) -> {
          let labels = map(d.generics.labels, |g: Ident| g.name);
          let names = fold(labels, map(d.params, |p: Param| p.name.name), |xs: List<Bytes>, n: Bytes| push(xs, n));
          match lower_fn(names, labels, map_new(), d.body) {
            None -> { dump: acc.dump, lowered: acc.lowered, skipped: acc.skipped + 1 },
            Some(l) -> {
              dump: bytes_concat_all([acc.dump, b"f:m.", d.name.name, b":",
                                      num(len(names)), b":", num(l.size), b";",
                                      dump(l.code), b";"]),
              lowered: acc.lowered + 1,
              skipped: acc.skipped,
            },
          }
        },
        _ -> acc,
      })
}

pub fn lower_dump(src: Bytes) -> String = string_of_bytes(lower_module(src).dump)

test "a literal lowers to itself" {
  assert_eq(lower_dump(b"fn f() -> Int = 1\n"), "L;1;f:m.f:0:0;blit(i1);")
}

test "binary operands are lowered left to right" {
  assert_eq(lower_dump(b"fn f() -> Int = 1 + 2\n"),
            "L;1;f:m.f:0:0;bbin(add,blit(i1),blit(i2));")
}

test "a name with no binder has no slot" {
  assert_eq(lower_dump(b"fn f() -> Int = g()\n"),
            "L;1;f:m.f:0:0;bapp(bvar(g,-));")
}

test "a parameter reads its slot and the last read owns it" {
  assert_eq(lower_dump(b"fn f(a: Int, b: Int) -> Int = a * b\n"),
            "L;1;f:m.f:2:2;bbin(mul,ovar(a,0),ovar(b,1));")
}

test "a read with another after it borrows" {
  assert_eq(lower_dump(b"fn f(x: Int) -> Int = x + x\n"),
            "L;1;f:m.f:1:1;bbin(add,bvar(x,0),ovar(x,0));")
}

test "both arms of an `if` see the same future" {
  assert_eq(lower_dump(b"fn f(n: Int) -> Int = if n > 0 { n } else { 0 - n }\n"),
            "L;1;f:m.f:1:1;bif(bbin(gt,bvar(n,0),blit(i0)),bblock(ovar(n,0)),bblock(bbin(sub,blit(i0),ovar(n,0))));")
}

test "a `let` takes the next slot and the binder dies at it" {
  assert_eq(lower_dump(b"fn f(a: Int) -> Int = { let b = a + 1; b }\n"),
            "L;1;f:m.f:1:2;bblock(let(v:b:1,bbin(add,ovar(a,0),blit(i1))),ovar(b,1));")
}

test "a match binds its arms into the window and each arm's binders leave at its end" {
  assert_eq(lower_dump(b"fn f(o: Option<Int>) -> Int = match o { Some(n) -> n, None -> 0 }\n"),
            "L;1;f:m.f:1:2;bmatch(ovar(o,0),arm(c:Some(v:n:1,),-,ovar(n,1)),arm(c:None(),-,blit(i0)));")
}

test "a guard is lowered between its arm's pattern and body and reads the arm's binders" {
  assert_eq(lower_dump(b"fn f(n: Int) -> Int = match n { x if x > 0 -> x, _ -> n }\n"),
            "L;1;f:m.f:1:2;bmatch(bvar(n,0),arm(v:x:1,bbin(gt,bvar(x,1),blit(i0)),ovar(x,1)),arm(_,-,ovar(n,0)));")
}

test "a guard borrows what a later arm still reads, the matched variable included" {
  assert_eq(lower_dump(b"fn f(n: Int, m: Int) -> Int = match n { x if x > m -> x, _ -> m }\n"),
            "L;1;f:m.f:2:3;bmatch(bvar(n,0),arm(v:x:2,bbin(gt,bvar(x,2),bvar(m,1)),ovar(x,2)),arm(_,-,ovar(m,1)));")
}

test "what the dump holds is what the count reports" {
  let out = lower_module(b"fn f() -> Int = 1\nfn g(a: Int) -> Int = a\nfn h() -> Int = 2\n");
  assert_eq(out.lowered, 3);
  assert_eq(out.skipped, 0);
  assert_eq(count_records(bytes_of_string(lower_dump(b"fn f() -> Int = 1\nfn g(a: Int) -> Int = a\nfn h() -> Int = 2\n"))), 3)
}

// Counts records by their `f:m.` heads.
fn count_records(d: Bytes) -> Int =
  fold(range(0, bytes_len(d) - 3), 0, |acc: Int, i: Int|
    if bytes_at(d, i) == 102 && bytes_at(d, i + 1) == 58
       && bytes_at(d, i + 2) == 109 && bytes_at(d, i + 3) == 46 { acc + 1 } else { acc })
