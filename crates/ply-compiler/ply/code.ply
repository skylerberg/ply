// The lowered form the code generator reads: slots resolved and ownership marked.

import parsing (Span, Ident, QName, dummy_span, int_to_bytes, span_key)
import patterns (Pattern, PWild, PVar, PLit, PCtor, PRecord, PList, POr, PBad, Lit, LInt, LFixed,
                 LWide, LBool, LStr, LBytes, LFloat, LDec, LChar, LUnit, LBad, has_or,
                 alternatives_of)
import exprs (HandleClause, MatchArm, Param, Expr, ELit, EVar, EBinary, EUnary, EApp, EIf, EBlock,
              EList, ERecord, EField, ELambda, EMatch, EPerform, EHandle, EWithCell, ESimulate,
              EParallel, EBad, ERecordUpdate, ETry, Stmt, SLet, SLetElse, SExpr, RecField,
              expr_span)
import items (Module, Item, IFn, parse)
import rewrite (expand)
import std.list (at_or)

// How a read takes its value.
pub type Own = | Borrowed | Owned

pub fn own_tag(o: Own) -> Bytes = match o { Borrowed -> b"b", Owned -> b"o" }

// One lowered node: what it is, and how the read that produced it takes it.
pub type Code = { own: Own, node: Node, span: Span }

pub type Node =
  | NLit(Lit)
  | NVar({ name: Bytes, slot: Option<Int> })
  | NUnary({ op: Bytes, operand: Code })
  | NBinary({ op: Bytes, lhs: Code, rhs: Code })
  | NApp({ func: Code, args: List<Code> })
  | NIf({ cond: Code, then_branch: Code, else_branch: Code })
  | NBlock({ stmts: List<CodeStmt>, tail: Option<Code> })
  | NList({ items: List<Code> })
  | NRecord({ fields: List<CodeField> })
  | NMatch({ scrutinee: Code, arms: List<CodeArm> })
  // `label` is the read of the label parameter the resource names, when a binder holds it.
  | NPerform({ effect: Bytes, op: Bytes, resource: Bytes, label: Option<Code>, args: List<Code> })
  // One label argument of a call: the field-table entry of a resource named here.
  | NLabel(Bytes)
  | NCell({ resource: Bytes, binder: Bytes, slot: Option<Int>, init: Code, body: Code })
  | NLambda({ params: Int, size: Int, captures: List<Capture>, body: Code })
  | NSimulate({ size: Int, captures: List<Capture>, body: Code })
  // Each branch a nullary `NLambda`, which the run calls on whichever thread it chooses.
  | NParallel({ branches: List<Code> })
  | NHandle({ body: Code, clauses: List<CodeClause>, ret: Option<CodeReturn> })
  | NField({ base: Code, field: Bytes })
  // `{..b, f: e}`, recognised in a plain literal where some field is `b.<its own name>` for one slot variable `b`.
  | NUpdate({ base: Code, copies: List<Bytes>, sets: List<CodeField> })

pub type CodeField = { name: Bytes, value: Code }

// A pattern with its binders resolved to slots, so a match writes bindings straight into the window.
pub type CodePattern =
  | PxWild
  | PxVar({ name: Bytes, slot: Option<Int> })
  | PxLit(Lit)
  | PxCtor({ name: Bytes, args: List<CodePattern> })
  | PxRecord({ fields: List<CodePatternField>, rest: Bool })
  | PxList({ items: List<CodePattern>, rest: Option<CodePattern> })

pub type CodePatternField = { name: Bytes, pat: CodePattern }

pub type CodeArm = { pat: CodePattern, guard: Option<Code>, body: Code }

// A free name a barrier copies in on entry: its slot outside, its slot here, and how the copy reads it.
pub type Capture = { src: Int, dst: Int, own: Own }

// A handler clause opens its own barrier: its parameters and `resume` binder take the leading slots.
pub type CodeClause = {
  effect: Bytes,
  op: Bytes,
  resource: Bytes,
  label: Option<Code>,
  params: Int,
  // `[*t]` binds the call site's label as one more leading slot, after the parameters and before
  // the continuation, which is the order the run appends them in.
  binds_label: Bool,
  resume: Bool,
  size: Int,
  captures: List<Capture>,
  body: Code,
}

pub type CodeReturn = { size: Int, captures: List<Capture>, body: Code }

// `CLet`'s slot is what the ownership pass drops when it walks backwards past the binder.
pub type CodeStmt =
  | CLet({ name: Bytes, slot: Int, value: Code })
  // `let <pattern> = e`: the value is bound as a whole and the pattern's names read out of it.
  | CLetPat({ span: Span, pat: CodePattern, value: Code })
  | CDo({ code: Code })

// --- the dump ---------------------------------------------------------------

// A resource a label parameter names is the slot it reads, which stays one comma-free word.
fn resource_tag(name: Bytes, label: Option<Code>) -> Bytes =
  match label {
    None -> name,
    Some(c) -> match c.node { NVar(v) -> bytes_concat(b"$", slot_tag(v.slot)), _ -> name },
  }

pub fn dump_lit(literal: Lit) -> Bytes / {abort.raise} =
  match literal {
    LInt(n) -> bytes_concat(b"i", int_to_bytes(n)),
    // Lowercased, so the dump has one spelling whatever case the suffix was written in.
    LFixed(name, bits) -> bytes_concat_all([b"x", lower_bytes(name), b":", int_to_bytes(bits)]),
    LWide(name, high, low) ->
      bytes_concat_all([
        b"x",
        lower_bytes(name),
        b":",
        int_to_bytes(high),
        b":",
        int_to_bytes(low),
      ]),
    LBool(b) -> if b { b"T" } else { b"F" },
    LStr(s) -> bytes_concat_all([b"s", int_to_bytes(bytes_len(s)), b":", hex(s)]),
    LBytes(s) -> bytes_concat_all([b"y", int_to_bytes(bytes_len(s)), b":", hex(s)]),
    LFloat(_) -> b"f",
    LDec(r) -> bytes_concat_all([b"d", int_to_bytes(bytes_len(r)), b":", hex(r)]),
    LChar(v) -> bytes_concat(b"c", int_to_bytes(v)),
    // Parser placeholders: never in a checked program's tree, so they dump as themselves.
    LUnit -> b"u",
    LBad -> b"!",
  }

fn lower_bytes(s: Bytes) -> Bytes / {abort.raise} =
  fold(range(0, bytes_len(s)), b"", |acc: Bytes, i: Int| {
    let c = bytes_at(s, i);
    bytes_concat(acc, byte_of_int(if c >= 65 && c <= 90 { c + 32 } else { c }))
  })

fn hex_digit(v: Int) -> Bytes / {abort.raise} = bytes_slice(b"0123456789abcdef", v, v + 1)

pub fn hex(s: Bytes) -> Bytes / {abort.raise} =
  fold(range(0, bytes_len(s)), b"", |acc: Bytes, i: Int| {
    let byte = bytes_at(s, i);
    bytes_concat_all([acc, hex_digit(byte / 16), hex_digit(byte % 16)])
  })

fn slot_tag(s: Option<Int>) -> Bytes = match s { Some(n) -> int_to_bytes(n), None -> b"-" }

fn dump_caps(captures: List<Capture>) -> Bytes =
  bytes_concat_all([
    b"[",
    fold(captures, b"", |acc: Bytes, capture: Capture|
      bytes_concat_all([
        acc,
        int_to_bytes(capture.src),
        b">",
        int_to_bytes(capture.dst),
        own_tag(capture.own),
        b" ",
      ])),
    b"]",
  ])

pub fn dump_pat(p: CodePattern) -> Bytes / {abort.raise} =
  match p {
    PxWild -> b"_",
    PxVar(v) -> bytes_concat_all([b"v:", v.name, b":", slot_tag(v.slot)]),
    PxLit(l) -> bytes_concat(b"l:", dump_lit(l)),
    PxCtor(c) ->
      bytes_concat_all([
        b"c:",
        c.name,
        b"(",
        fold(c.args, b"", |acc: Bytes, a: CodePattern| bytes_concat_all([acc, dump_pat(a), b","])),
        b")",
      ]),
    PxRecord(r) ->
      bytes_concat_all([
        b"r:(",
        fold(r.fields, b"", |acc: Bytes, f: CodePatternField|
          bytes_concat_all([acc, f.name, b"=", dump_pat(f.pat), b","])),
        if r.rest { b"..)" } else { b")" },
      ]),
    PxList(l) ->
      bytes_concat_all([
        b"s:(",
        fold(l.items, b"", |acc: Bytes, i: CodePattern| bytes_concat_all([acc, dump_pat(i), b","])),
        match l.rest { Some(r) -> bytes_concat(b"..", dump_pat(r)), None -> b"" },
        b")",
      ]),
  }

pub fn dump(code: Code) -> Bytes / {abort.raise} =
  bytes_concat(own_tag(code.own), dump_node(code.node))

fn dump_node(n: Node) -> Bytes / {abort.raise} =
  match n {
    NLit(l) -> bytes_concat_all([b"lit(", dump_lit(l), b")"]),
    NVar(v) -> bytes_concat_all([b"var(", v.name, b",", slot_tag(v.slot), b")"]),
    NUnary(u) -> bytes_concat_all([b"un(", u.op, b",", dump(u.operand), b")"]),
    NBinary(b) -> bytes_concat_all([b"bin(", b.op, b",", dump(b.lhs), b",", dump(b.rhs), b")"]),
    NApp(a) ->
      bytes_concat_all([
        b"app(",
        dump(a.func),
        fold(a.args, b"", |acc: Bytes, code: Code| bytes_concat_all([acc, b",", dump(code)])),
        b")",
      ]),
    NIf(i) ->
      bytes_concat_all([
        b"if(",
        dump(i.cond),
        b",",
        dump(i.then_branch),
        b",",
        dump(i.else_branch),
        b")",
      ]),
    NBlock(b) ->
      bytes_concat_all([
        b"block(",
        fold(b.stmts, b"", |acc: Bytes, stmt: CodeStmt|
          bytes_concat(acc, match stmt {
            CLet(l) ->
              bytes_concat_all([
                b"let(v:",
                l.name,
                b":",
                int_to_bytes(l.slot),
                b",",
                dump(l.value),
                b"),",
              ]),
            CLetPat(l) -> bytes_concat_all([b"let(", dump_pat(l.pat), b",", dump(l.value), b"),"]),
            CDo(d) -> bytes_concat_all([b"do(", dump(d.code), b"),"]),
          })),
        match b.tail { Some(t) -> dump(t), None -> b"-" },
        b")",
      ]),
    NList(l) ->
      bytes_concat_all([
        b"list(",
        fold(l.items, b"", |acc: Bytes, code: Code| bytes_concat_all([acc, dump(code), b","])),
        b")",
      ]),
    NRecord(r) ->
      bytes_concat_all([
        b"rec(",
        fold(r.fields, b"", |acc: Bytes, fd: CodeField|
          bytes_concat_all([acc, fd.name, b"=", dump(fd.value), b","])),
        b")",
      ]),
    NMatch(m) ->
      bytes_concat_all([
        b"match(",
        dump(m.scrutinee),
        fold(m.arms, b"", |acc: Bytes, a: CodeArm|
          bytes_concat_all([
            acc,
            b",arm(",
            dump_pat(a.pat),
            b",",
            match a.guard { Some(g) -> dump(g), None -> b"-" },
            b",",
            dump(a.body),
            b")",
          ])),
        b")",
      ]),
    NLabel(n) -> bytes_concat_all([b"label(", n, b")"]),
    NPerform(p) ->
      bytes_concat_all([
        b"perform(",
        p.effect,
        b",",
        p.op,
        b",",
        resource_tag(p.resource, p.label),
        fold(p.args, b"", |acc: Bytes, a: Code| bytes_concat_all([acc, b",", dump(a)])),
        b")",
      ]),
    NCell(c) ->
      bytes_concat_all([
        b"cell(",
        c.resource,
        b",",
        c.binder,
        b",",
        slot_tag(c.slot),
        b",",
        dump(c.init),
        b",",
        dump(c.body),
        b")",
      ]),
    NParallel(pr) ->
      bytes_concat_all([
        b"par(",
        fold(pr.branches, b"", |acc: Bytes, code: Code| bytes_concat_all([acc, dump(code), b","])),
        b")",
      ]),
    NSimulate(sm) ->
      bytes_concat_all([
        b"sim(",
        int_to_bytes(sm.size),
        b",",
        dump_caps(sm.captures),
        b",",
        dump(sm.body),
        b")",
      ]),
    NHandle(h) ->
      bytes_concat_all([
        b"handle(",
        dump(h.body),
        fold(h.clauses, b"", |acc: Bytes, c: CodeClause|
          bytes_concat_all([
            acc,
            b",cl(",
            c.effect,
            b",",
            c.op,
            b",",
            resource_tag(c.resource, c.label),
            b",",
            int_to_bytes(c.params),
            b",",
            if c.resume { b"true" } else { b"false" },
            b",",
            int_to_bytes(c.size),
            b",",
            dump_caps(c.captures),
            b",",
            dump(c.body),
            b")",
          ])),
        match h.ret {
          Some(r) ->
            bytes_concat_all([
              b",ret(",
              int_to_bytes(r.size),
              b",",
              dump_caps(r.captures),
              b",",
              dump(r.body),
              b")",
            ]),
          None -> b",-",
        },
        b")",
      ]),
    NLambda(l) ->
      bytes_concat_all([
        b"lam(",
        int_to_bytes(l.params),
        b",",
        int_to_bytes(l.size),
        b",",
        dump_caps(l.captures),
        b",",
        dump(l.body),
        b")",
      ]),
    NField(f) -> bytes_concat_all([b"fld(", dump(f.base), b",", f.field, b")"]),
    NUpdate(u) ->
      bytes_concat_all([
        b"upd(",
        dump(u.base),
        fold(u.copies, b"", |acc: Bytes, n: Bytes| bytes_concat_all([acc, b",c:", n])),
        fold(u.sets, b"", |acc: Bytes, f: CodeField|
          bytes_concat_all([acc, b",s:", f.name, b"=", dump(f.value)])),
        b")",
      ]),
  }

// --- slots ------------------------------------------------------------------
// Forward pass: every binding gets a slot and slot numbers never go back, so a window is sized by
// bindings, not by how many are live at once.

type Bind = { name: Bytes, slot: Int }

// `names` is the barrier's window in order; `scope` is what is visible here, innermost last.
type Frame = {
  names: List<Bytes>,
  scope: List<Bind>,
  captures: List<Capture>,
  capture_names: List<Bytes>,
}

fn bind(frame: Frame, name: Bytes) -> Frame =
  {
    names: push(frame.names, name),
    scope: push(frame.scope, { name: name, slot: len(frame.names) }),
    captures: frame.captures,
    capture_names: frame.capture_names,
  }

fn find(frame: Frame, name: Bytes) -> Option<Int> =
  fold(frame.scope, None, |acc: Option<Int>, b: Bind|
    if b.name == name { Some(b.slot) } else { acc })

// The barriers in scope, innermost last. A free name is threaded through every barrier between use and binding.
type Stack = { frames: List<Frame>, labels: List<Bytes>, sites: Map<Bytes, List<Bytes>> }

fn st_top(stack: Stack) -> Frame =
  match list_at(stack.frames, len(stack.frames) - 1) { Some(f) -> f, None -> empty_frame() }

fn empty_frame() -> Frame = { names: [], scope: [], captures: [], capture_names: [] }

fn st_at(stack: Stack, i: Int) -> Frame =
  match list_at(stack.frames, i) { Some(f) -> f, None -> empty_frame() }

fn st_set(stack: Stack, i: Int, frame: Frame) -> Stack =
  {
    frames: map(range(0, len(stack.frames)), |j: Int| if j == i { frame } else { st_at(stack, j) }),
    labels: stack.labels,
    sites: stack.sites,
  }

fn st_top_set(stack: Stack, frame: Frame) -> Stack = st_set(stack, len(stack.frames) - 1, frame)

fn st_push(stack: Stack, frame: Frame) -> Stack =
  { frames: push(stack.frames, frame), labels: stack.labels, sites: stack.sites }

fn st_pop(stack: Stack) -> Stack =
  {
    frames: map(range(0, len(stack.frames) - 1), |j: Int| st_at(stack, j)),
    labels: stack.labels,
    sites: stack.sites,
  }

// The depth whose barrier has `name` in scope or already captures it, innermost first.
fn st_depth(stack: Stack, name: Bytes) -> Option<Int> =
  fold(range(0, len(stack.frames)), None, |acc: Option<Int>, i: Int| {
    let f = st_at(stack, i);
    match find(f, name) {
      Some(_) -> Some(i),
      None -> match find_cap(f, name) { Some(_) -> Some(i), None -> acc },
    }
  })

fn slot_in(f: Frame, name: Bytes) -> Option<Int> =
  match find(f, name) { Some(s) -> Some(s), None -> find_cap(f, name) }

// Resolves `name` at the innermost barrier, threading a capture through every barrier between when it is free.
type SlotLookup = { slot: Option<Int>, stack: Stack }

fn resolve(stack: Stack, name: Bytes) -> SlotLookup =
  match st_depth(stack, name) {
    None -> { slot: None, stack: stack },
    Some(d) -> {
      let start = match slot_in(st_at(stack, d), name) { Some(s) -> s, None -> 0 };
      fold(
        range(d + 1, len(stack.frames)),
        { slot: Some(start), stack: stack },
        |acc: SlotLookup, i: Int| {
          let f = st_at(acc.stack, i);
          let from = match acc.slot { Some(s) -> s, None -> 0 };
          match find_cap(f, name) {
            Some(s) -> { slot: Some(s), stack: acc.stack },
            None -> {
              let g = capture(f, name, from);
              { slot: find_cap(g, name), stack: st_set(acc.stack, i, g) }
            },
          }
        },
      )
    },
  }

// A resource a label binder holds is read like any other name, captures threaded and all.
fn label_code(stack: Stack, name: Bytes) -> Option<Lowered> =
  if !has_bytes(stack.labels, name) { None } else {
    let r = resolve(stack, name);
    Some({
      code: { own: Borrowed, span: dummy_span(), node: NVar({ name: name, slot: r.slot }) },
      stack: r.stack,
    })
  }

type Labels = { codes: List<Code>, stack: Stack }

// The labels a call fills: this body's own parameter, or a field-table entry of the name.
fn label_args(stack: Stack, span: Span) -> Labels =
  fold(
    match map_get(stack.sites, span_key(span)) { Some(xs) -> xs, None -> [] },
    { codes: [], stack: stack },
    |acc: Labels, n: Bytes|
      match label_code(acc.stack, n) {
        Some(o) -> { codes: push(acc.codes, o.code), stack: o.stack },
        None ->
          {
            codes: push(acc.codes, { own: Borrowed, span: dummy_span(), node: NLabel(n) }),
            stack: acc.stack,
          },
      },
  )

// A block's binders leave scope at its end, but the slots they took are never reused.
fn bind_st(stack: Stack, name: Bytes) -> Stack = st_top_set(stack, bind(st_top(stack), name))

fn unscope(frame: Frame, to: Int) -> Frame =
  {
    names: frame.names,
    scope: take(frame.scope, to),
    captures: frame.captures,
    capture_names: frame.capture_names,
  }

fn unscope_st(stack: Stack, to: Int) -> Stack = st_top_set(stack, unscope(st_top(stack), to))

fn depth_of(stack: Stack) -> Int = len(st_top(stack).scope)

fn find_cap(frame: Frame, name: Bytes) -> Option<Int> =
  fold(range(0, len(frame.capture_names)), None, |acc: Option<Int>, i: Int|
    if at_or(frame.capture_names, i, b"") == name {
      match list_at(frame.captures, i) { Some(c) -> Some(c.dst), None -> acc }
    } else { acc })

// The own mark is `Borrowed` here; the enclosing barrier's backward pass rewrites it.
fn capture(frame: Frame, name: Bytes, src: Int) -> Frame =
  {
    names: push(frame.names, name),
    scope: frame.scope,
    captures: push(frame.captures, { src: src, dst: len(frame.names), own: Borrowed }),
    capture_names: push(frame.capture_names, name),
  }

fn take(xs: List<Bind>, n: Int) -> List<Bind> =
  fold(range(0, n), [], |acc: List<Bind>, i: Int| push(acc, at_or(xs, i, { name: b"", slot: 0 })))

// --- the lowering -----------------------------------------------------------
// `None` for a form not lowered. Every node is built `Borrowed`; `mark` sets ownership.

pub fn covers() -> List<Bytes> =
  [
    b"literals",
    b"unary",
    b"binary",
    b"if",
    b"list",
    b"field",
    b"application",
    b"records",
    b"blocks and `let`",
    b"parameters and their slots",
    b"the ownership marks",
    b"match, its guards and every pattern form",
    b"perform and with_cell",
    b"a lambda and the names it captures, through any depth of barrier",
    b"handle with its clauses and return arm, and simulate",
  ]

type Lowered = { code: Code, stack: Stack }

fn lower_in(e: Expr, stack: Stack) -> Option<Lowered> / {abort.raise} =
  match e {
    ELit(x) ->
      Some({ code: { own: Borrowed, span: expr_span(e), node: NLit(x.lit) }, stack: stack }),
    // `ERecordUpdate` is written out as a literal before lowering; `as_update` recognises the result.
    EVar(x) -> match x.name.module {
      // A qualified name is a global, never a slot: a module binder cannot be shadowed by a local.
      Some(m) ->
        Some({
          code: {
            own: Borrowed,
            span: expr_span(e),
            node: NVar({ name: bytes_concat_all([m.name, b"::", x.name.name.name]), slot: None }),
          },
          stack: stack,
        }),
      None -> {
        let name = x.name.name.name;
        let r = resolve(stack, name);
        Some({
          code: { own: Borrowed, span: expr_span(e), node: NVar({ name: name, slot: r.slot }) },
          stack: r.stack,
        })
      },
    },
    EUnary(x) -> match lower_in(x.operand, stack) {
      Some(o) ->
        Some({
          code: { own: Borrowed, span: expr_span(e), node: NUnary({ op: x.op, operand: o.code }) },
          stack: o.stack,
        }),
      None -> None,
    },
    EBinary(x) -> match lower_in(x.lhs, stack) {
      None -> None,
      Some(l) -> match lower_in(x.rhs, l.stack) {
        None -> None,
        Some(r) ->
          Some({
            code: {
              own: Borrowed,
              span: expr_span(e),
              node: NBinary({ op: x.op, lhs: l.code, rhs: r.code }),
            },
            stack: r.stack,
          }),
      },
    },
    EIf(x) -> match lower_in(x.cond, stack) {
      None -> None,
      Some(c) -> match lower_in(x.then_branch, c.stack) {
        None -> None,
        Some(t) -> match lower_in(x.else_branch, t.stack) {
          None -> None,
          Some(el) ->
            Some({
              code: {
                own: Borrowed,
                span: expr_span(e),
                node: NIf({ cond: c.code, then_branch: t.code, else_branch: el.code }),
              },
              stack: el.stack,
            }),
        },
      },
    },
    EField(x) -> match lower_in(x.base, stack) {
      Some(b) ->
        Some({
          code: {
            own: Borrowed,
            span: expr_span(e),
            node: NField({ base: b.code, field: x.field.name }),
          },
          stack: b.stack,
        }),
      None -> None,
    },
    EList(x) -> match lower_seq(x.items, stack) {
      Some(r) ->
        Some({
          code: { own: Borrowed, span: expr_span(e), node: NList({ items: r.codes }) },
          stack: r.stack,
        }),
      None -> None,
    },
    ERecord(x) -> match as_update(x.fields, stack) {
      Some(u) -> Some(u),
      None -> match lower_seq(map(x.fields, |field: RecField| field.value), stack) {
        None -> None,
        Some(r) ->
          Some({
            code: {
              own: Borrowed,
              span: expr_span(e),
              node: NRecord({
                fields: map(range(0, len(x.fields)), |i: Int|
                  { name: field_name(x.fields, i), value: nth(r.codes, i) }),
              }),
            },
            stack: r.stack,
          }),
      },
    },
    EApp(x) -> if len(x.named) > 0 { None } else {
      match lower_in(x.func, stack) {
        None -> None,
        Some(fu) -> match lower_seq(x.args, fu.stack) {
          Some(r) -> {
            let ls = label_args(r.stack, expr_span(e));
            Some({
              code: {
                own: Borrowed,
                span: expr_span(e),
                node: NApp({
                  func: fu.code,
                  args: fold(ls.codes, r.codes, |acc: List<Code>, code: Code| push(acc, code)),
                }),
              },
              stack: ls.stack,
            })
          },
          None -> None,
        },
      }
    },
    EMatch(x) -> match lower_in(x.scrutinee, stack) {
      None -> None,
      Some(sc) ->
        matched(expr_span(e), sc, |start: ArmAcc|
          fold(x.arms, start, |acc: ArmAcc, arm: MatchArm|
            arms_into(acc, arm.pat, arm.guard, |st: Stack| lower_in(arm.body, st)))),
    },
    EPerform(x) -> match lower_seq(x.args, stack) {
      None -> None,
      Some(r) -> {
        let name = match x.resource { Some(id) -> id.name, None -> b"" };
        let lb = label_code(r.stack, name);
        Some({
          code: {
            own: Borrowed,
            span: expr_span(e),
            node: NPerform({
              effect: qname_text(x.eff),
              op: x.op.name,
              resource: name,
              label: match lb { Some(o) -> Some(o.code), None -> None },
              args: r.codes,
            }),
          },
          stack: match lb { Some(o) -> o.stack, None -> r.stack },
        })
      },
    },
    // The binder is in scope for the body only; the init is evaluated before it exists.
    EWithCell(x) -> match lower_in(x.init, stack) {
      None -> None,
      Some(i) -> {
        let depth = depth_of(i.stack);
        let inner = bind_st(i.stack, x.binder.name);
        match lower_in(x.body, inner) {
          None -> None,
          Some(b) ->
            Some({
              code: {
                own: Borrowed,
                span: expr_span(e),
                node: NCell({
                  resource: x.resource.name,
                  binder: x.binder.name,
                  slot: slot_in(st_top(inner), x.binder.name),
                  init: i.code,
                  body: b.code,
                }),
              },
              stack: unscope_st(b.stack, depth),
            }),
        }
      },
    },
    // A lambda opens its own barrier; a name it reads from outside becomes a capture.
    ELambda(x) -> lower_lambda(map(x.params, |param: Param| param.name.name), x.body, stack),
    // `simulate` opens a barrier, as a lambda does, and takes no parameters.
    ESimulate(x) -> match lower_in(x.body, st_push(stack, empty_frame())) {
      None -> None,
      Some(b) -> {
        let inner = st_top(b.stack);
        Some({
          code: {
            own: Borrowed,
            span: expr_span(e),
            node: NSimulate({
              size: len(inner.names),
              captures: inner.captures,
              body: mark(b.code, []).code,
            }),
          },
          stack: st_pop(b.stack),
        })
      },
    },
    // Each branch is a lambda with no parameters.
    EParallel(x) -> match fold(
        x.branches,
        Some({ codes: [], stack: stack }),
        |acc: Option<Seq>, b: Expr|
          match acc {
            None -> None,
            Some(sq) -> match lower_lambda([], b, sq.stack) {
              Some(o) -> Some({ codes: push(sq.codes, o.code), stack: o.stack }),
              None -> None,
            },
          },
      ) {
      None -> None,
      Some(r) ->
        Some({
          code: { own: Borrowed, span: expr_span(e), node: NParallel({ branches: r.codes }) },
          stack: r.stack,
        }),
    },
    // The body runs in the enclosing barrier; each clause opens its own, led by its parameters and `resume`.
    EHandle(x) -> match lower_in(x.body, stack) {
      None -> None,
      Some(b) -> {
        let cls = fold(
          x.clauses,
          { clauses: [], stack: b.stack, ok: true },
          |acc: ClauseAcc, c: HandleClause|
            if !acc.ok { acc } else {
              let named = map(c.params, |i: Ident| i.name);
              let with_label = match c.label_binder {
                Some(t) -> push(named, t.name),
                None -> named,
              };
              let names = match c.resume {
                Some(rid) -> push(with_label, rid.name),
                None -> with_label,
              };
              let inner = fold(names, empty_frame(), |g: Frame, n: Bytes| bind(g, n));
              // The clause's resource is read where the table is built, outside the clause's own barrier.
              // A `[*]` clause keys on the wildcard rather than on a label, so it answers every
              // label the table is asked about.
              let res = if c.every_label { b"*" }
              else { match c.resource { Some(id) -> id.name, None -> b"" } };
              let lb = label_code(acc.stack, res);
              let outer = match lb { Some(o) -> o.stack, None -> acc.stack };
              match lower_in(c.body, st_push(outer, inner)) {
                None -> { clauses: acc.clauses, stack: acc.stack, ok: false },
                Some(cb) -> {
                  let f = st_top(cb.stack);
                  {
                    clauses: push(acc.clauses, {
                      effect: qname_text(c.eff),
                      op: c.op.name,
                      resource: res,
                      label: match lb { Some(o) -> Some(o.code), None -> None },
                      params: len(c.params),
                      binds_label: match c.label_binder { Some(_) -> true, None -> false },
                      resume: match c.resume { Some(_) -> true, None -> false },
                      size: len(f.names),
                      captures: f.captures,
                      body: mark(cb.code, []).code,
                    }),
                    stack: st_pop(cb.stack),
                    ok: true,
                  }
                },
              }
            },
        );
        if !cls.ok { None } else {
          match x.ret {
            None ->
              Some({
                code: {
                  own: Borrowed,
                  span: expr_span(e),
                  node: NHandle({ body: b.code, clauses: cls.clauses, ret: None }),
                },
                stack: cls.stack,
              }),
            Some(r) -> {
              let inner = bind(empty_frame(), r.binder.name);
              match lower_in(r.body, st_push(cls.stack, inner)) {
                None -> None,
                Some(rb) -> {
                  let f = st_top(rb.stack);
                  Some({
                    code: {
                      own: Borrowed,
                      span: expr_span(e),
                      node: NHandle({
                        body: b.code,
                        clauses: cls.clauses,
                        ret: Some({
                          size: len(f.names),
                          captures: f.captures,
                          body: mark(rb.code, []).code,
                        }),
                      }),
                    },
                    stack: st_pop(rb.stack),
                  })
                },
              }
            },
          }
        }
      },
    },
    EBlock(x) -> lower_block(x.stmts, x.tail, stack),
    _ -> None,
  }

fn field_name(fs: List<RecField>, i: Int) -> Bytes =
  match list_at(fs, i) { Some(fd) -> fd.name.name, None -> b"" }

// Recovers an update from a literal whose copied fields are `b.<own name>` for one slot variable `b`;
// the base is read after every written field, which `mark` has to reflect.
fn as_update(
  fields: List<RecField>,
  stack: Stack,
) -> Option<{ code: Code, stack: Stack }> / {abort.raise} = {
  // Two different copied-from variables make this a plain literal.
  let copies = fold(
    fields,
    { names: [], bad: false },
    |acc: { names: List<Bytes>, bad: Bool }, f: RecField|
      match copy_base(f, stack) {
        None -> acc,
        Some(n) -> if len(acc.names) == 0 { { names: [n], bad: acc.bad } }
        else if at_or(acc.names, 0, b"") == n { acc }
        else { { names: acc.names, bad: true } },
      },
  );
  if copies.bad { None } else {
    // With no copied field, a record projected from inside a written field is the base whose cells are reused.
    let base = if len(copies.names) == 1 { list_at(copies.names, 0) } else {
      fold(fields, None, |acc: Option<Bytes>, f: RecField|
        match acc {
          Some(_) -> acc,
          None -> if copy_base(f, stack) != None { None }
          else { projected_var(f.value, stack, []) },
        })
    };
    match base {
      None -> None,
      Some(name) -> {
        // Walked in field order, so each copy resolves the base, and each capture is numbered, where it stands.
        let walked = fold(
          fields,
          Some({ codes: [], stack: stack }),
          |acc: Option<Seq>, f: RecField|
            match acc {
              None -> None,
              Some(a) -> if copy_base(f, stack) == Some(name) {
                Some({ codes: a.codes, stack: resolve(a.stack, name).stack })
              } else {
                match lower_in(f.value, a.stack) {
                  None -> None,
                  Some(o) -> Some({ codes: push(a.codes, o.code), stack: o.stack }),
                }
              },
            },
        );
        match walked {
          None -> None,
          Some(o) -> match resolve(o.stack, name).slot {
            None -> None,
            Some(sl) -> {
              let copied = fold(fields, [], |acc: List<Bytes>, f: RecField|
                match copy_base(f, stack) {
                  Some(n) -> if n == name { push(acc, f.name.name) } else { acc },
                  None -> acc,
                });
              let sets = filter(fields, |f: RecField| copy_base(f, stack) != Some(name));
              Some({
                code: {
                  own: Borrowed,
                  span: dummy_span(),
                  node: NUpdate({
                    base: {
                      own: Borrowed,
                      span: dummy_span(),
                      node: NVar({ name: name, slot: Some(sl) }),
                    },
                    copies: copied,
                    sets: map(range(0, len(sets)), |i: Int|
                      {
                        name: match list_at(sets, i) { Some(f) -> f.name.name, None -> b"" },
                        value: nth(o.codes, i),
                      }),
                  }),
                },
                stack: o.stack,
              })
            },
          },
        }
      },
    }
  }
}

// The bare in-scope variable a field copies from, when the field is `b.<its own name>`.
fn copy_base(field: RecField, stack: Stack) -> Option<Bytes> =
  match field.value {
    EField(x) -> if x.field.name != field.name.name { None } else {
      match x.base {
        EVar(v) -> if v.name.module != None { None } else {
          match st_depth(stack, v.name.name.name) {
            Some(_) -> Some(v.name.name.name),
            None -> None,
          }
        },
        _ -> None,
      }
    },
    _ -> None,
  }

// The first in-scope variable a field read projects from inside `e`; a name `e` binds itself is never the base.
fn projected_var(e: Expr, stack: Stack, inner: List<Bytes>) -> Option<Bytes> = {
  let first = |exprs: List<Expr>|
    fold(exprs, None, |acc: Option<Bytes>, x: Expr|
      match acc { Some(_) -> acc, None -> projected_var(x, stack, inner) });
  match e {
    EField(x) -> match x.base {
      EVar(v) -> if v.name.module == None && !has_bytes(inner, v.name.name.name)
          && st_depth(stack, v.name.name.name) != None { Some(v.name.name.name) }
      else { projected_var(x.base, stack, inner) },
      _ -> projected_var(x.base, stack, inner),
    },
    EUnary(x) -> projected_var(x.operand, stack, inner),
    EBinary(x) -> first([x.lhs, x.rhs]),
    EApp(x) -> match projected_var(x.func, stack, inner) {
      Some(n) -> Some(n),
      None -> first(x.args),
    },
    EIf(x) -> first([x.cond, x.then_branch, x.else_branch]),
    EMatch(x) -> projected_var(x.scrutinee, stack, inner),
    EBlock(x) -> {
      let walked = fold(
        x.stmts,
        { found: None, inner: inner },
        |acc: { found: Option<Bytes>, inner: List<Bytes> }, stmt: Stmt|
          match acc.found {
            Some(_) -> acc,
            None -> match stmt {
              SLet(l) ->
                {
                  found: projected_var(l.value, stack, acc.inner),
                  inner: pat_binders(l.pat, acc.inner),
                },
              SLetElse(l) ->
                {
                  found: match projected_var(l.value, stack, acc.inner) {
                    Some(n) -> Some(n),
                    None -> projected_var(l.fallback, stack, acc.inner),
                  },
                  inner: pat_binders(l.pat, acc.inner),
                },
              SExpr(v) -> { found: projected_var(v, stack, acc.inner), inner: acc.inner },
            },
          },
      );
      match walked.found {
        Some(n) -> Some(n),
        None -> match x.tail { Some(t) -> projected_var(t, stack, walked.inner), None -> None },
      }
    },
    ERecord(x) -> first(map(x.fields, |field: RecField| field.value)),
    ERecordUpdate(x) -> match projected_var(x.base, stack, inner) {
      Some(n) -> Some(n),
      None -> first(map(x.fields, |field: RecField| field.value)),
    },
    ETry(x) -> projected_var(x.operand, stack, inner),
    EList(x) -> first(x.items),
    EPerform(x) -> first(x.args),
    EHandle(x) -> projected_var(x.body, stack, inner),
    EWithCell(x) -> match projected_var(x.init, stack, inner) {
      Some(n) -> Some(n),
      None -> projected_var(x.body, stack, push(inner, x.binder.name)),
    },
    _ -> None,
  }
}

fn has_bytes(xs: List<Bytes>, x: Bytes) -> Bool =
  fold(xs, false, |acc: Bool, y: Bytes| acc || y == x)

fn pat_binders(p: Pattern, out: List<Bytes>) -> List<Bytes> =
  match p {
    PVar(v) -> push(out, v.name.name),
    PCtor(c) -> fold(c.args, out, |acc: List<Bytes>, a: Pattern| pat_binders(a, acc)),
    PRecord(r) ->
      fold(r.fields, out, |acc: List<Bytes>, f: { name: Ident, pat: Pattern }|
        pat_binders(f.pat, acc)),
    PList(l) -> {
      let items = fold(l.items, out, |acc: List<Bytes>, a: Pattern| pat_binders(a, acc));
      match l.rest { Some(r) -> pat_binders(r, items), None -> items }
    },
    POr(o) -> fold(o.alts, out, |acc: List<Bytes>, a: Pattern| pat_binders(a, acc)),
    PWild(_) -> out,
    PLit(_) -> out,
    PBad(_) -> out,
  }

fn nth(codes: List<Code>, i: Int) -> Code =
  match list_at(codes, i) {
    Some(c) -> c,
    None -> { own: Borrowed, span: dummy_span(), node: NLit(LUnit) },
  }

type Seq = { codes: List<Code>, stack: Stack }

fn lower_seq(exprs: List<Expr>, stack: Stack) -> Option<Seq> / {abort.raise} =
  fold(exprs, Some({ codes: [], stack: stack }), |acc: Option<Seq>, expr: Expr|
    match acc {
      None -> None,
      Some(s) -> match lower_in(expr, s.stack) {
        Some(o) -> Some({ codes: push(s.codes, o.code), stack: o.stack }),
        None -> None,
      },
    })

// A lambda over `params`: its body lowered behind a barrier, which the captures cross.
fn lower_lambda(params: List<Bytes>, body: Expr, stack: Stack) -> Option<Lowered> / {abort.raise} = {
  let inner = fold(
    params,
    { names: [], scope: [], captures: [], capture_names: [] },
    |g: Frame, n: Bytes| bind(g, n),
  );
  match lower_in(body, st_push(stack, inner)) { None -> None, Some(b) -> Some(lam_of(params, b)) }
}

// Pops the lambda's barrier; the stack below keeps the captures threaded into it.
fn lam_of(params: List<Bytes>, b: Lowered) -> Lowered = {
  let inner = st_top(b.stack);
  {
    code: {
      own: Borrowed,
      span: dummy_span(),
      node: NLambda({
        params: len(params),
        size: len(inner.names),
        captures: inner.captures,
        body: mark(b.code, []).code,
      }),
    },
    stack: st_pop(b.stack),
  }
}

type ClauseAcc = { clauses: List<CodeClause>, stack: Stack, ok: Bool }

type ArmAcc = { arms: List<CodeArm>, stack: Stack, ok: Bool }

type GuardOut = { code: Option<Code>, stack: Stack }

fn lower_guard(expr: Option<Expr>, stack: Stack) -> Option<GuardOut> / {abort.raise} =
  match expr {
    None -> Some({ code: None, stack: stack }),
    Some(e) -> match lower_in(e, stack) {
      None -> None,
      Some(o) -> Some({ code: Some(o.code), stack: o.stack }),
    },
  }

type BlockAcc = { stmts: List<CodeStmt>, stack: Stack, ok: Bool }

// A `match` of the scrutinee lowered as `sc`, with the arms `arms` adds.
fn matched(
  span: Span,
  sc: Lowered,
  arms: (ArmAcc) -> ArmAcc / {abort.raise},
) -> Option<Lowered> / {abort.raise} = {
  let depth = depth_of(sc.stack);
  let walked = arms({ arms: [], stack: sc.stack, ok: true });
  if !walked.ok { None } else {
    Some({
      code: { own: Borrowed, span: span, node: NMatch({ scrutinee: sc.code, arms: walked.arms }) },
      stack: unscope_st(walked.stack, depth),
    })
  }
}

// An arm per alternative of an or-pattern, each with the arm's guard and body: a guard is tried
// again for every alternative that matches, in order.
fn arms_into(
  acc: ArmAcc,
  pat: Pattern,
  guard: Option<Expr>,
  body: (Stack) -> Option<Lowered> / {abort.raise},
) -> ArmAcc / {abort.raise} =
  fold(if has_or(pat) { alternatives_of(pat) } else { [pat] }, acc, |a: ArmAcc, alt: Pattern|
    arm_into(a, alt, guard, body))

// Arm binders leave scope at the arm's end; their slots are not reused.
fn arm_into(
  acc: ArmAcc,
  alt: Pattern,
  guard: Option<Expr>,
  body: (Stack) -> Option<Lowered> / {abort.raise},
) -> ArmAcc / {abort.raise} =
  if !acc.ok { acc } else {
    let pd = depth_of(acc.stack);
    let pat = lower_pat(alt, acc.stack);
    match lower_guard(guard, pat.stack) {
      None -> { arms: acc.arms, stack: acc.stack, ok: false },
      Some(g) -> match body(g.stack) {
        None -> { arms: acc.arms, stack: acc.stack, ok: false },
        Some(b) ->
          {
            arms: push(acc.arms, { pat: pat.pat, guard: g.code, body: b.code }),
            stack: unscope_st(b.stack, pd),
            ok: true,
          },
      },
    }
  }

// A statement whose pattern can fail, or whose alternatives bind in different places, is a `match`
// over the rest of the block; `let ... else` adds its `else` as the arm for everything else.
fn lower_block(
  stmts: List<Stmt>,
  tail: Option<Expr>,
  stack: Stack,
) -> Option<Lowered> / {abort.raise} =
  lower_from(stmts, 0, { stmts: [], stack: stack, ok: true }, depth_of(stack), tail)

// The statements from `from` on: each straight one lowered into `acc`, until one that branches ends
// the block in its `match`, whose arm for the rest is a block of its own.
fn lower_from(
  stmts: List<Stmt>,
  from: Int,
  acc: BlockAcc,
  depth: Int,
  tail: Option<Expr>,
) -> Option<Lowered> / {abort.raise} =
  if !acc.ok { None }
  else if from >= len(stmts) { finished(acc, depth, lower_guard(tail, acc.stack)) } else {
    match list_at(stmts, from) {
      None -> None,
      Some(stmt) -> if branches(stmt) {
        finished(acc, depth, match lower_branch(stmt, stmts, from + 1, tail, acc.stack) {
          None -> None,
          Some(o) -> Some({ code: Some(o.code), stack: o.stack }),
        })
      } else { lower_from(stmts, from + 1, straight(acc, stmt), depth, tail) },
    }
  }

fn branches(stmt: Stmt) -> Bool =
  match stmt { SLetElse(_) -> true, SLet(l) -> has_or(l.pat), SExpr(_) -> false }

// A branching statement's `match`, its first arm the statements from `next` on and the tail.
fn lower_branch(
  stmt: Stmt,
  stmts: List<Stmt>,
  next: Int,
  tail: Option<Expr>,
  stack: Stack,
) -> Option<Lowered> / {abort.raise} = {
  let rest = |st: Stack|
    lower_from(stmts, next, { stmts: [], stack: st, ok: true }, depth_of(st), tail);
  match stmt {
    SLetElse(l) -> match lower_in(l.value, stack) {
      None -> None,
      Some(sc) ->
        matched(l.span, sc, |start: ArmAcc|
          arms_into(
            arms_into(start, l.pat, None, rest),
            PWild({ span: l.span }),
            None,
            |st: Stack| lower_in(l.fallback, st),
          )),
    },
    // The checker refused a `let` whose or-pattern can fail, so its alternatives cover the value.
    SLet(l) -> match lower_in(l.value, stack) {
      None -> None,
      Some(sc) -> matched(l.span, sc, |start: ArmAcc| arms_into(start, l.pat, None, rest)),
    },
    SExpr(e) -> lower_in(e, stack),
  }
}

// A statement that does not branch, lowered onto the block so far.
fn straight(acc: BlockAcc, stmt: Stmt) -> BlockAcc / {abort.raise} =
  if !acc.ok { acc } else {
    match stmt {
      SExpr(e) -> match lower_in(e, acc.stack) {
        Some(o) -> { stmts: push(acc.stmts, CDo({ code: o.code })), stack: o.stack, ok: true },
        None -> { stmts: acc.stmts, stack: acc.stack, ok: false },
      },
      // `lower_from` lowers it as a `match` instead.
      SLetElse(_) -> { stmts: acc.stmts, stack: acc.stack, ok: false },
      SLet(l) -> match binder_of(l.pat) {
        None -> match lower_in(l.value, acc.stack) {
          None -> { stmts: acc.stmts, stack: acc.stack, ok: false },
          Some(o) -> {
            let p = lower_pat(l.pat, o.stack);
            {
              stmts: push(acc.stmts, CLetPat({ span: l.span, pat: p.pat, value: o.code })),
              stack: p.stack,
              ok: true,
            }
          },
        },
        Some(name) -> match lower_in(l.value, acc.stack) {
          None -> { stmts: acc.stmts, stack: acc.stack, ok: false },
          Some(o) ->
            {
              stmts: push(
                acc.stmts,
                CLet({ name: name, slot: len(st_top(o.stack).names), value: o.code }),
              ),
              stack: bind_st(o.stack, name),
              ok: true,
            },
        },
      },
    }
  }

// The block of the statements lowered, ending in the tail `t` lowered after them, if it is.
fn finished(acc: BlockAcc, depth: Int, t: Option<GuardOut>) -> Option<Lowered> =
  match t {
    None -> None,
    Some(o) ->
      Some({
        code: {
          own: Borrowed,
          span: dummy_span(),
          node: NBlock({ stmts: acc.stmts, tail: o.code }),
        },
        stack: unscope_st(o.stack, depth),
      }),
  }

type PatOut = { pat: CodePattern, stack: Stack }

// Binders take slots in walk order. A bare name may be a nullary constructor, so it takes a slot either way.
fn lower_pat(pattern: Pattern, stack: Stack) -> PatOut / {abort.raise} =
  match pattern {
    PWild(_) -> { pat: PxWild, stack: stack },
    PVar(v) -> {
      let name = v.name.name;
      let g = bind_st(stack, name);
      { pat: PxVar({ name: name, slot: slot_in(st_top(g), name) }), stack: g }
    },
    PLit(v) -> { pat: PxLit(v.lit), stack: stack },
    PCtor(c) -> {
      let r = lower_pats(c.args, stack);
      { pat: PxCtor({ name: qname_text(c.name), args: r.pats }), stack: r.stack }
    },
    PRecord(r) -> {
      let walked = fold(
        r.fields,
        { pats: [], stack: stack, names: [] },
        |acc: PatFields, fd: { name: Ident, pat: Pattern }| {
          let o = lower_pat(fd.pat, acc.stack);
          { pats: push(acc.pats, o.pat), stack: o.stack, names: push(acc.names, fd.name.name) }
        },
      );
      {
        pat: PxRecord({
          fields: map(range(0, len(walked.pats)), |i: Int|
            { name: at_or(walked.names, i, b""), pat: nth_pat(walked.pats, i) }),
          rest: r.rest,
        }),
        stack: walked.stack,
      }
    },
    PList(l) -> {
      let r = lower_pats(l.items, stack);
      match l.rest {
        None -> { pat: PxList({ items: r.pats, rest: None }), stack: r.stack },
        Some(rp) -> {
          let o = lower_pat(rp, r.stack);
          { pat: PxList({ items: r.pats, rest: Some(o.pat) }), stack: o.stack }
        },
      }
    },
    // A match's arms and `lower_block` are lowered an alternative at a time, so no or-pattern is left
    // for this to meet.
    POr(_) -> panic("an or-pattern reached the lowering unexpanded"),
    PBad(_) -> { pat: PxWild, stack: stack },
  }

fn lower_pats(patterns: List<Pattern>, stack: Stack) -> PatSeq / {abort.raise} =
  fold(patterns, { pats: [], stack: stack }, |acc: PatSeq, pattern: Pattern| {
    let o = lower_pat(pattern, acc.stack);
    { pats: push(acc.pats, o.pat), stack: o.stack }
  })

type PatFields = { pats: List<CodePattern>, stack: Stack, names: List<Bytes> }
type PatSeq = { pats: List<CodePattern>, stack: Stack }

fn nth_pat(xs: List<CodePattern>, i: Int) -> CodePattern =
  match list_at(xs, i) { Some(x) -> x, None -> PxWild }

pub fn qname_text(qname: QName) -> Bytes =
  match qname.module {
    // `::`, not the source's `.`: the dump must match the Rust side's spelling.
    Some(m) -> bytes_concat_all([m.name, b"::", qname.name.name]),
    None -> qname.name.name,
  }

// The slots a pattern binds; the ownership pass drops them walking back past it.
pub fn pat_slots(p: CodePattern) -> List<Int> =
  match p {
    PxWild -> [],
    PxVar(v) -> match v.slot { Some(s) -> [s], None -> [] },
    PxLit(_) -> [],
    PxCtor(c) -> fold(c.args, [], |acc: List<Int>, a: CodePattern| live_union(acc, pat_slots(a))),
    PxRecord(r) ->
      fold(r.fields, [], |acc: List<Int>, f: CodePatternField| live_union(acc, pat_slots(f.pat))),
    PxList(l) -> {
      let items = fold(l.items, [], |acc: List<Int>, i: CodePattern| live_union(acc, pat_slots(i)));
      match l.rest { Some(r) -> live_union(items, pat_slots(r)), None -> items }
    },
  }

// Only a single-name binder; any other pattern lowers as `CLetPat`.
fn binder_of(pattern: Pattern) -> Option<Bytes> =
  match pattern { PVar(id) -> Some(id.name.name), _ -> None }

// --- ownership --------------------------------------------------------------
// Backwards: a read is `Owned` when its slot is not read again after it, else `Borrowed`.
// Liveness is by slot, not name: a shadowed name is two slots that die at different points.

type Marked = { code: Code, live: List<Int> }

fn live_has(live: List<Int>, s: Int) -> Bool = fold(live, false, |acc: Bool, x: Int| acc || x == s)

fn live_add(live: List<Int>, s: Int) -> List<Int> =
  if live_has(live, s) { live } else { push(live, s) }

fn live_union(a: List<Int>, b: List<Int>) -> List<Int> =
  fold(b, a, |acc: List<Int>, x: Int| live_add(acc, x))

fn live_drop(live: List<Int>, s: Int) -> List<Int> = filter(live, |x: Int| x != s)

// The slot a projection reads through, when its base is a bare variable.
fn base_slot(code: Code) -> Option<Int> = match code.node { NVar(v) -> v.slot, _ -> None }

pub fn mark(c: Code, live: List<Int>) -> Marked =
  match c.node {
    NLit(_) -> { code: c, live: live },
    NLabel(_) -> { code: c, live: live },
    NVar(v) -> match v.slot {
      None -> { code: c, live: live },
      Some(s) ->
        {
          code: {
            own: if live_has(live, s) { Borrowed } else { Owned },
            node: c.node,
            span: c.span,
          },
          live: live_add(live, s),
        },
    },
    // The base is read after every written field, so backwards it is marked first.
    NUpdate(u) -> {
      let s = match base_slot(u.base) { Some(x) -> x, None -> -1 };
      let owned = s >= 0 && !live_has(live, s);
      let base = {
        own: if owned { Owned } else { Borrowed },
        node: u.base.node,
        span: u.base.span,
      };
      let after = if s < 0 { live } else { live_add(live, s) };
      let r = mark_seq(map(u.sets, |f: CodeField| f.value), after);
      {
        code: {
          own: Borrowed,
          span: c.span,
          node: NUpdate({
            base: base,
            copies: u.copies,
            sets: map(range(0, len(u.sets)), |i: Int|
              {
                name: match list_at(u.sets, i) { Some(f) -> f.name, None -> b"" },
                value: nth(r.codes, i),
              }),
          }),
        },
        live: r.live,
      }
    },
    NUnary(u) -> {
      let o = mark(u.operand, live);
      {
        code: { own: Borrowed, span: c.span, node: NUnary({ op: u.op, operand: o.code }) },
        live: o.live,
      }
    },
    NBinary(b) -> {
      let r = mark(b.rhs, live);
      let l = mark(b.lhs, r.live);
      {
        code: {
          own: Borrowed,
          span: c.span,
          node: NBinary({ op: b.op, lhs: l.code, rhs: r.code }),
        },
        live: l.live,
      }
    },
    // The base is marked here so the node stays `Borrowed`: a last read may move the record out, never a field.
    NField(fd) -> match base_slot(fd.base) {
      None -> {
        let b = mark(fd.base, live);
        {
          code: { own: Borrowed, span: c.span, node: NField({ base: b.code, field: fd.field }) },
          live: b.live,
        }
      },
      Some(s) -> {
        let base = {
          own: if live_has(live, s) { Borrowed } else { Owned },
          node: fd.base.node,
          span: fd.base.span,
        };
        {
          code: { own: Borrowed, span: c.span, node: NField({ base: base, field: fd.field }) },
          live: live_add(live, s),
        }
      },
    },
    // Every arm sees the same future, and each arm's binders die at the arm.
    // Walked last arm first: a failing guard goes on to the later arms, whose tests read the subject again,
    // so they and whatever the subject was read from are its future too.
    NMatch(m) -> {
      let subject = mark(m.scrutinee, []).live;
      let n = len(m.arms);
      let marked = fold(range(0, n), { arms: [], live: [] }, |acc: ArmMark, k: Int|
        match list_at(m.arms, n - 1 - k) {
          None -> acc,
          Some(a) -> {
            let b = mark(a.body, live);
            let g: GuardMark = match a.guard {
              None -> { guard: None, live: b.live },
              Some(gc) -> {
                let later = if len(acc.arms) == 0 { acc.live }
                else { live_union(acc.live, subject) };
                let gm = mark(gc, live_union(b.live, later));
                { guard: Some(gm.code), live: gm.live }
              },
            };
            let after = fold(pat_slots(a.pat), g.live, |x: List<Int>, s: Int| live_drop(x, s));
            {
              arms: push(acc.arms, { pat: a.pat, guard: g.guard, body: b.code }),
              live: live_union(acc.live, after),
            }
          },
        });
      let sc = mark(m.scrutinee, marked.live);
      {
        code: {
          own: Borrowed,
          span: c.span,
          node: NMatch({ scrutinee: sc.code, arms: rev_arms(marked.arms) }),
        },
        live: sc.live,
      }
    },
    // The body was marked when lowered; the captures are reads of this barrier where the closure is made.
    NLambda(l) -> {
      let w = mark_caps(l.captures, live);
      {
        code: {
          own: Borrowed,
          span: c.span,
          node: NLambda({ params: l.params, size: l.size, captures: w.captures, body: l.body }),
        },
        live: w.live,
      }
    },
    NParallel(pr) -> {
      let r = mark_seq(pr.branches, live);
      {
        code: { own: Borrowed, span: c.span, node: NParallel({ branches: r.codes }) },
        live: r.live,
      }
    },
    // Captures are reads of this barrier on entry, as a lambda's are.
    NSimulate(sm) -> {
      let w = mark_caps(sm.captures, live);
      {
        code: {
          own: Borrowed,
          span: c.span,
          node: NSimulate({ size: sm.size, captures: w.captures, body: sm.body }),
        },
        live: w.live,
      }
    },
    NHandle(h) -> {
      let cls = fold(h.clauses, { captures: [], live: live }, |acc: CapMark, c: CodeClause| {
        let w = mark_caps(c.captures, acc.live);
        { captures: acc.captures, live: w.live }
      });
      let marked = map(h.clauses, |c: CodeClause| c);
      let b = mark(h.body, cls.live);
      {
        code: {
          own: Borrowed,
          span: c.span,
          node: NHandle({ body: b.code, clauses: marked, ret: h.ret }),
        },
        live: b.live,
      }
    },
    NPerform(p) -> {
      let r = mark_seq(p.args, live);
      let lb = match p.label {
        Some(x) -> { code: Some(mark(x, r.live).code), live: mark(x, r.live).live },
        None -> { code: None, live: r.live },
      };
      {
        code: {
          own: Borrowed,
          span: c.span,
          node: NPerform({
            effect: p.effect,
            op: p.op,
            resource: p.resource,
            label: lb.code,
            args: r.codes,
          }),
        },
        live: lb.live,
      }
    },
    // The binder dies at the `with_cell`, as a `let`'s does at its `let`.
    NCell(cl) -> {
      let b = mark(cl.body, live);
      let after = match cl.slot { None -> b.live, Some(s) -> live_drop(b.live, s) };
      let i = mark(cl.init, after);
      {
        code: {
          own: Borrowed,
          span: c.span,
          node: NCell({
            resource: cl.resource,
            binder: cl.binder,
            slot: cl.slot,
            init: i.code,
            body: b.code,
          }),
        },
        live: i.live,
      }
    },
    NIf(i) -> {
      let t = mark(i.then_branch, live);
      let e = mark(i.else_branch, live);
      let cnd = mark(i.cond, live_union(t.live, e.live));
      {
        code: {
          own: Borrowed,
          span: c.span,
          node: NIf({ cond: cnd.code, then_branch: t.code, else_branch: e.code }),
        },
        live: cnd.live,
      }
    },
    NList(l) -> {
      let r = mark_seq(l.items, live);
      { code: { own: Borrowed, span: c.span, node: NList({ items: r.codes }) }, live: r.live }
    },
    NRecord(rc) -> {
      let r = mark_seq(map(rc.fields, |fd: CodeField| fd.value), live);
      {
        code: {
          own: Borrowed,
          span: c.span,
          node: NRecord({
            fields: map(range(0, len(rc.fields)), |i: Int|
              { name: cfield_name(rc.fields, i), value: nth(r.codes, i) }),
          }),
        },
        live: r.live,
      }
    },
    NApp(a) -> {
      let args = mark_seq(a.args, live);
      let fu = mark(a.func, args.live);
      {
        code: { own: Borrowed, span: c.span, node: NApp({ func: fu.code, args: args.codes }) },
        live: fu.live,
      }
    },
    NBlock(b) -> {
      let after = match b.tail {
        None -> { code: { own: Borrowed, span: dummy_span(), node: NLit(LUnit) }, live: live },
        Some(t) -> mark(t, live),
      };
      // Last statement first.
      let n = len(b.stmts);
      let walked = fold(range(0, n), { codes: [], live: after.live }, |acc: StmtSeq, k: Int|
        match list_at(b.stmts, n - 1 - k) {
          None -> acc,
          Some(CDo(d)) -> {
            let m = mark(d.code, acc.live);
            { codes: push(acc.codes, CDo({ code: m.code })), live: m.live }
          },
          // The binder dies at its `let`: nothing before it can read the slot.
          Some(CLet(l)) -> {
            let m = mark(l.value, live_drop(acc.live, l.slot));
            {
              codes: push(acc.codes, CLet({ name: l.name, slot: l.slot, value: m.code })),
              live: m.live,
            }
          },
          Some(CLetPat(l)) -> {
            let dropped = fold(pat_slots(l.pat), acc.live, |x: List<Int>, sl: Int|
              live_drop(x, sl));
            let m = mark(l.value, dropped);
            {
              codes: push(acc.codes, CLetPat({ span: l.span, pat: l.pat, value: m.code })),
              live: m.live,
            }
          },
        });
      {
        code: {
          own: Borrowed,
          span: c.span,
          node: NBlock({
            stmts: rev_stmts(walked.codes),
            tail: match b.tail { None -> None, Some(_) -> Some(after.code) },
          }),
        },
        live: walked.live,
      }
    },
  }

type CapMark = { captures: List<Capture>, live: List<Int> }

// A capture reads the enclosing barrier's slot, `Owned` when nothing after it wants that slot.
fn mark_caps(caps: List<Capture>, live: List<Int>) -> CapMark = {
  let walked = fold(
    rev_caps(caps),
    { captures: [], live: live },
    |acc: CapMark, capture: Capture|
      {
        captures: push(acc.captures, {
          src: capture.src,
          dst: capture.dst,
          own: if live_has(acc.live, capture.src) { Borrowed } else { Owned },
        }),
        live: live_add(acc.live, capture.src),
      },
  );
  { captures: rev_caps(walked.captures), live: walked.live }
}

type ArmMark = { arms: List<CodeArm>, live: List<Int> }

type GuardMark = { guard: Option<Code>, live: List<Int> }

type StmtSeq = { codes: List<CodeStmt>, live: List<Int> }

fn cfield_name(fs: List<CodeField>, i: Int) -> Bytes =
  match list_at(fs, i) { Some(fd) -> fd.name, None -> b"" }

// Last code first.
fn mark_seq(codes: List<Code>, live: List<Int>) -> MarkedSeq = {
  let n = len(codes);
  let walked = fold(range(0, n), { codes: [], live: live }, |acc: MarkedSeq, k: Int|
    match list_at(codes, n - 1 - k) {
      None -> acc,
      Some(code) -> {
        let m = mark(code, acc.live);
        { codes: push(acc.codes, m.code), live: m.live }
      },
    });
  { codes: rev_codes(walked.codes), live: walked.live }
}

type MarkedSeq = { codes: List<Code>, live: List<Int> }

fn rev_codes(codes: List<Code>) -> List<Code> =
  map(range(0, len(codes)), |i: Int| nth(codes, len(codes) - 1 - i))

fn rev_caps(xs: List<Capture>) -> List<Capture> =
  map(range(0, len(xs)), |i: Int|
    match list_at(xs, len(xs) - 1 - i) { Some(x) -> x, None -> { src: 0, dst: 0, own: Borrowed } })

fn rev_arms(xs: List<CodeArm>) -> List<CodeArm> =
  map(range(0, len(xs)), |i: Int|
    match list_at(xs, len(xs) - 1 - i) {
      Some(x) -> x,
      None ->
        {
          pat: PxWild,
          guard: None,
          body: { own: Borrowed, span: dummy_span(), node: NLit(LUnit) },
        },
    })

fn rev_stmts(xs: List<CodeStmt>) -> List<CodeStmt> =
  map(range(0, len(xs)), |i: Int|
    match list_at(xs, len(xs) - 1 - i) {
      Some(x) -> x,
      None -> CDo({ code: { own: Borrowed, span: dummy_span(), node: NLit(LUnit) } }),
    })

// --- the module entry ------------------------------------------------------

// `L;n;`, then one record per lowered function; a function not lowered is skipped and counted.

pub type LowerOut = { dump: Bytes, lowered: Int, skipped: Int }

// One function body: slots resolved forwards, then ownership marked backwards.
// `params` ends with `labels`, the hidden trailing parameters a label-generic definition takes.
pub fn lower_fn(
  params: List<Bytes>,
  labels: List<Bytes>,
  sites: Map<Bytes, List<Bytes>>,
  body: Expr,
) -> Option<{ code: Code, size: Int }> / {abort.raise} = {
  let start = fold(
    params,
    { names: [], scope: [], captures: [], capture_names: [] },
    |frame: Frame, p: Bytes| bind(frame, p),
  );
  match lower_in(body, { frames: [start], labels: labels, sites: sites }) {
    None -> None,
    Some(o) -> Some({ code: mark(o.code, []).code, size: len(st_top(o.stack).names) }),
  }
}

pub fn lower_module(src: Bytes) -> LowerOut / {abort.raise} = {
  let r = parse(src);
  let x = expand(r.node, r.parser.diags);
  fold(x.module.items, { dump: b"L;1;", lowered: 0, skipped: 0 }, |acc: LowerOut, item: Item|
    match item {
      IFn(d) -> {
        let labels = map(d.generics.labels, |ident: Ident| ident.name);
        let names = fold(
          labels,
          map(d.params, |param: Param| param.name.name),
          |xs: List<Bytes>, n: Bytes| push(xs, n),
        );
        match lower_fn(names, labels, map_new(), d.body) {
          None -> { dump: acc.dump, lowered: acc.lowered, skipped: acc.skipped + 1 },
          Some(l) ->
            {
              dump: bytes_concat_all([
                acc.dump,
                b"f:m.",
                d.name.name,
                b":",
                int_to_bytes(len(names)),
                b":",
                int_to_bytes(l.size),
                b";",
                dump(l.code),
                b";",
              ]),
              lowered: acc.lowered + 1,
              skipped: acc.skipped,
            },
        }
      },
      _ -> acc,
    })
}

pub fn lower_dump(src: Bytes) -> String / {abort.raise} = string_of_bytes(lower_module(src).dump)

test "a literal lowers to itself" {
  assert_eq(lower_dump(b"fn f() -> Int = 1\n"), "L;1;f:m.f:0:0;blit(i1);")
}

test "binary operands are lowered left to right" {
  assert_eq(lower_dump(b"fn f() -> Int = 1 + 2\n"), "L;1;f:m.f:0:0;bbin(add,blit(i1),blit(i2));")
}

test "a name with no binder has no slot" {
  assert_eq(lower_dump(b"fn f() -> Int = g()\n"), "L;1;f:m.f:0:0;bapp(bvar(g,-));")
}

test "a parameter reads its slot and the last read owns it" {
  assert_eq(
    lower_dump(b"fn f(a: Int, b: Int) -> Int = a * b\n"),
    "L;1;f:m.f:2:2;bbin(mul,ovar(a,0),ovar(b,1));",
  )
}

test "a read with another after it borrows" {
  assert_eq(
    lower_dump(b"fn f(x: Int) -> Int = x + x\n"),
    "L;1;f:m.f:1:1;bbin(add,bvar(x,0),ovar(x,0));",
  )
}

test "both arms of an `if` see the same future" {
  assert_eq(
    lower_dump(b"fn f(n: Int) -> Int = if n > 0 { n } else { 0 - n }\n"),
    "L;1;f:m.f:1:1;bif(bbin(gt,bvar(n,0),blit(i0)),bblock(ovar(n,0)),bblock(bbin(sub,blit(i0),ovar(n,0))));",
  )
}

test "a `let` takes the next slot and the binder dies at it" {
  assert_eq(
    lower_dump(b"fn f(a: Int) -> Int = { let b = a + 1; b }\n"),
    "L;1;f:m.f:1:2;bblock(let(v:b:1,bbin(add,ovar(a,0),blit(i1))),ovar(b,1));",
  )
}

test "a match binds its arms into the window and each arm's binders leave at its end" {
  assert_eq(
    lower_dump(b"fn f(o: Option<Int>) -> Int = match o { Some(n) -> n, None -> 0 }\n"),
    "L;1;f:m.f:1:2;bmatch(ovar(o,0),arm(c:Some(v:n:1,),-,ovar(n,1)),arm(c:None(),-,blit(i0)));",
  )
}

test "a guard is lowered between its arm's pattern and body and reads the arm's binders" {
  assert_eq(
    lower_dump(b"fn f(n: Int) -> Int = match n { x if x > 0 -> x, _ -> n }\n"),
    "L;1;f:m.f:1:2;bmatch(bvar(n,0),arm(v:x:1,bbin(gt,bvar(x,1),blit(i0)),ovar(x,1)),arm(_,-,ovar(n,0)));",
  )
}

test "a guard borrows what a later arm still reads, the matched variable included" {
  assert_eq(
    lower_dump(b"fn f(n: Int, m: Int) -> Int = match n { x if x > m -> x, _ -> m }\n"),
    "L;1;f:m.f:2:3;bmatch(bvar(n,0),arm(v:x:2,bbin(gt,bvar(x,2),bvar(m,1)),ovar(x,2)),arm(_,-,ovar(m,1)));",
  )
}

test "an or-pattern arm lowers to an arm per alternative, each binding its own slot" {
  assert_eq(
    lower_dump(b"fn f(p: (Int, Int)) -> Int = match p { (x, 0) | (0, x) -> x, _ -> 1 }\n"),
    "L;1;f:m.f:1:3;bmatch(ovar(p,0),arm(r:(_0=v:x:1,_1=l:i0,),-,ovar(x,1)),arm(r:(_0=l:i0,_1=v:x:2,),-,ovar(x,2)),arm(_,-,blit(i1)));",
  )
}

test "a `let ... else` lowers to a match over the rest of its block" {
  assert_eq(
    lower_dump(b"fn f(o: Option<Int>) -> Int = { let Some(v) = o else { 0 }; v + 1 }\n"),
    "L;1;f:m.f:1:2;bblock(bmatch(ovar(o,0),arm(c:Some(v:v:1,),-,bblock(bbin(add,ovar(v,1),blit(i1)))),arm(_,-,bblock(blit(i0)))));",
  )
}

test "what the dump holds is what the count reports" {
  let out = lower_module(b"fn f() -> Int = 1\nfn g(a: Int) -> Int = a\nfn h() -> Int = 2\n");
  assert_eq(out.lowered, 3);
  assert_eq(out.skipped, 0);
  assert_eq(
    count_records(
      bytes_of_string(
        lower_dump(b"fn f() -> Int = 1\nfn g(a: Int) -> Int = a\nfn h() -> Int = 2\n"),
      ),
    ),
    3,
  )
}

// Counts records by their `f:m.` heads.
fn count_records(d: Bytes) -> Int / {abort.raise} =
  fold(range(0, bytes_len(d) - 3), 0, |acc: Int, i: Int|
    if bytes_at(d, i) == 102 && bytes_at(d, i + 1) == 58 && bytes_at(d, i + 2) == 109
        && bytes_at(d, i + 3) == 46 { acc + 1 }
    else { acc })
