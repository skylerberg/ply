//! The memo store as segments in a directory (`segments`): what a run kept is one segment, named by
//! the store's manifest when the run ends, so a later run sees all of it or none. A segment holds the
//! records the run kept and the longer answers as frames, and tables of rows: what the run says of
//! each key it touched, the keys it left marked, what it saw at each place of the world, who read
//! each place or asked each record, where each longer answer lies, and the queries its records
//! answer under with when each was last seen running. The newest row of a key says what it answers,
//! how high it stands and whether it is marked; the newest that brought a record says where it lies,
//! always in its own segment.
//!
//! A row vouches for a record to the stamps it names: what names the queries a run answers under, the
//! pack below the store and the shipped files the run reads. A record is taken without its reads
//! being asked again only where the run's own stamp vouches for it: walking the key's rows newest
//! first, a row its stamp vouches in says whether the record stands; a row of other stamps that
//! marks the key, or brought it a new record, says it does not; a row of other stamps that only
//! checked it says nothing. So a `ply` of other queries running over the store writes only that it
//! checked what it took, and two taking turns each keep what they checked.
//!
//! A store keeps itself small. A run that names a segment writes the newest segments again as one
//! while each is at most twice what follows it, so a store is a handful of segments and a byte is
//! written again only as what follows it doubles. Writing all of them again keeps the records of
//! the queries the run answers under and, of the queries only other `ply`s answer under, those most
//! lately answered under, while they hold no more than the run's own hold: a store two `ply`s
//! take turns on holds both, and what only the dropped records named goes too.

import std.bin
import std.fs
import std.fs (fs)
import std.bytes (u32_le, u64_le)
import std.list
import memo
import memo (Record, Seen, memo, memo_keep, answer, started, at_height, digest_of, height_named,
             inline_named, kept_inline, output_named, record_bytes, record_from, seen_bin, settles)
import packs
import segments
import segments (Manifest, Segment, Table, Writing, Named)

/// What names the shapes this store keeps: a `ply` that keeps others has a manifest of its own.
fn shapes() -> Bytes = b"ply memo store: rows 2, records 5".blake3()

/// The directories of a store laid out as a file a record, which no run of this layout reads.
fn retired() -> List<String> = ["records", "outputs", "places", "links", "marked", "holds", "runs"]

fn records_table() -> Int = 1

fn marked_table() -> Int = 2

fn places_table() -> Int = 3

fn readers_table() -> Int = 4

fn answers_table() -> Int = 5

fn queries_table() -> Int = 6

fn record_width() -> Int = 88

fn key_width() -> Int = 32

fn reader_width() -> Int = 64

/// A key, where a frame lies and how long its payload is.
fn placed_width() -> Int = 44

/// A query's name in the store and when it was last seen.
fn query_width() -> Int = 40

/// What a segment says of a key: whether its record is marked; whether the segment brought the
/// record, which then lies in it at `offset` and is `size` bytes; whether the row breaks with what
/// older rows say, so that only the stamps it names take the record unchecked; the place of the
/// record's query among the segment's queries; the key's height; the stamps that vouch for the
/// record, a bit for each of the segment's; and the hash of the record's answer.
type Row = {
  marked: Bool,
  brought: Bool,
  breaks: Bool,
  query: Int,
  height: Int,
  vouchers: Int,
  offset: Int,
  size: Int,
  answer: Bytes,
}

/// What follows a key in the row that says `r` of it.
fn row_rest(r: Row) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    byte_of_int(
      (if r.marked { 1 } else { 0 }) + (if r.brought { 2 } else { 0 })
        + (if r.breaks { 4 } else { 0 }),
    ),
    byte_of_int(0),
    byte_of_int(r.query & 255),
    byte_of_int(r.query >> 8 & 255),
    u32_le(r.height),
    u32_le(r.vouchers),
    u64_le(r.offset),
    u32_le(r.size),
    r.answer,
  ])

fn row_from(b: Bytes) -> Row / {abort.raise} = {
  let flags = b.at(32);
  {
    marked: flags & 1 == 1,
    brought: flags & 2 == 2,
    breaks: flags & 4 == 4,
    query: b.at(34) + b.at(35) * 256,
    height: segments::word_at(b, 36),
    vouchers: segments::word_at(b, 40),
    offset: segments::long_at(b, 44),
    size: segments::word_at(b, 52),
    answer: b.slice(56, 88),
  }
}

/// The digest of the answer kept under `key`.
fn answer_digest(key: Bytes) -> Bytes = b"=".concat(key)

/// Where a frame lies in the segment `token` names, and how long its payload is.
type Found = { token: Bytes, offset: Int, size: Int }

// --- What a run holds of the store ------------------------------------------

/// What the segments say of a key: its newest row, the query that row names and when that query was
/// last seen, and whether the run's stamp vouches for the record.
type Known = { row: Row, query: Bytes, seen: Int, trusted: Bool }

/// What a run says of a key it kept a record under, checked, marked or raised: the hash of the
/// record's answer, its query and when that was last seen, the key's height, where the record lies
/// in the run's segment where the run brought it, and whether the run vouches for it.
type Mine = {
  answer: Bytes,
  query: Bytes,
  seen: Int,
  height: Int,
  frame: Option<{ offset: Int, size: Int }>,
  vouch: Bool,
}

/// What a run saw at a place it looked at, and its digest.
type Looked = { value: Option<Bytes>, digest: Bytes }

/// What a run holds of a store: the stamp it runs under, the queries it answers under and when it
/// began; what it saw at each place it looked at, by the place's id; the manifest it read; each
/// table read so far, by its segment's token and its number; the segments a table of which did not
/// read, after the first of which nothing kept is vouched for; what the segments say of each key
/// asked; what this run says of each key it touched, and the marks on each as it leaves them, the
/// store's own all one mark; how many marks it has made; the run's segment; each place as last
/// seen, read when first asked, and those this run saw; the readers it noted, under what they read;
/// where each longer answer it kept lies; the answers records hold inside them, and for each answer
/// a row named, a key whose record may hold it; each record read; the longer answers read or kept,
/// held while they come to no more than a bound, and how many bytes they are; those a segment names
/// and does not hold; the answers kept for the rest of the run only; and the pack below the store,
/// whether its records stand as they are, each record of it read, and those this run found standing.
type Open = {
  stamp: Bytes,
  own: Map<Bytes, Bool>,
  now: Int,
  looked: Map<Bytes, Looked>,
  manifest: Manifest,
  tables: Map<Bytes, Bytes>,
  lost: List<Bytes>,
  known: Map<Bytes, Option<Known>>,
  mine: Map<Bytes, Mine>,
  marks: Map<Bytes, List<Bytes>>,
  minted: Int,
  out: Writing,
  places: Option<Map<Bytes, Seen>>,
  saw: Map<Bytes, Seen>,
  readers: Map<Bytes, List<Bytes>>,
  answers: Map<Bytes, Bytes>,
  inlined: Map<Bytes, Bytes>,
  named: Map<Bytes, Bytes>,
  read: Map<Bytes, Bytes>,
  held: Map<Bytes, Bytes>,
  holding: Int,
  unread: Map<Bytes, Bool>,
  transient: Map<Bytes, Bytes>,
  pack: packs::Reading,
  trusted: Bool,
  packed: Map<Bytes, Option<Bytes>>,
  checked: Map<Bytes, Bool>,
}

/// How many bytes of longer answers a run holds, so that one asked again is not read again.
fn held_bound() -> Int = 268435456

/// `o` holding the longer answer `name`, where there is room for it.
fn holding(o: Open, name: Bytes, answer: Bytes) -> Open =
  if o.held.contains(name) || o.holding + answer.len() > held_bound() { o }
  else { { ..o, held: o.held.insert(name, answer), holding: o.holding + answer.len() } }

/// The stamp a run writes under until it names one: every run that names none shares it.
fn stamp_of(named: Bytes) -> Bytes = if named.len() == 32 { named } else { named.blake3() }

fn opened(m: Manifest, now: Int) -> Open =
  {
    stamp: stamp_of(b""),
    own: Map::new(),
    now: now,
    looked: Map::new(),
    manifest: m,
    tables: Map::new(),
    lost: [],
    known: Map::new(),
    mine: Map::new(),
    marks: Map::new(),
    minted: 0,
    out: segments::unwritten(),
    places: None,
    saw: Map::new(),
    readers: Map::new(),
    answers: Map::new(),
    inlined: Map::new(),
    named: Map::new(),
    read: Map::new(),
    held: Map::new(),
    holding: 0,
    unread: Map::new(),
    transient: Map::new(),
    pack: packs::none(),
    trusted: false,
    packed: Map::new(),
    checked: Map::new(),
  }

/// The rows of `table` in `seg`, read once a run: a table that does not read is no rows, and its
/// segment is lost.
fn table<[r]>(
  dir: String,
  o: Open,
  seg: Segment,
  table: Int,
) -> { open: Open, rows: Bytes } / {fs.read[r], abort.raise} = {
  let name = seg.token.concat(byte_of_int(table));
  match o.tables.get(name) {
    Some(rows) -> { open: o, rows: rows },
    None -> match segments::rows[r](dir, seg, table) {
      Some(rows) -> { open: { ..o, tables: o.tables.insert(name, rows) }, rows: rows },
      None ->
        {
          open: {
            ..o,
            tables: o.tables.insert(name, b""),
            lost: if o.lost.contains(seg.token) { o.lost } else { o.lost.push(seg.token) },
          },
          rows: b"",
        },
    },
  }
}

/// The query the `nth` of `queries`, a segment's rows of them, names, and when it was last seen:
/// no bytes where there is no such row.
fn query_in(queries: Bytes, nth: Int) -> { query: Bytes, seen: Int } / {abort.raise} = {
  let at = nth * query_width();
  if at + query_width() > queries.len() { { query: b"", seen: 0 } }
  else { { query: queries.slice(at, at + 32), seen: segments::long_at(queries, at + 32) } }
}

/// Whether `stamp` vouches for `row` of `seg`: a segment below the floor vouches for nothing.
fn vouches(m: Manifest, seg: Segment, row: Row, stamp: Bytes) -> Bool =
  !segments::below_floor(m, seg)
    && range(0, seg.stamps.len()).fold(false, |any: Bool, i: Int|
      any || (row.vouchers >> i & 1 == 1 && seg.stamps.at(i) == Some(stamp)))

/// What the segments say of `key` under the run's stamp, found once a run: nothing where no
/// segment holds a row of it.
fn known_of<[r]>(
  dir: String,
  o: Open,
  key: Bytes,
) -> { open: Open, known: Option<Known> } / {fs.read[r], abort.raise} =
  match o.known.get(key) {
    Some(k) -> { open: o, known: k },
    None -> {
      let found = iterate(
        { i: o.manifest.segments.len() - 1, open: o, newest: None },
        1000000,
        |x: { i: Int, open: Open, newest: Option<{ row: Row, seg: Segment }> }|
          if x.i < 0 { Stop({ open: x.open, newest: x.newest, trusted: false }) } else {
            let seg = x.open.manifest.segments.get(x.i);
            let t = table[r](dir, x.open, seg, records_table());
            match segments::row_of(t.rows, record_width(), key) {
              None -> Continue({ i: x.i - 1, open: t.open, newest: x.newest }),
              Some(b) -> {
                let row = row_from(b);
                let newest = match x.newest {
                  Some(_) -> x.newest,
                  None -> Some({ row: row, seg: seg }),
                };
                match settles({
                    own: vouches(t.open.manifest, seg, row, t.open.stamp),
                    stands: !row.marked,
                    fresh: row.breaks,
                  }) {
                  Some(trusted) -> Stop({ open: t.open, newest: newest, trusted: trusted }),
                  None -> Continue({ i: x.i - 1, open: t.open, newest: newest }),
                }
              },
            }
          },
      );
      let known = match found.newest {
        None -> { open: found.open, known: None },
        Some(n) -> {
          let t = table[r](dir, found.open, n.seg, queries_table());
          let q = query_in(t.rows, n.row.query);
          {
            open: t.open,
            known: Some({ row: n.row, query: q.query, seen: q.seen, trusted: found.trusted }),
          }
        },
      };
      {
        open: { ..known.open, known: known.open.known.insert(key, known.known) },
        known: known.known,
      }
    },
  }

/// Where the record under `key` lies: in the newest segment that brought the key a record, where
/// that record answers `answer`, as the key's newest row says its record does.
fn frame_row<[r]>(
  dir: String,
  o: Open,
  key: Bytes,
  answer: Bytes,
) -> { open: Open, at: Option<Found> } / {fs.read[r], abort.raise} =
  iterate({ i: o.manifest.segments.len() - 1, open: o }, 1000000, |x: { i: Int, open: Open }|
    if x.i < 0 { Stop({ open: x.open, at: None }) } else {
      let seg = x.open.manifest.segments.get(x.i);
      let t = table[r](dir, x.open, seg, records_table());
      match segments::row_of(t.rows, record_width(), key) {
        None -> Continue({ i: x.i - 1, open: t.open }),
        Some(b) -> {
          let row = row_from(b);
          if row.answer != answer { Stop({ open: t.open, at: None }) } else if row.brought {
            Stop({
              open: t.open,
              at: Some({ token: seg.token, offset: row.offset, size: row.size }),
            })
          } else { Continue({ i: x.i - 1, open: t.open }) }
        },
      }
    })

/// The payload framed at `at`: one the run whose segment `mine` names has yet to append is read
/// where it waits.
fn frame_of<[r]>(
  dir: String,
  mine: Bytes,
  o: Open,
  at: Found,
) -> Option<Bytes> / {fs.read[r], abort.raise} =
  match if at.token == mine { segments::waiting_at(o.out, at.offset) } else { None } {
    Some(payload) -> Some(payload),
    None -> segments::payload[r](dir, at.token, at.offset, at.size),
  }

/// Where the longer answer `name` lies in the newest segment that holds it.
fn answer_row<[r]>(
  dir: String,
  o: Open,
  name: Bytes,
) -> { open: Open, at: Option<Found> } / {fs.read[r], abort.raise} =
  iterate({ i: o.manifest.segments.len() - 1, open: o }, 1000000, |x: { i: Int, open: Open }|
    if x.i < 0 { Stop({ open: x.open, at: None }) } else {
      let seg = x.open.manifest.segments.get(x.i);
      let t = table[r](dir, x.open, seg, answers_table());
      match segments::row_of(t.rows, placed_width(), name) {
        None -> Continue({ i: x.i - 1, open: t.open }),
        Some(b) ->
          Stop({
            open: t.open,
            at: Some({
              token: seg.token,
              offset: segments::long_at(b, 32),
              size: segments::word_at(b, 40),
            }),
          }),
      }
    })

/// Each place a segment's one frame of places holds, laid over `acc`.
fn places_in(acc: Map<Bytes, Seen>, frame: Bytes) -> Map<Bytes, Seen> / {abort.raise} =
  iterate({ at: 0, acc: acc }, 100000000, |x: { at: Int, acc: Map<Bytes, Seen> }|
    if x.at + 36 > frame.len() { Stop(x.acc) } else {
      let size = segments::word_at(frame, x.at + 32);
      let next = x.at + 36 + size;
      if next > frame.len() { Stop(x.acc) } else {
        match bin::decode(frame.slice(x.at + 36, next), seen_bin()) {
          Ok(s) -> Continue({ at: next, acc: x.acc.insert(frame.slice(x.at, x.at + 32), s) }),
          Err(_) -> Continue({ at: next, acc: x.acc }),
        }
      }
    })

fn places_frame(saw: Map<Bytes, Seen>) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    saw.fold([], |acc: List<Bytes>, id: Bytes, s: Seen| {
      let body = bin::encode(s, seen_bin());
      acc.push(id).push(u32_le(body.len())).push(body)
    }),
  )

/// The places `seg` saw, laid over `acc`: `rows` is its table of them, one row naming one frame.
fn places_over<[r]>(
  dir: String,
  seg: Segment,
  rows: Bytes,
  acc: Map<Bytes, Seen>,
) -> Map<Bytes, Seen> / {fs.read[r], abort.raise} =
  if rows.len() < placed_width() { acc } else {
    match segments::payload[r](
        dir,
        seg.token,
        segments::long_at(rows, 32),
        segments::word_at(rows, 40),
      ) {
      Some(frame) -> places_in(acc, frame),
      None -> acc,
    }
  }

/// Each place the store last saw, the newest segment's word last: read once a run.
fn places_of<[r]>(
  dir: String,
  o: Open,
) -> { open: Open, places: Map<Bytes, Seen> } / {fs.read[r], abort.raise} =
  match o.places {
    Some(held) -> { open: o, places: held },
    None -> {
      let read = o.manifest.segments.fold(
        { open: o, places: Map::new() },
        |acc: { open: Open, places: Map<Bytes, Seen> }, seg: Segment| {
          let t = table[r](dir, acc.open, seg, places_table());
          { open: t.open, places: places_over[r](dir, seg, t.rows, acc.places) }
        },
      );
      let all = o.saw.fold(read.places, |acc: Map<Bytes, Seen>, id: Bytes, s: Seen|
        acc.insert(id, s));
      { open: { ..read.open, places: Some(all) }, places: all }
    },
  }

/// The bytes of the keys `bytes` lists, each once.
fn keys_in(bytes: Bytes) -> List<Bytes> =
  range(0, bytes.len() / 32).fold(Map::new(), |acc: Map<Bytes, Bool>, i: Int|
    acc.insert(bytes.slice(i * 32, i * 32 + 32), true)).keys(
  )

/// The keys of the records the store notes as readers of `id`, and those this run noted.
fn readers_of<[r]>(
  dir: String,
  o: Open,
  id: Bytes,
) -> { open: Open, keys: List<Bytes> } / {fs.read[r], abort.raise} = {
  let read = o.manifest.segments.fold(
    { open: o, keys: [] },
    |acc: { open: Open, keys: List<Bytes> }, seg: Segment| {
      let t = table[r](dir, acc.open, seg, readers_table());
      {
        open: t.open,
        keys: segments::rows_of(t.rows, reader_width(), id).fold(
          acc.keys,
          |ks: List<Bytes>, row: Bytes| ks.push(row.slice(32, 64)),
        ),
      }
    },
  );
  let noted = match o.readers.get(id) { Some(ks) -> ks, None -> [] };
  {
    open: read.open,
    keys: keys_in(Bytes::concat_all(noted.fold(read.keys, |ks: List<Bytes>, k: Bytes| ks.push(k)))),
  }
}

/// The keys a segment's table of marked keys names, and those this run changed the marks of.
fn marked_in<[r]>(
  dir: String,
  o: Open,
) -> { open: Open, keys: Map<Bytes, Bool> } / {fs.read[r], abort.raise} =
  o.manifest.segments.fold(
    {
      open: o,
      keys: o.marks.fold(Map::new(), |ks: Map<Bytes, Bool>, key: Bytes, _: List<Bytes>|
        ks.insert(key, true)),
    },
    |acc: { open: Open, keys: Map<Bytes, Bool> }, seg: Segment| {
      let t = table[r](dir, acc.open, seg, marked_table());
      {
        open: t.open,
        keys: range(0, t.rows.len() / 32).fold(acc.keys, |ks: Map<Bytes, Bool>, i: Int|
          ks.insert(t.rows.slice(i * 32, i * 32 + 32), true)),
      }
    },
  )

/// The record `bytes` hold at `height`, or nothing where they do not read as one: a key's height
/// is its rows', which outgrows the one its record was kept with.
fn record_of(bytes: Option<Bytes>, height: Int) -> Option<Record> / {abort.raise} =
  match bytes {
    None -> None,
    Some(b) -> match record_from(b) {
      Some(rec) -> Some({ ..rec, height: if height > rec.height { height } else { rec.height } }),
      None -> None,
    },
  }

// --- Ending a run ------------------------------------------------------------

/// What a segment says of a key, the row's query by its name in the store.
type Told = { row: Row, query: Bytes }

/// Each reader a run noted, as a row: what was read, then the key of who read it.
fn reader_set(noted: Map<Bytes, List<Bytes>>) -> Map<Bytes, Bool> =
  noted.fold(Map::new(), |acc: Map<Bytes, Bool>, id: Bytes, keys: List<Bytes>|
    keys.fold(acc, |m: Map<Bytes, Bool>, key: Bytes| m.insert(id.concat(key), true)))

/// `seen` with `query` seen at `at`, where that is later than it holds.
fn seen_at(seen: Map<Bytes, Int>, query: Bytes, at: Int) -> Map<Bytes, Int> =
  match seen.get(query) {
    Some(was) -> if was >= at { seen } else { seen.insert(query, at) },
    None -> seen.insert(query, at),
  }

/// The tables of a segment that says `told` of its keys: their rows, each naming its query by its
/// place among `seen`, which holds every one of them with when it was last seen; the keys it marks;
/// where the one frame of the places it saw lies and how long it is, where it saw any; the readers
/// it noted; and where each longer answer it holds lies and how long it is.
fn tables_of(
  told: Map<Bytes, Told>,
  seen: Map<Bytes, Int>,
  places: Option<Bytes>,
  readers: Map<Bytes, Bool>,
  answers: Map<Bytes, Bytes>,
) -> List<Table> / {abort.raise} = {
  let nth = seen.fold(Map::new(), |acc: Map<Bytes, Int>, query: Bytes, _: Int|
    acc.insert(query, acc.len()));
  [
    segments::table(records_table(), told, |_: Bytes, t: Told|
      Some(row_rest({ ..t.row, query: match nth.get(t.query) { Some(i) -> i, None -> 65535 } }))),
    segments::table(marked_table(), told, |_: Bytes, t: Told|
      if t.row.marked { Some(b"") } else { None }),
    segments::table(
      places_table(),
      match places { Some(at) -> Map::new().insert(b"\x00".repeat(32), at), None -> Map::new() },
      |_: Bytes, at: Bytes| Some(at),
    ),
    segments::table(readers_table(), readers, |_: Bytes, _: Bool| Some(b"")),
    segments::table(answers_table(), answers, |_: Bytes, at: Bytes| Some(at)),
    segments::table(queries_table(), seen, |_: Bytes, at: Int| Some(u64_le(at))),
  ]
}

/// Where a frame lies in its own segment and how long its payload is, as a row holds the two.
fn lying(offset: Int, size: Int) -> Bytes = u64_le(offset).concat(u32_le(size))

/// Whether the run kept nothing a later run would read.
fn kept_nothing(o: Open) -> Bool = o.mine.len() == 0 && o.saw.len() == 0 && o.readers.len() == 0

/// What `o`, a run's hold of the store in `dir`, kept, written as the run's segment and named by
/// the store's manifest: the places it saw as one frame, then its tables. A run that kept nothing
/// writes nothing, and one the file system refused leaves the store as it found it. A run that
/// named a segment leaves the store small and swept.
fn committed<[r]>(
  dir: String,
  run: String,
  token: Bytes,
  o: Open,
) -> Unit / {fs.read[r], fs.write[r], abort.raise} =
  if kept_nothing(o) { () } else {
    let frame = places_frame(o.saw);
    let places = if o.saw.len() == 0 { { writing: o.out, at: 0 } }
    else { segments::framing(o.out, frame) };
    let told = o.mine.fold(Map::new(), |acc: Map<Bytes, Told>, key: Bytes, x: Mine| {
      let lies = match x.frame { Some(f) -> f, None -> { offset: 0, size: 0 } };
      acc.insert(key, {
        row: {
          marked: match o.marks.get(key) { Some(ms) -> ms.len() > 0, None -> false },
          brought: x.frame != None,
          breaks: x.frame != None,
          query: 0,
          height: x.height,
          vouchers: if x.vouch { 1 } else { 0 },
          offset: lies.offset,
          size: lies.size,
          answer: x.answer,
        },
        query: x.query,
      })
    });
    let seen = o.mine.fold(
      o.own.fold(Map::new(), |seen: Map<Bytes, Int>, query: Bytes, _: Bool|
        seen.insert(query, o.now)),
      |seen: Map<Bytes, Int>, _: Bytes, x: Mine| seen_at(seen, x.query, x.seen),
    );
    let tables = tables_of(
      told,
      seen,
      if o.saw.len() == 0 { None } else { Some(lying(places.at, frame.len())) },
      reader_set(o.readers),
      o.answers,
    );
    match segments::finished[r](dir, shapes(), token, places.writing, tables, [o.stamp]) {
      None -> (),
      Some(seg) -> match segments::committed[r](
          dir,
          shapes(),
          o.manifest.generation,
          seg,
          without: o.lost,
        ) {
        Named(m) -> {
          let from = segments::merging(m);
          if from < m.segments.len() - 1 {
            // What the run kept stays whatever it weighs, and counts toward the room others may take.
            let own = o.mine.fold(o.own, |acc: Map<Bytes, Bool>, _: Bytes, x: Mine|
              acc.insert(x.query, true));
            merged[r](dir, m, from, segments::token_of(Some(run), m.generation, 1), Near(own));
            ()
          };
          segments::swept[r](dir, shapes(), run, retired())
        },
        _ -> (),
      },
    }
  }

// --- Writing segments again as one -------------------------------------------

/// What a merge dropped: records, and the longer answers no record it kept names, with their bytes.
pub type Compacted = { records: Int, answers: Int, bytes: Int }

/// A segment being merged, with its rows of records, of queries, of longer answers and of readers.
type Merging = { seg: Segment, records: Bytes, queries: Bytes, answers: Bytes, readers: Bytes }

/// What a merge carries of a key: its row as the merged segment will hold it, its query, and where
/// its record lies in a segment being merged, where one of them brought it.
type Carried = { row: Row, query: Bytes, from: Option<Found> }

/// A frame a merge carries over: where it lies, how long it is with its head, and what it is found
/// by afterwards, a key's record or an answer by its name.
type Frame = { at: Found, name: Bytes, answer: Bool }

/// Frames being carried over in the order they lie: the merged segment as far as it is written;
/// the frames that follow one another in one segment and are read as one, with where the first
/// lies and where the last ends; and where each frame carried so far lies now, a record's by its
/// key and an answer's by its name.
type Carrying = {
  out: Writing,
  token: Bytes,
  start: Int,
  end: Int,
  waiting: List<{ frame: Frame, at: Int }>,
  records: Map<Bytes, Int>,
  answers: Map<Bytes, Bytes>,
}

/// `c` with the frames it waits on read as one and carried into the merged segment `token` names:
/// frames that cannot be read are carried nowhere.
fn carried_over<[r]>(
  dir: String,
  token: Bytes,
  c: Carrying,
) -> Carrying / {fs.read[r], fs.write[r], abort.raise} =
  if c.waiting.len() == 0 { c } else {
    let rest = { ..c, waiting: [], start: 0, end: 0 };
    match segments::range_of[r](segments::segment_path(dir, c.token), c.start, c.end - c.start) {
      None -> rest,
      Some(bytes) -> {
        let put = segments::carrying(c.out, bytes);
        c.waiting.fold(
          { ..rest, out: segments::appended_when_full[r](dir, shapes(), token, put.writing) },
          |acc: Carrying, w: { frame: Frame, at: Int }|
            if w.frame.answer {
              {
                ..acc,
                answers: acc.answers.insert(
                  w.frame.name,
                  lying(put.at + w.at - c.start, w.frame.at.size),
                ),
              }
            } else {
              { ..acc, records: acc.records.insert(w.frame.name, put.at + w.at - c.start) }
            },
        )
      },
    }
  }

/// The most frames read as one take, in bytes.
fn carry_bound() -> Int = 16777216

/// Which queries' records a rewrite of a whole store keeps, each query by its name in the store:
/// those of `Only` and no other; or those of `Near`, the queries of the run that writes and of each
/// record it kept, and of the others the most lately answered under, while their records and the
/// longer answers those name hold no more than the run's own hold.
type Keeping = | Only(Map<Bytes, Bool>) | Near(Map<Bytes, Bool>)

/// A query other than the writing run's, what its records hold and when it was last answered under.
type Other = { query: Bytes, bytes: Int, seen: Int }

/// The tables a merge reads of each of `merging`: none where a table of one does not read.
fn read_all<[r]>(
  dir: String,
  merging: List<Segment>,
) -> Option<List<Merging>> / {fs.read[r], abort.raise} =
  merging.fold(Some([]), |acc: Option<List<Merging>>, seg: Segment|
    match acc {
      None -> None,
      Some(done) -> match ((
          segments::rows[r](dir, seg, records_table()),
          segments::rows[r](dir, seg, queries_table()),
          segments::rows[r](dir, seg, answers_table()),
          segments::rows[r](dir, seg, readers_table()),
        )) {
        (Some(records), Some(queries), Some(answers), Some(readers)) ->
          Some(
            done.push({
              seg: seg,
              records: records,
              queries: queries,
              answers: answers,
              readers: readers,
            }),
          ),
        _ -> None,
      },
    })

/// What a merge of `all`, segments of `m` oldest first, carries of each key they hold a row of: its
/// newest row, saying of the record what its rows said together, each stamp named by its place
/// among `stamps`; its query; and where its record lies in the newest of them that brought it one.
fn carried_of(
  m: Manifest,
  all: List<Merging>,
  stamps: List<Bytes>,
) -> Map<Bytes, Carried> / {abort.raise} =
  all.fold(Map::new(), |acc: Map<Bytes, Carried>, x: Merging| {
    // Where each of the segment's stamps lies among the merged segment's.
    let moves = x.seg.stamps.map(|s: Bytes|
      if segments::below_floor(m, x.seg) { 0 - 1 } else {
        range(0, stamps.len()).fold(0 - 1, |found: Int, j: Int|
          if stamps.at(j) == Some(s) { j } else { found })
      });
    range(0, x.records.len() / record_width()).fold(acc, |into: Map<Bytes, Carried>, i: Int| {
      let b = x.records.slice(i * record_width(), (i + 1) * record_width());
      let key = b.slice(0, 32);
      let row = row_from(b);
      let vouchers = range(0, moves.len()).fold(0, |v: Int, j: Int|
        match moves.at(j) {
          Some(to) -> if to >= 0 && row.vouchers >> j & 1 == 1 { v | 1 << to } else { v },
          None -> v,
        });
      let here = if row.brought { Some({ token: x.seg.token, offset: row.offset, size: row.size }) }
      else { None };
      let query = query_in(x.queries, row.query).query;
      into.insert(key, match into.get(key) {
        None -> { row: { ..row, vouchers: vouchers }, query: query, from: here },
        Some(c) -> {
          // A row that marks, or brought a record, breaks with the older ones; so does one
          // that checked a marked record. One that checked a record that stands adds its
          // stamps to those that vouch for it.
          let breaks = row.marked || row.breaks || c.row.marked;
          {
            row: {
              ..row,
              breaks: breaks || c.row.breaks,
              vouchers: if breaks { vouchers } else { c.row.vouchers | vouchers },
              height: if c.row.height > row.height { c.row.height } else { row.height },
            },
            query: query,
            from: match here {
              Some(_) -> here,
              None -> if c.row.answer == row.answer { c.from } else { None },
            },
          }
        },
      })
    })
  })

/// The queries whose records a rewrite of a whole store keeps, as `keeping` says: `carried` is what
/// the store holds of each key, `all` its segments and `seen` when each query was last answered
/// under. A merge of less than the whole store drops nothing, and asks for none.
fn living(
  keeping: Keeping,
  whole: Bool,
  all: List<Merging>,
  carried: Map<Bytes, Carried>,
  seen: Map<Bytes, Int>,
) -> Map<Bytes, Bool> / {abort.raise} =
  match keeping {
    Only(queries) -> queries,
    Near(own) -> if !whole { own } else {
      let lengths = all.fold(Map::new(), |acc: Map<Bytes, Int>, x: Merging|
        range(0, x.answers.len() / placed_width()).fold(acc, |into: Map<Bytes, Int>, i: Int|
          into.insert(
            x.answers.slice(i * placed_width(), i * placed_width() + 32),
            segments::word_at(x.answers, i * placed_width() + 40),
          )));
      let held = carried.fold(Map::new(), |acc: Map<Bytes, Int>, _: Bytes, c: Carried|
        match c.from {
          None -> acc,
          Some(f) ->
            acc.insert(
              c.query,
              f.size + (match lengths.get(c.row.answer) { Some(n) -> n, None -> 0 })
                + (match acc.get(c.query) { Some(n) -> n, None -> 0 }),
            ),
        });
      let mine = held.fold(0, |n: Int, query: Bytes, bytes: Int|
        if own.contains(query) { n + bytes } else { n });
      let others = held.fold([], |acc: List<Other>, query: Bytes, bytes: Int|
        if own.contains(query) { acc } else {
          acc.push({
            query: query,
            bytes: bytes,
            seen: match seen.get(query) { Some(at) -> at, None -> 0 },
          })
        }).sort_by(|a: Other, b: Other| a.seen > b.seen);
      others.fold(
        { live: own, room: mine },
        |acc: { live: Map<Bytes, Bool>, room: Int }, x: Other|
          if x.bytes <= acc.room {
            { live: acc.live.insert(x.query, true), room: acc.room - x.bytes }
          } else { { ..acc, room: 0 } },
      ).live
    },
  }

/// The segments of `m` from the one at `from` on written again as one, which the manifest then
/// names in their place: of each key its newest row, saying of the record what its rows said
/// together, so each stamp takes it or checks it as before; the records and longer answers those
/// rows name, where the merged segments hold them; the places and readers they noted. Where that is
/// every segment, a record goes with every row of it where `keeping` does not keep its query; with
/// it go the answers only such records named, and each reader that is no record any more. What it
/// dropped: nothing where a table of a segment does not read, which the next run to name a segment
/// finds, or where a run named a segment while it worked.
fn merged<[r]>(
  dir: String,
  m: Manifest,
  from: Int,
  token: Bytes,
  keeping: Keeping,
) -> Option<Compacted> / {fs.read[r], fs.write[r], abort.raise} = {
  let whole = from == 0;
  let merging = m.segments.drop(from);
  match read_all[r](dir, merging) {
    None -> None,
    Some(all) -> {
      // The newest segment's stamps first: past thirty-two, the oldest vouch no more.
      let stamps = merging.reverse().fold([], |acc: List<Bytes>, seg: Segment|
        if segments::below_floor(m, seg) { acc } else {
          seg.stamps.fold(acc, |a: List<Bytes>, s: Bytes|
            if a.contains(s) || a.len() >= 32 { a } else { a.push(s) })
        });
      let seen = all.fold(Map::new(), |acc: Map<Bytes, Int>, x: Merging|
        range(0, x.queries.len() / query_width()).fold(acc, |into: Map<Bytes, Int>, i: Int| {
          let q = query_in(x.queries, i);
          seen_at(into, q.query, q.seen)
        }));
      let carried = carried_of(m, all, stamps);
      let live = living(keeping, whole, all, carried, seen);
      let kept = carried.fold(
        { keys: Map::new(), dropped: 0 },
        |acc: { keys: Map<Bytes, Carried>, dropped: Int }, key: Bytes, c: Carried|
          if !whole { { ..acc, keys: acc.keys.insert(key, c) } }
          else if c.from == None { acc }
          else if !live.contains(c.query) { { ..acc, dropped: acc.dropped + 1 } }
          else { { ..acc, keys: acc.keys.insert(key, c) } },
      );
      let wanted = kept.keys.fold(Map::new(), |acc: Map<Bytes, Bool>, _: Bytes, c: Carried|
        acc.insert(c.row.answer, true));
      // Each frame to carry, by the segment it lies in and where, so that they are read in order.
      let places = range(0, merging.len()).fold(Map::new(), |acc: Map<Bytes, Int>, i: Int|
        acc.insert(merging.get(i).token, i));
      let order = |f: Found|
        match places.get(f.token) { Some(i) -> i * 1099511627776 + f.offset, None -> 0 - 1 };
      let records = kept.keys.fold(Map::new(), |acc: Map<Int, Frame>, key: Bytes, c: Carried|
        match c.from {
          Some(f) -> acc.insert(order(f), { at: f, name: key, answer: false }),
          None -> acc,
        });
      // Of a longer answer the newest segment's frame is carried, where a record kept names it.
      let answered = all.reverse().fold(
        { frames: records, met: Map::new(), dropped: 0, bytes: 0 },
        |acc: { frames: Map<Int, Frame>, met: Map<Bytes, Bool>, dropped: Int, bytes: Int }, x: Merging|
          range(0, x.answers.len() / placed_width()).fold(
            acc,
            |a: { frames: Map<Int, Frame>, met: Map<Bytes, Bool>, dropped: Int, bytes: Int }, i: Int| {
              let b = x.answers.slice(i * placed_width(), (i + 1) * placed_width());
              let name = b.slice(0, 32);
              let size = segments::word_at(b, 40);
              if a.met.contains(name) { a } else if !wanted.contains(name) {
                {
                  ..a,
                  met: a.met.insert(name, true),
                  dropped: a.dropped + 1,
                  bytes: a.bytes + size,
                }
              } else {
                let f = { token: x.seg.token, offset: segments::long_at(b, 32), size: size };
                {
                  ..a,
                  met: a.met.insert(name, true),
                  frames: a.frames.insert(order(f), { at: f, name: name, answer: true }),
                }
              }
            },
          ),
      );
      let copied = carried_over[r](
        dir,
        token,
        answered.frames.fold(
          {
            out: segments::unwritten(),
            token: b"",
            start: 0,
            end: 0,
            waiting: [],
            records: Map::new(),
            answers: Map::new(),
          },
          |c: Carrying, _: Int, f: Frame| {
            let size = segments::framed_len(f.at.size);
            let next = if c.waiting.len() > 0
                && (f.at.token != c.token || f.at.offset != c.end
                || c.end - c.start > carry_bound()) { carried_over[r](dir, token, c) }
            else { c };
            if next.waiting.len() == 0 {
              {
                ..next,
                token: f.at.token,
                start: f.at.offset,
                end: f.at.offset + size,
                waiting: [{ frame: f, at: f.at.offset }],
              }
            } else {
              {
                ..next,
                end: next.end + size,
                waiting: next.waiting.push({ frame: f, at: f.at.offset }),
              }
            }
          },
        ),
      );
      let seen_kept = kept.keys.fold(
        if whole { Map::new() } else { seen },
        |acc: Map<Bytes, Int>, _: Bytes, c: Carried|
          acc.insert(c.query, match seen.get(c.query) { Some(at) -> at, None -> 0 }),
      );
      let told = kept.keys.fold(Map::new(), |acc: Map<Bytes, Told>, key: Bytes, c: Carried| {
        let lies = match c.from {
          Some(f) -> match copied.records.get(key) {
            Some(at) -> Some({ offset: at, size: f.size }),
            None -> None,
          },
          None -> None,
        };
        acc.insert(key, {
          row: {
            ..c.row,
            brought: lies != None,
            offset: match lies { Some(l) -> l.offset, None -> 0 },
            size: match lies { Some(l) -> l.size, None -> 0 },
          },
          query: c.query,
        })
      });
      let saw = merging.fold(Map::new(), |acc: Map<Bytes, Seen>, seg: Segment|
        match segments::rows[r](dir, seg, places_table()) {
          Some(rows) -> places_over[r](dir, seg, rows, acc),
          None -> acc,
        });
      let frame = places_frame(saw);
      let places_at = if saw.len() == 0 { { writing: copied.out, at: 0 } }
      else { segments::framing(copied.out, frame) };
      let readers = all.fold(Map::new(), |acc: Map<Bytes, Bool>, x: Merging|
        range(0, x.readers.len() / reader_width()).fold(acc, |into: Map<Bytes, Bool>, i: Int| {
          let row = x.readers.slice(i * reader_width(), (i + 1) * reader_width());
          if whole && !kept.keys.contains(row.slice(32, 64)) { into }
          else { into.insert(row, true) }
        }));
      let tables = tables_of(
        told,
        seen_kept,
        if saw.len() == 0 { None } else { Some(lying(places_at.at, frame.len())) },
        readers,
        copied.answers,
      );
      match segments::finished[r](dir, shapes(), token, places_at.writing, tables, stamps) {
        None -> None,
        Some(seg) -> match segments::swapped[r](dir, shapes(), m, from, seg) {
          Named(_) ->
            Some({ records: kept.dropped, answers: answered.dropped, bytes: answered.bytes }),
          _ -> {
            fs.remove[r](segments::segment_path(dir, token));
            None
          },
        },
      }
    },
  }
}

// --- A run over the store -----------------------------------------------------

/// `work` run over the memo store in `dir`, with `look` answering what the world holds now: what it
/// keeps is named by the store when the run ends. Where `dir` holds no record under a key, the pack
/// below it is asked, through `read`, which answers what a frame of the pack's file holds. `world`
/// lists the shipped files the run reads: the pack's records stand as they are where they were made
/// under the run's stamp over those very files, and are held to their reads otherwise; none is
/// copied into `dir`. The stamp the run names the pack and those files too, so a record kept over
/// another pack or other files is checked before it is taken (`packs`). `covers` says which noted
/// places the run's world looks at: the rest are not brought to what it holds, so a run that sees
/// less of the world spoils nothing of what a run that sees more noted. `commands` are the hashes
/// the answers of the running `ply`'s own commands are kept under ([`memo::recorded`]), which a run
/// that writes the store again keeps as it keeps the records of its own queries.
pub fn kept<a, [r] | e>(
  dir: String,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_keep.read, memo_keep.write, abort.raise},
  covers: (Bytes, Bytes) -> Bool = |_: Bytes, _: Bytes| true,
  commands: List<Bytes> = [],
) -> a / {fs.read[r], fs.write[r], abort.raise | e} = {
  let run = segments::entered[r](dir);
  let manifest = segments::manifest[r](dir, shapes());
  let token = segments::token_of(run, manifest.generation, 0);
  let found = {
    ..opened(manifest, segments::began[r](run)),
    out: if run == None { segments::refused() } else { segments::unwritten() },
    pack: packs::opened(read),
  };
  // Each step of the run over the store takes what it holds open and answers it with what it read.
  // A record's bytes noted for the answer they hold, which the run asks for next.
  let noted = |o: Open, found: Option<Bytes>|
    match found {
      Some(b) -> match ((output_named(b), inline_named(b))) {
        (Some(d), Some(a)) -> { ..o, inlined: o.inlined.insert(d, a) },
        _ -> o,
      },
      None -> o,
    };
  // The bytes of the record the pack below holds under `key`, read once a run.
  let packed_at = |o: Open, key: Bytes|
    match o.packed.get(key) {
      Some(b) -> { open: o, bytes: b },
      None -> {
        let found = packs::record(o.pack, read, key);
        let now = { ..o, pack: found.reading, packed: o.packed.insert(key, found.bytes) };
        { open: noted(now, found.bytes), bytes: found.bytes }
      },
    };
  // The longer answer the pack below holds under `digest`, beside `o` with what was read to find it.
  let packed_answer = |o: Open, digest: Bytes| {
    let found = packs::answer(o.pack, read, digest);
    { open: { ..o, pack: found.reading }, answer: found.bytes }
  };
  let stored = |o: Open, key: Bytes| known_of[r](dir, o, key);
  // The answer and the height of the record kept under `key`: the run's word, else the store's.
  let held = |o: Open, key: Bytes|
    match o.mine.get(key) {
      Some(x) -> { open: o, held: Some({ answer: x.answer, height: x.height }) },
      None -> {
        let k = stored(o, key);
        {
          open: k.open,
          held: match k.known {
            Some(kn) -> Some({ answer: kn.row.answer, height: kn.row.height }),
            None -> None,
          },
        }
      },
    };
  // The marks on `key` as the run leaves them: those it changed, else the store's, all one mark.
  let marks = |o: Open, key: Bytes|
    match o.marks.get(key) {
      Some(ms) -> { open: o, marks: ms },
      None -> {
        let k = stored(o, key);
        {
          open: k.open,
          marks: match k.known {
            Some(kn) -> if kn.row.marked { [b"kept"] } else { [] },
            None -> [],
          },
        }
      },
    };
  let marked_as = |o: Open, key: Bytes, ms: List<Bytes>| { ..o, marks: o.marks.insert(key, ms) };
  // What the run says of `key` from here on: `change` of what it said, or of what the store says.
  // Nothing where no record is kept under the key.
  let saying = |o0: Open, key: Bytes, change: (Mine) -> Mine| {
    let m = marks(o0, key);
    let o = marked_as(m.open, key, m.marks);
    match o.mine.get(key) {
      Some(x) -> { ..o, mine: o.mine.insert(key, change(x)) },
      None -> {
        let k = stored(o, key);
        match k.known {
          Some(kn) ->
            {
              ..k.open,
              mine: k.open.mine.insert(
                key,
                change({
                  answer: kn.row.answer,
                  query: kn.query,
                  seen: kn.seen,
                  height: kn.row.height,
                  frame: None,
                  vouch: false,
                }),
              ),
            },
          None -> k.open,
        }
      },
    }
  };
  let looked = |o: Open, kind: Bytes, place: Bytes| {
    let id = memo::place_id(kind, place);
    match o.looked.get(id) {
      Some(x) -> { open: o, looked: x },
      None -> {
        let value = look(kind, place);
        let x = { value: value, digest: digest_of(value) };
        { open: { ..o, looked: o.looked.insert(id, x) }, looked: x }
      },
    }
  };
  // The bytes of the record kept under `key`, read once a run.
  let own = |o0: Open, key: Bytes| {
    let h0 = held(o0, key);
    match h0.held {
      None -> { open: h0.open, bytes: None },
      Some(h) -> {
        let o = h0.open;
        let lies = match match o.mine.get(key) { Some(x) -> x.frame, None -> None } {
          Some(f) -> { open: o, at: Some({ token: token, offset: f.offset, size: f.size }) },
          None -> frame_row[r](dir, o, key, h.answer),
        };
        match lies.at {
          None -> { open: lies.open, bytes: None },
          Some(at) -> {
            let name = at.token.concat(u64_le(at.offset));
            match lies.open.read.get(name) {
              Some(b) -> { open: lies.open, bytes: Some(b) },
              None -> {
                let framed = frame_of[r](dir, token, lies.open, at);
                let now = noted(lies.open, framed);
                match framed {
                  Some(b) -> { open: { ..now, read: now.read.insert(name, b) }, bytes: Some(b) },
                  None -> { open: now, bytes: None },
                }
              },
            }
          },
        }
      },
    }
  };
  // The answer under `digest` where a record holds it: one a row named is read for it.
  let inside = |o: Open, digest: Bytes|
    match o.inlined.get(digest) {
      Some(a) -> { open: o, answer: Some(a) },
      None -> match o.named.get(digest) {
        Some(key) -> {
          let got = own(o, key);
          { open: got.open, answer: got.open.inlined.get(digest) }
        },
        None -> { open: o, answer: None },
      },
    };
  let keeping = |o0: Open, key: Bytes, rec: Record, inline: Option<Bytes>, longer: Option<Bytes>|
    match packs::answer_key(rec.output) {
      None -> o0,
      Some(name) -> {
        // A row is a key and what follows it: a key of another length would misplace every row.
        if key.len() != key_width() { panic("a memo key is thirty-two bytes") };
        // A fresh record answers for what the store only left unchecked: its marks stay.
        let m = marks(o0, key);
        let h = held(marked_as(m.open, key, m.marks), key);
        let was = match h.held { Some(x) -> x.height, None -> 0 };
        let bytes = record_bytes(rec, inline);
        let o = h.open;
        let f = segments::framing(o.out, bytes);
        let o1 = { ..o, out: f.writing };
        let o2 = match inline {
          Some(a) -> { ..o1, inlined: o1.inlined.insert(rec.output, a) },
          None -> o1,
        };
        let o3 = match longer {
          None -> o2,
          Some(body) -> if o2.answers.contains(name) { o2 } else {
            // An answer a segment names and does not hold is kept again.
            let there = if o2.unread.contains(name) { { open: o2, at: None } }
            else { answer_row[r](dir, o2, name) };
            match there.at {
              Some(_) -> holding(there.open, name, body),
              None -> {
                let g = segments::framing(there.open.out, body);
                {
                  ..holding(there.open, name, body),
                  out: g.writing,
                  answers: there.open.answers.insert(name, lying(g.at, body.len())),
                }
              },
            }
          },
        };
        {
          ..o3,
          out: segments::appended_when_full[r](dir, shapes(), token, o3.out),
          mine: o3.mine.insert(key, {
            answer: name,
            query: rec.query.blake3(),
            seen: o3.now,
            height: if was > rec.height { was } else { rec.height },
            frame: Some({ offset: f.at, size: bytes.len() }),
            vouch: true,
          }),
        }
      },
    };
  let value = handle {
    work()
  } with {
    var st = found,
    memo_keep.head(key) -> {
      let h = held(st, key);
      st = h.open;
      match h.held {
        Some(x) -> {
          let digest = answer_digest(x.answer);
          st = { ..st, named: st.named.insert(digest, key) };
          Some(digest)
        },
        None -> {
          let p = packed_at(st, key);
          st = p.open;
          match p.bytes { Some(b) -> output_named(b), None -> None }
        },
      }
    },
    memo_keep.height(key) -> {
      let h = held(st, key);
      st = h.open;
      match h.held {
        Some(x) -> x.height,
        None -> {
          let p = packed_at(st, key);
          st = p.open;
          match p.bytes { Some(b) -> height_named(b), None -> 0 }
        },
      }
    },
    memo_keep.record(key) -> {
      let mine = own(st, key);
      let h = held(mine.open, key);
      st = h.open;
      match mine.bytes {
        Some(b) -> record_of(Some(b), match h.held { Some(x) -> x.height, None -> 0 }),
        // The pack's record only where the store keeps none of its own under the key.
        None -> match h.held {
          Some(_) -> None,
          None -> {
            let p = packed_at(st, key);
            st = p.open;
            record_of(p.bytes, 0)
          },
        },
      }
    },
    memo_keep.stored(key) -> {
      let h = held(st, key);
      st = h.open;
      match h.held { Some(_) -> true, None -> false }
    },
    memo_keep.output(digest) -> {
      let i = inside(st, digest);
      st = i.open;
      match i.answer {
        Some(a) -> Some(a),
        None -> match st.transient.get(digest) {
          Some(a) -> Some(a),
          None -> match packs::answer_key(digest) {
            None -> None,
            Some(name) -> match st.held.get(name) {
              Some(a) -> Some(a),
              None -> {
                let o = st;
                let lies = match o.answers.get(name) {
                  Some(b) ->
                    {
                      open: o,
                      at: Some({
                        token: token,
                        offset: segments::long_at(b, 0),
                        size: segments::word_at(b, 8),
                      }),
                    },
                  None -> if o.unread.contains(name) { { open: o, at: None } }
                  else { answer_row[r](dir, o, name) },
                };
                let found = match lies.at {
                  Some(at) -> match frame_of[r](dir, token, lies.open, at) {
                    Some(a) -> { open: lies.open, answer: Some(a) },
                    None ->
                      packed_answer(
                        { ..lies.open, unread: lies.open.unread.insert(name, true) },
                        digest,
                      ),
                  },
                  None -> packed_answer(lies.open, digest),
                };
                st = match found.answer {
                  Some(a) -> holding(found.open, name, a),
                  None -> found.open,
                };
                found.answer
              },
            },
          },
        },
      }
    },
    memo_keep.keep(key, rec, output, lasting) -> {
      st = match kept_inline(output) {
        Some(a) -> keeping(st, key, rec, Some(a), None),
        None -> if lasting { keeping(st, key, rec, None, Some(output)) } else {
          let o = keeping(st, key, rec, None, None);
          { ..o, transient: o.transient.insert(rec.output, output) }
        },
      };
    },
    // An answer its record holds is held by the record kept again.
    memo_keep.adopt(key, rec) -> {
      st = keeping(st, key, rec, st.inlined.get(rec.output), None);
    },
    memo_keep.raise(key, height) -> {
      st = saying(st, key, |x: Mine| if height > x.height { { ..x, height: height } } else { x });
    },
    memo_keep.now(kind, place) -> {
      let l = looked(st, kind, place);
      st = l.open;
      l.looked.value
    },
    memo_keep.digest(kind, place) -> {
      let l = looked(st, kind, place);
      st = l.open;
      l.looked.digest
    },
    memo_keep.places() -> {
      let p = places_of[r](dir, st);
      st = p.open;
      p.places.fold([], |acc: List<Seen>, _: Bytes, s: Seen|
        if covers(s.kind, s.at) { acc.push(s) } else { acc })
    },
    memo_keep.seen(id) -> {
      let p = places_of[r](dir, st);
      st = p.open;
      p.places.get(id)
    },
    memo_keep.see(id, s) -> {
      let p = places_of[r](dir, st);
      st = { ..p.open, places: Some(p.places.insert(id, s)), saw: p.open.saw.insert(id, s) };
    },
    memo_keep.readers(id) -> {
      let found = readers_of[r](dir, st, id);
      st = found.open;
      found.keys
    },
    memo_keep.link(id, key) -> {
      st = {
        ..st,
        readers: st.readers.insert(
          id,
          List::push(match st.readers.get(id) { Some(ks) -> ks, None -> [] }, key),
        ),
      };
    },
    memo_keep.marks(key) -> {
      let m = marks(st, key);
      st = m.open;
      if m.marks.len() > 0 { m.marks } else {
        let vouched = match st.mine.get(key) { Some(x) -> x.vouch, None -> false };
        let unchecked = if vouched { false } else {
          let k = stored(st, key);
          st = k.open;
          match k.known {
            Some(kn) -> !kn.trusted || st.lost.len() > 0,
            // A record of the pack below stands as it is only where the pack does, or where
            // this run checked it: it notes no reads, so no later run is told that one moved.
            None -> if st.trusted || st.checked.contains(key) { false } else {
              let p = packed_at(st, key);
              st = p.open;
              p.bytes != None
            },
          }
        };
        if unchecked { [memo::unchecked()] } else { [] }
      }
    },
    memo_keep.marked() -> {
      let named = marked_in[r](dir, st);
      let walked = named.keys.fold(
        { open: named.open, keys: [] },
        |acc: { open: Open, keys: List<Bytes> }, key: Bytes, _: Bool| {
          let query = match acc.open.mine.get(key) {
            Some(x) -> { open: acc.open, query: Some(x.query) },
            None -> {
              let k = stored(acc.open, key);
              { open: k.open, query: match k.known { Some(kn) -> Some(kn.query), None -> None } }
            },
          };
          match query.query {
            Some(q) -> if query.open.own.contains(q) {
              let m = marks(query.open, key);
              { open: m.open, keys: if m.marks.len() > 0 { acc.keys.push(key) } else { acc.keys } }
            } else { { open: query.open, keys: acc.keys } },
            None -> { open: query.open, keys: acc.keys },
          }
        },
      );
      st = walked.open;
      walked.keys
    },
    memo_keep.mark(key) -> {
      let m = marks(st, key);
      let o = m.open;
      st = saying(
        {
          ..o,
          marks: o.marks.insert(key, m.marks.push(Bytes::of_string(o.minted.to_string()))),
          minted: o.minted + 1,
        },
        key,
        |x: Mine| x,
      );
    },
    memo_keep.unmark(key, gone) -> {
      let m = marks(st, key);
      let h = held(marked_as(m.open, key, m.marks.filter(|mk: Bytes| !gone.contains(mk))), key);
      st = match h.held {
        Some(_) -> saying(h.open, key, |x: Mine| { ..x, vouch: true }),
        None -> { ..h.open, checked: h.open.checked.insert(key, true) },
      };
    },
    memo_keep.stamped(named, queries) -> {
      let stamp = stamp_of(named);
      st = {
        ..st,
        known: Map::new(),
        own: queries.concat(commands).fold(Map::new(), |own: Map<Bytes, Bool>, q: Bytes|
          own.insert(q.blake3(), true)),
        stamp: packs::above(st.pack.index, stamp, world),
        trusted: match st.pack.index { Some(i) -> packs::stands(i, stamp, world), None -> false },
      };
    },
    memo_keep.vouches() ->
      st.manifest.segments.fold(false, |any: Bool, seg: Segment|
        any || (!segments::below_floor(st.manifest, seg) && seg.stamps.contains(st.stamp))),
    return value -> {
      match run { Some(path) -> committed[r](dir, path, token, st), None -> () };
      value
    },
  };
  segments::left[r](run);
  value
}

// --- Reading a store apart from a run -----------------------------------------

/// The bytes of the record the store `o` holds of keeps under `key`, at the key's height.
fn kept_at<[r]>(
  dir: String,
  o: Open,
  key: Bytes,
) -> { open: Open, bytes: Option<Bytes> } / {fs.read[r], abort.raise} = {
  let k = known_of[r](dir, o, key);
  match k.known {
    None -> { open: k.open, bytes: None },
    Some(known) -> {
      let lies = frame_row[r](dir, k.open, key, known.row.answer);
      {
        open: lies.open,
        bytes: match lies.at {
          Some(at) -> match segments::payload[r](dir, at.token, at.offset, at.size) {
            Some(b) -> Some(at_height(b, known.row.height)),
            None -> None,
          },
          None -> None,
        },
      }
    },
  }
}

/// The record the store in `dir` holds under `key`.
pub fn record_at<[r]>(dir: String, key: Bytes) -> Option<Record> / {fs.read[r], abort.raise} =
  record_of(kept_at[r](dir, opened(segments::manifest[r](dir, shapes()), 0), key).bytes, 0)

/// What a pack being written from a store holds so far: the store as read, the frames written, where
/// each record's and each longer answer's frame lies, and each record's answer.
type Packing = {
  open: Open,
  writing: packs::Writing,
  records: Map<Bytes, packs::Range>,
  answers: Map<Bytes, packs::Range>,
  answered: Map<Bytes, Bytes>,
}

/// The pack of the records under each of `keys` in the store `from` and the longer answers they
/// name, as `packs` lays one out: each frame compressed by `compress`, made under `stamp` over the
/// shipped files `files` lists. A record whose answer the store no longer holds is left out. How
/// many records it holds.
pub fn packed<[r]>(
  from: String,
  keys: List<Bytes>,
  compress: (Bytes) -> Bytes,
  stamp: Bytes,
  files: Bytes,
) -> { written: packs::Written, records: Int } / {fs.read[r], abort.raise} = {
  let laid = keys.fold(
    {
      open: opened(segments::manifest[r](from, shapes()), 0),
      writing: packs::writing(),
      records: Map::new(),
      answers: Map::new(),
      answered: Map::new(),
    },
    |acc: Packing, key: Bytes| {
      let k = kept_at[r](from, acc.open, key);
      let named = match k.bytes {
        Some(b) -> match output_named(b) { Some(d) -> Some({ bytes: b, digest: d }), None -> None },
        None -> None,
      };
      match named {
        None -> { ..acc, open: k.open },
        Some(rec) -> {
          // The longer answer the record names, where it keeps none inside: framed once.
          let longer = if inline_named(rec.bytes) != None { Some({ ..acc, open: k.open }) } else {
            match packs::answer_key(rec.digest) {
              None -> None,
              Some(name) -> if acc.answers.contains(name) { Some({ ..acc, open: k.open }) } else {
                let lies = answer_row[r](from, k.open, name);
                let body = match lies.at {
                  Some(at) -> segments::payload[r](from, at.token, at.offset, at.size),
                  None -> None,
                };
                match body {
                  None -> None,
                  Some(a) -> {
                    let f = packs::framing(acc.writing, a, compress);
                    Some({
                      ..acc,
                      open: lies.open,
                      writing: f.writing,
                      answers: acc.answers.insert(name, f.at),
                    })
                  },
                }
              },
            }
          };
          match longer {
            None -> { ..acc, open: k.open },
            Some(had) -> {
              let f = packs::framing(had.writing, rec.bytes, compress);
              {
                ..had,
                writing: f.writing,
                records: had.records.insert(key, f.at),
                answered: had.answered.insert(key, rec.digest),
              }
            },
          }
        },
      }
    },
  );
  {
    written: packs::finished(
      laid.writing,
      laid.records,
      laid.answers,
      laid.answered,
      compress,
      stamp,
      files,
    ),
    records: laid.records.len(),
  }
}

/// What the store in `dir` holds: its records, the longer answers it keeps and their bytes, the
/// bytes of those no record names, the records of queries other than the running `ply`'s and the
/// bytes a compaction under its queries drops, and the segments it is and their bytes.
pub type Usage = {
  records: Int,
  answers: Int,
  answer_bytes: Int,
  unread_bytes: Int,
  foreign: Int,
  reclaimable_bytes: Int,
  segments: Int,
  bytes: Int,
}

/// What a key's newest row says: the answer its record names and that record's query; and the size
/// of the newest frame that brought it a record.
type Newest = { answer: Bytes, query: Bytes, frame: Int }

/// [`Usage`] of the store in `dir`, where `queries`, each a query's hash, are what the running `ply`
/// answers under.
pub fn usage<[r]>(dir: String, queries: List<Bytes>) -> Usage / {fs.read[r], abort.raise} = {
  let m = segments::manifest[r](dir, shapes());
  let current = queries.fold(Map::new(), |acc: Map<Bytes, Bool>, q: Bytes|
    acc.insert(q.blake3(), true));
  let rows_in = |seg: Segment, table: Int|
    match segments::rows[r](dir, seg, table) { Some(rows) -> rows, None -> b"" };
  // Oldest segment first, so a key's newest row is the last laid over it.
  let read = m.segments.fold(
    { newest: Map::new(), frames: 0, lengths: Map::new() },
    |acc: { newest: Map<Bytes, Newest>, frames: Int, lengths: Map<Bytes, Int> }, seg: Segment| {
      let qs = rows_in(seg, queries_table());
      let rows = rows_in(seg, records_table());
      let answers = rows_in(seg, answers_table());
      let laid = range(0, rows.len() / record_width()).fold(
        { newest: acc.newest, frames: acc.frames },
        |x: { newest: Map<Bytes, Newest>, frames: Int }, i: Int| {
          let b = rows.slice(i * record_width(), (i + 1) * record_width());
          let row = row_from(b);
          let was = match x.newest.get(b.slice(0, 32)) { Some(n) -> n.frame, None -> 0 };
          {
            newest: x.newest.insert(b.slice(0, 32), {
              answer: row.answer,
              query: query_in(qs, row.query).query,
              frame: if row.brought { row.size } else { was },
            }),
            frames: x.frames + (if row.brought { row.size } else { 0 }),
          }
        },
      );
      {
        newest: laid.newest,
        frames: laid.frames,
        lengths: range(0, answers.len() / placed_width()).fold(
          acc.lengths,
          |l: Map<Bytes, Int>, i: Int| {
            let b = answers.slice(i * placed_width(), (i + 1) * placed_width());
            l.insert(b.slice(0, 32), segments::word_at(b, 40))
          },
        ),
      }
    },
  );
  let kept = read.newest.fold(
    { answers: Map::new(), named: Map::new(), frames: 0, foreign: 0 },
    |acc: { answers: Map<Bytes, Bool>, named: Map<Bytes, Bool>, frames: Int, foreign: Int }, _: Bytes, n: Newest|
      if current.contains(n.query) {
        {
          ..acc,
          answers: acc.answers.insert(n.answer, true),
          named: acc.named.insert(n.answer, true),
          frames: acc.frames + n.frame,
        }
      } else { { ..acc, named: acc.named.insert(n.answer, true), foreign: acc.foreign + 1 } },
  );
  let answers = read.lengths.fold(
    { count: 0, bytes: 0, unread: 0, dropped: 0 },
    |u: { count: Int, bytes: Int, unread: Int, dropped: Int }, name: Bytes, n: Int|
      {
        count: u.count + 1,
        bytes: u.bytes + n,
        unread: if kept.named.contains(name) { u.unread } else { u.unread + n },
        dropped: if kept.answers.contains(name) { u.dropped } else { u.dropped + n },
      },
  );
  {
    records: read.newest.len(),
    answers: answers.count,
    answer_bytes: answers.bytes,
    unread_bytes: answers.unread,
    foreign: kept.foreign,
    reclaimable_bytes: answers.dropped + read.frames - kept.frames,
    segments: m.segments.len(),
    bytes: m.segments.fold(0, |n: Int, seg: Segment| n + seg.size),
  }
}

/// The store in `dir` written again as one segment that keeps only the records of `queries`, each
/// a query's hash: every other record is dropped, with every answer no record left names, each
/// reader that is no record any more, and every row but the newest of a key. A dropped record is
/// answered again by the next run that asks it. A compaction a run commits under lands nothing.
pub fn compacted<[r]>(
  dir: String,
  queries: List<Bytes>,
) -> Compacted / {fs.read[r], fs.write[r], abort.raise} = {
  let run = segments::entered[r](dir);
  let kept = queries.fold(Map::new(), |acc: Map<Bytes, Bool>, q: Bytes|
    acc.insert(q.blake3(), true));
  let done = match run {
    None -> None,
    Some(path) -> {
      let m = segments::manifest[r](dir, shapes());
      let dropped = if m.segments.len() == 0 { None }
      else { merged[r](dir, m, 0, segments::token_of(run, m.generation, 0), Only(kept)) };
      segments::swept[r](dir, shapes(), path, retired());
      dropped
    },
  };
  segments::left[r](run);
  match done { Some(d) -> d, None -> { records: 0, answers: 0, bytes: 0 } }
}

// --- Tests --------------------------------------------------------------------

fn quoted(input: Bytes) -> Bytes / {memo.read} =
  Bytes::concat_all([b"\"", memo.ask(b"text", input), b"\""])

/// The queries of the tests, and one nothing asks, whose hash alone tells two stamps apart.
fn test_queries(spare: Bytes) -> Map<Bytes, memo::Query<| {}>> =
  Map::new().insert(b"text", {
    name: b"text",
    hash: b"t1",
    body: memo::read_whole,
    kept: true,
  }).insert(b"quoted", { name: b"quoted", hash: b"q1", body: quoted, kept: true }).insert(
    b"spare",
    { name: b"spare", hash: spare, body: memo::read_whole, kept: true },
  )

/// What `quoted` answers over the store in `s` for a file holding `text`, asked by a run whose
/// queries hash `spare` among them, and how many bodies ran.
fn quoted_under<[r]>(
  text: Bytes,
  spare: Bytes,
) -> { output: Bytes, ran: Int } / {fs.read[r], fs.write[r], abort.raise} = {
  let queries = test_queries(spare);
  kept[r]("s", packs::no_pack, b"", |_: Bytes, _: Bytes| Some(text), || {
    let a = answer(queries, started(queries), b"quoted", b"a");
    { output: a.output, ran: memo::ran_total(a.run) }
  })
}

fn quoted_over<[r]>(text: Bytes) -> Bytes / {fs.read[r], fs.write[r], abort.raise} =
  quoted_under[r](text, b"").output

/// What `name` answers over the store in `s` for a file holding `text`, the query `text` keeping its
/// answers where `lasting` says, and how many bodies ran.
fn asked_keeping<[r]>(
  text: Bytes,
  name: Bytes,
  lasting: Bool,
) -> { output: Bytes, ran: Int } / {fs.read[r], fs.write[r], abort.raise} = {
  let queries = test_queries(b"").insert(b"text", {
    name: b"text",
    hash: b"t1",
    body: memo::read_whole,
    kept: lasting,
  });
  kept[r]("s", packs::no_pack, b"", |_: Bytes, _: Bytes| Some(text), || {
    let a = answer(queries, started(queries), name, b"a");
    { output: a.output, ran: memo::ran_total(a.run) }
  })
}

/// What the directory of the tests' store holds.
fn stored(tree: fs::MemFs) -> List<String> / {abort.raise} =
  match fs::mem_list(tree, "s") { Some(names) -> names, None -> [] }

fn segments_in(tree: fs::MemFs) -> List<String> / {abort.raise} =
  stored(tree).filter(|name: String| name.starts_with("seg-"))

test "a run that dies after any write leaves a store its next run answers from as a fresh one" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_over[abs](b"four"));
  assert_eq(first.value, b"\"four\"");
  let whole = fs::on_mem[abs](first.tree, || quoted_over[abs](b"forty")).tree;
  let writes = iterate(0, 1000, |n: Int| {
    let died = fs::on_mem_failing[abs](first.tree, n, || quoted_over[abs](b"forty"));
    assert_eq(fs::on_mem[abs](died.tree, || quoted_over[abs](b"forty")).value, b"\"forty\"");
    if died.tree.files == whole.files { Stop(n) } else { Continue(n + 1) }
  });
  assert(writes > 0)
}

test "a store is its manifest and a handful of segments, and a run that keeps nothing writes nothing" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_under[abs](b"four", b""));
  assert_eq(first.value.ran, 2);
  assert_eq(stored(first.tree).len(), 2);
  let again = fs::on_mem[abs](first.tree, || quoted_under[abs](b"four", b""));
  assert_eq(again.value, { output: b"\"four\"", ran: 0 });
  assert_eq(again.tree.files, first.tree.files);
  // What a run adds is written again as one segment with what it found, being as much.
  let moved = fs::on_mem[abs](again.tree, || quoted_under[abs](b"forty", b""));
  assert_eq(moved.value, { output: b"\"forty\"", ran: 2 });
  assert_eq(stored(moved.tree).len(), 2);
  assert_eq(fs::on_mem[abs](moved.tree, || quoted_under[abs](b"forty", b"")).value.ran, 0)
}

test "a record another stamp kept is checked before it is taken, and no body runs where it stands" {
  let one = b"one";
  let two = b"two";
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_under[abs](b"four", one));
  let other = fs::on_mem[abs](first.tree, || quoted_under[abs](b"four", two));
  assert_eq(other.value, { output: b"\"four\"", ran: 0 });
  // The second stamp wrote that it checked them; from then on neither writes.
  assert(other.tree.files != first.tree.files);
  let back = fs::on_mem[abs](other.tree, || quoted_under[abs](b"four", one));
  assert_eq(back.value.ran, 0);
  assert_eq(back.tree.files, other.tree.files);
  let forth = fs::on_mem[abs](back.tree, || quoted_under[abs](b"four", two));
  assert_eq(forth.value.ran, 0);
  assert_eq(forth.tree.files, other.tree.files)
}

test "a store vouches to a run of a stamp that kept or checked in it, and to no other" {
  let vouched_under = |tree: fs::MemFs, spare: Bytes| {
    let queries = test_queries(spare);
    fs::on_mem[abs](tree, ||
      kept[abs]("s", packs::no_pack, b"", |_: Bytes, _: Bytes| Some(b"four"), ||
        memo::vouched_to(answer(queries, started(queries), b"quoted", b"a").run)))
  };
  let first = vouched_under(fs::mem_of([]), b"one");
  assert(!first.value);
  assert(vouched_under(first.tree, b"one").value);
  let other = vouched_under(first.tree, b"two");
  assert(!other.value);
  // Having checked what the first kept, the second is vouched to as well.
  assert(vouched_under(other.tree, b"two").value);
  assert(vouched_under(other.tree, b"one").value)
}

test "a run under queries a store never saw writes nothing until it asks" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_under[abs](b"four", b"one"));
  let queries = test_queries(b"two");
  let idle = fs::on_mem[abs](first.tree, ||
    kept[abs]("s", packs::no_pack, b"", |_: Bytes, _: Bytes| Some(b"four"), ||
      memo::ran_total(started(queries))));
  assert_eq(idle.value, 0);
  assert_eq(idle.tree.files, first.tree.files)
}

test "what moved under one stamp is answered again under another" {
  let one = b"one";
  let two = b"two";
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_under[abs](b"four", one));
  let other = fs::on_mem[abs](first.tree, || quoted_under[abs](b"four", two));
  let moved = fs::on_mem[abs](other.tree, || quoted_under[abs](b"forty", two));
  assert_eq(moved.value, { output: b"\"forty\"", ran: 2 });
  let back = fs::on_mem[abs](moved.tree, || quoted_under[abs](b"forty", one));
  assert_eq(back.value, { output: b"\"forty\"", ran: 0 })
}

/// Whether a racing run has yet to begin: the first look begins it.
effect rival {
  write first() -> Bool
}

test "two runs at once over an edit leave a store that answers as a fresh one" {
  // The second run starts at the first's first look at the world, sees the edit and ends first.
  let racing = |tree: fs::MemFs|
    fs::on_mem[abs](tree, || {
      let queries = test_queries(b"");
      handle {
        kept[abs](
          "s",
          packs::no_pack,
          b"",
          |_: Bytes, _: Bytes| {
            if rival.first() {
              quoted_over[abs](b"forty");
              ()
            };
            Some(b"four")
          },
          || answer(queries, started(queries), b"quoted", b"a").output,
        )
      } with {
        var begun = false,
        rival.first() -> {
          let first = !begun;
          begun = true;
          first
        },
      }
    });
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_over[abs](b"four"));
  let raced = racing(first.tree);
  assert_eq(raced.value, b"\"four\"");
  let after = fs::on_mem[abs](raced.tree, || quoted_under[abs](b"forty", b""));
  assert_eq(after.value.output, b"\"forty\"");
  let settled = fs::on_mem[abs](after.tree, || quoted_under[abs](b"forty", b""));
  assert_eq(settled.value, { output: b"\"forty\"", ran: 0 });
  // Neither run saw what the other kept, so the store vouched for neither.
  let cold = racing(fs::mem_of([]));
  assert_eq(
    fs::on_mem[abs](cold.tree, || quoted_under[abs](b"forty", b"")).value.output,
    b"\"forty\"",
  )
}

test "a compaction leaves one segment holding the records of the queries it is given" {
  let first = fs::on_mem[abs](fs::mem_of([{ path: "s/records/stale", body: b"old" }]), ||
    quoted_over[abs](b"four"));
  // A run that names a segment removes the directories of the layout no run reads.
  assert(!stored(first.tree).contains("records"));
  let moved = fs::on_mem[abs](first.tree, || quoted_over[abs](b"forty"));
  let small = fs::on_mem[abs](moved.tree, || compacted[abs]("s", [b"t1", b"q1"]));
  assert_eq(small.value.records, 0);
  assert_eq(segments_in(small.tree).len(), 1);
  let after = fs::on_mem[abs](small.tree, || quoted_under[abs](b"forty", b""));
  assert_eq(after.value, { output: b"\"forty\"", ran: 0 });
  let less = fs::on_mem[abs](small.tree, || compacted[abs]("s", [b"t1"]));
  // The record of `quoted` goes, and the one it replaced, which an edit undone would take back.
  assert_eq(less.value.records, 2);
  let cold = fs::on_mem[abs](less.tree, || quoted_under[abs](b"forty", b""));
  assert_eq(cold.value, { output: b"\"forty\"", ran: 1 })
}

/// How many bodies ran as `quoted` was asked over the store in `s`, for a file holding `four`, by a
/// run whose two queries hash with `tag`: another `ply`'s for another tag.
fn quoted_tagged<[r]>(tag: Bytes) -> Int / {fs.read[r], fs.write[r], abort.raise} = {
  let queries = Map::new().insert(b"text", {
    name: b"text",
    hash: b"t".concat(tag),
    body: memo::read_whole,
    kept: true,
  }).insert(b"quoted", { name: b"quoted", hash: b"q".concat(tag), body: quoted, kept: true });
  kept[r]("s", packs::no_pack, b"", |_: Bytes, _: Bytes| Some(b"four"), ||
    memo::ran_total(answer(queries, started(queries), b"quoted", b"a").run))
}

test "what a store holds of another `ply`'s queries is counted as what a compaction reclaims" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_tagged[abs](b"a"));
  let own = fs::on_mem[abs](first.tree, || usage[abs]("s", [b"ta", b"qa"])).value;
  let other = fs::on_mem[abs](first.tree, || usage[abs]("s", [b"tb", b"qb"])).value;
  assert_eq([own.records, own.foreign, own.reclaimable_bytes], [2, 0, 0]);
  assert_eq([other.records, other.foreign], [2, 2]);
  assert(other.reclaimable_bytes > 0);
  let compacted = fs::on_mem[abs](first.tree, || compacted[abs]("s", [b"tb", b"qb"]));
  assert_eq(fs::on_mem[abs](compacted.tree, || usage[abs]("s", [b"tb", b"qb"])).value.records, 0)
}

test "a store several `ply`s keep holds the one writing and as much again of the latest others" {
  let after = |tree: fs::MemFs, tag: Bytes| fs::on_mem[abs](tree, || quoted_tagged[abs](tag));
  let four = [b"a", b"b", b"c", b"d"].fold(fs::mem_of([]), |tree: fs::MemFs, tag: Bytes| {
    let ran = after(tree, tag);
    assert_eq(ran.value, 2);
    ran.tree
  });
  // The last two are held. The others went as the store was written again: each was the longest
  // unasked, past what the writer's own records hold.
  assert_eq(after(four, b"d").value, 0);
  assert_eq(after(four, b"c").value, 0);
  assert_eq(after(four, b"b").value, 2);
  assert_eq(after(four, b"a").value, 2)
}

/// `output` kept in the store in `s` as a command's answer under the hash `p`, then `quoted` asked of a
/// file holding `text` by a run writing the store again: each run counts `commands` as its own.
/// Whether the command's answer is still kept.
fn command_outlived<[r]>(
  output: Bytes,
  text: Bytes,
  commands: List<Bytes>,
) -> Bool / {fs.read[r], fs.write[r], abort.raise} = {
  let queries = test_queries(b"");
  let key = b"a command".blake3();
  kept[r](
    "s",
    packs::no_pack,
    b"",
    |_: Bytes, _: Bytes| Some(text),
    || memo::recorded(queries, key, b"p", [], output, []),
    commands: commands,
  );
  kept[r](
    "s",
    packs::no_pack,
    b"",
    |_: Bytes, _: Bytes| Some(text),
    || memo::ran_total(answer(queries, started(queries), b"quoted", b"a").run),
    commands: commands,
  );
  record_at[r]("s", key) != None
}

test "a run writing the store again keeps its own commands' answers, whatever they hold" {
  let output = b"answer ".repeat(1200);
  let text = b"text ".repeat(600);
  assert(fs::on_mem[abs](fs::mem_of([]), || command_outlived[abs](output, text, [b"p"])).value);
  assert(!fs::on_mem[abs](fs::mem_of([]), || command_outlived[abs](output, text, [])).value)
}

test "a longer answer is kept once, and one that does not read costs its body once" {
  let long = b"long ".repeat(1000);
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_under[abs](long, b""));
  assert_eq(first.value.ran, 2);
  let name = match segments_in(first.tree) { [name] -> "s/" ++ name, _ -> "" };
  let bytes = match fs::mem_read(first.tree, name) { Some(b) -> b, None -> b"" };
  // Both answers hold the text, and each is past what a record holds inside it.
  assert(bytes.len() > 10000 && bytes.len() < 14000);
  // Every frame is damaged: the tables still say what was kept, and nothing of it reads.
  let torn = fs::on_mem[abs](first.tree, || {
    fs.write_file[abs](
      name,
      Bytes::concat_all([
        bytes.slice(0, 52),
        b"\x00".repeat(10000),
        bytes.slice(10052, bytes.len()),
      ]),
    );
    quoted_under[abs](long, b"")
  });
  assert_eq(torn.value.output, Bytes::concat_all([b"\"", long, b"\""]));
  assert_eq(torn.value.ran, 2);
  assert_eq(fs::on_mem[abs](torn.tree, || quoted_under[abs](long, b"")).value.ran, 0)
}

test "a query that keeps no answers writes none, and a later run that needs one answers it again" {
  let long = b"long ".repeat(1000);
  let first = fs::on_mem[abs](fs::mem_of([]), || asked_keeping[abs](long, b"quoted", false));
  assert_eq(first.value.ran, 2);
  let name = match segments_in(first.tree) { [name] -> "s/" ++ name, _ -> "" };
  let bytes = match fs::mem_read(first.tree, name) { Some(b) -> b, None -> b"" };
  // Only the quoted answer holds the text.
  assert(bytes.len() > 5000 && bytes.len() < 10000);
  let again = fs::on_mem[abs](first.tree, || asked_keeping[abs](long, b"quoted", false));
  assert_eq(again.value.ran, 0);
  let text = fs::on_mem[abs](again.tree, || asked_keeping[abs](long, b"text", false));
  assert_eq(text.value.output, long);
  assert_eq(text.value.ran, 1)
}

test "each longer answer is found again once a store is written again as one segment" {
  let queries = test_queries(b"");
  // Each file's text quoted, every answer past what a record holds inside it.
  let all = ||
    kept[abs](
      "s",
      packs::no_pack,
      b"",
      |_: Bytes, at: Bytes| Some(b"long ".repeat(1000).concat(at)),
      ||
        memo::ran_total(
          range(0, 12).fold(started(queries), |run: memo::Run, i: Int|
            answer(queries, run, b"quoted", Bytes::of_string(i.to_string())).run),
        ),
    );
  let first = fs::on_mem[abs](fs::mem_of([]), || all());
  assert_eq(first.value, 24);
  let small = fs::on_mem[abs](first.tree, || compacted[abs]("s", [b"t1", b"q1"]));
  assert_eq(small.value, { records: 0, answers: 0, bytes: 0 });
  assert_eq(fs::on_mem[abs](small.tree, || all()).value, 0)
}

/// The pack of what `text` and `quoted` answer of a file holding `text`, and of the keys `also`,
/// made over the files `b"files"` lists.
fn quoted_pack(
  text: Bytes,
  also: List<Bytes>,
) -> { written: packs::Written, records: Int } / {abort.raise} = {
  let queries = test_queries(b"");
  let keys = [b"text", b"quoted"].map(|name: Bytes|
    match queries.get(name) { Some(q) -> memo::key_of(q, b"a"), None -> b"" });
  fs::on_mem[abs](fs::mem_of([]), || {
    quoted_over[abs](text);
    packed[abs]("s", keys.concat(also), packs::as_is, memo::stamp_of(queries), b"files")
  }).value
}

/// What `quoted` answers over the store in `tree` with `pack` below it, for a run over the files
/// `files` lists of a file holding `text`, and how many bodies ran.
fn quoted_below(
  tree: fs::MemFs,
  pack: packs::Written,
  files: Bytes,
  text: Bytes,
) -> fs::Over<{ output: Bytes, ran: Int }> / {abort.raise} = {
  let queries = test_queries(b"");
  fs::on_mem[abs](tree, ||
    kept[abs](
      "s",
      |path: String, offset: Int, len: Int| packs::frame_in(Some(pack), path, offset, len),
      files,
      |_: Bytes, _: Bytes| Some(text),
      || {
        let a = answer(queries, started(queries), b"quoted", b"a");
        { output: a.output, ran: memo::ran_total(a.run) }
      },
    ))
}

test "a pack holds the records asked for and the answers they name, and a run below takes them" {
  let long = b"long ".repeat(1000);
  let made = quoted_pack(long, [b"none".blake3()]);
  assert_eq(made.records, 2);
  let below = |files: Bytes, text: Bytes| quoted_below(fs::mem_of([]), made.written, files, text);
  let quoted_long = Bytes::concat_all([b"\"", long, b"\""]);
  let stands = below(b"files", long);
  assert_eq(stands.value, { output: quoted_long, ran: 0 });
  assert_eq(segments_in(stands.tree), []);
  assert_eq(below(b"other files", long).value, { output: quoted_long, ran: 0 });
  assert_eq(below(b"other files", b"four").value, { output: b"\"four\"", ran: 2 })
}

// The files listed are the same in both runs, so only what the store noted says the text moved.
test "what a run answered again over a pack it does not trust is answered again where its reads move" {
  let pack = quoted_pack(b"long ".repeat(1000), []).written;
  let first = quoted_below(fs::mem_of([]), pack, b"other files", b"four");
  assert_eq(first.value, { output: b"\"four\"", ran: 2 });
  let moved = quoted_below(first.tree, pack, b"other files", b"forty");
  assert_eq(moved.value, { output: b"\"forty\"", ran: 2 });
  assert_eq(quoted_below(moved.tree, pack, b"other files", b"forty").value.ran, 0)
}

// The command's answer outweighs every other record, as `ply run`'s does over a pack below.
test "a run keeps what it wrote through the merge its write makes, and a later run's merge may drop it" {
  let queries = test_queries(b"");
  let key = b"command".blake3();
  let said = b"done ".repeat(40000);
  let look = |_: Bytes, at: Bytes| Some(b"long ".repeat(1200).concat(at));
  let session = |tree: fs::MemFs, work: () -> Option<Bytes> / {memo_keep.read, memo_keep.write, abort.raise}|
    fs::on_mem[abs](tree, || kept[abs]("s", packs::no_pack, b"", look, work));
  let held = |tree: fs::MemFs|
    match fs::on_mem[abs](tree, || record_at[abs]("s", key)).value {
      Some(_) -> true,
      None -> false,
    };
  let loaded = fs::on_mem[abs](fs::mem_of([]), ||
    kept[abs]("s", packs::no_pack, b"", look, ||
      memo::asked_reads(answer(queries, started(queries), b"quoted", b"a").run)));
  let filed = session(loaded.tree, || {
    memo::recorded(queries, key, b"c1", loaded.value, said, []);
    None
  });
  assert(held(filed.tree), Some("the run's own record outlives the merge its write made"));
  assert_eq(
    session(filed.tree, || memo::standing(queries, started(queries), key).output).value,
    Some(said),
  );
  // A run that keeps less than the command weighs, and enough to merge the whole store again.
  let later = session(filed.tree, || {
    range(0, 10).fold(started(queries), |run: memo::Run, i: Int|
      answer(queries, run, b"quoted", Bytes::of_string(i.to_string())).run);
    None
  });
  assert(!held(later.tree), Some("another run's merge drops a record of a query not its own"))
}

test "taking back a command's answer asks the file system the same handful of things, however much is kept" {
  let queries = test_queries(b"");
  let key = b"command".blake3();
  let world = |_: Bytes, at: Bytes| Some(at);
  // Each file's text quoted, a command's answer over all of it, and the store written again whole.
  let built = |files: Int|
    fs::on_mem[abs](fs::mem_of([]), || {
      kept[abs]("s", packs::no_pack, b"", world, || {
        let run = range(0, files).fold(started(queries), |run: memo::Run, i: Int|
          answer(queries, run, b"quoted", Bytes::of_string(i.to_string())).run);
        memo::recorded(queries, key, b"c1", memo::asked_reads(run), b"done", [])
      });
      compacted[abs]("s", [b"t1", b"q1", b"c1"])
    }).tree;
  let taken = |tree: fs::MemFs|
    fs::on_mem_counted[abs](tree, ||
      kept[abs]("s", packs::no_pack, b"", world, ||
        memo::standing(queries, started(queries), key).output));
  let few = taken(built(3));
  let many = taken(built(200));
  assert_eq(many.value, Some(b"done"));
  assert_eq(few.asked, many.asked);
  assert(many.asked <= 12)
}
