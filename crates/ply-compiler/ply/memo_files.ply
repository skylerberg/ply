//! The memo store as files in a directory: `records/`, each record under its key; `outputs/`, each
//! answer under its digest; `places/`, what the store last saw at each place of the world a record
//! read; `readers/`, the keys of the records that read each place or asked each record; and
//! `marked/`, a file for each mark on a record, named by the record's key and the mark, so a run lists
//! only the marks there are. A run reads the records it asks for and no other, and keeps what it
//! answered as files of their own, each landed whole by a rename, so runs that keep the same answer
//! at once leave one.

import std.bin
import std.fs
import std.fs (fs, under)
import std.bytes (bytes_of_hex, hex_of)
import std.list (contains)
import memo (Record, Seen, memo_keep, digest_of, head_bytes, output_named, output_path,
             record_bytes, record_from, record_path, seen_bin)

fn records_dir(dir: String) -> String = under(dir, "records")

fn outputs_dir(dir: String) -> String = under(dir, "outputs")

fn places_dir(dir: String) -> String = under(dir, "places")

fn readers_dir(dir: String) -> String = under(dir, "readers")

fn marks_dir(dir: String) -> String = under(dir, "marked")

fn holds_dir(dir: String) -> String = under(dir, "holds")

fn runs_dir(dir: String) -> String = under(dir, "runs")

fn at(dir: String, path: String) -> String = dir ++ "/" ++ path

fn named_in(sub: String, id: Bytes) -> String / {abort.raise} = sub ++ "/" ++ hex_of(id)

/// The record `bytes` hold, or nothing where they do not read as one.
fn record_of(bytes: Option<Bytes>) -> Option<Record> / {abort.raise} =
  match bytes { None -> None, Some(b) -> record_from(b) }

/// The record the store in `dir` holds under `key`.
pub fn record_at<[r]>(dir: String, key: Bytes) -> Option<Record> / {fs.read[r], abort.raise} =
  record_of(fs.read_file[r](at(dir, record_path(key))))

/// The bytes of the keys `bytes` lists, each once.
fn keys_in(bytes: Option<Bytes>) -> List<Bytes> =
  match bytes {
    None -> [],
    Some(b) ->
      map_keys(
        fold(range(0, bytes_len(b) / 32), map_new(), |acc: Map<Bytes, Bool>, i: Int|
          map_insert(acc, bytes_slice(b, i * 32, i * 32 + 32), true)),
      ),
  }

/// The marks the store in `dir` holds, by the key of the record each is on.
fn marks_in<[r]>(dir: String) -> Map<Bytes, List<Bytes>> / {fs.read[r], abort.raise} =
  fold(landed_in[r](marks_dir(dir)), map_new(), |acc: Map<Bytes, List<Bytes>>, n: String|
    if string_len(n) <= 65 || string_slice(n, 64, 65) != "-" { acc } else {
      let key = bytes_of_hex(string_slice(n, 0, 64));
      let mark = bytes_of_string(string_slice(n, 65, string_len(n)));
      map_insert(acc, key, push(match map_get(acc, key) { Some(ms) -> ms, None -> [] }, mark))
    })

fn mark_path(dir: String, key: Bytes, mark: Bytes) -> String / {abort.raise} =
  marks_dir(dir) ++ "/" ++ hex_of(key) ++ "-" ++ string_of_bytes_lossy(mark)

/// `work` run over the memo store in `dir`, with `look` answering what the world holds now: each
/// record it keeps written back as it is answered. Where `dir` holds no record under a key, a
/// read-only store laid out as this one is asked through `beside`, which reads a file of it by its
/// path within it.
pub fn kept<a, [r] | e>(
  dir: String,
  beside: (String) -> Option<Bytes> / {abort.raise | e},
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_keep.read, memo_keep.write, abort.raise},
) -> a / {fs.read[r], fs.write[r], abort.raise | e} = {
  fs.create_dir[r](records_dir(dir));
  fs.create_dir[r](outputs_dir(dir));
  fs.create_dir[r](places_dir(dir));
  fs.create_dir[r](readers_dir(dir));
  fs.create_dir[r](marks_dir(dir));
  fs.create_dir[r](holds_dir(dir));
  fs.create_dir[r](runs_dir(dir));
  // A directory of this run's own names what it marks and lands, so no two runs' names meet. A store
  // that takes no directory takes no write either, so the name it would have had is moot.
  let mine = fs.temp_dir[r](runs_dir(dir), "run");
  let token = match mine {
    Some(path) -> match list_at(string_split(path, "/"), len(string_split(path, "/")) - 1) {
      Some(t) -> t,
      None -> path,
    },
    None -> "unwritten",
  };
  let value = with_cell[minted](0) { minted ->
    with_cell[marking](marks_in[r](dir)) { marking -> {
      let fresh = || {
        let n = cell_get(minted);
        cell_set(minted, n + 1);
        token ++ "." ++ int_to_string(n)
      };
      // `bytes` at `path`, landed whole: written beside it under a name of this run's, and renamed.
      let landed = |path: String, bytes: Bytes| {
        let tmp = path ++ "." ++ fresh() ++ ".tmp";
        if fs.write_file[r](tmp, bytes) {
          fs.rename[r](tmp, path);
          ()
        }
      };
      handle {
        work()
      } with {
        memo_keep.head(key) -> match fs.read_at[r](at(dir, record_path(key)), 0, head_bytes()) {
          Some(b) -> output_named(b),
          None -> None,
        },
        memo_keep.record(key) -> record_of(fs.read_file[r](at(dir, record_path(key)))),
        memo_keep.packed(key) -> record_of(beside(record_path(key))),
        memo_keep.output(digest) -> match fs.read_file[r](at(dir, output_path(digest))) {
          Some(o) -> Some(o),
          None -> beside(output_path(digest)),
        },
        memo_keep.keep(key, rec, output) -> {
          let path = at(dir, output_path(rec.output));
          if !fs.exists[r](path) { landed(path, output) };
          landed(at(dir, record_path(key)), record_bytes(rec))
        },
        memo_keep.adopt(key, rec) -> landed(at(dir, record_path(key)), record_bytes(rec)),
        memo_keep.now(kind, place) -> look(kind, place),
        memo_keep.places() -> match fs.list_dir[r](places_dir(dir)) {
          None -> [],
          Some(names) ->
            fold(names, [], |acc: List<Seen>, n: String|
              if string_ends_with(n, ".tmp") { acc } else {
                match fs.read_file[r](places_dir(dir) ++ "/" ++ n) {
                  Some(b) -> match bin::decode(b, seen_bin()) {
                    Ok(s) -> push(acc, s),
                    Err(_) -> acc,
                  },
                  None -> acc,
                }
              }),
        },
        memo_keep.seen(id) -> match fs.read_file[r](named_in(places_dir(dir), id)) {
          Some(b) -> match bin::decode(b, seen_bin()) { Ok(s) -> Some(s), Err(_) -> None },
          None -> None,
        },
        memo_keep.see(id, s) -> landed(named_in(places_dir(dir), id), bin::encode(s, seen_bin())),
        memo_keep.readers(id) -> keys_in(fs.read_file[r](named_in(readers_dir(dir), id))),
        memo_keep.link(id, key) -> {
          fs.append[r](named_in(readers_dir(dir), id), key);
          ()
        },
        memo_keep.marks(key) -> match map_get(cell_get(marking), key) {
          Some(ms) -> ms,
          None -> [],
        },
        memo_keep.marked() -> {
          let now = marks_in[r](dir);
          cell_set(marking, now);
          map_fold(now, [], |acc: List<Bytes>, k: Bytes, ms: List<Bytes>|
            if len(ms) == 0 { acc } else { push(acc, k) })
        },
        memo_keep.mark(key) -> {
          let m = bytes_of_string(fresh());
          fs.write_file[r](mark_path(dir, key, m), b"");
          let held = cell_get(marking);
          cell_set(
            marking,
            map_insert(held, key, push(match map_get(held, key) { Some(ms) -> ms, None -> [] }, m)),
          )
        },
        memo_keep.unmark(key, gone) -> {
          fold(gone, (), |_: Unit, m: Bytes| {
            fs.remove[r](mark_path(dir, key, m));
            ()
          });
          let held = cell_get(marking);
          cell_set(
            marking,
            map_insert(
              held,
              key,
              filter(match map_get(held, key) { Some(ms) -> ms, None -> [] }, |m: Bytes|
                !contains(gone, m)),
            ),
          )
        },
        memo_keep.hold(id) -> fs.lock[r](named_in(holds_dir(dir), id)),
        memo_keep.release(id) -> {
          fs.unlock[r](named_in(holds_dir(dir), id));
          ()
        },
      }
    } }
  };
  match mine {
    Some(path) -> {
      fs.remove[r](path);
      ()
    },
    None -> (),
  };
  value
}

/// The store `to` made to hold the records under each of `keys` in the store `from`, the answers they
/// name, and nothing else. An answer `to` holds already is not written again, its name being its
/// digest, so a store kept between copies is written what moved. How many records it holds.
pub fn copied<[r], [w]>(
  from: String,
  to: String,
  keys: List<Bytes>,
) -> Int / {fs.read[r], fs.read[w], fs.write[w], abort.raise} = {
  fs.create_dir[w](records_dir(to));
  fs.create_dir[w](outputs_dir(to));
  let landed = |path: String, bytes: Bytes| {
    let tmp = path ++ ".tmp";
    fs.write_file[w](tmp, bytes) && fs.rename[w](tmp, path)
  };
  let held = fold(
    keys,
    { records: map_new(), outputs: map_new() },
    |acc: { records: Map<String, Bool>, outputs: Map<String, Bool> }, key: Bytes| {
      let bytes = fs.read_file[r](at(from, record_path(key)));
      match ((bytes, record_of(bytes))) {
        (Some(b), Some(rec)) -> {
          let output = output_path(rec.output);
          let there = fs.exists[w](at(to, output))
            || (match fs.read_file[r](at(from, output)) {
              Some(o) -> landed(at(to, output), o),
              None -> false,
            });
          if !there { acc } else {
            let record = record_path(key);
            if fs.read_file[w](at(to, record)) != Some(b) {
              landed(at(to, record), b);
              ()
            };
            {
              records: map_insert(acc.records, record, true),
              outputs: map_insert(acc.outputs, output, true),
            }
          }
        },
        _ -> acc,
      }
    },
  );
  let swept = |sub: String, kept: Map<String, Bool>|
    fold(landed_in[w](at(to, sub)), (), |_: Unit, name: String|
      if !map_contains(kept, sub ++ "/" ++ name) {
        fs.remove[w](at(to, sub ++ "/" ++ name));
        ()
      });
  swept("records", held.records);
  swept("outputs", held.outputs);
  map_len(held.records)
}

/// What the store in `dir` holds: its records, the answers kept beside them and their bytes, and the
/// bytes of the answers no record names, which compaction reclaims.
pub type Usage = { records: Int, answers: Int, answer_bytes: Int, unread_bytes: Int }

/// The names of the files in `sub` of `dir` that landed whole.
fn landed_in<[r]>(sub: String) -> List<String> / {fs.read[r]} =
  match fs.list_dir[r](sub) {
    Some(names) -> filter(names, |n: String| !string_ends_with(n, ".tmp")),
    None -> [],
  }

/// Each record of the store in `dir` that reads back, by the name of its file.
fn records_in<[r]>(
  dir: String,
) -> List<{ name: String, record: Record }> / {fs.read[r], abort.raise} =
  fold(
    landed_in[r](records_dir(dir)),
    [],
    |acc: List<{ name: String, record: Record }>, n: String|
      match record_of(fs.read_file[r](records_dir(dir) ++ "/" ++ n)) {
        Some(rec) -> push(acc, { name: n, record: rec }),
        None -> acc,
      },
  )

fn named_digests(
  records: List<{ name: String, record: Record }>,
) -> Map<String, Bool> / {abort.raise} =
  fold(records, map_new(), |acc: Map<String, Bool>, r: { name: String, record: Record }|
    map_insert(acc, hex_of(r.record.output), true))

pub fn usage<[r]>(dir: String) -> Usage / {fs.read[r], abort.raise} = {
  let records = records_in[r](dir);
  let named = named_digests(records);
  let sized = |name: String|
    match fs.file_size[r](outputs_dir(dir) ++ "/" ++ name) { Some(n) -> n, None -> 0 };
  fold(
    landed_in[r](outputs_dir(dir)),
    { records: len(records), answers: 0, answer_bytes: 0, unread_bytes: 0 },
    |u: Usage, name: String| {
      let n = sized(name);
      {
        ..u,
        answers: u.answers + 1,
        answer_bytes: u.answer_bytes + n,
        unread_bytes: if map_contains(named, name) { u.unread_bytes } else { u.unread_bytes + n },
      }
    },
  )
}

/// What a compaction dropped: records it did not keep, and answers no record names.
pub type Compacted = { records: Int, answers: Int, bytes: Int }

/// Drops every record `keeps` does not keep, asked with the hex of its key, and then every answer no
/// record left names. A dropped record is answered again by the next run that asks it.
pub fn compacted<[r]>(
  dir: String,
  keeps: (String, Record) -> Bool,
) -> Compacted / {fs.read[r], fs.write[r], abort.raise} = {
  let all = records_in[r](dir);
  let kept = filter(all, |x: { name: String, record: Record }| keeps(x.name, x.record));
  let gone = fold(all, 0, |n: Int, x: { name: String, record: Record }|
    if keeps(x.name, x.record) || !fs.remove[r](records_dir(dir) ++ "/" ++ x.name) { n }
    else { n + 1 });
  let named = named_digests(kept);
  let dropped = fold(
    landed_in[r](outputs_dir(dir)),
    { answers: 0, bytes: 0 },
    |acc: { answers: Int, bytes: Int }, name: String|
      if map_contains(named, name) { acc } else {
        let path = outputs_dir(dir) ++ "/" ++ name;
        let n = match fs.file_size[r](path) { Some(x) -> x, None -> 0 };
        if fs.remove[r](path) { { answers: acc.answers + 1, bytes: acc.bytes + n } } else { acc }
      },
  );
  { records: gone, answers: dropped.answers, bytes: dropped.bytes }
}

test "a copy leaves its store holding the records asked for and their answers, and nothing else" {
  let record = |answer: Bytes|
    record_bytes({ query: b"q", input: b"", reads: [], output: digest_of(Some(answer)) });
  let answer_at = |store: String, answer: Bytes|
    store ++ "/" ++ output_path(digest_of(Some(answer)));
  let tree = fs::mem_of([
    { path: "from/" ++ record_path(b"kept"), body: record(b"one") },
    { path: answer_at("from", b"one"), body: b"one" },
    { path: "from/" ++ record_path(b"unasked"), body: record(b"two") },
    { path: answer_at("from", b"two"), body: b"two" },
    { path: "to/" ++ record_path(b"stale"), body: record(b"old") },
    { path: answer_at("to", b"old"), body: b"old" },
  ]);
  let first = fs::on_mem[abs](tree, || copied[abs, abs]("from", "to", [b"kept"]));
  assert_eq(first.value, 1);
  assert_eq(fs::mem_list(first.tree, "to/records"), Some([hex_of(b"kept")]));
  assert_eq(fs::mem_read(first.tree, answer_at("to", b"one")), Some(b"one"));
  assert_eq(fs::mem_read(first.tree, answer_at("to", b"old")), None);
  // An answer the store holds is named by its digest, so a copy does not write it again.
  let held = fs::mem_write(first.tree, answer_at("to", b"one"), b"as held").fs;
  let again = fs::on_mem[abs](held, || copied[abs, abs]("from", "to", [b"kept"]));
  assert_eq(fs::mem_read(again.tree, answer_at("to", b"one")), Some(b"as held"))
}

test "a readers file's keys are each read once" {
  let key = |c: Bytes| bytes_concat_all(map(range(0, 32), |_: Int| c));
  assert_eq(keys_in(Some(bytes_concat_all([key(b"b"), key(b"a"), key(b"b"), key(b"a")]))), [
    key(b"a"),
    key(b"b"),
  ]);
  assert_eq(keys_in(None), [])
}
