//! The memo store as files in a directory: `records/`, each record under its key, holding its answer
//! where it is short; `outputs/`, each longer answer under its digest; `places/`, what the store last
//! saw at each place of the world a record read; `links/`, the keys of the records that read each
//! place or asked each record, in 4096 files by the id of what they read; and
//! `marked/`, a file for each mark on a record, named by the record's key and the mark, so a run lists
//! only the marks there are. A run reads the records it asks for and no other, and keeps what it
//! answered as files of their own, each landed whole by a rename, so runs that keep the same answer
//! at once leave one. What it keeps is written in batches, as it ends or once enough waits: marks at
//! once, and a record only after the notes of what it read.

import std.bin
import std.fs
import std.fs (fs, under)
import std.bytes (bytes_of_hex, hex_of)
import std.list (contains)
import memo (Record, Seen, memo_keep, digest_of, head_bytes, output_named, height_named,
             inline_named, kept_inline, output_path, record_bytes, record_from, record_path,
             seen_bin)

fn records_dir(dir: String) -> String = under(dir, "records")

fn outputs_dir(dir: String) -> String = under(dir, "outputs")

fn places_dir(dir: String) -> String = under(dir, "places")

fn links_dir(dir: String) -> String = under(dir, "links")

fn marks_dir(dir: String) -> String = under(dir, "marked")

fn holds_dir(dir: String) -> String = under(dir, "holds")

fn runs_dir(dir: String) -> String = under(dir, "runs")

fn at(dir: String, path: String) -> String = dir ++ "/" ++ path

/// What a run kept and has not written yet: records by key, the answers no record holds by digest,
/// and the keys of the records that read each place or asked each record, by its id; and about how
/// many bytes that is.
type Pending = {
  records: Map<Bytes, Bytes>,
  outputs: Map<Bytes, Bytes>,
  links: Map<Bytes, Bytes>,
  size: Int,
}

fn no_pending() -> Pending = { records: map_new(), outputs: map_new(), links: map_new(), size: 0 }

/// How many bytes a run holds unwritten before it writes them.
fn pending_bound() -> Int = 67108864

fn named_in(sub: String, id: Bytes) -> String / {abort.raise} = sub ++ "/" ++ hex_of(id)

/// The file the readers of `id` are noted in: one of 4096, by the id's first twelve bits. Each note
/// there is the id, then the key of a record that read it.
fn links_path(dir: String, id: Bytes) -> String / {abort.raise} =
  links_dir(dir) ++ "/" ++ string_slice(hex_of(bytes_slice(id, 0, 2)), 0, 3)

/// The keys `bytes`, a links file, notes as readers of `id`, in the order noted.
fn readers_in(bytes: Option<Bytes>, id: Bytes) -> List<Bytes> =
  match bytes {
    None -> [],
    Some(b) ->
      fold(range(0, bytes_len(b) / 64), [], |acc: List<Bytes>, i: Int|
        if bytes_slice(b, i * 64, i * 64 + 32) == id {
          push(acc, bytes_slice(b, i * 64 + 32, i * 64 + 64))
        } else { acc }),
  }

/// The notes of `keys` as readers of `id`, as a links file holds them.
fn notes_of(id: Bytes, keys: Bytes) -> Bytes =
  bytes_concat_all(
    map(range(0, bytes_len(keys) / 32), |i: Int|
      bytes_concat(id, bytes_slice(keys, i * 32, i * 32 + 32))),
  )

/// The record `bytes` hold, or nothing where they do not read as one.
fn record_of(bytes: Option<Bytes>) -> Option<Record> / {abort.raise} =
  match bytes { None -> None, Some(b) -> record_from(b) }

/// The record the store in `dir` holds under `key`.
pub fn record_at<[r]>(dir: String, key: Bytes) -> Option<Record> / {fs.read[r], abort.raise} =
  record_of(fs.read_file[r](at(dir, record_path(key))))

/// The bytes of the keys `bytes` lists, each once.
fn keys_in(bytes: Option<Bytes>) -> List<Bytes> =
  match bytes {
    None -> [],
    Some(b) ->
      map_keys(
        fold(range(0, bytes_len(b) / 32), map_new(), |acc: Map<Bytes, Bool>, i: Int|
          map_insert(acc, bytes_slice(b, i * 32, i * 32 + 32), true)),
      ),
  }

/// The marks the store in `dir` holds, by the key of the record each is on.
fn marks_in<[r]>(dir: String) -> Map<Bytes, List<Bytes>> / {fs.read[r], abort.raise} =
  fold(landed_in[r](marks_dir(dir)), map_new(), |acc: Map<Bytes, List<Bytes>>, n: String|
    if string_len(n) <= 65 || string_slice(n, 64, 65) != "-" { acc } else {
      let key = bytes_of_hex(string_slice(n, 0, 64));
      let mark = bytes_of_string(string_slice(n, 65, string_len(n)));
      map_insert(acc, key, push(match map_get(acc, key) { Some(ms) -> ms, None -> [] }, mark))
    })

fn mark_path(dir: String, key: Bytes, mark: Bytes) -> String / {abort.raise} =
  marks_dir(dir) ++ "/" ++ hex_of(key) ++ "-" ++ string_of_bytes_lossy(mark)

/// `work` run over the memo store in `dir`, with `look` answering what the world holds now: each
/// record it keeps written back as it is answered. Where `dir` holds no record under a key, a
/// read-only store laid out as this one is asked through `beside`, which reads a file of it by its
/// path within it. Where `trusted` says the world the run reads is the one that store was answered
/// over, as the shipped modules a binary carries are, its records stand as they are, neither held to
/// their reads nor copied into `dir`.
pub fn kept<a, [r] | e>(
  dir: String,
  beside: (String) -> Option<Bytes> / {abort.raise | e},
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_keep.read, memo_keep.write, abort.raise},
  trusted: Bool = false,
) -> a / {fs.read[r], fs.write[r], abort.raise | e} = {
  fs.create_dir[r](records_dir(dir));
  fs.create_dir[r](outputs_dir(dir));
  fs.create_dir[r](places_dir(dir));
  fs.create_dir[r](links_dir(dir));
  fs.create_dir[r](marks_dir(dir));
  fs.create_dir[r](holds_dir(dir));
  fs.create_dir[r](runs_dir(dir));
  // A directory of this run's own names what it marks and lands, so no two runs' names meet. A store
  // that takes no directory takes no write either, so the name it would have had is moot.
  let mine = fs.temp_dir[r](runs_dir(dir), "run");
  let token = match mine {
    Some(path) -> match list_at(string_split(path, "/"), len(string_split(path, "/")) - 1) {
      Some(t) -> t,
      None -> path,
    },
    None -> "unwritten",
  };
  let value = with_cell[minted](0) { minted ->
    with_cell[marking](marks_in[r](dir)) { marking ->
      with_cell[pending](no_pending()) { pending ->
        with_cell[heights](map_new()) { heights ->
          with_cell[inlined](map_new()) { inlined -> {
            let fresh = || {
              let n = cell_get(minted);
              cell_set(minted, n + 1);
              token ++ "." ++ int_to_string(n)
            };
            // `bytes` at `path`, landed whole: written beside it under a name of this run's, and renamed.
            let landed = |path: String, bytes: Bytes| {
              let tmp = path ++ "." ++ fresh() ++ ".tmp";
              if fs.write_file[r](tmp, bytes) {
                fs.rename[r](tmp, path);
                ()
              }
            };
            // What the run kept so far, written: each answer, then each read's new readers, then each
            // record, so a record is never there without the notes that mark it.
            let flushed = || {
              let p = cell_get(pending);
              map_fold(p.outputs, (), |_: Unit, digest: Bytes, output: Bytes| {
                let path = at(dir, output_path(digest));
                if !fs.exists[r](path) { landed(path, output) }
              });
              let filed = map_fold(
                p.links,
                map_new(),
                |acc: Map<String, Bytes>, id: Bytes, keys: Bytes| {
                  let path = links_path(dir, id);
                  let notes = notes_of(id, keys);
                  map_insert(acc, path, match map_get(acc, path) {
                    Some(b) -> bytes_concat(b, notes),
                    None -> notes,
                  })
                },
              );
              map_fold(filed, (), |_: Unit, path: String, notes: Bytes| {
                fs.append[r](path, notes);
                ()
              });
              map_fold(p.records, (), |_: Unit, key: Bytes, b: Bytes|
                landed(at(dir, record_path(key)), b));
              cell_set(pending, no_pending())
            };
            let held = |p: Pending| if p.size > pending_bound() { flushed() };
            // A record's bytes, or their first bytes, noted for the answer they hold, which the run
            // asks for next.
            let noted = |found: Option<Bytes>| {
              match found {
                Some(b) -> match ((output_named(b), inline_named(b))) {
                  (Some(d), Some(o)) -> cell_set(inlined, map_insert(cell_get(inlined), d, o)),
                  _ -> (),
                },
                None -> (),
              };
              found
            };
            // A record of the store beside, where it stands as it is.
            let trusted_at = |key: Bytes|
              if trusted { noted(beside(record_path(key))) } else { None };
            let record_bytes_at = |key: Bytes|
              match map_get(cell_get(pending).records, key) {
                Some(b) -> Some(b),
                None -> noted(fs.read_file[r](at(dir, record_path(key)))),
              };
            let value = handle {
              work()
            } with {
              memo_keep.head(key) -> match map_get(cell_get(pending).records, key) {
                Some(b) -> output_named(b),
                None -> match noted(fs.read_at[r](at(dir, record_path(key)), 0, head_bytes())) {
                  Some(b) -> {
                    // The head holds the height too, which a read of the record asks next.
                    cell_set(heights, map_insert(cell_get(heights), key, height_named(b)));
                    output_named(b)
                  },
                  None -> match trusted_at(key) {
                    Some(b) -> {
                      cell_set(heights, map_insert(cell_get(heights), key, height_named(b)));
                      output_named(b)
                    },
                    None -> None,
                  },
                },
              },
              memo_keep.height(key) -> match map_get(cell_get(pending).records, key) {
                Some(b) -> height_named(b),
                None -> match map_get(cell_get(heights), key) {
                  Some(h) -> h,
                  None -> match fs.read_at[r](at(dir, record_path(key)), 0, 9) {
                    Some(b) -> height_named(b),
                    None -> match trusted_at(key) { Some(b) -> height_named(b), None -> 0 },
                  },
                },
              },
              memo_keep.record(key) ->
                record_of(match record_bytes_at(key) {
                  Some(b) -> Some(b),
                  None -> trusted_at(key),
                }),
              memo_keep.packed(key) -> record_of(noted(beside(record_path(key)))),
              memo_keep.output(digest) -> match map_get(cell_get(pending).outputs, digest) {
                Some(o) -> Some(o),
                None -> match map_get(cell_get(inlined), digest) {
                  Some(o) -> Some(o),
                  None -> match fs.read_file[r](at(dir, output_path(digest))) {
                    Some(o) -> Some(o),
                    None -> beside(output_path(digest)),
                  },
                },
              },
              memo_keep.keep(key, rec, output) -> {
                cell_set(heights, map_remove(cell_get(heights), key));
                let p = cell_get(pending);
                let inline = kept_inline(output);
                let b = record_bytes(rec, inline);
                let next = match inline {
                  Some(o) -> {
                    cell_set(inlined, map_insert(cell_get(inlined), rec.output, o));
                    { ..p, records: map_insert(p.records, key, b), size: p.size + bytes_len(b) }
                  },
                  None ->
                    {
                      ..p,
                      records: map_insert(p.records, key, b),
                      outputs: map_insert(p.outputs, rec.output, output),
                      size: p.size + bytes_len(b) + bytes_len(output),
                    },
                };
                cell_set(pending, next);
                held(next)
              },
              memo_keep.adopt(key, rec) -> {
                cell_set(heights, map_remove(cell_get(heights), key));
                let p = cell_get(pending);
                // A packed answer its record holds is held by the adopted record too.
                let b = record_bytes(rec, map_get(cell_get(inlined), rec.output));
                let next = {
                  ..p,
                  records: map_insert(p.records, key, b),
                  size: p.size + bytes_len(b),
                };
                cell_set(pending, next);
                held(next)
              },
              memo_keep.now(kind, place) -> look(kind, place),
              memo_keep.places() -> match fs.list_dir[r](places_dir(dir)) {
                None -> [],
                Some(names) ->
                  fold(names, [], |acc: List<Seen>, n: String|
                    if string_ends_with(n, ".tmp") { acc } else {
                      match fs.read_file[r](places_dir(dir) ++ "/" ++ n) {
                        Some(b) -> match bin::decode(b, seen_bin()) {
                          Ok(s) -> push(acc, s),
                          Err(_) -> acc,
                        },
                        None -> acc,
                      }
                    }),
              },
              memo_keep.seen(id) -> match fs.read_file[r](named_in(places_dir(dir), id)) {
                Some(b) -> match bin::decode(b, seen_bin()) { Ok(s) -> Some(s), Err(_) -> None },
                None -> None,
              },
              memo_keep.see(id, s) ->
                landed(named_in(places_dir(dir), id), bin::encode(s, seen_bin())),
              memo_keep.readers(id) ->
                keys_in(
                  Some(
                    bytes_concat(
                      bytes_concat_all(readers_in(fs.read_file[r](links_path(dir, id)), id)),
                      match map_get(cell_get(pending).links, id) { Some(ks) -> ks, None -> b"" },
                    ),
                  ),
                ),
              memo_keep.link(id, key) -> {
                let p = cell_get(pending);
                let next = {
                  ..p,
                  links: map_insert(p.links, id, match map_get(p.links, id) {
                    Some(ks) -> bytes_concat(ks, key),
                    None -> key,
                  }),
                  size: p.size + 64,
                };
                cell_set(pending, next);
                held(next)
              },
              memo_keep.marks(key) -> match map_get(cell_get(marking), key) {
                Some(ms) -> ms,
                None -> [],
              },
              memo_keep.marked() -> {
                let now = marks_in[r](dir);
                cell_set(marking, now);
                map_fold(now, [], |acc: List<Bytes>, k: Bytes, ms: List<Bytes>|
                  if len(ms) == 0 { acc } else { push(acc, k) })
              },
              memo_keep.mark(key) -> {
                let m = bytes_of_string(fresh());
                fs.write_file[r](mark_path(dir, key, m), b"");
                let held = cell_get(marking);
                cell_set(
                  marking,
                  map_insert(
                    held,
                    key,
                    push(match map_get(held, key) { Some(ms) -> ms, None -> [] }, m),
                  ),
                )
              },
              memo_keep.unmark(key, gone) -> {
                fold(gone, (), |_: Unit, m: Bytes| {
                  fs.remove[r](mark_path(dir, key, m));
                  ()
                });
                let held = cell_get(marking);
                cell_set(
                  marking,
                  map_insert(
                    held,
                    key,
                    filter(match map_get(held, key) { Some(ms) -> ms, None -> [] }, |m: Bytes|
                      !contains(gone, m)),
                  ),
                )
              },
              memo_keep.forget(key) -> {
                let p = cell_get(pending);
                cell_set(pending, { ..p, records: map_remove(p.records, key) });
                fs.remove[r](at(dir, record_path(key)));
                let held = cell_get(marking);
                fold(
                  match map_get(held, key) { Some(ms) -> ms, None -> [] },
                  (),
                  |_: Unit, m: Bytes| {
                    fs.remove[r](mark_path(dir, key, m));
                    ()
                  },
                );
                cell_set(marking, map_remove(held, key))
              },
              memo_keep.hold(id) -> fs.lock[r](named_in(holds_dir(dir), id)),
              memo_keep.release(id) -> {
                fs.unlock[r](named_in(holds_dir(dir), id));
                ()
              },
            };
            flushed();
            value
          } }
        }
      }
    }
  };
  match mine {
    Some(path) -> {
      fs.remove[r](path);
      ()
    },
    None -> (),
  };
  value
}

/// The store `to` made to hold the records under each of `keys` in the store `from`, the answers they
/// name, and nothing else. An answer `to` holds already is not written again, its name being its
/// digest, so a store kept between copies is written what moved. How many records it holds.
pub fn copied<[r], [w]>(
  from: String,
  to: String,
  keys: List<Bytes>,
) -> Int / {fs.read[r], fs.read[w], fs.write[w], abort.raise} = {
  fs.create_dir[w](records_dir(to));
  fs.create_dir[w](outputs_dir(to));
  let landed = |path: String, bytes: Bytes| {
    let tmp = path ++ ".tmp";
    fs.write_file[w](tmp, bytes) && fs.rename[w](tmp, path)
  };
  let held = fold(
    keys,
    { records: map_new(), outputs: map_new() },
    |acc: { records: Map<String, Bool>, outputs: Map<String, Bool> }, key: Bytes| {
      let bytes = fs.read_file[r](at(from, record_path(key)));
      match ((bytes, record_of(bytes))) {
        (Some(b), Some(rec)) -> {
          let output = output_path(rec.output);
          let inside = inline_named(b) != None;
          let there = inside || fs.exists[w](at(to, output))
            || (match fs.read_file[r](at(from, output)) {
              Some(o) -> landed(at(to, output), o),
              None -> false,
            });
          if !there { acc } else {
            let record = record_path(key);
            if fs.read_file[w](at(to, record)) != Some(b) {
              landed(at(to, record), b);
              ()
            };
            {
              records: map_insert(acc.records, record, true),
              outputs: if inside { acc.outputs } else { map_insert(acc.outputs, output, true) },
            }
          }
        },
        _ -> acc,
      }
    },
  );
  let swept = |sub: String, kept: Map<String, Bool>|
    fold(landed_in[w](at(to, sub)), (), |_: Unit, name: String|
      if !map_contains(kept, sub ++ "/" ++ name) {
        fs.remove[w](at(to, sub ++ "/" ++ name));
        ()
      });
  swept("records", held.records);
  swept("outputs", held.outputs);
  map_len(held.records)
}

/// What the store in `dir` holds: its records, the answers kept inside or beside them and their
/// bytes, and the bytes of the answers no record names, which compaction reclaims.
pub type Usage = { records: Int, answers: Int, answer_bytes: Int, unread_bytes: Int }

/// The names of the files in `sub` of `dir` that landed whole.
fn landed_in<[r]>(sub: String) -> List<String> / {fs.read[r]} =
  match fs.list_dir[r](sub) {
    Some(names) -> filter(names, |n: String| !string_ends_with(n, ".tmp")),
    None -> [],
  }

/// Each record of the store in `dir` that reads back, by the name of its file, beside the bytes of
/// the answer it holds inside it.
fn records_in<[r]>(
  dir: String,
) -> List<{ name: String, record: Record, inside: Option<Int> }> / {fs.read[r], abort.raise} =
  fold(
    landed_in[r](records_dir(dir)),
    [],
    |acc: List<{ name: String, record: Record, inside: Option<Int> }>, n: String| {
      let bytes = fs.read_file[r](records_dir(dir) ++ "/" ++ n);
      match bytes {
        None -> acc,
        Some(b) -> match record_from(b) {
          Some(rec) ->
            push(acc, {
              name: n,
              record: rec,
              inside: match inline_named(b) { Some(o) -> Some(bytes_len(o)), None -> None },
            }),
          None -> acc,
        },
      }
    },
  )

fn named_digests(
  records: List<{ name: String, record: Record, inside: Option<Int> }>,
) -> Map<String, Bool> / {abort.raise} =
  fold(
    records,
    map_new(),
    |acc: Map<String, Bool>, r: { name: String, record: Record, inside: Option<Int> }|
      map_insert(acc, hex_of(r.record.output), true),
  )

pub fn usage<[r]>(dir: String) -> Usage / {fs.read[r], abort.raise} = {
  let records = records_in[r](dir);
  let named = named_digests(records);
  let sized = |name: String|
    match fs.file_size[r](outputs_dir(dir) ++ "/" ++ name) { Some(n) -> n, None -> 0 };
  let inside = fold(
    records,
    { answers: 0, bytes: 0 },
    |acc: { answers: Int, bytes: Int }, x: { name: String, record: Record, inside: Option<Int> }|
      match x.inside { Some(n) -> { answers: acc.answers + 1, bytes: acc.bytes + n }, None -> acc },
  );
  fold(
    landed_in[r](outputs_dir(dir)),
    { records: len(records), answers: inside.answers, answer_bytes: inside.bytes, unread_bytes: 0 },
    |u: Usage, name: String| {
      let n = sized(name);
      {
        ..u,
        answers: u.answers + 1,
        answer_bytes: u.answer_bytes + n,
        unread_bytes: if map_contains(named, name) { u.unread_bytes } else { u.unread_bytes + n },
      }
    },
  )
}

/// What a compaction dropped: records it did not keep, and answers no record names.
pub type Compacted = { records: Int, answers: Int, bytes: Int }

/// Drops every record `keeps` does not keep, asked with the hex of its key, and then every answer no
/// record left names. A dropped record is answered again by the next run that asks it.
pub fn compacted<[r]>(
  dir: String,
  keeps: (String, Record) -> Bool,
) -> Compacted / {fs.read[r], fs.write[r], abort.raise} = {
  let all = records_in[r](dir);
  let kept = filter(all, |x: { name: String, record: Record, inside: Option<Int> }|
    keeps(x.name, x.record));
  let gone = fold(all, 0, |n: Int, x: { name: String, record: Record, inside: Option<Int> }|
    if keeps(x.name, x.record) || !fs.remove[r](records_dir(dir) ++ "/" ++ x.name) { n }
    else { n + 1 });
  let named = named_digests(kept);
  let dropped = fold(
    landed_in[r](outputs_dir(dir)),
    { answers: 0, bytes: 0 },
    |acc: { answers: Int, bytes: Int }, name: String|
      if map_contains(named, name) { acc } else {
        let path = outputs_dir(dir) ++ "/" ++ name;
        let n = match fs.file_size[r](path) { Some(x) -> x, None -> 0 };
        if fs.remove[r](path) { { answers: acc.answers + 1, bytes: acc.bytes + n } } else { acc }
      },
  );
  { records: gone, answers: dropped.answers, bytes: dropped.bytes }
}

test "a copy leaves its store holding the records asked for and their answers, and nothing else" {
  let record = |answer: Bytes|
    record_bytes(
      { query: b"q", input: b"", reads: [], output: digest_of(Some(answer)), height: 1 },
      None,
    );
  let answer_at = |store: String, answer: Bytes|
    store ++ "/" ++ output_path(digest_of(Some(answer)));
  let tree = fs::mem_of([
    { path: "from/" ++ record_path(b"kept"), body: record(b"one") },
    { path: answer_at("from", b"one"), body: b"one" },
    { path: "from/" ++ record_path(b"unasked"), body: record(b"two") },
    { path: answer_at("from", b"two"), body: b"two" },
    { path: "to/" ++ record_path(b"stale"), body: record(b"old") },
    { path: answer_at("to", b"old"), body: b"old" },
  ]);
  let first = fs::on_mem[abs](tree, || copied[abs, abs]("from", "to", [b"kept"]));
  assert_eq(first.value, 1);
  assert_eq(fs::mem_list(first.tree, "to/records"), Some([hex_of(b"kept")]));
  assert_eq(fs::mem_read(first.tree, answer_at("to", b"one")), Some(b"one"));
  assert_eq(fs::mem_read(first.tree, answer_at("to", b"old")), None);
  // An answer the store holds is named by its digest, so a copy does not write it again.
  let held = fs::mem_write(first.tree, answer_at("to", b"one"), b"as held").fs;
  let again = fs::on_mem[abs](held, || copied[abs, abs]("from", "to", [b"kept"]));
  assert_eq(fs::mem_read(again.tree, answer_at("to", b"one")), Some(b"as held"))
}

test "a links file names the readers of each id it notes, and only theirs" {
  let id = |c: Bytes| bytes_concat_all(map(range(0, 32), |_: Int| c));
  let file = bytes_concat_all([
    notes_of(id(b"x"), bytes_concat(id(b"a"), id(b"b"))),
    notes_of(id(b"y"), id(b"c")),
    notes_of(id(b"x"), id(b"a")),
  ]);
  assert_eq(readers_in(Some(file), id(b"x")), [id(b"a"), id(b"b"), id(b"a")]);
  assert_eq(readers_in(Some(file), id(b"y")), [id(b"c")]);
  assert_eq(readers_in(Some(file), id(b"z")), []);
  // A note cut short, as a full disk leaves one, names no reader.
  assert_eq(readers_in(Some(bytes_slice(file, 0, bytes_len(file) - 1)), id(b"x")), [
    id(b"a"),
    id(b"b"),
  ]);
  assert_eq(readers_in(None, id(b"x")), [])
}

test "a readers file's keys are each read once" {
  let key = |c: Bytes| bytes_concat_all(map(range(0, 32), |_: Int| c));
  assert_eq(keys_in(Some(bytes_concat_all([key(b"b"), key(b"a"), key(b"b"), key(b"a")]))), [
    key(b"a"),
    key(b"b"),
  ]);
  assert_eq(keys_in(None), [])
}
