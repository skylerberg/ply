// The parser's spine: token access, threaded state, diagnostics, the sequence driver, the dump encoder.
// Rule: a parse function answers `Result<R<Thing>, P>` and propagates with `?`, except around a
// save/restore of `no_brace` or `no_pipe`, which is a `match` so both paths restore.
// Rule: a sequence is one `iterate`, never recursion; recursion is reserved for grammar nesting, and
// a rule that nests spends one of `Input.room`.
// Rule: the growing field is last in every record literal (`SoFar.out`, `Parser.diags`), or accumulation
// turns quadratic; build a `Parser` only through the constructors below.

import lexer
import std.bin

// --- Spans, names -----------------------------------------------------------

pub type Span = { start: Int, end: Int }

derive bin for Span

pub type Ident = { name: Bytes, span: Span }

pub type QName = { module: Option<Ident>, name: Ident, span: Span }

pub fn dummy_span() -> Span = { start: 0, end: 0 }

pub fn span_between(s: Int, e: Int) -> Span = { start: s, end: e }

pub fn span_to(a: Span, b: Span) -> Span =
  {
    start: if a.start < b.start { a.start } else { b.start },
    end: if a.end > b.end { a.end } else { b.end },
  }

// A span as the key a table of per-site facts is read by.
pub fn span_key(span: Span) -> Bytes =
  bytes_concat_all([int_to_bytes(span.start), b":", int_to_bytes(span.end)])

pub fn no_ident() -> Ident = { name: b"", span: dummy_span() }

pub fn no_qname() -> QName = { module: None, name: no_ident(), span: dummy_span() }

pub fn bare(ident: Ident) -> QName = { module: None, name: ident, span: ident.span }

pub fn qualified(m: Ident, n: Ident) -> QName =
  { module: Some(m), name: n, span: span_to(m.span, n.span) }

// --- Diagnostics ------------------------------------------------------------

// `notes` is always `len(notes_text)`.
pub type Label = { start: Int, end: Int, primary: Bool, text: Bytes }

pub type ParseDiag = {
  code: Bytes,
  notes: Int,
  labels: List<Label>,
  message: Bytes,
  notes_text: List<Bytes>,
  severity: Bytes,
}

pub fn unexpected() -> Bytes = b"E0001"
pub fn unterminated() -> Bytes = b"E0002"
pub fn duplicate_definition() -> Bytes = b"E0105"
pub fn unknown_effect_set() -> Bytes = b"E0114"
pub fn effect_set_cycle() -> Bytes = b"E0115"
pub fn unknown_deriver() -> Bytes = b"E0207"
pub fn default_not_allowed() -> Bytes = b"E0120"
pub fn unknown_argument_name() -> Bytes = b"E0123"
pub fn argument_order() -> Bytes = b"E0124"

pub fn parse_label(span: Span, primary: Bool, text: Bytes) -> Label =
  { start: span.start, end: span.end, primary: primary, text: text }

pub fn parse_diag(
  code: Bytes,
  message: Bytes,
  labels: List<Label>,
  notes: List<Bytes>,
) -> ParseDiag =
  {
    code: code,
    notes: len(notes),
    labels: labels,
    message: message,
    notes_text: notes,
    severity: b"error",
  }

pub fn error_at(
  code: Bytes,
  span: Span,
  message: Bytes,
  label: Bytes,
  notes: List<Bytes>,
) -> ParseDiag = parse_diag(code, message, [parse_label(span, true, label)], notes)

pub fn error_at_and(
  code: Bytes,
  span: Span,
  message: Bytes,
  label: Bytes,
  also: Span,
  also_text: Bytes,
  notes: List<Bytes>,
) -> ParseDiag =
  parse_diag(
    code,
    message,
    [parse_label(span, true, label), parse_label(also, false, also_text)],
    notes,
  )

pub fn primary_span_of(diag: ParseDiag) -> Span = {
  let first = fold(
    diag.labels,
    { seen: false, s: dummy_span() },
    |a: { seen: Bool, s: Span }, label: Label|
      if a.seen { a } else { { seen: true, s: { start: label.start, end: label.end } } },
  );
  let prim = fold(
    diag.labels,
    { seen: false, s: dummy_span() },
    |a: { seen: Bool, s: Span }, label: Label|
      if a.seen || !label.primary { a }
      else { { seen: true, s: { start: label.start, end: label.end } } },
  );
  if prim.seen { prim.s } else { first.s }
}

// --- The token buffer -------------------------------------------------------

// What a parse reads, which flows down into what it parses: the tokens, and `room`, how many levels
// deeper the grammar may nest from here, which every rule that nests spends one of.
pub type Input = { token_count: Int, source: Bytes, tokens: List<lexer::Token>, room: Int }

// `gt_split` is the index where `expect_gt` split a `>=`: `token_index` reads it as `=` over its
// second byte. One slot suffices because `pos` must pass a split before another can happen.
pub type Parser = {
  pos: Int,
  no_brace: Bool,
  // Inside a lambda's parameter list, `|` closes the list and is never bit-or.
  no_pipe: Bool,
  gt_split: Int,
  diags: List<ParseDiag>,
}

pub type Parsed<a> = { parser: Parser, node: a }

pub type Eaten = { parser: Parser, ok: Bool }

pub type SoFar<a> = { parser: Parser, out: List<a> }

pub type ParseStart = { input: Input, parser: Parser }

pub fn start(src: Bytes) -> ParseStart / {abort.raise} = {
  let lx = lexer::lex(src);
  let d = map(lx.diags, |diag: lexer::Diag|
    error_at(diag.code, { start: diag.start, end: diag.end }, diag.message, diag.label, []));
  {
    input: { token_count: len(lx.tokens), source: src, tokens: lx.tokens, room: max_depth() },
    parser: { pos: 0, no_brace: false, no_pipe: false, gt_split: -1, diags: d },
  }
}

// --- Constructing `Parser` -------------------------------------------------------

pub fn at_pos(parser: Parser, pos: Int) -> Parser =
  {
    no_brace: parser.no_brace,
    no_pipe: parser.no_pipe,
    gt_split: parser.gt_split,
    pos: pos,
    diags: parser.diags,
  }

pub fn with_no_brace(parser: Parser, b: Bool) -> Parser =
  {
    pos: parser.pos,
    no_pipe: parser.no_pipe,
    gt_split: parser.gt_split,
    no_brace: b,
    diags: parser.diags,
  }

pub fn with_no_pipe(parser: Parser, b: Bool) -> Parser =
  {
    pos: parser.pos,
    no_brace: parser.no_brace,
    gt_split: parser.gt_split,
    no_pipe: b,
    diags: parser.diags,
  }

pub fn with_gt_split(parser: Parser, i: Int) -> Parser =
  {
    pos: parser.pos,
    no_brace: parser.no_brace,
    no_pipe: parser.no_pipe,
    gt_split: i,
    diags: parser.diags,
  }

pub fn fresh_item(parser: Parser) -> Parser =
  {
    pos: parser.pos,
    no_pipe: parser.no_pipe,
    gt_split: parser.gt_split,
    no_brace: false,
    diags: parser.diags,
  }

pub fn advance_n(input: Input, parser: Parser, n: Int) -> Parser =
  if n <= 0 { parser } else { advance_n(input, advance(input, parser).parser, n - 1) }

// Drops a diagnostic with the same code and primary span as the previous one: one mistake trips several expectations.
pub fn push_diag(parser: Parser, diag: ParseDiag) -> Parser = {
  let s = primary_span_of(diag);
  let dup = match list_at(parser.diags, len(parser.diags) - 1) {
    Some(l) -> {
      let ls = primary_span_of(l);
      l.code == diag.code && ls.start == s.start && ls.end == s.end
    },
    None -> false,
  };
  if dup { parser } else {
    {
      pos: parser.pos,
      no_brace: parser.no_brace,
      no_pipe: parser.no_pipe,
      gt_split: parser.gt_split,
      diags: push(parser.diags, diag),
    }
  }
}

// Where `?` cannot stand (tests, lambdas): `parsed_or` answers the state either way; `failed` says which arm.
pub fn parsed_or<a>(r: Result<Parsed<a>, Parser>, d: a) -> Parsed<a> =
  match r { Ok(x) -> x, Err(q) -> { parser: q, node: d } }

pub fn failed<a>(r: Result<Parsed<a>, Parser>) -> Bool = match r { Ok(x) -> false, Err(q) -> true }

// --- Token access -----------------------------------------------------------

fn eof_token() -> lexer::Token = { start: 0, end: 0, kind: lexer::EndOfInput }

// Absolute index, clamped to the buffer (the clamped token is observable), with `expect_gt`'s split applied.
pub fn token_index(input: Input, parser: Parser, i: Int) -> lexer::Token = {
  let j = if i < 0 { 0 } else if i > input.token_count - 1 { input.token_count - 1 } else { i };
  let t = match list_at(input.tokens, j) { Some(x) -> x, None -> eof_token() };
  if j == parser.gt_split { { start: t.start + 1, end: t.end, kind: lexer::Punctuation(b"eq") } }
  else { t }
}

pub fn token_at(input: Input, parser: Parser, n: Int) -> lexer::Token =
  token_index(input, parser, parser.pos + n)

pub fn token_kind(input: Input, parser: Parser) -> lexer::TokenKind =
  token_at(input, parser, 0).kind

pub fn token_kind_at(input: Input, parser: Parser, n: Int) -> lexer::TokenKind =
  token_at(input, parser, n).kind

pub fn span_at(input: Input, parser: Parser, n: Int) -> Span = {
  let t = token_at(input, parser, n);
  { start: t.start, end: t.end }
}

pub fn current_span(input: Input, parser: Parser) -> Span = span_at(input, parser, 0)

pub fn previous_span(input: Input, parser: Parser) -> Span = {
  let t = token_index(input, parser, parser.pos - 1);
  { start: t.start, end: t.end }
}

pub fn token_bytes(input: Input, token: lexer::Token) -> Bytes / {abort.raise} =
  bytes_slice(input.source, token.start, token.end)

// Answers the current span and moves on, except at the last token, where it stays.
pub fn advance(input: Input, parser: Parser) -> Parsed<Span> =
  {
    parser: if parser.pos + 1 < input.token_count { at_pos(parser, parser.pos + 1) }
    else { parser },
    node: current_span(input, parser),
  }

pub fn at_token(input: Input, parser: Parser, kind: lexer::TokenKind) -> Bool =
  token_kind(input, parser) == kind

pub fn at_eof(input: Input, parser: Parser) -> Bool = token_kind(input, parser) == lexer::EndOfInput

pub fn at_ident_text(input: Input, parser: Parser, text: Bytes) -> Bool =
  token_kind(input, parser) == lexer::Identifier(text)

// Constructor versus binder. ASCII suffices: the lexer refuses a token whose first byte is >= 128.
pub fn starts_upper(name: Bytes) -> Bool / {abort.raise} =
  bytes_len(name) > 0 && bytes_at(name, 0) >= 65 && bytes_at(name, 0) <= 90

pub fn is_str(input: Input, parser: Parser) -> Bool =
  match token_kind(input, parser) { lexer::StringLiteral(v) -> true, _ -> false }

pub fn bump(input: Input, parser: Parser) -> Parser = advance(input, parser).parser

pub fn dump_bool(b: Bool) -> Bytes = if b { dump_word(b"true") } else { dump_word(b"false") }

pub fn is_ident(input: Input, parser: Parser) -> Bool =
  match token_kind(input, parser) { lexer::Identifier(n) -> true, _ -> false }

// --- Expecting --------------------------------------------------------------

pub fn eat(input: Input, parser: Parser, kind: lexer::TokenKind) -> Eaten =
  if at_token(input, parser, kind) { { parser: advance(input, parser).parser, ok: true } }
  else { { parser: parser, ok: false } }

// How a diagnostic names the token it found.
pub fn describe(kind: lexer::TokenKind) -> Bytes / {abort.raise} =
  match kind {
    lexer::Identifier(n) -> bytes_concat_all([b"identifier `", n, b"`"]),
    lexer::IntLiteral(v) -> bytes_concat_all([b"integer `", int_to_bytes(v), b"`"]),
    lexer::FixedLiteral(ty, v) ->
      bytes_concat_all([b"`", ty, b"` literal `", int_to_bytes(v), b"`"]),
    lexer::WideLiteral(ty, high, low) ->
      bytes_concat_all([
        b"`",
        ty,
        b"` literal `",
        lexer::wide_decimal(ty == b"I128", high, low),
        b"`",
      ]),
    lexer::FloatLiteral(txt) -> bytes_concat_all([b"float `", float_display(txt), b"`"]),
    lexer::DecimalLiteral(m, sc) -> bytes_concat_all([b"decimal `", render_decimal(m, sc), b"`"]),
    lexer::StringLiteral(_) -> b"string literal",
    lexer::LineString(_) -> b"line string",
    lexer::BytesLiteral(_) -> b"byte-string literal",
    lexer::InterpolatedHead(_) -> b"interpolated string",
    lexer::InterpolatedMiddle(_) -> b"`}` closing an interpolated value",
    lexer::InterpolatedTail(_) -> b"`}` closing an interpolated value",
    lexer::CharLiteral(_) -> b"character literal",
    lexer::Keyword(k) -> bytes_concat_all([b"keyword `", k, b"`"]),
    lexer::EndOfInput -> b"end of file",
    lexer::Punctuation(name) -> bytes_concat_all([b"`", punct_text(name), b"`"]),
  }

// A table, not an `else if` chain: a long chain overflows the native stack when the emitter compiles itself.
fn punct_text(name: Bytes) -> Bytes = {
  let table = [
    { n: b"lparen", t: b"(" },
    { n: b"rparen", t: b")" },
    { n: b"lbrace", t: b"{" },
    { n: b"rbrace", t: b"}" },
    { n: b"lbracket", t: b"[" },
    { n: b"rbracket", t: b"]" },
    { n: b"comma", t: b"," },
    { n: b"semi", t: b";" },
    { n: b"colon", t: b":" },
    { n: b"coloncolon", t: b"::" },
    { n: b"dot", t: b"." },
    { n: b"dotdot", t: b".." },
    { n: b"underscore", t: b"_" },
    { n: b"arrow", t: b"->" },
    { n: b"eq", t: b"=" },
    { n: b"eqeq", t: b"==" },
    { n: b"bang", t: b"!" },
    { n: b"bangeq", t: b"!=" },
    { n: b"lt", t: b"<" },
    { n: b"le", t: b"<=" },
    { n: b"gt", t: b">" },
    { n: b"ge", t: b">=" },
    { n: b"plus", t: b"+" },
    { n: b"plusplus", t: b"++" },
    { n: b"minus", t: b"-" },
    { n: b"star", t: b"*" },
    { n: b"slash", t: b"/" },
    { n: b"percent", t: b"%" },
    { n: b"amp", t: b"&" },
    { n: b"ampamp", t: b"&&" },
    { n: b"caret", t: b"^" },
    { n: b"pipe", t: b"|" },
    { n: b"pipepipe", t: b"||" },
    { n: b"tilde", t: b"~" },
    { n: b"hashbrace", t: b"#{" },
    { n: b"hashbracket", t: b"#[" },
    { n: b"question", t: b"?" },
  ];
  fold(table, b"", |acc: Bytes, e: { n: Bytes, t: Bytes }| if e.n == name { e.t } else { acc })
}

// The mantissa's digits with the point `scale` places from the end.
pub fn render_decimal(digits: Bytes, scale: Int) -> Bytes / {abort.raise} =
  if scale == 0 { digits } else {
    let padded = if bytes_len(digits) <= scale {
      bytes_concat(
        bytes_concat_all(map(range(0, scale - bytes_len(digits) + 1), |_: Int| b"0")),
        digits,
      )
    } else { digits };
    let point = bytes_len(padded) - scale;
    bytes_concat_all([
      bytes_slice(padded, 0, point),
      b".",
      bytes_slice(padded, point, bytes_len(padded)),
    ])
  }

// `f64`'s `Display` over literal text: zeros trimmed, exponent applied; exact up to 17 significant digits.
pub fn float_display(txt: Bytes) -> Bytes / {abort.raise} = {
  let n = bytes_len(txt);
  let e_at = match bytes_index_of(txt, b"e") { Some(i) -> i, None -> n };
  let mantissa = bytes_slice(txt, 0, e_at);
  let exp = if e_at == n { 0 } else { int_of_signed(bytes_slice(txt, e_at + 1, n)) };
  let dot = match bytes_index_of(mantissa, b".") { Some(i) -> i, None -> bytes_len(mantissa) };
  let whole = bytes_slice(mantissa, 0, dot);
  let frac = if dot == bytes_len(mantissa) { b"" }
  else { bytes_slice(mantissa, dot + 1, bytes_len(mantissa)) };
  let digits = bytes_concat(whole, frac);
  let point = bytes_len(whole) + exp;
  let lead = bytes_scan(digits, 0, b"0", bytes_len(digits));
  let trail = trailing_zeros(digits);
  if lead == bytes_len(digits) { b"0" } else {
    let sig = bytes_slice(digits, lead, bytes_len(digits) - trail);
    let parser = point - lead;
    if parser <= 0 {
      bytes_concat_all([b"0.", bytes_concat_all(map(range(0, 0 - parser), |_: Int| b"0")), sig])
    } else if parser >= bytes_len(sig) {
      bytes_concat(sig, bytes_concat_all(map(range(0, parser - bytes_len(sig)), |_: Int| b"0")))
    } else {
      bytes_concat_all([
        bytes_slice(sig, 0, parser),
        b".",
        bytes_slice(sig, parser, bytes_len(sig)),
      ])
    }
  }
}

fn trailing_zeros(b: Bytes) -> Int / {abort.raise} =
  fold(range(0, bytes_len(b)), 0, |acc: Int, i: Int|
    if bytes_at(b, bytes_len(b) - 1 - i) == 48 && acc == i { acc + 1 } else { acc })

fn int_of_signed(b: Bytes) -> Int / {abort.raise} =
  if bytes_len(b) == 0 { 0 }
  else if bytes_at(b, 0) == 45 { 0 - int_of_digits(bytes_slice(b, 1, bytes_len(b))) }
  else if bytes_at(b, 0) == 43 { int_of_digits(bytes_slice(b, 1, bytes_len(b))) }
  else { int_of_digits(b) }

fn int_of_digits(d: Bytes) -> Int / {abort.raise} =
  fold(range(0, bytes_len(d)), 0, |a: Int, i: Int| a * 10 + (bytes_at(d, i) - 48))

pub fn error_here(input: Input, parser: Parser, what: Bytes) -> Parser / {abort.raise} =
  push_diag(
    parser,
    error_at(
      unexpected(),
      current_span(input, parser),
      bytes_concat_all([b"expected ", what, b", found ", describe(token_kind(input, parser))]),
      bytes_concat(b"expected ", what),
      [],
    ),
  )

pub fn unclosed(input: Input, parser: Parser, open: Span, what: Bytes) -> Parser / {abort.raise} =
  push_diag(
    parser,
    error_at_and(
      unexpected(),
      current_span(input, parser),
      bytes_concat_all([b"expected ", what, b", found ", describe(token_kind(input, parser))]),
      bytes_concat(b"expected ", what),
      open,
      b"unclosed delimiter opened here",
      [],
    ),
  )

pub fn expect(
  input: Input,
  parser: Parser,
  kind: lexer::TokenKind,
  what: Bytes,
) -> Result<Parsed<Span>, Parser> / {abort.raise} =
  if at_token(input, parser, kind) { Ok(advance(input, parser)) }
  else { Err(error_here(input, parser, what)) }

pub fn expect_close(
  input: Input,
  parser: Parser,
  kind: lexer::TokenKind,
  open: Span,
  what: Bytes,
) -> Result<Parsed<Span>, Parser> / {abort.raise} =
  if at_token(input, parser, kind) { Ok(advance(input, parser)) }
  else { Err(unclosed(input, parser, open, what)) }

pub fn expect_ident(
  input: Input,
  parser: Parser,
  what: Bytes,
) -> Result<Parsed<Ident>, Parser> / {abort.raise} =
  match token_kind(input, parser) {
    lexer::Identifier(n) -> {
      let a = advance(input, parser);
      Ok({ parser: a.parser, node: { name: n, span: a.node } })
    },
    _ -> Err(error_here(input, parser, what)),
  }

// A parameter name, or `_` for one the body never names: it binds like any other name and is
// unreachable only because `_` never lexes as an identifier in expression position.
pub fn expect_binder(
  input: Input,
  parser: Parser,
  what: Bytes,
) -> Result<Parsed<Ident>, Parser> / {abort.raise} =
  match token_kind(input, parser) {
    lexer::Identifier(n) -> {
      let a = advance(input, parser);
      Ok({ parser: a.parser, node: { name: n, span: a.node } })
    },
    lexer::Punctuation(s) -> if s == b"underscore" {
      let a = advance(input, parser);
      Ok({ parser: a.parser, node: { name: b"_", span: a.node } })
    } else { Err(error_here(input, parser, what)) },
    _ -> Err(error_here(input, parser, what)),
  }

// A keyword may name a field; `keyword` flags it for the punned forms that also bind a variable.
pub fn expect_field_name(
  input: Input,
  parser: Parser,
  what: Bytes,
) -> Result<Parsed<{ name: Ident, keyword: Bool }>, Parser> / {abort.raise} =
  match token_kind(input, parser) {
    lexer::Identifier(n) -> {
      let a = advance(input, parser);
      Ok({ parser: a.parser, node: { name: { name: n, span: a.node }, keyword: false } })
    },
    lexer::Keyword(k) -> {
      let a = advance(input, parser);
      Ok({ parser: a.parser, node: { name: { name: k, span: a.node }, keyword: true } })
    },
    _ -> Err(error_here(input, parser, what)),
  }

pub fn keyword_pun_refusal(parser: Parser, name: Ident) -> Parser =
  push_diag(
    parser,
    error_at(
      unexpected(),
      name.span,
      bytes_concat_all([
        b"`",
        name.name,
        b"` names a field here, and a bare field also names a variable",
      ]),
      b"a keyword cannot name a variable",
      [
        bytes_concat_all([
          b"write `",
          name.name,
          b": ",
          name.name,
          b"_` with a name of your own on the right",
        ]),
      ],
    ),
  )

// On `>=`, answers the `>` and leaves `pos`, with `gt_split` turning the rest into `=`.
pub fn expect_gt(
  input: Input,
  parser: Parser,
  what: Bytes,
) -> Result<Parsed<Span>, Parser> / {abort.raise} =
  if at_token(input, parser, token_gt()) { Ok(advance(input, parser)) }
  else if at_token(input, parser, token_ge()) {
    let s = current_span(input, parser);
    Ok({ parser: with_gt_split(parser, parser.pos), node: { start: s.start, end: s.start + 1 } })
  } else { Err(error_here(input, parser, what)) }

// --- Depth ------------------------------------------------------------------

pub fn max_depth() -> Int = 128

// Where a rule would nest once more than `max_depth()` allows.
pub fn too_deep(input: Input, parser: Parser) -> Parser =
  push_diag(
    parser,
    error_at(
      unexpected(),
      current_span(input, parser),
      b"input is nested too deeply to parse",
      bytes_concat_all([b"more than ", int_to_bytes(max_depth()), b" levels of nesting"]),
      [b"split this into smaller definitions"],
    ),
  )

// --- The shared sequence driver ---------------------------------------------

pub fn comma_list<a | e>(
  input: Input,
  parser: Parser,
  close: lexer::TokenKind,
  item: (Input, Parser) -> Result<Parsed<a>, Parser> / e,
) -> Result<Parsed<List<a>>, Parser> / {abort.raise | e} =
  iterate({ parser: parser, out: [] }, input.token_count - parser.pos + 1, |s: SoFar<a>|
    if at_token(input, s.parser, close) || at_eof(input, s.parser) {
      Stop(Ok({ parser: s.parser, node: s.out }))
    } else {
      match item(input, s.parser) {
        Err(q) -> Stop(Err(q)),
        Ok(r) -> {
          let e = eat(input, r.parser, token_comma());
          if e.ok { Continue({ parser: e.parser, out: push(s.out, r.node) }) }
          else { Stop(Ok({ parser: e.parser, node: push(s.out, r.node) })) }
        },
      }
    })

// --- Qualified names --------------------------------------------------------

pub fn qname(
  input: Input,
  parser: Parser,
  what: Bytes,
) -> Result<Parsed<QName>, Parser> / {abort.raise} = {
  let { parser, node: first } = expect_ident(input, parser, what)?;
  let cc = eat(input, parser, token_coloncolon());
  if !cc.ok { Ok({ parser: cc.parser, node: bare(first) }) } else {
    let { parser, node: second } = expect_ident(input, cc.parser, b"a name after `::`")?;
    if at_token(input, parser, token_coloncolon()) {
      Err(
        push_diag(
          parser,
          error_at(
            unexpected(),
            current_span(input, parser),
            b"a qualified name has at most one `::`",
            b"unexpected `::`",
            [
              b"a module binder is a single name: `import store.orders` binds `orders`, so write `orders::place`",
            ],
          ),
        ),
      )
    } else { Ok({ parser: parser, node: qualified(first, second) }) }
  }
}

// --- The token vocabulary ---------------------------------------------------

pub fn token_lparen() -> lexer::TokenKind = lexer::Punctuation(b"lparen")
pub fn token_rparen() -> lexer::TokenKind = lexer::Punctuation(b"rparen")
pub fn token_lbrace() -> lexer::TokenKind = lexer::Punctuation(b"lbrace")
pub fn token_rbrace() -> lexer::TokenKind = lexer::Punctuation(b"rbrace")
