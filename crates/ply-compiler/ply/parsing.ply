pub fn token_eqeq() -> lexer::TokenKind = lexer::Punctuation(b"eqeq")
pub fn token_bang() -> lexer::TokenKind = lexer::Punctuation(b"bang")
pub fn token_bangeq() -> lexer::TokenKind = lexer::Punctuation(b"bangeq")
pub fn token_lt() -> lexer::TokenKind = lexer::Punctuation(b"lt")
pub fn token_amp() -> lexer::TokenKind = lexer::Punctuation(b"amp")
pub fn token_caret() -> lexer::TokenKind = lexer::Punctuation(b"caret")
pub fn token_tilde() -> lexer::TokenKind = lexer::Punctuation(b"tilde")
pub fn token_hashbrace() -> lexer::TokenKind = lexer::Punctuation(b"hashbrace")
pub fn token_hashbracket() -> lexer::TokenKind = lexer::Punctuation(b"hashbracket")
pub fn token_le() -> lexer::TokenKind = lexer::Punctuation(b"le")
pub fn token_gt() -> lexer::TokenKind = lexer::Punctuation(b"gt")
pub fn token_ge() -> lexer::TokenKind = lexer::Punctuation(b"ge")
