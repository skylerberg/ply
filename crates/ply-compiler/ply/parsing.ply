// --- The dump encoder -------------------------------------------------------
// Printable ASCII with no `"` and no `\`: the dump is read back through `ply run --json`'s escaping.

pub fn int_to_bytes(i: Int) -> Bytes = bytes_of_string(int_to_string(i))

pub fn dump_node(span: Span, tag: Bytes) -> Bytes =
  bytes_concat_all([int_to_bytes(span.start), b":", int_to_bytes(span.end), b":", tag, b";"])

pub fn dump_count(k: Int) -> Bytes = bytes_concat_all([b"#", int_to_bytes(k), b";"])

pub fn dump_presence(present: Bool) -> Bytes = if present { b"?1;" } else { b"?0;" }

pub fn dump_word(w: Bytes) -> Bytes = bytes_concat_all([b"%", w, b";"])

pub fn dump_payload(b: Bytes) -> Bytes / {abort.raise} = bytes_concat_all([b"@", hex(b), b";"])

pub fn dump_list<a | e>(xs: List<a>, f: (a) -> Bytes / e) -> Bytes / e =
  bytes_concat(dump_count(len(xs)), bytes_concat_all(map(xs, f)))

pub fn dump_opt<a | e>(o: Option<a>, f: (a) -> Bytes / e) -> Bytes / e =
  match o { None -> dump_presence(false), Some(x) -> bytes_concat(dump_presence(true), f(x)) }

pub fn dump_ident(ident: Ident) -> Bytes / {abort.raise} =
  bytes_concat(dump_node(ident.span, b"ident"), dump_payload(ident.name))

pub fn dump_qname(qname: QName) -> Bytes / {abort.raise} =
  bytes_concat_all([
    dump_node(qname.span, b"qname"),
    dump_opt(qname.module, dump_ident),
    dump_ident(qname.name),
  ])

pub fn dump_label(label: Label) -> Bytes =
  bytes_concat_all([
    b"=",
    int_to_bytes(label.start),
    b":",
    int_to_bytes(label.end),
    b":",
    if label.primary { b"1" } else { b"0" },
    b";",
  ])

pub fn dump_diag(diag: ParseDiag) -> Bytes = {
  let s = primary_span_of(diag);
  bytes_concat(
    bytes_concat_all([
      b"!",
      diag.code,
      b":",
      int_to_bytes(s.start),
      b":",
      int_to_bytes(s.end),
      b":",
      int_to_bytes(len(diag.labels)),
      b":",
      int_to_bytes(diag.notes),
      b";",
    ]),
    bytes_concat_all(map(diag.labels, dump_label)),
  )
}

pub fn dump_diags(diags: List<ParseDiag>) -> Bytes =
  bytes_concat(dump_count(len(diags)), bytes_concat_all(map(diags, dump_diag)))

fn hex_digits() -> Bytes = b"0123456789abcdef"

fn hex_digit(v: Int) -> Bytes / {abort.raise} = bytes_slice(hex_digits(), v, v + 1)

fn hex_byte(v: Int) -> Bytes / {abort.raise} = bytes_concat(hex_digit(v / 16), hex_digit(v % 16))

pub fn hex(b: Bytes) -> Bytes / {abort.raise} =
  bytes_concat_all(map(range(0, bytes_len(b)), |i: Int| hex_byte(bytes_at(b, i))))

// --- The spine's own tests --------------------------------------------------

fn probe(src: Bytes) -> ParseStart / {abort.raise} = start(src)

test "the token buffer is indexed from zero and ends with the EOF token" {
  let s = probe(b"fn f");
  assert_eq(s.input.token_count, 3);
  assert_eq(token_kind_at(s.input, s.parser, 0), lexer::Keyword(b"fn"));
  assert_eq(token_kind_at(s.input, s.parser, 1), lexer::Identifier(b"f"));
  assert_eq(token_kind_at(s.input, s.parser, 2), lexer::EndOfInput);
}

test "lookahead past the end clamps to the last token rather than failing" {
  let s = probe(b"fn");
  assert_eq(token_kind_at(s.input, s.parser, 7), lexer::EndOfInput);
  assert_eq(span_at(s.input, s.parser, 7).start, 2);
}

test "advance stops at the last token, so a parser at EOF cannot run away" {
  let s = probe(b"fn");
  let a = advance(s.input, advance(s.input, advance(s.input, s.parser).parser).parser);
  assert_eq(a.parser.pos, 1);
  assert_eq(at_eof(s.input, a.parser), true);
}

test "prev_span at position zero is the first token, as saturating_sub says" {
  let s = probe(b"fn f");
  assert_eq(previous_span(s.input, s.parser).start, 0);
  assert_eq(previous_span(s.input, advance(s.input, s.parser).parser).end, 2);
}

test "a float literal is carried as the raw source over its span" {
  let s = probe(b"1.50");
  assert_eq(token_bytes(s.input, token_at(s.input, s.parser, 0)), b"1.50");
}

test "expect_gt splits a `>=` into `>` and leaves an `=` where it stood" {
  let s = probe(b">= x");
  let g = parsed_or(expect_gt(s.input, s.parser, b"`>`"), dummy_span());
  assert_eq(g.node.start, 0);
  assert_eq(g.node.end, 1);
  assert_eq(g.parser.pos, 0);
  assert_eq(token_kind(s.input, g.parser), token_eq());
  assert_eq(current_span(s.input, g.parser).start, 1);
  assert_eq(current_span(s.input, g.parser).end, 2);
  let a = advance(s.input, g.parser);
  assert_eq(previous_span(s.input, a.parser).start, 1);
  assert_eq(token_kind(s.input, a.parser), lexer::Identifier(b"x"));
}

test "two diagnostics with the same code and primary span collapse to one" {
  let s = probe(b"fn f");
  let a = error_here(s.input, s.parser, b"one");
  let b = push_diag(a, error_at(unexpected(), current_span(s.input, s.parser), b"", b"", []));
  assert_eq(len(b.diags), 1);
  let c2 = push_diag(a, error_at(unexpected(), span_between(9, 9), b"", b"", []));
  assert_eq(len(c2.diags), 2);
  let d = push_diag(a, error_at(unterminated(), current_span(s.input, s.parser), b"", b"", []));
  assert_eq(len(d.diags), 2);
}

test "the dedup rule sees the last lexer diagnostic, not only parser ones" {
  let s = probe(b"$");
  assert_eq(len(s.parser.diags), 1);
  let last = match list_at(s.parser.diags, len(s.parser.diags) - 1) {
    Some(l) -> l,
    None -> error_at(b"", dummy_span(), b"", b"", []),
  };
  assert_eq(last.code, b"E0001");
  assert_eq(primary_span_of(last).start, 0);
  let q = push_diag(s.parser, error_at(unexpected(), span_between(0, 1), b"", b"", []));
  assert_eq(len(q.diags), 1);
}

test "an unclosed delimiter carries a secondary label at the opener" {
  let s = probe(b"( ]");
  let u = unclosed(s.input, at_pos(s.parser, 1), span_between(0, 1), b"`)`");
  assert_eq(len(u.diags), 1);
  assert_eq(dump_diags(u.diags), b"#1;!E0001:2:3:2:0;=2:3:1;=0:1:0;");
}

test "nesting too deep is refused where it would go deeper, and the diagnostic carries its note" {
  let s = probe(b"fn");
  assert_eq(s.input.room, max_depth());
  assert_eq(dump_diags(too_deep(s.input, s.parser).diags), b"#1;!E0001:0:2:1:1;=0:2:1;")
}

fn a_name(input: Input, parser: Parser) -> Result<Parsed<Ident>, Parser> / {abort.raise} =
  expect_ident(input, parser, b"a name")

fn idents(r: Result<Parsed<List<Ident>>, Parser>) -> Parsed<List<Ident>> = parsed_or(r, [])

test "comma_list reads a comma-separated run and stops at its closer" {
  let s = probe(b"a, b, c)");
  let r = idents(comma_list(s.input, s.parser, token_rparen(), a_name));
  assert_eq(len(r.node), 3);
  assert_eq(at_token(s.input, r.parser, token_rparen()), true);
  assert_eq(failed(comma_list(s.input, s.parser, token_rparen(), a_name)), false);
}

test "comma_list accepts an empty run and a trailing comma" {
  let s = probe(b")");
  assert_eq(len(idents(comma_list(s.input, s.parser, token_rparen(), a_name)).node), 0);
  let t = probe(b"a, )");
  let r = idents(comma_list(t.input, t.parser, token_rparen(), a_name));
  assert_eq(len(r.node), 1);
  assert_eq(at_token(t.input, r.parser, token_rparen()), true);
}

// The trailing comma matters: without it the run stops at the missing comma, not at end of input.
test "comma_list stops at end of input rather than running off the buffer" {
  let s = probe(b"a, b,");
  let r = idents(comma_list(s.input, s.parser, token_rparen(), a_name));
  assert_eq(len(r.node), 2);
  assert_eq(at_eof(s.input, r.parser), true);
  assert_eq(failed(comma_list(s.input, s.parser, token_rparen(), a_name)), false);
  assert_eq(len(r.parser.diags), 0);
}

test "two elements with no comma between them are one element and a stop" {
  let s = probe(b"a b)");
  let r = idents(comma_list(s.input, s.parser, token_rparen(), a_name));
  assert_eq(len(r.node), 1);
  assert_eq(token_kind(s.input, r.parser), lexer::Identifier(b"b"));
  assert_eq(failed(comma_list(s.input, s.parser, token_rparen(), a_name)), false);
}

test "an element that fails abandons the list and propagates the failure" {
  let s = probe(b"a, 1, c)");
  let r = comma_list(s.input, s.parser, token_rparen(), a_name);
  assert_eq(failed(r), true);
  assert_eq(len(parsed_or(r, []).parser.diags), 1);
  assert_eq(len(parsed_or(r, []).node), 0);
}

test "a list emits its length, so a dropped element shifts what follows" {
  let xs = [{ name: b"a", span: span_between(0, 1) }, { name: b"b", span: span_between(2, 3) }];
  assert_eq(dump_list(xs, dump_ident), b"#2;0:1:ident;@61;2:3:ident;@62;");
  assert_eq(dump_list([], dump_ident), b"#0;");
}

test "span_to covers both spans whichever order they arrive in" {
  assert_eq(span_to(span_between(5, 10), span_between(20, 25)), span_between(5, 25));
  assert_eq(span_to(span_between(20, 25), span_between(5, 10)), span_between(5, 25));
}

test "the primary span is the first primary label, not the first label" {
  let two = parse_diag(
    unexpected(),
    b"",
    [parse_label(span_between(7, 8), false, b""), parse_label(span_between(1, 2), true, b"")],
    [],
  );
  assert_eq(primary_span_of(two), span_between(1, 2));
  let none = parse_diag(unexpected(), b"", [parse_label(span_between(7, 8), false, b"")], []);
  assert_eq(primary_span_of(none), span_between(7, 8));
}

test "a diagnostic names the token it found the way the reference does" {
  let s = probe(b"fn 1.50 255u8 1.5m \"s\" b\"b\" ) x");
  assert_eq(describe(token_kind_at(s.input, s.parser, 0)), b"keyword `fn`");
  assert_eq(describe(token_kind_at(s.input, s.parser, 1)), b"float `1.5`");
  assert_eq(describe(token_kind_at(s.input, s.parser, 2)), b"`U8` literal `255`");
  assert_eq(describe(token_kind_at(s.input, s.parser, 3)), b"decimal `1.5`");
  assert_eq(describe(token_kind_at(s.input, s.parser, 4)), b"string literal");
  assert_eq(describe(token_kind_at(s.input, s.parser, 5)), b"byte-string literal");
  assert_eq(describe(token_kind_at(s.input, s.parser, 6)), b"`)`");
  assert_eq(describe(token_kind_at(s.input, s.parser, 7)), b"identifier `x`");
  assert_eq(describe(token_kind_at(s.input, s.parser, 8)), b"end of file");
  assert_eq(float_display(b"1e9"), b"1000000000");
  assert_eq(float_display(b"2.5e-3"), b"0.0025");
  assert_eq(float_display(b"007.50"), b"7.5");
  assert_eq(float_display(b"0.0"), b"0");
  assert_eq(render_decimal(b"5", 3), b"0.005");
  assert_eq(render_decimal(b"150", 2), b"1.50");
  let e = error_here(s.input, s.parser, b"a type");
  let d = match list_at(e.diags, 0) { Some(x) -> x, None -> parse_diag(b"", b"", [], []) };
  assert_eq(d.message, b"expected a type, found keyword `fn`");
  assert_eq(match list_at(d.labels, 0) { Some(l) -> l.text, None -> b"" }, b"expected a type");
}

// `law` is a contextual keyword, so an identifier; `type` checks that a real keyword never matches.
test "at_ident_text matches an identifier and never a keyword" {
  let s = probe(b"law type");
  assert_eq(at_ident_text(s.input, s.parser, b"law"), true);
  assert_eq(at_ident_text(s.input, s.parser, b"lav"), false);
  assert_eq(is_ident(s.input, s.parser), true);
  let n = advance(s.input, s.parser).parser;
  assert_eq(at_ident_text(s.input, n, b"type"), false);
  assert_eq(is_ident(s.input, n), false);
  assert_eq(at_token(s.input, n, keyword_type()), true);
}

test "starts_upper is the constructor-versus-binder decision, on ASCII" {
  assert_eq(starts_upper(b"Some"), true);
  assert_eq(starts_upper(b"Z"), true);
  assert_eq(starts_upper(b"A"), true);
  assert_eq(starts_upper(b"some"), false);
  assert_eq(starts_upper(b"_x"), false);
  assert_eq(starts_upper(b"["), false);
  assert_eq(starts_upper(b"a"), false);
  assert_eq(starts_upper(b""), false);
}

test "is_str is a string literal and not a byte string" {
  let s = probe(b"\"a\" b\"a\" x");
  assert_eq(is_str(s.input, s.parser), true);
  assert_eq(is_str(s.input, bump(s.input, s.parser)), false);
  assert_eq(is_str(s.input, bump(s.input, bump(s.input, s.parser))), false);
}

test "bump moves one token and dump_bool tells the two booleans apart" {
  let s = probe(b"a b");
  assert_eq(token_kind(s.input, bump(s.input, s.parser)), lexer::Identifier(b"b"));
  assert_eq(dump_bool(true), b"%true;");
  assert_eq(dump_bool(false), b"%false;");
}

test "the dump encoder emits printable ASCII with no quote and no backslash" {
  let d = bytes_concat_all([
    dump_node(span_between(3, 9), b"efoo"),
    dump_count(2),
    dump_presence(true),
    dump_presence(false),
    dump_word(b"pub"),
    dump_payload(b"a\"b\\c\n"),
    dump_ident({ name: b"x", span: span_between(0, 1) }),
  ]);
  assert_eq(d, b"3:9:efoo;#2;?1;?0;%pub;@6122625c630a;0:1:ident;@78;");
}

test "a qualified name and a bare one differ in the option, not only the span" {
  let s = probe(b"orders::place");
  let q = parsed_or(qname(s.input, s.parser, b"a name"), no_qname());
  assert_eq(dump_qname(q.node), b"0:13:qname;?1;0:6:ident;@6f7264657273;8:13:ident;@706c616365;");
  let t = probe(b"place");
  let b = parsed_or(qname(t.input, t.parser, b"a name"), no_qname());
  assert_eq(dump_qname(b.node), b"0:5:qname;?0;0:5:ident;@706c616365;");
}

test "a name with two `::` is a diagnostic with a note, and fails" {
  let s = probe(b"a::b::c");
  let q = qname(s.input, s.parser, b"a name");
  assert_eq(failed(q), true);
  assert_eq(dump_diags(parsed_or(q, no_qname()).parser.diags), b"#1;!E0001:4:6:1:1;=4:6:1;");
}

// --- Tuples -----------------------------------------------------------------

pub fn push_front<a>(x: a, xs: List<a>) -> List<a> =
  fold(xs, [x], |acc: List<a>, y: a| push(acc, y))

pub fn positional(i: Int, span: Span) -> Ident =
  { name: bytes_concat(b"_", bytes_of_string(int_to_string(i))), span: span }
