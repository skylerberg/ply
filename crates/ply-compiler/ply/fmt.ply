// `ply fmt`: the module printed back from its tree, with comments re-attached by position and
// literals re-sliced from the source. Layout is decided from the tree and the column alone, so
// printing the output again changes nothing.

import parsing (Span, Ident, QName, ParseDiag, primary_span_of, qname_text)
import lexer (Comment, Token, InterpolatedHead, InterpolatedTail, ItemDoc, lex, doc_mark)
import items (Module, Item, IFn, IType, IEffect, ITest, ILaw, IDerive, IEffectSet, IExtern,
              ImportDecl, IModule, IAlias, INames, FnDef, ExternDef, TypeDef, TDAlias, TDSum,
              VariantDef, EffectDef, OpDef, TestDef, LawDef, Binder, Deriver, deriver_text,
              Constraint, SpecClause, SpecKind, SRequires, SEnsures, SCost, ReturnsFresh,
              ReturnsParam, Vis, VPub, VPriv, item_span, item_doc, parse, dump_module, is_written,
              constraint_written, is_pub, spec_kind_text)
import type_syntax (TypeExpr, TVar, TCon, TFn, TRecord, TUnit, TBad, RowExpr, AtomExpr, Mode, MRead,
                    MWrite, MBad, ty_span, mode_text, is_raise, angled, generics_text, ident_names)
import exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock, ERecord,
              ERecordUpdate, ETry, EField, EList, EPerform, EHandle, EWithCell, ESimulate,
              EParallel, EBad, ETryBlock, RaiseName, RecField, NamedArg, Param, Stmt, SLet,
              SLetElse, SExpr, MatchArm, HandleClause, ReturnClause, expr_span, is_block_like)
import patterns (Pattern, PWild, PVar, PLit, PCtor, PRecord, PList, POr, PBad, Lit, LInt, LFixed,
                 LWide, LBool, LStr, LBytes, LFloat, LDec, LChar, LUnit, LBad, pat_span)
import std.list (at)
import std.bytes (is_digit, join, ascii_of_int)

// --- The entry point --------------------------------------------------------

pub fn fmt_source(src: Bytes) -> Result<Bytes, Bytes> / {abort.raise} = {
  let r = parse(src);
  match list_at(r.parser.diags, 0) {
    Some(d) -> Err(render_diag(src, d)),
    None -> {
      let out = module({ source: src, comments: lex(src).comments }, r.node);
      let again = parse(out);
      match list_at(again.parser.diags, 0) {
        Some(d) ->
          Err(
            bytes_concat(
              b"formatter bug: the formatted text does not parse: ",
              render_diag(out, d),
            ),
          ),
        None -> if erase_spans(dump_module(again.node)) != erase_spans(dump_module(r.node)) {
          Err(b"formatter bug: the formatted text parses to a different tree")
        } else { Ok(out) },
      }
    },
  }
}

fn render_diag(src: Bytes, diag: ParseDiag) -> Bytes / {abort.raise} = {
  let s = primary_span_of(diag);
  let lines = bytes_split(bytes_slice(src, 0, s.start), b"\n");
  let col = bytes_len(at(lines, len(lines) - 1)) + 1;
  bytes_concat_all([
    ascii_of_int(len(lines)),
    b":",
    ascii_of_int(col),
    b": ",
    diag.code,
    b": ",
    diag.message,
  ])
}

// The dump with every `start:end:` prefix removed, so two parses compare as trees.
fn erase_spans(dump: Bytes) -> Bytes / {abort.raise} =
  bytes_concat_all(
    map(bytes_split(dump, b";"), |u: Bytes|
      if bytes_len(u) > 0 && is_digit(bytes_at(u, 0)) {
        match bytes_index_of(u, b":") {
          Some(i) -> match bytes_index_of_from(u, b":", i + 1) {
            Some(j) -> bytes_concat(bytes_slice(u, j + 1, bytes_len(u)), b";"),
            None -> bytes_concat(u, b";"),
          },
          None -> bytes_concat(u, b";"),
        }
      } else { bytes_concat(u, b";") }),
  )

// --- The state --------------------------------------------------------------

type PrintInput = { source: Bytes, comments: List<Comment> }

// `ci` is the next comment not yet placed; `pending` holds the ones the current line will end
// with; `prev_end` is where the last placed node or comment ended, for the blank-line rule.
// `closed` is the indent the next text breaks to after a line string, whose line runs to its end,
// and -1 otherwise. `parts` is last: it is the list that grows.
type Printer = {
  next_comment: Int,
  column: Int,
  previous_end: Int,
  pending: List<Bytes>,
  closed: Int,
  parts: List<Bytes>,
}

fn width() -> Int = 100

fn is_blank(c: Int) -> Bool = c == 32 || c == 9 || c == 13

fn spaces(n: Int) -> Bytes = bytes_concat_all(map(range(0, n), |i: Int| b" "))

fn trim_end(b: Bytes) -> Bytes / {abort.raise} = {
  let k = iterate(bytes_len(b), bytes_len(b) + 1, |i: Int|
    if i > 0 && is_blank(bytes_at(b, i - 1)) { Continue(i - 1) } else { Stop(i) });
  bytes_slice(b, 0, k)
}

fn trim(b: Bytes) -> Bytes / {abort.raise} = {
  let t = trim_end(b);
  let k = iterate(0, bytes_len(t) + 1, |i: Int|
    if i < bytes_len(t) && is_blank(bytes_at(t, i)) { Continue(i + 1) } else { Stop(i) });
  bytes_slice(t, k, bytes_len(t))
}

fn trim_last(parts: List<Bytes>) -> List<Bytes> / {abort.raise} = {
  let n = len(parts);
  if n == 0 { parts } else { list_set(parts, n - 1, trim_end(at(parts, n - 1))) }
}

// What follows a closed line starts the next one, which `nl` opens and no longer has it closed.
fn emit(printer: Printer, b: Bytes) -> Printer / {abort.raise} =
  if printer.closed >= 0 && bytes_len(trim(b)) > 0 {
    appended(nl(printer, printer.closed, false), trim(b))
  } else { appended(printer, b) }

fn appended(printer: Printer, b: Bytes) -> Printer =
  {
    next_comment: printer.next_comment,
    previous_end: printer.previous_end,
    pending: printer.pending,
    column: printer.column + bytes_len(b),
    closed: printer.closed,
    parts: push(printer.parts, b),
  }

fn set_prev(printer: Printer, e: Int) -> Printer = { ..printer, previous_end: e }

fn with_trailing(
  parts: List<Bytes>,
  pending: List<Bytes>,
  indent: Int,
) -> List<Bytes> / {abort.raise} =
  fold(range(0, len(pending)), trim_last(parts), |ps: List<Bytes>, i: Int|
    push(
      ps,
      bytes_concat(
        if i == 0 { b"  " } else { bytes_concat(b"\n", spaces(indent)) },
        at(pending, i),
      ),
    ))

// Ends the line: the trailing comments it collected, a newline (two for a blank line), the indent.
// A line holding nothing yet is reused rather than left empty.
fn nl(printer: Printer, indent: Int, blank: Bool) -> Printer / {abort.raise} = {
  let pending = printer.pending;
  let n = len(printer.parts);
  let fresh = n > 0 && len(pending) == 0 && !blank
    && bytes_len(trim_end(at(printer.parts, n - 1))) == 0;
  if fresh {
    {
      next_comment: printer.next_comment,
      previous_end: printer.previous_end,
      pending: [],
      column: indent,
      closed: -1,
      parts: list_set(printer.parts, n - 1, spaces(indent)),
    }
  } else {
    let trailed = with_trailing(printer.parts, pending, indent);
    let lead = if len(trailed) == 0 { b"" } else if blank { b"\n\n" } else { b"\n" };
    {
      next_comment: printer.next_comment,
      previous_end: printer.previous_end,
      pending: [],
      column: indent,
      closed: -1,
      parts: push(trailed, bytes_concat(lead, spaces(indent))),
    }
  }
}

// Nothing printed on the current line yet but its indent.
fn line_empty(printer: Printer) -> Bool / {abort.raise} =
  match list_at(printer.parts, len(printer.parts) - 1) {
    None -> true,
    Some(last) ->
      fold(range(0, bytes_len(last)), true, |all: Bool, i: Int|
        all && (bytes_at(last, i) == 10 || is_blank(bytes_at(last, i)))),
  }

fn finish(printer: Printer) -> Bytes / {abort.raise} = {
  let trailed = with_trailing(printer.parts, printer.pending, 0);
  if len(trailed) == 0 { b"" } else { bytes_concat(bytes_concat_all(trailed), b"\n") }
}

fn fits(printer: Printer, text: Bytes, after: Int) -> Bool =
  printer.column + bytes_len(text) + after <= width()

// --- Comments ---------------------------------------------------------------

fn next_comment(input: PrintInput, printer: Printer) -> Option<Comment> =
  list_at(input.comments, printer.next_comment)

fn comment_before(p: PrintInput, printer: Printer, pos: Int) -> Bool =
  match next_comment(p, printer) { Some(c) -> c.start < pos, None -> false }

fn comment_text(input: PrintInput, c: Comment) -> Bytes / {abort.raise} =
  trim_end(bytes_slice(input.source, c.start, c.end))

fn same_line(input: PrintInput, a: Int, b: Int) -> Bool / {abort.raise} =
  a <= b
    && (match bytes_index_of(bytes_slice(input.source, a, b), b"\n") {
      Some(_) -> false,
      None -> true,
    })

// Two or more line breaks between `a` and `b` in the source: a blank line the output keeps.
fn gap(input: PrintInput, a: Int, b: Int) -> Bool / {abort.raise} =
  a <= b && len(bytes_split(bytes_slice(input.source, a, b), b"\n")) >= 3

fn take_comment(printer: Printer, c: Comment) -> Printer =
  { ..printer, next_comment: printer.next_comment + 1, previous_end: c.end }

// A blank line in the source before `at` that the output keeps: never after a `///` line, which
// holds to what follows it.
fn kept_blank(input: PrintInput, printer: Printer, at: Int) -> Bool / {abort.raise} =
  gap(input, printer.previous_end, at)
    && !(match list_at(input.comments, printer.next_comment - 1) {
      Some(c) -> c.end == printer.previous_end && doc_mark(input.source, c) == Some(ItemDoc),
      None -> false,
    })

// Every comment before `before`, each on a line of its own at `indent`.
fn flush_comments(
  input: PrintInput,
  printer: Printer,
  before: Int,
  indent: Int,
  blanks: Bool,
) -> Printer / {abort.raise} =
  match list_at(input.comments, printer.next_comment) {
    Some(c) -> if c.start < before {
      let s = nl(printer, indent, blanks && kept_blank(input, printer, c.start));
      flush_comments(
        input,
        take_comment(emit(s, comment_text(input, c)), c),
        before,
        indent,
        blanks,
      )
    } else { printer },
    None -> printer,
  }

// The leading comments of a node, then a fresh line at `indent` for the node itself.
fn open_line(
  input: PrintInput,
  printer: Printer,
  start: Int,
  indent: Int,
  blanks: Bool,
) -> Printer / {abort.raise} = {
  let s = flush_comments(input, printer, start, indent, blanks);
  nl(s, indent, blanks && kept_blank(input, s, start))
}

// Before a node that is not the first thing on its line: its leading comments, if any, force a break.
fn lead(input: PrintInput, printer: Printer, start: Int, indent: Int) -> Printer / {abort.raise} =
  if comment_before(input, printer, start) { open_line(input, printer, start, indent, false) }
  else { printer }

// A comment on the same source line as the node that just ended goes on the same output line.
fn trail(input: PrintInput, printer: Printer, end: Int) -> Printer / {abort.raise} =
  match next_comment(input, printer) {
    Some(c) -> if c.start >= end && same_line(input, end, c.start) {
      take_comment(
        {
          next_comment: printer.next_comment,
          column: printer.column,
          previous_end: printer.previous_end,
          closed: printer.closed,
          parts: printer.parts,
          pending: push(printer.pending, comment_text(input, c)),
        },
        c,
      )
    } else { printer },
    None -> printer,
  }

// Comments a printed node left behind inside its span end its line rather than being lost.
fn absorb(input: PrintInput, printer: Printer, end: Int) -> Printer / {abort.raise} =
  match list_at(input.comments, printer.next_comment) {
    Some(c) -> if c.start < end {
      absorb(
        input,
        take_comment(
          {
            next_comment: printer.next_comment,
            column: printer.column,
            previous_end: printer.previous_end,
            closed: printer.closed,
            parts: printer.parts,
            pending: push(printer.pending, comment_text(input, c)),
          },
          c,
        ),
        end,
      )
    } else { printer },
    None -> printer,
  }

// Comments before the closer, then the closer on a line of its own.
fn close(
  input: PrintInput,
  printer: Printer,
  end: Int,
  indent: Int,
  closer: Bytes,
) -> Printer / {abort.raise} =
  emit(nl(flush_comments(input, printer, end, indent + 2, false), indent, false), closer)

// The one-line form, when the node has one, holds no comment, and fits.
fn try_flat(
  input: PrintInput,
  printer: Printer,
  flat: Option<Bytes>,
  end: Int,
  after: Int,
) -> Option<Bytes> =
  match flat {
    Some(f) -> if !comment_before(input, printer, end) && fits(printer, f, after) { Some(f) }
    else { None },
    None -> None,
  }

// --- One-line text ----------------------------------------------------------

fn cat(xs: List<Option<Bytes>>) -> Option<Bytes> =
  fold(xs, Some(b""), |acc: Option<Bytes>, x: Option<Bytes>|
    match acc {
      None -> None,
      Some(a) -> match x { None -> None, Some(b) -> Some(bytes_concat(a, b)) },
    })

fn sep(xs: List<Option<Bytes>>, s: Bytes) -> Option<Bytes> / {abort.raise} =
  fold(range(0, len(xs)), Some(b""), |acc: Option<Bytes>, i: Int|
    match acc {
      None -> None,
      Some(a) -> match at(xs, i) {
        None -> None,
        Some(b) -> Some(if i == 0 { b } else { bytes_concat_all([a, s, b]) }),
      },
    })

fn resource_text(r: Option<Ident>) -> Bytes =
  match r { Some(i) -> bytes_concat_all([b"[", i.name, b"]"]), None -> b"" }

// One bracket holds every label a call fills: `relay[conn](c)`, `f[a, b](x)`.
fn call_labels(idents: List<Ident>) -> Bytes / {abort.raise} =
  if len(idents) == 0 { b"" }
  else { bytes_concat_all([b"[", join(map(idents, |ident: Ident| ident.name), b", "), b"]"]) }

fn atom_text(atom: AtomExpr) -> Bytes =
  bytes_concat_all([
    qname_text(atom.eff),
    b".",
    match atom.op { Some(o) -> o.name, None -> mode_text(atom.mode) },
    atom_label_text(atom),
    if atom.bounded { b" bounded" } else { b"" },
  ])

// `[*]` is a label, so it is written where a label goes rather than dropped.
fn atom_label_text(atom: AtomExpr) -> Bytes =
  if atom.every { b"[*]" } else { resource_text(atom.resource) }

// Atoms and set names as the source ordered them: the parser keeps them in two lists.
fn members(atoms: List<AtomExpr>, names: List<QName>) -> List<Bytes> / {abort.raise} = {
  let xs = map(atoms, |atom: AtomExpr| { start: atom.span.start, text: atom_text(atom) });
  let ys = map(names, |qname: QName| { start: qname.span.start, text: qname_text(qname) });
  let merged = iterate(
    { i: 0, j: 0, out: [] },
    len(xs) + len(ys) + 1,
    |s: { i: Int, j: Int, out: List<Bytes> }|
      if s.i >= len(xs) && s.j >= len(ys) { Stop(s.out) }
      else if s.j >= len(ys) || (s.i < len(xs) && at(xs, s.i).start < at(ys, s.j).start) {
        Continue({ i: s.i + 1, j: s.j, out: push(s.out, at(xs, s.i).text) })
      } else { Continue({ i: s.i, j: s.j + 1, out: push(s.out, at(ys, s.j).text) }) },
  );
  merged
}

fn row_text(input: PrintInput, row: RowExpr) -> Bytes / {abort.raise} = {
  let ms = join(members(row.atoms, row.aliases), b", ");
  let braced = row.span.end > row.span.start && bytes_at(input.source, row.span.start) == 123;
  match row.tail {
    Some(t) -> {
      let v = if row.tail_bounded { bytes_concat(t.name, b" bounded") } else { t.name };
      if !braced { v }
      else if bytes_len(ms) == 0 { bytes_concat_all([b"{| ", v, b"}"]) }
      else { bytes_concat_all([b"{", ms, b" | ", v, b"}"]) }
    },
    None -> bytes_concat_all([b"{", ms, b"}"]),
  }
}

fn row_suffix(input: PrintInput, r: Option<RowExpr>) -> Bytes / {abort.raise} =
  match r { Some(x) -> bytes_concat(b" / ", row_text(input, x)), None -> b"" }

fn positional_name(i: Int) -> Bytes = bytes_concat(b"_", ascii_of_int(i))

fn is_ty_tuple(fields: List<{ name: Ident, ty: TypeExpr }>) -> Bool / {abort.raise} =
  len(fields) >= 2
    && fold(range(0, len(fields)), true, |ok: Bool, i: Int| {
      let f = at(fields, i);
      ok && f.name.name == positional_name(i) && f.name.span == ty_span(f.ty)
    })

fn type_text(input: PrintInput, t: TypeExpr) -> Bytes / {abort.raise} =
  match t {
    TVar(i) -> i.name,
    TCon(x) ->
      bytes_concat(
        qname_text(x.name),
        angled(
          map(x.args, |a: TypeExpr| type_text(input, a)),
          ident_names(x.labels),
          map(x.rows, |r: RowExpr| row_text(input, r)),
        ),
      ),
    TFn(x) ->
      bytes_concat_all([
        b"(",
        join(map(x.params, |a: TypeExpr| type_text(input, a)), b", "),
        b") -> ",
        type_text(input, x.ret),
        row_suffix(input, x.effects),
      ]),
    TRecord(x) -> if is_ty_tuple(x.fields) {
      bytes_concat_all([
        b"(",
        join(map(x.fields, |f: { name: Ident, ty: TypeExpr }| type_text(input, f.ty)), b", "),
        b")",
      ])
    } else if len(x.fields) == 0 { b"{}" } else {
      bytes_concat_all([
        b"{ ",
        join(map(x.fields, |f: { name: Ident, ty: TypeExpr }| ty_field_text(input, f)), b", "),
        b" }",
      ])
    },
    TUnit(_) -> b"()",
    TBad(_) -> b"()",
  }

fn ty_field_text(input: PrintInput, f: { name: Ident, ty: TypeExpr }) -> Bytes / {abort.raise} =
  bytes_concat_all([f.name.name, b": ", type_text(input, f.ty)])

// The source over a literal, with the parentheses a grouping widened its span by removed.
fn unparen(input: PrintInput, span: Span) -> Bytes / {abort.raise} =
  unparen_text(trim(bytes_slice(input.source, span.start, span.end)))

// A pair of parentheses a round, each round two bytes shorter.
fn unparen_text(t: Bytes) -> Bytes / {abort.raise} =
  iterate(t, bytes_len(t) / 2 + 1, |cur: Bytes| {
    let n = bytes_len(cur);
    if n >= 2 && bytes_at(cur, 0) == 40 && bytes_at(cur, n - 1) == 41 {
      let inner = trim(bytes_slice(cur, 1, n - 1));
      if bytes_len(inner) == 0 { Stop(cur) } else { Continue(inner) }
    } else { Stop(cur) }
  })

fn strip_blanks(t: Bytes) -> Bytes / {abort.raise} =
  bytes_concat_all(bytes_split(bytes_concat_all(bytes_split(t, b" ")), b"\t"))

// A literal written as a line string: the AST holds only its value, so the source says which.
fn is_lines(input: PrintInput, expr: Expr) -> Bool / {abort.raise} =
  match expr {
    ELit(v) -> {
      let t = unparen(input, v.span);
      bytes_len(t) >= 2 && bytes_at(t, 0) == 92 && bytes_at(t, 1) == 92
    },
    _ -> false,
  }

// One line per line of the value, every one at the first's indent, and nothing after the last on
// its line: what follows breaks to `indent`.
fn line_string(printer: Printer, value: Bytes, indent: Int, cont: Int) -> Printer / {abort.raise} = {
  let empty = line_empty(printer);
  let col = if empty { printer.column } else { cont };
  let lines = bytes_split(value, b"\n");
  let printed = fold(
    range(0, len(lines)),
    if empty { printer } else { nl(printer, cont, false) },
    |s: Printer, i: Int|
      emit(if i == 0 { s } else { nl(s, col, false) }, bytes_concat(b"\\\\", at(lines, i))),
  );
  { ..printed, closed: indent }
}

fn lit_text(input: PrintInput, span: Span, literal: Lit) -> Bytes / {abort.raise} =
  match literal {
    LInt(_) -> strip_blanks(unparen(input, span)),
    LFixed(_, _) -> strip_blanks(unparen(input, span)),
    LWide(_, _, _) -> strip_blanks(unparen(input, span)),
    LBool(b) -> if b { b"true" } else { b"false" },
    LStr(_) -> unparen(input, span),
    LBytes(_) -> unparen(input, span),
    LFloat(r) -> r,
    LDec(r) -> r,
    LChar(_) -> unparen(input, span),
    LUnit -> b"()",
    LBad -> b"()",
  }

fn pat_punned(f: { name: Ident, pat: Pattern }) -> Bool =
  match f.pat { PVar(v) -> v.name.name == f.name.name && v.span == f.name.span, _ -> false }

fn is_pat_tuple(fields: List<{ name: Ident, pat: Pattern }>) -> Bool / {abort.raise} =
  len(fields) >= 2
    && fold(range(0, len(fields)), true, |ok: Bool, i: Int| {
      let f = at(fields, i);
      ok && f.name.name == positional_name(i) && f.name.span == pat_span(f.pat)
    })

fn pattern_text(input: PrintInput, x: Pattern) -> Bytes / {abort.raise} =
  match x {
    PWild(_) -> b"_",
    PVar(v) -> v.name.name,
    PLit(v) -> lit_text(input, v.span, v.lit),
    PCtor(v) -> if len(v.args) == 0 { qname_text(v.name) } else {
      bytes_concat_all([
        qname_text(v.name),
        b"(",
        join(map(v.args, |a: Pattern| pattern_text(input, a)), b", "),
        b")",
      ])
    },
    PRecord(v) -> if is_pat_tuple(v.fields) && !v.rest {
      bytes_concat_all([
        b"(",
        join(map(v.fields, |f: { name: Ident, pat: Pattern }| pattern_text(input, f.pat)), b", "),
        b")",
      ])
    } else {
      let fs = map(v.fields, |f: { name: Ident, pat: Pattern }|
        if pat_punned(f) { f.name.name }
        else { bytes_concat_all([f.name.name, b": ", pattern_text(input, f.pat)]) });
      let all = if v.rest { push(fs, b"..") } else { fs };
      bytes_concat_all([b"{ ", join(all, b", "), b" }"])
    },
    PList(v) -> {
      let items = map(v.items, |a: Pattern| pattern_text(input, a));
      let all = match v.rest {
        Some(PVar(r)) -> push(items, bytes_concat(b"..", r.name.name)),
        Some(_) -> push(items, b".."),
        None -> items,
      };
      bytes_concat_all([b"[", join(all, b", "), b"]"])
    },
    // An alternative that is itself a choice was parenthesised, and stays so.
    POr(v) ->
      join(
        map(v.alts, |a: Pattern|
          match a {
            POr(_) -> bytes_concat_all([b"(", pattern_text(input, a), b")"]),
            _ -> pattern_text(input, a),
          }),
        b" | ",
      ),
    PBad(_) -> b"_",
  }

// --- Operators and parentheses ----------------------------------------------

fn bp(op: Bytes) -> Int =
  if op == b"or" { 1 }
  else if op == b"and" { 2 }
  else if op == b"eq" || op == b"ne" || op == b"lt" || op == b"le" || op == b"gt" || op == b"ge" {
    3
  } else if op == b"bitor" { 4 }
  else if op == b"bitxor" { 5 }
  else if op == b"bitand" { 6 }
  else if op == b"shl" || op == b"shr" || op == b"ushr" { 7 }
  else if op == b"concat" { 8 }
  else if op == b"add" || op == b"sub" { 9 }
  else { 10 }

fn op_text(op: Bytes) -> Bytes = {
  let table = [
    { n: b"or", t: b"||" },
    { n: b"and", t: b"&&" },
    { n: b"eq", t: b"==" },
    { n: b"ne", t: b"!=" },
    { n: b"lt", t: b"<" },
    { n: b"le", t: b"<=" },
    { n: b"gt", t: b">" },
    { n: b"ge", t: b">=" },
    { n: b"bitor", t: b"|" },
    { n: b"bitxor", t: b"^" },
    { n: b"bitand", t: b"&" },
    { n: b"shl", t: b"<<" },
    { n: b"shr", t: b">>" },
    { n: b"ushr", t: b">>>" },
    { n: b"concat", t: b"++" },
    { n: b"add", t: b"+" },
    { n: b"sub", t: b"-" },
    { n: b"mul", t: b"*" },
    { n: b"div", t: b"/" },
    { n: b"rem", t: b"%" },
  ];
  fold(table, b"", |acc: Bytes, e: { n: Bytes, t: Bytes }| if e.n == op { e.t } else { acc })
}

fn unary_text(op: Bytes) -> Bytes =
  if op == b"neg" { b"-" } else if op == b"not" { b"!" } else { b"~" }

// A form with no closer of its own to read: where it ends is worked out rather than seen.
fn runs_on(expr: Expr) -> Bool =
  match expr {
    ELambda(_) -> true,
    EIf(_) -> true,
    EMatch(_) -> true,
    EHandle(_) -> true,
    EWithCell(_) -> true,
    ESimulate(_) -> true,
    ETryBlock(_) -> true,
    _ -> false,
  }

// A binary operand: a looser operator, the same one on the right, `&&` under `||`, or a form that
// runs on. The brackets `&&` binding tighter than `||` makes redundant are still written, so what
// an edit to one of them would mean is read rather than recalled.
fn parens_operand(expr: Expr, parent: Bytes, rhs: Bool) -> Bool =
  match expr {
    EBinary(v) ->
      bp(v.op) < bp(parent) || (bp(v.op) == bp(parent) && rhs)
        || (v.op == b"and" && parent == b"or"),
    _ -> runs_on(expr),
  }

fn parens_unary(expr: Expr) -> Bool =
  match expr { EBinary(_) -> true, EUnary(_) -> true, _ -> runs_on(expr) }

// What a call, a field read or `?` may follow without parentheses.
fn parens_postfix(expr: Expr) -> Bool =
  match expr {
    ELit(_) -> false,
    EVar(_) -> false,
    EApp(_) -> false,
    EField(_) -> false,
    ETry(_) -> false,
    EPerform(_) -> false,
    EList(_) -> false,
    ERecord(_) -> false,
    ERecordUpdate(_) -> false,
    EBlock(_) -> false,
    _ -> true,
  }

// `v.f(x)` would read as a perform, so a field of a variable is parenthesised before a call.
fn parens_callee(expr: Expr) -> Bool =
  match expr {
    EField(v) -> match v.base { EVar(_) -> true, _ -> parens_postfix(expr) },
    _ -> parens_postfix(expr),
  }

// In a scrutinee a `{` opens the arms, so an expression that begins with one is grouped.
fn starts_with_brace(expr: Expr) -> Bool =
  match expr {
    ERecord(_) -> true,
    ERecordUpdate(_) -> true,
    EBlock(_) -> true,
    ESimulate(_) -> true,
    EParallel(_) -> true,
    EBinary(v) -> starts_with_brace(v.lhs),
    EApp(v) -> starts_with_brace(v.func),
    EField(v) -> starts_with_brace(v.base),
    ETry(v) -> starts_with_brace(v.operand),
    _ -> false,
  }

fn wrap(o: Option<Bytes>, parens: Bool) -> Option<Bytes> =
  if parens { cat([Some(b"("), o, Some(b")")]) } else { o }

// --- Expressions, on one line -----------------------------------------------

fn punned(field: RecField) -> Bool =
  match field.value {
    EVar(v) -> match v.name.module {
      None -> v.name.name.name == field.name.name && v.span == field.name.span,
      Some(_) -> false,
    },
    _ -> false,
  }

fn is_tuple(fields: List<RecField>) -> Bool / {abort.raise} =
  len(fields) >= 2
    && fold(range(0, len(fields)), true, |ok: Bool, i: Int| {
      let f = at(fields, i);
      ok && f.name.name == positional_name(i) && f.name.span == expr_span(f.value)
    })

fn lambda_head(
  input: PrintInput,
  params: List<Param>,
  ret: Option<TypeExpr>,
) -> Bytes / {abort.raise} = {
  let ps = if len(params) == 0 { b"||" } else {
    bytes_concat_all([
      b"|",
      join(map(params, |param: Param| param_head(input, param)), b", "),
      b"|",
    ])
  };
  match ret { Some(t) -> bytes_concat_all([ps, b" -> ", type_text(input, t)]), None -> ps }
}

fn param_head(input: PrintInput, param: Param) -> Bytes / {abort.raise} =
  bytes_concat(
    match param.ty {
      Some(t) -> bytes_concat_all([param.name.name, b": ", type_text(input, t)]),
      None -> param.name.name,
    },
    match param.cost { Some(k) -> bytes_concat(b" cost ", k.name), None -> b"" },
  )

fn perform_head(eff: QName, ident: Ident, r: Option<Ident>) -> Bytes =
  bytes_concat_all([qname_text(eff), b".", ident.name, resource_text(r)])

fn try_head(raise: Option<RaiseName>) -> Bytes =
  match raise {
    None -> b"try ",
    Some(r) -> bytes_concat_all([b"try[", qname_text(r.eff), b".", r.op.name, b"] "]),
  }

fn clause_head(clause: HandleClause) -> Bytes / {abort.raise} =
  bytes_concat_all([
    // `[*]` is a label the clause answers on every resource, so it is not one to print as a name.
    // `[*t]` is the same coverage with the label bound, which is the only way to read it.
    match clause.every_label {
      true ->
        bytes_concat_all([
          qname_text(clause.eff),
          b".",
          clause.op.name,
          b"[*",
          match clause.label_binder { Some(t) -> t.name, None -> b"" },
          b"]",
        ]),
      false -> perform_head(clause.eff, clause.op, clause.resource),
    },
    b"(",
    join(map(clause.params, |ident: Ident| ident.name), b", "),
    b")",
    match clause.resume { Some(k) -> bytes_concat(b" resume ", k.name), None -> b"" },
  ])

// `{ x }` alone reads as a block, so a lone punned field is written out.
fn flat_field(input: PrintInput, field: RecField, pun_ok: Bool) -> Option<Bytes> / {abort.raise} =
  if punned(field) && pun_ok { Some(field.name.name) }
  else { cat([Some(bytes_concat(field.name.name, b": ")), flat_expr(input, field.value)]) }

fn flat_scrutinee(input: PrintInput, expr: Expr) -> Option<Bytes> / {abort.raise} =
  wrap(flat_expr(input, expr), starts_with_brace(expr))

fn flat_args(
  input: PrintInput,
  args: List<Expr>,
  named: List<NamedArg>,
) -> Option<Bytes> / {abort.raise} =
  sep(
    fold(
      named,
      map(args, |expr: Expr| flat_expr(input, expr)),
      |acc: List<Option<Bytes>>, arg: NamedArg|
        push(acc, cat([Some(bytes_concat(arg.name.name, b": ")), flat_expr(input, arg.value)])),
    ),
    b", ",
  )

fn flat_else(input: PrintInput, expr: Expr) -> Option<Bytes> / {abort.raise} =
  match expr { ELit(_) -> Some(b""), _ -> cat([Some(b" else "), flat_expr(input, expr)]) }

fn flat_arm(input: PrintInput, arm: MatchArm) -> Option<Bytes> / {abort.raise} =
  cat([
    Some(pattern_text(input, arm.pat)),
    match arm.guard { Some(g) -> cat([Some(b" if "), flat_expr(input, g)]), None -> Some(b"") },
    Some(b" -> "),
    flat_expr(input, arm.body),
  ])

fn flat_clauses(
  input: PrintInput,
  clauses: List<HandleClause>,
  ret: Option<ReturnClause>,
) -> Option<Bytes> / {abort.raise} = {
  let cs = map(clauses, |c: HandleClause|
    cat([Some(clause_head(c)), Some(b" -> "), flat_expr(input, c.body)]));
  let all = match ret {
    Some(r) ->
      push(
        cs,
        cat([
          Some(bytes_concat_all([b"return ", r.binder.name, b" -> "])),
          flat_expr(input, r.body),
        ]),
      ),
    None -> cs,
  };
  if len(all) == 0 { Some(b"{}") } else { cat([Some(b"{ "), sep(all, b", "), Some(b" }")]) }
}

// The parser expands an interpolated string into a concatenation spanning it, which the source
// still opens with `f"`: its text is kept as written and each hole printed flat.
fn interpolated(input: PrintInput, e: Expr) -> Option<Bytes> / {abort.raise} =
  match e {
    ELit(_) -> None,
    _ -> if !one_interpolation(input, expr_span(e)) { None }
    else { cat([Some(b"f\""), pieces(input, e), Some(b"\"")]) },
  }

// A concatenation the program wrote may open with an interpolated string too, so the span must be
// exactly one: the `"` closing its first `f"` is the span's last token.
fn one_interpolation(input: PrintInput, span: Span) -> Bool / {abort.raise} =
  if bytes_slice(input.source, span.start, span.start + 2) != b"f\"" { false } else {
    let toks = lex(bytes_slice(input.source, span.start, span.end)).tokens;
    let walked = fold(
      toks,
      { open: 0, closed: -1, i: 0 },
      |acc: { open: Int, closed: Int, i: Int }, token: Token| {
        let open = match token.kind {
          InterpolatedHead(_) -> acc.open + 1,
          InterpolatedTail(_) -> acc.open - 1,
          _ -> acc.open,
        };
        {
          open: open,
          closed: if acc.closed < 0 && acc.open > 0 && open == 0 { acc.i } else { acc.closed },
          i: acc.i + 1,
        }
      },
    );
    walked.closed == len(toks) - 2
  }

// Each piece of the concatenation printed, left to right.
fn pieces(input: PrintInput, expr: Expr) -> Option<Bytes> / {abort.raise} =
  match expr {
    EBinary(v) -> if v.op == b"concat" { cat([pieces(input, v.lhs), pieces(input, v.rhs)]) }
    else { piece(input, expr) },
    _ -> piece(input, expr),
  }

// A text piece's token runs from the `f"` or `}` before it to the `{` or `"` after it.
fn piece(input: PrintInput, expr: Expr) -> Option<Bytes> / {abort.raise} =
  match expr {
    ELit(v) -> {
      let lead = if bytes_slice(input.source, v.span.start, v.span.start + 2) == b"f\"" { 2 }
      else { 1 };
      Some(bytes_slice(input.source, v.span.start + lead, v.span.end - 1))
    },
    EApp(v) -> match v.args {
      [x] -> cat([Some(b"{"), flat_expr(input, x), Some(b"}")]),
      _ -> None,
    },
    _ -> None,
  }

fn flat_expr(p: PrintInput, expr: Expr) -> Option<Bytes> / {abort.raise} =
  match interpolated(p, expr) { Some(text) -> Some(text), None -> flat_node(p, expr) }

fn flat_node(input: PrintInput, e: Expr) -> Option<Bytes> / {abort.raise} =
  match e {
    ELit(v) -> if is_lines(input, e) { None } else { Some(lit_text(input, v.span, v.lit)) },
    EVar(v) -> Some(qname_text(v.name)),
    EBinary(v) ->
      cat([
        wrap(flat_expr(input, v.lhs), parens_operand(v.lhs, v.op, false)),
        Some(bytes_concat_all([b" ", op_text(v.op), b" "])),
        wrap(flat_expr(input, v.rhs), parens_operand(v.rhs, v.op, true)),
      ]),
    EUnary(v) ->
      cat([Some(unary_text(v.op)), wrap(flat_expr(input, v.operand), parens_unary(v.operand))]),
    ELambda(v) ->
      cat([Some(lambda_head(input, v.params, v.ret)), Some(b" "), flat_expr(input, v.body)]),
    EApp(v) -> match literal_of(input, e) {
      Some(m) -> flat_literal(input, m),
      None ->
        cat([
          wrap(flat_expr(input, v.func), parens_callee(v.func)),
          Some(call_labels(v.labels)),
          Some(b"("),
          flat_args(input, v.args, v.named),
          Some(b")"),
        ]),
    },
    EIf(v) ->
      cat([
        Some(b"if "),
        flat_scrutinee(input, v.cond),
        Some(b" "),
        flat_expr(input, v.then_branch),
        flat_else(input, v.else_branch),
      ]),
    EMatch(v) ->
      cat([
        Some(b"match "),
        flat_scrutinee(input, v.scrutinee),
        if len(v.arms) == 0 { Some(b" {}") } else {
          cat([
            Some(b" { "),
            sep(map(v.arms, |arm: MatchArm| flat_arm(input, arm)), b", "),
            Some(b" }"),
          ])
        },
      ]),
    EBlock(v) -> if len(v.stmts) > 0 { None } else {
      match v.tail {
        None -> Some(b"{}"),
        Some(t) -> cat([Some(b"{ "), flat_expr(input, t), Some(b" }")]),
      }
    },
    ERecord(v) -> if is_tuple(v.fields) {
      cat([
        Some(b"("),
        sep(map(v.fields, |field: RecField| flat_expr(input, field.value)), b", "),
        Some(b")"),
      ])
    } else {
      cat([
        Some(b"{ "),
        sep(map(v.fields, |field: RecField| flat_field(input, field, len(v.fields) > 1)), b", "),
        Some(b" }"),
      ])
    },
    ERecordUpdate(v) ->
      cat([
        Some(b"{ .."),
        flat_expr(input, v.base),
        Some(if len(v.fields) == 0 { b"" } else { b", " }),
        sep(map(v.fields, |field: RecField| flat_field(input, field, true)), b", "),
        Some(b" }"),
      ]),
    ETry(v) -> cat([wrap(flat_expr(input, v.operand), parens_postfix(v.operand)), Some(b"?")]),
    EField(v) ->
      cat([
        wrap(flat_expr(input, v.base), parens_postfix(v.base)),
        Some(bytes_concat(b".", v.field.name)),
      ]),
    EList(v) -> if len(v.items) == 0 { Some(b"[]") }
    else { cat([Some(b"["), sep(map(v.items, |x: Expr| flat_expr(input, x)), b", "), Some(b"]")]) },
    EPerform(v) ->
      cat([
        Some(perform_head(v.eff, v.op, v.resource)),
        Some(b"("),
        sep(map(v.args, |x: Expr| flat_expr(input, x)), b", "),
        Some(b")"),
      ]),
    EHandle(v) ->
      cat([
        Some(b"handle "),
        flat_expr(input, v.body),
        Some(b" with "),
        flat_clauses(input, v.clauses, v.ret),
      ]),
    EWithCell(v) ->
      cat([
        Some(bytes_concat_all([b"with_cell[", v.resource.name, b"]("])),
        flat_expr(input, v.init),
        Some(bytes_concat_all([b") { ", v.binder.name, b" -> "])),
        flat_expr(input, v.body),
        Some(b" }"),
      ]),
    ESimulate(v) -> cat([Some(b"simulate "), flat_expr(input, v.body)]),
    ETryBlock(v) -> cat([Some(try_head(v.raise)), flat_expr(input, v.body)]),
    EParallel(v) ->
      cat([
        Some(b"parallel { "),
        sep(map(v.branches, |x: Expr| flat_expr(input, x)), b", "),
        Some(b" }"),
      ]),
    EBad(_) -> Some(b"()"),
  }

fn flat_len(p: PrintInput, expr: Expr) -> Int / {abort.raise} =
  match flat_expr(p, expr) { Some(f) -> bytes_len(f), None -> 0 }

// --- Expressions, broken across lines --------------------------------------

// `indent` is where this node's continuation lines go; `after` is what follows it on its last line.
fn expr(
  input: PrintInput,
  printer: Printer,
  e: Expr,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} = laid(input, printer, e, indent, indent + 2, after)

// `cont` is where a broken operator chain puts its lines: one level in from where the chain began,
// and that level however its operators nest, so a wrapped chain does not step rightwards.
// A node that starts mid-line with comments before it moves to a line of its own, one level in,
// which is where a second pass finds it again.
fn laid(
  input: PrintInput,
  printer: Printer,
  e: Expr,
  indent: Int,
  cont: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let sp = expr_span(e);
  // On its own line the node starts at the indent, so it is laid out there.
  if printer.column > indent && comment_before(input, printer, sp.start) {
    laid_here(input, nl(printer, indent + 2, false), e, indent + 2, indent + 4, after)
  } else { laid_here(input, printer, e, indent, cont, after) }
}

fn laid_here(
  input: PrintInput,
  printer: Printer,
  e: Expr,
  indent: Int,
  cont: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let sp = expr_span(e);
  let s0 = lead(input, printer, sp.start, indent);
  let s1 = match try_flat(input, s0, flat_expr(input, e), sp.end, after) {
    Some(f) -> emit(s0, f),
    None -> broken(input, s0, e, indent, cont, after),
  };
  absorb(input, s1, sp.end)
}

fn operand(
  input: PrintInput,
  printer: Printer,
  e: Expr,
  parens: Bool,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} =
  if parens { emit(expr(input, emit(printer, b"("), e, indent, after + 1), b")") }
  else { expr(input, printer, e, indent, after) }

fn scrutinee(
  input: PrintInput,
  printer: Printer,
  expr: Expr,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} = operand(input, printer, expr, starts_with_brace(expr), indent, after)

// The operator opens every line of a broken chain after the first, and each of them sits at `cont`,
// whether what nests there is a tighter operator or a bracketed group.
fn chain(
  input: PrintInput,
  printer: Printer,
  lhs: Expr,
  op: Bytes,
  rhs: Expr,
  cont: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let s1 = chain_operand(input, printer, lhs, parens_operand(lhs, op, false), cont, 0);
  let s2 = emit(nl(s1, cont, false), bytes_concat(op_text(op), b" "));
  chain_operand(input, s2, rhs, parens_operand(rhs, op, true), cont, after)
}

fn chain_operand(
  input: PrintInput,
  printer: Printer,
  expr: Expr,
  parens: Bool,
  cont: Int,
  after: Int,
) -> Printer / {abort.raise} =
  if parens { emit(laid(input, emit(printer, b"("), expr, cont, cont, after + 1), b")") }
  else { laid(input, printer, expr, cont, cont, after) }

fn broken(
  input: PrintInput,
  printer: Printer,
  expr: Expr,
  indent: Int,
  cont: Int,
  after: Int,
) -> Printer / {abort.raise} =
  match interpolated(input, expr) {
    Some(text) -> emit(printer, text),
    None -> broken_node(input, printer, expr, indent, cont, after),
  }

fn broken_node(
  input: PrintInput,
  printer: Printer,
  expr: Expr,
  indent: Int,
  cont: Int,
  after: Int,
) -> Printer / {abort.raise} =
  match expr {
    ELit(v) -> match v.lit {
      LStr(value) -> if is_lines(input, expr) { line_string(printer, value, indent, cont) }
      else { emit(printer, lit_text(input, v.span, v.lit)) },
      _ -> emit(printer, lit_text(input, v.span, v.lit)),
    },
    EVar(v) -> emit(printer, qname_text(v.name)),
    EBinary(v) -> chain(input, printer, v.lhs, v.op, v.rhs, cont, after),
    EUnary(v) ->
      operand(
        input,
        emit(printer, unary_text(v.op)),
        v.operand,
        parens_unary(v.operand),
        indent,
        after,
      ),
    ELambda(v) -> lambda(input, printer, v.params, v.ret, v.body, indent, after),
    EApp(v) -> match literal_of(input, expr) {
      Some(m) -> literal(input, printer, m, indent),
      None -> {
        let ls = call_labels(v.labels);
        let s1 = operand(input, printer, v.func, parens_callee(v.func), indent, 1 + bytes_len(ls));
        call(input, emit(s1, ls), v.args, v.named, v.span, indent, after)
      },
    },
    EIf(v) -> if_chain(input, printer, v, indent, after),
    EMatch(v) -> match_expr(input, printer, v.scrutinee, v.arms, v.span, indent),
    EBlock(v) -> block_of(input, printer, v, indent),
    ERecord(v) -> if is_tuple(v.fields) {
      elements(
        input,
        printer,
        b"(",
        map(v.fields, |field: RecField| field.value),
        b")",
        v.span,
        indent,
      )
    } else { record(input, printer, None, v.fields, v.span, indent) },
    ERecordUpdate(v) -> record(input, printer, Some(v.base), v.fields, v.span, indent),
    ETry(v) ->
      emit(operand(input, printer, v.operand, parens_postfix(v.operand), indent, after + 1), b"?"),
    EField(v) ->
      emit(
        operand(
          input,
          printer,
          v.base,
          parens_postfix(v.base),
          indent,
          after + 1 + bytes_len(v.field.name),
        ),
        bytes_concat(b".", v.field.name),
      ),
    EList(v) -> elements(input, printer, b"[", v.items, b"]", v.span, indent),
    EPerform(v) ->
      call(
        input,
        emit(printer, perform_head(v.eff, v.op, v.resource)),
        v.args,
        [],
        v.span,
        indent,
        after,
      ),
    EHandle(v) -> handle_expr(input, printer, v.body, v.clauses, v.ret, v.span, indent),
    EWithCell(v) -> cell_expr(input, printer, v.resource, v.init, v.binder, v.body, v.span, indent),
    ESimulate(v) -> block(input, emit(printer, b"simulate "), v.body, indent),
    ETryBlock(v) -> block(input, emit(printer, try_head(v.raise)), v.body, indent),
    // Trailing comments are read from the end of the keyword, where the braces' own span would start.
    EParallel(v) ->
      elements(
        input,
        emit(printer, b"parallel "),
        b"{",
        v.branches,
        b"}",
        { ..v.span, start: v.span.start + 7 },
        indent,
      ),
    EBad(_) -> emit(printer, b"()"),
  }

// A block always breaks: `{`, its statements and tail one per line, `}` back at `indent`.
fn block(input: PrintInput, printer: Printer, e: Expr, indent: Int) -> Printer / {abort.raise} =
  match e {
    EBlock(v) -> block_of(input, printer, v, indent),
    _ -> expr(input, printer, e, indent, 0),
  }

fn block_of(
  input: PrintInput,
  printer: Printer,
  v: { span: Span, tail: Option<Expr>, stmts: List<Stmt> },
  indent: Int,
) -> Printer / {abort.raise} = {
  let has_tail = match v.tail { Some(_) -> true, None -> false };
  if len(v.stmts) == 0 && !has_tail && !comment_before(input, printer, v.span.end) {
    emit(printer, b"{}")
  } else {
    let s1 = set_prev(trail(input, emit(printer, b"{"), v.span.start + 1), v.span.start + 1);
    let s2 = fold(v.stmts, s1, |s: Printer, x: Stmt| stmt(input, s, x, indent + 2));
    let s3 = match v.tail {
      Some(t) -> {
        let tsp = expr_span(t);
        let s = expr(input, open_line(input, s2, tsp.start, indent + 2, true), t, indent + 2, 0);
        trail(input, set_prev(s, tsp.end), tsp.end)
      },
      None -> s2,
    };
    close(input, s3, v.span.end, indent, b"}")
  }
}

fn stmt(input: PrintInput, printer: Printer, x: Stmt, indent: Int) -> Printer / {abort.raise} =
  match x {
    SLet(v) -> {
      let s1 = open_line(input, printer, v.span.start, indent, true);
      let ty = match v.ty { Some(t) -> bytes_concat(b": ", type_text(input, t)), None -> b"" };
      let s2 = emit(s1, bytes_concat_all([b"let ", pattern_text(input, v.pat), ty, b" = "]));
      let s4 = emit(expr(input, s2, v.value, indent, 1), b";");
      trail(input, set_prev(s4, v.span.end), v.span.end)
    },
    SLetElse(v) -> {
      let s1 = open_line(input, printer, v.span.start, indent, true);
      let ty = match v.ty { Some(t) -> bytes_concat(b": ", type_text(input, t)), None -> b"" };
      let s2 = emit(s1, bytes_concat_all([b"let ", pattern_text(input, v.pat), ty, b" = "]));
      let s3 = emit(expr(input, s2, v.value, indent, 7), b" else ");
      // A short `else` stays on the line, as an `if` branch does.
      let s4 = emit(branch(input, s3, v.fallback, indent, 1).printer, b";");
      trail(input, set_prev(s4, v.span.end), v.span.end)
    },
    SExpr(e) -> {
      let sp = expr_span(e);
      let s1 = open_line(input, printer, sp.start, indent, true);
      let s2 = emit(expr(input, s1, e, indent, 1), b";");
      trail(input, set_prev(s2, sp.end), sp.end)
    },
  }

fn lambda(
  input: PrintInput,
  printer: Printer,
  params: List<Param>,
  ret: Option<TypeExpr>,
  body: Expr,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let s1 = emit(printer, lambda_head(input, params, ret));
  let sp = expr_span(body);
  match body {
    EBlock(v) -> block_of(input, emit(s1, b" "), v, indent),
    _ -> match try_flat(input, s1, flat_expr(input, body), sp.end, after + 1) {
      Some(f) -> emit(emit(s1, b" "), f),
      None -> expr(input, nl(s1, indent + 2, false), body, indent + 2, after),
    },
  }
}

// One that starts short and ends with its own closer, so it may hug the call's parentheses.
fn huggable(expr: Expr) -> Bool =
  match expr {
    ELambda(_) -> true,
    ERecord(_) -> true,
    ERecordUpdate(_) -> true,
    EList(_) -> true,
    _ -> is_block_like(expr),
  }

fn head_width(input: PrintInput, expr: Expr) -> Int / {abort.raise} =
  match expr {
    ELambda(v) -> bytes_len(lambda_head(input, v.params, v.ret)) + 2,
    EMatch(v) -> 8 + flat_len(input, v.scrutinee),
    EIf(v) -> 5 + flat_len(input, v.cond),
    EHandle(_) -> 8,
    EWithCell(v) ->
      16 + bytes_len(v.resource.name) + flat_len(input, v.init) + bytes_len(v.binder.name),
    _ -> 1,
  }

// After the callee: the last argument hugs the parentheses when it can, else one argument per line.
fn call(
  input: PrintInput,
  printer: Printer,
  args: List<Expr>,
  named: List<NamedArg>,
  span: Span,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let n = len(args);
  let hugged = match list_at(args, n - 1) {
    Some(last) -> if len(named) == 0 && huggable(last)
        && !comment_before(input, printer, expr_span(last).start) {
      let prefix = sep(map(range(0, n - 1), |i: Int| flat_expr(input, at(args, i))), b", ");
      match prefix {
        Some(pre) -> {
          let text = bytes_concat(b"(", if n > 1 { bytes_concat(pre, b", ") } else { pre });
          if fits(printer, text, head_width(input, last) + after + 1) { Some(text) } else { None }
        },
        None -> None,
      }
    } else { None },
    None -> None,
  };
  match hugged {
    Some(text) -> emit(expr(input, emit(printer, text), at(args, n - 1), indent, after + 1), b")"),
    None -> {
      let s1 = emit(printer, b"(");
      let s2 = fold(range(0, n), s1, |s: Printer, i: Int|
        element(input, s, at(args, i), indent + 2, i == n - 1 && len(named) == 0));
      let s3 = fold(range(0, len(named)), s2, |s: Printer, i: Int| {
        let a = at(named, i);
        let o = emit(
          open_line(input, s, a.span.start, indent + 2, false),
          bytes_concat(a.name.name, b": "),
        );
        let v = separated(
          input,
          expr(input, o, a.value, indent + 2, 1),
          a.value,
          i == len(named) - 1,
        );
        trail(input, set_prev(v, a.span.end), a.span.end)
      });
      close(input, s3, span.end, indent, b")")
    },
  }
}

fn element(
  input: PrintInput,
  printer: Printer,
  e: Expr,
  indent: Int,
  last: Bool,
) -> Printer / {abort.raise} = {
  let sp = expr_span(e);
  let s = separated(
    input,
    expr(input, open_line(input, printer, sp.start, indent, false), e, indent, 1),
    e,
    last,
  );
  trail(input, set_prev(s, sp.end), sp.end)
}

// A list's separator, except after a last line string, where it would need a line to itself.
fn separated(
  input: PrintInput,
  printer: Printer,
  expr: Expr,
  last: Bool,
) -> Printer / {abort.raise} =
  if last && is_lines(input, expr) { printer } else { emit(printer, b",") }

fn elements(
  input: PrintInput,
  printer: Printer,
  open: Bytes,
  items: List<Expr>,
  closer: Bytes,
  span: Span,
  indent: Int,
) -> Printer / {abort.raise} = {
  let s1 = set_prev(trail(input, emit(printer, open), span.start + 1), span.start + 1);
  let s2 = fold(range(0, len(items)), s1, |s: Printer, i: Int|
    element(input, s, at(items, i), indent + 2, i == len(items) - 1));
  close(input, s2, span.end, indent, closer)
}

// A map or set literal the parser built a `map_of_entries` call of: the source still opens it with
// `#{` or `#[`, which a call spelled out never does.
type Literal = { set: Bool, items: List<Expr>, span: Span }

fn literal_of(input: PrintInput, e: Expr) -> Option<Literal> / {abort.raise} =
  match e {
    EApp(a) -> match a.func {
      EVar(f) -> if f.name.module != None || f.name.name.name != b"map_of_entries" { None } else {
        let opener = bytes_slice(input.source, a.span.start, a.span.start + 2);
        match a.args {
          [EList(l)] -> if opener == b"#{" || opener == b"#[" {
            Some({ set: opener == b"#[", items: l.items, span: a.span })
          } else { None },
          _ -> None,
        }
      },
      _ -> None,
    },
    _ -> None,
  }

// The parser writes each entry of a literal as a record of its key and value; an item it did not
// write so is its own key and value.
fn entry_parts(x: Expr) -> Option<{ key: Expr, value: Expr }> =
  match x {
    ERecord(r) -> match field_of(r.fields, b"key") {
      Some(k) -> match field_of(r.fields, b"value") {
        Some(v) -> Some({ key: k, value: v }),
        None -> None,
      },
      None -> None,
    },
    _ -> None,
  }

fn field_of(fields: List<RecField>, name: Bytes) -> Option<Expr> =
  fold(fields, None, |acc: Option<Expr>, field: RecField|
    if field.name.name == name { Some(field.value) } else { acc })

fn flat_literal(input: PrintInput, m: Literal) -> Option<Bytes> / {abort.raise} =
  if m.set {
    cat([
      Some(b"#["),
      sep(
        map(m.items, |x: Expr|
          match entry_parts(x) {
            Some(en) -> flat_expr(input, en.key),
            None -> flat_expr(input, x),
          }),
        b", ",
      ),
      Some(b"]"),
    ])
  } else {
    let entry = |key: Expr, value: Expr|
      cat([flat_expr(input, key), Some(b": "), flat_expr(input, value)]);
    cat([
      Some(b"#{"),
      sep(
        map(m.items, |x: Expr|
          match entry_parts(x) { Some(en) -> entry(en.key, en.value), None -> entry(x, x) }),
        b", ",
      ),
      Some(b"}"),
    ])
  }

// One entry a line, as a record's fields are; a key stays on its line, flat.
fn literal(p: PrintInput, printer: Printer, m: Literal, indent: Int) -> Printer / {abort.raise} = {
  let open = if m.set { b"#[" } else { b"#{" };
  let s1 = set_prev(trail(p, emit(printer, open), m.span.start + 2), m.span.start + 2);
  let n = len(m.items);
  let s2 = fold(range(0, n), s1, |s: Printer, i: Int| {
    let entry = |key: Expr, value: Expr| {
      let ks = expr_span(key);
      let o = open_line(p, s, ks.start, indent + 2, false);
      if m.set {
        let v = separated(p, expr(p, o, key, indent + 2, 1), key, i == n - 1);
        trail(p, set_prev(v, ks.end), ks.end)
      } else {
        let vs = expr_span(value);
        let k = match flat_expr(p, key) { Some(f) -> f, None -> b"()" };
        let v = separated(
          p,
          expr(p, emit(o, bytes_concat(k, b": ")), value, indent + 2, 1),
          value,
          i == n - 1,
        );
        trail(p, set_prev(v, vs.end), vs.end)
      }
    };
    match list_at(m.items, i) {
      None -> s,
      Some(x) -> match entry_parts(x) { Some(en) -> entry(en.key, en.value), None -> entry(x, x) },
    }
  });
  close(p, s2, m.span.end, indent, if m.set { b"]" } else { b"}" })
}

fn record(
  p: PrintInput,
  printer: Printer,
  base: Option<Expr>,
  fields: List<RecField>,
  span: Span,
  indent: Int,
) -> Printer / {abort.raise} = {
  let s1 = set_prev(trail(p, emit(printer, b"{"), span.start + 1), span.start + 1);
  let s2 = match base {
    Some(base_expr) -> {
      let bsp = expr_span(base_expr);
      let text = match flat_expr(p, base_expr) { Some(f) -> f, None -> b"()" };
      let s = emit(
        open_line(p, s1, bsp.start, indent + 2, false),
        bytes_concat_all([b"..", text, b","]),
      );
      trail(p, set_prev(s, bsp.end), bsp.end)
    },
    None -> s1,
  };
  let s3 = fold(range(0, len(fields)), s2, |s: Printer, i: Int| {
    let f = at(fields, i);
    let vsp = expr_span(f.value);
    let o = open_line(p, s, f.name.span.start, indent + 2, false);
    let v = if punned(f) { emit(o, bytes_concat(f.name.name, b",")) } else {
      let named = emit(o, bytes_concat(f.name.name, b": "));
      separated(p, expr(p, named, f.value, indent + 2, 1), f.value, i == len(fields) - 1)
    };
    trail(p, set_prev(v, vsp.end), vsp.end)
  });
  close(p, s3, span.end, indent, b"}")
}

// A printed branch and whether its body had to open a block rather than stay on the branch's line.
type Branch = { opened: Bool, printer: Printer }

fn branch(
  input: PrintInput,
  printer: Printer,
  expr: Expr,
  indent: Int,
  after: Int,
) -> Branch / {abort.raise} = {
  let sp = expr_span(expr);
  match try_flat(input, printer, flat_expr(input, expr), sp.end, after) {
    Some(f) -> { opened: false, printer: emit(printer, f) },
    None -> { opened: true, printer: block(input, printer, expr, indent) },
  }
}

// What follows a branch on its line: the chain's follower once no `else` comes after it.
fn ending(expr: Expr, after: Int) -> Int = match expr { ELit(_) -> after, _ -> 0 }

fn fits_alone(input: PrintInput, expr: Expr, indent: Int, after: Int) -> Bool / {abort.raise} = {
  let head = match expr {
    EIf(v) ->
      cat([
        Some(b"if "),
        flat_scrutinee(input, v.cond),
        Some(b" "),
        flat_expr(input, v.then_branch),
      ]),
    _ -> flat_expr(input, expr),
  };
  let tail = match expr { EIf(v) -> ending(v.else_branch, after), _ -> after };
  match head { Some(f) -> indent + 5 + bytes_len(f) + tail <= width(), None -> false }
}

fn fits_opening(input: PrintInput, printer: Printer, expr: Expr) -> Bool / {abort.raise} = {
  let opening = match expr {
    EIf(v) -> cat([Some(b" else if "), flat_scrutinee(input, v.cond), Some(b" {")]),
    _ -> Some(b" else {"),
  };
  match opening { Some(o) -> fits(printer, o, 0), None -> false }
}

// Before a block, `else` joins the line only where the opening fits: no condition breaks for it.
fn otherwise(
  input: PrintInput,
  b: Branch,
  expr: Expr,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let start = expr_span(expr).start;
  if comment_before(input, b.printer, start) {
    emit(open_line(input, b.printer, start, indent, false), b"else ")
  } else if b.opened
      || (!fits_alone(input, expr, indent, after) && fits_opening(input, b.printer, expr)) {
    emit(b.printer, b" else ")
  } else { emit(nl(b.printer, indent, false), b"else ") }
}

// A chain the width forced open, one branch to a line.
fn if_chain(
  input: PrintInput,
  printer: Printer,
  v: { span: Span, cond: Expr, then_branch: Expr, else_branch: Expr },
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let s1 = scrutinee(input, emit(printer, b"if "), v.cond, indent + 2, 2);
  let o = v.else_branch;
  let b = branch(input, emit(s1, b" "), v.then_branch, indent, ending(o, after));
  match o {
    ELit(_) -> b.printer,
    EIf(w) -> if_chain(input, otherwise(input, b, o, indent, after), w, indent, after),
    _ -> branch(input, otherwise(input, b, o, indent, after), o, indent, after).printer,
  }
}

fn match_expr(
  input: PrintInput,
  printer: Printer,
  scrut: Expr,
  arms: List<MatchArm>,
  span: Span,
  indent: Int,
) -> Printer / {abort.raise} = {
  let s1 = emit(scrutinee(input, emit(printer, b"match "), scrut, indent + 2, 2), b" {");
  let s2 = fold(range(0, len(arms)), s1, |s: Printer, i: Int|
    arm(input, s, at(arms, i), indent + 2, i == len(arms) - 1));
  close(input, s2, span.end, indent, b"}")
}

fn arm(
  input: PrintInput,
  printer: Printer,
  a: MatchArm,
  indent: Int,
  last: Bool,
) -> Printer / {abort.raise} = {
  let s1 = emit(open_line(input, printer, a.span.start, indent, false), pattern_text(input, a.pat));
  let s2 = match a.guard {
    Some(g) -> expr(input, emit(s1, b" if "), g, indent + 2, 3),
    None -> s1,
  };
  let s4 = separated(input, arm_body(input, emit(s2, b" ->"), a.body, indent), a.body, last);
  trail(input, set_prev(s4, a.span.end), a.span.end)
}

// After `->`: the body on the same line when it fits or opens a block, else on the next.
fn arm_body(
  input: PrintInput,
  printer: Printer,
  body: Expr,
  indent: Int,
) -> Printer / {abort.raise} = {
  let sp = expr_span(body);
  match try_flat(input, printer, flat_expr(input, body), sp.end, 2) {
    Some(f) -> emit(emit(printer, b" "), f),
    None -> if is_block_like(body) || (match body { ELambda(_) -> true, _ -> false }) {
      expr(input, emit(printer, b" "), body, indent, 1)
    } else { expr(input, nl(printer, indent + 2, false), body, indent + 2, 1) },
  }
}

fn handle_expr(
  input: PrintInput,
  printer: Printer,
  body: Expr,
  clauses: List<HandleClause>,
  ret: Option<ReturnClause>,
  span: Span,
  indent: Int,
) -> Printer / {abort.raise} = {
  let s1 = emit(printer, b"handle ");
  let s2 = match body {
    EBlock(v) -> block_of(input, s1, v, indent),
    _ -> expr(input, s1, body, indent + 2, 7),
  };
  let s3 = emit(s2, b" with {");
  let s4 = fold(range(0, len(clauses)), s3, |s: Printer, i: Int| {
    let c = at(clauses, i);
    let o = emit(
      open_line(input, s, c.span.start, indent + 2, false),
      bytes_concat(clause_head(c), b" ->"),
    );
    let last = i == len(clauses) - 1 && (match ret { Some(_) -> false, None -> true });
    let bd = separated(input, arm_body(input, o, c.body, indent + 2), c.body, last);
    trail(input, set_prev(bd, c.span.end), c.span.end)
  });
  let s5 = match ret {
    Some(r) -> {
      let o = emit(
        open_line(input, s4, r.span.start, indent + 2, false),
        bytes_concat_all([b"return ", r.binder.name, b" ->"]),
      );
      let bd = separated(input, arm_body(input, o, r.body, indent + 2), r.body, true);
      trail(input, set_prev(bd, r.span.end), r.span.end)
    },
    None -> s4,
  };
  close(input, s5, span.end, indent, b"}")
}

fn cell_expr(
  input: PrintInput,
  printer: Printer,
  resource: Ident,
  init: Expr,
  binder: Ident,
  body: Expr,
  span: Span,
  indent: Int,
) -> Printer / {abort.raise} = {
  let s1 = emit(printer, bytes_concat_all([b"with_cell[", resource.name, b"]("]));
  let s2 = emit(
    expr(input, s1, init, indent + 2, 1),
    bytes_concat_all([b") { ", binder.name, b" ->"]),
  );
  let bsp = expr_span(body);
  match body {
    EBlock(_) -> emit(block(input, emit(s2, b" "), body, indent), b" }"),
    _ -> match try_flat(input, s2, flat_expr(input, body), bsp.end, 3) {
      Some(f) -> emit(s2, bytes_concat_all([b" ", f, b" }"])),
      None -> {
        let s3 = expr(input, nl(s2, indent + 2, false), body, indent + 2, 0);
        emit(nl(flush_comments(input, s3, span.end, indent + 2, false), indent, false), b"}")
      },
    },
  }
}

// --- Items ------------------------------------------------------------------

fn module(input: PrintInput, m: Module) -> Bytes / {abort.raise} = {
  let st0 = { next_comment: 0, column: 0, previous_end: 0, pending: [], closed: -1, parts: [] };
  let s1 = fold(filter(m.imports, is_written), st0, |printer: Printer, decl: ImportDecl|
    import_decl(input, printer, decl));
  let s2 = fold(m.items, s1, |printer: Printer, it: Item| item(input, printer, it));
  finish(flush_comments(input, s2, bytes_len(input.source) + 1, 0, true))
}

fn import_decl(input: PrintInput, printer: Printer, decl: ImportDecl) -> Printer / {abort.raise} = {
  let s1 = open_line(input, printer, decl.span.start, 0, true);
  let base = bytes_concat(b"import ", join(map(decl.path, |ident: Ident| ident.name), b"."));
  let s2 = match decl.kind {
    IModule -> emit(s1, base),
    IAlias(a) -> emit(s1, bytes_concat_all([base, b" as ", a.name])),
    INames(ns) -> fill(emit(s1, bytes_concat(base, b" (")), map(ns, |ident: Ident| ident.name)),
  };
  trail(input, set_prev(absorb(input, s2, decl.span.end), decl.span.end), decl.span.end)
}

// Names packed onto lines, continuation lines aligned under the first.
fn fill(printer: Printer, names: List<Bytes>) -> Printer / {abort.raise} = {
  let col0 = printer.column;
  let n = len(names);
  fold(range(0, n), printer, |s: Printer, i: Int| {
    let piece = bytes_concat(at(names, i), if i == n - 1 { b")" } else { b"," });
    if i == 0 { emit(s, piece) }
    else if fits(s, piece, 1) { emit(s, bytes_concat(b" ", piece)) }
    else { emit(nl(s, col0, false), piece) }
  })
}

fn vis_text(v: Vis) -> Bytes = match v { VPub -> b"pub ", VPriv -> b"" }

fn constraint_text(c: Constraint) -> Bytes = constraint_written(c.deriver, c.param.name)

fn item(input: PrintInput, printer: Printer, it: Item) -> Printer / {abort.raise} = {
  let sp = item_span(it);
  let s1 = open_line(input, printer, sp.start, 0, true);
  let s2 = match it {
    IFn(d) -> fn_def(input, s1, d),
    IType(d) -> type_def(input, s1, d),
    IEffect(d) -> effect_def(input, s1, d),
    ITest(d) -> test_def(input, s1, d),
    ILaw(d) -> law_def(input, s1, d),
    IDerive(d) ->
      emit(s1, bytes_concat_all([b"derive ", deriver_text(d.deriver), b" for ", d.target.name])),
    IEffectSet(d) ->
      emit(
        s1,
        bytes_concat_all([
          vis_text(d.vis),
          b"effect set ",
          d.name.name,
          b" = {",
          join(members(d.atoms, d.includes), b", "),
          b"}",
        ]),
      ),
    IExtern(d) -> extern_def(input, s1, d),
  };
  trail(input, set_prev(absorb(input, s2, sp.end), sp.end), sp.end)
}

// A body after `= `: on the line when it fits, hugging when it is a block, else on the next.
fn def_body(input: PrintInput, printer: Printer, e: Expr, indent: Int) -> Printer / {abort.raise} = {
  let sp = expr_span(e);
  if comment_before(input, printer, sp.start) {
    expr(input, nl(printer, indent + 2, false), e, indent + 2, 0)
  } else {
    match try_flat(input, printer, flat_expr(input, e), sp.end, 0) {
      Some(f) -> emit(printer, f),
      None -> match e {
        EBlock(v) -> block_of(input, printer, v, indent),
        _ -> expr(input, nl(printer, indent + 2, false), e, indent + 2, 0),
      },
    }
  }
}

fn flat_param(input: PrintInput, param: Param) -> Option<Bytes> / {abort.raise} =
  match param.default {
    Some(e) -> cat([Some(bytes_concat(param_head(input, param), b" = ")), flat_expr(input, e)]),
    None -> Some(param_head(input, param)),
  }

fn param(input: PrintInput, printer: Printer, x: Param, indent: Int) -> Printer / {abort.raise} = {
  let s1 = emit(open_line(input, printer, x.span.start, indent, false), param_head(input, x));
  let s2 = match x.default {
    Some(e) -> expr(input, absorb(input, emit(s1, b" = "), expr_span(e).start), e, indent, 1),
    None -> absorb(input, s1, x.span.end),
  };
  trail(input, set_prev(emit(s2, b","), x.span.end), x.span.end)
}

fn fn_def(input: PrintInput, printer: Printer, def: FnDef) -> Printer / {abort.raise} = {
  let reuse_kw = match def.reuse { Some(_) -> b"reuse ", None -> b"" };
  let transparent_kw = match def.transparent { Some(_) -> b"transparent ", None -> b"" };
  let head = bytes_concat_all([
    vis_text(def.vis),
    transparent_kw,
    reuse_kw,
    b"fn ",
    def.name.name,
    generics_text(def.generics),
  ]);
  let ret = match def.ret { Some(t) -> bytes_concat(b" -> ", type_text(input, t)), None -> b"" };
  let tail = bytes_concat(ret, row_suffix(input, def.effects));
  let clauses = len(def.constraints) > 0 || len(def.spec) > 0 || def.returns != None
    || (match def.decreases { Some(_) -> true, None -> false });
  let params_end = match list_at(def.params, len(def.params) - 1) {
    Some(x) -> x.span.end,
    None -> def.name.span.end,
  };
  let s1 = emit(printer, head);
  let flat = cat([
    Some(b"("),
    sep(map(def.params, |x: Param| flat_param(input, x)), b", "),
    Some(b")"),
    Some(tail),
  ]);
  let fit = if len(def.params) == 0 { flat }
  else { try_flat(input, s1, flat, params_end, if clauses { 0 } else { 2 }) };
  let s2 = match fit {
    Some(f) -> emit(s1, f),
    None -> {
      let ps = fold(def.params, emit(s1, b"("), |s: Printer, x: Param| param(input, s, x, 2));
      emit(close(input, ps, params_end, 0, b")"), tail)
    },
  };
  let s3 = if len(def.constraints) == 0 { s2 } else {
    emit(
      nl(s2, 2, false),
      bytes_concat(b"where ", join(map(def.constraints, constraint_text), b", ")),
    )
  };
  let s35 = match def.returns {
    None -> s3,
    Some(ReturnsFresh(_)) -> emit(nl(s3, 2, false), b"returns fresh"),
    Some(ReturnsParam(x)) -> emit(nl(s3, 2, false), bytes_concat(b"returns ", x.name)),
  };
  let s4 = fold(def.spec, s35, |s: Printer, clause: SpecClause| {
    let o = emit(
      open_line(input, s, clause.span.start, 2, false),
      bytes_concat(spec_kind_text(clause.kind), b" "),
    );
    let e = expr(input, o, clause.expr, 2, 0);
    trail(input, set_prev(e, clause.span.end), clause.span.end)
  });
  let s45 = match def.decreases {
    None -> s4,
    Some(m) -> {
      let span = expr_span(m);
      let o = emit(open_line(input, s4, span.start, 2, false), b"decreases ");
      trail(input, set_prev(expr(input, o, m, 2, 0), span.end), span.end)
    },
  };
  let s5 = if clauses { emit(nl(s45, 0, false), b"= ") } else { emit(s45, b" = ") };
  def_body(input, s5, def.body, 0)
}

fn extern_def(input: PrintInput, printer: Printer, def: ExternDef) -> Printer / {abort.raise} = {
  let head = bytes_concat_all([b"extern fn ", def.name.name, generics_text(def.generics)]);
  let tail = bytes_concat_all([b" -> ", type_text(input, def.ret), row_suffix(input, def.effects)]);
  let params_end = match list_at(def.params, len(def.params) - 1) {
    Some(x) -> x.span.end,
    None -> def.name.span.end,
  };
  let s1 = emit(printer, head);
  let flat = cat([
    Some(b"("),
    sep(map(def.params, |x: Param| flat_param(input, x)), b", "),
    Some(b")"),
    Some(tail),
  ]);
  let fit = if len(def.params) == 0 { flat } else { try_flat(input, s1, flat, params_end, 0) };
  let s2 = match fit {
    Some(f) -> emit(s1, f),
    None -> {
      let ps = fold(def.params, emit(s1, b"("), |s: Printer, x: Param| param(input, s, x, 2));
      emit(close(input, ps, params_end, 0, b")"), tail)
    },
  };
  if len(def.constraints) == 0 { s2 } else {
    emit(
      nl(s2, 2, false),
      bytes_concat(b"where ", join(map(def.constraints, constraint_text), b", ")),
    )
  }
}

fn variant_text(input: PrintInput, variant: VariantDef) -> Bytes / {abort.raise} =
  if len(variant.fields) == 0 { variant.name.name } else {
    bytes_concat_all([
      variant.name.name,
      b"(",
      join(map(variant.fields, |ty: TypeExpr| type_text(input, ty)), b", "),
      b")",
    ])
  }

fn record_type(
  input: PrintInput,
  printer: Printer,
  fields: List<{ name: Ident, ty: TypeExpr }>,
  span: Span,
  indent: Int,
) -> Printer / {abort.raise} = {
  let s1 = set_prev(trail(input, emit(printer, b"{"), span.start + 1), span.start + 1);
  let s2 = fold(fields, s1, |s: Printer, f: { name: Ident, ty: TypeExpr }| {
    let tsp = ty_span(f.ty);
    let o = emit(
      open_line(input, s, f.name.span.start, indent + 2, false),
      bytes_concat(ty_field_text(input, f), b","),
    );
    trail(input, set_prev(absorb(input, o, tsp.end), tsp.end), tsp.end)
  });
  close(input, s2, span.end, indent, b"}")
}

fn type_def(input: PrintInput, printer: Printer, d: TypeDef) -> Printer / {abort.raise} = {
  let params = generics_text(d.generics);
  let s1 = emit(
    printer,
    bytes_concat_all([vis_text(d.vis), b"type ", d.name.name, params, b" = "]),
  );
  match d.body {
    TDAlias(t) -> match t {
      TRecord(r) -> if is_ty_tuple(r.fields) { emit(s1, type_text(input, t)) } else {
        match try_flat(input, s1, Some(type_text(input, t)), r.span.end, 0) {
          Some(f) -> emit(s1, f),
          None -> record_type(input, s1, r.fields, r.span, 0),
        }
      },
      _ -> emit(s1, type_text(input, t)),
    },
    TDSum(vs) -> {
      let flat = bytes_concat(
        b"| ",
        join(map(vs, |variant: VariantDef| variant_text(input, variant)), b" | "),
      );
      match try_flat(input, s1, Some(flat), d.span.end, 0) {
        Some(f) -> emit(s1, f),
        None ->
          fold(vs, s1, |s: Printer, variant: VariantDef| {
            let o = emit(
              open_line(input, s, variant.span.start, 2, false),
              bytes_concat(b"| ", variant_text(input, variant)),
            );
            trail(
              input,
              set_prev(absorb(input, o, variant.span.end), variant.span.end),
              variant.span.end,
            )
          }),
      }
    },
  }
}

fn ident_chars() -> Bytes = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

fn is_ident_byte(c: Int) -> Bool =
  is_digit(c) || (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95

fn skip_ws(input: PrintInput, i: Int) -> Int / {abort.raise} =
  bytes_scan(input.source, i, b" \t\r\n", bytes_len(input.source) - i)

fn back_ws(input: PrintInput, i: Int) -> Int / {abort.raise} = back_blank(input.source, i)

fn back_blank(src: Bytes, i: Int) -> Int / {abort.raise} =
  iterate(i, i + 1, |k: Int|
    if k > 0 && (is_blank(bytes_at(src, k - 1)) || bytes_at(src, k - 1) == 10) { Continue(k - 1) }
    else { Stop(k) })

// The resource name of an operation, which the tree keeps only as a flag.
fn ident_after_bracket(input: PrintInput, i: Int) -> Bytes / {abort.raise} = {
  let j = skip_ws(input, i);
  if j < bytes_len(input.source) && bytes_at(input.source, j) == 91 {
    let k = skip_ws(input, j + 1);
    bytes_slice(
      input.source,
      k,
      bytes_scan(input.source, k, ident_chars(), bytes_len(input.source) - k),
    )
  } else { b"" }
}

// The documentation name an operation parameter may carry before its type; the tree drops it.
fn name_before(input: PrintInput, i: Int) -> Option<Bytes> / {abort.raise} = {
  let j = back_ws(input, i);
  if j > 0 && bytes_at(input.source, j - 1) == 58 {
    let e = back_ws(input, j - 1);
    let s = iterate(e, e + 1, |k: Int|
      if k > 0 && is_ident_byte(bytes_at(input.source, k - 1)) { Continue(k - 1) }
      else { Stop(k) });
    if s < e { Some(bytes_slice(input.source, s, e)) } else { None }
  } else { None }
}

fn op_decl_text(input: PrintInput, op: OpDef) -> Bytes / {abort.raise} = {
  let res = if op.resource_param {
    bytes_concat_all([b"[", ident_after_bracket(input, op.name.span.end), b"]"])
  } else { b"" };
  let ps = map(op.params, |t: TypeExpr| {
    let ty = type_text(input, t);
    match name_before(input, ty_span(t).start) {
      Some(n) -> bytes_concat_all([n, b": ", ty]),
      None -> ty,
    }
  });
  bytes_concat_all([
    mode_text(op.mode),
    b" ",
    op.name.name,
    res,
    generics_text({ types: op.ty_params, effects: [], labels: [] }),
    b"(",
    join(ps, b", "),
    b")",
    if is_raise(op.mode) { b"" } else { bytes_concat(b" -> ", type_text(input, op.ret)) },
  ])
}

fn effect_def(input: PrintInput, printer: Printer, d: EffectDef) -> Printer / {abort.raise} = {
  let nd = if d.is_nondet { b"nondet " } else { b"" };
  let s1 = emit(printer, bytes_concat_all([vis_text(d.vis), nd, b"effect ", d.name.name, b" {"]));
  if len(d.ops) == 0 && !comment_before(input, s1, d.span.end) { emit(s1, b"}") } else {
    let s2 = fold(d.ops, s1, |s: Printer, op: OpDef| {
      let e = emit(open_line(input, s, op.span.start, 2, false), op_decl_text(input, op));
      trail(input, set_prev(absorb(input, e, op.span.end), op.span.end), op.span.end)
    });
    close(input, s2, d.span.end, 0, b"}")
  }
}

fn test_def(input: PrintInput, printer: Printer, d: TestDef) -> Printer / {abort.raise} = {
  let kw = if d.is_nondet { b"test/nondet " } else { b"test " };
  def_body(
    input,
    emit(
      printer,
      bytes_concat_all([kw, bytes_slice(input.source, d.name_span.start, d.name_span.end), b" "]),
    ),
    d.body,
    0,
  )
}

fn binder_text(input: PrintInput, binder: Binder) -> Bytes / {abort.raise} =
  bytes_concat_all([binder.name.name, b": ", type_text(input, binder.ty)])

fn law_def(input: PrintInput, printer: Printer, d: LawDef) -> Printer / {abort.raise} = {
  let kw = if d.host { b"law/host " } else { b"law " };
  let head = bytes_concat(kw, bytes_slice(input.source, d.name_span.start, d.name_span.end));
  let binders = if len(d.binders) == 0 { b"" } else {
    bytes_concat_all([
      b"forall (",
      join(map(d.binders, |binder: Binder| binder_text(input, binder)), b", "),
      b")",
    ])
  };
  let guard = match d.guard {
    Some(g) -> cat([Some(b" where "), flat_expr(input, g)]),
    None -> Some(b""),
  };
  let cost = match d.cost {
    Some(k) -> cat([Some(b" cost "), flat_expr(input, k)]),
    None -> Some(b""),
  };
  let flat = cat([
    Some(head),
    Some(if bytes_len(binders) == 0 { b"" } else { bytes_concat(b" ", binders) }),
    guard,
    cost,
    Some(b" "),
    flat_expr(input, d.body),
  ]);
  match try_flat(input, printer, flat, d.span.end, 0) {
    Some(f) -> emit(printer, f),
    None -> {
      let s1 = emit(printer, head);
      let quantified = bytes_len(binders) > 0 || d.guard != None || d.cost != None;
      let s2 = if bytes_len(binders) == 0 { s1 } else { emit(nl(s1, 2, false), binders) };
      let s3 = match d.guard {
        Some(g) -> match try_flat(input, s2, guard, expr_span(g).end, 2) {
          Some(f) -> emit(s2, f),
          None -> expr(input, emit(nl(s2, 2, false), b"where "), g, 2, 2),
        },
        None -> s2,
      };
      let s4 = match d.cost {
        Some(k) -> match try_flat(input, s3, cost, expr_span(k).end, 2) {
          Some(f) -> emit(s3, f),
          None -> expr(input, emit(nl(s3, 2, false), b"cost "), k, 2, 2),
        },
        None -> s3,
      };
      block(input, emit(s4, b" "), d.body, if quantified { 2 } else { 0 })
    },
  }
}

// --- One item ---------------------------------------------------------------

type Located = { start: Int, end: Int, item: Item }

fn item_kind(item: Item) -> Bytes =
  match item {
    IFn(_) -> b"fn",
    IType(_) -> b"type",
    IEffect(_) -> b"effect",
    ITest(_) -> b"test",
    ILaw(_) -> b"law",
    IDerive(_) -> b"derive",
    IEffectSet(_) -> b"effect set",
    IExtern(_) -> b"extern fn",
  }

// A test, a law or a derive has no identifier to be found by.
fn item_name(item: Item) -> Option<Bytes> =
  match item {
    IFn(d) -> Some(d.name.name),
    IType(d) -> Some(d.name.name),
    IEffect(d) -> Some(d.name.name),
    IEffectSet(d) -> Some(d.name.name),
    IExtern(d) -> Some(d.name.name),
    _ -> None,
  }

fn item_desc(item: Item) -> Bytes =
  match item_name(item) {
    Some(n) -> bytes_concat_all([b"`", item_kind(item), b"` `", n, b"`"]),
    None -> bytes_concat_all([b"a `", item_kind(item), b"`"]),
  }

fn line_start(src: Bytes, i: Int) -> Int / {abort.raise} =
  iterate(i, i + 1, |k: Int|
    if k > 0 && bytes_at(src, k - 1) != 10 { Continue(k - 1) } else { Stop(k) })

// Past the newline ending the line that holds `i`, or the end of the text.
fn line_end(src: Bytes, i: Int) -> Int / {abort.raise} =
  match bytes_index_of_from(src, b"\n", i) { Some(j) -> j + 1, None -> bytes_len(src) }

// Where the item's own text starts: at its `pub`, `transparent` or `reuse` when it has one, else its
// keyword.
fn head_start(src: Bytes, item: Item) -> Int / {abort.raise} = {
  let kw = match item {
    IFn(d) -> match d.transparent {
      Some(t) -> t.start,
      None -> match d.reuse { Some(s) -> s.start, None -> d.span.start },
    },
    _ -> item_span(item).start,
  };
  let published = match item {
    IFn(d) -> is_pub(d.vis),
    IType(d) -> is_pub(d.vis),
    IEffect(d) -> is_pub(d.vis),
    _ -> false,
  };
  let j = back_blank(src, kw);
  if published && j >= 3 && bytes_slice(src, j - 3, j) == b"pub"
      && (j == 3 || !is_ident_byte(bytes_at(src, j - 4))) { j - 3 }
  else { kw }
}

// The end of the last item or import that ends at or before `pos`.
fn floor_before(module: Module, pos: Int) -> Int = {
  let imported = fold(filter(module.imports, is_written), 0, |acc: Int, decl: ImportDecl|
    if decl.span.end <= pos && decl.span.end > acc { decl.span.end } else { acc });
  fold(module.items, imported, |acc: Int, item: Item| {
    let e = item_span(item).end;
    if e <= pos && e > acc { e } else { acc }
  })
}

// The start of the first item or import that starts at or after `pos`, else the end of the text.
fn ceiling_after(src: Bytes, module: Module, pos: Int) -> Int / {abort.raise} = {
  let imported = fold(
    filter(module.imports, is_written),
    bytes_len(src),
    |acc: Int, decl: ImportDecl|
      if decl.span.start >= pos && decl.span.start < acc { decl.span.start } else { acc },
  );
  fold(module.items, imported, |acc: Int, item: Item| {
    let s = head_start(src, item);
    if s >= pos && s < acc { s } else { acc }
  })
}

// The start of the `//` lines directly above `head` with no blank line between, none before `floor`.
fn doc_start(src: Bytes, head: Int, floor: Int) -> Int / {abort.raise} = {
  let first = line_start(src, head);
  if first < floor { floor } else {
    iterate(first, head + 1, |ls: Int|
      if ls <= floor { Stop(ls) } else {
        let prev = line_start(src, ls - 1);
        if prev >= floor && bytes_starts_with(trim(bytes_slice(src, prev, ls - 1)), b"//") {
          Continue(prev)
        } else { Stop(ls) }
      })
  }
}

fn locate(src: Bytes, name: Bytes) -> Result<Located, Bytes> / {abort.raise} = {
  let r = parse(src);
  match list_at(r.parser.diags, 0) {
    Some(d) -> Err(render_diag(src, d)),
    None -> {
      let m = r.node;
      let found = filter(m.items, |it: Item|
        match item_name(it) { Some(n) -> n == name, None -> false });
      if len(found) == 0 {
        Err(bytes_concat_all([b"no `fn`, `type` or `effect` is named `", name, b"`"]))
      } else if len(found) > 1 {
        Err(bytes_concat_all([b"`", name, b"` names ", ascii_of_int(len(found)), b" items"]))
      } else {
        let it = at(found, 0);
        let head = head_start(src, it);
        let last = item_span(it).end;
        let above = match item_doc(it) { Some(d) -> d.span.start, None -> head };
        let start = doc_start(src, above, floor_before(m, above));
        let end = min(line_end(src, last), ceiling_after(src, m, last));
        Ok({ start: start, end: end, item: it })
      }
    },
  }
}

// The bytes of the item named `name`: its comment lines, `pub`, `reuse` and body through the end of
// its last line, so a comment ending that line comes along. Refused when the name is absent, names
// two items, or the text does not parse.
pub fn item_range(
  src: Bytes,
  name: Bytes,
) -> Result<{ start: Int, end: Int }, Bytes> / {abort.raise} =
  match locate(src, name) { Ok(l) -> Ok({ start: l.start, end: l.end }), Err(e) -> Err(e) }

// `src` with the item named `name` replaced by `item` formatted; every byte outside its range is kept.
pub fn replace_item(src: Bytes, name: Bytes, item: Bytes) -> Result<Bytes, Bytes> / {abort.raise} = {
  let old = locate(src, name)?;
  let r = parse(item);
  match list_at(r.parser.diags, 0) {
    Some(d) -> Err(bytes_concat(b"the replacement does not parse: ", render_diag(item, d))),
    None -> {
      let m = r.node;
      if len(filter(m.imports, is_written)) > 0 {
        Err(b"the replacement holds an import; it must be one item")
      } else if len(m.items) != 1 {
        Err(
          bytes_concat_all([
            b"the replacement holds ",
            ascii_of_int(len(m.items)),
            b" items; it must be one",
          ]),
        )
      } else {
        let fresh = at(m.items, 0);
        let same = item_kind(fresh) == item_kind(old.item)
          && (match item_name(fresh) { Some(n) -> n == name, None -> false });
        if !same {
          Err(
            bytes_concat_all([
              b"the replacement defines ",
              item_desc(fresh),
              b"; expected ",
              item_desc(old.item),
            ]),
          )
        } else {
          let formatted = fmt_source(item)?;
          let lead = if old.start > 0 && bytes_at(src, old.start - 1) != 10 { b"\n" } else { b"" };
          Ok(
            bytes_concat_all([
              bytes_slice(src, 0, old.start),
              lead,
              formatted,
              bytes_slice(src, old.end, bytes_len(src)),
            ]),
          )
        }
      }
    },
  }
}

// --- Tests ------------------------------------------------------------------

fn formatted(src: Bytes) -> Bytes / {abort.raise} =
  match fmt_source(src) { Ok(o) -> o, Err(e) -> panic(string_of_bytes(e)) }

fn stable(src: Bytes) -> Bool / {abort.raise} = {
  let out = formatted(src);
  fmt_source(out) == Ok(out)
}

fn tree_of(src: Bytes) -> Bytes / {abort.raise} = erase_spans(dump_module(parse(src).node))

// `src` prints as `out`, which prints as itself and parses to the tree `src` does.
fn lays_out(src: Bytes, out: Bytes) -> Unit / {abort.raise} = {
  assert_eq(formatted(src), out);
  assert_eq(formatted(out), out);
  assert_eq(tree_of(out), tree_of(src))
}

test "a program is printed back with its comments, and printing it again changes nothing" {
  let src = b"// top\nfn   f(a: Int,b: Int)->Int = a+b // add\n\n\nfn g() -> List<Int> = [1_000, 0xFF]\n";
  let out = formatted(src);
  assert_eq(
    out,
    b"// top\nfn f(a: Int, b: Int) -> Int = a + b  // add\n\nfn g() -> List<Int> = [1_000, 0xFF]\n",
  );
  assert(stable(src))
}

test "a map or a set literal prints as the literal it was, and a spelled-out call as a call" {
  lays_out(
    b"fn f() -> Map<String, Int> = #{ \"a\" : 1,\"b\":2 }\n",
    b"fn f() -> Map<String, Int> = #{\"a\": 1, \"b\": 2}\n",
  );
  lays_out(b"fn f() -> Map<Int, Unit> = #[ 3,1 ]\n", b"fn f() -> Map<Int, Unit> = #[3, 1]\n");
  lays_out(b"fn f() -> Map<Int, Int> = #{}\n", b"fn f() -> Map<Int, Int> = #{}\n");
  lays_out(
    b"fn f() -> Map<Int, Int> = map_of_entries([{key: 1, value: 2}])\n",
    b"fn f() -> Map<Int, Int> = map_of_entries([{ key: 1, value: 2 }])\n",
  )
}

test "a map literal too long for its line breaks one entry a line" {
  let src = b"fn f() -> Map<String, Int> = #{\"alpha\": 1, \"beta\": 2, \"gamma\": 3, \"delta\": 4, \"epsilon\": 5, \"zeta\": 6, \"eta\": 7, \"theta\": 8, \"iota\": 9}\n";
  let out = formatted(src);
  assert(bytes_index_of(out, b"#{\n") != None);
  assert(bytes_index_of(out, b"\"zeta\": 6,\n") != None);
  assert(stable(src));
  assert_eq(tree_of(out), tree_of(src))
}

test "an or-pattern parts its alternatives with ` | `, keeping a parenthesised choice" {
  lays_out(
    b"fn f(n: Int) -> Int = match n { 1|2 -> 0, (3 | (4|5)) -> 1, _ -> 2 }\n",
    b"fn f(n: Int) -> Int = match n { 1 | 2 -> 0, 3 | (4 | 5) -> 1, _ -> 2 }\n",
  )
}

test "a short `let ... else` keeps its `else` on the line, and a longer one opens a block" {
  lays_out(
    b"fn f(o: Option<Int>) -> Int = { let Some(v) = o else {0}; v }\n",
    b"fn f(o: Option<Int>) -> Int = {\n  let Some(v) = o else { 0 };\n  v\n}\n",
  );
  lays_out(
    b"fn f(o: Option<Int>) -> Int = { let Some(v) = o else { let w = 1; w }; v }\n",
    b"fn f(o: Option<Int>) -> Int = {\n  let Some(v) = o else {\n    let w = 1;\n    w\n  };\n  v\n}\n",
  )
}

test "a block breaks one statement per line and keeps one blank line between statements" {
  let src = b"fn f() -> Int = { let x = 1;\n\n\n  let y = 2; x + y }\n";
  assert_eq(formatted(src), b"fn f() -> Int = {\n  let x = 1;\n\n  let y = 2;\n  x + y\n}\n");
  assert(stable(src))
}

test "comments between match arms and at the end of the file keep their place" {
  let src = b"fn f(x: Option<Int>) -> Int =\n  match x {\n    // none\n    None -> 0,\n    Some(n) -> n, // some\n  }\n// end\n";
  assert_eq(
    formatted(src),
    b"fn f(x: Option<Int>) -> Int =\n  match x {\n    // none\n    None -> 0,\n    Some(n) -> n,  // some\n  }\n// end\n",
  );
  assert(stable(src))
}

test "a call past the width breaks one argument per line, and a lambda hugs the parentheses" {
  let long = b"fn f() -> Int = some_function(first_argument_value, second_argument_value, third_argument_value, fourth, fifth_argument_value)\n";
  assert_eq(
    formatted(long),
    b"fn f() -> Int =\n  some_function(\n    first_argument_value,\n    second_argument_value,\n    third_argument_value,\n    fourth,\n    fifth_argument_value,\n  )\n",
  );
  let hug = b"fn g(xs: List<Int>) -> Int = fold(xs, 0, |acc: Int, x: Int| if x > acc { acc + x * x * x * x * x * x * x * x * x * x } else { acc - x })\n";
  assert_eq(
    formatted(hug),
    b"fn g(xs: List<Int>) -> Int =\n  fold(xs, 0, |acc: Int, x: Int|\n    if x > acc { acc + x * x * x * x * x * x * x * x * x * x } else { acc - x })\n",
  );
  assert(stable(long));
  assert(stable(hug))
}

test "a chain past the width keeps every line it opens at one level, however its operators nest" {
  let src = bytes_concat(
    b"fn ordered(a: Int, b: Int, c: Int) -> Bool =\n  first_reading(a, b) || ",
    b"(second_reading(a, b) && (third_reading(b, c) || (fourth_reading(b, c) && fifth_reading(a, c))))\n",
  );
  assert_eq(
    formatted(src),
    bytes_concat(
      b"fn ordered(a: Int, b: Int, c: Int) -> Bool =\n  first_reading(a, b)\n    || (second_reading(a, b)\n",
      b"    && (third_reading(b, c) || (fourth_reading(b, c) && fifth_reading(a, c))))\n",
    ),
  );
  assert(stable(src))
}

test "`&&` under `||`, and a form that runs on, are bracketed wherever an operator bounds them" {
  let src = bytes_concat(
    b"fn holds(x: Option<Int>, n: Int) -> Bool =\n",
    b"  n > 0 || n < 0 && match x { Some(k) -> k > n, None -> false }\n",
  );
  assert_eq(
    formatted(src),
    bytes_concat(
      b"fn holds(x: Option<Int>, n: Int) -> Bool =\n",
      b"  n > 0 || (n < 0 && (match x { Some(k) -> k > n, None -> false }))\n",
    ),
  );
  assert_eq(
    formatted(b"fn kept(n: Int) -> Bool = !(n > 0) && n + 1 > 0 || n == 0\n"),
    b"fn kept(n: Int) -> Bool = (!(n > 0) && n + 1 > 0) || n == 0\n",
  );
  assert(stable(src))
}

test "an `if` chain past the width takes one branch to a line, its body on that line while it fits" {
  let src = bytes_concat(
    b"fn pick(n: Int) -> Bytes =\n  if n == 0 { b\"zero\" } else if n == 1 { b\"one\" } ",
    b"else if n == 2 { b\"two\" } else if n == 3 { b\"three\" } else { b\"many\" }\n",
  );
  assert_eq(
    formatted(src),
    bytes_concat(
      b"fn pick(n: Int) -> Bytes =\n  if n == 0 { b\"zero\" }\n  else if n == 1 { b\"one\" }\n",
      b"  else if n == 2 { b\"two\" }\n  else if n == 3 { b\"three\" }\n  else { b\"many\" }\n",
    ),
  );
  assert(stable(src));
  // A branch that has to open a block takes the `else` on either side of it onto its brace's line.
  let wide = bytes_concat(
    b"fn pick(n: Int, xs: List<Int>) -> Bytes =\n  if n == 0 { b\"zero\" } else if n == 1 { b\"one\" } ",
    b"else if n == 2 { let m = fold(xs, 0, |acc: Int, x: Int| acc + x); b\"two\" } else { b\"many\" }\n",
  );
  assert_eq(
    formatted(wide),
    bytes_concat_all([
      b"fn pick(n: Int, xs: List<Int>) -> Bytes =\n  if n == 0 { b\"zero\" }\n",
      b"  else if n == 1 { b\"one\" } else if n == 2 {\n",
      b"    let m = fold(xs, 0, |acc: Int, x: Int| acc + x);\n    b\"two\"\n",
      b"  } else { b\"many\" }\n",
    ]),
  );
  assert(stable(wide))
}

// Absorbed into the branch that followed it, the comment came back above a different `else` on the
// next pass, so formatting twice was not formatting once.
test "a comment written above an `else` keeps its line above it" {
  let src = bytes_concat(
    b"fn pick(n: Int) -> Bytes =\n  if n == 0 { b\"zero\" }\n  else if n == 1 { b\"one\" }\n",
    b"  // the rest are the same\n  else { b\"many\" }\n",
  );
  assert_eq(formatted(src), src);
  assert(stable(src))
}

test "an `if` chain past the width breaks into branches before any condition in it breaks" {
  lays_out(
    bytes_concat_all([
      b"fn request_line(line: Bytes) -> Parsed = {\n",
      b"  let len = bytes_len(line);\n",
      b"  let sp1 = index_of(line, b\" \", 0);\n",
      b"  if sp1 >= len { Malformed(\"a request line is `METHOD TARGET VERSION`\") } else {\n",
      b"    let sp2 = index_of(line, b\" \", sp1 + 1);\n",
      b"    if sp2 >= len { Malformed(\"a request line is `METHOD TARGET VERSION`\") } else if index_of(\n",
      b"          line,\n",
      b"          b\" \",\n",
      b"          sp2 + 1,\n",
      b"        )\n",
      b"        < len { Malformed(\"a request line holds exactly two spaces\") } else {\n",
      b"      parts(\n",
      b"        bytes_slice(line, 0, sp1),\n",
      b"        bytes_slice(line, sp1 + 1, sp2),\n",
      b"        bytes_slice(line, sp2 + 1, len),\n",
      b"      )\n",
      b"    }\n",
      b"  }\n",
      b"}\n",
    ]),
    bytes_concat_all([
      b"fn request_line(line: Bytes) -> Parsed = {\n",
      b"  let len = bytes_len(line);\n",
      b"  let sp1 = index_of(line, b\" \", 0);\n",
      b"  if sp1 >= len { Malformed(\"a request line is `METHOD TARGET VERSION`\") } else {\n",
      b"    let sp2 = index_of(line, b\" \", sp1 + 1);\n",
      b"    if sp2 >= len { Malformed(\"a request line is `METHOD TARGET VERSION`\") }\n",
      b"    else if index_of(line, b\" \", sp2 + 1) < len {\n",
      b"      Malformed(\"a request line holds exactly two spaces\")\n",
      b"    } else {\n",
      b"      parts(\n",
      b"        bytes_slice(line, 0, sp1),\n",
      b"        bytes_slice(line, sp1 + 1, sp2),\n",
      b"        bytes_slice(line, sp2 + 1, len),\n",
      b"      )\n",
      b"    }\n",
      b"  }\n",
      b"}\n",
    ]),
  )
}

test "a condition in a chain breaks, one level in, only when its branch's opening overflows its own line" {
  lays_out(
    bytes_concat(
      b"fn f(a: Int, b: Int) -> Int = if a == 0 { 1 } else if some_long_condition_name(a, b) ",
      b"&& another_long_condition_name(a, b) && third_condition_name(a, b) && fourth_condition(a) { 2 } else { 3 }\n",
    ),
    bytes_concat_all([
      b"fn f(a: Int, b: Int) -> Int =\n",
      b"  if a == 0 { 1 }\n",
      b"  else if some_long_condition_name(a, b) && another_long_condition_name(a, b)\n",
      b"      && third_condition_name(a, b)\n",
      b"      && fourth_condition(a) { 2 }\n",
      b"  else { 3 }\n",
    ]),
  )
}

test "an `if` with a long condition and no `else if` keeps its body on the condition's last line" {
  lays_out(
    bytes_concat(
      b"fn f(a: Int, b: Int) -> Int = if some_long_condition_name(a, b) ",
      b"&& another_long_condition_name(a, b) && third_one(a) { 1 } else { 2 }\n",
    ),
    bytes_concat_all([
      b"fn f(a: Int, b: Int) -> Int =\n",
      b"  if some_long_condition_name(a, b) && another_long_condition_name(a, b) && third_one(a) { 1 }\n",
      b"  else { 2 }\n",
    ]),
  );
  lays_out(
    bytes_concat(
      b"fn g(a: Int, b: Int) -> Int = if some_long_condition_name(a, b) ",
      b"&& another_long_condition_name(a, b) && third_condition_name(a, b) && fourth(a) { 1 } else { 2 }\n",
    ),
    bytes_concat_all([
      b"fn g(a: Int, b: Int) -> Int =\n",
      b"  if some_long_condition_name(a, b) && another_long_condition_name(a, b)\n",
      b"      && third_condition_name(a, b)\n",
      b"      && fourth(a) { 1 }\n",
      b"  else { 2 }\n",
    ]),
  )
}

test "a chain in a `let`, a match arm or a call argument puts each `else` where the chain's line began" {
  let chain = bytes_concat(
    b"if a == 0 { first(a, b) } else if some_long_condition_name(a, b) ",
    b"&& another_long_condition_name(a, b) { second_value_with_a_longer_name(a, b) } else { third(a, b) }",
  );
  lays_out(
    bytes_concat_all([b"fn f(a: Int, b: Int) -> Int = { let x = ", chain, b"; x }\n"]),
    bytes_concat_all([
      b"fn f(a: Int, b: Int) -> Int = {\n",
      b"  let x = if a == 0 { first(a, b) }\n",
      b"  else if some_long_condition_name(a, b) && another_long_condition_name(a, b) {\n",
      b"    second_value_with_a_longer_name(a, b)\n",
      b"  } else { third(a, b) };\n",
      b"  x\n",
      b"}\n",
    ]),
  );
  lays_out(
    bytes_concat_all([
      b"fn g(o: Option<Int>, b: Int) -> Int = match o { Some(a) -> ",
      chain,
      b", None -> 0 }\n",
    ]),
    bytes_concat_all([
      b"fn g(o: Option<Int>, b: Int) -> Int =\n",
      b"  match o {\n",
      b"    Some(a) -> if a == 0 { first(a, b) }\n",
      b"    else if some_long_condition_name(a, b) && another_long_condition_name(a, b) {\n",
      b"      second_value_with_a_longer_name(a, b)\n",
      b"    } else { third(a, b) },\n",
      b"    None -> 0,\n",
      b"  }\n",
    ]),
  );
  lays_out(
    bytes_concat_all([b"fn h(a: Int, b: Int) -> Int = combine(a, ", chain, b")\n"]),
    bytes_concat_all([
      b"fn h(a: Int, b: Int) -> Int =\n",
      b"  combine(a, if a == 0 { first(a, b) }\n",
      b"  else if some_long_condition_name(a, b) && another_long_condition_name(a, b) {\n",
      b"    second_value_with_a_longer_name(a, b)\n",
      b"  } else { third(a, b) })\n",
    ]),
  );
  lays_out(
    bytes_concat_all([b"fn k(a: Int, b: Int) -> Int = combine(", chain, b", a)\n"]),
    bytes_concat_all([
      b"fn k(a: Int, b: Int) -> Int =\n",
      b"  combine(\n",
      b"    if a == 0 { first(a, b) }\n",
      b"    else if some_long_condition_name(a, b) && another_long_condition_name(a, b) {\n",
      b"      second_value_with_a_longer_name(a, b)\n",
      b"    } else { third(a, b) },\n",
      b"    a,\n",
      b"  )\n",
    ]),
  )
}

test "an `else` with no room before the block it opens takes a line of its own" {
  lays_out(
    bytes_concat(
      b"fn pick(n: Int) -> Bytes = if n == 0 { b\"a body long enough that the else and its brace ",
      b"no longer fit on its one line\" } else { let m = n * 2; num(m) }\n",
    ),
    bytes_concat_all([
      b"fn pick(n: Int) -> Bytes =\n",
      b"  if n == 0 { b\"a body long enough that the else and its brace no longer fit on its one line\" }\n",
      b"  else {\n",
      b"    let m = n * 2;\n",
      b"    num(m)\n",
      b"  }\n",
    ]),
  )
}

test "the branch that ends a chain leaves room on its line for what follows the chain" {
  lays_out(
    bytes_concat(
      b"fn f(a: Int, b: Int) -> Unit = { if some_long_condition_name(a, b) ",
      b"&& another_long_condition_name(a, b) { note(a, b, 12345678901) }; done(a) }\n",
    ),
    bytes_concat_all([
      b"fn f(a: Int, b: Int) -> Unit = {\n",
      b"  if some_long_condition_name(a, b) && another_long_condition_name(a, b) {\n",
      b"    note(a, b, 12345678901)\n",
      b"  };\n",
      b"  done(a)\n",
      b"}\n",
    ]),
  );
  lays_out(
    bytes_concat(
      b"fn g(a: Int, b: Int) -> Int = { let x = if a > b { a } else { combine(first_argument_name, ",
      b"second_argument_name, third_argument_name, fourth_arguments) }; x }\n",
    ),
    bytes_concat_all([
      b"fn g(a: Int, b: Int) -> Int = {\n",
      b"  let x = if a > b { a } else {\n",
      b"    combine(first_argument_name, second_argument_name, third_argument_name, fourth_arguments)\n",
      b"  };\n",
      b"  x\n",
      b"}\n",
    ]),
  )
}

test "a line string starts a line of its own, and what follows it starts the next" {
  lays_out(
    b"fn f() -> String = { let s = \\\\one\n      \\\\two\n; s }\n",
    b"fn f() -> String = {\n  let s =\n    \\\\one\n    \\\\two\n  ;\n  s\n}\n",
  );
  lays_out(
    b"fn f() -> String = \\\\say \"hi\" \\\\here\n\nfn g() -> String = \"a\\nb\"\n",
    b"fn f() -> String =\n  \\\\say \"hi\" \\\\here\n\nfn g() -> String = \"a\\nb\"\n",
  )
}

test "a line string that ends a list, a call or a record takes no comma, and one before an item does" {
  lays_out(
    b"fn f() -> Unit = assert_eq(g(), \\\\a\n  \\\\b\n)\n",
    b"fn f() -> Unit =\n  assert_eq(\n    g(),\n    \\\\a\n    \\\\b\n  )\n",
  );
  lays_out(
    b"fn f() -> { path: String, text: String } = { path: \"m.ply\", text: \\\\one\n}\n",
    b"fn f() -> { path: String, text: String } =\n  {\n    path: \"m.ply\",\n    text:\n      \\\\one\n  }\n",
  );
  lays_out(
    b"fn f() -> List<String> = [\\\\a\n, \\\\b\n]\n",
    b"fn f() -> List<String> =\n  [\n    \\\\a\n    ,\n    \\\\b\n  ]\n",
  )
}

test "every item kind prints back to the same tree" {
  let src = bytes_concat_all([
    b"import std.json\nimport a.b as c\nimport spine (Span, Ident)\n",
    b"pub type Shape = | Circle(Int) | Rect(Int, Int) | Point\n",
    b"type P = { x: Int, y: Int }\n",
    b"pub effect db {\n  read get[r](key: Int) -> Option<Int>\n  write put(Int, Int) -> Unit\n}\n",
    b"nondet effect clock { read now() -> Int }\n",
    b"effect set Persist = {db.read[users], Other, db.write[users]}\n",
    b"pub reuse fn f<a | e>(x: a, g: (a) -> a / e, n: Int = 1) -> a / {db.read[users] | e} where derivable(json, a) requires n > 0 ensures true = g(x)\n",
    b"fn h(t: (Int, Bool)) -> (Bool, Int) = match t { (n, b) -> (b, n) }\n",
    b"pub transparent fn k(x: Int) -> Int = x\n",
    b"transparent reuse fn q(xs: List<Int>) -> List<Int> = xs\n",
    b"fn r(xs: List<Int>, n: Int) -> List<Int>\n  returns xs\n  requires n > 0\n= xs\n",
    b"fn s() -> List<Int>\n  returns fresh\n= []\n",
    b"derive json for P\n",
    b"test/nondet \"t\" { assert(true) }\n",
    b"law/host \"l\" forall (n: Int) where n > 0 { n == n }\n",
    b"law \"m\" { true }\n",
    b"law \"c\" forall (n: Int) where n > 1 cost n * n { n }\n",
  ]);
  assert(stable(src));
  assert(string_contains(string_of_bytes(formatted(src)), "read get[r](key: Int) -> Option<Int>"))
}

test "a cost law prints its bound after its guard, on the head's line while it fits" {
  lays_out(
    b"law \"linear\"   forall (n: Int) where n>0 cost 2*n { range(0,n) }\n",
    b"law \"linear\" forall (n: Int) where n > 0 cost 2 * n { range(0, n) }\n",
  );
  lays_out(b"law \"c\" forall (n: Int) cost n { n }\n", b"law \"c\" forall (n: Int) cost n { n }\n")
}

test "a function parameter's cost name prints after its type" {
  lays_out(
    b"fn f<| e>(xs: List<Int>,  g: (Int) -> Int / e cost  k) -> Int / e cost len(xs)*k = 0\n",
    b"fn f<| e>(xs: List<Int>, g: (Int) -> Int / e cost k) -> Int / e\n  cost len(xs) * k\n= 0\n",
  )
}

test "a `cost` clause prints on its own line among the spec clauses, in the order written" {
  lays_out(
    b"fn f(xs: List<Int>,  ys: List<Int>) -> Int requires len(xs) > 0 cost len(xs)*(len(ys)+1) = len(xs)\n",
    b"fn f(xs: List<Int>, ys: List<Int>) -> Int\n  requires len(xs) > 0\n  cost len(xs) * (len(ys) + 1)\n= len(xs)\n",
  )
}

test "an operation's type parameters print between its resource and its parameters" {
  let src = b"effect box {\n  read take[k]<a>() -> a\n  write put<a, b>(x: a, y: b) -> Unit\n}\n";
  assert_eq(formatted(src), src)
}

test "a `raise` operation prints its name and parameters, and no result" {
  lays_out(
    b"effect toml {\n  raise   syntax(e: SyntaxError)\n  raise eof( )\n  read peek() -> Int\n}\n",
    b"effect toml {\n  raise syntax(e: SyntaxError)\n  raise eof()\n  read peek() -> Int\n}\n",
  )
}

test "a `try` prints the raise it names, stands as a scrutinee, and is bracketed as an operand" {
  lays_out(
    b"fn f(b: Int) -> Result<Int, Int> = try   { digit(b) }\n",
    b"fn f(b: Int) -> Result<Int, Int> = try { digit(b) }\n",
  );
  lays_out(
    b"fn f(b: Int) -> Result<Int, Int> = try[ m::toml.syntax ]\n  { digit(b) }\n",
    b"fn f(b: Int) -> Result<Int, Int> = try[m::toml.syntax] { digit(b) }\n",
  );
  let scrutinee = b"fn f(b: Int) -> Int = match try { digit(b) } { Ok(v) -> v, Err(e) -> e }\n";
  assert_eq(formatted(scrutinee), scrutinee);
  let operand = b"fn f(b: Int) -> Bool = (try { digit(b) }) == Ok(1)\n";
  assert_eq(formatted(operand), operand);
  let long = bytes_concat_all([
    b"fn f(b: Int) -> Result<Int, Int> = try[toml.syntax] { let first = digit(b); ",
    b"let second = digit(b + 1); let third = digit(b + 2); first + second + third }\n",
  ]);
  assert(stable(long));
  assert(string_contains(string_of_bytes(formatted(long)), "\n  try[toml.syntax] {\n"))
}

test "a row naming operations prints them back, and a `let` bound to a `handle` keeps its shape" {
  let src = bytes_concat_all([
    b"effect db {\n  read get[r](key: Int) -> Int\n  write begin() -> Unit\n}\n",
    b"effect set Tx = {db.begin, db.get[users]}\n",
    b"fn f(k: Int) -> Int / {db.get[users], db.begin, db.write} = { db.begin(); db.get[users](k) }\n",
    b"fn g(k: Int) -> Int = {\n  let tried = handle {\n    f(k)\n  } with {\n    db.get[users](n) -> n,\n  };\n  match tried {\n    0 -> 1,\n    n -> n,\n  }\n}\n",
  ]);
  assert(stable(src));
  assert(string_contains(string_of_bytes(formatted(src)), "/ {db.get[users], db.begin, db.write}"));
  assert(string_contains(string_of_bytes(formatted(src)), "{db.begin, db.get[users]}"))
}

test "a label binder prints bracketed among the type parameters, and a call prints its labels" {
  let src = bytes_concat_all([
    b"fn relay<[l]>(c: Int) -> Unit / {net.send[l]} = ()\n",
    b"fn g<a, [l], [k] | e>(x: a) -> a / e = x\n",
    b"fn h(c: Int) -> Unit / {net.send[conn]} = relay[conn](c)\n",
    b"fn k(c: Int) -> Unit = pair[a, b](c)\n",
  ]);
  assert_eq(formatted(src), src)
}

test "a type prints its label and row binders as a `fn` does, and a use its arguments in their places" {
  let src = bytes_concat_all([
    b"type Step<a | e> = () -> Option<{ value: a, next: Seq<a | e> }> / e\n\n",
    b"type Seq<a | e> = | Seq(Step<a | e>)\n\n",
    b"pub type Sink<a, [l], [k] | e, f> = | Sink((a) -> Unit / {net.send[l] | e}) | Quiet\n\n",
    b"fn held(s: Sink<Int, [conn], [peer] | {}, {log.write | e}>) -> m::Seq<Int | {| e}> = s\n",
  ]);
  assert_eq(formatted(src), src);
  lays_out(
    b"type T< [l,k] ,a|e > = U<[ l ],a , [k]|e,{ }>\n",
    b"type T<a, [l], [k] | e> = U<a, [l], [k] | e, {}>\n",
  )
}

test "a `handle`, a `match` or an `if` may stand as a scrutinee" {
  let held = b"fn f(k: Int) -> Int = match handle { g(k) } with { db.get(n) -> n } { 0 -> 1, n -> n }\n";
  assert_eq(formatted(held), held);
  let nested = b"fn f(x: Int) -> Int = if match x { 0 -> true, _ -> false } { 1 } else { 2 }\n";
  assert_eq(formatted(nested), nested);
  let broken_up = bytes_concat_all([
    b"fn f(k: Int) -> Int = match handle { some_call(k) } with ",
    b"{ db.get[users](n) resume q -> q(n), db.put[users](n) -> n + 1 } { 0 -> 1, n -> n }\n",
  ]);
  assert(stable(broken_up));
  assert(string_contains(string_of_bytes(formatted(broken_up)), "match handle {"))
}

test "every expression kind prints back to the same tree" {
  let src = bytes_concat_all([
    b"fn f(r: {a: Int, b: Int}) -> Int = {\n",
    b"  let {a, b} = r;\n",
    b"  let s = {..r, a: 2};\n",
    b"  let t = (a, b);\n",
    b"  let u = if a > 0 && !(b < 0) { -a } else if a == 0 { ~b } else { (a - b) - (a + b) * 2 };\n",
    b"  let v = [1, 2.5, 1.50m, \"s\\n\", b\"\\x00\", true, ()];\n",
    b"  let w = |x, y: Int| -> Int { x + y };\n",
    b"  let z = (r.a)(1)? + m::g(1, k: 2);\n",
    b"  let c = handle { db.get[users](1) } with { db.get[users](k) resume q -> q(Some(k)), return x -> x };\n",
    b"  let d = with_cell[work](0) { cell -> { cell_set(cell, 1); cell_get(cell) } };\n",
    b"  simulate { a };\n",
    b"  let e = parallel { a + 1, b };\n",
    b"  match [a, b] { [x, ..rest] if x > 0 -> x, [..] -> 0 }\n",
    b"}\n",
  ]);
  assert(stable(src))
}

test "literal spelling survives, and a grouped literal loses only its parentheses" {
  let src = b"fn f() -> Int = 0xFF_FF + 1_000 + (7)\nfn g() -> Float = 1.50e-3\nfn h() -> Bytes = b\"a\\x0d\"\n";
  assert_eq(
    formatted(src),
    b"fn f() -> Int = 0xFF_FF + 1_000 + 7\nfn g() -> Float = 1.50e-3\nfn h() -> Bytes = b\"a\\x0d\"\n",
  );
  assert(stable(src))
}

test "an interpolated string keeps its text as written and prints each hole flat" {
  let src = b"fn h(x: Int) -> String =   f\"x = {x   +   1} {{y}} \\n {f\"in {x}\"}\"\nfn k(a: Int, b: Int) -> String = f\"{a}\" ++ f\"{b}\"\n";
  assert_eq(
    formatted(src),
    b"fn h(x: Int) -> String = f\"x = {x + 1} {{y}} \\n {f\"in {x}\"}\"\nfn k(a: Int, b: Int) -> String = f\"{a}\" ++ f\"{b}\"\n",
  );
  assert(stable(src))
}

test "a file that does not parse is refused with the first diagnostic, and never rewritten" {
  match fmt_source(b"fn f( = 1\n") {
    Ok(_) -> assert(false),
    Err(e) -> assert(bytes_starts_with(e, b"1:")),
  }
}

// Absorbing such a comment into the line's end put it after the body's opening brace, where the
// next pass read it as a leading comment of the first arm.
test "a comment between `=` or `->` and a block-like body keeps a line of its own" {
  let src = bytes_concat(
    b"fn f(x: Int) -> Int = {\n  let y =\n    // why\n    match x { 1 -> 2, _ -> 3 };\n",
    b"  match y {\n    2 ->\n      // because\n      if y > 1 { 1 } else { 0 },\n    _ -> 0,\n  }\n}\n",
  );
  let out = formatted(src);
  assert(bytes_index_of(out, b"// why") != None);
  assert(bytes_index_of(out, b"// because") != None);
  assert(stable(src));
  let header = b"fn g() -> Int // c\n  = { let z = 1; z }\n";
  assert(bytes_index_of(formatted(header), b"// c") != None);
  assert(stable(header))
}

test "specification clauses go on their own lines before the body" {
  let src = b"fn f(n: Int) -> Int requires n > 0 ensures result > n = n + 1\n";
  assert_eq(
    formatted(src),
    b"fn f(n: Int) -> Int\n  requires n > 0\n  ensures result > n\n= n + 1\n",
  );
  assert(stable(src));
  let measured = b"fn g(n: Int) -> Int decreases n = if n <= 1 { 0 } else { g(n / 2) }\n";
  assert_eq(
    formatted(measured),
    b"fn g(n: Int) -> Int\n  decreases n\n= if n <= 1 { 0 } else { g(n / 2) }\n",
  );
  assert(stable(measured))
}

fn range_of(src: Bytes, name: Bytes) -> Bytes / {abort.raise} =
  match item_range(src, name) {
    Ok(r) -> bytes_slice(src, r.start, r.end),
    Err(e) -> panic(string_of_bytes(e)),
  }

test "an item's range holds its `pub`, its `reuse`, the comment lines above it and a comment ending its last line" {
  let src = bytes_concat_all([
    b"import spine (Span)\n\n// first\npub fn a() -> Int = 1  // one\n\n",
    b"// doc for b\n// on two lines\npub reuse fn b(x: Int) -> Int = x\n",
    b"type T = { x: Int }\n\n// stray\n\neffect clock { read now() -> Int }\n",
  ]);
  assert_eq(range_of(src, b"a"), b"// first\npub fn a() -> Int = 1  // one\n");
  assert_eq(
    range_of(src, b"b"),
    b"// doc for b\n// on two lines\npub reuse fn b(x: Int) -> Int = x\n",
  );
  assert_eq(range_of(src, b"T"), b"type T = { x: Int }\n");
  assert_eq(range_of(src, b"clock"), b"effect clock { read now() -> Int }\n");
  let bare = b"fn a() -> Int = 1\nfn b() -> Int = 2";
  assert_eq(range_of(bare, b"a"), b"fn a() -> Int = 1\n");
  assert_eq(range_of(bare, b"b"), b"fn b() -> Int = 2")
}

test "an item's range starts at its doc, across a blank line the formatter would close" {
  let src = b"fn a() -> Int = 1\n\n/// Two.\n\npub fn b() -> Int = 2\n";
  assert_eq(range_of(src, b"b"), b"/// Two.\n\npub fn b() -> Int = 2\n")
}

test "a doc holds to what it documents: no blank line is kept after a `///` line" {
  lays_out(
    b"/// The answer.\n\nfn f() -> Int = 42\n\n// --- next ---\n\n/// Another.\n///\n/// More.\nfn g() -> Int = 1\n",
    b"/// The answer.\nfn f() -> Int = 42\n\n// --- next ---\n\n/// Another.\n///\n/// More.\nfn g() -> Int = 1\n",
  );
  lays_out(b"//! The module.\n\nimport a\n", b"//! The module.\n\nimport a\n")
}

test "the docs of variants, fields and operations stay on the declarations they document" {
  let srcs = [
    b"pub type T =\n  /// The first.\n  | A\n  /// The second.\n  | B(Int)\n",
    b"type R = {\n  /// Its size.\n  size: Int,\n\n  /// Its name.\n  name: String,\n}\n",
    b"effect log {\n  /// Writes a line.\n  write line(s: String) -> Unit\n\n  /// Counts.\n  read count() -> Int\n}\n",
  ];
  fold(srcs, (), |u: Unit, src: Bytes| {
    assert(stable(src));
    assert_eq(tree_of(formatted(src)), tree_of(src))
  })
}

test "an item that is absent, named twice, or in a text that does not parse is refused" {
  assert_eq(
    item_range(b"fn a() -> Int = 1\n", b"b"),
    Err(b"no `fn`, `type` or `effect` is named `b`"),
  );
  assert_eq(item_range(b"fn a() -> Int = 1\nfn a() -> Int = 2\n", b"a"), Err(b"`a` names 2 items"));
  match item_range(b"fn a( = 1\n", b"a") {
    Ok(_) -> assert(false),
    Err(e) -> assert(bytes_starts_with(e, b"1:")),
  }
}

test "a replacement rewrites the named item alone, formatted, and keeps every other byte" {
  let src = b"// head\nfn a() -> Int = 1\n\n// doc\npub fn b(x: Int) -> Int = x   // keep\n\nfn c() -> Int = 3  // tail\n";
  assert_eq(
    replace_item(src, b"b", b"// new doc\npub fn   b(x: Int)->Int = x+1\n"),
    Ok(
      b"// head\nfn a() -> Int = 1\n\n// new doc\npub fn b(x: Int) -> Int = x + 1\n\nfn c() -> Int = 3  // tail\n",
    ),
  );
  assert_eq(
    replace_item(src, b"c", b"fn c() -> Int = 4"),
    Ok(
      b"// head\nfn a() -> Int = 1\n\n// doc\npub fn b(x: Int) -> Int = x   // keep\n\nfn c() -> Int = 4\n",
    ),
  )
}

test "a replacement of another kind or name, or holding more than one item, is refused" {
  let src = b"fn a() -> Int = 1\ntype T = Int\n";
  assert_eq(
    replace_item(src, b"a", b"fn c() -> Int = 1\n"),
    Err(b"the replacement defines `fn` `c`; expected `fn` `a`"),
  );
  assert_eq(
    replace_item(src, b"T", b"fn a() -> Int = 1\n"),
    Err(b"the replacement defines `fn` `a`; expected `type` `T`"),
  );
  assert_eq(
    replace_item(src, b"a", b"test \"t\" { assert(true) }\n"),
    Err(b"the replacement defines a `test`; expected `fn` `a`"),
  );
  assert_eq(
    replace_item(src, b"a", b"fn a() -> Int = 1\nfn b() -> Int = 2\n"),
    Err(b"the replacement holds 2 items; it must be one"),
  );
  assert_eq(
    replace_item(src, b"a", b"import std.json\nfn a() -> Int = 1\n"),
    Err(b"the replacement holds an import; it must be one item"),
  );
  match replace_item(src, b"a", b"fn a( = 1\n") {
    Ok(_) -> assert(false),
    Err(e) -> assert(bytes_starts_with(e, b"the replacement does not parse: 1:")),
  }
}

test "a short `parallel` stays on its line, and a long one puts each branch on its own" {
  assert_eq(
    formatted(b"fn f() -> (Int, Int) = parallel {1,2}\n"),
    b"fn f() -> (Int, Int) = parallel { 1, 2 }\n",
  );
  let long = b"fn f() -> (Int, Int) = parallel { a_rather_long_function_name(1, 2, 3, 4, 5), another_rather_long_function_name(6, 7, 8, 9, 10) }\n";
  assert_eq(
    formatted(long),
    b"fn f() -> (Int, Int) =\n  parallel {\n    a_rather_long_function_name(1, 2, 3, 4, 5),\n    another_rather_long_function_name(6, 7, 8, 9, 10),\n  }\n",
  );
  assert(stable(long));
  assert_eq(
    formatted(b"fn g() -> Int = match (parallel { 1, 2 }) { _ -> 0 }\n"),
    b"fn g() -> Int = match (parallel { 1, 2 }) { _ -> 0 }\n",
  )
}

test "an `extern fn` prints as its declaration, a `where` on a line of its own" {
  lays_out(
    b"// kept\nextern   fn len<a>(xs:List<a>)->Int\n\nextern fn compare<a>(x: a, y: a) -> Ordering where derivable(ord, a)\n",
    b"// kept\nextern fn len<a>(xs: List<a>) -> Int\n\nextern fn compare<a>(x: a, y: a) -> Ordering\n  where derivable(ord, a)\n",
  )
}
