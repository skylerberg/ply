// The lexer: source bytes to tokens and diagnostics.

// --- Bytes the language cannot spell ----------------------------------------

// The only inverse of `bytes_at`: Ply has no `byte_of_int`.
fn all_bytes() -> Bytes =
  b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff"

pub fn byte_of(v: Int) -> Bytes = bytes_slice(all_bytes(), v, v + 1)

// Every non-ASCII byte: a stop-set inside `b"..."`, which refuses them.
fn high_bytes() -> Bytes = bytes_slice(all_bytes(), 128, 256)

// --- Bounded peeking --------------------------------------------------------

// The byte at `i`, or -1 off either end.
fn at(src: Bytes, i: Int) -> Int = if i < 0 || i >= bytes_len(src) { -1 } else { bytes_at(src, i) }

// `bytes_scan` refuses a start past the end rather than clamping, so every scan goes through these two.
fn scan(src: Bytes, i: Int, set: Bytes) -> Int =
  if i >= bytes_len(src) { bytes_len(src) } else { bytes_scan(src, i, set, bytes_len(src)) }

fn scan_until(src: Bytes, i: Int, set: Bytes) -> Int =
  if i >= bytes_len(src) { bytes_len(src) } else { bytes_scan_until(src, i, set, bytes_len(src)) }

// --- Tokens -----------------------------------------------------------------

// `TFloat` carries normalised text and `TDec` its mantissa as digits: 96 bits do not fit an `Int`.
pub type Tok =
  | TIdent(Bytes)
  | TInt(Int)
  // The width's name and the value normalized to that width.
  | TFixed(Bytes, Int)
  | TFloat(Bytes)
  | TDec(Bytes, Int)
  | TStr(Bytes)
  | TBytes(Bytes)
  | TKw(Bytes)
  | TPunct(Bytes)
  | TEof

pub type Token = { start: Int, end: Int, tok: Tok }

pub type Diag = { start: Int, end: Int, code: Bytes, message: Bytes, label: Bytes }

pub type Comment = { start: Int, end: Int }

pub type Lexed = { toks: List<Token>, diags: List<Diag>, comments: List<Comment> }

// `toks` must stay the last field in every `Scan` literal: anywhere earlier, `push` copies the list (quadratic).
type Scan = { pos: Int, diags: List<Diag>, toks: List<Token> }

fn emit(s: Scan, start: Int, fin: Int, t: Tok) -> Scan =
  { pos: fin, diags: s.diags, toks: push(s.toks, { start: start, end: fin, tok: t }) }

fn err(s: Scan, start: Int, fin: Int, code: Bytes, message: Bytes, label: Bytes) -> Scan =
  {
    pos: s.pos,
    toks: s.toks,
    diags: push(s.diags, { start: start, end: fin, code: code, message: message, label: label }),
  }

fn bad_suffix(s: Scan, start: Int, fin: Int, suffix: Bytes) -> Scan =
  err(
    s,
    start,
    fin,
    unexpected(),
    bytes_concat_all([b"invalid suffix `", suffix, b"` on a numeric literal"]),
    b"the suffixes are `m` for a `Decimal` and a width \xe2\x80\x94 `u8`, `i32` and the six others; separate a name with a space",
  )

fn seek(s: Scan, p: Int) -> Scan = { pos: p, diags: s.diags, toks: s.toks }

fn unexpected() -> Bytes = b"E0001"

fn out_of_range() -> Bytes = b"E0211"

fn unterminated() -> Bytes = b"E0002"

fn non_ascii() -> Bytes = b"X0001"

// --- Character classes ------------------------------------------------------

// ASCII whitespace only.
fn ws() -> Bytes = b" \t\n\r\x0b\x0c"

fn ident_chars() -> Bytes = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

fn digit_chars() -> Bytes = b"0123456789_"

fn is_digit(c: Int) -> Bool = c >= 48 && c <= 57

fn is_ident_start(c: Int) -> Bool = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95

fn is_ident_continue(c: Int) -> Bool = is_ident_start(c) || is_digit(c)

// The UTF-8 length at a lead byte, so one refused character is one diagnostic spanning all of it.
fn utf8_len(c: Int) -> Int = if c < 128 { 1 } else if c < 224 { 2 } else if c < 240 { 3 } else { 4 }

// --- Trivia -----------------------------------------------------------------

// Whitespace and `//` comments, to the first byte of the next token.
fn skip_trivia(src: Bytes, i: Int) -> Int = {
  let j = scan(src, i, ws());
  if at(src, j) == 47 && at(src, j + 1) == 47 { skip_trivia(src, scan_until(src, j, b"\n")) }
  else { j }
}

// --- The loop ---------------------------------------------------------------

pub fn lex(src: Bytes) -> Lexed = {
  let n = bytes_len(src);
  let start = { pos: 0, diags: [], toks: [] };
  // Every step that has work left consumes at least one byte, so `n + 1` steps suffice.
  let done = fold(range(0, n + 1), start, |s: Scan, i: Int| one(src, s));
  let with_eof = emit(done, n, n, TEof);
  { diags: with_eof.diags, toks: with_eof.toks, comments: comments(src, with_eof.toks) }
}

// Only trivia lies between two tokens, so the comments are read off the gaps; `end` excludes the newline.
fn comments(src: Bytes, toks: List<Token>) -> List<Comment> = {
  let walked = fold(toks, { from: 0, out: [] }, |s: { from: Int, out: List<Comment> }, t: Token|
    { from: t.end, out: gap_comments(src, s.from, t.start, s.out) });
  walked.out
}

fn gap_comments(src: Bytes, i: Int, stop: Int, out: List<Comment>) -> List<Comment> = {
  let j = scan(src, i, ws());
  if j < stop && at(src, j) == 47 && at(src, j + 1) == 47 {
    let fin = scan_until(src, j, b"\n");
    gap_comments(src, fin, stop, push(out, { start: j, end: fin }))
  } else { out }
}

fn one(src: Bytes, s: Scan) -> Scan = {
  let n = bytes_len(src);
  if s.pos >= n { s } else {
    let start = skip_trivia(src, s.pos);
    if start >= n { seek(s, n) } else { token_at(src, s, start) }
  }
}

fn token_at(src: Bytes, s: Scan, start: Int) -> Scan = {
  let c = bytes_at(src, start);
  if is_digit(c) { number(src, s, start) }
  else if c == 98 && at(src, start + 1) == 34 { bytes_body(src, s, start, start + 2, b"") }
  else if is_ident_start(c) { ident(src, s, start) }
  else if c == 34 { string_lit(src, s, start, start + 1, b"") } else if c >= 128 {
    // With no Unicode table, any non-ASCII character outside a literal is refused as `X0001`.
    err(
      seek(s, start + utf8_len(c)),
      start,
      start + utf8_len(c),
      non_ascii(),
      bytes_concat_all([
        b"unexpected character `",
        bytes_slice(src, start, start + utf8_len(c)),
        b"`",
      ]),
      b"this character has no meaning in Ply source",
    )
  } else { punct(src, s, start, c) }
}

// --- Identifiers and keywords -----------------------------------------------

fn ident(src: Bytes, s: Scan, start: Int) -> Scan = {
  let fin = scan(src, start, ident_chars());
  let text = bytes_slice(src, start, fin);
  if text == b"_" { emit(s, start, fin, TPunct(b"underscore")) }
  else if is_keyword(text) { emit(s, start, fin, TKw(text)) }
  else { emit(s, start, fin, TIdent(text)) }
}

fn is_keyword(t: Bytes) -> Bool = {
  let k = bytes_len(t);
  if k == 2 { t == b"fn" || t == b"if" }
  else if k == 3 { t == b"pub" || t == b"let" }
  else if k == 4 { t == b"type" || t == b"test" || t == b"else" || t == b"with" || t == b"true" }
  else if k == 5 { t == b"match" || t == b"false" }
  else if k == 6 { t == b"import" || t == b"effect" || t == b"nondet" || t == b"handle" }
  else { false }
}

// --- Numbers ----------------------------------------------------------------

// `1`, `1_000`, `1.5`, `1.5e-3`, `1.50m`.
type Num = { start: Int, whole: Bytes, frac: Bytes, hasf: Bool, exp: Bytes, hase: Bool, cur: Int }

fn strip_us(b: Bytes) -> Bytes = bytes_concat_all(bytes_split(b, b"_"))

// A hex literal is an `Int` bounded as a 64-bit pattern.
fn number(src: Bytes, s: Scan, start: Int) -> Scan =
  if at(src, start) == 48 && (at(src, start + 1) == 120 || at(src, start + 1) == 88) {
    hex_literal(src, s, start)
  } else { decimal_number(src, s, start) }

fn hex_literal(src: Bytes, s: Scan, start: Int) -> Scan = {
  let fin = scan(src, start + 2, b"0123456789abcdefABCDEF_");
  let digits = strip_us(bytes_slice(src, start + 2, fin));
  if bytes_len(digits) == 0 {
    emit(
      err(
        s,
        start,
        fin,
        unexpected(),
        b"hex literal with no digits",
        b"write at least one digit after `0x`, as in `0xFF`",
      ),
      start,
      fin,
      TInt(0),
    )
  } else {
    let sufe = if is_ident_start(at(src, fin)) { scan(src, fin, ident_chars()) } else { fin };
    let suffix = bytes_slice(src, fin, sufe);
    match width_named(suffix) {
      // A hex literal is a bit pattern, so the width bounds it rather than the type's range.
      Some(w) -> hex_fixed(s, start, sufe, digits, w),
      None -> {
        let s1 = if sufe > fin { bad_suffix(s, start, sufe, suffix) } else { s };
        let d = strip_zeros(digits);
        if bytes_len(d) > 16 {
          emit(
            err(
              s1,
              start,
              fin,
              unexpected(),
              bytes_concat_all([b"hex literal `0x", digits, b"` does not fit in `Int`"]),
              b"`Int` is 64 bits, so a hex literal has at most 16 digits",
            ),
            start,
            fin,
            TInt(0),
          )
        } else { emit(s1, start, fin, TInt(hex_of_digits(d))) }
      },
    }
  }
}

fn hex_fixed(s: Scan, start: Int, fin: Int, digits: Bytes, w: Width) -> Scan = {
  let d = strip_zeros(digits);
  if bytes_len(d) > 16 || (w.bits < 64 && bytes_len(d) * 4 > w.bits && hex_over(d, w)) {
    emit(
      err(
        s,
        start,
        fin,
        out_of_range(),
        bytes_concat_all([b"`0x", digits, b"` does not fit in `", width_upper(w), b"`"]),
        bytes_concat_all([b"a `", width_upper(w), b"` is ", num(w.bits), b" bits"]),
      ),
      start,
      fin,
      TFixed(width_upper(w), 0),
    )
  } else { emit(s, start, fin, TFixed(width_upper(w), width_normalize(w, hex_of_digits(d)))) }
}

// Decided on the digit string so no `Int` has to hold the pattern.
fn hex_over(d: Bytes, w: Width) -> Bool =
  bytes_len(strip_zeros(d)) * 4 > w.bits + 3 && (bytes_len(strip_zeros(d)) - 1) * 4 >= w.bits

fn hex_of_digits(d: Bytes) -> Int =
  fold(range(0, bytes_len(d)), 0, |a: Int, i: Int|
    wrap_add(wrap_mul(a, 16), hex_digit(bytes_at(d, i))))

fn decimal_number(src: Bytes, s: Scan, start: Int) -> Scan = {
  let we = scan(src, start, digit_chars());
  let whole = strip_us(bytes_slice(src, start, we));
  // `..` is the range separator, so a fraction is a dot followed by a digit.
  let hasf = at(src, we) == 46 && is_digit(at(src, we + 1));
  let fe = if hasf { scan(src, we + 1, digit_chars()) } else { we };
  let frac = if hasf { strip_us(bytes_slice(src, we + 1, fe)) } else { b"" };
  let es = exp_start(src, fe);
  let ee = if es < 0 { fe } else { scan(src, es, digit_chars()) };
  number_tail(src, s, {
    start: start,
    whole: whole,
    frac: frac,
    hasf: hasf,
    exp: if es < 0 { b"" } else { exp_text(src, fe, es, ee) },
    hase: es >= 0,
    cur: ee,
  })
}

// The first exponent digit, or -1: the `e` is consumed only when digits follow.
fn exp_start(src: Bytes, i: Int) -> Int = {
  let c = at(src, i);
  if c != 101 && c != 69 { -1 } else {
    let d = at(src, i + 1);
    let j = if d == 43 || d == 45 { i + 2 } else { i + 1 };
    if is_digit(at(src, j)) { j } else { -1 }
  }
}

fn exp_text(src: Bytes, e: Int, es: Int, ee: Int) -> Bytes =
  bytes_concat(bytes_slice(src, e + 1, es), strip_us(bytes_slice(src, es, ee)))

fn number_tail(src: Bytes, s: Scan, m: Num) -> Scan =
  if at(src, m.cur) == 109 && !is_ident_continue(at(src, m.cur + 1)) { decimal(s, m, m.cur + 1) } else if is_ident_start(
      at(src, m.cur),
    ) {
    let fin = scan(src, m.cur, ident_chars());
    // A width suffix applies only to an integer; `1.5u8` is refused as a bad suffix.
    match if m.hasf || m.hase { None } else { width_named(bytes_slice(src, m.cur, fin)) } {
      Some(w) -> fixed_value(s, m, fin, w),
      None -> number_value(bad_suffix(s, m.start, fin, bytes_slice(src, m.cur, fin)), m, fin),
    }
  } else { number_value(s, m, m.cur) }

// A decimal spelling is a value, so its bound is the type's range.
fn fixed_value(s: Scan, m: Num, fin: Int, w: Width) -> Scan = {
  let d = strip_zeros(m.whole);
  let k = bytes_len(d);
  let too_long = k > 19 || (k == 19 && compare(d, int_max()) == Greater);
  if too_long || over_width(d, w) {
    emit(
      err(
        s,
        m.start,
        fin,
        out_of_range(),
        bytes_concat_all([b"`", m.whole, b"` is not a value of `", width_upper(w), b"`"]),
        bytes_concat_all([b"`", width_upper(w), b"` holds ", width_range(w)]),
      ),
      m.start,
      fin,
      TFixed(width_upper(w), 0),
    )
  } else { emit(s, m.start, fin, TFixed(width_upper(w), width_normalize(w, int_of_digits(d)))) }
}

// At 64 bits the caller's `int_max` check is the only bound.
fn over_width(d: Bytes, w: Width) -> Bool =
  if w.bits == 64 { false } else { int_of_digits(d) > width_max(w) }

fn width_range(w: Width) -> Bytes =
  if w.bits == 64 {
    if w.signed { b"-9223372036854775808 to 9223372036854775807" }
    else { b"0 to 18446744073709551615" }
  } else if w.signed {
    bytes_concat_all([b"-", num(two_to(w.bits - 1)), b" to ", num(width_max(w))])
  } else { bytes_concat_all([b"0 to ", num(width_max(w))]) }

fn number_value(s: Scan, m: Num, fin: Int) -> Scan =
  if !m.hasf && !m.hase { int_value(s, m, fin) }
  else { emit(s, m.start, fin, TFloat(float_text(m))) }

fn float_text(m: Num) -> Bytes =
  bytes_concat_all([
    m.whole,
    if m.hasf { b"." } else { b"" },
    if m.hasf { m.frac } else { b"" },
    if m.hase { b"e" } else { b"" },
    if m.hase { m.exp } else { b"" },
  ])

// --- Integers ---------------------------------------------------------------

// `Int` arithmetic is checked, so a literal's bound is decided on its digits before accumulating.
fn int_max() -> Bytes = b"9223372036854775807"

fn strip_zeros(b: Bytes) -> Bytes = {
  let k = scan(b, 0, b"0");
  if k >= bytes_len(b) { b"0" } else { bytes_slice(b, k, bytes_len(b)) }
}

fn int_value(s: Scan, m: Num, fin: Int) -> Scan = {
  let d = strip_zeros(m.whole);
  let k = bytes_len(d);
  if k > 19 || (k == 19 && compare(d, int_max()) == Greater) {
    emit(
      err(
        s,
        m.start,
        fin,
        unexpected(),
        bytes_concat_all([b"integer literal `", m.whole, b"` does not fit in `Int`"]),
        b"`Int` is a 64-bit signed integer; use a smaller value",
      ),
      m.start,
      fin,
      TInt(0),
    )
  } else { emit(s, m.start, fin, TInt(int_of_digits(d))) }
}

fn int_of_digits(d: Bytes) -> Int =
  fold(range(0, bytes_len(d)), 0, |a: Int, i: Int| a * 10 + (bytes_at(d, i) - 48))

// --- Widths -----------------------------------------------------------------

pub type Width = { name: Bytes, bits: Int, signed: Bool }

pub fn widths() -> List<Width> =
  [
    { name: b"u8", bits: 8, signed: false },
    { name: b"u16", bits: 16, signed: false },
    { name: b"u32", bits: 32, signed: false },
    { name: b"u64", bits: 64, signed: false },
    { name: b"i8", bits: 8, signed: true },
    { name: b"i16", bits: 16, signed: true },
    { name: b"i32", bits: 32, signed: true },
    { name: b"i64", bits: 64, signed: true },
  ]

pub fn width_named(suffix: Bytes) -> Option<Width> =
  fold(widths(), None, |found: Option<Width>, w: Width|
    match found { Some(_) -> found, None -> if w.name == suffix { Some(w) } else { None } })

fn width_upper(w: Width) -> Bytes = string_upper_bytes(w.name)

fn string_upper_bytes(b: Bytes) -> Bytes = bytes_of_string(string_upper(string_of_bytes(b)))

fn two_to(n: Int) -> Int = fold(range(0, n), 1, |a: Int, _i: Int| a * 2)

// Only below 64 bits: `two_to(63)` overflows `Int`.
fn width_max(w: Width) -> Int = if w.signed { two_to(w.bits - 1) - 1 } else { two_to(w.bits) - 1 }

// The low `bits` kept, sign-extended when the width is signed.
pub fn width_normalize(w: Width, v: Int) -> Int =
  if w.bits == 64 { v } else {
    let low = v & two_to(w.bits) - 1;
    if w.signed && low >>> w.bits - 1 == 1 { low | 0 - two_to(w.bits) } else { low }
  }

// --- Decimals ---------------------------------------------------------------

// A `Decimal` mantissa is 96 bits and its scale 0..=28; neither fits an `Int` check, so both use the digits.
fn dec_max() -> Bytes = b"79228162514264337593543950335"

fn zero_dec() -> Tok = TDec(b"0", 0)

fn decimal(s: Scan, m: Num, fin: Int) -> Scan =
  if m.hase {
    emit(
      err(
        s,
        m.start,
        fin,
        unexpected(),
        b"a `Decimal` literal has no exponent",
        b"write the digits out, or drop the `m` for a `Float`",
      ),
      m.start,
      fin,
      zero_dec(),
    )
  } else if bytes_len(m.frac) > 28 {
    emit(
      err(
        s,
        m.start,
        fin,
        unexpected(),
        bytes_concat_all([
          b"a `Decimal` literal has at most 28 decimal places, not ",
          num(bytes_len(m.frac)),
        ]),
        b"round the literal, or use `Float`",
      ),
      m.start,
      fin,
      zero_dec(),
    )
  } else {
    let d = strip_zeros(bytes_concat(m.whole, m.frac));
    let k = bytes_len(d);
    if k > 29 || (k == 29 && compare(d, dec_max()) == Greater) {
      emit(
        err(
          s,
          m.start,
          fin,
          unexpected(),
          b"a `Decimal` literal has at most 96 bits of mantissa",
          b"the largest is 79228162514264337593543950335",
        ),
        m.start,
        fin,
        zero_dec(),
      )
    } else { emit(s, m.start, fin, TDec(d, bytes_len(m.frac))) }
  }

// --- String literals --------------------------------------------------------

fn str_stops() -> Bytes = b"\"\\\n"

fn string_lit(src: Bytes, s: Scan, open: Int, i: Int, acc: Bytes) -> Scan = {
  let stop = scan_until(src, i, str_stops());
  let so_far = bytes_concat(acc, bytes_slice(src, i, stop));
  let c = at(src, stop);
  if c < 0 || c == 10 {
    emit(
      err(
        s,
        open,
        stop,
        unterminated(),
        b"unterminated string literal",
        b"add a closing `\"`; a string may not span a line break",
      ),
      open,
      stop,
      TStr(so_far),
    )
  } else if c == 34 { emit(s, open, stop + 1, TStr(so_far)) }
  else { string_escape(src, s, open, stop, so_far) }
}

fn unknown_escape(src: Bytes, s: Scan, stop: Int, w: Int, valid: Bytes) -> Scan =
  err(
    s,
    stop,
    stop + 1 + w,
    unexpected(),
    bytes_concat_all([
      b"unknown escape sequence `\\",
      bytes_slice(src, stop + 1, stop + 1 + w),
      b"`",
    ]),
    valid,
  )

fn string_escape(src: Bytes, s: Scan, open: Int, stop: Int, so_far: Bytes) -> Scan = {
  let n = bytes_len(src);
  let c = at(src, stop + 1);
  if c < 0 {
    emit(
      err(s, open, n, unterminated(), b"unterminated string literal", b"add a closing `\"`"),
      open,
      n,
      TStr(so_far),
    )
  } else if c == 110 { string_lit(src, s, open, stop + 2, bytes_concat(so_far, b"\n")) }
  else if c == 116 { string_lit(src, s, open, stop + 2, bytes_concat(so_far, b"\t")) }
  else if c == 114 { string_lit(src, s, open, stop + 2, bytes_concat(so_far, b"\r")) }
  else if c == 48 { string_lit(src, s, open, stop + 2, bytes_concat(so_far, b"\x00")) }
  else if c == 92 { string_lit(src, s, open, stop + 2, bytes_concat(so_far, b"\\")) }
  else if c == 34 { string_lit(src, s, open, stop + 2, bytes_concat(so_far, b"\"")) } else {
    // Reported, and the whole character is kept.
    let w = utf8_len(c);
    string_lit(
      src,
      unknown_escape(src, s, stop, w, b"valid escapes are \\n \\t \\r \\0 \\\\ and \\\""),
      open,
      stop + 1 + w,
      bytes_concat(so_far, bytes_slice(src, stop + 1, stop + 1 + w)),
    )
  }
}

// --- Byte-string literals ---------------------------------------------------

// A byte above `~` is refused rather than encoded, so the literal cannot depend on the file's encoding.
fn bytes_stops() -> Bytes = bytes_concat(b"\"\\\n", high_bytes())

fn bytes_body(src: Bytes, s: Scan, open: Int, i: Int, acc: Bytes) -> Scan = {
  let stop = scan_until(src, i, bytes_stops());
  let so_far = bytes_concat(acc, bytes_slice(src, i, stop));
  let c = at(src, stop);
  if c < 0 || c == 10 {
    emit(
      err(
        s,
        open,
        stop,
        unterminated(),
        b"unterminated byte-string literal",
        b"add a closing `\"`; a literal may not span a line break",
      ),
      open,
      stop,
      TBytes(so_far),
    )
  } else if c == 34 { emit(s, open, stop + 1, TBytes(so_far)) }
  else if c == 92 { bytes_escape(src, s, open, stop, so_far) } else {
    let w = utf8_len(c);
    let ch = bytes_slice(src, stop, stop + w);
    let encoded = bytes_concat_all(
      map(range(0, w), |i: Int| bytes_concat(b"\\x", hex2(bytes_at(ch, i)))),
    );
    bytes_body(
      src,
      err(
        s,
        stop,
        stop + w,
        unexpected(),
        bytes_concat_all([
          b"`",
          ch,
          b"` is not an ASCII character, so it has no place in `b\"...\"`",
        ]),
        bytes_concat_all([b"write `", encoded, b"` instead"]),
      ),
      open,
      stop + w,
      so_far,
    )
  }
}

fn bytes_escape(src: Bytes, s: Scan, open: Int, stop: Int, so_far: Bytes) -> Scan = {
  let n = bytes_len(src);
  let c = at(src, stop + 1);
  if c < 0 {
    emit(
      err(s, open, n, unterminated(), b"unterminated byte-string literal", b"add a closing `\"`"),
      open,
      n,
      TBytes(so_far),
    )
  } else if c == 110 { bytes_body(src, s, open, stop + 2, bytes_concat(so_far, b"\n")) }
  else if c == 116 { bytes_body(src, s, open, stop + 2, bytes_concat(so_far, b"\t")) }
  else if c == 114 { bytes_body(src, s, open, stop + 2, bytes_concat(so_far, b"\r")) }
  else if c == 48 { bytes_body(src, s, open, stop + 2, bytes_concat(so_far, b"\x00")) }
  else if c == 92 { bytes_body(src, s, open, stop + 2, bytes_concat(so_far, b"\\")) }
  else if c == 34 { bytes_body(src, s, open, stop + 2, bytes_concat(so_far, b"\"")) }
  else if c == 120 { hex_escape(src, s, open, stop, so_far) } else {
    // Unlike a string's unknown escape, this one contributes no byte.
    let w = utf8_len(c);
    bytes_body(
      src,
      unknown_escape(src, s, stop, w, b"valid escapes are \\n \\t \\r \\0 \\\\ \\\" and \\xNN"),
      open,
      stop + 1 + w,
      so_far,
    )
  }
}

// A malformed escape yields a zero byte and consumes only the hex digits present, so the closing quote survives.
fn hex_escape(src: Bytes, s: Scan, open: Int, stop: Int, so_far: Bytes) -> Scan = {
  let hi = hex_digit(at(src, stop + 2));
  let lo = hex_digit(at(src, stop + 3));
  if hi >= 0 && lo >= 0 {
    bytes_body(src, s, open, stop + 4, bytes_concat(so_far, byte_of(hi * 16 + lo)))
  } else {
    let taken = if hi >= 0 { stop + 3 } else { stop + 2 };
    bytes_body(
      src,
      err(
        s,
        stop,
        taken,
        unexpected(),
        b"`\\x` needs exactly two hex digits",
        b"write two hex digits, as in `\\x0d`",
      ),
      open,
      taken,
      bytes_concat(so_far, b"\x00"),
    )
  }
}

fn hex_digit(c: Int) -> Int =
  if c >= 48 && c <= 57 { c - 48 }
  else if c >= 97 && c <= 102 { c - 87 }
  else if c >= 65 && c <= 70 { c - 55 }
  else { -1 }

// --- Punctuation ------------------------------------------------------------

// Maximal munch.
fn punct(src: Bytes, s: Scan, start: Int, c: Int) -> Scan =
  if c == 40 { emit(s, start, start + 1, TPunct(b"lparen")) }
  else if c == 41 { emit(s, start, start + 1, TPunct(b"rparen")) }
  else if c == 123 { emit(s, start, start + 1, TPunct(b"lbrace")) }
  else if c == 125 { emit(s, start, start + 1, TPunct(b"rbrace")) }
  else if c == 91 { emit(s, start, start + 1, TPunct(b"lbracket")) }
  else if c == 93 { emit(s, start, start + 1, TPunct(b"rbracket")) }
  else if c == 44 { emit(s, start, start + 1, TPunct(b"comma")) }
  else if c == 59 { emit(s, start, start + 1, TPunct(b"semi")) }
  else if c == 58 { pair(s, src, start, 58, b"coloncolon", b"colon") }
  else if c == 46 { pair(s, src, start, 46, b"dotdot", b"dot") }
  else if c == 61 { pair(s, src, start, 61, b"eqeq", b"eq") }
  else if c == 33 { pair(s, src, start, 61, b"bangeq", b"bang") }
  else if c == 60 { pair(s, src, start, 61, b"le", b"lt") }
  else if c == 62 { pair(s, src, start, 61, b"ge", b"gt") }
  else if c == 43 { pair(s, src, start, 43, b"plusplus", b"plus") }
  else if c == 45 { pair(s, src, start, 62, b"arrow", b"minus") }
  else if c == 42 { emit(s, start, start + 1, TPunct(b"star")) }
  else if c == 47 { emit(s, start, start + 1, TPunct(b"slash")) }
  else if c == 37 { emit(s, start, start + 1, TPunct(b"percent")) }
  else if c == 63 { emit(s, start, start + 1, TPunct(b"question")) }
  else if c == 124 { pair(s, src, start, 124, b"pipepipe", b"pipe") }
  // `<<` and `>>` are not lexed, so `Map<Int, List<Int>>` closes; the parser joins touching `<`s and `>`s.
  else if c == 38 { pair(s, src, start, 38, b"ampamp", b"amp") }
  else if c == 94 { emit(s, start, start + 1, TPunct(b"caret")) }
  else if c == 126 { emit(s, start, start + 1, TPunct(b"tilde")) } else {
    err(
      seek(s, start + 1),
      start,
      start + 1,
      unexpected(),
      bytes_concat_all([b"unexpected character `", bytes_slice(src, start, start + 1), b"`"]),
      b"this character has no meaning in Ply source",
    )
  }

fn pair(s: Scan, src: Bytes, start: Int, second: Int, both: Bytes, single: Bytes) -> Scan =
  if at(src, start + 1) == second { emit(s, start, start + 2, TPunct(both)) }
  else { emit(s, start, start + 1, TPunct(single)) }

// --- The dump ---------------------------------------------------------------

// `start:end:kind[:payload];` per token, then `start:end:!:code;` per diagnostic.
pub fn dump(src: Bytes) -> String = {
  let lx = lex(src);
  string_of_bytes(
    bytes_concat(
      bytes_concat_all(map(lx.toks, render_token)),
      bytes_concat_all(map(lx.diags, render_diag)),
    ),
  )
}

fn num(i: Int) -> Bytes = bytes_of_string(int_to_string(i))

fn render_token(t: Token) -> Bytes =
  bytes_concat_all([num(t.start), b":", num(t.end), b":", body(t.tok), b";"])

fn render_diag(d: Diag) -> Bytes =
  bytes_concat_all([num(d.start), b":", num(d.end), b":!:", d.code, b";"])

fn body(t: Tok) -> Bytes =
  match t {
    TIdent(b) -> bytes_concat(b"i:", b),
    TInt(v) -> bytes_concat(b"n:", num(v)),
    TFixed(ty, v) -> bytes_concat_all([b"w:", ty, b":", num(v)]),
    TFloat(txt) -> bytes_concat(b"f:", txt),
    TDec(m, sc) -> bytes_concat_all([b"d:", m, b":", num(sc)]),
    TStr(b) -> bytes_concat(b"s:", hex(b)),
    TBytes(b) -> bytes_concat(b"b:", hex(b)),
    TKw(b) -> bytes_concat(b"k:", b),
    TPunct(b) -> bytes_concat(b"p:", b),
    TEof -> b"e",
  }

fn hex_digits() -> Bytes = b"0123456789abcdef"

fn hex1(v: Int) -> Bytes = bytes_slice(hex_digits(), v, v + 1)

fn hex2(v: Int) -> Bytes = bytes_concat(hex1(v / 16), hex1(v % 16))

fn hex(b: Bytes) -> Bytes =
  bytes_concat_all(map(range(0, bytes_len(b)), |i: Int| hex2(bytes_at(b, i))))

// --- Tests ------------------------------------------------------------------

test "a keyword and an identifier that starts with one are different tokens" {
  assert_eq(dump(b"fn fnord"), "0:2:k:fn;3:8:i:fnord;8:8:e;")
}

test "an underscore alone is a wildcard but prefixes an identifier" {
  assert_eq(dump(b"_ _x"), "0:1:p:underscore;2:4:i:_x;4:4:e;")
}

test "an integer literal may be written with underscore separators" {
  assert_eq(dump(b"1_000_000"), "0:9:n:1000000;9:9:e;")
}

test "an integer that does not fit in Int is a diagnostic and a zero" {
  assert_eq(dump(b"99999999999999999999"), "0:20:n:0;20:20:e;0:20:!:E0001;")
}

test "a fraction or an exponent is what makes a literal a Float" {
  assert_eq(
    dump(b"1 1.5 1e9 1_000.5 1.5e-3"),
    "0:1:n:1;2:5:f:1.5;6:9:f:1e9;10:17:f:1000.5;18:24:f:1.5e-3;24:24:e;",
  )
}

test "a Decimal keeps the trailing zero its scale stands for" {
  assert_eq(dump(b"1.50m"), "0:5:d:150:2;5:5:e;")
}

test "a Decimal literal has no exponent" {
  assert_eq(dump(b"1e3m"), "0:4:d:0:0;4:4:e;0:4:!:E0001;")
}

test "the escapes a string literal decodes" {
  assert_eq(dump(b"\"a\\nb\\t\\\\\\\"\\r\\0\""), "0:16:s:610a62095c220d00;16:16:e;")
}

test "an unterminated string reports from its opening quote" {
  assert_eq(
    dump(b"let s = \"oops\nlet t = 1"),
    "0:3:k:let;4:5:i:s;6:7:p:eq;8:13:s:6f6f7073;14:17:k:let;18:19:i:t;20:21:p:eq;22:23:n:1;23:23:e;8:13:!:E0002;",
  )
}

test "a byte literal takes the string escapes plus hex" {
  assert_eq(dump(b"b\"GET \\r\\n\\x00\\xff\\\"\\\\\""), "0:23:b:474554200d0a00ff225c;23:23:e;")
}

test "a short hex escape is reported without swallowing the literal" {
  assert_eq(dump(b"b\"\\xg1\" 7"), "0:7:b:006731;8:9:n:7;9:9:e;2:4:!:E0001;")
}

test "operators use maximal munch" {
  assert_eq(
    dump(b"-> - ++ + == = != ! <= < >= > && || | .. ."),
    "0:2:p:arrow;3:4:p:minus;5:7:p:plusplus;8:9:p:plus;10:12:p:eqeq;13:14:p:eq;"
      ++ "15:17:p:bangeq;18:19:p:bang;20:22:p:le;23:24:p:lt;25:27:p:ge;28:29:p:gt;"
      ++ "30:32:p:ampamp;33:35:p:pipepipe;36:37:p:pipe;38:40:p:dotdot;41:42:p:dot;42:42:e;",
  )
}

test "the try operator is one token of its own" {
  assert_eq(dump(b"f(x)?"), "0:1:i:f;1:2:p:lparen;2:3:i:x;3:4:p:rparen;4:5:p:question;5:5:e;")
}

test "the bit operators are tokens, and a byte nothing claims is reported and skipped" {
  assert_eq(dump(b"a & b"), "0:1:i:a;2:3:p:amp;4:5:i:b;5:5:e;");
  assert_eq(dump(b"a ^ ~b"), "0:1:i:a;2:3:p:caret;4:5:p:tilde;5:6:i:b;6:6:e;");
  assert_eq(dump(b"a $ b"), "0:1:i:a;4:5:i:b;5:5:e;2:3:!:E0001;")
}

test "a hex literal is an Int bounded as a 64-bit pattern" {
  assert_eq(dump(b"0x10 0xff"), "0:4:n:16;5:9:n:255;9:9:e;");
  assert_eq(dump(b"0xFFFF_FFFF_FFFF_FFFF"), "0:21:n:-1;21:21:e;")
}

test "a comment runs to the end of its line" {
  assert_eq(dump(b"1 // two\n3"), "0:1:n:1;9:10:n:3;10:10:e;")
}

test "the end-of-file token sits at the end of the input" {
  assert_eq(dump(b"abc"), "0:3:i:abc;3:3:e;")
}

test "a comment is recorded from its slashes to the end of its line, and none is a token" {
  let lx = lex(b"1 // two\n3 // x");
  assert_eq(len(lx.toks), 3);
  assert_eq(lx.comments, [{ start: 2, end: 8 }, { start: 11, end: 15 }]);
  assert_eq(lex(b"\"//\"").comments, [])
}
