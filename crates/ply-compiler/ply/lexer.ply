// The lexer: source bytes to tokens and diagnostics.

// --- Bytes the language cannot spell ----------------------------------------

// The only inverse of `bytes_at`: Ply has no `byte_of_int`.
fn all_bytes() -> Bytes =
  b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff"

pub fn byte_of(v: Int) -> Bytes / {abort.raise} = bytes_slice(all_bytes(), v, v + 1)

// Every non-ASCII byte: a stop-set inside `b"..."`, which refuses them.
fn high_bytes() -> Bytes / {abort.raise} = bytes_slice(all_bytes(), 128, 256)

// --- Bounded peeking --------------------------------------------------------

// The byte at `i`, or -1 off either end.
fn byte_at(src: Bytes, i: Int) -> Int / {abort.raise} =
  if i < 0 || i >= bytes_len(src) { -1 } else { bytes_at(src, i) }

// `bytes_scan` refuses a start past the end rather than clamping, so every scan goes through these two.
fn scan(src: Bytes, i: Int, set: Bytes) -> Int / {abort.raise} =
  if i >= bytes_len(src) { bytes_len(src) } else { bytes_scan(src, i, set, bytes_len(src)) }

fn scan_until(src: Bytes, i: Int, set: Bytes) -> Int / {abort.raise} =
  if i >= bytes_len(src) { bytes_len(src) } else { bytes_scan_until(src, i, set, bytes_len(src)) }

// --- Tokens -----------------------------------------------------------------

// `FloatLiteral` carries normalised text and `DecimalLiteral` its mantissa as digits: 96 bits do not fit an `Int`.
pub type TokenKind =
  | Identifier(Bytes)
  | IntLiteral(Int)
  // The width's name and the value normalized to that width.
  | FixedLiteral(Bytes, Int)
  // A 128-bit literal: the width's name, then its high and low 64 bits as `Int` patterns.
  | WideLiteral(Bytes, Int, Int)
  | FloatLiteral(Bytes)
  | DecimalLiteral(Bytes, Int)
  | StringLiteral(Bytes)
  // A line string's lines, joined: a value like a `StringLiteral`'s, which only an expression may be.
  | LineString(Bytes)
  | BytesLiteral(Bytes)
  // An interpolated string's text: up to its first hole, between two holes, and after its last.
  | InterpolatedHead(Bytes)
  | InterpolatedMiddle(Bytes)
  | InterpolatedTail(Bytes)
  // A character literal's Unicode scalar value.
  | CharLiteral(Int)
  | Keyword(Bytes)
  | Punctuation(Bytes)
  | EndOfInput

pub type Token = { start: Int, end: Int, kind: TokenKind }

pub type Diag = { start: Int, end: Int, code: Bytes, message: Bytes, label: Bytes }

pub type Comment = { start: Int, end: Int }

pub type Lexed = { tokens: List<Token>, diags: List<Diag>, comments: List<Comment> }

// `tokens` must stay the last field in every `Scanner` literal: anywhere earlier, `push` copies the list (quadratic).
// `holes` is, per interpolated string open around the scan, the braces opened inside its hole.
type Scanner = { pos: Int, diags: List<Diag>, holes: List<Int>, tokens: List<Token> }

fn push_token(scanner: Scanner, start: Int, fin: Int, kind: TokenKind) -> Scanner =
  {
    pos: fin,
    diags: scanner.diags,
    holes: scanner.holes,
    tokens: push(scanner.tokens, { start: start, end: fin, kind: kind }),
  }

fn push_error(
  scanner: Scanner,
  start: Int,
  fin: Int,
  code: Bytes,
  message: Bytes,
  label: Bytes,
) -> Scanner =
  {
    pos: scanner.pos,
    holes: scanner.holes,
    tokens: scanner.tokens,
    diags: push(scanner.diags, {
      start: start,
      end: fin,
      code: code,
      message: message,
      label: label,
    }),
  }

fn with_holes(scanner: Scanner, holes: List<Int>) -> Scanner =
  { pos: scanner.pos, diags: scanner.diags, holes: holes, tokens: scanner.tokens }

fn bad_suffix(scanner: Scanner, start: Int, fin: Int, suffix: Bytes) -> Scanner =
  push_error(
    scanner,
    start,
    fin,
    unexpected(),
    bytes_concat_all([b"invalid suffix `", suffix, b"` on a numeric literal"]),
    b"the suffixes are `m` for a `Decimal` and a width \xe2\x80\x94 `u8`, `i32` and the six others; separate a name with a space",
  )

fn seek(scanner: Scanner, p: Int) -> Scanner =
  { pos: p, diags: scanner.diags, holes: scanner.holes, tokens: scanner.tokens }

fn unexpected() -> Bytes = b"E0001"

fn out_of_range() -> Bytes = b"E0211"

fn unterminated() -> Bytes = b"E0002"

fn non_ascii() -> Bytes = b"X0001"

// --- Character classes ------------------------------------------------------

// ASCII whitespace only.
fn whitespace() -> Bytes = b" \t\n\r\x0b\x0c"

fn ident_chars() -> Bytes = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

fn digit_chars() -> Bytes = b"0123456789_"

fn is_digit(c: Int) -> Bool = c >= 48 && c <= 57

fn is_ident_start(c: Int) -> Bool = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95

fn is_ident_continue(c: Int) -> Bool = is_ident_start(c) || is_digit(c)

// The UTF-8 length at a lead byte, so one refused character is one diagnostic spanning all of it.
fn utf8_len(c: Int) -> Int = if c < 128 { 1 } else if c < 224 { 2 } else if c < 240 { 3 } else { 4 }

// --- Trivia -----------------------------------------------------------------

// Whitespace and `//` comments, to the first byte of the next token.
fn skip_trivia(src: Bytes, i: Int) -> Int / {abort.raise} = {
  let j = scan(src, i, whitespace());
  if byte_at(src, j) == 47 && byte_at(src, j + 1) == 47 {
    skip_trivia(src, scan_until(src, j, b"\n"))
  } else { j }
}

// --- The loop ---------------------------------------------------------------

pub fn lex(src: Bytes) -> Lexed / {abort.raise} = {
  let n = bytes_len(src);
  let start = { pos: 0, diags: [], holes: [], tokens: [] };
  // Every step that has work left consumes at least one byte, so `n + 1` steps suffice.
  let done = fold(range(0, n + 1), start, |scanner: Scanner, i: Int| next_token(src, scanner));
  let closed = if len(done.holes) == 0 { done } else {
    push_error(
      done,
      n,
      n,
      unterminated(),
      b"an interpolated string's `{` is never closed",
      b"close the hole with `}` and the string with `\"`",
    )
  };
  let with_eof = push_token(closed, n, n, EndOfInput);
  { diags: with_eof.diags, tokens: with_eof.tokens, comments: comments(src, with_eof.tokens) }
}

// Only trivia lies between two tokens, so the comments are read off the gaps; `end` excludes the newline.
fn comments(src: Bytes, toks: List<Token>) -> List<Comment> / {abort.raise} = {
  let walked = fold(
    toks,
    { from: 0, out: [] },
    |s: { from: Int, out: List<Comment> }, token: Token|
      { from: token.end, out: gap_comments(src, s.from, token.start, s.out) },
  );
  walked.out
}

fn gap_comments(
  src: Bytes,
  i: Int,
  stop: Int,
  out: List<Comment>,
) -> List<Comment> / {abort.raise} = {
  let j = scan(src, i, whitespace());
  if j < stop && byte_at(src, j) == 47 && byte_at(src, j + 1) == 47 {
    let fin = scan_until(src, j, b"\n");
    gap_comments(src, fin, stop, push(out, { start: j, end: fin }))
  } else { out }
}

fn next_token(src: Bytes, scanner: Scanner) -> Scanner / {abort.raise} = {
  let n = bytes_len(src);
  if scanner.pos >= n { scanner } else {
    let start = skip_trivia(src, scanner.pos);
    if start >= n { seek(scanner, n) } else { token_at(src, scanner, start) }
  }
}

fn token_at(src: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} = {
  let c = bytes_at(src, start);
  if is_digit(c) { number(src, scanner, start) } else if c == 98 && byte_at(src, start + 1) == 34 {
    bytes_body(src, scanner, start, start + 2, b"")
  } else if c == 102 && byte_at(src, start + 1) == 34 {
    interpolated_piece(src, scanner, start, start + 2, b"", true)
  } else if is_ident_start(c) { ident(src, scanner, start) }
  else if c == 34 { string_lit(src, scanner, start, start + 1, b"") }
  else if c == 92 && byte_at(src, start + 1) == 92 { line_string(src, scanner, start, start, []) }
  else if c == 39 { char_lit(src, scanner, start) } else if c >= 128 {
    // With no Unicode table, any non-ASCII character outside a literal is refused as `X0001`.
    push_error(
      seek(scanner, start + utf8_len(c)),
      start,
      start + utf8_len(c),
      non_ascii(),
      bytes_concat_all([
        b"unexpected character `",
        bytes_slice(src, start, start + utf8_len(c)),
        b"`",
      ]),
      b"this character has no meaning in Ply source",
    )
  } else { punct(src, scanner, start, c) }
}

// --- Identifiers and keywords -----------------------------------------------

fn ident(src: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} = {
  let fin = scan(src, start, ident_chars());
  let text = bytes_slice(src, start, fin);
  if text == b"_" { push_token(scanner, start, fin, Punctuation(b"underscore")) }
  else if is_keyword(text) { push_token(scanner, start, fin, Keyword(text)) }
  else { push_token(scanner, start, fin, Identifier(text)) }
}

fn is_keyword(t: Bytes) -> Bool = {
  let k = bytes_len(t);
  if k == 2 { t == b"fn" || t == b"if" }
  else if k == 3 { t == b"pub" || t == b"let" }
  else if k == 4 { t == b"type" || t == b"test" || t == b"else" || t == b"with" || t == b"true" }
  else if k == 5 { t == b"match" || t == b"false" }
  else if k == 6 { t == b"import" || t == b"effect" || t == b"nondet" || t == b"handle" }
  else { false }
}

// --- Numbers ----------------------------------------------------------------

// `1`, `1_000`, `1.5`, `1.5e-3`, `1.50m`.
type NumberParts = {
  start: Int,
  whole: Bytes,
  fraction: Bytes,
  has_fraction: Bool,
  exp: Bytes,
  has_exponent: Bool,
  cursor: Int,
}

fn strip_underscores(b: Bytes) -> Bytes / {abort.raise} = bytes_concat_all(bytes_split(b, b"_"))

// A hex literal is an `Int` bounded as a 64-bit pattern.
fn number(src: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} =
  if byte_at(src, start) == 48
      && (byte_at(src, start + 1) == 120 || byte_at(src, start + 1) == 88) {
    hex_literal(src, scanner, start)
  } else { decimal_number(src, scanner, start) }

fn hex_literal(src: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} = {
  let fin = scan(src, start + 2, b"0123456789abcdefABCDEF_");
  let digits = strip_underscores(bytes_slice(src, start + 2, fin));
  if bytes_len(digits) == 0 {
    push_token(
      push_error(
        scanner,
        start,
        fin,
        unexpected(),
        b"hex literal with no digits",
        b"write at least one digit after `0x`, as in `0xFF`",
      ),
      start,
      fin,
      IntLiteral(0),
    )
  } else {
    let sufe = if is_ident_start(byte_at(src, fin)) { scan(src, fin, ident_chars()) } else { fin };
    let suffix = bytes_slice(src, fin, sufe);
    match width_named(suffix) {
      // A hex literal is a bit pattern, so the width bounds it rather than the type's range.
      Some(w) -> hex_fixed(scanner, start, sufe, digits, w),
      None -> {
        let s1 = if sufe > fin { bad_suffix(scanner, start, sufe, suffix) } else { scanner };
        let d = strip_zeros(digits);
        if bytes_len(d) > 16 {
          push_token(
            push_error(
              s1,
              start,
              fin,
              unexpected(),
              bytes_concat_all([b"hex literal `0x", digits, b"` does not fit in `Int`"]),
              b"`Int` is 64 bits, so a hex literal has at most 16 digits",
            ),
            start,
            fin,
            IntLiteral(0),
          )
        } else { push_token(s1, start, fin, IntLiteral(hex_of_digits(d))) }
      },
    }
  }
}

fn hex_fixed(
  scanner: Scanner,
  start: Int,
  fin: Int,
  digits: Bytes,
  width: Width,
) -> Scanner / {abort.raise} =
  if width.bits == 128 { hex_wide(scanner, start, fin, digits, width) }
  else { hex_narrow(scanner, start, fin, digits, width) }

fn hex_narrow(
  scanner: Scanner,
  start: Int,
  fin: Int,
  digits: Bytes,
  width: Width,
) -> Scanner / {abort.raise} = {
  let d = strip_zeros(digits);
  if bytes_len(d) > 16 || (width.bits < 64 && bytes_len(d) * 4 > width.bits && hex_over(d, width)) {
    push_token(
      push_error(
        scanner,
        start,
        fin,
        out_of_range(),
        bytes_concat_all([b"`0x", digits, b"` does not fit in `", width_upper(width), b"`"]),
        bytes_concat_all([
          b"a `",
          width_upper(width),
          b"` is ",
          int_to_bytes(width.bits),
          b" bits",
        ]),
      ),
      start,
      fin,
      FixedLiteral(width_upper(width), 0),
    )
  } else {
    push_token(
      scanner,
      start,
      fin,
      FixedLiteral(width_upper(width), width_normalize(width, hex_of_digits(d))),
    )
  }
}

// Thirty-two digits at most, the high sixteen and the low sixteen each one `Int` pattern.
fn hex_wide(
  scanner: Scanner,
  start: Int,
  fin: Int,
  digits: Bytes,
  width: Width,
) -> Scanner / {abort.raise} = {
  let d = strip_zeros(digits);
  let n = bytes_len(d);
  if n > 32 {
    push_token(
      push_error(
        scanner,
        start,
        fin,
        out_of_range(),
        bytes_concat_all([b"`0x", digits, b"` does not fit in `", width_upper(width), b"`"]),
        bytes_concat_all([b"a `", width_upper(width), b"` is 128 bits"]),
      ),
      start,
      fin,
      WideLiteral(width_upper(width), 0, 0),
    )
  } else {
    let split = if n > 16 { n - 16 } else { 0 };
    push_token(
      scanner,
      start,
      fin,
      WideLiteral(
        width_upper(width),
        hex_of_digits(bytes_slice(d, 0, split)),
        hex_of_digits(bytes_slice(d, split, n)),
      ),
    )
  }
}

// Decided on the digit string so no `Int` has to hold the pattern.
fn hex_over(d: Bytes, width: Width) -> Bool / {abort.raise} =
  bytes_len(strip_zeros(d)) * 4 > width.bits + 3
    && (bytes_len(strip_zeros(d)) - 1) * 4 >= width.bits

fn hex_of_digits(d: Bytes) -> Int / {abort.raise} =
  fold(range(0, bytes_len(d)), 0, |a: Int, i: Int|
    wrap_add(wrap_mul(a, 16), hex_digit(bytes_at(d, i))))

fn decimal_number(src: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} = {
  let we = scan(src, start, digit_chars());
  let whole = strip_underscores(bytes_slice(src, start, we));
  // `..` is the range separator, so a fraction is a dot followed by a digit.
  let hasf = byte_at(src, we) == 46 && is_digit(byte_at(src, we + 1));
  let fe = if hasf { scan(src, we + 1, digit_chars()) } else { we };
  let frac = if hasf { strip_underscores(bytes_slice(src, we + 1, fe)) } else { b"" };
  let es = exponent_start(src, fe);
  let ee = if es < 0 { fe } else { scan(src, es, digit_chars()) };
  number_tail(src, scanner, {
    start: start,
    whole: whole,
    fraction: frac,
    has_fraction: hasf,
    exp: if es < 0 { b"" } else { exponent_text(src, fe, es, ee) },
    has_exponent: es >= 0,
    cursor: ee,
  })
}

// The first exponent digit, or -1: the `e` is consumed only when digits follow.
fn exponent_start(src: Bytes, i: Int) -> Int / {abort.raise} = {
  let c = byte_at(src, i);
  if c != 101 && c != 69 { -1 } else {
    let d = byte_at(src, i + 1);
    let j = if d == 43 || d == 45 { i + 2 } else { i + 1 };
    if is_digit(byte_at(src, j)) { j } else { -1 }
  }
}

fn exponent_text(src: Bytes, e: Int, es: Int, ee: Int) -> Bytes / {abort.raise} =
  bytes_concat(bytes_slice(src, e + 1, es), strip_underscores(bytes_slice(src, es, ee)))

fn number_tail(src: Bytes, scanner: Scanner, parts: NumberParts) -> Scanner / {abort.raise} =
  if byte_at(src, parts.cursor) == 109 && !is_ident_continue(byte_at(src, parts.cursor + 1)) {
    decimal(scanner, parts, parts.cursor + 1)
  } else if is_ident_start(byte_at(src, parts.cursor)) {
    let fin = scan(src, parts.cursor, ident_chars());
    // A width suffix applies only to an integer; `1.5u8` is refused as a bad suffix.
    match if parts.has_fraction || parts.has_exponent { None }
      else { width_named(bytes_slice(src, parts.cursor, fin)) } {
      Some(w) -> fixed_value(scanner, parts, fin, w),
      None ->
        number_value(
          bad_suffix(scanner, parts.start, fin, bytes_slice(src, parts.cursor, fin)),
          parts,
          fin,
        ),
    }
  } else { number_value(scanner, parts, parts.cursor) }

// A decimal spelling is a value, so its bound is the type's range.
fn fixed_value(
  scanner: Scanner,
  parts: NumberParts,
  fin: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  if width.bits == 128 { wide_value(scanner, parts, fin, width) }
  else { narrow_value(scanner, parts, fin, width) }

fn narrow_value(
  scanner: Scanner,
  parts: NumberParts,
  fin: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  if width.bits == 64 && !width.signed { u64_value(scanner, parts, fin, width) } else {
    let d = strip_zeros(parts.whole);
    let k = bytes_len(d);
    let too_long = k > 19 || (k == 19 && compare(d, int_max()) == Greater);
    if too_long || over_width(d, width) {
      push_token(
        push_error(
          scanner,
          parts.start,
          fin,
          out_of_range(),
          bytes_concat_all([b"`", parts.whole, b"` is not a value of `", width_upper(width), b"`"]),
          bytes_concat_all([b"`", width_upper(width), b"` holds ", width_range(width)]),
        ),
        parts.start,
        fin,
        FixedLiteral(width_upper(width), 0),
      )
    } else {
      push_token(
        scanner,
        parts.start,
        fin,
        FixedLiteral(width_upper(width), width_normalize(width, int_of_digits(d))),
      )
    }
  }

// Past `Int`'s range a `U64` is the pattern its 64 bits make, as a hex spelling of it is.
fn u64_value(
  scanner: Scanner,
  parts: NumberParts,
  fin: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  match limbs_of_digits(strip_zeros(parts.whole)) {
    Some(ls) -> if limb(ls, 3) != 0 || limb(ls, 2) != 0 {
      narrow_out_of_range(scanner, parts, fin, width)
    } else {
      push_token(
        scanner,
        parts.start,
        fin,
        FixedLiteral(width_upper(width), limb(ls, 1) << 32 | limb(ls, 0)),
      )
    },
    None -> narrow_out_of_range(scanner, parts, fin, width),
  }

fn narrow_out_of_range(
  scanner: Scanner,
  parts: NumberParts,
  fin: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  push_token(
    push_error(
      scanner,
      parts.start,
      fin,
      out_of_range(),
      bytes_concat_all([b"`", parts.whole, b"` is not a value of `", width_upper(width), b"`"]),
      bytes_concat_all([b"`", width_upper(width), b"` holds ", width_range(width)]),
    ),
    parts.start,
    fin,
    FixedLiteral(width_upper(width), 0),
  )

// Read into four 32-bit limbs, so no `Int` overflows on the way; a signed width keeps its top bit clear.
fn wide_value(
  scanner: Scanner,
  parts: NumberParts,
  fin: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  match limbs_of_digits(strip_zeros(parts.whole)) {
    Some(ls) -> if width.signed && limb(ls, 3) >= power_of_two(31) {
      wide_out_of_range(scanner, parts, fin, width)
    } else {
      push_token(
        scanner,
        parts.start,
        fin,
        WideLiteral(
          width_upper(width),
          limb(ls, 3) << 32 | limb(ls, 2),
          limb(ls, 1) << 32 | limb(ls, 0),
        ),
      )
    },
    None -> wide_out_of_range(scanner, parts, fin, width),
  }

fn wide_out_of_range(
  scanner: Scanner,
  parts: NumberParts,
  fin: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  push_token(
    push_error(
      scanner,
      parts.start,
      fin,
      out_of_range(),
      bytes_concat_all([b"`", parts.whole, b"` is not a value of `", width_upper(width), b"`"]),
      bytes_concat_all([b"`", width_upper(width), b"` holds ", width_range(width)]),
    ),
    parts.start,
    fin,
    WideLiteral(width_upper(width), 0, 0),
  )

// Least significant first; `None` once the value passes 128 bits.
fn limbs_of_digits(d: Bytes) -> Option<List<Int>> / {abort.raise} =
  fold(range(0, bytes_len(d)), Some([0, 0, 0, 0]), |acc: Option<List<Int>>, i: Int|
    match acc { None -> None, Some(ls) -> times_ten_plus(ls, bytes_at(d, i) - 48) })

fn times_ten_plus(ls: List<Int>, digit: Int) -> Option<List<Int>> = {
  let step = fold(ls, { carry: digit, out: [] }, |acc: { carry: Int, out: List<Int> }, l: Int| {
    let v = l * 10 + acc.carry;
    { carry: v >>> 32, out: push(acc.out, v & 0xFFFF_FFFF) }
  });
  if step.carry == 0 { Some(step.out) } else { None }
}

fn limb(ls: List<Int>, i: Int) -> Int = match list_at(ls, i) { Some(l) -> l, None -> 0 }

// The decimal spelling of a 128-bit value given as its high and low 64-bit patterns.
pub fn wide_decimal(signed: Bool, high: Int, low: Int) -> Bytes =
  if signed && high < 0 {
    bytes_concat(
      b"-",
      limbs_decimal(
        high_first(if low == 0 { wrap_sub(0, high) } else { ~high }, wrap_sub(0, low)),
        b"",
      ),
    )
  } else { limbs_decimal(high_first(high, low), b"") }

fn high_first(high: Int, low: Int) -> List<Int> =
  [high >>> 32, high & 0xFFFF_FFFF, low >>> 32, low & 0xFFFF_FFFF]

// Divides by ten down the limbs, most significant first, until the quotient is zero.
fn limbs_decimal(ls: List<Int>, acc: Bytes) -> Bytes = {
  let step = fold(ls, { rem: 0, out: [] }, |a: { rem: Int, out: List<Int> }, l: Int| {
    let cur = a.rem << 32 | l;
    { rem: cur % 10, out: push(a.out, cur / 10) }
  });
  let digits = bytes_concat(int_to_bytes(step.rem), acc);
  if fold(step.out, true, |z: Bool, l: Int| z && l == 0) { digits }
  else { limbs_decimal(step.out, digits) }
}

// At 64 bits the caller's `int_max` check is the only bound.
fn over_width(d: Bytes, width: Width) -> Bool / {abort.raise} =
  if width.bits == 64 { false } else { int_of_digits(d) > width_max(width) }

fn width_range(width: Width) -> Bytes =
  if width.bits == 128 {
    if width.signed {
      b"-170141183460469231731687303715884105728 to 170141183460469231731687303715884105727"
    } else { b"0 to 340282366920938463463374607431768211455" }
  } else if width.bits == 64 {
    if width.signed { b"-9223372036854775808 to 9223372036854775807" }
    else { b"0 to 18446744073709551615" }
  } else if width.signed {
    bytes_concat_all([
      b"-",
      int_to_bytes(power_of_two(width.bits - 1)),
      b" to ",
      int_to_bytes(width_max(width)),
    ])
  } else { bytes_concat_all([b"0 to ", int_to_bytes(width_max(width))]) }

fn number_value(scanner: Scanner, parts: NumberParts, fin: Int) -> Scanner / {abort.raise} =
  if !parts.has_fraction && !parts.has_exponent { int_value(scanner, parts, fin) }
  else { push_token(scanner, parts.start, fin, FloatLiteral(float_text(parts))) }

fn float_text(parts: NumberParts) -> Bytes =
  bytes_concat_all([
    parts.whole,
    if parts.has_fraction { b"." } else { b"" },
    if parts.has_fraction { parts.fraction } else { b"" },
    if parts.has_exponent { b"e" } else { b"" },
    if parts.has_exponent { parts.exp } else { b"" },
  ])

// --- Integers ---------------------------------------------------------------

// `Int` arithmetic is checked, so a literal's bound is decided on its digits before accumulating.
fn int_max() -> Bytes = b"9223372036854775807"

fn strip_zeros(b: Bytes) -> Bytes / {abort.raise} = {
  let k = scan(b, 0, b"0");
  if k >= bytes_len(b) { b"0" } else { bytes_slice(b, k, bytes_len(b)) }
}

fn int_value(scanner: Scanner, parts: NumberParts, fin: Int) -> Scanner / {abort.raise} = {
  let d = strip_zeros(parts.whole);
  let k = bytes_len(d);
  if k > 19 || (k == 19 && compare(d, int_max()) == Greater) {
    push_token(
      push_error(
        scanner,
        parts.start,
        fin,
        unexpected(),
        bytes_concat_all([b"integer literal `", parts.whole, b"` does not fit in `Int`"]),
        b"`Int` is a 64-bit signed integer; use a smaller value",
      ),
      parts.start,
      fin,
      IntLiteral(0),
    )
  } else { push_token(scanner, parts.start, fin, IntLiteral(int_of_digits(d))) }
}

fn int_of_digits(d: Bytes) -> Int / {abort.raise} =
  fold(range(0, bytes_len(d)), 0, |a: Int, i: Int| a * 10 + (bytes_at(d, i) - 48))

// --- Widths -----------------------------------------------------------------

pub type Width = { name: Bytes, bits: Int, signed: Bool }

pub fn widths() -> List<Width> =
  [
    { name: b"u8", bits: 8, signed: false },
    { name: b"u16", bits: 16, signed: false },
    { name: b"u32", bits: 32, signed: false },
    { name: b"u64", bits: 64, signed: false },
    { name: b"i8", bits: 8, signed: true },
    { name: b"i16", bits: 16, signed: true },
    { name: b"i32", bits: 32, signed: true },
    { name: b"i64", bits: 64, signed: true },
    // Last, so every narrower width keeps the number a hash and the runtime know it by.
    { name: b"u128", bits: 128, signed: false },
    { name: b"i128", bits: 128, signed: true },
  ]

pub fn width_named(suffix: Bytes) -> Option<Width> =
  fold(widths(), None, |found: Option<Width>, width: Width|
    match found { Some(_) -> found, None -> if width.name == suffix { Some(width) } else { None } })

fn width_upper(width: Width) -> Bytes / {abort.raise} = string_upper_bytes(width.name)

fn string_upper_bytes(b: Bytes) -> Bytes / {abort.raise} =
  bytes_of_string(string_upper(string_of_bytes(b)))

fn power_of_two(n: Int) -> Int = fold(range(0, n), 1, |a: Int, _: Int| a * 2)

// Only below 64 bits: `power_of_two(63)` overflows `Int`.
fn width_max(width: Width) -> Int =
  if width.signed { power_of_two(width.bits - 1) - 1 } else { power_of_two(width.bits) - 1 }

// The low `bits` kept, sign-extended when the width is signed.
pub fn width_normalize(width: Width, v: Int) -> Int =
  if width.bits >= 64 { v } else {
    let low = v & power_of_two(width.bits) - 1;
    if width.signed && low >>> width.bits - 1 == 1 { low | 0 - power_of_two(width.bits) }
    else { low }
  }

// --- Decimals ---------------------------------------------------------------

// A `Decimal` mantissa is 96 bits and its scale 0..=28; neither fits an `Int` check, so both use the digits.
fn decimal_max() -> Bytes = b"79228162514264337593543950335"

fn zero_decimal() -> TokenKind = DecimalLiteral(b"0", 0)

fn decimal(scanner: Scanner, parts: NumberParts, fin: Int) -> Scanner / {abort.raise} =
  if parts.has_exponent {
    push_token(
      push_error(
        scanner,
        parts.start,
        fin,
        unexpected(),
        b"a `Decimal` literal has no exponent",
        b"write the digits out, or drop the `m` for a `Float`",
      ),
      parts.start,
      fin,
      zero_decimal(),
    )
  } else if bytes_len(parts.fraction) > 28 {
    push_token(
      push_error(
        scanner,
        parts.start,
        fin,
        unexpected(),
        bytes_concat_all([
          b"a `Decimal` literal has at most 28 decimal places, not ",
          int_to_bytes(bytes_len(parts.fraction)),
        ]),
        b"round the literal, or use `Float`",
      ),
      parts.start,
      fin,
      zero_decimal(),
    )
  } else {
    let d = strip_zeros(bytes_concat(parts.whole, parts.fraction));
    let k = bytes_len(d);
    if k > 29 || (k == 29 && compare(d, decimal_max()) == Greater) {
      push_token(
        push_error(
          scanner,
          parts.start,
          fin,
          unexpected(),
          b"a `Decimal` literal has at most 96 bits of mantissa",
          b"the largest is 79228162514264337593543950335",
        ),
        parts.start,
        fin,
        zero_decimal(),
      )
    } else { push_token(scanner, parts.start, fin, DecimalLiteral(d, bytes_len(parts.fraction))) }
  }

// --- String literals --------------------------------------------------------

fn string_stops() -> Bytes = b"\"\\\n"

fn string_lit(
  src: Bytes,
  scanner: Scanner,
  open: Int,
  i: Int,
  acc: Bytes,
) -> Scanner / {abort.raise} = {
  let stop = scan_until(src, i, string_stops());
  let so_far = bytes_concat(acc, bytes_slice(src, i, stop));
  let c = byte_at(src, stop);
  if c < 0 || c == 10 {
    push_token(
      push_error(
        scanner,
        open,
        stop,
        unterminated(),
        b"unterminated string literal",
        b"add a closing `\"`; a string may not span a line break",
      ),
      open,
      stop,
      StringLiteral(so_far),
    )
  } else if c == 34 { push_token(scanner, open, stop + 1, StringLiteral(so_far)) }
  else { string_escape(src, scanner, open, stop, so_far) }
}

fn unknown_escape(
  src: Bytes,
  scanner: Scanner,
  stop: Int,
  w: Int,
  valid: Bytes,
) -> Scanner / {abort.raise} =
  push_error(
    scanner,
    stop,
    stop + 1 + w,
    unexpected(),
    bytes_concat_all([
      b"unknown escape sequence `\\",
      bytes_slice(src, stop + 1, stop + 1 + w),
      b"`",
    ]),
    valid,
  )

fn string_escape(
  src: Bytes,
  scanner: Scanner,
  open: Int,
  stop: Int,
  so_far: Bytes,
) -> Scanner / {abort.raise} = {
  let n = bytes_len(src);
  if byte_at(src, stop + 1) < 0 {
    push_token(
      push_error(
        scanner,
        open,
        n,
        unterminated(),
        b"unterminated string literal",
        b"add a closing `\"`",
      ),
      open,
      n,
      StringLiteral(so_far),
    )
  } else {
    let e = text_escape(src, scanner, stop);
    string_lit(src, e.s, open, e.next, bytes_concat(so_far, e.text))
  }
}

// The escape at the backslash `stop` of a string's text, which is not the last byte: the bytes it
// stands for and where the text goes on. An unknown escape is reported and its character kept.
fn text_escape(
  src: Bytes,
  scanner: Scanner,
  stop: Int,
) -> { s: Scanner, text: Bytes, next: Int } / {abort.raise} = {
  let c = byte_at(src, stop + 1);
  if c == 110 { { s: scanner, text: b"\n", next: stop + 2 } }
  else if c == 116 { { s: scanner, text: b"\t", next: stop + 2 } }
  else if c == 114 { { s: scanner, text: b"\r", next: stop + 2 } }
  else if c == 48 { { s: scanner, text: b"\x00", next: stop + 2 } }
  else if c == 92 { { s: scanner, text: b"\\", next: stop + 2 } }
  else if c == 34 { { s: scanner, text: b"\"", next: stop + 2 } }
  else if c == 39 { { s: scanner, text: b"'", next: stop + 2 } } else if c == 117 {
    let u = unicode_escape(src, stop);
    if u.point < 0 { { s: refused(scanner, stop, u), text: b"", next: u.end } }
    else { { s: scanner, text: utf8_of(u.point), next: u.end } }
  } else {
    let w = utf8_len(c);
    {
      s: unknown_escape(src, scanner, stop, w, valid_escapes()),
      text: bytes_slice(src, stop + 1, stop + 1 + w),
      next: stop + 1 + w,
    }
  }
}

// --- Interpolated strings ---------------------------------------------------

// `f"a {x} b"` is `InterpolatedHead("a ")`, the tokens of `x`, then `InterpolatedTail(" b")`; the text between two
// holes is a `InterpolatedMiddle`. One with no hole is a plain `StringLiteral`. `{{` and `}}` are braces of the text.
fn interpolated_stops() -> Bytes = b"\"\\\n{}"

// `open` is where the piece's token starts: the `f` of a head, otherwise the `}` closing a hole.
fn interpolated_piece(
  src: Bytes,
  scanner: Scanner,
  open: Int,
  i: Int,
  acc: Bytes,
  head: Bool,
) -> Scanner / {abort.raise} = {
  let n = bytes_len(src);
  let stop = scan_until(src, i, interpolated_stops());
  let so_far = bytes_concat(acc, bytes_slice(src, i, stop));
  let c = byte_at(src, stop);
  let last = if head { StringLiteral(so_far) } else { InterpolatedTail(so_far) };
  if c < 0 || c == 10 || (c == 92 && byte_at(src, stop + 1) < 0) {
    push_token(
      push_error(
        scanner,
        open,
        if c == 92 { n } else { stop },
        unterminated(),
        b"unterminated string literal",
        b"add a closing `\"`; a string may not span a line break",
      ),
      open,
      if c == 92 { n } else { stop },
      last,
    )
  } else if c == 34 { push_token(scanner, open, stop + 1, last) } else if c == 92 {
    let e = text_escape(src, scanner, stop);
    interpolated_piece(src, e.s, open, e.next, bytes_concat(so_far, e.text), head)
  } else if byte_at(src, stop + 1) == c {
    interpolated_piece(
      src,
      scanner,
      open,
      stop + 2,
      bytes_concat(so_far, bytes_slice(src, stop, stop + 1)),
      head,
    )
  } else if c == 123 {
    let t = if head { InterpolatedHead(so_far) } else { InterpolatedMiddle(so_far) };
    push_token(with_holes(scanner, push(scanner.holes, 0)), open, stop + 1, t)
  } else {
    interpolated_piece(
      src,
      push_error(
        scanner,
        stop,
        stop + 1,
        unexpected(),
        b"a lone `}` in an interpolated string",
        b"write `}}` for a brace in the text",
      ),
      open,
      stop + 1,
      so_far,
      head,
    )
  }
}

// A brace opened or closed inside the innermost hole; outside every hole there is nothing to count.
fn nest_hole(scanner: Scanner, d: Int) -> Scanner =
  match list_at(scanner.holes, len(scanner.holes) - 1) {
    None -> scanner,
    Some(k) -> with_holes(scanner, push(drop_last(scanner.holes), k + d)),
  }

// A `}` with no brace of its own open inside the innermost hole ends that hole.
fn closes_hole(scanner: Scanner) -> Bool =
  match list_at(scanner.holes, len(scanner.holes) - 1) { Some(k) -> k == 0, None -> false }

fn drop_last(xs: List<Int>) -> List<Int> =
  fold(range(0, len(xs) - 1), [], |acc: List<Int>, i: Int|
    match list_at(xs, i) { Some(x) -> push(acc, x), None -> acc })

fn valid_escapes() -> Bytes = b"valid escapes are \\n \\t \\r \\0 \\\\ \\\" \\' and \\u{...}"

// --- Escapes shared by strings and characters --------------------------------

// What an escape names: a Unicode scalar value, or `-1` with the refusal in `code` and `message`.
type Escape = { point: Int, end: Int, code: Bytes, message: Bytes, label: Bytes }

fn escape_at(point: Int, end: Int) -> Escape =
  { point: point, end: end, code: b"", message: b"", label: b"" }

fn bad_escape(end: Int, code: Bytes, message: Bytes, label: Bytes) -> Escape =
  { point: -1, end: end, code: code, message: message, label: label }

fn refused(scanner: Scanner, at_backslash: Int, escape: Escape) -> Scanner =
  push_error(scanner, at_backslash, escape.end, escape.code, escape.message, escape.label)

fn hex_chars() -> Bytes = b"0123456789abcdefABCDEF"

// `\u{1F600}` at the backslash `i`: one to six hex digits between braces, naming a Unicode scalar
// value. Only the braces and digits present are consumed, so a closing quote survives a malformed one.
fn unicode_escape(src: Bytes, i: Int) -> Escape / {abort.raise} =
  if byte_at(src, i + 2) != 123 {
    bad_escape(
      i + 2,
      unexpected(),
      b"`\\u` takes its character's hex digits in braces",
      b"write it as `\\u{1F600}`",
    )
  } else {
    let first = i + 3;
    let stop = scan(src, first, hex_chars());
    let closed = byte_at(src, stop) == 125;
    if stop == first || stop - first > 6 || !closed {
      bad_escape(
        if closed { stop + 1 } else { stop },
        unexpected(),
        b"`\\u{...}` holds one to six hex digits and a closing `}`",
        b"as in `\\u{e9}` or `\\u{1F600}`",
      )
    } else {
      let v = fold(range(first, stop), 0, |acc: Int, k: Int| acc * 16 + hex_digit(byte_at(src, k)));
      if v > 1114111 || (v >= 55296 && v <= 57343) {
        bad_escape(
          stop + 1,
          out_of_range(),
          b"`\\u{...}` names no character",
          b"a surrogate, `D800` to `DFFF`, or a value past `10FFFF` is not a Unicode scalar value",
        )
      } else { escape_at(v, stop + 1) }
    }
  }

// The escape at the backslash `i` inside a character literal.
fn char_escape(src: Bytes, i: Int) -> Escape / {abort.raise} = {
  let c = byte_at(src, i + 1);
  if c == 110 { escape_at(10, i + 2) }
  else if c == 116 { escape_at(9, i + 2) }
  else if c == 114 { escape_at(13, i + 2) }
  else if c == 48 { escape_at(0, i + 2) }
  else if c == 92 { escape_at(92, i + 2) }
  else if c == 39 { escape_at(39, i + 2) }
  else if c == 34 { escape_at(34, i + 2) }
  else if c == 117 { unicode_escape(src, i) } else if c < 0 || c == 10 {
    bad_escape(i + 1, unterminated(), b"unterminated character literal", b"add a closing `'`")
  } else {
    let w = utf8_len(c);
    bad_escape(
      i + 1 + w,
      unexpected(),
      bytes_concat_all([b"unknown escape sequence `\\", bytes_slice(src, i + 1, i + 1 + w), b"`"]),
      valid_escapes(),
    )
  }
}

// A scalar value as its UTF-8 bytes.
pub fn utf8_of(v: Int) -> Bytes / {abort.raise} =
  if v < 128 { byte_of(v) }
  else if v < 2048 { bytes_concat(byte_of(192 | v >> 6), byte_of(128 | v & 63)) }
  else if v < 65536 {
    bytes_concat_all([byte_of(224 | v >> 12), byte_of(128 | v >> 6 & 63), byte_of(128 | v & 63)])
  } else {
    bytes_concat_all([
      byte_of(240 | v >> 18),
      byte_of(128 | v >> 12 & 63),
      byte_of(128 | v >> 6 & 63),
      byte_of(128 | v & 63),
    ])
  }

// The scalar value of the `w`-byte UTF-8 sequence at `i`; the source is UTF-8 by the time it is lexed.
fn utf8_point(src: Bytes, i: Int, w: Int) -> Int / {abort.raise} =
  if w == 1 { byte_at(src, i) }
  else if w == 2 { (byte_at(src, i) & 31) << 6 | byte_at(src, i + 1) & 63 } else if w == 3 {
    (byte_at(src, i) & 15) << 12 | (byte_at(src, i + 1) & 63) << 6 | byte_at(src, i + 2) & 63
  } else {
    (byte_at(src, i) & 7) << 18 | (byte_at(src, i + 1) & 63) << 12 | (byte_at(src, i + 2) & 63) << 6
      | byte_at(src, i + 3) & 63
  }

// --- Character literals -----------------------------------------------------

// `'a'`, `'\n'` or `'\u{1F600}'`: exactly one character between single quotes.
fn char_lit(src: Bytes, scanner: Scanner, open: Int) -> Scanner / {abort.raise} = {
  let c = byte_at(src, open + 1);
  if c < 0 || c == 10 { unterminated_char(scanner, open, open + 1, 0) } else if c == 39 {
    push_token(
      push_error(
        scanner,
        open,
        open + 2,
        unexpected(),
        b"an empty character literal",
        b"a character literal holds exactly one character",
      ),
      open,
      open + 2,
      CharLiteral(0),
    )
  } else if c == 92 {
    let e = char_escape(src, open + 1);
    if e.point < 0 { char_close(src, refused(scanner, open + 1, e), open, e.end, 0) }
    else { char_close(src, scanner, open, e.end, e.point) }
  } else {
    let w = utf8_len(c);
    char_close(src, scanner, open, open + 1 + w, utf8_point(src, open + 1, w))
  }
}

// The closing quote after the one character; more before it is refused, and so is none on the line.
fn char_close(
  src: Bytes,
  scanner: Scanner,
  open: Int,
  i: Int,
  point: Int,
) -> Scanner / {abort.raise} =
  if byte_at(src, i) == 39 { push_token(scanner, open, i + 1, CharLiteral(point)) } else {
    let close = scan_until(src, i, b"'\n");
    if byte_at(src, close) == 39 {
      push_token(
        push_error(
          scanner,
          open,
          close + 1,
          unexpected(),
          b"a character literal holds one character",
          b"write a string, `\"...\"`, for more than one",
        ),
        open,
        close + 1,
        CharLiteral(point),
      )
    } else { unterminated_char(scanner, open, close, point) }
  }

fn unterminated_char(scanner: Scanner, open: Int, stop: Int, point: Int) -> Scanner =
  push_token(
    push_error(
      scanner,
      open,
      stop,
      unterminated(),
      b"unterminated character literal",
      b"add a closing `'`",
    ),
    open,
    stop,
    CharLiteral(point),
  )

// --- Line strings -----------------------------------------------------------

// A `\r` before a line's `\n` ends the line rather than being content.
fn line_string(
  src: Bytes,
  scanner: Scanner,
  open: Int,
  line: Int,
  done: List<Bytes>,
) -> Scanner / {abort.raise} = {
  let from = line + 2;
  let eol = scan_until(src, from, b"\n");
  let fin = if eol > from && byte_at(src, eol - 1) == 13 { eol - 1 } else { eol };
  let blank = scan_back(src, from, fin);
  let checked = if blank == fin { scanner } else {
    push_error(
      scanner,
      blank,
      fin,
      unexpected(),
      b"a line of a line string ends in whitespace",
      b"whitespace at the end of a line is invisible, so it is not content; end the line before it, or write the line as a `\"...\"` string with the spaces in it",
    )
  };
  let lines = push(done, bytes_slice(src, from, fin));
  let next = continued_at(src, eol);
  if next < 0 { push_token(checked, open, fin, LineString(joined_lines(lines))) }
  else { line_string(src, checked, open, next, lines) }
}

fn scan_back(src: Bytes, from: Int, fin: Int) -> Int / {abort.raise} =
  iterate(fin, fin - from + 1, |i: Int|
    if i > from && (byte_at(src, i - 1) == 32 || byte_at(src, i - 1) == 9) { Continue(i - 1) }
    else { Stop(i) })

// The `\\` continuing a line string on the line after `eol`, or -1.
fn continued_at(src: Bytes, eol: Int) -> Int / {abort.raise} =
  if byte_at(src, eol) != 10 { -1 } else {
    let k = scan(src, eol + 1, b" \t");
    if byte_at(src, k) == 92 && byte_at(src, k + 1) == 92 { k } else { -1 }
  }

fn joined_lines(lines: List<Bytes>) -> Bytes =
  bytes_concat_all(
    fold(range(0, len(lines)), [], |acc: List<Bytes>, i: Int|
      match list_at(lines, i) {
        Some(l) -> if i == 0 { push(acc, l) } else { push(push(acc, b"\n"), l) },
        None -> acc,
      }),
  )

// --- Byte-string literals ---------------------------------------------------

// A byte above `~` is refused rather than encoded, so the literal cannot depend on the file's encoding.
fn bytes_stops() -> Bytes / {abort.raise} = bytes_concat(b"\"\\\n", high_bytes())

fn bytes_body(
  src: Bytes,
  scanner: Scanner,
  open: Int,
  i: Int,
  acc: Bytes,
) -> Scanner / {abort.raise} = {
  let stop = scan_until(src, i, bytes_stops());
  let so_far = bytes_concat(acc, bytes_slice(src, i, stop));
  let c = byte_at(src, stop);
  if c < 0 || c == 10 {
    push_token(
      push_error(
        scanner,
        open,
        stop,
        unterminated(),
        b"unterminated byte-string literal",
        b"add a closing `\"`; a literal may not span a line break",
      ),
      open,
      stop,
      BytesLiteral(so_far),
    )
  } else if c == 34 { push_token(scanner, open, stop + 1, BytesLiteral(so_far)) }
  else if c == 92 { bytes_escape(src, scanner, open, stop, so_far) } else {
    let w = utf8_len(c);
    let ch = bytes_slice(src, stop, stop + w);
    let encoded = bytes_concat_all(
      map(range(0, w), |i: Int| bytes_concat(b"\\x", hex_byte_text(bytes_at(ch, i)))),
    );
    bytes_body(
      src,
      push_error(
        scanner,
        stop,
        stop + w,
        unexpected(),
        bytes_concat_all([
          b"`",
          ch,
          b"` is not an ASCII character, so it has no place in `b\"...\"`",
        ]),
        bytes_concat_all([b"write `", encoded, b"` instead"]),
      ),
      open,
      stop + w,
      so_far,
    )
  }
}

fn bytes_escape(
  src: Bytes,
  scanner: Scanner,
  open: Int,
  stop: Int,
  so_far: Bytes,
) -> Scanner / {abort.raise} = {
  let n = bytes_len(src);
  let c = byte_at(src, stop + 1);
  if c < 0 {
    push_token(
      push_error(
        scanner,
        open,
        n,
        unterminated(),
        b"unterminated byte-string literal",
        b"add a closing `\"`",
      ),
      open,
      n,
      BytesLiteral(so_far),
    )
  } else if c == 110 { bytes_body(src, scanner, open, stop + 2, bytes_concat(so_far, b"\n")) }
  else if c == 116 { bytes_body(src, scanner, open, stop + 2, bytes_concat(so_far, b"\t")) }
  else if c == 114 { bytes_body(src, scanner, open, stop + 2, bytes_concat(so_far, b"\r")) }
  else if c == 48 { bytes_body(src, scanner, open, stop + 2, bytes_concat(so_far, b"\x00")) }
  else if c == 92 { bytes_body(src, scanner, open, stop + 2, bytes_concat(so_far, b"\\")) }
  else if c == 34 { bytes_body(src, scanner, open, stop + 2, bytes_concat(so_far, b"\"")) }
  else if c == 120 { hex_escape(src, scanner, open, stop, so_far) } else if c == 117 {
    // Consumed whole, so what follows reads as the literal's next bytes.
    let u = unicode_escape(src, stop);
    bytes_body(
      src,
      push_error(
        scanner,
        stop,
        u.end,
        unexpected(),
        b"`\\u{...}` names a character, and a byte string holds bytes",
        b"write the character's UTF-8 bytes as `\\xNN` escapes",
      ),
      open,
      u.end,
      so_far,
    )
  } else {
    // Unlike a string's unknown escape, this one contributes no byte.
    let w = utf8_len(c);
    bytes_body(
      src,
      unknown_escape(
        src,
        scanner,
        stop,
        w,
        b"valid escapes are \\n \\t \\r \\0 \\\\ \\\" and \\xNN",
      ),
      open,
      stop + 1 + w,
      so_far,
    )
  }
}

// A malformed escape yields a zero byte and consumes only the hex digits present, so the closing quote survives.
fn hex_escape(
  src: Bytes,
  scanner: Scanner,
  open: Int,
  stop: Int,
  so_far: Bytes,
) -> Scanner / {abort.raise} = {
  let hi = hex_digit(byte_at(src, stop + 2));
  let lo = hex_digit(byte_at(src, stop + 3));
  if hi >= 0 && lo >= 0 {
    bytes_body(src, scanner, open, stop + 4, bytes_concat(so_far, byte_of(hi * 16 + lo)))
  } else {
    let taken = if hi >= 0 { stop + 3 } else { stop + 2 };
    bytes_body(
      src,
      push_error(
        scanner,
        stop,
        taken,
        unexpected(),
        b"`\\x` needs exactly two hex digits",
        b"write two hex digits, as in `\\x0d`",
      ),
      open,
      taken,
      bytes_concat(so_far, b"\x00"),
    )
  }
}

fn hex_digit(c: Int) -> Int =
  if c >= 48 && c <= 57 { c - 48 }
  else if c >= 97 && c <= 102 { c - 87 }
  else if c >= 65 && c <= 70 { c - 55 }
  else { -1 }

// --- Punctuation ------------------------------------------------------------

// Maximal munch.
fn punct(src: Bytes, scanner: Scanner, start: Int, c: Int) -> Scanner / {abort.raise} =
  if c == 40 { push_token(scanner, start, start + 1, Punctuation(b"lparen")) }
  else if c == 41 { push_token(scanner, start, start + 1, Punctuation(b"rparen")) }
  else if c == 123 { push_token(nest_hole(scanner, 1), start, start + 1, Punctuation(b"lbrace")) }
  else if c == 125 && closes_hole(scanner) {
    interpolated_piece(
      src,
      with_holes(scanner, drop_last(scanner.holes)),
      start,
      start + 1,
      b"",
      false,
    )
  } else if c == 125 {
    push_token(nest_hole(scanner, -1), start, start + 1, Punctuation(b"rbrace"))
  } else if c == 91 { push_token(scanner, start, start + 1, Punctuation(b"lbracket")) }
  else if c == 93 { push_token(scanner, start, start + 1, Punctuation(b"rbracket")) }
  else if c == 44 { push_token(scanner, start, start + 1, Punctuation(b"comma")) }
  else if c == 59 { push_token(scanner, start, start + 1, Punctuation(b"semi")) }
  else if c == 58 { punct_pair(scanner, src, start, 58, b"coloncolon", b"colon") }
  else if c == 46 { punct_pair(scanner, src, start, 46, b"dotdot", b"dot") }
  else if c == 61 { punct_pair(scanner, src, start, 61, b"eqeq", b"eq") }
  else if c == 33 { punct_pair(scanner, src, start, 61, b"bangeq", b"bang") }
  else if c == 60 { punct_pair(scanner, src, start, 61, b"le", b"lt") }
  else if c == 62 { punct_pair(scanner, src, start, 61, b"ge", b"gt") }
  else if c == 43 { punct_pair(scanner, src, start, 43, b"plusplus", b"plus") }
  else if c == 45 { punct_pair(scanner, src, start, 62, b"arrow", b"minus") }
  else if c == 42 { push_token(scanner, start, start + 1, Punctuation(b"star")) }
  else if c == 47 { push_token(scanner, start, start + 1, Punctuation(b"slash")) }
  else if c == 37 { push_token(scanner, start, start + 1, Punctuation(b"percent")) }
  else if c == 63 { push_token(scanner, start, start + 1, Punctuation(b"question")) }
  else if c == 124 { punct_pair(scanner, src, start, 124, b"pipepipe", b"pipe") }
  // `<<` and `>>` are not lexed, so `Map<Int, List<Int>>` closes; the parser joins touching `<`s and `>`s.
  else if c == 38 { punct_pair(scanner, src, start, 38, b"ampamp", b"amp") }
  else if c == 94 { push_token(scanner, start, start + 1, Punctuation(b"caret")) }
  else if c == 126 { push_token(scanner, start, start + 1, Punctuation(b"tilde")) }
  else if c == 35 && byte_at(src, start + 1) == 123 {
    push_token(nest_hole(scanner, 1), start, start + 2, Punctuation(b"hashbrace"))
  } else if c == 35 && byte_at(src, start + 1) == 91 {
    push_token(scanner, start, start + 2, Punctuation(b"hashbracket"))
  } else if c == 35 {
    push_error(
      seek(scanner, start + 1),
      start,
      start + 1,
      unexpected(),
      b"unexpected character `#`",
      b"`#` opens a map literal, `#{k: v}`, or a set literal, `#[a, b]`, and nothing else",
    )
  } else {
    push_error(
      seek(scanner, start + 1),
      start,
      start + 1,
      unexpected(),
      bytes_concat_all([b"unexpected character `", bytes_slice(src, start, start + 1), b"`"]),
      b"this character has no meaning in Ply source",
    )
  }

fn punct_pair(
  scanner: Scanner,
  src: Bytes,
  start: Int,
  second: Int,
  both: Bytes,
  single: Bytes,
) -> Scanner / {abort.raise} =
  if byte_at(src, start + 1) == second { push_token(scanner, start, start + 2, Punctuation(both)) }
  else { push_token(scanner, start, start + 1, Punctuation(single)) }

// --- The dump ---------------------------------------------------------------

// `start:end:kind[:payload];` per token, then `start:end:!:code;` per diagnostic.
pub fn dump(src: Bytes) -> String / {abort.raise} = {
  let lx = lex(src);
  string_of_bytes(
    bytes_concat(
      bytes_concat_all(map(lx.tokens, render_token)),
      bytes_concat_all(map(lx.diags, render_diag)),
    ),
  )
}

fn int_to_bytes(i: Int) -> Bytes = bytes_of_string(int_to_string(i))

fn render_token(token: Token) -> Bytes / {abort.raise} =
  bytes_concat_all([
    int_to_bytes(token.start),
    b":",
    int_to_bytes(token.end),
    b":",
    token_body(token.kind),
    b";",
  ])

fn render_diag(diag: Diag) -> Bytes =
  bytes_concat_all([
    int_to_bytes(diag.start),
    b":",
    int_to_bytes(diag.end),
    b":!:",
    diag.code,
    b";",
  ])

fn token_body(kind: TokenKind) -> Bytes / {abort.raise} =
  match kind {
    Identifier(b) -> bytes_concat(b"i:", b),
    IntLiteral(v) -> bytes_concat(b"n:", int_to_bytes(v)),
    FixedLiteral(ty, v) -> bytes_concat_all([b"w:", ty, b":", int_to_bytes(v)]),
    WideLiteral(ty, high, low) ->
      bytes_concat_all([b"W:", ty, b":", int_to_bytes(high), b":", int_to_bytes(low)]),
    FloatLiteral(txt) -> bytes_concat(b"f:", txt),
    DecimalLiteral(m, sc) -> bytes_concat_all([b"d:", m, b":", int_to_bytes(sc)]),
    StringLiteral(b) -> bytes_concat(b"s:", hex(b)),
    LineString(b) -> bytes_concat(b"l:", hex(b)),
    BytesLiteral(b) -> bytes_concat(b"b:", hex(b)),
    InterpolatedHead(b) -> bytes_concat(b"F:", hex(b)),
    InterpolatedMiddle(b) -> bytes_concat(b"M:", hex(b)),
    InterpolatedTail(b) -> bytes_concat(b"T:", hex(b)),
    CharLiteral(v) -> bytes_concat(b"c:", int_to_bytes(v)),
    Keyword(b) -> bytes_concat(b"k:", b),
    Punctuation(b) -> bytes_concat(b"p:", b),
    EndOfInput -> b"e",
  }

fn hex_digits() -> Bytes = b"0123456789abcdef"

fn hex_digit_text(v: Int) -> Bytes / {abort.raise} = bytes_slice(hex_digits(), v, v + 1)

fn hex_byte_text(v: Int) -> Bytes / {abort.raise} =
  bytes_concat(hex_digit_text(v / 16), hex_digit_text(v % 16))

fn hex(b: Bytes) -> Bytes / {abort.raise} =
  bytes_concat_all(map(range(0, bytes_len(b)), |i: Int| hex_byte_text(bytes_at(b, i))))

// --- Tests ------------------------------------------------------------------

test "a keyword and an identifier that starts with one are different tokens" {
  assert_eq(dump(b"fn fnord"), "0:2:k:fn;3:8:i:fnord;8:8:e;")
}

test "an underscore alone is a wildcard but prefixes an identifier" {
  assert_eq(dump(b"_ _x"), "0:1:p:underscore;2:4:i:_x;4:4:e;")
}

test "an integer literal may be written with underscore separators" {
  assert_eq(dump(b"1_000_000"), "0:9:n:1000000;9:9:e;")
}

test "an integer that does not fit in Int is a diagnostic and a zero" {
  assert_eq(dump(b"99999999999999999999"), "0:20:n:0;20:20:e;0:20:!:E0001;")
}

test "a fraction or an exponent is what makes a literal a Float" {
  assert_eq(
    dump(b"1 1.5 1e9 1_000.5 1.5e-3"),
    "0:1:n:1;2:5:f:1.5;6:9:f:1e9;10:17:f:1000.5;18:24:f:1.5e-3;24:24:e;",
  )
}

test "a Decimal keeps the trailing zero its scale stands for" {
  assert_eq(dump(b"1.50m"), "0:5:d:150:2;5:5:e;")
}

test "a Decimal literal has no exponent" {
  assert_eq(dump(b"1e3m"), "0:4:d:0:0;4:4:e;0:4:!:E0001;")
}

test "the escapes a string literal decodes" {
  assert_eq(dump(b"\"a\\nb\\t\\\\\\\"\\r\\0\""), "0:16:s:610a62095c220d00;16:16:e;")
}

test "an unterminated string reports from its opening quote" {
  assert_eq(
    dump(b"let s = \"oops\nlet t = 1"),
    "0:3:k:let;4:5:i:s;6:7:p:eq;8:13:s:6f6f7073;14:17:k:let;18:19:i:t;20:21:p:eq;22:23:n:1;23:23:e;8:13:!:E0002;",
  )
}

test "a line string runs from its backslashes to the end of the line, verbatim" {
  // `a"\n` and two backslashes, as written: nothing in a line string is an escape.
  assert_eq(dump(b"\\\\a\"\\n\\\\\nx"), "0:8:l:61225c6e5c5c;9:10:i:x;10:10:e;")
}

test "the lines of a line string join with a newline, and the last one ends the value" {
  assert_eq(dump(b"\\\\one\n  \\\\two\n\t\\\\\n1"), "0:17:l:6f6e650a74776f0a;18:19:n:1;19:19:e;")
}

test "a line string ends at the first line that does not continue it" {
  assert_eq(dump(b"\\\\one\n\n\\\\two"), "0:5:l:6f6e65;7:12:l:74776f;12:12:e;");
  assert_eq(dump(b"\\\\one\n// two\n\\\\three"), "0:5:l:6f6e65;13:20:l:7468726565;20:20:e;")
}

test "a carriage return before a newline ends a line rather than being content" {
  assert_eq(dump(b"\\\\a\r\n\\\\b\r\n"), "0:8:l:610a62;10:10:e;")
}

test "a line of a line string that ends in whitespace is refused where the whitespace starts" {
  assert_eq(dump(b"\\\\a  \n\\\\b"), "0:9:l:6120200a62;9:9:e;3:5:!:E0001;")
}

test "one backslash is no token" { assert_eq(dump(b"\\a"), "1:2:i:a;2:2:e;0:1:!:E0001;") }

test "a byte literal takes the string escapes plus hex" {
  assert_eq(dump(b"b\"GET \\r\\n\\x00\\xff\\\"\\\\\""), "0:23:b:474554200d0a00ff225c;23:23:e;")
}

test "a short hex escape is reported without swallowing the literal" {
  assert_eq(dump(b"b\"\\xg1\" 7"), "0:7:b:006731;8:9:n:7;9:9:e;2:4:!:E0001;")
}

test "operators use maximal munch" {
  assert_eq(
    dump(b"-> - ++ + == = != ! <= < >= > && || | .. ."),
    "0:2:p:arrow;3:4:p:minus;5:7:p:plusplus;8:9:p:plus;10:12:p:eqeq;13:14:p:eq;"
      ++ "15:17:p:bangeq;18:19:p:bang;20:22:p:le;23:24:p:lt;25:27:p:ge;28:29:p:gt;"
      ++ "30:32:p:ampamp;33:35:p:pipepipe;36:37:p:pipe;38:40:p:dotdot;41:42:p:dot;42:42:e;",
  )
}

test "the try operator is one token of its own" {
  assert_eq(dump(b"f(x)?"), "0:1:i:f;1:2:p:lparen;2:3:i:x;3:4:p:rparen;4:5:p:question;5:5:e;")
}

test "the bit operators are tokens, and a byte nothing claims is reported and skipped" {
  assert_eq(dump(b"a & b"), "0:1:i:a;2:3:p:amp;4:5:i:b;5:5:e;");
  assert_eq(dump(b"a ^ ~b"), "0:1:i:a;2:3:p:caret;4:5:p:tilde;5:6:i:b;6:6:e;");
  assert_eq(dump(b"a $ b"), "0:1:i:a;4:5:i:b;5:5:e;2:3:!:E0001;")
}

test "a hex literal is an Int bounded as a 64-bit pattern" {
  assert_eq(dump(b"0x10 0xff"), "0:4:n:16;5:9:n:255;9:9:e;");
  assert_eq(dump(b"0xFFFF_FFFF_FFFF_FFFF"), "0:21:n:-1;21:21:e;")
}

test "a U64 literal spans all 64 bits, carried as its pattern" {
  assert_eq(dump(b"9223372036854775808u64"), "0:22:w:U64:-9223372036854775808;22:22:e;");
  assert_eq(dump(b"18446744073709551615u64"), "0:23:w:U64:-1;23:23:e;");
  assert_eq(dump(b"18446744073709551616u64"), "0:23:w:U64:0;23:23:e;0:23:!:E0211;")
}

test "a 128-bit literal is carried as its high and low 64-bit patterns" {
  assert_eq(dump(b"1u128"), "0:5:W:U128:0:1;5:5:e;");
  assert_eq(dump(b"18446744073709551616u128"), "0:24:W:U128:1:0;24:24:e;");
  assert_eq(dump(b"340282366920938463463374607431768211455u128"), "0:43:W:U128:-1:-1;43:43:e;");
  assert_eq(
    dump(b"170141183460469231731687303715884105727i128"),
    "0:43:W:I128:9223372036854775807:-1;43:43:e;",
  );
  assert_eq(dump(b"0x1_0000_0000_0000_0000u128"), "0:27:W:U128:1:0;27:27:e;");
  assert_eq(dump(b"0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFi128"), "0:38:W:I128:-1:-1;38:38:e;")
}

test "a 128-bit value spells in decimal from its two halves" {
  assert_eq(wide_decimal(false, 0, 0), b"0");
  assert_eq(wide_decimal(false, 1, 0), b"18446744073709551616");
  assert_eq(wide_decimal(false, -1, -1), b"340282366920938463463374607431768211455");
  assert_eq(wide_decimal(true, -1, -1), b"-1");
  assert_eq(
    wide_decimal(true, 0 - 9223372036854775807 - 1, 0),
    b"-170141183460469231731687303715884105728",
  );
  assert_eq(wide_decimal(true, 9223372036854775807, -1), b"170141183460469231731687303715884105727")
}

test "a 128-bit literal past its width is a diagnostic and a zero" {
  assert_eq(
    dump(b"340282366920938463463374607431768211456u128"),
    "0:43:W:U128:0:0;43:43:e;0:43:!:E0211;",
  );
  assert_eq(
    dump(b"170141183460469231731687303715884105728i128"),
    "0:43:W:I128:0:0;43:43:e;0:43:!:E0211;",
  );
  assert_eq(
    dump(b"0x1FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFu128"),
    "0:39:W:U128:0:0;39:39:e;0:39:!:E0211;",
  )
}

test "a comment runs to the end of its line" {
  assert_eq(dump(b"1 // two\n3"), "0:1:n:1;9:10:n:3;10:10:e;")
}

test "the end-of-file token sits at the end of the input" {
  assert_eq(dump(b"abc"), "0:3:i:abc;3:3:e;")
}

test "a comment is recorded from its slashes to the end of its line, and none is a token" {
  let lx = lex(b"1 // two\n3 // x");
  assert_eq(len(lx.tokens), 3);
  assert_eq(lx.comments, [{ start: 2, end: 8 }, { start: 11, end: 15 }]);
  assert_eq(lex(b"\"//\"").comments, [])
}

test "a character literal is its one character's scalar value" {
  assert_eq(dump(b"'a'"), "0:3:c:97;3:3:e;");
  assert_eq(dump(b"'\xc3\xa9'"), "0:4:c:233;4:4:e;");
  assert_eq(
    dump(b"'\\n' '\\'' '\\\"' '\\u{1F600}'"),
    "0:4:c:10;5:9:c:39;10:14:c:34;15:26:c:128512;26:26:e;",
  )
}

test "a character literal holds exactly one character" {
  assert_eq(dump(b"''"), "0:2:c:0;2:2:e;0:2:!:E0001;");
  assert_eq(dump(b"'ab'"), "0:4:c:97;4:4:e;0:4:!:E0001;");
  assert_eq(dump(b"'a"), "0:2:c:97;2:2:e;0:2:!:E0002;")
}

test "an interpolated string is its text pieces around the tokens of each hole" {
  assert_eq(dump(b"f\"a {x} b\""), "0:5:F:6120;5:6:i:x;6:10:T:2062;10:10:e;");
  assert_eq(dump(b"f\"{a}-{b}\""), "0:3:F:;3:4:i:a;4:7:M:2d;7:8:i:b;8:10:T:;10:10:e;");
  assert_eq(dump(b"f\"\\n{x}\""), "0:5:F:0a;5:6:i:x;6:8:T:;8:8:e;")
}

test "an interpolated string with no hole is a string, its doubled braces single" {
  assert_eq(dump(b"f\"plain {{x}}\""), "0:14:s:706c61696e207b787d;14:14:e;")
}

test "a brace inside a hole nests, and only the one that balances the hole closes it" {
  assert_eq(dump(b"f\"{ {1} }\""), "0:3:F:;4:5:p:lbrace;5:6:n:1;6:7:p:rbrace;8:10:T:;10:10:e;");
  assert_eq(dump(b"f\"{f\"{x}\"}\""), "0:3:F:;3:6:F:;6:7:i:x;7:9:T:;9:11:T:;11:11:e;");
  assert_eq(dump(b"f\"{#{}}\""), "0:3:F:;3:5:p:hashbrace;5:6:p:rbrace;6:8:T:;8:8:e;")
}

test "a lone closing brace and a hole never closed are reported" {
  assert_eq(dump(b"f\"a}b\""), "0:6:s:6162;6:6:e;3:4:!:E0001;");
  assert_eq(dump(b"f\"{x"), "0:3:F:;3:4:i:x;4:4:e;4:4:!:E0002;")
}

test "a string's \\u escape writes its character as UTF-8" {
  assert_eq(dump(b"\"\\u{e9}\\u{1F600}\""), "0:17:s:c3a9f09f9880;17:17:e;");
  assert_eq(dump(b"\"\\'\""), "0:4:s:27;4:4:e;")
}

test "a \\u escape that names no character is refused" {
  assert_eq(dump(b"\"\\u{D800}\""), "0:10:s:;10:10:e;1:9:!:E0211;");
  assert_eq(dump(b"\"\\u{110000}\""), "0:12:s:;12:12:e;1:11:!:E0211;");
  assert_eq(dump(b"\"\\u{}\""), "0:6:s:;6:6:e;1:5:!:E0001;");
  assert_eq(dump(b"\"\\u41\""), "0:6:s:3431;6:6:e;1:3:!:E0001;")
}

test "a byte string refuses a \\u escape and keeps what follows it" {
  assert_eq(dump(b"b\"\\u{41}z\""), "0:10:b:7a;10:10:e;2:8:!:E0001;")
}

test "a map and a set literal open with their own two-character tokens" {
  assert_eq(dump(b"#{#[#"), "0:2:p:hashbrace;2:4:p:hashbracket;5:5:e;4:5:!:E0001;")
}

test "an identifier is ASCII: a letter outside it is refused, not lexed" {
  assert_eq(
    dump(bytes_of_string("let \u{e9} = 1\n")),
    "0:3:k:let;7:8:p:eq;9:10:n:1;11:11:e;4:6:!:X0001;",
  )
}

test "a space outside ASCII is refused" {
  assert_eq(dump(bytes_of_string("a\u{a0}b\n")), "0:1:i:a;3:4:i:b;5:5:e;1:3:!:X0001;")
}

test "a symbol outside ASCII is refused with no token" {
  assert_eq(dump(bytes_of_string("a \u{20ac} b\n")), "0:1:i:a;6:7:i:b;8:8:e;2:5:!:X0001;");
  assert_eq(dump(bytes_of_string("a \u{2014} b\n")), "0:1:i:a;6:7:i:b;8:8:e;2:5:!:X0001;")
}

test "a backslash before a character outside ASCII is a bad escape" {
  assert_eq(dump(bytes_of_string("\"a\\\u{e9}b\"\n")), "0:7:s:61c3a962;8:8:e;2:5:!:E0001;")
}

test "a character outside ASCII inside a byte literal is refused" {
  assert_eq(dump(bytes_of_string("b\"a\u{e9}b\"\n")), "0:7:b:6162;8:8:e;3:5:!:E0001;")
}

test "a character outside ASCII inside a string is its contents" {
  assert_eq(dump(bytes_of_string("\"caf\u{e9}\"\n")), "0:7:s:636166c3a9;8:8:e;")
}

test "a character outside ASCII inside a comment is trivia" {
  assert_eq(dump(bytes_of_string("// caf\u{e9}\n1\n")), "9:10:n:1;11:11:e;")
}
