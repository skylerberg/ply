// The `.plyx` container: the magic, the header, the section table, and what a program digest is
// taken over. A section's payload belongs to its writer; this module places the payloads and
// hands them back where it put them.

import parsing (int_to_bytes)
import std.bytes (u32_le, u64_le, u32_at, u64_at, slice_at, hex_of)
import std.hash (blake3)
import std.list (at)

fn append<a>(a: List<a>, b: List<a>) -> List<a> = fold(b, a, |acc: List<a>, x: a| push(acc, x))

// --- The layout -------------------------------------------------------------

fn magic() -> Bytes = b"PLYPROG1"

// A library's container is the same layout under a magic of its own, so feeding one to `ply run`
// is refused as "not a program" rather than read for an entry it does not have.
pub fn library_magic() -> Bytes = b"PLYLIB01"

// So a program digest is never confused with a definition hash or `ply hosts --digest`.
pub fn domain() -> Bytes = b"ply.program.2"

// And a library digest is not a program digest: the two files hold different things.
pub fn library_domain() -> Bytes = b"ply.library.1"

// The container format this `ply` writes and reads.
pub fn format() -> Int = 6

fn flag_closure() -> Int = 1
fn flag_unit() -> Int = 2
fn flag_runnable() -> Int = 4

fn header_len() -> Int = 184
fn descriptor_len() -> Int = 24

fn offset_format() -> Int = 8
fn offset_flags() -> Int = 12
fn offset_frontend() -> Int = 16
fn offset_runtime() -> Int = 48
fn offset_stdlib() -> Int = 80
fn offset_entry() -> Int = 112
pub fn offset_digest() -> Int = 144
// The digest covers every byte of the file from here on, plus the entry point.
fn offset_sections() -> Int = 176
fn offset_reserved() -> Int = 180

fn kind_of(name: Bytes) -> Int =
  if name == b"bodies" { 1 }
  else if name == b"names" { 2 }
  else if name == b"strings" { 3 }
  else if name == b"closure" { 4 }
  else if name == b"unit" { 5 }
  else if name == b"sources" { 6 }
  else if name == b"manifest" { 7 }
  else if name == b"runnable" { 8 }
  else { 0 }

fn name_of(kind: Int) -> Bytes =
  if kind == 1 { b"bodies" }
  else if kind == 2 { b"names" }
  else if kind == 3 { b"strings" }
  else if kind == 4 { b"closure" }
  else if kind == 5 { b"unit" }
  else if kind == 6 { b"sources" }
  else if kind == 7 { b"manifest" }
  else if kind == 8 { b"runnable" }
  else { b"" }

// --- What crosses the seam --------------------------------------------------

// What a writer supplies; the format, the flags and the digest are this module's to fill. `frontend`
// names the compiler that built the file and `runtime` the runtime its unit was compiled against.
pub type Header = { frontend: Bytes, runtime: Bytes, stdlib: Bytes, entry: Bytes }

// One section as it is written: its payload, and how many records the payload holds.
pub type Section = { name: Bytes, count: Int, payload: Bytes }

// One section as it is read back: where its payload lies in the file it was read from.
pub type Placed = { name: Bytes, kind: Int, count: Int, at: Int, len: Int }

pub type Opened = {
  format: Int,
  flags: Int,
  frontend: Bytes,
  runtime: Bytes,
  stdlib: Bytes,
  entry: Bytes,
  digest: Bytes,
  sections: List<Placed>,
}

// `stale` is a file this `ply` will never read whatever is done to it, rather than one that
// arrived damaged.
pub type Refusal = { stale: Bool, note: Bytes, message: Bytes }

// A range of the file the digest is taken over.
pub type Range = { at: Int, len: Int }

// --- Writing ----------------------------------------------------------------

fn zeros(n: Int) -> Bytes = bytes_concat_all(map(range(0, n), |_: Int| b"\x00"))

// A header field is a fixed width, so a hash of another length would shift every field after it.
fn fixed(b: Bytes, n: Int) -> Bytes / {abort.raise} =
  if bytes_len(b) == n { b }
  else if bytes_len(b) > n { bytes_slice(b, 0, n) }
  else { bytes_concat(b, zeros(n - bytes_len(b))) }

fn holds(sections: List<Section>, name: Bytes) -> Bool =
  len(filter(sections, |section: Section| section.name == name)) > 0

fn flags_of(sections: List<Section>) -> Int =
  (if holds(sections, b"closure") { flag_closure() } else { 0 })
    | (if holds(sections, b"unit") { flag_unit() } else { 0 })
    | (if holds(sections, b"runnable") { flag_runnable() } else { 0 })

fn section_kind(section: Section) -> Int / {abort.raise} = {
  let k = kind_of(section.name);
  if k == 0 { panic("a section this container has no kind for") } else { k }
}

// The fields in the order the offsets above read them back, with no byte between them.
fn header(container_magic: Bytes, head: Header, sections: List<Section>) -> Bytes / {abort.raise} =
  bytes_concat_all([
    container_magic,
    u32_le(format()),
    u32_le(flags_of(sections)),
    fixed(head.frontend, 32),
    fixed(head.runtime, 32),
    fixed(head.stdlib, 32),
    fixed(head.entry, 32),
    zeros(32),
    u32_le(len(sections)),
    u32_le(0),
  ])

fn descriptor(section: Section, start: Int) -> Bytes / {abort.raise} =
  bytes_concat_all([
    u32_le(section_kind(section)),
    u32_le(section.count),
    u64_le(start),
    u64_le(bytes_len(section.payload)),
  ])

fn starts(table: Int, sections: List<Section>) -> List<Int> = {
  let walked = fold(
    sections,
    { at: table, out: [] },
    |acc: { at: Int, out: List<Int> }, section: Section|
      { at: acc.at + bytes_len(section.payload), out: push(acc.out, acc.at) },
  );
  walked.out
}

// The whole container, with the digest field left zero: a digest is taken over the finished bytes
// (see `covers`) and written into a field those bytes do not cover.
pub fn encode(head: Header, sections: List<Section>) -> Bytes / {abort.raise} =
  encode_named(magic(), head, sections)

// The same layout under another magic: a library's container is what this is for, and the rest of
// the file — the section table, the offsets, the digest field — is the program's own.
pub fn encode_named(
  container_magic: Bytes,
  head: Header,
  sections: List<Section>,
) -> Bytes / {abort.raise} = {
  let table = header_len() + descriptor_len() * len(sections);
  let offsets = starts(table, sections);
  bytes_concat_all(
    append(
      append(
        [header(container_magic, head, sections)],
        map(range(0, len(sections)), |i: Int| descriptor(at(sections, i), at(offsets, i))),
      ),
      map(sections, |section: Section| section.payload),
    ),
  )
}

// --- Reading ----------------------------------------------------------------

fn broken(message: Bytes) -> Refusal = { stale: false, note: b"", message: message }

fn truncated(offset: Int, wanted: Int, n: Int) -> Refusal =
  broken(
    bytes_concat_all([
      b"the artifact is ",
      int_to_bytes(n),
      b" bytes and wants ",
      int_to_bytes(wanted),
      b" more at offset ",
      int_to_bytes(offset),
    ]),
  )

// Every field these two read sits inside a header, and a shorter file is refused before either.
fn word(b: Bytes, i: Int) -> Int / {abort.raise} = match u32_at(b, i) { Some(w) -> w, None -> 0 }

fn hash32(b: Bytes, i: Int) -> Bytes / {abort.raise} =
  match slice_at(b, i, 32) { Some(x) -> x, None -> b"" }

fn descriptor_at(
  b: Bytes,
  d: Int,
  k: Int,
  table: Int,
  n: Int,
) -> Result<Placed, Refusal> / {abort.raise} = {
  let count = word(b, d + 4);
  let beyond = broken(
    bytes_concat_all([b"section ", int_to_bytes(k), b" claims more bytes than a file could hold"]),
  );
  match u64_at(b, d + 8) {
    None -> Err(beyond),
    Some(start) -> match u64_at(b, d + 16) {
      None -> Err(beyond),
      Some(size) -> if start < table || start > n || size > n - start {
        Err(
          broken(
            bytes_concat_all([
              b"section ",
              int_to_bytes(k),
              b" claims ",
              int_to_bytes(size),
              b" bytes at ",
              int_to_bytes(start),
              b" of a ",
              int_to_bytes(n),
              b"-byte file",
            ]),
          ),
        )
      } else { Ok({ name: name_of(k), kind: k, count: count, at: start, len: size }) },
    },
  }
}

fn table_of(
  b: Bytes,
  count: Int,
  table: Int,
  n: Int,
) -> Result<List<Placed>, Refusal> / {abort.raise} =
  iterate({ i: 0, out: [] }, count + 1, |s: { i: Int, out: List<Placed> }|
    if s.i >= count { Stop(Ok(s.out)) } else {
      let d = header_len() + descriptor_len() * s.i;
      let k = word(b, d);
      if len(filter(s.out, |placed: Placed| placed.kind == k)) > 0 {
        Stop(Err(broken(bytes_concat_all([b"section ", int_to_bytes(k), b" appears twice"]))))
      } else {
        match descriptor_at(b, d, k, table, n) {
          Err(e) -> Stop(Err(e)),
          Ok(p) -> Continue({ i: s.i + 1, out: push(s.out, p) }),
        }
      }
    })

// The header and the section table of `b`, believed only as far as `b` reaches.
pub fn decode(b: Bytes) -> Result<Opened, Refusal> / {abort.raise} =
  decode_as(magic(), b"program artifact", b)

// A library's `.plyz`, read by the same rules under its own magic.
pub fn decode_library(b: Bytes) -> Result<Opened, Refusal> / {abort.raise} =
  decode_as(library_magic(), b"library", b)

fn decode_as(
  container_magic: Bytes,
  what: Bytes,
  b: Bytes,
) -> Result<Opened, Refusal> / {abort.raise} = {
  let n = bytes_len(b);
  if n < header_len() { Err(truncated(0, header_len(), n)) }
  else if slice_at(b, 0, 8) != Some(container_magic) {
    Err({
      stale: false,
      note: bytes_concat_all([
        b"`ply build` writes one; the first eight bytes are `",
        container_magic,
        b"`",
      ]),
      message: bytes_concat(b"this file is not a Ply ", what),
    })
  } else {
    let written = word(b, offset_format());
    if written != format() {
      Err({
        stale: true,
        note: b"",
        message: bytes_concat_all([
          b"the artifact is format ",
          int_to_bytes(written),
          b" and this `ply` writes and reads format ",
          int_to_bytes(format()),
        ]),
      })
    } else {
      let count = word(b, offset_sections());
      let table = header_len() + descriptor_len() * count;
      if table > n { Err(truncated(header_len(), table - header_len(), n)) } else {
        match table_of(b, count, table, n) {
          Err(e) -> Err(e),
          Ok(sections) ->
            Ok({
              format: written,
              flags: word(b, offset_flags()),
              frontend: hash32(b, offset_frontend()),
              runtime: hash32(b, offset_runtime()),
              stdlib: hash32(b, offset_stdlib()),
              entry: hash32(b, offset_entry()),
              digest: hash32(b, offset_digest()),
              sections: sections,
            }),
        }
      }
    }
  }
}

// --- The digest -------------------------------------------------------------

// The ranges of an `n`-byte artifact a program digest is taken over, after the domain: the entry
// point, then every byte from the section count on. The digest's own field lies between them, so
// it is written after the hash is taken and never covers itself.
pub fn covers(n: Int) -> Option<List<Range>> =
  if n < offset_sections() { None } else {
    Some([{ at: offset_entry(), len: 32 }, { at: offset_sections(), len: n - offset_sections() }])
  }

// What a container is sealed with under `into`, its domain: the one digest a writer splices in, a
// reader checks, and a registry names a library by. `None` for a file too short to be a container.
pub fn digest_of(into: Bytes, container: Bytes) -> Option<Bytes> / {abort.raise} =
  match covers(bytes_len(container)) {
    None -> None,
    Some(ranges) ->
      Some(
        blake3(
          bytes_concat_all(
            append(
              [into],
              map(ranges, |range: Range| bytes_slice(container, range.at, range.at + range.len)),
            ),
          ),
        ),
      ),
  }

// A digest as a lock, an index and a report spell it.
pub fn digest_text(d: Bytes) -> String / {abort.raise} = "b3:" ++ hex_of(d)

// The domain a program digest is taken under, where it is written, and the ranges of the file it
// covers, so a host hashes what this module says and nothing else.
pub type Plan = { domain: Bytes, at: Int, covers: List<Range> }

// `None` for an `n`-byte file too short to carry a digest.
pub fn plan(n: Int) -> Option<Plan> =
  match covers(n) {
    None -> None,
    Some(rs) -> Some({ domain: domain(), at: offset_digest(), covers: rs }),
  }

// --- Tests ------------------------------------------------------------------

fn fill(byte: Int) -> Bytes / {abort.raise} =
  bytes_concat_all(map(range(0, 32), |_i: Int| byte_of_int(byte)))

fn sample() -> Header / {abort.raise} =
  { frontend: fill(0x11), runtime: fill(0x22), stdlib: fill(0x33), entry: fill(0x44) }

fn says(message: Bytes, what: Bytes) -> Bool =
  match bytes_index_of(message, what) { Some(_) -> true, None -> false }

fn opened(b: Bytes) -> Opened / {abort.raise} =
  match decode(b) { Ok(x) -> x, Err(_) -> panic("a container this module wrote must read back") }

test "every header field is written where it is read back" {
  let bytes = encode(sample(), []);
  assert_eq(bytes_len(bytes), header_len());
  assert_eq(slice_at(bytes, 0, 8), Some(magic()));
  assert_eq(u32_at(bytes, offset_reserved()), Some(0));
  let x = opened(bytes);
  assert_eq(x.format, format());
  assert_eq(x.flags, 0);
  assert_eq(x.frontend, fill(0x11));
  assert_eq(x.runtime, fill(0x22));
  assert_eq(x.stdlib, fill(0x33));
  assert_eq(x.entry, fill(0x44));
  assert_eq(x.digest, zeros(32));
  assert_eq(len(x.sections), 0)
}

test "a section's payload comes back where it was put" {
  let sections = [
    { name: b"bodies", count: 2, payload: b"AABBBB" },
    { name: b"closure", count: 1, payload: b"CCC" },
    { name: b"unit", count: 1, payload: b"D" },
  ];
  let bytes = encode(sample(), sections);
  assert_eq(bytes_len(bytes), header_len() + 3 * descriptor_len() + 10);
  let x = opened(bytes);
  assert_eq(len(x.sections), 3);
  assert_eq(x.flags, flag_closure() | flag_unit());
  let first = at(x.sections, 0);
  assert_eq(first.name, b"bodies");
  assert_eq(first.count, 2);
  assert_eq(slice_at(bytes, first.at, first.len), Some(b"AABBBB"));
  let last = at(x.sections, 2);
  assert_eq(last.name, b"unit");
  assert_eq(slice_at(bytes, last.at, last.len), Some(b"D"))
}

test "the digest covers the entry point and the sections, and never its own field" {
  let bytes = encode(sample(), [{ name: b"bodies", count: 1, payload: b"AA" }]);
  match covers(bytes_len(bytes)) {
    None -> panic("an artifact this module wrote is long enough to carry a digest"),
    Some(rs) -> {
      assert_eq(len(rs), 2);
      assert_eq(at(rs, 0), { at: offset_entry(), len: 32 });
      assert_eq(at(rs, 1), { at: offset_sections(), len: bytes_len(bytes) - offset_sections() });
      assert(offset_digest() >= offset_entry() + 32);
      assert(offset_digest() + 32 <= offset_sections())
    },
  }
}

test "a digest is its domain and the covered ranges, whatever its own field holds" {
  let bytes = encode_named(library_magic(), sample(), [
    { name: b"sources", count: 0, payload: b"" },
  ]);
  let tail = bytes_slice(bytes, offset_sections(), bytes_len(bytes));
  let want = blake3(bytes_concat_all([library_domain(), fill(0x44), tail]));
  assert_eq(digest_of(library_domain(), bytes), Some(want));
  let spliced = bytes_concat_all([
    bytes_slice(bytes, 0, offset_digest()),
    want,
    bytes_slice(bytes, offset_digest() + 32, bytes_len(bytes)),
  ]);
  assert_eq(digest_of(library_domain(), spliced), Some(want));
  assert(digest_of(domain(), bytes) != Some(want));
  assert_eq(digest_of(library_domain(), b"short"), None);
  assert_eq(digest_text(b"\x01\xab"), "b3:01ab")
}

test "a library reads back under its own magic, and a program is not a library" {
  let lib = encode_named(library_magic(), sample(), [
    { name: b"manifest", count: 1, payload: b"m" },
  ]);
  let x = match decode_library(lib) {
    Ok(x) -> x,
    Err(_) -> panic("a library this module wrote must read back"),
  };
  assert_eq(len(x.sections), 1);
  match decode(lib) {
    Ok(_) -> panic("a library is not a program"),
    Err(e) -> assert(says(e.message, b"not a Ply program artifact")),
  };
  match decode_library(encode(sample(), [])) {
    Ok(_) -> panic("a program is not a library"),
    Err(e) -> {
      assert(says(e.message, b"not a Ply library"));
      assert(says(e.note, b"PLYLIB01"))
    },
  }
}

test "an artifact too short to hold a header has nothing to digest" {
  assert_eq(covers(0), None);
  assert_eq(covers(offset_sections() - 1), None);
  assert_eq(
    covers(offset_sections()),
    Some([{ at: offset_entry(), len: 32 }, { at: offset_sections(), len: 0 }]),
  )
}

test "a digest plan names its domain, the field it is written into and the ranges it covers" {
  assert_eq(plan(offset_sections() - 1), None);
  assert_eq(
    plan(offset_sections() + 10),
    Some({
      domain: b"ply.program.2",
      at: offset_digest(),
      covers: [{ at: offset_entry(), len: 32 }, { at: offset_sections(), len: 10 }],
    }),
  )
}

test "a file that does not open with the magic is refused, and says what one is" {
  let bytes = encode(sample(), []);
  let forged = bytes_concat(b"NOTPLY01", bytes_slice(bytes, 8, bytes_len(bytes)));
  match decode(forged) {
    Ok(_) -> panic("a file that is not an artifact must be refused"),
    Err(e) -> {
      assert_eq(e.stale, false);
      assert(says(e.message, b"not a Ply program artifact"));
      assert(says(e.note, b"PLYPROG1"))
    },
  }
}

test "a format this `ply` does not write is stale rather than damaged" {
  let bytes = encode(sample(), []);
  let forged = bytes_concat_all([
    bytes_slice(bytes, 0, offset_format()),
    u32_le(3),
    bytes_slice(bytes, offset_format() + 4, bytes_len(bytes)),
  ]);
  match decode(forged) {
    Ok(_) -> panic("format 3 is not the format this `ply` reads"),
    Err(e) -> {
      assert(e.stale);
      assert(says(e.message, b"format 3"))
    },
  }
}

test "a section count nothing could hold is refused before a descriptor is read" {
  let bytes = encode(sample(), []);
  let forged = bytes_concat_all([
    bytes_slice(bytes, 0, offset_sections()),
    u32_le(4294967295),
    bytes_slice(bytes, offset_sections() + 4, bytes_len(bytes)),
  ]);
  match decode(forged) {
    Ok(_) -> panic("a count past the end of the file must be refused"),
    Err(e) -> {
      assert_eq(e.stale, false);
      assert(says(e.message, b"wants"))
    },
  }
}

test "one kind names one section" {
  match decode(
      encode(sample(), [
        { name: b"bodies", count: 1, payload: b"A" },
        { name: b"bodies", count: 1, payload: b"B" },
      ]),
    ) {
    Ok(_) -> panic("two sections of one kind must be refused"),
    Err(e) -> assert(says(e.message, b"appears twice")),
  }
}

test "no prefix of an artifact is believed" {
  let bytes = encode(sample(), [
    { name: b"bodies", count: 1, payload: b"AAAA" },
    { name: b"names", count: 1, payload: b"BB" },
  ]);
  let believed = filter(range(0, bytes_len(bytes)), |cut: Int|
    match decode(bytes_slice(bytes, 0, cut)) { Ok(_) -> true, Err(_) -> false });
  assert_eq(len(believed), 0)
}
