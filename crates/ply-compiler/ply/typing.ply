//! The type of each node of a lowered body, rebuilt from the sites the checker files, so a value's
//! layout is read off its node's type and never off how the value happened to be made.

import parsing (Span, span_key, dummy_span, span_between)
import code (Code, Borrowed, NLit, NVar, NUnary, NBinary, NApp, NIf, NBlock, NList, NRecord, NMatch,
             NPerform, NLabel, NCell, NLambda, NSimulate, NParallel, NHandle, NField, NUpdate,
             NKnown, CodeStmt, CLet, CLetPat, CDo, CodePattern, PxWild, PxVar, PxLit, PxRange,
             PxCtor, PxRecord, PxList, CodePatternField, CodeArm, Capture, Lambda, CodeField,
             CodeClause)
import patterns (Lit, LInt, LFixed, LWide, LBool, LStr, LBytes, LFloat, LDec, LChar, LUnit, LBad)
import types (Type, TyVar, TyFn, TyRecord, TyCon, int_type, bool_type, string_type, bytes_type,
              float_type, decimal_type, unit_type, list_type, named_type, fn_type, row_empty,
              field_get, record_fields)

/// What is known at a span. `ty` is the type the checker filed there, `unknown` where it filed
/// none, and `args` the type arguments it filled where the site names a generic definition. `node`
/// is the type of the node written there: none until `node_types` meets one, and `unknown` where
/// nodes of different types share the span.
pub type Typed = { ty: Type, args: List<Type>, node: Option<Type> }

/// No type: what a site holds where nothing is known of it.
pub fn unknown_type() -> Type = TyVar(0 - 1)

/// What the checker filed at a site, before any node there is typed.
pub fn filed_as(ty: Type, args: List<Type>) -> Typed = { ty: ty, args: args, node: None }

type Typing = { sites: Map<Bytes, Typed>, ty: Option<Type> }

/// `sites` with the type of every node of `body` that has a place in the source filed as its
/// site's `node`: a variable's from its binder, a call's from what it calls, a field's from its
/// record. `params` are the types the body's leading slots hold, none where one is unknown. What
/// the checker filed is left as it was.
pub fn node_types(
  sites: Map<Bytes, Typed>,
  params: List<Option<Type>>,
  body: Code,
) -> Map<Bytes, Typed> = {
  let env = range(0, params.len()).fold(Map::new(), |acc: Map<Int, Type>, i: Int|
    match params.at(i) { Some(Some(t)) -> acc.insert(i, t), _ -> acc });
  typing(sites, env, body).sites
}

fn typing(sites: Map<Bytes, Typed>, env: Map<Int, Type>, code: Code) -> Typing = {
  let made = match code.node {
    NLit(l) -> { sites: sites, ty: lit_type(l) },
    // A name no slot holds is a definition or a constructor, filed where it is written.
    NVar(v) ->
      { sites: sites, ty: match v.slot { Some(s) -> env.get(s), None -> filed(sites, code.span) } },
    NUnary(u) -> {
      let o = typing(sites, env, u.operand);
      { sites: o.sites, ty: if u.op == b"not" { Some(bool_type()) } else { o.ty } }
    },
    NBinary(b) -> {
      let l = typing(sites, env, b.lhs);
      let r = typing(l.sites, env, b.rhs);
      {
        sites: r.sites,
        ty: if answers_bool(b.op) { Some(bool_type()) }
        else { match l.ty { Some(t) -> Some(t), None -> r.ty } },
      }
    },
    // A call the checker types by no reference, a cell's read, is filed where the call is.
    NApp(a) -> {
      let f = typing(sites, env, a.func);
      {
        sites: a.args.fold(f.sites, |acc: Map<Bytes, Typed>, x: Code| typing(acc, env, x).sites),
        ty: match f.ty { Some(TyFn(t)) -> Some(t.ret), _ -> filed(sites, code.span) },
      }
    },
    NIf(i) -> {
      let c = typing(sites, env, i.cond);
      let t = typing(c.sites, env, i.then_branch);
      let e = typing(t.sites, env, i.else_branch);
      { sites: e.sites, ty: match t.ty { Some(x) -> Some(x), None -> e.ty } }
    },
    NBlock(b) -> {
      let after = b.stmts.fold(
        { sites: sites, env: env },
        |acc: { sites: Map<Bytes, Typed>, env: Map<Int, Type> }, s: CodeStmt|
          match s {
            CLet(l) -> {
              let v = typing(acc.sites, acc.env, l.value);
              { sites: v.sites, env: slot_typed(acc.env, Some(l.slot), v.ty) }
            },
            CLetPat(l) -> {
              let v = typing(acc.sites, acc.env, l.value);
              { sites: v.sites, env: bound(v.sites, acc.env, l.pat, v.ty) }
            },
            CDo(d) -> { sites: typing(acc.sites, acc.env, d.code).sites, env: acc.env },
          },
      );
      match b.tail {
        Some(t) -> typing(after.sites, after.env, t),
        None -> { sites: after.sites, ty: Some(unit_type()) },
      }
    },
    NList(l) -> {
      let items = l.items.fold({ sites: sites, ty: None }, |acc: Typing, x: Code| {
        let o = typing(acc.sites, env, x);
        { sites: o.sites, ty: match acc.ty { Some(t) -> Some(t), None -> o.ty } }
      });
      {
        sites: items.sites,
        // The checker files an empty list's type, which no item gives.
        ty: match items.ty { Some(t) -> Some(list_type(t)), None -> filed(sites, code.span) },
      }
    },
    NRecord(r) ->
      {
        sites: r.fields.fold(sites, |acc: Map<Bytes, Typed>, f: CodeField|
          typing(acc, env, f.value).sites),
        ty: filed(sites, code.span),
      },
    NUpdate(u) ->
      {
        sites: u.sets.fold(
          typing(sites, env, u.base).sites,
          |acc: Map<Bytes, Typed>, f: CodeField| typing(acc, env, f.value).sites,
        ),
        ty: filed(sites, code.span),
      },
    NMatch(m) -> {
      let s = typing(sites, env, m.scrutinee);
      m.arms.fold({ sites: s.sites, ty: None }, |acc: Typing, a: CodeArm| {
        let inner = bound(acc.sites, env, a.pat, s.ty);
        let g = match a.guard { Some(c) -> typing(acc.sites, inner, c).sites, None -> acc.sites };
        let o = typing(g, inner, a.body);
        { sites: o.sites, ty: match acc.ty { Some(t) -> Some(t), None -> o.ty } }
      })
    },
    NPerform(p) -> {
      let l = match p.label { Some(c) -> typing(sites, env, c).sites, None -> sites };
      {
        sites: p.args.fold(l, |acc: Map<Bytes, Typed>, x: Code| typing(acc, env, x).sites),
        ty: filed(sites, code.span),
      }
    },
    NLabel(_) -> { sites: sites, ty: None },
    NCell(c) -> {
      let i = typing(sites, env, c.init);
      typing(i.sites, slot_typed(env, c.slot, None), c.body)
    },
    NLambda(l) -> {
      let of = filed(sites, l.at);
      { sites: typing(sites, lambda_env(of, env, l), l.body).sites, ty: of }
    },
    NSimulate(s) -> typing(sites, captured(env, s.captures), s.body),
    NParallel(p) ->
      {
        sites: p.branches.fold(sites, |acc: Map<Bytes, Typed>, x: Code| typing(acc, env, x).sites),
        ty: None,
      },
    NHandle(h) -> {
      let b = typing(sites, env, h.body);
      let clauses = h.clauses.fold(b.sites, |acc: Map<Bytes, Typed>, c: CodeClause| {
        let l = match c.label { Some(x) -> typing(acc, env, x).sites, None -> acc };
        typing(l, clause_env(filed(sites, c.at), env, c), c.body).sites
      });
      match h.ret {
        None -> { sites: clauses, ty: b.ty },
        Some(r) -> typing(clauses, slot_typed(captured(env, r.captures), Some(0), b.ty), r.body),
      }
    },
    NField(f) -> {
      let b = typing(sites, env, f.base);
      {
        sites: b.sites,
        ty: match b.ty {
          Some(t) -> match record_fields(t) { Some(fs) -> field_get(fs, f.field), None -> None },
          None -> None,
        },
      }
    },
    NKnown(k) -> { sites: sites, ty: env.get(k.slot) },
  };
  noted(made, code.span)
}

/// `made` with its type filed as the node at `span`. Where a node of another type was met there
/// already, the two share the span and neither is read by it.
fn noted(made: Typing, span: Span) -> Typing =
  match made.ty {
    None -> made,
    Some(ty) -> if span == dummy_span() { made } else {
      let key = span_key(span);
      let at = match made.sites.get(key) { Some(t) -> t, None -> filed_as(unknown_type(), []) };
      match at.node {
        None -> { sites: made.sites.insert(key, { ..at, node: Some(ty) }), ty: made.ty },
        Some(met) -> if met == ty { made } else {
          { sites: made.sites.insert(key, { ..at, node: Some(unknown_type()) }), ty: made.ty }
        },
      }
    },
  }

/// The type the checker filed at `span`.
fn filed(sites: Map<Bytes, Typed>, span: Span) -> Option<Type> =
  if span == dummy_span() { None } else {
    match sites.get(span_key(span)) {
      Some(t) -> if t.ty == unknown_type() { None } else { Some(t.ty) },
      None -> None,
    }
  }

/// `env` with `slot` holding a value of `ty`; a slot whose type is unknown holds none, whatever an
/// earlier binder of the same slot held.
fn slot_typed(env: Map<Int, Type>, slot: Option<Int>, ty: Option<Type>) -> Map<Int, Type> =
  match slot {
    None -> env,
    Some(s) -> match ty { Some(t) -> env.insert(s, t), None -> env.remove(s) },
  }

/// `env` with each binder of `pat`, matched against a value of type `of`, holding the type the
/// checker filed at it, or where it filed none there, the type its place in `of` has.
fn bound(
  sites: Map<Bytes, Typed>,
  env: Map<Int, Type>,
  pat: CodePattern,
  of: Option<Type>,
) -> Map<Int, Type> =
  match pat {
    PxVar(v) ->
      slot_typed(env, v.slot, match filed(sites, v.span) { Some(t) -> Some(t), None -> of }),
    PxCtor(c) -> {
      let arg = argument_type(of, c.name);
      c.args.fold(env, |acc: Map<Int, Type>, p: CodePattern| bound(sites, acc, p, arg))
    },
    PxRecord(r) -> {
      let fields = match of { Some(t) -> record_fields(t), None -> None };
      r.fields.fold(env, |acc: Map<Int, Type>, f: CodePatternField|
        bound(sites, acc, f.pat, match fields { Some(fs) -> field_get(fs, f.name), None -> None }))
    },
    PxList(l) -> {
      let item = match of {
        Some(TyCon(c)) -> if c.name == b"List" { c.args.at(0) } else { None },
        _ -> None,
      };
      let items = l.items.fold(env, |acc: Map<Int, Type>, p: CodePattern|
        bound(sites, acc, p, item));
      match l.rest { Some(r) -> bound(sites, items, r, of), None -> items }
    },
    PxWild -> env,
    PxLit(_) -> env,
    PxRange(_) -> env,
  }

/// What the one argument of constructor `ctor` of an `Option` or a `Result` of type `of` is.
fn argument_type(of: Option<Type>, ctor: Bytes) -> Option<Type> =
  match of {
    Some(TyCon(c)) -> if c.name == b"Option" && c.args.len() == 1 && ctor == b"Some" {
      c.args.at(0)
    } else if c.name == b"Result" && c.args.len() == 2 && ctor == b"Ok" { c.args.at(0) }
    else if c.name == b"Result" && c.args.len() == 2 && ctor == b"Err" { c.args.at(1) }
    else { None },
    _ -> None,
  }

/// What a barrier's body reads: each capture at its slot inside, typed as its slot outside is.
fn captured(env: Map<Int, Type>, captures: List<Capture>) -> Map<Int, Type> =
  captures.fold(Map::new(), |acc: Map<Int, Type>, c: Capture|
    match env.get(c.src) { Some(t) -> acc.insert(c.dst, t), None -> acc })

/// A lambda's captures, and its parameters in its leading slots at the types its own type `of`
/// gives them.
fn lambda_env(of: Option<Type>, env: Map<Int, Type>, l: Lambda) -> Map<Int, Type> = {
  let inside = captured(env, l.captures);
  match of {
    Some(TyFn(f)) -> if f.params.len() != l.params { inside } else {
      range(0, l.params).fold(inside, |acc: Map<Int, Type>, i: Int|
        match f.params.at(i) { Some(t) -> acc.insert(i, t), None -> acc })
    },
    _ -> inside,
  }
}

/// A clause's captures, and its parameters in its leading slots at the types its operation's type
/// `of` gives them.
fn clause_env(of: Option<Type>, env: Map<Int, Type>, c: CodeClause) -> Map<Int, Type> = {
  let inside = captured(env, c.captures);
  match of {
    Some(TyFn(f)) -> if f.params.len() != c.params { inside } else {
      range(0, c.params).fold(inside, |acc: Map<Int, Type>, i: Int|
        match f.params.at(i) { Some(t) -> acc.insert(i, t), None -> acc })
    },
    _ -> inside,
  }
}

fn answers_bool(op: Bytes) -> Bool =
  op == b"eq" || op == b"ne" || op == b"lt" || op == b"le" || op == b"gt" || op == b"ge"
    || op == b"and"
    || op == b"or"

/// A width-suffixed literal is typed by the operand site its operator files.
fn lit_type(l: Lit) -> Option<Type> =
  match l {
    LInt(_) -> Some(int_type()),
    LBool(_) -> Some(bool_type()),
    LStr(_) -> Some(string_type()),
    LBytes(_) -> Some(bytes_type()),
    LFloat(_) -> Some(float_type()),
    LDec(_) -> Some(decimal_type()),
    LChar(_) -> Some(named_type(b"Char")),
    LUnit -> Some(unit_type()),
    LFixed(_, _) -> None,
    LWide(_, _, _) -> None,
    LBad -> None,
  }

test "a variable is typed by its binder, a call by what it calls and a field by its record" {
  let at = |n: Int| span_between(n, n + 1);
  let read = |slot: Int, n: Int|
    { own: Borrowed, node: NVar({ name: b"x", slot: Some(slot) }), span: at(n) };
  let point = TyRecord([{ name: b"x", ty: float_type() }, { name: b"y", ty: float_type() }]);
  let field = { own: Borrowed, node: NField({ base: read(0, 1), field: b"y" }), span: at(2) };
  let let_then_read = {
    own: Borrowed,
    node: NBlock({ stmts: [CLet({ name: b"v", slot: 1, value: field })], tail: Some(read(1, 3)) }),
    span: at(4),
  };
  let sites = node_types(Map::new(), [Some(point)], let_then_read);
  let of = |n: Int| match sites.get(span_key(at(n))) { Some(t) -> t.node, None -> None };
  assert_eq(of(1), Some(point));
  assert_eq(of(2), Some(float_type()));
  assert_eq(of(3), Some(float_type()));
  assert_eq(of(4), Some(float_type()))
}

test "a slot a later binder takes with no known type holds none" {
  let at = |n: Int| span_between(n, n + 1);
  let read = |n: Int| { own: Borrowed, node: NVar({ name: b"x", slot: Some(0) }), span: at(n) };
  let unknown = { own: Borrowed, node: NLabel(b"l"), span: at(1) };
  let body = {
    own: Borrowed,
    node: NBlock({ stmts: [CLet({ name: b"x", slot: 0, value: unknown })], tail: Some(read(2)) }),
    span: at(3),
  };
  let sites = node_types(Map::new(), [Some(int_type())], body);
  assert_eq(sites.get(span_key(at(2))), None)
}

test "a span two nodes of different types share is read as no type" {
  let at = |n: Int| span_between(n, n + 1);
  let lit = |l: Lit| { own: Borrowed, node: NLit(l), span: at(1) };
  let body = {
    own: Borrowed,
    node: NList({ items: [lit(LInt(1)), lit(LBool(true))] }),
    span: at(2),
  };
  let sites = node_types(Map::new(), [], body);
  assert_eq(
    sites.get(span_key(at(1))),
    Some({ ty: unknown_type(), args: [], node: Some(unknown_type()) }),
  )
}

test "a node that shares a span with what the checker filed leaves the filing as it was" {
  let at = |n: Int| span_between(n, n + 1);
  let reference = fn_type([int_type()], bool_type(), row_empty());
  let filing = Map::new().insert(span_key(at(1)), filed_as(reference, [int_type()]));
  let named = { own: Borrowed, node: NVar({ name: b"f", slot: None }), span: at(1) };
  let witness = { own: Borrowed, node: NLit(LInt(0)), span: at(1) };
  let call = { own: Borrowed, node: NApp({ func: named, args: [witness] }), span: at(2) };
  let sites = node_types(filing, [], call);
  assert_eq(
    sites.get(span_key(at(1))),
    Some({ ty: reference, args: [int_type()], node: Some(unknown_type()) }),
  );
  assert_eq(
    sites.get(span_key(at(2))),
    Some({ ty: unknown_type(), args: [], node: Some(bool_type()) }),
  )
}

test "a binder the checker filed no type at takes its place in the subject's type" {
  let at = |n: Int| span_between(n, n + 1);
  let point = TyRecord([{ name: b"x", ty: float_type() }, { name: b"y", ty: int_type() }]);
  let found = TyCon({ name: b"Result", args: [point, string_type()] });
  let read = |slot: Int, n: Int|
    { own: Borrowed, node: NVar({ name: b"v", slot: Some(slot) }), span: at(n) };
  let binder = |slot: Int| PxVar({ name: b"v", slot: Some(slot), span: dummy_span() });
  let arms = [
    {
      pat: PxCtor({
        name: b"Ok",
        args: [PxRecord({ fields: [{ name: b"y", pat: binder(1) }], rest: true })],
      }),
      guard: None,
      body: read(1, 2),
    },
    { pat: PxCtor({ name: b"Err", args: [binder(2)] }), guard: None, body: read(2, 3) },
  ];
  let body = { own: Borrowed, node: NMatch({ scrutinee: read(0, 1), arms: arms }), span: at(4) };
  let sites = node_types(Map::new(), [Some(found)], body);
  let of = |n: Int| match sites.get(span_key(at(n))) { Some(t) -> t.node, None -> None };
  assert_eq(of(2), Some(int_type()));
  assert_eq(of(3), Some(string_type()))
}
