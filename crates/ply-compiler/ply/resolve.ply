//! Name resolution over a whole program: module index, declarations, scopes, dependency order, effect
//! sets and defaults.
//! Ordered tables are lists in insertion order: the dump encodes that order and a `Map` sorts its keys.

import parsing (Span, Ident, QName, span_to, dummy_span, is_bare, starts_upper, span_key)
import type_syntax (TypeExpr, TVar, TCon, TFn, TRecord, RowExpr, AtomExpr, Mode, MRead, MWrite,
                    MBad, mode_text)
import items (Module, Item, IFn, IType, IEffect, ITest, ILaw, IDerive, IEffectSet, FnDef, Cases,
              TypeDefBody, TDSum, TDAlias, VariantDef, SpecClause, SCost, Binder, Vis, VPub, VPriv,
              ImportDecl, ImportKind, IModule, IAlias, INames, Derived, EffectSetDef, OpDef, LawDef,
              OfSchema, schema_named, schema_guard_name, parse, dump_module, is_pub, TDNominal,
              Opaque)
import exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock, ERecord,
              ERecordUpdate, ETry, EField, EList, EPerform, EHandle, EWithCell, ESimulate,
              EParallel, EBad, ETryBlock, Stmt, SLet, SLetElse, SExpr, Param, NamedArg, MatchArm,
              HandleClause, ReturnClause, RecField, expr_span, ETagged, Hole)
import patterns (Pattern, PWild, PVar, PLit, PRange, PCtor, PRecord, PList, POr, PBad)
import std.list (at, concat, contains, take, drop)
import std.bin
import types (last_dot)
import std.bytes (ascii_of_int)

// --- The tables ---------------------------------------------------------------

pub type Source = { name: Bytes, src: Bytes }

/// `derived` is what `derive.ply`'s expansion generated into `module`, for the checker.
pub type ParsedModule = { name: Bytes, module: Module, derived: List<Derived> }

pub type Namespace = | ValueSpace | TypeSpace | EffectSpace | SetSpace

pub type Declared = { name: Bytes, qualified: Bytes, public: Bool, span: Span }
/// The lists keep insertion order, which the dump encodes; the maps answer lookups. A name's first entry wins in both.
pub type Decls = {
  values: List<Declared>,
  types: List<Declared>,
  effects: List<Declared>,
  sets: List<Declared>,
  by_value: Map<Bytes, Declared>,
  by_type: Map<Bytes, Declared>,
  by_effect: Map<Bytes, Declared>,
  by_set: Map<Bytes, Declared>,
}
pub type Binding = { name: Bytes, qualified: Bytes, owner: Int, span: Span }
pub type Bindings = {
  values: List<Binding>,
  types: List<Binding>,
  effects: List<Binding>,
  sets: List<Binding>,
  by_value: Map<Bytes, Binding>,
  by_type: Map<Bytes, Binding>,
  by_effect: Map<Bytes, Binding>,
  by_set: Map<Bytes, Binding>,
}
pub type ModuleBinding = { binder: Bytes, target: Int, span: Span }
pub type Scope = {
  module: Bytes,
  modules: List<ModuleBinding>,
  selective: List<ModuleBinding>,
  bound: Bindings,
}
pub type Label = { module: Int, start: Int, end: Int, primary: Bool, text: Bytes }
/// One replacement a fix makes: `text` in place of the span; an empty span inserts, empty text deletes.
pub type Edit = { module: Int, start: Int, end: Int, text: Bytes }
/// A change that applies as it is and leaves a program the diagnostic no longer holds for.
pub type Fix = { title: Bytes, edits: List<Edit> }
/// `notes` is always `len(notes_text)`; `text` is the checker's dedup key for the two mismatch printers.
pub type Diag = {
  code: Bytes,
  notes: Int,
  labels: List<Label>,
  text: Bytes,
  message: Bytes,
  notes_text: List<Bytes>,
  severity: Bytes,
  fixes: List<Fix>,
}

derive bin for Label

derive bin for Edit

derive bin for Fix

derive bin for Diag

type Edge = { from: Int, target: Int, span: Span }
pub type ModuleEntry = { name: Bytes, at: Int }
pub type Resolved = {
  names: List<ModuleEntry>,
  scopes: List<Scope>,
  declarations: List<Decls>,
  declared: List<Bindings>,
  order: List<Int>,
  /// Each module's imports, one target module index per declaration, in source order: a
  /// dependency's sibling import and two selective imports sharing a binder both name exactly.
  imports: List<List<Int>>,
}

fn no_decls() -> Decls =
  {
    values: [],
    types: [],
    effects: [],
    sets: [],
    by_value: map_new(),
    by_type: map_new(),
    by_effect: map_new(),
    by_set: map_new(),
  }
fn no_bindings() -> Bindings =
  {
    values: [],
    types: [],
    effects: [],
    sets: [],
    by_value: map_new(),
    by_type: map_new(),
    by_effect: map_new(),
    by_set: map_new(),
  }

fn namespaces() -> List<Namespace> = [ValueSpace, TypeSpace, EffectSpace, SetSpace]

pub fn space(decls: Decls, namespace: Namespace) -> List<Declared> =
  match namespace {
    ValueSpace -> decls.values,
    TypeSpace -> decls.types,
    EffectSpace -> decls.effects,
    SetSpace -> decls.sets,
  }

fn first_declared(m: Map<Bytes, Declared>, declared: Declared) -> Map<Bytes, Declared> =
  if map_contains(m, declared.name) { m } else { map_insert(m, declared.name, declared) }

fn first_binding(m: Map<Bytes, Binding>, binding: Binding) -> Map<Bytes, Binding> =
  if map_contains(m, binding.name) { m } else { map_insert(m, binding.name, binding) }

fn push_declared(decls: Decls, namespace: Namespace, declared: Declared) -> Decls =
  match namespace {
    ValueSpace ->
      {
        ..decls,
        values: push(decls.values, declared),
        by_value: first_declared(decls.by_value, declared),
      },
    TypeSpace ->
      {
        ..decls,
        types: push(decls.types, declared),
        by_type: first_declared(decls.by_type, declared),
      },
    EffectSpace ->
      {
        ..decls,
        effects: push(decls.effects, declared),
        by_effect: first_declared(decls.by_effect, declared),
      },
    SetSpace ->
      { ..decls, sets: push(decls.sets, declared), by_set: first_declared(decls.by_set, declared) },
  }

pub fn lookup_declared(decls: Decls, namespace: Namespace, name: Bytes) -> Option<Declared> =
  map_get(
    match namespace {
      ValueSpace -> decls.by_value,
      TypeSpace -> decls.by_type,
      EffectSpace -> decls.by_effect,
      SetSpace -> decls.by_set,
    },
    name,
  )

fn with_space_bindings(b: Bindings, namespace: Namespace, xs: List<Binding>) -> Bindings = {
  let by = fold(xs, map_new(), |m: Map<Bytes, Binding>, binding: Binding|
    first_binding(m, binding));
  match namespace {
    ValueSpace -> { ..b, values: xs, by_value: by },
    TypeSpace -> { ..b, types: xs, by_type: by },
    EffectSpace -> { ..b, effects: xs, by_effect: by },
    SetSpace -> { ..b, sets: xs, by_set: by },
  }
}

fn push_binding(bindings: Bindings, namespace: Namespace, binding: Binding) -> Bindings =
  match namespace {
    ValueSpace ->
      {
        ..bindings,
        values: push(bindings.values, binding),
        by_value: first_binding(bindings.by_value, binding),
      },
    TypeSpace ->
      {
        ..bindings,
        types: push(bindings.types, binding),
        by_type: first_binding(bindings.by_type, binding),
      },
    EffectSpace ->
      {
        ..bindings,
        effects: push(bindings.effects, binding),
        by_effect: first_binding(bindings.by_effect, binding),
      },
    SetSpace ->
      {
        ..bindings,
        sets: push(bindings.sets, binding),
        by_set: first_binding(bindings.by_set, binding),
      },
  }

pub fn lookup(bindings: Bindings, namespace: Namespace, name: Bytes) -> Option<Binding> =
  map_get(
    match namespace {
      ValueSpace -> bindings.by_value,
      TypeSpace -> bindings.by_type,
      EffectSpace -> bindings.by_effect,
      SetSpace -> bindings.by_set,
    },
    name,
  )

pub fn find_module_binding(bindings: List<ModuleBinding>, binder: Bytes) -> Option<ModuleBinding> =
  fold(bindings, None, |acc: Option<ModuleBinding>, binding: ModuleBinding|
    match acc {
      Some(_) -> acc,
      None -> if binding.binder == binder { Some(binding) } else { None },
    })

fn position(xs: List<Int>, v: Int) -> Option<Int> / {abort.raise} =
  fold(range(0, len(xs)), None, |acc: Option<Int>, i: Int|
    match acc { Some(_) -> acc, None -> if at(xs, i) == v { Some(i) } else { None } })

// --- Module names ---------------------------------------------------------------

/// The last dotted segment.
pub fn default_binder(name: Bytes) -> Bytes / {abort.raise} =
  bytes_slice(name, last_dot(name) + 1, bytes_len(name))

/// An anonymous module qualifies nothing.
pub fn qualify(module: Bytes, name: Bytes) -> Bytes =
  if bytes_len(module) == 0 { name } else { bytes_concat_all([module, b".", name]) }

pub fn import_module_name(decl: ImportDecl) -> Bytes / {abort.raise} =
  fold(range(0, len(decl.path)), b"", |acc: Bytes, i: Int|
    if i == 0 { at(decl.path, i).name }
    else { bytes_concat_all([acc, b".", at(decl.path, i).name]) })

pub fn path_span(decl: ImportDecl) -> Span / {abort.raise} =
  if len(decl.path) == 0 { decl.span }
  else { span_to(at(decl.path, 0).span, at(decl.path, len(decl.path) - 1).span) }

fn import_binder(decl: ImportDecl) -> Option<Bytes> / {abort.raise} =
  match decl.kind {
    IModule -> if len(decl.path) == 0 { None }
    else { Some(at(decl.path, len(decl.path) - 1).name) },
    IAlias(a) -> Some(a.name),
    INames(_) -> None,
  }

fn binder_span(decl: ImportDecl) -> Span / {abort.raise} =
  match decl.kind {
    IModule -> if len(decl.path) == 0 { decl.span } else { at(decl.path, len(decl.path) - 1).span },
    IAlias(a) -> a.span,
    INames(_) -> decl.span,
  }

// --- Diagnostics ---------------------------------------------------------------

pub fn label_at(m: Int, span: Span, primary: Bool, text: Bytes) -> Label =
  { module: m, start: span.start, end: span.end, primary: primary, text: text }

pub fn error_with_labels(
  code: Bytes,
  message: Bytes,
  labels: List<Label>,
  notes: List<Bytes>,
) -> Diag =
  {
    code: code,
    notes: len(notes),
    labels: labels,
    text: b"",
    message: message,
    notes_text: notes,
    severity: b"error",
    fixes: [],
  }

pub fn with_fix(diag: Diag, title: Bytes, edits: List<Edit>) -> Diag =
  { ..diag, fixes: push(diag.fixes, { title: title, edits: edits }) }

pub fn insertion(m: Int, at: Int, text: Bytes) -> Edit =
  { module: m, start: at, end: at, text: text }

pub fn error_at(
  code: Bytes,
  m: Int,
  span: Span,
  message: Bytes,
  label: Bytes,
  notes: List<Bytes>,
) -> Diag = error_with_labels(code, message, [label_at(m, span, true, label)], notes)

pub fn error_at_and(
  code: Bytes,
  m: Int,
  span: Span,
  message: Bytes,
  label: Bytes,
  m2: Int,
  also: Span,
  also_text: Bytes,
  notes: List<Bytes>,
) -> Diag =
  error_with_labels(
    code,
    message,
    [label_at(m, span, true, label), label_at(m2, also, false, also_text)],
    notes,
  )

pub fn backticked(xs: List<Bytes>, sep: Bytes) -> Bytes / {abort.raise} =
  fold(range(0, len(xs)), b"", |acc: Bytes, i: Int| {
    let x = bytes_concat_all([b"`", at(xs, i), b"`"]);
    if i == 0 { x } else { bytes_concat_all([acc, sep, x]) }
  })

/// "nothing", "`a`", "`a` and `b`", "`a`, `b` and `c`".
pub fn list_names(xs: List<Bytes>) -> Bytes / {abort.raise} =
  if len(xs) == 0 { b"nothing" } else {
    fold(range(0, len(xs)), b"", |acc: Bytes, i: Int| {
      let x = bytes_concat_all([b"`", at(xs, i), b"`"]);
      if i == 0 { x }
      else { bytes_concat_all([acc, if i + 1 == len(xs) { b" and " } else { b", " }, x]) }
    })
  }

pub fn describe_namespace(namespace: Namespace) -> Bytes =
  match namespace {
    ValueSpace -> b"definition",
    TypeSpace -> b"type",
    EffectSpace -> b"effect",
    SetSpace -> b"effect set",
  }

pub fn namespace_keyword(namespace: Namespace) -> Bytes =
  match namespace {
    ValueSpace -> b"fn",
    TypeSpace -> b"type",
    EffectSpace -> b"effect",
    SetSpace -> b"effect set",
  }

pub fn exported_names(decls: Decls) -> List<Bytes> =
  fold(namespaces(), [], |acc: List<Bytes>, namespace: Namespace|
    fold(space(decls, namespace), acc, |a: List<Bytes>, declared: Declared|
      if declared.public { push(a, declared.name) } else { a }))

// --- Declarations ---------------------------------------------------------------

/// Every name an item declares; the first declaration wins.
fn declarations_of(parsed: ParsedModule) -> Decls =
  fold(parsed.module.items, no_decls(), |decls: Decls, item: Item|
    match item {
      IFn(f) -> declare(decls, ValueSpace, parsed.name, f.name, f.vis),
      IEffect(e) -> declare(decls, EffectSpace, parsed.name, e.name, e.vis),
      IEffectSet(e) -> declare(decls, SetSpace, parsed.name, e.name, e.vis),
      IType(t) -> {
        let d2 = declare(decls, TypeSpace, parsed.name, t.name, t.vis);
        match t.body {
          // A constructor is as public as its type, unless the type is `opaque`: its module keeps them.
          TDSum(vs) ->
            fold(vs, d2, |acc: Decls, variant: VariantDef|
              declare(acc, ValueSpace, parsed.name, variant.name, match t.opaque {
                Some(_) -> VPriv,
                None -> t.vis,
              })),
          TDAlias(_) -> d2,
          TDNominal(_) -> d2,
        }
      },
      // None declares a name a reference could reach.
      _ -> decls,
    })

fn declare(decls: Decls, namespace: Namespace, module: Bytes, name: Ident, vis: Vis) -> Decls =
  match lookup_declared(decls, namespace, name.name) {
    Some(_) -> decls,
    None ->
      push_declared(decls, namespace, {
        name: name.name,
        qualified: qualify(module, name.name),
        public: is_pub(vis),
        span: name.span,
      }),
  }

fn bindings_of(owner: Int, decls: Decls) -> Bindings =
  fold(namespaces(), no_bindings(), |bindings: Bindings, namespace: Namespace|
    with_space_bindings(
      bindings,
      namespace,
      map(space(decls, namespace), |declared: Declared|
        { name: declared.name, qualified: declared.qualified, owner: owner, span: declared.span }),
    ))

// --- Scopes ---------------------------------------------------------------------

type Builder = { scope: Scope, local: Decls, imported: Decls, edges: List<Edge>, diags: List<Diag> }

type World = {
  mods: List<ParsedModule>,
  names: List<ModuleEntry>,
  declarations: List<Decls>,
  declared: List<Bindings>,
  /// The packages of the closure: 0 is the root package, and `module_packages` maps a module to one.
  /// `std` and `compiler` are the built-in packages every package may import; a `module_packages` of
  /// `shipped` is a module the toolchain ships outside any package, likewise importable by all.
  pkgs: List<PackageDeps>,
  module_packages: List<Int>,
  std: Int,
  compiler: Int,
  shipped: Int,
}

/// A package for import resolution: the module prefix it grants and the prefixes it declares.
pub type PackageDeps = { prefix: Bytes, deps: List<Bytes> }

/// Every module one unnamed package, as projects without packages resolve.
pub fn no_packages(
  mods: List<ParsedModule>,
) -> { pkgs: List<PackageDeps>, module_packages: List<Int>, std: Int, compiler: Int, shipped: Int } =
  {
    pkgs: [{ prefix: b"", deps: [] }],
    module_packages: map(mods, |parsed: ParsedModule| 0),
    std: 1,
    compiler: 2,
    shipped: 3,
  }

fn index_of(names: List<ModuleEntry>, name: Bytes) -> Option<Int> =
  fold(names, None, |acc: Option<Int>, e: ModuleEntry|
    match acc { Some(_) -> acc, None -> if e.name == name { Some(e.at) } else { None } })

fn one_import(w: World, i: Int, builder: Builder, decl: ImportDecl) -> Builder / {abort.raise} =
  match target(w, i, builder, decl) {
    Found(t) -> {
      let b2: Builder = {
        ..builder,
        edges: push(builder.edges, { from: i, target: t, span: path_span(decl) }),
      };
      match decl.kind {
        INames(names) -> {
          let key = default_binder(import_module_name(decl));
          let sel = match find_module_binding(b2.scope.selective, key) {
            Some(_) -> b2.scope.selective,
            None -> push(b2.scope.selective, { binder: key, target: t, span: path_span(decl) }),
          };
          let b3: Builder = { ..b2, scope: { ..b2.scope, selective: sel } };
          fold(names, b3, |acc: Builder, ident: Ident| bind_name(w, i, acc, t, ident))
        },
        _ -> bind_module(w, i, b2, decl, t),
      }
    },
    _ -> builder,
  }

/// What an import aims at: a module it may use, no such module, or a module of a package its
/// manifest does not declare (naming the importer and the holder).
type ImportTarget = | Found(Int) | Missing | Undeclared({ importer: Int, holder: Int })

/// The module an import names, judged against the package table.
fn target(w: World, i: Int, builder: Builder, decl: ImportDecl) -> ImportTarget / {abort.raise} = {
  let name = import_module_name(decl);
  if bytes_len(name) == 0 { Missing } else {
    let p = at(w.module_packages, i);
    // A bare import inside a dependency names that package's own modules and nothing
    // else: the root package's bare modules are unreachable from a dependency, so a
    // fallback here would be a reach-back no diagnostic ever sees.
    if 0 < p && p < w.shipped && p < len(w.pkgs) && bytes_index_of(name, b".") == None {
      sibling(w, i, name)
    } else {
      match sibling(w, i, name) {
        Found(t) -> Found(t),
        _ -> match index_of(w.names, name) {
          Some(t) -> if bytes_len(at(w.mods, t).name) == 0 { Missing } else { declared(w, i, t) },
          None -> Missing,
        },
      }
    }
  }
}

/// A sibling within the importing module's own package: a dependency's `import args` means
/// `<its prefix>.args` — always ahead of another package's bare `args`. The root package and
/// the shipped modules resolve bare names as written.
fn sibling(w: World, i: Int, name: Bytes) -> ImportTarget / {abort.raise} = {
  let p = at(w.module_packages, i);
  if p == 0 || p >= w.shipped || p >= len(w.pkgs) { Missing } else {
    let prefix = at(w.pkgs, p).prefix;
    if bytes_starts_with(name, bytes_concat(prefix, b".")) { Missing } else {
      match index_of(w.names, bytes_concat_all([prefix, b".", name])) {
        Some(t) -> if bytes_len(at(w.mods, t).name) == 0 { Missing } else { Found(t) },
        None -> Missing,
      }
    }
  }
}

/// An exact hit is usable when it is the importer's own package, the shipped modules, or a package
/// the importer's manifest declares; anything else is E0132, naming who holds it and who wants it.
fn declared(w: World, i: Int, t: Int) -> ImportTarget / {abort.raise} = {
  let p = at(w.module_packages, i);
  let q = at(w.module_packages, t);
  if q == p || q == w.std || q == w.compiler || q >= w.shipped || p >= w.shipped { Found(t) } else {
    let prefix = at(w.pkgs, q).prefix;
    if contains(at(w.pkgs, p).deps, prefix) { Found(t) }
    else { Undeclared({ importer: p, holder: q }) }
  }
}

fn target_or_report(
  w: World,
  i: Int,
  builder: Builder,
  decl: ImportDecl,
) -> { b: Builder, t: Option<Int> } / {abort.raise} =
  match target(w, i, builder, decl) {
    Found(t) -> { b: builder, t: Some(t) },
    Undeclared(u) -> {
      let name = import_module_name(decl);
      let message = if u.holder == 0 {
        bytes_concat_all([
          b"`",
          name,
          b"` belongs to the package being loaded; a dependency may not reach back into it",
        ])
      } else {
        bytes_concat_all([
          b"`",
          name,
          b"` belongs to the package `",
          at(w.pkgs, u.holder).prefix,
          b"`, which `",
          at(w.pkgs, u.importer).prefix,
          b"` does not declare as a dependency",
        ])
      };
      {
        b: {
          ..builder,
          diags: push(
            builder.diags,
            error_at(b"E0132", i, path_span(decl), message, b"not a declared dependency", [
              b"add it to that package's ply.pkg dependencies to import it",
            ]),
          ),
        },
        t: None,
      }
    },
    Missing -> {
      let name = import_module_name(decl);
      let near = fold(w.names, [], |acc: List<Bytes>, e: ModuleEntry|
        if bytes_len(e.name) > 0 && bytes_ends_with(e.name, default_binder(name)) {
          push(acc, e.name)
        } else { acc });
      let note = if len(near) == 0 {
        b"a module is a file: `store/orders.ply` is `store.orders`, relative to the project root"
      } else { bytes_concat(b"modules with that last segment: ", backticked(near, b", ")) };
      {
        b: {
          ..builder,
          diags: push(
            builder.diags,
            error_at(
              b"E0106",
              i,
              path_span(decl),
              bytes_concat_all([b"no module named `", name, b"` in this program"]),
              b"not found",
              [note],
            ),
          ),
        },
        t: None,
      }
    },
  }

fn bind_module(
  w: World,
  i: Int,
  builder: Builder,
  decl: ImportDecl,
  t: Int,
) -> Builder / {abort.raise} =
  match import_binder(decl) {
    None -> builder,
    Some(binder) -> {
      let s = binder_span(decl);
      match find_module_binding(builder.scope.modules, binder) {
        Some(first) -> {
          let name = import_module_name(decl);
          {
            ..builder,
            diags: push(
              builder.diags,
              error_at_and(
                b"E0110",
                i,
                s,
                bytes_concat_all([b"two imports bind the module name `", binder, b"`"]),
                bytes_concat_all([b"`", name, b"` would also be `", binder, b"`"]),
                i,
                first.span,
                bytes_concat_all([
                  b"`",
                  at(w.mods, first.target).name,
                  b"` is already bound as `",
                  binder,
                  b"`",
                ]),
                [bytes_concat_all([b"rename one of them: `import ", name, b" as <other>`"])],
              ),
            ),
          }
        },
        None ->
          {
            ..builder,
            scope: {
              ..builder.scope,
              modules: push(builder.scope.modules, { binder: binder, target: t, span: s }),
            },
          },
      }
    },
  }

fn bind_name(w: World, i: Int, builder: Builder, t: Int, name: Ident) -> Builder / {abort.raise} = {
  let decls = at(w.declarations, t);
  let module = at(w.mods, t).name;
  let found = filter(namespaces(), |namespace: Namespace|
    match lookup_declared(decls, namespace, name.name) { Some(_) -> true, None -> false });
  if len(found) == 0 {
    let exported = exported_names(decls);
    let note = if len(exported) == 0 {
      bytes_concat_all([b"`", module, b"` exports nothing; mark an item `pub` to export it"])
    } else { bytes_concat_all([b"`", module, b"` exports: ", backticked(exported, b", ")]) };
    {
      ..builder,
      diags: push(
        builder.diags,
        error_at(
          b"E0101",
          i,
          name.span,
          bytes_concat_all([b"module `", module, b"` declares no `", name.name, b"`"]),
          bytes_concat_all([b"not found in `", module, b"`"]),
          [note],
        ),
      ),
    }
  } else {
    let public = filter(found, |namespace: Namespace|
      match lookup_declared(decls, namespace, name.name) { Some(x) -> x.public, None -> false });
    if len(public) == 0 {
      let declared = match lookup_declared(decls, at(found, 0), name.name) {
        Some(x) -> x,
        None -> panic("just found"),
      };
      {
        ..builder,
        diags: push(builder.diags, match closed_ctor(w.mods, i, name.span, t, name.name) {
          Some(closed) -> closed,
          None -> private_name(i, name.span, t, declared.span, at(found, 0), name.name, module),
        }),
      }
    } else {
      fold(public, builder, |acc: Builder, namespace: Namespace|
        bind_one(w, i, acc, t, name, namespace))
    }
  }
}

pub fn private_name(
  m: Int,
  span: Span,
  owner: Int,
  declared: Span,
  namespace: Namespace,
  name: Bytes,
  module: Bytes,
) -> Diag =
  error_at_and(
    b"E0107",
    m,
    span,
    bytes_concat_all([b"`", name, b"` is private to module `", module, b"`"]),
    b"not exported",
    owner,
    declared,
    b"declared here, without `pub`",
    [
      bytes_concat_all([
        b"write `pub ",
        namespace_keyword(namespace),
        b" ",
        name,
        b"` in `",
        module,
        b"` to export it",
      ]),
      b"items are private by default",
    ],
  )

/// What `module` publishes for a type it declares `opaque`, which is all another module has of it.
pub fn closed_notes(module: Bytes, opaque: Opaque) -> List<Bytes> / {abort.raise} = {
  let answered = if len(opaque.answer) == 0 { [] }
  else { [bytes_concat_all([b"`", module, b"` answers one from ", list_names(opaque.answer)])] };
  if len(opaque.take) == 0 {
    if len(answered) > 0 { answered } else {
      [bytes_concat_all([b"`", module, b"` publishes no function that answers or takes one"])]
    }
  } else {
    push(answered, bytes_concat_all([b"`", module, b"` reads one with ", list_names(opaque.take)]))
  }
}

/// The `opaque` sum of `module` that declares the constructor `name`, and what it publishes for it.
fn closed_sum(module: Module, name: Bytes) -> Option<{ name: Bytes, opaque: Opaque }> =
  fold(module.items, None, |found: Option<{ name: Bytes, opaque: Opaque }>, item: Item|
    match found {
      Some(_) -> found,
      None -> match item {
        IType(d) -> match ((d.opaque, d.body)) {
          (Some(o), TDSum(vs)) -> if fold(vs, false, |held: Bool, v: VariantDef|
              held || v.name.name == name) { Some({ name: d.name.name, opaque: o }) }
          else { None },
          _ -> None,
        },
        _ -> None,
      },
    })

/// `name` as a constructor of an `opaque` sum of module `owner`, named from module `m`: the type's
/// module keeps it, and what that module publishes for the type is what `m` has.
pub fn closed_ctor(
  mods: List<ParsedModule>,
  m: Int,
  span: Span,
  owner: Int,
  name: Bytes,
) -> Option<Diag> / {abort.raise} = {
  let parsed = at(mods, owner);
  match closed_sum(parsed.module, name) {
    None -> None,
    Some(closed) ->
      Some(
        error_at_and(
          b"E0107",
          m,
          span,
          bytes_concat_all([
            b"`",
            name,
            b"` is a constructor of the opaque type `",
            qualify(parsed.name, closed.name),
            b"`",
          ]),
          bytes_concat_all([b"only `", parsed.name, b"` builds or matches one"]),
          owner,
          closed.opaque.span,
          b"declared `opaque` here",
          closed_notes(parsed.name, closed.opaque),
        ),
      ),
  }
}

fn bind_one(
  w: World,
  i: Int,
  builder: Builder,
  t: Int,
  name: Ident,
  namespace: Namespace,
) -> Builder / {abort.raise} = {
  let binding = match lookup(at(w.declared, t), namespace, name.name) {
    Some(x) -> x,
    None -> panic("a public declaration always has a binding"),
  };
  let module = at(w.mods, t).name;
  match lookup_declared(builder.local, namespace, name.name) {
    // Local-wins was rejected: a local added beside an import would silently steal every existing call site.
    Some(prev) ->
      {
        ..builder,
        diags: push(
          builder.diags,
          error_at_and(
            b"E0108",
            i,
            name.span,
            bytes_concat_all([
              b"the ",
              describe_namespace(namespace),
              b" `",
              name.name,
              b"` is both imported and defined in `",
              builder.scope.module,
              b"`",
            ]),
            bytes_concat_all([b"imported from `", module, b"` here"]),
            i,
            prev.span,
            bytes_concat_all([b"`", name.name, b"` is also defined here"]),
            [
              bytes_concat_all([
                b"drop it from the import list and write `import ",
                module,
                b"`, then `",
                default_binder(module),
                b"::",
                name.name,
                b"` where you mean the imported one",
              ]),
              b"neither one silently wins: a call site would change meaning without changing",
            ],
          ),
        ),
      },
    None -> match lookup_declared(builder.imported, namespace, name.name) {
      Some(prev) ->
        {
          ..builder,
          diags: push(
            builder.diags,
            error_at_and(
              b"E0110",
              i,
              name.span,
              bytes_concat_all([
                b"the ",
                describe_namespace(namespace),
                b" `",
                name.name,
                b"` is imported twice",
              ]),
              b"imported again here",
              i,
              prev.span,
              b"first imported here",
              [
                bytes_concat_all([
                  b"remove one import, or import the module and write `<module>::",
                  name.name,
                  b"`",
                ]),
              ],
            ),
          ),
        },
      None -> {
        let imported = push_declared(builder.imported, namespace, {
          name: name.name,
          qualified: binding.qualified,
          public: true,
          span: name.span,
        });
        let bound = push_binding(builder.scope.bound, namespace, {
          name: name.name,
          qualified: binding.qualified,
          owner: t,
          span: name.span,
        });
        { ..builder, imported: imported, scope: { ..builder.scope, bound: bound } }
      },
    },
  }
}

// --- The dependency order ---------------------------------------------------------

type Cycle = { nodes: List<Int>, closing: Edge }

type OrderSearch = {
  color: List<Int>,
  order: List<Int>,
  cycles: List<Cycle>,
  found: List<List<Int>>,
  path: List<Int>,
  stack: List<{ v: Int, edge: Int }>,
}

/// One iterative DFS finds every cycle and, when there is none, leaves the dependency-first load order.
fn traverse(edges: List<List<Edge>>) -> OrderSearch / {abort.raise} = {
  let n = len(edges);
  let steps = fold(edges, 0, |acc: Int, es: List<Edge>| acc + len(es));
  let start = {
    color: map(range(0, n), |i: Int| 0),
    order: [],
    cycles: [],
    found: [],
    path: [],
    stack: [],
  };
  fold(range(0, n), start, |s: OrderSearch, root: Int|
    if at(s.color, root) != 0 { s } else {
      let opened: OrderSearch = {
        ..s,
        color: list_set(s.color, root, 1),
        path: push(s.path, root),
        stack: [{ v: root, edge: 0 }],
      };
      iterate(opened, 2 * (n + steps) + 4, |d: OrderSearch|
        if len(d.stack) == 0 { Stop(d) } else { Continue(order_step(edges, d)) })
    })
}

fn order_step(edges: List<List<Edge>>, d: OrderSearch) -> OrderSearch / {abort.raise} = {
  let top = at(d.stack, len(d.stack) - 1);
  let popped = map(range(0, len(d.stack) - 1), |i: Int| at(d.stack, i));
  let out = at(edges, top.v);
  if top.edge < len(out) {
    let again = push(popped, { v: top.v, edge: top.edge + 1 });
    let e = at(out, top.edge);
    let w = e.target;
    let c = at(d.color, w);
    if c == 0 {
      {
        ..d,
        stack: push(again, { v: w, edge: 0 }),
        color: list_set(d.color, w, 1),
        path: push(d.path, w),
      }
    } else if c == 1 {
      let st = match position(d.path, w) { Some(p) -> p, None -> 0 };
      let nodes = drop(d.path, st);
      let key = canonical(nodes);
      if contains_key(d.found, key) { { ..d, stack: again } } else {
        {
          ..d,
          stack: again,
          found: push(d.found, key),
          cycles: push(d.cycles, { nodes: nodes, closing: e }),
        }
      }
    } else { { ..d, stack: again } }
  } else {
    {
      ..d,
      stack: popped,
      color: list_set(d.color, top.v, 2),
      path: take(d.path, len(d.path) - 1),
      order: push(d.order, top.v),
    }
  }
}

fn contains_key(keys: List<List<Int>>, key: List<Int>) -> Bool =
  fold(keys, false, |acc: Bool, k: List<Int>| acc || k == key)

/// Rotated so the smallest index leads: the same cycle reached from two roots compares equal.
fn canonical(nodes: List<Int>) -> List<Int> / {abort.raise} =
  if len(nodes) == 0 { [] } else {
    let least = fold(range(0, len(nodes)), 0, |best: Int, i: Int|
      if at(nodes, i) < at(nodes, best) { i } else { best });
    map(range(0, len(nodes)), |i: Int| at(nodes, (least + i) % len(nodes)))
  }

fn cycle_diag(mods: List<ParsedModule>, cycle: Cycle) -> Diag / {abort.raise} = {
  let names = map(cycle.nodes, |i: Int| at(mods, i).name);
  let first = if len(names) == 0 { b"" } else { at(names, 0) };
  if len(cycle.nodes) == 1 {
    error_at(
      b"E0109",
      cycle.closing.from,
      cycle.closing.span,
      bytes_concat_all([b"module `", first, b"` imports itself"]),
      b"a module cannot import itself",
      [b"every name a module declares is already in scope in its own file"],
    )
  } else {
    error_at(
      b"E0109",
      cycle.closing.from,
      cycle.closing.span,
      bytes_concat_all([b"module cycle: ", backticked(names, b" -> "), b" -> `", first, b"`"]),
      b"this import closes the cycle",
      [
        b"each of these has to be checked before the next, and the last before the first, so there is no order to check them in",
        b"move what they share into a module that all of them import",
      ],
    )
  }
}

// --- `find`: what a name denotes in a module -----------------------------------------

pub fn find(
  resolved: Resolved,
  module: Int,
  namespace: Namespace,
  qname: QName,
) -> Option<Binding> / {abort.raise} = {
  let scope = at(resolved.scopes, module);
  match qname.module {
    None -> lookup(scope.bound, namespace, qname.name.name),
    Some(binder) -> match find_module_binding(scope.modules, binder.name) {
      None -> None,
      Some(mb) -> match lookup_declared(
          at(resolved.declarations, mb.target),
          namespace,
          qname.name.name,
        ) {
        None -> None,
        // Only a default copied back into its module binds that module, which sees what it keeps.
        Some(d) -> if !d.public && mb.target != module { None }
        else { lookup(at(resolved.declared, mb.target), namespace, qname.name.name) },
      },
    },
  }
}

// --- Defaults: what a default may be -----------------------------------------------------

/// A pure, closed expression: a value, not something that runs.
fn is_default_expr(expr: Expr) -> Bool / {abort.raise} =
  match expr {
    EApp(a) ->
      len(a.named) == 0 && (match a.func { EVar(v) -> starts_upper(v.name.name.name), _ -> false })
        && all_default(a.args),
    EPerform(_) -> false,
    EHandle(_) -> false,
    EWithCell(_) -> false,
    ESimulate(_) -> false,
    EParallel(_) -> false,
    ETry(_) -> false,
    ETryBlock(_) -> false,
    ETagged(_) -> false,
    ELit(_) -> true,
    EVar(_) -> true,
    EBinary(b) -> is_default_expr(b.lhs) && is_default_expr(b.rhs),
    EUnary(u) -> is_default_expr(u.operand),
    ELambda(l) -> is_default_expr(l.body),
    EIf(i) ->
      is_default_expr(i.cond) && is_default_expr(i.then_branch) && is_default_expr(i.else_branch),
    EMatch(m) ->
      is_default_expr(m.scrutinee)
        && fold(m.arms, true, |acc: Bool, arm: MatchArm|
          acc && is_default_expr(arm.body)
            && (match arm.guard { None -> true, Some(g) -> is_default_expr(g) })),
    EBlock(b) ->
      fold(b.stmts, true, |acc: Bool, stmt: Stmt|
          acc
            && (match stmt {
              SLet(l) -> is_default_expr(l.value),
              SLetElse(l) -> is_default_expr(l.value) && is_default_expr(l.fallback),
              SExpr(x) -> is_default_expr(x),
            }))
        && (match b.tail { None -> true, Some(t) -> is_default_expr(t) }),
    ERecord(r) -> fold(r.fields, true, |acc: Bool, f: RecField| acc && is_default_expr(f.value)),
    ERecordUpdate(r) ->
      is_default_expr(r.base)
        && fold(r.fields, true, |acc: Bool, f: RecField| acc && is_default_expr(f.value)),
    EField(f) -> is_default_expr(f.base),
    EList(l) -> all_default(l.items),
    EBad(_) -> true,
  }

fn all_default(exprs: List<Expr>) -> Bool / {abort.raise} =
  fold(exprs, true, |acc: Bool, expr: Expr| acc && is_default_expr(expr))

pub fn pattern_binders(p: Pattern, out: List<Bytes>) -> List<Bytes> =
  match p {
    PVar(v) -> push(out, v.name.name),
    PCtor(c) -> fold(c.args, out, |acc: List<Bytes>, a: Pattern| pattern_binders(a, acc)),
    PRecord(r) ->
      fold(r.fields, out, |acc: List<Bytes>, f: { name: Ident, pat: Pattern }|
        pattern_binders(f.pat, acc)),
    PList(l) -> {
      let items = fold(l.items, out, |acc: List<Bytes>, x: Pattern| pattern_binders(x, acc));
      match l.rest { None -> items, Some(r) -> pattern_binders(r, items) }
    },
    POr(o) -> fold(o.alts, out, |acc: List<Bytes>, a: Pattern| pattern_binders(a, acc)),
    PWild(_) -> out,
    PLit(_) -> out,
    PRange(_) -> out,
    PBad(_) -> out,
  }

/// Which of `params` the expression names free, in evaluation order.
fn mentions(e: Expr, params: List<Bytes>, bound: List<Bytes>, out: List<Bytes>) -> List<Bytes> =
  match e {
    EVar(v) -> if is_bare(v.name) && !contains(bound, v.name.name.name)
        && contains(params, v.name.name.name) { push(out, v.name.name.name) }
    else { out },
    ELambda(l) ->
      mentions(
        l.body,
        params,
        fold(l.params, bound, |acc: List<Bytes>, p: Param| push(acc, p.name.name)),
        out,
      ),
    EApp(a) -> {
      let o1 = mentions(a.func, params, bound, out);
      let o2 = fold(a.args, o1, |acc: List<Bytes>, x: Expr| mentions(x, params, bound, acc));
      fold(a.named, o2, |acc: List<Bytes>, arg: NamedArg| mentions(arg.value, params, bound, acc))
    },
    EBinary(b) -> mentions(b.rhs, params, bound, mentions(b.lhs, params, bound, out)),
    EUnary(u) -> mentions(u.operand, params, bound, out),
    EIf(i) ->
      mentions(
        i.else_branch,
        params,
        bound,
        mentions(i.then_branch, params, bound, mentions(i.cond, params, bound, out)),
      ),
    EMatch(m) ->
      fold(m.arms, mentions(m.scrutinee, params, bound, out), |acc: List<Bytes>, arm: MatchArm| {
        let inner = pattern_binders(arm.pat, bound);
        let g = match arm.guard { None -> acc, Some(x) -> mentions(x, params, inner, acc) };
        mentions(arm.body, params, inner, g)
      }),
    EBlock(b) -> {
      let walked = fold(
        b.stmts,
        { bound: bound, out: out },
        |acc: { bound: List<Bytes>, out: List<Bytes> }, s: Stmt|
          match s {
            SLet(l) ->
              {
                bound: pattern_binders(l.pat, acc.bound),
                out: mentions(l.value, params, acc.bound, acc.out),
              },
            // The `else` block runs where the pattern bound nothing.
            SLetElse(l) ->
              {
                bound: pattern_binders(l.pat, acc.bound),
                out: mentions(
                  l.fallback,
                  params,
                  acc.bound,
                  mentions(l.value, params, acc.bound, acc.out),
                ),
              },
            SExpr(x) -> { ..acc, out: mentions(x, params, acc.bound, acc.out) },
          },
      );
      match b.tail { None -> walked.out, Some(t) -> mentions(t, params, walked.bound, walked.out) }
    },
    ERecord(r) ->
      fold(r.fields, out, |acc: List<Bytes>, f: RecField| mentions(f.value, params, bound, acc)),
    ERecordUpdate(r) ->
      fold(r.fields, mentions(r.base, params, bound, out), |acc: List<Bytes>, f: RecField|
        mentions(f.value, params, bound, acc)),
    EField(f) -> mentions(f.base, params, bound, out),
    EList(l) -> fold(l.items, out, |acc: List<Bytes>, x: Expr| mentions(x, params, bound, acc)),
    ETry(t) -> mentions(t.operand, params, bound, out),
    EPerform(p) -> fold(p.args, out, |acc: List<Bytes>, x: Expr| mentions(x, params, bound, acc)),
    EHandle(h) -> mentions(h.body, params, bound, out),
    EWithCell(c) -> mentions(c.body, params, bound, out),
    ESimulate(s) -> mentions(s.body, params, bound, out),
    ETryBlock(t) -> mentions(t.body, params, bound, out),
    EParallel(v) ->
      fold(v.branches, out, |acc: List<Bytes>, x: Expr| mentions(x, params, bound, acc)),
    ELit(_) -> out,
    ETagged(_) -> out,
    EBad(_) -> out,
  }

// --- Defaults: qualifying one against the module that wrote it -----------------------------

type Qualifier = {
  owner: Int,
  public: Bool,
  bound: List<Bytes>,
  imports: List<ModuleBinding>,
  diags: List<Diag>,
}
type Qualified = { q: Qualifier, e: Expr }

fn qualify_expr(resolved: Resolved, qualifier: Qualifier, expr: Expr) -> Qualified / {abort.raise} =
  match expr {
    EVar(v) -> if !is_bare(v.name) || contains(qualifier.bound, v.name.name.name) {
      { q: qualifier, e: expr }
    } else {
      match find(resolved, qualifier.owner, ValueSpace, v.name) {
        // A builtin or a prelude constructor: in reach everywhere, so it needs no qualifying.
        None -> { q: qualifier, e: expr },
        Some(b) -> if b.owner == qualifier.owner && qualifier.public
            && !decl_public(resolved, qualifier.owner, v.name.name.name) {
          {
            q: {
              ..qualifier,
              diags: push(
                qualifier.diags,
                error_at(
                  b"E0122",
                  qualifier.owner,
                  v.name.span,
                  bytes_concat_all([
                    b"a default on a `pub fn` cannot mention `",
                    v.name.name.name,
                    b"`",
                  ]),
                  b"not exported by this module",
                  [
                    b"the default is copied into every call site that omits the argument, and a caller in another module may not name this",
                  ],
                ),
              ),
            },
            e: expr,
          }
        } else {
          let module = at(resolved.scopes, b.owner).module;
          let imports = match find_module_binding(qualifier.imports, module) {
            Some(_) -> qualifier.imports,
            None ->
              push(qualifier.imports, { binder: module, target: b.owner, span: dummy_span() }),
          };
          {
            q: { ..qualifier, imports: imports },
            e: EVar({
              span: v.span,
              name: {
                module: Some({ name: module, span: v.name.span }),
                name: v.name.name,
                span: v.name.span,
              },
            }),
          }
        },
      }
    },
    ELambda(l) -> {
      let mark = len(qualifier.bound);
      let inner = fold(l.params, qualifier.bound, |acc: List<Bytes>, p: Param|
        push(acc, p.name.name));
      let o: Qualified = qualify_expr(resolved, { ..qualifier, bound: inner }, l.body);
      {
        q: { ..o.q, bound: take(o.q.bound, mark) },
        e: ELambda({ span: l.span, body: o.e, params: l.params, ret: l.ret }),
      }
    },
    EApp(a) -> {
      let f = qualify_expr(resolved, qualifier, a.func);
      let args = qualify_exprs(resolved, f.q, a.args);
      let named = fold(
        a.named,
        { q: args.q, xs: [] },
        |acc: { q: Qualifier, xs: List<NamedArg> }, arg: NamedArg| {
          let o = qualify_expr(resolved, acc.q, arg.value);
          { q: o.q, xs: push(acc.xs, { name: arg.name, value: o.e, span: arg.span }) }
        },
      );
      {
        q: named.q,
        e: EApp({ span: a.span, func: f.e, named: named.xs, args: args.xs, labels: a.labels }),
      }
    },
    EMatch(m) -> {
      let s: Qualified = qualify_expr(resolved, qualifier, m.scrutinee);
      let arms = fold(
        m.arms,
        { q: s.q, xs: [] },
        |acc: { q: Qualifier, xs: List<MatchArm> }, arm: MatchArm| {
          let mark = len(acc.q.bound);
          let inner = { ..acc.q, bound: pattern_binders(arm.pat, acc.q.bound) };
          let g: { q: Qualifier, e: Option<Expr> } = match arm.guard {
            None -> { q: inner, e: None },
            Some(x) -> {
              let o: Qualified = qualify_expr(resolved, inner, x);
              { q: o.q, e: Some(o.e) }
            },
          };
          let body: Qualified = qualify_expr(resolved, g.q, arm.body);
          {
            q: { ..body.q, bound: take(body.q.bound, mark) },
            xs: push(acc.xs, { pat: arm.pat, guard: g.e, body: body.e, span: arm.span }),
          }
        },
      );
      { q: arms.q, e: EMatch({ span: m.span, scrutinee: s.e, arms: arms.xs }) }
    },
    EBlock(b) -> {
      let mark = len(qualifier.bound);
      let stmts: { q: Qualifier, xs: List<Stmt> } = fold(
        b.stmts,
        { q: qualifier, xs: [] },
        |acc: { q: Qualifier, xs: List<Stmt> }, s: Stmt|
          match s {
            SLet(l) -> {
              let o: Qualified = qualify_expr(resolved, acc.q, l.value);
              {
                q: { ..o.q, bound: pattern_binders(l.pat, o.q.bound) },
                xs: push(acc.xs, SLet({ span: l.span, pat: l.pat, ty: l.ty, value: o.e })),
              }
            },
            SLetElse(l) -> {
              let o: Qualified = qualify_expr(resolved, acc.q, l.value);
              let fb: Qualified = qualify_expr(resolved, o.q, l.fallback);
              {
                q: { ..fb.q, bound: pattern_binders(l.pat, fb.q.bound) },
                xs: push(acc.xs, SLetElse({ ..l, value: o.e, fallback: fb.e })),
              }
            },
            SExpr(x) -> {
              let o: Qualified = qualify_expr(resolved, acc.q, x);
              { q: o.q, xs: push(acc.xs, SExpr(o.e)) }
            },
          },
      );
      let tail: { q: Qualifier, e: Option<Expr> } = match b.tail {
        None -> { q: stmts.q, e: None },
        Some(t) -> {
          let o: Qualified = qualify_expr(resolved, stmts.q, t);
          { q: o.q, e: Some(o.e) }
        },
      };
      {
        q: { ..tail.q, bound: take(tail.q.bound, mark) },
        e: EBlock({ span: b.span, tail: tail.e, stmts: stmts.xs }),
      }
    },
    EBinary(b) -> {
      let l = qualify_expr(resolved, qualifier, b.lhs);
      let rr = qualify_expr(resolved, l.q, b.rhs);
      { q: rr.q, e: EBinary({ span: b.span, op: b.op, lhs: l.e, rhs: rr.e }) }
    },
    EUnary(u) -> {
      let o: Qualified = qualify_expr(resolved, qualifier, u.operand);
      { q: o.q, e: EUnary({ span: u.span, op: u.op, operand: o.e }) }
    },
    EIf(i) -> {
      let c = qualify_expr(resolved, qualifier, i.cond);
      let t = qualify_expr(resolved, c.q, i.then_branch);
      let el = qualify_expr(resolved, t.q, i.else_branch);
      { q: el.q, e: EIf({ span: i.span, cond: c.e, then_branch: t.e, else_branch: el.e }) }
    },
    ERecord(rec) -> {
      let o = qualify_fields(resolved, qualifier, rec.fields);
      { q: o.q, e: ERecord({ span: rec.span, fields: o.xs }) }
    },
    ERecordUpdate(rec) -> {
      let b = qualify_expr(resolved, qualifier, rec.base);
      let o = qualify_fields(resolved, b.q, rec.fields);
      { q: o.q, e: ERecordUpdate({ span: rec.span, base: b.e, fields: o.xs }) }
    },
    EField(f) -> {
      let o: Qualified = qualify_expr(resolved, qualifier, f.base);
      { q: o.q, e: EField({ span: f.span, base: o.e, field: f.field }) }
    },
    EList(l) -> {
      let o = qualify_exprs(resolved, qualifier, l.items);
      { q: o.q, e: EList({ span: l.span, items: o.xs }) }
    },
    ETry(t) -> {
      let o: Qualified = qualify_expr(resolved, qualifier, t.operand);
      { q: o.q, e: ETry({ span: t.span, operand: o.e }) }
    },
    // Refused by `is_default_expr` already; reached only after the checker has reported it.
    EPerform(p) -> {
      let o = qualify_exprs(resolved, qualifier, p.args);
      {
        q: o.q,
        e: EPerform({ span: p.span, eff: p.eff, op: p.op, resource: p.resource, args: o.xs }),
      }
    },
    EHandle(h) -> {
      let o: Qualified = qualify_expr(resolved, qualifier, h.body);
      { q: o.q, e: EHandle({ span: h.span, body: o.e, ret: h.ret, clauses: h.clauses }) }
    },
    EWithCell(c) -> {
      let o: Qualified = qualify_expr(resolved, qualifier, c.body);
      {
        q: o.q,
        e: EWithCell({
          span: c.span,
          resource: c.resource,
          init: c.init,
          binder: c.binder,
          body: o.e,
        }),
      }
    },
    ESimulate(s) -> {
      let o: Qualified = qualify_expr(resolved, qualifier, s.body);
      { q: o.q, e: ESimulate({ span: s.span, body: o.e }) }
    },
    ETryBlock(t) -> {
      let o: Qualified = qualify_expr(resolved, qualifier, t.body);
      { q: o.q, e: ETryBlock({ ..t, body: o.e }) }
    },
    EParallel(v) -> {
      let o = qualify_exprs(resolved, qualifier, v.branches);
      { q: o.q, e: EParallel({ span: v.span, branches: o.xs }) }
    },
    ELit(_) -> { q: qualifier, e: expr },
    ETagged(_) -> { q: qualifier, e: expr },
    EBad(_) -> { q: qualifier, e: expr },
  }

fn qualify_exprs(
  resolved: Resolved,
  qualifier: Qualifier,
  exprs: List<Expr>,
) -> { q: Qualifier, xs: List<Expr> } / {abort.raise} =
  fold(exprs, { q: qualifier, xs: [] }, |acc: { q: Qualifier, xs: List<Expr> }, expr: Expr| {
    let o = qualify_expr(resolved, acc.q, expr);
    { q: o.q, xs: push(acc.xs, o.e) }
  })

fn qualify_fields(
  resolved: Resolved,
  qualifier: Qualifier,
  fields: List<RecField>,
) -> { q: Qualifier, xs: List<RecField> } / {abort.raise} =
  fold(
    fields,
    { q: qualifier, xs: [] },
    |acc: { q: Qualifier, xs: List<RecField> }, field: RecField| {
      let o = qualify_expr(resolved, acc.q, field.value);
      { q: o.q, xs: push(acc.xs, { name: field.name, value: o.e }) }
    },
  )

fn decl_public(resolved: Resolved, owner: Int, name: Bytes) -> Bool / {abort.raise} =
  match lookup_declared(at(resolved.declarations, owner), ValueSpace, name) {
    Some(d) -> d.public,
    None -> false,
  }

// --- Effect sets ---------------------------------------------------------------------------
// A set stands for its atoms, each meaning what it means in the module that wrote it. A row of that
// module gets them as written; a row anywhere else gets them through the module that declares the
// effect, which the row's module then reaches under a binder no import can write, so no import of
// its own can stand in for it.

pub fn reached_binder(module: Bytes) -> Bytes = bytes_concat(b"@", module)

/// One atom a set stands for, and the module whose scope wrote it.
type Member = { atom: AtomExpr, home: Int }

/// A set of the program: its item and module, the sets it includes, whether it lies on a cycle, and
/// once expanded every atom it stands for.
type SetNode = {
  def: EffectSetDef,
  module: Int,
  includes: List<Option<Int>>,
  cyclic: Bool,
  members: List<Member>,
}

/// Each module's sets by name; the first declaration of a name is the set.
type SetTable = { nodes: List<SetNode>, by_module: List<Map<Bytes, Int>>, diags: List<Diag> }

fn set_table(mods: List<ParsedModule>) -> SetTable / {abort.raise} =
  fold(range(0, len(mods)), { nodes: [], by_module: [], diags: [] }, |table: SetTable, m: Int|
    fold(
      at(mods, m).module.items,
      { ..table, by_module: push(table.by_module, map_new()) },
      |acc: SetTable, item: Item|
        match item {
          IEffectSet(d) -> {
            let mine = at(acc.by_module, m);
            match map_get(mine, d.name.name) {
              Some(first) ->
                {
                  ..acc,
                  diags: push(
                    acc.diags,
                    error_at_and(
                      b"E0105",
                      m,
                      d.name.span,
                      bytes_concat_all([b"duplicate effect set `", d.name.name, b"`"]),
                      b"redefined here",
                      m,
                      at(acc.nodes, first).def.name.span,
                      b"first defined here",
                      [b"rename one of them; every effect set in a module needs a distinct name"],
                    ),
                  ),
                },
              None ->
                {
                  ..acc,
                  by_module: list_set(
                    acc.by_module,
                    m,
                    map_insert(mine, d.name.name, len(acc.nodes)),
                  ),
                  nodes: push(acc.nodes, {
                    def: d,
                    module: m,
                    includes: [],
                    cyclic: false,
                    members: [],
                  }),
                },
            }
          },
          _ -> acc,
        },
    ))

fn unknown_set(resolved: Resolved, m: Int, qname: QName) -> Diag / {abort.raise} = {
  let scope = at(resolved.scopes, m);
  let n = qname.name.name;
  let effect_notes = match lookup(scope.bound, EffectSpace, n) {
    Some(_) ->
      [
        bytes_concat_all([
          b"`",
          n,
          b"` is an effect, and a member of a set is an atom: write `",
          n,
          b".read[..]` or `",
          n,
          b".write[..]`",
        ]),
        b"a whole effect is every resource label anywhere in the program, so naming one would let an unrelated module change this row and therefore this definition's hash",
      ],
    None -> [],
  };
  let named = map(scope.bound.sets, |binding: Binding| binding.name);
  let known = if len(named) == 0 {
    b"this module names no `effect set`: declare one, or import one by name from the module that declares it `pub`"
  } else { bytes_concat(b"the sets this module names: ", backticked(named, b", ")) };
  error_at(
    b"E0114",
    m,
    qname.span,
    bytes_concat_all([b"no `effect set` named `", n, b"` here"]),
    b"neither declared nor imported here",
    push(effect_notes, known),
  )
}

/// `diverges` in a row is an atom with no operation to name, rather than a set.
fn is_diverges_name(qname: QName) -> Bool = qname.module == None && qname.name.name == b"diverges"

fn diverges_expr(qname: QName) -> AtomExpr =
  {
    eff: qname,
    mode: MRead,
    op: None,
    resource: None,
    every: false,
    bounded: false,
    span: qname.span,
  }

/// The set `qname` names in module `m`: one it declares or imports by name, or one a module binder reaches.
fn set_named(
  resolved: Resolved,
  table: SetTable,
  m: Int,
  qname: QName,
) -> Result<Int, Diag> / {abort.raise} = {
  let scope = at(resolved.scopes, m);
  let name = qname.name.name;
  match qname.module {
    None -> match lookup(scope.bound, SetSpace, name) {
      Some(b) -> match map_get(at(table.by_module, b.owner), name) {
        Some(id) -> Ok(id),
        None -> Err(unknown_set(resolved, m, qname)),
      },
      None -> Err(unknown_set(resolved, m, qname)),
    },
    Some(binder) -> match find_module_binding(scope.modules, binder.name) {
      None ->
        Err(
          error_at(
            b"E0114",
            m,
            qname.span,
            bytes_concat_all([b"no module is imported as `", binder.name, b"`"]),
            b"not a module imported by this file",
            [b"import the module that declares the set, or import the set by name"],
          ),
        ),
      Some(mb) -> {
        let module = at(resolved.scopes, mb.target).module;
        match lookup_declared(at(resolved.declarations, mb.target), SetSpace, name) {
          None -> {
            let exported = map(
              filter(at(resolved.declarations, mb.target).sets, |d: Declared| d.public),
              |d: Declared| d.name,
            );
            Err(
              error_at(
                b"E0114",
                m,
                qname.span,
                bytes_concat_all([
                  b"module `",
                  module,
                  b"` declares no `effect set` named `",
                  name,
                  b"`",
                ]),
                bytes_concat_all([b"not found in `", module, b"`"]),
                [
                  if len(exported) == 0 {
                    bytes_concat_all([b"`", module, b"` exports no effect set"])
                  } else {
                    bytes_concat_all([b"`", module, b"` exports ", backticked(exported, b", ")])
                  },
                ],
              ),
            )
          },
          Some(d) -> if !d.public && mb.target != m {
            Err(private_name(m, qname.span, mb.target, d.span, SetSpace, name, module))
          } else {
            match map_get(at(table.by_module, mb.target), name) {
              Some(id) -> Ok(id),
              None -> Err(unknown_set(resolved, m, qname)),
            }
          },
        }
      },
    },
  }
}

fn set_includes(resolved: Resolved, table: SetTable) -> SetTable / {abort.raise} =
  fold(range(0, len(table.nodes)), table, |acc: SetTable, id: Int| {
    let node = at(acc.nodes, id);
    let walked = fold(
      node.def.includes,
      { diags: acc.diags, xs: [] },
      |w: { diags: List<Diag>, xs: List<Option<Int>> }, qname: QName|
        match set_named(resolved, acc, node.module, qname) {
          Ok(i) -> { ..w, xs: push(w.xs, Some(i)) },
          Err(d) -> { diags: push(w.diags, d), xs: push(w.xs, None) },
        },
    );
    { ..acc, diags: walked.diags, nodes: list_set(acc.nodes, id, { ..node, includes: walked.xs }) }
  })

type SetSearch = {
  color: List<Int>,
  path: List<Int>,
  work: List<{ node: Int, next: Int }>,
  t: SetTable,
}

fn set_cycles(table: SetTable) -> SetTable / {abort.raise} = {
  let n = len(table.nodes);
  let steps = fold(table.nodes, 0, |acc: Int, node: SetNode| acc + len(node.includes));
  let start: SetSearch = { color: map(range(0, n), |i: Int| 0), path: [], work: [], t: table };
  let done = fold(range(0, n), start, |d: SetSearch, root: Int|
    if at(d.color, root) != 0 { d } else {
      let opened: SetSearch = {
        ..d,
        color: list_set(d.color, root, 1),
        path: push(d.path, root),
        work: [{ node: root, next: 0 }],
      };
      iterate(opened, 2 * (n + steps) + 4, |x: SetSearch|
        if len(x.work) == 0 { Stop(x) } else { Continue(set_search_step(x)) })
    });
  done.t
}

fn set_search_step(d: SetSearch) -> SetSearch / {abort.raise} = {
  let top = at(d.work, len(d.work) - 1);
  let rest = take(d.work, len(d.work) - 1);
  let out = at(d.t.nodes, top.node).includes;
  if top.next >= len(out) {
    { ..d, color: list_set(d.color, top.node, 2), work: rest, path: take(d.path, len(d.path) - 1) }
  } else {
    let advanced = push(rest, { node: top.node, next: top.next + 1 });
    match at(out, top.next) {
      None -> { ..d, work: advanced },
      Some(target) -> {
        let c = at(d.color, target);
        if c == 0 {
          {
            ..d,
            work: push(advanced, { node: target, next: 0 }),
            color: list_set(d.color, target, 1),
            path: push(d.path, target),
          }
        } else if c == 1 {
          let st = match position(d.path, target) { Some(p) -> p, None -> 0 };
          let cycle = drop(d.path, st);
          let t2 = {
            ..d.t,
            diags: push(d.t.diags, set_cycle(d.t, cycle)),
            nodes: fold(cycle, d.t.nodes, |ns: List<SetNode>, i: Int|
              list_set(ns, i, { ..at(ns, i), cyclic: true })),
          };
          { ..d, work: advanced, t: t2 }
        } else { { ..d, work: advanced } }
      },
    }
  }
}

fn set_cycle(table: SetTable, cycle: List<Int>) -> Diag / {abort.raise} = {
  let head = at(table.nodes, at(cycle, 0));
  let others = drop(cycle, 1);
  let names = push(map(cycle, |i: Int| at(table.nodes, i).def.name.name), head.def.name.name);
  let primary = if len(cycle) == 1 { b"this set names itself" } else {
    bytes_concat_all([
      b"expands through ",
      backticked(map(others, |i: Int| at(table.nodes, i).def.name.name), b", "),
      b" and back",
    ])
  };
  error_with_labels(
    b"E0115",
    bytes_concat_all([b"effect set `", head.def.name.name, b"` contains itself"]),
    fold(
      others,
      [label_at(head.module, head.def.name.span, true, primary)],
      |labels: List<Label>, i: Int|
        push(
          labels,
          label_at(
            at(table.nodes, i).module,
            at(table.nodes, i).def.name.span,
            false,
            b"on the cycle",
          ),
        ),
    ),
    [
      bytes_concat(b"the cycle is ", backticked(names, b" -> ")),
      b"expansion is a fixed point, and a cycle has none: break it by inlining the atoms one of these sets needs",
    ],
  )
}

/// The module that declares the effect `qname` names in `home`, and its name there: none for a prelude
/// effect, or one nothing declares.
fn effect_owner(
  resolved: Resolved,
  home: Int,
  qname: QName,
) -> Option<{ target: Int, name: Bytes }> / {abort.raise} = {
  let scope = at(resolved.scopes, home);
  match qname.module {
    Some(b) -> match find_module_binding(scope.modules, b.name) {
      Some(mb) -> match lookup_declared(
          at(resolved.declarations, mb.target),
          EffectSpace,
          qname.name.name,
        ) {
        Some(_) -> Some({ target: mb.target, name: qname.name.name }),
        None -> None,
      },
      None -> None,
    },
    None -> match lookup(scope.bound, EffectSpace, qname.name.name) {
      Some(b) -> Some({ target: b.owner, name: b.name }),
      None -> None,
    },
  }
}

/// What an atom names, wherever it was written: its effect's program-wide name, mode, operation and label.
fn member_key(resolved: Resolved, member: Member) -> Bytes / {abort.raise} = {
  let a = member.atom;
  let eff = match effect_owner(resolved, member.home, a.eff) {
    Some(o) -> qualify(at(resolved.scopes, o.target).module, o.name),
    None -> match a.eff.module {
      Some(b) -> bytes_concat_all([b.name, b"::", a.eff.name.name]),
      None -> a.eff.name.name,
    },
  };
  bytes_concat_all([
    eff,
    b" ",
    mode_text(a.mode),
    b" ",
    match a.op { Some(o) -> o.name, None -> b"" },
    b" ",
    if a.every { b"*" } else { match a.resource { Some(x) -> x.name, None -> b"" } },
  ])
}

type KeyedMember = { key: Bytes, member: Member }

fn insert_keyed(sorted: List<KeyedMember>, k: KeyedMember) -> List<KeyedMember> / {abort.raise} = {
  let n = len(sorted);
  let i = fold(range(0, n), n, |acc: Int, j: Int|
    if acc < n { acc } else if compare(k.key, at(sorted, j).key) == Less { j } else { acc });
  fold(drop(sorted, i), push(take(sorted, i), k), |acc: List<KeyedMember>, x: KeyedMember|
    push(acc, x))
}

/// Ordered by what each atom names; of two that name the same, the first written is kept.
fn canonical_members(resolved: Resolved, xs: List<Member>) -> List<Member> / {abort.raise} = {
  let sorted = fold(xs, [], |acc: List<KeyedMember>, member: Member|
    insert_keyed(acc, { key: member_key(resolved, member), member: member }));
  map(
    fold(sorted, [], |acc: List<KeyedMember>, keyed: KeyedMember|
      if len(acc) > 0 && at(acc, len(acc) - 1).key == keyed.key { acc } else { push(acc, keyed) }),
    |keyed: KeyedMember| keyed.member,
  )
}

type SetWork = { t: SetTable, done: List<Bool>, work: List<{ node: Int, visited: Bool }> }

fn set_expand_all(resolved: Resolved, table: SetTable) -> SetTable / {abort.raise} = {
  let n = len(table.nodes);
  let steps = fold(table.nodes, 0, |acc: Int, node: SetNode| acc + len(node.includes));
  let start: SetWork = { t: table, done: map(range(0, n), |i: Int| false), work: [] };
  let finished = fold(range(0, n), start, |x: SetWork, root: Int|
    if at(x.done, root) || at(x.t.nodes, root).cyclic { x } else {
      iterate({ ..x, work: [{ node: root, visited: false }] }, 4 * (n + steps) + 4, |y: SetWork|
        if len(y.work) == 0 { Stop(y) } else { Continue(set_expand_step(resolved, y)) })
    });
  finished.t
}

fn set_expand_step(resolved: Resolved, x: SetWork) -> SetWork / {abort.raise} = {
  let top = at(x.work, len(x.work) - 1);
  let rest = take(x.work, len(x.work) - 1);
  let node = at(x.t.nodes, top.node);
  if at(x.done, top.node) || node.cyclic { { ..x, work: rest } } else if !top.visited {
    let pushed = fold(
      node.includes,
      push(rest, { node: top.node, visited: true }),
      |w: List<{ node: Int, visited: Bool }>, e: Option<Int>|
        match e {
          Some(i) -> if !at(x.done, i) && !at(x.t.nodes, i).cyclic {
            push(w, { node: i, visited: false })
          } else { w },
          None -> w,
        },
    );
    { ..x, work: pushed }
  } else {
    let own = map(node.def.atoms, |atom: AtomExpr| { atom: atom, home: node.module });
    let all = fold(node.includes, own, |acc: List<Member>, e: Option<Int>|
      match e {
        Some(i) ->
          fold(at(x.t.nodes, i).members, acc, |ms: List<Member>, member: Member| push(ms, member)),
        None -> acc,
      });
    {
      ..x,
      work: rest,
      done: list_set(x.done, top.node, true),
      t: {
        ..x.t,
        nodes: list_set(x.t.nodes, top.node, { ..node, members: canonical_members(resolved, all) }),
      },
    }
  }
}

fn moved_to(atom: AtomExpr, span: Span) -> AtomExpr =
  {
    eff: {
      module: match atom.eff.module { Some(b) -> Some({ name: b.name, span: span }), None -> None },
      name: { name: atom.eff.name.name, span: span },
      span: span,
    },
    mode: atom.mode,
    op: match atom.op { Some(o) -> Some({ name: o.name, span: span }), None -> None },
    resource: match atom.resource { Some(x) -> Some({ name: x.name, span: span }), None -> None },
    every: atom.every,
    bounded: atom.bounded,
    span: span,
  }

type Usable = { atom: AtomExpr, bind: Option<ModuleBinding> }

/// A member as module `m` writes it at `span`: as written in its own module, and through the module
/// that declares its effect anywhere else. An effect that resolves to no module, a prelude one or a
/// misspelling, keeps its written name, and the checker answers for it where the set is named.
fn usable(resolved: Resolved, m: Int, member: Member, span: Span) -> Usable / {abort.raise} =
  if member.home == m { { atom: member.atom, bind: None } } else {
    let moved = moved_to(member.atom, span);
    match effect_owner(resolved, member.home, member.atom.eff) {
      None -> { atom: moved, bind: None },
      Some(o) -> {
        let module = at(resolved.scopes, o.target).module;
        if bytes_len(module) == 0 { { atom: moved, bind: None } } else {
          let binder = reached_binder(module);
          {
            atom: {
              ..moved,
              eff: {
                module: Some({ name: binder, span: span }),
                name: { name: o.name, span: span },
                span: span,
              },
            },
            bind: Some({ binder: binder, target: o.target, span: dummy_span() }),
          }
        }
      },
    }
  }

fn with_reach(xs: List<ModuleBinding>, b: Option<ModuleBinding>) -> List<ModuleBinding> =
  match b {
    None -> xs,
    Some(x) -> match find_module_binding(xs, x.binder) { Some(_) -> xs, None -> push(xs, x) },
  }

type RowExpander = {
  resolved: Resolved,
  table: SetTable,
  module: Int,
  reached: List<ModuleBinding>,
  diags: List<Diag>,
}

type ExpandedRow = { expander: RowExpander, r: RowExpr }

fn row_with_sets(expander: RowExpander, row: RowExpr) -> ExpandedRow / {abort.raise} =
  if len(row.aliases) == 0 { { expander: expander, r: row } } else {
    let o = fold(
      row.aliases,
      { expander: expander, atoms: row.atoms },
      |acc: { expander: RowExpander, atoms: List<AtomExpr> }, qname: QName|
        if is_diverges_name(qname) { { ..acc, atoms: push(acc.atoms, diverges_expr(qname)) } }
        else {
          match set_named(acc.expander.resolved, acc.expander.table, acc.expander.module, qname) {
            Err(d) -> { ..acc, expander: { ..acc.expander, diags: push(acc.expander.diags, d) } },
            Ok(id) ->
              fold(
                at(acc.expander.table.nodes, id).members,
                acc,
                |a: { expander: RowExpander, atoms: List<AtomExpr> }, member: Member| {
                  let u = usable(a.expander.resolved, a.expander.module, member, qname.span);
                  {
                    expander: { ..a.expander, reached: with_reach(a.expander.reached, u.bind) },
                    atoms: push(a.atoms, u.atom),
                  }
                },
              ),
          }
        },
    );
    {
      expander: o.expander,
      r: {
        atoms: o.atoms,
        aliases: row.aliases,
        tail: row.tail,
        tail_bounded: row.tail_bounded,
        span: row.span,
      },
    }
  }

/// Each row of the module with every set it names expanded; each set's own item with all it stands for.
fn module_sets(
  resolved: Resolved,
  table: SetTable,
  m: Int,
  parsed: ParsedModule,
) -> { module: ParsedModule, expander: RowExpander } / {abort.raise} = {
  let start: RowExpander = { resolved: resolved, table: table, module: m, reached: [], diags: [] };
  let walked = fold(
    parsed.module.items,
    { expander: start, items: [] },
    |acc: { expander: RowExpander, items: List<Item> }, item: Item|
      match item {
        IEffectSet(d) -> match map_get(at(table.by_module, m), d.name.name) {
          Some(id) -> if at(table.nodes, id).def.span == d.span {
            let us = map(at(table.nodes, id).members, |member: Member|
              usable(resolved, m, member, d.name.span));
            {
              expander: {
                ..acc.expander,
                reached: fold(
                  us,
                  acc.expander.reached,
                  |bindings: List<ModuleBinding>, u: Usable| with_reach(bindings, u.bind),
                ),
              },
              items: push(acc.items, IEffectSet({ ..d, expansion: map(us, |u: Usable| u.atom) })),
            }
          } else { { ..acc, items: push(acc.items, item) } },
          None -> { ..acc, items: push(acc.items, item) },
        },
        _ -> {
          let o = rows_item(acc.expander, item);
          { expander: o.expander, items: push(acc.items, o.it) }
        },
      },
  );
  {
    module: {
      name: parsed.name,
      module: { ..parsed.module, items: walked.items },
      derived: parsed.derived,
    },
    expander: walked.expander,
  }
}

// Every row an item writes, with the sets it names expanded. Rows are walked on lambda parameter
// types and `let` annotations, never on a lambda's return type.

fn rows_opt(
  expander: RowExpander,
  r: Option<RowExpr>,
) -> { expander: RowExpander, r: Option<RowExpr> } / {abort.raise} =
  match r {
    None -> { expander: expander, r: None },
    Some(x) -> {
      let o = row_with_sets(expander, x);
      { expander: o.expander, r: Some(o.r) }
    },
  }

fn rows_ty(
  expander: RowExpander,
  ty: TypeExpr,
) -> { expander: RowExpander, t: TypeExpr } / {abort.raise} =
  match ty {
    TCon(c) -> {
      let o = rows_tys(expander, c.args);
      let rows = fold(
        c.rows,
        { expander: o.expander, rs: [] },
        |acc: { expander: RowExpander, rs: List<RowExpr> }, row: RowExpr| {
          let r = row_with_sets(acc.expander, row);
          { expander: r.expander, rs: push(acc.rs, r.r) }
        },
      );
      { expander: rows.expander, t: TCon({ ..c, args: o.ts, rows: rows.rs }) }
    },
    TFn(ft) -> {
      let ps = rows_tys(expander, ft.params);
      let r = rows_ty(ps.expander, ft.ret);
      let e = rows_opt(r.expander, ft.effects);
      { expander: e.expander, t: TFn({ span: ft.span, params: ps.ts, ret: r.t, effects: e.r }) }
    },
    TRecord(r) -> {
      let fs = fold(
        r.fields,
        { expander: expander, fs: [] },
        |acc: { expander: RowExpander, fs: List<{ name: Ident, ty: TypeExpr }> }, fd: { name: Ident, ty: TypeExpr }| {
          let o = rows_ty(acc.expander, fd.ty);
          { expander: o.expander, fs: push(acc.fs, { name: fd.name, ty: o.t }) }
        },
      );
      { expander: fs.expander, t: TRecord({ span: r.span, fields: fs.fs }) }
    },
    _ -> { expander: expander, t: ty },
  }

fn rows_tys(
  expander: RowExpander,
  tys: List<TypeExpr>,
) -> { expander: RowExpander, ts: List<TypeExpr> } / {abort.raise} =
  fold(
    tys,
    { expander: expander, ts: [] },
    |acc: { expander: RowExpander, ts: List<TypeExpr> }, ty: TypeExpr| {
      let o = rows_ty(acc.expander, ty);
      { expander: o.expander, ts: push(acc.ts, o.t) }
    },
  )

fn rows_opt_ty(
  expander: RowExpander,
  ty: Option<TypeExpr>,
) -> { expander: RowExpander, t: Option<TypeExpr> } / {abort.raise} =
  match ty {
    None -> { expander: expander, t: None },
    Some(x) -> {
      let o = rows_ty(expander, x);
      { expander: o.expander, t: Some(o.t) }
    },
  }

fn rows_params(
  expander: RowExpander,
  params: List<Param>,
) -> { expander: RowExpander, ps: List<Param> } / {abort.raise} =
  fold(
    params,
    { expander: expander, ps: [] },
    |acc: { expander: RowExpander, ps: List<Param> }, param: Param| {
      let o = rows_opt_ty(acc.expander, param.ty);
      { expander: o.expander, ps: push(acc.ps, { ..param, ty: o.t }) }
    },
  )

fn rows_exprs(
  expander: RowExpander,
  exprs: List<Expr>,
) -> { expander: RowExpander, xs: List<Expr> } / {abort.raise} =
  fold(
    exprs,
    { expander: expander, xs: [] },
    |acc: { expander: RowExpander, xs: List<Expr> }, expr: Expr| {
      let o = rows_expr(acc.expander, expr);
      { expander: o.expander, xs: push(acc.xs, o.e) }
    },
  )

fn rows_fields(
  expander: RowExpander,
  fields: List<RecField>,
) -> { expander: RowExpander, fs: List<RecField> } / {abort.raise} =
  fold(
    fields,
    { expander: expander, fs: [] },
    |acc: { expander: RowExpander, fs: List<RecField> }, field: RecField| {
      let o = rows_expr(acc.expander, field.value);
      { expander: o.expander, fs: push(acc.fs, { name: field.name, value: o.e }) }
    },
  )

fn rows_opt_expr(
  expander: RowExpander,
  expr: Option<Expr>,
) -> { expander: RowExpander, e: Option<Expr> } / {abort.raise} =
  match expr {
    None -> { expander: expander, e: None },
    Some(x) -> {
      let o = rows_expr(expander, x);
      { expander: o.expander, e: Some(o.e) }
    },
  }

fn rows_expr(
  expander: RowExpander,
  expr: Expr,
) -> { expander: RowExpander, e: Expr } / {abort.raise} =
  match expr {
    EBinary(b) -> {
      let l = rows_expr(expander, b.lhs);
      let r = rows_expr(l.expander, b.rhs);
      { expander: r.expander, e: EBinary({ span: b.span, op: b.op, lhs: l.e, rhs: r.e }) }
    },
    EUnary(u) -> {
      let o = rows_expr(expander, u.operand);
      { expander: o.expander, e: EUnary({ span: u.span, op: u.op, operand: o.e }) }
    },
    ELambda(l) -> {
      let ps = rows_params(expander, l.params);
      let b = rows_expr(ps.expander, l.body);
      { expander: b.expander, e: ELambda({ span: l.span, body: b.e, params: ps.ps, ret: l.ret }) }
    },
    EApp(a) -> {
      let callee = rows_expr(expander, a.func);
      let args = rows_exprs(callee.expander, a.args);
      let named = fold(
        a.named,
        { expander: args.expander, ns: [] },
        |acc: { expander: RowExpander, ns: List<NamedArg> }, arg: NamedArg| {
          let o = rows_expr(acc.expander, arg.value);
          { expander: o.expander, ns: push(acc.ns, { name: arg.name, value: o.e, span: arg.span }) }
        },
      );
      {
        expander: named.expander,
        e: EApp({ span: a.span, func: callee.e, named: named.ns, args: args.xs, labels: a.labels }),
      }
    },
    EIf(i) -> {
      let c = rows_expr(expander, i.cond);
      let t = rows_expr(c.expander, i.then_branch);
      let el = rows_expr(t.expander, i.else_branch);
      {
        expander: el.expander,
        e: EIf({ span: i.span, cond: c.e, then_branch: t.e, else_branch: el.e }),
      }
    },
    EMatch(m) -> {
      let sc = rows_expr(expander, m.scrutinee);
      let arms = fold(
        m.arms,
        { expander: sc.expander, arms: [] },
        |acc: { expander: RowExpander, arms: List<MatchArm> }, arm: MatchArm| {
          let g = rows_opt_expr(acc.expander, arm.guard);
          let b = rows_expr(g.expander, arm.body);
          {
            expander: b.expander,
            arms: push(acc.arms, { pat: arm.pat, guard: g.e, body: b.e, span: arm.span }),
          }
        },
      );
      { expander: arms.expander, e: EMatch({ span: m.span, scrutinee: sc.e, arms: arms.arms }) }
    },
    EBlock(b) -> {
      let stmts = fold(
        b.stmts,
        { expander: expander, ss: [] },
        |acc: { expander: RowExpander, ss: List<Stmt> }, stmt: Stmt|
          match stmt {
            SLet(l) -> {
              let t = rows_opt_ty(acc.expander, l.ty);
              let v = rows_expr(t.expander, l.value);
              {
                expander: v.expander,
                ss: push(acc.ss, SLet({ span: l.span, pat: l.pat, ty: t.t, value: v.e })),
              }
            },
            SLetElse(l) -> {
              let t = rows_opt_ty(acc.expander, l.ty);
              let v = rows_expr(t.expander, l.value);
              let fb = rows_expr(v.expander, l.fallback);
              {
                expander: fb.expander,
                ss: push(
                  acc.ss,
                  SLetElse({ span: l.span, pat: l.pat, ty: t.t, value: v.e, fallback: fb.e }),
                ),
              }
            },
            SExpr(x) -> {
              let o = rows_expr(acc.expander, x);
              { expander: o.expander, ss: push(acc.ss, SExpr(o.e)) }
            },
          },
      );
      let tl = rows_opt_expr(stmts.expander, b.tail);
      { expander: tl.expander, e: EBlock({ span: b.span, tail: tl.e, stmts: stmts.ss }) }
    },
    ERecord(r) -> {
      let o = rows_fields(expander, r.fields);
      { expander: o.expander, e: ERecord({ span: r.span, fields: o.fs }) }
    },
    ERecordUpdate(r) -> {
      let b = rows_expr(expander, r.base);
      let o = rows_fields(b.expander, r.fields);
      { expander: o.expander, e: ERecordUpdate({ span: r.span, base: b.e, fields: o.fs }) }
    },
    EField(fd) -> {
      let o = rows_expr(expander, fd.base);
      { expander: o.expander, e: EField({ span: fd.span, base: o.e, field: fd.field }) }
    },
    ETry(t) -> {
      let o = rows_expr(expander, t.operand);
      { expander: o.expander, e: ETry({ span: t.span, operand: o.e }) }
    },
    EList(l) -> {
      let o = rows_exprs(expander, l.items);
      { expander: o.expander, e: EList({ span: l.span, items: o.xs }) }
    },
    EPerform(p) -> {
      let o = rows_exprs(expander, p.args);
      {
        expander: o.expander,
        e: EPerform({ span: p.span, eff: p.eff, op: p.op, resource: p.resource, args: o.xs }),
      }
    },
    EHandle(h) -> {
      let b = rows_expr(expander, h.body);
      let cs = fold(
        h.clauses,
        { expander: b.expander, cs: [] },
        |acc: { expander: RowExpander, cs: List<HandleClause> }, c: HandleClause| {
          let o = rows_expr(acc.expander, c.body);
          {
            expander: o.expander,
            cs: push(acc.cs, {
              eff: c.eff,
              op: c.op,
              resource: c.resource,
              every_label: c.every_label,
              label_binder: c.label_binder,
              resume: c.resume,
              body: o.e,
              span: c.span,
              params: c.params,
            }),
          }
        },
      );
      let r = match h.ret {
        None -> { expander: cs.expander, r: None },
        Some(rc) -> {
          let o = rows_expr(cs.expander, rc.body);
          { expander: o.expander, r: Some({ binder: rc.binder, body: o.e, span: rc.span }) }
        },
      };
      { expander: r.expander, e: EHandle({ span: h.span, body: b.e, ret: r.r, clauses: cs.cs }) }
    },
    EWithCell(c) -> {
      let i = rows_expr(expander, c.init);
      let b = rows_expr(i.expander, c.body);
      {
        expander: b.expander,
        e: EWithCell({
          span: c.span,
          resource: c.resource,
          init: i.e,
          binder: c.binder,
          body: b.e,
        }),
      }
    },
    ESimulate(x) -> {
      let o = rows_expr(expander, x.body);
      { expander: o.expander, e: ESimulate({ span: x.span, body: o.e }) }
    },
    ETryBlock(x) -> {
      let o = rows_expr(expander, x.body);
      { expander: o.expander, e: ETryBlock({ ..x, body: o.e }) }
    },
    EParallel(x) -> {
      let o = rows_exprs(expander, x.branches);
      { expander: o.expander, e: EParallel({ span: x.span, branches: o.xs }) }
    },
    ETagged(t) -> {
      let filled = fold(
        t.holes,
        { expander: expander, holes: [] },
        |acc: { expander: RowExpander, holes: List<Hole> }, h: Hole| {
          let o = rows_expr(acc.expander, h.value);
          { expander: o.expander, holes: push(acc.holes, { ..h, value: o.e }) }
        },
      );
      { expander: filled.expander, e: ETagged({ ..t, holes: filled.holes }) }
    },
    _ -> { expander: expander, e: expr },
  }

fn rows_item(
  expander: RowExpander,
  item: Item,
) -> { expander: RowExpander, it: Item } / {abort.raise} =
  match item {
    IFn(d) -> {
      let ps = rows_params(expander, d.params);
      let r = rows_opt_ty(ps.expander, d.ret);
      let ef = rows_opt(r.expander, d.effects);
      let spec = fold(
        d.spec,
        { expander: ef.expander, xs: [] },
        |acc: { expander: RowExpander, xs: List<SpecClause> }, clause: SpecClause| {
          let o = rows_expr(acc.expander, clause.expr);
          {
            expander: o.expander,
            xs: push(acc.xs, { kind: clause.kind, expr: o.e, span: clause.span }),
          }
        },
      );
      let measured: { expander: RowExpander, e: Option<Expr> } = match d.decreases {
        None -> { expander: spec.expander, e: None },
        Some(e) -> {
          let o = rows_expr(spec.expander, e);
          { expander: o.expander, e: Some(o.e) }
        },
      };
      let b = rows_expr(measured.expander, d.body);
      {
        expander: b.expander,
        it: IFn({
          vis: d.vis,
          name: d.name,
          generics: d.generics,
          params: ps.ps,
          ret: r.t,
          effects: ef.r,
          constraints: d.constraints,
          spec: spec.xs,
          returns: d.returns,
          reuse: d.reuse,
          transparent: d.transparent,
          baked: d.baked,
          decreases: measured.e,
          body: b.e,
          doc: d.doc,
          span: d.span,
        }),
      }
    },
    IType(d) -> match d.body {
      TDAlias(t) -> {
        let o = rows_ty(expander, t);
        { expander: o.expander, it: IType({ ..d, body: TDAlias(o.t) }) }
      },
      TDNominal(t) -> {
        let o = rows_ty(expander, t);
        { expander: o.expander, it: IType({ ..d, body: TDNominal(o.t) }) }
      },
      TDSum(vs) -> {
        let out = fold(
          vs,
          { expander: expander, vs: [] },
          |acc: { expander: RowExpander, vs: List<VariantDef> }, variant: VariantDef| {
            let o = rows_tys(acc.expander, variant.fields);
            { expander: o.expander, vs: push(acc.vs, { ..variant, fields: o.ts }) }
          },
        );
        { expander: out.expander, it: IType({ ..d, body: TDSum(out.vs) }) }
      },
    },
    IEffect(d) -> {
      let ops = fold(
        d.ops,
        { expander: expander, ops: [] },
        |acc: { expander: RowExpander, ops: List<OpDef> }, op: OpDef| {
          let ps = rows_tys(acc.expander, op.params);
          let r = rows_ty(ps.expander, op.ret);
          { expander: r.expander, ops: push(acc.ops, { ..op, params: ps.ts, ret: r.t }) }
        },
      );
      { expander: ops.expander, it: IEffect({ ..d, ops: ops.ops }) }
    },
    ITest(d) -> {
      let ranged: { expander: RowExpander, cases: Option<Cases> } = match d.cases {
        None -> { expander: expander, cases: None },
        Some(c) -> {
          let t = rows_ty(expander, c.ty);
          let table = rows_expr(t.expander, c.table);
          let label = rows_expr(table.expander, c.label);
          {
            expander: label.expander,
            cases: Some({ ..c, ty: t.t, table: table.e, label: label.e }),
          }
        },
      };
      let o = rows_expr(ranged.expander, d.body);
      { expander: o.expander, it: ITest({ ..d, cases: ranged.cases, body: o.e }) }
    },
    ILaw(d) -> {
      let bs = fold(
        d.binders,
        { expander: expander, binders: [] },
        |acc: { expander: RowExpander, binders: List<Binder> }, b: Binder| {
          let o = rows_ty(acc.expander, b.ty);
          {
            expander: o.expander,
            binders: push(acc.binders, { name: b.name, ty: o.t, span: b.span }),
          }
        },
      );
      let g = rows_opt_expr(bs.expander, d.guard);
      let b = rows_expr(g.expander, d.body);
      {
        expander: b.expander,
        it: ILaw({
          name: d.name,
          name_span: d.name_span,
          host: d.host,
          binders: bs.binders,
          guard: g.e,
          cost: d.cost,
          costs: d.costs,
          of: d.of,
          body: b.e,
          span: d.span,
        }),
      }
    },
    _ -> { expander: expander, it: item },
  }

// --- Law schemas: what an instantiation states -------------------------------------------------

fn has_instance(module: Module) -> Bool =
  fold(module.items, false, |found: Bool, item: Item|
    found || (match item { ILaw(d) -> d.of != None, _ -> false }))

/// The schema's name for a binder, with `_` after it until nothing the arguments name, and no binder
/// before it, is called that: an argument written here never reads a binder.
fn apart(name: Bytes, args: List<Expr>, taken: List<Bytes>, room: Int) -> Bytes / {abort.raise} =
  iterate(name, room, |n: Bytes|
    if !contains(taken, n)
        && fold(args, true, |free: Bool, x: Expr| free && len(mentions(x, [n], [], [])) == 0) {
      Stop(n)
    } else { Continue(bytes_concat(n, b"_")) })

type Instantiation = { r: Resolved, law: LawDef, diags: List<Diag> }

/// `law "label" = schema(f, g)` as the law it is: over the schema's binders, its guard and body
/// the schema's definitions called with what it was given and then the binders. A name that
/// resolves to nothing is left as written, for the checker to say what is in reach.
fn instance(
  r: Resolved,
  mods: List<ParsedModule>,
  m: Int,
  d: LawDef,
  i: OfSchema,
  diags: List<Diag>,
) -> Instantiation / {abort.raise} =
  match find(r, m, ValueSpace, i.schema) {
    None -> { r: r, law: d, diags: diags },
    Some(b) -> {
      let name = i.schema.name.name;
      let home = at(mods, b.owner);
      let args = match d.body { EApp(a) -> a.args, _ -> [] };
      match schema_named(home.module, name) {
        None ->
          {
            r: r,
            law: d,
            diags: push(
              diags,
              error_at_and(
                b"E0472",
                m,
                i.schema.span,
                bytes_concat_all([b"`", name, b"` is not a law schema"]),
                b"a law instantiates a schema",
                b.owner,
                b.span,
                b"declared here",
                [
                  b"a schema is declared `law schema name(f: (A) -> B) forall (x: A) { .. }`, and a law over a definition that is not one writes its own binders and body",
                ],
              ),
            ),
          },
        Some(schema) -> if len(args) != len(schema.params) {
          {
            r: r,
            law: d,
            diags: push(
              diags,
              error_at_and(
                b"E0202",
                m,
                i.span,
                bytes_concat_all([
                  b"the schema `",
                  name,
                  b"` takes ",
                  counted(len(schema.params), b"argument"),
                  b", but ",
                  ascii_of_int(len(args)),
                  if len(args) == 1 { b" was supplied" } else { b" were supplied" },
                ]),
                bytes_concat_all([
                  b"expected ",
                  ascii_of_int(len(schema.params)),
                  b", found ",
                  ascii_of_int(len(args)),
                ]),
                b.owner,
                schema.name.span,
                b"this is the schema being instantiated",
                [],
              ),
            ),
          }
        } else {
          let through = { name: reached_binder(home.name), span: i.schema.span };
          let end = { start: i.span.end, end: i.span.end };
          let names = fold(schema.binders, [], |acc: List<Bytes>, binder: Binder|
            push(
              acc,
              apart(binder.name.name, args, acc, i.span.end - i.span.start + len(acc) + 2),
            ));
          let given = concat(
            args,
            map(names, |n: Bytes|
              EVar({ span: end, name: { module: None, name: { name: n, span: end }, span: end } })),
          );
          let call = |callee: Bytes, at: Span|
            EApp({
              span: at,
              func: EVar({
                span: i.schema.span,
                name: {
                  module: Some(through),
                  name: { name: callee, span: i.schema.name.span },
                  span: i.schema.span,
                },
              }),
              named: [],
              args: given,
              labels: [],
            });
          {
            r: reach(r, m, through.name, b.owner),
            law: {
              ..d,
              binders: map(names, |n: Bytes|
                {
                  name: { name: n, span: i.span },
                  ty: TVar({ name: n, span: i.span }),
                  span: i.span,
                }),
              guard: match schema.guard {
                Some(_) -> Some(call(schema_guard_name(name), i.schema.span)),
                None -> None,
              },
              of: Some({
                ..i,
                home: Some(home.name),
                shown: map(schema.binders, |binder: Binder| binder.name.name),
              }),
              body: call(name, i.span),
            },
            diags: diags,
          }
        },
      }
    },
  }

fn counted(n: Int, what: Bytes) -> Bytes =
  bytes_concat_all([ascii_of_int(n), b" ", what, if n == 1 { b"" } else { b"s" }])

type Instantiated = { r: Resolved, mods: List<ParsedModule>, diags: List<Diag> }

fn instantiated(r: Resolved, mods: List<ParsedModule>) -> Instantiated / {abort.raise} =
  fold(range(0, len(mods)), { r: r, mods: [], diags: [] }, |acc: Instantiated, m: Int| {
    let mod: ParsedModule = at(mods, m);
    if !has_instance(mod.module) { { ..acc, mods: push(acc.mods, mod) } } else {
      let walked = fold(
        mod.module.items,
        { r: acc.r, items: [], diags: acc.diags },
        |w: { r: Resolved, items: List<Item>, diags: List<Diag> }, item: Item|
          match item {
            ILaw(d) -> match d.of {
              None -> { ..w, items: push(w.items, item) },
              Some(i) -> {
                let o = instance(w.r, mods, m, d, i, w.diags);
                { r: o.r, items: push(w.items, ILaw(o.law)), diags: o.diags }
              },
            },
            _ -> { ..w, items: push(w.items, item) },
          },
      );
      {
        r: walked.r,
        mods: push(acc.mods, { ..mod, module: { ..mod.module, items: walked.items } }),
        diags: walked.diags,
      }
    }
  })

type SetsExpanded = { r: Resolved, mods: List<ParsedModule>, diags: List<Diag> }

fn expand_sets(r: Resolved, mods: List<ParsedModule>) -> SetsExpanded / {abort.raise} = {
  let t = set_expand_all(r, set_cycles(set_includes(r, set_table(mods))));
  fold(range(0, len(mods)), { r: r, mods: [], diags: t.diags }, |acc: SetsExpanded, m: Int| {
    let o = module_sets(r, t, m, at(mods, m));
    {
      r: fold(o.expander.reached, acc.r, |rr: Resolved, binding: ModuleBinding|
        reach(rr, m, binding.binder, binding.target)),
      mods: push(acc.mods, o.module),
      diags: bytes_concat_diags(acc.diags, o.expander.diags),
    }
  })
}

// --- Defaults: the signatures ---------------------------------------------------------------

type ParamInfo = { name: Bytes, default: Option<Expr>, imports: List<ModuleBinding> }
type Signature = { name: Bytes, params: List<ParamInfo> }
type Collected = {
  sigs: List<Signature>,
  owner_imports: List<{ module: Int, binder: Bytes, target: Int }>,
  diags: List<Diag>,
}

fn collect(resolved: Resolved, mods: List<ParsedModule>) -> Collected / {abort.raise} =
  fold(range(0, len(mods)), { sigs: [], owner_imports: [], diags: [] }, |acc: Collected, m: Int|
    fold(at(mods, m).module.items, acc, |c: Collected, item: Item|
      match item { IFn(f) -> collect_fn(resolved, mods, m, c, f), _ -> c }))

fn collect_fn(
  resolved: Resolved,
  mods: List<ParsedModule>,
  m: Int,
  c: Collected,
  def: FnDef,
) -> Collected / {abort.raise} = {
  let names = map(def.params, |param: Param| param.name.name);
  let walked: { c: Collected, params: List<ParamInfo> } = fold(
    def.params,
    { c: c, params: [] },
    |acc: { c: Collected, params: List<ParamInfo> }, param: Param|
      match param.default {
        None ->
          {
            ..acc,
            params: push(acc.params, { name: param.name.name, default: None, imports: [] }),
          },
        Some(d) -> {
          let adm = admissible(m, d, names, acc.c.diags);
          if !adm.ok {
            {
              c: { ..acc.c, diags: adm.diags },
              params: push(acc.params, { name: param.name.name, default: None, imports: [] }),
            }
          } else {
            let o = qualify_expr(
              resolved,
              { owner: m, public: is_pub(def.vis), bound: [], imports: [], diags: adm.diags },
              d,
            );
            // The writing module needs the binder as much as any caller does.
            let owner_imports = fold(
              o.q.imports,
              acc.c.owner_imports,
              |oi: List<{ module: Int, binder: Bytes, target: Int }>, binding: ModuleBinding|
                push(oi, { module: m, binder: binding.binder, target: binding.target }),
            );
            {
              c: { ..acc.c, diags: o.q.diags, owner_imports: owner_imports },
              params: push(acc.params, {
                name: param.name.name,
                default: Some(o.e),
                imports: o.q.imports,
              }),
            }
          }
        },
      },
  );
  {
    ..walked.c,
    sigs: push(walked.c.sigs, {
      name: qualify(at(mods, m).name, def.name.name),
      params: walked.params,
    }),
  }
}

fn admissible(
  m: Int,
  expr: Expr,
  names: List<Bytes>,
  diags: List<Diag>,
) -> { ok: Bool, diags: List<Diag> } / {abort.raise} =
  if !is_default_expr(expr) {
    {
      ok: false,
      diags: push(
        diags,
        error_at(
          b"E0121",
          m,
          expr_span(expr),
          b"a parameter default must be a pure, closed expression",
          b"this runs, rather than being a value",
          [
            b"the default is copied into every call that omits the argument, so a call                  or a `perform` in it would run at the caller and not here",
            b"a literal, a constructor applied to literals, a record or a list is fine",
          ],
        ),
      ),
    }
  } else {
    let mentioned = mentions(expr, names, [], []);
    if len(mentioned) > 0 {
      {
        ok: false,
        diags: push(
          diags,
          error_at(
            b"E0121",
            m,
            expr_span(expr),
            bytes_concat_all([b"a parameter default cannot mention `", at(mentioned, 0), b"`"]),
            b"names a parameter of this same signature",
            [b"a call site has no such binding for the default to be copied into"],
          ),
        ),
      }
    } else { { ok: true, diags: diags } }
  }

/// The module now reaches `target` under `binder`, with no span.
fn reach(resolved: Resolved, module: Int, binder: Bytes, target: Int) -> Resolved / {abort.raise} = {
  let scope: Scope = at(resolved.scopes, module);
  match find_module_binding(scope.modules, binder) {
    Some(_) -> resolved,
    None ->
      {
        ..resolved,
        scopes: list_set(resolved.scopes, module, {
          ..scope,
          modules: push(scope.modules, { binder: binder, target: target, span: dummy_span() }),
        }),
      },
  }
}

/// The builtins that carry a default: `assert(cond, message: None)`.
fn builtin_signature(name: Bytes) -> Option<Signature> =
  if name == b"assert" {
    Some({
      name: b"assert",
      params: [
        { name: b"cond", default: None, imports: [] },
        {
          name: b"message",
          default: Some(
            EVar({
              span: dummy_span(),
              name: {
                module: None,
                name: { name: b"None", span: dummy_span() },
                span: dummy_span(),
              },
            }),
          ),
          imports: [],
        },
      ],
    })
  } else { None }

// --- Defaults: filling every call --------------------------------------------------------

type Filler = { module: Int, scope: List<Bytes>, implicit: List<ModuleBinding>, diags: List<Diag> }
type Filled = { filler: Filler, expr: Expr }
type Filling = { r: Resolved, index: Map<Bytes, Signature> }

fn fill_expr(f: Filling, filler: Filler, expr: Expr) -> Filled / {abort.raise} = {
  // Children first, so a nested call is filled before the outer one copies it.
  let o = fill_children(f, filler, expr);
  match o.expr { EApp(a) -> fill(f, o.filler, a), _ -> o }
}

fn fill_children(f: Filling, filler: Filler, expr: Expr) -> Filled / {abort.raise} =
  match expr {
    ELit(_) -> { filler: filler, expr: expr },
    ETagged(t) -> {
      let filled = fold(
        t.holes,
        { filler: filler, holes: [] },
        |acc: { filler: Filler, holes: List<Hole> }, h: Hole| {
          let o: Filled = fill_expr(f, acc.filler, h.value);
          { filler: o.filler, holes: push(acc.holes, { ..h, value: o.expr }) }
        },
      );
      { filler: filled.filler, expr: ETagged({ ..t, holes: filled.holes }) }
    },
    EVar(_) -> { filler: filler, expr: expr },
    EBad(_) -> { filler: filler, expr: expr },
    EBinary(b) -> {
      let l = fill_expr(f, filler, b.lhs);
      let rr = fill_expr(f, l.filler, b.rhs);
      { filler: rr.filler, expr: EBinary({ span: b.span, op: b.op, lhs: l.expr, rhs: rr.expr }) }
    },
    EUnary(u) -> {
      let o: Filled = fill_expr(f, filler, u.operand);
      { filler: o.filler, expr: EUnary({ span: u.span, op: u.op, operand: o.expr }) }
    },
    ELambda(l) -> {
      let mark = len(filler.scope);
      let inner = {
        ..filler,
        scope: fold(l.params, filler.scope, |acc: List<Bytes>, p: Param| push(acc, p.name.name)),
      };
      let o: Filled = fill_expr(f, inner, l.body);
      {
        filler: { ..o.filler, scope: take(o.filler.scope, mark) },
        expr: ELambda({ span: l.span, body: o.expr, params: l.params, ret: l.ret }),
      }
    },
    EApp(a) -> {
      let fn_ = fill_expr(f, filler, a.func);
      let args = fill_exprs(f, fn_.filler, a.args);
      let named = fold(
        a.named,
        { filler: args.filler, xs: [] },
        |acc: { filler: Filler, xs: List<NamedArg> }, arg: NamedArg| {
          let o = fill_expr(f, acc.filler, arg.value);
          { filler: o.filler, xs: push(acc.xs, { name: arg.name, value: o.expr, span: arg.span }) }
        },
      );
      {
        filler: named.filler,
        expr: EApp({
          span: a.span,
          func: fn_.expr,
          named: named.xs,
          args: args.xs,
          labels: a.labels,
        }),
      }
    },
    EIf(i) -> {
      let c = fill_expr(f, filler, i.cond);
      let t = fill_expr(f, c.filler, i.then_branch);
      let el = fill_expr(f, t.filler, i.else_branch);
      {
        filler: el.filler,
        expr: EIf({ span: i.span, cond: c.expr, then_branch: t.expr, else_branch: el.expr }),
      }
    },
    EMatch(m) -> {
      let s = fill_expr(f, filler, m.scrutinee);
      let arms = fold(
        m.arms,
        { filler: s.filler, xs: [] },
        |acc: { filler: Filler, xs: List<MatchArm> }, arm: MatchArm| {
          let mark = len(acc.filler.scope);
          let inner = { ..acc.filler, scope: pattern_binders(arm.pat, acc.filler.scope) };
          let g: { filler: Filler, expr: Option<Expr> } = match arm.guard {
            None -> { filler: inner, expr: None },
            Some(x) -> {
              let o: Filled = fill_expr(f, inner, x);
              { filler: o.filler, expr: Some(o.expr) }
            },
          };
          let body: Filled = fill_expr(f, g.filler, arm.body);
          {
            filler: { ..body.filler, scope: take(body.filler.scope, mark) },
            xs: push(acc.xs, { pat: arm.pat, guard: g.expr, body: body.expr, span: arm.span }),
          }
        },
      );
      { filler: arms.filler, expr: EMatch({ span: m.span, scrutinee: s.expr, arms: arms.xs }) }
    },
    EBlock(b) -> {
      let mark = len(filler.scope);
      let stmts: { filler: Filler, xs: List<Stmt> } = fold(
        b.stmts,
        { filler: filler, xs: [] },
        |acc: { filler: Filler, xs: List<Stmt> }, s: Stmt|
          match s {
            SLet(l) -> {
              let o: Filled = fill_expr(f, acc.filler, l.value);
              {
                filler: { ..o.filler, scope: pattern_binders(l.pat, o.filler.scope) },
                xs: push(acc.xs, SLet({ span: l.span, pat: l.pat, ty: l.ty, value: o.expr })),
              }
            },
            SLetElse(l) -> {
              let o: Filled = fill_expr(f, acc.filler, l.value);
              let fb: Filled = fill_expr(f, o.filler, l.fallback);
              {
                filler: { ..fb.filler, scope: pattern_binders(l.pat, fb.filler.scope) },
                xs: push(acc.xs, SLetElse({ ..l, value: o.expr, fallback: fb.expr })),
              }
            },
            SExpr(x) -> {
              let o: Filled = fill_expr(f, acc.filler, x);
              { filler: o.filler, xs: push(acc.xs, SExpr(o.expr)) }
            },
          },
      );
      let tail: { filler: Filler, expr: Option<Expr> } = match b.tail {
        None -> { filler: stmts.filler, expr: None },
        Some(t) -> {
          let o: Filled = fill_expr(f, stmts.filler, t);
          { filler: o.filler, expr: Some(o.expr) }
        },
      };
      {
        filler: { ..tail.filler, scope: take(tail.filler.scope, mark) },
        expr: EBlock({ span: b.span, tail: tail.expr, stmts: stmts.xs }),
      }
    },
    ERecord(rec) -> {
      let o = fill_fields(f, filler, rec.fields);
      { filler: o.filler, expr: ERecord({ span: rec.span, fields: o.xs }) }
    },
    ERecordUpdate(rec) -> {
      let b = fill_expr(f, filler, rec.base);
      let o = fill_fields(f, b.filler, rec.fields);
      { filler: o.filler, expr: ERecordUpdate({ span: rec.span, base: b.expr, fields: o.xs }) }
    },
    EField(fl) -> {
      let o: Filled = fill_expr(f, filler, fl.base);
      { filler: o.filler, expr: EField({ span: fl.span, base: o.expr, field: fl.field }) }
    },
    EList(l) -> {
      let o = fill_exprs(f, filler, l.items);
      { filler: o.filler, expr: EList({ span: l.span, items: o.xs }) }
    },
    ETry(t) -> {
      let o: Filled = fill_expr(f, filler, t.operand);
      { filler: o.filler, expr: ETry({ span: t.span, operand: o.expr }) }
    },
    EPerform(p) -> {
      let o = fill_exprs(f, filler, p.args);
      {
        filler: o.filler,
        expr: EPerform({ span: p.span, eff: p.eff, op: p.op, resource: p.resource, args: o.xs }),
      }
    },
    EHandle(h) -> {
      let body: Filled = fill_expr(f, filler, h.body);
      let clauses: { filler: Filler, xs: List<HandleClause> } = fold(
        h.clauses,
        { filler: body.filler, xs: [] },
        |acc: { filler: Filler, xs: List<HandleClause> }, c: HandleClause| {
          let mark = len(acc.filler.scope);
          let with_params = fold(c.params, acc.filler.scope, |sc: List<Bytes>, p: Ident|
            push(sc, p.name));
          let with_label = match c.label_binder {
            None -> with_params,
            Some(t) -> push(with_params, t.name),
          };
          let with_resume = match c.resume {
            None -> with_label,
            Some(k) -> push(with_label, k.name),
          };
          let o: Filled = fill_expr(f, { ..acc.filler, scope: with_resume }, c.body);
          {
            filler: { ..o.filler, scope: take(o.filler.scope, mark) },
            xs: push(acc.xs, {
              eff: c.eff,
              op: c.op,
              resource: c.resource,
              every_label: c.every_label,
              label_binder: c.label_binder,
              resume: c.resume,
              body: o.expr,
              span: c.span,
              params: c.params,
            }),
          }
        },
      );
      let ret: { filler: Filler, expr: Option<ReturnClause> } = match h.ret {
        None -> { filler: clauses.filler, expr: None },
        Some(rc) -> {
          let mark = len(clauses.filler.scope);
          let o: Filled = fill_expr(
            f,
            { ..clauses.filler, scope: push(clauses.filler.scope, rc.binder.name) },
            rc.body,
          );
          {
            filler: { ..o.filler, scope: take(o.filler.scope, mark) },
            expr: Some({ binder: rc.binder, body: o.expr, span: rc.span }),
          }
        },
      };
      {
        filler: ret.filler,
        expr: EHandle({ span: h.span, body: body.expr, ret: ret.expr, clauses: clauses.xs }),
      }
    },
    EWithCell(c) -> {
      let init: Filled = fill_expr(f, filler, c.init);
      let mark = len(init.filler.scope);
      let o: Filled = fill_expr(
        f,
        { ..init.filler, scope: push(init.filler.scope, c.binder.name) },
        c.body,
      );
      {
        filler: { ..o.filler, scope: take(o.filler.scope, mark) },
        expr: EWithCell({
          span: c.span,
          resource: c.resource,
          init: init.expr,
          binder: c.binder,
          body: o.expr,
        }),
      }
    },
    ESimulate(s) -> {
      let o: Filled = fill_expr(f, filler, s.body);
      { filler: o.filler, expr: ESimulate({ span: s.span, body: o.expr }) }
    },
    ETryBlock(t) -> {
      let o: Filled = fill_expr(f, filler, t.body);
      { filler: o.filler, expr: ETryBlock({ ..t, body: o.expr }) }
    },
    EParallel(v) -> {
      let o = fill_exprs(f, filler, v.branches);
      { filler: o.filler, expr: EParallel({ span: v.span, branches: o.xs }) }
    },
  }

fn fill_exprs(
  f: Filling,
  filler: Filler,
  exprs: List<Expr>,
) -> { filler: Filler, xs: List<Expr> } / {abort.raise} =
  fold(exprs, { filler: filler, xs: [] }, |acc: { filler: Filler, xs: List<Expr> }, expr: Expr| {
    let o = fill_expr(f, acc.filler, expr);
    { filler: o.filler, xs: push(acc.xs, o.expr) }
  })

fn fill_fields(
  f: Filling,
  filler: Filler,
  fields: List<RecField>,
) -> { filler: Filler, xs: List<RecField> } / {abort.raise} =
  fold(
    fields,
    { filler: filler, xs: [] },
    |acc: { filler: Filler, xs: List<RecField> }, field: RecField| {
      let o = fill_expr(f, acc.filler, field.value);
      { filler: o.filler, xs: push(acc.xs, { name: field.name, value: o.expr }) }
    },
  )

fn signature_of(f: Filling, filler: Filler, func: Expr) -> Option<Signature> / {abort.raise} =
  match func {
    EVar(v) ->      // Constructors carry no defaults; a local binder shadows everything, making this a call through a value.
      if is_bare(v.name) && starts_upper(v.name.name.name) { None }
      else if is_bare(v.name) && contains(filler.scope, v.name.name.name) { None } else {
        match find(f.r, filler.module, ValueSpace, v.name) {
          Some(b) -> map_get(f.index, b.qualified),
          None -> if is_bare(v.name) { builtin_signature(v.name.name.name) } else { None },
        }
      },
    _ -> None,
  }

type Call = { span: Span, func: Expr, named: List<NamedArg>, args: List<Expr>, labels: List<Ident> }

fn fill(f: Filling, filler: Filler, call: Call) -> Filled / {abort.raise} =
  match signature_of(f, filler, call.func) {
    None -> {
      // No signature: a call through a value, a constructor or an unresolved name, so a named argument names no parameter.
      let diags = fold(call.named, filler.diags, |ds: List<Diag>, arg: NamedArg|
        push(
          ds,
          error_at(
            b"E0123",
            filler.module,
            arg.name.span,
            bytes_concat_all([b"`", arg.name.name, b"` names no parameter here"]),
            b"no signature to match this against",
            [
              b"a named argument needs a callee reached by name; a call through a value, a lambda or a constructor is positional",
            ],
          ),
        ));
      { filler: { ..filler, diags: diags }, expr: EApp({ ..call, named: [] }) }
    },
    Some(sig) ->      // Over-application is `E0202`'s to report, with the callee's own type in hand.
      if len(call.args) > len(sig.params) { { filler: filler, expr: EApp({ ..call, named: [] }) } }
      else { fill_slots(filler, call, sig) },
  }

fn fill_slots(filler: Filler, call: Call, signature: Signature) -> Filled / {abort.raise} = {
  let was_named = len(call.named) > 0;
  let filled_positionally = len(call.args);
  let start = map(range(0, len(signature.params)), |i: Int| list_at(call.args, i));
  let placed: { filler: Filler, slots: List<Option<Expr>> } = fold(
    call.named,
    { filler: filler, slots: start },
    |acc: { filler: Filler, slots: List<Option<Expr>> }, arg: NamedArg|
      match param_index(signature, arg.name.name) {
        None ->
          {
            ..acc,
            filler: {
              ..acc.filler,
              diags: push(
                acc.filler.diags,
                error_at(
                  b"E0123",
                  filler.module,
                  arg.name.span,
                  bytes_concat_all([b"`", arg.name.name, b"` names no parameter of this function"]),
                  b"not a parameter",
                  [
                    bytes_concat(
                      b"the parameters are ",
                      list_names(map(signature.params, |p: ParamInfo| p.name)),
                    ),
                  ],
                ),
              ),
            },
          },
        Some(i) -> match at(acc.slots, i) {
          Some(_) -> {
            let already = if i < filled_positionally { b"already filled by a positional argument" }
            else { b"already given by name" };
            {
              ..acc,
              filler: {
                ..acc.filler,
                diags: push(
                  acc.filler.diags,
                  error_at(
                    b"E0123",
                    filler.module,
                    arg.name.span,
                    bytes_concat_all([b"`", arg.name.name, b"` is ", already]),
                    b"given twice",
                    [],
                  ),
                ),
              },
            }
          },
          None -> { ..acc, slots: list_set(acc.slots, i, Some(arg.value)) },
        },
      },
  );
  let out: { filler: Filler, xs: List<Expr>, missing: List<Bytes> } = fold(
    range(0, len(signature.params)),
    { filler: placed.filler, xs: [], missing: [] },
    |acc: { filler: Filler, xs: List<Expr>, missing: List<Bytes> }, i: Int|
      match at(placed.slots, i) {
        Some(written) -> { ..acc, xs: push(acc.xs, written) },
        None -> {
          let p = at(signature.params, i);
          match p.default {
            None -> { ..acc, missing: push(acc.missing, p.name) },
            Some(d) -> {
              // The default may name something in its own module, which this one may never have imported.
              let implicit = fold(
                p.imports,
                acc.filler.implicit,
                |im: List<ModuleBinding>, binding: ModuleBinding|
                  match find_module_binding(im, binding.binder) {
                    Some(_) -> im,
                    None -> push(im, binding),
                  },
              );
              { ..acc, filler: { ..acc.filler, implicit: implicit }, xs: push(acc.xs, d) }
            },
          }
        },
      },
  );
  if len(out.missing) > 0 {
    // A call with no names in it that leaves a hole is under-applied, which is `E0202`'s.
    let cx2 = if was_named {
      {
        ..out.filler,
        diags: push(
          out.filler.diags,
          error_at(
            b"E0125",
            filler.module,
            call.span,
            bytes_concat_all([b"this call leaves ", list_names(out.missing), b" unfilled"]),
            b"no argument and no default",
            [b"pass it positionally, or by name as `<parameter>: <value>`"],
          ),
        ),
      }
    } else { out.filler };
    { filler: cx2, expr: EApp({ ..call, named: [] }) }
  } else { { filler: out.filler, expr: EApp({ ..call, args: out.xs, named: [] }) } }
}

fn param_index(signature: Signature, name: Bytes) -> Option<Int> / {abort.raise} =
  fold(range(0, len(signature.params)), None, |acc: Option<Int>, i: Int|
    match acc {
      Some(_) -> acc,
      None -> if at(signature.params, i).name == name { Some(i) } else { None },
    })

fn fill_item(
  f: Filling,
  filler: Filler,
  item: Item,
) -> { filler: Filler, it: Item } / {abort.raise} =
  match item {
    IFn(d) -> {
      let mark = len(filler.scope);
      let inner = {
        ..filler,
        scope: fold(d.params, filler.scope, |acc: List<Bytes>, param: Param|
          push(acc, param.name.name)),
      };
      // A default is not walked here: it was qualified against this module in `collect`.
      // A `cost` clause also reads the parameters' cost names.
      let costed = fold(d.params, inner.scope, |acc: List<Bytes>, param: Param|
        match param.cost { Some(k) -> push(acc, k.name), None -> acc });
      let spec: { filler: Filler, xs: List<SpecClause> } = fold(
        d.spec,
        { filler: inner, xs: [] },
        |acc: { filler: Filler, xs: List<SpecClause> }, clause: SpecClause| {
          let o = fill_expr(
            f,
            { ..acc.filler, scope: if clause.kind == SCost { costed } else { inner.scope } },
            clause.expr,
          );
          {
            filler: { ..o.filler, scope: inner.scope },
            xs: push(acc.xs, { kind: clause.kind, expr: o.expr, span: clause.span }),
          }
        },
      );
      let measured: { filler: Filler, expr: Option<Expr> } = match d.decreases {
        None -> { filler: spec.filler, expr: None },
        Some(e) -> {
          let o = fill_expr(f, spec.filler, e);
          { filler: o.filler, expr: Some(o.expr) }
        },
      };
      let body: Filled = fill_expr(f, measured.filler, d.body);
      {
        filler: { ..body.filler, scope: take(body.filler.scope, mark) },
        it: IFn({
          vis: d.vis,
          name: d.name,
          generics: d.generics,
          params: d.params,
          ret: d.ret,
          effects: d.effects,
          constraints: d.constraints,
          spec: spec.xs,
          returns: d.returns,
          reuse: d.reuse,
          transparent: d.transparent,
          baked: d.baked,
          decreases: measured.expr,
          body: body.expr,
          doc: d.doc,
          span: d.span,
        }),
      }
    },
    ITest(d) -> match d.cases {
      None -> {
        let o: Filled = fill_expr(f, filler, d.body);
        { filler: o.filler, it: ITest({ ..d, body: o.expr }) }
      },
      // The case's name is in scope in the label and the body, never in the table.
      Some(c) -> {
        let mark = len(filler.scope);
        let table: Filled = fill_expr(f, filler, c.table);
        let inner = { ..table.filler, scope: push(table.filler.scope, c.binder.name) };
        let label: Filled = fill_expr(f, inner, c.label);
        let body: Filled = fill_expr(f, label.filler, d.body);
        {
          filler: { ..body.filler, scope: take(body.filler.scope, mark) },
          it: ITest({
            ..d,
            cases: Some({ ..c, table: table.expr, label: label.expr }),
            body: body.expr,
          }),
        }
      },
    },
    ILaw(d) -> {
      let mark = len(filler.scope);
      let inner = {
        ..filler,
        scope: fold(d.binders, filler.scope, |acc: List<Bytes>, binder: Binder|
          push(acc, binder.name.name)),
      };
      let g = match d.guard {
        None -> { filler: inner, expr: None },
        Some(x) -> {
          let o: Filled = fill_expr(f, inner, x);
          { filler: o.filler, expr: Some(o.expr) }
        },
      };
      let body: Filled = fill_expr(f, g.filler, d.body);
      {
        filler: { ..body.filler, scope: take(body.filler.scope, mark) },
        it: ILaw({
          name: d.name,
          name_span: d.name_span,
          host: d.host,
          binders: d.binders,
          guard: g.expr,
          cost: d.cost,
          costs: d.costs,
          of: d.of,
          body: body.expr,
          span: d.span,
        }),
      }
    },
    _ -> { filler: filler, it: item },
  }

pub type Expanded = { r: Resolved, mods: List<ParsedModule>, diags: List<Diag> }

/// The signatures, then every module's calls, then the modules a spliced default made each one reference.
fn expand(r: Resolved, mods: List<ParsedModule>, diags: List<Diag>) -> Expanded / {abort.raise} = {
  let c = collect(r, mods);
  let r2 = fold(
    c.owner_imports,
    r,
    |acc: Resolved, oi: { module: Int, binder: Bytes, target: Int }|
      reach(acc, oi.module, oi.binder, oi.target),
  );
  // Indexed once: a list lookup per call is quadratic in the program. First writer wins.
  let f = {
    r: r2,
    index: fold(c.sigs, map_new(), |acc: Map<Bytes, Signature>, signature: Signature|
      match map_get(acc, signature.name) {
        Some(_) -> acc,
        None -> map_insert(acc, signature.name, signature),
      }),
  };
  let walked = fold(
    range(0, len(mods)),
    { r: r2, mods: [], diags: bytes_concat_diags(diags, c.diags) },
    |acc: Expanded, m: Int| {
      let mod: ParsedModule = at(mods, m);
      let items: { filler: Filler, xs: List<Item> } = fold(
        mod.module.items,
        { filler: { module: m, scope: [], implicit: [], diags: acc.diags }, xs: [] },
        |ia: { filler: Filler, xs: List<Item> }, item: Item| {
          let o = fill_item(f, ia.filler, item);
          { filler: o.filler, xs: push(ia.xs, o.it) }
        },
      );
      let reached = fold(items.filler.implicit, acc.r, |rr: Resolved, binding: ModuleBinding|
        reach(rr, m, binding.binder, binding.target));
      {
        r: reached,
        mods: push(acc.mods, {
          name: mod.name,
          module: { ..mod.module, items: items.xs },
          derived: mod.derived,
        }),
        diags: items.filler.diags,
      }
    },
  );
  walked
}

fn bytes_concat_diags(a: List<Diag>, b: List<Diag>) -> List<Diag> =
  fold(b, a, |acc: List<Diag>, diag: Diag| push(acc, diag))

// --- `resolve` ---------------------------------------------------------------------------

pub type ResolveOutcome = | ResolveSucceeded(Expanded) | ResolveFailed(List<Diag>)

pub fn resolve(sources: List<Source>) -> ResolveOutcome / {abort.raise} =
  resolve_modules(
    map(sources, |source: Source|
      { name: source.name, module: parse(source.src).node, derived: [] }),
  )

/// Over modules already parsed and, for the checker, already rewritten.
pub fn resolve_modules(mods: List<ParsedModule>) -> ResolveOutcome / {abort.raise} =
  resolve_with(mods, no_packages(mods), true)

/// The tables without the defaults pass, so the two can be timed apart.
pub fn resolve_tables(mods: List<ParsedModule>) -> ResolveOutcome / {abort.raise} =
  resolve_with(mods, no_packages(mods), false)

/// Resolution against a package closure: `module_packages[i]` is the package of module `i`, and
/// `shipped` marks the modules the toolchain ships, which any package may import.
pub fn resolve_packaged(
  mods: List<ParsedModule>,
  pkgs: List<PackageDeps>,
  module_packages: List<Int>,
  std: Int,
  compiler: Int,
  shipped: Int,
) -> ResolveOutcome / {abort.raise} =
  resolve_with(
    mods,
    {
      pkgs: pkgs,
      module_packages: module_packages,
      std: std,
      compiler: compiler,
      shipped: shipped,
    },
    true,
  )

fn resolve_with(
  mods: List<ParsedModule>,
  packages: { pkgs: List<PackageDeps>, module_packages: List<Int>, std: Int, compiler: Int, shipped: Int },
  defaults: Bool,
) -> ResolveOutcome / {abort.raise} = {
  let n = len(mods);
  // The index: the first module of each name; a second non-anonymous one is `E0105`.
  let indexed = fold(
    range(0, n),
    { names: [], diags: [] },
    |acc: { names: List<ModuleEntry>, diags: List<Diag> }, i: Int| {
      let name = at(mods, i).name;
      match index_of(acc.names, name) {
        None -> { ..acc, names: push(acc.names, { name: name, at: i }) },
        Some(_) -> if bytes_len(name) == 0 { acc } else {
          {
            ..acc,
            diags: push(
              acc.diags,
              error_at(
                b"E0105",
                i,
                dummy_span(),
                bytes_concat_all([b"two files claim the module name `", name, b"`"]),
                b"loaded a second time under this name",
                [b"one file is one module, and a module name is derived from its path"],
              ),
            ),
          }
        },
      }
    },
  );
  let declarations = map(mods, declarations_of);
  let declared = map(range(0, n), |i: Int| bindings_of(i, at(declarations, i)));
  let w = {
    mods: mods,
    names: indexed.names,
    declarations: declarations,
    declared: declared,
    pkgs: packages.pkgs,
    module_packages: packages.module_packages,
    std: packages.std,
    compiler: packages.compiler,
    shipped: packages.shipped,
  };
  let built = map(range(0, n), |i: Int| build_scope_reporting(w, i));
  let scopes = map(built, |builder: Builder| builder.scope);
  let edges = map(built, |builder: Builder| builder.edges);
  let diags1 = fold(built, indexed.diags, |acc: List<Diag>, builder: Builder|
    bytes_concat_diags(acc, builder.diags));
  let dfs = traverse(edges);
  let diags2 = fold(dfs.cycles, diags1, |acc: List<Diag>, cycle: Cycle|
    push(acc, cycle_diag(mods, cycle)));
  // Only with a consistent set of tables: expansion resolves names through them.
  if len(diags2) > 0 { ResolveFailed(diags2) } else {
    let r = {
      names: indexed.names,
      scopes: scopes,
      declarations: declarations,
      declared: declared,
      order: dfs.order,
      imports: map(edges, |es: List<{ from: Int, target: Int, span: Span }>|
        map(es, |e: { from: Int, target: Int, span: Span }| e.target)),
    };
    let made = instantiated(r, mods);
    let sets = expand_sets(made.r, made.mods);
    if len(made.diags) > 0 { ResolveFailed(made.diags) }
    else if len(sets.diags) > 0 { ResolveFailed(sets.diags) }
    else if !defaults { ResolveSucceeded({ r: sets.r, mods: sets.mods, diags: [] }) } else {
      let x = expand(sets.r, sets.mods, []);
      if len(x.diags) > 0 { ResolveFailed(x.diags) } else { ResolveSucceeded(x) }
    }
  }
}

fn build_scope_reporting(w: World, i: Int) -> Builder / {abort.raise} = {
  let m = at(w.mods, i);
  let start = {
    scope: { module: m.name, modules: [], selective: [], bound: at(w.declared, i) },
    local: at(w.declarations, i),
    imported: no_decls(),
    edges: [],
    diags: [],
  };
  fold(m.module.imports, start, |builder: Builder, decl: ImportDecl| {
    let t = target_or_report(w, i, builder, decl);
    match t.t { None -> t.b, Some(_) -> one_import(w, i, t.b, decl) }
  })
}

// --- The dump -------------------------------------------------------------------------------

fn dump_modbind(tag: Bytes, binding: ModuleBinding) -> Bytes =
  bytes_concat_all([
    tag,
    b";",
    binding.binder,
    b";",
    ascii_of_int(binding.target),
    b";",
    span_key(binding.span),
    b";",
  ])

fn dump_binding(tag: Bytes, binding: Binding) -> Bytes =
  bytes_concat_all([
    tag,
    b";",
    binding.name,
    b";",
    binding.qualified,
    b";",
    ascii_of_int(binding.owner),
    b";",
    span_key(binding.span),
    b";",
  ])

fn dump_scope(i: Int, scope: Scope) -> Bytes =
  bytes_concat_all([
    b"M;",
    ascii_of_int(i),
    b";",
    scope.module,
    b";",
    bytes_concat_all(map(scope.modules, |mb: ModuleBinding| dump_modbind(b"B", mb))),
    bytes_concat_all(map(scope.selective, |mb: ModuleBinding| dump_modbind(b"S", mb))),
    bytes_concat_all(map(scope.bound.values, |b: Binding| dump_binding(b"V", b))),
    bytes_concat_all(map(scope.bound.types, |b: Binding| dump_binding(b"T", b))),
    bytes_concat_all(map(scope.bound.effects, |b: Binding| dump_binding(b"E", b))),
    bytes_concat_all(map(scope.bound.sets, |b: Binding| dump_binding(b"R", b))),
  ])

fn dump_order(order: List<Int>) -> Bytes / {abort.raise} =
  bytes_concat_all([
    b"O;",
    fold(range(0, len(order)), b"", |acc: Bytes, i: Int|
      if i == 0 { ascii_of_int(at(order, i)) }
      else { bytes_concat_all([acc, b",", ascii_of_int(at(order, i))]) }),
    b";",
  ])

fn dump_label(label: Label) -> Bytes =
  bytes_concat_all([
    b"=",
    ascii_of_int(label.module),
    b":",
    ascii_of_int(label.start),
    b":",
    ascii_of_int(label.end),
    b":",
    if label.primary { b"1" } else { b"0" },
    b";",
  ])

fn dump_diag(diag: Diag) -> Bytes = {
  let primary = fold(diag.labels, None, |acc: Option<Label>, l: Label|
    match acc { Some(_) -> acc, None -> if l.primary { Some(l) } else { None } });
  let head = match primary {
    Some(l) ->
      bytes_concat_all([
        ascii_of_int(l.module),
        b":",
        ascii_of_int(l.start),
        b":",
        ascii_of_int(l.end),
      ]),
    None -> b"0:0:0",
  };
  bytes_concat_all([
    b"!",
    diag.code,
    b":",
    head,
    b":",
    ascii_of_int(len(diag.labels)),
    b":",
    ascii_of_int(diag.notes),
    b";",
    bytes_concat_all(map(diag.labels, dump_label)),
  ])
}

pub fn dump_diags(diags: List<Diag>) -> Bytes =
  bytes_concat_all([b"D;", ascii_of_int(len(diags)), b";", bytes_concat_all(map(diags, dump_diag))])

pub fn resolve_dump(sources: List<Source>) -> String / {abort.raise} = {
  let head = bytes_concat_all([b"R;", ascii_of_int(len(sources)), b";"]);
  let body = match resolve(sources) {
    ResolveFailed(ds) -> bytes_concat(b"X;", dump_diags(ds)),
    ResolveSucceeded(x) ->
      bytes_concat_all([
        bytes_concat_all(map(range(0, len(x.r.scopes)), |i: Int| dump_scope(i, at(x.r.scopes, i)))),
        dump_order(x.r.order),
        dump_diags([]),
        bytes_concat_all(
          map(range(0, len(x.mods)), |i: Int|
            bytes_concat_all([
              b"P;",
              ascii_of_int(i),
              b";",
              dump_module(at(x.mods, i).module),
              b"#0;",
            ])),
        ),
      ]),
  };
  string_of_bytes(bytes_concat(head, body))
}

/// Whether any of `diags` is an error. A program with a warning in it is still a program: the
/// emitter compiles it, the runtime runs it, and the warning is the reader's to act on.
pub fn has_error(diags: List<Diag>) -> Bool =
  fold(diags, false, |acc: Bool, diag: Diag| acc || diag.severity == b"error")

// --- Tests ------------------------------------------------------------------

test "a module name qualifies its declarations and binds its last segment" {
  assert_eq(default_binder(b"std.db"), b"db");
  assert_eq(default_binder(b"app"), b"app");
  assert_eq(qualify(b"store.orders", b"place"), b"store.orders.place");
  assert_eq(qualify(b"", b"place"), b"place")
}

test "a cycle is rotated so the smallest index leads, whichever root reached it" {
  assert_eq(canonical([2, 0, 1]), [0, 1, 2]);
  assert_eq(canonical([1, 2]), [1, 2]);
  assert_eq(canonical([]), [])
}

test "the traversal leaves a dependency-first order and names each cycle once" {
  let e: Edge = { from: 0, target: 0, span: dummy_span() };
  // 0 -> 1 -> 2, and 3 alone: 2 before 1 before 0, then 3.
  let acyclic = traverse([[{ ..e, from: 0, target: 1 }], [{ ..e, from: 1, target: 2 }], [], []]);
  assert_eq(acyclic.order, [2, 1, 0, 3]);
  assert_eq(len(acyclic.cycles), 0);
  // 0 -> 1 -> 0 is one cycle, closed by 1's import, however it is entered.
  let ring = traverse([[{ ..e, from: 0, target: 1 }], [{ ..e, from: 1, target: 0 }]]);
  assert_eq(len(ring.cycles), 1);
  assert_eq(at(ring.cycles, 0).closing.from, 1)
}

test "a default is a value, and may not name a parameter of its own signature" {
  let src = b"fn f(a: Int = 1, b: Int = g(1), c: Int = a) -> Int = 0";
  let m = parse(src).node;
  let f = match at(m.items, 0) { IFn(d) -> d, _ -> panic("a fn") };
  let names = map(f.params, |param: Param| param.name.name);
  let d = |i: Int| match at(f.params, i).default { Some(x) -> x, None -> panic("a default") };
  assert(is_default_expr(d(0)));
  assert(!is_default_expr(d(1)));
  assert_eq(mentions(d(2), names, [], []), [b"a"])
}

test "two modules resolve to the tables the reference builds" {
  let dump = resolve_dump([
    { name: b"base", src: b"pub fn one() -> Int = 1" },
    { name: b"app", src: b"import base (one)\nfn two() -> Int = one() + one()" },
  ]);
  assert(
    string_starts_with(
      dump,
      "R;2;M;0;base;V;one;base.one;0;7:10;M;1;app;S;base;0;7:11;V;two;app.two;1;21:24;V;one;base.one;0;13:16;O;0,1;D;0;",
    ),
  )
}

/// Each atom of the first `fn`'s written row in module `m`, as the expansion left it.
fn first_row(expanded: Expanded, m: Int) -> List<Bytes> / {abort.raise} = {
  let f = fold(at(expanded.mods, m).module.items, None, |acc: Option<FnDef>, item: Item|
    match acc { Some(_) -> acc, None -> match item { IFn(d) -> Some(d), _ -> None } });
  match f {
    None -> panic("the module writes a fn"),
    Some(d) -> match d.effects {
      None -> [],
      Some(r) ->
        map(r.atoms, |atom: AtomExpr|
          bytes_concat_all([
            match atom.eff.module { Some(b) -> bytes_concat(b.name, b"::"), None -> b"" },
            atom.eff.name.name,
            b".",
            match atom.op { Some(o) -> o.name, None -> mode_text(atom.mode) },
            match atom.resource { Some(l) -> bytes_concat_all([b"[", l.name, b"]"]), None -> b"" },
          ])),
    },
  }
}

fn resolved(sources: List<Source>) -> Expanded / {abort.raise} =
  match resolve(sources) {
    ResolveSucceeded(x) -> x,
    ResolveFailed(ds) -> panic(string_of_bytes(bytes_concat(b"refused: ", dump_diags(ds)))),
  }

fn refused_codes(sources: List<Source>) -> List<Bytes> / {abort.raise} =
  match resolve(sources) {
    ResolveSucceeded(_) -> [],
    ResolveFailed(ds) -> map(ds, |diag: Diag| diag.code),
  }

fn store_base() -> Bytes =
  b"pub effect store { read get[t](k: Int) -> Int }\npub effect set Reads = {store.read[orders], log.write}\nfn own() -> Int / {Reads} = 1\n"

test "a `pub` set is named by import or through its module, and means what it means where it was written" {
  let by_name = resolved([
    { name: b"base", src: store_base() },
    { name: b"app", src: b"import base (Reads)\nfn f() -> Int / {Reads} = 1" },
  ]);
  // The declaring module writes its own atoms; another reaches the effect's module itself.
  assert_eq(first_row(by_name, 0), [b"store.read[orders]", b"log.write"]);
  assert_eq(first_row(by_name, 1), [b"@base::store.read[orders]", b"log.write"]);
  assert(find_module_binding(at(by_name.r.scopes, 1).modules, b"@base") != None);
  let through = resolved([
    { name: b"base", src: store_base() },
    { name: b"app", src: b"import base\nfn f() -> Int / {base::Reads} = 1" },
  ]);
  assert_eq(first_row(through, 1), [b"@base::store.read[orders]", b"log.write"])
}

test "a set may include another module's, and a third module names the whole of it" {
  let x = resolved([
    { name: b"base", src: store_base() },
    { name: b"mid", src: b"import base (Reads)\npub effect set All = {Reads, clock.read}" },
    { name: b"app", src: b"import mid (All)\nfn f() -> Int / {All} = 1" },
  ]);
  assert_eq(first_row(x, 2), [b"@base::store.read[orders]", b"clock.read", b"log.write"])
}

test "a set is refused where it is named when nothing declares it, its module keeps it, or it names itself" {
  assert_eq(refused_codes([{ name: b"app", src: b"fn f() -> Int / {Nope} = 1" }]), [b"E0114"]);
  let hidden = b"effect set Hidden = {log.write}\n";
  assert_eq(
    refused_codes([
      { name: b"base", src: hidden },
      { name: b"app", src: b"import base\nfn f() -> Int / {base::Hidden} = 1" },
    ]),
    [b"E0107"],
  );
  assert_eq(
    refused_codes([
      { name: b"base", src: hidden },
      { name: b"app", src: b"import base (Hidden)\nfn f() -> Int = 1" },
    ]),
    [b"E0107"],
  );
  assert_eq(
    refused_codes([
      { name: b"app", src: b"effect set A = {B}\neffect set B = {A}\nfn f() -> Int / {A} = 1" },
    ]),
    [b"E0115"],
  );
  assert_eq(
    refused_codes([
      {
        name: b"app",
        src: b"effect set A = {log.write}\neffect set A = {clock.read}\nfn f() -> Int = 1",
      },
    ]),
    [b"E0105"],
  )
}

fn lib_and_app(lib: Bytes, app: Bytes) -> List<Source> =
  [{ name: b"lib", src: lib }, { name: b"app", src: app }]

test "a missing module, an import cycle and two modules of one name are refused" {
  assert_eq(
    refused_codes([
      { name: b"app", src: b"import nowhere\nimport std.nowhere\nfn f() -> Int = 1" },
    ]),
    [b"E0106", b"E0106"],
  );
  assert_eq(refused_codes([{ name: b"me", src: b"import me\nfn f() -> Int = 1" }]), [b"E0109"]);
  assert_eq(
    refused_codes([
      { name: b"a", src: b"import b\npub fn fa() -> Int = 1" },
      { name: b"b", src: b"import c\npub fn fb() -> Int = 1" },
      { name: b"c", src: b"import a\npub fn fc() -> Int = 1" },
    ]),
    [b"E0109"],
  );
  assert_eq(
    refused_codes([
      { name: b"twin", src: b"pub fn x() -> Int = 1" },
      { name: b"twin", src: b"pub fn y() -> Int = 2" },
    ]),
    [b"E0105"],
  )
}

test "an imported name is refused when its module keeps or lacks it, the importer declares it, or another import binds it" {
  assert_eq(
    refused_codes(
      lib_and_app(
        b"fn secret() -> Int = 1\npub fn shown() -> Int = 2",
        b"import lib (secret, shown, absent)\nfn f() -> Int = shown()",
      ),
    ),
    [b"E0107", b"E0101"],
  );
  assert_eq(
    refused_codes(
      lib_and_app(
        b"type Hidden = | H1 | H2\npub type Shown = | S1 | S2",
        b"import lib (H1, S1)\nfn f() -> Int = 1",
      ),
    ),
    [b"E0107"],
  );
  assert_eq(
    refused_codes(
      lib_and_app(
        b"pub fn place() -> Int = 1\npub type Order = { id: Int }",
        b"import lib (place, Order)\nfn place() -> Int = 2\ntype Order = { id: Bytes }\nfn f() -> Int = place()",
      ),
    ),
    [b"E0108", b"E0108"],
  );
  assert_eq(
    refused_codes(
      lib_and_app(
        b"pub fn a() -> Int = 1",
        b"import lib\nimport lib\nimport lib as lib\nfn f() -> Int = lib::a()",
      ),
    ),
    [b"E0110", b"E0110"],
  );
  assert_eq(
    refused_codes([
      { name: b"lib", src: b"pub fn a() -> Int = 1" },
      { name: b"other", src: b"pub fn a() -> Int = 2" },
      { name: b"app", src: b"import lib (a)\nimport other (a)\nfn f() -> Int = a()" },
    ]),
    [b"E0110"],
  )
}

test "an opaque sum's constructors stay with its module: the type is imported, and they are not" {
  let lib = b"pub opaque type Tok = | Mint(Int) | Tok\npub fn mint() -> Tok = Mint(1)\npub fn spent(t: Tok) -> Bool = match t { Tok -> true, Mint(_) -> false }";
  let named = match resolve(lib_and_app(lib, b"import lib (Mint)\nfn f() -> Int = 1")) {
    ResolveSucceeded(_) -> [],
    ResolveFailed(ds) -> ds,
  };
  assert_eq(map(named, |diag: Diag| { code: diag.code, notes: diag.notes_text }), [
    { code: b"E0107", notes: [b"`lib` answers one from `mint`", b"`lib` reads one with `spent`"] },
  ]);
  // The type's name is public, and one it shares with a constructor binds the type alone.
  match resolve(lib_and_app(lib, b"import lib (Tok, mint)\nfn f() -> Tok = mint()")) {
    ResolveSucceeded(x) -> {
      let bound = at(x.r.scopes, 1).bound;
      assert(lookup(bound, TypeSpace, b"Tok") != None);
      assert_eq(lookup(bound, ValueSpace, b"Tok"), None)
    },
    ResolveFailed(ds) -> panic("a public type is imported"),
  }
}

test "a module imported whole and by name resolves both ways, its type bringing the constructors" {
  assert_eq(
    refused_codes([
      {
        name: b"base",
        src: b"pub fn one() -> Int = 1\npub type Shape = | Circle(Int) | Square(Int)\npub effect log { write emit(Bytes) -> Unit }\nfn hidden() -> Int = 2",
      },
      {
        name: b"app",
        src: b"import base\nimport base (one, Shape, log)\nfn two() -> Int = one() + base::one()\nfn s(x: Shape) -> Int = match x { Circle(r) -> r, Square(w) -> w }",
      },
    ]),
    [],
  )
}

fn defaults_lib() -> Bytes =
  b"pub type Mode = | Fast | Slow\npub fn greet(name: Bytes = b\"world\", times: Int = 1) -> Bytes = name\npub fn run(m: Mode = Fast, n: Int = 0) -> Int = n\npub fn scale(v: Int, by: Int = 2) -> Int = v * by"

test "a call resolves with its parameters left to their defaults, and a local of a callee's name shadows it" {
  assert_eq(
    refused_codes(
      lib_and_app(
        defaults_lib(),
        b"import lib (greet, scale, run)\nfn a() -> Bytes = greet()\nfn b() -> Bytes = greet(b\"x\")\nfn c() -> Bytes = greet(times: 2)\nfn d() -> Bytes = greet(b\"x\", times: 2)\nfn e() -> Bytes = greet(times: 2, name: b\"y\")\nfn f() -> Int = scale(2)\nfn h() -> Int = run()\nfn i() -> Int = run(n: 4)\nfn j() -> Bool = assert(true)\nfn k() -> Int = { let greet = |x: Int| x; greet(1) }\nfn l() -> Int = { let run = 3; run }",
      ),
    ),
    [],
  )
}

test "a named argument is refused when it names no parameter or one twice, or leaves one unfilled" {
  assert_eq(
    refused_codes(
      lib_and_app(defaults_lib(), b"import lib (greet)\nfn e() -> Bytes = greet(nope: 1)"),
    ),
    [b"E0123"],
  );
  assert_eq(
    refused_codes(
      lib_and_app(
        defaults_lib(),
        b"import lib (greet)\nfn d() -> Bytes = greet(b\"x\", times: 2, name: b\"y\")",
      ),
    ),
    [b"E0123"],
  );
  assert_eq(
    refused_codes(lib_and_app(defaults_lib(), b"import lib (scale)\nfn g() -> Int = scale(by: 3)")),
    [b"E0125"],
  );
  assert_eq(
    refused_codes(
      lib_and_app(
        defaults_lib(),
        b"import lib (scale)\nfn h() -> Int = scale(2, 3, 4)\nfn k() -> Int = Some(x: 1)\nfn j() -> Int = { let scale = |x: Int| x; scale(x: 1) }",
      ),
    ),
    [b"E0123", b"E0123"],
  )
}

test "a default is refused when it calls, names a parameter, or names what its module keeps" {
  assert_eq(
    refused_codes(
      lib_and_app(
        b"pub fn f(n: Int = g(1)) -> Int = n\npub fn g(n: Int) -> Int = n",
        b"import lib (f)\nfn a() -> Int = f()",
      ),
    ),
    [b"E0121"],
  );
  assert_eq(
    refused_codes(
      lib_and_app(
        b"pub fn h(n: Int, m: Int = n) -> Int = m",
        b"import lib (h)\nfn b() -> Int = h(1)",
      ),
    ),
    [b"E0121"],
  );
  assert_eq(
    refused_codes(
      lib_and_app(
        b"fn helper() -> Int = 3\npub fn leaky(n: Int = helper) -> Int = n",
        b"import lib (leaky)\nfn a() -> Int = leaky()",
      ),
    ),
    [b"E0122"],
  )
}
