//! The numbers `hash` begins each stored node with, read off its own text, so none is taken twice.
//! A module of its own, which nothing imports: what a shipped module embeds is asked of its whole
//! text on every load that pulls it.

import exprs (ELit)
import items (Item, IFn, parse)
import patterns (LInt)
import std.bytes

/// A function that takes nothing and is named `tag_…`, with the number its body writes: none where
/// the body is anything but an integer literal.
type Tag = { name: Bytes, number: Option<Int> }

fn tags(src: Bytes) -> List<Tag> / {abort.raise} =
  fold(parse(src).node.items, [], |acc: List<Tag>, item: Item|
    match item {
      IFn(d) -> if len(d.params) > 0 || !bytes_starts_with(d.name.name, b"tag_") { acc } else {
        push(acc, {
          name: d.name.name,
          number: match d.body {
            ELit(l) -> match l.lit { LInt(n) -> Some(n), _ -> None },
            _ -> None,
          },
        })
      },
      _ -> acc,
    })

/// What keeps `found` from being one table of tags: each that writes no number, and each that takes
/// the number an earlier one took. A decoder tells nodes apart by peeking at what comes next, of
/// whatever kind, so no two may share one.
fn clashes(found: List<Tag>) -> List<Bytes> =
  fold(
    found,
    { taken: map_new(), said: [] },
    |acc: { taken: Map<Int, Bytes>, said: List<Bytes> }, t: Tag|
      match t.number {
        None ->
          {
            ..acc,
            said: push(acc.said, bytes_concat_all([b"`", t.name, b"` is not written as a number"])),
          },
        Some(n) -> match map_get(acc.taken, n) {
          Some(first) ->
            {
              ..acc,
              said: push(
                acc.said,
                bytes_concat_all([
                  b"`",
                  t.name,
                  b"` and `",
                  first,
                  b"` are both ",
                  bytes_of_string(int_to_string(n)),
                ]),
              ),
            },
          None -> { ..acc, taken: map_insert(acc.taken, n, t.name) },
        },
      },
  ).said

test "no two of the tags a stored node begins with share a number" {
  let found = tags(embed("hash.ply"));
  assert(
    len(found) > 0,
    Some("`hash` names its tags `tag_…`, each a function that takes nothing"),
  );
  let clashing = clashes(found);
  assert(len(clashing) == 0, Some(string_of_bytes_lossy(bytes::join(clashing, b"\n"))))
}

test "a tag that takes another's number, or writes none, is named" {
  let found = tags(
    b"fn tag_a() -> Int = 1\nfn tag_b() -> Int = 160\nfn tag_c() -> Int = 160\nfn tag_d() -> Int = tag_a() + 1\nfn tag_of(n: Int) -> Int = n\nfn other() -> Int = 160\n",
  );
  assert_eq(map(found, |t: Tag| t.name), [b"tag_a", b"tag_b", b"tag_c", b"tag_d"]);
  assert_eq(clashes(found), [
    b"`tag_c` and `tag_b` are both 160",
    b"`tag_d` is not written as a number",
  ])
}
