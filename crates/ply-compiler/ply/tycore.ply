// The type language, unification, the type environment and the type printer `infer.ply` checks with.

import types (Mode, MRead, MWrite, MBad)

// --- Atoms and rows ---------------------------------------------------------------

// `RVar` is a label a definition is generic over: the id is a type variable, bound to `label_type`.
pub type Resource = | RNamed(Bytes) | RSingleton | RVar(Int)

// `op: None` is the mode atom `effect.mode[resource]`; `Some` names one operation of that effect.
pub type Atom = { effect: Bytes, resource: Resource, mode: Mode, op: Option<Bytes> }

// `atoms` stays sorted by `atom_lt` and duplicate-free.
pub type Row = { atoms: List<Atom>, tail: Option<Int> }

pub fn bytes_lt(a: Bytes, b: Bytes) -> Bool = match compare(a, b) { Less -> true, _ -> false }

fn resource_lt(a: Resource, b: Resource) -> Bool =
  match a {
    RNamed(x) -> match b { RNamed(y) -> bytes_lt(x, y), RVar(_) -> true, RSingleton -> true },
    RVar(x) -> match b { RNamed(_) -> false, RVar(y) -> x < y, RSingleton -> true },
    RSingleton -> false,
  }

fn mode_rank(m: Mode) -> Int = match m { MRead -> 0, MWrite -> 1, MBad -> 2 }

fn op_lt(a: Option<Bytes>, b: Option<Bytes>) -> Bool =
  match a {
    None -> match b { Some(_) -> true, None -> false },
    Some(x) -> match b { Some(y) -> bytes_lt(x, y), None -> false },
  }

pub fn atom_lt(a: Atom, b: Atom) -> Bool =
  bytes_lt(a.effect, b.effect)
    || (a.effect == b.effect
    && (resource_lt(a.resource, b.resource)
    || (a.resource == b.resource
    && (mode_rank(a.mode) < mode_rank(b.mode)
    || (mode_rank(a.mode) == mode_rank(b.mode) && op_lt(a.op, b.op))))))

// The mode atom of an effect and resource covers every operation atom of the same mode.
pub fn atom_covers(a: Atom, b: Atom) -> Bool =
  a.effect == b.effect && a.resource == b.resource
    && (a == b || (match a.op { None -> mode_rank(a.mode) == mode_rank(b.mode), Some(_) -> false }))

pub fn atoms_covered(xs: List<Atom>, x: Atom) -> Bool =
  fold(xs, false, |acc: Bool, y: Atom| acc || atom_covers(y, x))

pub fn atom_conflicts(a: Atom, b: Atom) -> Bool =
  a.effect == b.effect && a.resource == b.resource
    && (mode_rank(a.mode) == 1 || mode_rank(b.mode) == 1)

// Keeps the list sorted and duplicate-free.
pub fn atoms_insert(xs: List<Atom>, x: Atom) -> List<Atom> = {
  let n = len(xs);
  let i = fold(range(0, n), n, |acc: Int, j: Int|
    if acc < n { acc } else if atom_lt(x, at(xs, j)) || at(xs, j) == x { j } else { acc });
  if i < n && at(xs, i) == x { xs } else { append(push(take(xs, i), x), drop(xs, i)) }
}

pub fn atoms_union(a: List<Atom>, b: List<Atom>) -> List<Atom> =
  fold(b, a, |acc: List<Atom>, x: Atom| atoms_insert(acc, x))

pub fn atoms_contains(xs: List<Atom>, x: Atom) -> Bool =
  fold(xs, false, |acc: Bool, y: Atom| acc || y == x)

pub fn atoms_difference(a: List<Atom>, b: List<Atom>) -> List<Atom> =
  filter(a, |x: Atom| !atoms_contains(b, x))

pub fn row_empty() -> Row = { atoms: [], tail: None }
pub fn row_open(v: Int) -> Row = { atoms: [], tail: Some(v) }
pub fn row_closed(atoms: List<Atom>) -> Row =
  { atoms: fold(atoms, [], |acc: List<Atom>, x: Atom| atoms_insert(acc, x)), tail: None }
pub fn row_singleton(a: Atom) -> Row = { atoms: [a], tail: None }
pub fn row_is_pure(r: Row) -> Bool =
  len(r.atoms) == 0 && (match r.tail { None -> true, Some(_) -> false })

pub fn row_union(a: Row, b: Row) -> Row =
  { atoms: atoms_union(a.atoms, b.atoms), tail: match a.tail { Some(_) -> a.tail, None -> b.tail } }

pub fn row_without(r: Row, removed: List<Atom>) -> Row =
  { atoms: atoms_difference(r.atoms, removed), tail: r.tail }

pub fn row_without_covered(r: Row, removed: List<Atom>) -> Row =
  { atoms: filter(r.atoms, |x: Atom| !atoms_covered(removed, x)), tail: r.tail }

// --- Types -------------------------------------------------------------------------

pub type Field = { name: Bytes, ty: Type }

pub type Type =
  | TyVar(Int)
  | TyCon({ name: Bytes, args: List<Type> })
  | TyFn({ params: List<Type>, ret: Type, effects: Row })
  // Sorted by field name.
  | TyRecord(List<Field>)

pub type Scheme = { ty_vars: List<Int>, row_vars: List<Int>, label_vars: List<Int>, ty: Type }

pub fn con(name: Bytes) -> Type = TyCon({ name: name, args: [] })
pub fn con1(name: Bytes, a: Type) -> Type = TyCon({ name: name, args: [a] })
pub fn t_int() -> Type = con(b"Int")
pub fn t_bool() -> Type = con(b"Bool")
pub fn t_string() -> Type = con(b"String")
pub fn t_bytes() -> Type = con(b"Bytes")
pub fn t_float() -> Type = con(b"Float")
pub fn t_decimal() -> Type = con(b"Decimal")
pub fn t_unit() -> Type = con(b"Unit")
pub fn t_list(a: Type) -> Type = con1(b"List", a)
pub fn t_option(a: Type) -> Type = con1(b"Option", a)
pub fn t_map(k: Type, v: Type) -> Type = TyCon({ name: b"Map", args: [k, v] })
pub fn t_iter(s: Type, r: Type) -> Type = TyCon({ name: b"Iter", args: [s, r] })
pub fn t_secret(a: Type) -> Type = con1(b"Secret", a)
pub fn t_fn(params: List<Type>, ret: Type, effects: Row) -> Type =
  TyFn({ params: params, ret: ret, effects: effects })
pub fn mono(t: Type) -> Scheme = { ty_vars: [], row_vars: [], label_vars: [], ty: t }

pub fn fields_sorted(fs: List<Field>) -> List<Field> =
  fold(fs, [], |acc: List<Field>, f: Field| field_insert(acc, f))

// A later field of the same name replaces the earlier one.
fn field_insert(sorted: List<Field>, f: Field) -> List<Field> = {
  let n = len(sorted);
  let i = fold(range(0, n), n, |acc: Int, j: Int|
    if acc < n { acc } else if !bytes_lt(at(sorted, j).name, f.name) { j } else { acc });
  if i < n && at(sorted, i).name == f.name { set_at(sorted, i, f) }
  else { append(push(take(sorted, i), f), drop(sorted, i)) }
}

pub fn field_get(fs: List<Field>, name: Bytes) -> Option<Type> =
  fold(fs, None, |acc: Option<Type>, f: Field|
    match acc { Some(_) -> acc, None -> if f.name == name { Some(f.ty) } else { None } })

pub fn mentions_secret(t: Type) -> Bool =
  match t {
    TyCon(c) ->
      c.name == b"Secret" || fold(c.args, false, |acc: Bool, a: Type| acc || mentions_secret(a)),
    TyFn(f) ->
      fold(f.params, false, |acc: Bool, p: Type| acc || mentions_secret(p))
        || mentions_secret(f.ret),
    TyRecord(fs) -> fold(fs, false, |acc: Bool, f: Field| acc || mentions_secret(f.ty)),
    TyVar(_) -> false,
  }

// Two or more fields named exactly `_0`, `_1`, ... with none missing.
pub fn tuple_arity(fs: List<Field>) -> Option<Int> = {
  let n = len(fs);
  if n < 2 { None } else {
    let all = fold(range(0, n), true, |acc: Bool, i: Int|
      acc
        && (match field_get(fs, bytes_concat(b"_", bytes_of_string(int_to_string(i)))) {
          Some(_) -> true,
          None -> false,
        }));
    if all { Some(n) } else { None }
  }
}

// --- Small list helpers ---------------------------------------------------------------

pub fn at<a>(xs: List<a>, i: Int) -> a =
  match list_at(xs, i) { Some(x) -> x, None -> panic("an index the checker does not hold") }

pub fn set_at<a>(xs: List<a>, i: Int, v: a) -> List<a> = list_set(xs, i, v)

pub fn take<a>(xs: List<a>, n: Int) -> List<a> = map(range(0, n), |i: Int| at(xs, i))

pub fn drop<a>(xs: List<a>, n: Int) -> List<a> = map(range(n, len(xs)), |i: Int| at(xs, i))

pub fn append<a>(a: List<a>, b: List<a>) -> List<a> = fold(b, a, |acc: List<a>, x: a| push(acc, x))

pub fn contains_int(xs: List<Int>, v: Int) -> Bool =
  fold(xs, false, |acc: Bool, x: Int| acc || x == v)

pub fn contains_bytes(xs: List<Bytes>, v: Bytes) -> Bool =
  fold(xs, false, |acc: Bool, x: Bytes| acc || x == v)

pub fn ints_insert(xs: List<Int>, v: Int) -> List<Int> = {
  let n = len(xs);
  let i = fold(range(0, n), n, |acc: Int, j: Int|
    if acc < n { acc } else if at(xs, j) >= v { j } else { acc });
  if i < n && at(xs, i) == v { xs } else { append(push(take(xs, i), v), drop(xs, i)) }
}

pub fn ints_union(a: List<Int>, b: List<Int>) -> List<Int> =
  fold(b, a, |acc: List<Int>, v: Int| ints_insert(acc, v))

pub fn ints_difference(a: List<Int>, b: List<Int>) -> List<Int> =
  filter(a, |v: Int| !contains_int(b, v))

// --- Fresh variables and the substitution -----------------------------------------------

pub type Fresh = { next_ty: Int, next_row: Int }

pub fn fresh_new() -> Fresh = { next_ty: 0, next_row: 0 }

pub fn fresh_ty_var(f: Fresh) -> { f: Fresh, v: Int } =
  { f: { next_ty: f.next_ty + 1, next_row: f.next_row }, v: f.next_ty }
pub fn fresh_ty(f: Fresh) -> { f: Fresh, t: Type } = {
  let o = fresh_ty_var(f);
  { f: o.f, t: TyVar(o.v) }
}
pub fn fresh_row_var(f: Fresh) -> { f: Fresh, v: Int } =
  { f: { next_ty: f.next_ty, next_row: f.next_row + 1 }, v: f.next_row }
pub fn fresh_row(f: Fresh) -> { f: Fresh, r: Row } = {
  let o = fresh_row_var(f);
  { f: o.f, r: row_open(o.v) }
}

pub type Subst = {
  ty: Map<Int, Type>,
  row: Map<Int, Row>,
  rigid_ty: Map<Int, Bool>,
  rigid_row: Map<Int, Bool>,
}

pub fn subst_new() -> Subst =
  { ty: map_new(), row: map_new(), rigid_ty: map_new(), rigid_row: map_new() }

pub fn mark_rigid_ty(s: Subst, v: Int) -> Subst =
  { ty: s.ty, row: s.row, rigid_ty: map_insert(s.rigid_ty, v, true), rigid_row: s.rigid_row }
pub fn mark_rigid_row(s: Subst, v: Int) -> Subst =
  { ty: s.ty, row: s.row, rigid_ty: s.rigid_ty, rigid_row: map_insert(s.rigid_row, v, true) }
pub fn is_rigid_ty(s: Subst, v: Int) -> Bool = map_contains(s.rigid_ty, v)
pub fn is_rigid_row(s: Subst, v: Int) -> Bool = map_contains(s.rigid_row, v)

// The budget cannot run out: bindings never form a cycle, so a chain is at most `map_len(s.ty)` long.
pub fn shallow(s: Subst, t: Type) -> Type =
  iterate(t, map_len(s.ty) + 2, |cur: Type|
    match cur {
      TyVar(v) -> match map_get(s.ty, v) { Some(next) -> Continue(next), None -> Stop(cur) },
      _ -> Stop(cur),
    })

pub fn resolve_ty(s: Subst, t: Type) -> Type =
  match shallow(s, t) {
    TyVar(v) -> TyVar(v),
    TyCon(c) -> TyCon({ name: c.name, args: map(c.args, |a: Type| resolve_ty(s, a)) }),
    TyFn(f) ->
      TyFn({
        params: map(f.params, |p: Type| resolve_ty(s, p)),
        ret: resolve_ty(s, f.ret),
        effects: resolve_row(s, f.effects),
      }),
    TyRecord(fs) -> TyRecord(map(fs, |f: Field| { name: f.name, ty: resolve_ty(s, f.ty) })),
  }

pub fn resolved_tail(s: Subst, r: Row) -> Option<Int> = {
  let bound = map_len(s.row);
  iterate({ tail: r.tail, hops: 0 }, bound + 2, |st: { tail: Option<Int>, hops: Int }|
    match st.tail {
      None -> Stop(None),
      Some(v) -> match map_get(s.row, v) {
        Some(next) -> if next.tail == Some(v) { Stop(Some(v)) }
        else if st.hops + 1 > bound { Stop(next.tail) }
        else { Continue({ tail: next.tail, hops: st.hops + 1 }) },
        None -> Stop(Some(v)),
      },
    })
}

// A label variable bound since the atom was built may now name the same resource as another atom,
// so the atoms are rebuilt through `atoms_insert` rather than kept.
pub fn resolve_row(s: Subst, r: Row) -> Row = {
  let bound = map_len(s.row);
  let walked = iterate(
    { atoms: r.atoms, tail: r.tail, seen: [] },
    bound + 2,
    |st: { atoms: List<Atom>, tail: Option<Int>, seen: List<Int> }|
      match st.tail {
        None -> Stop({ atoms: st.atoms, tail: None }),
        Some(v) -> if contains_int(st.seen, v) { Stop({ atoms: st.atoms, tail: st.tail }) } else {
          match map_get(s.row, v) {
            Some(next) ->
              Continue({
                atoms: atoms_union(st.atoms, next.atoms),
                tail: next.tail,
                seen: push(st.seen, v),
              }),
            None -> Stop({ atoms: st.atoms, tail: st.tail }),
          }
        },
      },
  );
  if !fold(walked.atoms, false, |acc: Bool, a: Atom|
      acc || (match a.resource { RVar(_) -> true, _ -> false })) { walked } else {
    {
      atoms: fold(walked.atoms, [], |acc: List<Atom>, a: Atom|
        atoms_insert(acc, resolve_atom(s, a))),
      tail: walked.tail,
    }
  }
}

// The label prefix marks the nullary constructor a bound label variable stands for, as regions do.
pub fn label_prefix() -> Bytes = b"#label:"

pub fn label_type(name: Bytes) -> Type = con(bytes_concat(label_prefix(), name))

pub fn label_of(t: Type) -> Option<Bytes> =
  match t {
    TyCon(c) -> if len(c.args) == 0 && bytes_starts_with(c.name, label_prefix()) {
      Some(bytes_slice(c.name, bytes_len(label_prefix()), bytes_len(c.name)))
    } else { None },
    _ -> None,
  }

pub fn resolve_atom(s: Subst, a: Atom) -> Atom =
  match a.resource {
    RVar(v) ->
      { effect: a.effect, resource: resource_of(shallow(s, TyVar(v)), v), mode: a.mode, op: a.op },
    _ -> a,
  }

fn resource_of(t: Type, v: Int) -> Resource =
  match label_of(t) { Some(n) -> RNamed(n), None -> match t { TyVar(w) -> RVar(w), _ -> RVar(v) } }

pub fn occurs_ty(v: Int, t: Type) -> Bool =
  match t {
    TyVar(w) -> w == v,
    TyCon(c) -> fold(c.args, false, |acc: Bool, a: Type| acc || occurs_ty(v, a)),
    TyFn(f) ->
      fold(f.params, false, |acc: Bool, p: Type| acc || occurs_ty(v, p)) || occurs_ty(v, f.ret),
    TyRecord(fs) -> fold(fs, false, |acc: Bool, f: Field| acc || occurs_ty(v, f.ty)),
  }

pub type UnifyError =
  | Mismatch({ expected: Type, found: Type })
  | Arity({ expected: Int, found: Int })
  | OccursTy({ v: Int, ty: Type })
  | OccursRow({ v: Int, row: Row })
  | RowMismatch({ expected: Row, found: Row })

pub type Unified = { s: Subst, f: Fresh, err: Option<UnifyError> }

fn ok(s: Subst, f: Fresh) -> Unified = { s: s, f: f, err: None }
fn failed(s: Subst, f: Fresh, e: UnifyError) -> Unified = { s: s, f: f, err: Some(e) }

fn bind_ty(s: Subst, f: Fresh, v: Int, t: Type) -> Unified = {
  let r = resolve_ty(s, t);
  if r == TyVar(v) { ok(s, f) }
  else if occurs_ty(v, r) { failed(s, f, OccursTy({ v: v, ty: r })) } else {
    ok({ ty: map_insert(s.ty, v, r), row: s.row, rigid_ty: s.rigid_ty, rigid_row: s.rigid_row }, f)
  }
}

fn bind_row(s: Subst, f: Fresh, v: Int, r: Row) -> Unified =
  if len(r.atoms) == 0 && r.tail == Some(v) { ok(s, f) }
  else if r.tail == Some(v) { failed(s, f, OccursRow({ v: v, row: r })) } else {
    ok({ ty: s.ty, row: map_insert(s.row, v, r), rigid_ty: s.rigid_ty, rigid_row: s.rigid_row }, f)
  }

pub fn solve_continuation_row(s: Subst, v: Int, row: Row) -> Subst =
  if map_contains(s.row, v) { s } else {
    let solved = resolve_row(s, row);
    let closed = if solved.tail == Some(v) { { atoms: solved.atoms, tail: None } } else { solved };
    { ty: s.ty, row: map_insert(s.row, v, closed), rigid_ty: s.rigid_ty, rigid_row: s.rigid_row }
  }

pub type Free = { tys: List<Int>, rows: List<Int> }

pub fn free_vars(s: Subst, t: Type, acc: Free) -> Free =
  match shallow(s, t) {
    TyVar(v) -> { tys: ints_insert(acc.tys, v), rows: acc.rows },
    TyCon(c) -> fold(c.args, acc, |a: Free, x: Type| free_vars(s, x, a)),
    TyFn(fn_) -> {
      let ps = fold(fn_.params, acc, |a: Free, x: Type| free_vars(s, x, a));
      let r = free_vars(s, fn_.ret, ps);
      let row = resolve_row(s, fn_.effects);
      let ls = fold(row.atoms, r, |a: Free, x: Atom|
        match x.resource { RVar(v) -> { tys: ints_insert(a.tys, v), rows: a.rows }, _ -> a });
      match row.tail { Some(v) -> { tys: ls.tys, rows: ints_insert(ls.rows, v) }, None -> ls }
    },
    TyRecord(fs) -> fold(fs, acc, |a: Free, f: Field| free_vars(s, f.ty, a)),
  }

pub fn unify(s: Subst, f: Fresh, expected: Type, found: Type) -> Unified = {
  let a = shallow(s, expected);
  let b = shallow(s, found);
  match a {
    TyVar(x) -> match b {
      TyVar(y) -> if x == y { ok(s, f) }
      else if !is_rigid_ty(s, x) { bind_ty(s, f, x, b) }
      else if !is_rigid_ty(s, y) { bind_ty(s, f, y, a) }
      else { failed(s, f, Mismatch({ expected: a, found: b })) },
      _ -> if !is_rigid_ty(s, x) { bind_ty(s, f, x, b) }
      else { failed(s, f, Mismatch({ expected: a, found: b })) },
    },
    _ -> match b {
      TyVar(y) -> if !is_rigid_ty(s, y) { bind_ty(s, f, y, a) }
      else { failed(s, f, Mismatch({ expected: a, found: b })) },
      _ -> unify_structural(s, f, a, b),
    },
  }
}

fn unify_structural(s: Subst, f: Fresh, a: Type, b: Type) -> Unified =
  match a {
    TyCon(c1) -> match b {
      TyCon(c2) -> if c1.name != c2.name || len(c1.args) != len(c2.args) {
        failed(s, f, Mismatch({ expected: a, found: b }))
      } else { unify_all(s, f, c1.args, c2.args) },
      _ -> failed(s, f, Mismatch({ expected: a, found: b })),
    },
    TyFn(f1) -> match b {
      TyFn(f2) -> if len(f1.params) != len(f2.params) {
        failed(s, f, Arity({ expected: len(f1.params), found: len(f2.params) }))
      } else {
        let ps = unify_all(s, f, f1.params, f2.params);
        match ps.err {
          Some(_) -> ps,
          None -> {
            let r = unify(ps.s, ps.f, f1.ret, f2.ret);
            match r.err { Some(_) -> r, None -> unify_row(r.s, r.f, f1.effects, f2.effects) }
          },
        }
      },
      _ -> failed(s, f, Mismatch({ expected: a, found: b })),
    },
    TyRecord(fs1) -> match b {
      TyRecord(fs2) -> if len(fs1) != len(fs2)
          || map(fs1, |x: Field| x.name) != map(fs2, |x: Field| x.name) {
        failed(s, f, Mismatch({ expected: a, found: b }))
      } else { unify_all(s, f, map(fs1, |x: Field| x.ty), map(fs2, |x: Field| x.ty)) },
      _ -> failed(s, f, Mismatch({ expected: a, found: b })),
    },
    TyVar(_) -> failed(s, f, Mismatch({ expected: a, found: b })),
  }

fn unify_all(s: Subst, f: Fresh, xs: List<Type>, ys: List<Type>) -> Unified =
  fold(range(0, len(xs)), ok(s, f), |acc: Unified, i: Int|
    match acc.err { Some(_) -> acc, None -> unify(acc.s, acc.f, at(xs, i), at(ys, i)) })

// A free label variable takes the resource the other row names for the same operation, so a
// caller's concrete label reaches a callee's generic one through an argument's row.
fn bind_labels(s: Subst, xs: List<Atom>, ys: List<Atom>) -> Subst =
  fold(xs, s, |acc: Subst, x: Atom| {
    let a = resolve_atom(acc, x);
    match a.resource {
      RVar(v) -> if is_rigid_ty(acc, v) { acc } else {
        match partner(acc, ys, a, v) {
          None -> acc,
          Some(t) ->
            {
              ty: map_insert(acc.ty, v, t),
              row: acc.row,
              rigid_ty: acc.rigid_ty,
              rigid_row: acc.rigid_row,
            },
        }
      },
      _ -> acc,
    }
  })

fn partner(s: Subst, ys: List<Atom>, x: Atom, v: Int) -> Option<Type> =
  fold(ys, None, |acc: Option<Type>, y: Atom|
    match acc {
      Some(_) -> acc,
      None -> {
        let b = resolve_atom(s, y);
        if b.effect == x.effect && mode_rank(b.mode) == mode_rank(x.mode) && b.op == x.op {
          match b.resource {
            RNamed(n) -> Some(label_type(n)),
            RVar(w) -> if w == v { None } else { Some(TyVar(w)) },
            RSingleton -> None,
          }
        } else { None }
      },
    })

pub fn unify_row(s0: Subst, f: Fresh, expected: Row, found: Row) -> Unified = {
  let x = resolve_row(s0, expected);
  let y = resolve_row(s0, found);
  let s = bind_labels(bind_labels(s0, x.atoms, y.atoms), y.atoms, x.atoms);
  let moved = map_len(s.ty) != map_len(s0.ty);
  let a = if moved { resolve_row(s, x) } else { x };
  let b = if moved { resolve_row(s, y) } else { y };
  let only_a = atoms_difference(a.atoms, b.atoms);
  let only_b = atoms_difference(b.atoms, a.atoms);
  let bad = RowMismatch({ expected: a, found: b });
  match a.tail {
    None -> match b.tail {
      None -> if len(only_a) == 0 && len(only_b) == 0 { ok(s, f) } else { failed(s, f, bad) },
      Some(v) -> if len(only_b) > 0 || is_rigid_row(s, v) { failed(s, f, bad) }
      else { bind_row(s, f, v, row_closed(only_a)) },
    },
    Some(v1) -> match b.tail {
      None -> if len(only_a) > 0 || is_rigid_row(s, v1) { failed(s, f, bad) }
      else { bind_row(s, f, v1, row_closed(only_b)) },
      Some(v2) -> if v1 == v2 {
        if len(only_a) == 0 && len(only_b) == 0 { ok(s, f) }
        else if is_rigid_row(s, v1) { failed(s, f, bad) } else {
          let nv = fresh_row_var(f);
          bind_row(s, nv.f, v1, { atoms: atoms_union(only_a, only_b), tail: Some(nv.v) })
        }
      } else {
        let r1 = is_rigid_row(s, v1);
        let r2 = is_rigid_row(s, v2);
        if r1 && r2 { failed(s, f, bad) } else if r1 {
          if len(only_b) > 0 { failed(s, f, bad) }
          else { bind_row(s, f, v2, { atoms: only_a, tail: Some(v1) }) }
        } else if r2 {
          if len(only_a) > 0 { failed(s, f, bad) }
          else { bind_row(s, f, v1, { atoms: only_b, tail: Some(v2) }) }
        } else {
          let nv = fresh_row_var(f);
          let first = bind_row(s, nv.f, v1, { atoms: only_b, tail: Some(nv.v) });
          match first.err {
            Some(_) -> first,
            None -> bind_row(first.s, first.f, v2, { atoms: only_a, tail: Some(nv.v) }),
          }
        }
      },
    },
  }
}

// --- The environment ----------------------------------------------------------------------

pub type Scope = { schemes: Map<Bytes, Scheme>, open: List<Bytes> }
pub type TypeEnv = { scopes: List<Scope> }

pub fn env_new() -> TypeEnv = { scopes: [{ schemes: map_new(), open: [] }] }
pub fn env_push(e: TypeEnv) -> TypeEnv =
  { scopes: push(e.scopes, { schemes: map_new(), open: [] }) }
pub fn env_pop(e: TypeEnv) -> TypeEnv =
  if len(e.scopes) > 1 { { scopes: take(e.scopes, len(e.scopes) - 1) } } else { e }

pub fn env_bind(e: TypeEnv, name: Bytes, sc: Scheme) -> TypeEnv = {
  let last = len(e.scopes) - 1;
  let s = at(e.scopes, last);
  {
    scopes: set_at(e.scopes, last, {
      schemes: map_insert(s.schemes, name, sc),
      open: push(s.open, name),
    }),
  }
}

pub fn env_bind_global(e: TypeEnv, name: Bytes, sc: Scheme) -> TypeEnv = {
  let s = at(e.scopes, 0);
  {
    scopes: set_at(e.scopes, 0, {
      schemes: map_insert(s.schemes, name, sc),
      open: push(s.open, name),
    }),
  }
}

pub fn env_remove_global(e: TypeEnv, name: Bytes) -> TypeEnv = {
  let s = at(e.scopes, 0);
  {
    scopes: set_at(e.scopes, 0, {
      schemes: map_remove(s.schemes, name),
      open: filter(s.open, |n: Bytes| n != name),
    }),
  }
}

pub fn env_lookup(e: TypeEnv, name: Bytes) -> Option<Scheme> =
  fold(e.scopes, None, |acc: Option<Scheme>, s: Scope|
    match map_get(s.schemes, name) { Some(x) -> Some(x), None -> acc })

// The innermost scope holding `name`, as a depth; `0` is the globals.
pub fn env_depth_of(e: TypeEnv, name: Bytes) -> Option<Int> =
  fold(range(0, len(e.scopes)), None, |acc: Option<Int>, i: Int|
    if map_contains(at(e.scopes, i).schemes, name) { Some(i) } else { acc })

pub fn env_locals(e: TypeEnv) -> List<{ name: Bytes, sc: Scheme }> =
  fold(drop(e.scopes, 1), [], |acc: List<{ name: Bytes, sc: Scheme }>, s: Scope|
    map_fold(s.schemes, acc, |a: List<{ name: Bytes, sc: Scheme }>, k: Bytes, v: Scheme|
      push(a, { name: k, sc: v })))

fn scheme_free(s: Subst, sc: Scheme) -> Free = {
  let fv = free_vars(s, sc.ty, { tys: [], rows: [] });
  {
    tys: ints_difference(ints_difference(fv.tys, sc.ty_vars), sc.label_vars),
    rows: ints_difference(fv.rows, sc.row_vars),
  }
}

// Also closes every binding that reaches no free variable.
pub fn env_free_vars(s: Subst, e: TypeEnv) -> { e: TypeEnv, free: Free } = {
  let walked = fold(
    e.scopes,
    { scopes: [], free: { tys: [], rows: [] } },
    |acc: { scopes: List<Scope>, free: Free }, sc: Scope| {
      let kept = fold(
        sc.open,
        { open: [], free: acc.free },
        |a: { open: List<Bytes>, free: Free }, name: Bytes|
          match map_get(sc.schemes, name) {
            None -> a,
            Some(scheme) -> {
              let fv = scheme_free(s, scheme);
              if len(fv.tys) == 0 && len(fv.rows) == 0 { a } else {
                {
                  open: push(a.open, name),
                  free: {
                    tys: ints_union(a.free.tys, fv.tys),
                    rows: ints_union(a.free.rows, fv.rows),
                  },
                }
              }
            },
          },
      );
      { scopes: push(acc.scopes, { schemes: sc.schemes, open: kept.open }), free: kept.free }
    },
  );
  { e: { scopes: walked.scopes }, free: walked.free }
}

fn rename(t: Type, tys: Map<Int, Type>, rows: Map<Int, Int>) -> Type =
  match t {
    TyVar(v) -> match map_get(tys, v) { Some(x) -> x, None -> t },
    TyCon(c) -> TyCon({ name: c.name, args: map(c.args, |a: Type| rename(a, tys, rows)) }),
    TyFn(f) ->
      TyFn({
        params: map(f.params, |p: Type| rename(p, tys, rows)),
        ret: rename(f.ret, tys, rows),
        effects: {
          atoms: fold(f.effects.atoms, [], |acc: List<Atom>, a: Atom|
            atoms_insert(acc, rename_atom(a, tys))),
          tail: match f.effects.tail {
            None -> None,
            Some(v) -> Some(match map_get(rows, v) { Some(w) -> w, None -> v }),
          },
        },
      }),
    TyRecord(fs) -> TyRecord(map(fs, |x: Field| { name: x.name, ty: rename(x.ty, tys, rows) })),
  }

fn rename_atom(a: Atom, tys: Map<Int, Type>) -> Atom =
  match a.resource {
    RVar(v) -> match map_get(tys, v) {
      Some(t) -> { effect: a.effect, resource: resource_of(t, v), mode: a.mode, op: a.op },
      None -> a,
    },
    _ -> a,
  }

// `labels` are the fresh variables the scheme's label parameters became, in declaration order.
pub type Instantiated = { f: Fresh, ty: Type, args: List<Type>, labels: List<Type> }

pub fn instantiate_with(sc: Scheme, f: Fresh) -> Instantiated =
  if len(sc.ty_vars) == 0 && len(sc.row_vars) == 0 && len(sc.label_vars) == 0 {
    { f: f, ty: sc.ty, args: [], labels: [] }
  } else {
    let tys = fold(
      sc.ty_vars,
      { f: f, m: map_new(), args: [] },
      |acc: { f: Fresh, m: Map<Int, Type>, args: List<Type> }, v: Int| {
        let o = fresh_ty(acc.f);
        { f: o.f, m: map_insert(acc.m, v, o.t), args: push(acc.args, o.t) }
      },
    );
    let labels = fold(
      sc.label_vars,
      { f: tys.f, m: tys.m, args: [] },
      |acc: { f: Fresh, m: Map<Int, Type>, args: List<Type> }, v: Int| {
        let o = fresh_ty(acc.f);
        { f: o.f, m: map_insert(acc.m, v, o.t), args: push(acc.args, o.t) }
      },
    );
    let rows = fold(
      sc.row_vars,
      { f: labels.f, m: map_new() },
      |acc: { f: Fresh, m: Map<Int, Int> }, v: Int| {
        let o = fresh_row_var(acc.f);
        { f: o.f, m: map_insert(acc.m, v, o.v) }
      },
    );
    { f: rows.f, ty: rename(sc.ty, labels.m, rows.m), args: tys.args, labels: labels.args }
  }

pub fn instantiate(sc: Scheme, f: Fresh) -> { f: Fresh, ty: Type } = {
  let o = instantiate_with(sc, f);
  { f: o.f, ty: o.ty }
}

pub fn rename_scheme(
  sc: Scheme,
  ty_vars: List<Int>,
  row_vars: List<Int>,
  label_vars: List<Int>,
) -> Type = {
  let tys = fold(range(0, len(sc.ty_vars)), map_new(), |m: Map<Int, Type>, i: Int|
    map_insert(m, at(sc.ty_vars, i), TyVar(at(ty_vars, i))));
  let both = fold(range(0, len(sc.label_vars)), tys, |m: Map<Int, Type>, i: Int|
    map_insert(m, at(sc.label_vars, i), TyVar(at(label_vars, i))));
  let rows = fold(range(0, len(sc.row_vars)), map_new(), |m: Map<Int, Int>, i: Int|
    map_insert(m, at(sc.row_vars, i), at(row_vars, i)));
  rename(sc.ty, both, rows)
}

pub fn generalize(s: Subst, e: TypeEnv, t: Type) -> { e: TypeEnv, sc: Scheme } = {
  let ty = resolve_ty(s, t);
  let env = env_free_vars(s, e);
  let fv = free_vars(s, ty, { tys: [], rows: [] });
  {
    e: env.e,
    sc: {
      ty_vars: ints_difference(fv.tys, env.free.tys),
      row_vars: ints_difference(fv.rows, env.free.rows),
      label_vars: [],
      ty: ty,
    },
  }
}

// --- The printer --------------------------------------------------------------------------

// `taken` holds the concrete resource names the text names: a label variable may take none of them.
pub type Printer = {
  ty_names: Map<Int, Bytes>,
  row_names: Map<Int, Bytes>,
  label_names: Map<Int, Bytes>,
  taken: Map<Bytes, Bool>,
}

pub fn printer_new() -> Printer =
  { ty_names: map_new(), row_names: map_new(), label_names: map_new(), taken: map_new() }

// A variable printed under the name a signature wrote for it, rather than the next free letter.
pub fn printer_naming(p: Printer, v: Int, name: Bytes) -> Printer =
  { ..p, ty_names: map_insert(p.ty_names, v, name) }

fn ty_letters() -> Bytes = b"abcdghijklmnopqrsuvwxyz"
fn row_letters() -> Bytes = b"eft"
fn label_letters() -> Bytes = b"lmn"

fn letter_name(letters: Bytes, i: Int) -> Bytes = {
  let n = bytes_len(letters);
  let letter = bytes_slice(letters, i % n, i % n + 1);
  if i < n { letter } else { bytes_concat(letter, bytes_of_string(int_to_string(i / n))) }
}

fn ty_name(p: Printer, v: Int) -> { p: Printer, name: Bytes } =
  match map_get(p.ty_names, v) {
    Some(n) -> { p: p, name: n },
    None -> {
      let name = letter_name(ty_letters(), map_len(p.ty_names));
      { p: { ..p, ty_names: map_insert(p.ty_names, v, name) }, name: name }
    },
  }

fn row_name(p: Printer, v: Int) -> { p: Printer, name: Bytes } =
  match map_get(p.row_names, v) {
    Some(n) -> { p: p, name: n },
    None -> {
      let name = letter_name(row_letters(), map_len(p.row_names));
      { p: { ..p, row_names: map_insert(p.row_names, v, name) }, name: name }
    },
  }

fn label_name(p: Printer, v: Int) -> { p: Printer, name: Bytes } =
  match map_get(p.label_names, v) {
    Some(n) -> { p: p, name: n },
    None -> {
      let name = free_label(p, 0);
      { p: { ..p, label_names: map_insert(p.label_names, v, name) }, name: name }
    },
  }

// The first label letter, then round, that no resource in this text and no other label holds, so
// `[l]` in a printed row or footprint means one thing.
fn free_label(p: Printer, i: Int) -> Bytes = {
  let name = letter_name(label_letters(), i);
  if map_contains(p.taken, name) || label_held(p.label_names, name) { free_label(p, i + 1) }
  else { name }
}

fn label_held(names: Map<Int, Bytes>, name: Bytes) -> Bool =
  map_fold(names, false, |acc: Bool, v: Int, held: Bytes| acc || held == name)

// Every concrete resource a text names, gathered before a label variable in it is given a name.
fn reserve_resource(p: Printer, r: Resource) -> Printer =
  match r { RNamed(n) -> { ..p, taken: map_insert(p.taken, n, true) }, _ -> p }

// What a caller that lays a row out itself must hand the printer before it names anything.
pub fn reserve_atoms(p: Printer, atoms: List<Atom>) -> Printer =
  fold(atoms, p, |acc: Printer, a: Atom| reserve_resource(acc, a.resource))

fn reserve_ty(p: Printer, t: Type) -> Printer =
  match t {
    TyVar(_) -> p,
    TyCon(c) -> fold(c.args, p, |acc: Printer, a: Type| reserve_ty(acc, a)),
    TyFn(f) ->
      reserve_atoms(
        reserve_ty(fold(f.params, p, |acc: Printer, x: Type| reserve_ty(acc, x)), f.ret),
        f.effects.atoms,
      ),
    TyRecord(fs) -> fold(fs, p, |acc: Printer, f: Field| reserve_ty(acc, f.ty)),
  }

pub fn region_prefix() -> Bytes = b"#region:"

pub fn region_of(t: Type) -> Option<Bytes> =
  match t {
    TyCon(c) -> if len(c.args) == 0 && bytes_starts_with(c.name, region_prefix()) {
      Some(bytes_slice(c.name, bytes_len(region_prefix()), bytes_len(c.name)))
    } else { None },
    _ -> None,
  }

pub fn print_resource(p: Printer, r: Resource) -> { p: Printer, s: Bytes } =
  match r {
    RNamed(n) -> { p: p, s: bytes_concat_all([b"[", n, b"]"]) },
    RVar(v) -> {
      let o = label_name(p, v);
      { p: o.p, s: bytes_concat_all([b"[", o.name, b"]"]) }
    },
    RSingleton -> { p: p, s: b"" },
  }

pub fn print_atom(p: Printer, a: Atom) -> { p: Printer, s: Bytes } = {
  let r = print_resource(p, a.resource);
  {
    p: r.p,
    s: bytes_concat_all([
      a.effect,
      b".",
      match a.op {
        Some(op) -> op,
        None -> match a.mode { MRead -> b"read", MWrite -> b"write", MBad -> b"" },
      },
      r.s,
    ]),
  }
}

// A fresh printer, so a lone atom names its label from the start of the alphabet.
pub fn atom_text(a: Atom) -> Bytes = print_atom(printer_new(), a).s

pub fn resource_text(r: Resource) -> Bytes = print_resource(printer_new(), r).s

fn join_bytes(xs: List<Bytes>, sep: Bytes) -> Bytes =
  fold(range(0, len(xs)), b"", |acc: Bytes, i: Int|
    if i == 0 { at(xs, i) } else { bytes_concat_all([acc, sep, at(xs, i)]) })

pub fn print_ty(p0: Printer, t: Type) -> { p: Printer, s: Bytes } = {
  let p = reserve_ty(p0, t);
  match t {
    TyVar(v) -> {
      let o = ty_name(p, v);
      { p: o.p, s: o.name }
    },
    TyCon(c) -> if c.name == b"Cell" && len(c.args) == 2 {
      let elem = print_ty(p, at(c.args, 1));
      match region_of(at(c.args, 0)) {
        Some(r) -> { p: elem.p, s: bytes_concat_all([b"Cell[", r, b"]<", elem.s, b">"]) },
        None -> { p: elem.p, s: bytes_concat_all([b"Cell<", elem.s, b">"]) },
      }
    } else if len(c.args) == 0 { { p: p, s: c.name } } else {
      let args = print_tys(p, c.args);
      { p: args.p, s: bytes_concat_all([c.name, b"<", join_bytes(args.ss, b", "), b">"]) }
    },
    TyFn(f) -> {
      let ps = print_tys(p, f.params);
      let r = print_ty(ps.p, f.ret);
      let head = bytes_concat_all([b"(", join_bytes(ps.ss, b", "), b") -> ", r.s]);
      if row_is_pure(f.effects) { { p: r.p, s: head } } else {
        let row = print_row(r.p, f.effects);
        { p: row.p, s: bytes_concat_all([head, b" / ", row.s]) }
      }
    },
    TyRecord(fs) -> match tuple_arity(fs) {
      Some(n) -> {
        let ts = print_tys(
          p,
          map(range(0, n), |i: Int|
            match field_get(fs, bytes_concat(b"_", bytes_of_string(int_to_string(i)))) {
              Some(x) -> x,
              None -> panic("a tuple field"),
            }),
        );
        { p: ts.p, s: bytes_concat_all([b"(", join_bytes(ts.ss, b", "), b")"]) }
      },
      None -> {
        let out = fold(fs, { p: p, ss: [] }, |acc: { p: Printer, ss: List<Bytes> }, f: Field| {
          let v = print_ty(acc.p, f.ty);
          { p: v.p, ss: push(acc.ss, bytes_concat_all([f.name, b": ", v.s])) }
        });
        { p: out.p, s: bytes_concat_all([b"{", join_bytes(out.ss, b", "), b"}"]) }
      },
    },
  }
}

fn print_tys(p: Printer, ts: List<Type>) -> { p: Printer, ss: List<Bytes> } =
  fold(ts, { p: p, ss: [] }, |acc: { p: Printer, ss: List<Bytes> }, t: Type| {
    let o = print_ty(acc.p, t);
    { p: o.p, ss: push(acc.ss, o.s) }
  })

// One printer for the whole list, so two label variables in it are told apart. Each atom on its
// own, for a caller that places them itself.
pub fn print_atom_list(p0: Printer, atoms: List<Atom>) -> { p: Printer, ss: List<Bytes> } = {
  let p = reserve_atoms(p0, atoms);
  fold(atoms, { p: p, ss: [] }, |acc: { p: Printer, ss: List<Bytes> }, a: Atom| {
    let o = print_atom(acc.p, a);
    { p: o.p, ss: push(acc.ss, o.s) }
  })
}

pub fn print_atoms(p0: Printer, atoms: List<Atom>, sep: Bytes) -> { p: Printer, s: Bytes } = {
  let out = print_atom_list(p0, atoms);
  { p: out.p, s: join_bytes(out.ss, sep) }
}

fn holds_label(vs: List<Int>, v: Int) -> Bool = fold(vs, false, |acc: Bool, x: Int| acc || x == v)

// The labels the atoms name are bound in a head, as a scheme's head binds its own: without them a
// label a caller fills reads back as a resource of that name.
pub fn atoms_text(atoms: List<Atom>, sep: Bytes) -> Bytes = {
  let out = print_atoms(printer_new(), atoms, sep);
  let vars = fold(atoms, [], |acc: List<Int>, a: Atom|
    match a.resource { RVar(v) -> if holds_label(acc, v) { acc } else { push(acc, v) }, _ -> acc });
  if len(vars) == 0 { out.s } else {
    let head = fold(vars, { p: out.p, ss: [] }, |acc: { p: Printer, ss: List<Bytes> }, v: Int| {
      let o = label_name(acc.p, v);
      { p: o.p, ss: push(acc.ss, bytes_concat_all([b"[", o.name, b"]"])) }
    });
    bytes_concat_all([b"<", join_bytes(head.ss, sep), b">", out.s])
  }
}

// --- Reading atoms back -------------------------------------------------------------------

fn last_dot(b: Bytes) -> Int =
  fold(range(0, bytes_len(b)), 0 - 1, |acc: Int, i: Int| if bytes_at(b, i) == 46 { i } else { acc })

type Split = { name: Bytes, resource: Resource }

fn read_atom(text: Bytes) -> Option<Atom> = {
  let n = bytes_len(text);
  let split: Option<Split> = match bytes_index_of(text, b"[") {
    None -> Some({ name: text, resource: RSingleton }),
    Some(i) -> if n == 0 || bytes_at(text, n - 1) != 93 || i == 0 { None } else {
      Some({ name: bytes_slice(text, 0, i), resource: RNamed(bytes_slice(text, i + 1, n - 1)) })
    },
  };
  match split {
    None -> None,
    Some(s) -> {
      let d = last_dot(s.name);
      if d <= 0 || d >= bytes_len(s.name) - 1 { None } else {
        let eff = bytes_slice(s.name, 0, d);
        let access = bytes_slice(s.name, d + 1, bytes_len(s.name));
        if access == b"read" { Some({ effect: eff, resource: s.resource, mode: MRead, op: None }) } else if access
            == b"write" { Some({ effect: eff, resource: s.resource, mode: MWrite, op: None }) }
        // An operation's mode is its declaration's, which this text does not carry; the caller settles it.
        else { Some({ effect: eff, resource: s.resource, mode: MWrite, op: Some(access) }) }
      }
    },
  }
}

// The inverse of `atoms_text(_, b",")`. A text that binds label variables names them from the start
// of the alphabet, so nothing in it says which parameter each one was: that text reads as nothing.
pub fn read_atoms(text: Bytes) -> Option<List<Atom>> =
  if bytes_len(text) == 0 { Some([]) }
  else if bytes_at(text, 0) == 60 { None } else {
    fold(bytes_split(text, b","), Some([]), |acc: Option<List<Atom>>, piece: Bytes|
      match acc {
        None -> None,
        Some(xs) -> match read_atom(piece) { Some(a) -> Some(push(xs, a)), None -> None },
      })
  }

pub fn print_row(p: Printer, r: Row) -> { p: Printer, s: Bytes } = {
  let out = print_atoms(p, r.atoms, b", ");
  match r.tail {
    None -> { p: out.p, s: bytes_concat_all([b"{", out.s, b"}"]) },
    Some(v) -> {
      let n = row_name(out.p, v);
      if len(r.atoms) == 0 { { p: n.p, s: n.name } }
      else { { p: n.p, s: bytes_concat_all([b"{", out.s, b" | ", n.name, b"}"]) } }
    },
  }
}

pub fn print_scheme(p0: Printer, sc: Scheme) -> { p: Printer, s: Bytes } = {
  // Named in the order a call fills them, against every resource the body names, so the head and
  // the body read the same there.
  let p = reserve_ty(p0, sc.ty);
  let body = print_ty(fold(sc.label_vars, p, |acc: Printer, v: Int| label_name(acc, v).p), sc.ty);
  if len(sc.ty_vars) == 0 && len(sc.row_vars) == 0 && len(sc.label_vars) == 0 { body } else {
    let tys = fold(
      sc.ty_vars,
      { p: body.p, ss: [] },
      |acc: { p: Printer, ss: List<Bytes> }, v: Int| {
        let o = ty_name(acc.p, v);
        { p: o.p, ss: push(acc.ss, o.name) }
      },
    );
    let labels = fold(sc.label_vars, tys, |acc: { p: Printer, ss: List<Bytes> }, v: Int| {
      let o = label_name(acc.p, v);
      { p: o.p, ss: push(acc.ss, bytes_concat_all([b"[", o.name, b"]"])) }
    });
    let rows = fold(
      sc.row_vars,
      { p: labels.p, ss: [] },
      |acc: { p: Printer, ss: List<Bytes> }, v: Int| {
        let o = row_name(acc.p, v);
        { p: o.p, ss: push(acc.ss, o.name) }
      },
    );
    let head = if len(labels.ss) > 0 && len(rows.ss) > 0 {
      bytes_concat_all([
        b"<",
        join_bytes(labels.ss, b", "),
        b" | ",
        join_bytes(rows.ss, b", "),
        b">",
      ])
    } else if len(labels.ss) > 0 { bytes_concat_all([b"<", join_bytes(labels.ss, b", "), b">"]) }
    else { bytes_concat_all([b"<| ", join_bytes(rows.ss, b", "), b">"]) };
    { p: rows.p, s: bytes_concat(head, body.s) }
  }
}

// A fresh printer per scheme, so each one names its variables from the start of the alphabet.
pub fn scheme_text(sc: Scheme) -> Bytes = print_scheme(printer_new(), sc).s
pub fn type_text(t: Type) -> Bytes = print_ty(printer_new(), t).s
pub fn row_text(r: Row) -> Bytes = print_row(printer_new(), r).s

// --- Tests ------------------------------------------------------------------

test "unification binds a variable once and refuses the occurs case" {
  let f0 = fresh_new();
  let a = fresh_ty(f0);
  let u = unify(subst_new(), a.f, a.t, t_list(t_int()));
  assert_eq(type_text(resolve_ty(u.s, a.t)), b"List<Int>");
  let bad = unify(u.s, u.f, a.t, t_list(a.t));
  assert_eq(match bad.err { Some(Mismatch(_)) -> 1, Some(_) -> 2, None -> 0 }, 1)
}

test "a row unifies atom-wise and a closed row refuses what it lacks" {
  let db = { effect: b"db", resource: RNamed(b"users"), mode: MRead, op: None };
  let f0 = fresh_new();
  let e = fresh_row(f0);
  let u = unify_row(subst_new(), e.f, e.r, row_singleton(db));
  assert_eq(row_text(resolve_row(u.s, e.r)), b"{db.read[users]}");
  let bad = unify_row(u.s, u.f, row_empty(), row_singleton(db));
  assert(match bad.err { Some(RowMismatch(_)) -> true, _ -> false })
}

test "an operation atom sorts after its mode atom, which covers it" {
  let wr = { effect: b"net", resource: RNamed(b"conn"), mode: MWrite, op: None };
  let send = { effect: b"net", resource: RNamed(b"conn"), mode: MWrite, op: Some(b"send") };
  let recv = { effect: b"net", resource: RNamed(b"conn"), mode: MWrite, op: Some(b"recv") };
  let rd = { effect: b"net", resource: RNamed(b"conn"), mode: MRead, op: None };
  assert(atom_lt(wr, send));
  assert(!atom_lt(send, wr));
  assert(atom_lt(recv, send));
  assert_eq(
    row_text(row_closed([send, wr, recv])),
    b"{net.write[conn], net.recv[conn], net.send[conn]}",
  );
  assert(atom_covers(wr, send));
  assert(atom_covers(send, send));
  assert(!atom_covers(send, wr));
  assert(!atom_covers(rd, send));
  assert(atoms_covered([rd, wr], send));
  assert(!atoms_covered([rd], send));
  assert_eq(
    row_text(row_without_covered(row_closed([send, wr, recv, rd]), [wr])),
    b"{net.read[conn]}",
  );
  assert_eq(
    row_text(row_without_covered(row_closed([send, recv, rd]), [send])),
    b"{net.read[conn], net.recv[conn]}",
  )
}

test "atoms read back as the atoms they were printed from" {
  let rd = { effect: b"m.db", resource: RNamed(b"users"), mode: MRead, op: None };
  let wr = { effect: b"m.net", resource: RSingleton, mode: MWrite, op: None };
  let send = { effect: b"m.net", resource: RNamed(b"conn"), mode: MWrite, op: Some(b"send") };
  assert_eq(read_atoms(b""), Some([]));
  assert_eq(read_atoms(atoms_text([rd], b",")), Some([rd]));
  assert_eq(read_atoms(atoms_text([rd, wr], b",")), Some([rd, wr]));
  assert_eq(read_atoms(atoms_text([send], b",")), Some([send]));
  // A label variable's name is the printer's, not the parameter's, so a text that binds one is refused.
  assert_eq(
    read_atoms(
      atoms_text([{ effect: b"m.net", resource: RVar(4), mode: MWrite, op: Some(b"send") }], b","),
    ),
    None,
  );
  assert_eq(read_atoms(b"db"), None);
  assert_eq(read_atoms(b".read"), None);
  assert_eq(read_atoms(b"m.db."), None);
  assert_eq(read_atoms(b"m.db.read[users"), None)
}

test "the printer names variables in the order it meets them, rows apart" {
  let sc = {
    ty_vars: [7, 3],
    row_vars: [2],
    label_vars: [],
    ty: t_fn([TyVar(3), TyVar(7)], t_list(TyVar(3)), row_open(2)),
  };
  assert_eq(scheme_text(sc), b"<b, a | e>(a, b) -> List<a> / e");
  assert_eq(
    type_text(
      TyRecord(fields_sorted([{ name: b"_1", ty: t_int() }, { name: b"_0", ty: t_bool() }])),
    ),
    b"(Bool, Int)",
  )
}

test "a label variable sorts between a name and the singleton, and resolves to what it binds" {
  let named = { effect: b"net", resource: RNamed(b"conn"), mode: MWrite, op: Some(b"send") };
  let var_ = { effect: b"net", resource: RVar(4), mode: MWrite, op: Some(b"send") };
  let single = { effect: b"net", resource: RSingleton, mode: MWrite, op: Some(b"send") };
  assert(atom_lt(named, var_));
  assert(atom_lt(var_, single));
  assert_eq(
    row_text(row_closed([single, var_, named])),
    b"{net.send[conn], net.send[l], net.send}",
  );
  // Bound to the label `conn`, the variable atom is the named one and the row holds it once.
  let s = {
    ty: map_insert(map_new(), 4, label_type(b"conn")),
    row: map_new(),
    rigid_ty: map_new(),
    rigid_row: map_new(),
  };
  assert_eq(atom_text(resolve_atom(s, var_)), b"net.send[conn]");
  assert_eq(row_text(resolve_row(s, row_closed([var_, named]))), b"{net.send[conn]}")
}

// Without the head, a reader has nothing to tell `[l]` the parameter from `[l]` the resource by.
test "a footprint's text binds the labels its atoms name" {
  let named = { effect: b"net", resource: RNamed(b"conn"), mode: MWrite, op: Some(b"send") };
  let first = { effect: b"net", resource: RVar(4), mode: MWrite, op: Some(b"recv") };
  let second = { effect: b"net", resource: RVar(9), mode: MWrite, op: Some(b"send") };
  assert_eq(atoms_text([named], b","), b"net.send[conn]");
  assert_eq(atoms_text([], b","), b"");
  assert_eq(
    atoms_text([first, second, first], b","),
    b"<[l],[m]>net.recv[l],net.send[m],net.recv[l]",
  );
  assert_eq(atoms_text([named, second], b","), b"<[l]>net.send[conn],net.send[l]")
}

// The shape `crates/ply-ty-tests` pins for the Rust printer: the two must answer it alike, or a
// text one of them wrote reads back as something else in the other.
test "a label variable steps past a resource of its name" {
  let named = { effect: b"net", resource: RNamed(b"l"), mode: MWrite, op: Some(b"send") };
  let var_ = { effect: b"net", resource: RVar(4), mode: MWrite, op: Some(b"recv") };
  assert_eq(atoms_text([named, var_], b","), b"<[m]>net.send[l],net.recv[m]");
  assert_eq(row_text(row_closed([named, var_])), b"{net.send[l], net.recv[m]}");
  // One operation under a resource and under the variable: two atoms, and two names.
  let same_op = { effect: b"net", resource: RVar(4), mode: MWrite, op: Some(b"send") };
  assert_eq(atoms_text([named, same_op], b","), b"<[m]>net.send[l],net.send[m]");
  let sc = {
    ty_vars: [],
    row_vars: [],
    label_vars: [4],
    ty: t_fn([], t_unit(), row_closed([named, var_])),
  };
  assert_eq(scheme_text(sc), b"<[m]>() -> Unit / {net.send[l], net.recv[m]}");
  // A second name in the way takes the next letter again.
  let held = { effect: b"net", resource: RNamed(b"m"), mode: MWrite, op: Some(b"close") };
  assert_eq(atoms_text([named, held, var_], b","), b"<[n]>net.send[l],net.close[m],net.recv[n]");
  // Every letter held, so the variable takes the round.
  let last = { effect: b"net", resource: RNamed(b"n"), mode: MWrite, op: Some(b"connect") };
  assert_eq(
    atoms_text([named, held, last, var_], b","),
    b"<[l1]>net.send[l],net.close[m],net.connect[n],net.recv[l1]",
  )
}

test "a free label variable takes the resource the other row names for its operation" {
  let f0 = fresh_new();
  let v = fresh_ty_var(f0);
  let generic = row_closed([
    { effect: b"net", resource: RVar(v.v), mode: MWrite, op: Some(b"send") },
  ]);
  let concrete = row_closed([
    { effect: b"net", resource: RNamed(b"conn"), mode: MWrite, op: Some(b"send") },
  ]);
  let u = unify_row(subst_new(), v.f, generic, concrete);
  assert(match u.err { None -> true, Some(_) -> false });
  assert_eq(row_text(resolve_row(u.s, generic)), b"{net.send[conn]}");
  // A rigid one is the definition's own label and unifies with nothing else.
  let bad = unify_row(mark_rigid_ty(subst_new(), v.v), v.f, generic, concrete);
  assert(match bad.err { Some(RowMismatch(_)) -> true, _ -> false })
}

test "a scheme prints its label parameters bracketed, among the type parameters" {
  let atom = { effect: b"net", resource: RVar(5), mode: MWrite, op: Some(b"send") };
  let sc = {
    ty_vars: [1],
    row_vars: [2],
    label_vars: [5],
    ty: t_fn([TyVar(1)], t_unit(), { atoms: [atom], tail: Some(2) }),
  };
  assert_eq(scheme_text(sc), b"<a, [l] | e>(a) -> Unit / {net.send[l] | e}");
  // Renaming the label variable leaves the printed scheme alone.
  let other = {
    ty_vars: [1],
    row_vars: [2],
    label_vars: [9],
    ty: t_fn([TyVar(1)], t_unit(), {
      atoms: [{ effect: b"net", resource: RVar(9), mode: MWrite, op: Some(b"send") }],
      tail: Some(2),
    }),
  };
  assert_eq(scheme_text(other), scheme_text(sc))
}

test "instantiating a scheme freshens its label parameters and hands them back" {
  let atom = { effect: b"net", resource: RVar(5), mode: MWrite, op: Some(b"send") };
  let sc = {
    ty_vars: [],
    row_vars: [],
    label_vars: [5],
    ty: t_fn([], t_unit(), row_closed([atom])),
  };
  let inst = instantiate_with(sc, fresh_new());
  assert_eq(len(inst.labels), 1);
  let bound = match at(inst.labels, 0) { TyVar(v) -> v, _ -> 0 - 1 };
  assert(bound >= 0);
  let s = {
    ty: map_insert(map_new(), bound, label_type(b"conn")),
    row: map_new(),
    rigid_ty: map_new(),
    rigid_row: map_new(),
  };
  assert_eq(type_text(resolve_ty(s, inst.ty)), b"() -> Unit / {net.send[conn]}")
}

test "generalization skips what the environment still reaches" {
  let f0 = fresh_new();
  let a = fresh_ty(f0);
  let b = fresh_ty(a.f);
  let env = env_bind_global(env_new(), b"outer", mono(a.t));
  let g = generalize(subst_new(), env, t_fn([a.t], b.t, row_empty()));
  assert_eq(len(g.sc.ty_vars), 1)
}
