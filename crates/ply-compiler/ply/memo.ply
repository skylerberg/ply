//! Derived facts that stand while every read they made answers as it did. A query is a function a
//! run asks by name; its record keeps each read it made, in order, and the digest of what it
//! answered: a read of the world (a file, a shipped module, an embed) by the digest of what it
//! answered, and a read of another query by the digest of that query's answer. A query reads only
//! through `memo`, which its row is all of, so nothing it read goes unrecorded.
//!
//! A run costs what moved, not what the store holds. The store notes the digest it last saw at each
//! place of the world a record read, and which records read each place and asked each record. A run
//! first brings each note to what the world holds now; where a place moved, each record that read it
//! is marked. Then each mark is settled: the marked record is checked read by read, each read of
//! another query asked again, and answered anew only where a read moved; only an answer that comes
//! out otherwise marks the records that asked it. So an edit costs the records whose reads moved,
//! and a record with no mark stands without its reads being asked again.
//!
//! A store vouches for a record only to a run of the stamp that kept or checked it: what names the
//! queries the run answers under and, where the toolchain packed answers below the store, the pack
//! and the shipped files the run reads (`packs`). A run under another stamp checks a record read by
//! read before it takes it, so a toolchain that answers otherwise, or packed another answer, costs a
//! store no write and leaves no record standing on what it no longer answers.

import std.bin
import std.bytes (u64_le)
import std.list
import std.hash (blake3)
import std.gen
import packs

pub effect memo {
  /// What the world holds at `at`, as `kind` reads it, or nothing there.
  read world(kind: Bytes, at: Bytes) -> Option<Bytes>
  /// What the query named `query` answers for `input`.
  read ask(query: Bytes, input: Bytes) -> Bytes
  /// The digest of what the query named `query` answers for `input`: the read an `ask` makes,
  /// without the answer, which `held` hands over and no store is read for. A body that keeps what
  /// it decoded of an answer by its digest asks so, and decodes each answer once.
  read head(query: Bytes, input: Bytes) -> Bytes
  /// The answer under `digest`, which a `head` or an `ask` of this run answered: none where no
  /// store holds it any more, which an `ask` then makes again.
  read held(digest: Bytes) -> Option<Bytes>
  /// Whether the store holds an answer of `query` for `input` that stands: one asking it takes
  /// without running its body. A record the store does not vouch for to this run is judged by its
  /// reads as the store holds them, each asked record the same way, and no body runs for it. It
  /// reads nothing an answer depends on.
  read kept(query: Bytes, input: Bytes) -> Bool
  /// Offers `output` as what `query` answers for `input`, which a body running for it in this run
  /// takes in place of working it out: what a body that works out several answers at once hands on.
  /// The output must be what the body would work out from what it reads.
  read offer(query: Bytes, input: Bytes, output: Bytes) -> Unit
  /// [`memo.offer`] under the definition of the query `by` in place of the offering body's own:
  /// what a body offers of work another query's definition wholly reaches, so an answer made from
  /// the offer moves with that work and not with the rest of the body that happened to do it.
  read offer_as(by: Bytes, query: Bytes, input: Bytes, output: Bytes) -> Unit
  /// What was offered as the answer the running body works out, if anything was. Taking it reads
  /// the definition of the query that offered it, so an answer made from an offer moves with the
  /// code that made it.
  read offered() -> Option<Bytes>
}

/// A read a record keeps: of the world by what it answered, or of a query by what it answered.
pub type Read = | World(Bytes, Bytes, Bytes) | Asked(Bytes, Bytes, Bytes)

/// What a query answered for an input: the hash of the query that answered, the input, every read it
/// made, in order, and the digest of its answer, which the answer is kept under.
/// A query's answer for one input, by its digest, beside what it read and its height: one above the
/// highest record it asked, so a record stands above every record it reads.
pub type Record = { query: Bytes, input: Bytes, reads: List<Read>, output: Bytes, height: Int }

derive bin for Read
derive bin for Record

/// A place of the world as a store last saw it: how it is read, where, and the digest of what was
/// there.
pub type Seen = { kind: Bytes, at: Bytes, digest: Bytes }

derive bin for Seen

/// A query: its name, the hash of its definition, which keys what it answered, and its body.
pub type Query<| e> = {
  name: Bytes,
  hash: Bytes,
  body: (Bytes) -> Bytes / {memo.read, abort.raise | e},
}

/// What a run has settled: the digest of the answer under each key it settled, what its driver asked,
/// in order, the keys being answered now, which a query asking
/// one of them again would wait on forever, with the queries answering them, outermost first, and,
/// by query, how many answers it took as kept and how
/// many it ran the body for. While the run settles marks, `marked` holds the records it marked whose
/// marks are still to settle, lowest first. `offers` holds what a body offered for another key, the
/// query whose body offered it, the key that body was answering and which of its runs made the
/// offer; and `runs` how many times the run has run the body under each key. `vouched` is whether
/// the store vouched for any record to the run when it started, and `lost` how many answers a
/// record that stood named and no store held, which the run made again. `judged` holds each record
/// [`would_stand`] judged, by its key.
pub type Run = {
  settled: Map<Bytes, Bytes>,
  asked: List<Read>,
  open: Map<Bytes, Bool>,
  trail: List<{ query: Bytes, input: Bytes }>,
  took: Map<Bytes, Int>,
  ran: Map<Bytes, Int>,
  inputs: List<{ query: Bytes, input: Bytes }>,
  /// Each record the run took back from before an edit it found undone, with no body run.
  restored: List<{ query: Bytes, input: Bytes }>,
  settling: Bool,
  marked: Map<Int, List<Bytes>>,
  offers: Map<Bytes, Offer>,
  runs: Map<Bytes, Int>,
  vouched: Bool,
  lost: Int,
  judged: Map<Bytes, Bool>,
}

type Offer = { output: Bytes, by: Bytes, from: Bytes, nth: Int }

fn new_run() -> Run =
  {
    settled: Map::new(),
    asked: [],
    open: Map::new(),
    trail: [],
    took: Map::new(),
    ran: Map::new(),
    inputs: [],
    restored: [],
    settling: false,
    marked: Map::new(),
    offers: Map::new(),
    runs: Map::new(),
    vouched: false,
    lost: 0,
    judged: Map::new(),
  }

/// What the run's driver asked, each read by the digest of what it answered: what an answer made
/// over them is a function of.
pub fn asked_reads(run: Run) -> List<Read> = run.asked

fn asked_keys<| e>(
  queries: Map<Bytes, Query<| e>>,
  reads: List<Read>,
  onto: List<Bytes>,
) -> List<Bytes> =
  reads.fold(onto, |acc: List<Bytes>, r: Read|
    match r {
      Asked(name, input, _) -> match queries.get(name) {
        Some(q) -> acc.push(key_of(q, input)),
        None -> acc,
      },
      World(_, _, _) -> acc,
    })

/// The key of each record of a query whose hash `wanted` holds among those the answers `run`'s
/// driver asked read, at any depth, those answers' own among them: what a store of those answers
/// and nothing else keeps. A record the run settled for a mark is not among them unless one of
/// those answers read it, so what a store shared with another world holds of that world is left out.
pub fn reached<| e>(
  queries: Map<Bytes, Query<| e>>,
  wanted: Map<Bytes, Bool>,
  run: Run,
) -> List<Bytes> / {memo_keep.read, abort.raise} =
  iterate(
    { seen: Map::new(), work: asked_keys(queries, run.asked, []), keys: [] },
    100000000,
    |x: { seen: Map<Bytes, Bool>, work: List<Bytes>, keys: List<Bytes> }|
      match x.work {
        [] -> Stop(x.keys),
        [key, ..rest] -> if x.seen.contains(key) { Continue({ ..x, work: rest }) } else {
          let seen = x.seen.insert(key, true);
          match memo_keep.record(key) {
            None -> Continue({ ..x, seen: seen, work: rest }),
            Some(rec) ->
              Continue({
                seen: seen,
                work: asked_keys(queries, rec.reads, rest),
                keys: if wanted.contains(rec.query) { x.keys.push(key) } else { x.keys },
              }),
          }
        },
      },
  )

/// Whether the store the run started over vouched for any record to it. Where it did, a run that
/// ran bodies and took no answer was not served what the store holds.
pub fn vouched_to(run: Run) -> Bool = run.vouched

/// How many answers the run made again because a record that stood named one no store held: none
/// over a store that is whole.
pub fn lost_in(run: Run) -> Int = run.lost

/// What a run did of one query: answers taken as kept, and bodies run.
pub type Tally = { query: Bytes, took: Int, ran: Int }

derive bin for Tally

fn counted(m: Map<Bytes, Int>, name: Bytes) -> Int = match m.get(name) { Some(n) -> n, None -> 0 }

fn bumped(m: Map<Bytes, Int>, name: Bytes) -> Map<Bytes, Int> = m.insert(name, counted(m, name) + 1)

/// Each query the run asked, by name.
pub fn tallies(run: Run) -> List<Tally> =
  run.ran.fold(run.took, |acc: Map<Bytes, Int>, k: Bytes, _: Int|
    if acc.contains(k) { acc } else { acc.insert(k, 0) }).keys(
  ).map(|name: Bytes| { query: name, took: counted(run.took, name), ran: counted(run.ran, name) })

/// Each input of the query `name` the run took a record back for.
pub fn restored_for(run: Run, name: Bytes) -> List<Bytes> =
  run.restored.filter(|r: { query: Bytes, input: Bytes }| r.query == name).map(
    |r: { query: Bytes, input: Bytes }| r.input,
  )

/// Each input the run ran the body of the query `name` for, in the order it ran them.
pub fn ran_for(run: Run, name: Bytes) -> List<Bytes> =
  run.inputs.filter(|r: { query: Bytes, input: Bytes }| r.query == name).map(
    |r: { query: Bytes, input: Bytes }| r.input,
  )

/// How many bodies the run ran, over every query.
pub fn ran_total(run: Run) -> Int = run.ran.fold(0, |n: Int, _: Bytes, k: Int| n + k)

/// The digest a read is kept by: nothing there is a value of its own.
pub fn digest_of(answer: Option<Bytes>) -> Bytes =
  match answer { Some(b) -> b"=".concat(blake3(b)), None -> b"-" }

/// What a query's answer for `input` is kept under: its definition's hash and the input's digest.
pub fn key_of<| e>(q: Query<| e>, input: Bytes) -> Bytes =
  blake3(Bytes::concat_all([b"ply.memo.key\x00", q.hash, b"\x00", blake3(input)]))

fn sized(b: Bytes) -> Bytes = u64_le(b.len()).concat(b)

/// What a store notes the place `at`, as `kind` reads it, under.
pub fn place_id(kind: Bytes, at: Bytes) -> Bytes =
  blake3(Bytes::concat_all([b"ply.memo.place\x00", sized(kind), at]))

/// The place that holds a query's hash, at its name: what a record made from an offer reads of the
/// query that offered it. A store notes nothing of it and nobody as its reader: a run under queries
/// that hash otherwise writes under another stamp, which checks every record before it takes it.
fn query_kind() -> Bytes = b"query"

/// The mark a store answers for a record it holds and does not vouch for to the run: nothing it
/// read is known to have moved, and no run of this stamp has checked that.
pub fn unchecked() -> Bytes = b"unchecked"

/// What names the queries a run answers under: a store vouches for a record only to a run of the
/// stamp that kept or checked it.
pub fn stamp_of<| e>(queries: Map<Bytes, Query<| e>>) -> Bytes =
  blake3(
    Bytes::concat_all(
      queries.fold([b"ply.memo.stamp\x00"], |acc: List<Bytes>, name: Bytes, q: Query<| e>|
        acc.push(sized(name)).push(sized(q.hash))),
    ),
  )

/// What one row of a store says of a key, the part trust reads: whether a run of the asking run's
/// own stamp wrote it, whether it says the record stands, and whether it brought the record or only
/// checked it.
pub type Said = { own: Bool, stands: Bool, fresh: Bool }

/// What `said` settles of whether a record is taken without its reads being asked again, a key's
/// rows being read newest first: a row of the run's own stamp settles it either way; another
/// stamp's row that marks the record, or brought a new one, settles that it is not; and another
/// stamp's row that only checked the record settles nothing, so the row before it is read.
pub fn settles(said: Said) -> Option<Bool> =
  if said.own { Some(said.stands) } else if !said.stands || said.fresh { Some(false) } else { None }

/// Where the record a new one under `key` replaced is kept: a key of the same width that no query
/// makes, so nothing marks it.
pub fn earlier_key(key: Bytes) -> Bytes = blake3(b"earlier\x00".concat(key))

/// The records `held` keeps as what their keys answer, the earlier ones left out.
pub fn current(held: Held) -> Map<Bytes, Record> / {abort.raise} = {
  let earlier = held.records.fold(Map::new(), |acc: Map<Bytes, Bool>, k: Bytes, _: Record|
    acc.insert(earlier_key(k), true));
  held.records.fold(Map::new(), |acc: Map<Bytes, Record>, k: Bytes, r: Record|
    if earlier.contains(k) { acc } else { acc.insert(k, r) })
}

/// Keeps the record under `key` as the earlier one, where `next` is another: what an edit that is
/// undone answers again.
fn kept_earlier(key: Bytes, next: Record) -> Unit / {memo_keep.read, memo_keep.write} =
  match memo_keep.record(key) {
    Some(old) -> if memo_keep.stored(key)
        && (old.output != next.output || old.reads != next.reads) {
      memo_keep.adopt(earlier_key(key), old)
    },
    None -> (),
  }

fn record_format() -> Bytes = b"\x05"

/// The longest answer a store keeps inside the record that names it.
pub fn inline_bound() -> Int = 2048

/// `output` where a store keeps it inside its record.
pub fn kept_inline(output: Bytes) -> Option<Bytes> =
  if output.len() <= inline_bound() { Some(output) } else { None }

/// `r` as a store keeps it: its height and its answer's digest first, then `inline`, the answer
/// itself where the record holds it, so a run that takes it as kept reads no more.
pub fn record_bytes(r: Record, inline: Option<Bytes>) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    record_format(),
    u64_le(r.height),
    sized(r.output),
    match inline { Some(o) -> b"\x01".concat(sized(o)), None -> b"\x00" },
    sized(r.query),
    sized(r.input),
    bin::encode(r.reads, bin::list_bin(read_bin())),
  ])

fn sized_at(b: Bytes, at: Int) -> Option<{ value: Bytes, next: Int }> / {abort.raise} =
  match b.u64_at(at) {
    None -> None,
    Some(n) -> if n < 0 || at + 8 + n > b.len() { None }
    else { Some({ value: b.slice(at + 8, at + 8 + n), next: at + 8 + n }) },
  }

/// The digest of the answer a record's bytes, or their first bytes, name.
pub fn output_named(b: Bytes) -> Option<Bytes> / {abort.raise} =
  if b.len() < 9 || b.slice(0, 1) != record_format() { None }
  else { match sized_at(b, 9) { Some(o) -> Some(o.value), None -> None } }

/// The height a record's bytes, or their first bytes, name: none for bytes of no record.
pub fn height_named(b: Bytes) -> Int =
  if b.len() < 9 || b.slice(0, 1) != record_format() { 0 }
  else { match b.u64_at(1) { Some(h) -> h, None -> 0 } }

/// A record's bytes naming `height` where they name a lower one: bytes of no record as they are.
pub fn at_height(b: Bytes, height: Int) -> Bytes =
  if height <= height_named(b) || b.len() < 9 || b.slice(0, 1) != record_format() { b }
  else { Bytes::concat_all([record_format(), u64_le(height), b.slice(9, b.len())]) }

/// What a run names its queries by to a store: the hash of each.
fn hashes_of<| e>(queries: Map<Bytes, Query<| e>>) -> List<Bytes> =
  queries.fold([], |acc: List<Bytes>, _: Bytes, q: Query<| e>| acc.push(q.hash))

/// The answer a record's bytes, or their first bytes, hold beside its digest: none for a record
/// that keeps its answer apart.
pub fn inline_named(b: Bytes) -> Option<Bytes> / {abort.raise} =
  if b.len() < 9 || b.slice(0, 1) != record_format() { None } else {
    match sized_at(b, 9) {
      None -> None,
      Some(o) -> if o.next >= b.len() || b.at(o.next) != 1 { None }
      else { match sized_at(b, o.next + 1) { Some(i) -> Some(i.value), None -> None } },
    }
  }

/// Where in a record's bytes what follows its answer starts.
fn past_inline(b: Bytes, at: Int) -> Option<Int> / {abort.raise} =
  if at >= b.len() { None }
  else if b.at(at) == 0 { Some(at + 1) }
  else if b.at(at) != 1 { None }
  else { match sized_at(b, at + 1) { Some(i) -> Some(i.next), None -> None } }

/// How many of a record's first bytes name its answer, and hold it where the record does.
pub fn head_bytes() -> Int = 4096

/// The record `b` holds, or nothing where they do not read as one.
pub fn record_from(b: Bytes) -> Option<Record> / {abort.raise} =
  if b.len() < 9 || b.slice(0, 1) != record_format() { None } else {
    match sized_at(b, 9) {
      None -> None,
      Some(o) -> match match past_inline(b, o.next) { Some(at) -> sized_at(b, at), None -> None } {
        None -> None,
        Some(q) -> match sized_at(b, q.next) {
          None -> None,
          Some(i) -> match bin::decode(b.slice(i.next, b.len()), bin::list_bin(read_bin())) {
            Ok(reads) ->
              Some({
                query: q.value,
                input: i.value,
                reads: reads,
                output: o.value,
                height: height_named(b),
              }),
            Err(_) -> None,
          },
        },
      },
    }
  }

/// Where a run reads and keeps records, their answers, its notes of the world and who read what,
/// and what the world holds now: the handler a command runs its queries under.
pub effect memo_keep {
  /// The digest of the answer the record under `key` in the run's store names.
  read head(key: Bytes) -> Option<Bytes>
  /// The height of the record under `key` in the run's store: none for no record.
  read height(key: Bytes) -> Int
  /// The record kept under `key` in the run's store, or else in the pack below it.
  read record(key: Bytes) -> Option<Record>
  /// Whether the run's store holds the record under `key` itself, its reads noted among their
  /// readers, rather than the pack below it.
  read stored(key: Bytes) -> Bool
  /// The answer kept under its digest, in the store or the pack below it.
  read output(digest: Bytes) -> Option<Bytes>
  /// Keeps `r` under `key`, and `output` under `r.output`.
  write keep(key: Bytes, r: Record, output: Bytes) -> Unit
  /// Keeps `r`, a record the store or its pack holds already, under `key`; its answer stays where it
  /// is kept.
  write adopt(key: Bytes, r: Record) -> Unit
  /// Raises the height of the record under `key` to `height`, where it stands lower.
  write raise(key: Bytes, height: Int) -> Unit
  /// What the world holds at `at`, as `kind` reads it. A place is looked at once a run, so a run
  /// reads one world however long it runs: what moved under it is found by the next run, which
  /// holds the store's note of the place against the world.
  read now(kind: Bytes, at: Bytes) -> Option<Bytes>
  /// The digest of what [`memo_keep.now`] answers for the place, worked out once a run.
  read digest(kind: Bytes, at: Bytes) -> Bytes
  /// Each place the store noted.
  read places() -> List<Seen>
  /// What the store last saw at the place `id` names.
  read seen(id: Bytes) -> Option<Seen>
  /// Notes `s` as what the store saw at the place `id` names.
  write see(id: Bytes, s: Seen) -> Unit
  /// The keys of the records that read the place, or asked the query, `id` names.
  read readers(id: Bytes) -> List<Bytes>
  /// Notes the record under `key` among the readers of `id`.
  write link(id: Bytes, key: Bytes) -> Unit
  /// The marks on the record under `key`, each left by a run that found something it read moved.
  read marks(key: Bytes) -> List<Bytes>
  /// The keys of the records the store holds a mark on now, each once. A store kept by runs of
  /// other queries too names only the records of the queries this run answers under.
  read marked() -> List<Bytes>
  /// Leaves a mark of its own on the record under `key`.
  write mark(key: Bytes) -> Unit
  /// Removes `marks` from the record under `key`.
  write unmark(key: Bytes, marks: List<Bytes>) -> Unit
  /// Names what the run answers under, before it asks the store anything: `stamp`, since the store
  /// vouches for a record only to a run of the stamp that kept or checked it, and the hash of each
  /// of its `queries`, since a store drops in time the records of queries no run answers under.
  write stamped(stamp: Bytes, queries: List<Bytes>) -> Unit
  /// Whether the store holds a record it vouches for to the stamp the run named: one a run of
  /// that stamp kept or checked.
  read vouches() -> Bool
}

pub type Answered = { run: Run, output: Bytes }

fn query_of<| e>(queries: Map<Bytes, Query<| e>>, name: Bytes) -> Query<| e> / {abort.raise} =
  match queries.get(name) {
    Some(q) -> q,
    None -> panic("no query is named `" ++ String::of_bytes_lossy(name) ++ "`"),
  }

fn too_deep() -> Bytes = b"queries ask one another deeper than any program's queries go"

/// What the world holds at `at` as `kind` reads it, a query's hash at its name among them.
fn now_at<| e>(
  queries: Map<Bytes, Query<| e>>,
  kind: Bytes,
  at: Bytes,
) -> Option<Bytes> / {memo_keep.read} =
  if kind == query_kind() { match queries.get(at) { Some(q) -> Some(q.hash), None -> None } }
  else { memo_keep.now(kind, at) }

/// The digest of what [`now_at`] answers.
fn digest_at<| e>(
  queries: Map<Bytes, Query<| e>>,
  kind: Bytes,
  at: Bytes,
) -> Bytes / {memo_keep.read} =
  if kind == query_kind() { digest_of(now_at(queries, kind, at)) }
  else { memo_keep.digest(kind, at) }

/// Marks each record that read the place, or asked the query, `id` names, but those `open` holds:
/// the ones whose marks a run settling marks settles next. A record running now reads what moved as
/// it is now, since it would have settled it already had it read it before.
fn marked_readers(
  id: Bytes,
  open: Map<Bytes, Bool>,
) -> List<Bytes> / {memo_keep.read, memo_keep.write} =
  memo_keep.readers(id).fold([], |acc: List<Bytes>, k: Bytes|
    if open.contains(k) { acc } else {
      memo_keep.mark(k);
      acc.push(k)
    })

/// Marks each record that read the place, or asked the query, `id` names, each that asked one of
/// those, and so on: what a run that is done settling marks does where its own read moved under it,
/// since a record it took already may stand on one of them. A record is marked before the records
/// that asked it are read, so a run that notes itself among them after that finds the mark.
fn marked_from<| e>(
  queries: Map<Bytes, Query<| e>>,
  id: Bytes,
) -> Unit / {memo_keep.read, memo_keep.write, abort.raise} = {
  let by_hash = queries.fold(Map::new(), |acc: Map<Bytes, Bytes>, _: Bytes, q: Query<| e>|
    acc.insert(q.hash, q.name));
  // What asked the record under `k`: noted under what it asked, read off the record.
  let readers_of = |k: Bytes|
    match memo_keep.record(k) {
      Some(rec) -> match by_hash.get(rec.query) {
        Some(name) -> memo_keep.readers(asked_id(name, rec.input)),
        None -> [],
      },
      None -> [],
    };
  iterate(
    { frontier: memo_keep.readers(id), done: Map::new() },
    1000000,
    |x: { frontier: List<Bytes>, done: Map<Bytes, Bool> }|
      if x.frontier.len() == 0 { Stop(()) } else {
        Continue(
          x.frontier.fold(
            { frontier: [], done: x.done },
            |acc: { frontier: List<Bytes>, done: Map<Bytes, Bool> }, k: Bytes|
              if acc.done.contains(k) { acc } else {
                memo_keep.mark(k);
                {
                  frontier: readers_of(k).fold(acc.frontier, |f: List<Bytes>, r: Bytes| f.push(r)),
                  done: acc.done.insert(k, true),
                }
              },
          ),
        )
      },
  )
}

/// Whether `rec` asked the query and input `id` names.
fn asks(rec: Record, id: Bytes) -> Bool =
  rec.reads.fold(false, |found: Bool, r: Read|
    found
      || (match r {
        Asked(name, input, _) -> asked_id(name, input) == id,
        World(_, _, _) -> false,
      }))

/// The records to raise next, each with the height it is raised above, and those raised already.
type Raising = { frontier: List<{ id: Bytes, height: Int }>, done: Map<Bytes, Bool> }

/// Each record that asked the one `id` names raised above `height`, and each that asked one of those
/// in turn: a record stands above every record it reads, however tall those grew since it ran, so a
/// run settling marks lowest first settles what it reads before it. Records kept by runs apart may
/// ask one another in a circle, which no heights order, so each is raised at most once.
fn raised<| e>(
  queries: Map<Bytes, Query<| e>>,
  id: Bytes,
  height: Int,
) -> Unit / {memo_keep.read, memo_keep.write, abort.raise} = {
  let by_hash = queries.fold(Map::new(), |acc: Map<Bytes, Bytes>, _: Bytes, q: Query<| e>|
    acc.insert(q.hash, q.name));
  iterate({ frontier: [{ id: id, height: height }], done: Map::new() }, 1000000, |x: Raising|
    if x.frontier.len() == 0 { Stop(()) } else {
      Continue(
        x.frontier.fold(
          { frontier: [], done: x.done },
          |st: Raising, f: { id: Bytes, height: Int }|
            memo_keep.readers(f.id).fold(st, |acc: Raising, k: Bytes|
              if acc.done.contains(k) { acc } else {
                match memo_keep.record(k) {
                  // A link outlives the read that made it, so only a record that still asks it is
                  // raised.
                  Some(rec) -> if rec.height > f.height || !asks(rec, f.id) { acc } else {
                    match by_hash.get(rec.query) {
                      Some(name) -> {
                        memo_keep.raise(k, f.height + 1);
                        {
                          frontier: acc.frontier.push({
                            id: asked_id(name, rec.input),
                            height: f.height + 1,
                          }),
                          done: acc.done.insert(k, true),
                        }
                      },
                      None -> acc,
                    }
                  },
                  None -> acc,
                }
              }),
        ),
      )
    })
}

/// The digest of what the world holds at `at` as `kind` reads it, with the store's note of the place
/// brought to it. Where the note says otherwise, `marking` marks the records that read the place,
/// handed what they are noted under, before the note moves, so no record stands on a read that moved
/// unmarked; where another run holds the place, they are marked and the note is left to it.
fn seen_now<| e>(
  queries: Map<Bytes, Query<| e>>,
  kind: Bytes,
  at: Bytes,
  marking: (Bytes) -> Unit / {memo_keep.read, memo_keep.write, abort.raise},
) -> Bytes / {memo_keep.read, memo_keep.write, abort.raise} = {
  let d = digest_at(queries, kind, at);
  if kind == query_kind() { d } else {
    let id = place_id(kind, at);
    match memo_keep.seen(id) {
      Some(s) -> if s.digest != d {
        marking(id);
        memo_keep.see(id, { kind: kind, at: at, digest: d })
      },
      None -> memo_keep.see(id, { kind: kind, at: at, digest: d }),
    };
    d
  }
}

/// [`seen_now`] where a run has settled its marks: a read that moved under it marks all that stands
/// on the place.
fn seen_again<| e>(
  queries: Map<Bytes, Query<| e>>,
  kind: Bytes,
  at: Bytes,
) -> Bytes / {memo_keep.read, memo_keep.write, abort.raise} =
  seen_now(queries, kind, at, |id: Bytes| marked_from(queries, id))

/// A run over the store: each note of the world brought to what the world holds now, the records
/// that read a place that moved marked, and every mark the store holds settled, so a record with no
/// mark stands. A record is answered again only where a read it made moved, and marks the records
/// that asked it only where its answer moved. A record of a query this run does not answer, a
/// command's answer among them, keeps its mark for the run that asks it.
pub fn started<| e>(
  queries: Map<Bytes, Query<| e>>,
) -> Run / {memo_keep.read, memo_keep.write, abort.raise | e} = {
  memo_keep.stamped(stamp_of(queries), hashes_of(queries));
  let vouched = memo_keep.vouches();
  memo_keep.places().fold((), |_: Unit, s: Seen| {
    seen_now(queries, s.kind, s.at, |id: Bytes| {
      marked_readers(id, Map::new());
      ()
    });
    ()
  });
  settled_marks(queries, {
    ..new_run(),
    vouched: vouched,
    settling: true,
    marked: queued(Map::new(), memo_keep.marked()),
  })
}

/// `keys` queued among `pending` by the heights of their records, lowest first: a record settled
/// after every one below it, it reads what each it asks answers now, so it runs once.
fn queued(
  pending: Map<Int, List<Bytes>>,
  keys: List<Bytes>,
) -> Map<Int, List<Bytes>> / {memo_keep.read} =
  keys.fold(pending, |acc: Map<Int, List<Bytes>>, k: Bytes| {
    let h = memo_keep.height(k);
    acc.insert(h, List::push(match acc.get(h) { Some(ks) -> ks, None -> [] }, k))
  })

/// The lowest of `pending`'s records, the height it was queued at, and the rest of them: none where
/// none is left.
fn lowest(
  pending: Map<Int, List<Bytes>>,
) -> Option<{ key: Bytes, height: Int, rest: Map<Int, List<Bytes>> }> = {
  let h = pending.fold(0 - 1, |acc: Int, k: Int, _: List<Bytes>|
    if acc < 0 || k < acc { k } else { acc });
  match pending.get(h) {
    Some([key, ..rest]) ->
      Some({
        key: key,
        height: h,
        rest: if rest.len() == 0 { pending.remove(h) } else { pending.insert(h, rest) },
      }),
    _ -> None,
  }
}

/// `run` with each record it holds marked settled, and each one those mark, until none is left that
/// a query of `queries` answers.
fn settled_marks<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
) -> Run / {memo_keep.read, memo_keep.write, abort.raise | e} = {
  let by_hash = queries.fold(Map::new(), |acc: Map<Bytes, Query<| e>>, _: Bytes, q: Query<| e>|
    acc.insert(q.hash, q));
  let done = iterate(run, 100000000, |r: Run|
    match lowest(r.marked) {
      None -> Stop(r),
      Some(first) -> {
        let key = first.key;
        let next = { ..r, marked: first.rest };
        if memo_keep.marks(key).len() == 0 { Continue(next) }
        // Raised above where it was queued by something it reads, it settles after that.
        else if memo_keep.height(key) > first.height {
          Continue({ ..next, marked: queued(next.marked, [key]) })
        } else {
          match memo_keep.record(key) {
            // A link outlives the record it named, so a place that moves marks keys no record is
            // kept under: those marks mark nothing, and are let go.
            None -> {
              memo_keep.unmark(key, memo_keep.marks(key));
              Continue(next)
            },
            Some(rec) -> match by_hash.get(rec.query) {
              // A record no query of this run answers, a command's answer among them, keeps its
              // mark for the run that asks it.
              None -> Continue(next),
              // Settled again from its record: a mark found after the run settled it means
              // something it read has moved since.
              Some(q) ->
                Continue(
                  settled(
                    queries,
                    { ..next, settled: next.settled.remove(key) },
                    q.name,
                    rec.input,
                    100000,
                  ).run,
                ),
            },
          }
        }
      },
    });
  { ..done, settling: false, marked: Map::new() }
}

/// What the query `name` answers for `input`: its record's answer where nothing it read moved, else
/// its body's, which is kept. The run notes the read as one its driver asked.
pub fn answer<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  name: Bytes,
  input: Bytes,
) -> Answered / {memo_keep.read, memo_keep.write, abort.raise | e} = {
  let q = query_of(queries, name);
  let a = fetched(queries, run, q, key_of(q, input), input, 100000);
  { run: { ..a.run, asked: a.run.asked.push(Asked(name, input, a.head)) }, output: a.output }
}

/// [`answer`], for a query's body: what `q` answers for `input`, kept under `key`, beside the digest
/// it is kept by. `left` is how much deeper the asking may go: deeper than every query a program
/// has, which only a run asking its way around a loop reaches.
fn fetched<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  q: Query<| e>,
  key: Bytes,
  input: Bytes,
  left: Int,
) -> { run: Run, output: Bytes, head: Bytes } / {memo_keep.read, memo_keep.write, abort.raise | e} =
  if left <= 0 { panic(String::of_bytes_lossy(too_deep())) } else {
    let s = settled_at(queries, run, q, key, input, left - 1);
    match memo_keep.output(s.head) {
      Some(o) -> { run: s.run, output: o, head: s.head },
      // An answer no store keeps any more is answered again.
      None -> {
        let e = executed(queries, s.run, q, key, input, [], None, left - 1);
        {
          run: { ..e.run, lost: e.run.lost + 1, settled: e.run.settled.insert(key, e.head) },
          output: match memo_keep.output(e.head) {
            Some(o) -> o,
            None -> panic("a store does not hold an answer it was just handed to keep"),
          },
          head: e.head,
        }
      },
    }
  }

fn took(run: Run, name: Bytes, output: Bytes) -> { run: Run, head: Bytes } =
  { run: { ..run, took: bumped(run.took, name) }, head: output }

/// What the query `name` answers for `input`, by its digest: as kept, in the store or the pack below
/// it, where no mark is on its record or each read it made answers as it did, else as its body
/// answers.
fn settled<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  name: Bytes,
  input: Bytes,
  left: Int,
) -> { run: Run, head: Bytes } / {memo_keep.read, memo_keep.write, abort.raise | e} = {
  let q = query_of(queries, name);
  settled_at(queries, run, q, key_of(q, input), input, left)
}

/// [`settled`] of `q` for `input`, kept under `key`.
fn settled_at<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  q: Query<| e>,
  key: Bytes,
  input: Bytes,
  left: Int,
) -> { run: Run, head: Bytes } / {memo_keep.read, memo_keep.write, abort.raise | e} =
  if left <= 0 { panic(String::of_bytes_lossy(too_deep())) } else {
    let name = q.name;
    match run.settled.get(key) {
      Some(h) -> { run: run, head: h },
      None -> {
        let step = { query: name, input: input };
        if run.open.contains(key) {
          panic(
            "the query `" ++ String::of_bytes_lossy(name) ++ "` asks for its own answer, through"
              ++ run.trail.push(step).fold("", |acc: String, s: { query: Bytes, input: Bytes }|
                acc ++ "\n  " ++ String::of_bytes_lossy(s.query) ++ " "
                  ++ String::of_bytes_lossy(s.input.slice(0, min(s.input.len(), 120)))),
          )
        };
        let opened = { ..run, open: run.open.insert(key, true), trail: run.trail.push(step) };
        let done = match memo_keep.head(key) {
          None -> executed(queries, opened, q, key, input, [], None, left - 1),
          Some(out) -> {
            let marks = memo_keep.marks(key);
            if marks.len() == 0 { took(opened, name, out) } else {
              match memo_keep.record(key) {
                None -> executed(queries, opened, q, key, input, marks, None, left - 1),
                Some(r) -> {
                  let s = stands(queries, opened, r.reads, left - 1);
                  if s.ok {
                    memo_keep.unmark(key, marks);
                    took(s.run, name, r.output)
                  } else {
                    // A record of the pack below noted none of its reads: one answered again notes
                    // them all.
                    let prior = if memo_keep.stored(key) { Some(r) } else { None };
                    // An edit undone answers as before: the record it replaced stands again, its
                    // reads linked to the key since it was first kept.
                    match match prior {
                        Some(_) -> memo_keep.record(earlier_key(key)),
                        None -> None,
                      } {
                      Some(e) -> {
                        let t = stands(queries, s.run, e.reads, left - 1);
                        if t.ok && memo_keep.output(e.output) != None {
                          memo_keep.adopt(earlier_key(key), r);
                          memo_keep.adopt(key, { ..e, height: max(e.height, r.height) });
                          memo_keep.unmark(key, marks);
                          // What asked the answer it replaces asks again where the two differ.
                          took(
                            answer_moved(
                              queries,
                              {
                                ..t.run,
                                restored: t.run.restored.push({ query: name, input: input }),
                              },
                              asked_id(name, input),
                              Some(r.output),
                              e.output,
                            ),
                            name,
                            e.output,
                          )
                        } else { executed(queries, t.run, q, key, input, marks, prior, left - 1) }
                      },
                      None -> executed(queries, s.run, q, key, input, marks, prior, left - 1),
                    }
                  }
                },
              }
            }
          },
        };
        {
          run: {
            ..done.run,
            settled: done.run.settled.insert(key, done.head),
            open: done.run.open.remove(key),
            trail: run.trail,
          },
          head: done.head,
        }
      },
    }
  }

/// Whether the record under `key` would be taken without its body running, worked out with no body
/// run: the run settled it, or the store vouches for it, or the store only left it unchecked and
/// each read it made answers now as it did, each record it asked judged the same way. One being
/// answered now, marked, or held by no store would not. What is judged is kept in the run.
fn would_stand<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  key: Bytes,
  left: Int,
) -> { run: Run, ok: Bool } / {memo_keep.read, abort.raise} =
  if left <= 0 { panic(String::of_bytes_lossy(too_deep())) }
  else if run.settled.contains(key) { { run: run, ok: true } }
  else if run.open.contains(key) || memo_keep.head(key) == None { { run: run, ok: false } } else {
    let marks = memo_keep.marks(key);
    if marks.len() == 0 { { run: run, ok: true } }
    else if marks != [unchecked()] { { run: run, ok: false } } else {
      match run.judged.get(key) {
        Some(ok) -> { run: run, ok: ok },
        None -> {
          let read = match memo_keep.record(key) {
            None -> { run: run, ok: false },
            Some(rec) ->
              rec.reads.fold({ run: run, ok: true }, |acc: { run: Run, ok: Bool }, r: Read|
                if !acc.ok { acc } else {
                  match r {
                    World(kind, at, digest) ->
                      { run: acc.run, ok: digest_at(queries, kind, at) == digest },
                    Asked(name, input, head) -> match queries.get(name) {
                      None -> { run: acc.run, ok: false },
                      Some(q) -> {
                        let asked = key_of(q, input);
                        let w = would_stand(queries, acc.run, asked, left - 1);
                        {
                          run: w.run,
                          ok: w.ok
                            && (match w.run.settled.get(asked) {
                              Some(h) -> Some(h),
                              None -> memo_keep.head(asked),
                            })
                            == Some(head),
                        }
                      },
                    },
                  }
                }),
          };
          { run: { ..read.run, judged: read.run.judged.insert(key, read.ok) }, ok: read.ok }
        },
      }
    }
  }

/// Whether each of `reads` answers now what it answered when kept, asked in order and no further
/// than the first that does not.
fn stands<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  reads: List<Read>,
  left: Int,
) -> { run: Run, ok: Bool } / {memo_keep.read, memo_keep.write, abort.raise | e} =
  if left <= 0 { panic(String::of_bytes_lossy(too_deep())) } else {
    reads.fold({ run: run, ok: true }, |acc: { run: Run, ok: Bool }, r: Read|
      if !acc.ok { acc } else {
        match r {
          World(kind, at, digest) -> { run: acc.run, ok: seen_again(queries, kind, at) == digest },
          Asked(name, input, digest) -> {
            let a = settled(queries, acc.run, name, input, left - 1);
            { run: a.run, ok: a.head == digest }
          },
        }
      })
  }

/// What a record's reads are noted under among the readers of what they read: a read of a query's
/// hash under nothing, since a run under other hashes checks every record it takes.
fn read_ids(reads: List<Read>) -> Map<Bytes, Bool> =
  reads.fold(Map::new(), |acc: Map<Bytes, Bool>, r: Read|
    match r {
      World(kind, at, _) -> if kind == query_kind() { acc }
      else { acc.insert(place_id(kind, at), true) },
      Asked(name, input, _) -> acc.insert(asked_id(name, input), true),
    })

/// What the records that asked the query `name` for `input` are noted under among its readers: the
/// same whatever its definition hashes to, so a record still stands on the answer of a query whose
/// definition moved under it, and is marked where that answer moves.
fn asked_id(name: Bytes, input: Bytes) -> Bytes =
  blake3(Bytes::concat_all([b"ply.memo.asked\x00", sized(name), input]))

/// `run` once the answer a query answers for an input, noted under `id` among what its readers read,
/// is to be `now` where it was `before`: where it moves, the records that asked it are marked before
/// it does. A run settling marks settles theirs next; one done settling marks all that stands on
/// the record, since it may have taken one of them already.
fn answer_moved<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  id: Bytes,
  before: Option<Bytes>,
  now: Bytes,
) -> Run / {memo_keep.read, memo_keep.write, abort.raise} =
  match before {
    None -> run,
    Some(b) -> if b == now { run }
    else if run.settling { { ..run, marked: queued(run.marked, marked_readers(id, run.open)) } }
    else {
      marked_from(queries, id);
      run
    },
  }

/// Whether `o` still stands as what its key answers: the last run of the body that offered it made
/// it, and nothing that run read has been found moved since it ended. What a body offers it works
/// out from what it read, so taking it past either would keep an answer under reads that never
/// made it.
fn offer_stands(run: Run, o: Offer) -> Bool / {memo_keep.read} =
  run.runs.get(o.from) == Some(o.nth)
    && (run.open.contains(o.from) || memo_keep.marks(o.from).len() == 0)

/// `q`'s body run for `input`, its record kept under `key`, and `marks`, the marks a run found on
/// the record before running it, removed. Each read is noted among the readers of what it reads
/// before it reads it, so a run that marks what it read after that marks the record too; `prior`,
/// the record the key held, has its reads noted already. A read of the world is asked again once the
/// body has answered, and a record whose read moved meanwhile is kept marked.
fn executed<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  q: Query<| e>,
  key: Bytes,
  input: Bytes,
  marks: List<Bytes>,
  prior: Option<Record>,
  left: Int,
) -> { run: Run, head: Bytes } / {memo_keep.read, memo_keep.write, abort.raise | e} =
  if left <= 0 { panic(String::of_bytes_lossy(too_deep())) } else {
    let linked = match prior { Some(r) -> read_ids(r.reads), None -> Map::new() };
    let before = memo_keep.head(key);
    with_cell[memo]({
        run: {
          ..run,
          ran: bumped(run.ran, q.name),
          inputs: run.inputs.push({ query: q.name, input: input }),
          runs: bumped(run.runs, key),
        },
        reads: [],
        worlds: Map::new(),
        linked: linked,
        unsure: false,
        height: 1,
      }) { st -> {
      // Whether the read `id` names was newly noted.
      let link = |id: Bytes| {
        let s = cell_get(st);
        if s.linked.contains(id) { false } else {
          memo_keep.link(id, key);
          cell_set(st, { ..s, linked: s.linked.insert(id, true) });
          true
        }
      };
      let world = |kind: Bytes, at: Bytes| {
        if kind != query_kind() {
          link(place_id(kind, at));
          ()
        };
        let found = now_at(queries, kind, at);
        let d = digest_at(queries, kind, at);
        let s = cell_get(st);
        // A place read again to the same answer is one read.
        let seen = place_id(kind, at).concat(d);
        if !s.worlds.contains(seen) {
          cell_set(st, {
            ..s,
            reads: s.reads.push(World(kind, at, d)),
            worlds: s.worlds.insert(seen, true),
          })
        };
        found
      };
      // What the query `name` answers for `asked`, noted as a read of the body: with `whole`, the
      // answer beside its digest.
      let asking = |name: Bytes, asked: Bytes, whole: Bool| {
        let aq = query_of(queries, name);
        let akey = key_of(aq, asked);
        let fresh = link(asked_id(name, asked));
        let before = cell_get(st).run;
        // An answer settled before this read was noted may have been marked since.
        let unsure = fresh && before.settled.contains(akey) && memo_keep.marks(akey).len() > 0;
        let a = if whole { fetched(queries, before, aq, akey, asked, left - 1) } else {
          let s = settled_at(queries, before, aq, akey, asked, left - 1);
          { run: s.run, output: b"", head: s.head }
        };
        let above = memo_keep.height(akey) + 1;
        let s = cell_get(st);
        cell_set(st, {
          ..s,
          run: a.run,
          reads: s.reads.push(Asked(name, asked, a.head)),
          unsure: s.unsure || unsure,
          height: if above > s.height { above } else { s.height },
        });
        a
      };
      // `output` offered as what `name` answers for `asked`, read as the definition of `by`.
      let offering = |by: Bytes, name: Bytes, asked: Bytes, output: Bytes| {
        let s = cell_get(st);
        cell_set(st, {
          ..s,
          run: {
            ..s.run,
            offers: s.run.offers.insert(key_of(query_of(queries, name), asked), {
              output: output,
              by: by,
              from: key,
              nth: match s.run.runs.get(key) { Some(n) -> n, None -> 0 },
            }),
          },
        })
      };
      let output = handle {
        (q.body)(input)
      } with {
        memo.world(kind, at) -> world(kind, at),
        memo.ask(name, asked) -> asking(name, asked, true).output,
        memo.head(name, asked) -> asking(name, asked, false).head,
        memo.held(digest) -> memo_keep.output(digest),
        memo.kept(name, asked) -> {
          let k = key_of(query_of(queries, name), asked);
          let s = cell_get(st);
          let w = would_stand(queries, s.run, k, left - 1);
          cell_set(st, { ..s, run: w.run });
          w.ok || (match w.run.offers.get(k) { Some(o) -> offer_stands(w.run, o), None -> false })
        },
        memo.offer(name, asked, output) -> offering(q.name, name, asked, output),
        memo.offer_as(by, name, asked, output) ->
          offering(query_of(queries, by).name, name, asked, output),
        memo.offered() -> {
          let s = cell_get(st);
          match s.run.offers.get(key) {
            None -> None,
            Some(o) -> {
              cell_set(st, { ..s, run: { ..s.run, offers: s.run.offers.remove(key) } });
              if offer_stands(s.run, o) {
                world(query_kind(), o.by);
                Some(o.output)
              } else { None }
            },
          }
        },
      };
      let s = cell_get(st);
      let moved = s.reads.fold(s.unsure, |m: Bool, r: Read|
        match r {
          World(kind, at, d) -> m || seen_again(queries, kind, at) != d,
          Asked(_, _, _) -> m,
        });
      if moved { memo_keep.mark(key) };
      let d = digest_of(Some(output));
      let changed = answer_moved(queries, s.run, asked_id(q.name, input), before, d);
      // A height only orders settling, so it never falls: a record that read less for a while (its
      // group gone, say) still settles after what it reads once it reads it again.
      let was = memo_keep.height(key);
      let height = if was > s.height { was } else { s.height };
      let rec = { query: q.hash, input: input, reads: s.reads, output: d, height: height };
      kept_earlier(key, rec);
      memo_keep.keep(key, rec, output);
      // A new record's askers take their heights from it as they finish; one that grew lifts those
      // that asked it before.
      if was > 0 && height > was { raised(queries, asked_id(q.name, input), height) };
      if marks.len() > 0 { memo_keep.unmark(key, marks) };
      { run: changed, head: d }
    } }
  }

// --- Answers made over what a driver asked ---------------------------------------------------
// A command's answer is a function of what its run asked and of the places it names, so it is kept
// as a record of those reads, marked as any record is and taken back without the run.

/// What is kept under `key`, an answer made over what a run's driver asked: its answer where no mark
/// is on its record or each of its reads answers as it did; beside the marks found on it, which
/// keeping it again removes.
pub fn standing<| e>(
  queries: Map<Bytes, Query<| e>>,
  run: Run,
  key: Bytes,
) -> { run: Run, output: Option<Bytes>, marks: List<Bytes> } / {memo_keep.read, memo_keep.write, abort.raise | e} =
  match memo_keep.head(key) {
    None -> { run: run, output: None, marks: [] },
    Some(out) -> {
      let marks = memo_keep.marks(key);
      if marks.len() == 0 { { run: run, output: memo_keep.output(out), marks: [] } } else {
        match memo_keep.record(key) {
          None -> { run: run, output: None, marks: marks },
          Some(r) -> {
            let s = stands(queries, run, r.reads, 100000);
            if s.ok {
              memo_keep.unmark(key, marks);
              { run: s.run, output: memo_keep.output(out), marks: [] }
            } else { { run: s.run, output: None, marks: marks } }
          },
        }
      }
    },
  }

/// `output` kept under `key` as an answer made over `reads` by what `hash` names, with `marks`, the
/// marks [`standing`] found on its record, removed. Each read is noted among the readers of what it
/// read and then asked again, so one that moved since it was made leaves the record marked.
pub fn recorded<| e>(
  queries: Map<Bytes, Query<| e>>,
  key: Bytes,
  hash: Bytes,
  reads: List<Read>,
  output: Bytes,
  marks: List<Bytes>,
) -> Unit / {memo_keep.read, memo_keep.write, abort.raise} = {
  memo_keep.stamped(stamp_of(queries), hashes_of(queries));
  let noted = match memo_keep.record(key) { Some(r) -> read_ids(r.reads), None -> Map::new() };
  read_ids(reads).fold((), |_: Unit, id: Bytes, _: Bool|
    if !noted.contains(id) { memo_keep.link(id, key) });
  // Every read is asked again, so each place it read is noted.
  let moved = reads.fold(false, |m: Bool, r: Read| {
    let now = match r {
      World(kind, at, d) -> seen_again(queries, kind, at) != d,
      Asked(name, input, d) -> {
        let q = query_of(queries, name);
        let k = key_of(q, input);
        memo_keep.marks(k).len() > 0 || memo_keep.head(k) != Some(d)
      },
    };
    m || now
  });
  if moved { memo_keep.mark(key) };
  let rec = { query: hash, input: b"", reads: reads, output: digest_of(Some(output)), height: 0 };
  kept_earlier(key, rec);
  memo_keep.keep(key, rec, output);
  if marks.len() > 0 { memo_keep.unmark(key, marks) }
}

// --- A store held in memory ------------------------------------------------------------------

/// What a run said of a key: the stamp it ran under, whether the record stands, and whether the run
/// brought the record or only checked it.
type Vouch = { stamp: Bytes, stands: Bool, fresh: Bool }

/// A store held in memory: what a store laid out as a directory holds in files. `said` holds what
/// each run said of each key, the newest first.
pub type Held = {
  records: Map<Bytes, Record>,
  outputs: Map<Bytes, Bytes>,
  seen: Map<Bytes, Seen>,
  readers: Map<Bytes, Map<Bytes, Bool>>,
  marks: Map<Bytes, List<Bytes>>,
  said: Map<Bytes, List<Vouch>>,
  minted: Int,
}

pub fn nothing_held() -> Held =
  {
    records: Map::new(),
    outputs: Map::new(),
    seen: Map::new(),
    readers: Map::new(),
    marks: Map::new(),
    said: Map::new(),
    minted: 0,
  }

/// Whether a run under `stamp` takes the record `said` is of without asking its reads again.
fn vouched(said: List<Vouch>, stamp: Bytes) -> Bool =
  said.fold(None, |settled: Option<Bool>, v: Vouch|
      match settled {
        Some(_) -> settled,
        None -> settles({ own: v.stamp == stamp, stands: v.stands, fresh: v.fresh }),
      })
    == Some(true)

fn saying(h: Held, key: Bytes, v: Vouch) -> Map<Bytes, List<Vouch>> =
  h.said.insert(key, match h.said.get(key) { Some(vs) -> [v].concat(vs), None -> [v] })

/// `work` run over `held`, with `look` answering what the world holds now: what it answered, and the
/// store with what it kept. A record or an answer `held` lacks is asked of the pack below it, read
/// through `read`, which answers what a frame of the pack's file holds. `world` lists the shipped
/// files the run reads: the pack's records stand as they are where they were made under the run's
/// stamp over those very files, and are held to their reads otherwise (`packs`).
pub fn over_held<a | e>(
  held: Held,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_keep.read, memo_keep.write, abort.raise},
) -> { held: Held, value: a } / {abort.raise | e} =
  with_cell[held](held) { cell ->
    with_cell[inlined](Map::new()) { inlined ->

      // The stamp the run answers under, what it saw at each place it looked at, the pack below its
      // store, whether the pack's records stand as they are, each of them read, and those this run
      // found standing.
      with_cell[running]({
          stamp: b"",
          looked: Map::new(),
          pack: packs::opened(read),
          trusted: false,
          packed: Map::new(),
          checked: Map::new(),
        }) { running -> {
        // A packed record, read once a run, beside the answer it holds, which a later ask of the
        // answer reads.
        let packed_at = |key: Bytes| {
          let r = cell_get(running);
          match r.packed.get(key) {
            Some(rec) -> rec,
            None -> {
              let found = packs::record(r.pack, read, key);
              let rec = match found.bytes {
                None -> None,
                Some(b) -> match record_from(b) {
                  None -> None,
                  Some(rec) -> {
                    match inline_named(b) {
                      Some(o) -> cell_set(inlined, cell_get(inlined).insert(rec.output, o)),
                      None -> (),
                    };
                    Some(rec)
                  },
                },
              };
              let now = cell_get(running);
              cell_set(running, {
                ..now,
                pack: found.reading,
                packed: now.packed.insert(key, rec),
              });
              rec
            },
          }
        };
        let held_or_packed = |key: Bytes|
          match cell_get(cell).records.get(key) { Some(r) -> Some(r), None -> packed_at(key) };
        let looked = |kind: Bytes, at: Bytes| {
          let id = place_id(kind, at);
          match cell_get(running).looked.get(id) {
            Some(x) -> x,
            None -> {
              let value = look(kind, at);
              let x = { value: value, digest: digest_of(value) };
              let r = cell_get(running);
              cell_set(running, { ..r, looked: r.looked.insert(id, x) });
              x
            },
          }
        };
        let marking = |key: Bytes| {
          let h = cell_get(cell);
          let ms = match h.marks.get(key) { Some(ms) -> ms, None -> [] };
          cell_set(cell, {
            ..h,
            marks: h.marks.insert(key, ms.push(Bytes::of_string(h.minted.to_string()))),
            said: saying(h, key, { stamp: cell_get(running).stamp, stands: false, fresh: false }),
            minted: h.minted + 1,
          })
        };
        let value = handle {
          work()
        } with {
          memo_keep.head(key) -> match held_or_packed(key) {
            Some(r) -> Some(r.output),
            None -> None,
          },
          memo_keep.height(key) -> match held_or_packed(key) { Some(r) -> r.height, None -> 0 },
          memo_keep.record(key) -> held_or_packed(key),
          memo_keep.stored(key) -> cell_get(cell).records.contains(key),
          memo_keep.output(digest) -> match cell_get(cell).outputs.get(digest) {
            Some(o) -> Some(o),
            None -> match cell_get(inlined).get(digest) {
              Some(o) -> Some(o),
              None -> {
                let r = cell_get(running);
                let found = packs::answer(r.pack, read, digest);
                cell_set(running, { ..r, pack: found.reading });
                found.bytes
              },
            },
          },
          memo_keep.keep(key, rec, output) -> {
            let h = cell_get(cell);
            cell_set(cell, {
              ..h,
              records: h.records.insert(key, rec),
              outputs: h.outputs.insert(rec.output, output),
              said: saying(h, key, { stamp: cell_get(running).stamp, stands: true, fresh: true }),
            })
          },
          memo_keep.adopt(key, rec) -> {
            let h = cell_get(cell);
            // An answer its record holds is held beside the record kept again.
            cell_set(cell, {
              ..h,
              records: h.records.insert(key, rec),
              outputs: match cell_get(inlined).get(rec.output) {
                Some(o) -> h.outputs.insert(rec.output, o),
                None -> h.outputs,
              },
              said: saying(h, key, { stamp: cell_get(running).stamp, stands: true, fresh: true }),
            })
          },
          memo_keep.raise(key, height) -> {
            let h = cell_get(cell);
            match h.records.get(key) {
              Some(rec) -> if height > rec.height {
                cell_set(cell, { ..h, records: h.records.insert(key, { ..rec, height: height }) })
              },
              None -> (),
            }
          },
          memo_keep.now(kind, at) -> looked(kind, at).value,
          memo_keep.digest(kind, at) -> looked(kind, at).digest,
          memo_keep.places() -> cell_get(cell).seen.values(),
          memo_keep.seen(id) -> cell_get(cell).seen.get(id),
          memo_keep.see(id, s) -> {
            let h = cell_get(cell);
            cell_set(cell, { ..h, seen: h.seen.insert(id, s) })
          },
          memo_keep.readers(id) -> match cell_get(cell).readers.get(id) {
            Some(ks) -> ks.keys(),
            None -> [],
          },
          memo_keep.link(id, key) -> {
            let h = cell_get(cell);
            let ks = match h.readers.get(id) { Some(ks) -> ks, None -> Map::new() };
            cell_set(cell, { ..h, readers: h.readers.insert(id, ks.insert(key, true)) })
          },
          memo_keep.marks(key) -> {
            let h = cell_get(cell);
            let left = match h.marks.get(key) { Some(ms) -> ms, None -> [] };
            if left.len() > 0 { left } else if h.records.contains(key) {
              let said = match h.said.get(key) { Some(vs) -> vs, None -> [] };
              if vouched(said, cell_get(running).stamp) { [] } else { [unchecked()] }
            }
            // A record of the pack below stands as it is only where the pack does, or where this
            // run checked it: it notes no reads, so no later run is told that one moved.
            else if cell_get(running).trusted || cell_get(running).checked.contains(key)
                || packed_at(key) == None { [] }
            else { [unchecked()] }
          },
          memo_keep.marked() ->
            cell_get(cell).marks.fold([], |acc: List<Bytes>, k: Bytes, ms: List<Bytes>|
              if ms.len() == 0 { acc } else { acc.push(k) }),
          memo_keep.mark(key) -> marking(key),
          memo_keep.unmark(key, gone) -> {
            let h = cell_get(cell);
            let ms = match h.marks.get(key) { Some(ms) -> ms, None -> [] };
            cell_set(cell, {
              ..h,
              marks: h.marks.insert(key, ms.filter(|m: Bytes| !gone.contains(m))),
              said: if !h.records.contains(key) { h.said } else {
                saying(h, key, { stamp: cell_get(running).stamp, stands: true, fresh: false })
              },
            });
            if !h.records.contains(key) {
              let r = cell_get(running);
              cell_set(running, { ..r, checked: r.checked.insert(key, true) })
            }
          },
          memo_keep.stamped(stamp, _) -> {
            let r = cell_get(running);
            cell_set(running, {
              ..r,
              stamp: packs::above(r.pack.index, stamp, world),
              trusted: match r.pack.index {
                Some(i) -> packs::stands(i, stamp, world),
                None -> false,
              },
            })
          },
          memo_keep.vouches() -> {
            let stamp = cell_get(running).stamp;
            cell_get(cell).said.fold(false, |any: Bool, _: Bytes, vs: List<Vouch>|
              any || vs.fold(false, |b: Bool, v: Vouch| b || v.stamp == stamp))
          },
        };
        { held: cell_get(cell), value: value }
      } }
    }
  }

/// `work` run with no store of its own, over the pack `read` reads as [`over_held`] does: each record
/// it keeps lives only as long as the run.
pub fn fresh<a | e>(
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_keep.read, memo_keep.write, abort.raise},
) -> a / {abort.raise | e} = over_held(nothing_held(), read, world, look, work).value

// --- Tests ----------------------------------------------------------------------------------

type World = { files: Map<Bytes, Bytes>, held: Held, read: Int }

fn test_world(files: List<{ at: Bytes, text: Bytes }>) -> World =
  {
    files: files.fold(Map::new(), |acc: Map<Bytes, Bytes>, f: { at: Bytes, text: Bytes }|
      acc.insert(f.at, f.text)),
    held: nothing_held(),
    read: 0,
  }

fn length_of(input: Bytes) -> Bytes / {memo.read} =
  match memo.world(b"file", input) {
    Some(text) -> Bytes::of_string(text.len().to_string()),
    None -> b"none",
  }

fn longer(input: Bytes) -> Bytes / {memo.read} = {
  let n = memo.ask(b"length", input);
  b"long ".concat(n)
}

fn test_queries(length_hash: Bytes) -> Map<Bytes, Query<| {}>> =
  Map::new().insert(b"length", { name: b"length", hash: length_hash, body: length_of }).insert(
    b"longer",
    { name: b"longer", hash: b"l1", body: longer },
  )

/// `name` asked of `input` over `w` from a run of its own: what it answered, how many bodies ran,
/// how many times it read the world, and the world it left.
fn asked_over(
  queries: Map<Bytes, Query<| {}>>,
  w: World,
  name: Bytes,
  input: Bytes,
) -> { output: Bytes, executed: Int, lost: Int, read: Int, world: World } / {abort.raise} =
  asked_with(queries, w, None, None, name, input)

/// [`asked_over`], with `packed` below the run's store, made over files `w`'s are listed against,
/// and the world holding `after` from its second read on, where that is given.
fn asked_with(
  queries: Map<Bytes, Query<| {}>>,
  w: World,
  packed: Option<packs::Written>,
  after: Option<Map<Bytes, Bytes>>,
  name: Bytes,
  input: Bytes,
) -> { output: Bytes, executed: Int, lost: Int, read: Int, world: World } / {abort.raise} =
  with_cell[test_memo](0) { reads -> {
    let done = over_held(
      w.held,
      |path: String, offset: Int, len: Int| packs::frame_in(packed, path, offset, len),
      files_of(w),
      |_: Bytes, at: Bytes| {
        let n = cell_get(reads);
        cell_set(reads, n + 1);
        match after {
          Some(files) -> if n > 0 { files.get(at) } else { w.files.get(at) },
          None -> w.files.get(at),
        }
      },
      || {
        let a = answer(queries, started(queries), name, input);
        { output: a.output, executed: ran_total(a.run), lost: lost_in(a.run) }
      },
    );
    {
      output: done.value.output,
      executed: done.value.executed,
      lost: done.value.lost,
      read: cell_get(reads),
      world: { ..w, held: done.held, read: cell_get(reads) },
    }
  } }

fn edited(w: World, at: Bytes, text: Bytes) -> World = { ..w, files: w.files.insert(at, text) }

test "a query's record answers again while what it read answers the same" {
  let q = test_queries(b"h1");
  let first = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  assert_eq(first.output, b"4");
  assert_eq(first.executed, 1);
  let again = asked_over(q, first.world, b"length", b"a");
  assert_eq(again.output, b"4");
  assert_eq(again.executed, 0);
  let moved = asked_over(q, edited(again.world, b"a", b"seven!!"), b"length", b"a");
  assert_eq(moved.output, b"7");
  assert_eq(moved.executed, 1)
}

test "an answer that comes out the same stops what an edit moves" {
  let q = test_queries(b"h1");
  let first = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"longer", b"a");
  assert_eq(first.output, b"long 4");
  assert_eq(first.executed, 2);
  // Another text of the same length: `length` runs again and answers the same, so `longer` stands.
  let same = asked_over(q, edited(first.world, b"a", b"FOUR"), b"longer", b"a");
  assert_eq(same.output, b"long 4");
  assert_eq(same.executed, 1);
  let longer_now = asked_over(q, edited(same.world, b"a", b"forty"), b"longer", b"a");
  assert_eq(longer_now.output, b"long 5");
  assert_eq(longer_now.executed, 2)
}

test "an edit undone answers as before with no body run, from the records it replaced" {
  let q = test_queries(b"h1");
  let first = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"longer", b"a");
  let moved = asked_over(q, edited(first.world, b"a", b"forty"), b"longer", b"a");
  assert_eq(moved.output, b"long 5");
  assert_eq(moved.executed, 2);
  let undone = asked_over(q, edited(moved.world, b"a", b"four"), b"longer", b"a");
  assert_eq(undone.output, b"long 4");
  assert_eq(undone.executed, 0);
  // And done again: the record undoing replaced is the earlier one now.
  let redone = asked_over(q, edited(undone.world, b"a", b"forty"), b"longer", b"a");
  assert_eq(redone.output, b"long 5");
  assert_eq(redone.executed, 0)
}

test "what a driver's asks reach leaves out a record the run settled for a mark" {
  let q = test_queries(b"h1");
  let every = Map::new().insert(b"h1", true).insert(b"l1", true);
  let files = |b: Bytes| Map::new().insert(b"a", b"four").insert(b"b", b);
  let first = over_held(
    nothing_held(),
    packs::no_pack,
    b"",
    |_: Bytes, at: Bytes| files(b"six!!!").get(at),
    || {
      let a = answer(q, started(q), b"longer", b"a");
      reached(q, every, answer(q, a.run, b"longer", b"b").run).len()
    },
  );
  assert_eq(first.value, 4);
  let second = over_held(
    first.held,
    packs::no_pack,
    b"",
    |_: Bytes, at: Bytes| files(b"seven!!").get(at),
    || {
      let a = answer(q, started(q), b"longer", b"a");
      { ran: ran_total(a.run), keys: reached(q, every, a.run) }
    },
  );
  // `b` moved, so the run answered what read it again; its driver asked only of `a`.
  assert_eq(second.value.ran, 2);
  assert_eq(second.value.keys.len(), 2);
  assert(second.value.keys.contains(key_of(query_of(q, b"longer"), b"a")));
  assert(second.value.keys.contains(key_of(query_of(q, b"length"), b"a")))
}

fn loudest(input: Bytes) -> Bytes / {memo.read} = memo.ask(b"longer", input).concat(b"!")

fn loudest_by_digest(input: Bytes) -> Bytes / {memo.read} =
  Bytes::concat(
    match memo.held(memo.head(b"longer", input)) {
      Some(b) -> b,
      None -> memo.ask(b"longer", input),
    },
    b"!",
  )

test "an answer asked for by its digest is the read an ask makes, and is handed over by it" {
  let by = |body: (Bytes) -> Bytes / {memo.read}|
    test_queries(b"h1").insert(b"loudest", { name: b"loudest", hash: b"d1", body: body });
  let asked = asked_over(by(loudest), test_world([{ at: b"a", text: b"four" }]), b"loudest", b"a");
  let headed = asked_over(
    by(loudest_by_digest),
    test_world([{ at: b"a", text: b"four" }]),
    b"loudest",
    b"a",
  );
  assert_eq(headed.output, b"long 4!");
  assert_eq(headed.world.held.records, asked.world.held.records);
  // The read stands as an ask's does: an edit that moves the answer below runs the body again.
  let moved = asked_over(
    by(loudest_by_digest),
    edited(headed.world, b"a", b"forty"),
    b"loudest",
    b"a",
  );
  assert_eq(moved.output, b"long 5!");
  assert_eq(moved.executed, 3)
}

test "a store held in memory vouches to a run of a stamp that kept in it, and to no other" {
  let vouched_over = |held: Held, hash: Bytes| {
    let q = test_queries(hash);
    over_held(held, packs::no_pack, b"", |_: Bytes, _: Bytes| Some(b"four"), ||
      vouched_to(answer(q, started(q), b"length", b"a").run))
  };
  let first = vouched_over(nothing_held(), b"h1");
  assert(!first.value);
  assert(vouched_over(first.held, b"h1").value);
  assert(!vouched_over(first.held, b"h2").value)
}

test "an edit marks the records that read what moved, and what asked them only where it moved" {
  let q = test_queries(b"h1").insert(b"loudest", { name: b"loudest", hash: b"d1", body: loudest });
  let first = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"loudest", b"a");
  assert_eq(first.output, b"long 4!");
  // Another text of the same length: `length` answers alike, so neither query above it is marked.
  let same = asked_over(q, edited(first.world, b"a", b"FOUR"), b"loudest", b"a");
  assert_eq(same.output, b"long 4!");
  assert_eq(same.executed, 1);
  assert_eq(same.world.held.minted - first.world.held.minted, 1);
  // A longer text moves each answer, and each query above it is marked once as the one below moves.
  let moved = asked_over(q, edited(same.world, b"a", b"forty"), b"loudest", b"a");
  assert_eq(moved.output, b"long 5!");
  assert_eq(moved.executed, 3);
  assert_eq(moved.world.held.minted - same.world.held.minted, 3)
}

test "a run where nothing moved reads each place once and asks no record's reads again" {
  let q = test_queries(b"h1");
  let first = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"longer", b"a");
  let again = asked_over(q, first.world, b"longer", b"a");
  assert_eq(again.output, b"long 4");
  assert_eq(again.executed, 0);
  assert_eq(again.read, 1)
}

test "the run that sees a place move settles what read it and what asked that, asked or not" {
  let q = test_queries(b"h1");
  let first = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"longer", b"a");
  let moved = asked_over(q, edited(first.world, b"a", b"forty"), b"length", b"a");
  assert_eq(moved.output, b"5");
  assert_eq(moved.executed, 2);
  let later = asked_over(q, moved.world, b"longer", b"a");
  assert_eq(later.output, b"long 5");
  assert_eq(later.executed, 0)
}

test "a query whose definition moved answers anew, and what asked it stands where it answers alike" {
  let first = asked_over(
    test_queries(b"h1"),
    test_world([{ at: b"a", text: b"four" }]),
    b"longer",
    b"a",
  );
  let moved = asked_over(test_queries(b"h2"), first.world, b"longer", b"a");
  assert_eq(moved.output, b"long 4");
  assert_eq(moved.executed, 1)
}

test "what stood through a definition that moved under it is marked where that answer moves later" {
  let first = asked_over(
    test_queries(b"h1"),
    test_world([{ at: b"a", text: b"four" }]),
    b"longer",
    b"a",
  );
  // `length` is defined anew and answers alike, so `longer` stands on it.
  let stood = asked_over(test_queries(b"h2"), first.world, b"longer", b"a");
  assert_eq(stood.executed, 1);
  // Its answer moves now: `longer`, which asked it under its earlier definition, answers anew.
  let moved = asked_over(test_queries(b"h2"), edited(stood.world, b"a", b"forty"), b"longer", b"a");
  assert_eq(moved.output, b"long 5");
  assert_eq(moved.executed, 2)
}

test "a query whose definition moved marks what asked it, though nothing it read moved" {
  let q1 = test_queries(b"h1").insert(b"length", {
    name: b"length",
    hash: b"h1",
    body: |input: Bytes| length_of(input),
  });
  let first = asked_over(q1, test_world([{ at: b"a", text: b"four" }]), b"longer", b"a");
  let counting_twice = test_queries(b"h2").insert(b"length", {
    name: b"length",
    hash: b"h2",
    body: |input: Bytes|
      match memo.world(b"file", input) {
        Some(text) -> Bytes::of_string(Int::to_string(2 * text.len())),
        None -> b"none",
      },
  });
  let moved = asked_over(counting_twice, first.world, b"longer", b"a");
  assert_eq(moved.output, b"long 8");
  assert_eq(moved.executed, 2)
}

test "a read that moved while its body ran leaves the record marked for the next run" {
  let q = test_queries(b"h1");
  let edited_after = Map::new().insert(b"a", b"forty");
  let first = asked_with(
    q,
    test_world([{ at: b"a", text: b"four" }]),
    None,
    Some(edited_after),
    b"length",
    b"a",
  );
  assert_eq(first.output, b"4");
  let next = asked_over(q, edited(first.world, b"a", b"forty"), b"length", b"a");
  assert_eq(next.output, b"5");
  assert_eq(next.executed, 1)
}

/// A pack of what `held` holds, written with nothing compressed, made under the stamp of `queries`
/// over the files `files` lists.
pub fn packed_of<| e>(
  held: Held,
  queries: Map<Bytes, Query<| e>>,
  files: Bytes,
) -> packs::Written / {abort.raise} = {
  let records = held.records.fold(
    { writing: packs::writing(), placed: Map::new(), answered: Map::new() },
    |acc: { writing: packs::Writing, placed: Map<Bytes, packs::Range>, answered: Map<Bytes, Bytes> }, k: Bytes, r: Record| {
      let inline = match held.outputs.get(r.output) { Some(o) -> kept_inline(o), None -> None };
      let f = packs::framing(acc.writing, record_bytes(r, inline), packs::as_is);
      {
        writing: f.writing,
        placed: acc.placed.insert(k, f.at),
        answered: acc.answered.insert(k, r.output),
      }
    },
  );
  let answers = held.records.fold(
    { writing: records.writing, placed: Map::new() },
    |acc: { writing: packs::Writing, placed: Map<Bytes, packs::Range> }, _: Bytes, r: Record|
      match ((held.outputs.get(r.output), packs::answer_key(r.output))) {
        (Some(o), Some(name)) -> if kept_inline(o) != None || acc.placed.contains(name) { acc }
        else {
          let f = packs::framing(acc.writing, o, packs::as_is);
          { writing: f.writing, placed: acc.placed.insert(name, f.at) }
        },
        _ -> acc,
      },
  );
  packs::finished(
    answers.writing,
    records.placed,
    answers.placed,
    records.answered,
    packs::as_is,
    stamp_of(queries),
    files,
  )
}

/// What `w`'s files are, as a run lists the files a pack below it was made over.
fn files_of(w: World) -> Bytes =
  Bytes::concat_all(
    w.files.fold([], |acc: List<Bytes>, at: Bytes, text: Bytes|
      acc.push(at).push(b" ").push(blake3(text)).push(b"\n")),
  )

/// The pack cut from `held` over the world `w`'s files, for the queries `q`.
fn pack_over(q: Map<Bytes, Query<| {}>>, w: World) -> packs::Written / {abort.raise} =
  packed_of(w.held, q, files_of(w))

test "a packed answer stands as it is over the very files it was made over, and nothing is kept of it" {
  let q = test_queries(b"h1");
  let four = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let first = asked_with(
    q,
    test_world([{ at: b"a", text: b"four" }]),
    Some(pack_over(q, four.world)),
    None,
    b"longer",
    b"a",
  );
  // Only `longer` runs: `length` stands as packed.
  assert_eq(first.output, b"long 4");
  assert_eq(first.executed, 1);
  assert_eq(current(first.world.held).keys(), [key_of(query_of(q, b"longer"), b"a")])
}

test "a packed answer over other files is held to its reads, and answered again where they moved" {
  let q = test_queries(b"h1");
  let four = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let packed = pack_over(q, four.world);
  // Another file beside it: the pack stands for other files, but what `length` read is as it was.
  let beside = asked_with(
    q,
    test_world([{ at: b"a", text: b"four" }, { at: b"z", text: b"more" }]),
    Some(packed),
    None,
    b"longer",
    b"a",
  );
  assert_eq(beside.output, b"long 4");
  assert_eq(beside.executed, 1);
  let moved = asked_with(
    q,
    test_world([{ at: b"a", text: b"forty" }]),
    Some(packed),
    None,
    b"longer",
    b"a",
  );
  assert_eq(moved.output, b"long 5");
  assert_eq(moved.executed, 2)
}

test "what asked a packed answer is answered again where another pack is below the store" {
  let q = test_queries(b"h1");
  let four = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let forty = asked_over(q, test_world([{ at: b"a", text: b"forty" }]), b"length", b"a");
  let first = asked_with(
    q,
    test_world([{ at: b"a", text: b"four" }]),
    Some(pack_over(q, four.world)),
    None,
    b"longer",
    b"a",
  );
  assert_eq(first.output, b"long 4");
  let again = asked_with(q, first.world, Some(pack_over(q, four.world)), None, b"longer", b"a");
  assert_eq(again.executed, 0);
  // Nothing the store kept read what `length` read: only the pack below says its answer moved.
  let moved = asked_with(
    q,
    { ..again.world, files: forty.world.files },
    Some(pack_over(q, forty.world)),
    None,
    b"longer",
    b"a",
  );
  assert_eq(moved.output, b"long 5");
  assert_eq(moved.executed, 1);
  assert_eq(
    asked_with(q, moved.world, Some(pack_over(q, forty.world)), None, b"longer", b"a").executed,
    0,
  )
}

test "what asked a packed answer is answered again where the files below the pack moved" {
  let q = test_queries(b"h1");
  let four = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let packed = pack_over(q, four.world);
  let first = asked_with(
    q,
    test_world([{ at: b"a", text: b"four" }]),
    Some(packed),
    None,
    b"longer",
    b"a",
  );
  // The pack stands no longer, and `length` is held to what it read.
  let moved = asked_with(
    q,
    edited(first.world, b"a", b"forty"),
    Some(packed),
    None,
    b"longer",
    b"a",
  );
  assert_eq(moved.output, b"long 5");
  assert_eq(moved.executed, 2)
}

test "a command's answer over a packed answer falls where another pack is below the store" {
  let q = test_queries(b"h1");
  let four = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let forty = asked_over(q, test_world([{ at: b"a", text: b"forty" }]), b"length", b"a");
  let commanded = |held: Held, w: World| {
    let packed = Some(pack_over(q, w));
    over_held(
      held,
      |path: String, offset: Int, len: Int| packs::frame_in(packed, path, offset, len),
      files_of(w),
      |_: Bytes, at: Bytes| w.files.get(at),
      || {
        let kept = standing(q, started(q), b"k");
        match kept.output {
          Some(o) -> { took: true, output: o },
          None -> {
            let a = answer(q, kept.run, b"length", b"a");
            recorded(q, b"k", b"c1", asked_reads(a.run), a.output, kept.marks);
            { took: false, output: a.output }
          },
        }
      },
    )
  };
  let first = commanded(nothing_held(), four.world);
  assert_eq(first.value.output, b"4");
  assert(commanded(first.held, four.world).value.took);
  let moved = commanded(first.held, forty.world);
  assert(!moved.value.took);
  assert_eq(moved.value.output, b"5")
}

test "a run takes what the pack below its store holds for what moved" {
  let q = test_queries(b"h1");
  let four = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let forty = asked_over(q, test_world([{ at: b"a", text: b"forty" }]), b"length", b"a");
  let first = asked_with(
    q,
    test_world([{ at: b"a", text: b"four" }]),
    Some(pack_over(q, four.world)),
    None,
    b"length",
    b"a",
  );
  assert_eq(first.executed, 0);
  let next = asked_with(
    q,
    edited(first.world, b"a", b"forty"),
    Some(pack_over(q, forty.world)),
    None,
    b"length",
    b"a",
  );
  assert_eq(next.output, b"5");
  assert_eq(next.executed, 0)
}

/// A command over `w` that answers what `longer` answers for `a`, read back as `key` keeps it where it
/// stands: whether it was taken back, and what it answered.
fn commanded(
  q: Map<Bytes, Query<| {}>>,
  w: World,
  key: Bytes,
) -> { took: Bool, output: Bytes, world: World } / {abort.raise} = {
  let done = over_held(w.held, packs::no_pack, b"", |_: Bytes, at: Bytes| w.files.get(at), || {
    let run = started(q);
    let kept = standing(q, run, key);
    match kept.output {
      Some(o) -> { took: true, output: o },
      None -> {
        let a = answer(q, kept.run, b"longer", b"a");
        let said = b"said ".concat(a.output);
        recorded(q, key, b"c1", asked_reads(a.run), said, kept.marks);
        { took: false, output: said }
      },
    }
  });
  { took: done.value.took, output: done.value.output, world: { ..w, held: done.held } }
}

test "an answer kept over what a run asked stands until something it asked moves" {
  let q = test_queries(b"h1");
  let first = commanded(q, test_world([{ at: b"a", text: b"four" }]), b"k");
  assert_eq(first.output, b"said long 4");
  assert(!first.took);
  let again = commanded(q, first.world, b"k");
  assert(again.took);
  assert_eq(again.output, b"said long 4");
  // Another text of the same length moves nothing it asked: it stands, checked.
  let same = commanded(q, edited(again.world, b"a", b"FOUR"), b"k");
  assert(same.took);
  let moved = commanded(q, edited(same.world, b"a", b"forty"), b"k");
  assert(!moved.took);
  assert_eq(moved.output, b"said long 5");
  assert(commanded(q, moved.world, b"k").took)
}

test "a record whose answer is no longer kept is answered again" {
  let q = test_queries(b"h1");
  let first = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let lost = asked_over(
    q,
    { ..first.world, held: { ..first.world.held, outputs: Map::new() } },
    b"length",
    b"a",
  );
  assert_eq(lost.output, b"4");
  assert_eq(lost.executed, 1);
  assert_eq([first.lost, lost.lost], [0, 1])
}

fn offering(input: Bytes) -> Bytes / {memo.read} = {
  memo.offer(b"taken", input, b"v ".concat(input));
  b"offered"
}

fn taking(input: Bytes) -> Bytes / {memo.read} =
  match memo.offered() { Some(o) -> o, None -> b"v ".concat(input) }

fn both(input: Bytes) -> Bytes / {memo.read} = {
  memo.ask(b"offering", input);
  memo.ask(b"taken", input)
}

fn offer_queries(offering_hash: Bytes) -> Map<Bytes, Query<| {}>> =
  Map::new().insert(b"offering", { name: b"offering", hash: offering_hash, body: offering }).insert(
    b"taken",
    { name: b"taken", hash: b"t1", body: taking },
  ).insert(b"both", { name: b"both", hash: b"b1", body: both })

test "an answer taken from an offer is made again when the query that offered it is defined anew" {
  let first = asked_over(offer_queries(b"o1"), test_world([]), b"both", b"a");
  assert_eq(first.output, b"v a");
  let again = asked_over(offer_queries(b"o1"), first.world, b"both", b"a");
  assert_eq(again.executed, 0);
  // The offering query runs under its new definition, and the answer taken from its offer with it.
  let moved = asked_over(offer_queries(b"o2"), again.world, b"both", b"a");
  assert_eq(moved.output, b"v a");
  assert_eq(moved.executed, 2)
}

test "a mark on a key no record is kept under is let go" {
  let ghost = { ..nothing_held(), marks: Map::new().insert(b"ghost", [b"m"]) };
  let done = over_held(ghost, packs::no_pack, b"", |_: Bytes, _: Bytes| None, || {
    started(test_queries(b"h1"));
    ()
  });
  assert_eq(match done.held.marks.get(b"ghost") { Some(ms) -> ms.len(), None -> 0 }, 0)
}

test "a query asking for its own answer is refused" {
  let looping = Map::new().insert(b"self", {
    name: b"self",
    hash: b"s",
    body: |input: Bytes| memo.ask(b"self", input),
  });
  assert_eq(try_answer(|| asked_over(looping, test_world([]), b"self", b"x").output), None)
}

/// A `Record` as a test draws one.
fn records() -> gen::Gen<Record> =
  gen::and_then(gen::bytes(), |query: Bytes|
    gen::map4(
      gen::bytes(),
      gen::list(reads()),
      gen::bytes(),
      gen::any_int(),
      |input: Bytes, reads: List<Read>, output: Bytes, height: Int|
        { query: query, input: input, reads: reads, output: output, height: height },
    ))

/// A `Read` as a test draws one.
fn reads() -> gen::Gen<Read> =
  gen::one_of([
    gen::map3(gen::bytes(), gen::bytes(), gen::bytes(), |f0: Bytes, f1: Bytes, f2: Bytes|
      World(f0, f1, f2)),
    gen::map3(gen::bytes(), gen::bytes(), gen::bytes(), |f0: Bytes, f1: Bytes, f2: Bytes|
      Asked(f0, f1, f2)),
  ])

/// A `Seen` as a test draws one.
fn seens() -> gen::Gen<Seen> =
  gen::map3(gen::bytes(), gen::bytes(), gen::bytes(), |kind: Bytes, at: Bytes, digest: Bytes|
    { kind: kind, at: at, digest: digest })

test "a record reads back as it was kept, with the answer it holds" {
  gen::check2(records(), gen::option_of(gen::bytes()), |r: Record, inline: Option<Bytes>|
    if r.height >= 0 {
      let b = record_bytes(r, inline);
      record_from(b) == Some(r) && inline_named(b) == inline
    } else { true })
}

test "a record's first bytes name its answer, and hold one it keeps inside" {
  gen::check2(records(), gen::bytes(), |r: Record, o: Bytes|
    if r.output.len() <= 64 && r.height >= 0 {
      let inline = kept_inline(o);
      let b = record_bytes(r, inline);
      let head = b.slice(0, if b.len() < head_bytes() { b.len() } else { head_bytes() });
      output_named(head) == Some(r.output) && inline_named(head) == inline
    } else { true })
}

test "bytes of another format read as no record" {
  gen::check(gen::bytes(), |b: Bytes|
    if b.len() == 0 || b.at(0) != 5 {
      record_from(b) == None && output_named(b) == None && inline_named(b) == None
    } else { true })
}

test "a place's note reads back as it was noted" {
  gen::check(seens(), |s: Seen| { bin::decode(bin::encode(s, seen_bin()), seen_bin()) == Ok(s) })
}

fn try_answer(f: () -> Bytes / {abort.raise}) -> Option<Bytes> =
  handle { Some(f()) } with { abort.raise(_) -> None }
