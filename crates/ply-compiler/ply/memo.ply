//! Derived facts that stand while every read they made answers as it did. A query is a function a
//! run asks by name; its record keeps each read it made, in order, and the digest of what it
//! answered: a read of the world (a file, a shipped module, an embed) by the digest of what it
//! answered, and a read of another query by the digest of that query's answer. A query reads only
//! through `memo`, which its row is all of, so nothing it read goes unrecorded.
//!
//! A run costs what moved, not what the store holds. The store notes the digest it last saw at each
//! place of the world a record read, and which records read each place and asked each record. A run
//! first brings each note to what the world holds now; where a place moved, every record that read
//! it is marked, and every record that asked a marked one. A record with no mark stands without its
//! reads being asked again. A marked one is checked read by read, each read of another query asked
//! again, so an answer that comes out equal stops what an edit moves.

import std.bin
import std.bytes (hex_of, u64_at, u64_le)
import std.list (contains)
import std.hash (blake3)

pub effect memo {
  /// What the world holds at `at`, as `kind` reads it, or nothing there.
  read world(kind: Bytes, at: Bytes) -> Option<Bytes>
  /// What the query named `query` answers for `input`.
  read ask(query: Bytes, input: Bytes) -> Bytes
}

/// A read a record keeps: of the world by what it answered, or of a query by what it answered.
pub type Read = | World(Bytes, Bytes, Bytes) | Asked(Bytes, Bytes, Bytes)

/// What a query answered for an input: the hash of the query that answered, every read it made, in
/// order, and the digest of its answer, which the answer is kept under.
pub type Record = { query: Bytes, reads: List<Read>, output: Bytes }

derive bin for Read
derive bin for Record

/// A place of the world as a store last saw it: how it is read, where, and the digest of what was
/// there.
pub type Seen = { kind: Bytes, at: Bytes, digest: Bytes }

derive bin for Seen

/// A query: its name, the hash of its definition, which keys what it answered, and its body.
pub type Query = { name: Bytes, hash: Bytes, body: (Bytes) -> Bytes / {memo.read, abort.raise} }

/// What a run has settled: the digest of the answer under each key it settled, the answers it holds by their
/// digests, the keys being answered now, which a query asking one of them again would wait on
/// forever, and, by query, how many answers it took as kept and how many it ran the body for.
pub type Run = {
  settled: Map<Bytes, Bytes>,
  held: Map<Bytes, Bytes>,
  open: Map<Bytes, Bool>,
  took: Map<Bytes, Int>,
  ran: Map<Bytes, Int>,
}

fn new_run() -> Run =
  { settled: map_new(), held: map_new(), open: map_new(), took: map_new(), ran: map_new() }

/// What a run did of one query: answers taken as kept, and bodies run.
pub type Tally = { query: Bytes, took: Int, ran: Int }

derive bin for Tally

fn counted(m: Map<Bytes, Int>, name: Bytes) -> Int =
  match map_get(m, name) { Some(n) -> n, None -> 0 }

fn bumped(m: Map<Bytes, Int>, name: Bytes) -> Map<Bytes, Int> =
  map_insert(m, name, counted(m, name) + 1)

/// Each query the run asked, by name.
pub fn tallies(run: Run) -> List<Tally> =
  map(
    map_keys(
      map_fold(run.ran, run.took, |acc: Map<Bytes, Int>, k: Bytes, _: Int|
        if map_contains(acc, k) { acc } else { map_insert(acc, k, 0) }),
    ),
    |name: Bytes| { query: name, took: counted(run.took, name), ran: counted(run.ran, name) },
  )

/// How many bodies the run ran, over every query.
pub fn ran_total(run: Run) -> Int = map_fold(run.ran, 0, |n: Int, _: Bytes, k: Int| n + k)

/// The digest a read is kept by: nothing there is a value of its own.
pub fn digest_of(answer: Option<Bytes>) -> Bytes =
  match answer { Some(b) -> bytes_concat(b"=", blake3(b)), None -> b"-" }

/// What a query's answer for `input` is kept under: its definition's hash and the input's digest.
pub fn key_of(q: Query, input: Bytes) -> Bytes =
  blake3(bytes_concat_all([b"ply.memo.3\x00", q.hash, b"\x00", blake3(input)]))

fn sized(b: Bytes) -> Bytes = bytes_concat(u64_le(bytes_len(b)), b)

/// What a store notes the place `at`, as `kind` reads it, under.
pub fn place_id(kind: Bytes, at: Bytes) -> Bytes =
  blake3(bytes_concat_all([b"ply.memo.place\x00", sized(kind), at]))

/// The place that holds a query's hash, at its name: every record that asked the query reads it, so
/// a query whose definition moved marks what asked it.
fn query_kind() -> Bytes = b"query"

/// Where a store laid out as a directory keeps a record and an answer, relative to its root.
pub fn record_path(key: Bytes) -> String / {abort.raise} = "records/" ++ hex_of(key)

pub fn output_path(digest: Bytes) -> String / {abort.raise} = "outputs/" ++ hex_of(digest)

fn record_format() -> Bytes = b"\x02"

/// `r` as a store keeps it: its answer's digest first, so a run that takes it as kept reads no more.
pub fn record_bytes(r: Record) -> Bytes / {abort.raise} =
  bytes_concat_all([
    record_format(),
    sized(r.output),
    sized(r.query),
    bin::encode(r.reads, bin::list_bin(read_bin())),
  ])

fn sized_at(b: Bytes, at: Int) -> Option<{ value: Bytes, next: Int }> / {abort.raise} =
  match u64_at(b, at) {
    None -> None,
    Some(n) -> if n < 0 || at + 8 + n > bytes_len(b) { None }
    else { Some({ value: bytes_slice(b, at + 8, at + 8 + n), next: at + 8 + n }) },
  }

/// The digest of the answer a record's bytes, or their first bytes, name.
pub fn output_named(b: Bytes) -> Option<Bytes> / {abort.raise} =
  if bytes_len(b) < 1 || bytes_slice(b, 0, 1) != record_format() { None }
  else { match sized_at(b, 1) { Some(o) -> Some(o.value), None -> None } }

/// How many of a record's first bytes name its answer.
pub fn head_bytes() -> Int = 64

/// The record `b` holds, or nothing where they do not read as one.
pub fn record_from(b: Bytes) -> Option<Record> / {abort.raise} =
  if bytes_len(b) < 1 || bytes_slice(b, 0, 1) != record_format() { None } else {
    match sized_at(b, 1) {
      None -> None,
      Some(o) -> match sized_at(b, o.next) {
        None -> None,
        Some(q) -> match bin::decode(
            bytes_slice(b, q.next, bytes_len(b)),
            bin::list_bin(read_bin()),
          ) {
          Ok(reads) -> Some({ query: q.value, reads: reads, output: o.value }),
          Err(_) -> None,
        },
      },
    }
  }

/// Where a run reads and keeps records, their answers, its notes of the world and who read what,
/// and what the world holds now: the handler a command runs its queries under.
pub effect memo_keep {
  /// The digest of the answer the record under `key` in the run's store names.
  read head(key: Bytes) -> Option<Bytes>
  /// The record kept under `key` in the run's store.
  read record(key: Bytes) -> Option<Record>
  /// The record the toolchain packed beside the store under `key`.
  read packed(key: Bytes) -> Option<Record>
  /// The answer kept under its digest, in the store or packed beside it.
  read output(digest: Bytes) -> Option<Bytes>
  /// Keeps `r` under `key`, and `output` under `r.output`.
  write keep(key: Bytes, r: Record, output: Bytes) -> Unit
  /// Keeps `r`, a packed record, under `key`; its answer stays where the toolchain packed it.
  write adopt(key: Bytes, r: Record) -> Unit
  /// What the world holds at `at`, as `kind` reads it.
  read now(kind: Bytes, at: Bytes) -> Option<Bytes>
  /// Each place the store noted.
  read places() -> List<Seen>
  /// What the store last saw at the place `id` names.
  read seen(id: Bytes) -> Option<Seen>
  /// Notes `s` as what the store saw at the place `id` names.
  write see(id: Bytes, s: Seen) -> Unit
  /// The keys of the records that read the place, or asked the record, `id` names.
  read readers(id: Bytes) -> List<Bytes>
  /// Notes the record under `key` among the readers of `id`.
  write link(id: Bytes, key: Bytes) -> Unit
  /// The marks on the record under `key`, each left by a run that found something it read moved.
  read marks(key: Bytes) -> List<Bytes>
  /// Leaves a mark of its own on the record under `key`.
  write mark(key: Bytes) -> Unit
  /// Removes `marks` from the record under `key`.
  write unmark(key: Bytes, marks: List<Bytes>) -> Unit
  /// Holds the place `id` names for this run alone; false where another run would not let it go.
  write hold(id: Bytes) -> Bool
  /// Lets the place `id` names go.
  write release(id: Bytes) -> Unit
}

pub type Answered = { run: Run, output: Bytes }

fn query_of(queries: Map<Bytes, Query>, name: Bytes) -> Query / {abort.raise} =
  match map_get(queries, name) {
    Some(q) -> q,
    None -> panic("no query is named `" ++ string_of_bytes_lossy(name) ++ "`"),
  }

fn too_deep() -> Bytes = b"queries ask one another deeper than any program's queries go"

/// What the world holds at `at` as `kind` reads it, a query's hash at its name among them.
fn now_at(queries: Map<Bytes, Query>, kind: Bytes, at: Bytes) -> Option<Bytes> / {memo_keep.read} =
  if kind == query_kind() { match map_get(queries, at) { Some(q) -> Some(q.hash), None -> None } }
  else { memo_keep.now(kind, at) }

/// Marks each record that read the place, or asked the record, `id` names, each that asked one of
/// those, and so on. A record is marked before the records that asked it are read, so a run that
/// notes itself among them after that finds the mark.
fn marked_from(id: Bytes) -> Unit / {memo_keep.read, memo_keep.write, abort.raise} =
  iterate(
    { frontier: memo_keep.readers(id), done: map_new() },
    1000000,
    |x: { frontier: List<Bytes>, done: Map<Bytes, Bool> }|
      if len(x.frontier) == 0 { Stop(()) } else {
        Continue(
          fold(
            x.frontier,
            { frontier: [], done: x.done },
            |acc: { frontier: List<Bytes>, done: Map<Bytes, Bool> }, k: Bytes|
              if map_contains(acc.done, k) { acc } else {
                memo_keep.mark(k);
                {
                  frontier: fold(memo_keep.readers(k), acc.frontier, |f: List<Bytes>, r: Bytes|
                    push(f, r)),
                  done: map_insert(acc.done, k, true),
                }
              },
          ),
        )
      },
  )

/// The digest of what the world holds at `at` as `kind` reads it, with the store's note of the place
/// brought to it. Where the note says otherwise, every record that read the place is marked before
/// the note moves, so no record stands on a read that moved; where another run holds the place, they
/// are marked and the note is left to it.
fn seen_now(
  queries: Map<Bytes, Query>,
  kind: Bytes,
  at: Bytes,
) -> Bytes / {memo_keep.read, memo_keep.write, abort.raise} = {
  let id = place_id(kind, at);
  let d = digest_of(now_at(queries, kind, at));
  let noted = |s: Option<Seen>| match s { Some(x) -> x.digest == d, None -> false };
  if noted(memo_keep.seen(id)) { d } else {
    if memo_keep.hold(id) {
      match memo_keep.seen(id) { Some(s) -> if s.digest != d { marked_from(id) }, None -> () };
      memo_keep.see(id, { kind: kind, at: at, digest: d });
      memo_keep.release(id)
    } else { marked_from(id) };
    d
  }
}

/// A run over the store: each note of the world brought to what the world holds now, and every
/// record that read a place that moved marked. A run's answers stand only on a store looked over so.
pub fn started(queries: Map<Bytes, Query>) -> Run / {memo_keep.read, memo_keep.write, abort.raise} = {
  fold(memo_keep.places(), (), |_: Unit, s: Seen| {
    seen_now(queries, s.kind, s.at);
    ()
  });
  new_run()
}

/// What the query `name` answers for `input`: its record's answer where nothing it read moved, else
/// its body's, which is kept. `left` is how much deeper the asking may go: deeper than every query a
/// program has, which only a run asking its way around a loop reaches.
pub fn answer(
  queries: Map<Bytes, Query>,
  run: Run,
  name: Bytes,
  input: Bytes,
  left: Int = 100000,
) -> Answered / {memo_keep.read, memo_keep.write, abort.raise} =
  if left <= 0 { panic(string_of_bytes_lossy(too_deep())) } else {
    let s = settled(queries, run, name, input, left - 1);
    match map_get(s.run.held, s.head) {
      Some(o) -> { run: s.run, output: o },
      None -> match memo_keep.output(s.head) {
        Some(o) -> { run: { ..s.run, held: map_insert(s.run.held, s.head, o) }, output: o },
        // An answer no store keeps any more is answered again.
        None -> {
          let q = query_of(queries, name);
          let key = key_of(q, input);
          let e = executed(queries, s.run, q, key, input, [], None, left - 1);
          {
            run: { ..e.run, settled: map_insert(e.run.settled, key, e.head) },
            output: match map_get(e.run.held, e.head) { Some(o) -> o, None -> b"" },
          }
        },
      },
    }
  }

fn took(run: Run, name: Bytes, output: Bytes) -> { run: Run, head: Bytes } =
  { run: { ..run, took: bumped(run.took, name) }, head: output }

/// What the query `name` answers for `input`, by its digest: as kept where no mark is on its record
/// or each read it made answers as it did, else as packed where each read the packed record made
/// answers as it did, else as its body answers.
fn settled(
  queries: Map<Bytes, Query>,
  run: Run,
  name: Bytes,
  input: Bytes,
  left: Int,
) -> { run: Run, head: Bytes } / {memo_keep.read, memo_keep.write, abort.raise} =
  if left <= 0 { panic(string_of_bytes_lossy(too_deep())) } else {
    let q = query_of(queries, name);
    let key = key_of(q, input);
    match map_get(run.settled, key) {
      Some(h) -> { run: run, head: h },
      None -> {
        if map_contains(run.open, key) {
          panic("the query `" ++ string_of_bytes_lossy(name) ++ "` asks for its own answer")
        };
        let opened = { ..run, open: map_insert(run.open, key, true) };
        let done = match memo_keep.head(key) {
          None -> adopted(queries, opened, q, key, input, [], None, left - 1),
          Some(out) -> {
            let marks = memo_keep.marks(key);
            if len(marks) == 0 { took(opened, name, out) } else {
              match memo_keep.record(key) {
                None -> adopted(queries, opened, q, key, input, marks, None, left - 1),
                Some(r) -> {
                  let s = stands(queries, opened, r.reads, left - 1);
                  if s.ok {
                    memo_keep.unmark(key, marks);
                    took(s.run, name, r.output)
                  } else { adopted(queries, s.run, q, key, input, marks, Some(r), left - 1) }
                },
              }
            }
          },
        };
        {
          run: {
            ..done.run,
            settled: map_insert(done.run.settled, key, done.head),
            open: map_remove(done.run.open, key),
          },
          head: done.head,
        }
      },
    }
  }

/// Whether each of `reads` answers now what it answered when kept, asked in order and no further
/// than the first that does not.
fn stands(
  queries: Map<Bytes, Query>,
  run: Run,
  reads: List<Read>,
  left: Int,
) -> { run: Run, ok: Bool } / {memo_keep.read, memo_keep.write, abort.raise} =
  if left <= 0 { panic(string_of_bytes_lossy(too_deep())) } else {
    fold(reads, { run: run, ok: true }, |acc: { run: Run, ok: Bool }, r: Read|
      if !acc.ok { acc } else {
        match r {
          World(kind, at, digest) -> { run: acc.run, ok: seen_now(queries, kind, at) == digest },
          Asked(name, input, digest) -> {
            let a = settled(queries, acc.run, name, input, left - 1);
            { run: a.run, ok: a.head == digest }
          },
        }
      })
  }

fn asked_names(reads: List<Read>) -> Map<Bytes, Bool> =
  fold(reads, map_new(), |acc: Map<Bytes, Bool>, r: Read|
    match r { Asked(name, _, _) -> map_insert(acc, name, true), World(_, _, _) -> acc })

/// What a record's reads are noted under among the readers of what they read.
fn read_ids(queries: Map<Bytes, Query>, reads: List<Read>) -> Map<Bytes, Bool> =
  fold(reads, map_new(), |acc: Map<Bytes, Bool>, r: Read|
    match r {
      World(kind, at, _) -> map_insert(acc, place_id(kind, at), true),
      Asked(name, input, _) -> match map_get(queries, name) {
        Some(q) ->
          map_insert(map_insert(acc, key_of(q, input), true), place_id(query_kind(), name), true),
        None -> acc,
      },
    })

/// Notes the queries `reads` asked at their places, so a record that asked one is marked where its
/// hash moves.
fn noted_asked(
  queries: Map<Bytes, Query>,
  reads: List<Read>,
) -> Unit / {memo_keep.read, memo_keep.write, abort.raise} =
  fold(map_keys(asked_names(reads)), (), |_: Unit, name: Bytes| {
    seen_now(queries, query_kind(), name);
    ()
  })

/// The record the toolchain packed under `key`, kept in the run's store where each read it made
/// answers as it did, each noted among the readers of what it reads before it is asked; else `q`'s
/// body run for `input`, as [`executed`] runs it. A packed record is held to its reads like any
/// other, since the shipped modules a run reads need not be those it was packed from.
fn adopted(
  queries: Map<Bytes, Query>,
  run: Run,
  q: Query,
  key: Bytes,
  input: Bytes,
  marks: List<Bytes>,
  prior: Option<Record>,
  left: Int,
) -> { run: Run, head: Bytes } / {memo_keep.read, memo_keep.write, abort.raise} =
  if left <= 0 { panic(string_of_bytes_lossy(too_deep())) } else {
    match memo_keep.packed(key) {
      None -> executed(queries, run, q, key, input, marks, prior, left - 1),
      Some(r) -> {
        let noted = match prior { Some(p) -> read_ids(queries, p.reads), None -> map_new() };
        map_fold(read_ids(queries, r.reads), (), |_: Unit, id: Bytes, _: Bool|
          if !map_contains(noted, id) { memo_keep.link(id, key) });
        let s = stands(queries, run, r.reads, left - 1);
        if s.ok {
          noted_asked(queries, r.reads);
          memo_keep.adopt(key, r);
          if len(marks) > 0 { memo_keep.unmark(key, marks) };
          took(s.run, q.name, r.output)
        } else { executed(queries, s.run, q, key, input, marks, Some(r), left - 1) }
      },
    }
  }

/// `q`'s body run for `input`, its record kept under `key`, and `marks`, the marks a run found on
/// the record before running it, removed. Each read is noted among the readers of what it reads
/// before it reads it, so a run that marks what it read after that marks the record too; `prior`,
/// the record the key held, has its reads noted already. A read of the world is asked again once the
/// body has answered, and a record whose read moved meanwhile is kept marked.
fn executed(
  queries: Map<Bytes, Query>,
  run: Run,
  q: Query,
  key: Bytes,
  input: Bytes,
  marks: List<Bytes>,
  prior: Option<Record>,
  left: Int,
) -> { run: Run, head: Bytes } / {memo_keep.read, memo_keep.write, abort.raise} =
  if left <= 0 { panic(string_of_bytes_lossy(too_deep())) } else {
    let linked = match prior { Some(r) -> read_ids(queries, r.reads), None -> map_new() };
    with_cell[memo]({
        run: { ..run, ran: bumped(run.ran, q.name) },
        reads: [],
        worlds: map_new(),
        linked: linked,
        unsure: false,
      }) { st -> {
      // Whether the read `id` names was newly noted.
      let link = |id: Bytes| {
        let s = cell_get(st);
        if map_contains(s.linked, id) { false } else {
          memo_keep.link(id, key);
          cell_set(st, { ..s, linked: map_insert(s.linked, id, true) });
          true
        }
      };
      let world = |kind: Bytes, at: Bytes| {
        link(place_id(kind, at));
        let found = now_at(queries, kind, at);
        let d = digest_of(found);
        let s = cell_get(st);
        // A place read again to the same answer is one read.
        let seen = bytes_concat(place_id(kind, at), d);
        if !map_contains(s.worlds, seen) {
          cell_set(st, {
            ..s,
            reads: push(s.reads, World(kind, at, d)),
            worlds: map_insert(s.worlds, seen, true),
          })
        };
        found
      };
      let output = handle {
        (q.body)(input)
      } with {
        memo.world(kind, at) -> world(kind, at),
        memo.ask(name, asked) -> {
          let akey = key_of(query_of(queries, name), asked);
          link(place_id(query_kind(), name));
          let fresh = link(akey);
          let before = cell_get(st).run;
          // An answer settled before this read was noted may have been marked since.
          let unsure = fresh && map_contains(before.settled, akey)
            && len(memo_keep.marks(akey)) > 0;
          let a = answer(queries, before, name, asked, left - 1);
          let s = cell_get(st);
          cell_set(st, {
            ..s,
            run: a.run,
            reads: push(s.reads, Asked(name, asked, digest_of(Some(a.output)))),
            unsure: s.unsure || unsure,
          });
          a.output
        },
      };
      let s = cell_get(st);
      let moved = fold(s.reads, s.unsure, |m: Bool, r: Read|
        match r {
          World(kind, at, d) -> m || seen_now(queries, kind, at) != d,
          Asked(_, _, _) -> m,
        });
      noted_asked(queries, s.reads);
      if moved { memo_keep.mark(key) };
      let d = digest_of(Some(output));
      memo_keep.keep(key, { query: q.hash, reads: s.reads, output: d }, output);
      if len(marks) > 0 { memo_keep.unmark(key, marks) };
      { run: { ..s.run, held: map_insert(s.run.held, d, output) }, head: d }
    } }
  }

// --- A store held in memory ------------------------------------------------------------------

/// A store held in memory: what a store laid out as a directory holds in files.
pub type Held = {
  records: Map<Bytes, Record>,
  outputs: Map<Bytes, Bytes>,
  seen: Map<Bytes, Seen>,
  readers: Map<Bytes, List<Bytes>>,
  marks: Map<Bytes, List<Bytes>>,
  minted: Int,
}

pub fn nothing_held() -> Held =
  {
    records: map_new(),
    outputs: map_new(),
    seen: map_new(),
    readers: map_new(),
    marks: map_new(),
    minted: 0,
  }

/// `work` run over `held`, with `look` answering what the world holds now: what it answered, and the
/// store with what it kept. A record or an answer `held` lacks is asked of a read-only store laid out
/// as a directory, through `beside`, which reads a file of it by its path within it.
pub fn over_held<a | e>(
  held: Held,
  beside: (String) -> Option<Bytes> / {abort.raise | e},
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_keep.read, memo_keep.write, abort.raise},
) -> { held: Held, value: a } / {abort.raise | e} =
  with_cell[held](held) { cell -> {
    let value = handle {
      work()
    } with {
      memo_keep.head(key) -> match map_get(cell_get(cell).records, key) {
        Some(r) -> Some(r.output),
        None -> None,
      },
      memo_keep.record(key) -> map_get(cell_get(cell).records, key),
      memo_keep.packed(key) -> match beside(record_path(key)) {
        Some(b) -> record_from(b),
        None -> None,
      },
      memo_keep.output(digest) -> match map_get(cell_get(cell).outputs, digest) {
        Some(o) -> Some(o),
        None -> beside(output_path(digest)),
      },
      memo_keep.keep(key, rec, output) -> {
        let h = cell_get(cell);
        cell_set(cell, {
          ..h,
          records: map_insert(h.records, key, rec),
          outputs: map_insert(h.outputs, rec.output, output),
        })
      },
      memo_keep.adopt(key, rec) -> {
        let h = cell_get(cell);
        cell_set(cell, { ..h, records: map_insert(h.records, key, rec) })
      },
      memo_keep.now(kind, at) -> look(kind, at),
      memo_keep.places() -> map_values(cell_get(cell).seen),
      memo_keep.seen(id) -> map_get(cell_get(cell).seen, id),
      memo_keep.see(id, s) -> {
        let h = cell_get(cell);
        cell_set(cell, { ..h, seen: map_insert(h.seen, id, s) })
      },
      memo_keep.readers(id) -> match map_get(cell_get(cell).readers, id) {
        Some(ks) -> ks,
        None -> [],
      },
      memo_keep.link(id, key) -> {
        let h = cell_get(cell);
        let ks = match map_get(h.readers, id) { Some(ks) -> ks, None -> [] };
        if !contains(ks, key) {
          cell_set(cell, { ..h, readers: map_insert(h.readers, id, push(ks, key)) })
        }
      },
      memo_keep.marks(key) -> match map_get(cell_get(cell).marks, key) {
        Some(ms) -> ms,
        None -> [],
      },
      memo_keep.mark(key) -> {
        let h = cell_get(cell);
        let ms = match map_get(h.marks, key) { Some(ms) -> ms, None -> [] };
        cell_set(cell, {
          ..h,
          marks: map_insert(h.marks, key, push(ms, bytes_of_string(int_to_string(h.minted)))),
          minted: h.minted + 1,
        })
      },
      memo_keep.unmark(key, gone) -> {
        let h = cell_get(cell);
        let ms = match map_get(h.marks, key) { Some(ms) -> ms, None -> [] };
        cell_set(cell, {
          ..h,
          marks: map_insert(h.marks, key, filter(ms, |m: Bytes| !contains(gone, m))),
        })
      },
      memo_keep.hold(_) -> true,
      memo_keep.release(_) -> (),
    };
    { held: cell_get(cell), value: value }
  } }

/// `work` run with no store of its own, asking `beside` as [`over_held`] does: each record it keeps
/// lives only as long as the run.
pub fn fresh<a | e>(
  beside: (String) -> Option<Bytes> / {abort.raise | e},
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_keep.read, memo_keep.write, abort.raise},
) -> a / {abort.raise | e} = over_held(nothing_held(), beside, look, work).value

// --- Tests ----------------------------------------------------------------------------------

type World = { files: Map<Bytes, Bytes>, held: Held, read: Int }

fn test_world(files: List<{ at: Bytes, text: Bytes }>) -> World =
  {
    files: fold(files, map_new(), |acc: Map<Bytes, Bytes>, f: { at: Bytes, text: Bytes }|
      map_insert(acc, f.at, f.text)),
    held: nothing_held(),
    read: 0,
  }

fn length_of(input: Bytes) -> Bytes / {memo.read} =
  match memo.world(b"file", input) {
    Some(text) -> bytes_of_string(int_to_string(bytes_len(text))),
    None -> b"none",
  }

fn longer(input: Bytes) -> Bytes / {memo.read} = {
  let n = memo.ask(b"length", input);
  bytes_concat(b"long ", n)
}

fn test_queries(length_hash: Bytes) -> Map<Bytes, Query> =
  map_insert(
    map_insert(map_new(), b"length", { name: b"length", hash: length_hash, body: length_of }),
    b"longer",
    { name: b"longer", hash: b"l1", body: longer },
  )

/// `name` asked of `input` over `w` from a run of its own: what it answered, how many bodies ran,
/// how many times it read the world, and the world it left.
fn asked_over(
  queries: Map<Bytes, Query>,
  w: World,
  name: Bytes,
  input: Bytes,
) -> { output: Bytes, executed: Int, read: Int, world: World } / {abort.raise} =
  asked_with(queries, w, map_new(), None, name, input)

/// [`asked_over`], with the files of a packed store `beside` the run's own, and the world holding
/// `after` from its second read on, where that is given.
fn asked_with(
  queries: Map<Bytes, Query>,
  w: World,
  beside: Map<String, Bytes>,
  after: Option<Map<Bytes, Bytes>>,
  name: Bytes,
  input: Bytes,
) -> { output: Bytes, executed: Int, read: Int, world: World } / {abort.raise} =
  with_cell[test_memo](0) { reads -> {
    let done = over_held(
      w.held,
      |path: String| map_get(beside, path),
      |_: Bytes, at: Bytes| {
        let n = cell_get(reads);
        cell_set(reads, n + 1);
        match after {
          Some(files) -> if n > 0 { map_get(files, at) } else { map_get(w.files, at) },
          None -> map_get(w.files, at),
        }
      },
      || {
        let a = answer(queries, started(queries), name, input);
        { output: a.output, executed: ran_total(a.run) }
      },
    );
    {
      output: done.value.output,
      executed: done.value.executed,
      read: cell_get(reads),
      world: { ..w, held: done.held, read: cell_get(reads) },
    }
  } }

fn edited(w: World, at: Bytes, text: Bytes) -> World = { ..w, files: map_insert(w.files, at, text) }

test "a query's record answers again while what it read answers the same" {
  let q = test_queries(b"h1");
  let first = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  assert_eq(first.output, b"4");
  assert_eq(first.executed, 1);
  let again = asked_over(q, first.world, b"length", b"a");
  assert_eq(again.output, b"4");
  assert_eq(again.executed, 0);
  let moved = asked_over(q, edited(again.world, b"a", b"seven!!"), b"length", b"a");
  assert_eq(moved.output, b"7");
  assert_eq(moved.executed, 1)
}

test "an answer that comes out the same stops what an edit moves" {
  let q = test_queries(b"h1");
  let first = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"longer", b"a");
  assert_eq(first.output, b"long 4");
  assert_eq(first.executed, 2);
  // Another text of the same length: `length` runs again and answers the same, so `longer` stands.
  let same = asked_over(q, edited(first.world, b"a", b"FOUR"), b"longer", b"a");
  assert_eq(same.output, b"long 4");
  assert_eq(same.executed, 1);
  let longer_now = asked_over(q, edited(same.world, b"a", b"forty"), b"longer", b"a");
  assert_eq(longer_now.output, b"long 5");
  assert_eq(longer_now.executed, 2)
}

test "a run where nothing moved reads each place once and asks no record's reads again" {
  let q = test_queries(b"h1");
  let first = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"longer", b"a");
  let again = asked_over(q, first.world, b"longer", b"a");
  assert_eq(again.output, b"long 4");
  assert_eq(again.executed, 0);
  assert_eq(again.read, 1)
}

test "a place that moved marks what read it, and what asked that, until a run answers them" {
  let q = test_queries(b"h1");
  let first = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"longer", b"a");
  let marked = asked_over(q, edited(first.world, b"a", b"forty"), b"length", b"a");
  assert_eq(marked.output, b"5");
  // `longer` was not asked, so its mark stays for the run that asks it.
  let later = asked_over(q, marked.world, b"longer", b"a");
  assert_eq(later.output, b"long 5");
  assert_eq(later.executed, 1)
}

test "a query whose definition moved answers anew, and what asked it stands where it answers alike" {
  let first = asked_over(
    test_queries(b"h1"),
    test_world([{ at: b"a", text: b"four" }]),
    b"longer",
    b"a",
  );
  let moved = asked_over(test_queries(b"h2"), first.world, b"longer", b"a");
  assert_eq(moved.output, b"long 4");
  assert_eq(moved.executed, 1)
}

test "a query whose definition moved marks what asked it, though nothing it read moved" {
  let q1 = map_insert(test_queries(b"h1"), b"length", {
    name: b"length",
    hash: b"h1",
    body: |input: Bytes| length_of(input),
  });
  let first = asked_over(q1, test_world([{ at: b"a", text: b"four" }]), b"longer", b"a");
  let counting_twice = map_insert(test_queries(b"h2"), b"length", {
    name: b"length",
    hash: b"h2",
    body: |input: Bytes|
      match memo.world(b"file", input) {
        Some(text) -> bytes_of_string(int_to_string(2 * bytes_len(text))),
        None -> b"none",
      },
  });
  let moved = asked_over(counting_twice, first.world, b"longer", b"a");
  assert_eq(moved.output, b"long 8");
  assert_eq(moved.executed, 2)
}

test "a read that moved while its body ran leaves the record marked for the next run" {
  let q = test_queries(b"h1");
  let edited_after = map_insert(map_new(), b"a", b"forty");
  let first = asked_with(
    q,
    test_world([{ at: b"a", text: b"four" }]),
    map_new(),
    Some(edited_after),
    b"length",
    b"a",
  );
  assert_eq(first.output, b"4");
  let next = asked_over(q, edited(first.world, b"a", b"forty"), b"length", b"a");
  assert_eq(next.output, b"5");
  assert_eq(next.executed, 1)
}

/// The files of a packed store that holds what `held` holds.
fn packed_files(held: Held) -> Map<String, Bytes> / {abort.raise} =
  map_fold(
    held.outputs,
    map_fold(held.records, map_new(), |acc: Map<String, Bytes>, k: Bytes, r: Record|
      map_insert(acc, record_path(k), record_bytes(r))),
    |acc: Map<String, Bytes>, d: Bytes, o: Bytes| map_insert(acc, output_path(d), o),
  )

test "a packed answer is taken where what it read answers as it did, and kept as the run's own" {
  let q = test_queries(b"h1");
  let four = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let packed = packed_files(four.world.held);
  let first = asked_with(
    q,
    test_world([{ at: b"a", text: b"four" }]),
    packed,
    None,
    b"longer",
    b"a",
  );
  assert_eq(first.output, b"long 4");
  assert_eq(first.executed, 1);
  // Kept as the run's own, the packed record is marked by an edit like any other.
  let moved = asked_with(q, edited(first.world, b"a", b"forty"), packed, None, b"longer", b"a");
  assert_eq(moved.output, b"long 5");
  assert_eq(moved.executed, 2)
}

test "a packed answer over other shipped files than the run reads is answered again" {
  let q = test_queries(b"h1");
  let four = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let first = asked_with(
    q,
    test_world([{ at: b"a", text: b"forty" }]),
    packed_files(four.world.held),
    None,
    b"longer",
    b"a",
  );
  assert_eq(first.output, b"long 5");
  assert_eq(first.executed, 2)
}

test "a record marked where a packed answer stands for what moved takes that answer" {
  let q = test_queries(b"h1");
  let four = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let forty = asked_over(q, test_world([{ at: b"a", text: b"forty" }]), b"length", b"a");
  let first = asked_with(
    q,
    test_world([{ at: b"a", text: b"four" }]),
    packed_files(four.world.held),
    None,
    b"length",
    b"a",
  );
  assert_eq(first.executed, 0);
  let next = asked_with(
    q,
    edited(first.world, b"a", b"forty"),
    packed_files(forty.world.held),
    None,
    b"length",
    b"a",
  );
  assert_eq(next.output, b"5");
  assert_eq(next.executed, 0)
}

test "a record whose answer is no longer kept is answered again" {
  let q = test_queries(b"h1");
  let first = asked_over(q, test_world([{ at: b"a", text: b"four" }]), b"length", b"a");
  let lost = asked_over(
    q,
    { ..first.world, held: { ..first.world.held, outputs: map_new() } },
    b"length",
    b"a",
  );
  assert_eq(lost.output, b"4");
  assert_eq(lost.executed, 1)
}

test "a query asking for its own answer is refused" {
  let looping = map_insert(map_new(), b"self", {
    name: b"self",
    hash: b"s",
    body: |input: Bytes| memo.ask(b"self", input),
  });
  assert_eq(try_answer(|| asked_over(looping, test_world([]), b"self", b"x").output), None)
}

test "a record reads back as it was kept, and its first bytes name its answer" {
  let r = {
    query: blake3(b"q"),
    reads: [World(b"file", b"a", b"=x"), Asked(b"length", b"a", b"=y")],
    output: digest_of(Some(b"4")),
  };
  let b = record_bytes(r);
  assert_eq(record_from(b), Some(r));
  assert_eq(output_named(bytes_slice(b, 0, head_bytes())), Some(r.output));
  assert_eq(record_from(b"\x01"), None)
}

fn try_answer(f: () -> Bytes / {abort.raise}) -> Option<Bytes> =
  handle { Some(f()) } with { abort.raise(_) -> None }
