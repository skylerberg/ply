import exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock, ERecord,
              ERecordUpdate, ETry, EField, EList, EPerform, EHandle, EWithCell, EWithRegion,
              ESimulate, EBad, Stmt, SLet, SExpr, Param, MatchArm, HandleClause, ReturnClause, RecField)
import items (Module, Item, IFn, IType, IEffect, ITest, ILaw, IDerive, IEffectSet, FnDef, TypeDef,
              TypeDefBody, TDAlias, TDSum, VariantDef, EffectDef, OpDef, TestDef, LawDef, Binder,
              Constraint, Deriver, DJson, DEq, DOrd, SpecKind, SRequires, SEnsures, SpecClause, Derived, Vis, VPub, VPriv, parse)
import rewrite (expand)
import resolve (Mod, Source, Resolved, Scope, Binding, Bindings, ModBind, Diag, Outcome,
                Resolved_, Failed, resolve_modules, diag2, lab, is_bare, dump_diags, qualify,
                default_binder, backticked, is_ctor_name)
import derive (Expansion, expand_derives, deriver_tag)
import std.hash (blake3)

// --- Bytes ------------------------------------------------------------------------------------

fn at<a>(xs: List<a>, i: Int) -> a =
  match list_at(xs, i) { Some(x) -> x, None -> panic("an index the hasher does not hold") }

fn append<a>(a: List<a>, b: List<a>) -> List<a> = fold(b, a, |acc: List<a>, x: a| push(acc, x))

fn contains_int(xs: List<Int>, v: Int) -> Bool = fold(xs, false, |acc: Bool, x: Int| acc || x == v)

fn contains_bytes(xs: List<Bytes>, v: Bytes) -> Bool = fold(xs, false, |acc: Bool, x: Bytes| acc || x == v)

// The position of `v` in `xs`, searching from the end: a binder's de Bruijn level.
fn rposition(xs: List<Bytes>, v: Bytes) -> Option<Int> =
  fold(range(0, len(xs)), None, |acc: Option<Int>, i: Int| if at(xs, i) == v { Some(i) } else { acc })

fn u32_le(v: Int) -> Bytes =
  bytes_concat_all([byte_of(v & 0xFF), byte_of((v >>> 8) & 0xFF), byte_of((v >>> 16) & 0xFF), byte_of((v >>> 24) & 0xFF)])

// The width's position in `lexer::widths`: the discriminant the encoding writes.
fn width_index(ty: Bytes) -> Bytes = {
  let want = bytes_of_string(string_lower(string_of_bytes(ty)));
  byte_of(
    fold(range(0, len(widths())), 0, |at: Int, i: Int|
      match list_at(widths(), i) {
        Some(w) -> if w.name == want { i } else { at },
        None -> at,
      }))
}

fn i64_le(v: Int) -> Bytes =
  bytes_concat_all(map(range(0, 8), |i: Int| byte_of((v >>> (8 * i)) & 0xFF)))

fn hex_digit(v: Int) -> Bytes = if v < 10 { byte_of(48 + v) } else { byte_of(87 + v) }

pub fn hex(b: Bytes) -> Bytes =
  bytes_concat_all(map(range(0, bytes_len(b)), |i: Int| { let v = bytes_at(b, i); bytes_concat(hex_digit(v >>> 4), hex_digit(v & 15)) }))

// A `Decimal` mantissa has up to 96 bits, more than an `Int`, so it is accumulated a byte at a time.
fn i128_le_of_digits(digits: Bytes) -> Bytes = {
  let limbs = fold(range(0, bytes_len(digits)), map(range(0, 16), |i: Int| 0), |acc: List<Int>, i: Int| {
    let d = bytes_at(digits, i) - 48;
    let carried = fold(range(0, 16), { limbs: [], carry: d }, |s: { limbs: List<Int>, carry: Int }, k: Int| {
      let v = at(acc, k) * 10 + s.carry;
      { limbs: push(s.limbs, v & 0xFF), carry: v >>> 8 }
    });
    carried.limbs
  });
  bytes_concat_all(map(limbs, |v: Int| byte_of(v)))
}

fn is_digit_byte(c: Int) -> Bool = c >= 48 && c <= 57

fn float_bits(text: Bytes) -> Int =
  match float_of_string(string_of_bytes(text)) {
    Some(f) -> bits_of_float(f),
    None -> panic("a float literal the hasher cannot read"),
  }

// A `Decimal` literal's `(mantissa, scale)`: the digits without the point, and how many followed it.
fn decimal_parts(text: Bytes) -> { mantissa: Bytes, scale: Int } = {
  let body = bytes_slice(text, 0, bytes_len(text) - 1);
  let split = fold(range(0, bytes_len(body)), { digits: b"", scale: 0, after: false }, |s: { digits: Bytes, scale: Int, after: Bool }, i: Int| {
    let c = bytes_at(body, i);
    if c == 46 { {..s, after: true} }
    else if !is_digit_byte(c) { s }
    else { { digits: bytes_concat(s.digits, byte_of(c)), scale: if s.after { s.scale + 1 } else { s.scale }, after: s.after } }
  });
  { mantissa: i128_le_of_digits(split.digits), scale: split.scale }
}

// --- The reference graph over every top-level definition ------------------------------

pub type NodeBody = | NFn(FnDef) | NType(TypeDef) | NEffect(EffectDef)
pub type Node = { name: Bytes, simple: Bytes, module: Int, body: NodeBody }
pub type TestNode = { key: Bytes, module: Int, def: TestDef }
pub type LawNode = { key: Bytes, module: Int, def: LawDef }
pub type Entry = | EDef(Int) | ETest(Int) | ELaw(Int)
type Target = { owner: Int, name: Bytes }
pub type ValueTarget = | VFn(Int) | VCtor({ owner: Int, name: Bytes })
type ModuleItems = { fns: Map<Bytes, Int>, types: Map<Bytes, Int>, effects: Map<Bytes, Int>, ctors: Map<Bytes, Int> }
type ScopeIndex = { values: Map<Bytes, Target>, types: Map<Bytes, Target>, effects: Map<Bytes, Target>, modules: Map<Bytes, Int> }

pub type Index = { mods: List<Mod>, nodes: List<Node>, tests: List<TestNode>, laws: List<LawNode>, order: List<Entry>,
                   items: List<ModuleItems>, scopes: List<ScopeIndex>, effect_sketches: Map<Int, Bytes> }

fn qualifier(q: QName) -> Option<Bytes> = match q.module { Some(m) -> Some(m.name), None -> None }

// The name `qualified` has inside the module that declares it.
fn simple_of(qualified: Bytes, owner: Bytes) -> Bytes = {
  let prefix = bytes_concat(owner, b".");
  if bytes_len(owner) > 0 && bytes_starts_with(qualified, prefix) { bytes_slice(qualified, bytes_len(prefix), bytes_len(qualified)) } else { qualified }
}

type Building = { nodes: List<Node>, tests: List<TestNode>, laws: List<LawNode>, order: List<Entry>, items: List<ModuleItems>, diags: List<Diag> }
type Declaring = { map: Map<Bytes, Int>, spans: Map<Bytes, Span>, diags: List<Diag> }

fn declare(d: Declaring, m: Int, name: Ident, id: Int, what: Bytes) -> Declaring =
  match map_get(d.spans, name.name) {
    Some(first) -> {..d, diags: push(d.diags, diag2(b"E0105", m, name.span,
                       bytes_concat_all([b"duplicate ", what, b" `", name.name, b"`"]), b"redefined here",
                       m, first, b"first defined here",
                       [bytes_concat_all([b"rename one of them; every ", what, b" in a module needs a distinct name"])]))},
    None -> { map: map_insert(d.map, name.name, id), spans: map_insert(d.spans, name.name, name.span), diags: d.diags },
  }

fn no_declaring(diags: List<Diag>) -> Declaring = { map: map_new(), spans: map_new(), diags: diags }

pub fn build_index(mods: List<Mod>, r: Resolved) -> { index: Index, diags: List<Diag> } = {
  let built = fold(range(0, len(mods)), { nodes: [], tests: [], laws: [], order: [], items: [], diags: [] }, |b: Building, m: Int| {
    let module = at(mods, m);
    let walked = fold(module.module.items, { b: b, fns: no_declaring([]), types: no_declaring([]), effects: no_declaring([]), ctors: no_declaring([]) },
      |s: { b: Building, fns: Declaring, types: Declaring, effects: Declaring, ctors: Declaring }, it: Item| {
        let bb: Building = s.b;
        match it {
          IFn(d) -> {
            let id = len(bb.nodes);
            let pushed: Building = {..bb, nodes: push(bb.nodes, { name: qualify(module.name, d.name.name), simple: d.name.name, module: m, body: NFn(d) }), order: push(bb.order, EDef(id))};
            let fns: Declaring = declare({..s.fns, diags: []}, m, d.name, id, b"definition");
            {..s, b: {..pushed, diags: append(pushed.diags, fns.diags)}, fns: {..fns, diags: []}}
          },
          IType(d) -> {
            let id = len(bb.nodes);
            let pushed: Building = {..bb, nodes: push(bb.nodes, { name: qualify(module.name, d.name.name), simple: d.name.name, module: m, body: NType(d) }), order: push(bb.order, EDef(id))};
            let types: Declaring = declare({..s.types, diags: []}, m, d.name, id, b"type");
            let ctors: Declaring = match d.body {
              TDSum(variants) -> fold(variants, {..s.ctors, diags: []}, |c: Declaring, v: VariantDef| declare(c, m, v.name, id, b"variant")),
              _ -> {..s.ctors, diags: []},
            };
            {..s, b: {..pushed, diags: append(append(pushed.diags, types.diags), ctors.diags)}, types: {..types, diags: []}, ctors: {..ctors, diags: []}}
          },
          IEffect(d) -> {
            let id = len(bb.nodes);
            let pushed: Building = {..bb, nodes: push(bb.nodes, { name: qualify(module.name, d.name.name), simple: d.name.name, module: m, body: NEffect(d) }), order: push(bb.order, EDef(id))};
            let effects: Declaring = declare({..s.effects, diags: []}, m, d.name, id, b"effect");
            {..s, b: {..pushed, diags: append(pushed.diags, effects.diags)}, effects: {..effects, diags: []}}
          },
          ITest(d) -> {..s, b: {..bb, order: push(bb.order, ETest(len(bb.tests))), tests: push(bb.tests, { key: qualify(module.name, d.name), module: m, def: d })}},
          ILaw(d) -> {..s, b: {..bb, order: push(bb.order, ELaw(len(bb.laws))), laws: push(bb.laws, { key: qualify(module.name, d.name), module: m, def: d })}},
          _ -> s,
        }
      });
    let wb: Building = walked.b;
    {..wb, items: push(wb.items, { fns: walked.fns.map, types: walked.types.map, effects: walked.effects.map, ctors: walked.ctors.map })}
  });
  let scopes = map(range(0, len(mods)), |m: Int| {
    let scope = at(r.scopes, m);
    let project = |bs: List<Binding>| fold(bs, map_new(), |acc: Map<Bytes, Target>, b: Binding|
      map_insert(acc, b.name, { owner: b.owner, name: simple_of(b.qualified, at(mods, b.owner).name) }));
    { values: project(scope.bound.values), types: project(scope.bound.types), effects: project(scope.bound.effects),
      modules: fold(scope.modules, map_new(), |acc: Map<Bytes, Int>, mb: ModBind| map_insert(acc, mb.binder, mb.target)) }
  });
  let index: Index = { mods: mods, nodes: built.nodes, tests: built.tests, laws: built.laws, order: built.order, items: built.items, scopes: scopes, effect_sketches: map_new() };
  { index: {..index, effect_sketches: sketch_effects(index)}, diags: built.diags }
}

fn sketch_effects(index: Index) -> Map<Int, Bytes> =
  fold(range(0, len(index.nodes)), map_new(), |acc: Map<Int, Bytes>, v: Int| {
    let node = at(index.nodes, v);
    match node.body {
      NEffect(_) -> map_insert(acc, v, finish(normalize_node(new_nz(index, node.module, map_new(), map_new(), map_new()), node.body)).bytes),
      _ -> acc,
    }
  })

fn is_effect(index: Index, v: Int) -> Bool = match at(index.nodes, v).body { NEffect(_) -> true, _ -> false }

// A qualified name consults only the named module's declarations; a bare one only the scope.
fn target(index: Index, module: Int, ns: Int, qual: Option<Bytes>, name: Bytes) -> Option<Target> = {
  let scope = at(index.scopes, module);
  match qual {
    Some(binder) -> match map_get(scope.modules, binder) { Some(owner) -> Some({ owner: owner, name: name }), None -> None },
    None -> map_get(if ns == 0 { scope.values } else if ns == 1 { scope.types } else { scope.effects }, name),
  }
}

fn value_target(index: Index, module: Int, q: QName) -> Option<ValueTarget> =
  match target(index, module, 0, qualifier(q), q.name.name) {
    None -> None,
    Some(t) -> {
      let items = at(index.items, t.owner);
      match map_get(items.fns, t.name) {
        Some(node) -> Some(VFn(node)),
        None -> match map_get(items.ctors, t.name) { Some(owner) -> Some(VCtor({ owner: owner, name: t.name })), None -> None },
      }
    },
  }

fn ctor_target(index: Index, module: Int, q: QName) -> Option<ValueTarget> =
  match target(index, module, 0, qualifier(q), q.name.name) {
    None -> None,
    Some(t) -> match map_get(at(index.items, t.owner).ctors, t.name) { Some(owner) -> Some(VCtor({ owner: owner, name: t.name })), None -> None },
  }

fn type_target(index: Index, module: Int, qual: Option<Bytes>, name: Bytes) -> Option<Int> =
  match target(index, module, 1, qual, name) { None -> None, Some(t) -> map_get(at(index.items, t.owner).types, t.name) }

fn effect_target(index: Index, module: Int, q: QName) -> Option<Int> =
  match target(index, module, 2, qualifier(q), q.name.name) { None -> None, Some(t) -> map_get(at(index.items, t.owner).effects, t.name) }

// Tarjan's components, iterative: completion order, each component's members as they left the stack.
type Tarjan = { index: List<Int>, low: List<Int>, on_stack: List<Bool>, stack: List<Int>, call: List<{ v: Int, edge: Int }>, out: List<List<Int>>, next: Int }

pub fn tarjan(n: Int, edges: List<List<Int>>) -> List<List<Int>> = {
  let unvisited = 0 - 1;
  let start = { index: map(range(0, n), |i: Int| unvisited), low: map(range(0, n), |i: Int| 0), on_stack: map(range(0, n), |i: Int| false),
                stack: [], call: [], out: [], next: 0 };
  let total = fold(edges, 0, |acc: Int, es: List<Int>| acc + len(es));
  let done = fold(range(0, n), start, |t: Tarjan, root: Int|
    if at(t.index, root) != unvisited { t } else {
      let opened: Tarjan = {..t, index: set_at(t.index, root, t.next), low: set_at(t.low, root, t.next), next: t.next + 1,
                            stack: push(t.stack, root), on_stack: set_at(t.on_stack, root, true), call: [{ v: root, edge: 0 }]};
      iterate(opened, 2 * (n + total) + 4, |x: Tarjan| if len(x.call) == 0 { Stop(x) } else { Continue(tarjan_step(n, edges, x)) })
    });
  done.out
}

fn set_at<a>(xs: List<a>, i: Int, v: a) -> List<a> = list_set(xs, i, v)

fn tarjan_step(n: Int, edges: List<List<Int>>, t: Tarjan) -> Tarjan = {
  let top = at(t.call, len(t.call) - 1);
  let rest = take(t.call, len(t.call) - 1);
  let out = at(edges, top.v);
  if top.edge < len(out) {
    let again = push(rest, { v: top.v, edge: top.edge + 1 });
    let w = at(out, top.edge);
    if w >= n { {..t, call: again} }
    else if at(t.index, w) == 0 - 1 {
      {..t, index: set_at(t.index, w, t.next), low: set_at(t.low, w, t.next), next: t.next + 1,
            stack: push(t.stack, w), on_stack: set_at(t.on_stack, w, true), call: push(again, { v: w, edge: 0 })}
    } else if at(t.on_stack, w) {
      {..t, low: set_at(t.low, top.v, min(at(t.low, top.v), at(t.index, w))), call: again}
    } else { {..t, call: again} }
  } else {
    let lowered: Tarjan = if len(rest) > 0 {
      let parent = at(rest, len(rest) - 1).v;
      {..t, low: set_at(t.low, parent, min(at(t.low, parent), at(t.low, top.v)))}
    } else { t };
    let popped: Tarjan = if at(lowered.low, top.v) == at(lowered.index, top.v) {
      let split = iterate({ stack: lowered.stack, on: lowered.on_stack, comp: [] }, len(lowered.stack) + 1, |s: { stack: List<Int>, on: List<Bool>, comp: List<Int> }| {
        let w = at(s.stack, len(s.stack) - 1);
        let next = { stack: take(s.stack, len(s.stack) - 1), on: set_at(s.on, w, false), comp: push(s.comp, w) };
        if w == top.v { Stop(next) } else { Continue(next) }
      });
      {..lowered, stack: split.stack, on_stack: split.on, out: push(lowered.out, split.comp)}
    } else { lowered };
    {..popped, call: rest}
  }
}

fn take<a>(xs: List<a>, n: Int) -> List<a> = map(range(0, n), |i: Int| at(xs, i))

fn is_cyclic(component: List<Int>, edges: List<List<Int>>) -> Bool =
  if len(component) != 1 { true } else { let only = at(component, 0); contains_int(at(edges, only), only) }

// --- The byte encoding ----------------------------------------------------------------

fn t_local() -> Int = 1
fn t_ref_hash() -> Int = 2
fn t_ref_self() -> Int = 3
fn t_ref_index() -> Int = 4
fn t_free() -> Int = 5
fn t_ctor() -> Int = 6
fn t_ty_param() -> Int = 7
fn t_row_param() -> Int = 8
fn t_free_qualified() -> Int = 9
fn t_none() -> Int = 10
fn t_some() -> Int = 11
fn t_ref_name() -> Int = 12
fn t_param_default() -> Int = 13
fn t_fn() -> Int = 20
fn t_type_alias() -> Int = 21
fn t_type_sum() -> Int = 22
fn t_effect() -> Int = 23
fn t_test() -> Int = 24
fn t_variant() -> Int = 25
fn t_op() -> Int = 26
fn t_type() -> Int = 27
fn t_law() -> Int = 28
fn t_spec() -> Int = 29
fn t_ty_con() -> Int = 30
fn t_ty_fn() -> Int = 31
fn t_ty_record() -> Int = 32
fn t_ty_unit() -> Int = 33
fn t_lit_int() -> Int = 40
fn t_lit_bool() -> Int = 41
fn t_lit_str() -> Int = 42
fn t_lit_unit() -> Int = 43
fn t_lit_bytes() -> Int = 44
fn t_lit_float() -> Int = 45
fn t_lit_decimal() -> Int = 46
// A tag of its own: `5` and `5u32` are different definitions. Tags never renumber, or stored hashes move.
fn t_lit_fixed() -> Int = 96
fn t_e_lit() -> Int = 50
fn t_e_var() -> Int = 51
fn t_e_binary() -> Int = 52
fn t_e_unary() -> Int = 53
fn t_e_lambda() -> Int = 54
fn t_e_app() -> Int = 55
fn t_e_if() -> Int = 56
fn t_e_match() -> Int = 57
fn t_e_block() -> Int = 58
fn t_e_record() -> Int = 59
fn t_e_field() -> Int = 60
fn t_e_list() -> Int = 61
fn t_e_perform() -> Int = 62
fn t_e_handle() -> Int = 63
fn t_e_with_cell() -> Int = 64
fn t_e_simulate() -> Int = 65
fn t_e_with_region() -> Int = 66
fn t_s_let() -> Int = 70
fn t_s_expr() -> Int = 71
fn t_p_wildcard() -> Int = 80
fn t_p_var() -> Int = 81
fn t_p_lit() -> Int = 82
fn t_p_ctor() -> Int = 83
fn t_p_record() -> Int = 84
fn t_p_list() -> Int = 85
fn t_row() -> Int = 90
fn t_atom() -> Int = 91
fn t_arm() -> Int = 92
fn t_clause() -> Int = 93
fn t_return_clause() -> Int = 94
fn t_constraint() -> Int = 95

// An explicit table: renumbering a row invalidates every cached result in every store.
fn binop_byte(op: Bytes) -> Int =
  if op == b"add" { 1 } else if op == b"sub" { 2 } else if op == b"mul" { 3 } else if op == b"div" { 4 } else if op == b"rem" { 5 }
  else if op == b"eq" { 6 } else if op == b"ne" { 7 } else if op == b"lt" { 8 } else if op == b"le" { 9 } else if op == b"gt" { 10 } else if op == b"ge" { 11 }
  else if op == b"and" { 12 } else if op == b"or" { 13 } else if op == b"concat" { 14 }
  else if op == b"bitand" { 15 } else if op == b"bitor" { 16 } else if op == b"bitxor" { 17 } else if op == b"shl" { 18 } else if op == b"shr" { 19 } else { 20 }

fn unop_byte(op: Bytes) -> Int = if op == b"neg" { 1 } else if op == b"not" { 2 } else { 3 }

fn mode_byte(m: Mode) -> Int = match m { MRead -> 0, MWrite -> 1, MBad -> 0 }

fn spec_tag(k: SpecKind) -> Int = match k { SRequires -> 1, SEnsures -> 2 }

fn deriver_byte(d: Deriver) -> Int = deriver_tag(d) + 1

// `out` is chunks concatenated once at the end; `refs` is first-mention order; the binder lists are de Bruijn levels.
type Nz = { index: Index, module: Int, hashes: Map<Int, Bytes>, component: Map<Int, Int>, effects: Map<Int, Int>,
            out: List<Bytes>, refs: List<Int>, seen: Map<Int, Bool>, values: List<Bytes>, ty_params: List<Bytes>, row_params: List<Bytes>,
            by_name: Bool, deferred: Option<List<Int>> }

type Finished = { bytes: Bytes, refs: List<Int> }

fn new_nz(index: Index, module: Int, hashes: Map<Int, Bytes>, component: Map<Int, Int>, effects: Map<Int, Int>) -> Nz =
  { index: index, module: module, hashes: hashes, component: component, effects: effects, out: [], refs: [], seen: map_new(),
    values: [], ty_params: [], row_params: [], by_name: false, deferred: None }

fn finish(z: Nz) -> Finished = { bytes: bytes_concat_all(z.out), refs: z.refs }

fn emit(z: Nz, b: Bytes) -> Nz = {..z, out: push(z.out, b)}
fn tag(z: Nz, t: Int) -> Nz = emit(z, byte_of(t))
fn u32v(z: Nz, v: Int) -> Nz = emit(z, u32_le(v))
fn boolv(z: Nz, b: Bool) -> Nz = emit(z, byte_of(if b { 1 } else { 0 }))
fn strv(z: Nz, s: Bytes) -> Nz = emit(u32v(z, bytes_len(s)), s)

type Captured = { z: Nz, bytes: Bytes }

// The bytes `f` writes, kept apart from the encoding so far.
fn capture(z: Nz, f: (Nz) -> Nz) -> Captured = {
  let inner: Nz = f({..z, out: []});
  { z: {..inner, out: z.out}, bytes: bytes_concat_all(inner.out) }
}

fn normalize_node(z: Nz, body: NodeBody) -> Nz =
  match body { NFn(d) -> fn_def(z, d), NType(d) -> type_def(z, d), NEffect(d) -> effect_def(z, d) }

// A reference in first-mention order, unless a row is holding its mentions back.
fn mention(z: Nz, node: Int) -> Nz =
  match z.deferred {
    Some(held) -> {..z, deferred: Some(push(held, node))},
    None -> if map_contains(z.seen, node) { z } else { {..z, seen: map_insert(z.seen, node, true), refs: push(z.refs, node)} },
  }

fn node_ref(z: Nz, node: Int) -> Nz = {
  let m: Nz = mention(z, node);
  if m.by_name { strv(tag(m, t_ref_name()), at(m.index.nodes, node).name) }
  else {
    match map_get(m.component, node) {
      Some(ix) -> u32v(tag(m, t_ref_index()), ix),
      None -> match map_get(m.hashes, node) { Some(h) -> emit(tag(m, t_ref_hash()), h), None -> tag(m, t_ref_self()) },
    }
  }
}

fn free_ref(z: Nz, qual: Option<Bytes>, name: Bytes) -> Nz =
  match qual { None -> strv(tag(z, t_free()), name), Some(m) -> strv(strv(tag(z, t_free_qualified()), m), name) }

fn ctor_bytes(z: Nz, owner: Int, name: Bytes) -> Nz = strv(node_ref(tag(z, t_ctor()), owner), name)

// A local binder wins over everything, and only a bare name can be one.
fn value_ref(z: Nz, q: QName) -> Nz = {
  let local = if is_bare(q) { rposition(z.values, q.name.name) } else { None };
  match local {
    Some(level) -> u32v(tag(z, t_local()), level),
    None -> match value_target(z.index, z.module, q) {
      Some(t) -> match t { VFn(node) -> node_ref(z, node), VCtor(c) -> ctor_bytes(z, c.owner, c.name) },
      None -> free_ref(z, qualifier(q), q.name.name),
    },
  }
}

fn type_ref(z: Nz, qual: Option<Bytes>, name: Bytes) -> Nz = {
  let param = match qual { None -> rposition(z.ty_params, name), Some(_) -> None };
  match param {
    Some(level) -> u32v(tag(z, t_ty_param()), level),
    None -> match type_target(z.index, z.module, qual, name) { Some(node) -> node_ref(z, node), None -> free_ref(z, qual, name) },
  }
}

// Effects are nominal: the declaration referenced, then the slot the component's enumeration gave it.
fn effect_ref(z: Nz, q: QName) -> Nz =
  match effect_target(z.index, z.module, q) {
    Some(node) -> u32v(node_ref(z, node), match map_get(z.effects, node) { Some(s) -> s, None -> 0 }),
    None -> free_ref(z, qualifier(q), q.name.name),
  }

fn ctor_ref(z: Nz, q: QName) -> Nz =
  match ctor_target(z.index, z.module, q) { Some(VCtor(c)) -> ctor_bytes(z, c.owner, c.name), _ -> free_ref(z, qualifier(q), q.name.name) }

fn opt_type(z: Nz, t: Option<TypeExpr>) -> Nz = match t { None -> tag(z, t_none()), Some(te) -> type_expr(tag(z, t_some()), te) }
fn opt_row(z: Nz, r: Option<RowExpr>) -> Nz = match r { None -> tag(z, t_none()), Some(row) -> row_expr(tag(z, t_some()), row) }
fn opt_expr(z: Nz, e: Option<Expr>) -> Nz = match e { None -> tag(z, t_none()), Some(x) -> expr(tag(z, t_some()), x) }
fn opt_name(z: Nz, i: Option<Ident>) -> Nz = match i { None -> tag(z, t_none()), Some(x) -> strv(tag(z, t_some()), x.name) }

fn push_generics(z: Nz, def: FnDef) -> Nz =
  {..z, ty_params: append(z.ty_params, map(def.generics.types, |g: Ident| g.name)), row_params: append(z.row_params, map(def.generics.effects, |g: Ident| g.name))}

fn fn_def(z: Nz, d: FnDef) -> Nz = {
  let z1: Nz = push_generics(u32v(u32v(tag(z, t_fn()), len(d.generics.types)), len(d.generics.effects)), d);
  // Before the parameter names reach `values`: a default is closed.
  let z2: Nz = fold(d.params, u32v(z1, len(d.params)), |acc: Nz, p: Param|
    match p.default { Some(dflt) -> expr(opt_type(tag(acc, t_param_default()), p.ty), dflt), None -> opt_type(acc, p.ty) });
  let z3: Nz = constraints(opt_row(opt_type(z2, d.ret), d.effects), d.constraints);
  let z4: Nz = {..z3, values: append(z3.values, map(d.params, |p: Param| p.name.name))};
  expr(z4, d.body)
}

// Sorted and deduplicated: the same two constraints in the other order are one definition.
fn constraints(z: Nz, cs: List<Constraint>) -> Nz = {
  let levels = fold(cs, [], |acc: List<{ level: Int, deriver: Int }>, c: Constraint|
    match rposition(z.ty_params, c.param.name) { Some(level) -> push(acc, { level: level, deriver: deriver_byte(c.deriver) }), None -> acc });
  let sorted = fold(levels, [], |acc: List<{ level: Int, deriver: Int }>, x: { level: Int, deriver: Int }| insert_pair(acc, x));
  fold(sorted, u32v(z, len(sorted)), |acc: Nz, x: { level: Int, deriver: Int }| tag(u32v(tag(acc, t_constraint()), x.level), x.deriver))
}

fn insert_pair(sorted: List<{ level: Int, deriver: Int }>, x: { level: Int, deriver: Int }) -> List<{ level: Int, deriver: Int }> = {
  let dup = fold(sorted, false, |b: Bool, y: { level: Int, deriver: Int }| b || (y.level == x.level && y.deriver == x.deriver));
  if dup { sorted } else {
    let n = len(sorted);
    let i = fold(range(0, n), n, |acc: Int, j: Int| if acc < n { acc } else { let y = at(sorted, j); if x.level < y.level || (x.level == y.level && x.deriver < y.deriver) { j } else { acc } });
    append(push(take(sorted, i), x), map(range(i, n), |j: Int| at(sorted, j)))
  }
}

fn type_def(z: Nz, d: TypeDef) -> Nz = {
  let z0: Nz = tag(z, t_type());
  let z1: Nz = {..z0, ty_params: append(z0.ty_params, map(d.params, |p: Ident| p.name))};
  let z2: Nz = u32v(z1, len(d.params));
  match d.body {
    TDAlias(t) -> type_expr(tag(z2, t_type_alias()), t),
    TDSum(variants) -> fold(variants, u32v(tag(z2, t_type_sum()), len(variants)), |acc: Nz, v: VariantDef|
      fold(v.fields, u32v(strv(tag(acc, t_variant()), v.name.name), len(v.fields)), |a: Nz, f: TypeExpr| type_expr(a, f))),
  }
}

// Operations are looked up by name, so their declaration order is sorted away.
fn effect_def(z: Nz, d: EffectDef) -> Nz = {
  let z1: Nz = boolv(tag(z, t_effect()), d.is_nondet);
  let ops = fold(d.ops, { z: z1, encoded: [] }, |acc: { z: Nz, encoded: List<Bytes> }, op: OpDef| {
    let c: Captured = capture(acc.z, |x: Nz| op_def(x, op));
    { z: c.z, encoded: push(acc.encoded, c.bytes) }
  });
  let sorted = sort_bytes(ops.encoded);
  fold(sorted, u32v(ops.z, len(sorted)), |acc: Nz, b: Bytes| emit(acc, b))
}

fn bytes_lt(a: Bytes, b: Bytes) -> Bool = match compare_values(a, b) { Less -> true, _ -> false }

fn sort_bytes(xs: List<Bytes>) -> List<Bytes> =
  fold(xs, [], |acc: List<Bytes>, x: Bytes| {
    let n = len(acc);
    let i = fold(range(0, n), n, |p: Int, j: Int| if p < n { p } else if bytes_lt(x, at(acc, j)) { j } else { p });
    append(push(take(acc, i), x), map(range(i, n), |j: Int| at(acc, j)))
  })

fn op_def(z: Nz, op: OpDef) -> Nz = {
  let z1: Nz = boolv(emit(strv(tag(z, t_op()), op.name.name), byte_of(mode_byte(op.mode))), op.resource_param);
  type_expr(fold(op.params, u32v(z1, len(op.params)), |acc: Nz, p: TypeExpr| type_expr(acc, p)), op.ret)
}

pub fn test_def(z: Nz, d: TestDef) -> Nz = expr(boolv(tag(z, t_test()), d.is_nondet), d.body)

// A law's binder types are part of its identity; their names are levels like any other binder.
pub fn law_def(z: Nz, d: LawDef) -> Nz = {
  let z1: Nz = fold(d.binders, u32v(boolv(tag(z, t_law()), d.host), len(d.binders)), |acc: Nz, b: Binder| type_expr(acc, b.ty));
  let z2: Nz = {..z1, values: append(z1.values, map(d.binders, |b: Binder| b.name.name))};
  expr(opt_expr(z2, d.guard), d.body)
}

// In its owner's scope: generics, parameters, and `result` for an `ensures`. Parameter defaults are not written.
pub fn spec_clause(z: Nz, owner: FnDef, clause: SpecClause) -> Nz = {
  let z1: Nz = push_generics(u32v(u32v(emit(tag(z, t_spec()), byte_of(spec_tag(clause.kind))), len(owner.generics.types)), len(owner.generics.effects)), owner);
  let counted: Nz = u32v(z1, len(owner.params));
  let z2: Nz = {..counted, values: append(counted.values, map(owner.params, |p: Param| p.name.name))};
  let z3: Nz = match clause.kind { SEnsures -> {..z2, values: push(z2.values, b"result")}, SRequires -> z2 };
  expr(z3, clause.expr)
}

fn type_expr(z: Nz, t: TypeExpr) -> Nz =
  match t {
    TVar(name) -> u32v(type_ref(tag(z, t_ty_con()), None, name.name), 0),
    TCon(c) -> fold(c.args, u32v(type_ref(tag(z, t_ty_con()), qualifier(c.name), c.name.name.name), len(c.args)), |acc: Nz, a: TypeExpr| type_expr(acc, a)),
    TFn(f) -> opt_row(type_expr(fold(f.params, u32v(tag(z, t_ty_fn()), len(f.params)), |acc: Nz, p: TypeExpr| type_expr(acc, p)), f.ret), f.effects),
    // A record type is a map from label to type, so field order is sorted away.
    TRecord(r) -> {
      let fields = fold(r.fields, { z: tag(z, t_ty_record()), encoded: [] }, |acc: { z: Nz, encoded: List<Bytes> }, f: { name: Ident, ty: TypeExpr }| {
        let c: Captured = capture(acc.z, |x: Nz| type_expr(strv(x, f.name.name), f.ty));
        { z: c.z, encoded: push(acc.encoded, c.bytes) }
      });
      let sorted = sort_bytes(fields.encoded);
      fold(sorted, u32v(fields.z, len(sorted)), |acc: Nz, b: Bytes| emit(acc, b))
    },
    TUnit(_) -> tag(z, t_ty_unit()),
    TBad(_) -> tag(z, t_ty_unit()),
  }

type AtomEncoding = { bytes: Bytes, tie: Bytes, held: List<Int> }

// A row is a set: atoms sorted by encoding, then by the effect's declaration, and deduplicated.
// Every atom is mentioned, including one the dedup drops.
fn row_expr(z: Nz, r: RowExpr) -> Nz = {
  let z0: Nz = tag(z, t_row());
  let atoms = fold(r.atoms, { z: z0, encoded: [] }, |acc: { z: Nz, encoded: List<AtomEncoding> }, a: AtomExpr| {
    let outer = acc.z.deferred;
    let c: Captured = capture({..acc.z, deferred: Some([])}, |x: Nz| atom(x, a));
    let held = match c.z.deferred { Some(h) -> h, None -> [] };
    let tie = match effect_target(acc.z.index, acc.z.module, a.eff) {
      Some(node) -> match map_get(acc.z.index.effect_sketches, node) { Some(s) -> s, None -> b"" },
      None -> b"",
    };
    { z: {..c.z, deferred: outer}, encoded: push(acc.encoded, { bytes: c.bytes, tie: tie, held: held }) }
  });
  let sorted = fold(atoms.encoded, [], |acc: List<AtomEncoding>, x: AtomEncoding| insert_atom(acc, x));
  let distinct = fold(range(0, len(sorted)), 0, |acc: Int, i: Int| if i == 0 || at(sorted, i - 1).bytes != at(sorted, i).bytes { acc + 1 } else { acc });
  let written = fold(range(0, len(sorted)), u32v(atoms.z, distinct), |acc: Nz, i: Int| {
    let x = at(sorted, i);
    let mentioned: Nz = fold(x.held, acc, |a: Nz, node: Int| mention(a, node));
    if i > 0 && at(sorted, i - 1).bytes == x.bytes { mentioned } else { emit(mentioned, x.bytes) }
  });
  match r.tail {
    None -> tag(written, t_none()),
    Some(t) -> match rposition(written.row_params, t.name) {
      Some(level) -> u32v(tag(tag(written, t_some()), t_row_param()), level),
      None -> strv(tag(tag(written, t_some()), t_free()), t.name),
    },
  }
}

fn atom_lt(a: AtomEncoding, b: AtomEncoding) -> Bool =
  bytes_lt(a.bytes, b.bytes) || (a.bytes == b.bytes && bytes_lt(a.tie, b.tie))

fn insert_atom(sorted: List<AtomEncoding>, x: AtomEncoding) -> List<AtomEncoding> = {
  let n = len(sorted);
  let i = fold(range(0, n), n, |p: Int, j: Int| if p < n { p } else if atom_lt(x, at(sorted, j)) { j } else { p });
  append(push(take(sorted, i), x), map(range(i, n), |j: Int| at(sorted, j)))
}

fn atom(z: Nz, a: AtomExpr) -> Nz = opt_name(emit(effect_ref(tag(z, t_atom()), a.eff), byte_of(mode_byte(a.mode))), a.resource)

fn expr(z: Nz, e: Expr) -> Nz =
  match e {
    // `{ e }` and `e` are the same computation.
    EBlock(b) -> if len(b.stmts) == 0 { match b.tail { Some(t) -> expr(z, t), None -> block(z, b.stmts, b.tail) } } else { block(z, b.stmts, b.tail) },
    ELit(l) -> lit(tag(z, t_e_lit()), l.lit),
    EVar(v) -> value_ref(tag(z, t_e_var()), v.name),
    EBinary(b) -> expr(expr(emit(tag(z, t_e_binary()), byte_of(binop_byte(b.op))), b.lhs), b.rhs),
    EUnary(u) -> expr(emit(tag(z, t_e_unary()), byte_of(unop_byte(u.op))), u.operand),
    ELambda(l) -> {
      let z1: Nz = fold(l.params, u32v(tag(z, t_e_lambda()), len(l.params)), |acc: Nz, p: Param| opt_type(acc, p.ty));
      let inner: Nz = expr({..z1, values: append(z1.values, map(l.params, |p: Param| p.name.name))}, l.body);
      {..inner, values: z1.values}
    },
    EApp(a) -> fold(a.args, u32v(expr(tag(z, t_e_app()), a.func), len(a.args)), |acc: Nz, x: Expr| expr(acc, x)),
    EIf(i) -> expr(expr(expr(tag(z, t_e_if()), i.cond), i.then_branch), i.else_branch),
    EMatch(m) -> fold(m.arms, u32v(expr(tag(z, t_e_match()), m.scrutinee), len(m.arms)), |acc: Nz, arm: MatchArm| {
      let inner: Nz = expr(opt_expr(pattern(tag(acc, t_arm()), arm.pat), arm.guard), arm.body);
      {..inner, values: acc.values}
    }),
    ERecord(r) -> fold(r.fields, u32v(tag(z, t_e_record()), len(r.fields)), |acc: Nz, f: RecField| expr(strv(acc, f.name.name), f.value)),
    ERecordUpdate(_) -> panic("`{..b, f: e}` is expanded away before hashing"),
    ETry(_) -> panic("`e?` is expanded away before hashing"),
    EField(f) -> strv(expr(tag(z, t_e_field()), f.base), f.field.name),
    EList(l) -> fold(l.items, u32v(tag(z, t_e_list()), len(l.items)), |acc: Nz, x: Expr| expr(acc, x)),
    EPerform(p) -> fold(p.args, u32v(opt_name(strv(effect_ref(tag(z, t_e_perform()), p.eff), p.op.name), p.resource), len(p.args)), |acc: Nz, x: Expr| expr(acc, x)),
    EHandle(h) -> {
      let clauses: Nz = fold(h.clauses, u32v(expr(tag(z, t_e_handle()), h.body), len(h.clauses)), |acc: Nz, c: HandleClause| {
        let head: Nz = u32v(opt_name(strv(effect_ref(tag(acc, t_clause()), c.eff), c.op.name), c.resource), len(c.params));
        let bound: Nz = {..head, values: append(head.values, map(c.params, |p: Ident| p.name))};
        // Whether a clause binds a continuation is part of what the definition is.
        let resumed: Nz = match c.resume {
          None -> tag(bound, t_none()),
          Some(k) -> { let some: Nz = tag(bound, t_some()); {..some, values: push(some.values, k.name)} },
        };
        let inner: Nz = expr(resumed, c.body);
        {..inner, values: acc.values}
      });
      match h.ret {
        None -> tag(clauses, t_none()),
        Some(rc) -> {
          let head: Nz = tag(tag(clauses, t_some()), t_return_clause());
          let inner: Nz = expr({..head, values: push(head.values, rc.binder.name)}, rc.body);
          {..inner, values: clauses.values}
        },
      }
    },
    EWithCell(c) -> {
      let head: Nz = expr(strv(tag(z, t_e_with_cell()), c.resource.name), c.init);
      let inner: Nz = expr({..head, values: push(head.values, c.binder.name)}, c.body);
      {..inner, values: head.values}
    },
    EWithRegion(w) -> expr(strv(tag(z, t_e_with_region()), w.region.name), w.body),
    ESimulate(s) -> expr(tag(z, t_e_simulate()), s.body),
    EBad(_) -> panic("a placeholder reached the hasher"),
  }

fn block(z: Nz, stmts: List<Stmt>, tail: Option<Expr>) -> Nz = {
  let head: Nz = u32v(tag(z, t_e_block()), len(stmts));
  let ordered: { z: Nz, order: List<Int> } = stmt_order(head, stmts);
  let walked: Nz = fold(ordered.order, ordered.z, |acc: Nz, i: Int| stmt(acc, at(stmts, i)));
  let tailed: Nz = opt_expr(walked, tail);
  {..tailed, values: head.values}
}

// Consecutive `let`s that commute are emitted in the order their own encodings sort in.
fn stmt_order(z: Nz, stmts: List<Stmt>) -> { z: Nz, order: List<Int> } = {
  let n = len(stmts);
  let walked = iterate({ z: z, i: 0, order: [] }, n + 2, |s: { z: Nz, i: Int, order: List<Int> }|
    if s.i >= n { Stop(s) } else {
      let run = commutable_run(stmts, s.i);
      if run < 2 { Continue({..s, i: s.i + 1, order: push(s.order, s.i)}) }
      else {
        let sorted: { z: Nz, order: List<Int> } = sorted_run(s.z, stmts, s.i, s.i + run);
        Continue({ z: sorted.z, i: s.i + run, order: append(s.order, sorted.order) })
      }
    });
  { z: walked.z, order: walked.order }
}

// The members of the run, ordered by their encodings; ties keep their source order.
fn sorted_run(z: Nz, stmts: List<Stmt>, from: Int, to: Int) -> { z: Nz, order: List<Int> } = {
  let keyed = fold(range(from, to), { z: z, keys: [] }, |acc: { z: Nz, keys: List<{ key: Bytes, i: Int }> }, i: Int| {
    let c: Captured = capture(acc.z, |x: Nz| stmt(x, at(stmts, i)));
    { z: {..c.z, values: acc.z.values}, keys: push(acc.keys, { key: c.bytes, i: i }) }
  });
  let sorted = fold(keyed.keys, [], |acc: List<{ key: Bytes, i: Int }>, x: { key: Bytes, i: Int }| {
    let n = len(acc);
    let at_ = fold(range(0, n), n, |p: Int, j: Int| if p < n { p } else { let y = at(acc, j); if bytes_lt(x.key, y.key) || (x.key == y.key && x.i < y.i) { j } else { p } });
    append(push(take(acc, at_), x), map(range(at_, n), |j: Int| at(acc, j)))
  });
  { z: keyed.z, order: map(sorted, |x: { key: Bytes, i: Int }| x.i) }
}

fn stmt(z: Nz, s: Stmt) -> Nz =
  match s {
    SLet(l) -> pattern(expr(opt_type(tag(z, t_s_let()), l.ty), l.value), l.pat),
    SExpr(e) -> expr(tag(z, t_s_expr()), e),
  }

fn lit(z: Nz, l: Lit) -> Nz =
  match l {
    LInt(i) -> emit(tag(z, t_lit_int()), i64_le(i)),
    LFixed(ty, v) -> emit(emit(tag(z, t_lit_fixed()), width_index(ty)), i64_le(v)),
    LBool(b) -> boolv(tag(z, t_lit_bool()), b),
    LStr(s) -> strv(tag(z, t_lit_str()), s),
    LBytes(b) -> emit(u32v(tag(z, t_lit_bytes()), bytes_len(b)), b),
    LFloat(text) -> emit(tag(z, t_lit_float()), i64_le(float_bits(text))),
    LDec(text) -> { let p = decimal_parts(text); emit(emit(tag(z, t_lit_decimal()), p.mantissa), u32_le(p.scale)) },
    LUnit -> tag(z, t_lit_unit()),
    LBad -> panic("a placeholder literal reached the hasher"),
  }

fn pattern(z: Nz, p: Pattern) -> Nz =
  match p {
    PWild(_) -> tag(z, t_p_wildcard()),
    PVar(v) -> { let t: Nz = tag(z, t_p_var()); {..t, values: push(t.values, v.name.name)} },
    PLit(l) -> lit(tag(z, t_p_lit()), l.lit),
    PCtor(c) -> fold(c.args, u32v(ctor_ref(tag(z, t_p_ctor()), c.name), len(c.args)), |acc: Nz, a: Pattern| pattern(acc, a)),
    PRecord(r) -> boolv(fold(r.fields, u32v(tag(z, t_p_record()), len(r.fields)), |acc: Nz, f: { name: Ident, pat: Pattern }| pattern(strv(acc, f.name.name), f.pat)), r.rest),
    PList(l) -> {
      let items: Nz = fold(l.items, u32v(tag(z, t_p_list()), len(l.items)), |acc: Nz, i: Pattern| pattern(acc, i));
      match l.rest { None -> tag(items, t_none()), Some(rest) -> pattern(tag(items, t_some()), rest) }
    },
    PBad(_) -> panic("a placeholder pattern reached the hasher"),
  }

fn commutable_run(stmts: List<Stmt>, from: Int) -> Int = {
  let n = len(stmts);
  let to = iterate(from, n - from + 1, |i: Int|
    if i >= n { Stop(i) } else { match at(stmts, i) { SLet(l) -> if is_pure(l.value) { Continue(i + 1) } else { Stop(i) }, _ -> Stop(i) } });
  if to - from < 2 { 0 } else {
    let run = map(range(from, to), |i: Int| at(stmts, i));
    let counted = fold(run, { count: 0, bound: [] }, |acc: { count: Int, bound: List<Bytes> }, s: Stmt|
      match s { SLet(l) -> { let b = pattern_binders(l.pat, acc.bound); { count: acc.count + b.count, bound: b.bound } }, _ -> acc });
    if counted.count != len(counted.bound) { 0 }
    else if fold(run, false, |b: Bool, s: Stmt| b || (match s { SLet(l) -> mentions(l.value, counted.bound), _ -> false })) { 0 }
    else { to - from }
  }
}

fn insert_name(xs: List<Bytes>, v: Bytes) -> List<Bytes> = if contains_bytes(xs, v) { xs } else { push(xs, v) }

fn pattern_binders(p: Pattern, out: List<Bytes>) -> { count: Int, bound: List<Bytes> } =
  match p {
    PVar(v) -> { count: 1, bound: insert_name(out, v.name.name) },
    PWild(_) -> { count: 0, bound: out },
    PLit(_) -> { count: 0, bound: out },
    PBad(_) -> { count: 0, bound: out },
    PCtor(c) -> fold(c.args, { count: 0, bound: out }, |acc: { count: Int, bound: List<Bytes> }, a: Pattern| { let b = pattern_binders(a, acc.bound); { count: acc.count + b.count, bound: b.bound } }),
    PRecord(r) -> fold(r.fields, { count: 0, bound: out }, |acc: { count: Int, bound: List<Bytes> }, f: { name: Ident, pat: Pattern }| { let b = pattern_binders(f.pat, acc.bound); { count: acc.count + b.count, bound: b.bound } }),
    PList(l) -> {
      let items = fold(l.items, { count: 0, bound: out }, |acc: { count: Int, bound: List<Bytes> }, i: Pattern| { let b = pattern_binders(i, acc.bound); { count: acc.count + b.count, bound: b.bound } });
      match l.rest { Some(rest) -> { let b = pattern_binders(rest, items.bound); { count: items.count + b.count, bound: b.bound } }, None -> items }
    },
  }

pub fn is_pure(e: Expr) -> Bool =
  match e {
    EApp(_) -> false,
    EPerform(_) -> false,
    EHandle(_) -> false,
    EWithCell(_) -> false,
    EWithRegion(_) -> false,
    ESimulate(_) -> false,
    ETry(_) -> false,
    EBad(_) -> false,
    ELit(_) -> true,
    EVar(_) -> true,
    EBinary(b) -> is_pure(b.lhs) && is_pure(b.rhs),
    EUnary(u) -> is_pure(u.operand),
    ELambda(l) -> is_pure(l.body),
    EIf(i) -> is_pure(i.cond) && is_pure(i.then_branch) && is_pure(i.else_branch),
    EMatch(m) -> is_pure(m.scrutinee) && fold(m.arms, true, |acc: Bool, a: MatchArm| acc && is_pure(a.body) && (match a.guard { Some(g) -> is_pure(g), None -> true })),
    EBlock(b) -> fold(b.stmts, true, |acc: Bool, s: Stmt| acc && (match s { SLet(l) -> is_pure(l.value), SExpr(x) -> is_pure(x) })) && (match b.tail { Some(t) -> is_pure(t), None -> true }),
    ERecord(r) -> fold(r.fields, true, |acc: Bool, f: RecField| acc && is_pure(f.value)),
    ERecordUpdate(r) -> is_pure(r.base) && fold(r.fields, true, |acc: Bool, f: RecField| acc && is_pure(f.value)),
    EField(f) -> is_pure(f.base),
    EList(l) -> fold(l.items, true, |acc: Bool, x: Expr| acc && is_pure(x)),
  }

// Deliberately blind to scope: any occurrence of the name counts.
fn mentions(e: Expr, names: List<Bytes>) -> Bool =
  match e {
    ELit(_) -> false,
    EBad(_) -> false,
    EVar(v) -> is_bare(v.name) && contains_bytes(names, v.name.name.name),
    EBinary(b) -> mentions(b.lhs, names) || mentions(b.rhs, names),
    EUnary(u) -> mentions(u.operand, names),
    ELambda(l) -> fold(l.params, false, |acc: Bool, p: Param| acc || contains_bytes(names, p.name.name)) || mentions(l.body, names),
    EApp(a) -> mentions(a.func, names) || fold(a.args, false, |acc: Bool, x: Expr| acc || mentions(x, names)),
    EIf(i) -> mentions(i.cond, names) || mentions(i.then_branch, names) || mentions(i.else_branch, names),
    EMatch(m) -> mentions(m.scrutinee, names) || fold(m.arms, false, |acc: Bool, a: MatchArm|
      acc || pattern_mentions(a.pat, names) || (match a.guard { Some(g) -> mentions(g, names), None -> false }) || mentions(a.body, names)),
    EBlock(b) -> fold(b.stmts, false, |acc: Bool, s: Stmt| acc || (match s { SLet(l) -> pattern_mentions(l.pat, names) || mentions(l.value, names), SExpr(x) -> mentions(x, names) }))
      || (match b.tail { Some(t) -> mentions(t, names), None -> false }),
    ERecord(r) -> fold(r.fields, false, |acc: Bool, f: RecField| acc || mentions(f.value, names)),
    ERecordUpdate(r) -> mentions(r.base, names) || fold(r.fields, false, |acc: Bool, f: RecField| acc || mentions(f.value, names)),
    EField(f) -> mentions(f.base, names),
    ETry(t) -> mentions(t.operand, names),
    EList(l) -> fold(l.items, false, |acc: Bool, x: Expr| acc || mentions(x, names)),
    EPerform(p) -> fold(p.args, false, |acc: Bool, x: Expr| acc || mentions(x, names)),
    EHandle(h) -> mentions(h.body, names)
      || fold(h.clauses, false, |acc: Bool, c: HandleClause| acc || fold(c.params, false, |b: Bool, p: Ident| b || contains_bytes(names, p.name)) || mentions(c.body, names))
      || (match h.ret { Some(rc) -> contains_bytes(names, rc.binder.name) || mentions(rc.body, names), None -> false }),
    EWithCell(c) -> contains_bytes(names, c.binder.name) || mentions(c.init, names) || mentions(c.body, names),
    EWithRegion(w) -> mentions(w.body, names),
    ESimulate(s) -> mentions(s.body, names),
  }

fn pattern_mentions(p: Pattern, names: List<Bytes>) -> Bool =
  match p {
    PWild(_) -> false,
    PLit(_) -> false,
    PBad(_) -> false,
    PVar(v) -> contains_bytes(names, v.name.name),
    PCtor(c) -> (is_bare(c.name) && contains_bytes(names, c.name.name.name)) || fold(c.args, false, |acc: Bool, a: Pattern| acc || pattern_mentions(a, names)),
    PRecord(r) -> fold(r.fields, false, |acc: Bool, f: { name: Ident, pat: Pattern }| acc || pattern_mentions(f.pat, names)),
    PList(l) -> fold(l.items, false, |acc: Bool, i: Pattern| acc || pattern_mentions(i, names)) || (match l.rest { Some(rest) -> pattern_mentions(rest, names), None -> false }),
  }

// --- The hash table ----------------------------------------------------------------------

fn spec_domain() -> Bytes = b"ply.spec.1"
fn spec_text_domain() -> Bytes = b"ply.spec.text.1"
fn own_domain() -> Bytes = b"ply.own.1"

fn spec_text_hash(kind: Int, index: Int, normalized: Bytes) -> Bytes =
  blake3(bytes_concat_all([spec_text_domain(), byte_of(kind), u32_le(index), normalized]))

fn own_hash(normalized: Bytes) -> Bytes = blake3(bytes_concat(own_domain(), normalized))

pub fn spec_hash(owner: Bytes, kind: Int, index: Int, normalized: Bytes) -> Bytes =
  blake3(bytes_concat_all([spec_domain(), owner, byte_of(kind), u32_le(index), normalized]))

fn member_hash(component: Bytes, class: Int) -> Bytes = blake3(bytes_concat(component, u32_le(class)))

// `bodies` and `test_bodies`: each definition's and test's stored body, the bytes its hash is taken over.
pub type HashOutput = { defs: List<{ name: Bytes, hash: Bytes }>, own: List<{ name: Bytes, hash: Bytes }>, decls: List<{ name: Bytes, hash: Bytes }>,
                        tests: List<Bytes>, laws: List<Bytes>, specs: List<{ name: Bytes, hashes: List<Bytes> }>, spec_texts: List<{ name: Bytes, hashes: List<Bytes> }>,
                        law_texts: List<Bytes>, deps: List<{ name: Bytes, names: List<Bytes> }>, closure: List<{ name: Bytes, names: Names }>,
                        bodies: List<{ name: Bytes, body: Bytes }>, test_bodies: List<Bytes> }

// `deps` and `closure` are lists the dump writes in order; the maps index them, or recording is quadratic.
// They live here rather than in `HashOutput` because that type crosses into Rust.
type Recording = { out: HashOutput, deps_at: Map<Bytes, Int>, closure_at: Map<Bytes, Int> }

// A kind byte, then the normalized bytes `blake3` keys the body by.
fn solo_body(encoding: Bytes) -> Bytes = bytes_concat(b"\x00", encoding)

// The kind byte, the member's class, then the whole component's packed bytes, so any member rebuilds the cycle.
fn member_body(packed: Bytes, class: Int) -> Bytes = bytes_concat_all([b"\x01", u32_le(class), packed])

type Sccs = { component_of: List<Int>, orders: List<List<Int>> }

// The effects one component can see, in an order derived only from what it references.
fn effect_order(index: Index, refs: List<Int>, scc: Sccs, own: Option<Int>, out: List<Int>) -> List<Int> =
  fold(refs, out, |acc: List<Int>, r: Int| {
    let with_effect = if is_effect(index, r) { push_unique(acc, r) } else { acc };
    let ci = if r < len(scc.component_of) { at(scc.component_of, r) } else { 0 - 1 };
    if (match own { Some(o) -> o == ci, None -> false }) || ci < 0 || ci >= len(scc.orders) { with_effect }
    else { fold(at(scc.orders, ci), with_effect, |a: List<Int>, node: Int| push_unique(a, node)) }
  })

fn push_unique(xs: List<Int>, v: Int) -> List<Int> = if contains_int(xs, v) { xs } else { push(xs, v) }

fn slots(order: List<Int>) -> Map<Int, Int> = fold(range(0, len(order)), map_new(), |acc: Map<Int, Int>, i: Int| map_insert(acc, at(order, i), i))

// Two passes: the first yields the references that fix the effect enumeration, the second writes the bytes.
fn encode_item(index: Index, module: Int, scc: Sccs, hashes: Map<Int, Bytes>, by_name: Bool, encode: (Nz) -> Nz) -> Finished = {
  let first: Finished = finish(encode(new_nz(index, module, map_new(), map_new(), map_new())));
  let effects = slots(effect_order(index, first.refs, scc, None, []));
  let z: Nz = new_nz(index, module, hashes, map_new(), effects);
  finish(encode({..z, by_name: by_name}))
}

fn sketch_lt(a: Bytes, ia: Int, b: Bytes, ib: Int) -> Bool = bytes_lt(a, b) || (a == b && ia < ib)

type Refined = { members: List<{ node: Int, hash: Bytes }>, packed: Bytes, classes: Map<Int, Int> }

// A cyclic component hashes as a unit; members are labelled by class refinement to a fixpoint, plus one settling round.
fn hash_component(index: Index, component: List<Int>, hashes: Map<Int, Bytes>, effects: Map<Int, Int>) -> Refined = {
  let encode = |classes: Map<Int, Int>, v: Int| finish(normalize_node(new_nz(index, at(index.nodes, v).module, hashes, classes, effects), at(index.nodes, v).body)).bytes;
  let relabel = |encodings: List<Bytes>| {
    let distinct = dedup_sorted(sort_bytes(encodings));
    fold(range(0, len(component)), map_new(), |acc: Map<Int, Int>, i: Int| map_insert(acc, at(component, i), position_bytes(distinct, at(encodings, i))))
  };
  let grouping = |classes: Map<Int, Int>| sort_groups(fold(component, map_new(), |acc: Map<Int, List<Int>>, v: Int| {
    let c = match map_get(classes, v) { Some(x) -> x, None -> 0 };
    map_insert(acc, c, push(match map_get(acc, c) { Some(g) -> g, None -> [] }, v))
  }));
  let start = fold(component, map_new(), |acc: Map<Int, Int>, v: Int| map_insert(acc, v, 0));
  let settled = iterate({ classes: start, encodings: map(component, |v: Int| encode(start, v)) }, len(component) + 2, |s: { classes: Map<Int, Int>, encodings: List<Bytes> }| {
    let next = relabel(s.encodings);
    let same = grouping(next) == grouping(s.classes);
    let re = { classes: next, encodings: map(component, |v: Int| encode(next, v)) };
    if same { Stop(re) } else { Continue(re) }
  });
  let width = fold(component, 0, |acc: Int, v: Int| max(acc, match map_get(settled.classes, v) { Some(c) -> c, None -> 0 })) + 1;
  let by_class = fold(range(0, len(component)), map(range(0, width), |i: Int| b""), |acc: List<Bytes>, i: Int|
    set_at(acc, match map_get(settled.classes, at(component, i)) { Some(c) -> c, None -> 0 }, at(settled.encodings, i)));
  let packed = bytes_concat(u32_le(len(by_class)), bytes_concat_all(map(by_class, |m: Bytes| bytes_concat(u32_le(bytes_len(m)), m))));
  let component_hash = blake3(packed);
  { members: map(component, |v: Int| { node: v, hash: member_hash(component_hash, match map_get(settled.classes, v) { Some(c) -> c, None -> 0 }) }),
    packed: packed, classes: settled.classes }
}

fn dedup_sorted(xs: List<Bytes>) -> List<Bytes> =
  fold(xs, [], |acc: List<Bytes>, x: Bytes| if len(acc) > 0 && at(acc, len(acc) - 1) == x { acc } else { push(acc, x) })

fn position_bytes(xs: List<Bytes>, v: Bytes) -> Int =
  fold(range(0, len(xs)), 0, |acc: Int, i: Int| if at(xs, i) == v { i } else { acc })

// Groups by class, each sorted, the groups sorted: the shape two labellings are compared by.
fn sort_groups(groups: Map<Int, List<Int>>) -> List<List<Int>> = {
  let out = map_fold(groups, [], |acc: List<List<Int>>, k: Int, g: List<Int>| push(acc, sort_ints(g)));
  fold(out, [], |acc: List<List<Int>>, g: List<Int>| {
    let n = len(acc);
    let i = fold(range(0, n), n, |p: Int, j: Int| if p < n { p } else if ints_lt(g, at(acc, j)) { j } else { p });
    append(push(take(acc, i), g), map(range(i, n), |j: Int| at(acc, j)))
  })
}

fn sort_ints(xs: List<Int>) -> List<Int> =
  fold(xs, [], |acc: List<Int>, x: Int| {
    let n = len(acc);
    let i = fold(range(0, n), n, |p: Int, j: Int| if p < n { p } else if x < at(acc, j) { j } else { p });
    append(push(take(acc, i), x), map(range(i, n), |j: Int| at(acc, j)))
  })

fn ints_lt(a: List<Int>, b: List<Int>) -> Bool = match compare_values(a, b) { Less -> true, _ -> false }

type Forms = { own: List<{ name: Bytes, hash: Bytes }>, specs: List<{ name: Bytes, hashes: List<Bytes> }>, spec_texts: List<{ name: Bytes, hashes: List<Bytes> }> }

type Hashed = { hashes: Map<Int, Bytes>, bodies: Map<Int, Bytes>, tests: List<Bytes>, test_bodies: List<Bytes>, test_refs: List<List<Int>>,
                laws: List<Bytes>, law_refs: List<List<Int>>, law_texts: List<Bytes>,
                own: List<{ name: Bytes, hash: Bytes }>, specs: List<{ name: Bytes, hashes: List<Bytes> }>, spec_texts: List<{ name: Bytes, hashes: List<Bytes> }> }

// `hashes` is the table references are written from; `fresh` is what each body hashed to under it.
type Keyed = { hashes: Map<Int, Bytes>, bodies: Map<Int, Bytes>, fresh: Map<Int, Bytes> }

type Graph = { edges: List<List<Int>>, components: List<List<Int>>, scc: Sccs }

fn graph_of(index: Index) -> Graph = {
  let n = len(index.nodes);
  // A first pass with nothing known yields the reference graph, and a sketch that orders a cycle's members without source position.
  let first = map(index.nodes, |node: Node| finish(normalize_node(new_nz(index, node.module, map_new(), map_new(), map_new()), node.body)));
  let edges = map(first, |f: Finished| f.refs);
  let sketches = map(first, |f: Finished| f.bytes);
  let components = tarjan(n, edges);
  let component_of = fold(range(0, len(components)), map(range(0, n), |i: Int| 0 - 1), |acc: List<Int>, ci: Int|
    fold(at(components, ci), acc, |a: List<Int>, v: Int| set_at(a, v, ci)));
  // Components arrive dependency-first, so each can splice in the enumerations it references.
  let orders = fold(range(0, len(components)), [], |acc: List<List<Int>>, ci: Int| {
    let members = fold(at(components, ci), [], |ms: List<Int>, v: Int| {
      let k = len(ms);
      let i = fold(range(0, k), k, |p: Int, j: Int| if p < k { p } else if sketch_lt(at(sketches, v), v, at(sketches, at(ms, j)), at(ms, j)) { j } else { p });
      append(push(take(ms, i), v), map(range(i, k), |j: Int| at(ms, j)))
    });
    let scc = { component_of: component_of, orders: acc };
    push(acc, fold(members, [], |o: List<Int>, v: Int| effect_order(index, at(edges, v), scc, Some(ci), o)))
  });
  { edges: edges, components: components, scc: { component_of: component_of, orders: orders } }
}

fn key_components(index: Index, g: Graph, pinned: Map<Int, Bytes>) -> Keyed =
  fold(range(0, len(g.components)), { hashes: map_new(), bodies: map_new(), fresh: map_new() }, |acc: Keyed, ci: Int| {
    let component = at(g.components, ci);
    let effects = slots(at(g.scc.orders, ci));
    let own: Keyed = if is_cyclic(component, g.edges) {
      let refined: Refined = hash_component(index, component, acc.hashes, effects);
      fold(refined.members, acc, |a: Keyed, m: { node: Int, hash: Bytes }| {
        let class = match map_get(refined.classes, m.node) { Some(c) -> c, None -> 0 };
        {..a, fresh: map_insert(a.fresh, m.node, m.hash), bodies: map_insert(a.bodies, m.node, member_body(refined.packed, class))}
      })
    } else {
      let v = at(component, 0);
      let node = at(index.nodes, v);
      let encoding = finish(normalize_node(new_nz(index, node.module, acc.hashes, map_new(), effects), node.body)).bytes;
      {..acc, fresh: map_insert(acc.fresh, v, blake3(encoding)), bodies: map_insert(acc.bodies, v, solo_body(encoding))}
    };
    {..own, hashes: fold(component, own.hashes, |h: Map<Int, Bytes>, v: Int|
      match map_get(pinned, v) { Some(x) -> map_insert(h, v, x), None -> match map_get(own.fresh, v) { Some(x) -> map_insert(h, v, x), None -> h } })}
  })

pub fn hash_index(index: Index) -> HashOutput = {
  let g = graph_of(index);
  let components = g.components;
  let edges = g.edges;
  let scc = g.scc;
  let keyed = key_components(index, g, map_new());
  let hashes = keyed.hashes;
  let tests = fold(index.tests, { hashes: [], bodies: [], refs: [] }, |acc: { hashes: List<Bytes>, bodies: List<Bytes>, refs: List<List<Int>> }, t: TestNode| {
    let f: Finished = encode_item(index, t.module, scc, hashes, false, |z: Nz| test_def(z, t.def));
    { hashes: push(acc.hashes, blake3(f.bytes)), bodies: push(acc.bodies, solo_body(f.bytes)), refs: push(acc.refs, f.refs) }
  });
  let laws = fold(index.laws, { hashes: [], refs: [], texts: [] }, |acc: { hashes: List<Bytes>, refs: List<List<Int>>, texts: List<Bytes> }, l: LawNode| {
    let f: Finished = encode_item(index, l.module, scc, hashes, false, |z: Nz| law_def(z, l.def));
    let text: Finished = encode_item(index, l.module, scc, hashes, true, |z: Nz| law_def(z, l.def));
    { hashes: push(acc.hashes, blake3(f.bytes)), refs: push(acc.refs, f.refs), texts: push(acc.texts, spec_text_hash(0, 0, text.bytes)) }
  });
  let forms = fold(index.order, { own: [], specs: [], spec_texts: [] }, |acc: Forms, e: Entry|
    match e {
      EDef(v) -> {
        let node = at(index.nodes, v);
        match node.body {
          NFn(def) -> {
            let form: Finished = encode_item(index, node.module, scc, hashes, true, |z: Nz| normalize_node(z, NFn(def)));
            let owned: Forms = {..acc, own: push(acc.own, { name: node.name, hash: own_hash(form.bytes) })};
            if len(def.spec) == 0 { owned } else {
              match map_get(hashes, v) {
                None -> owned,
                Some(owner) -> {
                  let clauses = map(range(0, len(def.spec)), |i: Int| {
                    let c = at(def.spec, i);
                    spec_hash(owner, spec_tag(c.kind), i, encode_item(index, node.module, scc, hashes, false, |z: Nz| spec_clause(z, def, c)).bytes)
                  });
                  let texts = map(range(0, len(def.spec)), |i: Int| {
                    let c = at(def.spec, i);
                    spec_text_hash(spec_tag(c.kind), i, encode_item(index, node.module, scc, hashes, true, |z: Nz| spec_clause(z, def, c)).bytes)
                  });
                  {..owned, specs: push(owned.specs, { name: node.name, hashes: clauses }), spec_texts: push(owned.spec_texts, { name: node.name, hashes: texts })}
                },
              }
            }
          },
          _ -> acc,
        }
      },
      _ -> acc,
    });
  assemble(index, components, edges, { hashes: hashes, bodies: keyed.bodies, tests: tests.hashes, test_bodies: tests.bodies, test_refs: tests.refs,
                                        laws: laws.hashes, law_refs: laws.refs, law_texts: laws.texts,
                                        own: forms.own, specs: forms.specs, spec_texts: forms.spec_texts })
}

// Each body hashed with references as `pins` wrote them: an inherited move comes back to its pin, an edit does not.

pub type Pin = { name: Bytes, decl: Bool, hash: Bytes }
pub type Rehash = { name: Bytes, decl: Bool, fresh: Bytes, table: Bytes, component: Int }
pub type Rehashed = { nodes: List<Rehash>, tests: List<{ key: Bytes, hash: Bytes }> }

fn is_decl(node: Node) -> Bool = match node.body { NFn(_) -> false, _ -> true }

fn pin_key(name: Bytes, decl: Bool) -> Bytes = bytes_concat(if decl { b"decl " } else { b"def " }, name)

pub fn rehash_index(index: Index, pins: List<Pin>) -> Rehashed = {
  let wanted = fold(pins, map_new(), |acc: Map<Bytes, Bytes>, p: Pin| map_insert(acc, pin_key(p.name, p.decl), p.hash));
  let pinned = fold(range(0, len(index.nodes)), map_new(), |acc: Map<Int, Bytes>, v: Int| {
    let node = at(index.nodes, v);
    match map_get(wanted, pin_key(node.name, is_decl(node))) { Some(h) -> map_insert(acc, v, h), None -> acc }
  });
  let g = graph_of(index);
  let keyed = key_components(index, g, pinned);
  let grouped = fold(range(0, len(g.components)), map_new(), |acc: Map<Int, Int>, ci: Int| {
    let c = at(g.components, ci);
    if len(c) < 2 { acc } else { fold(c, acc, |a: Map<Int, Int>, v: Int| map_insert(a, v, ci)) }
  });
  let got = |m: Map<Int, Bytes>, v: Int| match map_get(m, v) { Some(h) -> h, None -> b"" };
  { nodes: map(range(0, len(index.nodes)), |v: Int| {
      let node = at(index.nodes, v);
      { name: node.name, decl: is_decl(node), fresh: got(keyed.fresh, v), table: got(keyed.hashes, v),
        component: match map_get(grouped, v) { Some(ci) -> ci, None -> 0 - 1 } }
    }),
    tests: map(index.tests, |t: TestNode| { key: t.key, hash: blake3(encode_item(index, t.module, g.scc, keyed.hashes, false, |z: Nz| test_def(z, t.def)).bytes) }) }
}

// Keys come back in byte order.
type Names = Map<Bytes, Bool>

fn names_union(a: Names, b: Names) -> Names = map_fold(b, a, |acc: Names, k: Bytes, v: Bool| map_insert(acc, k, true))

fn names_of(ns: Names) -> List<Bytes> = map_fold(ns, [], |acc: List<Bytes>, k: Bytes, v: Bool| push(acc, k))

fn assemble(index: Index, components: List<List<Int>>, edges: List<List<Int>>, h: Hashed) -> HashOutput = {
  let n = len(index.nodes);
  let component_of = fold(range(0, len(components)), map(range(0, n), |i: Int| 0 - 1), |acc: List<Int>, ci: Int|
    fold(at(components, ci), acc, |a: List<Int>, v: Int| set_at(a, v, ci)));
  // Dependency-first, so every closure a component needs is built by the time it is reached.
  let closures = fold(range(0, len(components)), [], |acc: List<Names>, ci: Int| {
    let component = at(components, ci);
    let own = fold(component, map_new(), |c: Names, v: Int| map_insert(c, at(index.nodes, v).name, true));
    let reached = fold(component, own, |c: Names, v: Int| fold(at(edges, v), c, |cc: Names, r: Int| {
      let rc = at(component_of, r);
      if rc != ci && rc >= 0 && rc < len(acc) { names_union(cc, at(acc, rc)) } else { cc }
    }));
    push(acc, reached)
  });
  let empty: HashOutput = { defs: [], own: h.own, decls: [], tests: h.tests, laws: h.laws, specs: h.specs, spec_texts: h.spec_texts, law_texts: h.law_texts, deps: [], closure: [],
                            bodies: [], test_bodies: h.test_bodies };
  (fold(index.order, { out: empty, deps_at: map_new(), closure_at: map_new() }, |acc: Recording, e: Entry|
    match e {
      EDef(v) -> {
        let node = at(index.nodes, v);
        let bodied: HashOutput = match map_get(h.bodies, v) {
          None -> acc.out,
          Some(body) -> {..acc.out, bodies: push(acc.out.bodies, { name: node.name, body: body })},
        };
        let keyed: HashOutput = match map_get(h.hashes, v) {
          None -> bodied,
          Some(hash) -> match node.body {
            NFn(_) -> {..bodied, defs: push(bodied.defs, { name: node.name, hash: hash })},
            _ -> {..bodied, decls: push(bodied.decls, { name: node.name, hash: hash })},
          },
        };
        let deps = map(at(edges, v), |r: Int| at(index.nodes, r).name);
        let closure = { let ci = at(component_of, v); if ci >= 0 && ci < len(closures) { at(closures, ci) } else { map_new() } };
        record({..acc, out: keyed}, node.name, deps, closure)
      },
      ETest(t) -> {
        let key = at(index.tests, t).key;
        let r = reached(at(h.test_refs, t), index, component_of, closures, key);
        record(acc, key, r.deps, r.closure)
      },
      // A law's references are what it is a claim about.
      ELaw(l) -> {
        let key = at(index.laws, l).key;
        let r = reached(at(h.law_refs, l), index, component_of, closures, key);
        record(acc, key, r.deps, r.closure)
      },
    })).out
}

fn reached(refs: List<Int>, index: Index, component_of: List<Int>, closures: List<Names>, own: Bytes) -> { deps: List<Bytes>, closure: Names } = {
  let deps = map(refs, |r: Int| at(index.nodes, r).name);
  let closure = fold(refs, map_insert(map_new(), own, true), |acc: Names, r: Int| { let ci = at(component_of, r); if ci >= 0 && ci < len(closures) { names_union(acc, at(closures, ci)) } else { acc } });
  { deps: deps, closure: closure }
}

// Names collide across namespaces, so entries are merged rather than replaced.
fn record(a: Recording, name: Bytes, deps: List<Bytes>, closure: Names) -> Recording = {
  let out: HashOutput = a.out;
  let deps_ = match map_get(a.deps_at, name) {
    Some(i) -> { let existing = at(out.deps, i);
                 { xs: set_at(out.deps, i, { name: name, names: fold(deps, existing.names, |acc: List<Bytes>, d: Bytes| if contains_bytes(acc, d) { acc } else { push(acc, d) }) }), at: a.deps_at } },
    None -> { xs: push(out.deps, { name: name, names: deps }), at: map_insert(a.deps_at, name, len(out.deps)) },
  };
  let closure_ = match map_get(a.closure_at, name) {
    Some(i) -> { let existing = at(out.closure, i);
                 { xs: set_at(out.closure, i, { name: name, names: names_union(existing.names, closure) }), at: a.closure_at } },
    None -> { xs: push(out.closure, { name: name, names: closure }), at: map_insert(a.closure_at, name, len(out.closure)) },
  };
  { out: {..out, deps: deps_.xs, closure: closure_.xs}, deps_at: deps_.at, closure_at: closure_.at }
}

// --- What nothing reaches -------------------------------------------------------------------------------
// The roots: a `pub` item, `main`, a derived definition, a name led by `_`, and what a test or a law mentions.
// A spec clause is reached with its owner.

type Reach = { seen: List<Bool>, frontier: List<Int> }

pub fn unused(index: Index) -> List<Diag> = {
  let n = len(index.nodes);
  let edges = map(index.nodes, |node: Node| node_edges(index, node));
  let own = filter(range(0, n), |v: Int| is_root(index, at(index.nodes, v)));
  let tested = fold(index.tests, own, |acc: List<Int>, t: TestNode|
    append(append(acc, refs_of(index, t.module, |z: Nz| test_def(z, t.def))), ret_refs(index, t.module, [t.def.body])));
  let roots = fold(index.laws, tested, |acc: List<Int>, l: LawNode| {
    let exprs = match l.def.guard { Some(g) -> [g, l.def.body], None -> [l.def.body] };
    append(append(acc, refs_of(index, l.module, |z: Nz| law_def(z, l.def))), ret_refs(index, l.module, exprs))
  });
  let start = fold(roots, { seen: map(range(0, n), |i: Int| false), frontier: [] }, reach);
  let seen = iterate(start, n + 2, |r: Reach|
    if len(r.frontier) == 0 { Stop(r.seen) }
    else { Continue(fold(r.frontier, { seen: r.seen, frontier: [] }, |acc: Reach, v: Int| fold(at(edges, v), acc, reach))) });
  fold(range(0, n), [], |acc: List<Diag>, v: Int| if at(seen, v) { acc } else { push(acc, never_used(at(index.nodes, v))) })
}

fn reach(r: Reach, v: Int) -> Reach =
  if at(r.seen, v) { r } else { { seen: set_at(r.seen, v, true), frontier: push(r.frontier, v) } }

fn refs_of(index: Index, module: Int, encode: (Nz) -> Nz) -> List<Int> =
  finish(encode(new_nz(index, module, map_new(), map_new(), map_new()))).refs

fn node_edges(index: Index, node: Node) -> List<Int> = {
  let own = refs_of(index, node.module, |z: Nz| normalize_node(z, node.body));
  match node.body {
    NFn(d) -> {
      let clauses = fold(d.spec, own, |acc: List<Int>, c: SpecClause| append(acc, refs_of(index, node.module, |z: Nz| spec_clause(z, d, c))));
      let defaults = fold(d.params, [], |acc: List<Expr>, p: Param| match p.default { Some(x) -> push(acc, x), None -> acc });
      append(clauses, ret_refs(index, node.module, push(append(defaults, map(d.spec, |c: SpecClause| c.expr)), d.body)))
    },
    _ -> own,
  }
}

// The encoding leaves a lambda's written return type out, and a type named only there is still used.
fn ret_refs(index: Index, module: Int, exprs: List<Expr>) -> List<Int> =
  refs_of(index, module, |z: Nz| fold(fold(exprs, [], |acc: List<TypeExpr>, e: Expr| lambda_rets(e, acc)), z, |acc: Nz, t: TypeExpr| type_expr(acc, t)))

fn lambda_rets(e: Expr, out: List<TypeExpr>) -> List<TypeExpr> =
  match e {
    ELambda(l) -> lambda_rets(l.body, match l.ret { Some(t) -> push(out, t), None -> out }),
    ELit(_) -> out,
    EVar(_) -> out,
    EBad(_) -> out,
    EBinary(b) -> lambda_rets(b.rhs, lambda_rets(b.lhs, out)),
    EUnary(u) -> lambda_rets(u.operand, out),
    EApp(a) -> fold(a.args, lambda_rets(a.func, out), |acc: List<TypeExpr>, x: Expr| lambda_rets(x, acc)),
    EIf(i) -> lambda_rets(i.else_branch, lambda_rets(i.then_branch, lambda_rets(i.cond, out))),
    EMatch(m) -> fold(m.arms, lambda_rets(m.scrutinee, out), |acc: List<TypeExpr>, arm: MatchArm|
      lambda_rets(arm.body, match arm.guard { Some(g) -> lambda_rets(g, acc), None -> acc })),
    EBlock(b) -> {
      let walked = fold(b.stmts, out, |acc: List<TypeExpr>, s: Stmt| match s { SLet(x) -> lambda_rets(x.value, acc), SExpr(x) -> lambda_rets(x, acc) });
      match b.tail { Some(t) -> lambda_rets(t, walked), None -> walked }
    },
    ERecord(r) -> fold(r.fields, out, |acc: List<TypeExpr>, f: RecField| lambda_rets(f.value, acc)),
    ERecordUpdate(r) -> fold(r.fields, lambda_rets(r.base, out), |acc: List<TypeExpr>, f: RecField| lambda_rets(f.value, acc)),
    ETry(t) -> lambda_rets(t.operand, out),
    EField(f) -> lambda_rets(f.base, out),
    EList(l) -> fold(l.items, out, |acc: List<TypeExpr>, x: Expr| lambda_rets(x, acc)),
    EPerform(p) -> fold(p.args, out, |acc: List<TypeExpr>, x: Expr| lambda_rets(x, acc)),
    EHandle(h) -> {
      let clauses = fold(h.clauses, lambda_rets(h.body, out), |acc: List<TypeExpr>, c: HandleClause| lambda_rets(c.body, acc));
      match h.ret { Some(rc) -> lambda_rets(rc.body, clauses), None -> clauses }
    },
    EWithCell(c) -> lambda_rets(c.body, lambda_rets(c.init, out)),
    EWithRegion(w) -> lambda_rets(w.body, out),
    ESimulate(s) -> lambda_rets(s.body, out),
  }

fn is_pub(v: Vis) -> Bool = match v { VPub -> true, VPriv -> false }

fn is_root(index: Index, node: Node) -> Bool =
  bytes_starts_with(node.simple, b"_") || (match node.body {
    NFn(d) -> is_pub(d.vis) || node.simple == b"main"
      || fold(at(index.mods, node.module).derived, false, |b: Bool, x: Derived| b || x.span == d.span),
    NType(d) -> is_pub(d.vis),
    NEffect(d) -> is_pub(d.vis),
  })

fn never_used(node: Node) -> Diag = {
  let named: { kind: Bytes, span: Span } = match node.body {
    NFn(d) -> { kind: b"fn", span: d.name.span },
    NType(d) -> { kind: b"type", span: d.name.span },
    NEffect(d) -> { kind: b"effect", span: d.name.span },
  };
  { code: b"W0611", notes: 0, labels: [lab(node.module, named.span, true, b"never used")], text: b"",
    message: bytes_concat_all([named.kind, b" `", node.name, b"` is never used"]), notes_text: [], severity: b"warning" }
}

// --- The dump -------------------------------------------------------------------------------------------

fn hexes(hs: List<Bytes>) -> Bytes =
  fold(range(0, len(hs)), b"", |acc: Bytes, i: Int| if i == 0 { hex(at(hs, i)) } else { bytes_concat_all([acc, b",", hex(at(hs, i))]) })

fn names_text(ns: List<Bytes>) -> Bytes =
  fold(range(0, len(ns)), b"", |acc: Bytes, i: Int| if i == 0 { at(ns, i) } else { bytes_concat_all([acc, b",", at(ns, i)]) })

fn dump_hashes(out: HashOutput) -> Bytes =
  bytes_concat_all([
    bytes_concat_all(map(out.defs, |d: { name: Bytes, hash: Bytes }| bytes_concat_all([b"H;", d.name, b";", hex(d.hash), b";"]))),
    bytes_concat_all(map(out.decls, |d: { name: Bytes, hash: Bytes }| bytes_concat_all([b"Y;", d.name, b";", hex(d.hash), b";"]))),
    bytes_concat_all(map(out.tests, |h: Bytes| bytes_concat_all([b"T;", hex(h), b";"]))),
    bytes_concat_all(map(out.laws, |h: Bytes| bytes_concat_all([b"L;", hex(h), b";"]))),
    bytes_concat_all(map(out.law_texts, |h: Bytes| bytes_concat_all([b"W;", hex(h), b";"]))),
    bytes_concat_all(map(out.own, |d: { name: Bytes, hash: Bytes }| bytes_concat_all([b"O;", d.name, b";", hex(d.hash), b";"]))),
    bytes_concat_all(map(out.specs, |s: { name: Bytes, hashes: List<Bytes> }| bytes_concat_all([b"S;", s.name, b";", hexes(s.hashes), b";"]))),
    bytes_concat_all(map(out.spec_texts, |s: { name: Bytes, hashes: List<Bytes> }| bytes_concat_all([b"X;", s.name, b";", hexes(s.hashes), b";"]))),
    bytes_concat_all(map(out.deps, |d: { name: Bytes, names: List<Bytes> }| bytes_concat_all([b"D;", d.name, b";", names_text(d.names), b";"]))),
    bytes_concat_all(map(out.closure, |d: { name: Bytes, names: Names }| bytes_concat_all([b"C;", d.name, b";", names_text(names_of(d.names)), b";"]))),
  ])

type Parsed = { name: Bytes, module: Module, derived: List<Derived>, diags: List<Diag> }

// The driver's order: parse with the rewrites, expand every `derive`, resolve, hash.
pub fn hash_dump(sources: List<Source>) -> String = {
  let parsed = map(range(0, len(sources)), |i: Int| {
    let s = at(sources, i);
    let r = parse(s.src);
    let x = expand(r.node, r.p.uses_sets, r.p.diags);
    let d: Expansion = expand_derives(i, x.module);
    { name: s.name, module: d.module, derived: d.derived, diags: d.diags }
  });
  let expansion = fold(parsed, [], |acc: List<Diag>, p: Parsed| append(acc, p.diags));
  let mods = map(parsed, |p: Parsed| { name: p.name, module: p.module, derived: p.derived });
  let head = bytes_concat_all([b"K;", num(len(sources)), b";"]);
  let body = if len(expansion) > 0 { bytes_concat(b"E;", dump_diags(expansion)) } else {
    match resolve_modules(mods) {
      Failed(ds) -> bytes_concat(b"E;", dump_diags(ds)),
      Resolved_(x) -> {
        let built = build_index(x.mods, x.r);
        if len(built.diags) > 0 { bytes_concat(b"E;", dump_diags(built.diags)) } else { dump_hashes(hash_index(built.index)) }
      },
    }
  };
  string_of_bytes(bytes_concat(head, body))
}

// --- Stored bodies back to source ------------------------------------------------------------

pub type Refusal = { message: Bytes, notes: List<Bytes> }
pub type Printing = | Printed(List<{ module: Bytes, text: Bytes }>) | Unprintable(Refusal)

type Part = { members: List<Bytes>, hashes: List<Bytes>, names: List<Bytes>, module: Bytes, binder: Bytes, printed: Bool }
type Slot = { part: Int, class: Int }
type Layout = { parts: List<Part>, by_hash: Map<Bytes, List<Slot>>, relink: Map<Bytes, Bytes> }
type Pr = { layout: Layout, part: Int, own: Bytes }
type Dc = { b: Bytes, pos: Int, values: Int, typs: Int, rows: Int, imports: Map<Bytes, Bytes>, missing: Map<Bytes, Bool>, slots: Map<Bytes, Int> }
type Got = { d: Dc, t: Bytes }
type Rd = { d: Dc, v: Int }
type Flag = { d: Dc, v: Bool }
type Opt = { d: Dc, t: Bytes, some: Bool }
type Many = { d: Dc, ts: List<Bytes> }
type Rf = { d: Dc, hash: Bytes, class: Int }

fn cursor(b: Bytes, missing: Map<Bytes, Bool>) -> Dc = { b: b, pos: 0, values: 0, typs: 0, rows: 0, imports: map_new(), missing: missing, slots: map_new() }

fn rd_bytes(d: Dc, n: Int) -> Got =
  if d.pos + n > bytes_len(d.b) { panic("a stored body ends inside a value") }
  else { { d: {..d, pos: d.pos + n}, t: bytes_slice(d.b, d.pos, d.pos + n) } }

fn le_int(b: Bytes) -> Int = fold(range(0, bytes_len(b)), 0, |a: Int, i: Int| a | (bytes_at(b, i) << (8 * i)))

fn rd_int(d: Dc, n: Int) -> Rd = { let g = rd_bytes(d, n); { d: g.d, v: le_int(g.t) } }

fn rd_u8(d: Dc) -> Rd = rd_int(d, 1)

fn rd_u32(d: Dc) -> Rd = rd_int(d, 4)

fn rd_text(d: Dc) -> Got = { let n = rd_u32(d); rd_bytes(n.d, n.v) }

fn rd_bool(d: Dc) -> Flag = { let r = rd_u8(d); if r.v > 1 { panic("a byte that is not a boolean") } else { { d: r.d, v: r.v == 1 } } }

fn peek(d: Dc) -> Int = if d.pos < bytes_len(d.b) { bytes_at(d.b, d.pos) } else { 0 - 1 }

fn skip(d: Dc) -> Dc = {..d, pos: d.pos + 1}

fn expect(d: Dc, want: Int, what: Bytes) -> Dc = {
  let r = rd_u8(d);
  if r.v == want { r.d } else { panic(string_of_bytes(bytes_concat_all([b"expected ", what, b", found tag ", num(r.v)]))) }
}

fn rd_count(d: Dc) -> Rd = { let r = rd_u32(d); if r.v > bytes_len(r.d.b) - r.d.pos { panic("a count runs past the stored body") } else { r } }

fn rd_binders(d: Dc) -> Rd = { let r = rd_u32(d); if r.v > 65535 { panic("a count of binders no definition declares") } else { r } }

fn rd_many(d: Dc, count: Int, f: (Dc) -> Got) -> Many =
  fold(range(0, count), { d: d, ts: [] }, |s: Many, i: Int| { let g = f(s.d); { d: g.d, ts: push(s.ts, g.t) } })

fn rd_opt(d: Dc, f: (Dc) -> Got) -> Opt = {
  let r = rd_u8(d);
  if r.v == t_none() { { d: r.d, t: b"", some: false } }
  else if r.v == t_some() { let g = f(r.d); { d: g.d, t: g.t, some: true } }
  else { panic("a byte that is not an optional marker") }
}

fn joined(xs: List<Bytes>, sep: Bytes) -> Bytes =
  bytes_concat_all(map(range(0, len(xs)), |i: Int| if i == 0 { at(xs, i) } else { bytes_concat(sep, at(xs, i)) }))

fn prefixed(o: Opt, before: Bytes) -> Bytes = if o.some { bytes_concat(before, o.t) } else { b"" }

fn bracketed(o: Opt) -> Bytes = if o.some { bytes_concat_all([b"[", o.t, b"]"]) } else { b"" }

fn lname(level: Int) -> Bytes = bytes_concat(b"_l", num(level))
fn tname(level: Int) -> Bytes = bytes_concat(b"_t", num(level))
fn ename(level: Int) -> Bytes = bytes_concat(b"_e", num(level))

fn nl(depth: Int) -> Bytes = bytes_concat(b"\n", bytes_concat_all(map(range(0, depth), |i: Int| b"  ")))

fn zeros(k: Int) -> Bytes = bytes_concat_all(map(range(0, k), |i: Int| b"0"))

fn short_hex(h: Bytes) -> Bytes = bytes_slice(hex(h), 0, 12)

fn rd_ref(x: Pr, d: Dc) -> Rf = {
  let t = rd_u8(d);
  if t.v == t_ref_hash() {
    let g: Got = rd_bytes(t.d, 32);
    let h = match map_get(x.layout.relink, g.t) { Some(to) -> to, None -> g.t };
    { d: if map_contains(x.layout.by_hash, h) { g.d } else { {..g.d, missing: map_insert(g.d.missing, h, true)} }, hash: h, class: 0 - 1 }
  } else if t.v == t_ref_index() {
    let c = rd_u32(t.d);
    let hashes = if x.part < 0 { [] } else { at(x.layout.parts, x.part).hashes };
    if c.v >= len(hashes) { panic("a reference to a member this component does not have") } else { { d: c.d, hash: at(hashes, c.v), class: c.v } }
  } else { panic(string_of_bytes(bytes_concat(b"a reference of tag ", num(t.v)))) }
}

fn pick(l: Layout, h: Bytes, own: Bytes) -> Option<Slot> = {
  let score = |s: Slot| { let p = at(l.parts, s.part); (if p.module == own { 0 } else { 2 }) + (if p.printed { 0 } else { 1 }) };
  match map_get(l.by_hash, h) {
    None -> None,
    Some(found) -> fold(found, None, |best: Option<Slot>, s: Slot| match best { Some(b) -> if score(s) < score(b) { Some(s) } else { best }, None -> Some(s) }),
  }
}

fn qname(x: Pr, r: Rf, ctor: Option<Bytes>) -> Got = {
  let found = if r.class >= 0 { Some({ part: x.part, class: r.class }) } else { pick(x.layout, r.hash, x.own) };
  match found {
    None -> { d: r.d, t: match ctor { Some(c) -> c, None -> short_hex(r.hash) } },
    Some(s) -> {
      let p = at(x.layout.parts, s.part);
      let name = match ctor { Some(c) -> c, None -> at(p.names, s.class) };
      if p.module == x.own { { d: r.d, t: name } }
      else { { d: {..r.d, imports: map_insert(r.d.imports, p.module, p.binder)}, t: bytes_concat_all([p.binder, b"::", name]) } }
    },
  }
}

fn is_free(d: Dc) -> Bool = peek(d) == t_free() || peek(d) == t_free_qualified()

fn rd_free(d: Dc) -> Got = {
  let t = rd_u8(d);
  if t.v == t_free() { rd_text(t.d) }
  else if t.v == t_free_qualified() { let m = rd_text(t.d); let n = rd_text(m.d); { d: n.d, t: bytes_concat_all([m.t, b"::", n.t]) } }
  else { panic("a tag that is not a free reference") }
}

fn rd_value(x: Pr, d: Dc) -> Got =
  if peek(d) == t_local() {
    let l = rd_u32(skip(d));
    if l.v >= d.values { panic("a local that is not in scope") } else { { d: l.d, t: lname(l.v) } }
  } else if peek(d) == t_ctor() { rd_ctor(x, d) }
  else if is_free(d) { rd_free(d) }
  else { qname(x, rd_ref(x, d), None) }

fn rd_ctor(x: Pr, d: Dc) -> Got =
  if peek(d) == t_ctor() {
    let owner: Rf = rd_ref(x, skip(d));
    let name = rd_text(owner.d);
    qname(x, {..owner, d: name.d}, Some(name.t))
  } else { rd_free(d) }

// Two effects declared alike share a hash, and only the slot tells them apart.
fn rd_effect(x: Pr, d: Dc) -> Got =
  if is_free(d) { rd_free(d) } else {
    let r: Rf = rd_ref(x, d);
    let s: Rd = rd_u32(r.d);
    match map_get(s.d.slots, r.hash) {
      Some(was) -> if was != s.v { panic("two distinct effects share one declaration, which a hash-keyed body cannot tell apart") } else { qname(x, {..r, d: s.d}, None) },
      None -> qname(x, {..r, d: {..s.d, slots: map_insert(s.d.slots, r.hash, s.v)}}, None),
    }
  }

fn p_type(x: Pr, d: Dc) -> Got = {
  let t = rd_u8(d);
  if t.v == t_ty_con() {
    if peek(t.d) == t_ty_param() {
      let l = rd_u32(skip(t.d));
      let n = rd_u32(l.d);
      if l.v >= d.typs || n.v != 0 { panic("a type parameter out of scope, or applied") } else { { d: n.d, t: tname(l.v) } }
    } else {
      let name = if is_free(t.d) { rd_free(t.d) } else { qname(x, rd_ref(x, t.d), None) };
      let n = rd_count(name.d);
      let args = rd_many(n.d, n.v, |e: Dc| p_type(x, e));
      // A bare lowercase name reads back as a type variable, so it keeps an empty `<>`.
      let bare = match bytes_index_of(name.t, b"::") { Some(_) -> false, None -> true };
      { d: args.d, t: if n.v > 0 || (bare && !is_ctor_name(name.t)) { bytes_concat_all([name.t, b"<", joined(args.ts, b", "), b">"]) } else { name.t } }
    }
  } else if t.v == t_ty_fn() {
    let n = rd_count(t.d);
    let ps = rd_many(n.d, n.v, |e: Dc| p_type(x, e));
    let ret = p_ret(x, ps.d);
    let row = rd_opt(ret.d, |e: Dc| p_row(x, e));
    { d: row.d, t: bytes_concat_all([b"(", joined(ps.ts, b", "), b") -> ", ret.t, prefixed(row, b" / ")]) }
  } else if t.v == t_ty_record() {
    let n = rd_count(t.d);
    let fs = rd_many(n.d, n.v, |e: Dc| { let f = rd_text(e); let ty = p_type(x, f.d); { d: ty.d, t: bytes_concat_all([f.t, b": ", ty.t]) } });
    { d: fs.d, t: bytes_concat_all([b"{", joined(fs.ts, b", "), b"}"]) }
  } else if t.v == t_ty_unit() { { d: t.d, t: b"()" } }
  else { panic("a tag that does not begin a type") }
}

// After `->` a function type is parenthesized, or a row after it would bind to the inner arrow.
fn p_ret(x: Pr, d: Dc) -> Got =
  if peek(d) == t_ty_fn() { let g = p_type(x, d); { d: g.d, t: bytes_concat_all([b"(", g.t, b")"]) } } else { p_type(x, d) }

fn rd_mode(d: Dc) -> Got = {
  let m = rd_u8(d);
  if m.v == 0 { { d: m.d, t: b"read" } } else if m.v == 1 { { d: m.d, t: b"write" } } else { panic("a byte that is not an access mode") }
}

fn p_row(x: Pr, d: Dc) -> Got = {
  let n = rd_count(expect(d, t_row(), b"an effect row"));
  let atoms = rd_many(n.d, n.v, |e: Dc| {
    let eff = rd_effect(x, expect(e, t_atom(), b"an effect atom"));
    let m = rd_mode(eff.d);
    let r = rd_opt(m.d, rd_text);
    { d: r.d, t: bytes_concat_all([eff.t, b".", m.t, bracketed(r)]) }
  });
  let tail = rd_opt(atoms.d, |e: Dc| {
    let k = rd_u8(e);
    if k.v == t_row_param() { let l = rd_u32(k.d); if l.v >= e.rows { panic("a row parameter that is not in scope") } else { { d: l.d, t: ename(l.v) } } }
    else if k.v == t_free() { rd_text(k.d) }
    else { panic("a tag that is not a row tail") }
  });
  { d: tail.d, t: if n.v == 0 && tail.some { tail.t } else { bytes_concat_all([b"{", joined(atoms.ts, b", "), prefixed(tail, b" | "), b"}"]) } }
}

fn escape(c: Int, raw: Bool) -> Bytes =
  if c == 34 { b"\\\"" } else if c == 92 { b"\\\\" } else if c == 10 { b"\\n" } else if c == 9 { b"\\t" } else if c == 13 { b"\\r" } else if c == 0 { b"\\0" }
  else if raw || (c >= 32 && c <= 126) { byte_of(c) } else { bytes_concat_all([b"\\x", hex_digit(c >>> 4), hex_digit(c & 15)]) }

fn str_lit(s: Bytes) -> Bytes = bytes_concat_all([b"\"", bytes_concat_all(map(range(0, bytes_len(s)), |i: Int| escape(bytes_at(s, i), true))), b"\""])

fn bytes_lit(s: Bytes) -> Bytes = bytes_concat_all([b"b\"", bytes_concat_all(map(range(0, bytes_len(s)), |i: Int| escape(bytes_at(s, i), false))), b"\""])

fn hex_int(v: Int, bits: Int) -> Bytes = {
  let n = bits / 4;
  let ds = map(range(0, n), |i: Int| (v >>> (4 * (n - 1 - i))) & 15);
  let lead = fold(range(0, n), n - 1, |acc: Int, j: Int| if at(ds, j) != 0 && j < acc { j } else { acc });
  bytes_concat(b"0x", bytes_concat_all(map(range(lead, n), |j: Int| hex_digit(at(ds, j)))))
}

// A negative literal is spelled as its bit pattern: `-5` would read back as a negation.
fn int_text(v: Int) -> Bytes = if v >= 0 { num(v) } else { hex_int(v, 64) }

fn fixed_text(which: Int, v: Int) -> Bytes =
  match list_at(widths(), which) {
    None -> panic("a byte that is not a fixed-width integer type"),
    Some(w) -> bytes_concat(if v >= 0 { num(v) } else { hex_int(if w.bits == 64 { v } else { v & ((1 << w.bits) - 1) }, w.bits) }, w.name),
  }

fn big_mul(n: List<Int>, f: Int, add: Int) -> List<Int> = {
  let r = fold(n, { limbs: [], carry: add }, |s: { limbs: List<Int>, carry: Int }, limb: Int| {
    let v = limb * f + s.carry;
    { limbs: push(s.limbs, v % 1000000000), carry: v / 1000000000 }
  });
  iterate(r, 4, |s: { limbs: List<Int>, carry: Int }|
    if s.carry == 0 { Stop(s) } else { Continue({ limbs: push(s.limbs, s.carry % 1000000000), carry: s.carry / 1000000000 }) }).limbs
}

fn pow_int(b: Int, k: Int) -> Int = fold(range(0, k), 1, |a: Int, i: Int| a * b)

fn big_pow(n: List<Int>, base: Int, e: Int) -> List<Int> = {
  let chunk = if base == 5 { 13 } else { 30 };
  big_mul(fold(range(0, e / chunk), n, |acc: List<Int>, i: Int| big_mul(acc, pow_int(base, chunk), 0)), pow_int(base, e % chunk), 0)
}

fn big_digits(n: List<Int>) -> Bytes = {
  let top = fold(range(0, len(n)), 0, |t: Int, i: Int| if at(n, i) != 0 { i } else { t });
  bytes_concat_all(map(range(0, top + 1), |j: Int| { let d = num(at(n, top - j)); if j == 0 { d } else { bytes_concat(zeros(9 - bytes_len(d)), d) } }))
}

fn decimal_text(m: Bytes, scale: Int) -> Bytes =
  if scale > 28 || fold(range(12, 16), false, |b: Bool, i: Int| b || bytes_at(m, i) != 0) { panic("a mantissa and scale that are not a `Decimal`") } else {
    let ds = big_digits(fold(range(0, 12), [0], |acc: List<Int>, i: Int| big_mul(acc, 256, bytes_at(m, 11 - i))));
    let padded = if bytes_len(ds) <= scale { bytes_concat(zeros(scale - bytes_len(ds) + 1), ds) } else { ds };
    let point = bytes_len(padded) - scale;
    bytes_concat(if scale == 0 { ds } else { bytes_concat_all([bytes_slice(padded, 0, point), b".", bytes_slice(padded, point, bytes_len(padded))]) }, b"m")
  }

type Rounded = { digits: Bytes, exp: Int, p: Int }

fn trim_zeros(s: Bytes) -> Bytes = bytes_slice(s, 0, fold(range(0, bytes_len(s)), 1, |acc: Int, i: Int| if bytes_at(s, i) != 48 { i + 1 } else { acc }))

fn sci(s: Bytes, x: Int) -> Bytes =
  bytes_concat_all([bytes_slice(s, 0, 1), if bytes_len(s) > 1 { bytes_concat(b".", bytes_slice(s, 1, bytes_len(s))) } else { b"" }, b"e", num(x)])

fn round_to(ds: Bytes, x0: Int, p: Int) -> Rounded = {
  let head = bytes_slice(ds, 0, p);
  if p >= bytes_len(ds) || bytes_at(ds, p) < 53 { { digits: trim_zeros(head), exp: x0, p: p } }
  else {
    let k = fold(range(0, p), 0 - 1, |acc: Int, i: Int| if bytes_at(head, i) != 57 { i } else { acc });
    if k < 0 { { digits: b"1", exp: x0 + 1, p: p } }
    else { { digits: bytes_concat(bytes_slice(head, 0, k), byte_of(bytes_at(head, k) + 1)), exp: x0, p: p } }
  }
}

fn reads_back(r: Rounded, mag: Int) -> Bool =
  match float_of_string(string_of_bytes(sci(r.digits, r.exp))) { Some(f) -> bits_of_float(f) == mag, None -> false }

fn shortest(ds: Bytes, x0: Int, mag: Int) -> Rounded =
  iterate({ digits: ds, exp: x0, p: 1 }, 19, |s: Rounded|
    if s.p > 17 || s.p > bytes_len(ds) { Stop({ digits: trim_zeros(ds), exp: x0, p: s.p }) }
    else { let r = round_to(ds, x0, s.p); if reads_back(r, mag) { Stop(r) } else { Continue({..s, p: s.p + 1}) } })

fn float_spelling(r: Rounded) -> Bytes = {
  let s = r.digits;
  let n = bytes_len(s);
  let positional = if r.exp >= n - 1 { bytes_concat(s, zeros(r.exp - n + 1)) }
    else if r.exp >= 0 { bytes_concat_all([bytes_slice(s, 0, r.exp + 1), b".", bytes_slice(s, r.exp + 1, n)]) }
    else { bytes_concat_all([b"0.", zeros(0 - r.exp - 1), s]) };
  let exponential = sci(s, r.exp);
  let text = if bytes_len(exponential) < bytes_len(positional) { exponential } else { positional };
  match bytes_index_of(text, b".") { Some(_) -> text, None -> match bytes_index_of(text, b"e") { Some(_) -> text, None -> bytes_concat(text, b".0") } }
}

fn float_text(bits: Int) -> Bytes = {
  let mag = bits & 0x7FFFFFFFFFFFFFFF;
  let sign = if bits < 0 { b"-" } else { b"" };
  let ex = mag >>> 52;
  let fr = mag & 0xFFFFFFFFFFFFF;
  if ex == 2047 && fr != 0 { panic("a NaN, which no literal spells") }
  else if ex == 2047 { bytes_concat(sign, b"1e400") }
  else if mag == 0 { bytes_concat(sign, b"0.0") }
  else {
    let m = if ex == 0 { fr } else { fr | 0x10000000000000 };
    let e2 = if ex == 0 { 0 - 1074 } else { ex - 1075 };
    let start = [m % 1000000000, m / 1000000000];
    let ds = big_digits(if e2 >= 0 { big_pow(start, 2, e2) } else { big_pow(start, 5, 0 - e2) });
    let x0 = bytes_len(ds) - 1 + (if e2 >= 0 { 0 } else { e2 });
    bytes_concat(sign, float_spelling(shortest(ds, x0, mag)))
  }
}

fn p_lit(d: Dc) -> Got = {
  let t = rd_u8(d);
  let e = t.d;
  if t.v == t_lit_int() { let v = rd_int(e, 8); { d: v.d, t: int_text(v.v) } }
  else if t.v == t_lit_bool() { let b = rd_bool(e); { d: b.d, t: if b.v { b"true" } else { b"false" } } }
  else if t.v == t_lit_str() { let s = rd_text(e); { d: s.d, t: str_lit(s.t) } }
  else if t.v == t_lit_bytes() { let s = rd_text(e); { d: s.d, t: bytes_lit(s.t) } }
  else if t.v == t_lit_float() { let v = rd_int(e, 8); { d: v.d, t: float_text(v.v) } }
  else if t.v == t_lit_decimal() { let m = rd_bytes(e, 16); let s = rd_u32(m.d); { d: s.d, t: decimal_text(m.t, s.v) } }
  else if t.v == t_lit_fixed() { let w = rd_u8(e); let v = rd_int(w.d, 8); { d: v.d, t: fixed_text(w.v, v.v) } }
  else if t.v == t_lit_unit() { { d: e, t: b"()" } }
  else { panic("a tag that is not a literal") }
}

fn p_pat(x: Pr, d: Dc) -> Got = {
  let t = rd_u8(d);
  let e: Dc = t.d;
  if t.v == t_p_wildcard() { { d: e, t: b"_" } }
  else if t.v == t_p_var() { { d: {..e, values: e.values + 1}, t: lname(e.values) } }
  else if t.v == t_p_lit() { p_lit(e) }
  else if t.v == t_p_ctor() {
    let name = rd_ctor(x, e);
    let n = rd_count(name.d);
    let args = rd_many(n.d, n.v, |g: Dc| p_pat(x, g));
    { d: args.d, t: if n.v == 0 { name.t } else { bytes_concat_all([name.t, b"(", joined(args.ts, b", "), b")"]) } }
  } else if t.v == t_p_record() {
    let n = rd_count(e);
    let fs = rd_many(n.d, n.v, |g: Dc| { let f = rd_text(g); let p = p_pat(x, f.d); { d: p.d, t: bytes_concat_all([f.t, b": ", p.t]) } });
    let rest = rd_bool(fs.d);
    { d: rest.d, t: bytes_concat_all([b"{", joined(fs.ts, b", "), if !rest.v { b"" } else if n.v > 0 { b", .." } else { b".." }, b"}"]) }
  } else if t.v == t_p_list() {
    let n = rd_count(e);
    let items = rd_many(n.d, n.v, |g: Dc| p_pat(x, g));
    let named = peek(skip(items.d)) == t_p_var();
    let rest = rd_opt(items.d, |g: Dc| p_pat(x, g));
    { d: rest.d, t: bytes_concat_all([b"[", joined(items.ts, b", "),
        if !rest.some { b"" } else { bytes_concat_all([if n.v > 0 { b", " } else { b"" }, b"..", if named { rest.t } else { b"" }]) }, b"]"]) }
  } else { panic("a tag that does not begin a pattern") }
}

fn parens(g: Got, bare: Bool) -> Got = if bare { g } else { { d: g.d, t: bytes_concat_all([b"(", g.t, b")"]) } }

fn is_atomic(d: Dc) -> Bool = {
  let t = peek(d);
  t == t_e_lit() || t == t_e_var() || t == t_e_app() || t == t_e_field() || t == t_e_list() || t == t_e_perform()
}

fn is_base(d: Dc) -> Bool = { let t = peek(d); t == t_e_var() || t == t_e_app() || t == t_e_field() || t == t_e_perform() }

fn p_operand(x: Pr, d: Dc, depth: Int) -> Got = parens(p_expr(x, d, depth), is_atomic(d))

fn p_block(x: Pr, d: Dc, depth: Int) -> Got =
  if peek(d) == t_e_block() { p_expr(x, d, depth) }
  else { let g = p_expr(x, d, depth + 1); { d: g.d, t: bytes_concat_all([b"{", nl(depth + 1), g.t, nl(depth), b"}"]) } }

fn binop_text(op: Int) -> Bytes =
  match list_at([b"+", b"-", b"*", b"/", b"%", b"==", b"!=", b"<", b"<=", b">", b">=", b"&&", b"||", b"++", b"&", b"|", b"^", b"<<", b">>", b">>>"], op - 1) {
    Some(t) -> t,
    None -> panic("a byte that is not a binary operator"),
  }

fn unop_text(op: Int) -> Bytes = if op == 1 { b"-" } else if op == 2 { b"!" } else if op == 3 { b"~" } else { panic("a byte that is not a unary operator") }

// `if c { t }` is the parser's own spelling of an `else ()`.
fn p_if(x: Pr, d: Dc, depth: Int) -> Got = {
  let c = p_operand(x, d, depth);
  let th = p_block(x, c.d, depth);
  let el: Dc = th.d;
  let tail: Got = if peek(el) == t_e_lit() && peek(skip(el)) == t_lit_unit() { { d: {..el, pos: el.pos + 2}, t: b"" } }
    else if peek(el) == t_e_if() { let g = p_expr(x, el, depth); { d: g.d, t: bytes_concat(b" else ", g.t) } }
    else { let g = p_block(x, el, depth); { d: g.d, t: bytes_concat(b" else ", g.t) } };
  { d: tail.d, t: bytes_concat_all([b"if ", c.t, b" ", th.t, tail.t]) }
}

fn p_expr(x: Pr, d: Dc, depth: Int) -> Got = {
  let t = rd_u8(d);
  let e = t.d;
  let inner = depth + 1;
  if t.v == t_e_lit() { p_lit(e) }
  else if t.v == t_e_var() { rd_value(x, e) }
  else if t.v == t_e_binary() {
    let op = rd_u8(e);
    let l = p_operand(x, op.d, depth);
    let r = p_operand(x, l.d, depth);
    { d: r.d, t: bytes_concat_all([l.t, b" ", binop_text(op.v), b" ", r.t]) }
  } else if t.v == t_e_unary() {
    let op = rd_u8(e);
    let o = p_operand(x, op.d, depth);
    { d: o.d, t: bytes_concat(unop_text(op.v), o.t) }
  } else if t.v == t_e_lambda() {
    let n = rd_count(e);
    let anns: Many = rd_many(n.d, n.v, |g: Dc| { let o = rd_opt(g, |h: Dc| p_type(x, h)); { d: o.d, t: prefixed(o, b": ") } });
    let base = anns.d.values;
    let body: Got = p_expr(x, {..anns.d, values: base + n.v}, depth);
    let ps = map(range(0, n.v), |i: Int| bytes_concat(lname(base + i), at(anns.ts, i)));
    { d: {..body.d, values: base}, t: bytes_concat_all([if n.v == 0 { b"||" } else { bytes_concat_all([b"|", joined(ps, b", "), b"|"]) }, b" ", body.t]) }
  } else if t.v == t_e_app() {
    // `r.f(x)` performs an effect, so a call through anything but a name is parenthesized.
    let f = parens(p_expr(x, e, depth), peek(e) == t_e_var());
    let n = rd_count(f.d);
    let args = rd_many(n.d, n.v, |g: Dc| p_expr(x, g, depth));
    { d: args.d, t: bytes_concat_all([f.t, b"(", joined(args.ts, b", "), b")"]) }
  } else if t.v == t_e_if() { p_if(x, e, depth) }
  else if t.v == t_e_match() {
    let s = p_operand(x, e, depth);
    let n = rd_count(s.d);
    let arms = rd_many(n.d, n.v, |g: Dc| {
      let p = p_pat(x, expect(g, t_arm(), b"a match arm"));
      let guard = rd_opt(p.d, |h: Dc| p_expr(x, h, inner));
      let body: Got = p_expr(x, guard.d, inner);
      { d: {..body.d, values: g.values}, t: bytes_concat_all([nl(inner), p.t, prefixed(guard, b" if "), b" -> ", body.t, b","]) }
    });
    { d: arms.d, t: bytes_concat_all([b"match ", s.t, b" {", bytes_concat_all(arms.ts), nl(depth), b"}"]) }
  } else if t.v == t_e_block() {
    let n = rd_count(e);
    let stmts = rd_many(n.d, n.v, |g: Dc| { let s = p_stmt(x, g, inner); { d: s.d, t: bytes_concat(nl(inner), s.t) } });
    let tail: Opt = rd_opt(stmts.d, |g: Dc| p_expr(x, g, inner));
    { d: {..tail.d, values: e.values}, t: bytes_concat_all([b"{", bytes_concat_all(stmts.ts), prefixed(tail, nl(inner)), nl(depth), b"}"]) }
  } else if t.v == t_e_record() {
    let n = rd_count(e);
    let fs = rd_many(n.d, n.v, |g: Dc| { let f = rd_text(g); let v = p_expr(x, f.d, depth); { d: v.d, t: bytes_concat_all([f.t, b": ", v.t]) } });
    { d: fs.d, t: bytes_concat_all([b"{", joined(fs.ts, b", "), b"}"]) }
  } else if t.v == t_e_field() {
    let b = parens(p_expr(x, e, depth), is_base(e));
    let f = rd_text(b.d);
    { d: f.d, t: bytes_concat_all([b.t, b".", f.t]) }
  } else if t.v == t_e_list() {
    let n = rd_count(e);
    let items = rd_many(n.d, n.v, |g: Dc| p_expr(x, g, depth));
    { d: items.d, t: bytes_concat_all([b"[", joined(items.ts, b", "), b"]"]) }
  } else if t.v == t_e_perform() {
    let eff = rd_effect(x, e);
    let op = rd_text(eff.d);
    let r = rd_opt(op.d, rd_text);
    let n = rd_count(r.d);
    let args = rd_many(n.d, n.v, |g: Dc| p_expr(x, g, depth));
    { d: args.d, t: bytes_concat_all([eff.t, b".", op.t, bracketed(r), b"(", joined(args.ts, b", "), b")"]) }
  } else if t.v == t_e_handle() {
    let body = p_expr(x, e, depth);
    let n = rd_count(body.d);
    let clauses = rd_many(n.d, n.v, |g: Dc| {
      let eff = rd_effect(x, expect(g, t_clause(), b"a handler clause"));
      let op = rd_text(eff.d);
      let r = rd_opt(op.d, rd_text);
      let k: Rd = rd_binders(r.d);
      let bound = g.values + k.v;
      let resumed: Opt = rd_opt({..k.d, values: bound}, |h: Dc| { d: h, t: bytes_concat(b" resume ", lname(bound)) });
      let cb: Got = p_expr(x, {..resumed.d, values: if resumed.some { bound + 1 } else { bound }}, inner);
      { d: {..cb.d, values: g.values},
        t: bytes_concat_all([nl(inner), eff.t, b".", op.t, bracketed(r), b"(", joined(map(range(0, k.v), |i: Int| lname(g.values + i)), b", "), b")",
                             resumed.t, b" -> ", cb.t, b","]) }
    });
    let ret = rd_opt(clauses.d, |g: Dc| {
      let h: Dc = expect(g, t_return_clause(), b"a return clause");
      let rb: Got = p_expr(x, {..h, values: g.values + 1}, inner);
      { d: {..rb.d, values: g.values}, t: bytes_concat_all([nl(inner), b"return ", lname(g.values), b" -> ", rb.t, b","]) }
    });
    { d: ret.d, t: bytes_concat_all([b"handle ", body.t, b" with {", bytes_concat_all(clauses.ts), ret.t, nl(depth), b"}"]) }
  } else if t.v == t_e_with_cell() {
    let r = rd_text(e);
    let init: Got = p_expr(x, r.d, depth);
    let at_ = init.d.values;
    let body: Got = p_expr(x, {..init.d, values: at_ + 1}, inner);
    { d: {..body.d, values: at_}, t: bytes_concat_all([b"with_cell[", r.t, b"](", init.t, b") {", nl(inner), lname(at_), b" -> ", body.t, nl(depth), b"}"]) }
  } else if t.v == t_e_with_region() {
    let r = rd_text(e);
    let body = p_block(x, r.d, depth);
    { d: body.d, t: bytes_concat_all([b"with_region[", r.t, b"] ", body.t]) }
  } else if t.v == t_e_simulate() { let body = p_block(x, e, depth); { d: body.d, t: bytes_concat(b"simulate ", body.t) } }
  else { panic(string_of_bytes(bytes_concat(b"a tag that does not begin an expression: ", num(t.v)))) }
}

fn p_stmt(x: Pr, d: Dc, depth: Int) -> Got = {
  let t = rd_u8(d);
  if t.v == t_s_let() {
    let ty = rd_opt(t.d, |g: Dc| p_type(x, g));
    let v = p_expr(x, ty.d, depth);
    let p = p_pat(x, v.d);
    { d: p.d, t: bytes_concat_all([b"let ", p.t, prefixed(ty, b": "), b" = ", v.t, b";"]) }
  } else if t.v == t_s_expr() { let g = p_expr(x, t.d, depth); { d: g.d, t: bytes_concat(g.t, b";") } }
  else { panic("a tag that does not begin a statement") }
}

fn p_param_slot(x: Pr, d: Dc) -> Got = {
  let t = rd_u8(d);
  if t.v == t_none() { { d: t.d, t: b"" } }
  else if t.v == t_some() { let ty = p_type(x, t.d); { d: ty.d, t: bytes_concat(b": ", ty.t) } }
  else if t.v == t_param_default() {
    let ty = rd_opt(t.d, |g: Dc| p_type(x, g));
    let v = p_expr(x, ty.d, 0);
    { d: v.d, t: bytes_concat_all([prefixed(ty, b": "), b" = ", v.t]) }
  } else { panic("a tag that does not open a parameter") }
}

fn p_constraint(d: Dc) -> Got = {
  let l = rd_u32(expect(d, t_constraint(), b"a constraint"));
  let k = rd_u8(l.d);
  let deriver = if k.v == 1 { b"json" } else if k.v == 2 { b"eq" } else if k.v == 3 { b"ord" } else { panic("a byte that is not a deriver") };
  { d: k.d, t: bytes_concat_all([b"derivable(", deriver, b", ", tname(l.v), b")"]) }
}

fn p_fn(x: Pr, d: Dc, name: Bytes) -> Got = {
  let tc = rd_binders(expect(d, t_fn(), b"a function"));
  let ec: Rd = rd_binders(tc.d);
  let generics = if tc.v == 0 && ec.v == 0 { b"" } else {
    bytes_concat_all([b"<", joined(map(range(0, tc.v), tname), b", "), if ec.v > 0 { bytes_concat(b" | ", joined(map(range(0, ec.v), ename), b", ")) } else { b"" }, b">"]) };
  let n = rd_count({..ec.d, typs: tc.v, rows: ec.v});
  let ps = rd_many(n.d, n.v, |g: Dc| p_param_slot(x, g));
  let ret = rd_opt(ps.d, |g: Dc| p_ret(x, g));
  let row = rd_opt(ret.d, |g: Dc| p_row(x, g));
  let cs = rd_count(row.d);
  let derives: Many = rd_many(cs.d, cs.v, p_constraint);
  let body = p_expr(x, {..derives.d, values: n.v}, 0);
  { d: body.d, t: bytes_concat_all([b"fn ", name, generics, b"(", joined(map(range(0, n.v), |i: Int| bytes_concat(lname(i), at(ps.ts, i))), b", "), b")",
                                    prefixed(ret, b" -> "), prefixed(row, b" / "), if cs.v > 0 { bytes_concat(b" where ", joined(derives.ts, b", ")) } else { b"" },
                                    b" =\n  ", body.t]) }
}

fn p_type_def(x: Pr, d: Dc, name: Bytes) -> Got = {
  let n: Rd = rd_binders(expect(d, t_type(), b"a type"));
  let k = rd_u8({..n.d, typs: n.v});
  // Every variant keeps its `|`: a single-variant sum without one reads as an alias.
  let body: Got = if k.v == t_type_alias() { p_type(x, k.d) }
    else if k.v == t_type_sum() {
      let vn = rd_count(k.d);
      let vs = rd_many(vn.d, vn.v, |g: Dc| {
        let vname = rd_text(expect(g, t_variant(), b"a variant"));
        let fc = rd_count(vname.d);
        let fs = rd_many(fc.d, fc.v, |h: Dc| p_type(x, h));
        { d: fs.d, t: bytes_concat_all([b"| ", vname.t, if fc.v > 0 { bytes_concat_all([b"(", joined(fs.ts, b", "), b")"]) } else { b"" }, b" "]) }
      });
      { d: vs.d, t: bytes_concat_all(vs.ts) }
    } else { panic("a tag that does not begin a type body") };
  { d: body.d, t: bytes_concat_all([b"type ", name, if n.v > 0 { bytes_concat_all([b"<", joined(map(range(0, n.v), tname), b", "), b">"]) } else { b"" }, b" = ", body.t]) }
}

fn p_effect(x: Pr, d: Dc, name: Bytes) -> Got = {
  let nd = rd_bool(expect(d, t_effect(), b"an effect"));
  let n = rd_count(nd.d);
  let ops = rd_many(n.d, n.v, |g: Dc| {
    let op = rd_text(expect(g, t_op(), b"an operation"));
    let m = rd_mode(op.d);
    let r = rd_bool(m.d);
    let pc = rd_count(r.d);
    let ps = rd_many(pc.d, pc.v, |h: Dc| p_type(x, h));
    let ret = p_type(x, ps.d);
    { d: ret.d, t: bytes_concat_all([nl(1), m.t, b" ", op.t, if r.v { b"[r]" } else { b"" }, b"(", joined(ps.ts, b", "), b") -> ", ret.t]) }
  });
  { d: ops.d, t: bytes_concat_all([if nd.v { b"nondet " } else { b"" }, b"effect ", name, b" {", bytes_concat_all(ops.ts), b"\n}"]) }
}

// Everything is `pub`: visibility is metadata the encoding erased.
fn p_item(x: Pr, d: Dc, name: Bytes) -> Got = {
  let t = peek(d);
  let g = if t == t_fn() { p_fn(x, d, name) } else if t == t_type() { p_type_def(x, d, name) } else if t == t_effect() { p_effect(x, d, name) }
          else { panic("a tag that does not begin a definition") };
  if g.d.pos != bytes_len(g.d.b) { panic("bytes remain after the definition") } else { { d: g.d, t: bytes_concat(b"pub ", g.t) } }
}

fn p_test(x: Pr, d: Dc, label: Bytes) -> Got = {
  let nd = rd_bool(expect(d, t_test(), b"a test"));
  let body = p_block(x, nd.d, 0);
  if body.d.pos != bytes_len(body.d.b) { panic("bytes remain after the test") }
  else { { d: body.d, t: bytes_concat_all([if nd.v { b"test/nondet " } else { b"test " }, str_lit(label), b" ", body.t]) } }
}

type Named = { module: Bytes, simple: Bytes }
type Comp = { members: List<Bytes>, hashes: List<Bytes>, id: Bytes, key: Bytes }
type Copied = { module: Bytes, names: List<Bytes> }
type Parting = { seen: Map<Bytes, Bool>, declared: Map<Bytes, Bytes>, parts: List<Part>, bad: Option<Refusal> }
type Sheet = { items: List<Bytes>, imports: Map<Bytes, Bytes> }

fn refuse(message: Bytes, notes: List<Bytes>) -> Option<Refusal> = Some({ message: message, notes: notes })

fn comp_of(body: Bytes) -> Comp = {
  let k = rd_u8(cursor(body, map_new()));
  if k.v == 0 { let payload = bytes_slice(body, 1, bytes_len(body)); let id = blake3(payload); { members: [payload], hashes: [id], id: id, key: id } }
  else if k.v == 1 {
    let class = rd_u32(k.d);
    let payload = bytes_slice(body, 5, bytes_len(body));
    let c = rd_count(cursor(payload, map_new()));
    let ms = rd_many(c.d, c.v, rd_text);
    if ms.d.pos != bytes_len(payload) || class.v >= c.v { panic("a malformed component body") } else {
      let id = blake3(payload);
      { members: ms.ts, hashes: map(range(0, c.v), |i: Int| member_hash(id, i)), id: id, key: member_hash(id, class.v) }
    }
  } else { panic("a stored body of a kind this build does not read") }
}

fn listed(ns: List<Named>) -> Bytes = backticked(map(ns, |n: Named| qualify(n.module, n.simple)), b", ")

fn named_of(names: List<{ name: Bytes, hash: Bytes }>, keys: Map<Bytes, Bool>) -> { named: Map<Bytes, Map<Bytes, Named>>, bad: Option<Refusal> } =
  fold(names, { named: map_new(), bad: None }, |acc: { named: Map<Bytes, Map<Bytes, Named>>, bad: Option<Refusal> }, n: { name: Bytes, hash: Bytes }|
    match acc.bad {
      Some(_) -> acc,
      None -> {
        let simple = default_binder(n.name);
        if bytes_len(simple) == bytes_len(n.name) { {..acc, bad: refuse(bytes_concat_all([b"`", n.name, b"` names no module"]), [])} }
        else if !map_contains(keys, n.hash) { {..acc, bad: refuse(bytes_concat_all([b"`", n.name, b"` has no body"]), [])} }
        else {
          let module = bytes_slice(n.name, 0, bytes_len(n.name) - bytes_len(simple) - 1);
          let had = match map_get(acc.named, n.hash) { Some(m) -> m, None -> map_new() };
          {..acc, named: map_insert(acc.named, n.hash, map_insert(had, bytes_concat_all([module, b"\x00", simple]), { module: module, simple: simple }))}
        }
      },
    })

fn copies(classes: List<List<Named>>) -> Option<List<Copied>> =
  if len(classes) == 1 { Some(map(at(classes, 0), |n: Named| { module: n.module, names: [n.simple] })) } else {
    let by_module = fold(range(0, len(classes)), map_new(), |acc: Map<Bytes, List<List<Bytes>>>, c: Int|
      fold(at(classes, c), acc, |a: Map<Bytes, List<List<Bytes>>>, n: Named| {
        let rows = match map_get(a, n.module) { Some(r) -> r, None -> map(classes, |k: List<Named>| []) };
        map_insert(a, n.module, set_at(rows, c, push(at(rows, c), n.simple)))
      }));
    map_fold(by_module, Some([]), |acc: Option<List<Copied>>, m: Bytes, rows: List<List<Bytes>>|
      match acc {
        None -> None,
        Some(out) -> {
          let count = len(at(rows, 0));
          if fold(rows, false, |b: Bool, r: List<Bytes>| b || len(r) != count) { None }
          else { Some(fold(range(0, count), out, |o: List<Copied>, k: Int| push(o, { module: m, names: map(rows, |r: List<Bytes>| at(r, k)) }))) }
        },
      })
  }

fn part_in(acc: Parting, c: Comp, named: Map<Bytes, Map<Bytes, Named>>, shipped: List<Bytes>) -> Parting = {
  let classes = map(c.hashes, |h: Bytes| match map_get(named, h) { Some(m) -> map_values(m), None -> [] });
  let checked: Parting = fold(range(0, len(c.hashes)), acc, |a: Parting, i: Int|
    match a.bad {
      Some(_) -> a,
      None -> {
        let all = at(classes, i);
        let h = at(c.hashes, i);
        let kind = bytes_at(at(c.members, i), 0);
        if len(all) == 0 { {..a, bad: refuse(bytes_concat_all([b"the body `", short_hex(h), b"` has no name"]), [])} }
        else if kind == t_effect() && len(all) > 1 {
          {..a, bad: refuse(bytes_concat(listed(all), b" are one effect declaration, so a body cannot say which it performs"),
                            [b"make the declarations differ, or keep one of them"])}
        } else {
          fold(all, a, |b: Parting, n: Named| {
            let q = qualify(n.module, n.simple);
            let key = bytes_concat(byte_of(kind), q);
            match map_get(b.declared, key) {
              Some(other) -> if other == h || is_some(b.bad) { b } else { {..b, bad: refuse(bytes_concat_all([b"`", q, b"` names two different definitions"]), [])} },
              None -> {..b, declared: map_insert(b.declared, key, h)},
            }
          })
        }
      },
    });
  match checked.bad {
    Some(_) -> checked,
    None -> match copies(classes) {
      None -> {..checked, bad: refuse(bytes_concat(listed(fold(classes, [], |o: List<Named>, ns: List<Named>| append(o, ns))),
                                                   b" are a mutually recursive group in which two definitions share one body, so a call cannot say which it reaches"),
                                      [b"make the definitions differ, or keep one of them"])},
      Some(cs) -> {..checked, parts: fold(cs, checked.parts, |ps: List<Part>, cp: Copied|
        push(ps, { members: c.members, hashes: c.hashes, names: cp.names, module: cp.module, binder: default_binder(cp.module), printed: !contains_bytes(shipped, cp.module) }))},
    },
  }
}

fn is_some(o: Option<Refusal>) -> Bool = match o { Some(_) -> true, None -> false }

fn binders(modules: List<Bytes>) -> Map<Bytes, Bytes> = {
  let sharing = fold(modules, map_new(), |acc: Map<Bytes, Int>, m: Bytes|
    map_insert(acc, default_binder(m), 1 + match map_get(acc, default_binder(m)) { Some(k) -> k, None -> 0 }));
  let start = { taken: map_fold(sharing, map_new(), |acc: Map<Bytes, Bool>, b: Bytes, k: Int| map_insert(acc, b, true)), out: map_new() };
  let done = fold(modules, start, |s: { taken: Map<Bytes, Bool>, out: Map<Bytes, Bytes> }, m: Bytes| {
    let own = default_binder(m);
    if (match map_get(sharing, own) { Some(k) -> k == 1, None -> true }) { {..s, out: map_insert(s.out, m, own)} }
    else {
      let base = joined(bytes_split(m, b"."), b"_");
      let found = iterate({ n: 1, binder: base }, 2 * len(modules) + 2, |t: { n: Int, binder: Bytes }|
        if map_contains(s.taken, t.binder) { Continue({ n: t.n + 1, binder: bytes_concat_all([base, b"_", num(t.n + 1)]) }) } else { Stop(t) });
      { taken: map_insert(s.taken, found.binder, true), out: map_insert(s.out, m, found.binder) }
    }
  });
  done.out
}

fn layout_of(parts: List<Part>, relink: Map<Bytes, Bytes>) -> Layout = {
  let bound = binders(map_keys(fold(parts, map_new(), |acc: Map<Bytes, Bool>, p: Part| map_insert(acc, p.module, true))));
  let placed = map(parts, |p: Part| {..p, binder: match map_get(bound, p.module) { Some(b) -> b, None -> p.binder }});
  { parts: placed,
    by_hash: fold(range(0, len(placed)), map_new(), |acc: Map<Bytes, List<Slot>>, u: Int| {
      let hashes = at(placed, u).hashes;
      fold(range(0, len(hashes)), acc, |a: Map<Bytes, List<Slot>>, c: Int|
        map_insert(a, at(hashes, c), push(match map_get(a, at(hashes, c)) { Some(xs) -> xs, None -> [] }, { part: u, class: c })))
    }),
    relink: relink }
}

fn print_parts(l: Layout) -> { modules: Map<Bytes, Sheet>, missing: Map<Bytes, Bool> } =
  fold(range(0, len(l.parts)), { modules: map_new(), missing: map_new() }, |acc: { modules: Map<Bytes, Sheet>, missing: Map<Bytes, Bool> }, u: Int| {
    let p = at(l.parts, u);
    if !p.printed { acc } else {
      let x = { layout: l, part: u, own: p.module };
      let walked = fold(range(0, len(p.members)), { d: cursor(b"", acc.missing), ts: [] }, |s: Many, c: Int| {
        let g = p_item(x, {..s.d, b: at(p.members, c), pos: 0, values: 0, typs: 0, rows: 0}, at(p.names, c));
        { d: g.d, ts: push(s.ts, g.t) }
      });
      let had = match map_get(acc.modules, p.module) { Some(m) -> m, None -> { items: [], imports: map_new() } };
      { modules: map_insert(acc.modules, p.module, { items: append(had.items, walked.ts), imports: map_merge(had.imports, map_remove(walked.d.imports, p.module)) }),
        missing: walked.d.missing }
    }
  })

fn print_tests(l: Layout, tests: List<Bytes>, missing: Map<Bytes, Bool>) -> Many = {
  let x = { layout: l, part: 0 - 1, own: b"" };
  fold(range(0, len(tests)), { d: cursor(b"", missing), ts: [] }, |s: Many, i: Int| {
    let body = at(tests, i);
    if bytes_len(body) == 0 || bytes_at(body, 0) != 0 { panic("a test body that is not a solo body") } else {
      let g = p_test(x, {..s.d, b: bytes_slice(body, 1, bytes_len(body)), pos: 0, values: 0, typs: 0, rows: 0, slots: map_new()}, bytes_concat(b"t", num(i)));
      { d: g.d, ts: push(s.ts, g.t) }
    }
  })
}

fn sheet_text(s: Sheet) -> Bytes =
  bytes_concat_all(append(
    map_fold(s.imports, [], |acc: List<Bytes>, m: Bytes, b: Bytes|
      push(acc, bytes_concat_all([b"import ", m, if b == default_binder(m) { b"" } else { bytes_concat(b" as ", b) }, b"\n"]))),
    map(s.items, |it: Bytes| bytes_concat_all([b"\n", it, b"\n"]))))

pub fn print_bodies(bodies: List<Bytes>, names: List<{ name: Bytes, hash: Bytes }>, tests: List<Bytes>,
                    relink: List<{ from: Bytes, to: Bytes }>, shipped: List<Bytes>) -> Printing = {
  let comps = map(bodies, comp_of);
  let n = named_of(names, fold(comps, map_new(), |acc: Map<Bytes, Bool>, c: Comp| map_insert(acc, c.key, true)));
  let parted: Parting = match n.bad {
    Some(_) -> { seen: map_new(), declared: map_new(), parts: [], bad: n.bad },
    None -> fold(comps, { seen: map_new(), declared: map_new(), parts: [], bad: None }, |acc: Parting, c: Comp|
      if is_some(acc.bad) || map_contains(acc.seen, c.id) { acc } else { part_in({..acc, seen: map_insert(acc.seen, c.id, true)}, c, n.named, shipped) }),
  };
  match parted.bad {
    Some(r) -> Unprintable(r),
    None -> {
      let l = layout_of(parted.parts, fold(relink, map_new(), |acc: Map<Bytes, Bytes>, r: { from: Bytes, to: Bytes }| map_insert(acc, r.from, r.to)));
      let printed = print_parts(l);
      let t = print_tests(l, tests, printed.missing);
      let missing = map_keys(t.d.missing);
      if len(missing) > 0 {
        Unprintable({ message: bytes_concat(num(len(missing)), b" definitions a body refers to are not among the bodies"),
                      notes: [bytes_concat(b"missing: ", joined(map(take(missing, min(8, len(missing))), short_hex), b", "))] })
      } else {
        let texts = map_fold(printed.modules, [], |acc: List<{ module: Bytes, text: Bytes }>, m: Bytes, s: Sheet| push(acc, { module: m, text: sheet_text(s) }));
        Printed(if len(tests) == 0 { texts } else { push(texts, { module: b"ply_tests", text: sheet_text({ items: t.ts, imports: t.d.imports }) }) })
      }
    },
  }
}

// --- Tests ------------------------------------------------------------------

test "the little-endian encoders write what the reference writes" {
  assert_eq(u32_le(1), b"\x01\x00\x00\x00");
  assert_eq(u32_le(0x01020304), b"\x04\x03\x02\x01");
  assert_eq(i64_le(0 - 1), b"\xff\xff\xff\xff\xff\xff\xff\xff");
  assert_eq(hex(b"\x00\xab\xff"), b"00abff");
  assert_eq(i128_le_of_digits(b"256"), b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")
}

test "a float literal is read as its correctly rounded bit pattern" {
  assert_eq(float_bits(b"1.5"), 0x3FF8000000000000);
  assert_eq(float_bits(b"1e2"), bits_of_float(100.0));
  assert_eq(float_bits(b"2.5e-1"), bits_of_float(0.25));
  assert_eq(float_bits(b"1.0e300"), 0x7E37E43C8800759C);
  assert_eq(float_bits(b"1.0e-30"), 0x39B4484BFEEBC2A0);
  let parts = decimal_parts(b"1.50m");
  assert_eq(parts.scale, 2);
  assert_eq(bytes_at(parts.mantissa, 0), 150)
}

test "renaming a definition does not move its hash, and a change to a callee does" {
  let a = hash_dump([{ name: b"m", src: b"fn helper(x: Int) -> Int = x + 1\nfn f() -> Int = helper(1)" }]);
  let b = hash_dump([{ name: b"m", src: b"fn aide(x: Int) -> Int = x + 1\nfn f() -> Int = aide(1)" }]);
  let c = hash_dump([{ name: b"m", src: b"fn helper(x: Int) -> Int = x + 2\nfn f() -> Int = helper(1)" }]);
  let hash_of = |dump: String, name: Bytes| {
    let d = bytes_of_string(dump);
    let key = bytes_concat_all([b"H;", name, b";"]);
    let start = match bytes_index_of(d, key) { Some(i) -> i + bytes_len(key), None -> panic("the dump names the definition") };
    bytes_slice(d, start, start + 64)
  };
  assert_eq(hash_of(a, b"m.helper"), hash_of(b, b"m.aide"));
  assert_eq(hash_of(a, b"m.f"), hash_of(b, b"m.f"));
  assert(hash_of(a, b"m.f") != hash_of(c, b"m.f"))
}

test "a mutually recursive pair hashes as one component with two members" {
  let d = bytes_of_string(hash_dump([{ name: b"m", src: b"fn even(n: Int) -> Bool = if n == 0 { true } else { odd(n - 1) }\nfn odd(n: Int) -> Bool = if n == 0 { false } else { even(n - 1) }" }]));
  assert(match bytes_index_of(d, b"C;m.even;m.even,m.odd;") { Some(_) -> true, None -> false });
  assert(match bytes_index_of(d, b"C;m.odd;m.even,m.odd;") { Some(_) -> true, None -> false })
}

test "a literal is spelled so it reads back to its bits" {
  assert_eq(float_text(bits_of_float(0.1)), b"0.1");
  assert_eq(float_text(bits_of_float(100.0)), b"100.0");
  assert_eq(float_text(bits_of_float(1e300)), b"1e300");
  assert_eq(float_text(bits_of_float(1.5e-7)), b"1.5e-7");
  assert_eq(float_text(1), b"5e-324");
  assert_eq(float_text(0x8000000000000000), b"-0.0");
  assert_eq(decimal_text(i128_le_of_digits(b"50"), 3), b"0.050m");
  assert_eq(decimal_text(i128_le_of_digits(b"79228162514264337593543950335"), 0), b"79228162514264337593543950335m");
  assert_eq(int_text(0 - 1), b"0xffffffffffffffff");
  assert_eq(fixed_text(4, 0 - 1), b"0xffi8");
  assert_eq(bytes_lit(b"\x00\"q\xff"), b"b\"\\0\\\"q\\xff\"")
}

fn indexed(sources: List<Source>) -> Index =
  match resolve_modules(map(range(0, len(sources)), |i: Int| {
    let r = parse(at(sources, i).src);
    let d: Expansion = expand_derives(i, expand(r.node, r.p.uses_sets, r.p.diags).module);
    { name: at(sources, i).name, module: d.module, derived: d.derived }
  })) {
    Failed(_) -> panic("the fixture resolves"),
    Resolved_(x) -> build_index(x.mods, x.r).index,
  }

fn named_hashes(out: HashOutput) -> List<{ name: Bytes, hash: Bytes }> = append(out.defs, out.decls)

fn by_name(xs: List<{ name: Bytes, hash: Bytes }>) -> Map<Bytes, Bytes> =
  fold(xs, map_new(), |m: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }| map_insert(m, x.name, x.hash))

fn printed_of(out: HashOutput, shipped: List<Bytes>) -> List<{ module: Bytes, text: Bytes }> =
  match print_bodies(map(out.bodies, |b: { name: Bytes, body: Bytes }| b.body), named_hashes(out), [], [], shipped) {
    Printed(ms) -> ms,
    Unprintable(why) -> panic(string_of_bytes(why.message)),
  }

fn holds_text(text: Bytes, part: Bytes) -> Bool = match bytes_index_of(text, part) { Some(_) -> true, None -> false }

test "printed bodies hash back to what they were stored under, under their own names" {
  let out = hash_index(indexed([
    { name: b"left.util", src: b"pub type Shape = | Dot | Line(Int)\npub fn size(s: Shape) -> Int = match s { Dot -> 0, Line(n) -> n }" },
    { name: b"right.util", src: b"pub fn big() -> Float = 0.1 + 1e300\npub fn tiny() -> Decimal = 0.050m\npub fn raw() -> Bytes = b\"\\x00\\\"q\"" },
    { name: b"app", src: b"import left.util as l\nfn even(n: Int) -> Bool = if n == 0 { true } else { odd(n - 1) }\nfn odd(n: Int) -> Bool = if n == 0 { false } else { even(n - 1) }\nfn all() -> Int = l::size(l::Line(0xFFFFFFFFFFFFFFFF)) + (match 255u8 { _ -> 1 })" }]));
  let ms = printed_of(out, []);
  assert_eq(map(ms, |m: { module: Bytes, text: Bytes }| m.module), [b"app", b"left.util", b"right.util"]);
  assert(holds_text(at(ms, 0).text, b"import left.util as left_util\n"));
  let again = hash_index(indexed(map(ms, |m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })));
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)));
  let shipped = printed_of(out, [b"left.util"]);
  assert_eq(map(shipped, |m: { module: Bytes, text: Bytes }| m.module), [b"app", b"right.util"])
}

test "one effect declaration under two names is refused, since a body cannot say which it performs" {
  let out = hash_index(indexed([{ name: b"a", src: b"pub effect one { read at() -> Int }" }, { name: b"b", src: b"pub effect two { read at() -> Int }" }]));
  match print_bodies(map(out.bodies, |b: { name: Bytes, body: Bytes }| b.body), named_hashes(out), [], [], []) {
    Printed(_) -> panic("two names for one declaration must be refused"),
    Unprintable(why) -> assert_eq(why.message, b"`a.one`, `b.two` are one effect declaration, so a body cannot say which it performs"),
  }
}
