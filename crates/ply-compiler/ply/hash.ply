// --- Bytes ------------------------------------------------------------------------------------

/// The position of `v` in `xs`, searching from the end: a binder's de Bruijn level.
fn rposition(xs: List<Bytes>, v: Bytes) -> Option<Int> / {abort.raise} =
  range(0, xs.len()).fold(None, |acc: Option<Int>, i: Int|
    if xs.get(i) == v { Some(i) } else { acc })

/// The width's position in `lexer::widths`: the discriminant the encoding writes.
fn width_index(ty: Bytes) -> Bytes / {abort.raise} = {
  let want = Bytes::of_string(String::of_bytes(ty).ascii_lower());
  byte_of_int(
    range(0, widths().len()).fold(0, |at: Int, i: Int|
      match widths().at(i) { Some(w) -> if w.name == want { i } else { at }, None -> at }),
  )
}

fn i64_le(v: Int) -> Bytes =
  Bytes::concat_all(range(0, 8).map(|i: Int| byte_of_int(v >>> 8 * i & 0xFF)))

fn hex_digit(v: Int) -> Bytes / {abort.raise} =
  if v < 10 { byte_of_int(48 + v) } else { byte_of_int(87 + v) }

/// Every byte's two digits, so a byte of `hex` is one lookup.
fn hex_pairs() -> List<Bytes> / {abort.raise} =
  range(0, 256).map(|v: Int| hex_digit(v >>> 4).concat(hex_digit(v & 15)))

pub fn hex(b: Bytes) -> Bytes / {abort.raise} = {
  let pairs = hex_pairs();
  Bytes::concat_all(range(0, b.len()).map(|i: Int| pairs.get(b.at(i))))
}

/// A `Decimal` mantissa has up to 96 bits, more than an `Int`, so it is accumulated a byte at a time.
fn i128_le_of_digits(digits: Bytes) -> Bytes / {abort.raise} = {
  let limbs = range(0, digits.len()).fold(range(0, 16).map(|i: Int| 0), |acc: List<Int>, i: Int| {
    let d = digits.at(i) - 48;
    let carried = range(0, 16).fold(
      { limbs: [], carry: d },
      |s: { limbs: List<Int>, carry: Int }, k: Int| {
        let v = acc.get(k) * 10 + s.carry;
        { limbs: s.limbs.push(v & 0xFF), carry: v >>> 8 }
      },
    );
    carried.limbs
  });
  Bytes::concat_all(limbs.map(|v: Int| byte_of_int(v)))
}

fn float_bits(text: Bytes) -> Int / {abort.raise} =
  match Float::of_string(String::of_bytes(text)) {
    Some(f) -> bits_of_float(f),
    None -> panic("a float literal the hasher cannot read"),
  }

/// A `Decimal` literal's `(mantissa, scale)`: the digits without the point, and how many followed it.
fn decimal_parts(text: Bytes) -> { mantissa: Bytes, scale: Int } / {abort.raise} = {
  let body = text.slice(0, text.len() - 1);
  let split = range(0, body.len()).fold(
    { digits: b"", scale: 0, after: false },
    |s: { digits: Bytes, scale: Int, after: Bool }, i: Int| {
      let c = body.at(i);
      if c == 46 { { ..s, after: true } }
      else if !is_digit(c) { s } else {
        {
          digits: s.digits.concat(byte_of_int(c)),
          scale: if s.after { s.scale + 1 } else { s.scale },
          after: s.after,
        }
      }
    },
  );
  { mantissa: i128_le_of_digits(split.digits), scale: split.scale }
}

// --- The reference graph over every top-level definition ------------------------------

pub type NodeBody = | NodeFn(FnDef) | NodeType(TypeDef) | NodeEffect(EffectDef)
pub type Node = { name: Bytes, simple: Bytes, module: Int, body: NodeBody }
pub type TestNode = { key: Bytes, module: Int, def: TestDef }
pub type LawNode = { key: Bytes, module: Int, def: LawDef }
pub type IndexEntry = | DefEntry(Int) | TestEntry(Int) | LawEntry(Int)
type Target = { owner: Int, name: Bytes }
pub type ValueTarget = | FnTarget(Int) | CtorTarget({ owner: Int, name: Bytes })
type ModuleItems = {
  fns: Map<Bytes, Int>,
  /// Its functions of types, `X::name`, under the name each has there.
  members: Map<Bytes, List<Int>>,
  types: Map<Bytes, Int>,
  effects: Map<Bytes, Int>,
  ctors: Map<Bytes, Int>,
  // What the module states of each type it names: a type's hash covers these.
  instances: Map<Bytes, List<InstanceDef>>,
  numerics: Map<Bytes, NumericDef>,
}
type ScopeIndex = {
  values: Map<Bytes, Target>,
  types: Map<Bytes, Target>,
  effects: Map<Bytes, Target>,
  modules: Map<Bytes, Int>,
  /// The modules whose functions of types a call on a value here may call: itself, and each it
  /// imports, directly or through others.
  sees: List<Int>,
}

pub type Index = {
  mods: List<ParsedModule>,
  nodes: List<Node>,
  tests: List<TestNode>,
  laws: List<LawNode>,
  order: List<IndexEntry>,
  items: List<ModuleItems>,
  scopes: List<ScopeIndex>,
  effect_sketches: Map<Int, Bytes>,
  /// The nodes of what the code the emitter writes for a container calls (`written_code`), which
  /// a body that compares, digests or shows anything references.
  written: List<Int>,
}

fn qualifier(qname: QName) -> Option<Bytes> =
  match qname.module { Some(m) -> Some(m.name), None -> None }

/// The name `qualified` has inside the module that declares it.
fn simple_of(qualified: Bytes, owner: Bytes) -> Bytes / {abort.raise} = {
  let prefix = owner.concat(b".");
  if owner.len() > 0 && qualified.starts_with(prefix) {
    qualified.slice(prefix.len(), qualified.len())
  } else { qualified }
}

type Building = {
  nodes: List<Node>,
  tests: List<TestNode>,
  laws: List<LawNode>,
  order: List<IndexEntry>,
  items: List<ModuleItems>,
  diags: List<Diag>,
}
type Declaring = { map: Map<Bytes, Int>, spans: Map<Bytes, Span>, diags: List<Diag> }

fn declare(d: Declaring, m: Int, name: Ident, id: Int, what: Bytes) -> Declaring =
  match d.spans.get(name.name) {
    Some(first) ->
      {
        ..d,
        diags: d.diags.push(
          error_at_and(
            b"E0105",
            m,
            name.span,
            Bytes::concat_all([b"duplicate ", what, b" `", name.name, b"`"]),
            b"redefined here",
            m,
            first,
            b"first defined here",
            [
              Bytes::concat_all([
                b"rename one of them; every ",
                what,
                b" in a module needs a distinct name",
              ]),
            ],
          ),
        ),
      },
    None ->
      {
        map: d.map.insert(name.name, id),
        spans: d.spans.insert(name.name, name.span),
        diags: d.diags,
      },
  }

fn no_declaring(diags: List<Diag>) -> Declaring =
  { map: Map::new(), spans: Map::new(), diags: diags }

pub fn build_index(
  mods: List<ParsedModule>,
  resolved: Resolved,
) -> { index: Index, diags: List<Diag> } / {abort.raise} = {
  let built = range(0, mods.len()).fold(
    { nodes: [], tests: [], laws: [], order: [], items: [], diags: [] },
    |b: Building, m: Int| {
      let module = mods.get(m);
      let walked = module.module.items.fold(
        {
          b: b,
          fns: no_declaring([]),
          types: no_declaring([]),
          effects: no_declaring([]),
          ctors: no_declaring([]),
        },
        |s: { b: Building, fns: Declaring, types: Declaring, effects: Declaring, ctors: Declaring }, item: Item| {
          let bb: Building = s.b;
          match item {
            IFn(d) -> {
              let id = bb.nodes.len();
              let pushed: Building = {
                ..bb,
                nodes: bb.nodes.push({
                  name: qualify(module.name, d.name.name),
                  simple: d.name.name,
                  module: m,
                  body: NodeFn(d),
                }),
                order: bb.order.push(DefEntry(id)),
              };
              let fns: Declaring = declare({ ..s.fns, diags: [] }, m, d.name, id, b"definition");
              {
                ..s,
                b: { ..pushed, diags: pushed.diags.concat(fns.diags) },
                fns: { ..fns, diags: [] },
              }
            },
            IType(d) -> {
              let id = bb.nodes.len();
              let pushed: Building = {
                ..bb,
                nodes: bb.nodes.push({
                  name: qualify(module.name, d.name.name),
                  simple: d.name.name,
                  module: m,
                  body: NodeType(d),
                }),
                order: bb.order.push(DefEntry(id)),
              };
              let types: Declaring = declare({ ..s.types, diags: [] }, m, d.name, id, b"type");
              let ctors: Declaring = match d.body {
                TDSum(variants) ->
                  variants.fold({ ..s.ctors, diags: [] }, |c: Declaring, variant: VariantDef|
                    declare(c, m, variant.name, id, b"variant")),
                _ -> { ..s.ctors, diags: [] },
              };
              {
                ..s,
                b: { ..pushed, diags: pushed.diags.concat(types.diags).concat(ctors.diags) },
                types: { ..types, diags: [] },
                ctors: { ..ctors, diags: [] },
              }
            },
            IEffect(d) -> {
              let id = bb.nodes.len();
              let pushed: Building = {
                ..bb,
                nodes: bb.nodes.push({
                  name: qualify(module.name, d.name.name),
                  simple: d.name.name,
                  module: m,
                  body: NodeEffect(d),
                }),
                order: bb.order.push(DefEntry(id)),
              };
              let effects: Declaring = declare(
                { ..s.effects, diags: [] },
                m,
                d.name,
                id,
                b"effect",
              );
              {
                ..s,
                b: { ..pushed, diags: pushed.diags.concat(effects.diags) },
                effects: { ..effects, diags: [] },
              }
            },
            ITest(d) ->
              {
                ..s,
                b: {
                  ..bb,
                  order: bb.order.push(TestEntry(bb.tests.len())),
                  tests: bb.tests.push({ key: qualify(module.name, d.name), module: m, def: d }),
                },
              },
            ILaw(d) ->
              {
                ..s,
                b: {
                  ..bb,
                  order: bb.order.push(LawEntry(bb.laws.len())),
                  laws: bb.laws.push({ key: qualify(module.name, d.name), module: m, def: d }),
                },
              },
            _ -> s,
          }
        },
      );
      let wb: Building = walked.b;
      {
        ..wb,
        items: wb.items.push({
          fns: walked.fns.map,
          members: walked.fns.map.fold(
            Map::new(),
            |acc: Map<Bytes, List<Int>>, name: Bytes, node: Int|
              match member_of(name) {
                Some(of) ->
                  acc.insert(
                    of.member,
                    List::push(match acc.get(of.member) { Some(ns) -> ns, None -> [] }, node),
                  ),
                None -> acc,
              },
          ),
          types: walked.types.map,
          effects: walked.effects.map,
          ctors: walked.ctors.map,
          instances: instances_in(module.module.items),
          numerics: module.module.items.fold(
            Map::new(),
            |acc: Map<Bytes, NumericDef>, item: Item|
              match item { INumeric(d) -> acc.insert(d.target.name, d), _ -> acc },
          ),
        }),
      }
    },
  );
  let scopes = range(0, mods.len()).map(|m: Int| {
    let scope = resolved.scopes.get(m);
    let project = |bindings: List<Binding>|
      bindings.fold(Map::new(), |acc: Map<Bytes, Target>, b: Binding|
        acc.insert(b.name, {
          owner: b.owner,
          name: simple_of(b.qualified, mods.get(b.owner).name),
        }));
    {
      values: project(scope.bound.values),
      types: project(scope.bound.types),
      effects: project(scope.bound.effects),
      modules: scope.modules.fold(Map::new(), |acc: Map<Bytes, Int>, mb: ModuleBinding|
        acc.insert(mb.binder, mb.target)),
      sees: match resolved.sees.at(m) { Some(seen) -> seen, None -> [m] },
    }
  });
  let prelude = range(0, mods.len()).filter(|m: Int| mods.get(m).name == prelude_module());
  let index: Index = {
    mods: mods,
    nodes: built.nodes,
    tests: built.tests,
    laws: built.laws,
    order: built.order,
    items: built.items,
    scopes: scopes,
    effect_sketches: Map::new(),
    written: prelude.fold([], |acc: List<Int>, m: Int|
      written_code().calls.fold(acc, |a: List<Int>, n: Bytes|
        match built.items.get(m).fns.get(n) { Some(v) -> a.push(v), None -> a })),
  };
  { index: { ..index, effect_sketches: sketch_effects(index) }, diags: built.diags }
}

/// Each type's `key` before its `show`, whatever order the module wrote them in. A `gen` is no part
/// of what its type is: it decides what a sample draws and nothing a program computes.
fn instances_in(items: List<Item>) -> Map<Bytes, List<InstanceDef>> =
  items.fold(Map::new(), |acc: Map<Bytes, List<InstanceDef>>, item: Item|
    match item {
      IInstance(d) -> {
        let held = match acc.get(d.target.name) { Some(xs) -> xs, None -> [] };
        match d.kind {
          NKey -> acc.insert(d.target.name, [d].concat(held)),
          NShow -> acc.insert(d.target.name, held.push(d)),
        }
      },
      _ -> acc,
    })

fn sketch_effects(index: Index) -> Map<Int, Bytes> / {abort.raise} =
  range(0, index.nodes.len()).fold(Map::new(), |acc: Map<Int, Bytes>, v: Int| {
    let node = index.nodes.get(v);
    match node.body {
      NodeEffect(_) ->
        acc.insert(
          v,
          filled(
            template_of(index, node.module, |encoder: Encoder| normalize_node(encoder, node.body)),
            blank(),
          ).bytes,
        ),
      _ -> acc,
    }
  })

fn is_effect(index: Index, v: Int) -> Bool / {abort.raise} =
  match index.nodes.get(v).body { NodeEffect(_) -> true, _ -> false }

/// A qualified name consults only the named module's declarations; a bare one only the scope.
fn target(
  index: Index,
  module: Int,
  ns: Int,
  qual: Option<Bytes>,
  name: Bytes,
) -> Option<Target> / {abort.raise} = {
  let scope = index.scopes.get(module);
  match qual {
    Some(binder) -> match scope.modules.get(binder) {
      Some(owner) -> Some({ owner: owner, name: name }),
      // A function of a type is written through a binder of its module that no import wrote,
      // or through the type.
      None -> match of_module(binder) {
        None -> match ((ns, scope.types.get(binder))) {
          (0, Some(of)) -> Some({ owner: of.owner, name: member_name(of.name, name) }),
          // A language type's are the prelude's where it writes one in Ply, as the checker binds
          // them, and else its home module's, where this module can see it.
          (0, None) -> {
            let home = b"std.".concat(Bytes::of_string(String::of_bytes(binder).ascii_lower()));
            let member = member_name(binder, name);
            let seen = |wanted: (Int) -> Bool / {abort.raise}|
              scope.sees.fold(None, |found: Option<Target>, k: Int|
                match found {
                  Some(_) -> found,
                  None -> if wanted(k) { Some({ owner: k, name: member }) } else { None },
                });
            match seen(|k: Int|
                index.mods.get(k).name == prelude_module()
                  && index.items.get(k).fns.contains(member)) {
              Some(t) -> Some(t),
              None -> seen(|k: Int| index.mods.get(k).name == home),
            }
          },
          _ -> None,
        },
        Some(home) ->
          range(0, index.mods.len()).fold(None, |found: Option<Target>, k: Int|
            match found {
              Some(_) -> found,
              None -> if index.mods.get(k).name == home { Some({ owner: k, name: name }) }
              else { None },
            }),
      },
    },
    None ->
      Map::get(
        if ns == 0 { scope.values } else if ns == 1 { scope.types } else { scope.effects },
        name,
      ),
  }
}

/// `pub` is metadata a definition's own encoding erases, but a reference to one is another matter: a
/// qualified name reaches only what its module exports, so an unexported one denotes nothing, as it
/// already does for a bare name the scope never bound. Without this a reference that stopped being
/// permitted would encode as though it still were, and the caller's hash would not move.
fn exports(index: Index, qual: Option<Bytes>, node: Int) -> Bool / {abort.raise} =
  match qual {
    None -> true,
    Some(_) -> match index.nodes.get(node).body {
      NodeFn(d) -> is_pub(d.vis),
      NodeType(d) -> is_pub(d.vis),
      NodeEffect(d) -> is_pub(d.vis),
    },
  }

/// A default copied back into its own module names it, and reaches what it keeps, as the checker does.
fn exported(
  index: Index,
  qual: Option<Bytes>,
  from: Int,
  node: Option<Int>,
) -> Option<Int> / {abort.raise} =
  match node {
    None -> None,
    Some(v) -> if index.nodes.get(v).module == from || exports(index, qual, v) { Some(v) }
    else { None },
  }

fn value_target(index: Index, module: Int, qname: QName) -> Option<ValueTarget> / {abort.raise} =
  match target(index, module, 0, qualifier(qname), qname.name.name) {
    None -> None,
    Some(t) -> {
      let items = index.items.get(t.owner);
      match exported(index, qualifier(qname), module, items.fns.get(t.name)) {
        Some(node) -> Some(FnTarget(node)),
        // A variant is exported exactly when the type that declares it is.
        None -> match exported(index, qualifier(qname), module, items.ctors.get(t.name)) {
          Some(owner) -> Some(CtorTarget({ owner: owner, name: t.name })),
          None -> None,
        },
      }
    },
  }

/// The definition a tagged literal's check runs, by its program-wide name, as `module` names it.
pub fn tagged_target(index: Index, module: Int, t: Tagged) -> Option<Bytes> / {abort.raise} =
  match value_target(index, module, tagged_parser(t)) {
    Some(FnTarget(node)) -> Some(index.nodes.get(node).name),
    _ -> None,
  }

/// What a name `module` writes as a value denotes: a definition, by its program-wide name, or a
/// constructor, by its own name and its type's program-wide one.
pub type Denoted =
  | DenotesFn(Bytes)
  | DenotesCtor({ type_name: Bytes, name: Bytes })
  | DenotesNothing

pub fn denoted(index: Index, module: Int, qname: QName) -> Denoted / {abort.raise} =
  match value_target(index, module, qname) {
    Some(FnTarget(node)) -> DenotesFn(index.nodes.get(node).name),
    Some(CtorTarget(c)) -> DenotesCtor({ type_name: index.nodes.get(c.owner).name, name: c.name }),
    None -> DenotesNothing,
  }

/// The program-wide name of the effect `module` names `qname`.
pub fn effect_called(index: Index, module: Int, qname: QName) -> Option<Bytes> / {abort.raise} =
  match effect_target(index, module, qname) {
    Some(v) -> Some(index.nodes.get(v).name),
    None -> None,
  }

/// The program-wide name of the type `module` names `qname`.
pub fn type_named(index: Index, module: Int, qname: QName) -> Option<Bytes> / {abort.raise} =
  match type_target(index, module, qualifier(qname), qname.name.name) {
    Some(v) -> Some(index.nodes.get(v).name),
    None -> None,
  }

fn ctor_target(index: Index, module: Int, qname: QName) -> Option<ValueTarget> / {abort.raise} =
  match target(index, module, 0, qualifier(qname), qname.name.name) {
    None -> None,
    Some(t) -> match exported(
        index,
        qualifier(qname),
        module,
        index.items.get(t.owner).ctors.get(t.name),
      ) {
      Some(owner) -> Some(CtorTarget({ owner: owner, name: t.name })),
      None -> None,
    },
  }

fn type_target(
  index: Index,
  module: Int,
  qual: Option<Bytes>,
  name: Bytes,
) -> Option<Int> / {abort.raise} =
  match target(index, module, 1, qual, name) {
    None -> None,
    Some(t) -> exported(index, qual, module, index.items.get(t.owner).types.get(t.name)),
  }

fn effect_target(index: Index, module: Int, qname: QName) -> Option<Int> / {abort.raise} =
  match target(index, module, 2, qualifier(qname), qname.name.name) {
    None -> None,
    Some(t) ->
      exported(index, qualifier(qname), module, index.items.get(t.owner).effects.get(t.name)),
  }

fn is_cyclic(component: List<Int>, edges: List<List<Int>>) -> Bool / {abort.raise} =
  if component.len() != 1 { true } else {
    let only = component.get(0);
    edges.get(only).contains(only)
  }

// --- The byte encoding ----------------------------------------------------------------

fn tag_local() -> Int = 1
fn tag_ref_hash() -> Int = 2
fn tag_ref_self() -> Int = 3
fn tag_ref_index() -> Int = 4
fn tag_free() -> Int = 5
fn tag_ctor() -> Int = 6
fn tag_ty_param() -> Int = 7
fn tag_row_param() -> Int = 8
fn tag_free_qualified() -> Int = 9
fn tag_none() -> Int = 10
fn tag_some() -> Int = 11
fn tag_ref_name() -> Int = 12
fn tag_param_default() -> Int = 13

/// A `fn` parameter written `keep`.
fn tag_param_kept() -> Int = 172

/// A `fn` parameter that names the space a call of it holds, which a caller's `space` bound reads.
fn tag_param_spaced() -> Int = 175
fn tag_fn() -> Int = 20
fn tag_type_alias() -> Int = 21
fn tag_type_sum() -> Int = 22
fn tag_effect() -> Int = 23
fn tag_test() -> Int = 24
fn tag_variant() -> Int = 25
fn tag_op() -> Int = 26
fn tag_type() -> Int = 27
fn tag_law() -> Int = 28
fn tag_spec() -> Int = 29
fn tag_ty_con() -> Int = 30
fn tag_ty_fn() -> Int = 31
fn tag_ty_record() -> Int = 32
fn tag_ty_unit() -> Int = 33
fn tag_lit_int() -> Int = 40
fn tag_lit_bool() -> Int = 41
fn tag_lit_str() -> Int = 42
fn tag_lit_unit() -> Int = 43
fn tag_lit_bytes() -> Int = 44
fn tag_lit_float() -> Int = 45
fn tag_lit_decimal() -> Int = 46
fn tag_lit_char() -> Int = 47
/// An embedded file by its digest and size, apart from a byte string that happens to be a digest.
fn tag_lit_embedded() -> Int = 48
/// A tag of its own: `5` and `5u32` are different definitions. Tags never renumber, or stored hashes move.
fn tag_lit_fixed() -> Int = 96
fn tag_lit_wide() -> Int = 99
fn tag_e_lit() -> Int = 50
fn tag_e_var() -> Int = 51
fn tag_e_binary() -> Int = 52
fn tag_e_unary() -> Int = 53
fn tag_e_lambda() -> Int = 54
fn tag_e_app() -> Int = 55
fn tag_e_if() -> Int = 56
fn tag_e_match() -> Int = 57
fn tag_e_block() -> Int = 58
fn tag_e_record() -> Int = 59
fn tag_e_field() -> Int = 60
fn tag_e_list() -> Int = 61
fn tag_e_perform() -> Int = 62
fn tag_e_handle() -> Int = 63
fn tag_e_with_hold() -> Int = 170
fn tag_e_on_value() -> Int = 171

fn tag_type_extern() -> Int = 173

/// What follows every binary operator and every value the encoding names by its name alone: the
/// references `written_block` writes, none where nothing calls for them.
fn tag_written() -> Int = 174

fn tag_e_simulate() -> Int = 65
fn tag_e_tagged() -> Int = 66
fn tag_e_filled() -> Int = 150
fn tag_e_parallel() -> Int = 100
fn tag_e_try_block() -> Int = 131
fn tag_e_record_update() -> Int = 67
/// A `handle` with variables, apart from `tag_e_handle` so one without any hashes as it did.
fn tag_e_handle_vars() -> Int = 68
fn tag_s_let() -> Int = 70
fn tag_s_expr() -> Int = 71
fn tag_s_let_else() -> Int = 72
fn tag_s_assign() -> Int = 73
fn tag_p_wildcard() -> Int = 80
fn tag_p_var() -> Int = 81
fn tag_p_lit() -> Int = 82
fn tag_p_ctor() -> Int = 83
fn tag_p_record() -> Int = 84
fn tag_p_list() -> Int = 85
fn tag_p_or() -> Int = 86
fn tag_p_range() -> Int = 87
/// In a later alternative of an or-pattern: the first alternative's binder a variable there is.
fn tag_p_again() -> Int = 162
fn tag_row() -> Int = 90
fn tag_atom() -> Int = 91
fn tag_atom_op() -> Int = 97
fn tag_label_param() -> Int = 98
fn tag_arm() -> Int = 92
fn tag_clause() -> Int = 93
fn tag_return_clause() -> Int = 94
fn tag_constraint() -> Int = 95
fn tag_returns_fresh() -> Int = 101
fn tag_returns_param() -> Int = 102
fn tag_bounded() -> Int = 103
fn tag_decreases() -> Int = 104
fn tag_const() -> Int = 160
fn tag_type_nominal() -> Int = 112
fn tag_cases() -> Int = 105
// A type that binds, and one applied to, labels or rows beside its types.
fn tag_type_over() -> Int = 120
fn tag_ty_con_over() -> Int = 121
/// The function a type's values are compared through, and the one they are shown through.
fn tag_key() -> Int = 140
fn tag_show() -> Int = 141
/// One function a type's arithmetic is, after the operation it is.
fn tag_numeric() -> Int = 142
/// A type only its own module builds a value of.
fn tag_opaque() -> Int = 161

/// An explicit table: renumbering a row invalidates every cached result in every store.
fn binop_byte(op: Bytes) -> Int =
  if op == b"add" { 1 }
  else if op == b"sub" { 2 }
  else if op == b"mul" { 3 }
  else if op == b"div" { 4 }
  else if op == b"rem" { 5 }
  else if op == b"eq" { 6 }
  else if op == b"ne" { 7 }
  else if op == b"lt" { 8 }
  else if op == b"le" { 9 }
  else if op == b"gt" { 10 }
  else if op == b"ge" { 11 }
  else if op == b"and" { 12 }
  else if op == b"or" { 13 }
  else if op == b"concat" { 14 }
  else if op == b"bitand" { 15 }
  else if op == b"bitor" { 16 }
  else if op == b"bitxor" { 17 }
  else if op == b"shl" { 18 }
  else if op == b"shr" { 19 }
  else { 20 }

fn unop_byte(op: Bytes) -> Int = if op == b"neg" { 1 } else if op == b"not" { 2 } else { 3 }

fn mode_byte(mode: Mode) -> Int = match mode { MRead -> 0, MWrite -> 1, MBad -> 0, MRaise -> 2 }

fn spec_tag(k: SpecKind) -> Int = match k { SRequires -> 1, SEnsures -> 2, SCost -> 3, SSpace -> 4 }

fn deriver_byte(deriver: Deriver) -> Int = deriver_tag(deriver) + 1

/// `out` is chunks concatenated once at the end; `refs` is first-mention order; the binder lists are de Bruijn levels.
/// Where the binder a level names stands: `run` -1 for one whose level is fixed where it is written,
/// at `within`; else `within` the binders member `member` of commutable run `run` writes from where
/// that member starts, which the member's place in the run's order decides.
pub type Spot = { run: Int, member: Int, within: Int }

type Bound = { name: Bytes, spot: Spot }

/// A normalized form with all that hashing it reads besides the node itself left open: what a
/// reference is written as, an effect's slot in its enumeration, a level a commutable run's order
/// decides, and each set whose order the bytes of its members decide. Filling the holes writes
/// the bytes; the walk over the tree, every name resolved, is made once. `Chose` writes nothing:
/// it is what the check found of the call on a value written just before it, as [`Choice`] says.
/// `Pending` writes nothing either: it is that call hashed before its check, as [`Site`] says.
pub type Piece =
  | Raw(Bytes)
  | Ref(Int)
  | Slot(Int)
  | Level(Spot)
  | Fields(List<List<Piece>>)
  | Atoms(List<AtomForm>)
  | Run(RunForm)
  | Chose(Int, List<Int>)
  | Pending(Bytes, List<Bytes>)

/// A row's atom, and the effect declaration's sketch that orders atoms equal in their bytes.
pub type AtomForm = { pieces: List<Piece>, tie: Bytes }

/// A `let` of a commutable run, and how many binders it writes.
pub type RunMember = { pieces: List<Piece>, binders: Int }

/// `let`s that commute, written in the order their encodings at `base` sort in.
pub type RunForm = { id: Int, base: Spot, members: List<RunMember> }

/// Which of the functions a call on a value may be the check found it calls, -1 where none is
/// known or the call names its function in full, and the place among that function's parameters,
/// the value's first, of each argument the call names, in the order written.
pub type Choice = { callee: Int, named: List<Int> }

/// What a check found of a call on a value: the function it calls, by its program-wide name, and
/// where each argument it names goes, as [`Choice`] says.
pub type Called = { callee: Bytes, named: List<Int> }

/// A call on a value as hashing that runs before the check leaves it: where the check files what
/// it found of the call ([`site_key`]), and every function the call may be, by program-wide name,
/// in the order the bytes write them.
pub type Site = { at: Bytes, candidates: List<Bytes> }

/// What a filled form says of a call on a value: the check's choice, or the site it is yet to be
/// read from.
pub type Pick = | Found(Choice) | Waiting(Site)

derive bin for Choice

derive bin for Site

derive bin for Pick

derive bin for Spot

derive bin for Piece

derive bin for AtomForm

derive bin for RunMember

derive bin for RunForm

type Encoder = {
  index: Index,
  module: Int,
  out: List<Piece>,
  values: List<Bound>,
  ty_params: List<Bytes>,
  row_params: List<Bytes>,
  label_params: List<Bytes>,
  /// The member of a commutable run being written, with `within` where its binders start among
  /// `values`; `run` -1 outside every run.
  scope: Spot,
  runs: Int,
  /// What the check found of each call on a value, by `site_key`; `None` where hashing runs
  /// before the check, which leaves each call pending.
  chose: Option<Map<Bytes, Called>>,
}

/// `chosen` is each `Chose` in the order the bytes write it.
type Finished = { bytes: Bytes, refs: List<Int>, chosen: List<Pick> }

fn no_scope() -> Spot = { run: 0 - 1, member: 0, within: 0 }

fn new_encoder(index: Index, module: Int) -> Encoder =
  {
    index: index,
    module: module,
    out: [],
    values: [],
    ty_params: [],
    row_params: [],
    label_params: [],
    scope: no_scope(),
    runs: 0,
    chose: Some(Map::new()),
  }

/// What `encode` writes from a fresh encoder in `module` of `index`, of what no stored body holds:
/// each call on a value found nothing.
fn template_of<| e>(
  index: Index,
  module: Int,
  encode: (Encoder) -> Encoder / e,
) -> List<Piece> / e = compact(encode(new_encoder(index, module)).out)

/// [`template_of`], each call on a value read as calling what `chose` holds at its site.
fn chosen_template<| e>(
  index: Index,
  module: Int,
  chose: Option<Map<Bytes, Called>>,
  encode: (Encoder) -> Encoder / e,
) -> List<Piece> / e = compact(encode({ ..new_encoder(index, module), chose: chose }).out)

/// Adjacent bytes joined, so a form holds as many pieces as it has holes.
fn compact(pieces: List<Piece>) -> List<Piece> = {
  let flushed = |acc: { out: List<Piece>, raw: List<Bytes> }|
    if acc.raw.len() == 0 { acc.out } else { acc.out.push(Raw(Bytes::concat_all(acc.raw))) };
  flushed(
    pieces.fold({ out: [], raw: [] }, |acc: { out: List<Piece>, raw: List<Bytes> }, p: Piece|
      match p {
        Raw(b) -> { ..acc, raw: acc.raw.push(b) },
        _ -> { out: flushed(acc).push(p), raw: [] },
      }),
  )
}

fn put_piece(encoder: Encoder, p: Piece) -> Encoder = { ..encoder, out: encoder.out.push(p) }
fn put_bytes(encoder: Encoder, b: Bytes) -> Encoder = put_piece(encoder, Raw(b))
fn put_tag(encoder: Encoder, t: Int) -> Encoder / {abort.raise} = put_bytes(encoder, byte_of_int(t))
fn put_u32(encoder: Encoder, v: Int) -> Encoder = put_bytes(encoder, u32_le(v))
fn put_bool(encoder: Encoder, b: Bool) -> Encoder / {abort.raise} =
  put_bytes(encoder, byte_of_int(if b { 1 } else { 0 }))
fn put_text(encoder: Encoder, s: Bytes) -> Encoder = put_bytes(put_u32(encoder, s.len()), s)

/// Where the next binder stands: within the member being written, if any.
fn spot_here(encoder: Encoder) -> Spot = {
  let n = encoder.values.len();
  if encoder.scope.run < 0 { { run: 0 - 1, member: 0, within: n } }
  else { { ..encoder.scope, within: n - encoder.scope.within } }
}

fn bind(encoder: Encoder, name: Bytes) -> Encoder =
  { ..encoder, values: encoder.values.push({ name: name, spot: spot_here(encoder) }) }

fn bind_all(encoder: Encoder, names: List<Bytes>) -> Encoder = names.fold(encoder, bind)

/// The binder `name` names, searching from the last bound: its place in `values`.
fn bound_at(values: List<Bound>, name: Bytes) -> Option<Int> / {abort.raise} =
  range(0, values.len()).fold(None, |acc: Option<Int>, i: Int|
    if values.get(i).name == name { Some(i) } else { acc })

/// The level of the binder at `i` of `values`: written now where no run's order moves it.
fn put_level(encoder: Encoder, i: Int) -> Encoder / {abort.raise} = {
  let spot = encoder.values.get(i).spot;
  if spot.run < 0 { put_u32(encoder, spot.within) } else { put_piece(encoder, Level(spot)) }
}

type Captured = { encoder: Encoder, pieces: List<Piece> }

/// The pieces `f` writes, kept apart from the encoding so far.
fn capture<| e>(encoder: Encoder, f: (Encoder) -> Encoder / e) -> Captured / e = {
  let inner: Encoder = f({ ..encoder, out: [] });
  { encoder: { ..inner, out: encoder.out }, pieces: compact(inner.out) }
}

fn normalize_node(encoder: Encoder, body: NodeBody) -> Encoder / {abort.raise} =
  match body {
    NodeFn(d) -> fn_def(encoder, d),
    NodeType(d) -> type_def(encoder, d),
    NodeEffect(d) -> effect_def(encoder, d),
  }

fn node_ref(encoder: Encoder, node: Int) -> Encoder = put_piece(encoder, Ref(node))

// --- Filling a form --------------------------------------------------------------------------

/// What a form's holes are filled from: each referenced node's hash, its class where it shares the
/// component being hashed, each effect's slot in the enumeration the form is written under, and
/// whether a reference is written as the name `names` gives its node instead.
type Filling = {
  hashes: Map<Int, Bytes>,
  component: Map<Int, Int>,
  effects: Map<Int, Int>,
  by_name: Bool,
  names: List<Bytes>,
}

/// Each reference with nothing known: what orders a cycle's members and what a node references.
fn blank() -> Filling =
  { hashes: Map::new(), component: Map::new(), effects: Map::new(), by_name: false, names: [] }

type RunAt = { base: Int, offsets: List<Int> }

/// The bytes so far, and each reference in first-mention order unless a row is holding its
/// mentions back.
type Fill = {
  out: List<Bytes>,
  refs: List<Int>,
  seen: Map<Int, Bool>,
  deferred: Option<List<Int>>,
  runs: Map<Int, RunAt>,
  chosen: List<Pick>,
}

/// `pieces` written as `f` fills them.
fn filled(pieces: List<Piece>, f: Filling) -> Finished / {abort.raise} = {
  let s = fill_all(
    f,
    { out: [], refs: [], seen: Map::new(), deferred: None, runs: Map::new(), chosen: [] },
    pieces,
  );
  { bytes: Bytes::concat_all(s.out), refs: s.refs, chosen: s.chosen }
}

fn fill_all(f: Filling, s: Fill, pieces: List<Piece>) -> Fill / {abort.raise} =
  pieces.fold(s, |acc: Fill, p: Piece| fill(f, acc, p))

fn mention(s: Fill, node: Int) -> Fill =
  match s.deferred {
    Some(held) -> { ..s, deferred: Some(held.push(node)) },
    None -> if s.seen.contains(node) { s }
    else { { ..s, seen: s.seen.insert(node, true), refs: s.refs.push(node) } },
  }

fn level_at(s: Fill, spot: Spot) -> Int / {abort.raise} =
  if spot.run < 0 { spot.within } else {
    match s.runs.get(spot.run) {
      Some(r) -> r.base + r.offsets.get(spot.member) + spot.within,
      None -> panic("a level names a run not written"),
    }
  }

type Written = { fill: Fill, bytes: Bytes }

/// `pieces` written apart, for their bytes to be placed by the caller: what they choose is left
/// for the caller's own writing of them.
fn written(f: Filling, s: Fill, pieces: List<Piece>) -> Written / {abort.raise} = {
  let inner = fill_all(f, { ..s, out: [] }, pieces);
  { fill: { ..inner, out: s.out, chosen: s.chosen }, bytes: Bytes::concat_all(inner.out) }
}

fn fill(f: Filling, s: Fill, p: Piece) -> Fill / {abort.raise} =
  match p {
    Raw(b) -> { ..s, out: s.out.push(b) },
    Ref(v) -> {
      let m = mention(s, v);
      let b = if f.by_name {
        let name = f.names.get(v);
        Bytes::concat_all([byte_of_int(tag_ref_name()), u32_le(name.len()), name])
      } else {
        match f.component.get(v) {
          Some(ix) -> byte_of_int(tag_ref_index()).concat(u32_le(ix)),
          None -> match f.hashes.get(v) {
            Some(h) -> byte_of_int(tag_ref_hash()).concat(h),
            None -> byte_of_int(tag_ref_self()),
          },
        }
      };
      { ..m, out: m.out.push(b) }
    },
    Slot(v) -> { ..s, out: s.out.push(u32_le(match f.effects.get(v) { Some(x) -> x, None -> 0 })) },
    Level(spot) -> { ..s, out: s.out.push(u32_le(level_at(s, spot))) },
    Fields(members) -> {
      let each = members.fold(
        { fill: s, encoded: [] },
        |acc: { fill: Fill, encoded: List<Bytes> }, m: List<Piece>| {
          let w = written(f, acc.fill, m);
          { fill: w.fill, encoded: acc.encoded.push(w.bytes) }
        },
      );
      let sorted = sort_bytes(each.encoded);
      { ..each.fill, out: each.fill.out.push(u32_le(sorted.len())).concat(sorted) }
    },
    Atoms(atoms) -> atoms_filled(f, s, atoms),
    Run(r) -> run_filled(f, s, r),
    Chose(callee, named) -> { ..s, chosen: s.chosen.push(Found({ callee: callee, named: named })) },
    Pending(at, candidates) ->
      { ..s, chosen: s.chosen.push(Waiting({ at: at, candidates: candidates })) },
  }

type AtomEncoding = { bytes: Bytes, tie: Bytes, held: List<Int> }

/// A row is a set: atoms sorted by encoding, then by the effect's declaration, and deduplicated.
/// Every atom is mentioned, including one the dedup drops.
fn atoms_filled(f: Filling, s: Fill, atoms: List<AtomForm>) -> Fill / {abort.raise} = {
  let each = atoms.fold(
    { fill: s, encoded: [] },
    |acc: { fill: Fill, encoded: List<AtomEncoding> }, a: AtomForm| {
      let outer = acc.fill.deferred;
      let w = written(f, { ..acc.fill, deferred: Some([]) }, a.pieces);
      let held = match w.fill.deferred { Some(h) -> h, None -> [] };
      {
        fill: { ..w.fill, deferred: outer },
        encoded: acc.encoded.push({ bytes: w.bytes, tie: a.tie, held: held }),
      }
    },
  );
  let sorted = each.encoded.fold([], |acc: List<AtomEncoding>, x: AtomEncoding|
    insert_atom(acc, x));
  let distinct = range(0, sorted.len()).fold(0, |acc: Int, i: Int|
    if i == 0 || sorted.get(i - 1).bytes != sorted.get(i).bytes { acc + 1 } else { acc });
  range(0, sorted.len()).fold(
    { ..each.fill, out: each.fill.out.push(u32_le(distinct)) },
    |acc: Fill, i: Int| {
      let x = sorted.get(i);
      let mentioned: Fill = x.held.fold(acc, |a: Fill, node: Int| mention(a, node));
      if i > 0 && sorted.get(i - 1).bytes == x.bytes { mentioned }
      else { { ..mentioned, out: mentioned.out.push(x.bytes) } }
    },
  )
}

fn atom_lt(a: AtomEncoding, b: AtomEncoding) -> Bool =
  bytes_lt(a.bytes, b.bytes) || (a.bytes == b.bytes && bytes_lt(a.tie, b.tie))

fn insert_atom(sorted: List<AtomEncoding>, x: AtomEncoding) -> List<AtomEncoding> / {abort.raise} = {
  let n = sorted.len();
  let i = range(0, n).fold(n, |p: Int, j: Int|
    if p < n { p } else if atom_lt(x, sorted.get(j)) { j } else { p });
  sorted.take(i).push(x).concat(range(i, n).map(|j: Int| sorted.get(j)))
}

/// Each member's encoding at the run's base orders the run, ties in source order; each member is
/// then written where that order puts it, after the binders of those before it.
fn run_filled(f: Filling, s: Fill, r: RunForm) -> Fill / {abort.raise} = {
  let base = level_at(s, r.base);
  let n = r.members.len();
  let keyed = range(0, n).fold(
    {
      fill: {
        ..s,
        runs: s.runs.insert(r.id, { base: base, offsets: range(0, n).map(|i: Int| 0) }),
      },
      keys: [],
    },
    |acc: { fill: Fill, keys: List<{ key: Bytes, i: Int }> }, i: Int| {
      let w = written(f, acc.fill, r.members.get(i).pieces);
      { fill: w.fill, keys: acc.keys.push({ key: w.bytes, i: i }) }
    },
  );
  let order = keyed.keys.fold(
    [],
    |acc: List<{ key: Bytes, i: Int }>, x: { key: Bytes, i: Int }| {
      let k = acc.len();
      let i = range(0, k).fold(k, |p: Int, j: Int|
        if p < k { p } else {
          let y = acc.get(j);
          if bytes_lt(x.key, y.key) || (x.key == y.key && x.i < y.i) { j } else { p }
        });
      acc.take(i).push(x).concat(range(i, k).map(|j: Int| acc.get(j)))
    },
  ).map(|x: { key: Bytes, i: Int }| x.i);
  let offsets = order.fold(
    { next: 0, offsets: range(0, n).map(|i: Int| 0) },
    |acc: { next: Int, offsets: List<Int> }, i: Int|
      { next: acc.next + r.members.get(i).binders, offsets: acc.offsets.set(i, acc.next) },
  ).offsets;
  order.fold(
    { ..keyed.fill, runs: keyed.fill.runs.insert(r.id, { base: base, offsets: offsets }) },
    |acc: Fill, i: Int| fill_all(f, acc, r.members.get(i).pieces),
  )
}

fn free_ref(encoder: Encoder, qual: Option<Bytes>, name: Bytes) -> Encoder / {abort.raise} =
  match qual {
    None -> put_text(put_tag(encoder, tag_free()), name),
    Some(m) -> put_text(put_text(put_tag(encoder, tag_free_qualified()), m), name),
  }

fn ctor_bytes(encoder: Encoder, owner: Int, name: Bytes) -> Encoder / {abort.raise} =
  put_text(node_ref(put_tag(encoder, tag_ctor()), owner), name)

/// A local binder wins over everything, and only a bare name can be one.
fn value_ref(encoder: Encoder, qname: QName) -> Encoder / {abort.raise} = {
  let local = if is_bare(qname) { bound_at(encoder.values, qname.name.name) } else { None };
  match local {
    Some(i) -> put_level(put_tag(encoder, tag_local()), i),
    None -> match value_target(encoder.index, encoder.module, qname) {
      Some(t) -> match t {
        FnTarget(node) -> node_ref(encoder, node),
        CtorTarget(c) -> ctor_bytes(encoder, c.owner, c.name),
      },
      // A function of a language type that no module declares is the prelude's, under the one
      // name it has however it is written.
      None -> {
        let builtin = written_code().builtins.contains(qname.name.name);
        match qualifier(qname) {
          Some(of) -> if starts_upper(of)
              && encoder.index.scopes.get(encoder.module).modules.get(of) == None {
            written_block(free_ref(encoder, None, member_name(of, qname.name.name)), false)
          } else { written_block(free_ref(encoder, Some(of), qname.name.name), builtin) },
          None -> written_block(free_ref(encoder, None, qname.name.name), builtin),
        }
      },
    },
  }
}

/// The code the emitter writes for a container a body compares, digests or shows, as `==` of two
/// lists walks them with `List::at` and of two maps walks their entries with `Map::entries`: the
/// operators a body writes it for, by name and as the lexer names their tokens, the builtins, and
/// the functions of [`prelude_module`] it calls, by their names there. A body that writes one of
/// those references each of these, so a load that reaches the body reaches them, and a check
/// groups them with it where they reach it back.
pub type WrittenCode = {
  operators: List<Bytes>,
  tokens: List<Bytes>,
  builtins: List<Bytes>,
  calls: List<Bytes>,
}

pub fn written_code() -> WrittenCode =
  {
    operators: [b"eq", b"ne"],
    tokens: [b"eqeq", b"bangeq"],
    builtins: [b"compare", b"compare_values", b"digest", b"reflect", b"shown"],
    calls: [b"List::at", b"List::push", b"Map::entries"],
  }

/// `encoder` past a binary operator or a value named by its name alone, `at` where the emitter
/// writes code for a container there (`written_code`): what that code calls, which the body
/// references with it, under `tag_written`, and none of it elsewhere.
fn written_block(encoder: Encoder, at: Bool) -> Encoder / {abort.raise} = {
  let called = if at { encoder.index.written } else { [] };
  called.fold(put_u32(put_tag(encoder, tag_written()), called.len()), node_ref)
}

fn type_ref(encoder: Encoder, qual: Option<Bytes>, name: Bytes) -> Encoder / {abort.raise} = {
  let param = match qual { None -> rposition(encoder.ty_params, name), Some(_) -> None };
  match param {
    Some(level) -> put_u32(put_tag(encoder, tag_ty_param()), level),
    None -> match type_target(encoder.index, encoder.module, qual, name) {
      Some(node) -> node_ref(encoder, node),
      None -> free_ref(encoder, qual, name),
    },
  }
}

/// Effects are nominal: the declaration referenced, then the slot the component's enumeration gave
/// it. What makes that true is the simple name in the declaration's own encoding; its module path is
/// not, so two modules declaring one effect alike declare one effect.
fn effect_ref(encoder: Encoder, qname: QName) -> Encoder / {abort.raise} =
  match effect_target(encoder.index, encoder.module, qname) {
    Some(node) -> put_piece(node_ref(encoder, node), Slot(node)),
    None -> free_ref(encoder, qualifier(qname), qname.name.name),
  }

fn ctor_ref(encoder: Encoder, qname: QName) -> Encoder / {abort.raise} =
  match ctor_target(encoder.index, encoder.module, qname) {
    Some(CtorTarget(c)) -> ctor_bytes(encoder, c.owner, c.name),
    _ -> free_ref(encoder, qualifier(qname), qname.name.name),
  }

/// A resource the signature binds is a level, so renaming the binder is not an edit; a real one stays a name.
fn label_ref(encoder: Encoder, ident: Ident) -> Encoder / {abort.raise} =
  match rposition(encoder.label_params, ident.name) {
    Some(level) -> put_u32(put_tag(encoder, tag_label_param()), level),
    None -> put_text(put_tag(encoder, tag_free()), ident.name),
  }

fn opt_type(encoder: Encoder, ty: Option<TypeExpr>) -> Encoder / {abort.raise} =
  match ty {
    None -> put_tag(encoder, tag_none()),
    Some(te) -> type_expr(put_tag(encoder, tag_some()), te),
  }
fn opt_row(encoder: Encoder, r: Option<RowExpr>) -> Encoder / {abort.raise} =
  match r {
    None -> put_tag(encoder, tag_none()),
    Some(row) -> row_expr(put_tag(encoder, tag_some()), row),
  }
fn opt_expr(encoder: Encoder, e: Option<Expr>) -> Encoder / {abort.raise} =
  match e { None -> put_tag(encoder, tag_none()), Some(x) -> expr(put_tag(encoder, tag_some()), x) }
/// A `[*]` clause is not the clause that names no label, so the wildcard is spelled out rather
/// than shared with the empty case. A `[*t]` clause is not a `[*]` one either: naming the label is
/// what the body reads, so the binder is part of what the clause is.
fn clause_label(clause: HandleClause) -> Option<Ident> =
  match clause.label_binder {
    Some(t) -> Some({ name: b"*".concat(t.name), span: clause.span }),
    None -> if clause.every_label { Some({ name: b"*", span: clause.span }) }
    else { clause.resource },
  }

fn opt_label(encoder: Encoder, i: Option<Ident>) -> Encoder / {abort.raise} =
  match i {
    None -> put_tag(encoder, tag_none()),
    Some(x) -> label_ref(put_tag(encoder, tag_some()), x),
  }

fn push_generics(encoder: Encoder, def: FnDef) -> Encoder =
  {
    ..encoder,
    ty_params: encoder.ty_params.concat(def.generics.types.map(|ident: Ident| ident.name)),
    row_params: encoder.row_params.concat(def.generics.effects.map(|ident: Ident| ident.name)),
    label_params: encoder.label_params.concat(def.generics.labels.map(|ident: Ident| ident.name)),
  }

fn fn_def(encoder: Encoder, def: FnDef) -> Encoder / {abort.raise} = {
  let generic: Encoder = push_generics(
    put_u32(
      put_u32(
        put_u32(put_tag(encoder, tag_fn()), def.generics.types.len()),
        def.generics.effects.len(),
      ),
      def.generics.labels.len(),
    ),
    def,
  );
  // Before the parameter names reach `values`: a default is closed.
  let with_params: Encoder = def.params.fold(
    put_u32(generic, def.params.len()),
    |acc: Encoder, param: Param| {
      let kept = if param.keep { put_tag(acc, tag_param_kept()) } else { acc };
      let spaced = if param.space != None { put_tag(kept, tag_param_spaced()) } else { kept };
      match param.default {
        Some(dflt) -> expr(opt_type(put_tag(spaced, tag_param_default()), param.ty), dflt),
        None -> opt_type(spaced, param.ty),
      }
    },
  );
  let signature: Encoder = returns(
    constraints(opt_row(opt_type(with_params, def.ret), def.effects), def.constraints),
    def,
  );
  let bound: Encoder = bind_all(signature, def.params.map(|param: Param| param.name.name));
  // A stated measure decides the definition's verdict, so it is part of what was written.
  let measured: Encoder = match def.decreases {
    Some(m) -> expr(put_tag(bound, tag_decreases()), m),
    None -> bound,
  };
  // A `const` publishes no raise its body can make, so its callers read another definition.
  let marked: Encoder = match def.baked {
    Some(_) -> put_tag(measured, tag_const()),
    None -> measured,
  };
  expr(marked, def.body)
}

/// A `returns` clause names a parameter by its position, so renaming one moves nothing.
fn returns(encoder: Encoder, def: FnDef) -> Encoder / {abort.raise} =
  match def.returns {
    None -> encoder,
    Some(ReturnsFresh(_)) -> put_tag(encoder, tag_returns_fresh()),
    Some(ReturnsParam(x)) ->
      put_u32(
        put_tag(encoder, tag_returns_param()),
        range(0, def.params.len()).fold(0, |acc: Int, i: Int|
          if def.params.get(i).name.name == x.name { i } else { acc }),
      ),
  }

/// Sorted and deduplicated: the same two constraints in the other order are one definition.
fn constraints(encoder: Encoder, cs: List<Constraint>) -> Encoder / {abort.raise} = {
  let levels = cs.fold([], |acc: List<{ level: Int, deriver: Int }>, c: Constraint|
    match rposition(encoder.ty_params, c.param.name) {
      Some(level) -> acc.push({ level: level, deriver: deriver_byte(c.deriver) }),
      None -> acc,
    });
  let sorted = levels.fold(
    [],
    |acc: List<{ level: Int, deriver: Int }>, x: { level: Int, deriver: Int }| insert_pair(acc, x),
  );
  sorted.fold(put_u32(encoder, sorted.len()), |acc: Encoder, x: { level: Int, deriver: Int }|
    put_tag(put_u32(put_tag(acc, tag_constraint()), x.level), x.deriver))
}

fn insert_pair(
  sorted: List<{ level: Int, deriver: Int }>,
  x: { level: Int, deriver: Int },
) -> List<{ level: Int, deriver: Int }> / {abort.raise} = {
  let dup = sorted.fold(false, |b: Bool, y: { level: Int, deriver: Int }|
    b || (y.level == x.level && y.deriver == x.deriver));
  if dup { sorted } else {
    let n = sorted.len();
    let i = range(0, n).fold(n, |acc: Int, j: Int|
      if acc < n { acc } else {
        let y = sorted.get(j);
        if x.level < y.level || (x.level == y.level && x.deriver < y.deriver) { j } else { acc }
      });
    sorted.take(i).push(x).concat(range(i, n).map(|j: Int| sorted.get(j)))
  }
}

/// A sum and a `new` record are nominal and an alias is transparent, exactly as the checker has
/// them: `conv_type` gives a sum a `TyCon` and a `new` record a `TyNominal` under its name, which
/// `unify_structural` compares by name, and expands an alias in place, so two aliases of one
/// expansion are one type there and must be one type here. The name is the simple one: a module
/// path is no part of an identity, so vendoring a module moves nothing.
fn type_def(encoder: Encoder, d: TypeDef) -> Encoder / {abort.raise} = {
  let g = d.generics;
  // Only a declaration that binds a row or a label writes their counts, under a tag of its own.
  let over = g.effects.len() > 0 || g.labels.len() > 0;
  let tagged: Encoder = put_u32(
    put_tag(encoder, if over { tag_type_over() } else { tag_type() }),
    g.types.len(),
  );
  let headed: Encoder = if over { put_u32(put_u32(tagged, g.effects.len()), g.labels.len()) }
  else { tagged };
  let counted: Encoder = {
    ..headed,
    ty_params: headed.ty_params.concat(g.types.map(|ident: Ident| ident.name)),
    row_params: headed.row_params.concat(g.effects.map(|ident: Ident| ident.name)),
    label_params: headed.label_params.concat(g.labels.map(|ident: Ident| ident.name)),
  };
  let declared: Encoder = match d.body {
    TDAlias(t) -> type_expr(put_tag(counted, tag_type_alias()), t),
    TDSum(variants) ->
      variants.fold(
        put_u32(put_text(put_tag(counted, tag_type_sum()), d.name.name), variants.len()),
        |acc: Encoder, variant: VariantDef|
          variant.fields.fold(
            put_u32(put_text(put_tag(acc, tag_variant()), variant.name.name), variant.fields.len()),
            |a: Encoder, ty: TypeExpr| type_expr(a, ty),
          ),
      ),
    TDNominal(t) -> type_expr(put_text(put_tag(counted, tag_type_nominal()), d.name.name), t),
    TDExtern -> put_text(put_tag(counted, tag_type_extern()), d.name.name),
  };
  // Unlike `pub`, `opaque` refuses bodies that name nothing of the type's: a literal where a
  // closed record is expected. Only the type's own hash reaches each of them.
  let closed: Encoder = match d.opaque {
    Some(_) -> put_tag(declared, tag_opaque()),
    None -> declared,
  };
  // What a value of the type compares and shows through is part of what the type is: each function
  // is a reference, so the type's hash moves when the function it names does.
  let stated: Encoder = match closed.index.items.get(closed.module).instances.get(d.name.name) {
    None -> closed,
    Some(stated) ->
      stated.fold(closed, |acc: Encoder, x: InstanceDef|
        value_ref(put_tag(acc, match x.kind { NKey -> tag_key(), _ -> tag_show() }), {
          module: None,
          name: x.by,
          span: x.by.span,
        })),
  };
  // In the operations' own order, so the order a module wrote them in moves nothing.
  match stated.index.items.get(stated.module).numerics.get(d.name.name) {
    None -> stated,
    Some(numeric) ->
      numeric_ops().fold(stated, |acc: Encoder, op: Bytes|
        match numeric_by(numeric, op) {
          None -> acc,
          Some(by) ->
            value_ref(put_text(put_tag(acc, tag_numeric()), op), {
              module: None,
              name: by,
              span: by.span,
            }),
        }),
  }
}

/// Operations are looked up by name, so their declaration order is sorted away.
/// An effect is nominal: it is the declaration this name declares, not a shape another declaration
/// could match. Two effects differing only in their names are two effects, so the name is encoded —
/// a published row names its atoms' effects, and nothing else would make a hash pin those names.
/// The name is the simple one: a module path is no part of an identity here, so the same declaration
/// vendored under another path is still that declaration.
fn effect_def(encoder: Encoder, d: EffectDef) -> Encoder / {abort.raise} = {
  let header: Encoder = put_bool(
    put_text(put_tag(encoder, tag_effect()), d.name.name),
    d.is_nondet,
  );
  let ops = d.ops.fold(
    { encoder: header, encoded: [] },
    |acc: { encoder: Encoder, encoded: List<List<Piece>> }, op: OpDef| {
      let captured: Captured = capture(acc.encoder, |x: Encoder| op_def(x, op));
      { encoder: captured.encoder, encoded: acc.encoded.push(captured.pieces) }
    },
  );
  put_piece(ops.encoder, Fields(ops.encoded))
}

fn bytes_lt(a: Bytes, b: Bytes) -> Bool = match compare_values(a, b) { Less -> true, _ -> false }

pub fn sort_bytes(xs: List<Bytes>) -> List<Bytes> / {abort.raise} =
  xs.fold([], |acc: List<Bytes>, x: Bytes| {
    let n = acc.len();
    let i = range(0, n).fold(n, |p: Int, j: Int|
      if p < n { p } else if bytes_lt(x, acc.get(j)) { j } else { p });
    acc.take(i).push(x).concat(range(i, n).map(|j: Int| acc.get(j)))
  })

/// An effect's operations share one encoder, so each one's type parameters go out of scope after it.
fn op_def(encoder: Encoder, op: OpDef) -> Encoder / {abort.raise} = {
  let header: Encoder = put_u32(
    put_bool(
      put_bytes(
        put_text(put_tag(encoder, tag_op()), op.name.name),
        byte_of_int(mode_byte(op.mode)),
      ),
      op.resource_param,
    ),
    op.ty_params.len(),
  );
  let bound: Encoder = {
    ..header,
    ty_params: header.ty_params.concat(op.ty_params.map(|p: Ident| p.name)),
  };
  let encoded: Encoder = type_expr(
    op.params.fold(put_u32(bound, op.params.len()), |acc: Encoder, p: TypeExpr| type_expr(acc, p)),
    op.ret,
  );
  { ..encoded, ty_params: encoder.ty_params }
}

/// A test over cases hashes as what one case runs: the case's type and the body over it. Its table
/// and its label are no part of that, so a case added to the table moves no other case's hash.
pub fn test_def(encoder: Encoder, d: TestDef) -> Encoder / {abort.raise} = {
  let headed: Encoder = put_bool(put_tag(encoder, tag_test()), d.is_nondet);
  match d.cases {
    None -> expr(headed, d.body),
    Some(c) -> {
      let typed: Encoder = type_expr(put_tag(headed, tag_cases()), c.ty);
      let inner: Encoder = expr(bind(typed, c.binder.name), d.body);
      { ..inner, values: typed.values }
    },
  }
}

/// What a test over cases references besides what its hash is taken over: what its two roots
/// run, its table and its label among it.
fn listed_refs(index: Index, t: TestNode) -> List<Int> / {abort.raise} =
  match t.def.cases {
    None -> [],
    Some(c) ->
      refs_of(index, t.module, |encoder: Encoder| {
        let listed: Encoder = expr(encoder, test_listing(c));
        expr(bind_all(listed, case_params()), test_run(t.def))
      }),
  }

/// A law's binder types are part of its identity; their names are levels like any other binder.
pub fn law_def(encoder: Encoder, d: LawDef) -> Encoder / {abort.raise} = {
  let typed: Encoder = d.binders.fold(
    put_u32(put_tag(encoder, tag_law()), d.binders.len()),
    |acc: Encoder, binder: Binder| type_expr(acc, binder.ty),
  );
  let bound: Encoder = bind_all(typed, d.binders.map(|binder: Binder| binder.name.name));
  expr(opt_expr(bound, d.guard), d.body)
}

/// In its owner's scope: generics, parameters, `result` for an `ensures`, cost names for a `cost` and
/// space names for a `space`. Parameter defaults are not written.
pub fn spec_clause(encoder: Encoder, owner: FnDef, clause: SpecClause) -> Encoder / {abort.raise} = {
  let generic: Encoder = push_generics(
    put_u32(
      put_u32(
        put_u32(
          put_bytes(put_tag(encoder, tag_spec()), byte_of_int(spec_tag(clause.kind))),
          owner.generics.types.len(),
        ),
        owner.generics.effects.len(),
      ),
      owner.generics.labels.len(),
    ),
    owner,
  );
  let counted: Encoder = put_u32(generic, owner.params.len());
  let bound: Encoder = bind_all(counted, owner.params.map(|param: Param| param.name.name));
  let in_scope: Encoder = match clause.kind {
    SEnsures -> bind(bound, b"result"),
    SRequires -> bound,
    // Written only where a parameter names its space, so a clause over none hashes as it always has.
    SSpace -> {
      let named = owner.params.map(|param: Param| param.space);
      if !named.any(|s: Option<Ident>| s != None) { bound } else { names_bound(bound, named) }
    },
    SCost -> names_bound(bound, owner.params.map(|param: Param| param.cost)),
  };
  expr(in_scope, clause.expr)
}

/// Each name after the parameters, with the parameter it names the cost or space of.
fn names_bound(bound: Encoder, named: List<Option<Ident>>) -> Encoder / {abort.raise} = {
  let at = range(0, named.len()).filter(|i: Int| named.get(i) != None);
  at.fold(put_u32(bound, at.len()), |e: Encoder, i: Int|
    match named.get(i) { Some(k) -> bind(put_u32(e, i), k.name), None -> e })
}

fn type_expr(encoder: Encoder, t: TypeExpr) -> Encoder / {abort.raise} =
  match t {
    TVar(name) -> put_u32(type_ref(put_tag(encoder, tag_ty_con()), None, name.name), 0),
    TCon(c) -> {
      // Only a use that fills a label or a row writes them, under a tag of its own.
      let over = c.labels.len() > 0 || c.rows.len() > 0;
      let applied: Encoder = c.args.fold(
        put_u32(
          type_ref(
            put_tag(encoder, if over { tag_ty_con_over() } else { tag_ty_con() }),
            qualifier(c.name),
            c.name.name.name,
          ),
          c.args.len(),
        ),
        |acc: Encoder, a: TypeExpr| type_expr(acc, a),
      );
      if !over { applied } else {
        c.rows.fold(
          put_u32(c.labels.fold(put_u32(applied, c.labels.len()), label_ref), c.rows.len()),
          row_expr,
        )
      }
    },
    TFn(f) ->
      opt_row(
        type_expr(
          f.params.fold(
            put_u32(put_tag(encoder, tag_ty_fn()), f.params.len()),
            |acc: Encoder, p: TypeExpr| type_expr(acc, p),
          ),
          f.ret,
        ),
        f.effects,
      ),
    // A record type is a map from label to type, so field order is sorted away.
    TRecord(r) -> {
      let fields = r.fields.fold(
        { encoder: put_tag(encoder, tag_ty_record()), encoded: [] },
        |acc: { encoder: Encoder, encoded: List<List<Piece>> }, f: { name: Ident, ty: TypeExpr }| {
          let captured: Captured = capture(acc.encoder, |x: Encoder|
            type_expr(put_text(x, f.name.name), f.ty));
          { encoder: captured.encoder, encoded: acc.encoded.push(captured.pieces) }
        },
      );
      put_piece(fields.encoder, Fields(fields.encoded))
    },
    TUnit(_) -> put_tag(encoder, tag_ty_unit()),
    TBad(_) -> put_tag(encoder, tag_ty_unit()),
  }

/// A row is a set, its atoms ordered and deduplicated as they are filled.
fn row_expr(encoder: Encoder, row: RowExpr) -> Encoder / {abort.raise} = {
  let tagged: Encoder = put_tag(encoder, tag_row());
  let atoms = row.atoms.fold(
    { encoder: tagged, atoms: [] },
    |acc: { encoder: Encoder, atoms: List<AtomForm> }, a: AtomExpr| {
      let captured: Captured = capture(acc.encoder, |x: Encoder| atom(x, a));
      let tie = match effect_target(acc.encoder.index, acc.encoder.module, a.eff) {
        Some(node) -> match acc.encoder.index.effect_sketches.get(node) {
          Some(s) -> s,
          None -> b"",
        },
        None -> b"",
      };
      { encoder: captured.encoder, atoms: acc.atoms.push({ pieces: captured.pieces, tie: tie }) }
    },
  );
  let written: Encoder = put_piece(atoms.encoder, Atoms(atoms.atoms));
  let tailed: Encoder = match row.tail {
    None -> put_tag(written, tag_none()),
    Some(t) -> match rposition(written.row_params, t.name) {
      Some(level) -> put_u32(put_tag(put_tag(written, tag_some()), tag_row_param()), level),
      None -> put_text(put_tag(put_tag(written, tag_some()), tag_free()), t.name),
    },
  };
  if row.tail_bounded { put_tag(tailed, tag_bounded()) } else { tailed }
}

fn atom(encoder: Encoder, a: AtomExpr) -> Encoder / {abort.raise} = {
  let named: Encoder = match a.op {
    None ->
      opt_label(
        put_bytes(effect_ref(put_tag(encoder, tag_atom()), a.eff), byte_of_int(mode_byte(a.mode))),
        atom_label(a),
      ),
    Some(op) ->
      opt_label(
        put_text(effect_ref(put_tag(encoder, tag_atom_op()), a.eff), op.name),
        atom_label(a),
      ),
  };
  if a.bounded { put_tag(named, tag_bounded()) } else { named }
}

/// `[*]` is not the absence of a label, so the wildcard is spelled out and hashes apart from it.
fn atom_label(atom: AtomExpr) -> Option<Ident> =
  if atom.every { Some({ name: b"*", span: atom.span }) } else { atom.resource }

/// What a call on a value written `.name(..)` at `at` may call: `m::f` where it names its function
/// in full, and otherwise every function `X::name` of a module its own can see, in the order of
/// their program-wide names. Which of them it is the value's type says, which no hash reads: the
/// check's choice follows, written as nothing. `names` is whether the call names an argument.
fn on_value(encoder: Encoder, at: Span, name: Ident, names: Bool) -> Encoder / {abort.raise} = {
  let site = site_key(encoder.module, at);
  let chosen = |c: Choice| Chose(c.callee, c.named);
  // With no function to choose and no argument to place, the check has nothing to say.
  let picked = |candidates: List<Bytes>|
    match encoder.chose {
      Some(chose) -> chosen(choice_of(chose.get(site), candidates)),
      None -> if candidates.len() == 0 && !names { chosen(choice_of(None, [])) }
      else { Pending(site, candidates) },
    };
  match member_of(name.name) {
    Some(of) ->
      put_piece(
        value_ref(put_tag(put_u32(encoder, 1), tag_e_var()), {
          module: Some({ name: of.of, span: name.span }),
          name: { name: of.member, span: name.span },
          span: name.span,
        }),
        picked([]),
      ),
    None -> {
      let index = encoder.index;
      let found = index.scopes.get(encoder.module).sees.fold(
        [],
        |acc: List<Int>, k: Int|
          match index.items.get(k).members.get(name.name) {
            Some(nodes) -> acc.concat(nodes),
            None -> acc,
          },
      ).sort_by(|a: Int, b: Int|
        match compare_values(index.nodes.get(a).name, index.nodes.get(b).name) {
          Greater -> false,
          _ -> true,
        });
      put_piece(
        found.fold(put_u32(put_u32(encoder, 0), found.len()), node_ref),
        picked(found.map(|v: Int| index.nodes.get(v).name)),
      )
    },
  }
}

/// Where a check files what it found of a call on a value: the call's module and span.
pub fn site_key(module: Int, at: Span) -> Bytes = u32_le(module).concat(span_key(at))

/// What a check found of each call on a value `sites` record, by `site_key`, each function by its
/// program-wide name, as a call's candidates name it. A call of a function a record holds in a
/// field calls none of a type's.
pub fn called_at(sites: List<MemberSite>) -> Map<Bytes, Called> =
  sites.fold(Map::new(), |acc: Map<Bytes, Called>, x: MemberSite|
    if x.callee == b"" { acc } else {
      acc.insert(site_key(x.module, x.span), {
        // The check names a function the prelude binds by its bare name.
        callee: if x.qualifier == prelude_binder() { qualify(prelude_module(), x.callee) }
        else { x.callee },
        named: x.named,
      })
    })

/// `called`, what a check found of a call on a value, as a choice among `candidates`: none where
/// it found nothing or calls a function none of them is.
fn choice_of(called: Option<Called>, candidates: List<Bytes>) -> Choice / {abort.raise} =
  match called {
    None -> { callee: 0 - 1, named: [] },
    Some(c) ->
      {
        callee: range(0, candidates.len()).fold(0 - 1, |acc: Int, i: Int|
          if acc < 0 && candidates.get(i) == c.callee { i } else { acc }),
        named: c.named,
      },
  }

/// What follows the value and the name in the form of `value.name[labels](args, named)`: the
/// labels, the arguments, those given by name, and every function the call may be.
fn called_on(
  encoder: Encoder,
  at: Span,
  name: Ident,
  labels: List<Ident>,
  args: List<Expr>,
  named: List<NamedArg>,
) -> Encoder / {abort.raise} = {
  let labelled: Encoder = labels.fold(put_u32(encoder, labels.len()), label_ref);
  let passed: Encoder = args.fold(put_u32(labelled, args.len()), |acc: Encoder, x: Expr|
    expr(acc, x));
  on_value(
    named.fold(put_u32(passed, named.len()), |acc: Encoder, n: NamedArg|
      expr(put_text(acc, n.name.name), n.value)),
    at,
    name,
    named.len() > 0,
  )
}

fn expr(encoder: Encoder, e: Expr) -> Encoder / {abort.raise} =
  match e {
    // `{ e }` and `e` are the same computation.
    EBlock(b) -> if b.stmts.len() == 0 {
      match b.tail { Some(t) -> expr(encoder, t), None -> block(encoder, b.stmts, b.tail) }
    } else { block(encoder, b.stmts, b.tail) },
    ELit(l) -> lit(put_tag(encoder, tag_e_lit()), l.lit),
    EVar(v) -> value_ref(put_tag(encoder, tag_e_var()), v.name),
    EBinary(b) ->
      written_block(
        expr(
          expr(put_bytes(put_tag(encoder, tag_e_binary()), byte_of_int(binop_byte(b.op))), b.lhs),
          b.rhs,
        ),
        written_code().operators.contains(b.op),
      ),
    EUnary(u) ->
      expr(put_bytes(put_tag(encoder, tag_e_unary()), byte_of_int(unop_byte(u.op))), u.operand),
    ELambda(l) -> {
      let typed: Encoder = l.params.fold(
        put_u32(put_tag(encoder, tag_e_lambda()), l.params.len()),
        |acc: Encoder, p: Param| opt_type(acc, p.ty),
      );
      let inner: Encoder = expr(bind_all(typed, l.params.map(|p: Param| p.name.name)), l.body);
      { ..inner, values: typed.values }
    },
    EApp(a) -> match a.func {
      // A call on a value: its named arguments are the call's to fill, and its callee the
      // value's type's to say, so every function it may be is part of what the call is.
      EField(f) ->
        called_on(
          put_text(expr(put_tag(encoder, tag_e_on_value()), f.base), f.field.name),
          a.span,
          f.field,
          a.labels,
          a.args,
          a.named,
        ),
      _ -> {
        let called: Encoder = a.args.fold(
          put_u32(expr(put_tag(encoder, tag_e_app()), a.func), a.args.len()),
          |acc: Encoder, x: Expr| expr(acc, x),
        );
        a.labels.fold(put_u32(called, a.labels.len()), label_ref)
      },
    },
    EIf(i) -> expr(expr(expr(put_tag(encoder, tag_e_if()), i.cond), i.then_branch), i.else_branch),
    EMatch(m) ->
      m.arms.fold(
        put_u32(expr(put_tag(encoder, tag_e_match()), m.scrutinee), m.arms.len()),
        |acc: Encoder, arm: MatchArm| {
          let inner: Encoder = expr(
            opt_expr(pattern(put_tag(acc, tag_arm()), arm.pat), arm.guard),
            arm.body,
          );
          { ..inner, values: acc.values }
        },
      ),
    ERecord(r) ->
      r.fields.fold(
        put_u32(put_tag(encoder, tag_e_record()), r.fields.len()),
        |acc: Encoder, f: RecField| expr(put_text(acc, f.name.name), f.value),
      ),
    // The update is the definition, not the literal it expands to: its meaning follows the base's type.
    ERecordUpdate(r) ->
      r.fields.fold(
        put_u32(expr(put_tag(encoder, tag_e_record_update()), r.base), r.fields.len()),
        |acc: Encoder, f: RecField| expr(put_text(acc, f.name.name), f.value),
      ),
    ETry(_) -> panic("`e?` is expanded away before hashing"),
    EField(f) -> put_text(expr(put_tag(encoder, tag_e_field()), f.base), f.field.name),
    EList(l) ->
      l.items.fold(
        put_u32(put_tag(encoder, tag_e_list()), l.items.len()),
        |acc: Encoder, x: Expr| expr(acc, x),
      ),
    EPerform(p) -> match if is_bare(p.eff) { bound_at(encoder.values, p.eff.name.name) }
      else { None } {
      None ->
        p.args.fold(
          put_u32(
            opt_label(
              put_text(effect_ref(put_tag(encoder, tag_e_perform()), p.eff), p.op.name),
              p.resource,
            ),
            p.args.len(),
          ),
          |acc: Encoder, x: Expr| expr(acc, x),
        ),
      // On a binding it is a call on the value the binding holds.
      Some(i) ->
        called_on(
          put_text(
            put_level(
              put_tag(put_tag(put_tag(encoder, tag_e_on_value()), tag_e_var()), tag_local()),
              i,
            ),
            p.op.name,
          ),
          p.span,
          p.op,
          match p.resource { Some(r) -> [r], None -> [] },
          p.args,
          [],
        ),
    },
    EHandle(h) -> if h.vars.len() == 0 {
      handled(expr(put_tag(encoder, tag_e_handle()), h.body), h.clauses, h.ret)
    } else {
      // The first values are read where the `handle` stands, before its body, each seeing the
      // variables above it; the clauses and the `return` see the variables, the body does not.
      let inits: Encoder = h.vars.fold(
        put_u32(put_tag(encoder, tag_e_handle_vars()), h.vars.len()),
        |acc: Encoder, v: HandlerVar| bind(expr(opt_type(acc, v.ty), v.init), v.name.name),
      );
      let held: Encoder = bind_all(
        expr({ ..inits, values: encoder.values }, h.body),
        h.vars.map(|v: HandlerVar| v.name.name),
      );
      { ..handled(held, h.clauses, h.ret), values: encoder.values }
    },
    EWithHold(c) -> {
      let head: Encoder = expr(
        expr(put_text(put_tag(encoder, tag_e_with_hold()), c.resource.name), c.acquire),
        c.release,
      );
      let inner: Encoder = expr(bind(head, c.binder.name), c.body);
      { ..inner, values: head.values }
    },
    ESimulate(s) -> expr(put_tag(encoder, tag_e_simulate()), s.body),
    EParallel(v) ->
      v.branches.fold(
        put_u32(put_tag(encoder, tag_e_parallel()), v.branches.len()),
        |acc: Encoder, x: Expr| expr(acc, x),
      ),
    // Apart from the call it stands for, which has another type and another row.
    ETagged(t) -> if t.holes.len() == 0 {
      lit(value_ref(put_tag(encoder, tag_e_tagged()), tagged_parser(t)), LStr(t.text))
    } else {
      let named: Encoder = value_ref(
        value_ref(put_tag(encoder, tag_e_filled()), tagged_parser(t)),
        tagged_filler(t),
      );
      t.holes.fold(lit(put_u32(named, t.holes.len()), LStr(t.text)), |acc: Encoder, h: Hole|
        lit(expr(acc, h.value), LStr(h.text)))
    },
    EBad(_) -> panic("a placeholder reached the hasher"),
    // A `try` that names no raise answers the one its body's row names, which the body settles.
    ETryBlock(t) -> {
      let tagged: Encoder = put_tag(encoder, tag_e_try_block());
      let named: Encoder = match t.raise {
        None -> put_tag(tagged, tag_none()),
        Some(r) -> put_text(effect_ref(put_tag(tagged, tag_some()), r.eff), r.op.name),
      };
      expr(named, t.body)
    },
  }

fn block(encoder: Encoder, stmts: List<Stmt>, tail: Option<Expr>) -> Encoder / {abort.raise} = {
  let head: Encoder = put_u32(put_tag(encoder, tag_e_block()), stmts.len());
  let tailed: Encoder = opt_expr(stmts_in_order(head, stmts), tail);
  { ..tailed, values: head.values }
}

/// Each statement in turn, consecutive `let`s that commute in the order their own encodings sort
/// in. A run is ordered where it stands, after the statements before it are written, so what it
/// reads of an earlier `let` of its block is that binder's level and never its name.
fn stmts_in_order(encoder: Encoder, stmts: List<Stmt>) -> Encoder / {abort.raise} = {
  let n = stmts.len();
  iterate({ encoder: encoder, i: 0 }, n + 2, |s: { encoder: Encoder, i: Int }|
    if s.i >= n { Stop(s) } else {
      let run = commutable_run(stmts, s.i);
      if run < 2 { Continue({ encoder: stmt(s.encoder, stmts.get(s.i)), i: s.i + 1 }) }
      else { Continue({ encoder: sorted_run(s.encoder, stmts, s.i, s.i + run), i: s.i + run }) }
    }).encoder
}

/// The members of the run, each written from where the run starts: filling orders them by those
/// encodings, ties in source order, and writes each after the binders of those it puts first.
fn sorted_run(encoder: Encoder, stmts: List<Stmt>, from: Int, to: Int) -> Encoder / {abort.raise} = {
  let id = encoder.runs;
  let n = encoder.values.len();
  let members = range(from, to).fold(
    { encoder: { ..encoder, runs: id + 1 }, members: [], bound: [] },
    |acc: { encoder: Encoder, members: List<RunMember>, bound: List<Bound> }, i: Int| {
      let inner: Encoder = stmt(
        {
          ..acc.encoder,
          out: [],
          values: encoder.values,
          scope: { run: id, member: i - from, within: n },
        },
        stmts.get(i),
      );
      let binders = range(n, inner.values.len()).map(|k: Int| inner.values.get(k));
      {
        encoder: { ..inner, out: acc.encoder.out, values: encoder.values, scope: encoder.scope },
        members: acc.members.push({ pieces: compact(inner.out), binders: binders.len() }),
        bound: acc.bound.concat(binders),
      }
    },
  );
  {
    ..put_piece(members.encoder, Run({ id: id, base: spot_here(encoder), members: members.members })),
    values: encoder.values.concat(members.bound),
  }
}

/// A `handle`'s clauses and `return`, after its body.
fn handled(
  encoder: Encoder,
  clauses: List<HandleClause>,
  ret: Option<ReturnClause>,
) -> Encoder / {abort.raise} = {
  let walked: Encoder = clauses.fold(
    put_u32(encoder, clauses.len()),
    |acc: Encoder, c: HandleClause| {
      let head: Encoder = put_u32(
        opt_label(
          put_text(effect_ref(put_tag(acc, tag_clause()), c.eff), c.op.name),
          clause_label(c),
        ),
        c.params.len(),
      );
      let bound: Encoder = bind_all(head, c.params.map(|p: Ident| p.name));
      // Whether a clause binds a continuation is part of what the definition is.
      let resumed: Encoder = match c.resume {
        None -> put_tag(bound, tag_none()),
        Some(k) -> bind(put_tag(bound, tag_some()), k.name),
      };
      let inner: Encoder = expr(resumed, c.body);
      { ..inner, values: acc.values }
    },
  );
  match ret {
    None -> put_tag(walked, tag_none()),
    Some(rc) -> {
      let head: Encoder = put_tag(put_tag(walked, tag_some()), tag_return_clause());
      let inner: Encoder = expr(bind(head, rc.binder.name), rc.body);
      { ..inner, values: walked.values }
    },
  }
}

fn stmt(encoder: Encoder, s: Stmt) -> Encoder / {abort.raise} =
  match s {
    SLet(l) -> pattern(expr(opt_type(put_tag(encoder, tag_s_let()), l.ty), l.value), l.pat),
    SLetElse(l) ->
      expr(
        pattern(expr(opt_type(put_tag(encoder, tag_s_let_else()), l.ty), l.value), l.pat),
        l.fallback,
      ),
    SExpr(e) -> expr(put_tag(encoder, tag_s_expr()), e),
    SAssign(a) -> expr(value_ref(put_tag(encoder, tag_s_assign()), bare(a.name)), a.value),
  }

fn lit(encoder: Encoder, literal: Lit) -> Encoder / {abort.raise} =
  match literal {
    LInt(i) -> put_bytes(put_tag(encoder, tag_lit_int()), i64_le(i)),
    LFixed(ty, v) ->
      put_bytes(put_bytes(put_tag(encoder, tag_lit_fixed()), width_index(ty)), i64_le(v)),
    LWide(ty, high, low) ->
      put_bytes(
        put_bytes(put_bytes(put_tag(encoder, tag_lit_wide()), width_index(ty)), i64_le(high)),
        i64_le(low),
      ),
    LBool(b) -> put_bool(put_tag(encoder, tag_lit_bool()), b),
    LStr(s) -> put_text(put_tag(encoder, tag_lit_str()), s),
    LBytes(b) -> put_bytes(put_u32(put_tag(encoder, tag_lit_bytes()), b.len()), b),
    LEmbedded(digest, size) ->
      put_text(put_bytes(put_tag(encoder, tag_lit_embedded()), i64_le(size)), digest),
    LFloat(text) -> put_bytes(put_tag(encoder, tag_lit_float()), i64_le(float_bits(text))),
    LDec(text) -> {
      let p = decimal_parts(text);
      put_bytes(put_bytes(put_tag(encoder, tag_lit_decimal()), p.mantissa), u32_le(p.scale))
    },
    LChar(v) -> put_bytes(put_tag(encoder, tag_lit_char()), u32_le(v)),
    LUnit -> put_tag(encoder, tag_lit_unit()),
    LBad -> panic("a placeholder literal reached the hasher"),
  }

fn pattern(encoder: Encoder, p: Pattern) -> Encoder / {abort.raise} = pattern_in(encoder, p, None)

/// `again` is where the binders of an or-pattern's first alternative start, inside a later one: a
/// variable there is that alternative's binder of its name, written by its level, and binds
/// nothing more. So one binder stands for a name whichever alternative matched, and which binder
/// each alternative gives it is part of the form.
fn pattern_in(encoder: Encoder, p: Pattern, again: Option<Int>) -> Encoder / {abort.raise} =
  match p {
    PWild(_) -> put_tag(encoder, tag_p_wildcard()),
    PVar(v) -> {
      let bound = match again {
        None -> None,
        Some(from) -> match bound_at(encoder.values, v.name.name) {
          Some(i) -> if i >= from { Some(i) } else { None },
          None -> None,
        },
      };
      match bound {
        Some(i) -> put_level(put_tag(encoder, tag_p_again()), i),
        None -> bind(put_tag(encoder, tag_p_var()), v.name.name),
      }
    },
    PLit(l) -> lit(put_tag(encoder, tag_p_lit()), l.lit),
    PRange(r) -> lit(lit(put_tag(encoder, tag_p_range()), r.lo), r.hi),
    PCtor(c) ->
      c.args.fold(
        put_u32(ctor_ref(put_tag(encoder, tag_p_ctor()), c.name), c.args.len()),
        |acc: Encoder, a: Pattern| pattern_in(acc, a, again),
      ),
    PRecord(r) ->
      put_bool(
        r.fields.fold(
          put_u32(put_tag(encoder, tag_p_record()), r.fields.len()),
          |acc: Encoder, f: { name: Ident, pat: Pattern }|
            pattern_in(put_text(acc, f.name.name), f.pat, again),
        ),
        r.rest,
      ),
    PList(l) -> {
      let items: Encoder = l.items.fold(
        put_u32(put_tag(encoder, tag_p_list()), l.items.len()),
        |acc: Encoder, i: Pattern| pattern_in(acc, i, again),
      );
      match l.rest {
        None -> put_tag(items, tag_none()),
        Some(rest) -> pattern_in(put_tag(items, tag_some()), rest, again),
      }
    },
    POr(o) -> {
      let head: Encoder = put_u32(put_tag(encoder, tag_p_or()), o.alts.len());
      let later = match again { Some(_) -> again, None -> Some(head.values.len()) };
      range(0, o.alts.len()).fold(head, |acc: Encoder, i: Int|
        pattern_in(acc, o.alts.get(i), if i == 0 { again } else { later }))
    },
    PBad(_) -> panic("a placeholder pattern reached the hasher"),
  }

fn commutable_run(stmts: List<Stmt>, from: Int) -> Int / {abort.raise} = {
  let n = stmts.len();
  let to = iterate(from, n - from + 1, |i: Int|
    if i >= n { Stop(i) } else {
      match stmts.get(i) {
        SLet(l) -> if is_pure(l.value) { Continue(i + 1) } else { Stop(i) },
        _ -> Stop(i),
      }
    });
  if to - from < 2 { 0 } else {
    let run = range(from, to).map(|i: Int| stmts.get(i));
    let counted = run.fold(
      { count: 0, bound: [] },
      |acc: { count: Int, bound: List<Bytes> }, stmt: Stmt|
        match stmt {
          SLet(l) -> {
            let b = pattern_binders(l.pat, acc.bound);
            { count: acc.count + b.count, bound: b.bound }
          },
          _ -> acc,
        },
    );
    if counted.count != counted.bound.len() { 0 }
    else if run.fold(false, |b: Bool, stmt: Stmt|
        b || (match stmt { SLet(l) -> mentions(l.value, counted.bound), _ -> false })) { 0 }
    else { to - from }
  }
}

fn pattern_binders(p: Pattern, out: List<Bytes>) -> { count: Int, bound: List<Bytes> } =
  match p {
    PVar(v) -> { count: 1, bound: out.push_unique(v.name.name) },
    PWild(_) -> { count: 0, bound: out },
    PLit(_) -> { count: 0, bound: out },
    PRange(_) -> { count: 0, bound: out },
    PBad(_) -> { count: 0, bound: out },
    PCtor(c) ->
      c.args.fold(
        { count: 0, bound: out },
        |acc: { count: Int, bound: List<Bytes> }, a: Pattern| {
          let b = pattern_binders(a, acc.bound);
          { count: acc.count + b.count, bound: b.bound }
        },
      ),
    PRecord(r) ->
      r.fields.fold(
        { count: 0, bound: out },
        |acc: { count: Int, bound: List<Bytes> }, f: { name: Ident, pat: Pattern }| {
          let b = pattern_binders(f.pat, acc.bound);
          { count: acc.count + b.count, bound: b.bound }
        },
      ),
    PList(l) -> {
      let items = l.items.fold(
        { count: 0, bound: out },
        |acc: { count: Int, bound: List<Bytes> }, i: Pattern| {
          let b = pattern_binders(i, acc.bound);
          { count: acc.count + b.count, bound: b.bound }
        },
      );
      match l.rest {
        Some(rest) -> {
          let b = pattern_binders(rest, items.bound);
          { count: items.count + b.count, bound: b.bound }
        },
        None -> items,
      }
    },
    // Every alternative binds the same names, which the checker holds them to.
    POr(o) -> match o.alts.at(0) {
      Some(a) -> pattern_binders(a, out),
      None -> { count: 0, bound: out },
    },
  }

pub fn is_pure(e: Expr) -> Bool =
  match e {
    EApp(_) -> false,
    EPerform(_) -> false,
    EHandle(_) -> false,
    EWithHold(_) -> false,
    ESimulate(_) -> false,
    ETryBlock(_) -> false,
    EParallel(v) -> v.branches.fold(true, |acc: Bool, x: Expr| acc && is_pure(x)),
    ETry(_) -> false,
    EBad(_) -> false,
    ELit(_) -> true,
    ETagged(t) -> t.holes.len() == 0,
    EVar(_) -> true,
    EBinary(b) -> is_pure(b.lhs) && is_pure(b.rhs),
    EUnary(u) -> is_pure(u.operand),
    ELambda(l) -> is_pure(l.body),
    EIf(i) -> is_pure(i.cond) && is_pure(i.then_branch) && is_pure(i.else_branch),
    EMatch(m) ->
      is_pure(m.scrutinee)
        && m.arms.fold(true, |acc: Bool, arm: MatchArm|
          acc && is_pure(arm.body) && (match arm.guard { Some(g) -> is_pure(g), None -> true })),
    EBlock(b) ->
      b.stmts.fold(true, |acc: Bool, stmt: Stmt|
          acc
            && (match stmt {
              SLet(l) -> is_pure(l.value),
              SLetElse(l) -> is_pure(l.value) && is_pure(l.fallback),
              SExpr(x) -> is_pure(x),
              SAssign(_) -> false,
            }))
        && (match b.tail { Some(t) -> is_pure(t), None -> true }),
    ERecord(r) -> r.fields.fold(true, |acc: Bool, f: RecField| acc && is_pure(f.value)),
    ERecordUpdate(r) ->
      is_pure(r.base) && r.fields.fold(true, |acc: Bool, f: RecField| acc && is_pure(f.value)),
    EField(f) -> is_pure(f.base),
    EList(l) -> l.items.fold(true, |acc: Bool, x: Expr| acc && is_pure(x)),
  }

/// Deliberately blind to scope: any occurrence of the name counts.
fn mentions(e: Expr, names: List<Bytes>) -> Bool =
  match e {
    ELit(_) -> false,
    ETagged(t) -> t.holes.fold(false, |acc: Bool, h: Hole| acc || mentions(h.value, names)),
    EBad(_) -> false,
    EVar(v) -> is_bare(v.name) && names.contains(v.name.name.name),
    EBinary(b) -> mentions(b.lhs, names) || mentions(b.rhs, names),
    EUnary(u) -> mentions(u.operand, names),
    ELambda(l) ->
      l.params.fold(false, |acc: Bool, p: Param| acc || names.contains(p.name.name))
        || mentions(l.body, names),
    EApp(a) ->
      mentions(a.func, names) || a.args.fold(false, |acc: Bool, x: Expr| acc || mentions(x, names)),
    EIf(i) ->
      mentions(i.cond, names) || mentions(i.then_branch, names) || mentions(i.else_branch, names),
    EMatch(m) ->
      mentions(m.scrutinee, names)
        || m.arms.fold(false, |acc: Bool, a: MatchArm|
          acc || pattern_mentions(a.pat, names)
            || (match a.guard { Some(g) -> mentions(g, names), None -> false })
            || mentions(a.body, names)),
    EBlock(b) ->
      b.stmts.fold(false, |acc: Bool, s: Stmt|
          acc
            || (match s {
              SLet(l) -> pattern_mentions(l.pat, names) || mentions(l.value, names),
              SLetElse(l) ->
                pattern_mentions(l.pat, names) || mentions(l.value, names)
                  || mentions(l.fallback, names),
              SExpr(x) -> mentions(x, names),
              SAssign(x) -> names.contains(x.name.name) || mentions(x.value, names),
            }))
        || (match b.tail { Some(t) -> mentions(t, names), None -> false }),
    ERecord(r) -> r.fields.fold(false, |acc: Bool, f: RecField| acc || mentions(f.value, names)),
    ERecordUpdate(r) ->
      mentions(r.base, names)
        || r.fields.fold(false, |acc: Bool, f: RecField| acc || mentions(f.value, names)),
    EField(f) -> mentions(f.base, names),
    ETry(t) -> mentions(t.operand, names),
    EList(l) -> l.items.fold(false, |acc: Bool, x: Expr| acc || mentions(x, names)),
    EPerform(p) -> p.args.fold(false, |acc: Bool, x: Expr| acc || mentions(x, names)),
    EHandle(h) ->
      h.vars.fold(false, |acc: Bool, v: HandlerVar|
          acc || names.contains(v.name.name) || mentions(v.init, names))
        || mentions(h.body, names)
        || h.clauses.fold(false, |acc: Bool, c: HandleClause|
          acc || c.params.fold(false, |b: Bool, p: Ident| b || names.contains(p.name))
            || mentions(c.body, names))
        || (match h.ret {
          Some(rc) -> names.contains(rc.binder.name) || mentions(rc.body, names),
          None -> false,
        }),
    EWithHold(c) ->
      names.contains(c.binder.name) || mentions(c.acquire, names) || mentions(c.release, names)
        || mentions(c.body, names),
    ESimulate(s) -> mentions(s.body, names),
    ETryBlock(t) -> mentions(t.body, names),
    EParallel(v) -> v.branches.fold(false, |acc: Bool, x: Expr| acc || mentions(x, names)),
  }

fn pattern_mentions(p: Pattern, names: List<Bytes>) -> Bool =
  match p {
    PWild(_) -> false,
    PLit(_) -> false,
    PRange(_) -> false,
    PBad(_) -> false,
    PVar(v) -> names.contains(v.name.name),
    PCtor(c) ->
      (is_bare(c.name) && names.contains(c.name.name.name))
        || c.args.fold(false, |acc: Bool, a: Pattern| acc || pattern_mentions(a, names)),
    PRecord(r) ->
      r.fields.fold(false, |acc: Bool, f: { name: Ident, pat: Pattern }|
        acc || pattern_mentions(f.pat, names)),
    PList(l) ->
      l.items.fold(false, |acc: Bool, i: Pattern| acc || pattern_mentions(i, names))
        || (match l.rest { Some(rest) -> pattern_mentions(rest, names), None -> false }),
    POr(o) -> o.alts.fold(false, |acc: Bool, a: Pattern| acc || pattern_mentions(a, names)),
  }

// --- The hash table ----------------------------------------------------------------------

fn spec_domain() -> Bytes = b"ply.spec.1"
fn spec_text_domain() -> Bytes = b"ply.spec.text.1"
fn own_domain() -> Bytes = b"ply.own.1"

fn spec_text_hash(kind: Int, index: Int, normalized: Bytes) -> Bytes / {abort.raise} =
  blake3(Bytes::concat_all([spec_text_domain(), byte_of_int(kind), u32_le(index), normalized]))

fn own_hash(normalized: Bytes) -> Bytes = blake3(own_domain().concat(normalized))

pub fn spec_hash(owner: Bytes, kind: Int, index: Int, normalized: Bytes) -> Bytes / {abort.raise} =
  blake3(Bytes::concat_all([spec_domain(), owner, byte_of_int(kind), u32_le(index), normalized]))

fn member_hash(component: Bytes, class: Int) -> Bytes = blake3(component.concat(u32_le(class)))

/// Where a stored body's parts stand: its kind, a member's class, the choices each member's calls
/// on values made (`Chose`) from `picks` to `at`, and the bytes its hash is taken over from `at`.
type Envelope = { kind: Int, class: Int, picks: Int, at: Int }

fn envelope(body: Bytes) -> Option<Envelope> = {
  let kind = if body.len() == 0 { 0 - 1 } else { body.at(0) };
  let framed = |class: Int, from: Int|
    match body.u32_at(from) {
      Some(n) -> if from + 4 + n > body.len() { None }
      else { Some({ kind: kind, class: class, picks: from + 4, at: from + 4 + n }) },
      None -> None,
    };
  if kind == 0 { framed(0, 1) }
  else if kind == 1 { match body.u32_at(1) { Some(class) -> framed(class, 5), None -> None } }
  else { None }
}

/// The one hash a stored body may be filed under, taken from its own bytes; `None` for bytes no
/// envelope holds.
pub fn body_key(body: Bytes) -> Option<Bytes> / {abort.raise} =
  match envelope(body) {
    Some(e) -> {
      let payload = blake3(body.slice(e.at, body.len()));
      Some(if e.kind == 0 { payload } else { member_hash(payload, e.class) })
    },
    None -> None,
  }

/// The component a stored body is of: the component's own hash and each member's, in class order,
/// a body alone in its component its only member; `None` for bytes no envelope holds.
pub fn body_component(body: Bytes) -> Option<{ id: Bytes, members: List<Bytes> }> / {abort.raise} =
  match envelope(body) {
    None -> None,
    Some(e) -> {
      let payload = body.slice(e.at, body.len());
      let id = blake3(payload);
      if e.kind == 0 { Some({ id: id, members: [id] }) } else {
        match payload.u32_at(0) {
          Some(count) -> if count > payload.len() / 4 { None } else {
            Some({ id: id, members: range(0, count).map(|class: Int| member_hash(id, class)) })
          },
          None -> None,
        }
      }
    },
  }

/// Each member's choices, written as `envelope` reads them.
fn framed_picks(picks: List<List<Choice>>) -> Bytes = {
  let inner = Bytes::concat_all(
    picks.map(|p: List<Choice>|
      u32_le(p.len()).concat(
        Bytes::concat_all(
          p.map(|c: Choice|
            Bytes::concat_all([
              u32_le(c.callee + 1),
              u32_le(c.named.len()),
              Bytes::concat_all(c.named.map(u32_le)),
            ])),
        ),
      )),
  );
  u32_le(inner.len()).concat(inner)
}

fn open_picks_bin() -> bin::BinCodec<List<List<Pick>>> = bin::list_bin(bin::list_bin(pick_bin()))

/// A body, alone in its component where `class` is `None`: a kind byte, the member's class, each
/// member's choices, then the bytes its hash is taken over. A body with a call on a value its check
/// is yet to say of is of a kind two past that, its picks written whole: `envelope` reads no key
/// from it, so no store files it and no printer reads it until [`checked_body`] completes it.
fn stored_body(
  class: Option<Int>,
  picks: List<List<Pick>>,
  payload: Bytes,
) -> Bytes / {abort.raise} = {
  let head = |kind: Int|
    match class { None -> byte_of_int(kind), Some(c) -> byte_of_int(kind + 1).concat(u32_le(c)) };
  let found = Option::traverse(picks, |member: List<Pick>|
    Option::traverse(member, |p: Pick| match p { Found(c) -> Some(c), Waiting(_) -> None }));
  match found {
    Some(choices) -> Bytes::concat_all([head(0), framed_picks(choices), payload]),
    None -> {
      let open = bin::encode(picks, open_picks_bin());
      Bytes::concat_all([head(2), u32_le(open.len()), open, payload])
    },
  }
}

/// `body` with each call on a value its hashing left pending written as `chose`, what its check
/// found of each call by `site_key`, says: the body hashing after the check stores. Any other body
/// is itself.
pub fn checked_body(body: Bytes, chose: Map<Bytes, Called>) -> Bytes / {abort.raise} = {
  let kind = if body.len() == 0 { 0 - 1 } else { body.at(0) };
  if kind != 2 && kind != 3 { body } else {
    let from = if kind == 2 { 1 } else { 5 };
    let n = match body.u32_at(from) { Some(x) -> x, None -> panic("a malformed body") };
    let picks = match bin::decode(body.slice(from + 4, from + 4 + n), open_picks_bin()) {
      Ok(p) -> p,
      Err(_) -> panic("a malformed body"),
    };
    Bytes::concat_all([
      byte_of_int(kind - 2),
      body.slice(1, from),
      framed_picks(
        picks.map(|member: List<Pick>|
          member.map(|p: Pick|
            match p { Found(c) -> c, Waiting(s) -> choice_of(chose.get(s.at), s.candidates) })),
      ),
      body.slice(from + 4 + n, body.len()),
    ])
  }
}

/// `hashes`, a hashing of a program made before its check, with each body completed as
/// [`checked_body`] does from `sites`, every call on a value the check found. A definition named
/// in `unread`, or a test keyed in `unread_tests`, is one the check found none of the calls of,
/// so its body stays pending.
pub fn checked_hashes(
  hashes: HashOutput,
  sites: List<MemberSite>,
  unread: Map<Bytes, Bool>,
  unread_tests: Map<Bytes, Bool>,
) -> HashOutput / {abort.raise} = {
  let chose = called_at(sites);
  {
    ..hashes,
    bodies: hashes.bodies.map(|b: { name: Bytes, body: Bytes }|
      if unread.contains(b.name) { b }
      else { { name: b.name, body: checked_body(b.body, chose) } }),
    test_bodies: hashes.test_bodies.fold(
      Map::new(),
      |acc: Map<Bytes, Bytes>, k: Bytes, b: Bytes|
        acc.insert(k, if unread_tests.contains(k) { b } else { checked_body(b, chose) }),
    ),
  }
}

/// The choices of a body `e` opens, a list a member.
fn picks_of(body: Bytes, e: Envelope) -> List<List<Choice>> / {abort.raise} = {
  let read = |at: Int| match body.u32_at(at) { Some(n) -> n, None -> panic("a malformed body") };
  iterate(
    { at: e.picks, lists: [] },
    e.at - e.picks + 1,
    |s: { at: Int, lists: List<List<Choice>> }|
      if s.at >= e.at { Stop(s.lists) } else {
        let list = range(0, read(s.at)).fold(
          { at: s.at + 4, choices: [] },
          |acc: { at: Int, choices: List<Choice> }, _i: Int| {
            let k = read(acc.at + 4);
            {
              at: acc.at + 8 + 4 * k,
              choices: acc.choices.push({
                callee: read(acc.at) - 1,
                named: range(0, k).map(|j: Int| read(acc.at + 8 + 4 * j)),
              }),
            }
          },
        );
        Continue({ at: list.at, lists: s.lists.push(list.choices) })
      },
  )
}

/// `bodies` and `test_bodies`: each definition's and test's stored body, the bytes its hash is taken
/// over; a hashing made before the check leaves a body with a call on a value pending until
/// [`checked_hashes`]. What is said of each test or law is under its key.
pub type HashOutput = {
  defs: List<{ name: Bytes, hash: Bytes }>,
  own: List<{ name: Bytes, hash: Bytes }>,
  decls: List<{ name: Bytes, hash: Bytes }>,
  tests: Map<Bytes, Bytes>,
  laws: Map<Bytes, Bytes>,
  specs: List<{ name: Bytes, hashes: List<Bytes> }>,
  spec_texts: List<{ name: Bytes, hashes: List<Bytes> }>,
  law_texts: Map<Bytes, Bytes>,
  /// Every name each name or key mentions, whatever of that name does the mentioning: a superset
  /// of what any one node references, which is what a key over it may read. `refs` says which.
  deps: List<{ name: Bytes, names: List<Bytes> }>,
  refs: Refs,
  bodies: List<{ name: Bytes, body: Bytes }>,
  test_bodies: Map<Bytes, Bytes>,
  /// Each test's own form: its body with every reference written as the name it resolves to.
  test_texts: Map<Bytes, Bytes>,
  /// What a definition's signature and specifications say to whoever references it.
  contracts: List<{ name: Bytes, hash: Bytes }>,
  /// What a definition's clauses are proved against: its body, with what that reaches in its own
  /// package read the same way and what it reaches in other packages by contract.
  checks: List<{ name: Bytes, hash: Bytes }>,
  /// What a clause's proof is filed under: its clause, over its definition's check.
  spec_checks: List<{ name: Bytes, hashes: List<Bytes> }>,
  /// What each test references and runs and what each law references.
  test_refs: Map<Bytes, List<Int>>,
  test_runs: Map<Bytes, List<Int>>,
  law_refs: Map<Bytes, List<Int>>,
  /// By node, the effects its component sees, in the order that numbers them: what a reference to
  /// one of its effects is written under, from wherever it is referenced.
  enumerations: List<List<Int>>,
}

/// Each node's name, whether it is a type or an effect and not a function, and what it references,
/// by index. A name is no node: a function, a type and an effect may share one, and a test's key
/// may spell a definition's name, so a function's node is found under `fns`, each type's and
/// effect's under `declared`, and what a test or a law references under `items`, by its key. A
/// closure is walked over these when it is asked for.
pub type Refs = {
  names: List<Bytes>,
  decls: List<Bool>,
  edges: List<List<Int>>,
  fns: Map<Bytes, Int>,
  declared: Map<Bytes, List<Int>>,
  items: Map<Bytes, List<Int>>,
  /// By the key of each test over cases, where one of its cases starts: what its hash is taken
  /// over, which leaves out its table and its label.
  cases: Map<Bytes, List<Int>>,
  /// By node, what its specification clauses reference, which is read with it.
  clauses: List<List<Int>>,
  /// By the key of each test over cases, what listing its cases references: its table and label.
  listings: Map<Bytes, List<Int>>,
}

/// What hashing no program answers.
pub fn no_hashes() -> HashOutput =
  {
    defs: [],
    own: [],
    decls: [],
    tests: Map::new(),
    laws: Map::new(),
    specs: [],
    spec_texts: [],
    law_texts: Map::new(),
    deps: [],
    refs: no_refs(),
    bodies: [],
    test_bodies: Map::new(),
    test_texts: Map::new(),
    contracts: [],
    checks: [],
    spec_checks: [],
    test_refs: Map::new(),
    test_runs: Map::new(),
    law_refs: Map::new(),
    enumerations: [],
  }

/// The reference graph of no program.
pub fn no_refs() -> Refs =
  {
    names: [],
    decls: [],
    edges: [],
    fns: Map::new(),
    declared: Map::new(),
    items: Map::new(),
    cases: Map::new(),
    clauses: [],
    listings: Map::new(),
  }

/// `deps` is a list in entry order; the map indexes it, or recording is quadratic.
type Recording = { out: HashOutput, deps_at: Map<Bytes, Int> }

// --- The published-hash digest -------------------------------------------------------

/// The digest names the shape it covers, so it is never confused with a definition hash.
fn hashes_domain() -> Bytes = b"ply.hashes.1"

fn digest_named(p: { name: Bytes, hash: Bytes }) -> Bytes =
  Bytes::concat_all([u64_le(p.name.len()), p.name, p.hash])

fn digest_spec(s: { name: Bytes, hashes: List<Bytes> }) -> Bytes =
  Bytes::concat_all([
    u64_le(s.name.len()),
    s.name,
    u64_le(s.hashes.len()),
    Bytes::concat_all(s.hashes),
  ])

/// Every published hash, framed so two tables cannot collide: what a compiled unit and the machine
/// entering it agree on. Each list is in the order the dump writes it.
pub fn digest(hashes: HashOutput) -> Bytes =
  blake3(
    Bytes::concat_all([
      hashes_domain(),
      u64_le(hashes.defs.len()),
      Bytes::concat_all(hashes.defs.map(|p: { name: Bytes, hash: Bytes }| digest_named(p))),
      u64_le(hashes.decls.len()),
      Bytes::concat_all(hashes.decls.map(|p: { name: Bytes, hash: Bytes }| digest_named(p))),
      u64_le(hashes.specs.len()),
      Bytes::concat_all(hashes.specs.map(|s: { name: Bytes, hashes: List<Bytes> }| digest_spec(s))),
      u64_le(hashes.tests.len()),
      Bytes::concat_all(hashes.tests.entries().map(digest_keyed)),
      u64_le(hashes.laws.len()),
      Bytes::concat_all(hashes.laws.entries().map(digest_keyed)),
    ]),
  )

fn digest_keyed(e: { key: Bytes, value: Bytes }) -> Bytes =
  digest_named({ name: e.key, hash: e.value })

/// What `m` says of `key`, which every table of tests or laws holds for each of them.
pub fn of_key<a>(m: Map<Bytes, a>, key: Bytes) -> a / {abort.raise} =
  match m.get(key) { Some(x) -> x, None -> panic("a key the table does not hold") }

/// Its calls' choices, then the normalized bytes `blake3` keys the body by.
fn solo_body(f: Finished) -> Bytes / {abort.raise} = stored_body(None, [f.chosen], f.bytes)

/// Every member's choices, then the whole component's packed bytes, so any member rebuilds the
/// cycle.
fn member_body(refined: Refined, class: Int) -> Bytes / {abort.raise} =
  stored_body(Some(class), refined.picks, refined.packed)

type Sccs = { component_of: List<Int>, orders: List<List<Int>> }

/// The effects one component can see, in an order derived only from what it references.
fn effect_order(
  shapes: Shapes,
  refs: List<Int>,
  scc: Sccs,
  own: Option<Int>,
  out: List<Int>,
) -> List<Int> / {abort.raise} =
  refs.fold(out, |acc: List<Int>, r: Int| {
    let with_effect = if shapes.nodes.get(r).effect { acc.push_unique(r) } else { acc };
    let ci = if r < scc.component_of.len() { scc.component_of.get(r) } else { 0 - 1 };
    if (match own { Some(o) -> o == ci, None -> false }) || ci < 0 || ci >= scc.orders.len() {
      with_effect
    } else { scc.orders.get(ci).fold(with_effect, |a: List<Int>, node: Int| a.push_unique(node)) }
  })

fn slots(order: List<Int>) -> Map<Int, Int> / {abort.raise} =
  range(0, order.len()).fold(Map::new(), |acc: Map<Int, Int>, i: Int| acc.insert(order.get(i), i))

// --- What hashing reads of a program ----------------------------------------------------------

/// A node as hashing reads it: its name, whether it is a declaration and whether an effect, the
/// package its module is in, and its forms, which a node read as an earlier run fixed it has none
/// of.
pub type Shape = { name: Bytes, decl: Bool, effect: Bool, package: Int, form: Option<NodeForm> }

/// A node normalized and, for a function, what another package reads of it: its signature with the
/// body left out, each clause of its specification, and whether its body is `transparent`.
pub type NodeForm = {
  pieces: List<Piece>,
  signature: List<Piece>,
  clauses: List<ClauseForm>,
  transparent: Bool,
}

pub type ClauseForm = { kind: Int, pieces: List<Piece> }

/// A test or a law normalized, and what a test over cases references besides: its table, its label
/// and what one case runs.
pub type ItemForm = { pieces: List<Piece>, listed: List<Int>, listing: List<Int> }

pub type ItemShape = { key: Bytes, form: Option<ItemForm> }

/// A program as hashing reads it: its nodes, those that are definitions in the order it lists
/// them, and its tests and laws.
pub type Shapes = {
  nodes: List<Shape>,
  order: List<Int>,
  tests: List<ItemShape>,
  laws: List<ItemShape>,
}

derive bin for ClauseForm

derive bin for NodeForm

derive bin for Shape

derive bin for ItemForm

derive bin for ItemShape

derive bin for Shapes

fn formless(shape: Shape) -> Bool = match shape.form { None -> true, Some(_) -> false }

/// What filling reads throughout one hashing: the shapes, each node's name, and the graph over them.
type Over = { shapes: Shapes, names: List<Bytes>, graph: Graph }

fn pieces_of(over: Over, v: Int) -> List<Piece> / {abort.raise} =
  match over.shapes.nodes.get(v).form {
    Some(f) -> f.pieces,
    None -> panic("a node hashed again has no form"),
  }

/// `pieces` filled from `hashes`, its effects numbered as `effects` says.
fn filled_under(
  over: Over,
  pieces: List<Piece>,
  hashes: Map<Int, Bytes>,
  effects: Map<Int, Int>,
  by_name: Bool,
) -> Finished / {abort.raise} =
  filled(pieces, {
    hashes: hashes,
    component: Map::new(),
    effects: effects,
    by_name: by_name,
    names: over.names,
  })

/// The effect enumeration an item is written under, fixed by what it references with nothing known.
fn slots_of(over: Over, pieces: List<Piece>) -> Map<Int, Int> / {abort.raise} =
  slots(effect_order(over.shapes, filled(pieces, blank()).refs, over.graph.scc, None, []))

/// `pieces` filled from `hashes` under the enumeration its own references fix.
fn filled_item(
  over: Over,
  pieces: List<Piece>,
  hashes: Map<Int, Bytes>,
  by_name: Bool,
) -> Finished / {abort.raise} = filled_under(over, pieces, hashes, slots_of(over, pieces), by_name)

fn sketch_lt(a: Bytes, ia: Int, b: Bytes, ib: Int) -> Bool = bytes_lt(a, b) || (a == b && ia < ib)

type Refined = {
  members: List<{ node: Int, hash: Bytes }>,
  packed: Bytes,
  picks: List<List<Pick>>,
  classes: Map<Int, Int>,
}

/// A cyclic component hashes as a unit; members are labelled by class refinement to a fixpoint, plus one settling round.
fn hash_component(
  over: Over,
  component: List<Int>,
  hashes: Map<Int, Bytes>,
  effects: Map<Int, Int>,
) -> Refined / {abort.raise} = {
  let encode = |classes: Map<Int, Int>, v: Int|
    filled(pieces_of(over, v), {
      hashes: hashes,
      component: classes,
      effects: effects,
      by_name: false,
      names: over.names,
    });
  let relabel = |finished: List<Finished>| {
    let encodings = finished.map(|f: Finished| f.bytes);
    let distinct = dedup_sorted(sort_bytes(encodings));
    range(0, component.len()).fold(Map::new(), |acc: Map<Int, Int>, i: Int|
      acc.insert(component.get(i), position_bytes(distinct, encodings.get(i))))
  };
  let grouping = |classes: Map<Int, Int>|
    sort_groups(
      component.fold(Map::new(), |acc: Map<Int, List<Int>>, v: Int| {
        let c = match classes.get(v) { Some(x) -> x, None -> 0 };
        acc.insert(c, List::push(match acc.get(c) { Some(g) -> g, None -> [] }, v))
      }),
    );
  let start = component.fold(Map::new(), |acc: Map<Int, Int>, v: Int| acc.insert(v, 0));
  let settled = iterate(
    { classes: start, encodings: component.map(|v: Int| encode(start, v)) },
    component.len() + 2,
    |s: { classes: Map<Int, Int>, encodings: List<Finished> }| {
      let next = relabel(s.encodings);
      let same = grouping(next) == grouping(s.classes);
      let re = { classes: next, encodings: component.map(|v: Int| encode(next, v)) };
      if same { Stop(re) } else { Continue(re) }
    },
  );
  let width = component.fold(0, |acc: Int, v: Int|
      max(acc, match settled.classes.get(v) { Some(c) -> c, None -> 0 }))
    + 1;
  let by_class = range(0, component.len()).fold(
    range(0, width).map(|i: Int| { bytes: b"", refs: [], chosen: [] }),
    |acc: List<Finished>, i: Int|
      acc.set(
        match settled.classes.get(component.get(i)) { Some(c) -> c, None -> 0 },
        settled.encodings.get(i),
      ),
  );
  let packed = u32_le(by_class.len()).concat(
    Bytes::concat_all(by_class.map(|m: Finished| u32_le(m.bytes.len()).concat(m.bytes))),
  );
  let component_hash = blake3(packed);
  {
    members: component.map(|v: Int|
      {
        node: v,
        hash: member_hash(component_hash, match settled.classes.get(v) { Some(c) -> c, None -> 0 }),
      }),
    packed: packed,
    picks: by_class.map(|m: Finished| m.chosen),
    classes: settled.classes,
  }
}

fn dedup_sorted(xs: List<Bytes>) -> List<Bytes> / {abort.raise} =
  xs.fold([], |acc: List<Bytes>, x: Bytes|
    if acc.len() > 0 && acc.get(acc.len() - 1) == x { acc } else { acc.push(x) })

fn position_bytes(xs: List<Bytes>, v: Bytes) -> Int / {abort.raise} =
  range(0, xs.len()).fold(0, |acc: Int, i: Int| if xs.get(i) == v { i } else { acc })

/// Groups by class, each sorted, the groups sorted: the shape two labellings are compared by.
fn sort_groups(groups: Map<Int, List<Int>>) -> List<List<Int>> / {abort.raise} = {
  let out = groups.fold([], |acc: List<List<Int>>, k: Int, g: List<Int>| acc.push(sort_ints(g)));
  out.fold([], |acc: List<List<Int>>, g: List<Int>| {
    let n = acc.len();
    let i = range(0, n).fold(n, |p: Int, j: Int|
      if p < n { p } else if ints_lt(g, acc.get(j)) { j } else { p });
    acc.take(i).push(g).concat(range(i, n).map(|j: Int| acc.get(j)))
  })
}

fn sort_ints(xs: List<Int>) -> List<Int> / {abort.raise} =
  xs.fold([], |acc: List<Int>, x: Int| {
    let n = acc.len();
    let i = range(0, n).fold(n, |p: Int, j: Int|
      if p < n { p } else if x < acc.get(j) { j } else { p });
    acc.take(i).push(x).concat(range(i, n).map(|j: Int| acc.get(j)))
  })

fn ints_lt(a: List<Int>, b: List<Int>) -> Bool =
  match compare_values(a, b) { Less -> true, _ -> false }

type Stated = {
  own: List<{ name: Bytes, hash: Bytes }>,
  specs: List<{ name: Bytes, hashes: List<Bytes> }>,
  spec_texts: List<{ name: Bytes, hashes: List<Bytes> }>,
  spec_checks: List<{ name: Bytes, hashes: List<Bytes> }>,
}

type Hashed = {
  hashes: Map<Int, Bytes>,
  bodies: Map<Int, Bytes>,
  tests: List<Bytes>,
  test_bodies: List<Bytes>,
  test_texts: List<Bytes>,
  test_refs: List<List<Int>>,
  // What each test's hash is taken over references: all a case of a test over cases runs.
  test_runs: List<List<Int>>,
  laws: List<Bytes>,
  law_refs: List<List<Int>>,
  law_texts: List<Bytes>,
  own: List<{ name: Bytes, hash: Bytes }>,
  specs: List<{ name: Bytes, hashes: List<Bytes> }>,
  spec_texts: List<{ name: Bytes, hashes: List<Bytes> }>,
  contracts: Map<Int, Bytes>,
  checks: Map<Int, Bytes>,
  spec_checks: List<{ name: Bytes, hashes: List<Bytes> }>,
  enumerations: List<List<Int>>,
  clauses: List<List<Int>>,
  test_listings: List<List<Int>>,
}

/// Each test's hash, stored body, own form and references, in the index's order.
type TestHashes = {
  hashes: List<Bytes>,
  bodies: List<Bytes>,
  texts: List<Bytes>,
  refs: List<List<Int>>,
  runs: List<List<Int>>,
  listings: List<List<Int>>,
}

/// `hashes` is the table references are written from; `fresh` is what each body hashed to under it.
type Keyed = { hashes: Map<Int, Bytes>, bodies: Map<Int, Bytes>, fresh: Map<Int, Bytes> }

type Graph = { edges: List<List<Int>>, components: List<List<Int>>, scc: Sccs }

/// Every node with nothing known: what it references, and a sketch that orders a cycle's members
/// without source position. A node `fixed` holds references what its run fixed, and has a sketch
/// only where it has a form.
fn first_of(shapes: Shapes, fixed: Map<Int, List<Int>>) -> List<Finished> / {abort.raise} =
  range(0, shapes.nodes.len()).map(|v: Int| {
    let edges = fixed.get(v);
    match shapes.nodes.get(v).form {
      None -> { bytes: b"", refs: match edges { Some(es) -> es, None -> [] }, chosen: [] },
      Some(f) -> {
        let x: Finished = filled(f.pieces, blank());
        match edges { Some(es) -> { ..x, refs: es }, None -> x }
      },
    }
  })

/// The node at `v` of `index` normalized, and what another package reads of a function. `chose`
/// is what [`Chosen`] says of its module's calls on values.
fn node_form(index: Index, v: Int, chose: Option<Map<Bytes, Called>>) -> NodeForm / {abort.raise} = {
  let node = index.nodes.get(v);
  let pieces = chosen_template(index, node.module, chose, |encoder: Encoder|
    normalize_node(encoder, node.body));
  match node.body {
    NodeFn(d) ->
      {
        pieces: pieces,
        signature: template_of(index, node.module, |encoder: Encoder|
          normalize_node(encoder, NodeFn({ ..d, body: ELit({ span: d.name.span, lit: LUnit }) }))),
        clauses: d.spec.map(|clause: SpecClause|
          {
            kind: spec_tag(clause.kind),
            pieces: template_of(index, node.module, |encoder: Encoder|
              spec_clause(encoder, d, clause)),
          }),
        transparent: d.transparent != None,
      },
    _ -> { pieces: pieces, signature: [], clauses: [], transparent: false },
  }
}

fn test_form(
  index: Index,
  t: TestNode,
  chose: Option<Map<Bytes, Called>>,
) -> ItemForm / {abort.raise} =
  {
    pieces: chosen_template(index, t.module, chose, |encoder: Encoder| test_def(encoder, t.def)),
    listed: listed_refs(index, t),
    listing: match t.def.cases {
      Some(c) -> refs_of(index, t.module, |encoder: Encoder| expr(encoder, test_listing(c))),
      None -> [],
    },
  }

fn law_form(index: Index, l: LawNode) -> ItemForm / {abort.raise} =
  {
    pieces: template_of(index, l.module, |encoder: Encoder| law_def(encoder, l.def)),
    listed: [],
    listing: [],
  }

type Shaped = { shapes: Shapes, first: List<Finished> }

/// Each node of `index` as hashing reads it, its modules in `packages`; a node `fixed` holds the
/// references of, and each test and law `fixing` holds, without forms. A fixed node that shares a
/// cycle with one that is not has a form: its sketch orders that cycle's members.
fn shapes_of(
  index: Index,
  packages: List<Int>,
  fixed: Map<Int, List<Int>>,
  fixing: Fixing,
) -> Shaped / {abort.raise} = {
  let held_tests = fixing.tests.fold(Map::new(), |acc: Map<Bytes, Bool>, t: FixedTest|
    acc.insert(t.key, true));
  let held_laws = fixing.laws.fold(Map::new(), |acc: Map<Bytes, Bool>, l: FixedLaw|
    acc.insert(l.key, true));
  let shape = |v: Int, formed: Bool| {
    let node = index.nodes.get(v);
    {
      name: node.name,
      decl: is_decl(node),
      effect: is_effect(index, v),
      package: match packages.at(node.module) { Some(p) -> p, None -> 0 },
      form: if formed { Some(node_form(index, v, None)) } else { None },
    }
  };
  let plain = {
    nodes: range(0, index.nodes.len()).map(|v: Int| shape(v, !fixed.contains(v))),
    order: index.order.fold([], |acc: List<Int>, e: IndexEntry|
      match e { DefEntry(v) -> acc.push(v), _ -> acc }),
    tests: index.tests.map(|t: TestNode|
      {
        key: t.key,
        form: if held_tests.contains(t.key) { None } else { Some(test_form(index, t, None)) },
      }),
    laws: index.laws.map(|l: LawNode|
      {
        key: l.key,
        form: if held_laws.contains(l.key) { None } else { Some(law_form(index, l)) },
      }),
  };
  let first = first_of(plain, fixed);
  // A cycle whose members are all fixed keeps the order it was fixed in, which no sketch decides.
  let cyclic = if fixed.len() == 0 { Map::new() } else {
    graph::components({ out: first.map(|f: Finished| f.refs) }).fold(
      Map::new(),
      |acc: Map<Int, Bool>, c: List<Int>|
        if c.len() < 2 || c.fold(true, |all: Bool, v: Int| all && fixed.contains(v)) { acc } else {
          c.fold(acc, |a: Map<Int, Bool>, v: Int|
            if fixed.contains(v) { a.insert(v, true) } else { a })
        },
    )
  };
  if cyclic.len() == 0 { { shapes: plain, first: first } } else {
    let shapes = {
      ..plain,
      nodes: range(0, index.nodes.len()).map(|v: Int|
        if cyclic.contains(v) { shape(v, true) } else { plain.nodes.get(v) }),
    };
    { shapes: shapes, first: first_of(shapes, fixed) }
  }
}

/// Every node of `index` with its forms and the graph over them.
fn over_of(index: Index) -> Over / {abort.raise} = {
  let shaped = shapes_of(index, [], Map::new(), no_fixing());
  {
    shapes: shaped.shapes,
    names: shaped.shapes.nodes.map(|s: Shape| s.name),
    graph: graph_with(shaped.shapes, shaped.first, Map::new()),
  }
}

/// Every node of `index` with nothing known.
fn first_pass(index: Index) -> List<Finished> / {abort.raise} =
  shapes_of(index, [], Map::new(), no_fixing()).first

/// `carried` gives a fixed node the enumeration its component had where its body was hashed.
fn graph_with(
  shapes: Shapes,
  first: List<Finished>,
  carried: Map<Int, List<Int>>,
) -> Graph / {abort.raise} = {
  let n = shapes.nodes.len();
  let edges = first.map(|f: Finished| f.refs);
  let sketches = first.map(|f: Finished| f.bytes);
  // A cycle's members last met first: the order the keys below are taken in.
  let components = graph::components({ out: edges }).map(|c: List<Int>| c.reverse());
  let component_of = range(0, components.len()).fold(
    range(0, n).map(|i: Int| 0 - 1),
    |acc: List<Int>, ci: Int| components.get(ci).fold(acc, |a: List<Int>, v: Int| a.set(v, ci)),
  );
  // Components arrive dependency-first, so each can splice in the enumerations it references.
  let orders = range(0, components.len()).fold([], |acc: List<List<Int>>, ci: Int| {
    let members = components.get(ci).fold([], |ms: List<Int>, v: Int| {
      let k = ms.len();
      let i = range(0, k).fold(k, |p: Int, j: Int|
        if p < k { p }
        else if sketch_lt(sketches.get(v), v, sketches.get(ms.get(j)), ms.get(j)) { j }
        else { p });
      ms.take(i).push(v).concat(range(i, k).map(|j: Int| ms.get(j)))
    });
    let scc = { component_of: component_of, orders: acc };
    let kept = match members {
      [first_member, ..] -> if members.fold(true, |all: Bool, v: Int| all && carried.contains(v)) {
        carried.get(first_member)
      } else { None },
      [] -> None,
    };
    acc.push(match kept {
      Some(order) -> order,
      None ->
        members.fold([], |o: List<Int>, v: Int|
          effect_order(shapes, edges.get(v), scc, Some(ci), o)),
    })
  });
  { edges: edges, components: components, scc: { component_of: component_of, orders: orders } }
}

/// A component of nodes held or never hashed keeps what `held` holds; any other is keyed.
fn key_components(
  over: Over,
  pinned: Map<Int, Bytes>,
  held: Map<Int, Fixed>,
) -> Keyed / {abort.raise} =
  range(0, over.graph.components.len()).fold(
    { hashes: Map::new(), bodies: Map::new(), fresh: Map::new() },
    |acc: Keyed, ci: Int| {
      let component = over.graph.components.get(ci);
      if component.fold(true, |all: Bool, v: Int|
          all && (held.contains(v) || formless(over.shapes.nodes.get(v)))) {
        component.fold(acc, |a: Keyed, v: Int|
          match held.get(v) {
            None -> a,
            Some(f) ->
              {
                hashes: a.hashes.insert(v, f.hash),
                bodies: a.bodies.insert(v, f.body),
                fresh: a.fresh.insert(v, f.hash),
              },
          })
      } else { key_component(over, pinned, acc, ci, component) }
    },
  )

fn key_component(
  over: Over,
  pinned: Map<Int, Bytes>,
  acc: Keyed,
  ci: Int,
  component: List<Int>,
) -> Keyed / {abort.raise} = {
  let effects = slots(over.graph.scc.orders.get(ci));
  let own: Keyed = if is_cyclic(component, over.graph.edges) {
    let refined: Refined = hash_component(over, component, acc.hashes, effects);
    refined.members.fold(acc, |a: Keyed, m: { node: Int, hash: Bytes }| {
      let class = match refined.classes.get(m.node) { Some(c) -> c, None -> 0 };
      {
        ..a,
        fresh: a.fresh.insert(m.node, m.hash),
        bodies: a.bodies.insert(m.node, member_body(refined, class)),
      }
    })
  } else {
    let v = component.get(0);
    let encoding = filled_under(over, pieces_of(over, v), acc.hashes, effects, false);
    {
      ..acc,
      fresh: acc.fresh.insert(v, blake3(encoding.bytes)),
      bodies: acc.bodies.insert(v, solo_body(encoding)),
    }
  };
  {
    ..own,
    hashes: component.fold(own.hashes, |h: Map<Int, Bytes>, v: Int|
      match pinned.get(v) {
        Some(x) -> h.insert(v, x),
        None -> match own.fresh.get(v) { Some(x) -> h.insert(v, x), None -> h },
      }),
  }
}

/// `index` hashed with each node, test and law `fixing` holds read as its earlier run fixed it,
/// its modules in `packages`; and what each node references with nothing known.
fn hashed_whole(
  index: Index,
  fixing: Fixing,
  packages: List<Int>,
) -> { hashes: HashOutput, first: List<Finished> } / {abort.raise} = {
  let keys = node_keys(index);
  let held = fixing.nodes.fold(Map::new(), |acc: Map<Int, Fixed>, f: Fixed|
    match keys.get(pin_key(f.name, f.decl)) { Some(v) -> acc.insert(v, f), None -> acc });
  let shaped = shapes_of(index, packages, fixed_edges(index, fixing.nodes), fixing);
  let out = hashed_over(shaped.shapes, shaped.first, held, fixing);
  { hashes: assemble(skeleton_of(index), out.graph.edges, out.hashed), first: shaped.first }
}

pub fn hash_index(index: Index) -> HashOutput / {abort.raise} =
  hashed_whole(index, no_fixing(), []).hashes

pub type NodeRef = { name: Bytes, decl: Bool }

/// What hashing derives from a node's body, which a module checked against its imports' entries
/// does not hold; `own`, specs and `contract` are a function's, `contract` empty for a declaration.
pub type Fixed = {
  name: Bytes,
  decl: Bool,
  hash: Bytes,
  own: Option<Bytes>,
  specs: List<Bytes>,
  spec_texts: List<Bytes>,
  spec_checks: List<Bytes>,
  contract: Bytes,
  /// What a clause's proof reads of it where another definition's clause reaches it: a
  /// declaration's hash.
  check: Bytes,
  body: Bytes,
  edges: List<NodeRef>,
  /// The effects its component sees, in the order that numbers them, which its body decides.
  effects: List<NodeRef>,
  /// What its specification clauses reference.
  clauses: List<NodeRef>,
}

/// What hashing derives from a test: its hash, stored body and own form, what it references and,
/// over cases, what its roots run.
pub type FixedTest = {
  key: Bytes,
  hash: Bytes,
  body: Bytes,
  text: Bytes,
  refs: List<NodeRef>,
  runs: List<NodeRef>,
  /// Over cases, what listing them references.
  listing: List<NodeRef>,
}

/// What hashing derives from a law: its hash, its sentence's and what it references.
pub type FixedLaw = { key: Bytes, hash: Bytes, text: Bytes, refs: List<NodeRef> }

/// The nodes, tests and laws a hashing reads as an earlier run fixed them rather than from their
/// bodies.
pub type Fixing = { nodes: List<Fixed>, tests: List<FixedTest>, laws: List<FixedLaw> }

pub fn no_fixing() -> Fixing = { nodes: [], tests: [], laws: [] }

derive bin for NodeRef

derive bin for Fixed

derive bin for FixedTest

derive bin for FixedLaw

derive bin for Fixing

fn node_keys(index: Index) -> Map<Bytes, Int> / {abort.raise} =
  range(0, index.nodes.len()).fold(Map::new(), |acc: Map<Bytes, Int>, v: Int| {
    let node = index.nodes.get(v);
    acc.insert(pin_key(node.name, is_decl(node)), v)
  })

/// What each fixed node references, by index, as its run fixed it: a node whose body is not read
/// here references nothing of its own.
fn fixed_edges(index: Index, fixed: List<Fixed>) -> Map<Int, List<Int>> / {abort.raise} = {
  let keys = node_keys(index);
  fixed.fold(Map::new(), |acc: Map<Int, List<Int>>, f: Fixed|
    match keys.get(pin_key(f.name, f.decl)) {
      None -> acc,
      Some(v) ->
        acc.insert(
          v,
          f.edges.fold([], |es: List<Int>, r: NodeRef|
            match keys.get(pin_key(r.name, r.decl)) { Some(w) -> es.push(w), None -> es }),
        ),
    })
}

/// The hashes and the definitions nothing uses, over one normalization of every node, test and law
/// but those `fixed` holds, which are read as their earlier run fixed them. A fixed node is never
/// reported unused.
pub fn hashed_and_unused(
  index: Index,
  fixed: Fixing,
  packages: List<Int>,
) -> { hashes: HashOutput, unused: List<Diag>, uses: List<UseNode> } / {abort.raise} = {
  let whole = hashed_whole(index, fixed, packages);
  let named = fixed.nodes.fold(Map::new(), |acc: Map<Bytes, Bool>, f: Fixed|
    acc.insert(pin_key(f.name, f.decl), true));
  if index.nodes.fold(true, |all: Bool, node: Node|
      all && named.contains(pin_key(node.name, is_decl(node)))) {
    let tested = fixed.tests.fold(Map::new(), |acc: Map<Bytes, Bool>, t: FixedTest|
      acc.insert(t.key, true));
    let lawed = fixed.laws.fold(Map::new(), |acc: Map<Bytes, Bool>, l: FixedLaw|
      acc.insert(l.key, true));
    let tests = index.tests.filter(|t: TestNode| !tested.contains(t.key));
    let laws = index.laws.filter(|l: LawNode| !lawed.contains(l.key));
    {
      hashes: whole.hashes,
      unused: [],
      uses: item_uses(
        index,
        tests,
        tests.map(|t: TestNode| test_roots_of(index, t)),
        laws,
        laws.map(|l: LawNode| law_roots_of(index, l)),
      ),
    }
  } else {
    let tests = index.tests.map(|t: TestNode| test_roots_of(index, t));
    let laws = index.laws.map(|l: LawNode| law_roots_of(index, l));
    let edges = node_edges_of(index, whole.first);
    {
      hashes: whole.hashes,
      unused: unused_over(index, edges, fixed.nodes, tests.concat(laws)),
      uses: use_nodes(index, edges, held_of(index, fixed.nodes), tests, laws),
    }
  }
}

fn shape_keys(shapes: Shapes) -> Map<Bytes, Int> / {abort.raise} =
  range(0, shapes.nodes.len()).fold(Map::new(), |acc: Map<Bytes, Int>, v: Int| {
    let s = shapes.nodes.get(v);
    acc.insert(pin_key(s.name, s.decl), v)
  })

/// What hashing `shapes` fixes, `first` what each node references with nothing known: each node
/// `held` holds, and each test and law without a form, read as `fixing` says its earlier run fixed
/// it.
fn hashed_over(
  shapes: Shapes,
  first: List<Finished>,
  held: Map<Int, Fixed>,
  fixing: Fixing,
) -> { graph: Graph, hashed: Hashed } / {abort.raise} = {
  let keys = shape_keys(shapes);
  let held_tests = fixing.tests.fold(Map::new(), |acc: Map<Bytes, FixedTest>, t: FixedTest|
    acc.insert(t.key, t));
  let held_laws = fixing.laws.fold(Map::new(), |acc: Map<Bytes, FixedLaw>, l: FixedLaw|
    acc.insert(l.key, l));
  let present = |refs: List<NodeRef>|
    refs.fold([], |es: List<Int>, r: NodeRef|
      match keys.get(pin_key(r.name, r.decl)) { Some(w) -> es.push(w), None -> es });
  let g = graph_with(
    shapes,
    first,
    held.fold(Map::new(), |acc: Map<Int, List<Int>>, v: Int, f: Fixed|
      acc.insert(v, present(f.effects))),
  );
  let over = { shapes: shapes, names: shapes.nodes.map(|s: Shape| s.name), graph: g };
  let pinned = held.fold(Map::new(), |acc: Map<Int, Bytes>, v: Int, f: Fixed|
    acc.insert(v, f.hash));
  let keyed = key_components(over, pinned, held);
  let hashes = keyed.hashes;
  let check_keys = check_key_components(over, held, hashes);
  let contracts = range(0, shapes.nodes.len()).fold(Map::new(), |acc: Map<Int, Bytes>, v: Int|
    if shapes.nodes.get(v).decl { acc } else {
      let fixed_contract = match held.get(v) { Some(f) -> f.contract, None -> b"" };
      acc.insert(v, if fixed_contract.len() > 0 { fixed_contract } else {
        match check_keys.contracts.get(v) {
          Some(c) -> c,
          None -> contract_of(over, held, hashes, v),
        }
      })
    });
  let tests = shapes.tests.fold(
    { hashes: [], bodies: [], texts: [], refs: [], runs: [], listings: [] },
    |acc: TestHashes, t: ItemShape|
      match t.form {
        None -> match held_tests.get(t.key) {
          Some(x) ->
            {
              hashes: acc.hashes.push(x.hash),
              bodies: acc.bodies.push(x.body),
              texts: acc.texts.push(x.text),
              refs: acc.refs.push(present(x.refs)),
              runs: acc.runs.push(present(x.runs)),
              listings: acc.listings.push(present(x.listing)),
            },
          None -> panic("a test read as fixed is not fixed"),
        },
        Some(form) -> {
          let effects = slots_of(over, form.pieces);
          let f: Finished = filled_under(over, form.pieces, hashes, effects, false);
          let text: Finished = filled_under(over, form.pieces, hashes, effects, true);
          {
            hashes: acc.hashes.push(blake3(f.bytes)),
            bodies: acc.bodies.push(solo_body(f)),
            texts: acc.texts.push(own_hash(text.bytes)),
            refs: acc.refs.push(
              form.listed.fold(f.refs, |rs: List<Int>, r: Int| rs.push_unique(r)),
            ),
            runs: acc.runs.push(f.refs),
            listings: acc.listings.push(form.listing),
          }
        },
      },
  );
  let laws = shapes.laws.fold(
    { hashes: [], refs: [], texts: [] },
    |acc: { hashes: List<Bytes>, refs: List<List<Int>>, texts: List<Bytes> }, l: ItemShape|
      match l.form {
        None -> match held_laws.get(l.key) {
          Some(x) ->
            {
              hashes: acc.hashes.push(x.hash),
              refs: acc.refs.push(present(x.refs)),
              texts: acc.texts.push(x.text),
            },
          None -> panic("a law read as fixed is not fixed"),
        },
        Some(form) -> {
          let effects = slots_of(over, form.pieces);
          let f: Finished = filled_under(over, form.pieces, hashes, effects, false);
          let text: Finished = filled_under(over, form.pieces, hashes, effects, true);
          {
            hashes: acc.hashes.push(blake3(f.bytes)),
            refs: acc.refs.push(f.refs),
            texts: acc.texts.push(spec_text_hash(0, 0, text.bytes)),
          }
        },
      },
  );
  let stated = shapes.order.fold(
    { own: [], specs: [], spec_texts: [], spec_checks: [] },
    |acc: Stated, v: Int|
      match held.get(v) {
        Some(f) -> fixed_stated(acc, shapes.nodes.get(v).name, f),
        None ->
          unfixed_stated(
            over,
            hashes,
            viewed_refs(over, held, hashes, check_keys, v).view,
            check_keys.checks,
            acc,
            v,
            first.get(v).refs,
          ),
      },
  );
  {
    graph: g,
    hashed: {
      hashes: hashes,
      bodies: keyed.bodies,
      tests: tests.hashes,
      test_bodies: tests.bodies,
      test_texts: tests.texts,
      test_refs: tests.refs,
      test_runs: tests.runs,
      laws: laws.hashes,
      law_refs: laws.refs,
      law_texts: laws.texts,
      own: stated.own,
      specs: stated.specs,
      spec_texts: stated.spec_texts,
      contracts: contracts,
      checks: check_keys.checks,
      spec_checks: stated.spec_checks,
      enumerations: range(0, shapes.nodes.len()).map(|v: Int| {
        let ci = g.scc.component_of.get(v);
        if ci < 0 { [] } else { g.scc.orders.get(ci) }
      }),
      clauses: range(0, shapes.nodes.len()).map(|v: Int|
        match shapes.nodes.get(v).form {
          Some(form) ->
            form.clauses.fold([], |acc: List<Int>, c: ClauseForm|
              acc.concat(filled(c.pieces, blank()).refs)),
          None -> match held.get(v) { Some(f) -> present(f.clauses), None -> [] },
        }),
      test_listings: tests.listings,
    },
  }
}

// --- Early cutoff -------------------------------------------------------------------

fn contract_domain() -> Bytes = b"ply.contract.1"

/// What another package reads of a definition: its signature and specifications, and its body only
/// when it is `transparent`; of a node `held` holds and has no form of, what its run fixed.
fn contract_of(
  over: Over,
  held: Map<Int, Fixed>,
  hashes: Map<Int, Bytes>,
  v: Int,
) -> Bytes / {abort.raise} = {
  let shape = over.shapes.nodes.get(v);
  let hash = match hashes.get(v) { Some(h) -> h, None -> b"" };
  if shape.decl { hash } else {
    match shape.form {
      None -> match held.get(v) { Some(f) -> f.contract, None -> hash },
      Some(form) -> {
        let signature = filled_item(over, form.signature, hashes, false).bytes;
        // Normalizing erases the specifications, which a dependent is owed as much as the types.
        let clauses = form.clauses.map(|clause: ClauseForm|
          filled_item(over, clause.pieces, hashes, false).bytes);
        // A `transparent` body is read too, so the contract holds the hash of it and all it reaches.
        let body = if form.transparent { b"transparent".concat(hash) } else { b"" };
        blake3(Bytes::concat_all([contract_domain(), signature, Bytes::concat_all(clauses), body]))
      },
    }
  }
}

/// A public definition or declaration as another package reads it: a function by its contract, a
/// declaration by its hash.
pub type Contract = { name: Bytes, decl: Bool, hash: Bytes }

fn is_public(node: Node) -> Bool =
  match node.body {
    NodeFn(d) -> is_pub(d.vis),
    NodeType(d) -> is_pub(d.vis),
    NodeEffect(d) -> is_pub(d.vis),
  }

/// Every public definition and declaration of the modules `mine` names, as another package reads it.
pub fn public_contracts(
  index: Index,
  h: HashOutput,
  mine: (Bytes) -> Bool,
) -> List<Contract> / {abort.raise} = {
  let keys = node_keys(index);
  let named = |xs: List<{ name: Bytes, hash: Bytes }>, decl: Bool, into: Map<Int, Bytes>|
    xs.fold(into, |acc: Map<Int, Bytes>, x: { name: Bytes, hash: Bytes }|
      match keys.get(pin_key(x.name, decl)) { Some(v) -> acc.insert(v, x.hash), None -> acc });
  let hashes = named(h.decls, true, named(h.defs, false, Map::new()));
  let over = over_of(index);
  range(0, index.nodes.len()).fold([], |acc: List<Contract>, v: Int| {
    let node = index.nodes.get(v);
    if !is_public(node) || !mine(index.mods.get(node.module).name) { acc } else {
      acc.push({
        name: node.name,
        decl: is_decl(node),
        hash: contract_of(over, Map::new(), hashes, v),
      })
    }
  })
}

type CheckKeys = { checks: Map<Int, Bytes>, contracts: Map<Int, Bytes> }

type Viewed = { check_keys: CheckKeys, view: Map<Int, Bytes> }

/// The table a node's check key reads its references from: a definition in another package by its
/// contract, and any other by its check key.
fn viewed_refs(
  over: Over,
  held: Map<Int, Fixed>,
  hashes: Map<Int, Bytes>,
  check_keys: CheckKeys,
  v: Int,
) -> Viewed / {abort.raise} = {
  let own = over.shapes.nodes.get(v).package;
  over.graph.edges.get(v).fold(
    { check_keys: check_keys, view: Map::new() },
    |acc: Viewed, r: Int|
      if over.shapes.nodes.get(r).package != own {
        match acc.check_keys.contracts.get(r) {
          Some(c) -> { ..acc, view: acc.view.insert(r, c) },
          None -> {
            let c = contract_of(over, held, hashes, r);
            {
              check_keys: { ..acc.check_keys, contracts: acc.check_keys.contracts.insert(r, c) },
              view: acc.view.insert(r, c),
            }
          },
        }
      } else {
        match acc.check_keys.checks.get(r) {
          Some(x) -> { ..acc, view: acc.view.insert(r, x) },
          None -> match hashes.get(r) {
            Some(x) -> { ..acc, view: acc.view.insert(r, x) },
            None -> acc,
          },
        }
      },
  )
}

/// Dependency-first, as the hashes are: a component whose references all read as their hashes keeps
/// them, and any other is keyed again under its view.
fn check_key_components(
  over: Over,
  held: Map<Int, Fixed>,
  hashes: Map<Int, Bytes>,
) -> CheckKeys / {abort.raise} =
  range(0, over.graph.components.len()).fold(
    { checks: Map::new(), contracts: Map::new() },
    |acc: CheckKeys, ci: Int| {
      let component = over.graph.components.get(ci);
      let keep = |keys: CheckKeys|
        component.fold(keys, |k: CheckKeys, v: Int|
          match hashes.get(v) { Some(h) -> { ..k, checks: k.checks.insert(v, h) }, None -> k });
      if component.fold(true, |all: Bool, v: Int|
          all && (held.contains(v) || formless(over.shapes.nodes.get(v)))) {
        component.fold(acc, |k: CheckKeys, v: Int|
          match held.get(v) { Some(f) -> { ..k, checks: k.checks.insert(v, f.check) }, None -> k })
      } else {
        let gathered = component.fold({ check_keys: acc, view: Map::new() }, |a: Viewed, v: Int| {
          let x = viewed_refs(over, held, hashes, a.check_keys, v);
          {
            check_keys: x.check_keys,
            view: x.view.fold(a.view, |m: Map<Int, Bytes>, r: Int, k: Bytes|
              if over.graph.scc.component_of.get(r) == ci { m } else { m.insert(r, k) }),
          }
        });
        if gathered.view.fold(true, |all: Bool, r: Int, k: Bytes| all && hashes.get(r) == Some(k)) {
          keep(gathered.check_keys)
        } else {
          let effects = slots(over.graph.scc.orders.get(ci));
          if is_cyclic(component, over.graph.edges) {
            let refined: Refined = hash_component(over, component, gathered.view, effects);
            refined.members.fold(
              gathered.check_keys,
              |keys: CheckKeys, m: { node: Int, hash: Bytes }|
                { ..keys, checks: keys.checks.insert(m.node, m.hash) },
            )
          } else {
            let v = component.get(0);
            let encoding = filled_under(
              over,
              pieces_of(over, v),
              gathered.view,
              effects,
              false,
            ).bytes;
            {
              ..gathered.check_keys,
              checks: gathered.check_keys.checks.insert(v, blake3(encoding)),
            }
          }
        }
      }
    },
  )

fn fixed_stated(acc: Stated, name: Bytes, fixed: Fixed) -> Stated = {
  let owned: Stated = match fixed.own {
    Some(o) -> { ..acc, own: acc.own.push({ name: name, hash: o }) },
    None -> acc,
  };
  if fixed.specs.len() == 0 { owned } else {
    {
      ..owned,
      specs: owned.specs.push({ name: name, hashes: fixed.specs }),
      spec_texts: owned.spec_texts.push({ name: name, hashes: fixed.spec_texts }),
      spec_checks: owned.spec_checks.push({ name: name, hashes: fixed.spec_checks }),
    }
  }
}

/// `refs` are the node's references with nothing known, as the first pass found them.
fn unfixed_stated(
  over: Over,
  hashes: Map<Int, Bytes>,
  view: Map<Int, Bytes>,
  checks: Map<Int, Bytes>,
  acc: Stated,
  v: Int,
  refs: List<Int>,
) -> Stated / {abort.raise} = {
  let shape = over.shapes.nodes.get(v);
  match shape.form {
    None -> acc,
    Some(form) -> if shape.decl { acc } else {
      let own: Finished = filled_under(
        over,
        form.pieces,
        hashes,
        slots(effect_order(over.shapes, refs, over.graph.scc, None, [])),
        true,
      );
      let owned: Stated = {
        ..acc,
        own: acc.own.push({ name: shape.name, hash: own_hash(own.bytes) }),
      };
      if form.clauses.len() == 0 { owned } else {
        match hashes.get(v) {
          None -> owned,
          Some(owner) -> {
            let effects = form.clauses.map(|c: ClauseForm| slots_of(over, c.pieces));
            let encoded = |i: Int, table: Map<Int, Bytes>, by_name: Bool|
              filled_under(over, form.clauses.get(i).pieces, table, effects.get(i), by_name).bytes;
            let kinds = range(0, form.clauses.len());
            let clauses = kinds.map(|i: Int|
              spec_hash(owner, form.clauses.get(i).kind, i, encoded(i, hashes, false)));
            let texts = kinds.map(|i: Int|
              spec_text_hash(form.clauses.get(i).kind, i, encoded(i, hashes, true)));
            let cut_owner = match checks.get(v) { Some(k) -> k, None -> owner };
            let cuts = kinds.map(|i: Int|
              spec_hash(cut_owner, form.clauses.get(i).kind, i, encoded(i, view, false)));
            {
              ..owned,
              specs: owned.specs.push({ name: shape.name, hashes: clauses }),
              spec_texts: owned.spec_texts.push({ name: shape.name, hashes: texts }),
              spec_checks: owned.spec_checks.push({ name: shape.name, hashes: cuts }),
            }
          },
        }
      }
    },
  }
}

// --- A module's forms ------------------------------------------------------------------------

/// Each node `pieces` names, after those of `seen`, in the order first named.
fn piece_nodes(pieces: List<Piece>, seen: Taken) -> Taken / {abort.raise} =
  pieces.fold(seen, |acc: Taken, p: Piece|
    match p {
      Ref(v) -> taken(acc, v),
      Slot(v) -> taken(acc, v),
      Fields(ms) -> ms.fold(acc, |a: Taken, m: List<Piece>| piece_nodes(m, a)),
      Atoms(xs) -> xs.fold(acc, |a: Taken, x: AtomForm| piece_nodes(x.pieces, a)),
      Run(r) -> r.members.fold(acc, |a: Taken, m: RunMember| piece_nodes(m.pieces, a)),
      _ -> acc,
    })

type Taken = { order: List<Int>, at: Map<Int, Int> }

fn taken(t: Taken, v: Int) -> Taken =
  if t.at.contains(v) { t } else { { order: t.order.push(v), at: t.at.insert(v, t.order.len()) } }

fn renumbered(pieces: List<Piece>, ids: Map<Int, Int>) -> List<Piece> / {abort.raise} = {
  let id = |v: Int|
    match ids.get(v) { Some(k) -> k, None -> panic("a form names a node not taken") };
  pieces.map(|p: Piece|
    match p {
      Ref(v) -> Ref(id(v)),
      Slot(v) -> Slot(id(v)),
      Fields(ms) -> Fields(ms.map(|m: List<Piece>| renumbered(m, ids))),
      Atoms(xs) -> Atoms(xs.map(|x: AtomForm| { ..x, pieces: renumbered(x.pieces, ids) })),
      Run(r) ->
        Run({
          ..r,
          members: r.members.map(|m: RunMember| { ..m, pieces: renumbered(m.pieces, ids) }),
        }),
      _ -> p,
    })
}

/// What hashing reads of the module at `module` of `index`, its modules in `packages`: each node
/// of it, test and law with its forms, and each node of another module those reference, by what it
/// is and the package it is in. Its own nodes come first, in the order the module lists them.
pub fn module_forms(index: Index, packages: List<Int>, module: Int) -> Shapes / {abort.raise} =
  kept_forms(index, packages, module, {
    node: |_: Bytes| true,
    test: |_: Bytes| true,
    law: |_: Bytes| true,
  })

/// Which of a module's definitions, tests and laws a hashing of part of it keeps, each by its
/// program-wide name: apart, since a test may be labelled as a definition is named.
pub type Keeping = {
  node: (Bytes) -> Bool / {abort.raise},
  test: (Bytes) -> Bool / {abort.raise},
  law: (Bytes) -> Bool / {abort.raise},
}

/// [`module_forms`] of what `keeps` keeps of the module, each other node it references read as
/// another module's is.
pub fn kept_forms(
  index: Index,
  packages: List<Int>,
  module: Int,
  keeps: Keeping,
) -> Shapes / {abort.raise} = {
  let c = chosen_in(index, module);
  chosen_forms(index, packages, {
    own: c.own.filter(|v: Int| (keeps.node)(index.nodes.get(v).name)),
    tests: c.tests.filter(|t: TestNode| (keeps.test)(t.key)),
    laws: c.laws.filter(|l: LawNode| (keeps.law)(l.key)),
    called: c.called,
  })
}

/// Nodes, tests and laws of one module of an index: its nodes in the order the index lists them.
/// `called` is what its check found of each call on a value, by `site_key`: nothing a hash reads,
/// and `None` where no check is read, which leaves each call pending.
pub type Chosen = {
  own: List<Int>,
  tests: List<TestNode>,
  laws: List<LawNode>,
  called: Option<Map<Bytes, Called>>,
}

/// Every node, test and law of the module at `module` of `index`, found in one walk of it.
pub fn chosen_in(index: Index, module: Int) -> Chosen / {abort.raise} =
  {
    own: index.order.fold([], |acc: List<Int>, e: IndexEntry|
      match e {
        DefEntry(v) -> if index.nodes.get(v).module == module { acc.push(v) } else { acc },
        _ -> acc,
      }),
    tests: index.tests.filter(|t: TestNode| t.module == module),
    laws: index.laws.filter(|l: LawNode| l.module == module),
    called: None,
  }

/// The forms hashing reads of `chosen`, nodes, tests and laws of one module, numbered among
/// themselves as `kept_forms` numbers them.
pub fn chosen_forms(index: Index, packages: List<Int>, chosen: Chosen) -> Shapes / {abort.raise} = {
  let own = chosen.own;
  let forms = own.map(|v: Int| node_form(index, v, chosen.called));
  let tests = chosen.tests;
  let laws = chosen.laws;
  let test_forms = tests.map(|t: TestNode| test_form(index, t, chosen.called));
  let law_forms = laws.map(|l: LawNode| law_form(index, l));
  let item_nodes = |acc: Taken, x: ItemForm|
    x.listed.concat(x.listing).fold(piece_nodes(x.pieces, acc), |a: Taken, v: Int| taken(a, v));
  let table = law_forms.fold(
    test_forms.fold(
      forms.fold(own.fold({ order: [], at: Map::new() }, taken), |acc: Taken, f: NodeForm|
        f.clauses.fold(
          piece_nodes(f.signature, piece_nodes(f.pieces, acc)),
          |a: Taken, c: ClauseForm| piece_nodes(c.pieces, a),
        )),
      item_nodes,
    ),
    item_nodes,
  );
  let ids = table.at;
  let item = |x: ItemForm|
    {
      pieces: renumbered(x.pieces, ids),
      listed: x.listed.map(|v: Int| match ids.get(v) { Some(k) -> k, None -> v }),
      listing: x.listing.map(|v: Int| match ids.get(v) { Some(k) -> k, None -> v }),
    };
  {
    nodes: range(0, table.order.len()).map(|k: Int| {
      let v = table.order.get(k);
      let node = index.nodes.get(v);
      {
        name: node.name,
        decl: is_decl(node),
        effect: is_effect(index, v),
        package: match packages.at(node.module) { Some(p) -> p, None -> 0 },
        form: if k < own.len() {
          let f = forms.get(k);
          Some({
            pieces: renumbered(f.pieces, ids),
            signature: renumbered(f.signature, ids),
            clauses: f.clauses.map(|c: ClauseForm| { ..c, pieces: renumbered(c.pieces, ids) }),
            transparent: f.transparent,
          })
        } else { None },
      }
    }),
    order: range(0, own.len()),
    tests: range(0, tests.len()).map(|i: Int|
      { key: tests.get(i).key, form: Some(item(test_forms.get(i))) }),
    laws: range(0, laws.len()).map(|i: Int|
      { key: laws.get(i).key, form: Some(item(law_forms.get(i))) }),
  }
}

/// Where a node of forms put together comes from: the part that gives its form and its place
/// there, or `part` -1 for one no part gives a form.
type Joint = { part: Int, at: Int, shape: Shape }

/// The forms of `parts`, each what hashing reads of some of one module's definitions, tests and
/// laws, as one reading of them all: each node a part gives a form, in the parts' order, then each
/// no part gives one, in the order first met.
pub fn joined_forms(parts: List<Shapes>) -> Shapes / {abort.raise} = {
  let met = |formed: Bool|
    |acc: { at: Map<Bytes, Int>, nodes: List<Joint> }, k: Int|
      range(0, parts.get(k).nodes.len()).fold(
        acc,
        |a: { at: Map<Bytes, Int>, nodes: List<Joint> }, v: Int| {
          let shape = parts.get(k).nodes.get(v);
          let key = pin_key(shape.name, shape.decl);
          if formless(shape) == formed || a.at.contains(key) { a } else {
            {
              at: a.at.insert(key, a.nodes.len()),
              nodes: a.nodes.push({ part: if formed { k } else { 0 - 1 }, at: v, shape: shape }),
            }
          }
        },
      );
  let formed = range(0, parts.len()).fold({ at: Map::new(), nodes: [] }, met(true));
  let all = range(0, parts.len()).fold(formed, met(false));
  let ids = parts.map(|part: Shapes|
    range(0, part.nodes.len()).fold(Map::new(), |acc: Map<Int, Int>, v: Int| {
      let shape = part.nodes.get(v);
      match all.at.get(pin_key(shape.name, shape.decl)) {
        Some(k) -> acc.insert(v, k),
        None -> panic("a node of a part is a node of the whole"),
      }
    }));
  let item = |k: Int|
    |x: ItemShape|
      {
        ..x,
        form: match x.form {
          None -> None,
          Some(f) ->
            Some({
              pieces: renumbered(f.pieces, ids.get(k)),
              listed: f.listed.map(|v: Int| match ids.get(k).get(v) { Some(w) -> w, None -> v }),
              listing: f.listing.map(|v: Int| match ids.get(k).get(v) { Some(w) -> w, None -> v }),
            }),
        },
      };
  {
    nodes: all.nodes.map(|j: Joint|
      match j.shape.form {
        None -> j.shape,
        Some(f) ->
          {
            ..j.shape,
            form: Some({
              pieces: renumbered(f.pieces, ids.get(j.part)),
              signature: renumbered(f.signature, ids.get(j.part)),
              clauses: f.clauses.map(|c: ClauseForm|
                { ..c, pieces: renumbered(c.pieces, ids.get(j.part)) }),
              transparent: f.transparent,
            }),
          },
      }),
    order: range(0, formed.nodes.len()),
    tests: range(0, parts.len()).fold([], |acc: List<ItemShape>, k: Int|
      acc.concat(parts.get(k).tests.map(item(k)))),
    laws: range(0, parts.len()).fold([], |acc: List<ItemShape>, k: Int|
      acc.concat(parts.get(k).laws.map(item(k)))),
  }
}

/// What hashing a module's `forms` fixes of its nodes, tests and laws, each node of another module
/// they reference read as `fixed` holds it, which holds each of those.
pub fn hashed_forms(forms: Shapes, fixed: List<Fixed>) -> Fixing / {abort.raise} = {
  let named = shape_keys(forms);
  let held = fixed.fold(Map::new(), |acc: Map<Int, Fixed>, f: Fixed|
    match named.get(pin_key(f.name, f.decl)) {
      Some(v) -> if formless(forms.nodes.get(v)) { acc.insert(v, f) } else { acc },
      None -> acc,
    });
  // An effect a fixed node's enumeration names is a node of the program though no form names it:
  // it is numbered, and never hashed.
  let extra = held.fold(
    { keys: named, nodes: [] },
    |acc: { keys: Map<Bytes, Int>, nodes: List<Shape> }, _: Int, f: Fixed|
      f.effects.fold(acc, |a: { keys: Map<Bytes, Int>, nodes: List<Shape> }, r: NodeRef| {
        let key = pin_key(r.name, r.decl);
        if a.keys.contains(key) { a } else {
          {
            keys: a.keys.insert(key, forms.nodes.len() + a.nodes.len()),
            nodes: a.nodes.push({
              name: r.name,
              decl: r.decl,
              effect: true,
              package: 0 - 1,
              form: None,
            }),
          }
        }
      }),
  );
  let shapes = { ..forms, nodes: forms.nodes.concat(extra.nodes) };
  let keys = extra.keys;
  let unfixed = range(0, forms.nodes.len()).filter(|v: Int|
    formless(forms.nodes.get(v)) && !held.contains(v));
  if unfixed.len() > 0 {
    panic("no fixed hash of " ++ String::of_bytes_lossy(forms.nodes.get(unfixed.get(0)).name))
  };
  let present = |refs: List<NodeRef>|
    refs.fold([], |es: List<Int>, r: NodeRef|
      match keys.get(pin_key(r.name, r.decl)) { Some(w) -> es.push(w), None -> es });
  let out = hashed_over(
    shapes,
    first_of(
      shapes,
      held.fold(Map::new(), |acc: Map<Int, List<Int>>, v: Int, f: Fixed|
        acc.insert(v, present(f.edges))),
    ),
    held,
    no_fixing(),
  );
  let h = out.hashed;
  let refs = |rs: List<Int>|
    rs.map(|r: Int| { name: shapes.nodes.get(r).name, decl: shapes.nodes.get(r).decl });
  let by_name = |xs: List<{ name: Bytes, hashes: List<Bytes> }>|
    xs.fold(Map::new(), |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, hashes: List<Bytes> }|
      acc.insert(x.name, x.hashes));
  let own = h.own.fold(Map::new(), |acc: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
    acc.insert(x.name, x.hash));
  let specs = by_name(h.specs);
  let texts = by_name(h.spec_texts);
  let checks = by_name(h.spec_checks);
  let listed = |m: Map<Bytes, List<Bytes>>, name: Bytes|
    match m.get(name) { Some(xs) -> xs, None -> [] };
  {
    nodes: forms.order.map(|v: Int| {
      let s = shapes.nodes.get(v);
      let hash = match h.hashes.get(v) { Some(x) -> x, None -> b"" };
      {
        name: s.name,
        decl: s.decl,
        hash: hash,
        own: if s.decl { None } else { own.get(s.name) },
        specs: if s.decl { [] } else { listed(specs, s.name) },
        spec_texts: if s.decl { [] } else { listed(texts, s.name) },
        spec_checks: if s.decl { [] } else { listed(checks, s.name) },
        contract: if s.decl { b"" }
        else { match h.contracts.get(v) { Some(c) -> c, None -> hash } },
        check: if s.decl { hash } else { match h.checks.get(v) { Some(c) -> c, None -> hash } },
        body: match h.bodies.get(v) { Some(b) -> b, None -> b"" },
        edges: refs(out.graph.edges.get(v)),
        effects: refs(h.enumerations.get(v)),
        clauses: refs(h.clauses.get(v)),
      }
    }),
    tests: range(0, forms.tests.len()).map(|i: Int|
      {
        key: forms.tests.get(i).key,
        hash: h.tests.get(i),
        body: h.test_bodies.get(i),
        text: h.test_texts.get(i),
        refs: refs(h.test_refs.get(i)),
        runs: refs(h.test_runs.get(i)),
        listing: refs(h.test_listings.get(i)),
      }),
    laws: range(0, forms.laws.len()).map(|i: Int|
      {
        key: forms.laws.get(i).key,
        hash: h.laws.get(i),
        text: h.law_texts.get(i),
        refs: refs(h.law_refs.get(i)),
      }),
  }
}

/// The nodes of the modules `keep` names, paired by `index.order` as `assemble` pushed them.
pub fn fixed_nodes(
  index: Index,
  hashes: HashOutput,
  keep: Map<Bytes, Bool>,
) -> List<Fixed> / {abort.raise} = {
  let node_refs = |refs: List<Int>|
    refs.map(|r: Int| { name: index.nodes.get(r).name, decl: is_decl(index.nodes.get(r)) });
  let edges_of = |v: Int, node: Node|
    match hashes.refs.edges.at(v) {
      Some(refs) -> node_refs(refs),
      None ->
        node_refs(
          refs_of(index, node.module, |encoder: Encoder| normalize_node(encoder, node.body)),
        ),
    };
  let own = hashes.own.fold(
    Map::new(),
    |acc: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }| acc.insert(x.name, x.hash),
  );
  let specs = hashes.specs.fold(
    Map::new(),
    |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, hashes: List<Bytes> }|
      acc.insert(x.name, x.hashes),
  );
  let texts = hashes.spec_texts.fold(
    Map::new(),
    |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, hashes: List<Bytes> }|
      acc.insert(x.name, x.hashes),
  );
  let checks = hashes.spec_checks.fold(
    Map::new(),
    |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, hashes: List<Bytes> }|
      acc.insert(x.name, x.hashes),
  );
  let named = |xs: List<{ name: Bytes, hash: Bytes }>|
    xs.fold(Map::new(), |acc: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
      acc.insert(x.name, x.hash));
  let contracts = named(hashes.contracts);
  let check_keys = named(hashes.checks);
  let listed = |m: Map<Bytes, List<Bytes>>, name: Bytes|
    match m.get(name) { Some(xs) -> xs, None -> [] };
  let walked = index.order.fold(
    { body: 0, def: 0, decl: 0, out: [] },
    |acc: { body: Int, def: Int, decl: Int, out: List<Fixed> }, e: IndexEntry|
      match e {
        DefEntry(v) -> {
          let node = index.nodes.get(v);
          let decl = is_decl(node);
          let body = hashes.bodies.get(acc.body);
          if body.name != node.name {
            panic("hashes and the index disagree on the order of nodes")
          };
          let next = {
            ..acc,
            body: acc.body + 1,
            def: if decl { acc.def } else { acc.def + 1 },
            decl: if decl { acc.decl + 1 } else { acc.decl },
          };
          if !keep.contains(index.mods.get(node.module).name) { next } else {
            {
              ..next,
              out: next.out.push({
                name: node.name,
                decl: decl,
                hash: if decl { hashes.decls.get(acc.decl).hash }
                else { hashes.defs.get(acc.def).hash },
                own: if decl { None } else { own.get(node.name) },
                specs: if decl { [] } else { listed(specs, node.name) },
                spec_texts: if decl { [] } else { listed(texts, node.name) },
                spec_checks: if decl { [] } else { listed(checks, node.name) },
                contract: if decl { b"" }
                else { match contracts.get(node.name) { Some(c) -> c, None -> b"" } },
                check: if decl { hashes.decls.get(acc.decl).hash }
                else { match check_keys.get(node.name) { Some(c) -> c, None -> b"" } },
                body: body.body,
                edges: edges_of(v, node),
                effects: node_refs(match hashes.enumerations.at(v) { Some(es) -> es, None -> [] }),
                clauses: node_refs(match hashes.refs.clauses.at(v) { Some(cs) -> cs, None -> [] }),
              }),
            }
          }
        },
        _ -> acc,
      },
  );
  walked.out
}

/// The nodes, tests and laws of the modules `keep` names as `hashes` fixed them.
pub fn fixing_of(
  index: Index,
  hashes: HashOutput,
  keep: Map<Bytes, Bool>,
) -> Fixing / {abort.raise} = {
  let refs = |rs: List<Int>|
    rs.map(|r: Int| { name: index.nodes.get(r).name, decl: is_decl(index.nodes.get(r)) });
  let kept = |module: Int| keep.contains(index.mods.get(module).name);
  {
    nodes: fixed_nodes(index, hashes, keep),
    tests: range(0, index.tests.len()).fold([], |acc: List<FixedTest>, i: Int| {
      let t = index.tests.get(i);
      if !kept(t.module) { acc } else {
        acc.push({
          key: t.key,
          hash: of_key(hashes.tests, t.key),
          body: of_key(hashes.test_bodies, t.key),
          text: of_key(hashes.test_texts, t.key),
          refs: refs(of_key(hashes.test_refs, t.key)),
          runs: refs(of_key(hashes.test_runs, t.key)),
          listing: refs(match hashes.refs.listings.get(t.key) { Some(xs) -> xs, None -> [] }),
        })
      }
    }),
    laws: range(0, index.laws.len()).fold([], |acc: List<FixedLaw>, i: Int| {
      let l = index.laws.get(i);
      if !kept(l.module) { acc } else {
        acc.push({
          key: l.key,
          hash: of_key(hashes.laws, l.key),
          text: of_key(hashes.law_texts, l.key),
          refs: refs(of_key(hashes.law_refs, l.key)),
        })
      }
    }),
  }
}

// Each body hashed with references as `pins` wrote them: an inherited move comes back to its pin, an edit does not.

pub type Pin = { name: Bytes, decl: Bool, hash: Bytes }
pub type Rehash = { name: Bytes, decl: Bool, fresh: Bytes, table: Bytes, component: Int }
pub type Rehashed = { nodes: List<Rehash>, tests: List<{ key: Bytes, hash: Bytes }> }

fn is_decl(node: Node) -> Bool = match node.body { NodeFn(_) -> false, _ -> true }

/// What a definition or a declaration named `name` is filed under among both.
pub fn pin_key(name: Bytes, decl: Bool) -> Bytes =
  Bytes::concat(if decl { b"decl " } else { b"def " }, name)

pub fn rehash_index(index: Index, pins: List<Pin>) -> Rehashed / {abort.raise} = {
  let wanted = pins.fold(Map::new(), |acc: Map<Bytes, Bytes>, pin: Pin|
    acc.insert(pin_key(pin.name, pin.decl), pin.hash));
  let pinned = range(0, index.nodes.len()).fold(Map::new(), |acc: Map<Int, Bytes>, v: Int| {
    let node = index.nodes.get(v);
    match wanted.get(pin_key(node.name, is_decl(node))) { Some(h) -> acc.insert(v, h), None -> acc }
  });
  let over = over_of(index);
  let g = over.graph;
  let keyed = key_components(over, pinned, Map::new());
  let grouped = range(0, g.components.len()).fold(Map::new(), |acc: Map<Int, Int>, ci: Int| {
    let c = g.components.get(ci);
    if c.len() < 2 { acc } else { c.fold(acc, |a: Map<Int, Int>, v: Int| a.insert(v, ci)) }
  });
  let got = |m: Map<Int, Bytes>, v: Int| match m.get(v) { Some(h) -> h, None -> b"" };
  {
    nodes: range(0, index.nodes.len()).map(|v: Int| {
      let node = index.nodes.get(v);
      {
        name: node.name,
        decl: is_decl(node),
        fresh: got(keyed.fresh, v),
        table: got(keyed.hashes, v),
        component: match grouped.get(v) { Some(ci) -> ci, None -> 0 - 1 },
      }
    }),
    tests: over.shapes.tests.map(|t: ItemShape|
      {
        key: t.key,
        hash: match t.form {
          Some(f) -> blake3(filled_item(over, f.pieces, keyed.hashes, false).bytes),
          None -> b"",
        },
      }),
  }
}

fn started(m: Map<Bytes, List<Int>>, key: Bytes, vs: List<Int>) -> Map<Bytes, List<Int>> =
  m.insert(key, List::concat(match m.get(key) { Some(xs) -> xs, None -> [] }, vs))

/// What a program's hash tables are laid out over: each node by its name and whether it is a
/// declaration, its definitions, tests and laws in the order it lists them, each test by its key and
/// whether it is over cases, and each law by its key.
pub type Skeleton = {
  nodes: List<NodeRef>,
  order: List<IndexEntry>,
  tests: List<{ key: Bytes, cases: Bool }>,
  laws: List<Bytes>,
}

fn skeleton_of(index: Index) -> Skeleton =
  {
    nodes: index.nodes.map(|node: Node| { name: node.name, decl: is_decl(node) }),
    order: index.order,
    tests: index.tests.map(|t: TestNode| { key: t.key, cases: t.def.cases != None }),
    laws: index.laws.map(|l: LawNode| l.key),
  }

/// `xs`, each under the key at its place in `keys`.
fn by_key<a>(keys: List<Bytes>, xs: List<a>) -> Map<Bytes, a> / {abort.raise} =
  range(0, keys.len()).fold(Map::new(), |acc: Map<Bytes, a>, i: Int|
    acc.insert(keys.get(i), xs.get(i)))

fn assemble(sk: Skeleton, edges: List<List<Int>>, h: Hashed) -> HashOutput / {abort.raise} = {
  let fns = range(0, sk.nodes.len()).fold(Map::new(), |acc: Map<Bytes, Int>, v: Int| {
    let node = sk.nodes.get(v);
    if node.decl { acc } else { acc.insert(node.name, v) }
  });
  let declared = range(0, sk.nodes.len()).fold(Map::new(), |acc: Map<Bytes, List<Int>>, v: Int| {
    let node = sk.nodes.get(v);
    if node.decl { started(acc, node.name, [v]) } else { acc }
  });
  let tested = range(0, sk.tests.len()).fold(Map::new(), |acc: Map<Bytes, List<Int>>, i: Int|
    started(acc, sk.tests.get(i).key, h.test_refs.get(i)));
  let items = range(0, sk.laws.len()).fold(tested, |acc: Map<Bytes, List<Int>>, i: Int|
    started(acc, sk.laws.get(i), h.law_refs.get(i)));
  let names_at = |refs: List<Int>| refs.map(|r: Int| sk.nodes.get(r).name);
  let tests = sk.tests.map(|t: { key: Bytes, cases: Bool }| t.key);
  let empty: HashOutput = {
    defs: [],
    own: h.own,
    decls: [],
    tests: by_key(tests, h.tests),
    laws: by_key(sk.laws, h.laws),
    specs: h.specs,
    spec_texts: h.spec_texts,
    law_texts: by_key(sk.laws, h.law_texts),
    deps: [],
    refs: {
      names: sk.nodes.map(|node: NodeRef| node.name),
      decls: sk.nodes.map(|node: NodeRef| node.decl),
      edges: edges,
      fns: fns,
      declared: declared,
      items: items,
      cases: range(0, sk.tests.len()).fold(Map::new(), |acc: Map<Bytes, List<Int>>, i: Int| {
        let t = sk.tests.get(i);
        if !t.cases { acc } else { started(acc, t.key, h.test_runs.get(i)) }
      }),
      clauses: h.clauses,
      listings: range(0, sk.tests.len()).fold(Map::new(), |acc: Map<Bytes, List<Int>>, i: Int| {
        let t = sk.tests.get(i);
        if !t.cases { acc } else { started(acc, t.key, h.test_listings.get(i)) }
      }),
    },
    bodies: [],
    test_bodies: by_key(tests, h.test_bodies),
    test_texts: by_key(tests, h.test_texts),
    contracts: [],
    checks: [],
    spec_checks: h.spec_checks,
    test_refs: by_key(tests, h.test_refs),
    test_runs: by_key(tests, h.test_runs),
    law_refs: by_key(sk.laws, h.law_refs),
    enumerations: h.enumerations,
  };
  sk.order.fold({ out: empty, deps_at: Map::new() }, |acc: Recording, e: IndexEntry|
    match e {
      DefEntry(v) -> {
        let node = sk.nodes.get(v);
        let bodied: HashOutput = match h.bodies.get(v) {
          None -> acc.out,
          Some(body) -> { ..acc.out, bodies: acc.out.bodies.push({ name: node.name, body: body }) },
        };
        let keyed: HashOutput = match h.hashes.get(v) {
          None -> bodied,
          Some(hash) -> if node.decl {
            { ..bodied, decls: bodied.decls.push({ name: node.name, hash: hash }) }
          } else {
            {
              ..bodied,
              defs: bodied.defs.push({ name: node.name, hash: hash }),
              contracts: bodied.contracts.push({
                name: node.name,
                hash: match h.contracts.get(v) { Some(c) -> c, None -> hash },
              }),
              checks: bodied.checks.push({
                name: node.name,
                hash: match h.checks.get(v) { Some(c) -> c, None -> hash },
              }),
            }
          },
        };
        record({ ..acc, out: keyed }, node.name, names_at(edges.get(v)))
      },
      TestEntry(i) -> record(acc, sk.tests.get(i).key, names_at(h.test_refs.get(i))),
      // A law's references are what it is a claim about.
      LawEntry(i) -> record(acc, sk.laws.get(i), names_at(h.law_refs.get(i))),
    }).out
}

/// The hash tables of the program `sk` lays out, each node, test and law as `fixing` says hashing
/// fixed it: what a load assembled from its modules' answers holds in place of hashing it.
pub fn hashes_fixed(sk: Skeleton, fixing: Fixing) -> HashOutput / {abort.raise} = {
  let keys = range(0, sk.nodes.len()).fold(Map::new(), |acc: Map<Bytes, Int>, v: Int| {
    let node = sk.nodes.get(v);
    acc.insert(pin_key(node.name, node.decl), v)
  });
  let ids = |refs: List<NodeRef>|
    refs.fold([], |es: List<Int>, r: NodeRef|
      match keys.get(pin_key(r.name, r.decl)) { Some(w) -> es.push(w), None -> es });
  let held = fixing.nodes.fold(Map::new(), |acc: Map<Int, Fixed>, f: Fixed|
    match keys.get(pin_key(f.name, f.decl)) { Some(v) -> acc.insert(v, f), None -> acc });
  let tests = fixing.tests.fold(Map::new(), |acc: Map<Bytes, FixedTest>, t: FixedTest|
    acc.insert(t.key, t));
  let laws = fixing.laws.fold(Map::new(), |acc: Map<Bytes, FixedLaw>, l: FixedLaw|
    acc.insert(l.key, l));
  let test_of = |key: Bytes|
    match tests.get(key) {
      Some(t) -> t,
      None -> panic("no test is fixed under " ++ String::of_bytes_lossy(key)),
    };
  let law_of = |key: Bytes|
    match laws.get(key) {
      Some(l) -> l,
      None -> panic("no law is fixed under " ++ String::of_bytes_lossy(key)),
    };
  let field = |pick: (Fixed) -> Bytes|
    held.fold(Map::new(), |acc: Map<Int, Bytes>, v: Int, f: Fixed| acc.insert(v, pick(f)));
  let stated = sk.order.fold(
    { own: [], specs: [], spec_texts: [], spec_checks: [] },
    |acc: Stated, e: IndexEntry|
      match e {
        DefEntry(v) -> match held.get(v) {
          Some(f) -> if f.decl { acc } else { fixed_stated(acc, f.name, f) },
          None -> acc,
        },
        _ -> acc,
      },
  );
  let tested = sk.tests.map(|t: { key: Bytes, cases: Bool }| test_of(t.key));
  let lawful = sk.laws.map(law_of);
  assemble(
    sk,
    range(0, sk.nodes.len()).map(|v: Int|
      match held.get(v) { Some(f) -> ids(f.edges), None -> [] }),
    {
      hashes: field(|f: Fixed| f.hash),
      bodies: field(|f: Fixed| f.body),
      tests: tested.map(|t: FixedTest| t.hash),
      test_bodies: tested.map(|t: FixedTest| t.body),
      test_texts: tested.map(|t: FixedTest| t.text),
      test_refs: tested.map(|t: FixedTest| ids(t.refs)),
      test_runs: tested.map(|t: FixedTest| ids(t.runs)),
      laws: lawful.map(|l: FixedLaw| l.hash),
      law_refs: lawful.map(|l: FixedLaw| ids(l.refs)),
      law_texts: lawful.map(|l: FixedLaw| l.text),
      own: stated.own,
      specs: stated.specs,
      spec_texts: stated.spec_texts,
      contracts: held.fold(Map::new(), |acc: Map<Int, Bytes>, v: Int, f: Fixed|
        if f.decl || f.contract.len() == 0 { acc } else { acc.insert(v, f.contract) }),
      checks: held.fold(Map::new(), |acc: Map<Int, Bytes>, v: Int, f: Fixed|
        if f.decl || f.check.len() == 0 { acc } else { acc.insert(v, f.check) }),
      spec_checks: stated.spec_checks,
      enumerations: range(0, sk.nodes.len()).map(|v: Int|
        match held.get(v) { Some(f) -> ids(f.effects), None -> [] }),
      clauses: range(0, sk.nodes.len()).map(|v: Int|
        match held.get(v) { Some(f) -> ids(f.clauses), None -> [] }),
      test_listings: tested.map(|t: FixedTest| ids(t.listing)),
    },
  )
}

/// Names collide across namespaces, so entries are merged rather than replaced.
fn record(a: Recording, name: Bytes, deps: List<Bytes>) -> Recording / {abort.raise} = {
  let out: HashOutput = a.out;
  match a.deps_at.get(name) {
    Some(i) -> {
      let existing = out.deps.get(i);
      {
        out: {
          ..out,
          deps: out.deps.set(i, {
            name: name,
            names: deps.fold(existing.names, |acc: List<Bytes>, d: Bytes|
              if acc.contains(d) { acc } else { acc.push(d) }),
          }),
        },
        deps_at: a.deps_at,
      }
    },
    None ->
      {
        out: { ..out, deps: out.deps.push({ name: name, names: deps }) },
        deps_at: a.deps_at.insert(name, out.deps.len()),
      },
  }
}

// --- Closures ---------------------------------------------------------------------------------------

type Walk = { seen: List<Bool>, frontier: List<Int>, all: List<Int> }

fn met(w: Walk, v: Int) -> Walk / {abort.raise} =
  if w.seen.get(v) { w }
  else { { seen: w.seen.set(v, true), frontier: w.frontier.push(v), all: w.all.push(v) } }

/// Every node `edges` lead to from `from`, those included: as a mark per node, and in the order met.
/// Every closure and every cut is this walk, over nodes: what differs is where it starts, which
/// edges it follows, and what is read off the nodes it met.
fn walked(
  edges: List<List<Int>>,
  from: List<Int>,
) -> { seen: List<Bool>, all: List<Int> } / {abort.raise} = {
  let n = edges.len();
  let start = from.fold({ seen: range(0, n).map(|i: Int| false), frontier: [], all: [] }, met);
  iterate(start, n + 2, |w: Walk|
    if w.frontier.len() == 0 { Stop({ seen: w.seen, all: w.all }) } else {
      Continue(
        w.frontier.fold({ ..w, frontier: [] }, |acc: Walk, v: Int| edges.get(v).fold(acc, met)),
      )
    })
}

/// What a walk starts from, and what a question is asked of: the function of a name, the type or
/// effect of one, or the test or law of a key. A name alone says none of these.
pub type Which = | TheFn(Bytes) | TheDecl(Bytes) | TheItem(Bytes)

/// What a walk reached: each function, and each type or effect, by name, one apart from the other.
pub type Reach = { fns: Map<Bytes, Bool>, decls: Map<Bytes, Bool> }

/// Where a walk from `which` starts: at a function or a declaration itself, and at what a test or
/// a law references.
fn nodes_of(r: Refs, which: Which) -> List<Int> =
  match which {
    TheFn(name) -> match r.fns.get(name) { Some(v) -> [v], None -> [] },
    TheDecl(name) -> match r.declared.get(name) { Some(vs) -> vs, None -> [] },
    TheItem(key) -> match r.items.get(key) { Some(vs) -> vs, None -> [] },
  }

fn starting(r: Refs, roots: List<Which>) -> List<Int> =
  roots.fold([], |acc: List<Int>, which: Which| acc.concat(nodes_of(r, which)))

/// Everything `key` could stand for: the function and the declaration of that name, and the test
/// or law of that key.
fn spelt(key: Bytes) -> List<Which> = [TheItem(key), TheFn(key), TheDecl(key)]

fn read_off(r: Refs, nodes: List<Int>) -> Reach / {abort.raise} =
  nodes.fold({ fns: Map::new(), decls: Map::new() }, |acc: Reach, v: Int|
    if r.decls.get(v) { { ..acc, decls: acc.decls.insert(r.names.get(v), true) } }
    else { { ..acc, fns: acc.fns.insert(r.names.get(v), true) } })

/// What `roots` reach through what each references, those that are definitions included.
pub fn reach(hashes: HashOutput, roots: List<Which>) -> Reach / {abort.raise} =
  read_off(hashes.refs, walked(hashes.refs.edges, starting(hashes.refs, roots)).all)

/// Every name some definition or declaration of which `keys` reach, and each of the keys the
/// program knows, each key read as everything it could spell: a superset, by name, of what any one
/// of them reaches. It is what a key over a closure may take, and never what is shipped, printed or
/// listed as reached: `reach` is.
pub fn closure_of(hashes: HashOutput, keys: List<Bytes>) -> Map<Bytes, Bool> / {abort.raise} = {
  let r = hashes.refs;
  let known = keys.filter(|k: Bytes|
    r.items.contains(k) || r.fns.contains(k) || r.declared.contains(k));
  let reached = reach(hashes, known.fold([], |acc: List<Which>, k: Bytes| acc.concat(spelt(k))));
  known.fold(Map::new(), |acc: Map<Bytes, Bool>, k: Bytes| acc.insert(k, true)).merge(
    reached.fns,
  ).merge(
    reached.decls,
  )
}

/// The functions `roots` reach, each by name, a definition's specification clauses reached with it:
/// what a `requires`, an `ensures` or a `cost` of a reached definition names is reached, and what
/// that reaches in turn. A function is answered only where it is reached itself: a type or an effect
/// that shares its name is another definition, and reaching one reaches nothing the function does.
pub fn reached_functions(
  hashes: HashOutput,
  roots: List<Which>,
) -> Map<Bytes, Bool> / {abort.raise} = {
  let r = hashes.refs;
  read_off(r, walked(with_clauses(r), starting(r, roots)).all).fns
}

/// Each node's references, with what its specification clauses reference.
fn with_clauses(r: Refs) -> List<List<Int>> / {abort.raise} =
  range(0, r.edges.len()).map(|v: Int|
    r.edges.get(v).concat(match r.clauses.at(v) { Some(cs) -> cs, None -> [] }))

/// The functions the listings of the tests over cases `keys` reach, with what a reached definition's
/// clauses reach: what a unit that lists their tables holds, and none of what a case runs.
pub fn listing_reach(hashes: HashOutput, keys: List<Bytes>) -> Map<Bytes, Bool> / {abort.raise} = {
  let r = hashes.refs;
  let starts = keys.fold([], |acc: List<Int>, k: Bytes|
    match r.listings.get(k) { Some(vs) -> acc.concat(vs), None -> acc });
  read_off(r, walked(with_clauses(r), starts).all).fns
}

/// What `which` references itself, each a function or a declaration, in the order its text first
/// names them.
pub fn named_in(hashes: HashOutput, which: Which) -> List<NodeRef> / {abort.raise} = {
  let r = hashes.refs;
  let direct = match which {
    TheItem(_) -> nodes_of(r, which),
    _ -> nodes_of(r, which).fold([], |acc: List<Int>, v: Int| acc.concat(r.edges.get(v))),
  };
  direct.map(|v: Int| { name: r.names.get(v), decl: r.decls.get(v) })
}

/// Each node's referrers, by index.
fn back_edges(r: Refs) -> List<List<Int>> / {abort.raise} = {
  let n = r.names.len();
  // Each list is taken out of its slot before the push, so the push finds it unshared.
  range(0, n).fold(range(0, n).map(|i: Int| []), |acc: List<List<Int>>, v: Int|
    r.edges.get(v).fold(acc, |a: List<List<Int>>, w: Int| {
      let into = a.get(w);
      a.set(w, []).set(w, into.push(v))
    }))
}

/// What names a definition or a declaration: each function and each type or effect by name, and
/// each test and law by its key.
pub type Naming = { fns: List<Bytes>, decls: List<Bytes>, items: List<Bytes> }

/// What names `target` in its own text, or, `through` any number of references, reaches it. A
/// definition that names itself is among the first; none is among what reaches it.
pub fn naming(hashes: HashOutput, target: Which, through: Bool) -> Naming / {abort.raise} = {
  let r = hashes.refs;
  let targets = nodes_of(r, target);
  let n = r.names.len();
  let marked = if through { walked(back_edges(r), targets).seen } else {
    targets.fold(range(0, n).map(|i: Int| false), |acc: List<Bool>, v: Int| acc.set(v, true))
  };
  let holds = |vs: List<Int>| vs.fold(false, |b: Bool, v: Int| b || marked.get(v));
  let nodes = range(0, n).filter(|v: Int|
    if through { marked.get(v) && !targets.contains(v) } else { holds(r.edges.get(v)) });
  let found = read_off(r, nodes);
  {
    fns: found.fns.keys(),
    decls: found.decls.keys(),
    items: r.items.fold([], |acc: List<Bytes>, key: Bytes, vs: List<Int>|
      if holds(vs) { acc.push(key) } else { acc }),
  }
}

/// Every name and key the program knows whose closure holds one of `names`, a name read as
/// everything it could spell, as `closure_of` reads one: a superset, by name, for a key to take.
pub fn reaching(hashes: HashOutput, names: Map<Bytes, Bool>) -> Map<Bytes, Bool> / {abort.raise} = {
  let r = hashes.refs;
  let n = r.names.len();
  let seen = walked(
    back_edges(r),
    range(0, n).filter(|v: Int| names.contains(r.names.get(v))),
  ).seen;
  let named = range(0, n).fold(Map::new(), |acc: Map<Bytes, Bool>, v: Int|
    if seen.get(v) { acc.insert(r.names.get(v), true) } else { acc });
  r.items.fold(named, |acc: Map<Bytes, Bool>, k: Bytes, vs: List<Int>|
    if names.contains(k) || vs.fold(false, |b: Bool, v: Int| b || seen.get(v)) {
      acc.insert(k, true)
    } else { acc })
}

/// One function or declaration a build holds: its name, which of the two it is, the hash it is
/// filed under, and what it references, each by its place in the list that holds them all.
pub type Closed = { name: Bytes, decl: Bool, hash: Bytes, refs: List<Int> }

/// Every function and declaration the functions `roots` reach through what each references, those
/// included, in the order met. One with no hash is no part of a build.
pub fn held_by(hashes: HashOutput, roots: List<Bytes>) -> List<Closed> / {abort.raise} = {
  let r = hashes.refs;
  let defs = by_name(hashes.defs);
  let decls = by_name(hashes.decls);
  let hash_of = |v: Int| Map::get(if r.decls.get(v) { decls } else { defs }, r.names.get(v));
  let reached = walked(r.edges, starting(r, roots.map(|name: Bytes| TheFn(name)))).all.filter(
    |v: Int| hash_of(v) != None,
  );
  let place = range(0, reached.len()).fold(Map::new(), |acc: Map<Int, Int>, i: Int|
    acc.insert(reached.get(i), i));
  reached.map(|v: Int|
    {
      name: r.names.get(v),
      decl: r.decls.get(v),
      hash: match hash_of(v) { Some(h) -> h, None -> b"" },
      refs: r.edges.get(v).fold([], |acc: List<Int>, w: Int|
        match place.get(w) { Some(i) -> acc.push(i), None -> acc }),
    })
}

/// Every index `edges` lead to from `from`, those included, in the order met: the walk every
/// closure here is, for one over a graph of the caller's own.
pub fn walk(edges: List<List<Int>>, from: List<Int>) -> List<Int> / {abort.raise} =
  walked(edges, from).all

// --- What nothing reaches -------------------------------------------------------------------------------
// The roots: a `pub` item, `main`, a derived definition, a name led by `_`, and what a test or a law mentions.
// A spec clause is reached with its owner.

/// A fixed node is never reported: its own package's check answered for it.
pub fn unused(index: Index, fixed: List<Fixed> = []) -> List<Diag> / {abort.raise} =
  unused_over(
    index,
    node_edges_of(index, first_pass(index)),
    fixed,
    index.tests.map(|t: TestNode| test_roots_of(index, t)).concat(
      index.laws.map(|l: LawNode| law_roots_of(index, l)),
    ),
  )

/// Each node of `index` `first` normalized, by what the walk for what nothing uses leads to from it.
fn node_edges_of(index: Index, first: List<Finished>) -> List<List<Int>> / {abort.raise} =
  range(0, index.nodes.len()).map(|v: Int| node_edges(index, index.nodes.get(v), first.get(v).refs))

/// The nodes of `index` that `fixed` holds.
fn held_of(index: Index, fixed: List<Fixed>) -> Map<Int, Bool> / {abort.raise} = {
  let keys = node_keys(index);
  fixed.fold(Map::new(), |acc: Map<Int, Bool>, f: Fixed|
    match keys.get(pin_key(f.name, f.decl)) { Some(v) -> acc.insert(v, true), None -> acc })
}

fn unused_over(
  index: Index,
  edges: List<List<Int>>,
  fixed: List<Fixed>,
  item_roots: List<List<Int>>,
) -> List<Diag> / {abort.raise} = {
  let held = held_of(index, fixed);
  let n = index.nodes.len();
  let own = range(0, n).filter(|v: Int| is_root(index, index.nodes.get(v)));
  let roots = item_roots.fold(own, |acc: List<Int>, rs: List<Int>| acc.concat(rs));
  let seen = walked(edges, roots).seen;
  range(0, n).fold([], |acc: List<Diag>, v: Int|
    if seen.get(v) || held.contains(v) { acc }
    else { acc.push(never_used(index, index.nodes.get(v))) })
}

/// A node, a test or a law as the walk for what nothing uses meets it: where it stands, whether the
/// walk starts at it, the nodes it leads to, each as [`pin_key`] files it, and, for a node, the
/// warning it is given where nothing reaches it.
pub type UseNode = {
  key: Bytes,
  module: Int,
  span: Span,
  root: Bool,
  leads: List<Bytes>,
  unused: Option<Diag>,
}

derive bin for UseNode

fn node_span(node: Node) -> Span =
  match node.body { NodeFn(d) -> d.span, NodeType(d) -> d.span, NodeEffect(d) -> d.span }

/// Each node of `index` but those `held` holds, and each test and law, `tests` and `laws` what each
/// test and law leads to, as the walk for what nothing uses meets them.
fn use_nodes(
  index: Index,
  edges: List<List<Int>>,
  held: Map<Int, Bool>,
  tests: List<List<Int>>,
  laws: List<List<Int>>,
) -> List<UseNode> / {abort.raise} = {
  let keys = index.nodes.map(|node: Node| pin_key(node.name, is_decl(node)));
  range(0, index.nodes.len()).fold([], |acc: List<UseNode>, v: Int|
    if held.contains(v) { acc } else {
      let node = index.nodes.get(v);
      acc.push({
        key: keys.get(v),
        module: node.module,
        span: node_span(node),
        root: is_root(index, node),
        leads: edges.get(v).map(|w: Int| keys.get(w)),
        unused: Some(never_used(index, node)),
      })
    }).concat(
    item_uses(index, index.tests, tests, index.laws, laws),
  )
}

/// `tests` and `laws`, `test_leads` and `law_leads` what each leads to, as the walk for what nothing
/// uses meets them: each a root.
fn item_uses(
  index: Index,
  tests: List<TestNode>,
  test_leads: List<List<Int>>,
  laws: List<LawNode>,
  law_leads: List<List<Int>>,
) -> List<UseNode> / {abort.raise} = {
  let named = |vs: List<Int>|
    vs.map(|v: Int| {
      let node = index.nodes.get(v);
      pin_key(node.name, is_decl(node))
    });
  let item = |module: Int, span: Span, leads: List<Int>|
    { key: b"", module: module, span: span, root: true, leads: named(leads), unused: None };
  range(0, tests.len()).map(|i: Int| {
    let t = tests.get(i);
    item(t.module, t.def.span, test_leads.get(i))
  }).concat(
    range(0, laws.len()).map(|i: Int| {
      let l = laws.get(i);
      item(l.module, l.def.span, law_leads.get(i))
    }),
  )
}

/// The warnings `uses`, the nodes, tests and laws of one module, give the nodes nothing reaches.
pub fn unreached(uses: List<UseNode>) -> List<Diag> / {abort.raise} = {
  let by_key = uses.fold(Map::new(), |acc: Map<Bytes, UseNode>, r: UseNode|
    if r.key.len() == 0 { acc } else { acc.insert(r.key, r) });
  let seen = iterate(
    {
      seen: Map::new(),
      work: uses.fold([], |acc: List<Bytes>, r: UseNode|
        if !r.root { acc }
        else if r.key.len() == 0 { acc.concat(r.leads) }
        else { acc.push(r.key) }),
    },
    1000000000,
    |x: { seen: Map<Bytes, Bool>, work: List<Bytes> }|
      match x.work {
        [] -> Stop(x.seen),
        [k, ..rest] -> if x.seen.contains(k) { Continue({ ..x, work: rest }) } else {
          Continue({
            seen: x.seen.insert(k, true),
            work: match by_key.get(k) { Some(r) -> r.leads.concat(rest), None -> rest },
          })
        },
      },
  );
  uses.fold([], |acc: List<Diag>, r: UseNode|
    match r.unused { Some(d) -> if seen.contains(r.key) { acc } else { acc.push(d) }, None -> acc })
}

/// What a test keeps from being unused: what it references, its cases' table and label among them,
/// and the types its lambdas say they return.
fn test_roots_of(index: Index, t: TestNode) -> List<Int> / {abort.raise} =
  listed_refs(index, t).fold(
    refs_of(index, t.module, |encoder: Encoder| test_def(encoder, t.def)),
    |acc: List<Int>, r: Int| acc.push_unique(r),
  ).concat(
    ret_refs(index, t.module, match t.def.cases {
      Some(c) -> [t.def.body, c.table, c.label],
      None -> [t.def.body],
    }),
  )

/// The same of a law: what it references, and the types its lambdas say they return.
fn law_roots_of(index: Index, l: LawNode) -> List<Int> / {abort.raise} = {
  let exprs = match l.def.guard { Some(g) -> [g, l.def.body], None -> [l.def.body] };
  refs_of(index, l.module, |encoder: Encoder| law_def(encoder, l.def)).concat(
    ret_refs(index, l.module, exprs),
  )
}

fn refs_of<| e>(
  index: Index,
  module: Int,
  encode: (Encoder) -> Encoder / e,
) -> List<Int> / {abort.raise | e} = filled(template_of(index, module, encode), blank()).refs

/// `own` and what the node's specification clauses reference.
fn with_spec_refs(index: Index, node: Node, own: List<Int>) -> List<Int> / {abort.raise} =
  match node.body {
    NodeFn(d) ->
      d.spec.fold(own, |acc: List<Int>, clause: SpecClause|
        acc.concat(
          refs_of(index, node.module, |encoder: Encoder| spec_clause(encoder, d, clause)),
        )),
    _ -> own,
  }

/// `own` is what normalizing the node alone references.
fn node_edges(index: Index, node: Node, own: List<Int>) -> List<Int> / {abort.raise} =
  match node.body {
    NodeFn(d) -> {
      let clauses = with_spec_refs(index, node, own);
      let defaults = d.params.fold([], |acc: List<Expr>, param: Param|
        match param.default { Some(x) -> acc.push(x), None -> acc });
      clauses.concat(
        ret_refs(
          index,
          node.module,
          defaults.concat(d.spec.map(|clause: SpecClause| clause.expr)).push(d.body),
        ),
      )
    },
    _ -> own,
  }

/// The encoding leaves a lambda's written return type out, and a type named only there is still used.
fn ret_refs(index: Index, module: Int, exprs: List<Expr>) -> List<Int> / {abort.raise} =
  refs_of(index, module, |encoder: Encoder|
    exprs.fold([], |acc: List<TypeExpr>, expr: Expr| lambda_rets(expr, acc)).fold(
      encoder,
      |acc: Encoder, ty: TypeExpr| type_expr(acc, ty),
    ))

fn lambda_rets(e: Expr, out: List<TypeExpr>) -> List<TypeExpr> =
  match e {
    ELambda(l) -> lambda_rets(l.body, match l.ret { Some(t) -> out.push(t), None -> out }),
    ELit(_) -> out,
    ETagged(t) -> t.holes.fold(out, |acc: List<TypeExpr>, h: Hole| lambda_rets(h.value, acc)),
    EVar(_) -> out,
    EBad(_) -> out,
    EBinary(b) -> lambda_rets(b.rhs, lambda_rets(b.lhs, out)),
    EUnary(u) -> lambda_rets(u.operand, out),
    EApp(a) ->
      a.args.fold(lambda_rets(a.func, out), |acc: List<TypeExpr>, x: Expr| lambda_rets(x, acc)),
    EIf(i) -> lambda_rets(i.else_branch, lambda_rets(i.then_branch, lambda_rets(i.cond, out))),
    EMatch(m) ->
      m.arms.fold(lambda_rets(m.scrutinee, out), |acc: List<TypeExpr>, arm: MatchArm|
        lambda_rets(arm.body, match arm.guard { Some(g) -> lambda_rets(g, acc), None -> acc })),
    EBlock(b) -> {
      let walked = b.stmts.fold(out, |acc: List<TypeExpr>, s: Stmt|
        match s {
          SLet(x) -> lambda_rets(x.value, acc),
          SLetElse(x) -> lambda_rets(x.fallback, lambda_rets(x.value, acc)),
          SExpr(x) -> lambda_rets(x, acc),
          SAssign(x) -> lambda_rets(x.value, acc),
        });
      match b.tail { Some(t) -> lambda_rets(t, walked), None -> walked }
    },
    ERecord(r) -> r.fields.fold(out, |acc: List<TypeExpr>, f: RecField| lambda_rets(f.value, acc)),
    ERecordUpdate(r) ->
      r.fields.fold(lambda_rets(r.base, out), |acc: List<TypeExpr>, f: RecField|
        lambda_rets(f.value, acc)),
    ETry(t) -> lambda_rets(t.operand, out),
    EField(f) -> lambda_rets(f.base, out),
    EList(l) -> l.items.fold(out, |acc: List<TypeExpr>, x: Expr| lambda_rets(x, acc)),
    EPerform(p) -> p.args.fold(out, |acc: List<TypeExpr>, x: Expr| lambda_rets(x, acc)),
    EHandle(h) -> {
      let inits = h.vars.fold(out, |acc: List<TypeExpr>, v: HandlerVar| lambda_rets(v.init, acc));
      let clauses = h.clauses.fold(
        lambda_rets(h.body, inits),
        |acc: List<TypeExpr>, c: HandleClause| lambda_rets(c.body, acc),
      );
      match h.ret { Some(rc) -> lambda_rets(rc.body, clauses), None -> clauses }
    },
    EWithHold(c) -> lambda_rets(c.body, lambda_rets(c.release, lambda_rets(c.acquire, out))),
    ESimulate(s) -> lambda_rets(s.body, out),
    ETryBlock(t) -> lambda_rets(t.body, out),
    EParallel(v) -> v.branches.fold(out, |acc: List<TypeExpr>, x: Expr| lambda_rets(x, acc)),
  }

/// A schema's guard is a root, so a schema nothing instantiates is reported once, by its own name.
fn is_root(index: Index, node: Node) -> Bool / {abort.raise} =
  node.simple.starts_with(b"_")
    || (match node.body {
      NodeFn(d) ->
        is_pub(d.vis) || node.simple == b"main"
          || index.mods.get(node.module).derived.fold(false, |b: Bool, x: Derived|
            b || x.span == d.span)
          || (match schema_of(index.mods.get(node.module).module, d) {
            Some(schema) -> schema.name.name != node.simple,
            None -> false,
          }),
      NodeType(d) -> is_pub(d.vis),
      NodeEffect(d) -> is_pub(d.vis),
    })

fn never_used(index: Index, node: Node) -> Diag / {abort.raise} = {
  let named: { kind: Bytes, span: Span } = match node.body {
    NodeFn(d) ->
      {
        kind: match schema_of(index.mods.get(node.module).module, d) {
          Some(_) -> b"law schema",
          None -> b"fn",
        },
        span: d.name.span,
      },
    NodeType(d) -> { kind: b"type", span: d.name.span },
    NodeEffect(d) -> { kind: b"effect", span: d.name.span },
  };
  {
    code: b"W0611",
    notes: 0,
    labels: [label_at(node.module, named.span, true, b"never used")],
    text: b"",
    message: Bytes::concat_all([named.kind, b" `", node.name, b"` is never used"]),
    notes_text: [],
    severity: b"warning",
    fixes: [],
  }
}

// --- The dump -------------------------------------------------------------------------------------------

fn hexes(hs: List<Bytes>) -> Bytes / {abort.raise} =
  range(0, hs.len()).fold(b"", |acc: Bytes, i: Int|
    if i == 0 { hex(hs.get(i)) } else { Bytes::concat_all([acc, b",", hex(hs.get(i))]) })

fn names_text(ns: List<Bytes>) -> Bytes / {abort.raise} =
  range(0, ns.len()).fold(b"", |acc: Bytes, i: Int|
    if i == 0 { ns.get(i) } else { Bytes::concat_all([acc, b",", ns.get(i)]) })

fn dump_keyed(tag: Bytes, m: Map<Bytes, Bytes>) -> Bytes / {abort.raise} =
  m.fold(b"", |acc: Bytes, key: Bytes, h: Bytes|
    Bytes::concat_all([acc, tag, b";", key, b";", hex(h), b";"]))

fn dump_hashes(out: HashOutput) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    Bytes::concat_all(
      out.defs.map(|d: { name: Bytes, hash: Bytes }|
        Bytes::concat_all([b"H;", d.name, b";", hex(d.hash), b";"])),
    ),
    Bytes::concat_all(
      out.decls.map(|d: { name: Bytes, hash: Bytes }|
        Bytes::concat_all([b"Y;", d.name, b";", hex(d.hash), b";"])),
    ),
    dump_keyed(b"T", out.tests),
    dump_keyed(b"L", out.laws),
    dump_keyed(b"W", out.law_texts),
    Bytes::concat_all(
      out.own.map(|d: { name: Bytes, hash: Bytes }|
        Bytes::concat_all([b"O;", d.name, b";", hex(d.hash), b";"])),
    ),
    Bytes::concat_all(
      out.specs.map(|s: { name: Bytes, hashes: List<Bytes> }|
        Bytes::concat_all([b"S;", s.name, b";", hexes(s.hashes), b";"])),
    ),
    Bytes::concat_all(
      out.spec_texts.map(|s: { name: Bytes, hashes: List<Bytes> }|
        Bytes::concat_all([b"X;", s.name, b";", hexes(s.hashes), b";"])),
    ),
    Bytes::concat_all(
      out.deps.map(|d: { name: Bytes, names: List<Bytes> }|
        Bytes::concat_all([b"D;", d.name, b";", names_text(d.names), b";"])),
    ),
    Bytes::concat_all(
      out.deps.map(|d: { name: Bytes, names: List<Bytes> }|
        Bytes::concat_all([
          b"C;",
          d.name,
          b";",
          names_text(closure_of(out, [d.name]).keys()),
          b";",
        ])),
    ),
  ])

type Parsed = { name: Bytes, module: Module, derived: List<Derived>, diags: List<Diag> }

/// The driver's order: parse with the rewrites, expand every `derive`, resolve, hash.
pub fn hash_dump(sources: List<Source>) -> String / {abort.raise} = {
  let parsed = range(0, sources.len()).map(|i: Int| {
    let s = sources.get(i);
    let r = parse(s.src);
    let x = expand(r.node, r.parser.diags);
    let d: Expansion = expand_derives(i, s.name, x.module);
    { name: s.name, module: d.module, derived: d.derived, diags: d.diags }
  });
  let expansion = parsed.fold([], |acc: List<Diag>, p: Parsed| acc.concat(p.diags));
  let mods = parsed.map(|p: Parsed| { name: p.name, module: p.module, derived: p.derived });
  let head = Bytes::concat_all([b"K;", ascii_of_int(sources.len()), b";"]);
  let body = if expansion.len() > 0 { b"E;".concat(dump_diags(expansion)) } else {
    match resolve_modules(mods) {
      ResolveFailed(ds) -> b"E;".concat(dump_diags(ds)),
      ResolveSucceeded(x) -> {
        let built = build_index(x.mods, x.r);
        if built.diags.len() > 0 { b"E;".concat(dump_diags(built.diags)) }
        else { dump_hashes(hash_index(built.index)) }
      },
    }
  };
  String::of_bytes(head.concat(body))
}

// --- Stored bodies back to source ------------------------------------------------------------

pub type Refusal = { message: Bytes, notes: List<Bytes> }
pub type Printing = | Printed(List<{ module: Bytes, text: Bytes }>) | Unprintable(Refusal)

type Part = {
  members: List<Bytes>,
  picks: List<List<Choice>>,
  hashes: List<Bytes>,
  names: List<Bytes>,
  public: List<Bool>,
  module: Bytes,
  binder: Bytes,
  printed: Bool,
}
type Slot = { part: Int, class: Int }
/// `apart` is a printing that sets each body in a module of its own, away from the one that wrote it.
/// `meant` is what each definition names, where the caller said, by `meant_key`.
type Layout = {
  parts: List<Part>,
  by_hash: Map<Bytes, List<Slot>>,
  relink: Map<Bytes, Bytes>,
  apart: Bool,
  meant: Map<Bytes, Map<Bytes, Bool>>,
}
/// The import graph the print has laid down so far travels with the printer: a home is chosen
/// with it in view, so a reference never closes a cycle the source did not have. `room` is how
/// much deeper a body may nest: each level reads a byte, so a definition's length is its room.
/// `meant` is every name the definition being printed names, and empty where nothing said.
type BodyPrinter = {
  layout: Layout,
  part: Int,
  own: Bytes,
  graph: Map<Bytes, List<Bytes>>,
  room: Int,
  meant: Map<Bytes, Bool>,
}

/// A hash is thirty-two bytes, so the name after it needs no separator.
fn meant_key(name: Bytes, hash: Bytes) -> Bytes = hash.concat(name)
/// `picks` is which candidate each call on a value of the body calls, in the order its bytes write
/// them (`Chose`), and `picked` how many of them are read.
type Decoder = {
  bytes: Bytes,
  pos: Int,
  picks: List<Choice>,
  picked: Int,
  values: Int,
  types: Int,
  rows: Int,
  labels: Int,
  imports: Map<Bytes, Bytes>,
  missing: Map<Bytes, Bool>,
  slots: Map<Bytes, Int>,
}
type Decoded = { decoder: Decoder, text: Bytes }
type DecodedInt = { decoder: Decoder, value: Int }
type DecodedFlag = { decoder: Decoder, value: Bool }
type DecodedOption = { decoder: Decoder, text: Bytes, some: Bool }
type DecodedList = { decoder: Decoder, texts: List<Bytes> }
type DecodedRef = { decoder: Decoder, hash: Bytes, class: Int }

fn cursor(b: Bytes, missing: Map<Bytes, Bool>) -> Decoder =
  {
    bytes: b,
    pos: 0,
    picks: [],
    picked: 0,
    values: 0,
    types: 0,
    rows: 0,
    labels: 0,
    imports: Map::new(),
    missing: missing,
    slots: Map::new(),
  }

fn read_bytes(decoder: Decoder, n: Int) -> Decoded / {abort.raise} =
  if decoder.pos + n > decoder.bytes.len() { panic("a stored body ends inside a value") } else {
    {
      decoder: { ..decoder, pos: decoder.pos + n },
      text: decoder.bytes.slice(decoder.pos, decoder.pos + n),
    }
  }

fn le_int(b: Bytes) -> Int = range(0, b.len()).fold(0, |a: Int, i: Int| a | b.at(i) << 8 * i)

fn read_int(decoder: Decoder, n: Int) -> DecodedInt / {abort.raise} = {
  let g = read_bytes(decoder, n);
  { decoder: g.decoder, value: le_int(g.text) }
}

fn read_u8(decoder: Decoder) -> DecodedInt / {abort.raise} = read_int(decoder, 1)

fn read_u32(decoder: Decoder) -> DecodedInt / {abort.raise} = read_int(decoder, 4)

fn read_text(decoder: Decoder) -> Decoded / {abort.raise} = {
  let n = read_u32(decoder);
  read_bytes(n.decoder, n.value)
}

fn read_bool(decoder: Decoder) -> DecodedFlag / {abort.raise} = {
  let r = read_u8(decoder);
  if r.value > 1 { panic("a byte that is not a boolean") }
  else { { decoder: r.decoder, value: r.value == 1 } }
}

fn peek(decoder: Decoder) -> Int / {abort.raise} =
  if decoder.pos < decoder.bytes.len() { decoder.bytes.at(decoder.pos) } else { 0 - 1 }

fn skip(decoder: Decoder) -> Decoder = { ..decoder, pos: decoder.pos + 1 }

fn expect(decoder: Decoder, want: Int, what: Bytes) -> Decoder / {abort.raise} = {
  let r = read_u8(decoder);
  if r.value == want { r.decoder } else {
    panic(
      String::of_bytes(
        Bytes::concat_all([b"expected ", what, b", found tag ", ascii_of_int(r.value)]),
      ),
    )
  }
}

fn read_count(decoder: Decoder) -> DecodedInt / {abort.raise} = {
  let r = read_u32(decoder);
  if r.value > r.decoder.bytes.len() - r.decoder.pos { panic("a count runs past the stored body") }
  else { r }
}

/// Past what `written_block` wrote, which the text of a body does not say: each reference read as
/// one and nothing looked up, so none is wanted where the body is printed.
fn past_written(decoder: Decoder) -> Decoder / {abort.raise} = {
  let n = read_count(expect(decoder, tag_written(), b"what a body references past its text"));
  range(0, n.value).fold(n.decoder, |d: Decoder, _i: Int| {
    let t = read_u8(d);
    if t.value == tag_ref_hash() { read_bytes(t.decoder, 32).decoder }
    else if t.value == tag_ref_index() { read_u32(t.decoder).decoder }
    else { panic(String::of_bytes(b"a reference of tag ".concat(ascii_of_int(t.value)))) }
  })
}

fn read_binders(decoder: Decoder) -> DecodedInt / {abort.raise} = {
  let r = read_u32(decoder);
  if r.value > 65535 { panic("a count of binders no definition declares") } else { r }
}

fn read_many<| e>(decoder: Decoder, count: Int, f: (Decoder) -> Decoded / e) -> DecodedList / e =
  range(0, count).fold({ decoder: decoder, texts: [] }, |decoded: DecodedList, i: Int| {
    let g = f(decoded.decoder);
    { decoder: g.decoder, texts: decoded.texts.push(g.text) }
  })

fn read_opt<| e>(
  decoder: Decoder,
  f: (Decoder) -> Decoded / e,
) -> DecodedOption / {abort.raise | e} = {
  let r = read_u8(decoder);
  if r.value == tag_none() { { decoder: r.decoder, text: b"", some: false } }
  else if r.value == tag_some() {
    let g = f(r.decoder);
    { decoder: g.decoder, text: g.text, some: true }
  } else { panic("a byte that is not an optional marker") }
}

fn joined(xs: List<Bytes>, sep: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(0, xs.len()).map(|i: Int| if i == 0 { xs.get(i) } else { sep.concat(xs.get(i)) }),
  )

fn prefixed(decoded: DecodedOption, before: Bytes) -> Bytes =
  if decoded.some { before.concat(decoded.text) } else { b"" }

fn bracketed(decoded: DecodedOption) -> Bytes =
  if decoded.some { Bytes::concat_all([b"[", decoded.text, b"]"]) } else { b"" }

fn local_name(level: Int) -> Bytes = b"_l".concat(ascii_of_int(level))
fn type_var_name(level: Int) -> Bytes = b"_t".concat(ascii_of_int(level))
fn row_var_name(level: Int) -> Bytes = b"_e".concat(ascii_of_int(level))
fn label_name(level: Int) -> Bytes = b"_r".concat(ascii_of_int(level))

fn line_break(depth: Int) -> Bytes =
  b"\n".concat(Bytes::concat_all(range(0, depth).map(|i: Int| b"  ")))

fn zeros(k: Int) -> Bytes = Bytes::concat_all(range(0, k).map(|i: Int| b"0"))

fn short_hex(h: Bytes) -> Bytes / {abort.raise} = hex(h).slice(0, 12)

fn read_ref(printer: BodyPrinter, decoder: Decoder) -> DecodedRef / {abort.raise} = {
  let t = read_u8(decoder);
  if t.value == tag_ref_hash() {
    let g: Decoded = read_bytes(t.decoder, 32);
    let h = match printer.layout.relink.get(g.text) { Some(to) -> to, None -> g.text };
    {
      decoder: if printer.layout.by_hash.contains(h) { g.decoder }
      else { { ..g.decoder, missing: g.decoder.missing.insert(h, true) } },
      hash: h,
      class: 0 - 1,
    }
  } else if t.value == tag_ref_index() {
    let c = read_u32(t.decoder);
    let hashes = if printer.part < 0 { [] } else { printer.layout.parts.get(printer.part).hashes };
    if c.value >= hashes.len() { panic("a reference to a member this component does not have") }
    else { { decoder: c.decoder, hash: hashes.get(c.value), class: c.value } }
  } else { panic(String::of_bytes(b"a reference of tag ".concat(ascii_of_int(t.value)))) }
}

/// A name the module being printed may write: its own needs no export, a printed module is reprinted
/// `pub` throughout, and any other is reached as `binder::name`, which is what its own `pub` permits.
fn nameable(layout: Layout, slot: Slot, own: Bytes) -> Bool / {abort.raise} = {
  let p = layout.parts.get(slot.part);
  p.module == own || p.printed || p.public.get(slot.class)
}

/// Two definitions alike are one body under two names, and only some of those names are in reach:
/// an unreachable one is no candidate at all, since printing it names something that will not
/// resolve rather than something merely further away.
/// Whether `from` reaches `target` along the import edges laid down. Each round reaches one edge
/// further, and a module past the first round has edges only if it is a key, so the rounds suffice.
fn reaches(g: Map<Bytes, List<Bytes>>, from: Bytes, target: Bytes) -> Bool = {
  let walked = range(0, g.len() + 1).fold(
    { seen: [from], frontier: [from] },
    |acc: { seen: List<Bytes>, frontier: List<Bytes> }, _round: Int|
      acc.frontier.fold(
        { seen: acc.seen, frontier: [] },
        |out: { seen: List<Bytes>, frontier: List<Bytes> }, m: Bytes|
          List::fold(
            match g.get(m) { Some(xs) -> xs, None -> [] },
            out,
            |o: { seen: List<Bytes>, frontier: List<Bytes> }, n: Bytes|
              if o.seen.contains(n) { o }
              else { { seen: o.seen.push(n), frontier: o.frontier.push(n) } },
          ),
      ),
  );
  walked.seen.contains(target)
}

fn pick(
  layout: Layout,
  g: Map<Bytes, List<Bytes>>,
  mine: Map<Bytes, Bytes>,
  h: Bytes,
  own: Bytes,
  wanted: (Slot) -> Bool / {abort.raise},
) -> Option<Slot> / {abort.raise} = {
  // A home is safe when pointing at it adds no import edge that closes a cycle: the module's own,
  // one it already imports, or one that cannot reach it in the print so far. When every home
  // would close a cycle the nearest name stands and the print fails downstream as before; a
  // choice that is only worse is still better than a cycle.
  let edges = g.insert(own, mine.keys());
  let safe = |s: Slot| {
    let p = layout.parts.get(s.part);
    p.module == own || mine.contains(p.module) || !reaches(edges, p.module, own)
  };
  let score = |s: Slot| {
    let p = layout.parts.get(s.part);
    (if p.module == own { 0 } else { 4 }) + (if mine.contains(p.module) { 0 } else { 2 })
      + (if p.printed { 0 } else { 1 })
  };
  match layout.by_hash.get(h) {
    None -> None,
    Some(found) -> {
      let named = found.filter(|s: Slot| nameable(layout, s, own) && wanted(s));
      let pool = match named.filter(safe) { [] -> named, homes -> homes };
      pool.fold(None, |best: Option<Slot>, s: Slot|
        match best { Some(b) -> if score(s) < score(b) { Some(s) } else { best }, None -> Some(s) })
    },
  }
}

fn qname(
  printer: BodyPrinter,
  decoded: DecodedRef,
  ctor: Option<Bytes>,
) -> Decoded / {abort.raise} = {
  // One body under two modules' names: the checker tells them apart where the hash does not.
  let named = |s: Slot| {
    let p = printer.layout.parts.get(s.part);
    printer.meant.contains(qualify(p.module, p.names.get(s.class)))
  };
  let told = match printer.layout.by_hash.get(decoded.hash) {
    Some(slots) -> slots.filter(named).len() > 0,
    None -> false,
  };
  let found = if decoded.class >= 0 { Some({ part: printer.part, class: decoded.class }) } else {
    pick(
      printer.layout,
      printer.graph,
      decoded.decoder.imports,
      decoded.hash,
      printer.own,
      |s: Slot| !told || named(s),
    )
  };
  match found {
    // A body with no name this module may write is filed with the ones it has no body for: either
    // way the reference cannot be printed, and a refusal names it rather than a hex string standing
    // in for it.
    None ->
      {
        decoder: { ..decoded.decoder, missing: decoded.decoder.missing.insert(decoded.hash, true) },
        text: match ctor { Some(c) -> c, None -> short_hex(decoded.hash) },
      },
    Some(s) -> {
      let p = printer.layout.parts.get(s.part);
      let name = match ctor { Some(c) -> c, None -> p.names.get(s.class) };
      if p.module == printer.own { { decoder: decoded.decoder, text: name } } else {
        {
          decoder: {
            ..decoded.decoder,
            imports: decoded.decoder.imports.insert(p.module, p.binder),
          },
          text: Bytes::concat_all([p.binder, b"::", name]),
        }
      }
    },
  }
}

/// What follows `decoded`, a function a call on a value may be, with its module imported where
/// the module being printed may name it: the call is answered among the modules its own can see.
fn seen(printer: BodyPrinter, decoded: DecodedRef) -> Decoder / {abort.raise} =
  if decoded.class >= 0 { decoded.decoder } else {
    match pick(
        printer.layout,
        printer.graph,
        decoded.decoder.imports,
        decoded.hash,
        printer.own,
        |_: Slot| true,
      ) {
      None -> decoded.decoder,
      Some(s) -> {
        let p = printer.layout.parts.get(s.part);
        if p.module == printer.own { decoded.decoder }
        else { { ..decoded.decoder, imports: decoded.decoder.imports.insert(p.module, p.binder) } }
      },
    }
  }

/// Whether `module` holds the body `hash` under `name`, where the module being printed may write it.
fn names_body(
  layout: Layout,
  module: Bytes,
  hash: Bytes,
  name: Bytes,
  own: Bytes,
) -> Bool / {abort.raise} =
  match layout.by_hash.get(hash) {
    None -> false,
    Some(found) ->
      found.fold(false, |held: Bool, s: Slot| {
        let p = layout.parts.get(s.part);
        held || (p.module == module && p.names.get(s.class) == name && nameable(layout, s, own))
      }),
  }

/// The binder a tagged literal is written with: one of another module that names the literal's
/// parser `named`, and its filler `fill` where it has one, and that a string can touch without
/// making an interpolated or a byte string.
fn tag_binder(
  printer: BodyPrinter,
  decoded: DecodedRef,
  named: Bytes,
  filler: Option<Bytes>,
) -> Decoded / {abort.raise} = {
  let layout = printer.layout;
  let found = pick(
    layout,
    printer.graph,
    decoded.decoder.imports,
    decoded.hash,
    printer.own,
    |s: Slot| {
      let p = layout.parts.get(s.part);
      p.module != printer.own && p.names.get(s.class) == named && p.binder != b"f"
        && p.binder != b"b"
        && (match filler {
          None -> true,
          Some(hash) -> names_body(layout, p.module, hash, b"fill", printer.own),
        })
    },
  );
  match found {
    None ->
      {
        decoder: { ..decoded.decoder, missing: decoded.decoder.missing.insert(decoded.hash, true) },
        text: short_hex(decoded.hash),
      },
    Some(s) -> {
      let p = layout.parts.get(s.part);
      {
        decoder: { ..decoded.decoder, imports: decoded.decoder.imports.insert(p.module, p.binder) },
        text: p.binder,
      }
    },
  }
}

fn is_free(decoder: Decoder) -> Bool / {abort.raise} =
  peek(decoder) == tag_free() || peek(decoder) == tag_free_qualified()

fn read_free(decoder: Decoder) -> Decoded / {abort.raise} = {
  let t = read_u8(decoder);
  if t.value == tag_free() { read_text(t.decoder) } else if t.value == tag_free_qualified() {
    let m = read_text(t.decoder);
    let n = read_text(m.decoder);
    { decoder: n.decoder, text: Bytes::concat_all([m.text, b"::", n.text]) }
  } else { panic("a tag that is not a free reference") }
}

fn read_value(printer: BodyPrinter, decoder: Decoder) -> Decoded / {abort.raise} =
  if peek(decoder) == tag_local() {
    let l = read_u32(skip(decoder));
    if l.value >= decoder.values { panic("a local that is not in scope") }
    else { { decoder: l.decoder, text: local_name(l.value) } }
  } else if peek(decoder) == tag_ctor() { read_ctor(printer, decoder) } else if is_free(decoder) {
    let name = read_free(decoder);
    { decoder: past_written(name.decoder), text: name.text }
  } else { qname(printer, read_ref(printer, decoder), None) }

fn read_ctor(printer: BodyPrinter, decoder: Decoder) -> Decoded / {abort.raise} =
  if peek(decoder) == tag_ctor() {
    let owner: DecodedRef = read_ref(printer, skip(decoder));
    let name = read_text(owner.decoder);
    qname(printer, { ..owner, decoder: name.decoder }, Some(name.text))
  } else { read_free(decoder) }

/// Two effects declared alike share a hash, and only the slot tells them apart.
fn read_effect(printer: BodyPrinter, decoder: Decoder) -> Decoded / {abort.raise} =
  if is_free(decoder) { read_free(decoder) } else {
    let r: DecodedRef = read_ref(printer, decoder);
    let s: DecodedInt = read_u32(r.decoder);
    match s.decoder.slots.get(r.hash) {
      Some(was) -> if was != s.value {
        panic(
          "two distinct effects share one declaration, which a hash-keyed body cannot tell apart",
        )
      } else { qname(printer, { ..r, decoder: s.decoder }, None) },
      None ->
        qname(
          printer,
          { ..r, decoder: { ..s.decoder, slots: s.decoder.slots.insert(r.hash, s.value) } },
          None,
        ),
    }
  }

fn print_type(outer: BodyPrinter, d: Decoder) -> Decoded / {abort.raise} =
  if outer.room <= 0 { panic("a body nested deeper than its own length") } else {
    let printer = { ..outer, room: outer.room - 1 };
    let t = read_u8(d);
    if t.value == tag_ty_con() {
      if peek(t.decoder) == tag_ty_param() {
        let l = read_u32(skip(t.decoder));
        let n = read_u32(l.decoder);
        if l.value >= d.types || n.value != 0 { panic("a type parameter out of scope, or applied") }
        else { { decoder: n.decoder, text: type_var_name(l.value) } }
      } else {
        let name = if is_free(t.decoder) { read_free(t.decoder) }
        else { qname(printer, read_ref(printer, t.decoder), None) };
        let n = read_count(name.decoder);
        let args = read_many(n.decoder, n.value, |e: Decoder| print_type(printer, e));
        // A bare lowercase name reads back as a type variable, so it keeps an empty `<>`.
        let bare = match name.text.index_of(b"::") { Some(_) -> false, None -> true };
        {
          decoder: args.decoder,
          text: if n.value > 0 || (bare && !starts_upper(name.text)) {
            Bytes::concat_all([name.text, b"<", joined(args.texts, b", "), b">"])
          } else { name.text },
        }
      }
    } else if t.value == tag_ty_con_over() {
      let name = if is_free(t.decoder) { read_free(t.decoder) }
      else { qname(printer, read_ref(printer, t.decoder), None) };
      let n = read_count(name.decoder);
      let args = read_many(n.decoder, n.value, |e: Decoder| print_type(printer, e));
      let lc = read_count(args.decoder);
      let labels = read_many(lc.decoder, lc.value, read_label);
      let rc = read_count(labels.decoder);
      let rows = read_many(rc.decoder, rc.value, |e: Decoder| print_row(printer, e, false));
      {
        decoder: rows.decoder,
        text: name.text.concat(angled(args.texts, labels.texts, rows.texts)),
      }
    } else if t.value == tag_ty_fn() {
      let n = read_count(t.decoder);
      let ps = read_many(n.decoder, n.value, |e: Decoder| print_type(printer, e));
      let ret = print_ret(printer, ps.decoder);
      let row = read_opt(ret.decoder, |e: Decoder| print_row(printer, e, false));
      {
        decoder: row.decoder,
        text: Bytes::concat_all([
          b"(",
          joined(ps.texts, b", "),
          b") -> ",
          ret.text,
          prefixed(row, b" / "),
        ]),
      }
    } else if t.value == tag_ty_record() {
      let n = read_count(t.decoder);
      let fs = read_many(n.decoder, n.value, |e: Decoder| {
        let f = read_text(e);
        let ty = print_type(printer, f.decoder);
        { decoder: ty.decoder, text: Bytes::concat_all([f.text, b": ", ty.text]) }
      });
      { decoder: fs.decoder, text: Bytes::concat_all([b"{", joined(fs.texts, b", "), b"}"]) }
    } else if t.value == tag_ty_unit() { { decoder: t.decoder, text: b"()" } }
    else { panic("a tag that does not begin a type") }
  }

/// After `->` a function type is parenthesized, or a row after it would bind to the inner arrow.
fn print_ret(printer: BodyPrinter, decoder: Decoder) -> Decoded / {abort.raise} =
  if peek(decoder) == tag_ty_fn() {
    let g = print_type(printer, decoder);
    { decoder: g.decoder, text: Bytes::concat_all([b"(", g.text, b")"]) }
  } else { print_type(printer, decoder) }

fn read_mode(decoder: Decoder) -> Decoded / {abort.raise} = {
  let m = read_u8(decoder);
  if m.value == 0 { { decoder: m.decoder, text: b"read" } }
  else if m.value == 1 { { decoder: m.decoder, text: b"write" } }
  else if m.value == 2 { { decoder: m.decoder, text: b"raise" } }
  else { panic("a byte that is not an access mode") }
}

fn read_label(decoder: Decoder) -> Decoded / {abort.raise} = {
  let k = read_u8(decoder);
  if k.value == tag_label_param() {
    let l = read_u32(k.decoder);
    if l.value >= decoder.labels { panic("a label parameter that is not in scope") }
    else { { decoder: l.decoder, text: label_name(l.value) } }
  } else if k.value == tag_free() { read_text(k.decoder) }
  else { panic("a tag that is not a resource label") }
}

/// `own` is a definition's own row, the only one whose row variable may be promised `bounded`: what
/// follows any other row is not the row's to read.
fn print_row(printer: BodyPrinter, d: Decoder, own: Bool) -> Decoded / {abort.raise} = {
  let n = read_count(expect(d, tag_row(), b"an effect row"));
  let atoms = read_many(n.decoder, n.value, |e: Decoder| {
    let named: Decoded = if peek(e) == tag_atom_op() {
      let eff = read_effect(printer, expect(e, tag_atom_op(), b"an operation atom"));
      let op = read_text(eff.decoder);
      let r = read_opt(op.decoder, read_label);
      { decoder: r.decoder, text: Bytes::concat_all([eff.text, b".", op.text, bracketed(r)]) }
    } else {
      let eff = read_effect(printer, expect(e, tag_atom(), b"an effect atom"));
      let m = read_mode(eff.decoder);
      let r = read_opt(m.decoder, read_label);
      { decoder: r.decoder, text: Bytes::concat_all([eff.text, b".", m.text, bracketed(r)]) }
    };
    if peek(named.decoder) == tag_bounded() {
      { decoder: skip(named.decoder), text: named.text.concat(b" bounded") }
    } else { named }
  });
  let tail = read_opt(atoms.decoder, |e: Decoder| {
    let k = read_u8(e);
    if k.value == tag_row_param() {
      let l = read_u32(k.decoder);
      if l.value >= e.rows { panic("a row parameter that is not in scope") }
      else { { decoder: l.decoder, text: row_var_name(l.value) } }
    } else if k.value == tag_free() { read_text(k.decoder) }
    else { panic("a tag that is not a row tail") }
  });
  let promised = own && tail.some && peek(tail.decoder) == tag_bounded();
  let variable = if promised { tail.text.concat(b" bounded") } else { tail.text };
  {
    decoder: if promised { skip(tail.decoder) } else { tail.decoder },
    text: if n.value == 0 && tail.some { variable } else {
      Bytes::concat_all([
        b"{",
        joined(atoms.texts, b", "),
        if tail.some { b" | ".concat(variable) } else { b"" },
        b"}",
      ])
    },
  }
}

fn escape(c: Int, raw: Bool) -> Bytes / {abort.raise} =
  if c == 34 { b"\\\"" }
  else if c == 92 { b"\\\\" }
  else if c == 10 { b"\\n" }
  else if c == 9 { b"\\t" }
  else if c == 13 { b"\\r" }
  else if c == 0 { b"\\0" }
  else if raw || (c >= 32 && c <= 126) { byte_of_int(c) }
  else { Bytes::concat_all([b"\\x", hex_digit(c >>> 4), hex_digit(c & 15)]) }

fn str_lit(s: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"\"",
    Bytes::concat_all(range(0, s.len()).map(|i: Int| escape(s.at(i), true))),
    b"\"",
  ])

/// A text of a tagged literal between its quotes and its holes, where a brace is written twice.
fn read_tag_text(decoder: Decoder) -> Decoded / {abort.raise} = {
  let s = read_text(expect(decoder, tag_lit_str(), b"a tagged literal's text"));
  {
    decoder: s.decoder,
    text: Bytes::concat_all(
      range(0, s.text.len()).map(|i: Int| {
        let c = s.text.at(i);
        if c == 123 { b"{{" } else if c == 125 { b"}}" } else { escape(c, true) }
      }),
    ),
  }
}

/// A character is its literal; past ASCII it is its own UTF-8, as a string's characters are.
fn char_lit(v: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"'",
    if v == 39 { b"\\'" }
    else if v == 34 { b"\"" }
    else if v < 128 { escape(v, true) }
    else { utf8_of(v) },
    b"'",
  ])

fn bytes_lit(s: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"b\"",
    Bytes::concat_all(range(0, s.len()).map(|i: Int| escape(s.at(i), false))),
    b"\"",
  ])

fn hex_int(v: Int, bits: Int) -> Bytes / {abort.raise} = {
  let n = bits / 4;
  let ds = range(0, n).map(|i: Int| v >>> 4 * (n - 1 - i) & 15);
  let lead = range(0, n).fold(n - 1, |acc: Int, j: Int|
    if ds.get(j) != 0 && j < acc { j } else { acc });
  b"0x".concat(Bytes::concat_all(range(lead, n).map(|j: Int| hex_digit(ds.get(j)))))
}

/// A negative literal is spelled as its bit pattern: `-5` would read back as a negation.
fn int_text(v: Int) -> Bytes / {abort.raise} = if v >= 0 { ascii_of_int(v) } else { hex_int(v, 64) }

fn fixed_text(which: Int, v: Int) -> Bytes / {abort.raise} =
  match widths().at(which) {
    None -> panic("a byte that is not a fixed-width integer type"),
    Some(w) ->
      Bytes::concat(
        if v >= 0 { ascii_of_int(v) }
        else { hex_int(if w.bits == 64 { v } else { v & (1 << w.bits) - 1 }, w.bits) },
        w.name,
      ),
  }

fn wide_text(which: Int, high: Int, low: Int) -> Bytes / {abort.raise} =
  match widths().at(which) {
    None -> panic("a byte that is not a fixed-width integer type"),
    Some(w) ->
      Bytes::concat(
        if w.signed && high < 0 {
          hex_int(high, 64).concat(
            Bytes::concat_all(range(0, 16).map(|i: Int| hex_digit(low >>> 4 * (15 - i) & 15))),
          )
        } else { wide_decimal(false, high, low) },
        w.name,
      ),
  }

fn big_mul(n: List<Int>, f: Int, add: Int) -> List<Int> / {abort.raise} = {
  let r = n.fold({ limbs: [], carry: add }, |s: { limbs: List<Int>, carry: Int }, limb: Int| {
    let v = limb * f + s.carry;
    { limbs: s.limbs.push(v % 1000000000), carry: v / 1000000000 }
  });
  iterate(r, 4, |s: { limbs: List<Int>, carry: Int }|
    if s.carry == 0 { Stop(s) } else {
      Continue({ limbs: s.limbs.push(s.carry % 1000000000), carry: s.carry / 1000000000 })
    }).limbs
}

fn pow_int(b: Int, k: Int) -> Int = range(0, k).fold(1, |a: Int, i: Int| a * b)

fn big_pow(n: List<Int>, base: Int, e: Int) -> List<Int> / {abort.raise} = {
  let chunk = if base == 5 { 13 } else { 30 };
  big_mul(
    range(0, e / chunk).fold(n, |acc: List<Int>, i: Int| big_mul(acc, pow_int(base, chunk), 0)),
    pow_int(base, e % chunk),
    0,
  )
}

fn big_digits(n: List<Int>) -> Bytes / {abort.raise} = {
  let top = range(0, n.len()).fold(0, |t: Int, i: Int| if n.get(i) != 0 { i } else { t });
  Bytes::concat_all(
    range(0, top + 1).map(|j: Int| {
      let d = ascii_of_int(n.get(top - j));
      if j == 0 { d } else { zeros(9 - d.len()).concat(d) }
    }),
  )
}

fn decimal_text(m: Bytes, scale: Int) -> Bytes / {abort.raise} =
  if scale > 28 || range(12, 16).fold(false, |b: Bool, i: Int| b || m.at(i) != 0) {
    panic("a mantissa and scale that are not a `Decimal`")
  } else {
    let ds = big_digits(
      range(0, 12).fold([0], |acc: List<Int>, i: Int| big_mul(acc, 256, m.at(11 - i))),
    );
    let padded = if ds.len() <= scale { zeros(scale - ds.len() + 1).concat(ds) } else { ds };
    let point = padded.len() - scale;
    Bytes::concat(
      if scale == 0 { ds }
      else { Bytes::concat_all([padded.slice(0, point), b".", padded.slice(point, padded.len())]) },
      b"m",
    )
  }

type Rounded = { digits: Bytes, exp: Int, p: Int }

fn trim_zeros(s: Bytes) -> Bytes / {abort.raise} =
  s.slice(0, range(0, s.len()).fold(1, |acc: Int, i: Int| if s.at(i) != 48 { i + 1 } else { acc }))

fn scientific(s: Bytes, x: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    s.slice(0, 1),
    if s.len() > 1 { b".".concat(s.slice(1, s.len())) } else { b"" },
    b"e",
    ascii_of_int(x),
  ])

fn round_to(ds: Bytes, x0: Int, p: Int) -> Rounded / {abort.raise} = {
  let head = ds.slice(0, p);
  if p >= ds.len() || ds.at(p) < 53 { { digits: trim_zeros(head), exp: x0, p: p } } else {
    let k = range(0, p).fold(0 - 1, |acc: Int, i: Int| if head.at(i) != 57 { i } else { acc });
    if k < 0 { { digits: b"1", exp: x0 + 1, p: p } }
    else { { digits: head.slice(0, k).concat(byte_of_int(head.at(k) + 1)), exp: x0, p: p } }
  }
}

fn reads_back(r: Rounded, mag: Int) -> Bool / {abort.raise} =
  match Float::of_string(String::of_bytes(scientific(r.digits, r.exp))) {
    Some(f) -> bits_of_float(f) == mag,
    None -> false,
  }

fn shortest(ds: Bytes, x0: Int, mag: Int) -> Rounded / {abort.raise} =
  iterate({ digits: ds, exp: x0, p: 1 }, 19, |s: Rounded|
    if s.p > 17 || s.p > ds.len() { Stop({ digits: trim_zeros(ds), exp: x0, p: s.p }) } else {
      let r = round_to(ds, x0, s.p);
      if reads_back(r, mag) { Stop(r) } else { Continue({ ..s, p: s.p + 1 }) }
    })

fn float_spelling(r: Rounded) -> Bytes / {abort.raise} = {
  let s = r.digits;
  let n = s.len();
  let positional = if r.exp >= n - 1 { s.concat(zeros(r.exp - n + 1)) }
  else if r.exp >= 0 { Bytes::concat_all([s.slice(0, r.exp + 1), b".", s.slice(r.exp + 1, n)]) }
  else { Bytes::concat_all([b"0.", zeros(0 - r.exp - 1), s]) };
  let exponential = scientific(s, r.exp);
  let text = if exponential.len() < positional.len() { exponential } else { positional };
  match text.index_of(b".") {
    Some(_) -> text,
    None -> match text.index_of(b"e") { Some(_) -> text, None -> text.concat(b".0") },
  }
}

fn float_text(bits: Int) -> Bytes / {abort.raise} = {
  let mag = bits & 0x7FFFFFFFFFFFFFFF;
  let sign = if bits < 0 { b"-" } else { b"" };
  let ex = mag >>> 52;
  let fr = mag & 0xFFFFFFFFFFFFF;
  if ex == 2047 && fr != 0 { panic("a NaN, which no literal spells") }
  else if ex == 2047 { sign.concat(b"1e400") }
  else if mag == 0 { sign.concat(b"0.0") } else {
    let m = if ex == 0 { fr } else { fr | 0x10000000000000 };
    let e2 = if ex == 0 { 0 - 1074 } else { ex - 1075 };
    let start = [m % 1000000000, m / 1000000000];
    let ds = big_digits(if e2 >= 0 { big_pow(start, 2, e2) } else { big_pow(start, 5, 0 - e2) });
    let x0 = ds.len() - 1 + (if e2 >= 0 { 0 } else { e2 });
    sign.concat(float_spelling(shortest(ds, x0, mag)))
  }
}

fn print_lit(decoder: Decoder) -> Decoded / {abort.raise} = {
  let t = read_u8(decoder);
  let e = t.decoder;
  if t.value == tag_lit_int() {
    let v = read_int(e, 8);
    { decoder: v.decoder, text: int_text(v.value) }
  } else if t.value == tag_lit_bool() {
    let b = read_bool(e);
    { decoder: b.decoder, text: if b.value { b"true" } else { b"false" } }
  } else if t.value == tag_lit_str() {
    let s = read_text(e);
    { decoder: s.decoder, text: str_lit(s.text) }
  } else if t.value == tag_lit_bytes() {
    let s = read_text(e);
    { decoder: s.decoder, text: bytes_lit(s.text) }
  } else if t.value == tag_lit_embedded() {
    // The bytes are not in the form: what prints embeds the file named by the digest's hex, which
    // a load handed the bytes under that digest reads back as this literal.
    let size = read_int(e, 8);
    let digest = read_text(size.decoder);
    { decoder: digest.decoder, text: Bytes::concat_all([b"embed(\"", hex(digest.text), b"\")"]) }
  } else if t.value == tag_lit_float() {
    let v = read_int(e, 8);
    { decoder: v.decoder, text: float_text(v.value) }
  } else if t.value == tag_lit_decimal() {
    let m = read_bytes(e, 16);
    let s = read_u32(m.decoder);
    { decoder: s.decoder, text: decimal_text(m.text, s.value) }
  } else if t.value == tag_lit_fixed() {
    let w = read_u8(e);
    let v = read_int(w.decoder, 8);
    { decoder: v.decoder, text: fixed_text(w.value, v.value) }
  } else if t.value == tag_lit_wide() {
    let w = read_u8(e);
    let high = read_int(w.decoder, 8);
    let low = read_int(high.decoder, 8);
    { decoder: low.decoder, text: wide_text(w.value, high.value, low.value) }
  } else if t.value == tag_lit_char() {
    let v = read_u32(e);
    { decoder: v.decoder, text: char_lit(v.value) }
  } else if t.value == tag_lit_unit() { { decoder: e, text: b"()" } }
  else { panic("a tag that is not a literal") }
}

fn print_pat(outer: BodyPrinter, d: Decoder) -> Decoded / {abort.raise} =
  if outer.room <= 0 { panic("a body nested deeper than its own length") } else {
    let printer = { ..outer, room: outer.room - 1 };
    let t = read_u8(d);
    let e: Decoder = t.decoder;
    if t.value == tag_p_wildcard() { { decoder: e, text: b"_" } } else if t.value == tag_p_var() {
      { decoder: { ..e, values: e.values + 1 }, text: local_name(e.values) }
    } else if t.value == tag_p_again() {
      let l = read_u32(e);
      if l.value >= e.values { panic("an alternative names a binder that is not in scope") }
      else { { decoder: l.decoder, text: local_name(l.value) } }
    } else if t.value == tag_p_or() {
      // Parenthesized wherever it stands: a choice nests only so, and reads the same at the top.
      let n = read_count(e);
      let alts = read_many(n.decoder, n.value, |g: Decoder| print_pat(printer, g));
      { decoder: alts.decoder, text: Bytes::concat_all([b"(", joined(alts.texts, b" | "), b")"]) }
    } else if t.value == tag_p_lit() { print_lit(e) } else if t.value == tag_p_range() {
      let lo = print_lit(e);
      let hi = print_lit(lo.decoder);
      { decoder: hi.decoder, text: Bytes::concat_all([lo.text, b"..=", hi.text]) }
    } else if t.value == tag_p_ctor() {
      let name = read_ctor(printer, e);
      let n = read_count(name.decoder);
      let args = read_many(n.decoder, n.value, |g: Decoder| print_pat(printer, g));
      {
        decoder: args.decoder,
        text: if n.value == 0 { name.text }
        else { Bytes::concat_all([name.text, b"(", joined(args.texts, b", "), b")"]) },
      }
    } else if t.value == tag_p_record() {
      let n = read_count(e);
      let fs = read_many(n.decoder, n.value, |g: Decoder| {
        let f = read_text(g);
        let p = print_pat(printer, f.decoder);
        { decoder: p.decoder, text: Bytes::concat_all([f.text, b": ", p.text]) }
      });
      let rest = read_bool(fs.decoder);
      {
        decoder: rest.decoder,
        text: Bytes::concat_all([
          b"{",
          joined(fs.texts, b", "),
          if !rest.value { b"" } else if n.value > 0 { b", .." } else { b".." },
          b"}",
        ]),
      }
    } else if t.value == tag_p_list() {
      let n = read_count(e);
      let items = read_many(n.decoder, n.value, |g: Decoder| print_pat(printer, g));
      let held = peek(skip(items.decoder));
      let named = held == tag_p_var() || held == tag_p_again();
      let rest = read_opt(items.decoder, |g: Decoder| print_pat(printer, g));
      {
        decoder: rest.decoder,
        text: Bytes::concat_all([
          b"[",
          joined(items.texts, b", "),
          if !rest.some { b"" } else {
            Bytes::concat_all([
              if n.value > 0 { b", " } else { b"" },
              b"..",
              if named { rest.text } else { b"" },
            ])
          },
          b"]",
        ]),
      }
    } else { panic("a tag that does not begin a pattern") }
  }

fn parens(decoded: Decoded, bare: Bool) -> Decoded =
  if bare { decoded }
  else { { decoder: decoded.decoder, text: Bytes::concat_all([b"(", decoded.text, b")"]) } }

fn is_atomic(decoder: Decoder) -> Bool / {abort.raise} = {
  let t = peek(decoder);
  t == tag_e_lit() || t == tag_e_var() || t == tag_e_app() || t == tag_e_field()
    || t == tag_e_list()
    || t == tag_e_perform()
    || t == tag_e_on_value()
    || t == tag_e_tagged()
    || t == tag_e_filled()
}

fn is_base(decoder: Decoder) -> Bool / {abort.raise} = {
  let t = peek(decoder);
  t == tag_e_var() || t == tag_e_app() || t == tag_e_field() || t == tag_e_perform()
    || t == tag_e_on_value()
}

fn print_operand(printer: BodyPrinter, decoder: Decoder, depth: Int) -> Decoded / {abort.raise} =
  parens(print_expr(printer, decoder, depth), is_atomic(decoder))

fn print_block(printer: BodyPrinter, decoder: Decoder, depth: Int) -> Decoded / {abort.raise} =
  if peek(decoder) == tag_e_block() { print_expr(printer, decoder, depth) } else {
    let g = print_expr(printer, decoder, depth + 1);
    {
      decoder: g.decoder,
      text: Bytes::concat_all([b"{", line_break(depth + 1), g.text, line_break(depth), b"}"]),
    }
  }

fn binop_text(op: Int) -> Bytes / {abort.raise} =
  match [
      b"+",
      b"-",
      b"*",
      b"/",
      b"%",
      b"==",
      b"!=",
      b"<",
      b"<=",
      b">",
      b">=",
      b"&&",
      b"||",
      b"++",
      b"&",
      b"|",
      b"^",
      b"<<",
      b">>",
      b">>>",
    ].at(
      op - 1,
    ) {
    Some(t) -> t,
    None -> panic("a byte that is not a binary operator"),
  }

fn unop_text(op: Int) -> Bytes / {abort.raise} =
  if op == 1 { b"-" }
  else if op == 2 { b"!" }
  else if op == 3 { b"~" }
  else { panic("a byte that is not a unary operator") }

/// `if c { t }` is the parser's own spelling of an `else ()`.
fn print_if(printer: BodyPrinter, decoder: Decoder, depth: Int) -> Decoded / {abort.raise} = {
  let c = print_operand(printer, decoder, depth);
  let th = print_block(printer, c.decoder, depth);
  let el: Decoder = th.decoder;
  let tail: Decoded = if peek(el) == tag_e_lit() && peek(skip(el)) == tag_lit_unit() {
    { decoder: { ..el, pos: el.pos + 2 }, text: b"" }
  } else if peek(el) == tag_e_if() {
    let g = print_expr(printer, el, depth);
    { decoder: g.decoder, text: b" else ".concat(g.text) }
  } else {
    let g = print_block(printer, el, depth);
    { decoder: g.decoder, text: b" else ".concat(g.text) }
  };
  { decoder: tail.decoder, text: Bytes::concat_all([b"if ", c.text, b" ", th.text, tail.text]) }
}

/// A call on a value, printed from where its arguments end: every function it may be follows, which
/// the hash reads and the text does not, and which of them the check found it calls. Under the
/// program's own names the value's type answers the call as it did; set apart, a function of a type
/// is a plain function under another name, so the call is printed as a call of the one it calls.
fn on_value_call(
  printer: BodyPrinter,
  decoder: Decoder,
  call: { on: Bytes, name: Bytes, labels: List<Bytes>, args: List<Bytes>, keys: List<Bytes>, values: List<Bytes> },
) -> Decoded / {abort.raise} = {
  let full = read_count(decoder);
  let apart = printer.layout.apart;
  let pick: Choice = match full.decoder.picks.at(full.decoder.picked) {
    Some(c) -> c,
    None -> { callee: 0 - 1, named: [] },
  };
  let after = { ..full.decoder, picked: full.decoder.picked + 1 };
  // A printed function's parameters are named by their places, so an argument a call names is
  // named so too, where the check said which parameter it fills.
  let named = range(0, call.keys.len()).map(|j: Int|
    Bytes::concat_all([
      if pick.named.len() == call.keys.len() { local_name(pick.named.get(j)) }
      else { call.keys.get(j) },
      b": ",
      call.values.get(j),
    ]));
  let callee: Decoded = if full.value == 1 {
    read_value(printer, expect(after, tag_e_var(), b"a function named in full"))
  } else {
    let c = read_count(after);
    let chosen = if apart { pick.callee } else { 0 - 1 };
    range(0, c.value).fold({ decoder: c.decoder, text: b"" }, |acc: Decoded, i: Int| {
      let r = read_ref(printer, acc.decoder);
      if i == chosen { qname(printer, r, None) }
      else if chosen >= 0 { { decoder: r.decoder, text: acc.text } }
      else { { decoder: seen(printer, r), text: acc.text } }
    })
  };
  let passed = |first: List<Bytes>|
    Bytes::concat_all([
      if call.labels == [] { b"" }
      else { Bytes::concat_all([b"[", joined(call.labels, b", "), b"]"]) },
      b"(",
      joined(first.concat(call.args).concat(named), b", "),
      b")",
    ]);
  {
    decoder: callee.decoder,
    text: if callee.text.len() == 0 { Bytes::concat_all([call.on, b".", call.name, passed([])]) }
    else if apart { callee.text.concat(passed([call.on])) }
    else { Bytes::concat_all([call.on, b".", callee.text, passed([])]) },
  }
}

fn print_expr(outer: BodyPrinter, d: Decoder, depth: Int) -> Decoded / {abort.raise} =
  if outer.room <= 0 { panic("a body nested deeper than its own length") } else {
    let printer = { ..outer, room: outer.room - 1 };
    let t = read_u8(d);
    let e = t.decoder;
    let inner = depth + 1;
    if t.value == tag_e_lit() { print_lit(e) }
    else if t.value == tag_e_var() { read_value(printer, e) } else if t.value == tag_e_binary() {
      let op = read_u8(e);
      let l = print_operand(printer, op.decoder, depth);
      let r = print_operand(printer, l.decoder, depth);
      {
        decoder: past_written(r.decoder),
        text: Bytes::concat_all([l.text, b" ", binop_text(op.value), b" ", r.text]),
      }
    } else if t.value == tag_e_unary() {
      let op = read_u8(e);
      let o = print_operand(printer, op.decoder, depth);
      { decoder: o.decoder, text: unop_text(op.value).concat(o.text) }
    } else if t.value == tag_e_lambda() {
      let n = read_count(e);
      let anns: DecodedList = read_many(n.decoder, n.value, |g: Decoder| {
        let o = read_opt(g, |h: Decoder| print_type(printer, h));
        { decoder: o.decoder, text: prefixed(o, b": ") }
      });
      let base = anns.decoder.values;
      let body: Decoded = print_expr(printer, { ..anns.decoder, values: base + n.value }, depth);
      let ps = range(0, n.value).map(|i: Int| local_name(base + i).concat(anns.texts.get(i)));
      {
        decoder: { ..body.decoder, values: base },
        text: Bytes::concat_all([
          if n.value == 0 { b"||" } else { Bytes::concat_all([b"|", joined(ps, b", "), b"|"]) },
          b" ",
          body.text,
        ]),
      }
    } else if t.value == tag_e_app() {
      // `r.f(x)` performs an effect, so a call through anything but a name is parenthesized.
      let f = parens(print_expr(printer, e, depth), peek(e) == tag_e_var());
      let n = read_count(f.decoder);
      let args = read_many(n.decoder, n.value, |g: Decoder| print_expr(printer, g, depth));
      let ln = read_count(args.decoder);
      let ls = read_many(ln.decoder, ln.value, read_label);
      {
        decoder: ls.decoder,
        text: Bytes::concat_all([
          f.text,
          if ln.value == 0 { b"" }
          else { Bytes::concat_all([b"[", joined(ls.texts, b", "), b"]"]) },
          b"(",
          joined(args.texts, b", "),
          b")",
        ]),
      }
    } else if t.value == tag_e_if() { print_if(printer, e, depth) }
    else if t.value == tag_e_match() {
      let s = print_operand(printer, e, depth);
      let n = read_count(s.decoder);
      let arms = read_many(n.decoder, n.value, |g: Decoder| {
        let p = print_pat(printer, expect(g, tag_arm(), b"a match arm"));
        let guard = read_opt(p.decoder, |h: Decoder| print_expr(printer, h, inner));
        let body: Decoded = print_expr(printer, guard.decoder, inner);
        {
          decoder: { ..body.decoder, values: g.values },
          text: Bytes::concat_all([
            line_break(inner),
            p.text,
            prefixed(guard, b" if "),
            b" -> ",
            body.text,
            b",",
          ]),
        }
      });
      {
        decoder: arms.decoder,
        text: Bytes::concat_all([
          b"match ",
          s.text,
          b" {",
          Bytes::concat_all(arms.texts),
          line_break(depth),
          b"}",
        ]),
      }
    } else if t.value == tag_e_block() {
      let n = read_count(e);
      let stmts = read_many(n.decoder, n.value, |g: Decoder| {
        let s = print_stmt(printer, g, inner);
        { decoder: s.decoder, text: line_break(inner).concat(s.text) }
      });
      let tail: DecodedOption = read_opt(stmts.decoder, |g: Decoder| print_expr(printer, g, inner));
      {
        decoder: { ..tail.decoder, values: e.values },
        text: Bytes::concat_all([
          b"{",
          Bytes::concat_all(stmts.texts),
          prefixed(tail, line_break(inner)),
          line_break(depth),
          b"}",
        ]),
      }
    } else if t.value == tag_e_record() {
      let n = read_count(e);
      let fs = read_many(n.decoder, n.value, |g: Decoder| {
        let f = read_text(g);
        let v = print_expr(printer, f.decoder, depth);
        { decoder: v.decoder, text: Bytes::concat_all([f.text, b": ", v.text]) }
      });
      { decoder: fs.decoder, text: Bytes::concat_all([b"{", joined(fs.texts, b", "), b"}"]) }
    } else if t.value == tag_e_record_update() {
      let b = print_expr(printer, e, depth);
      let n = read_count(b.decoder);
      let fs = read_many(n.decoder, n.value, |g: Decoder| {
        let f = read_text(g);
        let v = print_expr(printer, f.decoder, depth);
        { decoder: v.decoder, text: Bytes::concat_all([f.text, b": ", v.text]) }
      });
      {
        decoder: fs.decoder,
        text: Bytes::concat_all([
          b"{..",
          b.text,
          if n.value > 0 { b", " } else { b"" },
          joined(fs.texts, b", "),
          b"}",
        ]),
      }
    } else if t.value == tag_e_on_value() {
      let on = parens(print_expr(printer, e, depth), is_base(e));
      let name = read_text(on.decoder);
      let ln = read_count(name.decoder);
      let ls = read_many(ln.decoder, ln.value, read_label);
      let n = read_count(ls.decoder);
      let args = read_many(n.decoder, n.value, |g: Decoder| print_expr(printer, g, depth));
      let k = read_count(args.decoder);
      let named = range(0, k.value).fold(
        { decoder: k.decoder, keys: [], values: [] },
        |acc: { decoder: Decoder, keys: List<Bytes>, values: List<Bytes> }, _j: Int| {
          let key = read_text(acc.decoder);
          let value: Decoded = print_expr(printer, key.decoder, depth);
          {
            decoder: value.decoder,
            keys: acc.keys.push(key.text),
            values: acc.values.push(value.text),
          }
        },
      );
      on_value_call(printer, named.decoder, {
        on: on.text,
        name: name.text,
        labels: ls.texts,
        args: args.texts,
        keys: named.keys,
        values: named.values,
      })
    } else if t.value == tag_e_field() {
      let b = parens(print_expr(printer, e, depth), is_base(e));
      let f = read_text(b.decoder);
      { decoder: f.decoder, text: Bytes::concat_all([b.text, b".", f.text]) }
    } else if t.value == tag_e_list() {
      let n = read_count(e);
      let items = read_many(n.decoder, n.value, |g: Decoder| print_expr(printer, g, depth));
      { decoder: items.decoder, text: Bytes::concat_all([b"[", joined(items.texts, b", "), b"]"]) }
    } else if t.value == tag_e_perform() {
      let eff = read_effect(printer, e);
      let op = read_text(eff.decoder);
      let r = read_opt(op.decoder, read_label);
      let n = read_count(r.decoder);
      let args = read_many(n.decoder, n.value, |g: Decoder| print_expr(printer, g, depth));
      {
        decoder: args.decoder,
        text: Bytes::concat_all([
          eff.text,
          b".",
          op.text,
          bracketed(r),
          b"(",
          joined(args.texts, b", "),
          b")",
        ]),
      }
    } else if t.value == tag_e_handle() {
      let body = print_expr(printer, e, depth);
      print_handled(
        printer,
        body.decoder,
        depth,
        Bytes::concat_all([b"handle ", body.text, b" with {"]),
      )
    } else if t.value == tag_e_handle_vars() {
      let n = read_count(e);
      let level = n.decoder.values;
      let inits = range(0, n.value).fold(
        { decoder: n.decoder, texts: [] },
        |acc: { decoder: Decoder, texts: List<Bytes> }, i: Int| {
          let ty = read_opt({ ..acc.decoder, values: level + i }, |h: Decoder|
            print_type(printer, h));
          let v = print_expr(printer, ty.decoder, inner);
          {
            decoder: { ..v.decoder, values: level },
            texts: acc.texts.push(Bytes::concat_all([prefixed(ty, b": "), b" = ", v.text])),
          }
        },
      );
      let body = print_expr(printer, inits.decoder, depth);
      let vars = range(0, n.value).map(|i: Int|
        Bytes::concat_all([
          line_break(inner),
          b"var ",
          local_name(level + i),
          inits.texts.get(i),
          b",",
        ]));
      let h = print_handled(
        printer,
        { ..body.decoder, values: level + n.value },
        depth,
        Bytes::concat_all([b"handle ", body.text, b" with {", Bytes::concat_all(vars)]),
      );
      { ..h, decoder: { ..h.decoder, values: level } }
    } else if t.value == tag_e_with_hold() {
      let r = read_text(e);
      let acquire: Decoded = print_expr(printer, r.decoder, depth);
      let release: Decoded = print_expr(printer, acquire.decoder, depth);
      let level = release.decoder.values;
      let body: Decoded = print_expr(printer, { ..release.decoder, values: level + 1 }, inner);
      {
        decoder: { ..body.decoder, values: level },
        text: Bytes::concat_all([
          b"with_hold[",
          r.text,
          b"](",
          acquire.text,
          b", ",
          release.text,
          b") {",
          line_break(inner),
          local_name(level),
          b" -> ",
          body.text,
          line_break(depth),
          b"}",
        ]),
      }
    } else if t.value == tag_e_simulate() {
      let body = print_block(printer, e, depth);
      { decoder: body.decoder, text: b"simulate ".concat(body.text) }
    } else if t.value == tag_e_parallel() {
      let n = read_count(e);
      let branches = read_many(n.decoder, n.value, |g: Decoder| print_expr(printer, g, depth));
      {
        decoder: branches.decoder,
        text: Bytes::concat_all([b"parallel { ", joined(branches.texts, b", "), b" }"]),
      }
    } else if t.value == tag_e_try_block() {
      let named = read_opt(e, |g: Decoder| {
        let eff = read_effect(printer, g);
        let op = read_text(eff.decoder);
        { decoder: op.decoder, text: Bytes::concat_all([b"[", eff.text, b".", op.text, b"]"]) }
      });
      let body = print_block(printer, named.decoder, depth);
      { decoder: body.decoder, text: Bytes::concat_all([b"try", named.text, b" ", body.text]) }
    } else if t.value == tag_e_tagged() {
      let tag = tag_binder(printer, read_ref(printer, e), b"literal", None);
      let text = read_tag_text(tag.decoder);
      { decoder: text.decoder, text: Bytes::concat_all([tag.text, b"\"", text.text, b"\""]) }
    } else if t.value == tag_e_filled() {
      let parser = read_ref(printer, e);
      let filler = read_ref(printer, parser.decoder);
      let tag = tag_binder(
        printer,
        { ..parser, decoder: filler.decoder },
        b"compile",
        Some(filler.hash),
      );
      let n = read_count(tag.decoder);
      let head = read_tag_text(n.decoder);
      let rest = read_many(head.decoder, n.value, |g: Decoder| {
        let hole = print_expr(printer, g, depth);
        let text = read_tag_text(hole.decoder);
        // A hole that opens with a brace of its own is set off from it: `{{` is a brace of the text.
        let open = if hole.text.starts_with(b"{") { b"{ " } else { b"{" };
        { decoder: text.decoder, text: Bytes::concat_all([open, hole.text, b"}", text.text]) }
      });
      {
        decoder: rest.decoder,
        text: Bytes::concat_all([tag.text, b"\"", head.text, Bytes::concat_all(rest.texts), b"\""]),
      }
    } else {
      panic(
        String::of_bytes(
          b"a tag that does not begin an expression: ".concat(ascii_of_int(t.value)),
        ),
      )
    }
  }

/// A `handle`'s clauses and `return` after its body, `head` the text through its `with {`.
fn print_handled(
  printer: BodyPrinter,
  d: Decoder,
  depth: Int,
  head: Bytes,
) -> Decoded / {abort.raise} = {
  let inner = depth + 1;
  let n = read_count(d);
  let clauses = read_many(n.decoder, n.value, |g: Decoder| {
    let eff = read_effect(printer, expect(g, tag_clause(), b"a handler clause"));
    let op = read_text(eff.decoder);
    let r = read_opt(op.decoder, read_label);
    let k: DecodedInt = read_binders(r.decoder);
    let bound = g.values + k.value;
    let resumed: DecodedOption = read_opt({ ..k.decoder, values: bound }, |h: Decoder|
      { decoder: h, text: b" resume ".concat(local_name(bound)) });
    let cb: Decoded = print_expr(
      printer,
      { ..resumed.decoder, values: if resumed.some { bound + 1 } else { bound } },
      inner,
    );
    {
      decoder: { ..cb.decoder, values: g.values },
      text: Bytes::concat_all([
        line_break(inner),
        eff.text,
        b".",
        op.text,
        bracketed(r),
        b"(",
        joined(range(0, k.value).map(|i: Int| local_name(g.values + i)), b", "),
        b")",
        resumed.text,
        b" -> ",
        cb.text,
        b",",
      ]),
    }
  });
  let ret = read_opt(clauses.decoder, |g: Decoder| {
    let h: Decoder = expect(g, tag_return_clause(), b"a return clause");
    let rb: Decoded = print_expr(printer, { ..h, values: g.values + 1 }, inner);
    {
      decoder: { ..rb.decoder, values: g.values },
      text: Bytes::concat_all([
        line_break(inner),
        b"return ",
        local_name(g.values),
        b" -> ",
        rb.text,
        b",",
      ]),
    }
  });
  {
    decoder: ret.decoder,
    text: Bytes::concat_all([
      head,
      Bytes::concat_all(clauses.texts),
      ret.text,
      line_break(depth),
      b"}",
    ]),
  }
}

fn print_stmt(printer: BodyPrinter, d: Decoder, depth: Int) -> Decoded / {abort.raise} = {
  let t = read_u8(d);
  if t.value == tag_s_let() {
    let ty = read_opt(t.decoder, |g: Decoder| print_type(printer, g));
    let v = print_expr(printer, ty.decoder, depth);
    let p = print_pat(printer, v.decoder);
    {
      decoder: p.decoder,
      text: Bytes::concat_all([b"let ", p.text, prefixed(ty, b": "), b" = ", v.text, b";"]),
    }
  } else if t.value == tag_s_let_else() {
    let ty = read_opt(t.decoder, |g: Decoder| print_type(printer, g));
    // Parenthesized unless it is atomic: an `if` with no `else` would take the statement's.
    let v = print_operand(printer, ty.decoder, depth);
    let p = print_pat(printer, v.decoder);
    let fallback = print_block(printer, p.decoder, depth);
    {
      decoder: fallback.decoder,
      text: Bytes::concat_all([
        b"let ",
        p.text,
        prefixed(ty, b": "),
        b" = ",
        v.text,
        b" else ",
        fallback.text,
        b";",
      ]),
    }
  } else if t.value == tag_s_expr() {
    let g = print_expr(printer, t.decoder, depth);
    { decoder: g.decoder, text: g.text.concat(b";") }
  } else if t.value == tag_s_assign() {
    let target = read_value(printer, t.decoder);
    let v = print_expr(printer, target.decoder, depth);
    { decoder: v.decoder, text: Bytes::concat_all([target.text, b" = ", v.text, b";"]) }
  } else { panic("a tag that does not begin a statement") }
}

fn print_param_slot(printer: BodyPrinter, d: Decoder) -> Decoded / {abort.raise} = {
  let t = read_u8(d);
  if t.value == tag_none() { { decoder: t.decoder, text: b"" } } else if t.value == tag_some() {
    let ty = print_type(printer, t.decoder);
    { decoder: ty.decoder, text: b": ".concat(ty.text) }
  } else if t.value == tag_param_default() {
    let ty = read_opt(t.decoder, |g: Decoder| print_type(printer, g));
    let v = print_expr(printer, ty.decoder, 0);
    { decoder: v.decoder, text: Bytes::concat_all([prefixed(ty, b": "), b" = ", v.text]) }
  } else { panic("a tag that does not open a parameter") }
}

fn print_constraint(d: Decoder) -> Decoded / {abort.raise} = {
  let l = read_u32(expect(d, tag_constraint(), b"a constraint"));
  let k = read_u8(l.decoder);
  match constraint_kinds().fold(None, |acc: Option<Deriver>, deriver: Deriver|
      if deriver_byte(deriver) == k.value { Some(deriver) } else { acc }) {
    Some(d) -> { decoder: k.decoder, text: constraint_written(d, type_var_name(l.value)) },
    None -> panic("a byte that is not a deriver"),
  }
}

fn print_fn(printer: BodyPrinter, d: Decoder, name: Bytes) -> Decoded / {abort.raise} = {
  let tc = read_binders(expect(d, tag_fn(), b"a function"));
  let ec: DecodedInt = read_binders(tc.decoder);
  let lc: DecodedInt = read_binders(ec.decoder);
  let generics = generic_list(tc.value, ec.value, lc.value);
  let n = read_count({ ..lc.decoder, types: tc.value, rows: ec.value, labels: lc.value });
  let ps = read_many(n.decoder, n.value, |g: Decoder| print_param_slot(printer, g));
  let ret = read_opt(ps.decoder, |g: Decoder| print_ret(printer, g));
  let row = read_opt(ret.decoder, |g: Decoder| print_row(printer, g, true));
  let cs = read_count(row.decoder);
  let derives: DecodedList = read_many(cs.decoder, cs.value, print_constraint);
  let bound: Decoder = { ..derives.decoder, values: n.value };
  let shared: Decoded = if peek(bound) == tag_returns_fresh() {
    { decoder: skip(bound), text: b"\n  returns fresh" }
  } else if peek(bound) == tag_returns_param() {
    let i = read_u32(skip(bound));
    if i.value >= n.value { panic("a `returns` clause names a parameter out of scope") }
    else { { decoder: i.decoder, text: b"\n  returns ".concat(local_name(i.value)) } }
  } else { { decoder: bound, text: b"" } };
  let scoped: Decoder = shared.decoder;
  let measure: DecodedOption = if peek(scoped) != tag_decreases() {
    { decoder: scoped, text: b"", some: false }
  } else {
    let m = print_expr(printer, expect(scoped, tag_decreases(), b"a measure"), 0);
    { decoder: m.decoder, text: m.text, some: true }
  };
  let baked = peek(measure.decoder) == tag_const();
  let body = print_expr(printer, if baked { skip(measure.decoder) } else { measure.decoder }, 0);
  {
    decoder: body.decoder,
    text: Bytes::concat_all([
      if baked { b"const fn " } else { b"fn " },
      name,
      generics,
      b"(",
      joined(range(0, n.value).map(|i: Int| local_name(i).concat(ps.texts.get(i))), b", "),
      b")",
      prefixed(ret, b" -> "),
      prefixed(row, b" / "),
      if cs.value > 0 { b" where ".concat(joined(derives.texts, b", ")) } else { b"" },
      shared.text,
      if measure.some { b"\n  decreases ".concat(measure.text) } else { b"" },
      b" =\n  ",
      body.text,
    ]),
  }
}

fn type_binders(count: Int) -> Bytes = generic_list(count, 0, 0)

// A generic list of that many type, row and label binders, each named by its level.
fn generic_list(types: Int, rows: Int, labels: Int) -> Bytes =
  angled(
    range(0, types).map(type_var_name),
    range(0, labels).map(label_name),
    range(0, rows).map(row_var_name),
  )

fn print_type_def(printer: BodyPrinter, d: Decoder, name: Bytes) -> Decoded / {abort.raise} = {
  let over = peek(d) == tag_type_over();
  let n: DecodedInt = read_binders(
    expect(d, if over { tag_type_over() } else { tag_type() }, b"a type"),
  );
  let ec: DecodedInt = if over { read_binders(n.decoder) }
  else { { decoder: n.decoder, value: 0 } };
  let lc: DecodedInt = if over { read_binders(ec.decoder) }
  else { { decoder: ec.decoder, value: 0 } };
  let k = read_u8({ ..lc.decoder, types: n.value, rows: ec.value, labels: lc.value });
  // Every variant keeps its `|`: a single-variant sum without one reads as an alias.
  let body: Decoded = if k.value == tag_type_alias() { print_type(printer, k.decoder) }
  else if k.value == tag_type_sum() {
    // The encoding carries the name the declaring program wrote; this printing uses the one it
    // was asked for, which a relink may have changed.
    let declared = read_text(k.decoder);
    let vn = read_count(declared.decoder);
    let vs = read_many(vn.decoder, vn.value, |g: Decoder| {
      let vname = read_text(expect(g, tag_variant(), b"a variant"));
      let fc = read_count(vname.decoder);
      let fs = read_many(fc.decoder, fc.value, |h: Decoder| print_type(printer, h));
      {
        decoder: fs.decoder,
        text: Bytes::concat_all([
          b"| ",
          vname.text,
          if fc.value > 0 { Bytes::concat_all([b"(", joined(fs.texts, b", "), b")"]) } else { b"" },
          b" ",
        ]),
      }
    });
    { decoder: vs.decoder, text: Bytes::concat_all(vs.texts) }
  } else if k.value == tag_type_nominal() {
    let fields = print_type(printer, read_text(k.decoder).decoder);
    { decoder: fields.decoder, text: b"new ".concat(fields.text) }
  } else { panic("a tag that does not begin a type body") };
  let closed = peek(body.decoder) == tag_opaque();
  let stated = instances_of(printer, if closed { skip(body.decoder) } else { body.decoder }, name);
  let numeric = numeric_of(printer, stated.decoder);
  {
    decoder: numeric.decoder,
    text: Bytes::concat_all([
      if closed && !printer.layout.apart { b"opaque type " } else { b"type " },
      name,
      generic_list(n.value, ec.value, lc.value),
      b" = ",
      body.text,
      stated.text,
      if numeric.text.len() == 0 { b"" }
      else { Bytes::concat_all([b"\nnumeric for ", name, b" by { ", numeric.text, b" }"]) },
    ]),
  }
}

/// What follows a type's `key` and `show`: each operation its `numeric` names and the function it
/// is, as the statement's record lists them. Each one read is at least a byte.
fn numeric_of(printer: BodyPrinter, d: Decoder) -> Decoded / {abort.raise} =
  iterate({ decoder: d, text: b"" }, d.bytes.len() - d.pos + 1, |acc: Decoded|
    if peek(acc.decoder) != tag_numeric() { Stop(acc) } else {
      let op = read_text(skip(acc.decoder));
      let by = read_value(printer, op.decoder);
      Continue({
        decoder: by.decoder,
        text: Bytes::concat_all([
          acc.text,
          if acc.text.len() == 0 { b"" } else { b", " },
          op.text,
          b": ",
          by.text,
        ]),
      })
    })

/// What follows a type's body: the `key` and the `show` its module states of it, a line each. Each
/// one read is at least a byte, which bounds the rounds.
fn instances_of(printer: BodyPrinter, d: Decoder, name: Bytes) -> Decoded / {abort.raise} =
  iterate({ decoder: d, text: b"" }, d.bytes.len() - d.pos + 1, |acc: Decoded| {
    let kind = if peek(acc.decoder) == tag_key() { Some(NKey) }
    else if peek(acc.decoder) == tag_show() { Some(NShow) }
    else { None };
    match kind {
      None -> Stop(acc),
      Some(k) -> {
        let by = read_value(printer, skip(acc.decoder));
        Continue({
          decoder: by.decoder,
          text: Bytes::concat_all([
            acc.text,
            b"\n",
            instance_text(k),
            b" for ",
            name,
            b" by ",
            by.text,
          ]),
        })
      },
    }
  })

fn print_effect(printer: BodyPrinter, d: Decoder, name: Bytes) -> Decoded / {abort.raise} = {
  // The encoding carries the name the declaring program wrote; this printing uses the one it was
  // asked for, which a relink may have changed.
  let declared = read_text(expect(d, tag_effect(), b"an effect"));
  let nd = read_bool(declared.decoder);
  let n = read_count(nd.decoder);
  let ops = read_many(n.decoder, n.value, |g: Decoder| {
    let op = read_text(expect(g, tag_op(), b"an operation"));
    let m = read_mode(op.decoder);
    let r = read_bool(m.decoder);
    let tc = read_binders(r.decoder);
    let pc = read_count({ ..tc.decoder, types: tc.value });
    let ps = read_many(pc.decoder, pc.value, |h: Decoder| print_type(printer, h));
    let ret = print_type(printer, ps.decoder);
    {
      decoder: { ..ret.decoder, types: g.types },
      text: Bytes::concat_all([
        line_break(1),
        m.text,
        b" ",
        op.text,
        if r.value { b"[r]" } else { b"" },
        type_binders(tc.value),
        b"(",
        joined(ps.texts, b", "),
        b")",
        // A raise writes no result; the `Unit` its encoding holds in that place is read past.
        if m.text == b"raise" { b"" } else { b" -> ".concat(ret.text) },
      ]),
    }
  });
  {
    decoder: ops.decoder,
    text: Bytes::concat_all([
      if nd.value { b"nondet " } else { b"" },
      b"effect ",
      name,
      b" {",
      Bytes::concat_all(ops.texts),
      b"\n}",
    ]),
  }
}

/// Everything is `pub`: visibility is metadata the encoding erased.
fn print_item(unsized: BodyPrinter, decoder: Decoder, name: Bytes) -> Decoded / {abort.raise} = {
  let printer = { ..unsized, room: decoder.bytes.len() };
  let t = peek(decoder);
  let g = if t == tag_fn() { print_fn(printer, decoder, name) }
  else if t == tag_type() || t == tag_type_over() { print_type_def(printer, decoder, name) }
  else if t == tag_effect() { print_effect(printer, decoder, name) }
  else { panic("a tag that does not begin a definition") };
  if g.decoder.pos != g.decoder.bytes.len() { panic("bytes remain after the definition") }
  else { { decoder: g.decoder, text: b"pub ".concat(g.text) } }
}

fn print_test(unsized: BodyPrinter, decoder: Decoder, label: Bytes) -> Decoded / {abort.raise} = {
  let printer = { ..unsized, room: decoder.bytes.len() };
  let nd = read_bool(expect(decoder, tag_test(), b"a test"));
  let body = print_block(printer, nd.decoder, 0);
  if body.decoder.pos != body.decoder.bytes.len() { panic("bytes remain after the test") } else {
    {
      decoder: body.decoder,
      text: Bytes::concat_all([
        if nd.value { b"test/nondet " } else { b"test " },
        str_lit(label),
        b" ",
        body.text,
      ]),
    }
  }
}

type Named = { module: Bytes, simple: Bytes, public: Bool }
type Component = {
  members: List<Bytes>,
  picks: List<List<Choice>>,
  hashes: List<Bytes>,
  id: Bytes,
  key: Bytes,
}
type Copied = { module: Bytes, names: List<Bytes>, public: List<Bool> }
type Parting = {
  seen: Map<Bytes, Bool>,
  declared: Map<Bytes, Bytes>,
  parts: List<Part>,
  bad: Option<Refusal>,
}
type Sheet = { items: List<Bytes>, imports: Map<Bytes, Bytes> }

fn refuse(message: Bytes, notes: List<Bytes>) -> Option<Refusal> =
  Some({ message: message, notes: notes })

fn comp_of(body: Bytes) -> Component / {abort.raise} =
  match envelope(body) {
    None -> panic("a stored body of a kind this build does not read"),
    Some(e) -> {
      let payload = body.slice(e.at, body.len());
      let id = blake3(payload);
      if e.kind == 0 {
        { members: [payload], picks: picks_of(body, e), hashes: [id], id: id, key: id }
      } else {
        let c = read_count(cursor(payload, Map::new()));
        let ms = read_many(c.decoder, c.value, read_text);
        if ms.decoder.pos != payload.len() || e.class >= c.value {
          panic("a malformed component body")
        } else {
          {
            members: ms.texts,
            picks: picks_of(body, e),
            hashes: range(0, c.value).map(|i: Int| member_hash(id, i)),
            id: id,
            key: member_hash(id, e.class),
          }
        }
      }
    },
  }

fn listed(ns: List<Named>) -> Bytes / {abort.raise} =
  backticked(ns.map(|n: Named| qualify(n.module, n.simple)), b", ")

fn named_of(
  names: List<{ name: Bytes, hash: Bytes, public: Bool }>,
  keys: Map<Bytes, Bool>,
) -> { named: Map<Bytes, Map<Bytes, Named>>, bad: Option<Refusal> } / {abort.raise} =
  names.fold(
    { named: Map::new(), bad: None },
    |acc: { named: Map<Bytes, Map<Bytes, Named>>, bad: Option<Refusal> }, n: { name: Bytes, hash: Bytes, public: Bool }|
      match acc.bad {
        Some(_) -> acc,
        None -> {
          let simple = default_binder(n.name);
          if simple.len() == n.name.len() {
            { ..acc, bad: refuse(Bytes::concat_all([b"`", n.name, b"` names no module"]), []) }
          } else if !keys.contains(n.hash) {
            { ..acc, bad: refuse(Bytes::concat_all([b"`", n.name, b"` has no body"]), []) }
          } else {
            let module = n.name.slice(0, n.name.len() - simple.len() - 1);
            let had = match acc.named.get(n.hash) { Some(m) -> m, None -> Map::new() };
            {
              ..acc,
              named: acc.named.insert(
                n.hash,
                had.insert(Bytes::concat_all([module, b"\x00", simple]), {
                  module: module,
                  simple: simple,
                  public: n.public,
                }),
              ),
            }
          }
        },
      },
  )

fn copies(classes: List<List<Named>>) -> Option<List<Copied>> / {abort.raise} =
  if classes.len() == 1 {
    Some(classes.get(0).map(|n: Named| { module: n.module, names: [n.simple], public: [n.public] }))
  } else {
    let by_module = range(0, classes.len()).fold(
      Map::new(),
      |acc: Map<Bytes, List<List<Named>>>, c: Int|
        classes.get(c).fold(acc, |a: Map<Bytes, List<List<Named>>>, n: Named| {
          let rows = match a.get(n.module) {
            Some(r) -> r,
            None -> classes.map(|k: List<Named>| []),
          };
          a.insert(n.module, rows.set(c, rows.get(c).push(n)))
        }),
    );
    by_module.fold(Some([]), |acc: Option<List<Copied>>, m: Bytes, rows: List<List<Named>>|
      match acc {
        None -> None,
        Some(out) -> {
          let count = rows.get(0).len();
          if rows.fold(false, |b: Bool, r: List<Named>| b || r.len() != count) { None } else {
            Some(
              range(0, count).fold(out, |o: List<Copied>, k: Int|
                o.push({
                  module: m,
                  names: rows.map(|r: List<Named>| r.get(k).simple),
                  public: rows.map(|r: List<Named>| r.get(k).public),
                })),
            )
          }
        },
      })
  }

fn part_in(
  acc: Parting,
  component: Component,
  named: Map<Bytes, Map<Bytes, Named>>,
  shipped: List<Bytes>,
) -> Parting / {abort.raise} = {
  let classes = component.hashes.map(|h: Bytes|
    match named.get(h) { Some(m) -> m.values(), None -> [] });
  let checked: Parting = range(0, component.hashes.len()).fold(acc, |a: Parting, i: Int|
    match a.bad {
      Some(_) -> a,
      None -> {
        let all = classes.get(i);
        let h = component.hashes.get(i);
        let kind = component.members.get(i).at(0);
        if all.len() == 0 {
          {
            ..a,
            bad: refuse(Bytes::concat_all([b"the body `", short_hex(h), b"` has no name"]), []),
          }
        }
        // Two modules declaring one effect alike declare one effect, so a body performing it cannot
        // be printed back under a name: either module's would be a different claim about what it does.
        else if kind == tag_effect() && all.len() > 1 {
          {
            ..a,
            bad: refuse(
              listed(all).concat(
                b" are one effect declaration, so a body cannot say which it performs",
              ),
              [b"make the declarations differ, or keep one of them"],
            ),
          }
        } else {
          all.fold(a, |b: Parting, n: Named| {
            let q = qualify(n.module, n.simple);
            let key = byte_of_int(kind).concat(q);
            match b.declared.get(key) {
              Some(other) -> if other == h || is_some(b.bad) { b } else {
                {
                  ..b,
                  bad: refuse(
                    Bytes::concat_all([b"`", q, b"` names two different definitions"]),
                    [],
                  ),
                }
              },
              None -> { ..b, declared: b.declared.insert(key, h) },
            }
          })
        }
      },
    });
  match checked.bad {
    Some(_) -> checked,
    None -> match copies(classes) {
      None ->
        {
          ..checked,
          bad: refuse(
            listed(classes.fold([], |o: List<Named>, ns: List<Named>| o.concat(ns))).concat(
              b" are a mutually recursive group in which two definitions share one body, so a call cannot say which it reaches",
            ),
            [b"make the definitions differ, or keep one of them"],
          ),
        },
      Some(cs) ->
        {
          ..checked,
          parts: cs.fold(checked.parts, |ps: List<Part>, cp: Copied|
            ps.push({
              members: component.members,
              picks: component.picks,
              hashes: component.hashes,
              names: cp.names,
              public: cp.public,
              module: cp.module,
              binder: default_binder(cp.module),
              printed: !shipped.contains(cp.module),
            })),
        },
    },
  }
}

fn is_some(o: Option<Refusal>) -> Bool = match o { Some(_) -> true, None -> false }

fn binders(modules: List<Bytes>) -> Map<Bytes, Bytes> / {abort.raise} = {
  let sharing = modules.fold(Map::new(), |acc: Map<Bytes, Int>, m: Bytes|
    acc.insert(
      default_binder(m),
      1 + (match acc.get(default_binder(m)) { Some(k) -> k, None -> 0 }),
    ));
  let start = {
    taken: sharing.fold(Map::new(), |acc: Map<Bytes, Bool>, b: Bytes, k: Int| acc.insert(b, true)),
    out: Map::new(),
  };
  let done = modules.fold(
    start,
    |s: { taken: Map<Bytes, Bool>, out: Map<Bytes, Bytes> }, m: Bytes| {
      let own = default_binder(m);
      if match sharing.get(own) { Some(k) -> k == 1, None -> true } {
        { ..s, out: s.out.insert(m, own) }
      } else {
        let base = joined(m.split(b"."), b"_");
        let found = iterate(
          { n: 1, binder: base },
          2 * modules.len() + 2,
          |t: { n: Int, binder: Bytes }|
            if s.taken.contains(t.binder) {
              Continue({
                n: t.n + 1,
                binder: Bytes::concat_all([base, b"_", ascii_of_int(t.n + 1)]),
              })
            } else { Stop(t) },
        );
        { taken: s.taken.insert(found.binder, true), out: s.out.insert(m, found.binder) }
      }
    },
  );
  done.out
}

fn layout_of(
  parts: List<Part>,
  relink: Map<Bytes, Bytes>,
  apart: Bool,
  meant: Map<Bytes, Map<Bytes, Bool>>,
) -> Layout / {abort.raise} = {
  let bound = binders(
    parts.fold(Map::new(), |acc: Map<Bytes, Bool>, part: Part| acc.insert(part.module, true)).keys(
    ),
  );
  let placed = parts.map(|part: Part|
    { ..part, binder: match bound.get(part.module) { Some(b) -> b, None -> part.binder } });
  {
    parts: placed,
    by_hash: range(0, placed.len()).fold(Map::new(), |acc: Map<Bytes, List<Slot>>, u: Int| {
      let hashes = placed.get(u).hashes;
      range(0, hashes.len()).fold(acc, |a: Map<Bytes, List<Slot>>, c: Int|
        a.insert(
          hashes.get(c),
          List::push(match a.get(hashes.get(c)) { Some(xs) -> xs, None -> [] }, {
            part: u,
            class: c,
          }),
        ))
    }),
    relink: relink,
    apart: apart,
    meant: meant,
  }
}

fn print_parts(
  layout: Layout,
) -> { modules: Map<Bytes, Sheet>, missing: Map<Bytes, Bool>, graph: Map<Bytes, List<Bytes>> } / {abort.raise} =
  range(0, layout.parts.len()).fold(
    { modules: Map::new(), missing: Map::new(), graph: Map::new() },
    |acc: { modules: Map<Bytes, Sheet>, missing: Map<Bytes, Bool>, graph: Map<Bytes, List<Bytes>> }, u: Int| {
      let p = layout.parts.get(u);
      if !p.printed { acc } else {
        let x = {
          layout: layout,
          part: u,
          own: p.module,
          graph: acc.graph,
          room: 0,
          meant: Map::new(),
        };
        let walked = range(0, p.members.len()).fold(
          { decoder: cursor(b"", acc.missing), texts: [] },
          |decoded: DecodedList, c: Int| {
            let g = print_item(
              {
                ..x,
                meant: match layout.meant.get(
                    meant_key(qualify(p.module, p.names.get(c)), p.hashes.get(c)),
                  ) {
                  Some(names) -> names,
                  None -> Map::new(),
                },
              },
              {
                ..decoded.decoder,
                bytes: p.members.get(c),
                pos: 0,
                picks: match p.picks.at(c) { Some(x) -> x, None -> [] },
                picked: 0,
                values: 0,
                types: 0,
                rows: 0,
                labels: 0,
              },
              p.names.get(c),
            );
            { decoder: g.decoder, texts: decoded.texts.push(g.text) }
          },
        );
        let had = match acc.modules.get(p.module) {
          Some(m) -> m,
          None -> { items: [], imports: Map::new() },
        };
        let imports = had.imports.merge(walked.decoder.imports.remove(p.module));
        {
          modules: acc.modules.insert(p.module, {
            items: had.items.concat(walked.texts),
            imports: imports,
          }),
          missing: walked.decoder.missing,
          graph: acc.graph.insert(p.module, imports.keys()),
        }
      }
    },
  )

fn print_tests(
  layout: Layout,
  g: Map<Bytes, List<Bytes>>,
  tests: List<Bytes>,
  missing: Map<Bytes, Bool>,
) -> DecodedList / {abort.raise} = {
  let x = { layout: layout, part: 0 - 1, own: b"", graph: g, room: 0, meant: Map::new() };
  range(0, tests.len()).fold(
    { decoder: cursor(b"", missing), texts: [] },
    |decoded: DecodedList, i: Int| {
      let body = tests.get(i);
      match envelope(body) {
        Some(e) -> if e.kind != 0 { panic("a test body that is not a solo body") } else {
          let g = print_test(
            x,
            {
              ..decoded.decoder,
              bytes: body.slice(e.at, body.len()),
              pos: 0,
              picks: match picks_of(body, e).at(0) { Some(p) -> p, None -> [] },
              picked: 0,
              values: 0,
              types: 0,
              rows: 0,
              labels: 0,
              slots: Map::new(),
            },
            b"t".concat(ascii_of_int(i)),
          );
          { decoder: g.decoder, texts: decoded.texts.push(g.text) }
        },
        None -> panic("a test body that is not a solo body"),
      }
    },
  )
}

fn sheet_text(sheet: Sheet) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    sheet.imports.fold([], |acc: List<Bytes>, m: Bytes, b: Bytes|
      acc.push(
        Bytes::concat_all([
          b"import ",
          m,
          if b == default_binder(m) { b"" } else { b" as ".concat(b) },
          b"\n",
        ]),
      )).concat(
      sheet.items.map(|it: Bytes| Bytes::concat_all([b"\n", it, b"\n"])),
    ),
  )

/// `public` is what the name's own module exports: a reference from a module that is printed reaches
/// a shipped one only through it, so a name filed without it is never the one a reference is printed
/// under.
///
/// `apart` says the names set each body in a module of its own, as a search's do. What only a
/// type's module may write is then written wherever a body landed, so an `opaque` type is printed
/// open; it runs as it did, and is no longer stored under the hash it was.
///
/// `meant` is what each definition names, for those the caller knows it of. Two modules that
/// declare one thing alike file one body under two names, which the checker may still tell apart;
/// a reference to it from a definition listed here is printed under the name that definition
/// names, and from any other under the nearest.
pub fn print_bodies(
  bodies: List<Bytes>,
  names: List<{ name: Bytes, hash: Bytes, public: Bool }>,
  tests: List<Bytes>,
  relink: List<{ from: Bytes, to: Bytes }>,
  shipped: List<Bytes>,
  apart: Bool = false,
  meant: List<{ name: Bytes, hash: Bytes, names: List<Bytes> }> = [],
) -> Printing / {abort.raise} = {
  let comps = bodies.map(comp_of);
  let n = named_of(
    names,
    comps.fold(Map::new(), |acc: Map<Bytes, Bool>, component: Component|
      acc.insert(component.key, true)),
  );
  let parted: Parting = match n.bad {
    Some(_) -> { seen: Map::new(), declared: Map::new(), parts: [], bad: n.bad },
    None ->
      comps.fold(
        { seen: Map::new(), declared: Map::new(), parts: [], bad: None },
        |acc: Parting, component: Component|
          if is_some(acc.bad) || acc.seen.contains(component.id) { acc } else {
            part_in(
              { ..acc, seen: acc.seen.insert(component.id, true) },
              component,
              n.named,
              shipped,
            )
          },
      ),
  };
  match parted.bad {
    Some(r) -> Unprintable(r),
    None -> {
      let l = layout_of(
        parted.parts,
        relink.fold(Map::new(), |acc: Map<Bytes, Bytes>, r: { from: Bytes, to: Bytes }|
          acc.insert(r.from, r.to)),
        apart,
        meant.fold(
          Map::new(),
          |acc: Map<Bytes, Map<Bytes, Bool>>, n: { name: Bytes, hash: Bytes, names: List<Bytes> }|
            acc.insert(
              meant_key(n.name, n.hash),
              n.names.fold(Map::new(), |held: Map<Bytes, Bool>, name: Bytes|
                held.insert(name, true)),
            ),
        ),
      );
      let printed = print_parts(l);
      let t = print_tests(l, printed.graph, tests, printed.missing);
      let missing = t.decoder.missing.keys();
      if missing.len() > 0 {
        Unprintable({
          message: ascii_of_int(missing.len()).concat(
            b" definitions a body refers to are not among the bodies it can name",
          ),
          notes: [
            b"missing: ".concat(joined(missing.take(min(8, missing.len())).map(short_hex), b", ")),
          ],
        })
      } else {
        let texts = printed.modules.fold(
          [],
          |acc: List<{ module: Bytes, text: Bytes }>, m: Bytes, sheet: Sheet|
            acc.push({ module: m, text: sheet_text(sheet) }),
        );
        Printed(if tests.len() == 0 { texts } else {
          texts.push({
            module: b"ply_tests",
            text: sheet_text({ items: t.texts, imports: t.decoder.imports }),
          })
        })
      }
    },
  }
}

// --- Tests ------------------------------------------------------------------

test "the little-endian encoders write what the reference writes" {
  assert_eq(u32_le(1), b"\x01\x00\x00\x00");
  assert_eq(u32_le(0x01020304), b"\x04\x03\x02\x01");
  assert_eq(i64_le(0 - 1), b"\xff\xff\xff\xff\xff\xff\xff\xff");
  assert_eq(hex(b"\x00\xab\xff"), b"00abff");
  assert_eq(
    i128_le_of_digits(b"256"),
    b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
  )
}

test "a float literal is read as its correctly rounded bit pattern" {
  assert_eq(float_bits(b"1.5"), 0x3FF8000000000000);
  assert_eq(float_bits(b"1e2"), bits_of_float(100.0));
  assert_eq(float_bits(b"2.5e-1"), bits_of_float(0.25));
  assert_eq(float_bits(b"1.0e300"), 0x7E37E43C8800759C);
  assert_eq(float_bits(b"1.0e-30"), 0x39B4484BFEEBC2A0);
  let parts = decimal_parts(b"1.50m");
  assert_eq(parts.scale, 2);
  assert_eq(parts.mantissa.at(0), 150)
}

/// The hash a dump files `name` under.
fn dumped_hash(dump: String, name: Bytes) -> Bytes / {abort.raise} = {
  let d = Bytes::of_string(dump);
  let key = Bytes::concat_all([b"H;", name, b";"]);
  let start = match d.index_of(key) {
    Some(i) -> i + key.len(),
    None -> panic("the dump names the definition"),
  };
  d.slice(start, start + 64)
}

/// Two modules with tests and laws, one reading the other.
fn itemized() -> List<Source> =
  [
    {
      name: b"base",
      src: b"pub fn one() -> Int = 1\nfn unused_here() -> Int = 9\ntest \"one is one\" { assert(one() == 1) }\nlaw \"one is fixed\" forall x: Int { one() + x == x + 1 }\n",
    },
    {
      name: b"app",
      src: b"import base\npub fn two() -> Int = base::one() + 1\ntest \"two\" { assert(two() == 2) }\nlaw \"two is two\" forall x: Int { two() + x == x + 2 }\n",
    },
  ]

test "hashing reads a fixed definition's contract and references as its run fixed them, and answers as reading them again" {
  let index = indexed(itemized());
  let fresh = hashed_and_unused(index, no_fixing(), []);
  let fixed = fixed_nodes(index, fresh.hashes, Map::new().insert(b"base", true));
  assert(fixed.filter(|f: Fixed| !f.decl).len() > 0, Some("the fixture's base defines functions"));
  let held = hashed_and_unused(index, { ..no_fixing(), nodes: fixed }, []);
  assert_eq([held.hashes.defs, held.hashes.decls, held.hashes.own, held.hashes.contracts], [
    fresh.hashes.defs,
    fresh.hashes.decls,
    fresh.hashes.own,
    fresh.hashes.contracts,
  ]);
  assert_eq(
    held.unused,
    unused_over(
      index,
      node_edges_of(index, first_pass(index)),
      fixed,
      index.tests.map(|t: TestNode| test_roots_of(index, t)).concat(
        index.laws.map(|l: LawNode| law_roots_of(index, l)),
      ),
    ),
  );
  // What is fixed is what is answered: a contract fixed as another answers that one, unencoded.
  let marked = fixed.map(|f: Fixed|
    if f.decl { f } else { { ..f, contract: b"fixed:".concat(f.contract) } });
  let taken = hashed_and_unused(index, { ..no_fixing(), nodes: marked }, []).hashes.contracts;
  let base = |c: { name: Bytes, hash: Bytes }| c.name.starts_with(b"base.");
  assert_eq(
    taken.filter(base),
    fresh.hashes.contracts.filter(base).map(|c: { name: Bytes, hash: Bytes }|
      { ..c, hash: b"fixed:".concat(c.hash) }),
  )
}

test "a program read with every node, test and law fixed as a fresh run fixed it hashes as that run did" {
  let sources = itemized().concat([
    {
      name: b"loops",
      src: b"import base\npub effect tick { write beat() -> Unit }\npub fn even(n: Int) -> Bool / { tick.write } = if n == 0 { true } else { tick.beat(); odd(n - 1) }\nfn odd(n: Int) -> Bool / { tick.write } = if n == 0 { false } else { even(n - 1) }\npub fn half(n: Int) -> Int requires n >= 0 ensures result <= n = n / 2\ntest \"halves\" { assert_eq(half(base::one() + 3), 2) }\n",
    },
  ]);
  let index = indexed(sources);
  let fresh = hashed_and_unused(index, no_fixing(), []);
  let all = sources.fold(Map::new(), |acc: Map<Bytes, Bool>, s: Source| acc.insert(s.name, true));
  let held = hashed_and_unused(index, fixing_of(index, fresh.hashes, all), []);
  assert_eq(held.hashes, fresh.hashes);
  assert_eq(held.unused, [])
}

test "renaming a definition does not move its hash, and a change to a callee does" {
  let a = hash_dump([
    { name: b"m", src: b"fn helper(x: Int) -> Int = x + 1\nfn f() -> Int = helper(1)" },
  ]);
  let b = hash_dump([
    { name: b"m", src: b"fn aide(x: Int) -> Int = x + 1\nfn f() -> Int = aide(1)" },
  ]);
  let c = hash_dump([
    { name: b"m", src: b"fn helper(x: Int) -> Int = x + 2\nfn f() -> Int = helper(1)" },
  ]);
  assert_eq(dumped_hash(a, b"m.helper"), dumped_hash(b, b"m.aide"));
  assert_eq(dumped_hash(a, b"m.f"), dumped_hash(b, b"m.f"));
  assert(dumped_hash(a, b"m.f") != dumped_hash(c, b"m.f"))
}

test "a doc comment is trivia: written as a plain comment of the same length, nothing hashes otherwise" {
  let documented = Bytes::concat_all([
    b"//! The module.\n\n/// A type.\npub type T =\n  /// One.\n  | A\n  | B(Int)\n\n",
    b"/// An effect.\neffect log {\n  /// Writes.\n  write line(s: String) -> Unit\n}\n\n",
    b"/// Reads `t`.\nfn f(t: T) -> Int / {log.write} = match t { A -> 0, B(n) -> { log.line(\"x\"); n } }\n",
  ]);
  let plain = documented.replace(b"///", b"// ").replace(b"//!", b"// ");
  assert_eq(hash_dump([{ name: b"m", src: documented }]), hash_dump([{ name: b"m", src: plain }]))
}

test "an interpolated string hashes as the concatenation it stands for" {
  let shown = { name: b"std.show", src: b"pub fn display<a>(x: a) -> String = \"\"" };
  let a = hash_dump([shown, { name: b"m", src: b"fn f(x: Int) -> String = f\"a {x} b\"" }]);
  let b = hash_dump([
    shown,
    {
      name: b"m",
      src: b"import std.show\nfn f(x: Int) -> String = \"a \" ++ show::display(x) ++ \" b\"",
    },
  ]);
  assert_eq(dumped_hash(a, b"m.f"), dumped_hash(b, b"m.f"))
}

test "a byte literal hashes as the Int it is, and a wrapping operator as the call it is" {
  let one = |src: Bytes| dumped_hash(hash_dump([{ name: b"m", src: src }]), b"m.f");
  assert_eq(
    one(b"fn f(c: Int) -> Bool = c == b'{' || c == b'\\n'"),
    one(b"fn f(c: Int) -> Bool = c == 123 || c == 10"),
  );
  assert_eq(
    one(b"fn f(a: U32, b: U32) -> U32 = a +% b *| a"),
    one(b"fn f(a: U32, b: U32) -> U32 = wrap_add(a, saturating_mul(b, a))"),
  );
  assert(
    one(b"fn f(c: Int) -> Int = match c { 0..=9 -> 1, _ -> 0 }")
      != one(b"fn f(c: Int) -> Int = match c { 0..=8 -> 1, _ -> 0 }"),
  );
  assert_eq(
    one(b"fn f(c: Int) -> Int = match c { b'0'..=b'9' -> 1, _ -> 0 }"),
    one(b"fn f(c: Int) -> Int = match c { 48..=57 -> 1, _ -> 0 }"),
  )
}

test "a tagged literal hashes with its parser and its text, apart from the call it stands for" {
  let tag = |accepted: Bytes|
    {
      name: b"hex",
      src: Bytes::concat_all([
        b"pub fn literal(t: String) -> Result<Int, { message: String, offset: Int }> = Ok(",
        accepted,
        b")",
      ]),
    };
  let holding = |body: Bytes| { name: b"m", src: b"import hex\nfn f() -> Int = ".concat(body) };
  let of = |parser: Bytes, body: Bytes|
    dumped_hash(hash_dump([tag(parser), holding(body)]), b"m.f");
  let literal = of(b"1", b"hex\"ab\"");
  assert_eq(of(b"1", b"(hex\"ab\")"), literal);
  assert(of(b"1", b"hex\"ac\"") != literal);
  assert(of(b"2", b"hex\"ab\"") != literal);
  assert(of(b"1", b"match hex::literal(\"ab\") { Ok(n) -> n, Err(_) -> 0 }") != literal);
  let renamed = hash_dump([
    tag(b"1"),
    { name: b"m", src: b"import hex as h\nfn f() -> Int = h\"ab\"" },
  ]);
  assert_eq(dumped_hash(renamed, b"m.f"), literal)
}

test "a tagged literal with holes hashes with its tag's `compile` and `fill`, its texts and its holes" {
  let tag = |compiled: Bytes|
    {
      name: b"sh",
      src: Bytes::concat_all([
        b"pub fn compile(parts: List<String>) -> Result<Int, { message: String, offset: Int, part: Int }> = Ok(",
        compiled,
        b")\npub fn fill(c: Int, holes: List<Int>) -> Int = c",
      ]),
    };
  let holding = |body: Bytes|
    { name: b"m", src: b"import sh\nfn f(n: Int) -> Int = ".concat(body) };
  let of = |compiled: Bytes, body: Bytes|
    dumped_hash(hash_dump([tag(compiled), holding(body)]), b"m.f");
  let literal = of(b"1", b"sh\"a {n} b\"");
  assert_eq(of(b"1", b"(sh\"a {n} b\")"), literal);
  assert(of(b"1", b"sh\"a {n} c\"") != literal);
  assert(of(b"1", b"sh\"a {n + 1} b\"") != literal);
  assert(of(b"2", b"sh\"a {n} b\"") != literal);
  // A hole is no text: the texts around one are not the texts around another.
  assert(of(b"1", b"sh\"a {n}{n} b\"") != of(b"1", b"sh\"a {n} b{n}\""));
  assert(
    of(b"1", b"match sh::compile([\"a \", \" b\"]) { Ok(c) -> sh::fill(c, [n]), Err(_) -> 0 }")
      != literal,
  )
}

test "a record update of another module's record hashes stably, and follows that module's type" {
  let app = b"import shapes\npub fn bumped() -> shapes::P = { let p = shapes::mk(); {..p, a: 3} }";
  let narrow = [
    { name: b"shapes", src: b"pub type P = { a: Int, b: Int }\npub fn mk() -> P = { a: 1, b: 2 }" },
    { name: b"app", src: app },
  ];
  let wide = [
    {
      name: b"shapes",
      src: b"pub type P = { a: Int, b: Int, c: Int }\npub fn mk() -> P = { a: 1, b: 2, c: 3 }",
    },
    { name: b"app", src: app },
  ];
  assert_eq(
    dumped_hash(hash_dump(narrow), b"app.bumped"),
    dumped_hash(hash_dump(narrow), b"app.bumped"),
  );
  // The update means whatever the foreign record is, so a field added there moves this hash.
  assert(
    dumped_hash(hash_dump(narrow), b"app.bumped") != dumped_hash(hash_dump(wide), b"app.bumped"),
  );
  let out = hash_index(indexed(narrow));
  let ms = printed_of(out, []);
  assert(ms.get(0).text.contains(b"{.."));
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "a mutually recursive pair hashes as one component with two members" {
  let d = Bytes::of_string(
    hash_dump([
      {
        name: b"m",
        src: b"fn even(n: Int) -> Bool = if n == 0 { true } else { odd(n - 1) }\nfn odd(n: Int) -> Bool = if n == 0 { false } else { even(n - 1) }",
      },
    ]),
  );
  assert(match d.index_of(b"C;m.even;m.even,m.odd;") { Some(_) -> true, None -> false });
  assert(match d.index_of(b"C;m.odd;m.even,m.odd;") { Some(_) -> true, None -> false })
}

test "a literal is spelled so it reads back to its bits" {
  assert_eq(float_text(bits_of_float(0.1)), b"0.1");
  assert_eq(float_text(bits_of_float(100.0)), b"100.0");
  assert_eq(float_text(bits_of_float(1e300)), b"1e300");
  assert_eq(float_text(bits_of_float(1.5e-7)), b"1.5e-7");
  assert_eq(float_text(1), b"5e-324");
  assert_eq(float_text(0x8000000000000000), b"-0.0");
  assert_eq(decimal_text(i128_le_of_digits(b"50"), 3), b"0.050m");
  assert_eq(
    decimal_text(i128_le_of_digits(b"79228162514264337593543950335"), 0),
    b"79228162514264337593543950335m",
  );
  assert_eq(int_text(0 - 1), b"0xffffffffffffffff");
  assert_eq(fixed_text(4, 0 - 1), b"0xffi8");
  assert_eq(wide_text(8, 1, 0), b"18446744073709551616u128");
  assert_eq(wide_text(9, 0 - 1, 5), b"0xffffffffffffffff0000000000000005i128");
  assert_eq(bytes_lit(b"\x00\"q\xff"), b"b\"\\0\\\"q\\xff\"")
}

fn indexed(sources: List<Source>) -> Index / {abort.raise} =
  match resolve_modules(
      range(0, sources.len()).map(|i: Int| {
        let r = parse(sources.get(i).src);
        let d: Expansion = expand_derives(
          i,
          sources.get(i).name,
          expand(r.node, r.parser.diags).module,
        );
        { name: sources.get(i).name, module: d.module, derived: d.derived }
      }),
    ) {
    ResolveFailed(_) -> panic("the fixture resolves"),
    ResolveSucceeded(x) -> build_index(x.mods, x.r).index,
  }

fn named_hashes(out: HashOutput) -> List<{ name: Bytes, hash: Bytes }> = out.defs.concat(out.decls)

fn one_set(names: List<Bytes>) -> Map<Bytes, Bool> =
  names.fold(Map::new(), |acc: Map<Bytes, Bool>, n: Bytes| acc.insert(n, true))

test "a closure is what a name reaches, the name included, and a test's what the test references" {
  let h = hash_index(
    indexed([
      {
        name: b"m",
        src: b"pub fn leaf() -> Int = 1\npub fn mid() -> Int = leaf()\npub fn top() -> Int = mid()\npub fn other() -> Int = 2\ntest \"it\" { assert_eq(top(), 1) }",
      },
    ]),
  );
  assert_eq(closure_of(h, [b"m.mid"]).keys(), [b"m.leaf", b"m.mid"]);
  assert_eq(closure_of(h, [b"m.it"]).keys(), [b"m.it", b"m.leaf", b"m.mid", b"m.top"]);
  assert_eq(closure_of(h, [b"m.mid", b"m.other"]).keys(), [b"m.leaf", b"m.mid", b"m.other"]);
  assert_eq(closure_of(h, [b"m.nothing"]), Map::new());
  assert_eq(reaching(h, one_set([b"m.leaf"])).keys(), [b"m.it", b"m.leaf", b"m.mid", b"m.top"]);
  assert_eq(reaching(h, one_set([b"m.other"])).keys(), [b"m.other"])
}

test "the functions reached hold what a reached definition's clauses name, and what that reaches" {
  let index = indexed([
    {
      name: b"m",
      src: b"pub fn f(n: Int) -> Int\n  requires n > floor()\n  ensures result == model(n)\n= n\nfn model(n: Int) -> Int = n + under()\nfn under() -> Int = 0\nfn floor() -> Int = 0\npub fn other() -> Int = 2",
    },
  ]);
  let h = hash_index(index);
  assert_eq(closure_of(h, [b"m.f"]).keys(), [b"m.f"]);
  assert_eq(reached_functions(h, [TheFn(b"m.f")]).keys(), [
    b"m.f",
    b"m.floor",
    b"m.model",
    b"m.under",
  ]);
  assert_eq(reached_functions(h, [TheFn(b"m.other")]).keys(), [b"m.other"])
}

test "a listing reaches what its table and label do, and nothing only a case runs" {
  let index = indexed([
    {
      name: b"m",
      src: b"fn table() -> List<Int> = build(2)\nfn build(n: Int) -> List<Int> = [n]\nfn name_of(n: Int) -> Int = n\nfn heavy(n: Int) -> Int = deeper(n)\nfn deeper(n: Int) -> Int = n\ntest \"case {name_of(n)}\" for n: Int in table() {\n  assert_eq(heavy(n), n)\n}\n",
    },
    {
      name: b"std.cases",
      src: b"pub fn listed(xs: Int, f: Int) -> Int = 0\npub fn chosen(xs: Int, at: Int) -> Int = 0\n",
    },
    { name: b"std.show", src: b"pub fn display(x: Int) -> Int = x\n" },
  ]);
  let h = hash_index(index);
  let listed = listing_reach(h, [b"m.case {name_of(n)}"]).keys();
  assert(listed.contains(b"m.table") && listed.contains(b"m.build"), Some("the table is listed"));
  assert(!listed.contains(b"m.heavy") && !listed.contains(b"m.deeper"), Some("no case runs"));
  // The test itself reaches all of it.
  let run = reached_functions(h, [TheItem(b"m.case {name_of(n)}")]).keys();
  assert(run.contains(b"m.heavy") && run.contains(b"m.table"), None)
}

test "a function is reached through itself, never through a type or an effect of its name" {
  let index = indexed([
    {
      name: b"m",
      src: b"effect log { write emit(Bytes) -> Unit }\npub fn log() -> Int = helper()\nfn helper() -> Int = 1\npub fn user(b: Bytes) -> Unit / {log.write} = log.emit(b)\npub type Box = | Box(Int)\neffect Box { read held() -> Box }\npub fn boxed() -> Box / {Box.read} = Box.held()\npub fn caller() -> Int = log()",
    },
  ]);
  let h = hash_index(index);
  // `user` performs the effect `log` and `boxed` names the type and the effect `Box`: no function.
  assert_eq(reached_functions(h, [TheFn(b"m.user")]).keys(), [b"m.user"]);
  assert_eq(reached_functions(h, [TheFn(b"m.boxed")]).keys(), [b"m.boxed"]);
  assert_eq(reached_functions(h, [TheFn(b"m.caller")]).keys(), [
    b"m.caller",
    b"m.helper",
    b"m.log",
  ]);
  assert_eq(reached_functions(h, [TheFn(b"m.log")]).keys(), [b"m.helper", b"m.log"]);
  // The effect `log`, and the type and the effect `Box`, are where a walk can start too.
  assert_eq(reached_functions(h, [TheDecl(b"m.log")]).keys(), []);
  assert_eq(reached_functions(h, [TheDecl(b"m.Box")]).keys(), [])
}

fn over_cases(label: Bytes, ty: Bytes, table: Bytes, body: Bytes) -> HashOutput / {abort.raise} =
  hash_index(
    indexed([
      { name: b"std.show", src: b"pub fn display<a>(x: a) -> String = \"\"" },
      {
        name: b"std.cases",
        src: b"pub type Table<a> = List<a>\npub fn listed<a>(t: List<a>, l: (a) -> String) -> List<String> = t.map(l)\npub fn chosen<a>(t: List<a>, at: Int, d: Bytes) -> a = panic(\"\")",
      },
      {
        name: b"m",
        src: Bytes::concat_all([
          b"pub fn few() -> List<Int> = [1]\npub fn more() -> List<Int> = [1, 2]\npub fn held(n: Int) -> Bool = n > 0\ntest \"",
          label,
          b"\" for n: ",
          ty,
          b" in ",
          table,
          b" { ",
          body,
          b" }",
        ]),
      },
    ]),
  )

test "a test over cases hashes as what one case runs: its table and its label move nothing, its body and its case's type do" {
  let base = over_cases(b"n {n}", b"Int", b"few()", b"assert(held(n))");
  let hashed = |h: HashOutput| h.tests.values().get(0);
  assert_eq(hashed(over_cases(b"n {n}", b"Int", b"more()", b"assert(held(n))")), hashed(base));
  assert_eq(hashed(over_cases(b"another", b"Int", b"few()", b"assert(held(n))")), hashed(base));
  assert(hashed(over_cases(b"n {n}", b"Int", b"few()", b"assert(!held(n))")) != hashed(base));
  assert(hashed(over_cases(b"n {n}", b"Bool", b"few()", b"assert(held(n))")) != hashed(base));
  // The test reaches its table and what lists and chooses its cases; one case, only what it runs.
  let reached = closure_of(base, [b"m.n {n}"]);
  assert(reached.contains(b"m.few") && reached.contains(b"m.held"));
  assert(reached.contains(b"std.cases.listed") && reached.contains(b"std.cases.chosen"));
  assert_eq(
    match base.refs.cases.get(b"m.n {n}") {
      Some(runs) -> runs.map(|v: Int| base.refs.names.get(v)),
      None -> [],
    },
    [b"m.held"],
  )
}

/// A function `log`, an effect `log` and a test keyed `m.log`: three things one name spells.
fn three_of_a_name() -> HashOutput / {abort.raise} =
  hash_index(
    indexed([
      {
        name: b"m",
        src: b"effect log { write emit(Bytes) -> Unit }\npub fn log() -> Int = helper()\nfn helper() -> Int = 1\npub fn user(b: Bytes) -> Unit / {log.write} = log.emit(b)\npub fn caller() -> Int = log()\ntest \"log\" { assert_eq(caller(), 1) }",
      },
    ]),
  )

test "a walk goes by the node a reference names: a function apart from the effect of its name and from the test keyed like it" {
  let h = three_of_a_name();
  let names = |r: Reach| { fns: r.fns.keys(), decls: r.decls.keys() };
  assert_eq(names(reach(h, [TheFn(b"m.user")])), { fns: [b"m.user"], decls: [b"m.log"] });
  assert_eq(names(reach(h, [TheDecl(b"m.log")])), { fns: [], decls: [b"m.log"] });
  assert_eq(names(reach(h, [TheFn(b"m.log")])), { fns: [b"m.helper", b"m.log"], decls: [] });
  assert_eq(names(reach(h, [TheItem(b"m.log")])), {
    fns: [b"m.caller", b"m.helper", b"m.log"],
    decls: [],
  });
  assert_eq(named_in(h, TheFn(b"m.user")), [{ name: b"m.log", decl: true }]);
  assert_eq(named_in(h, TheItem(b"m.log")), [{ name: b"m.caller", decl: false }]);
  // What a build holds of `user` is the effect, and nothing the function of its name calls.
  assert_eq(
    held_by(h, [b"m.user"]).map(|x: Closed| { name: x.name, decl: x.decl, refs: x.refs }),
    [{ name: b"m.user", decl: false, refs: [1] }, { name: b"m.log", decl: true, refs: [] }],
  )
}

test "what names a function is not what names the effect of its name" {
  let h = three_of_a_name();
  assert_eq(naming(h, TheFn(b"m.log"), false), { fns: [b"m.caller"], decls: [], items: [] });
  assert_eq(naming(h, TheDecl(b"m.log"), false), { fns: [b"m.user"], decls: [], items: [] });
  assert_eq(naming(h, TheFn(b"m.caller"), false), { fns: [], decls: [], items: [b"m.log"] });
  assert_eq(naming(h, TheFn(b"m.helper"), true), {
    fns: [b"m.caller", b"m.log"],
    decls: [],
    items: [b"m.log"],
  })
}

test "a key read by name alone reaches what anything it spells does" {
  let h = three_of_a_name();
  assert_eq(closure_of(h, [b"m.user"]).keys(), [b"m.log", b"m.user"]);
  assert_eq(closure_of(h, [b"m.log"]).keys(), [b"m.caller", b"m.helper", b"m.log"]);
  assert_eq(reaching(h, one_set([b"m.helper"])).keys(), [b"m.caller", b"m.helper", b"m.log"])
}

/// The fixtures below write `pub` throughout, so every name is one a reference may be printed under.
fn all_public(
  xs: List<{ name: Bytes, hash: Bytes }>,
) -> List<{ name: Bytes, hash: Bytes, public: Bool }> =
  xs.map(|x: { name: Bytes, hash: Bytes }| { name: x.name, hash: x.hash, public: true })

pub fn by_name(xs: List<{ name: Bytes, hash: Bytes }>) -> Map<Bytes, Bytes> =
  xs.fold(Map::new(), |m: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
    m.insert(x.name, x.hash))

fn printed_of(
  out: HashOutput,
  shipped: List<Bytes>,
) -> List<{ module: Bytes, text: Bytes }> / {abort.raise} =
  match print_bodies(
      out.bodies.map(|b: { name: Bytes, body: Bytes }| b.body),
      all_public(named_hashes(out)),
      [],
      [],
      shipped,
    ) {
    Printed(ms) -> ms,
    Unprintable(why) -> panic(String::of_bytes(why.message)),
  }

test "a stated measure moves a definition's hash, and prints back to what it was stored under" {
  let src = b"fn f(n: Int) -> Int decreases n = if n <= 0 { 0 } else { f(n - 1) }";
  let plain = hash_dump([
    { name: b"m", src: b"fn f(n: Int) -> Int = if n <= 0 { 0 } else { f(n - 1) }" },
  ]);
  let measured = hash_dump([{ name: b"m", src: src }]);
  assert(dumped_hash(plain, b"m.f") != dumped_hash(measured, b"m.f"));
  let out = hash_index(indexed([{ name: b"m", src: src }]));
  let ms = printed_of(out, []);
  assert(ms.get(0).text.contains(b"decreases"));
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "`const` moves a definition's hash and its callers', and prints back to what it was stored under" {
  let src = b"pub const fn table() -> List<Int> = [1, 2]\npub fn first() -> Option<Int> = table().at(0)";
  let plain = hash_dump([
    {
      name: b"m",
      src: b"pub fn table() -> List<Int> = [1, 2]\npub fn first() -> Option<Int> = table().at(0)",
    },
  ]);
  let marked = hash_dump([{ name: b"m", src: src }]);
  assert(dumped_hash(plain, b"m.table") != dumped_hash(marked, b"m.table"));
  assert(dumped_hash(plain, b"m.first") != dumped_hash(marked, b"m.first"));
  let out = hash_index(indexed([{ name: b"m", src: src }]));
  let ms = printed_of(out, []);
  assert(ms.get(0).text.contains(b"pub const fn table"));
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "a range pattern prints back to what it was stored under, at any integer type and inside another pattern" {
  let src = b"pub fn class(c: Int, w: Option<U8>) -> Int = match c { b'0'..=b'9' -> 1, 100..=200 -> 2, _ -> match w { Some(1u8..=9u8) -> 3, _ -> 0 } }";
  let out = hash_index(indexed([{ name: b"m", src: src }]));
  let ms = printed_of(out, []);
  assert(ms.get(0).text.contains(b"48..=57 ->"));
  assert(ms.get(0).text.contains(b"Some(1u8..=9u8) ->"));
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

/// A module of `src` stored and printed back: what it printed as, and whether what was printed is
/// stored under the hashes `src` was.
fn printed_back(src: Bytes) -> { text: Bytes, same: Bool } / {abort.raise} = {
  let out = hash_index(indexed([{ name: b"m", src: src }]));
  let ms = printed_of(out, []);
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  { text: ms.get(0).text, same: by_name(named_hashes(again)) == by_name(named_hashes(out)) }
}

fn trees() -> Bytes =
  b"pub type Tree = | Leaf | Node(Tree, Int) | Other(Int, Tree)\npub type Point = { at: Int, up: Int }\n"

test "an or-pattern binds once, and which binder each alternative gives a name is part of its hash" {
  let over = |arm: Bytes|
    Bytes::concat_all([trees(), b"pub fn f(t: Tree) -> Int = match t { ", arm, b", _ -> 0 }"]);
  let one = |arm: Bytes| dumped_hash(hash_dump([{ name: b"m", src: over(arm) }]), b"m.f");
  // Renaming a binder moves nothing, in whichever alternative it is renamed.
  assert_eq(one(b"Node(_, x) | Other(x, _) -> x"), one(b"Node(_, n) | Other(n, _) -> n"));
  // Giving a name another field of either alternative makes another definition.
  let straight = one(b"Node(Node(_, x), y) | Other(x, Node(_, y)) -> x - y");
  assert(straight != one(b"Node(Node(_, y), x) | Other(x, Node(_, y)) -> x - y"));
  assert(straight != one(b"Node(Node(_, x), y) | Other(y, Node(_, x)) -> x - y"));
  assert_eq(straight, one(b"Node(Node(_, a), b) | Other(a, Node(_, b)) -> a - b"));
  // The body reads the one binder, so both spellings print back as one that checks.
  let back = printed_back(over(b"Node(Node(_, x), y) | Other(y, Node(_, x)) -> x - y"));
  assert(
    back.text.contains(b"(Node(Node(_, _l1), _l2) | Other(_l2, Node(_, _l1))) -> _l1 - _l2"),
    Some(String::of_bytes_lossy(back.text)),
  );
  assert(back.same);
  // Two `let`s that commute are one definition in either order, each binding through a choice.
  let lets = |first: Bytes, second: Bytes|
    dumped_hash(
      hash_dump([
        {
          name: b"m",
          src: Bytes::concat_all([
            b"pub fn f(a: Result<Int, Int>, b: (Int, Int)) -> Int = { ",
            first,
            b" ",
            second,
            b" x - y }",
          ]),
        },
      ]),
      b"m.f",
    );
  assert_eq(
    lets(b"let Ok(x) | Err(x) = a;", b"let (y, 1) | (_, y) = b;"),
    lets(b"let (y, 1) | (_, y) = b;", b"let Ok(x) | Err(x) = a;"),
  )
}

test "`let`s that commute are ordered by the levels they read, so renaming a `let` before them moves nothing" {
  let spread = |first: Bytes, second: Bytes|
    Bytes::concat_all([
      b"pub fn spread(a: Int, b: Int) -> Int = { let ",
      first,
      b" = a + 0; let ",
      second,
      b" = b + 0; let hw = ",
      first,
      b" / 2; let hh = ",
      second,
      b" / 2; hw - hh }",
    ]);
  let one = |src: Bytes| dumped_hash(hash_dump([{ name: b"m", src: src }]), b"m.spread");
  assert_eq(one(spread(b"w", b"h")), one(spread(b"h", b"w")));
  assert(printed_back(spread(b"w", b"h")).same);
  assert(printed_back(spread(b"h", b"w")).same)
}

/// A pattern of each form, and of the forms nested in each other, with the type it is matched at.
fn pattern_samples() -> List<{ of: Bytes, pattern: Bytes }> =
  [
    { of: b"Int", pattern: b"_" },
    { of: b"Int", pattern: b"x" },
    { of: b"Int", pattern: b"1" },
    { of: b"Int", pattern: b"-1" },
    { of: b"String", pattern: b"\"s\"" },
    { of: b"Int", pattern: b"0..=9" },
    { of: b"Int", pattern: b"b'a'..=b'z' | b'_'" },
    { of: b"Int", pattern: b"0..=9 | 20..=29 | -5..=-1" },
    { of: b"Int", pattern: b"1 | (2 | 3)" },
    { of: b"Tree", pattern: b"Leaf" },
    { of: b"Tree", pattern: b"Node(l, _)" },
    { of: b"Tree", pattern: b"Node(_, (1 | 2))" },
    { of: b"Tree", pattern: b"Node(Leaf, n) | Other(n, Leaf)" },
    { of: b"Tree", pattern: b"Node(l, 0..=9) | Other(10..=19, l) | Node(l, 30 | 40..=49)" },
    { of: b"Option<U8>", pattern: b"Some(1u8..=9u8 | 200u8..=255u8)" },
    { of: b"Tree", pattern: b"Node(Node(_, a), b) | Other(b, Node(_, a)) | Node(Other(a, _), b)" },
    { of: b"Point", pattern: b"{at: a, ..}" },
    { of: b"Point", pattern: b"{at: 0, up: u} | {at: u, up: 0}" },
    { of: b"(Int, Int)", pattern: b"(a, b)" },
    { of: b"(Int, Int)", pattern: b"(1 | 2, x) | (x, 3 | 4)" },
    { of: b"(Int, Tree)", pattern: b"(a, Leaf) | (_, (Node(_, a) | Other(a, _)))" },
    { of: b"List<Int>", pattern: b"[]" },
    { of: b"List<Int>", pattern: b"[h, ..]" },
    { of: b"List<Int>", pattern: b"[h, ..rest] | [_, h, ..rest]" },
    {
      of: b"List<Tree>",
      pattern: b"[(Node(_, x) | Other(x, _)), ..rest] | [_, Node(_, x), ..rest]",
    },
  ]

type PatternForms = {
  wildcard: Bool,
  variable: Bool,
  literal: Bool,
  range: Bool,
  constructor: Bool,
  record: Bool,
  list: Bool,
  choice: Bool,
}

/// `seen` with the forms `p` and the patterns inside it are written in. A form added to `Pattern`
/// is added here and to `pattern_samples`, which the test below stores and prints back.
fn pattern_forms(p: Pattern, seen: PatternForms) -> PatternForms =
  match p {
    PWild(_) -> { ..seen, wildcard: true },
    PVar(_) -> { ..seen, variable: true },
    PLit(_) -> { ..seen, literal: true },
    PRange(_) -> { ..seen, range: true },
    PCtor(c) ->
      c.args.fold({ ..seen, constructor: true }, |s: PatternForms, a: Pattern| pattern_forms(a, s)),
    PRecord(r) ->
      r.fields.fold(
        { ..seen, record: true },
        |s: PatternForms, f: { name: Ident, pat: Pattern }| pattern_forms(f.pat, s),
      ),
    PList(l) -> {
      let items = l.items.fold({ ..seen, list: true }, |s: PatternForms, i: Pattern|
        pattern_forms(i, s));
      match l.rest { Some(rest) -> pattern_forms(rest, items), None -> items }
    },
    POr(o) ->
      o.alts.fold({ ..seen, choice: true }, |s: PatternForms, a: Pattern| pattern_forms(a, s)),
    PBad(_) -> seen,
  }

fn matching(sample: { of: Bytes, pattern: Bytes }) -> Bytes =
  Bytes::concat_all([
    trees(),
    b"pub fn f(v: ",
    sample.of,
    b") -> Int = match v { ",
    sample.pattern,
    b" -> 1, _ -> 0 }",
  ])

/// The first arm's pattern of the one function `matching` writes.
fn sampled(sample: { of: Bytes, pattern: Bytes }) -> Pattern / {abort.raise} =
  parse(matching(sample)).node.items.fold(
    PBad({ span: dummy_span() }),
    |found: Pattern, it: Item|
      match it {
        IFn(d) -> match d.body {
          EMatch(m) -> match m.arms.at(0) { Some(arm) -> arm.pat, None -> found },
          _ -> found,
        },
        _ -> found,
      },
  )

fn each_pattern_form(seen: Bool) -> PatternForms =
  {
    wildcard: seen,
    variable: seen,
    literal: seen,
    range: seen,
    constructor: seen,
    record: seen,
    list: seen,
    choice: seen,
  }

test "every form a pattern is written in is stored, and prints back to what it was stored under" {
  let seen = pattern_samples().fold(
    each_pattern_form(false),
    |forms: PatternForms, sample: { of: Bytes, pattern: Bytes }|
      pattern_forms(sampled(sample), forms),
  );
  assert_eq(seen, each_pattern_form(true));
  pattern_samples().fold((), |_: Unit, sample: { of: Bytes, pattern: Bytes }|
    assert(printed_back(matching(sample)).same, Some(String::of_bytes_lossy(sample.pattern))))
}

type StmtForms = { bound: Bool, bound_or_left: Bool, run: Bool, assigned: Bool }

/// `seen` with the form `s` is written in. A form added to `Stmt` is added here and to the block
/// the test below stores and prints back.
fn stmt_forms(s: Stmt, seen: StmtForms) -> StmtForms =
  match s {
    SLet(_) -> { ..seen, bound: true },
    SLetElse(_) -> { ..seen, bound_or_left: true },
    SExpr(_) -> { ..seen, run: true },
    SAssign(_) -> { ..seen, assigned: true },
  }

/// The statements of a body's block, and of its handler clauses' blocks, where an assignment is.
fn body_stmts(body: Expr) -> List<Stmt> =
  match body {
    EBlock(b) -> b.stmts,
    EHandle(h) ->
      h.clauses.fold([], |acc: List<Stmt>, c: HandleClause|
        match c.body { EBlock(b) -> acc.concat(b.stmts), _ -> acc }),
    _ -> [],
  }

test "every form a statement is written in is stored, and prints back to what it was stored under" {
  let src = trees().concat(
    b"pub fn f(t: Tree, xs: List<Int>, c: Bool) -> Int / {abort.raise} = {\n  let Node(_, n) | Other(n, _) = t else { 0 - 1 };\n  let [h, ..] = xs else { if c { n } else { 0 } };\n  let () = (if c { assert(h > 0) }) else { 2 };\n  let (a, b): (Int, Int) = (n, h);\n  assert(a <= b);\n  a + b\n}\npub effect tally { write add(n: Int) -> Unit }\npub fn g(xs: List<Int>) -> Int = handle { xs.fold((), |u: Unit, x: Int| tally.add(x)) } with {\n  var sum: Int = 0,\n  tally.add(n) -> {\n    sum = sum + n;\n  },\n  return u -> sum,\n}",
  );
  let seen = parse(src).node.items.fold(
    { bound: false, bound_or_left: false, run: false, assigned: false },
    |forms: StmtForms, it: Item|
      match it {
        IFn(d) -> body_stmts(d.body).fold(forms, |f: StmtForms, s: Stmt| stmt_forms(s, f)),
        _ -> forms,
      },
  );
  assert_eq(seen, { bound: true, bound_or_left: true, run: true, assigned: true });
  let back = printed_back(src);
  assert(back.text.contains(b" else {"), Some(String::of_bytes_lossy(back.text)));
  assert(back.same, Some(String::of_bytes_lossy(back.text)))
}

type ExprForms = {
  literal: Bool,
  variable: Bool,
  binary: Bool,
  unary: Bool,
  lambda: Bool,
  call: Bool,
  conditional: Bool,
  matched: Bool,
  block: Bool,
  record: Bool,
  update: Bool,
  field: Bool,
  list: Bool,
  performed: Bool,
  handled: Bool,
  held: Bool,
  simulated: Bool,
  branched: Bool,
  tagged: Bool,
  filled: Bool,
  attempted: Bool,
}

fn each_expr_form(seen: Bool) -> ExprForms =
  {
    literal: seen,
    variable: seen,
    binary: seen,
    unary: seen,
    lambda: seen,
    call: seen,
    conditional: seen,
    matched: seen,
    block: seen,
    record: seen,
    update: seen,
    field: seen,
    list: seen,
    performed: seen,
    handled: seen,
    held: seen,
    simulated: seen,
    branched: seen,
    tagged: seen,
    filled: seen,
    attempted: seen,
  }

/// `seen` with the form `e` is written in. A form added to `Expr` is added here and to
/// `expr_samples`, which the test below stores and prints back. A `?` is expanded away before a
/// body is stored.
fn expr_forms(e: Expr, seen: ExprForms) -> ExprForms =
  match e {
    ELit(_) -> { ..seen, literal: true },
    EVar(_) -> { ..seen, variable: true },
    EBinary(_) -> { ..seen, binary: true },
    EUnary(_) -> { ..seen, unary: true },
    ELambda(_) -> { ..seen, lambda: true },
    EApp(_) -> { ..seen, call: true },
    EIf(_) -> { ..seen, conditional: true },
    EMatch(_) -> { ..seen, matched: true },
    EBlock(_) -> { ..seen, block: true },
    ERecord(_) -> { ..seen, record: true },
    ERecordUpdate(_) -> { ..seen, update: true },
    EField(_) -> { ..seen, field: true },
    EList(_) -> { ..seen, list: true },
    EPerform(_) -> { ..seen, performed: true },
    EHandle(_) -> { ..seen, handled: true },
    EWithHold(_) -> { ..seen, held: true },
    ESimulate(_) -> { ..seen, simulated: true },
    EParallel(_) -> { ..seen, branched: true },
    ETagged(t) -> if t.holes.len() == 0 { { ..seen, tagged: true } }
    else { { ..seen, filled: true } },
    ETryBlock(_) -> { ..seen, attempted: true },
    ETry(_) -> seen,
    EBad(_) -> seen,
  }

/// A body of each form an expression is written in, over what `expr_program` declares around it.
fn expr_samples() -> List<Bytes> =
  [
    b"1",
    b"x",
    b"x + 1",
    b"-x",
    b"|y: Int| y + x",
    b"relay[conn](g(x))",
    b"if x > 0 { 1 } else { 2 }",
    b"match x { 0 -> 1, _ -> 2 }",
    b"{ let y = x; y }",
    b"{ at: x, up: 1 }",
    b"{ ..p, at: 1 }",
    b"p.at",
    b"[x, 1]",
    b"net.send[conn](x)",
    b"handle { net.send[conn](x) } with { net.send[conn](y) resume k -> k(y), return v -> v }",
    b"handle { net.send[conn](x) } with { var sent = x, net.send[conn](y) -> { sent = sent + y; y }, return v -> v + sent }",
    b"with_hold[file](x + 1, |v: Int| net.send[conn](v)) { h -> h.get() + x }",
    b"simulate { x }",
    b"parallel { x, 1 }",
    b"hex\"ff\"",
    b"marks\"a {x} { { at: x, up: 1 } }\"",
    b"try { g(x) }",
    b"try[abort.raise] { g(x) }",
  ]

fn expr_program(body: Bytes) -> List<Source> =
  [
    {
      name: b"hex",
      src: b"pub fn literal(text: String) -> Result<Int, { message: String, offset: Int }> = Ok(1)",
    },
    {
      name: b"marks",
      src: b"pub fn compile(parts: List<String>) -> Result<Int, { message: String, offset: Int, part: Int }> = Ok(1)\npub fn fill(c: Int, holes: List<Int>) -> Int = c",
    },
    {
      name: b"m",
      src: Bytes::concat_all([
        b"import hex\nimport marks\n",
        trees(),
        b"pub effect net { write send[c](x: Int) -> Int }\npub fn g(x: Int) -> Int = x\npub fn relay<[l]>(x: Int) -> Int / {net.write[l]} = net.send[l](x)\npub fn f(x: Int, p: Point) -> Int = ",
        body,
      ]),
    },
  ]

/// The body of `m.f` as the hasher reads it.
fn read_body(index: Index) -> Expr =
  index.nodes.fold(EBad({ span: dummy_span() }), |found: Expr, n: Node|
    if n.name != b"m.f" { found } else { match n.body { NodeFn(d) -> d.body, _ -> found } })

test "every form an expression is written in is stored, and prints back to what it was stored under" {
  let seen = expr_samples().fold(each_expr_form(false), |forms: ExprForms, body: Bytes|
    expr_forms(read_body(indexed(expr_program(body))), forms));
  assert_eq(seen, each_expr_form(true));
  expr_samples().fold((), |_: Unit, body: Bytes| {
    let out = hash_index(indexed(expr_program(body)));
    let again = hash_index(
      indexed(
        printed_of(out, []).map(|m: { module: Bytes, text: Bytes }|
          { name: m.module, src: m.text }),
      ),
    );
    assert(
      by_name(named_hashes(again)) == by_name(named_hashes(out)),
      Some(String::of_bytes_lossy(body)),
    )
  })
}

test "a `returns` clause prints back to what it was stored under, naming the parameter it names" {
  let back = printed_back(
    b"pub fn kept(n: Int, xs: List<Int>) -> List<Int>\n  returns xs\n= xs\npub fn made(n: Int) -> List<Int>\n  returns fresh\n= [n]\npub fn down(n: Int, xs: List<Int>) -> List<Int>\n  returns xs\n  decreases n\n= if n <= 0 { xs } else { down(n - 1, xs) }",
  );
  assert(back.text.contains(b"\n  returns _l1 ="), Some(String::of_bytes_lossy(back.text)));
  assert(back.text.contains(b"\n  returns fresh ="), Some(String::of_bytes_lossy(back.text)));
  assert(
    back.text.contains(b"\n  returns _l1\n  decreases _l0 ="),
    Some(String::of_bytes_lossy(back.text)),
  );
  assert(back.same)
}

test "what a row promises `bounded` prints back to what it was stored under: an atom, its row variable, or both" {
  let back = printed_back(
    b"pub effect net { write send[c](x: Int) -> Int }\npub fn atom(x: Int) -> Int / {net.write[conn] bounded} = net.send[conn](x)\npub fn op(x: Int) -> Int / {net.send[conn] bounded, abort.raise} = net.send[conn](x)\npub fn tail<| e>(f: () -> Int / e) -> Int / e bounded = f()\npub fn both<a | e>(x: a, f: (a) -> Int / e) -> Int / {net.write[conn] bounded | e bounded} where derivable(eq, a) = net.send[conn](f(x))\npub fn neither<| e>(f: () -> Int / e, g: (() -> Int / e) -> Int / e) -> Int / e = g(f)",
  );
  let text = String::of_bytes_lossy(back.text);
  assert(back.text.contains(b"/ {net.write[conn] bounded} ="), Some(text));
  assert(back.text.contains(b"net.send[conn] bounded"), Some(text));
  assert(back.text.contains(b"/ _e0 bounded ="), Some(text));
  assert(back.text.contains(b"/ {net.write[conn] bounded | _e0 bounded} where"), Some(text));
  assert(back.same, Some(text));
  let plain = |row: Bytes|
    dumped_hash(
      hash_dump([
        {
          name: b"m",
          src: Bytes::concat_all([b"pub fn f<| e>(g: () -> Int / e) -> Int / ", row, b" = g()"]),
        },
      ]),
      b"m.f",
    );
  assert(plain(b"e") != plain(b"e bounded"))
}

test "printed bodies hash back to what they were stored under, under their own names" {
  let out = hash_index(
    indexed([
      {
        name: b"left.util",
        src: b"pub type Shape = | Dot | Line(Int)\npub fn size(s: Shape) -> Int = match s { Dot -> 0, Line(n) -> n }",
      },
      {
        name: b"right.util",
        src: b"pub fn big() -> Float = 0.1 + 1e300\npub fn tiny() -> Decimal = 0.050m\npub fn raw() -> Bytes = b\"\\x00\\\"q\"",
      },
      {
        name: b"app",
        src: b"import left.util as l\nfn even(n: Int) -> Bool = if n == 0 { true } else { odd(n - 1) }\nfn odd(n: Int) -> Bool = if n == 0 { false } else { even(n - 1) }\nfn all() -> Int = l::size(l::Line(0xFFFFFFFFFFFFFFFF)) + (match 255u8 { _ -> 1 })",
      },
    ]),
  );
  let ms = printed_of(out, []);
  assert_eq(ms.map(|m: { module: Bytes, text: Bytes }| m.module), [
    b"app",
    b"left.util",
    b"right.util",
  ]);
  assert(ms.get(0).text.contains(b"import left.util as left_util\n"));
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)));
  let shipped = printed_of(out, [b"left.util"]);
  assert_eq(shipped.map(|m: { module: Bytes, text: Bytes }| m.module), [b"app", b"right.util"])
}

test "a body that compares, digests or names a function of a type prints back and hashes alike" {
  let out = hash_index(
    indexed([
      {
        name: prelude_module(),
        src: b"pub fn List::at<a>(xs: List<a>, i: Int) -> Option<a> = None\npub fn List::push<a>(xs: List<a>, x: a) -> List<a> = xs\n",
      },
      {
        name: b"app",
        src: b"pub fn same(a: List<Int>, b: List<Int>) -> Bool = a == b\npub fn hashed(a: List<Int>) -> Bytes = digest(a)\npub fn named(a: List<Int>) -> Bytes = List::digest(a)\npub fn both(a: Int) -> Bool = a != 0 && digest(a) == b\"\"\n",
      },
    ]),
  );
  let written = [
    { name: b"std.prelude.List::at", decl: false },
    { name: b"std.prelude.List::push", decl: false },
  ];
  assert_eq(
    [b"app.same", b"app.hashed", b"app.named", b"app.both"].map(|n: Bytes| named_in(out, TheFn(n))),
    [written, written, [], written],
  );
  let ms = printed_of(out, []);
  let app = ms.filter(|m: { module: Bytes, text: Bytes }| m.module == b"app").get(0).text;
  assert(
    app.contains(b"_l0 == _l1") && app.contains(b"digest(_l0)")
      && app.contains(b"List::digest(_l0)"),
    Some(String::of_bytes_lossy(app)),
  );
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "a body that calls on a value prints back importing each module whose function it may call" {
  let hashed = hash_index(
    indexed([
      { name: b"low", src: b"pub type A = | A\npub fn A::go(a: A) -> Int = 1" },
      { name: b"app", src: b"import low\npub fn gone(xs: List<Int>) -> Int = xs.go()" },
    ]),
  );
  // What a check finds of `xs.go()`: none of the functions it may be.
  let out = {
    ..hashed,
    bodies: hashed.bodies.map(|b: { name: Bytes, body: Bytes }|
      { ..b, body: checked_body(b.body, Map::new()) }),
  };
  let ms = printed_of(out, []);
  assert(ms.get(0).text.contains(b"import low\n"));
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "a call on a value prints as a call of what its check found it calls, set apart or not" {
  let src = b"pub type Bag = | Bag(Int)\npub fn Bag::size(b: Bag) -> Int = match b { Bag(n) -> n + 1 }\npub type Cart = | Cart(Int)\npub fn Cart::size(c: Cart) -> Int = match c { Cart(n) -> n }\npub fn Cart::scaled(c: Cart, by: Int = 2, plus: Int = 0) -> Int = c.size() * by + plus\npub fn total(c: Cart) -> Int = c.size()\npub fn more(c: Cart) -> Int = c.scaled(plus: 3)";
  let index = indexed([{ name: b"m", src: src }]);
  let body_of = |name: Bytes|
    index.nodes.fold(dummy_span(), |acc: Span, n: Node|
      match n.body { NodeFn(d) -> if n.name == name { expr_span(d.body) } else { acc }, _ -> acc });
  let fixed = hashed_forms(
    chosen_forms(index, [0], {
      ..chosen_in(index, 0),
      called: Some(
        Map::of_entries([
          { key: site_key(0, body_of(b"m.total")), value: { callee: b"m.Cart::size", named: [] } },
          {
            key: site_key(0, body_of(b"m.more")),
            value: { callee: b"m.Cart::scaled", named: [2] },
          },
        ]),
      ),
    }),
    [],
  ).nodes;
  let item = |apart: Bool, name: Bytes|
    match print_bodies(
        fixed.map(|f: Fixed| f.body),
        fixed.map(|f: Fixed| { name: f.name, hash: f.hash, public: true }),
        [],
        [],
        [],
        apart,
      ) {
      Printed(ms) ->
        ms.get(0).text.split(b"\n\n").fold(b"", |acc: Bytes, it: Bytes|
          if it.contains(Bytes::concat_all([b"fn ", name, b"("])) { it } else { acc }),
      Unprintable(why) -> panic(String::of_bytes(why.message)),
    };
  let shown = |t: Bytes| Some(String::of_bytes_lossy(t));
  // Set apart, a function of a type is a plain function under another name.
  let apart = item(true, b"total");
  assert(apart.contains(b"Cart::size(_l0)") && !apart.contains(b".size("), shown(apart));
  // Under its own names it is written as it was, which hashes back to what it was stored under.
  let own = item(false, b"total");
  assert(own.contains(b".size()"), shown(own));
  // A printed function's parameters are named by their places, and so is an argument a call names.
  let named_apart = item(true, b"more");
  assert(named_apart.contains(b"Cart::scaled(_l0, _l2: 3)"), shown(named_apart));
  let named_own = item(false, b"more");
  assert(named_own.contains(b".scaled(_l2: 3)"), shown(named_own))
}

test "every deriver a constraint names prints back and hashes back to what it was stored under" {
  let out = hash_index(
    indexed([
      {
        name: b"app",
        src: b"pub fn j<a>(x: a) -> a where derivable(json, a) = x\npub fn e<a>(x: a) -> a where derivable(eq, a) = x\npub fn o<a>(x: a) -> a where derivable(ord, a) = x\npub fn b<a>(x: a) -> a where derivable(bin, a) = x\npub fn s<a>(x: a) -> a where derivable(show, a) = x",
      },
    ]),
  );
  let ms = printed_of(out, []);
  assert(ms.get(0).text.contains(b"derivable(bin, "));
  assert(ms.get(0).text.contains(b"derivable(show, "));
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "a parallel block prints back as written and hashes back to what it was stored under" {
  let out = hash_index(
    indexed([
      { name: b"app", src: b"pub fn both(n: Int) -> (Int, Bool) = parallel { n + 1, n > 0 }" },
    ]),
  );
  let ms = printed_of(out, []);
  assert(ms.get(0).text.contains(b"parallel { "));
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "a `with_hold` prints back as written and hashes back to what it was stored under" {
  let src = |region: Bytes|
    Bytes::concat_all([
      b"pub effect io { write close(n: Int) -> Unit }\n",
      b"pub fn held(n: Int) -> Int / {io.close} = with_hold[",
      region,
      b"](n + 1, |x: Int| io.close(x)) { h -> h.get() }",
    ]);
  let hash_of = |out: HashOutput| {
    match by_name(named_hashes(out)).get(b"app.held") {
      Some(h) -> h,
      None -> panic("the index names held"),
    }
  };
  let out = hash_index(indexed([{ name: b"app", src: src(b"file") }]));
  let ms = printed_of(out, []);
  assert(ms.get(0).text.contains(b"with_hold[file]("));
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)));
  // The region is part of what a hold is typed as, so its name is hashed.
  assert(hash_of(hash_index(indexed([{ name: b"app", src: src(b"other") }]))) != hash_of(out))
}

test "a `try` and a `raise` operation print back as written and hash back to what they were stored under" {
  let src = |tried: Bytes|
    Bytes::concat_all([
      b"pub effect p { raise bad(n: Int) }\npub fn g(n: Int) -> Int / {p.bad} = p.bad(n)\n",
      b"pub fn f(n: Int) -> Result<Int, Int> = ",
      tried,
    ]);
  let hash_of = |out: HashOutput| {
    match by_name(named_hashes(out)).get(b"m.f") {
      Some(h) -> h,
      None -> panic("the index names f"),
    }
  };
  let out = hash_index(indexed([{ name: b"m", src: src(b"try[p.bad] { g(n) }") }]));
  let ms = printed_of(out, []);
  assert(ms.get(0).text.contains(b"raise bad(Int)\n"));
  assert(ms.get(0).text.contains(b"try[p.bad] {"));
  let again = hash_index(indexed([{ name: b"m", src: ms.get(0).text }]));
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)));
  // One that names no raise reads it off its body, which is all its hash holds.
  let unnamed = hash_index(indexed([{ name: b"m", src: src(b"try { g(n) }") }]));
  assert(printed_of(unnamed, []).get(0).text.contains(b"try {"));
  assert(hash_of(unnamed) != hash_of(out))
}

test "a tagged literal prints back under a binder whose module names its parser `literal`" {
  // One body under two names: only a module that calls it `literal` can be the literal's tag.
  let parser = b"(text: String) -> Result<Int, { message: String, offset: Int }> = Ok(1)";
  let out = hash_index(
    indexed([
      { name: b"aaa", src: b"pub fn of_text".concat(parser) },
      { name: b"hex", src: b"pub fn literal".concat(parser) },
      { name: b"app", src: b"import hex as h\npub fn two() -> Int = h\"a\\\"b\" + h\"\"" },
    ]),
  );
  let ms = printed_of(out, []);
  assert(ms.get(1).text.contains(b"hex\"a\\\"b\" + hex\"\""));
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "a tagged literal's braces print doubled, and its holes under a binder that names `compile` and `fill`" {
  // One body under two names: only a module that calls them `compile` and `fill` can be the tag.
  let compiler = b"(parts: List<String>) -> Result<Int, { message: String, offset: Int, part: Int }> = Ok(1)";
  let filler = b"(c: Int, holes: List<Int>) -> Int = c";
  let parser = b"(text: String) -> Result<Int, { message: String, offset: Int }> = Ok(1)";
  let out = hash_index(
    indexed([
      {
        name: b"aaa",
        src: Bytes::concat_all([b"pub fn compile", compiler, b"\npub fn stuffed", filler]),
      },
      {
        name: b"sh",
        src: Bytes::concat_all([
          b"pub fn compile",
          compiler,
          b"\npub fn fill",
          filler,
          b"\npub fn literal",
          parser,
        ]),
      },
      {
        name: b"app",
        src: b"import sh as s\npub fn two() -> Int = s\"a{{b}} {1 + 2}\\\"{s\"{{\"}\" + s\"}}\"",
      },
    ]),
  );
  let ms = printed_of(out, []);
  let spelled = b"sh\"a{{b}} {1 + 2}\\\"{sh\"{{\"}\" + sh\"}}\"";
  assert(
    ms.fold(false, |found: Bool, m: { module: Bytes, text: Bytes }|
      found || m.text.contains(spelled)),
  );
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "a hole that opens with a brace of its own prints apart from the brace that opens it" {
  let out = hash_index(
    indexed([
      {
        name: b"marks",
        src: b"pub type Mark = { text: String }\npub fn compile(parts: List<String>) -> Result<Int, { message: String, offset: Int, part: Int }> = Ok(1)\npub fn fill(c: Int, holes: List<Mark>) -> Int = c + holes.len()",
      },
      {
        name: b"app",
        src: b"import marks\nimport marks (Mark)\npub fn two(n: Int, old: Mark) -> Int = marks\"a { { text: \"x\" } } { { ..old, text: \"y\" } }{ { let k = n + 1; { text: int_to_string(k) } } }{{}}\"",
      },
    ]),
  );
  let ms = printed_of(out, []);
  let text = ms.get(0).text;
  assert(
    text.contains(b"marks\"a { {text: \"x\"}} { {.._l1, text: \"y\"}}{ {"),
    Some(String::of_bytes_lossy(text)),
  );
  assert(text.contains(b"}{{}}\""), Some(String::of_bytes_lossy(text)));
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "a reference is printed under a name the module holding it exports" {
  // One body under two names, in modules that ship rather than print: which name a reference is
  // printed under is a choice, and only one of them is a name another module may write.
  let out = hash_index(
    indexed([
      { name: b"hidden", src: b"fn span() -> Int = 4\npub fn stride() -> Int = span() + 1" },
      { name: b"shelf", src: b"pub fn width() -> Int = 4" },
      { name: b"app", src: b"import shelf\npub fn wide() -> Int = shelf::width()" },
    ]),
  );
  let named = by_name(named_hashes(out));
  assert_eq(named.get(b"shelf.width"), named.get(b"hidden.span"));
  let names = named_hashes(out).map(|x: { name: Bytes, hash: Bytes }|
    { name: x.name, hash: x.hash, public: x.name != b"hidden.span" });
  match print_bodies(out.bodies.map(|b: { name: Bytes, body: Bytes }| b.body), names, [], [], [
      b"hidden",
      b"shelf",
    ]) {
    Unprintable(why) -> panic(String::of_bytes(why.message)),
    Printed(ms) -> {
      assert_eq(ms.map(|m: { module: Bytes, text: Bytes }| m.module), [b"app"]);
      assert(ms.get(0).text.contains(b"shelf::width()"));
      assert(!ms.get(0).text.contains(b"hidden::"))
    },
  }
}

test "an operation atom hashes apart from its mode atom and prints back as written" {
  let src = |access: Bytes|
    Bytes::concat_all([
      b"pub effect net { write send[c](x: Int) -> Int }\npub fn f() -> Int / {net.",
      access,
      b"[conn]} = 1",
    ]);
  let hash_of = |out: HashOutput| {
    match by_name(named_hashes(out)).get(b"m.f") {
      Some(h) -> h,
      None -> panic("the index names f"),
    }
  };
  let out = hash_index(indexed([{ name: b"m", src: src(b"send") }]));
  let ms = printed_of(out, []);
  assert(ms.get(0).text.contains(b"net.send[conn]"));
  let again = hash_index(indexed([{ name: b"m", src: ms.get(0).text }]));
  assert_eq(hash_of(again), hash_of(out));
  assert(hash_of(out) != hash_of(hash_index(indexed([{ name: b"m", src: src(b"write") }]))))
}

test "renaming a label binder does not move a hash, and renaming a real resource does" {
  let bound = |label: Bytes|
    Bytes::concat_all([
      b"pub effect net { write send[c](x: Int) -> Int }\n",
      b"pub fn relay<[",
      label,
      b"]>(x: Int) -> Int / {net.send[",
      label,
      b"]} = net.send[",
      label,
      b"](x)\n",
      b"pub fn outer<[",
      label,
      b"]>(x: Int) -> Int / {net.send[",
      label,
      b"]} = relay[",
      label,
      b"](x)\n",
      b"pub fn caught<[",
      label,
      b"]>(x: Int) -> Int = handle { relay[",
      label,
      b"](x) } with { net.send[",
      label,
      b"](n) -> n }",
    ]);
  let loose = |res: Bytes|
    Bytes::concat_all([
      b"pub effect net { write send[c](x: Int) -> Int }\n",
      b"pub fn relay(x: Int) -> Int / {net.send[",
      res,
      b"]} = net.send[",
      res,
      b"](x)",
    ]);
  let hash_of = |src: Bytes, name: Bytes| {
    let out = hash_index(indexed([{ name: b"m", src: src }]));
    match by_name(named_hashes(out)).get(name) {
      Some(h) -> h,
      None -> panic("the index names the definition"),
    }
  };
  assert_eq(hash_of(bound(b"l"), b"m.relay"), hash_of(bound(b"k"), b"m.relay"));
  assert_eq(hash_of(bound(b"l"), b"m.outer"), hash_of(bound(b"k"), b"m.outer"));
  assert_eq(hash_of(bound(b"l"), b"m.caught"), hash_of(bound(b"k"), b"m.caught"));
  assert(hash_of(loose(b"conn"), b"m.relay") != hash_of(loose(b"sock"), b"m.relay"));
  assert(hash_of(bound(b"l"), b"m.relay") != hash_of(loose(b"l"), b"m.relay"))
}

test "a label binder, the resources it names and the labels a call fills print back under their levels" {
  let out = hash_index(
    indexed([
      {
        name: b"m",
        src: Bytes::concat_all([
          b"pub effect net { write send[c](x: Int) -> Int }\n",
          b"pub fn relay<[l]>(x: Int) -> Int / {net.send[l]} = net.send[l](x)\n",
          b"pub fn outer<[l]>(x: Int) -> Int / {net.send[l]} = relay[l](x)\n",
          b"pub fn caught<[l]>(x: Int) -> Int = handle { relay[l](x) } with { net.send[l](n) -> n }\n",
          b"pub fn plain(x: Int) -> Int / {net.send[conn]} = relay[conn](x)",
        ]),
      },
    ]),
  );
  let ms = printed_of(out, []);
  assert(ms.get(0).text.contains(b"fn relay<[_r0]>"));
  assert(ms.get(0).text.contains(b"/ {net.send[_r0]}"));
  assert(ms.get(0).text.contains(b"net.send[_r0](_l0)"));
  assert(ms.get(0).text.contains(b"relay[_r0](_l0)"));
  assert(ms.get(0).text.contains(b"net.send[_r0](_l1) -> _l1"));
  assert(ms.get(0).text.contains(b"/ {net.send[conn]}"));
  assert(ms.get(0).text.contains(b"relay[conn](_l0)"));
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "renaming an operation's type parameter does not move a hash, and it prints back bound" {
  let boxed = |v: Bytes|
    Bytes::concat_all([
      b"pub effect box { read take[k]<",
      v,
      b">(xs: List<",
      v,
      b">) -> ",
      v,
      b" }",
    ]);
  let out = hash_index(indexed([{ name: b"m", src: boxed(b"a") }]));
  let renamed = hash_index(indexed([{ name: b"m", src: boxed(b"b") }]));
  assert_eq(by_name(named_hashes(renamed)), by_name(named_hashes(out)));
  let ms = printed_of(out, []);
  assert(ms.get(0).text.contains(b"read take[r]<_t0>(List<_t0>) -> _t0"));
  let again = hash_index(indexed([{ name: b"m", src: ms.get(0).text }]));
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "a type's label and row binders are levels, what it is applied to is hashed, and both print back" {
  let held = |row: Bytes, label: Bytes, given: Bytes|
    Bytes::concat_all([
      b"pub effect net { write send[c](x: Int) -> Int }\n",
      b"pub type Sink<a, [",
      label,
      b"] | ",
      row,
      b"> = | Sink(a, (Int) -> Int / {net.send[",
      label,
      b"] | ",
      row,
      b"})\npub type Step<| ",
      row,
      b"> = () -> Int / ",
      row,
      b"\npub fn held(s: Sink<Int, [",
      given,
      b"] | {}>, f: Step<| {net.send[",
      given,
      b"]}>) -> Int = 1",
    ]);
  let hashed = |src: Bytes| hash_index(indexed([{ name: b"m", src: src }]));
  let out = hashed(held(b"e", b"l", b"conn"));
  let named = by_name(named_hashes(out));
  assert_eq(by_name(named_hashes(hashed(held(b"f", b"k", b"conn")))), named);
  assert(
    by_name(named_hashes(hashed(held(b"e", b"l", b"sock")))).get(b"m.held") != named.get(b"m.held"),
  );
  let ms = printed_of(out, []);
  assert(ms.get(0).text.contains(b"type Sink<_t0, [_r0] | _e0> = "));
  assert(ms.get(0).text.contains(b"(Int) -> Int / {net.send[_r0] | _e0}"));
  assert(ms.get(0).text.contains(b"type Step<| _e0> = () -> Int / _e0"));
  assert(ms.get(0).text.contains(b"Sink<Int, [conn] | {}>"));
  assert(ms.get(0).text.contains(b"Step<| {net.send[conn]}>"));
  let again = hashed(ms.get(0).text);
  assert_eq(by_name(named_hashes(again)), named)
}

test "two effects that differ only in their names are two declarations" {
  let out = hash_index(
    indexed([
      { name: b"a", src: b"pub effect one { read at() -> Int }" },
      { name: b"b", src: b"pub effect two { read at() -> Int }" },
    ]),
  );
  let named = by_name(named_hashes(out));
  // Nominal: the shapes match, so only the names tell the two apart, and a hash has to.
  assert(named.get(b"a.one") != None);
  assert(named.get(b"a.one") != named.get(b"b.two"))
}

test "one effect declaration under two names is refused, since a body cannot say which it performs" {
  // One simple name in two modules: a module path is no part of an identity, so this is a single
  // declaration, and naming it twice leaves a body that performs it with no name to be printed under.
  let out = hash_index(
    indexed([
      { name: b"a", src: b"pub effect one { read at() -> Int }" },
      { name: b"b", src: b"pub effect one { read at() -> Int }" },
    ]),
  );
  let named = by_name(named_hashes(out));
  assert_eq(named.get(b"a.one"), named.get(b"b.one"));
  match print_bodies(
      out.bodies.map(|b: { name: Bytes, body: Bytes }| b.body),
      all_public(named_hashes(out)),
      [],
      [],
      [],
    ) {
    Printed(_) -> panic("two names for one declaration must be refused"),
    Unprintable(why) ->
      assert_eq(
        why.message,
        b"`a.one`, `b.one` are one effect declaration, so a body cannot say which it performs",
      ),
  }
}

test "two sums that differ only in their names are two declarations, and one sum in two modules is one" {
  let apart = hash_index(
    indexed([
      { name: b"a", src: b"pub type One = | Wrap(Int)" },
      { name: b"b", src: b"pub type Two = | Wrap(Int)" },
    ]),
  );
  let named = by_name(named_hashes(apart));
  // `unify_structural` compares a `TyCon` by name, so a hash that ignored it would call two types
  // the checker refuses to unify one type.
  assert(named.get(b"a.One") != None);
  assert(named.get(b"a.One") != named.get(b"b.Two"));
  // The module path is no part of it, so the same declaration in two places is one declaration.
  let together = by_name(
    named_hashes(
      hash_index(
        indexed([
          { name: b"a", src: b"pub type One = | Wrap(Int)" },
          { name: b"b", src: b"pub type One = | Wrap(Int)" },
        ]),
      ),
    ),
  );
  assert_eq(together.get(b"a.One"), together.get(b"b.One"))
}

test "a type two modules declare alike is printed under the name a definition names, where the print is told" {
  let out = hash_index(
    indexed([
      {
        name: b"a",
        src: b"pub type Limits = new { most: Int }\npub fn fa(l: Limits) -> Int = l.most + 1",
      },
      {
        name: b"b",
        src: b"pub type Limits = new { most: Int }\npub fn fb(l: Limits) -> Int = l.most * 2",
      },
      {
        name: b"app",
        src: b"import a\nimport b\npub fn roomy() -> b::Limits = { most: 1 }\npub fn main() -> Int = b::fb(roomy()) + a::fa({ most: 2 })",
      },
    ]),
  );
  let closure = held_by(out, [b"app.main"]);
  let print = |told: Bool|
    match print_bodies(
        out.bodies.map(|b: { name: Bytes, body: Bytes }| b.body),
        closure.map(|x: Closed| { name: x.name, hash: x.hash, public: true }),
        [],
        [],
        [],
        false,
        if told {
          closure.map(|x: Closed|
            { name: x.name, hash: x.hash, names: x.refs.map(|i: Int| closure.get(i).name) })
        } else { [] },
      ) {
      Printed(ms) ->
        ms.fold(b"", |found: Bytes, m: { module: Bytes, text: Bytes }|
          if m.module == b"app" { m.text } else { found }),
      Unprintable(why) -> panic(String::of_bytes(why.message)),
    };
  // The two are one body, so a print that is told nothing names the nearer, which is the wrong one.
  assert(print(false).contains(b"pub fn roomy() -> a::Limits"));
  assert(print(true).contains(b"pub fn roomy() -> b::Limits"))
}

test "a `new` record is its name and its fields, and no alias of those fields" {
  let m = |src: Bytes| by_name(named_hashes(hash_index(indexed([{ name: b"m", src: src }]))));
  let date = m(b"pub type Date = new { day: Int }\npub fn mk() -> Date = { day: 1 }");
  let other = m(b"pub type Span = new { day: Int }\npub fn mk() -> Span = { day: 1 }");
  let alias = m(b"pub type Date = { day: Int }\npub fn mk() -> Date = { day: 1 }");
  assert(date.get(b"m.Date") != None);
  assert(date.get(b"m.Date") != other.get(b"m.Span"));
  assert(date.get(b"m.mk") != other.get(b"m.mk"));
  assert(date.get(b"m.Date") != alias.get(b"m.Date"));
  assert(date.get(b"m.mk") != alias.get(b"m.mk"));
  // The module path is no part of it, as with a sum.
  let vendored = by_name(
    named_hashes(
      hash_index(
        indexed([
          { name: b"a", src: b"pub type Date = new { day: Int }" },
          { name: b"b", src: b"pub type Date = new { day: Int }" },
        ]),
      ),
    ),
  );
  assert_eq(vendored.get(b"a.Date"), vendored.get(b"b.Date"))
}

test "a `new` record prints back as one and hashes back to what it was stored under" {
  let out = hash_index(
    indexed([
      {
        name: b"m",
        src: b"pub type Date<a> = new { day: Int, of: a }\npub fn mk() -> Date<Int> = { day: 1, of: 2 }",
      },
    ]),
  );
  let ms = printed_of(out, []);
  assert(ms.get(0).text.contains(b" = new {"));
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "a type's hash says whether it is opaque, what holds it moves with it, and it prints back" {
  let m = |src: Bytes| by_name(named_hashes(hash_index(indexed([{ name: b"m", src: src }]))));
  let open = m(b"pub type Date = new { day: Int }\npub fn day(d: Date) -> Int = d.day");
  let closed = m(b"pub opaque type Date = new { day: Int }\npub fn day(d: Date) -> Int = d.day");
  assert(open.get(b"m.Date") != closed.get(b"m.Date"));
  assert(open.get(b"m.day") != closed.get(b"m.day"));
  // `pub` is still no part of it.
  let kept = m(b"opaque type Date = new { day: Int }\nfn day(d: Date) -> Int = d.day");
  assert_eq(kept.get(b"m.Date"), closed.get(b"m.Date"));
  let sum = m(b"pub type Tok = | Tok(Int)\npub fn mk() -> Tok = Tok(1)");
  let closed_sum = m(b"pub opaque type Tok = | Tok(Int)\npub fn mk() -> Tok = Tok(1)");
  assert(sum.get(b"m.Tok") != closed_sum.get(b"m.Tok"));
  assert(sum.get(b"m.mk") != closed_sum.get(b"m.mk"));
  let out = hash_index(
    indexed([
      {
        name: b"m",
        src: b"pub opaque type Tok = | Tok(Int)\nkey for Tok by n\nfn n(t: Tok) -> Int = match t { Tok(i) -> i }\npub opaque type Date = new { day: Int }\npub fn mk() -> Date = { day: n(Tok(1)) }",
      },
    ]),
  );
  let ms = printed_of(out, []);
  assert(ms.get(0).text.contains(b"pub opaque type Tok = | Tok(Int)"));
  assert(ms.get(0).text.contains(b"\nkey for Tok by n"));
  assert(ms.get(0).text.contains(b"pub opaque type Date = new {"));
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)));
  // Set apart from the module that wrote them, its bodies build the type from wherever they are.
  let apart = match print_bodies(
      out.bodies.map(|b: { name: Bytes, body: Bytes }| b.body),
      all_public(named_hashes(out)),
      [],
      [],
      [],
      true,
    ) {
    Printed(open) -> open.get(0).text,
    Unprintable(why) -> panic(String::of_bytes(why.message)),
  };
  assert(apart.contains(b"pub type Tok = | Tok(Int)"));
  assert(!apart.contains(b"opaque"))
}

test "an alias is transparent, so its name is no part of it" {
  let m = |src: Bytes| by_name(named_hashes(hash_index(indexed([{ name: b"m", src: src }]))));
  // `conv_type` expands an alias in place, so these two declare one type and use it alike.
  let metres = m(b"pub type Metres = Int\npub fn go(x: Metres) -> Metres = x");
  let feet = m(b"pub type Feet = Int\npub fn go(x: Feet) -> Feet = x");
  assert_eq(metres.get(b"m.Metres"), feet.get(b"m.Feet"));
  assert_eq(metres.get(b"m.go"), feet.get(b"m.go"));
  // A record alias is structural in the checker too, so naming one differently changes no use of it.
  let as_p = m(b"pub type P = { a: Int }\npub fn mk() -> P = { a: 1 }");
  let as_q = m(b"pub type Q = { a: Int }\npub fn mk() -> Q = { a: 1 }");
  assert_eq(as_p.get(b"m.mk"), as_q.get(b"m.mk"))
}

test "a definition's hash follows the name of the effect it performs" {
  let one = hash_index(
    indexed([
      {
        name: b"m",
        src: b"pub effect log { write put() -> Unit }\npub fn say() -> Unit / {log.write} = log.put()",
      },
    ]),
  );
  let other = hash_index(
    indexed([
      {
        name: b"m",
        src: b"pub effect trace { write put() -> Unit }\npub fn say() -> Unit / {trace.write} = trace.put()",
      },
    ]),
  );
  // The row `say` publishes names its effect, so a hash that ignored the name would not pin the row.
  assert(by_name(named_hashes(one)).get(b"m.say") != by_name(named_hashes(other)).get(b"m.say"))
}

test "the forms of a module's parts put together hash as the module's own, whichever order the parts come in" {
  let index = indexed([
    {
      name: b"m",
      src: b"pub type T = | Leaf | Node(List<T>)\npub fn even(n: Int) -> Bool = if n == 0 { true } else { odd(n - 1) }\npub fn odd(n: Int) -> Bool = if n == 0 { false } else { even(n - 1) }\npub fn count(t: T) -> Int = match t { Leaf -> 1, Node(ts) -> ts.fold(0, |n: Int, k: T| n + count(k)) }\ntest \"it\" { assert(even(2)) }\n",
    },
  ]);
  let whole = module_forms(index, [0], 0);
  let part = |names: List<Bytes>, tests: Bool|
    kept_forms(index, [0], 0, {
      node: |n: Bytes| names.contains(n),
      test: |_: Bytes| tests,
      law: |_: Bytes| false,
    });
  let counted = part([b"m.T", b"m.count"], false);
  let evens = part([b"m.even"], true);
  let odds = part([b"m.odd"], false);
  let said = |forms: Shapes| {
    let f = hashed_forms(forms, []);
    {
      nodes: f.nodes.fold(Map::new(), |acc: Map<Bytes, Fixed>, x: Fixed|
        acc.insert(pin_key(x.name, x.decl), x)),
      tests: f.tests,
    }
  };
  assert_eq(said(whole).nodes.len(), 4);
  assert_eq(said(joined_forms([counted, evens, odds])), said(whole));
  assert_eq(said(joined_forms([odds, evens, counted])), said(whole));
  assert_eq(joined_forms([whole]), whole)
}

test "a definition's hash follows each function a call on a value may be, of the modules its own can see" {
  let said = |low: Bytes, side: Bytes|
    by_name(
      named_hashes(
        hash_index(
          indexed([
            {
              name: b"low",
              src: b"pub type A = | A\npub fn made() -> A = A\npub fn A::go(a: A) -> Int = ".concat(
                low,
              ),
            },
            { name: b"side", src: b"pub type B = | B\npub fn B::go(b: B) -> Int = ".concat(side) },
            {
              name: b"m",
              src: b"import low\npub fn f() -> Int = low::made().go()\npub fn g() -> Int = low::A::go(low::made())",
            },
          ]),
        ),
      ),
    ).get(
      b"m.f",
    );
  assert(said(b"1", b"1") != None);
  assert(said(b"1", b"1") != said(b"2", b"1"));
  // A module it does not import is none it can see.
  assert_eq(said(b"1", b"1"), said(b"1", b"2"))
}

test "a body that compares, digests or shows references what the code written for a container calls" {
  // `full` compares, so it and `List::push` reference each other: a cycle hashed as any is.
  let prelude = {
    name: prelude_module(),
    src: b"pub fn List::at<a>(xs: List<a>, i: Int) -> Option<a> = None\npub fn List::push<a>(xs: List<a>, x: a) -> List<a> = if full(1) { xs } else { xs }\nfn full(n: Int) -> Bool = n == 32\n",
  };
  let hashes = hash_index(
    indexed([
      prelude,
      { name: b"std.value", src: b"pub extern fn shown<a>(x: a) -> Bool\n" },
      {
        name: b"m",
        src: b"import std.value (shown)\npub fn same(a: Int, b: Int) -> Bool = a != b\npub fn hashed(a: Int) -> Bytes = digest(a)\npub fn told(a: Int) -> Bool = shown(a)\npub fn less(a: Int, b: Int) -> Bool = a < b\n",
      },
      {
        name: b"n",
        src: b"fn digest(a: Int) -> Bytes = b\"\"\npub fn own(a: Int) -> Bytes = digest(a)\n",
      },
    ]),
  );
  let written = [
    { name: b"std.prelude.List::at", decl: false },
    { name: b"std.prelude.List::push", decl: false },
  ];
  assert_eq([b"m.same", b"m.hashed", b"m.told"].map(|n: Bytes| named_in(hashes, TheFn(n))), [
    written,
    written,
    written,
  ]);
  assert_eq(named_in(hashes, TheFn(b"m.less")), []);
  // A definition of the builtin's name is what the name calls.
  assert_eq(named_in(hashes, TheFn(b"n.own")), [{ name: b"n.digest", decl: false }]);
  assert_eq(reached_functions(hashes, [TheFn(b"m.same")]).keys(), [
    b"m.same",
    b"std.prelude.List::at",
    b"std.prelude.List::push",
    b"std.prelude.full",
  ]);
  assert_eq(named_in(hashes, TheFn(b"std.prelude.full")), written);
  assert_eq(
    hashes.defs.filter(|d: { name: Bytes, hash: Bytes }|
      (d.name == b"std.prelude.List::push" || d.name == b"std.prelude.full")
        && d.hash.len() == 32).len(
    ),
    2,
  )
}

// Pinned, so a framing change fails here rather than silently moving the digests a warm cache
// keys on.
test "the published hashes digest to a pinned value" {
  let h = |v: Int| Bytes::concat_all(range(0, 32).map(|i: Int| byte_of_int(v)));
  let sample: HashOutput = {
    ..no_hashes(),
    defs: [{ name: b"a", hash: h(1) }],
    decls: [{ name: b"b", hash: h(2) }],
    tests: Map::new().insert(b"m.t", h(5)),
    laws: Map::new().insert(b"m.l", h(6)),
    specs: [{ name: b"a", hashes: [h(3), h(4)] }],
  };
  assert_eq(
    hex(digest(sample)),
    b"58459713bdbbf484f0cfe80dc6063329ec4260055e400360c45911707f0342ec",
  );
  // One more hash is a different digest, so a unit keyed on it is not reused.
  let grown = { ..sample, tests: sample.tests.insert(b"m.u", h(7)) };
  assert(digest(grown) != digest(sample))
}

test "a stored body is keyed by its own bytes, and bytes no envelope holds by nothing" {
  let picked = [{ callee: 3, named: [] }, { callee: 0 - 1, named: [2, 1] }];
  let found = picked.map(|c: Choice| Found(c));
  let solo = solo_body({ bytes: b"abc", refs: [], chosen: found });
  assert_eq(body_key(solo), Some(blake3(b"abc")));
  match envelope(solo) { Some(e) -> assert_eq(picks_of(solo, e), [picked]), None -> assert(false) };
  let member = member_body(
    { members: [], packed: b"xyz", picks: [[], found], classes: Map::new() },
    2,
  );
  assert_eq(body_key(member), Some(member_hash(blake3(b"xyz"), 2)));
  assert_eq(body_component(solo), Some({ id: blake3(b"abc"), members: [blake3(b"abc")] }));
  let pair = member_body(
    { members: [], packed: u32_le(2).concat(b"pair"), picks: [], classes: Map::new() },
    0,
  );
  assert_eq(
    body_component(pair),
    Some({
      id: blake3(u32_le(2).concat(b"pair")),
      members: [
        member_hash(blake3(u32_le(2).concat(b"pair")), 0),
        member_hash(blake3(u32_le(2).concat(b"pair")), 1),
      ],
    }),
  );
  match envelope(member) {
    Some(e) -> assert_eq(picks_of(member, e), [[], picked]),
    None -> assert(false),
  };
  assert_eq(body_key(b""), None);
  assert_eq(body_key(b"\x07rest"), None);
  assert_eq(body_key(b"\x01\x00"), None);
  // A call its check is yet to say of keys its body under nothing, until the check completes it.
  let site = { at: site_key(0, dummy_span()), candidates: [b"m.A::f", b"m.B::f"] };
  let open = [Found(picked.get(0)), Waiting(site)];
  let found_open = [Found(picked.get(0)), Found({ callee: 1, named: [2, 1] })];
  let said = Map::new().insert(site.at, { callee: b"m.B::f", named: [2, 1] });
  let pending = solo_body({ bytes: b"abc", refs: [], chosen: open });
  let pending_member = member_body(
    { members: [], packed: b"xyz", picks: [[], open], classes: Map::new() },
    2,
  );
  assert_eq(body_key(pending), None);
  assert_eq(body_key(pending_member), None);
  assert_eq(
    checked_body(pending, said),
    solo_body({ bytes: b"abc", refs: [], chosen: found_open }),
  );
  assert_eq(
    checked_body(pending_member, said),
    member_body({ members: [], packed: b"xyz", picks: [[], found_open], classes: Map::new() }, 2),
  );
  assert_eq(checked_body(solo, said), solo)
}

test "a call that leaves an argument to a default naming what its module keeps hashes as one that writes it" {
  let left = b"fn triple(x: Int) -> Int = x * 3\nfn inner(x: Int, f: (Int) -> Int = triple) -> Int = f(x)\nfn caller() -> Int = inner(1)";
  let written = left.replace(b"inner(1)", b"inner(1, triple)");
  assert_eq(
    dumped_hash(hash_dump([{ name: b"m", src: left }]), b"m.caller"),
    dumped_hash(hash_dump([{ name: b"m", src: written }]), b"m.caller"),
  )
}

test "a parameter written `keep` hashes apart from one that is not" {
  let lent = b"fn hold(f: (Int) -> Int) -> Int = f(1)";
  let kept = b"fn hold(f: keep (Int) -> Int) -> Int = f(1)";
  assert(
    dumped_hash(hash_dump([{ name: b"m", src: lent }]), b"m.hold")
      != dumped_hash(hash_dump([{ name: b"m", src: kept }]), b"m.hold"),
    None,
  )
}

test "a parameter that names its space hashes apart from one that does not, whatever the name" {
  let hash = |src: Bytes| dumped_hash(hash_dump([{ name: b"m", src: src }]), b"m.each");
  let plain = hash(b"fn each(f: (Int) -> Int) -> Int = f(1)");
  let named = hash(b"fn each(f: (Int) -> Int space s) -> Int = f(1)");
  assert(plain != named, None);
  assert_eq(hash(b"fn each(f: (Int) -> Int space t) -> Int = f(1)"), named)
}

test "a type's hash covers the arithmetic it states, and prints it back" {
  let stating = |stated: Bytes, sum: Bytes|
    hash_index(
      indexed([
        {
          name: b"m",
          src: Bytes::concat_all([
            b"pub type N = | N(Int)\n",
            stated,
            b"fn add(a: N, b: N) -> N = match a { N(x) -> match b { N(y) -> N(",
            sum,
            b") } }\nfn neg(a: N) -> N = a\nfn of(n: Int) -> N = N(n)\n",
            b"pub fn two() -> N = of(2)\n",
          ]),
        },
      ]),
    );
  let named = |out: HashOutput, n: Bytes| by_name(named_hashes(out)).get(n);
  let all = b"numeric for N by { add: add, sub: add, mul: add, neg: neg, of_int: of }\n";
  let stated = stating(all, b"x + y");
  // Stating it, editing a function it names and naming another all move the type and what holds it.
  assert(named(stating(b"", b"x + y"), b"m.N") != named(stated, b"m.N"));
  assert(named(stated, b"m.N") != named(stating(all, b"y + x"), b"m.N"));
  assert(named(stated, b"m.two") != named(stating(all, b"y + x"), b"m.two"));
  let other = b"numeric for N by { add: add, sub: add, mul: add, neg: neg, of_int: of, }\n";
  // The order the record lists them in moves nothing.
  let reordered = b"numeric for N by { of_int: of, neg: neg, mul: add, sub: add, add: add }\n";
  assert_eq(named(stated, b"m.N"), named(stating(reordered, b"x + y"), b"m.N"));
  assert_eq(named(stated, b"m.N"), named(stating(other, b"x + y"), b"m.N"));
  let ms = printed_of(stated, []);
  assert(
    ms.get(0).text.contains(
      b"\nnumeric for N by { add: add, sub: add, mul: add, neg: neg, of_int: of }",
    ),
  );
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(stated)))
}

test "a type's hash covers the key and the show it states, and what hold it move with them" {
  let stating = |stated: Bytes, body: Bytes|
    by_name(
      named_hashes(
        hash_index(
          indexed([
            {
              name: b"m",
              src: Bytes::concat_all([
                b"pub type Box = | Box(Int, Int)\n",
                stated,
                b"fn area(b: Box) -> Int = match b { Box(w, h) -> ",
                body,
                b" }\nfn edge(b: Box) -> Int = match b { Box(w, h) -> w + h }\n",
                b"fn text(b: Box) -> String = \"box\"\n",
                b"pub fn make() -> Box = Box(1, 2)\nfn same<a>(x: a, y: a) -> Bool = x == y\n",
              ]),
            },
          ]),
        ),
      ),
    );
  let plain = stating(b"", b"w * h");
  let keyed = stating(b"key for Box by area\n", b"w * h");
  let edited = stating(b"key for Box by area\n", b"h * w");
  let other = stating(b"key for Box by edge\n", b"w * h");
  let shown = stating(b"show for Box by text\n", b"w * h");
  let named = |m: Map<Bytes, Bytes>, n: Bytes| m.get(n);
  // Stating a key, naming another function, and editing the function all move the type.
  assert(named(plain, b"m.Box") != named(keyed, b"m.Box"));
  assert(named(keyed, b"m.Box") != named(edited, b"m.Box"));
  assert(named(keyed, b"m.Box") != named(other, b"m.Box"));
  assert(named(plain, b"m.Box") != named(shown, b"m.Box"));
  assert(named(keyed, b"m.Box") != named(shown, b"m.Box"));
  // What can hold a `Box` follows its type, and what cannot does not.
  assert(named(keyed, b"m.make") != named(edited, b"m.make"));
  assert(named(plain, b"m.make") != named(keyed, b"m.make"));
  assert_eq(named(plain, b"m.same"), named(edited, b"m.same"))
}

test "a key and a show print back after their type and hash back to what they were stored under" {
  let out = hash_index(
    indexed([
      {
        name: b"m",
        src: b"pub type Box<a> = | Box(a, Int)\nkey for Box by count\nshow for Box by text\nfn count<a>(b: Box<a>) -> Int = match b { Box(_, n) -> n }\nfn text<a>(b: Box<a>) -> String = \"box\"\npub fn make() -> Box<Int> = Box(1, 2)",
      },
    ]),
  );
  let ms = printed_of(out, []);
  assert(ms.get(0).text.contains(b"\nkey for Box by count\nshow for Box by text"));
  let again = hash_index(
    indexed(ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}
