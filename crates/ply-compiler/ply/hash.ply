// --- Bytes ------------------------------------------------------------------------------------

/// The position of `v` in `xs`, searching from the end: a binder's de Bruijn level.
fn rposition(xs: List<Bytes>, v: Bytes) -> Option<Int> / {abort.raise} =
  fold(range(0, len(xs)), None, |acc: Option<Int>, i: Int|
    if at(xs, i) == v { Some(i) } else { acc })

/// The width's position in `lexer::widths`: the discriminant the encoding writes.
fn width_index(ty: Bytes) -> Bytes / {abort.raise} = {
  let want = bytes_of_string(ascii_lower(string_of_bytes(ty)));
  byte_of_int(
    fold(range(0, len(widths())), 0, |at: Int, i: Int|
      match list_at(widths(), i) { Some(w) -> if w.name == want { i } else { at }, None -> at }),
  )
}

fn i64_le(v: Int) -> Bytes =
  bytes_concat_all(map(range(0, 8), |i: Int| byte_of_int(v >>> 8 * i & 0xFF)))

fn hex_digit(v: Int) -> Bytes / {abort.raise} =
  if v < 10 { byte_of_int(48 + v) } else { byte_of_int(87 + v) }

/// Every byte's two digits, so a byte of `hex` is one lookup.
fn hex_pairs() -> List<Bytes> / {abort.raise} =
  map(range(0, 256), |v: Int| bytes_concat(hex_digit(v >>> 4), hex_digit(v & 15)))

pub fn hex(b: Bytes) -> Bytes / {abort.raise} = {
  let pairs = hex_pairs();
  bytes_concat_all(map(range(0, bytes_len(b)), |i: Int| at(pairs, bytes_at(b, i))))
}

/// A `Decimal` mantissa has up to 96 bits, more than an `Int`, so it is accumulated a byte at a time.
fn i128_le_of_digits(digits: Bytes) -> Bytes / {abort.raise} = {
  let limbs = fold(
    range(0, bytes_len(digits)),
    map(range(0, 16), |i: Int| 0),
    |acc: List<Int>, i: Int| {
      let d = bytes_at(digits, i) - 48;
      let carried = fold(
        range(0, 16),
        { limbs: [], carry: d },
        |s: { limbs: List<Int>, carry: Int }, k: Int| {
          let v = at(acc, k) * 10 + s.carry;
          { limbs: push(s.limbs, v & 0xFF), carry: v >>> 8 }
        },
      );
      carried.limbs
    },
  );
  bytes_concat_all(map(limbs, |v: Int| byte_of_int(v)))
}

fn float_bits(text: Bytes) -> Int / {abort.raise} =
  match float_of_string(string_of_bytes(text)) {
    Some(f) -> bits_of_float(f),
    None -> panic("a float literal the hasher cannot read"),
  }

/// A `Decimal` literal's `(mantissa, scale)`: the digits without the point, and how many followed it.
fn decimal_parts(text: Bytes) -> { mantissa: Bytes, scale: Int } / {abort.raise} = {
  let body = bytes_slice(text, 0, bytes_len(text) - 1);
  let split = fold(
    range(0, bytes_len(body)),
    { digits: b"", scale: 0, after: false },
    |s: { digits: Bytes, scale: Int, after: Bool }, i: Int| {
      let c = bytes_at(body, i);
      if c == 46 { { ..s, after: true } }
      else if !is_digit(c) { s } else {
        {
          digits: bytes_concat(s.digits, byte_of_int(c)),
          scale: if s.after { s.scale + 1 } else { s.scale },
          after: s.after,
        }
      }
    },
  );
  { mantissa: i128_le_of_digits(split.digits), scale: split.scale }
}

// --- The reference graph over every top-level definition ------------------------------

pub type NodeBody = | NodeFn(FnDef) | NodeType(TypeDef) | NodeEffect(EffectDef)
pub type Node = { name: Bytes, simple: Bytes, module: Int, body: NodeBody }
pub type TestNode = { key: Bytes, module: Int, def: TestDef }
pub type LawNode = { key: Bytes, module: Int, def: LawDef }
pub type IndexEntry = | DefEntry(Int) | TestEntry(Int) | LawEntry(Int)
type Target = { owner: Int, name: Bytes }
pub type ValueTarget = | FnTarget(Int) | CtorTarget({ owner: Int, name: Bytes })
type ModuleItems = {
  fns: Map<Bytes, Int>,
  types: Map<Bytes, Int>,
  effects: Map<Bytes, Int>,
  ctors: Map<Bytes, Int>,
  // What the module states of each type it names: a type's hash covers these.
  instances: Map<Bytes, List<InstanceDef>>,
  numerics: Map<Bytes, NumericDef>,
}
type ScopeIndex = {
  values: Map<Bytes, Target>,
  types: Map<Bytes, Target>,
  effects: Map<Bytes, Target>,
  modules: Map<Bytes, Int>,
}

pub type Index = {
  mods: List<ParsedModule>,
  nodes: List<Node>,
  tests: List<TestNode>,
  laws: List<LawNode>,
  order: List<IndexEntry>,
  items: List<ModuleItems>,
  scopes: List<ScopeIndex>,
  effect_sketches: Map<Int, Bytes>,
}

fn qualifier(qname: QName) -> Option<Bytes> =
  match qname.module { Some(m) -> Some(m.name), None -> None }

/// The name `qualified` has inside the module that declares it.
fn simple_of(qualified: Bytes, owner: Bytes) -> Bytes / {abort.raise} = {
  let prefix = bytes_concat(owner, b".");
  if bytes_len(owner) > 0 && bytes_starts_with(qualified, prefix) {
    bytes_slice(qualified, bytes_len(prefix), bytes_len(qualified))
  } else { qualified }
}

type Building = {
  nodes: List<Node>,
  tests: List<TestNode>,
  laws: List<LawNode>,
  order: List<IndexEntry>,
  items: List<ModuleItems>,
  diags: List<Diag>,
}
type Declaring = { map: Map<Bytes, Int>, spans: Map<Bytes, Span>, diags: List<Diag> }

fn declare(d: Declaring, m: Int, name: Ident, id: Int, what: Bytes) -> Declaring =
  match map_get(d.spans, name.name) {
    Some(first) ->
      {
        ..d,
        diags: push(
          d.diags,
          error_at_and(
            b"E0105",
            m,
            name.span,
            bytes_concat_all([b"duplicate ", what, b" `", name.name, b"`"]),
            b"redefined here",
            m,
            first,
            b"first defined here",
            [
              bytes_concat_all([
                b"rename one of them; every ",
                what,
                b" in a module needs a distinct name",
              ]),
            ],
          ),
        ),
      },
    None ->
      {
        map: map_insert(d.map, name.name, id),
        spans: map_insert(d.spans, name.name, name.span),
        diags: d.diags,
      },
  }

fn no_declaring(diags: List<Diag>) -> Declaring = { map: map_new(), spans: map_new(), diags: diags }

pub fn build_index(
  mods: List<ParsedModule>,
  resolved: Resolved,
) -> { index: Index, diags: List<Diag> } / {abort.raise} = {
  let built = fold(
    range(0, len(mods)),
    { nodes: [], tests: [], laws: [], order: [], items: [], diags: [] },
    |b: Building, m: Int| {
      let module = at(mods, m);
      let walked = fold(
        module.module.items,
        {
          b: b,
          fns: no_declaring([]),
          types: no_declaring([]),
          effects: no_declaring([]),
          ctors: no_declaring([]),
        },
        |s: { b: Building, fns: Declaring, types: Declaring, effects: Declaring, ctors: Declaring }, item: Item| {
          let bb: Building = s.b;
          match item {
            IFn(d) -> {
              let id = len(bb.nodes);
              let pushed: Building = {
                ..bb,
                nodes: push(bb.nodes, {
                  name: qualify(module.name, d.name.name),
                  simple: d.name.name,
                  module: m,
                  body: NodeFn(d),
                }),
                order: push(bb.order, DefEntry(id)),
              };
              let fns: Declaring = declare({ ..s.fns, diags: [] }, m, d.name, id, b"definition");
              {
                ..s,
                b: { ..pushed, diags: concat(pushed.diags, fns.diags) },
                fns: { ..fns, diags: [] },
              }
            },
            IType(d) -> {
              let id = len(bb.nodes);
              let pushed: Building = {
                ..bb,
                nodes: push(bb.nodes, {
                  name: qualify(module.name, d.name.name),
                  simple: d.name.name,
                  module: m,
                  body: NodeType(d),
                }),
                order: push(bb.order, DefEntry(id)),
              };
              let types: Declaring = declare({ ..s.types, diags: [] }, m, d.name, id, b"type");
              let ctors: Declaring = match d.body {
                TDSum(variants) ->
                  fold(variants, { ..s.ctors, diags: [] }, |c: Declaring, variant: VariantDef|
                    declare(c, m, variant.name, id, b"variant")),
                _ -> { ..s.ctors, diags: [] },
              };
              {
                ..s,
                b: { ..pushed, diags: concat(concat(pushed.diags, types.diags), ctors.diags) },
                types: { ..types, diags: [] },
                ctors: { ..ctors, diags: [] },
              }
            },
            IEffect(d) -> {
              let id = len(bb.nodes);
              let pushed: Building = {
                ..bb,
                nodes: push(bb.nodes, {
                  name: qualify(module.name, d.name.name),
                  simple: d.name.name,
                  module: m,
                  body: NodeEffect(d),
                }),
                order: push(bb.order, DefEntry(id)),
              };
              let effects: Declaring = declare(
                { ..s.effects, diags: [] },
                m,
                d.name,
                id,
                b"effect",
              );
              {
                ..s,
                b: { ..pushed, diags: concat(pushed.diags, effects.diags) },
                effects: { ..effects, diags: [] },
              }
            },
            ITest(d) ->
              {
                ..s,
                b: {
                  ..bb,
                  order: push(bb.order, TestEntry(len(bb.tests))),
                  tests: push(bb.tests, { key: qualify(module.name, d.name), module: m, def: d }),
                },
              },
            ILaw(d) ->
              {
                ..s,
                b: {
                  ..bb,
                  order: push(bb.order, LawEntry(len(bb.laws))),
                  laws: push(bb.laws, { key: qualify(module.name, d.name), module: m, def: d }),
                },
              },
            _ -> s,
          }
        },
      );
      let wb: Building = walked.b;
      {
        ..wb,
        items: push(wb.items, {
          fns: walked.fns.map,
          types: walked.types.map,
          effects: walked.effects.map,
          ctors: walked.ctors.map,
          instances: instances_in(module.module.items),
          numerics: fold(
            module.module.items,
            map_new(),
            |acc: Map<Bytes, NumericDef>, item: Item|
              match item { INumeric(d) -> map_insert(acc, d.target.name, d), _ -> acc },
          ),
        }),
      }
    },
  );
  let scopes = map(range(0, len(mods)), |m: Int| {
    let scope = at(resolved.scopes, m);
    let project = |bindings: List<Binding>|
      fold(bindings, map_new(), |acc: Map<Bytes, Target>, b: Binding|
        map_insert(acc, b.name, {
          owner: b.owner,
          name: simple_of(b.qualified, at(mods, b.owner).name),
        }));
    {
      values: project(scope.bound.values),
      types: project(scope.bound.types),
      effects: project(scope.bound.effects),
      modules: fold(scope.modules, map_new(), |acc: Map<Bytes, Int>, mb: ModuleBinding|
        map_insert(acc, mb.binder, mb.target)),
    }
  });
  let index: Index = {
    mods: mods,
    nodes: built.nodes,
    tests: built.tests,
    laws: built.laws,
    order: built.order,
    items: built.items,
    scopes: scopes,
    effect_sketches: map_new(),
  };
  { index: { ..index, effect_sketches: sketch_effects(index) }, diags: built.diags }
}

/// Each type's `key` before its `show`, whatever order the module wrote them in. A `gen` is no part
/// of what its type is: it decides what a sample draws and nothing a program computes.
fn instances_in(items: List<Item>) -> Map<Bytes, List<InstanceDef>> =
  fold(items, map_new(), |acc: Map<Bytes, List<InstanceDef>>, item: Item|
    match item {
      IInstance(d) -> {
        let held = match map_get(acc, d.target.name) { Some(xs) -> xs, None -> [] };
        match d.kind {
          NKey -> map_insert(acc, d.target.name, concat([d], held)),
          NShow -> map_insert(acc, d.target.name, push(held, d)),
          NGen -> acc,
        }
      },
      _ -> acc,
    })

fn sketch_effects(index: Index) -> Map<Int, Bytes> / {abort.raise} =
  fold(range(0, len(index.nodes)), map_new(), |acc: Map<Int, Bytes>, v: Int| {
    let node = at(index.nodes, v);
    match node.body {
      NodeEffect(_) ->
        map_insert(
          acc,
          v,
          filled(
            template_of(index, node.module, |encoder: Encoder| normalize_node(encoder, node.body)),
            blank(),
          ).bytes,
        ),
      _ -> acc,
    }
  })

fn is_effect(index: Index, v: Int) -> Bool / {abort.raise} =
  match at(index.nodes, v).body { NodeEffect(_) -> true, _ -> false }

/// A qualified name consults only the named module's declarations; a bare one only the scope.
fn target(
  index: Index,
  module: Int,
  ns: Int,
  qual: Option<Bytes>,
  name: Bytes,
) -> Option<Target> / {abort.raise} = {
  let scope = at(index.scopes, module);
  match qual {
    Some(binder) -> match map_get(scope.modules, binder) {
      Some(owner) -> Some({ owner: owner, name: name }),
      None -> None,
    },
    None ->
      map_get(
        if ns == 0 { scope.values } else if ns == 1 { scope.types } else { scope.effects },
        name,
      ),
  }
}

/// `pub` is metadata a definition's own encoding erases, but a reference to one is another matter: a
/// qualified name reaches only what its module exports, so an unexported one denotes nothing, as it
/// already does for a bare name the scope never bound. Without this a reference that stopped being
/// permitted would encode as though it still were, and the caller's hash would not move.
fn exports(index: Index, qual: Option<Bytes>, node: Int) -> Bool / {abort.raise} =
  match qual {
    None -> true,
    Some(_) -> match at(index.nodes, node).body {
      NodeFn(d) -> is_pub(d.vis),
      NodeType(d) -> is_pub(d.vis),
      NodeEffect(d) -> is_pub(d.vis),
    },
  }

/// A default copied back into its own module names it, and reaches what it keeps, as the checker does.
fn exported(
  index: Index,
  qual: Option<Bytes>,
  from: Int,
  node: Option<Int>,
) -> Option<Int> / {abort.raise} =
  match node {
    None -> None,
    Some(v) -> if at(index.nodes, v).module == from || exports(index, qual, v) { Some(v) }
    else { None },
  }

fn value_target(index: Index, module: Int, qname: QName) -> Option<ValueTarget> / {abort.raise} =
  match target(index, module, 0, qualifier(qname), qname.name.name) {
    None -> None,
    Some(t) -> {
      let items = at(index.items, t.owner);
      match exported(index, qualifier(qname), module, map_get(items.fns, t.name)) {
        Some(node) -> Some(FnTarget(node)),
        // A variant is exported exactly when the type that declares it is.
        None -> match exported(index, qualifier(qname), module, map_get(items.ctors, t.name)) {
          Some(owner) -> Some(CtorTarget({ owner: owner, name: t.name })),
          None -> None,
        },
      }
    },
  }

/// The definition a tagged literal's check runs, by its program-wide name, as `module` names it.
pub fn tagged_target(index: Index, module: Int, t: Tagged) -> Option<Bytes> / {abort.raise} =
  match value_target(index, module, tagged_parser(t)) {
    Some(FnTarget(node)) -> Some(at(index.nodes, node).name),
    _ -> None,
  }

/// What a name `module` writes as a value denotes: a definition, by its program-wide name, or a
/// constructor, by its own name and its type's program-wide one.
pub type Denoted =
  | DenotesFn(Bytes)
  | DenotesCtor({ type_name: Bytes, name: Bytes })
  | DenotesNothing

pub fn denoted(index: Index, module: Int, qname: QName) -> Denoted / {abort.raise} =
  match value_target(index, module, qname) {
    Some(FnTarget(node)) -> DenotesFn(at(index.nodes, node).name),
    Some(CtorTarget(c)) -> DenotesCtor({ type_name: at(index.nodes, c.owner).name, name: c.name }),
    None -> DenotesNothing,
  }

/// The program-wide name of the effect `module` names `qname`.
pub fn effect_called(index: Index, module: Int, qname: QName) -> Option<Bytes> / {abort.raise} =
  match effect_target(index, module, qname) {
    Some(v) -> Some(at(index.nodes, v).name),
    None -> None,
  }

/// The program-wide name of the type `module` names `qname`.
pub fn type_named(index: Index, module: Int, qname: QName) -> Option<Bytes> / {abort.raise} =
  match type_target(index, module, qualifier(qname), qname.name.name) {
    Some(v) -> Some(at(index.nodes, v).name),
    None -> None,
  }

fn ctor_target(index: Index, module: Int, qname: QName) -> Option<ValueTarget> / {abort.raise} =
  match target(index, module, 0, qualifier(qname), qname.name.name) {
    None -> None,
    Some(t) -> match exported(
        index,
        qualifier(qname),
        module,
        map_get(at(index.items, t.owner).ctors, t.name),
      ) {
      Some(owner) -> Some(CtorTarget({ owner: owner, name: t.name })),
      None -> None,
    },
  }

fn type_target(
  index: Index,
  module: Int,
  qual: Option<Bytes>,
  name: Bytes,
) -> Option<Int> / {abort.raise} =
  match target(index, module, 1, qual, name) {
    None -> None,
    Some(t) -> exported(index, qual, module, map_get(at(index.items, t.owner).types, t.name)),
  }

fn effect_target(index: Index, module: Int, qname: QName) -> Option<Int> / {abort.raise} =
  match target(index, module, 2, qualifier(qname), qname.name.name) {
    None -> None,
    Some(t) ->
      exported(index, qualifier(qname), module, map_get(at(index.items, t.owner).effects, t.name)),
  }

fn is_cyclic(component: List<Int>, edges: List<List<Int>>) -> Bool / {abort.raise} =
  if len(component) != 1 { true } else {
    let only = at(component, 0);
    contains(at(edges, only), only)
  }

