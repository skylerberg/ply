// --- Bytes ------------------------------------------------------------------------------------

fn at<a>(xs: List<a>, i: Int) -> a / {abort.raise} =
  match list_at(xs, i) { Some(x) -> x, None -> panic("an index the hasher does not hold") }

fn append<a>(a: List<a>, b: List<a>) -> List<a> = fold(b, a, |acc: List<a>, x: a| push(acc, x))

fn contains_int(xs: List<Int>, v: Int) -> Bool = fold(xs, false, |acc: Bool, x: Int| acc || x == v)

fn contains_bytes(xs: List<Bytes>, v: Bytes) -> Bool =
  fold(xs, false, |acc: Bool, x: Bytes| acc || x == v)

// The position of `v` in `xs`, searching from the end: a binder's de Bruijn level.
fn rposition(xs: List<Bytes>, v: Bytes) -> Option<Int> / {abort.raise} =
  fold(range(0, len(xs)), None, |acc: Option<Int>, i: Int|
    if at(xs, i) == v { Some(i) } else { acc })

fn u32_le(v: Int) -> Bytes / {abort.raise} =
  bytes_concat_all([
    byte_of(v & 0xFF),
    byte_of(v >>> 8 & 0xFF),
    byte_of(v >>> 16 & 0xFF),
    byte_of(v >>> 24 & 0xFF),
  ])

// The width's position in `lexer::widths`: the discriminant the encoding writes.
fn width_index(ty: Bytes) -> Bytes / {abort.raise} = {
  let want = bytes_of_string(string_lower(string_of_bytes(ty)));
  byte_of(
    fold(range(0, len(widths())), 0, |at: Int, i: Int|
      match list_at(widths(), i) { Some(w) -> if w.name == want { i } else { at }, None -> at }),
  )
}

fn i64_le(v: Int) -> Bytes / {abort.raise} =
  bytes_concat_all(map(range(0, 8), |i: Int| byte_of(v >>> 8 * i & 0xFF)))

fn hex_digit(v: Int) -> Bytes / {abort.raise} =
  if v < 10 { byte_of(48 + v) } else { byte_of(87 + v) }

// Every byte's two digits, so a byte of `hex` is one lookup.
fn hex_pairs() -> List<Bytes> / {abort.raise} =
  map(range(0, 256), |v: Int| bytes_concat(hex_digit(v >>> 4), hex_digit(v & 15)))

pub fn hex(b: Bytes) -> Bytes / {abort.raise} = {
  let pairs = hex_pairs();
  bytes_concat_all(map(range(0, bytes_len(b)), |i: Int| at(pairs, bytes_at(b, i))))
}

// A `Decimal` mantissa has up to 96 bits, more than an `Int`, so it is accumulated a byte at a time.
fn i128_le_of_digits(digits: Bytes) -> Bytes / {abort.raise} = {
  let limbs = fold(
    range(0, bytes_len(digits)),
    map(range(0, 16), |i: Int| 0),
    |acc: List<Int>, i: Int| {
      let d = bytes_at(digits, i) - 48;
      let carried = fold(
        range(0, 16),
        { limbs: [], carry: d },
        |s: { limbs: List<Int>, carry: Int }, k: Int| {
          let v = at(acc, k) * 10 + s.carry;
          { limbs: push(s.limbs, v & 0xFF), carry: v >>> 8 }
        },
      );
      carried.limbs
    },
  );
  bytes_concat_all(map(limbs, |v: Int| byte_of(v)))
}

fn is_digit_byte(c: Int) -> Bool = c >= 48 && c <= 57

fn float_bits(text: Bytes) -> Int / {abort.raise} =
  match float_of_string(string_of_bytes(text)) {
    Some(f) -> bits_of_float(f),
    None -> panic("a float literal the hasher cannot read"),
  }

// A `Decimal` literal's `(mantissa, scale)`: the digits without the point, and how many followed it.
fn decimal_parts(text: Bytes) -> { mantissa: Bytes, scale: Int } / {abort.raise} = {
  let body = bytes_slice(text, 0, bytes_len(text) - 1);
  let split = fold(
    range(0, bytes_len(body)),
    { digits: b"", scale: 0, after: false },
    |s: { digits: Bytes, scale: Int, after: Bool }, i: Int| {
      let c = bytes_at(body, i);
      if c == 46 { { ..s, after: true } }
      else if !is_digit_byte(c) { s } else {
        {
          digits: bytes_concat(s.digits, byte_of(c)),
          scale: if s.after { s.scale + 1 } else { s.scale },
          after: s.after,
        }
      }
    },
  );
  { mantissa: i128_le_of_digits(split.digits), scale: split.scale }
}

// --- The reference graph over every top-level definition ------------------------------

pub type NodeBody = | NodeFn(FnDef) | NodeType(TypeDef) | NodeEffect(EffectDef)
pub type Node = { name: Bytes, simple: Bytes, module: Int, body: NodeBody }
pub type TestNode = { key: Bytes, module: Int, def: TestDef }
pub type LawNode = { key: Bytes, module: Int, def: LawDef }
pub type IndexEntry = | DefEntry(Int) | TestEntry(Int) | LawEntry(Int)
type Target = { owner: Int, name: Bytes }
pub type ValueTarget = | FnTarget(Int) | CtorTarget({ owner: Int, name: Bytes })
type ModuleItems = {
  fns: Map<Bytes, Int>,
  types: Map<Bytes, Int>,
  effects: Map<Bytes, Int>,
  ctors: Map<Bytes, Int>,
}
type ScopeIndex = {
  values: Map<Bytes, Target>,
  types: Map<Bytes, Target>,
  effects: Map<Bytes, Target>,
  modules: Map<Bytes, Int>,
}

pub type Index = {
  mods: List<ParsedModule>,
  nodes: List<Node>,
  tests: List<TestNode>,
  laws: List<LawNode>,
  order: List<IndexEntry>,
  items: List<ModuleItems>,
  scopes: List<ScopeIndex>,
  effect_sketches: Map<Int, Bytes>,
}

fn qualifier(qname: QName) -> Option<Bytes> =
  match qname.module { Some(m) -> Some(m.name), None -> None }

// The name `qualified` has inside the module that declares it.
fn simple_of(qualified: Bytes, owner: Bytes) -> Bytes / {abort.raise} = {
  let prefix = bytes_concat(owner, b".");
  if bytes_len(owner) > 0 && bytes_starts_with(qualified, prefix) {
    bytes_slice(qualified, bytes_len(prefix), bytes_len(qualified))
  } else { qualified }
}

type Building = {
  nodes: List<Node>,
  tests: List<TestNode>,
  laws: List<LawNode>,
  order: List<IndexEntry>,
  items: List<ModuleItems>,
  diags: List<Diag>,
}
type Declaring = { map: Map<Bytes, Int>, spans: Map<Bytes, Span>, diags: List<Diag> }

fn declare(d: Declaring, m: Int, name: Ident, id: Int, what: Bytes) -> Declaring =
  match map_get(d.spans, name.name) {
    Some(first) ->
      {
        ..d,
        diags: push(
          d.diags,
          error_at_and(
            b"E0105",
            m,
            name.span,
            bytes_concat_all([b"duplicate ", what, b" `", name.name, b"`"]),
            b"redefined here",
            m,
            first,
            b"first defined here",
            [
              bytes_concat_all([
                b"rename one of them; every ",
                what,
                b" in a module needs a distinct name",
              ]),
            ],
          ),
        ),
      },
    None ->
      {
        map: map_insert(d.map, name.name, id),
        spans: map_insert(d.spans, name.name, name.span),
        diags: d.diags,
      },
  }

fn no_declaring(diags: List<Diag>) -> Declaring = { map: map_new(), spans: map_new(), diags: diags }

pub fn build_index(
  mods: List<ParsedModule>,
  resolved: Resolved,
) -> { index: Index, diags: List<Diag> } / {abort.raise} = {
  let built = fold(
    range(0, len(mods)),
    { nodes: [], tests: [], laws: [], order: [], items: [], diags: [] },
    |b: Building, m: Int| {
      let module = at(mods, m);
      let walked = fold(
        module.module.items,
        {
          b: b,
          fns: no_declaring([]),
          types: no_declaring([]),
          effects: no_declaring([]),
          ctors: no_declaring([]),
        },
        |s: { b: Building, fns: Declaring, types: Declaring, effects: Declaring, ctors: Declaring }, item: Item| {
          let bb: Building = s.b;
          match item {
            IFn(d) -> {
              let id = len(bb.nodes);
              let pushed: Building = {
                ..bb,
                nodes: push(bb.nodes, {
                  name: qualify(module.name, d.name.name),
                  simple: d.name.name,
                  module: m,
                  body: NodeFn(d),
                }),
                order: push(bb.order, DefEntry(id)),
              };
              let fns: Declaring = declare({ ..s.fns, diags: [] }, m, d.name, id, b"definition");
              {
                ..s,
                b: { ..pushed, diags: append(pushed.diags, fns.diags) },
                fns: { ..fns, diags: [] },
              }
            },
            IType(d) -> {
              let id = len(bb.nodes);
              let pushed: Building = {
                ..bb,
                nodes: push(bb.nodes, {
                  name: qualify(module.name, d.name.name),
                  simple: d.name.name,
                  module: m,
                  body: NodeType(d),
                }),
                order: push(bb.order, DefEntry(id)),
              };
              let types: Declaring = declare({ ..s.types, diags: [] }, m, d.name, id, b"type");
              let ctors: Declaring = match d.body {
                TDSum(variants) ->
                  fold(variants, { ..s.ctors, diags: [] }, |c: Declaring, variant: VariantDef|
                    declare(c, m, variant.name, id, b"variant")),
                _ -> { ..s.ctors, diags: [] },
              };
              {
                ..s,
                b: { ..pushed, diags: append(append(pushed.diags, types.diags), ctors.diags) },
                types: { ..types, diags: [] },
                ctors: { ..ctors, diags: [] },
              }
            },
            IEffect(d) -> {
              let id = len(bb.nodes);
              let pushed: Building = {
                ..bb,
                nodes: push(bb.nodes, {
                  name: qualify(module.name, d.name.name),
                  simple: d.name.name,
                  module: m,
                  body: NodeEffect(d),
                }),
                order: push(bb.order, DefEntry(id)),
              };
              let effects: Declaring = declare(
                { ..s.effects, diags: [] },
                m,
                d.name,
                id,
                b"effect",
              );
              {
                ..s,
                b: { ..pushed, diags: append(pushed.diags, effects.diags) },
                effects: { ..effects, diags: [] },
              }
            },
            ITest(d) ->
              {
                ..s,
                b: {
                  ..bb,
                  order: push(bb.order, TestEntry(len(bb.tests))),
                  tests: push(bb.tests, { key: qualify(module.name, d.name), module: m, def: d }),
                },
              },
            ILaw(d) ->
              {
                ..s,
                b: {
                  ..bb,
                  order: push(bb.order, LawEntry(len(bb.laws))),
                  laws: push(bb.laws, { key: qualify(module.name, d.name), module: m, def: d }),
                },
              },
            _ -> s,
          }
        },
      );
      let wb: Building = walked.b;
      {
        ..wb,
        items: push(wb.items, {
          fns: walked.fns.map,
          types: walked.types.map,
          effects: walked.effects.map,
          ctors: walked.ctors.map,
        }),
      }
    },
  );
  let scopes = map(range(0, len(mods)), |m: Int| {
    let scope = at(resolved.scopes, m);
    let project = |bindings: List<Binding>|
      fold(bindings, map_new(), |acc: Map<Bytes, Target>, b: Binding|
        map_insert(acc, b.name, {
          owner: b.owner,
          name: simple_of(b.qualified, at(mods, b.owner).name),
        }));
    {
      values: project(scope.bound.values),
      types: project(scope.bound.types),
      effects: project(scope.bound.effects),
      modules: fold(scope.modules, map_new(), |acc: Map<Bytes, Int>, mb: ModuleBinding|
        map_insert(acc, mb.binder, mb.target)),
    }
  });
  let index: Index = {
    mods: mods,
    nodes: built.nodes,
    tests: built.tests,
    laws: built.laws,
    order: built.order,
    items: built.items,
    scopes: scopes,
    effect_sketches: map_new(),
  };
  { index: { ..index, effect_sketches: sketch_effects(index) }, diags: built.diags }
}

fn sketch_effects(index: Index) -> Map<Int, Bytes> / {abort.raise} =
  fold(range(0, len(index.nodes)), map_new(), |acc: Map<Int, Bytes>, v: Int| {
    let node = at(index.nodes, v);
    match node.body {
      NodeEffect(_) ->
        map_insert(
          acc,
          v,
          finish(
            normalize_node(
              new_encoder(index, node.module, map_new(), map_new(), map_new()),
              node.body,
            ),
          ).bytes,
        ),
      _ -> acc,
    }
  })

fn is_effect(index: Index, v: Int) -> Bool / {abort.raise} =
  match at(index.nodes, v).body { NodeEffect(_) -> true, _ -> false }

// A qualified name consults only the named module's declarations; a bare one only the scope.
fn target(
  index: Index,
  module: Int,
  ns: Int,
  qual: Option<Bytes>,
  name: Bytes,
) -> Option<Target> / {abort.raise} = {
  let scope = at(index.scopes, module);
  match qual {
    Some(binder) -> match map_get(scope.modules, binder) {
      Some(owner) -> Some({ owner: owner, name: name }),
      None -> None,
    },
    None ->
      map_get(
        if ns == 0 { scope.values } else if ns == 1 { scope.types } else { scope.effects },
        name,
      ),
  }
}

// `pub` is metadata a definition's own encoding erases, but a reference to one is another matter: a
// qualified name reaches only what its module exports, so an unexported one denotes nothing, as it
// already does for a bare name the scope never bound. Without this a reference that stopped being
// permitted would encode as though it still were, and the caller's hash would not move.
fn exports(index: Index, qual: Option<Bytes>, node: Int) -> Bool / {abort.raise} =
  match qual {
    None -> true,
    Some(_) -> match at(index.nodes, node).body {
      NodeFn(d) -> is_pub(d.vis),
      NodeType(d) -> is_pub(d.vis),
      NodeEffect(d) -> is_pub(d.vis),
    },
  }

// A default copied back into its own module names it, and reaches what it keeps, as the checker does.
fn exported(
  index: Index,
  qual: Option<Bytes>,
  from: Int,
  node: Option<Int>,
) -> Option<Int> / {abort.raise} =
  match node {
    None -> None,
    Some(v) -> if at(index.nodes, v).module == from || exports(index, qual, v) { Some(v) }
    else { None },
  }

fn value_target(index: Index, module: Int, qname: QName) -> Option<ValueTarget> / {abort.raise} =
  match target(index, module, 0, qualifier(qname), qname.name.name) {
    None -> None,
    Some(t) -> {
      let items = at(index.items, t.owner);
      match exported(index, qualifier(qname), module, map_get(items.fns, t.name)) {
        Some(node) -> Some(FnTarget(node)),
        // A variant is exported exactly when the type that declares it is.
        None -> match exported(index, qualifier(qname), module, map_get(items.ctors, t.name)) {
          Some(owner) -> Some(CtorTarget({ owner: owner, name: t.name })),
          None -> None,
        },
      }
    },
  }

fn ctor_target(index: Index, module: Int, qname: QName) -> Option<ValueTarget> / {abort.raise} =
  match target(index, module, 0, qualifier(qname), qname.name.name) {
    None -> None,
    Some(t) -> match exported(
        index,
        qualifier(qname),
        module,
        map_get(at(index.items, t.owner).ctors, t.name),
      ) {
      Some(owner) -> Some(CtorTarget({ owner: owner, name: t.name })),
      None -> None,
    },
  }

fn type_target(
  index: Index,
  module: Int,
  qual: Option<Bytes>,
  name: Bytes,
) -> Option<Int> / {abort.raise} =
  match target(index, module, 1, qual, name) {
    None -> None,
    Some(t) -> exported(index, qual, module, map_get(at(index.items, t.owner).types, t.name)),
  }

fn effect_target(index: Index, module: Int, qname: QName) -> Option<Int> / {abort.raise} =
  match target(index, module, 2, qualifier(qname), qname.name.name) {
    None -> None,
    Some(t) ->
      exported(index, qualifier(qname), module, map_get(at(index.items, t.owner).effects, t.name)),
  }

// Tarjan's components, iterative: completion order, each component's members as they left the stack.
type Tarjan = {
  index: List<Int>,
  low: List<Int>,
  on_stack: List<Bool>,
  stack: List<Int>,
  call: List<{ v: Int, edge: Int }>,
  out: List<List<Int>>,
  next: Int,
}

pub fn tarjan(n: Int, edges: List<List<Int>>) -> List<List<Int>> / {abort.raise} = {
  let unvisited = 0 - 1;
  let start = {
    index: map(range(0, n), |i: Int| unvisited),
    low: map(range(0, n), |i: Int| 0),
    on_stack: map(range(0, n), |i: Int| false),
    stack: [],
    call: [],
    out: [],
    next: 0,
  };
  let total = fold(edges, 0, |acc: Int, es: List<Int>| acc + len(es));
  let done = fold(range(0, n), start, |t: Tarjan, root: Int|
    if at(t.index, root) != unvisited { t } else {
      let opened: Tarjan = {
        ..t,
        index: set_at(t.index, root, t.next),
        low: set_at(t.low, root, t.next),
        next: t.next + 1,
        stack: push(t.stack, root),
        on_stack: set_at(t.on_stack, root, true),
        call: [{ v: root, edge: 0 }],
      };
      iterate(opened, 2 * (n + total) + 4, |x: Tarjan|
        if len(x.call) == 0 { Stop(x) } else { Continue(tarjan_step(n, edges, x)) })
    });
  done.out
}

fn set_at<a>(xs: List<a>, i: Int, v: a) -> List<a> / {abort.raise} = list_set(xs, i, v)

fn tarjan_step(n: Int, edges: List<List<Int>>, t: Tarjan) -> Tarjan / {abort.raise} = {
  let top = at(t.call, len(t.call) - 1);
  let rest = take(t.call, len(t.call) - 1);
  let out = at(edges, top.v);
  if top.edge < len(out) {
    let again = push(rest, { v: top.v, edge: top.edge + 1 });
    let w = at(out, top.edge);
    if w >= n { { ..t, call: again } } else if at(t.index, w) == 0 - 1 {
      {
        ..t,
        index: set_at(t.index, w, t.next),
        low: set_at(t.low, w, t.next),
        next: t.next + 1,
        stack: push(t.stack, w),
        on_stack: set_at(t.on_stack, w, true),
        call: push(again, { v: w, edge: 0 }),
      }
    } else if at(t.on_stack, w) {
      { ..t, low: set_at(t.low, top.v, min(at(t.low, top.v), at(t.index, w))), call: again }
    } else { { ..t, call: again } }
  } else {
    let lowered: Tarjan = if len(rest) > 0 {
      let parent = at(rest, len(rest) - 1).v;
      { ..t, low: set_at(t.low, parent, min(at(t.low, parent), at(t.low, top.v))) }
    } else { t };
    let popped: Tarjan = if at(lowered.low, top.v) == at(lowered.index, top.v) {
      let split = iterate(
        { stack: lowered.stack, on: lowered.on_stack, comp: [] },
        len(lowered.stack) + 1,
        |s: { stack: List<Int>, on: List<Bool>, comp: List<Int> }| {
          let w = at(s.stack, len(s.stack) - 1);
          let next = {
            stack: take(s.stack, len(s.stack) - 1),
            on: set_at(s.on, w, false),
            comp: push(s.comp, w),
          };
          if w == top.v { Stop(next) } else { Continue(next) }
        },
      );
      { ..lowered, stack: split.stack, on_stack: split.on, out: push(lowered.out, split.comp) }
    } else { lowered };
    { ..popped, call: rest }
  }
}

fn take<a>(xs: List<a>, n: Int) -> List<a> / {abort.raise} = map(range(0, n), |i: Int| at(xs, i))

fn is_cyclic(component: List<Int>, edges: List<List<Int>>) -> Bool / {abort.raise} =
  if len(component) != 1 { true } else {
    let only = at(component, 0);
    contains_int(at(edges, only), only)
  }

// --- The byte encoding ----------------------------------------------------------------

fn tag_local() -> Int = 1
fn tag_ref_hash() -> Int = 2
fn tag_ref_self() -> Int = 3
fn tag_ref_index() -> Int = 4
fn tag_free() -> Int = 5
fn tag_ctor() -> Int = 6
fn tag_ty_param() -> Int = 7
fn tag_row_param() -> Int = 8
fn tag_free_qualified() -> Int = 9
fn tag_none() -> Int = 10
fn tag_some() -> Int = 11
fn tag_ref_name() -> Int = 12
fn tag_param_default() -> Int = 13
fn tag_fn() -> Int = 20
fn tag_type_alias() -> Int = 21
fn tag_type_sum() -> Int = 22
fn tag_effect() -> Int = 23
fn tag_test() -> Int = 24
fn tag_variant() -> Int = 25
fn tag_op() -> Int = 26
fn tag_type() -> Int = 27
fn tag_law() -> Int = 28
fn tag_spec() -> Int = 29
fn tag_ty_con() -> Int = 30
fn tag_ty_fn() -> Int = 31
fn tag_ty_record() -> Int = 32
fn tag_ty_unit() -> Int = 33
fn tag_lit_int() -> Int = 40
fn tag_lit_bool() -> Int = 41
fn tag_lit_str() -> Int = 42
fn tag_lit_unit() -> Int = 43
fn tag_lit_bytes() -> Int = 44
fn tag_lit_float() -> Int = 45
fn tag_lit_decimal() -> Int = 46
fn tag_lit_char() -> Int = 47
// A tag of its own: `5` and `5u32` are different definitions. Tags never renumber, or stored hashes move.
fn tag_lit_fixed() -> Int = 96
fn tag_lit_wide() -> Int = 99
fn tag_e_lit() -> Int = 50
fn tag_e_var() -> Int = 51
fn tag_e_binary() -> Int = 52
fn tag_e_unary() -> Int = 53
fn tag_e_lambda() -> Int = 54
fn tag_e_app() -> Int = 55
fn tag_e_if() -> Int = 56
fn tag_e_match() -> Int = 57
fn tag_e_block() -> Int = 58
fn tag_e_record() -> Int = 59
fn tag_e_field() -> Int = 60
fn tag_e_list() -> Int = 61
fn tag_e_perform() -> Int = 62
fn tag_e_handle() -> Int = 63
fn tag_e_with_cell() -> Int = 64
fn tag_e_simulate() -> Int = 65
fn tag_e_parallel() -> Int = 100
fn tag_e_record_update() -> Int = 67
fn tag_s_let() -> Int = 70
fn tag_s_expr() -> Int = 71
fn tag_s_let_else() -> Int = 72
fn tag_p_wildcard() -> Int = 80
fn tag_p_var() -> Int = 81
fn tag_p_lit() -> Int = 82
fn tag_p_ctor() -> Int = 83
fn tag_p_record() -> Int = 84
fn tag_p_list() -> Int = 85
fn tag_p_or() -> Int = 86
fn tag_row() -> Int = 90
fn tag_atom() -> Int = 91
fn tag_atom_op() -> Int = 97
fn tag_label_param() -> Int = 98
fn tag_arm() -> Int = 92
fn tag_clause() -> Int = 93
fn tag_return_clause() -> Int = 94
fn tag_constraint() -> Int = 95
fn tag_returns_fresh() -> Int = 101
fn tag_returns_param() -> Int = 102
fn tag_bounded() -> Int = 103
fn tag_decreases() -> Int = 104

// An explicit table: renumbering a row invalidates every cached result in every store.
fn binop_byte(op: Bytes) -> Int =
  if op == b"add" { 1 }
  else if op == b"sub" { 2 }
  else if op == b"mul" { 3 }
  else if op == b"div" { 4 }
  else if op == b"rem" { 5 }
  else if op == b"eq" { 6 }
  else if op == b"ne" { 7 }
  else if op == b"lt" { 8 }
  else if op == b"le" { 9 }
  else if op == b"gt" { 10 }
  else if op == b"ge" { 11 }
  else if op == b"and" { 12 }
  else if op == b"or" { 13 }
  else if op == b"concat" { 14 }
  else if op == b"bitand" { 15 }
  else if op == b"bitor" { 16 }
  else if op == b"bitxor" { 17 }
  else if op == b"shl" { 18 }
  else if op == b"shr" { 19 }
  else { 20 }

fn unop_byte(op: Bytes) -> Int = if op == b"neg" { 1 } else if op == b"not" { 2 } else { 3 }

fn mode_byte(mode: Mode) -> Int = match mode { MRead -> 0, MWrite -> 1, MBad -> 0 }

fn spec_tag(k: SpecKind) -> Int = match k { SRequires -> 1, SEnsures -> 2 }

fn deriver_byte(deriver: Deriver) -> Int = deriver_tag(deriver) + 1

// `out` is chunks concatenated once at the end; `refs` is first-mention order; the binder lists are de Bruijn levels.
type Encoder = {
  index: Index,
  module: Int,
  hashes: Map<Int, Bytes>,
  component: Map<Int, Int>,
  effects: Map<Int, Int>,
  out: List<Bytes>,
  refs: List<Int>,
  seen: Map<Int, Bool>,
  values: List<Bytes>,
  ty_params: List<Bytes>,
  row_params: List<Bytes>,
  label_params: List<Bytes>,
  by_name: Bool,
  deferred: Option<List<Int>>,
}

type Finished = { bytes: Bytes, refs: List<Int> }

fn new_encoder(
  index: Index,
  module: Int,
  hashes: Map<Int, Bytes>,
  component: Map<Int, Int>,
  effects: Map<Int, Int>,
) -> Encoder =
  {
    index: index,
    module: module,
    hashes: hashes,
    component: component,
    effects: effects,
    out: [],
    refs: [],
    seen: map_new(),
    values: [],
    ty_params: [],
    row_params: [],
    label_params: [],
    by_name: false,
    deferred: None,
  }

fn finish(encoder: Encoder) -> Finished =
  { bytes: bytes_concat_all(encoder.out), refs: encoder.refs }

fn put_bytes(encoder: Encoder, b: Bytes) -> Encoder = { ..encoder, out: push(encoder.out, b) }
fn put_tag(encoder: Encoder, t: Int) -> Encoder / {abort.raise} = put_bytes(encoder, byte_of(t))
fn put_u32(encoder: Encoder, v: Int) -> Encoder / {abort.raise} = put_bytes(encoder, u32_le(v))
fn put_bool(encoder: Encoder, b: Bool) -> Encoder / {abort.raise} =
  put_bytes(encoder, byte_of(if b { 1 } else { 0 }))
fn put_text(encoder: Encoder, s: Bytes) -> Encoder / {abort.raise} =
  put_bytes(put_u32(encoder, bytes_len(s)), s)

type Captured = { encoder: Encoder, bytes: Bytes }

// The bytes `f` writes, kept apart from the encoding so far.
fn capture<| e>(encoder: Encoder, f: (Encoder) -> Encoder / e) -> Captured / e = {
  let inner: Encoder = f({ ..encoder, out: [] });
  { encoder: { ..inner, out: encoder.out }, bytes: bytes_concat_all(inner.out) }
}

fn normalize_node(encoder: Encoder, body: NodeBody) -> Encoder / {abort.raise} =
  match body {
    NodeFn(d) -> fn_def(encoder, d),
    NodeType(d) -> type_def(encoder, d),
    NodeEffect(d) -> effect_def(encoder, d),
  }

// A reference in first-mention order, unless a row is holding its mentions back.
fn mention(encoder: Encoder, node: Int) -> Encoder =
  match encoder.deferred {
    Some(held) -> { ..encoder, deferred: Some(push(held, node)) },
    None -> if map_contains(encoder.seen, node) { encoder } else {
      { ..encoder, seen: map_insert(encoder.seen, node, true), refs: push(encoder.refs, node) }
    },
  }

fn node_ref(encoder: Encoder, node: Int) -> Encoder / {abort.raise} = {
  let m: Encoder = mention(encoder, node);
  if m.by_name { put_text(put_tag(m, tag_ref_name()), at(m.index.nodes, node).name) } else {
    match map_get(m.component, node) {
      Some(ix) -> put_u32(put_tag(m, tag_ref_index()), ix),
      None -> match map_get(m.hashes, node) {
        Some(h) -> put_bytes(put_tag(m, tag_ref_hash()), h),
        None -> put_tag(m, tag_ref_self()),
      },
    }
  }
}

fn free_ref(encoder: Encoder, qual: Option<Bytes>, name: Bytes) -> Encoder / {abort.raise} =
  match qual {
    None -> put_text(put_tag(encoder, tag_free()), name),
    Some(m) -> put_text(put_text(put_tag(encoder, tag_free_qualified()), m), name),
  }

fn ctor_bytes(encoder: Encoder, owner: Int, name: Bytes) -> Encoder / {abort.raise} =
  put_text(node_ref(put_tag(encoder, tag_ctor()), owner), name)

// A local binder wins over everything, and only a bare name can be one.
fn value_ref(encoder: Encoder, qname: QName) -> Encoder / {abort.raise} = {
  let local = if is_bare(qname) { rposition(encoder.values, qname.name.name) } else { None };
  match local {
    Some(level) -> put_u32(put_tag(encoder, tag_local()), level),
    None -> match value_target(encoder.index, encoder.module, qname) {
      Some(t) -> match t {
        FnTarget(node) -> node_ref(encoder, node),
        CtorTarget(c) -> ctor_bytes(encoder, c.owner, c.name),
      },
      None -> free_ref(encoder, qualifier(qname), qname.name.name),
    },
  }
}

fn type_ref(encoder: Encoder, qual: Option<Bytes>, name: Bytes) -> Encoder / {abort.raise} = {
  let param = match qual { None -> rposition(encoder.ty_params, name), Some(_) -> None };
  match param {
    Some(level) -> put_u32(put_tag(encoder, tag_ty_param()), level),
    None -> match type_target(encoder.index, encoder.module, qual, name) {
      Some(node) -> node_ref(encoder, node),
      None -> free_ref(encoder, qual, name),
    },
  }
}

// Effects are nominal: the declaration referenced, then the slot the component's enumeration gave
// it. What makes that true is the simple name in the declaration's own encoding; its module path is
// not, so two modules declaring one effect alike declare one effect.
fn effect_ref(encoder: Encoder, qname: QName) -> Encoder / {abort.raise} =
  match effect_target(encoder.index, encoder.module, qname) {
    Some(node) ->
      put_u32(node_ref(encoder, node), match map_get(encoder.effects, node) {
        Some(s) -> s,
        None -> 0,
      }),
    None -> free_ref(encoder, qualifier(qname), qname.name.name),
  }

fn ctor_ref(encoder: Encoder, qname: QName) -> Encoder / {abort.raise} =
  match ctor_target(encoder.index, encoder.module, qname) {
    Some(CtorTarget(c)) -> ctor_bytes(encoder, c.owner, c.name),
    _ -> free_ref(encoder, qualifier(qname), qname.name.name),
  }

// A resource the signature binds is a level, so renaming the binder is not an edit; a real one stays a name.
fn label_ref(encoder: Encoder, ident: Ident) -> Encoder / {abort.raise} =
  match rposition(encoder.label_params, ident.name) {
    Some(level) -> put_u32(put_tag(encoder, tag_label_param()), level),
    None -> put_text(put_tag(encoder, tag_free()), ident.name),
  }

fn opt_type(encoder: Encoder, ty: Option<TypeExpr>) -> Encoder / {abort.raise} =
  match ty {
    None -> put_tag(encoder, tag_none()),
    Some(te) -> type_expr(put_tag(encoder, tag_some()), te),
  }
fn opt_row(encoder: Encoder, r: Option<RowExpr>) -> Encoder / {abort.raise} =
  match r {
    None -> put_tag(encoder, tag_none()),
    Some(row) -> row_expr(put_tag(encoder, tag_some()), row),
  }
fn opt_expr(encoder: Encoder, e: Option<Expr>) -> Encoder / {abort.raise} =
  match e { None -> put_tag(encoder, tag_none()), Some(x) -> expr(put_tag(encoder, tag_some()), x) }
// A `[*]` clause is not the clause that names no label, so the wildcard is spelled out rather
// than shared with the empty case. A `[*t]` clause is not a `[*]` one either: naming the label is
// what the body reads, so the binder is part of what the clause is.
fn clause_label(clause: HandleClause) -> Option<Ident> =
  match clause.label_binder {
    Some(t) -> Some({ name: bytes_concat(b"*", t.name), span: clause.span }),
    None -> if clause.every_label { Some({ name: b"*", span: clause.span }) }
    else { clause.resource },
  }

fn opt_label(encoder: Encoder, i: Option<Ident>) -> Encoder / {abort.raise} =
  match i {
    None -> put_tag(encoder, tag_none()),
    Some(x) -> label_ref(put_tag(encoder, tag_some()), x),
  }

fn push_generics(encoder: Encoder, def: FnDef) -> Encoder =
  {
    ..encoder,
    ty_params: append(encoder.ty_params, map(def.generics.types, |ident: Ident| ident.name)),
    row_params: append(encoder.row_params, map(def.generics.effects, |ident: Ident| ident.name)),
    label_params: append(encoder.label_params, map(def.generics.labels, |ident: Ident| ident.name)),
  }

fn fn_def(encoder: Encoder, def: FnDef) -> Encoder / {abort.raise} = {
  let generic: Encoder = push_generics(
    put_u32(
      put_u32(
        put_u32(put_tag(encoder, tag_fn()), len(def.generics.types)),
        len(def.generics.effects),
      ),
      len(def.generics.labels),
    ),
    def,
  );
  // Before the parameter names reach `values`: a default is closed.
  let with_params: Encoder = fold(
    def.params,
    put_u32(generic, len(def.params)),
    |acc: Encoder, param: Param|
      match param.default {
        Some(dflt) -> expr(opt_type(put_tag(acc, tag_param_default()), param.ty), dflt),
        None -> opt_type(acc, param.ty),
      },
  );
  let signature: Encoder = returns(
    constraints(opt_row(opt_type(with_params, def.ret), def.effects), def.constraints),
    def,
  );
  let bound: Encoder = {
    ..signature,
    values: append(signature.values, map(def.params, |param: Param| param.name.name)),
  };
  // A stated measure decides the definition's verdict, so it is part of what was written.
  let measured: Encoder = match def.decreases {
    Some(m) -> expr(put_tag(bound, tag_decreases()), m),
    None -> bound,
  };
  expr(measured, def.body)
}

// A `returns` clause names a parameter by its position, so renaming one moves nothing.
fn returns(encoder: Encoder, def: FnDef) -> Encoder / {abort.raise} =
  match def.returns {
    None -> encoder,
    Some(ReturnsFresh(_)) -> put_tag(encoder, tag_returns_fresh()),
    Some(ReturnsParam(x)) ->
      put_u32(
        put_tag(encoder, tag_returns_param()),
        fold(range(0, len(def.params)), 0, |acc: Int, i: Int|
          if at(def.params, i).name.name == x.name { i } else { acc }),
      ),
  }

// Sorted and deduplicated: the same two constraints in the other order are one definition.
fn constraints(encoder: Encoder, cs: List<Constraint>) -> Encoder / {abort.raise} = {
  let levels = fold(cs, [], |acc: List<{ level: Int, deriver: Int }>, c: Constraint|
    match rposition(encoder.ty_params, c.param.name) {
      Some(level) -> push(acc, { level: level, deriver: deriver_byte(c.deriver) }),
      None -> acc,
    });
  let sorted = fold(
    levels,
    [],
    |acc: List<{ level: Int, deriver: Int }>, x: { level: Int, deriver: Int }| insert_pair(acc, x),
  );
  fold(sorted, put_u32(encoder, len(sorted)), |acc: Encoder, x: { level: Int, deriver: Int }|
    put_tag(put_u32(put_tag(acc, tag_constraint()), x.level), x.deriver))
}

fn insert_pair(
  sorted: List<{ level: Int, deriver: Int }>,
  x: { level: Int, deriver: Int },
) -> List<{ level: Int, deriver: Int }> / {abort.raise} = {
  let dup = fold(sorted, false, |b: Bool, y: { level: Int, deriver: Int }|
    b || (y.level == x.level && y.deriver == x.deriver));
  if dup { sorted } else {
    let n = len(sorted);
    let i = fold(range(0, n), n, |acc: Int, j: Int|
      if acc < n { acc } else {
        let y = at(sorted, j);
        if x.level < y.level || (x.level == y.level && x.deriver < y.deriver) { j } else { acc }
      });
    append(push(take(sorted, i), x), map(range(i, n), |j: Int| at(sorted, j)))
  }
}

// A sum is nominal and an alias is transparent, exactly as the checker has them: `conv_type` gives
// a sum a `TyCon` under its name, which `unify_structural` compares by name, and expands an alias
// in place, so two aliases of one expansion are one type there and must be one type here. The name
// is the simple one: a module path is no part of an identity, so vendoring a module moves nothing.
fn type_def(encoder: Encoder, d: TypeDef) -> Encoder / {abort.raise} = {
  let tagged: Encoder = put_tag(encoder, tag_type());
  let bound: Encoder = {
    ..tagged,
    ty_params: append(tagged.ty_params, map(d.params, |ident: Ident| ident.name)),
  };
  let counted: Encoder = put_u32(bound, len(d.params));
  match d.body {
    TDAlias(t) -> type_expr(put_tag(counted, tag_type_alias()), t),
    TDSum(variants) ->
      fold(
        variants,
        put_u32(put_text(put_tag(counted, tag_type_sum()), d.name.name), len(variants)),
        |acc: Encoder, variant: VariantDef|
          fold(
            variant.fields,
            put_u32(put_text(put_tag(acc, tag_variant()), variant.name.name), len(variant.fields)),
            |a: Encoder, ty: TypeExpr| type_expr(a, ty),
          ),
      ),
  }
}

// Operations are looked up by name, so their declaration order is sorted away.
// An effect is nominal: it is the declaration this name declares, not a shape another declaration
// could match. Two effects differing only in their names are two effects, so the name is encoded —
// a published row names its atoms' effects, and nothing else would make a hash pin those names.
// The name is the simple one: a module path is no part of an identity here, so the same declaration
// vendored under another path is still that declaration.
fn effect_def(encoder: Encoder, d: EffectDef) -> Encoder / {abort.raise} = {
  let header: Encoder = put_bool(
    put_text(put_tag(encoder, tag_effect()), d.name.name),
    d.is_nondet,
  );
  let ops = fold(
    d.ops,
    { encoder: header, encoded: [] },
    |acc: { encoder: Encoder, encoded: List<Bytes> }, op: OpDef| {
      let captured: Captured = capture(acc.encoder, |x: Encoder| op_def(x, op));
      { encoder: captured.encoder, encoded: push(acc.encoded, captured.bytes) }
    },
  );
  let sorted = sort_bytes(ops.encoded);
  fold(sorted, put_u32(ops.encoder, len(sorted)), |acc: Encoder, b: Bytes| put_bytes(acc, b))
}

fn bytes_lt(a: Bytes, b: Bytes) -> Bool = match compare_values(a, b) { Less -> true, _ -> false }

pub fn sort_bytes(xs: List<Bytes>) -> List<Bytes> / {abort.raise} =
  fold(xs, [], |acc: List<Bytes>, x: Bytes| {
    let n = len(acc);
    let i = fold(range(0, n), n, |p: Int, j: Int|
      if p < n { p } else if bytes_lt(x, at(acc, j)) { j } else { p });
    append(push(take(acc, i), x), map(range(i, n), |j: Int| at(acc, j)))
  })

// An effect's operations share one encoder, so each one's type parameters go out of scope after it.
fn op_def(encoder: Encoder, op: OpDef) -> Encoder / {abort.raise} = {
  let header: Encoder = put_u32(
    put_bool(
      put_bytes(put_text(put_tag(encoder, tag_op()), op.name.name), byte_of(mode_byte(op.mode))),
      op.resource_param,
    ),
    len(op.ty_params),
  );
  let bound: Encoder = {
    ..header,
    ty_params: append(header.ty_params, map(op.ty_params, |p: Ident| p.name)),
  };
  let encoded: Encoder = type_expr(
    fold(op.params, put_u32(bound, len(op.params)), |acc: Encoder, p: TypeExpr| type_expr(acc, p)),
    op.ret,
  );
  { ..encoded, ty_params: encoder.ty_params }
}

pub fn test_def(encoder: Encoder, d: TestDef) -> Encoder / {abort.raise} =
  expr(put_bool(put_tag(encoder, tag_test()), d.is_nondet), d.body)

// A law's binder types are part of its identity; their names are levels like any other binder.
pub fn law_def(encoder: Encoder, d: LawDef) -> Encoder / {abort.raise} = {
  let typed: Encoder = fold(
    d.binders,
    put_u32(put_bool(put_tag(encoder, tag_law()), d.host), len(d.binders)),
    |acc: Encoder, binder: Binder| type_expr(acc, binder.ty),
  );
  let bound: Encoder = {
    ..typed,
    values: append(typed.values, map(d.binders, |binder: Binder| binder.name.name)),
  };
  expr(opt_expr(bound, d.guard), d.body)
}

// In its owner's scope: generics, parameters, and `result` for an `ensures`. Parameter defaults are not written.
pub fn spec_clause(encoder: Encoder, owner: FnDef, clause: SpecClause) -> Encoder / {abort.raise} = {
  let generic: Encoder = push_generics(
    put_u32(
      put_u32(
        put_u32(
          put_bytes(put_tag(encoder, tag_spec()), byte_of(spec_tag(clause.kind))),
          len(owner.generics.types),
        ),
        len(owner.generics.effects),
      ),
      len(owner.generics.labels),
    ),
    owner,
  );
  let counted: Encoder = put_u32(generic, len(owner.params));
  let bound: Encoder = {
    ..counted,
    values: append(counted.values, map(owner.params, |param: Param| param.name.name)),
  };
  let in_scope: Encoder = match clause.kind {
    SEnsures -> { ..bound, values: push(bound.values, b"result") },
    SRequires -> bound,
  };
  expr(in_scope, clause.expr)
}

fn type_expr(encoder: Encoder, t: TypeExpr) -> Encoder / {abort.raise} =
  match t {
    TVar(name) -> put_u32(type_ref(put_tag(encoder, tag_ty_con()), None, name.name), 0),
    TCon(c) ->
      fold(
        c.args,
        put_u32(
          type_ref(put_tag(encoder, tag_ty_con()), qualifier(c.name), c.name.name.name),
          len(c.args),
        ),
        |acc: Encoder, a: TypeExpr| type_expr(acc, a),
      ),
    TFn(f) ->
      opt_row(
        type_expr(
          fold(
            f.params,
            put_u32(put_tag(encoder, tag_ty_fn()), len(f.params)),
            |acc: Encoder, p: TypeExpr| type_expr(acc, p),
          ),
          f.ret,
        ),
        f.effects,
      ),
    // A record type is a map from label to type, so field order is sorted away.
    TRecord(r) -> {
      let fields = fold(
        r.fields,
        { encoder: put_tag(encoder, tag_ty_record()), encoded: [] },
        |acc: { encoder: Encoder, encoded: List<Bytes> }, f: { name: Ident, ty: TypeExpr }| {
          let captured: Captured = capture(acc.encoder, |x: Encoder|
            type_expr(put_text(x, f.name.name), f.ty));
          { encoder: captured.encoder, encoded: push(acc.encoded, captured.bytes) }
        },
      );
      let sorted = sort_bytes(fields.encoded);
      fold(sorted, put_u32(fields.encoder, len(sorted)), |acc: Encoder, b: Bytes| put_bytes(acc, b))
    },
    TUnit(_) -> put_tag(encoder, tag_ty_unit()),
    TBad(_) -> put_tag(encoder, tag_ty_unit()),
  }

type AtomEncoding = { bytes: Bytes, tie: Bytes, held: List<Int> }

// A row is a set: atoms sorted by encoding, then by the effect's declaration, and deduplicated.
// Every atom is mentioned, including one the dedup drops.
fn row_expr(encoder: Encoder, row: RowExpr) -> Encoder / {abort.raise} = {
  let tagged: Encoder = put_tag(encoder, tag_row());
  let atoms = fold(
    row.atoms,
    { encoder: tagged, encoded: [] },
    |acc: { encoder: Encoder, encoded: List<AtomEncoding> }, a: AtomExpr| {
      let outer = acc.encoder.deferred;
      let captured: Captured = capture({ ..acc.encoder, deferred: Some([]) }, |x: Encoder|
        atom(x, a));
      let held = match captured.encoder.deferred { Some(h) -> h, None -> [] };
      let tie = match effect_target(acc.encoder.index, acc.encoder.module, a.eff) {
        Some(node) -> match map_get(acc.encoder.index.effect_sketches, node) {
          Some(s) -> s,
          None -> b"",
        },
        None -> b"",
      };
      {
        encoder: { ..captured.encoder, deferred: outer },
        encoded: push(acc.encoded, { bytes: captured.bytes, tie: tie, held: held }),
      }
    },
  );
  let sorted = fold(atoms.encoded, [], |acc: List<AtomEncoding>, x: AtomEncoding|
    insert_atom(acc, x));
  let distinct = fold(range(0, len(sorted)), 0, |acc: Int, i: Int|
    if i == 0 || at(sorted, i - 1).bytes != at(sorted, i).bytes { acc + 1 } else { acc });
  let written = fold(
    range(0, len(sorted)),
    put_u32(atoms.encoder, distinct),
    |acc: Encoder, i: Int| {
      let x = at(sorted, i);
      let mentioned: Encoder = fold(x.held, acc, |a: Encoder, node: Int| mention(a, node));
      if i > 0 && at(sorted, i - 1).bytes == x.bytes { mentioned }
      else { put_bytes(mentioned, x.bytes) }
    },
  );
  let tailed: Encoder = match row.tail {
    None -> put_tag(written, tag_none()),
    Some(t) -> match rposition(written.row_params, t.name) {
      Some(level) -> put_u32(put_tag(put_tag(written, tag_some()), tag_row_param()), level),
      None -> put_text(put_tag(put_tag(written, tag_some()), tag_free()), t.name),
    },
  };
  if row.tail_bounded { put_tag(tailed, tag_bounded()) } else { tailed }
}

fn atom_lt(a: AtomEncoding, b: AtomEncoding) -> Bool =
  bytes_lt(a.bytes, b.bytes) || (a.bytes == b.bytes && bytes_lt(a.tie, b.tie))

fn insert_atom(sorted: List<AtomEncoding>, x: AtomEncoding) -> List<AtomEncoding> / {abort.raise} = {
  let n = len(sorted);
  let i = fold(range(0, n), n, |p: Int, j: Int|
    if p < n { p } else if atom_lt(x, at(sorted, j)) { j } else { p });
  append(push(take(sorted, i), x), map(range(i, n), |j: Int| at(sorted, j)))
}

fn atom(encoder: Encoder, a: AtomExpr) -> Encoder / {abort.raise} = {
  let named: Encoder = match a.op {
    None ->
      opt_label(
        put_bytes(effect_ref(put_tag(encoder, tag_atom()), a.eff), byte_of(mode_byte(a.mode))),
        atom_label(a),
      ),
    Some(op) ->
      opt_label(
        put_text(effect_ref(put_tag(encoder, tag_atom_op()), a.eff), op.name),
        atom_label(a),
      ),
  };
  if a.bounded { put_tag(named, tag_bounded()) } else { named }
}

// `[*]` is not the absence of a label, so the wildcard is spelled out and hashes apart from it.
fn atom_label(atom: AtomExpr) -> Option<Ident> =
  if atom.every { Some({ name: b"*", span: atom.span }) } else { atom.resource }

fn expr(encoder: Encoder, e: Expr) -> Encoder / {abort.raise} =
  match e {
    // `{ e }` and `e` are the same computation.
    EBlock(b) -> if len(b.stmts) == 0 {
      match b.tail { Some(t) -> expr(encoder, t), None -> block(encoder, b.stmts, b.tail) }
    } else { block(encoder, b.stmts, b.tail) },
    ELit(l) -> lit(put_tag(encoder, tag_e_lit()), l.lit),
    EVar(v) -> value_ref(put_tag(encoder, tag_e_var()), v.name),
    EBinary(b) ->
      expr(
        expr(put_bytes(put_tag(encoder, tag_e_binary()), byte_of(binop_byte(b.op))), b.lhs),
        b.rhs,
      ),
    EUnary(u) ->
      expr(put_bytes(put_tag(encoder, tag_e_unary()), byte_of(unop_byte(u.op))), u.operand),
    ELambda(l) -> {
      let typed: Encoder = fold(
        l.params,
        put_u32(put_tag(encoder, tag_e_lambda()), len(l.params)),
        |acc: Encoder, p: Param| opt_type(acc, p.ty),
      );
      let inner: Encoder = expr(
        { ..typed, values: append(typed.values, map(l.params, |p: Param| p.name.name)) },
        l.body,
      );
      { ..inner, values: typed.values }
    },
    EApp(a) -> {
      let called: Encoder = fold(
        a.args,
        put_u32(expr(put_tag(encoder, tag_e_app()), a.func), len(a.args)),
        |acc: Encoder, x: Expr| expr(acc, x),
      );
      fold(a.labels, put_u32(called, len(a.labels)), label_ref)
    },
    EIf(i) -> expr(expr(expr(put_tag(encoder, tag_e_if()), i.cond), i.then_branch), i.else_branch),
    EMatch(m) ->
      fold(
        m.arms,
        put_u32(expr(put_tag(encoder, tag_e_match()), m.scrutinee), len(m.arms)),
        |acc: Encoder, arm: MatchArm| {
          let inner: Encoder = expr(
            opt_expr(pattern(put_tag(acc, tag_arm()), arm.pat), arm.guard),
            arm.body,
          );
          { ..inner, values: acc.values }
        },
      ),
    ERecord(r) ->
      fold(
        r.fields,
        put_u32(put_tag(encoder, tag_e_record()), len(r.fields)),
        |acc: Encoder, f: RecField| expr(put_text(acc, f.name.name), f.value),
      ),
    // The update is the definition, not the literal it expands to: its meaning follows the base's type.
    ERecordUpdate(r) ->
      fold(
        r.fields,
        put_u32(expr(put_tag(encoder, tag_e_record_update()), r.base), len(r.fields)),
        |acc: Encoder, f: RecField| expr(put_text(acc, f.name.name), f.value),
      ),
    ETry(_) -> panic("`e?` is expanded away before hashing"),
    EField(f) -> put_text(expr(put_tag(encoder, tag_e_field()), f.base), f.field.name),
    EList(l) ->
      fold(
        l.items,
        put_u32(put_tag(encoder, tag_e_list()), len(l.items)),
        |acc: Encoder, x: Expr| expr(acc, x),
      ),
    EPerform(p) ->
      fold(
        p.args,
        put_u32(
          opt_label(
            put_text(effect_ref(put_tag(encoder, tag_e_perform()), p.eff), p.op.name),
            p.resource,
          ),
          len(p.args),
        ),
        |acc: Encoder, x: Expr| expr(acc, x),
      ),
    EHandle(h) -> {
      let clauses: Encoder = fold(
        h.clauses,
        put_u32(expr(put_tag(encoder, tag_e_handle()), h.body), len(h.clauses)),
        |acc: Encoder, c: HandleClause| {
          let head: Encoder = put_u32(
            opt_label(
              put_text(effect_ref(put_tag(acc, tag_clause()), c.eff), c.op.name),
              clause_label(c),
            ),
            len(c.params),
          );
          let bound: Encoder = {
            ..head,
            values: append(head.values, map(c.params, |p: Ident| p.name)),
          };
          // Whether a clause binds a continuation is part of what the definition is.
          let resumed: Encoder = match c.resume {
            None -> put_tag(bound, tag_none()),
            Some(k) -> {
              let some: Encoder = put_tag(bound, tag_some());
              { ..some, values: push(some.values, k.name) }
            },
          };
          let inner: Encoder = expr(resumed, c.body);
          { ..inner, values: acc.values }
        },
      );
      match h.ret {
        None -> put_tag(clauses, tag_none()),
        Some(rc) -> {
          let head: Encoder = put_tag(put_tag(clauses, tag_some()), tag_return_clause());
          let inner: Encoder = expr({ ..head, values: push(head.values, rc.binder.name) }, rc.body);
          { ..inner, values: clauses.values }
        },
      }
    },
    EWithCell(c) -> {
      let head: Encoder = expr(
        put_text(put_tag(encoder, tag_e_with_cell()), c.resource.name),
        c.init,
      );
      let inner: Encoder = expr({ ..head, values: push(head.values, c.binder.name) }, c.body);
      { ..inner, values: head.values }
    },
    ESimulate(s) -> expr(put_tag(encoder, tag_e_simulate()), s.body),
    EParallel(v) ->
      fold(
        v.branches,
        put_u32(put_tag(encoder, tag_e_parallel()), len(v.branches)),
        |acc: Encoder, x: Expr| expr(acc, x),
      ),
    EBad(_) -> panic("a placeholder reached the hasher"),
  }

fn block(encoder: Encoder, stmts: List<Stmt>, tail: Option<Expr>) -> Encoder / {abort.raise} = {
  let head: Encoder = put_u32(put_tag(encoder, tag_e_block()), len(stmts));
  let ordered: { encoder: Encoder, order: List<Int> } = stmt_order(head, stmts);
  let walked: Encoder = fold(ordered.order, ordered.encoder, |acc: Encoder, i: Int|
    stmt(acc, at(stmts, i)));
  let tailed: Encoder = opt_expr(walked, tail);
  { ..tailed, values: head.values }
}

// Consecutive `let`s that commute are emitted in the order their own encodings sort in.
fn stmt_order(
  encoder: Encoder,
  stmts: List<Stmt>,
) -> { encoder: Encoder, order: List<Int> } / {abort.raise} = {
  let n = len(stmts);
  let walked = iterate(
    { encoder: encoder, i: 0, order: [] },
    n + 2,
    |s: { encoder: Encoder, i: Int, order: List<Int> }|
      if s.i >= n { Stop(s) } else {
        let run = commutable_run(stmts, s.i);
        if run < 2 { Continue({ ..s, i: s.i + 1, order: push(s.order, s.i) }) } else {
          let sorted: { encoder: Encoder, order: List<Int> } = sorted_run(
            s.encoder,
            stmts,
            s.i,
            s.i + run,
          );
          Continue({ encoder: sorted.encoder, i: s.i + run, order: append(s.order, sorted.order) })
        }
      },
  );
  { encoder: walked.encoder, order: walked.order }
}

// The members of the run, ordered by their encodings; ties keep their source order.
fn sorted_run(
  encoder: Encoder,
  stmts: List<Stmt>,
  from: Int,
  to: Int,
) -> { encoder: Encoder, order: List<Int> } / {abort.raise} = {
  let keyed = fold(
    range(from, to),
    { encoder: encoder, keys: [] },
    |acc: { encoder: Encoder, keys: List<{ key: Bytes, i: Int }> }, i: Int| {
      let captured: Captured = capture(acc.encoder, |x: Encoder| stmt(x, at(stmts, i)));
      {
        encoder: { ..captured.encoder, values: acc.encoder.values },
        keys: push(acc.keys, { key: captured.bytes, i: i }),
      }
    },
  );
  let sorted = fold(
    keyed.keys,
    [],
    |acc: List<{ key: Bytes, i: Int }>, x: { key: Bytes, i: Int }| {
      let n = len(acc);
      let i = fold(range(0, n), n, |p: Int, j: Int|
        if p < n { p } else {
          let y = at(acc, j);
          if bytes_lt(x.key, y.key) || (x.key == y.key && x.i < y.i) { j } else { p }
        });
      append(push(take(acc, i), x), map(range(i, n), |j: Int| at(acc, j)))
    },
  );
  { encoder: keyed.encoder, order: map(sorted, |x: { key: Bytes, i: Int }| x.i) }
}

fn stmt(encoder: Encoder, s: Stmt) -> Encoder / {abort.raise} =
  match s {
    SLet(l) -> pattern(expr(opt_type(put_tag(encoder, tag_s_let()), l.ty), l.value), l.pat),
    SLetElse(l) ->
      expr(
        pattern(expr(opt_type(put_tag(encoder, tag_s_let_else()), l.ty), l.value), l.pat),
        l.fallback,
      ),
    SExpr(e) -> expr(put_tag(encoder, tag_s_expr()), e),
  }

fn lit(encoder: Encoder, literal: Lit) -> Encoder / {abort.raise} =
  match literal {
    LInt(i) -> put_bytes(put_tag(encoder, tag_lit_int()), i64_le(i)),
    LFixed(ty, v) ->
      put_bytes(put_bytes(put_tag(encoder, tag_lit_fixed()), width_index(ty)), i64_le(v)),
    LWide(ty, high, low) ->
      put_bytes(
        put_bytes(put_bytes(put_tag(encoder, tag_lit_wide()), width_index(ty)), i64_le(high)),
        i64_le(low),
      ),
    LBool(b) -> put_bool(put_tag(encoder, tag_lit_bool()), b),
    LStr(s) -> put_text(put_tag(encoder, tag_lit_str()), s),
    LBytes(b) -> put_bytes(put_u32(put_tag(encoder, tag_lit_bytes()), bytes_len(b)), b),
    LFloat(text) -> put_bytes(put_tag(encoder, tag_lit_float()), i64_le(float_bits(text))),
    LDec(text) -> {
      let p = decimal_parts(text);
      put_bytes(put_bytes(put_tag(encoder, tag_lit_decimal()), p.mantissa), u32_le(p.scale))
    },
    LChar(v) -> put_bytes(put_tag(encoder, tag_lit_char()), u32_le(v)),
    LUnit -> put_tag(encoder, tag_lit_unit()),
    LBad -> panic("a placeholder literal reached the hasher"),
  }

fn pattern(encoder: Encoder, p: Pattern) -> Encoder / {abort.raise} =
  match p {
    PWild(_) -> put_tag(encoder, tag_p_wildcard()),
    PVar(v) -> {
      let t: Encoder = put_tag(encoder, tag_p_var());
      { ..t, values: push(t.values, v.name.name) }
    },
    PLit(l) -> lit(put_tag(encoder, tag_p_lit()), l.lit),
    PCtor(c) ->
      fold(
        c.args,
        put_u32(ctor_ref(put_tag(encoder, tag_p_ctor()), c.name), len(c.args)),
        |acc: Encoder, a: Pattern| pattern(acc, a),
      ),
    PRecord(r) ->
      put_bool(
        fold(
          r.fields,
          put_u32(put_tag(encoder, tag_p_record()), len(r.fields)),
          |acc: Encoder, f: { name: Ident, pat: Pattern }|
            pattern(put_text(acc, f.name.name), f.pat),
        ),
        r.rest,
      ),
    PList(l) -> {
      let items: Encoder = fold(
        l.items,
        put_u32(put_tag(encoder, tag_p_list()), len(l.items)),
        |acc: Encoder, i: Pattern| pattern(acc, i),
      );
      match l.rest {
        None -> put_tag(items, tag_none()),
        Some(rest) -> pattern(put_tag(items, tag_some()), rest),
      }
    },
    POr(o) ->
      fold(
        o.alts,
        put_u32(put_tag(encoder, tag_p_or()), len(o.alts)),
        |acc: Encoder, a: Pattern| pattern(acc, a),
      ),
    PBad(_) -> panic("a placeholder pattern reached the hasher"),
  }

fn commutable_run(stmts: List<Stmt>, from: Int) -> Int / {abort.raise} = {
  let n = len(stmts);
  let to = iterate(from, n - from + 1, |i: Int|
    if i >= n { Stop(i) } else {
      match at(stmts, i) {
        SLet(l) -> if is_pure(l.value) { Continue(i + 1) } else { Stop(i) },
        _ -> Stop(i),
      }
    });
  if to - from < 2 { 0 } else {
    let run = map(range(from, to), |i: Int| at(stmts, i));
    let counted = fold(
      run,
      { count: 0, bound: [] },
      |acc: { count: Int, bound: List<Bytes> }, stmt: Stmt|
        match stmt {
          SLet(l) -> {
            let b = pattern_binders(l.pat, acc.bound);
            { count: acc.count + b.count, bound: b.bound }
          },
          _ -> acc,
        },
    );
    if counted.count != len(counted.bound) { 0 }
    else if fold(run, false, |b: Bool, stmt: Stmt|
        b || (match stmt { SLet(l) -> mentions(l.value, counted.bound), _ -> false })) { 0 }
    else { to - from }
  }
}

fn insert_name(xs: List<Bytes>, v: Bytes) -> List<Bytes> =
  if contains_bytes(xs, v) { xs } else { push(xs, v) }

fn pattern_binders(p: Pattern, out: List<Bytes>) -> { count: Int, bound: List<Bytes> } =
  match p {
    PVar(v) -> { count: 1, bound: insert_name(out, v.name.name) },
    PWild(_) -> { count: 0, bound: out },
    PLit(_) -> { count: 0, bound: out },
    PBad(_) -> { count: 0, bound: out },
    PCtor(c) ->
      fold(
        c.args,
        { count: 0, bound: out },
        |acc: { count: Int, bound: List<Bytes> }, a: Pattern| {
          let b = pattern_binders(a, acc.bound);
          { count: acc.count + b.count, bound: b.bound }
        },
      ),
    PRecord(r) ->
      fold(
        r.fields,
        { count: 0, bound: out },
        |acc: { count: Int, bound: List<Bytes> }, f: { name: Ident, pat: Pattern }| {
          let b = pattern_binders(f.pat, acc.bound);
          { count: acc.count + b.count, bound: b.bound }
        },
      ),
    PList(l) -> {
      let items = fold(
        l.items,
        { count: 0, bound: out },
        |acc: { count: Int, bound: List<Bytes> }, i: Pattern| {
          let b = pattern_binders(i, acc.bound);
          { count: acc.count + b.count, bound: b.bound }
        },
      );
      match l.rest {
        Some(rest) -> {
          let b = pattern_binders(rest, items.bound);
          { count: items.count + b.count, bound: b.bound }
        },
        None -> items,
      }
    },
    // Every alternative binds the same names, which the checker holds them to.
    POr(o) -> match list_at(o.alts, 0) {
      Some(a) -> pattern_binders(a, out),
      None -> { count: 0, bound: out },
    },
  }

pub fn is_pure(e: Expr) -> Bool =
  match e {
    EApp(_) -> false,
    EPerform(_) -> false,
    EHandle(_) -> false,
    EWithCell(_) -> false,
    ESimulate(_) -> false,
    EParallel(v) -> fold(v.branches, true, |acc: Bool, x: Expr| acc && is_pure(x)),
    ETry(_) -> false,
    EBad(_) -> false,
    ELit(_) -> true,
    EVar(_) -> true,
    EBinary(b) -> is_pure(b.lhs) && is_pure(b.rhs),
    EUnary(u) -> is_pure(u.operand),
    ELambda(l) -> is_pure(l.body),
    EIf(i) -> is_pure(i.cond) && is_pure(i.then_branch) && is_pure(i.else_branch),
    EMatch(m) ->
      is_pure(m.scrutinee)
        && fold(m.arms, true, |acc: Bool, arm: MatchArm|
          acc && is_pure(arm.body) && (match arm.guard { Some(g) -> is_pure(g), None -> true })),
    EBlock(b) ->
      fold(b.stmts, true, |acc: Bool, stmt: Stmt|
          acc
            && (match stmt {
              SLet(l) -> is_pure(l.value),
              SLetElse(l) -> is_pure(l.value) && is_pure(l.fallback),
              SExpr(x) -> is_pure(x),
            }))
        && (match b.tail { Some(t) -> is_pure(t), None -> true }),
    ERecord(r) -> fold(r.fields, true, |acc: Bool, f: RecField| acc && is_pure(f.value)),
    ERecordUpdate(r) ->
      is_pure(r.base) && fold(r.fields, true, |acc: Bool, f: RecField| acc && is_pure(f.value)),
    EField(f) -> is_pure(f.base),
    EList(l) -> fold(l.items, true, |acc: Bool, x: Expr| acc && is_pure(x)),
  }

// Deliberately blind to scope: any occurrence of the name counts.
fn mentions(e: Expr, names: List<Bytes>) -> Bool =
  match e {
    ELit(_) -> false,
    EBad(_) -> false,
    EVar(v) -> is_bare(v.name) && contains_bytes(names, v.name.name.name),
    EBinary(b) -> mentions(b.lhs, names) || mentions(b.rhs, names),
    EUnary(u) -> mentions(u.operand, names),
    ELambda(l) ->
      fold(l.params, false, |acc: Bool, p: Param| acc || contains_bytes(names, p.name.name))
        || mentions(l.body, names),
    EApp(a) ->
      mentions(a.func, names)
        || fold(a.args, false, |acc: Bool, x: Expr| acc || mentions(x, names)),
    EIf(i) ->
      mentions(i.cond, names) || mentions(i.then_branch, names) || mentions(i.else_branch, names),
    EMatch(m) ->
      mentions(m.scrutinee, names)
        || fold(m.arms, false, |acc: Bool, a: MatchArm|
          acc || pattern_mentions(a.pat, names)
            || (match a.guard { Some(g) -> mentions(g, names), None -> false })
            || mentions(a.body, names)),
    EBlock(b) ->
      fold(b.stmts, false, |acc: Bool, s: Stmt|
          acc
            || (match s {
              SLet(l) -> pattern_mentions(l.pat, names) || mentions(l.value, names),
              SLetElse(l) ->
                pattern_mentions(l.pat, names) || mentions(l.value, names)
                  || mentions(l.fallback, names),
              SExpr(x) -> mentions(x, names),
            }))
        || (match b.tail { Some(t) -> mentions(t, names), None -> false }),
    ERecord(r) -> fold(r.fields, false, |acc: Bool, f: RecField| acc || mentions(f.value, names)),
    ERecordUpdate(r) ->
      mentions(r.base, names)
        || fold(r.fields, false, |acc: Bool, f: RecField| acc || mentions(f.value, names)),
    EField(f) -> mentions(f.base, names),
    ETry(t) -> mentions(t.operand, names),
    EList(l) -> fold(l.items, false, |acc: Bool, x: Expr| acc || mentions(x, names)),
    EPerform(p) -> fold(p.args, false, |acc: Bool, x: Expr| acc || mentions(x, names)),
    EHandle(h) ->
      mentions(h.body, names)
        || fold(h.clauses, false, |acc: Bool, c: HandleClause|
          acc || fold(c.params, false, |b: Bool, p: Ident| b || contains_bytes(names, p.name))
            || mentions(c.body, names))
        || (match h.ret {
          Some(rc) -> contains_bytes(names, rc.binder.name) || mentions(rc.body, names),
          None -> false,
        }),
    EWithCell(c) ->
      contains_bytes(names, c.binder.name) || mentions(c.init, names) || mentions(c.body, names),
    ESimulate(s) -> mentions(s.body, names),
    EParallel(v) -> fold(v.branches, false, |acc: Bool, x: Expr| acc || mentions(x, names)),
  }

fn pattern_mentions(p: Pattern, names: List<Bytes>) -> Bool =
  match p {
    PWild(_) -> false,
    PLit(_) -> false,
    PBad(_) -> false,
    PVar(v) -> contains_bytes(names, v.name.name),
    PCtor(c) ->
      (is_bare(c.name) && contains_bytes(names, c.name.name.name))
        || fold(c.args, false, |acc: Bool, a: Pattern| acc || pattern_mentions(a, names)),
    PRecord(r) ->
      fold(r.fields, false, |acc: Bool, f: { name: Ident, pat: Pattern }|
        acc || pattern_mentions(f.pat, names)),
    PList(l) ->
      fold(l.items, false, |acc: Bool, i: Pattern| acc || pattern_mentions(i, names))
        || (match l.rest { Some(rest) -> pattern_mentions(rest, names), None -> false }),
    POr(o) -> fold(o.alts, false, |acc: Bool, a: Pattern| acc || pattern_mentions(a, names)),
  }

// --- The hash table ----------------------------------------------------------------------

fn spec_domain() -> Bytes = b"ply.spec.1"
fn spec_text_domain() -> Bytes = b"ply.spec.text.1"
fn own_domain() -> Bytes = b"ply.own.1"

fn spec_text_hash(kind: Int, index: Int, normalized: Bytes) -> Bytes / {abort.raise} =
  blake3(bytes_concat_all([spec_text_domain(), byte_of(kind), u32_le(index), normalized]))

fn own_hash(normalized: Bytes) -> Bytes = blake3(bytes_concat(own_domain(), normalized))

pub fn spec_hash(owner: Bytes, kind: Int, index: Int, normalized: Bytes) -> Bytes / {abort.raise} =
  blake3(bytes_concat_all([spec_domain(), owner, byte_of(kind), u32_le(index), normalized]))

fn member_hash(component: Bytes, class: Int) -> Bytes / {abort.raise} =
  blake3(bytes_concat(component, u32_le(class)))

// The one hash a stored body may be filed under, taken from its own bytes; `None` for bytes no
// envelope holds.
pub fn body_key(body: Bytes) -> Option<Bytes> / {abort.raise} =
  if bytes_len(body) == 0 { None }
  else if bytes_at(body, 0) == 0 { Some(blake3(bytes_slice(body, 1, bytes_len(body)))) }
  else if bytes_at(body, 0) == 1 {
    match u32_at(body, 1) {
      Some(class) -> Some(member_hash(blake3(bytes_slice(body, 5, bytes_len(body))), class)),
      None -> None,
    }
  } else { None }

// `bodies` and `test_bodies`: each definition's and test's stored body, the bytes its hash is taken over.
pub type HashOutput = {
  defs: List<{ name: Bytes, hash: Bytes }>,
  own: List<{ name: Bytes, hash: Bytes }>,
  decls: List<{ name: Bytes, hash: Bytes }>,
  tests: List<Bytes>,
  laws: List<Bytes>,
  specs: List<{ name: Bytes, hashes: List<Bytes> }>,
  spec_texts: List<{ name: Bytes, hashes: List<Bytes> }>,
  law_texts: List<Bytes>,
  deps: List<{ name: Bytes, names: List<Bytes> }>,
  refs: Refs,
  bodies: List<{ name: Bytes, body: Bytes }>,
  test_bodies: List<Bytes>,
  // Each test's own form: its body with every reference written as the name it resolves to.
  test_texts: List<Bytes>,
  // What a definition's signature and specifications say to whoever references it.
  contracts: List<{ name: Bytes, hash: Bytes }>,
  // What a clause's proof is filed under: its definition's body and the contracts of what that
  // reaches in other packages. A fixed definition's is its hash.
  spec_checks: List<{ name: Bytes, hashes: List<Bytes> }>,
  // What a later run of the same program takes in place of hashing a node again.
  priors: List<Prior>,
}

// Each node's name and what it references, by index, and where a walk from a name or a key starts:
// a name at every node it names, a test's or law's key at what that item references. A closure is
// walked over these when it is asked for.
pub type Refs = { names: List<Bytes>, edges: List<List<Int>>, starts: Map<Bytes, List<Int>> }

// What hashing no program answers.
pub fn no_hashes() -> HashOutput =
  {
    defs: [],
    own: [],
    decls: [],
    tests: [],
    laws: [],
    specs: [],
    spec_texts: [],
    law_texts: [],
    deps: [],
    refs: { names: [], edges: [], starts: map_new() },
    bodies: [],
    test_bodies: [],
    test_texts: [],
    contracts: [],
    spec_checks: [],
    priors: [],
  }

// `deps` is a list in entry order; the map indexes it, or recording is quadratic.
type Recording = { out: HashOutput, deps_at: Map<Bytes, Int> }

// --- The published-hash digest -------------------------------------------------------

// The digest names the shape it covers, so it is never confused with a definition hash.
fn hashes_domain() -> Bytes = b"ply.hashes.1"

fn u64_le(v: Int) -> Bytes / {abort.raise} = bytes_concat(u32_le(v), u32_le(v >>> 32))

fn digest_named(p: { name: Bytes, hash: Bytes }) -> Bytes / {abort.raise} =
  bytes_concat_all([u64_le(bytes_len(p.name)), p.name, p.hash])

fn digest_spec(s: { name: Bytes, hashes: List<Bytes> }) -> Bytes / {abort.raise} =
  bytes_concat_all([
    u64_le(bytes_len(s.name)),
    s.name,
    u64_le(len(s.hashes)),
    bytes_concat_all(s.hashes),
  ])

// Every published hash, framed so two tables cannot collide: what a compiled unit and the machine
// entering it agree on. Each list is in the order the dump writes it.
pub fn digest(hashes: HashOutput) -> Bytes / {abort.raise} =
  blake3(
    bytes_concat_all([
      hashes_domain(),
      u64_le(len(hashes.defs)),
      bytes_concat_all(map(hashes.defs, |p: { name: Bytes, hash: Bytes }| digest_named(p))),
      u64_le(len(hashes.decls)),
      bytes_concat_all(map(hashes.decls, |p: { name: Bytes, hash: Bytes }| digest_named(p))),
      u64_le(len(hashes.specs)),
      bytes_concat_all(map(hashes.specs, |s: { name: Bytes, hashes: List<Bytes> }| digest_spec(s))),
      u64_le(len(hashes.tests)),
      bytes_concat_all(hashes.tests),
      u64_le(len(hashes.laws)),
      bytes_concat_all(hashes.laws),
    ]),
  )

// A kind byte, then the normalized bytes `blake3` keys the body by.
fn solo_body(encoding: Bytes) -> Bytes = bytes_concat(b"\x00", encoding)

// The kind byte, the member's class, then the whole component's packed bytes, so any member rebuilds the cycle.
fn member_body(packed: Bytes, class: Int) -> Bytes / {abort.raise} =
  bytes_concat_all([b"\x01", u32_le(class), packed])

type Sccs = { component_of: List<Int>, orders: List<List<Int>> }

// The effects one component can see, in an order derived only from what it references.
fn effect_order(
  index: Index,
  refs: List<Int>,
  scc: Sccs,
  own: Option<Int>,
  out: List<Int>,
) -> List<Int> / {abort.raise} =
  fold(refs, out, |acc: List<Int>, r: Int| {
    let with_effect = if is_effect(index, r) { push_unique(acc, r) } else { acc };
    let ci = if r < len(scc.component_of) { at(scc.component_of, r) } else { 0 - 1 };
    if (match own { Some(o) -> o == ci, None -> false }) || ci < 0 || ci >= len(scc.orders) {
      with_effect
    } else { fold(at(scc.orders, ci), with_effect, |a: List<Int>, node: Int| push_unique(a, node)) }
  })

fn push_unique(xs: List<Int>, v: Int) -> List<Int> =
  if contains_int(xs, v) { xs } else { push(xs, v) }

fn slots(order: List<Int>) -> Map<Int, Int> / {abort.raise} =
  fold(range(0, len(order)), map_new(), |acc: Map<Int, Int>, i: Int|
    map_insert(acc, at(order, i), i))

// The effect enumeration an item is written under, fixed by the references a pass with nothing known
// yields.
fn slots_of<| e>(
  index: Index,
  module: Int,
  scc: Sccs,
  encode: (Encoder) -> Encoder / e,
) -> Map<Int, Int> / {abort.raise | e} =
  slots(
    effect_order(
      index,
      finish(encode(new_encoder(index, module, map_new(), map_new(), map_new()))).refs,
      scc,
      None,
      [],
    ),
  )

fn encode_slotted<| e>(
  index: Index,
  module: Int,
  hashes: Map<Int, Bytes>,
  effects: Map<Int, Int>,
  by_name: Bool,
  encode: (Encoder) -> Encoder / e,
) -> Finished / {abort.raise | e} = {
  let encoder: Encoder = new_encoder(index, module, hashes, map_new(), effects);
  finish(encode({ ..encoder, by_name: by_name }))
}

fn encode_item<| e>(
  index: Index,
  module: Int,
  scc: Sccs,
  hashes: Map<Int, Bytes>,
  by_name: Bool,
  encode: (Encoder) -> Encoder / e,
) -> Finished / {abort.raise | e} =
  encode_slotted(index, module, hashes, slots_of(index, module, scc, encode), by_name, encode)

fn sketch_lt(a: Bytes, ia: Int, b: Bytes, ib: Int) -> Bool = bytes_lt(a, b) || (a == b && ia < ib)

type Refined = { members: List<{ node: Int, hash: Bytes }>, packed: Bytes, classes: Map<Int, Int> }

// A cyclic component hashes as a unit; members are labelled by class refinement to a fixpoint, plus one settling round.
fn hash_component(
  index: Index,
  component: List<Int>,
  hashes: Map<Int, Bytes>,
  effects: Map<Int, Int>,
) -> Refined / {abort.raise} = {
  let encode = |classes: Map<Int, Int>, v: Int|
    finish(
      normalize_node(
        new_encoder(index, at(index.nodes, v).module, hashes, classes, effects),
        at(index.nodes, v).body,
      ),
    ).bytes;
  let relabel = |encodings: List<Bytes>| {
    let distinct = dedup_sorted(sort_bytes(encodings));
    fold(range(0, len(component)), map_new(), |acc: Map<Int, Int>, i: Int|
      map_insert(acc, at(component, i), position_bytes(distinct, at(encodings, i))))
  };
  let grouping = |classes: Map<Int, Int>|
    sort_groups(
      fold(component, map_new(), |acc: Map<Int, List<Int>>, v: Int| {
        let c = match map_get(classes, v) { Some(x) -> x, None -> 0 };
        map_insert(acc, c, push(match map_get(acc, c) { Some(g) -> g, None -> [] }, v))
      }),
    );
  let start = fold(component, map_new(), |acc: Map<Int, Int>, v: Int| map_insert(acc, v, 0));
  let settled = iterate(
    { classes: start, encodings: map(component, |v: Int| encode(start, v)) },
    len(component) + 2,
    |s: { classes: Map<Int, Int>, encodings: List<Bytes> }| {
      let next = relabel(s.encodings);
      let same = grouping(next) == grouping(s.classes);
      let re = { classes: next, encodings: map(component, |v: Int| encode(next, v)) };
      if same { Stop(re) } else { Continue(re) }
    },
  );
  let width = fold(component, 0, |acc: Int, v: Int|
      max(acc, match map_get(settled.classes, v) { Some(c) -> c, None -> 0 }))
    + 1;
  let by_class = fold(
    range(0, len(component)),
    map(range(0, width), |i: Int| b""),
    |acc: List<Bytes>, i: Int|
      set_at(
        acc,
        match map_get(settled.classes, at(component, i)) { Some(c) -> c, None -> 0 },
        at(settled.encodings, i),
      ),
  );
  let packed = bytes_concat(
    u32_le(len(by_class)),
    bytes_concat_all(map(by_class, |m: Bytes| bytes_concat(u32_le(bytes_len(m)), m))),
  );
  let component_hash = blake3(packed);
  {
    members: map(component, |v: Int|
      {
        node: v,
        hash: member_hash(component_hash, match map_get(settled.classes, v) {
          Some(c) -> c,
          None -> 0,
        }),
      }),
    packed: packed,
    classes: settled.classes,
  }
}

fn dedup_sorted(xs: List<Bytes>) -> List<Bytes> / {abort.raise} =
  fold(xs, [], |acc: List<Bytes>, x: Bytes|
    if len(acc) > 0 && at(acc, len(acc) - 1) == x { acc } else { push(acc, x) })

fn position_bytes(xs: List<Bytes>, v: Bytes) -> Int / {abort.raise} =
  fold(range(0, len(xs)), 0, |acc: Int, i: Int| if at(xs, i) == v { i } else { acc })

// Groups by class, each sorted, the groups sorted: the shape two labellings are compared by.
fn sort_groups(groups: Map<Int, List<Int>>) -> List<List<Int>> / {abort.raise} = {
  let out = map_fold(groups, [], |acc: List<List<Int>>, k: Int, g: List<Int>|
    push(acc, sort_ints(g)));
  fold(out, [], |acc: List<List<Int>>, g: List<Int>| {
    let n = len(acc);
    let i = fold(range(0, n), n, |p: Int, j: Int|
      if p < n { p } else if ints_lt(g, at(acc, j)) { j } else { p });
    append(push(take(acc, i), g), map(range(i, n), |j: Int| at(acc, j)))
  })
}

fn sort_ints(xs: List<Int>) -> List<Int> / {abort.raise} =
  fold(xs, [], |acc: List<Int>, x: Int| {
    let n = len(acc);
    let i = fold(range(0, n), n, |p: Int, j: Int|
      if p < n { p } else if x < at(acc, j) { j } else { p });
    append(push(take(acc, i), x), map(range(i, n), |j: Int| at(acc, j)))
  })

fn ints_lt(a: List<Int>, b: List<Int>) -> Bool =
  match compare_values(a, b) { Less -> true, _ -> false }

type Forms = {
  own: List<{ name: Bytes, hash: Bytes }>,
  specs: List<{ name: Bytes, hashes: List<Bytes> }>,
  spec_texts: List<{ name: Bytes, hashes: List<Bytes> }>,
  spec_checks: List<{ name: Bytes, hashes: List<Bytes> }>,
}

type Hashed = {
  hashes: Map<Int, Bytes>,
  bodies: Map<Int, Bytes>,
  tests: List<Bytes>,
  test_bodies: List<Bytes>,
  test_texts: List<Bytes>,
  test_refs: List<List<Int>>,
  laws: List<Bytes>,
  law_refs: List<List<Int>>,
  law_texts: List<Bytes>,
  own: List<{ name: Bytes, hash: Bytes }>,
  specs: List<{ name: Bytes, hashes: List<Bytes> }>,
  spec_texts: List<{ name: Bytes, hashes: List<Bytes> }>,
  contracts: Map<Int, Bytes>,
  spec_checks: List<{ name: Bytes, hashes: List<Bytes> }>,
  priors: List<Prior>,
}

// Each test's hash, stored body, own form and references, in the index's order.
type TestForms = {
  hashes: List<Bytes>,
  bodies: List<Bytes>,
  texts: List<Bytes>,
  refs: List<List<Int>>,
}

// `hashes` is the table references are written from; `fresh` is what each body hashed to under it.
type Keyed = { hashes: Map<Int, Bytes>, bodies: Map<Int, Bytes>, fresh: Map<Int, Bytes> }

type Graph = { edges: List<List<Int>>, components: List<List<Int>>, scc: Sccs }

// Every node normalized with nothing known: the reference graph, and a sketch that orders a cycle's
// members without source position.
fn first_pass(index: Index) -> List<Finished> / {abort.raise} =
  map(index.nodes, |node: Node|
    finish(
      normalize_node(new_encoder(index, node.module, map_new(), map_new(), map_new()), node.body),
    ))

fn graph_of(index: Index) -> Graph / {abort.raise} = graph_with(index, first_pass(index), map_new())

// `extra` gives a node the references its compiled body has, where the body here is a blank.
fn graph_with(
  index: Index,
  first: List<Finished>,
  extra: Map<Int, List<Int>>,
) -> Graph / {abort.raise} = {
  let n = len(index.nodes);
  let edges = map(range(0, n), |v: Int|
    match map_get(extra, v) { Some(es) -> es, None -> at(first, v).refs });
  let sketches = map(first, |f: Finished| f.bytes);
  let components = tarjan(n, edges);
  let component_of = fold(
    range(0, len(components)),
    map(range(0, n), |i: Int| 0 - 1),
    |acc: List<Int>, ci: Int|
      fold(at(components, ci), acc, |a: List<Int>, v: Int| set_at(a, v, ci)),
  );
  // Components arrive dependency-first, so each can splice in the enumerations it references.
  let orders = fold(range(0, len(components)), [], |acc: List<List<Int>>, ci: Int| {
    let members = fold(at(components, ci), [], |ms: List<Int>, v: Int| {
      let k = len(ms);
      let i = fold(range(0, k), k, |p: Int, j: Int|
        if p < k { p }
        else if sketch_lt(at(sketches, v), v, at(sketches, at(ms, j)), at(ms, j)) { j }
        else { p });
      append(push(take(ms, i), v), map(range(i, k), |j: Int| at(ms, j)))
    });
    let scc = { component_of: component_of, orders: acc };
    push(
      acc,
      fold(members, [], |o: List<Int>, v: Int| effect_order(index, at(edges, v), scc, Some(ci), o)),
    )
  });
  { edges: edges, components: components, scc: { component_of: component_of, orders: orders } }
}

fn key_components(
  index: Index,
  graph: Graph,
  pinned: Map<Int, Bytes>,
  held: Map<Int, Fixed>,
  kept: Map<Int, Prior>,
) -> Keyed / {abort.raise} =
  fold(
    range(0, len(graph.components)),
    { hashes: map_new(), bodies: map_new(), fresh: map_new() },
    |acc: Keyed, ci: Int| {
      let component = at(graph.components, ci);
      if fold(component, true, |all: Bool, v: Int| all && map_contains(kept, v)) {
        fold(component, acc, |a: Keyed, v: Int|
          match map_get(kept, v) {
            None -> a,
            Some(p) ->
              {
                hashes: map_insert(a.hashes, v, p.hash),
                bodies: map_insert(a.bodies, v, p.body),
                fresh: map_insert(a.fresh, v, p.hash),
              },
          })
      } else if fold(component, true, |all: Bool, v: Int| all && map_contains(held, v)) {
        fold(component, acc, |a: Keyed, v: Int|
          match map_get(held, v) {
            None -> a,
            Some(f) ->
              {
                hashes: map_insert(a.hashes, v, f.hash),
                bodies: map_insert(a.bodies, v, f.body),
                fresh: map_insert(a.fresh, v, f.hash),
              },
          })
      } else { key_component(index, graph, pinned, acc, ci, component) }
    },
  )

fn key_component(
  index: Index,
  graph: Graph,
  pinned: Map<Int, Bytes>,
  acc: Keyed,
  ci: Int,
  component: List<Int>,
) -> Keyed / {abort.raise} = {
  let effects = slots(at(graph.scc.orders, ci));
  let own: Keyed = if is_cyclic(component, graph.edges) {
    let refined: Refined = hash_component(index, component, acc.hashes, effects);
    fold(refined.members, acc, |a: Keyed, m: { node: Int, hash: Bytes }| {
      let class = match map_get(refined.classes, m.node) { Some(c) -> c, None -> 0 };
      {
        ..a,
        fresh: map_insert(a.fresh, m.node, m.hash),
        bodies: map_insert(a.bodies, m.node, member_body(refined.packed, class)),
      }
    })
  } else {
    let v = at(component, 0);
    let node = at(index.nodes, v);
    let encoding = finish(
      normalize_node(new_encoder(index, node.module, acc.hashes, map_new(), effects), node.body),
    ).bytes;
    {
      ..acc,
      fresh: map_insert(acc.fresh, v, blake3(encoding)),
      bodies: map_insert(acc.bodies, v, solo_body(encoding)),
    }
  };
  {
    ..own,
    hashes: fold(component, own.hashes, |h: Map<Int, Bytes>, v: Int|
      match map_get(pinned, v) {
        Some(x) -> map_insert(h, v, x),
        None -> match map_get(own.fresh, v) { Some(x) -> map_insert(h, v, x), None -> h },
      }),
  }
}

pub fn hash_index(index: Index) -> HashOutput / {abort.raise} = hash_index_pinned(index, [])

pub type NodeRef = { name: Bytes, decl: Bool }

// What hashing derives from a node's body, which a stub lacks; `own` and specs are a function's.
pub type Fixed = {
  name: Bytes,
  decl: Bool,
  hash: Bytes,
  own: Option<Bytes>,
  specs: List<Bytes>,
  spec_texts: List<Bytes>,
  body: Bytes,
  edges: List<NodeRef>,
}

derive bin for NodeRef

derive bin for Fixed

fn node_keys(index: Index) -> Map<Bytes, Int> / {abort.raise} =
  fold(range(0, len(index.nodes)), map_new(), |acc: Map<Bytes, Int>, v: Int| {
    let node = at(index.nodes, v);
    map_insert(acc, pin_key(node.name, is_decl(node)), v)
  })

// A fixed node keeps the hash, references, forms and body it compiled with; none is hashed here.
pub fn hash_index_pinned(
  index: Index,
  fixed: List<Fixed>,
  packages: List<Int> = [],
  priors: List<Prior> = [],
) -> HashOutput / {abort.raise} = hashed_over(index, first_pass(index), fixed, packages, priors)

// The hashes and the definitions nothing uses, over one normalization of every node.
pub fn hashed_and_unused(
  index: Index,
  fixed: List<Fixed>,
  packages: List<Int>,
  priors: List<Prior> = [],
) -> { hashes: HashOutput, unused: List<Diag> } / {abort.raise} = {
  let first = first_pass(index);
  {
    hashes: hashed_over(index, first, fixed, packages, priors),
    unused: unused_over(index, first, fixed),
  }
}

// --- Priors -----------------------------------------------------------------------------

// What an earlier run hashed a node to, beside the sketch it had then.
pub type Prior = {
  name: Bytes,
  decl: Bool,
  sketch: Bytes,
  hash: Bytes,
  check: Bytes,
  contract: Bytes,
  own: Option<Bytes>,
  specs: List<Bytes>,
  spec_texts: List<Bytes>,
  spec_checks: List<Bytes>,
  body: Bytes,
}

derive bin for Prior

// References as a sketch names them: which node, of which kind, whether across a package
// boundary, and a fixed node's hash, which stands in for its body.
fn ref_marks(
  index: Index,
  packages: List<Int>,
  pinned: Map<Int, Bytes>,
  v: Int,
  refs: List<Int>,
) -> Bytes / {abort.raise} = {
  let own = package_of(index, packages, v);
  bytes_concat(
    u32_le(len(refs)),
    bytes_concat_all(
      map(refs, |r: Int| {
        let node = at(index.nodes, r);
        bytes_concat_all([
          u32_le(bytes_len(node.name)),
          node.name,
          if is_decl(node) { b"d" } else { b"f" },
          if package_of(index, packages, r) == own { b"=" } else { b"~" },
          match map_get(pinned, r) { Some(h) -> bytes_concat(b"h", h), None -> b"-" },
        ])
      }),
    ),
  )
}

type Sketched = { sketch: Bytes, spec_refs: List<Int> }

// What a node's hashing reads besides the hashes of what it references: its form with nothing
// known, and each specification clause's, which that form leaves out.
fn sketched(
  index: Index,
  first: List<Finished>,
  packages: List<Int>,
  pinned: Map<Int, Bytes>,
  v: Int,
) -> Sketched / {abort.raise} = {
  let node = at(index.nodes, v);
  let f = at(first, v);
  let clauses = match node.body {
    NodeFn(def) ->
      map(def.spec, |c: SpecClause|
        finish(
          spec_clause(new_encoder(index, node.module, map_new(), map_new(), map_new()), def, c),
        )),
    _ -> [],
  };
  let form = |x: Finished|
    bytes_concat_all([
      u32_le(bytes_len(x.bytes)),
      x.bytes,
      ref_marks(index, packages, pinned, v, x.refs),
    ]);
  {
    sketch: blake3(
      bytes_concat_all([
        b"ply.sketch.1\0",
        form(f),
        u32_le(len(clauses)),
        bytes_concat_all(map(clauses, form)),
      ]),
    ),
    spec_refs: fold(clauses, [], |acc: List<Int>, c: Finished| append(acc, c.refs)),
  }
}

// The nodes whose priors stand, component by component and dependency-first: a component stands
// when every member's sketch is its prior's and everything a member references outside it stands
// too, a fixed node by the hash its sketch carries.
fn standing_priors(
  index: Index,
  graph: Graph,
  held: Map<Int, Fixed>,
  sketches: List<Sketched>,
  priors: List<Prior>,
) -> Map<Int, Prior> / {abort.raise} =
  if len(priors) == 0 { map_new() } else {
    let by_key = fold(priors, map_new(), |acc: Map<Bytes, Prior>, p: Prior|
      map_insert(acc, pin_key(p.name, p.decl), p));
    fold(range(0, len(graph.components)), map_new(), |kept: Map<Int, Prior>, ci: Int| {
      let component = at(graph.components, ci);
      let stands = |r: Int|
        at(graph.scc.component_of, r) == ci || map_contains(held, r) || map_contains(kept, r);
      let found = fold(component, Some([]), |acc: Option<List<{ v: Int, p: Prior }>>, v: Int|
        match acc {
          None -> None,
          Some(members) -> {
            let node = at(index.nodes, v);
            let s = at(sketches, v);
            match map_get(by_key, pin_key(node.name, is_decl(node))) {
              Some(p) -> if !map_contains(held, v) && p.sketch == s.sketch
                  && fold(at(graph.edges, v), true, |all: Bool, r: Int| all && stands(r))
                  && fold(s.spec_refs, true, |all: Bool, r: Int| all && stands(r)) {
                Some(push(members, { v: v, p: p }))
              } else { None },
              None -> None,
            }
          },
        });
      match found {
        Some(members) ->
          fold(members, kept, |k: Map<Int, Prior>, m: { v: Int, p: Prior }|
            map_insert(k, m.v, m.p)),
        None -> kept,
      }
    })
  }

fn prior_forms(acc: Forms, name: Bytes, p: Prior) -> Forms = {
  let owned: Forms = match p.own {
    Some(o) -> { ..acc, own: push(acc.own, { name: name, hash: o }) },
    None -> acc,
  };
  if len(p.specs) == 0 { owned } else {
    {
      ..owned,
      specs: push(owned.specs, { name: name, hashes: p.specs }),
      spec_texts: push(owned.spec_texts, { name: name, hashes: p.spec_texts }),
      spec_checks: push(owned.spec_checks, { name: name, hashes: p.spec_checks }),
    }
  }
}

// Every node this run hashed, as the next run reads it back.
fn priors_of(
  index: Index,
  held: Map<Int, Fixed>,
  sketches: List<Sketched>,
  keyed: Keyed,
  check_keys: CheckKeys,
  contracts: Map<Int, Bytes>,
  forms: Forms,
) -> List<Prior> / {abort.raise} = {
  let named = |xs: List<{ name: Bytes, hashes: List<Bytes> }>|
    fold(xs, map_new(), |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, hashes: List<Bytes> }|
      map_insert(acc, x.name, x.hashes));
  let own = fold(forms.own, map_new(), |acc: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
    map_insert(acc, x.name, x.hash));
  let specs = named(forms.specs);
  let spec_texts = named(forms.spec_texts);
  let spec_checks = named(forms.spec_checks);
  let listed = |m: Map<Bytes, List<Bytes>>, name: Bytes|
    match map_get(m, name) { Some(xs) -> xs, None -> [] };
  fold(range(0, len(index.nodes)), [], |acc: List<Prior>, v: Int|
    if map_contains(held, v) { acc } else {
      match map_get(keyed.hashes, v) {
        None -> acc,
        Some(h) -> {
          let node = at(index.nodes, v);
          let decl = is_decl(node);
          push(acc, {
            name: node.name,
            decl: decl,
            sketch: at(sketches, v).sketch,
            hash: h,
            check: match map_get(check_keys.checks, v) { Some(c) -> c, None -> h },
            contract: match map_get(contracts, v) { Some(c) -> c, None -> h },
            own: if decl { None } else { map_get(own, node.name) },
            specs: if decl { [] } else { listed(specs, node.name) },
            spec_texts: if decl { [] } else { listed(spec_texts, node.name) },
            spec_checks: if decl { [] } else { listed(spec_checks, node.name) },
            body: match map_get(keyed.bodies, v) { Some(b) -> b, None -> b"" },
          })
        },
      }
    })
}

fn hashed_over(
  index: Index,
  first: List<Finished>,
  fixed: List<Fixed>,
  packages: List<Int>,
  priors: List<Prior>,
) -> HashOutput / {abort.raise} = {
  let keys = node_keys(index);
  let held = fold(fixed, map_new(), |acc: Map<Int, Fixed>, f: Fixed|
    match map_get(keys, pin_key(f.name, f.decl)) { Some(v) -> map_insert(acc, v, f), None -> acc });
  let g = graph_with(
    index,
    first,
    map_fold(held, map_new(), |acc: Map<Int, List<Int>>, v: Int, f: Fixed|
      map_insert(
        acc,
        v,
        fold(f.edges, [], |es: List<Int>, r: NodeRef|
          match map_get(keys, pin_key(r.name, r.decl)) { Some(w) -> push(es, w), None -> es }),
      )),
  );
  let edges = g.edges;
  let scc = g.scc;
  let pinned = map_fold(held, map_new(), |acc: Map<Int, Bytes>, v: Int, f: Fixed|
    map_insert(acc, v, f.hash));
  let sketches = map(range(0, len(index.nodes)), |v: Int|
    if map_contains(held, v) { { sketch: b"", spec_refs: [] } }
    else { sketched(index, first, packages, pinned, v) });
  let kept = standing_priors(index, g, held, sketches, priors);
  let keyed = key_components(index, g, pinned, held, kept);
  let hashes = keyed.hashes;
  let check_keys = check_key_components(index, g, held, kept, packages, hashes);
  let contracts = fold(range(0, len(index.nodes)), map_new(), |acc: Map<Int, Bytes>, v: Int|
    if is_decl(at(index.nodes, v)) { acc } else {
      map_insert(acc, v, match map_get(kept, v) {
        Some(p) -> p.contract,
        None -> match map_get(check_keys.contracts, v) {
          Some(c) -> c,
          None -> contract_of(index, g, hashes, v),
        },
      })
    });
  let tests = fold(
    index.tests,
    { hashes: [], bodies: [], texts: [], refs: [] },
    |acc: TestForms, t: TestNode| {
      let body = |encoder: Encoder| test_def(encoder, t.def);
      let effects = slots_of(index, t.module, scc, body);
      let f: Finished = encode_slotted(index, t.module, hashes, effects, false, body);
      let text: Finished = encode_slotted(index, t.module, hashes, effects, true, body);
      {
        hashes: push(acc.hashes, blake3(f.bytes)),
        bodies: push(acc.bodies, solo_body(f.bytes)),
        texts: push(acc.texts, own_hash(text.bytes)),
        refs: push(acc.refs, f.refs),
      }
    },
  );
  let laws = fold(
    index.laws,
    { hashes: [], refs: [], texts: [] },
    |acc: { hashes: List<Bytes>, refs: List<List<Int>>, texts: List<Bytes> }, l: LawNode| {
      let law = |encoder: Encoder| law_def(encoder, l.def);
      let effects = slots_of(index, l.module, scc, law);
      let f: Finished = encode_slotted(index, l.module, hashes, effects, false, law);
      let text: Finished = encode_slotted(index, l.module, hashes, effects, true, law);
      {
        hashes: push(acc.hashes, blake3(f.bytes)),
        refs: push(acc.refs, f.refs),
        texts: push(acc.texts, spec_text_hash(0, 0, text.bytes)),
      }
    },
  );
  let forms = fold(
    index.order,
    { own: [], specs: [], spec_texts: [], spec_checks: [] },
    |acc: Forms, e: IndexEntry|
      match e {
        DefEntry(v) -> {
          let node = at(index.nodes, v);
          match map_get(held, v) {
            Some(f) -> fixed_forms(acc, node.name, f),
            None -> match map_get(kept, v) {
              Some(p) -> prior_forms(acc, node.name, p),
              None -> {
                let view = viewed_refs(index, g, held, packages, hashes, check_keys, v).view;
                unfixed_forms(
                  index,
                  scc,
                  hashes,
                  view,
                  check_keys.checks,
                  acc,
                  v,
                  node,
                  at(first, v).refs,
                )
              },
            },
          }
        },
        _ -> acc,
      },
  );
  assemble(index, edges, {
    hashes: hashes,
    bodies: keyed.bodies,
    tests: tests.hashes,
    test_bodies: tests.bodies,
    test_texts: tests.texts,
    test_refs: tests.refs,
    laws: laws.hashes,
    law_refs: laws.refs,
    law_texts: laws.texts,
    own: forms.own,
    specs: forms.specs,
    spec_texts: forms.spec_texts,
    contracts: contracts,
    spec_checks: forms.spec_checks,
    priors: priors_of(index, held, sketches, keyed, check_keys, contracts, forms),
  })
}

// --- Early cutoff -------------------------------------------------------------------

fn contract_domain() -> Bytes = b"ply.contract.1"

fn package_of(index: Index, packages: List<Int>, v: Int) -> Int / {abort.raise} =
  match list_at(packages, at(index.nodes, v).module) { Some(p) -> p, None -> 0 }

// What another package reads of a definition: its signature and specifications, and its body only
// when it is `transparent`.
fn contract_of(
  index: Index,
  graph: Graph,
  hashes: Map<Int, Bytes>,
  v: Int,
) -> Bytes / {abort.raise} = {
  let node = at(index.nodes, v);
  match node.body {
    NodeFn(d) -> {
      let signature = encode_item(
        index,
        node.module,
        graph.scc,
        hashes,
        false,
        |encoder: Encoder|
          normalize_node(encoder, NodeFn({ ..d, body: ELit({ span: d.name.span, lit: LUnit }) })),
      ).bytes;
      // Normalizing erases the specifications, which a dependent is owed as much as the types.
      let clauses = map(d.spec, |clause: SpecClause|
        encode_item(index, node.module, graph.scc, hashes, false, |encoder: Encoder|
          spec_clause(encoder, d, clause)).bytes);
      // A `transparent` body is read too, so the contract holds the hash of it and all it reaches.
      let body = match d.transparent {
        Some(_) ->
          bytes_concat(b"transparent", match map_get(hashes, v) { Some(h) -> h, None -> b"" }),
        None -> b"",
      };
      blake3(bytes_concat_all([contract_domain(), signature, bytes_concat_all(clauses), body]))
    },
    _ -> match map_get(hashes, v) { Some(h) -> h, None -> b"" },
  }
}

// A public definition or declaration as another package reads it: a function by its contract, a
// declaration by its hash.
pub type Contract = { name: Bytes, decl: Bool, hash: Bytes }

fn is_public(node: Node) -> Bool =
  match node.body {
    NodeFn(d) -> is_pub(d.vis),
    NodeType(d) -> is_pub(d.vis),
    NodeEffect(d) -> is_pub(d.vis),
  }

// Every public definition and declaration of the modules `mine` names, as another package reads it.
pub fn public_contracts(
  index: Index,
  h: HashOutput,
  mine: (Bytes) -> Bool,
) -> List<Contract> / {abort.raise} = {
  let keys = node_keys(index);
  let named = |xs: List<{ name: Bytes, hash: Bytes }>, decl: Bool, into: Map<Int, Bytes>|
    fold(xs, into, |acc: Map<Int, Bytes>, x: { name: Bytes, hash: Bytes }|
      match map_get(keys, pin_key(x.name, decl)) {
        Some(v) -> map_insert(acc, v, x.hash),
        None -> acc,
      });
  let hashes = named(h.decls, true, named(h.defs, false, map_new()));
  let g = graph_of(index);
  fold(range(0, len(index.nodes)), [], |acc: List<Contract>, v: Int| {
    let node = at(index.nodes, v);
    if !is_public(node) || !mine(at(index.mods, node.module).name) { acc } else {
      push(acc, { name: node.name, decl: is_decl(node), hash: contract_of(index, g, hashes, v) })
    }
  })
}

type CheckKeys = { checks: Map<Int, Bytes>, contracts: Map<Int, Bytes> }

type Viewed = { check_keys: CheckKeys, view: Map<Int, Bytes> }

// The table a node's check key reads its references from: a definition in another package by its
// contract, a fixed one by its hash, and any other by its check key.
fn viewed_refs(
  index: Index,
  graph: Graph,
  held: Map<Int, Fixed>,
  packages: List<Int>,
  hashes: Map<Int, Bytes>,
  check_keys: CheckKeys,
  v: Int,
) -> Viewed / {abort.raise} = {
  let own = package_of(index, packages, v);
  fold(at(graph.edges, v), { check_keys: check_keys, view: map_new() }, |acc: Viewed, r: Int|
    if package_of(index, packages, r) != own {
      match map_get(acc.check_keys.contracts, r) {
        Some(c) -> { ..acc, view: map_insert(acc.view, r, c) },
        None -> {
          let c = contract_of(index, graph, hashes, r);
          {
            check_keys: { ..acc.check_keys, contracts: map_insert(acc.check_keys.contracts, r, c) },
            view: map_insert(acc.view, r, c),
          }
        },
      }
    } else {
      let k = if map_contains(held, r) { map_get(hashes, r) } else {
        match map_get(acc.check_keys.checks, r) { Some(x) -> Some(x), None -> map_get(hashes, r) }
      };
      match k { Some(x) -> { ..acc, view: map_insert(acc.view, r, x) }, None -> acc }
    })
}

// Dependency-first, as the hashes are: a component whose references all read as their hashes keeps
// them, and any other is keyed again under its view.
fn check_key_components(
  index: Index,
  graph: Graph,
  held: Map<Int, Fixed>,
  kept: Map<Int, Prior>,
  packages: List<Int>,
  hashes: Map<Int, Bytes>,
) -> CheckKeys / {abort.raise} =
  fold(
    range(0, len(graph.components)),
    { checks: map_new(), contracts: map_new() },
    |acc: CheckKeys, ci: Int| {
      let component = at(graph.components, ci);
      if fold(component, true, |all: Bool, v: Int| all && map_contains(kept, v)) {
        fold(component, acc, |keys: CheckKeys, v: Int|
          match map_get(kept, v) {
            Some(p) -> { ..keys, checks: map_insert(keys.checks, v, p.check) },
            None -> keys,
          })
      } else {
        let gathered = fold(component, { check_keys: acc, view: map_new() }, |a: Viewed, v: Int| {
          let x = viewed_refs(index, graph, held, packages, hashes, a.check_keys, v);
          {
            check_keys: x.check_keys,
            view: map_fold(x.view, a.view, |m: Map<Int, Bytes>, r: Int, k: Bytes|
              if at(graph.scc.component_of, r) == ci { m } else { map_insert(m, r, k) }),
          }
        });
        let unmoved = map_fold(gathered.view, true, |all: Bool, r: Int, k: Bytes|
          all && map_get(hashes, r) == Some(k));
        if unmoved || fold(component, true, |all: Bool, v: Int| all && map_contains(held, v)) {
          fold(component, gathered.check_keys, |keys: CheckKeys, v: Int|
            match map_get(hashes, v) {
              Some(h) -> { ..keys, checks: map_insert(keys.checks, v, h) },
              None -> keys,
            })
        } else {
          let effects = slots(at(graph.scc.orders, ci));
          if is_cyclic(component, graph.edges) {
            let refined: Refined = hash_component(index, component, gathered.view, effects);
            fold(
              refined.members,
              gathered.check_keys,
              |keys: CheckKeys, m: { node: Int, hash: Bytes }|
                { ..keys, checks: map_insert(keys.checks, m.node, m.hash) },
            )
          } else {
            let v = at(component, 0);
            let node = at(index.nodes, v);
            let encoding = finish(
              normalize_node(
                new_encoder(index, node.module, gathered.view, map_new(), effects),
                node.body,
              ),
            ).bytes;
            {
              ..gathered.check_keys,
              checks: map_insert(gathered.check_keys.checks, v, blake3(encoding)),
            }
          }
        }
      }
    },
  )

fn fixed_forms(acc: Forms, name: Bytes, fixed: Fixed) -> Forms = {
  let owned: Forms = match fixed.own {
    Some(o) -> { ..acc, own: push(acc.own, { name: name, hash: o }) },
    None -> acc,
  };
  if len(fixed.specs) == 0 { owned } else {
    {
      ..owned,
      specs: push(owned.specs, { name: name, hashes: fixed.specs }),
      spec_texts: push(owned.spec_texts, { name: name, hashes: fixed.spec_texts }),
      spec_checks: push(owned.spec_checks, { name: name, hashes: fixed.specs }),
    }
  }
}

// `refs` are the node's references with nothing known, as the first pass found them.
fn unfixed_forms(
  index: Index,
  scc: Sccs,
  hashes: Map<Int, Bytes>,
  view: Map<Int, Bytes>,
  checks: Map<Int, Bytes>,
  acc: Forms,
  v: Int,
  node: Node,
  refs: List<Int>,
) -> Forms / {abort.raise} =
  match node.body {
    NodeFn(def) -> {
      let form: Finished = encode_slotted(
        index,
        node.module,
        hashes,
        slots(effect_order(index, refs, scc, None, [])),
        true,
        |encoder: Encoder| normalize_node(encoder, NodeFn(def)),
      );
      let owned: Forms = {
        ..acc,
        own: push(acc.own, { name: node.name, hash: own_hash(form.bytes) }),
      };
      if len(def.spec) == 0 { owned } else {
        match map_get(hashes, v) {
          None -> owned,
          Some(owner) -> {
            let written = map(def.spec, |c: SpecClause| {
              let clause = |encoder: Encoder| spec_clause(encoder, def, c);
              { clause: clause, effects: slots_of(index, node.module, scc, clause) }
            });
            let encoded = |i: Int, table: Map<Int, Bytes>, by_name: Bool| {
              let w = at(written, i);
              encode_slotted(index, node.module, table, w.effects, by_name, w.clause).bytes
            };
            let clauses = map(range(0, len(def.spec)), |i: Int|
              spec_hash(owner, spec_tag(at(def.spec, i).kind), i, encoded(i, hashes, false)));
            let texts = map(range(0, len(def.spec)), |i: Int|
              spec_text_hash(spec_tag(at(def.spec, i).kind), i, encoded(i, hashes, true)));
            let cut_owner = match map_get(checks, v) { Some(k) -> k, None -> owner };
            let cuts = map(range(0, len(def.spec)), |i: Int|
              spec_hash(cut_owner, spec_tag(at(def.spec, i).kind), i, encoded(i, view, false)));
            {
              ..owned,
              specs: push(owned.specs, { name: node.name, hashes: clauses }),
              spec_texts: push(owned.spec_texts, { name: node.name, hashes: texts }),
              spec_checks: push(owned.spec_checks, { name: node.name, hashes: cuts }),
            }
          },
        }
      }
    },
    _ -> acc,
  }

// Pairs nodes by `index.order`, as `assemble` pushed them; a node `applied` fixed keeps its edges.
pub fn fixed_nodes(
  index: Index,
  hashes: HashOutput,
  keep: Map<Bytes, Bool>,
  applied: List<Fixed> = [],
) -> List<Fixed> / {abort.raise} = {
  let prior = fold(applied, map_new(), |acc: Map<Bytes, Fixed>, f: Fixed|
    map_insert(acc, pin_key(f.name, f.decl), f));
  let edges_of = |v: Int, node: Node, decl: Bool|
    match map_get(prior, pin_key(node.name, decl)) {
      Some(f) -> f.edges,
      None ->
        map(
          finish(
            normalize_node(
              new_encoder(index, node.module, map_new(), map_new(), map_new()),
              node.body,
            ),
          ).refs,
          |r: Int| { name: at(index.nodes, r).name, decl: is_decl(at(index.nodes, r)) },
        ),
    };
  let own = fold(
    hashes.own,
    map_new(),
    |acc: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }| map_insert(acc, x.name, x.hash),
  );
  let specs = fold(
    hashes.specs,
    map_new(),
    |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, hashes: List<Bytes> }|
      map_insert(acc, x.name, x.hashes),
  );
  let texts = fold(
    hashes.spec_texts,
    map_new(),
    |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, hashes: List<Bytes> }|
      map_insert(acc, x.name, x.hashes),
  );
  let listed = |m: Map<Bytes, List<Bytes>>, name: Bytes|
    match map_get(m, name) { Some(xs) -> xs, None -> [] };
  let walked = fold(
    index.order,
    { body: 0, def: 0, decl: 0, out: [] },
    |acc: { body: Int, def: Int, decl: Int, out: List<Fixed> }, e: IndexEntry|
      match e {
        DefEntry(v) -> {
          let node = at(index.nodes, v);
          let decl = is_decl(node);
          let body = at(hashes.bodies, acc.body);
          if body.name != node.name {
            panic("hashes and the index disagree on the order of nodes")
          };
          let next = {
            ..acc,
            body: acc.body + 1,
            def: if decl { acc.def } else { acc.def + 1 },
            decl: if decl { acc.decl + 1 } else { acc.decl },
          };
          if !map_contains(keep, at(index.mods, node.module).name) { next } else {
            {
              ..next,
              out: push(next.out, {
                name: node.name,
                decl: decl,
                hash: if decl { at(hashes.decls, acc.decl).hash }
                else { at(hashes.defs, acc.def).hash },
                own: if decl { None } else { map_get(own, node.name) },
                specs: if decl { [] } else { listed(specs, node.name) },
                spec_texts: if decl { [] } else { listed(texts, node.name) },
                body: body.body,
                edges: edges_of(v, node, decl),
              }),
            }
          }
        },
        _ -> acc,
      },
  );
  walked.out
}

// Each body hashed with references as `pins` wrote them: an inherited move comes back to its pin, an edit does not.

pub type Pin = { name: Bytes, decl: Bool, hash: Bytes }
pub type Rehash = { name: Bytes, decl: Bool, fresh: Bytes, table: Bytes, component: Int }
pub type Rehashed = { nodes: List<Rehash>, tests: List<{ key: Bytes, hash: Bytes }> }

fn is_decl(node: Node) -> Bool = match node.body { NodeFn(_) -> false, _ -> true }

fn pin_key(name: Bytes, decl: Bool) -> Bytes =
  bytes_concat(if decl { b"decl " } else { b"def " }, name)

pub fn rehash_index(index: Index, pins: List<Pin>) -> Rehashed / {abort.raise} = {
  let wanted = fold(pins, map_new(), |acc: Map<Bytes, Bytes>, pin: Pin|
    map_insert(acc, pin_key(pin.name, pin.decl), pin.hash));
  let pinned = fold(range(0, len(index.nodes)), map_new(), |acc: Map<Int, Bytes>, v: Int| {
    let node = at(index.nodes, v);
    match map_get(wanted, pin_key(node.name, is_decl(node))) {
      Some(h) -> map_insert(acc, v, h),
      None -> acc,
    }
  });
  let g = graph_of(index);
  let keyed = key_components(index, g, pinned, map_new(), map_new());
  let grouped = fold(range(0, len(g.components)), map_new(), |acc: Map<Int, Int>, ci: Int| {
    let c = at(g.components, ci);
    if len(c) < 2 { acc } else { fold(c, acc, |a: Map<Int, Int>, v: Int| map_insert(a, v, ci)) }
  });
  let got = |m: Map<Int, Bytes>, v: Int| match map_get(m, v) { Some(h) -> h, None -> b"" };
  {
    nodes: map(range(0, len(index.nodes)), |v: Int| {
      let node = at(index.nodes, v);
      {
        name: node.name,
        decl: is_decl(node),
        fresh: got(keyed.fresh, v),
        table: got(keyed.hashes, v),
        component: match map_get(grouped, v) { Some(ci) -> ci, None -> 0 - 1 },
      }
    }),
    tests: map(index.tests, |t: TestNode|
      {
        key: t.key,
        hash: blake3(
          encode_item(index, t.module, g.scc, keyed.hashes, false, |encoder: Encoder|
            test_def(encoder, t.def)).bytes,
        ),
      }),
  }
}

fn started(m: Map<Bytes, List<Int>>, key: Bytes, vs: List<Int>) -> Map<Bytes, List<Int>> =
  map_insert(m, key, append(match map_get(m, key) { Some(xs) -> xs, None -> [] }, vs))

fn assemble(index: Index, edges: List<List<Int>>, h: Hashed) -> HashOutput / {abort.raise} = {
  let named = fold(range(0, len(index.nodes)), map_new(), |acc: Map<Bytes, List<Int>>, v: Int|
    started(acc, at(index.nodes, v).name, [v]));
  let tested = fold(range(0, len(index.tests)), named, |acc: Map<Bytes, List<Int>>, i: Int|
    started(acc, at(index.tests, i).key, at(h.test_refs, i)));
  let starts = fold(range(0, len(index.laws)), tested, |acc: Map<Bytes, List<Int>>, i: Int|
    started(acc, at(index.laws, i).key, at(h.law_refs, i)));
  let names_at = |refs: List<Int>| map(refs, |r: Int| at(index.nodes, r).name);
  let empty: HashOutput = {
    defs: [],
    own: h.own,
    decls: [],
    tests: h.tests,
    laws: h.laws,
    specs: h.specs,
    spec_texts: h.spec_texts,
    law_texts: h.law_texts,
    deps: [],
    refs: { names: map(index.nodes, |node: Node| node.name), edges: edges, starts: starts },
    bodies: [],
    test_bodies: h.test_bodies,
    test_texts: h.test_texts,
    contracts: [],
    spec_checks: h.spec_checks,
    priors: h.priors,
  };
  fold(index.order, { out: empty, deps_at: map_new() }, |acc: Recording, e: IndexEntry|
    match e {
      DefEntry(v) -> {
        let node = at(index.nodes, v);
        let bodied: HashOutput = match map_get(h.bodies, v) {
          None -> acc.out,
          Some(body) ->
            { ..acc.out, bodies: push(acc.out.bodies, { name: node.name, body: body }) },
        };
        let keyed: HashOutput = match map_get(h.hashes, v) {
          None -> bodied,
          Some(hash) -> match node.body {
            NodeFn(_) ->
              {
                ..bodied,
                defs: push(bodied.defs, { name: node.name, hash: hash }),
                contracts: push(bodied.contracts, {
                  name: node.name,
                  hash: match map_get(h.contracts, v) { Some(c) -> c, None -> hash },
                }),
              },
            _ -> { ..bodied, decls: push(bodied.decls, { name: node.name, hash: hash }) },
          },
        };
        record({ ..acc, out: keyed }, node.name, names_at(at(edges, v)))
      },
      TestEntry(i) -> record(acc, at(index.tests, i).key, names_at(at(h.test_refs, i))),
      // A law's references are what it is a claim about.
      LawEntry(i) -> record(acc, at(index.laws, i).key, names_at(at(h.law_refs, i))),
    }).out
}

// Names collide across namespaces, so entries are merged rather than replaced.
fn record(a: Recording, name: Bytes, deps: List<Bytes>) -> Recording / {abort.raise} = {
  let out: HashOutput = a.out;
  match map_get(a.deps_at, name) {
    Some(i) -> {
      let existing = at(out.deps, i);
      {
        out: {
          ..out,
          deps: set_at(out.deps, i, {
            name: name,
            names: fold(deps, existing.names, |acc: List<Bytes>, d: Bytes|
              if contains_bytes(acc, d) { acc } else { push(acc, d) }),
          }),
        },
        deps_at: a.deps_at,
      }
    },
    None ->
      {
        out: { ..out, deps: push(out.deps, { name: name, names: deps }) },
        deps_at: map_insert(a.deps_at, name, len(out.deps)),
      },
  }
}

// --- Closures ---------------------------------------------------------------------------------------

type Reach = { seen: List<Bool>, frontier: List<Int>, all: List<Int> }

fn reach(r: Reach, v: Int) -> Reach / {abort.raise} =
  if at(r.seen, v) { r }
  else { { seen: set_at(r.seen, v, true), frontier: push(r.frontier, v), all: push(r.all, v) } }

// Every node `edges` lead to from `from`, those included: as a mark per node, and in the order met.
fn walked(
  edges: List<List<Int>>,
  from: List<Int>,
) -> { seen: List<Bool>, all: List<Int> } / {abort.raise} = {
  let n = len(edges);
  let start = fold(from, { seen: map(range(0, n), |i: Int| false), frontier: [], all: [] }, reach);
  iterate(start, n + 2, |r: Reach|
    if len(r.frontier) == 0 { Stop({ seen: r.seen, all: r.all }) } else {
      Continue(
        fold(r.frontier, { ..r, frontier: [] }, |acc: Reach, v: Int|
          fold(at(edges, v), acc, reach)),
      )
    })
}

// Every name the program declares that `keys` reach, and each of the keys the program knows: a
// definition's or declaration's name reaches what each node of that name references, and a test's
// or law's key what the item does.
pub fn closure_of(hashes: HashOutput, keys: List<Bytes>) -> Map<Bytes, Bool> / {abort.raise} = {
  let r = hashes.refs;
  let known = filter(keys, |k: Bytes| map_contains(r.starts, k));
  let from = fold(known, [], |acc: List<Int>, k: Bytes|
    append(acc, match map_get(r.starts, k) { Some(vs) -> vs, None -> [] }));
  fold(
    walked(r.edges, from).all,
    fold(known, map_new(), |acc: Map<Bytes, Bool>, k: Bytes| map_insert(acc, k, true)),
    |acc: Map<Bytes, Bool>, v: Int| map_insert(acc, at(r.names, v), true),
  )
}

// Every name and key the program knows whose closure holds one of `names`.
pub fn reaching(hashes: HashOutput, names: Map<Bytes, Bool>) -> Map<Bytes, Bool> / {abort.raise} = {
  let r = hashes.refs;
  let n = len(r.names);
  // Each list is taken out of its slot before the push, so the push finds it unshared.
  let back = fold(range(0, n), map(range(0, n), |i: Int| []), |acc: List<List<Int>>, v: Int|
    fold(at(r.edges, v), acc, |a: List<List<Int>>, w: Int| {
      let into = at(a, w);
      set_at(set_at(a, w, []), w, push(into, v))
    }));
  let seen = walked(back, filter(range(0, n), |v: Int| map_contains(names, at(r.names, v)))).seen;
  map_fold(r.starts, map_new(), |acc: Map<Bytes, Bool>, k: Bytes, vs: List<Int>|
    if map_contains(names, k) || fold(vs, false, |b: Bool, v: Int| b || at(seen, v)) {
      map_insert(acc, k, true)
    } else { acc })
}

// --- What nothing reaches -------------------------------------------------------------------------------
// The roots: a `pub` item, `main`, a derived definition, a name led by `_`, and what a test or a law mentions.
// A spec clause is reached with its owner.

// A fixed node is never reported: its own package's check answered for it.
pub fn unused(index: Index, fixed: List<Fixed> = []) -> List<Diag> / {abort.raise} =
  unused_over(index, first_pass(index), fixed)

fn unused_over(
  index: Index,
  first: List<Finished>,
  fixed: List<Fixed>,
) -> List<Diag> / {abort.raise} = {
  let keys = node_keys(index);
  let held = fold(fixed, map_new(), |acc: Map<Int, Bool>, f: Fixed|
    match map_get(keys, pin_key(f.name, f.decl)) {
      Some(v) -> map_insert(acc, v, true),
      None -> acc,
    });
  let n = len(index.nodes);
  let edges = map(range(0, n), |v: Int| node_edges(index, at(index.nodes, v), at(first, v).refs));
  let own = filter(range(0, n), |v: Int| is_root(index, at(index.nodes, v)));
  let tested = fold(index.tests, own, |acc: List<Int>, t: TestNode|
    append(
      append(acc, refs_of(index, t.module, |encoder: Encoder| test_def(encoder, t.def))),
      ret_refs(index, t.module, [t.def.body]),
    ));
  let roots = fold(index.laws, tested, |acc: List<Int>, l: LawNode| {
    let exprs = match l.def.guard { Some(g) -> [g, l.def.body], None -> [l.def.body] };
    append(
      append(acc, refs_of(index, l.module, |encoder: Encoder| law_def(encoder, l.def))),
      ret_refs(index, l.module, exprs),
    )
  });
  let seen = walked(edges, roots).seen;
  fold(range(0, n), [], |acc: List<Diag>, v: Int|
    if at(seen, v) || map_contains(held, v) { acc }
    else { push(acc, never_used(at(index.nodes, v))) })
}

fn refs_of<| e>(index: Index, module: Int, encode: (Encoder) -> Encoder / e) -> List<Int> / e =
  finish(encode(new_encoder(index, module, map_new(), map_new(), map_new()))).refs

// `own` is what normalizing the node alone references.
fn node_edges(index: Index, node: Node, own: List<Int>) -> List<Int> / {abort.raise} =
  match node.body {
    NodeFn(d) -> {
      let clauses = fold(d.spec, own, |acc: List<Int>, clause: SpecClause|
        append(
          acc,
          refs_of(index, node.module, |encoder: Encoder| spec_clause(encoder, d, clause)),
        ));
      let defaults = fold(d.params, [], |acc: List<Expr>, param: Param|
        match param.default { Some(x) -> push(acc, x), None -> acc });
      append(
        clauses,
        ret_refs(
          index,
          node.module,
          push(append(defaults, map(d.spec, |clause: SpecClause| clause.expr)), d.body),
        ),
      )
    },
    _ -> own,
  }

// The encoding leaves a lambda's written return type out, and a type named only there is still used.
fn ret_refs(index: Index, module: Int, exprs: List<Expr>) -> List<Int> / {abort.raise} =
  refs_of(index, module, |encoder: Encoder|
    fold(
      fold(exprs, [], |acc: List<TypeExpr>, expr: Expr| lambda_rets(expr, acc)),
      encoder,
      |acc: Encoder, ty: TypeExpr| type_expr(acc, ty),
    ))

fn lambda_rets(e: Expr, out: List<TypeExpr>) -> List<TypeExpr> =
  match e {
    ELambda(l) -> lambda_rets(l.body, match l.ret { Some(t) -> push(out, t), None -> out }),
    ELit(_) -> out,
    EVar(_) -> out,
    EBad(_) -> out,
    EBinary(b) -> lambda_rets(b.rhs, lambda_rets(b.lhs, out)),
    EUnary(u) -> lambda_rets(u.operand, out),
    EApp(a) ->
      fold(a.args, lambda_rets(a.func, out), |acc: List<TypeExpr>, x: Expr| lambda_rets(x, acc)),
    EIf(i) -> lambda_rets(i.else_branch, lambda_rets(i.then_branch, lambda_rets(i.cond, out))),
    EMatch(m) ->
      fold(m.arms, lambda_rets(m.scrutinee, out), |acc: List<TypeExpr>, arm: MatchArm|
        lambda_rets(arm.body, match arm.guard { Some(g) -> lambda_rets(g, acc), None -> acc })),
    EBlock(b) -> {
      let walked = fold(b.stmts, out, |acc: List<TypeExpr>, s: Stmt|
        match s {
          SLet(x) -> lambda_rets(x.value, acc),
          SLetElse(x) -> lambda_rets(x.fallback, lambda_rets(x.value, acc)),
          SExpr(x) -> lambda_rets(x, acc),
        });
      match b.tail { Some(t) -> lambda_rets(t, walked), None -> walked }
    },
    ERecord(r) -> fold(r.fields, out, |acc: List<TypeExpr>, f: RecField| lambda_rets(f.value, acc)),
    ERecordUpdate(r) ->
      fold(r.fields, lambda_rets(r.base, out), |acc: List<TypeExpr>, f: RecField|
        lambda_rets(f.value, acc)),
    ETry(t) -> lambda_rets(t.operand, out),
    EField(f) -> lambda_rets(f.base, out),
    EList(l) -> fold(l.items, out, |acc: List<TypeExpr>, x: Expr| lambda_rets(x, acc)),
    EPerform(p) -> fold(p.args, out, |acc: List<TypeExpr>, x: Expr| lambda_rets(x, acc)),
    EHandle(h) -> {
      let clauses = fold(
        h.clauses,
        lambda_rets(h.body, out),
        |acc: List<TypeExpr>, c: HandleClause| lambda_rets(c.body, acc),
      );
      match h.ret { Some(rc) -> lambda_rets(rc.body, clauses), None -> clauses }
    },
    EWithCell(c) -> lambda_rets(c.body, lambda_rets(c.init, out)),
    ESimulate(s) -> lambda_rets(s.body, out),
    EParallel(v) -> fold(v.branches, out, |acc: List<TypeExpr>, x: Expr| lambda_rets(x, acc)),
  }

fn is_pub(v: Vis) -> Bool = match v { VPub -> true, VPriv -> false }

fn is_root(index: Index, node: Node) -> Bool / {abort.raise} =
  bytes_starts_with(node.simple, b"_")
    || (match node.body {
      NodeFn(d) ->
        is_pub(d.vis) || node.simple == b"main"
          || fold(at(index.mods, node.module).derived, false, |b: Bool, x: Derived|
            b || x.span == d.span),
      NodeType(d) -> is_pub(d.vis),
      NodeEffect(d) -> is_pub(d.vis),
    })

fn never_used(node: Node) -> Diag = {
  let named: { kind: Bytes, span: Span } = match node.body {
    NodeFn(d) -> { kind: b"fn", span: d.name.span },
    NodeType(d) -> { kind: b"type", span: d.name.span },
    NodeEffect(d) -> { kind: b"effect", span: d.name.span },
  };
  {
    code: b"W0611",
    notes: 0,
    labels: [label_at(node.module, named.span, true, b"never used")],
    text: b"",
    message: bytes_concat_all([named.kind, b" `", node.name, b"` is never used"]),
    notes_text: [],
    severity: b"warning",
    fixes: [],
  }
}

// --- The dump -------------------------------------------------------------------------------------------

fn hexes(hs: List<Bytes>) -> Bytes / {abort.raise} =
  fold(range(0, len(hs)), b"", |acc: Bytes, i: Int|
    if i == 0 { hex(at(hs, i)) } else { bytes_concat_all([acc, b",", hex(at(hs, i))]) })

fn names_text(ns: List<Bytes>) -> Bytes / {abort.raise} =
  fold(range(0, len(ns)), b"", |acc: Bytes, i: Int|
    if i == 0 { at(ns, i) } else { bytes_concat_all([acc, b",", at(ns, i)]) })

fn dump_hashes(out: HashOutput) -> Bytes / {abort.raise} =
  bytes_concat_all([
    bytes_concat_all(
      map(out.defs, |d: { name: Bytes, hash: Bytes }|
        bytes_concat_all([b"H;", d.name, b";", hex(d.hash), b";"])),
    ),
    bytes_concat_all(
      map(out.decls, |d: { name: Bytes, hash: Bytes }|
        bytes_concat_all([b"Y;", d.name, b";", hex(d.hash), b";"])),
    ),
    bytes_concat_all(map(out.tests, |h: Bytes| bytes_concat_all([b"T;", hex(h), b";"]))),
    bytes_concat_all(map(out.laws, |h: Bytes| bytes_concat_all([b"L;", hex(h), b";"]))),
    bytes_concat_all(map(out.law_texts, |h: Bytes| bytes_concat_all([b"W;", hex(h), b";"]))),
    bytes_concat_all(
      map(out.own, |d: { name: Bytes, hash: Bytes }|
        bytes_concat_all([b"O;", d.name, b";", hex(d.hash), b";"])),
    ),
    bytes_concat_all(
      map(out.specs, |s: { name: Bytes, hashes: List<Bytes> }|
        bytes_concat_all([b"S;", s.name, b";", hexes(s.hashes), b";"])),
    ),
    bytes_concat_all(
      map(out.spec_texts, |s: { name: Bytes, hashes: List<Bytes> }|
        bytes_concat_all([b"X;", s.name, b";", hexes(s.hashes), b";"])),
    ),
    bytes_concat_all(
      map(out.deps, |d: { name: Bytes, names: List<Bytes> }|
        bytes_concat_all([b"D;", d.name, b";", names_text(d.names), b";"])),
    ),
    bytes_concat_all(
      map(out.deps, |d: { name: Bytes, names: List<Bytes> }|
        bytes_concat_all([
          b"C;",
          d.name,
          b";",
          names_text(map_keys(closure_of(out, [d.name]))),
          b";",
        ])),
    ),
  ])

type Parsed = { name: Bytes, module: Module, derived: List<Derived>, diags: List<Diag> }

// The driver's order: parse with the rewrites, expand every `derive`, resolve, hash.
pub fn hash_dump(sources: List<Source>) -> String / {abort.raise} = {
  let parsed = map(range(0, len(sources)), |i: Int| {
    let s = at(sources, i);
    let r = parse(s.src);
    let x = expand(r.node, r.parser.diags);
    let d: Expansion = expand_derives(i, s.name, x.module);
    { name: s.name, module: d.module, derived: d.derived, diags: d.diags }
  });
  let expansion = fold(parsed, [], |acc: List<Diag>, p: Parsed| append(acc, p.diags));
  let mods = map(parsed, |p: Parsed| { name: p.name, module: p.module, derived: p.derived });
  let head = bytes_concat_all([b"K;", int_to_bytes(len(sources)), b";"]);
  let body = if len(expansion) > 0 { bytes_concat(b"E;", dump_diags(expansion)) } else {
    match resolve_modules(mods) {
      ResolveFailed(ds) -> bytes_concat(b"E;", dump_diags(ds)),
      ResolveSucceeded(x) -> {
        let built = build_index(x.mods, x.r);
        if len(built.diags) > 0 { bytes_concat(b"E;", dump_diags(built.diags)) }
        else { dump_hashes(hash_index(built.index)) }
      },
    }
  };
  string_of_bytes(bytes_concat(head, body))
}

// --- Stored bodies back to source ------------------------------------------------------------

pub type Refusal = { message: Bytes, notes: List<Bytes> }
pub type Printing = | Printed(List<{ module: Bytes, text: Bytes }>) | Unprintable(Refusal)

type Part = {
  members: List<Bytes>,
  hashes: List<Bytes>,
  names: List<Bytes>,
  public: List<Bool>,
  module: Bytes,
  binder: Bytes,
  printed: Bool,
}
type Slot = { part: Int, class: Int }
type Layout = { parts: List<Part>, by_hash: Map<Bytes, List<Slot>>, relink: Map<Bytes, Bytes> }
// The import graph the print has laid down so far travels with the printer: a home is chosen
// with it in view, so a reference never closes a cycle the source did not have.
type BodyPrinter = { layout: Layout, part: Int, own: Bytes, graph: Map<Bytes, List<Bytes>> }
type Decoder = {
  bytes: Bytes,
  pos: Int,
  values: Int,
  types: Int,
  rows: Int,
  labels: Int,
  imports: Map<Bytes, Bytes>,
  missing: Map<Bytes, Bool>,
  slots: Map<Bytes, Int>,
}
type Decoded = { decoder: Decoder, text: Bytes }
type DecodedInt = { decoder: Decoder, value: Int }
type DecodedFlag = { decoder: Decoder, value: Bool }
type DecodedOption = { decoder: Decoder, text: Bytes, some: Bool }
type DecodedList = { decoder: Decoder, texts: List<Bytes> }
type DecodedRef = { decoder: Decoder, hash: Bytes, class: Int }

fn cursor(b: Bytes, missing: Map<Bytes, Bool>) -> Decoder =
  {
    bytes: b,
    pos: 0,
    values: 0,
    types: 0,
    rows: 0,
    labels: 0,
    imports: map_new(),
    missing: missing,
    slots: map_new(),
  }

fn read_bytes(decoder: Decoder, n: Int) -> Decoded / {abort.raise} =
  if decoder.pos + n > bytes_len(decoder.bytes) { panic("a stored body ends inside a value") }
  else {
    {
      decoder: { ..decoder, pos: decoder.pos + n },
      text: bytes_slice(decoder.bytes, decoder.pos, decoder.pos + n),
    }
  }

fn le_int(b: Bytes) -> Int / {abort.raise} =
  fold(range(0, bytes_len(b)), 0, |a: Int, i: Int| a | bytes_at(b, i) << 8 * i)

fn read_int(decoder: Decoder, n: Int) -> DecodedInt / {abort.raise} = {
  let g = read_bytes(decoder, n);
  { decoder: g.decoder, value: le_int(g.text) }
}

fn read_u8(decoder: Decoder) -> DecodedInt / {abort.raise} = read_int(decoder, 1)

fn read_u32(decoder: Decoder) -> DecodedInt / {abort.raise} = read_int(decoder, 4)

fn read_text(decoder: Decoder) -> Decoded / {abort.raise} = {
  let n = read_u32(decoder);
  read_bytes(n.decoder, n.value)
}

fn read_bool(decoder: Decoder) -> DecodedFlag / {abort.raise} = {
  let r = read_u8(decoder);
  if r.value > 1 { panic("a byte that is not a boolean") }
  else { { decoder: r.decoder, value: r.value == 1 } }
}

fn peek(decoder: Decoder) -> Int / {abort.raise} =
  if decoder.pos < bytes_len(decoder.bytes) { bytes_at(decoder.bytes, decoder.pos) } else { 0 - 1 }

fn skip(decoder: Decoder) -> Decoder = { ..decoder, pos: decoder.pos + 1 }

fn expect(decoder: Decoder, want: Int, what: Bytes) -> Decoder / {abort.raise} = {
  let r = read_u8(decoder);
  if r.value == want { r.decoder } else {
    panic(
      string_of_bytes(
        bytes_concat_all([b"expected ", what, b", found tag ", int_to_bytes(r.value)]),
      ),
    )
  }
}

fn read_count(decoder: Decoder) -> DecodedInt / {abort.raise} = {
  let r = read_u32(decoder);
  if r.value > bytes_len(r.decoder.bytes) - r.decoder.pos {
    panic("a count runs past the stored body")
  } else { r }
}

fn read_binders(decoder: Decoder) -> DecodedInt / {abort.raise} = {
  let r = read_u32(decoder);
  if r.value > 65535 { panic("a count of binders no definition declares") } else { r }
}

fn read_many<| e>(decoder: Decoder, count: Int, f: (Decoder) -> Decoded / e) -> DecodedList / e =
  fold(range(0, count), { decoder: decoder, texts: [] }, |decoded: DecodedList, i: Int| {
    let g = f(decoded.decoder);
    { decoder: g.decoder, texts: push(decoded.texts, g.text) }
  })

fn read_opt<| e>(
  decoder: Decoder,
  f: (Decoder) -> Decoded / e,
) -> DecodedOption / {abort.raise | e} = {
  let r = read_u8(decoder);
  if r.value == tag_none() { { decoder: r.decoder, text: b"", some: false } }
  else if r.value == tag_some() {
    let g = f(r.decoder);
    { decoder: g.decoder, text: g.text, some: true }
  } else { panic("a byte that is not an optional marker") }
}

fn joined(xs: List<Bytes>, sep: Bytes) -> Bytes / {abort.raise} =
  bytes_concat_all(
    map(range(0, len(xs)), |i: Int| if i == 0 { at(xs, i) } else { bytes_concat(sep, at(xs, i)) }),
  )

fn prefixed(decoded: DecodedOption, before: Bytes) -> Bytes =
  if decoded.some { bytes_concat(before, decoded.text) } else { b"" }

fn bracketed(decoded: DecodedOption) -> Bytes =
  if decoded.some { bytes_concat_all([b"[", decoded.text, b"]"]) } else { b"" }

fn local_name(level: Int) -> Bytes = bytes_concat(b"_l", int_to_bytes(level))
fn type_var_name(level: Int) -> Bytes = bytes_concat(b"_t", int_to_bytes(level))
fn row_var_name(level: Int) -> Bytes = bytes_concat(b"_e", int_to_bytes(level))
fn label_name(level: Int) -> Bytes = bytes_concat(b"_r", int_to_bytes(level))

fn line_break(depth: Int) -> Bytes =
  bytes_concat(b"\n", bytes_concat_all(map(range(0, depth), |i: Int| b"  ")))

fn zeros(k: Int) -> Bytes = bytes_concat_all(map(range(0, k), |i: Int| b"0"))

fn short_hex(h: Bytes) -> Bytes / {abort.raise} = bytes_slice(hex(h), 0, 12)

fn read_ref(printer: BodyPrinter, decoder: Decoder) -> DecodedRef / {abort.raise} = {
  let t = read_u8(decoder);
  if t.value == tag_ref_hash() {
    let g: Decoded = read_bytes(t.decoder, 32);
    let h = match map_get(printer.layout.relink, g.text) { Some(to) -> to, None -> g.text };
    {
      decoder: if map_contains(printer.layout.by_hash, h) { g.decoder }
      else { { ..g.decoder, missing: map_insert(g.decoder.missing, h, true) } },
      hash: h,
      class: 0 - 1,
    }
  } else if t.value == tag_ref_index() {
    let c = read_u32(t.decoder);
    let hashes = if printer.part < 0 { [] } else { at(printer.layout.parts, printer.part).hashes };
    if c.value >= len(hashes) { panic("a reference to a member this component does not have") }
    else { { decoder: c.decoder, hash: at(hashes, c.value), class: c.value } }
  } else { panic(string_of_bytes(bytes_concat(b"a reference of tag ", int_to_bytes(t.value)))) }
}

// A name the module being printed may write: its own needs no export, a printed module is reprinted
// `pub` throughout, and any other is reached as `binder::name`, which is what its own `pub` permits.
fn nameable(layout: Layout, slot: Slot, own: Bytes) -> Bool / {abort.raise} = {
  let p = at(layout.parts, slot.part);
  p.module == own || p.printed || at(p.public, slot.class)
}

// Two definitions alike are one body under two names, and only some of those names are in reach:
// an unreachable one is no candidate at all, since printing it names something that will not
// resolve rather than something merely further away.
// Whether `from` reaches `target` along the import edges laid down, `seen` against looping.
fn reaches(g: Map<Bytes, List<Bytes>>, from: Bytes, target: Bytes, seen: List<Bytes>) -> Bool =
  if from == target { true }
  else if contains_bytes(seen, from) { false } else {
    let next = match map_get(g, from) { Some(xs) -> xs, None -> [] };
    fold(next, false, |found: Bool, m: Bytes| found || reaches(g, m, target, push(seen, from)))
  }

fn pick(
  layout: Layout,
  g: Map<Bytes, List<Bytes>>,
  mine: Map<Bytes, Bytes>,
  h: Bytes,
  own: Bytes,
) -> Option<Slot> / {abort.raise} = {
  // A home is safe when pointing at it adds no import edge that closes a cycle: the module's own,
  // one it already imports, or one that cannot reach it in the print so far. When every home
  // would close a cycle the nearest name stands and the print fails downstream as before; a
  // choice that is only worse is still better than a cycle.
  let edges = map_insert(g, own, map_keys(mine));
  let safe = |s: Slot| {
    let p = at(layout.parts, s.part);
    p.module == own || map_contains(mine, p.module) || !reaches(edges, p.module, own, [])
  };
  let score = |s: Slot| {
    let p = at(layout.parts, s.part);
    (if p.module == own { 0 } else { 4 }) + (if map_contains(mine, p.module) { 0 } else { 2 })
      + (if p.printed { 0 } else { 1 })
  };
  match map_get(layout.by_hash, h) {
    None -> None,
    Some(found) -> {
      let named = filter(found, |s: Slot| nameable(layout, s, own));
      let pool = match filter(named, safe) { [] -> named, homes -> homes };
      fold(pool, None, |best: Option<Slot>, s: Slot|
        match best { Some(b) -> if score(s) < score(b) { Some(s) } else { best }, None -> Some(s) })
    },
  }
}

fn qname(
  printer: BodyPrinter,
  decoded: DecodedRef,
  ctor: Option<Bytes>,
) -> Decoded / {abort.raise} = {
  let found = if decoded.class >= 0 { Some({ part: printer.part, class: decoded.class }) }
  else { pick(printer.layout, printer.graph, decoded.decoder.imports, decoded.hash, printer.own) };
  match found {
    // A body with no name this module may write is filed with the ones it has no body for: either
    // way the reference cannot be printed, and a refusal names it rather than a hex string standing
    // in for it.
    None ->
      {
        decoder: {
          ..decoded.decoder,
          missing: map_insert(decoded.decoder.missing, decoded.hash, true),
        },
        text: match ctor { Some(c) -> c, None -> short_hex(decoded.hash) },
      },
    Some(s) -> {
      let p = at(printer.layout.parts, s.part);
      let name = match ctor { Some(c) -> c, None -> at(p.names, s.class) };
      if p.module == printer.own { { decoder: decoded.decoder, text: name } } else {
        {
          decoder: {
            ..decoded.decoder,
            imports: map_insert(decoded.decoder.imports, p.module, p.binder),
          },
          text: bytes_concat_all([p.binder, b"::", name]),
        }
      }
    },
  }
}

fn is_free(decoder: Decoder) -> Bool / {abort.raise} =
  peek(decoder) == tag_free() || peek(decoder) == tag_free_qualified()

fn read_free(decoder: Decoder) -> Decoded / {abort.raise} = {
  let t = read_u8(decoder);
  if t.value == tag_free() { read_text(t.decoder) } else if t.value == tag_free_qualified() {
    let m = read_text(t.decoder);
    let n = read_text(m.decoder);
    { decoder: n.decoder, text: bytes_concat_all([m.text, b"::", n.text]) }
  } else { panic("a tag that is not a free reference") }
}

fn read_value(printer: BodyPrinter, decoder: Decoder) -> Decoded / {abort.raise} =
  if peek(decoder) == tag_local() {
    let l = read_u32(skip(decoder));
    if l.value >= decoder.values { panic("a local that is not in scope") }
    else { { decoder: l.decoder, text: local_name(l.value) } }
  } else if peek(decoder) == tag_ctor() { read_ctor(printer, decoder) }
  else if is_free(decoder) { read_free(decoder) }
  else { qname(printer, read_ref(printer, decoder), None) }

fn read_ctor(printer: BodyPrinter, decoder: Decoder) -> Decoded / {abort.raise} =
  if peek(decoder) == tag_ctor() {
    let owner: DecodedRef = read_ref(printer, skip(decoder));
    let name = read_text(owner.decoder);
    qname(printer, { ..owner, decoder: name.decoder }, Some(name.text))
  } else { read_free(decoder) }

// Two effects declared alike share a hash, and only the slot tells them apart.
fn read_effect(printer: BodyPrinter, decoder: Decoder) -> Decoded / {abort.raise} =
  if is_free(decoder) { read_free(decoder) } else {
    let r: DecodedRef = read_ref(printer, decoder);
    let s: DecodedInt = read_u32(r.decoder);
    match map_get(s.decoder.slots, r.hash) {
      Some(was) -> if was != s.value {
        panic(
          "two distinct effects share one declaration, which a hash-keyed body cannot tell apart",
        )
      } else { qname(printer, { ..r, decoder: s.decoder }, None) },
      None ->
        qname(
          printer,
          { ..r, decoder: { ..s.decoder, slots: map_insert(s.decoder.slots, r.hash, s.value) } },
          None,
        ),
    }
  }

fn print_type(printer: BodyPrinter, d: Decoder) -> Decoded / {abort.raise} = {
  let t = read_u8(d);
  if t.value == tag_ty_con() {
    if peek(t.decoder) == tag_ty_param() {
      let l = read_u32(skip(t.decoder));
      let n = read_u32(l.decoder);
      if l.value >= d.types || n.value != 0 { panic("a type parameter out of scope, or applied") }
      else { { decoder: n.decoder, text: type_var_name(l.value) } }
    } else {
      let name = if is_free(t.decoder) { read_free(t.decoder) }
      else { qname(printer, read_ref(printer, t.decoder), None) };
      let n = read_count(name.decoder);
      let args = read_many(n.decoder, n.value, |e: Decoder| print_type(printer, e));
      // A bare lowercase name reads back as a type variable, so it keeps an empty `<>`.
      let bare = match bytes_index_of(name.text, b"::") { Some(_) -> false, None -> true };
      {
        decoder: args.decoder,
        text: if n.value > 0 || (bare && !is_ctor_name(name.text)) {
          bytes_concat_all([name.text, b"<", joined(args.texts, b", "), b">"])
        } else { name.text },
      }
    }
  } else if t.value == tag_ty_fn() {
    let n = read_count(t.decoder);
    let ps = read_many(n.decoder, n.value, |e: Decoder| print_type(printer, e));
    let ret = print_ret(printer, ps.decoder);
    let row = read_opt(ret.decoder, |e: Decoder| print_row(printer, e));
    {
      decoder: row.decoder,
      text: bytes_concat_all([
        b"(",
        joined(ps.texts, b", "),
        b") -> ",
        ret.text,
        prefixed(row, b" / "),
      ]),
    }
  } else if t.value == tag_ty_record() {
    let n = read_count(t.decoder);
    let fs = read_many(n.decoder, n.value, |e: Decoder| {
      let f = read_text(e);
      let ty = print_type(printer, f.decoder);
      { decoder: ty.decoder, text: bytes_concat_all([f.text, b": ", ty.text]) }
    });
    { decoder: fs.decoder, text: bytes_concat_all([b"{", joined(fs.texts, b", "), b"}"]) }
  } else if t.value == tag_ty_unit() { { decoder: t.decoder, text: b"()" } }
  else { panic("a tag that does not begin a type") }
}

// After `->` a function type is parenthesized, or a row after it would bind to the inner arrow.
fn print_ret(printer: BodyPrinter, decoder: Decoder) -> Decoded / {abort.raise} =
  if peek(decoder) == tag_ty_fn() {
    let g = print_type(printer, decoder);
    { decoder: g.decoder, text: bytes_concat_all([b"(", g.text, b")"]) }
  } else { print_type(printer, decoder) }

fn read_mode(decoder: Decoder) -> Decoded / {abort.raise} = {
  let m = read_u8(decoder);
  if m.value == 0 { { decoder: m.decoder, text: b"read" } }
  else if m.value == 1 { { decoder: m.decoder, text: b"write" } }
  else { panic("a byte that is not an access mode") }
}

fn read_label(decoder: Decoder) -> Decoded / {abort.raise} = {
  let k = read_u8(decoder);
  if k.value == tag_label_param() {
    let l = read_u32(k.decoder);
    if l.value >= decoder.labels { panic("a label parameter that is not in scope") }
    else { { decoder: l.decoder, text: label_name(l.value) } }
  } else if k.value == tag_free() { read_text(k.decoder) }
  else { panic("a tag that is not a resource label") }
}

fn print_row(printer: BodyPrinter, d: Decoder) -> Decoded / {abort.raise} = {
  let n = read_count(expect(d, tag_row(), b"an effect row"));
  let atoms = read_many(n.decoder, n.value, |e: Decoder| {
    if peek(e) == tag_atom_op() {
      let eff = read_effect(printer, expect(e, tag_atom_op(), b"an operation atom"));
      let op = read_text(eff.decoder);
      let r = read_opt(op.decoder, read_label);
      { decoder: r.decoder, text: bytes_concat_all([eff.text, b".", op.text, bracketed(r)]) }
    } else {
      let eff = read_effect(printer, expect(e, tag_atom(), b"an effect atom"));
      let m = read_mode(eff.decoder);
      let r = read_opt(m.decoder, read_label);
      { decoder: r.decoder, text: bytes_concat_all([eff.text, b".", m.text, bracketed(r)]) }
    }
  });
  let tail = read_opt(atoms.decoder, |e: Decoder| {
    let k = read_u8(e);
    if k.value == tag_row_param() {
      let l = read_u32(k.decoder);
      if l.value >= e.rows { panic("a row parameter that is not in scope") }
      else { { decoder: l.decoder, text: row_var_name(l.value) } }
    } else if k.value == tag_free() { read_text(k.decoder) }
    else { panic("a tag that is not a row tail") }
  });
  {
    decoder: tail.decoder,
    text: if n.value == 0 && tail.some { tail.text }
    else { bytes_concat_all([b"{", joined(atoms.texts, b", "), prefixed(tail, b" | "), b"}"]) },
  }
}

fn escape(c: Int, raw: Bool) -> Bytes / {abort.raise} =
  if c == 34 { b"\\\"" }
  else if c == 92 { b"\\\\" }
  else if c == 10 { b"\\n" }
  else if c == 9 { b"\\t" }
  else if c == 13 { b"\\r" }
  else if c == 0 { b"\\0" }
  else if raw || (c >= 32 && c <= 126) { byte_of(c) }
  else { bytes_concat_all([b"\\x", hex_digit(c >>> 4), hex_digit(c & 15)]) }

fn str_lit(s: Bytes) -> Bytes / {abort.raise} =
  bytes_concat_all([
    b"\"",
    bytes_concat_all(map(range(0, bytes_len(s)), |i: Int| escape(bytes_at(s, i), true))),
    b"\"",
  ])

// A character is its literal; past ASCII it is its own UTF-8, as a string's characters are.
fn char_lit(v: Int) -> Bytes / {abort.raise} =
  bytes_concat_all([
    b"'",
    if v == 39 { b"\\'" }
    else if v == 34 { b"\"" }
    else if v < 128 { escape(v, true) }
    else { utf8_of(v) },
    b"'",
  ])

fn bytes_lit(s: Bytes) -> Bytes / {abort.raise} =
  bytes_concat_all([
    b"b\"",
    bytes_concat_all(map(range(0, bytes_len(s)), |i: Int| escape(bytes_at(s, i), false))),
    b"\"",
  ])

fn hex_int(v: Int, bits: Int) -> Bytes / {abort.raise} = {
  let n = bits / 4;
  let ds = map(range(0, n), |i: Int| v >>> 4 * (n - 1 - i) & 15);
  let lead = fold(range(0, n), n - 1, |acc: Int, j: Int|
    if at(ds, j) != 0 && j < acc { j } else { acc });
  bytes_concat(b"0x", bytes_concat_all(map(range(lead, n), |j: Int| hex_digit(at(ds, j)))))
}

// A negative literal is spelled as its bit pattern: `-5` would read back as a negation.
fn int_text(v: Int) -> Bytes / {abort.raise} = if v >= 0 { int_to_bytes(v) } else { hex_int(v, 64) }

fn fixed_text(which: Int, v: Int) -> Bytes / {abort.raise} =
  match list_at(widths(), which) {
    None -> panic("a byte that is not a fixed-width integer type"),
    Some(w) ->
      bytes_concat(
        if v >= 0 { int_to_bytes(v) }
        else { hex_int(if w.bits == 64 { v } else { v & (1 << w.bits) - 1 }, w.bits) },
        w.name,
      ),
  }

fn wide_text(which: Int, high: Int, low: Int) -> Bytes / {abort.raise} =
  match list_at(widths(), which) {
    None -> panic("a byte that is not a fixed-width integer type"),
    Some(w) ->
      bytes_concat(
        if w.signed && high < 0 {
          bytes_concat(
            hex_int(high, 64),
            bytes_concat_all(map(range(0, 16), |i: Int| hex_digit(low >>> 4 * (15 - i) & 15))),
          )
        } else { wide_decimal(false, high, low) },
        w.name,
      ),
  }

fn big_mul(n: List<Int>, f: Int, add: Int) -> List<Int> / {abort.raise} = {
  let r = fold(n, { limbs: [], carry: add }, |s: { limbs: List<Int>, carry: Int }, limb: Int| {
    let v = limb * f + s.carry;
    { limbs: push(s.limbs, v % 1000000000), carry: v / 1000000000 }
  });
  iterate(r, 4, |s: { limbs: List<Int>, carry: Int }|
    if s.carry == 0 { Stop(s) } else {
      Continue({ limbs: push(s.limbs, s.carry % 1000000000), carry: s.carry / 1000000000 })
    }).limbs
}

fn pow_int(b: Int, k: Int) -> Int = fold(range(0, k), 1, |a: Int, i: Int| a * b)

fn big_pow(n: List<Int>, base: Int, e: Int) -> List<Int> / {abort.raise} = {
  let chunk = if base == 5 { 13 } else { 30 };
  big_mul(
    fold(range(0, e / chunk), n, |acc: List<Int>, i: Int| big_mul(acc, pow_int(base, chunk), 0)),
    pow_int(base, e % chunk),
    0,
  )
}

fn big_digits(n: List<Int>) -> Bytes / {abort.raise} = {
  let top = fold(range(0, len(n)), 0, |t: Int, i: Int| if at(n, i) != 0 { i } else { t });
  bytes_concat_all(
    map(range(0, top + 1), |j: Int| {
      let d = int_to_bytes(at(n, top - j));
      if j == 0 { d } else { bytes_concat(zeros(9 - bytes_len(d)), d) }
    }),
  )
}

fn decimal_text(m: Bytes, scale: Int) -> Bytes / {abort.raise} =
  if scale > 28 || fold(range(12, 16), false, |b: Bool, i: Int| b || bytes_at(m, i) != 0) {
    panic("a mantissa and scale that are not a `Decimal`")
  } else {
    let ds = big_digits(
      fold(range(0, 12), [0], |acc: List<Int>, i: Int| big_mul(acc, 256, bytes_at(m, 11 - i))),
    );
    let padded = if bytes_len(ds) <= scale { bytes_concat(zeros(scale - bytes_len(ds) + 1), ds) }
    else { ds };
    let point = bytes_len(padded) - scale;
    bytes_concat(
      if scale == 0 { ds } else {
        bytes_concat_all([
          bytes_slice(padded, 0, point),
          b".",
          bytes_slice(padded, point, bytes_len(padded)),
        ])
      },
      b"m",
    )
  }

type Rounded = { digits: Bytes, exp: Int, p: Int }

fn trim_zeros(s: Bytes) -> Bytes / {abort.raise} =
  bytes_slice(
    s,
    0,
    fold(range(0, bytes_len(s)), 1, |acc: Int, i: Int|
      if bytes_at(s, i) != 48 { i + 1 } else { acc }),
  )

fn scientific(s: Bytes, x: Int) -> Bytes / {abort.raise} =
  bytes_concat_all([
    bytes_slice(s, 0, 1),
    if bytes_len(s) > 1 { bytes_concat(b".", bytes_slice(s, 1, bytes_len(s))) } else { b"" },
    b"e",
    int_to_bytes(x),
  ])

fn round_to(ds: Bytes, x0: Int, p: Int) -> Rounded / {abort.raise} = {
  let head = bytes_slice(ds, 0, p);
  if p >= bytes_len(ds) || bytes_at(ds, p) < 53 { { digits: trim_zeros(head), exp: x0, p: p } }
  else {
    let k = fold(range(0, p), 0 - 1, |acc: Int, i: Int|
      if bytes_at(head, i) != 57 { i } else { acc });
    if k < 0 { { digits: b"1", exp: x0 + 1, p: p } } else {
      {
        digits: bytes_concat(bytes_slice(head, 0, k), byte_of(bytes_at(head, k) + 1)),
        exp: x0,
        p: p,
      }
    }
  }
}

fn reads_back(r: Rounded, mag: Int) -> Bool / {abort.raise} =
  match float_of_string(string_of_bytes(scientific(r.digits, r.exp))) {
    Some(f) -> bits_of_float(f) == mag,
    None -> false,
  }

fn shortest(ds: Bytes, x0: Int, mag: Int) -> Rounded / {abort.raise} =
  iterate({ digits: ds, exp: x0, p: 1 }, 19, |s: Rounded|
    if s.p > 17 || s.p > bytes_len(ds) { Stop({ digits: trim_zeros(ds), exp: x0, p: s.p }) } else {
      let r = round_to(ds, x0, s.p);
      if reads_back(r, mag) { Stop(r) } else { Continue({ ..s, p: s.p + 1 }) }
    })

fn float_spelling(r: Rounded) -> Bytes / {abort.raise} = {
  let s = r.digits;
  let n = bytes_len(s);
  let positional = if r.exp >= n - 1 { bytes_concat(s, zeros(r.exp - n + 1)) } else if r.exp >= 0 {
    bytes_concat_all([bytes_slice(s, 0, r.exp + 1), b".", bytes_slice(s, r.exp + 1, n)])
  } else { bytes_concat_all([b"0.", zeros(0 - r.exp - 1), s]) };
  let exponential = scientific(s, r.exp);
  let text = if bytes_len(exponential) < bytes_len(positional) { exponential } else { positional };
  match bytes_index_of(text, b".") {
    Some(_) -> text,
    None -> match bytes_index_of(text, b"e") { Some(_) -> text, None -> bytes_concat(text, b".0") },
  }
}

fn float_text(bits: Int) -> Bytes / {abort.raise} = {
  let mag = bits & 0x7FFFFFFFFFFFFFFF;
  let sign = if bits < 0 { b"-" } else { b"" };
  let ex = mag >>> 52;
  let fr = mag & 0xFFFFFFFFFFFFF;
  if ex == 2047 && fr != 0 { panic("a NaN, which no literal spells") }
  else if ex == 2047 { bytes_concat(sign, b"1e400") }
  else if mag == 0 { bytes_concat(sign, b"0.0") } else {
    let m = if ex == 0 { fr } else { fr | 0x10000000000000 };
    let e2 = if ex == 0 { 0 - 1074 } else { ex - 1075 };
    let start = [m % 1000000000, m / 1000000000];
    let ds = big_digits(if e2 >= 0 { big_pow(start, 2, e2) } else { big_pow(start, 5, 0 - e2) });
    let x0 = bytes_len(ds) - 1 + (if e2 >= 0 { 0 } else { e2 });
    bytes_concat(sign, float_spelling(shortest(ds, x0, mag)))
  }
}

fn print_lit(decoder: Decoder) -> Decoded / {abort.raise} = {
  let t = read_u8(decoder);
  let e = t.decoder;
  if t.value == tag_lit_int() {
    let v = read_int(e, 8);
    { decoder: v.decoder, text: int_text(v.value) }
  } else if t.value == tag_lit_bool() {
    let b = read_bool(e);
    { decoder: b.decoder, text: if b.value { b"true" } else { b"false" } }
  } else if t.value == tag_lit_str() {
    let s = read_text(e);
    { decoder: s.decoder, text: str_lit(s.text) }
  } else if t.value == tag_lit_bytes() {
    let s = read_text(e);
    { decoder: s.decoder, text: bytes_lit(s.text) }
  } else if t.value == tag_lit_float() {
    let v = read_int(e, 8);
    { decoder: v.decoder, text: float_text(v.value) }
  } else if t.value == tag_lit_decimal() {
    let m = read_bytes(e, 16);
    let s = read_u32(m.decoder);
    { decoder: s.decoder, text: decimal_text(m.text, s.value) }
  } else if t.value == tag_lit_fixed() {
    let w = read_u8(e);
    let v = read_int(w.decoder, 8);
    { decoder: v.decoder, text: fixed_text(w.value, v.value) }
  } else if t.value == tag_lit_wide() {
    let w = read_u8(e);
    let high = read_int(w.decoder, 8);
    let low = read_int(high.decoder, 8);
    { decoder: low.decoder, text: wide_text(w.value, high.value, low.value) }
  } else if t.value == tag_lit_char() {
    let v = read_u32(e);
    { decoder: v.decoder, text: char_lit(v.value) }
  } else if t.value == tag_lit_unit() { { decoder: e, text: b"()" } }
  else { panic("a tag that is not a literal") }
}

fn print_pat(printer: BodyPrinter, d: Decoder) -> Decoded / {abort.raise} = {
  let t = read_u8(d);
  let e: Decoder = t.decoder;
  if t.value == tag_p_wildcard() { { decoder: e, text: b"_" } } else if t.value == tag_p_var() {
    { decoder: { ..e, values: e.values + 1 }, text: local_name(e.values) }
  } else if t.value == tag_p_lit() { print_lit(e) } else if t.value == tag_p_ctor() {
    let name = read_ctor(printer, e);
    let n = read_count(name.decoder);
    let args = read_many(n.decoder, n.value, |g: Decoder| print_pat(printer, g));
    {
      decoder: args.decoder,
      text: if n.value == 0 { name.text }
      else { bytes_concat_all([name.text, b"(", joined(args.texts, b", "), b")"]) },
    }
  } else if t.value == tag_p_record() {
    let n = read_count(e);
    let fs = read_many(n.decoder, n.value, |g: Decoder| {
      let f = read_text(g);
      let p = print_pat(printer, f.decoder);
      { decoder: p.decoder, text: bytes_concat_all([f.text, b": ", p.text]) }
    });
    let rest = read_bool(fs.decoder);
    {
      decoder: rest.decoder,
      text: bytes_concat_all([
        b"{",
        joined(fs.texts, b", "),
        if !rest.value { b"" } else if n.value > 0 { b", .." } else { b".." },
        b"}",
      ]),
    }
  } else if t.value == tag_p_list() {
    let n = read_count(e);
    let items = read_many(n.decoder, n.value, |g: Decoder| print_pat(printer, g));
    let named = peek(skip(items.decoder)) == tag_p_var();
    let rest = read_opt(items.decoder, |g: Decoder| print_pat(printer, g));
    {
      decoder: rest.decoder,
      text: bytes_concat_all([
        b"[",
        joined(items.texts, b", "),
        if !rest.some { b"" } else {
          bytes_concat_all([
            if n.value > 0 { b", " } else { b"" },
            b"..",
            if named { rest.text } else { b"" },
          ])
        },
        b"]",
      ]),
    }
  } else { panic("a tag that does not begin a pattern") }
}

fn parens(decoded: Decoded, bare: Bool) -> Decoded =
  if bare { decoded }
  else { { decoder: decoded.decoder, text: bytes_concat_all([b"(", decoded.text, b")"]) } }

fn is_atomic(decoder: Decoder) -> Bool / {abort.raise} = {
  let t = peek(decoder);
  t == tag_e_lit() || t == tag_e_var() || t == tag_e_app() || t == tag_e_field()
    || t == tag_e_list()
    || t == tag_e_perform()
}

fn is_base(decoder: Decoder) -> Bool / {abort.raise} = {
  let t = peek(decoder);
  t == tag_e_var() || t == tag_e_app() || t == tag_e_field() || t == tag_e_perform()
}

fn print_operand(printer: BodyPrinter, decoder: Decoder, depth: Int) -> Decoded / {abort.raise} =
  parens(print_expr(printer, decoder, depth), is_atomic(decoder))

fn print_block(printer: BodyPrinter, decoder: Decoder, depth: Int) -> Decoded / {abort.raise} =
  if peek(decoder) == tag_e_block() { print_expr(printer, decoder, depth) } else {
    let g = print_expr(printer, decoder, depth + 1);
    {
      decoder: g.decoder,
      text: bytes_concat_all([b"{", line_break(depth + 1), g.text, line_break(depth), b"}"]),
    }
  }

fn binop_text(op: Int) -> Bytes / {abort.raise} =
  match list_at(
      [
        b"+",
        b"-",
        b"*",
        b"/",
        b"%",
        b"==",
        b"!=",
        b"<",
        b"<=",
        b">",
        b">=",
        b"&&",
        b"||",
        b"++",
        b"&",
        b"|",
        b"^",
        b"<<",
        b">>",
        b">>>",
      ],
      op - 1,
    ) {
    Some(t) -> t,
    None -> panic("a byte that is not a binary operator"),
  }

fn unop_text(op: Int) -> Bytes / {abort.raise} =
  if op == 1 { b"-" }
  else if op == 2 { b"!" }
  else if op == 3 { b"~" }
  else { panic("a byte that is not a unary operator") }

// `if c { t }` is the parser's own spelling of an `else ()`.
fn print_if(printer: BodyPrinter, decoder: Decoder, depth: Int) -> Decoded / {abort.raise} = {
  let c = print_operand(printer, decoder, depth);
  let th = print_block(printer, c.decoder, depth);
  let el: Decoder = th.decoder;
  let tail: Decoded = if peek(el) == tag_e_lit() && peek(skip(el)) == tag_lit_unit() {
    { decoder: { ..el, pos: el.pos + 2 }, text: b"" }
  } else if peek(el) == tag_e_if() {
    let g = print_expr(printer, el, depth);
    { decoder: g.decoder, text: bytes_concat(b" else ", g.text) }
  } else {
    let g = print_block(printer, el, depth);
    { decoder: g.decoder, text: bytes_concat(b" else ", g.text) }
  };
  { decoder: tail.decoder, text: bytes_concat_all([b"if ", c.text, b" ", th.text, tail.text]) }
}

fn print_expr(printer: BodyPrinter, d: Decoder, depth: Int) -> Decoded / {abort.raise} = {
  let t = read_u8(d);
  let e = t.decoder;
  let inner = depth + 1;
  if t.value == tag_e_lit() { print_lit(e) }
  else if t.value == tag_e_var() { read_value(printer, e) } else if t.value == tag_e_binary() {
    let op = read_u8(e);
    let l = print_operand(printer, op.decoder, depth);
    let r = print_operand(printer, l.decoder, depth);
    {
      decoder: r.decoder,
      text: bytes_concat_all([l.text, b" ", binop_text(op.value), b" ", r.text]),
    }
  } else if t.value == tag_e_unary() {
    let op = read_u8(e);
    let o = print_operand(printer, op.decoder, depth);
    { decoder: o.decoder, text: bytes_concat(unop_text(op.value), o.text) }
  } else if t.value == tag_e_lambda() {
    let n = read_count(e);
    let anns: DecodedList = read_many(n.decoder, n.value, |g: Decoder| {
      let o = read_opt(g, |h: Decoder| print_type(printer, h));
      { decoder: o.decoder, text: prefixed(o, b": ") }
    });
    let base = anns.decoder.values;
    let body: Decoded = print_expr(printer, { ..anns.decoder, values: base + n.value }, depth);
    let ps = map(range(0, n.value), |i: Int| bytes_concat(local_name(base + i), at(anns.texts, i)));
    {
      decoder: { ..body.decoder, values: base },
      text: bytes_concat_all([
        if n.value == 0 { b"||" } else { bytes_concat_all([b"|", joined(ps, b", "), b"|"]) },
        b" ",
        body.text,
      ]),
    }
  } else if t.value == tag_e_app() {
    // `r.f(x)` performs an effect, so a call through anything but a name is parenthesized.
    let f = parens(print_expr(printer, e, depth), peek(e) == tag_e_var());
    let n = read_count(f.decoder);
    let args = read_many(n.decoder, n.value, |g: Decoder| print_expr(printer, g, depth));
    let ln = read_count(args.decoder);
    let ls = read_many(ln.decoder, ln.value, read_label);
    {
      decoder: ls.decoder,
      text: bytes_concat_all([
        f.text,
        if ln.value == 0 { b"" } else { bytes_concat_all([b"[", joined(ls.texts, b", "), b"]"]) },
        b"(",
        joined(args.texts, b", "),
        b")",
      ]),
    }
  } else if t.value == tag_e_if() { print_if(printer, e, depth) } else if t.value == tag_e_match() {
    let s = print_operand(printer, e, depth);
    let n = read_count(s.decoder);
    let arms = read_many(n.decoder, n.value, |g: Decoder| {
      let p = print_pat(printer, expect(g, tag_arm(), b"a match arm"));
      let guard = read_opt(p.decoder, |h: Decoder| print_expr(printer, h, inner));
      let body: Decoded = print_expr(printer, guard.decoder, inner);
      {
        decoder: { ..body.decoder, values: g.values },
        text: bytes_concat_all([
          line_break(inner),
          p.text,
          prefixed(guard, b" if "),
          b" -> ",
          body.text,
          b",",
        ]),
      }
    });
    {
      decoder: arms.decoder,
      text: bytes_concat_all([
        b"match ",
        s.text,
        b" {",
        bytes_concat_all(arms.texts),
        line_break(depth),
        b"}",
      ]),
    }
  } else if t.value == tag_e_block() {
    let n = read_count(e);
    let stmts = read_many(n.decoder, n.value, |g: Decoder| {
      let s = print_stmt(printer, g, inner);
      { decoder: s.decoder, text: bytes_concat(line_break(inner), s.text) }
    });
    let tail: DecodedOption = read_opt(stmts.decoder, |g: Decoder| print_expr(printer, g, inner));
    {
      decoder: { ..tail.decoder, values: e.values },
      text: bytes_concat_all([
        b"{",
        bytes_concat_all(stmts.texts),
        prefixed(tail, line_break(inner)),
        line_break(depth),
        b"}",
      ]),
    }
  } else if t.value == tag_e_record() {
    let n = read_count(e);
    let fs = read_many(n.decoder, n.value, |g: Decoder| {
      let f = read_text(g);
      let v = print_expr(printer, f.decoder, depth);
      { decoder: v.decoder, text: bytes_concat_all([f.text, b": ", v.text]) }
    });
    { decoder: fs.decoder, text: bytes_concat_all([b"{", joined(fs.texts, b", "), b"}"]) }
  } else if t.value == tag_e_record_update() {
    let b = print_expr(printer, e, depth);
    let n = read_count(b.decoder);
    let fs = read_many(n.decoder, n.value, |g: Decoder| {
      let f = read_text(g);
      let v = print_expr(printer, f.decoder, depth);
      { decoder: v.decoder, text: bytes_concat_all([f.text, b": ", v.text]) }
    });
    {
      decoder: fs.decoder,
      text: bytes_concat_all([
        b"{..",
        b.text,
        if n.value > 0 { b", " } else { b"" },
        joined(fs.texts, b", "),
        b"}",
      ]),
    }
  } else if t.value == tag_e_field() {
    let b = parens(print_expr(printer, e, depth), is_base(e));
    let f = read_text(b.decoder);
    { decoder: f.decoder, text: bytes_concat_all([b.text, b".", f.text]) }
  } else if t.value == tag_e_list() {
    let n = read_count(e);
    let items = read_many(n.decoder, n.value, |g: Decoder| print_expr(printer, g, depth));
    { decoder: items.decoder, text: bytes_concat_all([b"[", joined(items.texts, b", "), b"]"]) }
  } else if t.value == tag_e_perform() {
    let eff = read_effect(printer, e);
    let op = read_text(eff.decoder);
    let r = read_opt(op.decoder, read_label);
    let n = read_count(r.decoder);
    let args = read_many(n.decoder, n.value, |g: Decoder| print_expr(printer, g, depth));
    {
      decoder: args.decoder,
      text: bytes_concat_all([
        eff.text,
        b".",
        op.text,
        bracketed(r),
        b"(",
        joined(args.texts, b", "),
        b")",
      ]),
    }
  } else if t.value == tag_e_handle() {
    let body = print_expr(printer, e, depth);
    let n = read_count(body.decoder);
    let clauses = read_many(n.decoder, n.value, |g: Decoder| {
      let eff = read_effect(printer, expect(g, tag_clause(), b"a handler clause"));
      let op = read_text(eff.decoder);
      let r = read_opt(op.decoder, read_label);
      let k: DecodedInt = read_binders(r.decoder);
      let bound = g.values + k.value;
      let resumed: DecodedOption = read_opt({ ..k.decoder, values: bound }, |h: Decoder|
        { decoder: h, text: bytes_concat(b" resume ", local_name(bound)) });
      let cb: Decoded = print_expr(
        printer,
        { ..resumed.decoder, values: if resumed.some { bound + 1 } else { bound } },
        inner,
      );
      {
        decoder: { ..cb.decoder, values: g.values },
        text: bytes_concat_all([
          line_break(inner),
          eff.text,
          b".",
          op.text,
          bracketed(r),
          b"(",
          joined(map(range(0, k.value), |i: Int| local_name(g.values + i)), b", "),
          b")",
          resumed.text,
          b" -> ",
          cb.text,
          b",",
        ]),
      }
    });
    let ret = read_opt(clauses.decoder, |g: Decoder| {
      let h: Decoder = expect(g, tag_return_clause(), b"a return clause");
      let rb: Decoded = print_expr(printer, { ..h, values: g.values + 1 }, inner);
      {
        decoder: { ..rb.decoder, values: g.values },
        text: bytes_concat_all([
          line_break(inner),
          b"return ",
          local_name(g.values),
          b" -> ",
          rb.text,
          b",",
        ]),
      }
    });
    {
      decoder: ret.decoder,
      text: bytes_concat_all([
        b"handle ",
        body.text,
        b" with {",
        bytes_concat_all(clauses.texts),
        ret.text,
        line_break(depth),
        b"}",
      ]),
    }
  } else if t.value == tag_e_with_cell() {
    let r = read_text(e);
    let init: Decoded = print_expr(printer, r.decoder, depth);
    let level = init.decoder.values;
    let body: Decoded = print_expr(printer, { ..init.decoder, values: level + 1 }, inner);
    {
      decoder: { ..body.decoder, values: level },
      text: bytes_concat_all([
        b"with_cell[",
        r.text,
        b"](",
        init.text,
        b") {",
        line_break(inner),
        local_name(level),
        b" -> ",
        body.text,
        line_break(depth),
        b"}",
      ]),
    }
  } else if t.value == tag_e_simulate() {
    let body = print_block(printer, e, depth);
    { decoder: body.decoder, text: bytes_concat(b"simulate ", body.text) }
  } else if t.value == tag_e_parallel() {
    let n = read_count(e);
    let branches = read_many(n.decoder, n.value, |g: Decoder| print_expr(printer, g, depth));
    {
      decoder: branches.decoder,
      text: bytes_concat_all([b"parallel { ", joined(branches.texts, b", "), b" }"]),
    }
  } else {
    panic(
      string_of_bytes(
        bytes_concat(b"a tag that does not begin an expression: ", int_to_bytes(t.value)),
      ),
    )
  }
}

fn print_stmt(printer: BodyPrinter, d: Decoder, depth: Int) -> Decoded / {abort.raise} = {
  let t = read_u8(d);
  if t.value == tag_s_let() {
    let ty = read_opt(t.decoder, |g: Decoder| print_type(printer, g));
    let v = print_expr(printer, ty.decoder, depth);
    let p = print_pat(printer, v.decoder);
    {
      decoder: p.decoder,
      text: bytes_concat_all([b"let ", p.text, prefixed(ty, b": "), b" = ", v.text, b";"]),
    }
  } else if t.value == tag_s_expr() {
    let g = print_expr(printer, t.decoder, depth);
    { decoder: g.decoder, text: bytes_concat(g.text, b";") }
  } else { panic("a tag that does not begin a statement") }
}

fn print_param_slot(printer: BodyPrinter, d: Decoder) -> Decoded / {abort.raise} = {
  let t = read_u8(d);
  if t.value == tag_none() { { decoder: t.decoder, text: b"" } } else if t.value == tag_some() {
    let ty = print_type(printer, t.decoder);
    { decoder: ty.decoder, text: bytes_concat(b": ", ty.text) }
  } else if t.value == tag_param_default() {
    let ty = read_opt(t.decoder, |g: Decoder| print_type(printer, g));
    let v = print_expr(printer, ty.decoder, 0);
    { decoder: v.decoder, text: bytes_concat_all([prefixed(ty, b": "), b" = ", v.text]) }
  } else { panic("a tag that does not open a parameter") }
}

fn print_constraint(d: Decoder) -> Decoded / {abort.raise} = {
  let l = read_u32(expect(d, tag_constraint(), b"a constraint"));
  let k = read_u8(l.decoder);
  match fold(constraint_kinds(), None, |acc: Option<Deriver>, deriver: Deriver|
      if deriver_byte(deriver) == k.value { Some(deriver) } else { acc }) {
    Some(d) -> { decoder: k.decoder, text: constraint_written(d, type_var_name(l.value)) },
    None -> panic("a byte that is not a deriver"),
  }
}

fn print_fn(printer: BodyPrinter, d: Decoder, name: Bytes) -> Decoded / {abort.raise} = {
  let tc = read_binders(expect(d, tag_fn(), b"a function"));
  let ec: DecodedInt = read_binders(tc.decoder);
  let lc: DecodedInt = read_binders(ec.decoder);
  let generics = if tc.value == 0 && ec.value == 0 && lc.value == 0 { b"" } else {
    bytes_concat_all([
      b"<",
      joined(
        append(
          map(range(0, tc.value), type_var_name),
          map(range(0, lc.value), |i: Int| bytes_concat_all([b"[", label_name(i), b"]"])),
        ),
        b", ",
      ),
      if ec.value > 0 { bytes_concat(b" | ", joined(map(range(0, ec.value), row_var_name), b", ")) }
      else { b"" },
      b">",
    ])
  };
  let n = read_count({ ..lc.decoder, types: tc.value, rows: ec.value, labels: lc.value });
  let ps = read_many(n.decoder, n.value, |g: Decoder| print_param_slot(printer, g));
  let ret = read_opt(ps.decoder, |g: Decoder| print_ret(printer, g));
  let row = read_opt(ret.decoder, |g: Decoder| print_row(printer, g));
  let cs = read_count(row.decoder);
  let derives: DecodedList = read_many(cs.decoder, cs.value, print_constraint);
  let scoped: Decoder = { ..derives.decoder, values: n.value };
  let measure: DecodedOption = if peek(scoped) != tag_decreases() {
    { decoder: scoped, text: b"", some: false }
  } else {
    let m = print_expr(printer, expect(scoped, tag_decreases(), b"a measure"), 0);
    { decoder: m.decoder, text: m.text, some: true }
  };
  let body = print_expr(printer, measure.decoder, 0);
  {
    decoder: body.decoder,
    text: bytes_concat_all([
      b"fn ",
      name,
      generics,
      b"(",
      joined(map(range(0, n.value), |i: Int| bytes_concat(local_name(i), at(ps.texts, i))), b", "),
      b")",
      prefixed(ret, b" -> "),
      prefixed(row, b" / "),
      if cs.value > 0 { bytes_concat(b" where ", joined(derives.texts, b", ")) } else { b"" },
      if measure.some { bytes_concat(b"\n  decreases ", measure.text) } else { b"" },
      b" =\n  ",
      body.text,
    ]),
  }
}

fn type_binders(count: Int) -> Bytes / {abort.raise} =
  if count > 0 {
    bytes_concat_all([b"<", joined(map(range(0, count), type_var_name), b", "), b">"])
  } else { b"" }

fn print_type_def(printer: BodyPrinter, d: Decoder, name: Bytes) -> Decoded / {abort.raise} = {
  let n: DecodedInt = read_binders(expect(d, tag_type(), b"a type"));
  let k = read_u8({ ..n.decoder, types: n.value });
  // Every variant keeps its `|`: a single-variant sum without one reads as an alias.
  let body: Decoded = if k.value == tag_type_alias() { print_type(printer, k.decoder) }
  else if k.value == tag_type_sum() {
    // The encoding carries the name the declaring program wrote; this printing uses the one it
    // was asked for, which a relink may have changed.
    let declared = read_text(k.decoder);
    let vn = read_count(declared.decoder);
    let vs = read_many(vn.decoder, vn.value, |g: Decoder| {
      let vname = read_text(expect(g, tag_variant(), b"a variant"));
      let fc = read_count(vname.decoder);
      let fs = read_many(fc.decoder, fc.value, |h: Decoder| print_type(printer, h));
      {
        decoder: fs.decoder,
        text: bytes_concat_all([
          b"| ",
          vname.text,
          if fc.value > 0 { bytes_concat_all([b"(", joined(fs.texts, b", "), b")"]) } else { b"" },
          b" ",
        ]),
      }
    });
    { decoder: vs.decoder, text: bytes_concat_all(vs.texts) }
  } else { panic("a tag that does not begin a type body") };
  {
    decoder: body.decoder,
    text: bytes_concat_all([b"type ", name, type_binders(n.value), b" = ", body.text]),
  }
}

fn print_effect(printer: BodyPrinter, d: Decoder, name: Bytes) -> Decoded / {abort.raise} = {
  // The encoding carries the name the declaring program wrote; this printing uses the one it was
  // asked for, which a relink may have changed.
  let declared = read_text(expect(d, tag_effect(), b"an effect"));
  let nd = read_bool(declared.decoder);
  let n = read_count(nd.decoder);
  let ops = read_many(n.decoder, n.value, |g: Decoder| {
    let op = read_text(expect(g, tag_op(), b"an operation"));
    let m = read_mode(op.decoder);
    let r = read_bool(m.decoder);
    let tc = read_binders(r.decoder);
    let pc = read_count({ ..tc.decoder, types: tc.value });
    let ps = read_many(pc.decoder, pc.value, |h: Decoder| print_type(printer, h));
    let ret = print_type(printer, ps.decoder);
    {
      decoder: { ..ret.decoder, types: g.types },
      text: bytes_concat_all([
        line_break(1),
        m.text,
        b" ",
        op.text,
        if r.value { b"[r]" } else { b"" },
        type_binders(tc.value),
        b"(",
        joined(ps.texts, b", "),
        b") -> ",
        ret.text,
      ]),
    }
  });
  {
    decoder: ops.decoder,
    text: bytes_concat_all([
      if nd.value { b"nondet " } else { b"" },
      b"effect ",
      name,
      b" {",
      bytes_concat_all(ops.texts),
      b"\n}",
    ]),
  }
}

// Everything is `pub`: visibility is metadata the encoding erased.
fn print_item(printer: BodyPrinter, decoder: Decoder, name: Bytes) -> Decoded / {abort.raise} = {
  let t = peek(decoder);
  let g = if t == tag_fn() { print_fn(printer, decoder, name) }
  else if t == tag_type() { print_type_def(printer, decoder, name) }
  else if t == tag_effect() { print_effect(printer, decoder, name) }
  else { panic("a tag that does not begin a definition") };
  if g.decoder.pos != bytes_len(g.decoder.bytes) { panic("bytes remain after the definition") }
  else { { decoder: g.decoder, text: bytes_concat(b"pub ", g.text) } }
}

fn print_test(printer: BodyPrinter, decoder: Decoder, label: Bytes) -> Decoded / {abort.raise} = {
  let nd = read_bool(expect(decoder, tag_test(), b"a test"));
  let body = print_block(printer, nd.decoder, 0);
  if body.decoder.pos != bytes_len(body.decoder.bytes) { panic("bytes remain after the test") }
  else {
    {
      decoder: body.decoder,
      text: bytes_concat_all([
        if nd.value { b"test/nondet " } else { b"test " },
        str_lit(label),
        b" ",
        body.text,
      ]),
    }
  }
}

type Named = { module: Bytes, simple: Bytes, public: Bool }
type Component = { members: List<Bytes>, hashes: List<Bytes>, id: Bytes, key: Bytes }
type Copied = { module: Bytes, names: List<Bytes>, public: List<Bool> }
type Parting = {
  seen: Map<Bytes, Bool>,
  declared: Map<Bytes, Bytes>,
  parts: List<Part>,
  bad: Option<Refusal>,
}
type Sheet = { items: List<Bytes>, imports: Map<Bytes, Bytes> }

fn refuse(message: Bytes, notes: List<Bytes>) -> Option<Refusal> =
  Some({ message: message, notes: notes })

fn comp_of(body: Bytes) -> Component / {abort.raise} = {
  let k = read_u8(cursor(body, map_new()));
  if k.value == 0 {
    let payload = bytes_slice(body, 1, bytes_len(body));
    let id = blake3(payload);
    { members: [payload], hashes: [id], id: id, key: id }
  } else if k.value == 1 {
    let class = read_u32(k.decoder);
    let payload = bytes_slice(body, 5, bytes_len(body));
    let c = read_count(cursor(payload, map_new()));
    let ms = read_many(c.decoder, c.value, read_text);
    if ms.decoder.pos != bytes_len(payload) || class.value >= c.value {
      panic("a malformed component body")
    } else {
      let id = blake3(payload);
      {
        members: ms.texts,
        hashes: map(range(0, c.value), |i: Int| member_hash(id, i)),
        id: id,
        key: member_hash(id, class.value),
      }
    }
  } else { panic("a stored body of a kind this build does not read") }
}

fn listed(ns: List<Named>) -> Bytes / {abort.raise} =
  backticked(map(ns, |n: Named| qualify(n.module, n.simple)), b", ")

fn named_of(
  names: List<{ name: Bytes, hash: Bytes, public: Bool }>,
  keys: Map<Bytes, Bool>,
) -> { named: Map<Bytes, Map<Bytes, Named>>, bad: Option<Refusal> } / {abort.raise} =
  fold(
    names,
    { named: map_new(), bad: None },
    |acc: { named: Map<Bytes, Map<Bytes, Named>>, bad: Option<Refusal> }, n: { name: Bytes, hash: Bytes, public: Bool }|
      match acc.bad {
        Some(_) -> acc,
        None -> {
          let simple = default_binder(n.name);
          if bytes_len(simple) == bytes_len(n.name) {
            { ..acc, bad: refuse(bytes_concat_all([b"`", n.name, b"` names no module"]), []) }
          } else if !map_contains(keys, n.hash) {
            { ..acc, bad: refuse(bytes_concat_all([b"`", n.name, b"` has no body"]), []) }
          } else {
            let module = bytes_slice(n.name, 0, bytes_len(n.name) - bytes_len(simple) - 1);
            let had = match map_get(acc.named, n.hash) { Some(m) -> m, None -> map_new() };
            {
              ..acc,
              named: map_insert(
                acc.named,
                n.hash,
                map_insert(had, bytes_concat_all([module, b"\x00", simple]), {
                  module: module,
                  simple: simple,
                  public: n.public,
                }),
              ),
            }
          }
        },
      },
  )

fn copies(classes: List<List<Named>>) -> Option<List<Copied>> / {abort.raise} =
  if len(classes) == 1 {
    Some(
      map(at(classes, 0), |n: Named| { module: n.module, names: [n.simple], public: [n.public] }),
    )
  } else {
    let by_module = fold(
      range(0, len(classes)),
      map_new(),
      |acc: Map<Bytes, List<List<Named>>>, c: Int|
        fold(at(classes, c), acc, |a: Map<Bytes, List<List<Named>>>, n: Named| {
          let rows = match map_get(a, n.module) {
            Some(r) -> r,
            None -> map(classes, |k: List<Named>| []),
          };
          map_insert(a, n.module, set_at(rows, c, push(at(rows, c), n)))
        }),
    );
    map_fold(by_module, Some([]), |acc: Option<List<Copied>>, m: Bytes, rows: List<List<Named>>|
      match acc {
        None -> None,
        Some(out) -> {
          let count = len(at(rows, 0));
          if fold(rows, false, |b: Bool, r: List<Named>| b || len(r) != count) { None } else {
            Some(
              fold(range(0, count), out, |o: List<Copied>, k: Int|
                push(o, {
                  module: m,
                  names: map(rows, |r: List<Named>| at(r, k).simple),
                  public: map(rows, |r: List<Named>| at(r, k).public),
                })),
            )
          }
        },
      })
  }

fn part_in(
  acc: Parting,
  component: Component,
  named: Map<Bytes, Map<Bytes, Named>>,
  shipped: List<Bytes>,
) -> Parting / {abort.raise} = {
  let classes = map(component.hashes, |h: Bytes|
    match map_get(named, h) { Some(m) -> map_values(m), None -> [] });
  let checked: Parting = fold(range(0, len(component.hashes)), acc, |a: Parting, i: Int|
    match a.bad {
      Some(_) -> a,
      None -> {
        let all = at(classes, i);
        let h = at(component.hashes, i);
        let kind = bytes_at(at(component.members, i), 0);
        if len(all) == 0 {
          {
            ..a,
            bad: refuse(bytes_concat_all([b"the body `", short_hex(h), b"` has no name"]), []),
          }
        }
        // Two modules declaring one effect alike declare one effect, so a body performing it cannot
        // be printed back under a name: either module's would be a different claim about what it does.
        else if kind == tag_effect() && len(all) > 1 {
          {
            ..a,
            bad: refuse(
              bytes_concat(
                listed(all),
                b" are one effect declaration, so a body cannot say which it performs",
              ),
              [b"make the declarations differ, or keep one of them"],
            ),
          }
        } else {
          fold(all, a, |b: Parting, n: Named| {
            let q = qualify(n.module, n.simple);
            let key = bytes_concat(byte_of(kind), q);
            match map_get(b.declared, key) {
              Some(other) -> if other == h || is_some(b.bad) { b } else {
                {
                  ..b,
                  bad: refuse(bytes_concat_all([b"`", q, b"` names two different definitions"]), [
                  ]),
                }
              },
              None -> { ..b, declared: map_insert(b.declared, key, h) },
            }
          })
        }
      },
    });
  match checked.bad {
    Some(_) -> checked,
    None -> match copies(classes) {
      None ->
        {
          ..checked,
          bad: refuse(
            bytes_concat(
              listed(fold(classes, [], |o: List<Named>, ns: List<Named>| append(o, ns))),
              b" are a mutually recursive group in which two definitions share one body, so a call cannot say which it reaches",
            ),
            [b"make the definitions differ, or keep one of them"],
          ),
        },
      Some(cs) ->
        {
          ..checked,
          parts: fold(cs, checked.parts, |ps: List<Part>, cp: Copied|
            push(ps, {
              members: component.members,
              hashes: component.hashes,
              names: cp.names,
              public: cp.public,
              module: cp.module,
              binder: default_binder(cp.module),
              printed: !contains_bytes(shipped, cp.module),
            })),
        },
    },
  }
}

fn is_some(o: Option<Refusal>) -> Bool = match o { Some(_) -> true, None -> false }

fn binders(modules: List<Bytes>) -> Map<Bytes, Bytes> / {abort.raise} = {
  let sharing = fold(modules, map_new(), |acc: Map<Bytes, Int>, m: Bytes|
    map_insert(
      acc,
      default_binder(m),
      1 + (match map_get(acc, default_binder(m)) { Some(k) -> k, None -> 0 }),
    ));
  let start = {
    taken: map_fold(sharing, map_new(), |acc: Map<Bytes, Bool>, b: Bytes, k: Int|
      map_insert(acc, b, true)),
    out: map_new(),
  };
  let done = fold(
    modules,
    start,
    |s: { taken: Map<Bytes, Bool>, out: Map<Bytes, Bytes> }, m: Bytes| {
      let own = default_binder(m);
      if match map_get(sharing, own) { Some(k) -> k == 1, None -> true } {
        { ..s, out: map_insert(s.out, m, own) }
      } else {
        let base = joined(bytes_split(m, b"."), b"_");
        let found = iterate(
          { n: 1, binder: base },
          2 * len(modules) + 2,
          |t: { n: Int, binder: Bytes }|
            if map_contains(s.taken, t.binder) {
              Continue({
                n: t.n + 1,
                binder: bytes_concat_all([base, b"_", int_to_bytes(t.n + 1)]),
              })
            } else { Stop(t) },
        );
        { taken: map_insert(s.taken, found.binder, true), out: map_insert(s.out, m, found.binder) }
      }
    },
  );
  done.out
}

fn layout_of(parts: List<Part>, relink: Map<Bytes, Bytes>) -> Layout / {abort.raise} = {
  let bound = binders(
    map_keys(
      fold(parts, map_new(), |acc: Map<Bytes, Bool>, part: Part|
        map_insert(acc, part.module, true)),
    ),
  );
  let placed = map(parts, |part: Part|
    { ..part, binder: match map_get(bound, part.module) { Some(b) -> b, None -> part.binder } });
  {
    parts: placed,
    by_hash: fold(range(0, len(placed)), map_new(), |acc: Map<Bytes, List<Slot>>, u: Int| {
      let hashes = at(placed, u).hashes;
      fold(range(0, len(hashes)), acc, |a: Map<Bytes, List<Slot>>, c: Int|
        map_insert(
          a,
          at(hashes, c),
          push(match map_get(a, at(hashes, c)) { Some(xs) -> xs, None -> [] }, {
            part: u,
            class: c,
          }),
        ))
    }),
    relink: relink,
  }
}

fn print_parts(
  layout: Layout,
) -> { modules: Map<Bytes, Sheet>, missing: Map<Bytes, Bool>, graph: Map<Bytes, List<Bytes>> } / {abort.raise} =
  fold(
    range(0, len(layout.parts)),
    { modules: map_new(), missing: map_new(), graph: map_new() },
    |acc: { modules: Map<Bytes, Sheet>, missing: Map<Bytes, Bool>, graph: Map<Bytes, List<Bytes>> }, u: Int| {
      let p = at(layout.parts, u);
      if !p.printed { acc } else {
        let x = { layout: layout, part: u, own: p.module, graph: acc.graph };
        let walked = fold(
          range(0, len(p.members)),
          { decoder: cursor(b"", acc.missing), texts: [] },
          |decoded: DecodedList, c: Int| {
            let g = print_item(
              x,
              {
                ..decoded.decoder,
                bytes: at(p.members, c),
                pos: 0,
                values: 0,
                types: 0,
                rows: 0,
                labels: 0,
              },
              at(p.names, c),
            );
            { decoder: g.decoder, texts: push(decoded.texts, g.text) }
          },
        );
        let had = match map_get(acc.modules, p.module) {
          Some(m) -> m,
          None -> { items: [], imports: map_new() },
        };
        let imports = map_merge(had.imports, map_remove(walked.decoder.imports, p.module));
        {
          modules: map_insert(acc.modules, p.module, {
            items: append(had.items, walked.texts),
            imports: imports,
          }),
          missing: walked.decoder.missing,
          graph: map_insert(acc.graph, p.module, map_keys(imports)),
        }
      }
    },
  )

fn print_tests(
  layout: Layout,
  g: Map<Bytes, List<Bytes>>,
  tests: List<Bytes>,
  missing: Map<Bytes, Bool>,
) -> DecodedList / {abort.raise} = {
  let x = { layout: layout, part: 0 - 1, own: b"", graph: g };
  fold(
    range(0, len(tests)),
    { decoder: cursor(b"", missing), texts: [] },
    |decoded: DecodedList, i: Int| {
      let body = at(tests, i);
      if bytes_len(body) == 0 || bytes_at(body, 0) != 0 {
        panic("a test body that is not a solo body")
      } else {
        let g = print_test(
          x,
          {
            ..decoded.decoder,
            bytes: bytes_slice(body, 1, bytes_len(body)),
            pos: 0,
            values: 0,
            types: 0,
            rows: 0,
            labels: 0,
            slots: map_new(),
          },
          bytes_concat(b"t", int_to_bytes(i)),
        );
        { decoder: g.decoder, texts: push(decoded.texts, g.text) }
      }
    },
  )
}

fn sheet_text(sheet: Sheet) -> Bytes / {abort.raise} =
  bytes_concat_all(
    append(
      map_fold(sheet.imports, [], |acc: List<Bytes>, m: Bytes, b: Bytes|
        push(
          acc,
          bytes_concat_all([
            b"import ",
            m,
            if b == default_binder(m) { b"" } else { bytes_concat(b" as ", b) },
            b"\n",
          ]),
        )),
      map(sheet.items, |it: Bytes| bytes_concat_all([b"\n", it, b"\n"])),
    ),
  )

// `public` is what the name's own module exports: a reference from a module that is printed reaches
// a shipped one only through it, so a name filed without it is never the one a reference is printed
// under.
pub fn print_bodies(
  bodies: List<Bytes>,
  names: List<{ name: Bytes, hash: Bytes, public: Bool }>,
  tests: List<Bytes>,
  relink: List<{ from: Bytes, to: Bytes }>,
  shipped: List<Bytes>,
) -> Printing / {abort.raise} = {
  let comps = map(bodies, comp_of);
  let n = named_of(
    names,
    fold(comps, map_new(), |acc: Map<Bytes, Bool>, component: Component|
      map_insert(acc, component.key, true)),
  );
  let parted: Parting = match n.bad {
    Some(_) -> { seen: map_new(), declared: map_new(), parts: [], bad: n.bad },
    None ->
      fold(
        comps,
        { seen: map_new(), declared: map_new(), parts: [], bad: None },
        |acc: Parting, component: Component|
          if is_some(acc.bad) || map_contains(acc.seen, component.id) { acc } else {
            part_in(
              { ..acc, seen: map_insert(acc.seen, component.id, true) },
              component,
              n.named,
              shipped,
            )
          },
      ),
  };
  match parted.bad {
    Some(r) -> Unprintable(r),
    None -> {
      let l = layout_of(
        parted.parts,
        fold(relink, map_new(), |acc: Map<Bytes, Bytes>, r: { from: Bytes, to: Bytes }|
          map_insert(acc, r.from, r.to)),
      );
      let printed = print_parts(l);
      let t = print_tests(l, printed.graph, tests, printed.missing);
      let missing = map_keys(t.decoder.missing);
      if len(missing) > 0 {
        Unprintable({
          message: bytes_concat(
            int_to_bytes(len(missing)),
            b" definitions a body refers to are not among the bodies it can name",
          ),
          notes: [
            bytes_concat(
              b"missing: ",
              joined(map(take(missing, min(8, len(missing))), short_hex), b", "),
            ),
          ],
        })
      } else {
        let texts = map_fold(
          printed.modules,
          [],
          |acc: List<{ module: Bytes, text: Bytes }>, m: Bytes, sheet: Sheet|
            push(acc, { module: m, text: sheet_text(sheet) }),
        );
        Printed(if len(tests) == 0 { texts } else {
          push(texts, {
            module: b"ply_tests",
            text: sheet_text({ items: t.texts, imports: t.decoder.imports }),
          })
        })
      }
    },
  }
}

// --- Tests ------------------------------------------------------------------

test "the little-endian encoders write what the reference writes" {
  assert_eq(u32_le(1), b"\x01\x00\x00\x00");
  assert_eq(u32_le(0x01020304), b"\x04\x03\x02\x01");
  assert_eq(i64_le(0 - 1), b"\xff\xff\xff\xff\xff\xff\xff\xff");
  assert_eq(hex(b"\x00\xab\xff"), b"00abff");
  assert_eq(
    i128_le_of_digits(b"256"),
    b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
  )
}

test "a float literal is read as its correctly rounded bit pattern" {
  assert_eq(float_bits(b"1.5"), 0x3FF8000000000000);
  assert_eq(float_bits(b"1e2"), bits_of_float(100.0));
  assert_eq(float_bits(b"2.5e-1"), bits_of_float(0.25));
  assert_eq(float_bits(b"1.0e300"), 0x7E37E43C8800759C);
  assert_eq(float_bits(b"1.0e-30"), 0x39B4484BFEEBC2A0);
  let parts = decimal_parts(b"1.50m");
  assert_eq(parts.scale, 2);
  assert_eq(bytes_at(parts.mantissa, 0), 150)
}

// The hash a dump files `name` under.
fn dumped_hash(dump: String, name: Bytes) -> Bytes / {abort.raise} = {
  let d = bytes_of_string(dump);
  let key = bytes_concat_all([b"H;", name, b";"]);
  let start = match bytes_index_of(d, key) {
    Some(i) -> i + bytes_len(key),
    None -> panic("the dump names the definition"),
  };
  bytes_slice(d, start, start + 64)
}

// `text` with every `from` written as `to`.
fn swapped(text: Bytes, from: Bytes, to: Bytes) -> Bytes / {abort.raise} =
  match bytes_index_of(text, from) {
    None -> text,
    Some(i) ->
      bytes_concat_all([
        bytes_slice(text, 0, i),
        to,
        swapped(bytes_slice(text, i + bytes_len(from), bytes_len(text)), from, to),
      ]),
  }

fn primed_m(changed: Bytes) -> Source =
  {
    name: b"m",
    src: bytes_concat(
      b"pub effect log { write emit(Bytes) -> Unit }\npub type Pair = { a: Int, b: Int }\nderive eq for Pair\nfn helper(x: Int) -> Int = x * 2\npub fn one() -> Int = 1\npub fn two(x: Int) -> Int requires x >= 0 ensures result > x = helper(x) + one()\npub fn even(n: Int) -> Bool = if n == 0 { true } else { odd(n - 1) }\npub fn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\ntest \"two adds\" { assert_eq(two(1), 3) }\nlaw \"doubling\" forall (x: Int) { helper(x) == x + x }\n",
      changed,
    ),
  }

fn primed_n(changed: Bytes) -> Source =
  {
    name: b"n",
    src: bytes_concat(
      b"import m (one, two, even, say, log, Pair)\npub fn four() -> Int = two(two(one()))\npub fn pair() -> Pair = { a: one(), b: four() }\nfn hi() -> Unit / { log.write } = say(b\"hi\")\ntest \"four\" { assert_eq(four(), 7) }\n",
      changed,
    ),
  }

fn primed_base() -> List<Source> =
  [
    primed_m(b"pub fn odd(n: Int) -> Bool = if n == 0 { false } else { even(n - 1) }\n"),
    primed_n(b"pub fn parity() -> Bool = even(4)\n"),
  ]

// Each a program that differs from the base where a run of it would.
fn primed_variants() -> List<List<Source>> / {abort.raise} =
  [
    primed_base(),
    [
      primed_m(b"pub fn odd(n: Int) -> Bool = if n == 0 { false } else { even(n - 1) && true }\n"),
      primed_n(b"pub fn parity() -> Bool = even(4)\n"),
    ],
    [
      { name: b"m", src: swapped(at(primed_base(), 0).src, b"x * 2", b"x * 3") },
      at(primed_base(), 1),
    ],
    [
      { name: b"m", src: swapped(at(primed_base(), 0).src, b"requires x >= 0", b"requires x > 0") },
      at(primed_base(), 1),
    ],
    [
      primed_m(
        b"pub fn odd(n: Int) -> Bool = if n == 0 { false } else { even(n - 1) }\npub fn three() -> Int = 3\n",
      ),
      {
        name: b"n",
        src: swapped(at(primed_base(), 1).src, b"two(two(one()))", b"two(two(three()))"),
      },
    ],
    [at(primed_base(), 0), primed_n(b"")],
    [
      { name: b"m", src: swapped(at(primed_base(), 0).src, b"helper", b"assist") },
      at(primed_base(), 1),
    ],
    [
      { name: b"m", src: swapped(at(primed_base(), 0).src, b"b: Int }", b"b: Int, c: Int }") },
      { name: b"n", src: swapped(at(primed_base(), 1).src, b"b: four() }", b"b: four(), c: 0 }") },
    ],
    [
      {
        name: b"m",
        src: swapped(
          at(primed_base(), 0).src,
          b"emit(Bytes) -> Unit }",
          b"emit(Bytes) -> Unit\n  write flush() -> Unit }",
        ),
      },
      at(primed_base(), 1),
    ],
  ]

fn primed_as_fresh(
  before: List<Source>,
  after: List<Source>,
  packages: List<Int>,
) -> Bool / {abort.raise} = {
  let priors = hash_index_pinned(indexed(before), [], packages).priors;
  let fresh = hash_index_pinned(indexed(after), [], packages);
  hash_index_pinned(indexed(after), [], packages, priors) == fresh
}

test "a run over an earlier run's priors hashes what a run from nothing does" {
  let variants = primed_variants();
  fold(variants, (), |_: Unit, before: List<Source>|
    fold(variants, (), |_: Unit, after: List<Source>| {
      assert(primed_as_fresh(before, after, []));
      // Across a package line, where a reference reads as the other package's contract.
      assert(primed_as_fresh(before, after, [1, 0]))
    }));
  // Priors of a program whose names all moved stand for nothing in this one.
  let renamed = map(primed_base(), |s: Source|
    { name: s.name, src: swapped(s.src, b"one", b"uno") });
  assert(primed_as_fresh(renamed, primed_base(), []))
}

test "a run of an unchanged program takes every node from its priors" {
  let index = indexed(primed_base());
  let priors = hash_index_pinned(index, []).priors;
  let first = first_pass(index);
  let g = graph_with(index, first, map_new());
  let sketches = map(range(0, len(index.nodes)), |v: Int| sketched(index, first, [], map_new(), v));
  assert_eq(map_len(standing_priors(index, g, map_new(), sketches, priors)), len(index.nodes));
  assert_eq(len(priors), len(index.nodes))
}

test "renaming a definition does not move its hash, and a change to a callee does" {
  let a = hash_dump([
    { name: b"m", src: b"fn helper(x: Int) -> Int = x + 1\nfn f() -> Int = helper(1)" },
  ]);
  let b = hash_dump([
    { name: b"m", src: b"fn aide(x: Int) -> Int = x + 1\nfn f() -> Int = aide(1)" },
  ]);
  let c = hash_dump([
    { name: b"m", src: b"fn helper(x: Int) -> Int = x + 2\nfn f() -> Int = helper(1)" },
  ]);
  assert_eq(dumped_hash(a, b"m.helper"), dumped_hash(b, b"m.aide"));
  assert_eq(dumped_hash(a, b"m.f"), dumped_hash(b, b"m.f"));
  assert(dumped_hash(a, b"m.f") != dumped_hash(c, b"m.f"))
}

test "an interpolated string hashes as the concatenation it stands for" {
  let shown = { name: b"std.show", src: b"pub fn display<a>(x: a) -> String = \"\"" };
  let a = hash_dump([shown, { name: b"m", src: b"fn f(x: Int) -> String = f\"a {x} b\"" }]);
  let b = hash_dump([
    shown,
    {
      name: b"m",
      src: b"import std.show\nfn f(x: Int) -> String = \"a \" ++ show::display(x) ++ \" b\"",
    },
  ]);
  assert_eq(dumped_hash(a, b"m.f"), dumped_hash(b, b"m.f"))
}

test "a record update of another module's record hashes stably, and follows that module's type" {
  let app = b"import shapes\npub fn bumped() -> shapes::P = { let p = shapes::mk(); {..p, a: 3} }";
  let narrow = [
    { name: b"shapes", src: b"pub type P = { a: Int, b: Int }\npub fn mk() -> P = { a: 1, b: 2 }" },
    { name: b"app", src: app },
  ];
  let wide = [
    {
      name: b"shapes",
      src: b"pub type P = { a: Int, b: Int, c: Int }\npub fn mk() -> P = { a: 1, b: 2, c: 3 }",
    },
    { name: b"app", src: app },
  ];
  assert_eq(
    dumped_hash(hash_dump(narrow), b"app.bumped"),
    dumped_hash(hash_dump(narrow), b"app.bumped"),
  );
  // The update means whatever the foreign record is, so a field added there moves this hash.
  assert(
    dumped_hash(hash_dump(narrow), b"app.bumped") != dumped_hash(hash_dump(wide), b"app.bumped"),
  );
  let out = hash_index(indexed(narrow));
  let ms = printed_of(out, []);
  assert(holds_text(at(ms, 0).text, b"{.."));
  let again = hash_index(
    indexed(map(ms, |m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "a mutually recursive pair hashes as one component with two members" {
  let d = bytes_of_string(
    hash_dump([
      {
        name: b"m",
        src: b"fn even(n: Int) -> Bool = if n == 0 { true } else { odd(n - 1) }\nfn odd(n: Int) -> Bool = if n == 0 { false } else { even(n - 1) }",
      },
    ]),
  );
  assert(match bytes_index_of(d, b"C;m.even;m.even,m.odd;") { Some(_) -> true, None -> false });
  assert(match bytes_index_of(d, b"C;m.odd;m.even,m.odd;") { Some(_) -> true, None -> false })
}

test "a literal is spelled so it reads back to its bits" {
  assert_eq(float_text(bits_of_float(0.1)), b"0.1");
  assert_eq(float_text(bits_of_float(100.0)), b"100.0");
  assert_eq(float_text(bits_of_float(1e300)), b"1e300");
  assert_eq(float_text(bits_of_float(1.5e-7)), b"1.5e-7");
  assert_eq(float_text(1), b"5e-324");
  assert_eq(float_text(0x8000000000000000), b"-0.0");
  assert_eq(decimal_text(i128_le_of_digits(b"50"), 3), b"0.050m");
  assert_eq(
    decimal_text(i128_le_of_digits(b"79228162514264337593543950335"), 0),
    b"79228162514264337593543950335m",
  );
  assert_eq(int_text(0 - 1), b"0xffffffffffffffff");
  assert_eq(fixed_text(4, 0 - 1), b"0xffi8");
  assert_eq(wide_text(8, 1, 0), b"18446744073709551616u128");
  assert_eq(wide_text(9, 0 - 1, 5), b"0xffffffffffffffff0000000000000005i128");
  assert_eq(bytes_lit(b"\x00\"q\xff"), b"b\"\\0\\\"q\\xff\"")
}

fn indexed(sources: List<Source>) -> Index / {abort.raise} =
  match resolve_modules(
      map(range(0, len(sources)), |i: Int| {
        let r = parse(at(sources, i).src);
        let d: Expansion = expand_derives(
          i,
          at(sources, i).name,
          expand(r.node, r.parser.diags).module,
        );
        { name: at(sources, i).name, module: d.module, derived: d.derived }
      }),
    ) {
    ResolveFailed(_) -> panic("the fixture resolves"),
    ResolveSucceeded(x) -> build_index(x.mods, x.r).index,
  }

fn named_hashes(out: HashOutput) -> List<{ name: Bytes, hash: Bytes }> = append(out.defs, out.decls)

fn one_set(names: List<Bytes>) -> Map<Bytes, Bool> =
  fold(names, map_new(), |acc: Map<Bytes, Bool>, n: Bytes| map_insert(acc, n, true))

test "a closure is what a name reaches, the name included, and a test's what the test references" {
  let h = hash_index(
    indexed([
      {
        name: b"m",
        src: b"pub fn leaf() -> Int = 1\npub fn mid() -> Int = leaf()\npub fn top() -> Int = mid()\npub fn other() -> Int = 2\ntest \"it\" { assert_eq(top(), 1) }",
      },
    ]),
  );
  assert_eq(map_keys(closure_of(h, [b"m.mid"])), [b"m.leaf", b"m.mid"]);
  assert_eq(map_keys(closure_of(h, [b"m.it"])), [b"m.it", b"m.leaf", b"m.mid", b"m.top"]);
  assert_eq(map_keys(closure_of(h, [b"m.mid", b"m.other"])), [b"m.leaf", b"m.mid", b"m.other"]);
  assert_eq(closure_of(h, [b"m.nothing"]), map_new());
  assert_eq(map_keys(reaching(h, one_set([b"m.leaf"]))), [b"m.it", b"m.leaf", b"m.mid", b"m.top"]);
  assert_eq(map_keys(reaching(h, one_set([b"m.other"]))), [b"m.other"])
}

// A function and an effect may share a name: the name reaches what either does, and a reference to
// one reaches only what that one does.
test "a reference reaches through the node it names, and a shared name through both" {
  let h = hash_index(
    indexed([
      {
        name: b"m",
        src: b"effect log { write emit(Bytes) -> Unit }\npub fn log() -> Int = helper()\nfn helper() -> Int = 1\npub fn user(b: Bytes) -> Unit / {log.write} = log.emit(b)",
      },
    ]),
  );
  assert_eq(map_keys(closure_of(h, [b"m.user"])), [b"m.log", b"m.user"]);
  assert_eq(map_keys(closure_of(h, [b"m.log"])), [b"m.helper", b"m.log"]);
  assert_eq(map_keys(reaching(h, one_set([b"m.helper"]))), [b"m.helper", b"m.log"])
}

// The fixtures below write `pub` throughout, so every name is one a reference may be printed under.
fn all_public(
  xs: List<{ name: Bytes, hash: Bytes }>,
) -> List<{ name: Bytes, hash: Bytes, public: Bool }> =
  map(xs, |x: { name: Bytes, hash: Bytes }| { name: x.name, hash: x.hash, public: true })

fn by_name(xs: List<{ name: Bytes, hash: Bytes }>) -> Map<Bytes, Bytes> =
  fold(xs, map_new(), |m: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
    map_insert(m, x.name, x.hash))

fn printed_of(
  out: HashOutput,
  shipped: List<Bytes>,
) -> List<{ module: Bytes, text: Bytes }> / {abort.raise} =
  match print_bodies(
      map(out.bodies, |b: { name: Bytes, body: Bytes }| b.body),
      all_public(named_hashes(out)),
      [],
      [],
      shipped,
    ) {
    Printed(ms) -> ms,
    Unprintable(why) -> panic(string_of_bytes(why.message)),
  }

fn holds_text(text: Bytes, part: Bytes) -> Bool =
  match bytes_index_of(text, part) { Some(_) -> true, None -> false }

test "a stated measure moves a definition's hash, and prints back to what it was stored under" {
  let src = b"fn f(n: Int) -> Int decreases n = if n <= 0 { 0 } else { f(n - 1) }";
  let plain = hash_dump([
    { name: b"m", src: b"fn f(n: Int) -> Int = if n <= 0 { 0 } else { f(n - 1) }" },
  ]);
  let measured = hash_dump([{ name: b"m", src: src }]);
  assert(dumped_hash(plain, b"m.f") != dumped_hash(measured, b"m.f"));
  let out = hash_index(indexed([{ name: b"m", src: src }]));
  let ms = printed_of(out, []);
  assert(holds_text(at(ms, 0).text, b"decreases"));
  let again = hash_index(
    indexed(map(ms, |m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "printed bodies hash back to what they were stored under, under their own names" {
  let out = hash_index(
    indexed([
      {
        name: b"left.util",
        src: b"pub type Shape = | Dot | Line(Int)\npub fn size(s: Shape) -> Int = match s { Dot -> 0, Line(n) -> n }",
      },
      {
        name: b"right.util",
        src: b"pub fn big() -> Float = 0.1 + 1e300\npub fn tiny() -> Decimal = 0.050m\npub fn raw() -> Bytes = b\"\\x00\\\"q\"",
      },
      {
        name: b"app",
        src: b"import left.util as l\nfn even(n: Int) -> Bool = if n == 0 { true } else { odd(n - 1) }\nfn odd(n: Int) -> Bool = if n == 0 { false } else { even(n - 1) }\nfn all() -> Int = l::size(l::Line(0xFFFFFFFFFFFFFFFF)) + (match 255u8 { _ -> 1 })",
      },
    ]),
  );
  let ms = printed_of(out, []);
  assert_eq(map(ms, |m: { module: Bytes, text: Bytes }| m.module), [
    b"app",
    b"left.util",
    b"right.util",
  ]);
  assert(holds_text(at(ms, 0).text, b"import left.util as left_util\n"));
  let again = hash_index(
    indexed(map(ms, |m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)));
  let shipped = printed_of(out, [b"left.util"]);
  assert_eq(map(shipped, |m: { module: Bytes, text: Bytes }| m.module), [b"app", b"right.util"])
}

test "every deriver a constraint names prints back and hashes back to what it was stored under" {
  let out = hash_index(
    indexed([
      {
        name: b"app",
        src: b"pub fn j<a>(x: a) -> a where derivable(json, a) = x\npub fn e<a>(x: a) -> a where derivable(eq, a) = x\npub fn o<a>(x: a) -> a where derivable(ord, a) = x\npub fn b<a>(x: a) -> a where derivable(bin, a) = x\npub fn s<a>(x: a) -> a where derivable(show, a) = x",
      },
    ]),
  );
  let ms = printed_of(out, []);
  assert(holds_text(at(ms, 0).text, b"derivable(bin, "));
  assert(holds_text(at(ms, 0).text, b"derivable(show, "));
  let again = hash_index(
    indexed(map(ms, |m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "a parallel block prints back as written and hashes back to what it was stored under" {
  let out = hash_index(
    indexed([
      { name: b"app", src: b"pub fn both(n: Int) -> (Int, Bool) = parallel { n + 1, n > 0 }" },
    ]),
  );
  let ms = printed_of(out, []);
  assert(holds_text(at(ms, 0).text, b"parallel { "));
  let again = hash_index(
    indexed(map(ms, |m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "a reference is printed under a name the module holding it exports" {
  // One body under two names, in modules that ship rather than print: which name a reference is
  // printed under is a choice, and only one of them is a name another module may write.
  let out = hash_index(
    indexed([
      { name: b"hidden", src: b"fn span() -> Int = 4\npub fn stride() -> Int = span() + 1" },
      { name: b"shelf", src: b"pub fn width() -> Int = 4" },
      { name: b"app", src: b"import shelf\npub fn wide() -> Int = shelf::width()" },
    ]),
  );
  let named = by_name(named_hashes(out));
  assert_eq(map_get(named, b"shelf.width"), map_get(named, b"hidden.span"));
  let names = map(named_hashes(out), |x: { name: Bytes, hash: Bytes }|
    { name: x.name, hash: x.hash, public: x.name != b"hidden.span" });
  match print_bodies(map(out.bodies, |b: { name: Bytes, body: Bytes }| b.body), names, [], [], [
      b"hidden",
      b"shelf",
    ]) {
    Unprintable(why) -> panic(string_of_bytes(why.message)),
    Printed(ms) -> {
      assert_eq(map(ms, |m: { module: Bytes, text: Bytes }| m.module), [b"app"]);
      assert(holds_text(at(ms, 0).text, b"shelf::width()"));
      assert(!holds_text(at(ms, 0).text, b"hidden::"))
    },
  }
}

test "an operation atom hashes apart from its mode atom and prints back as written" {
  let src = |access: Bytes|
    bytes_concat_all([
      b"pub effect net { write send[c](x: Int) -> Int }\npub fn f() -> Int / {net.",
      access,
      b"[conn]} = 1",
    ]);
  let hash_of = |out: HashOutput| {
    match map_get(by_name(named_hashes(out)), b"m.f") {
      Some(h) -> h,
      None -> panic("the index names f"),
    }
  };
  let out = hash_index(indexed([{ name: b"m", src: src(b"send") }]));
  let ms = printed_of(out, []);
  assert(holds_text(at(ms, 0).text, b"net.send[conn]"));
  let again = hash_index(indexed([{ name: b"m", src: at(ms, 0).text }]));
  assert_eq(hash_of(again), hash_of(out));
  assert(hash_of(out) != hash_of(hash_index(indexed([{ name: b"m", src: src(b"write") }]))))
}

test "renaming a label binder does not move a hash, and renaming a real resource does" {
  let bound = |label: Bytes|
    bytes_concat_all([
      b"pub effect net { write send[c](x: Int) -> Int }\n",
      b"pub fn relay<[",
      label,
      b"]>(x: Int) -> Int / {net.send[",
      label,
      b"]} = net.send[",
      label,
      b"](x)\n",
      b"pub fn outer<[",
      label,
      b"]>(x: Int) -> Int / {net.send[",
      label,
      b"]} = relay[",
      label,
      b"](x)\n",
      b"pub fn caught<[",
      label,
      b"]>(x: Int) -> Int = handle { relay[",
      label,
      b"](x) } with { net.send[",
      label,
      b"](n) -> n }",
    ]);
  let loose = |res: Bytes|
    bytes_concat_all([
      b"pub effect net { write send[c](x: Int) -> Int }\n",
      b"pub fn relay(x: Int) -> Int / {net.send[",
      res,
      b"]} = net.send[",
      res,
      b"](x)",
    ]);
  let hash_of = |src: Bytes, name: Bytes| {
    let out = hash_index(indexed([{ name: b"m", src: src }]));
    match map_get(by_name(named_hashes(out)), name) {
      Some(h) -> h,
      None -> panic("the index names the definition"),
    }
  };
  assert_eq(hash_of(bound(b"l"), b"m.relay"), hash_of(bound(b"k"), b"m.relay"));
  assert_eq(hash_of(bound(b"l"), b"m.outer"), hash_of(bound(b"k"), b"m.outer"));
  assert_eq(hash_of(bound(b"l"), b"m.caught"), hash_of(bound(b"k"), b"m.caught"));
  assert(hash_of(loose(b"conn"), b"m.relay") != hash_of(loose(b"sock"), b"m.relay"));
  assert(hash_of(bound(b"l"), b"m.relay") != hash_of(loose(b"l"), b"m.relay"))
}

test "a label binder, the resources it names and the labels a call fills print back under their levels" {
  let out = hash_index(
    indexed([
      {
        name: b"m",
        src: bytes_concat_all([
          b"pub effect net { write send[c](x: Int) -> Int }\n",
          b"pub fn relay<[l]>(x: Int) -> Int / {net.send[l]} = net.send[l](x)\n",
          b"pub fn outer<[l]>(x: Int) -> Int / {net.send[l]} = relay[l](x)\n",
          b"pub fn caught<[l]>(x: Int) -> Int = handle { relay[l](x) } with { net.send[l](n) -> n }\n",
          b"pub fn plain(x: Int) -> Int / {net.send[conn]} = relay[conn](x)",
        ]),
      },
    ]),
  );
  let ms = printed_of(out, []);
  assert(holds_text(at(ms, 0).text, b"fn relay<[_r0]>"));
  assert(holds_text(at(ms, 0).text, b"/ {net.send[_r0]}"));
  assert(holds_text(at(ms, 0).text, b"net.send[_r0](_l0)"));
  assert(holds_text(at(ms, 0).text, b"relay[_r0](_l0)"));
  assert(holds_text(at(ms, 0).text, b"net.send[_r0](_l1) -> _l1"));
  assert(holds_text(at(ms, 0).text, b"/ {net.send[conn]}"));
  assert(holds_text(at(ms, 0).text, b"relay[conn](_l0)"));
  let again = hash_index(
    indexed(map(ms, |m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text })),
  );
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "renaming an operation's type parameter does not move a hash, and it prints back bound" {
  let boxed = |v: Bytes|
    bytes_concat_all([
      b"pub effect box { read take[k]<",
      v,
      b">(xs: List<",
      v,
      b">) -> ",
      v,
      b" }",
    ]);
  let out = hash_index(indexed([{ name: b"m", src: boxed(b"a") }]));
  let renamed = hash_index(indexed([{ name: b"m", src: boxed(b"b") }]));
  assert_eq(by_name(named_hashes(renamed)), by_name(named_hashes(out)));
  let ms = printed_of(out, []);
  assert(holds_text(at(ms, 0).text, b"read take[r]<_t0>(List<_t0>) -> _t0"));
  let again = hash_index(indexed([{ name: b"m", src: at(ms, 0).text }]));
  assert_eq(by_name(named_hashes(again)), by_name(named_hashes(out)))
}

test "two effects that differ only in their names are two declarations" {
  let out = hash_index(
    indexed([
      { name: b"a", src: b"pub effect one { read at() -> Int }" },
      { name: b"b", src: b"pub effect two { read at() -> Int }" },
    ]),
  );
  let named = by_name(named_hashes(out));
  // Nominal: the shapes match, so only the names tell the two apart, and a hash has to.
  assert(map_get(named, b"a.one") != None);
  assert(map_get(named, b"a.one") != map_get(named, b"b.two"))
}

test "one effect declaration under two names is refused, since a body cannot say which it performs" {
  // One simple name in two modules: a module path is no part of an identity, so this is a single
  // declaration, and naming it twice leaves a body that performs it with no name to be printed under.
  let out = hash_index(
    indexed([
      { name: b"a", src: b"pub effect one { read at() -> Int }" },
      { name: b"b", src: b"pub effect one { read at() -> Int }" },
    ]),
  );
  let named = by_name(named_hashes(out));
  assert_eq(map_get(named, b"a.one"), map_get(named, b"b.one"));
  match print_bodies(
      map(out.bodies, |b: { name: Bytes, body: Bytes }| b.body),
      all_public(named_hashes(out)),
      [],
      [],
      [],
    ) {
    Printed(_) -> panic("two names for one declaration must be refused"),
    Unprintable(why) ->
      assert_eq(
        why.message,
        b"`a.one`, `b.one` are one effect declaration, so a body cannot say which it performs",
      ),
  }
}

test "two sums that differ only in their names are two declarations, and one sum in two modules is one" {
  let apart = hash_index(
    indexed([
      { name: b"a", src: b"pub type One = | Wrap(Int)" },
      { name: b"b", src: b"pub type Two = | Wrap(Int)" },
    ]),
  );
  let named = by_name(named_hashes(apart));
  // `unify_structural` compares a `TyCon` by name, so a hash that ignored it would call two types
  // the checker refuses to unify one type.
  assert(map_get(named, b"a.One") != None);
  assert(map_get(named, b"a.One") != map_get(named, b"b.Two"));
  // The module path is no part of it, so the same declaration in two places is one declaration.
  let together = by_name(
    named_hashes(
      hash_index(
        indexed([
          { name: b"a", src: b"pub type One = | Wrap(Int)" },
          { name: b"b", src: b"pub type One = | Wrap(Int)" },
        ]),
      ),
    ),
  );
  assert_eq(map_get(together, b"a.One"), map_get(together, b"b.One"))
}

test "an alias is transparent, so its name is no part of it" {
  let m = |src: Bytes| by_name(named_hashes(hash_index(indexed([{ name: b"m", src: src }]))));
  // `conv_type` expands an alias in place, so these two declare one type and use it alike.
  let metres = m(b"pub type Metres = Int\npub fn go(x: Metres) -> Metres = x");
  let feet = m(b"pub type Feet = Int\npub fn go(x: Feet) -> Feet = x");
  assert_eq(map_get(metres, b"m.Metres"), map_get(feet, b"m.Feet"));
  assert_eq(map_get(metres, b"m.go"), map_get(feet, b"m.go"));
  // A record alias is structural in the checker too, so naming one differently changes no use of it.
  let as_p = m(b"pub type P = { a: Int }\npub fn mk() -> P = { a: 1 }");
  let as_q = m(b"pub type Q = { a: Int }\npub fn mk() -> Q = { a: 1 }");
  assert_eq(map_get(as_p, b"m.mk"), map_get(as_q, b"m.mk"))
}

test "a definition's hash follows the name of the effect it performs" {
  let one = hash_index(
    indexed([
      {
        name: b"m",
        src: b"pub effect log { write put() -> Unit }\npub fn say() -> Unit / {log.write} = log.put()",
      },
    ]),
  );
  let other = hash_index(
    indexed([
      {
        name: b"m",
        src: b"pub effect trace { write put() -> Unit }\npub fn say() -> Unit / {trace.write} = trace.put()",
      },
    ]),
  );
  // The row `say` publishes names its effect, so a hash that ignored the name would not pin the row.
  assert(
    map_get(by_name(named_hashes(one)), b"m.say")
      != map_get(by_name(named_hashes(other)), b"m.say"),
  )
}

// Pinned, so a framing change fails here rather than silently moving the digests a warm cache
// keys on.
test "the published hashes digest to a pinned value" {
  let h = |v: Int| bytes_concat_all(map(range(0, 32), |i: Int| byte_of(v)));
  let sample: HashOutput = {
    ..no_hashes(),
    defs: [{ name: b"a", hash: h(1) }],
    decls: [{ name: b"b", hash: h(2) }],
    tests: [h(5)],
    laws: [h(6)],
    specs: [{ name: b"a", hashes: [h(3), h(4)] }],
  };
  assert_eq(
    hex(digest(sample)),
    b"ac9e5970a91b7f3d7f83d63ec7ce2f66789c1204021e9ab1357f24a9878f07a8",
  );
  // One more hash is a different digest, so a unit keyed on it is not reused.
  let grown = { ..sample, tests: append(sample.tests, [h(7)]) };
  assert(digest(grown) != digest(sample))
}

test "a stored body is keyed by its own bytes, and bytes no envelope holds by nothing" {
  assert_eq(body_key(solo_body(b"abc")), Some(blake3(b"abc")));
  assert_eq(body_key(member_body(b"xyz", 2)), Some(member_hash(blake3(b"xyz"), 2)));
  assert_eq(body_key(b""), None);
  assert_eq(body_key(b"\x07rest"), None);
  assert_eq(body_key(b"\x01\x00"), None)
}

test "a call that leaves an argument to a default naming what its module keeps hashes as one that writes it" {
  let left = b"fn triple(x: Int) -> Int = x * 3\nfn inner(x: Int, f: (Int) -> Int = triple) -> Int = f(x)\nfn caller() -> Int = inner(1)";
  let written = swapped(left, b"inner(1)", b"inner(1, triple)");
  assert_eq(
    dumped_hash(hash_dump([{ name: b"m", src: left }]), b"m.caller"),
    dumped_hash(hash_dump([{ name: b"m", src: written }]), b"m.caller"),
  )
}
