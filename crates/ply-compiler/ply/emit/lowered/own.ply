//! The ownership pass and the check over forms the lowering writes from program text.

import emit.compare (program_of, formed)
import emit.own (owned)
import emit.verify (verified)

test "a lowered body that holds no count is left as it was, and passes the check" {
  let src = Bytes::concat_all([
    b"fn total(n: Int, acc: Int) -> Int = if n <= 0 { acc } else { total(n - 1, acc + n) }\n",
    b"fn pick(c: Bool, a: Float, b: Float) -> Float = if c { a * b } else { b }\n",
  ]);
  match program_of(src) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let kept = |name: Bytes|
        match formed(p, name) {
          Err(no) -> Err(no.why),
          Ok(form) -> {
            let o = owned(form);
            Ok(o.body == form.body && verified(o) == None)
          },
        };
      assert_eq(kept(b"total"), Ok(true));
      assert_eq(kept(b"pick"), Ok(true))
    },
  }
}
