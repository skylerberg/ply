//! The calling family's programs lowered through the form: calls of definitions, generic calls,
//! closures, function values, bodies run in place, steps and tail groups.

import emit.compare (program_of, answered_today, today_text)

fn corpus() -> Bytes =
  Bytes::concat_all([
    b"fn add(a: Int, b: Int) -> Int = a + b\n",
    b"fn twice(x: Int) -> Int = add(x, x)\n",
    b"fn same(s: String) -> String = s\n",
    b"fn handed(s: String) -> String = same(s)\n",
    b"fn ident<T>(x: T) -> T = x\n",
    b"fn ident_int(x: Int) -> Int = ident(x)\n",
    b"fn ident_word(s: String) -> String = ident(s)\n",
    b"fn adder(x: Int) -> (Int) -> Int = |y: Int| y + x\n",
    b"fn doubler() -> (Int) -> Int = |y: Int| y * 2\n",
    b"fn named() -> (Int, Int) -> Int = add\n",
    b"fn nested(x: Int) -> (Int) -> (Int) -> Int = |y: Int| |z: Int| x + y + z\n",
    b"fn applied(f: (Int) -> Int, x: Int) -> Int = f(x)\n",
    b"fn applied_word(f: (String) -> String, s: String) -> String = f(s)\n",
    b"fn local(x: Int) -> Int = { let f = |y: Int| y + x; f(1) }\n",
    b"fn count(n: Int) -> Int = if n <= 0 { 0 } else { count(n - 1) }\n",
    b"fn counter() -> (Int) -> Int = |y: Int| count(y)\n",
    b"fn kept() -> Int = 42\n",
    b"fn read_kept(x: Int) -> Int = kept() + x\n",
    b"fn apply_to<T>(f: (T) -> T, x: T) -> T = f(x)\n",
    b"fn lends(x: Int) -> Int = apply_to(|y: Int| y + x, x)\n",
    b"fn steps(n: Int) -> Int / {abort.raise} = iterate(0, n, |i: Int| if i >= 10 { Stop(i) } else { Continue(i + 1) })\n",
    b"fn even(n: Int) -> Bool = if n == 0 { true } else { odd(n - 1) }\n",
    b"fn odd(n: Int) -> Bool = if n == 0 { false } else { even(n - 1) }\n",
  ])

fn names() -> List<Bytes> =
  [
    b"add",
    b"twice",
    b"same",
    b"handed",
    b"ident",
    b"ident_int",
    b"ident_word",
    b"adder",
    b"doubler",
    b"named",
    b"nested",
    b"applied",
    b"applied_word",
    b"local",
    b"count",
    b"counter",
    b"kept",
    b"read_kept",
    b"apply_to",
    b"lends",
    b"steps",
    b"even",
    b"odd",
  ]

test "today's text of the corpus" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let today = answered_today(p, names());
      assert_eq(
        Bytes::concat_all(
          names().map(|n: Bytes| Bytes::concat_all([b"=== ", n, b"\n", today_text(today, n)])),
        ),
        b"",
      )
    },
  }
}
