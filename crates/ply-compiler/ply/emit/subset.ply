//! The typed form's printer held to today's emitter over the scalar subset: each root's C as both
//! write it must agree, read past what two printers may differ in without computing anything
//! differently (a local copied from another local or a constant, the dead store after a restart's
//! `goto`, and how temporaries are numbered).

import code (Code, lower_to_emit)
import diagnostics (parse_all)
import front (Analysed, Refused, Analysis, KnownDefRow, analyse, dump_of, rows_of)
import items (Item, IFn, FnDef)
import exprs (Param)
import lexer (is_ident_continue)
import resolve (Source, Diag, qualify, of_binder)
import types (Type, TyFn, Scheme)
import emit (emit_roots_answer, ctor_layouts, ctor_sums, RootAnswer, Body, symbol_of)
import std.bytes (ascii_of_int)
import emit.keys (Named)
import emit.lower (lowered_fn)
import emit.print (printed_fn)
import emit.pieces (spelled)
import emit.verify (verified)

/// `text` as a list of lines, read past what two printers may write differently for one
/// computation: a local declared from another local or a literal and never assigned again is read
/// as what it copies; lines after a restart's `goto` in its block are dropped; and the temporaries
/// `t<n>` are renumbered in the order they first appear.
pub fn normalised(text: Bytes) -> List<Bytes> / {abort.raise} = {
  let lines = text.split(b"\n");
  let assigned = lines.fold(Map::new(), |m: Map<Bytes, Int>, l: Bytes| {
    let t = trimmed(l);
    match t.index_of(b" = ") {
      Some(at) -> if temp_name(t.slice(0, at)) {
        m.insert(t.slice(0, at), match m.get(t.slice(0, at)) { Some(n) -> n + 1, None -> 1 })
      } else { m },
      None -> m,
    }
  });
  let copies = lines.fold({ names: Map::new(), kept: [] },
    |acc: { names: Map<Bytes, Bytes>, kept: List<Bytes> }, l: Bytes|
      match copy_of(trimmed(l)) {
        Some(c) -> if assigned.contains(c.name) { { ..acc, kept: acc.kept.push(l) } } else {
          {
            ..acc,
            names: acc.names.insert(c.name, match acc.names.get(c.value) { Some(v) -> v, None -> c.value }),
          }
        },
        None -> { ..acc, kept: acc.kept.push(l) },
      });
  let read = copies.kept.map(|l: Bytes| renamed(l, copies.names));
  let live = read.fold({ out: [], skip: 0 - 1 }, |acc: { out: List<Bytes>, skip: Int }, l: Bytes| {
    let depth = indent(l);
    if acc.skip >= 0 && depth >= acc.skip { acc }
    else if trimmed(l) == b"goto ply_loop;" { { out: acc.out.push(l), skip: depth } }
    else { { out: acc.out.push(l), skip: 0 - 1 } }
  });
  let numbering = live.out.fold(Map::new(), |m: Map<Bytes, Bytes>, l: Bytes|
    idents(l).fold(m, |n: Map<Bytes, Bytes>, w: Bytes|
      if temp_name(w) && !n.contains(w) { n.insert(w, b"t".concat(ascii_of_int(n.len() + 1))) }
      else { n }));
  live.out.map(|l: Bytes| renamed(l, numbering))
}

fn trimmed(l: Bytes) -> Bytes / {abort.raise} = l.slice(indent(l), l.len())

fn indent(l: Bytes) -> Int / {abort.raise} =
  range(0, l.len()).fold(l.len(), |at: Int, i: Int| if at < l.len() || l.at(i) == 32 { at } else { i })

/// `T tN = X;` where `X` is a local or a literal: the copy's name and what it copies.
fn copy_of(t: Bytes) -> Option<{ name: Bytes, value: Bytes }> / {abort.raise} =
  match t.index_of(b" ") {
    None -> None,
    Some(sp) -> if !c_type(t.slice(0, sp)) || !t.ends_with(b";") { None } else {
      let rest = t.slice(sp + 1, t.len() - 1);
      match rest.index_of(b" = ") {
        None -> None,
        Some(eq) -> {
          let name = rest.slice(0, eq);
          let value = rest.slice(eq + 3, rest.len());
          if temp_name(name) && atom(value) { Some({ name: name, value: value }) } else { None }
        },
      }
    },
  }

fn c_type(t: Bytes) -> Bool =
  [b"int64_t", b"double", b"int8_t", b"int16_t", b"int32_t", b"uint8_t", b"uint16_t", b"uint32_t",
   b"uint64_t", b"Word", b"PlyDec"].contains(t)

/// A local or a literal: a name of one identifier, or a constant spelled as the printers spell
/// one, with nothing computed.
fn atom(v: Bytes) -> Bool / {abort.raise} =
  local_name(v) || v == b"INT64_MIN"
    || (v.starts_with(b"INT64_C(") && v.ends_with(b")") && v.index_of(b" ") == None)
    || (v.starts_with(b"ply_f64(INT64_C(") && v.ends_with(b"))") && v.index_of(b" ") == None)
    || (v.starts_with(b"((") && v.index_of(b")INT64_C(") != None && v.ends_with(b"))") && v.index_of(b" ") == None)
    || v == b"0" || v == b"1"

fn local_name(v: Bytes) -> Bool / {abort.raise} = temp_name(v) || param_name(v)

fn temp_name(v: Bytes) -> Bool / {abort.raise} = digits_after(v, 116)

fn param_name(v: Bytes) -> Bool / {abort.raise} = digits_after(v, 112)

/// Whether `v` is the byte `lead` and then one or more digits.
fn digits_after(v: Bytes, lead: Int) -> Bool / {abort.raise} =
  v.len() > 1 && v.at(0) == lead && range(1, v.len()).all(|i: Int| v.at(i) >= 48 && v.at(i) <= 57)

/// The identifiers of a line, in order.
fn idents(l: Bytes) -> List<Bytes> / {abort.raise} =
  words(l).filter(|w: { text: Bytes, ident: Bool }| w.ident).map(|w: { text: Bytes, ident: Bool }| w.text)

/// `l` with each identifier `names` holds written as what it holds.
fn renamed(l: Bytes, names: Map<Bytes, Bytes>) -> Bytes / {abort.raise} =
  Bytes::concat_all(words(l).map(|w: { text: Bytes, ident: Bool }|
    if w.ident { match names.get(w.text) { Some(n) -> n, None -> w.text } } else { w.text }))

/// `l` cut into runs of identifier bytes and single other bytes.
fn words(l: Bytes) -> List<{ text: Bytes, ident: Bool }> / {abort.raise} = {
  let cut = range(0, l.len()).fold({ out: [], from: 0 - 1 },
    |acc: { out: List<{ text: Bytes, ident: Bool }>, from: Int }, i: Int| {
      if is_ident_continue(l.at(i)) { if acc.from < 0 { { ..acc, from: i } } else { acc } } else {
        let flushed = if acc.from < 0 { acc.out } else { acc.out.push({ text: l.slice(acc.from, i), ident: true }) };
        { out: flushed.push({ text: l.slice(i, i + 1), ident: false }), from: 0 - 1 }
      }
    });
  if cut.from < 0 { cut.out } else { cut.out.push({ text: l.slice(cut.from, l.len()), ident: true }) }
}

/// Root `m.<name>` of `src` as the typed form prints it, or why it is not in the subset.
fn printed_by_form(src: Bytes, a: Analysis, name: Bytes) -> Result<Bytes, Bytes> / {abort.raise} = {
  let full = qualify(b"m", name);
  let schemes = rows_of(a).defs.fold(Map::new(), |m: Map<Bytes, Scheme>, r: KnownDefRow|
    m.insert(r.name, r.scheme));
  let parsed = parse_all([{ name: b"m", src: src }]);
  match parsed.get(0).module.module.items.fold(None, |acc: Option<FnDef>, i: Item|
      match i { IFn(d) -> if d.name.name == name { Some(d) } else { acc }, _ -> acc }) {
    None -> Err(b"no such definition"),
    Some(d) -> match schemes.get(full) {
      None -> Err(b"no scheme"),
      Some(sc) -> match sc.ty {
        TyFn(f) -> match lower_to_emit(d.params.map(|p: Param| p.name.name), [], Map::new(), d.body, of_binder(b"m")) {
          None -> Err(b"not lowered"),
          Some(l) -> match lowered_fn(
              {
                module: b"m",
                key: Named(full),
                base: d.span.start,
                params: f.params,
                answer: f.ret,
                schemes: schemes,
                typed: Map::new(),
              },
              l.code,
            ) {
            Err(no) -> Err(no.why),
            Ok(form) -> match verified(form) {
              Some(why) -> Err(b"refused by the check: ".concat(why)),
              None -> Ok(spelled(printed_fn(form).pieces)),
            },
          },
        },
        _ -> Err(b"not a function"),
      },
    },
  }
}

/// What today's emitter answers for root `m.<name>` of `src`.
fn printed_today(answers: List<RootAnswer>, name: Bytes) -> Bytes =
  answers.fold(b"", |acc: Bytes, a: RootAnswer|
    if a.name != qualify(b"m", name) { acc } else {
      match a.answer { Body(b) -> b.text, _ -> b"refused by today's emitter" }
    })

fn corpus() -> Bytes =
  Bytes::concat_all([
    b"fn add(a: Int, b: Int) -> Int = a + b\n",
    b"fn diff(a: Int, b: Int) -> Int = a - b * 3\n",
    b"fn quot(a: Int, b: Int) -> Int / {abort.raise} = a / b + a % 7\n",
    b"fn less(a: Int, b: Int) -> Bool = a < b\n",
    b"fn apart(a: Int, b: Int) -> Bool = a != b\n",
    b"fn negated(a: Int) -> Int = -a\n",
    b"fn bits(a: Int, b: Int) -> Int = (a & b) | 5\n",
    b"fn folded(a: Int) -> Int = a + (2 * 3 + 1)\n",
    b"fn pick(c: Bool, a: Int, b: Int) -> Int = if c { a } else { b + 1 }\n",
    b"fn square(x: Float) -> Float = x * x + 1.5\n",
    b"fn fless(x: Float, y: Float) -> Bool = x < y\n",
    b"fn fneg(x: Float) -> Float = -x\n",
    b"fn twice(x: Int) -> Int = add(x, x)\n",
    b"fn total(n: Int, acc: Int) -> Int = if n <= 0 { acc } else { total(n - 1, acc + n) }\n",
    b"fn bound(x: Int) -> Int = { let y = x * 2; let z = y + 3; z - x }\n",
    b"fn flip(b: Bool) -> Bool = !b\n",
    b"fn same(a: Bool, b: Bool) -> Bool = a == b\n",
    b"fn wadd(a: U8, b: U8) -> U8 = a + b\n",
    b"fn wless(a: U8, b: U8) -> Bool = a < b\n",
    b"fn wmul(a: I32, b: I32) -> I32 = a * b\n",
    b"fn wide(a: I64, b: I64) -> I64 = a + b\n",
    b"fn uwide(a: U64, b: U64) -> U64 = a - b\n",
    b"fn wand(a: U16, b: U16) -> U16 = a & b\n",
  ])

fn corpus_names() -> List<Bytes> =
  [b"add", b"diff", b"quot", b"less", b"apart", b"negated", b"bits", b"folded", b"pick", b"square",
   b"fless", b"fneg", b"twice", b"total", b"bound", b"flip", b"same", b"wadd", b"wless", b"wmul",
   b"wide", b"uwide", b"wand"]

test "the scalar subset prints as today's emitter writes it, but for copies and numbering" {
  let src = corpus();
  match analyse(parse_all([{ name: b"m", src: src }])) {
    Refused(diags) -> assert_eq(diags.map(|d: Diag| d.message), []),
    Analysed(a) -> {
      let d = dump_of(Analysed(a));
      let today = emit_roots_answer(
        [b"m"],
        [src],
        { names: [], laid: ctor_layouts(d.ctors), keyed: [], sums: ctor_sums(d.ctors) },
        [],
        corpus_names().map(|n: Bytes| qualify(b"m", n)),
        [],
        [],
        d.embeds,
        d.rows,
        d.walked,
      );
      let differing = corpus_names().fold([], |acc: List<{ name: Bytes, today: List<Bytes>, form: List<Bytes> }>, n: Bytes| {
        let form = match printed_by_form(src, a, n) { Ok(t) -> normalised(t), Err(why) -> [why] };
        let old = normalised(printed_today(today, n));
        if form == old { acc } else { acc.push({ name: n, today: old, form: form }) }
      });
      assert_eq(differing, []);
      // Each root compared is a whole function: its head, its fuel test, its body and its entry.
      assert_eq(
        corpus_names().filter(|n: Bytes| {
          let t = printed_today(today, n);
          t.index_of(b"ctx->fuel -= 1;") != None && t.index_of(b"_entry(PlyCtx *ctx, const Word *args) {") != None
        }).len(),
        corpus_names().len(),
      );
      // The texts read past copies still tell an overflow test, a call and a restart apart.
      let read = |n: Bytes| Bytes::join(normalised(printed_today(today, n)), b"\n");
      assert(read(b"add").index_of(b"if (ply_add_ov(p0, p1, &t1)) { rt_overflow_p(ctx, 0); return 0; }") != None);
      assert(read(b"twice").index_of(symbol_of(b"m.add").concat(b"(ctx, p0, p0);")) != None);
      assert(read(b"total").index_of(b"    p0 = t3;\n    p1 = t4;\n    goto ply_loop;\n  }") != None)
    },
  }
}

test "two printers' copies, dead stores after a restart and numbering are read past" {
  let a = b"  int64_t t4 = p0;\n  int64_t t7 = (t4) < (INT64_C(3));\n  if (t7) {\n    p0 = t4;\n    goto ply_loop;\n    t9 = 0;\n  }\n  return t7;";
  let b = b"  int64_t t1 = (p0) < (INT64_C(3));\n  if (t1) {\n    p0 = p0;\n    goto ply_loop;\n  }\n  return t1;";
  assert_eq(normalised(a), normalised(b));
  // A local assigned again is a join, never a copy.
  assert_eq(
    normalised(b"  int64_t t2 = 0;\n  t2 = p1;\n  return t2;"),
    [b"  int64_t t1 = 0;", b"  t1 = p1;", b"  return t1;"],
  )
}

test "a body outside the subset is refused with what it held" {
  let src = b"fn name(s: String) -> String = s\nfn listed(x: Int) -> List<Int> = [x]\n";
  match analyse(parse_all([{ name: b"m", src: src }])) {
    Refused(diags) -> assert_eq(diags.map(|d: Diag| d.message), []),
    Analysed(a) -> {
      assert_eq(printed_by_form(src, a, b"name"), Err(b"a parameter or answer held as a word"));
      assert_eq(printed_by_form(src, a, b"listed"), Err(b"a parameter or answer held as a word"))
    },
  }
}
