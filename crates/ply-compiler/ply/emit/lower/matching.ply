//! `match`, the patterns `let` binds, and a value compared with a constructor of its sum.

import code (Code, CodeArm, CodePattern, NVar, NApp)
import parsing (Span, starts_upper)
import emit.tir (Arg, Matching)
import emit.lower.base (Context, Lowering, Lowered, Armed, refuse)

/// The state arm `arm` of a match on `subject` is lowered in: a block of its own after `st`, its
/// pattern's binders in its environment. Its guard and body are lowered from it.
pub fn arm_opened(cx: Context, st: Lowering, subject: Arg, arm: CodeArm) -> Lowering =
  refuse(st, Matching, b"a match").st

/// The match on `subject` written after `before`, of `arms` each lowered from `arm_opened`'s state,
/// the last of them ending at `after`.
pub fn closed(
  cx: Context,
  before: Lowering,
  subject: Arg,
  arms: List<Armed>,
  after: Lowering,
  tail: Bool,
  at: Span,
) -> Lowered =
  refuse(after, Matching, b"a match")

/// `let pat = value`: `value`'s state with the pattern's binders in its environment.
pub fn let_bound(cx: Context, value: Lowered, pat: CodePattern, at: Span) -> Lowering =
  refuse(value.st, Matching, b"a pattern bound by `let`").st

/// Which side of `lhs op rhs` is a constructor a comparison tests as a pattern: `Some(true)` the left,
/// `Some(false)` the right, nothing where neither is or `op` is no equality.
pub fn compared_side(cx: Context, op: Bytes, lhs: Code, rhs: Code) -> Option<Bool> / {abort.raise} =
  if op != b"eq" && op != b"ne" { None }
  else if constructor(rhs) { Some(false) }
  else if constructor(lhs) { Some(true) }
  else { None }

/// Whether `c` is a constructor, or one applied to arguments.
fn constructor(c: Code) -> Bool / {abort.raise} =
  match c.node {
    NVar(v) -> v.slot == None && starts_upper(last_segment(v.name)),
    NApp(a) -> match a.func.node {
      NVar(v) -> v.slot == None && starts_upper(last_segment(v.name)),
      _ -> false,
    },
    _ -> false,
  }

/// What follows the last `.` or `::` of `name`.
fn last_segment(name: Bytes) -> Bytes / {abort.raise} = {
  let cut = range(0, name.len()).fold(0, |acc: Int, i: Int|
    if name.at(i) == 46 || name.at(i) == 58 { i + 1 } else { acc });
  name.slice(cut, name.len())
}

/// `value op ctor`, `op` being `eq` or `ne`, tested as a pattern tests the constructor.
pub fn compared(cx: Context, value: Lowered, ctor: Code, op: Bytes, at: Span) -> Lowered =
  refuse(value.st, Matching, b"a comparison with a constructor")
