//! How a value of a type is held in a body, as the form's representations say.

import types (Type, TyCon)
import emit (kind_of, KInt, KBool, KNum, KFloat, KDec)
import emit.tir (Rep, RInt, RBool, RNum, RFloat, RDec, RWord)

/// How a value of `ty` is held in a body. Scalars as themselves, a carried width in its own C
/// type, anything else a word until the layouts say more.
pub fn held_as(ty: Type) -> Rep =
  match kind_of(ty).kind {
    KInt -> RInt,
    KBool -> RBool,
    KNum(w) -> RNum(w),
    KFloat -> RFloat,
    KDec -> RDec,
    _ -> RWord,
  }

test "a value is held as its type says" {
  let named = |n: Bytes| TyCon({ name: n, args: [] });
  assert_eq(held_as(named(b"Int")), RInt);
  assert_eq(held_as(named(b"Bool")), RBool);
  assert_eq(held_as(named(b"Float")), RFloat);
  assert_eq(held_as(named(b"U8")), RNum({ bits: 8, signed: false }));
  assert_eq(held_as(named(b"String")), RWord)
}
