//! Records, constructors, fields, updates and constants.

import parsing (Span)
import emit.tir (Arg, Data)
import emit.lower.base (Context, Lowering, Lowered, refuse)

/// Constructor `name`, written at `ctor_at`, where the checker filed its type at this use, applied
/// to `args` by the call at `at`; both are one span for a constructor of no arguments.
pub fn constructed(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  ctor_at: Span,
  at: Span,
) -> Lowered = refuse(st, Data, b"a constructor: ".concat(name))

/// A record literal of `fields`, each lowered in order.
pub fn recorded(
  cx: Context,
  st: Lowering,
  fields: List<{ name: Bytes, arg: Arg }>,
  at: Span,
) -> Lowered = refuse(st, Data, b"a record")

/// Field `name` of `base`.
pub fn field(cx: Context, base: Lowered, name: Bytes, at: Span) -> Lowered =
  refuse(base.st, Data, b"a field read: ".concat(name))

/// `{ ..base, sets }`, the fields `copies` read out of `base` as they stand.
pub fn updated(
  cx: Context,
  st: Lowering,
  base: Arg,
  copies: List<Bytes>,
  sets: List<{ name: Bytes, arg: Arg }>,
  at: Span,
) -> Lowered = refuse(st, Data, b"a record update")
