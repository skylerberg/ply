//! Lists, maps, arrays, `Columns`, strings and bytes: their literals, builtins and intrinsics. Every
//! builtin call comes here first: what the emitter writes for a scalar's type goes on to `scalars`,
//! what reads or writes a container's cells is written in place, and the rest is called through the
//! runtime's helper named for it.

import parsing (Span, prelude_binder)
import types (Type, TyFn, list_type)
import typing (unknown_type)
import resolve (qualify)
import layout (Intrinsic, intrinsic_named)
import emit (Def, Imported, builtin_helper)
import emit.tir (Rep, RInt, RNum, RWord, RMaybe, Var, Arg, AVar, Make, MList, Native, Op, OContainer, Let,
                 Containers)
import emit.tir.containers (ContainerOp, Length, Elements, ByteAt, U32At, Joined)
import emit.lower.held (held_as)
import emit.lower.base (Context, Lowering, Lowered, refuse, bound_as, handed, type_at, type_of)
import emit.lower.scalars (operated)

/// Builtin `name` called on `args`; `callee` is where its name is written, which the checker files
/// the types it called the builtin at under.
pub fn builtin(cx: Context, st: Lowering, name: Bytes, args: List<Arg>, callee: Span, at: Span) -> Lowered / {abort.raise} =
  match intrinsic_at(cx, name) {
    Some(_) -> refuse(st, Containers, b"an extern written in place over a list's or a map's nodes"),
    None -> match resolved(cx, name) {
      None -> refuse(st, Containers, b"an imported name that is neither a definition nor a builtin: ".concat(name)),
      Some(b) -> if scalar_builtin(b) { operated(cx, st, b, args, at) } else {
        match called_at(cx, callee) {
          None -> refuse(st, Containers, b"a builtin the checker filed no type for: ".concat(b)),
          Some(f) -> contained(cx, st, b, args, f, at),
        }
      },
    },
  }

/// A list literal of `items`, each a word the list takes.
pub fn listed(cx: Context, st: Lowering, items: List<Arg>, at: Span) -> Lowered / {abort.raise} = {
  let ty = match type_at(cx, at) {
    Some(t) -> t,
    None -> list_type(match items.fold(None, |acc: Option<Type>, a: Arg|
        match acc { Some(_) -> acc, None -> match a { AVar(v) -> Some(v.ty), _ -> None } }) {
      Some(t) -> t,
      None -> match items.at(0) { Some(a) -> type_of(a), None -> unknown_type() },
    }),
  };
  let words = as_words(st, items, at);
  bound_as(words.st, ty, held_as(cx.setting, ty), Make({ made: MList(items.len()), args: words.args, reuse: None, kept: [] }), at)
}

/// A builtin's runtime helper called on `args`, each handed over as a word the helper takes, its
/// answer a word with a count of its own, held as a value of `ty` is.
pub fn through_runtime(cx: Context, st: Lowering, name: Bytes, args: List<Arg>, ty: Type, at: Span) -> Lowered / {abort.raise} = {
  let words = as_words(st, args, at);
  let answer = bound_as(words.st, ty, RWord, Native({
    name: builtin_helper(name).concat(b"_p"),
    args: words.args,
    uses: { takes: args.map(|_: Arg| true), owned: true, fails: true, stops: false },
  }), at);
  handed(answer, held_as(cx.setting, ty), at)
}

/// The types a call of a builtin was settled at: its parameters' and its answer's.
type Settled = { params: List<Type>, ret: Type }

fn called_at(cx: Context, callee: Span) -> Option<Settled> =
  match type_at(cx, callee) { Some(TyFn(f)) -> Some({ params: f.params, ret: f.ret }), _ -> None }

/// A builtin that is no scalar's: written in place where it reads or writes a container's cells, and
/// otherwise called through the runtime, which must implement it.
fn contained(cx: Context, st: Lowering, name: Bytes, args: List<Arg>, f: Settled, at: Span) -> Lowered / {abort.raise} =
  if (name == b"List::len" || name == b"Bytes::len") && args.len() == 1 { read_in_place(st, Length, args, f.ret, RInt, at) }
  else if name == b"Array::len" && args.len() == 1 { read_in_place(st, Elements, args, f.ret, RInt, at) }
  else if name == b"Bytes::at" && args.len() == 2 { read_in_place(st, ByteAt, args, f.ret, RInt, at) }
  else if name == b"Bytes::u32_le" && args.len() == 2 {
    read_in_place(st, U32At, args, f.ret, RNum({ bits: 32, signed: false }), at)
  } else if name == b"Bytes::concat_all" && args.len() == 1 { joined(cx, st, args, f.ret, at) }
  else if is_callback(name) { refuse(st, Containers, b"a callback builtin outside its fused shape: ".concat(name)) }
  else if name == b"Bytes::position" && cx.setting.release {
    refuse(st, Containers, b"a byte string's position found by a loop in the body")
  } else if is_array_write(name) || name == b"Array::get" {
    refuse(st, Containers, b"an array written or read at the layout of its elements: ".concat(name))
  } else if !cx.setting.builtins.contains(name) {
    refuse(st, Containers, b"a name the runtime implements no builtin of: ".concat(name))
  } else if is_lookup(name) && args.len() == 2 { looked_up(cx, st, name, args, f.ret, at) }
  else { through_runtime(cx, st, name, args, f.ret, at) }

/// An operation that reads `args`, written in place, its answer held as `rep`: the object first,
/// as a word, and then each index as an `Int`.
fn read_in_place(st: Lowering, op: ContainerOp, args: List<Arg>, ty: Type, rep: Rep, at: Span) -> Lowered / {abort.raise} = {
  let object = match args.at(0) { Some(a) -> handed({ st: st, arg: a }, RWord, at), None -> refuse(st, Containers, b"a read of nothing") };
  let index = match args.at(1) {
    Some(i) -> {
      let h = handed({ st: object.st, arg: i }, RInt, at);
      { st: h.st, args: [object.arg, h.arg] }
    },
    None -> { st: object.st, args: [object.arg] },
  };
  bound_as(index.st, ty, rep, Op({
    op: OContainer(op),
    args: index.args,
    uses: { takes: index.args.map(|_: Arg| false), owned: false, fails: op == ByteAt || op == U32At, stops: false },
  }), at)
}

/// `Bytes::concat_all` of a list this call alone was handed, made just before it: the list's items
/// joined without the list made. Any other list is joined through the runtime.
fn joined(cx: Context, st: Lowering, args: List<Arg>, ty: Type, at: Span) -> Lowered / {abort.raise} =
  match match args.at(0) { Some(AVar(v)) -> made_here(st, v), _ -> None } {
    Some(parts) ->
      bound_as({ ..st, insts: st.insts.take(st.insts.len() - 1) }, ty, RWord, Op({
        op: OContainer(Joined),
        args: parts,
        uses: { takes: parts.map(|_: Arg| true), owned: true, fails: true, stops: false },
      }), at),
    None -> if cx.setting.builtins.contains(b"Bytes::concat_all") {
      through_runtime(cx, st, b"Bytes::concat_all", args, ty, at)
    } else { refuse(st, Containers, b"a name the runtime implements no builtin of: Bytes::concat_all") },
  }

/// The items of the list `v` holds, where the last instruction made it and no slot holds it.
fn made_here(st: Lowering, v: Var) -> Option<List<Arg>> =
  if st.env.values().contains(AVar(v)) { None } else {
    match st.insts.at(st.insts.len() - 1) {
      Some(Let(l)) -> if l.var != v { None } else {
        match l.val { Make(m) -> match m.made { MList(_) -> Some(m.args), _ -> None }, _ -> None }
      },
      _ -> None,
    }
  }

/// A builtin whose helper answers an element or `None` as an `Option` held as its payload's word,
/// with no object made.
fn looked_up(cx: Context, st: Lowering, name: Bytes, args: List<Arg>, ty: Type, at: Span) -> Lowered / {abort.raise} = {
  let words = as_words(st, args, at);
  let answer = bound_as(words.st, ty, RMaybe, Native({
    name: if name == b"Array::at" { b"rt_array_lookup_p" } else { builtin_helper(name).concat(b"_p") },
    args: words.args,
    uses: { takes: args.map(|_: Arg| true), owned: true, fails: true, stops: false },
  }), at);
  handed(answer, held_as(cx.setting, ty), at)
}

fn is_lookup(name: Bytes) -> Bool = name == b"Array::at" || name == b"ListNode::leaf_of"

fn is_array_write(name: Bytes) -> Bool = name == b"Array::new" || name == b"Array::set" || name == b"Array::of_list"

/// A builtin that calls a function it is handed in a shape only a fused loop writes.
fn is_callback(name: Bytes) -> Bool = name == b"iterate"

/// `args` each handed over as a word.
fn as_words(st: Lowering, args: List<Arg>, at: Span) -> { st: Lowering, args: List<Arg> } / {abort.raise} =
  args.fold({ st: st, args: [] }, |acc: { st: Lowering, args: List<Arg> }, a: Arg| {
    let h = handed({ st: acc.st, arg: a }, RWord, at);
    { st: h.st, args: acc.args.push(h.arg) }
  })

/// The builtins `scalars` lowers: those the emitter writes at the type of a scalar it was called at,
/// or per type (order, show, digest, reflection).
fn scalar_builtin(name: Bytes) -> Bool =
  [
    b"reflect", b"shown", b"digest", b"?encoded", b"?same", b"compare", b"compare_values", b"wrap_add",
    b"wrap_sub", b"wrap_mul", b"rotr", b"rotl", b"saturating_add", b"saturating_sub", b"saturating_mul",
    b"checked_add", b"checked_sub", b"checked_mul", b"checked_neg", b"U8::of_int", b"U16::of_int",
    b"U32::of_int", b"U64::of_int", b"I8::of_int", b"I16::of_int", b"I32::of_int", b"I64::of_int",
    b"U128::of_int", b"I128::of_int", b"Int::of_u8", b"Int::of_u16", b"Int::of_u32", b"Int::of_u64",
    b"Int::of_i8", b"Int::of_i16", b"Int::of_i32", b"Int::of_i64", b"Int::of_u128", b"Int::of_i128",
    b"Float::of_int", b"Float::of_bits", b"bits_of_float", b"?stated_witness",
  ].contains(name)

/// The builtin a call of `name` reaches: a name no import holds a definition of, as its own name
/// where an import names an extern the runtime implements; nothing where an import names what is
/// neither.
fn resolved(cx: Context, name: Bytes) -> Option<Bytes> / {abort.raise} =
  match imported_target(cx.setting.imports, name) {
    None -> Some(generated_builtin(name)),
    Some(t) -> if t.imp.defs.any(|d: Def| d.name == t.name) || !cx.setting.builtins.contains(t.name) { None }
    else { Some(t.name) },
  }

/// What the emitter writes in place of a call of `name`: an extern the module, or one it imports,
/// declares under a program-wide name `layout.intrinsics` lists.
fn intrinsic_at(cx: Context, name: Bytes) -> Option<Intrinsic> / {abort.raise} =
  intrinsic_named(match qualified(name) {
    Some(q) -> match module_import(cx.setting.imports, q.binder) {
      Some(imp) -> qualify(imp.module, q.name),
      None -> qualify(cx.setting.module, name),
    },
    None -> match from_import(cx.setting.imports, name) {
      Some(imp) -> qualify(imp.module, name),
      None -> qualify(cx.setting.module, name),
    },
  })

// Copies of the emitter's private name resolution (`emit.ply`), listed in the hooks file.

/// The builtin a name in code the emitter writes from a type calls.
fn generated_builtin(name: Bytes) -> Bytes =
  if name == b"?compare" { b"compare" }
  else if name == b"?reflect" { b"reflect" }
  else if name == b"?shown" { b"shown" }
  else if name == b"?concat" { b"Bytes::concat_all" }
  else { name }

fn imported_target(imports: List<Imported>, name: Bytes) -> Option<{ imp: Imported, name: Bytes }> =
  match match qualified(name) {
      Some(q) -> match module_import(imports, q.binder) {
        Some(imp) -> Some({ imp: imp, name: q.name }),
        None -> None,
      },
      None -> match from_import(imports, name) {
        Some(imp) -> Some({ imp: imp, name: name }),
        None -> None,
      },
    } {
    Some(t) -> Some(t),
    None -> match module_import(imports, prelude_binder()) {
      Some(imp) -> if imp.defs.any(|d: Def| d.name == name) { Some({ imp: imp, name: name }) } else { None },
      None -> None,
    },
  }

fn qualified(name: Bytes) -> Option<{ binder: Bytes, name: Bytes }> =
  range(0, name.len() - 1).fold(None, |acc: Option<{ binder: Bytes, name: Bytes }>, i: Int|
    match acc {
      Some(_) -> acc,
      None -> if name.at(i) == 58 && name.at(i + 1) == 58 {
        Some({ binder: name.slice(0, i), name: name.slice(i + 2, name.len()) })
      } else { None },
    })

fn from_import(xs: List<Imported>, name: Bytes) -> Option<Imported> =
  xs.fold(None, |acc: Option<Imported>, i: Imported| if !i.whole && i.name == name { Some(i) } else { acc })

fn module_import(xs: List<Imported>, binder: Bytes) -> Option<Imported> =
  xs.fold(None, |acc: Option<Imported>, i: Imported| if i.whole && i.name == binder { Some(i) } else { acc })
