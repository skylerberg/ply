//! Lists, maps, arrays, `Columns`, strings and bytes: their literals, builtins and intrinsics. Every
//! builtin call comes here first; what is no container's goes on to `scalars`.

import parsing (Span)
import emit.tir (Arg, Containers)
import emit.lower.base (Context, Lowering, Lowered, refuse)
import emit.lower.scalars (operated)

/// Builtin `name` called with `args`; `callee` is the name's span, where the checker files the
/// call's instantiated type and type arguments.
pub fn builtin(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  callee: Span,
  at: Span,
) -> Lowered = operated(cx, st, name, args, at)

/// A list literal of `items`, each lowered in order.
pub fn listed(cx: Context, st: Lowering, items: List<Arg>, at: Span) -> Lowered =
  refuse(st, Containers, b"a list literal")
