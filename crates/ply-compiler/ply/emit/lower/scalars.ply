//! Literals, operators and widths, and every operation done per type at a site: equality, order,
//! show, digest and reflection. An operator means what the type its operands hold says: C's own
//! over a scalar a register holds, over a character's or a constructor's word and over a string's
//! bytes, a root written for a declared sum or a container, and the runtime's over any other word.

import code (Code, NLit, NBinary, NUnary)
import patterns (Lit, LInt, LBool, LFloat, LFixed, LWide, LChar, LStr, LBytes, LEmbedded, LDec,
                 LUnit, LBad)
import types (Type, TyVar, TyCon, TyRecord, TyNominal, TyFn, Field, named_type, spelled_type)
import typing (unknown_type)
import parsing (Span)
import std.bytes (ascii_of_int)
import emit (Width, Ctors, SumCtor, Scalar, Exact, Whole, Cases, KSum, literal_bits, has_vars,
             type_vars)
import emit.keys
import emit.keys (RootKey, TypeOp, Root, Written, Order, Reflect, Shown, Digest, Contained)
import emit.tir (Rep, RInt, RBool, RNum, RFloat, RDec, RWord, RMaybe, RCases, Arg, AVar, AInt,
                 ABool, AFloat, ANum, AChar, Val, Prim, Literal, Get, Call, Native, Given, Decl,
                 Assign, If, Scalars, rep_of_arg, comparison, arithmetic, shift)
import emit.lower.setting (carrier_of)
import emit.lower.held (held_as, carried_as, arg_path)
import emit.lower.base (Context, Lowering, Lowered, refuse, fresh, bound, bound_as, opened,
                        continued, type_of, handed, noted, set_join, joined, short_circuit)
import emit.lower.data (constructed, field)

/// A literal as the operand it is, or read from the pool into a variable of its type where no
/// register holds it: a string, bytes, an embedded file, a `Decimal`, `()` and a width past 64 bits.
pub fn literal(cx: Context, st: Lowering, l: Lit, at: Span) -> Lowered / {abort.raise} =
  match l {
    LInt(n) -> { st: st, arg: AInt(n) },
    LBool(b) -> { st: st, arg: ABool(b) },
    LFloat(x) -> { st: st, arg: AFloat(literal_bits(x)) },
    LChar(v) -> { st: st, arg: AChar(v) },
    LFixed(name, bits) -> fixed(cx, st, l, name, bits, at),
    LWide(name, _, low) -> fixed(cx, st, l, name, low, at),
    LStr(_) -> bound(cx, st, named_type(b"String"), Literal(l), at),
    LBytes(_) -> bound(cx, st, named_type(b"Bytes"), Literal(l), at),
    LEmbedded(_, _) -> bound(cx, st, named_type(b"Bytes"), Literal(l), at),
    LDec(_) -> bound(cx, st, named_type(b"Decimal"), Literal(l), at),
    LUnit -> bound(cx, st, named_type(b"Unit"), Literal(l), at),
    LBad -> refuse(st, Scalars, b"a literal that does not read"),
  }

/// A width's literal: its bits where a register holds the width, else its word from the pool.
fn fixed(cx: Context, st: Lowering, l: Lit, name: Bytes, bits: Int, at: Span) -> Lowered =
  match width_named(name) {
    Some(w) -> if w.bits <= 64 { { st: st, arg: ANum({ width: w, bits: bits }) } }
    else { bound(cx, st, named_type(name), Literal(l), at) },
    None -> refuse(st, Scalars, b"a literal of no known width"),
  }

/// A node folded to a constant without lowering anything: two `Int` literals under an operator
/// whose result is exact.
pub fn constant(cx: Context, c: Code) -> Option<Arg> =
  match folded(c) { Some(n) -> Some(AInt(n)), None -> None }

/// The right operand of `op` taken as a constant where its node is one C's own operator takes: a
/// negated literal divisor.
pub fn operand(cx: Context, op: Bytes, rhs: Code) -> Option<Arg> =
  match divisor(op, rhs) { Some(d) -> Some(AInt(d)), None -> None }

/// `op` over `o`: `!` over a `Bool`, `-` and `~` at the type `o` holds, C's own over a scalar a
/// register holds and the runtime's over any other word.
pub fn unary(cx: Context, o: Lowered, op: Bytes, at: Span) -> Lowered / {abort.raise} =
  if op == b"not" {
    let b = handed(o, RBool, at);
    bound(cx, b.st, named_type(b"Bool"), Prim({ op: op, on: RBool, args: [b.arg] }), at)
  } else if op != b"neg" && op != b"bitnot" { refuse(o.st, Scalars, b"an operator: ".concat(op)) }
  else {
    let ty = type_of(o.arg);
    let helper = if op == b"neg" { b"rt_negate_p" } else { b"rt_bitnot_p" };
    if ty == unknown_type() {
      refuse(o.st, Scalars, b"an operator over an operand of no known type: ".concat(op))
    } else {
      match class_of(cx.setting.ctors, ty) {
        CInt -> alone(cx, o, op, RInt, ty, at),
        CWidth(w) -> if op == b"neg" && w.bits == 64 && !w.signed {
          by_runtime(cx, o.st, helper, [], [o.arg], ty, at)
        } else { alone(cx, o, op, RNum(w), ty, at) },
        CFloat -> if op == b"neg" { alone(cx, o, op, RFloat, ty, at) } else { lacking(o.st, op) },
        CDec -> if op == b"neg" { alone(cx, o, op, RDec, ty, at) } else { lacking(o.st, op) },
        CWord(t) -> by_runtime(cx, needing(o.st, t, false), helper, [], [o.arg], ty, at),
        _ -> lacking(o.st, op),
      }
    }
  }

/// `l op r` at the type the operands hold, read off whichever says more than an `Int` literal does:
/// a comparison answers a `Bool`, any other operator a value of the operands' type.
pub fn binary(cx: Context, l: Lowered, r: Lowered, op: Bytes, at: Span) -> Lowered / {abort.raise} = {
  let ty = match l.arg { AInt(_) -> type_of(r.arg), _ -> type_of(l.arg) };
  if op == b"concat" { by_runtime(cx, r.st, b"rt_concat_p", [], [l.arg, r.arg], ty, at) }
  else if !comparison(op) && !arithmetic(op) && !shift(op) && !bitwise(op) {
    refuse(r.st, Scalars, b"an operator: ".concat(op))
  } else if ty == unknown_type() {
    refuse(r.st, Scalars, b"an operator over operands of no known type: ".concat(op))
  } else {
    let eq = op == b"eq" || op == b"ne";
    let equal = match class_of(cx.setting.ctors, ty) {
      CRecord(fs) -> if eq { Some(fields_equal(cx, r.st, ty, fs, l.arg, r.arg, at)) } else { None },
      CWord(t) -> if eq && maybes(l.arg, r.arg) { Some(options_equal(cx, l, r, t, at)) }
      else { None },
      _ -> None,
    };
    match equal {
      Some(e) -> if op == b"ne" { negation(cx, e, at) } else { e },
      None -> classed(cx, l, r, op, ty, class_of(cx.setting.ctors, ty), at),
    }
  }
}

/// `l op r` over values of `ty` of class `c`, but a record's or an `Option`'s equality, which
/// `binary` compares part by part.
fn classed(
  cx: Context,
  l: Lowered,
  r: Lowered,
  op: Bytes,
  ty: Type,
  c: Class,
  at: Span,
) -> Lowered = {
  let eq = op == b"eq" || op == b"ne";
  let truth = named_type(b"Bool");
  let answer = if comparison(op) { truth } else { ty };
  {
    match c {
      CInt -> over(cx, l, r, op, RInt, answer, at),
      CWidth(w) -> over(cx, l, r, op, RNum(w), answer, at),
      CBool -> if eq { over(cx, l, r, op, RBool, truth, at) } else { lacking(r.st, op) },
      CFloat -> if comparison(op) || arithmetic(op) { over(cx, l, r, op, RFloat, answer, at) }
      else { lacking(r.st, op) },
      CDec -> if comparison(op) || arithmetic(op) { over(cx, l, r, op, RDec, answer, at) }
      else { lacking(r.st, op) },
      CChar -> if comparison(op) { over(cx, l, r, op, RWord, truth, at) }
      else { lacking(r.st, op) },
      CText -> if eq {
        over(cx, l, r, if op == b"eq" { b"bytes_eq" } else { b"bytes_ne" }, RWord, truth, at)
      } else { words(cx, l, r, op, ty, at) },
      // Held as its constructor's index, a value is compared as one; crossing as its object, by
      // the constructor its header names.
      CNullary(_) -> if eq {
        match held_as(cx.setting, ty) {
          RCases(k) -> over(cx, l, r, op, RCases(k), truth, at),
          _ -> over(cx, l, r, if op == b"eq" { b"ctor_eq" } else { b"ctor_ne" }, RWord, truth, at),
        }
      } else { words(cx, l, r, op, ty, at) },
      CSum(t) -> if eq {
        equal_by(
          cx,
          r.st,
          op,
          // A bare `Equal` is `Ordering`'s, which the prelude declares.
          Written({ op: keys::Equal, ty: t, home: cx.setting.module }),
          [l.arg, r.arg],
          RWord,
          at,
        )
      } else { words(cx, l, r, op, ty, at) },
      CWalked(t) -> if eq {
        equal_by(
          cx,
          r.st,
          op,
          Written({ op: Contained(b"equal"), ty: t, home: cx.setting.module }),
          [l.arg, r.arg],
          RBool,
          at,
        )
      } else { words(cx, l, r, op, ty, at) },
      CWord(t) -> words(cx, l, r, op, t, at),
      CRecord(_) -> lacking(r.st, op),
    }
  }
}

/// Whether `a` and `b`, records of type `ty` of fields `fs`, are equal: field by field in order, each
/// compared only where those before it were equal and as its own type compares, a field of a record
/// type field by field again.
fn fields_equal(
  cx: Context,
  st: Lowering,
  ty: Type,
  fs: List<Field>,
  a: Arg,
  b: Arg,
  at: Span,
) -> Lowered =
  fs.fold(
    { out: { st: st, arg: ABool(true) }, first: true },
    |acc: { out: Lowered, first: Bool }, f: Field| {
      let x = field(
        cx,
        { st: if acc.first { acc.out.st } else { opened(acc.out.st) }, arg: a },
        f.name,
        at,
      );
      let y = field(cx, { st: x.st, arg: b }, f.name, at);
      let xs = { st: y.st, arg: x.arg };
      let e = match f.ty {
        TyRecord(gs) -> fields_equal(cx, y.st, f.ty, gs, x.arg, y.arg, at),
        TyNominal(n) -> fields_equal(cx, y.st, f.ty, n.fields, x.arg, y.arg, at),
        _ -> if maybes(x.arg, y.arg) { options_equal(cx, xs, y, f.ty, at) }
        else { classed(cx, xs, y, b"eq", f.ty, class_of(cx.setting.ctors, f.ty), at) },
      };
      { out: if acc.first { e } else { short_circuit(cx, acc.out, e, true, at) }, first: false }
    },
  ).out

/// The sign of `a` and `b`'s order, records of type `ty` of fields `fs`: by their fields in order,
/// the first that orders them apart deciding, each read only where those before it were equal.
fn fields_order(
  cx: Context,
  st: Lowering,
  ty: Type,
  fs: List<Field>,
  a: Arg,
  b: Arg,
  at: Span,
) -> Lowered =
  fs.fold(
    { out: { st: st, arg: AInt(0) }, first: true },
    |acc: { out: Lowered, first: Bool }, f: Field| {
      let x = field(
        cx,
        { st: if acc.first { acc.out.st } else { opened(acc.out.st) }, arg: a },
        f.name,
        at,
      );
      let y = field(cx, { st: x.st, arg: b }, f.name, at);
      let s = match f.ty {
        TyRecord(gs) -> fields_order(cx, y.st, f.ty, gs, x.arg, y.arg, at),
        TyNominal(n) -> fields_order(cx, y.st, f.ty, n.fields, x.arg, y.arg, at),
        _ -> sign_at(cx, { st: y.st, arg: x.arg }, y, f.ty, at),
      };
      { out: if acc.first { s } else { decided(cx, acc.out, s, at) }, first: false }
    },
  ).out

/// Whether `a` and `b` are `Option`s held as their payloads' words.
fn maybes(a: Arg, b: Arg) -> Bool = rep_of_arg(a) == RMaybe && rep_of_arg(b) == RMaybe

/// `l == r` over two `Option`s of type `t` held as their payloads' words: their words where either
/// is `None`, which is zero, else their payloads, read where they lie, compared as their type
/// compares; a record's payload by the runtime over its word.
fn options_equal(cx: Context, l: Lowered, r: Lowered, t: Type, at: Span) -> Lowered = {
  let truth = named_type(b"Bool");
  let payload = match t {
    TyCon(c) -> match c.args.at(0) { Some(p) -> p, None -> unknown_type() },
    _ -> unknown_type(),
  };
  let none = bound(cx, r.st, truth, Prim({ op: b"none_in", on: RMaybe, args: [l.arg, r.arg] }), at);
  let same = bound(
    cx,
    opened(none.st),
    truth,
    Prim({ op: b"eq", on: RMaybe, args: [l.arg, r.arg] }),
    at,
  );
  let x = payload_of(cx, continued(opened(none.st), same.st), l.arg, payload, at);
  let y = payload_of(cx, x.st, r.arg, payload, at);
  let xs = { st: y.st, arg: x.arg };
  let payloads = match class_of(cx.setting.ctors, payload) {
    CRecord(_) -> words(cx, xs, y, b"eq", payload, at),
    c -> classed(cx, xs, y, b"eq", payload, c, at),
  };
  joined(cx, none, same, payloads, at)
}

/// The payload of `Some` that `of`, an `Option` held as its payload's word, holds, borrowed: a
/// scalar read out of the word, anything else the word itself.
fn payload_of(cx: Context, st: Lowering, of: Arg, payload: Type, at: Span) -> Lowered =
  match of {
    AVar(v) ->
      bound_as(
        st,
        payload,
        match held_as(cx.setting, payload) {
          RInt -> RInt,
          RBool -> RBool,
          RNum(w) -> RNum(w),
          RFloat -> RFloat,
          RDec -> RDec,
          _ -> RWord,
        },
        Get({ of: v, path: arg_path(cx.setting, b"Some", 0) }),
        at,
      ),
    _ -> refuse(st, Scalars, b"an `Option` no variable holds"),
  }

/// The sign `l` where it is not zero, else `r`, lowered in a block of its own after `l`'s state.
fn decided(cx: Context, l: Lowered, r: Lowered, at: Span) -> Lowered = {
  let j = fresh(continued(l.st, r.st), named_type(b"Int"), RInt);
  let c = bound(
    cx,
    j.st,
    named_type(b"Bool"),
    Prim({ op: b"ne", on: RInt, args: [l.arg, AInt(0)] }),
    at,
  );
  let right = set_join(c.st, r, j.var, at);
  {
    st: {
      ..right.st,
      insts: right.st.insts.push(Decl(j.var)).push(
        If({ cond: c.arg, then: [Assign({ var: j.var, arg: l.arg })], otherwise: right.block }),
      ),
    },
    arg: AVar(j.var),
  }
}

/// Builtin `name` over `args`, which `containers` hands on as one written in place at the type its
/// operands hold: an order, a reflection, an encoding, an identity test, a width's wrapping,
/// saturating and checked arithmetic and its conversions, and a `Float`'s.
pub fn operated(cx: Context, st: Lowering, name: Bytes, args: List<Arg>, at: Span) -> Lowered =
  match args.at(0) {
    None -> refuse(st, Scalars, b"a builtin of no argument: ".concat(name)),
    Some(a) -> {
      let b = match args.at(1) { Some(x) -> x, None -> AInt(0) };
      if args.len() != arity(name) {
        refuse(st, Scalars, b"a builtin called with other than its arguments: ".concat(name))
      } else if name == b"compare" || name == b"compare_values" { ordered(cx, st, a, b, at) }
      else if name == b"reflect" || name == b"shown" { reflected(cx, st, name == b"shown", a, at) }
      else if name == b"?encoded" { encoded(cx, st, a, at) } else if name == b"?same" {
        let x = handed({ st: st, arg: a }, RWord, at);
        let y = handed({ st: x.st, arg: b }, RWord, at);
        bound(
          cx,
          y.st,
          named_type(b"Bool"),
          Prim({ op: b"eq", on: RWord, args: [x.arg, y.arg] }),
          at,
        )
      } else if name == b"Float::of_int" || name == b"Float::of_bits" {
        let x = handed({ st: st, arg: a }, RInt, at);
        bound(
          cx,
          x.st,
          named_type(b"Float"),
          Prim({
            op: if name == b"Float::of_int" { b"to_float" } else { b"of_bits" },
            on: RInt,
            args: [x.arg],
          }),
          at,
        )
      } else if name == b"bits_of_float" {
        let x = handed({ st: st, arg: a }, RFloat, at);
        bound(cx, x.st, named_type(b"Int"), Prim({ op: b"bits", on: RFloat, args: [x.arg] }), at)
      } else if wrapping(name) || saturating(name) { width_arithmetic(cx, st, name, a, b, at) }
      else {
        match of_int_width(name) {
          Some(w) -> if w.bits > 64 { by_runtime_only(st, name) } else {
            let x = handed({ st: st, arg: a }, RInt, at);
            bound(cx, x.st, width_type(w), Prim({ op: b"of_int", on: RInt, args: [x.arg] }), at)
          },
          None -> match int_of_width(name) {
            Some(w) -> if w.bits > 64 || (w.bits == 64 && !w.signed) { by_runtime_only(st, name) }
            else {
              let x = handed({ st: st, arg: a }, RNum(w), at);
              bound(
                cx,
                x.st,
                named_type(b"Int"),
                Prim({ op: b"to_int", on: RNum(w), args: [x.arg] }),
                at,
              )
            },
            None -> if name == b"digest" { by_runtime_only(st, name) }
            else if name.starts_with(b"checked_") {
              refuse(
                st,
                Scalars,
                b"a width's checked arithmetic, whose `Option` waits on `data`'s constructors: ".concat(
                  name,
                ),
              )
            } else if name == b"?stated_witness" {
              refuse(
                st,
                Scalars,
                b"a stated witness, which names a constructor's tag no operand holds",
              )
            } else { refuse(st, Scalars, b"a builtin no scalar's: ".concat(name)) },
          },
        }
      }
    },
  }

/// What an operator over two values of a type does, read off the type alone: C's own over a scalar
/// a register holds, a character's word, a string's bytes or the constructor a word holds; a root
/// written for a declared sum or for a container; the runtime's over any other word.
type Class =
  | CInt
  | CBool
  | CWidth(Width)
  | CFloat
  | CDec
  | CChar
  | CText
  | CNullary(Type)
  | CSum(Type)
  | CWalked(Type)
  | CRecord(List<Field>)
  | CWord(Type)

fn class_of(ctors: Ctors, ty: Type) -> Class =
  match ty {
    TyRecord(fs) -> if fs.len() > 0 && !has_vars(ty) { CRecord(fs) } else { CWord(ty) },
    TyNominal(x) -> if x.fields.len() > 0 && !has_vars(ty) { CRecord(x.fields) } else { CWord(ty) },
    TyCon(c) -> if c.args.len() > 0 {
      if walked_container(ty) || is_result(ty) { CWalked(ty) }
      else if generic_sum(ctors, ty) { CSum(ty) }
      else { CWord(ty) }
    } else if c.name == b"Int" { CInt }
    else if c.name == b"Bool" { CBool }
    else if c.name == b"Float" { CFloat }
    else if c.name == b"Decimal" { CDec }
    else if c.name == b"Char" { CChar }
    else if c.name == b"String" || c.name == b"Bytes" { CText }
    else if compared_by_ctors(ctors, c.name) {
      if nullary_sum(match ctors.sums.get(c.name) { Some(cs) -> cs, None -> [] }) { CNullary(ty) }
      else { CSum(ty) }
    } else {
      match width_named(c.name) {
        Some(w) -> if w.bits <= 64 { CWidth(w) } else { CWord(ty) },
        None -> CWord(ty),
      }
    },
    _ -> CWord(ty),
  }

/// `op` over `o` held as `on`, answering a value of `ty`.
fn alone(cx: Context, o: Lowered, op: Bytes, on: Rep, ty: Type, at: Span) -> Lowered = {
  let a = handed(o, on, at);
  bound(cx, a.st, ty, Prim({ op: op, on: on, args: [a.arg] }), at)
}

/// `l op r` as C's own over operands held as `on`, answering a value of `answer`. A shift's or a
/// rotation's count is an `Int` whatever it moves, so it stays as it is held.
fn over(
  cx: Context,
  l: Lowered,
  r: Lowered,
  op: Bytes,
  on: Rep,
  answer: Type,
  at: Span,
) -> Lowered = {
  let a = handed({ st: r.st, arg: l.arg }, on, at);
  let b = if counts(op) { { st: a.st, arg: r.arg } }
  else { handed({ st: a.st, arg: r.arg }, on, at) };
  bound(cx, b.st, answer, Prim({ op: op, on: on, args: [a.arg, b.arg] }), at)
}

/// `l op r` by the runtime over the operands' words: `==` as the evaluator compares two values,
/// any other operator as it does it. A type variable's operands note what a specialisation reads.
fn words(cx: Context, l: Lowered, r: Lowered, op: Bytes, ty: Type, at: Span) -> Lowered = {
  let eq = op == b"eq" || op == b"ne";
  let st = needing(r.st, ty, eq);
  if eq {
    let a = handed({ st: st, arg: l.arg }, RWord, at);
    let b = handed({ st: a.st, arg: r.arg }, RWord, at);
    let e = bound(
      cx,
      b.st,
      named_type(b"Bool"),
      Native({
        name: b"rt_equal_p",
        args: [a.arg, b.arg],
        uses: { takes: [false, false], owned: false, fails: true, stops: false },
      }),
      at,
    );
    if op == b"ne" { negation(cx, e, at) } else { e }
  } else {
    by_runtime(
      cx,
      st,
      b"rt_binary_p",
      [AInt(binary_code(op))],
      [l.arg, r.arg],
      if comparison(op) { named_type(b"Bool") } else { ty },
      at,
    )
  }
}

/// Runtime function `name` over `lead`, then `args` each made a word it takes, its answer a word
/// held as a value of `ty` is.
fn by_runtime(
  cx: Context,
  st: Lowering,
  name: Bytes,
  lead: List<Arg>,
  args: List<Arg>,
  ty: Type,
  at: Span,
) -> Lowered = {
  let ws = made_words(st, args, at);
  let w = bound_as(
    ws.st,
    ty,
    RWord,
    Native({
      name: name,
      args: lead.concat(ws.args),
      uses: {
        takes: lead.map(|_: Arg| false).concat(ws.args.map(|_: Arg| true)),
        owned: true,
        fails: true,
        stops: false,
      },
    }),
    at,
  );
  handed(w, held_as(cx.setting, ty), at)
}

fn made_words(st: Lowering, args: List<Arg>, at: Span) -> { st: Lowering, args: List<Arg> } =
  args.fold({ st: st, args: [] }, |acc: { st: Lowering, args: List<Arg> }, x: Arg| {
    let w = handed({ st: acc.st, arg: x }, RWord, at);
    { st: w.st, args: acc.args.push(w.arg) }
  })

/// `==`, or `!=`, through the root `key` names, which takes both operands' words and answers a
/// `Bool` held as `answer`.
fn equal_by(
  cx: Context,
  st: Lowering,
  op: Bytes,
  key: RootKey,
  args: List<Arg>,
  answer: Rep,
  at: Span,
) -> Lowered = {
  let e = handed(
    rooted(cx, st, key, args, args.map(|_: Arg| RWord), named_type(b"Bool"), answer, at),
    RBool,
    at,
  );
  if op == b"ne" { negation(cx, e, at) } else { e }
}

/// The root `key` names called on `args`, each given as `reps` says, answering a value of `ty` held
/// as `answer`.
fn rooted(
  cx: Context,
  st: Lowering,
  key: RootKey,
  args: List<Arg>,
  reps: List<Rep>,
  ty: Type,
  answer: Rep,
  at: Span,
) -> Lowered = {
  let given = range(0, args.len()).fold(
    { st: st, args: [] },
    |acc: { st: Lowering, args: List<Arg> }, i: Int|
      match args.at(i) {
        None -> acc,
        Some(x) -> {
          let h = handed(
            { st: acc.st, arg: x },
            match reps.at(i) { Some(r) -> r, None -> RWord },
            at,
          );
          { st: h.st, args: acc.args.push(h.arg) }
        },
      },
  );
  handed(
    bound_as(
      given.st,
      ty,
      answer,
      Call({
        callee: Root(key),
        args: given.args,
        conv: { params: given.args.map(|_: Arg| Given), reps: reps, answer: answer },
        stops: false,
      }),
      at,
    ),
    held_as(cx.setting, ty),
    at,
  )
}

fn negation(cx: Context, b: Lowered, at: Span) -> Lowered =
  bound(cx, b.st, named_type(b"Bool"), Prim({ op: b"not", on: RBool, args: [b.arg] }), at)

/// `compare(a, b)` at the type its operands hold: through the root written for a declared sum, a
/// container, an `Option` or a `Result` known throughout, which answers the `Ordering`; any other
/// type C orders, a record field by field, by the sign of the order made its `Ordering`.
fn ordered(cx: Context, st: Lowering, a: Arg, b: Arg, at: Span) -> Lowered = {
  let ty = match a { AInt(_) -> type_of(b), _ -> type_of(a) };
  match by_root(cx, st, ty, a, b, at) {
    Some(o) -> o,
    None -> {
      let s = match class_of(cx.setting.ctors, ty) {
        CRecord(fs) -> fields_order(cx, st, ty, fs, a, b, at),
        _ -> sign_at(cx, { st: st, arg: a }, { st: st, arg: b }, ty, at),
      };
      bound(
        cx,
        s.st,
        named_type(b"Ordering"),
        Prim({ op: b"ordering", on: RInt, args: [s.arg] }),
        at,
      )
    },
  }
}

/// The order of `a` and `b` where a root written for their type answers it: a sum a module declares,
/// a container, an `Option` or a `Result` known throughout.
fn by_root(cx: Context, st: Lowering, ty: Type, a: Arg, b: Arg, at: Span) -> Option<Lowered> = {
  let order = named_type(b"Ordering");
  let at_root = |op: TypeOp, t: Type|
    Some(
      rooted(
        cx,
        st,
        Written({ op: op, ty: t, home: cx.setting.module }),
        [a, b],
        [RWord, RWord],
        order,
        RWord,
        at,
      ),
    );
  match class_of(cx.setting.ctors, ty) {
    CNullary(t) -> if spelled_type(t).index_of(b".") != None { at_root(Order, t) } else { None },
    CSum(t) -> if spelled_type(t).index_of(b".") != None { at_root(Order, t) } else { None },
    CWalked(t) -> at_root(Contained(b"ordered"), t),
    CWord(t) -> if is_option(t) && !has_vars(t) { at_root(Contained(b"ordered"), t) } else { None },
    _ -> None,
  }
}

/// The sign of `l` and `r`'s order, an `Int` below, at or above zero, at their type: in C for a
/// number, a character, a string or byte string, a `Bool` and `()`, else through the root that
/// answers its `Ordering`.
fn sign_at(cx: Context, l: Lowered, r: Lowered, ty: Type, at: Span) -> Lowered = {
  let int = named_type(b"Int");
  match by_root(cx, r.st, ty, l.arg, r.arg, at) {
    Some(o) ->
      bound(cx, o.st, int, Prim({ op: b"sign", on: rep_of_arg(o.arg), args: [o.arg] }), at),
    None -> match class_of(cx.setting.ctors, ty) {
      CInt -> over(cx, l, r, b"order", RInt, int, at),
      CBool -> over(cx, l, r, b"order", RBool, int, at),
      CChar -> over(cx, l, r, b"order", RWord, int, at),
      CWidth(w) -> over(cx, l, r, b"order", RNum(w), int, at),
      CDec -> over(cx, l, r, b"order", RDec, int, at),
      CText -> over(cx, l, r, b"bytes_order", RWord, int, at),
      CWord(t) -> if t == named_type(b"Unit") { { st: r.st, arg: AInt(0) } }
      else { by_runtime_only(r.st, b"compare") },
      _ -> by_runtime_only(r.st, b"compare"),
    },
  }
}

/// `reflect(a)` or `shown(a)` at the type `a` holds, where the program holds `std.value`: a scalar
/// as its constructor of the value, a declared sum, a container and a record through a root.
fn reflected(cx: Context, st: Lowering, shown: Bool, a: Arg, at: Span) -> Lowered = {
  let ty = type_of(a);
  let value = |name: Bytes| constructed(cx, st, name, [a], at, at);
  if !cx.setting.ctors.names.contains(b"std.value.VUnit") || has_vars(ty) {
    by_runtime_only(st, b"reflect")
  } else {
    match ty {
      TyCon(c) -> if written_sum(cx.setting.ctors, c) || walked_container(ty) {
        written(cx, st, if shown { Shown } else { Reflect }, ty, a, at)
      } else if cx.setting.ctors.sums.contains(c.name) || c.args.len() > 0 {
        by_runtime_only(st, b"reflect")
      } else if c.name == b"Int" { value(b"std.value.VInt") }
      else if c.name == b"Bool" { value(b"std.value.VBool") }
      else if c.name == b"Float" { value(b"std.value.VFloat") }
      else if c.name == b"Decimal" { value(b"std.value.VDecimal") }
      else if c.name == b"Char" { value(b"std.value.VChar") }
      else if c.name == b"String" { value(b"std.value.VStr") }
      else if c.name == b"Bytes" { value(b"std.value.VBytes") }
      else if c.name == b"Unit" { constructed(cx, st, b"std.value.VUnit", [], at, at) }
      else { by_runtime_only(st, b"reflect") },
      TyRecord(_) -> written(cx, st, if shown { Shown } else { Reflect }, ty, a, at),
      TyNominal(_) -> written(cx, st, if shown { Shown } else { Reflect }, ty, a, at),
      _ -> by_runtime_only(st, b"reflect"),
    }
  }
}

/// `?encoded(a)`: the encoding `digest` hashes of a declared sum, a container or a record, through
/// the root written for its type.
fn encoded(cx: Context, st: Lowering, a: Arg, at: Span) -> Lowered = {
  let ty = type_of(a);
  if has_vars(ty) { by_runtime_only(st, b"?encoded") } else {
    match ty {
      TyCon(c) -> if written_sum(cx.setting.ctors, c) || walked_container(ty) {
        written(cx, st, Digest, ty, a, at)
      } else { by_runtime_only(st, b"?encoded") },
      TyRecord(_) -> written(cx, st, Digest, ty, a, at),
      TyNominal(_) -> written(cx, st, Digest, ty, a, at),
      _ -> by_runtime_only(st, b"?encoded"),
    }
  }
}

/// What the root written for `op` of a value of `ty` answers for `a`, which it takes held as the
/// root is handed it: an `Option` as its payload's word, a `Result` as its tagged word where it is
/// one, anything else as its word.
fn written(cx: Context, st: Lowering, op: TypeOp, ty: Type, a: Arg, at: Span) -> Lowered =
  rooted(
    cx,
    st,
    Written({ op: op, ty: ty, home: cx.setting.module }),
    [a],
    [taken_as(ty)],
    match op { Digest -> named_type(b"Bytes"), _ -> named_type(b"std.value.Value") },
    RWord,
    at,
  )

fn taken_as(ty: Type) -> Rep =
  match carrier_of(ty) {
    Whole(KSum(s)) -> carried_as(Whole(KSum(s))),
    Cases(c) -> carried_as(Whole(KSum(c.spec))),
    _ -> RWord,
  }

/// A width's wrapping or saturating builtin at the type its operands hold, in C where a register
/// holds the width: saturating only below 64 bits, where the exact answer fits a word.
fn width_arithmetic(cx: Context, st: Lowering, name: Bytes, a: Arg, b: Arg, at: Span) -> Lowered = {
  let ty = match a { AInt(_) -> type_of(b), _ -> type_of(a) };
  match class_of(cx.setting.ctors, ty) {
    CWidth(w) -> if saturating(name) && w.bits >= 64 { by_runtime_only(st, name) }
    else { over(cx, { st: st, arg: a }, { st: st, arg: b }, name, RNum(w), ty, at) },
    _ -> by_runtime_only(st, name),
  }
}

/// A builtin the runtime answers here, which waits on `containers`' runtime call.
fn by_runtime_only(st: Lowering, name: Bytes) -> Lowered =
  refuse(
    st,
    Scalars,
    b"a builtin the runtime answers at this type, which waits on `through_runtime`: ".concat(name),
  )

fn lacking(st: Lowering, op: Bytes) -> Lowered =
  refuse(st, Scalars, b"an operator its operands' type does not have: ".concat(op))

/// `st` noting what a specialisation would read of each type variable the operator meets: the type
/// itself where it compares, else whether it is a scalar held apart from a word.
fn needing(st: Lowering, ty: Type, compares: Bool) -> Lowering =
  match ty {
    TyVar(v) -> if v < 0 { st }
    else { noted(st, { var: v, reads: if compares { Exact } else { Scalar } }) },
    _ -> if compares {
      type_vars(ty).fold(st, |s: Lowering, v: Int| noted(s, { var: v, reads: Exact }))
    } else { st },
  }

fn bitwise(op: Bytes) -> Bool = op == b"bitand" || op == b"bitor" || op == b"bitxor"

/// Whether `op`'s second operand is a count, an `Int` whatever the first is.
fn counts(op: Bytes) -> Bool = shift(op) || op == b"rotl" || op == b"rotr"

fn wrapping(name: Bytes) -> Bool =
  name == b"wrap_add" || name == b"wrap_sub" || name == b"wrap_mul" || name == b"rotr"
    || name == b"rotl"

fn saturating(name: Bytes) -> Bool =
  name == b"saturating_add" || name == b"saturating_sub" || name == b"saturating_mul"

fn arity(name: Bytes) -> Int =
  if name == b"compare" || name == b"compare_values" || name == b"?same" || wrapping(name)
      || saturating(name)
      || (name.starts_with(b"checked_") && name != b"checked_neg") { 2 }
  else { 1 }

/// `rt_binary`'s operator numbering, in the runtime table's order.
fn binary_code(op: Bytes) -> Int =
  if op == b"add" { 0 }
  else if op == b"sub" { 1 }
  else if op == b"mul" { 2 }
  else if op == b"div" { 3 }
  else if op == b"rem" { 4 }
  else if op == b"eq" { 5 }
  else if op == b"ne" { 6 }
  else if op == b"lt" { 7 }
  else if op == b"le" { 8 }
  else if op == b"gt" { 9 }
  else if op == b"ge" { 10 }
  else if op == b"bitand" { 11 }
  else if op == b"bitor" { 12 }
  else if op == b"bitxor" { 13 }
  else if op == b"shl" { 14 }
  else if op == b"shr" { 15 }
  else { 16 }

/// The divisor an `Int` division or remainder takes as a literal where it is a negated one:
/// C's own operator then divides by it.
fn divisor(op: Bytes, rhs: Code) -> Option<Int> =
  if op != b"div" && op != b"rem" { None } else {
    match rhs.node {
      NUnary(u) -> if u.op != b"neg" { None } else {
        match u.operand.node {
          NLit(l) -> match l {
            LInt(v) -> if v == 0 || v == 1 { None } else { Some(0 - v) },
            _ -> None,
          },
          _ -> None,
        }
      },
      _ -> None,
    }
  }

/// Two `Int` literals under an operator, folded where the result is exact: `+`, `-` and `*` without
/// overflow, the bit operators, and shifts by a count the word holds.
fn folded(c: Code) -> Option<Int> =
  match c.node {
    NLit(l) -> match l { LInt(n) -> Some(n), _ -> None },
    NBinary(b) -> match folded(b.lhs) {
      None -> None,
      Some(a) -> match folded(b.rhs) {
        None -> None,
        Some(x) -> if b.op == b"add" { exact_add(a, x) }
        else if b.op == b"sub" { exact_sub(a, x) }
        else if b.op == b"mul" { exact_mul(a, x) }
        else if b.op == b"bitand" { Some(a & x) }
        else if b.op == b"bitor" { Some(a | x) }
        else if b.op == b"bitxor" { Some(a ^ x) }
        else if b.op == b"shl" && x >= 0 && x < 64 { Some(a << x) }
        else if b.op == b"shr" && x >= 0 && x < 64 { Some(a >> x) }
        else if b.op == b"ushr" && x >= 0 && x < 64 { Some(a >>> x) }
        else { None },
      },
    },
    _ -> None,
  }

fn exact_add(a: Int, b: Int) -> Option<Int> = {
  let s = wrap_add(a, b);
  if a >= 0 == (b >= 0) && s >= 0 != (a >= 0) { None } else { Some(s) }
}

fn exact_sub(a: Int, b: Int) -> Option<Int> = {
  let s = wrap_sub(a, b);
  if a >= 0 != (b >= 0) && s >= 0 != (a >= 0) { None } else { Some(s) }
}

fn exact_mul(a: Int, b: Int) -> Option<Int> =
  if a == 0 || b == 0 { Some(0) }
  else if a == -1 { exact_sub(0, b) }
  else if b == -1 { exact_sub(0, a) } else {
    let p = wrap_mul(a, b);
    if p / a == b && p % a == 0 { Some(p) } else { None }
  }

pub fn width_named(name: Bytes) -> Option<Width> =
  if name == b"U8" { Some({ bits: 8, signed: false }) }
  else if name == b"U16" { Some({ bits: 16, signed: false }) }
  else if name == b"U32" { Some({ bits: 32, signed: false }) }
  else if name == b"U64" { Some({ bits: 64, signed: false }) }
  else if name == b"I8" { Some({ bits: 8, signed: true }) }
  else if name == b"I16" { Some({ bits: 16, signed: true }) }
  else if name == b"I32" { Some({ bits: 32, signed: true }) }
  else if name == b"I64" { Some({ bits: 64, signed: true }) }
  else if name == b"U128" { Some({ bits: 128, signed: false }) }
  else if name == b"I128" { Some({ bits: 128, signed: true }) }
  else { None }

/// The type a width is.
fn width_type(w: Width) -> Type =
  named_type(
    Bytes::concat_all([
      if w.signed { b"I" } else { b"U" },
      if w.bits == 8 { b"8" }
      else if w.bits == 16 { b"16" }
      else if w.bits == 32 { b"32" }
      else if w.bits == 64 { b"64" }
      else { b"128" },
    ]),
  )

fn of_int_width(name: Bytes) -> Option<Width> =
  [b"U8", b"U16", b"U32", b"U64", b"I8", b"I16", b"I32", b"I64", b"U128", b"I128"].fold(
    None,
    |acc: Option<Width>, w: Bytes| if name == w.concat(b"::of_int") { width_named(w) } else { acc },
  )

fn int_of_width(name: Bytes) -> Option<Width> =
  [b"U8", b"U16", b"U32", b"U64", b"I8", b"I16", b"I32", b"I64", b"U128", b"I128"].fold(
    None,
    |acc: Option<Width>, w: Bytes|
      if name
          == Bytes::concat_all([
            b"Int::of_",
            if w.starts_with(b"U") { b"u" } else { b"i" },
            digits_of(w),
          ]) { width_named(w) }
      else { acc },
  )

/// A width's name past its sign.
fn digits_of(w: Bytes) -> Bytes =
  if w.ends_with(b"128") { b"128" }
  else if w.ends_with(b"16") { b"16" }
  else if w.ends_with(b"32") { b"32" }
  else if w.ends_with(b"64") { b"64" }
  else { b"8" }

fn is_option(t: Type) -> Bool =
  match t { TyCon(c) -> c.name == b"Option" && c.args.len() == 1, _ -> false }

// Copies of the emitter's private readers of types (`emit.ply`), listed in the hooks file.

fn walked_container(t: Type) -> Bool =
  !has_vars(t)
    && (match t {
      TyCon(c) -> c.name == b"List" || c.name == b"Array" || c.name == b"Map",
      _ -> false,
    })

fn is_result(t: Type) -> Bool =
  !has_vars(t) && (match t { TyCon(c) -> c.name == b"Result" && c.args.len() == 2, _ -> false })

/// Whether two values of the type `name` compare as the constructors of a sum the program declares
/// do: not an `Option` or a `Result`, not a type whose module states a `key`, and, where no module
/// declares it, one of no constructor's argument.
fn compared_by_ctors(ctors: Ctors, name: Bytes) -> Bool =
  name != b"Option" && name != b"Result"
    && (match ctors.sums.get(name) {
      Some(cs) ->
        cs.len() > 0 && cs.fold(true, |ok: Bool, c: SumCtor| ok && !ctors.keyed.contains(c.name))
          && (name.index_of(b".") != None || nullary_sum(cs)),
      None -> false,
    })

fn nullary_sum(cs: List<SumCtor>) -> Bool =
  cs.fold(true, |ok: Bool, c: SumCtor| ok && c.fields.len() == 0)

/// Whether `t` is a sum a module declares generic, at arguments known throughout, whose roots at
/// those arguments are finitely many.
fn generic_sum(ctors: Ctors, t: Type) -> Bool =
  !has_vars(t)
    && (match t {
      TyCon(c) ->
        c.args.len() > 0 && c.name.index_of(b".") != None && compared_by_ctors(ctors, c.name)
          && regular_sum(ctors, c.name),
      _ -> false,
    })

/// Whether `reflect`, `shown` and `digest` of a value of the sum `c` names are written by a root.
fn written_sum(ctors: Ctors, c: { name: Bytes, args: List<Type> }) -> Bool =
  ctors.sums.contains(c.name) && (c.args.len() == 0 || regular_sum(ctors, c.name))

/// Whether no chain of sums from one of `name`'s parameters back to one holds it at a grown type.
fn regular_sum(ctors: Ctors, name: Bytes) -> Bool = {
  let steps = sums_reached(ctors, name).fold([], |acc: List<ParamStep>, s: Bytes|
    acc.concat(param_steps(ctors, s)));
  let from = |p: Bytes| positions_reached(steps, p).push(p);
  let own = steps.fold([], |acc: List<Bytes>, s: ParamStep|
    if s.from.starts_with(name.concat(b"#")) && !acc.contains(s.from) { acc.push(s.from) }
    else { acc });
  steps.all(|s: ParamStep|
    !s.grown || !own.any(|p: Bytes| from(s.to).contains(p) && from(p).contains(s.from)))
}

type ParamStep = { from: Bytes, to: Bytes, grown: Bool }

fn sums_reached(ctors: Ctors, name: Bytes) -> List<Bytes> =
  range(0, ctors.sums.len()).fold(
    { seen: [name], at: 0 },
    |s: { seen: List<Bytes>, at: Int }, _: Int|
      match s.seen.at(s.at) {
        None -> s,
        Some(n) ->
          {
            seen: held_sums(ctors, n).fold(s.seen, |acc: List<Bytes>, o: Bytes|
              if acc.contains(o) { acc } else { acc.push(o) }),
            at: s.at + 1,
          },
      },
  ).seen

fn held_sums(ctors: Ctors, n: Bytes) -> List<Bytes> =
  match ctors.sums.get(n) {
    None -> [],
    Some(cs) ->
      cs.fold([], |acc: List<Bytes>, c: SumCtor|
        c.fields.fold(acc, |a: List<Bytes>, f: Type|
          a.concat(sums_in(ctors, f).map(|o: { name: Bytes, args: List<Type> }| o.name)))),
  }

fn param_steps(ctors: Ctors, s: Bytes) -> List<ParamStep> =
  match ctors.sums.get(s) {
    None -> [],
    Some(cs) ->
      cs.fold([], |acc: List<ParamStep>, c: SumCtor|
        c.fields.fold(acc, |a: List<ParamStep>, f: Type|
          sums_in(ctors, f).fold(a, |b: List<ParamStep>, o: { name: Bytes, args: List<Type> }|
            range(0, o.args.len()).fold(b, |d: List<ParamStep>, j: Int|
              range(0, c.params.len()).fold(d, |e: List<ParamStep>, i: Int|
                match c.params.at(i) {
                  None -> e,
                  Some(p) -> match o.args.at(j) {
                    None -> e,
                    Some(arg) -> {
                      let step = |grown: Bool|
                        e.push({
                          from: Bytes::concat_all([s, b"#", ascii_of_int(i)]),
                          to: Bytes::concat_all([o.name, b"#", ascii_of_int(j)]),
                          grown: grown,
                        });
                      if arg == TyVar(p) { step(false) }
                      else if type_vars(arg).contains(p) { step(true) }
                      else { e }
                    },
                  },
                }))))),
  }

fn sums_in(ctors: Ctors, t: Type) -> List<{ name: Bytes, args: List<Type> }> =
  match t {
    TyVar(_) -> [],
    TyCon(k) -> {
      let inner = k.args.fold([], |acc: List<{ name: Bytes, args: List<Type> }>, a: Type|
        acc.concat(sums_in(ctors, a)));
      if ctors.sums.contains(k.name) { inner.push({ name: k.name, args: k.args }) } else { inner }
    },
    TyFn(f) ->
      f.params.fold(
        sums_in(ctors, f.ret),
        |acc: List<{ name: Bytes, args: List<Type> }>, a: Type| acc.concat(sums_in(ctors, a)),
      ),
    TyRecord(fs) ->
      fs.fold([], |acc: List<{ name: Bytes, args: List<Type> }>, f: Field|
        acc.concat(sums_in(ctors, f.ty))),
    TyNominal(x) ->
      x.fields.fold(
        x.args.fold([], |acc: List<{ name: Bytes, args: List<Type> }>, a: Type|
          acc.concat(sums_in(ctors, a))),
        |acc: List<{ name: Bytes, args: List<Type> }>, f: Field| acc.concat(sums_in(ctors, f.ty)),
      ),
  }

fn positions_reached(steps: List<ParamStep>, from: Bytes) -> List<Bytes> = {
  let next = |n: Bytes| steps.filter(|s: ParamStep| s.from == n).map(|s: ParamStep| s.to);
  range(0, steps.len()).fold(next(from), |seen: List<Bytes>, _: Int|
    seen.fold(seen, |acc: List<Bytes>, n: Bytes|
      next(n).fold(acc, |more: List<Bytes>, m: Bytes|
        if more.contains(m) { more } else { more.push(m) })))
}
