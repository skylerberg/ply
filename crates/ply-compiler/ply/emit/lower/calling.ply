//! What a call calls and how: a definition's root by the convention it has at the call's type
//! arguments, a generic definition's call the unit settles, a call in tail position as a jump, a
//! pure definition read once, a function value, a body run in place of the call, a closure made of a
//! lambda's body, and a tail group's roots as one.

import code (Code, Node, Own, Borrowed, Owned, NVar, NKnown, NLambda, NApp, NUnary, NBinary, NField,
             NIf, NBlock, NList, NRecord, NUpdate, NMatch, NPerform, NSimulate, NParallel, NHandle,
             Lambda, Capture, CodeStmt, CLet, CLetPat, CDo, CodeField, CodeArm, CodeClause)
import types (Type, TyFn, TyVar, TyCon, TyRecord, TyNominal, Field, Scheme, spelled_type)
import typing (unknown_type)
import parsing (Span, span_key, starts_upper, prelude_binder)
import resolve (qualify)
import infer (is_test_owner)
import std.bytes (ascii_of_int)
import emit (Def, Imported, EmitParam, Carrier, Whole, KBoxed, FnArg, erased, has_vars)
import emit.keys (Named, At, KeyArg, KeyType, KeyLayout, Callee, Root, Generic, root_name,
                  definition_of)
import emit.tir (Rep, RWord, RFlat, RCases, Var, Arg, AVar, AZero, Given, Convention, Make, Get, Op,
                 OCalling, MClosure, PCapture, Call, Apply, Inst, Let, Restart, Return, Fn, Rooted,
                 Closure, Declined, Calling, no_links, falls_through)
import emit.tir.calling (EntryValue, ConstantRead, BuiltinValue, Ticked)
import emit.lower.setting (carrier_of)
import emit.lower.held (held_as, carried_as)
import emit.lower.base (Context, Lowering, Lowered, Target, ToCtor, ToBuiltin, ToDef, ToValue,
                        ToInPlace, Frame, Opened, GroupMember, Restarts, Enters, Calls, refuse,
                        bound_as, done, emitted, nested, unnested, with_lambda, started, type_at,
                        type_of, handed)
import emit.lower.data (constructed)

/// How the root takes its parameters and hands back its answer: as the emitter carries them.
pub fn convention(cx: Context) -> Convention =
  {
    params: cx.params.map(|_: EmitParam| Given),
    reps: cx.params.map(|p: EmitParam| carried_as(p.carrier)),
    answer: carried_as(cx.answer),
  }

/// What the call of `func` on `args` calls: a lambda known to the slot it reads, run in place; a
/// function value; a constructor; a definition; a step `iterate` runs in place of each of its
/// passes; or a builtin, an import's extern by its own name.
pub fn target(cx: Context, func: Code, args: List<Code>) -> Option<Target> / {abort.raise} =
  match func.node {
    NKnown(_) -> Some(ToInPlace(None)),
    NVar(f) -> match f.slot {
      Some(_) -> Some(ToValue),
      None -> if is_ctor_name(f.name) { Some(ToCtor(f.name)) } else {
        match def_named(cx, f.name) {
          Some(d) -> Some(ToDef(d.full)),
          None -> if f.name == b"iterate" && stepped(args) { Some(ToInPlace(Some(2))) }
          else { Some(ToBuiltin(extern_named(cx, f.name))) },
        }
      },
    },
    _ -> Some(ToValue),
  }

/// A name no slot holds read as a value: a constructor, the unit's closure over a definition's
/// entry, or a builtin's value.
pub fn global(cx: Context, st: Lowering, name: Bytes, at: Span) -> Lowered / {abort.raise} =
  if is_ctor_name(name) { constructed(cx, st, name, [], at) } else {
    match def_named(cx, name) {
      Some(d) -> {
        let n = named_ref(cx, st, d, at, []);
        bound_as(
          n.st,
          match type_at(cx, at) {
            Some(t) -> t,
            None -> match d.def.scheme { Some(sc) -> sc.ty, None -> unknown_type() },
          },
          RWord,
          Op({
            op: OCalling(EntryValue({ callee: n.callee, arity: d.def.arity })),
            args: [],
            uses: answers(),
          }),
          at,
        )
      },
      None -> if cx.setting.builtins.contains(name) {
        match type_at(cx, at) {
          Some(t) ->
            bound_as(
              st,
              t,
              RWord,
              Op({ op: OCalling(BuiltinValue(name)), args: [], uses: answers() }),
              at,
            ),
          None -> refuse(st, Calling, b"a builtin read as a value at no type: ".concat(name)),
        }
      } else { refuse(st, Calling, b"a global the lowering does not resolve: ".concat(name)) },
    }
  }

/// A read of a slot known to hold the closure of a lambda its owner wrote: the closure itself.
pub fn known(
  cx: Context,
  st: Lowering,
  k: { name: Bytes, slot: Int, lambda: Lambda, owner: Bytes, nth: Int },
  at: Span,
) -> Lowered =
  match st.env.get(k.slot) {
    Some(a) -> { st: st, arg: a },
    None -> refuse(st, Calling, b"a known lambda's slot nothing bound: ".concat(k.name)),
  }

/// A call of definition `full`, which `func` names, on `args`, lowered from `codes`: a pure
/// definition of no parameters read once; a jump where the call is in tail position and the root
/// may jump there; otherwise a call through the convention the callee has at the call's type
/// arguments, a lambda written at a parameter it lends laid out on this frame's stack.
pub fn called(
  cx: Context,
  st: Lowering,
  full: Bytes,
  func: Code,
  codes: List<Code>,
  args: List<Arg>,
  tail: Bool,
  at: Span,
) -> Lowered / {abort.raise} =
  match match func.node { NVar(f) -> def_named(cx, f.name), _ -> None } {
    None -> refuse(st, Calling, b"a call of a name the module does not define: ".concat(full)),
    Some(d) -> if d.full != full {
      refuse(st, Calling, b"a call whose callee resolves elsewhere: ".concat(full))
    } else if args.len() != d.def.arity {
      refuse(st, Calling, b"a call that does not fill its parameters: ".concat(full))
    } else if args.len() == 0 && d.def.pure { constant_read(cx, st, d, at) } else {
      match if tail { jumped(cx, st, d, func.span, codes, args, at) } else { None } {
        Some(j) -> j,
        None -> call(cx, st, d, func.span, codes, args, at),
      }
    },
  }

/// A call of the function value `f` on `args`, through the convention a function of its type has.
pub fn applied(
  cx: Context,
  st: Lowering,
  f: Arg,
  args: List<Arg>,
  tail: Bool,
  at: Span,
) -> Lowered =
  match type_of(f) {
    TyFn(t) -> if t.params.len() != args.len() {
      refuse(st, Calling, b"a function value called with another arity")
    } else {
      let reps = t.params.map(|p: Type| carried_as(carrier_of(p)));
      let answer = carried_as(carrier_of(t.ret));
      if !whole(answer) || !reps.all(whole) {
        refuse(st, Calling, b"a function value taking or answering a record or a sum as its parts")
      } else {
        let h = handed_all(param_called(cx, st, f), args, reps, at);
        handed(
          bound_as(
            h.st,
            t.ret,
            answer,
            Apply({
              f: f,
              args: h.args,
              conv: { params: reps.map(|_: Rep| Given), reps: reps, answer: answer },
              stops: stops_in(t.effects.atoms.len(), t.effects.tail != None),
            }),
            at,
          ),
          held_as(cx.setting, t.ret),
          at,
        )
      }
    },
    _ -> refuse(st, Calling, b"a call of a value of no function type"),
  }

/// The state a body run in place of the call of `func` on `args` is lowered in: the known lambda's
/// frame, its parameters the arguments `lowered` holds and its captures read off its closure, with a
/// step counted as the call it replaces would count one.
pub fn entered(
  cx: Context,
  st: Lowering,
  func: Code,
  args: List<Code>,
  lowered: List<Option<Arg>>,
  which: Option<Int>,
  at: Span,
) -> Opened =
  match which {
    Some(_) -> { cx: cx, st: refuse(st, Calling, b"a step run in place").st },
    None -> match func.node {
      NKnown(k) -> if k.owner != root_name(cx.key) {
        { cx: cx, st: refuse(st, Calling, b"a lambda another root lent, run in place").st }
      } else {
        match st.env.get(k.slot) {
          Some(AVar(f)) -> {
            let ticked = done(st, Op({ op: OCalling(Ticked), args: [], uses: ticks() }), at);
            let caps = range(0, k.lambda.captures.len()).fold(
              { st: ticked, env: Map::new() },
              |acc: { st: Lowering, env: Map<Int, Arg> }, i: Int|
                match k.lambda.captures.at(i) {
                  None -> acc,
                  Some(c) -> {
                    let ty = capture_type(st, k.lambda.at, i);
                    let read = bound_as(acc.st, ty, RWord, Get({ of: f, path: PCapture(i) }), at);
                    let opened = handed(read, held_as(cx.setting, ty), at);
                    { st: opened.st, env: acc.env.insert(c.dst, opened.arg) }
                  },
                },
            );
            {
              cx: { ..cx, answer_ty: lambda_answer(cx, k.lambda) },
              st: {
                ..caps.st,
                env: range(0, lowered.len()).fold(caps.env, |m: Map<Int, Arg>, j: Int|
                  match lowered.at(j) { Some(Some(a)) -> m.insert(j, a), _ -> m }),
              },
            }
          },
          _ ->
            {
              cx: cx,
              st: refuse(st, Calling, b"a known lambda whose closure no variable holds").st,
            },
        }
      },
      _ -> { cx: cx, st: refuse(st, Calling, b"a body run in place that is no known lambda").st },
    },
  }

/// The call's value once the body run in place was lowered to `body` from `entered`'s state: what
/// the body answers, back in the caller's slots.
pub fn left(
  cx: Context,
  before: Lowering,
  entered: Opened,
  body: Lowered,
  which: Option<Int>,
  at: Span,
) -> Lowered = { st: { ..body.st, env: before.env }, arg: body.arg }

/// The state the body of a lambda laid out as `frame` is lowered in, inside `st`: its captures, each
/// opened to its type's representation, and its own parameters, as the closure's function takes
/// them. Its place among the root's closures is taken now, so a lambda it writes comes after it.
pub fn lambda_opened(cx: Context, st: Lowering, frame: Frame, at: Span) -> Opened = {
  let s = shaped(cx, st.env, frame, at);
  if !whole(s.conv.answer) || !s.conv.reps.all(whole) {
    {
      cx: cx,
      st: refuse(st, Calling, b"a lambda taking or answering a record or a sum as its parts").st,
    }
  } else {
    let reserved = with_lambda(
      st,
      Closure({ body: placeholder(cx), captures: s.captures, at: at }),
    ).st;
    let caps = range(0, frame.captures.len()).fold(
      nested(reserved, s.params, Map::new()),
      |acc: Lowering, i: Int|
        match frame.captures.at(i) {
          None -> acc,
          Some(c) -> match s.params.at(i) {
            None -> acc,
            Some(q) -> {
              let opened = handed({ st: acc, arg: AVar(q) }, held_as(cx.setting, q.ty), at);
              { ..opened.st, env: opened.st.env.insert(c.dst, opened.arg) }
            },
          },
        },
    );
    {
      cx: { ..cx, tails: Calls, params: [], types: [], answer: s.answer, answer_ty: s.ret },
      st: {
        ..caps,
        env: range(0, s.own).fold(caps.env, |m: Map<Int, Arg>, j: Int|
          match s.params.at(s.captures + j) { Some(p) -> m.insert(j, AVar(p)), None -> m }),
      },
    }
  }
}

/// The closure of the body lowered to `inner` from `lambda_opened`'s state, made after `outer` of
/// the values it captures, each as its word.
pub fn closure(cx: Context, outer: Lowering, inner: Lowered, frame: Frame, at: Span) -> Lowered = {
  let s = shaped(cx, outer.env, frame, at);
  let nth = outer.lambdas.len();
  let answered = if falls_through(inner.st.insts) { handed(inner, s.conv.answer, at) }
  else { inner };
  let body = {
    key: cx.key,
    kind: Rooted,
    params: s.params,
    conv: s.conv,
    body: if falls_through(answered.st.insts) { answered.st.insts.push(Return(answered.arg)) }
    else { answered.st.insts },
    lambdas: [],
    base: cx.base,
    members: [],
    links: no_links(),
  };
  let after = unnested(outer, answered.st);
  let placed = {
    ..after,
    lambdas: after.lambdas.take(nth).push(
      Closure({ body: body, captures: s.captures, at: at }),
    ).concat(
      after.lambdas.drop(nth + 1),
    ),
  };
  let caps = frame.captures.fold(
    { st: placed, args: [] },
    |acc: { st: Lowering, args: List<Arg> }, c: Capture|
      match acc.st.env.get(c.src) {
        Some(a) -> {
          let h = handed({ st: acc.st, arg: a }, RWord, at);
          { st: h.st, args: acc.args.push(h.arg) }
        },
        None ->
          {
            st: refuse(acc.st, Calling, b"a capture nothing bound").st,
            args: acc.args.push(AZero(RWord)),
          },
      },
  );
  bound_as(
    caps.st,
    s.ty,
    RWord,
    Make({
      made: MClosure({ nth: nth, captures: s.captures, params: s.own, stacked: false }),
      args: caps.args,
      reuse: None,
      kept: [],
    }),
    at,
  )
}

/// The state each member of a tail group is lowered in.
pub fn group_opened(members: List<GroupMember>) -> List<Opened> =
  members.map(|m: GroupMember| { cx: m.cx, st: refuse(started([]), Calling, b"a tail group").st })

/// The group's root from each member's body lowered from `group_opened`'s state.
pub fn grouped(members: List<GroupMember>, bodies: List<Lowered>) -> Result<Fn, Declined> =
  Err({ by: Calling, why: b"a tail group" })

/// A root's body as it is lowered: each read of a slot `let` binds to a lambda, and each of its
/// parameters a specialisation was handed a lambda for, written as the lambda it is known to be, so
/// a call of it runs the lambda in place. A lambda holding a `handle` stays a closure.
pub fn known_body(full: Bytes, params: List<EmitParam>, body: Code) -> Code =
  known_values(
    body,
    range(0, params.len()).fold([], |acc: List<KnownSlot>, i: Int|
      match match params.at(i) { Some(p) -> p.lambda, None -> None } {
        Some(bl) -> if has_handle(bl.code.body) { acc }
        else { acc.push({ slot: i, owner: bl.owner, nth: bl.nth, code: bl.code }) },
        None -> acc,
      }),
    full,
    lambdas_of(body),
  )

/// A definition the root names: its full name and how the emitter reads it.
type Defined = { full: Bytes, def: Def }

/// A call's callee as the root names it, and the type arguments it names it at.
type Reference = { st: Lowering, callee: Callee, args: List<Type> }

/// A closure's body as the lambda's type lays it out: its captures, each a word, then its own
/// parameters as a function of its type carries them; how it answers; and the types of the closure
/// and of its answer.
type Shape = {
  params: List<Var>,
  conv: Convention,
  ty: Type,
  ret: Type,
  answer: Carrier,
  captures: Int,
  own: Int,
}

fn shaped(cx: Context, env: Map<Int, Arg>, frame: Frame, at: Span) -> Shape = {
  let fty = match type_at(cx, at) {
    Some(t) -> match t {
      TyFn(f) -> if f.params.len() == frame.params { Some({ ty: t, params: f.params, ret: f.ret }) }
      else { None },
      _ -> None,
    },
    None -> None,
  };
  let carriers = match fty {
    Some(f) -> f.params.map(carrier_of),
    None -> range(0, frame.params).map(|_: Int| Whole(KBoxed)),
  };
  let answer = match fty { Some(f) -> carrier_of(f.ret), None -> Whole(KBoxed) };
  let n = frame.captures.len();
  let caps = range(0, n).map(|i: Int|
    {
      id: i,
      ty: match frame.captures.at(i) {
        Some(c) -> match env.get(c.src) { Some(a) -> type_of(a), None -> unknown_type() },
        None -> unknown_type(),
      },
      rep: RWord,
    });
  let own = range(0, frame.params).map(|j: Int|
    {
      id: n + j,
      ty: match fty {
        Some(f) -> match f.params.at(j) { Some(t) -> t, None -> unknown_type() },
        None -> unknown_type(),
      },
      rep: match carriers.at(j) { Some(c) -> carried_as(c), None -> RWord },
    });
  let params = caps.concat(own);
  {
    params: params,
    conv: {
      params: params.map(|_: Var| Given),
      reps: params.map(|v: Var| v.rep),
      answer: carried_as(answer),
    },
    ty: match fty { Some(f) -> f.ty, None -> unknown_type() },
    ret: match fty { Some(f) -> f.ret, None -> unknown_type() },
    answer: answer,
    captures: n,
    own: frame.params,
  }
}

/// What a closure's place among the root's closures holds until its body is lowered.
fn placeholder(cx: Context) -> Fn =
  {
    key: cx.key,
    kind: Rooted,
    params: [],
    conv: { params: [], reps: [], answer: RWord },
    body: [],
    lambdas: [],
    base: cx.base,
    members: [],
    links: no_links(),
  }

/// The type capture `i` of the closure written at `at` holds, as its body took it.
fn capture_type(st: Lowering, at: Span, i: Int) -> Type =
  range(0, st.lambdas.len()).fold(unknown_type(), |acc: Type, k: Int|
    match st.lambdas.at(k) {
      Some(Closure(c)) -> if c.at == at && i < c.captures {
        match c.body.params.at(i) { Some(v) -> v.ty, None -> acc }
      } else { acc },
      None -> acc,
    })

/// The type a lambda's body answers, as the checker filed the lambda's.
fn lambda_answer(cx: Context, l: Lambda) -> Type =
  match type_at(cx, l.at) {
    Some(t) -> match t { TyFn(f) -> f.ret, _ -> cx.answer_ty },
    None -> cx.answer_ty,
  }

/// What a pure definition of no parameters answers, read from what the unit keeps of its one run.
fn constant_read(cx: Context, st: Lowering, d: Defined, at: Span) -> Lowered = {
  let ret = answer_type(d.def, []);
  handed(
    bound_as(
      st,
      ret,
      RWord,
      Op({ op: OCalling(ConstantRead(Root(Named(d.full)))), args: [], uses: answers() }),
      at,
    ),
    held_as(cx.setting, ret),
    at,
  )
}

/// A call in tail position as a jump: a restart where it calls the root's own definition at the
/// root's own type arguments, filling every parameter; nothing where the root cannot jump there.
fn jumped(
  cx: Context,
  st: Lowering,
  d: Defined,
  ref: Span,
  codes: List<Code>,
  args: List<Arg>,
  at: Span,
) -> Option<Lowered> / {abort.raise} =
  match cx.tails {
    Restarts -> if definition_of(cx.key) == Some(d.full) && args.len() == cx.params.len()
        && owns(cx, d, ref, fn_args(cx, codes)) {
      let h = handed_all(st, args, convention(cx).reps, at);
      Some({ st: emitted(h.st, Restart(h.args)), arg: AZero(held_as(cx.setting, cx.answer_ty)) })
    } else { None },
    Enters(_) -> None,
    Calls -> None,
  }

/// A call of `d` through the convention it has at the call's type arguments, its answer held as its
/// type is in a body.
fn call(
  cx: Context,
  st: Lowering,
  d: Defined,
  ref: Span,
  codes: List<Code>,
  args: List<Arg>,
  at: Span,
) -> Lowered / {abort.raise} = {
  let n = named_ref(cx, st, d, ref, fn_args(cx, codes));
  let cs = carriers_at(d.def, n.args);
  let reps = cs.params.map(carried_as);
  let answer = carried_as(cs.answer);
  if !whole(answer) || !reps.all(whole) {
    refuse(st, Calling, b"a call crossing a record or a sum as its parts: ".concat(d.full))
  } else {
    let h = handed_all(
      passed(cx, stacked(n.st, d.def.lent, codes, args), d.full, codes, args),
      args,
      reps,
      at,
    );
    let ret = answer_type(d.def, n.args);
    handed(
      bound_as(
        h.st,
        ret,
        answer,
        Call({
          callee: n.callee,
          args: h.args,
          conv: { params: reps.map(|_: Rep| Given), reps: reps, answer: answer },
          stops: match d.def.scheme {
            Some(sc) -> match sc.ty {
              TyFn(f) -> stops_in(f.effects.atoms.len(), f.effects.tail != None),
              _ -> true,
            },
            None -> true,
          },
        }),
        at,
      ),
      held_as(cx.setting, ret),
      at,
    )
  }
}

/// Whether a call of a function whose row names `atoms` operations, or is open, can stop for a
/// handler that may resume it later.
fn stops_in(atoms: Int, open: Bool) -> Bool = atoms > 0 || open

/// Each of `args` held as `reps` says, in order.
fn handed_all(
  st: Lowering,
  args: List<Arg>,
  reps: List<Rep>,
  at: Span,
) -> { st: Lowering, args: List<Arg> } =
  range(0, args.len()).fold(
    { st: st, args: [] },
    |acc: { st: Lowering, args: List<Arg> }, i: Int|
      match args.at(i) {
        Some(a) -> {
          let h = handed(
            { st: acc.st, arg: a },
            match reps.at(i) { Some(r) -> r, None -> RWord },
            at,
          );
          { st: h.st, args: acc.args.push(h.arg) }
        },
        None -> acc,
      },
  )

/// How a reference at `at` names definition `d`: the root being lowered, where it calls its own
/// definition at its own type arguments handing the lambdas it runs; the definition as it stands;
/// or, where the checker gave a generic definition type arguments there or the call hands lambdas
/// a specialisation would run, the body's next generic call, which the unit settles.
fn named_ref(
  cx: Context,
  st: Lowering,
  d: Defined,
  at: Span,
  fns: List<FnArg>,
) -> Reference / {abort.raise} =
  if definition_of(cx.key) == Some(d.full) {
    if owns(cx, d, at, fns) { { st: st, callee: Root(cx.key), args: key_types(cx) } }
    else { { st: st, callee: Root(Named(d.full)), args: [] } }
  } else {
    let given = reference_args(cx, d.def.scheme, at);
    if given.len() == 0 && fns.len() == 0 { { st: st, callee: Root(Named(d.full)), args: [] } }
    else {
      {
        st: {
          ..st,
          links: {
            ..st.links,
            generics: st.links.generics.push({
              callee: d.full,
              args: given.map(spelled_type),
              carried: match d.def.scheme {
                Some(sc) -> carried_vars(sc, given, d.def.arity),
                None -> [],
              },
              fns: fns,
            }),
          },
        },
        callee: Generic(st.links.generics.len()),
        args: given,
      }
    }
  }

/// Whether a reference at `at` of the root's own definition, handing `fns`, names the root itself:
/// always for a definition as it stands; for one at type arguments, where it hands the same lambdas
/// and its type arguments are the root's, or erase to them.
fn owns(cx: Context, d: Defined, at: Span, fns: List<FnArg>) -> Bool / {abort.raise} =
  match cx.key {
    At(a) -> {
      let given = reference_args(cx, d.def.scheme, at);
      let mine = key_types(cx);
      same_fns(a.lent, fns) && given.len() == mine.len()
        && range(0, mine.len()).all(|j: Int|
          match mine.at(j) {
            Some(m) ->
              m == unknown_type()
                || (match given.at(j) { Some(g) -> g == m || erased(g) == m, None -> false }),
            None -> false,
          })
    },
    _ -> true,
  }

/// The type arguments the root is lowered at; none for a definition as it stands.
fn key_types(cx: Context) -> List<Type> =
  match cx.key {
    At(a) -> a.args.map(|k: KeyArg| match k { KeyType(t) -> t, KeyLayout(_) -> unknown_type() }),
    _ -> [],
  }

/// The type a call of `d` at type arguments `args` answers.
fn answer_type(d: Def, args: List<Type>) -> Type =
  match d.scheme {
    Some(sc) -> match sc.ty {
      TyFn(f) -> if sc.ty_vars.len() == 0 || args.len() == 0 { f.ret }
      else { substituted_fully(f.ret, args) },
      _ -> unknown_type(),
    },
    None -> unknown_type(),
  }

/// `st` with each lambda `codes` writes at a parameter the callee lends, and which captures
/// something, laid out on this frame's stack.
fn stacked(st: Lowering, lent: List<Int>, codes: List<Code>, args: List<Arg>) -> Lowering =
  lent.fold(st, |acc: Lowering, i: Int|
    match codes.at(i) {
      Some(c) -> match c.node {
        NLambda(l) -> if l.captures.len() == 0 { acc } else {
          match args.at(i) {
            Some(AVar(v)) ->
              {
                ..acc,
                insts: acc.insts.map(|x: Inst|
                  match x {
                    Let(b) -> if b.var != v { x } else {
                      match b.val {
                        Make(m) -> match m.made {
                          MClosure(k) ->
                            Let({
                              ..b,
                              val: Make({ ..m, made: MClosure({ ..k, stacked: true }) }),
                            }),
                          _ -> x,
                        },
                        _ -> x,
                      }
                    },
                    _ -> x,
                  }),
              },
            _ -> acc,
          }
        },
        _ -> acc,
      },
      None -> acc,
    })

/// `st` noting each parameter of the root that may hold a function and that the call of `callee`
/// hands on as itself, by the argument it is.
fn passed(
  cx: Context,
  st: Lowering,
  callee: Bytes,
  codes: List<Code>,
  args: List<Arg>,
) -> Lowering =
  if cx.tails == Calls { st } else {
    range(0, codes.len()).fold(st, |acc: Lowering, i: Int|
      match codes.at(i) {
        Some(c) -> match c.node {
          NVar(v) -> if v.slot == None { acc } else {
            match args.at(i) {
              Some(AVar(p)) -> if p.id < cx.params.len() && may_be_called(cx, p.id) {
                {
                  ..acc,
                  links: {
                    ..acc.links,
                    passes: acc.links.passes.push({ param: p.id, callee: callee, at: i }),
                  },
                }
              } else { acc },
              _ -> acc,
            }
          },
          _ -> acc,
        },
        None -> acc,
      })
  }

/// `st` noting that the body calls parameter `f` is, where it is one of the root's.
fn param_called(cx: Context, st: Lowering, f: Arg) -> Lowering =
  match f {
    AVar(p) -> if cx.tails == Calls || p.id >= cx.params.len() || st.links.called.contains(p.id) {
      st
    } else { { ..st, links: { ..st.links, called: st.links.called.push(p.id) } } },
    _ -> st,
  }

/// Whether parameter `j` of the root may hold a function: its type is one, a variable, or unknown.
fn may_be_called(cx: Context, j: Int) -> Bool =
  match cx.types.at(j) {
    Some(t) -> match t { TyFn(_) -> true, TyVar(_) -> true, _ -> false },
    None -> true,
  }

/// The lambdas among a call's `codes`, each by its argument's place, which a callee's
/// specialisation reads and runs: a literal one where the root lends its lambdas, one known to a
/// slot, another root's wherever it is handed on, and a definition named as a value as the lambda
/// around a call of it.
fn fn_args(cx: Context, codes: List<Code>) -> List<FnArg> / {abort.raise} = {
  let owner = root_name(cx.key);
  let lends = lends_lambdas(cx);
  let handed_as = |j: Int, l: Lambda, acc: List<FnArg>|
    if !lends || has_handle(l.body) { acc } else {
      match position_in(written_in(cx), l) {
        Some(nth) -> acc.push({ param: j, owner: owner, nth: nth }),
        None -> acc,
      }
    };
  range(0, codes.len()).fold([], |acc: List<FnArg>, j: Int|
    match codes.at(j) {
      Some(c) -> match c.node {
        NLambda(l) -> handed_as(j, l, acc),
        NKnown(k) -> if k.owner != owner || lends {
          acc.push({ param: j, owner: k.owner, nth: k.nth })
        } else { acc },
        NVar(_) -> match named_arity(cx, c) {
          Some(n) -> handed_as(j, named_lambda(c, n), acc),
          None -> acc,
        },
        _ -> acc,
      },
      None -> acc,
    })
}

/// Whether a lambda of the root can be read again where another root runs it: the root is a test,
/// a definition of no type variable as it stands, or one at type arguments that are all known and
/// that runs no lambda of another root itself.
fn lends_lambdas(cx: Context) -> Bool / {abort.raise} = {
  let owner = root_name(cx.key);
  is_test_owner(owner)
    || (owner.index_of(b"#") == None
    && (match cx.key {
      At(a) ->
        a.lent.len() == 0 && owner.index_of(b"|") == None
          && key_types(cx).all(|t: Type| t != unknown_type() && !has_vars(t)),
      Named(_) -> match cx.setting.here.fold(None, |acc: Option<Def>, d: Def|
          if qualify(cx.setting.module, d.name) == owner { Some(d) } else { acc }) {
        Some(d) -> match d.scheme { Some(sc) -> sc.ty_vars.len() == 0, None -> true },
        None -> false,
      },
      _ -> false,
    }))
}

/// What the root lends: the lambdas its body writes, then each definition it hands a definition as a
/// value, as the lambda around a call of it.
fn written_in(cx: Context) -> List<Lambda> / {abort.raise} =
  lambdas_of(cx.body).concat(named_in(cx, cx.body))

/// How many arguments the definition `c` names as a value takes; none where `c` is not a
/// definition named as a value, or takes a witness or a label a call would fill.
fn named_arity(cx: Context, c: Code) -> Option<Int> / {abort.raise} =
  match c.node {
    NVar(v) -> if v.slot != None { None } else {
      match def_named(cx, v.name) {
        Some(d) -> match d.def.scheme {
          Some(sc) -> match sc.ty {
            TyFn(f) -> if d.def.witnesses == 0 && f.params.len() == d.def.arity {
              Some(d.def.arity)
            } else { None },
            _ -> None,
          },
          None -> None,
        },
        None -> None,
      }
    },
    _ -> None,
  }

/// The lambda around a call of the definition `c` names, which takes `n` arguments.
fn named_lambda(c: Code, n: Int) -> Lambda = {
  let at = |own: Own, node: Node| { own: own, node: node, span: c.span };
  {
    params: n,
    size: n,
    captures: [],
    at: c.span,
    body: at(
      Borrowed,
      NApp({
        func: { ..c, own: Borrowed },
        args: range(0, n).map(|i: Int|
          at(Owned, NVar({ name: b"p".concat(ascii_of_int(i)), slot: Some(i) }))),
      }),
    ),
  }
}

/// Each definition `c` hands a definition as a value, as `named_lambda` reads it, in one fixed order.
fn named_in(cx: Context, c: Code) -> List<Lambda> / {abort.raise} = {
  let within = |codes: List<Code>|
    codes.fold([], |acc: List<Lambda>, x: Code| acc.concat(named_in(cx, x)));
  match c.node {
    NApp(a) -> {
      let callee = match a.func.node {
        NVar(v) -> v.slot == None && def_named(cx, v.name) != None,
        _ -> false,
      };
      let handed = if !callee { [] } else {
        a.args.fold([], |acc: List<Lambda>, x: Code|
          match named_arity(cx, x) { Some(n) -> acc.push(named_lambda(x, n)), None -> acc })
      };
      handed.concat(within(a.args.push(a.func)))
    },
    NLambda(l) -> named_in(cx, l.body),
    NUnary(u) -> named_in(cx, u.operand),
    NBinary(b) -> within([b.lhs, b.rhs]),
    NField(f) -> named_in(cx, f.base),
    NIf(i) -> within([i.cond, i.then_branch, i.else_branch]),
    NBlock(b) ->
      within(
        b.stmts.fold(
          match b.tail { Some(t) -> [t], None -> [] },
          |acc: List<Code>, stmt: CodeStmt|
            acc.push(match stmt { CLet(l) -> l.value, CLetPat(l) -> l.value, CDo(d) -> d.code }),
        ),
      ),
    NList(l) -> within(l.items),
    NRecord(r) -> within(r.fields.map(|f: CodeField| f.value)),
    NUpdate(u) -> within(u.sets.map(|f: CodeField| f.value).push(u.base)),
    NMatch(m) ->
      within(
        m.arms.fold([m.scrutinee], |acc: List<Code>, a: CodeArm|
          List::push(match a.guard { Some(g) -> acc.push(g), None -> acc }, a.body)),
      ),
    NPerform(x) -> within(x.args),
    NSimulate(x) -> named_in(cx, x.body),
    NParallel(x) -> within(x.branches),
    NHandle(h) ->
      within(
        h.clauses.fold(
          match h.ret { Some(r) -> [h.body, r.body], None -> [h.body] },
          |acc: List<Code>, cl: CodeClause| acc.push(cl.body),
        ),
      ),
    _ -> [],
  }
}

/// The lambdas `c` writes, at any depth, each before those its body writes, in one fixed order.
fn lambdas_of(c: Code) -> List<Lambda> = {
  let within = |codes: List<Code>|
    codes.fold([], |acc: List<Lambda>, x: Code| acc.concat(lambdas_of(x)));
  match c.node {
    NLambda(l) -> [l].concat(lambdas_of(l.body)),
    NUnary(u) -> lambdas_of(u.operand),
    NBinary(b) -> within([b.lhs, b.rhs]),
    NField(f) -> lambdas_of(f.base),
    NApp(a) -> within(a.args.push(a.func)),
    NIf(i) -> within([i.cond, i.then_branch, i.else_branch]),
    NBlock(b) ->
      within(
        b.stmts.fold(
          match b.tail { Some(t) -> [t], None -> [] },
          |acc: List<Code>, stmt: CodeStmt|
            acc.push(match stmt { CLet(l) -> l.value, CLetPat(l) -> l.value, CDo(d) -> d.code }),
        ),
      ),
    NList(l) -> within(l.items),
    NRecord(r) -> within(r.fields.map(|f: CodeField| f.value)),
    NUpdate(u) -> within(u.sets.map(|f: CodeField| f.value).push(u.base)),
    NMatch(m) ->
      within(
        m.arms.fold([m.scrutinee], |acc: List<Code>, a: CodeArm|
          List::push(match a.guard { Some(g) -> acc.push(g), None -> acc }, a.body)),
      ),
    NPerform(x) -> within(x.args),
    NSimulate(x) -> lambdas_of(x.body),
    NParallel(x) -> within(x.branches),
    NHandle(h) ->
      within(
        h.clauses.fold(
          match h.ret { Some(r) -> [h.body, r.body], None -> [h.body] },
          |acc: List<Code>, cl: CodeClause| acc.push(cl.body),
        ),
      ),
    _ -> [],
  }
}

/// Where `l` first stands in `ls`.
fn position_in(ls: List<Lambda>, l: Lambda) -> Option<Int> =
  range(0, ls.len()).fold(None, |acc: Option<Int>, k: Int|
    match acc { Some(_) -> acc, None -> if ls.at(k) == Some(l) { Some(k) } else { None } })

fn has_handle(c: Code) -> Bool = {
  let within = |codes: List<Code>| codes.fold(false, |acc: Bool, x: Code| acc || has_handle(x));
  match c.node {
    NHandle(_) -> true,
    NUnary(u) -> has_handle(u.operand),
    NBinary(b) -> within([b.lhs, b.rhs]),
    NField(f) -> has_handle(f.base),
    NApp(a) -> within(a.args.push(a.func)),
    NIf(i) -> within([i.cond, i.then_branch, i.else_branch]),
    NBlock(b) ->
      (match b.tail { Some(t) -> has_handle(t), None -> false })
        || b.stmts.fold(false, |acc: Bool, stmt: CodeStmt|
          acc
            || (match stmt {
              CLet(l) -> has_handle(l.value),
              CLetPat(l) -> has_handle(l.value),
              CDo(d) -> has_handle(d.code),
            })),
    NList(l) -> within(l.items),
    NRecord(r) -> within(r.fields.map(|f: CodeField| f.value)),
    NUpdate(u) -> within(u.sets.map(|f: CodeField| f.value).push(u.base)),
    NMatch(m) ->
      has_handle(m.scrutinee)
        || m.arms.fold(false, |acc: Bool, a: CodeArm|
          acc || (match a.guard { Some(g) -> has_handle(g), None -> false }) || has_handle(a.body)),
    NPerform(p) -> within(p.args),
    NLambda(l) -> has_handle(l.body),
    NSimulate(x) -> has_handle(x.body),
    NKnown(k) -> has_handle(k.lambda.body),
    NParallel(pr) -> within(pr.branches),
    _ -> false,
  }
}

/// A slot known to hold `owner`'s `nth` lambda, whose code is `code`.
type KnownSlot = { slot: Int, owner: Bytes, nth: Int, code: Lambda }

/// `c`, code of the root `owner`, with each read of a slot `bound` names written as the lambda it is
/// known to be, through lambdas that capture the slot. A slot a `let` binds to a lambda, or to such
/// a read, is known for the rest of its block. `own` is the root's lambdas before any is rewritten,
/// which is what numbers them.
fn known_values(c: Code, bound: List<KnownSlot>, owner: Bytes, own: List<Lambda>) -> Code = {
  let go = |x: Code| known_values(x, bound, owner, own);
  let known = |slot: Int|
    bound.fold(None, |found: Option<KnownSlot>, k: KnownSlot|
      if k.slot == slot { Some(k) } else { found });
  let inside = |caps: List<Capture>|
    caps.fold([], |acc: List<KnownSlot>, cap: Capture|
      match known(cap.src) { Some(k) -> acc.push({ ..k, slot: cap.dst }), None -> acc });
  let maybe = |x: Option<Code>| match x { Some(y) -> Some(go(y)), None -> None };
  let node = match c.node {
    NVar(v) -> match match v.slot { Some(sl) -> known(sl), None -> None } {
      Some(k) -> NKnown({ name: v.name, slot: k.slot, lambda: k.code, owner: k.owner, nth: k.nth }),
      None -> c.node,
    },
    NApp(a) -> NApp({ func: go(a.func), args: a.args.map(go) }),
    NUnary(u) -> NUnary({ ..u, operand: go(u.operand) }),
    NBinary(b) -> NBinary({ ..b, lhs: go(b.lhs), rhs: go(b.rhs) }),
    NIf(i) ->
      NIf({ cond: go(i.cond), then_branch: go(i.then_branch), else_branch: go(i.else_branch) }),
    NBlock(b) -> {
      let walked = b.stmts.fold(
        { bound: bound, stmts: [] },
        |acc: { bound: List<KnownSlot>, stmts: List<CodeStmt> }, stmt: CodeStmt|
          match stmt {
            CLet(l) -> {
              let value = known_values(l.value, acc.bound, owner, own);
              let rest = acc.bound.filter(|k: KnownSlot| k.slot != l.slot);
              {
                bound: match value.node {
                  NLambda(lam) -> match match l.value.node {
                      NLambda(written) -> position_in(own, written),
                      _ -> None,
                    } {
                    Some(nth) -> if has_handle(lam.body) { rest }
                    else { rest.push({ slot: l.slot, owner: owner, nth: nth, code: lam }) },
                    None -> rest,
                  },
                  NKnown(k) ->
                    rest.push({ slot: l.slot, owner: k.owner, nth: k.nth, code: k.lambda }),
                  _ -> rest,
                },
                stmts: acc.stmts.push(CLet({ ..l, value: value })),
              }
            },
            CLetPat(l) ->
              {
                bound: acc.bound,
                stmts: acc.stmts.push(
                  CLetPat({ ..l, value: known_values(l.value, acc.bound, owner, own) }),
                ),
              },
            CDo(d) ->
              {
                bound: acc.bound,
                stmts: acc.stmts.push(CDo({ code: known_values(d.code, acc.bound, owner, own) })),
              },
          },
      );
      NBlock({
        stmts: walked.stmts,
        tail: match b.tail {
          Some(t) -> Some(known_values(t, walked.bound, owner, own)),
          None -> None,
        },
      })
    },
    NList(l) -> NList({ items: l.items.map(go) }),
    NRecord(r) -> NRecord({ fields: r.fields.map(|f: CodeField| { ..f, value: go(f.value) }) }),
    NMatch(m) ->
      NMatch({
        scrutinee: go(m.scrutinee),
        arms: m.arms.map(|a: CodeArm| { ..a, guard: maybe(a.guard), body: go(a.body) }),
      }),
    NPerform(x) -> NPerform({ ..x, label: maybe(x.label), args: x.args.map(go) }),
    NLambda(l) -> NLambda({ ..l, body: known_values(l.body, inside(l.captures), owner, own) }),
    NSimulate(x) -> NSimulate({ ..x, body: known_values(x.body, inside(x.captures), owner, own) }),
    NParallel(pr) -> NParallel({ ..pr, branches: pr.branches.map(go) }),
    NField(f) -> NField({ ..f, base: go(f.base) }),
    NUpdate(u) ->
      NUpdate({
        ..u,
        base: go(u.base),
        sets: u.sets.map(|f: CodeField| { ..f, value: go(f.value) }),
      }),
    other -> other,
  };
  { ..c, node: node }
}

/// What an operation that answers a word of its own and can fail does with its operands: it has none.
fn answers() -> { takes: List<Bool>, owned: Bool, fails: Bool, stops: Bool } =
  { takes: [], owned: true, fails: true, stops: false }

/// A step counted, which can fail where the run is cancelled, and answers nothing.
fn ticks() -> { takes: List<Bool>, owned: Bool, fails: Bool, stops: Bool } =
  { takes: [], owned: false, fails: true, stops: false }

/// Whether a value held as `r` crosses as one value of its own, not as a record's or a sum's parts.
fn whole(r: Rep) -> Bool = match r { RFlat(_) -> false, RCases(_) -> false, _ -> true }

/// Whether `args` are what `iterate` runs in place: a seed, a budget, and a step of one parameter.
fn stepped(args: List<Code>) -> Bool =
  args.len() == 3
    && (match args.at(2) {
      Some(c) -> match c.node { NLambda(l) -> l.params == 1, _ -> false },
      None -> false,
    })

/// The builtin a call of `name` reaches: an import's extern by its own name, else `name`.
fn extern_named(cx: Context, name: Bytes) -> Bytes / {abort.raise} =
  match imported_target(cx.setting.imports, name) {
    Some(t) -> if cx.setting.builtins.contains(t.name) { t.name } else { name },
    None -> name,
  }

/// The definition `name` names in the root's module: its own first, then what an import reaches.
fn def_named(cx: Context, name: Bytes) -> Option<Defined> / {abort.raise} =
  if is_ctor_name(name) { None } else {
    match cx.setting.here.fold(None, |acc: Option<Def>, d: Def|
        if d.name == name { Some(d) } else { acc }) {
      Some(d) -> Some({ full: qualify(cx.setting.module, name), def: d }),
      None -> match imported_target(cx.setting.imports, name) {
        None -> None,
        Some(t) -> match t.imp.defs.fold(None, |acc: Option<Def>, d: Def|
            if d.name == t.name { Some(d) } else { acc }) {
          Some(d) -> Some({ full: qualify(t.imp.module, t.name), def: d }),
          None -> None,
        },
      },
    }
  }

/// The type arguments the checker gave a reference of a generic definition at `at`; none where it
/// gave none or not one for each of the scheme's variables.
fn reference_args(cx: Context, scheme: Option<Scheme>, at: Span) -> List<Type> =
  match scheme {
    None -> [],
    Some(sc) -> if sc.ty_vars.len() == 0 { [] } else {
      match cx.setting.typed.get(span_key(at)) {
        Some(t) -> if t.args.len() == sc.ty_vars.len() { t.args } else { [] },
        None -> [],
      }
    },
  }

// Copies of the emitter's private conventions and name resolution (`emit.ply`), listed in the
// hooks file.

/// How a root of `d` at type arguments `args` takes each parameter and answers.
fn carriers_at(
  d: Def,
  args: List<Type>,
) -> { params: List<Carrier>, answer: Carrier } / {abort.raise} =
  match d.scheme {
    None -> { params: d.carriers, answer: d.answer },
    Some(sc) -> match sc.ty {
      TyFn(f) -> {
        let raw = carried_vars(sc, args, d.arity);
        let at_var = |t: Type, otherwise: Carrier|
          match t {
            TyVar(j) -> if raw.contains(j) { carrier_of(erased(args.get(j))) } else { otherwise },
            _ -> otherwise,
          };
        {
          params: range(0, d.carriers.len()).map(|i: Int| {
            let k = d.carriers.get(i);
            if i < d.witnesses { k }
            else { match f.params.at(i - d.witnesses) { Some(t) -> at_var(t, k), None -> k } }
          }),
          answer: at_var(f.ret, d.answer),
        }
      },
      _ -> { params: d.carriers, answer: d.answer },
    },
  }

/// The variables of `scheme` a call at `args` carries raw: each standing bare as a parameter, or as
/// the answer of a function taking any, at an argument whose word would be an allocation.
fn carried_vars(scheme: Scheme, args: List<Type>, arity: Int) -> List<Int> / {abort.raise} =
  match scheme.ty {
    TyFn(f) ->
      range(0, args.len()).filter(|j: Int|
        (f.params.contains(TyVar(j)) || (arity > 0 && f.ret == TyVar(j)))
          && (match carrier_of(erased(args.get(j))) { Whole(k) -> k != KBoxed, _ -> true })),
    _ -> [],
  }

fn same_fns(a: List<FnArg>, b: List<FnArg>) -> Bool =
  a.len() == b.len() && a.all(|f: FnArg| b.contains(f))

/// `ty` with each variable read as the type argument at its number.
fn substituted_fully(ty: Type, args: List<Type>) -> Type =
  match ty {
    TyVar(v) -> match args.at(v) { Some(t) -> t, None -> ty },
    TyCon(c) -> TyCon({ ..c, args: c.args.map(|a: Type| substituted_fully(a, args)) }),
    TyFn(f) ->
      TyFn({
        ..f,
        params: f.params.map(|p: Type| substituted_fully(p, args)),
        ret: substituted_fully(f.ret, args),
      }),
    TyRecord(fs) -> TyRecord(fs.map(|f: Field| { ..f, ty: substituted_fully(f.ty, args) })),
    TyNominal(x) ->
      TyNominal({
        ..x,
        args: x.args.map(|a: Type| substituted_fully(a, args)),
        fields: x.fields.map(|f: Field| { ..f, ty: substituted_fully(f.ty, args) }),
      }),
  }

fn imported_target(imports: List<Imported>, name: Bytes) -> Option<{ imp: Imported, name: Bytes }> =
  match match qualified(name) {
      Some(q) -> match module_import(imports, q.binder) {
        Some(imp) -> Some({ imp: imp, name: q.name }),
        None -> None,
      },
      None -> match from_import(imports, name) {
        Some(imp) -> Some({ imp: imp, name: name }),
        None -> None,
      },
    } {
    Some(t) -> Some(t),
    None -> match module_import(imports, prelude_binder()) {
      Some(imp) -> if imp.defs.fold(false, |found: Bool, d: Def| found || d.name == name) {
        Some({ imp: imp, name: name })
      } else { None },
      None -> None,
    },
  }

fn qualified(name: Bytes) -> Option<{ binder: Bytes, name: Bytes }> =
  range(0, name.len() - 1).fold(None, |acc: Option<{ binder: Bytes, name: Bytes }>, i: Int|
    match acc {
      Some(_) -> acc,
      None -> if name.at(i) == 58 && name.at(i + 1) == 58 {
        Some({ binder: name.slice(0, i), name: name.slice(i + 2, name.len()) })
      } else { None },
    })

fn from_import(xs: List<Imported>, name: Bytes) -> Option<Imported> =
  xs.fold(None, |acc: Option<Imported>, i: Imported|
    if !i.whole && i.name == name { Some(i) } else { acc })

fn module_import(xs: List<Imported>, binder: Bytes) -> Option<Imported> =
  xs.fold(None, |acc: Option<Imported>, i: Imported|
    if i.whole && i.name == binder { Some(i) } else { acc })

fn is_ctor_name(name: Bytes) -> Bool / {abort.raise} =
  name.index_of(b"#") == None
    && starts_upper(match qualified(name) {
      Some(q) -> q.name,
      None -> if name.index_of(b".") == None { name } else {
        let dot = range(0, name.len()).fold(0, |acc: Int, i: Int|
          if name.at(i) == 46 { i } else { acc });
        name.slice(dot + 1, name.len())
      },
    })
