//! `perform`, labels, `handle`, `parallel` and `simulate`.

import code (Code, CodeClause, CodeReturn)
import parsing (Span)
import emit.tir (Arg, Handling)
import emit.lower.base (Context, Lowering, Lowered, Frame, ClauseMade, refuse)

/// Operation `op` of `effect` performed on `resource` with `args`, at `label` where one is read.
pub fn performed(
  cx: Context,
  st: Lowering,
  p: { effect: Bytes, op: Bytes, resource: Bytes },
  label: Option<Arg>,
  args: List<Arg>,
  at: Span,
) -> Lowered =
  refuse(st, Handling, b"a perform")

/// The field-table entry of resource `name`, as a call's label argument.
pub fn label(cx: Context, st: Lowering, name: Bytes, at: Span) -> Lowered =
  refuse(st, Handling, b"a label")

/// How clause `clause`'s body is laid out as a function of its own.
pub fn clause_frame(cx: Context, clause: CodeClause) -> Frame =
  { params: clause.params, size: clause.size, captures: clause.captures }

/// How a `handle`'s body is laid out as a function of its own where it runs detached, on a stack of
/// its own; nothing where it runs in place.
pub fn body_frame(cx: Context, h: { body: Code, clauses: List<CodeClause>, ret: Option<CodeReturn> }) -> Option<Frame> =
  None

/// The `handle` `h`, its body lowered to `body` (in a block of its own, or as a closure where
/// `body_frame` says it runs detached), its clauses and return clause made.
pub fn handled(
  cx: Context,
  st: Lowering,
  body: Lowered,
  clauses: List<ClauseMade>,
  ret: Option<Arg>,
  h: { body: Code, clauses: List<CodeClause>, ret: Option<CodeReturn> },
  at: Span,
) -> Lowered =
  refuse(body.st, Handling, b"a handle")

/// A `parallel` block of the closures `branches`.
pub fn branched(cx: Context, st: Lowering, branches: List<Arg>, rooted: Bool, at: Span) -> Lowered =
  refuse(st, Handling, b"a parallel block")

/// A `simulate` of the nullary closure `body`.
pub fn simulated(cx: Context, st: Lowering, body: Arg, at: Span) -> Lowered =
  refuse(st, Handling, b"a simulate")
