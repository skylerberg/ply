//! The typed form checked before it is printed: every count a body holds is consumed exactly once on
//! every path, a borrowed value is read only while what it was read out of is held, a value that
//! can fail names exactly what its failure path releases, each join is set once on every path
//! into it with a value held as the join is, and each operand is held as its operation takes it.
//! A body that breaks one is refused, which fails a build.

import emit.tir (Rep, RWord, RInt, RBool, RMaybe, RTagged, RFlat, RCases, RToken, Leaf, Var, Arg,
                 AVar, AInt, ABool, Val, Call, Apply, Make, Pack, Gathered, Native, Op, Get, Take,
                 Static, Prim, Path, PLeaf, PField, PArg, Made, MRecord, MCtor, MClosure, Inst, Let,
                 Do, Decl, Assign, If, Case, Match, Miss, Loop, Next, Done, Return, Restart, Enter,
                 Fail, NoArm, Handle, Sited, Inc, Dec, Reset, Free, Opened, Block, Fn, Rooted,
                 Lambda, Closure, Handed, Given, Lent, Convention, Answered, Owns, ReadsOf, Lasts,
                 no_links, counted, operands, answered, fails, used_as, rep_of_arg, var_of,
                 parts_of, Test, TTag)
import emit.keys (Named, Root)
import types (TyCon)
import parsing (dummy_span)
import std.bytes (ascii_of_int)

/// What a path holds: the counts of each owned variable, the variable each borrowed one was read out
/// of (`-1` for a constant or a lent parameter, which outlast the body), each join declared on it
/// and whether it was set, the words of each value opened, the word each read of an opened
/// value's counted leaf is, the captures of each closure laid on this frame's stack, the fields
/// taken out of each block, and the block each reuse token holds the cells of.
type Holding = {
  owned: Map<Int, Int>,
  borrowed: Map<Int, Int>,
  joins: Map<Int, Bool>,
  opened: Map<Int, List<Var>>,
  alias: Map<Int, Var>,
  stacks: Map<Int, List<Var>>,
  taken: Map<Int, List<Path>>,
  cells: Map<Int, Int>,
}

/// A walk so far: what the path holds, the first fault found, whether control reaches here, what
/// the path held where the match arm being walked first missed, and whether the loop being walked
/// has been left by `Done`.
type Walk = { h: Holding, fault: Option<Bytes>, live: Bool, missed: Option<Holding>, done: Bool }

/// What encloses a block: the loop its `Next` and `Done` belong to; what a `handle` around it
/// holds across its body, which a failure inside it leaves to the handle's landing; whether a
/// `Miss` leaves it for a match's next arm; whether it is inside a `handle`'s body, which only
/// its end and a failure leave; how a `Return` answers; and the member of a tail group whose arm it
/// is in, which a `Restart` enters again.
type Within = {
  looped: Option<Looped>,
  landing: Map<Int, Int>,
  arm: Bool,
  handled: Bool,
  answer: Rep,
  member: Option<Int>,
}

/// A loop's state and answer, and the counts it holds across its passes, which each `Next` and
/// `Done` must leave held and nothing else.
type Looped = { held: Map<Int, Int>, state: List<Var>, answer: Var }

/// Why `f`, or a closure it makes, breaks a rule of the form, or nothing where both keep them all.
/// A tail group's arm `i` starts holding member `i`'s parameters and answers as that member does.
pub fn verified(f: Fn) -> Option<Bytes> = {
  let top = {
    looped: None,
    landing: Map::new(),
    arm: false,
    handled: false,
    answer: f.conv.answer,
    member: None,
  };
  let own = if f.members.len() == 0 { body_fault(f, top, holding_params(f.params, f.conv), f.body) }
  else {
    match f.body {
      [Case(c)] ->
        c.arms.fold(
          body_fault(f, top, holding_params([], f.conv), c.rest),
          |why: Option<Bytes>, a: { when: Int, body: Block }|
            match why {
              Some(_) -> why,
              None -> match f.members.at(a.when) {
                None -> Some(b"an arm of no member of the group"),
                Some(m) ->
                  body_fault(
                    f,
                    { ..top, answer: m.conv.answer, member: Some(a.when) },
                    holding_params(m.params, m.conv),
                    a.body,
                  ),
              },
            },
        ),
      _ -> Some(b"a tail group whose body is no case on its member's place"),
    }
  };
  f.lambdas.fold({ n: 0, why: own }, |s: { n: Int, why: Option<Bytes> }, l: Lambda|
    {
      n: s.n + 1,
      why: match s.why {
        Some(_) -> s.why,
        None -> match l {
          Closure(c) -> match verified(c.body) {
            Some(why) -> Some(Bytes::concat_all([b"in closure ", ascii_of_int(s.n), b": ", why])),
            None -> None,
          },
        },
      },
    }).why
}

/// What a body holds at its start: a count of each counted parameter `conv` gives it, and each one it
/// lends borrowed.
fn holding_params(params: List<Var>, conv: Convention) -> Holding =
  range(0, params.len()).fold(
    {
      owned: Map::new(),
      borrowed: Map::new(),
      joins: Map::new(),
      opened: Map::new(),
      alias: Map::new(),
      stacks: Map::new(),
      taken: Map::new(),
      cells: Map::new(),
    },
    |h: Holding, i: Int|
      match params.at(i) {
        None -> h,
        Some(p) -> if !counted(p.rep) { h } else if conv.params.at(i) == Some(Lent) {
          { ..h, borrowed: h.borrowed.insert(p.id, 0 - 1) }
        } else { { ..h, owned: h.owned.insert(p.id, 1) } },
      },
  )

/// Why body `b`, walked under `cx` from `start`, breaks a rule, or falls off its end.
fn body_fault(f: Fn, cx: Within, start: Holding, b: Block) -> Option<Bytes> = {
  let w = walked(f, cx, { h: start, fault: None, live: true, missed: None, done: false }, b);
  match w.fault {
    Some(why) -> Some(why),
    None -> if w.live { Some(b"a body that falls off its end without answering") } else { None },
  }
}

/// Whether `args` are held as member `member` of `f`'s group takes them; a root of its own's restart
/// is not checked here.
fn entered_as(f: Fn, member: Option<Int>, args: List<Arg>) -> Bool =
  match member {
    None -> true,
    Some(i) -> match f.members.at(i) { Some(m) -> held_as_reps(args, m.conv.reps), None -> false },
  }

/// Whether `args` are held as `reps` say, one for one.
fn held_as_reps(args: List<Arg>, reps: List<Rep>) -> Bool =
  args.len() == reps.len()
    && range(0, args.len()).all(|i: Int|
      match args.at(i) {
        Some(a) -> match reps.at(i) { Some(r) -> same_rep(a, r), None -> false },
        None -> false,
      })

/// The one recursion: each instruction in turn, a branch's blocks walked from the state before it
/// and joined after it.
fn walked(f: Fn, cx: Within, w: Walk, b: Block) -> Walk =
  b.fold(w, |acc: Walk, i: Inst|
    if acc.fault != None || !acc.live { acc } else {
      match i {
        Let(l) -> match field_fault(
            acc.h,
            match cx.looped { Some(lp) -> lp.held, None -> Map::new() },
            l.var,
            l.val,
          ) {
          Some(f) -> faulted(acc, f.why, f.v),
          None ->
            noted_take(
              match token_in(read_args(l.val)) {
                Some(t) -> faulted(acc, b"a reuse token read as a value: v", t),
                None -> match word_read(acc, l.var, l.val) {
                  Some(w) -> w,
                  None -> match escaping(acc.h, l.val) {
                    Some(c) ->
                      faulted(
                        acc,
                        b"a closure on this frame's stack handed beyond the call it is lent to: v",
                        c,
                      ),
                    None -> match stacked_captures(l.val) {
                      Some(caps) -> {
                        let read = failing(cx, used(acc, operands(l.val)), l.val, l.unwind);
                        {
                          ..read,
                          h: {
                            ..read.h,
                            stacks: read.h.stacks.insert(
                              l.var.id,
                              caps.fold([], |vs: List<Var>, a: Arg|
                                match var_of(a) {
                                  Some(v) -> if counted(v.rep) { vs.push(v) } else { vs },
                                  None -> vs,
                                }),
                            ),
                          },
                        }
                      },
                      None -> match held_otherwise(l.var, l.val) {
                        Some(why) -> faulted(acc, why, l.var),
                        None ->
                          result(
                            failing(cx, used(acc, operands(l.val)), l.val, l.unwind),
                            l.var,
                            answered(l.val),
                          ),
                      },
                    },
                  },
                },
              },
              l.val,
            ),
        },
        Do(d) -> match token_in(read_args(d.val)) {
          Some(t) -> faulted(acc, b"a reuse token read as a value: v", t),
          None -> if taken_whole(acc.h, read_args(d.val)) != None {
            { ..acc, fault: Some(b"a block used whole after a field was taken out of it") }
          } else if escaping(acc.h, d.val) != None {
            {
              ..acc,
              fault: Some(b"a closure on this frame's stack handed beyond the call it is lent to"),
            }
          } else if answers_count(d.val) {
            { ..acc, fault: Some(b"a value whose count nothing holds") }
          } else { failing(cx, used(acc, operands(d.val)), d.val, d.unwind) },
        },
        Decl(v) -> { ..acc, h: { ..acc.h, joins: acc.h.joins.insert(v.id, false) } },
        Assign(s) -> match acc.h.joins.get(s.var.id) {
          Some(false) -> if !same_rep(s.arg, s.var.rep) {
            faulted(acc, b"a join set from a value held otherwise: v", s.var)
          } else {
            let consumed = passed(acc, s.arg);
            {
              ..consumed,
              h: {
                ..consumed.h,
                joins: consumed.h.joins.insert(s.var.id, true),
                owned: if counted(s.var.rep) { consumed.h.owned.insert(s.var.id, 1) }
                else { consumed.h.owned },
              },
            }
          },
          Some(true) -> faulted(acc, b"a join set twice on one path: v", s.var),
          None -> faulted(acc, b"a join set before it is declared: v", s.var),
        },
        If(x) -> {
          let read = held(acc, x.cond);
          joined(read, walked(f, cx, read, x.then), walked(f, cx, read, x.otherwise))
        },
        Case(c) -> if !names_each(c.test, c.arms.map(|a: { when: Int, body: Block }| a.when)) {
          faulted(acc, b"a case arm for a constructor its test does not name: v", c.on)
        } else {
          let read = read_of(acc, c.on);
          c.arms.fold(walked(f, cx, read, c.rest), |j: Walk, a: { when: Int, body: Block }|
            joined(read, j, walked(f, cx, read, a.body)))
        },
        Match(m) -> {
          let tried = m.arms.fold(
            { from: Some(acc.h), out: { ..acc, live: false } },
            |s: { from: Option<Holding>, out: Walk }, a: Block|
              if s.out.fault != None { s } else {
                match s.from {
                  None -> s,
                  Some(h) -> {
                    let w = walked(
                      f,
                      { ..cx, arm: true },
                      { ..acc, h: entered(acc, h), missed: None },
                      a,
                    );
                    if w.fault != None { { from: None, out: w } } else {
                      { from: w.missed, out: joined(acc, s.out, { ..w, missed: acc.missed }) }
                    }
                  },
                }
              },
          );
          if tried.out.fault != None { tried.out } else {
            match tried.from {
              None -> tried.out,
              Some(h) ->
                joined(acc, tried.out, walked(f, cx, { ..acc, h: entered(acc, h) }, m.rest)),
            }
          }
        },
        Miss -> if !cx.arm { { ..acc, fault: Some(b"an arm's miss outside a match") } } else {
          match acc.missed {
            None -> { ..acc, missed: Some(acc.h), live: false },
            Some(m) -> if m.owned == acc.h.owned && m.joins == acc.h.joins {
              { ..acc, live: false }
            } else { { ..acc, fault: Some(b"the misses of an arm hold different counts") } },
          }
        },
        Loop(l) -> if l.init.len() != l.state.len() || !same_reps(l.init, l.state) {
          { ..acc, fault: Some(b"a loop's state set from values held otherwise") }
        } else {
          let fed = l.init.fold(acc, passed);
          let start = l.state.fold(fed.h, |h: Holding, s: Var|
            if counted(s.rep) { { ..h, owned: h.owned.insert(s.id, 1) } } else { h });
          let body = walked(
            f,
            {
              ..cx,
              looped: Some({ held: fed.h.owned, state: l.state, answer: l.answer }),
              arm: false,
            },
            { ..fed, h: start, missed: None, done: false },
            l.body,
          );
          if fed.fault != None { fed }
          else if body.fault != None { { ..fed, fault: body.fault } }
          else if body.live { { ..fed, fault: Some(b"a loop's body that falls off its end") } }
          else {
            {
              ..fed,
              h: {
                ..fed.h,
                owned: if counted(l.answer.rep) { fed.h.owned.insert(l.answer.id, 1) }
                else { fed.h.owned },
              },
              live: body.done,
            }
          }
        },
        Next(args) -> match cx.looped {
          None -> { ..acc, fault: Some(b"a loop's next pass outside a loop") },
          Some(lp) -> if args.len() != lp.state.len() || !same_reps(args, lp.state) {
            { ..acc, fault: Some(b"a loop's next pass held otherwise than its state") }
          } else {
            ended(
              args.fold(acc, passed),
              lp.held,
              b"a count held otherwise than the loop holds where it passes again: v",
            )
          },
        },
        Done(a) -> match cx.looped {
          None -> { ..acc, fault: Some(b"a loop's answer outside a loop") },
          Some(lp) -> if !same_rep(a, lp.answer.rep) {
            { ..acc, fault: Some(b"a loop's answer held otherwise") }
          } else {
            {
              ..ended(passed(acc, a), lp.held, b"a count held otherwise than the loop holds where it is left: v"),
              done: true,
            }
          },
        },
        Return(a) -> if cx.handled { left(acc) } else if !same_rep(a, cx.answer) {
          { ..acc, fault: Some(b"an answer held otherwise than the root answers") }
        } else {
          ended(passed(acc, a), Map::new(), b"a count left held where the body answers: v")
        },
        Restart(args) -> if cx.handled { left(acc) } else if !entered_as(f, cx.member, args) {
          { ..acc, fault: Some(b"a group's member restarted with arguments held otherwise") }
        } else {
          ended(args.fold(acc, passed), Map::new(), b"a count left held where the body restarts: v")
        },
        Enter(e) -> if cx.handled { left(acc) } else if !entered_as(f, Some(e.member), e.args) {
          { ..acc, fault: Some(b"a group's member entered with arguments held otherwise") }
        } else {
          ended(
            e.args.fold(acc, passed),
            Map::new(),
            b"a count left held where the body enters its group: v",
          )
        },
        Fail(_) ->
          ended(
            acc,
            cx.landing,
            b"a count held otherwise than the handle around holds where the body fails: v",
          ),
        Handle(x) -> match token_in(x.args) {
          Some(t) -> faulted(acc, b"a reuse token read as a value: v", t),
          None -> if taken_whole(acc.h, x.args) != None {
            { ..acc, fault: Some(b"a block used whole after a field was taken out of it") }
          } else {
            let h = used(acc, used_as(x.args, x.uses));
            let across = h.h;
            let after = {
              ..h,
              h: {
                ..across,
                owned: if counted(x.answer.rep) { across.owned.insert(x.answer.id, 1) }
                else { across.owned },
              },
            };
            if h.fault != None { h } else if with_released(cx.landing, x.unwind) != across.owned {
              {
                ..h,
                fault: Some(
                  b"a handle whose landing releases other than what it holds across its body",
                ),
              }
            } else if x.site.detached != None { after } else {
              let body = walked(
                f,
                { ..cx, looped: None, landing: across.owned, arm: false, handled: true },
                {
                  ..h,
                  h: { ..across, joins: across.joins.insert(x.answer.id, false) },
                  missed: None,
                  done: false,
                },
                x.body,
              );
              if body.fault != None { { ..h, fault: body.fault } }
              else if !body.live { after } else if body.h.joins.get(x.answer.id) != Some(true) {
                { ..h, fault: Some(b"a handle's body that ends without its answer") }
              } else if body.h.owned != after.h.owned {
                {
                  ..h,
                  fault: Some(
                    b"a handle's body that ends holding other counts than the handle holds across it",
                  ),
                }
              } else { after }
            }
          },
        },
        Inc(n) -> if !counted(n.var.rep) {
          faulted(acc, b"a count taken of a value that holds none: v", n.var)
        } else if is_token(n.var) { faulted(acc, b"a count taken of a reuse token: v", n.var) }
        else {
          let read = read_of(acc, n.var);
          if read.fault != None { read } else {
            resolved(read.h, n.var).fold(read, |x: Walk, t: Var|
              { ..x, h: { ..x.h, owned: x.h.owned.insert(t.id, count(x.h, t) + n.n) } })
          }
        },
        Dec(v) -> if !counted(v.rep) {
          faulted(acc, b"a count let go of a value that holds none: v", v)
        } else if is_token(v) { faulted(acc, b"a reuse token let go as a value: v", v) }
        else { consumed(acc, v) },
        Reset(r) -> if !is_token(r.token) {
          faulted(acc, b"cells kept as other than a reuse token: v", r.token)
        } else {
          let c = consumed(acc, r.of);
          {
            ..c,
            h: {
              ..c.h,
              owned: c.h.owned.insert(r.token.id, 1),
              cells: c.h.cells.insert(r.token.id, r.of.id),
            },
          }
        },
        Free(r) -> if !is_token(r.of) {
          faulted(acc, b"a block freed that is no reuse token: v", r.of)
        } else { consumed(acc, r.of) },
        Opened(o) -> if !held_here(o.of.rep) {
          faulted(acc, b"a value opened that is not held only here: v", o.of)
        } else if o.words.map(|w: Var| w.rep) != parts_of(o.of.rep) {
          faulted(acc, b"a value opened into words held otherwise than its parts: v", o.of)
        } else {
          let c = consumed(acc, o.of);
          let held = o.words.fold(c, |x: Walk, v: Var|
            if counted(v.rep) {
              { ..x, h: { ..x.h, owned: x.h.owned.insert(v.id, count(x.h, v) + 1) } }
            } else { x });
          { ..held, h: { ..held.h, opened: held.h.opened.insert(o.of.id, o.words) } }
        },
        Sited(_) -> acc,
      }
    })

/// Why `val`, bound to `y`, reads a block otherwise than the fields taken out of it allow: a field
/// is taken only once, out of a block's word this body holds a count of and no loop around holds
/// across its passes (`across`); once taken it is not read
/// again or kept in the block's cells; and a block a field was taken out of is used only to read its
/// other fields, test its constructor, or let it go.
fn field_fault(
  h: Holding,
  across: Map<Int, Int>,
  y: Var,
  val: Val,
) -> Option<{ why: Bytes, v: Var }> =
  match val {
    Take(t) -> if t.of.rep != RWord || !field_path(t.path) {
      Some({ why: b"a field taken out of other than a block's word: v", v: t.of })
    } else if count(h, t.of) == 0 {
      Some({ why: b"a field taken out of a block this body does not hold: v", v: t.of })
    } else if across.contains(t.of.id) {
      Some({ why: b"a field taken out of a block a loop holds across its passes: v", v: t.of })
    } else if taken_at(h, t.of, t.path) {
      Some({ why: b"a field taken twice out of its block: v", v: t.of })
    } else { None },
    Get(g) -> if taken_at(h, g.of, g.path) {
      Some({ why: b"a field read after it was taken out of its block: v", v: y })
    } else { None },
    Make(m) -> match m.reuse {
      Some(t) -> match h.cells.get(t.id) {
        Some(of) -> if kept_taken(m.made, m.kept, match h.taken.get(of) {
            Some(ps) -> ps,
            None -> [],
          }) { Some({ why: b"a field kept in cells it was taken out of: v", v: y }) }
        else { whole_fault(h, read_args(val)) },
        None -> whole_fault(h, read_args(val)),
      },
      None -> whole_fault(h, read_args(val)),
    },
    _ -> whole_fault(h, read_args(val)),
  }

fn whole_fault(h: Holding, args: List<Arg>) -> Option<{ why: Bytes, v: Var }> =
  match taken_whole(h, args) {
    Some(v) -> Some({ why: b"a block used whole after a field was taken out of it: v", v: v }),
    None -> None,
  }

/// The first of `args` a field was taken out of.
fn taken_whole(h: Holding, args: List<Arg>) -> Option<Var> =
  args.fold(None, |found: Option<Var>, a: Arg|
    match found {
      Some(_) -> found,
      None -> match var_of(a) {
        Some(v) -> match h.taken.get(v.id) {
          Some(ps) -> if ps.len() > 0 { Some(v) } else { None },
          None -> None,
        },
        None -> None,
      },
    })

fn taken_at(h: Holding, of: Var, p: Path) -> Bool =
  match h.taken.get(of.id) { Some(ps) -> ps.contains(p), None -> false }

/// Whether `made` keeps in place a field one of `taken` names.
fn kept_taken(made: Made, kept: List<Int>, taken: List<Path>) -> Bool =
  kept.any(|k: Int|
    taken.any(|p: Path|
      match p {
        PArg(a) -> a.at == k,
        PField(f) -> match made { MRecord(r) -> r.names.at(k) == Some(f.name), _ -> false },
        _ -> false,
      }))

/// Whether `p` reads a field at its offset in a block: what a `Take` may take.
pub fn field_path(p: Path) -> Bool = match p { PField(_) -> true, PArg(_) -> true, _ -> false }

/// `w` noting the field `val` takes, where it takes one and the path holds.
fn noted_take(w: Walk, val: Val) -> Walk =
  match val {
    Take(t) -> if w.fault != None { w } else {
      {
        ..w,
        h: {
          ..w.h,
          taken: w.h.taken.insert(t.of.id, match w.h.taken.get(t.of.id) {
            Some(ps) -> ps.push(t.path),
            None -> [t.path],
          }),
        },
      }
    },
    _ -> w,
  }

/// The fields taken on either of two paths, each block's paths listed once.
fn taken_either(a: Map<Int, List<Path>>, b: Map<Int, List<Path>>) -> Map<Int, List<Path>> =
  b.fold(a, |m: Map<Int, List<Path>>, id: Int, ps: List<Path>|
    m.insert(
      id,
      ps.fold(match m.get(id) { Some(qs) -> qs, None -> [] }, |qs: List<Path>, p: Path|
        if qs.contains(p) { qs } else { qs.push(p) }),
    ))

/// A match arm's or its rest's state: what the path held at the miss before it, the borrowed values
/// of the match's entry still readable.
fn entered(before: Walk, at: Holding) -> Holding = { ..at, borrowed: before.h.borrowed }

/// Two paths out of a branch: where both go on they must hold the same counts and have set the
/// same joins; a value borrowed inside one is gone after it. Their misses must agree.
fn joined(before: Walk, a: Walk, b: Walk) -> Walk =
  match a.fault {
    Some(_) -> a,
    None -> match b.fault {
      Some(_) -> b,
      None -> {
        let missed = match a.missed { Some(_) -> a.missed, None -> b.missed };
        let both = match a.missed {
          Some(x) -> match b.missed {
            Some(y) -> x.owned != y.owned || x.joins != y.joins,
            None -> false,
          },
          None -> false,
        };
        let done = a.done || b.done;
        if both { { ..a, fault: Some(b"the misses of an arm hold different counts") } }
        else if a.live && b.live {
          if a.h.owned != b.h.owned {
            { ..a, fault: Some(b"the paths out of a branch hold different counts") }
          } else if a.h.joins != b.h.joins {
            { ..a, fault: Some(b"the paths out of a branch set different joins") }
          } else {
            {
              ..a,
              h: { ..a.h, borrowed: before.h.borrowed, taken: taken_either(a.h.taken, b.h.taken) },
              missed: missed,
              done: done,
            }
          }
        } else if a.live {
          { ..a, h: { ..a.h, borrowed: before.h.borrowed }, missed: missed, done: done }
        } else if b.live {
          { ..b, h: { ..b.h, borrowed: before.h.borrowed }, missed: missed, done: done }
        } else { { ..a, live: false, missed: missed, done: done } }
      },
    },
  }

/// Each operand used as the operation's signature says: consumed, or only read.
fn used(w: Walk, ops: List<{ arg: Arg, takes: Bool }>) -> Walk =
  ops.fold(w, |acc: Walk, o: { arg: Arg, takes: Bool }|
    if o.takes { taken(acc, o.arg) } else { held(acc, o.arg) })

fn taken(w: Walk, a: Arg) -> Walk = match a { AVar(v) -> consumed(w, v), _ -> w }

/// `a` handed on whole, which a reuse token never is.
fn passed(w: Walk, a: Arg) -> Walk =
  match a {
    AVar(v) -> if is_token(v) { faulted(w, b"a reuse token read as a value: v", v) }
    else if taken_whole(w.h, [a]) != None {
      faulted(w, b"a block used whole after a field was taken out of it: v", v)
    } else if w.h.stacks.contains(v.id) {
      faulted(w, b"a closure on this frame's stack handed beyond the call it is lent to: v", v)
    } else { consumed(w, v) },
    _ -> w,
  }

fn is_token(v: Var) -> Bool = match v.rep { RToken(_) -> true, _ -> false }

/// The first reuse token among `args`.
fn token_in(args: List<Arg>) -> Option<Var> =
  args.fold(None, |found: Option<Var>, a: Arg|
    match found {
      Some(_) -> found,
      None -> match var_of(a) { Some(v) -> if is_token(v) { Some(v) } else { None }, None -> None },
    })

/// What `val` reads as values: its operands, but the cells a `Make` reuses.
fn read_args(val: Val) -> List<Arg> =
  match val { Make(m) -> m.args, _ -> operands(val).map(|o: { arg: Arg, takes: Bool }| o.arg) }

fn held(w: Walk, a: Arg) -> Walk = match a { AVar(v) -> read_of(w, v), _ -> w }

/// `y` bound to `val` where `val` reads an opened value: only a leaf, which is the word in its
/// place, so `y` is that word's alias. Nothing where `val` reads no opened value.
fn word_read(w: Walk, y: Var, val: Val) -> Option<Walk> =
  match val {
    Get(g) -> match w.h.opened.get(g.of.id) {
      None -> match payload_of(val, y) {
        None -> None,
        Some(x) -> {
          let whole = match w.h.alias.get(x.id) { Some(t) -> t, None -> x };
          let r = read_of(w, whole);
          Some(if r.fault != None { r }
          else { { ..r, h: { ..r.h, alias: r.h.alias.insert(y.id, whole) } } })
        },
      },
      Some(ws) ->
        Some(match g.path {
          PLeaf(k) -> match ws.at(k) {
            None -> faulted(w, b"a read past the words of an opened value: v", y),
            Some(word) -> if word.rep != y.rep {
              faulted(w, b"a word of an opened value read as other than it is held: v", y)
            } else if !counted(word.rep) { w } else {
              let r = read_of(w, word);
              if r.fault != None { r }
              else { { ..r, h: { ..r.h, alias: r.h.alias.insert(y.id, word) } } }
            },
          },
          _ -> faulted(w, b"an opened value read other than by its words: v", y),
        }),
    },
    _ -> None,
  }

/// The sum `y` is the payload of where `val` reads it: a constructor's argument read out of an
/// `Option` or a `Result` held as one word is that word, so it holds the sum's count.
pub fn payload_of(val: Val, y: Var) -> Option<Var> =
  match val {
    Get(g) -> match g.path {
      PArg(_) -> if sum_word(g.of.rep) && (y.rep == RWord || sum_word(y.rep)) { Some(g.of) }
      else { None },
      _ -> None,
    },
    _ -> None,
  }

fn sum_word(r: Rep) -> Bool = match r { RMaybe -> true, RTagged -> true, _ -> false }

fn made_width(m: Made) -> Int = match m { MRecord(r) -> r.width, MCtor(c) -> c.width, _ -> 0 }

/// Whether each arm's `when` is a constructor `tested` names, where it tests a tag: the arm then knows
/// its subject holds that constructor, which decides whose cells it may reuse.
fn names_each(tested: Test, whens: List<Int>) -> Bool =
  match tested { TTag(names) -> whens.all(|w: Int| w >= 0 && w < names.len()), _ -> true }

/// Whether a value held as `r` is held only by this body: a flat value or a sum's parts, each a
/// local of its own.
fn held_here(r: Rep) -> Bool = match r { RFlat(_) -> true, RCases(_) -> true, _ -> false }

/// What a use of `v` uses: an opened value's counted words, a word's alias that word, any other
/// variable itself.
fn resolved(h: Holding, v: Var) -> List<Var> =
  match h.stacks.get(v.id) {
    Some(caps) -> caps.fold([], |acc: List<Var>, c: Var| acc.concat(word_of(h, c))),
    None -> word_of(h, v),
  }

fn word_of(h: Holding, v: Var) -> List<Var> =
  match h.opened.get(v.id) {
    Some(ws) -> ws.filter(|x: Var| counted(x.rep)),
    None -> match h.alias.get(v.id) { Some(x) -> [x], None -> [v] },
  }

/// One count of `v` consumed, of each word where it was opened; a closure on this frame's stack
/// holds no count, so handing it to a call only reads its captures.
fn consumed(w: Walk, v: Var) -> Walk =
  if w.h.stacks.contains(v.id) { read_of(w, v) } else { resolved(w.h, v).fold(w, consumed_one) }

/// `v` read, each word where it was opened, each capture where it is a closure on this frame's stack.
fn read_of(w: Walk, v: Var) -> Walk = resolved(w.h, v).fold(w, read_one)

/// A closure on this frame's stack `val` keeps beyond itself: one any value but a call takes.
fn escaping(h: Holding, val: Val) -> Option<Var> =
  match val {
    Call(_) -> None,
    Apply(_) -> None,
    _ ->
      operands(val).fold(None, |found: Option<Var>, o: { arg: Arg, takes: Bool }|
        match found {
          Some(_) -> found,
          None -> match var_of(o.arg) {
            Some(v) -> if o.takes && h.stacks.contains(v.id) { Some(v) } else { None },
            None -> None,
          },
        }),
  }

/// What a `Make` laid on this frame's stack captures: a closure lent to the call it is made for,
/// which holds no count of its captures and lives no longer than the frame.
pub fn stacked_captures(val: Val) -> Option<List<Arg>> =
  match val {
    Make(m) -> match m.made {
      MClosure(c) -> if c.stacked { Some(m.args.take(c.captures)) } else { None },
      _ -> None,
    },
    _ -> None,
  }

/// One count of `v` consumed: it must hold one of its own.
fn consumed_one(w: Walk, v: Var) -> Walk =
  if w.fault != None || !counted(v.rep) { w } else {
    let n = count(w.h, v);
    if n > 0 {
      {
        ..w,
        h: {
          ..w.h,
          owned: if n == 1 { w.h.owned.remove(v.id) } else { w.h.owned.insert(v.id, n - 1) },
        },
      }
    } else if w.h.borrowed.contains(v.id) {
      faulted(w, b"a borrowed value consumed with no count of its own: v", v)
    } else { faulted(w, b"a value consumed with no count left: v", v) }
  }

/// `v` read: it must be held, or borrowed out of something still held.
fn read_one(w: Walk, v: Var) -> Walk =
  if w.fault != None || !counted(v.rep) || count(w.h, v) > 0 { w } else {
    match w.h.borrowed.get(v.id) {
      Some(base) -> if base < 0 || w.h.owned.contains(base) || w.h.borrowed.contains(base) { w }
      else { faulted(w, b"a value read after what it was read out of was let go: v", v) },
      None -> faulted(w, b"a value read with no count left: v", v),
    }
  }

/// Where `val` can fail, what its failure path releases must be exactly what the path holds but
/// what a `handle` around holds across its body.
fn failing(cx: Within, w: Walk, val: Val, unwind: List<Var>) -> Walk =
  if w.fault != None || !fails(val) {
    if unwind.len() > 0 && w.fault == None {
      { ..w, fault: Some(b"a release on the failure path of a value that cannot fail") }
    } else { w }
  } else if with_released(cx.landing, unwind) == w.h.owned { w }
  else { { ..w, fault: Some(b"a failure path that releases other than what it holds") } }

/// The counts a failure releases: `landing`'s, where it lands, and one more of each of `unwind`.
fn with_released(landing: Map<Int, Int>, unwind: List<Var>) -> Map<Int, Int> =
  unwind.fold(landing, |m: Map<Int, Int>, v: Var|
    m.insert(v.id, match m.get(v.id) { Some(n) -> n + 1, None -> 1 }))

/// The variable `v` a `Let` binds, holding what the operation answers.
fn result(w: Walk, v: Var, a: Answered) -> Walk =
  if w.fault != None || !counted(v.rep) { w } else {
    match a {
      Owns -> { ..w, h: { ..w.h, owned: w.h.owned.insert(v.id, 1) } },
      ReadsOf(read) -> {
        let x = match w.h.alias.get(read.id) { Some(word) -> word, None -> read };
        let base = if count(w.h, x) > 0 { x.id }
        else { match w.h.borrowed.get(x.id) { Some(b) -> b, None -> x.id } };
        { ..w, h: { ..w.h, borrowed: w.h.borrowed.insert(v.id, base) } }
      },
      Lasts -> { ..w, h: { ..w.h, borrowed: w.h.borrowed.insert(v.id, 0 - 1) } },
    }
  }

/// Control leaves: what the path holds past it must be `kept`, and nothing else.
fn ended(w: Walk, kept: Map<Int, Int>, why: Bytes) -> Walk =
  if w.fault != None { w }
  else if w.h.owned == kept { { ..w, live: false } } else {
    let odd = w.h.owned.keys().concat(kept.keys()).filter(|id: Int|
      w.h.owned.get(id) != kept.get(id));
    match odd.at(0) {
      Some(id) -> { ..w, fault: Some(why.concat(ascii_of_int(id))), live: false },
      None -> { ..w, live: false },
    }
  }

/// A body that leaves its root from inside a `handle`, whose frame would stay pushed.
fn left(w: Walk) -> Walk = { ..w, fault: Some(b"a body that leaves its root from inside a handle") }

/// Why binding `v` to `val` holds a value otherwise than the operation hands it, or an operand
/// otherwise than the operation takes it.
fn held_otherwise(v: Var, val: Val) -> Option<Bytes> =
  match val {
    Call(c) -> if c.conv.answer != v.rep {
      Some(b"a call's answer bound otherwise than its convention holds it: v")
    } else if !conv_reps(c.args, c.conv.reps) {
      Some(b"a call's operand held otherwise than its convention takes it: v")
    } else { None },
    Apply(c) -> if c.conv.answer != v.rep {
      Some(b"a call's answer bound otherwise than its convention holds it: v")
    } else if !conv_reps(c.args, c.conv.reps) {
      Some(b"a call's operand held otherwise than its convention takes it: v")
    } else { None },
    Pack(p) -> if p.to != v.rep { Some(b"a value packed otherwise than its variable holds it: v") }
    else { None },
    Make(m) -> match m.reuse {
      Some(t) -> if !is_token(t) { Some(b"a value made in cells no reset kept: v") }
      else if t.rep != RToken(made_width(m.made)) || made_width(m.made) == 0 {
        Some(b"a value made in cells of another size: v")
      } else if m.kept.any(|k: Int| k < 0 || k >= m.args.len()) {
        Some(b"a value made keeping a field it does not have: v")
      } else { None },
      None -> if m.kept.len() > 0 { Some(b"a value made afresh keeping fields: v") } else { None },
    },
    _ -> None,
  }

fn conv_reps(args: List<Arg>, reps: List<Rep>) -> Bool =
  args.len() == reps.len()
    && range(0, args.len()).all(|i: Int|
      match args.at(i) {
        Some(a) -> match reps.at(i) { Some(r) -> same_rep(a, r), None -> false },
        None -> false,
      })

fn same_reps(args: List<Arg>, vars: List<Var>) -> Bool =
  range(0, args.len()).all(|i: Int|
    match args.at(i) {
      Some(a) -> match vars.at(i) { Some(v) -> same_rep(a, v.rep), None -> false },
      None -> false,
    })

/// Whether `v` answers a count, which only a variable can hold.
fn answers_count(v: Val) -> Bool =
  match v {
    Call(c) -> counted(c.conv.answer),
    Apply(c) -> counted(c.conv.answer),
    Make(_) -> true,
    Take(_) -> true,
    Pack(p) -> counted(p.to),
    Gathered(g) -> g.parts.any(|a: Arg| counted(rep_of_arg(a))),
    Native(n) -> n.uses.owned,
    Op(o) -> o.uses.owned,
    _ -> false,
  }

fn count(h: Holding, v: Var) -> Int = match h.owned.get(v.id) { Some(n) -> n, None -> 0 }

fn faulted(w: Walk, why: Bytes, v: Var) -> Walk =
  { ..w, fault: Some(why.concat(ascii_of_int(v.id))) }

/// Whether operand `a` is held as `r`: a variable by its own representation, a constant always.
fn same_rep(a: Arg, r: Rep) -> Bool = match a { AVar(v) -> v.rep == r, _ -> true }

fn word(id: Int) -> Var = { id: id, ty: TyCon({ name: b"String", args: [] }), rep: RWord }

fn int(id: Int) -> Var = { id: id, ty: TyCon({ name: b"Int", args: [] }), rep: RInt }

fn flag(id: Int) -> Var = { id: id, ty: TyCon({ name: b"Bool", args: [] }), rep: RBool }

/// A root over `params`, each given unless `lent` names it, answering as `answer`.
fn root_of(params: List<Var>, lent: List<Int>, answer: Rep, body: Block) -> Fn =
  {
    key: Named(b"m.f"),
    kind: Rooted,
    params: params,
    conv: {
      params: range(0, params.len()).map(|i: Int| if lent.contains(i) { Lent } else { Given }),
      reps: params.map(|p: Var| p.rep),
      answer: answer,
    },
    body: body,
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
  }

/// A call of `m.g` handing `args`, each given unless `lent` names it, answering a word.
fn call_of(args: List<Arg>, lent: List<Int>) -> Val =
  Call({
    callee: Root(Named(b"m.g")),
    args: args,
    conv: {
      params: range(0, args.len()).map(|i: Int| if lent.contains(i) { Lent } else { Given }),
      reps: args.map(rep_of_arg),
      answer: RWord,
    },
    stops: false,
  })

fn bind(v: Var, val: Val, unwind: List<Var>) -> Inst =
  Let({ var: v, val: val, at: dummy_span(), unwind: unwind })

test "a count is consumed exactly once on every path, or the body is refused" {
  let p = word(0);
  let r = word(1);
  assert_eq(verified(root_of([p], [], RWord, [Return(AVar(p))])), None);
  assert_eq(
    verified(root_of([p], [], RInt, [Return(AInt(0))])),
    Some(b"a count left held where the body answers: v0"),
  );
  assert_eq(
    verified(
      root_of([p], [], RWord, [bind(r, call_of([AVar(p), AVar(p)], []), []), Return(AVar(r))]),
    ),
    Some(b"a value consumed with no count left: v0"),
  );
  assert_eq(
    verified(
      root_of([p], [], RWord, [
        Inc({ var: p, n: 1 }),
        bind(r, call_of([AVar(p), AVar(p)], []), []),
        Return(AVar(r)),
      ]),
    ),
    None,
  );
  // A lent parameter is read, never consumed, and the root holds no count of it.
  assert_eq(
    verified(root_of([p], [0], RWord, [bind(r, call_of([AVar(p)], [0]), []), Return(AVar(r))])),
    None,
  )
}

test "what a failing call's path releases is exactly what the path holds across it" {
  let p = word(0);
  let r = word(1);
  let body = |unwind: List<Var>|
    [Inc({ var: p, n: 1 }), bind(r, call_of([AVar(p)], []), unwind), Dec(p), Return(AVar(r))];
  assert_eq(verified(root_of([p], [], RWord, body([p]))), None);
  assert_eq(
    verified(root_of([p], [], RWord, body([]))),
    Some(b"a failure path that releases other than what it holds"),
  )
}

test "the paths out of a branch hold the same counts and set the same joins" {
  let p = word(0);
  let s = word(1);
  let j = int(2);
  assert_eq(
    verified(
      root_of([p], [], RInt, [
        If({ cond: ABool(true), then: [Dec(p)], otherwise: [] }),
        Return(AInt(0)),
      ]),
    ),
    Some(b"the paths out of a branch hold different counts"),
  );
  assert_eq(
    verified(
      root_of([p], [], RWord, [
        If({
          cond: ABool(true),
          then: [Return(AVar(p))],
          otherwise: [Dec(p), bind(s, Static(b"k"), []), Inc({ var: s, n: 1 }), Return(AVar(s))],
        }),
      ]),
    ),
    None,
  );
  assert_eq(
    verified(
      root_of([p], [], RInt, [
        Dec(p),
        Decl(j),
        If({ cond: ABool(true), then: [Assign({ var: j, arg: AInt(1) })], otherwise: [] }),
        Return(AVar(j)),
      ]),
    ),
    Some(b"the paths out of a branch set different joins"),
  )
}

test "a borrowed value is read only while what it was read out of is held" {
  let p = word(0);
  let x = word(1);
  let r = word(2);
  let read_after = |first: List<Inst>|
    root_of(
      [p],
      [],
      RWord,
      [bind(x, Get({ of: p, path: PLeaf(0) }), [])].concat(first).concat([
        bind(r, call_of([AVar(x)], [0]), []),
        Return(AVar(r)),
      ]),
    );
  assert_eq(
    verified(read_after([Dec(p)])),
    Some(b"a value read after what it was read out of was let go: v1"),
  );
  assert_eq(
    verified(
      root_of([p], [], RWord, [
        bind(x, Get({ of: p, path: PLeaf(0) }), []),
        bind(r, call_of([AVar(x)], [0]), [p]),
        Dec(p),
        Return(AVar(r)),
      ]),
    ),
    None,
  );
  assert_eq(
    verified(
      root_of([p], [], RWord, [
        bind(x, Get({ of: p, path: PLeaf(0) }), []),
        Dec(p),
        Return(AVar(x)),
      ]),
    ),
    Some(b"a borrowed value consumed with no count of its own: v1"),
  )
}

test "a match's next arm starts from what the arm before held where it missed" {
  let p = word(0);
  let q = word(1);
  let arms = |miss: List<Inst>|
    root_of([p, q], [], RWord, [
      Match({
        arms: [
          [If({ cond: ABool(true), then: [Dec(q), Return(AVar(p))], otherwise: miss.push(Miss) })],
          [Return(AVar(q))],
        ],
        rest: [Dec(q), Fail({ why: NoArm, at: dummy_span() })],
      }),
    ]);
  assert_eq(verified(arms([Dec(p)])), None);
  // Arm two reads `q` and nothing else, so holding `p` at the miss leaves a count held.
  assert_eq(verified(arms([])), Some(b"a count left held where the body answers: v0"));
  // A miss's holding is the next arm's: two misses of one arm must agree.
  assert_eq(
    verified(
      root_of([p, q], [], RWord, [
        Match({
          arms: [
            [If({ cond: ABool(true), then: [Dec(p), Miss], otherwise: [Miss] })],
            [Dec(p), Return(AVar(q))],
          ],
          rest: [],
        }),
      ]),
    ),
    Some(b"the misses of an arm hold different counts"),
  );
  assert_eq(verified(root_of([p], [], RWord, [Miss])), Some(b"an arm's miss outside a match"))
}

test "a loop holds the same counts across each of its passes, and a count it left holds after it" {
  let p = word(0);
  let s = word(1);
  let n = word(2);
  let a = word(3);
  let looped = |pass: List<Inst>|
    root_of([p], [], RWord, [
      Inc({ var: p, n: 1 }),
      Loop({
        state: [s],
        init: [AVar(p)],
        body: [
          If({
            cond: ABool(true),
            then: [Done(AVar(s))],
            otherwise: pass.concat([
              bind(n, call_of([AVar(p), AVar(s)], []), [p]),
              Next([AVar(n)]),
            ]),
          }),
        ],
        answer: a,
      }),
      Dec(p),
      Return(AVar(a)),
    ]);
  assert_eq(verified(looped([Inc({ var: p, n: 1 })])), None);
  assert_eq(verified(looped([])), Some(b"a failure path that releases other than what it holds"));
  assert_eq(
    verified(
      root_of([p], [], RWord, [
        Loop({ state: [s], init: [AVar(p)], body: [Dec(s)], answer: a }),
        Return(AVar(a)),
      ]),
    ),
    Some(b"a loop's body that falls off its end"),
  );
  assert_eq(
    verified(root_of([p], [], RWord, [Next([AVar(p)])])),
    Some(b"a loop's next pass outside a loop"),
  )
}

test "a handle's body leaves to its landing what the handle holds across it" {
  let p = word(0);
  let r = word(1);
  let a = word(2);
  let c = flag(3);
  let site = { clauses: [], ret: None, detached: None };
  let uses = { takes: [], owned: false, fails: true, stops: false };
  let landed = |body: List<Inst>, unwind: List<Var>, landing: List<Var>|
    root_of([p, c], [], RWord, [
      Handle({
        body: body.concat([
          bind(r, call_of([AVar(p)], [0]), unwind),
          Assign({ var: a, arg: AVar(r) }),
        ]),
        args: [],
        uses: uses,
        site: site,
        answer: a,
        unwind: landing,
      }),
      Dec(p),
      Return(AVar(a)),
    ]);
  let handled = |body: List<Inst>, unwind: List<Var>| landed(body, unwind, [p]);
  assert_eq(verified(handled([], [])), None);
  // A failure inside the body releases what the body holds; the handle's landing the rest.
  assert_eq(
    verified(handled([], [p])),
    Some(b"a failure path that releases other than what it holds"),
  );
  assert_eq(
    verified(landed([], [], [])),
    Some(b"a handle whose landing releases other than what it holds across its body"),
  );
  assert_eq(
    verified(
      handled(
        [If({ cond: AVar(c), then: [Fail({ why: NoArm, at: dummy_span() })], otherwise: [] })],
        [],
      ),
    ),
    None,
  );
  assert_eq(
    verified(
      handled(
        [
          If({
            cond: AVar(c),
            then: [Dec(p), Fail({ why: NoArm, at: dummy_span() })],
            otherwise: [],
          }),
        ],
        [],
      ),
    ),
    Some(b"a count held otherwise than the handle around holds where the body fails: v0"),
  );
  assert_eq(
    verified(handled([If({ cond: AVar(c), then: [Dec(p), Return(AVar(p))], otherwise: [] })], [])),
    Some(b"a body that leaves its root from inside a handle"),
  )
}

test "a reuse token is kept by a reset, taken by a make or freed, and never read as a value" {
  let r = word(0);
  let v = word(1);
  let n = word(2);
  let token = { ..word(3), rep: RToken(1) };
  let made = |reuse: Option<Var>, kept: List<Int>|
    Make({ made: MRecord({ names: [b"a"], width: 1 }), args: [AVar(v)], reuse: reuse, kept: kept });
  let reset = Reset({ token: token, of: r });
  assert_eq(
    verified(
      root_of([r, v], [], RWord, [reset, bind(n, made(Some(token), []), []), Return(AVar(n))]),
    ),
    None,
  );
  assert_eq(
    verified(
      root_of([r, v], [], RWord, [
        reset,
        Free({ of: token, bytes: AInt(8) }),
        bind(n, made(None, []), []),
        Return(AVar(n)),
      ]),
    ),
    None,
  );
  // Released on a failure path as it would be freed.
  assert_eq(
    verified(
      root_of([r, v], [], RWord, [
        reset,
        bind(n, made(None, []), [token]),
        Free({ of: token, bytes: AInt(8) }),
        Return(AVar(n)),
      ]),
    ),
    None,
  );
  assert_eq(
    verified(
      root_of([r, v], [], RWord, [reset, Dec(token), bind(n, made(None, []), []), Return(AVar(n))]),
    ),
    Some(b"a reuse token let go as a value: v3"),
  );
  assert_eq(
    verified(
      root_of([r, v], [], RWord, [
        reset,
        bind(n, call_of([AVar(token)], []), []),
        Dec(v),
        Return(AVar(n)),
      ]),
    ),
    Some(b"a reuse token read as a value: v3"),
  );
  assert_eq(
    verified(
      root_of([r, v], [], RWord, [
        Reset({ token: { ..token, rep: RWord }, of: r }),
        bind(n, made(None, []), []),
        Return(AVar(n)),
      ]),
    ),
    Some(b"cells kept as other than a reuse token: v3"),
  );
  assert_eq(
    verified(root_of([r, v], [], RWord, [Dec(r), bind(n, made(Some(v), []), []), Return(AVar(n))])),
    Some(b"a value made in cells no reset kept: v2"),
  );
  assert_eq(
    verified(root_of([r, v], [], RWord, [Dec(r), bind(n, made(None, [0]), []), Return(AVar(n))])),
    Some(b"a value made afresh keeping fields: v2"),
  );
  // Cells kept for a block of two words made into a block of one.
  let wide = { ..token, rep: RToken(2) };
  assert_eq(
    verified(
      root_of([r, v], [], RWord, [
        Reset({ token: wide, of: r }),
        bind(n, made(Some(wide), []), []),
        Return(AVar(n)),
      ]),
    ),
    Some(b"a value made in cells of another size: v2"),
  )
}

test "an opened value is its parts, each word counted on its own and read only by its leaves" {
  let s = {
    id: 0,
    ty: TyCon({ name: b"m.S", args: [] }),
    rep: RFlat([{ name: b"a", rep: RWord }, { name: b"n", rep: RInt }]),
  };
  let w0 = word(1);
  let w1 = int(2);
  let w2 = word(3);
  let y = word(4);
  let r = word(5);
  let opened = Opened({ of: s, words: [w0, w1, w2] });
  let leaf = bind(y, Get({ of: s, path: PLeaf(0) }), []);
  let called = [bind(r, call_of([AVar(y)], []), []), Return(AVar(r))];
  assert_eq(verified(root_of([s], [], RWord, [opened, Dec(w2), leaf].concat(called))), None);
  // A use of the whole value after it is opened uses each counted word.
  assert_eq(
    verified(
      root_of([s], [], RWord, [opened, bind(r, call_of([AVar(s)], []), []), Return(AVar(r))]),
    ),
    None,
  );
  assert_eq(
    verified(root_of([s], [], RWord, [opened, Dec(w0), Dec(w2), leaf].concat(called))),
    Some(b"a value read with no count left: v1"),
  );
  assert_eq(
    verified(
      root_of(
        [s],
        [],
        RWord,
        [opened, Dec(w2), bind(y, Get({ of: s, path: PField({ name: b"a", at: 0 }) }), [])].concat(
          called,
        ),
      ),
    ),
    Some(b"an opened value read other than by its words: v4"),
  );
  assert_eq(
    verified(root_of([s], [], RWord, [Opened({ of: s, words: [w0, w2] }), Dec(w2)].concat(called))),
    Some(b"a value opened into words held otherwise than its parts: v0"),
  );
  assert_eq(
    verified(root_of([w0], [], RWord, [Opened({ of: w0, words: [w2] }), Return(AVar(w2))])),
    Some(b"a value opened that is not held only here: v1"),
  )
}

test "a field taken out of its block is never read again, nor the block used whole" {
  let p = word(0);
  let x = word(1);
  let y = word(2);
  let take = bind(x, Take({ of: p, path: PField({ name: b"f", at: 0 }) }), []);
  assert_eq(verified(root_of([p], [], RWord, [take, Dec(p), Return(AVar(x))])), None);
  assert_eq(
    verified(
      root_of([p], [], RWord, [
        take,
        bind(y, Get({ of: p, path: PField({ name: b"f", at: 0 }) }), []),
        Dec(p),
        Return(AVar(x)),
      ]),
    ),
    Some(b"a field read after it was taken out of its block: v2"),
  );
  assert_eq(
    verified(root_of([p], [], RWord, [take, Dec(x), Return(AVar(p))])),
    Some(b"a block used whole after a field was taken out of it: v0"),
  );
  // Out of a block this body only borrows, the field would be taken from its holder.
  assert_eq(
    verified(root_of([p], [0], RWord, [take, Return(AVar(x))])),
    Some(b"a field taken out of a block this body does not hold: v0"),
  );
  assert_eq(
    verified(
      root_of([p], [], RWord, [
        Do({
          val: Take({ of: p, path: PField({ name: b"f", at: 0 }) }),
          at: dummy_span(),
          unwind: [],
        }),
        Return(AVar(p)),
      ]),
    ),
    Some(b"a value whose count nothing holds"),
  )
}

test "a case arm on a constructor is one its test names" {
  let p = word(0);
  let cased = |when: Int|
    root_of([p], [], RWord, [
      Case({
        on: p,
        test: TTag([b"A", b"B"]),
        arms: [{ when: when, body: [Return(AVar(p))] }],
        rest: [Return(AVar(p))],
      }),
    ]);
  assert_eq(verified(cased(1)), None);
  assert_eq(verified(cased(2)), Some(b"a case arm for a constructor its test does not name: v0"))
}

test "an operand is held as its operation takes it, and a counted answer is held by a variable" {
  let p = word(0);
  let n = int(1);
  let r = word(2);
  let int_call = Call({
    callee: Root(Named(b"m.g")),
    args: [AVar(p)],
    conv: { params: [Given], reps: [RInt], answer: RWord },
    stops: false,
  });
  assert_eq(
    verified(root_of([p], [], RWord, [bind(r, int_call, []), Return(AVar(r))])),
    Some(b"a call's operand held otherwise than its convention takes it: v2"),
  );
  assert_eq(
    verified(root_of([p], [], RWord, [bind(n, call_of([AVar(p)], []), []), Return(AVar(p))])),
    Some(b"a call's answer bound otherwise than its convention holds it: v1"),
  );
  assert_eq(
    verified(
      root_of([p], [], RInt, [
        Do({ val: call_of([AVar(p)], []), at: dummy_span(), unwind: [] }),
        Return(AInt(0)),
      ]),
    ),
    Some(b"a value whose count nothing holds"),
  );
  assert_eq(
    verified(root_of([p], [], RWord, [Dec(n), Return(AVar(p))])),
    Some(b"a count let go of a value that holds none: v1"),
  )
}
