//! What every C function the form prints does as it starts, and what a body run in place of a call
//! does for its step: spend a unit of fuel, count a tick, and move to a stack of its own where this
//! thread's is nearly out.

import std.bytes (ascii_of_int)
import emit.pieces (Piece, Text, spelled)
import emit.tir (Rep)
import emit.print.text (failing_return)
import emit.print.made (grown_answered)

/// The head of a function answering as `answer`: counts the call, spends a unit of fuel, and hands
/// the call a stack of its own when this thread's is nearly out, re-entering `entry` with `words`;
/// the same call on the new stack is counted once.
pub fn fuel_head(entry: Bytes, words: List<Bytes>, answer: Rep) -> Bytes / {abort.raise} =
  spelled(fuel_pieces(entry, [], words, answer))

/// `fuel_head`, where `prep` makes the words a growth of the stack hands on first, leaving the
/// function where that fails.
pub fn fuel_pieces(
  entry: Bytes,
  prep: List<Piece>,
  words: List<Bytes>,
  answer: Rep,
) -> List<Piece> / {abort.raise} =
  [
    Text(
      Bytes::concat_all([
        b"  if (ctx->fuel <= 0) { rt_no_fuel_p(ctx); ",
        failing_return(answer),
        b" }\n",
        b"  { char probe; if ((uintptr_t)&probe < ctx->stack_floor) { ",
      ]),
    ),
  ].concat(
    prep,
  ).push(
    Text(
      Bytes::concat_all([
        grow_call(entry, words, answer),
        b" } }\n",
        b"  ",
        tick_line(failing_return(answer)),
        b"\n",
        b"  ctx->fuel -= 1;\n",
      ]),
    ),
  )

/// A tick counted, the runtime's tick run when one is due, leaving by `leave` where it failed.
pub fn tick_line(leave: Bytes) -> Bytes =
  Bytes::concat_all([
    b"if (++ctx->ticks >= ctx->next_tick) { rt_tick_p(ctx); if (ctx->failed) ",
    leave,
    b" }",
  ])

/// `entry` called on a stack of its own with `args` as its words, and its answer handed back as a
/// function answering as `answer` hands back its own.
fn grow_call(entry: Bytes, args: List<Bytes>, answer: Rep) -> Bytes / {abort.raise} =
  if args.len() == 0 {
    grown_answered(Bytes::concat_all([b"rt_grow_p(ctx, (Word)(intptr_t)&", entry, b", 0)"]), answer)
  } else {
    Bytes::concat_all([
      b"Word ply_grown[",
      ascii_of_int(args.len()),
      b"];",
      Bytes::concat_all(
        range(0, args.len()).map(|i: Int|
          Bytes::concat_all([b" ply_grown[", ascii_of_int(i), b"] = ", args.get(i), b";"])),
      ),
      b" ",
      grown_answered(
        Bytes::concat_all([
          b"rt_grow_p(ctx, (Word)(intptr_t)&",
          entry,
          b", (Word)(intptr_t)ply_grown)",
        ]),
        answer,
      ),
    ])
  }
