//! Records and constructors made and read, values held otherwise, flat values gathered, static
//! constants, and the C types a value of each representation is held in.

import std.bytes (ascii_of_int)
import emit (KNum, ctype)
import emit.tir (Rep, RInt, RBool, RNum, RFloat, RDec, RWord, RMaybe, RTagged, RToken, Var, Arg, Made,
                 Path, rep_of_arg)
import emit.print.text (Printing, Place, line, arg_text, assigned, kind)

/// The C type a value held as `r` is declared and crosses a call in.
pub fn c_type(r: Rep) -> Bytes =
  match r {
    RWord -> b"Word",
    RToken(_) -> b"Word",
    RMaybe -> b"PlyMaybe",
    RTagged -> b"PlyTagged",
    _ -> ctype(kind(r)),
  }

/// The C values a value held as `r` crosses a call in, each its own parameter.
pub fn c_types(r: Rep) -> List<Bytes> = [c_type(r)]

/// A value held as `r`, named `e`, as the word a value of its type is.
pub fn as_word(e: Bytes, r: Rep) -> Bytes =
  match r {
    RInt -> Bytes::concat_all([b"(ply_fits_imm(", e, b") ? ply_imm(", e, b") : rt_box_int_p(ctx, ", e, b"))"]),
    RBool -> Bytes::concat_all([b"(", e, b" ? ply_true : ply_false)"]),
    RFloat -> Bytes::concat_all([b"rt_box_float_p(ctx, ply_f64_bits(", e, b"))"]),
    RDec -> Bytes::concat_all([b"rt_box_decimal_p(ctx, (", e, b").lo, (", e, b").hi)"]),
    RNum(w) -> if w.bits < 64 { Bytes::concat_all([b"ply_imm((int64_t)", e, b")"]) } else {
      Bytes::concat_all([b"rt_box_fixed_p(ctx, (Word)(", e, b"), ", ascii_of_int(width_index(w.bits, w.signed)), b")"])
    },
    _ -> e,
  }

/// The word `w` read as a value held as `r`.
pub fn word_as(w: Bytes, r: Rep) -> Bytes =
  match r {
    RInt -> Bytes::concat_all([b"(ply_is_imm(", w, b") ? ply_imm_value(", w, b") : rt_unbox_int_p(ctx, ", w, b"))"]),
    RBool -> Bytes::concat_all([b"(", w, b" == ply_true)"]),
    RFloat ->
      Bytes::concat_all([
        b"(ply_is_float(",
        w,
        b") ? ply_f64(ply_words(",
        w,
        b")[0]) : ply_f64(rt_unbox_float_p(ctx, ",
        w,
        b")))",
      ]),
    RDec -> Bytes::concat_all([b"ply_dec_of(", w, b")"]),
    RNum(n) -> if n.bits < 64 {
      Bytes::concat_all([b"(", ctype(KNum(n)), b")ply_imm_value(", w, b")"])
    } else { Bytes::concat_all([b"(", ctype(KNum(n)), b")ply_words(", w, b")[0]"]) },
    _ -> w,
  }

/// `rt_box_fixed`'s numbering of a width.
fn width_index(bits: Int, signed: Bool) -> Int =
  if bits == 128 { if signed { 9 } else { 8 } } else {
    (if signed { 4 } else { 0 })
      + (if bits == 8 { 0 } else if bits == 16 { 1 } else if bits == 32 { 2 } else { 3 })
  }

/// A record, a constructor's object or a list made of `m.args`.
pub fn made(p: Place, pr: Printing, into: Option<Var>, m: { made: Made, args: List<Arg>, reuse: Option<Var>, kept: List<Int> }) -> Printing =
  line(pr, p.depth, b"/* a value made, which this printer does not write yet */")

/// What `g.path` reads out of `g.of`.
pub fn got(p: Place, pr: Printing, into: Option<Var>, g: { of: Var, path: Path }) -> Printing =
  line(pr, p.depth, b"/* a read, which this printer does not write yet */")

/// `k.arg` held as `k.to`.
pub fn packed(p: Place, pr: Printing, into: Option<Var>, k: { arg: Arg, to: Rep }) -> Printing =
  match into {
    None -> pr,
    Some(v) -> match k.to {
      RWord -> assigned(pr, p.depth, v, c_type(RWord), as_word(arg_text(pr, k.arg), rep_of_arg(k.arg))),
      _ -> line(pr, p.depth, b"/* a value held otherwise, which this printer does not write yet */"),
    },
  }

/// A flat value gathered from `parts`.
pub fn gathered(p: Place, pr: Printing, into: Option<Var>, parts: List<Arg>) -> Printing =
  line(pr, p.depth, b"/* a flat value, which this printer does not write yet */")

/// The static constant `name`.
pub fn statics(p: Place, pr: Printing, into: Option<Var>, name: Bytes) -> Printing =
  line(pr, p.depth, b"/* a static constant, which this printer does not write yet */")
