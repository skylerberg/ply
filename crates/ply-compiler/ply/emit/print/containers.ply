//! Lists and arrays made, and the operations on a container's cells, printed.

import emit.tir (Var, Arg, Made, Uses)
import emit.tir.containers (ContainerOp)
import emit.print.text (Printing, Place, line)

/// A list or an array made of `m.args`.
pub fn contained(p: Place, pr: Printing, into: Option<Var>, m: { made: Made, args: List<Arg>, reuse: Option<Var>, kept: List<Int> }) -> Printing =
  line(pr, p.depth, b"/* a container made, which this printer does not write yet */")

/// Operation `op` on a container's cells over `args`.
pub fn container_op(p: Place, pr: Printing, into: Option<Var>, op: ContainerOp, args: List<Arg>, uses: Uses) -> Printing =
  line(pr, p.depth, b"/* a container's operation, which this printer does not write yet */")
