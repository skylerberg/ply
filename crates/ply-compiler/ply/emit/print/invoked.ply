//! Calls printed: a root's by its symbol, a function value's, a self tail call as a restart, a tail
//! call into the group, a loop's passes, closures made, and their bodies' functions.

import std.bytes (ascii_of_int)
import emit.keys (Callee, Root)
import emit.pieces (Piece, Text, Hole, Symbol)
import emit.tir (Var, Arg, Convention, Made, Fn, rep_of_arg)
import emit.print.text (Printing, Place, line, pad, temp, named, arg_text, site, check)
import emit.print.made (c_type)

/// A call of `c.callee` on `c.args`, its answer into `into`, its failure tested after it.
pub fn call(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  c: { callee: Callee, args: List<Arg>, conv: Convention, stops: Bool },
) -> Printing = {
  let sited = site(p, pr);
  let args = Bytes::concat_all([
    b"(ctx",
    Bytes::concat_all(c.args.map(|a: Arg| b", ".concat(arg_text(pr, a)))),
    b");\n",
  ]);
  let called = match c.callee {
    Root(k) -> { ..sited, calls: if sited.calls.contains(k) { sited.calls } else { sited.calls.push(k) } },
    _ -> sited,
  };
  let assigned = match into {
    Some(v) -> {
      let n = named(called, v);
      { pr: n.pr, head: Bytes::concat_all([c_type(c.conv.answer), b" ", n.name, b" = "]) }
    },
    None -> { pr: called, head: b"" },
  };
  check(p, {
    ..assigned.pr,
    out: assigned.pr.out.concat([
      Text(Bytes::concat_all([pad(p.depth), assigned.head])),
      Hole(Symbol(c.callee)),
      Text(args),
    ]),
  })
}

/// A call of the function value `c.f` on `c.args`.
pub fn applied(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  c: { f: Arg, args: List<Arg>, conv: Convention, stops: Bool },
) -> Printing =
  line(pr, p.depth, b"/* a call of a function value, which this printer does not write yet */")

/// A closure made of `m.args`, its captures.
pub fn closure_made(p: Place, pr: Printing, into: Option<Var>, m: { made: Made, args: List<Arg>, reuse: Option<Var>, kept: List<Int> }) -> Printing =
  line(pr, p.depth, b"/* a closure, which this printer does not write yet */")

/// A self tail call: its arguments into temporaries, then the parameters set from them, then the
/// body again.
pub fn restarted(p: Place, pr: Printing, args: List<Arg>) -> Printing / {abort.raise} = {
  let held = args.fold({ pr: pr, names: [] }, |h: { pr: Printing, names: List<Bytes> }, a: Arg| {
    let t = temp(h.pr);
    {
      pr: line(t.pr, p.depth, Bytes::concat_all([c_type(rep_of_arg(a)), b" ", t.name, b" = ", arg_text(h.pr, a), b";"])),
      names: h.names.push(t.name),
    }
  });
  let set = range(0, held.names.len()).fold(held.pr, |q: Printing, k: Int|
    line(q, p.depth, Bytes::concat_all([b"p", ascii_of_int(k), b" = ", held.names.get(k), b";"])));
  line(set, p.depth, b"goto ply_loop;")
}

/// A tail call of member `member` of the root's group.
pub fn entered_member(p: Place, pr: Printing, member: Int, args: List<Arg>) -> Printing =
  line(pr, p.depth, b"/* a tail call into the group, which this printer does not write yet */")

/// What opens a `Loop` numbered `label` over `state`, first `init`.
pub fn loop_opened(p: Place, pr: Printing, label: Int, state: List<Var>, init: List<Arg>, answer: Var) -> Printing =
  line(pr, p.depth, b"/* a loop, which this printer does not write yet */")

/// What closes `Loop` `label`.
pub fn loop_closed(p: Place, pr: Printing, label: Int, answer: Var) -> Printing = pr

/// The loop's next pass with `state` rebound to `args`.
pub fn next(p: Place, pr: Printing, label: Int, state: List<Var>, args: List<Arg>) -> Printing =
  line(pr, p.depth, b"/* a loop's next pass, which this printer does not write yet */")

/// The loop left answering `arg` into `answer`.
pub fn done(p: Place, pr: Printing, label: Int, answer: Var, arg: Arg) -> Printing =
  line(pr, p.depth, b"/* a loop's answer, which this printer does not write yet */")

/// The C names a closure body's parameters have.
pub fn lambda_names(f: Fn, nth: Int) -> Map<Int, Bytes> / {abort.raise} =
  range(0, f.params.len()).fold(Map::new(), |m: Map<Int, Bytes>, i: Int|
    m.insert(f.params.get(i).id, b"p".concat(ascii_of_int(i))))

/// The function of closure body `nth` of `root`, its body printed as `body`.
pub fn lambda_text(root: Fn, nth: Int, f: Fn, body: List<Piece>) -> List<Piece> =
  [Text(b"/* a closure's body, which this printer does not write yet */\n")]
