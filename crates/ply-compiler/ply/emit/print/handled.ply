//! A `handle`'s framing printed around the body the printer's driver prints, and the operations on
//! effects: a perform, a label, a `parallel` block, a `simulate`.

import std.bytes (ascii_of_int)
import emit.tir (Var, Arg, Uses)
import emit.tir.handling (HandleOp, HandleSite)
import emit.print.text (Printing, Place, line)

/// What opens `Handle` `label` laying out `site` over `args`, its answer into `answer`.
pub fn handle_opened(p: Place, pr: Printing, label: Int, args: List<Arg>, uses: Uses, site: HandleSite, answer: Var) -> Printing =
  line(pr, p.depth, b"/* a handle, which this printer does not write yet */")

/// The C a failure inside the body of `Handle` `label` runs, after its own releases, to reach the
/// handle's landing.
pub fn landing_jump(label: Int) -> Bytes = Bytes::concat_all([b"goto ply_h", ascii_of_int(label), b";"])

/// What closes `Handle` `label`: its landing, which answers a failure a clause catches and
/// otherwise leaves by `p.leave`, releasing what the handle holds across its body.
pub fn handle_closed(p: Place, pr: Printing, label: Int, site: HandleSite, answer: Var) -> Printing =
  line(
    line(pr, p.depth, Bytes::concat_all([b"ply_h", ascii_of_int(label), b": ;"])),
    p.depth,
    b"if (ctx->failed) ".concat(p.leave),
  )

/// Operation `op` on effects over `args`.
pub fn effect_op(p: Place, pr: Printing, into: Option<Var>, op: HandleOp, args: List<Arg>, uses: Uses) -> Printing =
  line(pr, p.depth, b"/* an operation on effects, which this printer does not write yet */")
