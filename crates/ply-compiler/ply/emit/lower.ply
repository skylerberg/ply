//! A root's `Code` lowered to the typed form. Each node is typed from its parts as it is lowered, so
//! a type belongs to its node and not to its place in the text; each value is held as its type says;
//! a value-producing `if` joins in a variable of its own type; a self call in tail position restarts
//! the body. It covers the scalar subset: `Int`, `Bool`, `Float` and carried widths, their literals
//! and operators, `let`, blocks, `if`, `&&`/`||`, and calls of the module's own definitions whose
//! parameters and answers are scalars. Any other node is refused, with what it was.

import code (Code, NLit, NVar, NBinary, NUnary, NIf, NBlock, NApp, CodeStmt, CLet, CLetPat, CDo,
             lower_to_emit)
import patterns (Lit, LInt, LBool, LFloat, LFixed)
import types (Type, TyCon, TyFn, Scheme, named_type, row_empty)
import diagnostics (parse_all)
import items (Item, IFn, FnDef)
import exprs (Param)
import typing (Typed)
import parsing (Span, dummy_span)
import resolve (qualify)
import emit (Width, literal_bits)
import std.bytes (ascii_of_int)
import emit.keys (RootKey, Named, Root, definition_of)
import emit.tir (Rep, RInt, RBool, RNum, RFloat, RDec, Var, Arg, AVar, AInt, ABool, AFloat, ANum,
                 AZero, Given, Convention, Val, Prim, Call, Inst, Let, Decl, Set, If, Return, Restart,
                 Block, Fn, Rooted, rep_of, comparison, ends, falls_through)

/// What a root's body is lowered under: its module and key, where its definition's text starts,
/// its parameters' and answer's types, the scheme of each definition it may call by full name, and
/// the types the checker filed by place.
pub type Context = {
  module: Bytes,
  key: RootKey,
  base: Int,
  params: List<Type>,
  answer: Type,
  schemes: Map<Bytes, Scheme>,
  typed: Map<Bytes, Typed>,
}

/// The body lowered so far: the next variable's number, what each slot holds, the block being
/// written, the first refusal, and whether a self call restarts the body.
type Lowering = {
  next: Int,
  env: Map<Int, Arg>,
  insts: List<Inst>,
  refused: Option<Bytes>,
  loops: Bool,
}

/// A node lowered: the state after it and the operand holding its value.
type Lowered = { st: Lowering, arg: Arg }

/// The root lowered, or why its body is outside what the lowering covers.
pub fn lowered_fn(cx: Context, body: Code) -> Result<Fn, Bytes> / {abort.raise} = {
  let params = range(0, cx.params.len()).map(|i: Int|
    { id: i, ty: cx.params.get(i), rep: rep_of(cx.params.get(i)) });
  let answer = rep_of(cx.answer);
  if !params.all(|p: Var| scalar(p.rep)) || !scalar(answer) {
    Err(b"a parameter or answer held as a word")
  } else {
    let start = {
      next: params.len(),
      env: range(0, params.len()).fold(Map::new(), |m: Map<Int, Arg>, i: Int|
        m.insert(i, AVar(params.get(i)))),
      insts: [],
      refused: None,
      loops: false,
    };
    let out = lowered(cx, start, body, true);
    match out.st.refused {
      Some(why) -> Err(why),
      None ->
        Ok({
          key: cx.key,
          kind: Rooted,
          params: params,
          conv: { params: params.map(|_: Var| Given), reps: params.map(|p: Var| p.rep), answer: answer },
          body: if falls_through(out.st.insts) { out.st.insts.push(Return(out.arg)) }
          else { out.st.insts },
          lambdas: [],
          base: cx.base,
          members: [],
        }),
    }
  }
}

/// Whether the subset holds a value held as `r`.
fn scalar(r: Rep) -> Bool =
  match r { RInt -> true, RBool -> true, RNum(_) -> true, RFloat -> true, _ -> false }

/// The one recursion over a body: each node lowered after its parts, which are lowered here or in
/// a fold over them, so the recursion descends through the node and nothing else.
fn lowered(cx: Context, st: Lowering, c: Code, tail: Bool) -> Lowered / {abort.raise} =
  if st.refused != None { { st: st, arg: AZero(RInt) } } else {
    match c.node {
      NLit(l) -> literal(st, l),
      NVar(v) -> match v.slot {
        Some(s) -> match st.env.get(s) {
          Some(a) -> { st: st, arg: a },
          None -> refuse(st, b"a slot nothing bound: ".concat(v.name)),
        },
        None -> refuse(st, b"a global read as a value: ".concat(v.name)),
      },
      NUnary(u) -> {
        let o = lowered(cx, st, u.operand, false);
        unary(o, u.op, c.span)
      },
      NBinary(b) -> match folded(c) {
        Some(n) -> { st: st, arg: AInt(n) },
        None -> if b.op == b"and" || b.op == b"or" {
          let l = lowered(cx, st, b.lhs, false);
          let r = lowered(cx, { ..l.st, insts: [] }, b.rhs, tail);
          short_circuit(l, r, b.op == b"and")
        } else {
          let l = lowered(cx, st, b.lhs, false);
          let r = match divisor(b.op, b.rhs) {
            Some(d) -> { st: l.st, arg: AInt(d) },
            None -> lowered(cx, l.st, b.rhs, false),
          };
          binary(l.arg, r, b.op, c.span)
        },
      },
      NBlock(bl) -> {
        let after = bl.stmts.fold(st, |acc: Lowering, s: CodeStmt|
          match s {
            CLet(l) -> {
              let v = lowered(cx, acc, l.value, false);
              { ..v.st, env: v.st.env.insert(l.slot, v.arg) }
            },
            CLetPat(_) -> refuse(acc, b"a pattern bound by `let`").st,
            CDo(d) -> lowered(cx, acc, d.code, false).st,
          });
        match bl.tail {
          Some(t) -> lowered(cx, after, t, tail),
          None -> refuse(after, b"a block answering the unit"),
        }
      },
      NIf(i) -> {
        let cond = lowered(cx, st, i.cond, false);
        let then = lowered(cx, { ..cond.st, insts: [] }, i.then_branch, tail);
        let otherwise = lowered(cx, { ..then.st, insts: [], env: cond.st.env }, i.else_branch, tail);
        joined(cx, cond, then, otherwise)
      },
      NApp(a) -> match a.func.node {
        NVar(f) -> if f.slot != None { refuse(st, b"a call of a function value") } else {
          let args = a.args.fold({ st: st, args: [] },
            |acc: { st: Lowering, args: List<Arg> }, x: Code| {
              let o = lowered(cx, acc.st, x, false);
              { st: o.st, args: acc.args.push(o.arg) }
            });
          called(cx, args.st, qualify(cx.module, f.name), args.args, tail, c.span)
        },
        _ -> refuse(st, b"a call of a computed function"),
      },
      _ -> refuse(st, b"a node outside the scalar subset"),
    }
  }

fn refuse(st: Lowering, why: Bytes) -> Lowered =
  { st: match st.refused { Some(_) -> st, None -> { ..st, refused: Some(why) } }, arg: AZero(RInt) }

/// A literal as the operand it is: no variable holds one.
fn literal(st: Lowering, l: Lit) -> Lowered / {abort.raise} =
  match l {
    LInt(n) -> { st: st, arg: AInt(n) },
    LBool(b) -> { st: st, arg: ABool(b) },
    LFloat(x) -> { st: st, arg: AFloat(literal_bits(x)) },
    LFixed(name, bits) -> match width_named(name) {
      Some(w) -> if w.bits <= 64 { { st: st, arg: ANum({ width: w, bits: bits }) } }
      else { refuse(st, b"a literal of a width wider than a register") },
      None -> refuse(st, b"a literal of no known width"),
    },
    _ -> refuse(st, b"a literal held as a word"),
  }

/// `st` with `val` bound to a new variable of type `ty`, and that variable.
fn bound(st: Lowering, ty: Type, val: Val, at: Span) -> Lowered = {
  let v = { id: st.next, ty: ty, rep: rep_of(ty) };
  {
    st: { ..st, next: st.next + 1, insts: st.insts.push(Let({ var: v, val: val, at: at, unwind: [] })) },
    arg: AVar(v),
  }
}

fn unary(o: Lowered, op: Bytes, at: Span) -> Lowered =
  if op == b"not" { bound(o.st, named_type(b"Bool"), Prim({ op: op, on: RBool, args: [o.arg] }), at) }
  else if op == b"neg" || op == b"bitnot" {
    bound(o.st, type_of(o.arg), Prim({ op: op, on: rep_of(type_of(o.arg)), args: [o.arg] }), at)
  } else { refuse(o.st, b"an operator outside the scalar subset: ".concat(op)) }

/// `l op r`, read at the type of whichever operand says more than an `Int` literal does: a
/// comparison answers a `Bool`, any other operator the operands' type.
fn binary(l: Arg, r: Lowered, op: Bytes, at: Span) -> Lowered = {
  let on = match l { AInt(_) -> type_of(r.arg), _ -> type_of(l) };
  bound(r.st, if comparison(op) { named_type(b"Bool") } else { on }, Prim({
    op: op,
    on: rep_of(on),
    args: [l, r.arg],
  }), at)
}

/// The divisor an `Int` division or remainder takes as a literal where it is a negated one:
/// C's own operator then divides by it.
fn divisor(op: Bytes, rhs: Code) -> Option<Int> =
  if op != b"div" && op != b"rem" { None } else {
    match rhs.node {
      NUnary(u) -> if u.op != b"neg" { None } else {
        match u.operand.node {
          NLit(l) -> match l {
            LInt(v) -> if v == 0 || v == 1 { None } else { Some(0 - v) },
            _ -> None,
          },
          _ -> None,
        }
      },
      _ -> None,
    }
  }

/// Two `Int` literals under an operator, folded where the result is exact: `+`, `-` and `*` without
/// overflow, the bit operators, and shifts by a count the word holds.
fn folded(c: Code) -> Option<Int> =
  match c.node {
    NLit(l) -> match l { LInt(n) -> Some(n), _ -> None },
    NBinary(b) -> match folded(b.lhs) {
      None -> None,
      Some(a) -> match folded(b.rhs) {
        None -> None,
        Some(x) -> if b.op == b"add" { exact_add(a, x) }
        else if b.op == b"sub" { exact_sub(a, x) }
        else if b.op == b"mul" { exact_mul(a, x) }
        else if b.op == b"bitand" { Some(a & x) }
        else if b.op == b"bitor" { Some(a | x) }
        else if b.op == b"bitxor" { Some(a ^ x) }
        else if b.op == b"shl" && x >= 0 && x < 64 { Some(a << x) }
        else if b.op == b"shr" && x >= 0 && x < 64 { Some(a >> x) }
        else if b.op == b"ushr" && x >= 0 && x < 64 { Some(a >>> x) }
        else { None },
      },
    },
    _ -> None,
  }

fn exact_add(a: Int, b: Int) -> Option<Int> = {
  let s = wrap_add(a, b);
  if a >= 0 == (b >= 0) && s >= 0 != (a >= 0) { None } else { Some(s) }
}

fn exact_sub(a: Int, b: Int) -> Option<Int> = {
  let s = wrap_sub(a, b);
  if a >= 0 != (b >= 0) && s >= 0 != (a >= 0) { None } else { Some(s) }
}

fn exact_mul(a: Int, b: Int) -> Option<Int> =
  if a == 0 || b == 0 { Some(0) }
  else if a == -1 { exact_sub(0, b) }
  else if b == -1 { exact_sub(0, a) } else {
    let p = wrap_mul(a, b);
    if p / a == b && p % a == 0 { Some(p) } else { None }
  }

/// `l && r` or `l || r`: a `Bool` joined from the right operand where the left one does not decide.
fn short_circuit(l: Lowered, r: Lowered, both: Bool) -> Lowered = {
  let j = { id: r.st.next, ty: named_type(b"Bool"), rep: RBool };
  let right = if falls_through(r.st.insts) { r.st.insts.push(Set({ var: j, arg: r.arg })) }
  else { r.st.insts };
  let decided = [Set({ var: j, arg: ABool(!both) })];
  {
    st: {
      ..r.st,
      next: r.st.next + 1,
      insts: l.st.insts.push(Decl(j)).push(If({
        cond: l.arg,
        then: if both { right } else { decided },
        otherwise: if both { decided } else { right },
      })),
    },
    arg: AVar(j),
  }
}

/// An `if` whose arms join in a variable of the type they answer; an arm that restarts the body
/// or leaves it sets nothing.
fn joined(cx: Context, cond: Lowered, then: Lowered, otherwise: Lowered) -> Lowered = {
  let ty = if falls_through(then.st.insts) { type_of(then.arg) }
  else if falls_through(otherwise.st.insts) { type_of(otherwise.arg) }
  else { cx.answer };
  let j = { id: otherwise.st.next, ty: ty, rep: rep_of(ty) };
  let set = |arm: Lowered|
    if falls_through(arm.st.insts) { arm.st.insts.push(Set({ var: j, arg: arm.arg })) }
    else { arm.st.insts };
  {
    st: {
      ..otherwise.st,
      next: otherwise.st.next + 1,
      env: cond.st.env,
      insts: cond.st.insts.push(Decl(j)).push(If({ cond: cond.arg, then: set(then), otherwise: set(otherwise) })),
    },
    arg: AVar(j),
  }
}

/// A call of definition `full` of the module: a restart where it is the root's own definition
/// called in tail position with every parameter, and otherwise a call through its convention.
fn called(
  cx: Context,
  st: Lowering,
  full: Bytes,
  args: List<Arg>,
  tail: Bool,
  at: Span,
) -> Lowered =
  match cx.schemes.get(full) {
    None -> refuse(st, b"a call of a name the module does not define: ".concat(full)),
    Some(sc) -> if sc.ty_vars.len() > 0 { refuse(st, b"a call of a generic definition") } else {
      match sc.ty {
        TyFn(f) -> if f.params.len() != args.len() { refuse(st, b"a call that does not fill its parameters") }
        else if !f.params.all(|t: Type| scalar(rep_of(t))) || !scalar(rep_of(f.ret)) {
          refuse(st, b"a call of a definition taking or answering a word")
        } else if tail && definition_of(cx.key) == Some(full) && args.len() == cx.params.len() {
          { st: { ..st, loops: true, insts: st.insts.push(Restart(args)) }, arg: AZero(rep_of(f.ret)) }
        } else {
          bound(st, f.ret, Call({
            callee: Root(Named(full)),
            args: args,
            conv: {
              params: f.params.map(|_: Type| Given),
              reps: f.params.map(rep_of),
              answer: rep_of(f.ret),
            },
            stops: false,
          }), at)
        },
        _ -> refuse(st, b"a call of a name that is no function"),
      }
    },
  }

/// The type an operand holds.
pub fn type_of(a: Arg) -> Type =
  match a {
    AVar(v) -> v.ty,
    AInt(_) -> named_type(b"Int"),
    ABool(_) -> named_type(b"Bool"),
    AFloat(_) -> named_type(b"Float"),
    ANum(n) -> named_type(width_name(n.width)),
    _ -> named_type(b"Int"),
  }

fn width_named(name: Bytes) -> Option<Width> =
  if name == b"U8" { Some({ bits: 8, signed: false }) }
  else if name == b"U16" { Some({ bits: 16, signed: false }) }
  else if name == b"U32" { Some({ bits: 32, signed: false }) }
  else if name == b"U64" { Some({ bits: 64, signed: false }) }
  else if name == b"I8" { Some({ bits: 8, signed: true }) }
  else if name == b"I16" { Some({ bits: 16, signed: true }) }
  else if name == b"I32" { Some({ bits: 32, signed: true }) }
  else if name == b"I64" { Some({ bits: 64, signed: true }) }
  else if name == b"U128" { Some({ bits: 128, signed: false }) }
  else if name == b"I128" { Some({ bits: 128, signed: true }) }
  else { None }

fn width_name(w: Width) -> Bytes =
  Bytes::concat_all([if w.signed { b"I" } else { b"U" }, ascii_of_int(w.bits)])

/// `m.<name>` of `src` lowered, under `schemes` for the definitions it calls, each a function of
/// the named types.
fn form_of(src: Bytes, name: Bytes, sigs: List<{ name: Bytes, params: List<Bytes>, ret: Bytes }>) -> Result<Fn, Bytes> / {abort.raise} = {
  let schemes = sigs.fold(Map::new(), |m: Map<Bytes, Scheme>, s: { name: Bytes, params: List<Bytes>, ret: Bytes }|
    m.insert(qualify(b"m", s.name), {
      ty_vars: [],
      row_vars: [],
      label_vars: [],
      ty: TyFn({ params: s.params.map(named_type), ret: named_type(s.ret), effects: row_empty() }),
    }));
  match parse_all([{ name: b"m", src: src }]).get(0).module.module.items.fold(None, |acc: Option<FnDef>, i: Item|
      match i { IFn(d) -> if d.name.name == name { Some(d) } else { acc }, _ -> acc }) {
    None -> Err(b"no such definition"),
    Some(d) -> match schemes.get(qualify(b"m", name)) {
      Some(sc) -> match sc.ty {
        TyFn(f) -> match lower_to_emit(d.params.map(|p: Param| p.name.name), [], Map::new(), d.body) {
          Some(l) ->
            lowered_fn(
              {
                module: b"m",
                key: Named(qualify(b"m", name)),
                base: d.span.start,
                params: f.params,
                answer: f.ret,
                schemes: schemes,
                typed: Map::new(),
              },
              l.code,
            ),
          None -> Err(b"not lowered"),
        },
        _ -> Err(b"no function"),
      },
      None -> Err(b"no scheme"),
    },
  }
}

fn local(id: Int, ty: Bytes) -> Var = { id: id, ty: named_type(ty), rep: rep_of(named_type(ty)) }

test "an if that answers a value joins in a variable of the type its arms answer" {
  let f = form_of(b"fn pick(c: Bool, a: Int, b: Int) -> Int = if c { a } else { b }\n", b"pick", [
    { name: b"pick", params: [b"Bool", b"Int", b"Int"], ret: b"Int" },
  ]);
  let j = local(3, b"Int");
  assert_eq(
    match f { Ok(x) -> Ok(x.body), Err(why) -> Err(why) },
    Ok([
      Decl(j),
      If({
        cond: AVar(local(0, b"Bool")),
        then: [Set({ var: j, arg: AVar(local(1, b"Int")) })],
        otherwise: [Set({ var: j, arg: AVar(local(2, b"Int")) })],
      }),
      Return(AVar(j)),
    ]),
  )
}

test "a self call in tail position restarts the body, and a join's restarting arm sets nothing" {
  let f = form_of(
    b"fn total(n: Int, acc: Int) -> Int = if n == 0 { acc } else { total(n - 1, acc) }\n",
    b"total",
    [{ name: b"total", params: [b"Int", b"Int"], ret: b"Int" }],
  );
  match f {
    Err(why) -> assert_eq(why, b""),
    Ok(x) -> match x.body.at(2) {
      Some(If(i)) -> {
        assert_eq(i.then.len(), 1);
        assert_eq(i.otherwise.at(i.otherwise.len() - 1), Some(Restart([AVar(local(3, b"Int")), AVar(local(1, b"Int"))])))
      },
      other -> assert_eq(other, None),
    },
  }
}

test "&& joins a Bool from its right operand where the left one does not decide" {
  let f = form_of(b"fn both(a: Bool, b: Bool) -> Bool = a && b\n", b"both", [
    { name: b"both", params: [b"Bool", b"Bool"], ret: b"Bool" },
  ]);
  let j = local(2, b"Bool");
  assert_eq(
    match f { Ok(x) -> Ok(x.body), Err(why) -> Err(why) },
    Ok([
      Decl(j),
      If({
        cond: AVar(local(0, b"Bool")),
        then: [Set({ var: j, arg: AVar(local(1, b"Bool")) })],
        otherwise: [Set({ var: j, arg: ABool(false) })],
      }),
      Return(AVar(j)),
    ]),
  )
}

test "a body outside the scalar subset is refused with what it held" {
  let sigs = [
    { name: b"name", params: [b"String"], ret: b"String" },
    { name: b"pair", params: [b"Int"], ret: b"Int" },
    { name: b"upper", params: [b"String"], ret: b"Int" },
  ];
  let src = b"fn name(s: String) -> String = s\nfn pair(x: Int) -> Int = match x { 0 -> 1, _ -> 2 }\nfn upper(s: String) -> Int = 1\n";
  assert_eq(match form_of(src, b"name", sigs) { Ok(_) -> b"", Err(w) -> w }, b"a parameter or answer held as a word");
  assert_eq(match form_of(src, b"pair", sigs) { Ok(_) -> b"", Err(w) -> w }, b"a node outside the scalar subset");
  assert_eq(
    match form_of(b"fn g(x: Int) -> Int = upper(x)\n", b"g", sigs.push({ name: b"g", params: [b"Int"], ret: b"Int" })) {
      Ok(_) -> b"",
      Err(w) -> w,
    },
    b"a call of a definition taking or answering a word",
  )
}
