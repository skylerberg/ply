//! A root's C as the printer writes it: text, and holes for what only the unit knows, each a value
//! the unit fills, never a placeholder found by scanning the text.

import emit.keys (Callee, Root, Generic, Named, root_name)
import emit (symbol_of)
import std.bytes (ascii_of_int)

pub type Piece = | Text(Bytes) | Hole(Reloc)

/// What the unit writes into a hole. `Symbol` is a root's, a generic call's once settled;
/// `SiteRoot` the id a failure site names its root by, this root's or, in a tail group, member
/// `i`'s; the rest are positions in the unit's tables of constants, builtins, field names, shapes
/// and lambda entries, and the tag of a constructor by its name.
pub type Reloc =
  | Symbol(Callee)
  | SiteRoot(Option<Int>)
  | Constant(Int)
  | BuiltinAt(Int)
  | FieldName(Int)
  | ShapeOf(Int)
  | LambdaEntry(Int)
  | TagOf(Bytes)

/// The placeholder today's unit reads for `r` (`@@g3@@`, `@@r@@`, `@@c0@@`), and a root's symbol
/// as itself: what an answer's text holds until the unit fills holes by value.
pub fn placeholder(r: Reloc) -> Bytes / {abort.raise} =
  match r {
    Symbol(Root(k)) -> symbol_of(root_name(k)),
    Symbol(Generic(n)) -> held(b"g", n),
    SiteRoot(None) -> b"@@r@@",
    SiteRoot(Some(i)) -> held(b"r", i),
    Constant(i) -> held(b"c", i),
    BuiltinAt(i) -> held(b"b", i),
    FieldName(i) -> held(b"f", i),
    ShapeOf(i) -> held(b"s", i),
    LambdaEntry(i) -> held(b"l", i),
    TagOf(name) -> Bytes::concat_all([b"@@T", name, b"@@"]),
  }

fn held(kind: Bytes, i: Int) -> Bytes = Bytes::concat_all([b"@@", kind, ascii_of_int(i), b"@@"])

/// The text an answer carries today: every hole as its placeholder.
pub fn spelled(pieces: List<Piece>) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    pieces.fold([], |acc: List<Bytes>, p: Piece|
      acc.push(match p { Text(t) -> t, Hole(r) -> placeholder(r) })),
  )

/// Adjacent texts as one, so a printer may write as many as it likes.
pub fn merged(pieces: List<Piece>) -> List<Piece> =
  pieces.fold([], |acc: List<Piece>, p: Piece|
    match p {
      Text(t) -> match acc.at(acc.len() - 1) {
        Some(Text(prev)) -> acc.take(acc.len() - 1).push(Text(prev.concat(t))),
        _ -> acc.push(p),
      },
      Hole(_) -> acc.push(p),
    })

test "a hole is written as the unit's placeholder for it, and a root as its symbol" {
  let pieces = [
    Text(b"PLY_SITE(ctx, "),
    Hole(SiteRoot(None)),
    Text(b", 3, 9); "),
    Hole(Symbol(Generic(2))),
    Text(b"(ctx, "),
    Hole(Constant(0)),
    Text(b")"),
  ];
  assert_eq(spelled(pieces), b"PLY_SITE(ctx, @@r@@, 3, 9); @@g2@@(ctx, @@c0@@)");
  assert_eq(spelled([Hole(Symbol(Root(Named(b"m.f"))))]), symbol_of(b"m.f"));
  assert_eq(spelled([Hole(SiteRoot(Some(1))), Hole(TagOf(b"m.Box"))]), b"@@r1@@@@Tm.Box@@")
}

test "adjacent texts merge and holes stay where they were" {
  assert_eq(merged([Text(b"a"), Text(b"b"), Hole(Constant(1)), Text(b"c"), Text(b"d")]), [
    Text(b"ab"),
    Hole(Constant(1)),
    Text(b"cd"),
  ])
}
