//! The typed form printed as C: the only place C is spelled. A root prints as its C function, the
//! fuel and stack checks every call makes, its body, and the entry the runtime calls it by with
//! words; what only the unit knows (a root's symbol, a site's root id) is a hole for it to fill.
//! This module holds the recursion over blocks; each instruction's family prints it, and for an
//! instruction holding blocks, the framing around them (`emit.print.*`).

import parsing (Span, span_between)
import types (TyCon)
import std.bytes (ascii_of_int)
import emit (symbol_of)
import emit.keys (Named, root_name)
import emit.pieces (Piece, Text, merged, spelled)
import emit.tir (Rep, RInt, RBool, RWord, Var, Arg, AVar, AInt, Val, Prim, Literal, Static, Make, Get,
                 Pack, Gathered, Call, Apply, Native, Op, OHandle, OContainer, MClosure, MList, MArray,
                 Inst, Let, Do, Decl, Assign, If, Case, Match, Miss, Loop, Next, Done, Return, Restart,
                 Enter, Fail, Handle, Inc, Dec, Reset, Free, Opened, Block, Fn, Rooted, Given, Closure,
                 Uses, no_links, falls_through)
import emit.print.text (Under, Place, Printing, Printed, printing, line, text, named, name_of, arg_text,
                        assigned, label, check, zero, failing_return)
import emit.print.counts (released, count_printed)
import emit.print.made (c_type, c_types, as_word, word_as, made, got, packed, gathered, statics)
import emit.print.prims (literal, prim)
import emit.print.containers (contained, container_op)
import emit.print.tested (case_opened, case_arm, case_arm_closed, case_rest, case_closed, match_opened,
                          match_arm, match_arm_closed, match_rest, match_closed, missed, failed)
import emit.print.invoked (call, applied, closure_made, restarted, entered_member, loop_opened,
                           loop_closed, next, done, lambda_names, lambda_text)
import emit.print.handled (handle_opened, handle_closed, landing_jump, effect_op)

/// Root `f` as its C function and entry, and its closures' bodies.
pub fn printed_fn(f: Fn) -> Printed / {abort.raise} = {
  let name = symbol_of(root_name(f.key));
  let body = body_printed(f, printing(param_names(f)));
  let words = range(0, f.params.len()).map(|i: Int|
    as_word(b"p".concat(ascii_of_int(i)), f.params.get(i).rep));
  let closures = range(0, f.lambdas.len()).fold(body, |pr: Printing, k: Int|
    match f.lambdas.at(k) {
      Some(Closure(lf)) -> {
        let inner = body_printed(lf, { ..pr, out: [], names: lambda_names(lf, k) });
        { ..inner, out: pr.out, names: pr.names, lambdas: inner.lambdas.push(lambda_text(f, k, lf, inner.out)) }
      },
      None -> pr,
    });
  {
    pieces: merged(
      [
        Text(Bytes::concat_all([
          b"Word ",
          name,
          b"_entry(PlyCtx *ctx, const Word *args);\n",
          head(name, f),
          b" {\n",
          fuel_head(name.concat(b"_entry"), words, f.conv.answer),
        ])),
      ].concat(closures.out).push(Text(Bytes::concat_all([b"}\n", entry(name, f)]))),
    ),
    calls: closures.calls,
    consts: closures.consts,
    builtins: closures.builtins,
    fields: closures.fields,
    shapes: closures.shapes,
    lambdas: closures.lambdas,
    performs: closures.performs,
    handles: closures.handles,
    expects: closures.expects,
  }
}

fn param_names(f: Fn) -> Map<Int, Bytes> / {abort.raise} =
  range(0, f.params.len()).fold(Map::new(), |m: Map<Int, Bytes>, i: Int|
    m.insert(f.params.get(i).id, b"p".concat(ascii_of_int(i))))

/// `f`'s body, its restart label first where a self call restarts it.
fn body_printed(f: Fn, pr: Printing) -> Printing / {abort.raise} = {
  let u = { base: f.base, answer: f.conv.answer, site: None, arm: None, looping: None, landing: None };
  let looped = if restarts(f.body) {
    text(pr, Bytes::concat_all([b"  ply_loop: ", tick_line(failing_return(f.conv.answer)), b"\n"]))
  } else { pr };
  printed(u, looped, f.body, 0)
}

/// Whether a self call restarts the body anywhere in `b`.
fn restarts(b: Block) -> Bool =
  b.fold(false, |found: Bool, i: Inst|
    found
      || (match i {
        Restart(_) -> true,
        If(x) -> restarts(x.then) || restarts(x.otherwise),
        Case(c) -> restarts(c.rest) || c.arms.fold(false, |any: Bool, a: { when: Int, body: Block }| any || restarts(a.body)),
        Match(m) -> restarts(m.rest) || m.arms.fold(false, |any: Bool, a: Block| any || restarts(a)),
        Loop(l) -> restarts(l.body),
        Handle(h) -> restarts(h.body),
        _ -> false,
      }))

/// The C a failure runs where the path holds `unwind`: their releases, then the enclosing handle's
/// landing, or else leaving the function.
fn leave_of(u: Under, pr: Printing, unwind: List<Var>) -> Bytes = {
  let releases = released(pr, unwind);
  let out = match u.landing { Some(j) -> j, None -> failing_return(u.answer) };
  if releases == b"" { out } else { Bytes::concat_all([b"{ ", releases, b" ", out, b" }"]) }
}

/// The one recursion over a body: each instruction printed in turn, a block it holds within it.
fn printed(u: Under, pr: Printing, b: Block, depth: Int) -> Printing / {abort.raise} =
  b.fold(pr, |acc: Printing, i: Inst| {
    let p = { u: u, at: span_between(0, 0), leave: failing_return(u.answer), depth: depth };
    match i {
      Let(l) -> value_printed({ ..p, at: l.at, leave: leave_of(u, acc, l.unwind) }, acc, Some(l.var), l.val),
      Do(d) -> value_printed({ ..p, at: d.at, leave: leave_of(u, acc, d.unwind) }, acc, None, d.val),
      Decl(v) -> {
        let n = named(acc, v);
        line(n.pr, depth, Bytes::concat_all([c_type(v.rep), b" ", n.name, b" = ", zero(v.rep), b";"]))
      },
      Assign(s) -> line(acc, depth, Bytes::concat_all([name_of(acc, s.var), b" = ", arg_text(acc, s.arg), b";"])),
      If(x) -> {
        let opened = line(acc, depth, Bytes::concat_all([b"if (", arg_text(acc, x.cond), b") {"]));
        let t = printed(u, opened, x.then, depth + 1);
        let e = printed(u, line(t, depth, b"} else {"), x.otherwise, depth + 1);
        line(e, depth, b"}")
      },
      Case(c) -> {
        let arms = c.arms.fold(case_opened(p, acc, c.on, c.test),
          |q: Printing, a: { when: Int, body: Block }|
            case_arm_closed(p, printed(u, case_arm(p, q, c.on, c.test, a.when), a.body, depth + 1)));
        case_closed(p, printed(u, case_rest(p, arms, c.on, c.test), c.rest, depth + 1))
      },
      Match(m) -> {
        let l = label(acc);
        let arms = m.arms.fold({ pr: match_opened(p, l.pr, l.n, m.arms.len()), at: 0 },
          |q: { pr: Printing, at: Int }, a: Block| {
            let armed = printed({ ..u, arm: Some({ label: l.n, at: q.at }) }, match_arm(p, q.pr, l.n, q.at), a, depth);
            { pr: if falls_through(a) { match_arm_closed(p, armed, l.n, q.at) } else { armed }, at: q.at + 1 }
          });
        match_closed(p, printed(u, match_rest(p, arms.pr, l.n, m.arms.len()), m.rest, depth), l.n)
      },
      Miss -> match u.arm {
        Some(a) -> missed(p, acc, a.label, a.at),
        None -> line(acc, depth, b"/* a miss outside a match */"),
      },
      Fail(why) -> failed(p, acc, why),
      Loop(lp) -> {
        let l = label(acc);
        let looped = { ..u, looping: Some({ label: l.n, state: lp.state, answer: lp.answer }) };
        loop_closed(p, printed(looped, loop_opened(p, l.pr, l.n, lp.state, lp.init, lp.answer), lp.body, depth + 1), l.n, lp.answer)
      },
      Next(args) -> match u.looping {
        Some(lp) -> next(p, acc, lp.label, lp.state, args),
        None -> line(acc, depth, b"/* a next pass outside a loop */"),
      },
      Done(a) -> match u.looping {
        Some(lp) -> done(p, acc, lp.label, lp.answer, a),
        None -> line(acc, depth, b"/* a loop's answer outside a loop */"),
      },
      Return(a) -> text(acc, Bytes::concat_all([b"  ctx->fuel += 1;\n  return ", arg_text(acc, a), b";\n"])),
      Restart(args) -> restarted(p, acc, args),
      Enter(e) -> entered_member(p, acc, e.member, e.args),
      // A failure in the body goes to the landing, which leaves by `hp.leave` where no clause answers.
      Handle(h) -> {
        let l = label(acc);
        let hp = { ..p, leave: leave_of(u, acc, h.unwind) };
        let inside = { ..u, landing: Some(landing_jump(l.n)) };
        handle_closed(hp, printed(inside, handle_opened(hp, l.pr, l.n, h.args, h.uses, h.site, h.answer), h.body, depth + 1), l.n, h.site, h.answer)
      },
      Inc(_) -> count_printed(p, acc, i),
      Dec(_) -> count_printed(p, acc, i),
      Reset(_) -> count_printed(p, acc, i),
      Free(_) -> count_printed(p, acc, i),
      Opened(_) -> count_printed(p, acc, i),
    }
  })

/// `val` printed by the family whose value it is, its answer into `into`.
fn value_printed(p: Place, pr: Printing, into: Option<Var>, val: Val) -> Printing / {abort.raise} =
  match val {
    Prim(x) -> prim(p, pr, into, x),
    Literal(l) -> literal(p, pr, into, l),
    Static(n) -> statics(p, pr, into, n),
    Make(m) -> match m.made {
      MClosure(_) -> closure_made(p, pr, into, m),
      MList(_) -> contained(p, pr, into, m),
      MArray(_) -> contained(p, pr, into, m),
      _ -> made(p, pr, into, m),
    },
    Get(g) -> got(p, pr, into, g),
    Pack(k) -> packed(p, pr, into, k),
    Gathered(g) -> gathered(p, pr, into, g.parts),
    Call(c) -> call(p, pr, into, c),
    Apply(c) -> applied(p, pr, into, c),
    Native(n) -> native(p, pr, into, n),
    Op(o) -> match o.op {
      OHandle(h) -> effect_op(p, pr, into, h, o.args, o.uses),
      OContainer(x) -> container_op(p, pr, into, x, o.args, o.uses),
    },
  }

/// A runtime function called by its C name with the context first, its answer a word.
fn native(p: Place, pr: Printing, into: Option<Var>, n: { name: Bytes, args: List<Arg>, uses: Uses }) -> Printing = {
  let call = Bytes::concat_all([
    n.name,
    b"(ctx",
    Bytes::concat_all(n.args.map(|a: Arg| b", ".concat(arg_text(pr, a)))),
    b")",
  ]);
  let written = match into {
    Some(v) -> assigned(pr, p.depth, v, c_type(v.rep), call),
    None -> line(pr, p.depth, call.concat(b";")),
  };
  if n.uses.fails { check(p, written) } else { written }
}

/// The C a root's function is declared with: its answer's and each parameter's C types.
fn head(name: Bytes, f: Fn) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    c_type(f.conv.answer),
    b" ",
    name,
    b"(PlyCtx *ctx",
    Bytes::concat_all(range(0, f.conv.reps.len()).map(|i: Int| {
      let ts = c_types(f.conv.reps.get(i));
      Bytes::concat_all(range(0, ts.len()).map(|k: Int|
        Bytes::concat_all([b", ", ts.get(k), b" p", ascii_of_int(i), if ts.len() == 1 { b"" } else { b"_".concat(ascii_of_int(k)) }])))
    })),
    b")",
  ])

/// Counts the call, spends a unit of fuel, and hands the call a stack of its own when this thread's
/// is nearly out; the same call on the new stack is counted once.
fn fuel_head(entry: Bytes, words: List<Bytes>, answer: Rep) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"  if (ctx->fuel <= 0) { rt_no_fuel_p(ctx); ",
    failing_return(answer),
    b" }\n",
    b"  { char probe; if ((uintptr_t)&probe < ctx->stack_floor) { ",
    grow_call(entry, words, answer),
    b" } }\n",
    b"  ",
    tick_line(failing_return(answer)),
    b"\n",
    b"  ctx->fuel -= 1;\n",
  ])

fn tick_line(leave: Bytes) -> Bytes =
  Bytes::concat_all([b"if (++ctx->ticks >= ctx->next_tick) { rt_tick_p(ctx); if (ctx->failed) ", leave, b" }"])

fn grow_call(entry: Bytes, args: List<Bytes>, answer: Rep) -> Bytes / {abort.raise} =
  if args.len() == 0 {
    grown_return(Bytes::concat_all([b"rt_grow_p(ctx, (Word)(intptr_t)&", entry, b", 0)"]), answer)
  } else {
    Bytes::concat_all([
      b"Word ply_grown[",
      ascii_of_int(args.len()),
      b"];",
      Bytes::concat_all(range(0, args.len()).map(|i: Int|
        Bytes::concat_all([b" ply_grown[", ascii_of_int(i), b"] = ", args.get(i), b";"]))),
      b" ",
      grown_return(
        Bytes::concat_all([b"rt_grow_p(ctx, (Word)(intptr_t)&", entry, b", (Word)(intptr_t)ply_grown)"]),
        answer,
      ),
    ])
  }

/// The grown call's word returned as a root answering `answer` returns it.
fn grown_return(grown: Bytes, answer: Rep) -> Bytes =
  match answer {
    RWord -> Bytes::concat_all([b"return ", grown, b";"]),
    _ ->
      Bytes::concat_all([
        b"Word ply_back = ",
        grown,
        b"; if (ctx->failed) ",
        failing_return(answer),
        b" ",
        c_type(answer),
        b" ply_out = ",
        word_as(b"ply_back", answer),
        b"; ply_dec(ctx, ply_back); return ply_out;",
      ]),
  }

/// The entry the runtime and closures call a root by, words in and out.
fn entry(name: Bytes, f: Fn) -> Bytes / {abort.raise} = {
  let conv = f.conv;
  let opened = range(0, conv.reps.len()).map(|i: Int| {
    let arg = Bytes::concat_all([b"args[", ascii_of_int(i), b"]"]);
    let r = conv.reps.get(i);
    match r {
      RWord -> { text: b"", arg: arg },
      _ ->
        {
          text: Bytes::concat_all([
            b"  ",
            c_type(r),
            b" a",
            ascii_of_int(i),
            b" = ",
            word_as(arg, r),
            b"; ply_dec(ctx, ",
            arg,
            b");\n",
          ]),
          arg: b"a".concat(ascii_of_int(i)),
        },
    }
  });
  let call = Bytes::concat_all([
    name,
    b"(ctx",
    Bytes::concat_all(opened.map(|o: { text: Bytes, arg: Bytes }| b", ".concat(o.arg))),
    b")",
  ]);
  Bytes::concat_all([
    b"Word ",
    name,
    b"_entry(PlyCtx *ctx, const Word *args) {\n",
    Bytes::concat_all(opened.map(|o: { text: Bytes, arg: Bytes }| o.text)),
    match conv.answer {
      RWord -> Bytes::concat_all([b"  return ", call, b";\n"]),
      r ->
        Bytes::concat_all([
          b"  ",
          c_type(r),
          b" r = ",
          call,
          b";\n  if (ctx->failed) return 0;\n  return ",
          as_word(b"r", r),
          b";\n",
        ]),
    },
    b"}\n",
  ])
}

/// Whether `run` stands in `lines` as consecutive lines.
fn holds_run(lines: List<Bytes>, run: List<Bytes>) -> Bool =
  range(0, lines.len()).any(|i: Int| lines.drop(i).take(run.len()) == run)

test "a restart takes its arguments into temporaries before it sets the parameters, then loops" {
  let int = TyCon({ name: b"Int", args: [] });
  let local = |id: Int, rep: Rep| { id: id, ty: int, rep: rep };
  let n = local(0, RInt);
  let acc = local(1, RInt);
  let c = local(2, RBool);
  let j = local(3, RInt);
  let a = local(4, RInt);
  let let_of = |v: Var, val: Val, at: Span| Let({ var: v, val: val, at: at, unwind: [] });
  let f = {
    key: Named(b"m.count"),
    kind: Rooted,
    params: [n, acc],
    conv: { params: [Given, Given], reps: [RInt, RInt], answer: RInt },
    body: [
      let_of(c, Prim({ op: b"eq", on: RInt, args: [AVar(n), AInt(0)] }), span_between(0, 0)),
      Decl(j),
      If({
        cond: AVar(c),
        then: [Assign({ var: j, arg: AVar(acc) })],
        otherwise: [
          let_of(a, Prim({ op: b"sub", on: RInt, args: [AVar(n), AInt(1)] }), span_between(10, 15)),
          Restart([AVar(a), AVar(acc)]),
        ],
      }),
      Return(AVar(j)),
    ],
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
  };
  let lines = spelled(printed_fn(f).pieces).split(b"\n");
  assert_eq(
    holds_run(lines, [
      b"  ctx->fuel -= 1;",
      b"  ply_loop: if (++ctx->ticks >= ctx->next_tick) { rt_tick_p(ctx); if (ctx->failed) return 0; }",
      b"  int64_t t1 = (p0) == (INT64_C(0));",
      b"  int64_t t2 = 0;",
      b"  if (t1) {",
      b"    t2 = p1;",
      b"  } else {",
      b"    PLY_SITE(ctx, @@r@@, 10, 15);",
      b"    int64_t t3;",
      b"    if (ply_sub_ov(p0, INT64_C(1), &t3)) { rt_overflow_p(ctx, 1); return 0; }",
      b"    int64_t t4 = t3;",
      b"    int64_t t5 = p1;",
      b"    p0 = t4;",
      b"    p1 = t5;",
      b"    goto ply_loop;",
      b"  }",
      b"  ctx->fuel += 1;",
      b"  return t2;",
      b"}",
    ]),
    true,
  );
  assert_eq(lines.at(1), Some(Bytes::concat_all([b"int64_t ", symbol_of(b"m.count"), b"(PlyCtx *ctx, int64_t p0, int64_t p1) {"])))
}

test "a failure inside a handle's body goes to its landing, and the landing leaves the function" {
  let int = TyCon({ name: b"Int", args: [] });
  let n = { id: 0, ty: int, rep: RInt };
  let t = { id: 1, ty: int, rep: RInt };
  let answer = { id: 2, ty: int, rep: RInt };
  let f = {
    key: Named(b"m.guarded"),
    kind: Rooted,
    params: [n],
    conv: { params: [Given], reps: [RInt], answer: RInt },
    body: [
      Handle({
        body: [
          Let({ var: t, val: Prim({ op: b"add", on: RInt, args: [AVar(n), AInt(1)] }), at: span_between(10, 15), unwind: [] }),
          Assign({ var: answer, arg: AVar(t) }),
        ],
        args: [],
        uses: { takes: [], owned: false, fails: false, stops: false },
        site: { clauses: [], ret: None, detached: None },
        answer: answer,
        unwind: [],
      }),
      Return(AVar(answer)),
    ],
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
  };
  let text = spelled(printed_fn(f).pieces);
  assert(text.index_of(b"{ rt_overflow_p(ctx, 0); goto ply_h0; }") != None);
  assert(text.index_of(b"  ply_h0: ;\n  if (ctx->failed) return 0;\n") != None)
}
