//! What the form's operations on containers hold beyond their operands.

import layout (Intrinsic)
import emit (Width)

/// An operation on a container's cells, written in place over the objects the runtime lays out.
/// An item an operation reads or writes is a word in the object; its value is held as the operand
/// or answer that holds it.
pub type ContainerOp =
  /// An extern `layout.ply` declares over a list's or a map's nodes.
  | Laid(Intrinsic)
  /// How many items a list holds, or bytes a byte string, read off its header.
  | Length
  /// How many elements an array holds, its words counted a stride at a time.
  | Elements
  /// Byte `i` of a byte string, tested against its length.
  | ByteAt
  /// The four bytes from `i` of a byte string as a little-endian `U32`, tested against its length.
  | U32At
  /// Byte strings joined, without the list of them made.
  | Joined
  /// `Array::new(n, x)`, `Array::set(xs, i, x)`, `Array::of_list(xs)` and `Array::get(xs, i)` over
  /// an array laid out as its elements' type lays one out.
  | ArrayNew(Element)
  | ArraySet(Element)
  | ArrayOfList(Element)
  | ArrayGet(Element)
  /// Field `k` of record `i` of a `Columns`, read from its column, which holds the field as
  /// `column` lays out its elements, with no record made.
  | ColumnField({ k: Int, column: Element })

/// How an array holds each element (`held`), the words each takes (`stride`), the shapes it lays
/// them out by where it holds them in place, each record's held in place first and the element's
/// own last, by their fields' spellings, and which words of each element hold a count.
pub type Element = { held: Held, stride: Int, shapes: List<List<Bytes>>, counted: List<Int> }

/// An element held as its word, as a scalar's bits, as an `Option`'s payload's word in place, or as
/// a record copied in place behind a header of its own, `tail` the words of its bitmap.
pub type Held = | Words | Bits(Bits) | Payloads | Records({ tail: Int })

/// A scalar an array holds as its bits.
pub type Bits = | IntBits | WidthBits(Width) | FloatBits | DecimalBits
