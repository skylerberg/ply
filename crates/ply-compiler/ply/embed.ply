//! `embed("path")` and `embed_dir("path")`: a file's bytes, or a directory's files, as constants a
//! definition's hash covers. The driver reads what a module asks for, relative to the module's own
//! file, and the front end writes each call out as that literal before anything hashes it, so a
//! changed file is a changed definition.

import parsing (Span, Ident, ParseDiag, error_at)
import exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock, ERecord,
              ERecordUpdate, ETry, EField, EList, EPerform, EHandle, EWithCell, EWithHold,
              ESimulate, EParallel, EBad, ETryBlock, Stmt, SLet, SLetElse, SExpr, Param, MatchArm,
              HandleClause, ReturnClause, RecField, NamedArg, ETagged, Hole)
import patterns (LStr, LBytes)
import items (Module, Item, IFn, ITest, ILaw, ISchema, ImportDecl, INames, SpecClause)
import std.list (contains)
import std.bin

/// One file an embed read: its name in the directory, and empty for `embed`'s one file.
pub type EmbedFile = { name: Bytes, bytes: Bytes }

/// What a driver read for one embed: `embed`'s file as the one entry, `embed_dir`'s files in name
/// order, or why it could not. No constructor of the compiler's own is in it, so it reads the same in
/// every program that hands it on.
pub type EmbedRead = Result<List<EmbedFile>, Bytes>

/// One embed a module asks for: its path as written, and whether it names a directory.
pub type EmbedWant = { path: Bytes, dir: Bool }

derive bin for EmbedWant

/// The key a read is handed under.
pub fn embed_key(want: EmbedWant) -> Bytes =
  bytes_concat(if want.dir { b"dir:" } else { b"file:" }, want.path)

/// What a module embeds as it reads now, asked by the module's name in the program and the embed's key.
pub type EmbedReader = (Bytes, Bytes) -> EmbedRead / {abort.raise}

pub fn want_of_key(key: Bytes) -> EmbedWant / {abort.raise} =
  if bytes_starts_with(key, b"dir:") { { path: bytes_slice(key, 4, bytes_len(key)), dir: true } }
  else { { path: bytes_slice(key, 5, bytes_len(key)), dir: false } }

/// One read the front end wrote out, by the module's name in the program. The answer carries them,
/// so a pass that parses the program's text again writes the same literals.
pub type EmbedAt = { module: Bytes, key: Bytes, read: EmbedRead }

derive bin for EmbedFile

pub fn embed_read_bin() -> bin::BinCodec<EmbedRead> =
  bin::result_bin(bin::list_bin(embed_file_bin()), bin::bytes_bin())

derive bin for EmbedAt

pub fn embed_tables(embeds: List<EmbedAt>) -> Map<Bytes, Map<Bytes, EmbedRead>> =
  fold(embeds, map_new(), |acc: Map<Bytes, Map<Bytes, EmbedRead>>, embed: EmbedAt| {
    let was = match map_get(acc, embed.module) { Some(t) -> t, None -> map_new() };
    map_insert(acc, embed.module, map_insert(was, embed.key, embed.read))
  })

/// The module named `name` with its embeds written out, over a program the front end already
/// answered for: a module it embedded nothing for has no call to write.
pub fn rewritten(
  tables: Map<Bytes, Map<Bytes, EmbedRead>>,
  name: Bytes,
  module: Module,
) -> { module: Module, diags: List<ParseDiag> } =
  match map_get(tables, name) {
    None -> { module: module, diags: [] },
    Some(t) -> embedded(module, t, []),
  }

type Call = { want: EmbedWant, span: Span, literal: Bool }

/// The names the module binds itself, which a bare call of `embed` then means instead.
fn own_names(module: Module) -> List<Bytes> = {
  let declared = fold(module.items, [], |acc: List<Bytes>, item: Item|
    match item { IFn(d) -> push(acc, d.name.name), _ -> acc });
  fold(module.imports, declared, |acc: List<Bytes>, decl: ImportDecl|
    match decl.kind {
      INames(names) -> fold(names, acc, |a: List<Bytes>, ident: Ident| push(a, ident.name)),
      _ -> acc,
    })
}

/// A bare `embed(...)` or `embed_dir(...)` the module does not bind itself.
fn call_of(own: List<Bytes>, expr: Expr) -> Option<Call> =
  match expr {
    EApp(a) -> match a.func {
      EVar(v) -> {
        let n = v.name.name.name;
        if v.name.module != None || (n != b"embed" && n != b"embed_dir") || contains(own, n) {
          None
        } else {
          let path = if len(a.args) == 1 && len(a.named) == 0 {
            match list_at(a.args, 0) {
              Some(arg) -> match arg {
                ELit(l) -> match l.lit { LStr(p) -> Some(p), _ -> None },
                _ -> None,
              },
              None -> None,
            }
          } else { None };
          Some({
            want: { path: match path { Some(p) -> p, None -> b"" }, dir: n == b"embed_dir" },
            span: a.span,
            literal: path != None,
          })
        }
      },
      _ -> None,
    },
    _ -> None,
  }

/// Every embed the module asks for with a literal path, each once.
pub fn wants_of(module: Module) -> List<EmbedWant> = {
  let own = own_names(module);
  let found = walk_module(module, { own: own, read: map_new(), diags: [], wants: [] }, false);
  found.state.wants
}

/// What `items` ask for, each once, as `wants_of` lists it of their module.
pub fn wants_in(items: List<ItemWants>) -> List<EmbedWant> =
  fold(
    items,
    { own: [], read: map_new(), diags: [], wants: [] },
    |state: EmbedState, item: ItemWants| fold(item.wants, state, noted),
  ).wants

/// An item that asks for an embed with a literal path, with what it asks for: by the name it
/// declares, or `None` for an item that declares none.
pub type ItemWants = { name: Option<Bytes>, wants: List<EmbedWant> }

derive bin for ItemWants

/// Each item of the module that asks for an embed with a literal path.
pub fn wants_by_item(module: Module) -> List<ItemWants> = {
  let own = own_names(module);
  fold(module.items, [], |acc: List<ItemWants>, item: Item| {
    let o = walk_item({ own: own, read: map_new(), diags: [], wants: [] }, item, false);
    if len(o.state.wants) == 0 { acc } else {
      push(acc, {
        name: match item {
          IFn(d) -> Some(d.name.name),
          ITest(d) -> Some(d.name),
          ILaw(d) -> Some(d.name),
          _ -> None,
        },
        wants: o.state.wants,
      })
    }
  })
}

/// The module with every embed written out as what was read for it; a path that is not a literal,
/// and one nothing could be read for, is a diagnostic.
pub fn embedded(
  module: Module,
  read: Map<Bytes, EmbedRead>,
  diags: List<ParseDiag>,
) -> { module: Module, diags: List<ParseDiag> } = {
  let walked = walk_module(
    module,
    { own: own_names(module), read: read, diags: diags, wants: [] },
    true,
  );
  { module: walked.module, diags: walked.state.diags }
}

type EmbedState = {
  own: List<Bytes>,
  read: Map<Bytes, EmbedRead>,
  diags: List<ParseDiag>,
  wants: List<EmbedWant>,
}

fn noted(state: EmbedState, w: EmbedWant) -> EmbedState =
  if fold(state.wants, false, |acc: Bool, x: EmbedWant|
      acc || (x.path == w.path && x.dir == w.dir)) { state }
  else { { ..state, wants: push(state.wants, w) } }

fn written(state: EmbedState, call: Call) -> { state: EmbedState, expr: Expr } =
  if !call.literal {
    {
      state: {
        ..state,
        diags: push(
          state.diags,
          error_at(
            b"E0147",
            call.span,
            b"an embed's path is a string literal",
            b"read when the program is loaded, so it cannot be computed",
            [],
          ),
        ),
      },
      expr: EBad({ span: call.span }),
    }
  } else {
    let unread = |why: Bytes|
      {
        state: {
          ..state,
          diags: push(
            state.diags,
            error_at(
              b"E0146",
              call.span,
              bytes_concat_all([b"`", call.want.path, b"` could not be embedded"]),
              why,
              [b"the path is read relative to the module's own file"],
            ),
          ),
        },
        expr: EBad({ span: call.span }),
      };
    match map_get(state.read, embed_key(call.want)) {
      None -> unread(b"nothing was read for it"),
      Some(Err(why)) -> unread(why),
      Some(Ok(files)) -> if !call.want.dir {
        match files {
          [file, ..] -> { state: state, expr: ELit({ span: call.span, lit: LBytes(file.bytes) }) },
          [] -> unread(b"nothing was read for it"),
        }
      } else {
        {
          state: state,
          expr: EList({
            span: call.span,
            items: map(files, |file: EmbedFile|
              ERecord({
                span: call.span,
                fields: [
                  {
                    name: { name: b"name", span: call.span },
                    value: ELit({ span: call.span, lit: LStr(file.name) }),
                  },
                  {
                    name: { name: b"bytes", span: call.span },
                    value: ELit({ span: call.span, lit: LBytes(file.bytes) }),
                  },
                ],
              })),
          }),
        }
      },
    }
  }

// --- The walk ---------------------------------------------------------------------------------
// Every expression a module holds, children first; `writing` rewrites the embeds it meets, and
// otherwise it only notes what they ask for.

type Out = { state: EmbedState, expr: Expr }

fn walk_module(
  module: Module,
  state: EmbedState,
  writing: Bool,
) -> { state: EmbedState, module: Module } = {
  let w = fold(
    module.items,
    { state: state, items: [] },
    |acc: { state: EmbedState, items: List<Item> }, item: Item| {
      let o = walk_item(acc.state, item, writing);
      { state: o.state, items: push(acc.items, o.item) }
    },
  );
  { state: w.state, module: { ..module, items: w.items } }
}

fn walk_item(state: EmbedState, item: Item, writing: Bool) -> { state: EmbedState, item: Item } =
  match item {
    IFn(d) -> {
      let b = walk(state, d.body, writing);
      let s = fold(
        d.spec,
        { state: b.state, xs: [] },
        |acc: { state: EmbedState, xs: List<SpecClause> }, clause: SpecClause| {
          let o = walk(acc.state, clause.expr, writing);
          { state: o.state, xs: push(acc.xs, { ..clause, expr: o.expr }) }
        },
      );
      let p = walk_params(s.state, d.params, writing);
      { state: p.state, item: IFn({ ..d, body: b.expr, spec: s.xs, params: p.xs }) }
    },
    ITest(d) -> {
      let b = walk(state, d.body, writing);
      match d.cases {
        None -> { state: b.state, item: ITest({ ..d, body: b.expr }) },
        Some(c) -> {
          let table = walk(b.state, c.table, writing);
          let label = walk(table.state, c.label, writing);
          {
            state: label.state,
            item: ITest({
              ..d,
              body: b.expr,
              cases: Some({ ..c, table: table.expr, label: label.expr }),
            }),
          }
        },
      }
    },
    ILaw(d) -> {
      let b = walk(state, d.body, writing);
      match d.guard {
        None -> { state: b.state, item: ILaw({ ..d, body: b.expr }) },
        Some(g) -> {
          let o = walk(b.state, g, writing);
          { state: o.state, item: ILaw({ ..d, body: b.expr, guard: Some(o.expr) }) }
        },
      }
    },
    // Its embeds are written out in the definitions made of it, so here they are only noted.
    ISchema(d) -> if writing { { state: state, item: item } } else {
      let b = walk(state, d.body, writing);
      match d.guard {
        None -> { state: b.state, item: item },
        Some(g) -> { state: walk(b.state, g, writing).state, item: item },
      }
    },
    other -> { state: state, item: other },
  }

fn walk_params(
  state: EmbedState,
  params: List<Param>,
  writing: Bool,
) -> { state: EmbedState, xs: List<Param> } =
  fold(
    params,
    { state: state, xs: [] },
    |acc: { state: EmbedState, xs: List<Param> }, param: Param|
      match param.default {
        None -> { state: acc.state, xs: push(acc.xs, param) },
        Some(v) -> {
          let o = walk(acc.state, v, writing);
          { state: o.state, xs: push(acc.xs, { ..param, default: Some(o.expr) }) }
        },
      },
  )

fn walk_all(
  state: EmbedState,
  exprs: List<Expr>,
  writing: Bool,
) -> { state: EmbedState, xs: List<Expr> } =
  fold(exprs, { state: state, xs: [] }, |acc: { state: EmbedState, xs: List<Expr> }, expr: Expr| {
    let o = walk(acc.state, expr, writing);
    { state: o.state, xs: push(acc.xs, o.expr) }
  })

fn walk_opt(
  state: EmbedState,
  expr: Option<Expr>,
  writing: Bool,
) -> { state: EmbedState, x: Option<Expr> } =
  match expr {
    None -> { state: state, x: None },
    Some(v) -> {
      let o = walk(state, v, writing);
      { state: o.state, x: Some(o.expr) }
    },
  }

fn walk_fields(
  state: EmbedState,
  fields: List<RecField>,
  writing: Bool,
) -> { state: EmbedState, xs: List<RecField> } =
  fold(
    fields,
    { state: state, xs: [] },
    |acc: { state: EmbedState, xs: List<RecField> }, field: RecField| {
      let o = walk(acc.state, field.value, writing);
      { state: o.state, xs: push(acc.xs, { ..field, value: o.expr }) }
    },
  )

fn walk(state: EmbedState, expr: Expr, writing: Bool) -> Out =
  match call_of(state.own, expr) {
    Some(c) -> if writing { written(state, c) }
    else { { state: if c.literal { noted(state, c.want) } else { state }, expr: expr } },
    None -> walk_children(state, expr, writing),
  }

fn walk_children(state: EmbedState, expr: Expr, writing: Bool) -> Out =
  match expr {
    EBinary(b) -> {
      let l = walk(state, b.lhs, writing);
      let r = walk(l.state, b.rhs, writing);
      { state: r.state, expr: EBinary({ ..b, lhs: l.expr, rhs: r.expr }) }
    },
    EUnary(u) -> {
      let o = walk(state, u.operand, writing);
      { state: o.state, expr: EUnary({ ..u, operand: o.expr }) }
    },
    ELambda(l) -> {
      let b = walk(state, l.body, writing);
      let p = walk_params(b.state, l.params, writing);
      { state: p.state, expr: ELambda({ ..l, body: b.expr, params: p.xs }) }
    },
    EApp(a) -> {
      let f = walk(state, a.func, writing);
      let xs = walk_all(f.state, a.args, writing);
      let n = fold(
        a.named,
        { state: xs.state, xs: [] },
        |acc: { state: EmbedState, xs: List<NamedArg> }, x: NamedArg| {
          let o = walk(acc.state, x.value, writing);
          { state: o.state, xs: push(acc.xs, { ..x, value: o.expr }) }
        },
      );
      { state: n.state, expr: EApp({ ..a, func: f.expr, args: xs.xs, named: n.xs }) }
    },
    EIf(i) -> {
      let c = walk(state, i.cond, writing);
      let t = walk(c.state, i.then_branch, writing);
      let x = walk(t.state, i.else_branch, writing);
      { state: x.state, expr: EIf({ ..i, cond: c.expr, then_branch: t.expr, else_branch: x.expr }) }
    },
    EMatch(m) -> {
      let s = walk(state, m.scrutinee, writing);
      let arms = fold(
        m.arms,
        { state: s.state, xs: [] },
        |acc: { state: EmbedState, xs: List<MatchArm> }, arm: MatchArm| {
          let g = walk_opt(acc.state, arm.guard, writing);
          let b = walk(g.state, arm.body, writing);
          { state: b.state, xs: push(acc.xs, { ..arm, guard: g.x, body: b.expr }) }
        },
      );
      { state: arms.state, expr: EMatch({ ..m, scrutinee: s.expr, arms: arms.xs }) }
    },
    EBlock(b) -> {
      let stmts = fold(
        b.stmts,
        { state: state, xs: [] },
        |acc: { state: EmbedState, xs: List<Stmt> }, s: Stmt|
          match s {
            SLet(l) -> {
              let o = walk(acc.state, l.value, writing);
              { state: o.state, xs: push(acc.xs, SLet({ ..l, value: o.expr })) }
            },
            SLetElse(l) -> {
              let v = walk(acc.state, l.value, writing);
              let f = walk(v.state, l.fallback, writing);
              {
                state: f.state,
                xs: push(acc.xs, SLetElse({ ..l, value: v.expr, fallback: f.expr })),
              }
            },
            SExpr(x) -> {
              let o = walk(acc.state, x, writing);
              { state: o.state, xs: push(acc.xs, SExpr(o.expr)) }
            },
          },
      );
      let t = walk_opt(stmts.state, b.tail, writing);
      { state: t.state, expr: EBlock({ ..b, stmts: stmts.xs, tail: t.x }) }
    },
    ERecord(r) -> {
      let f = walk_fields(state, r.fields, writing);
      { state: f.state, expr: ERecord({ ..r, fields: f.xs }) }
    },
    ERecordUpdate(r) -> {
      let b = walk(state, r.base, writing);
      let f = walk_fields(b.state, r.fields, writing);
      { state: f.state, expr: ERecordUpdate({ ..r, base: b.expr, fields: f.xs }) }
    },
    ETry(t) -> {
      let o = walk(state, t.operand, writing);
      { state: o.state, expr: ETry({ ..t, operand: o.expr }) }
    },
    EField(f) -> {
      let o = walk(state, f.base, writing);
      { state: o.state, expr: EField({ ..f, base: o.expr }) }
    },
    EList(l) -> {
      let xs = walk_all(state, l.items, writing);
      { state: xs.state, expr: EList({ ..l, items: xs.xs }) }
    },
    EPerform(p) -> {
      let xs = walk_all(state, p.args, writing);
      { state: xs.state, expr: EPerform({ ..p, args: xs.xs }) }
    },
    EHandle(h) -> {
      let b = walk(state, h.body, writing);
      let cs = fold(
        h.clauses,
        { state: b.state, xs: [] },
        |acc: { state: EmbedState, xs: List<HandleClause> }, c: HandleClause| {
          let o = walk(acc.state, c.body, writing);
          { state: o.state, xs: push(acc.xs, { ..c, body: o.expr }) }
        },
      );
      match h.ret {
        None -> { state: cs.state, expr: EHandle({ ..h, body: b.expr, clauses: cs.xs }) },
        Some(rc) -> {
          let o = walk(cs.state, rc.body, writing);
          {
            state: o.state,
            expr: EHandle({ ..h, body: b.expr, clauses: cs.xs, ret: Some({ ..rc, body: o.expr }) }),
          }
        },
      }
    },
    EWithCell(c) -> {
      let i = walk(state, c.init, writing);
      let b = walk(i.state, c.body, writing);
      { state: b.state, expr: EWithCell({ ..c, init: i.expr, body: b.expr }) }
    },
    EWithHold(c) -> {
      let a = walk(state, c.acquire, writing);
      let r = walk(a.state, c.release, writing);
      let b = walk(r.state, c.body, writing);
      { state: b.state, expr: EWithHold({ ..c, acquire: a.expr, release: r.expr, body: b.expr }) }
    },
    ESimulate(s) -> {
      let o = walk(state, s.body, writing);
      { state: o.state, expr: ESimulate({ ..s, body: o.expr }) }
    },
    EParallel(p) -> {
      let xs = walk_all(state, p.branches, writing);
      { state: xs.state, expr: EParallel({ ..p, branches: xs.xs }) }
    },
    ETryBlock(t) -> {
      let o = walk(state, t.body, writing);
      { state: o.state, expr: ETryBlock({ ..t, body: o.expr }) }
    },
    ETagged(t) -> {
      let filled = fold(
        t.holes,
        { state: state, holes: [] },
        |acc: { state: EmbedState, holes: List<Hole> }, h: Hole| {
          let o = walk(acc.state, h.value, writing);
          { state: o.state, holes: push(acc.holes, { ..h, value: o.expr }) }
        },
      );
      { state: filled.state, expr: ETagged({ ..t, holes: filled.holes }) }
    },
    other -> { state: state, expr: other },
  }
