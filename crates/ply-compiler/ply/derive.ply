// `derive D for T` becomes an ordinary definition: generated as source, parsed back, and retargeted.

import spine (Span, Ident, QName, span_to, num)
import lexer (byte_of)
import types (TypeExpr, TVar, TCon, TFn, TRecord, TUnit, TBad, RowExpr, AtomExpr, Mode, MRead,
              MWrite, MBad, ty_span)
import patterns (Pattern, PWild, PVar, PLit, PCtor, PRecord, PList, POr, PBad)
import exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock, ERecord,
              ERecordUpdate, ETry, EField, EList, EPerform, EHandle, EWithCell, ESimulate,
              EParallel, EBad, Stmt, SLet, SLetElse, SExpr, Param, NamedArg, MatchArm, HandleClause,
              ReturnClause, RecField, shown_binder)
import items (Module, Item, IFn, IType, IDerive, FnDef, TypeDef, TypeDefBody, TDAlias, TDSum,
              VariantDef, DeriveDef, Deriver, DJson, DEq, DOrd, DBin, DShow, DHash, DNumeric,
              DInteger, deriver_text, deriver_tag, ImportDecl, ImportKind, IModule, IAlias, INames,
              Vis, VPub, VPriv, Derived, Constraint, SpecClause, parse, constraint_written)
import rewrite (expand)
import resolve (Diag, Source, diag1, diag2, is_bare, dump_diags)

// --- Rules ---------------------------------------------------------------------------------------

pub type Why = | WFunction | WHandle | WFloat | WUnconstrained(Int) | WNullInsideOption | WSecret
pub type ConShape = | Leaf | Structural | Refused(Why) | Nominal

// The one table the deriver and the checker's `derivable` both read, so the two cannot disagree.
pub fn con_shape(d: Deriver, name: Bytes) -> ConShape =
  if name == b"Int" || name == b"Bool" || name == b"String" || name == b"Bytes" || name == b"Unit"
      || name == b"Decimal"
      || name == b"Char" { Leaf } else if name == b"Float" {
    match d { DOrd -> Refused(WFloat), DHash -> Refused(WFloat), _ -> Leaf }
  } else if name == b"List" || name == b"Array" || name == b"Option" || name == b"Map"
      || name == b"Result"
      || name == b"Ordering"
      || name == b"Rounding"
      || name == b"Instant"
      || name == b"Duration" { Structural }
  else if same_deriver(d, DBin) && is_fixed_width(name) { Leaf }
  else if same_deriver(d, DBin) && name == b"Iter" { Structural }
  else if name == b"Cell" || name == b"Task" || name == b"Chan" { Refused(WHandle) }
  else if name == b"Secret" { match d { DEq -> Leaf, _ -> Refused(WSecret) } }
  else { Nominal }

// Whether a type constructor's JSON encoding can be the document `null`.
pub fn null_encoded_name(name: Bytes) -> Bool = name == b"Unit" || name == b"Option"

fn is_fixed_width(name: Bytes) -> Bool =
  name == b"U8" || name == b"U16" || name == b"U32" || name == b"U64" || name == b"U128"
    || name == b"I8"
    || name == b"I16"
    || name == b"I32"
    || name == b"I64"
    || name == b"I128"

pub fn same_deriver(a: Deriver, b: Deriver) -> Bool = deriver_tag(a) == deriver_tag(b)

// The module whose definitions a generated body calls, if any.
fn runtime_module(d: Deriver) -> Option<Bytes> =
  match d {
    DJson -> Some(b"std.json"),
    DBin -> Some(b"std.bin"),
    DShow -> Some(b"std.show"),
    _ -> None,
  }

fn runtime_path(d: Deriver) -> List<Bytes> =
  match d {
    DJson -> [b"std", b"json"],
    DBin -> [b"std", b"bin"],
    DShow -> [b"std", b"show"],
    _ -> [],
  }

fn is_upper_b(c: Int) -> Bool = c >= 65 && c <= 90
fn is_lower_b(c: Int) -> Bool = c >= 97 && c <= 122
fn is_digit_b(c: Int) -> Bool = c >= 48 && c <= 57
fn lower_byte(c: Int) -> Int = if is_upper_b(c) { c + 32 } else { c }

// `_` before an uppercase after a lowercase or digit, and before the last of an uppercase run a lowercase follows.
pub fn snake_case(name: Bytes) -> Bytes = {
  let n = bytes_len(name);
  fold(range(0, n), b"", |out: Bytes, i: Int| {
    let c = bytes_at(name, i);
    let sep = if i > 0 && is_upper_b(c) {
      let prev = bytes_at(name, i - 1);
      let next_lower = i + 1 < n && is_lower_b(bytes_at(name, i + 1));
      is_lower_b(prev) || is_digit_b(prev) || (is_upper_b(prev) && next_lower)
    } else { false };
    bytes_concat_all([out, if sep { b"_" } else { b"" }, byte_of(lower_byte(c))])
  })
}

pub fn generated_name(d: Deriver, type_name: Bytes) -> Bytes =
  bytes_concat_all([snake_case(type_name), b"_", deriver_text(d)])

fn at<a>(xs: List<a>, i: Int) -> a =
  match list_at(xs, i) { Some(x) -> x, None -> panic("an index the deriver does not hold") }

fn append<a>(a: List<a>, b: List<a>) -> List<a> = fold(b, a, |acc: List<a>, x: a| push(acc, x))

fn join(xs: List<Bytes>, sep: Bytes) -> Bytes =
  fold(range(0, len(xs)), b"", |acc: Bytes, i: Int|
    if i == 0 { at(xs, i) } else { bytes_concat_all([acc, sep, at(xs, i)]) })

fn has(xs: List<Bytes>, x: Bytes) -> Bool = fold(xs, false, |found: Bool, y: Bytes| found || y == x)

// --- The syntactic half of `derivable(D, t)` ---------------------------------------------------

// `reason` completes the label at `span`; `note` is the advice only a `Secret` refusal carries.
type Blocker = { span: Span, reason: Bytes, note: Option<Bytes>, variant: Option<Bytes> }

fn check_decl(d: Deriver, def: TypeDef) -> Option<Blocker> =
  match def.body {
    TDAlias(body) -> check_te(d, body),
    TDSum(variants) ->
      fold(variants, None, |acc: Option<Blocker>, v: VariantDef|
        match acc {
          Some(_) -> acc,
          None -> match first_blocked_te(d, v.fields) {
            Some(b) ->
              Some({ span: b.span, reason: b.reason, note: b.note, variant: Some(v.name.name) }),
            None -> None,
          },
        }),
  }

fn function_refusal(d: Deriver) -> Bytes =
  match d {
    DJson -> b"a function has no JSON encoding",
    DEq -> b"functions cannot be compared for equality",
    DOrd -> b"functions cannot be ordered",
    DBin -> b"a function has no binary encoding",
    DShow -> b"a function has no rendering to derive",
    DHash -> b"a function has no content to hash",
    DNumeric -> b"a function is not a number",
    DInteger -> b"a function is not an integer",
  }

pub fn refusal_reason(w: Why, d: Deriver, simple: Bytes) -> Bytes =
  match w {
    WFloat -> float_reason(d),
    WHandle -> bytes_concat_all([b"a `", simple, b"` names a location rather than a value"]),
    WSecret -> secret_reason(d),
    _ -> b"",
  }

pub fn float_reason(d: Deriver) -> Bytes =
  match d {
    DHash ->
      b"`Float` has no hash that agrees with `==`: `NaN != NaN`, and `0.0 == -0.0` in different bits",
    _ -> b"`Float` is not ordered: `NaN != NaN`",
  }

pub fn secret_reason(d: Deriver) -> Bytes =
  match d {
    DJson -> b"a derived codec would write the credential into the document",
    DOrd -> b"a credential has no order",
    DEq -> b"a credential has no structural equality to derive",
    DBin -> b"a derived codec would write the credential into the bytes",
    DShow -> b"a derived rendering would write the credential out",
    DHash -> b"a hash of a credential is something to test guesses against",
    DNumeric -> b"a credential is not a number",
    DInteger -> b"a credential is not an integer",
  }

pub fn refusal_note(w: Why, d: Deriver) -> Option<Bytes> =
  match w {
    WSecret -> match d {
      DOrd ->
        Some(
          b"an ordering over a credential leaks a bit of position per comparison and recovers the value in calls proportional to its length; `derive eq` is available, and `secret_verify` is the check a program actually wants",
        ),
      DShow ->
        Some(
          b"a credential is never shown, in an interpolated string or anywhere else; show what the `Secret` guards or names instead",
        ),
      DHash ->
        Some(
          b"hash what the `Secret` guards or names instead; a password wants `std.password`, not a content hash",
        ),
      _ ->
        Some(
          b"move the `Secret` field out of the type being derived, or write the codec by hand over the fields that are not credentials \xe2\x80\x94 there is no way to encode a `Secret`, which is the guarantee",
        ),
    },
    _ -> None,
  }

pub fn null_in_option_note() -> Bytes =
  b"wrap the inner value in a record or a one-field variant \xe2\x80\x94 both are tagged, and a tagged encoding has no `null` to collide with"

pub fn null_in_option(inner: Bytes) -> Bytes =
  bytes_concat_all([
    b"`",
    inner,
    b"` encodes as `null`, which is how an `Option` writes `None`, so `Some` and `None` are the same document",
  ])

fn first_blocked_te(d: Deriver, ts: List<TypeExpr>) -> Option<Blocker> =
  fold(ts, None, |acc: Option<Blocker>, t: TypeExpr|
    match acc { Some(_) -> acc, None -> check_te(d, t) })

fn null_encoded_te(te: TypeExpr) -> Bool =
  match te { TUnit(_) -> true, TCon(c) -> null_encoded_name(c.name.name.name), _ -> false }

// A type parameter is derivable by assumption; a record field is blamed as a whole.
fn check_te(d: Deriver, te: TypeExpr) -> Option<Blocker> =
  match te {
    TVar(_) -> None,
    TUnit(_) -> None,
    TBad(_) -> None,
    TFn(f) -> Some({ span: f.span, reason: function_refusal(d), note: None, variant: None }),
    TRecord(r) ->
      fold(r.fields, None, |acc: Option<Blocker>, f: { name: Ident, ty: TypeExpr }|
        match acc {
          Some(_) -> acc,
          None -> match check_te(d, f.ty) {
            Some(b) ->
              Some({
                span: span_to(f.name.span, ty_span(f.ty)),
                reason: b.reason,
                note: b.note,
                variant: b.variant,
              }),
            None -> None,
          },
        }),
    TCon(c) -> {
      let simple = c.name.name.name;
      match con_shape(d, simple) {
        Refused(why) ->
          Some({
            span: c.span,
            reason: bytes_concat_all([
              refusal_reason(why, d, simple),
              b", so `",
              simple,
              b"` has no derivation",
            ]),
            note: refusal_note(why, d),
            variant: None,
          }),
        _ -> if same_deriver(d, DJson) && simple == b"Option" && len(c.args) > 0
            && null_encoded_te(at(c.args, 0)) {
          let inner = match at(c.args, 0) { TCon(k) -> k.name.name.name, _ -> b"Unit" };
          Some({ span: c.span, reason: null_in_option(inner), note: None, variant: None })
        } else {
          // A `Map`'s key type must be ordered whichever deriver is walking.
          let key = if simple == b"Map" && len(c.args) > 0 {
            match check_te(DOrd, at(c.args, 0)) {
              Some(b) ->
                Some({
                  span: b.span,
                  reason: bytes_concat(b.reason, b", and a `Map` key type must be ordered"),
                  note: b.note,
                  variant: b.variant,
                }),
              None -> None,
            }
          } else { None };
          match key { Some(b) -> Some(b), None -> first_blocked_te(d, c.args) }
        },
      }
    },
  }

// --- Generated definitions, as Ply source -------------------------------------------------------

type Alias = { name: Bytes, body: TypeExpr }

// `b` prefixes every generated binder, chosen so none can shadow a dictionary parameter; `path` is the
// module's; `cycle` holds the types whose codecs call the target's and are called back by it.
type Emitter = {
  d: Deriver,
  rt: Bytes,
  b: Bytes,
  aliases: List<Alias>,
  path: Bytes,
  cycle: List<Bytes>,
}

fn emitter(
  d: Deriver,
  rt: Bytes,
  params: List<Ident>,
  aliases: List<Alias>,
  path: Bytes,
  cycle: List<Bytes>,
) -> Emitter = {
  let b = iterate(b"d", len(params) + 2, |x: Bytes|
    if fold(params, false, |acc: Bool, p: Ident| acc || bytes_starts_with(p.name, x)) {
      Continue(bytes_concat(x, b"_"))
    } else { Stop(x) });
  { d: d, rt: rt, b: b, aliases: aliases, path: path, cycle: cycle }
}

fn find_alias(aliases: List<Alias>, name: Bytes) -> Option<TypeExpr> =
  fold(aliases, None, |acc: Option<TypeExpr>, a: Alias|
    match acc { Some(_) -> acc, None -> if a.name == name { Some(a.body) } else { None } })

pub fn target_type(def: TypeDef) -> Bytes =
  if len(def.params) == 0 { def.name.name } else {
    bytes_concat_all([def.name.name, b"<", join(map(def.params, |p: Ident| p.name), b", "), b">"])
  }

// A codec on a cycle is two definitions: the named one starts `_at` at the runtime's `max_depth`, and
// `_at` hands its cycle one less, so its recursion is seen to end.
fn emit_item(e: Emitter, def: TypeDef) -> Bytes = {
  let name = generated_name(e.d, def.name.name);
  let target = target_type(def);
  let ps = map(def.params, |p: Ident| p.name);
  let generics = if len(ps) == 0 { b"" } else { bytes_concat_all([b"<", join(ps, b", "), b">"]) };
  let dicts = map(ps, |p: Bytes| bytes_concat_all([p, b": ", dict_type(e, p)]));
  let constraints = if len(ps) == 0 { b"" }
  else { bytes_concat(b" where ", join(map(ps, |p: Bytes| constraint_written(e.d, p)), b", ")) };
  let head = |fname: Bytes, params: List<Bytes>|
    bytes_concat_all([
      b"fn ",
      fname,
      generics,
      b"(",
      join(params, b", "),
      b") -> ",
      dict_type(e, target),
      constraints,
      b" = ",
    ]);
  let vis = match def.vis { VPub -> b"pub ", VPriv -> b"" };
  if len(e.cycle) == 0 { bytes_concat_all([vis, head(name, dicts), dictionary(e, def, target)]) }
  else {
    let at_name = bytes_concat(name, b"_at");
    bytes_concat_all([
      vis,
      head(name, dicts),
      at_name,
      b"(",
      join(push(ps, bytes_concat(e.rt, b"max_depth()")), b", "),
      b")\n",
      head(at_name, push(dicts, bytes_concat(e.b, b"depth: Int"))),
      b"if ",
      e.b,
      b"depth <= 0 {",
      e.rt,
      b"too_deep()} else {",
      dictionary(e, def, target),
      b"}",
    ])
  }
}

// `JsonCodec<a>` and `BinCodec<a>` ship with their runtime modules; `EqDict` and `OrdDict` are structural.
fn dict_type(e: Emitter, arg: Bytes) -> Bytes =
  match e.d {
    DJson -> bytes_concat_all([e.rt, b"JsonCodec<", arg, b">"]),
    DBin -> bytes_concat_all([e.rt, b"BinCodec<", arg, b">"]),
    DShow -> bytes_concat_all([b"{show: (", arg, b") -> String}"]),
    DHash -> bytes_concat_all([b"{hash: (", arg, b") -> Bytes}"]),
    DEq -> bytes_concat_all([b"{eq: (", arg, b", ", arg, b") -> Bool}"]),
    DOrd -> bytes_concat_all([b"{compare: (", arg, b", ", arg, b") -> Ordering}"]),
    // A predicate is never derived: the parser has no `derive` that names one.
    _ -> b"()",
  }

fn dictionary(e: Emitter, def: TypeDef, target: Bytes) -> Bytes =
  match e.d {
    DEq ->
      bytes_concat_all([
        b"{eq: |",
        e.b,
        b"a: ",
        target,
        b", ",
        e.b,
        b"b: ",
        target,
        b"| ",
        e.b,
        b"a == ",
        e.b,
        b"b}",
      ]),
    DOrd ->
      bytes_concat_all([
        b"{compare: |",
        e.b,
        b"a: ",
        target,
        b", ",
        e.b,
        b"b: ",
        target,
        b"| compare_values(",
        e.b,
        b"a, ",
        e.b,
        b"b)}",
      ]),
    DShow ->
      bytes_concat_all([b"{show: |", e.b, b"a: ", target, b"| ", e.rt, b"show(", e.b, b"a)}"]),
    DHash -> bytes_concat_all([b"{hash: |", e.b, b"a: ", target, b"| digest(", e.b, b"a)}"]),
    DJson -> match def.body {
      TDAlias(body) -> codec(e, body, target),
      TDSum(variants) -> json_sum(e, variants, target),
    },
    DBin -> match def.body {
      TDAlias(body) -> codec(e, body, target),
      TDSum(variants) -> bin_sum(e, def, variants, target),
    },
    _ -> b"()",
  }

// An expression of the codec type of `te`: `JsonCodec<te>` or `BinCodec<te>`.
fn codec(e: Emitter, te: TypeExpr, annotation: Bytes) -> Bytes =
  match te {
    TVar(p) -> p.name,
    TUnit(_) -> bytes_concat_all([e.rt, b"unit_", deriver_text(e.d), b"()"]),
    TBad(_) -> b"()",
    TFn(_) -> b"()",
    TRecord(r) -> match e.d {
      DBin -> bin_record(e, r.fields, annotation),
      _ -> json_record(e, r.fields, annotation),
    },
    TCon(c) -> {
      let simple = c.name.name.name;
      let codecs = map(c.args, |a: TypeExpr| codec(e, a, render_type(a)));
      // A JSON object's keys are strings, so a `Map<String, v>` has an object form.
      if same_deriver(e.d, DJson) && simple == b"Map" && len(c.args) == 2
          && is_string(e, at(c.args, 0)) {
        bytes_concat_all([e.rt, b"string_map_json(", at(codecs, 1), b")"])
      } else {
        let call = bytes_concat_all([
          snake_case(simple),
          b"_",
          deriver_text(e.d),
          b"(",
          join(codecs, b", "),
          b")",
        ]);
        // A named type is composed through by name, never inlined.
        match con_shape(e.d, simple) {
          Nominal -> match c.name.module {
            Some(m) -> bytes_concat_all([m.name, b"::", call]),
            None -> if has(e.cycle, simple) {
              bytes_concat_all([
                snake_case(simple),
                b"_",
                deriver_text(e.d),
                b"_at(",
                join(push(codecs, bytes_concat(e.b, b"depth - 1")), b", "),
                b")",
              ])
            } else { call },
          },
          _ -> bytes_concat(e.rt, call),
        }
      }
    },
  }

// Whether a written type *is* `String`, following the module's own parameterless aliases.
fn is_string(e: Emitter, te: TypeExpr) -> Bool =
  iterate({ cur: te, n: 0 }, 66, |s: { cur: TypeExpr, n: Int }|
    if s.n >= 64 { Stop(false) } else {
      match s.cur {
        TCon(c) -> if !is_bare(c.name) || len(c.args) > 0 { Stop(false) }
        else if c.name.name.name == b"String" { Stop(true) } else {
          match find_alias(e.aliases, c.name.name.name) {
            Some(body) -> Continue({ cur: body, n: s.n + 1 }),
            None -> Stop(false),
          }
        },
        _ -> Stop(false),
      }
    })

fn json_record(
  e: Emitter,
  fields: List<{ name: Ident, ty: TypeExpr }>,
  annotation: Bytes,
) -> Bytes = {
  let entries = map(fields, |f: { name: Ident, ty: TypeExpr }|
    bytes_concat_all([
      b"{key: \"",
      f.name.name,
      b"\", value: (",
      codec(e, f.ty, render_type(f.ty)),
      b".encode)(",
      e.b,
      b"v.",
      f.name.name,
      b")}",
    ]));
  let encode = bytes_concat_all([
    b"|",
    e.b,
    b"v: ",
    annotation,
    b"| ",
    e.rt,
    b"object([",
    join(entries, b", "),
    b"])",
  ]);
  let built = map(range(0, len(fields)), |i: Int|
    bytes_concat_all([at(fields, i).name.name, b": ", e.b, num(i)]));
  let decode = fold(
    range(0, len(fields)),
    bytes_concat_all([b"Ok({", join(built, b", "), b"})"]),
    |acc: Bytes, k: Int| {
      let i = len(fields) - 1 - k;
      let f = at(fields, i);
      bytes_concat_all([
        b"match ",
        e.rt,
        b"field(",
        e.b,
        b"j, \"",
        f.name.name,
        b"\", ",
        codec(e, f.ty, render_type(f.ty)),
        b") {Err(",
        e.b,
        b"e) -> Err(",
        e.b,
        b"e), Ok(",
        e.b,
        num(i),
        b") -> ",
        acc,
        b"}",
      ])
    },
  );
  bytes_concat_all([
    b"{encode: ",
    encode,
    b", decode: |",
    e.b,
    b"j: ",
    e.rt,
    b"Json| ",
    decode,
    b"}",
  ])
}

// A variant is encoded by its declared name and its fields in order.
fn json_sum(e: Emitter, variants: List<VariantDef>, target: Bytes) -> Bytes = {
  let arms = map(variants, |v: VariantDef| {
    let binders = map(range(0, len(v.fields)), |i: Int| bytes_concat(e.b, num(i)));
    let pat = if len(binders) == 0 { v.name.name }
    else { bytes_concat_all([v.name.name, b"(", join(binders, b", "), b")"]) };
    let values = map(range(0, len(v.fields)), |i: Int|
      bytes_concat_all([
        b"(",
        codec(e, at(v.fields, i), render_type(at(v.fields, i))),
        b".encode)(",
        e.b,
        num(i),
        b")",
      ]));
    bytes_concat_all([
      pat,
      b" -> ",
      e.rt,
      b"variant(\"",
      v.name.name,
      b"\", [",
      join(values, b", "),
      b"])",
    ])
  });
  let encode = bytes_concat_all([
    b"|",
    e.b,
    b"v: ",
    target,
    b"| match ",
    e.b,
    b"v {",
    join(arms, b", "),
    b"}",
  ]);
  let names = map(variants, |v: VariantDef| bytes_concat_all([b"\"", v.name.name, b"\""]));
  let chain = fold(
    range(0, len(variants)),
    bytes_concat_all([e.rt, b"unknown_variant(", e.b, b"t.tag, [", join(names, b", "), b"])"]),
    |acc: Bytes, k: Int| {
      let v = at(variants, len(variants) - 1 - k);
      let ctor_args = if len(v.fields) == 0 { b"" } else {
        bytes_concat_all([
          b"(",
          join(map(range(0, len(v.fields)), |i: Int| bytes_concat(e.b, num(i))), b", "),
          b")",
        ])
      };
      let built = fold(
        range(0, len(v.fields)),
        bytes_concat_all([b"Ok(", v.name.name, ctor_args, b")"]),
        |inner: Bytes, kk: Int| {
          let i = len(v.fields) - 1 - kk;
          bytes_concat_all([
            b"match ",
            e.rt,
            b"decode_and_then(",
            e.rt,
            b"variant_value(",
            e.b,
            b"t, ",
            num(i),
            b"), ",
            codec(e, at(v.fields, i), render_type(at(v.fields, i))),
            b".decode) {Err(",
            e.b,
            b"e) -> Err(",
            e.b,
            b"e), Ok(",
            e.b,
            num(i),
            b") -> ",
            inner,
            b"}",
          ])
        },
      );
      // A call, not `==`: the emitter keys an operator's settled type by span, and every
      // operator here is on the `derive` item's one span, beside the `Int` ones of a depth.
      bytes_concat_all([
        b"if ",
        e.rt,
        b"has_tag(",
        e.b,
        b"t, \"",
        v.name.name,
        b"\") {",
        built,
        b"} else {",
        acc,
        b"}",
      ])
    },
  );
  let decode = bytes_concat_all([
    b"|",
    e.b,
    b"j: ",
    e.rt,
    b"Json| match ",
    e.rt,
    b"variant_of(",
    e.b,
    b"j) {Err(",
    e.b,
    b"e) -> Err(",
    e.b,
    b"e), Ok(",
    e.b,
    b"t) -> ",
    chain,
    b"}",
  ]);
  bytes_concat_all([b"{encode: ", encode, b", decode: ", decode, b"}"])
}

// A scalar is written and read by `std.bin`'s own functions rather than through a codec.
fn bin_scalar(te: TypeExpr) -> Option<Bytes> =
  match te {
    TUnit(_) -> Some(b"unit"),
    TCon(c) -> match con_shape(DBin, c.name.name.name) {
      Leaf -> Some(snake_case(c.name.name.name)),
      _ -> None,
    },
    _ -> None,
  }

fn bin_put(e: Emitter, te: TypeExpr, w: Bytes, x: Bytes) -> Bytes =
  match bin_scalar(te) {
    Some(s) -> bytes_concat_all([e.rt, b"put_", s, b"(", w, b", ", x, b")"]),
    None -> bytes_concat_all([b"(", codec(e, te, render_type(te)), b".put)(", w, b", ", x, b")"]),
  }

fn bin_take(e: Emitter, te: TypeExpr, from: Bytes) -> Bytes =
  match bin_scalar(te) {
    Some(s) -> bytes_concat_all([e.rt, b"take_", s, b"(", e.b, b"d, ", from, b")"]),
    None ->
      bytes_concat_all([b"(", codec(e, te, render_type(te)), b".take)(", e.b, b"d, ", from, b")"]),
  }

// Each of `tys` read where the last ended, the first at `start`, then `built` over their values.
fn bin_takes(e: Emitter, tys: List<TypeExpr>, start: Bytes, built: Bytes) -> Bytes = {
  let n = len(tys);
  let end_of = |i: Int| if i < 0 { start } else { bytes_concat_all([e.b, num(i), b".at"]) };
  fold(
    range(0, n),
    bytes_concat_all([b"Ok({value: ", built, b", at: ", end_of(n - 1), b"})"]),
    |acc: Bytes, k: Int| {
      let i = n - 1 - k;
      bytes_concat_all([
        b"match ",
        bin_take(e, at(tys, i), end_of(i - 1)),
        b" {Err(",
        e.b,
        b"e) -> Err(",
        e.b,
        b"e), Ok(",
        e.b,
        num(i),
        b") -> ",
        acc,
        b"}",
      ])
    },
  )
}

fn values_of(e: Emitter, n: Int) -> List<Bytes> =
  map(range(0, n), |i: Int| bytes_concat_all([e.b, num(i), b".value"]))

fn shapes_of(e: Emitter, tys: List<TypeExpr>) -> Bytes =
  join(map(tys, |t: TypeExpr| bytes_concat(codec(e, t, render_type(t)), b".shape")), b", ")

fn bin_record(e: Emitter, fields: List<{ name: Ident, ty: TypeExpr }>, annotation: Bytes) -> Bytes = {
  let put = fold(fields, bytes_concat(e.b, b"w"), |acc: Bytes, f: { name: Ident, ty: TypeExpr }|
    bin_put(e, f.ty, acc, bytes_concat_all([e.b, b"v.", f.name.name])));
  let values = values_of(e, len(fields));
  let built = map(range(0, len(fields)), |i: Int|
    bytes_concat_all([at(fields, i).name.name, b": ", at(values, i)]));
  let shapes = map(fields, |f: { name: Ident, ty: TypeExpr }|
    bytes_concat_all([
      b"{name: \"",
      f.name.name,
      b"\", shape: ",
      codec(e, f.ty, render_type(f.ty)),
      b".shape}",
    ]));
  bytes_concat_all([
    b"{put: |",
    e.b,
    b"w: Bytes, ",
    e.b,
    b"v: ",
    annotation,
    b"| ",
    put,
    b", take: |",
    e.b,
    b"d: Bytes, ",
    e.b,
    b"n: Int| ",
    bin_takes(
      e,
      map(fields, |f: { name: Ident, ty: TypeExpr }| f.ty),
      bytes_concat(e.b, b"n"),
      bytes_concat_all([b"{", join(built, b", "), b"}"]),
    ),
    b", shape: |",
    e.b,
    b"s: ",
    e.rt,
    b"Shapes| ",
    e.rt,
    b"record_shape(",
    e.b,
    b"s, [",
    join(shapes, b", "),
    b"])}",
  ])
}

// A variant is its index among the declared constructors, then its fields in order.
fn bin_sum(e: Emitter, def: TypeDef, variants: List<VariantDef>, target: Bytes) -> Bytes = {
  let count = len(variants);
  let arms = map(range(0, count), |vi: Int| {
    let v = at(variants, vi);
    let binders = map(range(0, len(v.fields)), |i: Int| bytes_concat(e.b, num(i)));
    let pat = if len(binders) == 0 { v.name.name }
    else { bytes_concat_all([v.name.name, b"(", join(binders, b", "), b")"]) };
    let tagged = bytes_concat_all([e.rt, b"put_tag(", e.b, b"w, ", num(vi), b")"]);
    let body = fold(range(0, len(v.fields)), tagged, |acc: Bytes, i: Int|
      bin_put(e, at(v.fields, i), acc, at(binders, i)));
    bytes_concat_all([pat, b" -> ", body])
  });
  let cases = map(range(0, count), |vi: Int| {
    let v = at(variants, vi);
    let args = if len(v.fields) == 0 { b"" }
    else { bytes_concat_all([b"(", join(values_of(e, len(v.fields)), b", "), b")"]) };
    bytes_concat_all([
      if vi == count - 1 { b"_" } else { num(vi) },
      b" -> ",
      bin_takes(e, v.fields, bytes_concat(e.b, b"t.at"), bytes_concat(v.name.name, args)),
    ])
  });
  let shapes = map(variants, |v: VariantDef|
    bytes_concat_all([b"{name: \"", v.name.name, b"\", fields: [", shapes_of(e, v.fields), b"]}"]));
  let params = join(map(def.params, |p: Ident| bytes_concat(p.name, b".shape")), b", ");
  bytes_concat_all([
    b"{put: |",
    e.b,
    b"w: Bytes, ",
    e.b,
    b"v: ",
    target,
    b"| match ",
    e.b,
    b"v {",
    join(arms, b", "),
    b"}, take: |",
    e.b,
    b"d: Bytes, ",
    e.b,
    b"n: Int| match ",
    e.rt,
    b"take_tag(",
    e.b,
    b"d, ",
    e.b,
    b"n, ",
    num(count),
    b") {Err(",
    e.b,
    b"e) -> Err(",
    e.b,
    b"e), Ok(",
    e.b,
    b"t) -> match ",
    e.b,
    b"t.value {",
    join(cases, b", "),
    b"}}, shape: |",
    e.b,
    b"s: ",
    e.rt,
    b"Shapes| ",
    e.rt,
    b"sum_shape(",
    e.b,
    b"s, \"",
    e.path,
    b".",
    def.name.name,
    b"\", \"",
    def.name.name,
    b"\", [",
    params,
    b"], [",
    join(shapes, b", "),
    b"])}",
  ])
}

fn qname_text(q: QName) -> Bytes =
  match q.module { Some(m) -> bytes_concat_all([m.name, b"::", q.name.name]), None -> q.name.name }

fn mode_text(m: Mode) -> Bytes = match m { MRead -> b"read", MWrite -> b"write", MBad -> b"" }

// A type back as source, for the annotations a generated lambda needs.
pub fn render_type(te: TypeExpr) -> Bytes =
  match te {
    TVar(i) -> i.name,
    TUnit(_) -> b"()",
    TBad(_) -> b"()",
    TCon(c) -> if len(c.args) == 0 { qname_text(c.name) } else {
      bytes_concat_all([qname_text(c.name), b"<", join(map(c.args, render_type), b", "), b">"])
    },
    TRecord(r) ->
      bytes_concat_all([
        b"{",
        join(
          map(r.fields, |f: { name: Ident, ty: TypeExpr }|
            bytes_concat_all([f.name.name, b": ", render_type(f.ty)])),
          b", ",
        ),
        b"}",
      ]),
    TFn(f) -> {
      let row = match f.effects { Some(r) -> bytes_concat(b" / ", render_row(r)), None -> b"" };
      bytes_concat_all([
        b"(",
        join(map(f.params, render_type), b", "),
        b") -> ",
        render_type(f.ret),
        row,
      ])
    },
  }

fn render_row(row: RowExpr) -> Bytes = {
  let atoms = join(map(row.atoms, render_atom), b", ");
  match row.tail {
    Some(t) -> bytes_concat_all([b"{", atoms, b" | ", t.name, b"}"]),
    None -> bytes_concat_all([b"{", atoms, b"}"]),
  }
}

fn render_atom(a: AtomExpr) -> Bytes = {
  let resource = if a.every { b"[*]" }
  else { match a.resource { Some(r) -> bytes_concat_all([b"[", r.name, b"]"]), None -> b"" } };
  bytes_concat_all([
    qname_text(a.eff),
    b".",
    match a.op { Some(o) -> o.name, None -> mode_text(a.mode) },
    resource,
  ])
}

// --- Every span in a generated definition becomes the `derive` item's ----------------------------

fn ident_at(i: Ident, s: Span) -> Ident = { name: i.name, span: s }

fn qname_at(q: QName, s: Span) -> QName =
  {
    module: match q.module { Some(m) -> Some(ident_at(m, s)), None -> None },
    name: ident_at(q.name, s),
    span: s,
  }

fn opt_ident_at(o: Option<Ident>, s: Span) -> Option<Ident> =
  match o { Some(i) -> Some(ident_at(i, s)), None -> None }

fn retarget_fn(def: FnDef, s: Span) -> FnDef =
  {
    vis: def.vis,
    name: ident_at(def.name, s),
    generics: {
      types: map(def.generics.types, |g: Ident| ident_at(g, s)),
      effects: map(def.generics.effects, |g: Ident| ident_at(g, s)),
      labels: map(def.generics.labels, |g: Ident| ident_at(g, s)),
    },
    params: map(def.params, |p: Param| retarget_param(p, s)),
    ret: match def.ret { Some(t) -> Some(retarget_ty(t, s)), None -> None },
    effects: match def.effects { Some(r) -> Some(retarget_row(r, s)), None -> None },
    constraints: map(def.constraints, |c: Constraint|
      { deriver: c.deriver, deriver_span: s, param: ident_at(c.param, s), span: s }),
    spec: map(def.spec, |c: SpecClause| { kind: c.kind, expr: retarget_expr(c.expr, s), span: s }),
    returns: def.returns,
    reuse: def.reuse,
    transparent: def.transparent,
    decreases: match def.decreases { Some(e) -> Some(retarget_expr(e, s)), None -> None },
    body: retarget_expr(def.body, s),
    span: s,
  }

// A parameter's default is deliberately not retargeted.
fn retarget_param(p: Param, s: Span) -> Param =
  {
    name: ident_at(p.name, s),
    ty: match p.ty { Some(t) -> Some(retarget_ty(t, s)), None -> None },
    default: p.default,
    span: s,
  }

fn retarget_ty(t: TypeExpr, s: Span) -> TypeExpr =
  match t {
    TVar(i) -> TVar(ident_at(i, s)),
    TCon(c) ->
      TCon({
        span: s,
        name: qname_at(c.name, s),
        args: map(c.args, |a: TypeExpr| retarget_ty(a, s)),
      }),
    TFn(f) ->
      TFn({
        span: s,
        params: map(f.params, |p: TypeExpr| retarget_ty(p, s)),
        ret: retarget_ty(f.ret, s),
        effects: match f.effects { Some(r) -> Some(retarget_row(r, s)), None -> None },
      }),
    TRecord(r) ->
      TRecord({
        span: s,
        fields: map(r.fields, |f: { name: Ident, ty: TypeExpr }|
          { name: ident_at(f.name, s), ty: retarget_ty(f.ty, s) }),
      }),
    TUnit(_) -> TUnit({ span: s }),
    TBad(_) -> TBad({ span: s }),
  }

fn retarget_row(r: RowExpr, s: Span) -> RowExpr =
  {
    atoms: map(r.atoms, |a: AtomExpr|
      {
        eff: qname_at(a.eff, s),
        mode: a.mode,
        op: opt_ident_at(a.op, s),
        resource: opt_ident_at(a.resource, s),
        every: a.every,
        bounded: a.bounded,
        span: s,
      }),
    aliases: map(r.aliases, |q: QName| qname_at(q, s)),
    tail: opt_ident_at(r.tail, s),
    tail_bounded: r.tail_bounded,
    span: s,
  }

fn retarget_opt_expr(o: Option<Expr>, s: Span) -> Option<Expr> =
  match o { Some(e) -> Some(retarget_expr(e, s)), None -> None }

fn retarget_field(f: RecField, s: Span) -> RecField =
  { name: ident_at(f.name, s), value: retarget_expr(f.value, s) }

fn retarget_expr(e: Expr, s: Span) -> Expr =
  match e {
    ELit(l) -> ELit({ span: s, lit: l.lit }),
    EVar(v) -> EVar({ span: s, name: qname_at(v.name, s) }),
    EBinary(b) ->
      EBinary({ span: s, op: b.op, lhs: retarget_expr(b.lhs, s), rhs: retarget_expr(b.rhs, s) }),
    EUnary(u) -> EUnary({ span: s, op: u.op, operand: retarget_expr(u.operand, s) }),
    // A lambda's written return type is deliberately not retargeted.
    ELambda(l) ->
      ELambda({
        span: s,
        body: retarget_expr(l.body, s),
        params: map(l.params, |p: Param| retarget_param(p, s)),
        ret: l.ret,
      }),
    EApp(a) ->
      EApp({
        span: s,
        func: retarget_expr(a.func, s),
        named: map(a.named, |n: NamedArg|
          { name: n.name, value: retarget_expr(n.value, s), span: n.span }),
        args: map(a.args, |x: Expr| retarget_expr(x, s)),
        labels: map(a.labels, |l: Ident| ident_at(l, s)),
      }),
    EIf(i) ->
      EIf({
        span: s,
        cond: retarget_expr(i.cond, s),
        then_branch: retarget_expr(i.then_branch, s),
        else_branch: retarget_expr(i.else_branch, s),
      }),
    EMatch(m) ->
      EMatch({
        span: s,
        scrutinee: retarget_expr(m.scrutinee, s),
        arms: map(m.arms, |arm: MatchArm|
          {
            pat: retarget_pat(arm.pat, s),
            guard: retarget_opt_expr(arm.guard, s),
            body: retarget_expr(arm.body, s),
            span: s,
          }),
      }),
    EBlock(b) ->
      EBlock({
        span: s,
        tail: retarget_opt_expr(b.tail, s),
        stmts: map(b.stmts, |st: Stmt|
          match st {
            SLet(l) ->
              SLet({
                span: s,
                pat: retarget_pat(l.pat, s),
                ty: match l.ty { Some(t) -> Some(retarget_ty(t, s)), None -> None },
                value: retarget_expr(l.value, s),
              }),
            SLetElse(l) ->
              SLetElse({
                span: s,
                pat: retarget_pat(l.pat, s),
                ty: match l.ty { Some(t) -> Some(retarget_ty(t, s)), None -> None },
                value: retarget_expr(l.value, s),
                fallback: retarget_expr(l.fallback, s),
              }),
            SExpr(x) -> SExpr(retarget_expr(x, s)),
          }),
      }),
    ERecord(r) -> ERecord({ span: s, fields: map(r.fields, |f: RecField| retarget_field(f, s)) }),
    ERecordUpdate(r) ->
      ERecordUpdate({
        span: s,
        base: retarget_expr(r.base, s),
        fields: map(r.fields, |f: RecField| retarget_field(f, s)),
      }),
    ETry(t) -> ETry({ span: s, operand: retarget_expr(t.operand, s) }),
    EField(f) -> EField({ span: s, base: retarget_expr(f.base, s), field: ident_at(f.field, s) }),
    EList(l) -> EList({ span: s, items: map(l.items, |x: Expr| retarget_expr(x, s)) }),
    EPerform(p) ->
      EPerform({
        span: s,
        eff: qname_at(p.eff, s),
        op: ident_at(p.op, s),
        resource: opt_ident_at(p.resource, s),
        args: map(p.args, |x: Expr| retarget_expr(x, s)),
      }),
    EHandle(h) ->
      EHandle({
        span: s,
        body: retarget_expr(h.body, s),
        ret: match h.ret {
          Some(rc) ->
            Some({ binder: ident_at(rc.binder, s), body: retarget_expr(rc.body, s), span: s }),
          None -> None,
        },
        clauses: map(h.clauses, |c: HandleClause|
          {
            eff: qname_at(c.eff, s),
            op: ident_at(c.op, s),
            resource: opt_ident_at(c.resource, s),
            every_label: c.every_label,
            label_binder: opt_ident_at(c.label_binder, s),
            resume: opt_ident_at(c.resume, s),
            body: retarget_expr(c.body, s),
            span: s,
            params: map(c.params, |p: Ident| ident_at(p, s)),
          }),
      }),
    EWithCell(c) ->
      EWithCell({
        span: s,
        resource: ident_at(c.resource, s),
        init: retarget_expr(c.init, s),
        binder: ident_at(c.binder, s),
        body: retarget_expr(c.body, s),
      }),
    ESimulate(x) -> ESimulate({ span: s, body: retarget_expr(x.body, s) }),
    EParallel(x) ->
      EParallel({ span: s, branches: map(x.branches, |b: Expr| retarget_expr(b, s)) }),
    EBad(_) -> EBad({ span: s }),
  }

fn retarget_pat(p: Pattern, s: Span) -> Pattern =
  match p {
    PWild(_) -> PWild({ span: s }),
    PVar(v) -> PVar({ span: s, name: ident_at(v.name, s) }),
    PLit(l) -> PLit({ span: s, lit: l.lit }),
    PCtor(c) ->
      PCtor({
        span: s,
        name: qname_at(c.name, s),
        args: map(c.args, |a: Pattern| retarget_pat(a, s)),
      }),
    PRecord(r) ->
      PRecord({
        span: s,
        rest: r.rest,
        fields: map(r.fields, |f: { name: Ident, pat: Pattern }|
          { name: ident_at(f.name, s), pat: retarget_pat(f.pat, s) }),
      }),
    PList(l) ->
      PList({
        span: s,
        rest: match l.rest { Some(r) -> Some(retarget_pat(r, s)), None -> None },
        items: map(l.items, |i: Pattern| retarget_pat(i, s)),
      }),
    POr(o) -> POr({ span: s, alts: map(o.alts, |a: Pattern| retarget_pat(a, s)) }),
    PBad(_) -> PBad({ span: s }),
  }

// --- The expander --------------------------------------------------------------------------------

type Runtime = { wanted: Bytes, prefix: Bytes, added: Option<ImportDecl> }
type Claimed = { name: Bytes, def: DeriveDef }
type Generated = { source: Bytes, defs: List<FnDef>, derived: Derived }
type Ex = {
  m: Int,
  path: Bytes,
  module: Module,
  types: List<TypeDef>,
  aliases: List<Alias>,
  claimed: List<Claimed>,
  generated: List<Generated>,
  runtimes: List<Runtime>,
  diags: List<Diag>,
}
type WithPrefix = { ex: Ex, prefix: Option<Bytes> }

pub type Expansion = { module: Module, derived: List<Derived>, diags: List<Diag> }

fn report(ex: Ex, d: Diag) -> Ex = { ..ex, diags: push(ex.diags, d) }

fn find_type(types: List<TypeDef>, name: Bytes) -> Option<TypeDef> =
  fold(types, None, |acc: Option<TypeDef>, t: TypeDef|
    match acc { Some(_) -> acc, None -> if t.name.name == name { Some(t) } else { None } })

fn find_claimed(xs: List<Claimed>, name: Bytes) -> Option<DeriveDef> =
  fold(xs, None, |acc: Option<DeriveDef>, c: Claimed|
    match acc { Some(_) -> acc, None -> if c.name == name { Some(c.def) } else { None } })

fn find_runtime(xs: List<Runtime>, wanted: Bytes) -> Option<Runtime> =
  fold(xs, None, |acc: Option<Runtime>, r: Runtime|
    match acc { Some(_) -> acc, None -> if r.wanted == wanted { Some(r) } else { None } })

fn dotted(i: ImportDecl) -> Bytes = join(map(i.path, |s: Ident| s.name), b".")

fn find_import(imports: List<ImportDecl>, wanted: Bytes) -> Option<ImportDecl> =
  fold(imports, None, |acc: Option<ImportDecl>, i: ImportDecl|
    match acc { Some(_) -> acc, None -> if dotted(i) == wanted { Some(i) } else { None } })

// The hidden import an interpolating module gets has no binder generated source can spell.
fn import_binder(i: ImportDecl) -> Option<Bytes> =
  match i.kind {
    IModule -> if len(i.path) == 0 { None } else { Some(at(i.path, len(i.path) - 1).name) },
    IAlias(a) -> if a.name == shown_binder() { None } else { Some(a.name) },
    INames(_) -> None,
  }

fn path_span(i: ImportDecl) -> Span =
  if len(i.path) == 0 { i.span }
  else { span_to(at(i.path, 0).span, at(i.path, len(i.path) - 1).span) }

fn eq_ignore_case(a: Bytes, b: Bytes) -> Bool =
  bytes_len(a) == bytes_len(b)
    && fold(range(0, bytes_len(a)), true, |acc: Bool, i: Int|
      acc && lower_byte(bytes_at(a, i)) == lower_byte(bytes_at(b, i)))

// Each table keeps the first of a name on its own, so an alias may follow a same-named sum type.
fn new_expander(m: Int, path: Bytes, module: Module) -> Ex = {
  let walked = fold(
    module.items,
    { types: [], aliases: [] },
    |acc: { types: List<TypeDef>, aliases: List<Alias> }, it: Item|
      match it {
        IType(d) -> {
          let types = match find_type(acc.types, d.name.name) {
            Some(_) -> acc.types,
            None -> push(acc.types, d),
          };
          let aliases = match d.body {
            TDAlias(body) -> if len(d.params) == 0
                && (match find_alias(acc.aliases, d.name.name) { Some(_) -> false, None -> true }) {
              push(acc.aliases, { name: d.name.name, body: body })
            } else { acc.aliases },
            _ -> acc.aliases,
          };
          { types: types, aliases: aliases }
        },
        _ -> acc,
      },
  );
  {
    m: m,
    path: path,
    module: module,
    types: walked.types,
    aliases: walked.aliases,
    claimed: [],
    generated: [],
    runtimes: [],
    diags: [],
  }
}

fn run_expander(ex: Ex) -> Ex =
  fold(ex.module.items, ex, |acc: Ex, it: Item|
    match it { IDerive(def) -> one(acc, def), _ -> acc })

fn one(ex: Ex, def: DeriveDef) -> Ex =
  match find_type(ex.types, def.target.name) {
    None -> orphan(ex, def),
    Some(target) -> {
      let name = generated_name(def.deriver, def.target.name);
      match find_claimed(ex.claimed, name) {
        Some(prev) -> collision(ex, def, prev, name),
        None -> match check_decl(def.deriver, target) {
          Some(blocker) -> not_derivable(ex, def, blocker),
          None -> {
            let rt: WithPrefix = runtime_prefix(ex, def);
            let ex1: Ex = rt.ex;
            match rt.prefix {
              None -> ex1,
              Some(prefix) -> {
                let cycle = cycle_of(codec_calls(ex1, def.deriver), def.target.name);
                let source = emit_item(
                  emitter(def.deriver, prefix, target.params, ex1.aliases, ex1.path, cycle),
                  target,
                );
                match parse_generated(source, def.span, if len(cycle) == 0 { 1 } else { 2 }) {
                  None -> internal(ex1, def, source),
                  Some(defs) ->
                    {
                      ..ex1,
                      claimed: push(ex1.claimed, { name: name, def: def }),
                      generated: push(ex1.generated, {
                        source: source,
                        defs: defs,
                        derived: { deriver: def.deriver, target: def.target.name, span: def.span },
                      }),
                    },
                }
              },
            }
          },
        },
      }
    },
  }

// Parsing what was just printed is the deriver's own round-trip check.
fn parse_generated(source: Bytes, span: Span, count: Int) -> Option<List<FnDef>> = {
  let r = parse(source);
  let x = expand(r.node, r.p.diags);
  let defs = fold(x.module.items, [], |acc: List<FnDef>, it: Item|
    match it { IFn(d) -> push(acc, retarget_fn(d, span)), _ -> acc });
  if len(x.diags) > 0 || len(x.module.items) != count || len(defs) != count { None }
  else { Some(defs) }
}

// --- Codecs on a cycle ---------------------------------------------------------------------------

// A type this module derives with a codec deriver, and the derived types its codec calls by name.
type Calls = { name: Bytes, calls: List<Bytes> }

fn codec_calls(ex: Ex, d: Deriver) -> List<Calls> =
  match d { DJson -> derived_calls(ex, d), DBin -> derived_calls(ex, d), _ -> [] }

fn derived_calls(ex: Ex, d: Deriver) -> List<Calls> = {
  let targets = fold(ex.module.items, [], |acc: List<TypeDef>, it: Item|
    match it {
      IDerive(def) -> if !same_deriver(def.deriver, d) { acc }
      else { match find_type(ex.types, def.target.name) { Some(t) -> push(acc, t), None -> acc } },
      _ -> acc,
    });
  let names = map(targets, |t: TypeDef| t.name.name);
  map(targets, |t: TypeDef|
    { name: t.name.name, calls: filter(named_in_def(d, t), |n: Bytes| has(names, n)) })
}

fn named_in_def(d: Deriver, t: TypeDef) -> List<Bytes> =
  match t.body {
    TDAlias(body) -> named_in(d, body),
    TDSum(variants) ->
      fold(variants, [], |acc: List<Bytes>, v: VariantDef|
        fold(v.fields, acc, |inner: List<Bytes>, f: TypeExpr| append(inner, named_in(d, f)))),
  }

// The types `codec` composes through by a name of this module's.
fn named_in(d: Deriver, te: TypeExpr) -> List<Bytes> =
  match te {
    TCon(c) -> {
      let inner = fold(c.args, [], |acc: List<Bytes>, a: TypeExpr| append(acc, named_in(d, a)));
      match con_shape(d, c.name.name.name) {
        Nominal -> if is_bare(c.name) { push(inner, c.name.name.name) } else { inner },
        _ -> inner,
      }
    },
    TRecord(r) ->
      fold(r.fields, [], |acc: List<Bytes>, f: { name: Ident, ty: TypeExpr }|
        append(acc, named_in(d, f.ty))),
    _ -> [],
  }

fn callees(calls: List<Calls>, name: Bytes) -> List<Bytes> =
  fold(calls, [], |acc: List<Bytes>, c: Calls|
    if c.name == name { append(acc, c.calls) } else { acc })

// Every type a chain of one or more calls leads to from `from`: no chain is longer than the types.
fn reached(calls: List<Calls>, from: Bytes) -> List<Bytes> =
  fold(range(0, len(calls)), callees(calls, from), |seen: List<Bytes>, _: Int|
    fold(seen, seen, |acc: List<Bytes>, n: Bytes|
      fold(callees(calls, n), acc, |more: List<Bytes>, m: Bytes|
        if has(more, m) { more } else { push(more, m) })))

// Empty unless `target`'s codec calls itself, through any of the others.
fn cycle_of(calls: List<Calls>, target: Bytes) -> List<Bytes> =
  filter(reached(calls, target), |n: Bytes| has(reached(calls, n), target))

// How this module writes a name that lives in the deriver's runtime module.
fn runtime_prefix(ex: Ex, def: DeriveDef) -> WithPrefix =
  match runtime_module(def.deriver) {
    None -> { ex: ex, prefix: Some(b"") },
    Some(wanted) -> match find_runtime(ex.runtimes, wanted) {
      Some(r) -> { ex: ex, prefix: Some(r.prefix) },
      None -> match find_import(ex.module.imports, wanted) {
        None ->
          {
            ex: report(
              ex,
              diag1(
                b"E0206",
                ex.m,
                def.span,
                bytes_concat_all([
                  b"`",
                  deriver_text(def.deriver),
                  b"` cannot be derived here: this module does not import `",
                  wanted,
                  b"`",
                ]),
                bytes_concat_all([b"needs `", wanted, b"`"]),
                [
                  bytes_concat_all([
                    b"add `import ",
                    wanted,
                    b"` \xe2\x80\x94 the dictionary type and the codecs a derivation composes with ship there",
                  ]),
                ],
              ),
            ),
            prefix: None,
          },
        Some(decl) -> {
          let bound: { binder: Bytes, added: Option<ImportDecl> } = match import_binder(decl) {
            Some(b) -> { binder: b, added: None },
            None -> {
              let b = free_binder(ex, def.deriver);
              let span = path_span(decl);
              {
                binder: b,
                added: Some({
                  path: map(runtime_path(def.deriver), |s: Bytes| { name: s, span: span }),
                  kind: IAlias({ name: b, span: span }),
                  span: span,
                }),
              }
            },
          };
          let prefix = bytes_concat(bound.binder, b"::");
          {
            ex: {
              ..ex,
              runtimes: push(ex.runtimes, { wanted: wanted, prefix: prefix, added: bound.added }),
            },
            prefix: Some(prefix),
          }
        },
      },
    },
  }

// A module binder nothing in this file already binds.
fn free_binder(ex: Ex, d: Deriver) -> Bytes = {
  let path = runtime_path(d);
  let base = if len(path) == 0 { b"" } else { at(path, len(path) - 1) };
  iterate(base, len(ex.module.imports) + len(ex.runtimes) + 2, |x: Bytes| {
    let by_import = fold(ex.module.imports, false, |acc: Bool, i: ImportDecl|
      acc || (match import_binder(i) { Some(b) -> b == x, None -> false }));
    let by_runtime = fold(ex.runtimes, false, |acc: Bool, r: Runtime|
      acc || r.prefix == bytes_concat(x, b"::"));
    if by_import || by_runtime { Continue(bytes_concat(x, b"_")) } else { Stop(x) }
  })
}

fn orphan(ex: Ex, def: DeriveDef) -> Ex = {
  let near = fold(ex.types, None, |acc: Option<Bytes>, t: TypeDef|
    match acc {
      Some(_) -> acc,
      None -> if eq_ignore_case(t.name.name, def.target.name) { Some(t.name.name) } else { None },
    });
  let notes = [
    b"a `derive` may only name a type its own module declares, so that one type has one canonical encoding rather than one per module that thought of it",
  ];
  report(
    ex,
    diag1(
      b"E0208",
      ex.m,
      def.target.span,
      bytes_concat_all([b"`", def.target.name, b"` is not a type this module declares"]),
      b"declared in another module, or not at all",
      match near {
        Some(n) -> push(notes, bytes_concat_all([b"this module declares `", n, b"`"])),
        None -> notes,
      },
    ),
  )
}

fn collision(ex: Ex, def: DeriveDef, prev: DeriveDef, name: Bytes) -> Ex = {
  let note = if prev.target.name == def.target.name {
    bytes_concat_all([
      b"`derive ",
      deriver_text(def.deriver),
      b" for ",
      def.target.name,
      b"` is already written above; remove one",
    ])
  } else {
    bytes_concat_all([
      b"`",
      prev.target.name,
      b"` and `",
      def.target.name,
      b"` both name `",
      name,
      b"`; rename one of the types",
    ])
  };
  report(
    ex,
    diag2(
      b"E0105",
      ex.m,
      def.span,
      bytes_concat_all([b"`", name, b"` is generated twice"]),
      b"this derivation generates it",
      ex.m,
      prev.span,
      b"and so does this one",
      [note],
    ),
  )
}

fn not_derivable(ex: Ex, def: DeriveDef, b: Blocker) -> Ex = {
  let head = bytes_concat_all([
    b"`derive ",
    deriver_text(def.deriver),
    b" for ",
    def.target.name,
    b"` requires every field to be derivable",
  ]);
  let with_note = match b.note { Some(n) -> [head, n], None -> [head] };
  let with_variant = match b.variant {
    Some(v) -> push(with_note, bytes_concat_all([b"the field is in variant `", v, b"`"])),
    None -> with_note,
  };
  let notes = push(
    with_variant,
    bytes_concat_all([
      b"remove the field from `",
      def.target.name,
      b"`, or write the dictionary by hand",
    ]),
  );
  report(
    ex,
    diag2(
      b"E0206",
      ex.m,
      b.span,
      bytes_concat_all([
        b"`",
        deriver_text(def.deriver),
        b"` cannot be derived for `",
        def.target.name,
        b"`",
      ]),
      b.reason,
      ex.m,
      def.span,
      b"required by this derivation",
      notes,
    ),
  )
}

fn internal(ex: Ex, def: DeriveDef, source: Bytes) -> Ex =
  report(
    ex,
    diag1(
      b"E0505",
      ex.m,
      def.span,
      bytes_concat_all([
        b"the `",
        deriver_text(def.deriver),
        b"` deriver generated a definition that does not parse",
      ]),
      b"this derivation",
      [
        b"this is a compiler bug: derivation is total, so generation cannot fail",
        bytes_concat(b"it generated: ", source),
      ],
    ),
  )

// Appends the generated definitions and any import a runtime module needed; `path` names the module.
pub fn expand_derives(m: Int, path: Bytes, module: Module) -> Expansion =
  if !fold(module.items, false, |b: Bool, it: Item|
      b || (match it { IDerive(_) -> true, _ -> false })) {
    { module: module, derived: [], diags: [] }
  } else {
    let ex = run_expander(new_expander(m, path, module));
    let added = fold(ex.runtimes, [], |acc: List<ImportDecl>, r: Runtime|
      match r.added { Some(i) -> push(acc, i), None -> acc });
    {
      module: {
        imports: append(module.imports, added),
        items: fold(ex.generated, module.items, |acc: List<Item>, g: Generated|
          append(acc, map(g.defs, |d: FnDef| IFn(d)))),
      },
      derived: map(ex.generated, |g: Generated| g.derived),
      diags: ex.diags,
    }
  }

// The source each of this module's derivations generates, in `derive` order.
pub fn preview(path: Bytes, module: Module) -> List<Bytes> =
  map(run_expander(new_expander(0, path, module)).generated, |g: Generated| g.source)

// Each module expanded on its own: its generated sources length-prefixed, then its diagnostics.
pub fn derive_dump(sources: List<Source>) -> String = {
  let out = fold(range(0, len(sources)), b"", |acc: Bytes, i: Int| {
    let s = at(sources, i);
    let r = parse(s.src);
    let x = expand(r.node, r.p.diags);
    let generated = preview(s.name, x.module);
    let d: Expansion = expand_derives(i, s.name, x.module);
    bytes_concat_all([
      acc,
      b"M;",
      num(len(generated)),
      b";",
      bytes_concat_all(
        map(generated, |g: Bytes| bytes_concat_all([b"S;", num(bytes_len(g)), b";", g])),
      ),
      dump_diags(d.diags),
    ])
  });
  string_of_bytes(out)
}

// --- Tests ------------------------------------------------------------------

test "snake_case follows the rule, acronyms included" {
  assert_eq(snake_case(b"Order"), b"order");
  assert_eq(snake_case(b"OrderLine"), b"order_line");
  assert_eq(snake_case(b"HTTPRequest"), b"http_request");
  assert_eq(snake_case(b"HttpRequest"), b"http_request");
  assert_eq(snake_case(b"Order2Line"), b"order2_line");
  assert_eq(snake_case(b"A"), b"a");
  assert_eq(generated_name(DJson, b"OrderLine"), b"order_line_json")
}

test "the generated form is pinned to the reference's golden output" {
  let src = b"import std.json\ntype Order = {id: Int, lines: List<Line>}\ntype Line = {sku: String}\ntype Status = Placed | Shipped(Int)\nderive json for Order\nderive eq for Line\nderive ord for Line\nderive json for Status";
  let out = preview(b"t", parse(src).node);
  assert_eq(len(out), 4);
  assert_eq(
    at(out, 0),
    b"fn order_json() -> json::JsonCodec<Order> = {encode: |dv: Order| json::object([{key: \"id\", value: (json::int_json().encode)(dv.id)}, {key: \"lines\", value: (json::list_json(line_json()).encode)(dv.lines)}]), decode: |dj: json::Json| match json::field(dj, \"id\", json::int_json()) {Err(de) -> Err(de), Ok(d0) -> match json::field(dj, \"lines\", json::list_json(line_json())) {Err(de) -> Err(de), Ok(d1) -> Ok({id: d0, lines: d1})}}}",
  );
  assert_eq(
    at(out, 1),
    b"fn line_eq() -> {eq: (Line, Line) -> Bool} = {eq: |da: Line, db: Line| da == db}",
  );
  assert_eq(
    at(out, 2),
    b"fn line_ord() -> {compare: (Line, Line) -> Ordering} = {compare: |da: Line, db: Line| compare_values(da, db)}",
  );
  assert_eq(
    at(out, 3),
    b"fn status_json() -> json::JsonCodec<Status> = {encode: |dv: Status| match dv {Placed -> json::variant(\"Placed\", []), Shipped(d0) -> json::variant(\"Shipped\", [(json::int_json().encode)(d0)])}, decode: |dj: json::Json| match json::variant_of(dj) {Err(de) -> Err(de), Ok(dt) -> if json::has_tag(dt, \"Placed\") {Ok(Placed)} else {if json::has_tag(dt, \"Shipped\") {match json::decode_and_then(json::variant_value(dt, 0), json::int_json().decode) {Err(de) -> Err(de), Ok(d0) -> Ok(Shipped(d0))}} else {json::unknown_variant(dt.tag, [\"Placed\", \"Shipped\"])}}}}",
  )
}

test "the bin form writes scalars straight, composes the rest, and keys a sum by its module" {
  let src = b"import std.bin\ntype Line = {sku: String, qty: U32, tags: List<String>}\ntype Tree<a> = Leaf | Node(Tree<a>, a)\nderive bin for Line\nderive bin for Tree";
  let out = preview(b"shop", parse(src).node);
  assert_eq(len(out), 2);
  assert_eq(
    at(out, 0),
    b"fn line_bin() -> bin::BinCodec<Line> = {put: |dw: Bytes, dv: Line| (bin::list_bin(bin::string_bin()).put)(bin::put_u32(bin::put_string(dw, dv.sku), dv.qty), dv.tags), take: |dd: Bytes, dn: Int| match bin::take_string(dd, dn) {Err(de) -> Err(de), Ok(d0) -> match bin::take_u32(dd, d0.at) {Err(de) -> Err(de), Ok(d1) -> match (bin::list_bin(bin::string_bin()).take)(dd, d1.at) {Err(de) -> Err(de), Ok(d2) -> Ok({value: {sku: d0.value, qty: d1.value, tags: d2.value}, at: d2.at})}}}, shape: |ds: bin::Shapes| bin::record_shape(ds, [{name: \"sku\", shape: bin::string_bin().shape}, {name: \"qty\", shape: bin::u32_bin().shape}, {name: \"tags\", shape: bin::list_bin(bin::string_bin()).shape}])}",
  );
  assert_eq(
    at(out, 1),
    b"fn tree_bin<a>(a: bin::BinCodec<a>) -> bin::BinCodec<Tree<a>> where derivable(bin, a) = tree_bin_at(a, bin::max_depth())\nfn tree_bin_at<a>(a: bin::BinCodec<a>, ddepth: Int) -> bin::BinCodec<Tree<a>> where derivable(bin, a) = if ddepth <= 0 {bin::too_deep()} else {{put: |dw: Bytes, dv: Tree<a>| match dv {Leaf -> bin::put_tag(dw, 0), Node(d0, d1) -> (a.put)((tree_bin_at(a, ddepth - 1).put)(bin::put_tag(dw, 1), d0), d1)}, take: |dd: Bytes, dn: Int| match bin::take_tag(dd, dn, 2) {Err(de) -> Err(de), Ok(dt) -> match dt.value {0 -> Ok({value: Leaf, at: dt.at}), _ -> match (tree_bin_at(a, ddepth - 1).take)(dd, dt.at) {Err(de) -> Err(de), Ok(d0) -> match (a.take)(dd, d0.at) {Err(de) -> Err(de), Ok(d1) -> Ok({value: Node(d0.value, d1.value), at: d1.at})}}}}, shape: |ds: bin::Shapes| bin::sum_shape(ds, \"shop.Tree\", \"Tree\", [a.shape], [{name: \"Leaf\", fields: []}, {name: \"Node\", fields: [tree_bin_at(a, ddepth - 1).shape, a.shape]}])}}",
  )
}

test "a codec on a cycle hands the cycle one depth less, and calls a codec off it as written" {
  let src = b"import std.json\ntype Expr = Num(Int) | Block(List<Stmt>) | Lit(Literal)\ntype Stmt = Bare(Expr) | Let({name: String, value: Expr})\ntype Literal = Text(String)\nderive json for Expr\nderive json for Stmt\nderive json for Literal\nderive eq for Expr";
  let out = preview(b"t", parse(src).node);
  assert_eq(len(out), 4);
  let expr = at(out, 0);
  assert(
    bytes_starts_with(
      expr,
      b"fn expr_json() -> json::JsonCodec<Expr> = expr_json_at(json::max_depth())\nfn expr_json_at(ddepth: Int) -> json::JsonCodec<Expr> = if ddepth <= 0 {json::too_deep()} else {{encode:",
    ),
  );
  assert(bytes_index_of(expr, b"json::list_json(stmt_json_at(ddepth - 1))") != None);
  assert(bytes_index_of(expr, b"(literal_json().encode)") != None);
  assert(bytes_index_of(at(out, 1), b"(expr_json_at(ddepth - 1).encode)(dv.value)") != None);
  assert(bytes_index_of(at(out, 2), b"_at") == None);
  assert(bytes_index_of(at(out, 3), b"_at") == None);
  let x = expand_derives(0, b"t", parse(src).node);
  assert_eq(len(x.diags), 0);
  assert_eq(len(x.derived), 4);
  assert_eq(len(x.module.items), 7 + 2 + 2 + 1 + 1)
}

test "a selective import of std.json still writes a module binder, stepping around a taken name" {
  let src = b"import other.json\nimport std.json (JsonCodec, Json, object, field, int_json)\ntype Order = {id: Int}\nderive json for Order";
  let x = expand_derives(0, b"t", parse(src).node);
  assert_eq(len(x.diags), 0);
  assert_eq(len(x.module.imports), 3);
  assert(
    bytes_starts_with(
      at(preview(b"t", parse(src).node), 0),
      b"fn order_json() -> json_::JsonCodec<Order>",
    ),
  )
}

test "every span in a generated definition is the derive item's" {
  let src = b"import std.json\ntype Order = {id: Int}\nderive json for Order";
  let x = expand_derives(0, b"t", parse(src).node);
  assert_eq(len(x.derived), 1);
  let d = at(x.derived, 0);
  assert_eq(d.span, { start: 39, end: 60 });
  match at(x.module.items, len(x.module.items) - 1) {
    IFn(f) -> {
      assert_eq(f.span, d.span);
      assert_eq(f.name.span, d.span)
    },
    _ -> assert(false),
  }
}

test "an orphan, a collision, a missing runtime and a refused field each report as the reference does" {
  let orphan_ = expand_derives(0, b"t", parse(b"import std.json\nderive json for Order").node);
  assert_eq(map(orphan_.diags, |d: Diag| d.code), [b"E0208"]);
  let twice = expand_derives(
    0,
    b"t",
    parse(b"type Order = {id: Int}\nderive eq for Order\nderive eq for Order").node,
  );
  assert_eq(map(twice.diags, |d: Diag| d.code), [b"E0105"]);
  assert_eq(len(at(twice.diags, 0).labels), 2);
  let missing = expand_derives(
    0,
    b"t",
    parse(b"type Order = {id: Int}\nderive json for Order").node,
  );
  assert_eq(map(missing.diags, |d: Diag| d.code), [b"E0206"]);
  let refused = expand_derives(
    0,
    b"t",
    parse(
      b"import std.json\ntype Order = {id: Int, on_complete: (Int) -> Unit}\nderive json for Order",
    ).node,
  );
  assert_eq(map(refused.diags, |d: Diag| d.code), [b"E0206"]);
  let first = at(at(refused.diags, 0).labels, 0);
  assert_eq(first.start, 39);
  assert_eq(first.end, 65)
}
