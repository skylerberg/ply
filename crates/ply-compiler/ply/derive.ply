//! `derive D for T` becomes an ordinary definition: generated as source, parsed back, and retargeted.

import parsing (Span, Ident, QName, span_to, is_bare, qname_text)
import type_syntax (TypeExpr, TVar, TCon, TFn, TRecord, TUnit, TBad, RowExpr, AtomExpr, Mode, MRead,
                    MWrite, MBad, ty_span, mode_text, angled, generics_text, is_generic,
                    ident_names)
import patterns (Pattern, PWild, PVar, PLit, PRange, PCtor, PRecord, PList, POr, PBad)
import exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock, ERecord,
              ERecordUpdate, ETry, EField, EList, EPerform, EHandle, EWithCell, ESimulate,
              EParallel, EBad, ETryBlock, Stmt, SLet, SLetElse, SExpr, Param, NamedArg, MatchArm,
              HandleClause, ReturnClause, RecField, hidden_binder, ETagged, Hole)
import items (Module, Item, IFn, IType, IDerive, FnDef, TypeDef, TypeDefBody, TDAlias, TDSum,
              VariantDef, DeriveDef, Deriver, DJson, DEq, DOrd, DBin, DShow, DHash, DNumeric,
              DInteger, deriver_text, deriver_tag, ImportDecl, ImportKind, IModule, IAlias, INames,
              Vis, VPub, VPriv, Derived, Constraint, SpecClause, parse, constraint_written,
              TDNominal, IInstance, InstanceDef, NKey, NShow)
import rewrite (expand, find_type)
import resolve (Diag, Source, error_at, error_at_and, dump_diags, path_span)
import std.list (at, concat, contains)
import std.bytes (join, ascii_of_int)
import std.text

// --- Rules ---------------------------------------------------------------------------------------

pub type DeriveRefusal =
  | HoldsFunction
  | HoldsHandle
  | HoldsFloat
  | Unconstrained(Int)
  | NullInsideOption
  | HoldsSecret
pub type ConstructorShape = | Leaf | Structural | Refused(DeriveRefusal) | Nominal

/// The one table the deriver and the checker's `derivable` both read, so the two cannot disagree.
pub fn constructor_shape(deriver: Deriver, name: Bytes) -> ConstructorShape =
  if name == b"Int" || name == b"Bool" || name == b"String" || name == b"Bytes" || name == b"Unit"
      || name == b"Decimal"
      || name == b"Char" { Leaf } else if name == b"Float" {
    match deriver { DOrd -> Refused(HoldsFloat), DHash -> Refused(HoldsFloat), _ -> Leaf }
  } else if name == b"List" || name == b"Array" || name == b"Option" || name == b"Map"
      || name == b"Result"
      || name == b"Ordering"
      || name == b"Rounding"
      || name == b"Instant"
      || name == b"Duration" { Structural }
  else if same_deriver(deriver, DBin) && is_fixed_width(name) { Leaf }
  else if same_deriver(deriver, DBin) && name == b"Iter" { Structural }
  else if name == b"Cell" || name == b"Task" || name == b"Chan" { Refused(HoldsHandle) }
  else if name == b"Secret" { match deriver { DEq -> Leaf, _ -> Refused(HoldsSecret) } }
  else { Nominal }

/// Whether a type constructor's JSON encoding can be the document `null`.
pub fn null_encoded_name(name: Bytes) -> Bool = name == b"Unit" || name == b"Option"

fn is_fixed_width(name: Bytes) -> Bool =
  name == b"U8" || name == b"U16" || name == b"U32" || name == b"U64" || name == b"U128"
    || name == b"I8"
    || name == b"I16"
    || name == b"I32"
    || name == b"I64"
    || name == b"I128"

pub fn same_deriver(a: Deriver, b: Deriver) -> Bool = deriver_tag(a) == deriver_tag(b)

/// The module whose definitions a generated body calls, if any.
fn runtime_module(deriver: Deriver) -> Option<Bytes> =
  match deriver {
    DJson -> Some(b"std.json"),
    DBin -> Some(b"std.bin"),
    DShow -> Some(b"std.show"),
    _ -> None,
  }

fn runtime_path(deriver: Deriver) -> List<Bytes> =
  match deriver {
    DJson -> [b"std", b"json"],
    DBin -> [b"std", b"bin"],
    DShow -> [b"std", b"show"],
    _ -> [],
  }

fn is_upper_byte(c: Int) -> Bool = c >= 65 && c <= 90
fn lower_byte(c: Int) -> Int = if is_upper_byte(c) { c + 32 } else { c }

/// The name a type's derived functions start with: `std.text`'s, so the two cannot disagree.
pub fn snake_case(name: Bytes) -> Bytes =
  bytes_of_string(text::snake_case(string_of_bytes_lossy(name)))

pub fn generated_name(deriver: Deriver, type_name: Bytes) -> Bytes / {abort.raise} =
  bytes_concat_all([snake_case(type_name), b"_", deriver_text(deriver)])

// --- The syntactic half of `derivable(D, t)` ---------------------------------------------------

/// `reason` completes the label at `span`; `note` is the advice only a `Secret` refusal carries.
type Blocker = { span: Span, reason: Bytes, note: Option<Bytes>, variant: Option<Bytes> }

fn check_decl(deriver: Deriver, def: TypeDef) -> Option<Blocker> / {abort.raise} =
  match def.body {
    TDAlias(body) -> check_type_expr(deriver, body),
    TDNominal(body) -> check_type_expr(deriver, body),
    TDSum(variants) ->
      fold(variants, None, |acc: Option<Blocker>, variant: VariantDef|
        match acc {
          Some(_) -> acc,
          None -> match first_blocked_type_expr(deriver, variant.fields) {
            Some(b) ->
              Some({
                span: b.span,
                reason: b.reason,
                note: b.note,
                variant: Some(variant.name.name),
              }),
            None -> None,
          },
        }),
  }

/// Whether the module states what `deriver` reads of `target`: its `key` for `eq`, `ord` and `hash`,
/// its `show` for `show`. The fields are then not what is derived from, and the checker judges what
/// the stated function answers.
fn has_instance(module: Module, deriver: Deriver, target: Bytes) -> Bool =
  fold(module.items, false, |found: Bool, item: Item|
    found
      || (match item {
        IInstance(d) ->
          d.target.name == target
            && (match d.kind {
              NKey ->
                same_deriver(deriver, DEq) || same_deriver(deriver, DOrd)
                  || same_deriver(deriver, DHash),
              NShow -> same_deriver(deriver, DShow),
            }),
        _ -> false,
      }))

// No generated call fills a label, and only a type that holds a function has a use for one.
fn label_refusal() -> Bytes = b"a type that takes a label has no derivation"

fn function_refusal(deriver: Deriver) -> Bytes =
  match deriver {
    DJson -> b"a function has no JSON encoding",
    DEq -> b"functions cannot be compared for equality",
    DOrd -> b"functions cannot be ordered",
    DBin -> b"a function has no binary encoding",
    DShow -> b"a function has no rendering to derive",
    DHash -> b"a function has no content to hash",
    DNumeric -> b"a function is not a number",
    DInteger -> b"a function is not an integer",
  }

pub fn refusal_reason(w: DeriveRefusal, deriver: Deriver, simple: Bytes) -> Bytes =
  match w {
    HoldsFloat -> float_reason(deriver),
    HoldsHandle -> bytes_concat_all([b"a `", simple, b"` names a location rather than a value"]),
    HoldsSecret -> secret_reason(deriver),
    _ -> b"",
  }

pub fn float_reason(deriver: Deriver) -> Bytes =
  match deriver {
    DHash ->
      b"`Float` has no hash that agrees with `==`: `NaN != NaN`, and `0.0 == -0.0` in different bits",
    _ -> b"`Float` is not ordered: `NaN != NaN`",
  }

pub fn secret_reason(deriver: Deriver) -> Bytes =
  match deriver {
    DJson -> b"a derived codec would write the credential into the document",
    DOrd -> b"a credential has no order",
    DEq -> b"a credential has no structural equality to derive",
    DBin -> b"a derived codec would write the credential into the bytes",
    DShow -> b"a derived rendering would write the credential out",
    DHash -> b"a hash of a credential is something to test guesses against",
    DNumeric -> b"a credential is not a number",
    DInteger -> b"a credential is not an integer",
  }

pub fn refusal_note(w: DeriveRefusal, deriver: Deriver) -> Option<Bytes> =
  match w {
    HoldsSecret -> match deriver {
      DOrd ->
        Some(
          b"an ordering over a credential leaks a bit of position per comparison and recovers the value in calls proportional to its length; `derive eq` is available, and `secret_verify` is the check a program actually wants",
        ),
      DShow ->
        Some(
          b"a credential is never shown, in an interpolated string or anywhere else; show what the `Secret` guards or names instead",
        ),
      DHash ->
        Some(
          b"hash what the `Secret` guards or names instead; a password wants `std.password`, not a content hash",
        ),
      _ ->
        Some(
          b"move the `Secret` field out of the type being derived, or write the codec by hand over the fields that are not credentials \xe2\x80\x94 there is no way to encode a `Secret`, which is the guarantee",
        ),
    },
    _ -> None,
  }

pub fn null_in_option_note() -> Bytes =
  b"wrap the inner value in a record or a one-field variant \xe2\x80\x94 both are tagged, and a tagged encoding has no `null` to collide with"

pub fn null_in_option(inner: Bytes) -> Bytes =
  bytes_concat_all([
    b"`",
    inner,
    b"` encodes as `null`, which is how an `Option` writes `None`, so `Some` and `None` are the same document",
  ])

fn first_blocked_type_expr(
  deriver: Deriver,
  tys: List<TypeExpr>,
) -> Option<Blocker> / {abort.raise} =
  fold(tys, None, |acc: Option<Blocker>, ty: TypeExpr|
    match acc { Some(_) -> acc, None -> check_type_expr(deriver, ty) })

fn null_encoded_type_expr(ty: TypeExpr) -> Bool =
  match ty { TUnit(_) -> true, TCon(c) -> null_encoded_name(c.name.name.name), _ -> false }

/// A type parameter is derivable by assumption; a record field is blamed as a whole.
fn check_type_expr(deriver: Deriver, ty: TypeExpr) -> Option<Blocker> / {abort.raise} =
  match ty {
    TVar(_) -> None,
    TUnit(_) -> None,
    TBad(_) -> None,
    TFn(f) -> Some({ span: f.span, reason: function_refusal(deriver), note: None, variant: None }),
    TRecord(r) ->
      fold(r.fields, None, |acc: Option<Blocker>, f: { name: Ident, ty: TypeExpr }|
        match acc {
          Some(_) -> acc,
          None -> match check_type_expr(deriver, f.ty) {
            Some(b) ->
              Some({
                span: span_to(f.name.span, ty_span(f.ty)),
                reason: b.reason,
                note: b.note,
                variant: b.variant,
              }),
            None -> None,
          },
        }),
    TCon(c) -> if len(c.labels) > 0 {
      Some({ span: c.span, reason: label_refusal(), note: None, variant: None })
    } else {
      let simple = c.name.name.name;
      match constructor_shape(deriver, simple) {
        Refused(why) ->
          Some({
            span: c.span,
            reason: bytes_concat_all([
              refusal_reason(why, deriver, simple),
              b", so `",
              simple,
              b"` has no derivation",
            ]),
            note: refusal_note(why, deriver),
            variant: None,
          }),
        _ -> if same_deriver(deriver, DJson) && simple == b"Option" && len(c.args) > 0
            && null_encoded_type_expr(at(c.args, 0)) {
          let inner = match at(c.args, 0) { TCon(k) -> k.name.name.name, _ -> b"Unit" };
          Some({ span: c.span, reason: null_in_option(inner), note: None, variant: None })
        } else {
          // A `Map`'s key type must be ordered whichever deriver is walking.
          let key = if simple == b"Map" && len(c.args) > 0 {
            match check_type_expr(DOrd, at(c.args, 0)) {
              Some(b) ->
                Some({
                  span: b.span,
                  reason: bytes_concat(b.reason, b", and a `Map` key type must be ordered"),
                  note: b.note,
                  variant: b.variant,
                }),
              None -> None,
            }
          } else { None };
          match key { Some(b) -> Some(b), None -> first_blocked_type_expr(deriver, c.args) }
        },
      }
    },
  }

// --- Generated definitions, as Ply source -------------------------------------------------------

type Alias = { name: Bytes, body: TypeExpr }

/// `b` prefixes every generated binder, chosen so none can shadow a dictionary parameter; `path` is the
/// module's; `cycle` holds the types whose codecs call the target's and are called back by it.
type DeriveEmitter = {
  d: Deriver,
  rt: Bytes,
  b: Bytes,
  aliases: List<Alias>,
  path: Bytes,
  cycle: List<Bytes>,
}

fn emitter(
  deriver: Deriver,
  rt: Bytes,
  params: List<Ident>,
  aliases: List<Alias>,
  path: Bytes,
  cycle: List<Bytes>,
) -> DeriveEmitter / {abort.raise} = {
  let b = iterate(b"d", len(params) + 2, |x: Bytes|
    if fold(params, false, |acc: Bool, ident: Ident| acc || bytes_starts_with(ident.name, x)) {
      Continue(bytes_concat(x, b"_"))
    } else { Stop(x) });
  { d: deriver, rt: rt, b: b, aliases: aliases, path: path, cycle: cycle }
}

fn find_alias(aliases: List<Alias>, name: Bytes) -> Option<TypeExpr> =
  fold(aliases, None, |acc: Option<TypeExpr>, alias: Alias|
    match acc { Some(_) -> acc, None -> if alias.name == name { Some(alias.body) } else { None } })

pub fn target_type(def: TypeDef) -> Bytes / {abort.raise} =
  bytes_concat(def.name.name, generics_text(def.generics))

/// A codec on a cycle is two definitions: the named one starts `_at` at the runtime's `max_depth`, and
/// `_at` hands its cycle one less, so its recursion is seen to end.
fn emit_item(emitter: DeriveEmitter, def: TypeDef) -> Bytes / {abort.raise} = {
  let name = generated_name(emitter.d, def.name.name);
  let target = target_type(def);
  let ps = map(def.generics.types, |p: Ident| p.name);
  let generics = generics_text(def.generics);
  let dicts = map(ps, |p: Bytes| bytes_concat_all([p, b": ", dict_type(emitter, p)]));
  let constraints = if len(ps) == 0 { b"" } else {
    bytes_concat(b" where ", join(map(ps, |p: Bytes| constraint_written(emitter.d, p)), b", "))
  };
  let head = |fname: Bytes, params: List<Bytes>|
    bytes_concat_all([
      b"fn ",
      fname,
      generics,
      b"(",
      join(params, b", "),
      b") -> ",
      dict_type(emitter, target),
      constraints,
      b" = ",
    ]);
  let vis = match def.vis { VPub -> b"pub ", VPriv -> b"" };
  if len(emitter.cycle) == 0 {
    bytes_concat_all([vis, head(name, dicts), dictionary(emitter, def, target)])
  } else {
    let at_name = bytes_concat(name, b"_at");
    bytes_concat_all([
      vis,
      head(name, dicts),
      at_name,
      b"(",
      join(push(ps, bytes_concat(emitter.rt, b"max_depth()")), b", "),
      b")\n",
      head(at_name, push(dicts, bytes_concat(emitter.b, b"depth: Int"))),
      b"if ",
      emitter.b,
      b"depth <= 0 {",
      emitter.rt,
      b"too_deep()} else {",
      dictionary(emitter, def, target),
      b"}",
    ])
  }
}

/// `JsonCodec<a>` and `BinCodec<a>` ship with their runtime modules; `EqDict` and `OrdDict` are structural.
fn dict_type(emitter: DeriveEmitter, arg: Bytes) -> Bytes =
  match emitter.d {
    DJson -> bytes_concat_all([emitter.rt, b"JsonCodec<", arg, b">"]),
    DBin -> bytes_concat_all([emitter.rt, b"BinCodec<", arg, b">"]),
    DShow -> bytes_concat_all([b"{show: (", arg, b") -> String}"]),
    DHash -> bytes_concat_all([b"{hash: (", arg, b") -> Bytes}"]),
    DEq -> bytes_concat_all([b"{eq: (", arg, b", ", arg, b") -> Bool}"]),
    DOrd -> bytes_concat_all([b"{compare: (", arg, b", ", arg, b") -> Ordering}"]),
    // A predicate is never derived: the parser has no `derive` that names one.
    _ -> b"()",
  }

fn dictionary(emitter: DeriveEmitter, def: TypeDef, target: Bytes) -> Bytes / {abort.raise} =
  match emitter.d {
    DEq ->
      bytes_concat_all([
        b"{eq: |",
        emitter.b,
        b"a: ",
        target,
        b", ",
        emitter.b,
        b"b: ",
        target,
        b"| ",
        emitter.b,
        b"a == ",
        emitter.b,
        b"b}",
      ]),
    DOrd ->
      bytes_concat_all([
        b"{compare: |",
        emitter.b,
        b"a: ",
        target,
        b", ",
        emitter.b,
        b"b: ",
        target,
        b"| compare_values(",
        emitter.b,
        b"a, ",
        emitter.b,
        b"b)}",
      ]),
    DShow ->
      bytes_concat_all([
        b"{show: |",
        emitter.b,
        b"a: ",
        target,
        b"| ",
        emitter.rt,
        b"show(",
        emitter.b,
        b"a)}",
      ]),
    DHash ->
      bytes_concat_all([b"{hash: |", emitter.b, b"a: ", target, b"| digest(", emitter.b, b"a)}"]),
    DJson -> match def.body {
      TDAlias(body) -> codec(emitter, body, target),
      TDNominal(body) -> codec(emitter, body, target),
      TDSum(variants) -> json_sum(emitter, variants, target),
    },
    DBin -> match def.body {
      TDAlias(body) -> codec(emitter, body, target),
      TDNominal(body) -> codec(emitter, body, target),
      TDSum(variants) -> bin_sum(emitter, def, variants, target),
    },
    _ -> b"()",
  }

/// An expression of the codec type of `te`: `JsonCodec<te>` or `BinCodec<te>`.
fn codec(emitter: DeriveEmitter, te: TypeExpr, annotation: Bytes) -> Bytes / {abort.raise} =
  match te {
    TVar(p) -> p.name,
    TUnit(_) -> bytes_concat_all([emitter.rt, b"unit_", deriver_text(emitter.d), b"()"]),
    TBad(_) -> b"()",
    TFn(_) -> b"()",
    TRecord(r) -> match emitter.d {
      DBin -> bin_record(emitter, r.fields, annotation),
      _ -> json_record(emitter, r.fields, annotation),
    },
    TCon(c) -> {
      let simple = c.name.name.name;
      let codecs = map(c.args, |a: TypeExpr| codec(emitter, a, render_type(a)));
      // A JSON object's keys are strings, so a `Map<String, v>` has an object form.
      if same_deriver(emitter.d, DJson) && simple == b"Map" && len(c.args) == 2
          && is_string(emitter, at(c.args, 0)) {
        bytes_concat_all([emitter.rt, b"string_map_json(", at(codecs, 1), b")"])
      } else {
        let call = bytes_concat_all([
          snake_case(simple),
          b"_",
          deriver_text(emitter.d),
          b"(",
          join(codecs, b", "),
          b")",
        ]);
        // A named type is composed through by name, never inlined.
        match constructor_shape(emitter.d, simple) {
          Nominal -> match c.name.module {
            Some(m) -> bytes_concat_all([m.name, b"::", call]),
            None -> if contains(emitter.cycle, simple) {
              bytes_concat_all([
                snake_case(simple),
                b"_",
                deriver_text(emitter.d),
                b"_at(",
                join(push(codecs, bytes_concat(emitter.b, b"depth - 1")), b", "),
                b")",
              ])
            } else { call },
          },
          _ -> bytes_concat(emitter.rt, call),
        }
      }
    },
  }

/// Whether a written type *is* `String`, following the module's own parameterless aliases.
fn is_string(emitter: DeriveEmitter, ty: TypeExpr) -> Bool / {abort.raise} =
  iterate({ cur: ty, n: 0 }, 66, |s: { cur: TypeExpr, n: Int }|
    if s.n >= 64 { Stop(false) } else {
      match s.cur {
        TCon(c) -> if !is_bare(c.name) || len(c.args) > 0 { Stop(false) }
        else if c.name.name.name == b"String" { Stop(true) } else {
          match find_alias(emitter.aliases, c.name.name.name) {
            Some(body) -> Continue({ cur: body, n: s.n + 1 }),
            None -> Stop(false),
          }
        },
        _ -> Stop(false),
      }
    })

fn json_record(
  emitter: DeriveEmitter,
  fields: List<{ name: Ident, ty: TypeExpr }>,
  annotation: Bytes,
) -> Bytes / {abort.raise} = {
  let entries = map(fields, |f: { name: Ident, ty: TypeExpr }|
    bytes_concat_all([
      b"{key: \"",
      f.name.name,
      b"\", value: (",
      codec(emitter, f.ty, render_type(f.ty)),
      b".encode)(",
      emitter.b,
      b"v.",
      f.name.name,
      b")}",
    ]));
  let encode = bytes_concat_all([
    b"|",
    emitter.b,
    b"v: ",
    annotation,
    b"| ",
    emitter.rt,
    b"object([",
    join(entries, b", "),
    b"])",
  ]);
  let built = map(range(0, len(fields)), |i: Int|
    bytes_concat_all([at(fields, i).name.name, b": ", emitter.b, ascii_of_int(i)]));
  let decode = fold(
    range(0, len(fields)),
    bytes_concat_all([b"Ok({", join(built, b", "), b"})"]),
    |acc: Bytes, k: Int| {
      let i = len(fields) - 1 - k;
      let f = at(fields, i);
      bytes_concat_all([
        b"match ",
        emitter.rt,
        b"field(",
        emitter.b,
        b"j, \"",
        f.name.name,
        b"\", ",
        codec(emitter, f.ty, render_type(f.ty)),
        b") {Err(",
        emitter.b,
        b"e) -> Err(",
        emitter.b,
        b"e), Ok(",
        emitter.b,
        ascii_of_int(i),
        b") -> ",
        acc,
        b"}",
      ])
    },
  );
  bytes_concat_all([
    b"{encode: ",
    encode,
    b", decode: |",
    emitter.b,
    b"j: ",
    emitter.rt,
    b"Json| ",
    decode,
    b"}",
  ])
}

/// A variant is encoded by its declared name and its fields in order.
fn json_sum(
  emitter: DeriveEmitter,
  variants: List<VariantDef>,
  target: Bytes,
) -> Bytes / {abort.raise} = {
  let arms = map(variants, |v: VariantDef| {
    let binders = map(range(0, len(v.fields)), |i: Int| bytes_concat(emitter.b, ascii_of_int(i)));
    let pat = if len(binders) == 0 { v.name.name }
    else { bytes_concat_all([v.name.name, b"(", join(binders, b", "), b")"]) };
    let values = map(range(0, len(v.fields)), |i: Int|
      bytes_concat_all([
        b"(",
        codec(emitter, at(v.fields, i), render_type(at(v.fields, i))),
        b".encode)(",
        emitter.b,
        ascii_of_int(i),
        b")",
      ]));
    bytes_concat_all([
      pat,
      b" -> ",
      emitter.rt,
      b"variant(\"",
      v.name.name,
      b"\", [",
      join(values, b", "),
      b"])",
    ])
  });
  let encode = bytes_concat_all([
    b"|",
    emitter.b,
    b"v: ",
    target,
    b"| match ",
    emitter.b,
    b"v {",
    join(arms, b", "),
    b"}",
  ]);
  let names = map(variants, |v: VariantDef| bytes_concat_all([b"\"", v.name.name, b"\""]));
  let chain = fold(
    range(0, len(variants)),
    bytes_concat_all([
      emitter.rt,
      b"unknown_variant(",
      emitter.b,
      b"t.tag, [",
      join(names, b", "),
      b"])",
    ]),
    |acc: Bytes, k: Int| {
      let v = at(variants, len(variants) - 1 - k);
      let ctor_args = if len(v.fields) == 0 { b"" } else {
        bytes_concat_all([
          b"(",
          join(
            map(range(0, len(v.fields)), |i: Int| bytes_concat(emitter.b, ascii_of_int(i))),
            b", ",
          ),
          b")",
        ])
      };
      let built = fold(
        range(0, len(v.fields)),
        bytes_concat_all([b"Ok(", v.name.name, ctor_args, b")"]),
        |inner: Bytes, kk: Int| {
          let i = len(v.fields) - 1 - kk;
          bytes_concat_all([
            b"match ",
            emitter.rt,
            b"decode_and_then(",
            emitter.rt,
            b"variant_value(",
            emitter.b,
            b"t, ",
            ascii_of_int(i),
            b"), ",
            codec(emitter, at(v.fields, i), render_type(at(v.fields, i))),
            b".decode) {Err(",
            emitter.b,
            b"e) -> Err(",
            emitter.b,
            b"e), Ok(",
            emitter.b,
            ascii_of_int(i),
            b") -> ",
            inner,
            b"}",
          ])
        },
      );
      // On a cycle the test is a call: the emitter keys an operator's settled type by span, every
      // operator here is on the `derive` item's one span, and a depth's are `Int`s.
      let tested = if len(emitter.cycle) == 0 {
        bytes_concat_all([emitter.b, b"t.tag == \"", v.name.name, b"\""])
      } else {
        bytes_concat_all([emitter.rt, b"has_tag(", emitter.b, b"t, \"", v.name.name, b"\")"])
      };
      bytes_concat_all([b"if ", tested, b" {", built, b"} else {", acc, b"}"])
    },
  );
  let decode = bytes_concat_all([
    b"|",
    emitter.b,
    b"j: ",
    emitter.rt,
    b"Json| match ",
    emitter.rt,
    b"variant_of(",
    emitter.b,
    b"j) {Err(",
    emitter.b,
    b"e) -> Err(",
    emitter.b,
    b"e), Ok(",
    emitter.b,
    b"t) -> ",
    chain,
    b"}",
  ]);
  bytes_concat_all([b"{encode: ", encode, b", decode: ", decode, b"}"])
}

/// A scalar is written and read by `std.bin`'s own functions rather than through a codec.
fn bin_scalar(ty: TypeExpr) -> Option<Bytes> / {abort.raise} =
  match ty {
    TUnit(_) -> Some(b"unit"),
    TCon(c) -> match constructor_shape(DBin, c.name.name.name) {
      Leaf -> Some(snake_case(c.name.name.name)),
      _ -> None,
    },
    _ -> None,
  }

fn bin_put(emitter: DeriveEmitter, ty: TypeExpr, w: Bytes, x: Bytes) -> Bytes / {abort.raise} =
  match bin_scalar(ty) {
    Some(s) -> bytes_concat_all([emitter.rt, b"put_", s, b"(", w, b", ", x, b")"]),
    None ->
      bytes_concat_all([b"(", codec(emitter, ty, render_type(ty)), b".put)(", w, b", ", x, b")"]),
  }

fn bin_take(emitter: DeriveEmitter, ty: TypeExpr, from: Bytes) -> Bytes / {abort.raise} =
  match bin_scalar(ty) {
    Some(s) -> bytes_concat_all([emitter.rt, b"take_", s, b"(", emitter.b, b"d, ", from, b")"]),
    None ->
      bytes_concat_all([
        b"(",
        codec(emitter, ty, render_type(ty)),
        b".take)(",
        emitter.b,
        b"d, ",
        from,
        b")",
      ]),
  }

/// Each of `tys` read where the last ended, the first at `start`, then `built` over their values.
fn bin_takes(
  emitter: DeriveEmitter,
  tys: List<TypeExpr>,
  start: Bytes,
  built: Bytes,
) -> Bytes / {abort.raise} = {
  let n = len(tys);
  let end_of = |i: Int|
    if i < 0 { start } else { bytes_concat_all([emitter.b, ascii_of_int(i), b".at"]) };
  fold(
    range(0, n),
    bytes_concat_all([b"Ok({value: ", built, b", at: ", end_of(n - 1), b"})"]),
    |acc: Bytes, k: Int| {
      let i = n - 1 - k;
      bytes_concat_all([
        b"match ",
        bin_take(emitter, at(tys, i), end_of(i - 1)),
        b" {Err(",
        emitter.b,
        b"e) -> Err(",
        emitter.b,
        b"e), Ok(",
        emitter.b,
        ascii_of_int(i),
        b") -> ",
        acc,
        b"}",
      ])
    },
  )
}

fn values_of(emitter: DeriveEmitter, n: Int) -> List<Bytes> =
  map(range(0, n), |i: Int| bytes_concat_all([emitter.b, ascii_of_int(i), b".value"]))

fn shapes_of(emitter: DeriveEmitter, tys: List<TypeExpr>) -> Bytes / {abort.raise} =
  join(map(tys, |ty: TypeExpr| bytes_concat(codec(emitter, ty, render_type(ty)), b".shape")), b", ")

fn bin_record(
  emitter: DeriveEmitter,
  fields: List<{ name: Ident, ty: TypeExpr }>,
  annotation: Bytes,
) -> Bytes / {abort.raise} = {
  let put = fold(
    fields,
    bytes_concat(emitter.b, b"w"),
    |acc: Bytes, f: { name: Ident, ty: TypeExpr }|
      bin_put(emitter, f.ty, acc, bytes_concat_all([emitter.b, b"v.", f.name.name])),
  );
  let values = values_of(emitter, len(fields));
  let built = map(range(0, len(fields)), |i: Int|
    bytes_concat_all([at(fields, i).name.name, b": ", at(values, i)]));
  let shapes = map(fields, |f: { name: Ident, ty: TypeExpr }|
    bytes_concat_all([
      b"{name: \"",
      f.name.name,
      b"\", shape: ",
      codec(emitter, f.ty, render_type(f.ty)),
      b".shape}",
    ]));
  bytes_concat_all([
    b"{put: |",
    emitter.b,
    b"w: Bytes, ",
    emitter.b,
    b"v: ",
    annotation,
    b"| ",
    put,
    b", take: |",
    emitter.b,
    b"d: Bytes, ",
    emitter.b,
    b"n: Int| ",
    bin_takes(
      emitter,
      map(fields, |f: { name: Ident, ty: TypeExpr }| f.ty),
      bytes_concat(emitter.b, b"n"),
      bytes_concat_all([b"{", join(built, b", "), b"}"]),
    ),
    b", shape: |",
    emitter.b,
    b"s: ",
    emitter.rt,
    b"Shapes| ",
    emitter.rt,
    b"record_shape(",
    emitter.b,
    b"s, [",
    join(shapes, b", "),
    b"])}",
  ])
}

/// A variant is its index among the declared constructors, then its fields in order.
fn bin_sum(
  emitter: DeriveEmitter,
  def: TypeDef,
  variants: List<VariantDef>,
  target: Bytes,
) -> Bytes / {abort.raise} = {
  let count = len(variants);
  let arms = map(range(0, count), |vi: Int| {
    let v = at(variants, vi);
    let binders = map(range(0, len(v.fields)), |i: Int| bytes_concat(emitter.b, ascii_of_int(i)));
    let pat = if len(binders) == 0 { v.name.name }
    else { bytes_concat_all([v.name.name, b"(", join(binders, b", "), b")"]) };
    let tagged = bytes_concat_all([
      emitter.rt,
      b"put_tag(",
      emitter.b,
      b"w, ",
      ascii_of_int(vi),
      b")",
    ]);
    let body = fold(range(0, len(v.fields)), tagged, |acc: Bytes, i: Int|
      bin_put(emitter, at(v.fields, i), acc, at(binders, i)));
    bytes_concat_all([pat, b" -> ", body])
  });
  let cases = map(range(0, count), |vi: Int| {
    let v = at(variants, vi);
    let args = if len(v.fields) == 0 { b"" }
    else { bytes_concat_all([b"(", join(values_of(emitter, len(v.fields)), b", "), b")"]) };
    bytes_concat_all([
      if vi == count - 1 { b"_" } else { ascii_of_int(vi) },
      b" -> ",
      bin_takes(
        emitter,
        v.fields,
        bytes_concat(emitter.b, b"t.at"),
        bytes_concat(v.name.name, args),
      ),
    ])
  });
  let shapes = map(variants, |v: VariantDef|
    bytes_concat_all([
      b"{name: \"",
      v.name.name,
      b"\", fields: [",
      shapes_of(emitter, v.fields),
      b"]}",
    ]));
  let params = join(
    map(def.generics.types, |ident: Ident| bytes_concat(ident.name, b".shape")),
    b", ",
  );
  bytes_concat_all([
    b"{put: |",
    emitter.b,
    b"w: Bytes, ",
    emitter.b,
    b"v: ",
    target,
    b"| match ",
    emitter.b,
    b"v {",
    join(arms, b", "),
    b"}, take: |",
    emitter.b,
    b"d: Bytes, ",
    emitter.b,
    b"n: Int| match ",
    emitter.rt,
    b"take_tag(",
    emitter.b,
    b"d, ",
    emitter.b,
    b"n, ",
    ascii_of_int(count),
    b") {Err(",
    emitter.b,
    b"e) -> Err(",
    emitter.b,
    b"e), Ok(",
    emitter.b,
    b"t) -> match ",
    emitter.b,
    b"t.value {",
    join(cases, b", "),
    b"}}, shape: |",
    emitter.b,
    b"s: ",
    emitter.rt,
    b"Shapes| ",
    emitter.rt,
    b"sum_shape(",
    emitter.b,
    b"s, \"",
    emitter.path,
    b".",
    def.name.name,
    b"\", \"",
    def.name.name,
    b"\", [",
    params,
    b"], [",
    join(shapes, b", "),
    b"])}",
  ])
}

/// A type back as source, for the annotations a generated lambda needs.
pub fn render_type(ty: TypeExpr) -> Bytes / {abort.raise} =
  match ty {
    TVar(i) -> i.name,
    TUnit(_) -> b"()",
    TBad(_) -> b"()",
    TCon(c) ->
      bytes_concat(
        qname_text(c.name),
        angled(map(c.args, render_type), ident_names(c.labels), map(c.rows, render_row)),
      ),
    TRecord(r) ->
      bytes_concat_all([
        b"{",
        join(
          map(r.fields, |f: { name: Ident, ty: TypeExpr }|
            bytes_concat_all([f.name.name, b": ", render_type(f.ty)])),
          b", ",
        ),
        b"}",
      ]),
    TFn(f) -> {
      let row = match f.effects { Some(r) -> bytes_concat(b" / ", render_row(r)), None -> b"" };
      bytes_concat_all([
        b"(",
        join(map(f.params, render_type), b", "),
        b") -> ",
        render_type(f.ret),
        row,
      ])
    },
  }

fn render_row(row: RowExpr) -> Bytes / {abort.raise} = {
  let atoms = join(map(row.atoms, render_atom), b", ");
  match row.tail {
    Some(t) -> bytes_concat_all([b"{", atoms, b" | ", t.name, b"}"]),
    None -> bytes_concat_all([b"{", atoms, b"}"]),
  }
}

fn render_atom(atom: AtomExpr) -> Bytes = {
  let resource = if atom.every { b"[*]" }
  else { match atom.resource { Some(r) -> bytes_concat_all([b"[", r.name, b"]"]), None -> b"" } };
  bytes_concat_all([
    qname_text(atom.eff),
    b".",
    match atom.op { Some(o) -> o.name, None -> mode_text(atom.mode) },
    resource,
  ])
}

// --- Every span in a generated definition becomes the `derive` item's ----------------------------

fn ident_at(ident: Ident, span: Span) -> Ident = { name: ident.name, span: span }

fn qname_at(qname: QName, span: Span) -> QName =
  {
    module: match qname.module { Some(m) -> Some(ident_at(m, span)), None -> None },
    name: ident_at(qname.name, span),
    span: span,
  }

fn opt_ident_at(o: Option<Ident>, span: Span) -> Option<Ident> =
  match o { Some(i) -> Some(ident_at(i, span)), None -> None }

fn retarget_fn(def: FnDef, span: Span) -> FnDef =
  {
    vis: def.vis,
    name: ident_at(def.name, span),
    generics: {
      types: map(def.generics.types, |ident: Ident| ident_at(ident, span)),
      effects: map(def.generics.effects, |ident: Ident| ident_at(ident, span)),
      labels: map(def.generics.labels, |ident: Ident| ident_at(ident, span)),
    },
    params: map(def.params, |param: Param| retarget_param(param, span)),
    ret: match def.ret { Some(t) -> Some(retarget_ty(t, span)), None -> None },
    effects: match def.effects { Some(r) -> Some(retarget_row(r, span)), None -> None },
    constraints: map(def.constraints, |c: Constraint|
      { deriver: c.deriver, deriver_span: span, param: ident_at(c.param, span), span: span }),
    spec: map(def.spec, |c: SpecClause|
      { kind: c.kind, expr: retarget_expr(c.expr, span), span: span }),
    returns: def.returns,
    reuse: def.reuse,
    transparent: def.transparent,
    baked: def.baked,
    decreases: match def.decreases { Some(e) -> Some(retarget_expr(e, span)), None -> None },
    body: retarget_expr(def.body, span),
    doc: def.doc,
    span: span,
  }

/// A parameter's default is deliberately not retargeted.
fn retarget_param(param: Param, span: Span) -> Param =
  {
    name: ident_at(param.name, span),
    ty: match param.ty { Some(t) -> Some(retarget_ty(t, span)), None -> None },
    cost: param.cost,
    default: param.default,
    span: span,
  }

fn retarget_ty(t: TypeExpr, span: Span) -> TypeExpr =
  match t {
    TVar(i) -> TVar(ident_at(i, span)),
    TCon(c) ->
      TCon({
        span: span,
        name: qname_at(c.name, span),
        args: map(c.args, |a: TypeExpr| retarget_ty(a, span)),
        labels: map(c.labels, |l: Ident| ident_at(l, span)),
        rows: map(c.rows, |r: RowExpr| retarget_row(r, span)),
      }),
    TFn(f) ->
      TFn({
        span: span,
        params: map(f.params, |p: TypeExpr| retarget_ty(p, span)),
        ret: retarget_ty(f.ret, span),
        effects: match f.effects { Some(r) -> Some(retarget_row(r, span)), None -> None },
      }),
    TRecord(r) ->
      TRecord({
        span: span,
        fields: map(r.fields, |f: { name: Ident, ty: TypeExpr }|
          { name: ident_at(f.name, span), ty: retarget_ty(f.ty, span) }),
      }),
    TUnit(_) -> TUnit({ span: span }),
    TBad(_) -> TBad({ span: span }),
  }

fn retarget_row(row: RowExpr, span: Span) -> RowExpr =
  {
    atoms: map(row.atoms, |atom: AtomExpr|
      {
        eff: qname_at(atom.eff, span),
        mode: atom.mode,
        op: opt_ident_at(atom.op, span),
        resource: opt_ident_at(atom.resource, span),
        every: atom.every,
        bounded: atom.bounded,
        span: span,
      }),
    aliases: map(row.aliases, |qname: QName| qname_at(qname, span)),
    tail: opt_ident_at(row.tail, span),
    tail_bounded: row.tail_bounded,
    span: span,
  }

fn retarget_opt_expr(expr: Option<Expr>, span: Span) -> Option<Expr> =
  match expr { Some(e) -> Some(retarget_expr(e, span)), None -> None }

fn retarget_field(field: RecField, span: Span) -> RecField =
  { name: ident_at(field.name, span), value: retarget_expr(field.value, span) }

fn retarget_expr(e: Expr, span: Span) -> Expr =
  match e {
    ELit(l) -> ELit({ span: span, lit: l.lit }),
    EVar(v) -> EVar({ span: span, name: qname_at(v.name, span) }),
    EBinary(b) ->
      EBinary({
        span: span,
        op: b.op,
        lhs: retarget_expr(b.lhs, span),
        rhs: retarget_expr(b.rhs, span),
      }),
    EUnary(u) -> EUnary({ span: span, op: u.op, operand: retarget_expr(u.operand, span) }),
    // A lambda's written return type is deliberately not retargeted.
    ELambda(l) ->
      ELambda({
        span: span,
        body: retarget_expr(l.body, span),
        params: map(l.params, |p: Param| retarget_param(p, span)),
        ret: l.ret,
      }),
    EApp(a) ->
      EApp({
        span: span,
        func: retarget_expr(a.func, span),
        named: map(a.named, |arg: NamedArg|
          { name: arg.name, value: retarget_expr(arg.value, span), span: arg.span }),
        args: map(a.args, |x: Expr| retarget_expr(x, span)),
        labels: map(a.labels, |l: Ident| ident_at(l, span)),
      }),
    EIf(i) ->
      EIf({
        span: span,
        cond: retarget_expr(i.cond, span),
        then_branch: retarget_expr(i.then_branch, span),
        else_branch: retarget_expr(i.else_branch, span),
      }),
    EMatch(m) ->
      EMatch({
        span: span,
        scrutinee: retarget_expr(m.scrutinee, span),
        arms: map(m.arms, |arm: MatchArm|
          {
            pat: retarget_pat(arm.pat, span),
            guard: retarget_opt_expr(arm.guard, span),
            body: retarget_expr(arm.body, span),
            span: span,
          }),
      }),
    EBlock(b) ->
      EBlock({
        span: span,
        tail: retarget_opt_expr(b.tail, span),
        stmts: map(b.stmts, |stmt: Stmt|
          match stmt {
            SLet(l) ->
              SLet({
                span: span,
                pat: retarget_pat(l.pat, span),
                ty: match l.ty { Some(t) -> Some(retarget_ty(t, span)), None -> None },
                value: retarget_expr(l.value, span),
              }),
            SLetElse(l) ->
              SLetElse({
                span: span,
                pat: retarget_pat(l.pat, span),
                ty: match l.ty { Some(t) -> Some(retarget_ty(t, span)), None -> None },
                value: retarget_expr(l.value, span),
                fallback: retarget_expr(l.fallback, span),
              }),
            SExpr(x) -> SExpr(retarget_expr(x, span)),
          }),
      }),
    ERecord(r) ->
      ERecord({ span: span, fields: map(r.fields, |f: RecField| retarget_field(f, span)) }),
    ERecordUpdate(r) ->
      ERecordUpdate({
        span: span,
        base: retarget_expr(r.base, span),
        fields: map(r.fields, |f: RecField| retarget_field(f, span)),
      }),
    ETry(t) -> ETry({ span: span, operand: retarget_expr(t.operand, span) }),
    EField(f) ->
      EField({ span: span, base: retarget_expr(f.base, span), field: ident_at(f.field, span) }),
    EList(l) -> EList({ span: span, items: map(l.items, |x: Expr| retarget_expr(x, span)) }),
    EPerform(p) ->
      EPerform({
        span: span,
        eff: qname_at(p.eff, span),
        op: ident_at(p.op, span),
        resource: opt_ident_at(p.resource, span),
        args: map(p.args, |x: Expr| retarget_expr(x, span)),
      }),
    EHandle(h) ->
      EHandle({
        span: span,
        body: retarget_expr(h.body, span),
        ret: match h.ret {
          Some(rc) ->
            Some({
              binder: ident_at(rc.binder, span),
              body: retarget_expr(rc.body, span),
              span: span,
            }),
          None -> None,
        },
        clauses: map(h.clauses, |c: HandleClause|
          {
            eff: qname_at(c.eff, span),
            op: ident_at(c.op, span),
            resource: opt_ident_at(c.resource, span),
            every_label: c.every_label,
            label_binder: opt_ident_at(c.label_binder, span),
            resume: opt_ident_at(c.resume, span),
            body: retarget_expr(c.body, span),
            span: span,
            params: map(c.params, |p: Ident| ident_at(p, span)),
          }),
      }),
    EWithCell(c) ->
      EWithCell({
        span: span,
        resource: ident_at(c.resource, span),
        init: retarget_expr(c.init, span),
        binder: ident_at(c.binder, span),
        body: retarget_expr(c.body, span),
      }),
    ESimulate(x) -> ESimulate({ span: span, body: retarget_expr(x.body, span) }),
    EParallel(x) ->
      EParallel({ span: span, branches: map(x.branches, |b: Expr| retarget_expr(b, span)) }),
    ETagged(t) ->
      ETagged({
        ..t,
        span: span,
        tag: ident_at(t.tag, span),
        quoted: span,
        holes: map(t.holes, |h: Hole|
          { value: retarget_expr(h.value, span), text: h.text, quoted: span }),
      }),
    EBad(_) -> EBad({ span: span }),
    ETryBlock(x) -> ETryBlock({ ..x, span: span, body: retarget_expr(x.body, span) }),
  }

fn retarget_pat(p: Pattern, span: Span) -> Pattern =
  match p {
    PWild(_) -> PWild({ span: span }),
    PVar(v) -> PVar({ span: span, name: ident_at(v.name, span) }),
    PLit(l) -> PLit({ span: span, lit: l.lit }),
    PRange(r) -> PRange({ ..r, span: span }),
    PCtor(c) ->
      PCtor({
        span: span,
        name: qname_at(c.name, span),
        args: map(c.args, |a: Pattern| retarget_pat(a, span)),
      }),
    PRecord(r) ->
      PRecord({
        span: span,
        rest: r.rest,
        fields: map(r.fields, |f: { name: Ident, pat: Pattern }|
          { name: ident_at(f.name, span), pat: retarget_pat(f.pat, span) }),
      }),
    PList(l) ->
      PList({
        span: span,
        rest: match l.rest { Some(r) -> Some(retarget_pat(r, span)), None -> None },
        items: map(l.items, |i: Pattern| retarget_pat(i, span)),
      }),
    POr(o) -> POr({ span: span, alts: map(o.alts, |a: Pattern| retarget_pat(a, span)) }),
    PBad(_) -> PBad({ span: span }),
  }

// --- The expander --------------------------------------------------------------------------------

type Runtime = { wanted: Bytes, prefix: Bytes, added: Option<ImportDecl> }
type Claimed = { name: Bytes, def: DeriveDef }
type Generated = { source: Bytes, defs: List<FnDef>, derived: Derived }
type Expander = {
  m: Int,
  path: Bytes,
  module: Module,
  types: List<TypeDef>,
  aliases: List<Alias>,
  claimed: List<Claimed>,
  generated: List<Generated>,
  runtimes: List<Runtime>,
  diags: List<Diag>,
}
type WithPrefix = { ex: Expander, prefix: Option<Bytes> }

pub type Expansion = { module: Module, derived: List<Derived>, diags: List<Diag> }

fn report(expander: Expander, diag: Diag) -> Expander =
  { ..expander, diags: push(expander.diags, diag) }

fn find_claimed(xs: List<Claimed>, name: Bytes) -> Option<DeriveDef> =
  fold(xs, None, |acc: Option<DeriveDef>, claimed: Claimed|
    match acc {
      Some(_) -> acc,
      None -> if claimed.name == name { Some(claimed.def) } else { None },
    })

fn find_runtime(xs: List<Runtime>, wanted: Bytes) -> Option<Runtime> =
  fold(xs, None, |acc: Option<Runtime>, runtime: Runtime|
    match acc {
      Some(_) -> acc,
      None -> if runtime.wanted == wanted { Some(runtime) } else { None },
    })

fn dotted(decl: ImportDecl) -> Bytes / {abort.raise} =
  join(map(decl.path, |ident: Ident| ident.name), b".")

fn find_import(imports: List<ImportDecl>, wanted: Bytes) -> Option<ImportDecl> / {abort.raise} =
  fold(imports, None, |acc: Option<ImportDecl>, decl: ImportDecl|
    match acc { Some(_) -> acc, None -> if dotted(decl) == wanted { Some(decl) } else { None } })

/// The hidden import an interpolating module gets has no binder generated source can spell.
fn import_binder(decl: ImportDecl) -> Option<Bytes> / {abort.raise} =
  match decl.kind {
    IModule -> if len(decl.path) == 0 { None }
    else { Some(at(decl.path, len(decl.path) - 1).name) },
    IAlias(a) -> if hidden_binder(a.name) { None } else { Some(a.name) },
    INames(_) -> None,
  }

fn eq_ignore_case(a: Bytes, b: Bytes) -> Bool / {abort.raise} =
  bytes_len(a) == bytes_len(b)
    && fold(range(0, bytes_len(a)), true, |acc: Bool, i: Int|
      acc && lower_byte(bytes_at(a, i)) == lower_byte(bytes_at(b, i)))

/// Each table keeps the first of a name on its own, so an alias may follow a same-named sum type.
fn new_expander(m: Int, path: Bytes, module: Module) -> Expander = {
  let walked = fold(
    module.items,
    { types: [], aliases: [] },
    |acc: { types: List<TypeDef>, aliases: List<Alias> }, item: Item|
      match item {
        IType(d) -> {
          let types = match find_type(acc.types, d.name.name) {
            Some(_) -> acc.types,
            None -> push(acc.types, d),
          };
          let aliases = match d.body {
            TDAlias(body) -> if !is_generic(d.generics)
                && (match find_alias(acc.aliases, d.name.name) { Some(_) -> false, None -> true }) {
              push(acc.aliases, { name: d.name.name, body: body })
            } else { acc.aliases },
            _ -> acc.aliases,
          };
          { types: types, aliases: aliases }
        },
        _ -> acc,
      },
  );
  {
    m: m,
    path: path,
    module: module,
    types: walked.types,
    aliases: walked.aliases,
    claimed: [],
    generated: [],
    runtimes: [],
    diags: [],
  }
}

fn run_expander(expander: Expander) -> Expander / {abort.raise} =
  fold(expander.module.items, expander, |acc: Expander, item: Item|
    match item { IDerive(def) -> unlabelled(acc, def), _ -> acc })

// A target that binds a label is refused before its fields are read.
fn unlabelled(expander: Expander, def: DeriveDef) -> Expander / {abort.raise} =
  match find_type(expander.types, def.target.name) {
    None -> one(expander, def),
    Some(target) -> match list_at(target.generics.labels, 0) {
      None -> one(expander, def),
      Some(label) ->
        report(
          expander,
          error_at_and(
            b"E0206",
            expander.m,
            label.span,
            bytes_concat_all([
              b"`",
              deriver_text(def.deriver),
              b"` cannot be derived for `",
              def.target.name,
              b"`",
            ]),
            label_refusal(),
            expander.m,
            def.span,
            b"required by this derivation",
            [
              bytes_concat_all([
                b"a label is what a function's row performs under, and a type that holds a function has no derivation, so `[",
                label.name,
                b"]` is used by no field a derivation could read",
              ]),
              bytes_concat_all([
                b"drop `[",
                label.name,
                b"]` from `",
                def.target.name,
                b"`, or write the dictionary by hand",
              ]),
            ],
          ),
        ),
    },
  }

fn one(expander: Expander, def: DeriveDef) -> Expander / {abort.raise} =
  match find_type(expander.types, def.target.name) {
    None -> orphan(expander, def),
    Some(target) -> {
      let name = generated_name(def.deriver, def.target.name);
      match find_claimed(expander.claimed, name) {
        Some(prev) -> collision(expander, def, prev, name),
        None -> match if has_instance(expander.module, def.deriver, def.target.name) { None }
          else { check_decl(def.deriver, target) } {
          Some(blocker) -> not_derivable(expander, def, blocker),
          None -> {
            let rt: WithPrefix = runtime_prefix(expander, def);
            let ex1: Expander = rt.ex;
            match rt.prefix {
              None -> ex1,
              Some(prefix) -> {
                let cycle = cycle_of(codec_calls(ex1, def.deriver), def.target.name);
                let source = emit_item(
                  emitter(def.deriver, prefix, target.generics.types, ex1.aliases, ex1.path, cycle),
                  target,
                );
                match parse_generated(source, def.span, if len(cycle) == 0 { 1 } else { 2 }) {
                  None -> internal(ex1, def, source),
                  Some(defs) ->
                    {
                      ..ex1,
                      claimed: push(ex1.claimed, { name: name, def: def }),
                      generated: push(ex1.generated, {
                        source: source,
                        defs: defs,
                        derived: { deriver: def.deriver, target: def.target.name, span: def.span },
                      }),
                    },
                }
              },
            }
          },
        },
      }
    },
  }

/// Parsing what was just printed is the deriver's own round-trip check.
fn parse_generated(source: Bytes, span: Span, count: Int) -> Option<List<FnDef>> / {abort.raise} = {
  let r = parse(source);
  let x = expand(r.node, r.parser.diags);
  let defs = fold(x.module.items, [], |acc: List<FnDef>, item: Item|
    match item { IFn(d) -> push(acc, retarget_fn(d, span)), _ -> acc });
  if len(x.diags) > 0 || len(x.module.items) != count || len(defs) != count { None }
  else { Some(defs) }
}

// --- Codecs on a cycle ---------------------------------------------------------------------------

/// A type this module derives with a codec deriver, and the derived types its codec calls by name.
type Calls = { name: Bytes, calls: List<Bytes> }

fn codec_calls(expander: Expander, deriver: Deriver) -> List<Calls> =
  match deriver {
    DJson -> derived_calls(expander, deriver),
    DBin -> derived_calls(expander, deriver),
    _ -> [],
  }

fn derived_calls(expander: Expander, deriver: Deriver) -> List<Calls> = {
  let targets = fold(expander.module.items, [], |acc: List<TypeDef>, item: Item|
    match item {
      IDerive(def) -> if !same_deriver(def.deriver, deriver) { acc } else {
        match find_type(expander.types, def.target.name) { Some(t) -> push(acc, t), None -> acc }
      },
      _ -> acc,
    });
  let names = map(targets, |t: TypeDef| t.name.name);
  map(targets, |t: TypeDef|
    { name: t.name.name, calls: filter(named_in_def(deriver, t), |n: Bytes| contains(names, n)) })
}

fn named_in_def(deriver: Deriver, type_def: TypeDef) -> List<Bytes> =
  match type_def.body {
    TDAlias(body) -> named_in(deriver, body),
    TDNominal(body) -> named_in(deriver, body),
    TDSum(variants) ->
      fold(variants, [], |acc: List<Bytes>, variant: VariantDef|
        fold(variant.fields, acc, |inner: List<Bytes>, ty: TypeExpr|
          concat(inner, named_in(deriver, ty)))),
  }

/// The types `codec` composes through by a name of this module's.
fn named_in(deriver: Deriver, te: TypeExpr) -> List<Bytes> =
  match te {
    TCon(c) -> {
      let inner = fold(c.args, [], |acc: List<Bytes>, a: TypeExpr|
        concat(acc, named_in(deriver, a)));
      match constructor_shape(deriver, c.name.name.name) {
        Nominal -> if is_bare(c.name) { push(inner, c.name.name.name) } else { inner },
        _ -> inner,
      }
    },
    TRecord(r) ->
      fold(r.fields, [], |acc: List<Bytes>, f: { name: Ident, ty: TypeExpr }|
        concat(acc, named_in(deriver, f.ty))),
    _ -> [],
  }

fn callees(calls: List<Calls>, name: Bytes) -> List<Bytes> =
  fold(calls, [], |acc: List<Bytes>, c: Calls|
    if c.name == name { concat(acc, c.calls) } else { acc })

/// Every type a chain of one or more calls leads to from `from`: no chain is longer than the types.
fn reached(calls: List<Calls>, from: Bytes) -> List<Bytes> =
  fold(range(0, len(calls)), callees(calls, from), |seen: List<Bytes>, _: Int|
    fold(seen, seen, |acc: List<Bytes>, n: Bytes|
      fold(callees(calls, n), acc, |more: List<Bytes>, m: Bytes|
        if contains(more, m) { more } else { push(more, m) })))

/// Empty unless `target`'s codec calls itself, through any of the others.
fn cycle_of(calls: List<Calls>, target: Bytes) -> List<Bytes> =
  filter(reached(calls, target), |n: Bytes| contains(reached(calls, n), target))

/// How this module writes a name that lives in the deriver's runtime module.
fn runtime_prefix(expander: Expander, def: DeriveDef) -> WithPrefix / {abort.raise} =
  match runtime_module(def.deriver) {
    None -> { ex: expander, prefix: Some(b"") },
    Some(wanted) -> match find_runtime(expander.runtimes, wanted) {
      Some(r) -> { ex: expander, prefix: Some(r.prefix) },
      None -> match find_import(expander.module.imports, wanted) {
        None ->
          {
            ex: report(
              expander,
              error_at(
                b"E0206",
                expander.m,
                def.span,
                bytes_concat_all([
                  b"`",
                  deriver_text(def.deriver),
                  b"` cannot be derived here: this module does not import `",
                  wanted,
                  b"`",
                ]),
                bytes_concat_all([b"needs `", wanted, b"`"]),
                [
                  bytes_concat_all([
                    b"add `import ",
                    wanted,
                    b"` \xe2\x80\x94 the dictionary type and the codecs a derivation composes with ship there",
                  ]),
                ],
              ),
            ),
            prefix: None,
          },
        Some(decl) -> {
          let bound: { binder: Bytes, added: Option<ImportDecl> } = match import_binder(decl) {
            Some(b) -> { binder: b, added: None },
            None -> {
              let b = free_binder(expander, def.deriver);
              let span = path_span(decl);
              {
                binder: b,
                added: Some({
                  path: map(runtime_path(def.deriver), |s: Bytes| { name: s, span: span }),
                  kind: IAlias({ name: b, span: span }),
                  span: span,
                }),
              }
            },
          };
          let prefix = bytes_concat(bound.binder, b"::");
          {
            ex: {
              ..expander,
              runtimes: push(expander.runtimes, {
                wanted: wanted,
                prefix: prefix,
                added: bound.added,
              }),
            },
            prefix: Some(prefix),
          }
        },
      },
    },
  }

/// A module binder nothing in this file already binds.
fn free_binder(expander: Expander, deriver: Deriver) -> Bytes / {abort.raise} = {
  let path = runtime_path(deriver);
  let base = if len(path) == 0 { b"" } else { at(path, len(path) - 1) };
  iterate(base, len(expander.module.imports) + len(expander.runtimes) + 2, |x: Bytes| {
    let by_import = fold(expander.module.imports, false, |acc: Bool, decl: ImportDecl|
      acc || (match import_binder(decl) { Some(b) -> b == x, None -> false }));
    let by_runtime = fold(expander.runtimes, false, |acc: Bool, runtime: Runtime|
      acc || runtime.prefix == bytes_concat(x, b"::"));
    if by_import || by_runtime { Continue(bytes_concat(x, b"_")) } else { Stop(x) }
  })
}

fn orphan(expander: Expander, def: DeriveDef) -> Expander / {abort.raise} = {
  let near = fold(expander.types, None, |acc: Option<Bytes>, type_def: TypeDef|
    match acc {
      Some(_) -> acc,
      None -> if eq_ignore_case(type_def.name.name, def.target.name) { Some(type_def.name.name) }
      else { None },
    });
  let notes = [
    b"a `derive` may only name a type its own module declares, so that one type has one canonical encoding rather than one per module that thought of it",
  ];
  report(
    expander,
    error_at(
      b"E0208",
      expander.m,
      def.target.span,
      bytes_concat_all([b"`", def.target.name, b"` is not a type this module declares"]),
      b"declared in another module, or not at all",
      match near {
        Some(n) -> push(notes, bytes_concat_all([b"this module declares `", n, b"`"])),
        None -> notes,
      },
    ),
  )
}

fn collision(expander: Expander, def: DeriveDef, prev: DeriveDef, name: Bytes) -> Expander = {
  let note = if prev.target.name == def.target.name {
    bytes_concat_all([
      b"`derive ",
      deriver_text(def.deriver),
      b" for ",
      def.target.name,
      b"` is already written above; remove one",
    ])
  } else {
    bytes_concat_all([
      b"`",
      prev.target.name,
      b"` and `",
      def.target.name,
      b"` both name `",
      name,
      b"`; rename one of the types",
    ])
  };
  report(
    expander,
    error_at_and(
      b"E0105",
      expander.m,
      def.span,
      bytes_concat_all([b"`", name, b"` is generated twice"]),
      b"this derivation generates it",
      expander.m,
      prev.span,
      b"and so does this one",
      [note],
    ),
  )
}

fn not_derivable(expander: Expander, def: DeriveDef, blocker: Blocker) -> Expander = {
  let head = bytes_concat_all([
    b"`derive ",
    deriver_text(def.deriver),
    b" for ",
    def.target.name,
    b"` requires every field to be derivable",
  ]);
  let with_note = match blocker.note { Some(n) -> [head, n], None -> [head] };
  let with_variant = match blocker.variant {
    Some(v) -> push(with_note, bytes_concat_all([b"the field is in variant `", v, b"`"])),
    None -> with_note,
  };
  let notes = push(
    with_variant,
    bytes_concat_all([
      b"remove the field from `",
      def.target.name,
      b"`, or write the dictionary by hand",
    ]),
  );
  report(
    expander,
    error_at_and(
      b"E0206",
      expander.m,
      blocker.span,
      bytes_concat_all([
        b"`",
        deriver_text(def.deriver),
        b"` cannot be derived for `",
        def.target.name,
        b"`",
      ]),
      blocker.reason,
      expander.m,
      def.span,
      b"required by this derivation",
      notes,
    ),
  )
}

fn internal(expander: Expander, def: DeriveDef, source: Bytes) -> Expander =
  report(
    expander,
    error_at(
      b"E0505",
      expander.m,
      def.span,
      bytes_concat_all([
        b"the `",
        deriver_text(def.deriver),
        b"` deriver generated a definition that does not parse",
      ]),
      b"this derivation",
      [
        b"this is a compiler bug: derivation is total, so generation cannot fail",
        bytes_concat(b"it generated: ", source),
      ],
    ),
  )

/// Appends the generated definitions and any import a runtime module needed; `path` names the module.
pub fn expand_derives(m: Int, path: Bytes, module: Module) -> Expansion / {abort.raise} =
  if !fold(module.items, false, |b: Bool, item: Item|
      b || (match item { IDerive(_) -> true, _ -> false })) {
    { module: module, derived: [], diags: [] }
  } else {
    let ex = run_expander(new_expander(m, path, module));
    let added = fold(ex.runtimes, [], |acc: List<ImportDecl>, runtime: Runtime|
      match runtime.added { Some(i) -> push(acc, i), None -> acc });
    {
      module: {
        doc: module.doc,
        imports: concat(module.imports, added),
        items: fold(ex.generated, module.items, |acc: List<Item>, generated: Generated|
          concat(acc, map(generated.defs, |def: FnDef| IFn(def)))),
      },
      derived: map(ex.generated, |generated: Generated| generated.derived),
      diags: ex.diags,
    }
  }

/// The source each of this module's derivations generates, in `derive` order.
pub fn preview(path: Bytes, module: Module) -> List<Bytes> / {abort.raise} =
  map(run_expander(new_expander(0, path, module)).generated, |generated: Generated|
    generated.source)

/// Each module expanded on its own: its generated sources length-prefixed, then its diagnostics.
pub fn derive_dump(sources: List<Source>) -> String / {abort.raise} = {
  let out = fold(range(0, len(sources)), b"", |acc: Bytes, i: Int| {
    let s = at(sources, i);
    let r = parse(s.src);
    let x = expand(r.node, r.parser.diags);
    let generated = preview(s.name, x.module);
    let d: Expansion = expand_derives(i, s.name, x.module);
    bytes_concat_all([
      acc,
      b"M;",
      ascii_of_int(len(generated)),
      b";",
      bytes_concat_all(
        map(generated, |g: Bytes| bytes_concat_all([b"S;", ascii_of_int(bytes_len(g)), b";", g])),
      ),
      dump_diags(d.diags),
    ])
  });
  string_of_bytes(out)
}

// --- Tests ------------------------------------------------------------------

test "snake_case follows the rule, acronyms included" {
  assert_eq(snake_case(b"Order"), b"order");
  assert_eq(snake_case(b"OrderLine"), b"order_line");
  assert_eq(snake_case(b"HTTPRequest"), b"http_request");
  assert_eq(snake_case(b"HttpRequest"), b"http_request");
  assert_eq(snake_case(b"Order2Line"), b"order2_line");
  assert_eq(snake_case(b"A"), b"a");
  assert_eq(generated_name(DJson, b"OrderLine"), b"order_line_json")
}

test "the generated form is pinned to the reference's golden output" {
  let src = b"import std.json\ntype Order = {id: Int, lines: List<Line>}\ntype Line = {sku: String}\ntype Status = Placed | Shipped(Int)\nderive json for Order\nderive eq for Line\nderive ord for Line\nderive json for Status";
  let out = preview(b"t", parse(src).node);
  assert_eq(len(out), 4);
  assert_eq(
    at(out, 0),
    b"fn order_json() -> json::JsonCodec<Order> = {encode: |dv: Order| json::object([{key: \"id\", value: (json::int_json().encode)(dv.id)}, {key: \"lines\", value: (json::list_json(line_json()).encode)(dv.lines)}]), decode: |dj: json::Json| match json::field(dj, \"id\", json::int_json()) {Err(de) -> Err(de), Ok(d0) -> match json::field(dj, \"lines\", json::list_json(line_json())) {Err(de) -> Err(de), Ok(d1) -> Ok({id: d0, lines: d1})}}}",
  );
  assert_eq(
    at(out, 1),
    b"fn line_eq() -> {eq: (Line, Line) -> Bool} = {eq: |da: Line, db: Line| da == db}",
  );
  assert_eq(
    at(out, 2),
    b"fn line_ord() -> {compare: (Line, Line) -> Ordering} = {compare: |da: Line, db: Line| compare_values(da, db)}",
  );
  assert_eq(
    at(out, 3),
    b"fn status_json() -> json::JsonCodec<Status> = {encode: |dv: Status| match dv {Placed -> json::variant(\"Placed\", []), Shipped(d0) -> json::variant(\"Shipped\", [(json::int_json().encode)(d0)])}, decode: |dj: json::Json| match json::variant_of(dj) {Err(de) -> Err(de), Ok(dt) -> if dt.tag == \"Placed\" {Ok(Placed)} else {if dt.tag == \"Shipped\" {match json::decode_and_then(json::variant_value(dt, 0), json::int_json().decode) {Err(de) -> Err(de), Ok(d0) -> Ok(Shipped(d0))}} else {json::unknown_variant(dt.tag, [\"Placed\", \"Shipped\"])}}}}",
  )
}

test "the bin form writes scalars straight, composes the rest, and keys a sum by its module" {
  let src = b"import std.bin\ntype Line = {sku: String, qty: U32, tags: List<String>}\ntype Tree<a> = Leaf | Node(Tree<a>, a)\nderive bin for Line\nderive bin for Tree";
  let out = preview(b"shop", parse(src).node);
  assert_eq(len(out), 2);
  assert_eq(
    at(out, 0),
    b"fn line_bin() -> bin::BinCodec<Line> = {put: |dw: Bytes, dv: Line| (bin::list_bin(bin::string_bin()).put)(bin::put_u32(bin::put_string(dw, dv.sku), dv.qty), dv.tags), take: |dd: Bytes, dn: Int| match bin::take_string(dd, dn) {Err(de) -> Err(de), Ok(d0) -> match bin::take_u32(dd, d0.at) {Err(de) -> Err(de), Ok(d1) -> match (bin::list_bin(bin::string_bin()).take)(dd, d1.at) {Err(de) -> Err(de), Ok(d2) -> Ok({value: {sku: d0.value, qty: d1.value, tags: d2.value}, at: d2.at})}}}, shape: |ds: bin::Shapes| bin::record_shape(ds, [{name: \"sku\", shape: bin::string_bin().shape}, {name: \"qty\", shape: bin::u32_bin().shape}, {name: \"tags\", shape: bin::list_bin(bin::string_bin()).shape}])}",
  );
  assert_eq(
    at(out, 1),
    b"fn tree_bin<a>(a: bin::BinCodec<a>) -> bin::BinCodec<Tree<a>> where derivable(bin, a) = tree_bin_at(a, bin::max_depth())\nfn tree_bin_at<a>(a: bin::BinCodec<a>, ddepth: Int) -> bin::BinCodec<Tree<a>> where derivable(bin, a) = if ddepth <= 0 {bin::too_deep()} else {{put: |dw: Bytes, dv: Tree<a>| match dv {Leaf -> bin::put_tag(dw, 0), Node(d0, d1) -> (a.put)((tree_bin_at(a, ddepth - 1).put)(bin::put_tag(dw, 1), d0), d1)}, take: |dd: Bytes, dn: Int| match bin::take_tag(dd, dn, 2) {Err(de) -> Err(de), Ok(dt) -> match dt.value {0 -> Ok({value: Leaf, at: dt.at}), _ -> match (tree_bin_at(a, ddepth - 1).take)(dd, dt.at) {Err(de) -> Err(de), Ok(d0) -> match (a.take)(dd, d0.at) {Err(de) -> Err(de), Ok(d1) -> Ok({value: Node(d0.value, d1.value), at: d1.at})}}}}, shape: |ds: bin::Shapes| bin::sum_shape(ds, \"shop.Tree\", \"Tree\", [a.shape], [{name: \"Leaf\", fields: []}, {name: \"Node\", fields: [tree_bin_at(a, ddepth - 1).shape, a.shape]}])}}",
  )
}

test "a codec on a cycle hands the cycle one depth less, and calls a codec off it as written" {
  let src = b"import std.json\ntype Expr = Num(Int) | Block(List<Stmt>) | Lit(Literal)\ntype Stmt = Bare(Expr) | Let({name: String, value: Expr})\ntype Literal = Text(String)\nderive json for Expr\nderive json for Stmt\nderive json for Literal\nderive eq for Expr";
  let out = preview(b"t", parse(src).node);
  assert_eq(len(out), 4);
  let expr = at(out, 0);
  assert(
    bytes_starts_with(
      expr,
      b"fn expr_json() -> json::JsonCodec<Expr> = expr_json_at(json::max_depth())\nfn expr_json_at(ddepth: Int) -> json::JsonCodec<Expr> = if ddepth <= 0 {json::too_deep()} else {{encode:",
    ),
  );
  assert(bytes_index_of(expr, b"json::list_json(stmt_json_at(ddepth - 1))") != None);
  assert(bytes_index_of(expr, b"(literal_json().encode)") != None);
  assert(bytes_index_of(expr, b"json::has_tag(dt, \"Num\")") != None);
  assert(bytes_index_of(at(out, 2), b"dt.tag == \"Text\"") != None);
  assert(bytes_index_of(at(out, 1), b"(expr_json_at(ddepth - 1).encode)(dv.value)") != None);
  assert(bytes_index_of(at(out, 2), b"_at") == None);
  assert(bytes_index_of(at(out, 3), b"_at") == None);
  let x = expand_derives(0, b"t", parse(src).node);
  assert_eq(len(x.diags), 0);
  assert_eq(len(x.derived), 4);
  assert_eq(len(x.module.items), 7 + 2 + 2 + 1 + 1)
}

test "a selective import of std.json still writes a module binder, stepping around a taken name" {
  let src = b"import other.json\nimport std.json (JsonCodec, Json, object, field, int_json)\ntype Order = {id: Int}\nderive json for Order";
  let x = expand_derives(0, b"t", parse(src).node);
  assert_eq(len(x.diags), 0);
  assert_eq(len(x.module.imports), 3);
  assert(
    bytes_starts_with(
      at(preview(b"t", parse(src).node), 0),
      b"fn order_json() -> json_::JsonCodec<Order>",
    ),
  )
}

test "every span in a generated definition is the derive item's" {
  let src = b"import std.json\ntype Order = {id: Int}\nderive json for Order";
  let x = expand_derives(0, b"t", parse(src).node);
  assert_eq(len(x.derived), 1);
  let d = at(x.derived, 0);
  assert_eq(d.span, { start: 39, end: 60 });
  match at(x.module.items, len(x.module.items) - 1) {
    IFn(f) -> {
      assert_eq(f.span, d.span);
      assert_eq(f.name.span, d.span)
    },
    _ -> assert(false),
  }
}

test "a type that takes a row derives over it, and one that takes a label has no derivation" {
  let out = preview(
    b"t",
    parse(
      b"type Tagged<a | e> = | Tagged(a)\ntype Pair = {left: Tagged<Int | {}>}\nderive eq for Tagged\nderive eq for Pair",
    ).node,
  );
  assert_eq(
    at(out, 0),
    b"fn tagged_eq<a | e>(a: {eq: (a, a) -> Bool}) -> {eq: (Tagged<a | e>, Tagged<a | e>) -> Bool} where derivable(eq, a) = {eq: |da: Tagged<a | e>, db: Tagged<a | e>| da == db}",
  );
  let refused = |src: Bytes|
    map(expand_derives(0, b"t", parse(src).node).diags, |diag: Diag| {
      let primary = at(diag.labels, 0);
      [diag.code, bytes_slice(src, primary.start, primary.end)]
    });
  assert_eq(refused(b"type Tagged<a, [l]> = | Tagged(a)\nderive eq for Tagged"), [
    [b"E0206", b"l"],
  ]);
  assert_eq(
    refused(
      b"type Tagged<a, [l]> = | Tagged(a)\ntype Pair = {left: Tagged<Int, [conn]>}\nderive eq for Pair",
    ),
    [[b"E0206", b"left: Tagged<Int, [conn]>"]],
  )
}

test "an orphan, a collision, a missing runtime and a refused field each report as the reference does" {
  let orphan_ = expand_derives(0, b"t", parse(b"import std.json\nderive json for Order").node);
  assert_eq(map(orphan_.diags, |diag: Diag| diag.code), [b"E0208"]);
  let twice = expand_derives(
    0,
    b"t",
    parse(b"type Order = {id: Int}\nderive eq for Order\nderive eq for Order").node,
  );
  assert_eq(map(twice.diags, |diag: Diag| diag.code), [b"E0105"]);
  assert_eq(len(at(twice.diags, 0).labels), 2);
  let missing = expand_derives(
    0,
    b"t",
    parse(b"type Order = {id: Int}\nderive json for Order").node,
  );
  assert_eq(map(missing.diags, |diag: Diag| diag.code), [b"E0206"]);
  let refused = expand_derives(
    0,
    b"t",
    parse(
      b"import std.json\ntype Order = {id: Int, on_complete: (Int) -> Unit}\nderive json for Order",
    ).node,
  );
  assert_eq(map(refused.diags, |diag: Diag| diag.code), [b"E0206"]);
  let first = at(at(refused.diags, 0).labels, 0);
  assert_eq(first.start, 39);
  assert_eq(first.end, 65)
}
