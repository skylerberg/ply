// Front-end diagnostics in driver order, where a stage that reports stops the rest, as length-framed frames.

import spine (PDiag, Label, num)
import items (parse)
import rewrite (expand)
import derive (Expansion, expand_derives)
import resolve (Source, Mod, Diag, Edit, Fix, Outcome, Resolved_, Failed, resolve_modules, diag,
                with_fix, insertion)
import hash (build_index)
import infer (check_diagnostics)

fn at<a>(xs: List<a>, i: Int) -> a =
  match list_at(xs, i) { Some(x) -> x, None -> panic("an index the list does not hold") }

fn append<a>(a: List<a>, b: List<a>) -> List<a> = fold(b, a, |acc: List<a>, x: a| push(acc, x))

pub fn placed(module: Int, d: PDiag) -> Diag =
  {
    code: d.code,
    notes: d.notes,
    labels: map(d.labels, |l: Label|
      { module: module, start: l.start, end: l.end, primary: l.primary, text: l.text }),
    text: b"",
    message: d.message,
    notes_text: d.notes_text,
    severity: d.severity,
    fixes: [],
  }

pub type Parsed = { name: Bytes, module: Mod, diags: List<Diag> }

pub fn parse_all(sources: List<Source>) -> List<Parsed> =
  map(range(0, len(sources)), |i: Int| parse_at(i, at(sources, i)))

pub fn parse_at(i: Int, s: Source) -> Parsed = {
  let r = parse(s.src);
  let x = expand(r.node, r.p.uses_sets, r.p.diags);
  let front = map(x.diags, |d: PDiag| placed(i, d));
  if len(front) > 0 {
    { name: s.name, module: { name: s.name, module: x.module, derived: [] }, diags: front }
  } else {
    let d: Expansion = expand_derives(i, x.module);
    { name: s.name, module: { name: s.name, module: d.module, derived: d.derived }, diags: d.diags }
  }
}

pub fn diagnostics(sources: List<Source>) -> List<Diag> = {
  let parsed = parse_all(sources);
  let front = fold(parsed, [], |acc: List<Diag>, p: Parsed| append(acc, p.diags));
  if len(front) > 0 { front } else {
    let later = match resolve_modules(map(parsed, |p: Parsed| p.module)) {
      Failed(ds) -> ds,
      Resolved_(x) -> {
        let built = build_index(x.mods, x.r);
        if len(built.diags) > 0 { built.diags } else { check_diagnostics(x.r, x.mods) }
      },
    };
    map(later, outside_every_module)
  }
}

// The module index of a span outside every module.
fn no_module() -> Int = 4294967295

// A `(0, 0)` label is `dummy_span`, except on the module-name clash, which really sits at offset 0.
pub fn outside_every_module(d: Diag) -> Diag =
  if d.code == b"E0105" && bytes_starts_with(d.message, b"two files claim") { d } else {
    {
      code: d.code,
      notes: d.notes,
      labels: map(
        d.labels,
        |l: { module: Int, start: Int, end: Int, primary: Bool, text: Bytes }|
          if l.start == 0 && l.end == 0 {
            { module: no_module(), start: 0, end: 0, primary: l.primary, text: l.text }
          } else { l },
      ),
      text: d.text,
      message: d.message,
      notes_text: d.notes_text,
      severity: d.severity,
      fixes: d.fixes,
    }
  }

// --- The frames -------------------------------------------------------------

pub fn field(key: Bytes, payload: Bytes) -> Bytes =
  bytes_concat_all([key, b" ", num(bytes_len(payload)), b"\n", payload])

pub fn flag(b: Bool) -> Bytes = if b { b"1" } else { b"0" }

// `<kind> <name> <length>\n<payload>`: every protocol framed this way, the front end's dump included.
pub fn framed(kind: Bytes, name: Bytes, fields: List<Bytes>) -> Bytes = {
  let payload = bytes_concat_all(fields);
  bytes_concat_all([kind, b" ", name, b" ", num(bytes_len(payload)), b"\n", payload])
}

pub fn frame(index: Int, d: Diag) -> Bytes = {
  let head = [field(b"code", d.code), field(b"severity", d.severity), field(b"message", d.message)];
  let labels = map(
    d.labels,
    |l: { module: Int, start: Int, end: Int, primary: Bool, text: Bytes }|
      field(
        b"label",
        bytes_concat_all([
          num(l.module),
          b" ",
          num(l.start),
          b" ",
          num(l.end),
          b" ",
          flag(l.primary),
          b"\n",
          l.text,
        ]),
      ),
  );
  let notes = map(d.notes_text, |n: Bytes| field(b"note", n));
  let fixes = fold(d.fixes, [], |acc: List<Bytes>, f: Fix|
    fold(f.edits, push(acc, field(b"fix", f.title)), |a: List<Bytes>, e: Edit|
      push(
        a,
        field(
          b"edit",
          bytes_concat_all([num(e.module), b" ", num(e.start), b" ", num(e.end), b"\n", e.text]),
        ),
      )));
  framed(b"diag", num(index), append(append(append(head, labels), notes), fixes))
}

// One concatenation over the finished frames; appending per frame is quadratic.
pub fn diag_dump(sources: List<Source>) -> String = {
  let ds = diagnostics(sources);
  string_of_bytes(bytes_concat_all(map(range(0, len(ds)), |i: Int| frame(i, at(ds, i)))))
}

// --- Tests ------------------------------------------------------------------

test "a fix travels as its title and one edit per replacement" {
  let d = with_fix(diag(b"E0126", b"m", [], []), b"add the type", [
    insertion(0, 7, b": Int"),
    { module: 0, start: 1, end: 3, text: b"" },
  ]);
  assert_eq(
    string_of_bytes(frame(0, d)),
    "diag 0 90\ncode 5\nE0126severity 5\nerrormessage 1\nmfix 12\nadd the typeedit 11\n0 7 7\n: Intedit 6\n0 1 3\n",
  )
}

test "a parser diagnostic names what it expected and the token it found" {
  let out = diag_dump([{ name: b"m", src: b"fn f() -> Int = )" }]);
  assert_eq(
    out,
    "diag 0 113\ncode 5\nE0001severity 5\nerrormessage 33\nexpected an expression, found `)`label 32\n0 16 17 1\nexpected an expression",
  )
}

test "a resolve diagnostic carries the reference's note" {
  let out = diag_dump([{ name: b"m", src: b"import missing\nfn f() -> Int = 1" }]);
  assert_eq(
    out,
    "diag 0 201\ncode 5\nE0106severity 5\nerrormessage 41\nno module named `missing` in this programlabel 18\n0 7 14 1\nnot foundnote 86\na module is a file: `store/orders.ply` is `store.orders`, relative to the project root",
  )
}

test "a check diagnostic prints the two types the way the reference does" {
  let out = diag_dump([{ name: b"m", src: b"fn f() -> Int = \"x\"" }]);
  assert_eq(
    out,
    "diag 0 121\ncode 5\nE0201severity 5\nerrormessage 33\ntype mismatch: function body typelabel 40\n0 16 19 1\nexpected `Int`, found `String`",
  )
}

test "a check diagnostic with a note frames it after the labels" {
  let out = diag_dump([{ name: b"m", src: b"fn f() -> Int = 1(2)" }]);
  assert_eq(
    out,
    "diag 0 137\ncode 5\nE0204severity 5\nerrormessage 22\nthis is not a functionlabel 24\n0 16 17 1\nhas type `Int`note 35\nonly function values can be applied",
  )
}

test "a secondary label follows the primary, in the reference's order" {
  let out = diag_dump([{ name: b"m", src: b"fn g(x: Int) -> Int = x\nfn f() -> Int = g(1, 2)" }]);
  assert_eq(
    out,
    "diag 0 180\ncode 5\nE0202severity 5\nerrormessage 51\nthis function takes 1 argument, but 2 were suppliedlabel 29\n0 40 47 1\nexpected 1, found 2label 43\n0 40 41 0\nthis is the function being called",
  )
}
