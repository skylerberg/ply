// The manifest: a `ply.pkg` file is one literal of std.pkg's Manifest, checked here so the
// driver and `ply resolve` read a value rather than a parse tree. The literal judgment is the
// one §3.1 states for parameter defaults: a literal, a constructor applied to literals, a
// record or a list.

import spine (Span, PDiag, diag1, dummy_span)
import items (Module, IFn, FnDef, item_span, parse)
import exprs (Expr, ELit, EVar, EApp, ERecord, EList, RecField, expr_span)
import patterns (LInt, LBool, LStr, LUnit)
import types (TCon, ty_span)
import hash (hex, sort_bytes)
import resolve (Source)
import embed (EmbedAt, EmbedFile)
import std.json (Json, Null, Bool, Number, Str, Member, object, array, variant, error_to_string)
import std.hash (blake3)
import std.pkg (Manifest, Version, Dep, Path, Git, Registry, manifest_json, prefix_of)

pub type Checked = { manifest: Option<Manifest>, diags: List<PDiag> }

pub fn check_source(src: Bytes) -> Checked / {abort.raise} = {
  let r = parse(src);
  if len(r.p.diags) > 0 { { manifest: None, diags: r.p.diags } } else { check(r.node) }
}

fn at<a>(xs: List<a>, i: Int) -> a / {abort.raise} =
  match list_at(xs, i) { Some(x) -> x, None -> panic("an index the tables do not hold") }

pub fn check(m: Module) -> Checked / {abort.raise} =
  match m.items {
    [one] -> match one {
      IFn(d) -> if d.name.name == b"package" { check_fn(d) }
      else { refused(shape(d.name.span, b"a manifest's one definition is named `package`")) },
      _ -> refused(shape(item_span(one), b"a manifest holds a `fn package`, nothing else")),
    },
    [] -> refused(shape(dummy_span(), b"a manifest defines `package`; this file defines nothing")),
    [_, two, ..rest] ->
      refused(shape(item_span(two), b"a manifest defines `package` and nothing else")),
  }

fn refused(d: PDiag) -> Checked = { manifest: None, diags: [d] }

fn shape(here: Span, message: Bytes) -> PDiag =
  diag1(b"E0129", here, message, b"not the shape a manifest takes", [
    b"a `ply.pkg` file is exactly `fn package() -> Manifest = ...`, with std.pkg's Manifest",
  ])

fn cat(xs: List<PDiag>, ys: List<PDiag>) -> List<PDiag> =
  fold(ys, xs, |acc: List<PDiag>, y: PDiag| push(acc, y))

fn check_fn(d: FnDef) -> Checked / {abort.raise} = {
  let ret_diags = match d.ret {
    None ->
      [
        shape_msg(
          d.name.span,
          b"`package` declares its return type, std.pkg's `Manifest`",
          b"no return type written",
        ),
      ],
    Some(t) -> match t {
      TCon(c) -> if c.name.name.name == b"Manifest" { [] } else {
        [shape_msg(ty_span(t), b"`package` returns std.pkg's `Manifest`", b"not the manifest type")]
      },
      _ ->
        [
          shape_msg(
            ty_span(t),
            b"`package` returns std.pkg's `Manifest`",
            b"not the manifest type",
          ),
        ],
    },
  };
  let param_diags = if len(d.params) == 0 { [] } else {
    [
      shape_msg(
        d.name.span,
        b"`package` takes no parameters",
        b"a manifest is data; nothing is passed in",
      ),
    ]
  };
  let diags = cat(ret_diags, param_diags);
  if len(diags) > 0 { { manifest: None, diags: diags } } else { check_body(d) }
}

fn shape_msg(here: Span, message: Bytes, label: Bytes) -> PDiag =
  diag1(b"E0129", here, message, label, [])

fn check_body(d: FnDef) -> Checked / {abort.raise} =
  match literal_json(d.body) {
    Err(s) ->
      {
        manifest: None,
        diags: [
          diag1(
            b"E0130",
            s,
            b"a manifest is a value, not something that runs",
            b"not manifest data",
            [b"a literal, a constructor applied to literals, a record or a list is fine"],
          ),
        ],
      },
    Ok(j) -> match manifest_json().decode(j) {
      Err(e) ->
        {
          manifest: None,
          diags: [
            diag1(
              b"E0131",
              expr_span(d.body),
              bytes_of_string(error_to_string(e)),
              b"the manifest does not decode",
              [],
            ),
          ],
        },
      Ok(m) -> validate(m, expr_span(d.body)),
    },
  }

// `None` and `Some` encode the way the json derive encodes `Option`: null and the bare value.
fn literal_json(e: Expr) -> Result<Json, Span> / {abort.raise} =
  match e {
    ELit(v) -> match v.lit {
      LInt(n) -> Ok(Number(decimal_of_int(n))),
      LBool(b) -> Ok(Bool(b)),
      LStr(s) -> Ok(Str(string_of_bytes(s))),
      LUnit -> Ok(Null),
      _ -> Err(v.span),
    },
    ERecord(r) -> fields_json(r.fields, []),
    EList(l) -> match items_json(l.items, []) { Err(s) -> Err(s), Ok(items) -> Ok(array(items)) },
    EApp(a) -> match a.func {
      EVar(f) -> if len(a.named) == 0 && len(a.labels) == 0 && is_ctor(f.name.name.name) {
        ctor_json(a.span, f.name.name.name, a.args)
      } else { Err(a.span) },
      _ -> Err(a.span),
    },
    EVar(v) -> if v.name.name.name == b"None" { Ok(Null) }
    else if is_ctor(v.name.name.name) { Ok(variant(string_of_bytes(v.name.name.name), [])) }
    else { Err(v.span) },
    _ -> Err(expr_span(e)),
  }

fn ctor_json(here: Span, tag: Bytes, args: List<Expr>) -> Result<Json, Span> / {abort.raise} =
  if tag == b"Some" { match args { [x] -> literal_json(x), _ -> Err(here) } } else {
    match items_json(args, []) {
      Err(s) -> Err(s),
      Ok(values) -> Ok(variant(string_of_bytes(tag), values)),
    }
  }

fn items_json(xs: List<Expr>, acc: List<Json>) -> Result<List<Json>, Span> / {abort.raise} =
  match xs {
    [] -> Ok(acc),
    [x, ..rest] -> match literal_json(x) {
      Err(s) -> Err(s),
      Ok(j) -> items_json(rest, push(acc, j)),
    },
  }

fn fields_json(fs: List<RecField>, acc: List<Member>) -> Result<Json, Span> / {abort.raise} =
  match fs {
    [] -> Ok(object(acc)),
    [f, ..rest] -> match literal_json(f.value) {
      Err(s) -> Err(s),
      Ok(j) -> fields_json(rest, push(acc, { key: string_of_bytes(f.name.name), value: j })),
    },
  }

fn is_ctor(name: Bytes) -> Bool / {abort.raise} =
  bytes_len(name) > 0 && bytes_at(name, 0) >= 65 && bytes_at(name, 0) <= 90

fn validate(m: Manifest, here: Span) -> Checked / {abort.raise} = {
  let bad = field_diag(here);
  let name_diags = if bytes_len(bytes_of_string(m.name)) == 0 {
    [bad(b"a manifest's `name` must not be empty")]
  } else if !is_dotted_path(m.name) {
    [bad(b"a manifest's `name` is lower-case identifier segments joined by dots")]
  } else { [] };
  let prefix_diags = match m.prefix {
    None -> [],
    Some(p) -> if is_dotted_path(p) { [] }
    else { [bad(b"a manifest's `prefix` is lower-case identifier segments joined by dots")] },
  };
  let version_diags = if version_ok(m.version) { [] }
  else { [bad(b"a manifest's `version` counts up from zero, never below")] };
  let base = cat(name_diags, cat(prefix_diags, version_diags));
  {
    manifest: if len(base) == 0 { Some(m) } else { None },
    diags: deps_ok(m.dependencies, [], base, bad),
  }
}

fn field_diag(here: Span) -> (Bytes) -> PDiag =
  |message: Bytes| diag1(b"E0131", here, message, b"not a field a manifest accepts", [])

fn version_ok(v: Version) -> Bool = v.major >= 0 && v.minor >= 0 && v.patch >= 0

fn deps_ok(
  deps: List<Dep>,
  seen: List<Bytes>,
  diags: List<PDiag>,
  bad: (Bytes) -> PDiag,
) -> List<PDiag> / {abort.raise} =
  match deps {
    [] -> diags,
    [d, ..rest] -> {
      let here = if bytes_len(bytes_of_string(d.name)) == 0 {
        push(diags, bad(b"a dependency's `name` must not be empty"))
      } else if has(seen, bytes_of_string(d.name)) {
        push(
          diags,
          bad(
            bytes_concat_all([b"the dependency `", bytes_of_string(d.name), b"` is listed twice"]),
          ),
        )
      } else if !version_ok(d.min) {
        push(
          diags,
          bad(
            bytes_concat_all([
              b"the dependency `",
              bytes_of_string(d.name),
              b"` asks for a version below zero",
            ]),
          ),
        )
      } else if is_registry(d) && !is_dotted_path(d.name) {
        // The name is the registry's address for it, and the directory it is fetched into.
        push(
          diags,
          bad(
            bytes_concat_all([
              b"the registry dependency `",
              bytes_of_string(d.name),
              b"` is not a package name: lower-case identifier segments joined by dots",
            ]),
          ),
        )
      } else { diags };
      deps_ok(rest, push(seen, bytes_of_string(d.name)), here, bad)
    },
  }

fn has(xs: List<Bytes>, x: Bytes) -> Bool =
  match xs { [] -> false, [y, ..rest] -> if y == x { true } else { has(rest, x) } }

// Lower-case identifier segments joined by single dots: the shape a module path takes, and the
// shape a package name takes, since a name is the prefix its importers reach it through.
pub fn is_dotted_path(s: String) -> Bool / {abort.raise} = {
  let bs = bytes_of_string(s);
  bytes_len(bs) > 0 && scan_path(bs, 0, true)
}

fn scan_path(bs: Bytes, i: Int, seg_start: Bool) -> Bool / {abort.raise} =
  if i >= bytes_len(bs) { !seg_start } else {
    let b = bytes_at(bs, i);
    if seg_start { if b >= 97 && b <= 122 { scan_path(bs, i + 1, false) } else { false } }
    else if b == 46 { scan_path(bs, i + 1, true) }
    else if (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95 { scan_path(bs, i + 1, false) }
    else { false }
  }

test "a well-formed manifest checks and decodes" {
  let got = check_source(
    b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"corpus\", version: {major: 0, minor: 1, patch: 0}, prefix: None, runtime: {major: 0, minor: 1, patch: 0}, dependencies: [{name: \"cli\", prefix: None, min: {major: 1, minor: 2, patch: 3}, source: Path(\"../cli\")}, {name: \"gitlib\", prefix: Some(\"gl\"), min: {major: 0, minor: 0, patch: 1}, source: Git(\"https://example.com/gitlib\", \"deadbee\")}, {name: \"reglib\", prefix: None, min: {major: 2, minor: 0, patch: 0}, source: Registry}], entry: Some(\"app.serve\")}",
  );
  assert_eq(got.diags, []);
  match got.manifest {
    None -> assert(false),
    Some(m) -> {
      assert_eq(m.name, "corpus");
      assert_eq(m.entry, Some("app.serve"));
      assert_eq(len(m.dependencies), 3);
      assert_eq(at(m.dependencies, 0).source, Path("../cli"));
      assert_eq(at(m.dependencies, 1).prefix, Some("gl"));
      assert_eq(at(m.dependencies, 2).source, Registry)
    },
  }
}

test "a manifest with anything but one fn named package is refused" {
  assert_eq(at(check_source(b"type X = {a: Int}").diags, 0).code, b"E0129");
  assert_eq(at(check_source(b"fn other() -> Int = 1").diags, 0).code, b"E0129");
  assert_eq(at(check_source(b"fn package() -> Int = 1").diags, 0).code, b"E0129");
  assert_eq(
    at(
      check_source(
        b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"a\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}\nfn extra() -> Int = 1",
      ).diags,
      0,
    ).code,
    b"E0129",
  )
}

test "a manifest body that runs is not a value" {
  let head = b"import std.pkg (Manifest)\nfn package() -> Manifest = ";
  assert_eq(
    at(
      check_source(
        head
          ++ b"{name: greet(\"x\"), version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}",
      ).diags,
      0,
    ).code,
    b"E0130",
  );
  assert_eq(
    at(
      check_source(
        head
          ++ b"{name: \"a\", version: {major: 0, minor: 0, patch: 1 + 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}",
      ).diags,
      0,
    ).code,
    b"E0130",
  );
  assert_eq(
    at(
      check_source(
        head
          ++ b"{ let x = 1; {name: \"a\", version: {major: 0, minor: 0, patch: x}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None} }",
      ).diags,
      0,
    ).code,
    b"E0130",
  )
}

// --- The versions a closure pins -------------------------------------------------
// Minimal version selection: one version of a package serves a whole closure. Two manifests may
// ask different floors of the same package (the highest wins), but two *places* holding a package
// of one name have no one version to pick.

fn a_manifest(name: String, deps: List<String>) -> Bytes =
  bytes_of_string(
    "import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"" ++ name
      ++ "\", version: {major: 0, minor: 1, patch: 0}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: ["
      ++ joined(deps, ", ")
      ++ "], entry: None}",
  )

fn joined(parts: List<String>, sep: String) -> String =
  fold(range(0, len(parts)), "", |acc: String, i: Int|
    match list_at(parts, i) { None -> acc, Some(x) -> if i == 0 { x } else { acc ++ sep ++ x } })

fn a_dep(name: String, floor: Int, path: String) -> String =
  "{name: \"" ++ name ++ "\", prefix: None, min: {major: 0, minor: " ++ int_to_string(floor)
    ++ ", patch: 0}, source: Path(\""
    ++ path
    ++ "\")}"

fn supplied_at(root: String, name: String, deps: List<String>) -> Supplied =
  { root: bytes_of_string(root), manifest: Some(a_manifest(name, deps)), modules: [] }

fn a_registry_dep(name: String, floor: Int) -> String =
  "{name: \"" ++ name ++ "\", prefix: None, min: {major: 0, minor: " ++ int_to_string(floor)
    ++ ", patch: 0}, source: Registry}"

fn codes_of(clo: Closure) -> List<Bytes> =
  map(clo.diags, |d: { slot: Int, diag: PDiag }| d.diag.code)

test "a registry dependency is wanted at the root's cache, whichever package declares it" {
  let app = supplied_at("/x/app", "app", [a_registry_dep("orders", 1), a_dep("lib", 0, "../lib")]);
  let lib = supplied_at("/x/lib", "lib", [a_registry_dep("money", 0)]);
  assert_eq(wants([b"/x/app"], [app]), [b"/x/app/.ply-cache/registry/orders", b"/x/lib"]);
  assert_eq(wants([b"/x/app", b"/x/app/.ply-cache/registry/orders", b"/x/lib"], [app, lib]), [
    b"/x/app/.ply-cache/registry/money",
  ]);
  assert_eq(registry_key(b".", b"orders"), b".ply-cache/registry/orders")
}

test "a registry dependency at or above its floor is the package its slot holds" {
  let pkgs: Pkgs = {
    root: b"/x/app",
    manifest: Some(a_manifest("app", [a_registry_dep("orders", 1)])),
    supplied: [supplied_at("/x/app/.ply-cache/registry/orders", "orders", [])],
  };
  let clo = closure(pkgs, []);
  assert_eq(clo.diags, []);
  assert_eq(map(clo.packages, |p: Package| p.prefix), [b"app", b"orders"]);
  assert_eq(at(clo.packages, 0).deps, [b"orders"])
}

test "a registry slot never fetched, fetched below the floor, or holding another package says so" {
  let unfetched = closure(
    {
      root: b"/x/app",
      manifest: Some(a_manifest("app", [a_registry_dep("orders", 1)])),
      supplied: [{ root: b"/x/app/.ply-cache/registry/orders", manifest: None, modules: [] }],
    },
    [],
  );
  assert_eq(codes_of(unfetched), [b"E0135"]);
  let said = at(unfetched.diags, 0).diag;
  assert(string_contains(string_of_bytes_lossy(said.message), "`orders` has not been fetched"));
  assert(string_contains(string_of_bytes_lossy(at(said.notes_text, 0)), "`ply resolve`"));
  let below = closure(
    {
      root: b"/x/app",
      manifest: Some(a_manifest("app", [a_registry_dep("orders", 2)])),
      supplied: [supplied_at("/x/app/.ply-cache/registry/orders", "orders", [])],
    },
    [],
  );
  assert_eq(codes_of(below), [b"E0136"]);
  assert_eq(at(below.diags, 0).diag.notes, 1);
  let other = closure(
    {
      root: b"/x/app",
      manifest: Some(a_manifest("app", [a_registry_dep("orders", 1)])),
      supplied: [supplied_at("/x/app/.ply-cache/registry/orders", "billing", [])],
    },
    [],
  );
  assert_eq(codes_of(other), [b"E0135"]);
  assert(
    string_contains(
      string_of_bytes_lossy(at(other.diags, 0).diag.message),
      "holds the package `billing`",
    ),
  )
}

test "a package two others depend on is not a cycle" {
  let edges = [
    { from: 0, target: 1 },
    { from: 0, target: 2 },
    { from: 1, target: 3 },
    { from: 2, target: 3 },
  ];
  assert_eq(find_cycle(4, edges), None)
}

test "a diamond of one version is what a closure pins: both requesters, one package" {
  let pkgs: Pkgs = {
    root: b"/x/app",
    manifest: Some(a_manifest("app", [a_dep("b", 1, "../b"), a_dep("c", 1, "../c")])),
    supplied: [
      supplied_at("/x/b", "b", [a_dep("d", 0, "../d")]),
      supplied_at("/x/c", "c", [a_dep("d", 1, "../d")]),
      supplied_at("/x/d", "d", []),
    ],
  };
  let clo = closure(pkgs, []);
  assert_eq(clo.diags, []);
  assert_eq(map(clo.packages, |p: Package| p.prefix), [b"app", b"b", b"c", b"d"])
}

test "a package of one version at two places has no version to pick" {
  let pkgs: Pkgs = {
    root: b"/x/app",
    manifest: Some(a_manifest("app", [a_dep("b", 1, "../b"), a_dep("c", 1, "../c")])),
    supplied: [
      supplied_at("/x/b", "b", [a_dep("d", 1, "../d1")]),
      supplied_at("/x/c", "c", [a_dep("d", 1, "../d2")]),
      supplied_at("/x/d1", "d", []),
      supplied_at("/x/d2", "d", []),
    ],
  };
  let clo = closure(pkgs, []);
  let codes = map(clo.diags, |d: { slot: Int, diag: PDiag }| d.diag.code);
  assert_eq(codes, [b"E0137"]);
  let text = string_of_bytes_lossy(at(clo.diags, 0).diag.message);
  assert(string_contains(text, "`b` wants `/x/d1`"));
  assert(string_contains(text, "`c` wants `/x/d2`"))
}

test "a dependency below the floor its importer asks for is named with both versions" {
  let pkgs: Pkgs = {
    root: b"/x/app",
    manifest: Some(a_manifest("app", [a_dep("b", 9, "../b")])),
    supplied: [supplied_at("/x/b", "b", [])],
  };
  let clo = closure(pkgs, []);
  let codes = map(clo.diags, |d: { slot: Int, diag: PDiag }| d.diag.code);
  assert_eq(codes, [b"E0136"]);
  let text = string_of_bytes_lossy(at(clo.diags, 0).diag.message);
  assert(string_contains(text, "is version 0.1.0"));
  assert(string_contains(text, "at least 0.9.0"))
}

test "fields that fail validation are named" {
  let head = b"import std.pkg (Manifest)\nfn package() -> Manifest = ";
  let tail = b", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}";
  assert_eq(at(check_source(head ++ b"{name: \"\"" ++ tail).diags, 0).code, b"E0131");
  assert_eq(at(check_source(head ++ b"{name: \"Not A Path\"" ++ tail).diags, 0).code, b"E0131");
  assert_eq(at(check_source(head ++ b"{name: 3" ++ tail).diags, 0).code, b"E0131");
  let dup = b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"a\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [{name: \"d\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Registry}, {name: \"d\", prefix: None, min: {major: 0, minor: 0, patch: 2}, source: Registry}], entry: None}";
  assert_eq(at(check_source(dup).diags, 0).code, b"E0131");
  let escaping = b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"a\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [{name: \"../up\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Registry}], entry: None}";
  let refused = at(check_source(escaping).diags, 0);
  assert_eq(refused.code, b"E0131");
  assert(string_contains(string_of_bytes_lossy(refused.message), "is not a package name"))
}

test "a manifest with a syntax error reports the parse, not the shape" {
  let got = check_source(b"fn package() -> Manifest = {name: \"a\"");
  assert_eq(len(got.diags), 1);
  assert(at(got.diags, 0).code != b"E0129")
}

test "a module path scans segments, not just characters" {
  assert(is_dotted_path("cli"));
  assert(is_dotted_path("std.pkg"));
  assert(is_dotted_path("a1.b_2.c"));
  assert(!is_dotted_path(""));
  assert(!is_dotted_path("Std"));
  assert(!is_dotted_path("a..b"));
  assert(!is_dotted_path("a."));
  assert(!is_dotted_path(".a"));
  assert(!is_dotted_path("a-b"))
}

// --- The closure --------------------------------------------------------------
// The packages a load pulls in: manifests checked, the graph judged, and every dependency's
// modules named for the front end. A walker supplies raw texts and reads named sources back;
// every package judgment lives here so the driver and the CLI share the one implementation.

// A package as a walker supplies it: the root it was found at, its manifest text when the
// root holds one (`None` marks a wanted root that had none), and its modules named relative.
pub type Supplied = { root: Bytes, manifest: Option<Bytes>, modules: List<Source> }

// The packages one load is made of: the root's own manifest (`None` is the anonymous
// package) and everything the walk reached from it.
pub type Pkgs = { root: Bytes, manifest: Option<Bytes>, supplied: List<Supplied> }

// One package of the settled closure: its granted module prefix, the prefixes it declares,
// and its decoded manifest (`None` when the root held none or the text did not check).
pub type Package = { root: Bytes, prefix: Bytes, deps: List<Bytes>, manifest: Option<Manifest> }

pub type Closure = {
  packages: List<Package>,
  // The dependency modules in supplied order, each named `<prefix>.<relative>` beside the
  // package it belongs to; a package with no decoded manifest keeps its names bare, so the
  // count and order a walker placed them in still holds.
  modules: List<{ pkg: Int, src: Source }>,
  // Diagnostics by the slot the manifest's text takes after every module (0-based); a
  // negative slot points at the module `-(slot) - 1` of the program instead.
  diags: List<{ slot: Int, diag: PDiag }>,
}

fn head_of<a>(xs: List<a>, n: Int) -> List<a> / {abort.raise} = map(range(0, n), |i: Int| at(xs, i))

fn join_bytes(xs: List<Bytes>, sep: Bytes) -> Bytes =
  match xs {
    [] -> b"",
    [x, ..rest] -> fold(rest, x, |acc: Bytes, y: Bytes| bytes_concat_all([acc, sep, y])),
  }

// `base` joined with `rel`, then `.` and `..` segments folded out textually, so two spellings
// of one directory key the same package.
fn join_normalized(base: Bytes, rel: Bytes) -> Bytes / {abort.raise} =
  normalize(bytes_concat_all([base, b"/", rel]), [], 0)

fn normalize(path: Bytes, out: List<Bytes>, i: Int) -> Bytes / {abort.raise} =
  if i >= bytes_len(path) {
    let joined = join_bytes(out, b"/");
    if bytes_len(path) > 0 && bytes_at(path, 0) == 47 { bytes_concat(b"/", joined) } else { joined }
  } else {
    let end = match bytes_index_of_from(path, b"/", i) { Some(j) -> j, None -> bytes_len(path) };
    let seg = bytes_slice(path, i, end);
    let next = end + 1;
    if seg == b"." || seg == b"" { normalize(path, out, next) } else if seg == b".." {
      if len(out) == 0 || at(out, len(out) - 1) == b".." { normalize(path, push(out, b".."), next) }
      else { normalize(path, head_of(out, len(out) - 1), next) }
    } else { normalize(path, push(out, seg), next) }
  }

// The root keys a set of manifests asks for beyond the ones already known: what a walker
// reads next. Malformed manifests ask for nothing; their refusal is the final pass's to say.
// The first manifest is the root package's, whose directory holds every registry dependency.
pub fn wants(known: List<Bytes>, manifests: List<Supplied>) -> List<Bytes> / {abort.raise} = {
  let root = match list_at(manifests, 0) { Some(s) -> s.root, None -> b"" };
  fold(manifests, [], |acc: List<Bytes>, s: Supplied|
    match s.manifest {
      None -> acc,
      Some(src) -> match check_source(src).manifest {
        None -> acc,
        Some(m) ->
          fold(m.dependencies, acc, |acc2: List<Bytes>, d: Dep|
            match d.source {
              Path(p) -> wanted(known, acc2, join_normalized(s.root, bytes_of_string(p))),
              // A git dependency is wanted by the key its fetch is named under, not by a path: a
              // walker that has not fetched it yet has nothing to read.
              Git(url, rev) ->
                wanted(known, acc2, git_key(bytes_of_string(url), bytes_of_string(rev))),
              Registry -> wanted(known, acc2, registry_key(root, bytes_of_string(d.name))),
            }),
      },
    })
}

fn wanted(known: List<Bytes>, acc: List<Bytes>, root: Bytes) -> List<Bytes> =
  if has(known, root) || has(acc, root) { acc } else { push(acc, root) }

test "a walk's next reads are the roots its manifests ask for that it has not read" {
  let app = supplied_at("/x/app", "app", [a_dep("b", 1, "../b"), a_dep("c", 1, "../c")]);
  assert_eq(wants([b"/x/app"], [app]), [b"/x/b", b"/x/c"]);
  assert_eq(wants([b"/x/app", b"/x/b"], [app]), [b"/x/c"]);
  assert_eq(wants([b"/x/app"], [{ root: b"/x/app", manifest: None, modules: [] }]), [])
}

/// The root key a git dependency is supplied under once it is fetched: `git+<url>@<rev>`. The front
/// end judges it like any other root, so nothing here needs to know where a fetch puts a tree — and
/// `rev` is read from the last `@`, since a url may hold one of its own (`git@host:path`).
pub fn git_key(url: Bytes, rev: Bytes) -> Bytes = bytes_concat_all([b"git+", url, b"@", rev])

/// The root package's registry cache, where every registry dependency of its closure is read from.
pub fn registry_dir(root: Bytes) -> Bytes / {abort.raise} =
  join_normalized(root, b".ply-cache/registry")

/// Where one registry dependency is read from: a directory per name, since a closure holds one
/// version of a name. `ply resolve` puts the version the closure selects there, and every other
/// walk only reads it. The name is a package name, which the manifest check holds it to.
pub fn registry_key(root: Bytes, name: Bytes) -> Bytes / {abort.raise} =
  bytes_concat_all([registry_dir(root), b"/", name])

/// The url and revision a key names, for the walker that has to fetch it.
pub fn git_spec(key: Bytes) -> Option<{ url: Bytes, rev: Bytes }> / {abort.raise} =
  if !bytes_starts_with(key, b"git+") { None } else {
    let rest = bytes_slice(key, 4, bytes_len(key));
    match last_at(rest, 0, 0) {
      None -> None,
      Some(at) ->
        Some({ url: bytes_slice(rest, 0, at), rev: bytes_slice(rest, at + 1, bytes_len(rest)) }),
    }
  }

// The last `@` in a key's url: a url may hold one of its own (`git@host:path`), and the revision
// never does.
fn last_at(rest: Bytes, from: Int, found: Int) -> Option<Int> / {abort.raise} =
  match bytes_index_of_from(rest, b"@", from) {
    None -> if found == 0 { None } else { Some(found) },
    Some(at) -> if at + 1 >= bytes_len(rest) { None } else { last_at(rest, at + 1, at) },
  }

fn slot_of(manifests: List<Option<Bytes>>, i: Int) -> Int / {abort.raise} = {
  let before = head_of(manifests, i);
  fold(before, 0, |acc: Int, m: Option<Bytes>| match m { None -> acc, Some(_) -> acc + 1 })
}

// Every manifest checked, in package order; slot `s` of a diag is the count of present
// manifest texts before it, so the front end can place it after every module.
fn checked_manifests(
  texts: List<Option<Bytes>>,
) -> { manifests: List<Option<Manifest>>, diags: List<{ slot: Int, diag: PDiag }> } / {abort.raise} =
  fold(
    range(0, len(texts)),
    { manifests: [], diags: [] },
    |acc: { manifests: List<Option<Manifest>>, diags: List<{ slot: Int, diag: PDiag }> }, i: Int|
      match at(texts, i) {
        None -> { ..acc, manifests: push(acc.manifests, None) },
        Some(src) -> {
          let c = check_source(src);
          let slot = slot_of(texts, i);
          {
            manifests: push(acc.manifests, c.manifest),
            diags: fold(c.diags, acc.diags, |ds: List<{ slot: Int, diag: PDiag }>, d: PDiag|
              push(ds, { slot: slot, diag: d })),
          }
        },
      },
  )

fn pkg_diag(slot: Int, code: Bytes, message: Bytes) -> { slot: Int, diag: PDiag } =
  { slot: slot, diag: diag1(code, dummy_span(), message, b"in this package's manifest", []) }

// The packages of one load, judged: dependencies usable, prefixes unique, the graph acyclic,
// and the dependency modules named. `root_modules` are the root package's own module names,
// whose first segments may not squat on a dependency's prefix.
pub fn empty() -> Pkgs = { root: b"", manifest: None, supplied: [] }

pub fn closure(pkgs: Pkgs, root_modules: List<Bytes>) -> Closure / {abort.raise} = {
  let texts: List<Option<Bytes>> = fold(
    pkgs.supplied,
    [pkgs.manifest],
    |acc: List<Option<Bytes>>, s: Supplied| push(acc, s.manifest),
  );
  let roots: List<Bytes> = fold(pkgs.supplied, [pkgs.root], |acc: List<Bytes>, s: Supplied|
    push(acc, s.root));
  let checked = checked_manifests(texts);
  let packages = map(range(0, len(roots)), |i: Int| {
    let m = at(checked.manifests, i);
    {
      root: at(roots, i),
      prefix: match m { None -> b"", Some(x) -> bytes_of_string(prefix_of(x)) },
      deps: [],
      manifest: m,
    }
  });
  let judged = judge(texts, roots, checked.manifests, packages, root_modules, checked.diags);
  {
    packages: judged.packages,
    modules: name_modules(judged.packages, pkgs.supplied, 1, []),
    diags: judged.diags,
  }
}

// Dependency modules in supplied order, named by their package's prefix when it decoded;
// the count and order a walker supplied in is the count and order named here.
fn name_modules(
  packages: List<Package>,
  supplied: List<Supplied>,
  i: Int,
  out: List<{ pkg: Int, src: Source }>,
) -> List<{ pkg: Int, src: Source }> / {abort.raise} =
  if i > len(supplied) { out } else {
    let p = at(packages, i);
    let named = match p.manifest {
      None ->
        fold(at(supplied, i - 1).modules, out, |o: List<{ pkg: Int, src: Source }>, s: Source|
          push(o, { pkg: i, src: s })),
      Some(_) ->
        fold(at(supplied, i - 1).modules, out, |o: List<{ pkg: Int, src: Source }>, s: Source|
          push(o, {
            pkg: i,
            src: { name: bytes_concat_all([p.prefix, b".", s.name]), src: s.src },
          })),
    };
    name_modules(packages, supplied, i + 1, named)
  }

// --- What a build pins -----------------------------------------------------------
// A package as `ply.lock` records it: what it calls itself, the version it declares, and the
// BLAKE3 digest of the modules it contributed. The digest is over the modules' names and texts in
// name order, so neither a move nor a walk order can change it and an edit must.

pub type Pinned = { name: Bytes, version: Bytes, digest: Bytes }

fn digest_domain() -> Bytes = b"ply.lock.package.1"

/// The closure's dependencies, in package order: the root package is the project's own sources and
/// is not pinned. A dependency is its modules and what they embed.
pub fn pins_of(clo: Closure, embeds: List<EmbedAt> = []) -> List<Pinned> / {abort.raise} =
  fold(range(1, len(clo.packages)), [], |acc: List<Pinned>, i: Int| {
    let p = at(clo.packages, i);
    match p.manifest {
      None -> acc,
      Some(m) ->
        push(acc, {
          name: bytes_of_string(m.name),
          version: version_text(m.version),
          digest: package_digest(i, clo, embeds),
        }),
    }
  })

fn package_digest(pkg: Int, clo: Closure, embeds: List<EmbedAt>) -> Bytes / {abort.raise} = {
  let mine = filter(clo.modules, |m: { pkg: Int, src: Source }| m.pkg == pkg);
  let parts = map(mine, |m: { pkg: Int, src: Source }|
    bytes_concat_all([m.src.name, b"\0", m.src.src, b"\0"]));
  let names = fold(mine, map_new(), |acc: Map<Bytes, Bool>, m: { pkg: Int, src: Source }|
    map_insert(acc, m.src.name, true));
  let embedded = map(filter(embeds, |e: EmbedAt| map_contains(names, e.module)), embed_part);
  let modules = bytes_concat_all(sort_bytes(parts));
  // A package that embeds nothing keeps the digest its modules alone give it.
  let tail = if len(embedded) == 0 { b"" }
  else { bytes_concat(b"\x01embeds", bytes_concat_all(sort_bytes(embedded))) };
  bytes_concat(b"b3:", hex(blake3(bytes_concat_all([digest_domain(), modules, tail]))))
}

fn embed_part(e: EmbedAt) -> Bytes / {abort.raise} =
  bytes_concat_all([
    e.module,
    b"\0",
    e.key,
    b"\0",
    match e.read {
      Ok(files) ->
        bytes_concat_all(
          map(files, |f: EmbedFile| bytes_concat_all([f.name, b"\0", hex(blake3(f.bytes)), b"\0"])),
        ),
      Err(why) -> bytes_concat_all([b"\x01", why, b"\0"]),
    },
  ])

// --- The graph's judgments ------------------------------------------------------

type Judged = { packages: List<Package>, diags: List<{ slot: Int, diag: PDiag }> }

type Pending = {
  packages: List<Package>,
  diags: List<{ slot: Int, diag: PDiag }>,
  edges: List<{ from: Int, target: Int }>,
}

fn set_at<a>(xs: List<a>, i: Int, v: a) -> List<a> / {abort.raise} = list_set(xs, i, v)

fn root_index(roots: List<Bytes>, key: Bytes, i: Int) -> Option<Int> / {abort.raise} =
  if i >= len(roots) { None }
  else if at(roots, i) == key { Some(i) }
  else { root_index(roots, key, i + 1) }

fn judge(
  texts: List<Option<Bytes>>,
  roots: List<Bytes>,
  manifests: List<Option<Manifest>>,
  packages: List<Package>,
  root_modules: List<Bytes>,
  diags: List<{ slot: Int, diag: PDiag }>,
) -> Judged / {abort.raise} = {
  let built = fold(
    range(0, len(packages)),
    { packages: packages, diags: diags, edges: [] },
    |acc: Pending, i: Int|
      match at(manifests, i) {
        None -> acc,
        Some(m) ->
          fold(m.dependencies, acc, |a: Pending, d: Dep| one_dep(texts, roots, manifests, i, a, d)),
      },
  );
  let versioned = version_judgments(texts, roots, built.packages, built.edges, built.diags);
  let collided = prefix_judgments(texts, roots, built.packages, root_modules, versioned);
  let cycled = match find_cycle(len(roots), built.edges) {
    None -> collided,
    Some(c) ->
      push(collided, {
        slot: slot_of(texts, at(c, 0)),
        diag: diag1(
          b"E0134",
          dummy_span(),
          bytes_concat_all([b"packages depend on one another in a cycle: ", cycle_text(roots, c)]),
          b"in this package's manifest",
          [b"break the cycle: a package may not reach itself through its dependencies"],
        ),
      }),
  };
  { packages: built.packages, diags: cycled }
}

fn version_text(v: Version) -> Bytes =
  bytes_of_string(
    int_to_string(v.major) ++ "." ++ int_to_string(v.minor) ++ "." ++ int_to_string(v.patch),
  )

// Minimal version selection: one version of a package serves a whole closure, so a name reached
// at two roots has no one version to pick and is refused naming both. Two manifests asking
// different floors of the *same* package is not an error — the highest floor wins, and the check
// that the package is at least that high is `one_dep`'s.
fn version_judgments(
  texts: List<Option<Bytes>>,
  roots: List<Bytes>,
  packages: List<Package>,
  edges: List<{ from: Int, target: Int }>,
  diags: List<{ slot: Int, diag: PDiag }>,
) -> List<{ slot: Int, diag: PDiag }> / {abort.raise} = {
  let named = |p: Package| match p.manifest { None -> "", Some(m) -> m.name };
  fold(range(0, len(packages)), diags, |acc: List<{ slot: Int, diag: PDiag }>, i: Int| {
    let p = at(packages, i);
    if p.manifest == None { acc } else {
      // The packages before this one with the same name: a name is what a closure pins, so a
      // second one is the ambiguity.
      let earlier = fold(range(0, i), None, |found: Option<Int>, j: Int|
        match found {
          Some(_) -> found,
          None -> if named(at(packages, j)) == named(p) && at(packages, j).manifest != None {
            Some(j)
          } else { None },
        });
      match earlier {
        None -> acc,
        Some(j) ->
          push(acc, {
            slot: slot_of(texts, requester_of(edges, i)),
            diag: diag1(
              b"E0137",
              dummy_span(),
              bytes_concat_all([
                b"`",
                bytes_of_string(named(p)),
                b"` is reached at two places: `",
                bytes_of_string(package_name(at(packages, requester_of(edges, j)))),
                b"` wants `",
                at(roots, j),
                b"`, and `",
                bytes_of_string(package_name(at(packages, requester_of(edges, i)))),
                b"` wants `",
                at(roots, i),
                b"`",
              ]),
              b"in this package's manifest",
              [
                b"a closure pins one version of a package, and only one of these can be it",
                b"depend on one of them, or make them the same package",
              ],
            ),
          }),
      }
    }
  })
}

// The package that declared the dependency reaching `target`: what a judgment about the target
// points at, since the requester's manifest is where the dependency is written.
fn requester_of(edges: List<{ from: Int, target: Int }>, target: Int) -> Int =
  match first_edge(edges, target) { Some(from) -> from, None -> target }

fn first_edge(edges: List<{ from: Int, target: Int }>, target: Int) -> Option<Int> =
  match edges {
    [] -> None,
    [e, ..rest] -> if e.target == target { Some(e.from) } else { first_edge(rest, target) },
  }

fn cycle_text(roots: List<Bytes>, c: List<Int>) -> Bytes / {abort.raise} =
  join_bytes(map(push(c, at(c, 0)), |i: Int| at(roots, i)), b" -> ")

fn one_dep(
  texts: List<Option<Bytes>>,
  roots: List<Bytes>,
  manifests: List<Option<Manifest>>,
  i: Int,
  acc: Pending,
  d: Dep,
) -> Pending / {abort.raise} = {
  let name = bytes_of_string(d.name);
  match d.source {
    Git(url, rev) -> {
      let key = git_key(bytes_of_string(url), bytes_of_string(rev));
      reached(
        texts,
        roots,
        manifests,
        i,
        acc,
        d,
        key,
        bytes_concat_all([b"the dependency `", name, b"` at `", key, b"` was not fetched"]),
        [],
      )
    },
    Path(p) -> {
      let target = join_normalized(at(roots, i), bytes_of_string(p));
      reached(
        texts,
        roots,
        manifests,
        i,
        acc,
        d,
        target,
        bytes_concat_all([b"the dependency `", name, b"` at `", target, b"` was not read"]),
        [],
      )
    },
    Registry ->
      reached(
        texts,
        roots,
        manifests,
        i,
        acc,
        d,
        registry_key(at(roots, 0), name),
        bytes_concat_all([b"the registry dependency `", name, b"` has not been fetched"]),
        [resolve_note()],
      ),
  }
}

fn resolve_note() -> Bytes =
  b"`ply resolve` fetches the version this closure selects into the project's `.ply-cache/registry`"

fn is_registry(d: Dep) -> Bool = match d.source { Registry -> true, _ -> false }

// A dependency judged at the root the walk supplied it under: it must have been read, hold a
// manifest, be the package a registry slot is named for, be at least the floor asked for, and call
// itself by the prefix it is granted. A registry slot with no manifest is one never fetched.
fn reached(
  texts: List<Option<Bytes>>,
  roots: List<Bytes>,
  manifests: List<Option<Manifest>>,
  i: Int,
  acc: Pending,
  d: Dep,
  key: Bytes,
  absent: Bytes,
  notes: List<Bytes>,
) -> Pending / {abort.raise} = {
  let slot = slot_of(texts, i);
  let name = bytes_of_string(d.name);
  match root_index(roots, key, 0) {
    None -> push_diag_notes(acc, slot, b"E0135", absent, notes),
    Some(j) -> match at(texts, j) {
      None -> if is_registry(d) { push_diag_notes(acc, slot, b"E0135", absent, notes) } else {
        push_diag_text(
          acc,
          slot,
          b"E0135",
          bytes_concat_all([
            b"the dependency `",
            name,
            b"` at `",
            key,
            b"` holds no ply.pkg; a package that is depended on must declare one",
          ]),
        )
      },
      Some(_) -> match at(manifests, j) {
        None -> acc,
        Some(tm) -> {
          let granted = bytes_of_string(prefix_of(tm));
          let aliased = match d.prefix { None -> granted, Some(a) -> bytes_of_string(a) };
          if is_registry(d) && tm.name != d.name {
            push_diag_notes(
              acc,
              slot,
              b"E0135",
              bytes_concat_all([
                b"the registry dependency `",
                name,
                b"` at `",
                key,
                b"` holds the package `",
                bytes_of_string(tm.name),
                b"`",
              ]),
              notes,
            )
          } else if compare(tm.version, d.min) == Less {
            // `derive ord` gives the type a `compare`, not an operator.
            push_diag_notes(
              acc,
              slot,
              b"E0136",
              bytes_concat_all([
                b"the dependency `",
                name,
                b"` at `",
                key,
                b"` is version ",
                version_text(tm.version),
                b", and this manifest asks for at least ",
                version_text(d.min),
              ]),
              notes,
            )
          } else if aliased != granted {
            push_diag_text(
              acc,
              slot,
              b"E0133",
              bytes_concat_all([
                b"the dependency `",
                name,
                b"` is granted the prefix `",
                aliased,
                b"` here, but calls itself `",
                granted,
                b"`",
              ]),
            )
          } else {
            {
              packages: set_at(acc.packages, i, {
                ..at(acc.packages, i),
                deps: push(at(acc.packages, i).deps, granted),
              }),
              diags: acc.diags,
              edges: push(acc.edges, { from: i, target: j }),
            }
          }
        },
      },
    },
  }
}

fn push_diag_notes(
  acc: Pending,
  slot: Int,
  code: Bytes,
  message: Bytes,
  notes: List<Bytes>,
) -> Pending =
  {
    ..acc,
    diags: push(acc.diags, {
      slot: slot,
      diag: diag1(code, dummy_span(), message, b"in this package's manifest", notes),
    }),
  }

fn push_diag_text(acc: Pending, slot: Int, code: Bytes, message: Bytes) -> Pending =
  { ..acc, diags: push(acc.diags, pkg_diag(slot, code, message)) }

// Every granted prefix is unique and neither reserved root, and no root module squats on one.
fn prefix_judgments(
  texts: List<Option<Bytes>>,
  roots: List<Bytes>,
  packages: List<Package>,
  root_modules: List<Bytes>,
  diags: List<{ slot: Int, diag: PDiag }>,
) -> List<{ slot: Int, diag: PDiag }> / {abort.raise} = {
  let reserved = fold(
    range(0, len(packages)),
    diags,
    |acc: List<{ slot: Int, diag: PDiag }>, i: Int| {
      let p = at(packages, i);
      if p.manifest == None || bytes_len(p.prefix) == 0 { acc } else {
        let with_reserved = if p.prefix == b"std" || p.prefix == b"compiler" {
          push(acc, {
            slot: slot_of(texts, i),
            diag: diag1(
              b"E0133",
              dummy_span(),
              bytes_concat_all([
                b"the package at `",
                p.root,
                b"` grants the prefix `",
                p.prefix,
                b"`, which is reserved",
              ]),
              b"in this package's manifest",
              [b"`std` and `compiler` name the modules the toolchain ships"],
            ),
          })
        } else { acc };
        fold(
          range(i + 1, len(packages)),
          with_reserved,
          |acc2: List<{ slot: Int, diag: PDiag }>, j: Int| {
            let q = at(packages, j);
            if q.manifest == None || p.prefix != q.prefix { acc2 }
            else if package_name(p) == package_name(q) { acc2 } else {
              push(acc2, {
                slot: slot_of(texts, j),
                diag: diag1(
                  b"E0133",
                  dummy_span(),
                  bytes_concat_all([
                    b"the packages at `",
                    p.root,
                    b"` and `",
                    q.root,
                    b"` both grant the prefix `",
                    p.prefix,
                    b"`",
                  ]),
                  b"in this package's manifest",
                  [b"a module prefix names one package in a closure"],
                ),
              })
            }
          },
        )
      }
    },
  );
  fold(root_modules, reserved, |acc: List<{ slot: Int, diag: PDiag }>, m: Bytes| {
    let seg = first_segment(m);
    match find_prefix(packages, seg, 1) {
      None -> acc,
      Some(j) ->
        push(acc, {
          slot: slot_of(texts, j),
          diag: diag1(
            b"E0133",
            dummy_span(),
            bytes_concat_all([
              b"`",
              m,
              b"` is a module of the root package, but `",
              seg,
              b"` is granted by the package at `",
              at(packages, j).root,
              b"`",
            ]),
            b"in this package's manifest",
            [b"rename the directory, or the dependency's prefix"],
          ),
        }),
    }
  })
}

fn package_name(p: Package) -> String = match p.manifest { None -> "", Some(m) -> m.name }

fn first_segment(name: Bytes) -> Bytes / {abort.raise} =
  match bytes_index_of(name, b".") { None -> name, Some(i) -> bytes_slice(name, 0, i) }

fn find_prefix(packages: List<Package>, prefix: Bytes, i: Int) -> Option<Int> / {abort.raise} =
  if i >= len(packages) { None }
  else if at(packages, i).manifest != None && at(packages, i).prefix == prefix { Some(i) }
  else { find_prefix(packages, prefix, i + 1) }

// A back edge in a depth-first walk, as the stack from the gray node; white 0, gray 1, black 2.
fn find_cycle(
  n: Int,
  edges: List<{ from: Int, target: Int }>,
) -> Option<List<Int>> / {abort.raise} =
  visit(range(0, n), edges, map(range(0, n), |_i: Int| 0), [], 0)

fn visit(
  nodes: List<Int>,
  edges: List<{ from: Int, target: Int }>,
  colors: List<Int>,
  stack: List<Int>,
  _u: Int,
) -> Option<List<Int>> / {abort.raise} =
  match nodes {
    [] -> None,
    [u, ..rest] -> if at(colors, u) != 0 { visit(rest, edges, colors, stack, 0) } else {
      match dfs(u, edges, list_set(colors, u, 1), push(stack, u)) {
        { colors: c2, cycle: Some(c) } -> Some(c),
        { colors: c2, cycle: None } -> visit(rest, edges, list_set(c2, u, 2), stack, 0),
      }
    },
  }

fn dfs(
  u: Int,
  edges: List<{ from: Int, target: Int }>,
  colors: List<Int>,
  stack: List<Int>,
) -> { colors: List<Int>, cycle: Option<List<Int>> } / {abort.raise} =
  fold(
    edges,
    { colors: colors, cycle: None },
    |acc: { colors: List<Int>, cycle: Option<List<Int>> }, e: { from: Int, target: Int }|
      match acc.cycle {
        Some(_) -> acc,
        None -> if e.from != u { acc } else if at(acc.colors, e.target) == 1 {
          { colors: acc.colors, cycle: Some(stack_from(stack, e.target)) }
        } else if at(acc.colors, e.target) == 0 {
          match dfs(e.target, edges, list_set(acc.colors, e.target, 1), push(stack, e.target)) {
            // Black once its own edges are done: a package two others both depend on is reached
            // twice, and only a gray target is a back edge.
            { colors: c2, cycle: c } -> { colors: list_set(c2, e.target, 2), cycle: c },
          }
        } else { acc },
      },
  )

// The path from `u` down to where the walk is: what a back edge closes into a cycle. A gray node
// is always on the walk's stack, so a call that reaches the end is the walk having lost it.
fn stack_from(stack: List<Int>, u: Int) -> List<Int> / {abort.raise} =
  match stack {
    [] -> panic("the walk's stack lost a package it had not finished"),
    [x, ..rest] -> if x == u { stack } else { stack_from(rest, u) },
  }
