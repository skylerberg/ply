  assert_eq(out.map(|e: Emitted| e.text.index_of(b"rt_field_p") != None), [false])
}

test "two operators on one span that the checker settled apart are left unsettled" {
  let at = span_between(3, 9);
  let sites = [
    { module: 0, span: at, ty: b"Int", owner: b"m.f" },
    { module: 0, span: at, ty: b"U8", owner: b"m.g" },
    { module: 1, span: at, ty: b"U8", owner: b"n.f" },
  ];
  assert_eq(operands_in(sites, 0).get(span_key(at)), Some(unsettled()));
  assert_eq(operands_in(sites, 1).get(span_key(at)), Some(b"U8"))
}

// --- the emitter's entry ----------------------------------------------------

/// A definition as its callers read it, its answer as its scheme says.
fn def_entry(module: Bytes, d: FnDef, pure: Map<Bytes, Bool>, schemes: Map<Bytes, Scheme>) -> Def = {
  let full = qualify(module, d.name.name);
  let ret = match sig_of(schemes, full) { Some(s) -> Some(kind_of(s.ret)), None -> None };
  let carried = carriers_of(d, sig_of(schemes, full));
  {
    name: d.name.name,
    ret: match ret { Some(r) -> Some(r.kind), None -> None },
    ret_ty: match ret { Some(r) -> r.ty, None -> TyOpen([]) },
    pure: pure.contains(full),
    arity: d.params.len() + d.generics.labels.len(),
    scheme: schemes.get(full),
    carriers: carried.params,
    answer: carried.answer,
    witnesses: carried.witnesses,
  }
}

/// How each parameter of `d`, witnesses first and labels last as its function takes them, and its
/// answer cross a call between roots, from the types its scheme declares; a nullary root's answer
/// is a word, as a constant's is.
fn carriers_of(
  d: FnDef,
  sig: Option<Sig>,
) -> { params: List<Carrier>, answer: Carrier, witnesses: Int } = {
  let given = match sig { Some(s) -> s.params, None -> [] };
  let witnesses = d.params.len() - given.len();
  let written = range(0, d.params.len()).map(|i: Int|
    if i < witnesses { Whole(KBoxed) }
    else { match given.at(i - witnesses) { Some(t) -> carrier_of(t), None -> Whole(KBoxed) } });
  {
    params: d.generics.labels.fold(written, |acc: List<Carrier>, _: Ident| acc.push(Whole(KBoxed))),
    answer: if d.params.len() + d.generics.labels.len() == 0 { Whole(KBoxed) }
    else { match sig { Some(s) -> carrier_of(s.ret), None -> Whole(KBoxed) } },
    witnesses: witnesses,
  }
}

/// How a root of `d` at type arguments `args` takes each parameter and answers: as `carriers_of`
/// says of the types it declares, and each variable `carried_vars` names as its argument crosses
/// once `erased`, which is what names the root. Callers at their type arguments and the root at its
/// own reach the same.
fn carriers_at(
  d: Def,
  args: List<Type>,
) -> { params: List<Carrier>, answer: Carrier } / {abort.raise} =
  match d.scheme {
    None -> { params: d.carriers, answer: d.answer },
    Some(sc) -> match sc.ty {
      TyFn(f) -> {
        let raw = carried_vars(sc, args, d.arity);
        let at_var = |t: Type, otherwise: Carrier|
          match t {
            TyVar(j) -> if raw.contains(j) { carrier_of(erased(args.get(j))) } else { otherwise },
            _ -> otherwise,
          };
        {
          params: range(0, d.carriers.len()).map(|i: Int| {
            let k = d.carriers.get(i);
            if i < d.witnesses { k }
            else { match f.params.at(i - d.witnesses) { Some(t) -> at_var(t, k), None -> k } }
          }),
          answer: at_var(f.ret, d.answer),
        }
      },
      _ -> { params: d.carriers, answer: d.answer },
    },
  }

/// The variables of `scheme` a call at `args` carries raw: each standing bare as a parameter, or as
/// the answer of a function taking any, at an argument whose word would be an allocation. The unit
/// settles such a call on the callee's specialisation at each.
fn carried_vars(scheme: Scheme, args: List<Type>, arity: Int) -> List<Int> / {abort.raise} =
  match scheme.ty {
    TyFn(f) ->
      range(0, args.len()).filter(|j: Int|
        (f.params.contains(TyVar(j)) || (arity > 0 && f.ret == TyVar(j)))
          && raw_carrier(carrier_of(erased(args.get(j))))),
    _ -> [],
  }

/// Whether two calls hand the same lambdas, each as the same parameter.
fn same_fns(a: List<FnArg>, b: List<FnArg>) -> Bool =
  a.len() == b.len() && a.fold(true, |ok: Bool, f: FnArg| ok && b.contains(f))

/// Whether parameter `j` may hold a function: its type is one, a variable, or unknown.
fn may_be_called(params: List<EmitParam>, j: Int) -> Bool =
  match params.at(j) {
    Some(p) -> match p.of {
      Some(TyFn(_)) -> true,
      Some(TyVar(_)) -> true,
      Some(_) -> false,
      None -> true,
    },
    None -> true,
  }

/// The parameter of this body slot `slot` holds as itself: one the window holds, followed through
/// renames, or one the prologue left as its word.
fn slot_param(emitter: Emitter, slot: Int, params: List<EmitParam>) -> Option<Int> =
  match conv_of(emitter, slot) {
    Some(cv) -> param_of(emitter, cv, params),
    None -> if slot < params.len() { Some(slot) } else { None },
  }

/// The emitter noting each of this body's parameters that may be a function and that a call of
/// `callee` hands on as itself, by the argument it is: where the callee calls that argument, this
/// body calls the parameter.
fn passed_on(
  emitter: Emitter,
  callee: Bytes,
  codes: List<Code>,
  params: List<EmitParam>,
) -> Emitter =
  range(0, codes.len()).fold(emitter, |acc: Emitter, i: Int|
    match match codes.at(i) {
        Some(c) -> match c.node {
          NVar(v) -> match v.slot {
            Some(slot) -> match slot_param(acc, slot, params) {
              Some(j) -> if may_be_called(params, j) { Some(j) } else { None },
              None -> None,
            },
            None -> None,
          },
          _ -> None,
        },
        None -> None,
      } {
      Some(j) -> {
        let g = acc.generics;
        note_generics(acc, { ..g, passes: g.passes.push({ param: j, callee: callee, at: i }) })
      },
      None -> acc,
    })

/// The lambdas among a call's `codes`, each by its argument's place, which a callee's
/// specialisation reads and runs: a literal one or one of this root's own where the root lends its
/// lambdas, and one another root lent wherever it is handed on.
fn fn_args(emitter: Emitter, codes: List<Code>) -> List<FnArg> / {abort.raise} = {
  let lends = lends_lambdas(emitter);
  range(0, codes.len()).fold([], |acc: List<FnArg>, j: Int|
    match codes.at(j) {
      Some(c) -> match c.node {
        NLambda(l) -> if lends {
          match position_in(emitter.written, l) {
            Some(nth) -> acc.push({ param: j, owner: emitter.owner, nth: nth }),
            None -> acc,
          }
        } else { acc },
        // Another root's lambda is handed on as it is; this root's own only where it lends.
        NKnown(k) -> if k.owner != emitter.owner || lends {
          acc.push({ param: j, owner: k.owner, nth: k.nth })
        } else { acc },
        // A definition named as a value is lent as the lambda around a call of it.
        NVar(_) -> if !lends { acc } else {
          match named_arity(emitter.module, emitter.here, emitter.imports, c) {
            Some(n) -> match position_in(emitter.written, named_lambda(c, n)) {
              Some(nth) -> acc.push({ param: j, owner: emitter.owner, nth: nth }),
              None -> acc,
            },
            None -> acc,
          }
        },
        _ -> acc,
      },
      None -> acc,
    })
}

/// Whether a lambda of the root being emitted can be read again where another root runs it: the
/// root is a definition of no type variable as it stands, or one at type arguments that are all
/// known and that runs no lambda of another root itself. Its sites then name no variable.
fn lends_lambdas(emitter: Emitter) -> Bool / {abort.raise} =
  is_test_owner(emitter.owner)
    || (emitter.owner.index_of(b"#") == None
    && (match specialisation_of(emitter.owner) {
      Some(s) ->
        s.fns.len() == 0 && emitter.owner.index_of(b"|") == None
          && s.args.fold(true, |known: Bool, a: Type| known && a != unknown_type() && !has_vars(a)),
      None -> match emitter.here.fold(None, |acc: Option<Def>, d: Def|
          if qualify(emitter.module, d.name) == emitter.owner { Some(d) } else { acc }) {
        Some(d) -> match d.scheme { Some(sc) -> sc.ty_vars.len() == 0, None -> true },
        None -> false,
      },
    }))

/// The type arguments the checker gave a reference of a generic definition at `at`; none where it
/// gave none or not one for each of the scheme's variables.
fn reference_args(emitter: Emitter, scheme: Option<Scheme>, at: Span) -> List<Type> =
  match scheme {
    None -> [],
    Some(sc) -> if sc.ty_vars.len() == 0 { [] } else {
      match emitter.typed.get(span_key(at)) {
        Some(t) -> if t.args.len() == sc.ty_vars.len() { t.args } else { [] },
        None -> [],
      }
    },
  }

/// How a value declared at `t` crosses a call between roots: a scalar held apart from a word as
/// itself; a record `carried_record` admits as its fields; an `Option` or a `Result` held as one
/// word as that word, or as its cases where one of its arguments crosses as a record's fields;
/// anything else as its word.
fn carrier_of(t: Type) -> Carrier = {
  let k = kind_of(t);
  let args = if is_option_type(t) || tagged_result(t) {
    match t { TyCon(c) -> c.args.map(|a: Type| case_carrier(carrier_of(a))), _ -> [] }
  } else { [] };
  if is_option_type(t) {
    sum_carrier(Zeroed, [{ name: b"None", arg: None }, { name: b"Some", arg: args.at(0) }])
  } else if tagged_result(t) {
    sum_carrier(Tagged, [{ name: b"Ok", arg: args.at(0) }, { name: b"Err", arg: args.at(1) }])
  } else {
    match k.ty {
      TyRec(fs) -> if carried_record(fs) { Fields(fs) } else { Whole(KBoxed) },
      _ -> match k.kind {
        KFloat -> Whole(KFloat),
        KDec -> Whole(KDec),
        KInt -> Whole(KInt),
        KBool -> Whole(KBool),
        KNum(w) -> if carried(w) { Whole(KNum(w)) } else { Whole(KBoxed) },
        _ -> Whole(KBoxed),
      },
    }
  }
}

/// A sum held as one word as `spec` says, crossing as its cases where a constructor's argument
/// crosses as a record's fields and as that word otherwise.
fn sum_carrier(spec: SumSpec, cases: List<SumCase>) -> Carrier =
  if cases.fold(false, |any: Bool, c: SumCase|
      any || (match c.arg { Some(Fields(_)) -> true, _ -> false })) {
    Cases({ spec: spec, cases: cases })
  } else { Whole(KSum(spec)) }

/// How a sum's argument a call carries as `c` crosses as the sum's: a sum as its object.
fn case_carrier(c: Carrier) -> Carrier =
  match c { Whole(KSum(_)) -> Whole(KBoxed), Cases(_) -> Whole(KBoxed), other -> other }

/// The C values a sum carried as `c` crosses in past its constructor's index: each constructor's
/// argument's in turn, a record's fields and then its word.
fn sum_leaves(c: SumCases) -> List<FieldTy> =
  c.cases.fold([], |acc: List<FieldTy>, sc: SumCase|
    match sc.arg {
      None -> acc,
      Some(Fields(fs)) ->
        acc.concat(record_leaves(fs).push({ name: b"", kind: KBoxed, ty: TyOpen([]) })),
      Some(Whole(k)) -> acc.push({ name: b"", kind: k, ty: TyOpen([]) }),
      Some(Cases(_)) -> acc.push({ name: b"", kind: KBoxed, ty: TyOpen([]) }),
    })

/// How many of a sum's C values past its index the argument `arg` takes.
fn case_width(arg: Option<Carrier>) -> Int =
  match arg { None -> 0, Some(Fields(fs)) -> record_leaves(fs).len() + 1, Some(_) -> 1 }

/// Where among a sum's values past its index its `i`th constructor's argument starts.
fn case_start(c: SumCases, i: Int) -> Int =
  range(0, i).fold(0, |acc: Int, j: Int|
    acc + case_width(match c.cases.at(j) { Some(sc) -> sc.arg, None -> None }))

/// The index of constructor `name` among `c`'s.
fn case_index(c: SumCases, name: Bytes) -> Option<Int> =
  range(0, c.cases.len()).fold(None, |acc: Option<Int>, i: Int|
    match c.cases.at(i) { Some(sc) -> if sc.name == name { Some(i) } else { acc }, None -> acc })

/// A record that crosses a call as its leaves, each in a C value of its own, and then its word,
/// zero where it was never made: one held back until its word is asked for, whose records in place
/// hold none, of at most four words of values. A record made once crosses any number of calls as
/// that word.
fn carried_record(fs: List<FieldTy>) -> Bool =
  fs.len() > 0
    && fs.fold(true, |ok: Bool, f: FieldTy|
      ok && (match in_place(f) { Some(inner) -> holdable(inner), None -> true }))
    && fs.fold(0, |n: Int, f: FieldTy|
      n + (match in_place(f) { Some(inner) -> laid_of(inner).width, None -> raw_words(f.kind) }))
    <= 4

/// The C values a record of `fs` crosses a call in before its word: each field's, and for a record
/// it holds in place, that record's fields and then its word.
fn record_leaves(fs: List<FieldTy>) -> List<FieldTy> =
  fs.fold([], |acc: List<FieldTy>, f: FieldTy|
    match in_place(f) {
      Some(inner) -> acc.concat(inner).push({ name: b"", kind: KBoxed, ty: TyOpen([]) }),
      None -> acc.push(f),
    })

/// The C types `c` crosses a call in, one per C parameter.
fn carried_types(c: Carrier) -> List<Bytes> =
  match c {
    Whole(k) -> [carried_type(k)],
    Fields(fs) -> record_leaves(fs).map(|f: FieldTy| ctype(f.kind)).push(b"Word"),
    Cases(sc) ->
      push_front_bytes(b"int64_t", sum_leaves(sc).map(|f: FieldTy| carried_type(f.kind))),
  }

fn push_front_bytes(x: Bytes, xs: List<Bytes>) -> List<Bytes> = [x].concat(xs)

/// Whether a value carried as `c` crosses in C values of its own rather than as a word: a record's
/// fields, or a scalar in its C type.
fn raw_carrier(c: Carrier) -> Bool =
  match c { Fields(_) -> true, Cases(_) -> true, Whole(k) -> k != KBoxed && !is_sum(k) }

/// The kind a root answering as `c` returns: the answer's, a record's first leaf's, or a sum's
/// constructor's index.
fn returned_kind(c: Carrier) -> Kind =
  match c {
    Whole(k) -> k,
    Fields(fs) -> match record_leaves(fs).at(0) { Some(f) -> f.kind, None -> KBoxed },
    Cases(_) -> KInt,
  }

/// What a record or sum answer writes through the pointers the caller hands: a record's leaves
/// past its first, then its word, a word field of no name; a sum's values past its index.
fn written_back(c: Carrier) -> List<FieldTy> =
  match c {
    Whole(_) -> [],
    Fields(fs) -> {
      let leaves = record_leaves(fs);
      range(1, leaves.len()).map(|k: Int| nth_field(leaves, k)).push({
        name: b"",
        kind: KBoxed,
        ty: TyOpen([]),
      })
    },
    Cases(sc) -> sum_leaves(sc),
  }

/// The C names of each parameter's carried values, `p<i>`, or a record's `p<i>_<k>` and its word
/// `p<i>_w`, and then the pointers a record answer is written through.
fn carried_names(params: List<EmitParam>, answer: Carrier) -> List<Bytes> =
  range(0, params.len()).fold([], |acc: List<Bytes>, i: Int|
    match params.at(i) {
      Some(p) -> match p.carrier {
        Fields(fs) ->
          acc.concat(range(0, record_leaves(fs).len()).map(|k: Int| field_param(i, k))).push(
            word_param(i),
          ),
        Whole(_) -> acc.push(b"p".concat(ascii_of_int(i))),
        Cases(sc) ->
          acc.push(b"p".concat(ascii_of_int(i))).concat(
            range(0, sum_leaves(sc).len()).map(|k: Int| field_param(i, k)),
          ),
      },
      None -> acc,
    }).concat(
    range(1, written_back(answer).len() + 1).map(|k: Int| b"o".concat(ascii_of_int(k))),
  )

fn field_param(i: Int, k: Int) -> Bytes =
  Bytes::concat_all([b"p", ascii_of_int(i), b"_", ascii_of_int(k)])

fn word_param(i: Int) -> Bytes = Bytes::concat_all([b"p", ascii_of_int(i), b"_w"])

/// Each field of the record `value` of fields `fs` as a value: what built it, or, where that is not
/// each of them, loaded from its word.
fn record_values(
  emitter: Emitter,
  value: CValue,
  fs: List<FieldTy>,
) -> { emitter: Emitter, vals: List<CValue> } = {
  let built = fs.map(|f: FieldTy| built_field(emitter, value.expr, f.name));
  if built.fold(true, |ok: Bool, b: Option<CValue>| ok && b != None) {
    {
      emitter: emitter,
      vals: built.map(|b: Option<CValue>|
        match b { Some(v) -> v, None -> { kind: KBoxed, expr: b"0", ty: TyOpen([]) } }),
    }
  } else {
    let w = word_of(emitter, value);
    { emitter: w.emitter, vals: field_loads(w.expr, fs) }
  }
}

/// C statements giving each counted value of `vals` a count of its own, before the word they were
/// loaded from is let go.
fn counted_incs(vals: List<CValue>) -> Bytes =
  vals.fold(b"", |t: Bytes, v: CValue|
    if counted(v.kind) { Bytes::concat_all([t, b"ply_inc(", v.expr, b"); "]) } else { t })

/// Each field of the record of fields `fs` whose word is `word`, loaded at its place.
fn field_loads(word: Bytes, fs: List<FieldTy>) -> List<CValue> =
  fs.map(|f: FieldTy|
    match field_at(TyRec(fs), f.name) {
      Some(i) ->
        {
          kind: f.kind,
          expr: if raw_slot(i.kind) { raw_at(word, ascii_of_int(i.at), i.kind) } else {
            as_kind({ kind: word_kind(i.kind), expr: field_read(word, i), ty: TyOpen([]) }, i.kind)
          },
          ty: f.ty,
        },
      None -> { kind: f.kind, expr: zero_of(f.kind), ty: f.ty },
    })

/// C statements giving `name` the word of the record of fields `fs` whose leaves are `vals`, each
/// counted one holding a count: `word` where it was made, the leaves let go; otherwise one made of
/// `shapes`, the record's and then each record's it holds in place, that takes them, as a held-back
/// record is made, leaving by `fail` if that fails. A record held in place made already is copied
/// in.
fn record_word_lines(
  name: Bytes,
  word: Bytes,
  fs: List<FieldTy>,
  shapes: List<Int>,
  vals: List<CValue>,
  fail: Bytes,
) -> Bytes = {
  let l = laid_of(fs);
  let flags = record_flags(fs, l);
  let let_go = |vs: List<CValue>|
    vs.fold(b"", |t: Bytes, v: CValue|
      if counted(v.kind) { Bytes::concat_all([t, b"ply_dec(ctx, ", v.expr, b"); "]) } else { t });
  let written = |at: Int, cs: List<{ at: Int, expr: Bytes }>|
    cs.fold(b"", |acc: Bytes, c: { at: Int, expr: Bytes }|
      Bytes::concat_all([
        acc,
        b" ply_words(",
        name,
        b")[",
        ascii_of_int(at + c.at),
        b"] = ",
        c.expr,
        b";",
      ]));
  // Each field's word, none for a record held in place, whose leaves are written after.
  let laid = range(0, fs.len()).fold(
    { at: 0, words: [], inner: [] },
    |acc: { at: Int, words: List<Bytes>, inner: List<{ field: Int, start: Int }> }, i: Int|
      match in_place(nth_field(fs, i)) {
        Some(inner) ->
          {
            at: acc.at + inner.len() + 1,
            words: acc.words.push(b"0"),
            inner: acc.inner.push({ field: i, start: acc.at }),
          },
        None ->
          {
            at: acc.at + 1,
            words: acc.words.push(field_word(nth_value(vals, acc.at), nth_field(fs, i).kind)),
            inner: acc.inner,
          },
      },
  );
  Bytes::concat_all([
    b"Word ",
    name,
    b" = ",
    word,
    b"; if (",
    name,
    b") { ",
    let_go(vals),
    b"} else { ",
    name,
    b" = rt_alloc_p(ctx, 3, ",
    ascii_of_int(l.width),
    b", ",
    shape_text(match shapes.at(0) { Some(sh) -> sh, None -> 0 }),
    b", ",
    ascii_of_int(flags),
    b"); if (ctx->failed) ",
    fail,
    written(0, put_cells(cells_of(fs, laid.words, [], l, flags))),
    range(0, laid.inner.len()).fold(b"", |acc: Bytes, j: Int| {
      let x = match laid.inner.at(j) { Some(y) -> y, None -> { field: 0, start: 0 } };
      let inner = match in_place(nth_field(fs, x.field)) { Some(ifs) -> ifs, None -> [] };
      let il = laid_of(inner);
      let iflags = record_flags(inner, il);
      let at = match l.offsets.at(x.field) { Some(o) -> o, None -> 0 };
      let ivals = range(0, inner.len()).map(|k: Int| nth_value(vals, x.start + k));
      let iw = nth_value(vals, x.start + inner.len()).expr;
      Bytes::concat_all([
        acc,
        b" if (",
        iw,
        b") { ",
        let_go(ivals),
        b"ply_embed(ctx, ",
        name,
        b", ",
        ascii_of_int(at),
        b", ",
        iw,
        b", ",
        ascii_of_int(il.tail),
        b"); } else { ply_embedded(",
        name,
        b", ",
        ascii_of_int(at),
        b", ",
        ascii_of_int(iflags),
        b", ",
        ascii_of_int(il.width),
        b", ",
        shape_text(match shapes.at(j + 1) { Some(sh) -> sh, None -> 0 }),
        b");",
        written(
          at + 2,
          put_cells(
            cells_of(
              inner,
              range(0, inner.len()).map(|k: Int|
                field_word(nth_value(ivals, k), nth_field(inner, k).kind)),
              [],
              il,
              iflags,
            ),
          ),
        ),
        b" }",
      ])
    }),
    b" }",
  ])
}

/// The shape of a record of `fs` and then of each record it holds in place, registered.
fn record_shapes(emitter: Emitter, fs: List<FieldTy>) -> { emitter: Emitter, shapes: List<Int> } = {
  let sh = shape_of_fields(emitter, fs);
  fs.fold(
    { emitter: sh.emitter, shapes: [sh.i] },
    |acc: { emitter: Emitter, shapes: List<Int> }, f: FieldTy|
      match in_place(f) {
        Some(inner) -> {
          let s = shape_of_fields(acc.emitter, inner);
          { emitter: s.emitter, shapes: acc.shapes.push(s.i) }
        },
        None -> acc,
      },
  )
}

/// The leaves of a record of `fs` among `vals` from `at` on, each typed as its leaf, and its word
/// after them.
fn leaves_at(
  vals: List<CValue>,
  at: Int,
  fs: List<FieldTy>,
) -> { vals: List<CValue>, word: Bytes } = {
  let rl = record_leaves(fs);
  {
    vals: range(0, rl.len()).map(|k: Int| {
      let f = nth_field(rl, k);
      { ..nth_value(vals, at + k), kind: f.kind, ty: f.ty }
    }),
    word: nth_value(vals, at + rl.len()).expr,
  }
}

/// Each leaf of the record of fields `fs` whose word is `word`, loaded at its place: a record held
/// in place as its own fields and then the address of its header there, which counts as its holder
/// does.
fn leaf_loads(word: Bytes, fs: List<FieldTy>) -> List<CValue> = {
  let loads = field_loads(word, fs);
  range(0, fs.len()).fold([], |acc: List<CValue>, k: Int| {
    let v = nth_value(loads, k);
    match in_place(nth_field(fs, k)) {
      Some(inner) ->
        acc.concat(field_loads(v.expr, inner)).push({ kind: KBoxed, expr: v.expr, ty: TyOpen([]) }),
      None -> acc.push(v),
    }
  })
}

fn defs_in(
  module: Bytes,
  m: Module,
  pure: Map<Bytes, Bool>,
  schemes: Map<Bytes, Scheme>,
) -> List<Def> =
  m.items.fold([], |acc: List<Def>, item: Item|
    match item { IFn(d) -> acc.push(def_entry(module, d, pure, schemes)), _ -> acc })

test "the emitter writes an embed out as the front end's answer says it was read" {
  let src = b"fn data() -> Bytes = embed(\"d.txt\")\n";
  let want = { path: b"d.txt", dir: false };
  let d = dump_of(
    analyse_pulling_std_with(
      [{ name: b"m", src: src }],
      [],
      no_rows(),
      { root: b"", manifest: None, supplied: [] },
      [{ root: b"", module: b"m", want: want, read: Ok([{ name: b"", bytes: b"one" }]) }],
    ).out,
  );
  match emit_roots_answer(
      [b"m"],
      [src],
      no_ctors(),
      [],
      [b"m.data"],
      [],
      [],
      d.embeds,
      d.rows,
      d.walked,
    ).get(
      0,
    ).answer {
    Body(b) -> assert_eq(b.tables.consts, [ConstBytes(b"one")]),
    Refused(r) -> panic(String::of_bytes_lossy(r.why)),
  }
}

test "a shipped module's extern is called as the builtin of its own name" {
  let names = [b"std.native", b"m"];
  let srcs = [
    b"pub extern fn doubled(x: Int) -> Int\n",
    b"import std.native (doubled)\nimport std.native as n\nfn f() -> Int = doubled(2) + n::doubled(3)\n",
  ];
  let d = dump_of(
    analyse_pulling_std_with(
      [{ name: b"m", src: srcs.get(1) }],
      [{ name: b"std.native", src: srcs.get(0) }],
      no_rows(),
    ).out,
  );
  let answers = emit_roots_answer(
    names,
    srcs,
    { names: [], laid: ctor_layouts(d.ctors), keyed: [], sums: ctor_sums(d.ctors) },
    [b"doubled"],
    [b"m.f"],
    [],
    [],
    d.embeds,
    d.rows,
    d.walked,
  );
  match answers.at(0) {
    Some(a) -> match a.answer {
      Body(b) -> {
        let code = own_code(b.text);
        assert_eq(code.split(b"builtin_doubled_p(ctx").len(), 3);
        assert(code.index_of(b"native_") == None, Some(String::of_bytes_lossy(code)))
      },
      Refused(r) -> panic(String::of_bytes_lossy(r.why)),
    },
    None -> panic("no answer"),
  }
}

/// A function of the prelude calling each extern the emitter writes in place, as the prelude's own
/// functions call them: at a scalar item, a counted one, an item of a type variable, and through a
/// value.
fn in_place_calls() -> List<{ name: Bytes, src: Bytes }> =
  [
    { name: b"start", src: b"(xs: List<Int>) -> Int = ListNode::start(xs)" },
    { name: b"tail_len", src: b"(xs: List<Int>) -> Int = ListNode::tail_len(xs)" },
    { name: b"root", src: b"(xs: List<Int>) -> Option<ListNode<Int>> = ListNode::root(xs)" },
    { name: b"tail_at", src: b"(xs: List<String>) -> String = ListNode::tail_at(xs, 1)" },
    { name: b"len", src: b"(n: ListNode<Int>) -> Int = ListNode::len(n)" },
    { name: b"leaf_at", src: b"(n: ListNode<Int>) -> Int = ListNode::leaf_at(n, 3)" },
    { name: b"leaf_at_any", src: b"<a>(n: ListNode<a>) -> a = ListNode::leaf_at(n, 3)" },
    { name: b"leaf_at_on", src: b"(n: ListNode<String>) -> String = n.leaf_at(3)" },
    { name: b"kid_at", src: b"(n: ListNode<Int>) -> ListNode<Int> = ListNode::kid_at(n, 1)" },
    {
      name: b"tail_push",
      src: b"(xs: List<String>, x: String) -> List<String> = ListNode::tail_push(xs, x)",
    },
    { name: b"tail_set", src: b"(xs: List<Int>) -> List<Int> = ListNode::tail_set(xs, 2, 7)" },
    {
      name: b"leaf_set",
      src: b"(n: ListNode<String>, x: String) -> ListNode<String> = ListNode::leaf_set(n, 2, x)",
    },
    {
      name: b"root_swap",
      src: b"(xs: List<Int>, r: ListNode<Int>) -> Option<ListNode<Int>> = ListNode::root_swap(xs, Some(r)).old",
    },
    {
      name: b"kid_swap",
      src: b"(n: ListNode<Int>) -> ListNode<Int> = ListNode::kid_swap(n, 0, None).node",
    },
    { name: b"tail_start", src: b"(xs: List<Int>) -> List<Int> = ListNode::tail_start(xs, 7)" },
    { name: b"spill", src: b"(xs: List<Int>) -> ListNode<Int> = ListNode::spill(xs).leaf" },
    { name: b"branch", src: b"() -> ListNode<Int> = ListNode::branch()" },
    {
      name: b"map_root",
      src: b"(m: Map<Int, String>) -> Option<MapNode<Int, String>> = MapNode::root(m)",
    },
    { name: b"height", src: b"(m: Map<Int, String>) -> Int = MapNode::height(m)" },
    { name: b"count", src: b"(n: MapNode<Int, String>) -> Int = MapNode::count(n)" },
    { name: b"key", src: b"(n: MapNode<Int, String>) -> Int = MapNode::key(n, 1)" },
    { name: b"value", src: b"(n: MapNode<Int, String>) -> String = MapNode::value(n, 1)" },
    {
      name: b"kid",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid(n, 1)",
    },
    { name: b"kid_max", src: b"(n: MapNode<Int, String>) -> Int = MapNode::kid_max(n, 1)" },
    { name: b"kid_size", src: b"(n: MapNode<Int, String>) -> Int = MapNode::kid_size(n, 1)" },
    { name: b"leaf", src: b"() -> MapNode<Int, String> = MapNode::leaf()" },
    { name: b"map_branch", src: b"() -> MapNode<Int, String> = MapNode::branch()" },
    {
      name: b"pair_put",
      src: b"(n: MapNode<Int, String>, v: String) -> MapNode<Int, String> = MapNode::pair_put(n, 1, 5, v)",
    },
    {
      name: b"pair_set",
      src: b"(n: MapNode<Int, String>, v: String) -> MapNode<Int, String> = MapNode::pair_set(n, 1, 5, v)",
    },
    {
      name: b"pair_take",
      src: b"(n: MapNode<Int, String>) -> String = MapNode::pair_take(n, 1).value",
    },
    {
      name: b"leaf_cut",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::leaf_cut(n, 16).right",
    },
    {
      name: b"branch_cut",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::branch_cut(n, 16).left",
    },
    {
      name: b"kid_out",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_out(n, 1).kid",
    },
    {
      name: b"kid_back",
      src: b"(n: MapNode<Int, String>, k: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_back(n, 1, k, 9, 4)",
    },
    {
      name: b"kid_put",
      src: b"(n: MapNode<Int, String>, k: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_put(n, 1, k, 9, 4)",
    },
    {
      name: b"kid_drop",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_drop(n, 1)",
    },
    {
      name: b"map_swap",
      src: b"(m: Map<Int, String>, r: MapNode<Int, String>) -> Map<Int, String> = MapNode::map_swap(m, Some(r), 1, 40).map",
    },
  ]

test "each extern written in place is written over the runtime's objects as the layouts lay them out, and calls no native" {
  let calls = in_place_calls();
  let probes = calls.fold(b"\n", |acc: Bytes, c: { name: Bytes, src: Bytes }|
    Bytes::concat_all([acc, b"fn probe_", c.name, c.src, b"\n"]));
  // Every extern `intrinsics` lists is called here.
  let unprobed = intrinsics().filter(|i: { name: Bytes, op: Intrinsic }|
    probes.index_of(i.name.slice(b"std.prelude.".len(), i.name.len()).concat(b"(")) == None);
  assert_eq(unprobed.map(|i: { name: Bytes, op: Intrinsic }| i.name), []);
  let roots = calls.map(|c: { name: Bytes, src: Bytes }| b"std.prelude.probe_".concat(c.name));
  let answers = answers_of(
    [b"std.prelude"],
    [prelude_source::text().concat(probes)],
    [b"Some", b"None"],
    roots,
  );
  let code = |name: Bytes|
    match answers.find(|a: RootAnswer| a.name == b"std.prelude.probe_".concat(name)) {
      Some(a) -> match a.answer {
        Body(b) -> own_code(b.text),
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic("no answer for probe_" ++ String::of_bytes_lossy(name)),
    };
  assert_eq(
    calls.filter(|c: { name: Bytes, src: Bytes }| code(c.name).index_of(b"builtin_") != None).map(
      |c: { name: Bytes, src: Bytes }| c.name,
    ),
    [],
  );
  let laid = layouts();
  let has = |name: Bytes, text: Bytes| code(name).index_of(text) != None;
  let field = |name: Bytes| b"->".concat(name);
  let node = |kind: Int| Bytes::concat_all([b"rt_node_p(ctx, ", ascii_of_int(kind), b")"]);
  let past = |from: Int| ascii_of_int(from).concat(b" + (");
  assert_eq(
    [
      has(b"start", field(laid.list.start)),
      has(b"tail_len", field(laid.list.tail_len)),
      has(b"tail_at", past(laid.list.tail)),
      has(b"height", field(laid.map.height)),
      has(b"kid_max", past(laid.tree.keys)),
      has(b"kid_size", past(laid.tree.sizes)),
      has(b"branch", node(laid.trie.branch)),
      has(b"spill", node(laid.trie.leaf)),
      has(b"leaf", node(laid.tree.leaf)),
      has(b"map_branch", node(laid.tree.branch)),
      has(b"branch_cut", node(laid.tree.branch)),
      has(b"leaf_cut", node(laid.tree.leaf)),
      has(b"tail_push", field(laid.list.room)),
    ],
    [true, true, true, true, true, true, true, true, true, true, true, true, true],
  );
  // A write takes what it writes held once, where it is not, and counts an item's or a pair's.
  assert_eq(
    [
      has(b"tail_push", b"rt_list_writable_p(ctx, "),
      has(b"leaf_set", b"rt_node_writable_p(ctx, "),
      has(b"map_swap", b"rt_map_writable_p(ctx, "),
      has(b"pair_set", b"rt_note_update_p(ctx, "),
      has(b"kid_put", b"rt_note_update_p(ctx, "),
    ],
    [true, true, true, true, false],
  )
}

test "a list, an array or a map read matched as `Some` or `None` is answered in place by its lookup" {
  let src = Bytes::concat_all([
    b"fn listed(xs: List<Int>, i: Int) -> Int = match xs.at(i) { Some(v) -> v, None -> 0 }\n",
    b"fn arrayed(xs: Array<Int>, i: Int) -> Int = match xs.at(i) { Some(v) -> v, None -> 0 }\n",
    b"fn mapped(xs: Map<Int, Int>, k: Int) -> Int = match xs.get(k) { Some(v) -> v, None -> 0 }\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [b"Some", b"None"],
    [b"List::at", b"Array::at", b"Map::get"],
    true,
  );
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None]);
  let calls = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(calls(b"rt_list_lookup_p"), [true, false, false]);
  assert_eq(calls(b"rt_array_lookup_p"), [false, true, false]);
  assert_eq(calls(b"rt_map_lookup_p"), [false, false, true]);
  assert_eq(calls(b"rt_ctor_p"), [false, false, false])
}

/// The roots `wanted` names as the emitter answers them over what the front end read of the program.
/// `shipped` are fixtures of the toolchain's modules the program imports, lowered with it.
fn answers_of(
  names: List<Bytes>,
  srcs: List<Bytes>,
  ctors: List<Bytes>,
  wanted: List<Bytes>,
  shipped: List<Source> = [],
) -> List<RootAnswer> / {abort.raise} = {
  let d = if shipped.len() == 0 { dump_of(analyse(parse_all(zip_sources(names, srcs)))) }
  else { dump_of(analyse_pulling_std_with(zip_sources(names, srcs), shipped, no_rows()).out) };
  emit_roots_answer(
    shipped.map(|s: Source| s.name).concat(names),
    shipped.map(|s: Source| s.src).concat(srcs),
    { names: ctors, laid: ctor_layouts(d.ctors), keyed: [], sums: ctor_sums(d.ctors) },
    [
      b"?numeric_binary",
      b"compare",
      b"digest",
      b"?encoded",
      b"Bytes::concat_all",
      b"Bytes::blake3",
      b"Array::new",
      b"Array::set",
      b"Array::of_list",
      b"List::push",
      b"Map::len",
      b"Map::entries",
      b"Bytes::slice",
      b"reflect",
      b"shown",
    ],
    wanted,
    [],
    [],
    d.embeds,
    d.rows,
    d.walked,
  )
}

/// `std.value` as the reflection roots read it: its `Value` and the externs that make one.
fn value_fixture() -> Source =
  {
    name: b"std.value",
    src: Bytes::concat_all([
      b"pub type Value = | VUnit | VBool(Bool) | VInt(Int) | VFloat(Float) | VDecimal(Decimal) | VFixed(String, U128) | VChar(Char) | VStr(String) | VBytes(Bytes) | VList(List<Value>) | VRecord(List<Field>) | VCtor(String, List<Value>) | VMap(List<Entry>) | VFn(Fun) | VCell({ index: Int, generation: Int }) | VTask(Int) | VChan(Int) | VSecret | VElided(Int) | VArray(List<Value>) | VShown(String)\n",
      b"pub type Field = { name: String, value: Value }\n",
      b"pub type Entry = { key: Value, value: Value }\n",
      b"pub type Fun = | FNamed(String) | FAnonymous | FConst({ arity: U8, value: Value }) | FProject({ arity: U8, index: U8 }) | FTable({ arity: U8, entries: List<Entry>, default: Value })\n",
      b"pub extern fn reflect<a>(x: a) -> Value\n",
      b"pub extern fn shown<a>(x: a) -> Value\n",
    ]),
  }

test "a generic definition reached at a type held apart from a word is emitted again at it" {
  let src = Bytes::concat_all([
    b"fn twice<a>(x: a) -> a where numeric(a) = x + x\n",
    b"fn go(f: Float) -> Float = twice(f)\n",
    b"fn id<a>(x: a) -> a = x\n",
    b"fn same(s: String) -> String = id(s)\n",
    b"fn down<a>(n: Int, x: a) -> a where numeric(a) = if n <= 0 { x } else { down(n - 1, x + x) }\n",
    b"fn fall(n: Int) -> Int = down(n, 1)\n",
  ]);
  let wanted = [
    b"m.go",
    b"m.same",
    b"m.fall",
    b"m.twice",
    b"m.id",
    b"m.twice@Float",
    b"m.down@Int",
  ];
  let answers = answers_of([b"m"], [src], [], wanted);
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if a.name == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic("no answer"),
    };
  let has = |name: Bytes, text: Bytes| body(name).text.index_of(text) != None;
  // A call of a generic definition names a placeholder the unit settles, with its type arguments,
  // which the unit reads as far as the callee needs.
  assert(has(b"m.go", b"@@g0@@"));
  assert_eq(body(b"m.go").tables.generics.calls, [
    { callee: b"m.twice", args: [b"Float"], carried: [0], fns: [] },
  ]);
  assert_eq(body(b"m.same").tables.generics.calls, [
    { callee: b"m.id", args: [b"String"], carried: [], fns: [] },
  ]);
  // `twice` reads its witness, which a scalar argument does in C; `id` needs nothing of its argument.
  assert_eq(body(b"m.twice").tables.generics.needs, [{ var: 0, reads: Scalar }]);
  assert_eq(body(b"m.id").tables.generics.needs, []);
  // At `Float` the witnessed `+` is C's own, and the parameter a `double`.
  assert(has(b"m.twice@Float", b"double "));
  assert(!has(b"m.twice@Float", b"numeric_binary"));
  // A specialisation's call of itself stays in it, here as a loop.
  assert(has(b"m.down@Int", b"goto ply_loop;"));
  assert(!has(b"m.down@Int", b"numeric_binary"));
  assert_eq(body(b"m.down@Int").tables.calls, [b"m.down@Int"])
}

test "a specialisation hands its recursion on to the definitions as they stand where it leaves them" {
  let src = Bytes::concat_all([
    b"fn spin<a, b>(x: a, y: b, n: Int) -> Int = if n <= 0 { 0 } else { spin(y, x, n - 1) }\n",
    b"fn ping<a>(x: a, n: Int) -> a = if n <= 0 { x } else { pong(x, n - 1) }\n",
    b"fn pong<a>(x: a, n: Int) -> a = if n <= 0 { x } else { ping(x, n - 1) }\n",
    b"fn go() -> Float = { let _ = spin(1.5, 7, 3); ping(1.5, 3) }\n",
  ]);
  let answers = answers_of([b"m"], [src], [], [
    b"m.go",
    b"m.spin",
    b"m.spin@Float,Int",
    b"m.ping",
    b"m.pong",
    b"m.ping@Float",
  ]);
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if a.name == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(r.why)),
      },
      None -> panic("no answer"),
    };
  let loops = |name: Bytes| body(name).text.index_of(b"goto ply_loop;") != None;
  assert_eq(body(b"m.go").tables.generics.calls, [
    { callee: b"m.spin", args: [b"Float", b"Int"], carried: [0, 1], fns: [] },
    { callee: b"m.ping", args: [b"Float"], carried: [0], fns: [] },
  ]);
  // The call hands `y` on as `x`: what is a `Float` here is an `Int` there, so the call is of the
  // definition as it stands, whose own body restarts.
  assert_eq(body(b"m.spin@Float,Int").tables.calls, [b"m.spin"]);
  assert(!loops(b"m.spin@Float,Int"));
  assert(loops(b"m.spin"));
  // `ping` and `pong` are one loop under `ping`'s name, which the specialisation enters by `pong`.
  assert_eq(body(b"m.ping@Float").tables.calls, [b"m.pong"]);
  assert(loops(b"m.ping"))
}

test "a generic definition reached at a record type reads the record where its layout puts it" {
  let src = b"fn first<a, b>(p: { l: a, r: b }) -> a = p.l\nfn pick(q: { l: { x: Float, y: Float }, r: Int }) -> Float = first(q).x\n";
  let laid = b"m.first@{x:Float,y:Float},Int";
  let answers = answers_of([b"m"], [src], [], [b"m.pick", b"m.first", laid]);
  let text = |name: Bytes|
    match answers.fold(None, |acc: Option<Bytes>, a: RootAnswer|
        if a.name == name {
          Some(match a.answer {
            Body(x) -> x.text,
            Refused(r) -> panic(String::of_bytes_lossy(r.why)),
          })
        } else { acc }) {
      Some(t) -> t,
      None -> panic("no answer"),
    };
  let tables = |name: Bytes|
    match answers.fold(None, |acc: Option<Tables>, a: RootAnswer|
        if a.name == name { match a.answer { Body(x) -> Some(x.tables), Refused(_) -> acc } }
        else { acc }) {
      Some(t) -> t,
      None -> panic("no answer"),
    };
  assert_eq(tables(b"m.pick").generics.calls, [
    { callee: b"m.first", args: [b"{x:Float,y:Float}", b"Int"], carried: [0], fns: [] },
  ]);
  // Unspecialised, `p`'s fields may be anything, so `p.l` is read by name, which both its variables
  // cause; at the record, by place.
  assert(text(b"m.first").index_of(b"rt_field_p") != None);
  assert_eq(tables(b"m.first").generics.needs, [
    { var: 0, reads: Layout },
    { var: 1, reads: Layout },
  ]);
  assert(text(laid).index_of(b"rt_field_p") == None)
}

test "a long part of a name is its digest, so two long names alike at the start stay apart" {
  let long = |tail: Bytes|
    Bytes::concat_all([
      b"m.f@{",
      Bytes::concat_all(
        range(0, 40).map(|i: Int| Bytes::concat_all([b"f", ascii_of_int(i), b":Float,"])),
      ),
      tail,
      b"}",
    ]);
  let a = symbol_of(long(b"x:Int"));
  let b = symbol_of(long(b"y:Int"));
  assert(a != b);
  assert(a.len() < 80);
  // A short part is spelled in full.
  assert(symbol_of(b"m.f@Float").index_of(hex(b"f@Float")) != None)
}

test "a symbol fits what a C compiler keeps, and two names alike past that stay apart" {
  let long = |tail: Bytes|
    Bytes::concat_all([
      b"m.f",
      Bytes::concat_all(
        range(0, 30).map(|i: Int| Bytes::concat_all([b".part", ascii_of_int(i), b":x|y"])),
      ),
      tail,
    ]);
  let a = symbol_of(long(b".one"));
  let b = symbol_of(long(b".two"));
  assert(a != b);
  assert(entry_of(long(b".one")).len() < 220);
  assert_eq(a.slice(0, 120), b.slice(0, 120));
  // One that fits is spelled whole.
  assert_eq(symbol_of(b"m.f"), b"ply_m_1f_1")
}

test "a specialisation's root spells its layouts and the lambdas it runs, and reads back as them" {
  let args = [
    TyRecord([
      {
        name: b"a",
        ty: TyCon({
          name: b"Array",
          args: [TyRecord([{ name: b"x", ty: TyCon({ name: b"Float", args: [] }) }])],
        }),
      },
      { name: b"b", ty: TyCon({ name: b"_", args: [] }) },
    ]),
    TyCon({ name: b"List", args: [TyCon({ name: b"_", args: [] })] }),
    TyCon({ name: b"U32", args: [] }),
  ];
  let root = specialised(b"m.f", args);
  assert_eq(root, b"m.f@{a:Array<{x:Float}>,b:_},List<_>,U32");
  assert_eq(specialisation_of(root), Some({ base: b"m.f", args: args, fns: [] }));
  assert_eq(specialisation_of(b"m.f@{a:"), None);
  // A program-wide name, a `new` record and a label, whose name is spelled as its bytes, read back.
  let whole = [
    TyCon({ name: b"std.json.Json", args: [] }),
    TyNominal({
      name: b"m.Date",
      args: [],
      fields: [{ name: b"day", ty: TyCon({ name: b"Int", args: [] }) }],
    }),
    TyCon({
      name: b"Hold",
      args: [TyCon({ name: b"#label:held", args: [] }), TyCon({ name: b"Int", args: [] })],
    }),
  ];
  assert_eq(
    specialisation_of(specialised(b"m.g", whole)),
    Some({ base: b"m.g", args: whole, fns: [] }),
  );
  // A lambda a caller hands is spelled by the root that wrote it and which of its lambdas it is.
  let fns = [{ param: 1, owner: b"app.main", nth: 0 }, { param: 2, owner: b"lib.h", nth: 3 }];
  let lent = specialised_with(b"m.f", [TyCon({ name: b"U32", args: [] })], fns);
  assert_eq(lent, b"m.f@U32|1=app.main:0|2=lib.h:3");
  assert_eq(
    specialisation_of(lent),
    Some({ base: b"m.f", args: [TyCon({ name: b"U32", args: [] })], fns: fns }),
  );
  // What a layout does not read is a word.
  assert_eq(
    erased(TyCon({ name: b"Option", args: [TyCon({ name: b"Float", args: [] })] })),
    TyCon({ name: b"Option", args: [TyCon({ name: b"_", args: [] })] }),
  );
  assert_eq(
    erased(TyCon({ name: b"List", args: [TyCon({ name: b"Float", args: [] })] })),
    TyCon({ name: b"List", args: [TyCon({ name: b"_", args: [] })] }),
  )
}

test "an operator the checker filed at a definition's variable is done at the type it is at" {
  let src = b"fn same<a>(x: a, y: a) -> Bool = x == y\nfn floats(x: Float, y: Float) -> Bool = same(x, y)\n";
  let answers = answers_of([b"m"], [src], [], [b"m.same", b"m.floats", b"m.same@Float"]);
  let texts = answers.map(|a: RootAnswer|
    match a.answer { Body(b) -> b.text, Refused(r) -> r.why });
  assert_eq(answers.map(|a: RootAnswer| a.name), [b"m.same@Float", b"m.same", b"m.floats"]);
  // A word is compared by the runtime; a `Float` the specialisation holds is compared by C.
  assert_eq(texts.map(|t: Bytes| t.index_of(b"rt_equal_p") != None), [false, true, false]);
  // The generic body's comparison is the runtime's because of its variable, whose type it notes.
  let same = match answers.at(1) {
    Some(a) -> match a.answer { Body(b) -> b.tables.generics.needs, Refused(_) -> [] },
    None -> [],
  };
  assert_eq(same, [{ var: 0, reads: Exact }])
}

// A body names each constructor it builds or tests by name, so it reads the same whatever else the
// program's constructor table holds.
test "a body reads the same whatever else the program's constructor table holds" {
  let m = b"pub type Shape = | Dot | Line(Int)\nfn f(s: Shape) -> Int = match s { Dot -> 0, Line(n) -> n }\nfn g() -> Shape = Line(1)\n";
  let wanted = [b"m.f", b"m.g"];
  let alone = answers_of([b"m"], [m], [b"m.Dot", b"m.Line"], wanted);
  let beside = answers_of([b"m"], [m], [b"a.One", b"a.Two", b"m.Dot", b"m.Line"], wanted);
  assert_eq(alone, beside);
  assert(alone.len() == 2)
}

test "a module no wanted root is in, read as its stub under its rows, lowers what its text does" {
  let a = b"import b\nfn f(x: Int) -> Int = b::g(x) + 1\n";
  let b = b"pub fn g(x: Int) -> Int = x * 2\ntest \"doubles\" { assert(g(1) == 2) }\n";
  let parsed = parse_all([{ name: b"a", src: a }, { name: b"b", src: b }]);
  let d = dump_of(analyse(parsed));
  let stub = stub_module(b, parsed.get(1).module);
  assert(stub.index_of(b"x * 2") == None);
  let call = |srcs: List<Bytes>|
    emit_roots_answer([b"a", b"b"], srcs, no_ctors(), [], [b"a.f"], [], [], [], d.rows, d.walked);
  assert_eq(call([a, stub]), call([a, b]))
}

/// A record update, a call that passes a witness, and operators at two types: every kind of site a
/// body's row files. `above` is written over `moved`, which moves it without touching its text.
fn sited(above: Bytes) -> List<Source> = sited_as(above, b"{ ..p, x: b::twice(p.x) + 1 }")

fn sited_as(above: Bytes, body: Bytes) -> List<Source> =
  [
    {
      name: b"a",
      src: Bytes::concat_all([
        b"import b\ntype P = { x: Int, y: Int }\n",
        above,
        b"fn moved(p: P) -> P = ",
        body,
        b"\ntest \"moves\" { assert(moved({ x: 1, y: 2 }).x == 3) }\n",
      ]),
    },
    { name: b"b", src: b"pub fn twice<a>(x: a) -> a\n  where numeric(a)\n= x + x\n" },
  ]

fn sited_answers(sources: List<Source>, d: Dump) -> List<RootAnswer> / {abort.raise} =
  emit_roots_answer(
    sources.map(|s: Source| s.name),
    sources.map(|s: Source| s.src),
    no_ctors(),
    [],
    [b"a.moved", test_owner(b"a", b"moves"), b"b.twice"],
    [],
    [],
    [],
    d.rows,
    d.walked,
  )

test "a body is lowered from what its row files of it, walked now or published from the row" {
  let walked = dump_of(analyse(parse_all(sited(b""))));
  let filed = walked.rows.defs.fold(b"", |acc: Bytes, row: KnownDefRow|
    if row.name == b"a.moved" { row.facts } else { acc });
  match facts_at(filed, 0, 0, b"a.moved") {
    None -> panic("the row files what the walk read"),
    Some(f) -> {
      assert_eq(f.updates.len(), 1);
      assert(f.refs.len() > 0);
      assert(f.operands.len() > 0)
    },
  };
  let seeded = analyse_with(parse_all(sited(b"")), walked.rows);
  match seeded {
    front::Refused(_) -> panic("the program checks"),
    front::Analysed(w) -> assert_eq(w.checked.seeded.len(), 2),
  };
  assert_eq(sited_answers(sited(b""), dump_of(seeded)), sited_answers(sited(b""), walked))
}

fn seeded_with(sources: List<Source>, rows: Rows) -> front::AnalysisOutcome / {abort.raise} =
  analyse_pulling_std_with(sources, [], rows).out

test "a body published from its row is lowered where its definition moved to" {
  let before = dump_of(seeded_with(sited(b""), no_rows()));
  let after = sited(b"// a comment, and a definition, above it\nfn aside() -> Int = 7\n");
  let seeded = seeded_with(after, before.rows);
  match seeded {
    front::Refused(_) -> panic("the program checks"),
    front::Analysed(w) -> assert_eq(w.checked.seeded, [b"b.twice", b"a.moved"]),
  };
  assert_eq(
    sited_answers(after, dump_of(seeded)),
    sited_answers(after, dump_of(seeded_with(after, no_rows()))),
  )
}

test "a module's roots are lowered only from an answer that holds what its check read" {
  let sources = sited(b"");
  let d = dump_of(analyse(parse_all(sources)));
  let unread = { ..d, rows: { ..d.rows, defs: [] } };
  match sited_answers(sources, unread).get(0).answer {
    Body(_) -> panic("a body with no row is not lowered from a guess"),
    Refused(r) -> assert(r.why.index_of(b"nothing its check read") != None),
  };
  match sited_answers(sources, { ..d, walked: b"" }).get(0).answer {
    Body(_) -> panic("an answer with nothing read lowers nothing"),
    Refused(_) -> (),
  }
}

test "a wanted body is lowered though the answer holds nothing of a test beside it" {
  let sources = sited(b"");
  let d = dump_of(analyse(parse_all(sources)));
  // A module the front end read through its stub: its tests were never in the answer.
  let call = |wanted: List<Bytes>|
    emit_roots_answer(
      sources.map(|s: Source| s.name),
      sources.map(|s: Source| s.src),
      no_ctors(),
      [],
      wanted,
      [],
      [],
      [],
      { ..d.rows, tests: [] },
      d.walked,
    ).get(
      0,
    ).answer;
  match call([b"a.moved"]) { Body(_) -> (), Refused(r) -> panic(String::of_bytes_lossy(r.why)) };
  match call([test_owner(b"a", b"moves")]) {
    Body(_) -> panic("a test the answer holds nothing of is not lowered from a guess"),
    Refused(_) -> (),
  }
}

test "a root is in the module its owner is in" {
  assert_eq(module_of_root(b"app.cli.main"), b"app.cli");
  assert_eq(module_of_root(b"app.cli.main#requires#0"), b"app.cli");
  assert_eq(module_of_root(test_owner(b"app", b"a.b c")), b"app");
  assert_eq(module_of_root(law_root(b"app", b"x.y", b"body")), b"app");
  assert_eq(
    module_of_root(specialised_with(b"app.g", [], [{ param: 1, owner: b"lib.h", nth: 0 }])),
    b"app",
  );
  assert_eq(module_of_root(b"main"), b"")
}

test "a buffer read out of a record this body holds alone reaches its append unshared" {
  let src = Bytes::concat_all([
    b"type S = { out: Bytes, n: Int }\n",
    b"type W = { out: Bytes, n: Int, a: Int, b: Int, c: Int }\n",
    b"type T = | T(Bytes, Int)\n",
    b"fn pattern(s: S, fuel: Int) -> Bytes = { let { out, n } = s; if n <= 0 || fuel <= 0 { out } else { pattern({ out: out ++ b\"x\", n: n - 1 }, fuel - 1) } }\n",
    b"fn ctor(t: T, fuel: Int) -> Bytes = match t { T(out, n) -> if n <= 0 || fuel <= 0 { out } else { ctor(T(out ++ b\"x\", n - 1), fuel - 1) } }\n",
    b"fn update(s: S, fuel: Int) -> Bytes = if s.n <= 0 || fuel <= 0 { s.out } else { update({ ..s, out: s.out ++ b\"x\", n: s.n - 1 }, fuel - 1) }\n",
    b"fn fields(s: S, fuel: Int) -> Bytes = { let n = s.n; let out = s.out; if n <= 0 || fuel <= 0 { out } else { fields({ out: out ++ b\"x\", n: n - 1 }, fuel - 1) } }\n",
    b"fn iterated(n: Int) -> Bytes / {abort.raise} = iterate({ out: b\"\", n: n }, n + 1, |s: S| if s.n <= 0 { Stop(s.out) } else { Continue({ out: s.out ++ b\"x\", n: s.n - 1 }) })\n",
    b"fn folded(n: Int) -> Bytes = range(0, n).fold({ out: b\"\", n: 0 }, |s: S, _: Int| { out: s.out ++ b\"x\", n: s.n + 1 }).out\n",
    b"fn widened(n: Int) -> Bytes / {abort.raise} = iterate({ out: b\"\", n: n, a: 0, b: 0, c: 0 }, n + 1, |s: W| if s.n <= 0 { Stop(s.out) } else { Continue({ out: s.out ++ b\"x\", n: s.n - 1, a: s.a, b: s.b, c: s.c }) })\n",
    b"fn guarded(t: T, k: Int) -> Bytes = match t { T(out, n) if n > k -> out ++ b\"y\", T(out, _) -> out }\n",
    b"fn captured(s: S, n: Int) -> Int / {abort.raise} = iterate(0, n + 1, |i: Int| if i >= n { Stop(s.out.len() + s.n) } else { Continue(i + s.out.len()) })\n",
    b"fn caught(s: S, n: Int) -> Int = range(0, n).fold(0, |acc: Int, _: Int| acc + s.out.len() + s.n)\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [b"Stop", b"Continue", b"m.T"],
    [b"range", b"List::fold", b"iterate", b"Bytes::len"],
    true,
  );
  assert_eq(out.map(|e: Emitted| e.why), [
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
    None,
  ]);
  let text = |name: Bytes|
    match out.filter(|e: Emitted| e.name == name) { [e, ..] -> e.text, [] -> b"" };
  let before = |name: Bytes, first: Bytes, then: Bytes|
    match text(name).index_of(first) {
      None -> false,
      Some(a) -> match text(name).index_of(then) { None -> false, Some(b) -> a < b },
    };
  let takes = |name: Bytes| text(name).index_of(b"] = ply_unit; } else { ply_inc(") != None;
  // A record parameter that arrives as its fields gives its buffer's local up outright: nothing is
  // counted again between the branch's opening and the append.
  let moves = |name: Bytes| {
    let body = own_code(text(name));
    match body.index_of(b"} else {\n") {
      None -> false,
      Some(a) -> match body.index_of(b"rt_concat_p(") {
        None -> false,
        Some(c) ->
          body.index_of(b" = p0_1;\n") != None && body.slice(a, c).index_of(b"ply_inc(") == None,
      },
    }
  };
  // A constructor pattern's subject is let go once its fields are bound, before the buffer is
  // appended to, and its cells are the token the constructor built after takes; one nothing took
  // is freed on the way out.
  assert(before(b"m.ctor", b"tok2 = rt_reset_p(ctx, t2); }", b"rt_concat_p("), None);
  assert(before(b"m.ctor", b"rt_concat_p(", b" = tok2; tok2 = 0;"), None);
  assert(before(b"m.ctor", b" = tok2; tok2 = 0;", b"if (tok2) ply_dec(ctx, tok2);"), None);
  // A field read before the record's last is taken from it where the record holds it alone.
  assert_eq([b"m.update", b"m.widened", b"m.fields"].map(takes), [false, true, false]);
  // A loop's state carried as its fields hands its buffer to the append outright: the loop counts
  // nothing again and makes no record.
  let looped = |name: Bytes| {
    let body = own_code(text(name));
    match body.index_of(b"for (") {
      None -> false,
      Some(a) -> {
        let rest = body.slice(a, body.len());
        rest.index_of(b"ply_inc(") == None && rest.index_of(b"rt_alloc_p(") == None
      },
    }
  };
  assert_eq([b"m.iterated", b"m.folded"].map(looped), [true, true]);
  assert_eq([b"m.update", b"m.pattern"].map(moves), [true, true]);
  // A subject a guard reads again, and a record a fused loop reads on each pass, keep their fields.
  assert_eq([b"m.guarded", b"m.captured", b"m.caught"].map(takes), [false, false, false]);
  assert(text(b"m.guarded").index_of(b"t1 = 0;") == None, None)
}

// A count taken again would not be a wrong answer but an object that cannot die.
test "a helper's answer handed to a helper is not counted again" {
  let out = emit_all_program(
    [{ name: b"m", src: b"fn wrap(n: Int) -> List<Bytes> / {abort.raise} = [byte_of_int(n)]\n" }],
    [],
    [b"byte_of_int"],
    true,
  );
  let text = match out { [e, ..] -> e.text, [] -> b"" };
  assert(
    text.index_of(b"builtin_byte_of_int_p") != None && text.index_of(b"rt_list_p") != None,
    Some(String::of_bytes_lossy(text)),
  );
  assert(text.index_of(b"ply_inc(") == None, Some(String::of_bytes_lossy(text)))
}

// The prologue unboxes an `Int`, a `Bool` or a fixed width into a local the loop reads instead, so the
// raw word is released once, on the way out, however often the body restarts.
test "a scalar parameter arrives as itself and holds no count for a self tail call to release" {
  let src = Bytes::concat_all([
    b"fn countdown(n: Int, k: Int) -> Int = if k <= 0 { n } else { countdown(n, k - 1) }\n",
    b"fn flip(b: Bool, k: Int) -> Bool = if k <= 0 { b } else { flip(b, k - 1) }\n",
    b"fn narrow(w: U32, k: Int) -> U32 = if k <= 0 { w } else { narrow(w, k - 1) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None]);
  assert_eq(out.map(|e: Emitted| e.text.split(b"ply_dec(ctx, p0)").len() - 1), [0, 0, 0])
}

// At the body's tail nothing follows the update, so reading the accumulator twice does not keep it
// from being rebuilt in place.
test "an accumulator read more than once is still rebuilt in place at the body's tail" {
  let src = Bytes::concat_all([
    b"type S = { i: Int, tag: Bytes }\n",
    b"fn narrow(s: S, x: Int) -> S = { ..s, i: x }\n",
    b"fn wide(s: S, x: Int) -> S = { ..s, i: s.i + x }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None]);
  let reuses = |e: Emitted|
    e.text.index_of(b"rt_reset_p(") != None || e.text.index_of(b"->rc == 1") != None;
  assert_eq(out.map(reuses), [true, true])
}

test "a branch lets go as it opens of a parameter only another branch reads, and of a field read out before it" {
  let src = Bytes::concat_all([
    b"type S = { out: Bytes, n: Int }\n",
    b"type W = { out: Bytes, n: Int, a: Int, b: Int, c: Int }\n",
    b"fn whole(s: S) -> Int = s.n\n",
    b"fn wide(w: W) -> Int = w.n\n",
    b"fn slot(x: Bytes, c: Bool) -> Int = if c { x.len() } else { 0 }\n",
    b"fn field(s: S) -> Int = { let out = s.out; if s.n < 0 { whole(s) } else { Bytes::len(out ++ b\"x\") + s.n } }\n",
    b"fn wide_field(w: W) -> Int = { let out = w.out; if w.n < 0 { wide(w) } else { Bytes::len(out ++ b\"x\") + w.n } }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [b"Bytes::len"], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None]);
  let text = |name: Bytes|
    match out.filter(|e: Emitted| e.name == name) { [e, ..] -> e.text, [] -> b"" };
  let before = |name: Bytes, first: Bytes, then: Bytes|
    match text(name).index_of(first) {
      None -> false,
      Some(a) -> match text(name).index_of(then) { None -> false, Some(b) -> a < b },
    };
  assert(text(b"m.slot").index_of(b"} else {\n    ply_dec(ctx, p0); p0 = 0;") != None, None);
  // A record that is an object gives the field up where it is its only holder; one that arrives
  // as its fields lets go of the field's local.
  assert(
    before(b"m.wide_field", b"if (ply_obj(p0)->rc == 1) { Word ", b"rt_concat_p("),
    Some(String::of_bytes_lossy(text(b"m.wide_field"))),
  );
  assert(
    before(b"m.field", b"} else {\n    ply_dec(ctx, p0_1); p0_1 = 0;", b"rt_concat_p("),
    Some(String::of_bytes_lossy(text(b"m.field"))),
  )
}

fn emit_all_program(
  sources: List<Source>,
  ctors: List<Bytes>,
  builtins: List<Bytes>,
  release: Bool,
) -> List<Emitted> / {abort.raise} =
  match analyse(parse_all(sources)) {
    front::Refused(diags) -> refused_rather_than_emitted(sources, None, said(diags)),
    front::Analysed(w) -> {
      let d = dump_of(front::Analysed(w));
      emit_program(
        sources,
        { names: ctors, laid: ctor_layouts(d.ctors), keyed: [], sums: ctor_sums(d.ctors) },
        builtins,
        release,
        None,
        [],
        [],
        d.embeds,
        d.rows,
        d.walked,
      )
    },
  }

/// What an arm that refuses a program before lowering anything can say: the checker's own words, one
/// per diagnostic. There is no renderer for a diagnostic on this side -- the driver's `explain` has
/// the prose -- so the code and the message are what a refusal carries.
fn said(diags: List<Diag>) -> Bytes =
  match diags {
    [] -> b"a program the emitter will not lower, and no diagnostic explains it",
    _ ->
      bytes_join(
        diags.map(|diag: Diag| Bytes::concat_all([diag.code, b": ", diag.message])),
        b"; ",
      ),
  }

/// The same for the parser's diagnostics, which are a different record: a module that does not parse
/// has not reached the point where the other kind exist.
fn said_p(diags: List<ParseDiag>) -> Bytes =
  match diags {
    [] -> b"a module the emitter cannot parse, and no diagnostic explains it",
    _ ->
      bytes_join(
        diags.map(|diag: ParseDiag| Bytes::concat_all([diag.code, b": ", diag.message])),
        b"; ",
      ),
  }

/// Every root the caller wanted, refused for the same reason. An arm that refuses a whole program has
/// no body to hang the reason on, and the answer's reader keys a refusal by root name, so the refusal
/// has to ride on the roots it was asked for. A caller that wanted everything names its sources
/// instead: those are the names it has.
fn refused_rather_than_emitted(
  sources: List<Source>,
  wanted: Option<Map<Bytes, Bool>>,
  why: Bytes,
) -> List<Emitted> =
  List::map(
    match wanted {
      Some(m) -> m.keys(),
      None -> sources.map(|source: Source| source.name).map(|n: Bytes| n),
    },
    |n: Bytes| { name: n, text: b"", tables: no_tables(), why: Some(why), handles: [] },
  )

/// Resolved together first, so defaults are filled and derives expanded; a program that does not resolve emits nothing.
/// Every root is resolved against, but only those `wanted` names are emitted; `None` wants them all.
/// `pkgs` and `module_packages` are the program's package tables, empty for one without packages:
/// resolution then treats every module as one package's, which is what no packages means.
fn emit_program(
  sources: List<Source>,
  ctors: Ctors,
  builtins: List<Bytes>,
  release: Bool,
  wanted: Option<Map<Bytes, Bool>>,
  pkgs: List<PackageDeps>,
  module_packages: List<Int>,
  embeds: List<EmbedAt>,
  rows: Rows,
  walked: Bytes,
) -> List<Emitted> / {abort.raise} = {
  let tables = embed_tables(embeds);
  let parsed = range(0, sources.len()).map(|i: Int| {
    let s = match sources.at(i) { Some(x) -> x, None -> { name: b"", src: b"" } };
    let r = parse(s.src);
    let x = expand(r.node, r.parser.diags);
    let d = expand_derives(i, s.name, x.module);
    let e = rewritten(tables, s.name, d.module);
    {
      name: s.name,
      module: e.module,
      derived: d.derived,
      bad: r.parser.diags.len() > 0 || d.diags.len() > 0 || e.diags.len() > 0,
      // A module that does not parse is not also reported against what its recovery expanded to.
      why: if r.parser.diags.len() > 0 { said_p(r.parser.diags) }
      else if d.diags.len() > 0 { said(d.diags) }
      else { said_p(e.diags) },
    }
  });
  match parsed.fold(
      None,
      |acc: Option<Bytes>, p: { name: Bytes, module: Module, derived: List<Derived>, bad: Bool, why: Bytes }|
        match acc { Some(_) -> acc, None -> if p.bad { Some(p.why) } else { None } },
    ) {
    Some(why) -> refused_rather_than_emitted(sources, wanted, why),
    None -> {
      let mods0: List<ParsedModule> = parsed.map(
        |p: { name: Bytes, module: Module, derived: List<Derived>, bad: Bool, why: Bytes }|
          { name: p.name, module: p.module, derived: p.derived },
      );
      // The published table ends with the built-in packages; the shipped modules sit one past them.
      let packaged = if pkgs.len() == 0 { no_packages(mods0) } else {
        {
          pkgs: pkgs,
          module_packages: module_packages,
          std: pkgs.len() - 2,
          compiler: pkgs.len() - 1,
          shipped: pkgs.len(),
        }
      };
      match resolve_packaged(
          mods0,
          packaged.pkgs,
          packaged.module_packages,
          packaged.std,
          packaged.compiler,
          packaged.shipped,
        ) {
        ResolveFailed(diags) -> refused_rather_than_emitted(sources, wanted, said(diags)),
        ResolveSucceeded(x) -> {
          // A specialisation is lowered from its definition's facts, and the lambdas it runs from
          // their owners'.
          let reading = match wanted {
            None -> None,
            Some(w) ->
              Some(
                w.fold(w, |acc: Map<Bytes, Bool>, root: Bytes, _: Bool|
                  List::fold(
                    match specialisation_of(root) { Some(s) -> s.fns, None -> [] },
                    acc.insert(own_definition(root), true),
                    |r: Map<Bytes, Bool>, f: FnArg| r.insert(own_definition(f.owner), true),
                  )),
              ),
          };
          let lowered = lowered_modules(reading);
          match match walked_read(walked) {
              None ->
                Err(
                  b"the front end's answer carries nothing its check read, so nothing is lowered from it",
                ),
              Some(w) -> facts_read(rows, w, reading, x.mods),
            } {
            Err(why) -> refused_rather_than_emitted(sources, wanted, why),
            Ok(facts) -> {
              let pure = facts.pure.fold(Map::new(), |acc: Map<Bytes, Bool>, n: Bytes|
                acc.insert(n, true));
              // The checker has the shape of every update, so the literals they stand for are written in here.
              let mods: List<ParsedModule> = expanded_mods(
                x.mods,
                facts.elaboration,
                x.r.signatures,
              );
              let schemes = rows.defs.fold(
                Map::new(),
                |acc: Map<Bytes, Scheme>, row: KnownDefRow| acc.insert(row.name, row.scheme),
              );
              let program = mods.map(|m: ParsedModule|
                { module: m.name, defs: defs_in(m.name, m.module, pure, schemes) });
              let stated = stated_by_tag(mods);
              let ctors = {
                ..ctors,
                keyed: keyed_tags(mods).fold(ctors.keyed, |acc: List<Bytes>, k: Bytes|
                  if acc.contains(k) { acc } else { acc.push(k) }),
              };
              let defs_of = |path: Bytes|
                program.fold([], |acc: List<Def>, md: ModuleDefs|
                  if md.module == path { md.defs } else { acc });
              // A lambda a specialisation runs: read again where its owner lowers it, a definition
              // as it stands or at the type arguments the owner's name gives.
              let lambda_at = |owner: Bytes, nth: Int| {
                let of = match specialisation_of(owner) {
                  Some(s) -> { base: s.base, args: s.args, lends: s.fns.len() == 0 },
                  None -> { base: owner, args: [], lends: true },
                };
                let dot = range(0, of.base.len()).fold(0 - 1, |acc: Int, k: Int|
                  if of.base.at(k) == 46 { k } else { acc });
                let module = of.base.slice(0, if dot < 0 { 0 } else { dot });
                let short = of.base.slice(dot + 1, of.base.len());
                match range(0, mods.len()).fold(None, |acc: Option<Int>, k: Int|
                    match acc {
                      Some(_) -> acc,
                      None -> if mods.get(k).name == module { Some(k) } else { None },
                    }) {
                  None -> None,
                  Some(i) -> {
                    let m = mods.get(i);
                    match m.module.items.fold(None, |acc: Option<FnDef>, item: Item|
                        match item {
                          IFn(d) -> if d.name.name == short && of.lends { Some(d) } else { acc },
                          _ -> acc,
                        }) {
                      // A test's lambdas, as its root lowers its run.
                      None -> match m.module.items.fold(
                          None,
                          |acc: Option<TestDef>, item: Item|
                            match item {
                              ITest(t) -> if test_owner(m.name, t.name) == owner { Some(t) }
                              else { acc },
                              _ -> acc,
                            },
                        ) {
                        None -> None,
                        Some(t) -> {
                          let cased = t.cases != None;
                          match lower_to_emit(
                              if cased { [case_at(), case_identity()] } else { [] },
                              [],
                              sites_in(facts.label_sites, i),
                              test_run(t),
                              of_binder(m.name),
                            ) {
                            None -> None,
                            Some(l) -> {
                              let here = defs_in(m.name, m.module, pure, schemes);
                              let imports = resolved_imports(
                                x.r,
                                i,
                                mods,
                                m.module,
                                defs_of,
                                facts.elaboration.members.filter(|s: MemberSite| s.module == i),
                              );
                              let emitted = known_body(owner, [], l.code);
                              let lambdas = lambdas_of(emitted);
                              match lambdas.concat(named_in(m.name, here, imports, emitted)).at(
                                  nth,
                                ) {
                                None -> None,
                                Some(code) ->
                                  Some({
                                    owner: owner,
                                    nth: nth,
                                    code: code,
                                    named: nth >= lambdas.len(),
                                    module: m.name,
                                    here: here,
                                    imports: imports,
                                    effects: effects_in(x.r, i, mods),
                                    typed: node_types(
                                      typed_in(facts, i),
                                      if cased { [Some(int_type()), Some(bytes_type())] }
                                      else { [] },
                                      l.code,
                                    ),
                                    operands: operands_in(facts.operands, i),
                                    base: t.span.start,
                                  }),
                              }
                            },
                          }
                        },
                      },
                      Some(d) -> {
                        let source = definition_at(
                          of.base,
                          d,
                          of.args,
                          schemes,
                          facts.elaboration.ops.filter(|o: WitnessOp| o.module == i),
                          operands_in(facts.operands, i),
                        );
                        match lower_to_emit(
                            d.params.map(|param: Param| param.name.name),
                            d.generics.labels.map(|ident: Ident| ident.name),
                            sites_in(facts.label_sites, i),
                            source.body,
                            of_binder(m.name),
                          ) {
                          None -> None,
                          Some(l) -> {
                            let here = defs_in(m.name, m.module, pure, schemes);
                            let imports = resolved_imports(
                              x.r,
                              i,
                              mods,
                              m.module,
                              defs_of,
                              facts.elaboration.members.filter(|s: MemberSite| s.module == i),
                            );
                            let emitted = known_body(owner, [], l.code);
                            let lambdas = lambdas_of(emitted);
                            match lambdas.concat(named_in(m.name, here, imports, emitted)).at(nth) {
                              None -> None,
                              Some(code) ->
                                Some({
                                  owner: owner,
                                  nth: nth,
                                  code: code,
                                  named: nth >= lambdas.len(),
                                  module: m.name,
                                  here: here,
                                  imports: imports,
                                  effects: effects_in(x.r, i, mods),
                                  // Typed with its owner's whole body, which is what types its captures.
                                  typed: node_types(
                                    if of.args.len() == 0 { typed_in(facts, i) }
                                    else { typed_at(typed_in(facts, i), of.args) },
                                    param_types(d, source.sig),
                                    l.code,
                                  ),
                                  operands: source.operands,
                                  base: d.span.start,
                                }),
                            }
                          },
                        }
                      },
                    }
                  },
                }
              };
              range(0, mods.len()).fold([], |acc: List<Emitted>, i: Int|
                match mods.at(i) {
                  None -> acc,
                  Some(m) -> if !lowers(lowered, m.name) { acc } else {
                    emit_module(
                      m.name,
                      m.module,
                      ctors,
                      builtins,
                      program,
                      schemes,
                      pure,
                      effects_in(x.r, i, mods),
                      release,
                      wanted,
                      {
                        labels: sites_in(facts.label_sites, i),
                        operands: operands_in(facts.operands, i),
                        typed: typed_in(facts, i),
                        ops: facts.elaboration.ops.filter(|o: WitnessOp| o.module == i),
                        members: facts.elaboration.members.filter(|s: MemberSite| s.module == i),
                      },
                      x.r,
                      i,
                      mods,
                      lambda_at,
                    ).fold(acc, |a: List<Emitted>, e: Emitted| a.push(calling_instances(stated, e)))
                  },
                })
            },
          }
        },
      }
    },
  }
}

/// Each constructor whose type's module states a `key`, which its values are compared by.
fn keyed_tags(mods: List<ParsedModule>) -> List<Bytes> =
  mods.fold([], |acc: List<Bytes>, m: ParsedModule|
    m.module.items.fold(acc, |a: List<Bytes>, item: Item|
      match item {
        IInstance(d) -> if d.kind != NKey { a }
        else { a.concat(stating(m, Map::new(), d.target.name, [d.by.name]).keys()) },
        _ -> a,
      }))

/// Each constructor whose type's module states a `key` or a `show`, with those functions under
/// their program-wide names.
fn stated_by_tag(mods: List<ParsedModule>) -> Map<Bytes, List<Bytes>> =
  mods.fold(Map::new(), |acc: Map<Bytes, List<Bytes>>, m: ParsedModule|
    m.module.items.fold(acc, |a: Map<Bytes, List<Bytes>>, item: Item|
      match item {
        IInstance(d) -> stating(m, a, d.target.name, [d.by.name]),
        INumeric(d) -> stating(m, a, d.target.name, d.ops.map(|x: NumericOp| x.by.name)),
        _ -> a,
      }))

/// `stated` with `fns` of module `m` under each constructor of its type `target`.
fn stating(
  m: ParsedModule,
  stated: Map<Bytes, List<Bytes>>,
  target: Bytes,
  fns: List<Bytes>,
) -> Map<Bytes, List<Bytes>> =
  m.module.items.fold(stated, |b: Map<Bytes, List<Bytes>>, other: Item|
    match other {
      IType(t) -> if t.name.name != target { b } else {
        match t.body {
          TDSum(variants) ->
            variants.fold(b, |c: Map<Bytes, List<Bytes>>, v: VariantDef| {
              let tag = qualify(m.name, v.name.name);
              c.insert(
                tag,
                fns.fold(
                  match c.get(tag) { Some(fs) -> fs, None -> [] },
                  |fs: List<Bytes>, f: Bytes| fs.push(qualify(m.name, f)),
                ),
              )
            }),
          _ -> b,
        }
      },
      _ -> b,
    })

/// The constructors a body's C names a tag of, as its placeholders spell them.
fn tags_named(text: Bytes) -> List<Bytes> / {abort.raise} =
  iterate({ from: 0, out: [] }, text.len() + 1, |s: { from: Int, out: List<Bytes> }|
    match text.index_of_from(b"@@", s.from) {
      None -> Stop(s.out),
      Some(open) -> match text.index_of_from(b"@@", open + 2) {
        None -> Stop(s.out),
        Some(close) ->
          Continue({
            from: close + 2,
            out: if text.at(open + 2) == 84 { s.out.push(text.slice(open + 3, close)) }
            else { s.out },
          }),
      },
    })

/// A body that names a constructor's tag holds values the runtime reads through what the type's
/// module states of it, wherever they are compared or shown: so it calls those functions, which the
/// unit then takes with it and a kept answer is checked against.
fn calling_instances(stated: Map<Bytes, List<Bytes>>, e: Emitted) -> Emitted / {abort.raise} =
  if stated.len() == 0 { e } else {
    match e.why {
      Some(_) -> e,
      None ->
        {
          ..e,
          tables: {
            ..e.tables,
            calls: tags_named(e.text).fold(e.tables.calls, |acc: List<Bytes>, tag: Bytes|
              match stated.get(tag) {
                None -> acc,
                Some(fs) ->
                  fs.fold(acc, |calls: List<Bytes>, f: Bytes|
                    if calls.contains(f) { calls } else { calls.push(f) }),
              }),
          },
        },
    }
  }

/// One import's module as it is written and as it resolves: a dependency's sibling import is
/// written bare and means the module of the same package, which the scope's binders name.
fn resolved_path(
  resolved: Resolved,
  index: Int,
  mods: List<ParsedModule>,
  j: Int,
  written: Bytes,
) -> Bytes / {abort.raise} =
  match resolved.imports.get(index).at(j) { Some(t) -> mods.get(t).name, None -> written }

fn resolved_imports(
  resolved: Resolved,
  index: Int,
  mods: List<ParsedModule>,
  x_module: Module,
  defs_of: (Bytes) -> List<Def>,
  members: List<MemberSite>,
) -> List<Imported> / {abort.raise} = {
  let written = range(0, x_module.imports.len()).fold([], |acc: List<Imported>, j: Int| {
    let im = x_module.imports.get(j);
    let full = resolved_path(
      resolved,
      index,
      mods,
      j,
      bytes_join_dots(im.path.map(|i: Ident| i.name)),
    );
    match im.kind {
      INames(ns) ->
        ns.fold(acc, |a: List<Imported>, n: Ident|
          a.push({ name: n.name, module: full, defs: defs_of(full), whole: false })),
      IModule ->
        acc.push({ name: last_segment(im.path), module: full, defs: defs_of(full), whole: true }),
      // A module the parser imports for names read with no import names each the resolver bound
      // to it.
      IAlias(a2) ->
        freed_by(a2.name).fold(
          acc.push({ name: a2.name, module: full, defs: defs_of(full), whole: true }),
          |a: List<Imported>, n: Bytes|
            match resolved.scopes.at(index) {
              Some(sc) -> match lookup(sc.bound, ValueSpace, n) {
                Some(b) -> if b.qualified != qualify(full, n) { a }
                else { a.push({ name: n, module: full, defs: defs_of(full), whole: false }) },
                None -> a,
              },
              None -> a,
            },
        ),
    }
  });
  // A function of a type is named through a binder of its module no import wrote, and so is
  // each name of a default a call on a value copied.
  let through = members.fold(written, |acc: List<Imported>, m: MemberSite|
    List::concat(match of_module(m.qualifier) { Some(home) -> [home], None -> [] }, m.reaches).fold(
      acc,
      |a: List<Imported>, home: Bytes|
        match module_import(a, of_binder(home)) {
          Some(_) -> a,
          None -> a.push({ name: of_binder(home), module: home, defs: defs_of(home), whole: true }),
        },
    ));
  // A default copied into a call names its own module through a binder no import wrote.
  match resolved.scopes.at(index) {
    None -> through,
    Some(scope) ->
      scope.modules.fold(through, |acc: List<Imported>, mb: ModuleBinding|
        match module_import(acc, mb.binder) {
          Some(_) -> acc,
          None -> {
            let full = mods.get(mb.target).name;
            acc.push({ name: mb.binder, module: full, defs: defs_of(full), whole: true })
          },
        }),
  }
}

/// The labels each call in this module fills, keyed by the call's span, which the lowering reads.
fn sites_in(all: List<LabelSite>, module: Int) -> Map<Bytes, List<Bytes>> =
  all.fold(Map::new(), |acc: Map<Bytes, List<Bytes>>, site: LabelSite|
    if site.module != module { acc } else { acc.insert(span_key(site.span), site.labels) })

/// Each operator's operand type in this module, by its span. A default argument is written in its
/// own module's positions, so two sites can share a span: where their types differ, neither is read.
fn operands_in(all: List<OperandSite>, module: Int) -> Map<Bytes, Bytes> =
  all.fold(Map::new(), |acc: Map<Bytes, Bytes>, site: OperandSite|
    if site.module != module { acc } else {
      let key = span_key(site.span);
      match acc.get(key) {
        None -> acc.insert(key, site.ty),
        Some(t) -> if t == site.ty { acc } else { acc.insert(key, unsettled()) },
      }
    })

/// Never a type's name.
fn unsettled() -> Bytes = b"?"

/// Each typed site in this module, by its span. A default argument is written in its own module's
/// positions, so two sites can share a span: where they differ, neither is read.
fn typed_in(facts: EmitFacts, module: Int) -> Map<Bytes, Typed> =
  facts.typed.fold(
    { sites: Map::new(), read: Map::new() },
    |acc: { sites: Map<Bytes, Typed>, read: Map<Bytes, Type> }, site: TypedSite|
      if site.module != module { acc } else {
        let own = type_at(facts.types, site.ty, acc.read);
        let args = site.args.fold(
          { tys: [], read: own.read },
          |a: { tys: List<Type>, read: Map<Bytes, Type> }, k: Bytes| {
            let t = type_at(facts.types, k, a.read);
            { tys: a.tys.push(t.ty), read: t.read }
          },
        );
        let key = span_key(site.span);
        let here = filed_as(own.ty, args.tys);
        {
          sites: match acc.sites.get(key) {
            None -> acc.sites.insert(key, here),
            Some(t) -> if t == here { acc.sites }
            else { acc.sites.insert(key, filed_as(unknown_type(), [])) },
          },
          read: args.read,
        }
      },
  ).sites

/// What the front end's check read, or nothing when its answer carried none or one this program does
/// not read.
fn walked_read(walked: Bytes) -> Option<WalkedFacts> / {abort.raise} =
  if walked.len() == 0 { None }
  else { match bin::decode(walked, walked_facts_bin()) { Ok(w) -> Some(w), Err(_) -> None } }

/// What the checker filed of one module's sites, by span: each call's labels, each operator's
/// operand type, each typed site, and each operator done through a witness.
type SitesRead = {
  labels: Map<Bytes, List<Bytes>>,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
  ops: List<WitnessOp>,
  members: List<MemberSite>,
}

fn emit_module(
  module: Bytes,
  x_module: Module,
  ctors: Ctors,
  builtins: List<Bytes>,
  program: List<ModuleDefs>,
  schemes: Map<Bytes, Scheme>,
  pure: Map<Bytes, Bool>,
  effects: List<EffectName>,
  release: Bool,
  wanted: Option<Map<Bytes, Bool>>,
  read: SitesRead,
  resolved: Resolved,
  index: Int,
  mods: List<ParsedModule>,
  lambda_at: (Bytes, Int) -> Option<BoundLambda> / {abort.raise},
) -> List<Emitted> / {abort.raise} = {
  let sites = read.labels;
  let operands = read.operands;
  let typed = read.typed;
  let ops = read.ops;
  let x = { module: x_module };
  let defs_of = |path: Bytes|
    program.fold([], |acc: List<Def>, md: ModuleDefs|
      if md.module == path { md.defs } else { acc });
  let imports = resolved_imports(resolved, index, mods, x_module, defs_of, read.members);
  let here = defs_in(module, x.module, pure, schemes);
  let fns = x.module.items.fold([], |acc: List<Prepared>, item: Item|
    match item { IFn(d) -> acc.push(prepare(module, schemes, wanted, sites, d)), _ -> acc });
  let groups = tail_groups(module, here, fns);
  let walked = x.module.items.fold({ out: [], fns: 0 }, |acc: Walk, item: Item|
    match item {
      IFn(d) -> {
        let p = match fns.at(acc.fns) {
          Some(q) -> q,
          None -> prepare(module, schemes, wanted, sites, d),
        };
        let specialisations = specialisations_wanted(wanted, p.full).fold(
          acc.out,
          |a: List<Emitted>, sp: { args: List<Type>, fns: List<FnArg> }|
            a.push(
              specialised_emitted(
                module,
                d,
                sp.args,
                sp.fns,
                lambda_at,
                schemes,
                ops,
                sites,
                held_whole(here, tail_cycle(module, here, sites, x.module.items, d)),
                imports,
                ctors,
                builtins,
                effects,
                release,
                operands,
                typed,
              ),
            ),
        );
        let out = match group_of(groups, acc.fns) {
          None -> if !wants(wanted, p.full) { specialisations } else {
            specialisations.push(
              witnessed_needs(
                emitted_from(
                  module,
                  p.base,
                  here,
                  imports,
                  ctors,
                  builtins,
                  effects,
                  release,
                  operands,
                  typed,
                  p.full,
                  p.ps,
                  p.known,
                  p.body,
                  p.code,
                ),
                d,
                schemes.get(p.full),
                ops,
              ),
            )
          },
          // The group is emitted where its first member stands; the others are its cases.
          Some(g) -> if g.at(0) != Some(acc.fns) { specialisations } else {
            group_emitted(
              module,
              here,
              imports,
              ctors,
              builtins,
              effects,
              release,
              operands,
              typed,
              g.map(|i: Int| match fns.at(i) { Some(q) -> q, None -> p }),
            ).fold(specialisations, |a: List<Emitted>, e: Emitted| a.push(e))
          },
        };
        clause_roots(
          { out: out, fns: acc.fns + 1 },
          d,
          p.names,
          p.kinds,
          module,
          here,
          imports,
          ctors,
          builtins,
          effects,
          release,
          operands,
          typed,
          sig_of(schemes, qualify(module, d.name.name)),
          wanted,
          sites,
        )
      },
      // A test is a root named by its label: nullary, or over cases entered with a case's place
      // and identity beside a nullary root that lists them.
      ITest(t) -> {
        let full = test_owner(module, t.name);
        let ps = if t.cases == None { [] } else {
          [
            {
              name: case_at(),
              kind: KInt,
              ty: TyOpen([]),
              of: None,
              carrier: Whole(KBoxed),
              lambda: None,
            },
            {
              name: case_identity(),
              kind: KBoxed,
              ty: TyBytes,
              of: None,
              carrier: Whole(KBoxed),
              lambda: None,
            },
          ]
        };
        let rooted = |name: Bytes, taken: List<EmitParam>, body: Expr|
          root_emitted(
            module,
            t.span.start,
            here,
            imports,
            ctors,
            builtins,
            effects,
            release,
            operands,
            typed,
            name,
            taken.map(|p: EmitParam| p.name),
            taken,
            true,
            sites,
            body,
          );
        let run = if !wants(wanted, full) { acc.out }
        else { acc.out.push(rooted(full, ps, test_run(t))) };
        let out = match t.cases {
          None -> run,
          Some(c) -> if !wants(wanted, cases_root(full)) { run }
          else { run.push(rooted(cases_root(full), [], test_listing(c))) },
        };
        { out: out, fns: acc.fns }
      },
      // A law's guard and body are roots the judge enters with the binders' values.
      ILaw(d) -> {
        let names = d.binders.map(|binder: Binder| binder.name.name);
        let kinds = d.binders.map(|binder: Binder| Some(typed_kind(typed, binder.name.span)));
        let ps = params_of(names, kinds);
        let known = kinds.fold(true, |acc2: Bool, k: Option<{ kind: Kind, ty: Ty }>|
          acc2 && k != None);
        let part = |which: Bytes| law_root(module, d.name, which);
        let with_guard = match d.guard {
          None -> acc.out,
          Some(g) -> if !wants(wanted, part(b"guard")) { acc.out } else {
            acc.out.push(
              root_emitted(
                module,
                d.span.start,
                here,
                imports,
                ctors,
                builtins,
                effects,
                release,
                operands,
                typed,
                part(b"guard"),
                names,
                ps,
                known,
                sites,
                g,
              ),
            )
          },
        };
        {
          out: if !wants(wanted, part(b"body")) { with_guard } else {
            with_guard.push(
              root_emitted(
                module,
                d.span.start,
                here,
                imports,
                ctors,
                builtins,
                effects,
                release,
                operands,
                typed,
                part(b"body"),
                names,
                ps,
                known,
                sites,
                d.body,
              ),
            )
          },
          fns: acc.fns,
        }
      },
      // A sum some body compares or orders is compared through a root written from its
      // constructors, written only where a body's call asks for it, not with every root a whole
      // emission takes.
      IType(t) -> {
        let named = qualify(module, t.name.name);
        let asked = |root: Bytes| match wanted { Some(w) -> w.contains(root), None -> false };
        // At its own name, and at each list of arguments a body asked for one at.
        let at_types = match wanted {
          Some(w) ->
            w.keys().fold(
              [],
              |acc2: List<{ root: Bytes, eq: Bool, args: List<Type> }>, n: Bytes|
                if !n.starts_with(named.concat(b"<")) { acc2 } else {
                  let eq = n.ends_with(b"#eq");
                  if !eq && !n.ends_with(b"#cmp") { acc2 } else {
                    match type_spelled(n.slice(0, n.len() - (if eq { 3 } else { 4 }))) {
                      Some(TyCon(c)) -> acc2.push({ root: n, eq: eq, args: c.args }),
                      _ -> acc2,
                    }
                  }
                },
            ),
          None -> [],
        };
        match ctors.sums.get(named) {
          None -> acc,
          Some(declared) ->
            [
              {
                root: equality_root(named),
                asked: asked(equality_root(named)),
                eq: true,
                args: [],
              },
              {
                root: ordering_root(named),
                asked: asked(ordering_root(named)),
                eq: false,
                args: [],
              },
            ].concat(
              at_types.map(|x: { root: Bytes, eq: Bool, args: List<Type> }|
                { root: x.root, asked: true, eq: x.eq, args: x.args }),
            ).fold(acc, |a2: Walk, d: { root: Bytes, asked: Bool, eq: Bool, args: List<Type> }|
              if !d.asked { a2 } else {
                let cs = if d.args.len() == 0 { declared } else {
                  declared.map(|c: SumCtor|
                    { ..c, fields: c.fields.map(|f: Type| at_args(f, c.params, d.args)) })
                };
                let e = if d.eq { equality_code(cs) } else { ordering_code(cs) };
                let word = |n: Bytes|
                  {
                    name: n,
                    kind: KBoxed,
                    ty: TyOpen([]),
                    of: None,
                    carrier: Whole(KBoxed),
                    lambda: None,
                  };
                {
                  ..a2,
                  out: a2.out.push(
                    emitted_from(
                      module,
                      t.span.start,
                      here,
                      imports,
                      ctors,
                      builtins,
                      effects,
                      release,
                      e.operands.fold(operands, |m: Map<Bytes, Bytes>, k: Bytes, v: Bytes|
                        m.insert(k, v)),
                      e.typed.fold(typed, |m: Map<Bytes, Typed>, k: Bytes, v: Typed|
                        m.insert(k, v)),
                      d.root,
                      [word(b"a"), word(b"b")],
                      true,
                      ELit({ span: t.span, lit: LBool(false) }),
                      Some(e.code),
                    ),
                  ),
                }
              }),
        }
      },
      _ -> acc,
    });
  // A type some body reflects or digests is written for by a root, in this module where the body's
  // call names it.
  let written = match wanted {
    None -> [],
    Some(w) ->
      w.keys().fold([], |acc: List<{ root: Bytes, op: Bytes, ty: Type }>, n: Bytes|
        match written_root_of(n) {
          Some(r) -> if r.module == module { acc.push({ root: n, op: r.op, ty: r.ty }) }
          else { acc },
          None -> acc,
        }),
  };
  written.fold(walked.out, |out: List<Emitted>, r: { root: Bytes, op: Bytes, ty: Type }|
    if container_ops().contains(r.op) || walked_container(r.ty) {
      let e = container_code(module, r.op, r.ty);
      let word = |n: Bytes|
        {
          name: n,
          kind: KBoxed,
          ty: kind_of(r.ty).ty,
          of: Some(r.ty),
          carrier: Whole(KBoxed),
          lambda: None,
        };
      let index = {
        name: b"i",
        kind: KInt,
        ty: TyOpen([]),
        of: Some(int_type()),
        carrier: Whole(KInt),
        lambda: None,
      };
      out.push(
        emitted_from(
          module,
          0,
          here.concat(e.here),
          imports,
          ctors,
          builtins,
          effects,
          release,
          e.operands.fold(operands, |m: Map<Bytes, Bytes>, k: Bytes, v: Bytes| m.insert(k, v)),
          e.typed.fold(typed, |m: Map<Bytes, Typed>, k: Bytes, v: Typed| m.insert(k, v)),
          r.root,
          if r.op.ends_with(b"_from") { [word(b"a"), word(b"b"), index] }
          else if r.op == b"equal" || r.op == b"ordered" { [word(b"a"), word(b"b")] }
          else { [word(b"a")] },
          true,
          ELit({ span: dummy_span(), lit: LBool(false) }),
          Some(e.code),
        ),
      )
    } else {
      let e = if r.op == b"digest" { digest_code(module, ctors, here, x.module.items, r.ty) }
      else { reflection_code(module, ctors, here, x.module.items, r.op == b"shown", r.ty) };
      let held = kind_of(r.ty);
      let word = reflected_kind(r.ty);
      out.push(
        emitted_from(
          module,
          0,
          here,
          imports,
          ctors,
          builtins,
          effects,
          release,
          operands,
          e.typed.fold(typed, |m: Map<Bytes, Typed>, k: Bytes, v: Typed| m.insert(k, v)),
          r.root,
          [{ name: b"a", kind: word, ty: held.ty, of: None, carrier: Whole(word), lambda: None }],
          true,
          ELit({ span: dummy_span(), lit: LBool(false) }),
          Some(e.code),
        ),
      )
    })
}

/// The builtin a name in code the emitter writes from a type calls: `?` and the builtin's name,
/// which no definition or import of the module the code is written in can take.
fn generated_builtin(name: Bytes) -> Bytes =
  if name == b"?compare" { b"compare" }
  else if name == b"?reflect" { b"reflect" }
  else if name == b"?shown" { b"shown" }
  else if name == b"?concat" { b"Bytes::concat_all" }
  else { name }

/// `why` is the refusal's reason, and then `text` and `tables` are empty.
pub type Emitted = {
  name: Bytes,
  text: Bytes,
  tables: Tables,
  why: Option<Bytes>,
  handles: List<Bytes>,
}

type Walk = { out: List<Emitted>, fns: Int }

/// A definition lowered once, for grouping and for emission; `code` is `None` when it is not wanted or does not lower.
type Prepared = {
  full: Bytes,
  base: Int,
  names: List<Bytes>,
  kinds: List<Option<{ kind: Kind, ty: Ty }>>,
  ps: List<EmitParam>,
  known: Bool,
  body: Expr,
  code: Option<Code>,
}

/// A label parameter is a hidden trailing `Int`: the caller passes the resource's field-table entry.
fn prepare(
  module: Bytes,
  schemes: Map<Bytes, Scheme>,
  wanted: Option<Map<Bytes, Bool>>,
  sites: Map<Bytes, List<Bytes>>,
  def: FnDef,
) -> Prepared / {abort.raise} = {
  let names = def.params.map(|param: Param| param.name.name);
  let kinds = param_kinds(def, sig_of(schemes, qualify(module, def.name.name))).map(
    |k: { kind: Kind, ty: Ty }| Some(k),
  );
  let labels = def.generics.labels.map(|ident: Ident| ident.name);
  let all_names = labels.fold(names, |acc: List<Bytes>, n: Bytes| acc.push(n));
  let all_kinds = labels.fold(kinds, |acc: List<Option<{ kind: Kind, ty: Ty }>>, n: Bytes|
    acc.push(Some({ kind: KInt, ty: TyOpen([]) })));
  let known = kinds.fold(true, |acc: Bool, k: Option<{ kind: Kind, ty: Ty }>| acc && k != None);
  let full = qualify(module, def.name.name);
  {
    full: full,
    base: def.span.start,
    names: names,
    kinds: kinds,
    ps: params_carried(
      all_names,
      all_kinds,
      carriers_of(def, sig_of(schemes, full)).params,
      param_types(def, sig_of(schemes, full)),
    ),
    known: known,
    body: def.body,
    code: if known && wants(wanted, full) {
      match lower_to_emit(names, labels, sites, def.body, of_binder(module)) {
        Some(l) -> Some(l.code),
        None -> None,
      }
    } else { None },
  }
}

/// The other definitions of the module whose tail calls lead from `def` round to it again, each
/// lowered as far as the walk reaches, wanted or not: the members of the loop `def` runs in.
fn tail_cycle(
  module: Bytes,
  here: List<Def>,
  sites: Map<Bytes, List<Bytes>>,
  items: List<Item>,
  def: FnDef,
) -> List<Bytes> / {abort.raise} = {
  let fns = items.fold(Map::new(), |acc: Map<Bytes, FnDef>, item: Item|
    match item { IFn(d) -> acc.insert(d.name.name, d), _ -> acc });
  let callees = |name: Bytes|
    match fns.get(name) {
      None -> [],
      Some(d) -> match lower_to_emit(
          d.params.map(|param: Param| param.name.name),
          d.generics.labels.map(|ident: Ident| ident.name),
          sites,
          d.body,
          of_binder(module),
        ) {
        Some(l) -> tail_callees(here, l.code, []),
        None -> [],
      },
    };
  let own = def.name.name;
  let edges = iterate(
    { edges: Map::new(), work: [own] },
    1000000,
    |s: { edges: Map<Bytes, List<Bytes>>, work: List<Bytes> }|
      match s.work {
        [] -> Stop(s),
        [n, ..rest] -> if s.edges.contains(n) { Continue({ ..s, work: rest }) } else {
          let out = callees(n);
          Continue({ edges: s.edges.insert(n, out), work: rest.concat(out) })
        },
      },
  ).edges;
  let back = iterate(Map::new().insert(own, true), edges.len() + 1, |seen: Map<Bytes, Bool>| {
    let more = edges.fold(seen, |acc: Map<Bytes, Bool>, n: Bytes, out: List<Bytes>|
      if acc.contains(n) || !out.fold(false, |b: Bool, m: Bytes| b || acc.contains(m)) { acc }
      else { acc.insert(n, true) });
    if more.len() == seen.len() { Stop(seen) } else { Continue(more) }
  });
  back.keys().filter(|n: Bytes| n != own)
}

/// `here` with each definition named in `names` as a call reaches one that takes no type parameter:
/// as it stands, at no specialisation.
fn held_whole(here: List<Def>, names: List<Bytes>) -> List<Def> =
  if names.len() == 0 { here }
  else { here.map(|d: Def| if names.contains(d.name) { { ..d, scheme: None } } else { d }) }

/// The module's definitions in tail-call cycles of two or more, each cycle's members in module order: a call in tail
/// position of one member from another is an edge, so a group is exactly what can run as one loop. A member holding a
/// `handle` keeps the whole cycle out, and only wanted, lowered definitions have edges, so every member is emitted.
fn tail_groups(
  module: Bytes,
  here: List<Def>,
  fns: List<Prepared>,
) -> List<List<Int>> / {abort.raise} = {
  let fulls = fns.map(|p: Prepared| p.full);
  let adj = fns.map(|p: Prepared|
    match p.code {
      None -> [],
      Some(c) ->
        tail_callees(here, c, []).fold([], |acc: List<Int>, nm: Bytes|
          match position_of(fulls, qualify(module, nm)) {
            None -> acc,
            Some(i) -> if acc.fold(false, |seen: Bool, j: Int| seen || j == i) { acc }
            else { acc.push(i) },
          }),
    });
  graph::components({ out: adj }).map(|c: List<Int>| sorted_widths(c)).filter(|c: List<Int>|
    c.len() >= 2 && c.fold(true, |ok: Bool, i: Int| ok && loops_as_case(fns, i)))
}

fn loops_as_case(fns: List<Prepared>, i: Int) -> Bool =
  match fns.at(i) {
    Some(p) -> match p.code { Some(code) -> !has_handle(code), None -> false },
    None -> false,
  }

fn group_of(groups: List<List<Int>>, i: Int) -> Option<List<Int>> =
  groups.fold(None, |acc: Option<List<Int>>, g: List<Int>|
    if g.fold(false, |seen: Bool, j: Int| seen || j == i) { Some(g) } else { acc })

/// The same-module definitions called in tail position, walking the positions `tail` is kept into.
fn tail_callees(here: List<Def>, code: Code, acc: List<Bytes>) -> List<Bytes> / {abort.raise} =
  match code.node {
    NApp(a) -> match a.func.node {
      NVar(fv) -> if fv.slot == None && !is_ctor_name(fv.name)
          && here.fold(false, |ok: Bool, h: Def|
            ok || (h.name == fv.name && h.arity == a.args.len())) { acc.push(fv.name) }
      else { acc },
      _ -> acc,
    },
    NBinary(b) -> if b.op == b"and" || b.op == b"or" { tail_callees(here, b.rhs, acc) }
    else { acc },
    NIf(i) -> tail_callees(here, i.else_branch, tail_callees(here, i.then_branch, acc)),
    NBlock(b) -> match b.tail { Some(t) -> tail_callees(here, t, acc), None -> acc },
    NMatch(m) -> m.arms.fold(acc, |a: List<Bytes>, arm: CodeArm| tail_callees(here, arm.body, a)),
    _ -> acc,
  }

/// The lambdas `c` writes, at any depth, each before those its body writes, in one fixed order.
fn lambdas_of(c: Code) -> List<Lambda> = {
  let within = |codes: List<Code>|
    codes.fold([], |acc: List<Lambda>, x: Code| acc.concat(lambdas_of(x)));
  match c.node {
    NLambda(l) -> [l].concat(lambdas_of(l.body)),
    NUnary(u) -> lambdas_of(u.operand),
    NBinary(b) -> within([b.lhs, b.rhs]),
    NField(f) -> lambdas_of(f.base),
    NApp(a) -> within(a.args.push(a.func)),
    NIf(i) -> within([i.cond, i.then_branch, i.else_branch]),
    NBlock(b) ->
      within(
        b.stmts.fold(
          match b.tail { Some(t) -> [t], None -> [] },
          |acc: List<Code>, stmt: CodeStmt|
            acc.push(match stmt { CLet(l) -> l.value, CLetPat(l) -> l.value, CDo(d) -> d.code }),
        ),
      ),
    NList(l) -> within(l.items),
    NRecord(r) -> within(r.fields.map(|f: CodeField| f.value)),
    NUpdate(u) -> within(u.sets.map(|f: CodeField| f.value).push(u.base)),
    NMatch(m) ->
      within(
        m.arms.fold([m.scrutinee], |acc: List<Code>, a: CodeArm|
          List::push(match a.guard { Some(g) -> acc.push(g), None -> acc }, a.body)),
      ),
    NPerform(x) -> within(x.args),
    NSimulate(x) -> lambdas_of(x.body),
    NParallel(x) -> within(x.branches),
    NHandle(h) ->
      within(
        h.clauses.fold(
          match h.ret { Some(r) -> [h.body, r.body], None -> [h.body] },
          |acc: List<Code>, cl: CodeClause| acc.push(cl.body),
        ),
      ),
    _ -> [],
  }
}

/// Where `l` first stands in `ls`.
fn position_in(ls: List<Lambda>, l: Lambda) -> Option<Int> =
  range(0, ls.len()).fold(None, |acc: Option<Int>, k: Int|
    match acc { Some(_) -> acc, None -> if ls.at(k) == Some(l) { Some(k) } else { None } })

/// What a root of `module` lends: the lambdas its `body` writes, and then each definition it hands
/// a definition as a value, as the lambda around a call of it.
fn written_in(
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  body: Code,
) -> List<Lambda> / {abort.raise} = lambdas_of(body).concat(named_in(module, here, imports, body))

/// How many arguments the definition `c` names as a value takes; none where `c` is not a
/// definition named as a value, or takes a witness or a label a call would fill.
fn named_arity(
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  c: Code,
) -> Option<Int> / {abort.raise} =
  match c.node {
    NVar(v) -> if v.slot != None { None } else {
      match def_in(module, here, imports, v.name) {
        Some(d) -> match d.scheme {
          Some(sc) -> match sc.ty {
            TyFn(f) -> if d.def.witnesses == 0 && f.params.len() == d.arity { Some(d.arity) }
            else { None },
            _ -> None,
          },
          None -> None,
        },
        None -> None,
      }
    },
    _ -> None,
  }

/// The lambda around a call of the definition `c` names, which takes `n` arguments. The call is
/// each parameter's only read, so it hands each one on.
fn named_lambda(c: Code, n: Int) -> Lambda = {
  let at = |own: Own, node: Node| { own: own, node: node, span: c.span };
  {
    params: n,
    size: n,
    captures: [],
    at: c.span,
    body: at(
      Borrowed,
      NApp({
        func: { ..c, own: Borrowed },
        args: range(0, n).map(|i: Int|
          at(Owned, NVar({ name: b"p".concat(ascii_of_int(i)), slot: Some(i) }))),
      }),
    ),
  }
}

/// Each definition `c` hands a definition as a value, as `named_lambda` reads it, in one fixed
/// order.
fn named_in(
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  c: Code,
) -> List<Lambda> / {abort.raise} = {
  let within = |codes: List<Code>|
    codes.fold([], |acc: List<Lambda>, x: Code| acc.concat(named_in(module, here, imports, x)));
  match c.node {
    NApp(a) -> {
      let callee = match a.func.node {
        NVar(v) -> v.slot == None && def_in(module, here, imports, v.name) != None,
        _ -> false,
      };
      let handed = if !callee { [] } else {
        a.args.fold([], |acc: List<Lambda>, x: Code|
          match named_arity(module, here, imports, x) {
            Some(n) -> acc.push(named_lambda(x, n)),
            None -> acc,
          })
      };
      handed.concat(within(a.args.push(a.func)))
    },
    NLambda(l) -> named_in(module, here, imports, l.body),
    NUnary(u) -> named_in(module, here, imports, u.operand),
    NBinary(b) -> within([b.lhs, b.rhs]),
    NField(f) -> named_in(module, here, imports, f.base),
    NIf(i) -> within([i.cond, i.then_branch, i.else_branch]),
    NBlock(b) ->
      within(
        b.stmts.fold(
          match b.tail { Some(t) -> [t], None -> [] },
          |acc: List<Code>, stmt: CodeStmt|
            acc.push(match stmt { CLet(l) -> l.value, CLetPat(l) -> l.value, CDo(d) -> d.code }),
        ),
      ),
    NList(l) -> within(l.items),
    NRecord(r) -> within(r.fields.map(|f: CodeField| f.value)),
    NUpdate(u) -> within(u.sets.map(|f: CodeField| f.value).push(u.base)),
    NMatch(m) ->
      within(
        m.arms.fold([m.scrutinee], |acc: List<Code>, a: CodeArm|
          List::push(match a.guard { Some(g) -> acc.push(g), None -> acc }, a.body)),
      ),
    NPerform(x) -> within(x.args),
    NSimulate(x) -> named_in(module, here, imports, x.body),
    NParallel(x) -> within(x.branches),
    NHandle(h) ->
      within(
        h.clauses.fold(
          match h.ret { Some(r) -> [h.body, r.body], None -> [h.body] },
          |acc: List<Code>, cl: CodeClause| acc.push(cl.body),
        ),
      ),
    _ -> [],
  }
}

fn has_handle(c: Code) -> Bool = {
  let within = |codes: List<Code>| codes.fold(false, |acc: Bool, x: Code| acc || has_handle(x));
  match c.node {
    NHandle(_) -> true,
    NUnary(u) -> has_handle(u.operand),
    NBinary(b) -> within([b.lhs, b.rhs]),
    NField(f) -> has_handle(f.base),
    NApp(a) -> within(a.args.push(a.func)),
    NIf(i) -> within([i.cond, i.then_branch, i.else_branch]),
    NBlock(b) ->
      (match b.tail { Some(t) -> has_handle(t), None -> false })
        || b.stmts.fold(false, |acc: Bool, stmt: CodeStmt|
          acc
            || (match stmt {
              CLet(l) -> has_handle(l.value),
              CLetPat(l) -> has_handle(l.value),
              CDo(d) -> has_handle(d.code),
            })),
    NList(l) -> within(l.items),
    NRecord(r) -> within(r.fields.map(|f: CodeField| f.value)),
    NUpdate(u) -> within(u.sets.map(|f: CodeField| f.value).push(u.base)),
    NMatch(m) ->
      has_handle(m.scrutinee)
        || m.arms.fold(false, |acc: Bool, a: CodeArm|
          acc || (match a.guard { Some(g) -> has_handle(g), None -> false }) || has_handle(a.body)),
    NPerform(p) -> within(p.args),
    NLambda(l) -> has_handle(l.body),
    NSimulate(x) -> has_handle(x.body),
    NKnown(k) -> has_handle(k.lambda.body),
    NParallel(pr) -> within(pr.branches),
    _ -> false,
  }
}

/// Whether `c` matches parameter `i` against a list pattern whose rest a call of `own` hands back
/// as its argument `i`: a walk down the list a self call loops through.
fn walks_by_rest(c: Code, own: Bytes, i: Int) -> Bool = {
  let within = |codes: List<Code>|
    codes.fold(false, |acc: Bool, x: Code| acc || walks_by_rest(x, own, i));
  match c.node {
    NUnary(u) -> walks_by_rest(u.operand, own, i),
    NBinary(b) -> within([b.lhs, b.rhs]),
    NField(f) -> walks_by_rest(f.base, own, i),
    NApp(a) -> within(a.args.push(a.func)),
    NIf(x) -> within([x.cond, x.then_branch, x.else_branch]),
    NBlock(b) ->
      (match b.tail { Some(t) -> walks_by_rest(t, own, i), None -> false })
        || b.stmts.fold(false, |acc: Bool, stmt: CodeStmt|
          acc
            || (match stmt {
              CLet(l) -> walks_by_rest(l.value, own, i),
              CLetPat(l) -> walks_by_rest(l.value, own, i),
              CDo(d) -> walks_by_rest(d.code, own, i),
            })),
    NList(l) -> within(l.items),
    NRecord(r) -> within(r.fields.map(|f: CodeField| f.value)),
    NUpdate(u) -> within(u.sets.map(|f: CodeField| f.value).push(u.base)),
    NMatch(m) ->
      (match m.scrutinee.node {
          NVar(v) ->
            v.slot == Some(i)
              && m.arms.fold(false, |acc: Bool, arm: CodeArm|
                acc
                  || (match arm.pat {
                    PxList(l) -> match l.rest {
                      Some(PxVar(r)) -> match r.slot {
                        Some(slot) -> hands_back(arm.body, own, i, slot),
                        None -> false,
                      },
                      _ -> false,
                    },
                    _ -> false,
                  })),
          _ -> false,
        })
        || walks_by_rest(m.scrutinee, own, i)
        || m.arms.fold(false, |acc: Bool, arm: CodeArm|
          acc || (match arm.guard { Some(g) -> walks_by_rest(g, own, i), None -> false })
            || walks_by_rest(arm.body, own, i)),
    NPerform(p) -> within(p.args),
    NParallel(pr) -> within(pr.branches),
    _ -> false,
  }
}

/// Whether `c` calls `own` with the binder of slot `r` as its argument `i`.
fn hands_back(c: Code, own: Bytes, i: Int, r: Int) -> Bool = {
  let within = |codes: List<Code>|
    codes.fold(false, |acc: Bool, x: Code| acc || hands_back(x, own, i, r));
  match c.node {
    NApp(a) ->
      (match a.func.node {
          NVar(f) ->
            f.name == own && f.slot == None
              && (match a.args.at(i) {
                Some(arg) -> match arg.node { NVar(v) -> v.slot == Some(r), _ -> false },
                None -> false,
              }),
          _ -> false,
        })
        || within(a.args.push(a.func)),
    NUnary(u) -> hands_back(u.operand, own, i, r),
    NBinary(b) -> within([b.lhs, b.rhs]),
    NField(f) -> hands_back(f.base, own, i, r),
    NIf(x) -> within([x.cond, x.then_branch, x.else_branch]),
    NBlock(b) ->
      (match b.tail { Some(t) -> hands_back(t, own, i, r), None -> false })
        || b.stmts.fold(false, |acc: Bool, stmt: CodeStmt|
          acc
            || (match stmt {
              CLet(l) -> hands_back(l.value, own, i, r),
              CLetPat(l) -> hands_back(l.value, own, i, r),
              CDo(d) -> hands_back(d.code, own, i, r),
            })),
    NMatch(m) ->
      hands_back(m.scrutinee, own, i, r)
        || m.arms.fold(false, |acc: Bool, arm: CodeArm|
          acc || (match arm.guard { Some(g) -> hands_back(g, own, i, r), None -> false })
            || hands_back(arm.body, own, i, r)),
    _ -> false,
  }
}

/// A group's one body under its first member's name, or, when a member does not emit, each member on its own.
fn group_emitted(
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  ctors: Ctors,
  builtins: List<Bytes>,
  effects: List<EffectName>,
  release: Bool,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
  members: List<Prepared>,
) -> List<Emitted> / {abort.raise} = {
  let ms = members.fold([], |acc: List<Member>, p: Prepared|
    match p.code {
      Some(c) -> acc.push({ full: p.full, base: p.base, params: p.ps, body: c }),
      None -> acc,
    });
  let first = match members.at(0) { Some(p) -> p.full, None -> b"" };
  let whole = if ms.len() == members.len() {
    emit_group_full(module, here, imports, ctors, builtins, ms, effects, release, operands, typed)
  } else { None };
  match whole {
    Some(c) -> [{ name: first, text: c.text, tables: c.tables, why: None, handles: [] }],
    None ->
      members.map(|p: Prepared|
        emitted_from(
          module,
          p.base,
          here,
          imports,
          ctors,
          builtins,
          effects,
          release,
          operands,
          typed,
          p.full,
          p.ps,
          p.known,
          p.body,
          p.code,
        )),
  }
}

fn params_of(names: List<Bytes>, kinds: List<Option<{ kind: Kind, ty: Ty }>>) -> List<EmitParam> =
  params_carried(names, kinds, [], [])

/// `params_of` with each parameter arriving as `carriers` says, and as a word past its end, and of
/// the type `types` gives it.
fn params_carried(
  names: List<Bytes>,
  kinds: List<Option<{ kind: Kind, ty: Ty }>>,
  carriers: List<Carrier>,
  types: List<Option<Type>>,
) -> List<EmitParam> =
  range(0, names.len()).map(|i: Int|
    {
      name: match names.at(i) { Some(n) -> n, None -> b"" },
      kind: match carriers.at(i) {
        Some(Whole(KSum(spec))) -> KSum(spec),
        _ -> match kinds.at(i) { Some(Some(p)) -> p.kind, _ -> KInt },
      },
      ty: match kinds.at(i) { Some(Some(p)) -> p.ty, _ -> TyOpen([]) },
      of: match types.at(i) { Some(t) -> t, None -> None },
      carrier: match carriers.at(i) { Some(c) -> c, None -> Whole(KBoxed) },
      lambda: None,
    })

/// One root's emission, definition, test or proposition alike. An unlowered body's handled operations are read off its source, so the fixpoint still drops their performers.
fn root_emitted(
  module: Bytes,
  base: Int,
  here: List<Def>,
  imports: List<Imported>,
  ctors: Ctors,
  builtins: List<Bytes>,
  effects: List<EffectName>,
  release: Bool,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
  full: Bytes,
  names: List<Bytes>,
  ps: List<EmitParam>,
  known: Bool,
  sites: Map<Bytes, List<Bytes>>,
  body: Expr,
) -> Emitted / {abort.raise} =
  emitted_from(
    module,
    base,
    here,
    imports,
    ctors,
    builtins,
    effects,
    release,
    operands,
    typed,
    full,
    ps,
    known,
    body,
    if known {
      match lower_to_emit(names, [], sites, body, of_binder(module)) {
        Some(l) -> Some(l.code),
        None -> None,
      }
    } else { None },
  )

fn emitted_from(
  module: Bytes,
  base: Int,
  here: List<Def>,
  imports: List<Imported>,
  ctors: Ctors,
  builtins: List<Bytes>,
  effects: List<EffectName>,
  release: Bool,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
  full: Bytes,
  ps: List<EmitParam>,
  known: Bool,
  body: Expr,
  code: Option<Code>,
) -> Emitted / {abort.raise} =
  match code {
    None ->
      {
        name: full,
        text: b"",
        tables: no_tables(),
        handles: ast_handles(body, effects),
        why: Some(if known { b"a body the lowering does not reach" }
        else { b"a parameter with no written type" }),
      },
    Some(lowered) -> {
      let c = known_body(full, ps, lowered);
      match emit_fn_full(
          module,
          base,
          here,
          imports,
          ctors,
          builtins,
          full,
          ps,
          c,
          effects,
          release,
          operands,
          typed,
        ) {
        None ->
          {
            name: full,
            text: b"",
            tables: no_tables(),
            handles: walk_handles(c, effects),
            why: emit_fn_why(
              module,
              base,
              here,
              imports,
              ctors,
              builtins,
              full,
              ps,
              c,
              effects,
              release,
              operands,
              typed,
            ),
          },
        Some(o) -> { name: full, text: o.text, tables: o.tables, why: None, handles: [] },
      }
    },
  }

/// `requires` and `ensures` clauses as roots: `<owner>#requires#<k>`, `<owner>#ensures#<k>`.
fn clause_roots(
  acc: Walk,
  def: FnDef,
  names: List<Bytes>,
  kinds: List<Option<{ kind: Kind, ty: Ty }>>,
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  ctors: Ctors,
  builtins: List<Bytes>,
  effects: List<EffectName>,
  release: Bool,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
  sig: Option<Sig>,
  wanted: Option<Map<Bytes, Bool>>,
  sites: Map<Bytes, List<Bytes>>,
) -> Walk / {abort.raise} = {
  let known = kinds.fold(true, |acc2: Bool, k: Option<{ kind: Kind, ty: Ty }>| acc2 && k != None);
  let clause = |kind: Bytes, k: Int|
    qualify(module, Bytes::concat_all([def.name.name, b"#", kind, b"#", ascii_of_int(k)]));
  let walked = def.spec.fold(
    { out: acc.out, requires: 0, ensures: 0 },
    |s: { out: List<Emitted>, requires: Int, ensures: Int }, c: SpecClause|
      match c.kind {
        SRequires -> {
          let full = clause(b"requires", s.requires);
          {
            out: if !wants(wanted, full) { s.out } else {
              s.out.push(
                root_emitted(
                  module,
                  def.span.start,
                  here,
                  imports,
                  ctors,
                  builtins,
                  effects,
                  release,
                  operands,
                  typed,
                  full,
                  names,
                  params_of(names, kinds),
                  known,
                  sites,
                  c.expr,
                ),
              )
            },
            requires: s.requires + 1,
            ensures: s.ensures,
          }
        },
        SEnsures -> match def.ret {
          None -> { out: s.out, requires: s.requires, ensures: s.ensures + 1 },
          Some(r) -> {
            let full = clause(b"ensures", s.ensures);
            let rnames = names.push(b"result");
            let rkinds = kinds.push(Some(match sig { Some(s) -> kind_of(s.ret), None -> boxed() }));
            let rknown = known;
            {
              out: if !wants(wanted, full) { s.out } else {
                s.out.push(
                  root_emitted(
                    module,
                    def.span.start,
                    here,
                    imports,
                    ctors,
                    builtins,
                    effects,
                    release,
                    operands,
                    typed,
                    full,
                    rnames,
                    params_of(rnames, rkinds),
                    rknown,
                    sites,
                    c.expr,
                  ),
                )
              },
              requires: s.requires,
              ensures: s.ensures + 1,
            }
          },
        },
        // A bound is read off the body, and never run.
        SCost -> s,
        SSpace -> s,
      },
  );
  { out: walked.out, fns: acc.fns }
}

fn concat_effects(a: List<EffectName>, b: List<EffectName>) -> List<EffectName> =
  b.fold(a, |acc: List<EffectName>, x: EffectName| acc.push(x))

/// The effect a clause names, program-wide: one a `try` wrote, the scope's, or the prelude's.
fn handled_effect(effects: List<EffectName>, written: Bytes) -> Option<Bytes> / {abort.raise} =
  match named_program_wide(written) {
    Some(global) -> Some(global),
    None ->
      concat_effects(effects, prelude_effects_here()).fold(
        None,
        |f: Option<Bytes>, en: EffectName| if en.written == written { Some(en.global) } else { f },
      ),
  }

/// The operations a body handles, read off its source, so a body the lowering did not reach still names them.
fn ast_handles(e: Expr, effects: List<EffectName>) -> List<Bytes> / {abort.raise} = {
  let here = |acc: List<Bytes>, x: Expr| acc.concat(ast_handles(x, effects));
  let all = |exprs: List<Expr>| exprs.fold([], here);
  match e {
    EHandle(h) -> {
      let inits = h.vars.fold([], |acc: List<Bytes>, v: HandlerVar| here(acc, v.init));
      let inner = h.clauses.fold(here(inits, h.body), |acc: List<Bytes>, clause: HandleClause|
        List::concat(
          match handled_effect(effects, qname_text(clause.eff)) {
            Some(g) -> acc.push(Bytes::concat_all([g, b"#", clause.op.name])),
            None -> acc,
          },
          ast_handles(clause.body, effects),
        ));
      match h.ret { Some(r) -> here(inner, r.body), None -> inner }
    },
    ESimulate(x) -> scheduled_ops().concat(ast_handles(x.body, effects)),
    EUnary(x) -> ast_handles(x.operand, effects),
    EBinary(x) -> all([x.lhs, x.rhs]),
    ELambda(x) -> ast_handles(x.body, effects),
    EApp(x) -> here(all(x.args), x.func),
    EIf(x) -> all([x.cond, x.then_branch, x.else_branch]),
    EMatch(x) ->
      x.arms.fold(ast_handles(x.scrutinee, effects), |acc: List<Bytes>, arm: MatchArm|
        here(match arm.guard { Some(g) -> here(acc, g), None -> acc }, arm.body)),
    EBlock(x) -> {
      let stmts = x.stmts.fold([], |acc: List<Bytes>, stmt: Stmt|
        match stmt {
          SLet(l) -> here(acc, l.value),
          SLetElse(l) -> here(here(acc, l.value), l.fallback),
          SExpr(v) -> here(acc, v),
          SAssign(v) -> here(acc, v.value),
        });
      match x.tail { Some(t) -> here(stmts, t), None -> stmts }
    },
    ERecord(x) -> all(x.fields.map(|f: RecField| f.value)),
    ERecordUpdate(x) -> here(all(x.fields.map(|f: RecField| f.value)), x.base),
    ETry(x) -> ast_handles(x.operand, effects),
    EField(x) -> ast_handles(x.base, effects),
    EList(x) -> all(x.items),
    EPerform(x) -> all(x.args),
    EWithHold(x) -> all([x.acquire, x.release, x.body]),
    ETryBlock(x) -> ast_handles(x.body, effects),
    _ -> [],
  }
}

fn walk_handles(c: Code, effects: List<EffectName>) -> List<Bytes> / {abort.raise} = {
  let here = |acc: List<Bytes>, x: Code| acc.concat(walk_handles(x, effects));
  match c.node {
    NHandle(h) ->
      h.clauses.fold(walk_handles(h.body, effects), |acc: List<Bytes>, clause: CodeClause|
        List::concat(
          match handled_effect(effects, clause.effect) {
            Some(g) -> acc.push(Bytes::concat_all([g, b"#", clause.op])),
            None -> acc,
          },
          walk_handles(clause.body, effects),
        )),
    NUnary(u) -> walk_handles(u.operand, effects),
    NBinary(b) -> here(walk_handles(b.lhs, effects), b.rhs),
    NField(f) -> walk_handles(f.base, effects),
    NApp(a) -> a.args.fold(walk_handles(a.func, effects), here),
    NIf(i) -> here(here(walk_handles(i.cond, effects), i.then_branch), i.else_branch),
    NBlock(b) -> {
      let stmts = b.stmts.fold([], |acc: List<Bytes>, stmt: CodeStmt|
        match stmt {
          CLet(l) -> here(acc, l.value),
          CLetPat(l) -> here(acc, l.value),
          CDo(d) -> here(acc, d.code),
        });
      match b.tail { Some(t) -> here(stmts, t), None -> stmts }
    },
    NList(l) -> l.items.fold([], here),
    NRecord(r) -> r.fields.fold([], |acc: List<Bytes>, f: CodeField| here(acc, f.value)),
    NUpdate(u) ->
      u.sets.fold(walk_handles(u.base, effects), |acc: List<Bytes>, f: CodeField|
        here(acc, f.value)),
    NMatch(m) ->
      m.arms.fold(walk_handles(m.scrutinee, effects), |acc: List<Bytes>, a: CodeArm|
        here(match a.guard { Some(g) -> here(acc, g), None -> acc }, a.body)),
    NPerform(p) -> p.args.fold([], here),
    NLambda(l) -> walk_handles(l.body, effects),
    NSimulate(x) -> scheduled_ops().concat(walk_handles(x.body, effects)),
    NParallel(pr) -> pr.branches.fold([], here),
    _ -> [],
  }
}

/// A body's C and the tables it names, or why it was refused and the operations it would have
/// handled, which a refusal still names so the fixpoint drops their performers.
pub type Answer =
  | Body({ text: Bytes, tables: Tables })
  | Refused({ why: Bytes, handles: List<Bytes> })

pub type RootAnswer = { name: Bytes, answer: Answer }

derive bin for Const
derive bin for Head
derive bin for Defined
derive bin for Expect
derive bin for Pass
derive bin for FnArg
derive bin for GenericCall
derive bin for Reads
derive bin for Need
derive bin for Generics
derive bin for Tables
derive bin for Answer

/// The roots `wanted` names, resolved against the whole program: one entry per root emitted or
/// refused, in its order, so the driver can drop what was refused. `embeds` is what the front end's
/// answer says it embedded, `rows` what it published for every definition and test, which spare a
/// walk of every module no wanted root is in, and `walked` what its check read of the modules it
/// walked whole, which spares a walk of those too.
pub fn emit_roots_answer(
  names: List<Bytes>,
  srcs: List<Bytes>,
  ctors: Ctors,
  builtins: List<Bytes>,
  wanted: List<Bytes>,
  pkgs: List<PackageDeps>,
  module_packages: List<Int>,
  embeds: List<EmbedAt>,
  rows: Rows,
  walked: Bytes,
) -> List<RootAnswer> / {abort.raise} =
  emit_program(
    zip_sources(names, srcs),
    ctors,
    builtins,
    true,
    Some(wanted.fold(Map::new(), |acc: Map<Bytes, Bool>, n: Bytes| acc.insert(n, true))),
    pkgs,
    module_packages,
    embeds,
    rows,
    walked,
  ).map(
    answer_of,
  )

fn answer_of(e: Emitted) -> RootAnswer =
  {
    name: e.name,
    answer: match e.why {
      Some(w) -> Refused({ why: w, handles: e.handles }),
      None -> Body({ text: e.text, tables: e.tables }),
    },
  }

fn zip_sources(names: List<Bytes>, srcs: List<Bytes>) -> List<Source> =
  range(0, names.len()).map(|i: Int|
    {
      name: match names.at(i) { Some(n) -> n, None -> b"" },
      src: match srcs.at(i) { Some(t) -> t, None -> b"" },
    })

/// The C symbol a full name becomes: the name cut on its dots and its `#`s, each piece written as
/// its bytes, a mode byte (`_` after a dot, `h` after a `#`, `x` and `y` for the same two with the
/// bytes in hex, which a piece holding a byte no C identifier carries takes) and their length.
/// Bytes lead, so symbols collate as their names do and a definition added to a program leaves the
/// code-table ranks before it alone. Every symbol ends in a length behind its mode byte, which
/// nothing suffixed (`_entry`, `_lambda0`, `_group`) and nothing the runtime names (`ply_bind`)
/// does, so no two names spell one symbol and no suffixed symbol is a name's own. A C compiler
/// may cut a long symbol short, so one past `symbol_room` is its start and the digest of the
/// whole behind a mode byte of its own (`q`): two names alike that far stay apart.
pub fn symbol_of(full: Bytes) -> Bytes / {abort.raise} = {
  let whole = mangled(full, 0, 0, 46, b"");
  if whole.len() <= symbol_room() { b"ply_".concat(whole) } else {
    Bytes::concat_all([
      b"ply_",
      whole.slice(0, symbol_room() - 40),
      hex(whole.blake3().slice(0, 16)),
      b"q",
      ascii_of_int(whole.len()),
    ])
  }
}

/// The longest a symbol is written whole: what is suffixed to one still fits in the 255 bytes the
/// shortest-keeping C compiler this is built with reads.
fn symbol_room() -> Int = 200

/// The symbol the loader binds a definition by, which is also its memo slot.
pub fn entry_of(full: Bytes) -> Bytes / {abort.raise} = symbol_of(full).concat(b"_entry")

/// `start` opens the piece being scanned and `delim` is the byte that opened it.
fn mangled(name: Bytes, start: Int, at: Int, delim: Int, acc: Bytes) -> Bytes / {abort.raise} =
  if at >= name.len() { acc.concat(mangled_part(name.slice(start, at), delim)) }
  else if name.at(at) == 46 || name.at(at) == 35 {
    mangled(
      name,
      at + 1,
      at + 1,
      name.at(at),
      acc.concat(mangled_part(name.slice(start, at), delim)),
    )
  } else { mangled(name, start, at + 1, delim, acc) }

fn mangled_part(part: Bytes, delim: Int) -> Bytes / {abort.raise} =
  if c_ident_bytes(part, 0) {
    Bytes::concat_all([part, if delim == 35 { b"h" } else { b"_" }, ascii_of_int(part.len())])
  } else if part.len() > 48 {
    // A C compiler may cut a long symbol short, so a long part is its digest.
    let digest = hex(part.blake3().slice(0, 16));
    Bytes::concat_all([digest, if delim == 35 { b"w" } else { b"z" }, ascii_of_int(part.len())])
  } else {
    let hexed = hex(part);
    Bytes::concat_all([hexed, if delim == 35 { b"y" } else { b"x" }, ascii_of_int(hexed.len())])
  }

fn c_ident_bytes(part: Bytes, i: Int) -> Bool / {abort.raise} =
  if i >= part.len() { true }
  else if is_ident_continue(part.at(i)) { c_ident_bytes(part, i + 1) }
  else { false }

fn bytes_join_dots(xs: List<Bytes>) -> Bytes =
  range(0, xs.len()).fold(b"", |acc: Bytes, i: Int|
    Bytes::concat_all([
      acc,
      if i == 0 { b"" } else { b"." },
      match xs.at(i) { Some(x) -> x, None -> b"" },
    ]))

test "a module imported whole under a builtin's name leaves a bare call the builtin's" {
  let emitted = emit_all_program(
    [
      { name: b"min", src: b"pub fn size(xs: List<Int>) -> Int = xs.len()\n" },
      {
        name: b"b",
        src: b"import min\nfn least(x: Int) -> Int = min(x, 1)\nfn n(xs: List<Int>) -> Int = min::size(xs)\n",
      },
    ],
    [],
    [b"min", b"List::len"],
    true,
  );
  assert_eq(emitted.map(|e: Emitted| e.why), [None, None, None]);
  let calls = |full: Bytes| emitted.map(|e: Emitted| e.text.index_of(symbol_of(full)) != None);
  assert_eq(calls(b"min.min"), [false, false, false]);
  assert_eq(calls(b"min.size"), [true, false, true])
}

test "a builtin is called through the helper named for it, and an import that takes its name is called instead" {
  let own = emit_all_program(
    [
      {
        name: b"m",
        src: b"fn longer(xs: List<Int>) -> List<Int> = xs.push(1)\nfn head(b: Bytes) -> Bytes / {abort.raise} = b.slice(0, 1)\n",
      },
    ],
    [],
    [b"List::push", b"Bytes::slice"],
    true,
  );
  assert_eq(own.map(|e: Emitted| e.why), [None, None]);
  let has = |text: Bytes| own.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(has(b"builtin_list_push_p(ctx, "), [true, false]);
  assert_eq(has(b"builtin_bytes_slice_p(ctx, "), [false, true]);
  assert_eq(builtin_helper(b"?numeric_binary"), b"builtin_elaborated_numeric_binary");
  assert_eq(builtin_helper(b"range"), b"builtin_range");
  let imported = emit_all_program(
    [
      { name: b"a", src: b"pub fn min(x: Int, y: Int) -> Int = x\n" },
      { name: b"b", src: b"import a (min)\nfn least(x: Int) -> Int = min(x, 1)\n" },
    ],
    [],
    [b"min"],
    true,
  );
  assert_eq(imported.map(|e: Emitted| e.why), [None, None]);
  assert_eq(imported.map(|e: Emitted| e.text.index_of(b"builtin_min_p") != None), [false, false])
}

// A value is compared and shown wherever it is read, by the runtime and not by a call a body
// makes: the body that names its constructor is what answers for the functions being there.
test "a body that names a constructor calls the key and the show its type states" {
  let rest = b"fn area(b: Box) -> Int = match b { Box(w, h) -> w * h }\nfn text(b: Box) -> String = \"box\"\nfn make() -> Box = Box(1, 2)\nfn same<a>(x: a, y: a) -> Bool = x == y\n";
  let plain = b"pub type Box = | Box(Int, Int)\n".concat(rest);
  let stating = b"pub type Box = | Box(Int, Int)\nkey for Box by area\nshow for Box by text\n".concat(
    rest,
  );
  let wanted = [b"m.area", b"m.text", b"m.make", b"m.same"];
  let calls = |src: Bytes|
    answers_of([b"m"], [src], [b"m.Box"], wanted).map(|a: RootAnswer|
      {
        name: a.name,
        calls: match a.answer { Body(b) -> b.tables.calls, Refused(_) -> [b"refused"] },
      });
  assert_eq(calls(stating), [
    // The key names the tag it takes its value apart by, and so itself.
    { name: b"m.area", calls: [b"m.area", b"m.text"] },
    { name: b"m.text", calls: [] },
    { name: b"m.make", calls: [b"m.area", b"m.text"] },
    { name: b"m.same", calls: [] },
  ]);
  assert_eq(calls(plain).map(|c: { name: Bytes, calls: List<Bytes> }| c.calls), [[], [], [], []])
}
