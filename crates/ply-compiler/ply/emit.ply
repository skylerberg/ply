  }

fn outdent(emitter: Emitter) -> Emitter =
  {
    out: emitter.out,
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent - 1,
    reads: emitter.reads,
    shapes: emitter.shapes,
