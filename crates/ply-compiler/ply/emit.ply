/// `KBoxed` is a tagged word; `KInt` is the untagged 64 bits inside one.
pub type Kind =
  | KBoxed
  | KInt
  | KBool
  /// Below 64 bits a width has its own C type; signed overflow is undefined in C, so casts carry signedness.
  | KNum(Width)
  /// A `Float` in a C `double`, whose arithmetic is IEEE-754's own once contraction is off.
  | KFloat
  /// A `Decimal` in a `PlyDec`, the two words of its object, whose arithmetic is the runtime's.
  | KDec
  /// A sum of known type as one word, as `SumSpec` says, counted as its argument's word is and made
  /// the sum's object only where it leaves the code that knows it.
  | KSum(SumSpec)

/// How a sum is one word. `Zeroed`: an `Option` is its payload's word, `0` for `None`; no word of a
/// value is zero. `Tagged`: a `Result` whose error is always an object is its `Ok`'s argument's word,
/// or its `Err`'s with the low bits `100`, which no value's word has.
pub type SumSpec = | Zeroed | Tagged

/// Whether a value of kind `k` is a word that holds a count: a value's word, or a sum's, zero or a
/// tag holding none of its own.
fn counted(k: Kind) -> Bool = match k { KBoxed -> true, KSum(_) -> true, _ -> false }

fn is_sum(k: Kind) -> Bool = match k { KSum(_) -> true, _ -> false }

/// The runtime's helper `what` for a sum held as `spec` says: `take` makes the object, taking the
/// word's count; `box` makes it, adding one; `open` makes the word, taking the object.
fn sum_helper(spec: SumSpec, what: Bytes) -> Bytes =
  match spec {
    Zeroed -> Bytes::concat_all([b"rt_maybe_", what, b"_p"]),
    Tagged -> Bytes::concat_all([b"rt_tagged_", what, b"_p"]),
  }

pub type Width = { bits: Int, signed: Bool }

pub fn ctype(k: Kind) -> Bytes =
  match k {
    KNum(w) -> if w.signed {
      if w.bits == 8 { b"int8_t" }
      else if w.bits == 16 { b"int16_t" }
      else if w.bits == 32 { b"int32_t" }
      else { b"int64_t" }
    } else { unsigned_ctype(w) },
    KFloat -> b"double",
    KDec -> b"PlyDec",
    KSum(Zeroed) -> b"PlyMaybe",
    KSum(Tagged) -> b"PlyTagged",
    _ -> b"int64_t",
  }

/// What a local of `k` is declared holding before a branch assigns it: a `Decimal`'s struct needs
/// its braces.
/// A value of `k` that stands for nothing, as an initializer or an expression.
fn zero_of(k: Kind) -> Bytes = match k { KDec -> b"(PlyDec){0, 0}", _ -> b"0" }

fn unsigned_ctype(width: Width) -> Bytes =
  if width.bits == 8 { b"uint8_t" }
  else if width.bits == 16 { b"uint16_t" }
  else if width.bits == 32 { b"uint32_t" }
  else { b"uint64_t" }

/// `width_index`'s order is the runtime's width numbering.
fn width_named(name: Bytes) -> Option<Width> =
  if name == b"U8" { Some({ bits: 8, signed: false }) }
  else if name == b"U16" { Some({ bits: 16, signed: false }) }
  else if name == b"U32" { Some({ bits: 32, signed: false }) }
  else if name == b"U64" { Some({ bits: 64, signed: false }) }
  else if name == b"I8" { Some({ bits: 8, signed: true }) }
  else if name == b"I16" { Some({ bits: 16, signed: true }) }
  else if name == b"I32" { Some({ bits: 32, signed: true }) }
  else if name == b"I64" { Some({ bits: 64, signed: true }) }
  else if name == b"U128" { Some({ bits: 128, signed: false }) }
  else if name == b"I128" { Some({ bits: 128, signed: true }) }
  else { None }

fn width_index(width: Width) -> Int =
  if width.bits == 128 { if width.signed { 9 } else { 8 } } else {
    (if width.signed { 4 } else { 0 })
      + (if width.bits == 8 { 0 }
      else if width.bits == 16 { 1 }
      else if width.bits == 32 { 2 }
      else { 3 })
  }

/// Whether a value of the width is held in a C register of its own type: up to 64 bits.
fn carried(width: Width) -> Bool = width.bits <= 64

/// Whether the width's word is an `Int`'s immediate, as below 64 bits; at 64 it is an object of
/// the width's own, which compares by the width's order.
fn in_imm(width: Width) -> Bool = width.bits < 64

fn width_min(width: Width) -> Int = if width.signed { 0 - pow(2, width.bits - 1) } else { 0 }

fn width_max(width: Width) -> Int =
  if width.signed { pow(2, width.bits - 1) - 1 } else { pow(2, width.bits) - 1 }

fn as_num(value: CValue, width: Width) -> Bytes =
  match value.kind {
    KNum(h) -> if h == width { value.expr }
    else { Bytes::concat_all([b"(", ctype(KNum(width)), b")(", value.expr, b")"]) },
    KBoxed -> if in_imm(width) {
      Bytes::concat_all([b"(", ctype(KNum(width)), b")ply_imm_value(", value.expr, b")"])
    } else { Bytes::concat_all([b"(", ctype(KNum(width)), b")ply_words(", value.expr, b")[0]"]) },
    _ -> Bytes::concat_all([b"(", ctype(KNum(width)), b")(", value.expr, b")"]),
  }

/// An emitted value: the kind it is held at and the C expression naming it.
pub type CValue = { kind: Kind, expr: Bytes, ty: Ty }

/// `TyArr`: an array, with how it holds its elements where its element type says (as a record's field
/// `e` of that type is held), and `None` where the type is a variable's.
/// The program's constructor table: the names its tags are positions of, and the arguments of each
/// constructor whose declaration lays one out other than as its word.
pub type Ctors = {
  names: List<Bytes>,
  laid: Map<Bytes, List<FieldTy>>,
  keyed: List<Bytes>,
  /// Each declared sum's constructors in their order, by the sum's name.
  sums: Map<Bytes, List<SumCtor>>,
}

/// A constructor of a declared sum, by its program-wide name, its arguments' declared types, and the
/// variable each of the sum's parameters is in them, in the parameters' order.
pub type SumCtor = { name: Bytes, index: Int, fields: List<Type>, params: List<Int> }

fn no_ctors() -> Ctors = { names: [], laid: Map::new(), keyed: [], sums: Map::new() }

/// Each declared sum's constructors, by the sum's name, in their declared order.
pub fn ctor_sums(rows: List<CtorRow>) -> Map<Bytes, List<SumCtor>> =
  rows.fold(Map::new(), |acc: Map<Bytes, List<SumCtor>>, c: CtorRow| {
    let had = match acc.get(c.type_name) { Some(cs) -> cs, None -> [] };
    // The arguments' types and the type made of them, in the scheme's one numbering.
    let typed = match c.scheme.ty {
      TyFn(f) -> { fields: f.params, made: f.ret },
      t -> { fields: c.fields, made: t },
    };
    let params = match typed.made {
      TyCon(t) -> t.args.map(|a: Type| match a { TyVar(v) -> v, _ -> 0 - 1 }),
      _ -> [],
    };
    let mine = { name: c.name, index: c.index, fields: typed.fields, params: params };
    acc.insert(
      c.type_name,
      had.filter(|x: SumCtor| x.index < c.index).concat(
        [mine].concat(had.filter(|x: SumCtor| x.index > c.index)),
      ),
    )
  })

/// `TyOpen([])` names the type variables that left the layout unknown, which a specialisation settles.
/// `TyOf` is a word of an `Option` or a `Result`, whose type says what each constructor's argument
/// is laid out as.
pub type Ty =
  | TyOpen(List<Int>)
  | TyRec(List<FieldTy>)
  | TyBytes
  | TyList
  | TyArr(Option<FieldTy>)
  | TyOf(Type)

/// The type the checker settled an operator's operands at, which alone decides what the operator
/// means; how an operand happens to be held only decides how it is read. `OWhole` is a type of
/// arguments or fields, and `OWord` one read by the runtime's own operators.
type Operand =
  | OInt
  | OBool
  | OWidth(Width)
  | OFloat
  | ODec
  | OChar
  | OText
  | OSum(Bytes)
  | OWhole(Type)
  | OWord

/// `None` where the checker settled no type, which it does for every operator of a checked program.
fn operand_at(emitter: Emitter, span: Span) -> Option<Operand> / {abort.raise} =
  match emitter.operands.get(span_key(span)) {
    None -> None,
    Some(name) -> if name == unsettled() { None }
    else if name == b"Int" { Some(OInt) }
    else if name == b"Bool" { Some(OBool) }
    else if name == b"Float" { Some(OFloat) }
    else if name == b"Decimal" { Some(ODec) }
    else if name == b"Char" { Some(OChar) }
    else if name == b"String" || name == b"Bytes" { Some(OText) }
    else if compared_by_ctors(emitter.ctors, name) { Some(OSum(name)) } else if spells_whole(name) {
      match type_spelled(name) { Some(t) -> Some(OWhole(t)), None -> Some(OWord) }
    } else { match width_named(name) { Some(w) -> Some(OWidth(w)), None -> Some(OWord) } },
  }

/// Whether an operand's name spells a type of arguments or fields rather than naming one.
fn spells_whole(name: Bytes) -> Bool = name.index_of(b"<") != None || name.index_of(b"{") != None

/// `emitter` noting that the operator at `span` is done by the runtime because the checker settled its
/// operands at type variable `'i`, which a scalar argument would do in C, and an argument of any
/// type would where the operator `compares` for equality.
fn operand_needed(emitter: Emitter, span: Span, compares: Bool) -> Emitter / {abort.raise} =
  match emitter.operands.get(span_key(span)) {
    Some(name) -> if name.len() > 1 && name.at(0) == 39 {
      needing(emitter, digits(name.slice(1, name.len())), if compares { Exact } else { Scalar })
    } else if compares && spells_whole(name) {
      match type_spelled(name) {
        Some(t) -> type_vars(t).fold(emitter, |e: Emitter, v: Int| needing(e, v, Exact)),
        None -> emitter,
      }
    } else { emitter },
    None -> emitter,
  }

/// `emitter` noting the type variables that left `ty` unknown, where it is.
fn open_needed(emitter: Emitter, ty: Ty) -> Emitter =
  match ty {
    TyOpen(vs) -> vs.fold(emitter, |e: Emitter, v: Int| needing(e, v, Layout)),
    _ -> emitter,
  }

/// `emitter` noting what builtin `name` reads of the type arguments the reference `at` leaves
/// unknown: the layout of an element it makes, writes or reads in place (`Array::new`, `set`,
/// `of_list` and `get`, or a field of `Columns::get`'s record), or the type `compare` orders by and
/// `reflect`, `shown` and `digest` read at.
fn builtin_needed(emitter: Emitter, written: Bytes, at: Span) -> Emitter = {
  let name = generated_builtin(written);
  match emitter.typed.get(span_key(at)) {
    None -> emitter,
    Some(t) -> if name == b"compare" || name == b"compare_values" || name == b"reflect"
        || name == b"shown"
        || name == b"digest"
        || name == b"?encoded" { t.args.fold(emitter, |e: Emitter, a: Type| exact_needed(e, a)) }
    else if name == b"Array::get" || name == b"Columns::get" || name == b"Array::new"
        || name == b"Array::set"
        || name == b"Array::of_list" {
      match t.args.at(0) {
        Some(element) -> if laid_field(b"e", element) == None { layout_needed(emitter, element) }
        else { emitter },
        None -> emitter,
      }
    } else { emitter },
  }
}

/// `emitter` noting each type variable that left the layout of the value at `span` unknown.
fn layout_needed_at(emitter: Emitter, span: Span) -> Emitter =
  match emitter.typed.get(span_key(span)) {
    Some(t) -> layout_needed(emitter, t.ty),
    None -> emitter,
  }

/// `emitter` noting each type variable whose layout a value of `ty` is laid out by: the type itself,
/// a record's fields and an array's or columns' element, through records and arrays.
fn layout_needed(emitter: Emitter, ty: Type) -> Emitter =
  laid_vars(ty).fold(emitter, |e: Emitter, v: Int| needing(e, v, Layout))

/// `emitter` noting each type variable in `ty`, whose type an operation done per type reads.
fn exact_needed(emitter: Emitter, ty: Type) -> Emitter =
  type_vars(ty).fold(emitter, |e: Emitter, v: Int| needing(e, v, Exact))

/// The type variables `ty` names, each once.
pub fn type_vars(ty: Type) -> List<Int> =
  match ty {
    TyVar(v) -> if v >= 0 { [v] } else { [] },
    TyCon(c) -> c.args.fold([], |acc: List<Int>, a: Type| ints_joined(acc, type_vars(a))),
    TyFn(f) ->
      f.params.push(f.ret).fold([], |acc: List<Int>, a: Type| ints_joined(acc, type_vars(a))),
    TyRecord(fs) -> fs.fold([], |acc: List<Int>, f: Field| ints_joined(acc, type_vars(f.ty))),
    TyNominal(x) -> x.args.fold([], |acc: List<Int>, a: Type| ints_joined(acc, type_vars(a))),
  }

fn ints_joined(a: List<Int>, b: List<Int>) -> List<Int> =
  b.fold(a, |acc: List<Int>, x: Int| if acc.contains(x) { acc } else { acc.push(x) })

pub fn laid_vars(ty: Type) -> List<Int> =
  match ty {
    TyVar(v) -> if v >= 0 { [v] } else { [] },
    TyRecord(fs) -> fs.fold([], |acc: List<Int>, f: Field| acc.concat(laid_vars(f.ty))),
    TyNominal(x) -> x.fields.fold([], |acc: List<Int>, f: Field| acc.concat(laid_vars(f.ty))),
    TyCon(c) -> if (c.name == b"Array" || c.name == b"Columns") && c.args.len() == 1 {
      c.args.fold([], |acc: List<Int>, a: Type| acc.concat(laid_vars(a)))
    } else { [] },
    _ -> [],
  }

/// `emitter` noting that its code took a slow path because type variable `var` was unknown, and
/// what a specialisation would read of it.
fn needing(emitter: Emitter, var: Int, reads: Reads) -> Emitter =
  if emitter.generics.needs.contains({ var: var, reads: reads }) { emitter } else {
    {
      ..emitter,
      generics: {
        ..emitter.generics,
        needs: emitter.generics.needs.push({ var: var, reads: reads }),
      },
    }
  }

fn unsettled_operator(emitter: Emitter, what: Bytes) -> WithValue =
  refused(emitter, b"an operator the checker settled no operand type for: ".concat(what))

/// Fields in written order; a field's kind decides whether reading it unboxes, so it must not default to `KInt`.
pub type FieldTy = { name: Bytes, kind: Kind, ty: Ty }

/// `conv`: slots already unboxed -- a parameter is unboxed once and later reads reuse that temporary.
/// `reads`: every slot read in the body, counted whole because reads are not emitted in the order they were marked.
pub type Emitter = {
  out: List<Bytes>,
  temp_count: Int,
  unboxed: List<Unboxed>,
  indent: Int,
  reads: List<Int>,
  shapes: List<List<Bytes>>,
  built: List<Built>,
  module: Bytes,
  base: Int,
  /// Locals holding a count only this body can name; a callee taking one is handed the count, not a duplicate.
  count_locals: List<CountLocal>,
  /// This module's definitions; any other bare name is a builtin or an import.
  here: List<Def>,
  imports: List<Imported>,
  /// Literals in first-met order: a body indexes the unit's tables by its own positions.
  consts: List<Lit>,
  /// Every constructor's program-wide name; a tag is its index here.
  ctors: Ctors,
  /// Lambda sub-functions, written after the function that builds the closure.
  lambda_bodies: Bytes,
  /// This body's code table: each lambda's entry and each pure nullary constant's entry.
  lambdas: List<Bytes>,
  /// Sub-functions are numbered under the named function, not an enclosing lambda.
  /// The definition being emitted, by its full name.
  owner: Bytes,
  builtins: List<Bytes>,
  called_builtins: List<Bytes>,
  /// Field names met, for reads whose record shape is unknown.
  fields: List<Bytes>,
  /// Nothing is emitted after the current node, so a tail update may release its base whatever its read count,
  /// and a self call restarts the body. Kept into block tails, `if`/`match` arms and the right of `&&`/`||`;
  /// cleared into call arguments, where a fused loop body runs repeatedly.
  tail: Bool,
  /// Program-wide names this body calls: a cached body is checked against this set.
  calls: List<Bytes>,
  /// Each call of a generic program definition and each slow path a type variable took here.
  generics: Generics,
  /// The first refusal; emission runs on in a poisoned state, so no signature carries it.
  refused: Option<Bytes>,
  /// Flat records built from locals, held back until their word is asked for; their locals are declared at the top.
  deferred: List<Deferred>,
  deferred_locals: List<Bytes>,
  /// `landing`: the label a failing call inside a `handle` body jumps to.
  performs: List<Bytes>,
  handles: List<Bytes>,
  landing: Option<Bytes>,
  effects: List<EffectName>,
  /// Slots already released: two reads can both be marked `Owned`, and releasing at both double-frees.
  released: List<Bytes>,
  /// Reuse-token widths actually used, declared afterwards at the top: predicting them would duplicate the release rule.
  reuse_widths: List<Int>,
  /// `by_root` counts reads per object, not per name: an object with three names each read once has three reads.
  alias: List<{ local: Bytes, root: Bytes }>,
  by_root: List<{ root: Bytes, n: Int }>,
  /// Off, every count is held until the entry ends. On: `bound` are locals a slot names, moved only at
  /// a read marked `Owned`; `pinned` are ones a fused loop body may read but never move.
  release: Bool,
  pinned: List<Bytes>,
  bound: List<Bytes>,
  /// The full names of the definitions sharing this C function, in case order; empty outside a group.
  group: List<Bytes>,
  /// The checker's operand type at each operator's site, as `operand_at` reads it.
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
  /// How this root hands back its answer; a failing exit returns its zero.
  answer: Carrier,
  /// The root a site is filed under where it is not this one's: a lambda of another root's run here.
  site_root: Option<Bytes>,
  /// The callers' lambdas this root runs in place of calls of the parameters they were handed as.
  lent: List<BoundLambda>,
  /// The lambdas the root's own code writes, which a callee names by their place among them.
  written: List<Lambda>,
  /// Lists this body reads as a word and an offset into it, each made a list only when asked for.
  slices: List<Slice>,
  /// Sums held back as their constructor and its argument, each until its word is asked for.
  sums: List<HeldSum>,
  /// Whether the value at hand goes where a sum is taken as its constructor and argument, so one
  /// is held back rather than made: a call's argument or an answer carried so, or a `match`'s
  /// subject. Kept and cleared where `tail` is.
  leaves: Bool,
}

/// A sum held back as the index `tag` of its constructor among `cases` and each constructor's
/// argument, one only where `tag` names its constructor, until its word is asked for: `name` is
/// its word, zero until made.
pub type HeldSum = { name: Bytes, cases: SumCases, tag: Bytes, args: List<Option<CValue>> }

/// A list read as `base`'s elements from `from` on, held in `name` once asked for as a list, zero
/// until then.
pub type Slice = { name: Bytes, base: Bytes, from: Bytes }

/// `ret_ty` keeps a record answer's fields so later reads get offsets; `pure` lets a nullary call come from the constant table.
pub type Def = {
  name: Bytes,
  ret: Option<Kind>,
  ret_ty: Ty,
  pure: Bool,
  arity: Int,
  scheme: Option<Scheme>,
  /// How each parameter its function takes and its answer cross a call, as `carriers_of` says, and
  /// how many witnesses come before the parameters its scheme writes.
  carriers: List<Carrier>,
  answer: Carrier,
  witnesses: Int,
}

/// An imported name lowers like a builtin; only the import list tells them apart. `defs` is empty when the module is out of reach.
/// `whole` binds the module itself, which only a qualified name reaches: a bare `min` is never a module `min`.
pub type Imported = { name: Bytes, module: Bytes, defs: List<Def>, whole: Bool }

pub type ModuleDefs = { module: Bytes, defs: List<Def> }

/// A record this body built: a field read of it reuses the built value (sound: the values are this body's locals).
pub type Built = { local: Bytes, names: List<Bytes>, vals: List<CValue> }

/// A record held back until something reads it as a word: `n` words of `shape`, each of `cells`
/// written at its place. `counts` are the locals holding its counted fields, each with a count of
/// its own, which the word, once made, holds one more of or takes. `inner` are the records it holds
/// in place, which it alone holds.
pub type Deferred = {
  name: Bytes,
  shape: Int,
  n: Int,
  flags: Int,
  cells: List<{ at: Int, expr: Bytes }>,
  counts: List<Bytes>,
  inner: List<Inner>,
}

/// A record a record held back holds in place, its header at word `at` with `tail` words of bitmap
/// after its own: `name` is a record of no record in place held back, or a word, either copied
/// into the holder's words when its word is made.
pub type Inner = { at: Int, name: Bytes, tail: Int }

/// A C local holding one count, released at its block's close unless spent first.
pub type CountLocal = { name: Bytes, indent: Int }

pub type EffectName = { written: Bytes, global: Bytes, ops: List<OpMode> }

pub type OpMode = { name: Bytes, mode: Mode }

pub type Unboxed = { slot: Int, kind: Kind, expr: Bytes, ty: Ty }

/// A parameter as the body holds it, and its `carrier`: how it arrives, as a word the prologue
/// opens to `kind`, as the value itself, or as a record's fields.
pub type EmitParam = {
  name: Bytes,
  kind: Kind,
  ty: Ty,
  /// The type the definition's scheme gives it, none where no scheme speaks for it.
  of: Option<Type>,
  carrier: Carrier,
  /// The caller's lambda this parameter is, which a call of it runs in place.
  lambda: Option<BoundLambda>,
}

/// A caller's lambda a specialisation runs where it calls the parameter it was handed as: the
/// lambda as its owner lowered it, and what the owner's body is emitted under.
pub type BoundLambda = {
  owner: Bytes,
  nth: Int,
  code: Lambda,
  /// Whether it is a definition its owner named as a value, read as the lambda around a call of
  /// it: run in place it counts no step but that call's.
  named: Bool,
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  effects: List<EffectName>,
  typed: Map<Bytes, Typed>,
  operands: Map<Bytes, Bytes>,
  base: Int,
}

/// How a value crosses a call between roots: whole, as its word or as its value in its own C type;
/// a small flat record as each of its fields in its own C type; or a sum one of whose constructors
/// holds such a record as its constructor's index and then each constructor's argument as it
/// crosses. A record answer returns its first field and a sum's its index, and each writes the
/// rest through pointers its caller hands it.
pub type Carrier = | Whole(Kind) | Fields(List<FieldTy>) | Cases(SumCases)

/// A sum held as `spec` says where it is a word, and its constructors in their declared order,
/// each with how its argument crosses: never as a sum's cases.
pub type SumCases = { spec: SumSpec, cases: List<SumCase> }

pub type SumCase = { name: Bytes, arg: Option<Carrier> }

pub type WithValue = { emitter: Emitter, value: CValue }

/// Where a `match` arm's answer goes: the answer local of its kind, a record's locals, a fused
/// `iterate` step's loop control, or a sum's constructor and argument's locals.
pub type Sink =
  | ToValue({ name: Bytes, kind: Kind })
  | ToRecord(Into)
  | ToLoop({ state: Into, answer: Bytes, depth: Int })
  | ToSum({ cases: SumCases, tag: Bytes, leaves: List<CValue> })

/// The locals a value is assigned into: one per field of `fields` and then `word`, the record's word
/// where it was made, or the whole value's word where `fields` is empty.
pub type Into = { fields: List<FieldTy>, locals: List<CValue>, word: Bytes }

/// Lines are joined once at the end; appending to one string would be quadratic.
fn line(emitter: Emitter, text: Bytes) -> Emitter =
  {
    out: emitter.out.push(Bytes::concat_all([pad(emitter.indent), text, b"\n"])),
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: emitter.built,
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: emitter.released,
    reuse_widths: emitter.reuse_widths,
    alias: emitter.alias,
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred,
    deferred_locals: emitter.deferred_locals,
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
    slices: emitter.slices,
    sums: emitter.sums,
    leaves: emitter.leaves,
  }

fn pad(ind: Int) -> Bytes = if ind <= 0 { b"  " } else { b"  ".concat(pad(ind - 1)) }

fn indent(emitter: Emitter) -> Emitter =
