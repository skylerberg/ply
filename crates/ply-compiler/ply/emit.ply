/// `KBoxed` is a tagged word; `KInt` is the untagged 64 bits inside one.
pub type Kind =
  | KBoxed
  | KInt
  | KBool
  /// Below 64 bits a width has its own C type; signed overflow is undefined in C, so casts carry signedness.
  | KNum(Width)
  /// A `Float` in a C `double`, whose arithmetic is IEEE-754's own once contraction is off.
  | KFloat
  /// A `Decimal` in a `PlyDec`, the two words of its object, whose arithmetic is the runtime's.
  | KDec
  /// An `Option` as its payload's word, `0` for `None`: no word of a value is zero. Counted as the
  /// payload's word is, and made an `Option` object only where it leaves the code that knows it.
  | KMaybe

/// Whether a value of kind `k` is a word that holds a count: a value's word, or an `Option`'s
/// payload word, zero holding none.
fn counted(k: Kind) -> Bool = k == KBoxed || k == KMaybe

pub type Width = { bits: Int, signed: Bool }

pub fn ctype(k: Kind) -> Bytes =
  match k {
    KNum(w) -> if w.signed {
      if w.bits == 8 { b"int8_t" }
      else if w.bits == 16 { b"int16_t" }
      else if w.bits == 32 { b"int32_t" }
      else { b"int64_t" }
    } else { unsigned_ctype(w) },
    KFloat -> b"double",
    KDec -> b"PlyDec",
    KMaybe -> b"PlyMaybe",
    _ -> b"int64_t",
  }

/// What a local of `k` is declared holding before a branch assigns it: a `Decimal`'s struct needs
/// its braces.
/// A value of `k` that stands for nothing, as an initializer or an expression.
fn zero_of(k: Kind) -> Bytes = match k { KDec -> b"(PlyDec){0, 0}", _ -> b"0" }

fn unsigned_ctype(width: Width) -> Bytes =
  if width.bits == 8 { b"uint8_t" }
  else if width.bits == 16 { b"uint16_t" }
  else if width.bits == 32 { b"uint32_t" }
  else { b"uint64_t" }

/// `width_index`'s order is the runtime's width numbering.
fn width_named(name: Bytes) -> Option<Width> =
  if name == b"U8" { Some({ bits: 8, signed: false }) }
  else if name == b"U16" { Some({ bits: 16, signed: false }) }
  else if name == b"U32" { Some({ bits: 32, signed: false }) }
  else if name == b"U64" { Some({ bits: 64, signed: false }) }
  else if name == b"I8" { Some({ bits: 8, signed: true }) }
  else if name == b"I16" { Some({ bits: 16, signed: true }) }
  else if name == b"I32" { Some({ bits: 32, signed: true }) }
  else if name == b"I64" { Some({ bits: 64, signed: true }) }
  else if name == b"U128" { Some({ bits: 128, signed: false }) }
  else if name == b"I128" { Some({ bits: 128, signed: true }) }
  else { None }

fn width_index(width: Width) -> Int =
  if width.bits == 128 { if width.signed { 9 } else { 8 } } else {
    (if width.signed { 4 } else { 0 })
      + (if width.bits == 8 { 0 }
      else if width.bits == 16 { 1 }
      else if width.bits == 32 { 2 }
      else { 3 })
  }

/// Whether a value of the width is held in a C register of its own type: up to 64 bits.
fn carried(width: Width) -> Bool = width.bits <= 64

/// Whether the width's word is an `Int`'s immediate, as below 64 bits; at 64 it is an object of
/// the width's own, which compares by the width's order.
fn in_imm(width: Width) -> Bool = width.bits < 64

fn width_min(width: Width) -> Int = if width.signed { 0 - pow(2, width.bits - 1) } else { 0 }

fn width_max(width: Width) -> Int =
  if width.signed { pow(2, width.bits - 1) - 1 } else { pow(2, width.bits) - 1 }

fn as_num(value: CValue, width: Width) -> Bytes =
  match value.kind {
    KNum(h) -> if h == width { value.expr }
    else { bytes_concat_all([b"(", ctype(KNum(width)), b")(", value.expr, b")"]) },
    KBoxed -> if in_imm(width) {
      bytes_concat_all([b"(", ctype(KNum(width)), b")ply_imm_value(", value.expr, b")"])
    } else { bytes_concat_all([b"(", ctype(KNum(width)), b")ply_words(", value.expr, b")[0]"]) },
    _ -> bytes_concat_all([b"(", ctype(KNum(width)), b")(", value.expr, b")"]),
  }

/// An emitted value: the kind it is held at and the C expression naming it.
pub type CValue = { kind: Kind, expr: Bytes, ty: Ty }

/// `TyArr`: an array, with how it holds its elements where its element type says (as a record's field
/// `e` of that type is held), and `None` where the type is a variable's.
/// The program's constructor table: the names its tags are positions of, and the arguments of each
/// constructor whose declaration lays one out other than as its word.
pub type Ctors = { names: List<Bytes>, laid: Map<Bytes, List<FieldTy>> }

fn no_ctors() -> Ctors = { names: [], laid: map_new() }

/// `TyOpen([])` names the type variables that left the layout unknown, which a specialisation settles.
pub type Ty = | TyOpen(List<Int>) | TyRec(List<FieldTy>) | TyBytes | TyList | TyArr(Option<FieldTy>)

/// The type the checker settled an operator's operands at, which alone decides what the operator
/// means; how an operand happens to be held only decides how it is read. `OWord` is read by the
/// runtime's own operators: whatever `==` compares structurally.
type Operand = | OInt | OBool | OWidth(Width) | OFloat | ODec | OChar | OWord

/// `None` where the checker settled no type, which it does for every operator of a checked program.
fn operand_at(emitter: Emitter, span: Span) -> Option<Operand> =
  match map_get(emitter.operands, span_key(span)) {
    None -> None,
    Some(name) -> if name == unsettled() { None }
    else if name == b"Int" { Some(OInt) }
    else if name == b"Bool" { Some(OBool) }
    else if name == b"Float" { Some(OFloat) }
    else if name == b"Decimal" { Some(ODec) }
    else if name == b"Char" { Some(OChar) }
    else { match width_named(name) { Some(w) -> Some(OWidth(w)), None -> Some(OWord) } },
  }

/// `emitter` noting that the operator at `span` is done by the runtime because the checker settled its
/// operands at type variable `'i`, which a scalar argument would do in C.
fn operand_needed(emitter: Emitter, span: Span) -> Emitter =
  match map_get(emitter.operands, span_key(span)) {
    Some(name) -> if bytes_len(name) > 1 && bytes_at(name, 0) == 39 {
      needing(emitter, digits(bytes_slice(name, 1, bytes_len(name))), false)
    } else { emitter },
    None -> emitter,
  }

/// `emitter` noting the type variables that left `ty` unknown, where it is.
fn open_needed(emitter: Emitter, ty: Ty) -> Emitter =
  match ty {
    TyOpen(vs) -> fold(vs, emitter, |e: Emitter, v: Int| needing(e, v, true)),
    _ -> emitter,
  }

/// `emitter` noting, where builtin `name` reads an element in place (`array_get`, or a field of
/// `columns_get`'s record), the type variables that left the element's layout unknown at the
/// reference `at`.
fn element_needed(emitter: Emitter, name: Bytes, at: Span) -> Emitter =
  if name != b"array_get" && name != b"columns_get" { emitter } else {
    match map_get(emitter.typed, span_key(at)) {
      Some(t) -> match list_at(t.args, 0) {
        Some(element) -> if laid_field(b"e", element) == None { layout_needed(emitter, element) }
        else { emitter },
        None -> emitter,
      },
      None -> emitter,
    }
  }

/// `emitter` noting each type variable that left the layout of the value at `span` unknown.
fn layout_needed_at(emitter: Emitter, span: Span) -> Emitter =
  match map_get(emitter.typed, span_key(span)) {
    Some(t) -> layout_needed(emitter, t.ty),
    None -> emitter,
  }

/// `emitter` noting each type variable whose layout a value of `ty` is laid out by: the type itself,
/// a record's fields and an array's or columns' element, through records and arrays.
fn layout_needed(emitter: Emitter, ty: Type) -> Emitter =
  fold(laid_vars(ty), emitter, |e: Emitter, v: Int| needing(e, v, true))

pub fn laid_vars(ty: Type) -> List<Int> =
  match ty {
    TyVar(v) -> if v >= 0 { [v] } else { [] },
    TyRecord(fs) -> fold(fs, [], |acc: List<Int>, f: Field| concat(acc, laid_vars(f.ty))),
    TyNominal(x) -> fold(x.fields, [], |acc: List<Int>, f: Field| concat(acc, laid_vars(f.ty))),
    TyCon(c) -> if (c.name == b"Array" || c.name == b"Columns") && len(c.args) == 1 {
      fold(c.args, [], |acc: List<Int>, a: Type| concat(acc, laid_vars(a)))
    } else { [] },
    _ -> [],
  }

/// `emitter` noting that its code took a slow path because type variable `var` was unknown: its
/// whole layout, where `layout`, else whether it is a scalar.
fn needing(emitter: Emitter, var: Int, layout: Bool) -> Emitter =
  if fold(emitter.generics.needs, false, |seen: Bool, n: Need|
      seen || n == { var: var, layout: layout }) { emitter } else {
    {
      ..emitter,
      generics: {
        ..emitter.generics,
        needs: push(emitter.generics.needs, { var: var, layout: layout }),
      },
    }
  }

fn unsettled_operator(emitter: Emitter, what: Bytes) -> WithValue =
  refused(emitter, bytes_concat(b"an operator the checker settled no operand type for: ", what))

/// Fields in written order; a field's kind decides whether reading it unboxes, so it must not default to `KInt`.
pub type FieldTy = { name: Bytes, kind: Kind, ty: Ty }

/// `conv`: slots already unboxed -- a parameter is unboxed once and later reads reuse that temporary.
/// `reads`: every slot read in the body, counted whole because reads are not emitted in the order they were marked.
pub type Emitter = {
  out: List<Bytes>,
  temp_count: Int,
  unboxed: List<Unboxed>,
  indent: Int,
  reads: List<Int>,
  shapes: List<List<Bytes>>,
  built: List<Built>,
  module: Bytes,
  base: Int,
  /// Locals holding a count only this body can name; a callee taking one is handed the count, not a duplicate.
  count_locals: List<CountLocal>,
  /// This module's definitions; any other bare name is a builtin or an import.
  here: List<Def>,
  imports: List<Imported>,
  /// Literals in first-met order: a body indexes the unit's tables by its own positions.
  consts: List<Lit>,
  /// Every constructor's program-wide name; a tag is its index here.
  ctors: Ctors,
  /// Lambda sub-functions, written after the function that builds the closure.
  lambda_bodies: Bytes,
  /// This body's code table: each lambda's entry and each pure nullary constant's entry.
  lambdas: List<Bytes>,
  /// Sub-functions are numbered under the named function, not an enclosing lambda.
  /// The definition being emitted, by its full name.
  owner: Bytes,
  builtins: List<Bytes>,
  called_builtins: List<Bytes>,
  /// Field names met, for reads whose record shape is unknown.
  fields: List<Bytes>,
  /// Nothing is emitted after the current node, so a tail update may release its base whatever its read count,
  /// and a self call restarts the body. Kept into block tails, `if`/`match` arms and the right of `&&`/`||`;
  /// cleared into call arguments, where a fused loop body runs repeatedly.
  tail: Bool,
  /// Program-wide names this body calls: a cached body is checked against this set.
  calls: List<Bytes>,
  /// Each call of a generic program definition and each slow path a type variable took here.
  generics: Generics,
  /// The first refusal; emission runs on in a poisoned state, so no signature carries it.
  refused: Option<Bytes>,
  /// Flat records built from locals, held back until their word is asked for; their locals are declared at the top.
  deferred: List<Deferred>,
  deferred_locals: List<Bytes>,
  /// `landing`: the label a failing call inside a `handle` body jumps to.
  performs: List<Bytes>,
  handles: List<Bytes>,
  landing: Option<Bytes>,
  effects: List<EffectName>,
  /// Slots already released: two reads can both be marked `Owned`, and releasing at both double-frees.
  released: List<Bytes>,
  /// Reuse-token widths actually used, declared afterwards at the top: predicting them would duplicate the release rule.
  reuse_widths: List<Int>,
  /// `by_root` counts reads per object, not per name: an object with three names each read once has three reads.
  alias: List<{ local: Bytes, root: Bytes }>,
  by_root: List<{ root: Bytes, n: Int }>,
  /// Off, every count is held until the entry ends. On: `bound` are locals a slot names, moved only at
  /// a read marked `Owned`; `pinned` are ones a fused loop body may read but never move.
  release: Bool,
  pinned: List<Bytes>,
  bound: List<Bytes>,
  /// The full names of the definitions sharing this C function, in case order; empty outside a group.
  group: List<Bytes>,
  /// The checker's operand type at each operator's site, as `operand_at` reads it.
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
  /// How this root hands back its answer; a failing exit returns its zero.
  answer: Kind,
  /// The root a site is filed under where it is not this one's: a lambda of another root's run here.
  site_root: Option<Bytes>,
  /// The callers' lambdas this root runs in place of calls of the parameters they were handed as.
  lent: List<BoundLambda>,
  /// The lambdas the root's own code writes, which a callee names by their place among them.
  written: List<Lambda>,
}

/// `ret_ty` keeps a record answer's fields so later reads get offsets; `pure` lets a nullary call come from the constant table.
pub type Def = {
  name: Bytes,
  ret: Option<Kind>,
  ret_ty: Ty,
  pure: Bool,
  arity: Int,
  scheme: Option<Scheme>,
  /// How each parameter its function takes and its answer cross a call, as `carriers_of` says, and
  /// how many witnesses come before the parameters its scheme writes.
  carriers: List<Carrier>,
  answer: Carrier,
  witnesses: Int,
}

/// An imported name lowers like a builtin; only the import list tells them apart. `defs` is empty when the module is out of reach.
/// `whole` binds the module itself, which only a qualified name reaches: a bare `map` is never `std.map`.
pub type Imported = { name: Bytes, module: Bytes, defs: List<Def>, whole: Bool }

pub type ModuleDefs = { module: Bytes, defs: List<Def> }

/// A record this body built: a field read of it reuses the built value (sound: the values are this body's locals).
pub type Built = { local: Bytes, names: List<Bytes>, vals: List<CValue> }

/// A flat record held back until something reads it as a word: `n` words of `shape`, each of
/// `cells` written at its place.
pub type Deferred = {
  name: Bytes,
  shape: Int,
  n: Int,
  flags: Int,
  cells: List<{ at: Int, expr: Bytes }>,
}

/// A C local holding one count, released at its block's close unless spent first.
pub type CountLocal = { name: Bytes, indent: Int }

pub type EffectName = { written: Bytes, global: Bytes, ops: List<OpMode> }

pub type OpMode = { name: Bytes, mode: Mode }

pub type Unboxed = { slot: Int, kind: Kind, expr: Bytes, ty: Ty }

/// A parameter as the body holds it, and its `carrier`: how it arrives, as a word the prologue
/// opens to `kind`, as the value itself, or as a record's fields.
pub type EmitParam = {
  name: Bytes,
  kind: Kind,
  ty: Ty,
  carrier: Carrier,
  /// The caller's lambda this parameter is, which a call of it runs in place.
  lambda: Option<BoundLambda>,
}

/// A caller's lambda a specialisation runs where it calls the parameter it was handed as: the
/// lambda as its owner lowered it, and what the owner's body is emitted under.
pub type BoundLambda = {
  owner: Bytes,
  at: Int,
  nth: Int,
  code: Lambda,
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  effects: List<EffectName>,
  typed: Map<Bytes, Typed>,
  operands: Map<Bytes, Bytes>,
  base: Int,
}

/// How a value crosses a call between roots: whole, as its word or as its value in its own C type,
/// or, a small flat record, as each of its fields in its own C type. A record answer returns its
/// first field and writes the others through pointers its caller hands it.
pub type Carrier = | Whole(Kind) | Fields(List<FieldTy>)

pub type WithValue = { emitter: Emitter, value: CValue }

/// Where a `match` arm's answer goes: the answer local of its kind, or a fused `iterate` step's loop
/// control.
pub type Sink =
  | ToValue({ name: Bytes, kind: Kind })
  | ToLoop({ state: Bytes, answer: Bytes, stop: Int, go: Int, depth: Int })

/// Lines are joined once at the end; appending to one string would be quadratic.
fn line(emitter: Emitter, text: Bytes) -> Emitter =
  {
    out: push(emitter.out, bytes_concat_all([pad(emitter.indent), text, b"\n"])),
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: emitter.built,
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: emitter.released,
    reuse_widths: emitter.reuse_widths,
    alias: emitter.alias,
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred,
    deferred_locals: emitter.deferred_locals,
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
  }

fn pad(ind: Int) -> Bytes = if ind <= 0 { b"  " } else { bytes_concat(b"  ", pad(ind - 1)) }

fn indent(emitter: Emitter) -> Emitter =
  {
    out: emitter.out,
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent + 1,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: emitter.built,
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: emitter.released,
    reuse_widths: emitter.reuse_widths,
    alias: emitter.alias,
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred,
    deferred_locals: emitter.deferred_locals,
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
  }

fn outdent(emitter: Emitter) -> Emitter =
  {
    out: emitter.out,
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent - 1,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: emitter.built,
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: emitter.released,
    reuse_widths: emitter.reuse_widths,
    alias: emitter.alias,
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred,
    deferred_locals: emitter.deferred_locals,
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
  }

/// Restoring the node's own `tail` makes an arm a tail again after its scrutinee or condition.
fn withtail(emitter: Emitter, t: Bool) -> Emitter =
  if emitter.tail == t { emitter } else {
    {
      out: emitter.out,
      temp_count: emitter.temp_count,
      unboxed: emitter.unboxed,
      indent: emitter.indent,
      reads: emitter.reads,
      shapes: emitter.shapes,
      built: emitter.built,
      module: emitter.module,
      base: emitter.base,
      count_locals: emitter.count_locals,
      here: emitter.here,
      imports: emitter.imports,
      consts: emitter.consts,
      ctors: emitter.ctors,
      lambda_bodies: emitter.lambda_bodies,
      lambdas: emitter.lambdas,
      owner: emitter.owner,
      builtins: emitter.builtins,
