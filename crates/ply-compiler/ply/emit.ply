/// The last entry wins: a `let` may shadow a slot an enclosing scope filled.
fn conv_of(emitter: Emitter, slot: Int) -> Option<CValue> =
  fold(emitter.unboxed, None, |acc: Option<CValue>, unboxed: Unboxed|
    if unboxed.slot == slot { Some({ kind: unboxed.kind, expr: unboxed.expr, ty: unboxed.ty }) }
    else { acc })

fn remember(em0: Emitter, slot: Int, value: CValue) -> Emitter = {
  let emitter = charge(em0, slot, value.expr);
  let em1: Emitter = if counted(value.kind) { note_bound(emitter, value.expr) } else { emitter };
  {
    ..em1,
    unboxed: push(em1.unboxed, { slot: slot, kind: value.kind, expr: value.expr, ty: value.ty }),
  }
}

fn bind(emitter: Emitter, k: Kind, expr: Bytes) -> WithValue = {
  let f = fresh(emitter);
  // A held-back record is already its local; the temporary number is still spent to keep numbering aligned.
  if fold(emitter.deferred_locals, false, |acc: Bool, r: Bytes| acc || r == expr) {
    { emitter: f.emitter, value: { kind: k, expr: expr, ty: TyOpen([]) } }
  } else {
    let o = line(f.emitter, bytes_concat_all([ctype(k), b" ", f.name, b" = ", expr, b";"]));
    // A rename keeps the fields the record was built from; without this the knowledge dies at the first block.
    let kept0 = match built_of(o, expr) {
      Some(b) -> remember_built(o, f.name, b.names, b.vals),
      None -> o,
    };
    let kept = if is_local(expr) { note_alias(kept0, f.name, root_of(kept0, expr)) } else { kept0 };
    let held = if counted(k) && answers_owned(kept, expr) { note_made(kept, f.name) }
    else if counted(k) && kept.release && spendable(kept, expr) {
      note_made(line(spend_made(kept, expr), bytes_concat_all([expr, b" = 0;"])), f.name)
    } else { kept };
    { emitter: held, value: { kind: k, expr: f.name, ty: TyOpen([]) } }
  }
}

fn deferred_of(emitter: Emitter, name: Bytes) -> Option<Deferred> =
  fold(emitter.deferred, None, |acc: Option<Deferred>, d: Deferred|
    if d.name == name { Some(d) } else { acc })

/// Built at the first demand for its word; the guard stops a second demand building it twice.
fn materialise(emitter: Emitter, name: Bytes) -> Emitter =
  match deferred_of(emitter, name) {
    None -> emitter,
    Some(d) -> {
      let o1 = line(note_tok(emitter, d.n), bytes_concat_all([b"if (!", name, b") {"]));
      let o2 = line(indent(o1), bytes_concat_all([b"if (tok", ascii_of_int(d.n), b") {"]));
      let o3 = line(
        indent(o2),
        bytes_concat_all([
          name,
          b" = tok",
          ascii_of_int(d.n),
          b"; tok",
          ascii_of_int(d.n),
          b" = 0;",
        ]),
      );
      let o4 = line(
        o3,
        bytes_concat_all([
          b"ply_obj(",
          name,
          b")->rc = 1; ply_obj(",
          name,
          b")->kind = 3; ply_obj(",
          name,
          b")->flags = ",
          ascii_of_int(d.flags),
          b"; ply_obj(",
          name,
          b")->len = ",
          ascii_of_int(d.n),
          b"; ply_obj(",
          name,
          b")->layout = @@s",
          ascii_of_int(d.shape),
          b"@@;",
        ]),
      );
      let o5 = line(
        indent(line(outdent(o4), b"} else {")),
        bytes_concat_all([
          name,
          b" = rt_alloc_p(ctx, 3, ",
          ascii_of_int(d.n),
          b", @@s",
          ascii_of_int(d.shape),
          b"@@, ",
          ascii_of_int(d.flags),
          b");",
        ]),
      );
      let o6 = line(outdent(check(o5)), b"}");
      let o7 = fold(d.cells, o6, |acc: Emitter, c: { at: Int, expr: Bytes }|
        line(
          acc,
          bytes_concat_all([b"ply_words(", name, b")[", ascii_of_int(c.at), b"] = ", c.expr, b";"]),
        ));
      line(outdent(o7), b"}")
    },
  }

fn word_of(emitter: Emitter, value: CValue) -> { emitter: Emitter, expr: Bytes } =
  match value.kind {
    KBoxed -> { emitter: materialise(emitter, value.expr), expr: value.expr },
    // A box of its own, which this scope lets go; the value keeps its count.
    KMaybe -> {
      let b = bind(emitter, KBoxed, bytes_concat_all([b"rt_maybe_box_p(ctx, ", value.expr, b")"]));
      {
        emitter: if is_made(b.emitter, b.value.expr) { b.emitter }
        else { note_made(b.emitter, b.value.expr) },
        expr: b.value.expr,
      }
    },
    _ -> { emitter: emitter, expr: as_word(value) },
  }

