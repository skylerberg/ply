    deferred: emitter.deferred,
    deferred_locals: emitter.deferred_locals,
    performs: emitter.performs,
    handles: emitter.handles.push(eff),
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
    slices: emitter.slices,
    sums: emitter.sums,
    leaves: emitter.leaves,
  }

fn note_deferred(emitter: Emitter, d: Deferred) -> Emitter =
  note_holder(push_deferred(emitter, d), d.name)

fn slice_of(emitter: Emitter, name: Bytes) -> Option<Slice> =
  emitter.slices.fold(None, |acc: Option<Slice>, sl: Slice|
    if sl.name == name { Some(sl) } else { acc })

/// `emitter` holding the list `base` read from `from` on as `name`, which the body declares.
fn note_slice(emitter: Emitter, name: Bytes, base: Bytes, from: Bytes) -> Emitter =
  {
    ..emitter,
    slices: emitter.slices.push({ name: name, base: base, from: from }),
    deferred_locals: emitter.deferred_locals.push(name),
  }

/// The list `sl` reads, made a list of its own: the elements from its offset on, or its base
/// itself, counted once more, where the offset is zero.
fn sliced_list(emitter: Emitter, sl: Slice, ty: Ty) -> WithValue = {
  let f = fresh(emitter);
  let made = line(
    f.emitter,
    Bytes::concat_all([
      b"Word ",
      f.name,
      b" = ",
      sl.from,
      b" ? rt_list_rest_p(ctx, ",
      sl.base,
      b", ",
      sl.from,
      b") : ",
      sl.base,
      b"; if (!",
      sl.from,
      b") ply_inc(",
      f.name,
      b");",
    ]),
  );
  { emitter: note_made(made, f.name), value: { kind: KBoxed, expr: f.name, ty: ty } }
}

fn push_deferred(emitter: Emitter, d: Deferred) -> Emitter =
  {
    out: emitter.out,
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: emitter.built,
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: emitter.released,
    reuse_widths: emitter.reuse_widths,
    alias: emitter.alias,
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred.push(d),
    deferred_locals: emitter.deferred_locals.push(d.name),
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
    slices: emitter.slices,
    sums: emitter.sums,
    leaves: emitter.leaves,
  }

/// Whether a record holds a value of `kind` as its own words rather than as a word: an `Int`, a
/// width, a `Float` or a `Decimal`. A width below 64 bits is held as the `Int` it stands for.
fn raw_slot(kind: Kind) -> Bool =
  match kind { KInt -> true, KFloat -> true, KDec -> true, KNum(_) -> true, _ -> false }

/// The kind a slot holding a value of `kind` as a word reads as: an `Option` its payload's word.
fn word_kind(kind: Kind) -> Kind = if kind == KSum(Zeroed) { KSum(Zeroed) } else { KBoxed }

/// The words a record holds a field of `kind` in: a `Decimal`'s two, and one for any other.
fn raw_words(kind: Kind) -> Int = match kind { KDec -> 2, _ -> 1 }

/// What a record holds `value` in, held at the kind `raw_slot` says it holds as its own words: its
/// word, or for a `Decimal` the local holding its two, which `cells_of` writes apart.
fn raw_word(value: CValue) -> Bytes =
  match value.kind {
    KInt -> Bytes::concat_all([b"(Word)(", value.expr, b")"]),
    KNum(_) -> Bytes::concat_all([b"(Word)(", value.expr, b")"]),
    KDec -> value.expr,
    _ -> Bytes::concat_all([b"ply_f64_bits(", as_float(value), b")"]),
  }

/// The word a record holds `value` in where it holds it as a word: an `Option` held as its
/// payload's word as that word.
fn held_word(value: CValue) -> Bytes =
  if value.kind == KSum(Zeroed) { value.expr } else { as_word(value) }

/// The word a record holds `value` in as a field of kind `kind`: its bits read at that kind where
/// `raw_slot` holds of it, whatever kind the value is held at, and its word otherwise.
fn field_word(value: CValue, kind: Kind) -> Bytes =
  if !raw_slot(kind) { held_word(value) }
  else if value.kind == kind || kind == KDec { raw_word(value) } else {
    match kind {
      KInt -> Bytes::concat_all([b"(Word)(", as_int(value), b")"]),
      KNum(w) -> Bytes::concat_all([b"(Word)(", as_num(value, w), b")"]),
      _ -> Bytes::concat_all([b"ply_f64_bits(", as_float(value), b")"]),
    }
  }

/// The field of `kind` that `base` holds as its own words from word `at` on, read as the kind.
fn raw_at(base: Bytes, at: Bytes, kind: Kind) -> Bytes = {
  let word = Bytes::concat_all([b"ply_words(", base, b")[", at, b"]"]);
  match kind {
    KInt -> Bytes::concat_all([b"(int64_t)(", word, b")"]),
    KNum(w) -> Bytes::concat_all([b"(", ctype(KNum(w)), b")(", word, b")"]),
    KDec -> Bytes::concat_all([b"ply_dec_at(", base, b", ", at, b")"]),
    _ -> Bytes::concat_all([b"ply_f64(", word, b")"]),
  }
}

/// The statement writing `value` over the field of `kind` that `base` holds as its own words from
/// word `at` on.
fn raw_store(base: Bytes, at: Bytes, value: CValue, kind: Kind) -> Bytes =
  match kind {
    KDec -> Bytes::concat_all([b"ply_set_dec(", base, b", ", at, b", ", as_dec(value), b");"]),
    _ -> Bytes::concat_all([b"ply_words(", base, b")[", at, b"] = ", raw_word(value), b";"]),
  }

/// `value` held at `kind`, a kind `raw_slot` holds of, in a register: a `Decimal` in a local.
fn held_raw(emitter: Emitter, value: CValue, kind: Kind) -> WithValue =
  match kind {
    KInt -> if value.kind == KInt { { emitter: emitter, value: value } }
    else { bind(emitter, KInt, as_int(value)) },
    KNum(w) -> if value.kind == kind { { emitter: emitter, value: value } }
    else { bind(emitter, kind, as_num(value, w)) },
    KDec -> if value.kind == KDec && is_local(value.expr) { { emitter: emitter, value: value } }
    else { bind(emitter, KDec, as_dec(value)) },
    _ -> float_held(emitter, value),
  }

/// The fields of the record a field holds in place: one of a record type, which its record copies
/// into its own words.
fn in_place(f: FieldTy) -> Option<List<FieldTy>> = match f.ty { TyRec(fs) -> Some(fs), _ -> None }

/// Where a record of `fs` holds each field, how many words it holds, the words of the tail a mixed
/// one's bitmap takes after them, and which words it counts: a field takes a word, and a record held
/// in place its header's two, its own and its tail's. `heap::Shapes` lays a shape out alike.
type Laid = { width: Int, tail: Int, offsets: List<Int>, counted: List<Int> }

fn laid_of(fs: List<FieldTy>) -> Laid = {
  let s = fs.fold(
    { at: 0, offsets: [], counted: [] },
    |acc: { at: Int, offsets: List<Int>, counted: List<Int> }, f: FieldTy|
      match f.ty {
        TyRec(inner) -> {
          let l = laid_of(inner);
          {
            at: acc.at + 2 + l.width + l.tail,
            offsets: acc.offsets.push(acc.at),
            counted: acc.counted.concat(l.counted.map(|c: Int| acc.at + 2 + c)),
          }
        },
        _ ->
          {
            at: acc.at + raw_words(f.kind),
            offsets: acc.offsets.push(acc.at),
            counted: if raw_slot(f.kind) { acc.counted } else { acc.counted.push(acc.at) },
          },
      },
  );
  let n = s.counted.len();
  {
    width: s.at,
    tail: if n > 0 && n < s.at { (s.at + 63) / 64 } else { 0 },
    offsets: s.offsets,
    counted: s.counted,
  }
}

/// A field as a shape spells it: a scalar held as its bits after its name, a width below 64 bits as
/// the `Int` it stands for, and a record held in place after its name with its own shape's fields,
/// all below every byte a name holds so a shape sorts as its names do.
pub fn spelled_field(f: FieldTy) -> Bytes =
  match f.ty {
    TyRec(inner) ->
      Bytes::concat_all([f.name, b"!r(", bytes_join(inner.map(spelled_field), b","), b")"]),
    _ -> match f.kind {
      KInt -> f.name.concat(b"!int"),
      KFloat -> f.name.concat(b"!f"),
      KDec -> f.name.concat(b"!d"),
      KSum(_) -> f.name.concat(b"!m"),
      KNum(w) ->
        f.name.concat(if in_imm(w) { b"!int" } else if w.signed { b"!i64" } else { b"!u64" }),
      _ -> f.name,
    },
  }

/// A record's flags: flat when none of its words holds a count, mixed when its tail says which
/// do, raw when it holds a scalar's bits or a record in place.
fn record_flags(fs: List<FieldTy>, l: Laid) -> Int = {
  let raw = if fs.fold(false, |acc: Bool, f: FieldTy|
      acc || raw_slot(f.kind) || f.kind == KSum(Zeroed) || in_place(f) != None) { 4 }
  else { 0 };
  if l.width > 0 && leaves_uncounted(fs) { 1 + raw } else if l.tail > 0 { 2 + raw } else { raw }
}

fn leaves_uncounted(fs: List<FieldTy>) -> Bool =
  fs.fold(true, |acc: Bool, f: FieldTy|
    acc
      && (match f.ty {
        TyRec(inner) -> leaves_uncounted(inner),
        _ -> match f.kind {
          KInt -> true,
          KNum(_) -> true,
          KBool -> true,
          KFloat -> true,
          KDec -> true,
          _ -> false,
        },
      }))

fn has_tail(flags: Int) -> Bool = flags & 2 != 0

/// Whether a record of `fs` is held back as its fields' values until its word is asked for: one of
/// no record held in place.
fn holdable(fs: List<FieldTy>) -> Bool =
  fs.len() > 0 && fs.fold(true, |ok: Bool, f: FieldTy| ok && in_place(f) == None)

/// The bitmap after a mixed record's words: a bit set for each word it counts, 64 to a word.
fn tail_bits(l: Laid) -> List<Bytes> =
  range(0, l.tail).map(|t: Int|
    int_lit(
      l.counted.fold(0, |acc: Int, c: Int| if c / 64 == t { acc | 1 << c % 64 } else { acc }),
    ))

/// The fields a record written at `at` holds `names` as: read off the type the checker filed there.
/// A record whose type holds a field of a variable's type, in place or not, has none, and is laid
/// out by what its fields hold when it is made.
fn laid_out(emitter: Emitter, at: Span, names: List<Bytes>) -> Option<List<FieldTy>> =
  match emitter.typed.get(span_key(at)) {
    None -> None,
    Some(t) -> match kind_of(t.ty).ty {
      TyRec(fs) ->
        Some(
          names.map(|nm: Bytes|
            fs.fold({ name: nm, kind: KBoxed, ty: TyOpen([]) }, |k: FieldTy, f: FieldTy|
              if f.name == nm { f } else { k })),
        ),
      _ -> None,
    },
  }

fn kinds_of(fs: List<FieldTy>) -> List<Kind> = fs.map(|f: FieldTy| f.kind)

fn kind_at(kinds: List<Kind>, at: Int) -> Kind = match kinds.at(at) { Some(k) -> k, None -> KBoxed }

/// A record of `names` holding `words`, which it takes, laid out by the runtime as a record of the
/// values they are: the layout its type has wherever it is made.
fn record_by_value(emitter: Emitter, names: List<Bytes>, words: List<Bytes>) -> WithValue = {
  let sh = shape_of(emitter, names);
  let arr = fresh(sh.emitter);
  let e = line(
    arr.emitter,
    Bytes::concat_all([
      b"Word ",
      arr.name,
      b"[] = {",
      if words.len() == 0 { b"0" } else { bytes_join(words, b", ") },
      b"};",
    ]),
  );
  let o = bind(
    e,
    KBoxed,
    Bytes::concat_all([
      b"rt_record_p(ctx, @@s",
      ascii_of_int(sh.i),
      b"@@, (Word)(intptr_t)",
      arr.name,
      b", ",
      ascii_of_int(words.len()),
      b")",
    ]),
  );
  { emitter: check(o.emitter), value: o.value }
}

/// `value` as a `Float` held in a register.
fn float_held(emitter: Emitter, value: CValue) -> WithValue =
  if value.kind == KFloat { { emitter: emitter, value: value } }
  else { bind(emitter, KFloat, as_float(value)) }

/// The shape of a record of `fs`, each shape it holds in place registered before it, which is the
/// order the unit's table and the runtime's interning give them.
fn shape_of_fields(emitter: Emitter, fs: List<FieldTy>) -> { emitter: Emitter, i: Int } = {
  let nested = fs.fold(emitter, |acc: Emitter, f: FieldTy|
    match f.ty { TyRec(inner) -> shape_of_fields(acc, inner).emitter, _ -> acc });
  shape_of(nested, fs.map(spelled_field))
}

/// What a record or constructor being built holds at word `at`: a value written there, a record
/// copied there whole with `tail` the words its shape's bitmap takes, or the header of a record whose
/// words were written there as its fields. A record's header counts back to its holder's, which a
/// copy of the holder keeps: `holder` is the word of the header of the record held in place that
/// holds it, none where the object being built does.
type WordAt =
  | Put({ at: Int, expr: Bytes })
  | Copied({ at: Int, expr: Bytes, tail: Int, holder: Option<Int> })
  | Header({ at: Int, flags: Int, len: Int, shape: Int, holder: Option<Int> })

/// A record argument written as a literal where its holder keeps a record in place: the cells of
/// its fields, from its header's word on, which the holder writes at the argument's place.
type Placed = { slot: Int, cells: List<WordAt> }

/// `c` moved `by` words on; one the object held moves with its holder's words.
fn shifted(c: WordAt, by: Int) -> WordAt =
  match c {
    Put(x) -> Put({ ..x, at: x.at + by }),
    Copied(x) -> Copied({ ..x, at: x.at + by, holder: moved(x.holder, by) }),
    Header(x) -> Header({ ..x, at: x.at + by, holder: moved(x.holder, by) }),
  }

fn moved(holder: Option<Int>, by: Int) -> Option<Int> =
  match holder { Some(h) -> Some(h + by), None -> None }

/// `c`, a cell of a record held in place whose header is at word 0, moved to its words from word 2:
/// what the record held is held by its header there.
fn held_inside(c: WordAt) -> WordAt =
  match c {
    Put(x) -> Put({ ..x, at: x.at + 2 }),
    Copied(x) ->
      Copied({
        ..x,
        at: x.at + 2,
        holder: match x.holder { Some(h) -> Some(h + 2), None -> Some(0) },
      }),
    Header(x) ->
      Header({
        ..x,
        at: x.at + 2,
        holder: match x.holder { Some(h) -> Some(h + 2), None -> Some(0) },
      }),
  }

/// The C word a cell's holder is, and the cell's word among its holder's.
fn held_at(rec: Bytes, at: Int, holder: Option<Int>) -> { base: Bytes, at: Int } =
  match holder {
    None -> { base: rec, at: at },
    Some(h) ->
      {
        base: Bytes::concat_all([
          b"((Word)(intptr_t)(ply_words(",
          rec,
          b") + ",
          ascii_of_int(h),
          b"))",
        ]),
        at: at - h - 2,
      },
  }

fn put_cells(cells: List<WordAt>) -> List<{ at: Int, expr: Bytes }> =
  cells.fold([], |acc: List<{ at: Int, expr: Bytes }>, c: WordAt|
    match c { Put(x) -> acc.push(x), _ -> acc })

/// `words` are the record's, one per field in `fields`' order; where `raw_slot` holds of a field's
/// kind its word is a `Float`'s bits, and where the field is held in place it is the record kept
/// there, which the record takes. A record built from locals is held back, as `word` where it was
/// made already, zero where not, when each record it holds in place is a word or one held back of
/// none; others are built now, from a reuse token if one fits.
fn build_record(
  emitter: Emitter,
  names: List<Bytes>,
  words: List<Bytes>,
  fields: List<FieldTy>,
  vals: Option<List<CValue>>,
  word: Bytes,
) -> WithValue = {
  let n = names.len();
  let sh = shape_of_fields(emitter, fields);
  let l = laid_of(fields);
  let flags = record_flags(fields, l);
  let ty = TyRec(fields);
  match vals {
    Some(vs) -> match inners_of(sh.emitter, fields, words, vs, l) {
      Some(inner) -> {
        let f = fresh(sh.emitter);
        let counts = range(0, n).fold([], |acc: List<Bytes>, i: Int| {
          let fi = nth_field(fields, i);
          if counted(fi.kind) && in_place(fi) == None { acc.push(nth_bytes(words, i)) } else { acc }
        });
        // No read moves a counted field or a record held in place out from under the record but
        // one `moved_field` allows.
        let holding = counts.concat(inner.map(|x: Inner| x.name)).fold(
          f.emitter,
          |e: Emitter, w: Bytes| note_bound(if is_made(e, w) { e } else { note_holder(e, w) }, w),
        );
        let held = line(
          note_deferred(holding, {
            name: f.name,
            shape: sh.i,
            n: l.width,
            flags: flags,
            cells: put_cells(cells_of(fields, words, [], l, flags)),
            counts: counts,
            inner: inner,
          }),
          Bytes::concat_all([f.name, b" = ", word, b";"]),
        );
        {
          emitter: remember_built(held, f.name, names, vs),
          value: { kind: KBoxed, expr: f.name, ty: ty },
        }
      },
      None -> {
        let p = placed_values(sh.emitter, fields, words, vs);
        // What a field held in place was is copied and let go, so only the record's other fields
        // are remembered as values.
        let k = range(0, n).fold(
          { names: [], vals: [] },
          |acc: { names: List<Bytes>, vals: List<CValue> }, i: Int|
            if in_place(nth_field(fields, i)) != None { acc } else {
              { names: acc.names.push(nth_bytes(names, i)), vals: acc.vals.push(nth_value(vs, i)) }
            },
        );
        built_now(
          p.emitter,
          k.names,
          cells_of(fields, p.words, p.placed, l, flags),
          3,
          shape_text(sh.i),
          l.width,
          flags,
          ty,
          Some(k.vals),
        )
      },
    },
    // A record held back where a record is held in place is written there as its cells, as above.
    None -> {
      let p = placed_values(
        sh.emitter,
        fields,
        words,
        words.map(|w: Bytes| { kind: KBoxed, expr: w, ty: TyOpen([]) }),
      );
      built_now(
        p.emitter,
        names,
        cells_of(fields, p.words, p.placed, l, flags),
        3,
        shape_text(sh.i),
        l.width,
        flags,
        ty,
        None,
      )
    },
  }
}

/// The records a record of `fields` built of `words` holds in place, where it is held back: each a
/// record held back of none in place, or a word; none where one is anything else, or where the
/// record has no field.
fn inners_of(
  emitter: Emitter,
  fields: List<FieldTy>,
  words: List<Bytes>,
  vals: List<CValue>,
  l: Laid,
) -> Option<List<Inner>> =
  if fields.len() == 0 { None } else {
    range(0, fields.len()).fold(Some([]), |acc: Option<List<Inner>>, i: Int|
      match acc {
        None -> None,
        Some(xs) -> match in_place(nth_field(fields, i)) {
          None -> acc,
          Some(inner) -> {
            let w = nth_bytes(words, i);
            let kept = match deferred_of(emitter, w) {
              Some(d) -> d.inner.len() == 0,
              None ->
                nth_value(vals, i).kind == KBoxed && is_local(w) && held_sum_of(emitter, w) == None
                  && slice_of(emitter, w) == None,
            };
            if kept {
              Some(
                xs.push({
                  at: match l.offsets.at(i) { Some(o) -> o, None -> i },
                  name: w,
                  tail: laid_of(inner).tail,
                }),
              )
            } else { None }
          },
        },
      })
  }

/// `words`, a record's or a constructor's of `slots` whose values are `vals`, with each record held
/// in place there that is held back of none in place written into the holder's cells, which take
/// its counts; any other is its word, which the holder copies.
fn placed_values(
  emitter: Emitter,
  slots: List<FieldTy>,
  words: List<Bytes>,
  vals: List<CValue>,
) -> { emitter: Emitter, words: List<Bytes>, placed: List<Placed> } =
  range(0, slots.len()).fold(
    { emitter: emitter, words: [], placed: [] },
    |acc: { emitter: Emitter, words: List<Bytes>, placed: List<Placed> }, i: Int| {
      let f = nth_field(slots, i);
      if in_place(f) == None { { ..acc, words: acc.words.push(nth_bytes(words, i)) } } else {
        let v = nth_value(vals, i);
        match deferred_cells(acc.emitter, v, Some(f)) {
          Some(p) ->
            {
              emitter: p.emitter,
              words: acc.words.push(b"0"),
              placed: acc.placed.push({ slot: i, cells: p.cells }),
            },
          None -> match deferred_of(acc.emitter, v.expr) {
            Some(_) -> {
              let w = owned(acc.emitter, v);
              { ..acc, emitter: w.emitter, words: acc.words.push(w.value.expr) }
            },
            None -> { ..acc, words: acc.words.push(nth_bytes(words, i)) },
          },
        }
      }
    },
  )

/// The words an object laid out as a record of `fields` is holds: `words`, one per field, each at
/// its offset, a `Decimal`'s local written as its two words, and the bitmap after them where
/// `flags` says it is mixed.
fn cells_of(
  fields: List<FieldTy>,
  words: List<Bytes>,
  placed: List<Placed>,
  l: Laid,
  flags: Int,
) -> List<WordAt> =
  range(0, fields.len()).fold([], |acc: List<WordAt>, i: Int| {
    let f = match fields.at(i) {
      Some(x) -> x,
      None -> { name: b"", kind: KBoxed, ty: TyOpen([]) },
    };
    let at = match l.offsets.at(i) { Some(o) -> o, None -> i };
    let expr = match words.at(i) { Some(w) -> w, None -> b"0" };
    match placed.fold(None, |found: Option<Placed>, p: Placed|
        if p.slot == i { Some(p) } else { found }) {
      Some(p) -> acc.concat(p.cells.map(|c: WordAt| shifted(c, at))),
      None -> if f.kind == KDec && in_place(f) == None {
        acc.concat([
          Put({ at: at, expr: expr.concat(b".lo") }),
          Put({ at: at + 1, expr: expr.concat(b".hi") }),
        ])
      } else {
        acc.push(match in_place(f) {
          Some(inner) -> Copied({ at: at, expr: expr, tail: laid_of(inner).tail, holder: None }),
          None -> Put({ at: at, expr: expr }),
        })
      },
    }
  }).concat(if has_tail(flags) {
    let bits = tail_bits(l);
    range(0, bits.len()).map(|t: Int|
      Put({ at: l.width + t, expr: match bits.at(t) { Some(b) -> b, None -> b"0" } }))
  } else { [] })

fn shape_text(shape: Int) -> Bytes = Bytes::concat_all([b"@@s", ascii_of_int(shape), b"@@"])

/// An object of `kind` (a record's 3, a constructor's 4) and `n` words built of `cells`, its header
/// naming `layout`. A token is taken for a mixed object only when it was one, so it has room for
/// the bitmap.
fn built_now(
  emitter: Emitter,
  names: List<Bytes>,
  cells: List<WordAt>,
  kind: Int,
  layout: Bytes,
  n: Int,
  flags: Int,
  ty: Ty,
  vals: Option<List<CValue>>,
) -> WithValue = {
  let rec = bind(note_tok(emitter, n), KBoxed, b"0");
  let opened = line(
    rec.emitter,
    Bytes::concat_all([
      b"if (tok",
      ascii_of_int(n),
      if has_tail(flags) {
        Bytes::concat_all([b" && (ply_obj(tok", ascii_of_int(n), b")->flags & PLY_MIXED)"])
      } else { b"" },
      b") {",
    ]),
  );
  let took = line(
    line(
      indent(opened),
      Bytes::concat_all([
        rec.value.expr,
        b" = tok",
        ascii_of_int(n),
        b"; tok",
        ascii_of_int(n),
        b" = 0;",
      ]),
    ),
    Bytes::concat_all([
      b"ply_obj(",
      rec.value.expr,
      b")->rc = 1; ply_obj(",
      rec.value.expr,
      b")->kind = ",
      ascii_of_int(kind),
      b"; ply_obj(",
      rec.value.expr,
      b")->flags = ",
      ascii_of_int(flags),
      b"; ply_obj(",
      rec.value.expr,
      b")->len = ",
      ascii_of_int(n),
      b"; ply_obj(",
      rec.value.expr,
      b")->layout = ",
      layout,
      b";",
    ]),
  );
  let made = check(
    line(
      indent(line(outdent(took), b"} else {")),
      Bytes::concat_all([
        rec.value.expr,
        b" = rt_alloc_p(ctx, ",
        ascii_of_int(kind),
        b", ",
        ascii_of_int(n),
        b", ",
        layout,
        b", ",
        ascii_of_int(flags),
        b");",
      ]),
    ),
  );
  let closed = line(outdent(made), b"}");
  // Words are written before a record is copied in place: copying lets the copied record go.
  let copied = |c: WordAt| match c { Copied(_) -> true, _ -> false };
  let stored = cells.filter(|c: WordAt| !copied(c)).concat(cells.filter(copied)).fold(
    closed,
    |acc: Emitter, c: WordAt|
      line(acc, match c {
        Put(x) ->
          Bytes::concat_all([
            b"ply_words(",
            rec.value.expr,
            b")[",
            ascii_of_int(x.at),
            b"] = ",
            x.expr,
            b";",
          ]),
        Copied(x) -> {
          let h = held_at(rec.value.expr, x.at, x.holder);
          Bytes::concat_all([
            b"ply_embed(ctx, ",
            h.base,
            b", ",
            ascii_of_int(h.at),
            b", ",
            x.expr,
            b", ",
            ascii_of_int(x.tail),
            b");",
          ])
        },
        Header(x) -> {
          let h = held_at(rec.value.expr, x.at, x.holder);
          Bytes::concat_all([
            b"ply_embedded(",
            h.base,
            b", ",
            ascii_of_int(h.at),
            b", ",
            ascii_of_int(x.flags),
            b", ",
            ascii_of_int(x.len),
            b", ",
            shape_text(x.shape),
            b");",
          ])
        },
      }),
  );
  let kept = match vals {
    Some(vs) -> remember_built(stored, rec.value.expr, names, vs),
    None -> stored,
  };
  {
    emitter: note_made(kept, rec.value.expr),
    value: { kind: KBoxed, expr: rec.value.expr, ty: ty },
  }
}

/// A constructor with arguments, built in this body's reuse token for its width when it holds one;
/// a token may be a record's cells or another constructor's, so the header is written whole.
fn ctor_built(emitter: Emitter, tag: Int, words: List<Bytes>) -> WithValue / {abort.raise} = {
  let n = words.len();
  let tok = b"tok".concat(ascii_of_int(n));
  let made = bind(note_tok(emitter, n), KBoxed, b"0");
  let r = made.value.expr;
  let flat = bytes_join(
    words.map(|w: Bytes| Bytes::concat_all([b"ply_is_imm(", w, b")"])),
    b" && ",
  );
  let took = line(
    line(
      indent(line(made.emitter, Bytes::concat_all([b"if (", tok, b") {"]))),
      Bytes::concat_all([r, b" = ", tok, b"; ", tok, b" = 0;"]),
    ),
    Bytes::concat_all([
      b"ply_obj(",
      r,
      b")->rc = 1; ply_obj(",
      r,
      b")->kind = 4; ply_obj(",
      r,
      b")->flags = (",
      flat,
      b") ? 1 : 0; ply_obj(",
      r,
      b")->len = ",
      ascii_of_int(n),
      b"; ply_obj(",
      r,
      b")->layout = ",
      tag_text(emitter, tag),
      b";",
    ]),
  );
  let stored = range(0, n).fold(took, |acc: Emitter, at: Int|
    line(
      acc,
      Bytes::concat_all([
        b"ply_words(",
        r,
        b")[",
        ascii_of_int(at),
        b"] = ",
        match words.at(at) { Some(w) -> w, None -> b"0" },
        b";",
      ]),
    ));
  let arr = fresh(indent(line(outdent(stored), b"} else {")));
  let called = check(
    line(
      line(
        arr.emitter,
        Bytes::concat_all([b"Word ", arr.name, b"[] = {", bytes_join(words, b", "), b"};"]),
      ),
      Bytes::concat_all([
        r,
        b" = rt_ctor_p(ctx, ",
        tag_text(emitter, tag),
        b", (Word)(intptr_t)",
        arr.name,
        b", ",
        ascii_of_int(n),
        b");",
      ]),
    ),
  );
  {
    emitter: note_made(line(outdent(called), b"}"), r),
    value: { kind: KBoxed, expr: r, ty: TyOpen([]) },
  }
}

/// A constructor whose declaration lays its arguments out as `fields`, built of `words`, whose
/// values are `vals`: a raw argument's bits and a record held in place, which it takes, as a record
/// of `fields` holds them.
fn ctor_laid(
  emitter: Emitter,
  tag: Int,
  fields: List<FieldTy>,
  words: List<Bytes>,
  vals: List<CValue>,
) -> WithValue / {abort.raise} = {
  let l = laid_of(fields);
  let flags = record_flags(fields, l);
  let p = placed_values(emitter, fields, words, vals);
  built_now(
    p.emitter,
    [],
    cells_of(fields, p.words, p.placed, l, flags),
    4,
    tag_text(emitter, tag),
    l.width,
    flags,
    TyOpen([]),
    None,
  )
}

/// How constructor `tag` holds its arguments, where its declaration lays one out other than as its
/// word; `None` where it holds each as its word.
fn ctor_fields(emitter: Emitter, tag: Int) -> Option<List<FieldTy>> =
  match emitter.ctors.names.at(tag) { Some(name) -> emitter.ctors.laid.get(name), None -> None }

/// The words a constructor object of `tag` with `arity` arguments holds.
fn ctor_width(emitter: Emitter, tag: Int, arity: Int) -> Int =
  match ctor_fields(emitter, tag) { Some(fs) -> laid_of(fs).width, None -> arity }

/// Like `bind`, keeping the value's shape so a record's fields survive block boundaries.
fn bind_keeping(emitter: Emitter, k: Kind, ty: Ty, expr: Bytes) -> WithValue = {
  let o = bind(emitter, k, expr);
  { emitter: o.emitter, value: { kind: o.value.kind, expr: o.value.expr, ty: ty } }
}

/// A local name (`t12`, `p0`, a record parameter's field `p0_1`, `q1`) rather than an expression.
fn is_local(e: Bytes) -> Bool =
  e.len() > 1 && (e.at(0) == 116 || e.at(0) == 112 || e.at(0) == 113)
    && range(1, e.len()).fold(true, |acc: Bool, i: Int|
      acc
        && ((e.at(i) >= 48 && e.at(i) <= 57)
        || (e.at(0) == 112 && e.at(i) == 95 && i > 1 && i + 1 < e.len())))

/// The parameter whose word `value` is, followed through renames and moves.
fn param_of(emitter: Emitter, value: CValue, params: List<EmitParam>) -> Option<Int> = {
  let root = root_of(emitter, value.expr);
  if root.len() < 2 || root.at(0) != 112
      || !range(1, root.len()).fold(true, |ok: Bool, i: Int|
        ok && root.at(i) >= 48 && root.at(i) <= 57) { None } else {
    let i = digits(root.slice(1, root.len()));
    if i < params.len() { Some(i) } else { None }
  }
}

fn note_generics(emitter: Emitter, g: Generics) -> Emitter = { ..emitter, generics: g }

fn root_of(emitter: Emitter, local: Bytes) -> Bytes =
  emitter.alias.fold(local, |acc: Bytes, a: { local: Bytes, root: Bytes }|
    if a.local == local { a.root } else { acc })

fn note_alias(emitter: Emitter, local: Bytes, root: Bytes) -> Emitter =
  {
    out: emitter.out,
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: emitter.built,
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: emitter.released,
    reuse_widths: emitter.reuse_widths,
    alias: emitter.alias.push({ local: local, root: root }),
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred,
    deferred_locals: emitter.deferred_locals,
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
    slices: emitter.slices,
    sums: emitter.sums,
    leaves: emitter.leaves,
  }

/// Charge a slot's reads to the object the local holds, once per (object, slot).
fn charge(emitter: Emitter, slot: Int, local: Bytes) -> Emitter = {
  let r = root_of(emitter, local);
  let already = emitter.by_root.fold(false, |acc: Bool, e: { root: Bytes, n: Int }|
    acc || e.root == Bytes::concat_all([r, b"#", ascii_of_int(slot)]));
  if already { emitter } else {
    {
      out: emitter.out,
      temp_count: emitter.temp_count,
      unboxed: emitter.unboxed,
      indent: emitter.indent,
      reads: emitter.reads,
      shapes: emitter.shapes,
      built: emitter.built,
      module: emitter.module,
      base: emitter.base,
      count_locals: emitter.count_locals,
      here: emitter.here,
      imports: emitter.imports,
      consts: emitter.consts,
      ctors: emitter.ctors,
      lambda_bodies: emitter.lambda_bodies,
      lambdas: emitter.lambdas,
      owner: emitter.owner,
      builtins: emitter.builtins,
      called_builtins: emitter.called_builtins,
      fields: emitter.fields,
      released: emitter.released,
      reuse_widths: emitter.reuse_widths,
      alias: emitter.alias,
      by_root: emitter.by_root.push({
        root: Bytes::concat_all([r, b"#", ascii_of_int(slot)]),
        n: 0,
      }).push({ root: r, n: emitter.reads.count(|y: Int| y == slot) }),
      tail: emitter.tail,
      calls: emitter.calls,
      generics: emitter.generics,
      refused: emitter.refused,
      deferred: emitter.deferred,
      deferred_locals: emitter.deferred_locals,
      performs: emitter.performs,
      handles: emitter.handles,
      landing: emitter.landing,
      effects: emitter.effects,
      release: emitter.release,
      pinned: emitter.pinned,
      bound: emitter.bound,
      group: emitter.group,
      operands: emitter.operands,
      typed: emitter.typed,
      answer: emitter.answer,
      site_root: emitter.site_root,
      lent: emitter.lent,
      written: emitter.written,
      slices: emitter.slices,
      sums: emitter.sums,
      leaves: emitter.leaves,
    }
  }
}

fn reads_of_root(emitter: Emitter, local: Bytes) -> Int = {
  let r = root_of(emitter, local);
  emitter.by_root.fold(0, |acc: Int, e: { root: Bytes, n: Int }|
    if e.root == r { acc + e.n } else { acc })
}

fn built_of(emitter: Emitter, local: Bytes) -> Option<Built> =
  emitter.built.fold(None, |acc: Option<Built>, b: Built|
    if b.local == local { Some(b) } else { acc })

/// Only a runtime helper's result hands over its count, a builtin's among them; a compiled call's result is duplicated before it is handed on.
fn answers_owned(emitter: Emitter, expr: Bytes) -> Bool =
  expr.starts_with(b"rt_") || expr.starts_with(b"builtin_")
    || (emitter.release
    && ((expr.len() > 4 && expr.slice(0, 4) == b"ply_" && calls_with_ctx(expr))
    || (

      // A generic call names its root by a placeholder the unit settles: a compiled call all the same.
      expr.starts_with(b"@@g")
    && calls_with_ctx(expr))
    || (expr.len() > 13 && expr.slice(0, 13) == b"(ply_fits_imm")))

/// A compiled call `ply_<name>(ctx, ...)`, told from a load or immediate by what follows the first parenthesis.
fn calls_with_ctx(expr: Bytes) -> Bool = {
  let p = expr.scan_until(0, b"(", expr.len());
  p + 4 <= expr.len() && expr.slice(p, p + 4) == b"(ctx"
}

fn note_made(emitter: Emitter, name: Bytes) -> Emitter =
  { ..emitter, count_locals: emitter.count_locals.push({ name: name, indent: emitter.indent }) }

/// A refusal: the first reason is kept, and emission runs out on a placeholder value.
fn poison(emitter: Emitter, why: Bytes) -> Emitter =
  match emitter.refused {
    Some(_) -> emitter,
    None ->
      {
        out: emitter.out,
        temp_count: emitter.temp_count,
        unboxed: emitter.unboxed,
        indent: emitter.indent,
        reads: emitter.reads,
        shapes: emitter.shapes,
        built: emitter.built,
        module: emitter.module,
        base: emitter.base,
        count_locals: emitter.count_locals,
        here: emitter.here,
        imports: emitter.imports,
        consts: emitter.consts,
        ctors: emitter.ctors,
        lambda_bodies: emitter.lambda_bodies,
        lambdas: emitter.lambdas,
        owner: emitter.owner,
        builtins: emitter.builtins,
        called_builtins: emitter.called_builtins,
        fields: emitter.fields,
        released: emitter.released,
        reuse_widths: emitter.reuse_widths,
        alias: emitter.alias,
        by_root: emitter.by_root,
        tail: emitter.tail,
        calls: emitter.calls,
        generics: emitter.generics,
        refused: Some(why),
        deferred: emitter.deferred,
        deferred_locals: emitter.deferred_locals,
        performs: emitter.performs,
        handles: emitter.handles,
        landing: emitter.landing,
        effects: emitter.effects,
        release: emitter.release,
        pinned: emitter.pinned,
        bound: emitter.bound,
        group: emitter.group,
        operands: emitter.operands,
        typed: emitter.typed,
        answer: emitter.answer,
        site_root: emitter.site_root,
        lent: emitter.lent,
        written: emitter.written,
        slices: emitter.slices,
        sums: emitter.sums,
        leaves: emitter.leaves,
      },
  }

fn refused(emitter: Emitter, why: Bytes) -> WithValue =
  { emitter: poison(emitter, why), value: { kind: KBoxed, expr: b"0", ty: TyOpen([]) } }

/// The index a symbol takes in this body's code table, added on first use.
fn lambda_of(emitter: Emitter, sym: Bytes) -> { emitter: Emitter, i: Int } =
  match range(0, emitter.lambdas.len()).fold(None, |acc: Option<Int>, i: Int|
      match emitter.lambdas.at(i) {
        Some(x) -> if x == sym { Some(i) } else { acc },
        None -> acc,
      }) {
    Some(i) -> { emitter: emitter, i: i },
    None ->
      {
        emitter: {
          out: emitter.out,
          temp_count: emitter.temp_count,
          unboxed: emitter.unboxed,
          indent: emitter.indent,
          reads: emitter.reads,
          shapes: emitter.shapes,
          built: emitter.built,
          module: emitter.module,
          base: emitter.base,
          count_locals: emitter.count_locals,
          here: emitter.here,
          imports: emitter.imports,
          consts: emitter.consts,
          ctors: emitter.ctors,
          lambda_bodies: emitter.lambda_bodies,
          lambdas: emitter.lambdas.push(sym),
          owner: emitter.owner,
          builtins: emitter.builtins,
          called_builtins: emitter.called_builtins,
          fields: emitter.fields,
          released: emitter.released,
          reuse_widths: emitter.reuse_widths,
          alias: emitter.alias,
          by_root: emitter.by_root,
          tail: emitter.tail,
          calls: emitter.calls,
          generics: emitter.generics,
          refused: emitter.refused,
          deferred: emitter.deferred,
          deferred_locals: emitter.deferred_locals,
          performs: emitter.performs,
          handles: emitter.handles,
          landing: emitter.landing,
          effects: emitter.effects,
          release: emitter.release,
          pinned: emitter.pinned,
          bound: emitter.bound,
          group: emitter.group,
          operands: emitter.operands,
          typed: emitter.typed,
          answer: emitter.answer,
          site_root: emitter.site_root,
          lent: emitter.lent,
          written: emitter.written,
          slices: emitter.slices,
          sums: emitter.sums,
          leaves: emitter.leaves,
        },
        i: emitter.lambdas.len(),
      },
  }

fn note_call(emitter: Emitter, full: Bytes) -> Emitter =
  {
    out: emitter.out,
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: emitter.built,
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: emitter.released,
    reuse_widths: emitter.reuse_widths,
    alias: emitter.alias,
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: emitter.calls.push(full),
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred,
    deferred_locals: emitter.deferred_locals,
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
    slices: emitter.slices,
    sums: emitter.sums,
    leaves: emitter.leaves,
  }

fn spend_made(emitter: Emitter, name: Bytes) -> Emitter =
  {
    ..emitter,
    count_locals: emitter.count_locals.fold([], |acc: List<CountLocal>, m: CountLocal|
      if m.name == name { acc } else { acc.push(m) }),
  }

fn is_made(emitter: Emitter, name: Bytes) -> Bool =
  emitter.count_locals.fold(false, |acc: Bool, m: CountLocal| acc || m.name == name)

fn is_bound(emitter: Emitter, name: Bytes) -> Bool =
  emitter.bound.fold(false, |acc: Bool, b: Bytes| acc || b == name)

fn is_pinned(emitter: Emitter, name: Bytes) -> Bool =
  emitter.pinned.fold(false, |acc: Bool, p: Bytes| acc || p == name)

/// A count a consumer may take in place: held by a local no slot names and no loop pins.
fn spendable(emitter: Emitter, name: Bytes) -> Bool =
  is_made(emitter, name) && !is_bound(emitter, name) && !is_pinned(emitter, name)

/// Whether handing `name` on spends it, its count moved rather than duplicated.
fn spends(emitter: Emitter, name: Bytes) -> Bool = emitter.release && spendable(emitter, name)

/// Holders are tracked only under release; otherwise every count lives until the entry ends.
fn note_holder(emitter: Emitter, name: Bytes) -> Emitter =
  if emitter.release { note_made(emitter, name) } else { emitter }

fn note_bound(emitter: Emitter, name: Bytes) -> Emitter =
  { ..emitter, bound: emitter.bound.push(name) }

/// Pinned for a fused loop body: its text runs once per iteration, so a "last use" mark is about text, not execution.
fn pin_all(emitter: Emitter) -> Emitter =
  {
    ..emitter,
    pinned: emitter.count_locals.fold(emitter.pinned, |acc: List<Bytes>, m: CountLocal|
      acc.push(m.name)),
  }

fn with_pinned(emitter: Emitter, pinned: List<Bytes>) -> Emitter = { ..emitter, pinned: pinned }

fn with_made(emitter: Emitter, made: List<CountLocal>) -> Emitter =
  { ..emitter, count_locals: made }

/// A branch beside one already written, from that one's state `after`: a sum held back `before`
/// that the other branch made and took is still held back on this path.
fn beside(after: Emitter, before: Emitter) -> Emitter =
  {
    ..after,
    sums: before.sums.fold(after.sums, |acc: List<HeldSum>, h: HeldSum|
      if acc.fold(false, |seen: Bool, x: HeldSum| seen || x.name == h.name) { acc }
      else { acc.push(h) }),
  }

/// Held after either of two paths; released at scope end, where the path that spent it left it null.
fn union_made(a: List<CountLocal>, b: List<CountLocal>) -> List<CountLocal> =
  b.fold(a, |acc: List<CountLocal>, m: CountLocal|
    if acc.fold(false, |seen: Bool, x: CountLocal| seen || x.name == m.name) { acc }
    else { acc.push(m) })

/// Releases holders at depth `from` or deeper; a `break` passes the loop's depth.
fn release_at(emitter: Emitter, from: Int) -> Emitter = release_at_except(emitter, from, [])

/// As `release_at`, but the holders named in `skip` are left held. A self tail call restarts with
/// what the *pass* holds released, and a parameter a prologue converted -- an `Int` or `Bool`
/// unboxed at entry, so the body reads the converted local and never the raw word again -- is the
/// call's, not the pass's: releasing it here as well would free a boxed `Int` on the first restart
/// and again on the way out. Skipped, it is released once, by the epilogue or by whichever return
/// path the body takes.
fn release_at_except(emitter: Emitter, from: Int, skip: List<Bytes>) -> Emitter =
  if !emitter.release { emitter } else {
    let out: Emitter = emitter.count_locals.fold(emitter, |acc: Emitter, m: CountLocal|
      if m.indent >= from && !skip.contains(m.name) {
        line(acc, Bytes::concat_all([b"ply_dec(ctx, ", m.name, b");"]))
      } else { acc });
    {
      ..out,
      count_locals: emitter.count_locals.fold([], |acc: List<CountLocal>, m: CountLocal|
        if m.indent >= emitter.indent && !skip.contains(m.name) { acc } else { acc.push(m) }),
    }
  }

fn close(emitter: Emitter) -> Emitter = line(outdent(release_at(emitter, emitter.indent)), b"}")

/// At a slot's `Owned` read the local is moved to a fresh name and nulled, so the scope's release
/// skips it. A held-back record moves held back: the fresh name takes its cells and the values it was
/// built from, and is made only when its word is asked for. A held-back sum is its own local and is
/// left as it is: whatever takes it takes its arguments.
fn move_read(emitter: Emitter, own: Own, value: CValue) -> WithValue =
  if !emitter.release || own != Owned || !counted(value.kind) || !is_made(emitter, value.expr)
      || is_pinned(emitter, value.expr)
      || held_sum_of(emitter, value.expr) != None { { emitter: emitter, value: value } } else {
    match deferred_of(emitter, value.expr) {
      Some(d) -> {
        let f = fresh(emitter);
        let held = line(
          note_deferred(f.emitter, { ..d, name: f.name }),
          Bytes::concat_all([f.name, b" = ", value.expr, b"; ", value.expr, b" = 0;"]),
        );
        let kept = match built_of(held, value.expr) {
          Some(b) -> remember_built(held, f.name, b.names, b.vals),
          None -> held,
        };
        {
          emitter: spend_made(kept, value.expr),
          value: { kind: KBoxed, expr: f.name, ty: value.ty },
        }
      },
      None -> {
        let b = bind_keeping(emitter, value.kind, value.ty, value.expr);
        {
          emitter: note_made(
            line(spend_made(b.emitter, value.expr), Bytes::concat_all([value.expr, b" = 0;"])),
            b.value.expr,
          ),
          value: { kind: value.kind, expr: b.value.expr, ty: value.ty },
        }
      },
    }
  }

/// A local a slot will name must hold its own count: taken over from a temporary, or added.
fn ensure_owned(emitter: Emitter, value: CValue) -> Emitter =
  if !emitter.release || !counted(value.kind) || is_made(emitter, value.expr) { emitter }
  else { note_made(line(emitter, Bytes::concat_all([b"ply_inc(", value.expr, b");"])), value.expr) }

/// `target = value;` as a word the target holds a count of: a held-back record spent here is made
/// of its fields' counts, and its word moved.
fn assigned_word(emitter: Emitter, target: Bytes, value: CValue) -> Emitter = {
  let w = match value.kind {
    KBoxed ->
      { emitter: materialise(emitter, value.expr, spends(emitter, value.expr)), expr: value.expr },
    _ -> word_of(emitter, value),
  };
  assign_owned(line(w.emitter, Bytes::concat_all([target, b" = ", w.expr, b";"])), target, w.expr)
}

/// After `target = word;` the target holds a count: a temporary's moves, a shared name's is duplicated, an expression's is fresh.
fn assign_owned(emitter: Emitter, target: Bytes, c: Bytes) -> Emitter =
  if !emitter.release { emitter }
  else if spendable(emitter, c) { line(spend_made(emitter, c), Bytes::concat_all([c, b" = 0;"])) }
  else if is_local(c) { line(emitter, Bytes::concat_all([b"ply_inc(", target, b");"])) }
  else { emitter }

/// A statement's unused value, released where it is.
fn drop_value(emitter: Emitter, value: CValue) -> Emitter =
  if emitter.release && counted(value.kind) && spendable(emitter, value.expr) {
    line(
      spend_made(emitter, value.expr),
      Bytes::concat_all([b"ply_dec(ctx, ", value.expr, b"); ", value.expr, b" = 0;"]),
    )
  } else { emitter }

/// The returned word is owned by the caller; under release everything else the body holds is released first.
fn returned(emitter: Emitter, value: CValue) -> { emitter: Emitter, expr: Bytes } =
  if !emitter.release { word_of(emitter, value) } else {
    let r = owned(emitter, value);
    { emitter: release_at(r.emitter, 0), expr: r.value.expr }
  }

/// Aggregate elements are held as `Word` locals: a list is built from an array of words.
fn sets_bound(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  i: Int,
  acc: List<CValue>,
) -> Option<{ emitter: Emitter, vals: List<CValue> }> / {abort.raise} =
  if i >= codes.len() { Some({ emitter: emitter, vals: acc }) } else {
    match codes.at(i) {
      None -> None,
      Some(x) -> match expr(notail(emitter), x, params) {
        None -> None,
        Some(o) -> {
          let b = bind_keeping(o.emitter, o.value.kind, o.value.ty, o.value.expr);
          let s = secure(b.emitter, b.value);
          sets_bound(s.emitter, codes, params, i + 1, acc.push(s.value))
        },
      },
    }
  }

fn set_value(sets: List<CodeField>, vals: List<CValue>, name: Bytes) -> Option<CValue> =
  range(0, sets.len()).fold(None, |acc: Option<CValue>, i: Int|
    match sets.at(i) { Some(f) -> if f.name == name { vals.at(i) } else { acc }, None -> acc })

/// A `Word` local holding an expression, without taking a count for it.
fn bind_word_of(emitter: Emitter, e: Bytes) -> WithValue = {
  let f = fresh(emitter);
  {
    emitter: line(f.emitter, Bytes::concat_all([b"Word ", f.name, b" = ", e, b";"])),
    value: { kind: KBoxed, expr: f.name, ty: TyOpen([]) },
  }
}

fn bind_word(emitter: Emitter, value: CValue) -> WithValue = {
  let w = word_of(emitter, value);
  let f = fresh(w.emitter);
  {
    emitter: line(f.emitter, Bytes::concat_all([b"Word ", f.name, b" = ", w.expr, b";"])),
    value: { kind: KBoxed, expr: f.name, ty: TyOpen([]) },
  }
}

/// Duplicate a word before a callee takes it; scalars are immediates and hold no count. A sum held
/// as one word is made the object it stands for, which takes that word's count.
fn owned(emitter: Emitter, value: CValue) -> WithValue =
  match value.kind {
    KSum(spec) -> {
      let word = owned_word(emitter, { ..value, kind: KBoxed });
      let boxed = bind(
        word.emitter,
        KBoxed,
        Bytes::concat_all([sum_helper(spec, b"take"), b"(ctx, ", word.value.expr, b")"]),
      );
      owned_word(boxed.emitter, boxed.value)
    },
    _ -> owned_word(emitter, value),
  }

/// `value`, a sum as its object or as the word `spec` makes it, as that word with a count this
/// scope hands on.
fn sum_owned(emitter: Emitter, value: CValue, spec: SumSpec) -> WithValue =
  if value.kind == KSum(spec) {
    let w = owned_word(emitter, { ..value, kind: KBoxed });
    { emitter: w.emitter, value: { ..w.value, kind: KSum(spec) } }
  } else {
    // The object is taken, so one this scope holds alone hands its argument over without a copy.
    let w = owned(emitter, value);
    let opened = bind(
      w.emitter,
      KSum(spec),
      Bytes::concat_all([sum_helper(spec, b"open"), b"(ctx, ", w.value.expr, b")"]),
    );
    let o = owned_word(opened.emitter, { ..opened.value, kind: KBoxed });
    { emitter: o.emitter, value: { ..o.value, kind: KSum(spec) } }
  }

fn owned_word(emitter: Emitter, value: CValue) -> WithValue = {
  let spend = if emitter.release { spendable(emitter, value.expr) }
  else { is_made(emitter, value.expr) };
  let from = if spend { spend_made(emitter, value.expr) } else { emitter };
  let w = match value.kind {
    KBoxed -> bind_word_of(materialise(from, value.expr, spends(emitter, value.expr)), value.expr),
    _ -> bind_word(from, value),
  };
  match value.kind {
    KBoxed -> if spend {
      if emitter.release {
        { emitter: line(w.emitter, Bytes::concat_all([value.expr, b" = 0;"])), value: w.value }
      } else { w }
    } else if emitter.release && answers_owned(emitter, value.expr) { w } else {
      {
        emitter: line(w.emitter, Bytes::concat_all([b"ply_inc(", w.value.expr, b");"])),
        value: w.value,
      }
    },
    _ -> w,
  }
}

/// Stores the source place before a call that can fail, as bytes from the root's definition so the C does not change
/// when the definition moves; a synthesized node (empty span) has none.
fn site(emitter: Emitter, span: Span) -> Emitter =
  if span.end <= span.start { emitter } else {
    line(
      emitter,
      Bytes::concat_all([
        b"PLY_SITE(ctx, ",
        site_key(emitter),
        b", ",
        ascii_of_int(span.start - emitter.base),
        b", ",
        ascii_of_int(span.end - emitter.base),
        b");",
      ]),
    )
  }

/// The placeholder the driver resolves to this body's root: a group member's is numbered by its case.
fn root_key(emitter: Emitter) -> Bytes =
  match position_of(emitter.group, emitter.owner) {
    None -> b"r",
    Some(i) -> b"r".concat(ascii_of_int(i)),
  }

/// The root id the sites of this body are filed under: the placeholder the unit resolves to this
/// root's, or another root's id outright.
fn site_key(emitter: Emitter) -> Bytes =
  match emitter.site_root {
    Some(r) -> ascii_of_int(root_id(r)),
    None -> Bytes::concat_all([b"@@", root_key(emitter), b"@@"]),
  }

/// The id a body's failure sites name their root by: a digest of its name, so a body's C does not
/// depend on which other roots the unit holds. Non-negative, since the C stores it in an `int64_t`.
pub fn root_id(name: Bytes) -> Int = {
  let h = name.blake3();
  let low = match h.u32_at(0) { Some(v) -> v, None -> 0 };
  let high = match h.u32_at(4) { Some(v) -> v, None -> 0 };
  high << 31 | low >>> 1
}

fn position_of(xs: List<Bytes>, x: Bytes) -> Option<Int> =
  range(0, xs.len()).fold(None, |acc: Option<Int>, i: Int|
    match acc { Some(_) -> acc, None -> if xs.at(i) == Some(x) { Some(i) } else { None } })

fn check(emitter: Emitter) -> Emitter = line(emitter, b"if (ctx->failed) ".concat(leaving(emitter)))

/// The statement a body leaves by once the context has failed. Inside a `handle` body it jumps to the handle,
/// which pops its frame and answers a raise bound for it; a `return` there would leave both undone.
fn leaving(emitter: Emitter) -> Bytes =
  match emitter.landing {
    None -> failing_return(returned_kind(emitter.answer)),
    Some(l) -> Bytes::concat_all([b"goto ", l, b";"]),
  }

/// How a root whose answer is carried as `k` returns once the context has failed.
fn failing_return(k: Kind) -> Bytes = Bytes::concat_all([b"return ", zero_of(k), b";"])

fn as_int(value: CValue) -> Bytes =
  match value.kind {
    KInt -> value.expr,
    KSum(_) -> b"ply_maybe_unrouted",
    KBool -> value.expr,
    KNum(_) -> Bytes::concat_all([b"(int64_t)(", value.expr, b")"]),
    KFloat -> Bytes::concat_all([b"rt_unbox_int_p(ctx, ", as_word(value), b")"]),
    KDec -> Bytes::concat_all([b"rt_unbox_int_p(ctx, ", as_word(value), b")"]),
    KBoxed ->
      Bytes::concat_all([
        b"(ply_is_imm(",
        value.expr,
        b") ? ply_imm_value(",
        value.expr,
        b") : rt_unbox_int_p(ctx, ",
        value.expr,
        b"))",
      ]),
  }

/// Releases a record at its last use into a reuse token. Guards: the base is a bare variable marked `Owned`, and
/// exactly one name reads the object, counted over the whole body since reads are not emitted in marking order.
fn release_base(
  emitter: Emitter,
  base: Code,
  value: CValue,
  params: List<EmitParam>,
) -> Option<Emitter> = release_from(emitter, base, value, params, false)

/// `at_tail` skips the one-read guard: nothing is emitted after the node, so no later read can exist.
fn release_from(
  emitter: Emitter,
  base: Code,
  value: CValue,
  params: List<EmitParam>,
  at_tail: Bool,
) -> Option<Emitter> =
  if !counted(value.kind) { Some(emitter) } else if emitter.release {
    if base_owned(base) && spendable(emitter, value.expr) {
      Some(release_holder(spend_made(emitter, value.expr), value))
    } else { Some(emitter) }
  } else {
    match base.own {
      Owned -> match base.node {
        NVar(v) -> match v.slot {
          None -> Some(emitter),
          // At most once per object (not per name), and only when it is read once.
          Some(_) -> if (!at_tail && reads_of_root(emitter, value.expr) != 1)
              || emitter.released.fold(false, |acc: Bool, r: Bytes|
                acc || r == root_of(emitter, value.expr)) { Some(emitter) } else {
            let emitter = note_released(emitter, root_of(emitter, value.expr));
            // A held-back record dies unbuilt; guarded, since another path may have built it.
            match deferred_of(emitter, value.expr) {
              Some(d) -> Some(held_into_token(emitter, value.expr, d.n)),
              None -> match width_of(value.ty) {
                None ->
                  Some(line(emitter, Bytes::concat_all([b"ply_dec(ctx, ", value.expr, b");"]))),
                Some(n) -> {
                  let emitter = note_tok(emitter, n);
                  Some(
                    line(
                      emitter,
                      Bytes::concat_all([
                        b"if (tok",
                        ascii_of_int(n),
                        b" == 0) { tok",
                        ascii_of_int(n),
                        b" = ply_reset_flat(",
                        value.expr,
                        b"); if (!tok",
                        ascii_of_int(n),
                        b") tok",
                        ascii_of_int(n),
                        b" = rt_reset_p(ctx, ",
                        value.expr,
                        b"); } else { ply_dec(ctx, ",
                        value.expr,
                        b"); }",
                      ]),
                    ),
                  )
                },
              },
            }
          },
        },
        _ -> Some(emitter),
      },
      _ -> Some(emitter),
    }
  }

fn base_owned(base: Code) -> Bool =
  match base.own { Owned -> match base.node { NVar(v) -> v.slot != None, _ -> false }, _ -> false }

/// A field read the ownership pass marked `Owned` (nothing after it reads the field or the whole
/// record) takes the field out of a record this body holds and no loop reads again: the record,
/// when it is the field's only other holder, gives the field up rather than sharing it.
fn takes_field(emitter: Emitter, read: Code, base: Code, holder: Bytes) -> Bool =
  emitter.release && read.own == Owned && !base_owned(base) && is_made(emitter, holder)
    && !is_pinned(emitter, holder)

/// A subject whose fields a pattern bound, each binder holding a count of its own, is let go at
/// once where this body holds it alone, so a field the subject alone held is its binder's alone;
/// its cells are the token the next record or constructor of its width takes.
fn let_go(emitter: Emitter, subj: CValue, pattern: CodePattern) -> Emitter =
  if emitter.release && counted(subj.kind) && spendable(emitter, subj.expr) {
    let spent = spend_made(emitter, subj.expr);
    match pattern {
      PxCtor(c) -> if c.args.len() == 0 || is_sum(subj.kind) { release_holder(spent, subj) } else {
        match tag_of(emitter, c.name) {
          Some(tag) -> into_token(spent, subj.expr, ctor_width(emitter, tag, c.args.len())),
          None -> release_holder(spent, subj),
        }
      },
      _ -> release_holder(spent, subj),
    }
  } else { emitter }

/// Releases a holder's count, keeping its cells as a reuse token when the shape is known, and nulls the local.
fn release_holder(emitter: Emitter, value: CValue) -> Emitter =

  // A sum's word is no object's cells: zero, or tagged.
  if is_sum(value.kind) {
    line(emitter, Bytes::concat_all([b"ply_dec(ctx, ", value.expr, b"); ", value.expr, b" = 0;"]))
  } else {
    match deferred_of(emitter, value.expr) {
      Some(d) ->
        held_into_token(d.counts.fold(inners_let_go(emitter, d), let_go_count), value.expr, d.n),
      None -> match width_of(value.ty) {
        None ->
          line(
            emitter,
            Bytes::concat_all([b"ply_dec(ctx, ", value.expr, b"); ", value.expr, b" = 0;"]),
          ),
        Some(n) -> into_token(emitter, value.expr, n),
      },
    }
  }

/// The records `d` holds in place let go where it still holds them: one held back as its counts and
/// word.
fn inners_let_go(emitter: Emitter, d: Deferred) -> Emitter =
  d.inner.fold(emitter, |acc: Emitter, x: Inner|
    match deferred_of(acc, x.name) {
      Some(id) -> if !is_made(acc, x.name) { acc }
      else { held_into_token(id.counts.fold(acc, let_go_count), x.name, id.n) },
      None -> let_go_count(acc, x.name),
    })

/// The word of `name`, a record held back nothing asks for whole again, let go where it was made,
/// into the token of its width: its fields' locals hold counts of their own.
fn let_go_word(emitter: Emitter, name: Bytes) -> Emitter =
  if !emitter.release || is_pinned(emitter, name) { emitter } else {
    match deferred_of(emitter, name) {
      Some(d) -> held_into_token(emitter, name, d.n),
      None -> emitter,
    }
  }

/// The count the local `x` holds, a field of a record held back that dies here, let go.
fn let_go_count(emitter: Emitter, x: Bytes) -> Emitter =
  if !emitter.release || !is_made(emitter, x) || is_pinned(emitter, x) { emitter } else {
    line(spend_made(emitter, x), Bytes::concat_all([b"ply_dec(ctx, ", x, b"); ", x, b" = 0;"]))
  }

/// Releases the local `name`, a record or a constructor of `n` words, into the token of that width
/// where it is unique and the token is empty, and nulls it.
fn into_token(emitter: Emitter, name: Bytes, n: Int) -> Emitter =
  line(note_tok(emitter, n), token_text(name, n))

/// As `into_token`, for the local of a record held back, which holds a word only where it was made.
fn held_into_token(emitter: Emitter, name: Bytes, n: Int) -> Emitter =
  line(
    note_tok(emitter, n),
    Bytes::concat_all([b"if (", name, b") { ", token_text(name, n), b" }"]),
  )

fn token_text(name: Bytes, n: Int) -> Bytes = {
  let tok = b"tok".concat(ascii_of_int(n));
  Bytes::concat_all([
    b"if (",
    tok,
    b" == 0) { ",
    tok,
    b" = ply_reset_flat(",
    name,
    b"); if (!",
    tok,
    b") ",
    tok,
    b" = rt_reset_p(ctx, ",
    name,
    b"); } else { ply_dec(ctx, ",
    name,
    b"); } ",
    name,
    b" = 0;",
  ])
}

/// `v`, the local holding a counted field of `b`, a record held back, or a record it holds in place,
/// moved into a local of its own where the read is the `last` of the field or the record: nothing
/// makes the record's word after. The count it moves is the taker's to note.
fn moved_field(emitter: Emitter, last: Bool, b: CValue, v: CValue) -> Option<WithValue> =
  match deferred_of(emitter, b.expr) {
    None -> None,
    Some(d) -> if !last || !emitter.release || is_pinned(emitter, v.expr) { None }
    else if !d.counts.contains(v.expr)
        && !d.inner.fold(false, |seen: Bool, x: Inner| seen || x.name == v.expr) { None } else {
      match deferred_of(emitter, v.expr) {
        Some(id) -> {
          let f = fresh(emitter);
          let held = line(
            push_deferred(f.emitter, { ..id, name: f.name }),
            Bytes::concat_all([f.name, b" = ", v.expr, b"; ", v.expr, b" = 0;"]),
          );
          Some({
            emitter: spend_made(
              match built_of(held, v.expr) {
                Some(bb) -> remember_built(held, f.name, bb.names, bb.vals),
                None -> held,
              },
              v.expr,
            ),
            value: { kind: KBoxed, expr: f.name, ty: v.ty },
          })
        },
        None -> {
          let t = bind_word_of(emitter, v.expr);
          Some({
            emitter: spend_made(line(t.emitter, v.expr.concat(b" = 0;")), v.expr),
            value: { kind: v.kind, expr: t.value.expr, ty: v.ty },
          })
        },
      }
    },
  }

/// A forwarded field of a record about to be released is duplicated first, as `rt_field` does; a
/// record held back in place is copied.
fn secure_field(emitter: Emitter, base: Code, b: CValue, v: CValue) -> WithValue =
  if !emitter.release || !counted(v.kind) || !base_owned(base) || !spendable(emitter, b.expr) {
    { emitter: emitter, value: v }
  } else if deferred_of(emitter, v.expr) != None { held_copy_of(emitter, v) } else {
    let t = bind_word_of(emitter, v.expr);
    {
      emitter: note_made(
        line(t.emitter, Bytes::concat_all([b"ply_inc(", t.value.expr, b");"])),
        t.value.expr,
      ),
      value: { kind: v.kind, expr: t.value.expr, ty: v.ty },
    }
  }

fn from_table(emitter: Emitter, literal: Lit) -> WithValue = {
  let c = const_of(emitter, literal);
  let o = bind(
    c.emitter,
    KBoxed,
    Bytes::concat_all([b"rt_lit_p(ctx, @@c", ascii_of_int(c.i), b"@@)"]),
  );
  { emitter: check(o.emitter), value: o.value }
}

/// Every occurrence takes a new index: constants are not interned, unlike shapes.
fn const_of(emitter: Emitter, literal: Lit) -> { emitter: Emitter, i: Int } =
  {
    emitter: {
      out: emitter.out,
      temp_count: emitter.temp_count,
      unboxed: emitter.unboxed,
      indent: emitter.indent,
      reads: emitter.reads,
      shapes: emitter.shapes,
      built: emitter.built,
      module: emitter.module,
      base: emitter.base,
      count_locals: emitter.count_locals,
      here: emitter.here,
      imports: emitter.imports,
      consts: emitter.consts.push(literal),
      ctors: emitter.ctors,
      lambda_bodies: emitter.lambda_bodies,
      lambdas: emitter.lambdas,
      owner: emitter.owner,
      builtins: emitter.builtins,
      called_builtins: emitter.called_builtins,
      fields: emitter.fields,
      released: emitter.released,
      reuse_widths: emitter.reuse_widths,
      alias: emitter.alias,
      by_root: emitter.by_root,
      tail: emitter.tail,
      calls: emitter.calls,
      generics: emitter.generics,
      refused: emitter.refused,
      deferred: emitter.deferred,
      deferred_locals: emitter.deferred_locals,
      performs: emitter.performs,
      handles: emitter.handles,
      landing: emitter.landing,
      effects: emitter.effects,
      release: emitter.release,
      pinned: emitter.pinned,
      bound: emitter.bound,
      group: emitter.group,
      operands: emitter.operands,
      typed: emitter.typed,
      answer: emitter.answer,
      site_root: emitter.site_root,
      lent: emitter.lent,
      written: emitter.written,
      slices: emitter.slices,
      sums: emitter.sums,
      leaves: emitter.leaves,
    },
    i: emitter.consts.len(),
  }

/// A constructor's tag: this module's own, a qualified one, or one an import brought in bare.
fn tag_of(emitter: Emitter, name: Bytes) -> Option<Int> = {
  let part = qualified(name);
  let written = match part { Some(q) -> q.name, None -> name };
  let want = match part {
    Some(q) -> match module_import(emitter.imports, q.binder) {
      Some(imp) -> Bytes::concat_all([imp.module, b".", q.name]),
      None -> Bytes::concat_all([b"std.", q.binder, b".", q.name]),
    },
    None -> qualify(emitter.module, name),
  };
  match ctor_index(emitter.ctors.names, want, name) {
    Some(t) -> Some(t),
    // Only an import that bound this name can be where it came from. Two modules may declare a
    // constructor of the same name, so matching on the module alone would take the wrong one.
    None ->
      emitter.imports.fold(None, |acc: Option<Int>, imp: Imported|
        match acc {
          Some(_) -> acc,
          None -> if !imp.whole && imp.name == written {
            ctor_index(emitter.ctors.names, Bytes::concat_all([imp.module, b".", written]), b"")
          } else { None },
        }),
  }
}

/// Whether `t` is a `Result` whose error is always an object, which compiled code holds as one word.
fn tagged_result(t: Type) -> Bool =
  match t {
    TyCon(c) ->
      c.name == b"Result" && c.args.len() == 2
        && (match c.args.at(1) { Some(e) -> always_object(e), None -> false }),
    _ -> false,
  }

/// Whether every value of `t` is an object's word: a record, a function, a list, map, array or
/// columns, bytes or a string, a sum a module declares or a `Result`; never an immediate or zero.
fn always_object(t: Type) -> Bool =
  match t {
    TyRecord(_) -> true,
    TyNominal(_) -> true,
    TyFn(_) -> true,
    TyCon(c) ->
      c.name.index_of(b".") != None || c.name == b"Result" || c.name == b"Bytes"
        || c.name == b"String"
        || c.name == b"List"
        || c.name == b"Map"
        || c.name == b"Array"
        || c.name == b"Columns",
    _ -> false,
  }

fn is_option_type(t: Type) -> Bool =
  match t { TyCon(c) -> c.name == b"Option" && c.args.len() == 1, _ -> false }

/// Constructor `name` of a sum held as `kind` says, over its word `w`: the test that `w` is it, and
/// its argument's word.
fn sum_case(emitter: Emitter, kind: Kind, name: Bytes, w: Bytes) -> { test: Bytes, arg: Bytes } = {
  let bare = match tag_of(emitter, name) {
    Some(tag) -> match emitter.ctors.names.at(tag) { Some(n) -> n, None -> name },
    None -> name,
  };
  match kind {
    KSum(Tagged) -> if bare == b"Err" {
      {
        test: Bytes::concat_all([b"((", w, b" & 7) == 4)"]),
        arg: Bytes::concat_all([b"(", w, b" & ~(Word)7)"]),
      }
    } else { { test: Bytes::concat_all([b"((", w, b" & 7) != 4)"]), arg: w } },
    _ -> if bare == b"None" { { test: Bytes::concat_all([b"(", w, b" == 0)"]), arg: w } }
    else { { test: Bytes::concat_all([b"(", w, b" != 0)"]), arg: w } },
  }
}

/// `word`, a word this scope now holds, as a `Result` held as one word: itself for `Ok`, its
/// object's address tagged `100` for `Err`.
fn held_tagged(emitter: Emitter, word: Bytes, err: Bool) -> WithValue = {
  let b = bind(emitter, KSum(Tagged), if err { Bytes::concat_all([b"((Word)(", word, b") | 4)"]) }
  else { word });
  {
    emitter: if is_made(b.emitter, b.value.expr) { b.emitter }
    else { note_made(b.emitter, b.value.expr) },
    value: b.value,
  }
}

/// The name the constructor table gives the constructor written `name`.
fn ctor_bare(emitter: Emitter, name: Bytes) -> Bytes =
  match tag_of(emitter, name) {
    Some(tag) -> match emitter.ctors.names.at(tag) { Some(n) -> n, None -> name },
    None -> name,
  }

/// Whether `tag` is the prelude's constructor `name`, which the table names bare.
fn is_option(emitter: Emitter, tag: Int, name: Bytes) -> Bool =
  emitter.ctors.names.at(tag) == Some(name)

/// `payload`, a word this scope now holds, as an `Option` held as that word.
fn held_maybe(emitter: Emitter, payload: Bytes, ty: Ty) -> WithValue = {
  let b = bind(emitter, KSum(Zeroed), payload);
  {
    emitter: if is_made(b.emitter, b.value.expr) { b.emitter }
    else { note_made(b.emitter, b.value.expr) },
    value: { ..b.value, ty: ty },
  }
}

/// The runtime's helper for a builtin answering an element or `None`, which hands the element back
/// with a count or zero: an `Option` held as its payload's word, no object made.
fn lookup_helper(name: Bytes, n: Int) -> Option<Bytes> =
  if n != 2 { None }
  else if name == b"List::at" { Some(b"rt_list_lookup_p") }
  else if name == b"Array::at" { Some(b"rt_array_lookup_p") }
  else if name == b"Map::get" { Some(b"rt_map_lookup_p") }
  else { None }

/// `helper` called over `names`, which it takes; a failed call answers zero too, so failure is read
/// before zero is taken for `None`.
fn looked_up(emitter: Emitter, helper: Bytes, names: List<Bytes>) -> WithValue = {
  let called = fresh(emitter);
  let read = check(
    line(
      called.emitter,
      Bytes::concat_all([
        b"int64_t ",
        called.name,
        b" = ",
        helper,
        b"(ctx",
        names.fold(b"", |acc: Bytes, nm: Bytes| Bytes::concat_all([acc, b", ", nm])),
        b");",
      ]),
    ),
  );
  held_maybe(read, called.name, TyOpen([]))
}

/// A constructor's tag as the C writes it: by its name in the program's table, which a unit resolves
/// to the position its own table gives that name, so a body reads the same in every program and does
/// not move when a constructor is added elsewhere.
/// The witness of a type that states its own arithmetic, which the elaboration names by one of the
/// type's constructors: the runtime's first such witness past that constructor's tag, so the body
/// names the tag and takes what the type states with it.
fn stated_witness(emitter: Emitter, args: List<Code>) -> Option<WithValue> / {abort.raise} =
  match match args.at(0) {
      Some(c) -> match c.node {
        NLit(LStr(name)) -> ctor_index(emitter.ctors.names, name, b""),
        _ -> None,
      },
      None -> None,
    } {
    None -> Some(refused(emitter, b"a witness of a type no constructor names")),
    Some(tag) ->
      Some({
        emitter: emitter,
        value: {
          kind: KInt,
          expr: Bytes::concat_all([b"(13 + ", tag_text(emitter, tag), b")"]),
          ty: TyOpen([]),
        },
      }),
  }

fn tag_text(emitter: Emitter, tag: Int) -> Bytes / {abort.raise} =
  match emitter.ctors.names.at(tag) {
    Some(name) -> Bytes::concat_all([b"@@T", name, b"@@"]),
    None -> panic("a tag is a position in the program's constructor table"),
  }

fn ctor_index(ctors: List<Bytes>, want: Bytes, bare: Bytes) -> Option<Int> =
  range(0, ctors.len()).fold(None, |acc: Option<Int>, i: Int|
    match ctors.at(i) {
      Some(c) -> if c == want || (bare != b"" && c == bare) { Some(i) } else { acc },
      None -> acc,
    })

/// Whether `name` names a constructor: as written, `binder::Name`, or program-wide, as code the
/// emitter writes names one, `m.Name`.
fn is_ctor_name(name: Bytes) -> Bool / {abort.raise} =

  // A written root's name spells a type, whose last segment may be a type's name.
  name.index_of(b"#") == None
    && starts_upper(match qualified(name) {
      Some(q) -> q.name,
      None -> if name.index_of(b".") == None { name } else {
        let dot = range(0, name.len()).fold(0, |acc: Int, i: Int|
          if name.at(i) == 46 { i } else { acc });
        name.slice(dot + 1, name.len())
      },
    })

fn last_segment(path: List<Ident>) -> Bytes =
  match path.at(path.len() - 1) { Some(i) -> i.name, None -> b"" }

/// `binder::name` split at the first `::`, when there is one.
fn qualified(name: Bytes) -> Option<{ binder: Bytes, name: Bytes }> =
  range(0, name.len() - 1).fold(None, |acc: Option<{ binder: Bytes, name: Bytes }>, i: Int|
    match acc {
      Some(_) -> acc,
      None -> if name.at(i) == 58 && name.at(i + 1) == 58 {
        Some({ binder: name.slice(0, i), name: name.slice(i + 2, name.len()) })
      } else { None },
    })

fn from_import(xs: List<Imported>, name: Bytes) -> Option<Imported> =
  xs.fold(None, |acc: Option<Imported>, i: Imported|
    if !i.whole && i.name == name { Some(i) } else { acc })

fn module_import(xs: List<Imported>, binder: Bytes) -> Option<Imported> =
  xs.fold(None, |acc: Option<Imported>, i: Imported|
    if i.whole && i.name == binder { Some(i) } else { acc })

fn opened_to(emitter: Emitter, value: CValue, d: { kind: Option<Kind>, ty: Ty }) -> WithValue =
  match d.kind {
    Some(KInt) -> bind(emitter, KInt, as_int(value)),
    Some(KBool) -> bind(emitter, KBool, as_bool(value)),
    Some(KNum(w)) -> bind(emitter, KNum(w), as_num(value, w)),
    Some(KFloat) -> bind(emitter, KFloat, as_float(value)),
    Some(KDec) -> bind(emitter, KDec, as_dec(value)),
    // The callee's declared type makes a later field read a load rather than a search.
    _ -> { emitter: emitter, value: { kind: value.kind, expr: value.expr, ty: d.ty } },
  }

fn ret_of(here: List<Def>, name: Bytes) -> { kind: Option<Kind>, ty: Ty } =
  here.fold({ kind: None, ty: TyOpen([]) }, |acc: { kind: Option<Kind>, ty: Ty }, d: Def|
    if d.name == name { { kind: d.ret, ty: d.ret_ty } } else { acc })

/// A nullary pure definition (here or imported) is read from the constant table, whatever its kind: a call reruns its body at every read.
fn constant_of(
  emitter: Emitter,
  name: Bytes,
) -> Option<{ full: Bytes, ret: { kind: Option<Kind>, ty: Ty } }> =
  if emitter.here.fold(false, |acc: Bool, h: Def| acc || h.name == name) {
    if is_pure(emitter.here, name) {
      Some({ full: qualify(emitter.module, name), ret: ret_of(emitter.here, name) })
    } else { None }
  } else {
    let callee = match qualified(name) { Some(q) -> q.name, None -> name };
    match match qualified(name) {
        Some(q) -> module_import(emitter.imports, q.binder),
        None -> from_import(emitter.imports, name),
      } {
      None -> None,
      Some(imp) -> if is_pure(imp.defs, callee) {
        Some({ full: Bytes::concat_all([imp.module, b".", callee]), ret: ret_of(imp.defs, callee) })
      } else { None },
    }
  }

fn is_pure(here: List<Def>, name: Bytes) -> Bool =
  here.fold(false, |acc: Bool, d: Def| if d.name == name { d.pure } else { acc })

/// Whether `code` names a definition of two parameters, which a fold calls in its loop.
fn names_a_step(emitter: Emitter, code: Code) -> Bool / {abort.raise} =
  match code.node {
    NVar(fv) ->
      fv.slot == None
        && (match def_of(emitter, fv.name) { Some(d) -> d.arity == 2, None -> false }),
    _ -> false,
  }

fn def_of(
  emitter: Emitter,
  name: Bytes,
) -> Option<{ full: Bytes, expr: Bytes, arity: Int, scheme: Option<Scheme>, def: Def }> / {abort.raise} =
  def_in(emitter.module, emitter.here, emitter.imports, name)

/// The definition `name` names in `module`, which defines `here` and imports `imports`.
fn def_in(
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  name: Bytes,
) -> Option<{ full: Bytes, expr: Bytes, arity: Int, scheme: Option<Scheme>, def: Def }> / {abort.raise} =
  if is_ctor_name(name) { None } else {
    // The module's own comes first: a function of a type is named `T::name`, which reads as
    // qualified and names no import.
    let target = if here.fold(false, |acc: Bool, h: Def| acc || h.name == name) {
      Some({ module: module, name: name, defs: here })
    } else {
      match qualified(name) {
        Some(q) -> match module_import(imports, q.binder) {
          Some(imp) -> Some({ module: imp.module, name: q.name, defs: imp.defs }),
          None -> None,
        },
        None -> {
          match from_import(imports, name) {
            Some(imp) -> Some({ module: imp.module, name: name, defs: imp.defs }),
            None -> None,
          }
        },
      }
    };
    match target {
      None -> None,
      Some(t) -> match t.defs.fold(None, |acc: Option<Def>, d: Def|
          if d.name == t.name { Some(d) } else { acc }) {
        Some(d) -> {
          let full = Bytes::concat_all([t.module, b".", t.name]);
          Some({ full: full, expr: symbol_of(full), arity: d.arity, scheme: d.scheme, def: d })
        },
        None -> None,
      },
    }
  }

/// Under release `Bytes::position` is a loop in the body: the runtime's would suspend, which a native frame cannot resume.
fn position_call(
  emitter: Emitter,
  name: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  if !emitter.release || name != b"Bytes::position" || args.len() != 3 { None } else {
    match tag_of(emitter, b"Some") {
      None -> None,
      Some(some) -> match tag_of(emitter, b"None") {
        None -> None,
        Some(none) -> match args.at(0) {
          None -> None,
          Some(b0) -> match args.at(1) {
            None -> None,
            Some(f0) -> match args.at(2) {
              None -> None,
              Some(p0) -> match expr(notail(emitter), b0, params) {
                None -> None,
                Some(bv) -> {
                  let bo = owned(bv.emitter, bv.value);
                  match expr(notail(bo.emitter), f0, params) {
                    None -> None,
                    Some(fv) -> {
                      let from = bind(fv.emitter, KInt, as_int(fv.value));
                      match expr(notail(from.emitter), p0, params) {
                        None -> None,
                        Some(pv) -> {
                          let po = owned(pv.emitter, pv.value);
                          // Bad input goes to the runtime's own call, which raises before it would suspend.
                          let guard = line(
                            site(po.emitter, span),
                            Bytes::concat_all([
                              b"if (ply_is_imm(",
                              bo.value.expr,
                              b") || ply_obj(",
                              bo.value.expr,
                              b")->kind != 10 || (uint64_t)",
                              from.value.expr,
                              b" > (uint64_t)ply_obj(",
                              bo.value.expr,
                              b")->len) { ",
                              builtin_call_over(b"Bytes::position", [
                                bo.value.expr,
                                as_word(from.value),
                                po.value.expr,
                              ]),
                              b"; ",
                              leaving(po.emitter),
                              b" }",
                            ]),
                          );
                          let ans = fresh(guard);
                          let declared = line(
                            ans.emitter,
                            Bytes::concat_all([
                              b"Word ",
                              ans.name,
                              b" = rt_nullary_p(ctx, ",
                              tag_text(emitter, none),
                              b");",
                            ]),
                          );
                          let i = bind(declared, KInt, from.value.expr);
                          let head = indent(
                            line(
                              i.emitter,
                              Bytes::concat_all([
                                b"for (; ",
                                i.value.expr,
                                b" < (int64_t)ply_obj(",
                                bo.value.expr,
                                b")->len; ",
                                i.value.expr,
                                b" += 1) {",
                              ]),
                            ),
                          );
                          let arg = fresh(head);
                          let called = fresh(
                            line(
                              arg.emitter,
                              Bytes::concat_all([
                                b"Word ",
                                arg.name,
                                b"[] = { ply_imm((int64_t)(ply_bytes(",
                                bo.value.expr,
                                b"))[",
                                i.value.expr,
                                b"]) }; ply_inc(",
                                po.value.expr,
                                b");",
                              ]),
                            ),
                          );
                          let asked = line(
                            site(called.emitter, span),
                            Bytes::concat_all([
                              b"Word ",
                              called.name,
                              b" = rt_call_p(ctx, ",
                              po.value.expr,
                              b", (Word)(intptr_t)",
                              arg.name,
                              b", 1);",
                            ]),
                          );
                          let hit = line(
                            indent(
                              line(
                                check(asked),
                                Bytes::concat_all([b"if (", bool_of_word(called.name), b") {"]),
                              ),
                            ),
                            Bytes::concat_all([
                              b"Word w[] = { ply_imm(",
                              i.value.expr,
                              b") }; ",
                              ans.name,
                              b" = rt_ctor_p(ctx, ",
                              tag_text(emitter, some),
                              b", (Word)(intptr_t)w, 1);",
                            ]),
                          );
                          let stopped = line(outdent(line(check(hit), b"break;")), b"}");
                          let done = line(outdent(stopped), b"}");
                          let freed = line(
                            line(done, Bytes::concat_all([b"ply_dec(ctx, ", po.value.expr, b");"])),
                            Bytes::concat_all([b"ply_dec(ctx, ", bo.value.expr, b");"]),
                          );
                          Some({
                            emitter: note_holder(freed, ans.name),
                            value: { kind: KBoxed, expr: ans.name, ty: TyOpen([]) },
                          })
                        },
                      }
                    },
                  }
                },
              },
            },
          },
        },
      },
    }
  }

/// `iterate` over a one-parameter lambda is fused into the body; anything else calls the runtime's helper.
fn iterate_call(
  emitter: Emitter,
  name: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  if name != b"iterate" || args.len() != 3 { None } else {
    match args.at(2) {
      None -> None,
      Some(f) -> match f.node {
        NLambda(l) -> if l.params == 1 { fused_iterate(emitter, args, l, params, span) }
        else { helper_call(emitter, b"rt_iterate_p", args, params) },
        _ -> helper_call(emitter, b"rt_iterate_p", args, params),
      },
    }
  }

/// A step answering `Stop`/`Continue` directly in every arm becomes the loop's assignments; any other is called and its tag tested.
fn fused_iterate(
  emitter: Emitter,
  args: List<Code>,
  l: Lambda,
  params: List<EmitParam>,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  match tag_of(emitter, b"Stop") {
    None -> Some(refused(emitter, b"`iterate` with no `Stop` and `Continue` in the program")),
    Some(stop) -> match tag_of(emitter, b"Continue") {
      None -> Some(refused(emitter, b"`iterate` with no `Stop` and `Continue` in the program")),
      Some(go) -> match args.at(0) {
        None -> None,
        Some(seed) -> match args.at(1) {
          None -> None,
          Some(budget) -> match expr(notail(emitter), seed, params) {
            None -> None,
            Some(sv) -> {
              let ty = ty_at(lambda_param_tys(emitter, l), 0);
              // A step that answers `Stop` or `Continue` in every arm assigns a record state's
              // fields back itself.
              let fs = if fusable_step(emitter, l.body) {
                match state_carrier(emitter, l) { Fields(x) -> x, _ -> [] }
              } else { [] };
              let ls = record_locals(sv.emitter, fs, empty_inits(fs));
              let state = into_of(fs, ls);
              let s1 = assigned_into(ls.emitter, sv.value, state);
              match expr(notail(s1), budget, params) {
                None -> None,
                Some(bv) -> {
                  let bud = as_int(bv.value);
                  let left = fresh(bv.emitter);
                  let s2 = line(
                    left.emitter,
                    Bytes::concat_all([b"int64_t ", left.name, b" = ", bud, b";"]),
                  );
                  let answer = fresh(s2);
                  let s3 = line(
                    answer.emitter,
                    Bytes::concat_all([b"Word ", answer.name, b" = 0;"]),
                  );
                  let opened = indent(line(s3, b"for (;;) {"));
                  let guarded = line(
                    line(
                      site(opened, span),
                      Bytes::concat_all([
                        b"if (",
                        left.name,
                        b" <= 0) { rt_iterate_bad_p(ctx, (",
                        bud,
                        b") < 1 ? 0 : 1, ",
                        bud,
                        b"); ",
                        leaving(opened),
                        b" }",
                      ]),
                    ),
                    Bytes::concat_all([left.name, b" -= 1;"]),
                  );
                  match capture_window(guarded, l.captures, params) {
                    None -> Some(refused(emitter, b"a capture this port has not bound")),
                    Some(window) -> {
                      // Everything held outside the loop is pinned: the body reads it once per iteration.
                      let held = taken_over(
                        with_reads(rescope(pin_all(guarded), window), slots_read(l.body)),
                        state,
                        KBoxed,
                        known_or(sv.value.ty, ty),
                      );
                      let inner = remember(held.emitter, 0, held.value);
                      let body = if fusable_step(inner, l.body) {
                        emit_step(inner, l.body, state, answer.name, params, inner.indent)
                      } else {
                        match expr(inner, l.body, params) {
                          None -> None,
                          Some(r) -> {
                            let rw = word_of(r.emitter, r.value);
                            let sa = bind(rw.emitter, KBoxed, rw.expr);
                            let k = fresh(sa.emitter);
                            let t1 = line(
                              k.emitter,
                              Bytes::concat_all([
                                b"uint32_t ",
                                k.name,
                                b" = (!ply_is_imm(",
                                sa.value.expr,
                                b") && ",
                                sa.value.expr,
                                b" != 0 && ply_obj(",
                                sa.value.expr,
                                b")->kind == 4 && ply_obj(",
                                sa.value.expr,
                                b")->len == 1) ? ply_obj(",
                                sa.value.expr,
                                b")->layout : 0xFFFFFFFFu;",
                              ]),
                            );
                            let t2 = line(
                              indent(
                                line(
                                  t1,
                                  Bytes::concat_all([
                                    b"if (",
                                    k.name,
                                    b" == ",
                                    tag_text(emitter, stop),
                                    b") {",
                                  ]),
                                ),
                              ),
                              Bytes::concat_all([
                                answer.name,
                                b" = ply_words(",
                                sa.value.expr,
                                b")[0];",
                              ]),
                            );
                            let t3 = line(
                              release_at(
                                line(t2, Bytes::concat_all([b"ply_inc(", answer.name, b");"])),
                                inner.indent,
                              ),
                              b"break;",
                            );
                            let t4 = line(
                              indent(
                                line(
                                  outdent(t3),
                                  Bytes::concat_all([
                                    b"} else if (",
                                    k.name,
                                    b" == ",
                                    tag_text(emitter, go),
                                    b") {",
                                  ]),
                                ),
                              ),
                              Bytes::concat_all([
                                state.word,
                                b" = ply_words(",
                                sa.value.expr,
                                b")[0];",
                              ]),
                            );
                            let t5 = line(t4, Bytes::concat_all([b"ply_inc(", state.word, b");"]));
                            let t6 = line(
                              site(indent(line(outdent(t5), b"} else {")), span),
                              Bytes::concat_all([
                                b"rt_iterate_bad_p(ctx, 2, ",
                                sa.value.expr,
                                b"); ",
                                leaving(t5),
                              ]),
                            );
                            Some(line(outdent(t6), b"}"))
                          },
                        }
                      };
                      match body {
                        None -> None,
                        Some(done) ->
                          Some({
                            emitter: note_holder(
                              with_pinned(
                                close(with_reads(rescope(done, guarded.unboxed), emitter.reads)),
                                emitter.pinned,
                              ),
                              answer.name,
                            ),
                            value: { kind: KBoxed, expr: answer.name, ty: TyOpen([]) },
                          }),
                      }
                    },
                  }
                },
              }
            },
          },
        },
      },
    },
  }

/// A call of the two-parameter definition `f` names, with the accumulator and the element in
/// slots 0 and 1, each read at its last use.
fn named_step(emitter: Emitter, f: Code) -> Option<WithValue> / {abort.raise} =
  match f.node {
    NVar(fv) -> match def_of(emitter, fv.name) {
      None -> None,
      Some(d) -> match conv_of(emitter, 0) {
        None -> None,
        Some(acc) -> match conv_of(emitter, 1) {
          None -> None,
          Some(x) -> {
            let target = call_target(emitter, d.full, Some(d.def), f.span, []);
            let a0 = move_read(target.emitter, Owned, acc);
            let a1 = move_read(a0.emitter, Owned, x);
            let c1 = carried_arg(a1.emitter, a0.value, carrier_at(target.carriers.params, 0));
            let c2 = carried_arg(c1.emitter, a1.value, carrier_at(target.carriers.params, 1));
            Some(called(c2.emitter, target, f.span, c1.names.concat(c2.names), 2, false))
          },
        },
      },
    },
    _ -> None,
  }

/// The lambdas `params` are bound to.
fn lent_of(params: List<EmitParam>) -> List<BoundLambda> =
  params.fold([], |acc: List<BoundLambda>, p: EmitParam|
    match p.lambda { Some(bl) -> acc.push(bl), None -> acc })

/// The lambda this root was handed that is `owner`'s `nth`.
fn lent_lambda(emitter: Emitter, owner: Bytes, nth: Int) -> Option<BoundLambda> =
  emitter.lent.fold(None, |acc: Option<BoundLambda>, bl: BoundLambda|
    match acc {
      Some(_) -> acc,
      None -> if bl.owner == owner && bl.nth == nth { Some(bl) } else { None },
    })

/// Whose names a lambda run in place is read under: those of the frame it is run in, where that
/// frame's owner wrote it, or those of the root that lent it.
type LambdaFrame = | Own | Lent(BoundLambda)

/// The owner of the code being emitted: the root's, or inside a lent lambda's frame, the lender's.
fn frame_owner(emitter: Emitter) -> Bytes =
  match emitter.site_root { Some(o) -> o, None -> emitter.owner }

/// The frame `owner`'s `nth` lambda runs in here; none where it is another root's and this root
/// was not handed it.
fn lambda_frame(emitter: Emitter, owner: Bytes, nth: Int) -> Option<LambdaFrame> =
  if owner == frame_owner(emitter) { Some(Own) }
  else { match lent_lambda(emitter, owner, nth) { Some(bl) -> Some(Lent(bl)), None -> None } }

/// `emitter` reading names, types and sites as the lambda's owner does.
fn framed(emitter: Emitter, frame: LambdaFrame) -> Emitter =
  match frame {
    Own -> emitter,
    Lent(bl) ->
      {
        ..emitter,
        module: bl.module,
        here: bl.here,
        imports: bl.imports,
        effects: bl.effects,
        typed: bl.typed,
        operands: bl.operands,
        base: bl.base,
        site_root: Some(bl.owner),
      },
  }

/// The frame a lambda run in place is emitted in: at its owner's names, types and sites, counting
/// the call it replaces, its parameters the call's argument values `vals`, each held until the body
/// is done, and its captures borrowed from the function value `func`, which keeps their counts.
fn inlined_frame(
  emitter: Emitter,
  frame: LambdaFrame,
  func: CValue,
  vals: List<CValue>,
  lambda: Lambda,
) -> Emitter = {
  let opened = match frame {
    Lent(bl) -> if bl.named { indent(emitter) }
    else { line(indent(emitter), tick_line(leaving(emitter))) },
    Own -> line(indent(emitter), tick_line(leaving(emitter))),
  };
  let held = vals.fold(
    { emitter: opened, vals: [] },
    |acc: { emitter: Emitter, vals: List<CValue> }, v: CValue|
      if counted(v.kind) {
        let o = owned_word(acc.emitter, { ..v, kind: KBoxed });
        {
          emitter: note_holder(o.emitter, o.value.expr),
          vals: acc.vals.push({ ..o.value, kind: v.kind }),
        }
      } else { { emitter: acc.emitter, vals: acc.vals.push(v) } },
  );
  let caps = range(0, lambda.captures.len()).fold(
    { emitter: held.emitter, window: [] },
    |acc: { emitter: Emitter, window: List<Unboxed> }, ci: Int|
      match lambda.captures.at(ci) {
        None -> acc,
        Some(c) -> {
          let b = bind(
            acc.emitter,
            KBoxed,
            Bytes::concat_all([b"ply_words(", func.expr, b")[", ascii_of_int(ci + 2), b"]"]),
          );
          {
            emitter: b.emitter,
            window: acc.window.push({
              slot: c.dst,
              kind: KBoxed,
              expr: b.value.expr,
              ty: TyOpen([]),
            }),
          }
        },
      },
  );
  let swapped = framed(caps.emitter, frame);
  let opened_frame = caps.window.fold(
    with_reads(rescope(swapped, caps.window), slots_read(lambda.body)),
    |acc: Emitter, w: Unboxed| note_bound(charge(acc, w.slot, w.expr), w.expr),
  );
  let tys = lambda_param_tys(swapped, lambda);
  range(0, held.vals.len()).fold(opened_frame, |acc: Emitter, k: Int|
    match held.vals.at(k) {
      Some(v) -> remember(acc, k, { ..v, ty: known_or(v.ty, ty_at(tys, k)) }),
      None -> acc,
    })
}

/// What a lambda run in place answered, made the caller's of `emitter` before what the frame
/// opened at depth `from` held is released.
fn inlined_answer(emitter: Emitter, from: Int, r: WithValue) -> WithValue = {
  let answered = if counted(r.value.kind) {
    let w = owned_word(r.emitter, { ..r.value, kind: KBoxed });
    { emitter: w.emitter, value: { ..w.value, kind: r.value.kind } }
  } else { bind(r.emitter, r.value.kind, r.value.expr) };
  let restored = {
    ..answered.emitter,
    module: emitter.module,
    here: emitter.here,
    imports: emitter.imports,
    effects: emitter.effects,
    typed: emitter.typed,
    operands: emitter.operands,
    base: emitter.base,
    site_root: emitter.site_root,
  };
  let released = outdent(
    release_at(with_reads(rescope(restored, emitter.unboxed), emitter.reads), from),
  );
  {
    emitter: if counted(answered.value.kind) { note_holder(released, answered.value.expr) }
    else { released },
    value: { ..answered.value, ty: TyOpen([]) },
  }
}

/// A slot known to hold `owner`'s `nth` lambda, whose code is `code`.
type KnownSlot = { slot: Int, owner: Bytes, nth: Int, code: Lambda }

/// `c`, code of the root `owner`, with each read of a slot `bound` names written as the lambda it
/// is known to be, through lambdas and barriers that capture the slot. A slot a `let` binds to a
/// lambda, or to such a read, is known for the rest of its block. `own` is the root's lambdas
/// before any is rewritten, which is what numbers them: the pass adds and removes none.
fn known_values(c: Code, bound: List<KnownSlot>, owner: Bytes, own: List<Lambda>) -> Code = {
  let go = |x: Code| known_values(x, bound, owner, own);
  let known = |slot: Int|
    bound.fold(None, |found: Option<KnownSlot>, k: KnownSlot|
      if k.slot == slot { Some(k) } else { found });
  let inside = |caps: List<Capture>|
    caps.fold([], |acc: List<KnownSlot>, cap: Capture|
      match known(cap.src) { Some(k) -> acc.push({ ..k, slot: cap.dst }), None -> acc });
  let maybe = |x: Option<Code>| match x { Some(y) -> Some(go(y)), None -> None };
  let node = match c.node {
    NVar(v) -> match match v.slot { Some(sl) -> known(sl), None -> None } {
      Some(k) -> NKnown({ name: v.name, slot: k.slot, lambda: k.code, owner: k.owner, nth: k.nth }),
      None -> c.node,
    },
    NApp(a) -> NApp({ func: go(a.func), args: a.args.map(go) }),
    NUnary(u) -> NUnary({ ..u, operand: go(u.operand) }),
    NBinary(b) -> NBinary({ ..b, lhs: go(b.lhs), rhs: go(b.rhs) }),
    NIf(i) ->
      NIf({ cond: go(i.cond), then_branch: go(i.then_branch), else_branch: go(i.else_branch) }),
    NBlock(b) -> {
      let walked = b.stmts.fold(
        { bound: bound, stmts: [] },
        |acc: { bound: List<KnownSlot>, stmts: List<CodeStmt> }, stmt: CodeStmt|
          match stmt {
            CLet(l) -> {
              let value = known_values(l.value, acc.bound, owner, own);
              let rest = acc.bound.filter(|k: KnownSlot| k.slot != l.slot);
              {
                bound: match value.node {
                  // A lambda holding a `handle` stays a closure: its handled operations are its own.
                  NLambda(lam) -> match match l.value.node {
                      NLambda(written) -> position_in(own, written),
                      _ -> None,
                    } {
                    Some(nth) -> if has_handle(lam.body) { rest }
                    else { rest.push({ slot: l.slot, owner: owner, nth: nth, code: lam }) },
                    None -> rest,
                  },
                  NKnown(k) ->
                    rest.push({ slot: l.slot, owner: k.owner, nth: k.nth, code: k.lambda }),
                  _ -> rest,
                },
                stmts: acc.stmts.push(CLet({ ..l, value: value })),
              }
            },
            CLetPat(l) ->
              {
                bound: acc.bound,
                stmts: acc.stmts.push(
                  CLetPat({ ..l, value: known_values(l.value, acc.bound, owner, own) }),
                ),
              },
            CDo(d) ->
              {
                bound: acc.bound,
                stmts: acc.stmts.push(CDo({ code: known_values(d.code, acc.bound, owner, own) })),
              },
          },
      );
      NBlock({
        stmts: walked.stmts,
        tail: match b.tail {
          Some(t) -> Some(known_values(t, walked.bound, owner, own)),
          None -> None,
        },
      })
    },
    NList(l) -> NList({ items: l.items.map(go) }),
    NRecord(r) -> NRecord({ fields: r.fields.map(|f: CodeField| { ..f, value: go(f.value) }) }),
    NMatch(m) ->
      NMatch({
        scrutinee: go(m.scrutinee),
        arms: m.arms.map(|a: CodeArm| { ..a, guard: maybe(a.guard), body: go(a.body) }),
      }),
    NPerform(x) -> NPerform({ ..x, label: maybe(x.label), args: x.args.map(go) }),
    NLambda(l) -> NLambda({ ..l, body: known_values(l.body, inside(l.captures), owner, own) }),
    NSimulate(x) -> NSimulate({ ..x, body: known_values(x.body, inside(x.captures), owner, own) }),
    NParallel(pr) -> NParallel({ ..pr, branches: pr.branches.map(go) }),
    NField(f) -> NField({ ..f, base: go(f.base) }),
    NUpdate(u) ->
      NUpdate({
        ..u,
        base: go(u.base),
        sets: u.sets.map(|f: CodeField| { ..f, value: go(f.value) }),
      }),
    other -> other,
  };
  { ..c, node: node }
}

/// A root's lowered `body` as it is emitted: each parameter the root was handed a lambda for, and
/// each of its own `let`-bound lambdas, known wherever it is read.
fn known_body(full: Bytes, params: List<EmitParam>, body: Code) -> Code =
  known_values(
    body,
    range(0, params.len()).fold([], |acc: List<KnownSlot>, i: Int|
      match match params.at(i) { Some(p) -> p.lambda, None -> None } {
        // A lambda holding a `handle` stays a closure: its handled operations are its owner's.
        Some(bl) -> if has_handle(bl.code.body) { acc }
        else { acc.push({ slot: i, owner: bl.owner, nth: bl.nth, code: bl.code }) },
        None -> acc,
      }),
    full,
    lambdas_of(body),
  )

/// What each capture of a lambda whose body is emitted in place names: the enclosing slot's value,
/// or a boxed parameter's word; `None` where a capture is neither.
fn capture_window(
  emitter: Emitter,
  captures: List<Capture>,
  params: List<EmitParam>,
) -> Option<List<Unboxed>> =
  captures.fold(Some([]), |acc: Option<List<Unboxed>>, capture: Capture|
    match acc {
      None -> None,
      Some(w) -> match conv_of(emitter, capture.src) {
        Some(v) -> Some(w.push({ slot: capture.dst, kind: v.kind, expr: v.expr, ty: v.ty })),
        None -> match params.at(capture.src) {
          Some(p) -> if counted(p.kind) {
            Some(
              w.push({
                slot: capture.dst,
                kind: p.kind,
                expr: b"p".concat(ascii_of_int(capture.src)),
                ty: p.ty,
              }),
            )
          } else { None },
          None -> None,
        },
      },
    })

fn fusable_step(emitter: Emitter, code: Code) -> Bool / {abort.raise} =
  match code.node {
    NApp(a) ->
      a.args.len() == 1
        && (match a.func.node {
          NVar(fv) -> match fv.slot {
            Some(_) -> false,
            None ->
              is_ctor_name(fv.name)
                && (match tag_of(emitter, fv.name) {
                  Some(t) ->
                    Some(t) == tag_of(emitter, b"Stop") || Some(t) == tag_of(emitter, b"Continue"),
                  None -> false,
                }),
          },
          _ -> false,
        }),
    NIf(i) -> fusable_step(emitter, i.then_branch) && fusable_step(emitter, i.else_branch),
    NBlock(b) -> match b.tail { Some(t) -> fusable_step(emitter, t), None -> false },
    NMatch(m) -> m.arms.fold(true, |acc: Bool, a: CodeArm| acc && fusable_step(emitter, a.body)),
    _ -> false,
  }

/// `Stop(x)` sets the answer and breaks; `Continue(x)` sets the state.
fn emit_step(
  emitter: Emitter,
  code: Code,
  state: Into,
  answer: Bytes,
  params: List<EmitParam>,
  depth: Int,
) -> Option<Emitter> / {abort.raise} =
  match code.node {
    NApp(a) -> match a.args.at(0) {
      None -> None,
      Some(x) -> match expr(notail(emitter), x, params) {
        None -> None,
        Some(v) -> {
          let which = match a.func.node { NVar(fv) -> tag_of(emitter, fv.name), _ -> None };
          if which != None && which == tag_of(emitter, b"Stop") {
            // The loop's holders are released before the `break` leaves their block.
            Some(line(release_at(assigned_word(v.emitter, answer, v.value), depth), b"break;"))
          } else { Some(assigned_into(v.emitter, v.value, state)) }
        },
      },
    },
    NIf(i) -> match expr(notail(emitter), i.cond, params) {
      None -> None,
      Some(cv) -> {
        let opened = indent(
          line(cv.emitter, Bytes::concat_all([b"if (", as_bool(cv.value), b") {"])),
        );
        match emit_step(opened, i.then_branch, state, answer, params, depth) {
          None -> None,
          Some(t) -> {
            let t2 = release_at(t, t.indent);
            let els = with_made(
              beside(indent(line(outdent(t2), b"} else {")), opened),
              opened.count_locals,
            );
            match emit_step(els, i.else_branch, state, answer, params, depth) {
              None -> None,
              Some(e) -> {
                let e2 = close(e);
                Some(with_made(e2, union_made(t2.count_locals, e2.count_locals)))
              },
            }
          },
        }
      },
    },
    NBlock(b) -> match b.tail {
      None -> None,
      Some(t) -> match stmts(emitter, b.stmts, params, 0) {
        None -> None,
        Some(after) -> emit_step(rescope(after, after.unboxed), t, state, answer, params, depth),
      },
    },
    NMatch(m) -> match match_subject(emitter, m.scrutinee, params) {
      None -> None,
      Some(s) ->
        match_arms(
          s.emitter,
          s.subj,
          m.arms,
          params,
          ToLoop({ state: state, answer: answer, depth: depth }),
          code.span,
          emitter.tail,
          emitter.leaves,
        ),
    },
    _ -> None,
  }

fn helper_call(
  emitter: Emitter,
  helper: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
) -> Option<WithValue> / {abort.raise} =
  match args_carried(emitter, args, params, [], 0, []) {
    None -> None,
    Some(w) -> {
      let o = bind(
        w.emitter,
        KBoxed,
        Bytes::concat_all([
          helper,
          b"(ctx",
          w.names.fold(b"", |acc: Bytes, nm: Bytes| Bytes::concat_all([acc, b", ", nm])),
          b")",
        ]),
      );
      Some({ emitter: check(o.emitter), value: o.value })
    },
  }

fn fused_fold(
  emitter: Emitter,
  name: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
  span: Span,
) -> Option<WithValue> / {abort.raise} =

  // `List::map` or `List::filter` over a lambda of one parameter is a loop running the lambda's body for each
  // element and pushing what it answers, or the element where it answers `true`, onto a list the
  // loop holds alone.
  if (name == b"List::map" || name == b"List::filter") && args.len() == 2 {
    match args.at(1) {
      None -> None,
      Some(f) -> match f.node {
        NLambda(l) -> if l.params != 1 { None } else {
          match args.at(0) {
            None -> None,
            Some(xs) -> match expr(notail(emitter), xs, params) {
              None -> None,
              Some(lv) -> {
                let lo = owned(lv.emitter, lv.value);
                let n = bind(lo.emitter, KInt, length_of(b"List::len", lo.value.expr));
                let made = bind(
                  n.emitter,
                  KBoxed,
                  Bytes::concat_all([b"rt_list_room_p(ctx, ", n.value.expr, b")"]),
                );
                let out = made.value.expr;
                let i = bind(builtin_of(check(made.emitter), b"List::push").emitter, KInt, b"0");
                let head = line(
                  i.emitter,
                  Bytes::concat_all([
                    b"for (; ",
                    i.value.expr,
                    b" < ",
                    n.value.expr,
                    b"; ",
                    i.value.expr,
                    b" += 1) {",
                  ]),
                );
                // Everything held outside the loop is pinned: the body reads it once per element.
                let opened = line(pin_all(indent(head)), tick_line(leaving(emitter)));
                match capture_window(opened, l.captures, params) {
                  None -> Some(refused(emitter, b"a capture this port has not bound")),
                  Some(window) -> {
                    let at = bind(
                      opened,
                      KBoxed,
                      Bytes::concat_all([
                        b"rt_list_at_p(ctx, ",
                        lo.value.expr,
                        b", ",
                        i.value.expr,
                        b")",
                      ]),
                    );
                    let element = { ..at.value, ty: ty_at(lambda_param_tys(emitter, l), 0) };
                    let bound = remember(
                      with_reads(rescope(at.emitter, window), slots_read(l.body)),
                      0,
                      element,
                    );
                    // The element `List::filter` keeps is held before the body, which may move it out.
                    let kept = if name == b"List::filter" { owned_word(bound, element) }
                    else { { emitter: bound, value: element } };
                    match expr(notail(kept.emitter), l.body, params) {
                      None -> None,
                      Some(r) -> {
                        let pushed = if name == b"List::map" {
                          let w = owned(r.emitter, r.value);
                          line(
                            w.emitter,
                            Bytes::concat_all([
                              out,
                              b" = ",
                              builtin_call_over(b"List::push", [out, w.value.expr]),
                              b";",
                            ]),
                          )
                        } else {
                          line(
                            r.emitter,
                            Bytes::concat_all([
                              b"if (",
                              as_bool(r.value),
                              b") { ",
                              out,
                              b" = ",
                              builtin_call_over(b"List::push", [out, kept.value.expr]),
                              b"; } else { ply_dec(ctx, ",
                              kept.value.expr,
                              b"); }",
                            ]),
                          )
                        };
                        let after = with_pinned(
                          close(with_reads(rescope(check(pushed), opened.unboxed), emitter.reads)),
                          emitter.pinned,
                        );
                        Some({
                          emitter: line(
                            after,
                            Bytes::concat_all([b"ply_dec(ctx, ", lo.value.expr, b");"]),
                          ),
                          value: made.value,
                        })
                      },
                    }
                  },
                }
              },
            },
          }
        },
        _ -> None,
      },
    }
  } else if name != b"List::fold" || args.len() != 3 { None } else {
    match args.at(2) {
      None -> None,
      Some(f) -> match f.node {
        NLambda(_) -> inlined_fold(emitter, args, params),
        _ -> if names_a_step(emitter, f) { inlined_fold(emitter, args, params) } else {
          match args.at(0) {
            None -> None,
            Some(xs) -> match args.at(1) {
              None -> None,
              Some(init) -> match expr(notail(emitter), xs, params) {
                None -> None,
                Some(lv) -> {
                  let lo = owned(lv.emitter, lv.value);
                  let n = bind(lo.emitter, KInt, length_of(b"List::len", lo.value.expr));
                  // The function value is evaluated once outside the loop, and each iteration hands `rt_call` its own count.
                  // Under release the seed is evaluated before the closure is built: a capture taken at its last use is null afterwards.
                  let ordered = if n.emitter.release {
                    match expr(notail(n.emitter), init, params) {
                      None -> None,
                      Some(iv) -> {
                        let acc = owned(iv.emitter, iv.value);
                        match expr(notail(acc.emitter), f, params) {
                          None -> None,
                          Some(cl) -> {
                            let held = owned(cl.emitter, cl.value);
                            Some({ emitter: held.emitter, co: held.value, acc: acc.value })
                          },
                        }
                      },
                    }
                  } else {
                    let held = match expr(notail(n.emitter), f, params) {
                      None -> None,
                      Some(cl) -> Some(owned(cl.emitter, cl.value)),
                    };
                    match held {
                      None -> None,
                      Some(co) -> match expr(notail(co.emitter), init, params) {
                        None -> None,
                        // The accumulator is not duplicated: the loop hands its count to the closure and takes back the answer's.
                        Some(iv) -> {
                          let acc = bind_word(iv.emitter, iv.value);
                          Some({ emitter: acc.emitter, co: co.value, acc: acc.value })
                        },
                      },
                    }
                  };
                  match ordered {
                    None -> None,
                    Some(ord) -> {
                      let co = { emitter: ord.emitter, value: ord.co };
                      let acc = { emitter: ord.emitter, value: ord.acc };
                      {
                        let i = bind(acc.emitter, KInt, b"0");
                        let head = line(
                          i.emitter,
                          Bytes::concat_all([
                            b"for (; ",
                            i.value.expr,
                            b" < ",
                            n.value.expr,
                            b"; ",
                            i.value.expr,
                            b" += 1) {",
                          ]),
                        );
                        let at = bind(
                          indent(head),
                          KBoxed,
                          Bytes::concat_all([
                            b"rt_list_at_p(ctx, ",
                            lo.value.expr,
                            b", ",
                            i.value.expr,
                            b")",
                          ]),
                        );
                        let call = {
                          let a2 = fresh(check(at.emitter));
                          line(
                            site(
                              line(
                                line(
                                  a2.emitter,
                                  Bytes::concat_all([
                                    b"Word ",
                                    a2.name,
                                    b"[] = {",
                                    acc.value.expr,
                                    b", ",
                                    at.value.expr,
                                    b"};",
                                  ]),
                                ),
                                Bytes::concat_all([b"ply_inc(", co.value.expr, b");"]),
                              ),
                              span,
                            ),
                            Bytes::concat_all([
                              acc.value.expr,
                              b" = rt_call_p(ctx, ",
                              co.value.expr,
                              b", (Word)(intptr_t)",
                              a2.name,
                              b", 2);",
                            ]),
                          )
                        };
                        // The call took the element.
                        let done = close(check(spend_made(call, at.value.expr)));
                        let freed = line(
                          done,
                          Bytes::concat_all([b"ply_dec(ctx, ", co.value.expr, b");"]),
                        );
                        Some({
                          emitter: note_holder(
                            line(
                              freed,
                              Bytes::concat_all([b"ply_dec(ctx, ", lo.value.expr, b");"]),
                            ),
                            acc.value.expr,
                          ),
                          value: acc.value,
                        })
                      }
                    },
                  }
                },
              },
            },
          }
        },
      },
    }
  }

/// `List::fold` over a literal lambda or a named definition runs its step in the loop, its accumulator
/// held at the seed's kind: a scalar is never boxed, and a record the step holds alone is updated in
/// place.
fn inlined_fold(
  emitter: Emitter,
  args: List<Code>,
  params: List<EmitParam>,
) -> Option<WithValue> / {abort.raise} =
  match args.at(2) {
    None -> None,
    Some(f) -> match args.at(0) {
      None -> None,
      Some(xs) -> match args.at(1) {
        None -> None,
        Some(init) -> match expr(notail(emitter), xs, params) {
          None -> None,
          Some(lv) -> {
            let lo = owned(lv.emitter, lv.value);
            let n = bind(lo.emitter, KInt, length_of(b"List::len", lo.value.expr));
            match expr(notail(n.emitter), init, params) {
              None -> None,
              Some(iv) -> {
                let tys = match f.node { NLambda(l) -> lambda_param_tys(emitter, l), _ -> [] };
                let carrier = match f.node {
                  NLambda(l) -> state_carrier(emitter, l),
                  _ -> Whole(KBoxed),
                };
                let fs = match carrier { Fields(x) -> x, _ -> [] };
                // An `Option` goes round as its payload's word; any other sum as its object.
                let k = if carrier == Whole(KSum(Zeroed)) { KSum(Zeroed) }
                else if is_sum(iv.value.kind) { KBoxed }
                else { iv.value.kind };
                let counted_state = k == KBoxed || is_sum(k) || fs.len() > 0;
                // The accumulator holds its count between steps; a step's holder takes it over.
                let seeded = if fs.len() > 0 {
                  let ls = record_locals(iv.emitter, fs, empty_inits(fs));
                  {
                    emitter: assigned_into(ls.emitter, iv.value, into_of(fs, ls)),
                    into: into_of(fs, ls),
                  }
                } else {
                  let o = match k {
                    KBoxed -> if iv.emitter.release { owned(iv.emitter, iv.value) }
                    else { bind_word(iv.emitter, iv.value) },
                    KSum(spec) -> sum_owned(iv.emitter, iv.value, spec),
                    _ -> bind(iv.emitter, k, as_kind(iv.value, k)),
                  };
                  { emitter: o.emitter, into: { fields: [], locals: [], word: o.value.expr } }
                };
                let st = seeded.into;
                let i = bind(seeded.emitter, KInt, b"0");
                let head = line(
                  i.emitter,
                  Bytes::concat_all([
                    b"for (; ",
                    i.value.expr,
                    b" < ",
                    n.value.expr,
                    b"; ",
                    i.value.expr,
                    b" += 1) {",
                  ]),
                );
                // Everything held outside the loop is pinned: the body reads it once per element.
                // A lambda's pass counts the call it replaces; a named step's callee counts its own.
                let opened = match f.node {
                  NLambda(_) -> line(pin_all(indent(head)), tick_line(leaving(emitter))),
                  _ -> pin_all(indent(head)),
                };
                let captures = match f.node { NLambda(l) -> l.captures, _ -> [] };
                let reads = match f.node { NLambda(l) -> slots_read(l.body), _ -> [0, 1] };
                match capture_window(opened, captures, params) {
                  None -> Some(refused(emitter, b"a capture this port has not bound")),
                  Some(window) -> {
                    let at = bind(
                      opened,
                      KBoxed,
                      Bytes::concat_all([
                        b"rt_list_at_p(ctx, ",
                        lo.value.expr,
                        b", ",
                        i.value.expr,
                        b")",
                      ]),
                    );
                    let held_ty = known_or(iv.value.ty, ty_at(tys, 0));
                    let holder = if counted_state { taken_over(at.emitter, st, k, held_ty) } else {
                      { emitter: at.emitter, value: { kind: k, expr: st.word, ty: held_ty } }
                    };
                    let inner = remember(
                      remember(with_reads(rescope(holder.emitter, window), reads), 0, holder.value),
                      1,
                      { ..at.value, ty: ty_at(tys, 1) },
                    );
                    match match f.node {
                        NLambda(l) -> expr(notail(inner), l.body, params),
                        _ -> named_step(notail(inner), f),
                      } {
                      None -> None,
                      Some(r) -> {
                        let stored = match k {
                          KSum(spec) -> {
                            let w = sum_owned(r.emitter, r.value, spec);
                            line(
                              w.emitter,
                              Bytes::concat_all([st.word, b" = ", w.value.expr, b";"]),
                            )
                          },
                          _ -> if counted_state { assigned_into(r.emitter, r.value, st) } else {
                            line(
                              r.emitter,
                              Bytes::concat_all([st.word, b" = ", as_kind(r.value, k), b";"]),
                            )
                          },
                        };
                        let after = with_pinned(
                          close(with_reads(rescope(stored, opened.unboxed), emitter.reads)),
                          emitter.pinned,
                        );
                        let freed = line(
                          after,
                          Bytes::concat_all([b"ply_dec(ctx, ", lo.value.expr, b");"]),
                        );
                        if fs.len() > 0 { Some(held_record(freed, fs, st.locals, st.word)) } else {
                          Some({
                            emitter: if counted_state { note_holder(freed, st.word) }
                            else { freed },
                            value: { kind: k, expr: st.word, ty: iv.value.ty },
                          })
                        }
                      },
                    }
                  },
                }
              },
            }
          },
        },
      },
    },
  }

/// Builtins expanded in place where the declaration fixes the kind: a length is the header's field, a byte a bounds-tested load.
fn inline_len(
  emitter: Emitter,
  name: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  if name == b"Bytes::at" && args.len() == 2 { inline_at(emitter, args, params, false, span) }
  else if name == b"Bytes::u32_le" && args.len() == 2 {
    inline_at(emitter, args, params, true, span)
  } else if name == b"Bytes::concat_all" && args.len() == 1 {
    inline_join(emitter, args, params, span)
  } else if name == b"Array::get" && args.len() == 2 { inline_get(emitter, args, params, span) }
  else if args.len() != 1 { None }
  else if name == b"Float::of_int" || name == b"Float::of_bits" || name == b"bits_of_float" {
    float_converted(emitter, name, args, params)
  } else if name != b"List::len" && name != b"Bytes::len" && name != b"Array::len" { None } else {
    match args.at(0) {
      None -> None,
      Some(x) -> match expr(notail(emitter), x, params) {
        None -> None,
        Some(o0) -> {
          let o = { emitter: site(o0.emitter, span), value: typed_value(o0.emitter, x, o0.value) };
          let fits = match o.value.ty {
            TyList -> name == b"List::len",
            TyBytes -> name == b"Bytes::len",
            TyArr(_) -> name == b"Array::len",
            _ -> false,
          };
          if !fits { Some(kind_tested(o.emitter, name, o.value, None)) } else {
            let t = bind(o.emitter, KBoxed, as_word(o.value));
            Some(bind(t.emitter, KInt, length_of(name, t.value.expr)))
          }
        },
      },
    }
  }

/// A conversion between a `Float` and an `Int`'s value or bits, in C: `Float::of_int` rounds to the
/// nearest as IEEE-754 does, and `bits_of_float` reads every NaN as the one `float::bits` names.
fn float_converted(
  emitter: Emitter,
  name: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
) -> Option<WithValue> / {abort.raise} =
  match args.at(0) {
    None -> None,
    Some(x) -> match expr(notail(emitter), x, params) {
      None -> None,
      Some(o) -> if name == b"Float::of_int" {
        Some(bind(o.emitter, KFloat, Bytes::concat_all([b"(double)(", as_int(o.value), b")"])))
      } else if name == b"Float::of_bits" {
        Some(bind(o.emitter, KFloat, Bytes::concat_all([b"ply_f64(", as_int(o.value), b")"])))
      } else {
        let b = bind(
          o.emitter,
          KInt,
          Bytes::concat_all([b"ply_f64_bits(", as_float(o.value), b")"]),
        );
        Some(
          bind(
            b.emitter,
            KInt,
            Bytes::concat_all([
              b"((((uint64_t)",
              b.value.expr,
              b" & UINT64_C(0x7FF0000000000000)) == UINT64_C(0x7FF0000000000000) && ((uint64_t)",
              b.value.expr,
              b" & UINT64_C(0x000FFFFFFFFFFFFF)) != 0) ? INT64_C(0x7FF8000000000000) : ",
              b.value.expr,
              b")",
            ]),
          ),
        )
      },
    },
  }

fn is_wrap(name: Bytes) -> Bool =
  name == b"wrap_add" || name == b"wrap_sub" || name == b"wrap_mul" || name == b"rotr"
    || name == b"rotl"

fn is_saturating(name: Bytes) -> Bool =
  name == b"saturating_add" || name == b"saturating_sub" || name == b"saturating_mul"

/// Exact in 64 bits, then held to the width's ends; only an unsigned 32-bit product needs the
/// unsigned word, and it can only pass the greatest value.
fn saturated(emitter: Emitter, name: Bytes, v0: CValue, v1: CValue, t: Width) -> WithValue = {
  let unsigned = !t.signed && name == b"saturating_mul";
  let wide = if unsigned { b"uint64_t" } else { b"int64_t" };
  let op = if name == b"saturating_add" { b" + " }
  else if name == b"saturating_sub" { b" - " }
  else { b" * " };
  let r = fresh(emitter);
  let exact = line(
    r.emitter,
    Bytes::concat_all([
      wide,
      b" ",
      r.name,
      b" = (",
      wide,
      b")(",
      as_num(v0, t),
      b")",
      op,
      b"(",
      wide,
      b")(",
      as_num(v1, t),
      b");",
    ]),
  );
  let top = Bytes::concat_all([
    r.name,
    b" > ",
    if unsigned { b"(uint64_t)" } else { b"" },
    int_lit(width_max(t)),
    b" ? ",
    int_lit(width_max(t)),
    b" : ",
    r.name,
  ]);
  bind(
    exact,
    KNum(t),
    Bytes::concat_all([
      b"(",
      ctype(KNum(t)),
      b")(",
      if unsigned { top } else {
        Bytes::concat_all([
          r.name,
          b" < ",
          int_lit(width_min(t)),
          b" ? ",
          int_lit(width_min(t)),
          b" : (",
          top,
          b")",
        ])
      },
      b")",
    ]),
  )
}

fn is_checked(name: Bytes) -> Bool =
  name == b"checked_add" || name == b"checked_sub" || name == b"checked_mul"
    || name == b"checked_neg"

/// Exact in 64 bits, then tested against the width; only an unsigned 32-bit product needs the unsigned word.
fn checked_num(
  emitter: Emitter,
  name: Bytes,
  vals: List<CValue>,
  t: Width,
) -> Option<WithValue> / {abort.raise} =
  match tag_of(emitter, b"Some") {
    None -> None,
    Some(some) -> match tag_of(emitter, b"None") {
      None -> None,
      Some(none) -> match vals.at(0) {
        None -> None,
        Some(v0) -> {
          let wide = if !t.signed && name == b"checked_mul" { b"uint64_t" } else { b"int64_t" };
          let a = Bytes::concat_all([b"(", wide, b")(", as_num(v0, t), b")"]);
          let exact = if name == b"checked_neg" { Some(b"-".concat(a)) } else {
            match vals.at(1) {
              None -> None,
              Some(v1) -> {
                let b = Bytes::concat_all([b"(", wide, b")(", as_num(v1, t), b")"]);
                let op = if name == b"checked_add" { b" + " }
                else if name == b"checked_sub" { b" - " }
                else { b" * " };
                Some(Bytes::concat_all([a, op, b]))
              },
            }
          };
          match exact {
            None -> None,
            Some(x) -> {
              let r = fresh(emitter);
              let computed = line(
                r.emitter,
                Bytes::concat_all([wide, b" ", r.name, b" = ", x, b";"]),
              );
              let ans = fresh(computed);
              let declared = line(
                ans.emitter,
                Bytes::concat_all([
                  b"Word ",
                  ans.name,
                  b" = rt_nullary_p(ctx, ",
                  tag_text(emitter, none),
                  b");",
                ]),
              );
              let fits = if wide == b"uint64_t" {
                Bytes::concat_all([r.name, b" <= (uint64_t)", int_lit(width_max(t))])
              } else {
                Bytes::concat_all([
                  r.name,
                  b" >= ",
                  int_lit(width_min(t)),
                  b" && ",
                  r.name,
                  b" <= ",
                  int_lit(width_max(t)),
                ])
              };
              let made = line(
                declared,
                Bytes::concat_all([
                  b"if (",
                  fits,
                  b") { Word w[] = { ply_imm((int64_t)",
                  r.name,
                  b") }; ",
                  ans.name,
                  b" = rt_ctor_p(ctx, ",
                  tag_text(emitter, some),
                  b", (Word)(intptr_t)w, 1); }",
                ]),
              );
              Some({
                emitter: note_holder(check(made), ans.name),
                value: { kind: KBoxed, expr: ans.name, ty: TyOpen([]) },
              })
            },
          }
        },
      },
    },
  }

fn of_int_width(name: Bytes) -> Option<Width> =
  if name == b"U8::of_int" { width_named(b"U8") }
  else if name == b"U16::of_int" { width_named(b"U16") }
  else if name == b"U32::of_int" { width_named(b"U32") }
  else if name == b"U64::of_int" { width_named(b"U64") }
  else if name == b"I8::of_int" { width_named(b"I8") }
  else if name == b"I16::of_int" { width_named(b"I16") }
  else if name == b"I32::of_int" { width_named(b"I32") }
  else if name == b"I64::of_int" { width_named(b"I64") }
  else if name == b"U128::of_int" { width_named(b"U128") }
  else if name == b"I128::of_int" { width_named(b"I128") }
  else { None }

fn int_of_width(name: Bytes) -> Option<Width> =
  if name == b"Int::of_u8" { width_named(b"U8") }
  else if name == b"Int::of_u16" { width_named(b"U16") }
  else if name == b"Int::of_u32" { width_named(b"U32") }
  else if name == b"Int::of_u64" { width_named(b"U64") }
  else if name == b"Int::of_i8" { width_named(b"I8") }
  else if name == b"Int::of_i16" { width_named(b"I16") }
  else if name == b"Int::of_i32" { width_named(b"I32") }
  else if name == b"Int::of_i64" { width_named(b"I64") }
  else if name == b"Int::of_u128" { width_named(b"U128") }
  else if name == b"Int::of_i128" { width_named(b"I128") }
  else { None }

fn is_width_builtin(name: Bytes) -> Bool =
  is_wrap(name) || is_saturating(name) || is_checked(name) || of_int_width(name) != None
    || int_of_width(name) != None

fn width_arity(name: Bytes) -> Int =
  if is_wrap(name) || is_saturating(name) || (is_checked(name) && name != b"checked_neg") { 2 }
  else { 1 }

/// A width builtin used as a value is a lambda around its own call, so the call is compiled at the
/// type the checker settled, as a direct one is: the runtime's builtin would read the words untyped.
fn width_closure(code: Code, name: Bytes) -> Code = {
  let n = width_arity(name);
  let at = |node: Node| { own: Borrowed, node: node, span: code.span };
  at(
    NLambda({
      params: n,
      size: n,
      captures: [],
      at: code.span,
      body: at(
        NApp({
          func: at(NVar({ name: name, slot: None })),
          args: range(0, n).map(|i: Int|
            at(NVar({ name: b"p".concat(ascii_of_int(i)), slot: Some(i) }))),
        }),
      ),
    }),
  )
}

/// Each width builtin used as a value written out as the lambda `width_closure` makes, before a body
/// is emitted, so emitting never writes code it then emits. A name a call applies stays a call.
fn widths_closed(emitter: Emitter, c: Code) -> Code / {abort.raise} = {
  let go = |x: Code| widths_closed(emitter, x);
  let maybe = |x: Option<Code>| match x { Some(y) -> Some(go(y)), None -> None };
  let node = match c.node {
    NVar(v) -> c.node,
    NLit(_) -> c.node,
    NLabel(_) -> c.node,
    NUnary(u) -> NUnary({ ..u, operand: go(u.operand) }),
    NBinary(b) -> NBinary({ ..b, lhs: go(b.lhs), rhs: go(b.rhs) }),
    NApp(a) ->
      NApp({
        func: match a.func.node { NVar(_) -> a.func, _ -> go(a.func) },
        args: a.args.map(go),
      }),
    NIf(i) ->
      NIf({ cond: go(i.cond), then_branch: go(i.then_branch), else_branch: go(i.else_branch) }),
    NBlock(b) ->
      NBlock({
        stmts: b.stmts.map(|stmt: CodeStmt|
          match stmt {
            CLet(l) -> CLet({ ..l, value: go(l.value) }),
            CLetPat(l) -> CLetPat({ ..l, value: go(l.value) }),
            CDo(d) -> CDo({ code: go(d.code) }),
          }),
        tail: maybe(b.tail),
      }),
    NList(l) -> NList({ items: l.items.map(go) }),
    NRecord(r) -> NRecord({ fields: r.fields.map(|f: CodeField| { ..f, value: go(f.value) }) }),
    NMatch(m) ->
      NMatch({
        scrutinee: go(m.scrutinee),
        arms: m.arms.map(|a: CodeArm| { ..a, guard: maybe(a.guard), body: go(a.body) }),
      }),
    NPerform(p) -> NPerform({ ..p, label: maybe(p.label), args: p.args.map(go) }),
    NLambda(l) -> NLambda({ ..l, body: go(l.body) }),
    NSimulate(x) -> NSimulate({ ..x, body: go(x.body) }),
    NParallel(pr) -> NParallel({ ..pr, branches: pr.branches.map(go) }),
    NHandle(h) ->
      NHandle({
        body: go(h.body),
        clauses: h.clauses.map(|k: CodeClause| { ..k, label: maybe(k.label), body: go(k.body) }),
        ret: match h.ret { Some(r) -> Some({ ..r, body: go(r.body) }), None -> None },
      }),
    NField(f) -> NField({ ..f, base: go(f.base) }),
    NUpdate(u) ->
      NUpdate({
        ..u,
        base: go(u.base),
        sets: u.sets.map(|f: CodeField| { ..f, value: go(f.value) }),
      }),
    // A known lambda is closed as its owner closes it, under the owner's names.
    NKnown(k) ->
      NKnown({
        ..k,
        lambda: {
          ..k.lambda,
          body: match lambda_frame(emitter, k.owner, k.nth) {
            Some(frame) -> widths_closed(framed(emitter, frame), k.lambda.body),
            None -> k.lambda.body,
          },
        },
      }),
  };
  match c.node {
    NVar(v) -> if bare_width(emitter, v.name, v.slot) { width_closure(c, v.name) } else { c },
    _ -> { ..c, node: node },
  }
}

/// A name that is a width builtin and not a local, a constructor or a definition, as `expr` reads one.
fn bare_width(emitter: Emitter, name: Bytes, slot: Option<Int>) -> Bool / {abort.raise} =
  slot == None && !is_ctor_name(name) && is_width_builtin(name)
    && (match def_of(emitter, name) { Some(_) -> false, None -> true })

/// Wrapping, checked arithmetic and conversions over a carried width, in place; otherwise the
/// runtime's call on the evaluated values. The wrapping and checked families work at the type the
/// checker settled at `at`, their name, and so do `compare`, `reflect` and `shown`.
fn width_builtin(
  emitter: Emitter,
  written: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
  span: Span,
  at: Span,
) -> Option<WithValue> / {abort.raise} = {
  let name = generated_builtin(written);
  if (name == b"reflect" || name == b"shown") && args.len() == 1 {
    match reflection_at(emitter, at) {
      None -> None,
      Some(r) -> reflected(emitter, name == b"shown", r, args, params, span),
    }
  } else if ((name == b"Array::new" && args.len() == 2)
      || (name == b"Array::set" && args.len() == 3)
      || (name == b"Array::of_list" && args.len() == 1))
      && array_element_at(emitter, at) != None {
    match array_element_at(emitter, at) {
      None -> None,
      Some(e) -> match args_evaled(emitter, args, params, 0, []) {
        None -> None,
        Some(e0) -> {
          let em = site(e0.emitter, span);
          let v = |i: Int| nth_value(e0.vals, i);
          if name == b"Array::new" { Some(array_new(em, e, v(0), v(1))) }
          else if name == b"Array::set" { Some(array_set(em, e, v(0), v(1), v(2))) }
          else { Some(array_of_list(em, e, v(0))) }
        },
      },
    }
  } else if (name == b"digest" || name == b"?encoded") && args.len() == 1 {
    match encoding_at(emitter, at) {
      None -> None,
      Some(ty) -> match args_evaled(emitter, args, params, 0, []) {
        None -> None,
        Some(e0) -> {
          let bytes = written_call(site(e0.emitter, span), b"digest", ty, nth_value(e0.vals, 0));
          if name == b"?encoded" { Some(bytes) }
          else { Some(builtin_call(bytes.emitter, b"Bytes::blake3", [bytes.value])) }
        },
      },
    }
  } else if (name == b"compare" || name == b"compare_values") && args.len() == 2
      && ordered_at(emitter, at) != None {
    match args_evaled(emitter, args, params, 0, []) {
      None -> None,
      Some(e0) ->
        Some(
          compared_order(
            site(e0.emitter, span),
            ordered_at(emitter, at),
            nth_value(e0.vals, 0),
            nth_value(e0.vals, 1),
            span,
          ),
        ),
    }
  } else if (is_wrap(name) || is_saturating(name) || is_checked(name))
      && args.len() == width_arity(name) {
    let emitter = operand_needed(emitter, at, false);
    match operand_at(emitter, at) {
      None -> Some(unsettled_operator(emitter, name)),
      Some(t) -> match args_evaled(emitter, args, params, 0, []) {
        None -> None,
        Some(e0) -> {
          let e = site(e0.emitter, span);
          match t {
            // Saturating and checked arithmetic is exact in 64 bits below them, and the runtime's at 64.
            OWidth(w) -> if !in_imm(w) && !(carried(w) && is_wrap(name)) {
              Some(builtin_call(e, name, e0.vals))
            } else if is_checked(name) { checked_num(e, name, e0.vals, w) } else {
              match e0.vals.at(0) {
                None -> None,
                Some(v0) -> match e0.vals.at(1) {
                  None -> None,
                  Some(v1) -> if is_saturating(name) { Some(saturated(e, name, v0, v1, w)) }
                  else { Some(wrapped(e, name, v0, v1, w)) },
                },
              }
            },
            _ -> Some(builtin_call(e, name, e0.vals)),
          }
        },
      },
    }
  } else if !((of_int_width(name) != None || int_of_width(name) != None) && args.len() == 1) {
    None
  } else {
    match args_evaled(emitter, args, params, 0, []) {
      None -> None,
      Some(e0) -> match e0.vals.at(0) {
        None -> None,
        Some(v0) -> {
          let e = { emitter: site(e0.emitter, span), vals: e0.vals };
          match of_int_width(name) {
            Some(t) -> if carried(t) && !in_imm(t) {
              // An `I64` is any `Int`; a `U64` any but a negative one.
              let held = bind(e.emitter, KInt, as_int(v0));
              let g = if t.signed { held.emitter } else {
                line(
                  held.emitter,
                  Bytes::concat_all([
                    b"if (",
                    held.value.expr,
                    b" < 0) { rt_not_that_width_p(ctx, ",
                    ascii_of_int(width_index(t)),
                    b", ",
                    held.value.expr,
                    b"); ",
                    leaving(held.emitter),
                    b" }",
                  ]),
                )
              };
              Some(
                bind(g, KNum(t), Bytes::concat_all([b"(", ctype(KNum(t)), b")", held.value.expr])),
              )
            } else if carried(t) {
              let held = bind(e.emitter, KInt, as_int(v0));
              let g = line(
                held.emitter,
                Bytes::concat_all([
                  b"if (",
                  held.value.expr,
                  b" < ",
                  int_lit(width_min(t)),
                  b" || ",
                  held.value.expr,
                  b" > ",
                  int_lit(width_max(t)),
                  b") { rt_not_that_width_p(ctx, ",
                  ascii_of_int(width_index(t)),
                  b", ",
                  held.value.expr,
                  b"); ",
                  leaving(held.emitter),
                  b" }",
                ]),
              );
              Some(
                bind(g, KNum(t), Bytes::concat_all([b"(", ctype(KNum(t)), b")", held.value.expr])),
              )
            } else { Some(builtin_call(e.emitter, name, e.vals)) },
            None -> match int_of_width(name) {
              // A `U64` past an `Int` is the runtime's to refuse.
              Some(t) -> if carried(t) && (in_imm(t) || t.signed) {
                Some(bind(e.emitter, KInt, as_int(v0)))
              } else { Some(builtin_call(e.emitter, name, e.vals)) },
              None -> None,
            },
          }
        },
      },
    }
  }
}

// --- Externs written in place -----------------------------------------------------

/// What the emitter writes in place of a call of `name` from this module: an extern the module, or
/// one it imports, declares under a program-wide name `intrinsics` lists. No definition has such a
/// name, since its module declares the extern.
fn in_place_at(emitter: Emitter, name: Bytes) -> Option<Intrinsic> =
  intrinsic_named(match qualified(name) {
    Some(q) -> match module_import(emitter.imports, q.binder) {
      Some(imp) -> qualify(imp.module, q.name),
      None -> qualify(emitter.module, name),
    },
    None -> match from_import(emitter.imports, name) {
      Some(imp) -> qualify(imp.module, name),
      None -> qualify(emitter.module, name),
    },
  })

/// A call of an extern the emitter writes in place, over what its arguments evaluated to, at the
/// types the checker settled the call at.
fn written_in_place(
  emitter: Emitter,
  op: Intrinsic,
  vals: List<CValue>,
  settled: Option<Typed>,
) -> WithValue = {
  let tys = match settled { Some(t) -> t.args, None -> [] };
  match op {
    OfList(o) -> list_node_op(emitter, o, vals, item_type(tys.at(0))),
    OfMap(o) -> map_node_op(emitter, o, vals, item_type(tys.at(0)), item_type(tys.at(1))),
  }
}

/// The type an item is held at in a list's or a map's objects: the type the call settled where it
/// settled one, else a word's.
fn item_type(t: Option<Type>) -> Type =
  match t { Some(ty) -> if has_vars(ty) { word_type() } else { ty }, None -> word_type() }

fn header_of(w: Bytes, field: Bytes) -> Bytes = Bytes::concat_all([b"ply_obj(", w, b")->", field])

fn slot_of(w: Bytes, at: Bytes) -> Bytes = Bytes::concat_all([b"ply_words(", w, b")[", at, b"]"])

/// `at` words past the word `from`, as C reads it.
fn past(from: Int, at: Bytes) -> Bytes = Bytes::concat_all([ascii_of_int(from), b" + (", at, b")"])

/// A new node of the runtime's `kind`, with room for a full one.
fn new_node(emitter: Emitter, kind: Int) -> WithValue =
  bind(emitter, KBoxed, Bytes::concat_all([b"rt_node_p(ctx, ", ascii_of_int(kind), b")"]))

/// The word `w` reads, held once more.
fn word_held(emitter: Emitter, w: Bytes, kind: Kind, ty: Ty) -> WithValue = {
  let r = fresh(emitter);
  let loaded = line(
    r.emitter,
    Bytes::concat_all([b"Word ", r.name, b" = ", w, b"; ply_inc(", r.name, b");"]),
  );
  { emitter: note_holder(loaded, r.name), value: { kind: kind, expr: r.name, ty: ty } }
}

/// An item, the word `w` reads, at its type `t`: a scalar read from the word, anything else the
/// word held once more.
fn item_read(emitter: Emitter, w: Bytes, t: Type) -> WithValue = {
  let k = kind_of(t);
  match k.kind {
    KBoxed -> word_held(emitter, w, KBoxed, k.ty),
    kind -> bind(emitter, kind, as_kind({ kind: KBoxed, expr: w, ty: TyOpen([]) }, kind)),
  }
}

/// An item, the word `w` the caller now holds, at its type `t`: a scalar read from the word and the
/// word let go, anything else the word itself.
fn item_taken(emitter: Emitter, w: Bytes, t: Type) -> WithValue = {
  let k = kind_of(t);
  match k.kind {
    KBoxed -> { emitter: note_made(emitter, w), value: { kind: KBoxed, expr: w, ty: k.ty } },
    kind -> {
      let read = bind(emitter, kind, as_kind({ kind: KBoxed, expr: w, ty: TyOpen([]) }, kind));
      {
        emitter: line(read.emitter, Bytes::concat_all([b"ply_dec(ctx, ", w, b");"])),
        value: read.value,
      }
    },
  }
}

/// The record of `fields`, in their names' order, held back as `words`: what a write that answers
/// two or three words answers.
fn written_record(emitter: Emitter, fields: List<Field>, words: List<CValue>) -> WithValue =
  match kind_of(TyRecord(fields)).ty {
    TyRec(fs) -> held_record(emitter, fs, words, b"0"),
    _ -> refused(emitter, b"a write in place that answers no record"),
  }

/// The object the call takes as its first argument, as a word this body holds and hands on.
fn taken_first(emitter: Emitter, vals: List<CValue>) -> WithValue = {
  let taken = owned(emitter, nth_value(vals, 0));
  bind(taken.emitter, KBoxed, taken.value.expr)
}

/// `a`, the object a write in place took, as the call's answer.
fn written_as(emitter: Emitter, a: Bytes, ty: Ty) -> WithValue =
  { emitter: note_made(emitter, a), value: { kind: KBoxed, expr: a, ty: ty } }

/// Written ahead of a write of an item of the object `a`: `a` held once, by `writable`, its
/// contents copied where it was not, and the write counted as in place or of a copy of `copied`
/// words.
fn counted_writable(a: Bytes, writable: Bytes, copied: Bytes) -> Bytes =
  Bytes::concat_all([
    b"{ int in_place = ",
    header_of(a, b"rc"),
    b" == 1; if (!in_place) ",
    writable,
    b" rt_note_update_p(ctx, in_place, in_place ? 0 : ",
    copied,
    b"); }",
  ])

/// What `read` makes of the word of the object a call takes first, which the call then lets go of
/// as any call does: a count held past the read would make the next write copy what it writes.
fn read_from(
  emitter: Emitter,
  vals: List<CValue>,
  read: (Emitter, Bytes) -> WithValue,
) -> WithValue = {
  let held = owned(emitter, nth_value(vals, 0));
  let r = read(held.emitter, held.value.expr);
  {
    emitter: line(r.emitter, Bytes::concat_all([b"ply_dec(ctx, ", held.value.expr, b");"])),
    value: r.value,
  }
}

/// An `Int` header field of the object a call takes first.
fn header_read(emitter: Emitter, vals: List<CValue>, field: Bytes) -> WithValue =
  read_from(emitter, vals, |e: Emitter, w: Bytes|
    bind(e, KInt, Bytes::concat_all([b"(int64_t)", header_of(w, field)])))

/// A function of `ListNode` over a list's objects as `layouts` lays them out, every item a word:
/// one that reads them here, one that writes them by `list_node_write`.
fn list_node_op(em: Emitter, op: ListOp, vals: List<CValue>, item: Type) -> WithValue = {
  let laid = layouts().list;
  let index = as_int(nth_value(vals, 1));
  let read = |r: (Emitter, Bytes) -> WithValue| read_from(em, vals, r);
  match op {
    ListStart -> header_read(em, vals, laid.start),
    TailLen -> header_read(em, vals, laid.tail_len),
    NodeLen -> header_read(em, vals, b"len"),
    ListRoot ->
      read(|e: Emitter, w: Bytes|
        word_held(e, slot_of(w, ascii_of_int(laid.root)), KSum(Zeroed), TyOpen([]))),
    TailAt -> read(|e: Emitter, w: Bytes| item_read(e, slot_of(w, past(laid.tail, index)), item)),
    LeafAt -> read(|e: Emitter, w: Bytes| item_read(e, slot_of(w, past(0, index)), item)),
    KidAt ->
      read(|e: Emitter, w: Bytes| word_held(e, slot_of(w, past(0, index)), KBoxed, TyOpen([]))),
    NewBranch -> new_node(em, layouts().trie.branch),
    _ -> list_node_write(em, op, vals, item),
  }
}

/// A function of `ListNode` that writes the list or node it takes: in place where it is held once,
/// else in a copy holding its contents once more, a write of an item counting which it was. Each
/// word taken is the call's to hand on, and each answered the answer's.
fn list_node_write(em: Emitter, op: ListOp, vals: List<CValue>, item: Type) -> WithValue = {
  let laid = layouts();
  let held = taken_first(em, vals);
  let a = held.value.expr;
  let header = |field: Bytes| header_of(a, field);
  let index = as_int(nth_value(vals, 1));
  let tail = |i: Bytes| slot_of(a, past(laid.list.tail, i));
  let list_writable = |room: Bytes|
    Bytes::concat_all([a, b" = rt_list_writable_p(ctx, ", a, b", ", room, b");"]);
  let node_writable = Bytes::concat_all([a, b" = rt_node_writable_p(ctx, ", a, b");"]);
  let shared = |writable: Bytes|
    Bytes::concat_all([b"if (", header(b"rc"), b" != 1) ", writable, b" "]);
  let list_ty = TyCon({ name: b"List", args: [item] });
  let node_ty = word_type();
  let maybe_node = TyCon({ name: b"Option", args: [node_ty] });
  let set = |e: Emitter, writable: Bytes, copied: Bytes, slot: Bytes| {
    let v = owned(e, nth_value(vals, 2));
    let old = fresh(v.emitter);
    line(
      old.emitter,
      Bytes::concat_all([
        counted_writable(a, writable, copied),
        b" Word ",
        old.name,
        b" = ",
        slot,
        b"; ",
        slot,
        b" = ",
        v.value.expr,
        b"; ply_dec(ctx, ",
        old.name,
        b");",
      ]),
    )
  };
  match op {
    TailPush -> {
      let v = owned(held.emitter, nth_value(vals, 1));
      let room = header(laid.list.room);
      let grown = line(
        v.emitter,
        Bytes::concat_all([
          b"{ int in_place = ",
          header(b"rc"),
          b" == 1; int64_t n = ",
          header(laid.list.tail_len),
          b"; if (!in_place || n == ",
          room,
          b") ",
          list_writable(Bytes::concat_all([b"n == ", room, b" ? 2 * ", room, b" : ", room])),
          b" rt_note_update_p(ctx, in_place, in_place ? 0 : n); }",
        ]),
      );
      let pushed = line(
        grown,
        Bytes::concat_all([
          tail(header(laid.list.tail_len)),
          b" = ",
          v.value.expr,
          b"; ",
          header(laid.list.tail_len),
          b" += 1; ",
          header(b"len"),
          b" += 1;",
        ]),
      );
      written_as(pushed, a, TyList)
    },
    TailStart -> {
      let v = owned(held.emitter, nth_value(vals, 1));
      let pushed = line(
        v.emitter,
        Bytes::concat_all([
          tail(b"0"),
          b" = ",
          v.value.expr,
          b"; ",
          header(laid.list.tail_len),
          b" = 1; ",
          header(b"len"),
          b" += 1;",
        ]),
      );
      written_as(pushed, a, TyList)
    },
    TailSet ->
      written_as(
        set(
          held.emitter,
          list_writable(header(laid.list.room)),
          header(laid.list.tail_len),
          tail(index),
        ),
        a,
        TyList,
      ),
    LeafSet ->
      written_as(
        set(held.emitter, node_writable, header(b"len"), slot_of(a, index)),
        a,
        TyOpen([]),
      ),
    RootSwap -> {
      let r = sum_owned(held.emitter, nth_value(vals, 1), Zeroed);
      let old = fresh(r.emitter);
      let root = slot_of(a, ascii_of_int(laid.list.root));
      let swapped = line(
        old.emitter,
        Bytes::concat_all([
          shared(list_writable(header(laid.list.room))),
          b"Word ",
          old.name,
          b" = ",
          root,
          b"; ",
          root,
          b" = ",
          r.value.expr,
          b";",
        ]),
      );
      written_record(
        note_made(note_made(swapped, a), old.name),
        [{ name: b"list", ty: list_ty }, { name: b"old", ty: maybe_node }],
        [
          { kind: KBoxed, expr: a, ty: TyList },
          { kind: KSum(Zeroed), expr: old.name, ty: TyOpen([]) },
        ],
      )
    },
    KidSwap -> {
      let c = sum_owned(held.emitter, nth_value(vals, 2), Zeroed);
      let old = fresh(c.emitter);
      let swapped = line(
        old.emitter,
        Bytes::concat_all([
          shared(node_writable),
          b"Word ",
          old.name,
          b" = 0; if (",
          index,
          b" < (int64_t)",
          header(b"len"),
          b") ",
          old.name,
          b" = ",
          slot_of(a, index),
          b"; else ",
          header(b"len"),
          b" = (uint32_t)(",
          index,
          b") + 1; ",
          slot_of(a, index),
          b" = ",
          c.value.expr,
          b";",
        ]),
      );
      written_record(
        note_made(note_made(swapped, a), old.name),
        [{ name: b"node", ty: node_ty }, { name: b"old", ty: maybe_node }],
        [
          { kind: KBoxed, expr: a, ty: TyOpen([]) },
          { kind: KSum(Zeroed), expr: old.name, ty: TyOpen([]) },
        ],
      )
    },
    Spill -> {
      let leaf = fresh(held.emitter);
      let width = ascii_of_int(laid.trie.width);
      let spilt = line(
        leaf.emitter,
        Bytes::concat_all([
          counted_writable(a, list_writable(header(laid.list.room)), header(laid.list.tail_len)),
          b" Word ",
          leaf.name,
          b" = rt_node_p(ctx, ",
          ascii_of_int(laid.trie.leaf),
          b"); memcpy(ply_words(",
          leaf.name,
          b"), &",
          tail(b"0"),
          b", ",
          width,
          b" * sizeof(Word)); ",
          header_of(leaf.name, b"len"),
          b" = ",
          width,
          b"; ",
          header(laid.list.tail_len),
          b" = 0;",
        ]),
      );
      written_record(
        note_made(note_made(spilt, a), leaf.name),
        [{ name: b"leaf", ty: node_ty }, { name: b"list", ty: list_ty }],
        [{ kind: KBoxed, expr: leaf.name, ty: TyOpen([]) }, { kind: KBoxed, expr: a, ty: TyList }],
      )
    },
    _ -> refused(held.emitter, b"a function of a list's node that reads it, written as a write"),
  }
}

/// A function of `MapNode` over a map's objects as `layouts` lays them out, every key and value a
/// word: one that reads them here, one that writes them by `map_node_write`.
fn map_node_op(em: Emitter, op: MapOp, vals: List<CValue>, key: Type, value: Type) -> WithValue = {
  let laid = layouts();
  let index = as_int(nth_value(vals, 1));
  let read = |r: (Emitter, Bytes) -> WithValue| read_from(em, vals, r);
  let pair = |w: Bytes, of: Bytes| slot_of(w, Bytes::concat_all([b"2 * (", index, b")", of]));
  match op {
    MapRoot ->
      read(|e: Emitter, w: Bytes|
        word_held(e, slot_of(w, ascii_of_int(laid.map.root)), KSum(Zeroed), TyOpen([]))),
    MapHeight -> header_read(em, vals, laid.map.height),
    NodeCount -> header_read(em, vals, b"len"),
    NodeKey -> read(|e: Emitter, w: Bytes| item_read(e, pair(w, b""), key)),
    NodeValue -> read(|e: Emitter, w: Bytes| item_read(e, pair(w, b" + 1"), value)),
    NodeKid ->
      read(|e: Emitter, w: Bytes| word_held(e, slot_of(w, past(0, index)), KBoxed, TyOpen([]))),
    KidMax ->
      read(|e: Emitter, w: Bytes| item_read(e, slot_of(w, past(laid.tree.keys, index)), key)),
    KidSize ->
      read(|e: Emitter, w: Bytes|
        bind(
          e,
          KInt,
          Bytes::concat_all([b"ply_imm_value(", slot_of(w, past(laid.tree.sizes, index)), b")"]),
        )),
    NewLeaf -> new_node(em, laid.tree.leaf),
    NewMapBranch -> new_node(em, laid.tree.branch),
    _ -> map_node_write(em, op, vals, key, value),
  }
}

/// A function of `MapNode` that writes the map or node it takes: in place where it is held once,
/// else in a copy holding its contents once more, a write of a pair counting which it was. Each
/// word taken is the call's to hand on, and each answered the answer's.
fn map_node_write(em: Emitter, op: MapOp, vals: List<CValue>, key: Type, value: Type) -> WithValue = {
  let laid = layouts();
  let held = taken_first(em, vals);
  let a = held.value.expr;
  let header = |field: Bytes| header_of(a, field);
  let index = Bytes::concat_all([b"(", as_int(nth_value(vals, 1)), b")"]);
  let at = |i: Bytes| slot_of(a, i);
  let words_at = |i: Bytes| Bytes::concat_all([b"&", at(i)]);
  let shifted = |from: Bytes, n: Bytes, by: Bytes|
    Bytes::concat_all([
      b"memmove(",
      words_at(Bytes::concat_all([from, b" + ", by])),
      b", ",
      words_at(from),
      b", (size_t)(",
      n,
      b") * sizeof(Word)); ",
    ]);
  let node_writable = Bytes::concat_all([a, b" = rt_node_writable_p(ctx, ", a, b");"]);
  let writable = Bytes::concat_all([b"if (", header(b"rc"), b" != 1) ", node_writable, b" "]);
  let pairs_writable = counted_writable(
    a,
    node_writable,
    Bytes::concat_all([b"2 * (int64_t)", header(b"len")]),
  );
  let keys = |i: Bytes| past(laid.tree.keys, i);
  let sizes = |i: Bytes| past(laid.tree.sizes, i);
  let node_ty = word_type();
  let node_value = { kind: KBoxed, expr: a, ty: TyOpen([]) };
  let pair = Bytes::concat_all([b"2 * ", index]);
  let pair_value = Bytes::concat_all([pair, b" + 1"]);
  let after = |less: Bytes| Bytes::concat_all([b"(int64_t)", header(b"len"), b" - ", index, less]);
  match op {
    PairPut -> {
      let k = owned(held.emitter, nth_value(vals, 2));
      let v = owned(k.emitter, nth_value(vals, 3));
      let put = line(
        v.emitter,
        Bytes::concat_all([
          pairs_writable,
          b" ",
          shifted(pair, Bytes::concat_all([b"2 * (", after(b""), b")"]), b"2"),
          at(pair),
          b" = ",
          k.value.expr,
          b"; ",
          at(pair_value),
          b" = ",
          v.value.expr,
          b"; ",
          header(b"len"),
          b" += 1;",
        ]),
      );
      written_as(put, a, TyOpen([]))
    },
    PairSet -> {
      let k = owned(held.emitter, nth_value(vals, 2));
      let v = owned(k.emitter, nth_value(vals, 3));
      let old_key = fresh(v.emitter);
      let old_value = fresh(old_key.emitter);
      let set = line(
        old_value.emitter,
        Bytes::concat_all([
          pairs_writable,
          b" Word ",
          old_key.name,
          b" = ",
          at(pair),
          b"; Word ",
          old_value.name,
          b" = ",
          at(pair_value),
          b"; ",
          at(pair),
          b" = ",
          k.value.expr,
          b"; ",
          at(pair_value),
          b" = ",
          v.value.expr,
          b"; ply_dec(ctx, ",
          old_key.name,
          b"); ply_dec(ctx, ",
          old_value.name,
          b");",
        ]),
      );
      written_as(set, a, TyOpen([]))
    },
    PairTake -> {
      let k = fresh(held.emitter);
      let v = fresh(k.emitter);
      let taken = line(
        v.emitter,
        Bytes::concat_all([
          pairs_writable,
          b" Word ",
          k.name,
          b" = ",
          at(pair),
          b"; Word ",
          v.name,
          b" = ",
          at(pair_value),
          b"; ",
          shifted(
            Bytes::concat_all([pair, b" + 2"]),
            Bytes::concat_all([b"2 * (", after(b" - 1"), b")"]),
            b"-2",
          ),
          header(b"len"),
          b" -= 1;",
        ]),
      );
      let k_value = item_taken(note_made(taken, a), k.name, key);
      let v_value = item_taken(k_value.emitter, v.name, value);
      written_record(
        v_value.emitter,
        [{ name: b"key", ty: key }, { name: b"node", ty: node_ty }, { name: b"value", ty: value }],
        [k_value.value, node_value, v_value.value],
      )
    },
    LeafCut -> cut(held.emitter, a, index, laid.tree.leaf, [{ from: 0, width: 2 }]),
    BranchCut ->
      cut(held.emitter, a, index, laid.tree.branch, [
        { from: 0, width: 1 },
        { from: laid.tree.keys, width: 1 },
        { from: laid.tree.sizes, width: 1 },
      ]),
    KidOut -> {
      let kid = fresh(held.emitter);
      let out = line(
        kid.emitter,
        Bytes::concat_all([
          writable,
          b"Word ",
          kid.name,
          b" = ",
          at(index),
          b"; ",
          at(index),
          b" = 0;",
        ]),
      );
      written_record(
        note_made(note_made(out, a), kid.name),
        [{ name: b"kid", ty: node_ty }, { name: b"node", ty: node_ty }],
        [{ kind: KBoxed, expr: kid.name, ty: TyOpen([]) }, node_value],
      )
    },
    KidBack -> {
      let kid = owned(held.emitter, nth_value(vals, 2));
      let max = owned(kid.emitter, nth_value(vals, 3));
      let old_max = fresh(max.emitter);
      let back = line(
        old_max.emitter,
        Bytes::concat_all([
          writable,
          b"Word ",
          old_max.name,
          b" = ",
          at(keys(index)),
          b"; ",
          at(keys(index)),
          b" = ",
          max.value.expr,
          b"; ply_dec(ctx, ",
          old_max.name,
          b"); ",
          at(index),
          b" = ",
          kid.value.expr,
          b"; ",
          at(sizes(index)),
          b" = ply_imm(",
          as_int(nth_value(vals, 4)),
          b");",
        ]),
      );
      written_as(back, a, TyOpen([]))
    },
    KidPut -> {
      let kid = owned(held.emitter, nth_value(vals, 2));
      let max = owned(kid.emitter, nth_value(vals, 3));
      let n = after(b"");
      let put = line(
        max.emitter,
        Bytes::concat_all([
          writable,
          shifted(index, n, b"1"),
          shifted(keys(index), n, b"1"),
          shifted(sizes(index), n, b"1"),
          at(index),
          b" = ",
          kid.value.expr,
          b"; ",
          at(keys(index)),
          b" = ",
          max.value.expr,
          b"; ",
          at(sizes(index)),
          b" = ply_imm(",
          as_int(nth_value(vals, 4)),
          b"); ",
          header(b"len"),
          b" += 1;",
        ]),
      );
      written_as(put, a, TyOpen([]))
    },
    KidDrop -> {
      let n = after(b" - 1");
      let next = Bytes::concat_all([index, b" + 1"]);
      let dropped = line(
        held.emitter,
        Bytes::concat_all([
          writable,
          b"ply_dec(ctx, ",
          at(index),
          b"); ply_dec(ctx, ",
          at(keys(index)),
          b"); ",
          shifted(next, n, b"-1"),
          shifted(keys(next), n, b"-1"),
          shifted(sizes(next), n, b"-1"),
          header(b"len"),
          b" -= 1;",
        ]),
      );
      written_as(dropped, a, TyOpen([]))
    },
    MapSwap -> {
      let root = sum_owned(held.emitter, nth_value(vals, 1), Zeroed);
      let old = fresh(root.emitter);
      let slot = at(ascii_of_int(laid.map.root));
      let swapped = line(
        old.emitter,
        Bytes::concat_all([
          b"if (",
          header(b"rc"),
          b" != 1) ",
          a,
          b" = rt_map_writable_p(ctx, ",
          a,
          b"); Word ",
          old.name,
          b" = ",
          slot,
          b"; ",
          slot,
          b" = ",
          root.value.expr,
          b"; ",
          header(laid.map.height),
          b" = (uint32_t)(",
          as_int(nth_value(vals, 2)),
          b"); ",
          header(b"len"),
          b" = (uint32_t)(",
          as_int(nth_value(vals, 3)),
          b");",
        ]),
      );
      written_record(
        note_made(note_made(swapped, a), old.name),
        [
          { name: b"map", ty: TyCon({ name: b"Map", args: [key, value] }) },
          { name: b"old", ty: TyCon({ name: b"Option", args: [node_ty] }) },
        ],
        [node_value, { kind: KSum(Zeroed), expr: old.name, ty: TyOpen([]) }],
      )
    },
    _ -> refused(held.emitter, b"a function of a map's node that reads it, written as a write"),
  }
}

/// The node `a`, held once, kept up to its entry `index`, and a new node of `kind` holding the
/// entries from `index` on: each run of words `runs` names, `width` words to an entry from word
/// `from`, moved across.
fn cut(
  emitter: Emitter,
  a: Bytes,
  index: Bytes,
  kind: Int,
  runs: List<{ from: Int, width: Int }>,
) -> WithValue = {
  let r = fresh(emitter);
  let rest = Bytes::concat_all([b"((int64_t)", header_of(a, b"len"), b" - ", index, b")"]);
  let moved = runs.fold(b"", |acc: Bytes, run: { from: Int, width: Int }| {
    let width = ascii_of_int(run.width);
    Bytes::concat_all([
      acc,
      b"memcpy(&",
      slot_of(r.name, ascii_of_int(run.from)),
      b", &",
      slot_of(a, Bytes::concat_all([ascii_of_int(run.from), b" + ", width, b" * ", index])),
      b", (size_t)(",
      width,
      b" * ",
      rest,
      b") * sizeof(Word)); ",
    ])
  });
  let written = line(
    r.emitter,
    Bytes::concat_all([
      b"if (",
      header_of(a, b"rc"),
      b" != 1) ",
      a,
      b" = rt_node_writable_p(ctx, ",
      a,
      b"); Word ",
      r.name,
      b" = rt_node_p(ctx, ",
      ascii_of_int(kind),
      b"); ",
      moved,
      header_of(r.name, b"len"),
      b" = (uint32_t)",
      rest,
      b"; ",
      header_of(a, b"len"),
      b" = (uint32_t)",
      index,
      b";",
    ]),
  );
  written_record(
    note_made(note_made(written, a), r.name),
    [{ name: b"left", ty: word_type() }, { name: b"right", ty: word_type() }],
    [{ kind: KBoxed, expr: a, ty: TyOpen([]) }, { kind: KBoxed, expr: r.name, ty: TyOpen([]) }],
  )
}

fn wrapped(emitter: Emitter, name: Bytes, v0: CValue, v1: CValue, t: Width) -> WithValue = {
  let u = unsigned_ctype(t);
  let a = as_num(v0, t);
  if name == b"rotr" || name == b"rotl" {
    // A rotation left is one right by the rest of the width.
    let k = bind(
      emitter,
      KInt,
      Bytes::concat_all([
        b"((",
        if name == b"rotl" { b"-" } else { b"" },
        b"((",
        as_int(v1),
        b") % ",
        ascii_of_int(t.bits),
        b")) % ",
        ascii_of_int(t.bits),
        b" + ",
        ascii_of_int(t.bits),
        b") % ",
        ascii_of_int(t.bits),
      ]),
    );
    bind(
      k.emitter,
      KNum(t),
      Bytes::concat_all([
        b"(",
        u,
        b")(",
        k.value.expr,
        b" == 0 ? (",
        u,
        b")(",
        a,
        b") : ((",
        u,
        b")(",
        a,
        b") >> ",
        k.value.expr,
        b") | ((",
        u,
        b")(",
        a,
        b") << (",
        ascii_of_int(t.bits),
        b" - ",
        k.value.expr,
        b")))",
      ]),
    )
  } else {
    let c = if name == b"wrap_add" { b"+" } else if name == b"wrap_sub" { b"-" } else { b"*" };
    // Below 32 bits C would promote the operands to `int`, where a product can overflow.
    bind(
      emitter,
      KNum(t),
      Bytes::concat_all([
        b"(",
        u,
        b")((uint64_t)(",
        u,
        b")(",
        a,
        b") ",
        c,
        b" (uint64_t)(",
        u,
        b")(",
        as_num(v1, t),
        b"))",
      ]),
    )
  }
}

/// A list's, a byte string's or an array's length, read off its header: an array holding its
/// elements in place counts its words a stride at a time.
fn length_of(name: Bytes, w: Bytes) -> Bytes =
  if name == b"Array::len" { Bytes::concat_all([b"ply_array_len(", w, b")"]) }
  else { Bytes::concat_all([b"(int64_t)ply_obj(", w, b")->len"]) }

/// A kind test: the header's field (or a bounds-tested byte) fast, the runtime's call slow, which raises on a wrong kind.
fn kind_tested(
  emitter: Emitter,
  name: Bytes,
  value: CValue,
  index: Option<CValue>,
) -> WithValue / {abort.raise} = {
  let t = bind(emitter, KBoxed, as_word(value));
  let out = fresh(t.emitter);
  let o1 = line(out.emitter, Bytes::concat_all([b"int64_t ", out.name, b" = 0;"]));
  let ok = fresh(o1);
  let kind = if name == b"List::len" { b"5" }
  else if name == b"Array::len" { b"15" }
  else { b"10" };
  let o2 = line(
    ok.emitter,
    Bytes::concat_all([
      b"int ",
      ok.name,
      b" = (!ply_is_imm(",
      t.value.expr,
      b") && ",
      t.value.expr,
      b" != 0 && ply_obj(",
      t.value.expr,
      b")->kind == ",
      kind,
      b");",
    ]),
  );
  let body = match index {
    Some(iv) -> {
      let idx = bind(o2, KInt, as_int(iv));
      let opened = line(
        idx.emitter,
        Bytes::concat_all([
          b"if (",
          ok.name,
          b" && (uint64_t)",
          idx.value.expr,
          b" < (uint64_t)ply_obj(",
          t.value.expr,
          b")->len) { ",
          out.name,
          b" = (int64_t)(ply_bytes(",
          t.value.expr,
          b"))[",
          idx.value.expr,
          b"]; } else {",
        ]),
      );
      line(
        check(
          line(
            line(indent(opened), Bytes::concat_all([b"ply_inc(", t.value.expr, b");"])),
            Bytes::concat_all([
              b"Word r = ",
              builtin_call_over(name, [
                t.value.expr,
                Bytes::concat_all([
                  b"(ply_fits_imm(",
                  idx.value.expr,
                  b") ? ply_imm(",
                  idx.value.expr,
                  b") : rt_box_int_p(ctx, ",
                  idx.value.expr,
                  b"))",
                ]),
              ]),
              b";",
            ]),
          ),
        ),
        Bytes::concat_all([out.name, b" = ply_imm_value(r);"]),
      )
    },
    None -> {
      let opened = line(
        o2,
        Bytes::concat_all([
          b"if (",
          ok.name,
          b") { ",
          out.name,
          b" = ",
          length_of(name, t.value.expr),
          b"; } else {",
        ]),
      );
      line(
        check(
          line(
            line(indent(opened), Bytes::concat_all([b"ply_inc(", t.value.expr, b");"])),
            Bytes::concat_all([b"Word r = ", builtin_call_over(name, [t.value.expr]), b";"]),
          ),
        ),
        Bytes::concat_all([out.name, b" = ply_imm_value(r);"]),
      )
    },
  };
  { emitter: close(body), value: { kind: KInt, expr: out.name, ty: TyOpen([]) } }
}

/// `Bytes::concat_all([a, b, ..])` joins the pieces without building the list.
fn inline_join(
  emitter: Emitter,
  args: List<Code>,
  params: List<EmitParam>,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  match args.at(0) {
    None -> None,
    Some(x) -> match x.node {
      NList(l) -> match items(emitter, l.items, params, 0, []) {
        None -> None,
        Some(w) -> {
          let arr = fresh(w.emitter);
          let e = line(
            arr.emitter,
            Bytes::concat_all([
              b"Word ",
              arr.name,
              b"[] = {",
              if w.names.len() == 0 { b"0" } else { bytes_join(w.names, b", ") },
              b"};",
            ]),
          );
          let o = bind(
            e,
            KBoxed,
            Bytes::concat_all([
              b"rt_bytes_join_p(ctx, (Word)(intptr_t)",
              arr.name,
              b", ",
              ascii_of_int(l.items.len()),
              b")",
            ]),
          );
          Some({ emitter: check(o.emitter), value: o.value })
        },
      },
      _ -> match expr(notail(emitter), x, params) {
        None -> None,
        Some(o) -> Some(builtin_call(site(o.emitter, span), b"Bytes::concat_all", [o.value])),
      },
    },
  }

/// `Bytes::u32_le` reads four bytes through `memcpy`, which C compilers lower to one unaligned load.
fn inline_at(
  emitter: Emitter,
  args: List<Code>,
  params: List<EmitParam>,
  wide: Bool,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  match args.at(0) {
    None -> None,
    Some(b0) -> match args.at(1) {
      None -> None,
      Some(i0) -> match typed(b0, expr(notail(emitter), b0, params)) {
        None -> None,
        // The bytes are read before the index and bound after: the index may read `b` at its last use and null it.
        Some(bv0) -> {
          let bv = secure_across(bv0.emitter, bv0.value, i0, params);
          match expr(notail(bv.emitter), i0, params) {
            None -> None,
            // Over bytes of unfixed kind, `Bytes::u32_le` is the runtime's call.
            Some(iv0) -> {
              let iv = { emitter: site(iv0.emitter, span), value: iv0.value };
              if bv.value.ty != TyBytes {
                if wide { Some(builtin_call(iv.emitter, b"Bytes::u32_le", [bv.value, iv.value])) }
                else { Some(kind_tested(iv.emitter, b"Bytes::at", bv.value, Some(iv.value))) }
              } else {
                let t = bind(iv.emitter, KBoxed, as_word(bv.value));
                let idx = bind(t.emitter, KInt, as_int(iv.value));
                let g = line(
                  idx.emitter,
                  Bytes::concat_all([
                    b"if (",
                    // Four bytes from an index are in range where the index is at most the length
                    // less four: adding to the index would wrap a negative one into range.
                    if wide {
                      Bytes::concat_all([
                        b"(uint64_t)ply_obj(",
                        t.value.expr,
                        b")->len < 4 || (uint64_t)",
                        idx.value.expr,
                        b" > (uint64_t)ply_obj(",
                        t.value.expr,
                        b")->len - 4",
                      ])
                    } else {
                      Bytes::concat_all([
                        b"(uint64_t)",
                        idx.value.expr,
                        b" >= (uint64_t)ply_obj(",
                        t.value.expr,
                        b")->len",
                      ])
                    },
                    b") { ply_inc(",
                    t.value.expr,
                    b"); ",
                    // The index as the word it is: one past an immediate's range is boxed, not wrapped
                    // into another that may be in range.
                    builtin_call_over(if wide { b"Bytes::u32_le" } else { b"Bytes::at" }, [
                      t.value.expr,
                      as_word(idx.value),
                    ]),
                    b"; ",
                    leaving(idx.emitter),
                    b" }",
                  ]),
                );
                if wide {
                  let w = fresh(g);
                  Some({
                    emitter: line(
                      w.emitter,
                      Bytes::concat_all([
                        b"uint32_t ",
                        w.name,
                        b"; memcpy(&",
                        w.name,
                        b", ply_bytes(",
                        t.value.expr,
                        b") + ",
                        idx.value.expr,
                        b", 4);",
                      ]),
                    ),
                    value: {
                      kind: KNum({ bits: 32, signed: false }),
                      expr: Bytes::concat_all([b"ply_le32(", w.name, b")"]),
                      ty: TyOpen([]),
                    },
                  })
                } else {
                  Some(
                    bind(
                      g,
                      KInt,
                      Bytes::concat_all([
                        b"(int64_t)(ply_bytes(",
                        t.value.expr,
                        b"))[",
                        idx.value.expr,
                        b"]",
                      ]),
                    ),
                  )
                }
              }
            },
          }
        },
      },
    },
  }

/// Over an array of known kind, a bounds-tested load; anything else is the runtime's call.
fn inline_get(
  emitter: Emitter,
  args: List<Code>,
  params: List<EmitParam>,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  match args.at(0) {
    None -> None,
    Some(a0) -> match args.at(1) {
      None -> None,
      Some(i0) -> match expr(notail(emitter), a0, params) {
        None -> None,
        Some(av0) -> match av0.value.ty {
          TyArr(Some(element)) -> {
            // The array is read before the index and bound after, as `inline_at` reads its bytes.
            let av = secure_across(av0.emitter, av0.value, i0, params);
            match expr(notail(av.emitter), i0, params) {
              None -> None,
              Some(iv0) -> {
                let t = bind(site(iv0.emitter, span), KBoxed, as_word(av.value));
                let idx = bind(t.emitter, KInt, as_int(iv0.value));
                let g = line(
                  idx.emitter,
                  Bytes::concat_all([
                    b"if ((uint64_t)",
                    idx.value.expr,
                    b" >= (uint64_t)ply_array_len(",
                    t.value.expr,
                    b")) { ply_inc(",
                    t.value.expr,
                    b"); ",
                    builtin_call_over(b"Array::get", [
                      t.value.expr,
                      Bytes::concat_all([
                        b"(ply_fits_imm(",
                        idx.value.expr,
                        b") ? ply_imm(",
                        idx.value.expr,
                        b") : rt_box_int_p(ctx, ",
                        idx.value.expr,
                        b"))",
                      ]),
                    ]),
                    b"; ",
                    leaving(idx.emitter),
                    b" }",
                  ]),
                );
                Some(element_read(g, t.value.expr, idx.value.expr, element))
              },
            }
          },
          _ -> None,
        },
      },
    },
  }

/// How the call of an `Array` builtin at `at` holds the elements of the type it settled, where it
/// settled one: as a record's field `e` of that type is held.
fn array_element_at(emitter: Emitter, at: Span) -> Option<FieldTy> =
  match emitter.typed.get(span_key(at)) {
    None -> None,
    Some(t) -> match t.args.at(0) {
      Some(ty) -> if has_vars(ty) { None } else { laid_field(b"e", ty) },
      None -> None,
    },
  }

/// Whether an array holds an element held as `e` in place: a record, a scalar as its bits, or an
/// `Option` as its payload's word; any other element is its word.
fn element_in_place(e: FieldTy) -> Bool =
  match e.ty { TyRec(_) -> true, _ -> raw_slot(e.kind) || e.kind == KSum(Zeroed) }

/// Whether an element held as `e` is a scalar's bits, which hold no count.
fn element_raw(e: FieldTy) -> Bool = match e.ty { TyRec(_) -> false, _ -> raw_slot(e.kind) }

/// `held`, an element as `element_held` holds it, as the word the runtime's builtin takes: a scalar
/// boxed and an `Option` its object.
fn element_word(e: FieldTy, held: CValue) -> Bytes =
  if element_raw(e) || e.kind == KSum(Zeroed) { as_word(held) } else { held.expr }

/// The words of an array an element held as `e` takes.
fn element_stride(e: FieldTy) -> Int = if element_in_place(e) { laid_of([e]).width } else { 1 }

/// An array of `n` elements held as `e`, allocated as the type lays one out: its stride, its
/// element's shape and, where it counts some words and not others, a bitmap saying which. Its
/// elements are for the caller to write; it is `a`, a local already declared.
fn array_allocated(emitter: Emitter, e: FieldTy, a: Bytes, n: Bytes) -> Emitter =
  if !element_in_place(e) {
    line(emitter, Bytes::concat_all([a, b" = rt_alloc_p(ctx, 15, ", n, b", 0, 0);"]))
  } else {
    let l = laid_of([e]);
    let s = shape_of_fields(emitter, [e]);
    let stride = ascii_of_int(l.width);
    let mixed = l.counted.len() > 0;
    let width = fresh(s.emitter);
    let allocated = line(
      line(
        line(
          width.emitter,
          Bytes::concat_all([b"int64_t ", width.name, b" = ", n, b" * ", stride, b";"]),
        ),
        Bytes::concat_all([
          a,
          b" = rt_alloc_p(ctx, 15, ",
          width.name,
          b", ",
          shape_text(s.i),
          b", ",
          if mixed { b"6" } else { b"5" },
          b");",
        ]),
      ),
      Bytes::concat_all([b"ply_obj(", a, b")->aux = ", stride, b";"]),
    );
    if !mixed { allocated } else {
      let i = fresh(allocated);
      let opened = indent(
        line(
          line(
            i.emitter,
            Bytes::concat_all([
              b"memset(ply_words(",
              a,
              b") + ",
              width.name,
              b", 0, (size_t)((",
              width.name,
              b" + 63) / 64) * 8);",
            ]),
          ),
          Bytes::concat_all([
            b"for (int64_t ",
            i.name,
            b" = 0; ",
            i.name,
            b" < ",
            n,
            b"; ",
            i.name,
            b"++) {",
          ]),
        ),
      );
      outdent(
        line(
          l.counted.fold(opened, |acc: Emitter, c: Int|
            line(
              acc,
              Bytes::concat_all([
                b"{ int64_t b = ",
                i.name,
                b" * ",
                stride,
                b" + ",
                ascii_of_int(c),
                b"; ply_words(",
                a,
                b")[",
                width.name,
                b" + b / 64] |= (Word)1 << (b % 64); }",
              ]),
            )),
          b"}",
        ),
      )
    }
  }

/// The value `v` holds, written as element `i` of the array `a` holds an element held as `e`:
/// a record copied in place, a scalar as its bits, any other as its word; it takes `v`'s count.
fn element_written(a: Bytes, i: Bytes, e: FieldTy, v: Bytes) -> Bytes =
  match e.ty {
    TyRec(inner) ->
      Bytes::concat_all([
        b"ply_embed(ctx, ",
        a,
        b", (int)(",
        i,
        b" * ",
        ascii_of_int(element_stride(e)),
        b"), ",
        v,
        b", ",
        ascii_of_int(laid_of(inner).tail),
        b");",
      ]),
    _ -> if raw_slot(e.kind) {
      raw_store(
        a,
        Bytes::concat_all([i, b" * ", ascii_of_int(element_stride(e))]),
        { kind: e.kind, expr: v, ty: TyOpen([]) },
        e.kind,
      )
    } else { Bytes::concat_all([b"ply_words(", a, b")[", i, b"] = ", v, b";"]) },
  }

/// `v` as element `element_written` writes: a record's or any word's own word, which the array
/// takes, or a scalar's bits in a local of its kind.
fn element_held(emitter: Emitter, e: FieldTy, v: CValue) -> WithValue =
  match e.ty {
    TyRec(_) -> owned(emitter, v),
    _ -> if raw_slot(e.kind) { held_raw(emitter, v, e.kind) } else { owned(emitter, v) },
  }

/// What the element at `i` of the array `a` holds as `e` lets go of before another is written over
/// it.
fn element_dropped(a: Bytes, i: Bytes, e: FieldTy) -> Bytes =
  match e.ty {
    TyRec(_) ->
      Bytes::concat_all([
        b"ply_drop_embedded(ctx, ",
        a,
        b", (int)(",
        i,
        b" * ",
        ascii_of_int(element_stride(e)),
        b"));",
      ]),
    _ -> if raw_slot(e.kind) { b"" }
    else { Bytes::concat_all([b"ply_dec(ctx, ply_words(", a, b")[", i, b"]);"]) },
  }

/// `Array::new(n, x)`, laid out as an array of `e`'s type is: `n` holders of `x`, which it takes.
/// A length below zero or past what an array holds is the runtime's to refuse.
fn array_new(emitter: Emitter, e: FieldTy, n: CValue, x: CValue) -> WithValue / {abort.raise} = {
  let count = bind(emitter, KInt, as_int(n));
  let k = count.value.expr;
  let held = element_held(count.emitter, e, x);
  let v = held.value.expr;
  let counted = !element_raw(e);
  let made = bind(held.emitter, KBoxed, b"0");
  let a = made.value.expr;
  // Past `Array::new`'s `requires`, or past a length one object holds, the runtime refuses it.
  let limit = ascii_of_int(min(67108864, 4294967295 / element_stride(e)));
  let refused = indent(
    line(made.emitter, Bytes::concat_all([b"if (", k, b" < 0 || ", k, b" > ", limit, b") {"])),
  );
  let to_runtime = line(
    refused,
    Bytes::concat_all([
      a,
      b" = ",
      builtin_call_over(b"Array::new", [
        Bytes::concat_all([
          b"(ply_fits_imm(",
          k,
          b") ? ply_imm(",
          k,
          b") : rt_box_int_p(ctx, ",
          k,
          b"))",
        ]),
        element_word(e, held.value),
      ]),
      b";",
    ]),
  );
  let laid = array_allocated(indent(line(outdent(to_runtime), b"} else {")), e, a, k);
  let i = fresh(laid);
  let shared = if counted {
    line(
      i.emitter,
      Bytes::concat_all([
        b"if (",
        k,
        b" == 0) { ply_dec(ctx, ",
        v,
        b"); } else { for (int64_t ",
        i.name,
        b" = 1; ",
        i.name,
        b" < ",
        k,
        b"; ",
        i.name,
        b"++) ply_inc(",
        v,
        b"); }",
      ]),
    )
  } else { i.emitter };
  let filled = line(
    shared,
    Bytes::concat_all([
      b"for (int64_t ",
      i.name,
      b" = 0; ",
      i.name,
      b" < ",
      k,
      b"; ",
      i.name,
      b"++) { ",
      element_written(a, i.name, e, v),
      b" }",
    ]),
  );
  {
    emitter: note_made(check(line(outdent(filled), b"}")), a),
    value: { kind: KBoxed, expr: a, ty: TyArr(Some(e)) },
  }
}

/// `Array::set(xs, i, v)`, laid out as an array of `e`'s type is: written in place where `xs` is its
/// only holder and into a copy otherwise, each counted word of which is held once more. An index
/// out of range is the runtime's to refuse. Takes `xs` and `v`.
fn array_set(
  emitter: Emitter,
  e: FieldTy,
  xs: CValue,
  iv: CValue,
  v0: CValue,
) -> WithValue / {abort.raise} = {
  let arr = owned(emitter, xs);
  let idx = bind(arr.emitter, KInt, as_int(iv));
  let held = element_held(idx.emitter, e, v0);
  let v = held.value.expr;
  let made = bind(held.emitter, KBoxed, arr.value.expr);
  let a = made.value.expr;
  let i = idx.value.expr;
  let stride = element_stride(e);
  let to_runtime = line(
    indent(
      line(
        made.emitter,
        Bytes::concat_all([b"if ((uint64_t)", i, b" >= (uint64_t)ply_array_len(", a, b")) {"]),
      ),
    ),
    Bytes::concat_all([
      a,
      b" = ",
      builtin_call_over(b"Array::set", [
        a,
        Bytes::concat_all([
          b"(ply_fits_imm(",
          i,
          b") ? ply_imm(",
          i,
          b") : rt_box_int_p(ctx, ",
          i,
          b"))",
        ]),
        element_word(e, held.value),
      ]),
      b";",
    ]),
  );
  let copy = fresh(indent(line(outdent(to_runtime), b"} else {")));
  let j = fresh(copy.emitter);
  // Each word of an element the array counts, held once more by the copy.
  let counts = if element_in_place(e) {
    laid_of([e]).counted.map(|c: Int|
      Bytes::concat_all([
        b"ply_inc(ply_words(",
        copy.name,
        b")[",
        j.name,
        b" * ",
        ascii_of_int(stride),
        b" + ",
        ascii_of_int(c),
        b"]);",
      ]))
  } else { [Bytes::concat_all([b"ply_inc(ply_words(", copy.name, b")[", j.name, b"]);"])] };
  let copied = line(
    line(
      j.emitter,
      Bytes::concat_all([
        b"int in_place = ply_obj(",
        a,
        b")->rc == 1; int64_t n = ply_array_len(",
        a,
        b");",
      ]),
    ),
    Bytes::concat_all([
      b"if (!in_place) { PlyObj *o = ply_obj(",
      a,
      b"); Word ",
      copy.name,
      b" = rt_alloc_p(ctx, 15, o->len, o->layout, o->flags); ",
      b"ply_obj(",
      copy.name,
      b")->aux = o->aux; ",
      b"memcpy(ply_words(",
      copy.name,
      b"), ply_words(",
      a,
      b"), (size_t)(o->len + ((o->flags & PLY_MIXED) ? (o->len + 63) / 64 : 0)) * 8); ",
      b"for (int64_t ",
      j.name,
      b" = 0; ",
      j.name,
      b" < n; ",
      j.name,
      b"++) { ",
      Bytes::concat_all(counts),
      b" } ",
      b"ply_dec(ctx, ",
      a,
      b"); ",
      a,
      b" = ",
      copy.name,
      b"; }",
    ]),
  );
  let written = line(
    line(
      line(copied, b"rt_note_update_p(ctx, in_place, in_place ? 0 : n);"),
      element_dropped(a, i, e),
    ),
    element_written(a, i, e, v),
  );
  {
    emitter: note_made(check(line(outdent(written), b"}")), a),
    value: { kind: KBoxed, expr: a, ty: TyArr(Some(e)) },
  }
}

/// `Array::of_list(xs)`, laid out as an array of `e`'s type is: each element of the list written as
/// the array holds it. Takes `xs`.
fn array_of_list(emitter: Emitter, e: FieldTy, xs: CValue) -> WithValue / {abort.raise} = {
  let list = owned(emitter, xs);
  let l = list.value.expr;
  let count = bind(list.emitter, KInt, length_of(b"List::len", l));
  let k = count.value.expr;
  let made = bind(count.emitter, KBoxed, b"0");
  let a = made.value.expr;
  let limit = ascii_of_int(4294967295 / element_stride(e));
  let to_runtime = line(
    indent(line(made.emitter, Bytes::concat_all([b"if (", k, b" > ", limit, b") {"]))),
    Bytes::concat_all([a, b" = ", builtin_call_over(b"Array::of_list", [l]), b";"]),
  );
  let laid = array_allocated(indent(line(outdent(to_runtime), b"} else {")), e, a, k);
  let i = fresh(laid);
  let w = fresh(i.emitter);
  let raw = element_raw(e);
  let word = { kind: KBoxed, expr: w.name, ty: TyOpen([]) };
  let at = Bytes::concat_all([i.name, b" * ", ascii_of_int(element_stride(e))]);
  // A scalar arrives as its word, read at its kind: a `Decimal` as its two words.
  let stored = if e.kind == KDec { raw_store(a, at, word, KDec) } else {
    Bytes::concat_all([b"ply_words(", a, b")[", at, b"] = ", field_word(word, e.kind), b";"])
  };
  let filled = line(
    line(
      w.emitter,
      Bytes::concat_all([
        b"for (int64_t ",
        i.name,
        b" = 0; ",
        i.name,
        b" < ",
        k,
        b"; ",
        i.name,
        b"++) { Word ",
        w.name,
        b" = rt_list_at_p(ctx, ",
        l,
        b", ",
        i.name,
        b"); ",
        if raw { Bytes::concat_all([stored, b" ply_dec(ctx, ", w.name, b");"]) }
        // An `Option` arrives as its object and is held as its payload's word.
        else if e.kind == KSum(Zeroed) {
          Bytes::concat_all([
            b"ply_words(",
            a,
            b")[",
            i.name,
            b"] = rt_maybe_open_p(ctx, ",
            w.name,
            b");",
          ])
        } else { element_written(a, i.name, e, w.name) },
        b" }",
      ]),
    ),
    Bytes::concat_all([b"ply_dec(ctx, ", l, b");"]),
  );
  {
    emitter: note_made(check(line(outdent(filled), b"}")), a),
    value: { kind: KBoxed, expr: a, ty: TyArr(Some(e)) },
  }
}

/// Element `i` of array `a`, whose elements are held as a record's field `e` of their type is: a
/// record in place as the address of its header there, a scalar as its bits, anything else as its
/// word, each held as the array's element is once read.
fn element_read(emitter: Emitter, a: Bytes, i: Bytes, element: FieldTy) -> WithValue = {
  let r = fresh(emitter);
  match element.ty {
    TyRec(fs) -> {
      let l = laid_of(fs);
      let loaded = line(
        r.emitter,
        Bytes::concat_all([
          b"Word ",
          r.name,
          b" = (Word)(intptr_t)(ply_words(",
          a,
          b") + ",
          i,
          b" * ",
          ascii_of_int(2 + l.width + l.tail),
          b"); ply_inc(",
          r.name,
          b");",
        ]),
      );
      {
        emitter: note_holder(loaded, r.name),
        value: { kind: KBoxed, expr: r.name, ty: element.ty },
      }
    },
    _ -> if raw_slot(element.kind) {
      let at = if raw_words(element.kind) == 1 { i }
      else { Bytes::concat_all([b"(", i, b") * ", ascii_of_int(raw_words(element.kind))]) };
      let loaded = line(
        r.emitter,
        Bytes::concat_all([
          ctype(element.kind),
          b" ",
          r.name,
          b" = ",
          raw_at(a, at, element.kind),
          b";",
        ]),
      );
      { emitter: loaded, value: { kind: element.kind, expr: r.name, ty: TyOpen([]) } }
    } else {
      let loaded = line(
        r.emitter,
        Bytes::concat_all([
          b"Word ",
          r.name,
          b" = ply_words(",
          a,
          b")[",
          i,
          b"]; ply_inc(",
          r.name,
          b");",
        ]),
      );
      {
        emitter: note_holder(loaded, r.name),
        value: { kind: word_kind(element.kind), expr: r.name, ty: element.ty },
      }
    },
  }
}

fn is_inlined(name: Bytes) -> Bool =
  name == b"List::len" || name == b"Bytes::len" || name == b"Bytes::at" || name == b"Bytes::u32_le"
    || name == b"Bytes::concat_all"

/// Callback builtins that are not a plain runtime call: `List::fold` may fuse, `iterate` may loop in place.
fn is_callback(name: Bytes) -> Bool = name == b"List::fold" || name == b"iterate"

/// Calls of one builtin share an index; constants deliberately do not.
fn builtin_of(emitter: Emitter, name: Bytes) -> { emitter: Emitter, i: Int } =
  match range(0, emitter.called_builtins.len()).fold(None, |acc: Option<Int>, i: Int|
      match emitter.called_builtins.at(i) {
        Some(x) -> if x == name { Some(i) } else { acc },
        None -> acc,
      }) {
    Some(i) -> { emitter: emitter, i: i },
    None ->
      {
        emitter: {
          out: emitter.out,
          temp_count: emitter.temp_count,
          unboxed: emitter.unboxed,
          indent: emitter.indent,
          reads: emitter.reads,
          shapes: emitter.shapes,
          built: emitter.built,
          module: emitter.module,
          base: emitter.base,
          count_locals: emitter.count_locals,
          here: emitter.here,
          imports: emitter.imports,
          consts: emitter.consts,
          ctors: emitter.ctors,
          lambda_bodies: emitter.lambda_bodies,
          lambdas: emitter.lambdas,
          owner: emitter.owner,
          builtins: emitter.builtins,
          called_builtins: emitter.called_builtins.push(name),
          fields: emitter.fields,
          released: emitter.released,
          reuse_widths: emitter.reuse_widths,
          alias: emitter.alias,
          by_root: emitter.by_root,
          tail: emitter.tail,
          calls: emitter.calls,
          generics: emitter.generics,
          refused: emitter.refused,
          deferred: emitter.deferred,
          deferred_locals: emitter.deferred_locals,
          performs: emitter.performs,
          handles: emitter.handles,
          landing: emitter.landing,
          effects: emitter.effects,
          release: emitter.release,
          pinned: emitter.pinned,
          bound: emitter.bound,
          group: emitter.group,
          operands: emitter.operands,
          typed: emitter.typed,
          answer: emitter.answer,
          site_root: emitter.site_root,
          lent: emitter.lent,
          written: emitter.written,
          slices: emitter.slices,
          sums: emitter.sums,
          leaves: emitter.leaves,
        },
        i: emitter.called_builtins.len(),
      },
  }

/// The runtime's helper for a builtin, named for it. An elaboration's `?` is spelled out, since no C
/// name holds one, and a function of a type is its type in lower case, `_` and its name.
pub fn builtin_helper(name: Bytes) -> Bytes / {abort.raise} =
  if name.starts_with(b"?") { b"builtin_elaborated_".concat(name.slice(1, name.len())) } else {
    match member_of(name) {
      Some(m) ->
        Bytes::concat_all([
          b"builtin_",
          Bytes::of_string(String::of_bytes(m.of).ascii_lower()),
          b"_",
          m.member,
        ]),
      None -> b"builtin_".concat(name),
    }
  }

/// A call of a builtin's helper over the words it takes, each already the callee's.
fn builtin_call_over(name: Bytes, words: List<Bytes>) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    builtin_helper(name),
    b"_p(ctx",
    words.fold(b"", |acc: Bytes, word: Bytes| Bytes::concat_all([acc, b", ", word])),
    b")",
  ])

/// Two passes: every argument evaluated, the site stored, then each duplicated; a compiled call interleaves (`args_carried`).
fn args_owned_at(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  span: Span,
) -> Option<{ emitter: Emitter, names: List<Bytes> }> / {abort.raise} =
  match args_evaled(emitter, codes, params, 0, []) {
    None -> None,
    Some(e) ->
      Some(
        e.vals.fold(
          { emitter: site(e.emitter, span), names: [] },
          |a: { emitter: Emitter, names: List<Bytes> }, value: CValue| {
            let w = owned(a.emitter, value);
            { emitter: w.emitter, names: a.names.push(w.value.expr) }
          },
        ),
      ),
  }

fn args_owned(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  i: Int,
  acc: List<Bytes>,
) -> Option<{ emitter: Emitter, names: List<Bytes> }> / {abort.raise} =
  match args_evaled(emitter, codes, params, i, []) {
    None -> None,
    Some(e) ->
      Some(
        e.vals.fold(
          { emitter: e.emitter, names: acc },
          |a: { emitter: Emitter, names: List<Bytes> }, value: CValue| {
            let w = owned(a.emitter, value);
            { emitter: w.emitter, names: a.names.push(w.value.expr) }
          },
        ),
      ),
  }

/// A builtin called over what its arguments evaluated to, each duplicated here.
fn builtin_call(emitter: Emitter, name: Bytes, vals: List<CValue>) -> WithValue / {abort.raise} = {
  let w = vals.fold(
    { emitter: emitter, names: [] },
    |a: { emitter: Emitter, names: List<Bytes> }, value: CValue| {
      let o = owned(a.emitter, value);
      { emitter: o.emitter, names: a.names.push(o.value.expr) }
    },
  );
  let o = bind(w.emitter, KBoxed, builtin_call_over(name, w.names));
  { emitter: check(o.emitter), value: o.value }
}

/// Whatever the callee evaluates to, called: by its type's convention where its node's type holds
/// a value apart from a word, and through the runtime otherwise. The callee is duplicated, then
/// each argument as evaluated.
fn call_value(
  emitter: Emitter,
  func: Code,
  args: List<Code>,
  params: List<EmitParam>,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  match expr(notail(emitter), func, params) {
    None -> None,
    Some(f) -> {
      let fo = owned(calling(f.emitter, f.value, params), f.value);
      let convention = called_convention(fo.emitter, func, args.len());
      let typed = typed_convention(convention);
      match args_carried(
          fo.emitter,
          args,
          params,
          if typed { convention.params } else { [] },
          0,
          [],
        ) {
        None -> None,
        Some(w) -> if typed {
          Some(called_by_type(w.emitter, fo.value.expr, convention, w.names, span, emitter.leaves))
        } else {
          let arr = fresh(w.emitter);
          let e = line(
            arr.emitter,
            Bytes::concat_all([
              b"Word ",
              arr.name,
              b"[] = {",
              if w.names.len() == 0 { b"0" } else { bytes_join(w.names, b", ") },
              b"};",
            ]),
          );
          let o = bind(
            site(e, span),
            KBoxed,
            Bytes::concat_all([
              b"rt_call_p(ctx, ",
              fo.value.expr,
              b", (Word)(intptr_t)",
              arr.name,
              b", ",
              ascii_of_int(args.len()),
              b")",
            ]),
          );
          Some({ emitter: check(o.emitter), value: o.value })
        },
      }
    },
  }

/// The call of the closure `f`, of which this scope holds a count, with `names`, its arguments'
/// carried values as `c` carries them: through its typed entry where the closure's own convention
/// is `c`, and through the runtime, every value made a word, where it is another or no compiled
/// closure. A record answer is held back as the fields it came back as, and a sum's as its cases
/// where `leaves` says they are taken so.
fn called_by_type(
  emitter: Emitter,
  f: Bytes,
  c: Convention,
  names: List<Bytes>,
  span: Span,
  leaves: Bool,
) -> WithValue = {
  let back = written_back(c.ret);
  let ret = returned_kind(c.ret);
  let r = fresh(emitter);
  let outs = back.fold(
    { emitter: r.emitter, names: [] },
    |acc: { emitter: Emitter, names: List<Bytes> }, b: FieldTy| {
      let o = fresh(acc.emitter);
      { emitter: o.emitter, names: acc.names.push(o.name) }
    },
  );
  let arr = fresh(outs.emitter);
  let word = fresh(arr.emitter);
  let declared = line(
    site(word.emitter, span),
    Bytes::concat_all([
      carried_type(ret),
      b" ",
      r.name,
      b" = ",
      zero_of(ret),
      b";",
      range(0, back.len()).fold(b"", |t: Bytes, k: Int|
        Bytes::concat_all([
          t,
          b" ",
          ctype(nth_field(back, k).kind),
          b" ",
          nth_bytes(outs.names, k),
          b" = ",
          zero_of(nth_field(back, k).kind),
          b";",
        ])),
    ]),
  );
  let by_type = line(
    indent(line(declared, Bytes::concat_all([b"if (", called_typed(f, c), b") {"]))),
    Bytes::concat_all([
      r.name,
      b" = ((",
      typed_entry_type(c),
      b")(intptr_t)",
      descriptor_of(f),
      b"[1])(ctx, ",
      f,
      names.fold(b"", |acc: Bytes, nm: Bytes| Bytes::concat_all([acc, b", ", nm])),
      outs.names.fold(b"", |acc: Bytes, nm: Bytes| Bytes::concat_all([acc, b", &", nm])),
      b"); ply_dec(ctx, ",
      f,
      b");",
    ]),
  );
  let words = convention_words(outdent(by_type), c, names, leaving(by_type));
  let by_words = line(
    line(
      indent(line(words.emitter, b"} else {")),
      Bytes::concat_all([
        words.prep,
        b"Word ",
        arr.name,
        b"[] = {",
        if words.words.len() == 0 { b"0" } else { bytes_join(words.words, b", ") },
        b"}; Word ",
        word.name,
        b" = rt_call_p(ctx, ",
        f,
        b", (Word)(intptr_t)",
        arr.name,
        b", ",
        ascii_of_int(c.params.len()),
        b");",
      ]),
    ),
    match c.ret {
      Whole(KBoxed) -> Bytes::concat_all([r.name, b" = ", word.name, b";"]),
      Whole(KSum(spec)) ->
        Bytes::concat_all([
          b"if (!ctx->failed) ",
          r.name,
          b" = ",
          sum_helper(spec, b"open"),
          b"(ctx, ",
          word.name,
          b");",
        ]),
      Whole(k) ->
        Bytes::concat_all([
          b"if (!ctx->failed) { ",
          r.name,
          b" = ",
          as_kind({ kind: KBoxed, expr: word.name, ty: TyOpen([]) }, k),
          b"; ply_dec(ctx, ",
          word.name,
          b"); }",
        ]),
      // The answer's object is opened into its constructor's index and argument's values.
      Cases(sc) -> {
        let opened = Bytes::concat_all([word.name, b"_s"]);
        Bytes::concat_all([
          b"if (!ctx->failed) { ",
          ctype(KSum(sc.spec)),
          b" ",
          opened,
          b" = ",
          sum_helper(sc.spec, b"open"),
          b"(ctx, ",
          word.name,
          b"); ",
          sum_opening(sc, opened, r.name, outs.names),
          b" }",
        ])
      },
      // The answer's word is the record's: its leaves are loaded, each counted one counted again.
      Fields(fs) -> {
        let loads = leaf_loads(word.name, fs);
        let locals = push_front(
          { ..nth_value(loads, 0), expr: r.name },
          range(1, loads.len()).map(|k: Int|
            { ..nth_value(loads, k), expr: nth_bytes(outs.names, k - 1) }),
        );
        Bytes::concat_all([
          b"if (!ctx->failed) { ",
          range(0, loads.len()).fold(b"", |t: Bytes, k: Int|
            Bytes::concat_all([
              t,
              nth_value(locals, k).expr,
              b" = ",
              nth_value(loads, k).expr,
              b"; ",
            ])),
          counted_incs(locals),
          nth_bytes(outs.names, back.len() - 1),
          b" = ",
          word.name,
          b"; }",
        ])
      },
    },
  );
  let closed = check(line(outdent(by_words), b"}"));
  match c.ret {
    Cases(sc) ->
      sum_answer(
        closed,
        leaves,
        sc,
        r.name,
        range(0, back.len()).map(|k: Int|
          { kind: nth_field(back, k).kind, expr: nth_bytes(outs.names, k), ty: TyOpen([]) }),
      ),
    Fields(fs) ->
      held_record(
        closed,
        fs,
        push_front(
          { kind: ret, expr: r.name, ty: nth_field(record_leaves(fs), 0).ty },
          range(0, back.len() - 1).map(|k: Int|
            {
              kind: nth_field(back, k).kind,
              expr: nth_bytes(outs.names, k),
              ty: nth_field(back, k).ty,
            }),
        ),
        nth_bytes(outs.names, back.len() - 1),
      ),
    Whole(k) ->
      {
        emitter: if counted(k) { note_made(closed, r.name) } else { closed },
        value: { kind: k, expr: r.name, ty: TyOpen([]) },
      },
  }
}

/// The words the runtime is handed for `names`, the carried values of arguments carried as `c`
/// says: a value its word, a record's fields its word, made of them where it was never made.
fn convention_words(
  emitter: Emitter,
  c: Convention,
  names: List<Bytes>,
  fail: Bytes,
) -> { emitter: Emitter, prep: Bytes, words: List<Bytes> } = {
  let walked = c.params.fold(
    { emitter: emitter, prep: b"", words: [], at: 0 },
    |acc: { emitter: Emitter, prep: Bytes, words: List<Bytes>, at: Int }, p: Carrier|
      match p {
        Whole(KBoxed) -> { ..acc, words: acc.words.push(nth_bytes(names, acc.at)), at: acc.at + 1 },
        Whole(KSum(spec)) ->
          {
            ..acc,
            words: acc.words.push(
              Bytes::concat_all([
                sum_helper(spec, b"take"),
                b"(ctx, ",
                nth_bytes(names, acc.at),
                b")",
              ]),
            ),
            at: acc.at + 1,
          },
        Whole(k) ->
          {
            ..acc,
            words: acc.words.push(
              as_word({ kind: k, expr: nth_bytes(names, acc.at), ty: TyOpen([]) }),
            ),
            at: acc.at + 1,
          },
        Fields(fs) -> {
          let sh = record_shapes(acc.emitter, fs);
          let made = fresh(sh.emitter);
          let rl = record_leaves(fs);
          {
            emitter: made.emitter,
            prep: Bytes::concat_all([
              acc.prep,
              record_word_lines(
                made.name,
                nth_bytes(names, acc.at + rl.len()),
                fs,
                sh.shapes,
                range(0, rl.len()).map(|k: Int|
                  {
                    kind: nth_field(rl, k).kind,
                    expr: nth_bytes(names, acc.at + k),
                    ty: nth_field(rl, k).ty,
                  }),
                fail,
              ),
              b" ",
            ]),
            words: acc.words.push(made.name),
            at: acc.at + rl.len() + 1,
          }
        },
        Cases(sc) -> {
          let shaped = case_shapes(acc.emitter, sc);
          let made = fresh(shaped.emitter);
          let leaves = sum_leaves(sc);
          {
            emitter: made.emitter,
            prep: Bytes::concat_all([
              acc.prep,
              sum_word_lines(
                made.name,
                sc,
                nth_bytes(names, acc.at),
                range(0, leaves.len()).map(|k: Int|
                  {
                    kind: nth_field(leaves, k).kind,
                    expr: nth_bytes(names, acc.at + 1 + k),
                    ty: TyOpen([]),
                  }),
                shaped.shapes,
                fail,
              ),
              b" ",
            ]),
            words: acc.words.push(
              Bytes::concat_all([sum_helper(sc.spec, b"take"), b"(ctx, ", made.name, b")"]),
            ),
            at: acc.at + 1 + leaves.len(),
          }
        },
      },
  );
  { emitter: walked.emitter, prep: walked.prep, words: walked.words }
}

/// The emitter noting that this body calls the parameter `value` is, where it is one.
fn calling(emitter: Emitter, value: CValue, params: List<EmitParam>) -> Emitter =
  match param_of(emitter, value, params) {
    Some(i) -> {
      let g = emitter.generics;
      if g.called.contains(i) { emitter }
      else { note_generics(emitter, { ..g, called: g.called.push(i) }) }
    },
    None -> emitter,
  }

/// A parameter the prologue did not open is outside the window and read as its own word.
fn caps_owned(
  emitter: Emitter,
  captures: List<Capture>,
  params: List<EmitParam>,
  i: Int,
  acc: List<{ name: Bytes, ty: Ty }>,
) -> Option<{ emitter: Emitter, caps: List<{ name: Bytes, ty: Ty }> }> =
  if i >= captures.len() { Some({ emitter: emitter, caps: acc }) } else {
    match captures.at(i) {
      None -> None,
      Some(c) -> {
        let found = match conv_of(emitter, c.src) {
          Some(v) -> Some(v),
          None -> match params.at(c.src) {
            Some(p) -> if counted(p.kind) {
              Some({ kind: p.kind, expr: b"p".concat(ascii_of_int(c.src)), ty: p.ty })
            } else { None },
            None -> None,
          },
        };
        match found {
          None ->
            Some({ emitter: poison(emitter, b"a capture this port has not bound"), caps: acc }),
          Some(v) -> {
            let mv = window_read(emitter, c.own, v, v);
            let w = owned(mv.emitter, mv.value);
            // The closure holds the capture as its word, laid out as the word was here.
            let ty = if v.kind == KBoxed { v.ty } else { TyOpen([]) };
            caps_owned(w.emitter, captures, params, i + 1, acc.push({ name: w.value.expr, ty: ty }))
          },
        }
      },
    }
  }

/// The layout of each of lambda `l`'s parameters at the type the checker gave the lambda, unknown
/// where it filed none.
fn lambda_param_tys(emitter: Emitter, l: Lambda) -> List<Ty> =
  match emitter.typed.get(span_key(l.at)) {
    Some(t) -> match t.ty {
      TyFn(f) -> if f.params.len() == l.params { f.params.map(|p: Type| kind_of(p).ty) }
      else { [] },
      _ -> [],
    },
    None -> [],
  }

fn ty_at(tys: List<Ty>, j: Int) -> Ty = match tys.at(j) { Some(t) -> t, None -> TyOpen([]) }

/// `ty` where it says something, else `fallback`.
fn known_or(ty: Ty, fallback: Ty) -> Ty = match ty { TyOpen(_) -> fallback, _ -> ty }

/// How a function value takes its arguments and answers where a call knows its type: each as a
/// direct call of a definition of that type carries it. Two reads of one closure agree on it only
/// where they agree on the type, so a closure carries its own and a call tests for the one it expects.
type Convention = { params: List<Carrier>, ret: Carrier }

fn words_convention(n: Int) -> Convention =
  { params: range(0, n).map(|_: Int| Whole(KBoxed)), ret: Whole(KBoxed) }

/// The convention of a function value of type `ty` that takes `n` arguments: every value a word
/// where `ty` is no such function's.
fn convention_of(ty: Option<Type>, n: Int) -> Convention =
  match ty {
    Some(TyFn(f)) -> if f.params.len() != n { words_convention(n) }
    else { { params: f.params.map(carrier_of), ret: carrier_of(f.ret) } },
    _ -> words_convention(n),
  }

/// The convention of the function value the node `code` is, by its node's type.
fn called_convention(emitter: Emitter, code: Code, n: Int) -> Convention =
  convention_of(node_type(emitter, code), n)

/// Whether `c` holds a value apart from a word, which is what a call by it saves.
fn typed_convention(c: Convention) -> Bool =
  c.ret != Whole(KBoxed) || c.params.fold(false, |any: Bool, p: Carrier| any || p != Whole(KBoxed))

fn kind_spelled(k: Kind) -> Bytes =
  match k {
    KBoxed -> b"w",
    KInt -> b"i",
    KBool -> b"b",
    KFloat -> b"f",
    KDec -> b"d",
    KSum(Zeroed) -> b"m",
    KSum(Tagged) -> b"t",
    KNum(w) -> Bytes::concat_all([if w.signed { b"s" } else { b"u" }, ascii_of_int(w.bits)]),
  }

fn carrier_spelled(c: Carrier) -> Bytes =
  match c {
    Whole(k) -> kind_spelled(k),
    Cases(sc) ->
      Bytes::concat_all([
        kind_spelled(KSum(sc.spec)),
        b"<",
        bytes_join(
          sc.cases.map(|x: SumCase|
            match x.arg {
              Some(a) -> Bytes::concat_all([x.name, b":", carrier_spelled(a)]),
              None -> x.name,
            }),
          b"|",
        ),
        b">",
      ]),
    Fields(fs) ->
      Bytes::concat_all([
        b"{",
        bytes_join(
          fs.map(|f: FieldTy|
            Bytes::concat_all([
              f.name,
              b":",
              match in_place(f) {
                Some(inner) -> flat_spelled(inner),
                None -> kind_spelled(f.kind),
              },
            ])),
          b",",
        ),
        b"}",
      ]),
  }

/// A record of no record in place as a convention spells it: each field's name and kind.
fn flat_spelled(fs: List<FieldTy>) -> Bytes =
  Bytes::concat_all([
    b"{",
    bytes_join(fs.map(|f: FieldTy| Bytes::concat_all([f.name, b":", kind_spelled(f.kind)])), b","),
    b"}",
  ])

/// A convention as the C integer a closure's descriptor holds: a digest of how each value crosses.
fn convention_id(c: Convention) -> Bytes =
  int_lit(root_id(bytes_join(c.params.push(c.ret).map(carrier_spelled), b",")))

/// The C type of the entry a closure of convention `c` is called through by its type: the closure,
/// then each argument's carried values, then the pointers a record answer is written through.
fn typed_entry_type(c: Convention) -> Bytes = {
  let h = convention_head(c);
  Bytes::concat_all([
    h.answer,
    b" (*)(PlyCtx *, Word",
    h.params.fold(b"", |acc: Bytes, t: Bytes| Bytes::concat_all([acc, b", ", t])),
    b")",
  ])
}

/// The C head a function of convention `c` has past what it captures.
fn convention_head(c: Convention) -> Head =
  {
    answer: carried_type(returned_kind(c.ret)),
    params: c.params.fold([], |acc: List<Bytes>, p: Carrier| acc.concat(carried_types(p))).concat(
      written_back(c.ret).map(|f: FieldTy| carried_type(f.kind).concat(b"*")),
    ),
  }

/// The descriptor of the closure `f`, where it has one: the word after its code is the address, as
/// an immediate, of its convention and typed entry.
fn descriptor_of(f: Bytes) -> Bytes =
  Bytes::concat_all([b"((const int64_t *)(intptr_t)ply_imm_value(ply_words(", f, b")[1]))"])

/// Whether `f` is a closure compiled code made, whose descriptor says convention `c`.
fn called_typed(f: Bytes, c: Convention) -> Bytes =
  Bytes::concat_all([
    b"(!ply_is_imm(",
    f,
    b") && ply_obj(",
    f,
    b")->kind == 6 && (ply_obj(",
    f,
    b")->flags & 16) && ",
    descriptor_of(f),
    b"[0] == ",
    convention_id(c),
    b")",
  ])

/// The parameters of a lambda of convention `c` as a definition's are, carried as `c` says.
fn lambda_params(c: Convention, tys: List<Ty>) -> List<EmitParam> =
  range(0, c.params.len()).map(|j: Int| {
    let carrier = carrier_at(c.params, j);
    {
      name: b"p".concat(ascii_of_int(j)),
      kind: match carrier { Whole(k) -> k, Fields(_) -> KBoxed, Cases(sc) -> KSum(sc.spec) },
      ty: match carrier { Fields(fs) -> TyRec(fs), _ -> ty_at(tys, j) },
      of: None,
      carrier: carrier,
      lambda: None,
    }
  })

/// What a lambda `name` of `captures` captures and parameters `params` is entered through: the
/// entry the runtime calls with every value a word, past the closure's descriptor; the entry a call
/// by its type makes with the closure, which hands the function its captures counted once more; and
/// the descriptor naming that entry. `shapes` are an answer's records', which the first entry makes.
fn lambda_entries(
  name: Bytes,
  captures: Int,
  params: List<EmitParam>,
  c: Convention,
  shapes: List<List<Int>>,
) -> Bytes = {
  let names = carried_names(params, c.ret);
  let h = convention_head(c);
  Bytes::concat_all([
    entry_from(
      name,
      range(0, captures).map(|i: Int| Bytes::concat_all([b"args[", ascii_of_int(1 + i), b"]"])),
      1 + captures,
      params,
      c.ret,
      shapes,
    ),
    h.answer,
    b" ",
    name,
    b"_typed(PlyCtx *ctx, Word self",
    range(0, h.params.len()).fold(b"", |acc: Bytes, j: Int|
      Bytes::concat_all([acc, b", ", nth_bytes(h.params, j), b" ", nth_bytes(names, j)])),
    b") {\n",
    range(0, captures).fold(b"", |acc: Bytes, i: Int|
      Bytes::concat_all([
        acc,
        b"  Word c",
        ascii_of_int(i),
        b" = ply_words(self)[",
        ascii_of_int(2 + i),
        b"]; ply_inc(c",
        ascii_of_int(i),
        b");\n",
      ])),
    b"  return ",
    name,
    b"(ctx",
    range(0, captures).fold(b"", |acc: Bytes, i: Int|
      Bytes::concat_all([acc, b", c", ascii_of_int(i)])),
    names.fold(b"", |acc: Bytes, n: Bytes| Bytes::concat_all([acc, b", ", n])),
    b");\n}\n",
    b"const int64_t ",
    name,
    b"_desc[2] = { ",
    convention_id(c),
    b", (int64_t)(intptr_t)&",
    name,
    b"_typed };\n",
  ])
}

/// A lambda's C parameters are its captures, each a word it owns, then its own as its type's
/// convention carries them; it answers as that convention does.
/// It continues the unit's tables from its builder and hands additions back; a fresh copy would renumber from zero.
fn emit_lambda(
  emitter: Emitter,
  name: Bytes,
  l: Lambda,
  cap_tys: List<Ty>,
) -> Option<{ text: Bytes, extra: Bytes, met: List<Bytes>, consts: List<Lit>, shapes: List<List<Bytes>>, fields: List<Bytes>, lambdas: List<Bytes>, calls: List<Bytes>, generics: Generics, performs: List<Bytes>, handles: List<Bytes>, refused: Option<Bytes> }> / {abort.raise} = {
  let tys = lambda_param_tys(emitter, l);
  let convention = convention_of(
    match emitter.typed.get(span_key(l.at)) { Some(t) -> Some(t.ty), None -> None },
    l.params,
  );
  let params = lambda_params(convention, tys);
  let captures = l.captures.len();
  let window = range(0, params.len()).fold(
    range(0, captures).fold([], |acc: List<Unboxed>, i: Int|
      match l.captures.at(i) {
        Some(c) ->
          acc.push({
            slot: c.dst,
            kind: KBoxed,
            expr: b"q".concat(ascii_of_int(i)),
            ty: ty_at(cap_tys, i),
          }),
        None -> acc,
      }),
    |acc: List<Unboxed>, j: Int|
      match params.at(j) {
        Some(p) -> match p.carrier {
          Whole(k) -> acc.push({ slot: j, kind: k, expr: p.name, ty: p.ty }),
          _ -> acc,
        },
        None -> acc,
      },
  );
  let reads = slots_read(l.body);
  // Nothing in a lambda's body is a tail, so an update at its end keeps the one-read guard.
  let start = {
    out: [],
    temp_count: 0,
    unboxed: window,
    indent: 0,
    reads: reads,
    shapes: emitter.shapes,
    built: [],
    module: emitter.module,
    base: emitter.base,
    count_locals: [],
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: b"",
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: [],
    reuse_widths: [],
    alias: [],
    by_root: [],
    tail: false,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: [],
    deferred_locals: [],
    performs: emitter.performs,
    handles: emitter.handles,
    landing: None,
    effects: emitter.effects,
    release: emitter.release,
    pinned: [],
    bound: [],
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: convention.ret,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
    slices: [],
    sums: [],
    leaves: answers_cases(convention.ret),
  };
  let charged = window.fold(start, |acc: Emitter, w: Unboxed|
    if counted(w.kind) { note_bound(note_holder(charge(acc, w.slot, w.expr), w.expr), w.expr) }
    else { acc });
  // A record that arrives as its fields is held back as them, and a sum as its cases.
  let opened = range(0, params.len()).fold(charged, |acc: Emitter, j: Int|
    match carrier_at(convention.params, j) {
      Fields(fs) -> {
        let rl = record_leaves(fs);
        let r = held_record(
          acc,
          fs,
          range(0, rl.len()).map(|k: Int|
            { kind: nth_field(rl, k).kind, expr: field_param(j, k), ty: nth_field(rl, k).ty }),
          word_param(j),
        );
        remember(r.emitter, j, r.value)
      },
      Cases(sc) -> {
        let h = sum_param(acc, sc, j);
        remember(h.emitter, j, { ..h.value, ty: ty_at(tys, j) })
      },
      Whole(_) -> acc,
    });
  match expr(opened, l.body, []) {
    None -> None,
    Some(o0) -> {
      let w = answered(o0.emitter, o0.value, convention.ret);
      let shaped = answer_shapes(w.emitter, convention.ret);
      // A stack grown re-enters through the runtime's entry: the descriptor's place, then words.
      let grown = grown_words(shaped.emitter, params, convention.ret);
      let o = grown.emitter;
      let h = convention_head(convention);
      let names = carried_names(params, convention.ret);
      Some({
        met: o.called_builtins,
        consts: o.consts,
        shapes: o.shapes,
        fields: o.fields,
        lambdas: o.lambdas,
        calls: o.calls,
        generics: o.generics,
        performs: o.performs,
        handles: o.handles,
        refused: o.refused,
        extra: o.lambda_bodies,
        text: Bytes::concat_all([
          b"Word ",
          name,
          b"_entry(PlyCtx *ctx, const Word *args);\n",
          h.answer,
          b" ",
          name,
          b"(PlyCtx *ctx",
          range(0, captures).fold(b"", |acc: Bytes, i: Int|
            Bytes::concat_all([acc, b", Word q", ascii_of_int(i)])),
          range(0, h.params.len()).fold(b"", |acc: Bytes, j: Int|
            Bytes::concat_all([acc, b", ", nth_bytes(h.params, j), b" ", nth_bytes(names, j)])),
          b") {\n",
          fuel_head(
            name.concat(b"_entry"),
            grown.prep,
            [b"0"].concat(range(0, captures).map(|i: Int| b"q".concat(ascii_of_int(i)))).concat(
              grown.words,
            ),
            convention.ret,
          ),
          sorted_widths(o.reuse_widths).fold(b"", |acc: Bytes, wd: Int|
            Bytes::concat_all([acc, b"  Word tok", ascii_of_int(wd), b" = 0;\n"])),
          o.deferred_locals.fold(b"", |acc: Bytes, r: Bytes|
            Bytes::concat_all([acc, b"  Word ", r, b" = 0;\n"])),
          bytes_join(o.out, b""),
          toks_freed(o.reuse_widths),
          b"  ctx->fuel += 1;\n  return ",
          w.expr,
          b";\n}\n",
          lambda_entries(name, captures, params, convention, shaped.shapes),
        ]),
      })
    },
  }
}

/// The line before a return that frees each token the body filled and nothing took.
fn toks_freed(widths: List<Int>) -> Bytes =
  if widths.len() == 0 { b"" } else { Bytes::concat_all([b"  ", toks_freeing(widths), b"\n"]) }

fn toks_freeing(widths: List<Int>) -> Bytes =
  bytes_join(
    sorted_widths(widths).map(|w: Int|
      Bytes::concat_all([
        b"if (tok",
        ascii_of_int(w),
        b") ply_dec(ctx, tok",
        ascii_of_int(w),
        b");",
      ])),
    b" ",
  )

/// Where a group member returns: what frees the group's tokens, known once every member is emitted.
fn toks_mark() -> Bytes = b"/*toks*/"

/// Each argument as the callee carries it, duplicated as soon as it is evaluated, unlike a
/// builtin's: an owned word where `carriers` names none for it, or the value in its own C type.
fn args_carried(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  carriers: List<Carrier>,
  i: Int,
  acc: List<Bytes>,
) -> Option<{ emitter: Emitter, names: List<Bytes> }> / {abort.raise} =
  if i >= codes.len() { Some({ emitter: emitter, names: acc }) } else {
    match codes.at(i) {
      None -> None,
      Some(x) -> match expr(
          if answers_cases(carrier_at(carriers, i)) { with_leaves(notail(emitter)) }
          else { notail(emitter) },
          x,
          params,
        ) {
        None -> None,
        Some(o) -> {
          let w = carried_arg(notail(o.emitter), o.value, carrier_at(carriers, i));
          args_carried(w.emitter, codes, params, carriers, i + 1, acc.concat(w.names))
        },
      },
    }
  }

/// The carrier at `i`: a word where nothing says otherwise.
fn carrier_at(carriers: List<Carrier>, i: Int) -> Carrier =
  match carriers.at(i) { Some(c) -> c, None -> Whole(KBoxed) }

/// `value` handed to a callee carrying it as `c`: an owned word, a local of its C type, or a local
/// of each field's.
fn carried_arg(
  emitter: Emitter,
  value: CValue,
  c: Carrier,
) -> { emitter: Emitter, names: List<Bytes> } =
  match c {
    Cases(sc) -> handed_sum(emitter, value, sc),
    other -> carried_value(emitter, value, other),
  }

/// As `carried_arg`, for a carrier that is not a sum's cases: what a sum's argument crosses as.
fn carried_value(
  emitter: Emitter,
  value: CValue,
  c: Carrier,
) -> { emitter: Emitter, names: List<Bytes> } =
  match c {
    Whole(KBoxed) -> {
      let w = owned(emitter, value);
      { emitter: w.emitter, names: [w.value.expr] }
    },
    Whole(KSum(spec)) -> {
      let w = sum_owned(emitter, value, spec);
      { emitter: w.emitter, names: [w.value.expr] }
    },
    Whole(k) -> {
      let w = bind(emitter, k, as_kind(value, k));
      { emitter: w.emitter, names: [w.value.expr] }
    },
    Fields(fs) -> handed_record(emitter, value, fs),
    Cases(_) -> {
      let w = owned(emitter, value);
      { emitter: w.emitter, names: [w.value.expr] }
    },
  }

/// Each leaf of the record `value` of fields `fs` in a local of its C type and then its word, each
/// with a count the taker owns: moved out of a record held back and spent here, and duplicated
/// otherwise. A record it holds in place hands on its own fields and word.
fn handed_record(
  emitter: Emitter,
  value: CValue,
  fs: List<FieldTy>,
) -> { emitter: Emitter, names: List<Bytes> } = {
  let r = record_values(emitter, value, fs);
  let spent = spendable(r.emitter, value.expr);
  let fields = range(0, fs.len()).fold(
    { emitter: r.emitter, names: [] },
    |acc: { emitter: Emitter, names: List<Bytes> }, k: Int| {
      let v = nth_value(r.vals, k);
      match in_place(nth_field(fs, k)) {
        Some(inner) -> {
          let iv = match moved_field(acc.emitter, spent, value, v) {
            Some(m) -> { emitter: note_made(m.emitter, m.value.expr), value: m.value },
            None -> { emitter: acc.emitter, value: v },
          };
          let h = handed_flat(iv.emitter, iv.value, inner);
          { emitter: h.emitter, names: acc.names.concat(h.names) }
        },
        None -> handed_field(acc, spent, value, nth_field(fs, k), v),
      }
    },
  );
  let w = handed_word(fields.emitter, value);
  { emitter: w.emitter, names: fields.names.push(w.value.expr) }
}

/// As `handed_record`, for a record of no record in place.
fn handed_flat(
  emitter: Emitter,
  value: CValue,
  fs: List<FieldTy>,
) -> { emitter: Emitter, names: List<Bytes> } = {
  let r = record_values(emitter, value, fs);
  let spent = spendable(r.emitter, value.expr);
  let fields = range(0, fs.len()).fold(
    { emitter: r.emitter, names: [] },
    |acc: { emitter: Emitter, names: List<Bytes> }, k: Int|
      handed_field(acc, spent, value, nth_field(fs, k), nth_value(r.vals, k)),
  );
  let w = handed_word(fields.emitter, value);
  { emitter: w.emitter, names: fields.names.push(w.value.expr) }
}

/// `acc` handing on `v`, field `f` of the record `value`, with a count the taker owns: moved out
/// where the record is `spent` here.
fn handed_field(
  acc: { emitter: Emitter, names: List<Bytes> },
  spent: Bool,
  value: CValue,
  f: FieldTy,
  v: CValue,
) -> { emitter: Emitter, names: List<Bytes> } = {
  let w = if counted(f.kind) {
    match moved_field(acc.emitter, spent, value, v) {
      Some(m) -> m,
      None -> match f.kind {
        KSum(spec) -> sum_owned(acc.emitter, v, spec),
        _ -> owned(acc.emitter, v),
      },
    }
  } else { bind(acc.emitter, f.kind, as_kind(v, f.kind)) };
  { emitter: w.emitter, names: acc.names.push(w.value.expr) }
}

/// The word of the record `value` with a count the taker owns: a record held back hands on its
/// local, zero where it was never made, moved where it is spent here; an object hands on itself.
fn handed_word(emitter: Emitter, value: CValue) -> WithValue =
  match deferred_of(emitter, value.expr) {
    None -> owned_word(emitter, { ..value, kind: KBoxed }),
    Some(_) -> {
      let w = bind_word_of(emitter, value.expr);
      if spends(emitter, value.expr) {
        {
          emitter: line(spend_made(w.emitter, value.expr), value.expr.concat(b" = 0;")),
          value: w.value,
        }
      } else {
        {
          emitter: line(w.emitter, Bytes::concat_all([b"ply_inc(", w.value.expr, b");"])),
          value: w.value,
        }
      }
    },
  }

/// The call of `target`, named before its `n` arguments were handed over as `names`, its answer as
/// the root it names hands it back: a record's held back as the fields it returned, and a sum's as
/// its cases where `leaves` says they are taken so.
fn called(
  emitter: Emitter,
  target: Target,
  span: Span,
  names: List<Bytes>,
  n: Int,
  leaves: Bool,
) -> WithValue = {
  let answer = target.carriers.answer;
  let back = written_back(answer);
  let expected = {
    answer: carried_type(returned_kind(answer)),
    params: range(0, n).fold([], |acc: List<Bytes>, i: Int|
      acc.concat(carried_types(carrier_at(target.carriers.params, i)))).concat(
      back.map(|f: FieldTy| carried_type(f.kind).concat(b"*")),
    ),
  };
  let noted = {
    ..emitter,
    generics: {
      ..emitter.generics,
      expects: emitter.generics.expects.push({ callee: target.root, head: expected }),
    },
  };
  // A record answer's later fields come back through locals the call is handed.
  let outs = back.fold(
    { emitter: noted, names: [] },
    |acc: { emitter: Emitter, names: List<Bytes> }, f: FieldTy| {
      let o = fresh(acc.emitter);
      {
        emitter: line(o.emitter, Bytes::concat_all([ctype(f.kind), b" ", o.name, b";"])),
        names: acc.names.push(o.name),
      }
    },
  );
  let o = bind(
    site(outs.emitter, span),
    returned_kind(answer),
    Bytes::concat_all([
      target.symbol,
      b"(ctx",
      names.fold(b"", |acc: Bytes, nm: Bytes| Bytes::concat_all([acc, b", ", nm])),
      outs.names.fold(b"", |acc: Bytes, nm: Bytes| Bytes::concat_all([acc, b", &", nm])),
      b")",
    ]),
  );
  // A word is opened to the callee's declared type, so a body whose answer is already a word hands it straight back.
  match answer {
    Whole(KBoxed) -> opened_to(check(o.emitter), o.value, target.ret),
    Whole(_) -> { emitter: check(o.emitter), value: { ..o.value, ty: target.ret.ty } },
    Cases(sc) ->
      sum_answer(
        check(o.emitter),
        leaves,
        sc,
        o.value.expr,
        range(0, back.len()).map(|k: Int|
          { kind: nth_field(back, k).kind, expr: nth_bytes(outs.names, k), ty: TyOpen([]) }),
      ),
    Fields(fs) -> {
      let vals = push_front(
        o.value,
        range(0, back.len() - 1).map(|k: Int|
          {
            kind: nth_field(back, k).kind,
            expr: nth_bytes(outs.names, k),
            ty: nth_field(back, k).ty,
          }),
      );
      held_record(check(o.emitter), fs, vals, nth_bytes(outs.names, back.len() - 1))
    },
  }
}

/// A sum of cases `c` a call answered as its constructor's index `tag` and the values `leaves`:
/// held back as them where `wanted`, and its word made of them otherwise.
fn sum_answer(
  emitter: Emitter,
  wanted: Bool,
  c: SumCases,
  tag: Bytes,
  leaves: List<CValue>,
) -> WithValue = {
  let h = held_sum_from(emitter, c, tag, leaves);
  if wanted { h } else {
    match held_sum_of(h.emitter, h.value.expr) {
      Some(held) -> { emitter: sum_made(h.emitter, held, true), value: h.value },
      None -> h,
    }
  }
}

/// Field `k` of `fs`; one of no name past the end.
fn nth_field(fs: List<FieldTy>, k: Int) -> FieldTy =
  match fs.at(k) { Some(f) -> f, None -> { name: b"", kind: KBoxed, ty: TyOpen([]) } }

fn nth_bytes(xs: List<Bytes>, k: Int) -> Bytes = match xs.at(k) { Some(x) -> x, None -> b"" }

fn nth_value(vs: List<CValue>, k: Int) -> CValue =
  match vs.at(k) { Some(v) -> v, None -> { kind: KBoxed, expr: b"0", ty: TyOpen([]) } }

/// `x` and then `xs`.
fn push_front(x: CValue, xs: List<CValue>) -> List<CValue> = [x].concat(xs)

/// The record of fields `fs` whose leaves are `vals`, held back as their values, and as `word`, its
/// word where it was made, until its word is asked for: a record it holds in place held back as its
/// own leaves.
fn held_record(emitter: Emitter, fs: List<FieldTy>, vals: List<CValue>, word: Bytes) -> WithValue = {
  let walked = fs.fold(
    { emitter: emitter, at: 0, vals: [] },
    |acc: { emitter: Emitter, at: Int, vals: List<CValue> }, f: FieldTy|
      match in_place(f) {
        Some(inner) -> {
          let n = inner.len();
          let r = held_flat(
            acc.emitter,
            inner,
            range(0, n).map(|k: Int| { ..nth_value(vals, acc.at + k), ty: nth_field(inner, k).ty }),
            nth_value(vals, acc.at + n).expr,
          );
          { emitter: r.emitter, at: acc.at + n + 1, vals: acc.vals.push(r.value) }
        },
        None -> { ..acc, at: acc.at + 1, vals: acc.vals.push(nth_value(vals, acc.at)) },
      },
  );
  build_record(
    walked.emitter,
    names_of(fs),
    range(0, fs.len()).map(|k: Int| {
      let v = nth_value(walked.vals, k);
      if in_place(nth_field(fs, k)) != None { v.expr } else { field_word(v, nth_field(fs, k).kind) }
    }),
    fs,
    Some(walked.vals),
    word,
  )
}

/// As `held_record`, for a record of no record in place.
fn held_flat(emitter: Emitter, fs: List<FieldTy>, vals: List<CValue>, word: Bytes) -> WithValue =
  build_record(
    emitter,
    names_of(fs),
    range(0, fs.len()).map(|k: Int| field_word(nth_value(vals, k), nth_field(fs, k).kind)),
    fs,
    Some(vals),
    word,
  )

fn args_evaled(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  i: Int,
  acc: List<CValue>,
) -> Option<{ emitter: Emitter, vals: List<CValue> }> / {abort.raise} =
  if i >= codes.len() { Some({ emitter: emitter, vals: acc }) } else {
    match codes.at(i) {
      None -> None,
      Some(x) -> match expr(notail(emitter), x, params) {
        None -> None,
        Some(o) -> {
          let s = secure(o.emitter, o.value);
          args_evaled(s.emitter, codes, params, i + 1, acc.push(s.value))
        },
      },
    }
  }

fn field_of(emitter: Emitter, name: Bytes) -> { emitter: Emitter, i: Int } =
  match range(0, emitter.fields.len()).fold(None, |acc: Option<Int>, i: Int|
      match emitter.fields.at(i) {
        Some(x) -> if x == name { Some(i) } else { acc },
        None -> acc,
      }) {
    Some(i) -> { emitter: emitter, i: i },
    None ->
      {
        emitter: {
          out: emitter.out,
          temp_count: emitter.temp_count,
          unboxed: emitter.unboxed,
          indent: emitter.indent,
          reads: emitter.reads,
          shapes: emitter.shapes,
          built: emitter.built,
          module: emitter.module,
          base: emitter.base,
          count_locals: emitter.count_locals,
          here: emitter.here,
          imports: emitter.imports,
          consts: emitter.consts,
          ctors: emitter.ctors,
          lambda_bodies: emitter.lambda_bodies,
          lambdas: emitter.lambdas,
          owner: emitter.owner,
          builtins: emitter.builtins,
          called_builtins: emitter.called_builtins,
          fields: emitter.fields.push(name),
          released: emitter.released,
          reuse_widths: emitter.reuse_widths,
          alias: emitter.alias,
          by_root: emitter.by_root,
          tail: emitter.tail,
          calls: emitter.calls,
          generics: emitter.generics,
          refused: emitter.refused,
          deferred: emitter.deferred,
          deferred_locals: emitter.deferred_locals,
          performs: emitter.performs,
          handles: emitter.handles,
          landing: emitter.landing,
          effects: emitter.effects,
          release: emitter.release,
          pinned: emitter.pinned,
          bound: emitter.bound,
          group: emitter.group,
          operands: emitter.operands,
          typed: emitter.typed,
          answer: emitter.answer,
          site_root: emitter.site_root,
          lent: emitter.lent,
          written: emitter.written,
          slices: emitter.slices,
          sums: emitter.sums,
          leaves: emitter.leaves,
        },
        i: emitter.fields.len(),
      },
  }

fn built_field(emitter: Emitter, local: Bytes, name: Bytes) -> Option<CValue> =
  emitter.built.fold(None, |acc: Option<CValue>, b: Built|
    if b.local != local { acc } else {
      range(0, b.names.len()).fold(acc, |inner: Option<CValue>, i: Int|
        match b.names.at(i) {
          Some(n) -> if n == name { b.vals.at(i) } else { inner },
          None -> inner,
        })
    })

fn remember_built(
  emitter: Emitter,
  local: Bytes,
  names: List<Bytes>,
  vals: List<CValue>,
) -> Emitter =
  {
    out: emitter.out,
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: emitter.built.push({ local: local, names: names, vals: vals }),
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: emitter.released,
    reuse_widths: emitter.reuse_widths,
    alias: emitter.alias,
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred,
    deferred_locals: emitter.deferred_locals,
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
    slices: emitter.slices,
    sums: emitter.sums,
    leaves: emitter.leaves,
  }

fn shape_of(emitter: Emitter, names: List<Bytes>) -> { emitter: Emitter, i: Int } =
  match range(0, emitter.shapes.len()).fold(None, |acc: Option<Int>, i: Int|
      match emitter.shapes.at(i) {
        Some(sh) -> if same_names(sh, names) { Some(i) } else { acc },
        None -> acc,
      }) {
    Some(i) -> { emitter: emitter, i: i },
    None ->
      {
        emitter: {
          out: emitter.out,
          temp_count: emitter.temp_count,
          unboxed: emitter.unboxed,
          indent: emitter.indent,
          reads: emitter.reads,
          shapes: emitter.shapes.push(names),
          built: emitter.built,
          module: emitter.module,
          base: emitter.base,
          count_locals: emitter.count_locals,
          here: emitter.here,
          imports: emitter.imports,
          consts: emitter.consts,
          ctors: emitter.ctors,
          lambda_bodies: emitter.lambda_bodies,
          lambdas: emitter.lambdas,
          owner: emitter.owner,
          builtins: emitter.builtins,
          called_builtins: emitter.called_builtins,
          fields: emitter.fields,
          released: emitter.released,
          reuse_widths: emitter.reuse_widths,
          alias: emitter.alias,
          by_root: emitter.by_root,
          tail: emitter.tail,
          calls: emitter.calls,
          generics: emitter.generics,
          refused: emitter.refused,
          deferred: emitter.deferred,
          deferred_locals: emitter.deferred_locals,
          performs: emitter.performs,
          handles: emitter.handles,
          landing: emitter.landing,
          effects: emitter.effects,
          release: emitter.release,
          pinned: emitter.pinned,
          bound: emitter.bound,
          group: emitter.group,
          operands: emitter.operands,
          typed: emitter.typed,
          answer: emitter.answer,
          site_root: emitter.site_root,
          lent: emitter.lent,
          written: emitter.written,
          slices: emitter.slices,
          sums: emitter.sums,
          leaves: emitter.leaves,
        },
        i: emitter.shapes.len(),
      },
  }

fn same_names(a: List<Bytes>, b: List<Bytes>) -> Bool =
  a.len() == b.len()
    && a.fold(true, |acc: Bool, x: Bytes|
      acc && b.fold(false, |seen: Bool, y: Bytes| seen || y == x))

/// Values were built in written order; the record holds them in sorted-name order.
fn word_at_rank(names: List<Bytes>, words: List<Bytes>, at: Int) -> Bytes =
  range(0, names.len()).fold(b"", |acc: Bytes, i: Int|
    match names.at(i) {
      None -> acc,
      Some(nm) -> if rank_of(names, nm) == at { match words.at(i) { Some(w) -> w, None -> acc } }
      else { acc },
    })

fn rank_of(names: List<Bytes>, name: Bytes) -> Int =
  names.fold(0, |acc: Int, n: Bytes| if compare(n, name) == Less { acc + 1 } else { acc })

fn note_tok(emitter: Emitter, w: Int) -> Emitter =
  if emitter.reuse_widths.fold(false, |acc: Bool, x: Int| acc || x == w) { emitter } else {
    {
      out: emitter.out,
      temp_count: emitter.temp_count,
      unboxed: emitter.unboxed,
      indent: emitter.indent,
      reads: emitter.reads,
      shapes: emitter.shapes,
      built: emitter.built,
      module: emitter.module,
      base: emitter.base,
      count_locals: emitter.count_locals,
      here: emitter.here,
      imports: emitter.imports,
      consts: emitter.consts,
      ctors: emitter.ctors,
      lambda_bodies: emitter.lambda_bodies,
      lambdas: emitter.lambdas,
      owner: emitter.owner,
      builtins: emitter.builtins,
      called_builtins: emitter.called_builtins,
      fields: emitter.fields,
      released: emitter.released,
      reuse_widths: emitter.reuse_widths.push(w),
      alias: emitter.alias,
      by_root: emitter.by_root,
      tail: emitter.tail,
      calls: emitter.calls,
      generics: emitter.generics,
      refused: emitter.refused,
      deferred: emitter.deferred,
      deferred_locals: emitter.deferred_locals,
      performs: emitter.performs,
      handles: emitter.handles,
      landing: emitter.landing,
      effects: emitter.effects,
      release: emitter.release,
      pinned: emitter.pinned,
      bound: emitter.bound,
      group: emitter.group,
      operands: emitter.operands,
      typed: emitter.typed,
      answer: emitter.answer,
      site_root: emitter.site_root,
      lent: emitter.lent,
      written: emitter.written,
      slices: emitter.slices,
      sums: emitter.sums,
      leaves: emitter.leaves,
    }
  }

fn note_released(emitter: Emitter, root: Bytes) -> Emitter =
  {
    out: emitter.out,
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: emitter.built,
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: emitter.released.push(root),
    reuse_widths: emitter.reuse_widths,
    alias: emitter.alias,
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred,
    deferred_locals: emitter.deferred_locals,
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
    slices: emitter.slices,
    sums: emitter.sums,
    leaves: emitter.leaves,
  }

/// The words a record of `ty` holds, which is the reuse token its cells make.
fn width_of(ty: Ty) -> Option<Int> = match ty { TyRec(fs) -> Some(laid_of(fs).width), _ -> None }

/// Where field `name` starts among a record's words: after the words of the fields that sort
/// before it.
fn field_at(ty: Ty, name: Bytes) -> Option<{ at: Int, kind: Kind, ty: Ty }> =
  match ty {
    TyRec(fs) -> {
      let offsets = laid_of(fs).offsets;
      range(0, fs.len()).fold(None, |acc: Option<{ at: Int, kind: Kind, ty: Ty }>, i: Int|
        match fs.at(i) {
          Some(field) -> if field.name == name {
            Some({
              at: match offsets.at(i) { Some(o) -> o, None -> i },
              kind: field.kind,
              ty: field.ty,
            })
          } else { acc },
          None -> acc,
        })
    },
    _ -> None,
  }

/// A record held in place at `at` of `base`, read into `w`, taken: its words move to a record of its
/// own where `base` is its only holder, and it is held once more otherwise.
fn took(emitter: Emitter, base: Bytes, at: Int, w: Bytes) -> Emitter =
  check(
    line(
      emitter,
      Bytes::concat_all([w, b" = ply_take(ctx, ", base, b", ", ascii_of_int(at), b");"]),
    ),
  )

/// What reading field `f` of record `base` answers: the word it holds, or for a record held in
/// place the address of its header there, which counts as its holder does.
fn field_read(base: Bytes, f: { at: Int, kind: Kind, ty: Ty }) -> Bytes =
  match f.ty {
    TyRec(_) ->
      Bytes::concat_all([
        b"((Word)(intptr_t)(ply_words(",
        base,
        b") + ",
        ascii_of_int(f.at),
        b"))",
      ]),
    _ -> Bytes::concat_all([b"ply_words(", base, b")[", ascii_of_int(f.at), b"]"]),
  }

fn names_of(fs: List<FieldTy>) -> List<Bytes> = fs.map(|field: FieldTy| field.name)

fn as_bool(value: CValue) -> Bytes =
  match value.kind {
    KBool -> value.expr,
    KSum(_) -> b"ply_maybe_unrouted",
    KNum(_) -> Bytes::concat_all([b"((", value.expr, b") != 0)"]),
    KInt -> Bytes::concat_all([b"((", value.expr, b") != 0)"]),
    KBoxed -> bool_of_word(value.expr),
    KFloat -> Bytes::concat_all([b"rt_unbox_bool_p(ctx, ", as_word(value), b")"]),
    KDec -> Bytes::concat_all([b"rt_unbox_bool_p(ctx, ", as_word(value), b")"]),
  }

/// C's truth of a `Bool` the word `w` holds: the word is `true`'s own.
fn bool_of_word(w: Bytes) -> Bytes = Bytes::concat_all([b"(", w, b" == ply_true)"])

/// A word is read in place when it is a `Float`'s own object; the runtime reads any other.
fn as_float(value: CValue) -> Bytes =
  match value.kind {
    KFloat -> value.expr,
    KBoxed ->
      Bytes::concat_all([
        b"(ply_is_float(",
        value.expr,
        b") ? ply_f64(ply_words(",
        value.expr,
        b")[0]) : ply_f64(rt_unbox_float_p(ctx, ",
        value.expr,
        b")))",
      ]),
    _ -> Bytes::concat_all([b"ply_f64(rt_unbox_float_p(ctx, ", as_word(value), b"))"]),
  }

fn as_word(value: CValue) -> Bytes =
  match value.kind {
    KBoxed -> value.expr,
    // Made an object only by `owned` or `word_of`, which know whose its count is.
    KSum(_) -> b"ply_maybe_unrouted",
    // The C type the value is held in decides sign or zero extension.
    KNum(w) -> if in_imm(w) { Bytes::concat_all([b"ply_imm((int64_t)", value.expr, b")"]) } else {
      Bytes::concat_all([
        b"rt_box_fixed_p(ctx, (Word)(",
        value.expr,
        b"), ",
        ascii_of_int(width_index(w)),
        b")",
      ])
    },
    KBool -> Bytes::concat_all([b"(", value.expr, b" ? ply_true : ply_false)"]),
    KInt ->
      Bytes::concat_all([
        b"(ply_fits_imm(",
        value.expr,
        b") ? ply_imm(",
        value.expr,
        b") : rt_box_int_p(ctx, ",
        value.expr,
        b"))",
      ]),
    KFloat -> Bytes::concat_all([b"rt_box_float_p(ctx, ply_f64_bits(", value.expr, b"))"]),
    KDec ->
      Bytes::concat_all([b"rt_box_decimal_p(ctx, (", value.expr, b").lo, (", value.expr, b").hi)"]),
  }

/// `value` as a `Decimal`'s two words: a word is the `Decimal`'s own object.
fn as_dec(value: CValue) -> Bytes =
  match value.kind {
    KDec -> value.expr,
    KBoxed -> Bytes::concat_all([b"ply_dec_of(", value.expr, b")"]),
    _ -> Bytes::concat_all([b"ply_dec_of(", as_word(value), b")"]),
  }

/// `rt_arith`'s opcode numbering.
fn arith_code(op: Bytes) -> Int = if op == b"mul" { 0 } else if op == b"div" { 1 } else { 2 }

/// `rt_binary`'s operator numbering, in the runtime table's order.
fn binary_code(op: Bytes) -> Int =
  if op == b"add" { 0 }
  else if op == b"sub" { 1 }
  else if op == b"mul" { 2 }
  else if op == b"div" { 3 }
  else if op == b"rem" { 4 }
  else if op == b"eq" { 5 }
  else if op == b"ne" { 6 }
  else if op == b"lt" { 7 }
  else if op == b"le" { 8 }
  else if op == b"gt" { 9 }
  else if op == b"ge" { 10 }
  else if op == b"concat" { 11 }
  else if op == b"bitand" { 12 }
  else if op == b"bitor" { 13 }
  else if op == b"bitxor" { 14 }
  else if op == b"shl" { 15 }
  else if op == b"shr" { 16 }
  else { 17 }

fn is_add_or_sub(op: Bytes) -> Bool = op == b"add" || op == b"sub"

/// A lambda's closure: its body emitted as an entry of its own, and its captures copied in.
fn closure_value(
  emitter: Emitter,
  l: Lambda,
  params: List<EmitParam>,
) -> Option<WithValue> / {abort.raise} =
  match caps_owned(emitter, l.captures, params, 0, []) {
    None -> None,
    Some(w) -> {
      // Numbered among this body's lambdas; the code table holds constants' entries too.
      let prefix = symbol_of(emitter.owner).concat(b"_lambda");
      let idx = w.emitter.lambdas.fold(0, |acc: Int, sym: Bytes|
        if sym.len() >= prefix.len() && sym.slice(0, prefix.len()) == prefix { acc + 1 }
        else { acc });
      let sub = prefix.concat(ascii_of_int(idx));
      let entry = lambda_of(w.emitter, sub.concat(b"_entry"));
      match emit_lambda(entry.emitter, sub, l, w.caps.map(|c: { name: Bytes, ty: Ty }| c.ty)) {
        None -> None,
        Some(sub_out) -> {
          // The closure's first capture is its descriptor's address, an immediate no walk reads.
          let arr = fresh(entry.emitter);
          let e = line(
            line(arr.emitter, Bytes::concat_all([b"extern const int64_t ", sub, b"_desc[2];"])),
            Bytes::concat_all([
              b"Word ",
              arr.name,
              b"[] = {ply_imm((int64_t)(intptr_t)",
              sub,
              b"_desc)",
              w.caps.fold(b"", |acc: Bytes, c: { name: Bytes, ty: Ty }|
                Bytes::concat_all([acc, b", ", c.name])),
              b"};",
            ]),
          );
          let grown = {
            out: e.out,
            temp_count: e.temp_count,
            unboxed: e.unboxed,
            indent: e.indent,
            reads: e.reads,
            shapes: sub_out.shapes,
            built: e.built,
            module: e.module,
            base: e.base,
            count_locals: e.count_locals,
            here: e.here,
            imports: e.imports,
            consts: sub_out.consts,
            ctors: e.ctors,
            lambda_bodies: Bytes::concat_all([e.lambda_bodies, sub_out.text, sub_out.extra]),
            lambdas: sub_out.lambdas,
            owner: e.owner,
            builtins: e.builtins,
            called_builtins: sub_out.met,
            fields: sub_out.fields,
            released: e.released,
            reuse_widths: e.reuse_widths,
            alias: e.alias,
            by_root: e.by_root,
            tail: e.tail,
            calls: sub_out.calls,
            generics: sub_out.generics,
            refused: sub_out.refused,
            deferred: e.deferred,
            deferred_locals: e.deferred_locals,
            performs: sub_out.performs,
            handles: sub_out.handles,
            landing: e.landing,
            effects: e.effects,
            release: e.release,
            pinned: e.pinned,
            bound: e.bound,
            group: e.group,
            operands: e.operands,
            typed: e.typed,
            answer: e.answer,
            site_root: e.site_root,
            lent: e.lent,
            written: e.written,
            slices: e.slices,
            sums: e.sums,
            leaves: e.leaves,
          };
          let o = bind(
            grown,
            KBoxed,
            Bytes::concat_all([
              b"rt_closure_p(ctx, @@l",
              ascii_of_int(entry.i),
              b"@@, ",
              ascii_of_int(l.params),
              b", (Word)(intptr_t)",
              arr.name,
              b", ",
              ascii_of_int(l.captures.len() + 1),
              b")",
            ]),
          );
          Some({
            emitter: line(
              check(o.emitter),
              Bytes::concat_all([b"ply_obj(", o.value.expr, b")->flags |= 16;"]),
            ),
            value: o.value,
          })
        },
      }
    },
  }

/// Whether `{..base, ..}` may write its fields into `base` itself: a record this body releases here,
/// of the layout the update makes, which holds a record in place. Copying one of those out and back
/// would cost its words and their counts; any other record's cells are the token the update takes.
fn updates_in_place(emitter: Emitter, base: Code, held: CValue, fs: List<FieldTy>) -> Bool =
  emitter.release && base_owned(base) && spendable(emitter, held.expr)
    && deferred_of(emitter, held.expr) == None
    && built_of(emitter, held.expr) == None
    && fs.fold(false, |acc: Bool, f: FieldTy| acc || in_place(f) != None)
    && (match held.ty { TyRec(had) -> had.map(spelled_field) == fs.map(spelled_field), _ -> false })

/// `{..base, sets}` where `base` is its only holder: each written field let go of and written over
/// in `base`, which the update answers; otherwise as `built` builds it. The written values are held
/// before the test, so one read out of `base` itself counts against it and the update copies.
fn in_place_update(
  emitter: Emitter,
  base: Bytes,
  names: List<Bytes>,
  fs: List<FieldTy>,
  sets: List<CodeField>,
  vals: List<CValue>,
  built: (Emitter, List<CValue>, Bool) -> Option<WithValue> / {abort.raise},
) -> Option<WithValue> / {abort.raise} = {
  let held = range(0, sets.len()).fold(
    { emitter: emitter, vals: [] },
    |acc: { emitter: Emitter, vals: List<CValue> }, i: Int|
      match vals.at(i) {
        None -> acc,
        Some(v) -> {
          let nm = match sets.at(i) { Some(f) -> f.name, None -> b"" };
          let raw = fs.fold(None, |r: Option<Kind>, f: FieldTy|
            if f.name == nm && (raw_slot(f.kind) || f.kind == KSum(Zeroed)) { Some(f.kind) }
            else { r });
          let w = match raw {
            Some(KSum(spec)) -> sum_owned(acc.emitter, v, spec),
            Some(k) -> held_raw(acc.emitter, v, k),
            None -> owned(acc.emitter, v),
          };
          { emitter: w.emitter, vals: acc.vals.push(w.value) }
        },
      },
  );
  let r = bind(held.emitter, KBoxed, b"0");
  let l = laid_of(fs);
  let opened = indent(
    line(r.emitter, Bytes::concat_all([b"if (ply_obj(", base, b")->rc == 1) {"])),
  );
  let written = range(0, names.len()).fold(opened, |acc: Emitter, i: Int| {
    let nm = match names.at(i) { Some(x) -> x, None -> b"" };
    let f = match fs.at(i) { Some(x) -> x, None -> { name: nm, kind: KBoxed, ty: TyOpen([]) } };
    let at = ascii_of_int(match l.offsets.at(i) { Some(o) -> o, None -> i });
    match set_value(sets, held.vals, nm) {
      None -> acc,
      Some(v) -> match in_place(f) {
        Some(inner) ->
          line(
            line(acc, Bytes::concat_all([b"ply_drop_embedded(ctx, ", base, b", ", at, b");"])),
            Bytes::concat_all([
              b"ply_embed(ctx, ",
              base,
              b", ",
              at,
              b", ",
              as_word(v),
              b", ",
              ascii_of_int(laid_of(inner).tail),
              b");",
            ]),
          ),
        None -> if raw_slot(f.kind) { line(acc, raw_store(base, at, v, f.kind)) } else {
          line(
            acc,
            Bytes::concat_all([
              b"ply_dec(ctx, ply_words(",
              base,
              b")[",
              at,
              b"]); ply_words(",
              base,
              b")[",
              at,
              b"] = ",
              held_word(v),
              b";",
            ]),
          )
        },
      },
    }
  });
  let moved = line(written, Bytes::concat_all([r.value.expr, b" = ", base, b";"]));
  let otherwise = indent(line(outdent(moved), b"} else {"));
  // The general branch starts from the state before the test, its text after the first branch's.
  match built(
      {
        ..r.emitter,
        out: otherwise.out,
        temp_count: otherwise.temp_count,
        indent: otherwise.indent,
      },
      held.vals,
      true,
    ) {
    None -> None,
    // A record held back is made here, the join taking its word, and what the branch held is let
    // go before its block closes.
    Some(b) -> {
      let joined = line(
        outdent(
          release_at(
            line(
              spend_made(materialise(b.emitter, b.value.expr, true), b.value.expr),
              Bytes::concat_all([r.value.expr, b" = ", as_word(b.value), b";"]),
            ),
            otherwise.indent,
          ),
        ),
        b"}",
      );
      Some({
        emitter: note_made(joined, r.value.expr),
        value: { kind: KBoxed, expr: r.value.expr, ty: TyRec(fs) },
      })
    },
  }
}

/// A field read. A record held in place that a last read hands on moves out of its holder where
/// `moves`; one read through to a field of its own stays put.
fn read_field(
  emitter: Emitter,
  c: Code,
  f: { base: Code, field: Bytes },
  params: List<EmitParam>,
  moves: Bool,
) -> Option<WithValue> / {abort.raise} =
  match match f.base.node {
      NField(g) -> read_field(notail(emitter), f.base, g, params, false),
      _ -> expr(notail(emitter), f.base, params),
    } {
    None -> None,
    Some(b) -> match built_field(b.emitter, b.value.expr, f.field) {
      // Built in this body: the value is already in a register; asking for the word would force the record into memory.
      Some(v) -> {
        let last = moves && (c.own == Owned || spendable(b.emitter, b.value.expr));
        let kept = match moved_field(b.emitter, last, b.value, v) {
          // Nothing asks for the record's word after: the field's count is then the only one.
          Some(m) ->
            {
              emitter: let_go_word(note_made(m.emitter, m.value.expr), b.value.expr),
              value: m.value,
            },
          None -> secure_field(b.emitter, f.base, b.value, v),
        };
        match release_base(kept.emitter, f.base, b.value, params) {
          None -> None,
          Some(r) -> Some({ emitter: r, value: kept.value }),
        }
      },
      None -> {
        let held = bind(b.emitter, KBoxed, as_word(b.value));
        // Under release the rename is the holder: the temporary it renamed was nulled.
        let hv = if b.emitter.release { { kind: KBoxed, expr: held.value.expr, ty: b.value.ty } }
        else { b.value };
        match field_at(typed_value(b.emitter, f.base, b.value).ty, f.field) {
          // A known shape reads at the field's offset; a scalar field goes into a register of its kind.
          Some(i) -> {
            let w = bind_keeping(
              held.emitter,
              word_kind(i.kind),
              i.ty,
              field_read(held.value.expr, i),
            );
            match i.kind {
              // Without release a word-kinded field never releases its base: there is no in-place field take.
              // Under release a base at its last use is let go here, the field duplicated first, as `rt_field` does.
              k if counted(k) -> if w.emitter.release && base_owned(f.base)
                  && spendable(w.emitter, hv.expr) {
                let once = if width_of(i.ty) != None && moves {
                  took(w.emitter, held.value.expr, i.at, w.value.expr)
                } else { line(w.emitter, Bytes::concat_all([b"ply_inc(", w.value.expr, b");"])) };
                let tf = note_made(once, w.value.expr);
                match release_base(tf, f.base, hv, params) {
                  None -> None,
                  Some(r) -> Some({ emitter: r, value: w.value }),
                }
              } else if takes_field(w.emitter, c, f.base, b.value.expr) {
                let taken = if width_of(i.ty) != None {
                  if moves { took(w.emitter, held.value.expr, i.at, w.value.expr) }
                  else { line(w.emitter, Bytes::concat_all([b"ply_inc(", w.value.expr, b");"])) }
                } else {
                  line(
                    w.emitter,
                    Bytes::concat_all([
                      b"if (ply_obj(",
                      held.value.expr,
                      b")->rc == 1) { ply_words(",
                      held.value.expr,
                      b")[",
                      ascii_of_int(i.at),
                      if i.kind == KSum(Zeroed) { b"] = 0; } else { ply_inc(" }
                      else { b"] = ply_unit; } else { ply_inc(" },
                      w.value.expr,
                      b"); }",
                    ]),
                  )
                };
                Some({ emitter: note_made(taken, w.value.expr), value: w.value })
              } else { Some({ emitter: w.emitter, value: w.value }) },
              _ -> {
                let out = bind(w.emitter, i.kind, if raw_slot(i.kind) {
                  raw_at(held.value.expr, ascii_of_int(i.at), i.kind)
                } else if i.kind == KFloat { Bytes::concat_all([b"ply_f64(", w.value.expr, b")"]) }
                else { as_kind(w.value, i.kind) });
                match release_base(out.emitter, f.base, hv, params) {
                  None -> None,
                  Some(r) -> Some({ emitter: r, value: out.value }),
                }
              },
            }
          },
          // Unknown shape: the runtime reads by name through this body's field table; a word-kinded field does not release its base.
          None -> {
            let idx = field_of(open_needed(held.emitter, b.value.ty), f.field);
            // Under release the runtime takes a base at its last use, or the field out of a base it holds alone.
            let take = idx.emitter.release && base_owned(f.base) && spendable(idx.emitter, hv.expr);
            let w = bind(
              idx.emitter,
              KBoxed,
              Bytes::concat_all([
                b"rt_field_p(ctx, ",
                held.value.expr,
                b", @@f",
                ascii_of_int(idx.i),
                b"@@, ",
                if take { b"1" }
                else if takes_field(idx.emitter, c, f.base, b.value.expr) { b"2" }
                else { b"0" },
                b")",
              ]),
            );
            let spent = if take {
              line(spend_made(w.emitter, hv.expr), Bytes::concat_all([hv.expr, b" = 0;"]))
            } else { w.emitter };
            Some({ emitter: check(spent), value: w.value })
          },
        }
      },
    },
  }

/// Whether `name` called is the builtin `builtin`: no definition of this module and no import takes
/// it.
fn names_builtin(emitter: Emitter, name: Bytes, builtin: Bytes) -> Bool =
  name == builtin && !emitter.here.fold(false, |acc: Bool, h: Def| acc || h.name == name)
    && from_import(emitter.imports, name) == None

/// Where call `a` read at `field` is `xs.get(i).field` of a `Columns` the checker settled
/// to records: the field's place among its record's fields, and how the record holds it.
fn columns_field(
  emitter: Emitter,
  a: { func: Code, args: List<Code> },
  field: Bytes,
) -> Option<{ k: Int, f: FieldTy }> =
  match a.func.node {
    NVar(fv) -> if fv.slot != None || a.args.len() != 2
        || !names_builtin(emitter, fv.name, b"Columns::get") { None } else {
      match emitter.typed.get(span_key(a.func.span)) {
        None -> None,
        Some(t) -> match t.args.at(0) {
          None -> None,
          Some(element) -> match kind_of(element).ty {
            TyRec(fs) ->
              range(0, fs.len()).fold(None, |found: Option<{ k: Int, f: FieldTy }>, k: Int|
                match fs.at(k) {
                  Some(x) -> if x.name == field { Some({ k: k, f: x }) } else { found },
                  None -> found,
                }),
            _ -> None,
          },
        },
      }
    },
    _ -> None,
  }

/// Field `at.f` of record `i` of `xs`, given as `words`, which it takes: loaded from its column
/// where `xs` is laid out in columns and `i` is in range, with no record made; otherwise read by the
/// runtime, which raises as `Columns::get` does.
fn columns_load(
  emitter: Emitter,
  words: List<Bytes>,
  at: { k: Int, f: FieldTy },
  span: Span,
) -> WithValue = {
  let xs = match words.at(0) { Some(w) -> w, None -> b"0" };
  let given = match words.at(1) { Some(w) -> w, None -> b"0" };
  let idx = bind(site(emitter, span), KInt, as_int({ kind: KBoxed, expr: given, ty: TyOpen([]) }));
  let kind = at.f.kind;
  let out = fresh(idx.emitter);
  let column = Bytes::concat_all([b"ply_words(", xs, b")[", ascii_of_int(at.k), b"]"]);
  let opened = line(
    line(
      out.emitter,
      Bytes::concat_all([ctype(kind), b" ", out.name, b" = ", zero_of(kind), b";"]),
    ),
    Bytes::concat_all([
      b"if (ply_obj(",
      xs,
      b")->kind == PLY_KIND_COLUMNS && (uint64_t)",
      idx.value.expr,
      b" < (uint64_t)ply_array_len(",
      column,
      b")) {",
    ]),
  );
  let fast = line(
    indent(opened),
    Bytes::concat_all([
      out.name,
      b" = ",
      column_read(column, idx.value.expr, at.f),
      b";",
      if counted(kind) { Bytes::concat_all([b" ply_inc(", out.name, b");"]) } else { b"" },
    ]),
  );
  let call = Bytes::concat_all([
    b"rt_columns_field_p(ctx, ",
    xs,
    b", ",
    idx.value.expr,
    b", ",
    ascii_of_int(at.k),
    b")",
  ]);
  let otherwise = indent(line(outdent(fast), b"} else {"));
  let slow = if kind == KBoxed {
    check(line(otherwise, Bytes::concat_all([out.name, b" = ", call, b";"])))
  } else if kind == KSum(Zeroed) {
    // The runtime answers the `Option`'s object, which opening takes.
    check(line(otherwise, Bytes::concat_all([out.name, b" = rt_maybe_open_p(ctx, ", call, b");"])))
  } else {
    let w = fresh(otherwise);
    line(
      check(line(w.emitter, Bytes::concat_all([b"Word ", w.name, b" = ", call, b";"]))),
      Bytes::concat_all([
        out.name,
        b" = ",
        as_kind({ kind: KBoxed, expr: w.name, ty: TyOpen([]) }, kind),
        b"; ply_dec(ctx, ",
        w.name,
        b");",
      ]),
    )
  };
  let closed = line(
    line(outdent(slow), b"}"),
    Bytes::concat_all([b"ply_dec(ctx, ", xs, b"); ply_dec(ctx, ", given, b");"]),
  );
  {
    emitter: if counted(kind) { note_made(closed, out.name) } else { closed },
    value: { kind: kind, expr: out.name, ty: at.f.ty },
  }
}

/// Element `i` of `column`, an array of field `f`'s values, read as the field is held: a record in
/// place as the address of its header, a scalar its record holds raw as its kind, any other as the
/// kind its word holds.
fn column_read(column: Bytes, i: Bytes, f: FieldTy) -> Bytes = {
  let at = Bytes::concat_all([b"(", i, b") * ply_obj(", column, b")->aux"]);
  match f.ty {
    TyRec(_) -> Bytes::concat_all([b"((Word)(intptr_t)(ply_words(", column, b") + ", at, b"))"]),
    _ -> if raw_slot(f.kind) { raw_at(column, at, f.kind) }
    else if f.kind == KSum(Zeroed) { Bytes::concat_all([b"ply_words(", column, b")[", i, b"]"]) }
    else {
      as_kind(
        {
          kind: KBoxed,
          expr: Bytes::concat_all([b"ply_words(", column, b")[", i, b"]"]),
          ty: TyOpen([]),
        },
        f.kind,
      )
    },
  }
}

/// A read, as `own`, of `v`, what the window holds for a slot, typed as `typed`.
fn window_read(emitter: Emitter, own: Own, v: CValue, typed: CValue) -> WithValue =
  match slice_of(emitter, v.expr) {
    Some(sl) -> sliced_list(emitter, sl, v.ty),
    None -> match held_sum_of(emitter, v.expr) {
      Some(h) -> held_sum_read(emitter, own, h, typed),
      None -> move_read(emitter, own, typed),
    },
  }

/// The read `c` of the slot `s`, a variable named `name`: what the window holds for it, or a
/// parameter the prologue did not open as its own word.
fn slot_read(
  emitter: Emitter,
  c: Code,
  s: Int,
  name: Bytes,
  params: List<EmitParam>,
) -> Option<WithValue> =
  match conv_of(emitter, s) {
    Some(v) -> Some(window_read(emitter, c.own, v, typed_value(emitter, c, v))),
    // A parameter the prologue did not open (a record) is read as its own word each time.
    None -> match params.at(s) {
      None -> Some(refused(emitter, b"a local this port has not bound: ".concat(name))),
      Some(p) -> match p.kind {
        KBoxed ->
          Some(
            move_read(
              emitter,
              c.own,
              typed_value(emitter, c, {
                kind: KBoxed,
                expr: b"p".concat(ascii_of_int(s)),
                ty: p.ty,
              }),
            ),
          ),
        KSum(spec) ->
          Some(
            move_read(
              emitter,
              c.own,
              typed_value(emitter, c, {
                kind: KSum(spec),
                expr: b"p".concat(ascii_of_int(s)),
                ty: p.ty,
              }),
            ),
          ),
        _ -> Some(refused(emitter, b"a scalar parameter read outside its window: ".concat(name))),
      },
    },
  }

/// A read of a slot holding the sum `h` held back, as `value`. Where its constructor and argument are
/// taken, its last read hands them on and any other a copy of them, counted again; elsewhere its
/// word is made, taking them at its last read.
fn held_sum_read(emitter: Emitter, own: Own, h: HeldSum, value: CValue) -> WithValue = {
  let last = own == Owned && !is_pinned(emitter, value.expr);
  if emitter.leaves {
    if last { { emitter: emitter, value: value } } else {
      let copied = h.args.fold(
        { emitter: emitter, args: [] },
        |acc: { emitter: Emitter, args: List<Option<CValue>> }, a: Option<CValue>|
          match a {
            None -> { ..acc, args: acc.args.push(None) },
            Some(v) -> if !counted(v.kind) { { ..acc, args: acc.args.push(Some(v)) } } else {
              match deferred_of(acc.emitter, v.expr) {
                Some(d) -> {
                  let r = copied_record(acc.emitter, v, d);
                  { emitter: r.emitter, args: acc.args.push(Some(r.value)) }
                },
                None -> {
                  let w = owned_word(acc.emitter, v);
                  {
                    emitter: note_holder(w.emitter, w.value.expr),
                    args: acc.args.push(Some(w.value)),
                  }
                },
              }
            },
          },
      );
      let f = fresh(copied.emitter);
      {
        emitter: note_held_sum(f.emitter, { ..h, name: f.name, args: copied.args }),
        value: { ..value, expr: f.name },
      }
    }
  } else {
    let w = sum_made(emitter, h, last);
    if last { move_read(w, Owned, value) } else { { emitter: w, value: value } }
  }
}

fn expr(emitter: Emitter, c: Code, params: List<EmitParam>) -> Option<WithValue> / {abort.raise} =
  match c.node {
    NLabel(n) -> {
      let f = field_of(emitter, n);
      Some({ emitter: f.emitter, value: { kind: KInt, expr: field_ref(f.i), ty: TyOpen([]) } })
    },
    NLit(l) -> match l {
      LInt(n) ->
        Some({ emitter: emitter, value: { kind: KInt, expr: int_lit(n), ty: TyOpen([]) } }),
      // A `Bool` is C's 1 or 0 until something asks for its word.
      LBool(b) ->
        Some({
          emitter: emitter,
          value: { kind: KBool, expr: if b { b"1" } else { b"0" }, ty: TyOpen([]) },
        }),
      // A literal the tag cannot hold is read from the unit's constant table; the helper can raise.
      LStr(_) -> Some(from_table(emitter, l)),
      LBytes(_) -> Some(from_table(emitter, l)),
      // Below 64 bits a literal is its C type's own; wider, it is the runtime's own word from the constant table, as a parameter of its type is.
      LFixed(name, bits) -> match width_named(name) {
        None -> Some(refused(emitter, b"a fixed-width literal of no known width")),
        Some(w) -> if carried(w) {
          Some({
            emitter: emitter,
            value: {
              kind: KNum(w),
              expr: Bytes::concat_all([b"((", ctype(KNum(w)), b")", int_lit(bits), b")"]),
              ty: TyOpen([]),
            },
          })
        } else { Some(from_table(emitter, l)) },
      },
      // A 64-bit literal past an `Int` is its low word's bits.
      LWide(name, _, low) -> match width_named(name) {
        Some(w) -> if carried(w) {
          Some({
            emitter: emitter,
            value: {
              kind: KNum(w),
              expr: Bytes::concat_all([b"((", ctype(KNum(w)), b")", int_lit(low), b")"]),
              ty: TyOpen([]),
            },
          })
        } else { Some(from_table(emitter, l)) },
        None -> Some(from_table(emitter, l)),
      },
      LUnit -> Some(from_table(emitter, l)),
      LFloat(x) ->
        Some({
          emitter: emitter,
          value: {
            kind: KFloat,
            expr: Bytes::concat_all([b"ply_f64(", int_lit(literal_bits(x)), b")"]),
            ty: TyOpen([]),
          },
        }),
      LDec(_) -> Some(from_table(emitter, l)),
      LChar(v) ->
        Some({
          emitter: emitter,
          value: {
            kind: KBoxed,
            expr: Bytes::concat_all([b"((Word)", int_lit(v * 8 + 2), b")"]),
            ty: TyOpen([]),
          },
        }),
      _ -> Some(refused(emitter, b"a literal this port does not pool")),
    },
    NVar(v) -> match v.slot {
      None -> if is_ctor_name(v.name) { Some(ctor_value(emitter, c, v.name)) } else {
        match def_of(emitter, v.name) {
          // A definition used as a value is a closure over its entry, a nullary one too: calling it here would run its body before, and outside the handlers of, any call.
          Some(d) -> {
            let named = named_ref(emitter, d.full, Some(d.def), c.span, []);
            let l = lambda_of(named.emitter, Bytes::concat_all([named.symbol, b"_entry"]));
            let arr = fresh(l.emitter);
            let e = line(arr.emitter, Bytes::concat_all([b"Word ", arr.name, b"[] = {0};"]));
            let o = bind(
              e,
              KBoxed,
              Bytes::concat_all([
                b"rt_closure_p(ctx, @@l",
                ascii_of_int(l.i),
                b"@@, ",
                ascii_of_int(d.arity),
                b", (Word)(intptr_t)",
                arr.name,
                b", 0)",
              ]),
            );
            Some({ emitter: note_made(check(o.emitter), o.value.expr), value: o.value })
          },
          None -> if is_width_builtin(v.name) {
            Some(refused(emitter, b"a width builtin left unwritten as a value: ".concat(v.name)))
          } else if emitter.builtins.fold(false, |acc: Bool, b2: Bytes| acc || b2 == v.name) {
            let bi = builtin_of(emitter, v.name);
            let o = bind(
              bi.emitter,
              KBoxed,
              Bytes::concat_all([b"rt_builtin_value_p(ctx, @@b", ascii_of_int(bi.i), b"@@)"]),
            );
            Some({ emitter: check(o.emitter), value: o.value })
          } else { Some(refused(emitter, b"a global this port cannot resolve: ".concat(v.name))) },
        }
      },
      Some(s) -> slot_read(emitter, c, s, v.name, params),
    },
    NBinary(b) ->      // Two `Int` literals under an operator fold to one, checked, so an overflow is left for the runtime.
      match lit_int(c) {
        Some(n) ->
          Some({ emitter: emitter, value: { kind: KInt, expr: int_lit(n), ty: TyOpen([]) } }),
        None -> if b.op == b"and" || b.op == b"or" {
          match expr(notail(emitter), b.lhs, params) {
            None -> None,
            Some(l) -> {
              let out = fresh(l.emitter);
              let opened = line(
                out.emitter,
                Bytes::concat_all([b"int64_t ", out.name, b" = ", as_bool(l.value), b";"]),
              );
              let branch = if b.op == b"and" { Bytes::concat_all([b"if (", out.name, b") {"]) }
              else { Bytes::concat_all([b"if (!", out.name, b") {"]) };
              match expr(withtail(indent(line(opened, branch)), position(emitter)), b.rhs, params) {
                None -> None,
                Some(r) -> {
                  let assigned = line(
                    r.emitter,
                    Bytes::concat_all([out.name, b" = ", as_bool(r.value), b";"]),
                  );
                  // Only one path runs the branch: what it moved is still held on the other.
                  let closed = close(assigned);
                  Some({
                    emitter: with_made(
                      closed,
                      union_made(opened.count_locals, closed.count_locals),
                    ),
                    value: { kind: KBool, expr: out.name, ty: TyOpen([]) },
                  })
                },
              }
            },
          }
        }
        // `++` takes both operands.
        else if b.op == b"concat" {
          match secured(expr(notail(emitter), b.lhs, params)) {
            None -> None,
            Some(l) -> match expr(notail(l.emitter), b.rhs, params) {
              None -> None,
              Some(r) -> {
                let lo = owned(r.emitter, l.value);
                let ro = owned(lo.emitter, r.value);
                let o = bind(
                  ro.emitter,
                  KBoxed,
                  Bytes::concat_all([
                    b"rt_concat_p(ctx, ",
                    lo.value.expr,
                    b", ",
                    ro.value.expr,
                    b")",
                  ]),
                );
                Some({ emitter: check(o.emitter), value: o.value })
              },
            },
          }
        } else if !is_arithmetic(b.op) && compare_op(b.op) == None && !is_bitop(b.op)
            && !is_shift(b.op) {
          Some(refused(emitter, b"an operator this port does not emit: ".concat(b.op)))
        } else {
          let emitter = operand_needed(emitter, c.span, b.op == b"eq" || b.op == b"ne");
          match operand_at(emitter, c.span) {
            None -> Some(unsettled_operator(emitter, b.op)),
            Some(t) -> match secured(expr(notail(emitter), b.lhs, params)) {
              None -> None,
              // A value compared with a constructor of its sum is tested as a pattern tests it,
              // the constructor's arguments compared where the value holds its own.
              Some(l) -> match compared_ctor(l.emitter, b.op, t, l.value, b.rhs) {
                Some(tag) -> match b.rhs.node {
                  NApp(a) -> match a.args.fold(
                      Some({ emitter: notail(l.emitter), vals: [] }),
                      |acc: Option<{ emitter: Emitter, vals: List<CValue> }>, x: Code|
                        match acc {
                          None -> None,
                          Some(g) -> match expr(notail(g.emitter), x, params) {
                            None -> None,
                            Some(o) -> {
                              let s = secure(o.emitter, o.value);
                              Some({ emitter: s.emitter, vals: g.vals.push(s.value) })
                            },
                          },
                        },
                    ) {
                    None -> None,
                    Some(g) -> Some(ctor_compared(g.emitter, b.op, l.value, tag, g.vals)),
                  },
                  _ -> Some(ctor_compared(l.emitter, b.op, l.value, tag, [])),
                },
                None -> match expr(notail(l.emitter), b.rhs, params) {
                  None -> None,
                  Some(r) ->
                    binary_rest(
                      if is_arithmetic(b.op) || is_shift(b.op) { site(r.emitter, c.span) }
                      else { r.emitter },
                      b.op,
                      l.value,
                      r.value,
                      t,
                      c.span,
                    ),
                },
              },
            },
          }
        },
      },
    // A block binds its tail even with no statements, so an `if` branch shows a rename it did not ask for.
    NBlock(bl) -> match bl.tail {
      None -> match stmts(emitter, bl.stmts, params, 0) {
        None -> None,
        Some(after) -> Some(bind(withtail(after, position(emitter)), KBoxed, b"ply_unit")),
      },
      Some(t) -> match stmts(emitter, bl.stmts, params, 0) {
        None -> None,
        // The block's tail is a tail when the block is; its statements are not.
        Some(after) -> match expr(withtail(after, position(emitter)), t, params) {
          None -> None,
          Some(o) -> Some(bind_keeping(o.emitter, o.value.kind, o.value.ty, o.value.expr)),
        },
      },
    },
    NUnary(u) -> if u.op == b"not" {
      match expr(notail(emitter), u.operand, params) {
        None -> None,
        Some(o) -> Some(bind(o.emitter, KBool, Bytes::concat_all([b"!(", as_bool(o.value), b")"]))),
      }
    } else if u.op == b"neg" || u.op == b"bitnot" {
      let emitter = operand_needed(emitter, c.span, false);
      match operand_at(emitter, c.span) {
        None -> Some(unsettled_operator(emitter, u.op)),
        Some(t) -> match expr(notail(emitter), u.operand, params) {
          None -> None,
          Some(o) -> if u.op == b"neg" { negated(o.emitter, o.value, t, c.span) }
          else { inverted(o.emitter, o.value, t) },
        },
      }
    } else { None },
    // A lambda is a closure and also a function written after the one that builds it.
    // A nested lambda is one more of the owner's: numbered after its container, its entry interned before its body.
    NLambda(l) -> closure_value(emitter, l, params),
    NList(l) -> match items(emitter, l.items, params, 0, []) {
      None -> None,
      Some(w) -> {
        let arr = fresh(w.emitter);
        // C has no empty initialiser, so an empty list still declares one word.
        let e = line(
          arr.emitter,
          Bytes::concat_all([
            b"Word ",
            arr.name,
            b"[] = {",
            if w.names.len() == 0 { b"0" } else { bytes_join(w.names, b", ") },
            b"};",
          ]),
        );
        let o = bind(
          e,
          KBoxed,
          Bytes::concat_all([
            b"rt_list_p(ctx, (Word)(intptr_t)",
            arr.name,
            b", ",
            ascii_of_int(l.items.len()),
            b")",
          ]),
        );
        Some({ emitter: check(o.emitter), value: o.value })
      },
    },
    // `xs.get(i).f` reads its field from its column.
    NField(f) -> match f.base.node {
      NApp(a) -> match columns_field(emitter, a, f.field) {
        Some(at) -> match items(emitter, a.args, params, 0, []) {
          None -> None,
          Some(w) -> Some(columns_load(w.emitter, w.names, at, c.span)),
        },
        None ->
          read_field(builtin_needed(emitter, b"Columns::get", a.func.span), c, f, params, true),
      },
      _ -> read_field(emitter, c, f, params, true),
    },
    // `{..b, f: e}` reuses the base's memory: the base is released before the allocation, so its cells are the token.
    // Order: the written fields are evaluated, then the base read, then each field filled in shape order.
    NUpdate(u) -> {
      let names = sorted_names(u.copies.concat(u.sets.map(|f: CodeField| f.name)));
      let laid = laid_out(emitter, c.span, names);
      let emitter = if laid == None { layout_needed_at(emitter, c.span) } else { emitter };
      // Each written field is evaluated and bound before the base is read.
      match sets_bound(emitter, u.sets.map(|f: CodeField| f.value), params, 0, []) {
        None -> None,
        Some(ev) -> match typed(u.base, expr(notail(ev.emitter), u.base, params)) {
          None -> None,
          Some(bv) -> {
            let held = bind(bv.emitter, KBoxed, as_word(bv.value));
            let hv = if bv.emitter.release {
              { kind: KBoxed, expr: held.value.expr, ty: bv.value.ty }
            } else { bv.value };
            // A copy the base remembered is its value, not a load; any word read from memory stops the record being held back.
            // `owned`: the written fields' values are words the record takes as they are.
            let built = |from: Emitter, vals: List<CValue>, owned_already: Bool| {
              let filled = range(0, names.len()).fold(
                { emitter: from, ws: [], kinds: [], vals: [], known: true },
                |acc: Filled, at: Int|
                  update_field(
                    acc,
                    {
                      copies: u.copies,
                      sets: u.sets,
                      names: names,
                      laid: laid,
                      base: held.value,
                      base_ty: bv.value.ty,
                      vals: vals,
                      owned: owned_already,
                    },
                    at,
                  ),
              );
              // At the body's tail the release skips the one-read guard: no later read can exist.
              match release_from(filled.emitter, u.base, hv, params, emitter.tail) {
                None -> None,
                Some(rel) -> match laid {
                  None -> Some(record_by_value(rel, names, filled.ws)),
                  Some(fs) ->
                    Some(
                      build_record(
                        rel,
                        names,
                        filled.ws,
                        fs,
                        if filled.known { Some(filled.vals) } else { None },
                        b"0",
                      ),
                    ),
                },
              }
            };
            match laid {
              Some(fs) -> if updates_in_place(held.emitter, u.base, hv, fs) {
                in_place_update(held.emitter, hv.expr, names, fs, u.sets, ev.vals, built)
              } else { built(held.emitter, ev.vals, false) },
              None -> built(held.emitter, ev.vals, false),
            }
          },
        },
      }
    },
    // Values evaluated in written order, assembled in sorted-name order, from a reuse token of this width when there is one.
    NRecord(r) -> {
      let names = r.fields.map(|f: CodeField| f.name);
      let sorted = sorted_names(names);
      match laid_out(emitter, c.span, sorted) {
        None -> match items(
            layout_needed_at(emitter, c.span),
            r.fields.map(|f: CodeField| f.value),
            params,
            0,
            [],
          ) {
          None -> None,
          Some(w) ->
            Some(
              record_by_value(
                w.emitter,
                sorted,
                range(0, sorted.len()).map(|at: Int| word_at_rank(names, w.names, at)),
              ),
            ),
        },
        Some(fields) -> match items_laid(
            emitter,
            r.fields.map(|f: CodeField| f.value),
            params,
            names.map(|nm: Bytes| nth_field(fields, rank_of(names, nm))),
          ) {
          None -> None,
          Some(w) -> {
            let vals = sorted.map(|nm: Bytes|
              match range(0, names.len()).fold(None, |acc: Option<CValue>, i: Int|
                  match names.at(i) {
                    Some(x) -> if x == nm { w.vals.at(i) } else { acc },
                    None -> acc,
                  }) {
                Some(v) -> v,
                None -> { kind: KBoxed, expr: b"0", ty: TyOpen([]) },
              });
            Some(
              build_record(
                w.emitter,
                sorted,
                range(0, sorted.len()).map(|at: Int| word_at_rank(names, w.names, at)),
                fields,
                Some(vals),
                b"0",
              ),
            )
          },
        },
      }
    },
    NApp(a) -> match a.func.node {
      // A name bound in this body holds a closure, called through the runtime; a constructor builds a tagged object.
      NVar(fv) -> match fv.slot {
        Some(_) -> call_value(emitter, a.func, a.args, params, c.span),
        None -> if fv.name == stated_witness_name() { stated_witness(emitter, a.args) }
        else if is_ctor_name(fv.name) {
          match tag_of(emitter, fv.name) {
            None -> Some(refused(emitter, b"a constructor not in the table: ".concat(fv.name))),
            // A sum taken as its constructor and argument is held back as them. A `Result` the root
            // answers as one word is built as that word; anywhere else it is the object, which may
            // take the cells of the one a match let go.
            Some(tag) -> if ctor_case(emitter, c, tag) != None {
              let at = ctor_case(emitter, c, tag);
              match a.args.fold(
                  Some({ emitter: notail(emitter), vals: [] }),
                  |acc: Option<{ emitter: Emitter, vals: List<CValue> }>, x: Code|
                    match acc {
                      None -> None,
                      Some(g) -> match expr(notail(g.emitter), x, params) {
                        None -> None,
                        Some(o) -> Some({ emitter: o.emitter, vals: g.vals.push(o.value) }),
                      },
                    },
                ) {
                None -> None,
                Some(g) -> Some(held_ctor(g.emitter, at, g.vals)),
              }
            } else if (is_option(emitter, tag, b"Ok") || is_option(emitter, tag, b"Err"))
                && a.args.len() == 1
                && answers_sum(emitter) == Some(Tagged) {
              match items(emitter, a.args, params, 0, []) {
                None -> None,
                Some(w) -> match w.names.at(0) {
                  None -> None,
                  Some(word) -> Some(held_tagged(w.emitter, word, is_option(emitter, tag, b"Err"))),
                },
              }
            } else if is_option(emitter, tag, b"Some") && a.args.len() == 1 {
              match items(emitter, a.args, params, 0, []) {
                None -> None,
                Some(w) -> match w.names.at(0) {
                  None -> None,
                  Some(payload) ->
                    Some(
                      held_maybe(w.emitter, payload, match w.vals.at(0) {
                        Some(v) -> v.ty,
                        None -> TyOpen([]),
                      }),
                    ),
                },
              }
            } else {
              match ctor_fields(emitter, tag) {
                Some(fs) -> match items_laid(emitter, a.args, params, fs) {
                  None -> None,
                  Some(w) -> Some(ctor_laid(w.emitter, tag, fs, w.names, w.vals)),
                },
                None -> match items(emitter, a.args, params, 0, []) {
                  None -> None,
                  Some(w) -> if w.names.len() > 0 { Some(ctor_built(w.emitter, tag, w.names)) }
                  else {
                    let arr = fresh(w.emitter);
                    let e = line(
                      arr.emitter,
                      Bytes::concat_all([b"Word ", arr.name, b"[] = {0};"]),
                    );
                    let o = bind(
                      e,
                      KBoxed,
                      Bytes::concat_all([
                        b"rt_ctor_p(ctx, ",
                        tag_text(emitter, tag),
                        b", (Word)(intptr_t)",
                        arr.name,
                        b", 0)",
                      ]),
                    );
                    Some({ emitter: check(o.emitter), value: o.value })
                  },
                },
              }
            },
          }
        } else {
          // A pure nullary definition is read from the runtime's constant table, not called.
          if a.args.len() == 0 && constant_of(emitter, fv.name) != None {
            match constant_of(emitter, fv.name) {
              None -> None,
              Some(k) -> {
                let noted = note_call(site(emitter, c.span), k.full);
                let l = lambda_of(noted, entry_of(k.full));
                let held = bind(
                  l.emitter,
                  KBoxed,
                  Bytes::concat_all([b"rt_constant_p(ctx, @@l", ascii_of_int(l.i), b"@@)"]),
                );
                Some(opened_to(check(held.emitter), held.value, k.ret))
              },
            }
          } else if in_place_at(emitter, fv.name) != None {
            match in_place_at(emitter, fv.name) {
              None -> None,
              Some(op) -> match args_evaled(emitter, a.args, params, 0, []) {
                None -> None,
                Some(w) ->
                  Some(
                    written_in_place(
                      w.emitter,
                      op,
                      w.vals,
                      emitter.typed.get(span_key(a.func.span)),
                    ),
                  ),
              },
            }
          } else if !emitter.here.fold(false, |acc: Bool, h: Def| acc || h.name == fv.name) {
            // Not this module's: an import, which takes the name where it has it, else a builtin. A
            // name an imported module holds no definition of is its extern, the builtin of its own
            // name.
            let via = match qualified(fv.name) {
              Some(q) -> module_import(emitter.imports, q.binder),
              None -> from_import(emitter.imports, fv.name),
            };
            let own = match qualified(fv.name) { Some(q) -> q.name, None -> fv.name };
            let external = match via {
              Some(imp) -> match def_named(imp.defs, own) {
                Some(_) -> false,
                None -> emitter.builtins.fold(false, |acc: Bool, b2: Bytes| acc || b2 == own),
              },
              None -> false,
            };
            let fv = if external { { ..fv, name: own } } else { fv };
            match if external { None } else { via } {
              // Callback and inline builtins outside their fused shapes are refused: a plain call for them is a wrong answer, not a slow one.
              None -> match match lookup_helper(fv.name, a.args.len()) {
                  Some(h) -> match args_owned_at(notail(emitter), a.args, params, c.span) {
                    None -> None,
                    Some(w) -> Some(looked_up(w.emitter, h, w.names)),
                  },
                  None -> fused_fold(emitter, fv.name, a.args, params, c.span),
                } {
                Some(o) -> Some(o),
                None -> match iterate_call(emitter, fv.name, a.args, params, c.span) {
                  Some(o) -> Some(o),
                  None -> match position_call(emitter, fv.name, a.args, params, c.span) {
                    Some(o) -> Some(o),
                    None -> match width_builtin(
                        emitter,
                        fv.name,
                        a.args,
                        params,
                        c.span,
                        a.func.span,
                      ) {
                      Some(o) -> Some(o),
                      None -> match inline_len(
                          builtin_needed(emitter, fv.name, a.func.span),
                          fv.name,
                          a.args,
                          params,
                          c.span,
                        ) {
                        Some(o) -> Some(o),
                        None -> if is_callback(fv.name) || is_inlined(fv.name) {
                          Some(
                            refused(
                              emitter,
                              b"a callback or inline builtin outside its fused shape: ".concat(
                                fv.name,
                              ),
                            ),
                          )
                        } else if !emitter.builtins.fold(false, |acc: Bool, b2: Bytes|
                            acc || b2 == generated_builtin(fv.name)) {
                          Some(
                            refused(emitter, b"a name this port cannot resolve: ".concat(fv.name)),
                          )
                        } else {
                          // `List::map` and `List::filter` duplicate the list before the closure is built; the rest evaluate everything first.
                          match if fv.name == b"List::map" || fv.name == b"List::filter" {
                              args_carried(emitter, a.args, params, [], 0, [])
                            } else if fv.name == b"Map::fold" {
                              args_owned(emitter, a.args, params, 0, [])
                            } else {
                              args_owned_at(
                                builtin_needed(emitter, fv.name, a.func.span),
                                a.args,
                                params,
                                c.span,
                              )
                            } {
                            None -> None,
                            Some(w) -> {
                              let o = bind(
                                w.emitter,
                                KBoxed,
                                builtin_call_over(generated_builtin(fv.name), w.names),
                              );
                              Some({ emitter: check(o.emitter), value: o.value })
                            },
                          }
                        },
                      },
                    },
                  },
                },
              },
              // The same direct call, mangled with its module.
              Some(imp) -> {
                let callee = match qualified(fv.name) { Some(q) -> q.name, None -> fv.name };
                {
                  let full = Bytes::concat_all([imp.module, b".", callee]);
                  let target = call_target(
                    passed_on(emitter, full, a.args, params),
                    full,
                    def_named(imp.defs, callee),
                    a.func.span,
                    fn_args(emitter, a.args),
                  );
                  match args_carried(target.emitter, a.args, params, target.carriers.params, 0, [
                    ]) {
                    None -> None,
                    Some(w) ->
                      Some(
                        called(w.emitter, target, c.span, w.names, a.args.len(), emitter.leaves),
                      ),
                  }
                }
              },
            }
          } else if emitter.tail && emitter.landing == None
              && group_case(emitter, fv.name, a.args.len()) != None {
            match group_case(emitter, fv.name, a.args.len()) {
              None -> None,
              Some(which) ->
                group_tail(
                  note_call(emitter, qualify(emitter.module, fv.name)),
                  fv.name,
                  a.args,
                  params,
                  which,
                ),
            }
          } else if emitter.tail && emitter.landing == None
              && self_tail_leaf(emitter, fv.name, a.func.span, a.args, params) {
            self_tail(note_call(emitter, emitter.owner), fv.name, a.args, params)
          } else {
            {
              let full = qualify(emitter.module, fv.name);
              let target = call_target(
                passed_on(emitter, full, a.args, params),
                full,
                def_named(emitter.here, fv.name),
                a.func.span,
                fn_args(emitter, a.args),
              );
              match args_carried(target.emitter, a.args, params, target.carriers.params, 0, []) {
                None -> None,
                Some(w) ->
                  Some(called(w.emitter, target, c.span, w.names, a.args.len(), emitter.leaves)),
              }
            }
          }
        },
      },
      // The value and arguments are evaluated here, then the lambda's body in its own frame. The
      // frame reads its captures off the value, so no argument's last read of it may move it.
      NKnown(k) -> match lambda_frame(emitter, k.owner, k.nth) {
        None -> Some(refused(emitter, b"a lambda run in place that this root was not handed")),
        Some(frame) -> match slot_read(notail(emitter), a.func, k.slot, k.name, params) {
          None -> None,
          Some(f) -> match args_evaled(
              with_pinned(f.emitter, f.emitter.pinned.push(f.value.expr)),
              a.args,
              params,
              0,
              [],
            ) {
            None -> None,
            Some(w) -> {
              let unpinned = with_pinned(w.emitter, f.emitter.pinned);
              let inner = inlined_frame(unpinned, frame, f.value, w.vals, k.lambda);
              match expr(notail(inner), k.lambda.body, params) {
                None -> None,
                Some(r) -> Some(inlined_answer(emitter, inner.indent, r)),
              }
            },
          },
        },
      },
      // Any other callee -- a field holding a function, a call's answer -- is a value too.
      _ -> call_value(emitter, a.func, a.args, params, c.span),
    },
    NKnown(k) -> slot_read(emitter, c, k.slot, k.name, params),
    NMatch(m) -> match match_subject(emitter, m.scrutinee, params) {
      None -> None,
      Some(s) -> {
        let j = match_join(s.emitter, emitter, c, m.arms, params);
        match match_arms(
            j.emitter,
            s.subj,
            m.arms,
            params,
            j.sink,
            c.span,
            emitter.tail,
            emitter.leaves,
          ) {
          None -> None,
          Some(after) -> Some(joined_value(after, j.sink)),
        }
      },
    },
    NIf(i) -> match expr(notail(emitter), i.cond, params) {
      None -> None,
      Some(cnd) -> {
        // A condition is read as a bool: on a word that is the runtime's bool unbox, not the integer's.
        let cv = {
          emitter: cnd.emitter,
          value: { kind: KBool, expr: as_bool(cnd.value), ty: TyOpen([]) },
        };
        {
          // The join's number is taken before either arm; arms go into buffers because a record-valued join needs one local per field, numbered after both.
          let j = fresh(cv.emitter);
          match arm(withtail(blank(j.emitter), position(emitter)), i.then_branch, params) {
            None -> None,
            Some(t) -> match arm(
                withtail(
                  with_made(
                    beside(rescope(blank(t.emitter), cv.emitter.unboxed), cv.emitter),
                    j.emitter.count_locals,
                  ),
                  position(emitter),
                ),
                i.else_branch,
                params,
              ) {
              None -> None,
              Some(e) -> match leaves_cases(emitter, c) {
                Some(sc) -> Some(if_sum_join(j, cv, t, e, sc)),
                None -> {
                  // Asked with the later table, which holds what both arms built.
                  let shape = shared_shape(e.emitter, t.value, e.value);
                  match shape {
                    // Both arms built a record of one shape: the join carries one local per leaf and reassembles; the number taken above is spent, never declared.
                    Some(fields) -> {
                      let ls = record_locals(
                        rescope(blank(e.emitter), cv.emitter.unboxed),
                        fields,
                        empty_inits(fields),
                      );
                      let tt = joined(
                        { ..e.emitter, temp_count: ls.emitter.temp_count },
                        t.emitter,
                        t.text,
                        t.value,
                        fields,
                        ls,
                      );
                      let ee = joined(
                        { ..e.emitter, temp_count: tt.temps },
                        e.emitter,
                        e.text,
                        e.value,
                        fields,
                        ls,
                      );
                      let body = Bytes::concat_all([
                        bytes_join(j.emitter.out, b""),
                        bytes_join(ls.emitter.out, b""),
                        pad(ls.emitter.indent),
                        b"if (",
                        cv.value.expr,
                        b") {\n",
                        tt.text,
                        pad(ls.emitter.indent),
                        b"} else {\n",
                        ee.text,
                        pad(ls.emitter.indent),
                        b"}\n",
                      ]);
                      Some(
                        held_record(
                          {
                            ..ls.emitter,
                            out: [body],
                            temp_count: ee.temps,
                            count_locals: union_made(tt.made, ee.made),
                            deferred_locals: ee.declared.fold(
                              tt.declared,
                              |acc: List<Bytes>, n: Bytes|
                                if acc.contains(n) { acc } else { acc.push(n) },
                            ),
                          },
                          fields,
                          ls.values,
                          ls.word,
                        ),
                      )
                    },
                    None -> {
                      let kt = join_kind(emitter, t.value.kind, e.value.kind);
                      let decl = line(
                        {
                          out: [],
                          temp_count: e.emitter.temp_count,
                          unboxed: cv.emitter.unboxed,
                          indent: e.emitter.indent,
                          reads: e.emitter.reads,
                          shapes: e.emitter.shapes,
                          built: e.emitter.built,
                          module: e.emitter.module,
                          base: e.emitter.base,
                          count_locals: e.emitter.count_locals,
                          here: e.emitter.here,
                          imports: e.emitter.imports,
                          consts: e.emitter.consts,
                          ctors: e.emitter.ctors,
                          lambda_bodies: e.emitter.lambda_bodies,
                          lambdas: e.emitter.lambdas,
                          owner: e.emitter.owner,
                          builtins: e.emitter.builtins,
                          called_builtins: e.emitter.called_builtins,
                          fields: e.emitter.fields,
                          released: e.emitter.released,
                          reuse_widths: e.emitter.reuse_widths,
                          alias: e.emitter.alias,
                          by_root: e.emitter.by_root,
                          tail: e.emitter.tail,
                          calls: e.emitter.calls,
                          generics: e.emitter.generics,
                          refused: e.emitter.refused,
                          deferred: e.emitter.deferred,
                          deferred_locals: e.emitter.deferred_locals,
                          performs: e.emitter.performs,
                          handles: e.emitter.handles,
                          landing: e.emitter.landing,
                          effects: e.emitter.effects,
                          release: e.emitter.release,
                          pinned: e.emitter.pinned,
                          bound: e.emitter.bound,
                          group: e.emitter.group,
                          operands: e.emitter.operands,
                          typed: e.emitter.typed,
                          answer: e.emitter.answer,
                          site_root: e.emitter.site_root,
                          lent: e.emitter.lent,
                          written: e.emitter.written,
                          slices: e.emitter.slices,
                          sums: e.emitter.sums,
                          leaves: e.emitter.leaves,
                        },
                        Bytes::concat_all([ctype(kt), b" ", j.name, b" = ", zero_of(kt), b";"]),
                      );
                      let ta = assigned(decl, t.emitter, t.text, decl.indent, kt, t.value, j.name);
                      let ea = assigned(
                        ta.emitter,
                        e.emitter,
                        e.text,
                        decl.indent,
                        kt,
                        e.value,
                        j.name,
                      );
                      let fin = ea.emitter;
                      let body = Bytes::concat_all([
                        bytes_join(j.emitter.out, b""),
                        bytes_join(decl.out, b""),
                        pad(decl.indent),
                        b"if (",
                        cv.value.expr,
                        b") {\n",
                        ta.text,
                        pad(decl.indent),
                        b"} else {\n",
                        ea.text,
                        pad(decl.indent),
                        b"}\n",
                      ]);
                      let fin_em: Emitter = {
                        out: [body],
                        temp_count: fin.temp_count,
                        unboxed: cv.emitter.unboxed,
                        indent: fin.indent,
                        reads: fin.reads,
                        shapes: fin.shapes,
                        built: fin.built,
                        module: fin.module,
                        base: fin.base,
                        count_locals: union_made(ta.made, ea.made),
                        here: fin.here,
                        imports: fin.imports,
                        consts: fin.consts,
                        ctors: fin.ctors,
                        lambda_bodies: fin.lambda_bodies,
                        lambdas: fin.lambdas,
                        owner: fin.owner,
                        builtins: fin.builtins,
                        called_builtins: fin.called_builtins,
                        fields: fin.fields,
                        released: fin.released,
                        reuse_widths: fin.reuse_widths,
                        alias: fin.alias,
                        by_root: fin.by_root,
                        tail: fin.tail,
                        calls: fin.calls,
                        generics: fin.generics,
                        refused: fin.refused,
                        deferred: fin.deferred,
                        deferred_locals: fin.deferred_locals,
                        performs: fin.performs,
                        handles: fin.handles,
                        landing: fin.landing,
                        effects: fin.effects,
                        release: fin.release,
                        pinned: fin.pinned,
                        bound: fin.bound,
                        group: fin.group,
                        operands: fin.operands,
                        typed: fin.typed,
                        answer: fin.answer,
                        site_root: fin.site_root,
                        lent: fin.lent,
                        written: fin.written,
                        slices: fin.slices,
                        sums: fin.sums,
                        leaves: fin.leaves,
                      };
                      Some({
                        emitter: if counted(kt) { note_holder(fin_em, j.name) } else { fin_em },
                        value: {
                          kind: kt,
                          expr: j.name,
                          ty: if t.value.ty == e.value.ty { t.value.ty } else { TyOpen([]) },
                        },
                      })
                    },
                  }
                },
              },
            },
          }
        }
      },
    },
    // A `perform` searches the handler frames through the runtime; arguments are duplicated and the effect named program-wide.
    NPerform(p) -> match effect_named(emitter, p.effect) {
      None -> Some(refused(emitter, b"an effect this port cannot resolve: ".concat(p.effect))),
      Some(en) -> match args_carried(emitter, p.args, params, [], 0, []) {
        None -> None,
        Some(w) -> {
          let global = en.global;
          let ef = field_of(w.emitter, global);
          let op = field_of(ef.emitter, p.op);
          // A resource a label parameter names is read from its slot; anything else is a field-table entry.
          let lb: Option<WithValue> = match p.label {
            None -> None,
            Some(x) -> expr(notail(op.emitter), x, params),
          };
          let wanted = match p.label { None -> false, Some(_) -> true };
          let missed = wanted && (match lb { Some(_) -> false, None -> true });
          let res = if wanted { None }
          else if p.resource == b"" { None }
          else { Some(field_of(op.emitter, p.resource)) };
          let after = match lb {
            Some(o) -> o.emitter,
            None -> match res { Some(r) -> r.emitter, None -> op.emitter },
          };
          let arr = fresh(after);
          let e = line(
            arr.emitter,
            Bytes::concat_all([
              b"Word ",
              arr.name,
              b"[] = {",
              if w.names.len() == 0 { b"0" } else { bytes_join(w.names, b", ") },
              b"};",
            ]),
          );
          let o = bind(
            note_performs(site(e, c.span), Bytes::concat_all([global, b"#", p.op])),
            KBoxed,
            Bytes::concat_all([
              b"rt_perform_p(ctx, ",
              field_ref(ef.i),
              b", ",
              field_ref(op.i),
              b", ",
              match lb {
                Some(o) -> as_int(o.value),
                None -> match res { Some(r) -> field_ref(r.i), None -> b"-1" },
              },
              b", ",
              mode_code(op_mode(en, p.op)),
              b", (Word)(intptr_t)",
              arr.name,
              b", ",
              ascii_of_int(p.args.len()),
              b")",
            ]),
          );
          if missed { None } else { Some({ emitter: check(o.emitter), value: o.value }) }
        },
      },
    },
    NHandle(h) -> handle_site(emitter, h.body, h.clauses, h.ret, params),
    // `simulate { body }`: the body is a nullary closure run as the root task of a region whose scheduler the runtime drives.
    NSimulate(x) -> {
      match closure_value(
          notail(emitter),
          { params: 0, size: x.size, captures: x.captures, body: x.body, at: x.body.span },
          params,
        ) {
        None -> None,
        Some(cl) -> {
          let held = owned(cl.emitter, cl.value);
          let noted = scheduled_ops().fold(held.emitter, |acc: Emitter, op: Bytes|
            note_handles(acc, op));
          let o = bind(
            site(noted, c.span),
            KBoxed,
            Bytes::concat_all([b"rt_simulate_p(ctx, ", held.value.expr, b")"]),
          );
          Some({ emitter: check(o.emitter), value: o.value })
        },
      }
    },
    // `parallel { .. }`: the branches' closures go to the runtime, which runs them at once where it may
    // and in order where it must, and writes each one's answer over its closure. Where the block's
    // definition says what the branches may perform, the runtime is told, so a handler none of it
    // reaches does not keep them in order.
    NParallel(pr) -> match items(emitter, pr.branches, params, 0, []) {
      None -> None,
      Some(w) -> {
        let n = w.names.len();
        let arr = fresh(w.emitter);
        let held = line(
          arr.emitter,
          Bytes::concat_all([b"Word ", arr.name, b"[] = {", bytes_join(w.names, b", "), b"};"]),
        );
        let ran = match if pr.rooted { owner_reach(held) } else { None } {
          None ->
            check(
              line(
                site(held, c.span),
                Bytes::concat_all([
                  b"rt_parallel_p(ctx, (Word)(intptr_t)",
                  arr.name,
                  b", ",
                  ascii_of_int(n),
                  b");",
                ]),
              ),
            ),
          Some(reach) -> {
            let named = reach.fold(
              { emitter: held, words: [] },
              |acc: { emitter: Emitter, words: List<Bytes> }, r: Reached| {
                let ef = field_of(acc.emitter, r.effect);
                match r.resource {
                  None ->
                    { emitter: ef.emitter, words: acc.words.concat([field_ref(ef.i), b"-1"]) },
                  Some(name) -> {
                    let res = field_of(ef.emitter, name);
                    {
                      emitter: res.emitter,
                      words: acc.words.concat([field_ref(ef.i), field_ref(res.i)]),
                    }
                  },
                }
              },
            );
            let table = fresh(named.emitter);
            let listed = line(
              table.emitter,
              Bytes::concat_all([
                b"Word ",
                table.name,
                b"[] = {",
                if named.words.len() == 0 { b"0" } else { bytes_join(named.words, b", ") },
                b"};",
              ]),
            );
            check(
              line(
                site(listed, c.span),
                Bytes::concat_all([
                  b"rt_parallel_past_p(ctx, (Word)(intptr_t)",
                  arr.name,
                  b", ",
                  ascii_of_int(n),
                  b", (Word)(intptr_t)",
                  table.name,
                  b", ",
                  ascii_of_int(reach.len()),
                  b");",
                ]),
              ),
            )
          },
        };
        let names = range(0, n).map(|i: Int| b"_".concat(ascii_of_int(i)));
        let words = range(0, n).map(|i: Int|
          Bytes::concat_all([arr.name, b"[", ascii_of_int(i), b"]"]));
        let sorted = sorted_names(names);
        Some(
          record_by_value(ran, sorted, range(0, n).map(|at: Int| word_at_rank(names, words, at))),
        )
      },
    },
    _ -> Some(refused(emitter, b"an effect construct or another node this port does not emit")),
  }

/// What a `parallel` block's branches may perform of one effect, by its program-wide name: on the
/// resource named, or on any.
type Reached = { effect: Bytes, resource: Option<Bytes> }

/// Every operation the definition being emitted may perform and does not answer, as its row has
/// it: what a block in its own body may reach of the handlers its callers installed. `None` where
/// the row does not say: a root that is no definition, a group's shared function and a row left
/// open. A row names an effect program-wide, as a frame's clause does.
fn owner_reach(emitter: Emitter) -> Option<List<Reached>> =
  if emitter.group.len() > 0 { None } else {
    match emitter.here.fold(None, |found: Option<Scheme>, d: Def| {
        let full = qualify(emitter.module, d.name);
        if full == emitter.owner || emitter.owner.starts_with(full.concat(b"@")) { d.scheme }
        else { found }
      }) {
      None -> None,
      Some(s) -> match s.ty {
        TyFn(f) -> match f.effects.tail {
          Some(_) -> None,
          None ->
            Some(
              // Nothing performs `diverges`: it says only that the body may not return.
              f.effects.atoms.filter(|atom: Atom| !is_diverges(atom)).map(|atom: Atom|
                {
                  effect: atom.effect,
                  resource: match atom.resource { RNamed(name) -> Some(name), _ -> None },
                }),
            ),
        },
        _ -> None,
      },
    }
  }

/// The operations a `simulate` region answers, named as the fixpoint names a handled operation.
fn scheduled_ops() -> List<Bytes> =
  [
    b"task#spawn",
    b"task#join",
    b"task#yield",
    b"clock#now",
    b"clock#sleep",
    b"random#next",
    b"random#below",
    b"sim#seed",
  ]

/// A field-table placeholder the unit resolves; the runtime reads effect, operation and resource names from it.
fn field_ref(i: Int) -> Bytes = Bytes::concat_all([b"@@f", ascii_of_int(i), b"@@"])

/// `None` for a name the module's scope does not bind.
fn effect_global(emitter: Emitter, written: Bytes) -> Option<Bytes> / {abort.raise} =
  match effect_named(emitter, written) { Some(e) -> Some(e.global), None -> None }

fn effect_named(emitter: Emitter, written: Bytes) -> Option<EffectName> / {abort.raise} =
  effect_among(emitter.effects, written)

/// A `try`'s clause names its effect program-wide, and only a raise is answered by one.
fn effect_among(effects: List<EffectName>, written: Bytes) -> Option<EffectName> / {abort.raise} =
  match named_program_wide(written) {
    Some(global) -> Some({ written: written, global: global, ops: [] }),
    None -> match effects.fold(None, |acc: Option<EffectName>, e: EffectName|
        if e.written == written { Some(e) } else { acc }) {
      Some(e) -> Some(e),
      // The prelude's effects are declared nowhere and known program-wide by their bare names.
      None ->
        prelude_effects_here().fold(None, |acc: Option<EffectName>, e: EffectName|
          if e.written == written { Some(e) } else { acc }),
    },
  }

fn prelude_effects_here() -> List<EffectName> =
  prelude_effects().map(|effect_info: EffectInfo|
    {
      written: effect_info.name,
      global: effect_info.name,
      ops: effect_info.ops.map(|op_info: OpInfo| { name: op_info.name, mode: op_info.mode }),
    })

/// An operation's declared mode: a `perform`'s recorded atom carries it.
fn op_mode(e: EffectName, op: Bytes) -> Mode =
  e.ops.fold(MRead, |acc: Mode, o: OpMode| if o.name == op { o.mode } else { acc })

/// As the runtime reads it.
fn mode_code(mode: Mode) -> Bytes =
  match mode { MRead -> b"0", MWrite -> b"1", MRaise -> b"2", MBad -> b"0" }

/// A clause for a raise is run once its `handle`'s body is abandoned, and no task inherits it.
fn clause_raises(emitter: Emitter, clause: CodeClause) -> Bool / {abort.raise} =
  named_program_wide(clause.effect) != None
    || (match effect_named(emitter, clause.effect) {
      Some(e) -> is_raise(op_mode(e, clause.op)),
      None -> false,
    })

/// Every effect name a module's scope binds, bare or through a module binder, with its program-wide name.
fn effects_in(resolved: Resolved, i: Int, mods: List<ParsedModule>) -> List<EffectName> =
  match resolved.scopes.at(i) {
    None -> [],
    Some(scope) -> {
      let bare = scope.bound.effects.map(|b: Binding|
        { written: b.name, global: b.qualified, ops: ops_of(mods, b.owner, b.name) });
      scope.modules.fold(bare, |acc: List<EffectName>, mb: ModuleBinding|
        match resolved.declared.at(mb.target) {
          None -> acc,
          Some(theirs) ->
            theirs.effects.fold(acc, |a: List<EffectName>, b: Binding|
              a.push({
                written: Bytes::concat_all([mb.binder, b"::", b.name]),
                global: b.qualified,
                ops: ops_of(mods, mb.target, b.name),
              })),
        })
    },
  }

fn ops_of(mods: List<ParsedModule>, owner: Int, name: Bytes) -> List<OpMode> =
  match mods.at(owner) {
    None -> [],
    Some(m) ->
      m.module.items.fold([], |acc: List<OpMode>, item: Item|
        match item {
          IEffect(e) -> if e.name.name == name {
            e.ops.map(|op: OpDef| { name: op.name.name, mode: op.mode })
          } else { acc },
          _ -> acc,
        }),
  }

/// A clause may call `resume` only in tail position, once per path; every read of the binder must be such a call.
fn resume_in_tail_only(body: Code, k: Int) -> Bool =
  slots_read(body).count(|y: Int| y == k) == tail_calls_of(body, k)

fn tail_calls_of(code: Code, k: Int) -> Int =
  match code.node {
    NApp(a) -> match a.func.node {
      NVar(v) -> if v.slot == Some(k) && a.args.len() == 1
          && all_read(a.args).count(|y: Int| y == k) == 0 { 1 }
      else { 0 },
      _ -> 0,
    },
    NIf(i) -> tail_calls_of(i.then_branch, k) + tail_calls_of(i.else_branch, k),
    NBlock(b) -> match b.tail { Some(t) -> tail_calls_of(t, k), None -> 0 },
    NMatch(m) -> m.arms.fold(0, |acc: Int, a: CodeArm| acc + tail_calls_of(a.body, k)),
    _ -> 0,
  }

/// Clause bodies become closures; the body is inlined, its failing calls landing where the frame is popped and unwinds are caught.
fn handle_site(
  emitter: Emitter,
  body: Code,
  clauses: List<CodeClause>,
  ret: Option<CodeReturn>,
  params: List<EmitParam>,
) -> Option<WithValue> / {abort.raise} = {
  let resolved = clauses.fold(true, |ok: Bool, clause: CodeClause|
    ok && (match effect_global(emitter, clause.effect) { Some(_) -> true, None -> false }));
  // A clause calling `resume` off the tail detaches the body: it runs on its own stack, so it becomes a closure.
  let detached = clauses.fold(false, |acc: Bool, clause: CodeClause|
    acc || (clause.resume && !resume_in_tail_only(clause.body, clause.params)));
  if !resolved {
    Some(refused(emitter, b"a `handle` this backend cannot carry: an effect it cannot resolve"))
  } else {
    let ans = fresh(emitter);
    let opened = line(ans.emitter, Bytes::concat_all([b"Word ", ans.name, b" = 0;"]));
    match clauses.fold(
        Some({ emitter: opened, entries: [] }),
        |acc: Option<{ emitter: Emitter, entries: List<Bytes> }>, clause: CodeClause|
          match acc {
            None -> None,
            Some(st) -> match effect_global(emitter, clause.effect) {
              None -> None,
              Some(global) -> match closure_value(
                  notail(st.emitter),
                  {
                    params: clause.params + (if clause.binds_label { 1 } else { 0 })
                      + (if clause.resume { 1 } else { 0 }),
                    size: clause.size,
                    captures: clause.captures,
                    body: clause.body,
                    at: clause.body.span,
                  },
                  params,
                ) {
                None -> None,
                Some(cl) -> {
                  let held = owned(cl.emitter, cl.value);
                  let ef = field_of(held.emitter, global);
                  // A clause on a label parameter keys on the slot, read where the table is built.
                  let lb: Option<WithValue> = match clause.label {
                    None -> None,
                    Some(cd) -> expr(notail(ef.emitter), cd, params),
                  };
                  let wanted = match clause.label { None -> false, Some(_) -> true };
                  let res = if wanted { None }
                  else if clause.resource == b"" { None }
                  else { Some(field_of(ef.emitter, clause.resource)) };
                  let op = field_of(
                    match lb {
                      Some(o) -> o.emitter,
                      None -> match res { Some(r) -> r.emitter, None -> ef.emitter },
                    },
                    clause.op,
                  );
                  if wanted && (match lb { Some(_) -> false, None -> true }) { None } else {
                    Some({
                      emitter: note_handles(
                        op.emitter,
                        Bytes::concat_all([global, b"#", clause.op]),
                      ),
                      entries: st.entries.push(
                        Bytes::concat_all([
                          field_ref(ef.i),
                          b", ",
                          match lb {
                            Some(o) -> as_int(o.value),
                            None -> match res { Some(r) -> field_ref(r.i), None -> b"-1" },
                          },
                          b", ",
                          field_ref(op.i),
                          b", ",
                          held.value.expr,
                          b", ",
                          if clause_raises(emitter, clause) { b"3" }
                          else if !clause.resume { b"0" }
                          else if resume_in_tail_only(clause.body, clause.params) { b"1" }
                          else { b"2" },
                          b", ",
                          if clause.binds_label { b"1" } else { b"0" },
                        ]),
                      ),
                    })
                  }
                },
              },
            },
          },
      ) {
      None -> None,
      Some(built) -> {
        let arr = fresh(built.emitter);
        let table = line(
          arr.emitter,
          Bytes::concat_all([
            b"Word ",
            arr.name,
            b"[] = {",
            bytes_join(built.entries, b", "),
            b"};",
          ]),
        );
        let retc = match ret {
          None -> Some({ emitter: table, clause: b"0" }),
          Some(r) -> {

            match closure_value(
                notail(table),
                { params: 1, size: r.size, captures: r.captures, body: r.body, at: r.body.span },
                params,
              ) {
              None -> None,
              Some(cl) -> {
                let held = owned(cl.emitter, cl.value);
                Some({ emitter: held.emitter, clause: held.value.expr })
              },
            }
          },
        };
        match retc {
          None -> None,
          Some(rc) -> if detached {
            // The body closes over every slot it reads at the same slot numbers, so nothing is renumbered.
            let reads = dedup(slots_read(body)).filter(|r: Int|
              match conv_of(rc.emitter, r) {
                Some(_) -> true,
                None -> match params.at(r) { Some(_) -> true, None -> false },
              });
            match closure_value(
                notail(rc.emitter),
                {
                  params: 0,
                  size: reads.fold(0, |m: Int, r: Int| if r + 1 > m { r + 1 } else { m }),
                  captures: reads.map(|r: Int| { src: r, dst: r, own: Borrowed }),
                  body: body,
                  at: body.span,
                },
                params,
              ) {
              None -> None,
              Some(cl) -> {
                let held = owned(cl.emitter, cl.value);
                let out = bind(
                  held.emitter,
                  KBoxed,
                  Bytes::concat_all([
                    b"rt_handle_detached_p(ctx, (Word)(intptr_t)",
                    arr.name,
                    b", ",
                    ascii_of_int(clauses.len()),
                    b", ",
                    rc.clause,
                    b", ",
                    held.value.expr,
                    b")",
                  ]),
                );
                Some({ emitter: check(out.emitter), value: out.value })
              },
            }
          } else {
            let depth = bind(
              rc.emitter,
              KInt,
              Bytes::concat_all([
                b"rt_handle_push_p(ctx, (Word)(intptr_t)",
                arr.name,
                b", ",
                ascii_of_int(clauses.len()),
                b", ",
                rc.clause,
                b")",
              ]),
            );
            let mark = fresh(depth.emitter);
            let label = b"land_".concat(ascii_of_int(mark.emitter.temp_count));
            // Under release the body is its own block, so its holders are released at its close, before the landing label.
            let opened = if mark.emitter.release { indent(line(mark.emitter, b"{")) }
            else { mark.emitter };
            match expr(notail(with_landing(opened, Some(label))), body, params) {
              None -> None,
              Some(emitted) -> {
                let b = if leaves_unlanded(opened.out, emitted.emitter.out) {
                  refused(emitted.emitter, b"a `handle` body that leaves without landing")
                } else { emitted };
                let bw = owned(b.emitter, b.value);
                let set = line(
                  bw.emitter,
                  Bytes::concat_all([ans.name, b" = ", bw.value.expr, b";"]),
                );
                let closed = if set.release {
                  with_made(
                    close(set),
                    union_made(mark.emitter.count_locals, release_at(set, set.indent).count_locals),
                  )
                } else { set };
                let landed = line(
                  with_landing(closed, emitter.landing),
                  Bytes::concat_all([label, b":;"]),
                );
                let out = bind(
                  landed,
                  KBoxed,
                  Bytes::concat_all([
                    b"rt_handle_land_p(ctx, ",
                    depth.value.expr,
                    b", ",
                    ans.name,
                    b")",
                  ]),
                );
                Some({ emitter: check(out.emitter), value: out.value })
              },
            }
          },
        }
      },
    }
  }
}

/// What an update gathers its new record of: each field's word, kind and value, and whether every
/// value is known, which holds the record back.
type Filled = {
  emitter: Emitter,
  ws: List<Bytes>,
  kinds: List<Kind>,
  vals: List<CValue>,
  known: Bool,
}

/// An update to the fields `names`: `copies` read from `base`, of type `base_ty`, and `sets` written,
/// their values `vals`, words the record takes as they are where `owned`; laid out as `laid` where
/// the new record's layout is known.
type UpdateOf = {
  copies: List<Bytes>,
  sets: List<CodeField>,
  names: List<Bytes>,
  laid: Option<List<FieldTy>>,
  base: CValue,
  base_ty: Ty,
  vals: List<CValue>,
  owned: Bool,
}

/// The kind the new record holds its field `at` as: none but a word where it is laid out by what it
/// holds.
fn update_target(u: UpdateOf, at: Int) -> Kind =
  match u.laid { Some(fs) -> kind_at(kinds_of(fs), at), None -> KBoxed }

/// `acc` with a field the new record holds as a `Float`'s bits, of kind `k`, from `v`.
fn update_bits(acc: Filled, em: Emitter, v: CValue, k: Kind) -> Filled = {
  let d = held_raw(em, v, k);
  {
    emitter: d.emitter,
    ws: acc.ws.push(raw_word(d.value)),
    kinds: acc.kinds.push(k),
    vals: acc.vals.push(d.value),
    known: acc.known,
  }
}

/// `o`, field `at` of update `u`'s new record, of kind `k`, as the record holds it: a record held
/// in place kept held back where it is one.
fn update_held(
  u: UpdateOf,
  at: Int,
  o: WithValue,
  k: Kind,
) -> { emitter: Emitter, word: Bytes, val: CValue } =
  if match u.laid { Some(fs) -> in_place(nth_field(fs, at)) != None, None -> false } {
    held_in_place(o)
  } else { held_item(o, k) }

/// `acc` with field `at` of update `u` gathered: a copy the base remembered is its value, not a
/// load, and any word read from memory stops the record being held back.
fn update_field(acc: Filled, u: UpdateOf, at: Int) -> Filled = {
  let nm = match u.names.at(at) { Some(x) -> x, None -> b"" };
  let tk = update_target(u, at);
  if u.copies.fold(false, |seen: Bool, c: Bytes| seen || c == nm) {
    match built_field(acc.emitter, u.base.expr, nm) {
      Some(v) -> if raw_slot(tk) { update_bits(acc, acc.emitter, v, tk) } else {
        let spent = spendable(acc.emitter, u.base.expr);
        let h = match moved_field(acc.emitter, spent, u.base, v) {
          Some(m) ->
            { emitter: m.emitter, word: m.value.expr, val: taken_as(m.emitter, v, m.value) },
          None -> update_held(u, at, { emitter: acc.emitter, value: v }, tk),
        };
        {
          emitter: h.emitter,
          ws: acc.ws.push(h.word),
          kinds: acc.kinds.push(tk),
          vals: acc.vals.push(h.val),
          known: acc.known,
        }
      },
      None -> match field_at(u.base_ty, nm) {
        // Read at the field's place in the base's shape, which differs from the new record's when the update adds a field.
        Some(f) -> {
          let w = bind_word_of(acc.emitter, field_read(u.base.expr, f));
          // A base of a known type holds a scalar as its bits.
          if raw_slot(f.kind) {
            let d = bind(w.emitter, f.kind, raw_at(u.base.expr, ascii_of_int(f.at), f.kind));
            if raw_slot(tk) { update_bits(acc, d.emitter, d.value, tk) } else {
              {
                emitter: d.emitter,
                ws: acc.ws.push(as_word(d.value)),
                kinds: acc.kinds.push(tk),
                vals: acc.vals.push(d.value),
                known: acc.known,
              }
            }
          } else {
            match f.kind {
              // A counted copy is a word this scope holds, so the record can still
              // be held back: one written into a holder makes no object of its own.
              k if counted(k) ->
                {
                  emitter: line(w.emitter, Bytes::concat_all([b"ply_inc(", w.value.expr, b");"])),
                  ws: acc.ws.push(w.value.expr),
                  kinds: acc.kinds.push(tk),
                  vals: acc.vals.push({ kind: word_kind(k), expr: w.value.expr, ty: f.ty }),
                  known: acc.known,
                },
              // A scalar copy is held in a register of its kind, as `held_item` holds one.
              _ -> {
                let c = bind(w.emitter, f.kind, as_kind(w.value, f.kind));
                {
                  emitter: c.emitter,
                  ws: acc.ws.push(as_word(c.value)),
                  kinds: acc.kinds.push(tk),
                  vals: acc.vals.push(c.value),
                  known: acc.known,
                }
              },
            }
          }
        },
        None -> {
          let idx = field_of(open_needed(acc.emitter, u.base_ty), nm);
          let w = bind(
            idx.emitter,
            KBoxed,
            Bytes::concat_all([
              b"rt_field_p(ctx, ",
              u.base.expr,
              b", @@f",
              ascii_of_int(idx.i),
              b"@@, 0)",
            ]),
          );
          // The runtime answers the copy duplicated, and the record takes it, or keeps
          // it until the block closes where the record holds the `Float` it is as bits.
          if raw_slot(tk) { update_bits(acc, check(w.emitter), w.value, tk) }
          else if tk == KSum(Zeroed) {
            let o = sum_owned(check(w.emitter), w.value, Zeroed);
            {
              emitter: o.emitter,
              ws: acc.ws.push(o.value.expr),
              kinds: acc.kinds.push(tk),
              vals: acc.vals,
              known: false,
            }
          } else {
            {
              emitter: spend_made(check(w.emitter), w.value.expr),
              ws: acc.ws.push(w.value.expr),
              kinds: acc.kinds.push(tk),
              vals: acc.vals,
              known: false,
            }
          }
        },
      },
    }
  } else {
    match set_value(u.sets, u.vals, nm) {
      None ->
        {
          emitter: acc.emitter,
          ws: acc.ws.push(b"0"),
          kinds: acc.kinds.push(KBoxed),
          vals: acc.vals,
          known: false,
        },
      Some(v) -> if raw_slot(tk) { update_bits(acc, acc.emitter, v, tk) } else {
        // The written field's word is duplicated: the record being built takes it.
        let h = if u.owned { { emitter: acc.emitter, word: v.expr, val: v } }
        else { update_held(u, at, { emitter: acc.emitter, value: v }, tk) };
        {
          emitter: h.emitter,
          ws: acc.ws.push(h.word),
          kinds: acc.kinds.push(tk),
          vals: acc.vals.push(h.val),
          known: acc.known,
        }
      },
    }
  }
}

/// Whether what a `handle` body emitted past `opened` holds a `return`, which would leave the frame
/// installed and a raise bound for it unanswered: a body that fails leaves by `leaving` alone.
fn leaves_unlanded(opened: List<Bytes>, body: List<Bytes>) -> Bool / {abort.raise} = {
  let before = bytes_join(opened, b"");
  let after = bytes_join(body, b"");
  after.starts_with(before) && after.slice(before.len(), after.len()).index_of(b"return ") != None
}

fn dedup(xs: List<Int>) -> List<Int> =
  xs.fold([], |acc: List<Int>, x: Int|
    if acc.count(|y: Int| y == x) > 0 { acc } else { acc.push(x) })

/// Each item is duplicated as soon as it is evaluated, unlike a call's two passes; each order is wrong in the other's place.
fn items(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  i: Int,
  acc: List<Bytes>,
) -> Option<{ emitter: Emitter, names: List<Bytes>, vals: List<CValue> }> / {abort.raise} =
  match items_from(emitter, codes, params, i, { names: acc, vals: [] }, []) {
    Some(w) -> Some({ emitter: w.emitter, names: w.names, vals: w.vals }),
    None -> None,
  }

/// A record's fields or a constructor's arguments, each held as the field in `slots` it fills: a
/// word the object takes, a `Float`'s bits, or, for a record literal where a record is held in
/// place, its own fields written there.
fn items_laid(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  slots: List<FieldTy>,
) -> Option<Items> / {abort.raise} =
  items_from(emitter, codes, params, 0, { names: [], vals: [] }, slots)

type Items = { emitter: Emitter, names: List<Bytes>, vals: List<CValue> }

/// The fields of the record `slot` holds in place when `code` is a literal of exactly them.
fn placeable(code: Code, slot: FieldTy) -> Option<List<FieldTy>> =
  match in_place(slot) {
    None -> None,
    Some(fs) -> {
      // An update that copies no field of its base writes every field: a literal, its base only
      // the cells it would have reused.
      let written = match code.node {
        NRecord(r) -> Some(r.fields),
        NUpdate(u) -> if u.copies.len() == 0 { Some(u.sets) } else { None },
        _ -> None,
      };
      match written {
        Some(cs) -> if sorted_names(cs.map(|f: CodeField| f.name)) == fs.map(|f: FieldTy| f.name) {
          Some(fs)
        } else { None },
        None -> None,
      }
    },
  }

/// The value of `vals`, in written order under `names`, whose name sorts `at`th.
fn value_at_rank(names: List<Bytes>, vals: List<CValue>, at: Int) -> CValue =
  range(0, names.len()).fold({ kind: KBoxed, expr: b"0", ty: TyOpen([]) }, |acc: CValue, i: Int|
    if rank_of(names, nth_bytes(names, i)) == at { nth_value(vals, i) } else { acc })

/// `o`, a record a holder keeps in place, as a value the holder alone holds: one held back of no
/// record in place taken, or copied where another holds it too; any other as its word.
fn held_in_place(o: WithValue) -> { emitter: Emitter, word: Bytes, val: CValue } =
  match deferred_of(o.emitter, o.value.expr) {
    Some(d) -> if d.inner.len() > 0 { held_item(o, KBoxed) } else {
      let r = if spendable(o.emitter, o.value.expr) { o }
      else { copied_record(o.emitter, o.value, d) };
      { emitter: r.emitter, word: r.value.expr, val: r.value }
    },
    None -> held_item(o, KBoxed),
  }

fn items_from(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  i: Int,
  so_far: { names: List<Bytes>, vals: List<CValue> },
  slots: List<FieldTy>,
) -> Option<Items> / {abort.raise} =
  if i >= codes.len() { Some({ emitter: emitter, names: so_far.names, vals: so_far.vals }) } else {
    let slot = slots.at(i);
    let in_slot = match slot { Some(f) -> in_place(f) != None, None -> false };
    let evaluated = match codes.at(i) {
      None -> None,
      Some(x) -> match match slot { Some(f) -> placeable(x, f), None -> None } {
        // A record literal where a record is held in place is laid out as the place lays it out:
        // its fields evaluated in written order.
        Some(inner) -> {
          let written = match x.node { NRecord(r) -> r.fields, NUpdate(u) -> u.sets, _ -> [] };
          let names = written.map(|f: CodeField| f.name);
          match written.fold(
              Some({ emitter: notail(emitter), words: [], vals: [] }),
              |got: Option<{ emitter: Emitter, words: List<Bytes>, vals: List<CValue> }>, f: CodeField|
                match got {
                  None -> None,
                  Some(g) -> match expr(g.emitter, f.value, params) {
                    None -> None,
                    Some(o) -> {
                      let h = held_item(o, nth_field(inner, rank_of(names, f.name)).kind);
                      Some({
                        emitter: h.emitter,
                        words: g.words.push(h.word),
                        vals: g.vals.push(h.val),
                      })
                    },
                  },
                },
            ) {
            None -> None,
            Some(w) ->
              Some(
                build_record(
                  w.emitter,
                  names_of(inner),
                  range(0, inner.len()).map(|at: Int| word_at_rank(names, w.words, at)),
                  inner,
                  Some(range(0, inner.len()).map(|at: Int| value_at_rank(names, w.vals, at))),
                  b"0",
                ),
              ),
          }
        },
        None -> expr(notail(emitter), x, params),
      },
    };
    match evaluated {
      None -> None,
      Some(o) -> {
        let h = if in_slot { held_in_place(o) } else { held_item(o, kind_at(kinds_of(slots), i)) };
        items_from(
          h.emitter,
          codes,
          params,
          i + 1,
          { names: so_far.names.push(h.word), vals: so_far.vals.push(h.val) },
          slots,
        )
      },
    }
  }

/// The cells a record held back of no record in place writes where `slot` holds a record in place,
/// from its header's word: each counted field a word of its own the holder takes, the field's count
/// where the record is spent.
fn deferred_cells(
  emitter: Emitter,
  value: CValue,
  slot: Option<FieldTy>,
) -> Option<{ emitter: Emitter, cells: List<WordAt> }> =
  match slot {
    Some(f) -> if in_place(f) == None { None } else {
      match deferred_of(emitter, value.expr) {
        Some(d) -> if d.inner.len() > 0 { None } else {
          let spent = spendable(emitter, value.expr);
          let taken = d.counts.fold(
            { emitter: emitter, cells: d.cells },
            |acc: { emitter: Emitter, cells: List<{ at: Int, expr: Bytes }> }, x: Bytes| {
              let xv = { kind: KBoxed, expr: x, ty: TyOpen([]) };
              let o = match moved_field(acc.emitter, spent, value, xv) {
                Some(m) -> m,
                None -> owned_word(acc.emitter, xv),
              };
              {
                emitter: o.emitter,
                cells: acc.cells.map(|c: { at: Int, expr: Bytes }|
                  if c.expr == x { { at: c.at, expr: o.value.expr } } else { c }),
              }
            },
          );
          Some({
            emitter: taken.emitter,
            cells: taken.cells.map(|c: { at: Int, expr: Bytes }| held_inside(Put(c))).push(
              Header({ at: 0, flags: d.flags, len: d.n, shape: d.shape, holder: None }),
            ),
          })
        },
        None -> None,
      }
    },
    None -> None,
  }

/// `o` held as a field of `kind`: the word the object takes or a `Float`'s bits, and the value the
/// object is remembered to hold.
fn held_item(o: WithValue, kind: Kind) -> { emitter: Emitter, word: Bytes, val: CValue } =

  // An `Int` is held as its 64 bits, in a register and in the object alike.
  if kind == KInt {
    let b = bind(o.emitter, KInt, as_int(o.value));
    { emitter: b.emitter, word: raw_word(b.value), val: b.value }
  } else { held_word_of(o, kind) }

fn held_word_of(o: WithValue, kind: Kind) -> { emitter: Emitter, word: Bytes, val: CValue } = {
  let raw = raw_slot(kind);
  let d = if raw { held_raw(o.emitter, o.value, kind) } else { o };
  let maybe = kind == KSum(Zeroed);
  let w = if maybe { sum_owned(o.emitter, o.value, Zeroed) }
  else if !raw { owned(o.emitter, o.value) }
  else if kind == KDec { d }
  else { bind(d.emitter, KInt, raw_word(d.value)) };
  {
    emitter: w.emitter,
    word: w.value.expr,
    val: if raw { d.value }
    else if maybe { w.value }
    else { taken_as(w.emitter, o.value, w.value) },
  }
}

/// Under release the temporary a field came from is null once the record takes it, so the held word is remembered instead.
fn taken_as(emitter: Emitter, v: CValue, w: CValue) -> CValue =
  if emitter.release && counted(v.kind) { { kind: w.kind, expr: w.expr, ty: v.ty } } else { v }

/// Under release a value read now and taken later is duplicated now: a read in between may be its last use and move it.
fn secure(emitter: Emitter, value: CValue) -> WithValue =
  if !emitter.release || !counted(value.kind) || spendable(emitter, value.expr) {
    { emitter: emitter, value: value }
  } else {
    let w = owned_word(emitter, { ..value, kind: KBoxed });
    {
      emitter: note_made(w.emitter, w.value.expr),
      value: { kind: value.kind, expr: w.value.expr, ty: value.ty },
    }
  }

fn secured(o: Option<WithValue>) -> Option<WithValue> =
  match o { None -> None, Some(x) -> Some(secure(x.emitter, x.value)) }

/// Duplicated only when a read in `later` can move it: a count per byte in the inline family's loops would cost what it saves.
fn secure_across(
  emitter: Emitter,
  value: CValue,
  later: Code,
  params: List<EmitParam>,
) -> WithValue =
  if !emitter.release || !counted(value.kind) || spendable(emitter, value.expr) {
    { emitter: emitter, value: value }
  } else {
    let r = holder_root(emitter, value.expr);
    let moved = slots_read(later).fold(false, |acc: Bool, s: Int|
      acc
        || (match local_of(emitter, params, s) {
          Some(c) -> is_made(emitter, c) && !is_pinned(emitter, c) && root_of(emitter, c) == r,
          None -> false,
        }));
    if moved { secure(emitter, value) } else { { emitter: emitter, value: value } }
  }

/// The root of `local`, or, for the local of a counted field of a record held back or of a record
/// one holds in place, the root of the record it was first held back as, whose last read moves the
/// field out.
fn holder_root(emitter: Emitter, local: Bytes) -> Bytes =
  match holder_of(emitter, local) {
    Some(name) -> match holder_of(emitter, name) {
      Some(outer) -> root_of(emitter, outer),
      None -> root_of(emitter, name),
    },
    None -> root_of(emitter, local),
  }

/// The record held back that holds `local` as a counted field's or a record's in place.
fn holder_of(emitter: Emitter, local: Bytes) -> Option<Bytes> =
  emitter.deferred.fold(None, |acc: Option<Bytes>, d: Deferred|
    match acc {
      Some(_) -> acc,
      None -> if d.counts.contains(local)
          || d.inner.fold(false, |seen: Bool, x: Inner| seen || x.name == local) { Some(d.name) }
      else { None },
    })

/// The local a slot reads as: the window's, or a parameter the prologue did not open.
fn local_of(emitter: Emitter, params: List<EmitParam>, s: Int) -> Option<Bytes> =
  match conv_of(emitter, s) {
    Some(cv) -> Some(cv.expr),
    None -> match params.at(s) { Some(_) -> Some(b"p".concat(ascii_of_int(s))), None -> None },
  }

/// What a slot reads as, with the type the prologue knows a parameter it did not open by.
fn slot_value(emitter: Emitter, params: List<EmitParam>, s: Int) -> Option<CValue> =
  match conv_of(emitter, s) {
    Some(cv) -> Some(cv),
    None -> match params.at(s) {
      Some(p) -> if p.kind == KBoxed {
        Some({ kind: KBoxed, expr: b"p".concat(ascii_of_int(s)), ty: p.ty })
      } else { None },
      None -> None,
    },
  }

/// A statement that is a last read and nothing else: a slot's, or a field's through a record read
/// after it.
fn last_read(code: Code) -> Option<{ slot: Int, field: Option<Bytes> }> =
  if code.own != Owned { None } else {
    match code.node {
      NVar(v) -> match v.slot { Some(s) -> Some({ slot: s, field: None }), None -> None },
      NField(f) -> if f.base.own != Borrowed { None } else {
        match f.base.node {
          NVar(v) -> match v.slot {
            Some(s) -> Some({ slot: s, field: Some(f.field) }),
            None -> None,
          },
          _ -> None,
        }
      },
      _ -> None,
    }
  }

/// The count a slot's local holds let go, where this body holds it and no loop reads it again.
fn released_slot(emitter: Emitter, s: Int, params: List<EmitParam>) -> Emitter =
  match slot_value(emitter, params, s) {
    Some(v) -> if emitter.release && counted(v.kind) && is_made(emitter, v.expr)
        && !is_pinned(emitter, v.expr) { release_holder(spend_made(emitter, v.expr), v) }
    else { emitter },
    None -> emitter,
  }

/// A record's field let go where the record is its only holder, as a field's last read takes it:
/// a count read out of the field before is then the only one. A record held back lets go of the
/// field's local; one built here keeps its fields.
fn released_field(emitter: Emitter, s: Int, name: Bytes, params: List<EmitParam>) -> Emitter =
  match slot_value(emitter, params, s) {
    None -> emitter,
    Some(v) -> match deferred_of(emitter, v.expr) {
      Some(d) -> match built_field(emitter, v.expr, name) {
        Some(f) -> if d.counts.contains(f.expr) {
          let_go_word(let_go_count(emitter, f.expr), v.expr)
        } else { emitter },
        None -> emitter,
      },
      None -> released_object_field(emitter, v, name),
    },
  }

fn released_object_field(emitter: Emitter, v: CValue, name: Bytes) -> Emitter =
  if !emitter.release || !counted(v.kind) || !is_made(emitter, v.expr) || is_pinned(emitter, v.expr)
      || built_of(emitter, v.expr) != None { emitter } else {
    match field_at(v.ty, name) {
      Some(i) -> if i.kind != KBoxed || width_of(i.ty) != None { emitter } else {
        let t = fresh(emitter);
        line(
          t.emitter,
          Bytes::concat_all([
            b"if (ply_obj(",
            v.expr,
            b")->rc == 1) { Word ",
            t.name,
            b" = ply_words(",
            v.expr,
            b")[",
            ascii_of_int(i.at),
            b"]; ply_words(",
            v.expr,
            b")[",
            ascii_of_int(i.at),
            b"] = ply_unit; ply_dec(ctx, ",
            t.name,
            b"); }",
          ]),
        )
      },
      None -> {
        let idx = field_of(open_needed(emitter, v.ty), name);
        let t = fresh(idx.emitter);
        check(
          line(
            t.emitter,
            Bytes::concat_all([
              b"{ Word ",
              t.name,
              b" = rt_field_p(ctx, ",
              v.expr,
              b", @@f",
              ascii_of_int(idx.i),
              b"@@, 2); ply_dec(ctx, ",
              t.name,
              b"); }",
            ]),
          ),
        )
      },
    }
  }

fn bytes_join(xs: List<Bytes>, sep: Bytes) -> Bytes =
  range(0, xs.len()).fold(b"", |acc: Bytes, i: Int|
    Bytes::concat_all([
      acc,
      if i == 0 { b"" } else { sep },
      match xs.at(i) { Some(x) -> x, None -> b"" },
    ]))

/// A `let` binds its value under its own name even when it is already a temporary.
fn stmts(
  emitter: Emitter,
  xs: List<CodeStmt>,
  params: List<EmitParam>,
  i: Int,
) -> Option<Emitter> / {abort.raise} =
  if i >= xs.len() { Some(emitter) } else {
    match xs.at(i) {
      None -> None,
      Some(st) -> match st {
        CLet(l) -> match expr(notail(emitter), l.value, params) {
          None -> None,
          Some(o) -> {
            let ty = typed_value(o.emitter, l.value, o.value).ty;
            let b = bind_keeping(o.emitter, o.value.kind, ty, o.value.expr);
            stmts(remember(ensure_owned(b.emitter, b.value), l.slot, b.value), xs, params, i + 1)
          },
        },
        // A refutable `let` tests the pattern first and raises rather than reading a missing field.
        CLetPat(l) -> match expr(notail(emitter), l.value, params) {
          None -> None,
          Some(o) -> {
            // A record held back is taken apart by its values, never made.
            let whole = matches_held(o.emitter, o.value.expr, l.pat);
            let w = if whole { { emitter: o.emitter, expr: o.value.expr } }
            else { word_of(o.emitter, o.value) };
            let held = bind(w.emitter, KBoxed, w.expr);
            let subject = { ..held.value, ty: typed_value(o.emitter, l.value, o.value).ty };
            let checked = if whole || irrefutable(l.pat) { Some(held.emitter) } else {
              match pat_test(l.pat, subject, held.emitter) {
                None -> None,
                Some(t) ->
                  Some(
                    line(
                      site(t.emitter, l.span),
                      Bytes::concat_all([
                        b"if (!(",
                        t.expr,
                        b")) { rt_let_no_match_p(ctx); ",
                        leaving(t.emitter),
                        b" }",
                      ]),
                    ),
                  ),
              }
            };
            match checked {
              None -> None,
              Some(gem) ->
                stmts(let_go(pat_bind(gem, l.pat, subject), subject, l.pat), xs, params, i + 1),
            }
          },
        },
        // A last read standing alone, as a branch opens with, lets the count go without reading it.
        CDo(d) -> match last_read(d.code) {
          Some(r) ->
            stmts(
              match r.field {
                None -> released_slot(emitter, r.slot, params),
                Some(name) -> released_field(emitter, r.slot, name, params),
              },
              xs,
              params,
              i + 1,
            ),
          None -> match expr(notail(emitter), d.code, params) {
            None -> None,
            Some(o) ->
              stmts(
                drop_value(
                  line(o.emitter, Bytes::concat_all([b"(void)(", o.value.expr, b");"])),
                  o.value,
                ),
                xs,
                params,
                i + 1,
              ),
          },
        },
      },
    }
  }

/// Each arm is guarded by the flag rather than an `else`, so its test is written at one depth.
fn arms(
  emitter: Emitter,
  xs: List<CodeArm>,
  params: List<EmitParam>,
  i: Int,
  subj: CValue,
  sink: Sink,
  flag: Bytes,
  base: List<CountLocal>,
  seen: List<CountLocal>,
) -> Option<Emitter> / {abort.raise} =
  if i >= xs.len() { Some(with_made(emitter, if i == 0 { emitter.count_locals } else { seen })) }
  else {
    match xs.at(i) {
      None -> None,
      Some(a) -> {
        let guarded = indent(
          line(with_made(emitter, base), Bytes::concat_all([b"if (!", flag, b") {"])),
        );
        match pat_test(a.pat, subj, guarded) {
          None -> Some(poison(emitter, b"a pattern this port cannot test")),
          Some(t) -> {
            let opened = line(t.emitter, Bytes::concat_all([b"if (", t.expr, b") {"]));
            let inner = indent(opened);
            // Past a failing guard the next arm tests the subject again, so neither its binders nor the guard may take its count.
            let binding = match a.guard {
              None -> inner,
              Some(_) -> with_pinned(inner, inner.pinned.push(subj.expr)),
            };
            let bound = let_go(pat_bind(binding, a.pat, subj), subj, a.pat);
            match guarded_body(
                bound,
                inner.pinned,
                a.guard,
                sink,
                a.body,
                params,
                flag,
                emitter.tail,
                emitter.leaves,
              ) {
              None -> None,
              Some(o) -> {
                let closed = close(close(o));
                // The next arm is a tail when this one was: the body's own nodes cleared the flag.
                arms(
                  withtail(beside(rescope(closed, emitter.unboxed), emitter), position(emitter)),
                  xs,
                  params,
                  i + 1,
                  subj,
                  sink,
                  flag,
                  base,
                  union_made(seen, closed.count_locals),
                )
              },
            }
          },
        }
      },
    }
  }

/// A failing guard leaves the flag clear; what the body moves is still held on that path, so it stays in `made`.
fn guarded_body(
  emitter: Emitter,
  pinned: List<Bytes>,
  guard: Option<Code>,
  sink: Sink,
  body: Code,
  params: List<EmitParam>,
  flag: Bytes,
  tail: Bool,
  leaves: Bool,
) -> Option<Emitter> / {abort.raise} =
  match guard {
    None -> match arm_body(with_pinned(emitter, pinned), sink, body, params) {
      None -> None,
      Some(o) -> Some(line(o, Bytes::concat_all([flag, b" = 1;"]))),
    },
    Some(g) -> match expr(notail(emitter), g, params) {
      None -> None,
      Some(gv) -> {
        let opened = line(gv.emitter, Bytes::concat_all([b"if (", as_bool(gv.value), b") {"]));
        match arm_body(
            with_pinned(withtail(indent(opened), { tail: tail, leaves: leaves }), pinned),
            sink,
            body,
            params,
          ) {
          None -> None,
          Some(o) -> {
            let closed = close(line(o, Bytes::concat_all([flag, b" = 1;"])));
            Some(
              rescope(
                with_made(closed, union_made(opened.count_locals, closed.count_locals)),
                opened.unboxed,
              ),
            )
          },
        }
      },
    },
  }

/// Where a `match` at `c` joins its arms, declared in `emitter`: a sum taken as its constructor and
/// argument joins as their locals, a record that crosses a call as its fields as its fields' and its
/// word's, and any other value as one local, a sum's word where the match answers one.
fn match_join(
  emitter: Emitter,
  at: Emitter,
  c: Code,
  arms: List<CodeArm>,
  params: List<EmitParam>,
) -> { emitter: Emitter, sink: Sink } =
  match leaves_cases(at, c) {
    Some(sc) -> {
      let j = sum_locals(emitter, sc);
      { emitter: j.emitter, sink: ToSum({ cases: sc, tag: j.tag, leaves: j.leaves }) }
    },
    // A record held back: each arm hands its values and word to locals the record is held back
    // as after the match, never made to be joined.
    None -> match matched_record(at, arms) {
      Some(fields) -> {
        let ls = record_locals(emitter, fields, empty_inits(fields));
        {
          emitter: ls.emitter,
          sink: ToRecord({ fields: fields, locals: ls.values, word: ls.word }),
        }
      },
      None -> {
        let k = match answers_sum(at) {
          Some(spec) -> KSum(spec),
          None -> if matched_option(at, arms, params) { KSum(Zeroed) } else { KBoxed },
        };
        let ans = fresh(emitter);
        {
          emitter: line(ans.emitter, Bytes::concat_all([ctype(k), b" ", ans.name, b" = 0;"])),
          sink: ToValue({ name: ans.name, kind: k }),
        }
      },
    },
  }

/// What a join's locals hold once each arm has handed its value to them.
fn joined_value(emitter: Emitter, sink: Sink) -> WithValue =
  match sink {
    ToSum(t) -> held_sum_from(emitter, t.cases, t.tag, t.leaves),
    ToRecord(r) -> held_record(emitter, r.fields, r.locals, r.word),
    ToValue(v) ->
      {
        emitter: note_holder(emitter, v.name),
        value: { kind: v.kind, expr: v.name, ty: TyOpen([]) },
      },
    ToLoop(_) -> { emitter: emitter, value: { kind: KBoxed, expr: b"ply_unit", ty: TyOpen([]) } },
  }

/// The cases of the sum constructor `tag` builds at node `c`, and its index among them, where the
/// value at hand is taken as a sum's constructor and argument.
fn ctor_case(emitter: Emitter, c: Code, tag: Int) -> Option<{ cases: SumCases, i: Int }> =
  match leaves_cases(emitter, c) {
    Some(sc) -> match emitter.ctors.names.at(tag) {
      Some(bare) -> match case_index(sc, bare) {
        Some(i) -> Some({ cases: sc, i: i }),
        None -> None,
      },
      None -> None,
    },
    None -> None,
  }

/// `v`, a held-back sum's argument, as a value of its own with a count of its own.
fn case_copy(emitter: Emitter, v: CValue) -> WithValue =
  if !counted(v.kind) { { emitter: emitter, value: v } } else {
    match deferred_of(emitter, v.expr) {
      Some(d) -> copied_record(emitter, v, d),
      None -> {
        let w = owned_word(emitter, v);
        { emitter: note_holder(w.emitter, w.value.expr), value: { ..w.value, ty: v.ty } }
      },
    }
  }

/// The constructor `name` at `c` as a value: held back where its sum is taken as its constructor and
/// argument, `None` as zero, and otherwise as the runtime answers it, which has no arities: a nullary
/// constructor's singleton or a function.
fn ctor_value(emitter: Emitter, c: Code, name: Bytes) -> WithValue / {abort.raise} =
  match tag_of(emitter, name) {
    None -> refused(emitter, b"a constructor not in the table: ".concat(name)),
    Some(tag) -> if ctor_case(emitter, c, tag) != None {
      held_ctor(emitter, ctor_case(emitter, c, tag), [])
    } else if is_option(emitter, tag, b"None") { bind(emitter, KSum(Zeroed), b"0") } else {
      let o = bind(
        emitter,
        KBoxed,
        Bytes::concat_all([b"rt_ctor_value_p(ctx, ", tag_text(emitter, tag), b")"]),
      );
      { emitter: check(o.emitter), value: o.value }
    },
  }

/// The constructor `at` names of `vals`, held back as itself and its argument, which it holds a
/// count of its own of.
fn held_ctor(
  emitter: Emitter,
  at: Option<{ cases: SumCases, i: Int }>,
  vals: List<CValue>,
) -> WithValue =
  match at {
    None -> refused(emitter, b"a constructor held back outside its sum"),
    Some(at) -> match vals.at(0) {
      None -> held_sum_at(emitter, at.cases, at.i, None),
      Some(v) -> {
        let arg = match nth_case(at.cases, at.i).arg {
          Some(Whole(k)) -> if k == KBoxed { owned_arg(emitter, v) }
          else { bind(emitter, k, as_kind(v, k)) },
          Some(Fields(_)) -> match deferred_of(emitter, v.expr) {
            Some(_) -> held_copy(emitter, v),
            None -> owned_arg(emitter, v),
          },
          _ -> owned_arg(emitter, v),
        };
        held_sum_at(arg.emitter, at.cases, at.i, Some(arg.value))
      },
    },
  }

/// `v` as a word this scope holds a count of and lets go at its scope's end unless handed on.
fn owned_arg(emitter: Emitter, v: CValue) -> WithValue = {
  let w = owned(emitter, v);
  {
    emitter: if is_made(w.emitter, w.value.expr) { w.emitter }
    else { note_holder(w.emitter, w.value.expr) },
    value: { ..w.value, ty: v.ty },
  }
}

/// The cases of the sum the node `c` is, where the value at hand is taken as its constructor and
/// argument and its type crosses so: the node's type, or at the root's answer the answer's.
fn leaves_cases(emitter: Emitter, c: Code) -> Option<SumCases> =
  if !emitter.leaves { None } else {
    match match node_type(emitter, c) {
        Some(t) -> Some(carrier_of(t)),
        None -> if emitter.tail { Some(emitter.answer) } else { None },
      } {
      Some(Cases(sc)) -> Some(sc),
      _ -> None,
    }
  }

/// The locals a sum of cases `c` is joined in: its constructor's index and each value past it.
fn sum_locals(
  emitter: Emitter,
  c: SumCases,
) -> { emitter: Emitter, tag: Bytes, leaves: List<CValue> } = {
  let t = fresh(emitter);
  let declared = sum_leaves(c).fold(
    { emitter: line(t.emitter, Bytes::concat_all([b"int64_t ", t.name, b" = 0;"])), leaves: [] },
    |acc: { emitter: Emitter, leaves: List<CValue> }, f: FieldTy| {
      let l = fresh(acc.emitter);
      {
        emitter: line(
          l.emitter,
          Bytes::concat_all([carried_type(f.kind), b" ", l.name, b" = ", zero_of(f.kind), b";"]),
        ),
        leaves: acc.leaves.push({ kind: f.kind, expr: l.name, ty: f.ty }),
      }
    },
  );
  { emitter: declared.emitter, tag: t.name, leaves: declared.leaves }
}

/// `value`, a sum of cases `c`, handed to the locals `tag` and `leaves` it is joined in.
fn sum_into(
  emitter: Emitter,
  value: CValue,
  c: SumCases,
  tag: Bytes,
  leaves: List<CValue>,
) -> Emitter = {
  let h = handed_sum(emitter, value, c);
  range(0, h.names.len()).fold(h.emitter, |acc: Emitter, k: Int|
    line(
      acc,
      Bytes::concat_all([
        if k == 0 { tag } else { nth_value(leaves, k - 1).expr },
        b" = ",
        nth_bytes(h.names, k),
        b";",
      ]),
    ))
}

fn arm_body(
  emitter: Emitter,
  sink: Sink,
  body: Code,
  params: List<EmitParam>,
) -> Option<Emitter> / {abort.raise} =
  match sink {
    ToLoop(l) -> emit_step(emitter, body, l.state, l.answer, params, l.depth),
    _ -> match expr(emitter, body, params) {
      None -> None,
      Some(o) -> Some(sunk(o.emitter, o.value, sink)),
    },
  }

/// An arm's answer `value` handed to where its join holds it.
fn sunk(emitter: Emitter, value: CValue, sink: Sink) -> Emitter =
  match sink {
    ToValue(ans) -> if is_sum(ans.kind) {
      let w = match ans.kind {
        KSum(spec) -> sum_owned(emitter, value, spec),
        _ -> owned(emitter, value),
      };
      line(w.emitter, Bytes::concat_all([ans.name, b" = ", w.value.expr, b";"]))
    } else { assigned_word(emitter, ans.name, value) },
    ToRecord(r) -> record_into(emitter, value, r.fields, r.locals, r.word),
    ToSum(t) -> sum_into(emitter, value, t.cases, t.tag, t.leaves),
    ToLoop(_) -> emitter,
  }

/// The fields of the record a `match`'s arm builds, where one builds a record that crosses a call as
/// its fields: its arms then join as an `if`'s do, each field's value and the record's word in a
/// local of its own.
fn matched_record(emitter: Emitter, arms: List<CodeArm>) -> Option<List<FieldTy>> =
  arms.fold(None, |found: Option<List<FieldTy>>, a: CodeArm|
    match found { Some(fs) -> Some(fs), None -> built_fields(emitter, a.body) })

/// Whether an arm of a `match` answers an `Option` held as its payload's word: one it builds, or a
/// variable bound outside the arm, or such a variable's field, held so already. The match then
/// answers it as that word.
fn matched_option(emitter: Emitter, arms: List<CodeArm>, params: List<EmitParam>) -> Bool =
  arms.fold(false, |found: Bool, a: CodeArm|
    found || answers_option(emitter, a.body, pat_slots(a.pat), params))

/// `bound` are the slots the arms around `code` bind.
fn answers_option(emitter: Emitter, code: Code, bound: List<Int>, params: List<EmitParam>) -> Bool =
  match code.node {
    NApp(a) -> a.args.len() == 1 && names_option(emitter, a.func, b"Some"),
    NVar(v) -> match v.slot {
      Some(s) -> option_held(emitter, s, bound, None, params),
      None -> names_option(emitter, code, b"None"),
    },
    NField(f) -> match f.base.node {
      NVar(v) -> match v.slot {
        Some(s) -> option_held(emitter, s, bound, Some(f.field), params),
        None -> false,
      },
      _ -> false,
    },
    NBlock(b) -> match b.tail {
      Some(t) -> answers_option(emitter, t, bound, params),
      None -> false,
    },
    NIf(i) ->
      answers_option(emitter, i.then_branch, bound, params)
        || answers_option(emitter, i.else_branch, bound, params),
    NMatch(m) ->
      m.arms.fold(false, |found: Bool, a: CodeArm|
        found || answers_option(emitter, a.body, bound.concat(pat_slots(a.pat)), params)),
    _ -> false,
  }

/// Whether slot `s`, where no arm around rebinds it, holds an `Option` as its payload's word, or,
/// with `field`, a record whose field `field` is held so.
fn option_held(
  emitter: Emitter,
  s: Int,
  bound: List<Int>,
  field: Option<Bytes>,
  params: List<EmitParam>,
) -> Bool =
  !bound.contains(s)
    && (match field {
      None -> match slot_value(emitter, params, s) {
        Some(cv) -> cv.kind == KSum(Zeroed),
        // A parameter that came as an `Option`'s word.
        None -> match params.at(s) { Some(p) -> p.kind == KSum(Zeroed), None -> false },
      },
      Some(name) -> match slot_value(emitter, params, s) {
        None -> false,
        Some(cv) -> match built_field(emitter, cv.expr, name) {
          Some(x) -> x.kind == KSum(Zeroed),
          None -> match field_at(cv.ty, name) {
            Some(fa) -> fa.kind == KSum(Zeroed),
            None -> false,
          },
        },
      },
    })

/// Whether `code` names the prelude's constructor `name`.
fn names_option(emitter: Emitter, code: Code, name: Bytes) -> Bool =
  match code.node {
    NVar(v) -> match v.slot {
      Some(_) -> false,
      None -> match tag_of(emitter, v.name) {
        Some(tag) -> is_option(emitter, tag, name),
        None -> false,
      },
    },
    _ -> false,
  }

fn built_fields(emitter: Emitter, code: Code) -> Option<List<FieldTy>> =
  match code.node {
    NRecord(_) -> carried_fields(emitter, code.span),
    NUpdate(_) -> carried_fields(emitter, code.span),
    NBlock(b) -> match b.tail { Some(t) -> built_fields(emitter, t), None -> None },
    _ -> None,
  }

type RecordLocals = { emitter: Emitter, values: List<CValue>, word: Bytes }

/// A local for each leaf of a record of `fields` and then one for the record's word, declared
/// holding `inits` in that order.
fn record_locals(emitter: Emitter, fields: List<FieldTy>, inits: List<Bytes>) -> RecordLocals = {
  let leaves = record_leaves(fields);
  let ls = range(0, leaves.len()).fold(
    { emitter: emitter, values: [] },
    |acc: { emitter: Emitter, values: List<CValue> }, k: Int| {
      let f = nth_field(leaves, k);
      let l = fresh(acc.emitter);
      {
        emitter: line(
          l.emitter,
          Bytes::concat_all([ctype(f.kind), b" ", l.name, b" = ", nth_bytes(inits, k), b";"]),
        ),
        values: acc.values.push({ kind: f.kind, expr: l.name, ty: f.ty }),
      }
    },
  );
  let w = fresh(ls.emitter);
  {
    emitter: line(
      w.emitter,
      Bytes::concat_all([b"Word ", w.name, b" = ", nth_bytes(inits, leaves.len()), b";"]),
    ),
    values: ls.values,
    word: w.name,
  }
}

fn empty_inits(fields: List<FieldTy>) -> List<Bytes> =
  record_leaves(fields).map(|f: FieldTy| zero_of(f.kind)).push(b"0")

fn into_of(fields: List<FieldTy>, ls: RecordLocals) -> Into =
  { fields: fields, locals: ls.values, word: ls.word }

fn assigned_into(emitter: Emitter, value: CValue, into: Into) -> Emitter =
  if into.fields.len() == 0 { assigned_word(emitter, into.word, value) }
  else { record_into(emitter, value, into.fields, into.locals, into.word) }

/// A loop's state as a pass takes it over, its counts with it, from the locals `into` holds it in
/// between passes, which each pass assigns its answer back into; a state held whole is of `kind`.
fn taken_over(emitter: Emitter, into: Into, kind: Kind, ty: Ty) -> WithValue =
  if into.fields.len() == 0 {
    let h = bind_keeping(emitter, kind, ty, into.word);
    { emitter: note_holder(h.emitter, h.value.expr), value: h.value }
  } else {
    let copies = record_locals(
      emitter,
      into.fields,
      into.locals.map(|v: CValue| v.expr).push(into.word),
    );
    held_record(copies.emitter, into.fields, copies.values, copies.word)
  }

/// How a loop state of carrier `c` goes round: a sum as its word.
fn state_of(c: Carrier) -> Carrier = match c { Cases(sc) -> Whole(KSum(sc.spec)), other -> other }

/// How lambda `l`'s first parameter, a loop's state, goes round the loop: as `carrier_of` has it
/// cross a call.
fn state_carrier(emitter: Emitter, l: Lambda) -> Carrier =
  match emitter.typed.get(span_key(l.at)) {
    Some(t) -> match t.ty {
      TyFn(f) -> match f.params.at(0) { Some(p) -> state_of(carrier_of(p)), None -> Whole(KBoxed) },
      _ -> Whole(KBoxed),
    },
    None -> Whole(KBoxed),
  }

/// The fields of the record the checker typed `span` as, where it crosses a call as its leaves.
fn carried_fields(emitter: Emitter, span: Span) -> Option<List<FieldTy>> =
  match typed_kind(emitter.typed, span).ty {
    TyRec(fs) -> if carried_record(fs) { Some(fs) } else { None },
    _ -> None,
  }

/// `value`, a record of `fields`, handed to the `locals` of its leaves and the `word` a join or a
/// loop holds it in, as a call is handed it: each counted leaf with a count they hold.
fn record_into(
  emitter: Emitter,
  value: CValue,
  fields: List<FieldTy>,
  locals: List<CValue>,
  word: Bytes,
) -> Emitter = {
  let h = handed_record(emitter, value, fields);
  let n = locals.len();
  range(0, n + 1).fold(h.emitter, |acc: Emitter, k: Int|
    line(
      acc,
      Bytes::concat_all([
        if k < n { nth_value(locals, k).expr } else { word },
        b" = ",
        nth_bytes(h.names, k),
        b";",
      ]),
    ))
}

/// A match's subject: an `Option` held as its payload's word as it is, anything else as its word.
fn match_subject(
  emitter: Emitter,
  scrutinee: Code,
  params: List<EmitParam>,
) -> Option<{ emitter: Emitter, subj: CValue }> / {abort.raise} =

  // A slice is matched where it stands: its patterns read its base from its offset on.
  match match scrutinee.node {
      NVar(v) -> match v.slot {
        Some(s) -> match conv_of(emitter, s) {
          Some(cv) -> if slice_of(emitter, cv.expr) != None { Some(cv) } else { None },
          None -> None,
        },
        None -> None,
      },
      _ -> None,
    } {
    Some(cv) -> Some({ emitter: emitter, subj: cv }),
    None -> match expr(with_leaves(notail(emitter)), scrutinee, params) {
      None -> None,
      Some(sc0) -> {
        let sc = { ..sc0, emitter: notail(sc0.emitter) };
        let ty = typed_value(sc.emitter, scrutinee, sc.value).ty;
        if is_sum(sc.value.kind) {
          let subj = bind_keeping(sc.emitter, sc.value.kind, ty, sc.value.expr);
          Some({ emitter: subj.emitter, subj: subj.value })
        } else {
          let sw = word_of(sc.emitter, sc.value);
          let subj = bind_keeping(sw.emitter, KBoxed, ty, sw.expr);
          Some({ emitter: subj.emitter, subj: subj.value })
        }
      },
    },
  }

/// Arms over one flag; a body falling off the end raises. `tail` and `leaves` are the match's own position, which evaluating the subject cleared.
fn match_arms(
  emitter: Emitter,
  subj: CValue,
  xs: List<CodeArm>,
  params: List<EmitParam>,
  sink: Sink,
  span: Span,
  tail: Bool,
  leaves: Bool,
) -> Option<Emitter> / {abort.raise} = {
  let flag = fresh(emitter);
  let opened = line(flag.emitter, Bytes::concat_all([b"int ", flag.name, b" = 0;"]));
  match arms(
      withtail(opened, { tail: tail, leaves: leaves }),
      xs,
      params,
      0,
      subj,
      sink,
      flag.name,
      opened.count_locals,
      [],
    ) {
    None -> None,
    Some(after) ->
      Some(
        line(
          site(after, span),
          Bytes::concat_all([
            b"if (!",
            flag.name,
            b") { rt_no_match_p(ctx); ",
            leaving(after),
            b" }",
          ]),
        ),
      ),
  }
}

/// Outside the immediate range an `Int` is boxed, and so is every word that can equal it.
fn int_test(subj: Bytes, n: Int) -> Bytes =
  if n >= 0 - 4611686018427387904 && n < 4611686018427387904 {
    Bytes::concat_all([
      b"(ply_is_imm(",
      subj,
      b") ? ply_imm_value(",
      subj,
      b") == ",
      int_lit(n),
      b" : 0)",
    ])
  } else {
    Bytes::concat_all([
      b"(",
      subj,
      b" != 0 && !ply_is_imm(",
      subj,
      b") && rt_unbox_int_p(ctx, ",
      subj,
      b") == ",
      int_lit(n),
      b")",
    ])
  }

/// An `Int` or a carried width from `lo` through `hi`. Every word that can be in the immediate
/// range is immediate, so bounds inside it leave a boxed word out.
fn int_between(subj: Bytes, lo: Int, hi: Int) -> Bytes = {
  let within = |v: Bytes|
    Bytes::concat_all([b"(", v, b" >= ", int_lit(lo), b" && ", v, b" <= ", int_lit(hi), b")"]);
  let immediate = within(Bytes::concat_all([b"ply_imm_value(", subj, b")"]));
  if lo >= 0 - 4611686018427387904 && hi < 4611686018427387904 {
    Bytes::concat_all([b"(ply_is_imm(", subj, b") ? ", immediate, b" : 0)"])
  } else {
    Bytes::concat_all([
      b"(",
      subj,
      b" != 0 && (ply_is_imm(",
      subj,
      b") ? ",
      immediate,
      b" : ",
      within(Bytes::concat_all([b"rt_unbox_int_p(ctx, ", subj, b")"])),
      b"))",
    ])
  }
}

/// A range over a width past 32 bits, whose values the runtime orders, against the unit's constants.
fn between_test(
  emitter: Emitter,
  lo: Lit,
  hi: Lit,
  subj: CValue,
) -> { emitter: Emitter, expr: Bytes } = {
  let from = from_table(emitter, lo);
  let to = from_table(from.emitter, hi);
  let held = bind(
    to.emitter,
    KBool,
    Bytes::concat_all([
      b"(",
      subj.expr,
      b" != 0 && rt_between_p(ctx, ",
      subj.expr,
      b", ",
      from.value.expr,
      b", ",
      to.value.expr,
      b"))",
    ]),
  );
  { emitter: check(held.emitter), expr: held.value.expr }
}

/// As `==` compares, against the unit's constant: a string or byte string by its bytes, a character
/// by its word, anything else as the runtime compares it. A zero subject is an enclosing test that
/// failed.
fn equal_test(emitter: Emitter, literal: Lit, subj: CValue) -> { emitter: Emitter, expr: Bytes } = {
  let k = from_table(emitter, literal);
  let same = match literal {
    LStr(_) -> bytes_equal(subj.expr, k.value.expr),
    LBytes(_) -> bytes_equal(subj.expr, k.value.expr),
    LChar(_) -> Bytes::concat_all([b"(", subj.expr, b" == ", k.value.expr, b")"]),
    _ -> Bytes::concat_all([b"rt_equal_p(ctx, ", subj.expr, b", ", k.value.expr, b")"]),
  };
  let eq = bind(k.emitter, KBool, Bytes::concat_all([b"(", subj.expr, b" != 0 && ", same, b")"]));
  { emitter: check(eq.emitter), expr: eq.value.expr }
}

/// `v`, a value a pattern tests, as patterns read it: a word, a sum's word, or a record held back,
/// and any other value made its word.
fn tested_value(emitter: Emitter, v: CValue) -> WithValue =
  if v.kind == KBoxed || is_sum(v.kind) { { emitter: emitter, value: v } }
  else { bind(emitter, KBoxed, as_word(v)) }

/// A nested pattern reads a field into a local under the test so far, since reading a non-record raises. `None` for an unsupported pattern.
fn pat_test(
  pattern: CodePattern,
  subj: CValue,
  emitter: Emitter,
) -> Option<{ emitter: Emitter, expr: Bytes }> / {abort.raise} =
  match pattern {
    PxWild -> Some({ emitter: emitter, expr: b"1" }),
    PxVar(_) -> Some({ emitter: emitter, expr: b"1" }),
    PxLit(l) -> match l {
      LInt(n) -> Some({ emitter: emitter, expr: int_test(subj.expr, n) }),
      // At 64 bits a width is the runtime's own object, not an immediate.
      LFixed(name, bits) -> match width_named(name) {
        None -> None,
        Some(w) -> if in_imm(w) { Some({ emitter: emitter, expr: int_test(subj.expr, bits) }) }
        else { Some(equal_test(emitter, l, subj)) },
      },
      LBool(b) ->
        Some({
          emitter: emitter,
          expr: Bytes::concat_all([
            b"(",
            subj.expr,
            b" == ",
            if b { b"ply_true" } else { b"ply_false" },
            b")",
          ]),
        }),
      // `()` is the only value of its type.
      LUnit -> Some({ emitter: emitter, expr: b"1" }),
      LBad -> None,
      _ -> Some(equal_test(emitter, l, subj)),
    },
    PxRange(r) -> match ((r.lo, r.hi)) {
      (LInt(lo), LInt(hi)) -> Some({ emitter: emitter, expr: int_between(subj.expr, lo, hi) }),
      (LFixed(name, lo), LFixed(_, hi)) -> match width_named(name) {
        None -> None,
        Some(w) -> if in_imm(w) { Some({ emitter: emitter, expr: int_between(subj.expr, lo, hi) }) }
        else { Some(between_test(emitter, r.lo, r.hi, subj)) },
      },
      (LWide(_, _, _), LWide(_, _, _)) -> Some(between_test(emitter, r.lo, r.hi, subj)),
      _ -> None,
    },
    // A constructor tests its tag and width over an object; an argument with its own test is read into a local under the test so far.
    // A nested subject is zero when an enclosing test failed, and its header must not be read then.
    // A sum held as its word: `None` zero and `Some` that word otherwise; `Err` the word tagged
    // `100` and `Ok` any other. The argument is the word, untagged for `Err`.
    // A sum held back tests its constructor's index, and its argument is the value it holds.
    PxCtor(c) -> match held_sum_of(emitter, subj.expr) {
      Some(h) -> match case_index(h.cases, ctor_bare(emitter, c.name)) {
        None -> None,
        Some(i) -> {
          let tested = Bytes::concat_all([b"(", h.tag, b" == ", ascii_of_int(i), b")"]);
          match c.args.at(0) {
            None -> Some({ emitter: emitter, expr: tested }),
            Some(sub) -> if irrefutable(sub) { Some({ emitter: emitter, expr: tested }) } else {
              match h.args.at(i) {
                Some(Some(v)) -> {
                  let w = tested_value(emitter, v);
                  match pat_test(sub, w.value, w.emitter) {
                    None -> None,
                    Some(inner) ->
                      Some({
                        emitter: inner.emitter,
                        expr: Bytes::concat_all([b"(", tested, b" && ", inner.expr, b")"]),
                      }),
                  }
                },
                _ -> None,
              }
            },
          }
        },
      },
      None -> if is_sum(subj.kind) {
        let case = sum_case(emitter, subj.kind, c.name, subj.expr);
        match c.args.at(0) {
          None -> Some({ emitter: emitter, expr: case.test }),
          Some(sub) -> if irrefutable(sub) { Some({ emitter: emitter, expr: case.test }) } else {
            match pat_test(
                sub,
                { kind: KBoxed, expr: case.arg, ty: arg_ty(emitter, subj, c.name) },
                emitter,
              ) {
              None -> None,
              Some(inner) ->
                Some({
                  emitter: inner.emitter,
                  expr: Bytes::concat_all([b"(", case.test, b" && ", inner.expr, b")"]),
                }),
            }
          },
        }
      } else {
        match tag_of(emitter, c.name) {
          None -> None,
          Some(tag) -> {
            let head = Bytes::concat_all([
              b"(",
              subj.expr,
              b" != 0 && !ply_is_imm(",
              subj.expr,
              b") && ply_obj(",
              subj.expr,
              b")->kind == 4 && ply_obj(",
              subj.expr,
              b")->layout == ",
              tag_text(emitter, tag),
              b" && ply_obj(",
              subj.expr,
              b")->len == ",
              ascii_of_int(ctor_width(emitter, tag, c.args.len())),
              b")",
            ]);
            let laid = ctor_fields(emitter, tag);
            range(0, c.args.len()).fold(
              Some({ emitter: emitter, expr: head }),
              |acc: Option<{ emitter: Emitter, expr: Bytes }>, k: Int|
                match acc {
                  None -> None,
                  Some(t) -> match c.args.at(k) {
                    None -> None,
                    Some(sub) -> if irrefutable(sub) { Some(t) } else {
                      let read = arg_tested(t.emitter, t.expr, subj.expr, k, laid);
                      let field = {
                        emitter: read.emitter,
                        value: {
                          ..read.value,
                          ty: known_or(read.value.ty, arg_ty(read.emitter, subj, c.name)),
                        },
                      };
                      match pat_test(sub, field.value, field.emitter) {
                        None -> None,
                        Some(inner) ->
                          Some({
                            emitter: inner.emitter,
                            expr: Bytes::concat_all([b"(", t.expr, b" && ", inner.expr, b")"]),
                          }),
                      }
                    },
                  },
                },
            )
          },
        }
      },
    },
    // A record held back tests each field's pattern on the value it holds.
    PxRecord(r) -> if deferred_of(emitter, subj.expr) != None {
      r.fields.fold(
        Some({ emitter: emitter, expr: b"1" }),
        |acc: Option<{ emitter: Emitter, expr: Bytes }>, f: CodePatternField|
          match acc {
            None -> None,
            Some(t) -> if irrefutable(f.pat) { acc } else {
              match built_field(t.emitter, subj.expr, f.name) {
                None -> None,
                Some(v) -> {
                  let w = tested_value(t.emitter, v);
                  match pat_test(f.pat, w.value, w.emitter) {
                    None -> None,
                    Some(inner) ->
                      Some({
                        emitter: inner.emitter,
                        expr: Bytes::concat_all([b"(", t.expr, b" && ", inner.expr, b")"]),
                      }),
                  }
                },
              }
            },
          },
      )
    } else {
      // Refutable despite the shape: a non-record, the field count without `..`, or a missing field.
      match pattern_slots(subj.ty, r.fields) {
        // A record of a known layout holds every field its type names: only the fields' own
        // patterns are tested, each on the field read where it stands.
        Some(slots) ->
          range(0, r.fields.len()).fold(
            Some({ emitter: emitter, expr: is_object(subj.expr) }),
            |acc: Option<{ emitter: Emitter, expr: Bytes }>, i: Int|
              match acc {
                None -> None,
                Some(t) -> match r.fields.at(i) {
                  None -> acc,
                  Some(f) -> if irrefutable(f.pat) { acc } else {
                    match slots.at(i) {
                      None -> None,
                      Some(x) -> {
                        let field = laid_tested(t.emitter, t.expr, subj.expr, x);
                        match pat_test(f.pat, field.value, field.emitter) {
                          None -> None,
                          Some(inner) ->
                            Some({
                              emitter: inner.emitter,
                              expr: Bytes::concat_all([b"(", t.expr, b" && ", inner.expr, b")"]),
                            }),
                        }
                      },
                    }
                  },
                },
              },
          ),
        None -> {
          let head = Bytes::concat_all([
            b"(",
            is_object(subj.expr),
            b" && rt_record_fits_p(ctx, ",
            subj.expr,
            b", ",
            ascii_of_int(r.fields.len()),
            b", ",
            if r.rest { b"0" } else { b"1" },
            b"))",
          ]);
          r.fields.fold(
            Some({ emitter: emitter, expr: head }),
            |acc: Option<{ emitter: Emitter, expr: Bytes }>, f: CodePatternField|
              match acc {
                None -> None,
                Some(t) -> {
                  let idx = field_of(t.emitter, f.name);
                  let has = Bytes::concat_all([
                    b"(",
                    t.expr,
                    b" && rt_record_has_p(ctx, ",
                    subj.expr,
                    b", @@f",
                    ascii_of_int(idx.i),
                    b"@@))",
                  ]);
                  if irrefutable(f.pat) { Some({ emitter: idx.emitter, expr: has }) } else {
                    let field = bind(
                      idx.emitter,
                      KBoxed,
                      Bytes::concat_all([
                        b"(",
                        has,
                        b" ? rt_field_p(ctx, ",
                        subj.expr,
                        b", @@f",
                        ascii_of_int(idx.i),
                        b"@@, 0) : 0)",
                      ]),
                    );
                    match pat_test(
                        f.pat,
                        field.value,
                        note_holder(check(field.emitter), field.value.expr),
                      ) {
                      None -> None,
                      Some(inner) ->
                        Some({
                          emitter: inner.emitter,
                          expr: Bytes::concat_all([b"(", has, b" && ", inner.expr, b")"]),
                        }),
                    }
                  }
                },
              },
          )
        },
      }
    },
    // A refutable `..rest` would allocate the tail inside a test that may fail, so it is refused.
    PxList(l) -> if match l.rest { Some(r) -> !irrefutable(r), None -> false } { None } else {
      let sliced = slice_of(emitter, subj.expr);
      let head = match sliced {
        Some(sl) ->
          Bytes::concat_all([
            b"((int64_t)ply_obj(",
            sl.base,
            b")->len - ",
            sl.from,
            match l.rest { Some(_) -> b" >= ", None -> b" == " },
            ascii_of_int(l.items.len()),
            b")",
          ]),
        None ->
          Bytes::concat_all([
            b"rt_list_fits_p(ctx, ",
            subj.expr,
            b", ",
            ascii_of_int(l.items.len()),
            b", ",
            match l.rest { Some(_) -> b"0", None -> b"1" },
            b")",
          ]),
      };
      range(0, l.items.len()).fold(
        Some({ emitter: emitter, expr: head }),
        |acc: Option<{ emitter: Emitter, expr: Bytes }>, i: Int|
          match acc {
            None -> None,
            Some(t) -> match l.items.at(i) {
              None -> None,
              Some(item) -> if irrefutable(item) { Some(t) } else {
                let at = bind(
                  t.emitter,
                  KBoxed,
                  Bytes::concat_all([
                    b"(",
                    t.expr,
                    b" ? ",
                    list_at_text(sliced, subj, i),
                    b" : 0)",
                  ]),
                );
                match pat_test(item, at.value, note_holder(check(at.emitter), at.value.expr)) {
                  None -> None,
                  Some(inner) ->
                    Some({
                      emitter: inner.emitter,
                      expr: Bytes::concat_all([b"(", t.expr, b" && ", inner.expr, b")"]),
                    }),
                }
              },
            },
          },
      )
    },
  }

/// Argument `k` of constructor object `subj` as a word, read where `so_far` holds and zero where it
/// does not: borrowed from the object, but for a raw argument, boxed and held by this body.
fn arg_tested(
  emitter: Emitter,
  so_far: Bytes,
  subj: Bytes,
  k: Int,
  laid: Option<List<FieldTy>>,
) -> WithValue =
  laid_tested(emitter, so_far, subj, match match laid { Some(fs) -> arg_at(fs, k), None -> None } {
    Some(x) -> x,
    None -> { at: k, kind: KBoxed, ty: TyOpen([]) },
  })

/// What `x` lays out in the object `subj` as a word, read where `so_far` holds and zero where it
/// does not: borrowed from the object, but for a raw value, boxed and held by this body.
fn laid_tested(
  emitter: Emitter,
  so_far: Bytes,
  subj: Bytes,
  x: { at: Int, kind: Kind, ty: Ty },
) -> WithValue =
  if raw_slot(x.kind) {
    let boxed = bind(
      emitter,
      KBoxed,
      Bytes::concat_all([
        b"(",
        so_far,
        b" ? ",
        as_word({ kind: x.kind, expr: raw_at(subj, ascii_of_int(x.at), x.kind), ty: TyOpen([]) }),
        b" : 0)",
      ]),
    );
    { emitter: note_holder(check(boxed.emitter), boxed.value.expr), value: boxed.value }
  } else {
    bind_keeping(
      emitter,
      word_kind(x.kind),
      x.ty,
      Bytes::concat_all([b"(", so_far, b" ? ", field_read(subj, x), b" : 0)"]),
    )
  }

/// Whether the word `w` is an object's. Under a pattern that did not match it is not: zero, an
/// immediate, or a `Result`'s tagged `Err`.
fn is_object(w: Bytes) -> Bytes =
  Bytes::concat_all([b"(", w, b" != 0 && ((uint64_t)", w, b" & 7) == 0)"])

/// Where each field `fields` names is laid out in a record of `ty`; none unless `ty` lays out every
/// one of them.
fn pattern_slots(
  ty: Ty,
  fields: List<CodePatternField>,
) -> Option<List<{ at: Int, kind: Kind, ty: Ty }>> =
  match ty {
    TyRec(_) ->
      fields.fold(
        Some([]),
        |acc: Option<List<{ at: Int, kind: Kind, ty: Ty }>>, f: CodePatternField|
          match acc {
            None -> None,
            Some(slots) -> match field_at(ty, f.name) {
              Some(x) -> Some(slots.push(x)),
              None -> None,
            },
          },
      ),
    _ -> None,
  }

/// What `x` lays out in the object `subj`, read where it stands: a scalar held apart as itself, a
/// word as the object still holds it.
fn laid_read(emitter: Emitter, subj: Bytes, x: { at: Int, kind: Kind, ty: Ty }) -> WithValue =
  if raw_slot(x.kind) { bind(emitter, x.kind, raw_at(subj, ascii_of_int(x.at), x.kind)) }
  else { bind_keeping(emitter, word_kind(x.kind), x.ty, field_read(subj, x)) }

/// `laid_read`, with a count of its own where the value is counted.
fn laid_held(emitter: Emitter, subj: Bytes, x: { at: Int, kind: Kind, ty: Ty }) -> WithValue = {
  let w = laid_read(emitter, subj, x);
  if !counted(w.value.kind) { w } else {
    {
      emitter: note_holder(
        line(w.emitter, Bytes::concat_all([b"ply_inc(", w.value.expr, b");"])),
        w.value.expr,
      ),
      value: w.value,
    }
  }
}

/// Where argument `k` of a constructor laid out as `fs` starts, and how it is held.
fn arg_at(fs: List<FieldTy>, k: Int) -> Option<{ at: Int, kind: Kind, ty: Ty }> =
  match fs.at(k) {
    Some(f) -> match laid_of(fs).offsets.at(k) {
      Some(at) -> Some({ at: at, kind: f.kind, ty: f.ty }),
      None -> None,
    },
    None -> None,
  }

/// Whether `pattern` matches the record held back as `name` whatever its values: one of its fields,
/// each irrefutable.
fn matches_held(emitter: Emitter, name: Bytes, pattern: CodePattern) -> Bool =
  deferred_of(emitter, name) != None
    && (match pattern {
      PxRecord(r) ->
        r.fields.fold(true, |ok: Bool, f: CodePatternField|
          ok && built_field(emitter, name, f.name) != None && irrefutable(f.pat)),
      _ -> irrefutable(pattern),
    })

/// A constructor's argument is duplicated when bound: the object still holds it.
fn pat_bind(emitter: Emitter, pattern: CodePattern, subj: CValue) -> Emitter / {abort.raise} =
  match pattern {
    // The binder carries the subject's shape, so `match r { x -> x.f }` reads at an offset.
    PxVar(v) -> match v.slot {
      None -> emitter,
      Some(s) -> {
        // What the subject's own shape does not say, the type the checker bound says.
        let ty = match subj.ty {
          TyOpen(_) -> typed_kind(emitter.typed, v.span).ty,
          known -> known,
        };
        // A sum held back is bound as its word.
        let ready = match held_sum_of(emitter, subj.expr) {
          Some(h) -> sum_made(emitter, h, !is_pinned(emitter, subj.expr)),
          None -> emitter,
        };
        let b = bind_keeping(ready, subj.kind, ty, subj.expr);
        remember(ensure_owned(b.emitter, b.value), s, b.value)
      },
    },
    // The argument of a sum held as its word is that word, untagged for `Err`; its binder takes
    // the subject's count where the subject moves into it, and holds one of its own where it does not.
    // A sum held back binds the argument it holds, a copy of it where a failing guard may hand the
    // subject on to the next arm.
    PxCtor(c) -> match held_sum_of(emitter, subj.expr) {
      Some(h) -> match c.args.at(0) {
        None -> emitter,
        Some(sub) -> match case_index(h.cases, ctor_bare(emitter, c.name)) {
          None -> emitter,
          Some(i) -> match h.args.at(i) {
            Some(Some(v)) -> {
              let a = if is_pinned(emitter, subj.expr) { case_copy(emitter, v) }
              else { { emitter: emitter, value: v } };
              pat_bind(a.emitter, sub, a.value)
            },
            _ -> emitter,
          },
        },
      },
      None -> if is_sum(subj.kind) {
        match c.args.at(0) {
          None -> emitter,
          Some(sub) -> {
            let case = sum_case(emitter, subj.kind, c.name, subj.expr);
            let ty = arg_ty(emitter, subj, c.name);
            if case.arg == subj.expr {
              let w = bind_keeping(emitter, KBoxed, ty, subj.expr);
              pat_bind(ensure_owned(w.emitter, w.value), sub, w.value)
            } else {
              let w = bind_keeping(emitter, KBoxed, ty, case.arg);
              if emitter.release && spendable(w.emitter, subj.expr) {
                let moved = line(
                  note_made(spend_made(w.emitter, subj.expr), w.value.expr),
                  Bytes::concat_all([subj.expr, b" = 0;"]),
                );
                pat_bind(moved, sub, w.value)
              } else { pat_bind(ensure_owned(w.emitter, w.value), sub, w.value) }
            }
          },
        }
      } else {
        // Every argument is read and duplicated whether or not the pattern names it, so the arm's scope has one shape.
        let laid = match tag_of(emitter, c.name) {
          Some(tag) -> ctor_fields(emitter, tag),
          None -> None,
        };
        range(0, c.args.len()).fold(emitter, |acc: Emitter, i: Int| {
          let f = match laid { Some(fs) -> arg_at(fs, i), None -> None };
          let w = laid_held(acc, subj.expr, match f {
            Some(x) -> x,
            None -> { at: i, kind: KBoxed, ty: TyOpen([]) },
          });
          // The object holds the argument as a word, which the subject's type says the layout of.
          let arg = { ..w.value, ty: known_or(w.value.ty, arg_ty(w.emitter, subj, c.name)) };
          match c.args.at(i) { Some(sub) -> pat_bind(w.emitter, sub, arg), None -> w.emitter }
        })
      },
    },
    // A record held back binds its values, each moved out where the record is spent; otherwise the
    // runtime's read by name answers the field duplicated, with no increment here.
    PxRecord(r) -> if deferred_of(emitter, subj.expr) != None {
      let spent = spendable(emitter, subj.expr);
      r.fields.fold(emitter, |acc: Emitter, f: CodePatternField|
        match built_field(acc, subj.expr, f.name) {
          Some(v) -> match moved_field(acc, spent, subj, v) {
            Some(m) -> pat_bind(note_made(m.emitter, m.value.expr), f.pat, m.value),
            None -> pat_bind(acc, f.pat, v),
          },
          None -> acc,
        })
    } else {
      match pattern_slots(subj.ty, r.fields) {
        // A record of a known layout hands over each field from where it holds it.
        Some(slots) ->
          range(0, r.fields.len()).fold(emitter, |acc: Emitter, i: Int|
            match r.fields.at(i) {
              Some(f) -> match slots.at(i) {
                Some(x) -> {
                  let w = laid_held(acc, subj.expr, x);
                  pat_bind(w.emitter, f.pat, w.value)
                },
                None -> acc,
              },
              None -> acc,
            }),
        None ->
          r.fields.fold(emitter, |acc: Emitter, f: CodePatternField| {
            let idx = field_of(acc, f.name);
            let field = bind(
              idx.emitter,
              KBoxed,
              Bytes::concat_all([
                b"rt_field_p(ctx, ",
                subj.expr,
                b", @@f",
                ascii_of_int(idx.i),
                b"@@, 0)",
              ]),
            );
            pat_bind(check(field.emitter), f.pat, field.value)
          }),
      }
    },
    PxList(l) -> {
      let sliced = slice_of(emitter, subj.expr);
      let items = range(0, l.items.len()).fold(emitter, |acc: Emitter, i: Int| {
        let at = bind(acc, KBoxed, list_at_text(sliced, subj, i));
        match l.items.at(i) {
          Some(item) -> pat_bind(check(at.emitter), item, at.value),
          None -> check(at.emitter),
        }
      });
      match l.rest {
        None -> items,
        Some(r) -> match sliced {
          // The rest of a slice is the same list from further on, bound without a copy.
          Some(sl) -> match r {
            PxVar(v) -> match v.slot {
              Some(s) -> {
                let from = bind(
                  items,
                  KInt,
                  Bytes::concat_all([sl.from, b" + ", ascii_of_int(l.items.len())]),
                );
                let f = fresh(from.emitter);
                remember(note_slice(f.emitter, f.name, sl.base, from.value.expr), s, {
                  kind: KBoxed,
                  expr: f.name,
                  ty: subj.ty,
                })
              },
              None -> items,
            },
            PxWild -> items,
            _ -> {
              let tail = bind(
                items,
                KBoxed,
                Bytes::concat_all([
                  b"rt_list_rest_p(ctx, ",
                  sl.base,
                  b", ",
                  sl.from,
                  b" + ",
                  ascii_of_int(l.items.len()),
                  b")",
                ]),
              );
              pat_bind(check(tail.emitter), r, tail.value)
            },
          },
          None -> {
            let tail = bind(
              items,
              KBoxed,
              Bytes::concat_all([
                b"rt_list_rest_p(ctx, ",
                subj.expr,
                b", ",
                ascii_of_int(l.items.len()),
                b")",
              ]),
            );
            pat_bind(check(tail.emitter), r, tail.value)
          },
        },
      }
    },
    _ -> emitter,
  }

/// Element `i` of the list `subj` a pattern reads, from a slice's offset on where it is one.
fn list_at_text(sliced: Option<Slice>, subj: CValue, i: Int) -> Bytes =
  match sliced {
    Some(sl) ->
      Bytes::concat_all([
        b"rt_list_at_p(ctx, ",
        sl.base,
        b", ",
        sl.from,
        b" + ",
        ascii_of_int(i),
        b")",
      ]),
    None -> Bytes::concat_all([b"rt_list_at_p(ctx, ", subj.expr, b", ", ascii_of_int(i), b")"]),
  }

/// An `if` arm goes into its own buffer so what follows it can still be numbered.
fn arm(
  emitter: Emitter,
  code: Code,
  params: List<EmitParam>,
) -> Option<{ emitter: Emitter, text: Bytes, value: CValue }> / {abort.raise} =
  match expr(indent(emitter), code, params) {
    None -> None,
    Some(o) ->
      Some({ emitter: outdent(o.emitter), text: bytes_join(o.emitter.out, b""), value: o.value }),
  }

/// An `if` whose arms answer a sum taken as its constructor and argument: each arm's handed to the
/// locals the sum is held back as after the `if`, its holders released behind it. `j` is the
/// join's number and what came before, `cv` the condition, `t` and `e` the arms.
fn if_sum_join(
  j: { emitter: Emitter, name: Bytes },
  cv: WithValue,
  t: { emitter: Emitter, text: Bytes, value: CValue },
  e: { emitter: Emitter, text: Bytes, value: CValue },
  sc: SumCases,
) -> WithValue = {
  let locals = sum_locals(rescope(with_out(e.emitter, []), cv.emitter.unboxed), sc);
  let ind = locals.emitter.indent;
  let ta = sum_assigned(
    locals.emitter,
    t.emitter,
    t.text,
    ind,
    t.value,
    sc,
    locals.tag,
    locals.leaves,
  );
  let ea = sum_assigned(ta.emitter, e.emitter, e.text, ind, e.value, sc, locals.tag, locals.leaves);
  let body = Bytes::concat_all([
    bytes_join(j.emitter.out, b""),
    bytes_join(locals.emitter.out, b""),
    pad(ind),
    b"if (",
    cv.value.expr,
    b") {\n",
    ta.text,
    pad(ind),
    b"} else {\n",
    ea.text,
    pad(ind),
    b"}\n",
  ]);
  held_sum_from(
    {
      ..ea.emitter,
      out: [body],
      unboxed: cv.emitter.unboxed,
      count_locals: union_made(ta.made, ea.made),
    },
    sc,
    locals.tag,
    locals.leaves,
  )
}

/// An arm of a sum's join: its sum handed to the join's locals, and the arm's holders released.
fn sum_assigned(
  emitter: Emitter,
  arm_em: Emitter,
  text: Bytes,
  ind: Int,
  value: CValue,
  sc: SumCases,
  tag: Bytes,
  leaves: List<CValue>,
) -> { emitter: Emitter, text: Bytes, made: List<CountLocal> } = {
  let arm = with_made(indent(with_out(emitter, [])), arm_em.count_locals);
  let m3 = release_at(sum_into(arm, value, sc, tag, leaves), ind + 1);
  {
    emitter: outdent(with_out(with_made(m3, emitter.count_locals), emitter.out)),
    text: Bytes::concat_all([text, bytes_join(m3.out, b"")]),
    made: m3.count_locals,
  }
}

fn assigned(
  emitter: Emitter,
  arm_em: Emitter,
  text: Bytes,
  ind: Int,
  k: Kind,
  value: CValue,
  join: Bytes,
) -> { emitter: Emitter, text: Bytes, made: List<CountLocal> } = {
  // The join takes the arm's value; the arm's own holders are released behind it.
  let m2 = if is_sum(k) || is_sum(value.kind) {
    // A sum joins as its word where it does as one, and as its object elsewhere.
    let arm = with_made(indent(with_out(emitter, [])), arm_em.count_locals);
    let o = match k { KSum(spec) -> sum_owned(arm, value, spec), _ -> owned(arm, value) };
    line(o.emitter, Bytes::concat_all([join, b" = ", o.value.expr, b";"]))
  } else {
    let m = indent(with_out(emitter, []));
    let m0 = match k {
      KBoxed -> materialise(m, value.expr, spends(with_made(m, arm_em.count_locals), value.expr)),
      _ -> m,
    };
    let m1 = line(m0, Bytes::concat_all([join, b" = ", as_kind(value, k), b";"]));
    if counted(k) { assign_owned(with_made(m1, arm_em.count_locals), join, value.expr) }
    else { with_made(m1, arm_em.count_locals) }
  };
  let m3 = release_at(m2, ind + 1);
  {
    emitter: outdent(with_out(with_made(m3, emitter.count_locals), emitter.out)),
    text: Bytes::concat_all([text, bytes_join(m3.out, b"")]),
    made: m3.count_locals,
  }
}

fn as_kind(value: CValue, k: Kind) -> Bytes =
  match k {
    KBoxed -> as_word(value),
    KSum(spec) -> if value.kind == KSum(spec) { value.expr } else { b"ply_maybe_unrouted" },
    KInt -> as_int(value),
    KBool -> as_bool(value),
    KNum(w) -> as_num(value, w),
    KFloat -> as_float(value),
    KDec -> as_dec(value),
  }

/// An arm of a record-valued join: its record assigned into the join's locals, and the arm's
/// holders released.
fn joined(
  emitter: Emitter,
  arm_em: Emitter,
  text: Bytes,
  value: CValue,
  fields: List<FieldTy>,
  ls: RecordLocals,
) -> { text: Bytes, made: List<CountLocal>, temps: Int, declared: List<Bytes> } = {
  let a0 = with_made(indent(with_out(emitter, [])), arm_em.count_locals);
  let a2 = release_at(record_into(a0, value, fields, ls.values, ls.word), emitter.indent + 1);
  {
    text: Bytes::concat_all([text, bytes_join(a2.out, b"")]),
    made: a2.count_locals,
    temps: a2.temp_count,
    // A record an arm moves out of the one it hands over is held back under a name the function
    // declares.
    declared: a2.deferred_locals,
  }
}

fn blank(emitter: Emitter) -> Emitter =
  {
    out: [],
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: emitter.built,
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: emitter.released,
    reuse_widths: emitter.reuse_widths,
    alias: emitter.alias,
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred,
    deferred_locals: emitter.deferred_locals,
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
    slices: emitter.slices,
    sums: emitter.sums,
    leaves: emitter.leaves,
  }

/// The shape both arms answer when both built a record of the same shape; otherwise the join is one local.
fn shared_shape(emitter: Emitter, a: CValue, b: CValue) -> Option<List<FieldTy>> =
  match a.ty {
    TyRec(na) -> match b.ty {
      TyRec(nb) -> if same_names(names_of(na), names_of(nb))
          && na.filter(|f: FieldTy| in_place(f) != None).map(spelled_field)
          == nb.filter(|f: FieldTy| in_place(f) != None).map(spelled_field)
          && sorted_names(names_of(na)).fold(true, |acc: Bool, nm: Bytes|
            acc
              && (match built_field(emitter, a.expr, nm) {
                None -> false,
                Some(x) -> match built_field(emitter, b.expr, nm) {
                  None -> false,
                  Some(y) -> x.kind == y.kind,
                },
              })) {
        // Each field held as both arms built it; a record in place as its type lays it out.
        Some(
          sorted_names(names_of(na)).map(|nm: Bytes| {
            let f = na.fold(nth_field([], 0), |found: FieldTy, x: FieldTy|
              if x.name == nm { x } else { found });
            if in_place(f) != None { f } else {
              {
                name: nm,
                kind: match built_field(emitter, a.expr, nm) { Some(x) -> x.kind, None -> KInt },
                ty: TyOpen([]),
              }
            }
          }),
        )
      } else { None },
      _ -> None,
    },
    _ -> None,
  }

/// Sorted by name: the order a shape holds its fields in.
fn sorted_names(ns: List<Bytes>) -> List<Bytes> =
  range(0, ns.len()).fold([], |acc: List<Bytes>, i: Int|
    ns.fold(acc, |a2: List<Bytes>, n: Bytes| if rank_of(ns, n) == i { a2.push(n) } else { a2 }))

/// `INT64_C(-9223372036854775808)` negates an unsigned literal, which C cannot write as a constant, so the least `Int` is named.
fn int_lit(n: Int) -> Bytes =
  if n == 0 - 9223372036854775807 - 1 { b"INT64_MIN" }
  else { Bytes::concat_all([b"INT64_C(", ascii_of_int(n), b")"]) }

/// Two literals folded under an operator: `+`, `-`, `*` only without overflow, a shift only by a count the width holds.
fn lit_int(code: Code) -> Option<Int> =
  match code.node {
    NLit(l) -> match l { LInt(n) -> Some(n), _ -> None },
    NBinary(b) -> match lit_int(b.lhs) {
      None -> None,
      Some(a) -> match lit_int(b.rhs) {
        None -> None,
        Some(x) -> if b.op == b"add" { checked_add(a, x) }
        else if b.op == b"sub" { checked_sub(a, x) }
        else if b.op == b"mul" { checked_mul(a, x) }
        else if b.op == b"bitand" { Some(a & x) }
        else if b.op == b"bitor" { Some(a | x) }
        else if b.op == b"bitxor" { Some(a ^ x) }
        else if b.op == b"shl" && x >= 0 && x < 64 { Some(a << x) }
        else if b.op == b"shr" && x >= 0 && x < 64 { Some(a >> x) }
        else if b.op == b"ushr" && x >= 0 && x < 64 { Some(a >>> x) }
        else { None },
      },
    },
    _ -> None,
  }

fn checked_add(a: Int, b: Int) -> Option<Int> = {
  let s = wrap_add(a, b);
  if a >= 0 == (b >= 0) && s >= 0 != (a >= 0) { None } else { Some(s) }
}

fn checked_sub(a: Int, b: Int) -> Option<Int> = {
  let s = wrap_sub(a, b);
  if a >= 0 != (b >= 0) && s >= 0 != (a >= 0) { None } else { Some(s) }
}

fn checked_mul(a: Int, b: Int) -> Option<Int> =
  if a == 0 || b == 0 { Some(0) }
  else if a == -1 { checked_sub(0, b) }
  else if b == -1 { checked_sub(0, a) } else {
    let p = wrap_mul(a, b);
    if p / a == b && p % a == 0 { Some(p) } else { None }
  }

/// The kind two arms of one type join as. An `Option` either arm holds as its payload's word joins
/// as that word; a `Result` either holds as its word joins as it where it is the root's answer,
/// handed back as one, and as its object elsewhere.
fn join_kind(emitter: Emitter, a: Kind, b: Kind) -> Kind =
  if a == b { a }
  else if a == KSum(Zeroed) || b == KSum(Zeroed) { KSum(Zeroed) } else {
    match answers_sum(emitter) {
      Some(spec) -> if a == KSum(spec) || b == KSum(spec) { KSum(spec) } else { KBoxed },
      None -> KBoxed,
    }
  }

/// How the value at hand, where it is the root's answer and the root hands back a sum as its word,
/// is that word.
fn answers_sum(emitter: Emitter) -> Option<SumSpec> =
  if emitter.tail { match emitter.answer { Whole(KSum(spec)) -> Some(spec), _ -> None } }
  else { None }

fn is_bitop(op: Bytes) -> Bool = op == b"bitand" || op == b"bitor" || op == b"bitxor"

fn is_shift(op: Bytes) -> Bool = op == b"shl" || op == b"shr" || op == b"ushr"

fn bitop_c(op: Bytes) -> Bytes =
  if op == b"bitand" { b"&" } else if op == b"bitor" { b"|" } else { b"^" }

/// `rt_overflow`'s numbering of the operation that overflowed; a remainder never leaves its width.
fn overflow_code(op: Bytes) -> Int =
  if op == b"add" { 0 }
  else if op == b"sub" { 1 }
  else if op == b"neg" { 2 }
  else if op == b"mul" { 3 }
  else { 4 }

fn narrow(wide: WithValue, width: Width, code: Int) -> Option<WithValue> = {
  let g = line(
    wide.emitter,
    Bytes::concat_all([
      b"if (",
      wide.value.expr,
      b" < ",
      int_lit(width_min(width)),
      b" || ",
      wide.value.expr,
      b" > ",
      int_lit(width_max(width)),
      b") { rt_overflow_p(ctx, ",
      ascii_of_int(code),
      b"); ",
      leaving(wide.emitter),
      b" }",
    ]),
  );
  Some(bind(g, KNum(width), Bytes::concat_all([b"(", ctype(KNum(width)), b")", wide.value.expr])))
}

fn negated(emitter: Emitter, value: CValue, t: Operand, span: Span) -> Option<WithValue> =
  match t {
    // A width negates wide and narrows back, under the same guard as a subtraction.
    OWidth(w) -> if in_imm(w) {
      narrow(
        bind(
          site(emitter, span),
          KInt,
          Bytes::concat_all([b"-(int64_t)(", as_num(value, w), b")"]),
        ),
        w,
        overflow_code(b"neg"),
      )
    } else if carried(w) && w.signed {
      let a = bind(site(emitter, span), KNum(w), as_num(value, w));
      let g = line(
        a.emitter,
        Bytes::concat_all([
          b"if (",
          a.value.expr,
          b" == INT64_MIN) { rt_overflow_p(ctx, ",
          ascii_of_int(overflow_code(b"neg")),
          b"); ",
          leaving(emitter),
          b" }",
        ]),
      );
      Some(bind(g, KNum(w), Bytes::concat_all([b"-(", a.value.expr, b")"])))
    } else { by_runtime(site(emitter, span), b"rt_negate_p", value) },
    OInt -> {
      // Negation overflows at one input; the guard runs before the value exists.
      let a = as_int(value);
      let g = line(
        site(emitter, span),
        Bytes::concat_all([
          b"if (",
          a,
          b" == INT64_MIN) { rt_overflow_p(ctx, ",
          ascii_of_int(overflow_code(b"neg")),
          b"); ",
          leaving(emitter),
          b" }",
        ]),
      );
      Some(bind(g, KInt, Bytes::concat_all([b"-(", a, b")"])))
    },
    OFloat -> Some(bind(emitter, KFloat, Bytes::concat_all([b"-(", as_float(value), b")"]))),
    ODec -> {
      let d = held_raw(emitter, value, KDec);
      let out = fresh(d.emitter);
      let e = line(
        out.emitter,
        Bytes::concat_all([
          b"PlyDec ",
          out.name,
          b"; rt_decimal_negate_p(ctx, ",
          d.value.expr,
          b".lo, ",
          d.value.expr,
          b".hi, (Word)(intptr_t)&",
          out.name,
          b");",
        ]),
      );
      Some({ emitter: e, value: { kind: KDec, expr: out.name, ty: TyOpen([]) } })
    },
    _ -> by_runtime(site(emitter, span), b"rt_negate_p", value),
  }

fn inverted(emitter: Emitter, value: CValue, t: Operand) -> Option<WithValue> =
  match t {
    OWidth(w) -> if carried(w) {
      Some(
        bind(
          emitter,
          KNum(w),
          Bytes::concat_all([b"(", ctype(KNum(w)), b") ~(", as_num(value, w), b")"]),
        ),
      )
    } else { by_runtime(emitter, b"rt_bitnot_p", value) },
    _ -> Some(bind(emitter, KInt, Bytes::concat_all([b"~(", as_int(value), b")"]))),
  }

/// A unary operator over the runtime's own word: a `Float`, a `Decimal` or a width past 32 bits.
fn by_runtime(emitter: Emitter, helper: Bytes, value: CValue) -> Option<WithValue> = {
  let held = owned(emitter, value);
  let out = bind(
    held.emitter,
    KBoxed,
    Bytes::concat_all([helper, b"(ctx, ", held.value.expr, b")"]),
  );
  Some({ emitter: check(out.emitter), value: out.value })
}

/// The count is tested against the width (64 for `Int`), and the shift done unsigned where C would leave it undefined.
fn shift(emitter: Emitter, op: Bytes, l: CValue, r: CValue, width: Option<Width>) -> WithValue = {
  let bound = match width { Some(t) -> t.bits, None -> 64 };
  let count = bind(emitter, KInt, as_int(r));
  let which = match width { Some(t) -> ascii_of_int(width_index(t)), None -> b"-1" };
  let g = line(
    count.emitter,
    Bytes::concat_all([
      b"if ((uint64_t)",
      count.value.expr,
      b" >= (uint64_t)",
      ascii_of_int(bound),
      b") { rt_shift_count_p(ctx, ",
      count.value.expr,
      b", ",
      which,
      b"); ",
      leaving(emitter),
      b" }",
    ]),
  );
  match width {
    Some(t) -> {
      let a = as_num(l, t);
      let u = unsigned_ctype(t);
      bind(g, KNum(t), if op == b"shl" {
        Bytes::concat_all([b"(", u, b")((", u, b")(", a, b") << ", count.value.expr, b")"])
      } else if op == b"shr" && t.signed {
        Bytes::concat_all([b"(", a, b") >> ", count.value.expr])
      } else {
        Bytes::concat_all([b"(", u, b")((", u, b")(", a, b") >> ", count.value.expr, b")"])
      })
    },
    None -> {
      let a = as_int(l);
      bind(g, KInt, if op == b"shl" {
        Bytes::concat_all([b"(int64_t)((uint64_t)(", a, b") << ", count.value.expr, b")"])
      } else if op == b"shr" { Bytes::concat_all([b"(", a, b") >> ", count.value.expr]) }
      else { Bytes::concat_all([b"(int64_t)((uint64_t)(", a, b") >> ", count.value.expr, b")"]) })
    },
  }
}

/// Arithmetic over a width is done wide and narrowed back under the overflow guard; the rest in the width itself.
/// At 64 bits there is no wider type: a sum or difference is guarded as it is formed, and the rest is the runtime's.
fn width_binary(emitter: Emitter, op: Bytes, l: CValue, r: CValue, t: Width) -> Option<WithValue> = {
  let a = as_num(l, t);
  let bb = as_num(r, t);
  if is_arithmetic(op) && !in_imm(t) { Some(wide_arithmetic(emitter, op, a, bb, t)) }
  else if is_arithmetic(op) {
    let wide = if op == b"add" {
      bind(emitter, KInt, Bytes::concat_all([b"(int64_t)(", a, b") + (int64_t)(", bb, b")"]))
    } else if op == b"sub" {
      bind(emitter, KInt, Bytes::concat_all([b"(int64_t)(", a, b") - (int64_t)(", bb, b")"]))
    } else {
      let w = bind(
        emitter,
        KInt,
        Bytes::concat_all([
          b"rt_arith_p(ctx, ",
          ascii_of_int(arith_code(op)),
          b", (int64_t)(",
          a,
          b"), (int64_t)(",
          bb,
          b"))",
        ]),
      );
      { emitter: check(w.emitter), value: w.value }
    };
    narrow(wide, t, overflow_code(op))
  } else if is_bitop(op) {
    Some(bind(emitter, KNum(t), Bytes::concat_all([b"(", a, b") ", bitop_c(op), b" (", bb, b")"])))
  } else if is_shift(op) { Some(shift(emitter, op, l, r, Some(t))) } else if op == b"eq" {
    Some(bind(emitter, KBool, Bytes::concat_all([b"(", a, b") == (", bb, b")"])))
  } else if op == b"ne" {
    Some(bind(emitter, KBool, Bytes::concat_all([b"!((", a, b") == (", bb, b"))"])))
  } else {
    match compare_op(op) {
      Some(c) ->
        Some(bind(emitter, KBool, Bytes::concat_all([b"(", a, b") ", c, b" (", bb, b")"]))),
      None -> None,
    }
  }
}

/// `a op b` over a 64-bit width.
fn wide_arithmetic(emitter: Emitter, op: Bytes, a: Bytes, b: Bytes, t: Width) -> WithValue =
  if op == b"add" || op == b"sub" {
    let r = fresh(emitter);
    let declared = line(r.emitter, Bytes::concat_all([ctype(KNum(t)), b" ", r.name, b";"]));
    let over = if t.signed {
      Bytes::concat_all([
        if op == b"add" { b"ply_add_ov(" } else { b"ply_sub_ov(" },
        a,
        b", ",
        b,
        b", &",
        r.name,
        b")",
      ])
    } else {
      Bytes::concat_all([
        b"(",
        r.name,
        b" = (uint64_t)(",
        a,
        if op == b"add" { b") + (uint64_t)(" } else { b") - (uint64_t)(" },
        b,
        b"), ",
        if op == b"add" { Bytes::concat_all([r.name, b" < (uint64_t)(", a, b"))"]) }
        else { Bytes::concat_all([b"(uint64_t)(", a, b") < (uint64_t)(", b, b"))"]) },
      ])
    };
    let g = line(
      declared,
      Bytes::concat_all([
        b"if (",
        over,
        b") { rt_overflow_p(ctx, ",
        ascii_of_int(overflow_code(op)),
        b"); ",
        leaving(emitter),
        b" }",
      ]),
    );
    { emitter: g, value: { kind: KNum(t), expr: r.name, ty: TyOpen([]) } }
  } else {
    let w = bind(
      emitter,
      KNum(t),
      Bytes::concat_all([
        b"(",
        ctype(KNum(t)),
        b")rt_wide_binary_p(ctx, ",
        ascii_of_int(binary_code(op)),
        b", ",
        ascii_of_int(width_index(t)),
        b", (Word)(",
        a,
        b"), (Word)(",
        b,
        b"))",
      ]),
    );
    { emitter: check(w.emitter), value: w.value }
  }

/// The operand type decides the whole operator, wherever the operands came from.
fn binary_rest(
  emitter: Emitter,
  op: Bytes,
  l: CValue,
  r: CValue,
  t: Operand,
  at: Span,
) -> Option<WithValue> / {abort.raise} =
  match t {
    OInt -> Some(int_binary(emitter, op, l, r)),
    OWidth(w) -> if carried(w) { width_binary(emitter, op, l, r, w) }
    else { word_binary(emitter, op, l, r, None, at) },
    OBool -> if op == b"eq" || op == b"ne" {
      Some(
        bind(
          emitter,
          KBool,
          Bytes::concat_all([
            if op == b"ne" { b"!((" } else { b"((" },
            as_bool(l),
            b") == (",
            as_bool(r),
            b"))",
          ]),
        ),
      )
    } else { Some(unsettled_operator(emitter, op)) },
    OFloat -> float_binary(emitter, op, l, r),
    ODec -> dec_binary(emitter, op, l, r),
    // A `Char`'s word is its code point above a tag, so its words compare as its code points do.
    OChar -> match compare_op(op) {
      Some(c) ->
        Some(
          bind(
            emitter,
            KBool,
            Bytes::concat_all([b"(", as_word(l), b") ", c, b" (", as_word(r), b")"]),
          ),
        ),
      None -> Some(unsettled_operator(emitter, op)),
    },
    // Two strings or byte strings are equal as their bytes are, compared where they lie.
    OText -> if op == b"eq" || op == b"ne" {
      let a = bind(emitter, KBoxed, as_word(l));
      let b = bind(a.emitter, KBoxed, as_word(r));
      let x = a.value.expr;
      let y = b.value.expr;
      Some(
        bind(b.emitter, KBool, if op == b"ne" { b"!".concat(bytes_equal(x, y)) }
        else { bytes_equal(x, y) }),
      )
    } else { word_binary(emitter, op, l, r, None, at) },
    OSum(t) -> if op == b"eq" || op == b"ne" { Some(sum_equal(emitter, op, l, r, t)) }
    else { word_binary(emitter, op, l, r, None, at) },
    OWhole(t) -> if (op == b"eq" || op == b"ne") && (walked_container(t) || is_result(t)) {
      let o = container_called(emitter, b"equal", t, [l, r], at);
      Some(if op == b"ne" { not_of(o) } else { o })
    } else if (op == b"eq" || op == b"ne") && generic_sum(emitter.ctors, t) {
      Some(sum_equal_by_root(emitter, op, l, r, spelled_type(t)))
    } else if op == b"eq" || op == b"ne" { word_binary(emitter, op, l, r, Some(t), at) }
    else { word_binary(emitter, op, l, r, None, at) },
    OWord -> word_binary(emitter, op, l, r, None, at),
  }

/// Whether `==` and `compare` of two values of `t` walk them through roots written for `t`: a
/// `List`, an `Array` or a `Map` whose type is known throughout.
fn walked_container(t: Type) -> Bool =
  !has_vars(t)
    && (match t {
      TyCon(c) -> c.name == b"List" || c.name == b"Array" || c.name == b"Map",
      _ -> false,
    })

/// The `Bool` `o` holds, negated.
fn not_of(o: WithValue) -> WithValue =
  bind(o.emitter, KBool, Bytes::concat_all([b"!(", as_bool(o.value), b")"]))

/// Whether two `Some`s' payload words `a` and `b`, of type `t` where it is known, are equal: a
/// string or byte string by its bytes, an `Int` by its value, a `Bool`, a `Char` or `Unit` by its
/// word, and anything else as the runtime compares two words.
fn payload_compared(a: Bytes, b: Bytes, t: Option<Type>) -> Bytes =
  match t {
    Some(TyCon(c)) -> if c.args.len() > 0 { runtime_equal(a, b) }
    else if c.name == b"String" || c.name == b"Bytes" { bytes_equal(a, b) }
    else if c.name == b"Int" {
      let value = |w: Bytes|
        Bytes::concat_all([
          b"(ply_is_imm(",
          w,
          b") ? ply_imm_value(",
          w,
          b") : rt_unbox_int_p(ctx, ",
          w,
          b"))",
        ]);
      Bytes::concat_all([b"(", value(a), b" == ", value(b), b")"])
    } else if c.name == b"Bool" || c.name == b"Char" || c.name == b"Unit" {
      Bytes::concat_all([b"(", a, b" == ", b, b")"])
    } else { runtime_equal(a, b) },
    _ -> runtime_equal(a, b),
  }

/// Whether `t` is a record whose fields' types are known, compared through the root written for it
/// where it is held as a word rather than in place.
fn rooted_record(t: Option<Type>) -> Bool =
  match t {
    Some(TyRecord(_)) -> !has_vars(t.unwrap_or(unknown_type())),
    Some(TyNominal(_)) -> !has_vars(t.unwrap_or(unknown_type())),
    _ -> false,
  }

/// The name a sum of type `t` is compared by through `T#eq`: a declared one by its name, a generic
/// one at known arguments as spelled.
fn declared_sum(emitter: Emitter, t: Option<Type>) -> Option<Bytes> =
  match t {
    Some(TyCon(c)) -> if c.args.len() == 0 && compared_by_ctors(emitter.ctors, c.name) {
      Some(c.name)
    } else if generic_sum(emitter.ctors, TyCon(c)) { Some(spelled_type(TyCon(c))) }
    else { None },
    _ -> None,
  }

fn runtime_equal(a: Bytes, b: Bytes) -> Bytes =
  Bytes::concat_all([b"rt_equal_p(ctx, ", a, b", ", b, b")"])

/// What an `Option` of type `t` holds, where `t` is one.
fn payload_type(t: Option<Type>) -> Option<Type> =
  match t { Some(TyCon(c)) -> if c.name == b"Option" { c.args.at(0) } else { None }, _ -> None }

fn is_text(t: Option<Type>) -> Bool =
  match t {
    Some(TyCon(c)) -> c.args.len() == 0 && (c.name == b"String" || c.name == b"Bytes"),
    _ -> false,
  }

/// Whether `t` is the record a map's entries list holds, `{key, value}`.
fn is_entry(t: Type) -> Bool =
  match t { TyRecord(fs) -> fs.map(|f: Field| f.name) == [b"key", b"value"], _ -> false }

/// The type of field `name` of a record of type `t`.
fn field_type(t: Option<Type>, name: Bytes) -> Option<Type> =
  match t {
    Some(TyRecord(fs)) ->
      fs.fold(None, |acc: Option<Type>, f: Field| if f.name == name { Some(f.ty) } else { acc }),
    Some(TyNominal(x)) ->
      x.fields.fold(None, |acc: Option<Type>, f: Field|
        if f.name == name { Some(f.ty) } else { acc }),
    _ -> None,
  }

/// `t` where it is a container `walked_container` walks.
fn walked_type(t: Option<Type>) -> Option<Type> =
  match t { Some(ty) -> if walked_container(ty) { Some(ty) } else { None }, None -> None }

/// Whether two `Option`s held as their payloads' words `a` and `b` are equal: `None` is zero, and
/// two `Some`s are equal as the root written for their payloads' type `t` compares them.
fn payloads_equal(
  emitter: Emitter,
  a: Bytes,
  b: Bytes,
  t: Type,
  at: Span,
) -> WithValue / {abort.raise} = {
  let eq = fresh(emitter);
  let opened = indent(
    line(
      line(
        eq.emitter,
        Bytes::concat_all([
          b"int64_t ",
          eq.name,
          b" = (",
          a,
          b" == 0 || ",
          b,
          b" == 0) ? (",
          a,
          b" == ",
          b,
          b") : 1;",
        ]),
      ),
      Bytes::concat_all([b"if (", a, b" != 0 && ", b, b" != 0) {"]),
    ),
  );
  let e = container_called(
    opened,
    b"equal",
    t,
    // Copies the root takes, made only where it runs: the operands stay their holders'.
    [
      { kind: KBoxed, expr: Bytes::concat_all([b"(Word)(", a, b")"]), ty: TyOpen([]) },
      { kind: KBoxed, expr: Bytes::concat_all([b"(Word)(", b, b")"]), ty: TyOpen([]) },
    ],
    at,
  );
  let closed = line(
    outdent(
      release_at(
        line(e.emitter, Bytes::concat_all([eq.name, b" = ", as_bool(e.value), b";"])),
        opened.indent,
      ),
    ),
    b"}",
  );
  { emitter: closed, value: { kind: KBool, expr: eq.name, ty: TyOpen([]) } }
}

/// The roots written for containers beside those of `reflect`, `shown` and `digest`: `equal` and
/// `ordered` of two, answering as `==` and `compare` do, and the loops the roots run from an index:
/// over two containers for those, and over one, gathering what each item writes, for the others.
fn container_ops() -> List<Bytes> =
  [
    b"equal",
    b"equal_from",
    b"ordered",
    b"ordered_from",
    b"reflect_from",
    b"shown_from",
    b"digest_from",
    b"reflect_entries_from",
    b"shown_entries_from",
    b"digest_entries_from",
  ]

/// Each root written for containers of type `t` in `module`, as a definition of the module, so a
/// root's call of another, or of itself, is a call of a definition: the two-container ones take
/// both and the loops an index after, the others take the container and the loops a list they add
/// to and an index after.
fn container_defs(module: Bytes, t: Type) -> List<Def> / {abort.raise} =
  [b"reflect", b"shown", b"digest"].concat(container_ops()).map(|op: Bytes| {
    let root = written_root(module, op, t);
    let arity = if op.ends_with(b"_from") { 3 }
    else if op == b"equal" || op == b"ordered" { 2 }
    else { 1 };
    let answer = if op == b"equal" || op == b"equal_from" { KBool } else { KBoxed };
    {
      name: local_root(module, root),
      ret: Some(answer),
      ret_ty: TyOpen([]),
      pure: true,
      arity: arity,
      scheme: None,
      carriers: range(0, arity).map(|i: Int| Whole(if i == 2 { KInt } else { KBoxed })),
      answer: Whole(answer),
      witnesses: 0,
    }
  })

/// The body of the root written for `op` of containers of type `t`, as lowered code over its
/// parameters `a`, `b` and, for the loops, `i`, the operand and binder types it files, and the
/// definitions its calls name. Two lists or arrays are equal where they have one length and each
/// pair at an index is equal, and ordered by the first pair that is not equal, a shorter one first
/// where the other begins with it; two maps as the lists of their entries in key order are. A
/// container is reflected, shown or digested item by item at the items' type, a map entry by entry.
fn container_code(
  module: Bytes,
  op: Bytes,
  t: Type,
) -> { code: Code, operands: Map<Bytes, Bytes>, typed: Map<Bytes, Typed>, here: List<Def> } / {abort.raise} = {
  let at = |node: Node, span: Span| { own: Borrowed, node: node, span: span };
  let placed = |k: Int| { start: 0, end: k, gen: 1 };
  let var = |name: Bytes, slot: Int| at(NVar({ name: name, slot: Some(slot) }), dummy_span());
  let named = |name: Bytes| at(NVar({ name: name, slot: None }), dummy_span());
  let lit = |l: Lit| at(NLit(l), dummy_span());
  let call = |f: Code, args: List<Code>| at(NApp({ func: f, args: args }), dummy_span());
  let builtin = |name: Bytes, k: Int| at(NVar({ name: name, slot: None }), placed(k));
  let binary = |op2: Bytes, l: Code, r: Code, k: Int|
    at(NBinary({ op: op2, lhs: l, rhs: r }), placed(k));
  let args = match t { TyCon(c) -> c.args, _ -> [] };
  let kind = match t { TyCon(c) -> c.name, _ -> b"" };
  let fields_of = match t { TyRecord(fs) -> fs, TyNominal(x) -> x.fields, _ -> [] };
  let value = TyCon({ name: b"std.value.Value", args: [] });
  // What a `Result`'s `Err` holds.
  let failure = match args.at(1) { Some(e) -> e, None -> unknown_type() };
  // A map is walked as the list of its entries.
  let walked = if kind == b"Map" {
    TyCon({
      name: b"List",
      args: [
        TyRecord([
          { name: b"key", ty: match args.at(0) { Some(k) -> k, None -> unknown_type() } },
          { name: b"value", ty: match args.at(1) { Some(v) -> v, None -> unknown_type() } },
        ]),
      ],
    })
  } else { t };
  let item = match walked {
    TyCon(c) -> match c.args.at(0) { Some(e) -> e, None -> unknown_type() },
    _ -> unknown_type(),
  };
  let field = |name: Bytes|
    match item {
      TyRecord(fs) ->
        fs.fold(unknown_type(), |acc: Type, f: Field| if f.name == name { f.ty } else { acc }),
      _ -> unknown_type(),
    };
  let of = if kind == b"Array" { b"Array::" } else { b"List::" };
  let loop_named = |name: Bytes| {
    let root = written_root(module, name, walked);
    local_root(module, root)
  };
  let here = if kind == b"Map" { container_defs(module, t).concat(container_defs(module, walked)) }
  else { container_defs(module, t) };
  let typed = [
    { k: 0, ty: filed_as(unknown_type(), args) },
    { k: 1, ty: filed_as(unknown_type(), args) },
    { k: 3, ty: filed_as(unknown_type(), [item]) },
    { k: 4, ty: filed_as(unknown_type(), [item]) },
    { k: 5, ty: filed_as(item, []) },
    { k: 6, ty: filed_as(item, []) },
    { k: 9, ty: filed_as(unknown_type(), [item]) },
    { k: 13, ty: filed_as(unknown_type(), [item]) },
    { k: 14, ty: filed_as(TyCon({ name: b"List", args: [value] }), []) },
    { k: 15, ty: filed_as(unknown_type(), [item]) },
    { k: 16, ty: filed_as(unknown_type(), [field(b"key")]) },
    { k: 17, ty: filed_as(unknown_type(), [field(b"value")]) },
    {
      k: 18,
      ty: filed_as(TyRecord([{ name: b"key", ty: value }, { name: b"value", ty: value }]), []),
    },
    {
      k: 19,
      ty: filed_as(
        TyCon({
          name: b"List",
          args: [TyRecord([{ name: b"key", ty: value }, { name: b"value", ty: value }])],
        }),
        [],
      ),
    },
    { k: 20, ty: filed_as(TyCon({ name: b"List", args: [bytes_type()] }), []) },
    { k: 21, ty: filed_as(unknown_type(), [int_type()]) },
    { k: 23, ty: filed_as(failure, []) },
    { k: 24, ty: filed_as(failure, []) },
    { k: 25, ty: filed_as(unknown_type(), [failure]) },
  ].fold(Map::new(), |m: Map<Bytes, Typed>, x: { k: Int, ty: Typed }|
    m.insert(span_key(placed(x.k)), x.ty));
  let operands = Map::new().insert(span_key(placed(2)), b"Int").insert(
    span_key(placed(7)),
    compared_name(item),
  ).insert(
    span_key(placed(8)),
    b"Int",
  ).insert(
    span_key(placed(10)),
    b"Ordering",
  ).insert(
    span_key(placed(12)),
    b"Int",
  ).insert(
    span_key(placed(22)),
    b"Ordering",
  ).insert(
    span_key(placed(26)),
    compared_name(failure),
  ).insert(
    span_key(placed(27)),
    b"Int",
  );
  let operands = range(0, fields_of.len()).fold(operands, |m: Map<Bytes, Bytes>, k: Int|
    m.insert(span_key(placed(40 + k)), compared_name(fields_of.get(k).ty)));
  let a = var(b"a", 0);
  let b = var(b"b", 1);
  let i = var(b"i", 2);
  let x = var(b"x", 3);
  let next = binary(b"add", i, lit(LInt(1)), 8);
  let length = |c: Code, k: Int|
    call(builtin(if kind == b"Map" { b"Map::len" } else { of.concat(b"len") }, k), [c]);
  let some = |name: Bytes, slot: Int, k: Int|
    PxCtor({ name: b"Some", args: [PxVar({ name: name, slot: Some(slot), span: placed(k) })] });
  let none = PxCtor({ name: b"None", args: [] });
  // An array's item is read by the inline `Array::get`, so no root calls a prelude function the
  // program may not reach.
  let match_at = |list: Code, k: Int, name: Bytes, slot: Int, binder: Int, found: Code, ended: Code|
    if kind == b"Array" {
      at(
        NIf({
          cond: binary(b"lt", i, length(list, k), 27),
          then_branch: at(
            NBlock({
              stmts: [
                CLet({ name: name, slot: slot, value: call(builtin(b"Array::get", k), [list, i]) }),
              ],
              tail: Some(found),
            }),
            dummy_span(),
          ),
          else_branch: ended,
        }),
        dummy_span(),
      )
    } else {
      at(
        NMatch({
          scrutinee: call(builtin(b"List::at", k), [list, i]),
          arms: [
            { pat: some(name, slot, binder), guard: None, body: found },
            { pat: none, guard: None, body: ended },
          ],
        }),
        dummy_span(),
      )
    };
  // The list or array walked, a map's entries for a map.
  let walked_of = |c: Code, k: Int|
    if kind == b"Map" { call(builtin(b"Map::entries", k), [c]) } else { c };
  // What a loop over one container adds to `b` for the item `x`.
  let part = |builtin_name: Bytes, c: Code, k: Int| call(builtin(builtin_name, k), [c]);
  let gathered = |name: Bytes, pushed: (Code) -> Code|
    match_at(a, 3, b"x", 3, 5, call(named(loop_named(name)), [a, pushed(b), next]), b);
  let push = |list: Code, v: Code| call(named(b"List::push"), [list, v]);
  let entry = |builtin_name: Bytes|
    at(
      NRecord({
        fields: [
          {
            name: b"key",
            value: part(builtin_name, at(NField({ base: x, field: b"key" }), dummy_span()), 16),
          },
          {
            name: b"value",
            value: part(builtin_name, at(NField({ base: x, field: b"value" }), dummy_span()), 17),
          },
        ],
      }),
      placed(18),
    );
  let empty = |k: Int| at(NList({ items: [] }), placed(k));
  // `?compare` of the two items, or of their field `name`, and `then` where it answers `Equal`.
  let ordered_then = |name: Bytes, k: Int, slot: Int, eq_at: Int, then: Code| {
    let read = |c: Code|
      if name == b"" { c } else { at(NField({ base: c, field: name }), dummy_span()) };
    let o = b"o".concat(ascii_of_int(slot));
    at(
      NBlock({
        stmts: [
          CLet({
            name: o,
            slot: slot,
            value: call(builtin(b"?compare", k), [read(x), read(var(b"y", 4))]),
          }),
        ],
        tail: Some(
          at(
            NIf({
              cond: binary(b"eq", var(o, slot), named(b"Equal"), eq_at),
              then_branch: then,
              else_branch: var(o, slot),
            }),
            dummy_span(),
          ),
        ),
      }),
      dummy_span(),
    )
  };
  let body = if kind == b"" && op == b"equal" {
    // A record's fields in the order their names sort, each compared at its own type.
    range(0, fields_of.len()).fold(lit(LBool(true)), |acc: Code, k: Int| {
      let f = fields_of.get(k);
      let read = |c: Code| at(NField({ base: c, field: f.name }), dummy_span());
      let eq = binary(b"eq", read(a), read(b), 40 + k);
      if k == 0 { eq } else { at(NBinary({ op: b"and", lhs: acc, rhs: eq }), dummy_span()) }
    })
  } else if kind == b"Result" {
    let arm = |pat: CodePattern, body2: Code| { pat: pat, guard: None, body: body2 };
    let on = |scrutinee: Code, arms: List<CodeArm>|
      at(NMatch({ scrutinee: scrutinee, arms: arms }), dummy_span());
    let one = |ctor: Bytes, slot: Int, k: Int|
      PxCtor({
        name: ctor,
        args: [
          PxVar({ name: if slot == 3 { b"x" } else { b"y" }, slot: Some(slot), span: placed(k) }),
        ],
      });
    let other = |ctor: Bytes| PxCtor({ name: ctor, args: [PxWild] });
    let y = var(b"y", 4);
    if op == b"equal" {
      on(a, [
        arm(
          one(b"Ok", 3, 5),
          on(b, [arm(one(b"Ok", 4, 6), binary(b"eq", x, y, 7)), arm(PxWild, lit(LBool(false)))]),
        ),
        arm(
          one(b"Err", 3, 23),
          on(b, [arm(one(b"Err", 4, 24), binary(b"eq", x, y, 26)), arm(PxWild, lit(LBool(false)))]),
        ),
      ])
    } else {
      on(a, [
        arm(
          one(b"Err", 3, 23),
          on(b, [
            arm(one(b"Err", 4, 24), call(builtin(b"?compare", 25), [x, y])),
            arm(other(b"Ok"), named(b"Less")),
          ]),
        ),
        arm(
          one(b"Ok", 3, 5),
          on(b, [
            arm(one(b"Ok", 4, 6), call(builtin(b"?compare", 9), [x, y])),
            arm(other(b"Err"), named(b"Greater")),
          ]),
        ),
      ])
    }
  } else if kind == b"Option" {
    let arm = |pat: CodePattern, body2: Code| { pat: pat, guard: None, body: body2 };
    let on = |scrutinee: Code, arms: List<CodeArm>|
      at(NMatch({ scrutinee: scrutinee, arms: arms }), dummy_span());
    on(a, [
      arm(none, on(b, [arm(none, named(b"Equal")), arm(PxWild, named(b"Less"))])),
      arm(
        some(b"x", 3, 5),
        on(b, [
          arm(none, named(b"Greater")),
          arm(some(b"y", 4, 6), call(builtin(b"?compare", 9), [x, var(b"y", 4)])),
        ]),
      ),
    ])
  } else if op == b"equal" {
    at(
      NIf({
        cond: binary(b"eq", length(a, 0), length(b, 1), 2),
        then_branch: call(named(loop_named(b"equal_from")), [
          walked_of(a, 0),
          walked_of(b, 1),
          lit(LInt(0)),
        ]),
        else_branch: lit(LBool(false)),
      }),
      dummy_span(),
    )
  } else if op == b"ordered" {
    call(named(loop_named(b"ordered_from")), [walked_of(a, 0), walked_of(b, 1), lit(LInt(0))])
  } else if op == b"equal_from" {
    match_at(
      a,
      3,
      b"x",
      3,
      5,
      match_at(
        b,
        4,
        b"y",
        4,
        6,
        at(
          NIf({
            cond: binary(b"eq", x, var(b"y", 4), 7),
            then_branch: call(named(loop_named(b"equal_from")), [a, b, next]),
            else_branch: lit(LBool(false)),
          }),
          dummy_span(),
        ),
        lit(LBool(false)),
      ),
      lit(LBool(true)),
    )
  } else if op == b"ordered_from" {
    match_at(
      a,
      3,
      b"x",
      3,
      5,
      match_at(
        b,
        4,
        b"y",
        4,
        6,
        // Item by item, a map's entry by its key and then its value.
        if is_entry(item) {
          ordered_then(
            b"key",
            16,
            5,
            10,
            ordered_then(
              b"value",
              17,
              6,
              22,
              call(named(loop_named(b"ordered_from")), [a, b, next]),
            ),
          )
        } else {
          ordered_then(b"", 9, 5, 10, call(named(loop_named(b"ordered_from")), [a, b, next]))
        },
        named(b"Greater"),
      ),
      at(
        NIf({
          cond: binary(b"lt", i, call(builtin(of.concat(b"len"), 13), [b]), 12),
          then_branch: named(b"Less"),
          else_branch: named(b"Equal"),
        }),
        dummy_span(),
      ),
    )
  } else if op == b"reflect_from" || op == b"shown_from" {
    let name = if op == b"reflect_from" { b"?reflect" } else { b"?shown" };
    gathered(op, |out: Code| push(out, part(name, x, 15)))
  } else if op == b"digest_from" { gathered(op, |out: Code| push(out, part(b"?encoded", x, 15))) }
  else if op == b"reflect_entries_from" || op == b"shown_entries_from" {
    let name = if op == b"reflect_entries_from" { b"?reflect" } else { b"?shown" };
    gathered(op, |out: Code| push(out, entry(name)))
  } else if op == b"digest_entries_from" {
    gathered(op, |out: Code|
      push(
        push(out, part(b"?encoded", at(NField({ base: x, field: b"key" }), dummy_span()), 16)),
        part(b"?encoded", at(NField({ base: x, field: b"value" }), dummy_span()), 17),
      ))
  } else if op == b"digest" {
    // The encoding `digest.rs` writes: the container's tag and count, then each item's encoding;
    // a count's eight bytes are an `Int` encoding's past its tag.
    let tag = if kind == b"Map" { 11 } else if kind == b"Array" { 10 } else { 9 };
    let loop_name = if kind == b"Map" { b"digest_entries_from" } else { b"digest_from" };
    call(named(b"?concat"), [
      at(
        NList({
          items: [
            lit(LBytes(byte_of_int(tag))),
            call(named(b"Bytes::slice"), [
              part(b"?encoded", length(a, 0), 21),
              lit(LInt(1)),
              lit(LInt(9)),
            ]),
            call(named(b"?concat"), [
              call(named(loop_named(loop_name)), [walked_of(a, 1), empty(20), lit(LInt(0))]),
            ]),
          ],
        }),
        dummy_span(),
      ),
    ])
  } else {
    // `reflect` or `shown`: the container's constructor of `std.value.Value` over its items'.
    let reflecting = op == b"reflect";
    let made = if kind == b"Map" { b"std.value.VMap" }
    else if kind == b"Array" { b"std.value.VArray" }
    else { b"std.value.VList" };
    let loop_name = if kind == b"Map" {
      if reflecting { b"reflect_entries_from" } else { b"shown_entries_from" }
    } else if reflecting { b"reflect_from" }
    else { b"shown_from" };
    call(named(made), [
      call(named(loop_named(loop_name)), [
        walked_of(a, 1),
        empty(if kind == b"Map" { 19 } else { 14 }),
        lit(LInt(0)),
      ]),
    ])
  };
  { code: marked(body), operands: operands, typed: typed, here: here }
}

/// The name `root`, written in `module`, has there.
fn local_root(module: Bytes, root: Bytes) -> Bytes / {abort.raise} =
  if module.len() == 0 { root } else { root.slice(module.len() + 1, root.len()) }

/// A call of the root written for `op` of containers of type `t`, handed `vals`.
fn container_called(
  emitter: Emitter,
  op: Bytes,
  t: Type,
  vals: List<CValue>,
  at: Span,
) -> WithValue / {abort.raise} = {
  let root = written_root(emitter.module, op, t);
  let d = match container_defs(emitter.module, t).find(|x: Def|
      x.name == local_root(emitter.module, root)) {
    Some(x) -> x,
    None -> panic("a container's root is one of those written for it"),
  };
  let target = call_target(emitter, root, Some(d), at, []);
  let w = range(0, vals.len()).fold(
    { emitter: target.emitter, names: [] },
    |acc: { emitter: Emitter, names: List<Bytes> }, i: Int| {
      let a = carried_arg(
        notail(acc.emitter),
        nth_value(vals, i),
        carrier_at(target.carriers.params, i),
      );
      { emitter: a.emitter, names: acc.names.concat(a.names) }
    },
  );
  called(w.emitter, target, at, w.names, vals.len(), false)
}

/// C's own `double` operators, which round as IEEE-754 does and compare as the evaluator does:
/// `NaN` is unordered and unequal to itself.
fn float_binary(emitter: Emitter, op: Bytes, l: CValue, r: CValue) -> Option<WithValue> = {
  let a = as_float(l);
  let b = as_float(r);
  let infix = |kind: Kind, c: Bytes|
    Some(bind(emitter, kind, Bytes::concat_all([b"(", a, b") ", c, b" (", b, b")"])));
  match compare_op(op) {
    Some(c) -> infix(KBool, c),
    None -> if op == b"add" { infix(KFloat, b"+") }
    else if op == b"sub" { infix(KFloat, b"-") }
    else if op == b"mul" { infix(KFloat, b"*") }
    else if op == b"div" { infix(KFloat, b"/") } else if op == b"rem" {
      Some(
        bind(
          emitter,
          KFloat,
          Bytes::concat_all([
            b"ply_f64(rt_float_rem_p(ctx, ply_f64_bits(",
            a,
            b"), ply_f64_bits(",
            b,
            b")))",
          ]),
        ),
      )
    } else { Some(unsettled_operator(emitter, op)) },
  }
}

/// The runtime's own `Decimal` operators over the two words of each operand, which allocate
/// nothing: arithmetic writes its answer into a local, and a comparison orders the two as numbers,
/// equal at any scale that holds the same one.
fn dec_binary(emitter: Emitter, op: Bytes, l: CValue, r: CValue) -> Option<WithValue> = {
  let a = held_raw(emitter, l, KDec);
  let b = held_raw(a.emitter, r, KDec);
  let x = a.value.expr;
  let y = b.value.expr;
  let words = Bytes::concat_all([x, b".lo, ", x, b".hi, ", y, b".lo, ", y, b".hi"]);
  match compare_op(op) {
    Some(c) ->
      Some(
        bind(
          b.emitter,
          KBool,
          Bytes::concat_all([b"(rt_decimal_compare_p(ctx, ", words, b") ", c, b" 0)"]),
        ),
      ),
    None -> if op == b"add" || op == b"sub" || op == b"mul" || op == b"div" || op == b"rem" {
      let out = fresh(b.emitter);
      let e = line(
        out.emitter,
        Bytes::concat_all([
          b"PlyDec ",
          out.name,
          b"; rt_decimal_binary_p(ctx, ",
          ascii_of_int(binary_code(op)),
          b", ",
          words,
          b", (Word)(intptr_t)&",
          out.name,
          b");",
        ]),
      );
      Some({ emitter: check(e), value: { kind: KDec, expr: out.name, ty: TyOpen([]) } })
    } else { Some(unsettled_operator(b.emitter, op)) },
  }
}

fn int_binary(emitter: Emitter, op: Bytes, l: CValue, r: CValue) -> WithValue =
  if is_shift(op) { shift(emitter, op, l, r, None) } else if is_bitop(op) {
    bind(
      emitter,
      KInt,
      Bytes::concat_all([b"(", as_int(l), b") ", bitop_c(op), b" (", as_int(r), b")"]),
    )
  } else {
    let a = { kind: KInt, expr: as_int(l), ty: TyOpen([]) };
    let bb = { kind: KInt, expr: as_int(r), ty: TyOpen([]) };
    match compare_op(op) {
      Some(c) ->
        bind(emitter, KBool, if op == b"ne" {
          Bytes::concat_all([b"!((", a.expr, b") == (", bb.expr, b"))"])
        } else { Bytes::concat_all([b"(", a.expr, b") ", c, b" (", bb.expr, b")"]) }),
      None -> arithmetic(emitter, op, a, bb),
    }
  }

/// The tag of the constructor `rhs` builds where `==` or `!=` compares a value of a declared sum
/// with it and the sum compares as its constructors do: not an `Option` or a `Result`, held as a
/// word, and not a type whose module states a `key`.
fn compared_ctor(
  emitter: Emitter,
  op: Bytes,
  t: Operand,
  x: CValue,
  rhs: Code,
) -> Option<Int> / {abort.raise} =
  if (op != b"eq" && op != b"ne") || (!is_word_operand(t) && !is_sum_operand(t))
      || x.kind != KBoxed { None } else {
    let named = match rhs.node {
      NApp(a) -> match a.func.node {
        NVar(fv) -> if fv.slot == None && is_ctor_name(fv.name) { Some(fv.name) } else { None },
        _ -> None,
      },
      NVar(v) -> if v.slot == None && is_ctor_name(v.name) { Some(v.name) } else { None },
      _ -> None,
    };
    match named {
      None -> None,
      Some(name) -> match tag_of(emitter, name) {
        None -> None,
        Some(tag) -> if is_option(emitter, tag, b"Some") || is_option(emitter, tag, b"None")
            || is_option(emitter, tag, b"Ok")
            || is_option(emitter, tag, b"Err")
            || (match emitter.ctors.names.at(tag) {
              Some(n) -> emitter.ctors.keyed.contains(n),
              None -> true,
            }) { None }
        else { Some(tag) },
      },
    }
  }

/// Whether `x`, a word of a declared sum, is constructor `tag` of the arguments `vals`, as `==`
/// compares two of them: its tag, then each argument where `x` holds its own, compared as the
/// argument's type compares; the negation for `!=`.
fn ctor_compared(
  emitter: Emitter,
  op: Bytes,
  x: CValue,
  tag: Int,
  vals: List<CValue>,
) -> WithValue / {abort.raise} = {
  let w = bind(emitter, KBoxed, as_word(x));
  let xw = w.value.expr;
  let laid = ctor_fields(w.emitter, tag);
  let eq = fresh(w.emitter);
  let opened = line(
    eq.emitter,
    Bytes::concat_all([
      b"int64_t ",
      eq.name,
      b" = (",
      xw,
      b" != 0 && !ply_is_imm(",
      xw,
      b") && ply_obj(",
      xw,
      b")->kind == 4 && ply_obj(",
      xw,
      b")->layout == ",
      tag_text(w.emitter, tag),
      b" && ply_obj(",
      xw,
      b")->len == ",
      ascii_of_int(ctor_width(w.emitter, tag, vals.len())),
      b");",
    ]),
  );
  let compared = range(0, vals.len()).fold(opened, |acc: Emitter, k: Int| {
    let v = nth_value(vals, k);
    // A constructor laid out as words, a generic one's among them, holds every argument as its word.
    let at = match match laid { Some(fs) -> arg_at(fs, k), None -> None } {
      Some(a) -> a,
      None -> { at: k, kind: KBoxed, ty: TyOpen([]) },
    };
    let held = if raw_slot(at.kind) {
      { kind: at.kind, expr: raw_at(xw, ascii_of_int(at.at), at.kind), ty: TyOpen([]) }
    } else { { kind: KBoxed, expr: field_read(xw, at), ty: at.ty } };
    let inside = indent(line(acc, Bytes::concat_all([b"if (", eq.name, b") {"])));
    // A word held is compared at the argument's own kind, unboxed.
    let compared_at = if laid == None && v.kind != KBoxed && !is_sum(v.kind) { v.kind }
    else { at.kind };
    let c = match at.ty {
      TyRec(inner) -> fields_equal(inside, inner, held, v, None, dummy_span()),
      _ ->
        field_equal(
          inside,
          { name: b"", kind: compared_at, ty: at.ty },
          held,
          v,
          None,
          dummy_span(),
        ),
    };
    line(
      outdent(
        release_at(
          line(c.emitter, Bytes::concat_all([eq.name, b" = ", c.value.expr, b";"])),
          inside.indent,
        ),
      ),
      b"}",
    )
  });
  bind(compared, KBool, if op == b"ne" { Bytes::concat_all([b"!(", eq.name, b")"]) }
  else { eq.name })
}

fn is_sum_operand(t: Operand) -> Bool = match t { OSum(_) -> true, _ -> false }

fn is_word_operand(t: Operand) -> Bool = match t { OWord -> true, OWhole(_) -> true, _ -> false }

/// Whether two values of the type `name` compare as the constructors of a sum the program declares
/// do: not an `Option` or a `Result`, which are held as words, not a type whose module states a
/// `key`, whose values compare as their keys do, and, where no module declares it, one of no
/// constructor's argument, which has no module to write its root in.
fn compared_by_ctors(ctors: Ctors, name: Bytes) -> Bool =
  name != b"Option" && name != b"Result"
    && (match ctors.sums.get(name) {
      Some(cs) ->
        cs.len() > 0 && cs.fold(true, |ok: Bool, c: SumCtor| ok && !ctors.keyed.contains(c.name))
          && (name.index_of(b".") != None || nullary_sum(cs)),
      None -> false,
    })

/// Whether `t` is a sum a module declares generic, at arguments known throughout, which roots
/// written for it at those arguments compare and order as `T#eq` and `T#cmp` do its declared type.
fn generic_sum(ctors: Ctors, t: Type) -> Bool =
  !has_vars(t)
    && (match t {
      TyCon(c) ->
        c.args.len() > 0 && c.name.index_of(b".") != None && compared_by_ctors(ctors, c.name)
          && regular_sum(ctors, c.name),
      _ -> false,
    })

/// Whether the roots written for the declared sum `name` at arguments are finitely many: no chain of
/// sums from one of its parameters back to one holds it at a grown type, as `Nest<a>` holding a
/// `Nest<List<a>>`, or `A<a>` a `B<List<a>>` holding an `A<a>`, does.
fn regular_sum(ctors: Ctors, name: Bytes) -> Bool = {
  let steps = sums_reached(ctors, name).fold([], |acc: List<ParamStep>, s: Bytes|
    acc.concat(param_steps(ctors, s)));
  let from = |p: Bytes| positions_reached(steps, p).push(p);
  let own = steps.fold([], |acc: List<Bytes>, s: ParamStep|
    if s.from.starts_with(name.concat(b"#")) && !acc.contains(s.from) { acc.push(s.from) }
    else { acc });
  steps.all(|s: ParamStep|
    !s.grown || !own.any(|p: Bytes| from(s.to).contains(p) && from(p).contains(s.from)))
}

/// Whether `reflect`, `shown` and `digest` of a value of the sum `c` names are written by a root:
/// the runtime reads one whose roots would be endless.
fn written_sum(ctors: Ctors, c: { name: Bytes, args: List<Type> }) -> Bool =
  ctors.sums.contains(c.name) && (c.args.len() == 0 || regular_sum(ctors, c.name))

/// A sum's parameter, `from`, in a constructor's argument as a sum's argument `to`, or inside it
/// (`grown`); a position is the sum's name and the parameter's index.
type ParamStep = { from: Bytes, to: Bytes, grown: Bool }

/// Every declared sum `name`'s constructors hold, through chains of sums, `name` first.
fn sums_reached(ctors: Ctors, name: Bytes) -> List<Bytes> =
  range(0, ctors.sums.len()).fold(
    { seen: [name], at: 0 },
    |s: { seen: List<Bytes>, at: Int }, _: Int|
      match s.seen.at(s.at) {
        None -> s,
        Some(n) ->
          {
            seen: held_sums(ctors, n).fold(s.seen, |acc: List<Bytes>, o: Bytes|
              if acc.contains(o) { acc } else { acc.push(o) }),
            at: s.at + 1,
          },
      },
  ).seen

fn held_sums(ctors: Ctors, n: Bytes) -> List<Bytes> =
  match ctors.sums.get(n) {
    None -> [],
    Some(cs) ->
      cs.fold([], |acc: List<Bytes>, c: SumCtor|
        c.fields.fold(acc, |a: List<Bytes>, f: Type|
          a.concat(sums_in(ctors, f).map(|o: { name: Bytes, args: List<Type> }| o.name)))),
  }

fn param_steps(ctors: Ctors, s: Bytes) -> List<ParamStep> =
  match ctors.sums.get(s) {
    None -> [],
    Some(cs) ->
      cs.fold([], |acc: List<ParamStep>, c: SumCtor|
        c.fields.fold(acc, |a: List<ParamStep>, f: Type|
          sums_in(ctors, f).fold(a, |b: List<ParamStep>, o: { name: Bytes, args: List<Type> }|
            range(0, o.args.len()).fold(b, |d: List<ParamStep>, j: Int|
              range(0, c.params.len()).fold(d, |e: List<ParamStep>, i: Int|
                match c.params.at(i) {
                  None -> e,
                  Some(p) -> match o.args.at(j) {
                    None -> e,
                    Some(arg) -> {
                      let step = |grown: Bool|
                        e.push({
                          from: s.concat(b"#").concat(ascii_of_int(i)),
                          to: o.name.concat(b"#").concat(ascii_of_int(j)),
                          grown: grown,
                        });
                      if arg == TyVar(p) { step(false) }
                      else if type_vars(arg).contains(p) { step(true) }
                      else { e }
                    },
                  },
                }))))),
  }

/// Each declared sum `t` names, at the arguments it names it at, those inside them included.
fn sums_in(ctors: Ctors, t: Type) -> List<{ name: Bytes, args: List<Type> }> =
  match t {
    TyVar(_) -> [],
    TyCon(k) -> {
      let inner = k.args.fold([], |acc: List<{ name: Bytes, args: List<Type> }>, a: Type|
        acc.concat(sums_in(ctors, a)));
      if ctors.sums.contains(k.name) { inner.push({ name: k.name, args: k.args }) } else { inner }
    },
    TyFn(f) ->
      f.params.fold(
        sums_in(ctors, f.ret),
        |acc: List<{ name: Bytes, args: List<Type> }>, a: Type| acc.concat(sums_in(ctors, a)),
      ),
    TyRecord(fs) ->
      fs.fold([], |acc: List<{ name: Bytes, args: List<Type> }>, f: Field|
        acc.concat(sums_in(ctors, f.ty))),
    TyNominal(x) ->
      x.fields.fold(
        x.args.fold([], |acc: List<{ name: Bytes, args: List<Type> }>, a: Type|
          acc.concat(sums_in(ctors, a))),
        |acc: List<{ name: Bytes, args: List<Type> }>, f: Field| acc.concat(sums_in(ctors, f.ty)),
      ),
  }

/// Every position a chain of one or more steps leads to from `from`: no chain is longer than the steps.
fn positions_reached(steps: List<ParamStep>, from: Bytes) -> List<Bytes> = {
  let next = |n: Bytes| steps.filter(|s: ParamStep| s.from == n).map(|s: ParamStep| s.to);
  range(0, steps.len()).fold(next(from), |seen: List<Bytes>, _: Int|
    seen.fold(seen, |acc: List<Bytes>, n: Bytes|
      next(n).fold(acc, |more: List<Bytes>, m: Bytes|
        if more.contains(m) { more } else { more.push(m) })))
}

/// Whether every constructor of a sum is of no argument, so a value of it is its constructor alone.
fn nullary_sum(cs: List<SumCtor>) -> Bool =
  cs.fold(true, |ok: Bool, c: SumCtor| ok && c.fields.len() == 0)

/// The root that compares two values of the declared sum `t`.
pub fn equality_root(t: Bytes) -> Bytes = t.concat(b"#eq")

/// The root that orders two values of the declared sum `t`.
pub fn ordering_root(t: Bytes) -> Bytes = t.concat(b"#cmp")

/// The type whose values `root` compares, orders or reflects, where it is a root `equality_root`,
/// `ordering_root` or `reflection_root` names: a declared sum by its name, a type reflected as it is
/// spelled.
pub fn derived_of(root: Bytes) -> Option<Bytes> / {abort.raise} =
  if root.len() > 3 && root.slice(root.len() - 3, root.len()) == b"#eq" {
    Some(root.slice(0, root.len() - 3))
  } else if root.len() > 4 && root.slice(root.len() - 4, root.len()) == b"#cmp" {
    Some(root.slice(0, root.len() - 4))
  } else { match written_root_of(root) { Some(r) -> Some(spelled_type(r.ty)), None -> None } }

/// Whether two values of the declared sum `t` are equal: one of no constructor's argument by the
/// constructor its header names, any other as `T#eq` compares them; the negation for `!=`.
fn sum_equal(
  emitter: Emitter,
  op: Bytes,
  l: CValue,
  r: CValue,
  t: Bytes,
) -> WithValue / {abort.raise} =
  if nullary_sum(match emitter.ctors.sums.get(t) { Some(cs) -> cs, None -> [] }) {
    // Each value is its constructor's object, which its header names.
    let a = word_of(emitter, l);
    let b = word_of(a.emitter, r);
    bind(
      b.emitter,
      KBool,
      Bytes::concat_all([
        b"(ply_obj(",
        a.expr,
        b")->layout ",
        if op == b"ne" { b"!=" } else { b"==" },
        b" ply_obj(",
        b.expr,
        b")->layout)",
      ]),
    )
  } else { sum_equal_by_root(emitter, op, l, r, t) }

/// As `sum_equal`, through the root `T#eq`, which takes both words and answers a `Bool`'s.
fn sum_equal_by_root(
  emitter: Emitter,
  op: Bytes,
  l: CValue,
  r: CValue,
  t: Bytes,
) -> WithValue / {abort.raise} = {
  let full = equality_root(t);
  let a = owned(emitter, l);
  let b = owned(a.emitter, r);
  let noted = {
    ..note_call(b.emitter, full),
    generics: {
      ..b.emitter.generics,
      expects: b.emitter.generics.expects.push({ callee: full, head: word_head(2) }),
    },
  };
  let e = bind(
    noted,
    KInt,
    Bytes::concat_all([symbol_of(full), b"(ctx, ", a.value.expr, b", ", b.value.expr, b")"]),
  );
  bind(
    check(e.emitter),
    KBool,
    Bytes::concat_all([
      b"(",
      e.value.expr,
      if op == b"ne" { b" != " } else { b" == " },
      b"ply_true)",
    ]),
  )
}

/// The body of `T#eq` for a sum of constructors `cs`, as lowered code over its two parameters, and the
/// operand types and binder types it files: each constructor's arguments compared in turn where
/// both are that constructor.
fn equality_code(
  cs: List<SumCtor>,
) -> { code: Code, operands: Map<Bytes, Bytes>, typed: Map<Bytes, Typed> } = {
  let at = |node: Node, span: Span| { own: Borrowed, node: node, span: span };
  let placed = |k: Int| { start: 0, end: k, gen: 1 };
  let var = |name: Bytes, slot: Int| at(NVar({ name: name, slot: Some(slot) }), dummy_span());
  let walked = range(0, cs.len()).fold(
    { arms: [], operands: Map::new(), typed: Map::new(), next: 0 },
    |acc: { arms: List<CodeArm>, operands: Map<Bytes, Bytes>, typed: Map<Bytes, Typed>, next: Int }, i: Int| {
      let c = match cs.at(i) {
        Some(x) -> x,
        None -> { name: b"", index: 0, fields: [], params: [] },
      };
      let k = c.fields.len();
      let binder = |side: Int, j: Int|
        {
          name: Bytes::concat_all([if side == 0 { b"x" } else { b"y" }, ascii_of_int(j)]),
          slot: Some(2 + side * k + j),
          span: placed(acc.next + side * k + j),
        };
      let typed = range(0, 2 * k).fold(acc.typed, |m: Map<Bytes, Typed>, n: Int|
        m.insert(
          span_key(placed(acc.next + n)),
          filed_as(match c.fields.at(n % k) { Some(t) -> t, None -> unknown_type() }, []),
        ));
      let compares = range(0, k).map(|j: Int|
        {
          span: placed(acc.next + 2 * k + j),
          ty: match c.fields.at(j) { Some(t) -> t, None -> unknown_type() },
        });
      let operands = compares.fold(
        acc.operands,
        |m: Map<Bytes, Bytes>, x: { span: Span, ty: Type }|
          m.insert(span_key(x.span), compared_name(x.ty)),
      );
      let same = range(0, k).fold(at(NLit(LBool(true)), dummy_span()), |acc2: Code, j: Int| {
        let eq = at(
          NBinary({
            op: b"eq",
            lhs: var(b"x".concat(ascii_of_int(j)), 2 + j),
            rhs: var(b"y".concat(ascii_of_int(j)), 2 + k + j),
          }),
          match compares.at(j) { Some(x) -> x.span, None -> dummy_span() },
        );
        if j == 0 { eq } else { at(NBinary({ op: b"and", lhs: acc2, rhs: eq }), dummy_span()) }
      });
      let inner = at(
        NMatch({
          scrutinee: var(b"b", 1),
          arms: [
            {
              pat: PxCtor({ name: c.name, args: range(0, k).map(|j: Int| PxVar(binder(1, j))) }),
              guard: None,
              body: same,
            },
            { pat: PxWild, guard: None, body: at(NLit(LBool(false)), dummy_span()) },
          ],
        }),
        dummy_span(),
      );
      {
        arms: acc.arms.push({
          pat: PxCtor({ name: c.name, args: range(0, k).map(|j: Int| PxVar(binder(0, j))) }),
          guard: None,
          body: inner,
        }),
        operands: operands,
        typed: typed,
        next: acc.next + 3 * k,
      }
    },
  );
  {
    code: marked(at(NMatch({ scrutinee: var(b"a", 0), arms: walked.arms }), dummy_span())),
    operands: walked.operands,
    typed: walked.typed,
  }
}

/// The body of `T#cmp` for a sum of constructors `cs`, as lowered code over its two parameters, and
/// the operand types and binder and call types it files: as the evaluator orders two constructors'
/// values, by the constructors' names and then by each argument in turn as its type orders.
fn ordering_code(
  cs: List<SumCtor>,
) -> { code: Code, operands: Map<Bytes, Bytes>, typed: Map<Bytes, Typed> } = {
  let at = |node: Node, span: Span| { own: Borrowed, node: node, span: span };
  let placed = |k: Int| { start: 0, end: k, gen: 1 };
  let var = |name: Bytes, slot: Int| at(NVar({ name: name, slot: Some(slot) }), dummy_span());
  let ctor = |name: Bytes| at(NVar({ name: name, slot: None }), dummy_span());
  let rank = |c: SumCtor|
    cs.fold(0, |n: Int, d: SumCtor| if compare(d.name, c.name) == Less { n + 1 } else { n });
  let ranked = |scrutinee: Code|
    at(
      NMatch({
        scrutinee: scrutinee,
        arms: cs.map(|c: SumCtor|
          {
            pat: PxCtor({ name: c.name, args: c.fields.map(|_: Type| PxWild) }),
            guard: None,
            body: at(NLit(LInt(rank(c))), dummy_span()),
          }),
      }),
      dummy_span(),
    );
  let walked = range(0, cs.len()).fold(
    { arms: [], operands: Map::new(), typed: Map::new(), next: 2, slot: 4 },
    |acc: { arms: List<CodeArm>, operands: Map<Bytes, Bytes>, typed: Map<Bytes, Typed>, next: Int, slot: Int }, i: Int| {
      let c = match cs.at(i) {
        Some(x) -> x,
        None -> { name: b"", index: 0, fields: [], params: [] },
      };
      let k = c.fields.len();
      let ty = |j: Int| match c.fields.at(j) { Some(t) -> t, None -> unknown_type() };
      let binder = |side: Int, j: Int|
        {
          name: Bytes::concat_all([if side == 0 { b"x" } else { b"y" }, ascii_of_int(j)]),
          slot: Some(acc.slot + side * k + j),
          span: placed(acc.next + side * k + j),
        };
      // Each binder's type, and each `compare`'s type argument, filed where the emitter reads it.
      let typed = range(0, 3 * k).fold(acc.typed, |m: Map<Bytes, Typed>, n: Int|
        m.insert(span_key(placed(acc.next + n)), if n < 2 * k { filed_as(ty(n % k), []) }
        else { filed_as(unknown_type(), [ty(n - 2 * k)]) }));
      let operands = range(0, k).fold(acc.operands, |m: Map<Bytes, Bytes>, j: Int|
        m.insert(span_key(placed(acc.next + 3 * k + j)), b"Ordering"));
      let compared = |j: Int|
        at(
          NApp({
            func: at(NVar({ name: b"?compare", slot: None }), placed(acc.next + 2 * k + j)),
            args: [
              var(b"x".concat(ascii_of_int(j)), acc.slot + j),
              var(b"y".concat(ascii_of_int(j)), acc.slot + k + j),
            ],
          }),
          dummy_span(),
        );
      // The first argument that orders apart decides, from the last back to the first.
      let lex = range(0, k).fold(ctor(b"Equal"), |later: Code, n: Int| {
        let j = k - 1 - n;
        if j == k - 1 { compared(j) } else {
          let o = b"o".concat(ascii_of_int(j));
          let os = acc.slot + 2 * k + j;
          at(
            NBlock({
              stmts: [CLet({ name: o, slot: os, value: compared(j) })],
              tail: Some(
                at(
                  NIf({
                    cond: at(
                      NBinary({ op: b"eq", lhs: var(o, os), rhs: ctor(b"Equal") }),
                      placed(acc.next + 3 * k + j),
                    ),
                    then_branch: later,
                    else_branch: var(o, os),
                  }),
                  dummy_span(),
                ),
              ),
            }),
            dummy_span(),
          )
        }
      });
      let inner = at(
        NMatch({
          scrutinee: var(b"b", 1),
          arms: [
            {
              pat: PxCtor({ name: c.name, args: range(0, k).map(|j: Int| PxVar(binder(1, j))) }),
              guard: None,
              body: lex,
            },
            { pat: PxWild, guard: None, body: ctor(b"Equal") },
          ],
        }),
        dummy_span(),
      );
      {
        arms: acc.arms.push({
          pat: PxCtor({ name: c.name, args: range(0, k).map(|j: Int| PxVar(binder(0, j))) }),
          guard: None,
          body: inner,
        }),
        operands: operands,
        typed: typed,
        next: acc.next + 4 * k,
        slot: acc.slot + 3 * k,
      }
    },
  );
  let operands = walked.operands.insert(span_key(placed(0)), b"Int").insert(
    span_key(placed(1)),
    b"Int",
  );
  let body = at(
    NIf({
      cond: at(NBinary({ op: b"lt", lhs: var(b"ra", 2), rhs: var(b"rb", 3) }), placed(0)),
      then_branch: ctor(b"Less"),
      else_branch: at(
        NIf({
          cond: at(NBinary({ op: b"gt", lhs: var(b"ra", 2), rhs: var(b"rb", 3) }), placed(1)),
          then_branch: ctor(b"Greater"),
          else_branch: at(NMatch({ scrutinee: var(b"a", 0), arms: walked.arms }), dummy_span()),
        }),
        dummy_span(),
      ),
    }),
    dummy_span(),
  );
  {
    code: marked(
      at(
        NBlock({
          stmts: [
            CLet({ name: b"ra", slot: 2, value: ranked(var(b"a", 0)) }),
            CLet({ name: b"rb", slot: 3, value: ranked(var(b"b", 1)) }),
          ],
          tail: Some(body),
        }),
        dummy_span(),
      ),
    ),
    operands: operands,
    typed: walked.typed,
  }
}

/// What `reflect` or `shown` makes of a value of a type the program fixes, where the program holds
/// `std.value`: a scalar is its constructor of the value, a width below 64 bits its constructor of
/// the bits, and a sum or a record what a root answers. The runtime reads every other value.
type Reflection = | RCtor(Bytes) | RUnit | RWidth({ name: Bytes, width: Width }) | RRoot(Type)

/// How the call of `reflect` or `shown` at `at` reflects its argument, at the type the checker
/// settled it at.
fn reflection_at(emitter: Emitter, at: Span) -> Option<Reflection> =
  if ctor_index(emitter.ctors.names, b"std.value.VUnit", b"") == None { None } else {
    match emitter.typed.get(span_key(at)) {
      None -> None,
      Some(t) -> match t.args.at(0) {
        Some(ty) -> if has_vars(ty) { None } else { reflection_of_type(emitter.ctors, ty) },
        None -> None,
      },
    }
  }

fn reflection_of_type(ctors: Ctors, ty: Type) -> Option<Reflection> =
  match ty {
    TyCon(c) -> if written_sum(ctors, c) || walked_container(ty) { Some(RRoot(ty)) }
    else if ctors.sums.contains(c.name) { None }
    else if c.args.len() > 0 { None }
    else if c.name == b"Int" { Some(RCtor(b"std.value.VInt")) }
    else if c.name == b"Bool" { Some(RCtor(b"std.value.VBool")) }
    else if c.name == b"Float" { Some(RCtor(b"std.value.VFloat")) }
    else if c.name == b"Decimal" { Some(RCtor(b"std.value.VDecimal")) }
    else if c.name == b"Char" { Some(RCtor(b"std.value.VChar")) }
    else if c.name == b"String" { Some(RCtor(b"std.value.VStr")) }
    else if c.name == b"Bytes" { Some(RCtor(b"std.value.VBytes")) }
    else if c.name == b"Unit" { Some(RUnit) } else {
      // A 64-bit width is the runtime's own object, which says what it is.
      match width_named(c.name) {
        Some(w) -> if in_imm(w) { Some(RWidth({ name: c.name, width: w })) } else { None },
        None -> None,
      }
    },
    TyRecord(_) -> Some(RRoot(ty)),
    TyNominal(_) -> Some(RRoot(ty)),
    _ -> None,
  }

/// `reflect(arg)`, or `shown(arg)`, as `r` says.
fn reflected(
  emitter: Emitter,
  shown: Bool,
  r: Reflection,
  args: List<Code>,
  params: List<EmitParam>,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  match args_evaled(emitter, args, params, 0, []) {
    None -> None,
    Some(e0) -> Some(reflection_made(site(e0.emitter, span), shown, r, nth_value(e0.vals, 0))),
  }

/// `v` reflected as `r` says.
fn reflection_made(
  emitter: Emitter,
  shown: Bool,
  r: Reflection,
  v: CValue,
) -> WithValue / {abort.raise} =
  match r {
    RCtor(ctor) -> value_ctor(emitter, ctor, [v]),
    RUnit -> value_ctor(emitter, b"std.value.VUnit", []),
    // A width's bits with nothing above them: a signed one's `Int` cut to its width.
    RWidth(w) -> {
      let int = Bytes::concat_all([b"((int64_t)", as_num(v, w.width), b")"]);
      let bits = if !w.width.signed { int }
      else { Bytes::concat_all([b"(", int, b" & ", int_lit((1 << w.width.bits) - 1), b")"]) };
      let wide = builtin_call(emitter, b"U128::of_int", [
        { kind: KInt, expr: bits, ty: TyOpen([]) },
      ]);
      let name = from_table(wide.emitter, LStr(w.name));
      value_ctor(name.emitter, b"std.value.VFixed", [name.value, wide.value])
    },
    RRoot(ty) -> written_call(emitter, if shown { b"shown" } else { b"reflect" }, ty, v),
  }

/// What the root that writes `op` of a value of `ty` answers for `v`, which it takes.
fn written_call(emitter: Emitter, op: Bytes, ty: Type, v: CValue) -> WithValue / {abort.raise} = {
  let root = written_root(emitter.module, op, ty);
  let taken = Whole(reflected_kind(ty));
  let a = carried_value(emitter, v, taken);
  let noted = {
    ..note_call(a.emitter, root),
    generics: {
      ..a.emitter.generics,
      expects: a.emitter.generics.expects.push({
        callee: root,
        head: { answer: b"Word", params: carried_types(taken) },
      }),
    },
  };
  let e = bind(
    noted,
    KBoxed,
    Bytes::concat_all([symbol_of(root), b"(ctx, ", bytes_join(a.names, b", "), b")"]),
  );
  { emitter: check(e.emitter), value: e.value }
}

/// The constructor `name`, program-wide, of `vals`, which it takes, each held as the constructor
/// holds that argument.
fn value_ctor(emitter: Emitter, name: Bytes, vals: List<CValue>) -> WithValue / {abort.raise} =
  match ctor_index(emitter.ctors.names, name, b"") {
    None -> refused(emitter, b"a constructor not in the table: ".concat(name)),
    Some(tag) -> {
      let laid = ctor_fields(emitter, tag);
      let held = range(0, vals.len()).fold(
        { emitter: emitter, words: [], vals: [] },
        |acc: { emitter: Emitter, words: List<Bytes>, vals: List<CValue> }, i: Int| {
          let kind = match laid { Some(fs) -> nth_field(fs, i).kind, None -> KBoxed };
          let h = held_item({ emitter: acc.emitter, value: nth_value(vals, i) }, kind);
          { emitter: h.emitter, words: acc.words.push(h.word), vals: acc.vals.push(h.val) }
        },
      );
      match laid {
        Some(fs) -> ctor_laid(held.emitter, tag, fs, held.words, held.vals),
        None -> if held.words.len() > 0 { ctor_built(held.emitter, tag, held.words) } else {
          let o = bind(
            held.emitter,
            KBoxed,
            Bytes::concat_all([b"rt_ctor_value_p(ctx, ", tag_text(held.emitter, tag), b")"]),
          );
          { emitter: check(o.emitter), value: o.value }
        },
      }
    },
  }

/// The kind a root written from a type takes a value of `ty` at: the word it crosses a call as, an
/// `Option` its payload's, a `Result` its tagged word, any other its object.
fn reflected_kind(ty: Type) -> Kind =
  match carrier_of(ty) {
    Whole(k) -> if is_sum(k) { k } else { KBoxed },
    Cases(sc) -> KSum(sc.spec),
    Fields(_) -> KBoxed,
  }

/// The root that reflects a value of `ty`, as `reflect` or as `shown` does.
pub fn reflection_root(module: Bytes, shown: Bool, ty: Type) -> Bytes / {abort.raise} =
  written_root(module, if shown { b"shown" } else { b"reflect" }, ty)

/// The root that writes `op` of a value of `ty`: its reflection as `reflect` or `shown` reads it, or
/// the encoding `digest` hashes. A declared sum's is in the module declaring it, which says how it
/// is shown and keyed, and any other type's in `module`.
pub fn written_root(module: Bytes, op: Bytes, ty: Type) -> Bytes / {abort.raise} = {
  let home = match ty {
    TyCon(c) -> {
      let dot = range(0, c.name.len()).fold(0 - 1, |acc: Int, i: Int|
        if c.name.at(i) == 46 { i } else { acc });
      if dot < 0 { module } else { c.name.slice(0, dot) }
    },
    _ -> module,
  };
  qualify(home, Bytes::concat_all([op, b"#", spelled_type(ty)]))
}

/// The module a root `written_root` names is written in, what it writes, and the type it is written
/// for; `None` for any other root.
pub fn written_root_of(
  root: Bytes,
) -> Option<{ module: Bytes, op: Bytes, ty: Type }> / {abort.raise} =
  match root.index_of(b"#") {
    None -> None,
    Some(h) -> {
      let head = root.slice(0, h);
      match [b"reflect", b"shown", b"digest"].concat(container_ops()).fold(
          None,
          |acc: Option<Bytes>, o: Bytes|
            if head == o || head.ends_with(b".".concat(o)) { Some(o) } else { acc },
        ) {
        None -> None,
        Some(op) -> match type_spelled(root.slice(h + 1, root.len())) {
          None -> None,
          Some(ty) ->
            Some({ module: head.slice(0, max(0, head.len() - op.len() - 1)), op: op, ty: ty }),
        },
      }
    },
  }

/// The type the call of `digest` or of `?encoded` at `at` writes an encoding of through a root:
/// a record or a declared sum, which the runtime would read by its shape.
fn encoding_at(emitter: Emitter, at: Span) -> Option<Type> =
  match emitter.typed.get(span_key(at)) {
    None -> None,
    Some(t) -> match t.args.at(0) {
      None -> None,
      Some(ty) -> if has_vars(ty) { None } else {
        match ty {
          TyCon(c) -> if written_sum(emitter.ctors, c) || walked_container(ty) { Some(ty) }
          else { None },
          TyRecord(_) -> Some(ty),
          TyNominal(_) -> Some(ty),
          _ -> None,
        }
      },
    },
  }

/// `n`'s low 64 bits, least significant byte first.
fn le64(n: Int) -> Bytes =
  Bytes::concat_all(range(0, 8).map(|i: Int| byte_of_int(n >> 8 * i & 255)))

/// The body of a root `written_root` names for `digest`, over its parameter `a`, a value of `ty`,
/// and the types it files: the encoding `digest.rs` writes, a record's and a constructor's own
/// bytes written here and each part's encoding at its type. A type whose module states `key` is its
/// key's encoding; one stated generic is read by the runtime.
fn digest_code(
  module: Bytes,
  ctors: Ctors,
  here: List<Def>,
  items: List<Item>,
  ty: Type,
) -> { code: Code, typed: Map<Bytes, Typed> } / {abort.raise} = {
  let at = |node: Node| { own: Borrowed, node: node, span: dummy_span() };
  let placed = |k: Int| { start: 0, end: k, gen: 1 };
  let var = |name: Bytes, slot: Int| at(NVar({ name: name, slot: Some(slot) }));
  let named = |name: Bytes| at(NVar({ name: name, slot: None }));
  let call = |f: Code, args: List<Code>| at(NApp({ func: f, args: args }));
  let written = |b: Bytes| at(NLit(LBytes(b)));
  let counted = |tag: Int, n: Int| byte_of_int(tag).concat(le64(n));
  let blob = |tag: Int, b: Bytes| counted(tag, b.len()).concat(b);
  // `x` encoded at its type: a call the emitter settles by what is filed at `k`.
  let part = |x: Code, k: Int|
    at(
      NApp({
        func: { own: Borrowed, node: NVar({ name: b"?encoded", slot: None }), span: placed(k) },
        args: [x],
      }),
    );
  let parted = |m: Map<Bytes, Typed>, t: Type, k: Int|
    m.insert(span_key(placed(k)), filed_as(unknown_type(), [t]));
  let joined = |parts: List<Code>| call(named(b"?concat"), [at(NList({ items: parts }))]);
  // The runtime's encoding, of a type this root cannot write.
  let read = { code: marked(part(var(b"a", 0), 1)), typed: Map::new() };
  let fields_of = match ty { TyRecord(fs) -> Some(fs), TyNominal(x) -> Some(x.fields), _ -> None };
  match fields_of {
    Some(fs) -> {
      let walked = range(0, fs.len()).fold(
        { parts: [written(counted(12, fs.len()))], typed: Map::new() },
        |acc: { parts: List<Code>, typed: Map<Bytes, Typed> }, i: Int|
          match fs.at(i) {
            None -> acc,
            Some(f) ->
              {
                parts: acc.parts.concat([
                  written(blob(13, f.name)),
                  part(at(NField({ base: var(b"a", 0), field: f.name })), i + 1),
                ]),
                typed: parted(acc.typed, f.ty, i + 1),
              },
          },
      );
      { code: marked(joined(walked.parts)), typed: walked.typed }
    },
    None -> match ty {
      TyCon(c) -> match ctors.sums.get(c.name) {
        None -> read,
        Some(cs) -> {
          let stated = items.fold(None, |acc: Option<Bytes>, item: Item|
            match item {
              IInstance(d) -> if d.kind == NKey && qualify(module, d.target.name) == c.name {
                Some(d.by.name)
              } else { acc },
              _ -> acc,
            });
          let scheme = |f: Bytes|
            here.fold(None, |s: Option<Scheme>, h: Def| if h.name == f { h.scheme } else { s });
          match stated {
            // Values whose keys are equal are equal, so the key is what is written.
            Some(f) -> match scheme(f) {
              Some(s) -> match s.ty {
                TyFn(fn_ty) -> if s.ty_vars.len() > 0 { read } else {
                  {
                    code: marked(
                      joined([written(byte_of_int(16)), part(call(named(f), [var(b"a", 0)]), 1)]),
                    ),
                    typed: parted(Map::new(), fn_ty.ret, 1),
                  }
                },
                _ -> read,
              },
              None -> read,
            },
            None -> {
              let walked = cs.fold(
                { arms: [], typed: Map::new(), next: 1, slot: 1 },
                |acc: { arms: List<CodeArm>, typed: Map<Bytes, Typed>, next: Int, slot: Int }, sc: SumCtor| {
                  let k = sc.fields.len();
                  let arg = |j: Int|
                    at_args(
                      match sc.fields.at(j) { Some(t) -> t, None -> unknown_type() },
                      sc.params,
                      c.args,
                    );
                  let dot = range(0, sc.name.len()).fold(0 - 1, |d: Int, i: Int|
                    if sc.name.at(i) == 46 { i } else { d });
                  let simple = sc.name.slice(dot + 1, sc.name.len());
                  {
                    arms: acc.arms.push({
                      pat: PxCtor({
                        name: sc.name,
                        args: range(0, k).map(|j: Int|
                          PxVar({
                            name: b"x".concat(ascii_of_int(j)),
                            slot: Some(acc.slot + j),
                            span: placed(acc.next + 2 * j),
                          })),
                      }),
                      guard: None,
                      body: joined(
                        [written(blob(14, simple).concat(counted(15, k)))].concat(
                          range(0, k).map(|j: Int|
                            part(
                              var(b"x".concat(ascii_of_int(j)), acc.slot + j),
                              acc.next + 2 * j + 1,
                            )),
                        ),
                      ),
                    }),
                    typed: range(0, k).fold(acc.typed, |m: Map<Bytes, Typed>, j: Int|
                      parted(
                        m.insert(span_key(placed(acc.next + 2 * j)), filed_as(arg(j), [])),
                        arg(j),
                        acc.next + 2 * j + 1,
                      )),
                    next: acc.next + 2 * k,
                    slot: acc.slot + k,
                  }
                },
              );
              {
                code: marked(at(NMatch({ scrutinee: var(b"a", 0), arms: walked.arms }))),
                typed: walked.typed,
              }
            },
          }
        },
      },
      _ -> read,
    },
  }
}

/// The type a declared sum's argument of declared type `ty` is, where the sum is at `args`: each of
/// its parameters' variables `params` read as the argument in its place.
fn at_args(ty: Type, params: List<Int>, args: List<Type>) -> Type =
  match ty {
    TyVar(v) ->
      range(0, params.len()).fold(ty, |acc: Type, i: Int|
        if params.at(i) == Some(v) { match args.at(i) { Some(a) -> a, None -> acc } } else { acc }),
    TyCon(c) -> TyCon({ ..c, args: c.args.map(|a: Type| at_args(a, params, args)) }),
    TyFn(f) ->
      TyFn({
        ..f,
        params: f.params.map(|p: Type| at_args(p, params, args)),
        ret: at_args(f.ret, params, args),
      }),
    TyRecord(fs) -> TyRecord(fs.map(|f: Field| { ..f, ty: at_args(f.ty, params, args) })),
    TyNominal(x) ->
      TyNominal({
        ..x,
        args: x.args.map(|a: Type| at_args(a, params, args)),
        fields: x.fields.map(|f: Field| { ..f, ty: at_args(f.ty, params, args) }),
      }),
  }

/// The body of a root `reflection_root` names, over its parameter `a`, a value of `ty`, and the
/// types it files: a record's fields in their names' order, and a declared sum's constructor's name
/// and arguments, each part reflected at its own type. Under `shown`, a sum whose module states a
/// `show` is what that function writes; one stated generic is read by the runtime.
fn reflection_code(
  module: Bytes,
  ctors: Ctors,
  here: List<Def>,
  items: List<Item>,
  shown: Bool,
  ty: Type,
) -> { code: Code, typed: Map<Bytes, Typed> } = {
  let at = |node: Node| { own: Borrowed, node: node, span: dummy_span() };
  let placed = |k: Int| { start: 0, end: k, gen: 1 };
  let var = |name: Bytes, slot: Int| at(NVar({ name: name, slot: Some(slot) }));
  let named = |name: Bytes| at(NVar({ name: name, slot: None }));
  let call = |f: Code, args: List<Code>| at(NApp({ func: f, args: args }));
  let builtin = if shown { b"?shown" } else { b"?reflect" };
  // `x`, of type `t`, reflected at its type: a call the emitter settles by what is filed at `k`.
  let part = |x: Code, k: Int|
    at(
      NApp({
        func: { own: Borrowed, node: NVar({ name: builtin, slot: None }), span: placed(k) },
        args: [x],
      }),
    );
  let parted = |m: Map<Bytes, Typed>, t: Type, k: Int|
    m.insert(span_key(placed(k)), filed_as(unknown_type(), [t]));
  let fields_of = match ty { TyRecord(fs) -> Some(fs), TyNominal(x) -> Some(x.fields), _ -> None };
  match fields_of {
    Some(fs) -> {
      let field = TyRecord([
        { name: b"name", ty: TyCon({ name: b"String", args: [] }) },
        { name: b"value", ty: TyCon({ name: b"std.value.Value", args: [] }) },
      ]);
      let walked = range(0, fs.len()).fold(
        { items: [], typed: Map::new() },
        |acc: { items: List<Code>, typed: Map<Bytes, Typed> }, i: Int|
          match fs.at(i) {
            None -> acc,
            Some(f) ->
              {
                items: acc.items.push({
                  own: Borrowed,
                  node: NRecord({
                    fields: [
                      { name: b"name", value: at(NLit(LStr(f.name))) },
                      {
                        name: b"value",
                        value: part(at(NField({ base: var(b"a", 0), field: f.name })), 2 * i + 1),
                      },
                    ],
                  }),
                  span: placed(2 * i + 2),
                }),
                typed: parted(acc.typed, f.ty, 2 * i + 1).insert(
                  span_key(placed(2 * i + 2)),
                  filed_as(field, []),
                ),
              },
          },
      );
      {
        code: marked(call(named(b"std.value.VRecord"), [at(NList({ items: walked.items }))])),
        typed: walked.typed,
      }
    },
    None -> match ty {
      TyCon(c) -> match ctors.sums.get(c.name) {
        None -> { code: marked(part(var(b"a", 0), 1)), typed: Map::new() },
        Some(cs) -> {
          let stated = if !shown { None } else {
            items.fold(None, |acc: Option<Bytes>, item: Item|
              match item {
                IInstance(d) -> if d.kind != NKey && qualify(module, d.target.name) == c.name {
                  Some(d.by.name)
                } else { acc },
                _ -> acc,
              })
          };
          let generic = |f: Bytes|
            here.fold(false, |g: Bool, h: Def|
              g
                || (h.name == f
                && (match h.scheme { Some(s) -> s.ty_vars.len() > 0, None -> false })));
          match stated {
            // What the runtime reads, it reads through the function at the type it is called at.
            Some(f) -> if generic(f) { { code: marked(part(var(b"a", 0), 1)), typed: Map::new() } }
            else {
              {
                code: marked(call(named(b"std.value.VShown"), [call(named(f), [var(b"a", 0)])])),
                typed: Map::new(),
              }
            },
            None -> {
              let walked = cs.fold(
                { arms: [], typed: Map::new(), next: 1, slot: 1 },
                |acc: { arms: List<CodeArm>, typed: Map<Bytes, Typed>, next: Int, slot: Int }, sc: SumCtor| {
                  let k = sc.fields.len();
                  let arg = |j: Int|
                    at_args(
                      match sc.fields.at(j) { Some(t) -> t, None -> unknown_type() },
                      sc.params,
                      c.args,
                    );
                  let typed = range(0, k).fold(acc.typed, |m: Map<Bytes, Typed>, j: Int|
                    parted(
                      m.insert(span_key(placed(acc.next + 2 * j)), filed_as(arg(j), [])),
                      arg(j),
                      acc.next + 2 * j + 1,
                    ));
                  {
                    arms: acc.arms.push({
                      pat: PxCtor({
                        name: sc.name,
                        args: range(0, k).map(|j: Int|
                          PxVar({
                            name: b"x".concat(ascii_of_int(j)),
                            slot: Some(acc.slot + j),
                            span: placed(acc.next + 2 * j),
                          })),
                      }),
                      guard: None,
                      body: call(named(b"std.value.VCtor"), [
                        at(NLit(LStr(sc.name))),
                        at(
                          NList({
                            items: range(0, k).map(|j: Int|
                              part(
                                var(b"x".concat(ascii_of_int(j)), acc.slot + j),
                                acc.next + 2 * j + 1,
                              )),
                          }),
                        ),
                      ]),
                    }),
                    typed: typed,
                    next: acc.next + 2 * k,
                    slot: acc.slot + k,
                  }
                },
              );
              {
                code: marked(at(NMatch({ scrutinee: var(b"a", 0), arms: walked.arms }))),
                typed: walked.typed,
              }
            },
          }
        },
      },
      _ -> { code: marked(part(var(b"a", 0), 1)), typed: Map::new() },
    },
  }
}

/// How the checker names a compared value's type to the emitter: a type of no arguments by its
/// name, a function's as a word, and any other spelled.
fn compared_name(t: Type) -> Bytes =
  match t {
    TyCon(c) -> if c.args.len() == 0 { c.name } else { spelled_type(t) },
    TyFn(_) -> b"",
    _ -> spelled_type(t),
  }

/// The operand name of `t`, a type a specialisation settled an operand's variables at, where
/// it is known: `compared_name`, and a variable as the checker names one.
fn operand_spelled(t: Type) -> Option<Bytes> =
  match t {
    TyVar(v) -> if v < 0 { None } else { Some(b"'".concat(ascii_of_int(v))) },
    TyCon(c) -> if c.args.len() == 0 && c.name == b"_" { None } else { Some(compared_name(t)) },
    _ -> Some(compared_name(t)),
  }

/// The fields two records compared are laid out by, where both are known and alike.
fn compared_fields(l: CValue, r: CValue) -> Option<List<FieldTy>> =
  match l.ty {
    TyRec(fs) -> match r.ty {
      TyRec(gs) -> if fs.map(spelled_field) == gs.map(spelled_field) && fs.len() > 0
          && fs.fold(true, |ok: Bool, f: FieldTy| ok && f.kind != KSum(Tagged)) { Some(fs) }
      else { None },
      _ -> None,
    },
    _ -> None,
  }

/// Whether the records `l` and `r` of fields `fs` are equal, as the evaluator says: field by field
/// in the order their names sort, the first unequal one the answer, each compared as its type
/// compares, a record held in place field by field again. A field the runtime compares can raise.
fn records_equal(
  emitter: Emitter,
  fs: List<FieldTy>,
  l: CValue,
  r: CValue,
  whole: Option<Type>,
  at: Span,
) -> WithValue / {abort.raise} = {
  let lv = record_values(emitter, l, fs);
  let rv = record_values(lv.emitter, r, fs);
  let eq = fresh(rv.emitter);
  let opened = line(eq.emitter, Bytes::concat_all([b"int64_t ", eq.name, b" = 1;"]));
  let compared = range(0, fs.len()).fold(opened, |acc: Emitter, k: Int| {
    let f = nth_field(fs, k);
    let a = nth_value(lv.vals, k);
    let b = nth_value(rv.vals, k);
    let inside = indent(line(acc, Bytes::concat_all([b"if (", eq.name, b") {"])));
    let c = match in_place(f) {
      Some(inner) -> fields_equal(inside, inner, a, b, field_type(whole, f.name), at),
      None -> field_equal(inside, f, a, b, field_type(whole, f.name), at),
    };
    line(
      outdent(
        release_at(
          line(c.emitter, Bytes::concat_all([eq.name, b" = ", c.value.expr, b";"])),
          inside.indent,
        ),
      ),
      b"}",
    )
  });
  { emitter: compared, value: { kind: KBool, expr: eq.name, ty: TyOpen([]) } }
}

/// As `records_equal`, a record a record holds in place being compared as its word.
fn fields_equal(
  emitter: Emitter,
  fs: List<FieldTy>,
  l: CValue,
  r: CValue,
  whole: Option<Type>,
  at: Span,
) -> WithValue / {abort.raise} = {
  let lv = record_values(emitter, l, fs);
  let rv = record_values(lv.emitter, r, fs);
  let eq = fresh(rv.emitter);
  let opened = line(eq.emitter, Bytes::concat_all([b"int64_t ", eq.name, b" = 1;"]));
  let compared = range(0, fs.len()).fold(opened, |acc: Emitter, k: Int| {
    let inside = indent(line(acc, Bytes::concat_all([b"if (", eq.name, b") {"])));
    let f = nth_field(fs, k);
    let c = field_equal(
      inside,
      f,
      nth_value(lv.vals, k),
      nth_value(rv.vals, k),
      field_type(whole, f.name),
      at,
    );
    line(
      outdent(
        release_at(
          line(c.emitter, Bytes::concat_all([eq.name, b" = ", c.value.expr, b";"])),
          inside.indent,
        ),
      ),
      b"}",
    )
  });
  { emitter: compared, value: { kind: KBool, expr: eq.name, ty: TyOpen([]) } }
}

/// Whether two values of field `f` are equal, as `records_equal` compares them: a container of
/// type `ply` through the prelude.
fn field_equal(
  emitter: Emitter,
  f: FieldTy,
  a: CValue,
  b: CValue,
  ply: Option<Type>,
  at: Span,
) -> WithValue / {abort.raise} =
  match f.kind {
    KFloat ->
      bind(emitter, KBool, Bytes::concat_all([b"(", as_float(a), b" == ", as_float(b), b")"])),
    KDec -> {
      let x = held_raw(emitter, a, KDec);
      let y = held_raw(x.emitter, b, KDec);
      bind(
        y.emitter,
        KBool,
        Bytes::concat_all([
          b"(rt_decimal_compare_p(ctx, ",
          x.value.expr,
          b".lo, ",
          x.value.expr,
          b".hi, ",
          y.value.expr,
          b".lo, ",
          y.value.expr,
          b".hi) == 0)",
        ]),
      )
    },
    KInt -> bind(emitter, KBool, Bytes::concat_all([b"(", as_int(a), b" == ", as_int(b), b")"])),
    KBool -> bind(emitter, KBool, Bytes::concat_all([b"(", as_bool(a), b" == ", as_bool(b), b")"])),
    KNum(w) ->
      bind(emitter, KBool, Bytes::concat_all([b"(", as_num(a, w), b" == ", as_num(b, w), b")"])),
    // An `Option` as its payload's word: `None` is zero, two `Some`s equal as their payloads are.
    KSum(Zeroed) -> match walked_type(payload_type(ply)) {
      Some(t) -> payloads_equal(emitter, a.expr, b.expr, t, at),
      None -> {
        let e = bind(
          emitter,
          KBool,
          Bytes::concat_all([
            b"((",
            a.expr,
            b" == 0 || ",
            b.expr,
            b" == 0) ? (",
            a.expr,
            b" == ",
            b.expr,
            b") : ",
            payload_compared(a.expr, b.expr, payload_type(ply)),
            b")",
          ]),
        );
        { emitter: check(e.emitter), value: e.value }
      },
    },
    // Byte strings are equal as their bytes are, a container of known type as its type compares,
    // and anything else as the runtime compares its word.
    _ -> if a.ty == TyBytes || b.ty == TyBytes || is_text(ply) {
      bind(emitter, KBool, bytes_equal(as_word(a), as_word(b)))
    } else if walked_type(ply) != None || rooted_record(ply)
        || is_result(ply.unwrap_or(unknown_type())) {
      container_called(
        emitter,
        b"equal",
        match ply { Some(t) -> t, None -> unknown_type() },
        [a, b],
        at,
      )
    } else if declared_sum(emitter, ply) != None {
      sum_equal_by_root(emitter, b"eq", a, b, declared_sum(emitter, ply).unwrap_or(b""))
    } else {
      let x = word_of(emitter, a);
      let y = word_of(x.emitter, b);
      let e = bind(
        y.emitter,
        KBool,
        Bytes::concat_all([b"rt_equal_p(ctx, ", x.expr, b", ", y.expr, b")"]),
      );
      { emitter: check(e.emitter), value: e.value }
    },
  }

/// How `compare` orders two values in C: a type one ordered by its name, a record field by field in
/// the order its names sort, each field of such a type, or a container through the roots written
/// for its type.
type Ordered =
  | ONamed(Bytes)
  | OFields({ fields: List<FieldTy>, names: List<Bytes> })
  | OWalked(Type)

/// How `compare` orders two values of the type the checker settled its reference at `at` at, where
/// C orders them: a number, a character, a string or byte string by its bytes, a sum a module
/// declares, which its `T#cmp` root orders, or a record of such fields.
fn ordered_at(emitter: Emitter, at: Span) -> Option<Ordered> =
  match emitter.typed.get(span_key(at)) {
    Some(t) -> match t.args.at(0) {
      Some(ty) -> match ordered_name(emitter, ty) {
        Some(n) -> Some(ONamed(n)),
        None -> match ty {
          TyRecord(fs) -> fields_ordered(emitter, ty, fs),
          TyNominal(x) -> fields_ordered(emitter, ty, x.fields),
          _ -> if walked_container(ty) || ordered_option(ty) { Some(OWalked(ty)) } else { None },
        },
      },
      None -> None,
    },
    None -> None,
  }

/// Whether `t` is an `Option` of a type known throughout, which a root written for it orders:
/// `None` first, then two `Some`s as their payloads order; or a `Result`, as `is_result` says.
fn ordered_option(t: Type) -> Bool =
  !has_vars(t)
    && (match t {
      TyCon(c) -> (c.name == b"Option" && c.args.len() == 1) || is_result(t),
      _ -> false,
    })

/// Whether `t` is a `Result` known throughout, which roots written for it compare and order: an
/// `Err` before an `Ok`, then two of one constructor as their arguments do.
fn is_result(t: Type) -> Bool =
  !has_vars(t) && (match t { TyCon(c) -> c.name == b"Result" && c.args.len() == 2, _ -> false })

/// Whether `t` is a record known throughout whose fields C orders, as a field of a record it orders.
fn ordered_record(emitter: Emitter, t: Type) -> Bool =
  rooted_record(Some(t)) && ordered_fields_of(emitter, t) != None

/// A record of type `ty`, of fields `fs`, ordered field by field, where each field's type orders by
/// its name or is a container, an `Option`, a `Result` or such a record, named by its spelled type,
/// which the roots written for it order.
fn fields_ordered(emitter: Emitter, ty: Type, fs: List<Field>) -> Option<Ordered> =
  match kind_of(ty).ty {
    TyRec(laid) -> {
      let names = fs.map(|f: Field|
        match ordered_name(emitter, f.ty) {
          Some(n) -> n,
          None -> if walked_container(f.ty) || ordered_option(f.ty)
              || ordered_record(emitter, f.ty) { spelled_type(f.ty) }
          else { b"" },
        });
      if laid.len() == fs.len() && laid.len() > 0 && !names.contains(b"") {
        Some(OFields({ fields: laid, names: names }))
      } else { None }
    },
    _ -> None,
  }

/// The name a type C orders goes by: a number, a character, a string or byte string, or a sum a
/// module declares.
fn ordered_name(emitter: Emitter, ty: Type) -> Option<Bytes> =
  match ty {
    TyCon(c) -> if generic_sum(emitter.ctors, ty) { Some(spelled_type(ty)) }
    else if c.args.len() > 0 { None }
    else if c.name == b"Int" || c.name == b"Char" || c.name == b"Decimal" || c.name == b"String"
        || c.name == b"Bytes"
        || c.name == b"Bool"
        || c.name == b"Unit" { Some(c.name) }
    else if c.name.index_of(b".") != None && compared_by_ctors(emitter.ctors, c.name) {
      Some(c.name)
    } else {
      match width_named(c.name) {
        Some(w) -> if carried(w) { Some(c.name) } else { None },
        None -> None,
      }
    },
    _ -> None,
  }

/// The `Ordering` of `a` and `b`, values of a type `t` says C orders, as the evaluator orders them:
/// a `Decimal` by its value, a string by its bytes, a record field by field; the constructor's own
/// word, which no count holds.
fn compared_order(
  emitter: Emitter,
  t: Option<Ordered>,
  a: CValue,
  b: CValue,
  at: Span,
) -> WithValue / {abort.raise} =
  match t {
    Some(ONamed(n)) -> if n.index_of(b".") != None { sum_ordered(emitter, a, b, n) }
    else { ordering_word(order_of(emitter, n, a, b)) },
    Some(OFields(r)) -> ordering_word(record_order(emitter, r.fields, r.names, a, b)),
    Some(OWalked(t)) -> container_called(emitter, b"ordered", t, [a, b], at),
    None -> refused(emitter, b"an order of a type C does not order"),
  }

/// The constructor of `Ordering` that `o`, below zero, zero or above it, names, as its word.
fn ordering_word(o: { emitter: Emitter, expr: Bytes }) -> WithValue / {abort.raise} = {
  let tag = |ctor: Bytes|
    match tag_of(o.emitter, ctor) { Some(i) -> tag_text(o.emitter, i), None -> b"0" };
  bind(
    o.emitter,
    KBoxed,
    Bytes::concat_all([
      b"rt_ctor_value_p(ctx, ",
      o.expr,
      b" < 0 ? ",
      tag(b"Less"),
      b" : ",
      o.expr,
      b" == 0 ? ",
      tag(b"Equal"),
      b" : ",
      tag(b"Greater"),
      b")",
    ]),
  )
}

/// Below zero, zero or above zero as `a` and `b`, values of the type `name` C orders, order: a sum
/// a module declares as its root answers.
fn order_of(
  emitter: Emitter,
  name: Bytes,
  a: CValue,
  b: CValue,
) -> { emitter: Emitter, expr: Bytes } / {abort.raise} =
  if name.index_of(b".") != None || spells_whole(name) {
    // A container's spelled type orders through its root, a sum's name through `T#cmp`.
    let w = match if spells_whole(name) { type_spelled(name) } else { None } {
      Some(t) -> if walked_container(t) || ordered_option(t) {
        container_called(emitter, b"ordered", t, [a, b], dummy_span())
      } else { sum_ordered(emitter, a, b, name) },
      None -> sum_ordered(emitter, a, b, name),
    };
    let tag = |ctor: Bytes|
      match tag_of(w.emitter, ctor) { Some(i) -> tag_text(w.emitter, i), None -> b"0" };
    let o = bind(
      w.emitter,
      KInt,
      Bytes::concat_all([
        b"(ply_obj(",
        w.value.expr,
        b")->layout == ",
        tag(b"Less"),
        b" ? -1 : ply_obj(",
        w.value.expr,
        b")->layout == ",
        tag(b"Equal"),
        b" ? 0 : 1)",
      ]),
    );
    { emitter: o.emitter, expr: o.value.expr }
  } else if name == b"String" || name == b"Bytes" {
    let x = bind(emitter, KBoxed, as_word(a));
    let y = bind(x.emitter, KBoxed, as_word(b));
    bytes_order(y.emitter, x.value.expr, y.value.expr)
  } else if name == b"Decimal" {
    let x = held_raw(emitter, a, KDec);
    let y = held_raw(x.emitter, b, KDec);
    let c = bind(
      y.emitter,
      KInt,
      Bytes::concat_all([
        b"rt_decimal_compare_p(ctx, ",
        x.value.expr,
        b".lo, ",
        x.value.expr,
        b".hi, ",
        y.value.expr,
        b".lo, ",
        y.value.expr,
        b".hi)",
      ]),
    );
    { emitter: c.emitter, expr: c.value.expr }
  } else if name == b"Char" { signed_order(emitter, as_word(a), as_word(b)) }
  else if name == b"Int" { signed_order(emitter, as_int(a), as_int(b)) }
  else if name == b"Bool" { signed_order(emitter, as_bool(a), as_bool(b)) }
  else if name == b"Unit" { { emitter: emitter, expr: b"0" } } else {
    match width_named(name) {
      Some(w) -> signed_order(emitter, as_num(a, w), as_num(b, w)),
      None -> signed_order(emitter, as_int(a), as_int(b)),
    }
  }

/// The names the fields of the record type `t` order by, where C orders each.
fn ordered_fields_of(emitter: Emitter, t: Type) -> Option<List<Bytes>> =
  match match t {
      TyRecord(fs) -> fields_ordered(emitter, t, fs),
      TyNominal(x) -> fields_ordered(emitter, t, x.fields),
      _ -> None,
    } {
    Some(OFields(r)) -> Some(r.names),
    _ -> None,
  }

/// Below zero, zero or above zero as the records `a` and `b` order: by their fields in the order
/// their names sort, the first that orders them apart deciding; a record held in place in turn.
fn record_order(
  emitter: Emitter,
  fields: List<FieldTy>,
  names: List<Bytes>,
  a: CValue,
  b: CValue,
) -> { emitter: Emitter, expr: Bytes } / {abort.raise} = {
  let lv = record_values(emitter, a, fields);
  let rv = record_values(lv.emitter, b, fields);
  let o = fresh(rv.emitter);
  let opened = line(o.emitter, Bytes::concat_all([b"int64_t ", o.name, b" = 0;"]));
  let ordered = fields.fold(
    { emitter: opened, k: 0 },
    |acc: { emitter: Emitter, k: Int }, field: FieldTy| {
      let k = acc.k;
      let inside = indent(line(acc.emitter, Bytes::concat_all([b"if (", o.name, b" == 0) {"])));
      let name = nth_bytes(names, k);
      let x = nth_value(lv.vals, k);
      let y = nth_value(rv.vals, k);
      // A record held in place is ordered field by field where it is, not through its root.
      let f = match field.ty {
        TyRec(inner) -> match match type_spelled(name) {
            Some(t) -> ordered_fields_of(inside, t),
            None -> None,
          } {
          Some(inner_names) -> record_order(inside, inner, inner_names, x, y),
          None -> order_of(inside, name, x, y),
        },
        _ -> order_of(inside, name, x, y),
      };
      {
        emitter: line(
          outdent(
            release_at(
              line(f.emitter, Bytes::concat_all([o.name, b" = ", f.expr, b";"])),
              inside.indent,
            ),
          ),
          b"}",
        ),
        k: k + 1,
      }
    },
  );
  { emitter: ordered.emitter, expr: o.name }
}

/// The `Ordering` of `l` and `r`, values of the declared sum `t`, as `T#cmp` orders them: the root
/// takes both words and answers the constructor's.
fn sum_ordered(emitter: Emitter, l: CValue, r: CValue, t: Bytes) -> WithValue / {abort.raise} = {
  let full = ordering_root(t);
  let a = owned(emitter, l);
  let b = owned(a.emitter, r);
  let noted = {
    ..note_call(b.emitter, full),
    generics: {
      ..b.emitter.generics,
      expects: b.emitter.generics.expects.push({ callee: full, head: word_head(2) }),
    },
  };
  let e = bind(
    noted,
    KBoxed,
    Bytes::concat_all([symbol_of(full), b"(ctx, ", a.value.expr, b", ", b.value.expr, b")"]),
  );
  { emitter: check(e.emitter), value: e.value }
}

/// A local holding below zero, zero or above zero as `x` and `y`, C values of one ordered type,
/// order.
fn signed_order(emitter: Emitter, x: Bytes, y: Bytes) -> { emitter: Emitter, expr: Bytes } = {
  let o = bind(
    emitter,
    KInt,
    Bytes::concat_all([b"(int64_t)((", x, b") > (", y, b")) - (int64_t)((", x, b") < (", y, b"))"]),
  );
  { emitter: o.emitter, expr: o.value.expr }
}

/// A local holding below zero, zero or above zero as the strings or byte strings `x` and `y`
/// order: by their bytes from the first, and where one begins the other, by their lengths.
fn bytes_order(emitter: Emitter, x: Bytes, y: Bytes) -> { emitter: Emitter, expr: Bytes } = {
  let lx = bind(emitter, KInt, Bytes::concat_all([b"(int64_t)ply_obj(", x, b")->len"]));
  let ly = bind(lx.emitter, KInt, Bytes::concat_all([b"(int64_t)ply_obj(", y, b")->len"]));
  let a = lx.value.expr;
  let b = ly.value.expr;
  let o = bind(
    ly.emitter,
    KInt,
    Bytes::concat_all([
      b"(int64_t)memcmp(ply_bytes(",
      x,
      b"), ply_bytes(",
      y,
      b"), (size_t)(",
      a,
      b" < ",
      b,
      b" ? ",
      a,
      b" : ",
      b,
      b"))",
    ]),
  );
  {
    emitter: line(
      o.emitter,
      Bytes::concat_all([
        b"if (",
        o.value.expr,
        b" == 0) ",
        o.value.expr,
        b" = (",
        a,
        b" > ",
        b,
        b") - (",
        a,
        b" < ",
        b,
        b");",
      ]),
    ),
    expr: o.value.expr,
  }
}

/// Whether the strings or byte strings `x` and `y` hold the same bytes, read where they lie.
fn bytes_equal(x: Bytes, y: Bytes) -> Bytes =
  Bytes::concat_all([
    b"(",
    x,
    b" == ",
    y,
    b" || (ply_obj(",
    x,
    b")->len == ply_obj(",
    y,
    b")->len && memcmp(ply_bytes(",
    x,
    b"), ply_bytes(",
    y,
    b"), ply_obj(",
    x,
    b")->len) == 0))",
  ])

/// Equality is structural, and every other operator is the runtime's own over the words, which a
/// width past 32 bits, a `Float` and a `Decimal` are.
/// `whole` is the type both are of where the checker spelled it, which says how a container a
/// record or an `Option` holds is compared.
fn word_binary(
  emitter: Emitter,
  op: Bytes,
  l: CValue,
  r: CValue,
  whole: Option<Type>,
  at: Span,
) -> Option<WithValue> / {abort.raise} =
  if (op == b"eq" || op == b"ne") && l.kind == KSum(Zeroed) && r.kind == KSum(Zeroed)
      && compared_fields(l, r) != None {
    // Two `Option`s of a record of known layout: `None` is zero, two `Some`s equal as their
    // records are, field by field.
    let lb = if is_local(l.expr) { { emitter: emitter, value: l } }
    else { bind(emitter, l.kind, l.expr) };
    let rb = if is_local(r.expr) { { emitter: lb.emitter, value: r } }
    else { bind(lb.emitter, r.kind, r.expr) };
    let a = lb.value.expr;
    let b = rb.value.expr;
    let eq = fresh(rb.emitter);
    let opened = indent(
      line(
        line(
          eq.emitter,
          Bytes::concat_all([
            b"int64_t ",
            eq.name,
            b" = (",
            a,
            b" == 0 || ",
            b,
            b" == 0) ? (",
            a,
            b" == ",
            b,
            b") : 1;",
          ]),
        ),
        Bytes::concat_all([b"if (", a, b" != 0 && ", b, b" != 0) {"]),
      ),
    );
    let fs = match compared_fields(l, r) { Some(x) -> x, None -> [] };
    let e = records_equal(
      opened,
      fs,
      { kind: KBoxed, expr: a, ty: l.ty },
      { kind: KBoxed, expr: b, ty: r.ty },
      payload_type(whole),
      at,
    );
    let closed = line(
      outdent(
        release_at(
          line(e.emitter, Bytes::concat_all([eq.name, b" = ", e.value.expr, b";"])),
          opened.indent,
        ),
      ),
      b"}",
    );
    Some(
      bind(closed, KBool, if op == b"ne" { Bytes::concat_all([b"!(", eq.name, b")"]) }
      else { eq.name }),
    )
  } else if (op == b"eq" || op == b"ne") && l.kind == KSum(Zeroed) && r.kind == KSum(Zeroed) {
    // Two `Option`s as their payloads' words: `None` is zero, and two `Some`s are equal where their
    // payloads are.
    let lb = if is_local(l.expr) { { emitter: emitter, value: l } }
    else { bind(emitter, l.kind, l.expr) };
    let rb = if is_local(r.expr) { { emitter: lb.emitter, value: r } }
    else { bind(lb.emitter, r.kind, r.expr) };
    let a = lb.value.expr;
    let b = rb.value.expr;
    match walked_type(payload_type(whole)) {
      Some(t) -> {
        let e = payloads_equal(rb.emitter, a, b, t, at);
        Some(if op == b"ne" { not_of(e) } else { e })
      },
      None -> {
        let e = bind(
          rb.emitter,
          KBool,
          Bytes::concat_all([
            b"((",
            a,
            b" == 0 || ",
            b,
            b" == 0) ? (",
            a,
            b" == ",
            b,
            b") : ",
            payload_compared(a, b, payload_type(whole)),
            b")",
          ]),
        );
        Some(
          bind(check(e.emitter), KBool, if op == b"ne" {
            Bytes::concat_all([b"!(", e.value.expr, b")"])
          } else { e.value.expr }),
        )
      },
    }
  } else if (op == b"eq" || op == b"ne") && compared_fields(l, r) != None {
    match compared_fields(l, r) {
      Some(fs) -> {
        let e = records_equal(emitter, fs, l, r, whole, at);
        Some(
          bind(e.emitter, KBool, if op == b"ne" { Bytes::concat_all([b"!(", e.value.expr, b")"]) }
          else { e.value.expr }),
        )
      },
      None -> None,
    }
  } else if op == b"eq" || op == b"ne" {
    // Under release both are handed over as held, and a temporary among them is released at its scope's end.
    let lo = if emitter.release {
      let w = word_of(emitter, l);
      { emitter: w.emitter, value: { kind: KBoxed, expr: w.expr, ty: l.ty } }
    } else { owned(emitter, l) };
    let ro = if lo.emitter.release {
      let w = word_of(lo.emitter, r);
      { emitter: w.emitter, value: { kind: KBoxed, expr: w.expr, ty: r.ty } }
    } else { owned(lo.emitter, r) };
    let e = bind(
      ro.emitter,
      KBool,
      Bytes::concat_all([b"rt_equal_p(ctx, ", lo.value.expr, b", ", ro.value.expr, b")"]),
    );
    // For `!=` the answer's binding is the negation.
    Some(
      bind(check(e.emitter), KBool, if op == b"ne" {
        Bytes::concat_all([b"!(", e.value.expr, b")"])
      } else { e.value.expr }),
    )
  } else {
    let lo = owned(emitter, l);
    let ro = owned(lo.emitter, r);
    let o = bind(
      ro.emitter,
      KBoxed,
      Bytes::concat_all([
        b"rt_binary_p(ctx, ",
        ascii_of_int(binary_code(op)),
        b", ",
        lo.value.expr,
        b", ",
        ro.value.expr,
        b")",
      ]),
    );
    Some({ emitter: check(o.emitter), value: o.value })
  }

/// The six orderings compile to C's own on untagged integers: an `Int` comparison cannot raise.
fn compare_op(op: Bytes) -> Option<Bytes> =
  if op == b"lt" { Some(b"<") }
  else if op == b"le" { Some(b"<=") }
  else if op == b"gt" { Some(b">") }
  else if op == b"ge" { Some(b">=") }
  else if op == b"eq" { Some(b"==") }
  else if op == b"ne" { Some(b"!=") }
  else { None }

/// Addition and subtraction are overflow-checked in the C; the rest go through `rt_arith`, which raises on a zero divisor.
fn arithmetic(emitter: Emitter, op: Bytes, l: CValue, r: CValue) -> WithValue =
  if is_add_or_sub(op) {
    let f = fresh(emitter);
    let e1 = line(f.emitter, Bytes::concat_all([b"int64_t ", f.name, b";"]));
    let e2 = line(
      e1,
      Bytes::concat_all([
        b"if (ply_",
        op,
        b"_ov(",
        l.expr,
        b", ",
        r.expr,
        b", &",
        f.name,
        b")) { rt_overflow_p(ctx, ",
        ascii_of_int(overflow_code(op)),
        b"); ",
        leaving(emitter),
        b" }",
      ]),
    );
    { emitter: e2, value: { kind: KInt, expr: f.name, ty: TyOpen([]) } }
  } else {
    let o = bind(
      emitter,
      KInt,
      Bytes::concat_all([
        b"rt_arith_p(ctx, ",
        ascii_of_int(arith_code(op)),
        b", ",
        l.expr,
        b", ",
        r.expr,
        b")",
      ]),
    );
    { emitter: check(o.emitter), value: o.value }
  }

/// The prologue and the body; a body with a self call in tail position gets the label that call restarts at,
/// where each pass counts one call of the entry's budget, since a restart is what a tail call became.
fn emit_body(
  start: Emitter,
  params: List<EmitParam>,
  body: Code,
) -> Option<WithValue> / {abort.raise} = {
  let prologued = prologue(start, params);
  let loops = loops_to_self(prologued, body, params);
  // A list parameter the loop walks down by its rest is read as its word and an offset.
  let opened = if !loops { prologued } else {
    range(0, params.len()).fold(prologued, |acc: Emitter, i: Int|
      match params.at(i) {
        Some(p) -> if p.carrier == Whole(KBoxed) && p.ty == TyList
            && walks_by_rest(body, own_name(acc), i) { sliced_param(acc, i, p.ty) }
        else { acc },
        None -> acc,
      })
  };
  let looped = line(
    opened,
    b"ply_loop: ".concat(tick_line(failing_return(returned_kind(opened.answer)))),
  );
  expr(if loops { looped } else { opened }, widths_closed(start, body), params)
}

/// The name this root's body calls itself by.
fn own_name(emitter: Emitter) -> Bytes / {abort.raise} = {
  let pre = if emitter.module.len() == 0 { b"" } else { emitter.module.concat(b".") };
  let short = if emitter.owner.starts_with(pre) {
    emitter.owner.slice(pre.len(), emitter.owner.len())
  } else { emitter.owner };
  let cut = range(0, short.len()).fold(short.len(), |acc: Int, k: Int|
    if acc == short.len() && (short.at(k) == 64 || short.at(k) == 35) { k } else { acc });
  short.slice(0, cut)
}

/// Parameter `i`, a list, read as its word `p<i>` from the offset `p<i>_from` on, which a self call
/// handing back its rest moves.
fn sliced_param(emitter: Emitter, i: Int, ty: Ty) -> Emitter = {
  let from = Bytes::concat_all([b"p", ascii_of_int(i), b"_from"]);
  let f = fresh(line(emitter, Bytes::concat_all([b"int64_t ", from, b" = 0;"])));
  remember(note_slice(f.emitter, f.name, b"p".concat(ascii_of_int(i)), from), i, {
    kind: KBoxed,
    expr: f.name,
    ty: ty,
  })
}

/// The offset a self call hands parameter `i` where its argument `x` is a rest of the list the
/// parameter is read from: the loop goes on through the same list.
fn kept_slice(emitter: Emitter, x: Code, i: Int) -> Option<Bytes> =
  match param_local(emitter, i) {
    None -> None,
    Some(pv) -> match slice_of(emitter, pv.expr) {
      None -> None,
      Some(own) -> match x.node {
        NVar(v) -> match v.slot {
          Some(r) -> match conv_of(emitter, r) {
            Some(cv) -> match slice_of(emitter, cv.expr) {
              Some(sl) -> if sl.base == own.base { Some(sl.from) } else { None },
              None -> None,
            },
            None -> None,
          },
          None -> None,
        },
        _ -> None,
      },
    },
  }

/// A call, through the reference at `at`, of the root being emitted that fills every parameter:
/// from tail position it restarts the body. A specialisation's call of its definition at other
/// type arguments is a call of the definition as it stands.
fn self_tail_leaf(
  emitter: Emitter,
  name: Bytes,
  at: Span,
  args: List<Code>,
  params: List<EmitParam>,
) -> Bool / {abort.raise} = {
  let full = qualify(emitter.module, name);
  args.len() == params.len()
    && emitter.here.fold(false, |acc: Bool, h: Def|
      acc || (h.name == name && h.arity == args.len()))
    && (full == emitter.owner
    || (emitter.owner.starts_with(full.concat(b"@"))
    && call_target(emitter, full, def_named(emitter.here, name), at, fn_args(emitter, args)).root
    == emitter.owner))
}

/// Whether a body reaches a self call in tail position; the walk is the positions `tail` is kept into.
fn loops_to_self(emitter: Emitter, code: Code, params: List<EmitParam>) -> Bool / {abort.raise} =
  match code.node {
    NApp(a) -> match a.func.node {
      NVar(fv) ->
        fv.slot == None && !is_ctor_name(fv.name)
          && self_tail_leaf(emitter, fv.name, a.func.span, a.args, params),
      _ -> false,
    },
    NBinary(b) -> (b.op == b"and" || b.op == b"or") && loops_to_self(emitter, b.rhs, params),
    NIf(i) ->
      loops_to_self(emitter, i.then_branch, params)
        || loops_to_self(emitter, i.else_branch, params),
    NBlock(b) -> match b.tail { Some(t) -> loops_to_self(emitter, t, params), None -> false },
    NMatch(m) ->
      m.arms.fold(false, |acc: Bool, a: CodeArm| acc || loops_to_self(emitter, a.body, params)),
    _ -> false,
  }

/// The local the prologue opened parameter `i` into: the first entry for the slot, under any `let` that shadows it.
fn param_local(emitter: Emitter, i: Int) -> Option<CValue> =
  emitter.unboxed.fold(None, |acc: Option<CValue>, unboxed: Unboxed|
    match acc {
      Some(_) -> acc,
      None -> if unboxed.slot == i {
        Some({ kind: unboxed.kind, expr: unboxed.expr, ty: unboxed.ty })
      } else { None },
    })

/// The raw `p<i>` words of the parameters a prologue converted. Those words are dead for the loop --
/// the body reads the converted local -- but they are the call's, so a restart leaves them held.
fn converted_params(emitter: Emitter, params: List<EmitParam>) -> List<Bytes> =
  range(0, params.len()).fold([], |acc: List<Bytes>, i: Int|
    match param_local(emitter, i) {
      Some(_) -> acc.push(b"p".concat(ascii_of_int(i))),
      None -> acc,
    })

/// Each argument in temporaries fitted to its parameter: the opened kind, an owned word the
/// parameter takes over, or a record's fields.
fn tail_args(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  i: Int,
  acc: List<List<Bytes>>,
) -> Option<{ emitter: Emitter, names: List<List<Bytes>> }> / {abort.raise} =
  if i >= codes.len() { Some({ emitter: emitter, names: acc }) } else {
    match codes.at(i) {
      None -> None,
      Some(x) -> match kept_slice(emitter, x, i) {
        // An empty name keeps the parameter's list and moves its offset.
        Some(from) -> {
          let f = bind(emitter, KInt, from);
          tail_args(f.emitter, codes, params, i + 1, acc.push([b"", f.value.expr]))
        },
        None -> match expr(notail(emitter), x, params) {
          None -> None,
          Some(o) -> match match params.at(i) { Some(p) -> p.carrier, None -> Whole(KBoxed) } {
            Fields(fs) -> {
              let held = handed_record(o.emitter, o.value, fs);
              tail_args(held.emitter, codes, params, i + 1, acc.push(held.names))
            },
            Cases(sc) -> {
              let held = handed_sum(o.emitter, o.value, sc);
              tail_args(held.emitter, codes, params, i + 1, acc.push(held.names))
            },
            Whole(KSum(spec)) -> {
              let t = sum_owned(o.emitter, o.value, spec);
              tail_args(t.emitter, codes, params, i + 1, acc.push([t.value.expr]))
            },
            Whole(_) -> {
              let t = match param_local(o.emitter, i) {
                Some(p) -> if slice_of(o.emitter, p.expr) != None { owned(o.emitter, o.value) }
                else { bind(o.emitter, p.kind, as_kind(o.value, p.kind)) },
                None -> owned(o.emitter, o.value),
              };
              tail_args(t.emitter, codes, params, i + 1, acc.push([t.value.expr]))
            },
          },
        },
      },
    }
  }

/// C statements giving each record the record held back as `name`, of fields `fs`, holds in place
/// the word its leaf among `names` from `at` on is.
fn inner_words_set(
  emitter: Emitter,
  name: Bytes,
  fs: List<FieldTy>,
  names: List<Bytes>,
  at: Int,
) -> Emitter =
  match deferred_of(emitter, name) {
    None -> emitter,
    Some(d) -> {
      let slots = inner_word_slots(fs);
      range(0, d.inner.len()).fold(emitter, |acc: Emitter, j: Int|
        match d.inner.at(j) {
          Some(x) ->
            line(
              acc,
              Bytes::concat_all([
                x.name,
                b" = ",
                nth_bytes(names, at + (match slots.at(j) { Some(k) -> k, None -> 0 })),
                b";",
              ]),
            ),
          None -> acc,
        })
    },
  }

/// Where among the leaves of a record of `fs` each record it holds in place has its word.
fn inner_word_slots(fs: List<FieldTy>) -> List<Int> =
  fs.fold({ at: 0, slots: [] }, |acc: { at: Int, slots: List<Int> }, f: FieldTy|
    match in_place(f) {
      Some(inner) -> { at: acc.at + inner.len() + 1, slots: acc.slots.push(acc.at + inner.len()) },
      None -> { ..acc, at: acc.at + 1 },
    }).slots

/// Parameter `i`, a sum of cases `c` held back, given the values `names` a self call hands it.
fn restarted_sum(emitter: Emitter, c: SumCases, i: Int, names: List<Bytes>) -> Emitter = {
  let set = range(0, names.len()).fold(emitter, |acc: Emitter, k: Int|
    line(
      acc,
      Bytes::concat_all([
        if k == 0 { b"p".concat(ascii_of_int(i)) } else { field_param(i, k - 1) },
        b" = ",
        nth_bytes(names, k),
        b";",
      ]),
    ));
  match param_local(set, i) {
    None -> set,
    Some(p) -> match held_sum_of(set, p.expr) {
      None -> set,
      Some(h) -> {
        let words = range(0, c.cases.len()).fold(set, |acc: Emitter, j: Int|
          match nth_case(c, j).arg {
            Some(Fields(fs)) -> match h.args.at(j) {
              Some(Some(v)) ->
                inner_words_set(
                  line(
                    acc,
                    Bytes::concat_all([
                      v.expr,
                      b" = ",
                      nth_bytes(names, 1 + case_start(c, j) + record_leaves(fs).len()),
                      b";",
                    ]),
                  ),
                  v.expr,
                  fs,
                  names,
                  1 + case_start(c, j),
                ),
              _ -> acc,
            },
            _ -> acc,
          });
        line(words, h.name.concat(b" = 0;"))
      },
    },
  }
}

/// A self call in tail position: the parameters take the arguments, what this pass of the body holds is released, and the body restarts.
fn self_tail(
  emitter: Emitter,
  name: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
) -> Option<WithValue> / {abort.raise} =
  match tail_args(emitter, args, params, 0, []) {
    None -> None,
    Some(w) -> {
      let assigned = range(0, params.len()).fold(
        release_at_except(w.emitter, 0, converted_params(w.emitter, params)),
        |acc: Emitter, i: Int|
          match w.names.at(i) {
            None -> acc,
            Some(nm) -> match match params.at(i) { Some(p) -> p.carrier, None -> Whole(KBoxed) } {
              // The record's word, if the pass made one, was released with the pass; the next is
              // the word the new record was handed as.
              Fields(fs) -> {
                let n = record_leaves(fs).len();
                range(0, n).fold(
                  match param_local(acc, i) {
                    Some(p) ->
                      inner_words_set(
                        line(acc, Bytes::concat_all([p.expr, b" = ", nth_bytes(nm, n), b";"])),
                        p.expr,
                        fs,
                        nm,
                        0,
                      ),
                    None -> acc,
                  },
                  |a: Emitter, k: Int|
                    line(a, Bytes::concat_all([field_param(i, k), b" = ", nth_bytes(nm, k), b";"])),
                )
              },
              // The sum's index and values are the parameter's again, each record argument's
              // word its local, and the sum's own word not made.
              Cases(sc) -> restarted_sum(acc, sc, i, nm),
              Whole(_) -> match match param_local(acc, i) {
                  Some(p) -> slice_of(acc, p.expr),
                  None -> None,
                } {
                // A list read from an offset keeps its word where the call hands back its rest,
                // and otherwise lets it go for the new list, read from its start.
                Some(sl) -> if nth_bytes(nm, 0) == b"" {
                  line(acc, Bytes::concat_all([sl.from, b" = ", nth_bytes(nm, 1), b";"]))
                } else {
                  line(
                    acc,
                    Bytes::concat_all([
                      b"ply_dec(ctx, ",
                      sl.base,
                      b"); ",
                      sl.base,
                      b" = ",
                      nth_bytes(nm, 0),
                      b"; ",
                      sl.from,
                      b" = 0;",
                    ]),
                  )
                },
                None ->
                  line(
                    acc,
                    Bytes::concat_all([
                      match param_local(acc, i) {
                        Some(p) -> p.expr,
                        None -> b"p".concat(ascii_of_int(i)),
                      },
                      b" = ",
                      nth_bytes(nm, 0),
                      b";",
                    ]),
                  ),
              },
            },
          },
      );
      let d = ret_of(emitter.here, name);
      Some({
        emitter: line(assigned, b"goto ply_loop;"),
        value: {
          kind: match d.kind { Some(k) -> k, None -> KBoxed },
          expr: zero_of(match d.kind { Some(k) -> k, None -> KBoxed }),
          ty: d.ty,
        },
      })
    },
  }

/// The case a call of `name` with `nargs` arguments jumps to when this body is a group member and so is the callee.
fn group_case(emitter: Emitter, name: Bytes, nargs: Int) -> Option<Int> =
  if emitter.group.len() == 0 { None } else {
    match position_of(emitter.group, qualify(emitter.module, name)) {
      None -> None,
      Some(i) -> if emitter.here.fold(false, |acc: Bool, h: Def|
          acc || (h.name == name && h.arity == nargs)) { Some(i) }
      else { None },
    }
  }

/// The widest arity in this body's group: the group function takes that many words.
fn group_width(emitter: Emitter) -> Int =
  emitter.here.fold(0, |acc: Int, h: Def|
    if h.arity > acc && position_of(emitter.group, qualify(emitter.module, h.name)) != None {
      h.arity
    } else { acc })

/// A call of a group member in tail position: the arguments are duplicated into the group's parameters, what this pass
/// holds is released, and the callee's case restarts through its own prologue. A self call in a group goes this way too.
fn group_tail(
  emitter: Emitter,
  name: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
  which: Int,
) -> Option<WithValue> / {abort.raise} =
  match args_carried(emitter, args, params, [], 0, []) {
    None -> None,
    Some(w) -> {
      let assigned = range(0, w.names.len()).fold(
        release_at(w.emitter, 0),
        |acc: Emitter, i: Int|
          match w.names.at(i) {
            None -> acc,
            Some(nm) -> line(acc, Bytes::concat_all([b"p", ascii_of_int(i), b" = ", nm, b";"])),
          },
      );
      let zeroed = range(w.names.len(), group_width(emitter)).fold(
        assigned,
        |acc: Emitter, i: Int| line(acc, Bytes::concat_all([b"p", ascii_of_int(i), b" = 0;"])),
      );
      let d = ret_of(emitter.here, name);
      Some({
        emitter: line(
          line(zeroed, Bytes::concat_all([b"which = ", ascii_of_int(which), b";"])),
          b"goto ply_loop;",
        ),
        value: {
          kind: match d.kind { Some(k) -> k, None -> KBoxed },
          expr: zero_of(match d.kind { Some(k) -> k, None -> KBoxed }),
          ty: d.ty,
        },
      })
    },
  }

/// Parameter `i`, a sum of cases `c` that arrived as its constructor's index and argument's values,
/// held back as them.
fn sum_param(emitter: Emitter, c: SumCases, i: Int) -> WithValue = {
  let leaves = sum_leaves(c);
  held_sum_from(
    emitter,
    c,
    b"p".concat(ascii_of_int(i)),
    range(0, leaves.len()).map(|k: Int|
      { kind: nth_field(leaves, k).kind, expr: field_param(i, k), ty: nth_field(leaves, k).ty }),
  )
}

/// Every parameter is opened at entry, in order, read or not: opening lazily writes the temporaries in a different order.
fn prologue(emitter: Emitter, params: List<EmitParam>) -> Emitter =
  range(0, params.len()).fold(emitter, |acc: Emitter, i: Int|
    match params.at(i) {
      None -> acc,
      Some(p) -> if raw_carrier(p.carrier) {
        match p.carrier {
          Fields(fs) -> {
            let rl = record_leaves(fs);
            let r = held_record(
              acc,
              fs,
              range(0, rl.len()).map(|k: Int|
                { kind: nth_field(rl, k).kind, expr: field_param(i, k), ty: nth_field(rl, k).ty }),
              word_param(i),
            );
            remember(r.emitter, i, r.value)
          },
          Whole(k) -> remember(acc, i, { kind: k, expr: b"p".concat(ascii_of_int(i)), ty: p.ty }),
          Cases(sc) -> {
            let h = sum_param(acc, sc, i);
            remember(h.emitter, i, { ..h.value, ty: p.ty })
          },
        }
      } else {
        let acc = note_bound(
          note_holder(acc, b"p".concat(ascii_of_int(i))),
          b"p".concat(ascii_of_int(i)),
        );
        match p.kind {
          // A record arrives as its word and is never opened, but its reads are still charged, or the release rule sees nothing read it.
          KBoxed -> charge(acc, i, b"p".concat(ascii_of_int(i))),
          KSum(_) -> charge(acc, i, b"p".concat(ascii_of_int(i))),
          KBool -> {
            let o = bind(acc, KBool, bool_of_word(b"p".concat(ascii_of_int(i))));
            remember(o.emitter, i, o.value)
          },
          KNum(w) -> {
            let o = bind(
              acc,
              KNum(w),
              as_num({ kind: KBoxed, expr: b"p".concat(ascii_of_int(i)), ty: TyOpen([]) }, w),
            );
            remember(o.emitter, i, o.value)
          },
          KFloat -> {
            let o = bind(
              acc,
              KFloat,
              as_float({ kind: KBoxed, expr: b"p".concat(ascii_of_int(i)), ty: TyOpen([]) }),
            );
            remember(o.emitter, i, o.value)
          },
          KDec -> {
            let o = bind(
              acc,
              KDec,
              as_dec({ kind: KBoxed, expr: b"p".concat(ascii_of_int(i)), ty: TyOpen([]) }),
            );
            remember(o.emitter, i, o.value)
          },
          _ -> {
            let o = bind(
              acc,
              KInt,
              Bytes::concat_all([
                b"(ply_is_imm(p",
                ascii_of_int(i),
                b") ? ply_imm_value(p",
                ascii_of_int(i),
                b") : rt_unbox_int_p(ctx, p",
                ascii_of_int(i),
                b"))",
              ]),
            );
            remember(o.emitter, i, o.value)
          },
        }
      },
    })

/// How a value of `ty` is held: an `Int` or a `Bool` untagged, a width below 64 bits in its own C
/// type, a `Float` in a `double`, anything else a word, with what a field read or an inline builtin
/// can take of its type.
pub fn kind_of(ty: Type) -> { kind: Kind, ty: Ty } =
  match ty {
    TyCon(c) -> if c.args.len() == 0 && c.name == b"Int" { { kind: KInt, ty: TyOpen([]) } }
    else if c.args.len() == 0 && c.name == b"Bool" { { kind: KBool, ty: TyOpen([]) } }
    else if c.args.len() == 0 && c.name == b"Float" { { kind: KFloat, ty: TyOpen([]) } }
    else if c.args.len() == 0 && c.name == b"Decimal" { { kind: KDec, ty: TyOpen([]) } }
    else if c.args.len() == 0 && c.name == b"Bytes" { { kind: KBoxed, ty: TyBytes } }
    else if c.args.len() == 1 && c.name == b"List" { { kind: KBoxed, ty: TyList } }
    else if c.args.len() == 1 && c.name == b"Array" {
      {
        kind: KBoxed,
        ty: TyArr(match c.args.at(0) { Some(e) -> laid_field(b"e", e), None -> None }),
      }
    }
    // A width below 64 bits is carried in a register; the wider ones are the runtime's own words.
    else if c.args.len() == 0 {
      match width_named(c.name) {
        Some(w) -> if carried(w) { { kind: KNum(w), ty: TyOpen([]) } } else { boxed() },
        None -> boxed(),
      }
    } else { boxed() },
    // Field order is the checker's, sorted by name. A field of a variable's type may hold any kind's
    // word or bits, and a record it holds in place any width, so such a record is read by name, as
    // the runtime reads it.
    TyRecord(fs) -> if open_fields(fs) { { kind: KBoxed, ty: TyOpen(laid_vars(ty)) } }
    else { { kind: KBoxed, ty: TyRec(fs.map(field_ty)) } },
    // At run time a `new` record is the record it is written as.
    TyNominal(x) -> if open_fields(x.fields) { { kind: KBoxed, ty: TyOpen(laid_vars(ty)) } }
    else { { kind: KBoxed, ty: TyRec(x.fields.map(field_ty)) } },
    TyVar(v) -> { kind: KBoxed, ty: TyOpen(if v >= 0 { [v] } else { [] }) },
    _ -> boxed(),
  }

fn boxed() -> { kind: Kind, ty: Ty } = { kind: KBoxed, ty: TyOpen([]) }

/// Each constructor whose declaration lays out an argument other than as its word: its arguments,
/// `a000` first, each held as a record's field of its declared type is. An argument of a variable's
/// type, or of a record holding one, is its word, so a constructor's layout is its own.
pub fn ctor_layouts(ctors: List<CtorRow>) -> Map<Bytes, List<FieldTy>> =
  ctors.fold(Map::new(), |acc: Map<Bytes, List<FieldTy>>, c: CtorRow| {
    let args = range(0, c.fields.len()).map(|i: Int| {
      let name = Bytes::concat_all([
        b"a",
        ascii_of_int(i / 100),
        ascii_of_int(i / 10 % 10),
        ascii_of_int(i % 10),
      ]);
      match match c.fields.at(i) { Some(t) -> laid_field(name, t), None -> None } {
        Some(f) -> f,
        None -> { name: name, kind: KBoxed, ty: TyOpen([]) },
      }
    });
    if args.fold(false, |laid: Bool, f: FieldTy|
        laid || raw_slot(f.kind) || f.kind == KSum(Zeroed) || in_place(f) != None) {
      acc.insert(c.name, args)
    } else { acc }
  })

/// How a record's field `name` of type `t` is held, wherever the record is made; `None` where that
/// depends on what the field turns out to hold: a variable's type, or a record holding one.
fn laid_field(name: Bytes, t: Type) -> Option<FieldTy> =
  match t {
    TyVar(_) -> None,
    TyRecord(fs) -> if open_fields(fs) { None } else { Some(field_ty({ name: name, ty: t })) },
    TyNominal(x) -> if open_fields(x.fields) { None }
    else { Some(field_ty({ name: name, ty: t })) },
    _ -> Some(field_ty({ name: name, ty: t })),
  }

fn open_fields(fs: List<Field>) -> Bool =
  fs.fold(false, |open: Bool, f: Field|
    open
      || (match f.ty {
        TyVar(_) -> true,
        TyRecord(inner) -> open_fields(inner),
        TyNominal(x) -> open_fields(x.fields),
        _ -> false,
      }))

fn field_ty(f: Field) -> FieldTy = {
  let k = kind_of(f.ty);
  // An `Option` is held as its payload's word, as the runtime holds one it lays out.
  { name: f.name, kind: if is_option_type(f.ty) { KSum(Zeroed) } else { k.kind }, ty: k.ty }
}

/// What a definition's scheme says it takes and answers.
type Sig = { params: List<Type>, ret: Type }

fn sig_of(schemes: Map<Bytes, Scheme>, full: Bytes) -> Option<Sig> =
  match schemes.get(full) {
    Some(s) -> match s.ty { TyFn(f) -> Some({ params: f.params, ret: f.ret }), _ -> None },
    None -> None,
  }

/// How each parameter of `def` arrives: the witnesses the expansion put before what the definition
/// writes are `Int`s, and the rest are as its scheme says. A parameter no scheme speaks for is a word,
/// which every parameter arrives as.
fn param_kinds(def: FnDef, sig: Option<Sig>) -> List<{ kind: Kind, ty: Ty }> = {
  let given = match sig { Some(s) -> s.params, None -> [] };
  let witnesses = def.params.len() - given.len();
  range(0, def.params.len()).map(|i: Int|
    if i < witnesses { { kind: KInt, ty: TyOpen([]) } }
    else { match given.at(i - witnesses) { Some(t) -> kind_of(t), None -> boxed() } })
}

/// The type of each parameter of `def`, as `param_kinds` reads them; none where no scheme speaks.
fn param_types(def: FnDef, sig: Option<Sig>) -> List<Option<Type>> = {
  let given = match sig { Some(s) -> s.params, None -> [] };
  let witnesses = def.params.len() - given.len();
  range(0, def.params.len()).map(|i: Int|
    if i < witnesses { Some(int_type()) } else { given.at(i - witnesses) })
}

/// The type the checker filed at `span`, as a value of it is held; a word where it filed none.
fn typed_kind(typed: Map<Bytes, Typed>, span: Span) -> { kind: Kind, ty: Ty } =
  match typed.get(span_key(span)) { Some(t) -> kind_of(t.ty), None -> boxed() }

/// `value`, what `code` evaluated to, read with the layout its node's type gives it where the value
/// itself carries none: a word of that type, or an `Option`'s payload held as its word.
fn typed_value(emitter: Emitter, code: Code, value: CValue) -> CValue =
  match value.ty {
    TyOpen(_) -> match node_type(emitter, code) {
      None -> value,
      Some(ty) -> match value.kind {
        KBoxed -> laid_as(value, ty),
        KSum(Zeroed) -> match ty {
          TyCon(c) -> if c.name != b"Option" { value }
          else { match c.args.at(0) { Some(payload) -> laid_as(value, payload), None -> value } },
          _ -> value,
        },
        KSum(Tagged) -> if tagged_result(ty) { { ..value, ty: TyOf(ty) } } else { value },
        _ -> value,
      },
    },
    _ -> value,
  }

/// The type of the node `code`, where its place in the source is its alone and its type was
/// rebuilt.
fn node_type(emitter: Emitter, code: Code) -> Option<Type> =
  match emitter.typed.get(span_key(code.span)) {
    Some(t) -> match t.node {
      Some(ty) -> if ty == unknown_type() { None } else { Some(ty) },
      None -> None,
    },
    None -> None,
  }

/// What `code` evaluated to, as `typed_value` reads it.
fn typed(code: Code, made: Option<WithValue>) -> Option<WithValue> =
  match made {
    None -> None,
    Some(o) -> Some({ emitter: o.emitter, value: typed_value(o.emitter, code, o.value) }),
  }

/// `value`, a word, read as a value of `ty` is laid out where `ty` is held as a word and says how.
fn laid_as(value: CValue, ty: Type) -> CValue =
  if kind_of(ty).kind == KBoxed { { ..value, ty: known_or(word_ty(ty), value.ty) } } else { value }

/// What a word of type `ty` is laid out as: what `kind_of` reads of it, and an `Option` or a `Result`
/// as its type, which its constructors' arguments are read by.
fn word_ty(ty: Type) -> Ty =
  match kind_of(ty).ty {
    TyOpen(vs) -> match ty {
      TyCon(c) -> if (c.name == b"Option" && c.args.len() == 1)
          || (c.name == b"Result" && c.args.len() == 2) { TyOf(ty) }
      else { TyOpen(vs) },
      _ -> TyOpen(vs),
    },
    laid -> laid,
  }

/// What the argument of constructor `name` of the sum `subj` is laid out as, held as its word: an
/// `Option` held as its payload's word says that payload's own layout, and a word of a known
/// `Option` or `Result` type its argument's.
fn arg_ty(emitter: Emitter, subj: CValue, name: Bytes) -> Ty =
  if subj.kind == KSum(Zeroed) { subj.ty } else {
    match subj.ty {
      TyOf(of) -> match of {
        TyCon(c) -> {
          let bare = match tag_of(emitter, name) {
            Some(tag) -> match emitter.ctors.names.at(tag) { Some(n) -> n, None -> name },
            None -> name,
          };
          match c.args.at(if c.name == b"Result" && bare == b"Err" { 1 } else { 0 }) {
            Some(t) -> word_ty(t),
            None -> TyOpen([]),
          }
        },
        _ -> TyOpen([]),
      },
      _ -> TyOpen([]),
    }
  }

// --- Specialisation ----------------------------------------------------------------------------
// A generic definition reached with a type argument laid out apart from a word is emitted again for
// the layouts its arguments have, under a root that spells them: the body holds its values as their
// own, reads a record's fields where its layout puts them and does its arithmetic with no witness.

/// The root `full` is emitted under for type arguments laid out as `args` are.
pub fn specialised(full: Bytes, args: List<Type>) -> Bytes =
  Bytes::concat_all([full, b"@", bytes_join(args.map(spelled_type), b",")])

/// `specialised`, and then each lambda the root runs where it calls parameter `param`, as
/// `|param=owner:nth`.
pub fn specialised_with(full: Bytes, args: List<Type>, fns: List<FnArg>) -> Bytes =
  Bytes::concat_all(
    [specialised(full, args)].concat(
      fns.map(|f: FnArg|
        Bytes::concat_all([b"|", ascii_of_int(f.param), b"=", f.owner, b":", ascii_of_int(f.nth)])),
    ),
  )

/// The definition and layouts of the root `specialised` named; `None` for any other root.
pub fn specialisation_of(
  root: Bytes,
) -> Option<{ base: Bytes, args: List<Type>, fns: List<FnArg> }> / {abort.raise} =
  match root.index_of(b"@") {
    None -> None,
    // A lambda's owner may be a test, whose name holds a `#`; a definition's never does.
    Some(at) -> if root.slice(0, at).index_of(b"#") != None { None } else {
      let parts = root.slice(at + 1, root.len()).split(b"|");
      let layouts = match parts.at(0) { Some(x) -> x, None -> b"" };
      let fns = range(1, parts.len()).fold(Some([]), |acc: Option<List<FnArg>>, k: Int|
        match acc {
          None -> None,
          Some(fs) -> match fn_arg_of(match parts.at(k) { Some(x) -> x, None -> b"" }) {
            Some(f) -> Some(fs.push(f)),
            None -> None,
          },
        });
      match fns {
        None -> None,
        Some(fs) -> match if layouts.len() == 0 { Some([]) }
          else { read_types(layouts, 0, [], layouts.len()) } {
          Some(args) -> Some({ base: root.slice(0, at), args: args, fns: fs }),
          None -> None,
        },
      }
    },
  }

/// A lambda `specialised_with` spelled as `param=owner:nth`. The owner is a root's name, whose
/// type arguments may hold a `:`, so the lambda's place is what follows the last one.
fn fn_arg_of(spelled: Bytes) -> Option<FnArg> / {abort.raise} =
  match spelled.index_of(b"=") {
    None -> None,
    Some(eq) -> {
      let colon = range(eq + 1, spelled.len()).fold(0 - 1, |acc: Int, k: Int|
        if spelled.at(k) == 58 { k } else { acc });
      if eq == 0 || colon < 0 || colon + 1 >= spelled.len() { None } else {
        Some({
          param: digits(spelled.slice(0, eq)),
          owner: spelled.slice(eq + 1, colon),
          nth: digits(spelled.slice(colon + 1, spelled.len())),
        })
      }
    },
  }

/// The definition a root runs: its own, or the one it specialises.
pub fn own_definition(root: Bytes) -> Bytes / {abort.raise} =
  match specialisation_of(root) { Some(s) -> s.base, None -> root }

/// What a value's layout reads of its type, every other part a known word, `_`: a scalar, a byte
/// string, an `Option` or a list whatever it holds, an array or columns by its element, a record by
/// its fields, and a variable as itself, for what the type it stands for reads.
pub fn erased(ty: Type) -> Type =
  match ty {
    TyVar(_) -> ty,
    TyCon(c) -> if c.args.len() == 0 && laid_scalar(c.name) { ty }
    else if c.args.len() == 1 && (c.name == b"List" || c.name == b"Option") {
      TyCon({ name: c.name, args: [word_type()] })
    } else if c.args.len() == 1 && (c.name == b"Array" || c.name == b"Columns") {
      TyCon({ name: c.name, args: c.args.map(erased) })
    } else { word_type() },
    TyRecord(fs) -> TyRecord(fs.map(erased_field)),
    TyNominal(x) -> TyRecord(x.fields.map(erased_field)),
    _ -> word_type(),
  }

/// A position a specialisation leaves as its definition has it: a variable no call settles.
fn erased_field(f: Field) -> Field = { name: f.name, ty: erased(f.ty) }

/// A type whose values are words and say nothing more of their layout.
fn word_type() -> Type = TyCon({ name: b"_", args: [] })

fn laid_scalar(name: Bytes) -> Bool =
  name == b"Int" || name == b"Bool" || name == b"Float" || name == b"Decimal" || name == b"Bytes"
    || width_named(name) != None

/// Whether `ty` names a type variable anywhere in it.
pub fn has_vars(ty: Type) -> Bool =
  match ty {
    TyVar(_) -> true,
    TyCon(c) -> c.args.fold(false, |any: Bool, a: Type| any || has_vars(a)),
    TyFn(f) -> f.params.push(f.ret).fold(false, |any: Bool, a: Type| any || has_vars(a)),
    TyRecord(fs) -> fs.fold(false, |any: Bool, f: Field| any || has_vars(f.ty)),
    TyNominal(x) -> x.fields.fold(false, |any: Bool, f: Field| any || has_vars(f.ty)),
  }

/// Whether a specialisation holds a value of `ty` apart from a word, or does its operators in C.
pub fn held_apart(ty: Type) -> Bool =
  match ty {
    TyCon(c) -> c.args.len() == 0 && (kind_of(ty).kind != KBoxed || c.name == b"Char"),
    _ -> false,
  }

/// `ty`, in a definition's numbering, with each variable a specialisation settles read as the layout
/// it is at; one it leaves unknown stays a variable.
fn substituted(ty: Type, args: List<Type>) -> Type =
  match ty {
    TyVar(v) -> match args.at(v) {
      Some(t) -> if t == unknown_type() { ty } else { t },
      None -> ty,
    },
    TyCon(c) -> TyCon({ ..c, args: c.args.map(|a: Type| substituted(a, args)) }),
    TyFn(f) ->
      TyFn({
        ..f,
        params: f.params.map(|p: Type| substituted(p, args)),
        ret: substituted(f.ret, args),
      }),
    TyRecord(fs) -> TyRecord(fs.map(|f: Field| { ..f, ty: substituted(f.ty, args) })),
    TyNominal(x) ->
      TyNominal({
        ..x,
        args: x.args.map(|a: Type| substituted(a, args)),
        fields: x.fields.map(|f: Field| { ..f, ty: substituted(f.ty, args) }),
      }),
  }

/// The numeric type a value of `ty` is held as alone, apart from a word: its own arithmetic.
fn numeric_named(ty: Type) -> Option<Bytes> =
  match ty {
    TyCon(c) -> match kind_of(ty).kind { KBoxed -> None, KBool -> None, _ -> Some(c.name) },
    _ -> None,
  }

fn def_named(defs: List<Def>, name: Bytes) -> Option<Def> =
  defs.fold(None, |acc: Option<Def>, d: Def| if d.name == name { Some(d) } else { acc })

/// What a call names: the root and its symbol, how the root takes each argument and answers, and
/// the answer's type at the call's own type arguments.
type Target = {
  emitter: Emitter,
  full: Bytes,
  symbol: Bytes,
  root: Bytes,
  ret: { kind: Option<Kind>, ty: Ty },
  carriers: { params: List<Carrier>, answer: Carrier },
}

/// The target of a call of `full` through the reference at `at`, named as `named_ref` names it,
/// handed the lambdas `fns`.
fn call_target(
  emitter: Emitter,
  full: Bytes,
  d: Option<Def>,
  at: Span,
  fns: List<FnArg>,
) -> Target / {abort.raise} = {
  let declared = match d {
    Some(x) -> { kind: x.ret, ty: x.ret_ty },
    None -> { kind: None, ty: TyOpen([]) },
  };
  let scheme = match d { Some(x) -> x.scheme, None -> None };
  let named = named_ref(emitter, full, d, at, fns);
  let ret = match scheme {
    Some(sc) -> if sc.ty_vars.len() == 0 { declared } else {
      match emitter.typed.get(span_key(at)) {
        Some(t) -> if t.args.len() != sc.ty_vars.len() { declared } else {
          match sc.ty {
            TyFn(f) -> {
              let k = kind_of(substituted_fully(f.ret, t.args));
              { kind: Some(k.kind), ty: k.ty }
            },
            _ -> declared,
          }
        },
        None -> declared,
      }
    },
    None -> declared,
  };
  {
    emitter: named.emitter,
    full: full,
    symbol: named.symbol,
    root: named.root,
    ret: ret,
    carriers: match d {
      Some(x) -> carriers_at(x, named.args),
      None -> { params: [], answer: Whole(KBoxed) },
    },
  }
}

/// How a reference at `at` names definition `full`: its own symbol, or, for a generic definition the
/// checker gave type arguments there, a placeholder the unit settles once it knows what the callee
/// reads of each argument, which the body records. A definition's reference to itself at the type
/// arguments of the root being emitted, handing the lambdas it runs, names that root; a
/// specialisation's at other arguments or lambdas names the definition as it stands, whose body
/// restarts where a specialisation's cannot become another's.
fn named_ref(
  emitter: Emitter,
  full: Bytes,
  d: Option<Def>,
  at: Span,
  fns: List<FnArg>,
) -> { emitter: Emitter, symbol: Bytes, root: Bytes, args: List<Type> } / {abort.raise} =
  if own_definition(emitter.owner) == full {
    let own = match specialisation_of(emitter.owner) {
      None -> true,
      Some(sp) -> {
        let given = reference_args(emitter, match d { Some(x) -> x.scheme, None -> None }, at);
        same_fns(sp.fns, fns) && given.len() == sp.args.len()
          && range(0, sp.args.len()).fold(true, |same: Bool, j: Int|
            same
              && (match sp.args.at(j) {
                Some(mine) ->
                  mine == unknown_type()
                    || (match given.at(j) {
                      Some(g) -> g == mine || erased(g) == mine,
                      None -> false,
                    }),
                None -> false,
              }))
      },
    };
    let named = if own { emitter.owner } else { full };
    {
      emitter: note_call(emitter, named),
      symbol: symbol_of(named),
      root: named,
      args: match specialisation_of(named) { Some(sp) -> sp.args, None -> [] },
    }
  } else {
    let plain = {
      emitter: note_call(emitter, full),
      symbol: symbol_of(full),
      root: full,
      args: [],
    };
    let scheme = match d { Some(x) -> x.scheme, None -> None };
    let given = reference_args(emitter, scheme, at);
    if given.len() == 0 && fns.len() == 0 { plain } else {
      let k = emitter.generics.calls.len();
      let placeholder = Bytes::concat_all([b"@@g", ascii_of_int(k), b"@@"]);
      {
        emitter: {
          ..emitter,
          generics: {
            ..emitter.generics,
            calls: emitter.generics.calls.push({
              callee: full,
              args: given.map(spelled_type),
              carried: match scheme {
                Some(sc) -> carried_vars(sc, given, match d { Some(x) -> x.arity, None -> 0 }),
                None -> [],
              },
              fns: fns,
            }),
          },
        },
        symbol: placeholder,
        root: placeholder,
        args: given,
      }
    }
  }

/// `ty` with each variable read as the type argument at its number.
fn substituted_fully(ty: Type, args: List<Type>) -> Type =
  match ty {
    TyVar(v) -> match args.at(v) { Some(t) -> t, None -> ty },
    TyCon(c) -> TyCon({ ..c, args: c.args.map(|a: Type| substituted_fully(a, args)) }),
    TyFn(f) ->
      TyFn({
        ..f,
        params: f.params.map(|p: Type| substituted_fully(p, args)),
        ret: substituted_fully(f.ret, args),
      }),
    TyRecord(fs) -> TyRecord(fs.map(|f: Field| { ..f, ty: substituted_fully(f.ty, args) })),
    TyNominal(x) ->
      TyNominal({
        ..x,
        args: x.args.map(|a: Type| substituted_fully(a, args)),
        fields: x.fields.map(|f: Field| { ..f, ty: substituted_fully(f.ty, args) }),
      }),
  }

/// Each typed site of `typed` read at `args`, for a specialisation whose sites are these.
fn typed_at(typed: Map<Bytes, Typed>, args: List<Type>) -> Map<Bytes, Typed> =
  typed.fold(Map::new(), |acc: Map<Bytes, Typed>, k: Bytes, t: Typed|
    acc.insert(k, {
      ..t,
      ty: substituted(t.ty, args),
      args: t.args.map(|a: Type| substituted(a, args)),
    }))

/// The scheme's number of each type parameter `def` writes by name, read off where its parameters'
/// and answer's written types and its scheme's agree.
fn generics_numbered(def: FnDef, scheme: Scheme) -> Map<Bytes, Int> =
  match scheme.ty {
    TyFn(f) -> {
      let written = def.params.map(|p: Param| p.ty);
      let paired = range(0, written.len()).fold(Map::new(), |acc: Map<Bytes, Int>, i: Int|
        match written.at(i) {
          Some(Some(w)) -> match f.params.at(i) { Some(t) -> numbered_by(w, t, acc), None -> acc },
          _ -> acc,
        });
      match def.ret { Some(w) -> numbered_by(w, f.ret, paired), None -> paired }
    },
    _ -> Map::new(),
  }

fn numbered_by(written: TypeExpr, ty: Type, acc: Map<Bytes, Int>) -> Map<Bytes, Int> =
  match written {
    TVar(id) -> match ty { TyVar(v) -> acc.insert(id.name, v), _ -> acc },
    TCon(c) -> match ty {
      TyCon(k) -> pairwise(c.args, k.args, acc),
      TyNominal(x) -> pairwise(c.args, x.args, acc),
      _ -> acc,
    },
    TFn(w) -> match ty {
      TyFn(f) -> numbered_by(w.ret, f.ret, pairwise(w.params, f.params, acc)),
      _ -> acc,
    },
    _ -> acc,
  }

fn pairwise(written: List<TypeExpr>, tys: List<Type>, acc: Map<Bytes, Int>) -> Map<Bytes, Int> =
  if written.len() != tys.len() { acc } else {
    range(0, written.len()).fold(acc, |m: Map<Bytes, Int>, i: Int|
      match written.at(i) {
        Some(w) -> match tys.at(i) { Some(t) -> numbered_by(w, t, m), None -> m },
        None -> m,
      })
  }

/// The root names `wanted` holds of `full`'s specialisations, each with the layouts it is at.
fn specialisations_wanted(
  wanted: Option<Map<Bytes, Bool>>,
  full: Bytes,
) -> List<{ args: List<Type>, fns: List<FnArg> }> / {abort.raise} =
  match wanted {
    None -> [],
    Some(w) ->
      w.fold([], |acc: List<{ args: List<Type>, fns: List<FnArg> }>, root: Bytes, _: Bool|
        match specialisation_of(root) {
          Some(s) -> if s.base == full { acc.push({ args: s.args, fns: s.fns }) } else { acc },
          None -> acc,
        }),
  }

/// `e`, the body of generic `def`, noting the variables whose numeric witness it reads: a scalar
/// argument does that arithmetic in C.
fn witnessed_needs(
  e: Emitted,
  def: FnDef,
  scheme: Option<Scheme>,
  ops: List<WitnessOp>,
) -> Emitted =
  match scheme {
    None -> e,
    Some(sc) -> {
      let numbering = generics_numbered(def, sc);
      let needs = ops.fold(e.tables.generics.needs, |acc: List<Need>, o: WitnessOp|
        if o.owner != e.name { acc } else {
          match numbering.get(o.param) {
            Some(v) -> if acc.contains({ var: v, reads: Scalar }) { acc }
            else { acc.push({ var: v, reads: Scalar }) },
            None -> acc,
          }
        });
      { ..e, tables: { ..e.tables, generics: { ..e.tables.generics, needs: needs } } }
    },
  }

/// What a root of `def`, named `full`, at `args` reads its definition as: the body with each
/// operator whose witness is a parameter held as one numeric type alone done as that type's own,
/// the operand sites the checker filed at the definition's variables read at the types `args`
/// give them, and the signature at `args`.
fn definition_at(
  full: Bytes,
  def: FnDef,
  args: List<Type>,
  schemes: Map<Bytes, Scheme>,
  ops: List<WitnessOp>,
  operands: Map<Bytes, Bytes>,
) -> { body: Expr, operands: Map<Bytes, Bytes>, sig: Option<Sig> } / {abort.raise} = {
  let scheme = schemes.get(full);
  let numbering = match scheme { Some(sc) -> generics_numbered(def, sc), None -> Map::new() };
  // The type a witnessed parameter is at, where its argument is held as one numeric type alone.
  let numeric = |param: Bytes|
    match numbering.get(param) {
      Some(i) -> match args.at(i) { Some(t) -> numeric_named(t), None -> None },
      None -> None,
    };
  let concrete = numbering.fold(Map::new(), |acc: Map<Bytes, Bool>, param: Bytes, _: Int|
    if numeric(param) == None { acc } else { acc.insert(witness_param(param), true) });
  // An operand the checker filed at a variable of the definition is read as the type it is at.
  let at_args = operands.fold(operands, |acc: Map<Bytes, Bytes>, k: Bytes, name: Bytes|
    if name.index_of(b"'") == None { acc } else {
      match type_spelled(name) {
        Some(t) -> match operand_spelled(substituted(t, args)) {
          Some(n) -> acc.insert(k, n),
          None -> acc,
        },
        None -> acc,
      }
    });
  {
    body: map_expr(def.body, |e: Expr| unwitnessed(e, |w: Bytes| concrete.contains(w))),
    operands: ops.fold(at_args, |acc: Map<Bytes, Bytes>, o: WitnessOp|
      if o.owner != full { acc }
      else { match numeric(o.param) { Some(n) -> acc.insert(span_key(o.span), n), None -> acc } }),
    sig: match sig_of(schemes, full) {
      Some(s) ->
        Some({
          params: s.params.map(|t: Type| substituted(t, args)),
          ret: substituted(s.ret, args),
        }),
      None -> None,
    },
  }
}

/// `def` emitted at `args`: its parameters and sites read at them, and each operator whose witness
/// is a parameter now held as one numeric type alone done as that type's own.
fn specialised_emitted(
  module: Bytes,
  def: FnDef,
  args: List<Type>,
  fns: List<FnArg>,
  lambda_at: (Bytes, Int) -> Option<BoundLambda> / {abort.raise},
  schemes: Map<Bytes, Scheme>,
  ops: List<WitnessOp>,
  sites: Map<Bytes, List<Bytes>>,
  here: List<Def>,
  imports: List<Imported>,
  ctors: Ctors,
  builtins: List<Bytes>,
  effects: List<EffectName>,
  release: Bool,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
) -> Emitted / {abort.raise} = {
  let full = qualify(module, def.name.name);
  let source = definition_at(full, def, args, schemes, ops, operands);
  let body = source.body;
  let settled = source.operands;
  let sig = source.sig;
  let names = def.params.map(|param: Param| param.name.name);
  let kinds = param_kinds(def, sig).map(|k: { kind: Kind, ty: Ty }| Some(k));
  let labels = def.generics.labels.map(|ident: Ident| ident.name);
  let all_names = labels.fold(names, |acc: List<Bytes>, n: Bytes| acc.push(n));
  let all_kinds = labels.fold(kinds, |acc: List<Option<{ kind: Kind, ty: Ty }>>, n: Bytes|
    acc.push(Some({ kind: KInt, ty: TyOpen([]) })));
  let root = specialised_with(full, args, fns);
  let carried = params_carried(
    all_names,
    all_kinds,
    match def_named(here, def.name.name) {
      Some(d) -> carriers_at(d, args).params,
      None -> carriers_of(def, sig_of(schemes, full)).params,
    },
    param_types(def, sig),
  );
  // Each lambda the root runs, read where its owner lowered it.
  let lent = fns.fold(Some(carried), |acc: Option<List<EmitParam>>, f: FnArg|
    match acc {
      None -> None,
      Some(ps) -> match lambda_at(f.owner, f.nth) {
        None -> None,
        Some(bl) ->
          Some(
            range(0, ps.len()).map(|i: Int|
              if i == f.param { { ..ps.get(i), lambda: Some(bl) } } else { ps.get(i) }),
          ),
      },
    });
  match lent {
    None ->
      {
        name: root,
        text: b"",
        tables: no_tables(),
        why: Some(b"a lambda this root runs in place of a call is not one its owner lowers"),
        handles: [],
      },
    Some(ps) ->
      emitted_from(
        module,
        def.span.start,
        here,
        imports,
        ctors,
        builtins,
        effects,
        release,
        settled,
        typed_at(typed, args),
        root,
        ps,
        true,
        body,
        match lower_to_emit(names, labels, sites, body, of_binder(module)) {
          Some(l) -> Some(l.code),
          None -> None,
        },
      ),
  }
}

pub fn emit_fn(
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  ctors: List<Bytes>,
  builtins: List<Bytes>,
  full: Bytes,
  params: List<EmitParam>,
  body: Code,
) -> Option<Bytes> / {abort.raise} =
  match emit_fn_full(
      module,
      0,
      here,
      imports,
      { names: ctors, laid: Map::new(), keyed: [], sums: Map::new() },
      builtins,
      full,
      params,
      body,
      [],
      false,
      Map::new(),
      Map::new(),
    ) {
    None -> None,
    Some(f) -> Some(f.text),
  }

/// One definition's C, with the tables it names. `full` is the definition's own name (`m.f`, or a
/// root's `m.f#requires#0`), from which its C symbol is derived.
pub fn emit_fn_full(
  module: Bytes,
  base: Int,
  here: List<Def>,
  imports: List<Imported>,
  ctors: Ctors,
  builtins: List<Bytes>,
  full: Bytes,
  params: List<EmitParam>,
  body: Code,
  effects: List<EffectName>,
  release: Bool,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
) -> Option<{ text: Bytes, tables: Tables }> / {abort.raise} = {
  let name = symbol_of(full);
  let answer = carried_answer(module, here, full);
  let start = {
    out: [],
    temp_count: 0,
    unboxed: [],
    indent: 0,
    reads: slots_read(body),
    shapes: [],
    built: [],
    module: module,
    base: base,
    count_locals: [],
    here: here,
    imports: imports,
    consts: [],
    ctors: ctors,
    lambda_bodies: b"",
    lambdas: [],
    owner: full,
    builtins: builtins,
    called_builtins: [],
    fields: [],
    released: [],
    reuse_widths: [],
    alias: [],
    by_root: [],
    tail: true,
    calls: [],
    generics: no_generics(),
    refused: None,
    deferred: [],
    deferred_locals: [],
    performs: [],
    handles: [],
    landing: None,
    effects: effects,
    release: release,
    pinned: [],
    bound: [],
    group: [],
    operands: operands,
    typed: node_types(typed, params.map(|p: EmitParam| p.of), body),
    answer: answer,
    site_root: None,
    lent: lent_of(params),
    written: written_in(module, here, imports, body),
    slices: [],
    sums: [],
    leaves: answers_cases(answer),
  };
  match emit_body(start, params, body) {
    None -> None,
    Some(o0) -> if o0.emitter.refused != None { None } else {
      let sig = Bytes::concat_all([
        b"Word ",
        name,
        b"_entry(PlyCtx *ctx, const Word *args);\n",
        head_text(name, params, answer),
        b" {\n",
      ]);
      let grown = grown_words(o0.emitter, params, answer);
      let head = fuel_head(name.concat(b"_entry"), grown.prep, grown.words, answer);
      let w = answered(grown.emitter, o0.value, answer);
      let shaped = answer_shapes(w.emitter, answer);
      let o = { emitter: shaped.emitter, value: o0.value };
      let epilogue = Bytes::concat_all([
        toks_freed(o.emitter.reuse_widths),
        b"  ctx->fuel += 1;\n  return ",
        w.expr,
        b";\n}\n",
      ]);
      let entry = entry_from(name, [], 0, params, answer, shaped.shapes);
      // Token declarations go in front once the body has used them; they take no temporary, so nothing moves.
      let toks = sorted_widths(o.emitter.reuse_widths).fold(b"", |acc: Bytes, w: Int|
        Bytes::concat_all([acc, b"  Word tok", ascii_of_int(w), b" = 0;\n"]));
      let decls = o.emitter.deferred_locals.fold(b"", |acc: Bytes, r: Bytes|
        Bytes::concat_all([acc, b"  Word ", r, b" = 0;\n"]));
      Some({
        text: Bytes::concat_all([
          sig,
          head,
          toks,
          decls,
          bytes_join(o.emitter.out, b""),
          epilogue,
          entry,
          o.emitter.lambda_bodies,
        ]),
        tables: tables_of(o.emitter, full, [head_of(params, answer)]),
      })
    },
  }
}

/// What a root hands back as `answer` carries it: the word, the value in its own C type, or a
/// record's first field, its others written through the pointers; whatever the body holds is
/// released first.
fn answered(emitter: Emitter, value: CValue, answer: Carrier) -> { emitter: Emitter, expr: Bytes } =
  match answer {
    Whole(KBoxed) -> returned(emitter, value),
    Whole(KSum(spec)) -> {
      let w = sum_owned(emitter, value, spec);
      { emitter: release_at(w.emitter, 0), expr: w.value.expr }
    },
    Whole(k) -> {
      let b = bind(emitter, k, as_kind(value, k));
      { emitter: release_at(b.emitter, 0), expr: b.value.expr }
    },
    Fields(fs) -> {
      // A record never made is made in the cells of one this body let go, where it has them, so
      // the caller is handed a word to keep rather than making one.
      let bound = handed_record(made(emitter, value.expr, false, false), value, fs);
      let written = range(1, bound.names.len()).fold(bound.emitter, |acc: Emitter, k: Int|
        line(
          acc,
          Bytes::concat_all([b"*o", ascii_of_int(k), b" = ", nth_bytes(bound.names, k), b";"]),
        ));
      { emitter: release_at(written, 0), expr: nth_bytes(bound.names, 0) }
    },
    Cases(sc) -> {
      let h = handed_sum(emitter, value, sc);
      let written = range(1, h.names.len()).fold(h.emitter, |acc: Emitter, k: Int|
        line(
          acc,
          Bytes::concat_all([b"*o", ascii_of_int(k), b" = ", nth_bytes(h.names, k), b";"]),
        ));
      { emitter: release_at(written, 0), expr: nth_bytes(h.names, 0) }
    },
  }

/// Whether a body answering as `c` hands back a sum as its constructor and argument.
fn answers_cases(c: Carrier) -> Bool = match c { Cases(_) -> true, _ -> false }

/// The C type a value carried as `k` crosses a call in.
fn carried_type(k: Kind) -> Bytes = match k { KBoxed -> b"Word", _ -> ctype(k) }

/// A root's C function head: its answer's and each carried value's C type, then the pointers a
/// record answer is written through.
fn head_text(name: Bytes, params: List<EmitParam>, answer: Carrier) -> Bytes = {
  let h = head_of(params, answer);
  let names = carried_names(params, answer);
  Bytes::concat_all([
    h.answer,
    b" ",
    name,
    b"(PlyCtx *ctx",
    range(0, h.params.len()).fold(b"", |acc: Bytes, i: Int|
      Bytes::concat_all([acc, b", ", nth_bytes(h.params, i), b" ", nth_bytes(names, i)])),
    b")",
  ])
}

/// What a growth of the stack re-enters a root with: each parameter as a word, its own or one made
/// of a carried value, which `prep` makes first.
fn grown_words(
  emitter: Emitter,
  params: List<EmitParam>,
  answer: Carrier,
) -> { emitter: Emitter, prep: Bytes, words: List<Bytes> } =
  range(0, params.len()).fold(
    { emitter: emitter, prep: b"", words: [] },
    |acc: { emitter: Emitter, prep: Bytes, words: List<Bytes> }, i: Int|
      match params.at(i) {
        None -> acc,
        Some(p) -> match p.carrier {
          Whole(KSum(spec)) ->
            {
              ..acc,
              words: acc.words.push(
                Bytes::concat_all([sum_helper(spec, b"take"), b"(ctx, p", ascii_of_int(i), b")"]),
              ),
            },
          Whole(k) ->
            {
              ..acc,
              words: acc.words.push(
                as_word({ kind: k, expr: b"p".concat(ascii_of_int(i)), ty: TyOpen([]) }),
              ),
            },
          Fields(fs) -> {
            let sh = record_shapes(acc.emitter, fs);
            let name = b"ply_g".concat(ascii_of_int(i));
            let rl = record_leaves(fs);
            {
              emitter: sh.emitter,
              prep: Bytes::concat_all([
                acc.prep,
                record_word_lines(
                  name,
                  word_param(i),
                  fs,
                  sh.shapes,
                  range(0, rl.len()).map(|k: Int|
                    {
                      kind: nth_field(rl, k).kind,
                      expr: field_param(i, k),
                      ty: nth_field(rl, k).ty,
                    }),
                  failing_return(returned_kind(answer)),
                ),
                b" ",
              ]),
              words: acc.words.push(name),
            }
          },
          Cases(sc) -> {
            let shaped = case_shapes(acc.emitter, sc);
            let name = b"ply_g".concat(ascii_of_int(i));
            {
              emitter: shaped.emitter,
              prep: Bytes::concat_all([
                acc.prep,
                sum_word_lines(
                  name,
                  sc,
                  b"p".concat(ascii_of_int(i)),
                  range(0, sum_leaves(sc).len()).map(|k: Int|
                    {
                      kind: nth_field(sum_leaves(sc), k).kind,
                      expr: field_param(i, k),
                      ty: TyOpen([]),
                    }),
                  shaped.shapes,
                  failing_return(returned_kind(answer)),
                ),
                b" ",
              ]),
              words: acc.words.push(
                Bytes::concat_all([sum_helper(sc.spec, b"take"), b"(ctx, ", name, b")"]),
              ),
            }
          },
        },
      },
  )

/// The entry the runtime and closures call a function by, words in and out: `held` are handed first
/// as they are, then each carried argument from `args[first]` is opened, a record's fields loaded
/// and its word handed on with them; a carried answer is boxed, a record's its word, or one made of
/// `shape`.
fn entry_from(
  name: Bytes,
  held: List<Bytes>,
  first: Int,
  params: List<EmitParam>,
  answer: Carrier,
  shapes: List<List<Int>>,
) -> Bytes = {
  let opened = range(0, params.len()).fold(
    { text: b"", args: held },
    |acc: { text: Bytes, args: List<Bytes> }, i: Int| {
      let arg = Bytes::concat_all([b"args[", ascii_of_int(first + i), b"]"]);
      match params.at(i) {
        None -> acc,
        Some(p) -> match p.carrier {
          Whole(KBoxed) -> { ..acc, args: acc.args.push(arg) },
          // The argument's object is taken, its payload handed on.
          Whole(KSum(spec)) -> {
            let local = b"a".concat(ascii_of_int(i));
            {
              text: Bytes::concat_all([
                acc.text,
                b"  ",
                ctype(KSum(spec)),
                b" ",
                local,
                b" = ",
                sum_helper(spec, b"open"),
                b"(ctx, ",
                arg,
                b");\n",
              ]),
              args: acc.args.push(local),
            }
          },
          Whole(k) -> {
            let local = b"a".concat(ascii_of_int(i));
            {
              text: Bytes::concat_all([
                acc.text,
                b"  ",
                ctype(k),
                b" ",
                local,
                b" = ",
                as_kind({ kind: KBoxed, expr: arg, ty: TyOpen([]) }, k),
                b"; ply_dec(ctx, ",
                arg,
                b");\n",
              ]),
              args: acc.args.push(local),
            }
          },
          // The argument's object is opened into its constructor's index and argument's values.
          Cases(sc) -> {
            let tag = b"a".concat(ascii_of_int(i));
            let leaves = range(0, sum_leaves(sc).len()).map(|k: Int|
              Bytes::concat_all([b"a", ascii_of_int(i), b"_", ascii_of_int(k)]));
            let word = Bytes::concat_all([b"a", ascii_of_int(i), b"_s"]);
            {
              text: Bytes::concat_all([
                acc.text,
                b"  ",
                ctype(KSum(sc.spec)),
                b" ",
                word,
                b" = ",
                sum_helper(sc.spec, b"open"),
                b"(ctx, ",
                arg,
                b"); int64_t ",
                tag,
                b" = 0;",
                range(0, leaves.len()).fold(b"", |t: Bytes, k: Int|
                  Bytes::concat_all([
                    t,
                    b" ",
                    carried_type(nth_field(sum_leaves(sc), k).kind),
                    b" ",
                    nth_bytes(leaves, k),
                    b" = ",
                    zero_of(nth_field(sum_leaves(sc), k).kind),
                    b";",
                  ])),
                b"\n  ",
                sum_opening(sc, word, tag, leaves),
                b"\n",
              ]),
              args: acc.args.push(tag).concat(leaves),
            }
          },
          Fields(fs) -> {
            let loads = leaf_loads(arg, fs);
            let locals = range(0, loads.len()).map(|k: Int|
              Bytes::concat_all([b"a", ascii_of_int(i), b"_", ascii_of_int(k)]));
            {
              text: Bytes::concat_all([
                acc.text,
                range(0, loads.len()).fold(b"", |t: Bytes, k: Int|
                  Bytes::concat_all([
                    t,
                    b"  ",
                    ctype(nth_value(loads, k).kind),
                    b" ",
                    nth_bytes(locals, k),
                    b" = ",
                    nth_value(loads, k).expr,
                    b";\n",
                  ])),
                b"  ",
                counted_incs(
                  range(0, loads.len()).map(|k: Int|
                    { ..nth_value(loads, k), expr: nth_bytes(locals, k) }),
                ),
                b"\n",
              ]),
              args: acc.args.concat(locals).push(arg),
            }
          },
        },
      }
    },
  );
  let back = written_back(answer);
  let outs = range(1, back.len() + 1).map(|k: Int| b"r".concat(ascii_of_int(k)));
  let call = Bytes::concat_all([
    name,
    b"(ctx",
    opened.args.fold(b"", |acc: Bytes, a: Bytes| Bytes::concat_all([acc, b", ", a])),
    outs.fold(b"", |acc: Bytes, o: Bytes| Bytes::concat_all([acc, b", &", o])),
    b")",
  ]);
  Bytes::concat_all([
    b"Word ",
    name,
    b"_entry(PlyCtx *ctx, const Word *args) {\n",
    opened.text,
    match answer {
      Whole(KBoxed) -> Bytes::concat_all([b"  return ", call, b";\n"]),
      Whole(k) ->
        Bytes::concat_all([
          b"  ",
          ctype(k),
          b" r = ",
          call,
          b";\n  if (ctx->failed) return 0;\n  return ",
          match k {
            KSum(spec) -> sum_helper(spec, b"take").concat(b"(ctx, r)"),
            _ -> as_word({ kind: k, expr: b"r", ty: TyOpen([]) }),
          },
          b";\n",
        ]),
      Cases(sc) ->
        Bytes::concat_all([
          range(0, back.len()).fold(b"", |t: Bytes, k: Int|
            Bytes::concat_all([
              t,
              b"  ",
              carried_type(nth_field(back, k).kind),
              b" ",
              nth_bytes(outs, k),
              b" = ",
              zero_of(nth_field(back, k).kind),
              b";\n",
            ])),
          b"  int64_t r0 = ",
          call,
          b";\n  if (ctx->failed) return 0;\n  ",
          sum_word_lines(
            b"rw",
            sc,
            b"r0",
            range(0, back.len()).map(|k: Int|
              { kind: nth_field(back, k).kind, expr: nth_bytes(outs, k), ty: TyOpen([]) }),
            shapes,
            b"return 0;",
          ),
          b"\n  return ",
          sum_helper(sc.spec, b"take"),
          b"(ctx, rw);\n",
        ]),
      Fields(fs) ->
        Bytes::concat_all([
          range(0, back.len()).fold(b"", |t: Bytes, k: Int|
            Bytes::concat_all([
              t,
              b"  ",
              ctype(nth_field(back, k).kind),
              b" ",
              nth_bytes(outs, k),
              b";\n",
            ])),
          b"  ",
          ctype(returned_kind(answer)),
          b" r0 = ",
          call,
          b";\n  if (ctx->failed) return 0;\n  ",
          record_word_lines(
            b"rw",
            nth_bytes(outs, back.len() - 1),
            fs,
            match shapes.at(0) { Some(sh) -> sh, None -> [] },
            range(0, record_leaves(fs).len()).map(|k: Int|
              {
                kind: nth_field(record_leaves(fs), k).kind,
                expr: b"r".concat(ascii_of_int(k)),
                ty: nth_field(record_leaves(fs), k).ty,
              }),
            b"return 0;",
          ),
          b"\n  return rw;\n",
        ]),
    },
    b"}\n",
  ])
}

/// How the root `full` of `module` hands back its answer: as its definition's `Def` says, and a word
/// for any other root.
fn carried_answer(module: Bytes, here: List<Def>, full: Bytes) -> Carrier / {abort.raise} = {
  let own = own_definition(full);
  let args = match specialisation_of(full) { Some(sp) -> sp.args, None -> [] };
  here.fold(Whole(KBoxed), |acc: Carrier, d: Def|
    if qualify(module, d.name) == own { carriers_at(d, args).answer } else { acc })
}

/// Why a body was refused, or nothing when it was emitted.
pub fn emit_fn_why(
  module: Bytes,
  base: Int,
  here: List<Def>,
  imports: List<Imported>,
  ctors: Ctors,
  builtins: List<Bytes>,
  full: Bytes,
  params: List<EmitParam>,
  body: Code,
  effects: List<EffectName>,
  release: Bool,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
) -> Option<Bytes> / {abort.raise} = {
  let answer = carried_answer(module, here, full);
  let start = {
    out: [],
    temp_count: 0,
    unboxed: [],
    indent: 0,
    reads: slots_read(body),
    shapes: [],
    built: [],
    module: module,
    base: base,
    count_locals: [],
    here: here,
    imports: imports,
    consts: [],
    ctors: ctors,
    lambda_bodies: b"",
    lambdas: [],
    owner: full,
    builtins: builtins,
    called_builtins: [],
    fields: [],
    released: [],
    reuse_widths: [],
    alias: [],
    by_root: [],
    tail: true,
    calls: [],
    generics: no_generics(),
    refused: None,
    deferred: [],
    deferred_locals: [],
    performs: [],
    handles: [],
    landing: None,
    effects: effects,
    release: release,
    pinned: [],
    bound: [],
    group: [],
    operands: operands,
    typed: node_types(typed, params.map(|p: EmitParam| p.of), body),
    answer: answer,
    site_root: None,
    lent: lent_of(params),
    written: written_in(module, here, imports, body),
    slices: [],
    sums: [],
    leaves: answers_cases(answer),
  };
  match emit_body(start, params, body) {
    None -> Some(b"refused without a reason"),
    Some(o) -> o.emitter.refused,
  }
}

/// One definition of a group: its full name, where its source starts, and its lowered body.
pub type Member = { full: Bytes, base: Int, params: List<EmitParam>, body: Code }

/// A tail-recursive group as one C function: `which` picks the member's case, the loop label sits before the switch, and
/// each case opens its own parameters, so a jump to any member restarts through that member's prologue. Every member's
/// own symbol is a wrapper passing its case, and the group's tables list the members its one body serves.
pub fn emit_group_full(
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  ctors: Ctors,
  builtins: List<Bytes>,
  members: List<Member>,
  effects: List<EffectName>,
  release: Bool,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
) -> Option<{ text: Bytes, tables: Tables }> / {abort.raise} = {
  let names = members.map(|m: Member| m.full);
  let first = match members.at(0) { Some(m) -> m.full, None -> b"" };
  let gname = symbol_of(first).concat(b"_group");
  let width = members.fold(0, |acc: Int, m: Member|
    if m.params.len() > acc { m.params.len() } else { acc });
  let start: Emitter = {
    out: [],
    temp_count: 0,
    unboxed: [],
    indent: 0,
    reads: [],
    shapes: [],
    built: [],
    module: module,
    base: 0,
    count_locals: [],
    here: here,
    imports: imports,
    consts: [],
    ctors: ctors,
    lambda_bodies: b"",
    lambdas: [],
    owner: first,
    builtins: builtins,
    called_builtins: [],
    fields: [],
    released: [],
    reuse_widths: [],
    alias: [],
    by_root: [],
    tail: true,
    calls: [],
    generics: no_generics(),
    refused: None,
    deferred: [],
    deferred_locals: [],
    performs: [],
    handles: [],
    landing: None,
    effects: effects,
    release: release,
    pinned: [],
    bound: [],
    group: names,
    operands: operands,
    typed: members.fold(typed, |acc: Map<Bytes, Typed>, m: Member|
      node_types(acc, m.params.map(|p: EmitParam| p.of), m.body)),
    answer: Whole(KBoxed),
    site_root: None,
    lent: [],
    written: [],
    slices: [],
    sums: [],
    leaves: false,
  };
  match group_cases(start, members, 0) {
    None -> None,
    Some(emitter) -> if emitter.refused != None { None } else {
      let gentry = gname.concat(b"_entry");
      let sig = Bytes::concat_all([
        b"static Word ",
        gentry,
        b"(PlyCtx *ctx, const Word *args);\n",
        b"static Word ",
        gname,
        b"(PlyCtx *ctx, int which",
        range(0, width).fold(b"", |acc: Bytes, i: Int|
          Bytes::concat_all([acc, b", Word p", ascii_of_int(i)])),
        b") {\n",
      ]);
      let toks = sorted_widths(emitter.reuse_widths).fold(b"", |acc: Bytes, w: Int|
        Bytes::concat_all([acc, b"  Word tok", ascii_of_int(w), b" = 0;\n"]));
      let decls = emitter.deferred_locals.fold(b"", |acc: Bytes, r: Bytes|
        Bytes::concat_all([acc, b"  Word ", r, b" = 0;\n"]));
      let entered = Bytes::concat_all([
        b"static Word ",
        gentry,
        b"(PlyCtx *ctx, const Word *args) {\n  return ",
        gname,
        b"(ctx, (int)args[0]",
        range(0, width).fold(b"", |acc: Bytes, i: Int|
          Bytes::concat_all([acc, b", args[", ascii_of_int(i + 1), b"]"])),
        b");\n}\n",
      ]);
      let wrappers = range(0, members.len()).fold(
        { emitter: emitter, text: b"" },
        |acc: { emitter: Emitter, text: Bytes }, i: Int|
          match members.at(i) {
            Some(m) -> {
              let w = group_wrapper(
                acc.emitter,
                gname,
                i,
                m,
                width,
                carried_answer(module, here, m.full),
              );
              { emitter: w.emitter, text: acc.text.concat(w.text) }
            },
            None -> acc,
          },
      );
      Some({
        text: Bytes::concat_all([
          sig,
          fuel_head(gentry, b"", group_args(width), Whole(KBoxed)),
          toks,
          decls,
          b"  ply_loop: ",
          tick_line(failing_return(KBoxed)),
          b"\n",
          b"  switch (which) {\n",
          bytes_join(
            bytes_join(emitter.out, b"").split(toks_mark()),
            toks_freeing(emitter.reuse_widths),
          ),
          b"  }\n  return 0;\n}\n",
          entered,
          wrappers.text,
          emitter.lambda_bodies,
        ]),
        tables: tables_of(
          wrappers.emitter,
          first,
          members.map(|m: Member| head_of(m.params, carried_answer(module, here, m.full))),
        ),
      })
    },
  }
}

/// Each member's case: its own window over the shared temporaries and tables, closed by its return.
fn group_cases(emitter: Emitter, members: List<Member>, i: Int) -> Option<Emitter> / {abort.raise} =
  if i >= members.len() { Some(emitter) } else {
    match members.at(i) {
      None -> None,
      Some(m) -> {
        let opened: Emitter = indent(
          line(emitter, Bytes::concat_all([b"case ", ascii_of_int(i), b": {"])),
        );
        let entered: Emitter = {
          ..opened,
          unboxed: [],
          reads: slots_read(m.body),
          built: [],
          count_locals: [],
          released: [],
          alias: [],
          by_root: [],
          deferred: [],
          sums: [],
          pinned: [],
          bound: [],
          tail: true,
          landing: None,
          owner: m.full,
          base: m.base,
        };
        let words = m.params.map(|p: EmitParam|
          { ..p, carrier: Whole(KBoxed), kind: if is_sum(p.kind) { KBoxed } else { p.kind } });
        match expr(prologue(entered, words), widths_closed(entered, m.body), words) {
          None -> None,
          Some(o) -> {
            let w = returned(o.emitter, o.value);
            let closed = line(
              w.emitter,
              Bytes::concat_all([toks_mark(), b" ctx->fuel += 1; return ", w.expr, b";"]),
            );
            group_cases(line(outdent(closed), b"}"), members, i + 1)
          },
        }
      },
    }
  }

fn group_wrapper(
  emitter: Emitter,
  gname: Bytes,
  which: Int,
  member: Member,
  width: Int,
  answer: Carrier,
) -> { emitter: Emitter, text: Bytes } / {abort.raise} = {
  let name = symbol_of(member.full);
  let grown = grown_words(emitter, member.params, answer);
  let call = Bytes::concat_all([
    gname,
    b"(ctx, ",
    ascii_of_int(which),
    range(0, width).fold(b"", |acc: Bytes, i: Int|
      acc.concat(match grown.words.at(i) { Some(w) -> b", ".concat(w), None -> b", 0" })),
    b")",
  ]);
  let shaped = answer_shapes(grown.emitter, answer);
  let k = returned_kind(answer);
  // A record answer hands its word back with its fields; a scalar's word is let go.
  let opened = |loads: List<CValue>, record: Bool|
    Bytes::concat_all([
      b"  Word r = ",
      call,
      b";\n  if (ctx->failed) ",
      failing_return(k),
      b"\n  ",
      ctype(k),
      b" v = ",
      nth_value(loads, 0).expr,
      b";\n",
      range(1, loads.len()).fold(b"", |t: Bytes, j: Int|
        Bytes::concat_all([t, b"  *o", ascii_of_int(j), b" = ", nth_value(loads, j).expr, b";\n"])),
      b"  ",
      counted_incs(
        range(0, loads.len()).map(|j: Int|
          {
            ..nth_value(loads, j),
            expr: if j == 0 { b"v" } else { b"*o".concat(ascii_of_int(j)) },
          }),
      ),
      if record { Bytes::concat_all([b"*o", ascii_of_int(loads.len()), b" = r;"]) }
      else { b"ply_dec(ctx, r);" },
      b"\n  return v;\n",
    ]);
  {
    emitter: shaped.emitter,
    text: Bytes::concat_all([
      head_text(name, member.params, answer),
      b" {\n",
      if grown.prep.len() == 0 { b"" } else { Bytes::concat_all([b"  ", grown.prep, b"\n"]) },
      match answer {
        Whole(KBoxed) -> Bytes::concat_all([b"  return ", call, b";\n"]),
        Whole(KSum(spec)) ->
          Bytes::concat_all([
            b"  Word r = ",
            call,
            b";\n  if (ctx->failed) return 0;\n  return ",
            sum_helper(spec, b"open"),
            b"(ctx, r);\n",
          ]),
        Whole(_) ->
          opened(
            [
              {
                kind: k,
                expr: as_kind({ kind: KBoxed, expr: b"r", ty: TyOpen([]) }, k),
                ty: TyOpen([]),
              },
            ],
            false,
          ),
        Fields(fs) -> opened(leaf_loads(b"r", fs), true),
        Cases(sc) ->
          Bytes::concat_all([
            b"  Word r = ",
            call,
            b";\n  if (ctx->failed) return 0;\n  ",
            sum_returned(sc, b"r"),
            b"\n",
          ]),
      },
      b"}\n",
      entry_from(name, [], 0, member.params, answer, shaped.shapes),
    ]),
  }
}

/// A constant of a body's table. A width is the runtime's numbering of it, and a float or a decimal
/// is its literal as written, which the driver converts by the lexer's own rule. `ConstUnit` is the
/// unit, and any literal the table has no entry for.
pub type Const =
  | ConstStr(Bytes)
  | ConstBytes(Bytes)
  | ConstFixed({ width: Int, bits: Int })
  | ConstWide({ width: Int, high: Int, low: Int })
  | ConstFloat(Bytes)
  | ConstDecimal(Bytes)
  | ConstChar(Int)
  | ConstUnit

/// What the emitted C calls one definition, and the entry the loader binds it by.
pub type Defined = { symbol: Bytes, entry: Bytes, head: Head }

/// A root's C function as a call declares it: its answer's and each parameter's carried C type.
pub type Head = { answer: Bytes, params: List<Bytes> }

/// The head a body's call of `callee` was written to: a root, or a generic call's placeholder.
pub type Expect = { callee: Bytes, head: Head }

/// The head of a root of `n` parameters that takes and answers words.
pub fn word_head(n: Int) -> Head = { answer: b"Word", params: range(0, n).map(|_: Int| b"Word") }

fn head_of(params: List<EmitParam>, answer: Carrier) -> Head =
  {
    answer: carried_type(returned_kind(answer)),
    params: params.fold([], |acc: List<Bytes>, p: EmitParam|
      acc.concat(carried_types(p.carrier))).concat(
      written_back(answer).map(|f: FieldTy| carried_type(f.kind).concat(b"*")),
    ),
  }

/// What one body names of the unit around it, each table in the order its own text numbers it.
/// `members` are a group's definitions in case order, and empty for a body of its own.
/// A call of a generic definition: the callee, and each type argument as `spelled_type` spells its
/// layout, a variable of the calling body spelled as itself (`'0`), which the unit settles the
/// callee's root by; `carried` are the variables the call hands over raw, which it settles on; and
/// `fns` the lambdas it hands, which the root it settles on may run in place of its calls of them.
pub type GenericCall = { callee: Bytes, args: List<Bytes>, carried: List<Int>, fns: List<FnArg> }

/// A literal lambda handed as argument `param`: the `nth` its owner root lowers. Where the owner
/// stands in its module is no part of it, so a body kept for a definition names the same lambda
/// wherever the definition moves.
pub type FnArg = { param: Int, owner: Bytes, nth: Int }

/// Where a body's code took a slow path because type variable `var` was unknown, and what a
/// specialisation would read of it.
pub type Need = { var: Int, reads: Reads }

/// Whether the variable's type is a scalar the code holds apart from a word, its layout, or the
/// type itself: an operation done per type, `==` or `compare`, reads which type it is.
pub type Reads = | Scalar | Layout | Exact

/// A body's calls of generic definitions, numbered as their `@@gN@@` placeholders are, and its
/// needs: what a specialisation at its type arguments would read of each; the head each call of a
/// root was written to, which the unit holds the callee's own to; and the parameters it calls as
/// functions, or hands on to calls, which the unit closes to know where a function argument is called.
pub type Generics = {
  calls: List<GenericCall>,
  needs: List<Need>,
  expects: List<Expect>,
  called: List<Int>,
  passes: List<Pass>,
}

/// A body's parameter `param` handed on as argument `at` of a call of definition `callee`.
pub type Pass = { param: Int, callee: Bytes, at: Int }

pub fn no_generics() -> Generics = { calls: [], needs: [], expects: [], called: [], passes: [] }

pub type Tables = {
  consts: List<Const>,
  builtins: List<Bytes>,
  fields: List<Bytes>,
  shapes: List<List<Bytes>>,
  lambdas: List<Bytes>,
  calls: List<Bytes>,
  generics: Generics,
  performs: List<Bytes>,
  handles: List<Bytes>,
  members: List<Bytes>,
  symbols: List<Defined>,
}

/// What a body that names nothing of its unit holds.
pub fn no_tables() -> Tables =
  {
    consts: [],
    builtins: [],
    fields: [],
    shapes: [],
    lambdas: [],
    calls: [],
    generics: no_generics(),
    performs: [],
    handles: [],
    members: [],
    symbols: [],
  }

/// `s` with every `byte` taken out.
pub fn without(s: Bytes, byte: Int) -> Bytes =
  Bytes::concat_all(
    range(0, s.len()).map(|i: Int| if s.at(i) == byte { b"" } else { s.slice(i, i + 1) }),
  )

/// The bits of the `Float` a literal's text names, its `_`s read past.
pub fn literal_bits(literal: Bytes) -> Int / {abort.raise} =
  match Float::of_string(String::of_bytes(without(unspaced(literal), 95))) {
    Some(x) -> bits_of_float(x),
    None -> panic("a float literal that does not read"),
  }

fn const_of_lit(literal: Lit) -> Const =
  match literal {
    LStr(x) -> ConstStr(x),
    LBytes(x) -> ConstBytes(x),
    LFixed(name, bits) -> match width_named(name) {
      Some(w) -> ConstFixed({ width: width_index(w), bits: bits }),
      None -> ConstUnit,
    },
    LWide(name, high, low) -> match width_named(name) {
      Some(w) -> ConstWide({ width: width_index(w), high: high, low: low }),
      None -> ConstUnit,
    },
    LFloat(x) -> ConstFloat(unspaced(x)),
    LDec(x) -> ConstDecimal(unspaced(x)),
    LChar(v) -> ConstChar(v),
    _ -> ConstUnit,
  }

/// The tables of a body defining `full`, or its group's members, each with its head in `heads`.
fn tables_of(emitter: Emitter, full: Bytes, heads: List<Head>) -> Tables / {abort.raise} = {
  let names = if emitter.group.len() == 0 { [full] } else { emitter.group };
  {
    consts: emitter.consts.map(const_of_lit),
    builtins: emitter.called_builtins,
    fields: emitter.fields,
    // A shape's fields in the checker's order, which is what the unit interns a shape by.
    shapes: emitter.shapes.map(sorted_names),
    lambdas: emitter.lambdas,
    calls: emitter.calls,
    generics: emitter.generics,
    performs: emitter.performs,
    handles: emitter.handles,
    members: emitter.group,
    // What this body's C calls each definition it holds, so nothing downstream spells a symbol itself.
    symbols: range(0, names.len()).map(|i: Int|
      {
        symbol: symbol_of(names.get(i)),
        entry: entry_of(names.get(i)),
        head: match heads.at(i) { Some(h) -> h, None -> word_head(0) },
      }),
  }
}

/// A negative pattern literal's text runs from its `-`, across any space written after it.
fn unspaced(s: Bytes) -> Bytes =
  Bytes::concat_all(
    range(0, s.len()).map(|i: Int| if s.at(i) <= 32 { b"" } else { s.slice(i, i + 1) }),
  )

/// Ascending: declarations come out sorted, not in the order the widths were found.
fn sorted_widths(xs: List<Int>) -> List<Int> =
  range(0, xs.len()).fold([], |acc: List<Int>, _: Int|
    match xs.fold(None, |best: Option<Int>, x: Int|
        if acc.fold(false, |seen: Bool, y: Int| seen || y == x) { best }
        else { match best { None -> Some(x), Some(b2) -> if x < b2 { Some(x) } else { best } } }) {
      Some(m) -> acc.push(m),
      None -> acc,
    })

/// Counts the call, spends a unit of fuel, and hands the call a stack of its own when this thread's is
/// nearly out: a C frame is not a machine frame, so what bounds nesting is the fuel rather than the machine
/// it runs on. Depth and work are two bounds and two counters: fuel comes back on return, a tick never does.
/// Both are spent past the probe, so the same call re-entered on a new stack is counted once.
fn fuel_head(entry: Bytes, prep: Bytes, args: List<Bytes>, answer: Carrier) -> Bytes =
  Bytes::concat_all([
    b"  if (ctx->fuel <= 0) { rt_no_fuel_p(ctx); ",
    failing_return(returned_kind(answer)),
    b" }\n",
    b"  { char probe; if ((uintptr_t)&probe < ctx->stack_floor) { ",
    prep,
    grow_call(entry, args, answer),
    b" } }\n",
    b"  ",
    tick_line(failing_return(returned_kind(answer))),
    b"\n",
    b"  ctx->fuel -= 1;\n",
  ])

/// One call counted against the entry's step budget: in the prologue, and again at every restart of a loop,
/// since a restart is the call a tail call would have made. The runtime is asked only when the count reaches
/// the checkpoint it set, so a call costs an increment and a compare.
fn tick_line(leave: Bytes) -> Bytes =
  Bytes::concat_all([
    b"if (++ctx->ticks >= ctx->next_tick) { rt_tick_p(ctx); if (ctx->failed) ",
    leave,
    b" }",
  ])

/// The same call once more, on the stack `rt_grow` reserves for it. The arguments travel as an
/// array in this frame, which outlives the call that runs above it.
fn grow_call(entry: Bytes, args: List<Bytes>, answer: Carrier) -> Bytes =
  if args.len() == 0 {
    grown_return(Bytes::concat_all([b"rt_grow_p(ctx, (Word)(intptr_t)&", entry, b", 0)"]), answer)
  } else {
    Bytes::concat_all([
      b"Word ply_grown[",
      ascii_of_int(args.len()),
      b"];",
      range(0, args.len()).fold(b"", |acc: Bytes, i: Int|
        Bytes::concat_all([
          acc,
          b" ply_grown[",
          ascii_of_int(i),
          b"] = ",
          match args.at(i) { Some(a) -> a, None -> b"" },
          b";",
        ])),
      b" ",
      grown_return(
        Bytes::concat_all([
          b"rt_grow_p(ctx, (Word)(intptr_t)&",
          entry,
          b", (Word)(intptr_t)ply_grown)",
        ]),
        answer,
      ),
    ])
  }

/// `grown`'s word returned as a root carrying its answer as `answer` returns it: opened, or a
/// record's fields loaded, the first returned and the others written back.
fn grown_return(grown: Bytes, answer: Carrier) -> Bytes =
  match answer {
    Whole(KBoxed) -> Bytes::concat_all([b"return ", grown, b";"]),
    // The answer's object is taken, its payload handed back.
    Whole(KSum(spec)) ->
      Bytes::concat_all([
        b"Word ply_back = ",
        grown,
        b"; if (ctx->failed) return 0; return ",
        sum_helper(spec, b"open"),
        b"(ctx, ply_back);",
      ]),
    _ -> {
      let k = returned_kind(answer);
      let fail = Bytes::concat_all([b"if (ctx->failed) ", failing_return(k), b" "]);
      match answer {
        Cases(sc) ->
          Bytes::concat_all([
            b"Word ply_back = ",
            grown,
            b"; ",
            fail,
            sum_returned(sc, b"ply_back"),
          ]),
        Fields(fs) -> {
          let loads = leaf_loads(b"ply_back", fs);
          Bytes::concat_all([
            b"Word ply_back = ",
            grown,
            b"; ",
            fail,
            ctype(k),
            b" ply_out = ",
            nth_value(loads, 0).expr,
            b";",
            range(1, loads.len()).fold(b"", |t: Bytes, j: Int|
              Bytes::concat_all([
                t,
                b" *o",
                ascii_of_int(j),
                b" = ",
                nth_value(loads, j).expr,
                b";",
              ])),
            b" ",
            counted_incs(
              range(0, loads.len()).map(|j: Int|
                {
                  ..nth_value(loads, j),
                  expr: if j == 0 { b"ply_out" } else { b"*o".concat(ascii_of_int(j)) },
                }),
            ),
            b"*o",
            ascii_of_int(loads.len()),
            b" = ply_back; return ply_out;",
          ])
        },
        _ ->
          Bytes::concat_all([
            b"Word ply_back = ",
            grown,
            b"; ",
            fail,
            ctype(k),
            b" ply_out = ",
            as_kind({ kind: KBoxed, expr: b"ply_back", ty: TyOpen([]) }, k),
            b"; ply_dec(ctx, ply_back); return ply_out;",
          ]),
      }
    },
  }

/// A group's are its case selector and the widest member's parameters.
fn group_args(width: Int) -> List<Bytes> =
  range(0, width).fold([b"which"], |acc: List<Bytes>, i: Int|
    acc.push(b"p".concat(ascii_of_int(i))))

test "a body that answers a literal" {
  let f = symbol_of(b"m.f");
  assert_eq(
    match emit_fn(b"m", [], [], [], [], b"m.f", [], {
        own: Borrowed,
        span: dummy_span(),
        node: NLit(LInt(7)),
      }) {
      Some(c) -> c,
      None -> b"",
    },
    Bytes::concat_all([
      b"Word ",
      f,
      b"_entry(PlyCtx *ctx, const Word *args);\n",
      b"Word ",
      f,
      b"(PlyCtx *ctx) {\n  if (ctx->fuel <= 0) { rt_no_fuel_p(ctx); return 0; }\n  { char probe; if ((uintptr_t)&probe < ctx->stack_floor) { return rt_grow_p(ctx, (Word)(intptr_t)&",
      f,
      b"_entry, 0); } }\n  if (++ctx->ticks >= ctx->next_tick) { rt_tick_p(ctx); if (ctx->failed) return 0; }\n  ctx->fuel -= 1;\n  ctx->fuel += 1;\n  return (ply_fits_imm(INT64_C(7)) ? ply_imm(INT64_C(7)) : rt_box_int_p(ctx, INT64_C(7)));\n}\n",
      b"Word ",
      f,
      b"_entry(PlyCtx *ctx, const Word *args) {\n  return ",
      f,
      b"(ctx);\n}\n",
    ]),
  )
}

test "a body that would overrun this thread's stack runs the same call on a stack of its own" {
  let out = emit_all_program([{ name: b"m", src: b"fn g(b: Bytes) -> Bytes = b\n" }], [], [], true);
  let text = match out.at(0) { Some(e) -> e.text, None -> b"" };
  assert_eq(
    text.index_of(
        Bytes::concat_all([
          b"{ char probe; if ((uintptr_t)&probe < ctx->stack_floor) { Word ply_grown[1];",
          b" ply_grown[0] = p0; return rt_grow_p(ctx, (Word)(intptr_t)&",
          symbol_of(b"m.g"),
          b"_entry, (Word)(intptr_t)ply_grown); } }",
        ]),
      )
      != None,
    true,
  );
  assert_eq(text.index_of(b"rt_no_stack_p") != None, false)
}

test "two names an underscore apart spell two symbols" {
  assert_eq(symbol_of(b"m_a.b") == symbol_of(b"m.a_b"), false);
  assert_eq(symbol_of(b"m.f"), b"ply_m_1f_1");
  assert_eq(symbol_of(b"m.f#requires#0"), b"ply_m_1f_1requiresh80h1");
  // A byte no C identifier holds takes the whole piece into hex.
  assert_eq(symbol_of(b"m.f\xc3\xa9"), b"ply_m_166c3a9x6")
}

test "a self call in tail position restarts the body instead of nesting" {
  let src = Bytes::concat_all([
    b"fn count(n: Int, acc: Int) -> Int = if n <= 0 { acc } else { count(n - 1, acc + n) }\n",
    b"fn upto(xs: List<Int>, i: Int, acc: Int) -> Int = match i >= xs.len() { true -> acc, false -> upto(xs, i + 1, acc + 1) }\n",
    b"fn all_below(xs: List<Int>, bound: Int, i: Int) -> Bool = i >= xs.len() || (i < bound && all_below(xs, bound, i + 1))\n",
    b"fn ladder(n: Int) -> Int = if n <= 0 { 0 } else { 1 + ladder(n - 1) }\n",
    b"fn inner(n: Int) -> Int = { let k = if n > 5 { inner(n - 1) } else { 0 }; k + 1 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None]);
  assert_eq(out.map(|e: Emitted| e.text.index_of(b"ply_loop: if") != None), [
    true,
    true,
    true,
    false,
    false,
  ]);
  assert_eq(out.map(|e: Emitted| e.text.index_of(b"goto ply_loop;") != None), [
    true,
    true,
    true,
    false,
    false,
  ])
}

test "a self call that takes no arguments restarts the body as well" {
  // `spin` declares a row: a pure nullary definition is a constant, which the table answers.
  let src = Bytes::concat_all([
    b"fn spin() -> Int / {clock.read, diverges} = spin()\n",
    b"fn poll() -> Int / {clock.read, diverges} = { clock.now(); poll() }\n",
    b"fn ladder() -> Int / {diverges} = 1 + ladder()\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.name), [b"m.spin", b"m.poll", b"m.ladder"]);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None]);
  assert_eq(out.map(|e: Emitted| e.text.index_of(b"ply_loop: if") != None), [true, true, false]);
  assert_eq(out.map(|e: Emitted| e.text.index_of(b"goto ply_loop;") != None), [true, true, false]);
  // A lone definition is no group, so the jump is the self path's, and a nullary body assigns nothing before it.
  let spin = match out.at(0) {
    Some(e) -> e,
    None -> { name: b"", text: b"", tables: no_tables(), why: None, handles: [] },
  };
  assert_eq(spin.text.index_of(b"which = ") != None, false);
  assert_eq(spin.text.index_of(b"p0 = ") != None, false)
}

test "a tail call into a definition's own recursive group jumps instead of nesting" {
  let src = Bytes::concat_all([
    b"fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\n",
    b"fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n",
    b"fn parity(n: Int) -> Bool = even(n)\n",
    b"fn count(n: Int, acc: Int) -> Int = if n <= 0 { acc } else { count(n - 1, acc + n) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.name), [b"m.even", b"m.parity", b"m.count"]);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None]);
  let group = match out.at(0) {
    Some(e) -> e,
    None -> { name: b"", text: b"", tables: no_tables(), why: None, handles: [] },
  };
  assert_eq(group.tables.members, [b"m.even", b"m.odd"]);
  let scalars = { answer: b"int64_t", params: [b"int64_t"] };
  assert_eq(group.tables.symbols, [
    { symbol: symbol_of(b"m.even"), entry: entry_of(b"m.even"), head: scalars },
    { symbol: symbol_of(b"m.odd"), entry: entry_of(b"m.odd"), head: scalars },
  ]);
  assert_eq(
    group.text.index_of(
        Bytes::concat_all([
          b"static Word ",
          symbol_of(b"m.even"),
          b"_group(PlyCtx *ctx, int which, Word p0) {",
        ]),
      )
      != None,
    true,
  );
  assert_eq(group.text.index_of(b"ply_loop: if") != None, true);
  assert_eq(group.text.index_of(b"which = 1;\n") != None, true);
  assert_eq(group.text.index_of(b"which = 0;\n") != None, true);
  assert_eq(group.text.index_of(b"goto ply_loop;") != None, true);
  assert_eq(
    group.text.index_of(
        Bytes::concat_all([
          b"int64_t ",
          symbol_of(b"m.odd"),
          b"(PlyCtx *ctx, int64_t p0) {\n  Word r = ",
          symbol_of(b"m.even"),
          b"_group(ctx, 1, (ply_fits_imm(p0) ? ply_imm(p0) : rt_box_int_p(ctx, p0)));",
        ]),
      )
      != None,
    true,
  );
  assert_eq(
    group.text.index_of(
        Bytes::concat_all([b"Word ", entry_of(b"m.even"), b"(PlyCtx *ctx, const Word *args)"]),
      )
      != None,
    true,
  );
  assert_eq(group.text.index_of(b"PLY_SITE(ctx, @@r@@") != None, false);
  // A caller outside the group calls a member's own symbol, and a self loop outside a group keeps its label.
  let parity = match out.at(1) { Some(e) -> e, None -> group };
  assert_eq(parity.text.index_of(symbol_of(b"m.even").concat(b"(ctx, ")) != None, true);
  assert_eq(parity.text.index_of(b"ply_loop") != None, false);
  let count = match out.at(2) { Some(e) -> e, None -> group };
  assert_eq(count.text.index_of(b"ply_loop: if") != None, true);
  assert_eq(count.text.index_of(b"which = ") != None, false);
  assert_eq(count.tables.members, [])
}

test "a cycle whose member holds a handle, or whose calls are not in tail position, is emitted per definition" {
  let src = Bytes::concat_all([
    b"fn a(n: Int) -> Int / {clock.read, diverges} = if n <= 0 { 0 } else if n == 1 { handle { b(0) } with { clock.now() -> clock.now(), } } else { b(n - 1) }\n",
    b"fn b(n: Int) -> Int / {clock.read, diverges} = if n <= 0 { clock.now(); 0 } else { a(n - 1) }\n",
    b"fn c(n: Int) -> Int = if n <= 0 { 0 } else { 1 + d(n - 1) }\n",
    b"fn d(n: Int) -> Int = if n <= 0 { 0 } else { c(n - 1) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.name), [b"m.a", b"m.b", b"m.c", b"m.d"]);
  assert_eq(out.map(|e: Emitted| e.why == None), [true, true, true, true]);
  assert_eq(out.map(|e: Emitted| e.tables.members.len() == 2), [false, false, false, false]);
  assert_eq(out.map(|e: Emitted| e.text.index_of(b"_group(PlyCtx *ctx, int which") != None), [
    false,
    false,
    false,
    false,
  ])
}

/// The C between a `handle`'s push and its landing label, for a unit whose first definition holds one.
fn handled_body(src: Bytes, release: Bool) -> Bytes / {abort.raise} = {
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [],
    [b"U8::of_int", b"Int::of_u8", b"Bytes::at", b"Array::get"],
    release,
  );
  match out.at(0) {
    None -> b"nothing was emitted",
    Some(e) -> match e.why {
      Some(why) -> why,
      None -> match e.text.index_of(b"rt_handle_push_p") {
        None -> b"no handle was pushed",
        Some(pushed) -> match e.text.index_of(b":;\n") {
          None -> b"no handle lands",
          Some(landed) -> e.text.slice(pushed, landed),
        },
      },
    },
  }
}

test "a body that fails inside a `handle` leaves through the handle's landing, whatever failed" {
  let src = Bytes::concat_all([
    b"fn f(vs: List<Int>, b: Bytes, xs: Array<Int>, n: Int) -> Int =\n",
    b"  handle {\n",
    b"    let [x, ..] = vs;\n",
    b"    x + Int::of_u8(U8::of_int(n)) + b.at(n) + xs.get(n) + (0 - n) * (n << 3)\n",
    b"  } with { abort.raise(m) -> 0 }\n",
  ]);
  let bodies = [false, true].map(|release: Bool| handled_body(src, release));
  let leaves = |raised: Bytes| bodies.map(|body: Bytes| body.index_of(raised) != None);
  assert_eq(leaves(b"rt_let_no_match_p(ctx); goto land_"), [true, true]);
  assert_eq(leaves(b"rt_not_that_width_p(ctx, "), [true, true]);
  assert_eq(leaves(b"builtin_bytes_at_p(ctx, "), [true, true]);
  assert_eq(bodies.map(|body: Bytes| body.index_of(b"return")), [None, None])
}

test "a `parallel` block tells the runtime its definition's row only where that row holds all its branches reach" {
  let src = Bytes::concat_all([
    b"effect meter { read level() -> Int }\n",
    b"fn pure(n: Int) -> (Int, Int) = parallel { n + 1, n + 2 }\n",
    b"fn reads() -> (Int, Int) / {meter.level} = parallel { meter.level(), meter.level() }\n",
    b"fn handled() -> (Int, Int) = handle { parallel { meter.level(), meter.level() } } with { meter.level() -> 0 }\n",
    b"fn nested(xs: List<Int>) -> List<(Int, Int)> = xs.map(|m: Int| parallel { m + 1, m + 2 })\n",
    b"fn open<| e>(g: () -> Int / e) -> (Int, Int) / e = parallel { g(), 1 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [b"List::map"], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None]);
  let calls = |helper: Bytes| out.map(|e: Emitted| e.text.index_of(helper) != None);
  assert_eq(calls(b"rt_parallel_past_p(ctx, "), [true, true, false, false, false]);
  assert_eq(calls(b"rt_parallel_p(ctx, "), [false, false, true, true, true])
}

test "a `return` a `handle` body emitted is seen, however its lines were joined since" {
  let failing = b"  if (ctx->failed) return 0;\n";
  assert(leaves_unlanded([b"  x;\n"], [b"  x;\n", failing]));
  assert(leaves_unlanded([b"  x;\n", b"  y;\n"], [Bytes::concat_all([b"  x;\n  y;\n", failing])]));
  // One before the `handle` is the function's own, and a callee may spell the word.
  assert(!leaves_unlanded([failing], [failing, b"  if (ctx->failed) goto land_3;\n"]));
  assert(!leaves_unlanded([b"  x;\n"], [b"  x;\n", b"  Word t1 = ply_m_1returned_1(ctx);\n"]))
}

test "a form this port does not reach is refused" {
  assert_eq(
    match emit_fn(b"m", [], [], [], [], b"m.f", [], {
        own: Borrowed,
        span: dummy_span(),
        node: NLit(LBad),
      }) {
      Some(_) -> false,
      None -> true,
    },
    true,
  )
}

test "a program that will not parse is refused, and the refusal carries the parser's words" {
  let out = emit_all_program(zip_sources([b"m"], [b"fn f(x: -> Int = 1\n"]), [], [], true);
  assert_eq(out.map(|e: Emitted| e.name), [b"m"]);
  assert_eq(out.map(|e: Emitted| match e.why { Some(w) -> w.len() > 0, None -> false }), [true])
}

test "the emitter answers each root it was asked for, a body's tables as values" {
  let src = b"fn greet() -> Bytes = b\"hi\"\nfn twice(x: Int) -> Int = x + x\nfn guarded() -> Option<Instant> / {clock.read} = handle { Some(clock.now()) } with { clock.now() -> clock.now(), }\n";
  let wanted = [b"m.greet", b"m.twice", b"m.guarded"];
  // No constructor is in the table, so the body that builds one is refused.
  let answers = answers_of([b"m"], [src], [], wanted);
  assert_eq(answers.map(|a: RootAnswer| a.name), wanted);
  match answers.get(0).answer {
    Body(b) -> {
      assert_eq(b.tables.consts, [ConstBytes(b"hi")]);
      assert_eq(b.tables.members, []);
      assert_eq(b.tables.symbols, [
        { symbol: symbol_of(b"m.greet"), entry: entry_of(b"m.greet"), head: word_head(0) },
      ])
    },
    Refused(_) -> assert(false),
  };
  match answers.get(2).answer {
    Refused(r) -> {
      assert_eq(r.why, b"a constructor not in the table: Some");
      assert_eq(r.handles, [b"clock#now"])
    },
    Body(_) -> assert(false),
  }
}

test "guarded arms and every literal pattern are emitted rather than refused" {
  let src = b"fn f(n: Int, m: Int) -> Int = match n { x if x > m -> x, 0 -> 1, x if x < 0 - m -> m, _ -> m }\nfn g(s: String) -> Int = match s { t if t == \"a\" -> 1, \"b\" -> 2, _ -> 3 }\nfn h(u: Unit, b: Bytes, f: Float, d: Decimal, w: U64, n: Int) -> Int = match u { () -> match b { b\"x\" -> 1, _ -> match f { -1.5 -> 2, _ -> match d { 2.50m -> 3, _ -> match w { 7u64 -> 4, _ -> match n { 4611686018427387904 -> 5, _ -> 6 } } } } } }\n";
  assert_eq(emit_all_program([{ name: b"m", src: src }], [], [], true).map(|e: Emitted| e.why), [
    None,
    None,
    None,
  ])
}

test "an operator is compiled at the type the checker settled, whatever holds its operands" {
  let src = Bytes::concat_all([
    b"fn bytes(xs: List<U8>) -> U8 = match xs { [a, b, ..] -> a + b, _ -> 0u8 }\n",
    b"fn ints(xs: List<Int>) -> Int = match xs { [a, b, ..] -> a + b, _ -> 0 }\n",
    b"fn folded(xs: List<U8>) -> U8 = xs.fold(0u8, wrap_add)\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None]);
  // The runtime's operator reads its words untyped, and a builtin value is the runtime's too.
  assert_eq(has(b"rt_binary_p"), [false, false, false]);
  assert_eq(has(b"rt_builtin_value_p"), [false, false, false]);
  assert_eq(has(b" > INT64_C(255)) { rt_overflow_p"), [true, false, false]);
  assert_eq(has(b"ply_add_ov("), [false, true, false]);
  assert_eq(has(b"(uint8_t)((uint64_t)(uint8_t)("), [false, false, true])
}

test "a `Float` is a C `double`: its operators are C's own and a literal is its bits" {
  let src = Bytes::concat_all([
    b"fn poly(x: Float) -> Float = (0.5 * x + 0.25) * x - 1.5\n",
    b"fn less(a: Float, b: Float) -> Bool = a < b || a == -b\n",
    b"fn rest(a: Float, b: Float) -> Float = a % b\n",
    b"type Point = { x: Float, y: Float }\n",
    b"fn norm(p: Point) -> Float = p.x * p.x + p.y * p.y\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  assert_eq(has(b"rt_binary_p"), [false, false, false, false]);
  assert_eq(has(b"rt_negate_p"), [false, false, false, false]);
  assert_eq(has(b"double "), [true, true, true, true]);
  // `0.5` is `0x3FE0_0000_0000_0000`.
  assert_eq(has(b"ply_f64(INT64_C(4602678819172646912))"), [true, false, false, false]);
  // C has no `%` on doubles; the runtime answers it as the evaluator does.
  assert_eq(has(b"rt_float_rem_p"), [false, false, true, false])
}

/// A root's own code: what it runs past its fuel head and before its entry, leaving out the
/// adapters that box what it carries raw for the runtime.
fn own_code(text: Bytes) -> Bytes / {abort.raise} = {
  let from = match text.index_of(b"ctx->fuel -= 1;\n") { Some(i) -> i, None -> 0 };
  let to = match text.index_of(b"_entry(PlyCtx *ctx, const Word *args) {") {
    Some(i) -> i,
    None -> text.len(),
  };
  text.slice(from, to)
}

test "a record holds every `Float` field as its bits, wherever the field stands" {
  let fields = bytes_join(
    range(0, 70).map(|k: Int| Bytes::concat_all([b"f", ascii_of_int(k + 10), b": Float"])),
    b", ",
  );
  let src = Bytes::concat_all([
    b"type Point = { x: Float, y: Float }\n",
    b"fn point(x: Float, y: Float) -> Point = { x: x, y: y }\n",
    b"fn sum(p: Point) -> Float = p.x + p.y\n",
    b"fn weighed(name: String, weight: Float) -> { name: String, weight: Float } = { name: name, weight: weight }\n",
    b"fn moved(p: Point, by: Float) -> Point = { ..p, x: p.x + by }\n",
    b"type Wide = { ",
    fields,
    b", tag: String }\n",
    b"fn last(wide: Wide) -> Float = wide.f79\n",
    b"fn wrapped<a>(x: a) -> { inner: a } = { inner: x }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None, None]);
  // No `Float` is boxed: a record holds its bits, and a function takes and answers its own.
  assert_eq(out.map(|e: Emitted| own_code(e.text).index_of(b"rt_box_float_p") != None), [
    false,
    false,
    false,
    false,
    false,
    false,
  ]);
  // `Point` holds bits alone, so it is flat wherever its word is made, here by the entries that
  // hand one to the runtime; `weighed` holds a word it counts beside them, so it is mixed and the
  // word after its fields says its first is the counted one. Both are raw.
  assert_eq(has(b"@@, 5);"), [true, true, false, true, false, false]);
  assert_eq(has(b"@@, 6);"), [false, false, true, false, false, false]);
  assert_eq(has(b"[2] = INT64_C(1);"), [false, false, true, false, false, false]);
  // A record of a known type holds a `Float` as its bits wherever it was made, so a read is a load,
  // the 70th field's at its place as the first's.
  assert(out.get(4).text.index_of(b")[69]") != None);
  // A field of a variable's type is laid out as what it holds when the record is made.
  assert_eq(has(b"rt_record_p"), [false, false, false, false, false, true])
}

test "a definition takes and answers a float as itself, and a call says the head it was written to" {
  let src = b"fn half(x: Float) -> Float = x / 2.0\nfn quarter(x: Float) -> Float = half(half(x))\nfn same(x: Int) -> Int = x\n";
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let floats = { answer: b"double", params: [b"double"] };
  assert(
    out.get(0).text.index_of(
        Bytes::concat_all([b"double ", symbol_of(b"m.half"), b"(PlyCtx *ctx, double p0) {"]),
      )
      != None,
    None,
  );
  assert(own_code(out.get(1).text).index_of(b"rt_box_float_p") == None, None);
  assert_eq(out.get(1).tables.generics.expects, [
    { callee: b"m.half", head: floats },
    { callee: b"m.half", head: floats },
  ]);
  assert_eq(out.get(1).tables.symbols.map(|d: Defined| d.head), [floats]);
  // An `Int` crosses as itself too.
  assert_eq(out.get(2).tables.symbols.map(|d: Defined| d.head), [
    { answer: b"int64_t", params: [b"int64_t"] },
  ])
}

test "a lambda reads a field of its parameter or its capture where the record's type lays it" {
  let src = Bytes::concat_all([
    b"type Fld = { name: Bytes, n: Int }\n",
    b"fn mapped(fs: List<Fld>) -> List<Int> = fs.map(|f: Fld| f.n)\n",
    b"fn folded(fs: List<Fld>) -> Int = fs.fold(0, |acc: Int, f: Fld| acc + f.n)\n",
    b"fn captured(f: Fld, xs: List<Int>) -> List<Int> = xs.map(|x: Int| x + f.n)\n",
    b"fn stepped(f: Fld) -> Int / {abort.raise} = iterate(f, 9, |t: Fld| if t.n > 3 { Stop(t.n) } else { Continue({ ..t, n: t.n + 1 }) })\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [b"Stop", b"Continue"],
    [b"List::map", b"List::fold"],
    true,
  );
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  assert_eq(out.map(|e: Emitted| e.text.index_of(b"rt_field_p") != None), [
    false,
    false,
    false,
    false,
  ])
}

/// `scaled` hands a lambda to `total`, which hands it on to `each`, which calls it.
fn lending() -> Bytes =
  b"fn each(n: Int, f: (Int) -> Int, i: Int, acc: Int) -> Int = if i >= n { acc } else { each(n, f, i + 1, acc + f(i)) }\nfn total(n: Int, f: (Int) -> Int) -> Int = each(n, f, 0, 0)\nfn scaled(n: Int, k: Int) -> Int = total(n, |x: Int| x * k)\n"

test "a lambda handed to a definition that calls it is run in place by the root it settles on" {
  let lent = [{ param: 1, owner: b"m.scaled", nth: 0 }];
  let total = specialised_with(b"m.total", [], lent);
  let each = specialised_with(b"m.each", [], lent);
  let answers = answers_of([b"m"], [lending()], [], [
    b"m.each",
    b"m.total",
    b"m.scaled",
    total,
    each,
  ]);
  let body = |name: Bytes|
    answers.fold(None, |acc: Option<{ text: Bytes, tables: Tables }>, a: RootAnswer|
      if a.name != name { acc } else {
        match a.answer { Body(b) -> Some(b), Refused(r) -> panic(String::of_bytes_lossy(r.why)) }
      });
  let generics = |name: Bytes|
    match body(name) { Some(b) -> b.tables.generics, None -> no_generics() };
  // `each` calls its parameter; `total` hands its own on to `each`, which calls it.
  assert_eq(generics(b"m.each").called, [1]);
  assert_eq(generics(b"m.total").passes, [{ param: 1, callee: b"m.each", at: 1 }]);
  assert_eq(generics(b"m.scaled").calls.map(|g: GenericCall| g.fns), [lent]);
  assert_eq(generics(total).calls.map(|g: GenericCall| g.fns), [lent]);
  // The lambda runs in `each`'s loop: no call through the runtime, its product written there.
  match body(each) {
    Some(b) -> {
      assert(own_code(b.text).index_of(b"rt_call_p") == None, None);
      assert(own_code(b.text).index_of(b"ply_loop") != None, None)
    },
    None -> panic("no body for the specialisation"),
  }
}

test "a function value a let binds to a lambda runs in place where it is called and is lent where it is handed" {
  let src = Bytes::concat_all([
    b"fn walked(n: Int, x: Float, f: (Float) -> Float) -> Float = if n <= 0 { x } else { walked(n - 1, f(x), f) }\n",
    b"fn called(k: Float) -> Float = { let f = |x: Float| x * k; let g = f; f(1.0) + g(2.0) }\n",
    b"fn nested(k: Float) -> Float = { let f = |x: Float| x * k; let h = |x: Float| f(x) + 1.0; h(2.0) }\n",
    b"fn handed(n: Int, k: Float) -> Float = { let f = |x: Float| x * k; let g = f; walked(n, 1.0, g) }\n",
    b"fn half(x: Float) -> Float = x * 0.5\n",
    b"fn halved(n: Int) -> Float = walked(n, 1.0, half)\n",
  ]);
  let lent = [{ param: 2, owner: b"m.handed", nth: 0 }];
  let walked = specialised_with(b"m.walked", [], lent);
  let named = [{ param: 2, owner: b"m.halved", nth: 0 }];
  let halving = specialised_with(b"m.walked", [], named);
  let answers = answers_of([b"m"], [src], [], [
    b"m.walked",
    b"m.called",
    b"m.nested",
    b"m.handed",
    b"m.half",
    b"m.halved",
    walked,
    halving,
  ]);
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if a.name == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(r.why)),
      },
      None -> panic("no answer"),
    };
  // A call of the bound name, of another name bound to it, and of one a lambda captures.
  assert(own_code(body(b"m.called").text).index_of(b"rt_call_p") == None, None);
  assert(body(b"m.nested").text.index_of(b"rt_call_p") == None, None);
  // Handed on, it is the lambda its `let` wrote, which `walked` runs in its loop.
  assert_eq(body(b"m.handed").tables.generics.calls.map(|g: GenericCall| g.fns), [lent]);
  assert(own_code(body(walked).text).index_of(b"rt_call_p") == None, None);
  assert(own_code(body(walked).text).index_of(b"ply_loop") != None, None);
  // A definition handed on by name is lent as the lambda around a call of it, which `walked`
  // makes directly, counting no step but the definition's own.
  assert_eq(body(b"m.halved").tables.generics.calls.map(|g: GenericCall| g.fns), [named]);
  assert(own_code(body(halving).text).index_of(b"rt_call_p") == None, None);
  assert(own_code(body(halving).text).index_of(symbol_of(b"m.half")) != None, None);
  assert_eq(
    own_code(body(halving).text).split(b"ctx->ticks").len(),
    own_code(body(b"m.walked").text).split(b"ctx->ticks").len(),
  )
}

test "a definition at type arguments that are all known lends its lambdas as a plain one does" {
  let src = Bytes::concat_all([
    b"fn some<a>(xs: List<a>, f: (a) -> Bool, i: Int) -> Bool = match xs.at(i) { Some(x) -> if f(x) { true } else { some(xs, f, i + 1) }, None -> false }\n",
    b"fn holds<a>(xs: List<a>, x: a) -> Bool = some(xs, |y: a| y == x, 0)\n",
    b"fn has_three(xs: List<Int>) -> Bool = holds(xs, 3)\n",
  ]);
  let int = TyCon({ name: b"Int", args: [] });
  let holds = specialised(b"m.holds", [int]);
  let lent = [{ param: 1, owner: holds, nth: 0 }];
  let some = specialised_with(b"m.some", [int], lent);
  // A root's name reads back with its lambda's owner whole, type arguments and all.
  assert_eq(specialisation_of(some), Some({ base: b"m.some", args: [int], fns: lent }));
  let answers = answers_of([b"m"], [src], [b"Some", b"None"], [b"m.has_three", holds, some]);
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if a.name == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(r.why)),
      },
      None -> panic("no answer"),
    };
  // `holds` at `Int` hands `some` its lambda, and `some` runs it in its loop.
  assert_eq(body(holds).tables.generics.calls.map(|g: GenericCall| g.fns), [lent]);
  assert(own_code(body(some).text).index_of(b"rt_call_p") == None, None);
  assert(own_code(body(some).text).index_of(b"rt_equal_p") == None, None);
  assert(own_code(body(some).text).index_of(b"ply_loop") != None, None);
  // Asked for alone, `some` still reads the lambda's operator at the type its owner is at.
  assert_eq(
    answers_of([b"m"], [src], [b"Some", b"None"], [some]).map(|a: RootAnswer|
      match a.answer {
        Body(b) -> own_code(b.text),
        Refused(r) -> panic(String::of_bytes_lossy(r.why)),
      }),
    [own_code(body(some).text)],
  )
}

test "a body that hands a lambda on is the same wherever its definition stands, and so are the roots it names" {
  let lent = [{ param: 1, owner: b"m.scaled", nth: 0 }];
  let wanted = [
    b"m.scaled",
    specialised_with(b"m.total", [], lent),
    specialised_with(b"m.each", [], lent),
  ];
  let emitted = |above: Bytes|
    answers_of([b"m"], [above.concat(lending())], [], wanted).map(|a: RootAnswer|
      match a.answer {
        Body(b) -> { name: a.name, text: b.text, calls: b.tables.calls },
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([a.name, b": ", r.why]))),
      });
  // A body is kept under its definition's hash, which an edit above the definition does not move.
  assert_eq(
    emitted(b"// a comment, and a definition, above them\nfn aside() -> Int = 7\n"),
    emitted(b""),
  )
}

test "a definition's call of itself is written to the head of the root it names" {
  let src = b"fn deepened<a>(x: a, n: Int) -> a where numeric(a) = if n <= 0 { x } else { deepened(x, n - 1) + x }\n";
  let answers = answers_of([b"m"], [src], [], [b"m.deepened", b"m.deepened@Float"]);
  let heads = |name: Bytes|
    answers.filter(|a: RootAnswer| a.name == name).map(|a: RootAnswer|
      match a.answer {
        Body(b) ->
          {
            own: b.tables.symbols.map(|d: Defined| d.head),
            called: b.tables.generics.expects.map(|e: Expect| e.head),
          },
        Refused(r) -> panic(String::of_bytes_lossy(r.why)),
      });
  let words = { answer: b"Word", params: [b"Word", b"Word", b"int64_t"] };
  let floats = { answer: b"double", params: [b"Word", b"double", b"int64_t"] };
  assert_eq(heads(b"m.deepened"), [{ own: [words], called: [words] }]);
  assert_eq(heads(b"m.deepened@Float"), [{ own: [floats], called: [floats] }])
}

test "a small record of floats crosses a call as its fields" {
  let src = b"type P = { x: Float, y: Float }\nfn mid(a: P, b: P) -> P = { x: (a.x + b.x) / 2.0, y: (a.y + b.y) / 2.0 }\nfn twice(p: P) -> P = mid(p, p)\n";
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let mid = {
    answer: b"double",
    params: [b"double", b"double", b"Word", b"double", b"double", b"Word", b"double*", b"Word*"],
  };
  assert_eq(out.map(|e: Emitted| e.why), [None, None]);
  assert_eq(out.get(0).tables.symbols.map(|d: Defined| d.head), [mid]);
  assert_eq(out.get(1).tables.generics.expects, [{ callee: b"m.mid", head: mid }]);
  // Neither body makes an object: `mid` answers fields and `twice` hands `p`'s along.
  assert_eq(out.map(|e: Emitted| own_code(e.text).index_of(b"rt_alloc_p") != None), [false, false])
}

test "a record of a record type holds it in place, header and all" {
  let src = Bytes::concat_all([
    b"type Point = { x: Float, y: Float }\n",
    b"type Segment = { from: Point, label: String, to: Point }\n",
    b"fn segment(from: Point, to: Point, label: String) -> Segment = { from: from, label: label, to: to }\n",
    b"fn end_x(s: Segment) -> Float = s.to.x\n",
    b"fn start(s: Segment) -> Point = s.from\n",
    b"fn relabelled(s: Segment, label: String) -> Segment = { ..s, label: label }\n",
    b"fn wrapped<a>(x: a) -> { outer: { inner: a } } = { outer: { inner: x } }\n",
    b"fn retargeted(s: Segment, to: Point) -> Segment = { ..s, to: to }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None, None]);
  // `from` takes a header's two words and its own two, `label` the fifth, `to` the four after, and
  // the bitmap after them names the fifth alone as counted.
  assert_eq(has(b", 9, @@s"), [true, false, false, true, false, true]);
  assert_eq(has(b"@@, 6);"), [true, false, false, true, false, true]);
  assert_eq(has(b"[9] = INT64_C(16);"), [true, false, false, true, false, true]);
  // `segment`'s points arrive as their fields and word: written in place, or copied in where one
  // was made; an update copies one in.
  assert_eq(has(b"ply_embed(ctx, "), [true, false, false, true, false, true]);
  // A read of a record held in place is the address of its header inside its holder.
  assert_eq(has(b"+ 5))"), [false, true, false, true, false, false]);
  assert_eq(has(b"rt_box_float_p"), [false, true, false, false, false, false]);
  // `start` hands on the `from` it reads last from a record it holds: where it holds it alone, the
  // words move out. `end_x` reads through `to` and moves nothing.
  assert_eq(has(b"ply_take(ctx, "), [false, false, true, false, false, false]);
  // An update of a record it holds alone writes over the fields it sets, `label` a word and `to` a
  // record in place, and copies nothing.
  assert_eq(has(b")->rc == 1) {"), [false, false, false, true, false, true]);
  assert_eq(has(b"ply_dec(ctx, ply_words("), [false, false, false, true, false, false]);
  assert_eq(has(b"ply_drop_embedded(ctx, "), [false, false, false, false, false, true]);
  // A record holding one of a variable's type in place is laid out when it is made.
  assert_eq(has(b"rt_record_p"), [false, false, false, false, true, false])
}

test "a 64-bit width is held in a C register of its type, and in a record as its bits" {
  let src = Bytes::concat_all([
    b"type Tally = { count: U64, label: String, offset: I64 }\n",
    b"fn bumped(t: Tally, by: U64) -> Tally = { ..t, count: t.count + by }\n",
    b"fn scaled(a: U64, b: U64) -> U64 = a * b\n",
    b"fn turned(a: I64) -> I64 = -a\n",
    b"fn largest() -> U64 = 0xFFFF_FFFF_FFFF_FFFFu64\n",
    b"fn kept<a>(x: a) -> { inner: a } = { inner: x }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None]);
  // A sum is formed and guarded in the width itself; a product is the runtime's.
  assert_eq(has(b"(uint64_t)"), [true, true, false, true, false]);
  assert_eq(has(b"rt_binary_p"), [false, false, false, false, false]);
  assert_eq(has(b"rt_wide_binary_p(ctx, 2, 3, "), [false, true, false, false, false]);
  assert_eq(has(b"== INT64_MIN"), [false, false, true, false, false]);
  // The record holds its count's bits where its type says; a function takes and answers its width
  // raw, and only a nullary answer, which a constant reads, is boxed.
  assert_eq(has(b"] = (Word)("), [true, false, false, false, false]);
  assert_eq(out.map(|e: Emitted| own_code(e.text).index_of(b"rt_box_fixed_p") != None), [
    false,
    false,
    false,
    true,
    false,
  ]);
  assert_eq(has(b"rt_record_p"), [false, false, false, false, true])
}

test "an array holds its records in place and its floats as their bits" {
  let src = Bytes::concat_all([
    b"type Point = { x: Float, y: Float }\n",
    b"fn second_x(ps: Array<Point>) -> Float / {abort.raise} = ps.get(1).x\n",
    b"fn bumped(xs: Array<Float>, i: Int) -> Float / {abort.raise} = xs.get(i) + 1.0\n",
    b"fn count(ps: Array<Point>) -> Int = ps.len()\n",
    b"fn element_of<a>(xs: Array<a>, i: Int) -> a / {abort.raise} = xs.get(i)\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [b"Array::get", b"Array::len"], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  // A point takes a header's two words and its own two: element `i` is the header `4 * i` words in.
  // A `Float`, an element or a point's field, is a load of its bits.
  assert_eq(has(b" * 4); ply_inc("), [true, false, false, false]);
  assert_eq(has(b"ply_f64(ply_words("), [true, true, false, false]);
  assert_eq(has(b"ply_array_len("), [true, true, true, false]);
  // An array of a variable's type is the runtime's to read.
  assert_eq(has(b"builtin_array_get"), [true, true, false, true])
}

test "a value's layout is read off its node's type where the value carries none" {
  let src = Bytes::concat_all([
    b"type P = { x: Int, y: Int }\n",
    b"fn larger(p: P, q: P) -> Int = max(p, q).x\n",
    b"fn kept(p: P, q: P) -> Int = { let m = max(p, q); m.x + m.y }\n",
    b"fn opened(p: P, q: P) -> Int = { let { x, y } = max(p, q); x + y }\n",
    b"fn chosen(p: P, q: P) -> Int = match max(p, q) { { x, y } -> x + y }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [b"max"], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  // What a generic builtin answers is read at its fields' offsets: nothing asks the runtime for a
  // field by name or whether the record holds one.
  assert_eq(has(b"rt_field_p"), [false, false, false, false]);
  assert_eq(has(b"rt_record_has_p"), [false, false, false, false]);
  assert_eq(has(b"builtin_max_p"), [true, true, true, true])
}

test "a record rebuilt from another's fields is written into the constructor that holds it" {
  let src = Bytes::concat_all([
    b"type T = | Con({ name: Bytes, args: List<T> }) | Leaf\n",
    b"fn renamed(t: T, to: Bytes) -> T = match t { Con(c) -> Con({ name: to, args: c.args }), Leaf -> Leaf }\n",
    b"fn rebuilt(t: T) -> T = match t { Con(c) -> Con({ name: c.name, args: c.args.map(|a: T| rebuilt(a)) }), Leaf -> Leaf }\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [b"m.Con", b"m.Leaf"],
    [b"List::map"],
    true,
  );
  assert_eq(out.map(|e: Emitted| e.why), [None, None]);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  // The field copied out of the old record is a word this body holds, so the new record is held
  // back and its cells are written in the constructor: no record is made to be copied in.
  assert_eq(has(b"rt_alloc_p(ctx, 3, "), [false, false]);
  assert_eq(has(b"ply_embed(ctx, "), [false, false])
}

test "what an operation answers and what a clause is handed are read by their types" {
  let src = Bytes::concat_all([
    b"type P = { x: Int, y: Int }\n",
    b"effect store { read held() -> P\n write keep(p: P) -> Unit }\n",
    b"fn summed() -> Int / {store.held} = { let p = store.held(); p.x + p.y }\n",
    b"fn kept(start: P) -> Int = handle { store.keep(start) } with { var seen = 0, store.keep(p) -> { seen = p.x + p.y; }, return u -> seen }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], handler_builtins(), true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None]);
  assert_eq(out.map(|e: Emitted| e.text.index_of(b"rt_field_p") != None), [false, false])
}

fn handler_builtins() -> List<Bytes> = [b"?handler_init", b"?handler_var", b"?handler_set"]

test "what a handler's variable holds is read by its type" {
  let src = Bytes::concat_all([
    b"type Open = { now: Int, mine: List<Int>, held: Int }\n",
    b"effect bump { write by(n: Int) -> Int }\n",
    b"fn bumped(start: Open, by: Int) -> Int = handle { bump.by(by) } with { var st = start, bump.by(n) -> { let o = st; st = { ..o, now: o.now + n }; st.now + o.held } }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], handler_builtins(), true);
  assert_eq(out.map(|e: Emitted| e.why), [None]);
  assert_eq(out.map(|e: Emitted| own_code(e.text).index_of(b"rt_field_p") != None), [false])
}

test "a constructor pattern reads its argument as the subject's type lays it out" {
  let src = Bytes::concat_all([
    b"type P = { x: Int, y: Int }\n",
    b"type E = { why: Bytes }\n",
    b"fn made(n: Int) -> Result<P, E> = if n > 0 { Ok({ x: n, y: n }) } else { Err({ why: b\"low\" }) }\n",
    b"fn found(n: Int) -> Option<P> = if n > 0 { Some({ x: n, y: n }) } else { None }\n",
    b"fn summed(n: Int) -> Int = match made(n) { Ok({ x, y }) -> x + y, Err({ why }) -> why.len() }\n",
    b"fn first(n: Int) -> Int = match made(n) { Ok({ x: 7, y }) -> y, Ok(p) -> p.x, Err(e) -> e.why.len() }\n",
    b"fn either(n: Int) -> Int = match found(n) { Some({ x, y: 3 }) -> x, Some({ x, y }) -> x + y, None -> 0 }\n",
    b"fn held(rs: List<Result<P, E>>) -> Int = match rs.at(0) { Some(Ok({ x, y })) -> x + y, Some(Err({ why })) -> why.len(), None -> 0 }\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [b"Some", b"None", b"Ok", b"Err"],
    [b"List::at", b"Bytes::len"],
    true,
  );
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None, None]);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  // Under `Ok`, `Err` and `Some`, held as a word or as an object, a record is read where its
  // fields lie.
  assert_eq(has(b"rt_field_p"), [false, false, false, false, false, false]);
  assert_eq(has(b"rt_record_has_p"), [false, false, false, false, false, false]);
  assert_eq(has(b"rt_record_fits_p"), [false, false, false, false, false, false]);
  // A constructor's object holds its argument as a word: none is read as a record held in place.
  assert_eq(has(b"(intptr_t)(ply_words("), [false, false, false, false, false, false])
}

test "an Option is its payload's word in the code that knows it, and its object where it leaves" {
  let src = Bytes::concat_all([
    b"fn picked(c: Bool, s: String) -> Int = match if c { Some(s) } else { None } { Some(_) -> 1, None -> 0 }\n",
    b"fn found(xs: List<String>, i: Int) -> String = match xs.at(i) { Some(s) -> s, None -> \"\" }\n",
    b"fn nested(s: String) -> Int = match Some(Some(s)) { Some(Some(_)) -> 2, Some(None) -> 1, None -> 0 }\n",
    b"fn kept(s: String) -> Option<String> = Some(s)\n",
    b"fn held(s: String) -> List<Option<String>> = [Some(s), None]\n",
    b"fn same(a: String, b: String) -> Bool = Some(a) == Some(b)\n",
    b"fn either(c: Bool, s: String, o: Option<String>) -> Option<String> = if c { Some(s) } else { o }\n",
    b"fn guarded(xs: List<Int>) -> Int = match xs.at(0) { Some(n) if n > 1 -> n, Some(1) -> 10, _ -> 0 }\n",
    b"fn asked(o: Option<String>) -> Int = match kept(\"k\") { Some(_) -> 1, None -> 0 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"Some", b"None"], [b"List::at"], true);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None, None, None, None, None]);
  // Nothing reads one as a word or a scalar but through `owned` or `word_of`.
  assert_eq(out.map(|e: Emitted| e.text.index_of(b"ply_maybe_unrouted") != None), [
    false,
    false,
    false,
    false,
    false,
    false,
    false,
    false,
    false,
  ]);
  // Built, matched, handed across a call, answered or compared, no object is made; one stored or
  // nested is made the object it stands for.
  assert_eq(has(b"rt_ctor_p"), [false, false, false, false, false, false, false, false, false]);
  assert_eq(has(b"rt_maybe_take_p"), [false, false, true, false, true, false, false, false, false]);
  assert_eq(has(b"rt_maybe_box_p"), [
    false,
    false,
    false,
    false,
    false,
    false,
    false,
    false,
    false,
  ]);
  assert_eq(has(b"rt_equal_p"), [false, false, false, false, false, false, false, false, false]);
  assert_eq(has(b"rt_list_lookup_p"), [
    false,
    true,
    false,
    false,
    false,
    false,
    false,
    true,
    false,
  ]);
  // It crosses a call as its payload's word, a C type of its own so a stale caller fails the build.
  let maybe = { answer: b"PlyMaybe", params: [b"Word"] };
  assert_eq(out.get(3).tables.symbols.map(|d: Defined| d.head), [maybe]);
  assert_eq(out.get(6).tables.symbols.map(|d: Defined| d.head), [
    { answer: b"PlyMaybe", params: [b"int64_t", b"Word", b"PlyMaybe"] },
  ]);
  assert_eq(out.get(8).tables.generics.expects, [{ callee: b"m.kept", head: maybe }])
}

test "a Result whose error is an object is one word in the code that knows it" {
  let src = Bytes::concat_all([
    // Wider than a record that crosses a call as its fields.
    b"type Bad = { why: Bytes, a: Int, b: Int, c: Int, d: Int }\n",
    b"fn half(n: Int) -> Result<Int, Bad> = if n % 2 == 0 { Ok(n / 2) } else { Err({ why: b\"odd\", a: 0, b: 0, c: 0, d: 0 }) }\n",
    b"fn quarter(n: Int) -> Result<Int, Bad> = { let h = half(n)?; half(h) }\n",
    b"fn told(n: Int) -> Bytes = match quarter(n) { Ok(_) -> b\"\", Err(b) -> b.why }\n",
    b"fn plain(n: Int) -> Result<Int, Int> = if n > 0 { Ok(n) } else { Err(n) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"Ok", b"Err"], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  // Built, answered, handed on by `?` and matched, no object is made; an error that may be an
  // immediate leaves the `Result` an object.
  assert_eq(has(b"rt_ctor_p"), [false, false, false, true]);
  assert_eq(has(b"rt_tagged_"), [false, false, false, false]);
  assert_eq(has(b") | 4)"), [true, true, false, false]);
  assert_eq(has(b" & 7) "), [false, true, true, false])
}

test "a Result whose error is a small record crosses a call as its constructor and the record's fields" {
  let src = Bytes::concat_all([
    b"type Bad = { why: Bytes }\n",
    b"fn half(n: Int) -> Result<Int, Bad> = if n % 2 == 0 { Ok(n / 2) } else { Err({ why: b\"odd\" }) }\n",
    b"fn quarter(n: Int) -> Result<Int, Bad> = { let h = half(n)?; half(h) }\n",
    b"fn told(n: Int) -> Bytes = match quarter(n) { Ok(_) -> b\"\", Err(b) -> b.why }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"Ok", b"Err"], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None]);
  // Built, answered, handed on by `?` and matched as its constructor and the record's fields: no
  // record or `Result` is made, and the error's field is read where it came back.
  assert_eq(has(b"rt_alloc_p"), [false, false, false]);
  assert_eq(has(b"rt_ctor_p"), [false, false, false]);
  assert_eq(has(b"rt_tagged_"), [false, false, false]);
  assert_eq(has(b"rt_field_p"), [false, false, false]);
  assert_eq(has(b"*o1 = "), [true, true, false])
}

test "a record rebuilt from a captured record's fields reads them where they lie, run in place or not" {
  let src = Bytes::concat_all([
    b"type Sp = { start: Int, end: Int, gen: Int }\n",
    b"type C = { own: Int, node: Int, span: Sp }\n",
    b"fn rebuilt(c: C, n: Int) -> C = { let at = |k: Int| { own: 0, node: k, span: c.span }; at(n) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.why), [None]);
  assert_eq(out.map(|e: Emitted| e.text.index_of(b"rt_field_p") != None), [false])
}

test "records of a known type are compared field by field, not by the runtime" {
  let src = Bytes::concat_all([
    b"type R = { at: Int, value: Float, price: Decimal, on: Bool }\n",
    b"fn same(a: R, b: R) -> Bool = a == b\n",
    b"fn differ(a: R, b: R) -> Bool = a != b\n",
    b"fn noted(a: { at: Int, note: Option<Int> }, b: { at: Int, note: Option<Int> }) -> Bool = a == b\n",
    b"fn found(a: Option<R>, b: Option<R>) -> Bool = a == b\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"Some", b"None"], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  // Scalars and a `Decimal` in C, and an `Option`'s payloads at their type where both are `Some`.
  assert_eq(has(b"rt_equal_p"), [false, false, false, false]);
  assert_eq(has(b"rt_decimal_compare_p"), [true, true, false, true]);
  assert_eq(has(b" == 0 || "), [false, false, true, true])
}

test "a value compared with a constructor of its sum is tested as a pattern tests it" {
  let src = Bytes::concat_all([
    b"type TK = | Punct(Bytes) | Num(Int, Float) | Eof\n",
    b"fn punct(k: TK, p: Bytes) -> Bool = k == Punct(p)\n",
    b"fn num(k: TK) -> Bool = k != Num(3, 0.5)\n",
    b"fn eof(k: TK) -> Bool = k == Eof\n",
    b"fn same(a: TK, b: TK) -> Bool = a == b\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [b"m.Punct", b"m.Num", b"m.Eof"],
    [],
    true,
  );
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  // Its tag, then each argument where it holds its own: no constructor is built to be compared.
  assert_eq(has(b"rt_ctor_p"), [false, false, false, false]);
  assert_eq(has(b"rt_ctor_value_p"), [false, false, false, false]);
  assert_eq(has(b"->layout == "), [true, true, true, false]);
  // A bytes argument by its bytes; two values of the sum through the root that compares them.
  assert_eq(has(b"rt_equal_p"), [false, false, false, false]);
  assert_eq(has(b"memcmp(ply_bytes("), [true, false, false, false]);
  assert_eq(has(symbol_of(b"m.TK#eq").concat(b"(ctx, ")), [false, false, false, true])
}

test "two values of a declared sum are compared through a root written from its constructors" {
  let src = Bytes::concat_all([
    b"type TK = | Punct(Bytes) | Num(Int, Float) | Pair(TK, TK) | Eof\n",
    b"fn same(a: TK, b: TK) -> Bool = a == b\n",
  ]);
  let answers = answers_of([b"m"], [src], [b"m.Punct", b"m.Num", b"m.Pair", b"m.Eof"], [
    b"m.same",
    b"m.TK#eq",
  ]);
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if a.name == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b.text,
        Refused(r) -> panic(String::of_bytes_lossy(r.why)),
      },
      None -> panic("no answer"),
    };
  let eq = body(b"m.TK#eq");
  // Each constructor's arguments as their types compare: bytes by their bytes, a `Float` in C, and
  // the sum's own arguments through the same root.
  assert(eq.index_of(b"rt_equal_p") == None, None);
  assert(eq.index_of(b"memcmp(ply_bytes(") != None, None);
  assert(eq.index_of(symbol_of(b"m.TK#eq").concat(b"(ctx, ")) != None, None);
  assert(body(b"m.same").index_of(b"rt_equal_p") == None, None)
}

test "a generic definition comparing its type argument is emitted again at each type it compares" {
  let src = Bytes::concat_all([
    b"type TK = | Punct(Bytes) | Eof\n",
    b"fn same<a>(x: a, y: a) -> Bool = x == y\n",
    b"fn order<a>(x: a, y: a) -> Ordering where derivable(ord, a) = compare(x, y)\n",
    b"fn tokens(k: TK) -> Bool = same(k, Eof)\n",
    b"fn texts(s: String) -> Bool = same(s, \"x\")\n",
  ]);
  let answers = answers_of([b"m"], [src], [b"m.Punct", b"m.Eof", b"Less", b"Equal", b"Greater"], [
    b"m.same",
    b"m.order",
    b"m.tokens",
    b"m.same@m.TK",
    b"m.same@String",
    b"m.order@m.TK",
  ]);
  let tables = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if a.name == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic("no answer"),
    };
  let has = |name: Bytes, text: Bytes| tables(name).text.index_of(text) != None;
  // `==` and `compare` at `a` read which type `a` is, and the call names the whole type.
  assert_eq(tables(b"m.same").tables.generics.needs, [{ var: 0, reads: Exact }]);
  assert_eq(tables(b"m.order").tables.generics.needs, [{ var: 0, reads: Exact }]);
  assert_eq(tables(b"m.tokens").tables.generics.calls, [
    { callee: b"m.same", args: [b"m.TK"], carried: [], fns: [] },
  ]);
  // The generic body stays on the runtime; each specialisation compares as its type does.
  assert(has(b"m.same", b"rt_equal_p"));
  assert(!has(b"m.same@m.TK", b"rt_equal_p"));
  assert(has(b"m.same@m.TK", symbol_of(b"m.TK#eq")));
  assert(!has(b"m.same@String", b"rt_equal_p"));
  assert(has(b"m.same@String", b"memcmp(ply_bytes("));
  assert(has(b"m.order@m.TK", symbol_of(b"m.TK#cmp")))
}

test "two values of a declared sum are ordered through a root written from its constructors" {
  let src = Bytes::concat_all([
    b"type TK = | Punct(Bytes) | Num(Int, Bytes) | Pair(TK, TK) | Eof\n",
    b"fn order(a: TK, b: TK) -> Ordering = compare(a, b)\n",
  ]);
  let answers = answers_of(
    [b"m"],
    [src],
    [b"m.Punct", b"m.Num", b"m.Pair", b"m.Eof", b"Less", b"Equal", b"Greater"],
    [b"m.order", b"m.TK#cmp"],
  );
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if a.name == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b.text,
        Refused(r) -> panic(String::of_bytes_lossy(r.why)),
      },
      None -> panic("no answer"),
    };
  let cmp = body(b"m.TK#cmp");
  // Each argument as its type orders: bytes by their bytes, an `Int` in C, and the sum's own
  // arguments through the same root; nothing goes to the runtime's order.
  assert(cmp.index_of(b"builtin_compare") == None, None);
  assert(cmp.index_of(b"memcmp(ply_bytes(") != None, None);
  assert(cmp.index_of(symbol_of(b"m.TK#cmp").concat(b"(ctx, ")) != None, None);
  assert(body(b"m.order").index_of(symbol_of(b"m.TK#cmp").concat(b"(ctx, ")) != None, None)
}

test "a root written from a type orders and reflects by the language's builtins, whatever its module defines" {
  let src = Bytes::concat_all([
    b"type TK = | Num(Int) | Pair(TK, TK) | Eof\n",
    b"type Named = | Named(Int)\n",
    b"show for Named by shown\n",
    b"fn shown(n: Named) -> String = \"n\"\n",
    b"fn compare<a>(x: a, y: a) -> Ordering = Greater\n",
    b"fn reflect<a>(x: a) -> Int = 0\n",
  ]);
  let named = reflection_root(b"m", true, TyCon({ name: b"m.Named", args: [] }));
  let roots = [
    b"m.TK#cmp",
    reflection_root(b"m", false, TyCon({ name: b"m.TK", args: [] })),
    named,
  ];
  let answers = answers_of(
    [b"m"],
    [src],
    [
      b"m.Num",
      b"m.Pair",
      b"m.Eof",
      b"m.Named",
      b"Less",
      b"Equal",
      b"Greater",
      b"std.value.VUnit",
      b"std.value.VInt",
      b"std.value.VCtor",
      b"std.value.VShown",
    ],
    roots,
  );
  let tables = |root: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if a.name == root { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b.tables,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([root, b": ", r.why]))),
      },
      None -> panic("no answer"),
    };
  [b"m.TK#cmp", reflection_root(b"m", false, TyCon({ name: b"m.TK", args: [] }))].fold(
    (),
    |_: Unit, root: Bytes| {
      assert_eq(tables(root).generics.calls.map(|g: GenericCall| g.callee), []);
      assert(
        !tables(root).calls.contains(b"m.compare") && !tables(root).calls.contains(b"m.reflect"),
        None,
      )
    },
  );
  // The function a type states for `show` is called by its name, whatever builtin that name is.
  assert(tables(named).calls.contains(b"m.shown"), None)
}

test "a sum's constructors read their arguments' types at the sum's arguments" {
  let d = dump_of(
    analyse(parse_all(zip_sources([b"m"], [b"type P<a, b> = | L(a) | R(b, a) | N\n"]))),
  );
  let int = TyCon({ name: b"Int", args: [] });
  let text = TyCon({ name: b"String", args: [] });
  let at = |name: Bytes|
    match ctor_sums(d.ctors).get(name) {
      Some(cs) -> cs.map(|c: SumCtor| c.fields.map(|f: Type| at_args(f, c.params, [int, text]))),
      None -> [],
    };
  assert_eq(at(b"Result"), [[int], [text]]);
  assert_eq(at(b"m.P"), [[int], [text, int], []])
}

test "a value is reflected as its type says: a scalar as its constructor, a sum or a record through a root" {
  let src = Bytes::concat_all([
    b"import std.value (reflect, shown)\n",
    b"type TK = | Punct(Bytes) | Num(Int, U8) | Pair(TK, TK) | Eof\n",
    b"type Dated = | Dated(Int)\n",
    b"show for Dated by dated\n",
    b"fn dated(d: Dated) -> String = \"d\"\n",
    b"fn same(t: TK) -> Bool = reflect(t) == reflect(t)\n",
    b"fn held(p: { a: Int, b: TK }) -> Bool = reflect(p) == reflect(p)\n",
    b"fn told(d: Dated) -> Bool = shown(d) == shown(d)\n",
    b"fn maybe(o: Option<TK>) -> Bool = reflect(o) == reflect(o)\n",
  ]);
  let values = [
    b"VUnit",
    b"VBool",
    b"VInt",
    b"VStr",
    b"VBytes",
    b"VRecord",
    b"VCtor",
    b"VFixed",
    b"VShown",
  ].map(|v: Bytes| b"std.value.".concat(v));
  let sum = reflection_root(b"m", false, TyCon({ name: b"m.TK", args: [] }));
  let record = reflection_root(
    b"m",
    false,
    TyRecord([
      { name: b"a", ty: TyCon({ name: b"Int", args: [] }) },
      { name: b"b", ty: TyCon({ name: b"m.TK", args: [] }) },
    ]),
  );
  let told = reflection_root(b"m", true, TyCon({ name: b"m.Dated", args: [] }));
  let maybe = reflection_root(
    b"m",
    false,
    TyCon({ name: b"Option", args: [TyCon({ name: b"m.TK", args: [] })] }),
  );
  assert_eq([sum, record, told], [
    b"m.reflect#m.TK",
    b"m.reflect#{a:Int,b:m.TK}",
    b"m.shown#m.Dated",
  ]);
  let answers = answers_of(
    [b"m"],
    [src],
    [b"m.Punct", b"m.Num", b"m.Pair", b"m.Eof", b"m.Dated"].concat(values),
    [b"m.same", b"m.held", b"m.told", b"m.maybe", sum, record, told, maybe],
    shipped: [value_fixture()],
  );
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if a.name == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b.text,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic("no answer"),
    };
  let calls = |name: Bytes, root: Bytes|
    body(name).index_of(symbol_of(root).concat(b"(ctx, ")) != None;
  // A sum and a record go to the root that reflects their type, which no runtime reading does.
  assert(calls(b"m.same", sum));
  assert(calls(b"m.held", record));
  assert(calls(b"m.told", told));
  assert(body(sum).index_of(b"builtin_reflect") == None, None);
  // A constructor's name and each argument at its type: bytes and an `Int` as their constructors,
  // a `U8` as its bits, and the sum's own arguments through the same root.
  assert(body(sum).index_of(b"@@Tstd.value.VCtor@@") != None, None);
  assert(body(sum).index_of(b"@@Tstd.value.VBytes@@") != None, None);
  assert(body(sum).index_of(b"@@Tstd.value.VFixed@@") != None, None);
  assert(calls(sum, sum));
  // A record's fields in their names' order, its sum through the sum's root.
  assert(body(record).index_of(b"@@Tstd.value.VRecord@@") != None, None);
  assert(calls(record, sum));
  // An `Option` is handed to its root as the word it crosses a call as, which the root takes it as.
  let tables = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if a.name == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer { Body(b) -> b.tables, Refused(_) -> no_tables() },
      None -> no_tables(),
    };
  assert(calls(b"m.maybe", maybe));
  let expected = tables(b"m.maybe").generics.expects.filter(|x: Expect| x.callee == maybe);
  assert(expected.len() > 0, None);
  assert_eq(
    expected.map(|x: Expect| x.head).at(0),
    tables(maybe).symbols.map(|d: Defined| d.head).at(0),
  );
  // A type whose module states `show` is shown as that function writes it.
  assert(body(told).index_of(b"@@Tstd.value.VShown@@") != None, None);
  assert(body(told).index_of(b"@@Tstd.value.VCtor@@") == None, None)
}

test "a value is digested through a root written for its type, its parts encoded at theirs" {
  let src = Bytes::concat_all([
    b"type TK = | Punct(Bytes) | Pair(TK, TK) | Eof\n",
    b"type Money = | Money(Int, Bytes)\n",
    b"key for Money by cents\n",
    b"fn cents(m: Money) -> Int = match m { Money(c, _) -> c }\n",
    b"fn hashed(t: TK) -> Bytes = digest(t)\n",
    b"fn held(p: { a: Int, b: TK }) -> Bytes = digest(p)\n",
    b"fn priced(m: Money) -> Bytes = digest(m)\n",
  ]);
  let sum = written_root(b"m", b"digest", TyCon({ name: b"m.TK", args: [] }));
  let record = written_root(
    b"m",
    b"digest",
    TyRecord([
      { name: b"a", ty: TyCon({ name: b"Int", args: [] }) },
      { name: b"b", ty: TyCon({ name: b"m.TK", args: [] }) },
    ]),
  );
  let keyed = written_root(b"m", b"digest", TyCon({ name: b"m.Money", args: [] }));
  let answers = answers_of([b"m"], [src], [b"m.Punct", b"m.Pair", b"m.Eof", b"m.Money"], [
    b"m.hashed",
    b"m.held",
    b"m.priced",
    sum,
    record,
    keyed,
  ]);
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if a.name == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic("no answer"),
    };
  let has = |name: Bytes, text: Bytes| body(name).text.index_of(text) != None;
  // The call hashes what the root writes, and the runtime reads no shape.
  [
    { at: b"m.hashed", root: sum },
    { at: b"m.held", root: record },
    { at: b"m.priced", root: keyed },
  ].fold((), |_: Unit, c: { at: Bytes, root: Bytes }| {
    assert(has(c.at, symbol_of(c.root).concat(b"(ctx, ")), None);
    assert(has(c.at, b"builtin_bytes_blake3_p"), None);
    assert(!has(c.at, b"builtin_digest_p"), None)
  });
  // A leaf is the runtime's encoding of it, passed the words `?encoded` is declared to take; the
  // sum's own arguments go through the same root.
  assert(has(sum, b"builtin_elaborated_encoded_p"), None);
  let opened = b"builtin_elaborated_encoded_p(ctx";
  let text = body(sum).text;
  let passed = match text.index_of(opened) {
    None -> 0,
    Some(i) ->
      iterate(
        { at: i + opened.len(), depth: 0, words: 0 },
        text.len(),
        |s: { at: Int, depth: Int, words: Int }| {
          let c = text.at(s.at);
          if c == 41 && s.depth == 0 { Stop(s.words) } else {
            Continue({
              at: s.at + 1,
              depth: if c == 40 { s.depth + 1 } else if c == 41 { s.depth - 1 } else { s.depth },
              words: if c == 44 && s.depth == 0 { s.words + 1 } else { s.words },
            })
          }
        },
      ),
  };
  assert_eq(
    [passed],
    elaborated_natives().filter(|n: Elaborated| n.name == b"?encoded").map(|n: Elaborated| n.words),
  );
  assert(has(sum, symbol_of(sum).concat(b"(ctx, ")), None);
  assert(has(record, symbol_of(sum).concat(b"(ctx, ")), None);
  // A keyed type is its key.
  assert(body(keyed).tables.calls.contains(b"m.cents"), None)
}

test "an array is made, written and listed into as the type of its elements lays it out" {
  let src = Bytes::concat_all([
    b"type R = { name: Bytes, n: Int }\n",
    b"fn made(n: Int, r: R) -> Array<R> / {abort.raise} = Array::new(n, r)\n",
    b"fn put(xs: Array<R>, i: Int, r: R) -> Array<R> / {abort.raise} = xs.set(i, r)\n",
    b"fn listed(xs: List<Int>) -> Array<Int> = Array::of_list(xs)\n",
    b"fn words(n: Int, s: Bytes) -> Array<Bytes> / {abort.raise} = Array::new(n, s)\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [],
    [b"Array::new", b"Array::set", b"Array::of_list"],
    true,
  );
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  // Allocated as an array, a write's copy too, its elements written by the code that knows their
  // type.
  assert_eq(has(b"rt_alloc_p(ctx, 15, "), [true, true, true, true]);
  // A record is copied in place and let go of where it is written over; an `Int` is its bits.
  assert_eq(has(b"ply_embed(ctx, "), [true, true, false, false]);
  assert_eq(has(b"ply_drop_embedded(ctx, "), [false, true, false, false]);
  assert_eq(has(b"rt_list_at_p(ctx, "), [false, false, true, false]);
  // A write is counted in place or into a copy.
  assert_eq(has(b"rt_note_update_p(ctx, "), [false, true, false, false])
}

test "an array of options holds each as its payload's word, and a generic one is made at its type" {
  let src = Bytes::concat_all([
    b"fn opts(xs: List<Option<Bytes>>) -> Array<Option<Bytes>> = Array::of_list(xs)\n",
    b"fn filled<a>(n: Int, x: a) -> Array<a> / {abort.raise} = Array::new(n, x)\n",
    b"fn ints(n: Int) -> Array<Int> / {abort.raise} = filled(n, 7)\n",
  ]);
  let answers = answers_of([b"m"], [src], [], [b"m.opts", b"m.filled", b"m.ints", b"m.filled@Int"]);
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if a.name == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic("no answer"),
    };
  // A list's `Option` is its object; the array holds its payload's word.
  assert(body(b"m.opts").text.index_of(b"rt_maybe_open_p(ctx, ") != None, None);
  // Making an array reads its element's layout, so a generic body is made again at each.
  assert_eq(body(b"m.filled").tables.generics.needs, [{ var: 0, reads: Layout }]);
  assert(body(b"m.filled@Int").text.index_of(b"rt_alloc_p(ctx, 15, ") != None, None)
}

test "a list, an array or a map is compared and digested by roots written for its type" {
  let src = Bytes::concat_all([
    b"type Rec = { name: String, tags: List<Int> }\n",
    b"fn same(a: List<Int>, b: List<Int>) -> Bool = a == b\n",
    b"fn other(a: Array<String>, b: Array<String>) -> Bool = a != b\n",
    b"fn alike(a: Map<Int, List<Int>>, b: Map<Int, List<Int>>) -> Bool = a == b\n",
    b"fn order(a: List<List<Int>>, b: List<List<Int>>) -> Ordering = compare(a, b)\n",
    b"fn held(a: Option<List<Int>>, b: Option<List<Int>>) -> Bool = a == b\n",
    b"fn fields(a: Rec, b: Rec) -> Bool = a == b\n",
    b"fn eq<a>(x: a, y: a) -> Bool = x == y\n",
    b"fn hashed(a: List<Int>) -> Bytes = digest(a)\n",
    b"fn some_int(a: Option<Int>, b: Option<Int>) -> Bool = a == b\n",
    b"fn some_text(a: Option<String>, b: Option<String>) -> Bool = a == b\n",
    b"type Tree<a> = | Leaf(a) | Node(List<Tree<a>>)\n",
    b"fn trees(a: Tree<Int>, b: Tree<Int>) -> Bool = a == b\n",
    b"fn ranked(a: { o: Option<Int>, p: Rec }, b: { o: Option<Int>, p: Rec }) -> Ordering = compare(a, b)\n",
  ]);
  let ints = TyCon({ name: b"List", args: [int_type()] });
  let lists = TyCon({ name: b"List", args: [ints] });
  let map = TyCon({ name: b"Map", args: [int_type(), ints] });
  let entries = TyCon({
    name: b"List",
    args: [TyRecord([{ name: b"key", ty: int_type() }, { name: b"value", ty: ints }])],
  });
  let texts = TyCon({ name: b"Array", args: [string_type()] });
  let trees = TyCon({ name: b"List", args: [TyCon({ name: b"m.Tree", args: [int_type()] })] });
  let written = |op: Bytes, t: Type| written_root(b"m", op, t);
  let roots = [
    b"m.same",
    b"m.other",
    b"m.alike",
    b"m.order",
    b"m.held",
    b"m.fields",
    specialised(b"m.eq", [ints]),
    b"m.hashed",
    written(b"equal_from", ints),
    written(b"equal", map),
    written(b"equal_from", entries),
    written(b"ordered_from", lists),
    written(b"digest", ints),
    written(b"digest_from", ints),
    b"m.trees",
    b"m.Tree<Int>#eq",
    b"m.some_int",
    b"m.some_text",
    written(b"equal_from", texts),
    b"m.ranked",
    written(b"equal", trees),
    written(b"equal_from", trees),
  ];
  let ctors = [b"Less", b"Equal", b"Greater", b"Some", b"None", b"m.Leaf", b"m.Node"];
  let answers = answers_of([b"m"], [src], ctors, roots);
  let body = |name: Bytes|
    match answers.find(|a: RootAnswer| a.name == name) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic("no answer"),
    };
  let written_called = |name: Bytes|
    body(name).tables.calls.filter(|c: Bytes| c.index_of(b"#") != None && c != name);
  assert_eq(roots.map(written_called), [
    [written(b"equal", ints)],
    [written(b"equal", texts)],
    [written(b"equal", map)],
    [written(b"ordered", lists)],
    [written(b"equal", ints)],
    [written(b"equal", ints)],
    [written(b"equal", ints)],
    [written(b"digest", ints)],
    [],
    [written(b"equal_from", entries)],
    [written(b"equal", ints)],
    [written(b"ordered", ints)],
    [written(b"digest_from", ints)],
    [],
    [b"m.Tree<Int>#eq"],
    [
      written(
        b"equal",
        TyCon({ name: b"List", args: [TyCon({ name: b"m.Tree", args: [int_type()] })] }),
      ),
    ],
    [],
    [],
    [],
    [
      written(b"ordered", TyCon({ name: b"Option", args: [int_type()] })),
      written(b"ordered", ints),
    ],
    [written(b"equal_from", trees)],
    [b"m.Tree<Int>#eq"],
  ]);
  // An array is read by the inline `Array::get`, not the prelude's `Array::at`.
  assert_eq(
    body(written(b"equal_from", texts)).tables.calls.filter(|c: Bytes|
      c.index_of(b"Array::at") != None),
    [],
  );
  // Nothing is handed to the runtime to compare, and a walk is a loop.
  assert_eq(
    roots.filter(|n: Bytes|
      own_code(body(n).text).index_of(b"rt_equal_p") != None
        || own_code(body(n).text).index_of(b"builtin_compare") != None),
    [],
  );
  assert_eq(
    [
      written(b"equal_from", ints),
      written(b"equal_from", entries),
      written(b"ordered_from", lists),
      written(b"digest_from", ints),
      written(b"equal_from", texts),
    ].filter(|n: Bytes| own_code(body(n).text).index_of(b"goto ply_loop") == None),
    [],
  )
}

test "strings and byte strings are compared by their bytes where they lie" {
  let src = Bytes::concat_all([
    b"fn same(a: String, b: String) -> Bool = a == b\n",
    b"fn other(a: Bytes, b: Bytes) -> Bool = a != b\n",
    b"fn named(b: Bytes) -> Int = match b { b\"List\" -> 1, b\"Map\" -> 2, _ -> 0 }\n",
    b"fn worded(s: String) -> Int = match s { \"x\" -> 1, _ -> 0 }\n",
    b"fn lettered(c: Char) -> Int = match c { 'a' -> 1, _ -> 0 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None]);
  // A literal pattern compares as `==` at its type does.
  assert_eq(has(b"rt_equal_p"), [false, false, false, false, false]);
  assert_eq(has(b"memcmp(ply_bytes("), [true, true, true, true, false])
}

test "a record holds an Option as its payload's word" {
  let src = Bytes::concat_all([
    b"type Entry = { name: String, note: Option<String> }\n",
    b"fn made(s: String) -> Entry = { name: s, note: Some(s) }\n",
    b"fn noted(e: Entry) -> Int = match e.note { Some(_) -> 1, None -> 0 }\n",
    b"fn cleared(e: Entry) -> Entry = { ..e, note: None }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"Some", b"None"], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None]);
  // Built, read and matched, updated: the field is the payload's word throughout, no object made.
  assert_eq(has(b"rt_maybe_take_p"), [false, false, false]);
  assert_eq(has(b"rt_maybe_box_p"), [false, false, false]);
  assert_eq(has(b"rt_ctor_p"), [false, false, false]);
  // Its shape says so, which is how the runtime reads it.
  assert(
    out.fold(false, |acc: Bool, e: Emitted|
      acc
        || e.tables.shapes.fold(false, |seen: Bool, sh: List<Bytes>|
          seen || sh.contains(b"note!m"))),
    None,
  )
}

test "a constructor holds its arguments as its declaration types them" {
  let src = Bytes::concat_all([
    b"type Point = { x: Float, y: Float }\n",
    b"type Shape = | Circle(Point, Float) | Label(String)\n",
    b"fn circle(at: Point, r: Float) -> Shape = Circle(at, r)\n",
    b"fn radius(s: Shape) -> Float = match s { Circle(_, r) -> r, _ -> 0.0 }\n",
    b"fn centre_x(s: Shape) -> Float = match s { Circle(p, _) -> p.x, _ -> 0.0 }\n",
    b"fn unit(s: Shape) -> Bool = match s { Circle(_, 1.0) -> true, _ -> false }\n",
    b"fn label(s: String) -> Shape = Label(s)\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"m.Circle", b"m.Label"], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None]);
  // A circle holds its point in place, a header's two words and its own two, and its radius's bits
  // after them: five words, none counted, so flat and raw.
  assert_eq(has(b"rt_alloc_p(ctx, 4, 5, @@Tm.Circle@@, 5);"), [true, false, false, false, false]);
  assert_eq(has(b"ply_embedded("), [true, false, false, false, false]);
  assert_eq(has(b"->len == 5)"), [false, true, true, true, false]);
  // A match reads each argument where it is held: the radius a load of its bits, and the point
  // the address of its header in the circle.
  assert_eq(has(b")[4])"), [false, true, true, true, false]);
  assert_eq(has(b") + 0))"), [false, true, true, true, false]);
  // A test of the radius against a literal boxes it to compare it as `==` does.
  assert_eq(has(b"rt_equal_p(ctx, "), [false, false, false, true, false]);
  // A label holds its word, as a constructor of no raw or record argument does.
  assert_eq(has(b"rt_ctor_p"), [false, false, false, false, true])
}

test "a record of ints crosses a call as its fields and is made only where its word is asked for" {
  let src = Bytes::concat_all([
    b"type Span = { start: Int, end: Int }\n",
    b"fn widened(s: Span, by: Int) -> Span = { start: s.start - by, end: s.end + by }\n",
    b"fn width(s: Span) -> Int = s.end - s.start\n",
    b"fn twice(s: Span) -> Int = width(widened(widened(s, 1), 2))\n",
    b"fn kept(s: Span) -> List<Span> = [widened(s, 1)]\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  assert_eq(has(b"rt_alloc_p(ctx, 3, "), [false, false, false, true]);
  assert_eq(out.get(1).tables.symbols.map(|d: Defined| d.head), [
    { answer: b"int64_t", params: [b"int64_t", b"int64_t", b"Word"] },
  ])
}

test "a record literal held in place is written there, with no record made first" {
  let src = Bytes::concat_all([
    b"type T = | TyC({ name: Bytes, args: List<Int> }) | TyV(Int)\n",
    b"type Counter = { next: Int, last: Int }\n",
    b"fn made(n: Bytes, a: List<Int>) -> T = TyC({ name: n, args: a })\n",
    b"fn stepped(v: Int) -> { counter: Counter, at: Int } = { counter: { next: v + 1, last: v }, at: v }\n",
    b"fn copied(h: { c: { tag: Bytes, n: Int } }, v: Int) -> { counter: { tag: Bytes, n: Int }, at: Int } = { counter: h.c, at: v }\n",
    b"fn read(n: { v: Bytes }, a: { v: List<Int> }) -> T = TyC({ name: n.v, args: a.v })\n",
    b"fn held(c: { tag: Bytes, n: Int }, v: Int) -> { counter: { tag: Bytes, n: Int }, at: Int } = { counter: c, at: v }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"m.TyC", b"m.TyV"], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None]);
  // The literal's fields are written in place under a header of their own wherever the holder is
  // made, read out of other records as well, and a record held in place that was made already is
  // copied in. A record answered as its leaves makes no object at all, and no record held in place
  // is made on its own first.
  assert_eq(has(b"ply_embedded("), [true, true, true, true, true]);
  assert_eq(has(b"ply_embed(ctx, "), [false, true, true, false, true]);
  assert_eq(has(b"rt_alloc_p("), [true, false, false, true, false]);
  assert_eq(has(b"rt_alloc_p(ctx, 3, 2, "), [false, false, false, false, false])
}

test "a record holding a small record in place crosses a call as its leaves and each record's word" {
  let src = Bytes::concat_all([
    b"type Holding = { held: List<Int>, places: Map<Bytes, Int>, whole: Map<Bytes, Int> }\n",
    b"fn added(h: Holding, n: Int, key: Bytes) -> { h: Holding, at: Int } = match h.places.get(key) { Some(at) -> { h: h, at: at }, None -> { h: { ..h, held: h.held.push(n), places: h.places.insert(key, h.held.len()) }, at: h.held.len() } }\n",
    b"fn counted(h: Holding, key: Bytes) -> Int = { let p = added(h, 1, key); p.at + p.h.held.len() }\n",
    b"fn kept(h: Holding, key: Bytes) -> List<Holding> = [added(h, 2, key).h]\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [b"Some", b"None"],
    [b"Map::get", b"List::push", b"Map::insert", b"List::len"],
    true,
  );
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None]);
  // The answer and the record it holds are made only where a word of the record held is asked for.
  assert_eq(has(b"rt_alloc_p(ctx, 3, "), [false, false, true]);
  // The holding crosses as its three fields and word, and the answer comes back as its first
  // leaf, `at`, then the holding's fields and word and the answer's word through pointers.
  assert_eq(out.get(0).tables.symbols.map(|d: Defined| d.head), [
    {
      answer: b"int64_t",
      params: [
        b"int64_t",
        b"int64_t",
        b"int64_t",
        b"Word",
        b"int64_t",
        b"Word",
        b"Word*",
        b"Word*",
        b"Word*",
        b"Word*",
        b"Word*",
      ],
    },
  ])
}

test "compare at a number, a character or a string orders in C and answers its constructor" {
  let src = Bytes::concat_all([
    b"fn by_name(a: Bytes, b: Bytes) -> Bool = compare(a, b) == Less\n",
    b"fn by_int(a: Int, b: Int) -> Ordering = compare(a, b)\n",
    b"fn by_text(a: String, b: String) -> Ordering = compare_values(a, b)\n",
    b"fn by_list(a: List<Int>, b: List<Int>) -> Ordering = compare(a, b)\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [b"Less", b"Equal", b"Greater"],
    [b"compare", b"compare_values"],
    true,
  );
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  // None is handed to the runtime: a list is ordered by the prelude's function at its items' type,
  // and the rest answer the constructor the order names, a word no count holds.
  assert_eq(has(b"builtin_compare"), [false, false, false, false]);
  assert_eq(has(b"rt_ctor_value_p(ctx, "), [true, true, true, false]);
  assert_eq(has(b"memcmp(ply_bytes("), [true, false, true, false])
}

test "a `Decimal` is held in registers as its two words, and in a record or an array as them" {
  let src = Bytes::concat_all([
    b"type Line = { price: Decimal, qty: Int }\n",
    b"fn line(price: Decimal, qty: Int) -> Line = { price: price, qty: qty }\n",
    b"fn doubled(l: Line) -> Decimal = l.price * 2.00m\n",
    b"fn cheaper(a: Line, b: Line) -> Bool = a.price < b.price\n",
    b"fn negated(d: Decimal) -> Decimal = -d\n",
    b"fn priced(ds: Array<Decimal>, i: Int) -> Decimal / {abort.raise} = ds.get(i)\n",
    b"fn picked(up: Bool, d: Decimal) -> Decimal = if up { d + 1m } else { d - 1m }\n",
    b"fn listed(d: Decimal) -> List<{ price: Decimal }> = [{ price: d }]\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [b"Array::get"], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None, None, None]);
  // A line holds its price as two words and its count after them, each as its own bits: flat and
  // raw, as a record of a price alone is. It crosses a call as its fields, which an entry handed its
  // word loads and a stack's growth makes it of.
  assert_eq(has(b".lo;"), [true, true, true, false, false, false, true]);
  assert_eq(has(b"@@, 5);"), [true, true, true, false, false, false, true]);
  // A branch's answer is declared as the struct it is before either arm assigns it.
  assert_eq(has(b" = (PlyDec){0, 0};"), [false, false, false, false, false, true, false]);
  // A price's second word is written after its first, in a line and in a record of a price
  // alone, which is held back until it is first a word.
  assert_eq(has(b")[1] = "), [true, true, true, false, false, false, true]);
  // A field read loads both words, an array's element is two words a step, and nothing is boxed:
  // a function takes and answers its decimals as their words.
  assert_eq(has(b"ply_dec_at("), [true, true, true, false, true, false, false]);
  assert_eq(has(b") * 2)"), [false, false, false, false, true, false, false]);
  assert_eq(out.map(|e: Emitted| own_code(e.text).index_of(b"rt_box_decimal_p") != None), [
    false,
    false,
    false,
    false,
    false,
    false,
    false,
  ]);
  // Arithmetic and comparison are the runtime's, over the words, allocating nothing.
  assert_eq(has(b"rt_decimal_binary_p(ctx, 2, "), [false, true, false, false, false, false, false]);
  assert_eq(has(b") < 0)"), [false, false, true, false, false, false, false]);
  assert_eq(has(b"rt_decimal_negate_p"), [false, false, false, true, false, false, false]);
  assert_eq(has(b"rt_binary_p"), [false, false, false, false, false, false, false])
}

