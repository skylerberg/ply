/// Whether a record holds a value of `kind` as its own words rather than as a word: a `Float`, a
/// 64-bit width or a `Decimal`.
fn raw_slot(kind: Kind) -> Bool =
  match kind { KFloat -> true, KDec -> true, KNum(w) -> !in_imm(w), _ -> false }

/// The words a record holds a field of `kind` in: a `Decimal`'s two, and one for any other.
fn raw_words(kind: Kind) -> Int = match kind { KDec -> 2, _ -> 1 }

/// What a record holds `value` in, held at the kind `raw_slot` says it holds as its own words: its
/// word, or for a `Decimal` the local holding its two, which `cells_of` writes apart.
fn raw_word(value: CValue) -> Bytes =
  match value.kind {
    KNum(_) -> bytes_concat_all([b"(Word)(", value.expr, b")"]),
    KDec -> value.expr,
    _ -> bytes_concat_all([b"ply_f64_bits(", as_float(value), b")"]),
  }

/// The field of `kind` that `base` holds as its own words from word `at` on, read as the kind.
fn raw_at(base: Bytes, at: Bytes, kind: Kind) -> Bytes = {
  let word = bytes_concat_all([b"ply_words(", base, b")[", at, b"]"]);
  match kind {
    KNum(w) -> bytes_concat_all([b"(", ctype(KNum(w)), b")(", word, b")"]),
    KDec -> bytes_concat_all([b"ply_dec_at(", base, b", ", at, b")"]),
    _ -> bytes_concat_all([b"ply_f64(", word, b")"]),
  }
}

/// The statement writing `value` over the field of `kind` that `base` holds as its own words from
/// word `at` on.
fn raw_store(base: Bytes, at: Bytes, value: CValue, kind: Kind) -> Bytes =
  match kind {
    KDec -> bytes_concat_all([b"ply_set_dec(", base, b", ", at, b", ", as_dec(value), b");"]),
    _ -> bytes_concat_all([b"ply_words(", base, b")[", at, b"] = ", raw_word(value), b";"]),
  }

/// `value` held at `kind`, a kind `raw_slot` holds of, in a register: a `Decimal` in a local.
fn held_raw(emitter: Emitter, value: CValue, kind: Kind) -> WithValue =
  match kind {
    KNum(w) -> if value.kind == kind { { emitter: emitter, value: value } }
    else { bind(emitter, kind, as_num(value, w)) },
    KDec -> if value.kind == KDec && is_local(value.expr) { { emitter: emitter, value: value } }
    else { bind(emitter, KDec, as_dec(value)) },
    _ -> float_held(emitter, value),
  }

/// The fields of the record a field holds in place: one of a record type, which its record copies
/// into its own words.
fn in_place(f: FieldTy) -> Option<List<FieldTy>> = match f.ty { TyRec(fs) -> Some(fs), _ -> None }

/// Where a record of `fs` holds each field, how many words it holds, the words of the tail a mixed
/// one's bitmap takes after them, and which words it counts: a field takes a word, and a record held
/// in place its header's two, its own and its tail's. `heap::Shapes` lays a shape out alike.
type Laid = { width: Int, tail: Int, offsets: List<Int>, counted: List<Int> }

fn laid_of(fs: List<FieldTy>) -> Laid = {
  let s = fold(
    fs,
    { at: 0, offsets: [], counted: [] },
    |acc: { at: Int, offsets: List<Int>, counted: List<Int> }, f: FieldTy|
      match f.ty {
        TyRec(inner) -> {
          let l = laid_of(inner);
          {
            at: acc.at + 2 + l.width + l.tail,
            offsets: push(acc.offsets, acc.at),
            counted: concat(acc.counted, map(l.counted, |c: Int| acc.at + 2 + c)),
          }
        },
        _ ->
          {
            at: acc.at + raw_words(f.kind),
            offsets: push(acc.offsets, acc.at),
            counted: if raw_slot(f.kind) { acc.counted } else { push(acc.counted, acc.at) },
          },
      },
  );
  let n = len(s.counted);
  {
    width: s.at,
    tail: if n > 0 && n < s.at { (s.at + 63) / 64 } else { 0 },
    offsets: s.offsets,
    counted: s.counted,
  }
}

/// A field as a shape spells it: a `Float` held as its bits after its name, and a record held in
/// place after its name with its own shape's fields, both below every byte a name holds so a shape
/// sorts as its names do.
pub fn spelled_field(f: FieldTy) -> Bytes =
  match f.ty {
    TyRec(inner) ->
      bytes_concat_all([f.name, b"!r(", bytes_join(map(inner, spelled_field), b","), b")"]),
    _ -> match f.kind {
      KFloat -> bytes_concat(f.name, b"!f"),
      KDec -> bytes_concat(f.name, b"!d"),
      KNum(w) -> if raw_slot(f.kind) {
        bytes_concat(f.name, if w.signed { b"!i64" } else { b"!u64" })
      } else { f.name },
      _ -> f.name,
    },
  }

/// A record's flags: flat when none of its words holds a count, mixed when its tail says which
/// do, raw when it holds a `Float`'s bits or a record in place.
fn record_flags(fs: List<FieldTy>, l: Laid) -> Int = {
  let raw = if fold(fs, false, |acc: Bool, f: FieldTy|
      acc || raw_slot(f.kind) || in_place(f) != None) { 4 }
  else { 0 };
  if l.width > 0 && leaves_uncounted(fs) { 1 + raw } else if l.tail > 0 { 2 + raw } else { raw }
}

fn leaves_uncounted(fs: List<FieldTy>) -> Bool =
  fold(fs, true, |acc: Bool, f: FieldTy|
    acc
      && (match f.ty {
        TyRec(inner) -> leaves_uncounted(inner),
        _ -> match f.kind {
          KNum(_) -> true,
          KBool -> true,
          KFloat -> true,
          KDec -> true,
          _ -> false,
        },
      }))

fn has_tail(flags: Int) -> Bool = flags & 2 != 0

/// The bitmap after a mixed record's words: a bit set for each word it counts, 64 to a word.
fn tail_bits(l: Laid) -> List<Bytes> =
  map(range(0, l.tail), |t: Int|
    int_lit(
      fold(l.counted, 0, |acc: Int, c: Int| if c / 64 == t { acc | 1 << c % 64 } else { acc }),
    ))

/// The fields a record written at `at` holds `names` as: read off the type the checker filed there.
/// A record whose type holds a field of a variable's type, in place or not, has none, and is laid
/// out by what its fields hold when it is made.
fn laid_out(emitter: Emitter, at: Span, names: List<Bytes>) -> Option<List<FieldTy>> =
  match map_get(emitter.typed, span_key(at)) {
    None -> None,
    Some(t) -> match kind_of(t.ty).ty {
      TyRec(fs) ->
        Some(
          map(names, |nm: Bytes|
            fold(fs, { name: nm, kind: KBoxed, ty: TyOpen([]) }, |k: FieldTy, f: FieldTy|
              if f.name == nm { f } else { k })),
        ),
      _ -> None,
    },
  }

fn kinds_of(fs: List<FieldTy>) -> List<Kind> = map(fs, |f: FieldTy| f.kind)

fn kind_at(kinds: List<Kind>, at: Int) -> Kind =
  match list_at(kinds, at) { Some(k) -> k, None -> KBoxed }

/// A record of `names` holding `words`, which it takes, laid out by the runtime as a record of the
/// values they are: the layout its type has wherever it is made.
fn record_by_value(emitter: Emitter, names: List<Bytes>, words: List<Bytes>) -> WithValue = {
  let sh = shape_of(emitter, names);
  let arr = fresh(sh.emitter);
  let e = line(
    arr.emitter,
    bytes_concat_all([
      b"Word ",
      arr.name,
      b"[] = {",
      if len(words) == 0 { b"0" } else { bytes_join(words, b", ") },
      b"};",
    ]),
  );
  let o = bind(
    e,
    KBoxed,
    bytes_concat_all([
      b"rt_record_p(ctx, @@s",
      ascii_of_int(sh.i),
      b"@@, (Word)(intptr_t)",
      arr.name,
      b", ",
      ascii_of_int(len(words)),
      b")",
    ]),
  );
  { emitter: check(o.emitter), value: o.value }
}

/// `value` as a `Float` held in a register.
fn float_held(emitter: Emitter, value: CValue) -> WithValue =
  if value.kind == KFloat { { emitter: emitter, value: value } }
  else { bind(emitter, KFloat, as_float(value)) }

/// The shape of a record of `fs`, each shape it holds in place registered before it, which is the
/// order the unit's table and the runtime's interning give them.
fn shape_of_fields(emitter: Emitter, fs: List<FieldTy>) -> { emitter: Emitter, i: Int } = {
  let nested = fold(fs, emitter, |acc: Emitter, f: FieldTy|
    match f.ty { TyRec(inner) -> shape_of_fields(acc, inner).emitter, _ -> acc });
  shape_of(nested, map(fs, spelled_field))
}

/// A word a record being built holds: written at `at`, or for a record held in place copied there
/// whole, with `tail` the words its shape's bitmap takes.
type WordAt = { at: Int, expr: Bytes, tail: Option<Int> }

/// `words` are the record's, one per field in `fields`' order; where `raw_slot` holds of a field's
/// kind its word is a `Float`'s bits, and where the field is held in place it is the record copied
/// there, which the record takes. A flat record of no record in place, built from locals, is held
/// back; others are built now, from a reuse token if one fits.
fn build_record(
  emitter: Emitter,
  names: List<Bytes>,
  words: List<Bytes>,
  fields: List<FieldTy>,
  vals: Option<List<CValue>>,
) -> WithValue = {
  let n = len(names);
  let sh = shape_of_fields(emitter, fields);
  let l = laid_of(fields);
  let flags = record_flags(fields, l);
  let nests = fold(fields, false, |acc: Bool, f: FieldTy| acc || in_place(f) != None);
  let cells = cells_of(fields, words, l, flags);
  let ty = TyRec(fields);
  // What a field held in place was is copied and let go, so only the record's other fields are
  // remembered as values.
  let kept = |vs: List<CValue>|
    fold(
      range(0, n),
      { names: [], vals: [] },
      |acc: { names: List<Bytes>, vals: List<CValue> }, i: Int|
        match list_at(fields, i) {
          Some(f) -> if in_place(f) != None { acc } else {
            match list_at(names, i) {
              Some(nm) -> match list_at(vs, i) {
                Some(v) -> { names: push(acc.names, nm), vals: push(acc.vals, v) },
                None -> acc,
              },
              None -> acc,
            }
          },
          None -> acc,
        },
    );
  match vals {
    Some(vs) -> if flags % 2 == 1 && !nests {
      let f = fresh(sh.emitter);
      let held = line(
        note_deferred(f.emitter, {
          name: f.name,
          shape: sh.i,
          n: l.width,
          flags: flags,
          cells: map(cells, |c: WordAt| { at: c.at, expr: c.expr }),
        }),
        bytes_concat_all([f.name, b" = 0;"]),
      );
      {
        emitter: remember_built(held, f.name, names, vs),
        value: { kind: KBoxed, expr: f.name, ty: ty },
      }
    } else {
      let k = kept(vs);
      built_now(sh.emitter, k.names, cells, 3, shape_text(sh.i), l.width, flags, ty, Some(k.vals))
    },
    None -> built_now(sh.emitter, names, cells, 3, shape_text(sh.i), l.width, flags, ty, None),
  }
}

/// The words an object laid out as a record of `fields` is holds: `words`, one per field, each at
/// its offset, a `Decimal`'s local written as its two words, and the bitmap after them where
/// `flags` says it is mixed.
fn cells_of(fields: List<FieldTy>, words: List<Bytes>, l: Laid, flags: Int) -> List<WordAt> =
  concat(
    fold(range(0, len(fields)), [], |acc: List<WordAt>, i: Int| {
      let f = match list_at(fields, i) {
        Some(x) -> x,
        None -> { name: b"", kind: KBoxed, ty: TyOpen([]) },
      };
      let at = match list_at(l.offsets, i) { Some(o) -> o, None -> i };
      let expr = match list_at(words, i) { Some(w) -> w, None -> b"0" };
      if f.kind == KDec && in_place(f) == None {
        concat(acc, [
          { at: at, expr: bytes_concat(expr, b".lo"), tail: None },
          { at: at + 1, expr: bytes_concat(expr, b".hi"), tail: None },
        ])
      } else {
        push(acc, {
          at: at,
          expr: expr,
          tail: match in_place(f) { Some(inner) -> Some(laid_of(inner).tail), None -> None },
        })
      }
    }),
    if has_tail(flags) {
      let bits = tail_bits(l);
      map(range(0, len(bits)), |t: Int|
        {
          at: l.width + t,
          expr: match list_at(bits, t) { Some(b) -> b, None -> b"0" },
          tail: None,
        })
    } else { [] },
  )

fn shape_text(shape: Int) -> Bytes = bytes_concat_all([b"@@s", ascii_of_int(shape), b"@@"])

/// An object of `kind` (a record's 3, a constructor's 4) and `n` words built of `cells`, its header
/// naming `layout`. A token is taken for a mixed object only when it was one, so it has room for
/// the bitmap.
fn built_now(
  emitter: Emitter,
  names: List<Bytes>,
  cells: List<WordAt>,
  kind: Int,
  layout: Bytes,
  n: Int,
  flags: Int,
  ty: Ty,
  vals: Option<List<CValue>>,
) -> WithValue = {
  let rec = bind(note_tok(emitter, n), KBoxed, b"0");
  let opened = line(
    rec.emitter,
    bytes_concat_all([
      b"if (tok",
      ascii_of_int(n),
      if has_tail(flags) {
        bytes_concat_all([b" && (ply_obj(tok", ascii_of_int(n), b")->flags & PLY_MIXED)"])
      } else { b"" },
      b") {",
    ]),
  );
  let took = line(
    line(
      indent(opened),
      bytes_concat_all([
        rec.value.expr,
        b" = tok",
        ascii_of_int(n),
        b"; tok",
        ascii_of_int(n),
        b" = 0;",
      ]),
    ),
    bytes_concat_all([
      b"ply_obj(",
      rec.value.expr,
      b")->rc = 1; ply_obj(",
      rec.value.expr,
      b")->kind = ",
      ascii_of_int(kind),
      b"; ply_obj(",
      rec.value.expr,
      b")->flags = ",
      ascii_of_int(flags),
      b"; ply_obj(",
      rec.value.expr,
      b")->len = ",
      ascii_of_int(n),
      b"; ply_obj(",
      rec.value.expr,
      b")->layout = ",
      layout,
      b";",
    ]),
  );
  let made = check(
    line(
      indent(line(outdent(took), b"} else {")),
      bytes_concat_all([
        rec.value.expr,
        b" = rt_alloc_p(ctx, ",
        ascii_of_int(kind),
        b", ",
        ascii_of_int(n),
        b", ",
        layout,
        b", ",
        ascii_of_int(flags),
        b");",
      ]),
    ),
  );
  let closed = line(outdent(made), b"}");
  // Words are written before a record is copied in place: copying lets the copied record go.
  let stored = fold(
    concat(filter(cells, |c: WordAt| c.tail == None), filter(cells, |c: WordAt| c.tail != None)),
    closed,
    |acc: Emitter, c: WordAt|
      line(acc, match c.tail {
        None ->
          bytes_concat_all([
            b"ply_words(",
            rec.value.expr,
            b")[",
            ascii_of_int(c.at),
            b"] = ",
            c.expr,
            b";",
          ]),
        Some(t) ->
          bytes_concat_all([
            b"ply_embed(ctx, ",
            rec.value.expr,
            b", ",
            ascii_of_int(c.at),
            b", ",
            c.expr,
            b", ",
            ascii_of_int(t),
            b");",
          ]),
      }),
  );
  let kept = match vals {
    Some(vs) -> remember_built(stored, rec.value.expr, names, vs),
    None -> stored,
  };
  {
    emitter: note_made(kept, rec.value.expr),
    value: { kind: KBoxed, expr: rec.value.expr, ty: ty },
  }
}

/// A constructor with arguments, built in this body's reuse token for its width when it holds one;
/// a token may be a record's cells or another constructor's, so the header is written whole.
fn ctor_built(emitter: Emitter, tag: Int, words: List<Bytes>) -> WithValue / {abort.raise} = {
  let n = len(words);
  let tok = bytes_concat(b"tok", ascii_of_int(n));
  let made = bind(note_tok(emitter, n), KBoxed, b"0");
  let r = made.value.expr;
  let flat = bytes_join(
    map(words, |w: Bytes| bytes_concat_all([b"ply_is_imm(", w, b")"])),
    b" && ",
  );
  let took = line(
    line(
      indent(line(made.emitter, bytes_concat_all([b"if (", tok, b") {"]))),
      bytes_concat_all([r, b" = ", tok, b"; ", tok, b" = 0;"]),
    ),
    bytes_concat_all([
      b"ply_obj(",
      r,
      b")->rc = 1; ply_obj(",
      r,
      b")->kind = 4; ply_obj(",
      r,
      b")->flags = (",
      flat,
      b") ? 1 : 0; ply_obj(",
      r,
      b")->len = ",
      ascii_of_int(n),
      b"; ply_obj(",
      r,
      b")->layout = ",
      tag_text(emitter, tag),
      b";",
    ]),
  );
  let stored = fold(range(0, n), took, |acc: Emitter, at: Int|
    line(
      acc,
      bytes_concat_all([
        b"ply_words(",
        r,
        b")[",
        ascii_of_int(at),
        b"] = ",
        match list_at(words, at) { Some(w) -> w, None -> b"0" },
        b";",
      ]),
    ));
  let arr = fresh(indent(line(outdent(stored), b"} else {")));
  let called = check(
    line(
      line(
        arr.emitter,
        bytes_concat_all([b"Word ", arr.name, b"[] = {", bytes_join(words, b", "), b"};"]),
      ),
      bytes_concat_all([
        r,
        b" = rt_ctor_p(ctx, ",
        tag_text(emitter, tag),
        b", (Word)(intptr_t)",
        arr.name,
        b", ",
        ascii_of_int(n),
        b");",
      ]),
    ),
  );
  {
    emitter: note_made(line(outdent(called), b"}"), r),
    value: { kind: KBoxed, expr: r, ty: TyOpen([]) },
  }
}

/// A constructor whose declaration lays its arguments out as `fields`, built of `words`: a raw
/// argument's bits and a record held in place, which it takes, as a record of `fields` holds them.
fn ctor_laid(
  emitter: Emitter,
  tag: Int,
  fields: List<FieldTy>,
  words: List<Bytes>,
) -> WithValue / {abort.raise} = {
  let l = laid_of(fields);
  let flags = record_flags(fields, l);
  built_now(
    emitter,
    [],
    cells_of(fields, words, l, flags),
    4,
    tag_text(emitter, tag),
    l.width,
    flags,
    TyOpen([]),
    None,
  )
}

/// How constructor `tag` holds its arguments, where its declaration lays one out other than as its
/// word; `None` where it holds each as its word.
fn ctor_fields(emitter: Emitter, tag: Int) -> Option<List<FieldTy>> =
  match list_at(emitter.ctors.names, tag) {
    Some(name) -> map_get(emitter.ctors.laid, name),
    None -> None,
  }

/// The words a constructor object of `tag` with `arity` arguments holds.
fn ctor_width(emitter: Emitter, tag: Int, arity: Int) -> Int =
  match ctor_fields(emitter, tag) { Some(fs) -> laid_of(fs).width, None -> arity }

/// Like `bind`, keeping the value's shape so a record's fields survive block boundaries.
fn bind_keeping(emitter: Emitter, k: Kind, ty: Ty, expr: Bytes) -> WithValue = {
  let o = bind(emitter, k, expr);
  { emitter: o.emitter, value: { kind: o.value.kind, expr: o.value.expr, ty: ty } }
}

/// A local name (`t12`, `p0`, `q1`) rather than an expression.
fn is_local(e: Bytes) -> Bool =
  bytes_len(e) > 1 && (bytes_at(e, 0) == 116 || bytes_at(e, 0) == 112 || bytes_at(e, 0) == 113)
    && fold(range(1, bytes_len(e)), true, |acc: Bool, i: Int|
      acc && bytes_at(e, i) >= 48 && bytes_at(e, i) <= 57)

/// The parameter whose word `value` is, followed through renames and moves.
fn param_of(emitter: Emitter, value: CValue, params: List<EmitParam>) -> Option<Int> = {
  let root = root_of(emitter, value.expr);
  if bytes_len(root) < 2 || bytes_at(root, 0) != 112
      || !fold(range(1, bytes_len(root)), true, |ok: Bool, i: Int|
        ok && bytes_at(root, i) >= 48 && bytes_at(root, i) <= 57) { None } else {
    let i = digits(bytes_slice(root, 1, bytes_len(root)));
    if i < len(params) { Some(i) } else { None }
  }
}

fn note_generics(emitter: Emitter, g: Generics) -> Emitter = { ..emitter, generics: g }

fn root_of(emitter: Emitter, local: Bytes) -> Bytes =
  fold(emitter.alias, local, |acc: Bytes, a: { local: Bytes, root: Bytes }|
    if a.local == local { a.root } else { acc })

fn note_alias(emitter: Emitter, local: Bytes, root: Bytes) -> Emitter =
  {
    out: emitter.out,
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: emitter.built,
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: emitter.released,
    reuse_widths: emitter.reuse_widths,
    alias: push(emitter.alias, { local: local, root: root }),
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred,
    deferred_locals: emitter.deferred_locals,
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
  }

/// Charge a slot's reads to the object the local holds, once per (object, slot).
fn charge(emitter: Emitter, slot: Int, local: Bytes) -> Emitter = {
  let r = root_of(emitter, local);
  let already = fold(emitter.by_root, false, |acc: Bool, e: { root: Bytes, n: Int }|
    acc || e.root == bytes_concat_all([r, b"#", ascii_of_int(slot)]));
  if already { emitter } else {
    {
      out: emitter.out,
      temp_count: emitter.temp_count,
      unboxed: emitter.unboxed,
      indent: emitter.indent,
      reads: emitter.reads,
      shapes: emitter.shapes,
      built: emitter.built,
      module: emitter.module,
      base: emitter.base,
      count_locals: emitter.count_locals,
      here: emitter.here,
      imports: emitter.imports,
      consts: emitter.consts,
      ctors: emitter.ctors,
      lambda_bodies: emitter.lambda_bodies,
      lambdas: emitter.lambdas,
      owner: emitter.owner,
      builtins: emitter.builtins,
      called_builtins: emitter.called_builtins,
      fields: emitter.fields,
      released: emitter.released,
      reuse_widths: emitter.reuse_widths,
      alias: emitter.alias,
      by_root: push(
        push(emitter.by_root, { root: bytes_concat_all([r, b"#", ascii_of_int(slot)]), n: 0 }),
        { root: r, n: list::count(emitter.reads, |y: Int| y == slot) },
      ),
      tail: emitter.tail,
      calls: emitter.calls,
      generics: emitter.generics,
      refused: emitter.refused,
      deferred: emitter.deferred,
      deferred_locals: emitter.deferred_locals,
      performs: emitter.performs,
      handles: emitter.handles,
      landing: emitter.landing,
      effects: emitter.effects,
      release: emitter.release,
      pinned: emitter.pinned,
      bound: emitter.bound,
      group: emitter.group,
      operands: emitter.operands,
      typed: emitter.typed,
      answer: emitter.answer,
      site_root: emitter.site_root,
      lent: emitter.lent,
      written: emitter.written,
    }
  }
}

fn reads_of_root(emitter: Emitter, local: Bytes) -> Int = {
  let r = root_of(emitter, local);
  fold(emitter.by_root, 0, |acc: Int, e: { root: Bytes, n: Int }|
    if e.root == r { acc + e.n } else { acc })
}

fn built_of(emitter: Emitter, local: Bytes) -> Option<Built> =
  fold(emitter.built, None, |acc: Option<Built>, b: Built|
    if b.local == local { Some(b) } else { acc })

/// Only a runtime helper's result hands over its count, a builtin's among them; a compiled call's result is duplicated before it is handed on.
fn answers_owned(emitter: Emitter, expr: Bytes) -> Bool =
  bytes_starts_with(expr, b"rt_") || bytes_starts_with(expr, b"builtin_")
    || (emitter.release
    && ((bytes_len(expr) > 4 && bytes_slice(expr, 0, 4) == b"ply_" && calls_with_ctx(expr))
    || (

      // A generic call names its root by a placeholder the unit settles: a compiled call all the same.
      bytes_starts_with(expr, b"@@g")
    && calls_with_ctx(expr))
    || (bytes_len(expr) > 13 && bytes_slice(expr, 0, 13) == b"(ply_fits_imm")))

/// A compiled call `ply_<name>(ctx, ...)`, told from a load or immediate by what follows the first parenthesis.
fn calls_with_ctx(expr: Bytes) -> Bool = {
  let p = bytes_scan_until(expr, 0, b"(", bytes_len(expr));
  p + 4 <= bytes_len(expr) && bytes_slice(expr, p, p + 4) == b"(ctx"
}

fn note_made(emitter: Emitter, name: Bytes) -> Emitter =
  { ..emitter, count_locals: push(emitter.count_locals, { name: name, indent: emitter.indent }) }

/// A refusal: the first reason is kept, and emission runs out on a placeholder value.
fn poison(emitter: Emitter, why: Bytes) -> Emitter =
  match emitter.refused {
    Some(_) -> emitter,
    None ->
      {
        out: emitter.out,
        temp_count: emitter.temp_count,
        unboxed: emitter.unboxed,
        indent: emitter.indent,
        reads: emitter.reads,
        shapes: emitter.shapes,
        built: emitter.built,
        module: emitter.module,
        base: emitter.base,
        count_locals: emitter.count_locals,
        here: emitter.here,
        imports: emitter.imports,
        consts: emitter.consts,
        ctors: emitter.ctors,
        lambda_bodies: emitter.lambda_bodies,
        lambdas: emitter.lambdas,
        owner: emitter.owner,
        builtins: emitter.builtins,
        called_builtins: emitter.called_builtins,
        fields: emitter.fields,
        released: emitter.released,
        reuse_widths: emitter.reuse_widths,
        alias: emitter.alias,
        by_root: emitter.by_root,
        tail: emitter.tail,
        calls: emitter.calls,
        generics: emitter.generics,
        refused: Some(why),
        deferred: emitter.deferred,
        deferred_locals: emitter.deferred_locals,
        performs: emitter.performs,
        handles: emitter.handles,
        landing: emitter.landing,
        effects: emitter.effects,
        release: emitter.release,
        pinned: emitter.pinned,
        bound: emitter.bound,
        group: emitter.group,
        operands: emitter.operands,
        typed: emitter.typed,
        answer: emitter.answer,
        site_root: emitter.site_root,
        lent: emitter.lent,
        written: emitter.written,
      },
  }

fn refused(emitter: Emitter, why: Bytes) -> WithValue =
  { emitter: poison(emitter, why), value: { kind: KBoxed, expr: b"0", ty: TyOpen([]) } }

/// The index a symbol takes in this body's code table, added on first use.
fn lambda_of(emitter: Emitter, sym: Bytes) -> { emitter: Emitter, i: Int } =
  match fold(range(0, len(emitter.lambdas)), None, |acc: Option<Int>, i: Int|
      match list_at(emitter.lambdas, i) {
        Some(x) -> if x == sym { Some(i) } else { acc },
        None -> acc,
      }) {
    Some(i) -> { emitter: emitter, i: i },
    None ->
      {
        emitter: {
          out: emitter.out,
          temp_count: emitter.temp_count,
          unboxed: emitter.unboxed,
          indent: emitter.indent,
          reads: emitter.reads,
          shapes: emitter.shapes,
          built: emitter.built,
          module: emitter.module,
          base: emitter.base,
          count_locals: emitter.count_locals,
          here: emitter.here,
          imports: emitter.imports,
          consts: emitter.consts,
          ctors: emitter.ctors,
          lambda_bodies: emitter.lambda_bodies,
          lambdas: push(emitter.lambdas, sym),
          owner: emitter.owner,
          builtins: emitter.builtins,
          called_builtins: emitter.called_builtins,
          fields: emitter.fields,
          released: emitter.released,
          reuse_widths: emitter.reuse_widths,
          alias: emitter.alias,
          by_root: emitter.by_root,
          tail: emitter.tail,
          calls: emitter.calls,
          generics: emitter.generics,
          refused: emitter.refused,
          deferred: emitter.deferred,
          deferred_locals: emitter.deferred_locals,
          performs: emitter.performs,
          handles: emitter.handles,
          landing: emitter.landing,
          effects: emitter.effects,
          release: emitter.release,
          pinned: emitter.pinned,
          bound: emitter.bound,
          group: emitter.group,
          operands: emitter.operands,
          typed: emitter.typed,
          answer: emitter.answer,
          site_root: emitter.site_root,
          lent: emitter.lent,
          written: emitter.written,
        },
        i: len(emitter.lambdas),
      },
  }

fn note_call(emitter: Emitter, full: Bytes) -> Emitter =
  {
    out: emitter.out,
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: emitter.built,
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: emitter.released,
    reuse_widths: emitter.reuse_widths,
    alias: emitter.alias,
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: push(emitter.calls, full),
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred,
    deferred_locals: emitter.deferred_locals,
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
  }

fn spend_made(emitter: Emitter, name: Bytes) -> Emitter =
  {
    ..emitter,
    count_locals: fold(emitter.count_locals, [], |acc: List<CountLocal>, m: CountLocal|
      if m.name == name { acc } else { push(acc, m) }),
  }

fn is_made(emitter: Emitter, name: Bytes) -> Bool =
  fold(emitter.count_locals, false, |acc: Bool, m: CountLocal| acc || m.name == name)

fn is_bound(emitter: Emitter, name: Bytes) -> Bool =
  fold(emitter.bound, false, |acc: Bool, b: Bytes| acc || b == name)

fn is_pinned(emitter: Emitter, name: Bytes) -> Bool =
  fold(emitter.pinned, false, |acc: Bool, p: Bytes| acc || p == name)

/// A count a consumer may take in place: held by a local no slot names and no loop pins.
fn spendable(emitter: Emitter, name: Bytes) -> Bool =
  is_made(emitter, name) && !is_bound(emitter, name) && !is_pinned(emitter, name)

/// Holders are tracked only under release; otherwise every count lives until the entry ends.
fn note_holder(emitter: Emitter, name: Bytes) -> Emitter =
  if emitter.release { note_made(emitter, name) } else { emitter }

fn note_bound(emitter: Emitter, name: Bytes) -> Emitter =
  { ..emitter, bound: push(emitter.bound, name) }

/// Pinned for a fused loop body: its text runs once per iteration, so a "last use" mark is about text, not execution.
fn pin_all(emitter: Emitter) -> Emitter =
  {
    ..emitter,
    pinned: fold(emitter.count_locals, emitter.pinned, |acc: List<Bytes>, m: CountLocal|
      push(acc, m.name)),
  }

fn with_pinned(emitter: Emitter, pinned: List<Bytes>) -> Emitter = { ..emitter, pinned: pinned }

fn with_made(emitter: Emitter, made: List<CountLocal>) -> Emitter =
  { ..emitter, count_locals: made }

/// Held after either of two paths; released at scope end, where the path that spent it left it null.
fn union_made(a: List<CountLocal>, b: List<CountLocal>) -> List<CountLocal> =
  fold(b, a, |acc: List<CountLocal>, m: CountLocal|
    if fold(acc, false, |seen: Bool, x: CountLocal| seen || x.name == m.name) { acc }
    else { push(acc, m) })

/// Releases holders at depth `from` or deeper; a `break` passes the loop's depth.
fn release_at(emitter: Emitter, from: Int) -> Emitter = release_at_except(emitter, from, [])

/// As `release_at`, but the holders named in `skip` are left held. A self tail call restarts with
/// what the *pass* holds released, and a parameter a prologue converted -- an `Int` or `Bool`
/// unboxed at entry, so the body reads the converted local and never the raw word again -- is the
/// call's, not the pass's: releasing it here as well would free a boxed `Int` on the first restart
/// and again on the way out. Skipped, it is released once, by the epilogue or by whichever return
/// path the body takes.
fn release_at_except(emitter: Emitter, from: Int, skip: List<Bytes>) -> Emitter =
  if !emitter.release { emitter } else {
    let out: Emitter = fold(emitter.count_locals, emitter, |acc: Emitter, m: CountLocal|
      if m.indent >= from && !contains(skip, m.name) {
        line(acc, bytes_concat_all([b"ply_dec(ctx, ", m.name, b");"]))
      } else { acc });
    {
      ..out,
      count_locals: fold(emitter.count_locals, [], |acc: List<CountLocal>, m: CountLocal|
        if m.indent >= emitter.indent && !contains(skip, m.name) { acc } else { push(acc, m) }),
    }
  }

fn close(emitter: Emitter) -> Emitter = line(outdent(release_at(emitter, emitter.indent)), b"}")

/// At a slot's `Owned` read the local is moved to a fresh name and nulled, so the scope's release
/// skips it. A held-back record moves held back: the fresh name takes its cells and the values it was
/// built from, and is made only when its word is asked for.
fn move_read(emitter: Emitter, own: Own, value: CValue) -> WithValue =
  if !emitter.release || own != Owned || !counted(value.kind) || !is_made(emitter, value.expr)
      || is_pinned(emitter, value.expr) { { emitter: emitter, value: value } } else {
    match deferred_of(emitter, value.expr) {
      Some(d) -> {
        let f = fresh(emitter);
        let held = line(
          note_deferred(f.emitter, { ..d, name: f.name }),
          bytes_concat_all([f.name, b" = ", value.expr, b"; ", value.expr, b" = 0;"]),
        );
        let kept = match built_of(held, value.expr) {
          Some(b) -> remember_built(held, f.name, b.names, b.vals),
          None -> held,
        };
        {
          emitter: spend_made(kept, value.expr),
          value: { kind: KBoxed, expr: f.name, ty: value.ty },
        }
      },
      None -> {
        let b = bind_keeping(emitter, value.kind, value.ty, value.expr);
        {
          emitter: note_made(
            line(spend_made(b.emitter, value.expr), bytes_concat_all([value.expr, b" = 0;"])),
            b.value.expr,
          ),
          value: { kind: value.kind, expr: b.value.expr, ty: value.ty },
        }
      },
    }
  }

/// A local a slot will name must hold its own count: taken over from a temporary, or added.
fn ensure_owned(emitter: Emitter, value: CValue) -> Emitter =
  if !emitter.release || !counted(value.kind) || is_made(emitter, value.expr) { emitter }
  else { note_made(line(emitter, bytes_concat_all([b"ply_inc(", value.expr, b");"])), value.expr) }

/// After `target = word;` the target holds a count: a temporary's moves, a shared name's is duplicated, an expression's is fresh.
fn assign_owned(emitter: Emitter, target: Bytes, c: Bytes) -> Emitter =
  if !emitter.release { emitter }
  else if spendable(emitter, c) { line(spend_made(emitter, c), bytes_concat_all([c, b" = 0;"])) }
  else if is_local(c) { line(emitter, bytes_concat_all([b"ply_inc(", target, b");"])) }
  else { emitter }

/// A statement's unused value, released where it is.
fn drop_value(emitter: Emitter, value: CValue) -> Emitter =
  if emitter.release && counted(value.kind) && spendable(emitter, value.expr) {
    line(
      spend_made(emitter, value.expr),
      bytes_concat_all([b"ply_dec(ctx, ", value.expr, b"); ", value.expr, b" = 0;"]),
    )
  } else { emitter }

/// The returned word is owned by the caller; under release everything else the body holds is released first.
fn returned(emitter: Emitter, value: CValue) -> { emitter: Emitter, expr: Bytes } =
  if !emitter.release { word_of(emitter, value) } else {
    let r = owned(emitter, value);
    { emitter: release_at(r.emitter, 0), expr: r.value.expr }
  }

/// Aggregate elements are held as `Word` locals: a list is built from an array of words.
fn sets_bound(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  i: Int,
  acc: List<CValue>,
) -> Option<{ emitter: Emitter, vals: List<CValue> }> / {abort.raise} =
  if i >= len(codes) { Some({ emitter: emitter, vals: acc }) } else {
    match list_at(codes, i) {
      None -> None,
      Some(x) -> match expr(notail(emitter), x, params) {
        None -> None,
        Some(o) -> {
          let b = bind_keeping(o.emitter, o.value.kind, o.value.ty, o.value.expr);
          let s = secure(b.emitter, b.value);
          sets_bound(s.emitter, codes, params, i + 1, push(acc, s.value))
        },
      },
    }
  }

fn set_value(sets: List<CodeField>, vals: List<CValue>, name: Bytes) -> Option<CValue> =
  fold(range(0, len(sets)), None, |acc: Option<CValue>, i: Int|
    match list_at(sets, i) {
      Some(f) -> if f.name == name { list_at(vals, i) } else { acc },
      None -> acc,
    })

/// A `Word` local holding an expression, without taking a count for it.
fn bind_word_of(emitter: Emitter, e: Bytes) -> WithValue = {
  let f = fresh(emitter);
  {
    emitter: line(f.emitter, bytes_concat_all([b"Word ", f.name, b" = ", e, b";"])),
    value: { kind: KBoxed, expr: f.name, ty: TyOpen([]) },
  }
}

fn bind_word(emitter: Emitter, value: CValue) -> WithValue = {
  let w = word_of(emitter, value);
  let f = fresh(w.emitter);
  {
    emitter: line(f.emitter, bytes_concat_all([b"Word ", f.name, b" = ", w.expr, b";"])),
    value: { kind: KBoxed, expr: f.name, ty: TyOpen([]) },
  }
}

/// Duplicate a word before a callee takes it; scalars are immediates and hold no count. An `Option`
/// held as its payload's word is made the object it stands for, which takes that payload's count.
fn owned(emitter: Emitter, value: CValue) -> WithValue =
  if value.kind == KMaybe {
    let payload = owned_word(emitter, { ..value, kind: KBoxed });
    let boxed = bind(
      payload.emitter,
      KBoxed,
      bytes_concat_all([b"rt_maybe_take_p(ctx, ", payload.value.expr, b")"]),
    );
    owned_word(boxed.emitter, boxed.value)
  } else { owned_word(emitter, value) }

/// `value`, an `Option` as its object or as its payload's word, as its payload's word with a count
/// this scope hands on.
fn maybe_owned(emitter: Emitter, value: CValue) -> WithValue =
  if value.kind == KMaybe {
    let w = owned_word(emitter, { ..value, kind: KBoxed });
    { emitter: w.emitter, value: { ..w.value, kind: KMaybe } }
  } else {
    // The object is taken, so one this scope holds alone hands its payload over without a copy.
    let w = owned(emitter, value);
    let opened = bind(
      w.emitter,
      KMaybe,
      bytes_concat_all([b"rt_maybe_open_p(ctx, ", w.value.expr, b")"]),
    );
    let o = owned_word(opened.emitter, { ..opened.value, kind: KBoxed });
    { emitter: o.emitter, value: { ..o.value, kind: KMaybe } }
  }

fn owned_word(emitter: Emitter, value: CValue) -> WithValue = {
  let spend = if emitter.release { spendable(emitter, value.expr) }
  else { is_made(emitter, value.expr) };
  let w = bind_word(if spend { spend_made(emitter, value.expr) } else { emitter }, value);
  match value.kind {
    KBoxed -> if spend {
      if emitter.release {
        { emitter: line(w.emitter, bytes_concat_all([value.expr, b" = 0;"])), value: w.value }
      } else { w }
    } else if emitter.release && answers_owned(emitter, value.expr) { w } else {
      {
        emitter: line(w.emitter, bytes_concat_all([b"ply_inc(", w.value.expr, b");"])),
        value: w.value,
      }
    },
    _ -> w,
  }
}

/// Stores the source place before a call that can fail, as bytes from the root's definition so the C does not change
/// when the definition moves; a synthesized node (empty span) has none.
fn site(emitter: Emitter, span: Span) -> Emitter =
  if span.end <= span.start { emitter } else {
    line(
      emitter,
      bytes_concat_all([
        b"PLY_SITE(ctx, ",
        site_key(emitter),
        b", ",
        ascii_of_int(span.start - emitter.base),
        b", ",
        ascii_of_int(span.end - emitter.base),
        b");",
      ]),
    )
  }

/// The placeholder the driver resolves to this body's root: a group member's is numbered by its case.
fn root_key(emitter: Emitter) -> Bytes =
  match position_of(emitter.group, emitter.owner) {
    None -> b"r",
    Some(i) -> bytes_concat(b"r", ascii_of_int(i)),
  }

/// The root id the sites of this body are filed under: the placeholder the unit resolves to this
/// root's, or another root's id outright.
fn site_key(emitter: Emitter) -> Bytes =
  match emitter.site_root {
    Some(r) -> ascii_of_int(root_id(r)),
    None -> bytes_concat_all([b"@@", root_key(emitter), b"@@"]),
  }

/// The id a body's failure sites name their root by: a digest of its name, so a body's C does not
/// depend on which other roots the unit holds. Non-negative, since the C stores it in an `int64_t`.
pub fn root_id(name: Bytes) -> Int = {
  let h = bytes_blake3(name);
  let low = match u32_at(h, 0) { Some(v) -> v, None -> 0 };
  let high = match u32_at(h, 4) { Some(v) -> v, None -> 0 };
  high << 31 | low >>> 1
}

fn position_of(xs: List<Bytes>, x: Bytes) -> Option<Int> =
  fold(range(0, len(xs)), None, |acc: Option<Int>, i: Int|
    match acc { Some(_) -> acc, None -> if list_at(xs, i) == Some(x) { Some(i) } else { None } })

fn check(emitter: Emitter) -> Emitter =
  line(emitter, bytes_concat(b"if (ctx->failed) ", leaving(emitter)))

/// The statement a body leaves by once the context has failed. Inside a `handle` body it jumps to the handle,
/// which pops its frame and answers a raise bound for it; a `return` there would leave both undone.
fn leaving(emitter: Emitter) -> Bytes =
  match emitter.landing {
    None -> failing_return(emitter.answer),
    Some(l) -> bytes_concat_all([b"goto ", l, b";"]),
  }

/// How a root whose answer is carried as `k` returns once the context has failed.
fn failing_return(k: Kind) -> Bytes = bytes_concat_all([b"return ", zero_of(k), b";"])

fn as_int(value: CValue) -> Bytes =
  match value.kind {
    KInt -> value.expr,
    KMaybe -> b"ply_maybe_unrouted",
    KBool -> value.expr,
    KNum(_) -> bytes_concat_all([b"(int64_t)(", value.expr, b")"]),
    KFloat -> bytes_concat_all([b"rt_unbox_int_p(ctx, ", as_word(value), b")"]),
    KDec -> bytes_concat_all([b"rt_unbox_int_p(ctx, ", as_word(value), b")"]),
    KBoxed ->
      bytes_concat_all([
        b"(ply_is_imm(",
        value.expr,
        b") ? ply_imm_value(",
        value.expr,
        b") : rt_unbox_int_p(ctx, ",
        value.expr,
        b"))",
      ]),
  }

/// Releases a record at its last use into a reuse token. Guards: the base is a bare variable marked `Owned`, and
/// exactly one name reads the object, counted over the whole body since reads are not emitted in marking order.
fn release_base(
  emitter: Emitter,
  base: Code,
  value: CValue,
  params: List<EmitParam>,
) -> Option<Emitter> = release_from(emitter, base, value, params, false)

/// `at_tail` skips the one-read guard: nothing is emitted after the node, so no later read can exist.
fn release_from(
  emitter: Emitter,
  base: Code,
  value: CValue,
  params: List<EmitParam>,
  at_tail: Bool,
) -> Option<Emitter> =
  if !counted(value.kind) { Some(emitter) } else if emitter.release {
    if base_owned(base) && spendable(emitter, value.expr) {
      Some(release_holder(spend_made(emitter, value.expr), value))
    } else { Some(emitter) }
  } else {
    match base.own {
      Owned -> match base.node {
        NVar(v) -> match v.slot {
          None -> Some(emitter),
          // At most once per object (not per name), and only when it is read once.
          Some(_) -> if (!at_tail && reads_of_root(emitter, value.expr) != 1)
              || fold(emitter.released, false, |acc: Bool, r: Bytes|
                acc || r == root_of(emitter, value.expr)) { Some(emitter) } else {
            let emitter = note_released(emitter, root_of(emitter, value.expr));
            // A held-back record dies unbuilt; guarded, since another path may have built it.
            match deferred_of(emitter, value.expr) {
              Some(d) ->
                Some(
                  line(
                    note_tok(emitter, d.n),
                    bytes_concat_all([
                      b"if (",
                      value.expr,
                      b") { if (tok",
                      ascii_of_int(d.n),
                      b" == 0) { tok",
                      ascii_of_int(d.n),
                      b" = ply_reset_flat(",
                      value.expr,
                      b"); if (!tok",
                      ascii_of_int(d.n),
                      b") tok",
                      ascii_of_int(d.n),
                      b" = rt_reset_p(ctx, ",
                      value.expr,
                      b"); } else { ply_dec(ctx, ",
                      value.expr,
                      b"); } ",
                      value.expr,
                      b" = 0; }",
                    ]),
                  ),
                ),
              None -> match width_of(value.ty) {
                None ->
                  Some(line(emitter, bytes_concat_all([b"ply_dec(ctx, ", value.expr, b");"]))),
                Some(n) -> {
                  let emitter = note_tok(emitter, n);
                  Some(
                    line(
                      emitter,
                      bytes_concat_all([
                        b"if (tok",
                        ascii_of_int(n),
                        b" == 0) { tok",
                        ascii_of_int(n),
                        b" = ply_reset_flat(",
                        value.expr,
                        b"); if (!tok",
                        ascii_of_int(n),
                        b") tok",
                        ascii_of_int(n),
                        b" = rt_reset_p(ctx, ",
                        value.expr,
                        b"); } else { ply_dec(ctx, ",
                        value.expr,
                        b"); }",
                      ]),
                    ),
                  )
                },
              },
            }
          },
        },
        _ -> Some(emitter),
      },
      _ -> Some(emitter),
    }
  }

fn base_owned(base: Code) -> Bool =
  match base.own { Owned -> match base.node { NVar(v) -> v.slot != None, _ -> false }, _ -> false }

/// A field read the ownership pass marked `Owned` (nothing after it reads the field or the whole
/// record) takes the field out of a record this body holds and no loop reads again: the record,
/// when it is the field's only other holder, gives the field up rather than sharing it.
fn takes_field(emitter: Emitter, read: Code, base: Code, holder: Bytes) -> Bool =
  emitter.release && read.own == Owned && !base_owned(base) && is_made(emitter, holder)
    && !is_pinned(emitter, holder)

/// A subject whose fields a pattern bound, each binder holding a count of its own, is let go at
/// once where this body holds it alone, so a field the subject alone held is its binder's alone;
/// its cells are the token the next record or constructor of its width takes.
fn let_go(emitter: Emitter, subj: CValue, pattern: CodePattern) -> Emitter =
  if emitter.release && counted(subj.kind) && spendable(emitter, subj.expr) {
    let spent = spend_made(emitter, subj.expr);
    match pattern {
      PxCtor(c) -> if len(c.args) == 0 || subj.kind == KMaybe { release_holder(spent, subj) } else {
        match tag_of(emitter, c.name) {
          Some(tag) -> into_token(spent, subj.expr, ctor_width(emitter, tag, len(c.args))),
          None -> release_holder(spent, subj),
        }
      },
      _ -> release_holder(spent, subj),
    }
  } else { emitter }

/// Releases a holder's count, keeping its cells as a reuse token when the shape is known, and nulls the local.
fn release_holder(emitter: Emitter, value: CValue) -> Emitter =
  match deferred_of(emitter, value.expr) {
    Some(d) ->
      line(
        note_tok(emitter, d.n),
        bytes_concat_all([
          b"if (",
          value.expr,
          b") { if (tok",
          ascii_of_int(d.n),
          b" == 0) { tok",
          ascii_of_int(d.n),
          b" = ply_reset_flat(",
          value.expr,
          b"); if (!tok",
          ascii_of_int(d.n),
          b") tok",
          ascii_of_int(d.n),
          b" = rt_reset_p(ctx, ",
          value.expr,
          b"); } else { ply_dec(ctx, ",
          value.expr,
          b"); } ",
          value.expr,
          b" = 0; }",
        ]),
      ),
    None -> match width_of(value.ty) {
      None ->
        line(
          emitter,
          bytes_concat_all([b"ply_dec(ctx, ", value.expr, b"); ", value.expr, b" = 0;"]),
        ),
      Some(n) -> into_token(emitter, value.expr, n),
    },
  }

/// Releases the local `name`, a record or a constructor of `n` words, into the token of that width
/// where it is unique and the token is empty, and nulls it.
fn into_token(emitter: Emitter, name: Bytes, n: Int) -> Emitter =
  line(
    note_tok(emitter, n),
    bytes_concat_all([
      b"if (tok",
      ascii_of_int(n),
      b" == 0) { tok",
      ascii_of_int(n),
      b" = ply_reset_flat(",
      name,
      b"); if (!tok",
      ascii_of_int(n),
      b") tok",
      ascii_of_int(n),
      b" = rt_reset_p(ctx, ",
      name,
      b"); } else { ply_dec(ctx, ",
      name,
      b"); } ",
      name,
      b" = 0;",
    ]),
  )

/// A forwarded field of a record about to be released is duplicated first, as `rt_field` does.
fn secure_field(emitter: Emitter, base: Code, b: CValue, v: CValue) -> WithValue =
  if !emitter.release || !counted(v.kind) || !base_owned(base) || !spendable(emitter, b.expr) {
    { emitter: emitter, value: v }
  } else {
    let t = bind_word_of(emitter, v.expr);
    {
      emitter: note_made(
        line(t.emitter, bytes_concat_all([b"ply_inc(", t.value.expr, b");"])),
        t.value.expr,
      ),
      value: { kind: KBoxed, expr: t.value.expr, ty: v.ty },
    }
  }

fn from_table(emitter: Emitter, literal: Lit) -> WithValue = {
  let c = const_of(emitter, literal);
  let o = bind(
    c.emitter,
    KBoxed,
    bytes_concat_all([b"rt_lit_p(ctx, @@c", ascii_of_int(c.i), b"@@)"]),
  );
  { emitter: check(o.emitter), value: o.value }
}

/// Every occurrence takes a new index: constants are not interned, unlike shapes.
fn const_of(emitter: Emitter, literal: Lit) -> { emitter: Emitter, i: Int } =
  {
    emitter: {
      out: emitter.out,
      temp_count: emitter.temp_count,
      unboxed: emitter.unboxed,
      indent: emitter.indent,
      reads: emitter.reads,
      shapes: emitter.shapes,
      built: emitter.built,
      module: emitter.module,
      base: emitter.base,
      count_locals: emitter.count_locals,
      here: emitter.here,
      imports: emitter.imports,
      consts: push(emitter.consts, literal),
      ctors: emitter.ctors,
      lambda_bodies: emitter.lambda_bodies,
      lambdas: emitter.lambdas,
      owner: emitter.owner,
      builtins: emitter.builtins,
      called_builtins: emitter.called_builtins,
      fields: emitter.fields,
      released: emitter.released,
      reuse_widths: emitter.reuse_widths,
      alias: emitter.alias,
      by_root: emitter.by_root,
      tail: emitter.tail,
      calls: emitter.calls,
      generics: emitter.generics,
      refused: emitter.refused,
      deferred: emitter.deferred,
      deferred_locals: emitter.deferred_locals,
      performs: emitter.performs,
      handles: emitter.handles,
      landing: emitter.landing,
      effects: emitter.effects,
      release: emitter.release,
      pinned: emitter.pinned,
      bound: emitter.bound,
      group: emitter.group,
      operands: emitter.operands,
      typed: emitter.typed,
      answer: emitter.answer,
      site_root: emitter.site_root,
      lent: emitter.lent,
      written: emitter.written,
    },
    i: len(emitter.consts),
  }

/// A constructor's tag: this module's own, a qualified one, or one an import brought in bare.
fn tag_of(emitter: Emitter, name: Bytes) -> Option<Int> = {
  let part = qualified(name);
  let written = match part { Some(q) -> q.name, None -> name };
  let want = match part {
    Some(q) -> match module_import(emitter.imports, q.binder) {
      Some(imp) -> bytes_concat_all([imp.module, b".", q.name]),
      None -> bytes_concat_all([b"std.", q.binder, b".", q.name]),
    },
    None -> qualify(emitter.module, name),
  };
  match ctor_index(emitter.ctors.names, want, name) {
    Some(t) -> Some(t),
    // Only an import that bound this name can be where it came from. Two modules may declare a
    // constructor of the same name, so matching on the module alone would take the wrong one.
    None ->
      fold(emitter.imports, None, |acc: Option<Int>, imp: Imported|
        match acc {
          Some(_) -> acc,
          None -> if !imp.whole && imp.name == written {
            ctor_index(emitter.ctors.names, bytes_concat_all([imp.module, b".", written]), b"")
          } else { None },
        }),
  }
}

fn is_option_type(t: Type) -> Bool =
  match t { TyCon(c) -> c.name == b"Option" && len(c.args) == 1, _ -> false }

/// Whether the checker typed the expression at `span` an `Option`.
fn option_at(emitter: Emitter, span: Span) -> Bool =
  match map_get(emitter.typed, span_key(span)) { Some(t) -> is_option_type(t.ty), None -> false }

/// Whether `tag` is the prelude's `Option` constructor `name`, which the table names bare.
fn is_option(emitter: Emitter, tag: Int, name: Bytes) -> Bool =
  list_at(emitter.ctors.names, tag) == Some(name)

/// `payload`, a word this scope now holds, as an `Option` held as that word.
fn held_maybe(emitter: Emitter, payload: Bytes, ty: Ty) -> WithValue = {
  let b = bind(emitter, KMaybe, payload);
  {
    emitter: if is_made(b.emitter, b.value.expr) { b.emitter }
    else { note_made(b.emitter, b.value.expr) },
    value: { ..b.value, ty: ty },
  }
}

/// The runtime's helper for a builtin answering an element or `None`, which hands the element back
/// with a count or zero: an `Option` held as its payload's word, no object made.
fn lookup_helper(name: Bytes, n: Int) -> Option<Bytes> =
  if n != 2 { None }
  else if name == b"list_at" { Some(b"rt_list_lookup_p") }
  else if name == b"array_at" { Some(b"rt_array_lookup_p") }
  else if name == b"map_get" { Some(b"rt_map_lookup_p") }
  else { None }

/// `helper` called over `names`, which it takes; a failed call answers zero too, so failure is read
/// before zero is taken for `None`.
fn looked_up(emitter: Emitter, helper: Bytes, names: List<Bytes>) -> WithValue = {
  let called = fresh(emitter);
  let read = check(
    line(
      called.emitter,
      bytes_concat_all([
        b"int64_t ",
        called.name,
        b" = ",
        helper,
        b"(ctx",
        fold(names, b"", |acc: Bytes, nm: Bytes| bytes_concat_all([acc, b", ", nm])),
        b");",
      ]),
    ),
  );
  held_maybe(read, called.name, TyOpen([]))
}

/// A constructor's tag as the C writes it: by its name in the program's table, which a unit resolves
/// to the position its own table gives that name, so a body reads the same in every program and does
/// not move when a constructor is added elsewhere.
/// The witness of a type that states its own arithmetic, which the elaboration names by one of the
/// type's constructors: the runtime's first such witness past that constructor's tag, so the body
/// names the tag and takes what the type states with it.
fn stated_witness(emitter: Emitter, args: List<Code>) -> Option<WithValue> / {abort.raise} =
  match match list_at(args, 0) {
      Some(c) -> match c.node {
        NLit(LStr(name)) -> ctor_index(emitter.ctors.names, name, b""),
        _ -> None,
      },
      None -> None,
    } {
    None -> Some(refused(emitter, b"a witness of a type no constructor names")),
    Some(tag) ->
      Some({
        emitter: emitter,
        value: {
          kind: KInt,
          expr: bytes_concat_all([b"(13 + ", tag_text(emitter, tag), b")"]),
          ty: TyOpen([]),
        },
      }),
  }

fn tag_text(emitter: Emitter, tag: Int) -> Bytes / {abort.raise} =
  match list_at(emitter.ctors.names, tag) {
    Some(name) -> bytes_concat_all([b"@@T", name, b"@@"]),
    None -> panic("a tag is a position in the program's constructor table"),
  }

fn ctor_index(ctors: List<Bytes>, want: Bytes, bare: Bytes) -> Option<Int> =
  fold(range(0, len(ctors)), None, |acc: Option<Int>, i: Int|
    match list_at(ctors, i) {
      Some(c) -> if c == want || (bare != b"" && c == bare) { Some(i) } else { acc },
      None -> acc,
    })

fn is_ctor_name(name: Bytes) -> Bool = {
  let bare = match qualified(name) { Some(q) -> q.name, None -> name };
  bytes_len(bare) > 0 && bytes_at(bare, 0) >= 65 && bytes_at(bare, 0) <= 90
}

fn last_segment(path: List<Ident>) -> Bytes =
  match list_at(path, len(path) - 1) { Some(i) -> i.name, None -> b"" }

/// `binder::name` split at the first `::`, when there is one.
fn qualified(name: Bytes) -> Option<{ binder: Bytes, name: Bytes }> =
  fold(range(0, bytes_len(name) - 1), None, |acc: Option<{ binder: Bytes, name: Bytes }>, i: Int|
    match acc {
      Some(_) -> acc,
      None -> if bytes_at(name, i) == 58 && bytes_at(name, i + 1) == 58 {
        Some({ binder: bytes_slice(name, 0, i), name: bytes_slice(name, i + 2, bytes_len(name)) })
      } else { None },
    })

fn from_import(xs: List<Imported>, name: Bytes) -> Option<Imported> =
  fold(xs, None, |acc: Option<Imported>, i: Imported|
    if !i.whole && i.name == name { Some(i) } else { acc })

fn module_import(xs: List<Imported>, binder: Bytes) -> Option<Imported> =
  fold(xs, None, |acc: Option<Imported>, i: Imported|
    if i.whole && i.name == binder { Some(i) } else { acc })

fn opened_to(emitter: Emitter, value: CValue, d: { kind: Option<Kind>, ty: Ty }) -> WithValue =
  match d.kind {
    Some(KInt) -> bind(emitter, KInt, as_int(value)),
    Some(KBool) -> bind(emitter, KBool, as_bool(value)),
    Some(KNum(w)) -> bind(emitter, KNum(w), as_num(value, w)),
    Some(KFloat) -> bind(emitter, KFloat, as_float(value)),
    Some(KDec) -> bind(emitter, KDec, as_dec(value)),
    // The callee's declared type makes a later field read a load rather than a search.
    _ -> { emitter: emitter, value: { kind: value.kind, expr: value.expr, ty: d.ty } },
  }

fn ret_of(here: List<Def>, name: Bytes) -> { kind: Option<Kind>, ty: Ty } =
  fold(here, { kind: None, ty: TyOpen([]) }, |acc: { kind: Option<Kind>, ty: Ty }, d: Def|
    if d.name == name { { kind: d.ret, ty: d.ret_ty } } else { acc })

/// A nullary pure definition (here or imported) is read from the constant table, whatever its kind: a call reruns its body at every read.
fn constant_of(
  emitter: Emitter,
  name: Bytes,
) -> Option<{ full: Bytes, ret: { kind: Option<Kind>, ty: Ty } }> =
  if fold(emitter.here, false, |acc: Bool, h: Def| acc || h.name == name) {
    if is_pure(emitter.here, name) {
      Some({ full: qualify(emitter.module, name), ret: ret_of(emitter.here, name) })
    } else { None }
  } else {
    let callee = match qualified(name) { Some(q) -> q.name, None -> name };
    match match qualified(name) {
        Some(q) -> module_import(emitter.imports, q.binder),
        None -> from_import(emitter.imports, name),
      } {
      None -> None,
      Some(imp) -> if is_pure(imp.defs, callee) {
        Some({ full: bytes_concat_all([imp.module, b".", callee]), ret: ret_of(imp.defs, callee) })
      } else { None },
    }
  }

fn is_pure(here: List<Def>, name: Bytes) -> Bool =
  fold(here, false, |acc: Bool, d: Def| if d.name == name { d.pure } else { acc })

/// Whether `code` names a definition of two parameters, which a fold calls in its loop.
fn names_a_step(emitter: Emitter, code: Code) -> Bool / {abort.raise} =
  match code.node {
    NVar(fv) ->
      fv.slot == None
        && (match def_of(emitter, fv.name) { Some(d) -> d.arity == 2, None -> false }),
    _ -> false,
  }

fn def_of(
  emitter: Emitter,
  name: Bytes,
) -> Option<{ full: Bytes, expr: Bytes, arity: Int, scheme: Option<Scheme>, def: Def }> / {abort.raise} =
  if is_ctor_name(name) { None } else {
    let target = match qualified(name) {
      Some(q) -> match module_import(emitter.imports, q.binder) {
        Some(imp) -> Some({ module: imp.module, name: q.name, defs: imp.defs }),
        None -> None,
      },
      None -> if fold(emitter.here, false, |acc: Bool, h: Def| acc || h.name == name) {
        Some({ module: emitter.module, name: name, defs: emitter.here })
      } else {
        match from_import(emitter.imports, name) {
          Some(imp) -> Some({ module: imp.module, name: name, defs: imp.defs }),
          None -> None,
        }
      },
    };
    match target {
      None -> None,
      Some(t) -> match fold(t.defs, None, |acc: Option<Def>, d: Def|
          if d.name == t.name { Some(d) } else { acc }) {
        Some(d) -> {
          let full = bytes_concat_all([t.module, b".", t.name]);
          Some({ full: full, expr: symbol_of(full), arity: d.arity, scheme: d.scheme, def: d })
        },
        None -> None,
      },
    }
  }

/// Under release `bytes_position` is a loop in the body: the runtime's would suspend, which a native frame cannot resume.
fn position_call(
  emitter: Emitter,
  name: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  if !emitter.release || name != b"bytes_position" || len(args) != 3 { None } else {
    match tag_of(emitter, b"Some") {
      None -> None,
      Some(some) -> match tag_of(emitter, b"None") {
        None -> None,
        Some(none) -> match list_at(args, 0) {
          None -> None,
          Some(b0) -> match list_at(args, 1) {
            None -> None,
            Some(f0) -> match list_at(args, 2) {
              None -> None,
              Some(p0) -> match expr(notail(emitter), b0, params) {
                None -> None,
                Some(bv) -> {
                  let bo = owned(bv.emitter, bv.value);
                  match expr(notail(bo.emitter), f0, params) {
                    None -> None,
                    Some(fv) -> {
                      let from = bind(fv.emitter, KInt, as_int(fv.value));
                      match expr(notail(from.emitter), p0, params) {
                        None -> None,
                        Some(pv) -> {
                          let po = owned(pv.emitter, pv.value);
                          // Bad input goes to the runtime's own call, which raises before it would suspend.
                          let guard = line(
                            site(po.emitter, span),
                            bytes_concat_all([
                              b"if (ply_is_imm(",
                              bo.value.expr,
                              b") || ply_obj(",
                              bo.value.expr,
                              b")->kind != 10 || (uint64_t)",
                              from.value.expr,
                              b" > (uint64_t)ply_obj(",
                              bo.value.expr,
                              b")->len) { ",
                              builtin_call_over(b"bytes_position", [
                                bo.value.expr,
                                bytes_concat_all([b"ply_imm(", from.value.expr, b")"]),
                                po.value.expr,
                              ]),
                              b"; ",
                              leaving(po.emitter),
                              b" }",
                            ]),
                          );
                          let ans = fresh(guard);
                          let declared = line(
                            ans.emitter,
                            bytes_concat_all([
                              b"Word ",
                              ans.name,
                              b" = rt_nullary_p(ctx, ",
                              tag_text(emitter, none),
                              b");",
                            ]),
                          );
                          let i = bind(declared, KInt, from.value.expr);
                          let head = indent(
                            line(
                              i.emitter,
                              bytes_concat_all([
                                b"for (; ",
                                i.value.expr,
                                b" < (int64_t)ply_obj(",
                                bo.value.expr,
                                b")->len; ",
                                i.value.expr,
                                b" += 1) {",
                              ]),
                            ),
                          );
                          let arg = fresh(head);
                          let called = fresh(
                            line(
                              arg.emitter,
                              bytes_concat_all([
                                b"Word ",
                                arg.name,
                                b"[] = { ply_imm((int64_t)(ply_bytes(",
                                bo.value.expr,
                                b"))[",
                                i.value.expr,
                                b"]) }; ply_inc(",
                                po.value.expr,
                                b");",
                              ]),
                            ),
                          );
                          let asked = line(
                            site(called.emitter, span),
                            bytes_concat_all([
                              b"Word ",
                              called.name,
                              b" = rt_call_p(ctx, ",
                              po.value.expr,
                              b", (Word)(intptr_t)",
                              arg.name,
                              b", 1);",
                            ]),
                          );
                          let hit = line(
                            indent(
                              line(
                                check(asked),
                                bytes_concat_all([
                                  b"if (rt_unbox_bool_p(ctx, ",
                                  called.name,
                                  b")) {",
                                ]),
                              ),
                            ),
                            bytes_concat_all([
                              b"Word w[] = { ply_imm(",
                              i.value.expr,
                              b") }; ",
                              ans.name,
                              b" = rt_ctor_p(ctx, ",
                              tag_text(emitter, some),
                              b", (Word)(intptr_t)w, 1);",
                            ]),
                          );
                          let stopped = line(outdent(line(check(hit), b"break;")), b"}");
                          let done = line(outdent(stopped), b"}");
                          let freed = line(
                            line(done, bytes_concat_all([b"ply_dec(ctx, ", po.value.expr, b");"])),
                            bytes_concat_all([b"ply_dec(ctx, ", bo.value.expr, b");"]),
                          );
                          Some({
                            emitter: note_holder(freed, ans.name),
                            value: { kind: KBoxed, expr: ans.name, ty: TyOpen([]) },
                          })
                        },
                      }
                    },
                  }
                },
              },
            },
          },
        },
      },
    }
  }

/// `iterate` over a one-parameter lambda is fused into the body; anything else calls the runtime's helper.
fn iterate_call(
  emitter: Emitter,
  name: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  if name != b"iterate" || len(args) != 3 { None } else {
    match list_at(args, 2) {
      None -> None,
      Some(f) -> match f.node {
        NLambda(l) -> if l.params == 1 { fused_iterate(emitter, args, l, params, span) }
        else { helper_call(emitter, b"rt_iterate_p", args, params) },
        _ -> helper_call(emitter, b"rt_iterate_p", args, params),
      },
    }
  }

/// A step answering `Stop`/`Continue` directly in every arm becomes the loop's assignments; any other is called and its tag tested.
fn fused_iterate(
  emitter: Emitter,
  args: List<Code>,
  l: Lambda,
  params: List<EmitParam>,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  match tag_of(emitter, b"Stop") {
    None -> Some(refused(emitter, b"`iterate` with no `Stop` and `Continue` in the program")),
    Some(stop) -> match tag_of(emitter, b"Continue") {
      None -> Some(refused(emitter, b"`iterate` with no `Stop` and `Continue` in the program")),
      Some(go) -> match list_at(args, 0) {
        None -> None,
        Some(seed) -> match list_at(args, 1) {
          None -> None,
          Some(budget) -> match expr(notail(emitter), seed, params) {
            None -> None,
            Some(sv) -> {
              let sw = word_of(sv.emitter, sv.value);
              let state = fresh(sw.emitter);
              let s1 = assign_owned(
                line(
                  state.emitter,
                  bytes_concat_all([b"Word ", state.name, b" = ", sw.expr, b";"]),
                ),
                state.name,
                sw.expr,
              );
              match expr(notail(s1), budget, params) {
                None -> None,
                Some(bv) -> {
                  let bud = as_int(bv.value);
                  let left = fresh(bv.emitter);
                  let s2 = line(
                    left.emitter,
                    bytes_concat_all([b"int64_t ", left.name, b" = ", bud, b";"]),
                  );
                  let answer = fresh(s2);
                  let s3 = line(
                    answer.emitter,
                    bytes_concat_all([b"Word ", answer.name, b" = 0;"]),
                  );
                  let opened = indent(line(s3, b"for (;;) {"));
                  let guarded = line(
                    line(
                      site(opened, span),
                      bytes_concat_all([
                        b"if (",
                        left.name,
                        b" <= 0) { rt_iterate_bad_p(ctx, (",
                        bud,
                        b") < 1 ? 0 : 1, ",
                        bud,
                        b"); ",
                        leaving(opened),
                        b" }",
                      ]),
                    ),
                    bytes_concat_all([left.name, b" -= 1;"]),
                  );
                  match capture_window(guarded, l.captures, params) {
                    None -> Some(refused(emitter, b"a capture this port has not bound")),
                    Some(window) -> {
                      // Everything held outside the loop is pinned: the body reads it once per iteration.
                      let held = bind_keeping(
                        with_reads(rescope(pin_all(guarded), window), slots_read(l.body)),
                        KBoxed,
                        sv.value.ty,
                        state.name,
                      );
                      let inner = remember(
                        note_holder(held.emitter, held.value.expr),
                        0,
                        held.value,
                      );
                      let body = if fusable_step(inner, l.body) {
                        emit_step(
                          inner,
                          l.body,
                          state.name,
                          answer.name,
                          stop,
                          go,
                          params,
                          inner.indent,
                        )
                      } else {
                        match expr(inner, l.body, params) {
                          None -> None,
                          Some(r) -> {
                            let rw = word_of(r.emitter, r.value);
                            let sa = bind(rw.emitter, KBoxed, rw.expr);
                            let k = fresh(sa.emitter);
                            let t1 = line(
                              k.emitter,
                              bytes_concat_all([
                                b"uint32_t ",
                                k.name,
                                b" = (!ply_is_imm(",
                                sa.value.expr,
                                b") && ",
                                sa.value.expr,
                                b" != 0 && ply_obj(",
                                sa.value.expr,
                                b")->kind == 4 && ply_obj(",
                                sa.value.expr,
                                b")->len == 1) ? ply_obj(",
                                sa.value.expr,
                                b")->layout : 0xFFFFFFFFu;",
                              ]),
                            );
                            let t2 = line(
                              indent(
                                line(
                                  t1,
                                  bytes_concat_all([
                                    b"if (",
                                    k.name,
                                    b" == ",
                                    tag_text(emitter, stop),
                                    b") {",
                                  ]),
                                ),
                              ),
                              bytes_concat_all([
                                answer.name,
                                b" = ply_words(",
                                sa.value.expr,
                                b")[0];",
                              ]),
                            );
                            let t3 = line(
                              release_at(
                                line(t2, bytes_concat_all([b"ply_inc(", answer.name, b");"])),
                                inner.indent,
                              ),
                              b"break;",
                            );
                            let t4 = line(
                              indent(
                                line(
                                  outdent(t3),
                                  bytes_concat_all([
                                    b"} else if (",
                                    k.name,
                                    b" == ",
                                    tag_text(emitter, go),
                                    b") {",
                                  ]),
                                ),
                              ),
                              bytes_concat_all([
                                state.name,
                                b" = ply_words(",
                                sa.value.expr,
                                b")[0];",
                              ]),
                            );
                            let t5 = line(t4, bytes_concat_all([b"ply_inc(", state.name, b");"]));
                            let t6 = line(
                              site(indent(line(outdent(t5), b"} else {")), span),
                              bytes_concat_all([
                                b"rt_iterate_bad_p(ctx, 2, ",
                                sa.value.expr,
                                b"); ",
                                leaving(t5),
                              ]),
                            );
                            Some(line(outdent(t6), b"}"))
                          },
                        }
                      };
                      match body {
                        None -> None,
                        Some(done) ->
                          Some({
                            emitter: note_holder(
                              with_pinned(
                                close(with_reads(rescope(done, guarded.unboxed), emitter.reads)),
                                emitter.pinned,
                              ),
                              answer.name,
                            ),
                            value: { kind: KBoxed, expr: answer.name, ty: TyOpen([]) },
                          }),
                      }
                    },
                  }
                },
              }
            },
          },
        },
      },
    },
  }

/// A call of the two-parameter definition `f` names, with the accumulator and the element in
/// slots 0 and 1, each read at its last use.
fn named_step(emitter: Emitter, f: Code) -> Option<WithValue> / {abort.raise} =
  match f.node {
    NVar(fv) -> match def_of(emitter, fv.name) {
      None -> None,
      Some(d) -> match conv_of(emitter, 0) {
        None -> None,
        Some(acc) -> match conv_of(emitter, 1) {
          None -> None,
          Some(x) -> {
            let target = call_target(emitter, d.full, Some(d.def), f.span, []);
            let a0 = move_read(target.emitter, Owned, acc);
            let a1 = move_read(a0.emitter, Owned, x);
            let c1 = carried_arg(a1.emitter, a0.value, carrier_at(target.carriers.params, 0));
            let c2 = carried_arg(c1.emitter, a1.value, carrier_at(target.carriers.params, 1));
            Some(called(c2.emitter, target, f.span, concat(c1.names, c2.names), 2))
          },
        },
      },
    },
    _ -> None,
  }

/// The lambdas `params` are bound to.
fn lent_of(params: List<EmitParam>) -> List<BoundLambda> =
  fold(params, [], |acc: List<BoundLambda>, p: EmitParam|
    match p.lambda { Some(bl) -> push(acc, bl), None -> acc })

/// The lambda this root was handed that is `owner`'s `nth` written at `at`.
fn lent_lambda(emitter: Emitter, owner: Bytes, at: Int, nth: Int) -> Option<BoundLambda> =
  fold(emitter.lent, None, |acc: Option<BoundLambda>, bl: BoundLambda|
    match acc {
      Some(_) -> acc,
      None -> if bl.owner == owner && bl.at == at && bl.nth == nth { Some(bl) } else { None },
    })

/// The frame a lambda run in place is emitted in: at its owner's names, types and sites, counting
/// the call it replaces, its parameters the call's argument values `vals`, each held until the body
/// is done, and its captures borrowed from the function value `func`, which keeps their counts.
fn inlined_frame(
  emitter: Emitter,
  bl: BoundLambda,
  func: CValue,
  vals: List<CValue>,
  lambda: Lambda,
) -> Emitter / {abort.raise} = {
  let opened = line(indent(emitter), tick_line(leaving(emitter)));
  let held = fold(
    vals,
    { emitter: opened, vals: [] },
    |acc: { emitter: Emitter, vals: List<CValue> }, v: CValue|
      if counted(v.kind) {
        let o = owned_word(acc.emitter, { ..v, kind: KBoxed });
        {
          emitter: note_holder(o.emitter, o.value.expr),
          vals: push(acc.vals, { ..o.value, kind: v.kind }),
        }
      } else { { emitter: acc.emitter, vals: push(acc.vals, v) } },
  );
  let caps = fold(
    range(0, len(lambda.captures)),
    { emitter: held.emitter, window: [] },
    |acc: { emitter: Emitter, window: List<Unboxed> }, ci: Int|
      match list_at(lambda.captures, ci) {
        None -> acc,
        Some(c) -> {
          let b = bind(
            acc.emitter,
            KBoxed,
            bytes_concat_all([b"ply_words(", func.expr, b")[", ascii_of_int(ci + 1), b"]"]),
          );
          {
            emitter: b.emitter,
            window: push(acc.window, {
              slot: c.dst,
              kind: KBoxed,
              expr: b.value.expr,
              ty: TyOpen([]),
            }),
          }
        },
      },
  );
  let swapped = {
    ..caps.emitter,
    module: bl.module,
    here: bl.here,
    imports: bl.imports,
    effects: bl.effects,
    typed: bl.typed,
    operands: bl.operands,
    base: bl.base,
    site_root: Some(bl.owner),
  };
  let framed = fold(
    caps.window,
    with_reads(rescope(swapped, caps.window), slots_read(lambda.body)),
    |acc: Emitter, w: Unboxed| note_bound(charge(acc, w.slot, w.expr), w.expr),
  );
  fold(range(0, len(held.vals)), framed, |acc: Emitter, k: Int|
    match list_at(held.vals, k) { Some(v) -> remember(acc, k, v), None -> acc })
}

/// What a lambda run in place answered, made the caller's of `emitter` before what the frame
/// opened at depth `from` held is released.
fn inlined_answer(emitter: Emitter, from: Int, r: WithValue) -> WithValue = {
  let answered = if counted(r.value.kind) {
    let w = owned_word(r.emitter, { ..r.value, kind: KBoxed });
    { emitter: w.emitter, value: { ..w.value, kind: r.value.kind } }
  } else { bind(r.emitter, r.value.kind, r.value.expr) };
  let restored = {
    ..answered.emitter,
    module: emitter.module,
    here: emitter.here,
    imports: emitter.imports,
    effects: emitter.effects,
    typed: emitter.typed,
    operands: emitter.operands,
    base: emitter.base,
    site_root: emitter.site_root,
  };
  let released = outdent(
    release_at(with_reads(rescope(restored, emitter.unboxed), emitter.reads), from),
  );
  {
    emitter: if counted(answered.value.kind) { note_holder(released, answered.value.expr) }
    else { released },
    value: { ..answered.value, ty: TyOpen([]) },
  }
}

/// `c` with each call of a slot `bound` names written as the lambda it runs in place, through
/// lambdas and barriers that capture the slot.
fn inlined_calls(c: Code, bound: List<{ slot: Int, lent: BoundLambda }>) -> Code = {
  let go = |x: Code| inlined_calls(x, bound);
  let inside = |caps: List<Capture>|
    fold(caps, [], |acc: List<{ slot: Int, lent: BoundLambda }>, cap: Capture|
      match fold(
          bound,
          None,
          |found: Option<{ slot: Int, lent: BoundLambda }>, b: { slot: Int, lent: BoundLambda }|
            if b.slot == cap.src { Some(b) } else { found },
        ) {
        Some(b) -> push(acc, { ..b, slot: cap.dst }),
        None -> acc,
      });
  let maybe = |x: Option<Code>| match x { Some(y) -> Some(go(y)), None -> None };
  let node = match c.node {
    NApp(a) -> match a.func.node {
      NVar(v) -> match match v.slot {
          Some(sl) ->
            fold(
              bound,
              None,
              |found: Option<{ slot: Int, lent: BoundLambda }>, b: { slot: Int, lent: BoundLambda }|
                if b.slot == sl { Some(b) } else { found },
            ),
          None -> None,
        } {
        Some(b) ->
          NInlined({
            func: a.func,
            args: map(a.args, go),
            lambda: b.lent.code,
            owner: b.lent.owner,
            nth: b.lent.nth,
          }),
        None -> NApp({ func: a.func, args: map(a.args, go) }),
      },
      _ -> NApp({ func: go(a.func), args: map(a.args, go) }),
    },
    NUnary(u) -> NUnary({ ..u, operand: go(u.operand) }),
    NBinary(b) -> NBinary({ ..b, lhs: go(b.lhs), rhs: go(b.rhs) }),
    NIf(i) ->
      NIf({ cond: go(i.cond), then_branch: go(i.then_branch), else_branch: go(i.else_branch) }),
    NBlock(b) ->
      NBlock({
        stmts: map(b.stmts, |stmt: CodeStmt|
          match stmt {
            CLet(l) -> CLet({ ..l, value: go(l.value) }),
            CLetPat(l) -> CLetPat({ ..l, value: go(l.value) }),
            CDo(d) -> CDo({ code: go(d.code) }),
          }),
        tail: maybe(b.tail),
      }),
    NList(l) -> NList({ items: map(l.items, go) }),
    NRecord(r) -> NRecord({ fields: map(r.fields, |f: CodeField| { ..f, value: go(f.value) }) }),
    NMatch(m) ->
      NMatch({
        scrutinee: go(m.scrutinee),
        arms: map(m.arms, |a: CodeArm| { ..a, guard: maybe(a.guard), body: go(a.body) }),
      }),
    NPerform(x) -> NPerform({ ..x, label: maybe(x.label), args: map(x.args, go) }),
    NCell(cl) -> NCell({ ..cl, init: go(cl.init), body: go(cl.body) }),
    NLambda(l) -> NLambda({ ..l, body: inlined_calls(l.body, inside(l.captures)) }),
    NSimulate(x) -> NSimulate({ ..x, body: inlined_calls(x.body, inside(x.captures)) }),
    NParallel(pr) -> NParallel({ ..pr, branches: map(pr.branches, go) }),
    NField(f) -> NField({ ..f, base: go(f.base) }),
    NUpdate(u) ->
      NUpdate({
        ..u,
        base: go(u.base),
        sets: map(u.sets, |f: CodeField| { ..f, value: go(f.value) }),
      }),
    other -> other,
  };
  { ..c, node: node }
}

/// What each capture of a lambda whose body is emitted in place names: the enclosing slot's value,
/// or a boxed parameter's word; `None` where a capture is neither.
fn capture_window(
  emitter: Emitter,
  captures: List<Capture>,
  params: List<EmitParam>,
) -> Option<List<Unboxed>> =
  fold(captures, Some([]), |acc: Option<List<Unboxed>>, capture: Capture|
    match acc {
      None -> None,
      Some(w) -> match conv_of(emitter, capture.src) {
        Some(v) -> Some(push(w, { slot: capture.dst, kind: v.kind, expr: v.expr, ty: v.ty })),
        None -> match list_at(params, capture.src) {
          Some(p) -> if counted(p.kind) {
            Some(
              push(w, {
                slot: capture.dst,
                kind: p.kind,
                expr: bytes_concat(b"p", ascii_of_int(capture.src)),
                ty: p.ty,
              }),
            )
          } else { None },
          None -> None,
        },
      },
    })

fn fusable_step(emitter: Emitter, code: Code) -> Bool / {abort.raise} =
  match code.node {
    NApp(a) ->
      len(a.args) == 1
        && (match a.func.node {
          NVar(fv) -> match fv.slot {
            Some(_) -> false,
            None ->
              is_ctor_name(fv.name)
                && (match tag_of(emitter, fv.name) {
                  Some(t) ->
                    Some(t) == tag_of(emitter, b"Stop") || Some(t) == tag_of(emitter, b"Continue"),
                  None -> false,
                }),
          },
          _ -> false,
        }),
    NIf(i) -> fusable_step(emitter, i.then_branch) && fusable_step(emitter, i.else_branch),
    NBlock(b) -> match b.tail { Some(t) -> fusable_step(emitter, t), None -> false },
    NMatch(m) -> fold(m.arms, true, |acc: Bool, a: CodeArm| acc && fusable_step(emitter, a.body)),
    _ -> false,
  }

/// `Stop(x)` sets the answer and breaks; `Continue(x)` sets the state.
fn emit_step(
  emitter: Emitter,
  code: Code,
  state: Bytes,
  answer: Bytes,
  stop: Int,
  go: Int,
  params: List<EmitParam>,
  depth: Int,
) -> Option<Emitter> / {abort.raise} =
  match code.node {
    NApp(a) -> match list_at(a.args, 0) {
      None -> None,
      Some(x) -> match expr(notail(emitter), x, params) {
        None -> None,
        Some(v) -> {
          let w = word_of(v.emitter, v.value);
          let which = match a.func.node { NVar(fv) -> tag_of(emitter, fv.name), _ -> None };
          if which == Some(stop) {
            // The loop's holders are released before the `break` leaves their block.
            Some(
              line(
                release_at(
                  assign_owned(
                    line(w.emitter, bytes_concat_all([answer, b" = ", w.expr, b";"])),
                    answer,
                    w.expr,
                  ),
                  depth,
                ),
                b"break;",
              ),
            )
          } else {
            Some(
              assign_owned(
                line(w.emitter, bytes_concat_all([state, b" = ", w.expr, b";"])),
                state,
                w.expr,
              ),
            )
          }
        },
      },
    },
    NIf(i) -> match expr(notail(emitter), i.cond, params) {
      None -> None,
      Some(cv) -> {
        let opened = indent(
          line(cv.emitter, bytes_concat_all([b"if (", as_bool(cv.value), b") {"])),
        );
        match emit_step(opened, i.then_branch, state, answer, stop, go, params, depth) {
          None -> None,
          Some(t) -> {
            let t2 = release_at(t, t.indent);
            let els = with_made(indent(line(outdent(t2), b"} else {")), opened.count_locals);
            match emit_step(els, i.else_branch, state, answer, stop, go, params, depth) {
              None -> None,
              Some(e) -> {
                let e2 = close(e);
                Some(with_made(e2, union_made(t2.count_locals, e2.count_locals)))
              },
            }
          },
        }
      },
    },
    NBlock(b) -> match b.tail {
      None -> None,
      Some(t) -> match stmts(emitter, b.stmts, params, 0) {
        None -> None,
        Some(after) ->
          emit_step(rescope(after, after.unboxed), t, state, answer, stop, go, params, depth),
      },
    },
    NMatch(m) -> match match_subject(emitter, m.scrutinee, params) {
      None -> None,
      Some(s) ->
        match_arms(
          s.emitter,
          s.subj,
          m.arms,
          params,
          ToLoop({ state: state, answer: answer, stop: stop, go: go, depth: depth }),
          code.span,
          emitter.tail,
        ),
    },
    _ -> None,
  }

fn helper_call(
  emitter: Emitter,
  helper: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
) -> Option<WithValue> / {abort.raise} =
  match args_one_pass(emitter, args, params, 0, []) {
    None -> None,
    Some(w) -> {
      let o = bind(
        w.emitter,
        KBoxed,
        bytes_concat_all([
          helper,
          b"(ctx",
          fold(w.names, b"", |acc: Bytes, nm: Bytes| bytes_concat_all([acc, b", ", nm])),
          b")",
        ]),
      );
      Some({ emitter: check(o.emitter), value: o.value })
    },
  }

fn fused_fold(
  emitter: Emitter,
  name: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  if name != b"fold" || len(args) != 3 { None } else {
    match list_at(args, 2) {
      None -> None,
      Some(f) -> match f.node {
        NLambda(_) -> inlined_fold(emitter, args, params),
        _ -> if names_a_step(emitter, f) { inlined_fold(emitter, args, params) } else {
          match list_at(args, 0) {
            None -> None,
            Some(xs) -> match list_at(args, 1) {
              None -> None,
              Some(init) -> match expr(notail(emitter), xs, params) {
                None -> None,
                Some(lv) -> {
                  let lo = owned(lv.emitter, lv.value);
                  let cnt = line(lo.emitter, bytes_concat_all([b"ply_inc(", lo.value.expr, b");"]));
                  let raw = bind(cnt, KBoxed, builtin_call_over(b"len", [lo.value.expr]));
                  let n = bind(check(raw.emitter), KInt, as_int(raw.value));
                  // The function value is evaluated once outside the loop, and each iteration hands `rt_call` its own count.
                  // Under release the seed is evaluated before the closure is built: a capture taken at its last use is null afterwards.
                  let ordered = if n.emitter.release {
                    match expr(notail(n.emitter), init, params) {
                      None -> None,
                      Some(iv) -> {
                        let acc = owned(iv.emitter, iv.value);
                        match expr(notail(acc.emitter), f, params) {
                          None -> None,
                          Some(cl) -> {
                            let held = owned(cl.emitter, cl.value);
                            Some({ emitter: held.emitter, co: held.value, acc: acc.value })
                          },
                        }
                      },
                    }
                  } else {
                    let held = match expr(notail(n.emitter), f, params) {
                      None -> None,
                      Some(cl) -> Some(owned(cl.emitter, cl.value)),
                    };
                    match held {
                      None -> None,
                      Some(co) -> match expr(notail(co.emitter), init, params) {
                        None -> None,
                        // The accumulator is not duplicated: the loop hands its count to the closure and takes back the answer's.
                        Some(iv) -> {
                          let acc = bind_word(iv.emitter, iv.value);
                          Some({ emitter: acc.emitter, co: co.value, acc: acc.value })
                        },
                      },
                    }
                  };
                  match ordered {
                    None -> None,
                    Some(ord) -> {
                      let co = { emitter: ord.emitter, value: ord.co };
                      let acc = { emitter: ord.emitter, value: ord.acc };
                      {
                        let i = bind(acc.emitter, KInt, b"0");
                        let head = line(
                          i.emitter,
                          bytes_concat_all([
                            b"for (; ",
                            i.value.expr,
                            b" < ",
                            n.value.expr,
                            b"; ",
                            i.value.expr,
                            b" += 1) {",
                          ]),
                        );
                        let at = bind(
                          indent(head),
                          KBoxed,
                          bytes_concat_all([
                            b"rt_list_at_p(ctx, ",
                            lo.value.expr,
                            b", ",
                            i.value.expr,
                            b")",
                          ]),
                        );
                        let call = {
                          let a2 = fresh(check(at.emitter));
                          line(
                            site(
                              line(
                                line(
                                  a2.emitter,
                                  bytes_concat_all([
                                    b"Word ",
                                    a2.name,
                                    b"[] = {",
                                    acc.value.expr,
                                    b", ",
                                    at.value.expr,
                                    b"};",
                                  ]),
                                ),
                                bytes_concat_all([b"ply_inc(", co.value.expr, b");"]),
                              ),
                              span,
                            ),
                            bytes_concat_all([
                              acc.value.expr,
                              b" = rt_call_p(ctx, ",
                              co.value.expr,
                              b", (Word)(intptr_t)",
                              a2.name,
                              b", 2);",
                            ]),
                          )
                        };
                        // The call took the element.
                        let done = close(check(spend_made(call, at.value.expr)));
                        let freed = line(
                          done,
                          bytes_concat_all([b"ply_dec(ctx, ", co.value.expr, b");"]),
                        );
                        Some({
                          emitter: note_holder(
                            line(freed, bytes_concat_all([b"ply_dec(ctx, ", lo.value.expr, b");"])),
                            acc.value.expr,
                          ),
                          value: acc.value,
                        })
                      }
                    },
                  }
                },
              },
            },
          }
        },
      },
    }
  }

/// `fold` over a literal lambda or a named definition runs its step in the loop, its accumulator
/// held at the seed's kind: a scalar is never boxed, and a record the step holds alone is updated in
/// place.
fn inlined_fold(
  emitter: Emitter,
  args: List<Code>,
  params: List<EmitParam>,
) -> Option<WithValue> / {abort.raise} =
  match list_at(args, 2) {
    None -> None,
    Some(f) -> match list_at(args, 0) {
      None -> None,
      Some(xs) -> match list_at(args, 1) {
        None -> None,
        Some(init) -> match expr(notail(emitter), xs, params) {
          None -> None,
          Some(lv) -> {
            let lo = owned(lv.emitter, lv.value);
            let cnt = line(lo.emitter, bytes_concat_all([b"ply_inc(", lo.value.expr, b");"]));
            let raw = bind(cnt, KBoxed, builtin_call_over(b"len", [lo.value.expr]));
            let n = bind(check(raw.emitter), KInt, as_int(raw.value));
            match expr(notail(n.emitter), init, params) {
              None -> None,
              Some(iv) -> {
                // An `Option` held as its payload's word is carried round the loop as its object.
                let k = if iv.value.kind == KMaybe { KBoxed } else { iv.value.kind };
                // The accumulator holds its count between steps; a step's holder takes it over.
                let seeded = match k {
                  KBoxed -> if iv.emitter.release { owned(iv.emitter, iv.value) }
                  else { bind_word(iv.emitter, iv.value) },
                  _ -> bind(iv.emitter, k, as_kind(iv.value, k)),
                };
                let st = { name: seeded.value.expr };
                let i = bind(seeded.emitter, KInt, b"0");
                let head = line(
                  i.emitter,
                  bytes_concat_all([
                    b"for (; ",
                    i.value.expr,
                    b" < ",
                    n.value.expr,
                    b"; ",
                    i.value.expr,
                    b" += 1) {",
                  ]),
                );
                // Everything held outside the loop is pinned: the body reads it once per element.
                // A lambda's pass counts the call it replaces; a named step's callee counts its own.
                let opened = match f.node {
                  NLambda(_) -> line(pin_all(indent(head)), tick_line(leaving(emitter))),
                  _ -> pin_all(indent(head)),
                };
                let captures = match f.node { NLambda(l) -> l.captures, _ -> [] };
                let reads = match f.node { NLambda(l) -> slots_read(l.body), _ -> [0, 1] };
                match capture_window(opened, captures, params) {
                  None -> Some(refused(emitter, b"a capture this port has not bound")),
                  Some(window) -> {
                    let at = bind(
                      opened,
                      KBoxed,
                      bytes_concat_all([
                        b"rt_list_at_p(ctx, ",
                        lo.value.expr,
                        b", ",
                        i.value.expr,
                        b")",
                      ]),
                    );
                    let holder = match k {
                      KBoxed -> {
                        let h = bind_keeping(at.emitter, KBoxed, iv.value.ty, st.name);
                        { emitter: note_holder(h.emitter, h.value.expr), value: h.value }
                      },
                      _ ->
                        { emitter: at.emitter, value: { kind: k, expr: st.name, ty: iv.value.ty } },
                    };
                    let inner = remember(
                      remember(with_reads(rescope(holder.emitter, window), reads), 0, holder.value),
                      1,
                      at.value,
                    );
                    match match f.node {
                        NLambda(l) -> expr(notail(inner), l.body, params),
                        _ -> named_step(notail(inner), f),
                      } {
                      None -> None,
                      Some(r) -> {
                        let stored = match k {
                          KBoxed -> {
                            let rw = word_of(r.emitter, r.value);
                            assign_owned(
                              line(rw.emitter, bytes_concat_all([st.name, b" = ", rw.expr, b";"])),
                              st.name,
                              rw.expr,
                            )
                          },
                          _ ->
                            line(
                              r.emitter,
                              bytes_concat_all([st.name, b" = ", as_kind(r.value, k), b";"]),
                            ),
                        };
                        let after = with_pinned(
                          close(with_reads(rescope(stored, opened.unboxed), emitter.reads)),
                          emitter.pinned,
                        );
                        let freed = line(
                          after,
                          bytes_concat_all([b"ply_dec(ctx, ", lo.value.expr, b");"]),
                        );
                        Some({
                          emitter: if k == KBoxed { note_holder(freed, st.name) } else { freed },
                          value: { kind: k, expr: st.name, ty: iv.value.ty },
                        })
                      },
                    }
                  },
                }
              },
            }
          },
        },
      },
    },
  }

/// Builtins expanded in place where the declaration fixes the kind: a length is the header's field, a byte a bounds-tested load.
fn inline_len(
  emitter: Emitter,
  name: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  if name == b"bytes_at" && len(args) == 2 { inline_at(emitter, args, params, false, span) }
  else if name == b"bytes_u32_le" && len(args) == 2 { inline_at(emitter, args, params, true, span) }
  else if name == b"bytes_concat_all" && len(args) == 1 { inline_join(emitter, args, params, span) }
  else if name == b"array_get" && len(args) == 2 { inline_get(emitter, args, params, span) }
  else if len(args) != 1 { None }
  else if name == b"float_of_int" || name == b"float_of_bits" || name == b"bits_of_float" {
    float_converted(emitter, name, args, params)
  } else if name != b"len" && name != b"bytes_len" && name != b"array_len" { None } else {
    match list_at(args, 0) {
      None -> None,
      Some(x) -> match expr(notail(emitter), x, params) {
        None -> None,
        Some(o0) -> {
          let o = { emitter: site(o0.emitter, span), value: o0.value };
          let fits = match o.value.ty {
            TyList -> name == b"len",
            TyBytes -> name == b"bytes_len",
            TyArr(_) -> name == b"array_len",
            _ -> false,
          };
          if !fits { Some(kind_tested(o.emitter, name, o.value, None)) } else {
            let t = bind(o.emitter, KBoxed, as_word(o.value));
            Some(bind(t.emitter, KInt, length_of(name, t.value.expr)))
          }
        },
      },
    }
  }

/// A conversion between a `Float` and an `Int`'s value or bits, in C: `float_of_int` rounds to the
/// nearest as IEEE-754 does, and `bits_of_float` reads every NaN as the one `float::bits` names.
fn float_converted(
  emitter: Emitter,
  name: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
) -> Option<WithValue> / {abort.raise} =
  match list_at(args, 0) {
    None -> None,
    Some(x) -> match expr(notail(emitter), x, params) {
      None -> None,
      Some(o) -> if name == b"float_of_int" {
        Some(bind(o.emitter, KFloat, bytes_concat_all([b"(double)(", as_int(o.value), b")"])))
      } else if name == b"float_of_bits" {
        Some(bind(o.emitter, KFloat, bytes_concat_all([b"ply_f64(", as_int(o.value), b")"])))
      } else {
        let b = bind(
          o.emitter,
          KInt,
          bytes_concat_all([b"ply_f64_bits(", as_float(o.value), b")"]),
        );
        Some(
          bind(
            b.emitter,
            KInt,
            bytes_concat_all([
              b"((((uint64_t)",
              b.value.expr,
              b" & UINT64_C(0x7FF0000000000000)) == UINT64_C(0x7FF0000000000000) && ((uint64_t)",
              b.value.expr,
              b" & UINT64_C(0x000FFFFFFFFFFFFF)) != 0) ? INT64_C(0x7FF8000000000000) : ",
              b.value.expr,
              b")",
            ]),
          ),
        )
      },
    },
  }

fn is_wrap(name: Bytes) -> Bool =
  name == b"wrap_add" || name == b"wrap_sub" || name == b"wrap_mul" || name == b"rotr"
    || name == b"rotl"

fn is_saturating(name: Bytes) -> Bool =
  name == b"saturating_add" || name == b"saturating_sub" || name == b"saturating_mul"

/// Exact in 64 bits, then held to the width's ends; only an unsigned 32-bit product needs the
/// unsigned word, and it can only pass the greatest value.
fn saturated(emitter: Emitter, name: Bytes, v0: CValue, v1: CValue, t: Width) -> WithValue = {
  let unsigned = !t.signed && name == b"saturating_mul";
  let wide = if unsigned { b"uint64_t" } else { b"int64_t" };
  let op = if name == b"saturating_add" { b" + " }
  else if name == b"saturating_sub" { b" - " }
  else { b" * " };
  let r = fresh(emitter);
  let exact = line(
    r.emitter,
    bytes_concat_all([
      wide,
      b" ",
      r.name,
      b" = (",
      wide,
      b")(",
      as_num(v0, t),
      b")",
      op,
      b"(",
      wide,
      b")(",
      as_num(v1, t),
      b");",
    ]),
  );
  let top = bytes_concat_all([
    r.name,
    b" > ",
    if unsigned { b"(uint64_t)" } else { b"" },
    int_lit(width_max(t)),
    b" ? ",
    int_lit(width_max(t)),
    b" : ",
    r.name,
  ]);
  bind(
    exact,
    KNum(t),
    bytes_concat_all([
      b"(",
      ctype(KNum(t)),
      b")(",
      if unsigned { top } else {
        bytes_concat_all([
          r.name,
          b" < ",
          int_lit(width_min(t)),
          b" ? ",
          int_lit(width_min(t)),
          b" : (",
          top,
          b")",
        ])
      },
      b")",
    ]),
  )
}

fn is_checked(name: Bytes) -> Bool =
  name == b"checked_add" || name == b"checked_sub" || name == b"checked_mul"
    || name == b"checked_neg"

/// Exact in 64 bits, then tested against the width; only an unsigned 32-bit product needs the unsigned word.
fn checked_num(
  emitter: Emitter,
  name: Bytes,
  vals: List<CValue>,
  t: Width,
) -> Option<WithValue> / {abort.raise} =
  match tag_of(emitter, b"Some") {
    None -> None,
    Some(some) -> match tag_of(emitter, b"None") {
      None -> None,
      Some(none) -> match list_at(vals, 0) {
        None -> None,
        Some(v0) -> {
          let wide = if !t.signed && name == b"checked_mul" { b"uint64_t" } else { b"int64_t" };
          let a = bytes_concat_all([b"(", wide, b")(", as_num(v0, t), b")"]);
          let exact = if name == b"checked_neg" { Some(bytes_concat(b"-", a)) } else {
            match list_at(vals, 1) {
              None -> None,
              Some(v1) -> {
                let b = bytes_concat_all([b"(", wide, b")(", as_num(v1, t), b")"]);
                let op = if name == b"checked_add" { b" + " }
                else if name == b"checked_sub" { b" - " }
                else { b" * " };
                Some(bytes_concat_all([a, op, b]))
              },
            }
          };
          match exact {
            None -> None,
            Some(x) -> {
              let r = fresh(emitter);
              let computed = line(
                r.emitter,
                bytes_concat_all([wide, b" ", r.name, b" = ", x, b";"]),
              );
              let ans = fresh(computed);
              let declared = line(
                ans.emitter,
                bytes_concat_all([
                  b"Word ",
                  ans.name,
                  b" = rt_nullary_p(ctx, ",
                  tag_text(emitter, none),
                  b");",
                ]),
              );
              let fits = if wide == b"uint64_t" {
                bytes_concat_all([r.name, b" <= (uint64_t)", int_lit(width_max(t))])
              } else {
                bytes_concat_all([
                  r.name,
                  b" >= ",
                  int_lit(width_min(t)),
                  b" && ",
                  r.name,
                  b" <= ",
                  int_lit(width_max(t)),
                ])
              };
              let made = line(
                declared,
                bytes_concat_all([
                  b"if (",
                  fits,
                  b") { Word w[] = { ply_imm((int64_t)",
                  r.name,
                  b") }; ",
                  ans.name,
                  b" = rt_ctor_p(ctx, ",
                  tag_text(emitter, some),
                  b", (Word)(intptr_t)w, 1); }",
                ]),
              );
              Some({
                emitter: note_holder(check(made), ans.name),
                value: { kind: KBoxed, expr: ans.name, ty: TyOpen([]) },
              })
            },
          }
        },
      },
    },
  }

fn of_int_width(name: Bytes) -> Option<Width> =
  if name == b"u8_of_int" { width_named(b"U8") }
  else if name == b"u16_of_int" { width_named(b"U16") }
  else if name == b"u32_of_int" { width_named(b"U32") }
  else if name == b"u64_of_int" { width_named(b"U64") }
  else if name == b"i8_of_int" { width_named(b"I8") }
  else if name == b"i16_of_int" { width_named(b"I16") }
  else if name == b"i32_of_int" { width_named(b"I32") }
  else if name == b"i64_of_int" { width_named(b"I64") }
  else if name == b"u128_of_int" { width_named(b"U128") }
  else if name == b"i128_of_int" { width_named(b"I128") }
  else { None }

fn int_of_width(name: Bytes) -> Option<Width> =
  if name == b"int_of_u8" { width_named(b"U8") }
  else if name == b"int_of_u16" { width_named(b"U16") }
  else if name == b"int_of_u32" { width_named(b"U32") }
  else if name == b"int_of_u64" { width_named(b"U64") }
  else if name == b"int_of_i8" { width_named(b"I8") }
  else if name == b"int_of_i16" { width_named(b"I16") }
  else if name == b"int_of_i32" { width_named(b"I32") }
  else if name == b"int_of_i64" { width_named(b"I64") }
  else if name == b"int_of_u128" { width_named(b"U128") }
  else if name == b"int_of_i128" { width_named(b"I128") }
  else { None }

fn is_width_builtin(name: Bytes) -> Bool =
  is_wrap(name) || is_saturating(name) || is_checked(name) || of_int_width(name) != None
    || int_of_width(name) != None

fn width_arity(name: Bytes) -> Int =
  if is_wrap(name) || is_saturating(name) || (is_checked(name) && name != b"checked_neg") { 2 }
  else { 1 }

/// A width builtin used as a value is a lambda around its own call, so the call is compiled at the
/// type the checker settled, as a direct one is: the runtime's builtin would read the words untyped.
fn width_closure(code: Code, name: Bytes) -> Code = {
  let n = width_arity(name);
  let at = |node: Node| { own: Borrowed, node: node, span: code.span };
  at(
    NLambda({
      params: n,
      size: n,
      captures: [],
      at: code.span,
      body: at(
        NApp({
          func: at(NVar({ name: name, slot: None })),
          args: map(range(0, n), |i: Int|
            at(NVar({ name: bytes_concat(b"p", ascii_of_int(i)), slot: Some(i) }))),
        }),
      ),
    }),
  )
}

/// Each width builtin used as a value written out as the lambda `width_closure` makes, before a body
/// is emitted, so emitting never writes code it then emits. A name a call applies stays a call.
fn widths_closed(emitter: Emitter, c: Code) -> Code / {abort.raise} = {
  let go = |x: Code| widths_closed(emitter, x);
  let maybe = |x: Option<Code>| match x { Some(y) -> Some(go(y)), None -> None };
  let node = match c.node {
    NVar(v) -> c.node,
    NLit(_) -> c.node,
    NLabel(_) -> c.node,
    NUnary(u) -> NUnary({ ..u, operand: go(u.operand) }),
    NBinary(b) -> NBinary({ ..b, lhs: go(b.lhs), rhs: go(b.rhs) }),
    NApp(a) ->
      NApp({
        func: match a.func.node { NVar(_) -> a.func, _ -> go(a.func) },
        args: map(a.args, go),
      }),
    NIf(i) ->
      NIf({ cond: go(i.cond), then_branch: go(i.then_branch), else_branch: go(i.else_branch) }),
    NBlock(b) ->
      NBlock({
        stmts: map(b.stmts, |stmt: CodeStmt|
          match stmt {
            CLet(l) -> CLet({ ..l, value: go(l.value) }),
            CLetPat(l) -> CLetPat({ ..l, value: go(l.value) }),
            CDo(d) -> CDo({ code: go(d.code) }),
          }),
        tail: maybe(b.tail),
      }),
    NList(l) -> NList({ items: map(l.items, go) }),
    NRecord(r) -> NRecord({ fields: map(r.fields, |f: CodeField| { ..f, value: go(f.value) }) }),
    NMatch(m) ->
      NMatch({
        scrutinee: go(m.scrutinee),
        arms: map(m.arms, |a: CodeArm| { ..a, guard: maybe(a.guard), body: go(a.body) }),
      }),
    NPerform(p) -> NPerform({ ..p, label: maybe(p.label), args: map(p.args, go) }),
    NCell(cl) -> NCell({ ..cl, init: go(cl.init), body: go(cl.body) }),
    NLambda(l) -> NLambda({ ..l, body: go(l.body) }),
    NSimulate(x) -> NSimulate({ ..x, body: go(x.body) }),
    NParallel(pr) -> NParallel({ ..pr, branches: map(pr.branches, go) }),
    NHandle(h) ->
      NHandle({
        body: go(h.body),
        clauses: map(h.clauses, |k: CodeClause| { ..k, label: maybe(k.label), body: go(k.body) }),
        ret: match h.ret { Some(r) -> Some({ ..r, body: go(r.body) }), None -> None },
      }),
    NField(f) -> NField({ ..f, base: go(f.base) }),
    NUpdate(u) ->
      NUpdate({
        ..u,
        base: go(u.base),
        sets: map(u.sets, |f: CodeField| { ..f, value: go(f.value) }),
      }),
    // A lambda run in place is closed as its owner closes it, under the owner's names.
    NInlined(x) ->
      NInlined({
        ..x,
        func: go(x.func),
        args: map(x.args, go),
        lambda: {
          ..x.lambda,
          body: match lent_lambda(emitter, x.owner, x.lambda.at.start, x.nth) {
            Some(bl) ->
              widths_closed(
                { ..emitter, module: bl.module, here: bl.here, imports: bl.imports },
                x.lambda.body,
              ),
            None -> x.lambda.body,
          },
        },
      }),
  };
  match c.node {
    NVar(v) -> if bare_width(emitter, v.name, v.slot) { width_closure(c, v.name) } else { c },
    _ -> { ..c, node: node },
  }
}

/// A name that is a width builtin and not a local, a constructor or a definition, as `expr` reads one.
fn bare_width(emitter: Emitter, name: Bytes, slot: Option<Int>) -> Bool / {abort.raise} =
  slot == None && !is_ctor_name(name) && is_width_builtin(name)
    && (match def_of(emitter, name) { Some(_) -> false, None -> true })

/// Wrapping, checked arithmetic and conversions over a carried width, in place; otherwise the
/// runtime's call on the evaluated values. The wrapping and checked families work at the type the
/// checker settled at `at`, their name.
fn width_builtin(
  emitter: Emitter,
  name: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
  span: Span,
  at: Span,
) -> Option<WithValue> / {abort.raise} =
  if (is_wrap(name) || is_saturating(name) || is_checked(name)) && len(args) == width_arity(name) {
    let emitter = operand_needed(emitter, at);
    match operand_at(emitter, at) {
      None -> Some(unsettled_operator(emitter, name)),
      Some(t) -> match args_evaled(emitter, args, params, 0, []) {
        None -> None,
        Some(e0) -> {
          let e = site(e0.emitter, span);
          match t {
            // Saturating and checked arithmetic is exact in 64 bits below them, and the runtime's at 64.
            OWidth(w) -> if !in_imm(w) && !(carried(w) && is_wrap(name)) {
              Some(builtin_call(e, name, e0.vals))
            } else if is_checked(name) { checked_num(e, name, e0.vals, w) } else {
              match list_at(e0.vals, 0) {
                None -> None,
                Some(v0) -> match list_at(e0.vals, 1) {
                  None -> None,
                  Some(v1) -> if is_saturating(name) { Some(saturated(e, name, v0, v1, w)) }
                  else { Some(wrapped(e, name, v0, v1, w)) },
                },
              }
            },
            _ -> Some(builtin_call(e, name, e0.vals)),
          }
        },
      },
    }
  } else if !((of_int_width(name) != None || int_of_width(name) != None) && len(args) == 1) { None }
  else {
    match args_evaled(emitter, args, params, 0, []) {
      None -> None,
      Some(e0) -> match list_at(e0.vals, 0) {
        None -> None,
        Some(v0) -> {
          let e = { emitter: site(e0.emitter, span), vals: e0.vals };
          match of_int_width(name) {
            Some(t) -> if carried(t) && !in_imm(t) {
              // An `I64` is any `Int`; a `U64` any but a negative one.
              let held = bind(e.emitter, KInt, as_int(v0));
              let g = if t.signed { held.emitter } else {
                line(
                  held.emitter,
                  bytes_concat_all([
                    b"if (",
                    held.value.expr,
                    b" < 0) { rt_not_that_width_p(ctx, ",
                    ascii_of_int(width_index(t)),
                    b", ",
                    held.value.expr,
                    b"); ",
                    leaving(held.emitter),
                    b" }",
                  ]),
                )
              };
              Some(
                bind(g, KNum(t), bytes_concat_all([b"(", ctype(KNum(t)), b")", held.value.expr])),
              )
            } else if carried(t) {
              let held = bind(e.emitter, KInt, as_int(v0));
              let g = line(
                held.emitter,
                bytes_concat_all([
                  b"if (",
                  held.value.expr,
                  b" < ",
                  int_lit(width_min(t)),
                  b" || ",
                  held.value.expr,
                  b" > ",
                  int_lit(width_max(t)),
                  b") { rt_not_that_width_p(ctx, ",
                  ascii_of_int(width_index(t)),
                  b", ",
                  held.value.expr,
                  b"); ",
                  leaving(held.emitter),
                  b" }",
                ]),
              );
              Some(
                bind(g, KNum(t), bytes_concat_all([b"(", ctype(KNum(t)), b")", held.value.expr])),
              )
            } else { Some(builtin_call(e.emitter, name, e.vals)) },
            None -> match int_of_width(name) {
              // A `U64` past an `Int` is the runtime's to refuse.
              Some(t) -> if carried(t) && (in_imm(t) || t.signed) {
                Some(bind(e.emitter, KInt, as_int(v0)))
              } else { Some(builtin_call(e.emitter, name, e.vals)) },
              None -> None,
            },
          }
        },
      },
    }
  }

fn wrapped(emitter: Emitter, name: Bytes, v0: CValue, v1: CValue, t: Width) -> WithValue = {
  let u = unsigned_ctype(t);
  let a = as_num(v0, t);
  if name == b"rotr" || name == b"rotl" {
    // A rotation left is one right by the rest of the width.
    let k = bind(
      emitter,
      KInt,
      bytes_concat_all([
        b"((",
        if name == b"rotl" { b"-" } else { b"" },
        b"((",
        as_int(v1),
        b") % ",
        ascii_of_int(t.bits),
        b")) % ",
        ascii_of_int(t.bits),
        b" + ",
        ascii_of_int(t.bits),
        b") % ",
        ascii_of_int(t.bits),
      ]),
    );
    bind(
      k.emitter,
      KNum(t),
      bytes_concat_all([
        b"(",
        u,
        b")(",
        k.value.expr,
        b" == 0 ? (",
        u,
        b")(",
        a,
        b") : ((",
        u,
        b")(",
        a,
        b") >> ",
        k.value.expr,
        b") | ((",
        u,
        b")(",
        a,
        b") << (",
        ascii_of_int(t.bits),
        b" - ",
        k.value.expr,
        b")))",
      ]),
    )
  } else {
    let c = if name == b"wrap_add" { b"+" } else if name == b"wrap_sub" { b"-" } else { b"*" };
    // Below 32 bits C would promote the operands to `int`, where a product can overflow.
    bind(
      emitter,
      KNum(t),
      bytes_concat_all([
        b"(",
        u,
        b")((uint64_t)(",
        u,
        b")(",
        a,
        b") ",
        c,
        b" (uint64_t)(",
        u,
        b")(",
        as_num(v1, t),
        b"))",
      ]),
    )
  }
}

/// A list's, a byte string's or an array's length, read off its header: an array holding its
/// elements in place counts its words a stride at a time.
fn length_of(name: Bytes, w: Bytes) -> Bytes =
  if name == b"array_len" { bytes_concat_all([b"ply_array_len(", w, b")"]) }
  else { bytes_concat_all([b"(int64_t)ply_obj(", w, b")->len"]) }

/// A kind test: the header's field (or a bounds-tested byte) fast, the runtime's call slow, which raises on a wrong kind.
fn kind_tested(
  emitter: Emitter,
  name: Bytes,
  value: CValue,
  index: Option<CValue>,
) -> WithValue / {abort.raise} = {
  let t = bind(emitter, KBoxed, as_word(value));
  let out = fresh(t.emitter);
  let o1 = line(out.emitter, bytes_concat_all([b"int64_t ", out.name, b" = 0;"]));
  let ok = fresh(o1);
  let kind = if name == b"len" { b"5" } else if name == b"array_len" { b"15" } else { b"10" };
  let o2 = line(
    ok.emitter,
    bytes_concat_all([
      b"int ",
      ok.name,
      b" = (!ply_is_imm(",
      t.value.expr,
      b") && ",
      t.value.expr,
      b" != 0 && ply_obj(",
      t.value.expr,
      b")->kind == ",
      kind,
      b");",
    ]),
  );
  let body = match index {
    Some(iv) -> {
      let idx = bind(o2, KInt, as_int(iv));
      let opened = line(
        idx.emitter,
        bytes_concat_all([
          b"if (",
          ok.name,
          b" && (uint64_t)",
          idx.value.expr,
          b" < (uint64_t)ply_obj(",
          t.value.expr,
          b")->len) { ",
          out.name,
          b" = (int64_t)(ply_bytes(",
          t.value.expr,
          b"))[",
          idx.value.expr,
          b"]; } else {",
        ]),
      );
      line(
        check(
          line(
            line(indent(opened), bytes_concat_all([b"ply_inc(", t.value.expr, b");"])),
            bytes_concat_all([
              b"Word r = ",
              builtin_call_over(name, [
                t.value.expr,
                bytes_concat_all([
                  b"(ply_fits_imm(",
                  idx.value.expr,
                  b") ? ply_imm(",
                  idx.value.expr,
                  b") : rt_box_int_p(ctx, ",
                  idx.value.expr,
                  b"))",
                ]),
              ]),
              b";",
            ]),
          ),
        ),
        bytes_concat_all([out.name, b" = ply_imm_value(r);"]),
      )
    },
    None -> {
      let opened = line(
        o2,
        bytes_concat_all([
          b"if (",
          ok.name,
          b") { ",
          out.name,
          b" = ",
          length_of(name, t.value.expr),
          b"; } else {",
        ]),
      );
      line(
        check(
          line(
            line(indent(opened), bytes_concat_all([b"ply_inc(", t.value.expr, b");"])),
            bytes_concat_all([b"Word r = ", builtin_call_over(name, [t.value.expr]), b";"]),
          ),
        ),
        bytes_concat_all([out.name, b" = ply_imm_value(r);"]),
      )
    },
  };
  { emitter: close(body), value: { kind: KInt, expr: out.name, ty: TyOpen([]) } }
}

/// `bytes_concat_all([a, b, ..])` joins the pieces without building the list.
fn inline_join(
  emitter: Emitter,
  args: List<Code>,
  params: List<EmitParam>,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  match list_at(args, 0) {
    None -> None,
    Some(x) -> match x.node {
      NList(l) -> match items(emitter, l.items, params, 0, []) {
        None -> None,
        Some(w) -> {
          let arr = fresh(w.emitter);
          let e = line(
            arr.emitter,
            bytes_concat_all([
              b"Word ",
              arr.name,
              b"[] = {",
              if len(w.names) == 0 { b"0" } else { bytes_join(w.names, b", ") },
              b"};",
            ]),
          );
          let o = bind(
            e,
            KBoxed,
            bytes_concat_all([
              b"rt_bytes_join_p(ctx, (Word)(intptr_t)",
              arr.name,
              b", ",
              ascii_of_int(len(l.items)),
              b")",
            ]),
          );
          Some({ emitter: check(o.emitter), value: o.value })
        },
      },
      _ -> match expr(notail(emitter), x, params) {
        None -> None,
        Some(o) -> Some(builtin_call(site(o.emitter, span), b"bytes_concat_all", [o.value])),
      },
    },
  }

/// `bytes_u32_le` reads four bytes through `memcpy`, which C compilers lower to one unaligned load.
fn inline_at(
  emitter: Emitter,
  args: List<Code>,
  params: List<EmitParam>,
  wide: Bool,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  match list_at(args, 0) {
    None -> None,
    Some(b0) -> match list_at(args, 1) {
      None -> None,
      Some(i0) -> match expr(notail(emitter), b0, params) {
        None -> None,
        // The bytes are read before the index and bound after: the index may read `b` at its last use and null it.
        Some(bv0) -> {
          let bv = secure_across(bv0.emitter, bv0.value, i0, params);
          match expr(notail(bv.emitter), i0, params) {
            None -> None,
            // Over bytes of unfixed kind, `bytes_u32_le` is the runtime's call.
            Some(iv0) -> {
              let iv = { emitter: site(iv0.emitter, span), value: iv0.value };
              if bv.value.ty != TyBytes {
                if wide { Some(builtin_call(iv.emitter, b"bytes_u32_le", [bv.value, iv.value])) }
                else { Some(kind_tested(iv.emitter, b"bytes_at", bv.value, Some(iv.value))) }
              } else {
                let t = bind(iv.emitter, KBoxed, as_word(bv.value));
                let idx = bind(t.emitter, KInt, as_int(iv.value));
                let g = line(
                  idx.emitter,
                  bytes_concat_all([
                    b"if ((uint64_t)",
                    idx.value.expr,
                    if wide { b" + 4 > " } else { b" >= " },
                    b"(uint64_t)ply_obj(",
                    t.value.expr,
                    b")->len) { ply_inc(",
                    t.value.expr,
                    b"); ",
                    builtin_call_over(if wide { b"bytes_u32_le" } else { b"bytes_at" }, [
                      t.value.expr,
                      bytes_concat_all([b"ply_imm(", idx.value.expr, b")"]),
                    ]),
                    b"; ",
                    leaving(idx.emitter),
                    b" }",
                  ]),
                );
                if wide {
                  let w = fresh(g);
                  Some({
                    emitter: line(
                      w.emitter,
                      bytes_concat_all([
                        b"uint32_t ",
                        w.name,
                        b"; memcpy(&",
                        w.name,
                        b", ply_bytes(",
                        t.value.expr,
                        b") + ",
                        idx.value.expr,
                        b", 4);",
                      ]),
                    ),
                    value: {
                      kind: KNum({ bits: 32, signed: false }),
                      expr: bytes_concat_all([b"ply_le32(", w.name, b")"]),
                      ty: TyOpen([]),
                    },
                  })
                } else {
                  Some(
                    bind(
                      g,
                      KInt,
                      bytes_concat_all([
                        b"(int64_t)(ply_bytes(",
                        t.value.expr,
                        b"))[",
                        idx.value.expr,
                        b"]",
                      ]),
                    ),
                  )
                }
              }
            },
          }
        },
      },
    },
  }

/// Over an array of known kind, a bounds-tested load; anything else is the runtime's call.
fn inline_get(
  emitter: Emitter,
  args: List<Code>,
  params: List<EmitParam>,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  match list_at(args, 0) {
    None -> None,
    Some(a0) -> match list_at(args, 1) {
      None -> None,
      Some(i0) -> match expr(notail(emitter), a0, params) {
        None -> None,
        Some(av0) -> match av0.value.ty {
          TyArr(Some(element)) -> {
            // The array is read before the index and bound after, as `inline_at` reads its bytes.
            let av = secure_across(av0.emitter, av0.value, i0, params);
            match expr(notail(av.emitter), i0, params) {
              None -> None,
              Some(iv0) -> {
                let t = bind(site(iv0.emitter, span), KBoxed, as_word(av.value));
                let idx = bind(t.emitter, KInt, as_int(iv0.value));
                let g = line(
                  idx.emitter,
                  bytes_concat_all([
                    b"if ((uint64_t)",
                    idx.value.expr,
                    b" >= (uint64_t)ply_array_len(",
                    t.value.expr,
                    b")) { ply_inc(",
                    t.value.expr,
                    b"); ",
                    builtin_call_over(b"array_get", [
                      t.value.expr,
                      bytes_concat_all([
                        b"(ply_fits_imm(",
                        idx.value.expr,
                        b") ? ply_imm(",
                        idx.value.expr,
                        b") : rt_box_int_p(ctx, ",
                        idx.value.expr,
                        b"))",
                      ]),
                    ]),
                    b"; ",
                    leaving(idx.emitter),
                    b" }",
                  ]),
                );
                Some(element_read(g, t.value.expr, idx.value.expr, element))
              },
            }
          },
          _ -> None,
        },
      },
    },
  }

/// Element `i` of array `a`, whose elements are held as a record's field `e` of their type is: a
/// record in place as the address of its header there, a `Float` or a 64-bit width as its bits,
/// anything else as its word, each held as the array's element is once read.
fn element_read(emitter: Emitter, a: Bytes, i: Bytes, element: FieldTy) -> WithValue = {
  let r = fresh(emitter);
  match element.ty {
    TyRec(fs) -> {
      let l = laid_of(fs);
      let loaded = line(
        r.emitter,
        bytes_concat_all([
          b"Word ",
          r.name,
          b" = (Word)(intptr_t)(ply_words(",
          a,
          b") + ",
          i,
          b" * ",
          ascii_of_int(2 + l.width + l.tail),
          b"); ply_inc(",
          r.name,
          b");",
        ]),
      );
      {
        emitter: note_holder(loaded, r.name),
        value: { kind: KBoxed, expr: r.name, ty: element.ty },
      }
    },
    _ -> if raw_slot(element.kind) {
      let at = if raw_words(element.kind) == 1 { i }
      else { bytes_concat_all([b"(", i, b") * ", ascii_of_int(raw_words(element.kind))]) };
      let loaded = line(
        r.emitter,
        bytes_concat_all([
          ctype(element.kind),
          b" ",
          r.name,
          b" = ",
          raw_at(a, at, element.kind),
          b";",
        ]),
      );
      { emitter: loaded, value: { kind: element.kind, expr: r.name, ty: TyOpen([]) } }
    } else {
      let loaded = line(
        r.emitter,
        bytes_concat_all([
          b"Word ",
          r.name,
          b" = ply_words(",
          a,
          b")[",
          i,
          b"]; ply_inc(",
          r.name,
          b");",
        ]),
      );
      {
        emitter: note_holder(loaded, r.name),
        value: { kind: KBoxed, expr: r.name, ty: element.ty },
      }
    },
  }
}

fn is_inlined(name: Bytes) -> Bool =
  name == b"len" || name == b"bytes_len" || name == b"bytes_at" || name == b"bytes_u32_le"
    || name == b"bytes_concat_all"

/// Callback builtins that are not a plain runtime call: `fold` may fuse, `iterate` may loop in place.
fn is_callback(name: Bytes) -> Bool = name == b"fold" || name == b"iterate"

/// Calls of one builtin share an index; constants deliberately do not.
fn builtin_of(emitter: Emitter, name: Bytes) -> { emitter: Emitter, i: Int } =
  match fold(range(0, len(emitter.called_builtins)), None, |acc: Option<Int>, i: Int|
      match list_at(emitter.called_builtins, i) {
        Some(x) -> if x == name { Some(i) } else { acc },
        None -> acc,
      }) {
    Some(i) -> { emitter: emitter, i: i },
    None ->
      {
        emitter: {
          out: emitter.out,
          temp_count: emitter.temp_count,
          unboxed: emitter.unboxed,
          indent: emitter.indent,
          reads: emitter.reads,
          shapes: emitter.shapes,
          built: emitter.built,
          module: emitter.module,
          base: emitter.base,
          count_locals: emitter.count_locals,
          here: emitter.here,
          imports: emitter.imports,
          consts: emitter.consts,
          ctors: emitter.ctors,
          lambda_bodies: emitter.lambda_bodies,
          lambdas: emitter.lambdas,
          owner: emitter.owner,
          builtins: emitter.builtins,
          called_builtins: push(emitter.called_builtins, name),
          fields: emitter.fields,
          released: emitter.released,
          reuse_widths: emitter.reuse_widths,
          alias: emitter.alias,
          by_root: emitter.by_root,
          tail: emitter.tail,
          calls: emitter.calls,
          generics: emitter.generics,
          refused: emitter.refused,
          deferred: emitter.deferred,
          deferred_locals: emitter.deferred_locals,
          performs: emitter.performs,
          handles: emitter.handles,
          landing: emitter.landing,
          effects: emitter.effects,
          release: emitter.release,
          pinned: emitter.pinned,
          bound: emitter.bound,
          group: emitter.group,
          operands: emitter.operands,
          typed: emitter.typed,
          answer: emitter.answer,
          site_root: emitter.site_root,
          lent: emitter.lent,
          written: emitter.written,
        },
        i: len(emitter.called_builtins),
      },
  }

/// The runtime's helper for a builtin, named for it. An elaboration's `?` is spelled out, since no C
/// name holds one.
pub fn builtin_helper(name: Bytes) -> Bytes / {abort.raise} =
  if bytes_starts_with(name, b"?") {
    bytes_concat(b"builtin_elaborated_", bytes_slice(name, 1, bytes_len(name)))
  } else { bytes_concat(b"builtin_", name) }

/// A call of a builtin's helper over the words it takes, each already the callee's.
fn builtin_call_over(name: Bytes, words: List<Bytes>) -> Bytes / {abort.raise} =
  bytes_concat_all([
    builtin_helper(name),
    b"_p(ctx",
    fold(words, b"", |acc: Bytes, word: Bytes| bytes_concat_all([acc, b", ", word])),
    b")",
  ])

/// Two passes: every argument evaluated, the site stored, then each duplicated; a compiled call interleaves (`args_one_pass`).
fn args_owned_at(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  span: Span,
) -> Option<{ emitter: Emitter, names: List<Bytes> }> / {abort.raise} =
  match args_evaled(emitter, codes, params, 0, []) {
    None -> None,
    Some(e) ->
      Some(
        fold(
          e.vals,
          { emitter: site(e.emitter, span), names: [] },
          |a: { emitter: Emitter, names: List<Bytes> }, value: CValue| {
            let w = owned(a.emitter, value);
            { emitter: w.emitter, names: push(a.names, w.value.expr) }
          },
        ),
      ),
  }

fn args_owned(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  i: Int,
  acc: List<Bytes>,
) -> Option<{ emitter: Emitter, names: List<Bytes> }> / {abort.raise} =
  match args_evaled(emitter, codes, params, i, []) {
    None -> None,
    Some(e) ->
      Some(
        fold(
          e.vals,
          { emitter: e.emitter, names: acc },
          |a: { emitter: Emitter, names: List<Bytes> }, value: CValue| {
            let w = owned(a.emitter, value);
            { emitter: w.emitter, names: push(a.names, w.value.expr) }
          },
        ),
      ),
  }

/// A builtin called over what its arguments evaluated to, each duplicated here.
fn builtin_call(emitter: Emitter, name: Bytes, vals: List<CValue>) -> WithValue / {abort.raise} = {
  let w = fold(
    vals,
    { emitter: emitter, names: [] },
    |a: { emitter: Emitter, names: List<Bytes> }, value: CValue| {
      let o = owned(a.emitter, value);
      { emitter: o.emitter, names: push(a.names, o.value.expr) }
    },
  );
  let o = bind(w.emitter, KBoxed, builtin_call_over(name, w.names));
  { emitter: check(o.emitter), value: o.value }
}

/// Whatever the callee evaluates to, called through the runtime: the callee is duplicated, then each argument as evaluated.
fn call_value(
  emitter: Emitter,
  func: Code,
  args: List<Code>,
  params: List<EmitParam>,
  span: Span,
) -> Option<WithValue> / {abort.raise} =
  match expr(notail(emitter), func, params) {
    None -> None,
    Some(f) -> {
      let fo = owned(calling(f.emitter, f.value, params), f.value);
      match args_one_pass(fo.emitter, args, params, 0, []) {
        None -> None,
        Some(w) -> {
          let arr = fresh(w.emitter);
          let e = line(
            arr.emitter,
            bytes_concat_all([
              b"Word ",
              arr.name,
              b"[] = {",
              if len(w.names) == 0 { b"0" } else { bytes_join(w.names, b", ") },
              b"};",
            ]),
          );
          let o = bind(
            site(e, span),
            KBoxed,
            bytes_concat_all([
              b"rt_call_p(ctx, ",
              fo.value.expr,
              b", (Word)(intptr_t)",
              arr.name,
              b", ",
              ascii_of_int(len(args)),
              b")",
            ]),
          );
          Some({ emitter: check(o.emitter), value: o.value })
        },
      }
    },
  }

/// The emitter noting that this body calls the parameter `value` is, where it is one.
fn calling(emitter: Emitter, value: CValue, params: List<EmitParam>) -> Emitter =
  match param_of(emitter, value, params) {
    Some(i) -> {
      let g = emitter.generics;
      if contains(g.called, i) { emitter }
      else { note_generics(emitter, { ..g, called: push(g.called, i) }) }
    },
    None -> emitter,
  }

/// A parameter the prologue did not open is outside the window and read as its own word.
fn caps_owned(
  emitter: Emitter,
  captures: List<Capture>,
  params: List<EmitParam>,
  i: Int,
  acc: List<Bytes>,
) -> Option<{ emitter: Emitter, names: List<Bytes> }> =
  if i >= len(captures) { Some({ emitter: emitter, names: acc }) } else {
    match list_at(captures, i) {
      None -> None,
      Some(c) -> {
        let found = match conv_of(emitter, c.src) {
          Some(v) -> Some(v),
          None -> match list_at(params, c.src) {
            Some(p) -> if counted(p.kind) {
              Some({ kind: p.kind, expr: bytes_concat(b"p", ascii_of_int(c.src)), ty: p.ty })
            } else { None },
            None -> None,
          },
        };
        match found {
          None ->
            Some({ emitter: poison(emitter, b"a capture this port has not bound"), names: acc }),
          Some(v) -> {
            let mv = move_read(emitter, c.own, v);
            let w = owned(mv.emitter, mv.value);
            caps_owned(w.emitter, captures, params, i + 1, push(acc, w.value.expr))
          },
        }
      },
    }
  }

/// A lambda's C parameters are its captures then its own, all words, none opened at entry.
/// It continues the unit's tables from its builder and hands additions back; a fresh copy would renumber from zero.
fn emit_lambda(
  emitter: Emitter,
  name: Bytes,
  l: Lambda,
) -> Option<{ text: Bytes, extra: Bytes, met: List<Bytes>, consts: List<Lit>, shapes: List<List<Bytes>>, fields: List<Bytes>, lambdas: List<Bytes>, calls: List<Bytes>, generics: Generics, performs: List<Bytes>, handles: List<Bytes>, refused: Option<Bytes> }> / {abort.raise} = {
  let n = len(l.captures) + l.params;
  let window = fold(
    range(0, l.params),
    fold(range(0, len(l.captures)), [], |acc: List<Unboxed>, i: Int|
      match list_at(l.captures, i) {
        Some(c) ->
          push(acc, {
            slot: c.dst,
            kind: KBoxed,
            expr: bytes_concat(b"q", ascii_of_int(i)),
            ty: TyOpen([]),
          }),
        None -> acc,
      }),
    |acc: List<Unboxed>, j: Int|
      push(acc, {
        slot: j,
        kind: KBoxed,
        expr: bytes_concat(b"q", ascii_of_int(len(l.captures) + j)),
        ty: TyOpen([]),
      }),
  );
  let reads = slots_read(l.body);
  // Nothing in a lambda's body is a tail, so an update at its end keeps the one-read guard.
  let start = {
    out: [],
    temp_count: 0,
    unboxed: window,
    indent: 0,
    reads: reads,
    shapes: emitter.shapes,
    built: [],
    module: emitter.module,
    base: emitter.base,
    count_locals: [],
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: b"",
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: [],
    reuse_widths: [],
    alias: [],
    by_root: [],
    tail: false,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: [],
    deferred_locals: [],
    performs: emitter.performs,
    handles: emitter.handles,
    landing: None,
    effects: emitter.effects,
    release: emitter.release,
    pinned: [],
    bound: [],
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: KBoxed,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
  };
  let charged = fold(window, start, |acc: Emitter, w: Unboxed|
    note_bound(note_holder(charge(acc, w.slot, w.expr), w.expr), w.expr));
  match expr(charged, l.body, []) {
    None -> None,
    Some(o0) -> {
      let w = returned(o0.emitter, o0.value);
      let o = { emitter: w.emitter, value: o0.value };
      Some({
        met: o.emitter.called_builtins,
        consts: o.emitter.consts,
        shapes: o.emitter.shapes,
        fields: o.emitter.fields,
        lambdas: o.emitter.lambdas,
        calls: o.emitter.calls,
        generics: o.emitter.generics,
        performs: o.emitter.performs,
        handles: o.emitter.handles,
        refused: o.emitter.refused,
        extra: o.emitter.lambda_bodies,
        text: bytes_concat_all([
          b"Word ",
          name,
          b"_entry(PlyCtx *ctx, const Word *args);\n",
          b"Word ",
          name,
          b"(PlyCtx *ctx",
          fold(range(0, n), b"", |acc: Bytes, i: Int|
            bytes_concat_all([acc, b", Word q", ascii_of_int(i)])),
          b") {\n",
          fuel_head(bytes_concat(name, b"_entry"), b"", param_names(b"q", n), Whole(KBoxed)),
          fold(sorted_widths(o.emitter.reuse_widths), b"", |acc: Bytes, w: Int|
            bytes_concat_all([acc, b"  Word tok", ascii_of_int(w), b" = 0;\n"])),
          fold(o.emitter.deferred_locals, b"", |acc: Bytes, r: Bytes|
            bytes_concat_all([acc, b"  Word ", r, b" = 0;\n"])),
          bytes_join(o.emitter.out, b""),
          toks_freed(o.emitter.reuse_widths),
          b"  ctx->fuel += 1;\n  return ",
          w.expr,
          b";\n}\n",
          b"Word ",
          name,
          b"_entry(PlyCtx *ctx, const Word *args) {\n  return ",
          name,
          b"(ctx",
          fold(range(0, n), b"", |acc: Bytes, i: Int|
            bytes_concat_all([acc, b", args[", ascii_of_int(i), b"]"])),
          b");\n}\n",
        ]),
      })
    },
  }
}

/// The line before a return that frees each token the body filled and nothing took.
fn toks_freed(widths: List<Int>) -> Bytes =
  if len(widths) == 0 { b"" } else { bytes_concat_all([b"  ", toks_freeing(widths), b"\n"]) }

fn toks_freeing(widths: List<Int>) -> Bytes =
  bytes_join(
    map(sorted_widths(widths), |w: Int|
      bytes_concat_all([
        b"if (tok",
        ascii_of_int(w),
        b") ply_dec(ctx, tok",
        ascii_of_int(w),
        b");",
      ])),
    b" ",
  )

/// Where a group member returns: what frees the group's tokens, known once every member is emitted.
fn toks_mark() -> Bytes = b"/*toks*/"

/// A compiled call's arguments: each duplicated as soon as it is evaluated, unlike a builtin's.
fn args_one_pass(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  i: Int,
  acc: List<Bytes>,
) -> Option<{ emitter: Emitter, names: List<Bytes> }> / {abort.raise} =
  if i >= len(codes) { Some({ emitter: emitter, names: acc }) } else {
    match list_at(codes, i) {
      None -> None,
      Some(x) -> match expr(notail(emitter), x, params) {
        None -> None,
        Some(o) -> {
          let w = owned(o.emitter, o.value);
          args_one_pass(w.emitter, codes, params, i + 1, push(acc, w.value.expr))
        },
      },
    }
  }

/// Each argument as the callee carries it: an owned word, or the value in its own C type.
fn args_carried(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  carriers: List<Carrier>,
  i: Int,
  acc: List<Bytes>,
) -> Option<{ emitter: Emitter, names: List<Bytes> }> / {abort.raise} =
  if i >= len(codes) { Some({ emitter: emitter, names: acc }) } else {
    match list_at(codes, i) {
      None -> None,
      Some(x) -> match expr(notail(emitter), x, params) {
        None -> None,
        Some(o) -> {
          let w = carried_arg(o.emitter, o.value, carrier_at(carriers, i));
          args_carried(w.emitter, codes, params, carriers, i + 1, concat(acc, w.names))
        },
      },
    }
  }

/// The carrier at `i`: a word where nothing says otherwise.
fn carrier_at(carriers: List<Carrier>, i: Int) -> Carrier =
  match list_at(carriers, i) { Some(c) -> c, None -> Whole(KBoxed) }

/// `value` handed to a callee carrying it as `c`: an owned word, a local of its C type, or a local
/// of each field's.
fn carried_arg(
  emitter: Emitter,
  value: CValue,
  c: Carrier,
) -> { emitter: Emitter, names: List<Bytes> } =
  match c {
    Whole(KBoxed) -> {
      let w = owned(emitter, value);
      { emitter: w.emitter, names: [w.value.expr] }
    },
    Whole(KMaybe) -> {
      let w = maybe_owned(emitter, value);
      { emitter: w.emitter, names: [w.value.expr] }
    },
    Whole(k) -> {
      let w = bind(emitter, k, as_kind(value, k));
      { emitter: w.emitter, names: [w.value.expr] }
    },
    Fields(fs) -> {
      let r = record_values(emitter, value, fs);
      fold(
        range(0, len(fs)),
        { emitter: r.emitter, names: [] },
        |acc: { emitter: Emitter, names: List<Bytes> }, k: Int| {
          let f = nth_field(fs, k);
          let w = bind(acc.emitter, f.kind, as_kind(nth_value(r.vals, k), f.kind));
          { emitter: w.emitter, names: push(acc.names, w.value.expr) }
        },
      )
    },
  }

/// The call of `target`, named before its `n` arguments were handed over as `names`, its answer as
/// the root it names hands it back: a record's held back as the fields it returned.
fn called(
  emitter: Emitter,
  target: Target,
  span: Span,
  names: List<Bytes>,
  n: Int,
) -> WithValue / {abort.raise} = {
  let answer = target.carriers.answer;
  let back = written_back(answer);
  let expected = {
    answer: carried_type(returned_kind(answer)),
    params: concat(
      fold(range(0, n), [], |acc: List<Bytes>, i: Int|
        concat(acc, carried_types(carrier_at(target.carriers.params, i)))),
      map(back, |f: FieldTy| bytes_concat(ctype(f.kind), b"*")),
    ),
  };
  let noted = {
    ..emitter,
    generics: {
      ..emitter.generics,
      expects: push(emitter.generics.expects, { callee: target.root, head: expected }),
    },
  };
  // A record answer's later fields come back through locals the call is handed.
  let outs = fold(
    back,
    { emitter: noted, names: [] },
    |acc: { emitter: Emitter, names: List<Bytes> }, f: FieldTy| {
      let o = fresh(acc.emitter);
      {
        emitter: line(o.emitter, bytes_concat_all([ctype(f.kind), b" ", o.name, b";"])),
        names: push(acc.names, o.name),
      }
    },
  );
  let o = bind(
    site(outs.emitter, span),
    returned_kind(answer),
    bytes_concat_all([
      target.symbol,
      b"(ctx",
      fold(names, b"", |acc: Bytes, nm: Bytes| bytes_concat_all([acc, b", ", nm])),
      fold(outs.names, b"", |acc: Bytes, nm: Bytes| bytes_concat_all([acc, b", &", nm])),
      b")",
    ]),
  );
  // A word is opened to the callee's declared type, so a body whose answer is already a word hands it straight back.
  match answer {
    Whole(KBoxed) -> opened_to(check(o.emitter), o.value, target.ret),
    Whole(_) -> { emitter: check(o.emitter), value: { ..o.value, ty: target.ret.ty } },
    Fields(fs) -> {
      let vals = push_front(
        o.value,
        map(range(0, len(back)), |k: Int|
          {
            kind: nth_field(back, k).kind,
            expr: nth_bytes(outs.names, k),
            ty: nth_field(back, k).ty,
          }),
      );
      held_record(check(o.emitter), fs, vals)
    },
  }
}

/// Field `k` of `fs`; one of no name past the end.
fn nth_field(fs: List<FieldTy>, k: Int) -> FieldTy =
  match list_at(fs, k) { Some(f) -> f, None -> { name: b"", kind: KBoxed, ty: TyOpen([]) } }

fn nth_bytes(xs: List<Bytes>, k: Int) -> Bytes = match list_at(xs, k) { Some(x) -> x, None -> b"" }

fn nth_value(vs: List<CValue>, k: Int) -> CValue =
  match list_at(vs, k) { Some(v) -> v, None -> { kind: KBoxed, expr: b"0", ty: TyOpen([]) } }

/// `x` and then `xs`.
fn push_front(x: CValue, xs: List<CValue>) -> List<CValue> = concat([x], xs)

/// The record of fields `fs` whose values are `vals`, held back as their values until its word is
/// asked for.
fn held_record(emitter: Emitter, fs: List<FieldTy>, vals: List<CValue>) -> WithValue =
  build_record(
    emitter,
    map(fs, |f: FieldTy| f.name),
    map(vals, |v: CValue| if raw_slot(v.kind) { raw_word(v) } else { as_word(v) }),
    fs,
    Some(vals),
  )

fn args_evaled(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  i: Int,
  acc: List<CValue>,
) -> Option<{ emitter: Emitter, vals: List<CValue> }> / {abort.raise} =
  if i >= len(codes) { Some({ emitter: emitter, vals: acc }) } else {
    match list_at(codes, i) {
      None -> None,
      Some(x) -> match expr(notail(emitter), x, params) {
        None -> None,
        Some(o) -> {
          let s = secure(o.emitter, o.value);
          args_evaled(s.emitter, codes, params, i + 1, push(acc, s.value))
        },
      },
    }
  }

fn field_of(emitter: Emitter, name: Bytes) -> { emitter: Emitter, i: Int } =
  match fold(range(0, len(emitter.fields)), None, |acc: Option<Int>, i: Int|
      match list_at(emitter.fields, i) {
        Some(x) -> if x == name { Some(i) } else { acc },
        None -> acc,
      }) {
    Some(i) -> { emitter: emitter, i: i },
    None ->
      {
        emitter: {
          out: emitter.out,
          temp_count: emitter.temp_count,
          unboxed: emitter.unboxed,
          indent: emitter.indent,
          reads: emitter.reads,
          shapes: emitter.shapes,
          built: emitter.built,
          module: emitter.module,
          base: emitter.base,
          count_locals: emitter.count_locals,
          here: emitter.here,
          imports: emitter.imports,
          consts: emitter.consts,
          ctors: emitter.ctors,
          lambda_bodies: emitter.lambda_bodies,
          lambdas: emitter.lambdas,
          owner: emitter.owner,
          builtins: emitter.builtins,
          called_builtins: emitter.called_builtins,
          fields: push(emitter.fields, name),
          released: emitter.released,
          reuse_widths: emitter.reuse_widths,
          alias: emitter.alias,
          by_root: emitter.by_root,
          tail: emitter.tail,
          calls: emitter.calls,
          generics: emitter.generics,
          refused: emitter.refused,
          deferred: emitter.deferred,
          deferred_locals: emitter.deferred_locals,
          performs: emitter.performs,
          handles: emitter.handles,
          landing: emitter.landing,
          effects: emitter.effects,
          release: emitter.release,
          pinned: emitter.pinned,
          bound: emitter.bound,
          group: emitter.group,
          operands: emitter.operands,
          typed: emitter.typed,
          answer: emitter.answer,
          site_root: emitter.site_root,
          lent: emitter.lent,
          written: emitter.written,
        },
        i: len(emitter.fields),
      },
  }

fn built_field(emitter: Emitter, local: Bytes, name: Bytes) -> Option<CValue> =
  fold(emitter.built, None, |acc: Option<CValue>, b: Built|
    if b.local != local { acc } else {
      fold(range(0, len(b.names)), acc, |inner: Option<CValue>, i: Int|
        match list_at(b.names, i) {
          Some(n) -> if n == name { list_at(b.vals, i) } else { inner },
          None -> inner,
        })
    })

fn remember_built(
  emitter: Emitter,
  local: Bytes,
  names: List<Bytes>,
  vals: List<CValue>,
) -> Emitter =
  {
    out: emitter.out,
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: push(emitter.built, { local: local, names: names, vals: vals }),
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: emitter.released,
    reuse_widths: emitter.reuse_widths,
    alias: emitter.alias,
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred,
    deferred_locals: emitter.deferred_locals,
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
  }

fn shape_of(emitter: Emitter, names: List<Bytes>) -> { emitter: Emitter, i: Int } =
  match fold(range(0, len(emitter.shapes)), None, |acc: Option<Int>, i: Int|
      match list_at(emitter.shapes, i) {
        Some(sh) -> if same_names(sh, names) { Some(i) } else { acc },
        None -> acc,
      }) {
    Some(i) -> { emitter: emitter, i: i },
    None ->
      {
        emitter: {
          out: emitter.out,
          temp_count: emitter.temp_count,
          unboxed: emitter.unboxed,
          indent: emitter.indent,
          reads: emitter.reads,
          shapes: push(emitter.shapes, names),
          built: emitter.built,
          module: emitter.module,
          base: emitter.base,
          count_locals: emitter.count_locals,
          here: emitter.here,
          imports: emitter.imports,
          consts: emitter.consts,
          ctors: emitter.ctors,
          lambda_bodies: emitter.lambda_bodies,
          lambdas: emitter.lambdas,
          owner: emitter.owner,
          builtins: emitter.builtins,
          called_builtins: emitter.called_builtins,
          fields: emitter.fields,
          released: emitter.released,
          reuse_widths: emitter.reuse_widths,
          alias: emitter.alias,
          by_root: emitter.by_root,
          tail: emitter.tail,
          calls: emitter.calls,
          generics: emitter.generics,
          refused: emitter.refused,
          deferred: emitter.deferred,
          deferred_locals: emitter.deferred_locals,
          performs: emitter.performs,
          handles: emitter.handles,
          landing: emitter.landing,
          effects: emitter.effects,
          release: emitter.release,
          pinned: emitter.pinned,
          bound: emitter.bound,
          group: emitter.group,
          operands: emitter.operands,
          typed: emitter.typed,
          answer: emitter.answer,
          site_root: emitter.site_root,
          lent: emitter.lent,
          written: emitter.written,
        },
        i: len(emitter.shapes),
      },
  }

fn same_names(a: List<Bytes>, b: List<Bytes>) -> Bool =
  len(a) == len(b)
    && fold(a, true, |acc: Bool, x: Bytes|
      acc && fold(b, false, |seen: Bool, y: Bytes| seen || y == x))

/// Values were built in written order; the record holds them in sorted-name order.
fn word_at_rank(names: List<Bytes>, words: List<Bytes>, at: Int) -> Bytes =
  fold(range(0, len(names)), b"", |acc: Bytes, i: Int|
    match list_at(names, i) {
      None -> acc,
      Some(nm) -> if rank_of(names, nm) == at {
        match list_at(words, i) { Some(w) -> w, None -> acc }
      } else { acc },
    })

fn rank_of(names: List<Bytes>, name: Bytes) -> Int =
  fold(names, 0, |acc: Int, n: Bytes| if compare(n, name) == Less { acc + 1 } else { acc })

fn note_tok(emitter: Emitter, w: Int) -> Emitter =
  if fold(emitter.reuse_widths, false, |acc: Bool, x: Int| acc || x == w) { emitter } else {
    {
      out: emitter.out,
      temp_count: emitter.temp_count,
      unboxed: emitter.unboxed,
      indent: emitter.indent,
      reads: emitter.reads,
      shapes: emitter.shapes,
      built: emitter.built,
      module: emitter.module,
      base: emitter.base,
      count_locals: emitter.count_locals,
      here: emitter.here,
      imports: emitter.imports,
      consts: emitter.consts,
      ctors: emitter.ctors,
      lambda_bodies: emitter.lambda_bodies,
      lambdas: emitter.lambdas,
      owner: emitter.owner,
      builtins: emitter.builtins,
      called_builtins: emitter.called_builtins,
      fields: emitter.fields,
      released: emitter.released,
      reuse_widths: push(emitter.reuse_widths, w),
      alias: emitter.alias,
      by_root: emitter.by_root,
      tail: emitter.tail,
      calls: emitter.calls,
      generics: emitter.generics,
      refused: emitter.refused,
      deferred: emitter.deferred,
      deferred_locals: emitter.deferred_locals,
      performs: emitter.performs,
      handles: emitter.handles,
      landing: emitter.landing,
      effects: emitter.effects,
      release: emitter.release,
      pinned: emitter.pinned,
      bound: emitter.bound,
      group: emitter.group,
      operands: emitter.operands,
      typed: emitter.typed,
      answer: emitter.answer,
      site_root: emitter.site_root,
      lent: emitter.lent,
      written: emitter.written,
    }
  }

fn note_released(emitter: Emitter, root: Bytes) -> Emitter =
  {
    out: emitter.out,
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: emitter.built,
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: push(emitter.released, root),
    reuse_widths: emitter.reuse_widths,
    alias: emitter.alias,
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred,
    deferred_locals: emitter.deferred_locals,
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
  }

/// The words a record of `ty` holds, which is the reuse token its cells make.
fn width_of(ty: Ty) -> Option<Int> = match ty { TyRec(fs) -> Some(laid_of(fs).width), _ -> None }

/// Where field `name` starts among a record's words: after the words of the fields that sort
/// before it.
fn field_at(ty: Ty, name: Bytes) -> Option<{ at: Int, kind: Kind, ty: Ty }> =
  match ty {
    TyRec(fs) -> {
      let offsets = laid_of(fs).offsets;
      fold(range(0, len(fs)), None, |acc: Option<{ at: Int, kind: Kind, ty: Ty }>, i: Int|
        match list_at(fs, i) {
          Some(field) -> if field.name == name {
            Some({
              at: match list_at(offsets, i) { Some(o) -> o, None -> i },
              kind: field.kind,
              ty: field.ty,
            })
          } else { acc },
          None -> acc,
        })
    },
    _ -> None,
  }

/// A record held in place at `at` of `base`, read into `w`, taken: its words move to a record of its
/// own where `base` is its only holder, and it is held once more otherwise.
fn took(emitter: Emitter, base: Bytes, at: Int, w: Bytes) -> Emitter =
  check(
    line(
      emitter,
      bytes_concat_all([w, b" = ply_take(ctx, ", base, b", ", ascii_of_int(at), b");"]),
    ),
  )

/// What reading field `f` of record `base` answers: the word it holds, or for a record held in
/// place the address of its header there, which counts as its holder does.
fn field_read(base: Bytes, f: { at: Int, kind: Kind, ty: Ty }) -> Bytes =
  match f.ty {
    TyRec(_) ->
      bytes_concat_all([b"((Word)(intptr_t)(ply_words(", base, b") + ", ascii_of_int(f.at), b"))"]),
    _ -> bytes_concat_all([b"ply_words(", base, b")[", ascii_of_int(f.at), b"]"]),
  }

fn names_of(fs: List<FieldTy>) -> List<Bytes> = map(fs, |field: FieldTy| field.name)

fn as_bool(value: CValue) -> Bytes =
  match value.kind {
    KBool -> value.expr,
    KMaybe -> b"ply_maybe_unrouted",
    KNum(_) -> bytes_concat_all([b"((", value.expr, b") != 0)"]),
    KInt -> bytes_concat_all([b"((", value.expr, b") != 0)"]),
    KBoxed -> bytes_concat_all([b"rt_unbox_bool_p(ctx, ", value.expr, b")"]),
    KFloat -> bytes_concat_all([b"rt_unbox_bool_p(ctx, ", as_word(value), b")"]),
    KDec -> bytes_concat_all([b"rt_unbox_bool_p(ctx, ", as_word(value), b")"]),
  }

/// A word is read in place when it is a `Float`'s own object; the runtime reads any other.
fn as_float(value: CValue) -> Bytes =
  match value.kind {
    KFloat -> value.expr,
    KBoxed ->
      bytes_concat_all([
        b"(ply_is_float(",
        value.expr,
        b") ? ply_f64(ply_words(",
        value.expr,
        b")[0]) : ply_f64(rt_unbox_float_p(ctx, ",
        value.expr,
        b")))",
      ]),
    _ -> bytes_concat_all([b"ply_f64(rt_unbox_float_p(ctx, ", as_word(value), b"))"]),
  }

fn as_word(value: CValue) -> Bytes =
  match value.kind {
    KBoxed -> value.expr,
    // Made an object only by `owned` or `word_of`, which know whose its count is.
    KMaybe -> b"ply_maybe_unrouted",
    // The C type the value is held in decides sign or zero extension.
    KNum(w) -> if in_imm(w) { bytes_concat_all([b"ply_imm((int64_t)", value.expr, b")"]) } else {
      bytes_concat_all([
        b"rt_box_fixed_p(ctx, (Word)(",
        value.expr,
        b"), ",
        ascii_of_int(width_index(w)),
        b")",
      ])
    },
    KBool -> bytes_concat_all([b"(", value.expr, b" ? ply_true : ply_false)"]),
    KInt ->
      bytes_concat_all([
        b"(ply_fits_imm(",
        value.expr,
        b") ? ply_imm(",
        value.expr,
        b") : rt_box_int_p(ctx, ",
        value.expr,
        b"))",
      ]),
    KFloat -> bytes_concat_all([b"rt_box_float_p(ctx, ply_f64_bits(", value.expr, b"))"]),
    KDec ->
      bytes_concat_all([b"rt_box_decimal_p(ctx, (", value.expr, b").lo, (", value.expr, b").hi)"]),
  }

/// `value` as a `Decimal`'s two words: a word is the `Decimal`'s own object.
fn as_dec(value: CValue) -> Bytes =
  match value.kind {
    KDec -> value.expr,
    KBoxed -> bytes_concat_all([b"ply_dec_of(", value.expr, b")"]),
    _ -> bytes_concat_all([b"ply_dec_of(", as_word(value), b")"]),
  }

/// `rt_arith`'s opcode numbering.
fn arith_code(op: Bytes) -> Int = if op == b"mul" { 0 } else if op == b"div" { 1 } else { 2 }

/// `rt_binary`'s operator numbering, in the runtime table's order.
fn binary_code(op: Bytes) -> Int =
  if op == b"add" { 0 }
  else if op == b"sub" { 1 }
  else if op == b"mul" { 2 }
  else if op == b"div" { 3 }
  else if op == b"rem" { 4 }
  else if op == b"eq" { 5 }
  else if op == b"ne" { 6 }
  else if op == b"lt" { 7 }
  else if op == b"le" { 8 }
  else if op == b"gt" { 9 }
  else if op == b"ge" { 10 }
  else if op == b"concat" { 11 }
  else if op == b"bitand" { 12 }
  else if op == b"bitor" { 13 }
  else if op == b"bitxor" { 14 }
  else if op == b"shl" { 15 }
  else if op == b"shr" { 16 }
  else { 17 }

fn is_add_or_sub(op: Bytes) -> Bool = op == b"add" || op == b"sub"

/// A lambda's closure: its body emitted as an entry of its own, and its captures copied in.
fn closure_value(
  emitter: Emitter,
  l: Lambda,
  params: List<EmitParam>,
) -> Option<WithValue> / {abort.raise} =
  match caps_owned(emitter, l.captures, params, 0, []) {
    None -> None,
    Some(w) -> {
      // Numbered among this body's lambdas; the code table holds constants' entries too.
      let prefix = bytes_concat(symbol_of(emitter.owner), b"_lambda");
      let idx = fold(w.emitter.lambdas, 0, |acc: Int, sym: Bytes|
        if bytes_len(sym) >= bytes_len(prefix) && bytes_slice(sym, 0, bytes_len(prefix)) == prefix {
          acc + 1
        } else { acc });
      let sub = bytes_concat(prefix, ascii_of_int(idx));
      let entry = lambda_of(w.emitter, bytes_concat(sub, b"_entry"));
      match emit_lambda(entry.emitter, sub, l) {
        None -> None,
        Some(sub_out) -> {
          let arr = fresh(entry.emitter);
          let e = line(
            arr.emitter,
            bytes_concat_all([
              b"Word ",
              arr.name,
              b"[] = {",
              if len(w.names) == 0 { b"0" } else { bytes_join(w.names, b", ") },
              b"};",
            ]),
          );
          let grown = {
            out: e.out,
            temp_count: e.temp_count,
            unboxed: e.unboxed,
            indent: e.indent,
            reads: e.reads,
            shapes: sub_out.shapes,
            built: e.built,
            module: e.module,
            base: e.base,
            count_locals: e.count_locals,
            here: e.here,
            imports: e.imports,
            consts: sub_out.consts,
            ctors: e.ctors,
            lambda_bodies: bytes_concat_all([e.lambda_bodies, sub_out.text, sub_out.extra]),
            lambdas: sub_out.lambdas,
            owner: e.owner,
            builtins: e.builtins,
            called_builtins: sub_out.met,
            fields: sub_out.fields,
            released: e.released,
            reuse_widths: e.reuse_widths,
            alias: e.alias,
            by_root: e.by_root,
            tail: e.tail,
            calls: sub_out.calls,
            generics: sub_out.generics,
            refused: sub_out.refused,
            deferred: e.deferred,
            deferred_locals: e.deferred_locals,
            performs: sub_out.performs,
            handles: sub_out.handles,
            landing: e.landing,
            effects: e.effects,
            release: e.release,
            pinned: e.pinned,
            bound: e.bound,
            group: e.group,
            operands: e.operands,
            typed: e.typed,
            answer: e.answer,
            site_root: e.site_root,
            lent: e.lent,
            written: e.written,
          };
          let o = bind(
            grown,
            KBoxed,
            bytes_concat_all([
              b"rt_closure_p(ctx, @@l",
              ascii_of_int(entry.i),
              b"@@, ",
              ascii_of_int(l.params),
              b", (Word)(intptr_t)",
              arr.name,
              b", ",
              ascii_of_int(len(l.captures)),
              b")",
            ]),
          );
          Some({ emitter: check(o.emitter), value: o.value })
        },
      }
    },
  }

/// Whether `{..base, ..}` may write its fields into `base` itself: a record this body releases here,
/// of the layout the update makes, which holds a record in place. Copying one of those out and back
/// would cost its words and their counts; any other record's cells are the token the update takes.
fn updates_in_place(emitter: Emitter, base: Code, held: CValue, fs: List<FieldTy>) -> Bool =
  emitter.release && base_owned(base) && spendable(emitter, held.expr)
    && deferred_of(emitter, held.expr) == None
    && built_of(emitter, held.expr) == None
    && fold(fs, false, |acc: Bool, f: FieldTy| acc || in_place(f) != None)
    && (match held.ty {
      TyRec(had) -> map(had, spelled_field) == map(fs, spelled_field),
      _ -> false,
    })

/// `{..base, sets}` where `base` is its only holder: each written field let go of and written over
/// in `base`, which the update answers; otherwise as `built` builds it. The written values are held
/// before the test, so one read out of `base` itself counts against it and the update copies.
fn in_place_update(
  emitter: Emitter,
  base: Bytes,
  names: List<Bytes>,
  fs: List<FieldTy>,
  sets: List<CodeField>,
  vals: List<CValue>,
  built: (Emitter, List<CValue>, Bool) -> Option<WithValue> / {abort.raise},
) -> Option<WithValue> / {abort.raise} = {
  let held = fold(
    range(0, len(sets)),
    { emitter: emitter, vals: [] },
    |acc: { emitter: Emitter, vals: List<CValue> }, i: Int|
      match list_at(vals, i) {
        None -> acc,
        Some(v) -> {
          let nm = match list_at(sets, i) { Some(f) -> f.name, None -> b"" };
          let raw = fold(fs, None, |r: Option<Kind>, f: FieldTy|
            if f.name == nm && raw_slot(f.kind) { Some(f.kind) } else { r });
          let w = match raw {
            Some(k) -> held_raw(acc.emitter, v, k),
            None -> owned(acc.emitter, v),
          };
          { emitter: w.emitter, vals: push(acc.vals, w.value) }
        },
      },
  );
  let r = bind(held.emitter, KBoxed, b"0");
  let l = laid_of(fs);
  let opened = indent(line(r.emitter, bytes_concat_all([b"if (ply_obj(", base, b")->rc == 1) {"])));
  let written = fold(range(0, len(names)), opened, |acc: Emitter, i: Int| {
    let nm = match list_at(names, i) { Some(x) -> x, None -> b"" };
    let f = match list_at(fs, i) {
      Some(x) -> x,
      None -> { name: nm, kind: KBoxed, ty: TyOpen([]) },
    };
    let at = ascii_of_int(match list_at(l.offsets, i) { Some(o) -> o, None -> i });
    match set_value(sets, held.vals, nm) {
      None -> acc,
      Some(v) -> match in_place(f) {
        Some(inner) ->
          line(
            line(acc, bytes_concat_all([b"ply_drop_embedded(ctx, ", base, b", ", at, b");"])),
            bytes_concat_all([
              b"ply_embed(ctx, ",
              base,
              b", ",
              at,
              b", ",
              as_word(v),
              b", ",
              ascii_of_int(laid_of(inner).tail),
              b");",
            ]),
          ),
        None -> if raw_slot(f.kind) { line(acc, raw_store(base, at, v, f.kind)) } else {
          line(
            acc,
            bytes_concat_all([
              b"ply_dec(ctx, ply_words(",
              base,
              b")[",
              at,
              b"]); ply_words(",
              base,
              b")[",
              at,
              b"] = ",
              as_word(v),
              b";",
            ]),
          )
        },
      },
    }
  });
  let moved = line(written, bytes_concat_all([r.value.expr, b" = ", base, b";"]));
  let otherwise = indent(line(outdent(moved), b"} else {"));
  // The general branch starts from the state before the test, its text after the first branch's.
  match built(
      {
        ..r.emitter,
        out: otherwise.out,
        temp_count: otherwise.temp_count,
        indent: otherwise.indent,
      },
      held.vals,
      true,
    ) {
    None -> None,
    Some(b) -> {
      let joined = line(
        outdent(
          line(
            spend_made(b.emitter, b.value.expr),
            bytes_concat_all([r.value.expr, b" = ", as_word(b.value), b";"]),
          ),
        ),
        b"}",
      );
      Some({
        emitter: note_made(joined, r.value.expr),
        value: { kind: KBoxed, expr: r.value.expr, ty: TyRec(fs) },
      })
    },
  }
}

/// A field read. A record held in place that a last read hands on moves out of its holder where
/// `moves`; one read through to a field of its own stays put.
fn read_field(
  emitter: Emitter,
  c: Code,
  f: { base: Code, field: Bytes },
  params: List<EmitParam>,
  moves: Bool,
) -> Option<WithValue> / {abort.raise} =
  match match f.base.node {
      NField(g) -> read_field(notail(emitter), f.base, g, params, false),
      _ -> expr(notail(emitter), f.base, params),
    } {
    None -> None,
    Some(b) -> match built_field(b.emitter, b.value.expr, f.field) {
      // Built in this body: the value is already in a register; asking for the word would force the record into memory.
      Some(v) -> {
        let kept = secure_field(b.emitter, f.base, b.value, v);
        match release_base(kept.emitter, f.base, b.value, params) {
          None -> None,
          Some(r) -> Some({ emitter: r, value: kept.value }),
        }
      },
      None -> {
        let held = bind(b.emitter, KBoxed, as_word(b.value));
        // Under release the rename is the holder: the temporary it renamed was nulled.
        let hv = if b.emitter.release { { kind: KBoxed, expr: held.value.expr, ty: b.value.ty } }
        else { b.value };
        match field_at(b.value.ty, f.field) {
          // A known shape reads at the field's offset; a scalar field goes into a register of its kind.
          Some(i) -> {
            let w = bind_keeping(held.emitter, KBoxed, i.ty, field_read(held.value.expr, i));
            match i.kind {
              // Without release a word-kinded field never releases its base: there is no in-place field take.
              // Under release a base at its last use is let go here, the field duplicated first, as `rt_field` does.
              KBoxed -> if w.emitter.release && base_owned(f.base)
                  && spendable(w.emitter, hv.expr) {
                let once = if width_of(i.ty) != None && moves {
                  took(w.emitter, held.value.expr, i.at, w.value.expr)
                } else { line(w.emitter, bytes_concat_all([b"ply_inc(", w.value.expr, b");"])) };
                let tf = note_made(once, w.value.expr);
                match release_base(tf, f.base, hv, params) {
                  None -> None,
                  Some(r) -> Some({ emitter: r, value: w.value }),
                }
              } else if takes_field(w.emitter, c, f.base, b.value.expr) {
                let taken = if width_of(i.ty) != None {
                  if moves { took(w.emitter, held.value.expr, i.at, w.value.expr) }
                  else { line(w.emitter, bytes_concat_all([b"ply_inc(", w.value.expr, b");"])) }
                } else {
                  line(
                    w.emitter,
                    bytes_concat_all([
                      b"if (ply_obj(",
                      held.value.expr,
                      b")->rc == 1) { ply_words(",
                      held.value.expr,
                      b")[",
                      ascii_of_int(i.at),
                      b"] = ply_unit; } else { ply_inc(",
                      w.value.expr,
                      b"); }",
                    ]),
                  )
                };
                Some({ emitter: note_made(taken, w.value.expr), value: w.value })
              } else { Some({ emitter: w.emitter, value: w.value }) },
              _ -> {
                let out = bind(w.emitter, i.kind, if raw_slot(i.kind) {
                  raw_at(held.value.expr, ascii_of_int(i.at), i.kind)
                } else if i.kind == KFloat { bytes_concat_all([b"ply_f64(", w.value.expr, b")"]) }
                else { as_kind(w.value, i.kind) });
                match release_base(out.emitter, f.base, hv, params) {
                  None -> None,
                  Some(r) -> Some({ emitter: r, value: out.value }),
                }
              },
            }
          },
          // Unknown shape: the runtime reads by name through this body's field table; a word-kinded field does not release its base.
          None -> {
            let idx = field_of(open_needed(held.emitter, b.value.ty), f.field);
            // Under release the runtime takes a base at its last use, or the field out of a base it holds alone.
            let take = idx.emitter.release && base_owned(f.base) && spendable(idx.emitter, hv.expr);
            let w = bind(
              idx.emitter,
              KBoxed,
              bytes_concat_all([
                b"rt_field_p(ctx, ",
                held.value.expr,
                b", @@f",
                ascii_of_int(idx.i),
                b"@@, ",
                if take { b"1" }
                else if takes_field(idx.emitter, c, f.base, b.value.expr) { b"2" }
                else { b"0" },
                b")",
              ]),
            );
            let spent = if take {
              line(spend_made(w.emitter, hv.expr), bytes_concat_all([hv.expr, b" = 0;"]))
            } else { w.emitter };
            Some({ emitter: check(spent), value: w.value })
          },
        }
      },
    },
  }

/// Whether `name` called is the builtin `builtin`: no definition of this module and no import takes
/// it.
fn names_builtin(emitter: Emitter, name: Bytes, builtin: Bytes) -> Bool =
  name == builtin && !fold(emitter.here, false, |acc: Bool, h: Def| acc || h.name == name)
    && from_import(emitter.imports, name) == None

/// Where call `a` read at `field` is `columns_get(xs, i).field` of a `Columns` the checker settled
/// to records: the field's place among its record's fields, and how the record holds it.
fn columns_field(
  emitter: Emitter,
  a: { func: Code, args: List<Code> },
  field: Bytes,
) -> Option<{ k: Int, f: FieldTy }> =
  match a.func.node {
    NVar(fv) -> if fv.slot != None || len(a.args) != 2
        || !names_builtin(emitter, fv.name, b"columns_get") { None } else {
      match map_get(emitter.typed, span_key(a.func.span)) {
        None -> None,
        Some(t) -> match list_at(t.args, 0) {
          None -> None,
          Some(element) -> match kind_of(element).ty {
            TyRec(fs) ->
              fold(range(0, len(fs)), None, |found: Option<{ k: Int, f: FieldTy }>, k: Int|
                match list_at(fs, k) {
                  Some(x) -> if x.name == field { Some({ k: k, f: x }) } else { found },
                  None -> found,
                }),
            _ -> None,
          },
        },
      }
    },
    _ -> None,
  }

/// Field `at.f` of record `i` of `xs`, given as `words`, which it takes: loaded from its column
/// where `xs` is laid out in columns and `i` is in range, with no record made; otherwise read by the
/// runtime, which raises as `columns_get` does.
fn columns_load(
  emitter: Emitter,
  words: List<Bytes>,
  at: { k: Int, f: FieldTy },
  span: Span,
) -> WithValue = {
  let xs = match list_at(words, 0) { Some(w) -> w, None -> b"0" };
  let given = match list_at(words, 1) { Some(w) -> w, None -> b"0" };
  let idx = bind(site(emitter, span), KInt, as_int({ kind: KBoxed, expr: given, ty: TyOpen([]) }));
  let kind = at.f.kind;
  let out = fresh(idx.emitter);
  let column = bytes_concat_all([b"ply_words(", xs, b")[", ascii_of_int(at.k), b"]"]);
  let opened = line(
    line(out.emitter, bytes_concat_all([ctype(kind), b" ", out.name, b" = ", zero_of(kind), b";"])),
    bytes_concat_all([
      b"if (ply_obj(",
      xs,
      b")->kind == PLY_KIND_COLUMNS && (uint64_t)",
      idx.value.expr,
      b" < (uint64_t)ply_array_len(",
      column,
      b")) {",
    ]),
  );
  let fast = line(
    indent(opened),
    bytes_concat_all([
      out.name,
      b" = ",
      column_read(column, idx.value.expr, at.f),
      b";",
      if kind == KBoxed { bytes_concat_all([b" ply_inc(", out.name, b");"]) } else { b"" },
    ]),
  );
  let call = bytes_concat_all([
    b"rt_columns_field_p(ctx, ",
    xs,
    b", ",
    idx.value.expr,
    b", ",
    ascii_of_int(at.k),
    b")",
  ]);
  let otherwise = indent(line(outdent(fast), b"} else {"));
  let slow = if kind == KBoxed {
    check(line(otherwise, bytes_concat_all([out.name, b" = ", call, b";"])))
  } else {
    let w = fresh(otherwise);
    line(
      check(line(w.emitter, bytes_concat_all([b"Word ", w.name, b" = ", call, b";"]))),
      bytes_concat_all([
        out.name,
        b" = ",
        as_kind({ kind: KBoxed, expr: w.name, ty: TyOpen([]) }, kind),
        b"; ply_dec(ctx, ",
        w.name,
        b");",
      ]),
    )
  };
  let closed = line(
    line(outdent(slow), b"}"),
    bytes_concat_all([b"ply_dec(ctx, ", xs, b"); ply_dec(ctx, ", given, b");"]),
  );
  {
    emitter: if kind == KBoxed { note_made(closed, out.name) } else { closed },
    value: { kind: kind, expr: out.name, ty: at.f.ty },
  }
}

/// Element `i` of `column`, an array of field `f`'s values, read as the field is held: a record in
/// place as the address of its header, a scalar its record holds raw as its kind, any other as the
/// kind its word holds.
fn column_read(column: Bytes, i: Bytes, f: FieldTy) -> Bytes = {
  let at = bytes_concat_all([b"(", i, b") * ply_obj(", column, b")->aux"]);
  match f.ty {
    TyRec(_) -> bytes_concat_all([b"((Word)(intptr_t)(ply_words(", column, b") + ", at, b"))"]),
    _ -> if raw_slot(f.kind) { raw_at(column, at, f.kind) } else {
      as_kind(
        {
          kind: KBoxed,
          expr: bytes_concat_all([b"ply_words(", column, b")[", i, b"]"]),
          ty: TyOpen([]),
        },
        f.kind,
      )
    },
  }
}

fn expr(emitter: Emitter, c: Code, params: List<EmitParam>) -> Option<WithValue> / {abort.raise} =
  match c.node {
    NLabel(n) -> {
      let f = field_of(emitter, n);
      Some({ emitter: f.emitter, value: { kind: KInt, expr: field_ref(f.i), ty: TyOpen([]) } })
    },
    NLit(l) -> match l {
      LInt(n) ->
        Some({ emitter: emitter, value: { kind: KInt, expr: int_lit(n), ty: TyOpen([]) } }),
      // A `Bool` is C's 1 or 0 until something asks for its word.
      LBool(b) ->
        Some({
          emitter: emitter,
          value: { kind: KBool, expr: if b { b"1" } else { b"0" }, ty: TyOpen([]) },
        }),
      // A literal the tag cannot hold is read from the unit's constant table; the helper can raise.
      LStr(_) -> Some(from_table(emitter, l)),
      LBytes(_) -> Some(from_table(emitter, l)),
      // Below 64 bits a literal is its C type's own; wider, it is the runtime's own word from the constant table, as a parameter of its type is.
      LFixed(name, bits) -> match width_named(name) {
        None -> Some(refused(emitter, b"a fixed-width literal of no known width")),
        Some(w) -> if carried(w) {
          Some({
            emitter: emitter,
            value: {
              kind: KNum(w),
              expr: bytes_concat_all([b"((", ctype(KNum(w)), b")", int_lit(bits), b")"]),
              ty: TyOpen([]),
            },
          })
        } else { Some(from_table(emitter, l)) },
      },
      // A 64-bit literal past an `Int` is its low word's bits.
      LWide(name, _, low) -> match width_named(name) {
        Some(w) -> if carried(w) {
          Some({
            emitter: emitter,
            value: {
              kind: KNum(w),
              expr: bytes_concat_all([b"((", ctype(KNum(w)), b")", int_lit(low), b")"]),
              ty: TyOpen([]),
            },
          })
        } else { Some(from_table(emitter, l)) },
        None -> Some(from_table(emitter, l)),
      },
      LUnit -> Some(from_table(emitter, l)),
      LFloat(x) ->
        Some({
          emitter: emitter,
          value: {
            kind: KFloat,
            expr: bytes_concat_all([b"ply_f64(", int_lit(literal_bits(x)), b")"]),
            ty: TyOpen([]),
          },
        }),
      LDec(_) -> Some(from_table(emitter, l)),
      LChar(v) ->
        Some({
          emitter: emitter,
          value: {
            kind: KBoxed,
            expr: bytes_concat_all([b"((Word)", int_lit(v * 8 + 2), b")"]),
            ty: TyOpen([]),
          },
        }),
      _ -> Some(refused(emitter, b"a literal this port does not pool")),
    },
    NVar(v) -> match v.slot {
      // The table has no arities: the runtime answers a nullary constructor's singleton or a function.
      None -> if is_ctor_name(v.name) {
        match tag_of(emitter, v.name) {
          None -> Some(refused(emitter, bytes_concat(b"a constructor not in the table: ", v.name))),
          Some(tag) -> if is_option(emitter, tag, b"None") { Some(bind(emitter, KMaybe, b"0")) }
          else {
            let o = bind(
              emitter,
              KBoxed,
              bytes_concat_all([b"rt_ctor_value_p(ctx, ", tag_text(emitter, tag), b")"]),
            );
            Some({ emitter: check(o.emitter), value: o.value })
          },
        }
      } else {
        match def_of(emitter, v.name) {
          // A definition used as a value is a closure over its entry, a nullary one too: calling it here would run its body before, and outside the handlers of, any call.
          Some(d) -> {
            let named = named_ref(emitter, d.full, Some(d.def), c.span, []);
            let l = lambda_of(named.emitter, bytes_concat_all([named.symbol, b"_entry"]));
            let arr = fresh(l.emitter);
            let e = line(arr.emitter, bytes_concat_all([b"Word ", arr.name, b"[] = {0};"]));
            let o = bind(
              e,
              KBoxed,
              bytes_concat_all([
                b"rt_closure_p(ctx, @@l",
                ascii_of_int(l.i),
                b"@@, ",
                ascii_of_int(d.arity),
                b", (Word)(intptr_t)",
                arr.name,
                b", 0)",
              ]),
            );
            Some({ emitter: note_made(check(o.emitter), o.value.expr), value: o.value })
          },
          None -> if is_width_builtin(v.name) {
            Some(
              refused(
                emitter,
                bytes_concat(b"a width builtin left unwritten as a value: ", v.name),
              ),
            )
          } else if fold(emitter.builtins, false, |acc: Bool, b2: Bytes| acc || b2 == v.name) {
            let bi = builtin_of(emitter, v.name);
            let o = bind(
              bi.emitter,
              KBoxed,
              bytes_concat_all([b"rt_builtin_value_p(ctx, @@b", ascii_of_int(bi.i), b"@@)"]),
            );
            Some({ emitter: check(o.emitter), value: o.value })
          } else {
            Some(refused(emitter, bytes_concat(b"a global this port cannot resolve: ", v.name)))
          },
        }
      },
      Some(s) -> match conv_of(emitter, s) {
        Some(v) -> Some(move_read(emitter, c.own, v)),
        // A parameter the prologue did not open (a record) is read as its own word each time.
        None -> match list_at(params, s) {
          None ->
            Some(refused(emitter, bytes_concat(b"a local this port has not bound: ", v.name))),
          Some(p) -> match p.kind {
            KBoxed ->
              Some(
                move_read(emitter, c.own, {
                  kind: KBoxed,
                  expr: bytes_concat(b"p", ascii_of_int(s)),
                  ty: p.ty,
                }),
              ),
            KMaybe ->
              Some(
                move_read(emitter, c.own, {
                  kind: KMaybe,
                  expr: bytes_concat(b"p", ascii_of_int(s)),
                  ty: p.ty,
                }),
              ),
            _ ->
              Some(
                refused(
                  emitter,
                  bytes_concat(b"a scalar parameter read outside its window: ", v.name),
                ),
              ),
          },
        },
      },
    },
    NBinary(b) ->      // Two `Int` literals under an operator fold to one, checked, so an overflow is left for the runtime.
      match lit_int(c) {
        Some(n) ->
          Some({ emitter: emitter, value: { kind: KInt, expr: int_lit(n), ty: TyOpen([]) } }),
        None -> if b.op == b"and" || b.op == b"or" {
          match expr(notail(emitter), b.lhs, params) {
            None -> None,
            Some(l) -> {
              let out = fresh(l.emitter);
              let opened = line(
                out.emitter,
                bytes_concat_all([b"int64_t ", out.name, b" = ", as_bool(l.value), b";"]),
              );
              let branch = if b.op == b"and" { bytes_concat_all([b"if (", out.name, b") {"]) }
              else { bytes_concat_all([b"if (!", out.name, b") {"]) };
              match expr(withtail(indent(line(opened, branch)), emitter.tail), b.rhs, params) {
                None -> None,
                Some(r) -> {
                  let assigned = line(
                    r.emitter,
                    bytes_concat_all([out.name, b" = ", as_bool(r.value), b";"]),
                  );
                  // Only one path runs the branch: what it moved is still held on the other.
                  let closed = close(assigned);
                  Some({
                    emitter: with_made(
                      closed,
                      union_made(opened.count_locals, closed.count_locals),
                    ),
                    value: { kind: KBool, expr: out.name, ty: TyOpen([]) },
                  })
                },
              }
            },
          }
        }
        // `++` takes both operands.
        else if b.op == b"concat" {
          match secured(expr(notail(emitter), b.lhs, params)) {
            None -> None,
            Some(l) -> match expr(notail(l.emitter), b.rhs, params) {
              None -> None,
              Some(r) -> {
                let lo = owned(r.emitter, l.value);
                let ro = owned(lo.emitter, r.value);
                let o = bind(
                  ro.emitter,
                  KBoxed,
                  bytes_concat_all([
                    b"rt_concat_p(ctx, ",
                    lo.value.expr,
                    b", ",
                    ro.value.expr,
                    b")",
                  ]),
                );
                Some({ emitter: check(o.emitter), value: o.value })
              },
            },
          }
        } else if !is_arithmetic(b.op) && compare_op(b.op) == None && !is_bitop(b.op)
            && !is_shift(b.op) {
          Some(refused(emitter, bytes_concat(b"an operator this port does not emit: ", b.op)))
        } else {
          let emitter = operand_needed(emitter, c.span);
          match operand_at(emitter, c.span) {
            None -> Some(unsettled_operator(emitter, b.op)),
            Some(t) -> match secured(expr(notail(emitter), b.lhs, params)) {
              None -> None,
              Some(l) -> match expr(notail(l.emitter), b.rhs, params) {
                None -> None,
                Some(r) ->
                  binary_rest(
                    if is_arithmetic(b.op) || is_shift(b.op) { site(r.emitter, c.span) }
                    else { r.emitter },
                    b.op,
                    l.value,
                    r.value,
                    t,
                  ),
              },
            },
          }
        },
      },
    // A block binds its tail even with no statements, so an `if` branch shows a rename it did not ask for.
    NBlock(bl) -> match bl.tail {
      None -> match stmts(emitter, bl.stmts, params, 0) {
        None -> None,
        Some(after) -> Some(bind(withtail(after, emitter.tail), KBoxed, b"ply_unit")),
      },
      Some(t) -> match stmts(emitter, bl.stmts, params, 0) {
        None -> None,
        // The block's tail is a tail when the block is; its statements are not.
        Some(after) -> match expr(withtail(after, emitter.tail), t, params) {
          None -> None,
          Some(o) -> Some(bind_keeping(o.emitter, o.value.kind, o.value.ty, o.value.expr)),
        },
      },
    },
    NUnary(u) -> if u.op == b"not" {
      match expr(notail(emitter), u.operand, params) {
        None -> None,
        Some(o) -> Some(bind(o.emitter, KBool, bytes_concat_all([b"!(", as_bool(o.value), b")"]))),
      }
    } else if u.op == b"neg" || u.op == b"bitnot" {
      let emitter = operand_needed(emitter, c.span);
      match operand_at(emitter, c.span) {
        None -> Some(unsettled_operator(emitter, u.op)),
        Some(t) -> match expr(notail(emitter), u.operand, params) {
          None -> None,
          Some(o) -> if u.op == b"neg" { negated(o.emitter, o.value, t, c.span) }
          else { inverted(o.emitter, o.value, t) },
        },
      }
    } else { None },
    // A lambda is a closure and also a function written after the one that builds it.
    // A nested lambda is one more of the owner's: numbered after its container, its entry interned before its body.
    NLambda(l) -> closure_value(emitter, l, params),
    NList(l) -> match items(emitter, l.items, params, 0, []) {
      None -> None,
      Some(w) -> {
        let arr = fresh(w.emitter);
        // C has no empty initialiser, so an empty list still declares one word.
        let e = line(
          arr.emitter,
          bytes_concat_all([
            b"Word ",
            arr.name,
            b"[] = {",
            if len(w.names) == 0 { b"0" } else { bytes_join(w.names, b", ") },
            b"};",
          ]),
        );
        let o = bind(
          e,
          KBoxed,
          bytes_concat_all([
            b"rt_list_p(ctx, (Word)(intptr_t)",
            arr.name,
            b", ",
            ascii_of_int(len(l.items)),
            b")",
          ]),
        );
        Some({ emitter: check(o.emitter), value: o.value })
      },
    },
    // `columns_get(xs, i).f` reads its field from its column.
    NField(f) -> match f.base.node {
      NApp(a) -> match columns_field(emitter, a, f.field) {
        Some(at) -> match items(emitter, a.args, params, 0, []) {
          None -> None,
          Some(w) -> Some(columns_load(w.emitter, w.names, at, c.span)),
        },
        None ->
          read_field(element_needed(emitter, b"columns_get", a.func.span), c, f, params, true),
      },
      _ -> read_field(emitter, c, f, params, true),
    },
    // `{..b, f: e}` reuses the base's memory: the base is released before the allocation, so its cells are the token.
    // Order: the written fields are evaluated, then the base read, then each field filled in shape order.
    NUpdate(u) -> {
      let names = sorted_names(concat(u.copies, map(u.sets, |f: CodeField| f.name)));
      let laid = laid_out(emitter, c.span, names);
      let emitter = if laid == None { layout_needed_at(emitter, c.span) } else { emitter };
      // Each written field is evaluated and bound before the base is read.
      match sets_bound(emitter, map(u.sets, |f: CodeField| f.value), params, 0, []) {
        None -> None,
        Some(ev) -> match expr(notail(ev.emitter), u.base, params) {
          None -> None,
          Some(bv) -> {
            let held = bind(bv.emitter, KBoxed, as_word(bv.value));
            let hv = if bv.emitter.release {
              { kind: KBoxed, expr: held.value.expr, ty: bv.value.ty }
            } else { bv.value };
            // The kind the new record holds its field `at` as: none but a word where it is laid out by
            // what it holds.
            let target = |at: Int|
              match laid { Some(fs) -> kind_at(kinds_of(fs), at), None -> KBoxed };
            // A field the new record holds as a `Float`'s bits, from a value it holds as a `Float`.
            let as_bits = |acc: { emitter: Emitter, ws: List<Bytes>, kinds: List<Kind>, vals: List<CValue>, known: Bool }, em: Emitter, v: CValue, at: Int| {
              let d = held_raw(em, v, target(at));
              {
                emitter: d.emitter,
                ws: push(acc.ws, raw_word(d.value)),
                kinds: push(acc.kinds, target(at)),
                vals: push(acc.vals, d.value),
                known: acc.known,
              }
            };
            // A copy the base remembered is its value, not a load; any word read from memory stops the record being held back.
            // `owned`: the written fields' values are words the record takes as they are.
            let built = |from: Emitter, vals: List<CValue>, owned_already: Bool| {
              let filled = fold(
                range(0, len(names)),
                { emitter: from, ws: [], kinds: [], vals: [], known: true },
                |acc: { emitter: Emitter, ws: List<Bytes>, kinds: List<Kind>, vals: List<CValue>, known: Bool }, at: Int| {
                  let nm = match list_at(names, at) { Some(x) -> x, None -> b"" };
                  let tk = target(at);
                  if fold(u.copies, false, |seen: Bool, c: Bytes| seen || c == nm) {
                    match built_field(acc.emitter, held.value.expr, nm) {
                      Some(v) -> if raw_slot(tk) { as_bits(acc, acc.emitter, v, at) } else {
                        let o = owned(acc.emitter, v);
                        {
                          emitter: o.emitter,
                          ws: push(acc.ws, o.value.expr),
                          kinds: push(acc.kinds, tk),
                          vals: push(acc.vals, taken_as(o.emitter, v, o.value)),
                          known: acc.known,
                        }
                      },
                      None -> match field_at(bv.value.ty, nm) {
                        // Read at the field's place in the base's shape, which differs from the new record's when the update adds a field.
                        Some(f) -> {
                          let w = bind_word_of(acc.emitter, field_read(held.value.expr, f));
                          // A base of a known type holds a `Float` or a 64-bit width as its bits.
                          if raw_slot(f.kind) {
                            let d = bind(
                              w.emitter,
                              f.kind,
                              raw_at(held.value.expr, ascii_of_int(f.at), f.kind),
                            );
                            if raw_slot(tk) { as_bits(acc, d.emitter, d.value, at) } else {
                              {
                                emitter: d.emitter,
                                ws: push(acc.ws, as_word(d.value)),
                                kinds: push(acc.kinds, tk),
                                vals: push(acc.vals, d.value),
                                known: acc.known,
                              }
                            }
                          } else {
                            let inc = line(
                              w.emitter,
                              bytes_concat_all([b"ply_inc(", w.value.expr, b");"]),
                            );
                            // A scalar copy is read into a register of its kind, then unused: the store takes the word.
                            match f.kind {
                              KBoxed ->
                                {
                                  emitter: inc,
                                  ws: push(acc.ws, w.value.expr),
                                  kinds: push(acc.kinds, tk),
                                  vals: acc.vals,
                                  known: false,
                                },
                              _ -> {
                                let c = bind(inc, f.kind, as_kind(w.value, f.kind));
                                {
                                  emitter: c.emitter,
                                  ws: push(acc.ws, w.value.expr),
                                  kinds: push(acc.kinds, tk),
                                  vals: push(acc.vals, c.value),
                                  known: acc.known,
                                }
                              },
                            }
                          }
                        },
                        None -> {
                          let idx = field_of(open_needed(acc.emitter, bv.value.ty), nm);
                          let w = bind(
                            idx.emitter,
                            KBoxed,
                            bytes_concat_all([
                              b"rt_field_p(ctx, ",
                              held.value.expr,
                              b", @@f",
                              ascii_of_int(idx.i),
                              b"@@, 0)",
                            ]),
                          );
                          // The runtime answers the copy duplicated, and the record takes it, or keeps
                          // it until the block closes where the record holds the `Float` it is as bits.
                          if raw_slot(tk) { as_bits(acc, check(w.emitter), w.value, at) } else {
                            {
                              emitter: spend_made(check(w.emitter), w.value.expr),
                              ws: push(acc.ws, w.value.expr),
                              kinds: push(acc.kinds, tk),
                              vals: acc.vals,
                              known: false,
                            }
                          }
                        },
                      },
                    }
                  } else {
                    match set_value(u.sets, vals, nm) {
                      None ->
                        {
                          emitter: acc.emitter,
                          ws: push(acc.ws, b"0"),
                          kinds: push(acc.kinds, KBoxed),
                          vals: acc.vals,
                          known: false,
                        },
                      Some(v) -> if raw_slot(tk) { as_bits(acc, acc.emitter, v, at) } else {
                        // The written field's word is duplicated: the record being built takes it.
                        let w = if owned_already { { emitter: acc.emitter, value: v } }
                        else { owned(acc.emitter, v) };
                        {
                          emitter: w.emitter,
                          ws: push(acc.ws, w.value.expr),
                          kinds: push(acc.kinds, tk),
                          vals: push(acc.vals, taken_as(w.emitter, v, w.value)),
                          known: acc.known,
                        }
                      },
                    }
                  }
                },
              );
              // At the body's tail the release skips the one-read guard: no later read can exist.
              match release_from(filled.emitter, u.base, hv, params, emitter.tail) {
                None -> None,
                Some(rel) -> match laid {
                  None -> Some(record_by_value(rel, names, filled.ws)),
                  Some(fs) ->
                    Some(
                      build_record(rel, names, filled.ws, fs, if filled.known { Some(filled.vals) }
                      else { None }),
                    ),
                },
              }
            };
            match laid {
              Some(fs) -> if updates_in_place(held.emitter, u.base, hv, fs) {
                in_place_update(held.emitter, hv.expr, names, fs, u.sets, ev.vals, built)
              } else { built(held.emitter, ev.vals, false) },
              None -> built(held.emitter, ev.vals, false),
            }
          },
        },
      }
    },
    // Values evaluated in written order, assembled in sorted-name order, from a reuse token of this width when there is one.
    NRecord(r) -> {
      let names = map(r.fields, |f: CodeField| f.name);
      let sorted = sorted_names(names);
      match laid_out(emitter, c.span, sorted) {
        None -> match items(
            layout_needed_at(emitter, c.span),
            map(r.fields, |f: CodeField| f.value),
            params,
            0,
            [],
          ) {
          None -> None,
          Some(w) ->
            Some(
              record_by_value(
                w.emitter,
                sorted,
                map(range(0, len(sorted)), |at: Int| word_at_rank(names, w.names, at)),
              ),
            ),
        },
        Some(fields) -> match items_laid(
            emitter,
            map(r.fields, |f: CodeField| f.value),
            params,
            map(names, |nm: Bytes| kind_at(kinds_of(fields), rank_of(names, nm))),
          ) {
          None -> None,
          Some(w) -> {
            let vals = map(sorted, |nm: Bytes|
              match fold(range(0, len(names)), None, |acc: Option<CValue>, i: Int|
                  match list_at(names, i) {
                    Some(x) -> if x == nm { list_at(w.vals, i) } else { acc },
                    None -> acc,
                  }) {
                Some(v) -> v,
                None -> { kind: KBoxed, expr: b"0", ty: TyOpen([]) },
              });
            Some(
              build_record(
                w.emitter,
                sorted,
                map(range(0, len(sorted)), |at: Int| word_at_rank(names, w.names, at)),
                fields,
                Some(vals),
              ),
            )
          },
        },
      }
    },
    NApp(a) -> match a.func.node {
      // A name bound in this body holds a closure, called through the runtime; a constructor builds a tagged object.
      NVar(fv) -> match fv.slot {
        Some(_) -> call_value(emitter, a.func, a.args, params, c.span),
        None -> if fv.name == stated_witness_name() { stated_witness(emitter, a.args) }
        else if is_ctor_name(fv.name) {
          match tag_of(emitter, fv.name) {
            None ->
              Some(refused(emitter, bytes_concat(b"a constructor not in the table: ", fv.name))),
            Some(tag) -> if is_option(emitter, tag, b"Some") && len(a.args) == 1 {
              match items(emitter, a.args, params, 0, []) {
                None -> None,
                Some(w) -> match list_at(w.names, 0) {
                  None -> None,
                  Some(payload) ->
                    Some(
                      held_maybe(w.emitter, payload, match list_at(w.vals, 0) {
                        Some(v) -> v.ty,
                        None -> TyOpen([]),
                      }),
                    ),
                },
              }
            } else {
              match ctor_fields(emitter, tag) {
                Some(fs) -> match items_laid(emitter, a.args, params, kinds_of(fs)) {
                  None -> None,
                  Some(w) -> Some(ctor_laid(w.emitter, tag, fs, w.names)),
                },
                None -> match items(emitter, a.args, params, 0, []) {
                  None -> None,
                  Some(w) -> if len(w.names) > 0 { Some(ctor_built(w.emitter, tag, w.names)) }
                  else {
                    let arr = fresh(w.emitter);
                    let e = line(arr.emitter, bytes_concat_all([b"Word ", arr.name, b"[] = {0};"]));
                    let o = bind(
                      e,
                      KBoxed,
                      bytes_concat_all([
                        b"rt_ctor_p(ctx, ",
                        tag_text(emitter, tag),
                        b", (Word)(intptr_t)",
                        arr.name,
                        b", 0)",
                      ]),
                    );
                    Some({ emitter: check(o.emitter), value: o.value })
                  },
                },
              }
            },
          }
        } else {
          // A pure nullary definition is read from the runtime's constant table, not called.
          if len(a.args) == 0 && constant_of(emitter, fv.name) != None {
            match constant_of(emitter, fv.name) {
              None -> None,
              Some(k) -> {
                let noted = note_call(site(emitter, c.span), k.full);
                let l = lambda_of(noted, entry_of(k.full));
                let held = bind(
                  l.emitter,
                  KBoxed,
                  bytes_concat_all([b"rt_constant_p(ctx, @@l", ascii_of_int(l.i), b"@@)"]),
                );
                Some(opened_to(check(held.emitter), held.value, k.ret))
              },
            }
          } else if !fold(emitter.here, false, |acc: Bool, h: Def| acc || h.name == fv.name) {
            // Not this module's: an import, which takes the name where it has it, else a builtin.
            match match qualified(fv.name) {
                Some(q) -> module_import(emitter.imports, q.binder),
                None -> from_import(emitter.imports, fv.name),
              } {
              // Callback and inline builtins outside their fused shapes are refused: a plain call for them is a wrong answer, not a slow one.
              None -> match match lookup_helper(fv.name, len(a.args)) {
                  Some(h) -> match args_owned_at(notail(emitter), a.args, params, c.span) {
                    None -> None,
                    Some(w) -> Some(looked_up(w.emitter, h, w.names)),
                  },
                  None -> fused_fold(emitter, fv.name, a.args, params, c.span),
                } {
                Some(o) -> Some(o),
                None -> match iterate_call(emitter, fv.name, a.args, params, c.span) {
                  Some(o) -> Some(o),
                  None -> match position_call(emitter, fv.name, a.args, params, c.span) {
                    Some(o) -> Some(o),
                    None -> match width_builtin(
                        emitter,
                        fv.name,
                        a.args,
                        params,
                        c.span,
                        a.func.span,
                      ) {
                      Some(o) -> Some(o),
                      None -> match inline_len(
                          element_needed(emitter, fv.name, a.func.span),
                          fv.name,
                          a.args,
                          params,
                          c.span,
                        ) {
                        Some(o) -> Some(o),
                        None -> if is_callback(fv.name) || is_inlined(fv.name) {
                          Some(
                            refused(
                              emitter,
                              bytes_concat(
                                b"a callback or inline builtin outside its fused shape: ",
                                fv.name,
                              ),
                            ),
                          )
                        } else if !fold(emitter.builtins, false, |acc: Bool, b2: Bytes|
                            acc || b2 == fv.name) {
                          Some(
                            refused(
                              emitter,
                              bytes_concat(b"a name this port cannot resolve: ", fv.name),
                            ),
                          )
                        } else {
                          // `map` and `filter` duplicate the list before the closure is built; the rest evaluate everything first.
                          match if fv.name == b"map" || fv.name == b"filter" {
                              args_one_pass(emitter, a.args, params, 0, [])
                            } else if fv.name == b"map_fold" {
                              args_owned(emitter, a.args, params, 0, [])
                            } else { args_owned_at(emitter, a.args, params, c.span) } {
                            None -> None,
                            Some(w) -> {
                              let o = bind(w.emitter, KBoxed, builtin_call_over(fv.name, w.names));
                              Some({ emitter: check(o.emitter), value: o.value })
                            },
                          }
                        },
                      },
                    },
                  },
                },
              },
              // The same direct call, mangled with its module.
              Some(imp) -> {
                let callee = match qualified(fv.name) { Some(q) -> q.name, None -> fv.name };
                {
                  let full = bytes_concat_all([imp.module, b".", callee]);
                  let target = call_target(
                    passed_on(emitter, full, a.args, params),
                    full,
                    def_named(imp.defs, callee),
                    a.func.span,
                    fn_args(emitter, a.args, params),
                  );
                  match args_carried(target.emitter, a.args, params, target.carriers.params, 0, [
                    ]) {
                    None -> None,
                    Some(w) -> Some(called(w.emitter, target, c.span, w.names, len(a.args))),
                  }
                }
              },
            }
          } else if emitter.tail && emitter.landing == None
              && group_case(emitter, fv.name, len(a.args)) != None {
            match group_case(emitter, fv.name, len(a.args)) {
              None -> None,
              Some(which) ->
                group_tail(
                  note_call(emitter, qualify(emitter.module, fv.name)),
                  fv.name,
                  a.args,
                  params,
                  which,
                ),
            }
          } else if emitter.tail && emitter.landing == None
              && self_tail_leaf(emitter, fv.name, a.func.span, a.args, params) {
            self_tail(note_call(emitter, emitter.owner), fv.name, a.args, params)
          } else {
            {
              let full = qualify(emitter.module, fv.name);
              let target = call_target(
                passed_on(emitter, full, a.args, params),
                full,
                def_named(emitter.here, fv.name),
                a.func.span,
                fn_args(emitter, a.args, params),
              );
              match args_carried(target.emitter, a.args, params, target.carriers.params, 0, []) {
                None -> None,
                Some(w) -> Some(called(w.emitter, target, c.span, w.names, len(a.args))),
              }
            }
          }
        },
      },
      // Any other callee -- a field holding a function, a call's answer -- is a value too.
      _ -> call_value(emitter, a.func, a.args, params, c.span),
    },
    // A call a specialisation runs in place: the function value and arguments evaluated here, then
    // the lambda's body in its own frame.
    NInlined(x) -> match lent_lambda(emitter, x.owner, x.lambda.at.start, x.nth) {
      None -> Some(refused(emitter, b"a lambda run in place that this root was not handed")),
      Some(bl) -> match expr(notail(emitter), x.func, params) {
        None -> None,
        Some(f) -> match args_evaled(f.emitter, x.args, params, 0, []) {
          None -> None,
          Some(w) -> {
            let inner = inlined_frame(w.emitter, bl, f.value, w.vals, x.lambda);
            match expr(notail(inner), x.lambda.body, params) {
              None -> None,
              Some(r) -> Some(inlined_answer(emitter, inner.indent, r)),
            }
          },
        },
      },
    },
    NMatch(m) -> match match_subject(emitter, m.scrutinee, params) {
      None -> None,
      Some(s) -> {
        let k = if option_at(s.emitter, c.span) { KMaybe } else { KBoxed };
        let ans = fresh(s.emitter);
        let declared = line(ans.emitter, bytes_concat_all([ctype(k), b" ", ans.name, b" = 0;"]));
        match match_arms(
            declared,
            s.subj,
            m.arms,
            params,
            ToValue({ name: ans.name, kind: k }),
            c.span,
            emitter.tail,
          ) {
          None -> None,
          Some(after) ->
            Some({
              emitter: note_holder(after, ans.name),
              value: { kind: k, expr: ans.name, ty: TyOpen([]) },
            }),
        }
      },
    },
    NIf(i) -> match expr(notail(emitter), i.cond, params) {
      None -> None,
      Some(cnd) -> {
        // A condition is read as a bool: on a word that is the runtime's bool unbox, not the integer's.
        let cv = {
          emitter: cnd.emitter,
          value: { kind: KBool, expr: as_bool(cnd.value), ty: TyOpen([]) },
        };
        {
          // The join's number is taken before either arm; arms go into buffers because a record-valued join needs one local per field, numbered after both.
          let j = fresh(cv.emitter);
          match arm(withtail(blank(j.emitter), emitter.tail), i.then_branch, params) {
            None -> None,
            Some(t) -> match arm(
                withtail(
                  with_made(rescope(blank(t.emitter), cv.emitter.unboxed), j.emitter.count_locals),
                  emitter.tail,
                ),
                i.else_branch,
                params,
              ) {
              None -> None,
              Some(e) -> {
                // Asked with the later table, which holds what both arms built.
                let shape = shared_shape(e.emitter, t.value, e.value);
                match shape {
                  // Both arms built a record of one shape: the join carries one local per field and reassembles; the number taken above is spent, never declared.
                  Some(names) -> {
                    let n = len(names);
                    let js = fold(
                      names,
                      { emitter: rescope(blank(e.emitter), cv.emitter.unboxed), names: [] },
                      |acc: { emitter: Emitter, names: List<CValue> }, nm: Bytes| {
                        let k = match built_field(e.emitter, t.value.expr, nm) {
                          Some(fv) -> fv.kind,
                          None -> KInt,
                        };
                        let f = fresh(acc.emitter);
                        {
                          emitter: line(
                            f.emitter,
                            bytes_concat_all([ctype(k), b" ", f.name, b" = ", zero_of(k), b";"]),
                          ),
                          names: push(acc.names, { kind: k, expr: f.name, ty: TyOpen([]) }),
                        }
                      },
                    );
                    let tt = joined(e.emitter, t.emitter, t.text, t.value, names, js.names);
                    let ee = joined(e.emitter, e.emitter, e.text, e.value, names, js.names);
                    let body = bytes_concat_all([
                      bytes_join(j.emitter.out, b""),
                      bytes_join(js.emitter.out, b""),
                      pad(js.emitter.indent),
                      b"if (",
                      cv.value.expr,
                      b") {\n",
                      tt.text,
                      pad(js.emitter.indent),
                      b"} else {\n",
                      ee.text,
                      pad(js.emitter.indent),
                      b"}\n",
                    ]);
                    rebuild(
                      {
                        out: [body],
                        temp_count: js.emitter.temp_count,
                        unboxed: cv.emitter.unboxed,
                        indent: js.emitter.indent,
                        reads: js.emitter.reads,
                        shapes: js.emitter.shapes,
                        built: js.emitter.built,
                        module: js.emitter.module,
                        base: js.emitter.base,
                        count_locals: union_made(tt.made, ee.made),
                        here: js.emitter.here,
                        imports: js.emitter.imports,
                        consts: js.emitter.consts,
                        ctors: js.emitter.ctors,
                        lambda_bodies: js.emitter.lambda_bodies,
                        lambdas: js.emitter.lambdas,
                        owner: js.emitter.owner,
                        builtins: js.emitter.builtins,
                        called_builtins: js.emitter.called_builtins,
                        fields: js.emitter.fields,
                        released: js.emitter.released,
                        reuse_widths: js.emitter.reuse_widths,
                        alias: js.emitter.alias,
                        by_root: js.emitter.by_root,
                        tail: js.emitter.tail,
                        calls: js.emitter.calls,
                        generics: js.emitter.generics,
                        refused: js.emitter.refused,
                        deferred: js.emitter.deferred,
                        deferred_locals: js.emitter.deferred_locals,
                        performs: js.emitter.performs,
                        handles: js.emitter.handles,
                        landing: js.emitter.landing,
                        effects: js.emitter.effects,
                        release: js.emitter.release,
                        pinned: js.emitter.pinned,
                        bound: js.emitter.bound,
                        group: js.emitter.group,
                        operands: js.emitter.operands,
                        typed: js.emitter.typed,
                        answer: js.emitter.answer,
                        site_root: js.emitter.site_root,
                        lent: js.emitter.lent,
                        written: js.emitter.written,
                      },
                      names,
                      js.names,
                    )
                  },
                  None -> {
                    let kt = join_kind(t.value.kind, e.value.kind);
                    let decl = line(
                      {
                        out: [],
                        temp_count: e.emitter.temp_count,
                        unboxed: cv.emitter.unboxed,
                        indent: e.emitter.indent,
                        reads: e.emitter.reads,
                        shapes: e.emitter.shapes,
                        built: e.emitter.built,
                        module: e.emitter.module,
                        base: e.emitter.base,
                        count_locals: e.emitter.count_locals,
                        here: e.emitter.here,
                        imports: e.emitter.imports,
                        consts: e.emitter.consts,
                        ctors: e.emitter.ctors,
                        lambda_bodies: e.emitter.lambda_bodies,
                        lambdas: e.emitter.lambdas,
                        owner: e.emitter.owner,
                        builtins: e.emitter.builtins,
                        called_builtins: e.emitter.called_builtins,
                        fields: e.emitter.fields,
                        released: e.emitter.released,
                        reuse_widths: e.emitter.reuse_widths,
                        alias: e.emitter.alias,
                        by_root: e.emitter.by_root,
                        tail: e.emitter.tail,
                        calls: e.emitter.calls,
                        generics: e.emitter.generics,
                        refused: e.emitter.refused,
                        deferred: e.emitter.deferred,
                        deferred_locals: e.emitter.deferred_locals,
                        performs: e.emitter.performs,
                        handles: e.emitter.handles,
                        landing: e.emitter.landing,
                        effects: e.emitter.effects,
                        release: e.emitter.release,
                        pinned: e.emitter.pinned,
                        bound: e.emitter.bound,
                        group: e.emitter.group,
                        operands: e.emitter.operands,
                        typed: e.emitter.typed,
                        answer: e.emitter.answer,
                        site_root: e.emitter.site_root,
                        lent: e.emitter.lent,
                        written: e.emitter.written,
                      },
                      bytes_concat_all([ctype(kt), b" ", j.name, b" = ", zero_of(kt), b";"]),
                    );
                    let ta = assigned(decl, t.emitter, t.text, decl.indent, kt, t.value, j.name);
                    let ea = assigned(
                      ta.emitter,
                      e.emitter,
                      e.text,
                      decl.indent,
                      kt,
                      e.value,
                      j.name,
                    );
                    let fin = ea.emitter;
                    let body = bytes_concat_all([
                      bytes_join(j.emitter.out, b""),
                      bytes_join(decl.out, b""),
                      pad(decl.indent),
                      b"if (",
                      cv.value.expr,
                      b") {\n",
                      ta.text,
                      pad(decl.indent),
                      b"} else {\n",
                      ea.text,
                      pad(decl.indent),
                      b"}\n",
                    ]);
                    let fin_em: Emitter = {
                      out: [body],
                      temp_count: fin.temp_count,
                      unboxed: cv.emitter.unboxed,
                      indent: fin.indent,
                      reads: fin.reads,
                      shapes: fin.shapes,
                      built: fin.built,
                      module: fin.module,
                      base: fin.base,
                      count_locals: union_made(ta.made, ea.made),
                      here: fin.here,
                      imports: fin.imports,
                      consts: fin.consts,
                      ctors: fin.ctors,
                      lambda_bodies: fin.lambda_bodies,
                      lambdas: fin.lambdas,
                      owner: fin.owner,
                      builtins: fin.builtins,
                      called_builtins: fin.called_builtins,
                      fields: fin.fields,
                      released: fin.released,
                      reuse_widths: fin.reuse_widths,
                      alias: fin.alias,
                      by_root: fin.by_root,
                      tail: fin.tail,
                      calls: fin.calls,
                      generics: fin.generics,
                      refused: fin.refused,
                      deferred: fin.deferred,
                      deferred_locals: fin.deferred_locals,
                      performs: fin.performs,
                      handles: fin.handles,
                      landing: fin.landing,
                      effects: fin.effects,
                      release: fin.release,
                      pinned: fin.pinned,
                      bound: fin.bound,
                      group: fin.group,
                      operands: fin.operands,
                      typed: fin.typed,
                      answer: fin.answer,
                      site_root: fin.site_root,
                      lent: fin.lent,
                      written: fin.written,
                    };
                    Some({
                      emitter: if counted(kt) { note_holder(fin_em, j.name) } else { fin_em },
                      value: {
                        kind: kt,
                        expr: j.name,
                        ty: if t.value.ty == e.value.ty { t.value.ty } else { TyOpen([]) },
                      },
                    })
                  },
                }
              },
            },
          }
        }
      },
    },
    // A `perform` searches the handler frames through the runtime; arguments are duplicated and the effect named program-wide.
    NPerform(p) -> match effect_named(emitter, p.effect) {
      None ->
        Some(refused(emitter, bytes_concat(b"an effect this port cannot resolve: ", p.effect))),
      Some(en) -> match args_one_pass(emitter, p.args, params, 0, []) {
        None -> None,
        Some(w) -> {
          let global = en.global;
          let ef = field_of(w.emitter, global);
          let op = field_of(ef.emitter, p.op);
          // A resource a label parameter names is read from its slot; anything else is a field-table entry.
          let lb: Option<WithValue> = match p.label {
            None -> None,
            Some(x) -> expr(notail(op.emitter), x, params),
          };
          let wanted = match p.label { None -> false, Some(_) -> true };
          let missed = wanted && (match lb { Some(_) -> false, None -> true });
          let res = if wanted { None }
          else if p.resource == b"" { None }
          else { Some(field_of(op.emitter, p.resource)) };
          let after = match lb {
            Some(o) -> o.emitter,
            None -> match res { Some(r) -> r.emitter, None -> op.emitter },
          };
          let arr = fresh(after);
          let e = line(
            arr.emitter,
            bytes_concat_all([
              b"Word ",
              arr.name,
              b"[] = {",
              if len(w.names) == 0 { b"0" } else { bytes_join(w.names, b", ") },
              b"};",
            ]),
          );
          let o = bind(
            note_performs(site(e, c.span), bytes_concat_all([global, b"#", p.op])),
            KBoxed,
            bytes_concat_all([
              b"rt_perform_p(ctx, ",
              field_ref(ef.i),
              b", ",
              field_ref(op.i),
              b", ",
              match lb {
                Some(o) -> as_int(o.value),
                None -> match res { Some(r) -> field_ref(r.i), None -> b"-1" },
              },
              b", ",
              mode_code(op_mode(en, p.op)),
              b", (Word)(intptr_t)",
              arr.name,
              b", ",
              ascii_of_int(len(p.args)),
              b")",
            ]),
          );
          if missed { None } else { Some({ emitter: check(o.emitter), value: o.value }) }
        },
      },
    },
    NHandle(h) -> handle_site(emitter, h.body, h.clauses, h.ret, params),
    // `with cell`: a shared region holding a cell with the initial value, the binder in scope for the body, the region closed after.
    NCell(cl) -> match expr(notail(emitter), cl.init, params) {
      None -> None,
      Some(iv) -> {
        // Under release the runtime takes the initial value; otherwise it is handed a word still held.
        let init = if iv.emitter.release { owned(iv.emitter, iv.value) } else {
          let w0 = word_of(iv.emitter, iv.value);
          { emitter: w0.emitter, value: { kind: KBoxed, expr: w0.expr, ty: TyOpen([]) } }
        };
        let region = bind(site(init.emitter, c.span), KInt, b"rt_region_p(ctx, 0)");
        let made = bind(
          region.emitter,
          KBoxed,
          bytes_concat_all([b"rt_cell_p(ctx, ", init.value.expr, b")"]),
        );
        let cell = bind(made.emitter, KBoxed, made.value.expr);
        let bound = match cl.slot {
          Some(sl) -> remember(cell.emitter, sl, cell.value),
          None -> cell.emitter,
        };
        match expr(bound, cl.body, params) {
          None -> None,
          Some(b) -> {
            let held = bind_keeping(b.emitter, b.value.kind, b.value.ty, b.value.expr);
            Some({
              emitter: line(
                held.emitter,
                bytes_concat_all([b"rt_region_close_p(ctx, ", region.value.expr, b");"]),
              ),
              value: held.value,
            })
          },
        }
      },
    },
    // `simulate { body }`: the body is a nullary closure run as the root task of a region whose scheduler the runtime drives.
    NSimulate(x) -> {
      match closure_value(
          notail(emitter),
          { params: 0, size: x.size, captures: x.captures, body: x.body, at: x.body.span },
          params,
        ) {
        None -> None,
        Some(cl) -> {
          let held = owned(cl.emitter, cl.value);
          let noted = fold(scheduled_ops(), held.emitter, |acc: Emitter, op: Bytes|
            note_handles(acc, op));
          let o = bind(
            site(noted, c.span),
            KBoxed,
            bytes_concat_all([b"rt_simulate_p(ctx, ", held.value.expr, b")"]),
          );
          Some({ emitter: check(o.emitter), value: o.value })
        },
      }
    },
    // `parallel { .. }`: the branches' closures go to the runtime, which runs them at once where it may
    // and in order where it must, and writes each one's answer over its closure. Where the block's
    // definition says what the branches may perform, the runtime is told, so a handler none of it
    // reaches does not keep them in order.
    NParallel(pr) -> match items(emitter, pr.branches, params, 0, []) {
      None -> None,
      Some(w) -> {
        let n = len(w.names);
        let arr = fresh(w.emitter);
        let held = line(
          arr.emitter,
          bytes_concat_all([b"Word ", arr.name, b"[] = {", bytes_join(w.names, b", "), b"};"]),
        );
        let ran = match if pr.rooted { owner_reach(held) } else { None } {
          None ->
            check(
              line(
                site(held, c.span),
                bytes_concat_all([
                  b"rt_parallel_p(ctx, (Word)(intptr_t)",
                  arr.name,
                  b", ",
                  ascii_of_int(n),
                  b");",
                ]),
              ),
            ),
          Some(reach) -> {
            let named = fold(
              reach,
              { emitter: held, words: [] },
              |acc: { emitter: Emitter, words: List<Bytes> }, r: Reached| {
                let ef = field_of(acc.emitter, r.effect);
                match r.resource {
                  None ->
                    { emitter: ef.emitter, words: concat(acc.words, [field_ref(ef.i), b"-1"]) },
                  Some(name) -> {
                    let res = field_of(ef.emitter, name);
                    {
                      emitter: res.emitter,
                      words: concat(acc.words, [field_ref(ef.i), field_ref(res.i)]),
                    }
                  },
                }
              },
            );
            let table = fresh(named.emitter);
            let listed = line(
              table.emitter,
              bytes_concat_all([
                b"Word ",
                table.name,
                b"[] = {",
                if len(named.words) == 0 { b"0" } else { bytes_join(named.words, b", ") },
                b"};",
              ]),
            );
            check(
              line(
                site(listed, c.span),
                bytes_concat_all([
                  b"rt_parallel_past_p(ctx, (Word)(intptr_t)",
                  arr.name,
                  b", ",
                  ascii_of_int(n),
                  b", (Word)(intptr_t)",
                  table.name,
                  b", ",
                  ascii_of_int(len(reach)),
                  b");",
                ]),
              ),
            )
          },
        };
        let names = map(range(0, n), |i: Int| bytes_concat(b"_", ascii_of_int(i)));
        let words = map(range(0, n), |i: Int|
          bytes_concat_all([arr.name, b"[", ascii_of_int(i), b"]"]));
        let sorted = sorted_names(names);
        Some(
          record_by_value(ran, sorted, map(range(0, n), |at: Int| word_at_rank(names, words, at))),
        )
      },
    },
    _ -> Some(refused(emitter, b"an effect construct or another node this port does not emit")),
  }

/// What a `parallel` block's branches may perform of one effect, by its program-wide name: on the
/// resource named, or on any.
type Reached = { effect: Bytes, resource: Option<Bytes> }

/// Every operation the definition being emitted may perform and does not answer, as its row has
/// it: what a block in its own body may reach of the handlers its callers installed. `None` where
/// the row does not say: a root that is no definition, a group's shared function and a row left
/// open. A row names an effect program-wide, as a frame's clause does.
fn owner_reach(emitter: Emitter) -> Option<List<Reached>> =
  if len(emitter.group) > 0 { None } else {
    match fold(emitter.here, None, |found: Option<Scheme>, d: Def| {
        let full = qualify(emitter.module, d.name);
        if full == emitter.owner || bytes_starts_with(emitter.owner, bytes_concat(full, b"@")) {
          d.scheme
        } else { found }
      }) {
      None -> None,
      Some(s) -> match s.ty {
        TyFn(f) -> match f.effects.tail {
          Some(_) -> None,
          None ->
            Some(
              // Nothing performs `diverges`: it says only that the body may not return.
              map(filter(f.effects.atoms, |atom: Atom| !is_diverges(atom)), |atom: Atom|
                {
                  effect: atom.effect,
                  resource: match atom.resource { RNamed(name) -> Some(name), _ -> None },
                }),
            ),
        },
        _ -> None,
      },
    }
  }

/// The operations a `simulate` region answers, named as the fixpoint names a handled operation.
fn scheduled_ops() -> List<Bytes> =
  [
    b"task#spawn",
    b"task#join",
    b"task#yield",
    b"clock#now",
    b"clock#sleep",
    b"random#next",
    b"random#below",
    b"sim#seed",
  ]

/// A field-table placeholder the unit resolves; the runtime reads effect, operation and resource names from it.
fn field_ref(i: Int) -> Bytes = bytes_concat_all([b"@@f", ascii_of_int(i), b"@@"])

/// `None` for a name the module's scope does not bind.
fn effect_global(emitter: Emitter, written: Bytes) -> Option<Bytes> / {abort.raise} =
  match effect_named(emitter, written) { Some(e) -> Some(e.global), None -> None }

fn effect_named(emitter: Emitter, written: Bytes) -> Option<EffectName> / {abort.raise} =
  effect_among(emitter.effects, written)

/// A `try`'s clause names its effect program-wide, and only a raise is answered by one.
fn effect_among(effects: List<EffectName>, written: Bytes) -> Option<EffectName> / {abort.raise} =
  match named_program_wide(written) {
    Some(global) -> Some({ written: written, global: global, ops: [] }),
    None -> match fold(effects, None, |acc: Option<EffectName>, e: EffectName|
        if e.written == written { Some(e) } else { acc }) {
      Some(e) -> Some(e),
      // The prelude's effects are declared nowhere and known program-wide by their bare names.
      None ->
        fold(prelude_effects_here(), None, |acc: Option<EffectName>, e: EffectName|
          if e.written == written { Some(e) } else { acc }),
    },
  }

fn prelude_effects_here() -> List<EffectName> =
  map(prelude_effects(), |effect_info: EffectInfo|
    {
      written: effect_info.name,
      global: effect_info.name,
      ops: map(effect_info.ops, |op_info: OpInfo| { name: op_info.name, mode: op_info.mode }),
    })

/// An operation's declared mode: a `perform`'s recorded atom carries it.
fn op_mode(e: EffectName, op: Bytes) -> Mode =
  fold(e.ops, MRead, |acc: Mode, o: OpMode| if o.name == op { o.mode } else { acc })

/// As the runtime reads it.
fn mode_code(mode: Mode) -> Bytes =
  match mode { MRead -> b"0", MWrite -> b"1", MRaise -> b"2", MBad -> b"0" }

/// A clause for a raise is run once its `handle`'s body is abandoned, and no task inherits it.
fn clause_raises(emitter: Emitter, clause: CodeClause) -> Bool / {abort.raise} =
  named_program_wide(clause.effect) != None
    || (match effect_named(emitter, clause.effect) {
      Some(e) -> is_raise(op_mode(e, clause.op)),
      None -> false,
    })

/// Every effect name a module's scope binds, bare or through a module binder, with its program-wide name.
fn effects_in(resolved: Resolved, i: Int, mods: List<ParsedModule>) -> List<EffectName> =
  match list_at(resolved.scopes, i) {
    None -> [],
    Some(scope) -> {
      let bare = map(scope.bound.effects, |b: Binding|
        { written: b.name, global: b.qualified, ops: ops_of(mods, b.owner, b.name) });
      fold(scope.modules, bare, |acc: List<EffectName>, mb: ModuleBinding|
        match list_at(resolved.declared, mb.target) {
          None -> acc,
          Some(theirs) ->
            fold(theirs.effects, acc, |a: List<EffectName>, b: Binding|
              push(a, {
                written: bytes_concat_all([mb.binder, b"::", b.name]),
                global: b.qualified,
                ops: ops_of(mods, mb.target, b.name),
              })),
        })
    },
  }

fn ops_of(mods: List<ParsedModule>, owner: Int, name: Bytes) -> List<OpMode> =
  match list_at(mods, owner) {
    None -> [],
    Some(m) ->
      fold(m.module.items, [], |acc: List<OpMode>, item: Item|
        match item {
          IEffect(e) -> if e.name.name == name {
            map(e.ops, |op: OpDef| { name: op.name.name, mode: op.mode })
          } else { acc },
          _ -> acc,
        }),
  }

/// A clause may call `resume` only in tail position, once per path; every read of the binder must be such a call.
fn resume_in_tail_only(body: Code, k: Int) -> Bool =
  list::count(slots_read(body), |y: Int| y == k) == tail_calls_of(body, k)

fn tail_calls_of(code: Code, k: Int) -> Int =
  match code.node {
    NApp(a) -> match a.func.node {
      NVar(v) -> if v.slot == Some(k) && len(a.args) == 1
          && list::count(all_read(a.args), |y: Int| y == k) == 0 { 1 }
      else { 0 },
      _ -> 0,
    },
    NIf(i) -> tail_calls_of(i.then_branch, k) + tail_calls_of(i.else_branch, k),
    NBlock(b) -> match b.tail { Some(t) -> tail_calls_of(t, k), None -> 0 },
    NMatch(m) -> fold(m.arms, 0, |acc: Int, a: CodeArm| acc + tail_calls_of(a.body, k)),
    _ -> 0,
  }

/// Clause bodies become closures; the body is inlined, its failing calls landing where the frame is popped and unwinds are caught.
fn handle_site(
  emitter: Emitter,
  body: Code,
  clauses: List<CodeClause>,
  ret: Option<CodeReturn>,
  params: List<EmitParam>,
) -> Option<WithValue> / {abort.raise} = {
  let resolved = fold(clauses, true, |ok: Bool, clause: CodeClause|
    ok && (match effect_global(emitter, clause.effect) { Some(_) -> true, None -> false }));
  // A clause calling `resume` off the tail detaches the body: it runs on its own stack, so it becomes a closure.
  let detached = fold(clauses, false, |acc: Bool, clause: CodeClause|
    acc || (clause.resume && !resume_in_tail_only(clause.body, clause.params)));
  if !resolved {
    Some(refused(emitter, b"a `handle` this backend cannot carry: an effect it cannot resolve"))
  } else {
    let ans = fresh(emitter);
    let opened = line(ans.emitter, bytes_concat_all([b"Word ", ans.name, b" = 0;"]));
    match fold(
        clauses,
        Some({ emitter: opened, entries: [] }),
        |acc: Option<{ emitter: Emitter, entries: List<Bytes> }>, clause: CodeClause|
          match acc {
            None -> None,
            Some(st) -> match effect_global(emitter, clause.effect) {
              None -> None,
              Some(global) -> match closure_value(
                  notail(st.emitter),
                  {
                    params: clause.params + (if clause.binds_label { 1 } else { 0 })
                      + (if clause.resume { 1 } else { 0 }),
                    size: clause.size,
                    captures: clause.captures,
                    body: clause.body,
                    at: clause.body.span,
                  },
                  params,
                ) {
                None -> None,
                Some(cl) -> {
                  let held = owned(cl.emitter, cl.value);
                  let ef = field_of(held.emitter, global);
                  // A clause on a label parameter keys on the slot, read where the table is built.
                  let lb: Option<WithValue> = match clause.label {
                    None -> None,
                    Some(cd) -> expr(notail(ef.emitter), cd, params),
                  };
                  let wanted = match clause.label { None -> false, Some(_) -> true };
                  let res = if wanted { None }
                  else if clause.resource == b"" { None }
                  else { Some(field_of(ef.emitter, clause.resource)) };
                  let op = field_of(
                    match lb {
                      Some(o) -> o.emitter,
                      None -> match res { Some(r) -> r.emitter, None -> ef.emitter },
                    },
                    clause.op,
                  );
                  if wanted && (match lb { Some(_) -> false, None -> true }) { None } else {
                    Some({
                      emitter: note_handles(
                        op.emitter,
                        bytes_concat_all([global, b"#", clause.op]),
                      ),
                      entries: push(
                        st.entries,
                        bytes_concat_all([
                          field_ref(ef.i),
                          b", ",
                          match lb {
                            Some(o) -> as_int(o.value),
                            None -> match res { Some(r) -> field_ref(r.i), None -> b"-1" },
                          },
                          b", ",
                          field_ref(op.i),
                          b", ",
                          held.value.expr,
                          b", ",
                          if clause_raises(emitter, clause) { b"3" }
                          else if !clause.resume { b"0" }
                          else if resume_in_tail_only(clause.body, clause.params) { b"1" }
                          else { b"2" },
                          b", ",
                          if clause.binds_label { b"1" } else { b"0" },
                        ]),
                      ),
                    })
                  }
                },
              },
            },
          },
      ) {
      None -> None,
      Some(built) -> {
        let arr = fresh(built.emitter);
        let table = line(
          arr.emitter,
          bytes_concat_all([
            b"Word ",
            arr.name,
            b"[] = {",
            bytes_join(built.entries, b", "),
            b"};",
          ]),
        );
        let retc = match ret {
          None -> Some({ emitter: table, clause: b"0" }),
          Some(r) -> {

            match closure_value(
                notail(table),
                { params: 1, size: r.size, captures: r.captures, body: r.body, at: r.body.span },
                params,
              ) {
              None -> None,
              Some(cl) -> {
                let held = owned(cl.emitter, cl.value);
                Some({ emitter: held.emitter, clause: held.value.expr })
              },
            }
          },
        };
        match retc {
          None -> None,
          Some(rc) -> if detached {
            // The body closes over every slot it reads at the same slot numbers, so nothing is renumbered.
            let reads = filter(dedup(slots_read(body)), |r: Int|
              match conv_of(rc.emitter, r) {
                Some(_) -> true,
                None -> match list_at(params, r) { Some(_) -> true, None -> false },
              });
            match closure_value(
                notail(rc.emitter),
                {
                  params: 0,
                  size: fold(reads, 0, |m: Int, r: Int| if r + 1 > m { r + 1 } else { m }),
                  captures: map(reads, |r: Int| { src: r, dst: r, own: Borrowed }),
                  body: body,
                  at: body.span,
                },
                params,
              ) {
              None -> None,
              Some(cl) -> {
                let held = owned(cl.emitter, cl.value);
                let out = bind(
                  held.emitter,
                  KBoxed,
                  bytes_concat_all([
                    b"rt_handle_detached_p(ctx, (Word)(intptr_t)",
                    arr.name,
                    b", ",
                    ascii_of_int(len(clauses)),
                    b", ",
                    rc.clause,
                    b", ",
                    held.value.expr,
                    b")",
                  ]),
                );
                Some({ emitter: check(out.emitter), value: out.value })
              },
            }
          } else {
            let depth = bind(
              rc.emitter,
              KInt,
              bytes_concat_all([
                b"rt_handle_push_p(ctx, (Word)(intptr_t)",
                arr.name,
                b", ",
                ascii_of_int(len(clauses)),
                b", ",
                rc.clause,
                b")",
              ]),
            );
            let mark = fresh(depth.emitter);
            let label = bytes_concat(b"land_", ascii_of_int(mark.emitter.temp_count));
            // Under release the body is its own block, so its holders are released at its close, before the landing label.
            let opened = if mark.emitter.release { indent(line(mark.emitter, b"{")) }
            else { mark.emitter };
            match expr(notail(with_landing(opened, Some(label))), body, params) {
              None -> None,
              Some(emitted) -> {
                let b = if leaves_unlanded(opened.out, emitted.emitter.out) {
                  refused(emitted.emitter, b"a `handle` body that leaves without landing")
                } else { emitted };
                let bw = owned(b.emitter, b.value);
                let set = line(
                  bw.emitter,
                  bytes_concat_all([ans.name, b" = ", bw.value.expr, b";"]),
                );
                let closed = if set.release {
                  with_made(
                    close(set),
                    union_made(mark.emitter.count_locals, release_at(set, set.indent).count_locals),
                  )
                } else { set };
                let landed = line(
                  with_landing(closed, emitter.landing),
                  bytes_concat_all([label, b":;"]),
                );
                let out = bind(
                  landed,
                  KBoxed,
                  bytes_concat_all([
                    b"rt_handle_land_p(ctx, ",
                    depth.value.expr,
                    b", ",
                    ans.name,
                    b")",
                  ]),
                );
                Some({ emitter: check(out.emitter), value: out.value })
              },
            }
          },
        }
      },
    }
  }
}

/// Whether what a `handle` body emitted past `opened` holds a `return`, which would leave the frame
/// installed and a raise bound for it unanswered: a body that fails leaves by `leaving` alone.
fn leaves_unlanded(opened: List<Bytes>, body: List<Bytes>) -> Bool / {abort.raise} = {
  let before = bytes_join(opened, b"");
  let after = bytes_join(body, b"");
  bytes_starts_with(after, before)
    && bytes_index_of(bytes_slice(after, bytes_len(before), bytes_len(after)), b"return ") != None
}

fn dedup(xs: List<Int>) -> List<Int> =
  fold(xs, [], |acc: List<Int>, x: Int|
    if list::count(acc, |y: Int| y == x) > 0 { acc } else { push(acc, x) })

/// Each item is duplicated as soon as it is evaluated, unlike a call's two passes; each order is wrong in the other's place.
fn items(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  i: Int,
  acc: List<Bytes>,
) -> Option<{ emitter: Emitter, names: List<Bytes>, vals: List<CValue> }> / {abort.raise} =
  items_from(emitter, codes, params, i, acc, [], [])

/// A record's fields, each held as `kinds` says the record holds it: a word the record takes, or a
/// `Float`'s bits.
fn items_laid(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  kinds: List<Kind>,
) -> Option<{ emitter: Emitter, names: List<Bytes>, vals: List<CValue> }> / {abort.raise} =
  items_from(emitter, codes, params, 0, [], [], kinds)

fn items_from(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  i: Int,
  acc: List<Bytes>,
  values: List<CValue>,
  kinds: List<Kind>,
) -> Option<{ emitter: Emitter, names: List<Bytes>, vals: List<CValue> }> / {abort.raise} =
  if i >= len(codes) { Some({ emitter: emitter, names: acc, vals: values }) } else {
    match list_at(codes, i) {
      None -> None,
      Some(x) -> match expr(notail(emitter), x, params) {
        None -> None,
        Some(o) -> {
          let raw = raw_slot(kind_at(kinds, i)) && len(kinds) > i;
          let d = if raw { held_raw(o.emitter, o.value, kind_at(kinds, i)) }
          else { { emitter: o.emitter, value: o.value } };
          let w = if !raw { owned(o.emitter, o.value) }
          else if kind_at(kinds, i) == KDec { d }
          else { bind(d.emitter, KInt, raw_word(d.value)) };
          items_from(
            w.emitter,
            codes,
            params,
            i + 1,
            push(acc, w.value.expr),
            push(values, if raw { d.value } else { taken_as(w.emitter, o.value, w.value) }),
            kinds,
          )
        },
      },
    }
  }

/// Under release the temporary a field came from is null once the record takes it, so the held word is remembered instead.
fn taken_as(emitter: Emitter, v: CValue, w: CValue) -> CValue =
  if emitter.release && counted(v.kind) { { kind: KBoxed, expr: w.expr, ty: v.ty } } else { v }

/// Under release a value read now and taken later is duplicated now: a read in between may be its last use and move it.
fn secure(emitter: Emitter, value: CValue) -> WithValue =
  if !emitter.release || !counted(value.kind) || spendable(emitter, value.expr) {
    { emitter: emitter, value: value }
  } else {
    let w = owned_word(emitter, { ..value, kind: KBoxed });
    {
      emitter: note_made(w.emitter, w.value.expr),
      value: { kind: value.kind, expr: w.value.expr, ty: value.ty },
    }
  }

fn secured(o: Option<WithValue>) -> Option<WithValue> =
  match o { None -> None, Some(x) -> Some(secure(x.emitter, x.value)) }

/// Duplicated only when a read in `later` can move it: a count per byte in the inline family's loops would cost what it saves.
fn secure_across(
  emitter: Emitter,
  value: CValue,
  later: Code,
  params: List<EmitParam>,
) -> WithValue =
  if !emitter.release || !counted(value.kind) || spendable(emitter, value.expr) {
    { emitter: emitter, value: value }
  } else {
    let r = root_of(emitter, value.expr);
    let moved = fold(slots_read(later), false, |acc: Bool, s: Int|
      acc
        || (match local_of(emitter, params, s) {
          Some(c) -> is_made(emitter, c) && !is_pinned(emitter, c) && root_of(emitter, c) == r,
          None -> false,
        }));
    if moved { secure(emitter, value) } else { { emitter: emitter, value: value } }
  }

/// The local a slot reads as: the window's, or a parameter the prologue did not open.
fn local_of(emitter: Emitter, params: List<EmitParam>, s: Int) -> Option<Bytes> =
  match conv_of(emitter, s) {
    Some(cv) -> Some(cv.expr),
    None -> match list_at(params, s) {
      Some(_) -> Some(bytes_concat(b"p", ascii_of_int(s))),
      None -> None,
    },
  }

/// What a slot reads as, with the type the prologue knows a parameter it did not open by.
fn slot_value(emitter: Emitter, params: List<EmitParam>, s: Int) -> Option<CValue> =
  match conv_of(emitter, s) {
    Some(cv) -> Some(cv),
    None -> match list_at(params, s) {
      Some(p) -> if p.kind == KBoxed {
        Some({ kind: KBoxed, expr: bytes_concat(b"p", ascii_of_int(s)), ty: p.ty })
      } else { None },
      None -> None,
    },
  }

/// A statement that is a last read and nothing else: a slot's, or a field's through a record read
/// after it.
fn last_read(code: Code) -> Option<{ slot: Int, field: Option<Bytes> }> =
  if code.own != Owned { None } else {
    match code.node {
      NVar(v) -> match v.slot { Some(s) -> Some({ slot: s, field: None }), None -> None },
      NField(f) -> if f.base.own != Borrowed { None } else {
        match f.base.node {
          NVar(v) -> match v.slot {
            Some(s) -> Some({ slot: s, field: Some(f.field) }),
            None -> None,
          },
          _ -> None,
        }
      },
      _ -> None,
    }
  }

/// The count a slot's local holds let go, where this body holds it and no loop reads it again.
fn released_slot(emitter: Emitter, s: Int, params: List<EmitParam>) -> Emitter =
  match slot_value(emitter, params, s) {
    Some(v) -> if emitter.release && counted(v.kind) && is_made(emitter, v.expr)
        && !is_pinned(emitter, v.expr) { release_holder(spend_made(emitter, v.expr), v) }
    else { emitter },
    None -> emitter,
  }

/// A record's field let go where the record is its only holder, as a field's last read takes it:
/// a count read out of the field before is then the only one. A record built here, or held back,
/// keeps its fields.
fn released_field(emitter: Emitter, s: Int, name: Bytes, params: List<EmitParam>) -> Emitter =
  match slot_value(emitter, params, s) {
    None -> emitter,
    Some(v) -> if !emitter.release || !counted(v.kind) || !is_made(emitter, v.expr)
        || is_pinned(emitter, v.expr)
        || deferred_of(emitter, v.expr) != None
        || built_of(emitter, v.expr) != None { emitter } else {
      match field_at(v.ty, name) {
        Some(i) -> if i.kind != KBoxed || width_of(i.ty) != None { emitter } else {
          let t = fresh(emitter);
          line(
            t.emitter,
            bytes_concat_all([
              b"if (ply_obj(",
              v.expr,
              b")->rc == 1) { Word ",
              t.name,
              b" = ply_words(",
              v.expr,
              b")[",
              ascii_of_int(i.at),
              b"]; ply_words(",
              v.expr,
              b")[",
              ascii_of_int(i.at),
              b"] = ply_unit; ply_dec(ctx, ",
              t.name,
              b"); }",
            ]),
          )
        },
        None -> {
          let idx = field_of(open_needed(emitter, v.ty), name);
          let t = fresh(idx.emitter);
          check(
            line(
              t.emitter,
              bytes_concat_all([
                b"{ Word ",
                t.name,
                b" = rt_field_p(ctx, ",
                v.expr,
                b", @@f",
                ascii_of_int(idx.i),
                b"@@, 2); ply_dec(ctx, ",
                t.name,
                b"); }",
              ]),
            ),
          )
        },
      }
    },
  }

fn bytes_join(xs: List<Bytes>, sep: Bytes) -> Bytes =
  fold(range(0, len(xs)), b"", |acc: Bytes, i: Int|
    bytes_concat_all([
      acc,
      if i == 0 { b"" } else { sep },
      match list_at(xs, i) { Some(x) -> x, None -> b"" },
    ]))

/// A `let` binds its value under its own name even when it is already a temporary.
fn stmts(
  emitter: Emitter,
  xs: List<CodeStmt>,
  params: List<EmitParam>,
  i: Int,
) -> Option<Emitter> / {abort.raise} =
  if i >= len(xs) { Some(emitter) } else {
    match list_at(xs, i) {
      None -> None,
      Some(st) -> match st {
        CLet(l) -> match expr(notail(emitter), l.value, params) {
          None -> None,
          Some(o) -> {
            let b = bind_keeping(o.emitter, o.value.kind, o.value.ty, o.value.expr);
            stmts(remember(ensure_owned(b.emitter, b.value), l.slot, b.value), xs, params, i + 1)
          },
        },
        // A refutable `let` tests the pattern first and raises rather than reading a missing field.
        CLetPat(l) -> match expr(notail(emitter), l.value, params) {
          None -> None,
          Some(o) -> {
            let w = word_of(o.emitter, o.value);
            let held = bind(w.emitter, KBoxed, w.expr);
            let checked = if irrefutable(l.pat) { Some(held.emitter) } else {
              match pat_test(l.pat, held.value, held.emitter) {
                None -> None,
                Some(t) ->
                  Some(
                    line(
                      site(t.emitter, l.span),
                      bytes_concat_all([
                        b"if (!(",
                        t.expr,
                        b")) { rt_let_no_match_p(ctx); ",
                        leaving(t.emitter),
                        b" }",
                      ]),
                    ),
                  ),
              }
            };
            match checked {
              None -> None,
              Some(gem) ->
                stmts(
                  let_go(pat_bind(gem, l.pat, held.value), { ..held.value, ty: o.value.ty }, l.pat),
                  xs,
                  params,
                  i + 1,
                ),
            }
          },
        },
        // A last read standing alone, as a branch opens with, lets the count go without reading it.
        CDo(d) -> match last_read(d.code) {
          Some(r) ->
            stmts(
              match r.field {
                None -> released_slot(emitter, r.slot, params),
                Some(name) -> released_field(emitter, r.slot, name, params),
              },
              xs,
              params,
              i + 1,
            ),
          None -> match expr(notail(emitter), d.code, params) {
            None -> None,
            Some(o) ->
              stmts(
                drop_value(
                  line(o.emitter, bytes_concat_all([b"(void)(", o.value.expr, b");"])),
                  o.value,
                ),
                xs,
                params,
                i + 1,
              ),
          },
        },
      },
    }
  }

/// Each arm is guarded by the flag rather than an `else`, so its test is written at one depth.
fn arms(
  emitter: Emitter,
  xs: List<CodeArm>,
  params: List<EmitParam>,
  i: Int,
  subj: CValue,
  sink: Sink,
  flag: Bytes,
  base: List<CountLocal>,
  seen: List<CountLocal>,
) -> Option<Emitter> / {abort.raise} =
  if i >= len(xs) { Some(with_made(emitter, if i == 0 { emitter.count_locals } else { seen })) }
  else {
    match list_at(xs, i) {
      None -> None,
      Some(a) -> {
        let guarded = indent(
          line(with_made(emitter, base), bytes_concat_all([b"if (!", flag, b") {"])),
        );
        match pat_test(a.pat, subj, guarded) {
          None -> Some(poison(emitter, b"a pattern this port cannot test")),
          Some(t) -> {
            let opened = line(t.emitter, bytes_concat_all([b"if (", t.expr, b") {"]));
            let inner = indent(opened);
            // Past a failing guard the next arm tests the subject again, so neither its binders nor the guard may take its count.
            let binding = match a.guard {
              None -> inner,
              Some(_) -> with_pinned(inner, push(inner.pinned, subj.expr)),
            };
            let bound = let_go(pat_bind(binding, a.pat, subj), subj, a.pat);
            match guarded_body(
                bound,
                inner.pinned,
                a.guard,
                sink,
                a.body,
                params,
                flag,
                emitter.tail,
              ) {
              None -> None,
              Some(o) -> {
                let closed = close(close(o));
                // The next arm is a tail when this one was: the body's own nodes cleared the flag.
                arms(
                  withtail(rescope(closed, emitter.unboxed), emitter.tail),
                  xs,
                  params,
                  i + 1,
                  subj,
                  sink,
                  flag,
                  base,
                  union_made(seen, closed.count_locals),
                )
              },
            }
          },
        }
      },
    }
  }

/// A failing guard leaves the flag clear; what the body moves is still held on that path, so it stays in `made`.
fn guarded_body(
  emitter: Emitter,
  pinned: List<Bytes>,
  guard: Option<Code>,
  sink: Sink,
  body: Code,
  params: List<EmitParam>,
  flag: Bytes,
  tail: Bool,
) -> Option<Emitter> / {abort.raise} =
  match guard {
    None -> match arm_body(with_pinned(emitter, pinned), sink, body, params) {
      None -> None,
      Some(o) -> Some(line(o, bytes_concat_all([flag, b" = 1;"]))),
    },
    Some(g) -> match expr(notail(emitter), g, params) {
      None -> None,
      Some(gv) -> {
        let opened = line(gv.emitter, bytes_concat_all([b"if (", as_bool(gv.value), b") {"]));
        match arm_body(with_pinned(withtail(indent(opened), tail), pinned), sink, body, params) {
          None -> None,
          Some(o) -> {
            let closed = close(line(o, bytes_concat_all([flag, b" = 1;"])));
            Some(
              rescope(
                with_made(closed, union_made(opened.count_locals, closed.count_locals)),
                opened.unboxed,
              ),
            )
          },
        }
      },
    },
  }

fn arm_body(
  emitter: Emitter,
  sink: Sink,
  body: Code,
  params: List<EmitParam>,
) -> Option<Emitter> / {abort.raise} =
  match sink {
    ToValue(ans) -> match expr(emitter, body, params) {
      None -> None,
      Some(o) -> if ans.kind == KMaybe {
        let w = maybe_owned(o.emitter, o.value);
        Some(line(w.emitter, bytes_concat_all([ans.name, b" = ", w.value.expr, b";"])))
      } else {
        let w = word_of(o.emitter, o.value);
        Some(
          assign_owned(
            line(w.emitter, bytes_concat_all([ans.name, b" = ", w.expr, b";"])),
            ans.name,
            w.expr,
          ),
        )
      },
    },
    ToLoop(l) -> emit_step(emitter, body, l.state, l.answer, l.stop, l.go, params, l.depth),
  }

/// A match's subject: an `Option` held as its payload's word as it is, anything else as its word.
fn match_subject(
  emitter: Emitter,
  scrutinee: Code,
  params: List<EmitParam>,
) -> Option<{ emitter: Emitter, subj: CValue }> / {abort.raise} =
  match expr(notail(emitter), scrutinee, params) {
    None -> None,
    Some(sc) -> if sc.value.kind == KMaybe {
      let subj = bind_keeping(sc.emitter, KMaybe, sc.value.ty, sc.value.expr);
      Some({ emitter: subj.emitter, subj: subj.value })
    } else {
      let sw = word_of(sc.emitter, sc.value);
      let subj = bind_keeping(sw.emitter, KBoxed, sc.value.ty, sw.expr);
      Some({ emitter: subj.emitter, subj: subj.value })
    },
  }

/// Arms over one flag; a body falling off the end raises. `tail` is the match's own position, which evaluating the subject cleared.
fn match_arms(
  emitter: Emitter,
  subj: CValue,
  xs: List<CodeArm>,
  params: List<EmitParam>,
  sink: Sink,
  span: Span,
  tail: Bool,
) -> Option<Emitter> / {abort.raise} = {
  let flag = fresh(emitter);
  let opened = line(flag.emitter, bytes_concat_all([b"int ", flag.name, b" = 0;"]));
  match arms(withtail(opened, tail), xs, params, 0, subj, sink, flag.name, opened.count_locals, [
    ]) {
    None -> None,
    Some(after) ->
      Some(
        line(
          site(after, span),
          bytes_concat_all([
            b"if (!",
            flag.name,
            b") { rt_no_match_p(ctx); ",
            leaving(after),
            b" }",
          ]),
        ),
      ),
  }
}

/// Outside the immediate range an `Int` is boxed, and so is every word that can equal it.
fn int_test(subj: Bytes, n: Int) -> Bytes =
  if n >= 0 - 4611686018427387904 && n < 4611686018427387904 {
    bytes_concat_all([
      b"(ply_is_imm(",
      subj,
      b") ? ply_imm_value(",
      subj,
      b") == ",
      int_lit(n),
      b" : 0)",
    ])
  } else {
    bytes_concat_all([
      b"(",
      subj,
      b" != 0 && !ply_is_imm(",
      subj,
      b") && rt_unbox_int_p(ctx, ",
      subj,
      b") == ",
      int_lit(n),
      b")",
    ])
  }

/// An `Int` or a carried width from `lo` through `hi`. Every word that can be in the immediate
/// range is immediate, so bounds inside it leave a boxed word out.
fn int_between(subj: Bytes, lo: Int, hi: Int) -> Bytes = {
  let within = |v: Bytes|
    bytes_concat_all([b"(", v, b" >= ", int_lit(lo), b" && ", v, b" <= ", int_lit(hi), b")"]);
  let immediate = within(bytes_concat_all([b"ply_imm_value(", subj, b")"]));
  if lo >= 0 - 4611686018427387904 && hi < 4611686018427387904 {
    bytes_concat_all([b"(ply_is_imm(", subj, b") ? ", immediate, b" : 0)"])
  } else {
    bytes_concat_all([
      b"(",
      subj,
      b" != 0 && (ply_is_imm(",
      subj,
      b") ? ",
      immediate,
      b" : ",
      within(bytes_concat_all([b"rt_unbox_int_p(ctx, ", subj, b")"])),
      b"))",
    ])
  }
}

/// A range over a width past 32 bits, whose values the runtime orders, against the unit's constants.
fn between_test(
  emitter: Emitter,
  lo: Lit,
  hi: Lit,
  subj: CValue,
) -> { emitter: Emitter, expr: Bytes } = {
  let from = from_table(emitter, lo);
  let to = from_table(from.emitter, hi);
  let held = bind(
    to.emitter,
    KBool,
    bytes_concat_all([
      b"(",
      subj.expr,
      b" != 0 && rt_between_p(ctx, ",
      subj.expr,
      b", ",
      from.value.expr,
      b", ",
      to.value.expr,
      b"))",
    ]),
  );
  { emitter: check(held.emitter), expr: held.value.expr }
}

/// As `==` compares, against the unit's constant; a zero subject is an enclosing test that failed.
fn equal_test(emitter: Emitter, literal: Lit, subj: CValue) -> { emitter: Emitter, expr: Bytes } = {
  let k = from_table(emitter, literal);
  let eq = bind(
    k.emitter,
    KBool,
    bytes_concat_all([
      b"(",
      subj.expr,
      b" != 0 && rt_equal_p(ctx, ",
      subj.expr,
      b", ",
      k.value.expr,
      b"))",
    ]),
  );
  { emitter: check(eq.emitter), expr: eq.value.expr }
}

/// A nested pattern reads a field into a local under the test so far, since reading a non-record raises. `None` for an unsupported pattern.
fn pat_test(
  pattern: CodePattern,
  subj: CValue,
  emitter: Emitter,
) -> Option<{ emitter: Emitter, expr: Bytes }> / {abort.raise} =
  match pattern {
    PxWild -> Some({ emitter: emitter, expr: b"1" }),
    PxVar(_) -> Some({ emitter: emitter, expr: b"1" }),
    PxLit(l) -> match l {
      LInt(n) -> Some({ emitter: emitter, expr: int_test(subj.expr, n) }),
      // At 64 bits a width is the runtime's own object, not an immediate.
      LFixed(name, bits) -> match width_named(name) {
        None -> None,
        Some(w) -> if in_imm(w) { Some({ emitter: emitter, expr: int_test(subj.expr, bits) }) }
        else { Some(equal_test(emitter, l, subj)) },
      },
      LBool(b) ->
        Some({
          emitter: emitter,
          expr: bytes_concat_all([
            b"(",
            subj.expr,
            b" == ",
            if b { b"ply_true" } else { b"ply_false" },
            b")",
          ]),
        }),
      // `()` is the only value of its type.
      LUnit -> Some({ emitter: emitter, expr: b"1" }),
      LBad -> None,
      _ -> Some(equal_test(emitter, l, subj)),
    },
    PxRange(r) -> match ((r.lo, r.hi)) {
      (LInt(lo), LInt(hi)) -> Some({ emitter: emitter, expr: int_between(subj.expr, lo, hi) }),
      (LFixed(name, lo), LFixed(_, hi)) -> match width_named(name) {
        None -> None,
        Some(w) -> if in_imm(w) { Some({ emitter: emitter, expr: int_between(subj.expr, lo, hi) }) }
        else { Some(between_test(emitter, r.lo, r.hi, subj)) },
      },
      (LWide(_, _, _), LWide(_, _, _)) -> Some(between_test(emitter, r.lo, r.hi, subj)),
      _ -> None,
    },
    // A constructor tests its tag and width over an object; an argument with its own test is read into a local under the test so far.
    // A nested subject is zero when an enclosing test failed, and its header must not be read then.
    // An `Option` held as its payload's word is `None` at zero and `Some` of that word otherwise.
    PxCtor(c) -> if subj.kind == KMaybe {
      if len(c.args) == 0 {
        Some({ emitter: emitter, expr: bytes_concat_all([b"(", subj.expr, b" == 0)"]) })
      } else {
        let head = bytes_concat_all([b"(", subj.expr, b" != 0)"]);
        match list_at(c.args, 0) {
          None -> None,
          Some(sub) -> if irrefutable(sub) { Some({ emitter: emitter, expr: head }) } else {
            match pat_test(sub, { kind: KBoxed, expr: subj.expr, ty: subj.ty }, emitter) {
              None -> None,
              Some(inner) ->
                Some({
                  emitter: inner.emitter,
                  expr: bytes_concat_all([b"(", head, b" && ", inner.expr, b")"]),
                }),
            }
          },
        }
      }
    } else {
      match tag_of(emitter, c.name) {
        None -> None,
        Some(tag) -> {
          let head = bytes_concat_all([
            b"(",
            subj.expr,
            b" != 0 && !ply_is_imm(",
            subj.expr,
            b") && ply_obj(",
            subj.expr,
            b")->kind == 4 && ply_obj(",
            subj.expr,
            b")->layout == ",
            tag_text(emitter, tag),
            b" && ply_obj(",
            subj.expr,
            b")->len == ",
            ascii_of_int(ctor_width(emitter, tag, len(c.args))),
            b")",
          ]);
          let laid = ctor_fields(emitter, tag);
          fold(
            range(0, len(c.args)),
            Some({ emitter: emitter, expr: head }),
            |acc: Option<{ emitter: Emitter, expr: Bytes }>, k: Int|
              match acc {
                None -> None,
                Some(t) -> match list_at(c.args, k) {
                  None -> None,
                  Some(sub) -> if irrefutable(sub) { Some(t) } else {
                    let field = arg_tested(t.emitter, t.expr, subj.expr, k, laid);
                    match pat_test(sub, field.value, field.emitter) {
                      None -> None,
                      Some(inner) ->
                        Some({
                          emitter: inner.emitter,
                          expr: bytes_concat_all([b"(", t.expr, b" && ", inner.expr, b")"]),
                        }),
                    }
                  },
                },
              },
          )
        },
      }
    },
    // Refutable despite the shape: a non-record, the field count without `..`, or a missing field.
    PxRecord(r) -> {
      let head = bytes_concat_all([
        b"rt_record_fits_p(ctx, ",
        subj.expr,
        b", ",
        ascii_of_int(len(r.fields)),
        b", ",
        if r.rest { b"0" } else { b"1" },
        b")",
      ]);
      fold(
        r.fields,
        Some({ emitter: emitter, expr: head }),
        |acc: Option<{ emitter: Emitter, expr: Bytes }>, f: CodePatternField|
          match acc {
            None -> None,
            Some(t) -> {
              let idx = field_of(t.emitter, f.name);
              let has = bytes_concat_all([
                b"(",
                t.expr,
                b" && rt_record_has_p(ctx, ",
                subj.expr,
                b", @@f",
                ascii_of_int(idx.i),
                b"@@))",
              ]);
              if irrefutable(f.pat) { Some({ emitter: idx.emitter, expr: has }) } else {
                let field = bind(
                  idx.emitter,
                  KBoxed,
                  bytes_concat_all([
                    b"(",
                    has,
                    b" ? rt_field_p(ctx, ",
                    subj.expr,
                    b", @@f",
                    ascii_of_int(idx.i),
                    b"@@, 0) : 0)",
                  ]),
                );
                match pat_test(
                    f.pat,
                    field.value,
                    note_holder(check(field.emitter), field.value.expr),
                  ) {
                  None -> None,
                  Some(inner) ->
                    Some({
                      emitter: inner.emitter,
                      expr: bytes_concat_all([b"(", has, b" && ", inner.expr, b")"]),
                    }),
                }
              }
            },
          },
      )
    },
    // A refutable `..rest` would allocate the tail inside a test that may fail, so it is refused.
    PxList(l) -> if match l.rest { Some(r) -> !irrefutable(r), None -> false } { None } else {
      let head = bytes_concat_all([
        b"rt_list_fits_p(ctx, ",
        subj.expr,
        b", ",
        ascii_of_int(len(l.items)),
        b", ",
        match l.rest { Some(_) -> b"0", None -> b"1" },
        b")",
      ]);
      fold(
        range(0, len(l.items)),
        Some({ emitter: emitter, expr: head }),
        |acc: Option<{ emitter: Emitter, expr: Bytes }>, i: Int|
          match acc {
            None -> None,
            Some(t) -> match list_at(l.items, i) {
              None -> None,
              Some(item) -> if irrefutable(item) { Some(t) } else {
                let at = bind(
                  t.emitter,
                  KBoxed,
                  bytes_concat_all([
                    b"(",
                    t.expr,
                    b" ? rt_list_at_p(ctx, ",
                    subj.expr,
                    b", ",
                    ascii_of_int(i),
                    b") : 0)",
                  ]),
                );
                match pat_test(item, at.value, note_holder(check(at.emitter), at.value.expr)) {
                  None -> None,
                  Some(inner) ->
                    Some({
                      emitter: inner.emitter,
                      expr: bytes_concat_all([b"(", t.expr, b" && ", inner.expr, b")"]),
                    }),
                }
              },
            },
          },
      )
    },
  }

/// Argument `k` of constructor object `subj` as a word, read where `so_far` holds and zero where it
/// does not: borrowed from the object, but for a raw argument, boxed and held by this body.
fn arg_tested(
  emitter: Emitter,
  so_far: Bytes,
  subj: Bytes,
  k: Int,
  laid: Option<List<FieldTy>>,
) -> WithValue =
  match match laid { Some(fs) -> arg_at(fs, k), None -> None } {
    None ->
      bind(
        emitter,
        KBoxed,
        bytes_concat_all([b"(", so_far, b" ? ply_words(", subj, b")[", ascii_of_int(k), b"] : 0)"]),
      ),
    Some(f) -> if raw_slot(f.kind) {
      let boxed = bind(
        emitter,
        KBoxed,
        bytes_concat_all([
          b"(",
          so_far,
          b" ? ",
          as_word({ kind: f.kind, expr: raw_at(subj, ascii_of_int(f.at), f.kind), ty: TyOpen([]) }),
          b" : 0)",
        ]),
      );
      { emitter: note_holder(check(boxed.emitter), boxed.value.expr), value: boxed.value }
    } else {
      bind(emitter, KBoxed, bytes_concat_all([b"(", so_far, b" ? ", field_read(subj, f), b" : 0)"]))
    },
  }

/// Where argument `k` of a constructor laid out as `fs` starts, and how it is held.
fn arg_at(fs: List<FieldTy>, k: Int) -> Option<{ at: Int, kind: Kind, ty: Ty }> =
  match list_at(fs, k) {
    Some(f) -> match list_at(laid_of(fs).offsets, k) {
      Some(at) -> Some({ at: at, kind: f.kind, ty: f.ty }),
      None -> None,
    },
    None -> None,
  }

/// A constructor's argument is duplicated when bound: the object still holds it.
fn pat_bind(emitter: Emitter, pattern: CodePattern, subj: CValue) -> Emitter / {abort.raise} =
  match pattern {
    // The binder carries the subject's shape, so `match r { x -> x.f }` reads at an offset.
    PxVar(v) -> match v.slot {
      None -> emitter,
      Some(s) -> {
        // What the subject's own shape does not say, the type the checker bound says.
        let ty = match subj.ty {
          TyOpen(_) -> typed_kind(emitter.typed, v.span).ty,
          known -> known,
        };
        let b = bind_keeping(emitter, subj.kind, ty, subj.expr);
        remember(ensure_owned(b.emitter, b.value), s, b.value)
      },
    },
    // The payload of an `Option` held as its word is that word; its binder takes the subject's count
    // where the subject moves into it, and holds one of its own where it does not.
    PxCtor(c) -> if subj.kind == KMaybe {
      match list_at(c.args, 0) {
        None -> emitter,
        Some(sub) -> {
          let w = bind_keeping(emitter, KBoxed, subj.ty, subj.expr);
          pat_bind(ensure_owned(w.emitter, w.value), sub, w.value)
        },
      }
    } else {
      // Every argument is read and duplicated whether or not the pattern names it, so the arm's scope has one shape.
      let laid = match tag_of(emitter, c.name) {
        Some(tag) -> ctor_fields(emitter, tag),
        None -> None,
      };
      fold(range(0, len(c.args)), emitter, |acc: Emitter, i: Int| {
        let f = match laid { Some(fs) -> arg_at(fs, i), None -> None };
        let w = match f {
          Some(x) -> if raw_slot(x.kind) {
            bind(acc, x.kind, raw_at(subj.expr, ascii_of_int(x.at), x.kind))
          } else { bind_keeping(acc, KBoxed, x.ty, field_read(subj.expr, x)) },
          None ->
            bind(
              acc,
              KBoxed,
              bytes_concat_all([b"ply_words(", subj.expr, b")[", ascii_of_int(i), b"]"]),
            ),
        };
        let held = if w.value.kind != KBoxed { w.emitter } else {
          note_holder(
            line(w.emitter, bytes_concat_all([b"ply_inc(", w.value.expr, b");"])),
            w.value.expr,
          )
        };
        match list_at(c.args, i) { Some(sub) -> pat_bind(held, sub, w.value), None -> held }
      })
    },
    // The runtime's read by name answers the field duplicated; no increment here.
    PxRecord(r) ->
      fold(r.fields, emitter, |acc: Emitter, f: CodePatternField| {
        let idx = field_of(acc, f.name);
        let field = bind(
          idx.emitter,
          KBoxed,
          bytes_concat_all([
            b"rt_field_p(ctx, ",
            subj.expr,
            b", @@f",
            ascii_of_int(idx.i),
            b"@@, 0)",
          ]),
        );
        pat_bind(check(field.emitter), f.pat, field.value)
      }),
    PxList(l) -> {
      let items = fold(range(0, len(l.items)), emitter, |acc: Emitter, i: Int| {
        let at = bind(
          acc,
          KBoxed,
          bytes_concat_all([b"rt_list_at_p(ctx, ", subj.expr, b", ", ascii_of_int(i), b")"]),
        );
        match list_at(l.items, i) {
          Some(item) -> pat_bind(check(at.emitter), item, at.value),
          None -> check(at.emitter),
        }
      });
      match l.rest {
        None -> items,
        Some(r) -> {
          let tail = bind(
            items,
            KBoxed,
            bytes_concat_all([
              b"rt_list_rest_p(ctx, ",
              subj.expr,
              b", ",
              ascii_of_int(len(l.items)),
              b")",
            ]),
          );
          pat_bind(check(tail.emitter), r, tail.value)
        },
      }
    },
    _ -> emitter,
  }

/// An `if` arm goes into its own buffer so what follows it can still be numbered.
fn arm(
  emitter: Emitter,
  code: Code,
  params: List<EmitParam>,
) -> Option<{ emitter: Emitter, text: Bytes, value: CValue }> / {abort.raise} =
  match expr(indent(emitter), code, params) {
    None -> None,
    Some(o) ->
      Some({ emitter: outdent(o.emitter), text: bytes_join(o.emitter.out, b""), value: o.value }),
  }

fn assigned(
  emitter: Emitter,
  arm_em: Emitter,
  text: Bytes,
  ind: Int,
  k: Kind,
  value: CValue,
  join: Bytes,
) -> { emitter: Emitter, text: Bytes, made: List<CountLocal> } = {
  // The join takes the arm's value; the arm's own holders are released behind it.
  let m2 = if k == KMaybe || value.kind == KMaybe {
    // An `Option` joins as its payload's word where it does as one, and as its object elsewhere.
    let arm = with_made(indent(with_out(emitter, [])), arm_em.count_locals);
    let o = if k == KMaybe { maybe_owned(arm, value) } else { owned(arm, value) };
    line(o.emitter, bytes_concat_all([join, b" = ", o.value.expr, b";"]))
  } else {
    let m0 = match k {
      KBoxed -> materialise(indent(with_out(emitter, [])), value.expr),
      _ -> indent(with_out(emitter, [])),
    };
    let m1 = line(m0, bytes_concat_all([join, b" = ", as_kind(value, k), b";"]));
    if counted(k) { assign_owned(with_made(m1, arm_em.count_locals), join, value.expr) }
    else { with_made(m1, arm_em.count_locals) }
  };
  let m3 = release_at(m2, ind + 1);
  {
    emitter: outdent(with_out(with_made(m3, emitter.count_locals), emitter.out)),
    text: bytes_concat_all([text, bytes_join(m3.out, b"")]),
    made: m3.count_locals,
  }
}

fn as_kind(value: CValue, k: Kind) -> Bytes =
  match k {
    KBoxed -> as_word(value),
    KMaybe -> if value.kind == KMaybe { value.expr } else { b"ply_maybe_unrouted" },
    KInt -> as_int(value),
    KBool -> as_bool(value),
    KNum(w) -> as_num(value, w),
    KFloat -> as_float(value),
    KDec -> as_dec(value),
  }

/// A record-valued join: one assignment per field, from the values the record was built from.
fn joined(
  emitter: Emitter,
  arm_em: Emitter,
  text: Bytes,
  value: CValue,
  names: List<Bytes>,
  js: List<CValue>,
) -> { text: Bytes, made: List<CountLocal> } = {
  let a0 = with_made(indent(with_out(emitter, [])), arm_em.count_locals);
  let a1 = fold(range(0, len(names)), a0, |acc: Emitter, i: Int| {
    let target = match list_at(js, i) { Some(x) -> x.expr, None -> b"" };
    let jk = match list_at(js, i) { Some(x) -> x.kind, None -> KInt };
    let fv = match list_at(names, i) {
      Some(nm) -> built_field(emitter, value.expr, nm),
      None -> None,
    };
    let l = line(
      acc,
      bytes_concat_all([
        target,
        b" = ",
        match fv { Some(x) -> as_kind(x, jk), None -> b"0" },
        b";",
      ]),
    );
    if jk == KBoxed { match fv { Some(x) -> assign_owned(l, target, x.expr), None -> l } }
    else { l }
  });
  let a2 = release_at(a1, emitter.indent + 1);
  { text: bytes_concat_all([text, bytes_join(a2.out, b"")]), made: a2.count_locals }
}

fn blank(emitter: Emitter) -> Emitter =
  {
    out: [],
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: emitter.built,
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: emitter.released,
    reuse_widths: emitter.reuse_widths,
    alias: emitter.alias,
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred,
    deferred_locals: emitter.deferred_locals,
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
  }

/// The shape both arms answer when both built a record of the same shape; otherwise the join is one local.
fn shared_shape(emitter: Emitter, a: CValue, b: CValue) -> Option<List<Bytes>> =
  match a.ty {
    TyRec(na) -> match b.ty {
      TyRec(nb) -> if same_names(names_of(na), names_of(nb))
          && fold(sorted_names(names_of(na)), true, |acc: Bool, nm: Bytes|
            acc
              && (match built_field(emitter, a.expr, nm) {
                None -> false,
                Some(x) -> match built_field(emitter, b.expr, nm) {
                  None -> false,
                  Some(y) -> x.kind == y.kind && x.kind != KBoxed,
                },
              })) { Some(sorted_names(names_of(na))) }
      else { None },
      _ -> None,
    },
    _ -> None,
  }

/// Sorted by name: the order a shape holds its fields in.
fn sorted_names(ns: List<Bytes>) -> List<Bytes> =
  fold(range(0, len(ns)), [], |acc: List<Bytes>, i: Int|
    fold(ns, acc, |a2: List<Bytes>, n: Bytes| if rank_of(ns, n) == i { push(a2, n) } else { a2 }))

fn rebuild(emitter: Emitter, names: List<Bytes>, values: List<CValue>) -> Option<WithValue> =
  Some(
    build_record(
      emitter,
      names,
      map(range(0, len(values)), |at: Int|
        match list_at(values, at) {
          Some(value) -> if raw_slot(value.kind) { raw_word(value) } else { as_word(value) },
          None -> b"0",
        }),
      map(range(0, len(values)), |at: Int|
        {
          name: match list_at(names, at) { Some(nm) -> nm, None -> b"" },
          kind: match list_at(values, at) { Some(v) -> v.kind, None -> KBoxed },
          ty: TyOpen([]),
        }),
      Some(values),
    ),
  )

/// `INT64_C(-9223372036854775808)` negates an unsigned literal, which C cannot write as a constant, so the least `Int` is named.
fn int_lit(n: Int) -> Bytes =
  if n == 0 - 9223372036854775807 - 1 { b"INT64_MIN" }
  else { bytes_concat_all([b"INT64_C(", ascii_of_int(n), b")"]) }

/// Two literals folded under an operator: `+`, `-`, `*` only without overflow, a shift only by a count the width holds.
fn lit_int(code: Code) -> Option<Int> =
  match code.node {
    NLit(l) -> match l { LInt(n) -> Some(n), _ -> None },
    NBinary(b) -> match lit_int(b.lhs) {
      None -> None,
      Some(a) -> match lit_int(b.rhs) {
        None -> None,
        Some(x) -> if b.op == b"add" { checked_add(a, x) }
        else if b.op == b"sub" { checked_sub(a, x) }
        else if b.op == b"mul" { checked_mul(a, x) }
        else if b.op == b"bitand" { Some(a & x) }
        else if b.op == b"bitor" { Some(a | x) }
        else if b.op == b"bitxor" { Some(a ^ x) }
        else if b.op == b"shl" && x >= 0 && x < 64 { Some(a << x) }
        else if b.op == b"shr" && x >= 0 && x < 64 { Some(a >> x) }
        else if b.op == b"ushr" && x >= 0 && x < 64 { Some(a >>> x) }
        else { None },
      },
    },
    _ -> None,
  }

fn checked_add(a: Int, b: Int) -> Option<Int> = {
  let s = wrap_add(a, b);
  if a >= 0 == (b >= 0) && s >= 0 != (a >= 0) { None } else { Some(s) }
}

fn checked_sub(a: Int, b: Int) -> Option<Int> = {
  let s = wrap_sub(a, b);
  if a >= 0 != (b >= 0) && s >= 0 != (a >= 0) { None } else { Some(s) }
}

fn checked_mul(a: Int, b: Int) -> Option<Int> =
  if a == 0 || b == 0 { Some(0) }
  else if a == -1 { checked_sub(0, b) }
  else if b == -1 { checked_sub(0, a) } else {
    let p = wrap_mul(a, b);
    if p / a == b && p % a == 0 { Some(p) } else { None }
  }

/// Where two arms disagree the join is a word, and each is converted into it.
/// Two arms of one type: an `Option` either holds as its payload's word joins as one.
fn join_kind(a: Kind, b: Kind) -> Kind =
  if a == b { a } else if a == KMaybe || b == KMaybe { KMaybe } else { KBoxed }

fn is_bitop(op: Bytes) -> Bool = op == b"bitand" || op == b"bitor" || op == b"bitxor"

fn is_shift(op: Bytes) -> Bool = op == b"shl" || op == b"shr" || op == b"ushr"

fn bitop_c(op: Bytes) -> Bytes =
  if op == b"bitand" { b"&" } else if op == b"bitor" { b"|" } else { b"^" }

/// `rt_overflow`'s numbering of the operation that overflowed; a remainder never leaves its width.
fn overflow_code(op: Bytes) -> Int =
  if op == b"add" { 0 }
  else if op == b"sub" { 1 }
  else if op == b"neg" { 2 }
  else if op == b"mul" { 3 }
  else { 4 }

fn narrow(wide: WithValue, width: Width, code: Int) -> Option<WithValue> = {
  let g = line(
    wide.emitter,
    bytes_concat_all([
      b"if (",
      wide.value.expr,
      b" < ",
      int_lit(width_min(width)),
      b" || ",
      wide.value.expr,
      b" > ",
      int_lit(width_max(width)),
      b") { rt_overflow_p(ctx, ",
      ascii_of_int(code),
      b"); ",
      leaving(wide.emitter),
      b" }",
    ]),
  );
  Some(bind(g, KNum(width), bytes_concat_all([b"(", ctype(KNum(width)), b")", wide.value.expr])))
}

fn negated(emitter: Emitter, value: CValue, t: Operand, span: Span) -> Option<WithValue> =
  match t {
    // A width negates wide and narrows back, under the same guard as a subtraction.
    OWidth(w) -> if in_imm(w) {
      narrow(
        bind(site(emitter, span), KInt, bytes_concat_all([b"-(int64_t)(", as_num(value, w), b")"])),
        w,
        overflow_code(b"neg"),
      )
    } else if carried(w) && w.signed {
      let a = bind(site(emitter, span), KNum(w), as_num(value, w));
      let g = line(
        a.emitter,
        bytes_concat_all([
          b"if (",
          a.value.expr,
          b" == INT64_MIN) { rt_overflow_p(ctx, ",
          ascii_of_int(overflow_code(b"neg")),
          b"); ",
          leaving(emitter),
          b" }",
        ]),
      );
      Some(bind(g, KNum(w), bytes_concat_all([b"-(", a.value.expr, b")"])))
    } else { by_runtime(site(emitter, span), b"rt_negate_p", value) },
    OInt -> {
      // Negation overflows at one input; the guard runs before the value exists.
      let a = as_int(value);
      let g = line(
        site(emitter, span),
        bytes_concat_all([
          b"if (",
          a,
          b" == INT64_MIN) { rt_overflow_p(ctx, ",
          ascii_of_int(overflow_code(b"neg")),
          b"); ",
          leaving(emitter),
          b" }",
        ]),
      );
      Some(bind(g, KInt, bytes_concat_all([b"-(", a, b")"])))
    },
    OFloat -> Some(bind(emitter, KFloat, bytes_concat_all([b"-(", as_float(value), b")"]))),
    ODec -> {
      let d = held_raw(emitter, value, KDec);
      let out = fresh(d.emitter);
      let e = line(
        out.emitter,
        bytes_concat_all([
          b"PlyDec ",
          out.name,
          b"; rt_decimal_negate_p(ctx, ",
          d.value.expr,
          b".lo, ",
          d.value.expr,
          b".hi, (Word)(intptr_t)&",
          out.name,
          b");",
        ]),
      );
      Some({ emitter: e, value: { kind: KDec, expr: out.name, ty: TyOpen([]) } })
    },
    _ -> by_runtime(site(emitter, span), b"rt_negate_p", value),
  }

fn inverted(emitter: Emitter, value: CValue, t: Operand) -> Option<WithValue> =
  match t {
    OWidth(w) -> if carried(w) {
      Some(
        bind(
          emitter,
          KNum(w),
          bytes_concat_all([b"(", ctype(KNum(w)), b") ~(", as_num(value, w), b")"]),
        ),
      )
    } else { by_runtime(emitter, b"rt_bitnot_p", value) },
    _ -> Some(bind(emitter, KInt, bytes_concat_all([b"~(", as_int(value), b")"]))),
  }

/// A unary operator over the runtime's own word: a `Float`, a `Decimal` or a width past 32 bits.
fn by_runtime(emitter: Emitter, helper: Bytes, value: CValue) -> Option<WithValue> = {
  let held = owned(emitter, value);
  let out = bind(
    held.emitter,
    KBoxed,
    bytes_concat_all([helper, b"(ctx, ", held.value.expr, b")"]),
  );
  Some({ emitter: check(out.emitter), value: out.value })
}

/// The count is tested against the width (64 for `Int`), and the shift done unsigned where C would leave it undefined.
fn shift(emitter: Emitter, op: Bytes, l: CValue, r: CValue, width: Option<Width>) -> WithValue = {
  let bound = match width { Some(t) -> t.bits, None -> 64 };
  let count = bind(emitter, KInt, as_int(r));
  let which = match width { Some(t) -> ascii_of_int(width_index(t)), None -> b"-1" };
  let g = line(
    count.emitter,
    bytes_concat_all([
      b"if ((uint64_t)",
      count.value.expr,
      b" >= (uint64_t)",
      ascii_of_int(bound),
      b") { rt_shift_count_p(ctx, ",
      count.value.expr,
      b", ",
      which,
      b"); ",
      leaving(emitter),
      b" }",
    ]),
  );
  match width {
    Some(t) -> {
      let a = as_num(l, t);
      let u = unsigned_ctype(t);
      bind(g, KNum(t), if op == b"shl" {
        bytes_concat_all([b"(", u, b")((", u, b")(", a, b") << ", count.value.expr, b")"])
      } else if op == b"shr" && t.signed { bytes_concat_all([b"(", a, b") >> ", count.value.expr]) }
      else { bytes_concat_all([b"(", u, b")((", u, b")(", a, b") >> ", count.value.expr, b")"]) })
    },
    None -> {
      let a = as_int(l);
      bind(g, KInt, if op == b"shl" {
        bytes_concat_all([b"(int64_t)((uint64_t)(", a, b") << ", count.value.expr, b")"])
      } else if op == b"shr" { bytes_concat_all([b"(", a, b") >> ", count.value.expr]) }
      else { bytes_concat_all([b"(int64_t)((uint64_t)(", a, b") >> ", count.value.expr, b")"]) })
    },
  }
}

/// Arithmetic over a width is done wide and narrowed back under the overflow guard; the rest in the width itself.
/// At 64 bits there is no wider type: a sum or difference is guarded as it is formed, and the rest is the runtime's.
fn width_binary(emitter: Emitter, op: Bytes, l: CValue, r: CValue, t: Width) -> Option<WithValue> = {
  let a = as_num(l, t);
  let bb = as_num(r, t);
  if is_arithmetic(op) && !in_imm(t) { Some(wide_arithmetic(emitter, op, a, bb, t)) }
  else if is_arithmetic(op) {
    let wide = if op == b"add" {
      bind(emitter, KInt, bytes_concat_all([b"(int64_t)(", a, b") + (int64_t)(", bb, b")"]))
    } else if op == b"sub" {
      bind(emitter, KInt, bytes_concat_all([b"(int64_t)(", a, b") - (int64_t)(", bb, b")"]))
    } else {
      let w = bind(
        emitter,
        KInt,
        bytes_concat_all([
          b"rt_arith_p(ctx, ",
          ascii_of_int(arith_code(op)),
          b", (int64_t)(",
          a,
          b"), (int64_t)(",
          bb,
          b"))",
        ]),
      );
      { emitter: check(w.emitter), value: w.value }
    };
    narrow(wide, t, overflow_code(op))
  } else if is_bitop(op) {
    Some(bind(emitter, KNum(t), bytes_concat_all([b"(", a, b") ", bitop_c(op), b" (", bb, b")"])))
  } else if is_shift(op) { Some(shift(emitter, op, l, r, Some(t))) } else if op == b"eq" {
    Some(bind(emitter, KBool, bytes_concat_all([b"(", a, b") == (", bb, b")"])))
  } else if op == b"ne" {
    Some(bind(emitter, KBool, bytes_concat_all([b"!((", a, b") == (", bb, b"))"])))
  } else {
    match compare_op(op) {
      Some(c) -> Some(bind(emitter, KBool, bytes_concat_all([b"(", a, b") ", c, b" (", bb, b")"]))),
      None -> None,
    }
  }
}

/// `a op b` over a 64-bit width.
fn wide_arithmetic(emitter: Emitter, op: Bytes, a: Bytes, b: Bytes, t: Width) -> WithValue =
  if op == b"add" || op == b"sub" {
    let r = fresh(emitter);
    let declared = line(r.emitter, bytes_concat_all([ctype(KNum(t)), b" ", r.name, b";"]));
    let over = if t.signed {
      bytes_concat_all([
        if op == b"add" { b"ply_add_ov(" } else { b"ply_sub_ov(" },
        a,
        b", ",
        b,
        b", &",
        r.name,
        b")",
      ])
    } else {
      bytes_concat_all([
        b"(",
        r.name,
        b" = (uint64_t)(",
        a,
        if op == b"add" { b") + (uint64_t)(" } else { b") - (uint64_t)(" },
        b,
        b"), ",
        if op == b"add" { bytes_concat_all([r.name, b" < (uint64_t)(", a, b"))"]) }
        else { bytes_concat_all([b"(uint64_t)(", a, b") < (uint64_t)(", b, b"))"]) },
      ])
    };
    let g = line(
      declared,
      bytes_concat_all([
        b"if (",
        over,
        b") { rt_overflow_p(ctx, ",
        ascii_of_int(overflow_code(op)),
        b"); ",
        leaving(emitter),
        b" }",
      ]),
    );
    { emitter: g, value: { kind: KNum(t), expr: r.name, ty: TyOpen([]) } }
  } else {
    let w = bind(
      emitter,
      KNum(t),
      bytes_concat_all([
        b"(",
        ctype(KNum(t)),
        b")rt_wide_binary_p(ctx, ",
        ascii_of_int(binary_code(op)),
        b", ",
        ascii_of_int(width_index(t)),
        b", (Word)(",
        a,
        b"), (Word)(",
        b,
        b"))",
      ]),
    );
    { emitter: check(w.emitter), value: w.value }
  }

/// The operand type decides the whole operator, wherever the operands came from.
fn binary_rest(emitter: Emitter, op: Bytes, l: CValue, r: CValue, t: Operand) -> Option<WithValue> =
  match t {
    OInt -> Some(int_binary(emitter, op, l, r)),
    OWidth(w) -> if carried(w) { width_binary(emitter, op, l, r, w) }
    else { word_binary(emitter, op, l, r) },
    OBool -> if op == b"eq" || op == b"ne" {
      Some(
        bind(
          emitter,
          KBool,
          bytes_concat_all([
            if op == b"ne" { b"!((" } else { b"((" },
            as_bool(l),
            b") == (",
            as_bool(r),
            b"))",
          ]),
        ),
      )
    } else { Some(unsettled_operator(emitter, op)) },
    OFloat -> float_binary(emitter, op, l, r),
    ODec -> dec_binary(emitter, op, l, r),
    // A `Char`'s word is its code point above a tag, so its words compare as its code points do.
    OChar -> match compare_op(op) {
      Some(c) ->
        Some(
          bind(
            emitter,
            KBool,
            bytes_concat_all([b"(", as_word(l), b") ", c, b" (", as_word(r), b")"]),
          ),
        ),
      None -> Some(unsettled_operator(emitter, op)),
    },
    OWord -> word_binary(emitter, op, l, r),
  }

/// C's own `double` operators, which round as IEEE-754 does and compare as the evaluator does:
/// `NaN` is unordered and unequal to itself.
fn float_binary(emitter: Emitter, op: Bytes, l: CValue, r: CValue) -> Option<WithValue> = {
  let a = as_float(l);
  let b = as_float(r);
  let infix = |kind: Kind, c: Bytes|
    Some(bind(emitter, kind, bytes_concat_all([b"(", a, b") ", c, b" (", b, b")"])));
  match compare_op(op) {
    Some(c) -> infix(KBool, c),
    None -> if op == b"add" { infix(KFloat, b"+") }
    else if op == b"sub" { infix(KFloat, b"-") }
    else if op == b"mul" { infix(KFloat, b"*") }
    else if op == b"div" { infix(KFloat, b"/") } else if op == b"rem" {
      Some(
        bind(
          emitter,
          KFloat,
          bytes_concat_all([
            b"ply_f64(rt_float_rem_p(ctx, ply_f64_bits(",
            a,
            b"), ply_f64_bits(",
            b,
            b")))",
          ]),
        ),
      )
    } else { Some(unsettled_operator(emitter, op)) },
  }
}

/// The runtime's own `Decimal` operators over the two words of each operand, which allocate
/// nothing: arithmetic writes its answer into a local, and a comparison orders the two as numbers,
/// equal at any scale that holds the same one.
fn dec_binary(emitter: Emitter, op: Bytes, l: CValue, r: CValue) -> Option<WithValue> = {
  let a = held_raw(emitter, l, KDec);
  let b = held_raw(a.emitter, r, KDec);
  let x = a.value.expr;
  let y = b.value.expr;
  let words = bytes_concat_all([x, b".lo, ", x, b".hi, ", y, b".lo, ", y, b".hi"]);
  match compare_op(op) {
    Some(c) ->
      Some(
        bind(
          b.emitter,
          KBool,
          bytes_concat_all([b"(rt_decimal_compare_p(ctx, ", words, b") ", c, b" 0)"]),
        ),
      ),
    None -> if op == b"add" || op == b"sub" || op == b"mul" || op == b"div" || op == b"rem" {
      let out = fresh(b.emitter);
      let e = line(
        out.emitter,
        bytes_concat_all([
          b"PlyDec ",
          out.name,
          b"; rt_decimal_binary_p(ctx, ",
          ascii_of_int(binary_code(op)),
          b", ",
          words,
          b", (Word)(intptr_t)&",
          out.name,
          b");",
        ]),
      );
      Some({ emitter: check(e), value: { kind: KDec, expr: out.name, ty: TyOpen([]) } })
    } else { Some(unsettled_operator(b.emitter, op)) },
  }
}

fn int_binary(emitter: Emitter, op: Bytes, l: CValue, r: CValue) -> WithValue =
  if is_shift(op) { shift(emitter, op, l, r, None) } else if is_bitop(op) {
    bind(
      emitter,
      KInt,
      bytes_concat_all([b"(", as_int(l), b") ", bitop_c(op), b" (", as_int(r), b")"]),
    )
  } else {
    let a = { kind: KInt, expr: as_int(l), ty: TyOpen([]) };
    let bb = { kind: KInt, expr: as_int(r), ty: TyOpen([]) };
    match compare_op(op) {
      Some(c) ->
        bind(emitter, KBool, if op == b"ne" {
          bytes_concat_all([b"!((", a.expr, b") == (", bb.expr, b"))"])
        } else { bytes_concat_all([b"(", a.expr, b") ", c, b" (", bb.expr, b")"]) }),
      None -> arithmetic(emitter, op, a, bb),
    }
  }

/// Equality is structural, and every other operator is the runtime's own over the words, which a
/// width past 32 bits, a `Float` and a `Decimal` are.
fn word_binary(emitter: Emitter, op: Bytes, l: CValue, r: CValue) -> Option<WithValue> =
  if op == b"eq" || op == b"ne" {
    // Under release both are handed over as held, and a temporary among them is released at its scope's end.
    let lo = if emitter.release {
      let w = word_of(emitter, l);
      { emitter: w.emitter, value: { kind: KBoxed, expr: w.expr, ty: l.ty } }
    } else { owned(emitter, l) };
    let ro = if lo.emitter.release {
      let w = word_of(lo.emitter, r);
      { emitter: w.emitter, value: { kind: KBoxed, expr: w.expr, ty: r.ty } }
    } else { owned(lo.emitter, r) };
    let e = bind(
      ro.emitter,
      KBool,
      bytes_concat_all([b"rt_equal_p(ctx, ", lo.value.expr, b", ", ro.value.expr, b")"]),
    );
    // For `!=` the answer's binding is the negation.
    Some(
      bind(check(e.emitter), KBool, if op == b"ne" { bytes_concat_all([b"!(", e.value.expr, b")"]) }
      else { e.value.expr }),
    )
  } else {
    let lo = owned(emitter, l);
    let ro = owned(lo.emitter, r);
    let o = bind(
      ro.emitter,
      KBoxed,
      bytes_concat_all([
        b"rt_binary_p(ctx, ",
        ascii_of_int(binary_code(op)),
        b", ",
        lo.value.expr,
        b", ",
        ro.value.expr,
        b")",
      ]),
    );
    Some({ emitter: check(o.emitter), value: o.value })
  }

/// The six orderings compile to C's own on untagged integers: an `Int` comparison cannot raise.
fn compare_op(op: Bytes) -> Option<Bytes> =
  if op == b"lt" { Some(b"<") }
  else if op == b"le" { Some(b"<=") }
  else if op == b"gt" { Some(b">") }
  else if op == b"ge" { Some(b">=") }
  else if op == b"eq" { Some(b"==") }
  else if op == b"ne" { Some(b"!=") }
  else { None }

/// Addition and subtraction are overflow-checked in the C; the rest go through `rt_arith`, which raises on a zero divisor.
fn arithmetic(emitter: Emitter, op: Bytes, l: CValue, r: CValue) -> WithValue =
  if is_add_or_sub(op) {
    let f = fresh(emitter);
    let e1 = line(f.emitter, bytes_concat_all([b"int64_t ", f.name, b";"]));
    let e2 = line(
      e1,
      bytes_concat_all([
        b"if (ply_",
        op,
        b"_ov(",
        l.expr,
        b", ",
        r.expr,
        b", &",
        f.name,
        b")) { rt_overflow_p(ctx, ",
        ascii_of_int(overflow_code(op)),
        b"); ",
        leaving(emitter),
        b" }",
      ]),
    );
    { emitter: e2, value: { kind: KInt, expr: f.name, ty: TyOpen([]) } }
  } else {
    let o = bind(
      emitter,
      KInt,
      bytes_concat_all([
        b"rt_arith_p(ctx, ",
        ascii_of_int(arith_code(op)),
        b", ",
        l.expr,
        b", ",
        r.expr,
        b")",
      ]),
    );
    { emitter: check(o.emitter), value: o.value }
  }

/// The prologue and the body; a body with a self call in tail position gets the label that call restarts at,
/// where each pass counts one call of the entry's budget, since a restart is what a tail call became.
fn emit_body(
  start: Emitter,
  params: List<EmitParam>,
  body: Code,
) -> Option<WithValue> / {abort.raise} = {
  let opened = prologue(start, params);
  let looped = line(opened, bytes_concat(b"ply_loop: ", tick_line(failing_return(opened.answer))));
  expr(
    if loops_to_self(opened, body, params) { looped } else { opened },
    widths_closed(start, body),
    params,
  )
}

/// A call, through the reference at `at`, of the root being emitted that fills every parameter:
/// from tail position it restarts the body. A specialisation's call of its definition at other
/// type arguments is a call of the definition as it stands.
fn self_tail_leaf(
  emitter: Emitter,
  name: Bytes,
  at: Span,
  args: List<Code>,
  params: List<EmitParam>,
) -> Bool / {abort.raise} = {
  let full = qualify(emitter.module, name);
  len(args) == len(params)
    && fold(emitter.here, false, |acc: Bool, h: Def|
      acc || (h.name == name && h.arity == len(args)))
    && (full == emitter.owner
    || (bytes_starts_with(emitter.owner, bytes_concat(full, b"@"))
    && call_target(
      emitter,
      full,
      def_named(emitter.here, name),
      at,
      fn_args(emitter, args, params),
    ).root
    == emitter.owner))
}

/// Whether a body reaches a self call in tail position; the walk is the positions `tail` is kept into.
fn loops_to_self(emitter: Emitter, code: Code, params: List<EmitParam>) -> Bool / {abort.raise} =
  match code.node {
    NApp(a) -> match a.func.node {
      NVar(fv) ->
        fv.slot == None && !is_ctor_name(fv.name)
          && self_tail_leaf(emitter, fv.name, a.func.span, a.args, params),
      _ -> false,
    },
    NBinary(b) -> (b.op == b"and" || b.op == b"or") && loops_to_self(emitter, b.rhs, params),
    NIf(i) ->
      loops_to_self(emitter, i.then_branch, params)
        || loops_to_self(emitter, i.else_branch, params),
    NBlock(b) -> match b.tail { Some(t) -> loops_to_self(emitter, t, params), None -> false },
    NMatch(m) ->
      fold(m.arms, false, |acc: Bool, a: CodeArm| acc || loops_to_self(emitter, a.body, params)),
    _ -> false,
  }

/// The local the prologue opened parameter `i` into: the first entry for the slot, under any `let` that shadows it.
fn param_local(emitter: Emitter, i: Int) -> Option<CValue> =
  fold(emitter.unboxed, None, |acc: Option<CValue>, unboxed: Unboxed|
    match acc {
      Some(_) -> acc,
      None -> if unboxed.slot == i {
        Some({ kind: unboxed.kind, expr: unboxed.expr, ty: unboxed.ty })
      } else { None },
    })

/// The raw `p<i>` words of the parameters a prologue converted. Those words are dead for the loop --
/// the body reads the converted local -- but they are the call's, so a restart leaves them held.
fn converted_params(emitter: Emitter, params: List<EmitParam>) -> List<Bytes> =
  fold(range(0, len(params)), [], |acc: List<Bytes>, i: Int|
    match param_local(emitter, i) {
      Some(_) -> push(acc, bytes_concat(b"p", ascii_of_int(i))),
      None -> acc,
    })

/// Each argument in temporaries fitted to its parameter: the opened kind, an owned word the
/// parameter takes over, or a record's fields.
fn tail_args(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
  i: Int,
  acc: List<List<Bytes>>,
) -> Option<{ emitter: Emitter, names: List<List<Bytes>> }> / {abort.raise} =
  if i >= len(codes) { Some({ emitter: emitter, names: acc }) } else {
    match list_at(codes, i) {
      None -> None,
      Some(x) -> match expr(notail(emitter), x, params) {
        None -> None,
        Some(o) -> match match list_at(params, i) { Some(p) -> p.carrier, None -> Whole(KBoxed) } {
          Fields(fs) -> {
            let r = record_values(o.emitter, o.value, fs);
            let held = fold(
              range(0, len(fs)),
              { emitter: r.emitter, names: [] },
              |a: { emitter: Emitter, names: List<Bytes> }, k: Int| {
                let f = nth_field(fs, k);
                let b = bind(a.emitter, f.kind, as_kind(nth_value(r.vals, k), f.kind));
                { emitter: b.emitter, names: push(a.names, b.value.expr) }
              },
            );
            tail_args(held.emitter, codes, params, i + 1, push(acc, held.names))
          },
          Whole(KMaybe) -> {
            let t = maybe_owned(o.emitter, o.value);
            tail_args(t.emitter, codes, params, i + 1, push(acc, [t.value.expr]))
          },
          Whole(_) -> {
            let t = match param_local(o.emitter, i) {
              Some(p) -> bind(o.emitter, p.kind, as_kind(o.value, p.kind)),
              None -> owned(o.emitter, o.value),
            };
            tail_args(t.emitter, codes, params, i + 1, push(acc, [t.value.expr]))
          },
        },
      },
    }
  }

/// A self call in tail position: the parameters take the arguments, what this pass of the body holds is released, and the body restarts.
fn self_tail(
  emitter: Emitter,
  name: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
) -> Option<WithValue> / {abort.raise} =
  match tail_args(emitter, args, params, 0, []) {
    None -> None,
    Some(w) -> {
      let assigned = fold(
        range(0, len(params)),
        release_at_except(w.emitter, 0, converted_params(w.emitter, params)),
        |acc: Emitter, i: Int|
          match list_at(w.names, i) {
            None -> acc,
            Some(nm) -> match match list_at(params, i) {
                Some(p) -> p.carrier,
                None -> Whole(KBoxed),
              } {
              // The record's word, if the pass made one, was released with the pass; the next makes
              // its own of the new fields.
              Fields(fs) ->
                fold(
                  range(0, len(fs)),
                  match param_local(acc, i) {
                    Some(p) -> line(acc, bytes_concat_all([p.expr, b" = 0;"])),
                    None -> acc,
                  },
                  |a: Emitter, k: Int|
                    line(a, bytes_concat_all([field_param(i, k), b" = ", nth_bytes(nm, k), b";"])),
                ),
              Whole(_) ->
                line(
                  acc,
                  bytes_concat_all([
                    match param_local(acc, i) {
                      Some(p) -> p.expr,
                      None -> bytes_concat(b"p", ascii_of_int(i)),
                    },
                    b" = ",
                    nth_bytes(nm, 0),
                    b";",
                  ]),
                ),
            },
          },
      );
      let d = ret_of(emitter.here, name);
      Some({
        emitter: line(assigned, b"goto ply_loop;"),
        value: {
          kind: match d.kind { Some(k) -> k, None -> KBoxed },
          expr: zero_of(match d.kind { Some(k) -> k, None -> KBoxed }),
          ty: d.ty,
        },
      })
    },
  }

/// The case a call of `name` with `nargs` arguments jumps to when this body is a group member and so is the callee.
fn group_case(emitter: Emitter, name: Bytes, nargs: Int) -> Option<Int> =
  if len(emitter.group) == 0 { None } else {
    match position_of(emitter.group, qualify(emitter.module, name)) {
      None -> None,
      Some(i) -> if fold(emitter.here, false, |acc: Bool, h: Def|
          acc || (h.name == name && h.arity == nargs)) { Some(i) }
      else { None },
    }
  }

/// The widest arity in this body's group: the group function takes that many words.
fn group_width(emitter: Emitter) -> Int =
  fold(emitter.here, 0, |acc: Int, h: Def|
    if h.arity > acc && position_of(emitter.group, qualify(emitter.module, h.name)) != None {
      h.arity
    } else { acc })

/// A call of a group member in tail position: the arguments are duplicated into the group's parameters, what this pass
/// holds is released, and the callee's case restarts through its own prologue. A self call in a group goes this way too.
fn group_tail(
  emitter: Emitter,
  name: Bytes,
  args: List<Code>,
  params: List<EmitParam>,
  which: Int,
) -> Option<WithValue> / {abort.raise} =
  match args_one_pass(emitter, args, params, 0, []) {
    None -> None,
    Some(w) -> {
      let assigned = fold(
        range(0, len(w.names)),
        release_at(w.emitter, 0),
        |acc: Emitter, i: Int|
          match list_at(w.names, i) {
            None -> acc,
            Some(nm) -> line(acc, bytes_concat_all([b"p", ascii_of_int(i), b" = ", nm, b";"])),
          },
      );
      let zeroed = fold(
        range(len(w.names), group_width(emitter)),
        assigned,
        |acc: Emitter, i: Int| line(acc, bytes_concat_all([b"p", ascii_of_int(i), b" = 0;"])),
      );
      let d = ret_of(emitter.here, name);
      Some({
        emitter: line(
          line(zeroed, bytes_concat_all([b"which = ", ascii_of_int(which), b";"])),
          b"goto ply_loop;",
        ),
        value: {
          kind: match d.kind { Some(k) -> k, None -> KBoxed },
          expr: zero_of(match d.kind { Some(k) -> k, None -> KBoxed }),
          ty: d.ty,
        },
      })
    },
  }

/// Every parameter is opened at entry, in order, read or not: opening lazily writes the temporaries in a different order.
fn prologue(emitter: Emitter, params: List<EmitParam>) -> Emitter =
  fold(range(0, len(params)), emitter, |acc: Emitter, i: Int|
    match list_at(params, i) {
      None -> acc,
      Some(p) -> if p.carrier != Whole(KBoxed) && p.carrier != Whole(KMaybe) {
        match p.carrier {
          Fields(fs) -> {
            let r = held_record(
              acc,
              fs,
              map(range(0, len(fs)), |k: Int|
                { kind: nth_field(fs, k).kind, expr: field_param(i, k), ty: nth_field(fs, k).ty }),
            );
            remember(r.emitter, i, r.value)
          },
          Whole(k) ->
            remember(acc, i, { kind: k, expr: bytes_concat(b"p", ascii_of_int(i)), ty: p.ty }),
        }
      } else {
        let acc = note_bound(
          note_holder(acc, bytes_concat(b"p", ascii_of_int(i))),
          bytes_concat(b"p", ascii_of_int(i)),
        );
        match p.kind {
          // A record arrives as its word and is never opened, but its reads are still charged, or the release rule sees nothing read it.
          KBoxed -> charge(acc, i, bytes_concat(b"p", ascii_of_int(i))),
          KMaybe -> charge(acc, i, bytes_concat(b"p", ascii_of_int(i))),
          KBool -> {
            let o = bind(
              acc,
              KBool,
              bytes_concat_all([b"rt_unbox_bool_p(ctx, p", ascii_of_int(i), b")"]),
            );
            remember(o.emitter, i, o.value)
          },
          KNum(w) -> {
            let o = bind(
              acc,
              KNum(w),
              as_num(
                { kind: KBoxed, expr: bytes_concat(b"p", ascii_of_int(i)), ty: TyOpen([]) },
                w,
              ),
            );
            remember(o.emitter, i, o.value)
          },
          KFloat -> {
            let o = bind(
              acc,
              KFloat,
              as_float({ kind: KBoxed, expr: bytes_concat(b"p", ascii_of_int(i)), ty: TyOpen([]) }),
            );
            remember(o.emitter, i, o.value)
          },
          KDec -> {
            let o = bind(
              acc,
              KDec,
              as_dec({ kind: KBoxed, expr: bytes_concat(b"p", ascii_of_int(i)), ty: TyOpen([]) }),
            );
            remember(o.emitter, i, o.value)
          },
          _ -> {
            let o = bind(
              acc,
              KInt,
              bytes_concat_all([
                b"(ply_is_imm(p",
                ascii_of_int(i),
                b") ? ply_imm_value(p",
                ascii_of_int(i),
                b") : rt_unbox_int_p(ctx, p",
                ascii_of_int(i),
                b"))",
              ]),
            );
            remember(o.emitter, i, o.value)
          },
        }
      },
    })

/// How a value of `ty` is held: an `Int` or a `Bool` untagged, a width below 64 bits in its own C
/// type, a `Float` in a `double`, anything else a word, with what a field read or an inline builtin
/// can take of its type.
pub fn kind_of(ty: Type) -> { kind: Kind, ty: Ty } =
  match ty {
    TyCon(c) -> if len(c.args) == 0 && c.name == b"Int" { { kind: KInt, ty: TyOpen([]) } }
    else if len(c.args) == 0 && c.name == b"Bool" { { kind: KBool, ty: TyOpen([]) } }
    else if len(c.args) == 0 && c.name == b"Float" { { kind: KFloat, ty: TyOpen([]) } }
    else if len(c.args) == 0 && c.name == b"Decimal" { { kind: KDec, ty: TyOpen([]) } }
    else if len(c.args) == 0 && c.name == b"Bytes" { { kind: KBoxed, ty: TyBytes } }
    else if len(c.args) == 1 && c.name == b"List" { { kind: KBoxed, ty: TyList } }
    else if len(c.args) == 1 && c.name == b"Array" {
      {
        kind: KBoxed,
        ty: TyArr(match list_at(c.args, 0) { Some(e) -> laid_field(b"e", e), None -> None }),
      }
    }
    // A width below 64 bits is carried in a register; the wider ones are the runtime's own words.
    else if len(c.args) == 0 {
      match width_named(c.name) {
        Some(w) -> if carried(w) { { kind: KNum(w), ty: TyOpen([]) } } else { boxed() },
        None -> boxed(),
      }
    } else { boxed() },
    // Field order is the checker's, sorted by name. A field of a variable's type may hold any kind's
    // word or bits, and a record it holds in place any width, so such a record is read by name, as
    // the runtime reads it.
    TyRecord(fs) -> if open_fields(fs) { { kind: KBoxed, ty: TyOpen(laid_vars(ty)) } }
    else { { kind: KBoxed, ty: TyRec(map(fs, field_ty)) } },
    // At run time a `new` record is the record it is written as.
    TyNominal(x) -> if open_fields(x.fields) { { kind: KBoxed, ty: TyOpen(laid_vars(ty)) } }
    else { { kind: KBoxed, ty: TyRec(map(x.fields, field_ty)) } },
    TyVar(v) -> { kind: KBoxed, ty: TyOpen(if v >= 0 { [v] } else { [] }) },
    _ -> boxed(),
  }

fn boxed() -> { kind: Kind, ty: Ty } = { kind: KBoxed, ty: TyOpen([]) }

/// Each constructor whose declaration lays out an argument other than as its word: its arguments,
/// `a000` first, each held as a record's field of its declared type is. An argument of a variable's
/// type, or of a record holding one, is its word, so a constructor's layout is its own.
pub fn ctor_layouts(ctors: List<CtorRow>) -> Map<Bytes, List<FieldTy>> =
  fold(ctors, map_new(), |acc: Map<Bytes, List<FieldTy>>, c: CtorRow| {
    let args = map(range(0, len(c.fields)), |i: Int| {
      let name = bytes_concat_all([
        b"a",
        ascii_of_int(i / 100),
        ascii_of_int(i / 10 % 10),
        ascii_of_int(i % 10),
      ]);
      match match list_at(c.fields, i) { Some(t) -> laid_field(name, t), None -> None } {
        Some(f) -> f,
        None -> { name: name, kind: KBoxed, ty: TyOpen([]) },
      }
    });
    if fold(args, false, |laid: Bool, f: FieldTy| laid || raw_slot(f.kind) || in_place(f) != None) {
      map_insert(acc, c.name, args)
    } else { acc }
  })

/// How a record's field `name` of type `t` is held, wherever the record is made; `None` where that
/// depends on what the field turns out to hold: a variable's type, or a record holding one.
fn laid_field(name: Bytes, t: Type) -> Option<FieldTy> =
  match t {
    TyVar(_) -> None,
    TyRecord(fs) -> if open_fields(fs) { None } else { Some(field_ty({ name: name, ty: t })) },
    TyNominal(x) -> if open_fields(x.fields) { None }
    else { Some(field_ty({ name: name, ty: t })) },
    _ -> Some(field_ty({ name: name, ty: t })),
  }

fn open_fields(fs: List<Field>) -> Bool =
  fold(fs, false, |open: Bool, f: Field|
    open
      || (match f.ty {
        TyVar(_) -> true,
        TyRecord(inner) -> open_fields(inner),
        TyNominal(x) -> open_fields(x.fields),
        _ -> false,
      }))

fn field_ty(f: Field) -> FieldTy = {
  let k = kind_of(f.ty);
  { name: f.name, kind: k.kind, ty: k.ty }
}

/// What a definition's scheme says it takes and answers.
type Sig = { params: List<Type>, ret: Type }

fn sig_of(schemes: Map<Bytes, Scheme>, full: Bytes) -> Option<Sig> =
  match map_get(schemes, full) {
    Some(s) -> match s.ty { TyFn(f) -> Some({ params: f.params, ret: f.ret }), _ -> None },
    None -> None,
  }

/// How each parameter of `def` arrives: the witnesses the expansion put before what the definition
/// writes are `Int`s, and the rest are as its scheme says. A parameter no scheme speaks for is a word,
/// which every parameter arrives as.
fn param_kinds(def: FnDef, sig: Option<Sig>) -> List<{ kind: Kind, ty: Ty }> = {
  let given = match sig { Some(s) -> s.params, None -> [] };
  let witnesses = len(def.params) - len(given);
  map(range(0, len(def.params)), |i: Int|
    if i < witnesses { { kind: KInt, ty: TyOpen([]) } }
    else { match list_at(given, i - witnesses) { Some(t) -> kind_of(t), None -> boxed() } })
}

/// The type the checker filed at `span`, as a value of it is held; a word where it filed none.
fn typed_kind(typed: Map<Bytes, Typed>, span: Span) -> { kind: Kind, ty: Ty } =
  match map_get(typed, span_key(span)) { Some(t) -> kind_of(t.ty), None -> boxed() }

// --- Specialisation ----------------------------------------------------------------------------
// A generic definition reached with a type argument laid out apart from a word is emitted again for
// the layouts its arguments have, under a root that spells them: the body holds its values as their
// own, reads a record's fields where its layout puts them and does its arithmetic with no witness.

/// The root `full` is emitted under for type arguments laid out as `args` are.
pub fn specialised(full: Bytes, args: List<Type>) -> Bytes =
  bytes_concat_all([full, b"@", bytes_join(map(args, spelled_type), b",")])

/// `specialised`, and then each lambda the root runs where it calls parameter `param`, as
/// `|param=owner:at`.
pub fn specialised_with(full: Bytes, args: List<Type>, fns: List<FnArg>) -> Bytes =
  bytes_concat_all(
    concat(
      [specialised(full, args)],
      map(fns, |f: FnArg|
        bytes_concat_all([
          b"|",
          ascii_of_int(f.param),
          b"=",
          f.owner,
          b":",
          ascii_of_int(f.at),
          b":",
          ascii_of_int(f.nth),
        ])),
    ),
  )

/// The definition and layouts of the root `specialised` named; `None` for any other root.
pub fn specialisation_of(
  root: Bytes,
) -> Option<{ base: Bytes, args: List<Type>, fns: List<FnArg> }> / {abort.raise} =
  if bytes_index_of(root, b"#") != None { None } else {
    match bytes_index_of(root, b"@") {
      None -> None,
      Some(at) -> {
        let parts = bytes_split(bytes_slice(root, at + 1, bytes_len(root)), b"|");
        let layouts = match list_at(parts, 0) { Some(x) -> x, None -> b"" };
        let fns = fold(range(1, len(parts)), Some([]), |acc: Option<List<FnArg>>, k: Int|
          match acc {
            None -> None,
            Some(fs) -> match fn_arg_of(match list_at(parts, k) { Some(x) -> x, None -> b"" }) {
              Some(f) -> Some(push(fs, f)),
              None -> None,
            },
          });
        match fns {
          None -> None,
          Some(fs) -> match if bytes_len(layouts) == 0 { Some([]) }
            else { read_types(layouts, 0, [], bytes_len(layouts)) } {
            Some(args) -> Some({ base: bytes_slice(root, 0, at), args: args, fns: fs }),
            None -> None,
          },
        }
      },
    }
  }

/// A lambda `specialised_with` spelled as `param=owner:at:nth`.
fn fn_arg_of(spelled: Bytes) -> Option<FnArg> / {abort.raise} =
  match bytes_index_of(spelled, b"=") {
    None -> None,
    Some(eq) -> {
      let rest = bytes_slice(spelled, eq + 1, bytes_len(spelled));
      let parts = bytes_split(rest, b":");
      if eq == 0 || len(parts) != 3 { None } else {
        Some({
          param: digits(bytes_slice(spelled, 0, eq)),
          owner: at(parts, 0),
          at: digits(at(parts, 1)),
          nth: digits(at(parts, 2)),
        })
      }
    },
  }

/// The definition a root runs: its own, or the one it specialises.
pub fn own_definition(root: Bytes) -> Bytes / {abort.raise} =
  match specialisation_of(root) { Some(s) -> s.base, None -> root }

/// What a value's layout reads of its type, every other part a known word, `_`: a scalar, a byte
/// string, a list, an array or columns by its element, a record by its fields, and a variable as
/// itself, for what the type it stands for reads.
pub fn erased(ty: Type) -> Type =
  match ty {
    TyVar(_) -> ty,
    TyCon(c) -> if len(c.args) == 0 && laid_scalar(c.name) { ty }
    else if len(c.args) == 1 && c.name == b"List" { TyCon({ name: b"List", args: [word_type()] }) }
    else if len(c.args) == 1 && (c.name == b"Array" || c.name == b"Columns") {
      TyCon({ name: c.name, args: map(c.args, erased) })
    } else { word_type() },
    TyRecord(fs) -> TyRecord(map(fs, erased_field)),
    TyNominal(x) -> TyRecord(map(x.fields, erased_field)),
    _ -> word_type(),
  }

/// A position a specialisation leaves as its definition has it: a variable no call settles.
pub fn unknown_type() -> Type = TyVar(0 - 1)

fn erased_field(f: Field) -> Field = { name: f.name, ty: erased(f.ty) }

/// A type whose values are words and say nothing more of their layout.
fn word_type() -> Type = TyCon({ name: b"_", args: [] })

fn laid_scalar(name: Bytes) -> Bool =
  name == b"Int" || name == b"Bool" || name == b"Float" || name == b"Decimal" || name == b"Bytes"
    || width_named(name) != None

/// `ty` as `specialised` spells it: `_`, a type's name and arguments, a record's fields, a variable
/// of the spelling body as `'0`, and a position left unknown as `?`.
fn spelled_type(ty: Type) -> Bytes =
  match ty {
    TyVar(v) -> if v < 0 { b"?" } else { bytes_concat(b"'", ascii_of_int(v)) },
    TyCon(c) -> if len(c.args) == 0 { c.name }
    else { bytes_concat_all([c.name, b"<", bytes_join(map(c.args, spelled_type), b","), b">"]) },
    TyRecord(fs) ->
      bytes_concat_all([
        b"{",
        bytes_join(map(fs, |f: Field| bytes_concat_all([f.name, b":", spelled_type(f.ty)])), b","),
        b"}",
      ]),
    _ -> b"_",
  }

/// The one type `s` spells, as `spelled_type` spells it.
pub fn type_spelled(s: Bytes) -> Option<Type> / {abort.raise} =
  match read_type(s, 0, 2 * bytes_len(s) + 2) {
    Some(r) -> if r.at == bytes_len(s) { Some(r.ty) } else { None },
    None -> None,
  }

/// Whether `ty` names a type variable anywhere in it.
pub fn has_vars(ty: Type) -> Bool =
  match ty {
    TyVar(_) -> true,
    TyCon(c) -> fold(c.args, false, |any: Bool, a: Type| any || has_vars(a)),
    TyFn(f) -> fold(push(f.params, f.ret), false, |any: Bool, a: Type| any || has_vars(a)),
    TyRecord(fs) -> fold(fs, false, |any: Bool, f: Field| any || has_vars(f.ty)),
    TyNominal(x) -> fold(x.fields, false, |any: Bool, f: Field| any || has_vars(f.ty)),
  }

/// Whether a specialisation holds a value of `ty` apart from a word, or does its operators in C.
pub fn held_apart(ty: Type) -> Bool =
  match ty {
    TyCon(c) -> len(c.args) == 0 && (kind_of(ty).kind != KBoxed || c.name == b"Char"),
    _ -> false,
  }

/// The types spelled from `at` to the end of `s`, each after a comma; `room` is how many more a
/// spelling of `s`'s length can hold.
fn read_types(s: Bytes, at: Int, acc: List<Type>, room: Int) -> Option<List<Type>> / {abort.raise} =
  if room <= 0 { None } else {
    match read_type(s, at, 2 * bytes_len(s) + 2) {
      None -> None,
      Some(r) -> if r.at == bytes_len(s) { Some(push(acc, r.ty)) }
      else if bytes_at(s, r.at) == 44 { read_types(s, r.at + 1, push(acc, r.ty), room - 1) }
      else { None },
    }
  }

/// The type spelled at `at`, and where its spelling ends; `room` is how many more reads a spelling
/// of `s`'s length can nest.
fn read_type(s: Bytes, at: Int, room: Int) -> Option<{ ty: Type, at: Int }> / {abort.raise} =
  if room <= 0 || at >= bytes_len(s) { None }
  else if bytes_at(s, at) == 63 { Some({ ty: unknown_type(), at: at + 1 }) }
  else if bytes_at(s, at) == 39 {
    let end = digits_end(s, at + 1);
    if end == at + 1 { None }
    else { Some({ ty: TyVar(digits(bytes_slice(s, at + 1, end))), at: end }) }
  } else if bytes_at(s, at) == 123 {
    match read_fields(s, at + 1, [], room - 1) {
      Some(r) -> Some({ ty: TyRecord(r.fields), at: r.at }),
      None -> None,
    }
  } else {
    let end = name_end(s, at);
    if end == at { None } else {
      let name = bytes_slice(s, at, end);
      if end < bytes_len(s) && bytes_at(s, end) == 60 {
        match read_args(s, end + 1, [], room - 1) {
          Some(r) -> Some({ ty: TyCon({ name: name, args: r.args }), at: r.at }),
          None -> None,
        }
      } else { Some({ ty: TyCon({ name: name, args: [] }), at: end }) }
    }
  }

/// The arguments spelled from `at` to the `>` that closes them, and where it ends.
fn read_args(
  s: Bytes,
  at: Int,
  acc: List<Type>,
  room: Int,
) -> Option<{ args: List<Type>, at: Int }> / {abort.raise} =
  if room <= 0 { None } else {
    match read_type(s, at, room - 1) {
      None -> None,
      Some(r) -> if r.at >= bytes_len(s) { None }
      else if bytes_at(s, r.at) == 44 { read_args(s, r.at + 1, push(acc, r.ty), room - 1) }
      else if bytes_at(s, r.at) == 62 { Some({ args: push(acc, r.ty), at: r.at + 1 }) }
      else { None },
    }
  }

/// The fields spelled from `at` to the `}` that closes them, and where it ends.
fn read_fields(
  s: Bytes,
  at: Int,
  acc: List<Field>,
  room: Int,
) -> Option<{ fields: List<Field>, at: Int }> / {abort.raise} =
  if room <= 0 { None } else if at < bytes_len(s) && bytes_at(s, at) == 125 && len(acc) == 0 {
    Some({ fields: acc, at: at + 1 })
  } else {
    let end = name_end(s, at);
    if end == at || end >= bytes_len(s) || bytes_at(s, end) != 58 { None } else {
      match read_type(s, end + 1, room - 1) {
        None -> None,
        Some(r) -> {
          let fields = push(acc, { name: bytes_slice(s, at, end), ty: r.ty });
          if r.at >= bytes_len(s) { None }
          else if bytes_at(s, r.at) == 44 { read_fields(s, r.at + 1, fields, room - 1) }
          else if bytes_at(s, r.at) == 125 { Some({ fields: fields, at: r.at + 1 }) }
          else { None }
        },
      }
    }
  }

/// Where the decimal digits that start at `at` end.
fn digits_end(s: Bytes, at: Int) -> Int / {abort.raise} =
  if at < bytes_len(s) && bytes_at(s, at) >= 48 && bytes_at(s, at) <= 57 { digits_end(s, at + 1) }
  else { at }

/// Where the name that starts at `at` ends.
fn name_end(s: Bytes, at: Int) -> Int / {abort.raise} =
  if at < bytes_len(s) && c_ident_byte(bytes_at(s, at)) { name_end(s, at + 1) } else { at }

/// `ty`, in a definition's numbering, with each variable a specialisation settles read as the layout
/// it is at; one it leaves unknown stays a variable.
fn substituted(ty: Type, args: List<Type>) -> Type =
  match ty {
    TyVar(v) -> match list_at(args, v) {
      Some(t) -> if t == unknown_type() { ty } else { t },
      None -> ty,
    },
    TyCon(c) -> TyCon({ ..c, args: map(c.args, |a: Type| substituted(a, args)) }),
    TyFn(f) ->
      TyFn({
        ..f,
        params: map(f.params, |p: Type| substituted(p, args)),
        ret: substituted(f.ret, args),
      }),
    TyRecord(fs) -> TyRecord(map(fs, |f: Field| { ..f, ty: substituted(f.ty, args) })),
    TyNominal(x) ->
      TyNominal({
        ..x,
        args: map(x.args, |a: Type| substituted(a, args)),
        fields: map(x.fields, |f: Field| { ..f, ty: substituted(f.ty, args) }),
      }),
  }

/// The numeric type a value of `ty` is held as alone, apart from a word: its own arithmetic.
fn numeric_named(ty: Type) -> Option<Bytes> =
  match ty {
    TyCon(c) -> match kind_of(ty).kind { KBoxed -> None, KBool -> None, _ -> Some(c.name) },
    _ -> None,
  }

/// The number decimal digits `b` spell.
pub fn digits(b: Bytes) -> Int =
  fold(range(0, bytes_len(b)), 0, |acc: Int, i: Int| acc * 10 + bytes_at(b, i) - 48)

fn def_named(defs: List<Def>, name: Bytes) -> Option<Def> =
  fold(defs, None, |acc: Option<Def>, d: Def| if d.name == name { Some(d) } else { acc })

/// What a call names: the root and its symbol, how the root takes each argument and answers, and
/// the answer's type at the call's own type arguments.
type Target = {
  emitter: Emitter,
  full: Bytes,
  symbol: Bytes,
  root: Bytes,
  ret: { kind: Option<Kind>, ty: Ty },
  carriers: { params: List<Carrier>, answer: Carrier },
}

/// The target of a call of `full` through the reference at `at`, named as `named_ref` names it,
/// handed the lambdas `fns`.
fn call_target(
  emitter: Emitter,
  full: Bytes,
  d: Option<Def>,
  at: Span,
  fns: List<FnArg>,
) -> Target / {abort.raise} = {
  let declared = match d {
    Some(x) -> { kind: x.ret, ty: x.ret_ty },
    None -> { kind: None, ty: TyOpen([]) },
  };
  let scheme = match d { Some(x) -> x.scheme, None -> None };
  let named = named_ref(emitter, full, d, at, fns);
  let ret = match scheme {
    Some(sc) -> if len(sc.ty_vars) == 0 { declared } else {
      match map_get(emitter.typed, span_key(at)) {
        Some(t) -> if len(t.args) != len(sc.ty_vars) { declared } else {
          match sc.ty {
            TyFn(f) -> {
              let k = kind_of(substituted_fully(f.ret, t.args));
              { kind: Some(k.kind), ty: k.ty }
            },
            _ -> declared,
          }
        },
        None -> declared,
      }
    },
    None -> declared,
  };
  {
    emitter: named.emitter,
    full: full,
    symbol: named.symbol,
    root: named.root,
    ret: ret,
    carriers: match d {
      Some(x) -> carriers_at(x, named.args),
      None -> { params: [], answer: Whole(KBoxed) },
    },
  }
}

/// How a reference at `at` names definition `full`: its own symbol, or, for a generic definition the
/// checker gave type arguments there, a placeholder the unit settles once it knows what the callee
/// reads of each argument, which the body records. A definition's reference to itself at the type
/// arguments of the root being emitted, handing the lambdas it runs, names that root; a
/// specialisation's at other arguments or lambdas names the definition as it stands, whose body
/// restarts where a specialisation's cannot become another's.
fn named_ref(
  emitter: Emitter,
  full: Bytes,
  d: Option<Def>,
  at: Span,
  fns: List<FnArg>,
) -> { emitter: Emitter, symbol: Bytes, root: Bytes, args: List<Type> } / {abort.raise} =
  if own_definition(emitter.owner) == full {
    let own = match specialisation_of(emitter.owner) {
      None -> true,
      Some(sp) -> {
        let given = reference_args(emitter, match d { Some(x) -> x.scheme, None -> None }, at);
        same_fns(sp.fns, fns) && len(given) == len(sp.args)
          && fold(range(0, len(sp.args)), true, |same: Bool, j: Int|
            same
              && (match list_at(sp.args, j) {
                Some(mine) ->
                  mine == unknown_type()
                    || (match list_at(given, j) { Some(g) -> erased(g) == mine, None -> false }),
                None -> false,
              }))
      },
    };
    let named = if own { emitter.owner } else { full };
    {
      emitter: note_call(emitter, named),
      symbol: symbol_of(named),
      root: named,
      args: match specialisation_of(named) { Some(sp) -> sp.args, None -> [] },
    }
  } else {
    let plain = {
      emitter: note_call(emitter, full),
      symbol: symbol_of(full),
      root: full,
      args: [],
    };
    let scheme = match d { Some(x) -> x.scheme, None -> None };
    let given = reference_args(emitter, scheme, at);
    if len(given) == 0 && len(fns) == 0 { plain } else {
      let k = len(emitter.generics.calls);
      let placeholder = bytes_concat_all([b"@@g", ascii_of_int(k), b"@@"]);
      {
        emitter: {
          ..emitter,
          generics: {
            ..emitter.generics,
            calls: push(emitter.generics.calls, {
              callee: full,
              args: map(given, |a: Type| spelled_type(erased(a))),
              carried: match scheme {
                Some(sc) -> carried_vars(sc, given, match d { Some(x) -> x.arity, None -> 0 }),
                None -> [],
              },
              fns: fns,
            }),
          },
        },
        symbol: placeholder,
        root: placeholder,
        args: given,
      }
    }
  }

/// `ty` with each variable read as the type argument at its number.
fn substituted_fully(ty: Type, args: List<Type>) -> Type =
  match ty {
    TyVar(v) -> match list_at(args, v) { Some(t) -> t, None -> ty },
    TyCon(c) -> TyCon({ ..c, args: map(c.args, |a: Type| substituted_fully(a, args)) }),
    TyFn(f) ->
      TyFn({
        ..f,
        params: map(f.params, |p: Type| substituted_fully(p, args)),
        ret: substituted_fully(f.ret, args),
      }),
    TyRecord(fs) -> TyRecord(map(fs, |f: Field| { ..f, ty: substituted_fully(f.ty, args) })),
    TyNominal(x) ->
      TyNominal({
        ..x,
        args: map(x.args, |a: Type| substituted_fully(a, args)),
        fields: map(x.fields, |f: Field| { ..f, ty: substituted_fully(f.ty, args) }),
      }),
  }

/// Each typed site of `typed` read at `args`, for a specialisation whose sites are these.
fn typed_at(typed: Map<Bytes, Typed>, args: List<Type>) -> Map<Bytes, Typed> =
  map_fold(typed, map_new(), |acc: Map<Bytes, Typed>, k: Bytes, t: Typed|
    map_insert(acc, k, {
      ty: substituted(t.ty, args),
      args: map(t.args, |a: Type| substituted(a, args)),
    }))

/// The scheme's number of each type parameter `def` writes by name, read off where its parameters'
/// and answer's written types and its scheme's agree.
fn generics_numbered(def: FnDef, scheme: Scheme) -> Map<Bytes, Int> =
  match scheme.ty {
    TyFn(f) -> {
      let written = map(def.params, |p: Param| p.ty);
      let paired = fold(range(0, len(written)), map_new(), |acc: Map<Bytes, Int>, i: Int|
        match list_at(written, i) {
          Some(Some(w)) -> match list_at(f.params, i) {
            Some(t) -> numbered_by(w, t, acc),
            None -> acc,
          },
          _ -> acc,
        });
      match def.ret { Some(w) -> numbered_by(w, f.ret, paired), None -> paired }
    },
    _ -> map_new(),
  }

fn numbered_by(written: TypeExpr, ty: Type, acc: Map<Bytes, Int>) -> Map<Bytes, Int> =
  match written {
    TVar(id) -> match ty { TyVar(v) -> map_insert(acc, id.name, v), _ -> acc },
    TCon(c) -> match ty {
      TyCon(k) -> pairwise(c.args, k.args, acc),
      TyNominal(x) -> pairwise(c.args, x.args, acc),
      _ -> acc,
    },
    TFn(w) -> match ty {
      TyFn(f) -> numbered_by(w.ret, f.ret, pairwise(w.params, f.params, acc)),
      _ -> acc,
    },
    _ -> acc,
  }

fn pairwise(written: List<TypeExpr>, tys: List<Type>, acc: Map<Bytes, Int>) -> Map<Bytes, Int> =
  if len(written) != len(tys) { acc } else {
    fold(range(0, len(written)), acc, |m: Map<Bytes, Int>, i: Int|
      match list_at(written, i) {
        Some(w) -> match list_at(tys, i) { Some(t) -> numbered_by(w, t, m), None -> m },
        None -> m,
      })
  }

/// The root names `wanted` holds of `full`'s specialisations, each with the layouts it is at.
fn specialisations_wanted(
  wanted: Option<Map<Bytes, Bool>>,
  full: Bytes,
) -> List<{ args: List<Type>, fns: List<FnArg> }> / {abort.raise} =
  match wanted {
    None -> [],
    Some(w) ->
      map_fold(w, [], |acc: List<{ args: List<Type>, fns: List<FnArg> }>, root: Bytes, _: Bool|
        match specialisation_of(root) {
          Some(s) -> if s.base == full { push(acc, { args: s.args, fns: s.fns }) } else { acc },
          None -> acc,
        }),
  }

/// `e`, the body of generic `def`, noting the variables whose numeric witness it reads: a scalar
/// argument does that arithmetic in C.
fn witnessed_needs(
  e: Emitted,
  def: FnDef,
  scheme: Option<Scheme>,
  ops: List<WitnessOp>,
) -> Emitted =
  match scheme {
    None -> e,
    Some(sc) -> {
      let numbering = generics_numbered(def, sc);
      let needs = fold(ops, e.tables.generics.needs, |acc: List<Need>, o: WitnessOp|
        if o.owner != e.name { acc } else {
          match map_get(numbering, o.param) {
            Some(v) -> if contains(acc, { var: v, layout: false }) { acc }
            else { push(acc, { var: v, layout: false }) },
            None -> acc,
          }
        });
      { ..e, tables: { ..e.tables, generics: { ..e.tables.generics, needs: needs } } }
    },
  }

/// `def` emitted at `args`: its parameters and sites read at them, and each operator whose witness
/// is a parameter now held as one numeric type alone done as that type's own.
fn specialised_emitted(
  module: Bytes,
  def: FnDef,
  args: List<Type>,
  fns: List<FnArg>,
  lambda_at: (Bytes, Int, Int) -> Option<BoundLambda> / {abort.raise},
  schemes: Map<Bytes, Scheme>,
  ops: List<WitnessOp>,
  sites: Map<Bytes, List<Bytes>>,
  here: List<Def>,
  imports: List<Imported>,
  ctors: Ctors,
  builtins: List<Bytes>,
  effects: List<EffectName>,
  release: Bool,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
) -> Emitted / {abort.raise} = {
  let full = qualify(module, def.name.name);
  let scheme = map_get(schemes, full);
  let numbering = match scheme { Some(sc) -> generics_numbered(def, sc), None -> map_new() };
  // The type a witnessed parameter is at, where its argument is held as one numeric type alone.
  let numeric = |param: Bytes|
    match map_get(numbering, param) {
      Some(i) -> match list_at(args, i) { Some(t) -> numeric_named(t), None -> None },
      None -> None,
    };
  let concrete = map_fold(numbering, map_new(), |acc: Map<Bytes, Bool>, param: Bytes, _: Int|
    if numeric(param) == None { acc } else { map_insert(acc, witness_param(param), true) });
  let body = map_expr(def.body, |e: Expr| unwitnessed(e, |w: Bytes| map_contains(concrete, w)));
  // An operand the checker filed at a variable of the definition is read as the type it is at.
  let at_args = map_fold(operands, operands, |acc: Map<Bytes, Bytes>, k: Bytes, name: Bytes|
    if bytes_len(name) < 2 || bytes_at(name, 0) != 39 { acc } else {
      match list_at(args, digits(bytes_slice(name, 1, bytes_len(name)))) {
        Some(t) -> if held_apart(t) { match t { TyCon(c) -> map_insert(acc, k, c.name), _ -> acc } }
        else { acc },
        None -> acc,
      }
    });
  let settled = fold(ops, at_args, |acc: Map<Bytes, Bytes>, o: WitnessOp|
    if o.owner != full { acc } else {
      match numeric(o.param) { Some(n) -> map_insert(acc, span_key(o.span), n), None -> acc }
    });
  let sig = match sig_of(schemes, full) {
    Some(s) ->
      Some({
        params: map(s.params, |t: Type| substituted(t, args)),
        ret: substituted(s.ret, args),
      }),
    None -> None,
  };
  let names = map(def.params, |param: Param| param.name.name);
  let kinds = map(param_kinds(def, sig), |k: { kind: Kind, ty: Ty }| Some(k));
  let labels = map(def.generics.labels, |ident: Ident| ident.name);
  let all_names = fold(labels, names, |acc: List<Bytes>, n: Bytes| push(acc, n));
  let all_kinds = fold(labels, kinds, |acc: List<Option<{ kind: Kind, ty: Ty }>>, n: Bytes|
    push(acc, Some({ kind: KInt, ty: TyOpen([]) })));
  let root = specialised_with(full, args, fns);
  let carried = params_carried(all_names, all_kinds, match def_named(here, def.name.name) {
    Some(d) -> carriers_at(d, args).params,
    None -> carriers_of(def, sig_of(schemes, full)).params,
  });
  // Each lambda the root runs, read where its owner lowered it.
  let lent = fold(fns, Some(carried), |acc: Option<List<EmitParam>>, f: FnArg|
    match acc {
      None -> None,
      Some(ps) -> match lambda_at(f.owner, f.at, f.nth) {
        None -> None,
        Some(bl) ->
          Some(
            map(range(0, len(ps)), |i: Int|
              if i == f.param { { ..at(ps, i), lambda: Some(bl) } } else { at(ps, i) }),
          ),
      },
    });
  match lent {
    None ->
      {
        name: root,
        text: b"",
        tables: no_tables(),
        why: Some(b"a lambda this root runs in place of a call is not one its owner lowers"),
        handles: [],
      },
    Some(ps) ->
      emitted_from(
        module,
        def.span.start,
        here,
        imports,
        ctors,
        builtins,
        effects,
        release,
        settled,
        typed_at(typed, args),
        root,
        ps,
        true,
        body,
        match lower_to_emit(names, labels, sites, body) {
          Some(l) ->
            Some(
              inlined_calls(
                l.code,
                fold(
                  range(0, len(ps)),
                  [],
                  |acc: List<{ slot: Int, lent: BoundLambda }>, i: Int|
                    match at(ps, i).lambda {
                      // A lambda holding a `handle` stays a closure: its handled operations are its owner's.
                      Some(bl) -> if has_handle(bl.code.body) { acc }
                      else { push(acc, { slot: i, lent: bl }) },
                      None -> acc,
                    },
                ),
              ),
            ),
          None -> None,
        },
      ),
  }
}

pub fn emit_fn(
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  ctors: List<Bytes>,
  builtins: List<Bytes>,
  full: Bytes,
  params: List<EmitParam>,
  body: Code,
) -> Option<Bytes> / {abort.raise} =
  match emit_fn_full(
      module,
      0,
      here,
      imports,
      { names: ctors, laid: map_new() },
      builtins,
      full,
      params,
      body,
      [],
      false,
      map_new(),
      map_new(),
    ) {
    None -> None,
    Some(f) -> Some(f.text),
  }

/// One definition's C, with the tables it names. `full` is the definition's own name (`m.f`, or a
/// root's `m.f#requires#0`), from which its C symbol is derived.
pub fn emit_fn_full(
  module: Bytes,
  base: Int,
  here: List<Def>,
  imports: List<Imported>,
  ctors: Ctors,
  builtins: List<Bytes>,
  full: Bytes,
  params: List<EmitParam>,
  body: Code,
  effects: List<EffectName>,
  release: Bool,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
) -> Option<{ text: Bytes, tables: Tables }> / {abort.raise} = {
  let name = symbol_of(full);
  let answer = carried_answer(module, here, full);
  let start = {
    out: [],
    temp_count: 0,
    unboxed: [],
    indent: 0,
    reads: slots_read(body),
    shapes: [],
    built: [],
    module: module,
    base: base,
    count_locals: [],
    here: here,
    imports: imports,
    consts: [],
    ctors: ctors,
    lambda_bodies: b"",
    lambdas: [],
    owner: full,
    builtins: builtins,
    called_builtins: [],
    fields: [],
    released: [],
    reuse_widths: [],
    alias: [],
    by_root: [],
    tail: true,
    calls: [],
    generics: no_generics(),
    refused: None,
    deferred: [],
    deferred_locals: [],
    performs: [],
    handles: [],
    landing: None,
    effects: effects,
    release: release,
    pinned: [],
    bound: [],
    group: [],
    operands: operands,
    typed: typed,
    answer: returned_kind(answer),
    site_root: None,
    lent: lent_of(params),
    written: lambdas_of(body),
  };
  match emit_body(start, params, body) {
    None -> None,
    Some(o0) -> if o0.emitter.refused != None { None } else {
      let sig = bytes_concat_all([
        b"Word ",
        name,
        b"_entry(PlyCtx *ctx, const Word *args);\n",
        head_text(name, params, answer),
        b" {\n",
      ]);
      let grown = grown_words(o0.emitter, params, answer);
      let head = fuel_head(bytes_concat(name, b"_entry"), grown.prep, grown.words, answer);
      let w = answered(grown.emitter, o0.value, answer);
      let shaped = match answer {
        Fields(fs) -> shape_of_fields(w.emitter, fs),
        Whole(_) -> { emitter: w.emitter, i: 0 },
      };
      let o = { emitter: shaped.emitter, value: o0.value };
      let epilogue = bytes_concat_all([
        toks_freed(o.emitter.reuse_widths),
        b"  ctx->fuel += 1;\n  return ",
        w.expr,
        b";\n}\n",
      ]);
      let entry = entry_text(name, params, answer, shaped.i);
      // Token declarations go in front once the body has used them; they take no temporary, so nothing moves.
      let toks = fold(sorted_widths(o.emitter.reuse_widths), b"", |acc: Bytes, w: Int|
        bytes_concat_all([acc, b"  Word tok", ascii_of_int(w), b" = 0;\n"]));
      let decls = fold(o.emitter.deferred_locals, b"", |acc: Bytes, r: Bytes|
        bytes_concat_all([acc, b"  Word ", r, b" = 0;\n"]));
      Some({
        text: bytes_concat_all([
          sig,
          head,
          toks,
          decls,
          bytes_join(o.emitter.out, b""),
          epilogue,
          entry,
          o.emitter.lambda_bodies,
        ]),
        tables: tables_of(o.emitter, full, [head_of(params, answer)]),
      })
    },
  }
}

/// What a root hands back as `answer` carries it: the word, the value in its own C type, or a
/// record's first field, its others written through the pointers; whatever the body holds is
/// released first.
fn answered(emitter: Emitter, value: CValue, answer: Carrier) -> { emitter: Emitter, expr: Bytes } =
  match answer {
    Whole(KBoxed) -> returned(emitter, value),
    Whole(KMaybe) -> {
      let w = maybe_owned(emitter, value);
      { emitter: release_at(w.emitter, 0), expr: w.value.expr }
    },
    Whole(k) -> {
      let b = bind(emitter, k, as_kind(value, k));
      { emitter: release_at(b.emitter, 0), expr: b.value.expr }
    },
    Fields(fs) -> {
      let r = record_values(emitter, value, fs);
      let bound = fold(
        range(0, len(fs)),
        { emitter: r.emitter, names: [] },
        |acc: { emitter: Emitter, names: List<Bytes> }, k: Int| {
          let f = nth_field(fs, k);
          let b = bind(acc.emitter, f.kind, as_kind(nth_value(r.vals, k), f.kind));
          { emitter: b.emitter, names: push(acc.names, b.value.expr) }
        },
      );
      let written = fold(range(1, len(fs)), bound.emitter, |acc: Emitter, k: Int|
        line(
          acc,
          bytes_concat_all([b"*o", ascii_of_int(k), b" = ", nth_bytes(bound.names, k), b";"]),
        ));
      { emitter: release_at(written, 0), expr: nth_bytes(bound.names, 0) }
    },
  }

/// The C type a value carried as `k` crosses a call in.
fn carried_type(k: Kind) -> Bytes = match k { KBoxed -> b"Word", _ -> ctype(k) }

/// A root's C function head: its answer's and each carried value's C type, then the pointers a
/// record answer is written through.
fn head_text(name: Bytes, params: List<EmitParam>, answer: Carrier) -> Bytes = {
  let h = head_of(params, answer);
  let names = carried_names(params, answer);
  bytes_concat_all([
    h.answer,
    b" ",
    name,
    b"(PlyCtx *ctx",
    fold(range(0, len(h.params)), b"", |acc: Bytes, i: Int|
      bytes_concat_all([acc, b", ", nth_bytes(h.params, i), b" ", nth_bytes(names, i)])),
    b")",
  ])
}

/// What a growth of the stack re-enters a root with: each parameter as a word, its own or one made
/// of a carried value, which `prep` makes first.
fn grown_words(
  emitter: Emitter,
  params: List<EmitParam>,
  answer: Carrier,
) -> { emitter: Emitter, prep: Bytes, words: List<Bytes> } / {abort.raise} =
  fold(
    range(0, len(params)),
    { emitter: emitter, prep: b"", words: [] },
    |acc: { emitter: Emitter, prep: Bytes, words: List<Bytes> }, i: Int|
      match list_at(params, i) {
        None -> acc,
        Some(p) -> match p.carrier {
          Whole(KMaybe) ->
            {
              ..acc,
              words: push(
                acc.words,
                bytes_concat_all([b"rt_maybe_take_p(ctx, p", ascii_of_int(i), b")"]),
              ),
            },
          Whole(k) ->
            {
              ..acc,
              words: push(
                acc.words,
                as_word({ kind: k, expr: bytes_concat(b"p", ascii_of_int(i)), ty: TyOpen([]) }),
              ),
            },
          Fields(fs) -> {
            let sh = shape_of_fields(acc.emitter, fs);
            let name = bytes_concat(b"ply_g", ascii_of_int(i));
            {
              emitter: sh.emitter,
              prep: bytes_concat_all([
                acc.prep,
                record_word_lines(
                  name,
                  fs,
                  sh.i,
                  map(range(0, len(fs)), |k: Int|
                    {
                      kind: nth_field(fs, k).kind,
                      expr: field_param(i, k),
                      ty: nth_field(fs, k).ty,
                    }),
                  failing_return(returned_kind(answer)),
                ),
                b" ",
              ]),
              words: push(acc.words, name),
            }
          },
        },
      },
  )

/// The entry the runtime and closures call a root by, words in and out: each carried argument is
/// opened, a record's fields loaded, and its word released; a carried answer is boxed, a record's
/// made of `shape`.
fn entry_text(name: Bytes, params: List<EmitParam>, answer: Carrier, shape: Int) -> Bytes = {
  let opened = fold(
    range(0, len(params)),
    { text: b"", args: [] },
    |acc: { text: Bytes, args: List<Bytes> }, i: Int| {
      let arg = bytes_concat_all([b"args[", ascii_of_int(i), b"]"]);
      match list_at(params, i) {
        None -> acc,
        Some(p) -> match p.carrier {
          Whole(KBoxed) -> { ..acc, args: push(acc.args, arg) },
          // The argument's object is taken, its payload handed on.
          Whole(KMaybe) -> {
            let local = bytes_concat(b"a", ascii_of_int(i));
            {
              text: bytes_concat_all([
                acc.text,
                b"  PlyMaybe ",
                local,
                b" = rt_maybe_open_p(ctx, ",
                arg,
                b");\n",
              ]),
              args: push(acc.args, local),
            }
          },
          Whole(k) -> {
            let local = bytes_concat(b"a", ascii_of_int(i));
            {
              text: bytes_concat_all([
                acc.text,
                b"  ",
                ctype(k),
                b" ",
                local,
                b" = ",
                as_kind({ kind: KBoxed, expr: arg, ty: TyOpen([]) }, k),
                b"; ply_dec(ctx, ",
                arg,
                b");\n",
              ]),
              args: push(acc.args, local),
            }
          },
          Fields(fs) -> {
            let loads = field_loads(arg, fs);
            let locals = map(range(0, len(fs)), |k: Int|
              bytes_concat_all([b"a", ascii_of_int(i), b"_", ascii_of_int(k)]));
            {
              text: bytes_concat_all([
                acc.text,
                fold(range(0, len(fs)), b"", |t: Bytes, k: Int|
                  bytes_concat_all([
                    t,
                    b"  ",
                    ctype(nth_field(fs, k).kind),
                    b" ",
                    nth_bytes(locals, k),
                    b" = ",
                    nth_value(loads, k).expr,
                    b";\n",
                  ])),
                b"  ply_dec(ctx, ",
                arg,
                b");\n",
              ]),
              args: concat(acc.args, locals),
            }
          },
        },
      }
    },
  );
  let back = written_back(answer);
  let outs = map(range(1, len(back) + 1), |k: Int| bytes_concat(b"r", ascii_of_int(k)));
  let call = bytes_concat_all([
    name,
    b"(ctx",
    fold(opened.args, b"", |acc: Bytes, a: Bytes| bytes_concat_all([acc, b", ", a])),
    fold(outs, b"", |acc: Bytes, o: Bytes| bytes_concat_all([acc, b", &", o])),
    b")",
  ]);
  bytes_concat_all([
    b"Word ",
    name,
    b"_entry(PlyCtx *ctx, const Word *args) {\n",
    opened.text,
    match answer {
      Whole(KBoxed) -> bytes_concat_all([b"  return ", call, b";\n"]),
      Whole(k) ->
        bytes_concat_all([
          b"  ",
          ctype(k),
          b" r = ",
          call,
          b";\n  if (ctx->failed) return 0;\n  return ",
          if k == KMaybe { b"rt_maybe_take_p(ctx, r)" }
          else { as_word({ kind: k, expr: b"r", ty: TyOpen([]) }) },
          b";\n",
        ]),
      Fields(fs) ->
        bytes_concat_all([
          fold(range(0, len(back)), b"", |t: Bytes, k: Int|
            bytes_concat_all([
              t,
              b"  ",
              ctype(nth_field(back, k).kind),
              b" ",
              nth_bytes(outs, k),
              b";\n",
            ])),
          b"  ",
          ctype(returned_kind(answer)),
          b" r0 = ",
          call,
          b";\n  if (ctx->failed) return 0;\n  ",
          record_word_lines(
            b"rw",
            fs,
            shape,
            map(range(0, len(fs)), |k: Int|
              {
                kind: nth_field(fs, k).kind,
                expr: bytes_concat(b"r", ascii_of_int(k)),
                ty: nth_field(fs, k).ty,
              }),
            b"return 0;",
          ),
          b"\n  return rw;\n",
        ]),
    },
    b"}\n",
  ])
}

/// How the root `full` of `module` hands back its answer: as its definition's `Def` says, and a word
/// for any other root.
fn carried_answer(module: Bytes, here: List<Def>, full: Bytes) -> Carrier / {abort.raise} = {
  let own = own_definition(full);
  let args = match specialisation_of(full) { Some(sp) -> sp.args, None -> [] };
  fold(here, Whole(KBoxed), |acc: Carrier, d: Def|
    if qualify(module, d.name) == own { carriers_at(d, args).answer } else { acc })
}

/// Why a body was refused, or nothing when it was emitted.
pub fn emit_fn_why(
  module: Bytes,
  base: Int,
  here: List<Def>,
  imports: List<Imported>,
  ctors: Ctors,
  builtins: List<Bytes>,
  full: Bytes,
  params: List<EmitParam>,
  body: Code,
  effects: List<EffectName>,
  release: Bool,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
) -> Option<Bytes> / {abort.raise} = {
  let answer = carried_answer(module, here, full);
  let start = {
    out: [],
    temp_count: 0,
    unboxed: [],
    indent: 0,
    reads: slots_read(body),
    shapes: [],
    built: [],
    module: module,
    base: base,
    count_locals: [],
    here: here,
    imports: imports,
    consts: [],
    ctors: ctors,
    lambda_bodies: b"",
    lambdas: [],
    owner: full,
    builtins: builtins,
    called_builtins: [],
    fields: [],
    released: [],
    reuse_widths: [],
    alias: [],
    by_root: [],
    tail: true,
    calls: [],
    generics: no_generics(),
    refused: None,
    deferred: [],
    deferred_locals: [],
    performs: [],
    handles: [],
    landing: None,
    effects: effects,
    release: release,
    pinned: [],
    bound: [],
    group: [],
    operands: operands,
    typed: typed,
    answer: returned_kind(answer),
    site_root: None,
    lent: lent_of(params),
    written: lambdas_of(body),
  };
  match emit_body(start, params, body) {
    None -> Some(b"refused without a reason"),
    Some(o) -> o.emitter.refused,
  }
}

/// One definition of a group: its full name, where its source starts, and its lowered body.
pub type Member = { full: Bytes, base: Int, params: List<EmitParam>, body: Code }

/// A tail-recursive group as one C function: `which` picks the member's case, the loop label sits before the switch, and
/// each case opens its own parameters, so a jump to any member restarts through that member's prologue. Every member's
/// own symbol is a wrapper passing its case, and the group's tables list the members its one body serves.
pub fn emit_group_full(
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  ctors: Ctors,
  builtins: List<Bytes>,
  members: List<Member>,
  effects: List<EffectName>,
  release: Bool,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
) -> Option<{ text: Bytes, tables: Tables }> / {abort.raise} = {
  let names = map(members, |m: Member| m.full);
  let first = match list_at(members, 0) { Some(m) -> m.full, None -> b"" };
  let gname = bytes_concat(symbol_of(first), b"_group");
  let answer = KBoxed;
  let width = fold(members, 0, |acc: Int, m: Member|
    if len(m.params) > acc { len(m.params) } else { acc });
  let start: Emitter = {
    out: [],
    temp_count: 0,
    unboxed: [],
    indent: 0,
    reads: [],
    shapes: [],
    built: [],
    module: module,
    base: 0,
    count_locals: [],
    here: here,
    imports: imports,
    consts: [],
    ctors: ctors,
    lambda_bodies: b"",
    lambdas: [],
    owner: first,
    builtins: builtins,
    called_builtins: [],
    fields: [],
    released: [],
    reuse_widths: [],
    alias: [],
    by_root: [],
    tail: true,
    calls: [],
    generics: no_generics(),
    refused: None,
    deferred: [],
    deferred_locals: [],
    performs: [],
    handles: [],
    landing: None,
    effects: effects,
    release: release,
    pinned: [],
    bound: [],
    group: names,
    operands: operands,
    typed: typed,
    answer: answer,
    site_root: None,
    lent: [],
    written: [],
  };
  match group_cases(start, members, 0) {
    None -> None,
    Some(emitter) -> if emitter.refused != None { None } else {
      let gentry = bytes_concat(gname, b"_entry");
      let sig = bytes_concat_all([
        b"static Word ",
        gentry,
        b"(PlyCtx *ctx, const Word *args);\n",
        b"static Word ",
        gname,
        b"(PlyCtx *ctx, int which",
        fold(range(0, width), b"", |acc: Bytes, i: Int|
          bytes_concat_all([acc, b", Word p", ascii_of_int(i)])),
        b") {\n",
      ]);
      let toks = fold(sorted_widths(emitter.reuse_widths), b"", |acc: Bytes, w: Int|
        bytes_concat_all([acc, b"  Word tok", ascii_of_int(w), b" = 0;\n"]));
      let decls = fold(emitter.deferred_locals, b"", |acc: Bytes, r: Bytes|
        bytes_concat_all([acc, b"  Word ", r, b" = 0;\n"]));
      let entered = bytes_concat_all([
        b"static Word ",
        gentry,
        b"(PlyCtx *ctx, const Word *args) {\n  return ",
        gname,
        b"(ctx, (int)args[0]",
        fold(range(0, width), b"", |acc: Bytes, i: Int|
          bytes_concat_all([acc, b", args[", ascii_of_int(i + 1), b"]"])),
        b");\n}\n",
      ]);
      let wrappers = fold(
        range(0, len(members)),
        { emitter: emitter, text: b"" },
        |acc: { emitter: Emitter, text: Bytes }, i: Int|
          match list_at(members, i) {
            Some(m) -> {
              let w = group_wrapper(
                acc.emitter,
                gname,
                i,
                m,
                width,
                carried_answer(module, here, m.full),
              );
              { emitter: w.emitter, text: bytes_concat(acc.text, w.text) }
            },
            None -> acc,
          },
      );
      Some({
        text: bytes_concat_all([
          sig,
          fuel_head(gentry, b"", group_args(width), Whole(KBoxed)),
          toks,
          decls,
          b"  ply_loop: ",
          tick_line(failing_return(KBoxed)),
          b"\n",
          b"  switch (which) {\n",
          bytes_join(
            bytes_split(bytes_join(emitter.out, b""), toks_mark()),
            toks_freeing(emitter.reuse_widths),
          ),
          b"  }\n  return 0;\n}\n",
          entered,
          wrappers.text,
          emitter.lambda_bodies,
        ]),
        tables: tables_of(
          wrappers.emitter,
          first,
          map(members, |m: Member| head_of(m.params, carried_answer(module, here, m.full))),
        ),
      })
    },
  }
}

/// Each member's case: its own window over the shared temporaries and tables, closed by its return.
fn group_cases(emitter: Emitter, members: List<Member>, i: Int) -> Option<Emitter> / {abort.raise} =
  if i >= len(members) { Some(emitter) } else {
    match list_at(members, i) {
      None -> None,
      Some(m) -> {
        let opened: Emitter = indent(
          line(emitter, bytes_concat_all([b"case ", ascii_of_int(i), b": {"])),
        );
        let entered: Emitter = {
          ..opened,
          unboxed: [],
          reads: slots_read(m.body),
          built: [],
          count_locals: [],
          released: [],
          alias: [],
          by_root: [],
          deferred: [],
          pinned: [],
          bound: [],
          tail: true,
          landing: None,
          owner: m.full,
          base: m.base,
        };
        let words = map(m.params, |p: EmitParam|
          { ..p, carrier: Whole(KBoxed), kind: if p.kind == KMaybe { KBoxed } else { p.kind } });
        match expr(prologue(entered, words), widths_closed(entered, m.body), words) {
          None -> None,
          Some(o) -> {
            let w = returned(o.emitter, o.value);
            let closed = line(
              w.emitter,
              bytes_concat_all([toks_mark(), b" ctx->fuel += 1; return ", w.expr, b";"]),
            );
            group_cases(line(outdent(closed), b"}"), members, i + 1)
          },
        }
      },
    }
  }

fn group_wrapper(
  emitter: Emitter,
  gname: Bytes,
  which: Int,
  member: Member,
  width: Int,
  answer: Carrier,
) -> { emitter: Emitter, text: Bytes } / {abort.raise} = {
  let name = symbol_of(member.full);
  let grown = grown_words(emitter, member.params, answer);
  let call = bytes_concat_all([
    gname,
    b"(ctx, ",
    ascii_of_int(which),
    fold(range(0, width), b"", |acc: Bytes, i: Int|
      bytes_concat(acc, match list_at(grown.words, i) {
        Some(w) -> bytes_concat(b", ", w),
        None -> b", 0",
      })),
    b")",
  ]);
  let shaped = match answer {
    Fields(fs) -> shape_of_fields(grown.emitter, fs),
    Whole(_) -> { emitter: grown.emitter, i: 0 },
  };
  let k = returned_kind(answer);
  let opened = |loads: List<CValue>|
    bytes_concat_all([
      b"  Word r = ",
      call,
      b";\n  if (ctx->failed) ",
      failing_return(k),
      b"\n  ",
      ctype(k),
      b" v = ",
      nth_value(loads, 0).expr,
      b";\n",
      fold(range(1, len(loads)), b"", |t: Bytes, j: Int|
        bytes_concat_all([t, b"  *o", ascii_of_int(j), b" = ", nth_value(loads, j).expr, b";\n"])),
      b"  ply_dec(ctx, r);\n  return v;\n",
    ]);
  {
    emitter: shaped.emitter,
    text: bytes_concat_all([
      head_text(name, member.params, answer),
      b" {\n",
      if bytes_len(grown.prep) == 0 { b"" } else { bytes_concat_all([b"  ", grown.prep, b"\n"]) },
      match answer {
        Whole(KBoxed) -> bytes_concat_all([b"  return ", call, b";\n"]),
        Whole(KMaybe) ->
          bytes_concat_all([
            b"  Word r = ",
            call,
            b";\n  if (ctx->failed) return 0;\n  return rt_maybe_open_p(ctx, r);\n",
          ]),
        Whole(_) ->
          opened([
            {
              kind: k,
              expr: as_kind({ kind: KBoxed, expr: b"r", ty: TyOpen([]) }, k),
              ty: TyOpen([]),
            },
          ]),
        Fields(fs) -> opened(field_loads(b"r", fs)),
      },
      b"}\n",
      entry_text(name, member.params, answer, shaped.i),
    ]),
  }
}

/// A constant of a body's table. A width is the runtime's numbering of it, and a float or a decimal
/// is its literal as written, which the driver converts by the lexer's own rule. `ConstUnit` is the
/// unit, and any literal the table has no entry for.
pub type Const =
  | ConstStr(Bytes)
  | ConstBytes(Bytes)
  | ConstFixed({ width: Int, bits: Int })
  | ConstWide({ width: Int, high: Int, low: Int })
  | ConstFloat(Bytes)
  | ConstDecimal(Bytes)
  | ConstChar(Int)
  | ConstUnit

/// What the emitted C calls one definition, and the entry the loader binds it by.
pub type Defined = { symbol: Bytes, entry: Bytes, head: Head }

/// A root's C function as a call declares it: its answer's and each parameter's carried C type.
pub type Head = { answer: Bytes, params: List<Bytes> }

/// The head a body's call of `callee` was written to: a root, or a generic call's placeholder.
pub type Expect = { callee: Bytes, head: Head }

/// The head of a root of `n` parameters that takes and answers words.
pub fn word_head(n: Int) -> Head = { answer: b"Word", params: map(range(0, n), |_: Int| b"Word") }

fn head_of(params: List<EmitParam>, answer: Carrier) -> Head =
  {
    answer: carried_type(returned_kind(answer)),
    params: concat(
      fold(params, [], |acc: List<Bytes>, p: EmitParam| concat(acc, carried_types(p.carrier))),
      map(written_back(answer), |f: FieldTy| bytes_concat(ctype(f.kind), b"*")),
    ),
  }

/// What one body names of the unit around it, each table in the order its own text numbers it.
/// `members` are a group's definitions in case order, and empty for a body of its own.
/// A call of a generic definition: the callee, and each type argument as `spelled_type` spells its
/// layout, a variable of the calling body spelled as itself (`'0`), which the unit settles the
/// callee's root by; `carried` are the variables the call hands over raw, which it settles on; and
/// `fns` the lambdas it hands, which the root it settles on may run in place of its calls of them.
pub type GenericCall = { callee: Bytes, args: List<Bytes>, carried: List<Int>, fns: List<FnArg> }

/// A literal lambda handed as argument `param`: the `at`th byte of its owner root's module is where
/// it is written.
pub type FnArg = { param: Int, owner: Bytes, at: Int, nth: Int }

/// Where a body's code took a slow path because type variable `var` was unknown: its layout, where
/// `layout`, else only whether it is a scalar the code holds apart from a word.
pub type Need = { var: Int, layout: Bool }

/// A body's calls of generic definitions, numbered as their `@@gN@@` placeholders are, and its
/// needs: what a specialisation at its type arguments would read of each; the head each call of a
/// root was written to, which the unit holds the callee's own to; and the parameters it calls as
/// functions, or hands on to calls, which the unit closes to know where a function argument is called.
pub type Generics = {
  calls: List<GenericCall>,
  needs: List<Need>,
  expects: List<Expect>,
  called: List<Int>,
  passes: List<Pass>,
}

/// A body's parameter `param` handed on as argument `at` of a call of definition `callee`.
pub type Pass = { param: Int, callee: Bytes, at: Int }

pub fn no_generics() -> Generics = { calls: [], needs: [], expects: [], called: [], passes: [] }

pub type Tables = {
  consts: List<Const>,
  builtins: List<Bytes>,
  fields: List<Bytes>,
  shapes: List<List<Bytes>>,
  lambdas: List<Bytes>,
  calls: List<Bytes>,
  generics: Generics,
  performs: List<Bytes>,
  handles: List<Bytes>,
  members: List<Bytes>,
  symbols: List<Defined>,
}

/// What a body that names nothing of its unit holds.
pub fn no_tables() -> Tables =
  {
    consts: [],
    builtins: [],
    fields: [],
    shapes: [],
    lambdas: [],
    calls: [],
    generics: no_generics(),
    performs: [],
    handles: [],
    members: [],
    symbols: [],
  }

/// `s` with every `byte` taken out.
pub fn without(s: Bytes, byte: Int) -> Bytes =
  bytes_concat_all(
    map(range(0, bytes_len(s)), |i: Int|
      if bytes_at(s, i) == byte { b"" } else { bytes_slice(s, i, i + 1) }),
  )

/// The bits of the `Float` a literal's text names, its `_`s read past.
pub fn literal_bits(literal: Bytes) -> Int / {abort.raise} =
  match float_of_string(string_of_bytes(without(unspaced(literal), 95))) {
    Some(x) -> bits_of_float(x),
    None -> panic("a float literal that does not read"),
  }

fn const_of_lit(literal: Lit) -> Const =
  match literal {
    LStr(x) -> ConstStr(x),
    LBytes(x) -> ConstBytes(x),
    LFixed(name, bits) -> match width_named(name) {
      Some(w) -> ConstFixed({ width: width_index(w), bits: bits }),
      None -> ConstUnit,
    },
    LWide(name, high, low) -> match width_named(name) {
      Some(w) -> ConstWide({ width: width_index(w), high: high, low: low }),
      None -> ConstUnit,
    },
    LFloat(x) -> ConstFloat(unspaced(x)),
    LDec(x) -> ConstDecimal(unspaced(x)),
    LChar(v) -> ConstChar(v),
    _ -> ConstUnit,
  }

/// The tables of a body defining `full`, or its group's members, each with its head in `heads`.
fn tables_of(emitter: Emitter, full: Bytes, heads: List<Head>) -> Tables / {abort.raise} = {
  let names = if len(emitter.group) == 0 { [full] } else { emitter.group };
  {
    consts: map(emitter.consts, const_of_lit),
    builtins: emitter.called_builtins,
    fields: emitter.fields,
    // A shape's fields in the checker's order, which is what the unit interns a shape by.
    shapes: map(emitter.shapes, sorted_names),
    lambdas: emitter.lambdas,
    calls: emitter.calls,
    generics: emitter.generics,
    performs: emitter.performs,
    handles: emitter.handles,
    members: emitter.group,
    // What this body's C calls each definition it holds, so nothing downstream spells a symbol itself.
    symbols: map(range(0, len(names)), |i: Int|
      {
        symbol: symbol_of(at(names, i)),
        entry: entry_of(at(names, i)),
        head: match list_at(heads, i) { Some(h) -> h, None -> word_head(0) },
      }),
  }
}

/// A negative pattern literal's text runs from its `-`, across any space written after it.
fn unspaced(s: Bytes) -> Bytes =
  bytes_concat_all(
    map(range(0, bytes_len(s)), |i: Int|
      if bytes_at(s, i) <= 32 { b"" } else { bytes_slice(s, i, i + 1) }),
  )

/// Ascending: declarations come out sorted, not in the order the widths were found.
fn sorted_widths(xs: List<Int>) -> List<Int> =
  fold(range(0, len(xs)), [], |acc: List<Int>, _: Int|
    match fold(xs, None, |best: Option<Int>, x: Int|
        if fold(acc, false, |seen: Bool, y: Int| seen || y == x) { best }
        else { match best { None -> Some(x), Some(b2) -> if x < b2 { Some(x) } else { best } } }) {
      Some(m) -> push(acc, m),
      None -> acc,
    })

/// Counts the call, spends a unit of fuel, and hands the call a stack of its own when this thread's is
/// nearly out: a C frame is not a machine frame, so what bounds nesting is the fuel rather than the machine
/// it runs on. Depth and work are two bounds and two counters: fuel comes back on return, a tick never does.
/// Both are spent past the probe, so the same call re-entered on a new stack is counted once.
fn fuel_head(entry: Bytes, prep: Bytes, args: List<Bytes>, answer: Carrier) -> Bytes =
  bytes_concat_all([
    b"  if (ctx->fuel <= 0) { rt_no_fuel_p(ctx); ",
    failing_return(returned_kind(answer)),
    b" }\n",
    b"  { char probe; if ((uintptr_t)&probe < ctx->stack_floor) { ",
    prep,
    grow_call(entry, args, answer),
    b" } }\n",
    b"  ",
    tick_line(failing_return(returned_kind(answer))),
    b"\n",
    b"  ctx->fuel -= 1;\n",
  ])

/// One call counted against the entry's step budget: in the prologue, and again at every restart of a loop,
/// since a restart is the call a tail call would have made. The runtime is asked only when the count reaches
/// the checkpoint it set, so a call costs an increment and a compare.
fn tick_line(leave: Bytes) -> Bytes =
  bytes_concat_all([
    b"if (++ctx->ticks >= ctx->next_tick) { rt_tick_p(ctx); if (ctx->failed) ",
    leave,
    b" }",
  ])

/// The same call once more, on the stack `rt_grow` reserves for it. The arguments travel as an
/// array in this frame, which outlives the call that runs above it.
fn grow_call(entry: Bytes, args: List<Bytes>, answer: Carrier) -> Bytes =
  if len(args) == 0 {
    grown_return(bytes_concat_all([b"rt_grow_p(ctx, (Word)(intptr_t)&", entry, b", 0)"]), answer)
  } else {
    bytes_concat_all([
      b"Word ply_grown[",
      ascii_of_int(len(args)),
      b"];",
      fold(range(0, len(args)), b"", |acc: Bytes, i: Int|
        bytes_concat_all([
          acc,
          b" ply_grown[",
          ascii_of_int(i),
          b"] = ",
          match list_at(args, i) { Some(a) -> a, None -> b"" },
          b";",
        ])),
      b" ",
      grown_return(
        bytes_concat_all([
          b"rt_grow_p(ctx, (Word)(intptr_t)&",
          entry,
          b", (Word)(intptr_t)ply_grown)",
        ]),
        answer,
      ),
    ])
  }

/// `grown`'s word returned as a root carrying its answer as `answer` returns it: opened, or a
/// record's fields loaded, the first returned and the others written back.
fn grown_return(grown: Bytes, answer: Carrier) -> Bytes =
  match answer {
    Whole(KBoxed) -> bytes_concat_all([b"return ", grown, b";"]),
    // The answer's object is taken, its payload handed back.
    Whole(KMaybe) ->
      bytes_concat_all([
        b"Word ply_back = ",
        grown,
        b"; if (ctx->failed) return 0; return rt_maybe_open_p(ctx, ply_back);",
      ]),
    _ -> {
      let k = returned_kind(answer);
      let fail = bytes_concat_all([b"if (ctx->failed) ", failing_return(k), b" "]);
      match answer {
        Fields(fs) -> {
          let loads = field_loads(b"ply_back", fs);
          bytes_concat_all([
            b"Word ply_back = ",
            grown,
            b"; ",
            fail,
            ctype(k),
            b" ply_out = ",
            nth_value(loads, 0).expr,
            b";",
            fold(range(1, len(fs)), b"", |t: Bytes, j: Int|
              bytes_concat_all([
                t,
                b" *o",
                ascii_of_int(j),
                b" = ",
                nth_value(loads, j).expr,
                b";",
              ])),
            b" ply_dec(ctx, ply_back); return ply_out;",
          ])
        },
        _ ->
          bytes_concat_all([
            b"Word ply_back = ",
            grown,
            b"; ",
            fail,
            ctype(k),
            b" ply_out = ",
            as_kind({ kind: KBoxed, expr: b"ply_back", ty: TyOpen([]) }, k),
            b"; ply_dec(ctx, ply_back); return ply_out;",
          ]),
      }
    },
  }

/// The names a prologue still holds its arguments under, before any loop has reassigned them.
fn param_names(prefix: Bytes, n: Int) -> List<Bytes> =
  map(range(0, n), |i: Int| bytes_concat(prefix, ascii_of_int(i)))

/// A group's are its case selector and the widest member's parameters.
fn group_args(width: Int) -> List<Bytes> =
  fold(range(0, width), [b"which"], |acc: List<Bytes>, i: Int|
    push(acc, bytes_concat(b"p", ascii_of_int(i))))

test "a body that answers a literal" {
  let f = symbol_of(b"m.f");
  assert_eq(
    match emit_fn(b"m", [], [], [], [], b"m.f", [], {
        own: Borrowed,
        span: dummy_span(),
        node: NLit(LInt(7)),
      }) {
      Some(c) -> c,
      None -> b"",
    },
    bytes_concat_all([
      b"Word ",
      f,
      b"_entry(PlyCtx *ctx, const Word *args);\n",
      b"Word ",
      f,
      b"(PlyCtx *ctx) {\n  if (ctx->fuel <= 0) { rt_no_fuel_p(ctx); return 0; }\n  { char probe; if ((uintptr_t)&probe < ctx->stack_floor) { return rt_grow_p(ctx, (Word)(intptr_t)&",
      f,
      b"_entry, 0); } }\n  if (++ctx->ticks >= ctx->next_tick) { rt_tick_p(ctx); if (ctx->failed) return 0; }\n  ctx->fuel -= 1;\n  ctx->fuel += 1;\n  return (ply_fits_imm(INT64_C(7)) ? ply_imm(INT64_C(7)) : rt_box_int_p(ctx, INT64_C(7)));\n}\n",
      b"Word ",
      f,
      b"_entry(PlyCtx *ctx, const Word *args) {\n  return ",
      f,
      b"(ctx);\n}\n",
    ]),
  )
}

test "a body that would overrun this thread's stack runs the same call on a stack of its own" {
  let out = emit_all_program([{ name: b"m", src: b"fn g(n: Int) -> Int = n + 1\n" }], [], [], true);
  let text = match list_at(out, 0) { Some(e) -> e.text, None -> b"" };
  assert_eq(
    bytes_index_of(
        text,
        bytes_concat_all([
          b"{ char probe; if ((uintptr_t)&probe < ctx->stack_floor) { Word ply_grown[1];",
          b" ply_grown[0] = p0; return rt_grow_p(ctx, (Word)(intptr_t)&",
          symbol_of(b"m.g"),
          b"_entry, (Word)(intptr_t)ply_grown); } }",
        ]),
      )
      != None,
    true,
  );
  assert_eq(bytes_index_of(text, b"rt_no_stack_p") != None, false)
}

test "two names an underscore apart spell two symbols" {
  assert_eq(symbol_of(b"m_a.b") == symbol_of(b"m.a_b"), false);
  assert_eq(symbol_of(b"m.f"), b"ply_m_1f_1");
  assert_eq(symbol_of(b"m.f#requires#0"), b"ply_m_1f_1requiresh80h1");
  // A byte no C identifier holds takes the whole piece into hex.
  assert_eq(symbol_of(b"m.f\xc3\xa9"), b"ply_m_166c3a9x6")
}

test "a self call in tail position restarts the body instead of nesting" {
  let src = bytes_concat_all([
    b"fn count(n: Int, acc: Int) -> Int = if n <= 0 { acc } else { count(n - 1, acc + n) }\n",
    b"fn upto(xs: List<Int>, i: Int, acc: Int) -> Int = match i >= len(xs) { true -> acc, false -> upto(xs, i + 1, acc + 1) }\n",
    b"fn all_below(xs: List<Int>, bound: Int, i: Int) -> Bool = i >= len(xs) || (i < bound && all_below(xs, bound, i + 1))\n",
    b"fn ladder(n: Int) -> Int = if n <= 0 { 0 } else { 1 + ladder(n - 1) }\n",
    b"fn inner(n: Int) -> Int = { let k = if n > 5 { inner(n - 1) } else { 0 }; k + 1 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(map(out, |e: Emitted| e.why), [None, None, None, None, None]);
  assert_eq(map(out, |e: Emitted| bytes_index_of(e.text, b"ply_loop: if") != None), [
    true,
    true,
    true,
    false,
    false,
  ]);
  assert_eq(map(out, |e: Emitted| bytes_index_of(e.text, b"goto ply_loop;") != None), [
    true,
    true,
    true,
    false,
    false,
  ])
}

test "a self call that takes no arguments restarts the body as well" {
  // `spin` declares a row: a pure nullary definition is a constant, which the table answers.
  let src = bytes_concat_all([
    b"fn spin() -> Int / {clock.read, diverges} = spin()\n",
    b"fn poll() -> Int / {clock.read, diverges} = { clock.now(); poll() }\n",
    b"fn ladder() -> Int / {diverges} = 1 + ladder()\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(map(out, |e: Emitted| e.name), [b"m.spin", b"m.poll", b"m.ladder"]);
  assert_eq(map(out, |e: Emitted| e.why), [None, None, None]);
  assert_eq(map(out, |e: Emitted| bytes_index_of(e.text, b"ply_loop: if") != None), [
    true,
    true,
    false,
  ]);
  assert_eq(map(out, |e: Emitted| bytes_index_of(e.text, b"goto ply_loop;") != None), [
    true,
    true,
    false,
  ]);
  // A lone definition is no group, so the jump is the self path's, and a nullary body assigns nothing before it.
  let spin = match list_at(out, 0) {
    Some(e) -> e,
    None -> { name: b"", text: b"", tables: no_tables(), why: None, handles: [] },
  };
  assert_eq(bytes_index_of(spin.text, b"which = ") != None, false);
  assert_eq(bytes_index_of(spin.text, b"p0 = ") != None, false)
}

test "a tail call into a definition's own recursive group jumps instead of nesting" {
  let src = bytes_concat_all([
    b"fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\n",
    b"fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n",
    b"fn parity(n: Int) -> Bool = even(n)\n",
    b"fn count(n: Int, acc: Int) -> Int = if n <= 0 { acc } else { count(n - 1, acc + n) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(map(out, |e: Emitted| e.name), [b"m.even", b"m.parity", b"m.count"]);
  assert_eq(map(out, |e: Emitted| e.why), [None, None, None]);
  let group = match list_at(out, 0) {
    Some(e) -> e,
    None -> { name: b"", text: b"", tables: no_tables(), why: None, handles: [] },
  };
  assert_eq(group.tables.members, [b"m.even", b"m.odd"]);
  assert_eq(group.tables.symbols, [
    { symbol: symbol_of(b"m.even"), entry: entry_of(b"m.even"), head: word_head(1) },
    { symbol: symbol_of(b"m.odd"), entry: entry_of(b"m.odd"), head: word_head(1) },
  ]);
  assert_eq(
    bytes_index_of(
        group.text,
        bytes_concat_all([
          b"static Word ",
          symbol_of(b"m.even"),
          b"_group(PlyCtx *ctx, int which, Word p0) {",
        ]),
      )
      != None,
    true,
  );
  assert_eq(bytes_index_of(group.text, b"ply_loop: if") != None, true);
  assert_eq(bytes_index_of(group.text, b"which = 1;\n") != None, true);
  assert_eq(bytes_index_of(group.text, b"which = 0;\n") != None, true);
  assert_eq(bytes_index_of(group.text, b"goto ply_loop;") != None, true);
  assert_eq(
    bytes_index_of(
        group.text,
        bytes_concat_all([
          b"Word ",
          symbol_of(b"m.odd"),
          b"(PlyCtx *ctx, Word p0) {\n  return ",
          symbol_of(b"m.even"),
          b"_group(ctx, 1, p0);",
        ]),
      )
      != None,
    true,
  );
  assert_eq(
    bytes_index_of(
        group.text,
        bytes_concat_all([b"Word ", entry_of(b"m.even"), b"(PlyCtx *ctx, const Word *args)"]),
      )
      != None,
    true,
  );
  assert_eq(bytes_index_of(group.text, b"PLY_SITE(ctx, @@r@@") != None, false);
  // A caller outside the group calls a member's own symbol, and a self loop outside a group keeps its label.
  let parity = match list_at(out, 1) { Some(e) -> e, None -> group };
  assert_eq(
    bytes_index_of(parity.text, bytes_concat(symbol_of(b"m.even"), b"(ctx, ")) != None,
    true,
  );
  assert_eq(bytes_index_of(parity.text, b"ply_loop") != None, false);
  let count = match list_at(out, 2) { Some(e) -> e, None -> group };
  assert_eq(bytes_index_of(count.text, b"ply_loop: if") != None, true);
  assert_eq(bytes_index_of(count.text, b"which = ") != None, false);
  assert_eq(count.tables.members, [])
}

test "a cycle whose member holds a handle, or whose calls are not in tail position, is emitted per definition" {
  let src = bytes_concat_all([
    b"fn a(n: Int) -> Int / {clock.read, diverges} = if n <= 0 { 0 } else if n == 1 { handle { b(0) } with { clock.now() -> clock.now(), } } else { b(n - 1) }\n",
    b"fn b(n: Int) -> Int / {clock.read, diverges} = if n <= 0 { clock.now(); 0 } else { a(n - 1) }\n",
    b"fn c(n: Int) -> Int = if n <= 0 { 0 } else { 1 + d(n - 1) }\n",
    b"fn d(n: Int) -> Int = if n <= 0 { 0 } else { c(n - 1) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(map(out, |e: Emitted| e.name), [b"m.a", b"m.b", b"m.c", b"m.d"]);
  assert_eq(map(out, |e: Emitted| e.why == None), [true, true, true, true]);
  assert_eq(map(out, |e: Emitted| len(e.tables.members) == 2), [false, false, false, false]);
  assert_eq(
    map(out, |e: Emitted| bytes_index_of(e.text, b"_group(PlyCtx *ctx, int which") != None),
    [false, false, false, false],
  )
}

/// The C between a `handle`'s push and its landing label, for a unit whose first definition holds one.
fn handled_body(src: Bytes, release: Bool) -> Bytes / {abort.raise} = {
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [],
    [b"u8_of_int", b"int_of_u8", b"bytes_at", b"array_get"],
    release,
  );
  match list_at(out, 0) {
    None -> b"nothing was emitted",
    Some(e) -> match e.why {
      Some(why) -> why,
      None -> match bytes_index_of(e.text, b"rt_handle_push_p") {
        None -> b"no handle was pushed",
        Some(pushed) -> match bytes_index_of(e.text, b":;\n") {
          None -> b"no handle lands",
          Some(landed) -> bytes_slice(e.text, pushed, landed),
        },
      },
    },
  }
}

test "a body that fails inside a `handle` leaves through the handle's landing, whatever failed" {
  let src = bytes_concat_all([
    b"fn f(vs: List<Int>, b: Bytes, xs: Array<Int>, n: Int) -> Int =\n",
    b"  handle {\n",
    b"    let [x, ..] = vs;\n",
    b"    x + int_of_u8(u8_of_int(n)) + bytes_at(b, n) + array_get(xs, n) + (0 - n) * (n << 3)\n",
    b"  } with { abort.raise(m) -> 0 }\n",
  ]);
  let bodies = map([false, true], |release: Bool| handled_body(src, release));
  let leaves = |raised: Bytes| map(bodies, |body: Bytes| bytes_index_of(body, raised) != None);
  assert_eq(leaves(b"rt_let_no_match_p(ctx); goto land_"), [true, true]);
  assert_eq(leaves(b"rt_not_that_width_p(ctx, "), [true, true]);
  assert_eq(leaves(b"builtin_bytes_at_p(ctx, "), [true, true]);
  assert_eq(map(bodies, |body: Bytes| bytes_index_of(body, b"return")), [None, None])
}

test "a `parallel` block tells the runtime its definition's row only where that row holds all its branches reach" {
  let src = bytes_concat_all([
    b"effect meter { read level() -> Int }\n",
    b"fn pure(n: Int) -> (Int, Int) = parallel { n + 1, n + 2 }\n",
    b"fn reads() -> (Int, Int) / {meter.level} = parallel { meter.level(), meter.level() }\n",
    b"fn handled() -> (Int, Int) = handle { parallel { meter.level(), meter.level() } } with { meter.level() -> 0 }\n",
    b"fn nested(xs: List<Int>) -> List<(Int, Int)> = map(xs, |m: Int| parallel { m + 1, m + 2 })\n",
    b"fn open<| e>(g: () -> Int / e) -> (Int, Int) / e = parallel { g(), 1 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [b"map"], true);
  assert_eq(map(out, |e: Emitted| e.why), [None, None, None, None, None]);
  let calls = |helper: Bytes| map(out, |e: Emitted| bytes_index_of(e.text, helper) != None);
  assert_eq(calls(b"rt_parallel_past_p(ctx, "), [true, true, false, false, false]);
  assert_eq(calls(b"rt_parallel_p(ctx, "), [false, false, true, true, true])
}

test "a `return` a `handle` body emitted is seen, however its lines were joined since" {
  let failing = b"  if (ctx->failed) return 0;\n";
  assert(leaves_unlanded([b"  x;\n"], [b"  x;\n", failing]));
  assert(leaves_unlanded([b"  x;\n", b"  y;\n"], [bytes_concat_all([b"  x;\n  y;\n", failing])]));
  // One before the `handle` is the function's own, and a callee may spell the word.
  assert(!leaves_unlanded([failing], [failing, b"  if (ctx->failed) goto land_3;\n"]));
  assert(!leaves_unlanded([b"  x;\n"], [b"  x;\n", b"  Word t1 = ply_m_1returned_1(ctx);\n"]))
}

test "a form this port does not reach is refused" {
  assert_eq(
    match emit_fn(b"m", [], [], [], [], b"m.f", [], {
        own: Borrowed,
        span: dummy_span(),
        node: NLit(LBad),
      }) {
      Some(_) -> false,
      None -> true,
    },
    true,
  )
}

test "a program that will not parse is refused, and the refusal carries the parser's words" {
  let out = emit_all_program(zip_sources([b"m"], [b"fn f(x: -> Int = 1\n"]), [], [], true);
  assert_eq(map(out, |e: Emitted| e.name), [b"m"]);
  assert_eq(map(out, |e: Emitted| match e.why { Some(w) -> bytes_len(w) > 0, None -> false }), [
    true,
  ])
}

test "the emitter answers each root it was asked for, a body's tables as values" {
  let src = b"fn greet() -> Bytes = b\"hi\"\nfn twice(x: Int) -> Int = x + x\nfn guarded() -> Option<Instant> / {clock.read} = handle { Some(clock.now()) } with { clock.now() -> clock.now(), }\n";
  let wanted = [b"m.greet", b"m.twice", b"m.guarded"];
  // No constructor is in the table, so the body that builds one is refused.
  let answers = answers_of([b"m"], [src], [], wanted);
  assert_eq(map(answers, |a: RootAnswer| a.name), wanted);
  match at(answers, 0).answer {
    Body(b) -> {
      assert_eq(b.tables.consts, [ConstBytes(b"hi")]);
      assert_eq(b.tables.members, []);
      assert_eq(b.tables.symbols, [
        { symbol: symbol_of(b"m.greet"), entry: entry_of(b"m.greet"), head: word_head(0) },
      ])
    },
    Refused(_) -> assert(false),
  };
  match at(answers, 2).answer {
    Refused(r) -> {
      assert_eq(r.why, b"a constructor not in the table: Some");
      assert_eq(r.handles, [b"clock#now"])
    },
    Body(_) -> assert(false),
  }
}

test "guarded arms and every literal pattern are emitted rather than refused" {
  let src = b"fn f(n: Int, m: Int) -> Int = match n { x if x > m -> x, 0 -> 1, x if x < 0 - m -> m, _ -> m }\nfn g(s: String) -> Int = match s { t if t == \"a\" -> 1, \"b\" -> 2, _ -> 3 }\nfn h(u: Unit, b: Bytes, f: Float, d: Decimal, w: U64, n: Int) -> Int = match u { () -> match b { b\"x\" -> 1, _ -> match f { -1.5 -> 2, _ -> match d { 2.50m -> 3, _ -> match w { 7u64 -> 4, _ -> match n { 4611686018427387904 -> 5, _ -> 6 } } } } } }\n";
  assert_eq(map(emit_all_program([{ name: b"m", src: src }], [], [], true), |e: Emitted| e.why), [
    None,
    None,
    None,
  ])
}

test "an operator is compiled at the type the checker settled, whatever holds its operands" {
  let src = bytes_concat_all([
    b"fn bytes(xs: List<U8>) -> U8 = match xs { [a, b, ..] -> a + b, _ -> 0u8 }\n",
    b"fn ints(xs: List<Int>) -> Int = match xs { [a, b, ..] -> a + b, _ -> 0 }\n",
    b"fn folded(xs: List<U8>) -> U8 = fold(xs, 0u8, wrap_add)\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| map(out, |e: Emitted| bytes_index_of(e.text, text) != None);
  assert_eq(map(out, |e: Emitted| e.why), [None, None, None]);
  // The runtime's operator reads its words untyped, and a builtin value is the runtime's too.
  assert_eq(has(b"rt_binary_p"), [false, false, false]);
  assert_eq(has(b"rt_builtin_value_p"), [false, false, false]);
  assert_eq(has(b" > INT64_C(255)) { rt_overflow_p"), [true, false, false]);
  assert_eq(has(b"ply_add_ov("), [false, true, false]);
  assert_eq(has(b"(uint8_t)((uint64_t)(uint8_t)("), [false, false, true])
}

test "a `Float` is a C `double`: its operators are C's own and a literal is its bits" {
  let src = bytes_concat_all([
    b"fn poly(x: Float) -> Float = (0.5 * x + 0.25) * x - 1.5\n",
    b"fn less(a: Float, b: Float) -> Bool = a < b || a == -b\n",
    b"fn rest(a: Float, b: Float) -> Float = a % b\n",
    b"type Point = { x: Float, y: Float }\n",
    b"fn norm(p: Point) -> Float = p.x * p.x + p.y * p.y\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| map(out, |e: Emitted| bytes_index_of(e.text, text) != None);
  assert_eq(map(out, |e: Emitted| e.why), [None, None, None, None]);
  assert_eq(has(b"rt_binary_p"), [false, false, false, false]);
  assert_eq(has(b"rt_negate_p"), [false, false, false, false]);
  assert_eq(has(b"double "), [true, true, true, true]);
  // `0.5` is `0x3FE0_0000_0000_0000`.
  assert_eq(has(b"ply_f64(INT64_C(4602678819172646912))"), [true, false, false, false]);
  // C has no `%` on doubles; the runtime answers it as the evaluator does.
  assert_eq(has(b"rt_float_rem_p"), [false, false, true, false])
}

/// A root's own code: what it runs past its fuel head and before its entry, leaving out the
/// adapters that box what it carries raw for the runtime.
fn own_code(text: Bytes) -> Bytes / {abort.raise} = {
  let from = match bytes_index_of(text, b"ctx->fuel -= 1;\n") { Some(i) -> i, None -> 0 };
  let to = match bytes_index_of(text, b"_entry(PlyCtx *ctx, const Word *args) {") {
    Some(i) -> i,
    None -> bytes_len(text),
  };
  bytes_slice(text, from, to)
}

test "a record holds every `Float` field as its bits, wherever the field stands" {
  let fields = bytes_join(
    map(range(0, 70), |k: Int| bytes_concat_all([b"f", ascii_of_int(k + 10), b": Float"])),
    b", ",
  );
  let src = bytes_concat_all([
    b"type Point = { x: Float, y: Float }\n",
    b"fn point(x: Float, y: Float) -> Point = { x: x, y: y }\n",
    b"fn sum(p: Point) -> Float = p.x + p.y\n",
    b"fn weighed(name: String, weight: Float) -> { name: String, weight: Float } = { name: name, weight: weight }\n",
    b"fn moved(p: Point, by: Float) -> Point = { ..p, x: p.x + by }\n",
    b"type Wide = { ",
    fields,
    b", tag: String }\n",
    b"fn last(wide: Wide) -> Float = wide.f79\n",
    b"fn wrapped<a>(x: a) -> { inner: a } = { inner: x }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| map(out, |e: Emitted| bytes_index_of(e.text, text) != None);
  assert_eq(map(out, |e: Emitted| e.why), [None, None, None, None, None, None]);
  // No `Float` is boxed: a record holds its bits, and a function takes and answers its own.
  assert_eq(map(out, |e: Emitted| bytes_index_of(own_code(e.text), b"rt_box_float_p") != None), [
    false,
    false,
    false,
    false,
    false,
    false,
  ]);
  // `Point` holds bits alone, so it is flat wherever its word is made, here by the entries that
  // hand one to the runtime; `weighed` holds a word it counts beside them, so it is mixed and the
  // word after its fields says its first is the counted one. Both are raw.
  assert_eq(has(b"@@, 5);"), [true, true, false, true, false, false]);
  assert_eq(has(b"@@, 6);"), [false, false, true, false, false, false]);
  assert_eq(has(b"[2] = INT64_C(1);"), [false, false, true, false, false, false]);
  // A record of a known type holds a `Float` as its bits wherever it was made, so a read is a load,
  // the 70th field's at its place as the first's.
  assert(bytes_index_of(at(out, 4).text, b")[69]") != None);
  // A field of a variable's type is laid out as what it holds when the record is made.
  assert_eq(has(b"rt_record_p"), [false, false, false, false, false, true])
}

test "a definition takes and answers a float as itself, and a call says the head it was written to" {
  let src = b"fn half(x: Float) -> Float = x / 2.0\nfn quarter(x: Float) -> Float = half(half(x))\nfn same(x: Int) -> Int = x\n";
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let floats = { answer: b"double", params: [b"double"] };
  assert(
    bytes_index_of(
        at(out, 0).text,
        bytes_concat_all([b"double ", symbol_of(b"m.half"), b"(PlyCtx *ctx, double p0) {"]),
      )
      != None,
    None,
  );
  assert(bytes_index_of(own_code(at(out, 1).text), b"rt_box_float_p") == None, None);
  assert_eq(at(out, 1).tables.generics.expects, [
    { callee: b"m.half", head: floats },
    { callee: b"m.half", head: floats },
  ]);
  assert_eq(map(at(out, 1).tables.symbols, |d: Defined| d.head), [floats]);
  // An `Int` is a word whatever it is declared as, an immediate that costs no allocation.
  assert_eq(map(at(out, 2).tables.symbols, |d: Defined| d.head), [word_head(1)])
}

test "a lambda handed to a definition that calls it is run in place by the root it settles on" {
  let src = b"fn each(n: Int, f: (Int) -> Int, i: Int, acc: Int) -> Int = if i >= n { acc } else { each(n, f, i + 1, acc + f(i)) }\nfn total(n: Int, f: (Int) -> Int) -> Int = each(n, f, 0, 0)\nfn scaled(n: Int, k: Int) -> Int = total(n, |x: Int| x * k)\n";
  let at = match bytes_index_of(src, b"|x: Int|") { Some(i) -> i, None -> 0 - 1 };
  let lent = [{ param: 1, owner: b"m.scaled", at: at, nth: 0 }];
  let total = specialised_with(b"m.total", [], lent);
  let each = specialised_with(b"m.each", [], lent);
  let answers = answers_of([b"m"], [src], [], [b"m.each", b"m.total", b"m.scaled", total, each]);
  let body = |name: Bytes|
    fold(answers, None, |acc: Option<{ text: Bytes, tables: Tables }>, a: RootAnswer|
      if a.name != name { acc } else {
        match a.answer { Body(b) -> Some(b), Refused(r) -> panic(string_of_bytes_lossy(r.why)) }
      });
  let generics = |name: Bytes|
    match body(name) { Some(b) -> b.tables.generics, None -> no_generics() };
  // `each` calls its parameter; `total` hands its own on to `each`, which calls it.
  assert_eq(generics(b"m.each").called, [1]);
  assert_eq(generics(b"m.total").passes, [{ param: 1, callee: b"m.each", at: 1 }]);
  assert_eq(map(generics(b"m.scaled").calls, |g: GenericCall| g.fns), [lent]);
  assert_eq(map(generics(total).calls, |g: GenericCall| g.fns), [lent]);
  // The lambda runs in `each`'s loop: no call through the runtime, its product written there.
  match body(each) {
    Some(b) -> {
      assert(bytes_index_of(own_code(b.text), b"rt_call_p") == None, None);
      assert(bytes_index_of(own_code(b.text), b"ply_loop") != None, None)
    },
    None -> panic("no body for the specialisation"),
  }
}

test "a definition's call of itself is written to the head of the root it names" {
  let src = b"fn deepened<a>(x: a, n: Int) -> a where numeric(a) = if n <= 0 { x } else { deepened(x, n - 1) + x }\n";
  let answers = answers_of([b"m"], [src], [], [b"m.deepened", b"m.deepened@Float"]);
  let heads = |name: Bytes|
    map(filter(answers, |a: RootAnswer| a.name == name), |a: RootAnswer|
      match a.answer {
        Body(b) ->
          {
            own: map(b.tables.symbols, |d: Defined| d.head),
            called: map(b.tables.generics.expects, |e: Expect| e.head),
          },
        Refused(r) -> panic(string_of_bytes_lossy(r.why)),
      });
  let words = { answer: b"Word", params: [b"Word", b"Word", b"Word"] };
  let floats = { answer: b"double", params: [b"Word", b"double", b"Word"] };
  assert_eq(heads(b"m.deepened"), [{ own: [words], called: [words] }]);
  assert_eq(heads(b"m.deepened@Float"), [{ own: [floats], called: [floats] }])
}

test "a small record of floats crosses a call as its fields" {
  let src = b"type P = { x: Float, y: Float }\nfn mid(a: P, b: P) -> P = { x: (a.x + b.x) / 2.0, y: (a.y + b.y) / 2.0 }\nfn twice(p: P) -> P = mid(p, p)\n";
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let mid = { answer: b"double", params: [b"double", b"double", b"double", b"double", b"double*"] };
  assert_eq(map(out, |e: Emitted| e.why), [None, None]);
  assert_eq(map(at(out, 0).tables.symbols, |d: Defined| d.head), [mid]);
  assert_eq(at(out, 1).tables.generics.expects, [{ callee: b"m.mid", head: mid }]);
  // Neither body makes an object: `mid` answers fields and `twice` hands `p`'s along.
  assert_eq(map(out, |e: Emitted| bytes_index_of(own_code(e.text), b"rt_alloc_p") != None), [
    false,
    false,
  ])
}

test "a record of a record type holds it in place, header and all" {
  let src = bytes_concat_all([
    b"type Point = { x: Float, y: Float }\n",
    b"type Segment = { from: Point, label: String, to: Point }\n",
    b"fn segment(from: Point, to: Point, label: String) -> Segment = { from: from, label: label, to: to }\n",
    b"fn end_x(s: Segment) -> Float = s.to.x\n",
    b"fn start(s: Segment) -> Point = s.from\n",
    b"fn relabelled(s: Segment, label: String) -> Segment = { ..s, label: label }\n",
    b"fn wrapped<a>(x: a) -> { outer: { inner: a } } = { outer: { inner: x } }\n",
    b"fn retargeted(s: Segment, to: Point) -> Segment = { ..s, to: to }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| map(out, |e: Emitted| bytes_index_of(e.text, text) != None);
  assert_eq(map(out, |e: Emitted| e.why), [None, None, None, None, None, None]);
  // `from` takes a header's two words and its own two, `label` the fifth, `to` the four after, and
  // the bitmap after them names the fifth alone as counted.
  assert_eq(has(b", 9, @@s"), [true, false, false, true, false, true]);
  assert_eq(has(b"@@, 6);"), [true, false, false, true, false, true]);
  assert_eq(has(b"[9] = INT64_C(16);"), [true, false, false, true, false, true]);
  assert_eq(has(b"ply_embed(ctx, "), [true, false, false, true, false, true]);
  // A read of a record held in place is the address of its header inside its holder.
  assert_eq(has(b"+ 5))"), [false, true, false, true, false, false]);
  assert_eq(has(b"rt_box_float_p"), [false, true, false, false, false, false]);
  // `start` hands on the `from` it reads last from a record it holds: where it holds it alone, the
  // words move out. `end_x` reads through `to` and moves nothing.
  assert_eq(has(b"ply_take(ctx, "), [false, false, true, false, false, false]);
  // An update of a record it holds alone writes over the fields it sets, `label` a word and `to` a
  // record in place, and copies nothing.
  assert_eq(has(b")->rc == 1) {"), [false, false, false, true, false, true]);
  assert_eq(has(b"ply_dec(ctx, ply_words("), [false, false, false, true, false, false]);
  assert_eq(has(b"ply_drop_embedded(ctx, "), [false, false, false, false, false, true]);
  // A record holding one of a variable's type in place is laid out when it is made.
  assert_eq(has(b"rt_record_p"), [false, false, false, false, true, false])
}

test "a 64-bit width is held in a C register of its type, and in a record as its bits" {
  let src = bytes_concat_all([
    b"type Tally = { count: U64, label: String, offset: I64 }\n",
    b"fn bumped(t: Tally, by: U64) -> Tally = { ..t, count: t.count + by }\n",
    b"fn scaled(a: U64, b: U64) -> U64 = a * b\n",
    b"fn turned(a: I64) -> I64 = -a\n",
    b"fn largest() -> U64 = 0xFFFF_FFFF_FFFF_FFFFu64\n",
    b"fn kept<a>(x: a) -> { inner: a } = { inner: x }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| map(out, |e: Emitted| bytes_index_of(e.text, text) != None);
  assert_eq(map(out, |e: Emitted| e.why), [None, None, None, None, None]);
  // A sum is formed and guarded in the width itself; a product is the runtime's.
  assert_eq(has(b"(uint64_t)"), [true, true, false, true, false]);
  assert_eq(has(b"rt_binary_p"), [false, false, false, false, false]);
  assert_eq(has(b"rt_wide_binary_p(ctx, 2, 3, "), [false, true, false, false, false]);
  assert_eq(has(b"== INT64_MIN"), [false, false, true, false, false]);
  // The record holds its count's bits where its type says; a function takes and answers its width
  // raw, and only a nullary answer, which a constant reads, is boxed.
  assert_eq(has(b"] = (Word)("), [true, false, false, false, false]);
  assert_eq(map(out, |e: Emitted| bytes_index_of(own_code(e.text), b"rt_box_fixed_p") != None), [
    false,
    false,
    false,
    true,
    false,
  ]);
  assert_eq(has(b"rt_record_p"), [false, false, false, false, true])
}

test "an array holds its records in place and its floats as their bits" {
  let src = bytes_concat_all([
    b"type Point = { x: Float, y: Float }\n",
    b"fn second_x(ps: Array<Point>) -> Float / {abort.raise} = array_get(ps, 1).x\n",
    b"fn bumped(xs: Array<Float>, i: Int) -> Float / {abort.raise} = array_get(xs, i) + 1.0\n",
    b"fn count(ps: Array<Point>) -> Int = array_len(ps)\n",
    b"fn element_of<a>(xs: Array<a>, i: Int) -> a / {abort.raise} = array_get(xs, i)\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [b"array_get", b"array_len"], true);
  let has = |text: Bytes| map(out, |e: Emitted| bytes_index_of(e.text, text) != None);
  assert_eq(map(out, |e: Emitted| e.why), [None, None, None, None]);
  // A point takes a header's two words and its own two: element `i` is the header `4 * i` words in.
  // A `Float`, an element or a point's field, is a load of its bits.
  assert_eq(has(b" * 4); ply_inc("), [true, false, false, false]);
  assert_eq(has(b"ply_f64(ply_words("), [true, true, false, false]);
  assert_eq(has(b"ply_array_len("), [true, true, true, false]);
  // An array of a variable's type is the runtime's to read.
  assert_eq(has(b"array_get"), [true, true, false, true])
}

test "an Option is its payload's word in the code that knows it, and its object where it leaves" {
  let src = bytes_concat_all([
    b"fn picked(c: Bool, s: String) -> Int = match if c { Some(s) } else { None } { Some(_) -> 1, None -> 0 }\n",
    b"fn found(xs: List<String>, i: Int) -> String = match list_at(xs, i) { Some(s) -> s, None -> \"\" }\n",
    b"fn nested(s: String) -> Int = match Some(Some(s)) { Some(Some(_)) -> 2, Some(None) -> 1, None -> 0 }\n",
    b"fn kept(s: String) -> Option<String> = Some(s)\n",
    b"fn held(s: String) -> List<Option<String>> = [Some(s), None]\n",
    b"fn same(a: String, b: String) -> Bool = Some(a) == Some(b)\n",
    b"fn either(c: Bool, s: String, o: Option<String>) -> Option<String> = if c { Some(s) } else { o }\n",
    b"fn guarded(xs: List<Int>) -> Int = match list_at(xs, 0) { Some(n) if n > 1 -> n, Some(1) -> 10, _ -> 0 }\n",
    b"fn asked(o: Option<String>) -> Int = match kept(\"k\") { Some(_) -> 1, None -> 0 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"Some", b"None"], [b"list_at"], true);
  let has = |text: Bytes| map(out, |e: Emitted| bytes_index_of(own_code(e.text), text) != None);
  assert_eq(map(out, |e: Emitted| e.why), [None, None, None, None, None, None, None, None, None]);
  // Nothing reads one as a word or a scalar but through `owned` or `word_of`.
  assert_eq(map(out, |e: Emitted| bytes_index_of(e.text, b"ply_maybe_unrouted") != None), [
    false,
    false,
    false,
    false,
    false,
    false,
    false,
    false,
    false,
  ]);
  // Built, matched, handed across a call or answered, no object is made; one stored, nested or
  // compared is made the object it stands for.
  assert_eq(has(b"rt_ctor_p"), [false, false, false, false, false, false, false, false, false]);
  assert_eq(has(b"rt_maybe_take_p"), [false, false, true, false, true, false, false, false, false]);
  assert_eq(has(b"rt_maybe_box_p"), [false, false, false, false, false, true, false, false, false]);
  assert_eq(has(b"rt_list_lookup_p"), [
    false,
    true,
    false,
    false,
    false,
    false,
    false,
    true,
    false,
  ]);
  // It crosses a call as its payload's word, a C type of its own so a stale caller fails the build.
  let maybe = { answer: b"PlyMaybe", params: [b"Word"] };
  assert_eq(map(at(out, 3).tables.symbols, |d: Defined| d.head), [maybe]);
  assert_eq(map(at(out, 6).tables.symbols, |d: Defined| d.head), [
    { answer: b"PlyMaybe", params: [b"Word", b"Word", b"PlyMaybe"] },
  ]);
  assert_eq(at(out, 8).tables.generics.expects, [{ callee: b"m.kept", head: maybe }])
}

test "a constructor holds its arguments as its declaration types them" {
  let src = bytes_concat_all([
    b"type Point = { x: Float, y: Float }\n",
    b"type Shape = | Circle(Point, Float) | Label(String)\n",
    b"fn circle(at: Point, r: Float) -> Shape = Circle(at, r)\n",
    b"fn radius(s: Shape) -> Float = match s { Circle(_, r) -> r, _ -> 0.0 }\n",
    b"fn centre_x(s: Shape) -> Float = match s { Circle(p, _) -> p.x, _ -> 0.0 }\n",
    b"fn unit(s: Shape) -> Bool = match s { Circle(_, 1.0) -> true, _ -> false }\n",
    b"fn label(s: String) -> Shape = Label(s)\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"m.Circle", b"m.Label"], [], true);
  let has = |text: Bytes| map(out, |e: Emitted| bytes_index_of(e.text, text) != None);
  assert_eq(map(out, |e: Emitted| e.why), [None, None, None, None, None]);
  // A circle holds its point in place, a header's two words and its own two, and its radius's bits
  // after them: five words, none counted, so flat and raw.
  assert_eq(has(b"rt_alloc_p(ctx, 4, 5, @@Tm.Circle@@, 5);"), [true, false, false, false, false]);
  assert_eq(has(b"ply_embed(ctx, "), [true, false, false, false, false]);
  assert_eq(has(b"->len == 5)"), [false, true, true, true, false]);
  // A match reads each argument where it is held: the radius a load of its bits, and the point
  // the address of its header in the circle.
  assert_eq(has(b")[4])"), [false, true, true, true, false]);
  assert_eq(has(b") + 0))"), [false, true, true, true, false]);
  // A test of the radius against a literal boxes it to compare it as `==` does.
  assert_eq(has(b"rt_equal_p(ctx, "), [false, false, false, true, false]);
  // A label holds its word, as a constructor of no raw or record argument does.
  assert_eq(has(b"rt_ctor_p"), [false, false, false, false, true])
}

test "a `Decimal` is held in registers as its two words, and in a record or an array as them" {
  let src = bytes_concat_all([
    b"type Line = { price: Decimal, qty: Int }\n",
    b"fn line(price: Decimal, qty: Int) -> Line = { price: price, qty: qty }\n",
    b"fn doubled(l: Line) -> Decimal = l.price * 2.00m\n",
    b"fn cheaper(a: Line, b: Line) -> Bool = a.price < b.price\n",
    b"fn negated(d: Decimal) -> Decimal = -d\n",
    b"fn priced(ds: Array<Decimal>, i: Int) -> Decimal / {abort.raise} = array_get(ds, i)\n",
    b"fn picked(up: Bool, d: Decimal) -> Decimal = if up { d + 1m } else { d - 1m }\n",
    b"fn listed(d: Decimal) -> List<{ price: Decimal }> = [{ price: d }]\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [b"array_get"], true);
  let has = |text: Bytes| map(out, |e: Emitted| bytes_index_of(e.text, text) != None);
  assert_eq(map(out, |e: Emitted| e.why), [None, None, None, None, None, None, None]);
  // A line holds its price as two words and its count after them: mixed and raw.
  assert_eq(has(b".lo;"), [true, false, false, false, false, false, true]);
  assert_eq(has(b"@@, 6);"), [true, false, false, false, false, false, false]);
  // A branch's answer is declared as the struct it is before either arm assigns it.
  assert_eq(has(b" = (PlyDec){0, 0};"), [false, false, false, false, false, true, false]);
  // A price's second word is written after its first, in a line and in a record of a price
  // alone, which is held back until it is first a word.
  assert_eq(has(b")[1] = "), [true, false, false, false, false, false, true]);
  // A field read loads both words, an array's element is two words a step, and nothing is boxed:
  // a function takes and answers its decimals as their words.
  assert_eq(has(b"ply_dec_at("), [false, true, true, false, true, false, false]);
  assert_eq(has(b") * 2)"), [false, false, false, false, true, false, false]);
  assert_eq(
    map(out, |e: Emitted| bytes_index_of(own_code(e.text), b"rt_box_decimal_p") != None),
    [false, false, false, false, false, false, false],
  );
  // Arithmetic and comparison are the runtime's, over the words, allocating nothing.
  assert_eq(has(b"rt_decimal_binary_p(ctx, 2, "), [false, true, false, false, false, false, false]);
  assert_eq(has(b") < 0)"), [false, false, true, false, false, false, false]);
  assert_eq(has(b"rt_decimal_negate_p"), [false, false, false, true, false, false, false]);
  assert_eq(has(b"rt_binary_p"), [false, false, false, false, false, false, false])
}

test "a byte is read through `ply_bytes`, which follows a view to the value it views" {
  let src = bytes_concat_all([
    b"fn at(b: Bytes, i: Int) -> Int / {abort.raise} = bytes_at(b, i)\n",
