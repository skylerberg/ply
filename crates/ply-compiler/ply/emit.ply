  let has = |text: Bytes| map(out, |e: Emitted| bytes_index_of(e.text, text) != None);
  assert_eq(map(out, |e: Emitted| e.why), [None, None]);
  assert_eq(has(b"ply_bytes("), [true, true]);
  assert_eq(has(b"(unsigned char *)ply_words("), [false, false])
}

test "a field of a `Columns`' record is loaded from its column, with no record made" {
  let src = bytes_concat_all([
    b"type P = { label: String, x: Float }\n",
    b"fn x_at(ps: Columns<P>, i: Int) -> Float / {abort.raise} = columns_get(ps, i).x\n",
    b"fn label_at(ps: Columns<P>, i: Int) -> String / {abort.raise} = columns_get(ps, i).label\n",
