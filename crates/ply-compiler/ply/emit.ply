  assert_eq(map(out, |e: Emitted| e.why), [None]);
  // `p` holds a `Point`, so each field is a load at its place rather than a search by name.
  assert_eq(map(out, |e: Emitted| bytes_index_of(e.text, b"rt_field_p") != None), [false])
}

test "two operators on one span that the checker settled apart are left unsettled" {
  let at = { start: 3, end: 9 };
  let sites = [
    { module: 0, span: at, ty: b"Int", owner: b"m.f" },
    { module: 0, span: at, ty: b"U8", owner: b"m.g" },
    { module: 1, span: at, ty: b"U8", owner: b"n.f" },
  ];
  assert_eq(map_get(operands_in(sites, 0), span_key(at)), Some(unsettled()));
  assert_eq(map_get(operands_in(sites, 1), span_key(at)), Some(b"U8"))
}

// --- the emitter's entry ----------------------------------------------------

/// A definition as its callers read it, its answer as its scheme says.
fn def_entry(module: Bytes, d: FnDef, pure: Map<Bytes, Bool>, schemes: Map<Bytes, Scheme>) -> Def = {
  let full = qualify(module, d.name.name);
  let ret = match sig_of(schemes, full) { Some(s) -> Some(kind_of(s.ret)), None -> None };
  let carried = carriers_of(d, sig_of(schemes, full));
  {
    name: d.name.name,
    ret: match ret { Some(r) -> Some(r.kind), None -> None },
    ret_ty: match ret { Some(r) -> r.ty, None -> TyOpen([]) },
    pure: map_contains(pure, full),
    arity: len(d.params) + len(d.generics.labels),
    scheme: map_get(schemes, full),
    carriers: carried.params,
    answer: carried.answer,
    witnesses: carried.witnesses,
  }
}

/// How each parameter of `d`, witnesses first and labels last as its function takes them, and its
/// answer cross a call between roots, from the types its scheme declares; a nullary root's answer
/// is a word, as a constant's is.
fn carriers_of(
  d: FnDef,
  sig: Option<Sig>,
) -> { params: List<Carrier>, answer: Carrier, witnesses: Int } = {
  let given = match sig { Some(s) -> s.params, None -> [] };
  let witnesses = len(d.params) - len(given);
  let written = map(range(0, len(d.params)), |i: Int|
    if i < witnesses { Whole(KBoxed) } else {
      match list_at(given, i - witnesses) { Some(t) -> carrier_of(t), None -> Whole(KBoxed) }
    });
  {
    params: fold(d.generics.labels, written, |acc: List<Carrier>, _: Ident|
      push(acc, Whole(KBoxed))),
    answer: if len(d.params) + len(d.generics.labels) == 0 { Whole(KBoxed) }
    else { match sig { Some(s) -> carrier_of(s.ret), None -> Whole(KBoxed) } },
    witnesses: witnesses,
  }
}

/// How a root of `d` at type arguments `args` takes each parameter and answers: as `carriers_of`
/// says of the types it declares, and each variable `carried_vars` names as its argument's own C
/// type. Callers at their type arguments and the root at its own reach the same.
fn carriers_at(
  d: Def,
  args: List<Type>,
) -> { params: List<Carrier>, answer: Carrier } / {abort.raise} =
  match d.scheme {
    None -> { params: d.carriers, answer: d.answer },
    Some(sc) -> match sc.ty {
      TyFn(f) -> {
        let raw = carried_vars(sc, args, d.arity);
        let at_var = |t: Type, otherwise: Carrier|
          match t {
            TyVar(j) -> if contains(raw, j) { carrier_of(at(args, j)) } else { otherwise },
            _ -> otherwise,
          };
        {
          params: map(range(0, len(d.carriers)), |i: Int| {
            let k = at(d.carriers, i);
            if i < d.witnesses { k }
            else { match list_at(f.params, i - d.witnesses) { Some(t) -> at_var(t, k), None -> k } }
          }),
          answer: at_var(f.ret, d.answer),
        }
      },
      _ -> { params: d.carriers, answer: d.answer },
    },
  }

/// The variables of `scheme` a call at `args` carries raw: each standing bare as a parameter, or as
/// the answer of a function taking any, at an argument whose word would be an allocation. The unit
/// settles such a call on the callee's specialisation at each.
fn carried_vars(scheme: Scheme, args: List<Type>, arity: Int) -> List<Int> / {abort.raise} =
  match scheme.ty {
    TyFn(f) ->
      filter(range(0, len(args)), |j: Int|
        (contains(f.params, TyVar(j)) || (arity > 0 && f.ret == TyVar(j)))
          && carrier_of(at(args, j)) != Whole(KBoxed)
          && carrier_of(at(args, j)) != Whole(KMaybe)),
    _ -> [],
  }

/// Whether two calls hand the same lambdas, each as the same parameter.
fn same_fns(a: List<FnArg>, b: List<FnArg>) -> Bool =
  len(a) == len(b) && fold(a, true, |ok: Bool, f: FnArg| ok && contains(b, f))

/// The parameter of this body slot `slot` holds as itself: one the window holds, followed through
/// renames, or one the prologue left as its word.
fn slot_param(emitter: Emitter, slot: Int, params: List<EmitParam>) -> Option<Int> =
  match conv_of(emitter, slot) {
    Some(cv) -> param_of(emitter, cv, params),
    None -> if slot < len(params) { Some(slot) } else { None },
  }

/// The emitter noting each of this body's parameters a call of `callee` hands on as itself, by the
/// argument it is: where the callee calls that argument, this body calls the parameter.
fn passed_on(
  emitter: Emitter,
  callee: Bytes,
  codes: List<Code>,
  params: List<EmitParam>,
) -> Emitter =
  fold(range(0, len(codes)), emitter, |acc: Emitter, i: Int|
    match match list_at(codes, i) {
        Some(c) -> match c.node {
          NVar(v) -> match v.slot { Some(slot) -> slot_param(acc, slot, params), None -> None },
          _ -> None,
        },
        None -> None,
      } {
      Some(j) -> {
        let g = acc.generics;
        note_generics(acc, { ..g, passes: push(g.passes, { param: j, callee: callee, at: i }) })
      },
      None -> acc,
    })

/// The literal lambdas among a call's `codes`, each by its argument's place, where this root is a
/// plain definition at no type variable, whose lambdas a callee's specialisation reads and runs.
fn fn_args(
  emitter: Emitter,
  codes: List<Code>,
  params: List<EmitParam>,
) -> List<FnArg> / {abort.raise} = {
  let lends = lends_lambdas(emitter);
  fold(range(0, len(codes)), [], |acc: List<FnArg>, j: Int|
    match list_at(codes, j) {
      Some(c) -> match c.node {
        NLambda(l) -> if lends {
          match position_in(written_at(emitter.written, l.at.start), l) {
            Some(nth) -> push(acc, { param: j, owner: emitter.owner, at: l.at.start, nth: nth }),
            None -> acc,
          }
        } else { acc },
        // A parameter bound to a lambda, handed on: the callee runs the same lambda.
        NVar(v) -> match match v.slot {
            Some(slot) -> match slot_param(emitter, slot, params) {
              Some(i) -> match list_at(params, i) { Some(p) -> p.lambda, None -> None },
              None -> None,
            },
            None -> None,
          } {
          Some(bl) -> push(acc, { param: j, owner: bl.owner, at: bl.at, nth: bl.nth }),
          None -> acc,
        },
        _ -> acc,
      },
      None -> acc,
    })
}

/// Whether the root being emitted is a definition as it stands, of no type variable: one a
/// lambda of can be read again where another root runs it.
fn lends_lambdas(emitter: Emitter) -> Bool / {abort.raise} =
  specialisation_of(emitter.owner) == None && bytes_index_of(emitter.owner, b"#") == None
    && (match fold(emitter.here, None, |acc: Option<Def>, d: Def|
        if qualify(emitter.module, d.name) == emitter.owner { Some(d) } else { acc }) {
      Some(d) -> match d.scheme { Some(sc) -> len(sc.ty_vars) == 0, None -> true },
      None -> false,
    })

/// The type arguments the checker gave a reference of a generic definition at `at`; none where it
/// gave none or not one for each of the scheme's variables.
fn reference_args(emitter: Emitter, scheme: Option<Scheme>, at: Span) -> List<Type> =
  match scheme {
    None -> [],
    Some(sc) -> if len(sc.ty_vars) == 0 { [] } else {
      match map_get(emitter.typed, span_key(at)) {
        Some(t) -> if len(t.args) == len(sc.ty_vars) { t.args } else { [] },
        None -> [],
      }
    },
  }

/// How a value declared at `t` crosses a call between roots: a `Float`, a `Decimal` or a 64-bit
/// width, whose word would be an allocation, as itself; a record `carried_record` admits as its
/// fields; anything else as its word.
fn carrier_of(t: Type) -> Carrier = {
  let k = kind_of(t);
  if is_option_type(t) { Whole(KMaybe) } else {
    match k.ty {
      TyRec(fs) -> if carried_record(fs) { Fields(fs) } else { Whole(KBoxed) },
      _ -> match k.kind {
        KFloat -> Whole(KFloat),
        KDec -> Whole(KDec),
        KNum(w) -> if in_imm(w) || !carried(w) { Whole(KBoxed) } else { Whole(KNum(w)) },
        _ -> Whole(KBoxed),
      },
    }
  }
}

/// A record that crosses a call as its fields: flat, every field bits no count is kept of and none
/// a record held in place, and at most four words.
fn carried_record(fs: List<FieldTy>) -> Bool =
  len(fs) > 0 && laid_of(fs).width <= 4
    && fold(fs, true, |ok: Bool, f: FieldTy|
      ok && in_place(f) == None
        && (match f.kind {
          KFloat -> true,
          KDec -> true,
          KNum(_) -> true,
          KBool -> true,
          _ -> false,
        }))

/// The C types `c` crosses a call in, one per C parameter.
fn carried_types(c: Carrier) -> List<Bytes> =
  match c { Whole(k) -> [carried_type(k)], Fields(fs) -> map(fs, |f: FieldTy| ctype(f.kind)) }

/// The kind a root answering as `c` returns: the answer's, or a record's first field's.
fn returned_kind(c: Carrier) -> Kind =
  match c {
    Whole(k) -> k,
    Fields(fs) -> match list_at(fs, 0) { Some(f) -> f.kind, None -> KBoxed },
  }

/// The fields of a record answer past its first, each written through a pointer the caller hands.
fn written_back(c: Carrier) -> List<FieldTy> =
  match c { Whole(_) -> [], Fields(fs) -> map(range(1, len(fs)), |k: Int| nth_field(fs, k)) }

/// The C names of each parameter's carried values, `p<i>` or a record's `p<i>_<k>`, and then the
/// pointers a record answer is written through.
fn carried_names(params: List<EmitParam>, answer: Carrier) -> List<Bytes> =
  concat(
    fold(range(0, len(params)), [], |acc: List<Bytes>, i: Int|
      match list_at(params, i) {
        Some(p) -> match p.carrier {
          Fields(fs) -> concat(acc, map(range(0, len(fs)), |k: Int| field_param(i, k))),
          Whole(_) -> push(acc, bytes_concat(b"p", ascii_of_int(i))),
        },
        None -> acc,
      }),
    map(range(1, len(written_back(answer)) + 1), |k: Int| bytes_concat(b"o", ascii_of_int(k))),
  )

fn field_param(i: Int, k: Int) -> Bytes =
  bytes_concat_all([b"p", ascii_of_int(i), b"_", ascii_of_int(k)])

/// Each field of the record `value` of fields `fs` as a value: what built it, or loaded from its word.
fn record_values(
  emitter: Emitter,
  value: CValue,
  fs: List<FieldTy>,
) -> { emitter: Emitter, vals: List<CValue> } =
  match built_of(emitter, value.expr) {
    Some(_) ->
      {
        emitter: emitter,
        vals: map(fs, |f: FieldTy|
          match built_field(emitter, value.expr, f.name) {
            Some(v) -> v,
            None -> { kind: f.kind, expr: zero_of(f.kind), ty: f.ty },
          }),
      },
    None -> {
      let w = word_of(emitter, value);
      { emitter: w.emitter, vals: field_loads(w.expr, fs) }
    },
  }

/// Each field of the record of fields `fs` whose word is `word`, loaded at its place.
fn field_loads(word: Bytes, fs: List<FieldTy>) -> List<CValue> =
  map(fs, |f: FieldTy|
    match field_at(TyRec(fs), f.name) {
      Some(i) ->
        {
          kind: f.kind,
          expr: if raw_slot(i.kind) { raw_at(word, ascii_of_int(i.at), i.kind) }
          else { as_kind({ kind: KBoxed, expr: field_read(word, i), ty: TyOpen([]) }, i.kind) },
          ty: f.ty,
        },
      None -> { kind: f.kind, expr: zero_of(f.kind), ty: f.ty },
    })

/// C statements making the record of fields `fs` from `vals` into the word `name`, as a held-back
/// record is made: one of `shape`, leaving by `fail` if the allocation fails.
fn record_word_lines(
  name: Bytes,
  fs: List<FieldTy>,
  shape: Int,
  vals: List<CValue>,
  fail: Bytes,
) -> Bytes = {
  let l = laid_of(fs);
  let flags = record_flags(fs, l);
  let words = map(vals, |v: CValue| if raw_slot(v.kind) { raw_word(v) } else { as_word(v) });
  bytes_concat_all([
    b"Word ",
    name,
    b" = rt_alloc_p(ctx, 3, ",
    ascii_of_int(l.width),
    b", ",
    shape_text(shape),
    b", ",
    ascii_of_int(flags),
    b"); if (ctx->failed) ",
    fail,
    fold(cells_of(fs, words, l, flags), b"", |acc: Bytes, c: WordAt|
      bytes_concat_all([
        acc,
        b" ply_words(",
        name,
        b")[",
        ascii_of_int(c.at),
        b"] = ",
        c.expr,
        b";",
      ])),
  ])
}

fn defs_in(
  module: Bytes,
  m: Module,
  pure: Map<Bytes, Bool>,
  schemes: Map<Bytes, Scheme>,
) -> List<Def> =
  fold(m.items, [], |acc: List<Def>, item: Item|
    match item { IFn(d) -> push(acc, def_entry(module, d, pure, schemes)), _ -> acc })

test "the emitter writes an embed out as the front end's answer says it was read" {
  let src = b"fn data() -> Bytes = embed(\"d.txt\")\n";
  let want = { path: b"d.txt", dir: false };
  let d = dump_of(
    analyse_pulling_std_with(
      [{ name: b"m", src: src }],
      [],
      no_rows(),
      { root: b"", manifest: None, supplied: [] },
      [{ root: b"", module: b"m", want: want, read: Ok([{ name: b"", bytes: b"one" }]) }],
    ).out,
  );
  match at(
      emit_roots_answer(
        [b"m"],
        [src],
        no_ctors(),
        [],
        [b"m.data"],
        [],
        [],
        d.embeds,
        d.rows,
        d.walked,
      ),
      0,
    ).answer {
    Body(b) -> assert_eq(b.tables.consts, [ConstBytes(b"one")]),
    Refused(r) -> panic(string_of_bytes_lossy(r.why)),
  }
}

/// The roots `wanted` names as the emitter answers them over what the front end read of the program.
fn answers_of(
  names: List<Bytes>,
  srcs: List<Bytes>,
  ctors: List<Bytes>,
  wanted: List<Bytes>,
) -> List<RootAnswer> / {abort.raise} = {
  let d = dump_of(analyse(parse_all(zip_sources(names, srcs))));
  emit_roots_answer(
    names,
    srcs,
    { names: ctors, laid: ctor_layouts(d.ctors) },
    [b"?numeric_binary"],
    wanted,
    [],
    [],
    d.embeds,
    d.rows,
    d.walked,
  )
}

test "a generic definition reached at a type held apart from a word is emitted again at it" {
  let src = bytes_concat_all([
    b"fn twice<a>(x: a) -> a where numeric(a) = x + x\n",
    b"fn go(f: Float) -> Float = twice(f)\n",
    b"fn id<a>(x: a) -> a = x\n",
    b"fn same(s: String) -> String = id(s)\n",
    b"fn down<a>(n: Int, x: a) -> a where numeric(a) = if n <= 0 { x } else { down(n - 1, x + x) }\n",
    b"fn fall(n: Int) -> Int = down(n, 1)\n",
  ]);
  let wanted = [
    b"m.go",
    b"m.same",
    b"m.fall",
    b"m.twice",
    b"m.id",
    b"m.twice@Float",
    b"m.down@Int",
  ];
  let answers = answers_of([b"m"], [src], [], wanted);
  let body = |name: Bytes|
    match fold(answers, None, |acc: Option<RootAnswer>, a: RootAnswer|
        if a.name == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(string_of_bytes_lossy(bytes_concat_all([name, b": ", r.why]))),
      },
      None -> panic("no answer"),
    };
  let has = |name: Bytes, text: Bytes| bytes_index_of(body(name).text, text) != None;
  // A call of a generic definition names a placeholder the unit settles, with its arguments' layouts.
  assert(has(b"m.go", b"@@g0@@"));
  assert_eq(body(b"m.go").tables.generics.calls, [
    { callee: b"m.twice", args: [b"Float"], carried: [0], fns: [] },
  ]);
  assert_eq(body(b"m.same").tables.generics.calls, [
    { callee: b"m.id", args: [b"_"], carried: [], fns: [] },
  ]);
  // `twice` reads its witness, which a scalar argument does in C; `id` needs nothing of its argument.
  assert_eq(body(b"m.twice").tables.generics.needs, [{ var: 0, layout: false }]);
  assert_eq(body(b"m.id").tables.generics.needs, []);
  // At `Float` the witnessed `+` is C's own, and the parameter a `double`.
  assert(has(b"m.twice@Float", b"double "));
  assert(!has(b"m.twice@Float", b"numeric_binary"));
  // A specialisation's call of itself stays in it, here as a loop.
  assert(has(b"m.down@Int", b"goto ply_loop;"));
  assert(!has(b"m.down@Int", b"numeric_binary"));
  assert_eq(body(b"m.down@Int").tables.calls, [b"m.down@Int"])
}

test "a specialisation hands its recursion on to the definitions as they stand where it leaves them" {
  let src = bytes_concat_all([
    b"fn spin<a, b>(x: a, y: b, n: Int) -> Int = if n <= 0 { 0 } else { spin(y, x, n - 1) }\n",
    b"fn ping<a>(x: a, n: Int) -> a = if n <= 0 { x } else { pong(x, n - 1) }\n",
    b"fn pong<a>(x: a, n: Int) -> a = if n <= 0 { x } else { ping(x, n - 1) }\n",
    b"fn go() -> Float = { let _ = spin(1.5, 7, 3); ping(1.5, 3) }\n",
  ]);
  let answers = answers_of([b"m"], [src], [], [
    b"m.go",
    b"m.spin",
    b"m.spin@Float,Int",
    b"m.ping",
    b"m.pong",
    b"m.ping@Float",
  ]);
  let body = |name: Bytes|
    match fold(answers, None, |acc: Option<RootAnswer>, a: RootAnswer|
        if a.name == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer { Body(b) -> b, Refused(r) -> panic(string_of_bytes_lossy(r.why)) },
      None -> panic("no answer"),
    };
  let loops = |name: Bytes| bytes_index_of(body(name).text, b"goto ply_loop;") != None;
  assert_eq(body(b"m.go").tables.generics.calls, [
    { callee: b"m.spin", args: [b"Float", b"Int"], carried: [0], fns: [] },
    { callee: b"m.ping", args: [b"Float"], carried: [0], fns: [] },
  ]);
  // The call hands `y` on as `x`: what is a `Float` here is an `Int` there, so the call is of the
  // definition as it stands, whose own body restarts.
  assert_eq(body(b"m.spin@Float,Int").tables.calls, [b"m.spin"]);
  assert(!loops(b"m.spin@Float,Int"));
  assert(loops(b"m.spin"));
  // `ping` and `pong` are one loop under `ping`'s name, which the specialisation enters by `pong`.
  assert_eq(body(b"m.ping@Float").tables.calls, [b"m.pong"]);
  assert(loops(b"m.ping"))
}

test "a generic definition reached at a record type reads the record where its layout puts it" {
  let src = b"fn first<a, b>(p: { l: a, r: b }) -> a = p.l\nfn pick(q: { l: { x: Float, y: Float }, r: Int }) -> Float = first(q).x\n";
  let laid = b"m.first@{x:Float,y:Float},Int";
  let answers = answers_of([b"m"], [src], [], [b"m.pick", b"m.first", laid]);
  let text = |name: Bytes|
    match fold(answers, None, |acc: Option<Bytes>, a: RootAnswer|
        if a.name == name {
          Some(match a.answer {
            Body(x) -> x.text,
            Refused(r) -> panic(string_of_bytes_lossy(r.why)),
          })
        } else { acc }) {
      Some(t) -> t,
      None -> panic("no answer"),
    };
  let tables = |name: Bytes|
    match fold(answers, None, |acc: Option<Tables>, a: RootAnswer|
        if a.name == name { match a.answer { Body(x) -> Some(x.tables), Refused(_) -> acc } }
        else { acc }) {
      Some(t) -> t,
      None -> panic("no answer"),
    };
  assert_eq(tables(b"m.pick").generics.calls, [
    { callee: b"m.first", args: [b"{x:Float,y:Float}", b"Int"], carried: [0], fns: [] },
  ]);
  // Unspecialised, `p`'s fields may be anything, so `p.l` is read by name, which both its variables
  // cause; at the record, by place.
  assert(bytes_index_of(text(b"m.first"), b"rt_field_p") != None);
  assert_eq(tables(b"m.first").generics.needs, [
    { var: 0, layout: true },
    { var: 1, layout: true },
  ]);
  assert(bytes_index_of(text(laid), b"rt_field_p") == None)
}

test "a long part of a name is its digest, so two long names alike at the start stay apart" {
  let long = |tail: Bytes|
    bytes_concat_all([
      b"m.f@{",
      bytes_concat_all(
        map(range(0, 40), |i: Int| bytes_concat_all([b"f", ascii_of_int(i), b":Float,"])),
      ),
      tail,
      b"}",
    ]);
  let a = symbol_of(long(b"x:Int"));
  let b = symbol_of(long(b"y:Int"));
  assert(a != b);
  assert(bytes_len(a) < 80);
  // A short part is spelled in full.
  assert(bytes_index_of(symbol_of(b"m.f@Float"), hex(b"f@Float")) != None)
}

test "a specialisation's root spells its layouts and the lambdas it runs, and reads back as them" {
  let args = [
    TyRecord([
      {
        name: b"a",
        ty: TyCon({
          name: b"Array",
          args: [TyRecord([{ name: b"x", ty: TyCon({ name: b"Float", args: [] }) }])],
        }),
      },
      { name: b"b", ty: TyCon({ name: b"_", args: [] }) },
    ]),
    TyCon({ name: b"List", args: [TyCon({ name: b"_", args: [] })] }),
    TyCon({ name: b"U32", args: [] }),
  ];
  let root = specialised(b"m.f", args);
  assert_eq(root, b"m.f@{a:Array<{x:Float}>,b:_},List<_>,U32");
  assert_eq(specialisation_of(root), Some({ base: b"m.f", args: args, fns: [] }));
  assert_eq(specialisation_of(b"m.f@{a:"), None);
  // A lambda a caller hands is spelled by the root that wrote it and where.
  let fns = [
    { param: 1, owner: b"app.main", at: 120, nth: 0 },
    { param: 2, owner: b"lib.h", at: 7, nth: 3 },
  ];
  let lent = specialised_with(b"m.f", [TyCon({ name: b"U32", args: [] })], fns);
  assert_eq(lent, b"m.f@U32|1=app.main:120:0|2=lib.h:7:3");
  assert_eq(
    specialisation_of(lent),
    Some({ base: b"m.f", args: [TyCon({ name: b"U32", args: [] })], fns: fns }),
  );
  // What a layout does not read is a word.
  assert_eq(
    erased(TyCon({ name: b"Option", args: [TyCon({ name: b"Float", args: [] })] })),
    TyCon({ name: b"_", args: [] }),
  );
  assert_eq(
    erased(TyCon({ name: b"List", args: [TyCon({ name: b"Float", args: [] })] })),
    TyCon({ name: b"List", args: [TyCon({ name: b"_", args: [] })] }),
  )
}

test "an operator the checker filed at a definition's variable is done at the type it is at" {
  let src = b"fn same<a>(x: a, y: a) -> Bool = x == y\nfn floats(x: Float, y: Float) -> Bool = same(x, y)\n";
  let answers = answers_of([b"m"], [src], [], [b"m.same", b"m.floats", b"m.same@Float"]);
  let texts = map(answers, |a: RootAnswer|
    match a.answer { Body(b) -> b.text, Refused(r) -> r.why });
  assert_eq(map(answers, |a: RootAnswer| a.name), [b"m.same@Float", b"m.same", b"m.floats"]);
  // A word is compared by the runtime; a `Float` the specialisation holds is compared by C.
  assert_eq(map(texts, |t: Bytes| bytes_index_of(t, b"rt_equal_p") != None), [false, true, false]);
  // The generic body's comparison is the runtime's because of its variable, which it notes.
  let same = match list_at(answers, 1) {
    Some(a) -> match a.answer { Body(b) -> b.tables.generics.needs, Refused(_) -> [] },
    None -> [],
  };
  assert_eq(same, [{ var: 0, layout: false }])
}

// A body names each constructor it builds or tests by name, so it reads the same whatever else the
// program's constructor table holds.
test "a body reads the same whatever else the program's constructor table holds" {
  let m = b"pub type Shape = | Dot | Line(Int)\nfn f(s: Shape) -> Int = match s { Dot -> 0, Line(n) -> n }\nfn g() -> Shape = Line(1)\n";
  let wanted = [b"m.f", b"m.g"];
  let alone = answers_of([b"m"], [m], [b"m.Dot", b"m.Line"], wanted);
  let beside = answers_of([b"m"], [m], [b"a.One", b"a.Two", b"m.Dot", b"m.Line"], wanted);
  assert_eq(alone, beside);
  assert(len(alone) == 2)
}

test "a module no wanted root is in, read as its stub under its rows, lowers what its text does" {
  let a = b"import b\nfn f(x: Int) -> Int = b::g(x) + 1\n";
  let b = b"pub fn g(x: Int) -> Int = x * 2\ntest \"doubles\" { assert(g(1) == 2) }\n";
  let parsed = parse_all([{ name: b"a", src: a }, { name: b"b", src: b }]);
  let d = dump_of(analyse(parsed));
  let stub = stub_module(b, at(parsed, 1).module);
  assert(bytes_index_of(stub, b"x * 2") == None);
  let call = |srcs: List<Bytes>|
    emit_roots_answer([b"a", b"b"], srcs, no_ctors(), [], [b"a.f"], [], [], [], d.rows, d.walked);
  assert_eq(call([a, stub]), call([a, b]))
}

/// A record update, a call that passes a witness, and operators at two types: every kind of site a
/// body's row files. `above` is written over `moved`, which moves it without touching its text.
fn sited(above: Bytes) -> List<Source> = sited_as(above, b"{ ..p, x: b::twice(p.x) + 1 }")

fn sited_as(above: Bytes, body: Bytes) -> List<Source> =
  [
    {
      name: b"a",
      src: bytes_concat_all([
        b"import b\ntype P = { x: Int, y: Int }\n",
        above,
        b"fn moved(p: P) -> P = ",
        body,
        b"\ntest \"moves\" { assert(moved({ x: 1, y: 2 }).x == 3) }\n",
      ]),
    },
    { name: b"b", src: b"pub fn twice<a>(x: a) -> a\n  where numeric(a)\n= x + x\n" },
  ]

fn sited_answers(sources: List<Source>, d: Dump) -> List<RootAnswer> / {abort.raise} =
  emit_roots_answer(
    map(sources, |s: Source| s.name),
    map(sources, |s: Source| s.src),
    no_ctors(),
    [],
    [b"a.moved", test_owner(b"a", b"moves"), b"b.twice"],
    [],
    [],
    [],
    d.rows,
    d.walked,
  )

test "a body is lowered from what its row files of it, walked now or published from the row" {
  let walked = dump_of(analyse(parse_all(sited(b""))));
  let filed = fold(walked.rows.defs, b"", |acc: Bytes, row: KnownDefRow|
    if row.name == b"a.moved" { row.facts } else { acc });
  match facts_at(filed, 0, 0, b"a.moved") {
    None -> panic("the row files what the walk read"),
    Some(f) -> {
      assert_eq(len(f.updates), 1);
      assert(len(f.refs) > 0);
      assert(len(f.operands) > 0)
    },
  };
  let seeded = analyse_with(parse_all(sited(b"")), walked.rows);
  match seeded {
    front::Refused(_) -> panic("the program checks"),
    front::Analysed(w) -> assert_eq(len(w.checked.seeded), 2),
  };
  assert_eq(sited_answers(sited(b""), dump_of(seeded)), sited_answers(sited(b""), walked))
}

fn seeded_with(sources: List<Source>, rows: Rows) -> front::AnalysisOutcome / {abort.raise} =
  analyse_pulling_std_with(sources, [], rows).out

test "a body published from its row is lowered where its definition moved to" {
  let before = dump_of(seeded_with(sited(b""), no_rows()));
  let after = sited(b"// a comment, and a definition, above it\nfn aside() -> Int = 7\n");
  let seeded = seeded_with(after, before.rows);
  match seeded {
    front::Refused(_) -> panic("the program checks"),
    front::Analysed(w) -> assert_eq(w.checked.seeded, [b"b.twice", b"a.moved"]),
  };
  assert_eq(
    sited_answers(after, dump_of(seeded)),
    sited_answers(after, dump_of(seeded_with(after, no_rows()))),
  )
}

test "a module's roots are lowered only from an answer that holds what its check read" {
  let sources = sited(b"");
  let d = dump_of(analyse(parse_all(sources)));
  let unread = { ..d, rows: { ..d.rows, defs: [] } };
  match at(sited_answers(sources, unread), 0).answer {
    Body(_) -> panic("a body with no row is not lowered from a guess"),
    Refused(r) -> assert(bytes_index_of(r.why, b"nothing its check read") != None),
  };
  match at(sited_answers(sources, { ..d, walked: b"" }), 0).answer {
    Body(_) -> panic("an answer with nothing read lowers nothing"),
    Refused(_) -> (),
  }
}

test "a wanted body is lowered though the answer holds nothing of a test beside it" {
  let sources = sited(b"");
  let d = dump_of(analyse(parse_all(sources)));
  // A module the front end read through its stub: its tests were never in the answer.
  let call = |wanted: List<Bytes>|
    at(
      emit_roots_answer(
        map(sources, |s: Source| s.name),
        map(sources, |s: Source| s.src),
        no_ctors(),
        [],
        wanted,
        [],
        [],
        [],
        { ..d.rows, tests: [] },
        d.walked,
      ),
      0,
    ).answer;
  match call([b"a.moved"]) { Body(_) -> (), Refused(r) -> panic(string_of_bytes_lossy(r.why)) };
  match call([test_owner(b"a", b"moves")]) {
    Body(_) -> panic("a test the answer holds nothing of is not lowered from a guess"),
    Refused(_) -> (),
  }
}

test "a root is in the module its owner is in" {
  assert_eq(module_of_root(b"app.cli.main"), b"app.cli");
  assert_eq(module_of_root(b"app.cli.main#requires#0"), b"app.cli");
  assert_eq(module_of_root(test_owner(b"app", b"a.b c")), b"app");
  assert_eq(module_of_root(law_root(b"app", b"x.y", b"body")), b"app");
  assert_eq(
    module_of_root(specialised_with(b"app.g", [], [{ param: 1, owner: b"lib.h", at: 7, nth: 0 }])),
    b"app",
  );
  assert_eq(module_of_root(b"main"), b"")
}

test "a buffer read out of a record this body holds alone reaches its append unshared" {
  let src = bytes_concat_all([
    b"type S = { out: Bytes, n: Int }\n",
    b"type T = | T(Bytes, Int)\n",
    b"fn pattern(s: S, fuel: Int) -> Bytes = { let { out, n } = s; if n <= 0 || fuel <= 0 { out } else { pattern({ out: out ++ b\"x\", n: n - 1 }, fuel - 1) } }\n",
    b"fn ctor(t: T, fuel: Int) -> Bytes = match t { T(out, n) -> if n <= 0 || fuel <= 0 { out } else { ctor(T(out ++ b\"x\", n - 1), fuel - 1) } }\n",
    b"fn update(s: S, fuel: Int) -> Bytes = if s.n <= 0 || fuel <= 0 { s.out } else { update({ ..s, out: s.out ++ b\"x\", n: s.n - 1 }, fuel - 1) }\n",
    b"fn fields(s: S, fuel: Int) -> Bytes = { let n = s.n; let out = s.out; if n <= 0 || fuel <= 0 { out } else { fields({ out: out ++ b\"x\", n: n - 1 }, fuel - 1) } }\n",
    b"fn iterated(n: Int) -> Bytes / {abort.raise} = iterate({ out: b\"\", n: n }, n + 1, |s: S| if s.n <= 0 { Stop(s.out) } else { Continue({ out: s.out ++ b\"x\", n: s.n - 1 }) })\n",
    b"fn folded(n: Int) -> Bytes = fold(range(0, n), { out: b\"\", n: 0 }, |s: S, _: Int| { out: s.out ++ b\"x\", n: s.n + 1 }).out\n",
    b"fn guarded(t: T, k: Int) -> Bytes = match t { T(out, n) if n > k -> out ++ b\"y\", T(out, _) -> out }\n",
    b"fn captured(s: S, n: Int) -> Int / {abort.raise} = iterate(0, n + 1, |i: Int| if i >= n { Stop(bytes_len(s.out) + s.n) } else { Continue(i + bytes_len(s.out)) })\n",
    b"fn caught(s: S, n: Int) -> Int = fold(range(0, n), 0, |acc: Int, _: Int| acc + bytes_len(s.out) + s.n)\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [b"Stop", b"Continue", b"m.T"],
    [b"range", b"fold", b"iterate", b"bytes_len"],
    true,
  );
  assert_eq(map(out, |e: Emitted| e.why), [None, None, None, None, None, None, None, None, None]);
  let text = |name: Bytes|
    match filter(out, |e: Emitted| e.name == name) { [e, ..] -> e.text, [] -> b"" };
  let before = |name: Bytes, first: Bytes, then: Bytes|
    match bytes_index_of(text(name), first) {
      None -> false,
      Some(a) -> match bytes_index_of(text(name), then) { None -> false, Some(b) -> a < b },
    };
  let takes = |name: Bytes| bytes_index_of(text(name), b"] = ply_unit; } else { ply_inc(") != None;
  // A pattern's subject is let go once its fields are bound, before the buffer is appended to, and
  // its cells are the token the record or constructor built after takes; one nothing took is
  // freed on the way out.
  assert(before(b"m.pattern", b"tok2 = rt_reset_p(ctx, t3); }", b"rt_concat_p("), None);
  assert(before(b"m.ctor", b"tok2 = rt_reset_p(ctx, t3); }", b"rt_concat_p("), None);
  assert(before(b"m.ctor", b"rt_concat_p(", b" = tok2; tok2 = 0;"), None);
  assert(before(b"m.ctor", b" = tok2; tok2 = 0;", b"if (tok2) ply_dec(ctx, tok2);"), None);
  // A field read before the record's last is taken from it where the record holds it alone.
  assert_eq(map([b"m.update", b"m.iterated", b"m.folded", b"m.fields"], takes), [
    true,
    true,
    true,
    false,
  ]);
  // A subject a guard reads again, and a record a fused loop reads on each pass, keep their fields.
  assert_eq(map([b"m.guarded", b"m.captured", b"m.caught"], takes), [false, false, false]);
  assert(bytes_index_of(text(b"m.guarded"), b"t2 = 0;") == None, None)
}

// A count taken again would not be a wrong answer but an object that cannot die.
test "a helper's answer handed to a helper is not counted again" {
  let out = emit_all_program(
    [{ name: b"m", src: b"fn wrap(n: Int) -> List<Bytes> / {abort.raise} = [byte_of_int(n)]\n" }],
    [],
    [b"byte_of_int"],
    true,
  );
  let text = match out { [e, ..] -> e.text, [] -> b"" };
  assert(
    bytes_index_of(text, b"builtin_byte_of_int_p") != None
      && bytes_index_of(text, b"rt_list_p") != None,
    Some(string_of_bytes_lossy(text)),
  );
  assert(bytes_index_of(text, b"ply_inc(") == None, Some(string_of_bytes_lossy(text)))
}

// The prologue unboxes an `Int`, a `Bool` or a fixed width into a local the loop reads instead, so the
// raw word is released once, on the way out, however often the body restarts.
test "a self tail call releases a parameter its prologue converted once, on the way out" {
  let src = bytes_concat_all([
    b"fn countdown(n: Int, k: Int) -> Int = if k <= 0 { n } else { countdown(n, k - 1) }\n",
    b"fn flip(b: Bool, k: Int) -> Bool = if k <= 0 { b } else { flip(b, k - 1) }\n",
    b"fn narrow(w: U32, k: Int) -> U32 = if k <= 0 { w } else { narrow(w, k - 1) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(map(out, |e: Emitted| e.why), [None, None, None]);
  assert_eq(map(out, |e: Emitted| len(bytes_split(e.text, b"ply_dec(ctx, p0)")) - 1), [1, 1, 1])
}

// At the body's tail nothing follows the update, so reading the accumulator twice does not keep it
// from being rebuilt in place.
test "an accumulator read more than once is still rebuilt in place at the body's tail" {
  let src = bytes_concat_all([
    b"type S = { i: Int, tag: Bytes }\n",
    b"fn narrow(s: S, x: Int) -> S = { ..s, i: x }\n",
    b"fn wide(s: S, x: Int) -> S = { ..s, i: s.i + x }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(map(out, |e: Emitted| e.why), [None, None]);
  let reuses = |e: Emitted|
    bytes_index_of(e.text, b"rt_reset_p(") != None || bytes_index_of(e.text, b"->rc == 1") != None;
  assert_eq(map(out, reuses), [true, true])
}

test "a branch lets go as it opens of a parameter only another branch reads, and of a field read out before it" {
  let src = bytes_concat_all([
    b"type S = { out: Bytes, n: Int }\n",
    b"fn whole(s: S) -> Int = s.n\n",
    b"fn slot(x: Bytes, c: Bool) -> Int = if c { bytes_len(x) } else { 0 }\n",
    b"fn field(s: S) -> Int = { let out = s.out; if s.n < 0 { whole(s) } else { bytes_len(out ++ b\"x\") + s.n } }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [b"bytes_len"], true);
  assert_eq(map(out, |e: Emitted| e.why), [None, None, None]);
  let text = |name: Bytes|
    match filter(out, |e: Emitted| e.name == name) { [e, ..] -> e.text, [] -> b"" };
  assert(bytes_index_of(text(b"m.slot"), b"} else {\n    ply_dec(ctx, p0); p0 = 0;") != None, None);
  let field = text(b"m.field");
  match bytes_index_of(field, b"if (ply_obj(p0)->rc == 1) { Word ") {
    None -> assert(false, Some(string_of_bytes(field))),
    Some(at) -> match bytes_index_of(field, b"rt_concat_p(") {
      None -> assert(false, None),
      Some(joined) -> assert(at < joined, None),
    },
  }
}

fn emit_all_program(
  sources: List<Source>,
  ctors: List<Bytes>,
  builtins: List<Bytes>,
  release: Bool,
) -> List<Emitted> / {abort.raise} =
  match analyse(parse_all(sources)) {
    front::Refused(diags) -> refused_rather_than_emitted(sources, None, said(diags)),
    front::Analysed(w) -> {
      let d = dump_of(front::Analysed(w));
      emit_program(
        sources,
        { names: ctors, laid: ctor_layouts(d.ctors) },
        builtins,
        release,
        None,
        [],
        [],
        d.embeds,
        d.rows,
        d.walked,
      )
    },
  }

/// What an arm that refuses a program before lowering anything can say: the checker's own words, one
/// per diagnostic. There is no renderer for a diagnostic on this side -- the driver's `explain` has
/// the prose -- so the code and the message are what a refusal carries.
fn said(diags: List<Diag>) -> Bytes =
  match diags {
    [] -> b"a program the emitter will not lower, and no diagnostic explains it",
    _ ->
      bytes_join(
        map(diags, |diag: Diag| bytes_concat_all([diag.code, b": ", diag.message])),
        b"; ",
      ),
  }

/// The same for the parser's diagnostics, which are a different record: a module that does not parse
/// has not reached the point where the other kind exist.
fn said_p(diags: List<ParseDiag>) -> Bytes =
  match diags {
    [] -> b"a module the emitter cannot parse, and no diagnostic explains it",
    _ ->
      bytes_join(
        map(diags, |diag: ParseDiag| bytes_concat_all([diag.code, b": ", diag.message])),
        b"; ",
      ),
  }

/// Every root the caller wanted, refused for the same reason. An arm that refuses a whole program has
/// no body to hang the reason on, and the answer's reader keys a refusal by root name, so the refusal
/// has to ride on the roots it was asked for. A caller that wanted everything names its sources
/// instead: those are the names it has.
fn refused_rather_than_emitted(
  sources: List<Source>,
  wanted: Option<Map<Bytes, Bool>>,
  why: Bytes,
) -> List<Emitted> =
  map(
    match wanted {
      Some(m) -> map_keys(m),
      None -> map(map(sources, |source: Source| source.name), |n: Bytes| n),
    },
    |n: Bytes| { name: n, text: b"", tables: no_tables(), why: Some(why), handles: [] },
  )

/// Resolved together first, so defaults are filled and derives expanded; a program that does not resolve emits nothing.
/// Every root is resolved against, but only those `wanted` names are emitted; `None` wants them all.
/// `pkgs` and `module_packages` are the program's package tables, empty for one without packages:
/// resolution then treats every module as one package's, which is what no packages means.
fn emit_program(
  sources: List<Source>,
  ctors: Ctors,
  builtins: List<Bytes>,
  release: Bool,
  wanted: Option<Map<Bytes, Bool>>,
  pkgs: List<PackageDeps>,
  module_packages: List<Int>,
  embeds: List<EmbedAt>,
  rows: Rows,
  walked: Bytes,
) -> List<Emitted> / {abort.raise} = {
  let tables = embed_tables(embeds);
  let parsed = map(range(0, len(sources)), |i: Int| {
    let s = match list_at(sources, i) { Some(x) -> x, None -> { name: b"", src: b"" } };
    let r = parse(s.src);
    let x = expand(r.node, r.parser.diags);
    let d = expand_derives(i, s.name, x.module);
    let e = rewritten(tables, s.name, d.module);
    {
      name: s.name,
      module: e.module,
      derived: d.derived,
      bad: len(r.parser.diags) > 0 || len(d.diags) > 0 || len(e.diags) > 0,
      // A module that does not parse is not also reported against what its recovery expanded to.
      why: if len(r.parser.diags) > 0 { said_p(r.parser.diags) }
      else if len(d.diags) > 0 { said(d.diags) }
      else { said_p(e.diags) },
    }
  });
  match fold(
      parsed,
      None,
      |acc: Option<Bytes>, p: { name: Bytes, module: Module, derived: List<Derived>, bad: Bool, why: Bytes }|
        match acc { Some(_) -> acc, None -> if p.bad { Some(p.why) } else { None } },
    ) {
    Some(why) -> refused_rather_than_emitted(sources, wanted, why),
    None -> {
      let mods0: List<ParsedModule> = map(
        parsed,
        |p: { name: Bytes, module: Module, derived: List<Derived>, bad: Bool, why: Bytes }|
          { name: p.name, module: p.module, derived: p.derived },
      );
      // The published table ends with the built-in packages; the shipped modules sit one past them.
      let packaged = if len(pkgs) == 0 { no_packages(mods0) } else {
        {
          pkgs: pkgs,
          module_packages: module_packages,
          std: len(pkgs) - 2,
          compiler: len(pkgs) - 1,
          shipped: len(pkgs),
        }
      };
      match resolve_packaged(
          mods0,
          packaged.pkgs,
          packaged.module_packages,
          packaged.std,
          packaged.compiler,
          packaged.shipped,
        ) {
        ResolveFailed(diags) -> refused_rather_than_emitted(sources, wanted, said(diags)),
        ResolveSucceeded(x) -> {
          // A specialisation is lowered from its definition's facts, and the lambdas it runs from
          // their owners'.
          let reading = match wanted {
            None -> None,
            Some(w) ->
              Some(
                map_fold(w, w, |acc: Map<Bytes, Bool>, root: Bytes, _: Bool|
                  fold(
                    match specialisation_of(root) { Some(s) -> s.fns, None -> [] },
                    map_insert(acc, own_definition(root), true),
                    |r: Map<Bytes, Bool>, f: FnArg| map_insert(r, f.owner, true),
                  )),
              ),
          };
          let lowered = lowered_modules(reading);
          match match walked_read(walked) {
              None ->
                Err(
                  b"the front end's answer carries nothing its check read, so nothing is lowered from it",
                ),
              Some(w) -> facts_read(rows, w, reading, x.mods),
            } {
            Err(why) -> refused_rather_than_emitted(sources, wanted, why),
            Ok(facts) -> {
              let pure = fold(facts.pure, map_new(), |acc: Map<Bytes, Bool>, n: Bytes|
                map_insert(acc, n, true));
              // The checker has the shape of every update, so the literals they stand for are written in here.
              let mods: List<ParsedModule> = expanded_mods(x.mods, facts.elaboration);
              let schemes = fold(
                rows.defs,
                map_new(),
                |acc: Map<Bytes, Scheme>, row: KnownDefRow| map_insert(acc, row.name, row.scheme),
              );
              let program = map(mods, |m: ParsedModule|
                { module: m.name, defs: defs_in(m.name, m.module, pure, schemes) });
              let stated = stated_by_tag(mods);
              let defs_of = |path: Bytes|
                fold(program, [], |acc: List<Def>, md: ModuleDefs|
                  if md.module == path { md.defs } else { acc });
              // A lambda a specialisation runs: read again where its owner, a plain definition, lowers it.
              let lambda_at = |owner: Bytes, start: Int, nth: Int| {
                let dot = fold(range(0, bytes_len(owner)), 0 - 1, |acc: Int, k: Int|
                  if bytes_at(owner, k) == 46 { k } else { acc });
                let module = bytes_slice(owner, 0, if dot < 0 { 0 } else { dot });
                let short = bytes_slice(owner, dot + 1, bytes_len(owner));
                match fold(range(0, len(mods)), None, |acc: Option<Int>, k: Int|
                    match acc {
                      Some(_) -> acc,
                      None -> if at(mods, k).name == module { Some(k) } else { None },
                    }) {
                  None -> None,
                  Some(i) -> {
                    let m = at(mods, i);
                    match fold(m.module.items, None, |acc: Option<FnDef>, item: Item|
                        match item {
                          IFn(d) -> if d.name.name == short { Some(d) } else { acc },
                          _ -> acc,
                        }) {
                      None -> None,
                      Some(d) -> match lower_to_emit(
                          map(d.params, |param: Param| param.name.name),
                          map(d.generics.labels, |ident: Ident| ident.name),
                          sites_in(facts.label_sites, i),
                          d.body,
                        ) {
                        None -> None,
                        Some(l) -> match list_at(written_at(lambdas_of(l.code), start), nth) {
                          None -> None,
                          Some(code) ->
                            Some({
                              owner: owner,
                              at: start,
                              nth: nth,
                              code: code,
                              module: m.name,
                              here: defs_in(m.name, m.module, pure, schemes),
                              imports: resolved_imports(x.r, i, mods, m.module, defs_of),
                              effects: effects_in(x.r, i, mods),
                              typed: typed_in(facts, i),
                              operands: operands_in(facts.operands, i),
                              base: d.span.start,
                            }),
                        },
                      },
                    }
                  },
                }
              };
              fold(range(0, len(mods)), [], |acc: List<Emitted>, i: Int|
                match list_at(mods, i) {
                  None -> acc,
                  Some(m) -> if !lowers(lowered, m.name) { acc } else {
                    fold(
                      emit_module(
                        m.name,
                        m.module,
                        ctors,
                        builtins,
                        program,
                        schemes,
                        pure,
                        effects_in(x.r, i, mods),
                        release,
                        wanted,
                        {
                          labels: sites_in(facts.label_sites, i),
                          operands: operands_in(facts.operands, i),
                          typed: typed_in(facts, i),
                          ops: filter(facts.elaboration.ops, |o: WitnessOp| o.module == i),
                        },
                        x.r,
                        i,
                        mods,
                        lambda_at,
                      ),
                      acc,
                      |a: List<Emitted>, e: Emitted| push(a, calling_instances(stated, e)),
                    )
                  },
                })
            },
          }
        },
      }
    },
  }
}

/// Each constructor whose type's module states a `key` or a `show`, with those functions under
/// their program-wide names.
fn stated_by_tag(mods: List<ParsedModule>) -> Map<Bytes, List<Bytes>> =
  fold(mods, map_new(), |acc: Map<Bytes, List<Bytes>>, m: ParsedModule|
    fold(m.module.items, acc, |a: Map<Bytes, List<Bytes>>, item: Item|
      match item {
        IInstance(d) -> stating(m, a, d.target.name, [d.by.name]),
        INumeric(d) -> stating(m, a, d.target.name, map(d.ops, |x: NumericOp| x.by.name)),
        _ -> a,
      }))

/// `stated` with `fns` of module `m` under each constructor of its type `target`.
fn stating(
  m: ParsedModule,
  stated: Map<Bytes, List<Bytes>>,
  target: Bytes,
  fns: List<Bytes>,
) -> Map<Bytes, List<Bytes>> =
  fold(m.module.items, stated, |b: Map<Bytes, List<Bytes>>, other: Item|
    match other {
      IType(t) -> if t.name.name != target { b } else {
        match t.body {
          TDSum(variants) ->
            fold(variants, b, |c: Map<Bytes, List<Bytes>>, v: VariantDef| {
              let tag = qualify(m.name, v.name.name);
              map_insert(
                c,
                tag,
                fold(
                  fns,
                  match map_get(c, tag) { Some(fs) -> fs, None -> [] },
                  |fs: List<Bytes>, f: Bytes| push(fs, qualify(m.name, f)),
                ),
              )
            }),
          _ -> b,
        }
      },
      _ -> b,
    })

/// The constructors a body's C names a tag of, as its placeholders spell them.
fn tags_named(text: Bytes) -> List<Bytes> / {abort.raise} =
  iterate({ from: 0, out: [] }, bytes_len(text) + 1, |s: { from: Int, out: List<Bytes> }|
    match bytes_index_of_from(text, b"@@", s.from) {
      None -> Stop(s.out),
      Some(open) -> match bytes_index_of_from(text, b"@@", open + 2) {
        None -> Stop(s.out),
        Some(close) ->
          Continue({
            from: close + 2,
            out: if bytes_at(text, open + 2) == 84 {
              push(s.out, bytes_slice(text, open + 3, close))
            } else { s.out },
          }),
      },
    })

/// A body that names a constructor's tag holds values the runtime reads through what the type's
/// module states of it, wherever they are compared or shown: so it calls those functions, which the
/// unit then takes with it and a kept answer is checked against.
fn calling_instances(stated: Map<Bytes, List<Bytes>>, e: Emitted) -> Emitted / {abort.raise} =
  if map_len(stated) == 0 { e } else {
    match e.why {
      Some(_) -> e,
      None ->
        {
          ..e,
          tables: {
            ..e.tables,
            calls: fold(tags_named(e.text), e.tables.calls, |acc: List<Bytes>, tag: Bytes|
              match map_get(stated, tag) {
                None -> acc,
                Some(fs) ->
                  fold(fs, acc, |calls: List<Bytes>, f: Bytes|
                    if contains(calls, f) { calls } else { push(calls, f) }),
              }),
          },
        },
    }
  }

/// One import's module as it is written and as it resolves: a dependency's sibling import is
/// written bare and means the module of the same package, which the scope's binders name.
fn resolved_path(
  resolved: Resolved,
  index: Int,
  mods: List<ParsedModule>,
  j: Int,
  written: Bytes,
) -> Bytes / {abort.raise} =
  match list_at(at(resolved.imports, index), j) { Some(t) -> at(mods, t).name, None -> written }

fn resolved_imports(
  resolved: Resolved,
  index: Int,
  mods: List<ParsedModule>,
  x_module: Module,
  defs_of: (Bytes) -> List<Def>,
) -> List<Imported> / {abort.raise} = {
  let written = fold(range(0, len(x_module.imports)), [], |acc: List<Imported>, j: Int| {
    let im = at(x_module.imports, j);
    let full = resolved_path(
      resolved,
      index,
      mods,
      j,
      bytes_join_dots(map(im.path, |i: Ident| i.name)),
    );
    match im.kind {
      INames(ns) ->
        fold(ns, acc, |a: List<Imported>, n: Ident|
          push(a, { name: n.name, module: full, defs: defs_of(full), whole: false })),
      IModule ->
        push(acc, { name: last_segment(im.path), module: full, defs: defs_of(full), whole: true }),
      IAlias(a2) -> push(acc, { name: a2.name, module: full, defs: defs_of(full), whole: true }),
    }
  });
  // A default copied into a call names its own module through a binder no import wrote.
  match list_at(resolved.scopes, index) {
    None -> written,
    Some(scope) ->
      fold(scope.modules, written, |acc: List<Imported>, mb: ModuleBinding|
        match module_import(acc, mb.binder) {
          Some(_) -> acc,
          None -> {
            let full = at(mods, mb.target).name;
            push(acc, { name: mb.binder, module: full, defs: defs_of(full), whole: true })
          },
        }),
  }
}

/// The labels each call in this module fills, keyed by the call's span, which the lowering reads.
fn sites_in(all: List<LabelSite>, module: Int) -> Map<Bytes, List<Bytes>> =
  fold(all, map_new(), |acc: Map<Bytes, List<Bytes>>, site: LabelSite|
    if site.module != module { acc } else { map_insert(acc, span_key(site.span), site.labels) })

/// Each operator's operand type in this module, by its span. A default argument is written in its
/// own module's positions, so two sites can share a span: where their types differ, neither is read.
fn operands_in(all: List<OperandSite>, module: Int) -> Map<Bytes, Bytes> =
  fold(all, map_new(), |acc: Map<Bytes, Bytes>, site: OperandSite|
    if site.module != module { acc } else {
      let key = span_key(site.span);
      match map_get(acc, key) {
        None -> map_insert(acc, key, site.ty),
        Some(t) -> if t == site.ty { acc } else { map_insert(acc, key, unsettled()) },
      }
    })

/// Never a type's name.
fn unsettled() -> Bytes = b"?"

/// A type the checker filed at a site, and the type arguments a use there is at.
pub type Typed = { ty: Type, args: List<Type> }

/// Each typed site in this module, by its span. A default argument is written in its own module's
/// positions, so two sites can share a span: where they differ, neither is read.
fn typed_in(facts: EmitFacts, module: Int) -> Map<Bytes, Typed> =
  fold(
    facts.typed,
    { sites: map_new(), read: map_new() },
    |acc: { sites: Map<Bytes, Typed>, read: Map<Bytes, Type> }, site: TypedSite|
      if site.module != module { acc } else {
        let own = type_at(facts.types, site.ty, acc.read);
        let args = fold(
          site.args,
          { tys: [], read: own.read },
          |a: { tys: List<Type>, read: Map<Bytes, Type> }, k: Bytes| {
            let t = type_at(facts.types, k, a.read);
            { tys: push(a.tys, t.ty), read: t.read }
          },
        );
        let key = span_key(site.span);
        let here = { ty: own.ty, args: args.tys };
        {
          sites: match map_get(acc.sites, key) {
            None -> map_insert(acc.sites, key, here),
            Some(t) -> if t == here { acc.sites }
            else { map_insert(acc.sites, key, { ty: TyVar(0 - 1), args: [] }) },
          },
          read: args.read,
        }
      },
  ).sites

/// What the front end's check read, or nothing when its answer carried none or one this program does
/// not read.
fn walked_read(walked: Bytes) -> Option<WalkedFacts> / {abort.raise} =
  if bytes_len(walked) == 0 { None }
  else { match bin::decode(walked, walked_facts_bin()) { Ok(w) -> Some(w), Err(_) -> None } }

/// What the checker filed of one module's sites, by span: each call's labels, each operator's
/// operand type, each typed site, and each operator done through a witness.
type SitesRead = {
  labels: Map<Bytes, List<Bytes>>,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
  ops: List<WitnessOp>,
}

fn emit_module(
  module: Bytes,
  x_module: Module,
  ctors: Ctors,
  builtins: List<Bytes>,
  program: List<ModuleDefs>,
  schemes: Map<Bytes, Scheme>,
  pure: Map<Bytes, Bool>,
  effects: List<EffectName>,
  release: Bool,
  wanted: Option<Map<Bytes, Bool>>,
  read: SitesRead,
  resolved: Resolved,
  index: Int,
  mods: List<ParsedModule>,
  lambda_at: (Bytes, Int, Int) -> Option<BoundLambda> / {abort.raise},
) -> List<Emitted> / {abort.raise} = {
  let sites = read.labels;
  let operands = read.operands;
  let typed = read.typed;
  let ops = read.ops;
  let x = { module: x_module };
  let defs_of = |path: Bytes|
    fold(program, [], |acc: List<Def>, md: ModuleDefs|
      if md.module == path { md.defs } else { acc });
  let imports = resolved_imports(resolved, index, mods, x_module, defs_of);
  let here = defs_in(module, x.module, pure, schemes);
  let fns = fold(x.module.items, [], |acc: List<Prepared>, item: Item|
    match item { IFn(d) -> push(acc, prepare(module, schemes, wanted, sites, d)), _ -> acc });
  let groups = tail_groups(module, here, fns);
  let walked = fold(x.module.items, { out: [], fns: 0 }, |acc: Walk, item: Item|
    match item {
      IFn(d) -> {
        let p = match list_at(fns, acc.fns) {
          Some(q) -> q,
          None -> prepare(module, schemes, wanted, sites, d),
        };
        let specialisations = fold(
          specialisations_wanted(wanted, p.full),
          acc.out,
          |a: List<Emitted>, sp: { args: List<Type>, fns: List<FnArg> }|
            push(
              a,
              specialised_emitted(
                module,
                d,
                sp.args,
                sp.fns,
                lambda_at,
                schemes,
                ops,
                sites,
                held_whole(here, tail_cycle(here, sites, x.module.items, d)),
                imports,
                ctors,
                builtins,
                effects,
                release,
                operands,
                typed,
              ),
            ),
        );
        let out = match group_of(groups, acc.fns) {
          None -> if !wants(wanted, p.full) { specialisations } else {
            push(
              specialisations,
              witnessed_needs(
                emitted_from(
                  module,
                  p.base,
                  here,
                  imports,
                  ctors,
                  builtins,
                  effects,
                  release,
                  operands,
                  typed,
                  p.full,
                  p.ps,
                  p.known,
                  p.body,
                  p.code,
                ),
                d,
                map_get(schemes, p.full),
                ops,
              ),
            )
          },
          // The group is emitted where its first member stands; the others are its cases.
          Some(g) -> if list_at(g, 0) != Some(acc.fns) { specialisations } else {
            fold(
              group_emitted(
                module,
                here,
                imports,
                ctors,
                builtins,
                effects,
                release,
                operands,
                typed,
                map(g, |i: Int| match list_at(fns, i) { Some(q) -> q, None -> p }),
              ),
              specialisations,
              |a: List<Emitted>, e: Emitted| push(a, e),
            )
          },
        };
        clause_roots(
          { out: out, fns: acc.fns + 1 },
          d,
          p.names,
          p.kinds,
          module,
          here,
          imports,
          ctors,
          builtins,
          effects,
          release,
          operands,
          typed,
          sig_of(schemes, qualify(module, d.name.name)),
          wanted,
          sites,
        )
      },
      // A test is a root named by its label: nullary, or over cases entered with a case's place
      // and identity beside a nullary root that lists them.
      ITest(t) -> {
        let full = test_owner(module, t.name);
        let ps = if t.cases == None { [] } else {
          [
            { name: case_at(), kind: KInt, ty: TyOpen([]), carrier: Whole(KBoxed), lambda: None },
            {
              name: case_identity(),
              kind: KBoxed,
              ty: TyBytes,
              carrier: Whole(KBoxed),
              lambda: None,
            },
          ]
        };
        let rooted = |name: Bytes, taken: List<EmitParam>, body: Expr|
          root_emitted(
            module,
            t.span.start,
            here,
            imports,
            ctors,
            builtins,
            effects,
            release,
            operands,
            typed,
            name,
            map(taken, |p: EmitParam| p.name),
            taken,
            true,
            sites,
            body,
          );
        let run = if !wants(wanted, full) { acc.out }
        else { push(acc.out, rooted(full, ps, test_run(t))) };
        let out = match t.cases {
          None -> run,
          Some(c) -> if !wants(wanted, cases_root(full)) { run }
          else { push(run, rooted(cases_root(full), [], test_listing(c))) },
        };
        { out: out, fns: acc.fns }
      },
      // A law's guard and body are roots the judge enters with the binders' values.
      ILaw(d) -> {
        let names = map(d.binders, |binder: Binder| binder.name.name);
        let kinds = map(d.binders, |binder: Binder| Some(typed_kind(typed, binder.name.span)));
        let ps = params_of(names, kinds);
        let known = fold(kinds, true, |acc2: Bool, k: Option<{ kind: Kind, ty: Ty }>|
          acc2 && k != None);
        let part = |which: Bytes| law_root(module, d.name, which);
        let with_guard = match d.guard {
          None -> acc.out,
          Some(g) -> if !wants(wanted, part(b"guard")) { acc.out } else {
            push(
              acc.out,
              root_emitted(
                module,
                d.span.start,
                here,
                imports,
                ctors,
                builtins,
                effects,
                release,
                operands,
                typed,
                part(b"guard"),
                names,
                ps,
                known,
                sites,
                g,
              ),
            )
          },
        };
        {
          out: if !wants(wanted, part(b"body")) { with_guard } else {
            push(
              with_guard,
              root_emitted(
                module,
                d.span.start,
                here,
                imports,
                ctors,
                builtins,
                effects,
                release,
                operands,
                typed,
                part(b"body"),
                names,
                ps,
                known,
                sites,
                d.body,
              ),
            )
          },
          fns: acc.fns,
        }
      },
      _ -> acc,
    });
  walked.out
}

/// `why` is the refusal's reason, and then `text` and `tables` are empty.
pub type Emitted = {
  name: Bytes,
  text: Bytes,
  tables: Tables,
  why: Option<Bytes>,
  handles: List<Bytes>,
}

type Walk = { out: List<Emitted>, fns: Int }

/// A definition lowered once, for grouping and for emission; `code` is `None` when it is not wanted or does not lower.
type Prepared = {
  full: Bytes,
  base: Int,
  names: List<Bytes>,
  kinds: List<Option<{ kind: Kind, ty: Ty }>>,
  ps: List<EmitParam>,
  known: Bool,
  body: Expr,
  code: Option<Code>,
}

/// A label parameter is a hidden trailing `Int`: the caller passes the resource's field-table entry.
fn prepare(
  module: Bytes,
  schemes: Map<Bytes, Scheme>,
  wanted: Option<Map<Bytes, Bool>>,
  sites: Map<Bytes, List<Bytes>>,
  def: FnDef,
) -> Prepared / {abort.raise} = {
  let names = map(def.params, |param: Param| param.name.name);
  let kinds = map(
    param_kinds(def, sig_of(schemes, qualify(module, def.name.name))),
    |k: { kind: Kind, ty: Ty }| Some(k),
  );
  let labels = map(def.generics.labels, |ident: Ident| ident.name);
  let all_names = fold(labels, names, |acc: List<Bytes>, n: Bytes| push(acc, n));
  let all_kinds = fold(labels, kinds, |acc: List<Option<{ kind: Kind, ty: Ty }>>, n: Bytes|
    push(acc, Some({ kind: KInt, ty: TyOpen([]) })));
  let known = fold(kinds, true, |acc: Bool, k: Option<{ kind: Kind, ty: Ty }>| acc && k != None);
  let full = qualify(module, def.name.name);
  {
    full: full,
    base: def.span.start,
    names: names,
    kinds: kinds,
    ps: params_carried(all_names, all_kinds, carriers_of(def, sig_of(schemes, full)).params),
    known: known,
    body: def.body,
    code: if known && wants(wanted, full) {
      match lower_to_emit(names, labels, sites, def.body) { Some(l) -> Some(l.code), None -> None }
    } else { None },
  }
}

/// The other definitions of the module whose tail calls lead from `def` round to it again, each
/// lowered as far as the walk reaches, wanted or not: the members of the loop `def` runs in.
fn tail_cycle(
  here: List<Def>,
  sites: Map<Bytes, List<Bytes>>,
  items: List<Item>,
  def: FnDef,
) -> List<Bytes> / {abort.raise} = {
  let fns = fold(items, map_new(), |acc: Map<Bytes, FnDef>, item: Item|
    match item { IFn(d) -> map_insert(acc, d.name.name, d), _ -> acc });
  let callees = |name: Bytes|
    match map_get(fns, name) {
      None -> [],
      Some(d) -> match lower_to_emit(
          map(d.params, |param: Param| param.name.name),
          map(d.generics.labels, |ident: Ident| ident.name),
          sites,
          d.body,
        ) {
        Some(l) -> tail_callees(here, l.code, []),
        None -> [],
      },
    };
  let own = def.name.name;
  let edges = iterate(
    { edges: map_new(), work: [own] },
    1000000,
    |s: { edges: Map<Bytes, List<Bytes>>, work: List<Bytes> }|
      match s.work {
        [] -> Stop(s),
        [n, ..rest] -> if map_contains(s.edges, n) { Continue({ ..s, work: rest }) } else {
          let out = callees(n);
          Continue({ edges: map_insert(s.edges, n, out), work: concat(rest, out) })
        },
      },
  ).edges;
  let back = iterate(
    map_insert(map_new(), own, true),
    map_len(edges) + 1,
    |seen: Map<Bytes, Bool>| {
      let more = map_fold(edges, seen, |acc: Map<Bytes, Bool>, n: Bytes, out: List<Bytes>|
        if map_contains(acc, n)
            || !fold(out, false, |b: Bool, m: Bytes| b || map_contains(acc, m)) { acc }
        else { map_insert(acc, n, true) });
      if map_len(more) == map_len(seen) { Stop(seen) } else { Continue(more) }
    },
  );
  filter(map_keys(back), |n: Bytes| n != own)
}

/// `here` with each definition named in `names` as a call reaches one that takes no type parameter:
/// as it stands, at no specialisation.
fn held_whole(here: List<Def>, names: List<Bytes>) -> List<Def> =
  if len(names) == 0 { here }
  else { map(here, |d: Def| if contains(names, d.name) { { ..d, scheme: None } } else { d }) }

/// The module's definitions in tail-call cycles of two or more, each cycle's members in module order: a call in tail
/// position of one member from another is an edge, so a group is exactly what can run as one loop. A member holding a
/// `handle` keeps the whole cycle out, and only wanted, lowered definitions have edges, so every member is emitted.
fn tail_groups(
  module: Bytes,
  here: List<Def>,
  fns: List<Prepared>,
) -> List<List<Int>> / {abort.raise} = {
  let fulls = map(fns, |p: Prepared| p.full);
  let adj = map(fns, |p: Prepared|
    match p.code {
      None -> [],
      Some(c) ->
        fold(tail_callees(here, c, []), [], |acc: List<Int>, nm: Bytes|
          match position_of(fulls, qualify(module, nm)) {
            None -> acc,
            Some(i) -> if fold(acc, false, |seen: Bool, j: Int| seen || j == i) { acc }
            else { push(acc, i) },
          }),
    });
  filter(map(graph::components({ out: adj }), |c: List<Int>| sorted_widths(c)), |c: List<Int>|
    len(c) >= 2 && fold(c, true, |ok: Bool, i: Int| ok && loops_as_case(fns, i)))
}

fn loops_as_case(fns: List<Prepared>, i: Int) -> Bool =
  match list_at(fns, i) {
    Some(p) -> match p.code { Some(code) -> !has_handle(code), None -> false },
    None -> false,
  }

fn group_of(groups: List<List<Int>>, i: Int) -> Option<List<Int>> =
  fold(groups, None, |acc: Option<List<Int>>, g: List<Int>|
    if fold(g, false, |seen: Bool, j: Int| seen || j == i) { Some(g) } else { acc })

/// The same-module definitions called in tail position, walking the positions `tail` is kept into.
fn tail_callees(here: List<Def>, code: Code, acc: List<Bytes>) -> List<Bytes> / {abort.raise} =
  match code.node {
    NApp(a) -> match a.func.node {
      NVar(fv) -> if fv.slot == None && !is_ctor_name(fv.name)
          && fold(here, false, |ok: Bool, h: Def|
            ok || (h.name == fv.name && h.arity == len(a.args))) { push(acc, fv.name) }
      else { acc },
      _ -> acc,
    },
    NBinary(b) -> if b.op == b"and" || b.op == b"or" { tail_callees(here, b.rhs, acc) }
    else { acc },
    NIf(i) -> tail_callees(here, i.else_branch, tail_callees(here, i.then_branch, acc)),
    NBlock(b) -> match b.tail { Some(t) -> tail_callees(here, t, acc), None -> acc },
    NMatch(m) -> fold(m.arms, acc, |a: List<Bytes>, arm: CodeArm| tail_callees(here, arm.body, a)),
    _ -> acc,
  }

/// The lambdas `c` writes, at any depth, each before those its body writes, in one fixed order.
fn lambdas_of(c: Code) -> List<Lambda> = {
  let within = |codes: List<Code>|
    fold(codes, [], |acc: List<Lambda>, x: Code| concat(acc, lambdas_of(x)));
  match c.node {
    NLambda(l) -> concat([l], lambdas_of(l.body)),
    NUnary(u) -> lambdas_of(u.operand),
    NBinary(b) -> within([b.lhs, b.rhs]),
    NField(f) -> lambdas_of(f.base),
    NApp(a) -> within(push(a.args, a.func)),
    NIf(i) -> within([i.cond, i.then_branch, i.else_branch]),
    NBlock(b) ->
      within(
        fold(
          b.stmts,
          match b.tail { Some(t) -> [t], None -> [] },
          |acc: List<Code>, stmt: CodeStmt|
            push(acc, match stmt { CLet(l) -> l.value, CLetPat(l) -> l.value, CDo(d) -> d.code }),
        ),
      ),
    NList(l) -> within(l.items),
    NRecord(r) -> within(map(r.fields, |f: CodeField| f.value)),
    NUpdate(u) -> within(push(map(u.sets, |f: CodeField| f.value), u.base)),
    NMatch(m) ->
      within(
        fold(m.arms, [m.scrutinee], |acc: List<Code>, a: CodeArm|
          push(match a.guard { Some(g) -> push(acc, g), None -> acc }, a.body)),
      ),
    NPerform(x) -> within(x.args),
    NCell(x) -> within([x.init, x.body]),
    NSimulate(x) -> lambdas_of(x.body),
    NInlined(x) -> within(push(x.args, x.func)),
    NParallel(x) -> within(x.branches),
    NHandle(h) ->
      within(
        fold(
          h.clauses,
          match h.ret { Some(r) -> [h.body, r.body], None -> [h.body] },
          |acc: List<Code>, cl: CodeClause| push(acc, cl.body),
        ),
      ),
    _ -> [],
  }
}

/// The lambdas of `ls` written at byte `at`, in their order.
fn written_at(ls: List<Lambda>, at: Int) -> List<Lambda> = filter(ls, |l: Lambda| l.at.start == at)

/// Where `l` first stands in `ls`.
fn position_in(ls: List<Lambda>, l: Lambda) -> Option<Int> =
  fold(range(0, len(ls)), None, |acc: Option<Int>, k: Int|
    match acc { Some(_) -> acc, None -> if list_at(ls, k) == Some(l) { Some(k) } else { None } })

fn has_handle(c: Code) -> Bool = {
  let within = |codes: List<Code>| fold(codes, false, |acc: Bool, x: Code| acc || has_handle(x));
  match c.node {
    NHandle(_) -> true,
    NUnary(u) -> has_handle(u.operand),
    NBinary(b) -> within([b.lhs, b.rhs]),
    NField(f) -> has_handle(f.base),
    NApp(a) -> within(push(a.args, a.func)),
    NIf(i) -> within([i.cond, i.then_branch, i.else_branch]),
    NBlock(b) ->
      (match b.tail { Some(t) -> has_handle(t), None -> false })
        || fold(b.stmts, false, |acc: Bool, stmt: CodeStmt|
          acc
            || (match stmt {
              CLet(l) -> has_handle(l.value),
              CLetPat(l) -> has_handle(l.value),
              CDo(d) -> has_handle(d.code),
            })),
    NList(l) -> within(l.items),
    NRecord(r) -> within(map(r.fields, |f: CodeField| f.value)),
    NUpdate(u) -> within(push(map(u.sets, |f: CodeField| f.value), u.base)),
    NMatch(m) ->
      has_handle(m.scrutinee)
        || fold(m.arms, false, |acc: Bool, a: CodeArm|
          acc || (match a.guard { Some(g) -> has_handle(g), None -> false }) || has_handle(a.body)),
    NPerform(p) -> within(p.args),
    NCell(c2) -> within([c2.init, c2.body]),
    NLambda(l) -> has_handle(l.body),
    NSimulate(x) -> has_handle(x.body),
    NInlined(x) -> within(push(x.args, x.func)) || has_handle(x.lambda.body),
    NParallel(pr) -> within(pr.branches),
    _ -> false,
  }
}

/// A group's one body under its first member's name, or, when a member does not emit, each member on its own.
fn group_emitted(
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  ctors: Ctors,
  builtins: List<Bytes>,
  effects: List<EffectName>,
  release: Bool,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
  members: List<Prepared>,
) -> List<Emitted> / {abort.raise} = {
  let ms = fold(members, [], |acc: List<Member>, p: Prepared|
    match p.code {
      Some(c) -> push(acc, { full: p.full, base: p.base, params: p.ps, body: c }),
      None -> acc,
    });
  let first = match list_at(members, 0) { Some(p) -> p.full, None -> b"" };
  let whole = if len(ms) == len(members) {
    emit_group_full(module, here, imports, ctors, builtins, ms, effects, release, operands, typed)
  } else { None };
  match whole {
    Some(c) -> [{ name: first, text: c.text, tables: c.tables, why: None, handles: [] }],
    None ->
      map(members, |p: Prepared|
        emitted_from(
          module,
          p.base,
          here,
          imports,
          ctors,
          builtins,
          effects,
          release,
          operands,
          typed,
          p.full,
          p.ps,
          p.known,
          p.body,
          p.code,
        )),
  }
}

fn params_of(names: List<Bytes>, kinds: List<Option<{ kind: Kind, ty: Ty }>>) -> List<EmitParam> =
  params_carried(names, kinds, [])

/// `params_of` with each parameter arriving as `carriers` says, and as a word past its end.
fn params_carried(
  names: List<Bytes>,
  kinds: List<Option<{ kind: Kind, ty: Ty }>>,
  carriers: List<Carrier>,
) -> List<EmitParam> =
  map(range(0, len(names)), |i: Int|
    {
      name: match list_at(names, i) { Some(n) -> n, None -> b"" },
      kind: match list_at(carriers, i) {
        Some(Whole(KMaybe)) -> KMaybe,
        _ -> match list_at(kinds, i) { Some(Some(p)) -> p.kind, _ -> KInt },
      },
      ty: match list_at(kinds, i) { Some(Some(p)) -> p.ty, _ -> TyOpen([]) },
      carrier: match list_at(carriers, i) { Some(c) -> c, None -> Whole(KBoxed) },
      lambda: None,
    })

/// One root's emission, definition, test or proposition alike. An unlowered body's handled operations are read off its source, so the fixpoint still drops their performers.
fn root_emitted(
  module: Bytes,
  base: Int,
  here: List<Def>,
  imports: List<Imported>,
  ctors: Ctors,
  builtins: List<Bytes>,
  effects: List<EffectName>,
  release: Bool,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
  full: Bytes,
  names: List<Bytes>,
  ps: List<EmitParam>,
  known: Bool,
  sites: Map<Bytes, List<Bytes>>,
  body: Expr,
) -> Emitted / {abort.raise} =
  emitted_from(
    module,
    base,
    here,
    imports,
    ctors,
    builtins,
    effects,
    release,
    operands,
    typed,
    full,
    ps,
    known,
    body,
    if known {
      match lower_to_emit(names, [], sites, body) { Some(l) -> Some(l.code), None -> None }
    } else { None },
  )

fn emitted_from(
  module: Bytes,
  base: Int,
  here: List<Def>,
  imports: List<Imported>,
  ctors: Ctors,
  builtins: List<Bytes>,
  effects: List<EffectName>,
  release: Bool,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
  full: Bytes,
  ps: List<EmitParam>,
  known: Bool,
  body: Expr,
  code: Option<Code>,
) -> Emitted / {abort.raise} =
  match code {
    None ->
      {
        name: full,
        text: b"",
        tables: no_tables(),
        handles: ast_handles(body, effects),
        why: Some(if known { b"a body the lowering does not reach" }
        else { b"a parameter with no written type" }),
      },
    Some(c) -> match emit_fn_full(
        module,
        base,
        here,
        imports,
        ctors,
        builtins,
        full,
        ps,
        c,
        effects,
        release,
        operands,
        typed,
      ) {
      None ->
        {
          name: full,
          text: b"",
          tables: no_tables(),
          handles: walk_handles(c, effects),
          why: emit_fn_why(
            module,
            base,
            here,
            imports,
            ctors,
            builtins,
            full,
            ps,
            c,
            effects,
            release,
            operands,
            typed,
          ),
        },
      Some(o) -> { name: full, text: o.text, tables: o.tables, why: None, handles: [] },
    },
  }

/// `requires` and `ensures` clauses as roots: `<owner>#requires#<k>`, `<owner>#ensures#<k>`.
fn clause_roots(
  acc: Walk,
  def: FnDef,
  names: List<Bytes>,
  kinds: List<Option<{ kind: Kind, ty: Ty }>>,
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  ctors: Ctors,
  builtins: List<Bytes>,
  effects: List<EffectName>,
  release: Bool,
  operands: Map<Bytes, Bytes>,
  typed: Map<Bytes, Typed>,
  sig: Option<Sig>,
  wanted: Option<Map<Bytes, Bool>>,
  sites: Map<Bytes, List<Bytes>>,
) -> Walk / {abort.raise} = {
  let known = fold(kinds, true, |acc2: Bool, k: Option<{ kind: Kind, ty: Ty }>| acc2 && k != None);
  let clause = |kind: Bytes, k: Int|
    qualify(module, bytes_concat_all([def.name.name, b"#", kind, b"#", ascii_of_int(k)]));
  let walked = fold(
    def.spec,
    { out: acc.out, requires: 0, ensures: 0 },
    |s: { out: List<Emitted>, requires: Int, ensures: Int }, c: SpecClause|
      match c.kind {
        SRequires -> {
          let full = clause(b"requires", s.requires);
          {
            out: if !wants(wanted, full) { s.out } else {
              push(
                s.out,
                root_emitted(
                  module,
                  def.span.start,
                  here,
                  imports,
                  ctors,
                  builtins,
                  effects,
                  release,
                  operands,
                  typed,
                  full,
                  names,
                  params_of(names, kinds),
                  known,
                  sites,
                  c.expr,
                ),
              )
            },
            requires: s.requires + 1,
            ensures: s.ensures,
          }
        },
        SEnsures -> match def.ret {
          None -> { out: s.out, requires: s.requires, ensures: s.ensures + 1 },
          Some(r) -> {
            let full = clause(b"ensures", s.ensures);
            let rnames = push(names, b"result");
            let rkinds = push(
              kinds,
              Some(match sig { Some(s) -> kind_of(s.ret), None -> boxed() }),
            );
            let rknown = known;
            {
              out: if !wants(wanted, full) { s.out } else {
                push(
                  s.out,
                  root_emitted(
                    module,
                    def.span.start,
                    here,
                    imports,
                    ctors,
                    builtins,
                    effects,
                    release,
                    operands,
                    typed,
                    full,
                    rnames,
                    params_of(rnames, rkinds),
                    rknown,
                    sites,
                    c.expr,
                  ),
                )
              },
              requires: s.requires,
              ensures: s.ensures + 1,
            }
          },
        },
        // A bound is read off the body, and never run.
        SCost -> s,
        SSpace -> s,
      },
  );
  { out: walked.out, fns: acc.fns }
}

fn concat_effects(a: List<EffectName>, b: List<EffectName>) -> List<EffectName> =
  fold(b, a, |acc: List<EffectName>, x: EffectName| push(acc, x))

/// The effect a clause names, program-wide: one a `try` wrote, the scope's, or the prelude's.
fn handled_effect(effects: List<EffectName>, written: Bytes) -> Option<Bytes> / {abort.raise} =
  match named_program_wide(written) {
    Some(global) -> Some(global),
    None ->
      fold(
        concat_effects(effects, prelude_effects_here()),
        None,
        |f: Option<Bytes>, en: EffectName| if en.written == written { Some(en.global) } else { f },
      ),
  }

/// The operations a body handles, read off its source, so a body the lowering did not reach still names them.
fn ast_handles(e: Expr, effects: List<EffectName>) -> List<Bytes> / {abort.raise} = {
  let here = |acc: List<Bytes>, x: Expr| concat(acc, ast_handles(x, effects));
  let all = |exprs: List<Expr>| fold(exprs, [], here);
  match e {
    EHandle(h) -> {
      let inner = fold(
        h.clauses,
        ast_handles(h.body, effects),
        |acc: List<Bytes>, clause: HandleClause|
          concat(
            match handled_effect(effects, qname_text(clause.eff)) {
              Some(g) -> push(acc, bytes_concat_all([g, b"#", clause.op.name])),
              None -> acc,
            },
            ast_handles(clause.body, effects),
          ),
      );
      match h.ret { Some(r) -> here(inner, r.body), None -> inner }
    },
    ESimulate(x) -> concat(scheduled_ops(), ast_handles(x.body, effects)),
    EUnary(x) -> ast_handles(x.operand, effects),
    EBinary(x) -> all([x.lhs, x.rhs]),
    ELambda(x) -> ast_handles(x.body, effects),
    EApp(x) -> here(all(x.args), x.func),
    EIf(x) -> all([x.cond, x.then_branch, x.else_branch]),
    EMatch(x) ->
      fold(x.arms, ast_handles(x.scrutinee, effects), |acc: List<Bytes>, arm: MatchArm|
        here(match arm.guard { Some(g) -> here(acc, g), None -> acc }, arm.body)),
    EBlock(x) -> {
      let stmts = fold(x.stmts, [], |acc: List<Bytes>, stmt: Stmt|
        match stmt {
          SLet(l) -> here(acc, l.value),
          SLetElse(l) -> here(here(acc, l.value), l.fallback),
          SExpr(v) -> here(acc, v),
        });
      match x.tail { Some(t) -> here(stmts, t), None -> stmts }
    },
    ERecord(x) -> all(map(x.fields, |f: RecField| f.value)),
    ERecordUpdate(x) -> here(all(map(x.fields, |f: RecField| f.value)), x.base),
    ETry(x) -> ast_handles(x.operand, effects),
    EField(x) -> ast_handles(x.base, effects),
    EList(x) -> all(x.items),
    EPerform(x) -> all(x.args),
    EWithCell(x) -> all([x.init, x.body]),
    EWithHold(x) -> all([x.acquire, x.release, x.body]),
    ETryBlock(x) -> ast_handles(x.body, effects),
    _ -> [],
  }
}

fn walk_handles(c: Code, effects: List<EffectName>) -> List<Bytes> / {abort.raise} = {
  let here = |acc: List<Bytes>, x: Code| concat(acc, walk_handles(x, effects));
  match c.node {
    NHandle(h) ->
      fold(h.clauses, walk_handles(h.body, effects), |acc: List<Bytes>, clause: CodeClause|
        concat(
          match handled_effect(effects, clause.effect) {
            Some(g) -> push(acc, bytes_concat_all([g, b"#", clause.op])),
            None -> acc,
          },
          walk_handles(clause.body, effects),
        )),
    NUnary(u) -> walk_handles(u.operand, effects),
    NBinary(b) -> here(walk_handles(b.lhs, effects), b.rhs),
    NField(f) -> walk_handles(f.base, effects),
    NApp(a) -> fold(a.args, walk_handles(a.func, effects), here),
    NInlined(x) -> fold(x.args, walk_handles(x.func, effects), here),
    NIf(i) -> here(here(walk_handles(i.cond, effects), i.then_branch), i.else_branch),
    NBlock(b) -> {
      let stmts = fold(b.stmts, [], |acc: List<Bytes>, stmt: CodeStmt|
        match stmt {
          CLet(l) -> here(acc, l.value),
          CLetPat(l) -> here(acc, l.value),
          CDo(d) -> here(acc, d.code),
        });
      match b.tail { Some(t) -> here(stmts, t), None -> stmts }
    },
    NList(l) -> fold(l.items, [], here),
    NRecord(r) -> fold(r.fields, [], |acc: List<Bytes>, f: CodeField| here(acc, f.value)),
    NUpdate(u) ->
      fold(u.sets, walk_handles(u.base, effects), |acc: List<Bytes>, f: CodeField|
        here(acc, f.value)),
    NMatch(m) ->
      fold(m.arms, walk_handles(m.scrutinee, effects), |acc: List<Bytes>, a: CodeArm|
        here(match a.guard { Some(g) -> here(acc, g), None -> acc }, a.body)),
    NPerform(p) -> fold(p.args, [], here),
    NCell(c2) -> here(walk_handles(c2.init, effects), c2.body),
    NLambda(l) -> walk_handles(l.body, effects),
    NSimulate(x) -> concat(scheduled_ops(), walk_handles(x.body, effects)),
    NParallel(pr) -> fold(pr.branches, [], here),
    _ -> [],
  }
}

/// A body's C and the tables it names, or why it was refused and the operations it would have
/// handled, which a refusal still names so the fixpoint drops their performers.
pub type Answer =
  | Body({ text: Bytes, tables: Tables })
  | Refused({ why: Bytes, handles: List<Bytes> })

pub type RootAnswer = { name: Bytes, answer: Answer }

derive bin for Const
derive bin for Head
derive bin for Defined
derive bin for Expect
derive bin for Pass
derive bin for FnArg
derive bin for GenericCall
derive bin for Need
derive bin for Generics
derive bin for Tables
derive bin for Answer

/// The roots `wanted` names, resolved against the whole program: one entry per root emitted or
/// refused, in its order, so the driver can drop what was refused. `embeds` is what the front end's
/// answer says it embedded, `rows` what it published for every definition and test, which spare a
/// walk of every module no wanted root is in, and `walked` what its check read of the modules it
/// walked whole, which spares a walk of those too.
pub fn emit_roots_answer(
  names: List<Bytes>,
  srcs: List<Bytes>,
  ctors: Ctors,
  builtins: List<Bytes>,
  wanted: List<Bytes>,
  pkgs: List<PackageDeps>,
  module_packages: List<Int>,
  embeds: List<EmbedAt>,
  rows: Rows,
  walked: Bytes,
) -> List<RootAnswer> / {abort.raise} =
  map(
    emit_program(
      zip_sources(names, srcs),
      ctors,
      builtins,
      true,
      Some(fold(wanted, map_new(), |acc: Map<Bytes, Bool>, n: Bytes| map_insert(acc, n, true))),
      pkgs,
      module_packages,
      embeds,
      rows,
      walked,
    ),
    answer_of,
  )

fn answer_of(e: Emitted) -> RootAnswer =
  {
    name: e.name,
    answer: match e.why {
      Some(w) -> Refused({ why: w, handles: e.handles }),
      None -> Body({ text: e.text, tables: e.tables }),
    },
  }

fn zip_sources(names: List<Bytes>, srcs: List<Bytes>) -> List<Source> =
  map(range(0, len(names)), |i: Int|
    {
      name: match list_at(names, i) { Some(n) -> n, None -> b"" },
      src: match list_at(srcs, i) { Some(t) -> t, None -> b"" },
    })

/// The C symbol a full name becomes: the name cut on its dots and its `#`s, each piece written as
/// its bytes, a mode byte (`_` after a dot, `h` after a `#`, `x` and `y` for the same two with the
/// bytes in hex, which a piece holding a byte no C identifier carries takes) and their length.
/// Bytes lead, so symbols collate as their names do and a definition added to a program leaves the
/// code-table ranks before it alone. Every symbol ends in a length behind its mode byte, which
/// nothing suffixed (`_entry`, `_lambda0`, `_group`) and nothing the runtime names (`ply_bind`)
/// does, so no two names spell one symbol and no suffixed symbol is a name's own.
pub fn symbol_of(full: Bytes) -> Bytes / {abort.raise} =
  bytes_concat(b"ply_", mangled(full, 0, 0, 46, b""))

/// The symbol the loader binds a definition by, which is also its memo slot.
pub fn entry_of(full: Bytes) -> Bytes / {abort.raise} = bytes_concat(symbol_of(full), b"_entry")

/// `start` opens the piece being scanned and `delim` is the byte that opened it.
fn mangled(name: Bytes, start: Int, at: Int, delim: Int, acc: Bytes) -> Bytes / {abort.raise} =
  if at >= bytes_len(name) { bytes_concat(acc, mangled_part(bytes_slice(name, start, at), delim)) }
  else if bytes_at(name, at) == 46 || bytes_at(name, at) == 35 {
    mangled(
      name,
      at + 1,
      at + 1,
      bytes_at(name, at),
      bytes_concat(acc, mangled_part(bytes_slice(name, start, at), delim)),
    )
  } else { mangled(name, start, at + 1, delim, acc) }

fn mangled_part(part: Bytes, delim: Int) -> Bytes / {abort.raise} =
  if c_ident_bytes(part, 0) {
    bytes_concat_all([part, if delim == 35 { b"h" } else { b"_" }, ascii_of_int(bytes_len(part))])
  } else if bytes_len(part) > 48 {
    // A C compiler may cut a long symbol short, so a long part is its digest.
    let digest = hex(bytes_slice(bytes_blake3(part), 0, 16));
    bytes_concat_all([digest, if delim == 35 { b"w" } else { b"z" }, ascii_of_int(bytes_len(part))])
  } else {
    let hexed = hex(part);
    bytes_concat_all([hexed, if delim == 35 { b"y" } else { b"x" }, ascii_of_int(bytes_len(hexed))])
  }

fn c_ident_bytes(part: Bytes, i: Int) -> Bool / {abort.raise} =
  if i >= bytes_len(part) { true }
  else if c_ident_byte(bytes_at(part, i)) { c_ident_bytes(part, i + 1) }
  else { false }

fn c_ident_byte(c: Int) -> Bool =
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95

fn bytes_join_dots(xs: List<Bytes>) -> Bytes =
  fold(range(0, len(xs)), b"", |acc: Bytes, i: Int|
    bytes_concat_all([
      acc,
      if i == 0 { b"" } else { b"." },
      match list_at(xs, i) { Some(x) -> x, None -> b"" },
    ]))

test "a module imported whole under a builtin's name leaves a bare call the builtin's" {
  let emitted = emit_all_program(
    [
      { name: b"map", src: b"pub fn size(xs: List<Int>) -> Int = len(xs)\n" },
      {
        name: b"b",
        src: b"import map\nfn doubled(xs: List<Int>) -> List<Int> = map(xs, |x: Int| x * 2)\nfn n(xs: List<Int>) -> Int = map::size(xs)\n",
      },
    ],
    [],
    [b"map", b"len"],
    true,
  );
  assert_eq(map(emitted, |e: Emitted| e.why), [None, None, None]);
  let calls = |full: Bytes|
    map(emitted, |e: Emitted| bytes_index_of(e.text, symbol_of(full)) != None);
  assert_eq(calls(b"map.map"), [false, false, false]);
  assert_eq(calls(b"map.size"), [true, false, true])
}

test "a builtin is called through the helper named for it, and an import that takes its name is called instead" {
  let own = emit_all_program(
    [
      {
        name: b"m",
        src: b"fn longer(xs: List<Int>) -> List<Int> = push(xs, 1)\nfn head(b: Bytes) -> Bytes / {abort.raise} = bytes_slice(b, 0, 1)\n",
      },
    ],
    [],
    [b"push", b"bytes_slice"],
    true,
  );
  assert_eq(map(own, |e: Emitted| e.why), [None, None]);
  let has = |text: Bytes| map(own, |e: Emitted| bytes_index_of(e.text, text) != None);
  assert_eq(has(b"builtin_push_p(ctx, "), [true, false]);
  assert_eq(has(b"builtin_bytes_slice_p(ctx, "), [false, true]);
  assert_eq(builtin_helper(b"?numeric_binary"), b"builtin_elaborated_numeric_binary");
  let imported = emit_all_program(
    [
      { name: b"a", src: b"pub fn push(xs: List<Int>, x: Int) -> List<Int> = xs\n" },
      {
        name: b"b",
        src: b"import a (push)\nfn longer(xs: List<Int>) -> List<Int> = push(xs, 1)\n",
      },
    ],
    [],
    [b"push"],
    true,
  );
  assert_eq(map(imported, |e: Emitted| e.why), [None, None]);
  assert_eq(map(imported, |e: Emitted| bytes_index_of(e.text, b"builtin_push_p") != None), [
    false,
    false,
  ])
}

// A value is compared and shown wherever it is read, by the runtime and not by a call a body
// makes: the body that names its constructor is what answers for the functions being there.
test "a body that names a constructor calls the key and the show its type states" {
  let rest = b"fn area(b: Box) -> Int = match b { Box(w, h) -> w * h }\nfn text(b: Box) -> String = \"box\"\nfn make() -> Box = Box(1, 2)\nfn same<a>(x: a, y: a) -> Bool = x == y\n";
  let plain = bytes_concat(b"pub type Box = | Box(Int, Int)\n", rest);
  let stating = bytes_concat(
    b"pub type Box = | Box(Int, Int)\nkey for Box by area\nshow for Box by text\n",
    rest,
  );
  let wanted = [b"m.area", b"m.text", b"m.make", b"m.same"];
  let calls = |src: Bytes|
    map(answers_of([b"m"], [src], [b"m.Box"], wanted), |a: RootAnswer|
      {
        name: a.name,
        calls: match a.answer { Body(b) -> b.tables.calls, Refused(_) -> [b"refused"] },
      });
  assert_eq(calls(stating), [
    // The key names the tag it takes its value apart by, and so itself.
    { name: b"m.area", calls: [b"m.area", b"m.text"] },
    { name: b"m.text", calls: [] },
    { name: b"m.make", calls: [b"m.area", b"m.text"] },
    { name: b"m.same", calls: [] },
  ]);
  assert_eq(map(calls(plain), |c: { name: Bytes, calls: List<Bytes> }| c.calls), [[], [], [], []])
}
