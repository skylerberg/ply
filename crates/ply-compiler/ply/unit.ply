//! A unit: the bodies the emitter answered, closed under calls and placed as one translation unit
//! that says what it holds, so the runtime loads it without reading a source. The runtime's own C
//! and its helper table are the runtime's to say, and are handed in.

import hash (hex)
import emit (Answer, Body, Refused, RootAnswer, Tables, Const, ConstStr, ConstBytes, ConstFixed,
             ConstWide, ConstFloat, ConstDecimal, ConstChar, ConstUnit, Defined, answer_bin,
             tables_bin, emit_roots_answer, module_of_root, symbol_of, entry_of, no_tables)
import front (Dump, EmitterRoot, EmitterCtor, KeyRow, ModuleRow, OrdinalRow, analyse, dump_of)
import diagnostics (parse_all)
import infer (dump_flag)
import interface (read_key, sized, stubbed)
import embed (EmbedAt)
import resolve (PackageDeps, Diag, Label, error_with_labels)
import std.bin
import std.list (sort_by, take, at, concat)
import std.graph
import std.bytes (hex_of, u32_at, u64_le, hex_digit, ascii_of_int)
import std.fs (fs)
import std.hash (blake3)
import std.random (entropy)
import std.time (time)
import parsing (no_module)

// --- What crosses the seam ----------------------------------------------------

/// A helper the runtime binds by position: its arguments past the context, and whether it answers.
pub type Helper = { name: Bytes, args: Int, answers: Bool }

/// The runtime a unit is compiled against: the C every unit opens with, through the runtime's
/// declarations, and closes with, its definitions; the helpers those bind by position; the builtins
/// a body may call; and the digest of the runtime's sources and helper table.
pub type Runtime = {
  head: Bytes,
  tail: Bytes,
  helpers: List<Helper>,
  builtins: List<Bytes>,
  identity: Bytes,
}

/// What this binary ships, a function of the binary alone: its shipped modules, its version,
/// what its store's groups are a function of, and the runtime a unit is compiled against.
pub effect shipped {
  read names() -> List<String>
  read module(name: String) -> Option<Bytes>
  /// What a load read of the shipped modules it pulled, for whatever observes the run: a test's
  /// pass then stands on the functions its program reached rather than on the whole modules.
  /// `pulled` is whether the load read them itself, rather than re-analysing one that did.
  read reached(view: Bytes, pulled: Bool) -> Unit
  read version() -> String
  read stamps() -> String
  read runtime() -> Runtime
  /// Each definition of this binary's own program, the one its launcher entered (the builder's own
  /// where a builder asks), and the hash its front end gave it, a `name hash` line each: a hash
  /// covers all its definition reaches.
  read definitions() -> Bytes
  /// Each builtin the runtime implements, how many words a call to it passes, and whether a failure
  /// of it raises rather than ending the run.
  read builtins() -> List<{ name: Bytes, arity: Int, raises: Bool }>
  /// A program as this binary's launcher enters it: the entry it runs, its front end's answer over
  /// every source that answer's indices run over, in their order, and the C of its unit.
  read runnable(entry: String, files: List<{ path: String, name: String, text: Bytes }>, dump: Dump, unit: Bytes) -> Bytes
}

/// The hash `definitions` holds for a definition of the compiler's, `name` as the compiler's own
/// program names it: a program that ships the compiler names it under `compiler.`.
pub fn definition_hash(definitions: Bytes, name: Bytes) -> Option<Bytes> / {abort.raise} = {
  let held = |full: Bytes| {
    let line = bytes_concat(full, b" ");
    let found = if bytes_starts_with(definitions, line) { Some(0) } else {
      match bytes_index_of(definitions, bytes_concat(b"\n", line)) {
        Some(i) -> Some(i + 1),
        None -> None,
      }
    };
    match found {
      None -> None,
      Some(i) -> {
        let from = i + bytes_len(line);
        // A hash is sixty-four digits, so its line ends within this many bytes.
        let most = if from + 65 > bytes_len(definitions) { bytes_len(definitions) }
        else { from + 65 };
        let rest = bytes_slice(definitions, from, most);
        Some(
          bytes_slice(rest, 0, match bytes_index_of_byte(rest, 10) {
            Some(end) -> end,
            None -> bytes_len(rest),
          }),
        )
      },
    }
  };
  match held(bytes_concat(b"compiler.", name)) { Some(h) -> Some(h), None -> held(name) }
}

/// What the answers `roots` compute are a function of on the program's side: each root's hash,
/// which covers all the root reaches and nothing else of the program. A root the program does not
/// hold was renamed without the list that names it.
pub fn identity_of(definitions: Bytes, roots: List<Bytes>) -> Bytes / {abort.raise} =
  hex(
    blake3(
      bytes_concat_all(
        map(roots, |root: Bytes|
          match definition_hash(definitions, root) {
            Some(h) -> bytes_concat_all([root, b" ", h, b"\n"]),
            None ->
              panic(
                "this binary's program holds no definition `" ++ string_of_bytes_lossy(root)
                  ++ "`, which a kept answer is filed under",
              ),
          }),
      ),
    ),
  )

/// The definitions an emitter's answer is a function of besides the root it answers for: the one
/// that asks the emitter, and the one that makes the front end's answer it is asked over.
pub fn emitter_roots() -> List<Bytes> = [b"unit.emitter_answers", b"front.dump_of"]

pub fn emitter_identity(definitions: Bytes) -> Bytes / {abort.raise} =
  identity_of(definitions, emitter_roots())

/// The definitions a unit is a function of besides the program it is of: the emitter's, and the ones
/// that produce a unit over its answers and hold it to what was offered.
pub fn unit_roots() -> List<Bytes> = [b"unit.emitted", b"unit.held", b"front.dump_of"]

/// The definitions a program's analysis and its unit are a function of besides its sources.
pub fn compiler_roots() -> List<Bytes> = push(unit_roots(), b"front.analyse_pulling_std_with")

/// What a program's runnable is a function of besides its text: the definition it enters, whose
/// hash covers all that reaches and nothing else of the program, the runtime its unit is compiled
/// against, and the compiler that made it.
pub fn program_key(entry: Bytes, runtime: Runtime, definitions: Bytes) -> Bytes / {abort.raise} =
  hex(
    blake3(
      bytes_concat_all([
        b"ply.program.1\0",
        entry,
        runtime.identity,
        b"\0",
        identity_of(definitions, compiler_roots()),
      ]),
    ),
  )

/// Where a builder keeps each program it built under `program_key`, below the stages.
pub fn programs_kept() -> String = "programs"

fn kept_path(dir: String, key: Bytes) -> String / {abort.raise} =
  if dir == "" || dir == "." { string_of_bytes(key) } else { dir ++ "/" ++ string_of_bytes(key) }

/// An answer kept between runs under `dir`. A read is a use, which keeps it from the toolchain's
/// sweep.
pub fn read_kept<[r]>(
  dir: String,
  key: Bytes,
) -> Option<Bytes> / {fs.read[r], fs.write[r], time.now_ms, abort.raise} = {
  let path = kept_path(dir, key);
  match fs.read_file[r](path) {
    None -> None,
    Some(bytes) -> {
      fs.set_modified[r](path, time.now_ms());
      Some(bytes)
    },
  }
}

/// Written beside itself and renamed into place, so a reader finds a whole answer or none. An answer
/// that cannot be written is left unwritten.
pub fn write_kept<[r]>(
  dir: String,
  key: Bytes,
  bytes: Bytes,
) -> Unit / {fs.write[r], entropy.next, time.now_ms, abort.raise} = {
  let path = kept_path(dir, key);
  let nonce = bytes_slice(
    blake3(bytes_concat(u64_le(entropy.next()), u64_le(time.now_ms()))),
    0,
    8,
  );
  let temp = path ++ "." ++ hex_of(nonce) ++ ".tmp";
  if fs.create_dir[r](if dir == "" { "." } else { dir }) && fs.write_file[r](temp, bytes) {
    if !fs.rename[r](temp, path) {
      fs.remove[r](temp);
      ()
    }
  }
}

/// A root a unit is offered: its arity, and whether it is pure and takes nothing, which the unit
/// gives a memo slot.
pub type Offered = { name: Bytes, arity: Int, constant: Bool }

pub type Ctor = { name: Bytes, arity: Int }

/// A constructor whose type's module states what its values are compared and shown through, and the
/// function of each.
pub type Stated = { ctor: Bytes, key: Option<Bytes>, show: Option<Bytes>, numeric: List<Bytes> }

/// What the fixpoint dropped and why: the emitter refused it, or it calls `missing`, which the unit
/// does not take.
pub type Dropped = { function: Bytes, construct: Bytes, missing: Option<Bytes> }

/// What a unit's C was made of: its bodies, before the unit placed them, and its roots as they were
/// offered, which decide how the unit places each.
pub type Made = { bodies: List<UnitBody>, offered: List<Offered> }

/// A unit's C, the roots it takes, what it dropped, in the order it dropped them, and what it was
/// made of.
pub type Produced = { text: Bytes, taken: List<Bytes>, dropped: List<Dropped>, made: Made }

/// A unit produced over answers an earlier run kept and answers the emitter gave now: how many of
/// the offered roots each covered.
pub type Emission = { produced: Produced, kept: Int, asked: Int }

/// Each root's answer, a group's one body answering for every member.
pub fn answers_of(rows: List<RootAnswer>) -> Map<Bytes, Answer> =
  fold(rows, map_new(), |acc: Map<Bytes, Answer>, r: RootAnswer|
    match r.answer {
      Body(b) -> if len(b.tables.members) == 0 { map_insert(acc, r.name, r.answer) } else {
        fold(b.tables.members, acc, |into: Map<Bytes, Answer>, m: Bytes|
          map_insert(into, m, r.answer))
      },
      Refused(_) -> map_insert(acc, r.name, r.answer),
    })

// --- Order --------------------------------------------------------------------

/// Ascending by byte, each once.
fn ordered(xs: List<Bytes>) -> List<Bytes> =
  map_keys(fold(xs, map_new(), |acc: Map<Bytes, Bool>, x: Bytes| map_insert(acc, x, true)))

/// A shape's names joined by a byte below every name's, so shapes sort as their name lists do.
fn shape_key(names: List<Bytes>) -> Bytes / {abort.raise} =
  fold(range(0, len(names)), b"", |acc: Bytes, i: Int|
    if i == 0 { at(names, i) } else { bytes_concat_all([acc, b"\x00", at(names, i)]) })

fn positions(keys: List<Bytes>) -> Map<Bytes, Int> / {abort.raise} =
  fold(range(0, len(keys)), map_new(), |acc: Map<Bytes, Int>, i: Int|
    map_insert(acc, at(keys, i), i))

// --- The fixpoint ---------------------------------------------------------------

/// A body the unit holds once: a group's under its first member.
pub type UnitBody = { name: Bytes, text: Bytes, tables: Tables }

type Round = { bodies: List<UnitBody>, symbols: Map<Bytes, Defined>, out: List<Dropped> }

type Settled = {
  taken: List<Bytes>,
  bodies: List<UnitBody>,
  symbols: Map<Bytes, Defined>,
  dropped: List<Dropped>,
}

fn refused_one(name: Bytes, why: Bytes) -> Dropped =
  { function: name, construct: why, missing: None }

fn lost(name: Bytes, callee: Bytes) -> Dropped =
  {
    function: name,
    construct: bytes_concat_all([b"`", callee, b"`, which is not in this compiled unit"]),
    missing: Some(callee),
  }

/// The C a body publishes for `name`: its place among the members, or the body's one definition.
fn defines(name: Bytes, tables: Tables) -> Defined / {abort.raise} = {
  let found = fold(range(0, len(tables.members)), 0 - 1, |acc: Int, i: Int|
    if acc < 0 && at(tables.members, i) == name { i } else { acc });
  match list_at(tables.symbols, if found < 0 { 0 } else { found }) {
    Some(d) -> d,
    None -> panic("an emitted body publishes the C it defines"),
  }
}

fn first_missing(calls: List<Bytes>, taken: Map<Bytes, Bool>) -> Option<Bytes> =
  fold(calls, None, |acc: Option<Bytes>, c: Bytes|
    match acc { Some(_) -> acc, None -> if map_contains(taken, c) { None } else { Some(c) } })

fn heads_its_group(name: Bytes, tables: Tables) -> Bool / {abort.raise} =
  len(tables.members) == 0 || at(tables.members, 0) == name

fn round_over(answers: Map<Bytes, Answer>, taken: List<Bytes>) -> Round / {abort.raise} = {
  let set = fold(taken, map_new(), |acc: Map<Bytes, Bool>, n: Bytes| map_insert(acc, n, true));
  fold(taken, { bodies: [], symbols: map_new(), out: [] }, |r: Round, name: Bytes|
    match map_get(answers, name) {
      None -> { ..r, out: push(r.out, refused_one(name, b"which the Ply emitter did not answer")) },
      Some(Refused(why)) -> { ..r, out: push(r.out, refused_one(name, why.why)) },
      Some(Body(b)) -> match first_missing(b.tables.calls, set) {
        Some(callee) -> { ..r, out: push(r.out, lost(name, callee)) },
        None ->
          {
            bodies: if heads_its_group(name, b.tables) {
              push(r.bodies, { name: name, text: b.text, tables: b.tables })
            } else { r.bodies },
            symbols: map_insert(r.symbols, name, defines(name, b.tables)),
            out: r.out,
          },
      },
    })
}

/// Dropping a body can drop its callers, so rounds repeat until one drops nothing; what a round
/// drops it took, so each round takes fewer, and the bodies taken bound the rounds.
fn settle(
  answers: Map<Bytes, Answer>,
  taken: List<Bytes>,
  dropped: List<Dropped>,
) -> Settled / {abort.raise} =
  iterate(
    { taken: taken, dropped: dropped },
    len(taken) + 1,
    |s: { taken: List<Bytes>, dropped: List<Dropped> }| {
      let r = round_over(answers, s.taken);
      if len(r.out) == 0 {
        Stop({ taken: s.taken, bodies: r.bodies, symbols: r.symbols, dropped: s.dropped })
      } else {
        let gone = fold(r.out, map_new(), |acc: Map<Bytes, Bool>, d: Dropped|
          map_insert(acc, d.function, true));
        Continue({
          taken: filter(s.taken, |n: Bytes| !map_contains(gone, n)),
          dropped: concat(s.dropped, r.out),
        })
      }
    },
  )

/// The dropped bodies that are errors, given what was `offered`. A body dropped because a callee was
/// never offered is the offer's doing, as is anything that lost a callee to such a body; every other
/// drop is a definition the program reaches and cannot run.
pub fn fatal(offered: List<Bytes>, dropped: List<Dropped>) -> List<Dropped> / {abort.raise} = {
  let asked = fold(offered, map_new(), |acc: Map<Bytes, Bool>, n: Bytes| map_insert(acc, n, true));
  let narrowed = iterate(map_new(), len(dropped) + 1, |nar: Map<Bytes, Bool>| {
    let grew = filter(dropped, |d: Dropped|
      !map_contains(nar, d.function)
        && (match d.missing {
          None -> false,
          Some(m) -> !map_contains(asked, m) || map_contains(nar, m),
        }));
    if len(grew) == 0 { Stop(nar) } else {
      Continue(
        fold(grew, nar, |acc: Map<Bytes, Bool>, d: Dropped| map_insert(acc, d.function, true)),
      )
    }
  });
  filter(dropped, |d: Dropped| !map_contains(narrowed, d.function))
}

// --- Constants ------------------------------------------------------------------

/// An `Int`'s 64 bits as sixteen hex digits, its sign bit included.
fn hex16(n: Int) -> Bytes / {abort.raise} =
  bytes_concat_all(map(range(0, 16), |i: Int| hex_digit(n >>> 60 - 4 * i & 15)))

/// `n`'s two's-complement pattern at 128 bits, as a cast to `u128` widens it.
fn wide_of(n: Int) -> U128 / {abort.raise} =
  if n >= 0 { u128_of_int(n) } else { ~u128_of_int(0 - (n + 1)) }

/// The low 64 bits of `n`, as an unsigned word.
fn word_of(n: Int) -> U128 / {abort.raise} = wide_of(n) & wrap_sub(1u128 << 64, 1u128)

fn width_bits(w: Int) -> Int =
  if w == 0 || w == 4 { 8 }
  else if w == 1 || w == 5 { 16 }
  else if w == 2 || w == 6 { 32 }
  else if w == 3 || w == 7 { 64 }
  else { 128 }

fn width_signed(w: Int) -> Bool = (w >= 4 && w <= 7) || w == 9

/// Truncated to the width, then zero- or sign-extended: every fixed-width value is held so.
fn normalized(w: Int, bits: U128) -> U128 = {
  let n = width_bits(w);
  if n == 128 { bits } else {
    let low = bits & ~0u128 >>> 128 - n;
    if width_signed(w) && low >>> n - 1 == 1u128 { low | ~0u128 << n } else { low }
  }
}

fn fixed_line(w: Int, bits: U128) -> Bytes =
  bytes_concat_all([
    b"f ",
    ascii_of_int(w),
    b" ",
    bytes_of_string(u128_to_string(normalized(w, bits))),
  ])

fn without(s: Bytes, byte: Int) -> Bytes / {abort.raise} =
  bytes_concat_all(
    map(range(0, bytes_len(s)), |i: Int|
      if bytes_at(s, i) == byte { b"" } else { bytes_slice(s, i, i + 1) }),
  )

fn float_line(literal: Bytes) -> Bytes / {abort.raise} =
  match float_of_string(string_of_bytes(without(literal, 95))) {
    Some(x) -> bytes_concat(b"x ", hex16(bits_of_float(x))),
    None -> panic("the emitter wrote a float literal that does not read"),
  }

fn trimmed_m(s: Bytes) -> Bytes / {abort.raise} =
  iterate(s, bytes_len(s) + 1, |t: Bytes|
    if bytes_len(t) > 0 && bytes_at(t, bytes_len(t) - 1) == 109 {
      Continue(bytes_slice(t, 0, bytes_len(t) - 1))
    } else { Stop(t) })

/// A decimal as its mantissa and scale, read off the text that keeps its scale.
fn decimal_line(literal: Bytes) -> Bytes / {abort.raise} =
  match decimal_of_string(string_of_bytes(trimmed_m(without(literal, 95)))) {
    None -> panic("the emitter wrote a decimal literal that does not read"),
    Some(d) -> {
      let text = bytes_of_string(decimal_to_string(d));
      let negative = bytes_len(text) > 0 && bytes_at(text, 0) == 45;
      let body = if negative { bytes_slice(text, 1, bytes_len(text)) } else { text };
      let point = match bytes_index_of(body, b".") { Some(i) -> i, None -> bytes_len(body) };
      let digits = without(body, 46);
      let lead = iterate(0, bytes_len(digits) + 1, |i: Int|
        if i < bytes_len(digits) - 1 && bytes_at(digits, i) == 48 { Continue(i + 1) }
        else { Stop(i) });
      let mantissa = bytes_slice(digits, lead, bytes_len(digits));
      let signed = if negative && mantissa != b"0" { bytes_concat(b"-", mantissa) }
      else { mantissa };
      bytes_concat_all([
        b"d ",
        signed,
        b" ",
        ascii_of_int(if point < bytes_len(body) { bytes_len(body) - point - 1 } else { 0 }),
      ])
    },
  }

/// One pooled constant's line: its identity, which the pool sorts and deduplicates by, and what the
/// runtime reads it back from.
pub fn const_line(c: Const) -> Bytes / {abort.raise} =
  match c {
    ConstUnit -> b"u",
    ConstStr(s) -> bytes_concat(b"s ", hex(s)),
    ConstBytes(b) -> bytes_concat(b"b ", hex(b)),
    ConstFixed(f) -> fixed_line(f.width, wide_of(f.bits)),
    ConstWide(x) -> fixed_line(x.width, word_of(x.high) << 64 | word_of(x.low)),
    ConstChar(v) -> bytes_concat(b"c ", ascii_of_int(v)),
    ConstFloat(x) -> float_line(x),
    ConstDecimal(x) -> decimal_line(x),
  }

// --- The unit's tables ------------------------------------------------------------

/// What a unit names that is not code, each table sorted by content and each entry once, so a
/// position is a rank among what the unit holds and a body's C is a function of the unit's content.
type Pools = {
  consts: List<Bytes>,
  fields: List<Bytes>,
  builtins: List<Bytes>,
  shapes: List<List<Bytes>>,
  lambdas: List<Bytes>,
}

fn entry_fields() -> List<Bytes> = [b"key", b"value"]

/// `lines` is each unit body's constants as `const_line` writes them, in its table's order.
fn pools_of(
  bodies: List<UnitBody>,
  lines: List<List<Bytes>>,
  constant_entries: List<Bytes>,
) -> Pools / {abort.raise} = {
  let ts = map(bodies, |k: UnitBody| k.tables);
  let all = |pick: (Tables) -> List<Bytes>|
    fold(ts, [], |acc: List<Bytes>, tables: Tables| concat(acc, pick(tables)));
  let shapes = fold(
    ts,
    map_insert(map_new(), shape_key(entry_fields()), entry_fields()),
    |acc: Map<Bytes, List<Bytes>>, tables: Tables|
      fold(tables.shapes, acc, |into: Map<Bytes, List<Bytes>>, names: List<Bytes>| {
        let s = ordered(names);
        map_insert(into, shape_key(s), s)
      }),
  );
  {
    consts: ordered(fold(lines, [], |acc: List<Bytes>, ls: List<Bytes>| concat(acc, ls))),
    fields: ordered(all(|tables: Tables| tables.fields)),
    builtins: ordered(all(|tables: Tables| tables.builtins)),
    shapes: map_values(shapes),
    lambdas: ordered(concat(constant_entries, all(|tables: Tables| tables.lambdas))),
  }
}

type Placed = {
  consts: Map<Bytes, Int>,
  fields: Map<Bytes, Int>,
  builtins: Map<Bytes, Int>,
  shapes: Map<Bytes, Int>,
  lambdas: Map<Bytes, Int>,
}

fn placed_of(p: Pools) -> Placed / {abort.raise} =
  {
    consts: positions(p.consts),
    fields: positions(p.fields),
    builtins: positions(p.builtins),
    shapes: positions(map(p.shapes, shape_key)),
    lambdas: positions(p.lambdas),
  }

fn place(m: Map<Bytes, Int>, key: Bytes) -> Int / {abort.raise} =
  match map_get(m, key) {
    Some(i) -> i,
    None -> panic("the unit's tables hold everything its bodies name"),
  }

// --- Sites ----------------------------------------------------------------------

/// The id a body's failure sites name their root by: a digest of its name, so a body's C does not
/// depend on which other roots the unit holds. Non-negative, since the C stores it in an `int64_t`.
pub fn root_id(name: Bytes) -> Int / {abort.raise} = {
  let h = blake3(name);
  let low = match u32_at(h, 0) { Some(v) -> v, None -> 0 };
  let high = match u32_at(h, 4) { Some(v) -> v, None -> 0 };
  high << 31 | low >>> 1
}

/// The bucket a body compiles in: the top bits of its root id, so it is a function of the name
/// alone and an edit recompiles the one bucket holding the body.
pub fn bucket_of(name: Bytes) -> Int / {abort.raise} = root_id(name) >>> 57

fn bucket_mark(id: Int) -> Bytes / {abort.raise} =
  bytes_concat_all([b"/* --- bucket ", hex_digit(id / 16), hex_digit(id % 16), b" --- */"])

fn digits_of(b: Bytes) -> Int / {abort.raise} =
  fold(range(0, bytes_len(b)), 0, |acc: Int, i: Int| acc * 10 + bytes_at(b, i) - 48)

/// A placeholder in a body's C, `@@kN@@`: where it opens and closes, its kind byte, and what
/// follows the kind.
type Hole = { open: Int, close: Int, kind: Int, digits: Bytes }

fn holes(text: Bytes) -> List<Hole> / {abort.raise} =
  iterate({ from: 0, out: [] }, bytes_len(text) + 1, |s: { from: Int, out: List<Hole> }|
    match bytes_index_of_from(text, b"@@", s.from) {
      None -> Stop(s.out),
      Some(open) -> match bytes_index_of_from(text, b"@@", open + 2) {
        None -> panic("an emitted placeholder always closes"),
        Some(close) ->
          Continue({
            from: close + 2,
            out: push(s.out, {
              open: open,
              close: close,
              kind: bytes_at(text, open + 2),
              digits: bytes_slice(text, open + 3, close),
            }),
          }),
      },
    })

/// What a placeholder names in the unit's tables, its kind leading so a bucket's table sorts by
/// kind; `None` for a root, written as its id. `lines` is the body's constants as the pool holds them.
fn hole_key(h: Hole, tables: Tables, lines: List<Bytes>) -> Option<Bytes> / {abort.raise} =
  if h.kind == 84 { Some(bytes_concat(b"T", h.digits)) }
  else if h.kind == 114 { None } else {
    let i = digits_of(h.digits);
    if h.kind == 99 { Some(bytes_concat(b"c", at(lines, i))) }
    else if h.kind == 98 { Some(bytes_concat(b"b", at(tables.builtins, i))) }
    else if h.kind == 102 { Some(bytes_concat(b"f", at(tables.fields, i))) }
    else if h.kind == 115 { Some(bytes_concat(b"s", shape_key(ordered(at(tables.shapes, i))))) }
    else if h.kind == 108 { Some(bytes_concat(b"l", at(tables.lambdas, i))) }
    else { panic("an emitted placeholder of no kind the unit resolves") }
  }

/// A key's position in the unit's table of its kind, which is what the loader writes for it.
fn unit_place(key: Bytes, p: Placed, tags: Map<Bytes, Int>) -> Int / {abort.raise} = {
  let kind = bytes_at(key, 0);
  let rest = bytes_slice(key, 1, bytes_len(key));
  if kind == 84 { place(tags, rest) }
  else if kind == 99 { place(p.consts, rest) }
  else if kind == 98 { place(p.builtins, rest) }
  else if kind == 102 { place(p.fields, rest) }
  else if kind == 115 { place(p.shapes, rest) }
  else { place(p.lambdas, rest) }
}

/// The table a bucket's C reads the unit's positions from, which the loader fills.
fn bucket_table(id: Int) -> Bytes / {abort.raise} =
  bytes_concat_all([b"ply_bk_", hex_digit(id / 16), hex_digit(id % 16)])

/// A body's C with each placeholder written as its bucket names it: a root as its id, and the rest
/// as a position in the bucket's own table, so the C reads the same whatever else the unit holds.
fn resolved(
  text: Bytes,
  hs: List<Hole>,
  keys: List<Option<Bytes>>,
  tables: Tables,
  name: Bytes,
  table: Bytes,
  local: Map<Bytes, Int>,
) -> Bytes / {abort.raise} = {
  let walked = fold(
    range(0, len(hs)),
    { from: 0, out: [] },
    |s: { from: Int, out: List<Bytes> }, i: Int| {
      let h = at(hs, i);
      let value = match at(keys, i) {
        None ->
          ascii_of_int(if bytes_len(h.digits) == 0 { root_id(name) }
          else { root_id(at(tables.members, digits_of(h.digits))) }),
        Some(k) -> bytes_concat_all([table, b"[", ascii_of_int(place(local, k)), b"]"]),
      };
      { from: h.close + 2, out: push(push(s.out, bytes_slice(text, s.from, h.open)), value) }
    },
  );
  bytes_concat_all(push(walked.out, bytes_slice(text, walked.from, bytes_len(text))))
}

// --- What the unit says about itself ---------------------------------------------

type Taken = { name: Bytes, arity: Int, symbol: Bytes, entry: Bytes }

fn counted(label: Bytes, n: Int) -> Bytes = bytes_concat_all([label, b" ", ascii_of_int(n), b"\n"])

fn lines(label: Bytes, xs: List<Bytes>) -> Bytes =
  bytes_concat_all(concat([counted(label, len(xs))], map(xs, |x: Bytes| bytes_concat(x, b"\n"))))

/// Each bucket's table as the loader fills it: the unit's position for each of the bucket's keys.
type BucketRow = { id: Int, places: List<Int> }

fn exports_text(
  helpers: List<Helper>,
  ctors: List<Ctor>,
  taken: List<Taken>,
  constants: List<Bytes>,
  modules: Int,
  dropped: List<Dropped>,
  p: Pools,
  buckets: List<BucketRow>,
  stated: List<Stated>,
) -> Bytes / {abort.raise} = {
  let held = fold(taken, map_new(), |acc: Map<Bytes, Bool>, t: Taken|
    map_insert(acc, t.name, true));
  // `-` where the type states none, and `!` for a function the unit does not take, which a value
  // read through it there is refused by.
  let written = |f: Option<Bytes>|
    match f { None -> b"-", Some(name) -> if map_contains(held, name) { name } else { b"!" } };
  bytes_concat_all([
    lines(
      b"helpers",
      map(helpers, |h: Helper|
        bytes_concat_all([h.name, b" ", ascii_of_int(h.args), b" ", dump_flag(h.answers)])),
    ),
    lines(b"ctors", map(ctors, |c: Ctor| bytes_concat_all([c.name, b" ", ascii_of_int(c.arity)]))),
    lines(
      b"taken",
      map(taken, |t: Taken|
        bytes_concat_all([t.name, b" ", ascii_of_int(t.arity), b" ", t.symbol, b" ", t.entry])),
    ),
    lines(b"constants", constants),
    counted(b"modules", modules),
    counted(b"refused", len(dropped)),
    bytes_concat_all(
      map(dropped, |d: Dropped| bytes_concat_all([d.function, b"\n", d.construct, b"\n"])),
    ),
    lines(b"consts", p.consts),
    lines(b"builtins", p.builtins),
    lines(b"fields", p.fields),
    lines(
      b"shapes",
      map(p.shapes, |names: List<Bytes>|
        fold(range(0, len(names)), b"", |acc: Bytes, i: Int|
          if i == 0 { at(names, i) } else { bytes_concat_all([acc, b" ", at(names, i)]) })),
    ),
    lines(b"lambdas", p.lambdas),
    lines(
      b"buckets",
      map(buckets, |r: BucketRow|
        bytes_concat_all(
          fold(r.places, [ascii_of_int(r.id)], |acc: List<Bytes>, n: Int|
            push(push(acc, b" "), ascii_of_int(n))),
        )),
    ),
    // Only a unit one of whose types states either says so, so any other reads as it always did.
    if len(stated) == 0 { b"" } else {
      lines(
        b"instances",
        map(stated, |x: Stated|
          fold(
            x.numeric,
            bytes_concat_all([x.ctor, b" ", written(x.key), b" ", written(x.show)]),
            |row: Bytes, f: Bytes| bytes_concat_all([row, b" ", written(Some(f))]),
          )),
      )
    },
  ])
}

fn octal(b: Int) -> Bytes =
  bytes_concat_all([b"\\", ascii_of_int(b / 64), ascii_of_int(b / 8 % 8), ascii_of_int(b % 8)])

/// The bytes a C string literal holds as they are: the printable ones but for the quote, the
/// backslash and `?`, which could open a trigraph.
fn plain() -> Bytes / {abort.raise} =
  bytes_concat_all(map(filter(range(32, 127), |b: Int| b != 34 && b != 63 && b != 92), byte_of_int))

fn escaped(piece: Bytes) -> Bytes / {abort.raise} = {
  let n = bytes_len(piece);
  bytes_concat_all(
    iterate({ from: 0, out: [] }, n + 1, |s: { from: Int, out: List<Bytes> }|
      if s.from >= n { Stop(s.out) } else {
        let stop = bytes_scan(piece, s.from, plain(), n - s.from);
        if stop > s.from {
          Continue({ from: stop, out: push(s.out, bytes_slice(piece, s.from, stop)) })
        } else {
          let b = bytes_at(piece, s.from);
          Continue({
            from: s.from + 1,
            out: push(s.out, if b == 34 { b"\\\"" } else if b == 92 { b"\\\\" } else { octal(b) }),
          })
        }
      }),
  )
}

/// Bytes per C string literal, so no literal exceeds what compilers accept.
fn piece_len() -> Int = 2000

fn literal_lines(line: Bytes) -> Bytes / {abort.raise} = {
  let n = bytes_len(line);
  let count = if n == 0 { 1 } else { (n + piece_len() - 1) / piece_len() };
  bytes_concat_all(
    map(range(0, count), |i: Int| {
      let piece = bytes_slice(line, i * piece_len(), if (i + 1) * piece_len() < n {
        (i + 1) * piece_len()
      } else { n });
      bytes_concat_all([b"\"", escaped(piece), if i == count - 1 { b"\\n" } else { b"" }, b"\"\n"])
    }),
  )
}

/// The text's lines as `str::lines` reads them: a final newline ends the last line rather than
/// opening another, and a carriage return before a newline is part of the ending.
fn split_lines(text: Bytes) -> List<Bytes> / {abort.raise} = {
  let parts = bytes_split(text, b"\n");
  let whole = if len(parts) > 0 && bytes_len(at(parts, len(parts) - 1)) == 0 {
    take(parts, len(parts) - 1)
  } else { parts };
  map(whole, |l: Bytes|
    if bytes_len(l) > 0 && bytes_at(l, bytes_len(l) - 1) == 13 {
      bytes_slice(l, 0, bytes_len(l) - 1)
    } else { l })
}

/// The table as C string literals, non-printable bytes and `?` in octal.
fn embedded(exports: Bytes) -> Bytes / {abort.raise} =
  bytes_concat_all([
    b"\n/* --- what this unit says about itself, read by the loader --- */\n",
    b"const char ply_exports[] =\n",
    bytes_concat_all(map(split_lines(exports), literal_lines)),
    b";\n",
  ])

// --- Placing it -----------------------------------------------------------------

type Placing = { name: Bytes, bucket: Int, text: Bytes, reaches: List<Bytes> }

/// A body's placeholders and what each names, which its bucket's table is made of.
type Marked = { body: UnitBody, holes: List<Hole>, keys: List<Option<Bytes>> }

/// What a body's C names of the unit's definitions: its own, a group's every member, and its calls.
fn reaches_of(name: Bytes, tables: Tables) -> List<Bytes> =
  ordered(concat(tables.calls, if len(tables.members) == 0 { [name] } else { tables.members }))

fn prototype(symbol: Bytes, arity: Int) -> Bytes =
  bytes_concat_all([
    b"Word ",
    symbol,
    b"(PlyCtx*",
    bytes_concat_all(map(range(0, arity), |_: Int| b", Word")),
    b");\n",
  ])

fn bucket_key(p: Placing) -> Bytes / {abort.raise} =
  bytes_concat_all([hex_digit(p.bucket / 16), hex_digit(p.bucket % 16), b"\x00", p.name])

/// The header, then a marked bucket per class of names opening with its table and the prototypes
/// of what its bodies reach, then the runtime's definitions and the unit's own table: one
/// translation unit that the loader also compiles in parts, cut on the marks.
fn assembled(
  runtime: Runtime,
  bodies: List<Placing>,
  sizes: Map<Int, Int>,
  taken: Map<Bytes, Taken>,
  exports: Bytes,
) -> Bytes / {abort.raise} = {
  let by_bucket = fold(bodies, map_new(), |acc: Map<Bytes, Placing>, p: Placing|
    map_insert(acc, bucket_key(p), p));
  let groups = fold(map_values(by_bucket), [], |acc: List<List<Placing>>, p: Placing| {
    let last = len(acc) - 1;
    if last >= 0 && at(at(acc, last), 0).bucket == p.bucket {
      list_set(acc, last, push(at(acc, last), p))
    } else { push(acc, [p]) }
  });
  bytes_concat_all([
    runtime.head,
    bytes_concat_all(
      map(groups, |group: List<Placing>|
        bytes_concat_all([
          bucket_mark(at(group, 0).bucket),
          b"\n",
          match map_get(sizes, at(group, 0).bucket) {
            Some(n) -> if n == 0 { b"" } else {
              bytes_concat_all([
                b"uint32_t ",
                bucket_table(at(group, 0).bucket),
                b"[",
                ascii_of_int(n),
                b"];\n",
              ])
            },
            None -> b"",
          },
          bytes_concat_all(
            map(
              ordered(fold(group, [], |acc: List<Bytes>, p: Placing| concat(acc, p.reaches))),
              |name: Bytes|
                match map_get(taken, name) { Some(t) -> prototype(t.symbol, t.arity), None -> b"" },
            ),
          ),
          b"\n",
          bytes_concat_all(map(group, |p: Placing| bytes_concat(p.text, b"\n"))),
        ])),
    ),
    runtime.tail,
    embedded(exports),
  ])
}

/// The unit over `offered`, from each root's answer: closed under calls, its tables sorted by
/// content, its bodies resolved against them and bucketed, and what it holds embedded in its C.
/// `modules` is how many modules the program it was emitted from has.
pub fn produce(
  runtime: Runtime,
  ctors: List<Ctor>,
  offered: List<Offered>,
  modules: Int,
  answers: Map<Bytes, Answer>,
  stated: List<Stated> = [],
) -> Produced / {abort.raise} = {
  let arity = fold(offered, map_new(), |acc: Map<Bytes, Offered>, o: Offered|
    map_insert(acc, o.name, o));
  let s = settle(answers, ordered(map(offered, |o: Offered| o.name)), []);
  let published = |n: Bytes|
    match map_get(s.symbols, n) {
      Some(d) -> d,
      None -> panic("every definition a unit takes emitted, and an emitted body publishes its C"),
    };
  let constants = filter(s.taken, |n: Bytes|
    match map_get(arity, n) { Some(o) -> o.constant, None -> false });
  let lines = map(s.bodies, |k: UnitBody| map(k.tables.consts, const_line));
  let pools = pools_of(s.bodies, lines, map(constants, |n: Bytes| published(n).entry));
  let placed = placed_of(pools);
  let tags = positions(map(ctors, |c: Ctor| c.name));
  let taken = map(s.taken, |n: Bytes| {
    let d = published(n);
    {
      name: n,
      arity: match map_get(arity, n) { Some(o) -> o.arity, None -> 0 },
      symbol: d.symbol,
      entry: d.entry,
    }
  });
  let marked = map(range(0, len(s.bodies)), |i: Int| {
    let k = at(s.bodies, i);
    let hs = holes(k.text);
    { body: k, holes: hs, keys: map(hs, |h: Hole| hole_key(h, k.tables, at(lines, i))) }
  });
  // Each bucket's table: every key its bodies' placeholders name, once, in byte order.
  let keyed = fold(marked, map_new(), |acc: Map<Int, Map<Bytes, Bool>>, m: Marked| {
    let b = bucket_of(m.body.name);
    map_insert(
      acc,
      b,
      fold(
        m.keys,
        match map_get(acc, b) { Some(x) -> x, None -> map_new() },
        |ks: Map<Bytes, Bool>, k: Option<Bytes>|
          match k { Some(key) -> map_insert(ks, key, true), None -> ks },
      ),
    )
  });
  let locals = map_fold(
    keyed,
    map_new(),
    |acc: Map<Int, Map<Bytes, Int>>, b: Int, ks: Map<Bytes, Bool>|
      map_insert(acc, b, positions(map_keys(ks))),
  );
  let bodies = map(marked, |m: Marked| {
    let b = bucket_of(m.body.name);
    {
      name: m.body.name,
      bucket: b,
      text: resolved(
        m.body.text,
        m.holes,
        m.keys,
        m.body.tables,
        m.body.name,
        bucket_table(b),
        match map_get(locals, b) { Some(l) -> l, None -> map_new() },
      ),
      reaches: reaches_of(m.body.name, m.body.tables),
    }
  });
  let rows = map_fold(keyed, [], |acc: List<BucketRow>, b: Int, ks: Map<Bytes, Bool>|
    if map_len(ks) == 0 { acc } else {
      push(acc, { id: b, places: map(map_keys(ks), |k: Bytes| unit_place(k, placed, tags)) })
    });
  let exports = exports_text(
    runtime.helpers,
    ctors,
    taken,
    constants,
    modules,
    s.dropped,
    pools,
    rows,
    stated,
  );
  {
    text: assembled(
      runtime,
      bodies,
      map_fold(keyed, map_new(), |acc: Map<Int, Int>, b: Int, ks: Map<Bytes, Bool>|
        map_insert(acc, b, map_len(ks))),
      fold(taken, map_new(), |acc: Map<Bytes, Taken>, t: Taken| map_insert(acc, t.name, t)),
      exports,
    ),
    taken: s.taken,
    dropped: s.dropped,
    made: { bodies: s.bodies, offered: offered },
  }
}

// --- What a root runs ----------------------------------------------------------

/// The names a body answers for: a group's members, or its own.
fn answered(body: UnitBody) -> List<Bytes> =
  if len(body.tables.members) == 0 { [body.name] } else { body.tables.members }

/// How a body's roots were offered, which places them: a constant is held rather than called.
fn offered_as(roots: Map<Bytes, Offered>, body: UnitBody) -> Bytes / {abort.raise} =
  bytes_concat_all(
    map(answered(body), |name: Bytes|
      match map_get(roots, name) {
        Some(o) ->
          bytes_concat_all([
            name,
            b" ",
            ascii_of_int(o.arity),
            if o.constant { b" constant\n" } else { b"\n" },
          ]),
        None -> bytes_concat(name, b" unoffered\n"),
      }),
  )

/// What each root of a unit runs, as one digest: its own body and every body it can call, whatever
/// the calls' cycles. A body is digested as the unit keeps it, before placing, so a root that two
/// compilers or two units made into the same code is named alike by both.
pub fn codes(made: Made) -> Map<Bytes, Bytes> / {abort.raise} = {
  let bodies = made.bodies;
  let n = len(bodies);
  let index = fold(range(0, n), map_new(), |acc: Map<Bytes, Int>, i: Int|
    fold(answered(at(bodies, i)), acc, |m: Map<Bytes, Int>, name: Bytes| map_insert(m, name, i)));
  let roots = fold(made.offered, map_new(), |acc: Map<Bytes, Offered>, o: Offered|
    map_insert(acc, o.name, o));
  let own = map(bodies, |b: UnitBody|
    blake3(
      bytes_concat_all([
        blake3(b.name),
        blake3(b.text),
        blake3(bin::encode(b.tables, tables_bin())),
        blake3(offered_as(roots, b)),
      ]),
    ));
  let adj = map(bodies, |b: UnitBody|
    fold(b.tables.calls, [], |acc: List<Int>, c: Bytes|
      match map_get(index, c) { Some(j) -> push(acc, j), None -> acc }));
  // Components come callees first, so each folds in the digests of those it reaches.
  let components = graph::components({ out: adj });
  let reached = fold(components, map_new(), |done: Map<Int, Bytes>, comp: List<Int>| {
    let inside = fold(comp, map_new(), |m: Map<Int, Bool>, i: Int| map_insert(m, i, true));
    let below = fold(comp, [], |acc: List<Bytes>, i: Int|
      fold(at(adj, i), acc, |a: List<Bytes>, j: Int|
        if map_contains(inside, j) { a }
        else { match map_get(done, j) { Some(d) -> push(a, d), None -> a } }));
    let digest = blake3(
      bytes_concat_all(concat(ordered(map(comp, |i: Int| at(own, i))), ordered(below))),
    );
    fold(comp, done, |m: Map<Int, Bytes>, i: Int| map_insert(m, i, digest))
  });
  fold(range(0, n), map_new(), |acc: Map<Bytes, Bytes>, i: Int| {
    let code = blake3(
      bytes_concat(at(own, i), match map_get(reached, i) { Some(d) -> d, None -> b"" }),
    );
    fold(answered(at(bodies, i)), acc, |m: Map<Bytes, Bytes>, name: Bytes|
      map_insert(m, name, code))
  })
}

// --- Emitting what no earlier run kept --------------------------------------------

/// What the front end's answer says the emitter works over: each root, the modules in program order,
/// and what each module imports.
type Program = {
  roots: Map<Bytes, EmitterRoot>,
  keys: Map<Bytes, Bytes>,
  modules: List<ModuleRow>,
  imports: Map<Bytes, List<Bytes>>,
  sources: List<Bytes>,
  /// A digest of what each module embeds, by its index: the emitter writes each call out as its bytes.
  embeds: Map<Int, Bytes>,
}

fn program_of(dump: Dump, sources: List<Bytes>) -> Program / {abort.raise} = {
  let by_name = fold(dump.modules, map_new(), |acc: Map<Bytes, ModuleRow>, m: ModuleRow|
    map_insert(acc, m.name, m));
  let reads = fold(dump.embeds, map_new(), |acc: Map<Int, List<Bytes>>, e: EmbedAt|
    match map_get(by_name, e.module) {
      None -> acc,
      Some(m) ->
        map_insert(
          acc,
          m.index,
          push(
            match map_get(acc, m.index) { Some(xs) -> xs, None -> [] },
            bytes_concat(sized(e.key), read_key(e.read)),
          ),
        ),
    });
  {
    roots: fold(dump.emitter_roots, map_new(), |acc: Map<Bytes, EmitterRoot>, root: EmitterRoot|
      map_insert(acc, root.root, root)),
    keys: fold(dump.keys, map_new(), |acc: Map<Bytes, Bytes>, k: KeyRow|
      map_insert(acc, k.root, k.key)),
    // The emitter walks modules in the front end's ordinal order, so this order is not ours to pick.
    modules: fold(dump.ordinals, [], |acc: List<ModuleRow>, o: OrdinalRow|
      match map_get(by_name, o.module) { Some(m) -> push(acc, m), None -> acc }),
    imports: map_fold(by_name, map_new(), |acc: Map<Bytes, List<Bytes>>, n: Bytes, m: ModuleRow|
      map_insert(acc, n, m.imports)),
    sources: sources,
    embeds: map_fold(reads, map_new(), |acc: Map<Int, Bytes>, i: Int, parts: List<Bytes>|
      map_insert(acc, i, blake3(bytes_concat_all(ordered(parts))))),
  }
}

fn text_at(program: Program, index: Int) -> Option<Bytes> = list_at(program.sources, index)

/// `modules` and every module they import, directly or not: all the emitter reads to lower a body
/// of one of them.
fn imported(program: Program, modules: List<Bytes>) -> Map<Bytes, Bool> / {abort.raise} = {
  let start = ordered(modules);
  iterate(
    { seen: map_new(), stack: start },
    len(start) + map_fold(program.imports, 1, |n: Int, _: Bytes, xs: List<Bytes>| n + len(xs)),
    |s: { seen: Map<Bytes, Bool>, stack: List<Bytes> }|
      match s.stack {
        [] -> Stop(s.seen),
        [m, ..rest] -> if map_contains(s.seen, m) { Continue({ seen: s.seen, stack: rest }) } else {
          Continue({
            seen: map_insert(s.seen, m, true),
            stack: concat(rest, match map_get(program.imports, m) { Some(xs) -> xs, None -> [] }),
          })
        },
      },
  )
}

/// What a kept answer is a function of beyond the emitter and the runtime: the root's name, the key
/// the front end gave it, the text it is written in, since its sites are offsets into that text, and
/// what its module embeds, which that text's calls are written out as. `None` for a root with no key
/// or no place, which is asked again every time.
fn root_material(program: Program, name: Bytes) -> Option<Bytes> / {abort.raise} =
  match map_get(program.keys, name) {
    None -> None,
    Some(key) -> match map_get(program.roots, name) {
      None -> None,
      Some(r) -> match text_at(program, r.at.module) {
        None -> None,
        Some(text) -> if r.at.start < 0 || r.at.end > bytes_len(text) || r.at.start > r.at.end {
          None
        } else {
          Some(
            bytes_concat_all([
              name,
              b"\x00",
              key,
              b"\x00",
              blake3(bytes_slice(text, r.at.start, r.at.end)),
              match map_get(program.embeds, r.at.module) { Some(d) -> d, None -> b"" },
            ]),
          )
        },
      },
    },
  }

fn kept_key(parts: List<Bytes>) -> Bytes / {abort.raise} =
  hex(blake3(bytes_concat_all(map(parts, |b: Bytes| bytes_concat(b, b"\x00")))))

/// A group's kept body stands only when every member is offered and each member's kept answer is
/// that same group; otherwise the group is asked again, and the emitter groups what is wanted now.
fn standing(looked: Map<Bytes, Answer>, offered: Map<Bytes, Bool>) -> Map<Bytes, Answer> =
  map_fold(looked, map_new(), |acc: Map<Bytes, Answer>, n: Bytes, a: Answer|
    match a {
      Refused(_) -> map_insert(acc, n, a),
      Body(b) -> if fold(b.tables.members, true, |ok: Bool, m: Bytes|
          ok && map_contains(offered, m)
            && (match map_get(looked, m) {
              Some(Body(other)) -> other.tables.members == b.tables.members,
              _ -> false,
            })) { map_insert(acc, n, a) }
      else { acc },
    })

/// A callee a kept body names, with the key it had. A key reads its callees by hash and the C calls
/// them by name, so two callees that hash alike under two names share a key and not a body.
type Callee = { name: Bytes, key: Option<Bytes> }
type Kept = { answer: Answer, callees: List<Callee> }

derive bin for Callee
derive bin for Kept

fn kept_of(keys: Map<Bytes, Bytes>, a: Answer) -> Kept / {abort.raise} =
  {
    answer: a,
    callees: match a {
      Body(b) -> map(ordered(b.tables.calls), |c: Bytes| { name: c, key: map_get(keys, c) }),
      Refused(_) -> [],
    },
  }

fn holds(keys: Map<Bytes, Bytes>, callees: List<Callee>) -> Bool =
  fold(callees, true, |ok: Bool, c: Callee| ok && map_get(keys, c.name) == c.key)

fn decoded(keys: Map<Bytes, Bytes>, bytes: Option<Bytes>) -> Option<Answer> / {abort.raise} =
  match bytes {
    None -> None,
    Some(b) -> match bin::decode(b, kept_bin()) {
      Ok(k) -> if holds(keys, k.callees) { Some(k.answer) } else { None },
      Err(_) -> None,
    },
  }

/// The bodies a bucket's roots had, kept as one answer so a run reads a file per bucket.
type Packed = { name: Bytes, kept: Kept }
type Pack = { rows: List<Packed> }

derive bin for Packed
derive bin for Pack

/// A row whose callees moved is a root the pack holds no body for, which the emitter is asked again.
fn unpacked(
  keys: Map<Bytes, Bytes>,
  bytes: Option<Bytes>,
) -> Option<Map<Bytes, Answer>> / {abort.raise} =
  match bytes {
    None -> None,
    Some(b) -> match bin::decode(b, pack_bin()) {
      Ok(p) ->
        Some(
          fold(p.rows, map_new(), |acc: Map<Bytes, Answer>, r: Packed|
            if holds(keys, r.kept.callees) { map_insert(acc, r.name, r.kept.answer) } else { acc }),
        ),
      Err(_) -> None,
    },
  }

/// Each bucket's roots, by name.
fn bucketed(names: List<Bytes>) -> Map<Int, List<Bytes>> / {abort.raise} =
  fold(names, map_new(), |acc: Map<Int, List<Bytes>>, n: Bytes| {
    let b = bucket_of(n);
    map_insert(acc, b, push(match map_get(acc, b) { Some(xs) -> xs, None -> [] }, n))
  })

/// Each root's answer as an earlier run kept it, `materials` naming what each is a function of. A
/// body answers for its material whatever else is offered, so it is taken before a refusal filed
/// under this offered set, and a bucket's pack, the bodies its roots had when it was written, before
/// a root's own body.
fn looked_up<| e>(
  materials: Map<Bytes, Bytes>,
  packs: Map<Int, Map<Bytes, Answer>>,
  body: (Bytes) -> Option<Answer> / e,
  refusal: (Bytes) -> Option<Answer> / e,
) -> Map<Bytes, Answer> / {abort.raise | e} =
  map_fold(materials, map_new(), |acc: Map<Bytes, Answer>, n: Bytes, m: Bytes| {
    let found = match map_get(packs, bucket_of(n)) {
      Some(packed) -> map_get(packed, n),
      None -> body(m),
    };
    match found {
      Some(a) -> map_insert(acc, n, a),
      None -> match refusal(m) { Some(a) -> map_insert(acc, n, a), None -> acc },
    }
  })

type Repack = { names: List<Bytes>, pack: Pack }

/// The packs to write: each bucket's that was missing or in which a root gained a body now, holding
/// every body its roots have.
fn repacked(
  keys: Map<Bytes, Bytes>,
  buckets: Map<Int, List<Bytes>>,
  packs: Map<Int, Map<Bytes, Answer>>,
  looked: Map<Bytes, Answer>,
  answered: Map<Bytes, Answer>,
) -> List<Repack> / {abort.raise} =
  map_fold(buckets, [], |acc: List<Repack>, b: Int, names: List<Bytes>| {
    let body_of = |n: Bytes|
      match map_get(answered, n) {
        Some(Body(x)) -> Some(Body(x)),
        Some(Refused(_)) -> None,
        None -> match map_get(looked, n) { Some(Body(x)) -> Some(Body(x)), _ -> None },
      };
    let gained = fold(names, false, |g: Bool, n: Bytes|
      g || (match map_get(answered, n) { Some(Body(_)) -> true, _ -> false }));
    if map_contains(packs, b) && !gained { acc } else {
      push(acc, {
        names: names,
        pack: {
          rows: fold(names, [], |rows: List<Packed>, n: Bytes|
            match body_of(n) {
              Some(a) -> push(rows, { name: n, kept: kept_of(keys, a) }),
              None -> rows,
            }),
        },
      })
    }
  })

/// What the emitter answers for `missed`: entered once, over the modules those roots are in and the
/// ones they import.
fn emitter_answers(
  runtime: Runtime,
  dump: Dump,
  p: Program,
  ctors: List<Ctor>,
  missed: List<Bytes>,
) -> List<RootAnswer> / {abort.raise} = {
  let lowered = fold(missed, map_new(), |acc: Map<Bytes, Bool>, n: Bytes|
    map_insert(acc, module_of_root(n), true));
  let needed = imported(p, map_keys(lowered));
  let placed = filter(range(0, len(p.modules)), |i: Int|
    map_contains(needed, at(p.modules, i).name));
  let names = map(placed, |i: Int| at(p.modules, i).name);
  // A module no wanted root is in is read for its declarations, its rows standing for its bodies.
  let text_of = |m: ModuleRow| {
    let text = match text_at(p, m.index) { Some(t) -> t, None -> b"" };
    if map_contains(lowered, m.name) { text } else { stubbed(text, m.cuts) }
  };
  emit_roots_answer(
    names,
    map(placed, |i: Int| text_of(at(p.modules, i))),
    map(ctors, |c: Ctor| c.name),
    runtime.builtins,
    missed,
    if len(dump.packages) == 0 { [{ prefix: b"", deps: [] }] } else { dump.packages },
    if len(dump.packages) == 0 { map(names, |_: Bytes| 0) } else {
      map(placed, |i: Int| match list_at(dump.module_packages, i) { Some(k) -> k, None -> 0 })
    },
    dump.embeds,
    dump.rows,
    dump.walked,
  )
}

/// The calls the emitter's work is dealt over. Each repeats the front end's work over its modules'
/// imports, so more of them lose more than they gain.
fn pieces() -> Int = 2

type Piece = { weight: Int, roots: List<Bytes> }

/// `missed` as at most `pieces()` lists that lower about as much each: the longest module first onto
/// the lightest list, and a module's roots together, since the emitter groups what one call wants.
fn dealt(p: Program, missed: List<Bytes>) -> List<List<Bytes>> / {abort.raise} = {
  let by_module = fold(missed, map_new(), |acc: Map<Bytes, List<Bytes>>, n: Bytes| {
    let m = module_of_root(n);
    map_insert(acc, m, push(match map_get(acc, m) { Some(xs) -> xs, None -> [] }, n))
  });
  let lengths = fold(p.modules, map_new(), |acc: Map<Bytes, Int>, m: ModuleRow|
    map_insert(acc, m.name, match text_at(p, m.index) { Some(t) -> bytes_len(t), None -> 0 }));
  let weighed = map_fold(by_module, [], |acc: List<Piece>, m: Bytes, roots: List<Bytes>|
    push(acc, { weight: match map_get(lengths, m) { Some(n) -> n, None -> 0 }, roots: roots }));
  let longest_first = sort_by(weighed, |a: Piece, b: Piece| a.weight >= b.weight);
  let dealt = fold(longest_first, [], |acc: List<Piece>, m: Piece|
    if len(acc) < pieces() { push(acc, m) } else {
      let lightest = fold(range(0, len(acc)), 0, |best: Int, i: Int|
        if at(acc, i).weight < at(acc, best).weight { i } else { best });
      map(range(0, len(acc)), |i: Int| {
        let piece = at(acc, i);
        if i == lightest {
          { weight: piece.weight + m.weight, roots: concat(piece.roots, m.roots) }
        } else { piece }
      })
    });
  map(dealt, |piece: Piece| piece.roots)
}

/// What the emitter answers for every list of `pieces` from `lo` up to `hi`, each list a call of its
/// own and the calls at once: a root's answer is the same whichever call asks for it. `room` is the
/// halvings left, and 64 take any length to one.
fn answers_at_once(
  runtime: Runtime,
  dump: Dump,
  p: Program,
  ctors: List<Ctor>,
  pieces: List<List<Bytes>>,
  lo: Int,
  hi: Int,
  room: Int,
) -> List<RootAnswer> / {abort.raise} =
  if hi - lo <= 1 {
    match list_at(pieces, lo) {
      Some(roots) -> emitter_answers(runtime, dump, p, ctors, roots),
      None -> [],
    }
  } else if room <= 0 { panic("more halvings than a length has") } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel {
      answers_at_once(runtime, dump, p, ctors, pieces, lo, mid, room - 1),
      answers_at_once(runtime, dump, p, ctors, pieces, mid, hi, room - 1),
    };
    concat(halves._0, halves._1)
  }

// --- Values a build kept ----------------------------------------------------------

/// A `const` definition and the text a build kept its value as, which the runtime wrote and reads.
pub type Baked = { name: Bytes, text: Bytes }

/// The root that answers a `const` definition's value as that text: what a build enters to keep it.
pub fn stored_root(name: Bytes) -> Bytes = bytes_concat(name, b"#stored")

fn stored_of(root: Bytes) -> Option<Bytes> / {abort.raise} =
  if bytes_ends_with(root, b"#stored") { Some(bytes_slice(root, 0, bytes_len(root) - 7)) }
  else { None }

/// `text` as adjacent C string literals, none longer than a compiler accepts. It is hex digits, so
/// no byte of it needs an escape or reads as a placeholder.
fn quoted(text: Bytes) -> Bytes / {abort.raise} = {
  let n = bytes_len(text);
  let count = if n == 0 { 1 } else { (n + piece_len() - 1) / piece_len() };
  bytes_concat_all(
    map(range(0, count), |i: Int|
      bytes_concat_all([
        b"\"",
        bytes_slice(text, i * piece_len(), min(n, (i + 1) * piece_len())),
        b"\"\n",
      ])),
  )
}

fn entered_by(symbol: Bytes, entry: Bytes) -> Bytes =
  bytes_concat_all([
    b"Word ",
    entry,
    b"(PlyCtx *ctx, const Word *args) {\n  return ",
    symbol,
    b"(ctx);\n}",
  ])

/// A `const` definition as the value a build kept: its unit holds the text and reads it once, where
/// the definition's own body would have run. It calls nothing, so the unit need not hold what the
/// body reaches.
fn baked_body(b: Baked) -> Answer / {abort.raise} = {
  let symbol = symbol_of(b.name);
  let entry = entry_of(b.name);
  let held = bytes_concat(symbol, b"_baked");
  Body({
    text: bytes_concat_all([
      b"static const char ",
      held,
      b"[] =\n",
      quoted(b.text),
      b";\nWord ",
      entry,
      b"(PlyCtx *ctx, const Word *args);\nWord ",
      symbol,
      b"(PlyCtx *ctx) {\n  return rt_baked_p(ctx, (Word)(intptr_t)",
      held,
      b", INT64_C(",
      ascii_of_int(bytes_len(b.text)),
      b"));\n}\n",
      entered_by(symbol, entry),
    ]),
    tables: { ..no_tables(), symbols: [{ symbol: symbol, entry: entry }] },
  })
}

/// The body of `root`, the stored root of `of`: the definition read as any body reads a constant,
/// and what it answers written as the text a unit holds a value by.
fn stored_body(root: Bytes, of: Bytes) -> Answer / {abort.raise} = {
  let symbol = symbol_of(root);
  let entry = entry_of(root);
  Body({
    text: bytes_concat_all([
      b"Word ",
      entry,
      b"(PlyCtx *ctx, const Word *args);\nWord ",
      symbol,
      b"(PlyCtx *ctx) {\n  Word held = rt_constant_p(ctx, @@l0@@);\n",
      b"  if (ctx->failed) return 0;\n  return rt_stored_p(ctx, held);\n}\n",
      entered_by(symbol, entry),
    ]),
    tables: {
      ..no_tables(),
      lambdas: [entry_of(of)],
      calls: [of],
      symbols: [{ symbol: symbol, entry: entry }],
    },
  })
}

/// The unit over `every` root offered: each one's answer taken from what an earlier run kept where it
/// stands, the emitter entered once for the rest, what it answered kept for the next run, and the
/// unit produced over all of it. `emitter` is what the emitter's answers are a function of on its
/// side, which every kept answer is filed under. `Err` says why the emitter answered nothing at all.
/// A root `baked` names is held as that value in place of its body, and a `stored_root` offered is
/// made here: the emitter is asked for neither.
pub fn emitted<| e>(
  runtime: Runtime,
  dump: Dump,
  sources: List<Bytes>,
  every: List<Bytes>,
  emitter: Bytes,
  read: (Bytes) -> Option<Bytes> / e,
  write: (Bytes, Bytes) -> Unit / e,
  baked: List<Baked> = [],
) -> Result<Emission, Bytes> / {abort.raise | e} = {
  let p = program_of(dump, sources);
  let ctors = map(dump.emitter_ctors, |c: EmitterCtor| { name: c.name, arity: c.arity });
  let wanted = fold(every, map_new(), |acc: Map<Bytes, Bool>, n: Bytes| map_insert(acc, n, true));
  let values = fold(baked, map_new(), |acc: Map<Bytes, Baked>, b: Baked|
    if map_contains(wanted, b.name) { map_insert(acc, b.name, b) } else { acc });
  let offered = filter(every, |n: Bytes| !map_contains(values, n) && stored_of(n) == None);
  let asked = fold(offered, map_new(), |acc: Map<Bytes, Bool>, n: Bytes| map_insert(acc, n, true));
  // No constructor table: a body names each tag by its constructor, which its key's read
  // declarations already cover, so one answer serves every program that holds the root.
  let common = [
    b"ply.unit.answer.2",
    hex(bin::shape_digest(kept_bin())),
    runtime.identity,
    emitter,
  ];
  let fragment = kept_key(ordered(offered));
  let body_key = |m: Bytes| kept_key(concat(common, [b"body", m]));
  let refusal_key = |m: Bytes| kept_key(concat(common, [b"refusal", fragment, m]));
  let materials = fold(offered, map_new(), |acc: Map<Bytes, Bytes>, n: Bytes|
    match root_material(p, n) { Some(m) -> map_insert(acc, n, m), None -> acc });
  let buckets = bucketed(map_keys(materials));
  let pack_key = |names: List<Bytes>|
    kept_key(
      concat(
        concat(common, [b"pack", hex(bin::shape_digest(pack_bin()))]),
        map(names, |n: Bytes| match map_get(materials, n) { Some(m) -> m, None -> b"" }),
      ),
    );
  let packs = map_fold(
    buckets,
    map_new(),
    |acc: Map<Int, Map<Bytes, Answer>>, b: Int, names: List<Bytes>|
      match unpacked(p.keys, read(pack_key(names))) {
        Some(found) -> map_insert(acc, b, found),
        None -> acc,
      },
  );
  let looked = looked_up(
    materials,
    packs,
    |m: Bytes| decoded(p.keys, read(body_key(m))),
    |m: Bytes| decoded(p.keys, read(refusal_key(m))),
  );
  let kept = standing(looked, asked);
  let missed = filter(offered, |n: Bytes| !map_contains(kept, n));
  let fresh = if len(missed) == 0 { [] } else {
    let pieces = dealt(p, missed);
    answers_at_once(runtime, dump, p, ctors, pieces, 0, len(pieces), 64)
  };
  if len(missed) > 0 && len(fresh) == 0 {
    Err(
      bytes_concat_all([
        b"it answered nothing for the ",
        ascii_of_int(len(missed)),
        b" root(s) it was asked for, so no body was emitted: a module it cannot parse, a package it ",
        b"cannot resolve, or a program its own check refuses",
      ]),
    )
  } else {
    let answered = answers_of(fresh);
    map_fold(answered, (), |_: Unit, n: Bytes, a: Answer|
      match root_material(p, n) {
        None -> (),
        Some(m) -> match a {
          Body(_) -> write(body_key(m), bin::encode(kept_of(p.keys, a), kept_bin())),
          Refused(_) -> write(refusal_key(m), bin::encode(kept_of(p.keys, a), kept_bin())),
        },
      });
    fold(repacked(p.keys, buckets, packs, looked, answered), (), |_: Unit, r: Repack|
      write(pack_key(r.names), bin::encode(r.pack, pack_bin())));
    let lowered = map_fold(answered, kept, |acc: Map<Bytes, Answer>, n: Bytes, a: Answer|
      map_insert(acc, n, a));
    let held = map_fold(values, lowered, |acc: Map<Bytes, Answer>, n: Bytes, b: Baked|
      map_insert(acc, n, baked_body(b)));
    Ok({
      produced: produce(
        runtime,
        ctors,
        map(every, |n: Bytes|
          match map_get(p.roots, n) {
            Some(r) -> { name: n, arity: r.arity, constant: r.pure && r.arity == 0 },
            None -> { name: n, arity: 0, constant: false },
          }),
        len(p.modules),
        fold(every, held, |acc: Map<Bytes, Answer>, n: Bytes|
          match stored_of(n) { Some(of) -> map_insert(acc, n, stored_body(n, of)), None -> acc }),
        fold(dump.emitter_ctors, [], |acc: List<Stated>, c: EmitterCtor|
          if c.key == None && c.show == None && len(c.numeric) == 0 { acc }
          else { push(acc, { ctor: c.name, key: c.key, show: c.show, numeric: c.numeric }) }),
      ),
      kept: map_len(kept),
      asked: len(missed),
    })
  }
}

// --- What a program is told -------------------------------------------------------

fn place_of(dump: Dump, name: Bytes) -> { module: Int, start: Int, end: Int } =
  fold(
    dump.emitter_roots,
    { module: no_module(), start: 0, end: 0 },
    |acc: { module: Int, start: Int, end: Int }, root: EmitterRoot|
      if root.root == name { { module: root.at.module, start: root.at.start, end: root.at.end } }
      else { acc },
  )

fn label_of(dump: Dump, d: Dropped, primary: Bool) -> Label = {
  let at = place_of(dump, d.function);
  { module: at.module, start: at.start, end: at.end, primary: primary, text: d.construct }
}

/// Definitions the program reaches that the emitter refused, in the order the fixpoint dropped them,
/// so the first is a cause and the rest what that cause carried.
fn refused_reach(dump: Dump, dropped: List<Dropped>) -> Diag / {abort.raise} = {
  let listed = fold(
    dropped,
    b"the emitter refused, in the order it dropped them:",
    |acc: Bytes, d: Dropped|
      bytes_concat_all([acc, b"\n  `", d.function, b"` (", d.construct, b")"]),
  );
  error_with_labels(
    b"E0448",
    bytes_concat_all([
      b"the C backend cannot compile ",
      ascii_of_int(len(dropped)),
      b" of the definitions this program reaches",
    ]),
    fold(range(0, len(dropped)), [], |acc: List<Label>, i: Int|
      if i > 4 { acc } else { push(acc, label_of(dump, at(dropped, i), i == 0)) }),
    [
      listed,
      b"compiled code is the only evaluator, so a definition it cannot compile is one nothing can enter; the build fails here, where the construct that refused it is still in hand, rather than at the call that would find no body",
    ],
  )
}

fn unanswered(why: Bytes) -> Diag =
  error_with_labels(
    b"E0450",
    bytes_concat(
      b"the C backend could not be built: the Ply emitter failed over the program: ",
      why,
    ),
    [],
    [
      b"compiled code is the only evaluator, so a run without a backend would be reported green over a seam nothing reached",
    ],
  )

/// The unit's C as the runtime compiles it, or why there is none: an emitter that answered nothing
/// at all, or a definition the program reaches that the emitter refused. A definition dropped only
/// because a narrowed offer left its callee out is no refusal of the program's.
pub fn held(
  dump: Dump,
  offered: List<Bytes>,
  emission: Result<Emission, Bytes>,
) -> Result<Bytes, List<Diag>> / {abort.raise} =
  match emission {
    Err(why) -> Err([unanswered(why)]),
    Ok(e) -> {
      let errors = fatal(offered, e.produced.dropped);
      if len(errors) == 0 { Ok(e.produced.text) } else { Err([refused_reach(dump, errors)]) }
    },
  }

/// The unit over `offered`, held as `held` holds it. What is kept between runs is `read` and
/// `write`'s, under keys that name `emitter`.
pub fn compiled<| e>(
  runtime: Runtime,
  dump: Dump,
  sources: List<Bytes>,
  offered: List<Bytes>,
  emitter: Bytes,
  read: (Bytes) -> Option<Bytes> / e,
  write: (Bytes, Bytes) -> Unit / e,
) -> Result<Bytes, List<Diag>> / {abort.raise | e} =
  held(dump, offered, emitted(runtime, dump, sources, offered, emitter, read, write))

// --- Tests ------------------------------------------------------------------

fn some_definitions() -> Bytes =
  b"compiler.unit.emitted aa\nfront.dump_of bb\nunit.emitted cc\nunit.emitted_twice dd\n"

test "a definition's hash is read under its own name, or under `compiler.` where the program ships the compiler" {
  assert_eq(definition_hash(some_definitions(), b"unit.emitted"), Some(b"aa"));
  assert_eq(definition_hash(some_definitions(), b"front.dump_of"), Some(b"bb"));
  assert_eq(definition_hash(some_definitions(), b"unit.emitted_twice"), Some(b"dd"));
  assert_eq(definition_hash(b"unit.emitted cc", b"unit.emitted"), Some(b"cc"));
  assert_eq(definition_hash(some_definitions(), b"emitted"), None);
  assert_eq(definition_hash(some_definitions(), b"unit.emit"), None)
}

test "an identity moves with the hash of a root it names, and with no other definition's" {
  let roots = [b"unit.emitted", b"front.dump_of"];
  let one = identity_of(some_definitions(), roots);
  assert_eq(
    identity_of(
      b"compiler.unit.emitted aa\nfront.dump_of bb\nunit.emitted_twice ee\nzeta.new ff\n",
      roots,
    ),
    one,
  );
  assert(
    identity_of(b"compiler.unit.emitted aa\nfront.dump_of b0\n", roots) != one,
    Some("a root's hash moved and the identity did not"),
  );
  assert(identity_of(some_definitions(), [b"unit.emitted"]) != one, None)
}

fn a_runtime(identity: Bytes) -> Runtime =
  { head: b"", tail: b"", helpers: [], builtins: [], identity: identity }

fn a_compiler(emitted: Bytes) -> Bytes =
  bytes_concat_all([
    b"front.analyse_pulling_std_with a1\nfront.dump_of b2\nunit.emitted ",
    emitted,
    b"\nunit.held d4\nbuild.told e5\n",
  ])

test "a program's key moves with the definition it enters, the runtime and the compiler, and with nothing else" {
  let key = program_key(b"entry", a_runtime(b"rt"), a_compiler(b"c3"));
  assert_eq(bytes_len(key), 64);
  assert_eq(
    program_key(b"entry", a_runtime(b"rt"), bytes_concat(a_compiler(b"c3"), b"other.one f6\n")),
    key,
  );
  assert(program_key(b"other", a_runtime(b"rt"), a_compiler(b"c3")) != key);
  assert(program_key(b"entry", a_runtime(b"tr"), a_compiler(b"c3")) != key);
  assert(program_key(b"entry", a_runtime(b"rt"), a_compiler(b"c4")) != key)
}

test "a pooled constant's line is the one the runtime reads it back from" {
  assert_eq(const_line(ConstUnit), b"u");
  assert_eq(const_line(ConstStr(b"hi")), b"s 6869");
  assert_eq(const_line(ConstBytes(b"\x00\xff")), b"b 00ff");
  assert_eq(const_line(ConstChar(65)), b"c 65");
  assert_eq(const_line(ConstFixed({ width: 0, bits: 255 })), b"f 0 255");
  assert_eq(const_line(ConstFixed({ width: 4, bits: 127 })), b"f 4 127")
}

test "a fixed-width constant is held truncated to its width, a signed one sign-extended" {
  assert_eq(
    const_line(ConstFixed({ width: 4, bits: 0 - 1 })),
    b"f 4 340282366920938463463374607431768211455",
  );
  assert_eq(const_line(ConstFixed({ width: 1, bits: 0 - 1 })), b"f 1 65535");
  assert_eq(
    const_line(ConstWide({ width: 8, high: 0 - 1, low: 0 - 1 })),
    b"f 8 340282366920938463463374607431768211455",
  );
  assert_eq(const_line(ConstWide({ width: 9, high: 0, low: 5 })), b"f 9 5");
  assert_eq(const_line(ConstWide({ width: 8, high: 1, low: 0 })), b"f 8 18446744073709551616")
}

test "a float is its bits and a decimal its mantissa and scale, as the literal reads" {
  assert_eq(const_line(ConstFloat(b"1.5")), b"x 3ff8000000000000");
  assert_eq(const_line(ConstFloat(b"-2_000.0")), b"x c09f400000000000");
  assert_eq(const_line(ConstDecimal(b"1.50m")), b"d 150 2");
  assert_eq(const_line(ConstDecimal(b"-0.05m")), b"d -5 2");
  assert_eq(const_line(ConstDecimal(b"12m")), b"d 12 0")
}

test "a C string literal holds printable bytes as they are and the rest in octal" {
  assert_eq(escaped(b"a\"b\\c?\n\x01z"), b"a\\\"b\\\\c\\077\\012\\001z");
  assert_eq(literal_lines(b""), b"\"\\n\"\n");
  let long = bytes_concat_all(map(range(0, 2001), |_: Int| b"x"));
  let pieces = bytes_split(literal_lines(long), b"\n");
  assert_eq(len(pieces), 3);
  assert_eq(bytes_len(at(pieces, 0)), 2002);
  assert_eq(at(pieces, 1), b"\"x\\n\"")
}

test "lines are read as a final newline ends the last one" {
  assert_eq(split_lines(b"a\nb\n"), [b"a", b"b"]);
  assert_eq(split_lines(b"a\r\n\nb"), [b"a", b"", b"b"])
}

test "a body dropped for a callee never offered is the offer's doing, and so is its fallout" {
  let dropped = [
    { function: b"m.a", construct: b"why", missing: None },
    { function: b"m.b", construct: b"lost", missing: Some(b"m.out") },
    { function: b"m.c", construct: b"lost", missing: Some(b"m.b") },
    { function: b"m.d", construct: b"lost", missing: Some(b"m.a") },
  ];
  assert_eq(map(fatal([b"m.a", b"m.b", b"m.c", b"m.d"], dropped), |d: Dropped| d.function), [
    b"m.a",
    b"m.d",
  ])
}

fn one_body(name: Bytes, calls: List<Bytes>) -> Answer =
  Body({
    text: bytes_concat_all([b"Word f_", name, b"(PlyCtx *ctx) { return @@c0@@ + @@r@@; }"]),
    tables: {
      consts: [ConstStr(name)],
      builtins: [],
      fields: [],
      shapes: [],
      lambdas: [],
      calls: calls,
      performs: [],
      handles: [],
      members: [],
      symbols: [{ symbol: bytes_concat(b"f_", name), entry: bytes_concat(b"e_", name) }],
    },
  })

/// `one_body` with other text, as an edit to its definition would make it.
fn edited_body(name: Bytes) -> Answer =
  match one_body(name, []) {
    Body(b) -> Body({ ..b, text: bytes_concat(b.text, b"\n/* edited */") }),
    other -> other,
  }

/// The codes of a unit over `answers`, offering `constants` as constants and the rest as calls.
fn codes_over(
  answers: List<{ key: Bytes, value: Answer }>,
  offered: List<Bytes>,
  constants: List<Bytes>,
) -> Map<Bytes, Bytes> / {abort.raise} =
  codes(
    produce(
      { head: b"", tail: b"", helpers: [], builtins: [], identity: b"r" },
      [],
      map(offered, |n: Bytes|
        { name: n, arity: 0, constant: len(filter(constants, |c: Bytes| c == n)) > 0 }),
      1,
      map_of_entries(answers),
    ).made,
  )

test "a root's code moves with every body it can call, and with no other" {
  let program = |g: Answer|
    codes_over(
      [
        { key: b"m.f", value: one_body(b"m.f", [b"m.g"]) },
        { key: b"m.g", value: g },
        { key: b"m.h", value: one_body(b"m.h", []) },
      ],
      [b"m.f", b"m.g", b"m.h"],
      [],
    );
  let before = program(one_body(b"m.g", []));
  let after = program(edited_body(b"m.g"));
  assert(map_get(before, b"m.f") != map_get(after, b"m.f"), None);
  assert(map_get(before, b"m.g") != map_get(after, b"m.g"), None);
  assert_eq(map_get(before, b"m.h"), map_get(after, b"m.h"));
  assert(map_get(before, b"m.f") != map_get(before, b"m.h"), None)
}

// The checker decides which roots are constants, and the unit holds a constant where it would call
// a root, so the same bodies offered otherwise are other code.
test "a root's code moves with how it and its callees were offered" {
  let program = |constants: List<Bytes>|
    codes_over(
      [
        { key: b"m.f", value: one_body(b"m.f", [b"m.g"]) },
        { key: b"m.g", value: one_body(b"m.g", []) },
        { key: b"m.h", value: one_body(b"m.h", []) },
      ],
      [b"m.f", b"m.g", b"m.h"],
      constants,
    );
  let called = program([]);
  let held = program([b"m.g"]);
  assert(map_get(called, b"m.g") != map_get(held, b"m.g"), None);
  assert(map_get(called, b"m.f") != map_get(held, b"m.f"), None);
  assert_eq(map_get(called, b"m.h"), map_get(held, b"m.h"))
}

test "a cycle is digested whole, whatever order the unit holds its roots in" {
  let cycle = |b: Answer, order: List<Bytes>|
    codes_over(
      [{ key: b"m.a", value: one_body(b"m.a", [b"m.b"]) }, { key: b"m.b", value: b }],
      order,
      [],
    );
  let one = cycle(one_body(b"m.b", [b"m.a"]), [b"m.a", b"m.b"]);
  assert_eq(cycle(one_body(b"m.b", [b"m.a"]), [b"m.b", b"m.a"]), one);
  assert(map_get(one, b"m.a") != map_get(one, b"m.b"), None);
  let edited = match edited_body(b"m.b") {
    Body(b) -> Body({ ..b, tables: { ..b.tables, calls: [b"m.a"] } }),
    other -> other,
  };
  assert(map_get(cycle(edited, [b"m.a", b"m.b"]), b"m.a") != map_get(one, b"m.a"), None)
}

// A body names a constructor's tag by the constructor, so the same answer serves programs whose
// tables differ, and each unit writes the position its own table gives.
test "a constructor's tag is its bucket's to read, at the position the unit's own table gives it" {
  let runtime = { head: b"", tail: b"", helpers: [], builtins: [], identity: b"r" };
  let answer = Body({
    text: b"Word f_m.f(PlyCtx *ctx) { return @@Tm.Line@@ + @@TNone@@; }",
    tables: {
      consts: [],
      builtins: [],
      fields: [],
      shapes: [],
      lambdas: [],
      calls: [],
      performs: [],
      handles: [],
      members: [],
      symbols: [{ symbol: b"f_m.f", entry: b"e_m.f" }],
    },
  });
  let unit = |ctors: List<Ctor>|
    produce(
      runtime,
      ctors,
      [{ name: b"m.f", arity: 0, constant: false }],
      1,
      map_insert(map_new(), b"m.f", answer),
    ).text;
  let alone = unit([
    { name: b"None", arity: 0 },
    { name: b"m.Dot", arity: 0 },
    { name: b"m.Line", arity: 1 },
  ]);
  let beside = unit([
    { name: b"None", arity: 0 },
    { name: b"a.One", arity: 0 },
    { name: b"a.Two", arity: 0 },
    { name: b"m.Dot", arity: 0 },
    { name: b"m.Line", arity: 1 },
  ]);
  let table = bucket_table(bucket_of(b"m.f"));
  let body = bytes_concat_all([b"{ return ", table, b"[1] + ", table, b"[0]; }"]);
  assert(bytes_index_of(alone, body) != None, None);
  assert(bytes_index_of(beside, body) != None, None);
  let row = |places: Bytes|
    bytes_concat_all([b"\"", ascii_of_int(bucket_of(b"m.f")), places, b"\\n\""]);
  assert(bytes_index_of(alone, row(b" 0 2")) != None, None);
  assert(bytes_index_of(beside, row(b" 0 4")) != None, None)
}

/// A bucket's part of a unit's C: from its mark to the next part's.
fn bucket_part(unit: Bytes, id: Int) -> Bytes / {abort.raise} =
  match bytes_index_of(unit, bucket_mark(id)) {
    None -> b"",
    Some(start) -> match bytes_index_of_from(unit, b"/* --- ", start + 1) {
      Some(end) -> bytes_slice(unit, start, end),
      None -> bytes_slice(unit, start, bytes_len(unit)),
    },
  }

test "a bucket's C reads the same whatever another bucket adds to the unit's tables" {
  let runtime = {
    head: b"/* head */\n",
    tail: b"/* --- the runtime --- */\n",
    helpers: [],
    builtins: [],
    identity: b"r",
  };
  let other = fold(range(0, 4096), b"", |found: Bytes, i: Int| {
    let n = bytes_concat(b"a.other", ascii_of_int(i));
    if found == b"" && bucket_of(n) != bucket_of(b"m.f") { n } else { found }
  });
  let unit = |names: List<Bytes>|
    produce(
      runtime,
      [{ name: b"None", arity: 0 }],
      map(names, |n: Bytes| { name: n, arity: 0, constant: false }),
      1,
      fold(names, map_new(), |acc: Map<Bytes, Answer>, n: Bytes|
        map_insert(acc, n, one_body(n, []))),
    ).text;
  let alone = unit([b"m.f"]);
  let beside = unit([b"m.f", other]);
  assert(bucket_part(alone, bucket_of(b"m.f")) != b"", None);
  assert_eq(bucket_part(beside, bucket_of(b"m.f")), bucket_part(alone, bucket_of(b"m.f")));
  // What moved is the unit's own table: `other`'s constant sorts first, so `m.f`'s is the second.
  assert(alone != beside, None)
}

/// A name in `name`'s bucket that is not `name`, for a test that wants two roots to share one.
fn bucket_mate(name: Bytes) -> Bytes / {abort.raise} =
  fold(range(0, 4096), b"", |found: Bytes, i: Int| {
    let n = bytes_concat(b"m.mate", ascii_of_int(i));
    if found == b"" && bucket_of(n) == bucket_of(name) { n } else { found }
  })

fn answered_by(answers: List<{ key: Bytes, value: Answer }>) -> (Bytes) -> Option<Answer> = {
  let m = map_of_entries(answers);
  |k: Bytes| map_get(m, k)
}

test "a bucket's pack answers before a root's own body, and a body before a refusal" {
  let mate = bucket_mate(b"m.a");
  assert(bucket_of(b"m.b") != bucket_of(b"m.a") && bucket_of(b"m.c") != bucket_of(b"m.a"), None);
  let packed = one_body(b"m.a", []);
  let refusal = Refused({ why: b"a body the lowering does not reach", handles: [] });
  let looked = looked_up(
    map_of_entries([
      { key: b"m.a", value: b"ma" },
      { key: b"m.b", value: b"mb" },
      { key: b"m.c", value: b"mc" },
      { key: mate, value: b"md" },
    ]),
    map_insert(map_new(), bucket_of(b"m.a"), map_insert(map_new(), b"m.a", packed)),
    answered_by([
      { key: b"ma", value: one_body(b"m.a", [b"m.old"]) },
      { key: b"mb", value: one_body(b"m.b", []) },
      { key: b"md", value: one_body(mate, []) },
    ]),
    answered_by([
      { key: b"mb", value: refusal },
      { key: b"mc", value: refusal },
      { key: b"md", value: refusal },
    ]),
  );
  assert_eq(map_get(looked, b"m.a"), Some(packed));
  assert_eq(map_get(looked, b"m.b"), Some(one_body(b"m.b", [])));
  assert_eq(map_get(looked, b"m.c"), Some(refusal));
  // A pack holds every body its bucket had, so a root it does not hold had none.
  assert_eq(map_get(looked, mate), Some(refusal))
}

test "a kept body stands only where each callee it names still has the key it was filed with" {
  let keys = map_of_entries([{ key: b"m.b", value: b"kb" }]);
  let body = one_body(b"m.a", [b"m.b"]);
  let filed = kept_of(keys, body);
  assert(holds(keys, filed.callees));
  // Another tree's callee that hashes alike under another name: the C would call a name not here.
  assert(!holds(map_of_entries([{ key: b"m.c", value: b"kb" }]), filed.callees));
  assert(!holds(map_of_entries([{ key: b"m.b", value: b"another" }]), filed.callees));
  assert_eq(decoded(keys, Some(bin::encode(filed, kept_bin()))), Some(body));
  assert_eq(decoded(map_new(), Some(bin::encode(filed, kept_bin()))), None);
  let pack = bin::encode({ rows: [{ name: b"m.a", kept: filed }] }, pack_bin());
  assert_eq(unpacked(keys, Some(pack)), Some(map_insert(map_new(), b"m.a", body)));
  assert_eq(unpacked(map_new(), Some(pack)), Some(map_new()))
}

test "a pack is written again where it was missing or a root in it gained a body" {
  let mate = bucket_mate(b"m.a");
  let refusal = Refused({ why: b"a body the lowering does not reach", handles: [] });
  let buckets = bucketed([b"m.a", mate, b"m.b"]);
  let packs = map_insert(
    map_new(),
    bucket_of(b"m.a"),
    map_insert(map_new(), b"m.a", one_body(b"m.a", [])),
  );
  let looked = map_of_entries([
    { key: b"m.a", value: one_body(b"m.a", []) },
    { key: mate, value: refusal },
    { key: b"m.b", value: one_body(b"m.b", []) },
  ]);
  let rows = |rs: List<Repack>| map(rs, |r: Repack| map(r.pack.rows, |p: Packed| p.name));
  assert_eq(rows(repacked(map_new(), buckets, packs, looked, map_new())), [[b"m.b"]]);
  let again = rows(
    repacked(map_new(), buckets, packs, looked, map_insert(map_new(), mate, one_body(mate, []))),
  );
  assert_eq(len(again), 2);
  assert(fold(again, false, |found: Bool, r: List<Bytes>| found || r == [b"m.a", mate]), None)
}

fn three_modules() -> List<Bytes> =
  [
    b"import b\nimport c\nfn f(x: Int) -> Int = b::g(x) + c::h(x)\n",
    b"import c\npub fn g(x: Int) -> Int = c::h(x) * 2\n",
    bytes_concat_all([
      b"pub fn h(x: Int) -> Int = if even(x) { x } else { x + 1 }\n",
      b"fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\n",
      b"fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n",
    ]),
  ]

fn three_modules_dump() -> Dump / {abort.raise} = {
  let texts = three_modules();
  dump_of(
    analyse(
      parse_all([
        { name: b"a", src: at(texts, 0) },
        { name: b"b", src: at(texts, 1) },
        { name: b"c", src: at(texts, 2) },
      ]),
    ),
  )
}

test "roots are dealt a module at a time, each once, over no more lists than there are pieces" {
  let dump = three_modules_dump();
  let p = program_of(dump, three_modules());
  let missed = map(dump.emitter_roots, |r: EmitterRoot| r.root);
  let lists = dealt(p, missed);
  assert_eq(len(lists), pieces());
  assert_eq(
    ordered(fold(lists, [], |acc: List<Bytes>, roots: List<Bytes>| concat(acc, roots))),
    ordered(missed),
  );
  assert_eq(fold(lists, 0, |n: Int, roots: List<Bytes>| n + len(roots)), len(missed));
  let modules = |roots: List<Bytes>| ordered(map(roots, module_of_root));
  assert_eq(
    fold(lists, 0, |n: Int, roots: List<Bytes>| n + len(modules(roots))),
    len(modules(missed)),
  );
  let many = map(range(0, 3 * pieces()), |i: Int| bytes_concat_all([b"m", ascii_of_int(i), b".f"]));
  assert_eq(len(dealt(p, many)), pieces())
}

test "a root's kept answer moves with what its module embeds, and with no other module's" {
  let dump = three_modules_dump();
  let embedding = |bytes: Bytes|
    program_of(
      {
        ..dump,
        embeds: [{ module: b"c", key: b"file:data.txt", read: Ok([{ name: b"", bytes: bytes }]) }],
      },
      three_modules(),
    );
  let one = root_material(embedding(b"one"), b"c.h");
  assert(one != None, None);
  assert(one != root_material(embedding(b"two"), b"c.h"), None);
  assert_eq(
    root_material(embedding(b"one"), b"a.f"),
    root_material(program_of(dump, three_modules()), b"a.f"),
  )
}

test "the emitter answers roots dealt over calls as it answers them in one" {
  let dump = three_modules_dump();
  let p = program_of(dump, three_modules());
  let missed = map(dump.emitter_roots, |r: EmitterRoot| r.root);
  let runtime = { head: b"", tail: b"", helpers: [], builtins: [], identity: b"r" };
  let lists = dealt(p, missed);
  let rows = |answers: List<RootAnswer>|
    map_fold(answers_of(answers), [], |acc: List<RootAnswer>, n: Bytes, a: Answer|
      push(acc, { name: n, answer: a }));
  let together = rows(emitter_answers(runtime, dump, p, [], missed));
  assert(
    fold(together, false, |found: Bool, r: RootAnswer|
      found
        || (match r.answer {
          Body(b) -> b.tables.members == [b"c.even", b"c.odd"],
          Refused(_) -> false,
        })),
    None,
  );
  assert_eq(rows(answers_at_once(runtime, dump, p, [], lists, 0, len(lists), 64)), together)
}

test "a unit holds a `const` definition as the value a build kept, and makes its stored root" {
  let source = b"const fn table() -> List<Int> = spread(3)\nfn spread(n: Int) -> List<Int> = [n, n + 1]\nfn first() -> Int = match table() { [x, ..] -> x, [] -> 0 }\n";
  let dump = dump_of(analyse(parse_all([{ name: b"m", src: source }])));
  assert_eq(map(dump.baked, |row: { name: Bytes, hash: Bytes }| row.name), [b"m.table"]);
  let runtime = { head: b"", tail: b"", helpers: [], builtins: [], identity: b"r" };
  let unit = |every: List<Bytes>, baked: List<Baked>|
    match emitted(
        runtime,
        dump,
        [source],
        every,
        b"",
        |_: Bytes| None,
        |_: Bytes, _: Bytes| (),
        baked,
      ) {
      Ok(e) -> e,
      Err(why) -> panic(string_of_bytes_lossy(why)),
    };
  let held = unit([b"m.table", b"m.first"], [{ name: b"m.table", text: b"78da" }]);
  // The value stands where the body would: nothing asks the emitter for it, or for what it calls.
  assert_eq(held.asked, 1);
  assert_eq(held.produced.taken, [b"m.first", b"m.table"]);
  assert(
    bytes_index_of(
        held.produced.text,
        bytes_concat_all([
          b"static const char ",
          symbol_of(b"m.table"),
          b"_baked[] =\n\"78da\"\n;",
        ]),
      )
      != None,
    None,
  );
  assert(bytes_index_of(held.produced.text, b", INT64_C(4));") != None, None);
  // A value for a root the unit does not hold is no part of it.
  let apart = unit([b"m.spread"], [{ name: b"m.table", text: b"78da" }]);
  assert_eq(bytes_index_of(apart.produced.text, b"_baked"), None);
  // The stored root reads the definition as any body reads a constant, and needs it held.
  let storing = unit([b"m.table", b"m.spread", stored_root(b"m.table")], []);
  assert_eq(storing.asked, 2);
  assert_eq(storing.produced.taken, [b"m.spread", b"m.table", b"m.table#stored"]);
  assert(bytes_index_of(storing.produced.text, b"rt_stored_p(ctx, held)") != None, None);
  let alone = unit([stored_root(b"m.table")], []);
  assert_eq(map(alone.produced.dropped, |d: Dropped| d.function), [b"m.table#stored"])
}

test "a value's text is cut into literals no longer than a compiler takes" {
  assert_eq(quoted(b"ab"), b"\"ab\"\n");
  assert_eq(quoted(b""), b"\"\"\n");
  let long = bytes_concat_all(map(range(0, piece_len() + 1), |_: Int| b"0"));
  assert_eq(len(bytes_split(quoted(long), b"\n")), 3)
}

test "a unit takes what its callees let it, resolves its bodies and says what it holds" {
  let runtime = {
    head: b"/* head */\n",
    tail: b"/* tail */\n",
    helpers: [{ name: b"rt_a", args: 1, answers: true }],
    builtins: [],
    identity: b"r",
  };
  let answers = map_insert(
    map_insert(map_new(), b"m.f", one_body(b"m.f", [])),
    b"m.g",
    one_body(b"m.g", [b"m.gone"]),
  );
  let p = produce(
    runtime,
    [{ name: b"None", arity: 0 }],
    [{ name: b"m.g", arity: 0, constant: false }, { name: b"m.f", arity: 0, constant: true }],
    1,
    answers,
  );
  assert_eq(p.taken, [b"m.f"]);
  assert_eq(map(p.dropped, |d: Dropped| d.function), [b"m.g"]);
  assert(
    bytes_index_of(
        p.text,
        bytes_concat_all([
          b"Word f_m.f(PlyCtx *ctx) { return ",
          bucket_table(bucket_of(b"m.f")),
          b"[0] + ",
        ]),
      )
      != None,
    None,
  );
  assert(bytes_index_of(p.text, b"Word f_m.f(PlyCtx*);\n") != None, None);
  assert(
    bytes_index_of(p.text, b"/* tail */\n\n/* --- what this unit says about itself") != None,
    None,
  );
  assert(
    bytes_index_of(
        p.text,
        b"\"taken 1\\n\"\n\"m.f 0 f_m.f e_m.f\\n\"\n\"constants 1\\n\"\n\"m.f\\n\"",
      )
      != None,
    None,
  )
}

test "a unit says which constructors are read through a function, and which function it lacks" {
  let p = produce(
    { head: b"/* head */\n", tail: b"/* tail */\n", helpers: [], builtins: [], identity: b"r" },
    [{ name: b"m.Box", arity: 2 }, { name: b"m.Dot", arity: 0 }],
    [
      { name: b"m.area", arity: 1, constant: false },
      { name: b"m.make", arity: 0, constant: false },
    ],
    1,
    map_of_entries([
      { key: b"m.area", value: one_body(b"m.area", [b"m.area"]) },
      { key: b"m.make", value: one_body(b"m.make", [b"m.area"]) },
    ]),
    [{ ctor: b"m.Box", key: Some(b"m.area"), show: Some(b"m.text"), numeric: [] }],
  );
  assert_eq(p.taken, [b"m.area", b"m.make"]);
  assert(bytes_index_of(p.text, b"\"instances 1\\n\"\n\"m.Box m.area !\\n\"") != None, None);
  // A body that names the constructor is not taken without the key its type states.
  let alone = produce(
    { head: b"", tail: b"", helpers: [], builtins: [], identity: b"r" },
    [{ name: b"m.Box", arity: 2 }],
    [{ name: b"m.make", arity: 0, constant: false }],
    1,
    map_of_entries([{ key: b"m.make", value: one_body(b"m.make", [b"m.area"]) }]),
    [{ ctor: b"m.Box", key: Some(b"m.area"), show: None, numeric: [] }],
  );
  assert_eq(alone.taken, []);
  assert_eq(map(alone.dropped, |d: Dropped| d.missing), [Some(b"m.area")]);
  // A unit none of whose types states one says nothing of it.
  let plain = produce(
    { head: b"", tail: b"", helpers: [], builtins: [], identity: b"r" },
    [],
    [{ name: b"m.f", arity: 0, constant: false }],
    1,
    map_of_entries([{ key: b"m.f", value: one_body(b"m.f", []) }]),
  );
  assert(bytes_index_of(plain.text, b"instances") == None, None)
}

test "a root's code moves with the key a type it names states" {
  let program = |key: Answer, calls: List<Bytes>|
    codes_over(
      [
        { key: b"m.make", value: one_body(b"m.make", calls) },
        { key: b"m.area", value: key },
        { key: b"m.edge", value: one_body(b"m.edge", []) },
      ],
      [b"m.make", b"m.area", b"m.edge"],
      [],
    );
  let keyed = program(one_body(b"m.area", []), [b"m.area"]);
  let edited = program(edited_body(b"m.area"), [b"m.area"]);
  let other = program(one_body(b"m.area", []), [b"m.edge"]);
  assert(map_get(keyed, b"m.make") != map_get(edited, b"m.make"), None);
  assert(map_get(keyed, b"m.make") != map_get(other, b"m.make"), None)
}
