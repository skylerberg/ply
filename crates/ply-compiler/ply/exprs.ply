// Expressions: the tree, the grammar and the dump. Record updates, `?` and named arguments are
// kept as parsed; later passes expand them.

import spine (push_front, positional, Span, Ident, QName, Ctx, P, R, Ate, Acc, Start, PDiag,
              span_to, dummy_span, no_ident, bare,
              unexpected, diag1, diag2, push_diag, error_here, unclosed,
              settle, failed,
              default_not_allowed, unknown_argument_name, argument_order,
              kind, kind_at, cur_span, prev_span, at, at_eof, at_ident_text,
              advance, bump, eat, expect, expect_close, expect_ident,
              expect_field_name, keyword_pun_refusal,
              with_no_brace, deeper, shallower, start, qname, comma_list,
              t_lparen, t_rparen, t_lbrace, t_rbrace, t_lbracket, t_rbracket,
              t_comma, t_semi, t_colon, t_dot, t_dotdot, t_arrow, t_eq,
              t_pipe, t_pipepipe, t_question,
              k_let, k_if, k_else, k_with,
              rec, nlist, opt, word, dump_list, dump_opt, dump_ident, dump_qname,
              dump_diags, with_no_pipe, advance_n, tok_at, t_gt, t_lt)
import lexer (Tok, TIdent, TInt, TFixed, TFloat, TDec, TStr, TBytes, TKw, TPunct, TEof)
import types (TypeExpr, ty, ty_span, dump_ty)
import patterns (Pattern, Lit, LInt, LFixed, LBool, LStr, LBytes, LFloat, LDec, LUnit,
                 pattern, pat_span, no_pattern, dump_pattern, dump_lit)

// --- The tree ---------------------------------------------------------------
pub type Expr =
  | ELit({ span: Span, lit: Lit })
  | EVar({ span: Span, name: QName })
  | EBinary({ span: Span, op: Bytes, lhs: Expr, rhs: Expr })
  | EUnary({ span: Span, op: Bytes, operand: Expr })
  | ELambda({ span: Span, body: Expr, params: List<Param>, ret: Option<TypeExpr> })
  | EApp({ span: Span, func: Expr, named: List<NamedArg>, args: List<Expr> })
  | EIf({ span: Span, cond: Expr, then_branch: Expr, else_branch: Expr })
  | EMatch({ span: Span, scrutinee: Expr, arms: List<MatchArm> })
  | EBlock({ span: Span, tail: Option<Expr>, stmts: List<Stmt> })
  | ERecord({ span: Span, fields: List<RecField> })
  | ERecordUpdate({ span: Span, base: Expr, fields: List<RecField> })
  | ETry({ span: Span, operand: Expr })
  | EField({ span: Span, base: Expr, field: Ident })
  | EList({ span: Span, items: List<Expr> })
  | EPerform({ span: Span, eff: QName, op: Ident, resource: Option<Ident>,
               args: List<Expr> })
  | EHandle({ span: Span, body: Expr, ret: Option<ReturnClause>,
              clauses: List<HandleClause> })
  | EWithCell({ span: Span, resource: Ident, init: Expr, binder: Ident, body: Expr })
  | EWithRegion({ span: Span, region: Ident, body: Expr })
  | ESimulate({ span: Span, body: Expr })
  | EBad({ span: Span })

pub type RecField = { name: Ident, value: Expr }

pub type NamedArg = { name: Ident, value: Expr, span: Span }

type Arg = | APos(Expr) | ANamed(NamedArg)

// A parameter; only a `fn` parameter may carry a `default`.
pub type Param = { name: Ident, ty: Option<TypeExpr>, default: Option<Expr>,
                   span: Span }

pub type Stmt =
  | SLet({ span: Span, pat: Pattern, ty: Option<TypeExpr>, value: Expr })
  | SExpr(Expr)

pub type MatchArm = { pat: Pattern, guard: Option<Expr>, body: Expr, span: Span }

pub type HandleClause = {
  eff: QName,
  op: Ident,
  resource: Option<Ident>,
  resume: Option<Ident>,
  body: Expr,
  span: Span,
  params: List<Ident>,
}

pub type ReturnClause = { binder: Ident, body: Expr, span: Span }

// A variant of its own rather than `()`, so a placeholder that reaches the dump is visible.
pub fn no_expr() -> Expr = EBad({ span: dummy_span() })

fn no_clause() -> HandleClause =
  { eff: bare(no_ident()), op: no_ident(), resource: None, resume: None,
    body: no_expr(), span: dummy_span(), params: [] }

fn no_return() -> ReturnClause =
  { binder: no_ident(), body: no_expr(), span: dummy_span() }

pub fn expr_span(e: Expr) -> Span =
  match e {
    ELit(v) -> v.span,
    EVar(v) -> v.span,
    EBinary(v) -> v.span,
    EUnary(v) -> v.span,
    ELambda(v) -> v.span,
    EApp(v) -> v.span,
    EIf(v) -> v.span,
    EMatch(v) -> v.span,
    EBlock(v) -> v.span,
    ERecord(v) -> v.span,
    ERecordUpdate(v) -> v.span,
    ETry(v) -> v.span,
    EField(v) -> v.span,
    EList(v) -> v.span,
    EPerform(v) -> v.span,
    EHandle(v) -> v.span,
    EWithCell(v) -> v.span,
    EWithRegion(v) -> v.span,
    ESimulate(v) -> v.span,
    EBad(v) -> v.span,
  }

fn set_span(e: Expr, s: Span) -> Expr =
  match e {
    ELit(v) -> ELit({ span: s, lit: v.lit }),
    EVar(v) -> EVar({ span: s, name: v.name }),
    EBinary(v) -> EBinary({ span: s, op: v.op, lhs: v.lhs, rhs: v.rhs }),
    EUnary(v) -> EUnary({ span: s, op: v.op, operand: v.operand }),
    ELambda(v) -> ELambda({ span: s, body: v.body, params: v.params, ret: v.ret }),
    EApp(v) -> EApp({ span: s, func: v.func, named: v.named, args: v.args }),
    EIf(v) -> EIf({ span: s, cond: v.cond, then_branch: v.then_branch,
                    else_branch: v.else_branch }),
    EMatch(v) -> EMatch({ span: s, scrutinee: v.scrutinee, arms: v.arms }),
    EBlock(v) -> EBlock({ span: s, tail: v.tail, stmts: v.stmts }),
    ERecord(v) -> ERecord({ span: s, fields: v.fields }),
    ERecordUpdate(v) -> ERecordUpdate({ span: s, base: v.base, fields: v.fields }),
    ETry(v) -> ETry({ span: s, operand: v.operand }),
    EField(v) -> EField({ span: s, base: v.base, field: v.field }),
    EList(v) -> EList({ span: s, items: v.items }),
    EPerform(v) -> EPerform({ span: s, eff: v.eff, op: v.op, resource: v.resource,
                              args: v.args }),
    EHandle(v) -> EHandle({ span: s, body: v.body, ret: v.ret, clauses: v.clauses }),
    EWithCell(v) -> EWithCell({ span: s, resource: v.resource, init: v.init,
                                binder: v.binder, body: v.body }),
    EWithRegion(v) -> EWithRegion({ span: s, region: v.region, body: v.body }),
    ESimulate(v) -> ESimulate({ span: s, body: v.body }),
    EBad(v) -> EBad({ span: s }),
  }

// Ends in `}`, so it may stand as a statement without `;` and as a match arm without `,`.
pub fn is_block_like(e: Expr) -> Bool =
  match e {
    EBlock(v) -> true,
    EIf(v) -> true,
    EMatch(v) -> true,
    EHandle(v) -> true,
    EWithCell(v) -> true,
    EWithRegion(v) -> true,
    ESimulate(v) -> true,
    _ -> false,
  }

// --- The precedence table ---------------------------------------------------
// `width` is how many tokens the operator spans: a shift is touching `<`s or `>`s, as `>>` is not lexed.
type Op = { op: Bytes, bp: Int, width: Int }

fn bin_op(k: Tok) -> Option<Op> =
  match k {
    TPunct(s) ->
      if s == b"pipepipe" { Some({op: b"or", bp: 1, width: 1}) }
      else if s == b"ampamp" { Some({op: b"and", bp: 2, width: 1}) }
      else if s == b"eqeq" { Some({op: b"eq", bp: 3, width: 1}) }
      else if s == b"bangeq" { Some({op: b"ne", bp: 3, width: 1}) }
      else if s == b"lt" { Some({op: b"lt", bp: 3, width: 1}) }
      else if s == b"le" { Some({op: b"le", bp: 3, width: 1}) }
      else if s == b"gt" { Some({op: b"gt", bp: 3, width: 1}) }
      else if s == b"ge" { Some({op: b"ge", bp: 3, width: 1}) }
      else if s == b"pipe" { Some({op: b"bitor", bp: 4, width: 1}) }
      else if s == b"caret" { Some({op: b"bitxor", bp: 5, width: 1}) }
      else if s == b"amp" { Some({op: b"bitand", bp: 6, width: 1}) }
      else if s == b"plusplus" { Some({op: b"concat", bp: 8, width: 1}) }
      else if s == b"plus" { Some({op: b"add", bp: 9, width: 1}) }
      else if s == b"minus" { Some({op: b"sub", bp: 9, width: 1}) }
      else if s == b"star" { Some({op: b"mul", bp: 10, width: 1}) }
      else if s == b"slash" { Some({op: b"div", bp: 10, width: 1}) }
      else if s == b"percent" { Some({op: b"rem", bp: 10, width: 1}) }
      else { None },
    _ -> None,
  }

fn touching(c: Ctx, p: P, i: Int) -> Bool =
  kind_at(c, p, i) == kind(c, p) && tok_at(c, p, i).start == tok_at(c, p, i - 1).end

fn joined(c: Ctx, p: P, n: Int) -> Bool =
  if n == 1 { touching(c, p, 1) } else { touching(c, p, 1) && touching(c, p, 2) }

// `>>>` must be tried before `>>`.
fn peek_bin_op(c: Ctx, p: P) -> Option<Op> =
  if p.no_pipe && at(c, p, t_pipe()) { None }
  else if at(c, p, t_gt()) && joined(c, p, 2) { Some({op: b"ushr", bp: 7, width: 3}) }
  else if at(c, p, t_gt()) && joined(c, p, 1) { Some({op: b"shr", bp: 7, width: 2}) }
  else if at(c, p, t_lt()) && joined(c, p, 1) { Some({op: b"shl", bp: 7, width: 2}) }
  else { bin_op(kind(c, p)) }

fn src_over(c: Ctx, s: Span) -> Bytes = bytes_slice(c.src, s.start, s.end)

// --- The grammar ------------------------------------------------------------

pub fn expr(c: Ctx, p: P) -> Result<R<Expr>, P> = bin_expr(c, p, 1)

// In a scrutinee a `{` opens the arm block, never a record or a block expression.
pub fn scrutinee(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let saved = p.no_brace;
  match expr(c, with_no_brace(p, true)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ p: with_no_brace(r.p, saved), node: r.node }),
  }
}

// The left spine is one `iterate`; the right operand recurses at `bp + 1`, so depth is bounded
// by the number of binding powers rather than by the input's length.
fn bin_expr(c: Ctx, p: P, min_bp: Int) -> Result<R<Expr>, P> = {
  let lhs = unary_expr(c, p)?;
  iterate(lhs, c.ntok - lhs.p.pos + 1, |s: R<Expr>|
    match peek_bin_op(c, s.p) {
      None -> Stop(Ok(s)),
      Some(o) ->
        if o.bp < min_bp { Stop(Ok(s)) } else {
          let a = advance_n(c, s.p, o.width);
          match bin_expr(c, a, o.bp + 1) {
            Err(q) -> Stop(Err(q)),
            Ok(rhs) ->
              Continue({p: rhs.p,
                        node: EBinary({ span: span_to(expr_span(s.node),
                                                      expr_span(rhs.node)),
                                        op: o.op, lhs: s.node, rhs: rhs.node })}),
          }
        },
    })
}

fn unary_expr(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let d = deeper(c, p)?;
  match unary_body(c, d) {
    Err(q) -> Err(shallower(q)),
    Ok(r) -> Ok({ p: shallower(r.p), node: r.node }),
  }
}

fn unary_body(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let op = match kind(c, p) {
    TPunct(s) -> if s == b"minus" { b"neg" } else if s == b"bang" { b"not" }
                 else if s == b"tilde" { b"bitnot" } else { b"" },
    _ -> b"",
  };
  if op == b"" { postfix_expr(c, p) } else {
    let st = advance(c, p);
    let {p, node: operand} = unary_expr(c, st.p)?;
    Ok({ p: p,
         node: EUnary({ span: span_to(st.node, expr_span(operand)),
                        op: op, operand: operand }) })
  }
}

fn postfix_expr(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let first = primary_expr(c, p)?;
  iterate(first, c.ntok - first.p.pos + 1, |s: R<Expr>|
    if at(c, s.p, t_lparen()) {
      match call_args(c, s.p) {
        Err(q) -> Stop(Err(q)),
        Ok(a) ->
          Continue({p: a.p,
                    node: EApp({ span: span_to(expr_span(s.node), a.close),
                                 func: s.node, named: a.named, args: a.args })}),
      }
    } else if at(c, s.p, t_dot()) {
      match postfix_dot(c, s) {
        Err(q) -> Stop(Err(q)),
        Ok(r) -> Continue(r),
      }
    } else if at(c, s.p, t_question()) {
      // `?` binds tightest, with calls and fields: `f(x)?.g` is `(f(x)?).g` and `-x?` is `-(x?)`.
      let q = advance(c, s.p);
      Continue({p: q.p,
                node: ETry({ span: span_to(expr_span(s.node), q.node),
                             operand: s.node })})
    } else {
      Stop(Ok(s))
    })
}

// A name, `.`, a name, then `[` or `(` is a perform; anything else is a field read.
fn postfix_dot(c: Ctx, s: R<Expr>) -> Result<R<Expr>, P> = {
  let is_perform = match s.node {
    EVar(v) ->
      match kind_at(c, s.p, 1) {
        TIdent(n) -> at(c, s.p, t_dot()) && follows_op(kind_at(c, s.p, 2)),
        _ -> false,
      },
    _ -> false,
  };
  let dot = advance(c, s.p);
  if !is_perform {
    let {p, node: f} = expect_field_name(c, dot.p, b"a field name after `.`")?;
    Ok({ p: p,
         node: EField({ span: span_to(expr_span(s.node), f.name.span),
                        base: s.node, field: f.name }) })
  } else {
    let eff = match s.node { EVar(v) -> v.name, _ -> bare(no_ident()) };
    let {p, node: op} = expect_ident(c, dot.p, b"an operation name")?;
    let {p, node: res} = opt_resource(c, p)?;
    let a = call_args(c, p)?;
    // An operation takes no named arguments: each is refused and dropped.
    Ok({ p: refuse_named(a.p, eff, op, a.named),
         node: EPerform({ span: span_to(expr_span(s.node), a.close), eff: eff,
                          op: op, resource: res, args: a.args }) })
  }
}

fn follows_op(k: Tok) -> Bool = k == t_lbracket() || k == t_lparen()

fn opt_resource(c: Ctx, p: P) -> Result<R<Option<Ident>>, P> =
  if !at(c, p, t_lbracket()) { Ok({ p: p, node: None }) } else {
    let o = advance(c, p);
    let {p, node: r} = expect_ident(c, o.p, b"a resource name inside `[..]`")?;
    let {p, ..} = expect_close(c, p, t_rbracket(), o.node, b"`]`")?;
    Ok({ p: p, node: Some(r) })
  }

type RArgs = { p: P, close: Span, named: List<NamedArg>, args: List<Expr> }

fn refuse_named(p: P, eff: QName, op: Ident, named: List<NamedArg>) -> P = {
  let written = match eff.module { Some(m) -> bytes_concat_all([m.name, b"::", eff.name.name]), None -> eff.name.name };
  fold(named, p, |q: P, n: NamedArg|
    push_diag(q, diag1(unknown_argument_name(), n.span,
                       bytes_concat_all([b"`", written, b".", op.name, b"` takes no named arguments"]),
                       b"named", [b"an effect operation's arguments are positional"])))
}

fn call_args(c: Ctx, p: P) -> Result<RArgs, P> = {
  let saved = p.no_brace;
  match call_args_inner(c, with_no_brace(p, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(a) -> Ok({ p: with_no_brace(a.p, saved), close: a.close,
                  named: a.named, args: a.args }),
  }
}

fn call_args_inner(c: Ctx, p: P) -> Result<RArgs, P> = {
  let {p, node: o} = expect(c, p, t_lparen(), b"`(` to start the argument list")?;
  let {p, node: parsed} = comma_list(c, p, t_rparen(), call_arg)?;
  let {p, node: cl} = expect_close(c, p, t_rparen(), o, b"`)` to close the arguments")?;
  let sp = split_args(p, parsed);
  Ok({ p: sp.p, close: cl, named: sp.named, args: sp.args })
}

fn call_arg(c: Ctx, p: P) -> Result<R<Arg>, P> =
  match kind(c, p) {
    TIdent(n) ->
      if kind_at(c, p, 1) == t_colon() { named_arg(c, p, n) }
      else { positional_arg(c, p) },
    _ -> positional_arg(c, p),
  }

fn positional_arg(c: Ctx, p: P) -> Result<R<Arg>, P> = {
  let {p, node: e} = expr(c, p)?;
  Ok({ p: p, node: APos(e) })
}

fn named_arg(c: Ctx, p: P, text: Bytes) -> Result<R<Arg>, P> = {
  let name = { name: text, span: cur_span(c, p) };
  let a = advance(c, p);
  let b = advance(c, a.p);
  let {p, node: v} = expr(c, b.p)?;
  Ok({ p: p,
       node: ANamed({ name: name, value: v,
                      span: span_to(name.span, expr_span(v)) }) })
}

// The parser's only rule about names is ordering; `first` is the first named argument's span, for the label.
type Split = { p: P, first: Option<Span>, named: List<NamedArg>, args: List<Expr> }

fn split_args(p: P, parsed: List<Arg>) -> Split =
  fold(parsed, { p: p, first: None, named: [], args: [] }, |s: Split, a: Arg|
    match a {
      APos(e) ->
        { first: s.first, named: s.named,
          p: match s.first {
               None -> s.p,
               Some(f) -> push_diag(s.p, diag2(argument_order(), expr_span(e),
                                               b"a positional argument cannot follow a named one",
                                               b"positional", f, b"the first named argument is here",
                                               [b"positional arguments fill parameters left to right, which a name in front of them would make ambiguous"])),
             },
          args: push(s.args, e) },
      ANamed(n) ->
        { p: s.p, args: s.args,
          first: match s.first { None -> Some(n.span), Some(f) -> Some(f) },
          named: push(s.named, n) },
    })

fn lit_expr(c: Ctx, p: P, l: Lit) -> Result<R<Expr>, P> = {
  let a = advance(c, p);
  Ok({ p: a.p, node: ELit({ span: a.node, lit: l }) })
}

fn primary_expr(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let st = cur_span(c, p);
  match kind(c, p) {
    TInt(v) -> lit_expr(c, p, LInt(v)),
    TFixed(ty, v) -> lit_expr(c, p, LFixed(ty, v)),
    // Float and decimal literals keep their source text.
    TFloat(f) -> lit_expr(c, p, LFloat(src_over(c, st))),
    TDec(m, sc) -> lit_expr(c, p, LDec(src_over(c, st))),
    TStr(s) -> lit_expr(c, p, LStr(s)),
    TBytes(b) -> lit_expr(c, p, LBytes(b)),
    TKw(k) ->
      if k == b"true" { lit_expr(c, p, LBool(true)) }
      else if k == b"false" { lit_expr(c, p, LBool(false)) }
      else if k == b"if" { if_expr(c, p) }
      else if k == b"match" { match_expr(c, p) }
      else if k == b"handle" { handle_expr(c, p) }
      else { Err(error_here(c, p, b"an expression")) },
    TIdent(n) -> primary_ident(c, p, n),
    TPunct(s) ->
      if s == b"lparen" { primary_paren(c, p) }
      else if s == b"lbracket" { primary_list(c, p) }
      else if s == b"lbrace" && !p.no_brace {
        if at_record_literal(c, p) { record_expr(c, p) } else { block_expr(c, p) }
      }
      else if s == b"pipe" || s == b"pipepipe" { lambda_expr(c, p) }
      else { Err(error_here(c, p, b"an expression")) },
    _ -> Err(error_here(c, p, b"an expression")),
  }
}

// Contextual, not reserved. `simulate` defers to `no_brace`, so `if simulate { .. }` is a name
// and a block.
fn primary_ident(c: Ctx, p: P, name: Bytes) -> Result<R<Expr>, P> =
  if name == b"with_cell" && kind_at(c, p, 1) == t_lbracket() {
    with_cell_expr(c, p)
  } else if name == b"with_region" && kind_at(c, p, 1) == t_lbracket() {
    with_region_expr(c, p)
  } else if name == b"simulate" && !p.no_brace && kind_at(c, p, 1) == t_lbrace() {
    simulate_expr(c, p)
  } else {
    let {p, node: q} = qname(c, p, b"an expression")?;
    Ok({ p: p, node: EVar({ span: q.span, name: q }) })
  }

fn primary_paren(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let saved = p.no_brace;
  match primary_paren_inner(c, with_no_brace(p, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ p: with_no_brace(r.p, saved), node: r.node }),
  }
}

fn primary_paren_inner(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let o = advance(c, p);
  if at(c, o.p, t_rparen()) {
    let cl = advance(c, o.p);
    Ok({ p: cl.p, node: ELit({ span: span_to(o.node, cl.node), lit: LUnit }) })
  } else {
    let inner = expr(c, o.p)?;
    if at(c, inner.p, t_comma()) {
      // A comma makes a tuple: the record `{_0: a, _1: b}`.
      let rest = comma_list(c, advance(c, inner.p).p, t_rparen(), expr)?;
      let cl = expect_close(c, rest.p, t_rparen(), o.node, b"`)` to close the tuple")?;
      let items = push_front(inner.node, rest.node);
      if len(items) == 1 {
        Ok({ p: cl.p, node: set_span(inner.node, span_to(o.node, cl.node)) })
      } else {
      Ok({ p: cl.p,
           node: ERecord({ span: span_to(o.node, cl.node),
                           fields: map(range(0, len(items)), |i: Int| -> RecField {
                             match list_at(items, i) {
                               Some(e) -> { name: positional(i, expr_span(e)), value: e },
                               None -> { name: positional(i, o.node), value: no_expr() },
                             }
                           }) }) })
      }
    } else {
      let close = expect_close(c, inner.p, t_rparen(), o.node, b"`)` to close the group")?;
      Ok({ p: close.p, node: set_span(inner.node, span_to(o.node, close.node)) })
    }
  }
}

fn primary_list(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let saved = p.no_brace;
  match primary_list_inner(c, with_no_brace(p, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ p: with_no_brace(r.p, saved), node: r.node }),
  }
}

fn primary_list_inner(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let o = advance(c, p);
  let {p, node: items} = comma_list(c, o.p, t_rbracket(), expr)?;
  let {p, node: cl} = expect_close(c, p, t_rbracket(), o.node, b"`]` to close the list")?;
  Ok({ p: p, node: EList({ span: span_to(o.node, cl), items: items }) })
}

// `{x: e}`, `{x, y}` and `{..b}` are records; `{x}` is a block whose value is `x`.
fn at_record_literal(c: Ctx, p: P) -> Bool =
  if kind_at(c, p, 1) == t_dotdot() { true } else {
    match kind_at(c, p, 1) {
      TIdent(n) -> kind_at(c, p, 2) == t_colon() || kind_at(c, p, 2) == t_comma(),
      TKw(k) -> kind_at(c, p, 2) == t_colon() || kind_at(c, p, 2) == t_comma(),
      _ -> false,
    }
  }

fn record_expr(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let saved = p.no_brace;
  match record_expr_inner(c, with_no_brace(p, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ p: with_no_brace(r.p, saved), node: r.node }),
  }
}

fn record_expr_inner(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let o = advance(c, p);
  let {p, node: base} = record_base(c, o.p)?;
  let {p, node: fields} = comma_list(c, p, t_rbrace(), record_field)?;
  let {p, node: cl} = expect_close(c, p, t_rbrace(), o.node, b"`}` to close the record")?;
  let sp = span_to(o.node, cl);
  Ok({ p: p,
       node: match base {
         None -> ERecord({ span: sp, fields: fields }),
         Some(b) -> ERecordUpdate({ span: sp, base: b, fields: fields }),
       } })
}

fn record_base(c: Ctx, p: P) -> Result<R<Option<Expr>>, P> =
  if !at(c, p, t_dotdot()) { Ok({ p: p, node: None }) } else {
    let {p, node: b} = record_update_base(c, p)?;
    if at(c, p, t_rbrace()) { Ok({ p: p, node: Some(b) }) } else {
      let {p, ..} = expect(c, p, t_comma(), b"`,` after the record being updated")?;
      Ok({ p: p, node: Some(b) })
    }
  }

// A path, not an expression: the expansion writes `base.f` once per field it copies.
fn record_update_base(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let dots = advance(c, p);
  if at(c, dots.p, t_dot()) {
    Err(push_diag(dots.p,
                  diag1(unexpected(), span_to(dots.node, cur_span(c, dots.p)),
                        b"a record update is spelled `..`, not `...`", b"one dot too many",
                        [b"`..` is the same token the record *pattern* `{a, ..}` uses"])))
  } else {
    let {p, node: name} = expect_ident(c, dots.p, b"the record being updated")?;
    iterate({ p: p, node: EVar({ span: name.span, name: bare(name) }) },
            c.ntok - p.pos + 1, |s: R<Expr>|
      if !at(c, s.p, t_dot()) { Stop(Ok(s)) } else {
        let d = advance(c, s.p);
        match expect_field_name(c, d.p, b"a field name") {
          Err(q) -> Stop(Err(q)),
          Ok(f) ->
            Continue({ p: f.p,
                       node: EField({ span: span_to(expr_span(s.node), f.node.name.span),
                                      base: s.node, field: f.node.name }) }),
        }
      })
  }
}

fn record_field(c: Ctx, p: P) -> Result<R<RecField>, P> =
  if at(c, p, t_dotdot()) {
    Err(push_diag(p, diag1(unexpected(), cur_span(c, p), b"a record update has one base, written first",
                           b"a second `..` here",
                           [b"write `{..b, x: 1, y: 2}`; two bases have no defined order of fields"])))
  } else { record_field_named(c, p) }

fn record_field_named(c: Ctx, p: P) -> Result<R<RecField>, P> = {
  let {p, node: f} = expect_field_name(c, p, b"a field name")?;
  let name = f.name;
  let colon = eat(c, p, t_colon());
  if colon.ok {
    let {p, node: v} = expr(c, colon.p)?;
    Ok({ p: p, node: {name: name, value: v} })
  } else if f.keyword {
    Err(keyword_pun_refusal(colon.p, name))
  } else {
    Ok({ p: colon.p,
         node: {name: name,
                value: EVar({ span: name.span, name: bare(name) })} })
  }
}

pub fn block_expr(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let saved = p.no_brace;
  match block_inner(c, with_no_brace(p, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ p: with_no_brace(r.p, saved), node: r.node }),
  }
}

type BlockAcc = { p: P, tail: Option<Expr>, stmts: List<Stmt> }

fn block_inner(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let {p, node: o} = expect(c, p, t_lbrace(), b"`{` to start a block")?;
  let body = iterate({p: p, tail: None, stmts: []}, c.ntok - p.pos + 1,
    |s: BlockAcc|
      if at(c, s.p, t_rbrace()) { Stop(Ok(s)) }
      else if at_eof(c, s.p) {
        Stop(Err(unclosed(c, s.p, o, b"`}` to close the block")))
      }
      else if at(c, s.p, k_let()) {
        match let_stmt(c, s.p) {
          Err(q) -> Stop(Err(q)),
          Ok(st) -> Continue({p: st.p, tail: s.tail, stmts: push(s.stmts, st.node)}),
        }
      }
      else { block_step(c, s, o) })?;
  let {p, node: cl} = expect_close(c, body.p, t_rbrace(), o, b"`}` to close the block")?;
  Ok({ p: p,
       node: EBlock({ span: span_to(o, cl), tail: body.tail,
                      stmts: body.stmts }) })
}

fn block_step(c: Ctx, s: BlockAcc, open: Span) -> Iter<BlockAcc, Result<BlockAcc, P>> =
  match expr(c, s.p) {
    Err(q) -> Stop(Err(q)),
    Ok(e) -> {
      let semi = eat(c, e.p, t_semi());
      if semi.ok {
        Continue({p: semi.p, tail: s.tail, stmts: push(s.stmts, SExpr(e.node))})
      } else if at(c, semi.p, t_rbrace()) {
        Continue({p: semi.p, tail: Some(e.node), stmts: s.stmts})
      } else if is_block_like(e.node) {
        Continue({p: semi.p, tail: s.tail, stmts: push(s.stmts, SExpr(e.node))})
      } else if at_eof(c, semi.p) {
        Stop(Err(unclosed(c, semi.p, open, b"`}` to close the block")))
      } else {
        Stop(Err(error_here(c, semi.p,
                            b"`;` to end the statement, or `}` to end the block")))
      }
    },
  }

// Its own function so `?` sits in return position: `?` in an `if` branch bound by `let` is `E0119`.
fn let_ty(c: Ctx, p: P) -> Result<R<Option<TypeExpr>>, P> = {
  let colon = eat(c, p, t_colon());
  if !colon.ok { Ok({ p: colon.p, node: None }) } else {
    let {p, node: x} = ty(c, colon.p)?;
    Ok({ p: p, node: Some(x) })
  }
}

fn let_stmt(c: Ctx, p: P) -> Result<R<Stmt>, P> = {
  let st = advance(c, p);
  let {p, node: pat} = pattern(c, st.p)?;
  let {p, node: t} = let_ty(c, p)?;
  let {p, ..} = expect(c, p, t_eq(), b"`=` and an initializer")?;
  let {p, node: value} = expr(c, p)?;
  let {p, node: semi} = expect(c, p, t_semi(), b"`;` to end the `let`")?;
  Ok({ p: p,
       node: SLet({ span: span_to(st.node, semi), pat: pat, ty: t,
                    value: value }) })
}

pub fn fn_param(c: Ctx, p: P) -> Result<R<Param>, P> = param_inner(c, p, true)

// A lambda parameter, which may not carry a default.
pub fn param(c: Ctx, p: P) -> Result<R<Param>, P> = param_inner(c, p, false)

fn param_inner(c: Ctx, p: P, allow_default: Bool) -> Result<R<Param>, P> = {
  let {p, node: n} = expect_ident(c, p, b"a parameter name")?;
  let {p, node: t} = param_ty(c, p)?;
  let {p, node: d} = param_default(c, p, allow_default)?;
  // A refused default is `None`, so the span stops before the `= 1` that was read.
  let end = match d {
    Some(e) -> expr_span(e),
    None -> match t { Some(x) -> ty_span(x), None -> n.span },
  };
  Ok({ p: p, node: { name: n, ty: t, default: d, span: span_to(n.span, end) } })
}

fn param_ty(c: Ctx, p: P) -> Result<R<Option<TypeExpr>>, P> = {
  let co = eat(c, p, t_colon());
  if !co.ok { Ok({ p: co.p, node: None }) } else {
    let {p, node: t} = ty(c, co.p)?;
    Ok({ p: p, node: Some(t) })
  }
}

// Parsed either way, so a default on a lambda is refused with the reason rather than a syntax error.
fn param_default(c: Ctx, p: P, allow: Bool) -> Result<R<Option<Expr>>, P> =
  if !at(c, p, t_eq()) { Ok({ p: p, node: None }) } else {
    let eq = advance(c, p);
    let {p, node: e} = expr(c, eq.p)?;
    if allow { Ok({ p: p, node: Some(e) }) } else {
      Ok({ p: push_diag(p, diag1(default_not_allowed(), span_to(eq.node, expr_span(e)),
                                 b"a lambda parameter cannot have a default",
                                 b"no call can omit this argument",
                                 [b"a default is filled in by matching a call against a signature, and a lambda is called through a value rather than by name"])),
           node: None })
    }
  }

pub fn no_param() -> Param =
  { name: no_ident(), ty: None, default: None, span: dummy_span() }

// `||` is one token: the empty parameter list.
fn lambda_params(c: Ctx, p: P) -> Result<R<List<Param>>, P> = {
  let empty = eat(c, p, t_pipepipe());
  if empty.ok { Ok({ p: empty.p, node: [] }) } else {
    let bar = advance(c, empty.p);
    // Inside the list a `|` closes it and is never bit-or; restored on both paths.
    let saved = bar.p.no_pipe;
    let {p, node: ps} = match comma_list(c, with_no_pipe(bar.p, true), t_pipe(), param) {
      Err(q) -> Err(with_no_pipe(q, saved)),
      Ok(r) -> Ok({ p: with_no_pipe(r.p, saved), node: r.node }),
    }?;
    let {p, ..} = expect(c, p, t_pipe(), b"`|` to close the lambda parameters")?;
    Ok({ p: p, node: ps })
  }
}

// A written return type requires a block body.
fn lambda_expr(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let st = cur_span(c, p);
  let {p, node: params} = lambda_params(c, p)?;
  let arrow = eat(c, p, t_arrow());
  if arrow.ok {
    let {p, node: ret} = ty(c, arrow.p)?;
    if !at(c, p, t_lbrace()) {
      Err(error_here(c, p, b"`{` to open the body of a lambda with a written return type"))
    } else {
      let {p, node: body} = lambda_body(c, p, true)?;
      Ok({ p: p,
           node: ELambda({ span: span_to(st, expr_span(body)),
                           body: body, params: params, ret: Some(ret) }) })
    }
  } else {
    let {p, node: body} = lambda_body(c, p, false)?;
    Ok({ p: p,
         node: ELambda({ span: span_to(st, expr_span(body)),
                         body: body, params: params, ret: None }) })
  }
}

// The body reads `|` as bit-or again whatever list encloses the lambda; restored on both paths.
fn lambda_body(c: Ctx, p: P, braced: Bool) -> Result<R<Expr>, P> = {
  let saved = p.no_pipe;
  let inner = with_no_pipe(p, false);
  match (if braced { block_expr(c, inner) } else { expr(c, inner) }) {
    Err(q) -> Err(with_no_pipe(q, saved)),
    Ok(r) -> Ok({ p: with_no_pipe(r.p, saved), node: r.node }),
  }
}

fn else_branch(c: Ctx, p: P, then_branch: Expr) -> Result<R<Expr>, P> = {
  let els = eat(c, p, k_else());
  if !els.ok {
    // No `else`: a `()` over the empty span at the end of the `then` block.
    let end = expr_span(then_branch).end;
    Ok({ p: els.p, node: ELit({ span: {start: end, end: end}, lit: LUnit }) })
  } else if at(c, els.p, k_if()) {
    if_expr(c, els.p)
  } else {
    block_expr(c, els.p)
  }
}

fn if_expr(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let st = advance(c, p);
  let {p, node: cond} = scrutinee(c, st.p)?;
  let {p, node: then_b} = block_expr(c, p)?;
  let {p, node: else_b} = else_branch(c, p, then_b)?;
  Ok({ p: p,
       node: EIf({ span: span_to(st.node, expr_span(else_b)),
                   cond: cond, then_branch: then_b,
                   else_branch: else_b }) })
}

fn match_expr(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let st = advance(c, p);
  let {p, node: scrut} = scrutinee(c, st.p)?;
  let saved = p.no_brace;
  match match_arms(c, with_no_brace(p, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(arms) -> Ok({ p: with_no_brace(arms.p, saved),
                     node: EMatch({ span: span_to(st.node, arms.close),
                                    scrutinee: scrut, arms: arms.arms }) }),
  }
}

type RArms = { p: P, close: Span, arms: List<MatchArm> }

fn match_arms(c: Ctx, p: P) -> Result<RArms, P> = {
  let {p, node: o} = expect(c, p, t_lbrace(), b"`{` to start the match arms")?;
  let body = iterate({p: p, out: []}, c.ntok - p.pos + 1, |s: Acc<MatchArm>|
    if at(c, s.p, t_rbrace()) { Stop(Ok(s)) }
    else if at_eof(c, s.p) {
      Stop(Err(unclosed(c, s.p, o, b"`}` to close the match arms")))
    }
    else { match_arm_step(c, s, o) })?;
  let {p, node: cl} = expect_close(c, body.p, t_rbrace(), o, b"`}` to close the match arms")?;
  Ok({ p: p, close: cl, arms: body.out })
}

fn arm_guard(c: Ctx, p: P) -> Result<R<Option<Expr>>, P> = {
  let gif = eat(c, p, k_if());
  if !gif.ok { Ok({ p: gif.p, node: None }) } else {
    let {p, node: g} = expr(c, gif.p)?;
    Ok({ p: p, node: Some(g) })
  }
}

fn match_arm_step(c: Ctx, s: Acc<MatchArm>, open: Span)
  -> Iter<Acc<MatchArm>, Result<Acc<MatchArm>, P>> =
  match pattern(c, s.p) {
    Err(q) -> Stop(Err(q)),
    Ok(pat) -> match arm_guard(c, pat.p) {
      Err(q) -> Stop(Err(q)),
      Ok(guard) -> match expect(c, guard.p, t_arrow(), b"`->` and the arm body") {
        Err(q) -> Stop(Err(q)),
        Ok(arrow) -> match expr(c, arrow.p) {
          Err(q) -> Stop(Err(q)),
          Ok(body) -> {
            let arm = {pat: pat.node, guard: guard.node, body: body.node,
                       span: span_to(pat_span(pat.node), expr_span(body.node))};
            // The comma is eaten before the `}` test, whichever way the test goes.
            let comma = eat(c, body.p, t_comma());
            if comma.ok || at(c, comma.p, t_rbrace()) {
              Continue({p: comma.p, out: push(s.out, arm)})
            } else if at_eof(c, comma.p) {
              Stop(Err(unclosed(c, comma.p, open, b"`}` to close the match arms")))
            } else if !is_block_like(arm.body) {
              Stop(Err(error_here(c, comma.p,
                                  b"`,` between match arms, or `}` to end the match")))
            } else {
              Continue({p: comma.p, out: push(s.out, arm)})
            }
          },
        },
      },
    },
  }

fn handle_expr(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let st = advance(c, p);
  let saved = st.p.no_brace;
  match handle_rest(c, with_no_brace(st.p, false), st.node) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ p: with_no_brace(r.p, saved), node: r.node }),
  }
}

type HAcc = { p: P, ret: Option<ReturnClause>, clauses: List<HandleClause> }

fn handle_rest(c: Ctx, p: P, st: Span) -> Result<R<Expr>, P> = {
  let {p, node: body} = expr(c, p)?;
  let {p, ..} = expect(c, p, k_with(), b"`with` and then the handler clauses")?;
  let {p, node: o} = expect(c, p, t_lbrace(), b"`{` to start the handler clauses")?;
  let acc = iterate({p: p, ret: None, clauses: []}, c.ntok - p.pos + 1, |s: HAcc|
    if at(c, s.p, t_rbrace()) { Stop(Ok(s)) }
    else if at_eof(c, s.p) {
      Stop(Err(unclosed(c, s.p, o, b"`}` to close the handler")))
    }
    else { handle_step(c, s) })?;
  let {p, node: cl} = expect_close(c, acc.p, t_rbrace(), o, b"`}` to close the handler")?;
  Ok({ p: p,
       node: EHandle({ span: span_to(st, cl), body: body,
                       ret: acc.ret, clauses: acc.clauses }) })
}

// `return` is contextual here too: it is a clause only when a name follows it.
fn handle_step(c: Ctx, s: HAcc) -> Iter<HAcc, Result<HAcc, P>> =
  if at_ident_text(c, s.p, b"return") && is_ident_at(c, s.p, 1) {
    match return_clause(c, s.p) {
      Err(q) -> Stop(Err(q)),
      Ok(rc) -> {
        let next = match s.ret {
          None -> {p: rc.p, clauses: s.clauses, ret: Some(rc.node)},
          // A duplicate `return` is reported and dropped; the parse carries on.
          Some(prev) ->
            {p: push_diag(rc.p, diag2(unexpected(), rc.node.span,
                                      b"a handler may have only one `return` clause",
                                      b"duplicate `return` clause", prev.span, b"first one is here", [])),
             clauses: s.clauses, ret: s.ret},
        };
        let comma = eat(c, next.p, t_comma());
        Continue({p: comma.p, ret: next.ret, clauses: next.clauses})
      },
    }
  } else {
    match handle_clause(c, s.p) {
      Err(q) -> Stop(Err(q)),
      Ok(cl) -> {
        let comma = eat(c, cl.p, t_comma());
        Continue({p: comma.p, ret: s.ret, clauses: push(s.clauses, cl.node)})
      },
    }
  }

fn is_ident_at(c: Ctx, p: P, n: Int) -> Bool =
  match kind_at(c, p, n) { TIdent(x) -> true, _ -> false }

// `resume` is a keyword only between a clause's `)` and its `->`.
fn clause_resume(c: Ctx, p: P) -> Result<R<Option<Ident>>, P> =
  if !at_ident_text(c, p, b"resume") { Ok({ p: p, node: None }) } else {
    let a = advance(c, p);
    let {p, node: n} = expect_ident(c, a.p, b"a name to bind the continuation to")?;
    Ok({ p: p, node: Some(n) })
  }

fn handle_clause(c: Ctx, p: P) -> Result<R<HandleClause>, P> = {
  let {p, node: eff} = qname(c, p, b"an effect name, or `return`")?;
  let {p, ..} = expect(c, p, t_dot(), b"`.` and the operation name")?;
  let {p, node: op} = expect_ident(c, p, b"an operation name")?;
  let {p, node: res} = opt_resource(c, p)?;
  let {p, node: o} = expect(c, p, t_lparen(), b"`(` to start the clause parameters")?;
  let {p, node: params} = comma_list(c, p, t_rparen(), clause_param)?;
  let {p, ..} = expect_close(c, p, t_rparen(), o,
                             b"`)` to close the clause parameters")?;
  let {p, node: resume} = clause_resume(c, p)?;
  let {p, ..} = expect(c, p, t_arrow(), b"`->` and the clause body")?;
  let {p, node: body} = expr(c, p)?;
  Ok({ p: p,
       node: {eff: eff, op: op, resource: res, resume: resume,
              body: body, span: span_to(eff.span, expr_span(body)),
              params: params} })
}

fn clause_param(c: Ctx, p: P) -> Result<R<Ident>, P> =
  expect_ident(c, p, b"a clause parameter name")

fn return_clause(c: Ctx, p: P) -> Result<R<ReturnClause>, P> = {
  let st = advance(c, p);
  let {p, node: binder} = expect_ident(c, st.p, b"a binder after `return`")?;
  let {p, ..} = expect(c, p, t_arrow(), b"`->` and the `return` body")?;
  let {p, node: body} = expr(c, p)?;
  Ok({ p: p,
       node: {binder: binder, body: body,
              span: span_to(st.node, expr_span(body))} })
}

fn with_cell_expr(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let st = advance(c, p);
  let {p, node: br} = expect(c, st.p, t_lbracket(), b"`[` and a resource name")?;
  let {p, node: resource} = expect_ident(c, p, b"a resource name inside `[..]`")?;
  let {p, ..} = expect_close(c, p, t_rbracket(), br, b"`]`")?;
  let saved = p.no_brace;
  match with_cell_rest(c, with_no_brace(p, false), st.node, resource) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ p: with_no_brace(r.p, saved), node: r.node }),
  }
}

fn with_cell_rest(c: Ctx, p: P, st: Span, resource: Ident) -> Result<R<Expr>, P> = {
  let {p, node: paren} = expect(c, p, t_lparen(), b"`(` and the cell's initial value")?;
  let {p, node: init} = expr(c, p)?;
  let {p, ..} = expect_close(c, p, t_rparen(), paren, b"`)` after the initial value")?;
  let {p, node: brace} = expect(c, p, t_lbrace(), b"`{` to start the cell's region")?;
  let {p, node: binder} = expect_ident(c, p, b"a name to bind the cell to")?;
  let {p, ..} = expect(c, p, t_arrow(), b"`->` and the region body")?;
  let {p, node: body} = expr(c, p)?;
  let {p, node: cl} = expect_close(c, p, t_rbrace(), brace,
                                   b"`}` to close the cell's region")?;
  Ok({ p: p,
       node: EWithCell({ span: span_to(st, cl), resource: resource,
                         init: init, binder: binder, body: body }) })
}

fn with_region_expr(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let st = advance(c, p);
  let {p, node: br} = expect(c, st.p, t_lbracket(), b"`[` and a region name")?;
  let {p, node: region} = expect_ident(c, p, b"a region name inside `[..]`")?;
  let {p, ..} = expect_close(c, p, t_rbracket(), br, b"`]`")?;
  let {p, node: body} = block_expr(c, p)?;
  Ok({ p: p,
       node: EWithRegion({ span: span_to(st.node, expr_span(body)),
                           region: region, body: body }) })
}

fn simulate_expr(c: Ctx, p: P) -> Result<R<Expr>, P> = {
  let st = advance(c, p);
  let {p, node: body} = block_expr(c, st.p)?;
  Ok({ p: p,
       node: ESimulate({ span: span_to(st.node, expr_span(body)),
                         body: body }) })
}

// --- The dump ---------------------------------------------------------------

pub fn dump_expr(e: Expr) -> Bytes =
  match e {
    ELit(v) -> bytes_concat(rec(v.span, b"elit"), dump_lit(v.lit)),
    EVar(v) -> bytes_concat(rec(v.span, b"evar"), dump_qname(v.name)),
    EBinary(v) -> bytes_concat_all([rec(v.span, b"ebin"), word(v.op),
                                    dump_expr(v.lhs), dump_expr(v.rhs)]),
    EUnary(v) -> bytes_concat_all([rec(v.span, b"eun"), word(v.op),
                                   dump_expr(v.operand)]),
    ELambda(v) -> bytes_concat_all([rec(v.span, b"elam"),
                                    dump_list(v.params, dump_param),
                                    dump_opt(v.ret, dump_ty),
                                    dump_expr(v.body)]),
    EApp(v) -> bytes_concat_all([rec(v.span, b"eapp"), dump_expr(v.func),
                                 dump_list(v.args, dump_expr),
                                 dump_list(v.named, dump_named)]),
    EIf(v) -> bytes_concat_all([rec(v.span, b"eif"), dump_expr(v.cond),
                                dump_expr(v.then_branch), dump_expr(v.else_branch)]),
    EMatch(v) -> bytes_concat_all([rec(v.span, b"emat"), dump_expr(v.scrutinee),
                                   dump_list(v.arms, dump_arm)]),
    EBlock(v) -> bytes_concat_all([rec(v.span, b"eblk"), dump_list(v.stmts, dump_stmt),
                                   dump_opt(v.tail, dump_expr)]),
    ERecord(v) -> bytes_concat(rec(v.span, b"erec"), dump_list(v.fields, dump_field)),
    ERecordUpdate(v) -> bytes_concat_all([rec(v.span, b"erup"), dump_expr(v.base),
                                          dump_list(v.fields, dump_field)]),
    ETry(v) -> bytes_concat(rec(v.span, b"etry"), dump_expr(v.operand)),
    EField(v) -> bytes_concat_all([rec(v.span, b"efld"), dump_expr(v.base),
                                   dump_ident(v.field)]),
    EList(v) -> bytes_concat(rec(v.span, b"elst"), dump_list(v.items, dump_expr)),
    EPerform(v) -> bytes_concat_all([rec(v.span, b"eprf"), dump_qname(v.eff),
                                     dump_ident(v.op), dump_opt(v.resource, dump_ident),
                                     dump_list(v.args, dump_expr)]),
    EHandle(v) -> bytes_concat_all([rec(v.span, b"ehnd"), dump_expr(v.body),
                                    dump_list(v.clauses, dump_clause),
                                    dump_opt(v.ret, dump_return)]),
    EWithCell(v) -> bytes_concat_all([rec(v.span, b"ecel"), dump_ident(v.resource),
                                      dump_expr(v.init), dump_ident(v.binder),
                                      dump_expr(v.body)]),
    EWithRegion(v) -> bytes_concat_all([rec(v.span, b"ergn"), dump_ident(v.region),
                                        dump_expr(v.body)]),
    ESimulate(v) -> bytes_concat(rec(v.span, b"esim"), dump_expr(v.body)),
    EBad(v) -> rec(v.span, b"ebad"),
  }

fn dump_field(f: RecField) -> Bytes =
  bytes_concat(dump_ident(f.name), dump_expr(f.value))

fn dump_named(n: NamedArg) -> Bytes =
  bytes_concat_all([rec(n.span, b"narg"), dump_ident(n.name), dump_expr(n.value)])

pub fn dump_param(pa: Param) -> Bytes =
  bytes_concat_all([rec(pa.span, b"prm"), dump_ident(pa.name),
                    dump_opt(pa.ty, dump_ty), dump_opt(pa.default, dump_expr)])

pub fn dump_stmt(s: Stmt) -> Bytes =
  match s {
    SLet(v) -> bytes_concat_all([rec(v.span, b"slet"), dump_pattern(v.pat),
                                 dump_opt(v.ty, dump_ty), dump_expr(v.value)]),
    SExpr(e) -> bytes_concat(rec(expr_span(e), b"sexp"), dump_expr(e)),
  }

pub fn dump_arm(m: MatchArm) -> Bytes =
  bytes_concat_all([rec(m.span, b"arm"), dump_pattern(m.pat),
                    dump_opt(m.guard, dump_expr), dump_expr(m.body)])

pub fn dump_clause(h: HandleClause) -> Bytes =
  bytes_concat_all([rec(h.span, b"hcl"), dump_qname(h.eff), dump_ident(h.op),
                    dump_opt(h.resource, dump_ident),
                    dump_list(h.params, dump_ident),
                    dump_opt(h.resume, dump_ident), dump_expr(h.body)])

pub fn dump_return(r: ReturnClause) -> Bytes =
  bytes_concat_all([rec(r.span, b"rcl"), dump_ident(r.binder), dump_expr(r.body)])

// --- The area's own entry point ---------------------------------------------
// One expression, then end of input; on failure the dump is the diagnostics alone.
pub fn dump_expr_of(src: Bytes) -> String = {
  let s = start(src);
  let r = expr(s.c, s.p);
  let v = settle(r, no_expr());
  let bad = failed(r);
  let fin = if bad || at_eof(s.c, v.p) { v.p }
            else { error_here(s.c, v.p, b"end of input after the expression") };
  let tree = if bad || !at_eof(s.c, v.p) { b"" } else { dump_expr(v.node) };
  string_of_bytes(bytes_concat(tree, dump_diags(fin.diags)))
}

pub fn dump_param_of(src: Bytes) -> String = {
  let s = start(src);
  let r = settle(param(s.c, s.p), no_param());
  string_of_bytes(bytes_concat(dump_param(r.node), dump_diags(r.p.diags)))
}

pub fn dump_fn_param_of(src: Bytes) -> String = {
  let s = start(src);
  let r = settle(fn_param(s.c, s.p), no_param());
  string_of_bytes(bytes_concat(dump_param(r.node), dump_diags(r.p.diags)))
}

// Total on purpose: a probe uses it to touch the whole tree.
pub fn node_count(e: Expr) -> Int =
  match e {
    ELit(v) -> 1,
    EVar(v) -> 1,
    EBinary(v) -> 1 + node_count(v.lhs) + node_count(v.rhs),
    EUnary(v) -> 1 + node_count(v.operand),
    ELambda(v) -> 1 + count_params(v.params) + node_count(v.body),
    EApp(v) -> 1 + node_count(v.func) + count_all(v.args)
                 + fold(v.named, 0, |n: Int, a: NamedArg| n + 1 + node_count(a.value)),
    EIf(v) -> 1 + node_count(v.cond) + node_count(v.then_branch)
                + node_count(v.else_branch),
    EMatch(v) -> 1 + node_count(v.scrutinee)
                   + fold(v.arms, 0, |n: Int, m: MatchArm|
                       n + 1 + count_opt(m.guard) + node_count(m.body)),
    EBlock(v) -> 1 + fold(v.stmts, 0, |n: Int, s: Stmt| n + count_stmt(s))
                   + count_opt(v.tail),
    ERecord(v) -> 1 + fold(v.fields, 0, |n: Int, f: RecField| n + 1 + node_count(f.value)),
    ERecordUpdate(v) -> 1 + node_count(v.base)
                          + fold(v.fields, 0, |n: Int, f: RecField|
                              n + 1 + node_count(f.value)),
    ETry(v) -> 1 + node_count(v.operand),
    EField(v) -> 1 + node_count(v.base),
    EList(v) -> 1 + count_all(v.items),
    EPerform(v) -> 1 + count_all(v.args),
    EHandle(v) -> 1 + node_count(v.body)
                    + fold(v.clauses, 0, |n: Int, h: HandleClause|
                        n + 1 + len(h.params) + node_count(h.body))
                    + (match v.ret { None -> 0, Some(r) -> 1 + node_count(r.body) }),
    EWithCell(v) -> 1 + node_count(v.init) + node_count(v.body),
    EWithRegion(v) -> 1 + node_count(v.body),
    ESimulate(v) -> 1 + node_count(v.body),
    EBad(v) -> 1,
  }

fn count_all(xs: List<Expr>) -> Int = fold(xs, 0, |n: Int, x: Expr| n + node_count(x))

pub fn count_params(ps: List<Param>) -> Int =
  fold(ps, 0, |n: Int, pa: Param| n + 1 + count_opt(pa.default))

fn count_opt(o: Option<Expr>) -> Int = match o { None -> 0, Some(x) -> node_count(x) }

fn count_stmt(s: Stmt) -> Int =
  match s { SLet(v) -> 1 + node_count(v.value), SExpr(e) -> 1 + node_count(e) }

pub fn parse_count(src: Bytes) -> Int = {
  let s = start(src);
  node_count(settle(expr(s.c, s.p), no_expr()).node)
}

// Parses and reads only the final position, to price parsing without the walk.
pub fn parse_pos(src: Bytes) -> Int = {
  let s = start(src);
  settle(expr(s.c, s.p), no_expr()).p.pos
}

// --- Tests ------------------------------------------------------------------

test "the bit operators sit between the comparisons and the concatenation, loosest first" {
  assert_eq(dump_expr_of(b"a | b ^ c & d"),
            "0:13:ebin;%bitor;0:1:evar;0:1:qname;?0;0:1:ident;@61;4:13:ebin;%bitxor;4"
            ++ ":5:evar;4:5:qname;?0;4:5:ident;@62;8:13:ebin;%bitand;8:9:evar;8:9:qname;"
            ++ "?0;8:9:ident;@63;12:13:evar;12:13:qname;?0;12:13:ident;@64;#0;")
}

test "a shift is touching `<`s or `>`s, and `>>>` is read before `>>`" {
  assert_eq(dump_expr_of(b"a << b >> c >>> d"),
            "0:17:ebin;%ushr;0:11:ebin;%shr;0:6:ebin;%shl;0:1:evar;0:1:qname;?0;0:1:i"
            ++ "dent;@61;5:6:evar;5:6:qname;?0;5:6:ident;@62;10:11:evar;10:11:qname;?0;1"
            ++ "0:11:ident;@63;16:17:evar;16:17:qname;?0;16:17:ident;@64;#0;")
}

test "`~` is a unary operator, tighter than any binary" {
  assert_eq(dump_expr_of(b"~a + b"), "0:6:ebin;%add;0:2:eun;%bitnot;1:2:evar;1:2:qname;?0;1:2:ident;@61;5:6:ev"
            ++ "ar;5:6:qname;?0;5:6:ident;@62;#0;")
}

test "inside a lambda's parameter list a `|` closes the list; in its body it is bit-or again" {
  // `x = 1` is a default, refused as `E0120`.
  assert_eq(dump_expr_of(b"|x = 1| x | 2"),
            "0:13:elam;#1;1:2:prm;1:2:ident;@78;?0;?0;?0;8:13:ebin;%bitor;8:9:evar;8:"
            ++ "9:qname;?0;8:9:ident;@78;12:13:elit;%int;@32;#1;!E0120:3:6:1:1;=3:6:1;")
}

test "a keyword names a field in a literal and after `.`" {
  assert_eq(dump_expr_of(b"{effect: 1, type: 2}.type"),
            "0:25:efld;0:20:erec;#2;1:7:ident;@656666656374;9:10:elit;%int;@31;12:16:"
            ++ "ident;@74797065;18:19:elit;%int;@32;21:25:ident;@74797065;#0;")
}

test "the try operator is a node of its own and takes the `?` into its span" {
  assert_eq(dump_expr_of(b"x?"),
            "0:2:etry;0:1:evar;0:1:qname;?0;0:1:ident;@78;#0;");
  // `x??` nests left.
  assert_eq(dump_expr_of(b"x??"),
            "0:3:etry;0:2:etry;0:1:evar;0:1:qname;?0;0:1:ident;@78;#0;");
}

test "the try operator binds tighter than a unary and than any binary" {
  // `-x?` is `-(x?)`: the `eun` is outside.
  assert_eq(dump_expr_of(b"-x?"),
            "0:3:eun;%neg;1:3:etry;1:2:evar;1:2:qname;?0;1:2:ident;@78;#0;");
  // `x? + y` is `(x?) + y`.
  assert_eq(dump_expr_of(b"x? + y"),
            "0:6:ebin;%add;0:2:etry;0:1:evar;0:1:qname;?0;0:1:ident;@78;"
            ++ "5:6:evar;5:6:qname;?0;5:6:ident;@79;#0;")
}

test "a record update carries its base, and `{..b}` needs no comma" {
  assert_eq(dump_expr_of(b"{..b, x: 1}"),
            "0:11:erup;3:4:evar;3:4:qname;?0;3:4:ident;@62;#1;6:7:ident;@78;"
            ++ "9:10:elit;%int;@31;#0;");
  assert_eq(dump_expr_of(b"{..b}"),
            "0:5:erup;3:4:evar;3:4:qname;?0;3:4:ident;@62;#0;#0;")
}

test "the base of a record update is a path and not an expression" {
  assert_eq(dump_expr_of(b"{..s.i, x: 1}"),
            "0:13:erup;3:6:efld;3:4:evar;3:4:qname;?0;3:4:ident;@73;5:6:ident;@69;"
            ++ "#1;8:9:ident;@78;11:12:elit;%int;@31;#0;");
  // `...b` is one dot too many.
  assert_eq(dump_expr_of(b"{...b}"), "#1;!E0001:1:4:1:1;=1:4:1;");
  // A second `..` has no defined order of fields.
  assert_eq(dump_expr_of(b"{..a, ..b}"), "#1;!E0001:6:8:1:1;=6:8:1;")
}

test "a named argument is a node with its own span, its name and its value" {
  assert_eq(dump_expr_of(b"f(1, b: 2)"),
            "0:10:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#1;2:3:elit;%int;@31;"
            ++ "#1;5:9:narg;5:6:ident;@62;8:9:elit;%int;@32;#0;");
  // The two-token lookahead: `f(x)` is positional and `f(x: 1)` is not.
  assert_eq(dump_expr_of(b"f(x)"),
            "0:4:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#1;2:3:evar;2:3:qname;?0;"
            ++ "2:3:ident;@78;#0;#0;")
}

// Neither `E0124` nor `E0123` fails the parse, so the call is still built and dumped.
test "a positional argument after a named one is refused, once each" {
  // Each offending positional points back at the first named argument.
  assert_eq(dump_expr_of(b"f(a: 1, 2)"),
            "0:10:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#1;8:9:elit;%int;@32;"
            ++ "#1;2:6:narg;2:3:ident;@61;5:6:elit;%int;@31;"
            ++ "#1;!E0124:8:9:2:1;=8:9:1;=2:6:0;");
  assert_eq(dump_expr_of(b"f(a: 1, 2, 3)"),
            "0:13:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#2;8:9:elit;%int;@32;"
            ++ "11:12:elit;%int;@33;#1;2:6:narg;2:3:ident;@61;5:6:elit;%int;@31;"
            ++ "#2;!E0124:8:9:2:1;=8:9:1;=2:6:0;!E0124:11:12:2:1;=11:12:1;=2:6:0;")
}

test "an effect operation takes no named argument" {
  // Dropped as well as refused: the `eprf` carries no arguments.
  assert_eq(dump_expr_of(b"d.op(k: 1)"),
            "0:10:eprf;0:1:qname;?0;0:1:ident;@64;2:4:ident;@6f70;?0;#0;"
            ++ "#1;!E0123:5:9:1:1;=5:9:1;")
}

test "a parameter's type and its default are both optional" {
  assert_eq(dump_param_of(b"x"), "0:1:prm;0:1:ident;@78;?0;?0;#0;");
  assert_eq(dump_param_of(b"x: Int"),
            "0:6:prm;0:1:ident;@78;?1;3:6:tcon;3:6:qname;?0;3:6:ident;@496e74;#0;?0;#0;");
  assert_eq(dump_param_of(b"x: (Int) -> Bool"),
            "0:16:prm;0:1:ident;@78;?1;3:16:tfn;#1;4:7:tcon;4:7:qname;?0;4:7:ident;@496e74;#0;12:16:tcon;12:16:qname;?0;12:16:ident;@426f6f6c;#0;?0;?0;#0;");
  assert_eq(dump_param_of(b"x:"), "0:0:prm;0:0:ident;@;?0;?0;#1;!E0001:2:2:1:0;=2:2:1;")
}

test "a fn parameter may carry a default and a lambda parameter may not" {
  assert_eq(dump_fn_param_of(b"x: Int = 1"),
            "0:10:prm;0:1:ident;@78;?1;3:6:tcon;3:6:qname;?0;3:6:ident;@496e74;#0;"
            ++ "?1;9:10:elit;%int;@31;#0;");
  assert_eq(dump_fn_param_of(b"x = 1"),
            "0:5:prm;0:1:ident;@78;?0;?1;4:5:elit;%int;@31;#0;");
  // Refused, so `default` is `None` and the span ends at the type.
  assert_eq(dump_param_of(b"x: Int = 1"),
            "0:6:prm;0:1:ident;@78;?1;3:6:tcon;3:6:qname;?0;3:6:ident;@496e74;#0;"
            ++ "?0;#1;!E0120:7:10:1:1;=7:10:1;")
}

test "a literal keeps its own span and its decoded value" {
  assert_eq(dump_expr_of(b"1"), "0:1:elit;%int;@31;#0;");
  assert_eq(dump_expr_of(b"true"), "0:4:elit;%bool;@31;#0;");
  assert_eq(dump_expr_of(b"()"), "0:2:elit;%unit;#0;");
  assert_eq(dump_expr_of(b"\"a\\n\""), "0:5:elit;%str;@610a;#0;");
}

test "a float and a decimal are the source text, and no value is ever built" {
  assert_eq(dump_expr_of(b"1.5e-3"), "0:6:elit;%float;@312e35652d33;#0;");
  assert_eq(dump_expr_of(b"1.50m"), "0:5:elit;%dec;@312e35306d;#0;");
}

test "precedence binds the tighter operator first and stays left-associative" {
  assert_eq(dump_expr_of(b"1 + 2 * 3"),
            "0:9:ebin;%add;0:1:elit;%int;@31;4:9:ebin;%mul;4:5:elit;%int;@32;8:9:elit;%int;@33;#0;");
  assert_eq(dump_expr_of(b"1 - 2 - 3"),
            "0:9:ebin;%sub;0:5:ebin;%sub;0:1:elit;%int;@31;4:5:elit;%int;@32;8:9:elit;%int;@33;#0;");
}

test "a long left-associative chain is one iterate and adds no frames" {
  let whole = bytes_concat(bytes_concat_all(map(range(0, 400), |i: Int| b"1 + ")), b"1");
  let s = start(whole);
  let rr = expr(s.c, s.p);
  assert(!failed(rr));
  let r = settle(rr, no_expr());
  assert_eq(len(r.p.diags), 0);
  assert_eq(r.p.depth, 0);
  assert_eq(node_count(r.node), 801);
}

test "a unary operator nests, and a `-` before a literal is an operator here" {
  assert_eq(dump_expr_of(b"-1"), "0:2:eun;%neg;1:2:elit;%int;@31;#0;");
  assert_eq(dump_expr_of(b"!x"), "0:2:eun;%not;1:2:evar;1:2:qname;?0;1:2:ident;@78;#0;");
}

test "application and field access chain left to right" {
  assert_eq(dump_expr_of(b"f(1)(2)"),
            "0:7:eapp;0:4:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#1;2:3:elit;%int;@31;#0;#1;5:6:elit;%int;@32;#0;#0;");
  assert_eq(dump_expr_of(b"r.a.b"),
            "0:5:efld;0:3:efld;0:1:evar;0:1:qname;?0;0:1:ident;@72;2:3:ident;@61;4:5:ident;@62;#0;");
}

test "a `.` before a name and an argument list is a perform, not a field read" {
  assert_eq(dump_expr_of(b"db.get[users](k)"),
            "0:16:eprf;0:2:qname;?0;0:2:ident;@6462;3:6:ident;@676574;?1;7:12:ident;@7573657273;#1;14:15:evar;14:15:qname;?0;14:15:ident;@6b;#0;");
  assert_eq(dump_expr_of(b"db.get(k)"),
            "0:9:eprf;0:2:qname;?0;0:2:ident;@6462;3:6:ident;@676574;?0;#1;7:8:evar;7:8:qname;?0;7:8:ident;@6b;#0;");
  assert_eq(dump_expr_of(b"db.get"),
            "0:6:efld;0:2:evar;0:2:qname;?0;0:2:ident;@6462;3:6:ident;@676574;#0;");
}

test "a brace after an `if` scrutinee opens the block, never a record" {
  assert_eq(dump_expr_of(b"if x { 1 } else { 2 }"),
            "0:21:eif;3:4:evar;3:4:qname;?0;3:4:ident;@78;5:10:eblk;#0;?1;7:8:elit;%int;@31;16:21:eblk;#0;?1;18:19:elit;%int;@32;#0;");
}

test "an `if` with no `else` gets a unit whose span is empty and at the end" {
  assert_eq(dump_expr_of(b"if x { 1 }"),
            "0:10:eif;3:4:evar;3:4:qname;?0;3:4:ident;@78;5:10:eblk;#0;?1;7:8:elit;%int;@31;10:10:elit;%unit;#0;");
}

test "`else if` chains rather than nesting a block" {
  assert_eq(dump_expr_of(b"if a { 1 } else if b { 2 }"),
            "0:26:eif;3:4:evar;3:4:qname;?0;3:4:ident;@61;5:10:eblk;#0;?1;7:8:elit;%int;@31;16:26:eif;19:20:evar;19:20:qname;?0;19:20:ident;@62;21:26:eblk;#0;?1;23:24:elit;%int;@32;26:26:elit;%unit;#0;");
}

test "`{x: e}` and `{x, y}` are records and `{x}` is a block" {
  assert_eq(dump_expr_of(b"{a: 1}"), "0:6:erec;#1;1:2:ident;@61;4:5:elit;%int;@31;#0;");
  assert_eq(dump_expr_of(b"{a, b}"),
            "0:6:erec;#2;1:2:ident;@61;1:2:evar;1:2:qname;?0;1:2:ident;@61;4:5:ident;@62;4:5:evar;4:5:qname;?0;4:5:ident;@62;#0;");
  assert_eq(dump_expr_of(b"{a}"),
            "0:3:eblk;#0;?1;1:2:evar;1:2:qname;?0;1:2:ident;@61;#0;");
}

test "a block separates its statements from its tail" {
  assert_eq(dump_expr_of(b"{ let x = 1; x }"),
            "0:16:eblk;#1;2:12:slet;6:7:pvar;6:7:ident;@78;?0;10:11:elit;%int;@31;?1;13:14:evar;13:14:qname;?0;13:14:ident;@78;#0;");
  assert_eq(dump_expr_of(b"{ 1; }"), "0:6:eblk;#1;2:3:sexp;2:3:elit;%int;@31;?0;#0;");
}

test "a block-like statement needs no semicolon and anything else does" {
  assert_eq(dump_expr_of(b"{ if a { 1 } 2 }"),
            "0:16:eblk;#1;2:12:sexp;2:12:eif;5:6:evar;5:6:qname;?0;5:6:ident;@61;7:12:eblk;#0;?1;9:10:elit;%int;@31;12:12:elit;%unit;?1;13:14:elit;%int;@32;#0;");
  assert_eq(dump_expr_of(b"{ 1 2 }"), "#1;!E0001:4:5:1:0;=4:5:1;");
}

test "a lambda takes typed or untyped parameters, and `||` takes none" {
  assert_eq(dump_expr_of(b"|x| x"),
            "0:5:elam;#1;1:2:prm;1:2:ident;@78;?0;?0;?0;4:5:evar;4:5:qname;?0;4:5:ident;@78;#0;");
  assert_eq(dump_expr_of(b"|| 1"), "0:4:elam;#0;?0;3:4:elit;%int;@31;#0;");
  assert_eq(dump_expr_of(b"|x: Int| x"),
            "0:10:elam;#1;1:7:prm;1:2:ident;@78;?1;4:7:tcon;4:7:qname;?0;4:7:ident;@496e74;#0;?0;?0;9:10:evar;9:10:qname;?0;9:10:ident;@78;#0;");
}

test "a match arm takes a guard and needs a comma unless its body is block-like" {
  assert_eq(dump_expr_of(b"match x { 1 -> 2, _ -> 3 }"),
            "0:26:emat;6:7:evar;6:7:qname;?0;6:7:ident;@78;#2;10:16:arm;10:11:plit;%int;@31;?0;15:16:elit;%int;@32;18:24:arm;18:19:pwld;?0;23:24:elit;%int;@33;#0;");
  assert_eq(dump_expr_of(b"match x { y if y -> 1 }"),
            "0:23:emat;6:7:evar;6:7:qname;?0;6:7:ident;@78;#1;10:21:arm;10:11:pvar;10:11:ident;@79;?1;15:16:evar;15:16:qname;?0;15:16:ident;@79;20:21:elit;%int;@31;#0;");
  assert_eq(dump_expr_of(b"match x { 1 -> 2 _ -> 3 }"), "#1;!E0001:17:18:1:0;=17:18:1;");
}

test "a handler takes clauses, a resume binder and at most one `return`" {
  assert_eq(dump_expr_of(b"handle f() with { e.op(a) resume k -> k(a), return v -> v }"),
            "0:59:ehnd;7:10:eapp;7:8:evar;7:8:qname;?0;7:8:ident;@66;#0;#0;#1;18:42:hcl;18:19:qname;?0;18:19:ident;@65;20:22:ident;@6f70;?0;#1;23:24:ident;@61;?1;33:34:ident;@6b;38:42:eapp;38:39:evar;38:39:qname;?0;38:39:ident;@6b;#1;40:41:evar;40:41:qname;?0;40:41:ident;@61;#0;?1;44:57:rcl;51:52:ident;@76;56:57:evar;56:57:qname;?0;56:57:ident;@76;#0;");
  let two = dump_expr_of(b"handle f() with { return a -> a, return b -> b }");
  assert(string_contains(two, "!E0001:33:46:2:0;=33:46:1;=18:31:0;"));
}

test "`with_cell`, `with_region` and `simulate` are contextual" {
  assert_eq(dump_expr_of(b"with_cell[u](0) { s -> s }"),
            "0:26:ecel;10:11:ident;@75;13:14:elit;%int;@30;18:19:ident;@73;23:24:evar;23:24:qname;?0;23:24:ident;@73;#0;");
  assert_eq(dump_expr_of(b"with_region[r] { 1 }"),
            "0:20:ergn;12:13:ident;@72;15:20:eblk;#0;?1;17:18:elit;%int;@31;#0;");
  assert_eq(dump_expr_of(b"simulate { 1 }"),
            "0:14:esim;9:14:eblk;#0;?1;11:12:elit;%int;@31;#0;");
  // Each is an ordinary name wherever the shape does not hold.
  assert_eq(dump_expr_of(b"simulate"),
            "0:8:evar;0:8:qname;?0;0:8:ident;@73696d756c617465;#0;");
  assert_eq(dump_expr_of(b"with_cell"),
            "0:9:evar;0:9:qname;?0;0:9:ident;@776974685f63656c6c;#0;");
}

test "in a scrutinee a `{` is the arm block, so `simulate` is a name there" {
  assert_eq(dump_expr_of(b"if simulate { 1 }"),
            "0:17:eif;3:11:evar;3:11:qname;?0;3:11:ident;@73696d756c617465;12:17:eblk;#0;?1;14:15:elit;%int;@31;17:17:elit;%unit;#0;");
}

test "an argument list clears no_brace so a record may be written inside one" {
  assert_eq(dump_expr_of(b"if f({a: 1}) { 2 }"),
            "0:18:eif;3:12:eapp;3:4:evar;3:4:qname;?0;3:4:ident;@66;#1;5:11:erec;#1;6:7:ident;@61;9:10:elit;%int;@31;#0;13:18:eblk;#0;?1;15:16:elit;%int;@32;18:18:elit;%unit;#0;");
}

test "a list expression, an empty one, and a qualified name" {
  assert_eq(dump_expr_of(b"[1, 2]"),
            "0:6:elst;#2;1:2:elit;%int;@31;4:5:elit;%int;@32;#0;");
  assert_eq(dump_expr_of(b"[]"), "0:2:elst;#0;#0;");
  assert_eq(dump_expr_of(b"m::f(1)"),
            "0:7:eapp;0:4:evar;0:4:qname;?1;0:1:ident;@6d;3:4:ident;@66;#1;5:6:elit;%int;@31;#0;#0;");
}

test "a parenthesized expression takes the parentheses into its span" {
  assert_eq(dump_expr_of(b"(1 + 2)"),
            "0:7:ebin;%add;1:2:elit;%int;@31;5:6:elit;%int;@32;#0;");
}

test "an unclosed group reports against the opener as a secondary label" {
  assert_eq(dump_expr_of(b"(1"), "#1;!E0001:2:2:2:0;=2:2:1;=0:1:0;");
}

test "one offset raises one diagnostic, which is `Parser::push`'s dedup rule" {
  let s = start(b"*");
  let r = expr(s.c, s.p);
  assert(failed(r));
  assert_eq(len(settle(r, no_expr()).p.diags), 1);
}

test "the node count walks every node of a small tree" {
  assert_eq(parse_count(b"1 + 2 * 3"), 5);
  assert_eq(parse_count(b"{ let x = 1; [x, x] }"), 6);
}

test "past MAX_DEPTH the parser reports rather than overflowing" {
  let n = 200;
  let deep = bytes_concat(bytes_concat_all(map(range(0, n), |i: Int| b"(")),
                          bytes_concat(b"1", bytes_concat_all(map(range(0, n), |i: Int| b")"))));
  let s = start(deep);
  let r = expr(s.c, s.p);
  assert(failed(r));
  assert_eq(len(settle(r, no_expr()).p.diags), 1);
}

test "just under MAX_DEPTH it does not" {
  let n = 60;
  let deep = bytes_concat(bytes_concat_all(map(range(0, n), |i: Int| b"(")),
                          bytes_concat(b"1", bytes_concat_all(map(range(0, n), |i: Int| b")"))));
  let s = start(deep);
  let r = expr(s.c, s.p);
  assert(!failed(r));
  assert_eq(len(settle(r, no_expr()).p.diags), 0);
}
