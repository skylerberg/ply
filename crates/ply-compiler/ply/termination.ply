// Termination: whether a recursive group's calls back into itself descend. Size-change
// termination (Lee, Jones and Ben-Amram 2001): each call is a graph from the caller's measures to
// the callee's, saying which the call keeps from growing and which it shrinks; the group terminates
// when every loop the composed graphs can make shrinks some measure. A lambda's calls count as its
// definition's: where the walk sees the lambda called, with what it is called with, and otherwise
// with its parameters unknown.

import parsing (Span, Ident, QName, span_bin)
import patterns (Pattern, PWild, PVar, PLit, PCtor, PRecord, PList, POr, PBad, LInt, LFixed, LWide,
                 LBad, LBool)
import exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock, ERecord,
              ERecordUpdate, ETry, EField, EList, EPerform, EHandle, EWithCell, ESimulate,
              EParallel, EBad, ETryBlock, Stmt, SLet, SLetElse, SExpr, Param, NamedArg, MatchArm,
              HandleClause, RecField, expr_span)
import items (FnDef)
import types (Type, TyVar, TyCon, TyFn, TyRecord, Field)
import std.bin
import std.list (at, concat, contains)
import std.math (pow)

// What a name the walk did not bind names: a member of the group, a builtin, a constructor,
// another definition by its qualified name, or something else.
pub type Callee =
  | GroupMember(Int)
  | BuiltinCallee(Bytes)
  | ConstructorCallee
  | DefinedCallee(Bytes)
  | OtherCallee

// How a definition's calls are known to return.
pub type Ending =
  // Every loop through its group descends a measure, and everything it reaches ends too.
  | Ends
  // Only by the measures its group states with `decreases`, each of which a proof must show.
  | Stated
  // A call by which it may not return: back into its group without descending, on the `loop` of
  // calls that does not, or with no `loop` where the group is past what the check follows; or,
  // `through`, to a definition that may not return.
  | Diverges({ at: Site, through: Option<Bytes>, loop: List<Site> })

// A call in the body of the definition `caller` names, `span` counted from where that definition
// starts, so an ending filed for a definition holds wherever the definition moves to.
pub type Site = { caller: Bytes, span: Span }

// A parameter, or a field reached from one through records.
pub type Place = { param: Int, path: List<Bytes> }

// What an integer is offset from: a place; a length the place decides; a quotient by a literal
// greater than one, under the operator that took it, since `/`, `>>` and `>>>` part below zero;
// or a remainder, which only its divisor bounds, so it names no one value and is never measured.
pub type Base =
  | PlaceBase(Place)
  | LengthBase({ name: Bytes, of: Place })
  | QuotientBase({ of: Base, by: Int, op: Bytes })
  | RemainderBase({ by: Base })

// `base + k`; no base is the constant `k`.
pub type Linear = { base: Option<Base>, k: Int }

// What the walk knows of a value, in the terms of the definition it is in.
pub type Term =
  // Exactly this; a place with `k == 0` is the place itself, at any type.
  | Exactly(Linear)
  // A part of the place reached through elements and fields alone: smaller than it and, where the
  // place is a list, no larger than the element it lies in.
  | Below(Place)
  // A part of the place reached through a list's tail: smaller than it, though not than its
  // elements.
  | Inside(Place)
  // A value each of whose elements and fields is a part of the place: neither it nor, for a list
  // rebuilt of parts, its tail need be smaller.
  | PartsOf(Place)
  // A record written out, its unwritten fields those of `base`.
  | RecordTerm({ base: Option<Term>, fields: List<{ name: Bytes, term: Term }> })
  // A value with no parts: a nullary constructor, an empty list, a literal.
  | NoParts
  // A constructor of one field, which the term is, or a value with no parts: no larger than a place
  // the field is a part of, since a part is smaller than what it is a part of by at least one.
  | Wrapped(Term)
  // As long as the place: what a write at an index leaves of it.
  | SameLength(Place)
  | UnknownTerm

// How a definition calls each function it is handed, and what it answers, in its own parameters'
// terms: what a call of it tells a group that hands it a member or a lambda.
pub type Summary = { names: List<Bytes>, params: List<Passing>, result: Term }

pub type Passing =
  // Not a function it calls.
  | NotCalled
  // Called with these arguments.
  | CalledWith(List<List<Term>>)
  // Kept, answered, or handed somewhere the walk does not follow: called with anything.
  | Escapes

// A group's members in slot order, each with its qualified name and its parameters' types; how to
// read a free name; how a definition outside the group ends; and how it calls what it is handed.
pub type Group = {
  defs: List<FnDef>,
  names: List<Bytes>,
  params: List<List<Type>>,
  resolve: (QName) -> Callee / {abort.raise},
  ending_of: (Bytes) -> Ending / {abort.raise},
  summary_of: (Bytes) -> Option<Summary>,
}

// Each member's ending, which is its group's since they reach one another, told first by its own
// call out of the group by which it may not return; and each member's summary.
pub type Verdict = { endings: List<Ending>, summaries: List<Summary> }

// Filed with a definition's rows, so a stub, whose body is a blank, still answers what its own did.
derive bin for Site
derive bin for Ending
derive bin for Place
derive bin for Base
derive bin for Linear
derive bin for Term
derive bin for Passing
derive bin for Summary

// What nothing is known of: how a definition calls what it is handed, and what it answers.
pub fn unknown_summary() -> Summary = { names: [], params: [], result: UnknownTerm }

// `lo < hi`, or `lo <= hi` when not `strict`.
type Fact = { lo: Linear, hi: Linear, strict: Bool }

type Local =
  | KnownTerm(Term)
  // A parameter of function type, whose calls the walk records.
  | FunctionParam(Int)
  // A lambda bound by `let`, walked where it is called, in the scope it was written in.
  | LetLambda({ params: List<Param>, body: Expr, locals: Map<Bytes, Local> })

type Scope = { locals: Map<Bytes, Local>, facts: List<Fact> }

type Call = { callee: Int, args: List<Term>, facts: List<Fact>, span: Span }

// A call of the parameter at `param`, or, with no arguments, its escape.
type Use = { param: Int, args: Option<List<Term>> }

// A definition outside the group that a body calls, or hands on as a value.
type Outside = { name: Bytes, span: Span }

// `lost` is a lambda's body nested too deep in others to be read, so the group is not read as
// ending.
type Seen = { calls: List<Call>, uses: List<Use>, outside: List<Outside>, lost: Option<Span> }

// `depth` counts the lambdas whose bodies the walk is reading within one another; `results` is what
// each member of the group is known to answer, or `None` where it is not known to answer at all.
type MemberContext = { group: Group, me: Int, depth: Int, results: List<Option<Term>> }

// The structural size of a place; `hi - lo`, which a shrinking call must find bounded below; or the
// measure a `decreases` states, which every call between two members stating one is owed to shrink.
type Measure =
  | SizeMeasure(Place)
  // The size of the largest element of the list a parameter is, none for an empty one.
  | ElementMeasure(Place)
  | DifferenceMeasure({ hi: Option<Base>, lo: Option<Base> })
  | StatedMeasure

// From the caller's measure `a` to the callee's `b`: smaller when `strict`, otherwise no larger.
type Arc = { a: Int, b: Int, strict: Bool }

// What a chain of calls from `from` to `to` does to the measures; `calls` are the chain's, in order.
type Graph = { from: Int, to: Int, arcs: List<Arc>, calls: List<Site> }

// --- The verdict ----------------------------------------------------------------------------------

pub fn verdict(g: Group) -> Verdict / {abort.raise} = {
  let results = settled_results(g);
  let seen = map(range(0, len(g.defs)), |i: Int|
    seen_of({ group: g, me: i, depth: 0, results: results }, at(g.defs, i)));
  let calls = map(seen, |x: Seen| x.calls);
  let stating = fold(g.defs, false, |acc: Bool, d: FnDef|
    acc || (match d.decreases { Some(_) -> true, None -> false }));
  let lost = fold(range(0, len(seen)), None, |acc: Option<Site>, i: Int|
    match acc {
      Some(_) -> acc,
      None -> match at(seen, i).lost { Some(span) -> Some(site(g, i, span)), None -> None },
    });
  let own = match lost {
    Some(s) -> Diverges({ at: s, through: None, loop: [] }),
    None -> match looping(g, calls, false) {
      None -> Ends,
      Some(first) -> if !stating { looped(first) }
      else { match looping(g, calls, true) { None -> Stated, Some(again) -> looped(again) } },
    },
  };
  let out = |me: Int|
    |e: Ending, o: Outside|
      weaker(e, match (g.ending_of)(o.name) {
        Diverges(_) -> Diverges({ at: site(g, me, o.span), through: Some(o.name), loop: [] }),
        other -> other,
      });
  let settled = match own { Diverges(_) -> Ends, other -> other };
  {
    endings: map(range(0, len(g.defs)), |i: Int|
      fold(
        range(0, len(seen)),
        weaker(fold(at(seen, i).outside, settled, out(i)), own),
        |e: Ending, j: Int| fold(at(seen, j).outside, e, out(j)),
      )),
    summaries: map(range(0, len(g.defs)), |i: Int|
      summary({ group: g, me: i, depth: 0, results: results }, at(seen, i))),
  }
}

// What each member answers: from none known, each member's answer read again with what the others
// are known to answer, until a round changes nothing, which every answer then holds of. A call that
// returned answered what its callee is known to, so a later call reads it soundly. Past a number of
// rounds nothing is known.
fn settled_results(g: Group) -> List<Option<Term>> / {abort.raise} = {
  let n = len(g.defs);
  let round = |rs: List<Option<Term>>|
    map(range(0, n), |i: Int| {
      let context = { group: g, me: i, depth: 0, results: rs };
      answered(context, entry_scope(context, at(g.defs, i)), at(g.defs, i).body)
    });
  iterate(
    { rs: map(range(0, n), |i: Int| None), k: 0 },
    result_rounds() + 2,
    |st: { rs: List<Option<Term>>, k: Int }|
      if st.k >= result_rounds() { Stop(map(range(0, n), |i: Int| Some(UnknownTerm))) } else {
        let next = round(st.rs);
        if next == st.rs { Stop(st.rs) } else { Continue({ rs: next, k: st.k + 1 }) }
      },
  )
}

fn result_rounds() -> Int = 6

fn looped(u: Unending) -> Ending = Diverges({ at: u.at, through: None, loop: u.loop })

// A loop that may not shrink any measure: its first call and all of them, or, past what the check
// follows, a call into the group and no loop.
type Unending = { at: Site, loop: List<Site> }

// The call at `span` in member `me`'s body.
fn site(g: Group, me: Int, span: Span) -> Site / {abort.raise} = {
  let start = at(g.defs, me).span.start;
  { caller: at(g.names, me), span: { start: span.start - start, end: span.end - start } }
}

fn weaker(a: Ending, b: Ending) -> Ending =
  match a { Diverges(_) -> a, Stated -> match b { Diverges(_) -> b, _ -> a }, Ends -> b }

// The calls of a loop that may not shrink any measure; `None` when every loop does. With `stated`,
// the measures the members state count as shrinking at every call between two of them.
fn looping(g: Group, calls: List<List<Call>>, stated: Bool) -> Option<Unending> / {abort.raise} = {
  let measures = spread(
    calls,
    map(range(0, len(g.defs)), |i: Int| measures_of(g, i, at(calls, i), stated)),
  );
  let graphs = fold(range(0, len(g.defs)), [], |acc: List<Graph>, i: Int|
    fold(at(calls, i), acc, |gs: List<Graph>, c: Call| added(gs, call_graph(g, measures, i, c))));
  searched(len(g.defs), graphs)
}

fn idempotent(x: Graph) -> Bool / {abort.raise} = same_arcs(composed(x, x).arcs, x.arcs)

fn shrinks(x: Graph) -> Bool =
  fold(x.arcs, false, |acc: Bool, r: Arc| acc || (r.strict && r.a == r.b))

// Every path the calls can take, as a graph, each path extended by one call at a time so every
// path is found once its prefix is: the first loop found that shrinks no measure, or `None` once
// every path is found. Past a number of paths this check does not search, the group is not read as
// ending.
type Closure = {
  buckets: Map<Int, List<Graph>>,
  queue: List<Graph>,
  next: Int,
  bad: Option<Unending>,
}

fn searched(n: Int, calls: List<Graph>) -> Option<Unending> / {abort.raise} = {
  let from = map(range(0, n), |i: Int| filter(calls, |x: Graph| x.from == i));
  let start = fold(
    calls,
    { buckets: map_new(), queue: [], next: 0, bad: None },
    |c: Closure, x: Graph| enqueued(c, n, x),
  );
  iterate(start, closure_bound() + 2, |c: Closure|
    match c.bad {
      Some(_) -> Stop(c.bad),
      None -> if c.next >= len(c.queue) { Stop(None) } else if len(c.queue) > closure_bound() {
        Stop(Some({ at: at(at(c.queue, 0).calls, 0), loop: [] }))
      } else {
        let x = at(c.queue, c.next);
        let grown = fold(at(from, x.to), c, |acc: Closure, y: Graph|
          enqueued(acc, n, composed(x, y)));
        Continue({ ..grown, next: c.next + 1 })
      },
    })
}

fn enqueued(c: Closure, n: Int, x: Graph) -> Closure / {abort.raise} = {
  let key = x.from * n + x.to;
  let bucket = match map_get(c.buckets, key) { Some(b) -> b, None -> [] };
  if fold(bucket, false, |found: Bool, y: Graph| found || same_arcs(y.arcs, x.arcs)) { c } else {
    {
      ..c,
      buckets: map_insert(c.buckets, key, push(bucket, x)),
      queue: push(c.queue, x),
      bad: match c.bad {
        Some(_) -> c.bad,
        None -> if x.from == x.to && idempotent(x) && !shrinks(x) {
          Some({ at: at(x.calls, 0), loop: x.calls })
        } else { None },
      },
    }
  }
}

fn closure_bound() -> Int = 10000

fn added(gs: List<Graph>, x: Graph) -> List<Graph> =
  if fold(gs, false, |found: Bool, y: Graph|
      found || (y.from == x.from && y.to == x.to && same_arcs(y.arcs, x.arcs))) { gs }
  else { push(gs, x) }

fn same_arcs(a: List<Arc>, b: List<Arc>) -> Bool =
  len(a) == len(b) && fold(a, true, |ok: Bool, r: Arc| ok && has_arc(b, r))

fn has_arc(xs: List<Arc>, r: Arc) -> Bool = fold(xs, false, |found: Bool, x: Arc| found || x == r)

fn composed(x: Graph, y: Graph) -> Graph / {abort.raise} =
  {
    from: x.from,
    to: y.to,
    arcs: fold(x.arcs, [], |acc: List<Arc>, r: Arc|
      fold(y.arcs, acc, |a: List<Arc>, s: Arc|
        if r.b != s.a { a }
        else { with_arc(a, { a: r.a, b: s.b, strict: r.strict || s.strict }) })),
    calls: fold(y.calls, x.calls, |acc: List<Site>, s: Site| push(acc, s)),
  }

// Keeps the stronger of two arcs between the same measures.
fn with_arc(xs: List<Arc>, r: Arc) -> List<Arc> / {abort.raise} =
  match fold(range(0, len(xs)), None, |found: Option<Int>, i: Int|
      match found {
        Some(_) -> found,
        None -> if at(xs, i).a == r.a && at(xs, i).b == r.b { Some(i) } else { None },
      }) {
    None -> push(xs, r),
    Some(i) -> if r.strict { list_set(xs, i, r) } else { xs },
  }

// --- Measures -------------------------------------------------------------------------------------

// Each parameter's size, each deeper place a call passes a part of, and each distance a fact at a
// call bounds.
fn measures_of(
  g: Group,
  me: Int,
  calls: List<Call>,
  stated: Bool,
) -> List<Measure> / {abort.raise} = {
  let sized = fold(range(0, len(at(g.defs, me).params)), [], |acc: List<Measure>, i: Int| {
    let p = { param: i, path: [] };
    let size = push(acc, SizeMeasure(p));
    if listed(g, me, p) { push(size, ElementMeasure(p)) } else { size }
  });
  let params = match at(g.defs, me).decreases {
    Some(_) -> if stated { push(sized, StatedMeasure) } else { sized },
    None -> sized,
  };
  let deep = fold(calls, params, |acc: List<Measure>, c: Call|
    fold(c.args, acc, |a: List<Measure>, t: Term| deeper_places(a, t)));
  fold(calls, deep, |acc: List<Measure>, c: Call|
    fold(c.facts, acc, |a: List<Measure>, f: Fact| with_difference(a, f.hi.base, f.lo.base)))
}

// `hi - lo` as a measure, unless it is no distance or a remainder names no one value.
fn with_difference(xs: List<Measure>, hi: Option<Base>, lo: Option<Base>) -> List<Measure> =
  if hi == lo || remains(hi) || remains(lo) { xs }
  else { with_measure(xs, DifferenceMeasure({ hi: hi, lo: lo })) }

fn remains(b: Option<Base>) -> Bool = match b { Some(x) -> remainder_in(x), None -> false }

fn remainder_in(b: Base) -> Bool =
  match b { RemainderBase(_) -> true, QuotientBase(q) -> remainder_in(q.of), _ -> false }

// A difference a member's guard bounds, or a field it measures, carried back along every call into
// it that hands it the same of the caller's own, so a loop through members that test nothing, or
// that pass the record on whole, still reads it.
// A loop is no longer than the group, so that many rounds carry it all the way round.
fn spread(calls: List<List<Call>>, ms: List<List<Measure>>) -> List<List<Measure>> / {abort.raise} =
  fold(range(0, len(ms)), ms, |acc: List<List<Measure>>, _: Int|
    map(range(0, len(acc)), |i: Int|
      fold(at(calls, i), at(acc, i), |mine: List<Measure>, c: Call|
        fold(at(acc, c.callee), mine, |m: List<Measure>, x: Measure|
          match measured(c, x) {
            DifferenceValue(v) -> match v.hi {
              Some(hi) -> match v.lo {
                Some(lo) -> with_difference(m, hi.base, lo.base),
                None -> m,
              },
              None -> m,
            },
            // A field the callee measures, which the caller hands it as a field of its own.
            SizeValue(Exactly(l)) -> match field_place(l) {
              Some(p) -> with_measure(m, SizeMeasure(p)),
              None -> m,
            },
            _ -> m,
          }))))

// A field of a parameter, which a measure may size on its own.
fn field_place(l: Linear) -> Option<Place> =
  match l.base {
    Some(PlaceBase(p)) -> if l.k == 0 && len(p.path) > 0 { Some(p) } else { None },
    _ -> None,
  }

fn deeper_places(acc: List<Measure>, t: Term) -> List<Measure> =
  match t {
    Exactly(l) -> match field_place(l) {
      Some(p) -> with_measure(acc, SizeMeasure(p)),
      None -> acc,
    },
    Wrapped(x) -> deeper_places(acc, x),
    Below(p) -> if len(p.path) == 0 { acc } else { with_measure(acc, SizeMeasure(p)) },
    Inside(p) -> if len(p.path) == 0 { acc } else { with_measure(acc, SizeMeasure(p)) },
    RecordTerm(r) -> {
      let based = match r.base { Some(b) -> deeper_places(acc, b), None -> acc };
      fold(r.fields, based, |a: List<Measure>, f: { name: Bytes, term: Term }|
        deeper_places(a, f.term))
    },
    _ -> acc,
  }

fn with_measure(xs: List<Measure>, m: Measure) -> List<Measure> =
  if fold(xs, false, |found: Bool, x: Measure| found || x == m) { xs } else { push(xs, m) }

// What one call does to each pair of the caller's and the callee's measures.
fn call_graph(g: Group, measures: List<List<Measure>>, me: Int, c: Call) -> Graph / {abort.raise} = {
  let mine = at(measures, me);
  let theirs = at(measures, c.callee);
  {
    from: me,
    to: c.callee,
    arcs: fold(range(0, len(theirs)), [], |acc: List<Arc>, j: Int| {
      let value = measured(c, at(theirs, j));
      fold(range(0, len(mine)), acc, |a: List<Arc>, i: Int|
        match relation(g, me, c, at(mine, i), value) {
          None -> a,
          Some(strict) -> with_arc(a, { a: i, b: j, strict: strict }),
        })
    }),
    calls: [site(g, me, c.span)],
  }
}

// A callee's measure at the call, in the caller's terms.
type Valued =
  | SizeValue(Term)
  | ElementValue(Term)
  | DifferenceValue({ hi: Option<Linear>, lo: Option<Linear> })
  | StatedValue

fn measured(c: Call, m: Measure) -> Valued =
  match m {
    SizeMeasure(q) -> SizeValue(along(arg(c, q.param), q.path)),
    ElementMeasure(q) -> ElementValue(along(arg(c, q.param), q.path)),
    DifferenceMeasure(d) ->
      DifferenceValue({ hi: substituted(c.args, d.hi), lo: substituted(c.args, d.lo) }),
    StatedMeasure -> StatedValue,
  }

fn arg(c: Call, i: Int) -> Term = actual(c.args, i)

fn actual(args: List<Term>, i: Int) -> Term =
  match list_at(args, i) { Some(t) -> t, None -> UnknownTerm }

fn along(t: Term, path: List<Bytes>) -> Term = fold(path, t, |x: Term, f: Bytes| project(x, f))

// A callee's base at the call, as an offset from one of the caller's.
fn substituted(args: List<Term>, b: Option<Base>) -> Option<Linear> =
  match b {
    None -> Some({ base: None, k: 0 }),
    Some(x) -> match base_at(args, x) { Some(Exactly(l)) -> Some(l), _ -> None },
  }

// The value a callee's base takes at a call, in the caller's terms.
fn base_at(args: List<Term>, b: Base) -> Option<Term> =
  match b {
    PlaceBase(q) -> Some(along(actual(args, q.param), q.path)),
    LengthBase(n) -> match along(actual(args, n.of.param), n.of.path) {
      Exactly(l) -> match l.base {
        Some(PlaceBase(p)) -> if l.k != 0 { None }
        else { Some(Exactly({ base: Some(LengthBase({ name: n.name, of: p })), k: 0 })) },
        _ -> None,
      },
      SameLength(p) -> Some(Exactly({ base: Some(LengthBase({ name: n.name, of: p })), k: 0 })),
      _ -> None,
    },
    QuotientBase(q) -> match base_at(args, q.of) {
      Some(Exactly(l)) -> match l.base {
        Some(x) -> if l.k != 0 { None }
        else { Some(Exactly({ base: Some(QuotientBase({ ..q, of: x })), k: 0 })) },
        None -> None,
      },
      _ -> None,
    },
    RemainderBase(r) -> match base_at(args, r.by) {
      Some(Exactly(l)) -> match l.base {
        Some(x) -> if l.k != 0 { None }
        else { Some(Exactly({ base: Some(RemainderBase({ by: x })), k: 0 })) },
        None -> None,
      },
      _ -> None,
    },
  }

// `Some(true)` when the callee's measure is below the caller's, `Some(false)` when it is no larger.
fn relation(
  g: Group,
  me: Int,
  c: Call,
  mine: Measure,
  value: Valued,
) -> Option<Bool> / {abort.raise} =
  match mine {
    SizeMeasure(p) -> match value {
      SizeValue(t) -> size_relation(t, p, place_type(g, me, p)),
      ElementValue(t) -> elements_below(t, p),
      _ -> None,
    },
    ElementMeasure(p) -> match value {
      // A part of a list reached through elements and fields lies in one of its elements.
      SizeValue(t) -> match t { Below(q) -> if q == p { Some(false) } else { None }, _ -> None },
      ElementValue(t) -> element_relation(t, p),
      _ -> None,
    },
    DifferenceMeasure(d) -> match value {
      DifferenceValue(v) -> match v.hi {
        None -> None,
        Some(hi) -> match v.lo {
          None -> None,
          Some(lo) -> if lo.base != d.lo { None } else if hi.base == d.hi {
            match checked_sub(hi.k, lo.k) {
              None -> None,
              Some(delta) -> if delta > 0 { None }
              else if delta == 0 { Some(false) }
              else { Some(bounded(c.facts, d.hi, d.lo)) },
            }
          } else { shrunk(c.facts, hi, lo, d.hi, d.lo) },
        },
      },
      _ -> None,
    },
    StatedMeasure -> match value { StatedValue -> Some(true), _ -> None },
  }

// Every element of the list is smaller than the place: the list is the place, a part of it, or
// made of its parts, or it has no elements.
fn elements_below(t: Term, p: Place) -> Option<Bool> =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(q)) -> if l.k == 0 && (q == p || within(q, p)) { Some(true) } else { None },
      _ -> None,
    },
    NoParts -> Some(true),
    _ -> match place_of(t) {
      Some(q) -> if q == p || within(q, p) { Some(true) } else { None },
      None -> None,
    },
  }

// A list's elements against the largest of the list `p`'s: its own, or its tail's, are no larger,
// and those of a list lying in one of its elements are smaller. One rebuilt of parts may hold a
// tail, so it is not read.
fn element_relation(t: Term, p: Place) -> Option<Bool> =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(q)) -> if l.k == 0 && q == p { Some(false) } else { None },
      _ -> None,
    },
    Inside(q) -> if q == p { Some(false) } else { None },
    Below(q) -> if q == p { Some(true) } else { None },
    NoParts -> Some(false),
    _ -> None,
  }

// A quotient by more than one, or a remainder by the measure itself, is below a measure the facts
// hold at one or more, so the step shrinks it.
fn shrunk(
  facts: List<Fact>,
  hi: Linear,
  lo: Linear,
  was: Option<Base>,
  floor: Option<Base>,
) -> Option<Bool> =
  if floor != None || lo.k != 0 || hi.k > 0 { None } else {
    match was {
      None -> None,
      Some(x) -> match hi.base {
        Some(QuotientBase(q)) -> if q.of == x && at_least_one(facts, x) { Some(true) }
        else { None },
        Some(RemainderBase(r)) -> if r.by == x && at_least_one(facts, x) { Some(true) }
        else { None },
        _ -> None,
      },
    }
  }

fn at_least_one(facts: List<Fact>, x: Base) -> Bool =
  fold(facts, false, |found: Bool, f: Fact|
    found
      || (f.lo.base == None && f.hi.base == Some(x)
      && (match checked_sub(f.lo.k, f.hi.k) {
        Some(d) -> d >= (if f.strict { 0 } else { 1 }),
        None -> false,
      })))

// A fact at the call bounds `hi - lo` below, so a shrinking step cannot repeat without end.
fn bounded(facts: List<Fact>, hi: Option<Base>, lo: Option<Base>) -> Bool =
  fold(facts, false, |found: Bool, f: Fact| found || (f.hi.base == hi && f.lo.base == lo))

fn size_relation(t: Term, p: Place, ty: Option<Type>) -> Option<Bool> / {abort.raise} =
  match ty { Some(x) -> typed_relation(t, p, x), None -> place_relation(t, p) }

fn typed_relation(t: Term, p: Place, ty: Type) -> Option<Bool> / {abort.raise} =
  match t {
    RecordTerm(r) -> match ty {
      TyRecord(fs) -> record_relation(r.base, r.fields, fs, p),
      _ -> None,
    },
    _ -> place_relation(t, p),
  }

fn place_relation(t: Term, p: Place) -> Option<Bool> =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(q)) -> if l.k != 0 { None }
      else if q == p { Some(false) }
      else if within(q, p) { Some(true) }
      else { None },
      _ -> None,
    },
    Below(q) -> if q == p || within(q, p) { Some(true) } else { None },
    Inside(q) -> if q == p || within(q, p) { Some(true) } else { None },
    // Every value has a size of at least one, which is the whole of one with no parts.
    NoParts -> Some(false),
    Wrapped(x) -> match x {
      Exactly(l) -> match l.base {
        Some(PlaceBase(q)) -> if l.k == 0 && within(q, p) { Some(false) } else { None },
        _ -> None,
      },
      NoParts -> Some(false),
      _ -> match part_place(x) {
        Some(q) -> if q == p { Some(false) } else if within(q, p) { Some(true) } else { None },
        None -> None,
      },
    },
    _ -> None,
  }

// A record written over a place: no larger when each field is no larger than the place's, smaller
// when one is smaller too. A field of a type whose every value has one size is no larger.
fn record_relation(
  base: Option<Term>,
  written: List<{ name: Bytes, term: Term }>,
  fs: List<Field>,
  p: Place,
) -> Option<Bool> / {abort.raise} =
  match fs {
    [] -> Some(false),
    [f, ..rest] -> {
      let value = match field_term(written, f.name) {
        Some(x) -> x,
        None -> match base { Some(b) -> project(b, f.name), None -> UnknownTerm },
      };
      let here = match typed_relation(value, { ..p, path: push(p.path, f.name) }, f.ty) {
        Some(s) -> Some(s),
        None -> if atomic(f.ty) { Some(false) } else { None },
      };
      match here {
        None -> None,
        Some(s) -> match record_relation(base, written, rest, p) {
          None -> None,
          Some(more) -> Some(s || more),
        },
      }
    },
  }

// `q` is a field of `p`, at any depth.
fn within(q: Place, p: Place) -> Bool =
  q.param == p.param && len(q.path) > len(p.path) && prefix(p.path, q.path)

fn prefix(a: List<Bytes>, b: List<Bytes>) -> Bool =
  match a {
    [] -> true,
    [x, ..rest] -> match b { [y, ..more] -> x == y && prefix(rest, more), [] -> false },
  }

// The first field of the name.
fn field_term(fs: List<{ name: Bytes, term: Term }>, name: Bytes) -> Option<Term> =
  fold(fs, None, |found: Option<Term>, f: { name: Bytes, term: Term }|
    match found { Some(_) -> found, None -> if f.name == name { Some(f.term) } else { None } })

// A value of this type has one size whatever it holds.
fn atomic(t: Type) -> Bool =
  match t {
    TyCon(c) ->
      len(c.args) == 0
        && (is_integer_name(c.name)
        || contains(
          [b"Bool", b"String", b"Bytes", b"Float", b"Decimal", b"Char", b"Unit"],
          c.name,
        )),
    TyFn(_) -> true,
    TyRecord(fs) -> len(fs) == 0,
    TyVar(_) -> false,
  }

fn is_integer_name(n: Bytes) -> Bool =
  contains(
    [b"Int", b"U8", b"U16", b"U32", b"U64", b"U128", b"I8", b"I16", b"I32", b"I64", b"I128"],
    n,
  )

fn place_type(g: Group, me: Int, p: Place) -> Option<Type> / {abort.raise} =
  match list_at(at(g.params, me), p.param) {
    None -> None,
    Some(t) ->
      fold(p.path, Some(t), |acc: Option<Type>, f: Bytes|
        match acc { Some(TyRecord(fs)) -> field_type(fs, f), _ -> None }),
  }

fn field_type(fs: List<Field>, name: Bytes) -> Option<Type> =
  match fs {
    [] -> None,
    [f, ..rest] -> if f.name == name { Some(f.ty) } else { field_type(rest, name) },
  }

fn integer_place(g: Group, me: Int, p: Place) -> Bool / {abort.raise} =
  match place_type(g, me, p) {
    Some(TyCon(c)) -> len(c.args) == 0 && is_integer_name(c.name),
    _ -> false,
  }

// The place holds a list, whose elements a measure may size.
fn listed(g: Group, me: Int, p: Place) -> Bool / {abort.raise} =
  match place_type(g, me, p) {
    Some(TyCon(c)) -> len(c.args) == 1 && (c.name == b"List" || c.name == b"Array"),
    _ -> false,
  }

fn function_param(g: Group, me: Int, i: Int) -> Bool / {abort.raise} =
  match list_at(at(g.params, me), i) { Some(TyFn(_)) -> true, _ -> false }

// --- Terms ----------------------------------------------------------------------------------------

fn project(t: Term, field: Bytes) -> Term =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(p)) -> if l.k != 0 { UnknownTerm }
      else { Exactly({ base: Some(PlaceBase({ ..p, path: push(p.path, field) })), k: 0 }) },
      _ -> UnknownTerm,
    },
    Below(p) -> Below(p),
    Inside(p) -> Below(p),
    PartsOf(p) -> Below(p),
    RecordTerm(r) -> match field_term(r.fields, field) {
      Some(x) -> x,
      None -> match r.base { Some(b) -> project(b, field), None -> UnknownTerm },
    },
    NoParts -> UnknownTerm,
    Wrapped(_) -> UnknownTerm,
    SameLength(_) -> UnknownTerm,
    UnknownTerm -> UnknownTerm,
  }

// An element or a field of the value, or one of theirs: of a list's tail, an element of the list.
fn below(t: Term) -> Term =
  match t {
    Wrapped(x) -> x,
    Exactly(l) -> match l.base {
      Some(PlaceBase(p)) -> if l.k == 0 { Below(p) } else { UnknownTerm },
      _ -> UnknownTerm,
    },
    Below(p) -> Below(p),
    Inside(p) -> Below(p),
    PartsOf(p) -> Below(p),
    _ -> UnknownTerm,
  }

// A list's tail, or a part of the value reached through one: of a list rebuilt of a place's parts,
// no part of the place.
fn tail(t: Term) -> Term =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(p)) -> if l.k == 0 { Inside(p) } else { UnknownTerm },
      _ -> UnknownTerm,
    },
    Below(p) -> Inside(p),
    Inside(p) -> Inside(p),
    PartsOf(p) -> PartsOf(p),
    _ -> UnknownTerm,
  }

// A value whose elements and fields are parts of the value, so parts of the place it is, or is a
// part of; a list rebuilt of parts has tails that are neither.
fn made_of(t: Term) -> Term =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(p)) -> if l.k == 0 { PartsOf(p) } else { UnknownTerm },
      _ -> UnknownTerm,
    },
    Below(p) -> PartsOf(p),
    Inside(p) -> PartsOf(p),
    NoParts -> NoParts,
    _ -> UnknownTerm,
  }

// A value made of elements or fields of the value: what `list_at` finds in a list.
fn parts(t: Term) -> Term =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(p)) -> if l.k == 0 { PartsOf(p) } else { UnknownTerm },
      _ -> UnknownTerm,
    },
    Below(p) -> PartsOf(p),
    Inside(p) -> PartsOf(p),
    PartsOf(p) -> PartsOf(p),
    NoParts -> NoParts,
    _ -> UnknownTerm,
  }

// An element of a list a builtin makes of a map: a key or a value is a part of the map, and an
// entry is made of one of each, so it is smaller than anything the map is a part of.
fn element(context: MemberContext, scope: Scope, list: Expr) -> Term / {abort.raise} =
  match list {
    EApp(a) -> match builtin(context, scope, a.func) {
      Some(name) -> if len(a.args) != 1 { below(term(context, scope, list)) }
      else if name == b"map_keys" || name == b"map_values" {
        below(term(context, scope, at(a.args, 0)))
      } else if name == b"map_entries" {
        match term(context, scope, at(a.args, 0)) { Below(p) -> Below(p), other -> parts(other) }
      } else { below(term(context, scope, list)) },
      None -> below(term(context, scope, list)),
    },
    _ -> below(term(context, scope, list)),
  }

// The place every argument is a part of, which a constructor or a list of them is made of.
fn parts_of(ts: List<Term>) -> Term =
  if len(ts) == 0 { NoParts } else {
    let widest = fold(ts, None, |acc: Option<Place>, t: Term|
      match part_place(t) {
        Some(p) -> match acc {
          Some(q) -> if within(q, p) { Some(p) } else { acc },
          None -> Some(p),
        },
        None -> acc,
      });
    match widest {
      Some(p) -> if fold(ts, true, |ok: Bool, x: Term| ok && part_of(x, p)) { PartsOf(p) }
      else { UnknownTerm },
      None -> UnknownTerm,
    }
  }

// A list of parts of a place with one more element, which may be a part of a wider place.
fn with_part(xs: Term, x: Term) -> Term =
  if xs == NoParts { parts_of([x]) } else {
    match parts(xs) {
      PartsOf(p) -> if part_of(x, p) { PartsOf(p) } else {
        match part_place(x) {
          Some(q) -> if within(p, q) { PartsOf(q) } else { UnknownTerm },
          None -> UnknownTerm,
        }
      },
      _ -> UnknownTerm,
    }
  }

// What `fold` answers when its lambda answers its accumulator or parts: the start joined with what
// a round answers, so long as a second round answers nothing the first did not.
fn folded(
  context: MemberContext,
  scope: Scope,
  xs: Expr,
  init: Expr,
  f: Expr,
) -> Term / {abort.raise} =
  match f {
    ELambda(l) -> match l.params {
      [acc, x] -> {
        let round = |r: Term|
          match answered(
              context,
              bound(bound(scope, acc.name.name, r), x.name.name, element(context, scope, xs)),
              l.body,
            ) {
            Some(t) -> join(r, t),
            None -> r,
          };
        let once = round(term(context, scope, init));
        if round(once) == once { once } else { UnknownTerm }
      },
      _ -> UnknownTerm,
    },
    _ -> UnknownTerm,
  }

// What `map` answers when the lambda it is given answers a part of each element.
fn mapped(context: MemberContext, scope: Scope, xs: Expr, f: Expr) -> Term / {abort.raise} =
  match f {
    ELambda(l) -> match l.params {
      [p] -> match answered(
          context,
          bound(scope, p.name.name, element(context, scope, xs)),
          l.body,
        ) {
        Some(t) -> parts_of([t]),
        None -> UnknownTerm,
      },
      _ -> UnknownTerm,
    },
    _ -> UnknownTerm,
  }

fn part_of(t: Term, p: Place) -> Bool =
  match t {
    Exactly(l) -> match l.base { Some(PlaceBase(q)) -> l.k == 0 && within(q, p), _ -> false },
    _ -> match part_place(t) { Some(q) -> q == p || within(q, p), None -> false },
  }

// The place a part of either kind is a part of.
fn part_place(t: Term) -> Option<Place> =
  match t { Below(p) -> Some(p), Inside(p) -> Some(p), _ -> None }

fn local(scope: Scope, name: Bytes) -> Option<Local> = map_get(scope.locals, name)

fn term(context: MemberContext, scope: Scope, e: Expr) -> Term / {abort.raise} =
  match e {
    ELit(l) -> match l.lit {
      LInt(k) -> Exactly({ base: None, k: k }),
      // A width's literal is its value where the `Int` pattern it is read as is not negative.
      LFixed(_, k) -> if k >= 0 { Exactly({ base: None, k: k }) } else { UnknownTerm },
      LWide(_, hi, lo) -> if hi == 0 && lo >= 0 { Exactly({ base: None, k: lo }) }
      else { UnknownTerm },
      LBad -> UnknownTerm,
      _ -> NoParts,
    },
    EVar(v) -> match local_of(scope, v.name) {
      Some(KnownTerm(t)) -> t,
      Some(FunctionParam(i)) -> Exactly({ base: Some(PlaceBase({ param: i, path: [] })), k: 0 }),
      Some(LetLambda(_)) -> UnknownTerm,
      // A constructor written bare takes no arguments.
      None -> match callee_of(context, scope, v.name) {
        ConstructorCallee -> NoParts,
        _ -> UnknownTerm,
      },
    },
    EField(f) -> project(term(context, scope, f.base), f.field.name),
    EBinary(b) -> if b.op == b"add" {
      offset(context, term(context, scope, b.lhs), term(context, scope, b.rhs))
    } else if b.op == b"sub" {
      match term(context, scope, b.rhs) {
        Exactly(r) -> match r.base {
          None -> match checked_neg(r.k) {
            Some(k) -> shifted(context, term(context, scope, b.lhs), k),
            None -> UnknownTerm,
          },
          Some(_) -> UnknownTerm,
        },
        _ -> UnknownTerm,
      }
    } else if b.op == b"div" {
      quotient(context, term(context, scope, b.lhs), term(context, scope, b.rhs), b.op)
    }
    // At one or more, either shift by `k` is the quotient by `2^k`, which is all a shrinking step
    // reads of it.
    else if b.op == b"shr" || b.op == b"ushr" {
      match term(context, scope, b.rhs) {
        Exactly(r) -> if r.base == None && r.k >= 1 && r.k <= 62 {
          quotient(
            context,
            term(context, scope, b.lhs),
            Exactly({ base: None, k: pow(2, r.k) }),
            b.op,
          )
        } else { UnknownTerm },
        _ -> UnknownTerm,
      }
    } else if b.op == b"rem" { remainder(context, term(context, scope, b.rhs)) }
    else { UnknownTerm },
    ERecord(r) -> RecordTerm({ base: None, fields: field_terms(context, scope, r.fields) }),
    EList(l) -> parts_of(map(l.items, |x: Expr| term(context, scope, x))),
    ERecordUpdate(r) ->
      RecordTerm({
        base: Some(term(context, scope, r.base)),
        fields: field_terms(context, scope, r.fields),
      }),
    EApp(a) -> applied_term(context, scope, a.func, a.args, a.named),
    EIf(i) -> match branches_of_if(context, scope, i) { Some(t) -> t, None -> UnknownTerm },
    EMatch(m) -> match branches_of_match(context, scope, m) { Some(t) -> t, None -> UnknownTerm },
    EBlock(b) -> {
      let r = block_scope(context, scope, b.stmts);
      match b.tail {
        None -> UnknownTerm,
        Some(t) -> match joined(r.falls, Some(term(context, r.s, t))) {
          Some(x) -> x,
          None -> UnknownTerm,
        },
      }
    },
    _ -> UnknownTerm,
  }

// The scope past a block's statements, and what the block answers where a `let ... else` fails,
// since its fallback is then the block's value.
fn block_scope(
  context: MemberContext,
  scope: Scope,
  stmts: List<Stmt>,
) -> { s: Scope, falls: Option<Term> } / {abort.raise} =
  fold(stmts, { s: scope, falls: None }, |acc: { s: Scope, falls: Option<Term> }, x: Stmt|
    {
      s: statement_scope(context, acc.s, x),
      falls: match x {
        SLetElse(l) -> joined(acc.falls, answered(context, acc.s, l.fallback)),
        _ -> acc.falls,
      },
    })

fn field_terms(
  context: MemberContext,
  scope: Scope,
  fs: List<RecField>,
) -> List<{ name: Bytes, term: Term }> / {abort.raise} =
  map(fs, |field: RecField| { name: field.name.name, term: term(context, scope, field.value) })

fn offset(context: MemberContext, a: Term, b: Term) -> Term / {abort.raise} =
  match b {
    Exactly(r) -> match r.base {
      None -> shifted(context, a, r.k),
      Some(_) -> match a {
        Exactly(l) -> match l.base { None -> shifted(context, b, l.k), Some(_) -> UnknownTerm },
        _ -> UnknownTerm,
      },
    },
    _ -> UnknownTerm,
  }

// An integer moved by `k`; a place that is not an integer has no such neighbour, and a move past
// `Int`'s range is no integer either.
fn shifted(context: MemberContext, t: Term, k: Int) -> Term / {abort.raise} =
  match t {
    Exactly(l) -> if !integer(context, l) { UnknownTerm }
    else { match checked_add(l.k, k) { Some(n) -> Exactly({ ..l, k: n }), None -> UnknownTerm } },
    _ -> UnknownTerm,
  }

fn quotient(context: MemberContext, a: Term, b: Term, op: Bytes) -> Term / {abort.raise} =
  match a {
    Exactly(l) -> match l.base {
      Some(x) -> if l.k != 0 || !integer(context, l) { UnknownTerm } else {
        match b {
          Exactly(r) -> if r.base == None && r.k >= 2 {
            Exactly({ base: Some(QuotientBase({ of: x, by: r.k, op: op })), k: 0 })
          } else { UnknownTerm },
          _ -> UnknownTerm,
        }
      },
      None -> UnknownTerm,
    },
    _ -> UnknownTerm,
  }

fn remainder(context: MemberContext, b: Term) -> Term / {abort.raise} =
  match b {
    Exactly(l) -> match l.base {
      Some(x) -> if l.k != 0 || !integer(context, l) { UnknownTerm }
      else { Exactly({ base: Some(RemainderBase({ by: x })), k: 0 }) },
      None -> UnknownTerm,
    },
    _ -> UnknownTerm,
  }

fn integer(context: MemberContext, l: Linear) -> Bool / {abort.raise} =
  match l.base { None -> true, Some(x) -> integer_base(context, x) }

fn integer_base(context: MemberContext, b: Base) -> Bool / {abort.raise} =
  match b {
    PlaceBase(p) -> integer_place(context.group, context.me, p),
    LengthBase(_) -> true,
    QuotientBase(q) -> integer_base(context, q.of),
    RemainderBase(r) -> integer_base(context, r.by),
  }

fn length_builtin(name: Bytes) -> Bool =
  name == b"len" || name == b"bytes_len" || name == b"string_len" || name == b"map_len"
    || name == b"array_len"

// What a call answers, where the walk can say: a length, a part a builtin finds, a constructor of
// parts, or what a summarized definition answers.
fn applied_term(
  context: MemberContext,
  scope: Scope,
  func: Expr,
  args: List<Expr>,
  named: List<NamedArg>,
) -> Term / {abort.raise} =
  match func {
    EVar(v) -> match callee_of(context, scope, v.name) {
      BuiltinCallee(name) -> if len(args) == 0 { UnknownTerm }
      else if length_builtin(name) && len(args) == 1 {
        match term(context, scope, at(args, 0)) {
          Exactly(l) -> match l.base {
            Some(PlaceBase(p)) -> if l.k == 0 {
              Exactly({ base: Some(LengthBase({ name: name, of: p })), k: 0 })
            } else { UnknownTerm },
            _ -> UnknownTerm,
          },
          _ -> UnknownTerm,
        }
      } else if name == b"list_at" || name == b"map_get" || name == b"filter" {
        parts(term(context, scope, at(args, 0)))
      } else if name == b"push" && len(args) == 2 {
        with_part(term(context, scope, at(args, 0)), term(context, scope, at(args, 1)))
      } else if name == b"list_set" && len(args) == 3 {
        let xs = term(context, scope, at(args, 0));
        match with_part(xs, term(context, scope, at(args, 2))) {
          UnknownTerm -> same_length(xs),
          t -> t,
        }
      } else if name == b"array_set" && len(args) == 3 {
        same_length(term(context, scope, at(args, 0)))
      } else if name == b"map" && len(args) == 2 {
        mapped(context, scope, at(args, 0), at(args, 1))
      } else if name == b"fold" && len(args) == 3 {
        folded(context, scope, at(args, 0), at(args, 1), at(args, 2))
      } else { UnknownTerm },
      ConstructorCallee -> if len(args) == 1 { Wrapped(term(context, scope, at(args, 0))) }
      else { parts_of(map(args, |x: Expr| term(context, scope, x))) },
      DefinedCallee(n) -> match context.group.summary_of(n) {
        Some(sum) ->
          translated(context, sum.result, actuals(context, scope, sum.names, args, named)),
        None -> UnknownTerm,
      },
      GroupMember(t) -> match list_at(context.results, t) {
        Some(Some(r)) -> translated(context, r, arguments(context, scope, t, args, named)),
        _ -> UnknownTerm,
      },
      _ -> UnknownTerm,
    },
    _ -> UnknownTerm,
  }

// A term of a callee's parameters, at a call with these arguments, in the caller's terms.
fn translated(context: MemberContext, t: Term, args: List<Term>) -> Term / {abort.raise} =
  match t {
    Exactly(l) -> match l.base {
      None -> t,
      Some(b) -> match base_at(args, b) {
        Some(x) -> if l.k == 0 { x } else { shifted(context, x, l.k) },
        None -> UnknownTerm,
      },
    },
    Below(p) -> below(along(actual(args, p.param), p.path)),
    Inside(p) -> tail(along(actual(args, p.param), p.path)),
    PartsOf(p) -> made_of(along(actual(args, p.param), p.path)),
    RecordTerm(r) ->
      RecordTerm({
        base: match r.base { Some(b) -> Some(translated(context, b, args)), None -> None },
        fields: map(r.fields, |f: { name: Bytes, term: Term }|
          { name: f.name, term: translated(context, f.term, args) }),
      }),
    NoParts -> NoParts,
    Wrapped(x) -> Wrapped(translated(context, x, args)),
    SameLength(p) -> same_length(along(actual(args, p.param), p.path)),
    UnknownTerm -> UnknownTerm,
  }

// What a write at an index leaves of a value: a place's length, kept.
fn same_length(t: Term) -> Term =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(p)) -> if l.k == 0 { SameLength(p) } else { UnknownTerm },
      _ -> UnknownTerm,
    },
    SameLength(p) -> SameLength(p),
    _ -> UnknownTerm,
  }

// An integer-valued term, the only kind a fact relates.
fn linear(context: MemberContext, scope: Scope, e: Expr) -> Option<Linear> / {abort.raise} =
  match term(context, scope, e) {
    Exactly(l) -> if integer(context, l) { Some(l) } else { None },
    _ -> None,
  }

// What a body answers: the terms its branches answer joined, a branch that never answers apart.
fn answered(context: MemberContext, scope: Scope, e: Expr) -> Option<Term> / {abort.raise} =
  match e {
    EIf(i) -> branches_of_if(context, scope, i),
    EMatch(m) -> branches_of_match(context, scope, m),
    EBlock(b) -> {
      let r = block_scope(context, scope, b.stmts);
      joined(r.falls, match b.tail {
        None -> Some(UnknownTerm),
        Some(t) -> answered(context, r.s, t),
      })
    },
    EApp(a) -> match a.func {
      EVar(v) -> match callee_of(context, scope, v.name) {
        BuiltinCallee(name) -> if name == b"panic" { None } else { Some(term(context, scope, e)) },
        // A member not yet known to answer has not answered here either.
        GroupMember(t) -> match list_at(context.results, t) {
          Some(None) -> None,
          _ -> Some(term(context, scope, e)),
        },
        _ -> Some(term(context, scope, e)),
      },
      _ -> Some(term(context, scope, e)),
    },
    _ -> Some(term(context, scope, e)),
  }

fn branches_of_if(
  context: MemberContext,
  scope: Scope,
  i: { span: Span, cond: Expr, then_branch: Expr, else_branch: Expr },
) -> Option<Term> / {abort.raise} =
  joined(
    answered(context, assume(context, scope, i.cond, true), i.then_branch),
    answered(context, assume(context, scope, i.cond, false), i.else_branch),
  )

fn branches_of_match(
  context: MemberContext,
  scope: Scope,
  m: { span: Span, scrutinee: Expr, arms: List<MatchArm> },
) -> Option<Term> / {abort.raise} = {
  let t = term(context, scope, m.scrutinee);
  fold(m.arms, None, |acc: Option<Term>, arm: MatchArm| {
    let inside = bind(scope, arm.pat, t);
    joined(
      acc,
      answered(
        context,
        match arm.guard { Some(g) -> assume(context, inside, g, true), None -> inside },
        arm.body,
      ),
    )
  })
}

fn joined(a: Option<Term>, b: Option<Term>) -> Option<Term> =
  match a { None -> b, Some(x) -> match b { None -> a, Some(y) -> Some(join(x, y)) } }

// A value either term may be: its parts are parts of a place both are, or are parts of, whatever
// a term with no parts adds. Two parts are a part of the wider place, of the looser kind; two
// constructors of one field one whose field is either; and two records one whose fields are.
fn join(a: Term, b: Term) -> Term = joined_within(a, b, join_depth())

// Records and constructors nested past this many deep are joined as nothing known, which is always
// a join.
fn join_depth() -> Int = 8

fn joined_within(a: Term, b: Term, room: Int) -> Term =
  if a == b { a }
  else if room <= 0 { UnknownTerm } else {
    match a {
      Wrapped(x) -> match b {
        Wrapped(y) -> Wrapped(joined_within(x, y, room - 1)),
        NoParts -> a,
        _ -> UnknownTerm,
      },
      RecordTerm(r) -> match b {
        RecordTerm(q) -> record_join(r, q, room - 1),
        _ -> match r.base {
          Some(base) -> if base == b { record_join(r, { base: Some(b), fields: [] }, room - 1) }
          else { UnknownTerm },
          None -> UnknownTerm,
        },
      },
      _ -> match b {
        Wrapped(_) -> if a == NoParts { b } else { UnknownTerm },
        RecordTerm(q) -> match q.base {
          Some(base) -> if base == a { record_join({ base: Some(a), fields: [] }, q, room - 1) }
          else { UnknownTerm },
          None -> UnknownTerm,
        },
        _ -> joined_parts(a, b),
      },
    }
  }

// Two records over one base, or both written out whole, field by field: each field is either's.
fn record_join(
  a: { base: Option<Term>, fields: List<{ name: Bytes, term: Term }> },
  b: { base: Option<Term>, fields: List<{ name: Bytes, term: Term }> },
  room: Int,
) -> Term =
  if a.base != b.base { UnknownTerm } else {
    let named = fold(
      b.fields,
      map(a.fields, |f: { name: Bytes, term: Term }| f.name),
      |acc: List<Bytes>, f: { name: Bytes, term: Term }|
        if contains(acc, f.name) { acc } else { push(acc, f.name) },
    );
    RecordTerm({
      base: a.base,
      fields: map(named, |n: Bytes|
        {
          name: n,
          term: match record_field(a, n) {
            Some(x) -> match record_field(b, n) {
              Some(y) -> joined_within(x, y, room),
              None -> UnknownTerm,
            },
            None -> UnknownTerm,
          },
        }),
    })
  }

fn record_field(
  r: { base: Option<Term>, fields: List<{ name: Bytes, term: Term }> },
  name: Bytes,
) -> Option<Term> =
  match field_term(r.fields, name) {
    Some(t) -> Some(t),
    None -> match r.base { Some(b) -> Some(project(b, name)), None -> None },
  }

// Over the nearest place both lie in: two parts of it are a part of it, of the looser kind, and
// anything else made of its parts is made of its parts.
fn joined_parts(a: Term, b: Term) -> Term =
  if a == NoParts { widened(b) }
  else if b == NoParts { widened(a) } else {
    match place_of(a) {
      Some(p) -> match place_of(b) {
        Some(q) -> if p.param != q.param { UnknownTerm } else {
          let c = { param: p.param, path: common_prefix(p.path, q.path) };
          if !(proper_part(a, c) && proper_part(b, c)) { PartsOf(c) }
          else if below_kind(a) && below_kind(b) { Below(c) }
          else { Inside(c) }
        },
        None -> UnknownTerm,
      },
      None -> UnknownTerm,
    }
  }

fn common_prefix(a: List<Bytes>, b: List<Bytes>) -> List<Bytes> =
  fold(
    range(0, len(a)),
    { same: true, out: [] },
    |acc: { same: Bool, out: List<Bytes> }, i: Int|
      if !acc.same { acc } else {
        match list_at(a, i) {
          None -> acc,
          Some(x) -> if list_at(b, i) == Some(x) { { same: true, out: push(acc.out, x) } }
          else { { same: false, out: acc.out } },
        }
      },
  ).out

// Strictly smaller than the place: a part of it or of a field of it, or a field of it.
fn proper_part(t: Term, c: Place) -> Bool =
  match t {
    Exactly(l) -> match l.base { Some(PlaceBase(q)) -> l.k == 0 && within(q, c), _ -> false },
    _ -> match part_place(t) { Some(q) -> q == c || within(q, c), None -> false },
  }

// Reached through elements and fields alone.
fn below_kind(t: Term) -> Bool = match t { Below(_) -> true, Exactly(_) -> true, _ -> false }

fn widened(t: Term) -> Term = match place_of(t) { Some(p) -> PartsOf(p), None -> UnknownTerm }

// The place a term is, or is a part of.
fn place_of(t: Term) -> Option<Place> =
  match t {
    Exactly(l) -> match l.base {
      Some(PlaceBase(p)) -> if l.k == 0 { Some(p) } else { None },
      _ -> None,
    },
    Below(p) -> Some(p),
    Inside(p) -> Some(p),
    PartsOf(p) -> Some(p),
    _ -> None,
  }

// --- Scope ----------------------------------------------------------------------------------------

fn entry_scope(context: MemberContext, def: FnDef) -> Scope / {abort.raise} =
  {
    locals: fold(range(0, len(def.params)), map_new(), |m: Map<Bytes, Local>, i: Int|
      map_insert(
        m,
        at(def.params, i).name.name,
        if function_param(context.group, context.me, i) { FunctionParam(i) }
        else { KnownTerm(Exactly({ base: Some(PlaceBase({ param: i, path: [] })), k: 0 })) },
      )),
    facts: [],
  }

fn bound(scope: Scope, name: Bytes, t: Term) -> Scope =
  { ..scope, locals: map_insert(scope.locals, name, KnownTerm(t)) }

fn unknown_params(s: Scope, ps: List<Param>) -> Scope =
  fold(ps, s, |sc: Scope, p: Param| bound(sc, p.name.name, UnknownTerm))

fn bind(s: Scope, p: Pattern, t: Term) -> Scope =
  match p {
    PWild(_) -> s,
    PVar(v) -> bound(s, v.name.name, t),
    PLit(_) -> s,
    PCtor(k) -> fold(k.args, s, |sc: Scope, x: Pattern| bind(sc, x, below(t))),
    PRecord(r) ->
      fold(r.fields, s, |sc: Scope, f: { name: Ident, pat: Pattern }|
        bind(sc, f.pat, project(t, f.name.name))),
    PList(l) -> {
      let items = fold(l.items, s, |sc: Scope, x: Pattern| bind(sc, x, below(t)));
      match l.rest {
        Some(r) -> bind(items, r, if len(l.items) > 0 { tail(t) } else { t }),
        None -> items,
      }
    },
    // Each alternative binds the same names; one whose parts differ between them is unknown.
    POr(o) -> match o.alts {
      [] -> s,
      [first, ..others] -> {
        let one = bind(s, first, t);
        fold(others, one, |sc: Scope, alt: Pattern| {
          let other = bind(s, alt, t);
          fold(pattern_names(alt), sc, |acc: Scope, n: Bytes|
            if local(acc, n) == local(other, n) { acc } else { bound(acc, n, UnknownTerm) })
        })
      },
    },
    PBad(_) -> s,
  }

fn pattern_names(p: Pattern) -> List<Bytes> =
  match p {
    PVar(v) -> [v.name.name],
    PCtor(k) -> fold(k.args, [], |acc: List<Bytes>, x: Pattern| concat(acc, pattern_names(x))),
    PRecord(r) ->
      fold(r.fields, [], |acc: List<Bytes>, f: { name: Ident, pat: Pattern }|
        concat(acc, pattern_names(f.pat))),
    PList(l) -> {
      let items = fold(l.items, [], |acc: List<Bytes>, x: Pattern| concat(acc, pattern_names(x)));
      match l.rest { Some(r) -> concat(items, pattern_names(r)), None -> items }
    },
    POr(o) -> match o.alts { [a, ..] -> pattern_names(a), [] -> [] },
    _ -> [],
  }

// A `let` of a lambda keeps the lambda, walked where it is called.
fn statement_scope(context: MemberContext, scope: Scope, x: Stmt) -> Scope / {abort.raise} =
  match x {
    SLet(l) -> match l.pat {
      PVar(v) -> match l.value {
        ELambda(f) ->
          {
            ..scope,
            locals: map_insert(
              scope.locals,
              v.name.name,
              LetLambda({ params: f.params, body: f.body, locals: scope.locals }),
            ),
          },
        _ -> bind(scope, l.pat, term(context, scope, l.value)),
      },
      _ -> bind(scope, l.pat, term(context, scope, l.value)),
    },
    SLetElse(l) -> bind(scope, l.pat, term(context, scope, l.value)),
    SExpr(_) -> scope,
  }

// What holds where `e` evaluated to `truth`.
fn assume(context: MemberContext, scope: Scope, e: Expr, truth: Bool) -> Scope / {abort.raise} =
  match e {
    EUnary(u) -> if u.op == b"not" { assume(context, scope, u.operand, !truth) } else { scope },
    EBinary(b) -> if b.op == b"and" {
      if truth { assume(context, assume(context, scope, b.lhs, true), b.rhs, true) } else { scope }
    } else if b.op == b"or" {
      if truth { scope }
      else { assume(context, assume(context, scope, b.lhs, false), b.rhs, false) }
    } else {
      match linear(context, scope, b.lhs) {
        None -> scope,
        Some(l) -> match linear(context, scope, b.rhs) {
          None -> scope,
          Some(r) -> { ..scope, facts: append_facts(scope.facts, compared(b.op, l, r, truth)) },
        },
      }
    },
    EBlock(b) -> if len(b.stmts) > 0 { scope }
    else { match b.tail { Some(t) -> assume(context, scope, t, truth), None -> scope } },
    _ -> scope,
  }

// `list_at(xs, i)` or `array_at(xs, i)` answering `Some` puts `i` below the length, and a
// condition matched against `true` or `false` holds or fails as an `if` would.
fn found_at(
  context: MemberContext,
  scope: Scope,
  scrutinee: Expr,
  p: Pattern,
) -> Scope / {abort.raise} =
  match p {
    PLit(l) -> match l.lit { LBool(b) -> assume(context, scope, scrutinee, b), _ -> scope },
    PCtor(k) -> if k.name.name.name != b"Some" { scope } else {
      match scrutinee {
        EApp(a) -> match builtin(context, scope, a.func) {
          Some(name) -> if (name != b"list_at" && name != b"array_at") || len(a.args) != 2 { scope }
          else {
            let length = if name == b"list_at" { b"len" } else { b"array_len" };
            match term(context, scope, at(a.args, 0)) {
              Exactly(l) -> match l.base {
                Some(PlaceBase(xs)) -> if l.k != 0 { scope } else {
                  match linear(context, scope, at(a.args, 1)) {
                    Some(i) ->
                      {
                        ..scope,
                        facts: push(scope.facts, {
                          lo: i,
                          hi: { base: Some(LengthBase({ name: length, of: xs })), k: 0 },
                          strict: true,
                        }),
                      },
                    None -> scope,
                  }
                },
                _ -> scope,
              },
              _ -> scope,
            }
          },
          None -> scope,
        },
        _ -> scope,
      }
    },
    _ -> scope,
  }

// The facts `after` holds past those `before` did, which it extends.
fn facts_past(before: List<Fact>, after: List<Fact>) -> List<Fact> / {abort.raise} =
  map(range(len(before), len(after)), |i: Int| at(after, i))

fn irrefutable(p: Pattern) -> Bool =
  match p {
    PWild(_) -> true,
    PVar(_) -> true,
    PRecord(r) ->
      fold(r.fields, true, |ok: Bool, f: { name: Ident, pat: Pattern }| ok && irrefutable(f.pat)),
    _ -> false,
  }

fn append_facts(a: List<Fact>, b: List<Fact>) -> List<Fact> =
  fold(b, a, |acc: List<Fact>, f: Fact| push(acc, f))

fn compared(op: Bytes, l: Linear, r: Linear, truth: Bool) -> List<Fact> = {
  let lt = |a: Linear, b: Linear| { lo: a, hi: b, strict: true };
  let le = |a: Linear, b: Linear| { lo: a, hi: b, strict: false };
  if truth {
    if op == b"lt" { [lt(l, r)] }
    else if op == b"le" { [le(l, r)] }
    else if op == b"gt" { [lt(r, l)] }
    else if op == b"ge" { [le(r, l)] }
    else if op == b"eq" { [le(l, r), le(r, l)] }
    else { [] }
  } else {
    if op == b"lt" { [le(r, l)] }
    else if op == b"le" { [lt(r, l)] }
    else if op == b"gt" { [le(l, r)] }
    else if op == b"ge" { [lt(l, r)] }
    else if op == b"ne" { [le(l, r), le(r, l)] }
    else { [] }
  }
}

// --- The walk -------------------------------------------------------------------------------------

fn seen_of(context: MemberContext, def: FnDef) -> Seen / {abort.raise} = {
  let s = entry_scope(context, def);
  let defaults = fold(
    def.params,
    { calls: [], uses: [], outside: [], lost: None },
    |acc: Seen, p: Param| match p.default { Some(d) -> walk(context, s, acc, d), None -> acc },
  );
  walk(context, s, defaults, def.body)
}

// How the definition calls each function it is handed, and what it answers.
fn summary(context: MemberContext, x: Seen) -> Summary / {abort.raise} = {
  let def = at(context.group.defs, context.me);
  {
    names: map(def.params, |p: Param| p.name.name),
    params: map(range(0, len(def.params)), |i: Int|
      if !function_param(context.group, context.me, i) { NotCalled } else {
        fold(x.uses, CalledWith([]), |acc: Passing, u: Use|
          if u.param != i { acc } else {
            match acc {
              CalledWith(cs) -> match u.args {
                Some(a) -> CalledWith(push(cs, a)),
                None -> Escapes,
              },
              other -> other,
            }
          })
      }),
    result: match list_at(context.results, context.me) { Some(Some(t)) -> t, _ -> UnknownTerm },
  }
}

fn called(acc: Seen, x: Call) -> Seen = { ..acc, calls: push(acc.calls, x) }

fn used(acc: Seen, u: Use) -> Seen = { ..acc, uses: push(acc.uses, u) }

fn reached(acc: Seen, name: Bytes, span: Span) -> Seen =
  { ..acc, outside: push(acc.outside, { name: name, span: span }) }

// What a free name names; a name the walk bound is its own.
fn callee_of(context: MemberContext, scope: Scope, q: QName) -> Callee / {abort.raise} =
  match q.module {
    None -> match local(scope, q.name.name) {
      Some(_) -> OtherCallee,
      None -> context.group.resolve(q),
    },
    Some(_) -> context.group.resolve(q),
  }

fn builtin(context: MemberContext, scope: Scope, func: Expr) -> Option<Bytes> / {abort.raise} =
  match func {
    EVar(v) -> match callee_of(context, scope, v.name) { BuiltinCallee(n) -> Some(n), _ -> None },
    _ -> None,
  }

// The local a bare name binds.
fn local_of(s: Scope, q: QName) -> Option<Local> =
  match q.module { None -> local(s, q.name.name), Some(_) -> None }

fn walk(context: MemberContext, s: Scope, acc: Seen, e: Expr) -> Seen / {abort.raise} =
  match e {
    ELit(_) -> acc,
    // A function named but not called here is called wherever the value goes, with nothing known.
    EVar(v) -> match local_of(s, v.name) {
      Some(FunctionParam(i)) -> used(acc, { param: i, args: None }),
      Some(LetLambda(f)) -> lambda_escapes(context, s, acc, f),
      Some(KnownTerm(_)) -> acc,
      None -> match callee_of(context, s, v.name) {
        GroupMember(t) -> called(acc, { callee: t, args: [], facts: [], span: v.span }),
        DefinedCallee(n) -> reached(acc, n, v.span),
        _ -> acc,
      },
    },
    EBinary(b) -> if b.op == b"and" {
      walk(context, assume(context, s, b.lhs, true), walk(context, s, acc, b.lhs), b.rhs)
    } else if b.op == b"or" {
      walk(context, assume(context, s, b.lhs, false), walk(context, s, acc, b.lhs), b.rhs)
    } else { walk(context, s, walk(context, s, acc, b.lhs), b.rhs) },
    EUnary(u) -> walk(context, s, acc, u.operand),
    ELambda(l) -> walk(context, unknown_params(s, l.params), acc, l.body),
    EApp(a) -> applied(context, s, acc, a.func, a.args, a.named, a.span),
    EIf(i) -> {
      let cond = walk(context, s, acc, i.cond);
      walk(
        context,
        assume(context, s, i.cond, false),
        walk(context, assume(context, s, i.cond, true), cond, i.then_branch),
        i.else_branch,
      )
    },
    EMatch(m) -> {
      let t = term(context, s, m.scrutinee);
      // An arm whose pattern always matches is passed only when its guard fails.
      let walked = fold(
        m.arms,
        { seen: walk(context, s, acc, m.scrutinee), failed: [] },
        |a: { seen: Seen, failed: List<Fact> }, arm: MatchArm| {
          let inside = found_at(
            context,
            bind({ ..s, facts: append_facts(s.facts, a.failed) }, arm.pat, t),
            m.scrutinee,
            arm.pat,
          );
          match arm.guard {
            None -> { seen: walk(context, inside, a.seen, arm.body), failed: a.failed },
            Some(g) ->
              {
                seen: walk(
                  context,
                  assume(context, inside, g, true),
                  walk(context, inside, a.seen, g),
                  arm.body,
                ),
                failed: if irrefutable(arm.pat) {
                  append_facts(
                    a.failed,
                    facts_past(inside.facts, assume(context, inside, g, false).facts),
                  )
                } else { a.failed },
              },
          }
        },
      );
      walked.seen
    },
    EBlock(b) -> {
      let r = statements(context, s, acc, b.stmts);
      match b.tail { Some(t) -> walk(context, r.s, r.acc, t), None -> r.acc }
    },
    ERecord(r) -> fold(r.fields, acc, |a: Seen, f: RecField| walk(context, s, a, f.value)),
    ERecordUpdate(r) ->
      fold(r.fields, walk(context, s, acc, r.base), |a: Seen, f: RecField|
        walk(context, s, a, f.value)),
    ETry(t) -> walk(context, s, acc, t.operand),
    EField(f) -> walk(context, s, acc, f.base),
    EList(l) -> fold(l.items, acc, |a: Seen, x: Expr| walk(context, s, a, x)),
    EPerform(p) -> fold(p.args, acc, |a: Seen, x: Expr| walk(context, s, a, x)),
    EHandle(h) -> {
      let body = walk(context, s, acc, h.body);
      let returned = match h.ret {
        Some(r) -> walk(context, bound(s, r.binder.name, UnknownTerm), body, r.body),
        None -> body,
      };
      fold(h.clauses, returned, |a: Seen, k: HandleClause| {
        let params = fold(k.params, s, |sc: Scope, p: Ident| bound(sc, p.name, UnknownTerm));
        let resumed = match k.resume {
          Some(r) -> bound(params, r.name, UnknownTerm),
          None -> params,
        };
        walk(context, resumed, a, k.body)
      })
    },
    EWithCell(w) ->
      walk(context, bound(s, w.binder.name, UnknownTerm), walk(context, s, acc, w.init), w.body),
    ESimulate(x) -> walk(context, s, acc, x.body),
    EParallel(p) -> fold(p.branches, acc, |a: Seen, x: Expr| walk(context, s, a, x)),
    EBad(_) -> acc,
    ETryBlock(t) -> walk(context, s, acc, t.body),
  }

// A block's statements walked, and the scope past them.
fn statements(
  context: MemberContext,
  scope: Scope,
  acc: Seen,
  stmts: List<Stmt>,
) -> { s: Scope, acc: Seen } / {abort.raise} =
  fold(stmts, { s: scope, acc: acc }, |st: { s: Scope, acc: Seen }, x: Stmt|
    match x {
      SLet(l) -> match l.pat {
        PVar(_) -> match l.value {
          ELambda(_) -> { s: statement_scope(context, st.s, x), acc: st.acc },
          _ -> { s: statement_scope(context, st.s, x), acc: walk(context, st.s, st.acc, l.value) },
        },
        _ -> { s: statement_scope(context, st.s, x), acc: walk(context, st.s, st.acc, l.value) },
      },
      SLetElse(l) ->
        {
          s: statement_scope(context, st.s, x),
          acc: walk(context, st.s, walk(context, st.s, st.acc, l.value), l.fallback),
        },
      SExpr(y) -> { s: st.s, acc: walk(context, st.s, st.acc, y) },
    })

// Past this many lambdas' bodies read within one another, a body is not read.
fn inline_bound() -> Int = 8

// A `let` lambda called here with these arguments: its body, walked in the scope it was written in
// with what holds here.
fn inlined(
  context: MemberContext,
  s: Scope,
  acc: Seen,
  f: { params: List<Param>, body: Expr, locals: Map<Bytes, Local> },
  args: List<Term>,
) -> Seen / {abort.raise} =
  if context.depth >= inline_bound() { too_deep(acc, f.body) } else {
    let inside = fold(
      range(0, len(f.params)),
      { locals: f.locals, facts: s.facts },
      |sc: Scope, i: Int| bound(sc, at(f.params, i).name.name, actual(args, i)),
    );
    walk({ ..context, depth: context.depth + 1 }, inside, acc, f.body)
  }

fn lambda_escapes(
  context: MemberContext,
  scope: Scope,
  acc: Seen,
  f: { params: List<Param>, body: Expr, locals: Map<Bytes, Local> },
) -> Seen / {abort.raise} =
  if context.depth >= inline_bound() { too_deep(acc, f.body) } else {
    walk(
      { ..context, depth: context.depth + 1 },
      unknown_params({ locals: f.locals, facts: scope.facts }, f.params),
      acc,
      f.body,
    )
  }

fn too_deep(acc: Seen, body: Expr) -> Seen =
  match acc.lost { Some(_) -> acc, None -> { ..acc, lost: Some(expr_span(body)) } }

fn applied(
  context: MemberContext,
  scope: Scope,
  acc: Seen,
  func: Expr,
  args: List<Expr>,
  named: List<NamedArg>,
  span: Span,
) -> Seen / {abort.raise} = {
  let walk_args = |a: Seen|
    fold(
      named,
      fold(args, a, |x: Seen, y: Expr| walk(context, scope, x, y)),
      |x: Seen, n: NamedArg| walk(context, scope, x, n.value),
    );
  match func {
    EVar(v) -> match local_of(scope, v.name) {
      Some(LetLambda(f)) ->
        inlined(context, scope, walk_args(acc), f, map(args, |x: Expr| term(context, scope, x))),
      Some(FunctionParam(i)) ->
        used(walk_args(acc), {
          param: i,
          args: Some(map(args, |x: Expr| term(context, scope, x))),
        }),
      Some(KnownTerm(_)) -> walk_args(acc),
      None -> match callee_of(context, scope, v.name) {
        GroupMember(t) ->
          called(walk_args(acc), {
            callee: t,
            args: arguments(context, scope, t, args, named),
            facts: scope.facts,
            span: span,
          }),
        BuiltinCallee(name) -> match element_callback(name) {
          Some(shape) -> iterated(context, scope, acc, args, named, shape),
          None -> walk_args(acc),
        },
        DefinedCallee(n) -> match context.group.summary_of(n) {
          Some(sum) -> passed(context, scope, reached(acc, n, v.span), sum, args, named),
          None -> walk_args(reached(acc, n, v.span)),
        },
        _ -> walk_args(acc),
      },
    },
    _ -> walk(context, scope, walk_args(acc), func),
  }
}

// A call's arguments by the callee's parameters; one left to its default is unknown.
fn arguments(
  context: MemberContext,
  scope: Scope,
  t: Int,
  args: List<Expr>,
  named: List<NamedArg>,
) -> List<Term> / {abort.raise} =
  actuals(
    context,
    scope,
    map(at(context.group.defs, t).params, |p: Param| p.name.name),
    args,
    named,
  )

fn actuals(
  context: MemberContext,
  scope: Scope,
  names: List<Bytes>,
  args: List<Expr>,
  named: List<NamedArg>,
) -> List<Term> / {abort.raise} =
  map(range(0, len(names)), |i: Int|
    match list_at(args, i) {
      Some(x) -> term(context, scope, x),
      None ->
        fold(named, UnknownTerm, |found: Term, n: NamedArg|
          if n.name.name == at(names, i) { term(context, scope, n.value) } else { found }),
    })

// A call of a summarized definition: each function it is handed is called as the summary says.
fn passed(
  context: MemberContext,
  scope: Scope,
  acc: Seen,
  sum: Summary,
  args: List<Expr>,
  named: List<NamedArg>,
) -> Seen / {abort.raise} = {
  let terms = actuals(context, scope, sum.names, args, named);
  let at_param = |i: Int, seen: Seen, x: Expr|
    match list_at(sum.params, i) {
      Some(CalledWith(calls)) ->
        handed(
          context,
          scope,
          seen,
          x,
          map(calls, |call: List<Term>| map(call, |t: Term| translated(context, t, terms))),
        ),
      _ -> walk(context, scope, seen, x),
    };
  let positional = fold(range(0, len(args)), acc, |seen: Seen, i: Int|
    at_param(i, seen, at(args, i)));
  fold(named, positional, |seen: Seen, n: NamedArg|
    match index_of(sum.names, n.name.name) {
      Some(i) -> at_param(i, seen, n.value),
      None -> walk(context, scope, seen, n.value),
    })
}

fn index_of(xs: List<Bytes>, x: Bytes) -> Option<Int> / {abort.raise} =
  fold(range(0, len(xs)), None, |found: Option<Int>, i: Int|
    match found { Some(_) -> found, None -> if at(xs, i) == x { Some(i) } else { None } })

// A function handed to a callee that calls it with each of `calls`.
fn handed(
  context: MemberContext,
  s: Scope,
  acc: Seen,
  x: Expr,
  calls: List<List<Term>>,
) -> Seen / {abort.raise} =
  match x {
    ELambda(l) ->
      fold(calls, acc, |seen: Seen, call: List<Term>| {
        let inside = fold(range(0, len(l.params)), s, |sc: Scope, j: Int|
          bound(sc, at(l.params, j).name.name, actual(call, j)));
        walk(context, inside, seen, l.body)
      }),
    EVar(v) -> match local_of(s, v.name) {
      Some(LetLambda(f)) ->
        fold(calls, acc, |seen: Seen, call: List<Term>| inlined(context, s, seen, f, call)),
      Some(FunctionParam(i)) ->
        fold(calls, acc, |seen: Seen, call: List<Term>| used(seen, { param: i, args: Some(call) })),
      Some(KnownTerm(_)) -> acc,
      None -> match callee_of(context, s, v.name) {
        GroupMember(t) ->
          fold(calls, acc, |seen: Seen, call: List<Term>|
            called(seen, { callee: t, args: call, facts: s.facts, span: v.span })),
        _ -> walk(context, s, acc, x),
      },
    },
    // A function an `if`, a `match` or a block answers is called as each branch would be.
    EBlock(b) -> {
      let r = statements(context, s, acc, b.stmts);
      match b.tail { Some(t) -> handed(context, r.s, r.acc, t, calls), None -> r.acc }
    },
    EIf(i) ->
      handed(
        context,
        assume(context, s, i.cond, false),
        handed(
          context,
          assume(context, s, i.cond, true),
          walk(context, s, acc, i.cond),
          i.then_branch,
          calls,
        ),
        i.else_branch,
        calls,
      ),
    EMatch(m) -> {
      let t = term(context, s, m.scrutinee);
      fold(m.arms, walk(context, s, acc, m.scrutinee), |seen: Seen, arm: MatchArm| {
        let inside = bind(s, arm.pat, t);
        match arm.guard {
          None -> handed(context, inside, seen, arm.body, calls),
          Some(g) ->
            handed(
              context,
              assume(context, inside, g, true),
              walk(context, inside, seen, g),
              arm.body,
              calls,
            ),
        }
      })
    },
    _ -> walk(context, s, acc, x),
  }

// A builtin that calls its argument at `callback` once per element of its argument at `list`,
// handing parts of it in as the callback's parameters at `params`: a map's key and value both.
type Iterates = { list: Int, callback: Int, params: List<Int>, arity: Int }

fn element_callback(name: Bytes) -> Option<Iterates> =
  if name == b"map" || name == b"filter" { Some({ list: 0, callback: 1, params: [0], arity: 1 }) }
  else if name == b"fold" { Some({ list: 0, callback: 2, params: [1], arity: 2 }) }
  else if name == b"map_fold" { Some({ list: 0, callback: 2, params: [1, 2], arity: 3 }) }
  else { None }

fn iterated(
  context: MemberContext,
  scope: Scope,
  acc: Seen,
  args: List<Expr>,
  named: List<NamedArg>,
  shape: Iterates,
) -> Seen / {abort.raise} = {
  let others = fold(named, acc, |seen: Seen, n: NamedArg| walk(context, scope, seen, n.value));
  let element = match list_at(args, shape.list) {
    Some(x) -> element(context, scope, x),
    None -> UnknownTerm,
  };
  let call = map(range(0, shape.arity), |j: Int|
    if fold(shape.params, false, |found: Bool, p: Int| found || p == j) { element }
    else { UnknownTerm });
  fold(range(0, len(args)), others, |seen: Seen, i: Int| {
    let x = at(args, i);
    if i != shape.callback { walk(context, scope, seen, x) }
    else { handed(context, scope, seen, x, [call]) }
  })
}
