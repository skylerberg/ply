//! What the emitter writes in place over the objects the runtime lays out: where a list's and a
//! map's parts lie, which the runtime's description reports too, and the externs it writes over
//! them, which no native implements.

/// A list's own object: the root of its trie at word `root`, zero for none, then the tail's items
/// from word `tail`. Its header's `len` holds how many items the list has, and the fields named
/// here hold how many items a `rest` dropped from the trie's front, how many the tail holds, and
/// how many it has room for.
pub type ListLaid = { root: Int, tail: Int, start: Bytes, tail_len: Bytes, room: Bytes }

/// The nodes of a list's trie, of kind `leaf` or `branch`: each holds at most `width` items or
/// children from word 0, as many as its header's `len`.
pub type TrieLaid = { leaf: Int, branch: Int, width: Int }

/// A map's own object: the root of its tree at word `root`, zero for none. Its header's `len` holds
/// how many entries the map has, and the field `height` how many levels of branches stand above its
/// leaves, every leaf at that depth.
pub type MapLaid = { root: Int, height: Bytes }

/// The nodes of a map's tree, as many pairs or children as their header's `len`: a leaf of kind
/// `leaf` holds at most `width` pairs in key order, key `i` at word `2 * i` and its value after
/// it; a branch of kind `branch` at most `width` children from word 0, with room for one more until
/// a cut, the greatest key under each from word `keys`, and how many entries lie under each from
/// word `sizes`, as an immediate.
pub type TreeLaid = { leaf: Int, branch: Int, width: Int, keys: Int, sizes: Int }

/// Each object the emitter writes code over in place, laid out as the runtime lays it out. A header
/// field is named as the C prelude's `PlyObj` names it.
pub type Layouts = { list: ListLaid, trie: TrieLaid, map: MapLaid, tree: TreeLaid }

/// The layouts the emitter writes against.
pub fn layouts() -> Layouts =
  {
    list: { root: 0, tail: 1, start: b"layout", tail_len: b"flags", room: b"aux" },
    trie: { leaf: 11, branch: 12, width: 32 },
    map: { root: 0, height: b"layout" },
    tree: { leaf: 13, branch: 14, width: 32, keys: 33, sizes: 66 },
  }

/// A function of `ListNode` the emitter writes in place over a list's objects.
pub type ListOp =
  | ListStart
  | TailLen
  | ListRoot
  | TailAt
  | NodeLen
  | LeafAt
  | KidAt
  | TailPush
  | TailSet
  | LeafSet
  | RootSwap
  | KidSwap
  | TailStart
  | Spill
  | NewBranch

/// A function of `MapNode` the emitter writes in place over a map's objects.
pub type MapOp =
  | MapRoot
  | NodeCount
  | MapHeight
  | NodeKey
  | NodeValue
  | NodeKid
  | KidMax
  | KidSize
  | NewLeaf
  | NewMapBranch
  | PairPut
  | PairSet
  | PairTake
  | LeafCut
  | BranchCut
  | KidOut
  | KidBack
  | KidPut
  | KidDrop
  | MapSwap

/// An extern the emitter writes in place.
pub type Intrinsic = | OfList(ListOp) | OfMap(MapOp)

/// Every extern the emitter writes in place, by its declaration's program-wide name: no native
/// implements one, and a call of one is never a call of the runtime.
pub fn intrinsics() -> List<{ name: Bytes, op: Intrinsic }> =
  [
    { name: b"std.prelude.ListNode::start", op: OfList(ListStart) },
    { name: b"std.prelude.ListNode::tail_len", op: OfList(TailLen) },
    { name: b"std.prelude.ListNode::root", op: OfList(ListRoot) },
    { name: b"std.prelude.ListNode::tail_at", op: OfList(TailAt) },
    { name: b"std.prelude.ListNode::len", op: OfList(NodeLen) },
    { name: b"std.prelude.ListNode::leaf_at", op: OfList(LeafAt) },
    { name: b"std.prelude.ListNode::kid_at", op: OfList(KidAt) },
    { name: b"std.prelude.ListNode::tail_push", op: OfList(TailPush) },
    { name: b"std.prelude.ListNode::tail_set", op: OfList(TailSet) },
    { name: b"std.prelude.ListNode::leaf_set", op: OfList(LeafSet) },
    { name: b"std.prelude.ListNode::root_swap", op: OfList(RootSwap) },
    { name: b"std.prelude.ListNode::kid_swap", op: OfList(KidSwap) },
    { name: b"std.prelude.ListNode::tail_start", op: OfList(TailStart) },
    { name: b"std.prelude.ListNode::spill", op: OfList(Spill) },
    { name: b"std.prelude.ListNode::branch", op: OfList(NewBranch) },
    { name: b"std.prelude.MapNode::root", op: OfMap(MapRoot) },
    { name: b"std.prelude.MapNode::count", op: OfMap(NodeCount) },
    { name: b"std.prelude.MapNode::height", op: OfMap(MapHeight) },
    { name: b"std.prelude.MapNode::key", op: OfMap(NodeKey) },
    { name: b"std.prelude.MapNode::value", op: OfMap(NodeValue) },
    { name: b"std.prelude.MapNode::kid", op: OfMap(NodeKid) },
    { name: b"std.prelude.MapNode::kid_max", op: OfMap(KidMax) },
    { name: b"std.prelude.MapNode::kid_size", op: OfMap(KidSize) },
    { name: b"std.prelude.MapNode::leaf", op: OfMap(NewLeaf) },
    { name: b"std.prelude.MapNode::branch", op: OfMap(NewMapBranch) },
    { name: b"std.prelude.MapNode::pair_put", op: OfMap(PairPut) },
    { name: b"std.prelude.MapNode::pair_set", op: OfMap(PairSet) },
    { name: b"std.prelude.MapNode::pair_take", op: OfMap(PairTake) },
    { name: b"std.prelude.MapNode::leaf_cut", op: OfMap(LeafCut) },
    { name: b"std.prelude.MapNode::branch_cut", op: OfMap(BranchCut) },
    { name: b"std.prelude.MapNode::kid_out", op: OfMap(KidOut) },
    { name: b"std.prelude.MapNode::kid_back", op: OfMap(KidBack) },
    { name: b"std.prelude.MapNode::kid_put", op: OfMap(KidPut) },
    { name: b"std.prelude.MapNode::kid_drop", op: OfMap(KidDrop) },
    { name: b"std.prelude.MapNode::map_swap", op: OfMap(MapSwap) },
  ]

/// Pure and nullary, so the runtime builds it once.
fn intrinsic_map() -> Map<Bytes, Intrinsic> =
  intrinsics().fold(Map::new(), |acc: Map<Bytes, Intrinsic>, i: { name: Bytes, op: Intrinsic }|
    acc.insert(i.name, i.op))

/// What the emitter writes in place of a call of the extern whose program-wide name is `name`;
/// `None` for any other.
pub fn intrinsic_named(name: Bytes) -> Option<Intrinsic> = intrinsic_map().get(name)
