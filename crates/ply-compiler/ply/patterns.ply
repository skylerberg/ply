// Patterns, and the `Lit` that expressions share with them.

import spine (push_front, positional, Span, Ident, QName, Ctx, P, R, Ate, Acc, PDiag, span_to,
              dummy_span, no_ident, no_qname, unexpected, diag1, push_diag, error_here, unclosed,
              kind, kind_at, cur_span, span_at, prev_span, at, at_eof, starts_upper, advance, bump,
              eat, tok_bytes, tok_at, expect, expect_close, expect_ident, expect_field_name,
              keyword_pun_refusal, deeper, shallower, qname, comma_list, settle, failed, t_lparen,
              t_rparen, t_lbrace, t_rbrace, t_lbracket, t_rbracket, t_comma, t_colon, t_dotdot,
              t_minus, t_underscore, k_true, k_false, num, rec, nlist, opt, payload, word,
              dump_list, dump_opt, dump_ident, dump_qname, dump_diags, start)
import lexer (Tok, Token, TIdent, TInt, TFixed, TFloat, TDec, TStr, TBytes, TKw, TPunct, TEof,
              Width, width_named, width_normalize)

// --- Literals ---------------------------------------------------------------

// `LFloat` and `LDec` carry the raw source over the literal node's own span, `-` included, never a parsed value.
pub type Lit =
  | LInt(Int)
  // A width-suffixed literal: the width's name and the `Int` bit pattern the width reads.
  | LFixed(Bytes, Int)
  | LBool(Bool)
  | LStr(Bytes)
  | LBytes(Bytes)
  | LFloat(Bytes)
  | LDec(Bytes)
  | LUnit
  | LBad

pub fn dump_lit(l: Lit) -> Bytes =
  match l {
    LInt(v) -> bytes_concat(word(b"int"), payload(num(v))),
    LFixed(ty, v) -> bytes_concat(word(b"fixed"), payload(bytes_concat_all([ty, b":", num(v)]))),
    LBool(b) -> bytes_concat(word(b"bool"), payload(if b { b"1" } else { b"0" })),
    LStr(s) -> bytes_concat(word(b"str"), payload(s)),
    LBytes(b) -> bytes_concat(word(b"bytes"), payload(b)),
    LFloat(r) -> bytes_concat(word(b"float"), payload(r)),
    LDec(r) -> bytes_concat(word(b"dec"), payload(r)),
    LUnit -> word(b"unit"),
    LBad -> word(b"badlit"),
  }

// --- The AST ----------------------------------------------------------------

// Every variant carries its own span: a parenthesised pattern's span covers the parens, wider than its name's.
pub type Pattern =
  | PWild({ span: Span })
  | PVar({ span: Span, name: Ident })
  | PLit({ span: Span, lit: Lit })
  | PCtor({ span: Span, name: QName, args: List<Pattern> })
  | PRecord({ span: Span, rest: Bool, fields: List<{ name: Ident, pat: Pattern }> })
  | PList({ span: Span, rest: Option<Pattern>, items: List<Pattern> })
  // The placeholder `settle` asks for; no parse produces it.
  | PBad({ span: Span })

pub fn pat_span(x: Pattern) -> Span =
  match x {
    PWild(v) -> v.span,
    PVar(v) -> v.span,
    PLit(v) -> v.span,
    PCtor(v) -> v.span,
    PRecord(v) -> v.span,
    PList(v) -> v.span,
    PBad(v) -> v.span,
  }

fn set_pat_span(x: Pattern, s: Span) -> Pattern =
  match x {
    PWild(v) -> PWild({ span: s }),
    PVar(v) -> PVar({ span: s, name: v.name }),
    PLit(v) -> PLit({ span: s, lit: v.lit }),
    PCtor(v) -> PCtor({ span: s, name: v.name, args: v.args }),
    PRecord(v) -> PRecord({ span: s, rest: v.rest, fields: v.fields }),
    PList(v) -> PList({ span: s, rest: v.rest, items: v.items }),
    PBad(v) -> PBad({ span: s }),
  }

pub fn no_pattern() -> Pattern = PBad({ span: dummy_span() })

fn is_bare(q: QName) -> Bool = match q.module { None -> true, Some(m) -> false }

// --- Patterns ---------------------------------------------------------------

pub fn pattern(c: Ctx, p: P) -> Result<R<Pattern>, P> = {
  let d = deeper(c, p)?;
  match pattern_body(c, d) {
    Err(q) -> Err(shallower(q)),
    Ok(r) -> Ok({ p: shallower(r.p), node: r.node }),
  }
}

fn lit_pat(c: Ctx, p: P, l: Lit) -> Result<R<Pattern>, P> = {
  let a = advance(c, p);
  Ok({ p: a.p, node: PLit({ span: a.node, lit: l }) })
}

fn src_over(c: Ctx, s: Span) -> Bytes = bytes_slice(c.src, s.start, s.end)

fn is_num_tok(t: Tok) -> Bool =
  match t {
    TInt(v) -> true,
    TFixed(ty, v) -> true,
    TFloat(f) -> true,
    TDec(m, sc) -> true,
    _ -> false,
  }

fn pattern_body(c: Ctx, p: P) -> Result<R<Pattern>, P> = {
  let st = cur_span(c, p);
  match kind(c, p) {
    TInt(v) -> lit_pat(c, p, LInt(v)),
    TFixed(ty, v) -> lit_pat(c, p, LFixed(ty, v)),
    // The lexer's payload is discarded: the tree holds the source, sliced.
    TFloat(f) -> lit_pat(c, p, LFloat(src_over(c, st))),
    TDec(m, sc) -> lit_pat(c, p, LDec(src_over(c, st))),
    TStr(s) -> lit_pat(c, p, LStr(s)),
    TBytes(b) -> lit_pat(c, p, LBytes(b)),
    TKw(k) -> if k == b"true" { lit_pat(c, p, LBool(true)) }
    else if k == b"false" { lit_pat(c, p, LBool(false)) }
    else { Err(error_here(c, p, b"a pattern")) },
    TIdent(n) -> pattern_named(c, p, st),
    TPunct(s) -> if s == b"underscore" {
      let a = advance(c, p);
      Ok({ p: a.p, node: PWild({ span: a.node }) })
    }
    // A negative literal is one pattern, decided by two tokens of lookahead.
    else if s == b"minus" && is_num_tok(kind_at(c, p, 1)) { neg_lit(c, p, st) }
    else if s == b"lparen" { pattern_paren(c, p) }
    else if s == b"lbracket" { list_pattern(c, p) }
    else if s == b"lbrace" { record_pattern(c, p) }
    else { Err(error_here(c, p, b"a pattern")) },
    _ -> Err(error_here(c, p, b"a pattern")),
  }
}

fn string_lower_bytes(b: Bytes) -> Bytes = bytes_of_string(string_lower(string_of_bytes(b)))

// `-v` wrapped to the width.
fn neg_at_width(ty: Bytes, v: Int) -> Int =
  match width_named(string_lower_bytes(ty)) {
    Some(w) -> width_normalize(w, wrap_sub(0, v)),
    None -> 0 - v,
  }

fn neg_lit(c: Ctx, p: P, st: Span) -> Result<R<Pattern>, P> = {
  let m = advance(c, p);
  let a = advance(c, m.p);
  let s = span_to(st, a.node);
  // `Float` and `Decimal` are not negated: their raw source over `s` already has the `-`.
  match kind(c, m.p) {
    TInt(v) -> Ok({ p: a.p, node: PLit({ span: s, lit: LInt(0 - v) }) }),
    // Negated at the width, so each signed type's minimum (`-128i8`) is writable.
    TFixed(ty, v) -> Ok({ p: a.p, node: PLit({ span: s, lit: LFixed(ty, neg_at_width(ty, v)) }) }),
    TFloat(f) -> Ok({ p: a.p, node: PLit({ span: s, lit: LFloat(src_over(c, s)) }) }),
    TDec(mm, sc) -> Ok({ p: a.p, node: PLit({ span: s, lit: LDec(src_over(c, s)) }) }),
    // Unreachable: `is_num_tok` admitted only a number.
    _ -> Ok({ p: a.p, node: PLit({ span: s, lit: LBad }) }),
  }
}

fn pattern_paren(c: Ctx, p: P) -> Result<R<Pattern>, P> = {
  let o = advance(c, p);
  if at(c, o.p, t_rparen()) {
    let cl = advance(c, o.p);
    Ok({ p: cl.p, node: PLit({ span: span_to(o.node, cl.node), lit: LUnit }) })
  } else {
    let inner = pattern(c, o.p)?;
    if at(c, inner.p, t_comma()) {
      // A comma makes a tuple pattern: the exact record pattern `{_0: p, _1: q}`.
      let rest = comma_list(c, advance(c, inner.p).p, t_rparen(), pattern)?;
      let cl = expect_close(c, rest.p, t_rparen(), o.node, b"`)` to close the tuple")?;
      let items = push_front(inner.node, rest.node);
      if len(items) == 1 {
        Ok({ p: cl.p, node: set_pat_span(inner.node, span_to(o.node, cl.node)) })
      } else {
        Ok({
          p: cl.p,
          node: PRecord({
            span: span_to(o.node, cl.node),
            rest: false,
            fields: map(range(0, len(items)), |i: Int| -> { name: Ident, pat: Pattern } {
              match list_at(items, i) {
                Some(q) -> { name: positional(i, pat_span(q)), pat: q },
                None -> { name: positional(i, o.node), pat: PWild({ span: o.node }) },
              }
            }),
          }),
        })
      }
    } else {
      let close = expect_close(c, inner.p, t_rparen(), o.node, b"`)`")?;
      Ok({ p: close.p, node: set_pat_span(inner.node, span_to(o.node, close.node)) })
    }
  }
}

fn pattern_named(c: Ctx, p: P, st: Span) -> Result<R<Pattern>, P> = {
  let q = qname(c, p, b"a pattern")?;
  if is_bare(q.node) && !starts_upper(q.node.name.name) {
    Ok({ p: q.p, node: PVar({ span: st, name: q.node.name }) })
  } else if at(c, q.p, t_lparen()) {
    let o = advance(c, q.p);
    let args = comma_list(c, o.p, t_rparen(), pattern)?;
    let cl = expect_close(
      c,
      args.p,
      t_rparen(),
      o.node,
      b"`)` to close the constructor arguments",
    )?;
    Ok({ p: cl.p, node: PCtor({ span: span_to(st, cl.node), name: q.node, args: args.node }) })
  } else { Ok({ p: q.p, node: PCtor({ span: span_to(st, q.node.span), name: q.node, args: [] }) }) }
}

// --- List patterns ----------------------------------------------------------

// `items` grows, so it is written last in every literal that pushes to it.
type ListAcc = { p: P, rest: Option<Pattern>, items: List<Pattern> }

type ListOut = { rest: Option<Pattern>, items: List<Pattern> }

fn list_pattern(c: Ctx, p: P) -> Result<R<Pattern>, P> = {
  let o = advance(c, p);
  let { p, node: b } = list_items(c, o.p, o.node)?;
  let { p, node: cl } = expect_close(c, p, t_rbracket(), o.node, b"`]` to close the list pattern")?;
  Ok({ p: p, node: PList({ span: span_to(o.node, cl), rest: b.rest, items: b.items }) })
}

fn list_items(c: Ctx, p: P, open: Span) -> Result<R<ListOut>, P> =
  iterate({ p: p, rest: None, items: [] }, c.ntok - p.pos + 1, |s: ListAcc|
    if at(c, s.p, t_rbracket()) { Stop(Ok({ p: s.p, node: { rest: s.rest, items: s.items } })) }
    else if at_eof(c, s.p) { Stop(Err(unclosed(c, s.p, open, b"`]` to close the list pattern"))) } else if at(
        c,
        s.p,
        t_dotdot(),
      ) {
      let d = advance(c, s.p);
      let bound = match kind(c, d.p) {
        TIdent(n) -> match expect_ident(c, d.p, b"a name after `..`") {
          Err(q) -> Err(q),
          Ok(i) -> Ok({ p: i.p, node: PVar({ span: i.node.span, name: i.node }) }),
        },
        _ -> Ok({ p: d.p, node: PWild({ span: d.node }) }),
      };
      match bound {
        Err(q) -> Stop(Err(q)),
        // A trailing comma after `..` is allowed; an element after it is not.
        Ok(b) ->
          Stop(Ok({ p: eat(c, b.p, t_comma()).p, node: { items: s.items, rest: Some(b.node) } })),
      }
    } else {
      match pattern(c, s.p) {
        Err(q) -> Stop(Err(q)),
        Ok(it) -> {
          let e = eat(c, it.p, t_comma());
          if e.ok { Continue({ p: e.p, rest: s.rest, items: push(s.items, it.node) }) }
          else { Stop(Ok({ p: e.p, node: { rest: s.rest, items: push(s.items, it.node) } })) }
        },
      }
    })

// --- Record patterns --------------------------------------------------------

type RecAcc = { p: P, rest: Bool, fields: List<{ name: Ident, pat: Pattern }> }

type RecOut = { rest: Bool, fields: List<{ name: Ident, pat: Pattern }> }

fn record_pattern(c: Ctx, p: P) -> Result<R<Pattern>, P> = {
  let o = advance(c, p);
  let { p, node: b } = record_fields(c, o.p, o.node)?;
  let { p, node: cl } = expect_close(c, p, t_rbrace(), o.node, b"`}` to close the record pattern")?;
  Ok({ p: p, node: PRecord({ span: span_to(o.node, cl), rest: b.rest, fields: b.fields }) })
}

fn record_fields(c: Ctx, p: P, open: Span) -> Result<R<RecOut>, P> =
  iterate({ p: p, rest: false, fields: [] }, c.ntok - p.pos + 1, |s: RecAcc|
    if at(c, s.p, t_rbrace()) { Stop(Ok({ p: s.p, node: { rest: s.rest, fields: s.fields } })) }
    else if at_eof(c, s.p) { Stop(Err(unclosed(c, s.p, open, b"`}` to close the record pattern"))) } else {
      let dd = eat(c, s.p, t_dotdot());
      if dd.ok {
        Stop(Ok({ p: eat(c, dd.p, t_comma()).p, node: { fields: s.fields, rest: true } }))
      } else {
        match expect_field_name(c, s.p, b"a field name") {
          Err(q) -> Stop(Err(q)),
          Ok(fname) -> {
            let n = { p: fname.p, node: fname.node.name };
            let co = eat(c, n.p, t_colon());
            // The shorthand `{x}` binds with the name's span; a keyword cannot be punned.
            let f = if co.ok { pattern(c, co.p) }
            else if fname.node.keyword { Err(keyword_pun_refusal(co.p, n.node)) }
            else { Ok({ p: co.p, node: PVar({ span: n.node.span, name: n.node }) }) };
            match f {
              Err(q) -> Stop(Err(q)),
              Ok(fv) -> {
                let e = eat(c, fv.p, t_comma());
                if e.ok {
                  Continue({
                    p: e.p,
                    rest: s.rest,
                    fields: push(s.fields, { name: n.node, pat: fv.node }),
                  })
                } else {
                  Stop(
                    Ok({
                      p: e.p,
                      node: {
                        rest: s.rest,
                        fields: push(s.fields, { name: n.node, pat: fv.node }),
                      },
                    }),
                  )
                }
              },
            }
          },
        }
      }
    })

// --- The dump ---------------------------------------------------------------

pub fn dump_pattern(x: Pattern) -> Bytes =
  match x {
    PWild(v) -> rec(v.span, b"pwld"),
    PVar(v) -> bytes_concat(rec(v.span, b"pvar"), dump_ident(v.name)),
    PLit(v) -> bytes_concat(rec(v.span, b"plit"), dump_lit(v.lit)),
    PCtor(v) ->
      bytes_concat_all([rec(v.span, b"pctr"), dump_qname(v.name), dump_list(v.args, dump_pattern)]),
    PRecord(v) ->
      bytes_concat_all([rec(v.span, b"prec"), opt(v.rest), dump_list(v.fields, dump_pat_field)]),
    PList(v) ->
      bytes_concat_all([
        rec(v.span, b"plst"),
        dump_list(v.items, dump_pattern),
        dump_opt(v.rest, dump_pattern),
      ]),
    PBad(v) -> rec(v.span, b"pbad"),
  }

fn dump_pat_field(f: { name: Ident, pat: Pattern }) -> Bytes =
  bytes_concat(dump_ident(f.name), dump_pattern(f.pat))

// --- The area's own entry point ---------------------------------------------

// Parses one pattern on its own, for the tests below.
pub fn dump_pattern_of(src: Bytes) -> String = {
  let s = start(src);
  let r = settle(pattern(s.c, s.p), no_pattern());
  string_of_bytes(bytes_concat(dump_pattern(r.node), dump_diags(r.p.diags)))
}

// --- Tests ------------------------------------------------------------------

test "wildcards, variables and constructors" {
  assert_eq(dump_pattern_of(b"_"), "0:1:pwld;#0;");
  assert_eq(dump_pattern_of(b"x"), "0:1:pvar;0:1:ident;@78;#0;");
  assert_eq(dump_pattern_of(b"None"), "0:4:pctr;0:4:qname;?0;0:4:ident;@4e6f6e65;#0;#0;");
  assert_eq(
    dump_pattern_of(b"Some(x)"),
    "0:7:pctr;0:4:qname;?0;0:4:ident;@536f6d65;#1;5:6:pvar;5:6:ident;@78;#0;",
  );
  assert_eq(
    dump_pattern_of(b"m::Ok(a, b)"),
    "0:11:pctr;0:5:qname;?1;0:1:ident;@6d;3:5:ident;@4f6b;#2;6:7:pvar;6:7:ident;@61;9:10:pvar;9:10:ident;@62;#0;",
  )
}

test "a parenthesised pattern is the inner node with the parens' span" {
  assert_eq(dump_pattern_of(b"(x)"), "0:3:pvar;1:2:ident;@78;#0;");
  assert_eq(dump_pattern_of(b"()"), "0:2:plit;%unit;#0;")
}

test "literal patterns" {
  assert_eq(dump_pattern_of(b"42"), "0:2:plit;%int;@3432;#0;");
  assert_eq(dump_pattern_of(b"1_000"), "0:5:plit;%int;@31303030;#0;");
  assert_eq(dump_pattern_of(b"true"), "0:4:plit;%bool;@31;#0;");
  assert_eq(dump_pattern_of(b"false"), "0:5:plit;%bool;@30;#0;");
  assert_eq(dump_pattern_of(b"\"hi\""), "0:4:plit;%str;@6869;#0;");
  assert_eq(dump_pattern_of(b"b\"GET \""), "0:7:plit;%bytes;@47455420;#0;")
}

test "a float or decimal pattern carries the source bytes over its own span" {
  assert_eq(dump_pattern_of(b"1.5"), "0:3:plit;%float;@312e35;#0;");
  assert_eq(dump_pattern_of(b"1.50m"), "0:5:plit;%dec;@312e35306d;#0;")
}

test "a negative literal pattern is one literal and the minus is in its span" {
  assert_eq(dump_pattern_of(b"-42"), "0:3:plit;%int;@2d3432;#0;");
  assert_eq(dump_pattern_of(b"-1.5"), "0:4:plit;%float;@2d312e35;#0;");
  assert_eq(dump_pattern_of(b"-1.50m"), "0:6:plit;%dec;@2d312e35306d;#0;");
  assert_eq(dump_pattern_of(b"- 1.5"), "0:5:plit;%float;@2d20312e35;#0;")
}

test "list patterns, with and without a rest binding" {
  assert_eq(dump_pattern_of(b"[]"), "0:2:plst;#0;?0;#0;");
  assert_eq(
    dump_pattern_of(b"[a, b]"),
    "0:6:plst;#2;1:2:pvar;1:2:ident;@61;4:5:pvar;4:5:ident;@62;?0;#0;",
  );
  assert_eq(
    dump_pattern_of(b"[a, ..rest]"),
    "0:11:plst;#1;1:2:pvar;1:2:ident;@61;?1;6:10:pvar;6:10:ident;@72657374;#0;",
  );
  assert_eq(dump_pattern_of(b"[..]"), "0:4:plst;#0;?1;1:3:pwld;#0;");
  assert_eq(dump_pattern_of(b"[a, ..]"), "0:7:plst;#1;1:2:pvar;1:2:ident;@61;?1;4:6:pwld;#0;")
}

test "record patterns, the shorthand, and the rest marker" {
  assert_eq(
    dump_pattern_of(b"{x, y: z}"),
    "0:9:prec;?0;#2;1:2:ident;@78;1:2:pvar;1:2:ident;@78;4:5:ident;@79;7:8:pvar;7:8:ident;@7a;#0;",
  );
  assert_eq(dump_pattern_of(b"{..}"), "0:4:prec;?1;#0;#0;");
  assert_eq(dump_pattern_of(b"{x, ..}"), "0:7:prec;?1;#1;1:2:ident;@78;1:2:pvar;1:2:ident;@78;#0;")
}

test "an unclosed list pattern labels its opening bracket" {
  assert_eq(dump_pattern_of(b"[a"), "0:0:pbad;#1;!E0001:2:2:2:0;=2:2:1;=0:1:0;")
}

test "a field with no pattern after its colon is one diagnostic" {
  assert_eq(dump_pattern_of(b"{x: }"), "0:0:pbad;#1;!E0001:4:5:1:0;=4:5:1;")
}

test "a lexical error and the syntactic one it causes are both reported" {
  assert_eq(dump_pattern_of(b"@"), "0:0:pbad;#2;!E0001:0:1:1:0;=0:1:1;!E0001:1:1:1:0;=1:1:1;")
}
