// The parser's spine: token access, threaded state, diagnostics, the sequence driver, the dump encoder.
// Rule: a parse function answers `Result<R<Thing>, P>` and propagates with `?`, except around a
// save/restore of `no_brace`, `no_pipe` or `depth`, which is a `match` so both paths restore.
// Rule: a sequence is one `iterate`, never recursion; recursion is reserved for grammar nesting.
// Rule: the growing field is last in every record literal (`Acc.out`, `P.diags`), or accumulation
// turns quadratic; build a `P` only through the constructors below.

import lexer

// --- Spans, names -----------------------------------------------------------

pub type Span = { start: Int, end: Int }

pub type Ident = { name: Bytes, span: Span }

pub type QName = { module: Option<Ident>, name: Ident, span: Span }

pub fn dummy_span() -> Span = { start: 0, end: 0 }

pub fn sp(s: Int, e: Int) -> Span = { start: s, end: e }

pub fn span_to(a: Span, b: Span) -> Span =
  {
    start: if a.start < b.start { a.start } else { b.start },
    end: if a.end > b.end { a.end } else { b.end },
  }

// A span as the key a table of per-site facts is read by.
pub fn span_key(s: Span) -> Bytes = bytes_concat_all([num(s.start), b":", num(s.end)])

pub fn no_ident() -> Ident = { name: b"", span: dummy_span() }

pub fn no_qname() -> QName = { module: None, name: no_ident(), span: dummy_span() }

pub fn bare(i: Ident) -> QName = { module: None, name: i, span: i.span }

pub fn qualified(m: Ident, n: Ident) -> QName =
  { module: Some(m), name: n, span: span_to(m.span, n.span) }

// --- Diagnostics ------------------------------------------------------------

// `notes` is always `len(notes_text)`.
pub type Label = { start: Int, end: Int, primary: Bool, text: Bytes }

pub type PDiag = {
  code: Bytes,
  notes: Int,
  labels: List<Label>,
  message: Bytes,
  notes_text: List<Bytes>,
  severity: Bytes,
}

pub fn unexpected() -> Bytes = b"E0001"
pub fn unterminated() -> Bytes = b"E0002"
pub fn duplicate_definition() -> Bytes = b"E0105"
pub fn unknown_effect_set() -> Bytes = b"E0114"
pub fn effect_set_cycle() -> Bytes = b"E0115"
pub fn unknown_deriver() -> Bytes = b"E0207"
pub fn default_not_allowed() -> Bytes = b"E0120"
pub fn unknown_argument_name() -> Bytes = b"E0123"
pub fn argument_order() -> Bytes = b"E0124"

pub fn plabel(at: Span, primary: Bool, text: Bytes) -> Label =
  { start: at.start, end: at.end, primary: primary, text: text }

pub fn pdiag(code: Bytes, message: Bytes, labels: List<Label>, notes: List<Bytes>) -> PDiag =
  {
    code: code,
    notes: len(notes),
    labels: labels,
    message: message,
    notes_text: notes,
    severity: b"error",
  }

pub fn diag1(code: Bytes, at: Span, message: Bytes, label: Bytes, notes: List<Bytes>) -> PDiag =
  pdiag(code, message, [plabel(at, true, label)], notes)

pub fn diag2(
  code: Bytes,
  at: Span,
  message: Bytes,
  label: Bytes,
  also: Span,
  also_text: Bytes,
  notes: List<Bytes>,
) -> PDiag = pdiag(code, message, [plabel(at, true, label), plabel(also, false, also_text)], notes)

pub fn primary_span_of(d: PDiag) -> Span = {
  let first = fold(
    d.labels,
    { seen: false, s: dummy_span() },
    |a: { seen: Bool, s: Span }, l: Label|
      if a.seen { a } else { { seen: true, s: { start: l.start, end: l.end } } },
  );
  let prim = fold(
    d.labels,
    { seen: false, s: dummy_span() },
    |a: { seen: Bool, s: Span }, l: Label|
      if a.seen || !l.primary { a } else { { seen: true, s: { start: l.start, end: l.end } } },
  );
  if prim.seen { prim.s } else { first.s }
}

// --- The token buffer -------------------------------------------------------

pub type Ctx = { ntok: Int, src: Bytes, toks: List<lexer::Token> }

// `gt_split` is the index where `expect_gt` split a `>=`: `tok_index` reads it as `=` over its
// second byte. One slot suffices because `pos` must pass a split before another can happen.
pub type P = {
  pos: Int,
  no_brace: Bool,
  // Inside a lambda's parameter list, `|` closes the list and is never bit-or.
  no_pipe: Bool,
  depth: Int,
  gt_split: Int,
  uses_sets: Bool,
  diags: List<PDiag>,
}

pub type R<a> = { p: P, node: a }

pub type Ate = { p: P, ok: Bool }

pub type Acc<a> = { p: P, out: List<a> }

pub type Start = { c: Ctx, p: P }

pub fn start(src: Bytes) -> Start = {
  let lx = lexer::lex(src);
  let d = map(lx.diags, |x: lexer::Diag|
    diag1(x.code, { start: x.start, end: x.end }, x.message, x.label, []));
  {
    c: { ntok: len(lx.toks), src: src, toks: lx.toks },
    p: {
      pos: 0,
      no_brace: false,
      no_pipe: false,
      depth: 0,
      gt_split: -1,
      uses_sets: false,
      diags: d,
    },
  }
}

// --- Constructing `P` -------------------------------------------------------

pub fn at_pos(p: P, pos: Int) -> P =
  {
    no_brace: p.no_brace,
    no_pipe: p.no_pipe,
    depth: p.depth,
    gt_split: p.gt_split,
    uses_sets: p.uses_sets,
    pos: pos,
    diags: p.diags,
  }

pub fn with_no_brace(p: P, b: Bool) -> P =
  {
    pos: p.pos,
    no_pipe: p.no_pipe,
    depth: p.depth,
    gt_split: p.gt_split,
    uses_sets: p.uses_sets,
    no_brace: b,
    diags: p.diags,
  }

pub fn with_no_pipe(p: P, b: Bool) -> P =
  {
    pos: p.pos,
    no_brace: p.no_brace,
    depth: p.depth,
    gt_split: p.gt_split,
    uses_sets: p.uses_sets,
    no_pipe: b,
    diags: p.diags,
  }

pub fn with_depth(p: P, d: Int) -> P =
  {
    pos: p.pos,
    no_brace: p.no_brace,
    no_pipe: p.no_pipe,
    gt_split: p.gt_split,
    uses_sets: p.uses_sets,
    depth: d,
    diags: p.diags,
  }

pub fn with_gt_split(p: P, i: Int) -> P =
  {
    pos: p.pos,
    no_brace: p.no_brace,
    no_pipe: p.no_pipe,
    depth: p.depth,
    uses_sets: p.uses_sets,
    gt_split: i,
    diags: p.diags,
  }

pub fn with_sets(p: P) -> P =
  {
    pos: p.pos,
    no_brace: p.no_brace,
    no_pipe: p.no_pipe,
    depth: p.depth,
    gt_split: p.gt_split,
    uses_sets: true,
    diags: p.diags,
  }

pub fn fresh_item(p: P) -> P =
  {
    pos: p.pos,
    no_pipe: p.no_pipe,
    gt_split: p.gt_split,
    uses_sets: p.uses_sets,
    no_brace: false,
    depth: 0,
    diags: p.diags,
  }

pub fn advance_n(c: Ctx, p: P, n: Int) -> P =
  if n <= 0 { p } else { advance_n(c, advance(c, p).p, n - 1) }

// Drops a diagnostic with the same code and primary span as the previous one: one mistake trips several expectations.
pub fn push_diag(p: P, d: PDiag) -> P = {
  let s = primary_span_of(d);
  let dup = match list_at(p.diags, len(p.diags) - 1) {
    Some(l) -> {
      let ls = primary_span_of(l);
      l.code == d.code && ls.start == s.start && ls.end == s.end
    },
    None -> false,
  };
  if dup { p } else {
    {
      pos: p.pos,
      no_brace: p.no_brace,
      no_pipe: p.no_pipe,
      depth: p.depth,
      gt_split: p.gt_split,
      uses_sets: p.uses_sets,
      diags: push(p.diags, d),
    }
  }
}

// Where `?` cannot stand (tests, lambdas): `settle` answers the state either way; `failed` says which arm.
pub fn settle<a>(r: Result<R<a>, P>, d: a) -> R<a> =
  match r { Ok(x) -> x, Err(q) -> { p: q, node: d } }

pub fn failed<a>(r: Result<R<a>, P>) -> Bool = match r { Ok(x) -> false, Err(q) -> true }

// --- Token access -----------------------------------------------------------

fn eof_token() -> lexer::Token = { start: 0, end: 0, tok: lexer::TEof }

// Absolute index, clamped to the buffer (the clamped token is observable), with `expect_gt`'s split applied.
pub fn tok_index(c: Ctx, p: P, i: Int) -> lexer::Token = {
  let j = if i < 0 { 0 } else if i > c.ntok - 1 { c.ntok - 1 } else { i };
  let t = match list_at(c.toks, j) { Some(x) -> x, None -> eof_token() };
  if j == p.gt_split { { start: t.start + 1, end: t.end, tok: lexer::TPunct(b"eq") } } else { t }
}

pub fn tok_at(c: Ctx, p: P, n: Int) -> lexer::Token = tok_index(c, p, p.pos + n)

pub fn kind(c: Ctx, p: P) -> lexer::Tok = tok_at(c, p, 0).tok

pub fn kind_at(c: Ctx, p: P, n: Int) -> lexer::Tok = tok_at(c, p, n).tok

pub fn span_at(c: Ctx, p: P, n: Int) -> Span = {
  let t = tok_at(c, p, n);
  { start: t.start, end: t.end }
}

pub fn cur_span(c: Ctx, p: P) -> Span = span_at(c, p, 0)

pub fn prev_span(c: Ctx, p: P) -> Span = {
  let t = tok_index(c, p, p.pos - 1);
  { start: t.start, end: t.end }
}

pub fn tok_bytes(c: Ctx, t: lexer::Token) -> Bytes = bytes_slice(c.src, t.start, t.end)

// Answers the current span and moves on, except at the last token, where it stays.
pub fn advance(c: Ctx, p: P) -> R<Span> =
  { p: if p.pos + 1 < c.ntok { at_pos(p, p.pos + 1) } else { p }, node: cur_span(c, p) }

pub fn at(c: Ctx, p: P, k: lexer::Tok) -> Bool = kind(c, p) == k

pub fn at_eof(c: Ctx, p: P) -> Bool = kind(c, p) == lexer::TEof

pub fn at_ident_text(c: Ctx, p: P, text: Bytes) -> Bool = kind(c, p) == lexer::TIdent(text)

// Constructor versus binder. ASCII suffices: the lexer refuses a token whose first byte is >= 128.
pub fn starts_upper(name: Bytes) -> Bool =
  bytes_len(name) > 0 && bytes_at(name, 0) >= 65 && bytes_at(name, 0) <= 90

pub fn is_str(c: Ctx, p: P) -> Bool = match kind(c, p) { lexer::TStr(v) -> true, _ -> false }

pub fn bump(c: Ctx, p: P) -> P = advance(c, p).p

pub fn dump_bool(b: Bool) -> Bytes = if b { word(b"true") } else { word(b"false") }

pub fn is_ident(c: Ctx, p: P) -> Bool = match kind(c, p) { lexer::TIdent(n) -> true, _ -> false }

// --- Expecting --------------------------------------------------------------

pub fn eat(c: Ctx, p: P, k: lexer::Tok) -> Ate =
  if at(c, p, k) { { p: advance(c, p).p, ok: true } } else { { p: p, ok: false } }

// How a diagnostic names the token it found.
pub fn describe(t: lexer::Tok) -> Bytes =
  match t {
    lexer::TIdent(n) -> bytes_concat_all([b"identifier `", n, b"`"]),
    lexer::TInt(v) -> bytes_concat_all([b"integer `", num(v), b"`"]),
    lexer::TFixed(ty, v) -> bytes_concat_all([b"`", ty, b"` literal `", num(v), b"`"]),
    lexer::TFloat(txt) -> bytes_concat_all([b"float `", float_display(txt), b"`"]),
    lexer::TDec(m, sc) -> bytes_concat_all([b"decimal `", render_decimal(m, sc), b"`"]),
    lexer::TStr(_) -> b"string literal",
    lexer::TBytes(_) -> b"byte-string literal",
    lexer::TKw(k) -> bytes_concat_all([b"keyword `", k, b"`"]),
    lexer::TEof -> b"end of file",
    lexer::TPunct(name) -> bytes_concat_all([b"`", punct_text(name), b"`"]),
  }

// A table, not an `else if` chain: a long chain overflows the native stack when the emitter compiles itself.
fn punct_text(name: Bytes) -> Bytes = {
  let table = [
    { n: b"lparen", t: b"(" },
    { n: b"rparen", t: b")" },
    { n: b"lbrace", t: b"{" },
    { n: b"rbrace", t: b"}" },
    { n: b"lbracket", t: b"[" },
    { n: b"rbracket", t: b"]" },
    { n: b"comma", t: b"," },
    { n: b"semi", t: b";" },
    { n: b"colon", t: b":" },
    { n: b"coloncolon", t: b"::" },
    { n: b"dot", t: b"." },
    { n: b"dotdot", t: b".." },
    { n: b"underscore", t: b"_" },
    { n: b"arrow", t: b"->" },
    { n: b"eq", t: b"=" },
    { n: b"eqeq", t: b"==" },
    { n: b"bang", t: b"!" },
    { n: b"bangeq", t: b"!=" },
    { n: b"lt", t: b"<" },
    { n: b"le", t: b"<=" },
    { n: b"gt", t: b">" },
    { n: b"ge", t: b">=" },
    { n: b"plus", t: b"+" },
    { n: b"plusplus", t: b"++" },
    { n: b"minus", t: b"-" },
    { n: b"star", t: b"*" },
    { n: b"slash", t: b"/" },
    { n: b"percent", t: b"%" },
    { n: b"amp", t: b"&" },
    { n: b"ampamp", t: b"&&" },
    { n: b"caret", t: b"^" },
    { n: b"pipe", t: b"|" },
    { n: b"pipepipe", t: b"||" },
    { n: b"tilde", t: b"~" },
    { n: b"question", t: b"?" },
  ];
  fold(table, b"", |acc: Bytes, e: { n: Bytes, t: Bytes }| if e.n == name { e.t } else { acc })
}

// The mantissa's digits with the point `scale` places from the end.
pub fn render_decimal(digits: Bytes, scale: Int) -> Bytes =
  if scale == 0 { digits } else {
    let padded = if bytes_len(digits) <= scale {
      bytes_concat(
        bytes_concat_all(map(range(0, scale - bytes_len(digits) + 1), |_i: Int| b"0")),
        digits,
      )
    } else { digits };
    let point = bytes_len(padded) - scale;
    bytes_concat_all([
      bytes_slice(padded, 0, point),
      b".",
      bytes_slice(padded, point, bytes_len(padded)),
    ])
  }

// `f64`'s `Display` over literal text: zeros trimmed, exponent applied; exact up to 17 significant digits.
pub fn float_display(txt: Bytes) -> Bytes = {
  let n = bytes_len(txt);
  let e_at = match bytes_index_of(txt, b"e") { Some(i) -> i, None -> n };
  let mantissa = bytes_slice(txt, 0, e_at);
  let exp = if e_at == n { 0 } else { int_of_signed(bytes_slice(txt, e_at + 1, n)) };
  let dot = match bytes_index_of(mantissa, b".") { Some(i) -> i, None -> bytes_len(mantissa) };
  let whole = bytes_slice(mantissa, 0, dot);
  let frac = if dot == bytes_len(mantissa) { b"" }
  else { bytes_slice(mantissa, dot + 1, bytes_len(mantissa)) };
  let digits = bytes_concat(whole, frac);
  let point = bytes_len(whole) + exp;
  let lead = bytes_scan(digits, 0, b"0", bytes_len(digits));
  let trail = trailing_zeros(digits);
  if lead == bytes_len(digits) { b"0" } else {
    let sig = bytes_slice(digits, lead, bytes_len(digits) - trail);
    let p = point - lead;
    if p <= 0 {
      bytes_concat_all([b"0.", bytes_concat_all(map(range(0, 0 - p), |_i: Int| b"0")), sig])
    } else if p >= bytes_len(sig) {
      bytes_concat(sig, bytes_concat_all(map(range(0, p - bytes_len(sig)), |_i: Int| b"0")))
    } else { bytes_concat_all([bytes_slice(sig, 0, p), b".", bytes_slice(sig, p, bytes_len(sig))]) }
  }
}

fn trailing_zeros(b: Bytes) -> Int =
  fold(range(0, bytes_len(b)), 0, |acc: Int, i: Int|
    if bytes_at(b, bytes_len(b) - 1 - i) == 48 && acc == i { acc + 1 } else { acc })

fn int_of_signed(b: Bytes) -> Int =
  if bytes_len(b) == 0 { 0 }
  else if bytes_at(b, 0) == 45 { 0 - int_of_digits(bytes_slice(b, 1, bytes_len(b))) }
  else if bytes_at(b, 0) == 43 { int_of_digits(bytes_slice(b, 1, bytes_len(b))) }
  else { int_of_digits(b) }

fn int_of_digits(d: Bytes) -> Int =
  fold(range(0, bytes_len(d)), 0, |a: Int, i: Int| a * 10 + (bytes_at(d, i) - 48))

pub fn error_here(c: Ctx, p: P, what: Bytes) -> P =
  push_diag(
    p,
    diag1(
      unexpected(),
      cur_span(c, p),
      bytes_concat_all([b"expected ", what, b", found ", describe(kind(c, p))]),
      bytes_concat(b"expected ", what),
      [],
    ),
  )

pub fn unclosed(c: Ctx, p: P, open: Span, what: Bytes) -> P =
  push_diag(
    p,
    diag2(
      unexpected(),
      cur_span(c, p),
      bytes_concat_all([b"expected ", what, b", found ", describe(kind(c, p))]),
      bytes_concat(b"expected ", what),
      open,
      b"unclosed delimiter opened here",
      [],
    ),
  )

pub fn expect(c: Ctx, p: P, k: lexer::Tok, what: Bytes) -> Result<R<Span>, P> =
  if at(c, p, k) { Ok(advance(c, p)) } else { Err(error_here(c, p, what)) }

pub fn expect_close(c: Ctx, p: P, k: lexer::Tok, open: Span, what: Bytes) -> Result<R<Span>, P> =
  if at(c, p, k) { Ok(advance(c, p)) } else { Err(unclosed(c, p, open, what)) }

pub fn expect_ident(c: Ctx, p: P, what: Bytes) -> Result<R<Ident>, P> =
  match kind(c, p) {
    lexer::TIdent(n) -> {
      let a = advance(c, p);
      Ok({ p: a.p, node: { name: n, span: a.node } })
    },
    _ -> Err(error_here(c, p, what)),
  }

// A keyword may name a field; `keyword` flags it for the punned forms that also bind a variable.
pub fn expect_field_name(
  c: Ctx,
  p: P,
  what: Bytes,
) -> Result<R<{ name: Ident, keyword: Bool }>, P> =
  match kind(c, p) {
    lexer::TIdent(n) -> {
      let a = advance(c, p);
      Ok({ p: a.p, node: { name: { name: n, span: a.node }, keyword: false } })
    },
    lexer::TKw(k) -> {
      let a = advance(c, p);
      Ok({ p: a.p, node: { name: { name: k, span: a.node }, keyword: true } })
    },
    _ -> Err(error_here(c, p, what)),
  }

pub fn keyword_pun_refusal(p: P, name: Ident) -> P =
  push_diag(
    p,
    diag1(
      unexpected(),
      name.span,
      bytes_concat_all([
        b"`",
        name.name,
        b"` names a field here, and a bare field also names a variable",
      ]),
      b"a keyword cannot name a variable",
      [
        bytes_concat_all([
          b"write `",
          name.name,
          b": ",
          name.name,
          b"_` with a name of your own on the right",
        ]),
      ],
    ),
  )

// On `>=`, answers the `>` and leaves `pos`, with `gt_split` turning the rest into `=`.
pub fn expect_gt(c: Ctx, p: P, what: Bytes) -> Result<R<Span>, P> =
  if at(c, p, t_gt()) { Ok(advance(c, p)) } else if at(c, p, t_ge()) {
    let s = cur_span(c, p);
    Ok({ p: with_gt_split(p, p.pos), node: { start: s.start, end: s.start + 1 } })
  } else { Err(error_here(c, p, what)) }

// --- Depth ------------------------------------------------------------------

pub fn max_depth() -> Int = 128

pub fn deeper(c: Ctx, p: P) -> Result<P, P> = {
  let q = with_depth(p, p.depth + 1);
  if q.depth <= max_depth() { Ok(q) } else {
    Err(
      push_diag(
        q,
        diag1(
          unexpected(),
          cur_span(c, q),
          b"input is nested too deeply to parse",
          bytes_concat_all([b"more than ", num(max_depth()), b" levels of nesting"]),
          [b"split this into smaller definitions"],
        ),
      ),
    )
  }
}

pub fn shallower(p: P) -> P = with_depth(p, p.depth - 1)

// --- The shared sequence driver ---------------------------------------------

pub fn comma_list<a>(
  c: Ctx,
  p: P,
  close: lexer::Tok,
  item: (Ctx, P) -> Result<R<a>, P>,
) -> Result<R<List<a>>, P> =
  iterate({ p: p, out: [] }, c.ntok - p.pos + 1, |s: Acc<a>|
    if at(c, s.p, close) || at_eof(c, s.p) { Stop(Ok({ p: s.p, node: s.out })) } else {
      match item(c, s.p) {
        Err(q) -> Stop(Err(q)),
        Ok(r) -> {
          let e = eat(c, r.p, t_comma());
          if e.ok { Continue({ p: e.p, out: push(s.out, r.node) }) }
          else { Stop(Ok({ p: e.p, node: push(s.out, r.node) })) }
        },
      }
    })

// --- Qualified names --------------------------------------------------------

pub fn qname(c: Ctx, p: P, what: Bytes) -> Result<R<QName>, P> = {
  let { p, node: first } = expect_ident(c, p, what)?;
  let cc = eat(c, p, t_coloncolon());
  if !cc.ok { Ok({ p: cc.p, node: bare(first) }) } else {
    let { p, node: second } = expect_ident(c, cc.p, b"a name after `::`")?;
    if at(c, p, t_coloncolon()) {
      Err(
        push_diag(
          p,
          diag1(
            unexpected(),
            cur_span(c, p),
            b"a qualified name has at most one `::`",
            b"unexpected `::`",
            [
              b"a module binder is a single name: `import store.orders` binds `orders`, so write `orders::place`",
            ],
          ),
        ),
      )
    } else { Ok({ p: p, node: qualified(first, second) }) }
  }
}

// --- The token vocabulary ---------------------------------------------------

pub fn t_lparen() -> lexer::Tok = lexer::TPunct(b"lparen")
pub fn t_rparen() -> lexer::Tok = lexer::TPunct(b"rparen")
pub fn t_lbrace() -> lexer::Tok = lexer::TPunct(b"lbrace")
pub fn t_rbrace() -> lexer::Tok = lexer::TPunct(b"rbrace")
pub fn t_lbracket() -> lexer::Tok = lexer::TPunct(b"lbracket")
pub fn t_rbracket() -> lexer::Tok = lexer::TPunct(b"rbracket")
pub fn t_comma() -> lexer::Tok = lexer::TPunct(b"comma")
pub fn t_semi() -> lexer::Tok = lexer::TPunct(b"semi")
pub fn t_colon() -> lexer::Tok = lexer::TPunct(b"colon")
pub fn t_coloncolon() -> lexer::Tok = lexer::TPunct(b"coloncolon")
