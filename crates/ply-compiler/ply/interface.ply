// A compiled package: offset-preserving stubs (function bodies empty blocks, tests and laws blank)
// with the rows and fixed nodes a load trusts in place of the bodies.

import std.bin
import std.hash (blake3)
import std.list (at, concat, take)
import resolve (Source, ParsedModule)
import diagnostics (parse_all)
import pkg (PackageSources)
import hash (Contract, Fixed, closure_of, fixed_nodes, fixed_bin, public_contracts)
import front (Analysis, AnalysisOutcome, Analysed, Refused, Interfaces, no_interfaces,
              contracted_rows_of, KnownDefRow, EmitterRoot, KeyRow, analyse, analyse_with, dump_of,
              known_def_row_bin, Cut, cut_bin, cuts_of, body_cuts_of, Dump, ModuleRow, Rows,
              checked_staged, no_rows, rows_of, staged_pulling_std_with, embed_slot)

import infer (DefInfo)
import rewrite (has_tagged)
import types (Scheme, canonical_scheme)
import embed (EmbedAt, EmbedRead, EmbedReader, EmbedFile)

// A module another one's analysis read, with the key it had then.
pub type Reached = { name: Bytes, key: Bytes }

// `key` is what the stub stands for (`module_key`); `reaches` is every module it imports, directly
// or not, so the stub stands wherever each of them still has its key, in whatever package.
pub type CompiledModule = {
  name: Bytes,
  stub: Bytes,
  key: Bytes,
  reaches: List<Reached>,
  cuts: List<Cut>,
}

// A module as a package is cut from it: its source and, for a dependency's, its package's manifest,
// which decides what its imports name.
pub type Original = { name: Bytes, src: Bytes, manifest: Option<Bytes> }

pub type CompiledPackage = {
  modules: List<CompiledModule>,
  defs: List<KnownDefRow>,
  fixed: List<Fixed>,
}

derive bin for Reached

derive bin for CompiledModule

derive bin for CompiledPackage

// A package's interface as a registry serves it beside a version's archive: the semantics it was
// cut under, the archive it was cut from, and the package. A registry reads the frame whatever
// semantics wrote the payload.
pub type Envelope = { semantics: Bytes, archive: Bytes, payload: Bytes }

derive bin for Envelope

fn envelope_magic() -> Bytes = b"PLYIFC01"

pub fn enveloped(envelope: Envelope) -> Bytes / {abort.raise} =
  bytes_concat(envelope_magic(), bin::encode(envelope, envelope_bin()))

pub fn envelope_of(b: Bytes) -> Option<Envelope> / {abort.raise} =
  if !bytes_starts_with(b, envelope_magic()) { None } else {
    match bin::decode(bytes_slice(b, bytes_len(envelope_magic()), bytes_len(b)), envelope_bin()) {
      Ok(e) -> Some(e),
      Err(_) -> None,
    }
  }

// --- Stubs ------------------------------------------------------------------

// `n` spaces, by doubling, so a long body costs a few concatenations.
fn spaces(n: Int) -> Bytes =
  if n <= 0 { b"" } else {
    let half = spaces(n / 2);
    let twice = bytes_concat(half, half);
    if n % 2 == 1 { bytes_concat(twice, b" ") } else { twice }
  }

// `text` with every byte but a newline turned to a space: the same lines, the same offsets.
fn blank(text: Bytes) -> Bytes / {abort.raise} = {
  let segs = bytes_split(text, b"\n");
  bytes_concat_all(
    fold(range(0, len(segs)), [], |parts: List<Bytes>, i: Int|
      if i == 0 { push(parts, spaces(bytes_len(at(segs, 0)))) }
      else { push(push(parts, b"\n"), spaces(bytes_len(at(segs, i)))) }),
  )
}

fn cut(src: Bytes, c: Cut) -> List<Bytes> / {abort.raise} =
  if c.braced { [b"{", blank(bytes_slice(src, c.start + 1, c.end - 1)), b"}"] }
  else { [blank(bytes_slice(src, c.start, c.end))] }

pub fn stub_module(src: Bytes, parsed: ParsedModule) -> Bytes / {abort.raise} =
  stubbed(src, cuts_of(parsed))

// `src` with each cut blanked, at the offsets it had: what a module's published cuts make of it.
pub fn stubbed(src: Bytes, cuts: List<Cut>) -> Bytes / {abort.raise} = {
  let walked = fold(cuts, { at: 0, parts: [] }, |acc: { at: Int, parts: List<Bytes> }, c: Cut|
    if c.start < acc.at { acc } else {
      { at: c.end, parts: concat(push(acc.parts, bytes_slice(src, acc.at, c.start)), cut(src, c)) }
    });
  bytes_concat_all(push(walked.parts, bytes_slice(src, walked.at, bytes_len(src))))
}

// --- Compiling ----------------------------------------------------------------

// The module a qualified name belongs to: its name without the final segment.
pub fn module_of(name: Bytes) -> Bytes / {abort.raise} = {
  let i = last_dot(name, bytes_len(name));
  if i < 0 { b"" } else { bytes_slice(name, 0, i) }
}

fn last_dot(s: Bytes, i: Int) -> Int / {abort.raise} =
  if i <= 0 { 0 - 1 } else if bytes_at(s, i - 1) == 46 { i - 1 } else { last_dot(s, i - 1) }

pub fn module_key(original: Original) -> Bytes =
  blake3(
    bytes_concat_all([
      b"ply.interface.module.1\0",
      match original.manifest { None -> b"-", Some(m) -> bytes_concat(b"+", blake3(m)) },
      b"\0",
      original.src,
    ]),
  )

// Every module `from` imports, directly or not, ascending.
fn reach(imports: List<List<Int>>, from: Int) -> List<Int> / {abort.raise} = {
  let seen = iterate(
    { seen: map_new(), stack: at(imports, from) },
    len(imports) * len(imports) + 1,
    |s: { seen: Map<Int, Bool>, stack: List<Int> }|
      match s.stack {
        [] -> Stop(s.seen),
        [i, ..rest] -> if map_contains(s.seen, i) || i == from {
          Continue({ seen: s.seen, stack: rest })
        } else {
          Continue({ seen: map_insert(s.seen, i, true), stack: concat(at(imports, i), rest) })
        },
      },
  );
  filter(range(0, len(imports)), |i: Int| map_contains(seen, i))
}

fn embed_named(name: Bytes) -> Option<{ module: Bytes, key: Bytes }> / {abort.raise} =
  match bytes_index_of_from(name, b"\0", 0) {
    None -> None,
    Some(i) ->
      Some({ module: bytes_slice(name, 0, i), key: bytes_slice(name, i + 1, bytes_len(name)) }),
  }

pub fn sized(b: Bytes) -> Bytes =
  bytes_concat_all([bytes_of_string(int_to_string(bytes_len(b))), b":", b])

pub fn read_key(read: EmbedRead) -> Bytes =
  blake3(
    bytes_concat_all(match read {
      Err(why) -> [b"ply.interface.embed.1\0!", why],
      Ok(files) ->
        fold(files, [b"ply.interface.embed.1\0="], |acc: List<Bytes>, f: EmbedFile|
          push(push(acc, sized(f.name)), sized(f.bytes))),
    }),
  )

fn embeds_reached(embeds: List<EmbedAt>) -> Map<Bytes, List<Reached>> =
  fold(embeds, map_new(), |acc: Map<Bytes, List<Reached>>, e: EmbedAt|
    map_insert(
      acc,
      e.module,
      push(match map_get(acc, e.module) { Some(rs) -> rs, None -> [] }, {
        name: embed_slot(e.module, e.key),
        key: read_key(e.read),
      }),
    ))

// Every module `from` imports, directly or not, each under `keyed`'s key for it, then every embed
// of those and of `from` itself.
fn reached_from(
  analysis: Analysis,
  keyed: (Bytes) -> Bytes,
  embedded: Map<Bytes, List<Reached>>,
  from: Int,
) -> List<Reached> / {abort.raise} = {
  let modules = reach(analysis.r.imports, from);
  fold(
    concat([from], modules),
    map(modules, |j: Int|
      { name: at(analysis.mods, j).name, key: keyed(at(analysis.mods, j).name) }),
    |acc: List<Reached>, j: Int|
      match map_get(embedded, at(analysis.mods, j).name) {
        Some(rs) -> concat(acc, rs),
        None -> acc,
      },
  )
}

// `keys` with what each embed a module of `modules` reaches reads now, under the name it is
// reached by.
pub fn with_embeds(
  keys: Map<Bytes, Bytes>,
  modules: List<CompiledModule>,
  read: EmbedReader,
) -> Map<Bytes, Bytes> / {abort.raise} =
  fold(modules, keys, |acc: Map<Bytes, Bytes>, m: CompiledModule|
    fold(m.reaches, acc, |a: Map<Bytes, Bytes>, r: Reached|
      if map_contains(a, r.name) { a } else {
        match embed_named(r.name) {
          None -> a,
          Some(e) -> map_insert(a, r.name, read_key(read(e.module, e.key))),
        }
      }))

// A module `analysis` read through `through` keeps that package's stub and edges, its body here a blank;
// one `analysis` never reached is carried over whole, since what a package fixes of a module is its own.
pub fn compile_package(
  sources: List<Original>,
  analysis: Analysis,
  modules: List<Bytes>,
  through: List<CompiledPackage> = [],
) -> CompiledPackage / {abort.raise} = {
  let members = fold(modules, map_new(), |acc: Map<Bytes, Bool>, m: Bytes|
    map_insert(acc, m, true));
  let mine = |name: Bytes| map_contains(members, module_of(name));
  let read = fold(
    through,
    map_new(),
    |acc: Map<Bytes, CompiledModule>, package: CompiledPackage|
      fold(package.modules, acc, |a: Map<Bytes, CompiledModule>, m: CompiledModule|
        map_insert(a, m.name, m)),
  );
  let originals = fold(sources, map_new(), |acc: Map<Bytes, Original>, o: Original|
    map_insert(acc, o.name, o));
  let index = fold(range(0, len(analysis.mods)), map_new(), |acc: Map<Bytes, Int>, i: Int|
    map_insert(acc, at(analysis.mods, i).name, i));
  let embedded = embeds_reached(analysis.embeds);
  let reached = |i: Int|
    reached_from(
      analysis,
      |name: Bytes| match map_get(originals, name) { Some(o) -> module_key(o), None -> b"" },
      embedded,
      i,
    );
  let implemented = fold(
    analysis.hashes.defs,
    map_new(),
    |acc: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }| map_insert(acc, x.name, x.hash),
  );
  let cut: CompiledPackage = {
    modules: map(modules, |name: Bytes|
      match map_get(read, name) {
        Some(m) -> m,
        None -> match ((map_get(originals, name), map_get(index, name))) {
          (Some(o), Some(i)) -> {
            let cuts = cuts_of(at(analysis.mods, i));
            {
              name: name,
              stub: stubbed(o.src, cuts),
              key: module_key(o),
              reaches: reached(i),
              cuts: cuts,
            }
          },
          _ -> panic("a module the package cuts is in the analysis, with its source in hand"),
        },
      }),
    // A later load reads these modules fixed, where a row is matched under the definition's hash.
    defs: map(
      filter(contracted_rows_of(analysis), |row: KnownDefRow| mine(row.name)),
      |row: KnownDefRow|
        match map_get(implemented, row.name) { Some(h) -> { ..row, hash: h }, None -> row },
    ),
    fixed: fixed_nodes(
      analysis.index,
      analysis.hashes,
      members,
      fold(through, [], |acc: List<Fixed>, package: CompiledPackage| concat(acc, package.fixed)),
    ),
  };
  fold(
    through,
    { covered: members, package: cut },
    |acc: { covered: Map<Bytes, Bool>, package: CompiledPackage }, package: CompiledPackage| {
      let more = filter(package.modules, |m: CompiledModule| !map_contains(acc.covered, m.name));
      let named = fold(more, map_new(), |s: Map<Bytes, Bool>, m: CompiledModule|
        map_insert(s, m.name, true));
      let theirs = |name: Bytes| map_contains(named, module_of(name));
      {
        covered: fold(more, acc.covered, |s: Map<Bytes, Bool>, m: CompiledModule|
          map_insert(s, m.name, true)),
        package: {
          modules: concat(acc.package.modules, more),
          defs: concat(acc.package.defs, filter(package.defs, |row: KnownDefRow| theirs(row.name))),
          fixed: concat(
            acc.package.fixed,
            filter(package.fixed, |fixed: Fixed| theirs(fixed.name)),
          ),
        },
      }
    },
  ).package
}

// What a build keeps of every module of the program it built, so its next build reads a module
// whose text did not move, and that reaches none whose did, as its stub: where each is cut, what
// its hashing fixed, and the check key each definition's row was filed under. A stub's text is its
// source cut again, a row is the build's own and a body is read by nothing a build makes, so none
// of the three is kept.
pub type KeptModules = {
  modules: List<CompiledModule>,
  fixed: List<Fixed>,
  checks: List<{ name: Bytes, hash: Bytes }>,
}

derive bin for KeptModules

// `own`, where it is given, keeps the root package's modules alone, each cut at its bodies with
// its tests and laws left standing: what a load that answers for its own tests reads back.
pub fn kept_modules(
  sources: List<Original>,
  analysis: Analysis,
  through: List<CompiledPackage> = [],
  own: Bool = false,
) -> KeptModules / {abort.raise} = {
  let names = map(analysis.mods, |m: ParsedModule| m.name);
  // A tagged literal is checked off its module's bodies, so a module that writes one keeps them.
  let kept = |i: Int|
    !own
      || (list_at(analysis.module_packages, i) == Some(0)
      && !has_tagged(at(analysis.mods, i).module));
  let members = fold(range(0, len(names)), map_new(), |acc: Map<Bytes, Bool>, i: Int|
    if kept(i) { map_insert(acc, at(names, i), true) } else { acc });
  let read = fold(
    through,
    map_new(),
    |acc: Map<Bytes, CompiledModule>, package: CompiledPackage|
      fold(package.modules, acc, |a: Map<Bytes, CompiledModule>, m: CompiledModule|
        map_insert(a, m.name, m)),
  );
  let originals = fold(sources, map_new(), |acc: Map<Bytes, Original>, o: Original|
    map_insert(acc, o.name, o));
  let keyed = |name: Bytes|
    match map_get(originals, name) { Some(o) -> module_key(o), None -> b"" };
  let embedded = embeds_reached(analysis.embeds);
  {
    modules: map(filter(range(0, len(names)), kept), |i: Int| {
      let name = at(names, i);
      match map_get(read, name) {
        Some(m) -> { ..m, stub: b"" },
        None ->
          {
            name: name,
            stub: b"",
            key: keyed(name),
            reaches: reached_from(analysis, keyed, embedded, i),
            cuts: match map_get(analysis.stub_cuts, name) {
              Some(cuts) -> cuts,
              None -> if own { body_cuts_of(at(analysis.mods, i)) }
              else { cuts_of(at(analysis.mods, i)) },
            },
          },
      }
    }),
    fixed: map(
      fixed_nodes(
        analysis.index,
        analysis.hashes,
        members,
        fold(through, [], |acc: List<Fixed>, package: CompiledPackage| concat(acc, package.fixed)),
      ),
      |fixed: Fixed| { ..fixed, body: b"" },
    ),
    checks: if !own { analysis.checked.checks } else {
      filter(analysis.checked.checks, |c: { name: Bytes, hash: Bytes }|
        map_contains(members, module_of(c.name)))
    },
  }
}

// What a build kept, as the load after it reads the modules that still stand: each one's stub cut
// from its source again, and of `rows` each fixed definition's under the hash it was fixed with,
// which is how a load takes a row with a stub. `rows` are whatever the last build to write them
// kept, which another checkout may have: a row is this module's where it was filed under the key
// kept here, and a module one of whose definitions has no such row is read from its source. `read`
// is what a module embeds, as it reads now.
pub fn standing_modules(
  kept: KeptModules,
  sources: List<Original>,
  rows: List<KnownDefRow>,
  read: EmbedReader,
) -> List<CompiledPackage> / {abort.raise} = {
  let originals = fold(sources, map_new(), |acc: Map<Bytes, Original>, o: Original|
    map_insert(acc, o.name, o));
  let valid = valid_part(
    { modules: kept.modules, defs: [], fixed: kept.fixed },
    with_embeds(
      map_fold(originals, map_new(), |acc: Map<Bytes, Bytes>, name: Bytes, o: Original|
        map_insert(acc, name, module_key(o))),
      kept.modules,
      read,
    ),
  );
  let checks = fold(
    kept.checks,
    map_new(),
    |acc: Map<Bytes, Bytes>, c: { name: Bytes, hash: Bytes }| map_insert(acc, c.name, c.hash),
  );
  let filed = fold(rows, map_new(), |acc: Map<Bytes, KnownDefRow>, row: KnownDefRow|
    if map_get(checks, row.name) == Some(row.hash) { map_insert(acc, row.name, row) } else { acc });
  let rowless = fold(valid.fixed, map_new(), |acc: Map<Bytes, Bool>, fixed: Fixed|
    if fixed.decl || map_contains(filed, fixed.name) { acc }
    else { map_insert(acc, module_of(fixed.name), true) });
  let here = |name: Bytes| !map_contains(rowless, name);
  let modules = filter(valid.modules, |m: CompiledModule| here(m.name));
  if len(modules) == 0 { [] } else {
    let fixed = filter(valid.fixed, |f: Fixed| here(module_of(f.name)));
    [
      {
        modules: map(modules, |m: CompiledModule|
          match map_get(originals, m.name) {
            Some(o) -> { ..m, stub: stubbed(o.src, m.cuts) },
            None -> m,
          }),
        defs: fold(fixed, [], |acc: List<KnownDefRow>, f: Fixed|
          match map_get(filed, f.name) {
            Some(row) -> if f.decl { acc } else { push(acc, { ..row, hash: f.hash }) },
            None -> acc,
          }),
        fixed: fixed,
      },
    ]
  }
}

// --- Loading ----------------------------------------------------------------

// The part of `package` that still stands, given each module's current key and what each embed
// reads now (`with_embeds`): a module whose key moved, or that reaches a module or an embed whose
// key moved, is read from its source again.
pub fn valid_part(
  package: CompiledPackage,
  keys: Map<Bytes, Bytes>,
) -> CompiledPackage / {abort.raise} = {
  let stands = |name: Bytes, key: Bytes| map_get(keys, name) == Some(key);
  let standing = fold(
    package.modules,
    map_new(),
    |acc: Map<Bytes, Bool>, compiled: CompiledModule|
      if stands(compiled.name, compiled.key)
          && fold(compiled.reaches, true, |all: Bool, r: Reached| all && stands(r.name, r.key)) {
        map_insert(acc, compiled.name, true)
      } else { acc },
  );
  let here = |name: Bytes| map_contains(standing, module_of(name));
  {
    modules: filter(package.modules, |compiled: CompiledModule|
      map_contains(standing, compiled.name)),
    defs: filter(package.defs, |r: KnownDefRow| here(r.name)),
    fixed: filter(package.fixed, |fixed: Fixed| here(fixed.name)),
  }
}

pub fn merged_interfaces(packages: List<CompiledPackage>) -> Interfaces =
  fold(packages, no_interfaces(), |acc: Interfaces, package: CompiledPackage|
    {
      stubs: concat(
        acc.stubs,
        map(package.modules, |compiled: CompiledModule|
          { name: compiled.name, src: compiled.stub }),
      ),
      cuts: concat(
        acc.cuts,
        map(package.modules, |compiled: CompiledModule|
          { name: compiled.name, cuts: compiled.cuts }),
      ),
      defs: concat(acc.defs, package.defs),
      fixed: concat(acc.fixed, package.fixed),
    })

// Each package's modules resolve among the roots, as bare imports do.
fn analyse_with_interfaces(
  root: List<Source>,
  packages: List<CompiledPackage>,
) -> AnalysisOutcome / {abort.raise} = {
  let ifaces = merged_interfaces(packages);
  analyse_with(
    parse_all(concat(root, ifaces.stubs)),
    [],
    [],
    { root: b"", manifest: None, supplied: [] },
    ifaces,
  )
}

// --- Tests ------------------------------------------------------------------

fn original(source: Source) -> Original = { name: source.name, src: source.src, manifest: None }

fn whole_of(analysis: AnalysisOutcome) -> Analysis / {abort.raise} =
  match analysis { Analysed(w) -> w, Refused(ds) -> panic("analysis refused") }

fn named_set(xs: List<{ name: Bytes, hash: Bytes }>) -> Map<Bytes, Bool> =
  fold(xs, map_new(), |acc: Map<Bytes, Bool>, x: { name: Bytes, hash: Bytes }|
    map_insert(acc, x.name, true))

fn depends() -> Source =
  {
    name: b"base",
    src: b"pub effect log { write emit(Bytes) -> Unit }\npub effect chan { write put[r](Int) -> Unit }\npub type Pair = { a: Int, b: Int }\nderive eq for Pair\nfn helper(x: Int) -> Int = x * 2\npub fn one() -> Int = 1\npub fn two(x: Int) -> Int requires x >= 0 ensures result > x = helper(x) + one()\npub fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\npub fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\npub fn mk(x: Int) -> Pair {\n  { a: x, b: two(x) }\n}\npub fn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\npub fn twice<|e>(f: () -> Unit / e) -> Unit / e = { f(); f() }\npub fn send<[l]>(x: Int) -> Unit / { chan.write[l] } = chan.put[l](x)\ntest \"two adds\" { assert_eq(two(1), 3) }\nlaw \"doubling\" forall (x: Int) { helper(x) == x + x }\n",
  }

fn dependent() -> Source =
  {
    name: b"app",
    src: b"import base (one, two, Pair, mk, even, say, twice, log)\npub fn four() -> Int = two(two(one()))\npub fn pair() -> Pair = mk(four())\npub fn parity() -> Bool = even(4)\nfn hi() -> Unit / { log.write } = say(b\"hi\")\npub fn shout() -> Unit / { log.write } = twice(hi)\ntest \"four\" { assert_eq(four(), 7) }\n",
  }

test "a module read through its package is cut as its source was, its test and law included" {
  let full = whole_of(analyse(parse_all([dependent(), depends()])));
  let package = compile_package([original(depends())], full, [b"base"]);
  let via = whole_of(analyse_with_interfaces([dependent()], [package]));
  let base_cuts = |d: Dump|
    fold(d.modules, [], |acc: List<Cut>, m: ModuleRow|
      if m.name == b"base" { m.cuts } else { acc });
  let source = base_cuts(dump_of(Analysed(full)));
  assert(fold(source, false, |unbraced: Bool, c: Cut| unbraced || !c.braced));
  assert_eq(base_cuts(dump_of(Analysed(via))), source)
}

test "a stub keeps every offset and line of its source" {
  let base = depends();
  let m = at(parse_all([base]), 0).module;
  let stub = stub_module(base.src, m);
  assert_eq(bytes_len(stub), bytes_len(base.src));
  assert_eq(len(bytes_split(stub, b"\n")), len(bytes_split(base.src, b"\n")));
  // Declarations, signatures and the label-generic body stay; other bodies, the row-generic one
  // among them, the test and the law go.
  assert(
    bytes_index_of(stub, b"pub fn two(x: Int) -> Int requires x >= 0 ensures result > x = {")
      != None,
  );
  assert(bytes_index_of(stub, b"pub fn mk(x: Int) -> Pair {\n") != None);
  assert(bytes_index_of(stub, b"{ a: x") == None);
  assert(bytes_index_of(stub, b"= { f(); f() }") == None);
  assert(bytes_index_of(stub, b"= chan.put[l](x)") != None);
  assert(bytes_index_of(stub, b"derive eq for Pair") != None);
  assert(bytes_index_of(stub, b"helper(x) + one()") == None);
  assert(bytes_index_of(stub, b"test") == None);
  assert(bytes_index_of(stub, b"law") == None)
}

// Every definition's scheme as the checker published it, its variables numbered as its text names them.
fn schemes(analysis: Analysis) -> List<{ name: Bytes, scheme: Scheme }> / {abort.raise} =
  map(analysis.checked.defs, |def_info: DefInfo|
    { name: def_info.name, scheme: canonical_scheme(def_info.scheme) })

test "a dependency reached through its interface answers what its source does" {
  let base = depends();
  let app = dependent();
  let full = whole_of(analyse(parse_all([app, base])));
  let iface = compile_package([original(base)], full, [b"base"]);
  let via = whole_of(analyse_with_interfaces([app], [iface]));
  // Every definition, root or dependency, is checked to the same row, spans included.
  let fd = dump_of(Analysed(full));
  let vd = dump_of(Analysed(via));
  assert_eq(vd.defs, fd.defs);
  assert_eq(schemes(via), schemes(full));
  assert_eq(vd.types, fd.types);
  assert_eq(vd.effects, fd.effects);
  assert_eq(vd.ctors, fd.ctors);
  // Hashing answers the same hashes, forms and bodies, and references and closures for every node.
  assert_eq(via.hashes.defs, full.hashes.defs);
  assert_eq(via.hashes.decls, full.hashes.decls);
  assert_eq(via.hashes.own, full.hashes.own);
  assert_eq(via.hashes.specs, full.hashes.specs);
  assert_eq(via.hashes.spec_texts, full.hashes.spec_texts);
  assert_eq(via.hashes.bodies, full.hashes.bodies);
  let nodes = fold(
    full.hashes.decls,
    named_set(full.hashes.defs),
    |acc: Map<Bytes, Bool>, x: { name: Bytes, hash: Bytes }| map_insert(acc, x.name, true),
  );
  let noded = |xs: List<{ name: Bytes, names: List<Bytes> }>|
    filter(xs, |x: { name: Bytes, names: List<Bytes> }| map_contains(nodes, x.name));
  assert_eq(noded(via.hashes.deps), noded(full.hashes.deps));
  assert_eq(
    map(map_keys(nodes), |n: Bytes| closure_of(via.hashes, [n])),
    map(map_keys(nodes), |n: Bytes| closure_of(full.hashes, [n])),
  );
  // What the emitter reads of every definition is the same.
  assert_eq(
    filter(vd.emitter_roots, |root: EmitterRoot| map_contains(nodes, root.root)),
    filter(fd.emitter_roots, |root: EmitterRoot| map_contains(nodes, root.root)),
  );
  assert_eq(
    filter(vd.keys, |k: KeyRow| map_contains(nodes, k.root)),
    filter(fd.keys, |k: KeyRow| map_contains(nodes, k.root)),
  );
  // The root's test hashes the same; the dependency's does not travel.
  assert_eq(len(via.hashes.tests), 1);
  assert_eq(via.hashes.tests, take(full.hashes.tests, 1));
  // Nothing is reported unused, though the dependency's private helper is reached only from blanks.
  assert_eq(len(full.warnings), 0);
  assert_eq(len(via.warnings), 0);
  // A stub's module is claimed by its specs: its body is a blank.
  assert_eq(via.stubs, [b"base"])
}

test "a compiled package round-trips through its binary encoding" {
  let base = depends();
  let full = whole_of(analyse(parse_all([base])));
  let iface = compile_package([original(base)], full, [b"base"]);
  match bin::decode(bin::encode(iface, compiled_package_bin()), compiled_package_bin()) {
    Ok(back) -> assert_eq(back, iface),
    Err(e) -> panic("a compiled package did not decode"),
  }
}

test "a package re-cut from an analysis that read it through itself is the same package" {
  let base = depends();
  let app = dependent();
  let full = whole_of(analyse(parse_all([app, base])));
  let iface = compile_package([original(base)], full, [b"base"]);
  let via = whole_of(analyse_with_interfaces([app], [iface]));
  assert_eq(compile_package([original(base)], via, [b"base"], [iface]), iface)
}

fn of_module(package: CompiledPackage, m: Bytes) -> CompiledPackage / {abort.raise} = {
  let here = |name: Bytes| module_of(name) == m;
  {
    modules: filter(package.modules, |compiled: CompiledModule| compiled.name == m),
    defs: filter(package.defs, |row: KnownDefRow| here(row.name)),
    fixed: filter(package.fixed, |fixed: Fixed| here(fixed.name)),
  }
}

test "a package cut from an analysis that reached less keeps the rest of the one it read" {
  let base = depends();
  let extra: Source = { name: b"extra", src: b"pub fn three() -> Int = 3\n" };
  let app: Source = {
    name: b"app",
    src: b"import base (one)\nimport extra (three)\npub fn four() -> Int = one() + three()\n",
  };
  let full = whole_of(analyse(parse_all([app, base, extra])));
  let iface = compile_package([original(base), original(extra)], full, [b"base", b"extra"]);
  let part: Source = {
    name: b"app",
    src: b"import extra (three)\npub fn six() -> Int = three() * 2\n",
  };
  let partial = whole_of(analyse(parse_all([part, extra])));
  let recut = compile_package([original(base), original(extra)], partial, [b"extra"], [iface]);
  assert_eq(len(recut.modules), 2);
  assert_eq(of_module(recut, b"base"), of_module(iface, b"base"));
  assert_eq(of_module(recut, b"extra"), of_module(iface, b"extra"))
}

fn manifest_of(name: String, deps: String) -> Bytes =
  bytes_of_string(
    "import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"" ++ name
      ++ "\", version: {major: 0, minor: 1, patch: 0}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: ["
      ++ deps
      ++ "], entry: None}",
  )

// `app` over the package `base` at `../base`, whose one module is `lib`.
fn over_base(lib: Bytes) -> PackageSources =
  {
    root: b"/x/app",
    manifest: Some(
      manifest_of(
        "app",
        "{name: \"base\", prefix: None, min: {major: 0, minor: 1, patch: 0}, source: Path(\"../base\")}",
      ),
    ),
    supplied: [
      {
        root: b"/x/base",
        manifest: Some(manifest_of("base", "")),
        modules: [{ name: b"lib", src: lib }],
      },
    ],
  }

test "a dependency package's module read through its stub answers what its source does" {
  let app: Source = {
    name: b"app",
    src: bytes_concat(
      b"import base.lib (one, two, Pair, mk, even, say, twice, log)\n",
      bytes_slice(
        dependent().src,
        bytes_len(b"import base (one, two, Pair, mk, even, say, twice, log)\n"),
        bytes_len(dependent().src),
      ),
    ),
  };
  let pkgs = over_base(depends().src);
  let full = whole_of(analyse_with(parse_all([app]), [], [], pkgs));
  let lib: Original = {
    name: b"base.lib",
    src: depends().src,
    manifest: match list_at(pkgs.supplied, 0) { Some(s) -> s.manifest, None -> None },
  };
  let iface = compile_package([lib], full, [b"base.lib"]);
  let via = whole_of(analyse_with(parse_all([app]), [], [], pkgs, merged_interfaces([iface])));
  let fd = dump_of(Analysed(full));
  let vd = dump_of(Analysed(via));
  assert_eq(vd.defs, fd.defs);
  assert_eq(schemes(via), schemes(full));
  assert_eq(vd.types, fd.types);
  assert_eq(vd.effects, fd.effects);
  assert_eq(vd.pins, fd.pins);
  assert_eq(via.hashes.defs, full.hashes.defs);
  assert_eq(via.hashes.decls, full.hashes.decls);
  assert_eq(via.hashes.bodies, full.hashes.bodies);
  assert_eq(via.stubs, [b"base.lib"]);
  // The dependency's private helper is its own package's to report, read either way.
  assert_eq(len(full.warnings), 0);
  assert_eq(len(via.warnings), 0)
}

test "a stub stands while its source, its package's manifest and what it imports stand" {
  let a: Source = { name: b"a", src: b"pub fn one() -> Int = 1\n" };
  let b: Source = { name: b"b", src: b"import a (one)\npub fn two() -> Int = one() + one()\n" };
  let c: Source = { name: b"c", src: b"pub fn three() -> Int = 3\n" };
  let app: Source = {
    name: b"app",
    src: b"import b (two)\nimport c (three)\npub fn five() -> Int = two() + three()\n",
  };
  let full = whole_of(analyse(parse_all([app, a, b, c])));
  let p = compile_package([original(a), original(b), original(c)], full, [b"a", b"b", b"c"]);
  let keyed = |xs: List<Original>|
    fold(xs, map_new(), |acc: Map<Bytes, Bytes>, o: Original|
      map_insert(acc, o.name, module_key(o)));
  let names = |package: CompiledPackage| map(package.modules, |m: CompiledModule| m.name);
  assert_eq(valid_part(p, keyed([original(a), original(b), original(c)])), p);
  // An edit to `a` takes `b`, which imports it, down with it; `c` stands.
  let edited: Original = { name: b"a", src: b"pub fn one() -> Int = 2\n", manifest: None };
  let left = valid_part(p, keyed([edited, original(b), original(c)]));
  assert_eq(names(left), [b"c"]);
  assert_eq(of_module(left, b"a").fixed, []);
  assert_eq(of_module(left, b"c"), of_module(p, b"c"));
  // An edit to `b` takes `b` alone.
  let b2: Original = { name: b"b", src: bytes_concat(b.src, b"\n"), manifest: None };
  assert_eq(names(valid_part(p, keyed([original(a), b2, original(c)]))), [b"a", b"c"]);
  // The same source under another manifest is another module.
  let under = |m: Bytes| module_key({ name: b"a", src: a.src, manifest: Some(m) });
  assert(under(b"one") != under(b"two"));
  assert(under(b"one") != module_key(original(a)))
}

fn reading(bytes: Bytes) -> EmbedReader =
  |module: Bytes, key: Bytes|
    if module == b"a" && key == b"file:x.txt" { Ok([{ name: b"", bytes: bytes }]) }
    else { Err(b"nothing is embedded") }

test "a stub stands while what its module, and each module it reaches, embeds reads the same" {
  let a: Source = { name: b"a", src: b"pub fn text() -> Bytes = embed(\"x.txt\")\n" };
  let b: Source = {
    name: b"b",
    src: b"import a (text)\npub fn size() -> Int = bytes_len(text())\n",
  };
  let c: Source = { name: b"c", src: b"pub fn three() -> Int = 3\n" };
  let originals = [original(a), original(b), original(c)];
  let full = whole_of(
    checked_staged(
      staged_pulling_std_with(
        [a, b, c],
        [],
        { root: b"", manifest: None, supplied: [] },
        no_interfaces(),
        [
          {
            root: b"",
            module: b"a",
            want: { path: b"x.txt", dir: false },
            read: Ok([{ name: b"", bytes: b"one" }]),
          },
        ],
      ),
      [],
      [],
    ).out,
  );
  let p = compile_package(originals, full, [b"a", b"b", b"c"]);
  let keys = fold(originals, map_new(), |acc: Map<Bytes, Bytes>, o: Original|
    map_insert(acc, o.name, module_key(o)));
  let standing = |read: EmbedReader|
    map(valid_part(p, with_embeds(keys, p.modules, read)).modules, |m: CompiledModule| m.name);
  assert_eq(standing(reading(b"one")), [b"a", b"b", b"c"]);
  // The file moved and no module's text did: `a`, which embeds it, and `b`, which reaches `a`.
  assert_eq(standing(reading(b"two")), [b"c"]);
  let kept = kept_modules(originals, full);
  let rows = rows_of(full).defs;
  assert_eq(standing_names(standing_modules(kept, originals, rows, reading(b"one"))), [
    b"a",
    b"b",
    b"c",
  ]);
  assert_eq(standing_names(standing_modules(kept, originals, rows, reading(b"two"))), [b"c"])
}

// A program to ship, loaded as a builder loads it: with no test or law, through `through`, seeded
// with `rows`.
fn shipping(
  sources: List<Source>,
  through: List<CompiledPackage>,
  rows: Rows,
) -> Analysis / {abort.raise} =
  whole_of(
    checked_staged(
      staged_pulling_std_with(
        sources,
        [],
        { root: b"", manifest: None, supplied: [] },
        merged_interfaces(through),
        [],
        [],
        false,
      ),
      rows.defs,
      rows.tests,
    ).out,
  )

// The answer less what no build reads back: a stub's fixed nodes hold no body.
fn shipped_answer(analysis: Analysis) -> Dump / {abort.raise} =
  { ..dump_of(Analysed(analysis)), bodies: [], walked: b"" }

// What a program that embeds nothing is asked to read.
pub fn unread(module: Bytes, key: Bytes) -> EmbedRead / {abort.raise} = Err(b"nothing is embedded")

fn standing_names(through: List<CompiledPackage>) -> List<Bytes> =
  fold(through, [], |acc: List<Bytes>, p: CompiledPackage|
    concat(acc, map(p.modules, |m: CompiledModule| m.name)))

test "a program read through what its last load kept answers what its source does" {
  let sources = [dependent(), depends()];
  let first = shipping(sources, [], no_rows());
  assert_eq(len(first.checked.tests), 0);
  let kept = kept_modules(map(sources, original), first);
  assert_eq(map(kept.modules, |m: CompiledModule| m.stub), [b"", b""]);
  let rows = rows_of(first);
  // Nothing moved: both modules are read as stubs, their rows taken whole.
  let unmoved = standing_modules(kept, map(sources, original), rows.defs, unread);
  assert_eq(standing_names(unmoved), [b"app", b"base"]);
  let again = shipping(sources, unmoved, rows);
  assert_eq(again.stubs, [b"app", b"base"]);
  let r1 = at(rows_of(again).defs, 12);
  let r0 = at(rows.defs, 12);
  assert_eq(shipped_answer(again), shipped_answer(first));
  assert_eq(rows_of(again), rows);
  // A body of `app` moved: `base`, which reaches nothing that moved, is still read as its stub.
  let edited = [
    {
      name: b"app",
      src: b"import base (one, two, Pair, mk, even, say, twice, log)\npub fn four() -> Int = two(one()) + 2\npub fn pair() -> Pair = mk(four())\npub fn parity() -> Bool = even(4)\nfn hi() -> Unit / { log.write } = say(b\"hi\")\npub fn shout() -> Unit / { log.write } = twice(hi)\ntest \"four\" { assert_eq(four(), 5) }\n",
    },
    depends(),
  ];
  let through = standing_modules(kept, map(edited, original), rows.defs, unread);
  assert_eq(standing_names(through), [b"base"]);
  let via = shipping(edited, through, rows);
  let fresh = shipping(edited, [], no_rows());
  assert_eq(shipped_answer(via), shipped_answer(fresh));
  assert_eq(rows_of(via), rows_of(fresh));
  // What the next load keeps is what a load from source would have kept.
  assert_eq(
    kept_modules(map(edited, original), via, through),
    kept_modules(map(edited, original), fresh),
  );
  // `base` moved: `app`, which reaches it, is read from its source with it.
  let below = [dependent(), { name: b"base", src: bytes_concat(depends().src, b"\n") }];
  assert_eq(standing_names(standing_modules(kept, map(below, original), rows.defs, unread)), []);
  // A module a definition of which has no row, or a row filed under another key, is read from its
  // source.
  let rowless = filter(rows.defs, |row: KnownDefRow| row.name != b"base.one");
  assert_eq(standing_names(standing_modules(kept, map(sources, original), rowless, unread)), [
    b"app",
  ]);
  let another = map(rows.defs, |row: KnownDefRow|
    if row.name == b"app.four" { { ..row, hash: b"another build's" } } else { row });
  assert_eq(standing_names(standing_modules(kept, map(sources, original), another, unread)), [
    b"base",
  ])
}

fn keyed_by(xs: List<{ name: Bytes, hash: Bytes }>, name: Bytes) -> Bytes =
  fold(xs, b"", |acc: Bytes, x: { name: Bytes, hash: Bytes }|
    if x.name == name { x.hash } else { acc })

fn spec_keys(xs: List<{ name: Bytes, hashes: List<Bytes> }>, name: Bytes) -> List<Bytes> =
  fold(xs, [], |acc: List<Bytes>, x: { name: Bytes, hashes: List<Bytes> }|
    if x.name == name { x.hashes } else { acc })

test "a dependency's body edit moves no check key of the package that reads it, and its contract does" {
  let app: Source = {
    name: b"app",
    src: b"import base.lib (one, two)\npub fn three() -> Int = two(one()) + 1\npub fn four(x: Int) -> Int requires x >= 0 ensures result > x = two(x)\n",
  };
  let lib = |two_body: Bytes, two_ensures: Bytes|
    bytes_concat_all([
      b"pub fn one() -> Int = 1\npub fn two(x: Int) -> Int requires x >= 0 ensures ",
      two_ensures,
      b" = ",
      two_body,
      b"\n",
    ]);
  let read = |src: Bytes| whole_of(analyse_with(parse_all([app]), [], [], over_base(src)));
  let before = read(lib(b"x + one()", b"result > x"));
  let edited = read(lib(b"x + one() + 0", b"result > x"));
  let promised = read(lib(b"x + one()", b"result >= x"));
  let checks = |w: Analysis, name: Bytes| keyed_by(w.checked.checks, name);
  let proofs = |w: Analysis| spec_keys(w.hashes.spec_checks, b"app.four");
  // The body moved: every hash that reaches it, and not one key the dependent checks or proves under.
  assert(keyed_by(edited.hashes.defs, b"app.three") != keyed_by(before.hashes.defs, b"app.three"));
  assert_eq(checks(edited, b"app.three"), checks(before, b"app.three"));
  assert(
    spec_keys(edited.hashes.specs, b"app.four") != spec_keys(before.hashes.specs, b"app.four"),
  );
  assert_eq(proofs(edited), proofs(before));
  // The edited definition is checked again, and what references it in its own package is not.
  assert(checks(edited, b"base.lib.two") != checks(before, b"base.lib.two"));
  // The contract moved: the dependent is checked and proved again.
  assert(checks(promised, b"app.three") != checks(before, b"app.three"));
  assert(proofs(promised) != proofs(before))
}

test "a stub cut alone stands on the keys of the modules it reaches, wherever they are read from" {
  let a: Source = { name: b"a", src: b"pub fn one() -> Int = 1\n" };
  let b: Source = { name: b"b", src: b"import a (one)\npub fn two() -> Int = one() + one()\n" };
  let c: Source = { name: b"c", src: b"import b (two)\npub fn four() -> Int = two() + two()\n" };
  let full = whole_of(analyse(parse_all([a, b, c])));
  let p = compile_package([original(a), original(b), original(c)], full, [b"c"]);
  let keyed = |xs: List<Original>|
    fold(xs, map_new(), |acc: Map<Bytes, Bytes>, o: Original|
      map_insert(acc, o.name, module_key(o)));
  assert_eq(map(of_module(p, b"c").modules, |compiled: CompiledModule| compiled.reaches), [
    [{ name: b"a", key: module_key(original(a)) }, { name: b"b", key: module_key(original(b)) }],
  ]);
  assert_eq(valid_part(p, keyed([original(a), original(b), original(c)])), p);
  // `c` imports `b` alone, and `b`'s analysis read `a`.
  let edited: Original = { name: b"a", src: b"pub fn one() -> Int = 2\n", manifest: None };
  assert_eq(valid_part(p, keyed([edited, original(b), original(c)])).modules, [])
}

test "an envelope carries its frame and payload whole, and nothing else reads as one" {
  let e: Envelope = { semantics: b"s1", archive: b"b3:ab", payload: b"\x00\x01payload" };
  assert_eq(envelope_of(enveloped(e)), Some(e));
  assert_eq(envelope_of(b"PLYIFC01"), None);
  assert_eq(envelope_of(bytes_slice(enveloped(e), 1, bytes_len(enveloped(e)))), None)
}

test "a `transparent` definition's body is part of its contract, and its stub keeps it" {
  let app: Source = {
    name: b"app",
    src: b"import base.lib (one, two)\npub fn three() -> Int = two(one()) + 1\n",
  };
  let lib = |two_body: Bytes|
    bytes_concat_all([
      b"pub fn one() -> Int = 0 + 1\npub transparent fn two(x: Int) -> Int = ",
      two_body,
      b"\n",
    ]);
  let checks = |src: Bytes|
    whole_of(analyse_with(parse_all([app]), [], [], over_base(src))).checked.checks;
  let before = checks(lib(b"x + one()"));
  let edited = checks(lib(b"x + one() + 0"));
  assert(
    keyed_by(edited, b"app.three") != keyed_by(before, b"app.three"),
    Some("the body is read"),
  );
  let source = lib(b"x + one()");
  let stub = stub_module(source, at(parse_all([{ name: b"base.lib", src: source }]), 0).module);
  assert(bytes_index_of(stub, b"= x + one()") != None, Some(string_of_bytes(stub)));
  assert(bytes_index_of(stub, b"0 + 1") == None, Some(string_of_bytes(stub)))
}

test "a `returns` clause is part of a definition's contract" {
  let app: Source = {
    name: b"app",
    src: b"import base.lib (made)\npub fn three() -> List<Int> = made(3)\n",
  };
  let lib = |clause: Bytes|
    bytes_concat_all([b"pub fn made(n: Int) -> List<Int>", clause, b" = range(0, n)\n"]);
  let checks = |src: Bytes|
    whole_of(analyse_with(parse_all([app]), [], [], over_base(src))).checked.checks;
  assert(
    keyed_by(checks(lib(b" returns fresh")), b"app.three")
      != keyed_by(checks(lib(b"")), b"app.three"),
  )
}

fn contracts_of(src: Bytes) -> List<Contract> / {abort.raise} = {
  let w = whole_of(analyse(parse_all([{ name: b"lib", src: src }])));
  public_contracts(w.index, w.hashes, |m: Bytes| m == b"lib")
}

fn contract_named(cs: List<Contract>, name: Bytes) -> Bytes / {abort.raise} =
  match filter(cs, |contract: Contract| contract.name == name) {
    [contract] -> contract.hash,
    _ -> panic("one contract of the name"),
  }

test "a public definition's contract moves with its signature and specification, never its body" {
  let lib = |body: Bytes, spec: Bytes, variants: Bytes|
    bytes_concat_all([
      b"pub type T = ",
      variants,
      b"\npub fn f(x: Int) -> Int",
      spec,
      b" = ",
      body,
      b"\nfn hidden() -> Int = 1\n",
    ]);
  let base = contracts_of(lib(b"x + 1", b"", b"| A | B"));
  assert_eq(map(base, |contract: Contract| contract.name), [b"lib.T", b"lib.f"]);
  assert_eq(contracts_of(lib(b"x + 2", b"", b"| A | B")), base);
  let specified = contracts_of(lib(b"x + 1", b" ensures result > x", b"| A | B"));
  assert(contract_named(specified, b"lib.f") != contract_named(base, b"lib.f"));
  assert_eq(contract_named(specified, b"lib.T"), contract_named(base, b"lib.T"));
  let widened = contracts_of(lib(b"x + 1", b"", b"| A | B | C"));
  assert(contract_named(widened, b"lib.T") != contract_named(base, b"lib.T"))
}
