//! A package as another package reads it: what each of its modules shows the modules that import
//! it, and the text helpers that blank what a reader of a module does not read.

import std.bin
import std.hash (blake3)
import std.list (at, concat, contains, take)
import resolve (Source, ParsedModule, Diag)
import diagnostics (parse_all)
import pkg (PackageSources)
import hash (Contract, public_contracts)
import front (Analysis, AnalysisOutcome, Analysed, Refused, analyse, analyse_with, Cut, cuts_of)
import exports (Exports, Hashes, exports_of, hashes_of, exports_bin, hashes_bin)
import embed (EmbedRead, EmbedFile)
import items (unimported)
import parsing (Span)

/// One module of a package as a module importing it checks and hashes against it.
pub type ModuleInterface = { exports: Exports, hashes: Hashes }

/// Each module of a package, in the package's order.
pub type Interface = { modules: List<ModuleInterface> }

derive bin for ModuleInterface

derive bin for Interface

/// A package's interface as a registry serves it beside a version's archive: the semantics it was
/// cut under, the archive it was cut from, and the package. A registry reads the frame whatever
/// semantics wrote the payload.
pub type Envelope = { semantics: Bytes, archive: Bytes, payload: Bytes }

derive bin for Envelope

fn envelope_magic() -> Bytes = b"PLYIFC01"

pub fn enveloped(envelope: Envelope) -> Bytes / {abort.raise} =
  bytes_concat(envelope_magic(), bin::encode(envelope, envelope_bin()))

pub fn envelope_of(b: Bytes) -> Option<Envelope> / {abort.raise} =
  if !bytes_starts_with(b, envelope_magic()) { None } else {
    match bin::decode(bytes_slice(b, bytes_len(envelope_magic()), bytes_len(b)), envelope_bin()) {
      Ok(e) -> Some(e),
      Err(_) -> None,
    }
  }

// --- Stubs ------------------------------------------------------------------

/// `n` spaces, by doubling, so a long body costs a few concatenations.
fn spaces(n: Int) -> Bytes =
  if n <= 0 { b"" } else {
    let half = spaces(n / 2);
    let twice = bytes_concat(half, half);
    if n % 2 == 1 { bytes_concat(twice, b" ") } else { twice }
  }

/// `text` with every byte but a newline turned to a space: the same lines, the same offsets.
fn blank(text: Bytes) -> Bytes / {abort.raise} = {
  let segs = bytes_split(text, b"\n");
  bytes_concat_all(
    fold(range(0, len(segs)), [], |parts: List<Bytes>, i: Int|
      if i == 0 { push(parts, spaces(bytes_len(at(segs, 0)))) }
      else { push(push(parts, b"\n"), spaces(bytes_len(at(segs, i)))) }),
  )
}

fn cut(src: Bytes, c: Cut) -> List<Bytes> / {abort.raise} =
  if c.braced { [b"{", blank(bytes_slice(src, c.start + 1, c.end - 1)), b"}"] }
  else { [blank(bytes_slice(src, c.start, c.end))] }

pub fn stub_module(src: Bytes, parsed: ParsedModule) -> Bytes / {abort.raise} =
  stubbed(src, cuts_of(parsed))

/// A shipped module as a module that imports it reads it: what `items.unimported` finds of it
/// blanked, at the offsets it had. Its tests and laws stay for a run over the shipped modules
/// themselves.
pub fn imported(src: Bytes) -> Bytes / {abort.raise} = blanked(src, unimported(src))

/// `src` with each of `spans`, in order and apart, blanked at the offsets it had.
pub fn blanked(src: Bytes, spans: List<Span>) -> Bytes / {abort.raise} =
  stubbed(
    src,
    map(spans, |s: Span| { start: s.start, end: s.end, braced: false, name: b"", test: false }),
  )

/// `src` with each cut blanked, at the offsets it had: what a module's published cuts make of it.
pub fn stubbed(src: Bytes, cuts: List<Cut>) -> Bytes / {abort.raise} = {
  let walked = fold(cuts, { at: 0, parts: [] }, |acc: { at: Int, parts: List<Bytes> }, c: Cut|
    if c.start < acc.at { acc } else {
      { at: c.end, parts: concat(push(acc.parts, bytes_slice(src, acc.at, c.start)), cut(src, c)) }
    });
  bytes_concat_all(push(walked.parts, bytes_slice(src, walked.at, bytes_len(src))))
}

/// The module a qualified name belongs to: its name without the final segment.
pub fn module_of(name: Bytes) -> Bytes / {abort.raise} = {
  let i = last_dot(name, bytes_len(name));
  if i < 0 { b"" } else { bytes_slice(name, 0, i) }
}

fn last_dot(s: Bytes, i: Int) -> Int / {abort.raise} =
  if i <= 0 { 0 - 1 } else if bytes_at(s, i - 1) == 46 { i - 1 } else { last_dot(s, i - 1) }

pub fn sized(b: Bytes) -> Bytes =
  bytes_concat_all([bytes_of_string(int_to_string(bytes_len(b))), b":", b])

pub fn read_key(read: EmbedRead) -> Bytes =
  blake3(
    bytes_concat_all(match read {
      Err(why) -> [b"ply.interface.embed.1\0!", why],
      Ok(files) ->
        fold(files, [b"ply.interface.embed.1\0="], |acc: List<Bytes>, f: EmbedFile|
          push(push(acc, sized(f.name)), sized(f.bytes))),
    }),
  )

/// What `analysis` shows of each of `modules`, each read from its text among `sources`.
pub fn interface_of(
  analysis: Analysis,
  sources: List<Source>,
  modules: List<Bytes>,
) -> Interface / {abort.raise} = {
  let texts = fold(sources, map_new(), |acc: Map<Bytes, Bytes>, s: Source|
    map_insert(acc, s.name, s.src));
  let index = fold(range(0, len(analysis.mods)), map_new(), |acc: Map<Bytes, Int>, i: Int|
    map_insert(acc, at(analysis.mods, i).name, i));
  {
    modules: map(modules, |name: Bytes|
      match ((map_get(texts, name), map_get(index, name))) {
        (Some(text), Some(i)) ->
          {
            exports: exports_of(analysis, i, text),
            hashes: hashes_of(analysis.index, analysis.hashes, i, text),
          },
        _ -> panic("a module the interface shows is in the analysis, with its source in hand"),
      }),
  }
}

// --- Tests ------------------------------------------------------------------

fn whole_of(analysis: AnalysisOutcome) -> Analysis / {abort.raise} =
  match analysis { Analysed(w) -> w, Refused(ds) -> panic("analysis refused") }

fn depends() -> Source =
  {
    name: b"base",
    src: b"pub effect log { write emit(Bytes) -> Unit }\npub effect chan { write put[r](Int) -> Unit }\npub type Pair = { a: Int, b: Int }\nderive eq for Pair\nfn helper(x: Int) -> Int = x * 2\npub fn one() -> Int = 1\npub fn two(x: Int) -> Int requires x >= 0 ensures result > x = helper(x) + one()\npub fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\npub fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\npub fn mk(x: Int) -> Pair {\n  { a: x, b: two(x) }\n}\npub fn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\npub fn twice<|e>(f: () -> Unit / e) -> Unit / e = { f(); f() }\npub fn send<[l]>(x: Int) -> Unit / { chan.write[l] } = chan.put[l](x)\ntest \"two adds\" { assert_eq(two(1), 3) }\nlaw \"doubling\" forall (x: Int) { helper(x) == x + x }\n",
  }

test "a stub keeps every offset and line of its source" {
  let base = depends();
  let m = at(parse_all([base]), 0).module;
  let stub = stub_module(base.src, m);
  assert_eq(bytes_len(stub), bytes_len(base.src));
  assert_eq(len(bytes_split(stub, b"\n")), len(bytes_split(base.src, b"\n")));
  // Declarations, signatures and the label-generic body stay; other bodies, the row-generic one
  // among them, the test and the law go.
  assert(
    bytes_index_of(stub, b"pub fn two(x: Int) -> Int requires x >= 0 ensures result > x = {")
      != None,
  );
  assert(bytes_index_of(stub, b"pub fn mk(x: Int) -> Pair {\n") != None);
  assert(bytes_index_of(stub, b"{ a: x") == None);
  assert(bytes_index_of(stub, b"= { f(); f() }") == None);
  assert(bytes_index_of(stub, b"= chan.put[l](x)") != None);
  assert(bytes_index_of(stub, b"derive eq for Pair") != None);
  assert(bytes_index_of(stub, b"helper(x) + one()") == None);
  assert(bytes_index_of(stub, b"test") == None);
  assert(bytes_index_of(stub, b"law") == None)
}

test "an interface round-trips through its binary encoding" {
  let base = depends();
  let iface = interface_of(whole_of(analyse(parse_all([base]))), [base], [b"base"]);
  assert_eq(len(iface.modules), 1);
  match bin::decode(bin::encode(iface, interface_bin()), interface_bin()) {
    Ok(back) -> assert_eq(back, iface),
    Err(e) -> panic("an interface did not decode"),
  }
}

/// What a program that embeds nothing is asked to read.
pub fn unread(module: Bytes, key: Bytes) -> EmbedRead = Err(b"nothing is embedded")

test "an envelope carries its frame and payload whole, and nothing else reads as one" {
  let e: Envelope = { semantics: b"s1", archive: b"b3:ab", payload: b"\x00\x01payload" };
  assert_eq(envelope_of(enveloped(e)), Some(e));
  assert_eq(envelope_of(b"PLYIFC01"), None);
  assert_eq(envelope_of(bytes_slice(enveloped(e), 1, bytes_len(enveloped(e)))), None)
}

test "a `transparent` definition's body is part of its contract, and its stub keeps it" {
  let lib = |two_body: Bytes|
    bytes_concat_all([
      b"pub fn one() -> Int = 0 + 1\npub transparent fn two(x: Int) -> Int = ",
      two_body,
      b"\n",
    ]);
  let before = contracts_of(lib(b"x + one()"));
  assert(
    contract_named(contracts_of(lib(b"x + one() + 0")), b"lib.two")
      != contract_named(before, b"lib.two"),
    Some("the body is read"),
  );
  assert_eq(
    contract_named(
      contracts_of(bytes_concat(lib(b"x + one()"), b"fn aside() -> Int = 2\n")),
      b"lib.two",
    ),
    contract_named(before, b"lib.two"),
  );
  let source = lib(b"x + one()");
  let stub = stub_module(source, at(parse_all([{ name: b"base.lib", src: source }]), 0).module);
  assert(bytes_index_of(stub, b"= x + one()") != None, Some(string_of_bytes(stub)));
  assert(bytes_index_of(stub, b"0 + 1") == None, Some(string_of_bytes(stub)))
}

test "a `returns` clause is part of a definition's contract" {
  let lib = |clause: Bytes|
    bytes_concat_all([b"pub fn made(n: Int) -> List<Int>", clause, b" = range(0, n)\n"]);
  assert(
    contract_named(contracts_of(lib(b" returns fresh")), b"lib.made")
      != contract_named(contracts_of(lib(b"")), b"lib.made"),
  )
}

fn contracts_of(src: Bytes) -> List<Contract> / {abort.raise} = {
  let w = whole_of(analyse(parse_all([{ name: b"lib", src: src }])));
  public_contracts(w.index, w.hashes, |m: Bytes| m == b"lib")
}

fn contract_named(cs: List<Contract>, name: Bytes) -> Bytes / {abort.raise} =
  match filter(cs, |contract: Contract| contract.name == name) {
    [contract] -> contract.hash,
    _ -> panic("one contract of the name"),
  }

test "a public definition's contract moves with its signature and specification, never its body" {
  let lib = |body: Bytes, spec: Bytes, variants: Bytes|
    bytes_concat_all([
      b"pub type T = ",
      variants,
      b"\npub fn f(x: Int) -> Int",
      spec,
      b" = ",
      body,
      b"\nfn hidden() -> Int = 1\n",
    ]);
  let base = contracts_of(lib(b"x + 1", b"", b"| A | B"));
  assert_eq(map(base, |contract: Contract| contract.name), [b"lib.T", b"lib.f"]);
  assert_eq(contracts_of(lib(b"x + 2", b"", b"| A | B")), base);
  let specified = contracts_of(lib(b"x + 1", b" ensures result > x", b"| A | B"));
  assert(contract_named(specified, b"lib.f") != contract_named(base, b"lib.f"));
  assert_eq(contract_named(specified, b"lib.T"), contract_named(base, b"lib.T"));
  let widened = contracts_of(lib(b"x + 1", b"", b"| A | B | C"));
  assert(contract_named(widened, b"lib.T") != contract_named(base, b"lib.T"))
}
