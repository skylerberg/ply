              fresh_row_var, fresh_row, subst_new, mark_rigid_ty, mark_rigid_row, is_rigid_ty,
              is_rigid_row, shallow, resolve_ty, resolved_tail, resolve_row, occurs_ty,
              solve_continuation_row, free_vars, unify, unify_row, covariant_con, env_new, env_push,
              env_pop, env_bind, env_bind_global, env_remove_global, env_lookup, env_depth_of,
              env_locals, instantiate_with, instantiate, rename_scheme, generalize, region_prefix,
              region_of, label_type, label_of, resolve_atom, atom_text, atoms_text, resource_text,
              scheme_text, type_text, row_text, Printer, printer_new, printer_naming, print_ty,
              print_row, applied_args, at_arguments, over_arg)
