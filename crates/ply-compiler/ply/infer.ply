// The type checker: schemes, footprints and constraints for every definition, test, law, effect and constructor.

import spine (Span, Ident, QName, span_to, dummy_span, num, span_key, push_front)
import types (TypeExpr, TVar, TCon, TFn, TRecord, TUnit, TBad, RowExpr, AtomExpr, Mode, MRead, MWrite, MBad, ty_span)
import items (Module, Item, IFn, IType, IEffect, ITest, ILaw, IDerive, IEffectSet, FnDef, TypeDef,
              TypeDefBody, TDAlias, TDSum, VariantDef, EffectDef, OpDef, TestDef, LawDef, Binder,
              Constraint, Deriver, DJson, DEq, DOrd, SpecKind, SRequires, SEnsures, SpecClause, Derived, DeriveDef, parse)
import exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock, ERecord,
              ERecordUpdate, ETry, EField, EList, EPerform, EHandle, EWithCell, EWithRegion,
              ESimulate, EBad, Stmt, SLet, SExpr, Param, NamedArg, MatchArm, HandleClause,
              ReturnClause, RecField, expr_span)
import patterns (Pattern, PWild, PVar, PLit, PCtor, PRecord, PList, PBad, Lit, LInt, LFixed, LBool, LStr,
                 LBytes, LFloat, LDec, LUnit, pat_span)
import tycore (Resource, RNamed, RSingleton, RVar, Atom, Row, Type, TyVar, TyCon, TyFn, TyRecord, Field,
               Scheme, Fresh, Subst, TypeEnv, Free, UnifyError, Mismatch, Arity, OccursTy, OccursRow,
               RowMismatch, Unified, atom_lt, atoms_covered, atoms_insert, atoms_union, atoms_contains,
               atoms_difference, row_empty, row_open, row_closed, row_singleton, row_is_pure,
               row_union, row_without, row_without_covered, con, con1, t_int, t_bool, t_string, t_bytes, t_float,
               t_decimal, t_unit, t_list, t_option, t_map, t_iter, t_secret, t_fn, mono,
               fields_sorted, field_get, mentions_secret, at, set_at, take, drop, append,
               contains_int, contains_bytes, ints_insert, ints_union, ints_difference, fresh_new,
               fresh_ty_var, fresh_ty, fresh_row_var, fresh_row, subst_new, mark_rigid_ty,
               mark_rigid_row, is_rigid_ty, is_rigid_row, shallow, resolve_ty, resolved_tail,
               resolve_row, occurs_ty, solve_continuation_row, free_vars, unify, unify_row,
               env_new, env_push, env_pop, env_bind, env_bind_global, env_remove_global,
               env_lookup, env_depth_of, env_locals, instantiate_with, instantiate, rename_scheme,
               generalize, region_prefix, region_of, label_type, label_of, resolve_atom,
               atom_text, atoms_text, resource_text, scheme_text, type_text, row_text,
               printer_new, print_ty, print_row)
import resolve (Mod, Source, Resolved, Scope, Binding, ModBind, Declared, Entry, Diag, Label, Edit, Fix, with_fix, insertion, Ns, NValue, NType, NEffect,
                resolve_modules, Resolved_, Failed, Expanded, find, lookup, dlookup, space,
                qualify, default_binder, dump_diags, diag, diag1, diag2, lab, is_bare,
                is_ctor_name, backticked, ns_describe, private_name)
import rewrite (expand, expand_record_updates)
import derive (Why, WFunction, WHandle, WFloatIsNotOrdered, WUnconstrained, WNullInsideOption, WSecret,
               ConShape, Leaf, Structural, Refused, Nominal, con_shape, null_encoded_name, Expansion, expand_derives,
               refusal_note, secret_reason, null_in_option_note)

// --- What the checker keeps ----------------------------------------------------------

// A prelude item's `at` is `{ module: 0, span: dummy_span() }`.
pub type Loc = { module: Int, span: Span }
type TypeDecl = { params: List<Bytes>, alias: Option<TypeExpr>, owner: Int, span: Span }
pub type OpInfo = { name: Bytes, mode: Mode, resource_param: Bool, params: List<Type>, ret: Type,
                    at: Loc, scheme: Option<Scheme> }
pub type EffectInfo = { name: Bytes, module: Bytes, simple_name: Bytes, nondet: Bool, ops: List<OpInfo>, at: Loc }
pub type CtorInfo = { name: Bytes, module: Bytes, simple_name: Bytes, type_name: Bytes, index: Int,
                      arity: Int, fields: List<Type>, scheme: Scheme, at: Loc }
pub type DefConstraint = { deriver: Deriver, param: Int }
pub type SpecInfo = { kind: SpecKind, index: Int, footprint: List<Atom>, span: Span }
pub type DefInfo = { name: Bytes, module: Bytes, simple_name: Bytes, scheme: Scheme, footprint: List<Atom>,
                     performed: List<Atom>, row_aliases: List<Bytes>, constraints: List<DefConstraint>, spec: List<SpecInfo>,
                     internally_effectful: Bool, at: Loc }
pub type TestInfo = { name: Bytes, module: Bytes, key: Bytes, index: Int, nondet: Bool, footprint: List<Atom>, at: Loc }
pub type LawBinder = { name: Bytes, ty: Type, span: Span }
pub type LawInfo = { name: Bytes, module: Bytes, key: Bytes, index: Int, binders: List<LawBinder>, has_guard: Bool, host: Bool,
                     footprint: List<Atom>, at: Loc }
// Where an atom entered a body's row: an operation performed here, a named definition's row,
// arguments alone (a builtin or constructor), or a function value.
type Src = | SDirect | SVia(Bytes) | SArgs | SOpaque
type PerformSite = { atom: Atom, module: Int, span: Span, source: Src }
type OpKey = { effect: Bytes, op: Bytes, res: Resource }
type Numeric = { span: Span, op: Bytes, ty: Type }
// A bit operator's or integer builtin's operand, kept until its type is known. `what` names the site in a diagnostic.
type BitOp = { span: Span, what: Bytes, ty: Type }
// The one type both sides of a `++` share, kept until the substitution has it: `String` and `Bytes` both join.
type ConcatSite = { module: Int, span: Span, ty: Type }
// A written field of `{..b, f: e}` with the type its value inferred to.
type UpdField = { name: Bytes, span: Span, ty: Type }
// An update whose base was still a variable where it was written; `result` is what the site answered.
type UpdateSite = { module: Int, span: Span, base_span: Span, base: Type, written: List<UpdField>, result: Type }
// What the lowering needs: the field list of the record an update copies, in the record's own order.
pub type UpdateShape = { module: Int, span: Span, names: List<Bytes> }
type Sig = { ty_params: Map<Bytes, Type>, row_params: Map<Bytes, Int>, label_params: Map<Bytes, Int>,
             fn_ty: Type, params: List<Type>,
             ret: Type, declared: Option<Row>, published_row: Row, scope: Int }
// One use of a label-generic definition: `vars` are the variables its label parameters became,
// `called` is false while it is still only a value, and `written` records `f[conn](..)`.
type LabelApp = { module: Int, span: Span, callee: Bytes, vars: List<Int>, params: Map<Bytes, Int>,
                  called: Bool }
// What the emitter needs: the labels a call fills, in declaration order.
pub type LabelSite = { module: Int, span: Span, labels: List<Bytes> }
type Assumed = { deriver: Deriver, vars: List<Int> }
type SpawnSite = { span: Span, ty: Type }
type HandoffSite = { span: Span, ty: Type, op: Bytes }
type OpenRegion = { name: Bytes, with_cell: Bool, span: Span, simulate_depth: Int, spawns: List<SpawnSite>, handoffs: List<HandoffSite> }
type OuterBinding = { name: Bytes, ty: Type, site: Span }
type RegionSite = { module: Int, name: Bytes, with_cell: Bool, span: Span, body_span: Span, body_ty: Type, exits: List<Span>,
                    outer: List<OuterBinding>, spawns: List<SpawnSite>, handoffs: List<HandoffSite> }
type Simulation = { module: Int, span: Span, body_span: Span, body_ty: Type, body_row: Row }
// `params` names the signature's rigid type parameters, so a refusal can say which to constrain.
type RigidParam = { name: Bytes, v: Int }
type MapKeySite = { module: Int, span: Span, scope: Int, key: Type, assumed: List<Int>, params: List<RigidParam> }
type ConstraintSite = { module: Int, span: Span, deriver: Deriver, ty: Type, callee: Bytes, callee_at: Loc, assumed: List<Int>, params: List<RigidParam> }
type SpecEnv = { name: Bytes, ty_params: Map<Bytes, Type>, row_params: Map<Bytes, Int>, params: List<Type>, ret: Type }

// The interfaces the driver hands in for definitions it need not re-walk, and test footprints, one slot per `test`.
pub type KnownDef = { name: Bytes, scheme: Scheme, footprint: List<Atom>, performed: List<Atom> }
pub type KnownTests = { module: Bytes, slots: List<Option<List<Atom>>> }
pub type Known = { defs: List<KnownDef>, tests: List<KnownTests> }

pub fn no_known() -> Known = { defs: [], tests: [] }

type Cx = {
  r: Resolved,
  mods: List<Mod>,
  module: Int,
  subst: Subst,
  fresh: Fresh,
  env: TypeEnv,
  diags: List<Diag>,
  types: Map<Bytes, TypeDecl>,
  effects: List<EffectInfo>,
  effect_index: Map<Bytes, Int>,
  ctors: List<CtorInfo>,
  ctor_index: Map<Bytes, Int>,
  defs: List<DefInfo>,
  def_index: Map<Bytes, Int>,
  tests: List<TestInfo>,
  laws: List<LawInfo>,
  ty_params: Map<Bytes, Type>,
  row_params: Map<Bytes, Int>,
  label_params: Map<Bytes, Int>,
  label_apps: List<LabelApp>,
  label_sites: List<LabelSite>,
  // The label parameters of the group being walked: recursion is monomorphic, so a call reuses them.
  group_labels: List<{ name: Bytes, vars: List<Int> }>,
  auto_ty_params: Bool,
  alias_stack: List<Bytes>,
  refused_atoms: List<Span>,
  performs: List<PerformSite>,
  // The written row of the definition being checked; empty when it wrote none, or for a test or law.
  declared_atoms: List<Atom>,
  comparisons: List<{ module: Int, span: Span, ty: Type }>,
  scope: Int,
  constraints: Map<Bytes, List<DefConstraint>>,
  numerics: List<Numeric>,
  bit_ops: List<BitOp>,
  concats: List<ConcatSite>,
  updates: List<UpdateSite>,
  update_shapes: List<UpdateShape>,
  simulate_depth: Int,
  open_regions: List<OpenRegion>,
  regions: List<RegionSite>,
  simulations: List<Simulation>,
  map_keys: List<MapKeySite>,
  constrained_uses: List<ConstraintSite>,
  spec_kind: Option<SpecKind>,
  spec_envs: List<SpecEnv>,
  derived: Option<Derived>,
  known: Known,
  assumed: List<Assumed>,
}

type Inferred = { cx: Cx, ty: Type, row: Row }
type WithTy = { cx: Cx, t: Type }
type WithVar = { cx: Cx, v: Int }
type WithRow = { cx: Cx, r: Row }
type WithName = { cx: Cx, name: Option<Bytes> }
type Expected = { cx: Cx, ok: Bool }
type WithTys = { cx: Cx, ts: List<Type> }
type WithSig = { cx: Cx, sig: Sig }
type WithAtom = { cx: Cx, atom: Option<Atom> }
type WithKey = { cx: Cx, key: Option<ValueKey> }
type WithHit = { cx: Cx, hit: Option<{ info: EffectInfo, op: OpInfo }> }
type WithRes = { cx: Cx, res: Option<Resource> }
type WithBodyRow = { cx: Cx, row: Row }
type Generalized = { e: TypeEnv, sc: Scheme }

fn cell() -> Bytes = b"cell"
fn compare_values_name() -> Bytes = b"compare_values"
fn result_name() -> Bytes = b"result"

fn here(cx: Cx, s: Span) -> Loc = { module: cx.module, span: s }

fn module_name(cx: Cx, i: Int) -> Bytes = at(cx.mods, i).name

fn scope_of(cx: Cx) -> Scope = at(cx.r.scopes, cx.module)

fn report(cx: Cx, d: Diag) -> Cx = {..cx, diags: push(cx.diags, d)}

fn err1(cx: Cx, code: Bytes, s: Span, message: Bytes, label: Bytes, notes: List<Bytes>) -> Cx =
  report(cx, diag1(code, cx.module, s, message, label, notes))

fn err2(cx: Cx, code: Bytes, s: Span, message: Bytes, label: Bytes, also: Loc, also_text: Bytes, notes: List<Bytes>) -> Cx =
  report(cx, diag2(code, cx.module, s, message, label, also.module, also.span, also_text, notes))

fn err_labels(cx: Cx, code: Bytes, message: Bytes, labels: List<Label>, notes: List<Bytes>) -> Cx =
  report(cx, diag(code, message, labels, notes))

fn tick(x: Bytes) -> Bytes = bytes_concat_all([b"`", x, b"`"])

fn qname_text(q: QName) -> Bytes =
  match q.module { Some(m) -> bytes_concat_all([m.name, b"::", q.name.name]), None -> q.name.name }

fn plural(n: Int) -> Bytes = if n == 1 { b"" } else { b"s" }

fn supplied(n: Int) -> Bytes = if n == 1 { b"1 was supplied" } else { bytes_concat(num(n), b" were supplied") }

fn what_of(d: Deriver) -> Bytes = match d { DJson -> b"JSON encoding", DEq -> b"structural equality", DOrd -> b"order" }

fn deriver_tag(d: Deriver) -> Int = match d { DJson -> 0, DEq -> 1, DOrd -> 2 }

fn same_deriver(a: Deriver, b: Deriver) -> Bool = deriver_tag(a) == deriver_tag(b)

pub fn deriver_text(d: Deriver) -> Bytes = match d { DJson -> b"json", DEq -> b"eq", DOrd -> b"ord" }

fn row_aliases(def: FnDef) -> List<Bytes> =
  match def.effects { Some(r) -> map(r.aliases, |q: QName| q.name.name), None -> [] }

// --- Fresh variables, threaded ---------------------------------------------------------

fn new_ty(cx: Cx) -> { cx: Cx, t: Type } = { let o = fresh_ty(cx.fresh); { cx: {..cx, fresh: o.f}, t: o.t } }
fn new_ty_var(cx: Cx) -> { cx: Cx, v: Int } = { let o = fresh_ty_var(cx.fresh); { cx: {..cx, fresh: o.f}, v: o.v } }
fn new_row(cx: Cx) -> { cx: Cx, r: Row } = { let o = fresh_row(cx.fresh); { cx: {..cx, fresh: o.f}, r: o.r } }
fn new_row_var(cx: Cx) -> { cx: Cx, v: Int } = { let o = fresh_row_var(cx.fresh); { cx: {..cx, fresh: o.f}, v: o.v } }

fn resolve(cx: Cx, t: Type) -> Type = resolve_ty(cx.subst, t)
fn resolve_r(cx: Cx, r: Row) -> Row = resolve_row(cx.subst, r)

fn with_unified(cx: Cx, u: Unified) -> Cx = {..cx, subst: u.s, fresh: u.f}

// --- The prelude ----------------------------------------------------------------------

fn prelude_effect_names() -> List<Bytes> = [b"task", b"clock", b"random", b"sim"]
pub fn is_prelude_effect(name: Bytes) -> Bool = contains_bytes(prelude_effect_names(), name)
fn simulated_names() -> List<Bytes> = [b"task", b"clock", b"random"]

fn seed_atom() -> Atom = { effect: b"sim", resource: RSingleton, mode: MRead, op: None }

fn builtin_type_arities() -> List<{ name: Bytes, arity: Int }> =
  [{ name: b"Int", arity: 0 }, { name: b"Bool", arity: 0 }, { name: b"String", arity: 0 }, { name: b"Bytes", arity: 0 },
   { name: b"U8", arity: 0 }, { name: b"U16", arity: 0 }, { name: b"U32", arity: 0 }, { name: b"U64", arity: 0 },
   { name: b"I8", arity: 0 }, { name: b"I16", arity: 0 }, { name: b"I32", arity: 0 }, { name: b"I64", arity: 0 },
   { name: b"Float", arity: 0 }, { name: b"Decimal", arity: 0 }, { name: b"Unit", arity: 0 }, { name: b"List", arity: 1 },
   { name: b"Map", arity: 2 }, { name: b"Cell", arity: 1 }, { name: b"Secret", arity: 1 }, { name: b"Task", arity: 1 },
   { name: b"Option", arity: 1 }, { name: b"Result", arity: 2 }, { name: b"Ordering", arity: 0 }, { name: b"Rounding", arity: 0 },
   { name: b"Iter", arity: 2 }]

fn builtin_type_arity(name: Bytes) -> Option<Int> =
  fold(builtin_type_arities(), None, |acc: Option<Int>, x: { name: Bytes, arity: Int }|
    match acc { Some(_) -> acc, None -> if x.name == name { Some(x.arity) } else { None } })

type Adt = { name: Bytes, params: List<Bytes>, variants: List<{ name: Bytes, fields: List<Bytes> }> }

fn prelude_adts() -> List<Adt> =
  [{ name: b"Option", params: [b"a"], variants: [{ name: b"None", fields: [] }, { name: b"Some", fields: [b"a"] }] },
   { name: b"Result", params: [b"a", b"e"], variants: [{ name: b"Ok", fields: [b"a"] }, { name: b"Err", fields: [b"e"] }] },
   { name: b"Ordering", params: [], variants: [{ name: b"Less", fields: [] }, { name: b"Equal", fields: [] }, { name: b"Greater", fields: [] }] },
   { name: b"Rounding", params: [], variants: [{ name: b"HalfEven", fields: [] }, { name: b"HalfUp", fields: [] }, { name: b"Down", fields: [] },
                                               { name: b"Up", fields: [] }, { name: b"Ceiling", fields: [] }, { name: b"Floor", fields: [] }] },
   { name: b"Iter", params: [b"s", b"r"], variants: [{ name: b"Continue", fields: [b"s"] }, { name: b"Stop", fields: [b"r"] }] }]

fn position_bytes(xs: List<Bytes>, v: Bytes) -> Int =
  fold(range(0, len(xs)), 0 - 1, |acc: Int, i: Int| if acc >= 0 { acc } else if at(xs, i) == v { i } else { acc })

fn install_prelude_adts(cx: Cx) -> Cx =
  fold(prelude_adts(), cx, |c: Cx, adt: Adt| {
    let vars = range(0, len(adt.params));
    let result = TyCon({ name: adt.name, args: map(vars, |v: Int| TyVar(v)) });
    fold(range(0, len(adt.variants)), c, |c2: Cx, index: Int| {
      let v = at(adt.variants, index);
      let fields = map(v.fields, |p: Bytes| TyVar(position_bytes(adt.params, p)));
      let ty = if len(fields) == 0 { result } else { t_fn(fields, result, row_empty()) };
      let sc = { ty_vars: vars, row_vars: [], label_vars: [], ty: ty };
      add_ctor({..c2, env: env_bind_global(c2.env, v.name, sc)},
               { name: v.name, module: b"", simple_name: v.name, type_name: adt.name, index: index,
                 arity: len(fields), fields: fields, scheme: sc, at: { module: 0, span: dummy_span() } })
    })
  })

fn add_ctor(cx: Cx, info: CtorInfo) -> Cx =
  {..cx, ctors: push(cx.ctors, info), ctor_index: map_insert(cx.ctor_index, info.name, len(cx.ctors))}

fn ctor_of(cx: Cx, name: Bytes) -> Option<CtorInfo> =
  match map_get(cx.ctor_index, name) { Some(i) -> Some(at(cx.ctors, i)), None -> None }

fn add_effect(cx: Cx, info: EffectInfo) -> Cx =
  {..cx, effects: push(cx.effects, info), effect_index: map_insert(cx.effect_index, info.name, len(cx.effects))}

fn effect_of(cx: Cx, name: Bytes) -> Option<EffectInfo> =
  match map_get(cx.effect_index, name) { Some(i) -> Some(at(cx.effects, i)), None -> None }

fn def_of(cx: Cx, name: Bytes) -> Option<DefInfo> =
  match map_get(cx.def_index, name) { Some(i) -> Some(at(cx.defs, i)), None -> None }

fn set_def(cx: Cx, info: DefInfo) -> Cx =
  match map_get(cx.def_index, info.name) {
    Some(i) -> {..cx, defs: set_at(cx.defs, i, info)},
    None -> {..cx, defs: push(cx.defs, info), def_index: map_insert(cx.def_index, info.name, len(cx.defs))},
  }

fn prelude_op(name: Bytes, mode: Mode, ty_vars: List<Int>, row_vars: List<Int>, params: List<Type>, ret: Type, row: Row) -> OpInfo =
  { name: name, mode: mode, resource_param: false, params: params, ret: ret, at: { module: 0, span: dummy_span() },
    scheme: Some({ ty_vars: ty_vars, row_vars: row_vars, label_vars: [], ty: t_fn(params, ret, row) }) }

fn prelude_effects() -> List<EffectInfo> = {
  let ta = TyVar(0);
  let body = t_fn([], ta, row_open(0));
  let task = con1(b"Task", ta);
  let none = { module: 0, span: dummy_span() };
  [{ name: b"task", module: b"", simple_name: b"task", nondet: true, at: none,
     ops: [prelude_op(b"spawn", MWrite, [0], [0], [body], task, row_open(0)),
           prelude_op(b"join", MWrite, [0], [], [task], ta, row_empty()),
           prelude_op(b"yield", MWrite, [], [], [], t_unit(), row_empty())] },
   { name: b"clock", module: b"", simple_name: b"clock", nondet: true, at: none,
     ops: [prelude_op(b"now", MRead, [], [], [], t_int(), row_empty()),
           prelude_op(b"sleep", MWrite, [], [], [t_int()], t_unit(), row_empty())] },
   { name: b"random", module: b"", simple_name: b"random", nondet: true, at: none,
     ops: [prelude_op(b"next", MWrite, [], [], [], t_int(), row_empty()),
           prelude_op(b"below", MWrite, [], [], [t_int()], t_int(), row_empty())] },
   { name: b"sim", module: b"", simple_name: b"sim", nondet: false, at: none,
     ops: [prelude_op(b"seed", MRead, [], [], [], t_int(), row_empty())] }]
}

fn simulated_atoms() -> List<Atom> =
  fold(prelude_effects(), [], |acc: List<Atom>, e: EffectInfo|
    if contains_bytes(simulated_names(), e.name) {
      fold(e.ops, acc, |a: List<Atom>, op: OpInfo| atoms_insert(a, { effect: e.name, resource: RSingleton, mode: op.mode, op: None }))
    } else { acc })

fn mono_fn(params: List<Type>, ret: Type) -> Scheme = mono(t_fn(params, ret, row_empty()))
fn poly_fn(tys: List<Int>, rows: List<Int>, params: List<Type>, ret: Type, eff: Row) -> Scheme =
  { ty_vars: tys, row_vars: rows, label_vars: [], ty: t_fn(params, ret, eff) }

// Every builtin's scheme over the type variables `a`, `b`, `c` and the row variable `e`.
pub fn builtin_schemes(a: Int, b: Int, c: Int, e: Int) -> List<{ name: Bytes, sc: Scheme }> = {
  let ta = TyVar(a);
  let tb = TyVar(b);
  let tc = TyVar(c);
  let re = row_open(e);
  let map_ty = t_map(ta, tb);
  let entry_ty = TyRecord(fields_sorted([{ name: b"key", ty: ta }, { name: b"value", ty: tb }]));
  let ordering = con(b"Ordering");
  let rounding = con(b"Rounding");
  let cell_ty = TyCon({ name: b"Cell", args: [tb, ta] });
  [
    { name: b"assert", sc: mono_fn([t_bool(), t_option(t_string())], t_unit()) },
    { name: b"assert_eq", sc: poly_fn([a], [], [ta, ta], t_unit(), row_empty()) },
    { name: b"len", sc: poly_fn([a], [], [t_list(ta)], t_int(), row_empty()) },
    { name: b"push", sc: poly_fn([a], [], [t_list(ta), ta], t_list(ta), row_empty()) },
    { name: b"list_at", sc: poly_fn([a], [], [t_list(ta), t_int()], t_option(ta), row_empty()) },
    { name: b"list_set", sc: poly_fn([a], [], [t_list(ta), t_int(), ta], t_list(ta), row_empty()) },
    { name: b"map", sc: poly_fn([a, b], [e], [t_list(ta), t_fn([ta], tb, re)], t_list(tb), re) },
    { name: b"filter", sc: poly_fn([a], [e], [t_list(ta), t_fn([ta], t_bool(), re)], t_list(ta), re) },
    { name: b"fold", sc: poly_fn([a, b], [e], [t_list(ta), tb, t_fn([tb, ta], tb, re)], tb, re) },
    { name: b"iterate", sc: poly_fn([a, b], [e], [ta, t_int(), t_fn([ta], t_iter(ta, tb), re)], tb, re) },
    { name: b"range", sc: mono_fn([t_int(), t_int()], t_list(t_int())) },
    // The wrapping family is `forall a. (a, a) -> a`; `infer_app` attaches the integer obligation at each call.
    { name: b"wrap_add", sc: poly_fn([a], [], [ta, ta], ta, row_empty()) },
    { name: b"wrap_sub", sc: poly_fn([a], [], [ta, ta], ta, row_empty()) },
    { name: b"wrap_mul", sc: poly_fn([a], [], [ta, ta], ta, row_empty()) },
    { name: b"rotr", sc: poly_fn([a], [], [ta, t_int()], ta, row_empty()) },
    { name: b"rotr32", sc: mono_fn([t_int(), t_int()], t_int()) },
    { name: b"u8_of_int", sc: mono_fn([t_int()], con(b"U8")) },
    { name: b"u16_of_int", sc: mono_fn([t_int()], con(b"U16")) },
    { name: b"u32_of_int", sc: mono_fn([t_int()], con(b"U32")) },
    { name: b"u64_of_int", sc: mono_fn([t_int()], con(b"U64")) },
    { name: b"i8_of_int", sc: mono_fn([t_int()], con(b"I8")) },
    { name: b"i16_of_int", sc: mono_fn([t_int()], con(b"I16")) },
    { name: b"i32_of_int", sc: mono_fn([t_int()], con(b"I32")) },
    { name: b"i64_of_int", sc: mono_fn([t_int()], con(b"I64")) },
    { name: b"int_of_u8", sc: mono_fn([con(b"U8")], t_int()) },
    { name: b"int_of_u16", sc: mono_fn([con(b"U16")], t_int()) },
    { name: b"int_of_u32", sc: mono_fn([con(b"U32")], t_int()) },
    { name: b"int_of_u64", sc: mono_fn([con(b"U64")], t_int()) },
    { name: b"int_of_i8", sc: mono_fn([con(b"I8")], t_int()) },
