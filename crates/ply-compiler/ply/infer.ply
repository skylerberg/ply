    { name: b"min", sc: mono_fn([t_int(), t_int()], t_int()) },
    { name: b"max", sc: mono_fn([t_int(), t_int()], t_int()) },
    { name: b"byte_of_int", sc: mono_fn([t_int()], t_bytes()) },
    { name: b"int_to_string", sc: mono_fn([t_int()], t_string()) },
    { name: b"string_concat", sc: mono_fn([t_string(), t_string()], t_string()) },
    { name: b"bytes_len", sc: mono_fn([t_bytes()], t_int()) },
    { name: b"bytes_at", sc: mono_fn([t_bytes(), t_int()], t_int()) },
    { name: b"bytes_u32_le", sc: mono_fn([t_bytes(), t_int()], con(b"U32")) },
    { name: b"bytes_slice", sc: mono_fn([t_bytes(), t_int(), t_int()], t_bytes()) },
    { name: b"bytes_concat", sc: mono_fn([t_bytes(), t_bytes()], t_bytes()) },
    { name: b"bytes_concat_all", sc: mono_fn([t_list(t_bytes())], t_bytes()) },
    { name: b"bytes_of_string", sc: mono_fn([t_string()], t_bytes()) },
    { name: b"bytes_is_utf8", sc: mono_fn([t_bytes()], t_bool()) },
    { name: b"bytes_index_of", sc: mono_fn([t_bytes(), t_bytes()], t_option(t_int())) },
    { name: b"bytes_index_of_from", sc: mono_fn([t_bytes(), t_bytes(), t_int()], t_option(t_int())) },
    { name: b"bytes_index_of_byte", sc: mono_fn([t_bytes(), t_int()], t_option(t_int())) },
    { name: b"bytes_starts_with", sc: mono_fn([t_bytes(), t_bytes()], t_bool()) },
    { name: b"bytes_ends_with", sc: mono_fn([t_bytes(), t_bytes()], t_bool()) },
    { name: b"bytes_split", sc: mono_fn([t_bytes(), t_bytes()], t_list(t_bytes())) },
