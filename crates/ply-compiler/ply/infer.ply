    { name: b"string_contains", sc: mono_fn([t_string(), t_string()], t_bool()) },
    { name: b"string_find", sc: mono_fn([t_string(), t_string()], t_int()) },
    { name: b"compare", sc: poly_fn([a], [], [ta, ta], ordering, row_empty()) },
    { name: b"compare_values", sc: poly_fn([a], [], [ta, ta], ordering, row_empty()) },
    { name: b"map_new", sc: poly_fn([a, b], [], [], map_ty, row_empty()) },
    { name: b"map_insert", sc: poly_fn([a, b], [], [map_ty, ta, tb], map_ty, row_empty()) },
    { name: b"map_update", sc: poly_fn([a, b], [e], [map_ty, ta, t_fn([tb], tb, re)], map_ty, re) },
    { name: b"map_get", sc: poly_fn([a, b], [], [map_ty, ta], t_option(tb), row_empty()) },
    { name: b"map_contains", sc: poly_fn([a, b], [], [map_ty, ta], t_bool(), row_empty()) },
    { name: b"map_remove", sc: poly_fn([a, b], [], [map_ty, ta], map_ty, row_empty()) },
    { name: b"map_len", sc: poly_fn([a, b], [], [map_ty], t_int(), row_empty()) },
    { name: b"map_keys", sc: poly_fn([a, b], [], [map_ty], t_list(ta), row_empty()) },
    { name: b"map_values", sc: poly_fn([a, b], [], [map_ty], t_list(tb), row_empty()) },
    { name: b"map_entries", sc: poly_fn([a, b], [], [map_ty], t_list(entry_ty), row_empty()) },
    { name: b"map_of_entries", sc: poly_fn([a, b], [], [t_list(entry_ty)], map_ty, row_empty()) },
    { name: b"map_merge", sc: poly_fn([a, b], [], [map_ty, map_ty], map_ty, row_empty()) },
    { name: b"map_fold", sc: poly_fn([a, b, c], [e], [map_ty, tc, t_fn([tc, ta, tb], tc, re)], tc, re) },
    { name: b"decimal_div", sc: mono_fn([t_decimal(), t_decimal(), t_int(), rounding], t_decimal()) },
    { name: b"decimal_round", sc: mono_fn([t_decimal(), t_int(), rounding], t_decimal()) },
    { name: b"decimal_of_int", sc: mono_fn([t_int()], t_decimal()) },
    { name: b"int_of_decimal", sc: mono_fn([t_decimal(), rounding], t_option(t_int())) },
    { name: b"float_of_decimal", sc: mono_fn([t_decimal()], t_float()) },
    { name: b"decimal_of_float", sc: mono_fn([t_float()], t_option(t_decimal())) },
    { name: b"decimal_of_string", sc: mono_fn([t_string()], t_option(t_decimal())) },
    { name: b"float_of_string", sc: mono_fn([t_string()], t_option(t_float())) },
    { name: b"decimal_to_string", sc: mono_fn([t_decimal()], t_string()) },
    { name: b"bits_of_float", sc: mono_fn([t_float()], t_int()) },
    { name: b"float_of_bits", sc: mono_fn([t_int()], t_float()) },
    { name: b"panic", sc: poly_fn([a], [], [t_string()], ta, row_empty()) },
    { name: b"secret_of_string", sc: mono_fn([t_string()], t_secret(t_string())) },
    { name: b"secret_verify", sc: mono_fn([t_secret(t_string()), t_string()], t_bool()) },
    { name: b"secret_is_empty", sc: poly_fn([a], [], [t_secret(ta)], t_bool(), row_empty()) },
    { name: b"cell_get", sc: poly_fn([a, b], [], [cell_ty], ta, row_empty()) },
    { name: b"cell_set", sc: poly_fn([a, b], [], [cell_ty, ta], t_unit(), row_empty()) },
    { name: b"cell_update", sc: poly_fn([a, b], [e], [cell_ty, t_fn([ta], ta, re)], t_unit(), row_empty()) },
  ]
}

pub type BuiltinDoc = { name: Bytes, params: List<Bytes>, note: Bytes }

fn bdoc(name: Bytes, params: List<Bytes>, note: Bytes) -> BuiltinDoc = { name: name, params: params, note: note }

// Every builtin's parameter names and its one-line note, which `ply doc` prints beside the scheme.
pub fn builtin_docs() -> List<BuiltinDoc> = [
  bdoc(b"assert", [b"cond", b"message"], b"E0501 when `cond` is false; `message` defaults to `None`"),
  bdoc(b"assert_eq", [b"actual", b"expected"], b"E0501 when they differ"),
  bdoc(b"len", [b"xs"], b""),
  bdoc(b"push", [b"xs", b"x"], b"a new list with `x` at the end"),
  bdoc(b"list_at", [b"xs", b"i"], b"`None` if `i` is negative or past the end"),
  bdoc(b"list_set", [b"xs", b"i", b"v"], b"raises if `i` is out of range"),
  bdoc(b"map", [b"xs", b"f"], b""),
  bdoc(b"filter", [b"xs", b"f"], b""),
  bdoc(b"fold", [b"xs", b"init", b"f"], b"left to right"),
  bdoc(b"iterate", [b"seed", b"budget", b"step"], b"`step` answers `Continue(next)` or `Stop(result)`; the budget bounds the steps"),
  bdoc(b"range", [b"lo", b"hi"], b"`[lo, hi)`"),
  bdoc(b"wrap_add", [b"a", b"b"], b"any integer type; wraps at its width"),
  bdoc(b"wrap_sub", [b"a", b"b"], b"any integer type; wraps at its width"),
  bdoc(b"wrap_mul", [b"a", b"b"], b"any integer type; wraps at its width"),
  bdoc(b"rotr", [b"x", b"n"], b"any integer type; rotated right by `n` bits at its width"),
  bdoc(b"rotr32", [b"x", b"n"], b"the low thirty-two bits of `x`, rotated right by `n`"),
  bdoc(b"u8_of_int", [b"n"], b"raises if out of range"),
  bdoc(b"u16_of_int", [b"n"], b"raises if out of range"),
  bdoc(b"u32_of_int", [b"n"], b"raises if out of range"),
  bdoc(b"u64_of_int", [b"n"], b"raises if out of range"),
  bdoc(b"i8_of_int", [b"n"], b"raises if out of range"),
  bdoc(b"i16_of_int", [b"n"], b"raises if out of range"),
  bdoc(b"i32_of_int", [b"n"], b"raises if out of range"),
  bdoc(b"i64_of_int", [b"n"], b"raises if out of range"),
  bdoc(b"int_of_u8", [b"n"], b"total"),
