// --- What the checker keeps ----------------------------------------------------------

/// A prelude item's `at` is `{ module: 0, span: dummy_span() }`.
pub type Location = { module: Int, span: Span }
/// What a `type` declares: an alias each use expands, a record of its own, or a sum.
type Declaration = | DeclaredAlias(TypeExpr) | DeclaredRecord(TypeExpr) | DeclaredSum
/// `opaque` is what the declaration says of it: only `owner` builds a value of the type.
type TypeDecl = {
  params: List<Bytes>,
  labels: List<Bytes>,
  rows: List<Bytes>,
  declared: Declaration,
  opaque: Option<Opaque>,
  owner: Int,
  span: Span,
}
/// A `new` record as its declaration converts: its type over the variables its parameters became,
/// types then labels in `ty_vars` and rows in `row_vars`, which a use's arguments take the place of.
type RecordDecl = { ty: Type, ty_vars: List<Int>, row_vars: List<Int> }
pub type OpInfo = {
  name: Bytes,
  mode: Mode,
  resource_param: Bool,
  params: List<Type>,
  ret: Type,
  at: Location,
  scheme: Option<Scheme>,
}
pub type EffectInfo = {
  name: Bytes,
  module: Bytes,
  simple_name: Bytes,
  nondet: Bool,
  ops: List<OpInfo>,
  at: Location,
}
pub type CtorInfo = {
  name: Bytes,
  module: Bytes,
  simple_name: Bytes,
  type_name: Bytes,
  index: Int,
  arity: Int,
  fields: List<Type>,
  scheme: Scheme,
  at: Location,
}
pub type DefConstraint = { deriver: Deriver, param: Int }
/// What a type's module states its values go through: `by` is the function, and `answers` what it
/// answers over the type's own type and row parameters, as the function's signature numbers them.
pub type InstanceInfo = {
  type_name: Bytes,
  kind: InstanceKind,
  by: Bytes,
  params: List<Int>,
  rows: List<Int>,
  answers: Type,
  at: Location,
}
/// The arithmetic a type's module states the operators mean at it: `fns` are its functions in
/// `numeric_ops`' order, and `ctor` one of its constructors, which a witness names it by.
pub type NumericInfo = { type_name: Bytes, ctor: Bytes, fns: List<Bytes>, at: Location }
pub type SpecInfo = { kind: SpecKind, index: Int, footprint: List<Atom>, span: Span }
pub type DefInfo = {
  name: Bytes,
  module: Bytes,
  simple_name: Bytes,
  scheme: Scheme,
  footprint: List<Atom>,
  performed: List<Atom>,
  /// The atoms of `footprint` performed a number of times that grows with the input, and the
  /// parameters whose functions are called so.
  scaling: List<Atom>,
  repeats: List<Int>,
  /// What the written row promises bounded, which is all a caller in another package reads.
  bounded: List<Atom>,
  tail_bounded: Bool,
  /// Whether its calls are known to return (`diverges` where they may not).
  ending: Ending,
  /// How it calls the functions it is handed and what it answers, which callers' endings read.
  summary: Summary,
  /// Where its body can raise `abort.raise`, and why nothing there rules the raise out.
  raises: List<Raise>,
  row_aliases: List<Bytes>,
  constraints: List<DefConstraint>,
  spec: List<SpecInfo>,
  at: Location,
}
/// Why a place in a body can raise `abort.raise`.
pub type RaiseWhy =
  /// A builtin called where `needs`, a clause of its `requires` as the prelude writes it, is not
  /// shown.
  | Unshown({ callee: Bytes, needs: Bytes })
  /// A builtin that states no `requires`: nothing a call shows rules its raise out.
  | Unguarded(Bytes)
  /// A definition whose row names the raise.
  | Calls(Bytes)
  /// A `/` or `%` whose divisor nothing shows is other than zero.
  | ZeroDivisor
  /// A `let` whose pattern can miss.
  | Misses
  /// An operation that raises it, performed.
  | Performed
  /// A function value whose type says it may.
  | Handed
/// `span` counts from where the definition starts, so a raise filed for a definition is where it
/// is wherever the definition moves to.
pub type Raise = { span: Span, why: RaiseWhy }

derive bin for RaiseWhy
derive bin for Raise

pub type RaiseNote = { span: Span, why: RaiseWhy }
pub type TestInfo = {
  name: Bytes,
  module: Bytes,
  key: Bytes,
  index: Int,
  nondet: Bool,
  /// Over cases: `name` is its label's template, and a run makes a test of each case it lists.
  cases: Bool,
  /// What a run of it must be given: no raise, which fails it, and no `diverges`, which its steps bound.
  footprint: List<Atom>,
  at: Location,
}
pub type LawBinder = { name: Bytes, ty: Type, span: Span }
pub type LawInfo = {
  name: Bytes,
  module: Bytes,
  key: Bytes,
  index: Int,
  binders: List<LawBinder>,
  has_guard: Bool,
  /// As a test's: a discharge answers a raise as a gap.
  footprint: List<Atom>,
  at: Location,
}
derive bin for Location
derive bin for OpInfo
derive bin for EffectInfo
derive bin for CtorInfo
derive bin for DefConstraint
derive bin for InstanceInfo
derive bin for NumericInfo
derive bin for SpecInfo
derive bin for DefInfo
derive bin for TestInfo
derive bin for LawBinder
derive bin for LawInfo

/// Where an atom entered a body's row: an operation performed here, a named definition's row,
/// arguments alone (a builtin or constructor), or a function value.
pub type PerformSource = | DirectPerform | PerformVia(Bytes) | PerformThroughArgs | OpaquePerform
/// `over` is the iteration the site repeats with: a call that runs it once per element of its input,
/// or a recursive call; `None` where it runs a number of times no input decides.
pub type PerformSite = {
  atom: Atom,
  module: Int,
  span: Span,
  source: PerformSource,
  over: Option<Span>,
  /// The iterations around it that wait on a callee's counts, innermost first: the first that
  /// holds is the site's, before `over`.
  maybe: List<Maybe>,
}
/// An iteration a call turns out to be once the definition `callee` is counted: it calls its parameter `param` a number of times that grows with its input, or, with
/// no `param`, performs the site's own atom so.
pub type Maybe = { callee: Bytes, param: Option<Int>, span: Span }
/// A row variable performed under an iteration, as a `PerformSite` is.
type Repeated = { var: Int, over: Option<Span>, maybe: List<Maybe> }
/// A row variable a body performs under an iteration, as its group reads it with nothing of the
/// walk's substitution: the parameters whose types hold the variable, and whether it is the
/// definition's own row parameter.
pub type RepeatedRow = { params: List<Int>, tail: Bool, over: Option<Span>, maybe: List<Maybe> }
/// A call of a function of the module being checked.
pub type OwnCall = { callee: Bytes, span: Span }
/// A use of a function of a type, or a call on a value, which the rewrite writes as later passes
/// read it. A call on a value, `base.name(args)`, at `span` calls `qualifier::name` with the value
/// first, or the bare `name` where `qualifier` is empty; with no `name` either it calls the
/// function the value holds in the field written. A name written `T::name` at `span` is
/// `qualifier::name`. `callee` is the function's qualified name, empty for a field's, and
/// `reaches` the modules the defaults the call copies name. `named` is the place among the
/// callee's parameters, the value's first, of each argument the call names, in the order written.
pub type MemberSite = {
  module: Int,
  span: Span,
  qualifier: Bytes,
  name: Bytes,
  callee: Bytes,
  owner: Bytes,
  reaches: List<Bytes>,
  named: List<Int>,
}
/// A tagged literal whose tag's function `name` is one of the module being checked.
type TagUse = { owner: Bytes, name: Bytes, t: Tagged, callee: QName }
type OpKey = { effect: Bytes, op: Bytes, resource: Resource }
type Numeric = { span: Span, op: Bytes, ty: Type }
/// A bit operator's or integer builtin's operand, kept until its type is known. `what` names the site in a diagnostic.
type BitOp = { span: Span, what: Bytes, ty: Type, builtin: Bool }
/// A type parameter a `numeric` or `integer` constraint makes the witness of: a hidden argument each
/// call fills with the type it instantiates the parameter at.
type Witnessed = { param: Bytes, integer: Bool }
/// An operator over a witnessed parameter, which the elaboration rewrites to read the witness.
pub type WitnessOp = { module: Int, span: Span, param: Bytes, owner: Bytes }
/// `params` are the callee's type parameters the witnesses are for, so one constrained twice is
/// passed once.
pub type WitnessRef = {
  module: Int,
  span: Span,
  witnesses: List<NumericWitness>,
  params: List<Int>,
  owner: Bytes,
}
/// A definition's witnessed type parameters in its scheme's order, which is the order a call passes
/// their witnesses in.
pub type WitnessOrder = { module: Int, name: Bytes, params: List<Bytes> }
/// A reference inside the group being walked that filled a member's type parameters: `args` are
/// what it gave them, in the order the member's scheme takes them.
type GroupFill = { module: Int, span: Span, callee: Bytes, args: List<Type> }
/// The one type both sides of a `++` share, kept until the substitution has it: `String` and `Bytes` both join.
type ConcatSite = { module: Int, span: Span, ty: Type }

/// A definition named at `span` whose answer at its instantiation, `ty`, holds a `Columns`, waiting
/// to be settled.
type ColumnsSite = { module: Int, span: Span, ty: Type }
/// A written field of `{..b, f: e}` with the type its value inferred to.
type UpdateField = { name: Bytes, span: Span, ty: Type }
/// An update whose base was still a variable where it was written; `result` is what the site answered.
type UpdateSite = {
  module: Int,
  span: Span,
  base_span: Span,
  base: Type,
  written: List<UpdateField>,
  result: Type,
  owner: Bytes,
}
/// What the lowering needs: the field list of the record an update copies, in the record's own order.
pub type UpdateShape = { module: Int, span: Span, names: List<Bytes>, owner: Bytes }
/// The raise a `try` answers, by its effect's program-wide name, and how many values it carries.
pub type TrySite = { module: Int, span: Span, effect: Bytes, op: Bytes, arity: Int, owner: Bytes }
type Signature = {
  ty_params: Map<Bytes, Type>,
  row_params: Map<Bytes, Int>,
  label_params: Map<Bytes, Int>,
  fn_ty: Type,
  params: List<Type>,
  ret: Type,
  declared: Option<Row>,
  published_row: Row,
  /// The written row's atoms marked `bounded`, and whether its variable is.
  bounded: List<Atom>,
  tail_bounded: Bool,
  scope: Int,
}
/// One use of a label-generic definition: `vars` are the variables its label parameters became,
/// `called` is false while it is still only a value, and `written` records `f[conn](..)`.
type LabelApplication = {
  module: Int,
  span: Span,
  /// Where the callee's name ends: where a call writes the labels it fills.
  named: Int,
  callee: Bytes,
  vars: List<Int>,
  /// Those of `vars` a call writes: the ones that name no region.
  written: List<Int>,
  params: Map<Bytes, Int>,
  called: Bool,
  owner: Bytes,
}
/// What the emitter needs: the labels a call fills, in declaration order.
pub type LabelSite = { module: Int, span: Span, labels: List<Bytes>, owner: Bytes }
/// The type an operator reads its operands at, which is all its meaning turns on: the name of a
/// type with no arguments, `""` for any other. A wrapping builtin's site is its name.
pub type OperandSite = { module: Int, span: Span, ty: Bytes, owner: Bytes }
type OperandAt = { module: Int, span: Span, ty: Type, owner: Bytes }
/// A type the emitter reads off the checker rather than off what is written: a pattern's binder, a
/// lambda, an empty list, a law's binder, and a global named at a use with the type arguments it is
/// used at. Resolved when the check ends.
type TypedAt = { module: Int, span: Span, ty: Type, args: List<Type>, owner: Bytes }
/// A `TypedAt` resolved, with each variable its owner's scheme quantifies numbered as the scheme's
/// canonical form numbers it and every other variable `-1`, and no function type carrying a row.
/// `ty` and `args` are keys of a `TypeTable` beside the sites: a body names a few types at many
/// places, and one record type can be large.
pub type TypedSite = { module: Int, span: Span, ty: Bytes, args: List<Bytes>, owner: Bytes }
type Assumed = { deriver: Deriver, vars: List<Int> }
/// A clause of a `handle` around a spawn, typed as the function its task calls by performing `op`.
type ClauseSite = { span: Span, op: Atom, ty: Type }
/// `around` holds the clauses of every `handle` between the spawn and the region's open.
type SpawnSite = { span: Span, ty: Type, around: List<ClauseSite> }
type HandoffSite = { span: Span, ty: Type, op: Bytes }
/// `hold`: a `with_hold` opened it, which no other region of its name may nest in.
type OpenRegion = {
  name: Bytes,
  label: Bytes,
  span: Span,
  hold: Bool,
  simulate_depth: Int,
  spawns: List<SpawnSite>,
  handoffs: List<HandoffSite>,
}
type OuterBinding = { name: Bytes, ty: Type, site: Span }
type RegionSite = {
  module: Int,
  name: Bytes,
  label: Bytes,
  span: Span,
  hold: Bool,
  body_span: Span,
  body_ty: Type,
  exits: List<Span>,
  outer: List<OuterBinding>,
  spawns: List<SpawnSite>,
  handoffs: List<HandoffSite>,
}
/// What may not outlive a region: a `with_cell[r]` region's cells, a `with_hold[r]` region's hold
/// and every function that reads a hold, a `simulate` region's tasks.
type Brand = | CellsOf(Bytes) | HoldsOf(Bytes) | Tasks
type Opened = { name: Bytes, label: Bytes, span: Span }
/// A local bound outside the innermost `simulate` region, named inside it.
type Crossing = { name: Bytes, span: Span }
type CellAccess = { span: Span, region: Bytes }
/// `cells` hold a cell at the open, `writes` and `reads` reach `older` regions' cells, `entering` brings a task.
type Simulation = {
  module: Int,
  span: Span,
  body_span: Span,
  body_ty: Type,
  body_row: Row,
  exits: List<Span>,
  older: List<Opened>,
  cells: List<{ name: Bytes, ty: Type }>,
  writes: List<CellAccess>,
  reads: List<CellAccess>,
  entering: List<{ name: Bytes, span: Span, ty: Type }>,
}
/// A `parallel` block's branches and what each performs, judged once the module is solved.
type ParallelSite = { module: Int, span: Span, branches: List<{ span: Span, row: Row }> }
/// `params` names the signature's rigid type parameters, so a refusal can say which to constrain.
type RigidParam = { name: Bytes, var: Int }
/// `via` is the alias a use named when the `Map` came from its expansion, else empty.
type MapKeySite = {
  module: Int,
  span: Span,
  scope: Int,
  key: Type,
  assumed: List<Int>,
  params: List<RigidParam>,
  via: Bytes,
}
type ConstraintSite = {
  module: Int,
  span: Span,
  deriver: Deriver,
  param: Int,
  ty: Type,
  callee: Bytes,
  callee_at: Location,
  assumed: List<Int>,
  params: List<RigidParam>,
  called: Bool,
  owner: Bytes,
}
type SpecEnv = {
  name: Bytes,
  ty_params: Map<Bytes, Type>,
  row_params: Map<Bytes, Int>,
  params: List<Type>,
  ret: Type,
}
/// A member of the recursive group being walked, with the variables its binders took: `types` are
/// its own type parameters a call fills, in its scheme's order.
type GroupDef = { name: Bytes, labels: List<Int>, types: List<RigidParam> }

/// The rows the driver hands in for a definition, which are taken as they are. The rest of a
/// published interface is the written signature, which is on hand.
pub type KnownDef = {
  footprint: List<Atom>,
  performed: List<Atom>,
  scaling: List<Atom>,
  repeats: List<Int>,
  ending: Ending,
  summary: Summary,
  raises: List<Raise>,
  /// What the emitter reads of the body, as `root_facts` encoded it when the body was walked.
  facts: Bytes,
}
pub type KnownTest = { footprint: List<Atom>, facts: Bytes }
/// What the emitter reads of one body published from its rows: `name` is the definition, or a test
/// as `test_owner` names it.
pub type KeptFacts = { name: Bytes, facts: Bytes }

derive bin for KeptFacts

/// The name a test's roots and sites go by: its module, `test#` and a digest of its label, which
/// the module's tests do not share (E0105) and which no definition's name can spell.
pub fn test_owner(module: Bytes, label: Bytes) -> Bytes / {abort.raise} =
  by_label(module, b"test", label)

/// Whether `name` is one `test_owner` makes.
pub fn is_test_owner(name: Bytes) -> Bool =
  match name.split(b"#") {
    [named, digest] ->
      (named == b"test" || named.ends_with(b".test")) && digest.len() == 16
        && digest.position(0, |c: Int| bytes::hex_value(c) < 0) == None,
    _ -> false,
  }

/// The root of `part` (`guard` or `body`) of the law labelled `label`, named as a test's is.
pub fn law_root(module: Bytes, label: Bytes, part: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([by_label(module, b"law", label), b".", part])

fn by_label(module: Bytes, kind: Bytes, label: Bytes) -> Bytes / {abort.raise} =
  qualify(
    module,
    Bytes::concat_all([kind, b"#", Bytes::of_string(blake3(label).slice(0, 8).hex_of())]),
  )

/// The root a test over cases lists its cases by, beside the root that runs one.
pub fn cases_root(owner: Bytes) -> Bytes = owner.concat(b".cases")

/// What the listing root of a test over cases answers: each case's label and identity, in the
/// table's order.
pub fn listing_ty() -> Type / {abort.raise} =
  list_type(
    TyRecord(
      fields_sorted([
        { name: b"identity", ty: bytes_type() },
        { name: b"label", ty: string_type() },
      ]),
    ),
  )
/// `tests` is by test key. `root`: the modules below it are the run's own;
/// a definition of any other is counted by what its row writes, whatever its body does, so its
/// `bounded` promises were checked when its package was.
/// `types` holds the types the rows' facts name, by key.
/// `walks` is how the check treats the bodies of its module's functions.
pub type Known = {
  defs: Map<Bytes, KnownDef>,
  tests: Map<Bytes, KnownTest>,
  root: Int,
  types: TypeTable,
  walks: Walks,
}

pub fn no_known() -> Known =
  { defs: Map::new(), tests: Map::new(), root: 1 << 62, types: Map::new(), walks: Every }

/// How a check treats the bodies of its module's functions. A function whose rows are handed in
/// (`Known.defs`) is published from them whichever this is.
pub type Walks =
  /// Each is walked, and every group settled.
  | Every
  /// Those named are walked and any other is published from its signature. No group is settled.
  | Only(List<Bytes>)
  /// None is walked. One whose body another check walked, held here by function, is published
  /// from its signature and that body's row, and any other from its signature. A group is settled
  /// where every member's body or rows are in hand. The sites are what the calls on values in
  /// those bodies call.
  | Given(Map<Bytes, HandedBody>, List<MemberSite>)

/// A body another check walked, and what the emitter reads of it as that check filed it.
pub type HandedBody = { body: WalkedBody, facts: Bytes }

type Checker = {
  resolved: Resolved,
  modules: List<ParsedModule>,
  module: Int,
  subst: Subst,
  fresh: Fresh,
  env: TypeEnv,
  diags: List<Diag>,
  types: Map<Bytes, TypeDecl>,
  effects: List<EffectInfo>,
  effect_index: Map<Bytes, Int>,
  ctors: List<CtorInfo>,
  ctor_index: Map<Bytes, Int>,
  defs: List<DefInfo>,
  def_index: Map<Bytes, Int>,
  tests: List<TestInfo>,
  laws: List<LawInfo>,
  ty_params: Map<Bytes, Type>,
  row_params: Map<Bytes, Int>,
  label_params: Map<Bytes, Int>,
  label_apps: List<LabelApplication>,
  label_sites: List<LabelSite>,
  /// The group being settled.
  group_defs: List<GroupDef>,
  /// The functions of the module whose bodies are being walked, each by its qualified name: the
  /// groups they form are read off what each body names and calls of them.
  own_fns: Map<Bytes, Int>,
  /// Those the body being walked names, the calls it makes of them, its tagged literals of them, and
  /// (`group_fills`) the types it fills their parameters with.
  refs: List<Bytes>,
  calls: List<OwnCall>,
  tag_uses: List<TagUse>,
  /// The parameters of each definition called so far whose types hold a function.
  fn_holding: Map<Bytes, List<Int>>,
  auto_ty_params: Bool,
  alias_stack: List<Bytes>,
  /// Each parameterless alias as an expansion made it, and the `Map` keys that expansion noted.
  aliases: Map<Bytes, { t: Type, keys: List<MapKeySite> }>,
  /// Each `new` record declared so far.
  nominals: Map<Bytes, RecordDecl>,
  refused_atoms: List<Location>,
  performs: List<PerformSite>,
  /// The iteration around the expression being inferred, as `PerformSite.over` reads, and those
  /// that wait on a callee's counts.
  over: Option<Span>,
  maybe: List<Maybe>,
  /// Each row variable a body performs under an iteration.
  repeated_vars: List<Repeated>,
  /// The first call into the group being settled: a recursive body performs all it does again there.
  recursed: Option<Span>,
  /// The written row of the definition being checked; empty when it wrote none, or for a test or law.
  declared_atoms: List<Atom>,
  /// What the conditions on the way to the expression being inferred hold.
  guards: Guards,
  /// What the prelude states of each builtin.
  contracts: Map<Bytes, Contract>,
  /// Why a raise recorded in `performs` was kept, by where it is.
  raise_notes: List<RaiseNote>,
  comparisons: List<{ module: Int, span: Span, ty: Type }>,
  scope: Int,
  constraints: Map<Bytes, List<DefConstraint>>,
  numerics: List<Numeric>,
  bit_ops: List<BitOp>,
  operands: List<OperandAt>,
  typed: List<TypedAt>,
  witnessed: Map<Int, Witnessed>,
  witness_refs: List<WitnessRef>,
  witness_orders: List<WitnessOrder>,
  group_fills: List<GroupFill>,
  /// How each definition checked so far calls the functions it is handed, and what it answers.
  summaries: Map<Bytes, Summary>,
  concats: List<ConcatSite>,
  columns: List<ColumnsSite>,
  updates: List<UpdateSite>,
  update_shapes: List<UpdateShape>,
  try_sites: List<TrySite>,
  member_sites: List<MemberSite>,
  /// The defaults calls on values copied, each beside its parameter's type, not yet typed.
  copied_defaults: List<{ expr: Expr, ty: Type }>,
  /// The builtin each call on a value of a language type calls, by the call's span.
  builtins_on: Map<Bytes, Bytes>,
  simulate_depth: Int,
  /// The scopes open around the innermost `simulate` body, and the locals of those it names.
  sim_scope: Int,
  crossings: List<Crossing>,
  open_regions: List<OpenRegion>,
  regions: List<RegionSite>,
  simulations: List<Simulation>,
  parallels: List<ParallelSite>,
  map_keys: List<MapKeySite>,
  constrained_uses: List<ConstraintSite>,
  spec_kind: Option<SpecKind>,
  spec_envs: List<SpecEnv>,
  derived: Option<Derived>,
  known: Known,
  seeded: List<Bytes>,
  /// The tests published from the rows handed in, by key.
  seeded_tests: List<Bytes>,
  /// The definition or test whose body is being walked, which every site the walk records is
  /// filed under; empty for a clause or a law, which are walked afresh each time.
  walking: Bytes,
  /// What the rows handed in say the emitter reads of each body published from them.
  kept: List<KeptFacts>,
  /// Each body this check walked, as another check reads it.
  bodies: List<WalkedBody>,
  assumed: List<Assumed>,
  instances: List<InstanceInfo>,
  /// Filled as the declarations are collected, before any body is checked: an operator in a body
  /// reads which types state `numeric`, and `keyed_names` which state a `key`.
  numeric_types: List<NumericInfo>,
  keyed_names: List<Bytes>,
  /// True while a `pub fn`'s default is walked: a caller in another module is handed a copy of it.
  copied: Bool,
  /// True while the first argument of `cell_get`, `cell_set` or `cell_update` is read, which is the
  /// one place a cell's name stands.
  cell_named: Bool,
  assignable: Assignable,
}

/// The variables of the handler whose clause is being walked, each by the stamp its name is bound
/// at, which an assignment may give a new value; `barred` names the place in the clause where none
/// may, since what runs there may run after the clause has returned.
type Assignable = { vars: List<{ stamp: Int, name: Bytes, ty: Type }>, barred: Option<Bytes> }

/// `checker` where no assignment may give the variables of the clause around it a value: inside
/// `place`, whose walk `unbarred` ends.
fn barred(checker: Checker, place: Bytes) -> Checker =
  if checker.assignable.vars.len() == 0 { checker }
  else { { ..checker, assignable: { ..checker.assignable, barred: Some(place) } } }

/// `o`, walked from `barred(outer, ..)`, with the assignments `outer` allowed allowed again.
fn unbarred(outer: Checker, o: Inferred) -> Inferred =
  if outer.assignable.vars.len() == 0 { o }
  else { { ..o, checker: { ..o.checker, assignable: outer.assignable } } }

type Inferred = { checker: Checker, ty: Type, row: Row }
type WithTy = { checker: Checker, ty: Type }
type WithVar = { checker: Checker, var: Int }
type WithRow = { checker: Checker, row: Row }
type WithName = { checker: Checker, name: Option<Bytes> }
type Expected = { checker: Checker, ok: Bool }
type WithTys = { checker: Checker, tys: List<Type> }
type WithSig = { checker: Checker, sig: Signature }
type WithAtom = { checker: Checker, atom: Option<Atom> }
type WithKey = { checker: Checker, key: Option<ValueKey> }
type WithHit = { checker: Checker, hit: Option<{ info: EffectInfo, op: OpInfo }> }
type WithResource = { checker: Checker, resource: Option<Resource> }
type WithBodyRow = { checker: Checker, row: Row }

/// A module's functions as their signatures bind them, each for every body of the module to call.
type Signed = { checker: Checker, sigs: List<Signature>, members: List<GroupDef> }

/// A body's walk as it stands in the checker's substitution, before it is closed.
type Walk = {
  checker: Checker,
  row: Row,
  performs: List<PerformSite>,
  repeated_vars: List<Repeated>,
  raise_notes: List<RaiseNote>,
  refs: List<Bytes>,
  calls: List<OwnCall>,
  tag_uses: List<TagUse>,
  fills: List<GroupFill>,
}

/// What a function's walk leaves for its group, closed: every type, atom and variable in it is as
/// the walk settled it, so its group reads it without the walk's substitution. Its row; what its
/// group reads of its signature (`params` and `tail` for what it performs through its parameters,
/// what its row promises `bounded`, whether it says `diverges`, and `written`, what the signature
/// alone says of its counts); what it performs and where; what it names and calls of its module's
/// functions, `stated` those an operator, a comparison or a constraint calls because a type states
/// them; and what each name it reads refers to. `filed` and `count` are the rows it was published
/// from, where its body was not walked.
type Body = {
  row: Row,
  filed: Option<KnownDef>,
  count: Option<Count>,
  params: List<Type>,
  tail: Option<Int>,
  bounded: List<{ atom: Atom, written: Bytes }>,
  tail_bounded: Bool,
  tail_name: Option<Bytes>,
  says_diverges: Bool,
  written: { scaling: List<Atom>, repeats: List<Int> },
  performs: List<PerformSite>,
  repeated: List<RepeatedRow>,
  raise_notes: List<RaiseNote>,
  refs: List<Bytes>,
  calls: List<OwnCall>,
  stated: List<OwnCall>,
  tags: List<TagRefusal>,
  fills: List<Fill>,
  names: List<NamedCallee>,
}

/// A tagged literal whose tag's function `name` is of its own module: what to say if the two turn
/// out to be in one recursion.
pub type TagRefusal = { name: Bytes, refusal: Diag }

/// A parameter a call fills with a type built from its caller's own, as the type prints.
pub type Growth = { param: Int, ty: Bytes }

/// A call that fills `callee`'s type parameters: those it fills with a type built from the
/// caller's own.
pub type Fill = { module: Int, span: Span, callee: Bytes, grows: List<Growth> }

/// What a name a body reads refers to, `module` empty where it is written bare.
pub type NamedCallee = { module: Bytes, name: Bytes, callee: Callee }

/// What the walk of the function `name` leaves its group beside what its signature says, as
/// another check reads it: what it performs with each label parameter of the definition named by
/// its place (`filed_atoms`), `through` where it performs what its row parameter stands for too,
/// and each place as the check that walked it counted it.
pub type WalkedBody = {
  name: Bytes,
  atoms: List<Atom>,
  through: Bool,
  performs: List<PerformSite>,
  repeated: List<RepeatedRow>,
  raise_notes: List<RaiseNote>,
  refs: List<Bytes>,
  calls: List<OwnCall>,
  stated: List<OwnCall>,
  tags: List<TagRefusal>,
  fills: List<Fill>,
  names: List<NamedCallee>,
}

derive bin for PerformSource
derive bin for Maybe
derive bin for PerformSite
derive bin for RepeatedRow
derive bin for RaiseNote
derive bin for OwnCall
derive bin for TagRefusal
derive bin for Growth
derive bin for Fill
derive bin for NamedCallee
derive bin for WalkedBody

/// `b` with each place in it moved through `by`, read as module `module` of a check.
pub fn moved_body(b: WalkedBody, module: Int, by: (Int) -> Int) -> WalkedBody = {
  let at = |s: Span| { ..s, start: by(s.start), end: by(s.end) };
  let over = |o: Option<Span>| match o { Some(s) -> Some(at(s)), None -> None };
  let waits = |ms: List<Maybe>| ms.map(|m: Maybe| { ..m, span: at(m.span) });
  let call = |c: OwnCall| { ..c, span: at(c.span) };
  {
    ..b,
    performs: b.performs.map(|s: PerformSite|
      { ..s, module: module, span: at(s.span), over: over(s.over), maybe: waits(s.maybe) }),
    repeated: b.repeated.map(|r: RepeatedRow| { ..r, over: over(r.over), maybe: waits(r.maybe) }),
    raise_notes: b.raise_notes.map(|n: RaiseNote| { ..n, span: at(n.span) }),
    calls: b.calls.map(call),
    stated: b.stated.map(call),
    tags: b.tags.map(|t: TagRefusal|
      {
        ..t,
        refusal: {
          ..t.refusal,
          labels: t.refusal.labels.map(|l: Label|
            { ..l, module: module, start: by(l.start), end: by(l.end) }),
        },
      }),
    fills: b.fills.map(|f: Fill| { ..f, module: module, span: at(f.span) }),
  }
}

/// A module's functions in the order it writes them, each with its qualified name, what its group
/// reads of its generic list and its body.
type ModuleFns = {
  fns: List<FnDef>,
  names: List<Bytes>,
  members: List<GroupDef>,
  bodies: List<Body>,
  /// What each call on a value in the module calls, by the call's span.
  written: Map<Bytes, MemberCallee>,
}

/// The sites of a body an operator, a comparison, a `Map` or a constraint is read at.
type TypedSites = {
  numerics: List<Numeric>,
  comparisons: List<{ module: Int, span: Span, ty: Type }>,
  map_keys: List<MapKeySite>,
  constrained: List<ConstraintSite>,
}

/// What a module's type states: its key, its show and its arithmetic in `numeric_ops`' order, each
/// a function of the module by its qualified name.
type StatedFns = { key: Option<Bytes>, show: Option<Bytes>, numeric: List<Bytes> }

type Reached = { seen: List<Bytes>, fns: List<Bytes> }

/// What a group member performs a number of times that grows with its input: its atoms, the sites a
/// walk of its body found them at, and the parameters it calls so.
type Count = {
  scaling: List<Atom>,
  sites: List<PerformSite>,
  repeats: List<Int>,
  tail_over: Option<Span>,
  recursed: Option<Span>,
  raises: List<Raise>,
}

type Generalized = { env: TypeEnv, scheme: Scheme }

fn cell() -> Bytes = b"cell"

/// The effect of reading a hold, which a `with_hold` region answers.
fn hold() -> Bytes = b"hold"

/// A read of the hold a region labelled `resource` holds.
fn hold_atom(resource: Resource) -> Atom =
  { effect: hold(), resource: resource, mode: MRead, op: None }

/// The effects a region answers and nothing declares.
fn is_region_effect(name: Bytes) -> Bool = name == cell() || name == hold()

/// A cell or a hold: each carries the region that made it as a first, unwritten argument.
fn is_region_type(name: Bytes) -> Bool = name == b"Cell" || name == b"Hold"
fn compare_values_name() -> Bytes = b"compare_values"
fn result_name() -> Bytes = b"result"

fn location_of(checker: Checker, span: Span) -> Location = { module: checker.module, span: span }

fn module_name(checker: Checker, i: Int) -> Bytes / {abort.raise} = checker.modules.get(i).name

fn scope_of(checker: Checker) -> Scope / {abort.raise} = checker.resolved.scopes.get(checker.module)

fn report(checker: Checker, diag: Diag) -> Checker = { ..checker, diags: checker.diags.push(diag) }

fn report_error_at(
  checker: Checker,
  code: Bytes,
  span: Span,
  message: Bytes,
  label: Bytes,
  notes: List<Bytes>,
) -> Checker = report(checker, error_at(code, checker.module, span, message, label, notes))

fn report_error_at_and(
  checker: Checker,
  code: Bytes,
  span: Span,
  message: Bytes,
  label: Bytes,
  also: Location,
  also_text: Bytes,
  notes: List<Bytes>,
) -> Checker =
  report(
    checker,
    error_at_and(
      code,
      checker.module,
      span,
      message,
      label,
      also.module,
      also.span,
      also_text,
      notes,
    ),
  )

fn err_labels(
  checker: Checker,
  code: Bytes,
  message: Bytes,
  labels: List<Label>,
  notes: List<Bytes>,
) -> Checker = report(checker, error_with_labels(code, message, labels, notes))

fn backticked_text(x: Bytes) -> Bytes = Bytes::concat_all([b"`", x, b"`"])

fn plural(n: Int) -> Bytes = if n == 1 { b"" } else { b"s" }

fn supplied(n: Int) -> Bytes =
  if n == 1 { b"1 was supplied" } else { ascii_of_int(n).concat(b" were supplied") }

fn what_of(deriver: Deriver) -> Bytes =
  match deriver {
    DJson -> b"JSON encoding",
    DEq -> b"structural equality",
    DOrd -> b"order",
    DBin -> b"binary encoding",
    DShow -> b"rendering",
    DHash -> b"content hash",
    DNumeric -> b"arithmetic",
    DInteger -> b"integer arithmetic",
    DRow -> b"row",
  }

fn row_aliases(def: FnDef) -> List<Bytes> =
  match def.effects { Some(r) -> r.aliases.map(|qname: QName| qname.name.name), None -> [] }

// --- Fresh variables, threaded ---------------------------------------------------------

fn new_ty(checker: Checker) -> { checker: Checker, ty: Type } = {
  let o = fresh_ty(checker.fresh);
  { checker: { ..checker, fresh: o.fresh }, ty: o.ty }
}
fn new_ty_var(checker: Checker) -> { checker: Checker, var: Int } = {
  let o = fresh_ty_var(checker.fresh);
  { checker: { ..checker, fresh: o.fresh }, var: o.var }
}
fn new_row(checker: Checker) -> { checker: Checker, row: Row } = {
  let o = fresh_row(checker.fresh);
  { checker: { ..checker, fresh: o.fresh }, row: o.row }
}
fn new_row_var(checker: Checker) -> { checker: Checker, var: Int } = {
  let o = fresh_row_var(checker.fresh);
  { checker: { ..checker, fresh: o.fresh }, var: o.var }
}

fn resolve(checker: Checker, ty: Type) -> Type / {abort.raise} = resolve_ty(checker.subst, ty)
fn resolve_row_in(checker: Checker, row: Row) -> Row / {abort.raise} =
  resolve_row(checker.subst, row)

fn with_unified(checker: Checker, unified: Unified) -> Checker =
  { ..checker, subst: unified.subst, fresh: unified.fresh }

// --- The prelude ----------------------------------------------------------------------

fn prelude_effect_names() -> List<Bytes> =
  [b"task", b"clock", b"random", b"sim", b"abort", b"diverges"]
pub fn is_prelude_effect(name: Bytes) -> Bool = prelude_effect_names().contains(name)
fn simulated_names() -> List<Bytes> = [b"task", b"clock", b"random"]

fn seed_atom() -> Atom = { effect: b"sim", resource: RSingleton, mode: MRead, op: None }

pub fn abort_atom() -> Atom =
  { effect: b"abort", resource: RSingleton, mode: MRaise, op: Some(b"raise") }

fn abort_row() -> Row = row_singleton(abort_atom())

fn builtin_type_arities() -> List<{ name: Bytes, arity: Int }> =
  [
    { name: b"Int", arity: 0 },
    { name: b"Bool", arity: 0 },
    { name: b"String", arity: 0 },
    { name: b"Bytes", arity: 0 },
    { name: b"U8", arity: 0 },
    { name: b"U16", arity: 0 },
    { name: b"U32", arity: 0 },
    { name: b"U64", arity: 0 },
    { name: b"I8", arity: 0 },
    { name: b"I16", arity: 0 },
    { name: b"I32", arity: 0 },
    { name: b"I64", arity: 0 },
    { name: b"U128", arity: 0 },
    { name: b"I128", arity: 0 },
    { name: b"Float", arity: 0 },
    { name: b"Decimal", arity: 0 },
    { name: b"Char", arity: 0 },
    { name: b"Unit", arity: 0 },
    { name: b"List", arity: 1 },
    { name: b"Array", arity: 1 },
    { name: b"Columns", arity: 1 },
    { name: b"Map", arity: 2 },
    { name: b"Cell", arity: 1 },
    { name: b"Hold", arity: 1 },
    { name: b"Secret", arity: 1 },
    { name: b"Task", arity: 1 },
    { name: b"Chan", arity: 1 },
    { name: b"Option", arity: 1 },
    { name: b"Result", arity: 2 },
    { name: b"Ordering", arity: 0 },
    { name: b"Rounding", arity: 0 },
    { name: b"Iter", arity: 2 },
    { name: b"Instant", arity: 0 },
    { name: b"Duration", arity: 0 },
  ]

/// Pure and nullary, so the runtime builds it once and each type conversion only looks a name up.
fn builtin_type_arity_map() -> Map<Bytes, Int> =
  builtin_type_arities().fold(Map::new(), |acc: Map<Bytes, Int>, x: { name: Bytes, arity: Int }|
    if acc.contains(x.name) { acc } else { acc.insert(x.name, x.arity) })

fn builtin_type_arity(name: Bytes) -> Option<Int> = builtin_type_arity_map().get(name)

/// A field names one of `params`, or else a builtin type.
type AlgebraicType = {
  name: Bytes,
  params: List<Bytes>,
  variants: List<{ name: Bytes, fields: List<Bytes> }>,
}

fn prelude_adts() -> List<AlgebraicType> =
  [
    {
      name: b"Option",
      params: [b"a"],
      variants: [{ name: b"None", fields: [] }, { name: b"Some", fields: [b"a"] }],
    },
    {
      name: b"Result",
      params: [b"a", b"e"],
      variants: [{ name: b"Ok", fields: [b"a"] }, { name: b"Err", fields: [b"e"] }],
    },
    {
      name: b"Ordering",
      params: [],
      variants: [
        { name: b"Less", fields: [] },
        { name: b"Equal", fields: [] },
        { name: b"Greater", fields: [] },
      ],
    },
    {
      name: b"Rounding",
      params: [],
      variants: [
        { name: b"HalfEven", fields: [] },
        { name: b"HalfUp", fields: [] },
        { name: b"Down", fields: [] },
        { name: b"Up", fields: [] },
        { name: b"Ceiling", fields: [] },
        { name: b"Floor", fields: [] },
      ],
    },
    {
      name: b"Iter",
      params: [b"s", b"r"],
      variants: [{ name: b"Continue", fields: [b"s"] }, { name: b"Stop", fields: [b"r"] }],
    },
    // Nanoseconds: a point on a clock, and a span between two points, kept apart by their types.
    { name: b"Instant", params: [], variants: [{ name: b"Instant", fields: [b"Int"] }] },
    { name: b"Duration", params: [], variants: [{ name: b"Duration", fields: [b"Int"] }] },
  ]

fn position_bytes(xs: List<Bytes>, v: Bytes) -> Int / {abort.raise} =
  range(0, xs.len()).fold(0 - 1, |acc: Int, i: Int|
    if acc >= 0 { acc } else if xs.get(i) == v { i } else { acc })

fn install_prelude_adts(checker: Checker) -> Checker / {abort.raise} =
  prelude_adts().fold(checker, |c: Checker, adt: AlgebraicType| {
    let vars = range(0, adt.params.len());
    let result = TyCon({ name: adt.name, args: vars.map(|v: Int| TyVar(v)) });
    range(0, adt.variants.len()).fold(c, |c2: Checker, index: Int| {
      let v = adt.variants.get(index);
      let fields = v.fields.map(|p: Bytes| {
        let at = position_bytes(adt.params, p);
        if at >= 0 { TyVar(at) } else { named_type(p) }
      });
      let ty = if fields.len() == 0 { result } else { fn_type(fields, result, row_empty()) };
      let sc = { ty_vars: vars, row_vars: [], label_vars: [], ty: ty };
      add_ctor({ ..c2, env: env_bind_global(c2.env, v.name, sc) }, {
        name: v.name,
        module: b"",
        simple_name: v.name,
        type_name: adt.name,
        index: index,
        arity: fields.len(),
        fields: fields,
        scheme: sc,
        at: { module: 0, span: dummy_span() },
      })
    })
  })

fn add_ctor(checker: Checker, info: CtorInfo) -> Checker =
  {
    ..checker,
    ctors: checker.ctors.push(info),
    ctor_index: checker.ctor_index.insert(info.name, checker.ctors.len()),
  }

fn ctor_of(checker: Checker, name: Bytes) -> Option<CtorInfo> / {abort.raise} =
  match checker.ctor_index.get(name) { Some(i) -> Some(checker.ctors.get(i)), None -> None }

fn add_effect(checker: Checker, info: EffectInfo) -> Checker =
  {
    ..checker,
    effects: checker.effects.push(info),
    effect_index: checker.effect_index.insert(info.name, checker.effects.len()),
  }

fn effect_of(checker: Checker, name: Bytes) -> Option<EffectInfo> / {abort.raise} =
  match checker.effect_index.get(name) { Some(i) -> Some(checker.effects.get(i)), None -> None }

fn def_of(checker: Checker, name: Bytes) -> Option<DefInfo> / {abort.raise} =
  match checker.def_index.get(name) { Some(i) -> Some(checker.defs.get(i)), None -> None }

fn set_def(checker: Checker, info: DefInfo) -> Checker / {abort.raise} =
  match checker.def_index.get(info.name) {
    Some(i) -> { ..checker, defs: checker.defs.set(i, info) },
    None ->
      {
        ..checker,
        defs: checker.defs.push(info),
        def_index: checker.def_index.insert(info.name, checker.defs.len()),
      },
  }

fn prelude_op(
  name: Bytes,
  mode: Mode,
  ty_vars: List<Int>,
  row_vars: List<Int>,
  params: List<Type>,
  ret: Type,
  row: Row,
) -> OpInfo =
  {
    name: name,
    mode: mode,
    resource_param: false,
    params: params,
    ret: ret,
    at: { module: 0, span: dummy_span() },
    scheme: Some({
      ty_vars: ty_vars,
      row_vars: row_vars,
      label_vars: [],
      ty: fn_type(params, ret, row),
    }),
  }

fn pair_type(first: Type, second: Type) -> Type =
  TyRecord([{ name: b"_0", ty: first }, { name: b"_1", ty: second }])

/// The operations whose place in a closure's row shows a channel it captured.
fn channel_ops() -> List<Bytes> = [b"send", b"recv", b"close", b"select"]

pub fn prelude_effects() -> List<EffectInfo> = {
  let ta = TyVar(0);
  let body = fn_type([], ta, row_open(0));
  let task = applied_type(b"Task", ta);
  let chan = applied_type(b"Chan", ta);
  let none = { module: 0, span: dummy_span() };
  [
    {
      name: b"task",
      module: b"",
      simple_name: b"task",
      nondet: true,
      at: none,
      ops: [
        prelude_op(b"spawn", MWrite, [0], [0], [body], task, row_open(0)),
        // A join of a cancelled task raises; `await` answers `None` for one.
        prelude_op(b"join", MWrite, [0], [], [task], ta, abort_row()),
        prelude_op(b"yield", MWrite, [], [], [], unit_type(), row_empty()),
        // Stops a task where it stands; `true` when it had not yet ended.
        prelude_op(b"cancel", MWrite, [0], [], [task], bool_type(), row_empty()),
        // A join that answers `None` for a cancelled task.
        prelude_op(b"await", MWrite, [0], [], [task], option_type(ta), row_empty()),
        prelude_op(b"channel", MWrite, [0], [], [int_type()], chan, row_empty()),
        // `false` once the channel is closed.
        prelude_op(b"send", MWrite, [0], [], [chan, ta], bool_type(), row_empty()),
        // `None` once the channel is closed and empty.
        prelude_op(b"recv", MWrite, [0], [], [chan], option_type(ta), row_empty()),
        prelude_op(b"close", MWrite, [0], [], [chan], unit_type(), row_empty()),
        // An arm is a channel beside `Some` of what to send on it, or `None` to receive; the
        // answer is the arm that went beside what it took or sent, `None` for a closed channel.
        prelude_op(
          b"select",
          MWrite,
          [0],
          [],
          [list_type(pair_type(chan, option_type(ta))), bool_type()],
          option_type(pair_type(int_type(), option_type(ta))),
          row_empty(),
        ),
      ],
    },
    {
      name: b"clock",
      module: b"",
      simple_name: b"clock",
      nondet: true,
      at: none,
      ops: [
        prelude_op(b"now", MRead, [], [], [], named_type(b"Instant"), row_empty()),
        prelude_op(b"sleep", MWrite, [], [], [named_type(b"Duration")], unit_type(), row_empty()),
      ],
    },
    {
      name: b"random",
      module: b"",
      simple_name: b"random",
      nondet: true,
      at: none,
      ops: [
        prelude_op(b"next", MWrite, [], [], [], int_type(), row_empty()),
        prelude_op(b"below", MWrite, [], [], [int_type()], int_type(), row_empty()),
      ],
    },
    {
      name: b"sim",
      module: b"",
      simple_name: b"sim",
      nondet: false,
      at: none,
      ops: [prelude_op(b"seed", MRead, [], [], [], int_type(), row_empty())],
    },
    {
      name: b"abort",
      module: b"",
      simple_name: b"abort",
      nondet: false,
      at: none,
      ops: [prelude_op(b"raise", MRaise, [0], [], [string_type()], ta, row_empty())],
    },
    // Divergence names no operation: nothing performs it, and nothing handles it.
    { name: b"diverges", module: b"", simple_name: b"diverges", nondet: false, at: none, ops: [] },
  ]
}

fn simulated_atoms() -> List<Atom> / {abort.raise} =
  prelude_effects().fold([], |acc: List<Atom>, effect_info: EffectInfo|
    if simulated_names().contains(effect_info.name) {
      effect_info.ops.fold(acc, |atoms: List<Atom>, op_info: OpInfo|
        atoms_insert(atoms, {
          effect: effect_info.name,
          resource: RSingleton,
          mode: op_info.mode,
          op: None,
        }))
    } else { acc })

// --- The prelude's functions -------------------------------------------------------------------

/// A function the prelude declares: its scheme, the names its declaration gives its parameters, the
/// lines of its doc, and what a call must show of the types it fixes.
pub type Builtin = {
  name: Bytes,
  scheme: Scheme,
  params: List<Bytes>,
  doc: List<Bytes>,
  constraints: List<DefConstraint>,
  /// Each `requires` and `ensures` as the prelude writes it.
  clauses: List<Bytes>,
  /// The same as the checker reads them, a `requires` for each condition `&&` joins.
  contract: Contract,
}

/// What a declaration's types are read against: the variables its generic list binds, and the types
/// the prelude imports, each under the name its module declares it by.
type Declaring = {
  fresh: Fresh,
  tys: Map<Bytes, Type>,
  labels: Map<Bytes, Type>,
  rows: Map<Bytes, Int>,
  imported: Map<Bytes, Bytes>,
}

fn misdeclared(what: Bytes, name: Bytes) -> String =
  "the prelude " ++ String::of_bytes_lossy(what) ++ ": `" ++ String::of_bytes_lossy(name) ++ "`"

fn declared_types(
  d: Declaring,
  tys: List<TypeExpr>,
) -> { d: Declaring, tys: List<Type> } / {abort.raise} =
  tys.fold({ d: d, tys: [] }, |acc: { d: Declaring, tys: List<Type> }, ty: TypeExpr| {
    let o = declared_type(acc.d, ty);
    { d: o.d, tys: acc.tys.push(o.ty) }
  })

/// A type as a declaration writes it: the language's own, or one its module declares or imports by
/// name, at the arguments written. A cell's region is the call's to fix, so a declaration is generic
/// over it.
fn declared_type(d: Declaring, ty: TypeExpr) -> { d: Declaring, ty: Type } / {abort.raise} =
  match ty {
    TVar(id) -> match d.tys.get(id.name) {
      Some(t) -> { d: d, ty: t },
      None -> panic(misdeclared(b"names a type variable no generic list binds", id.name)),
    },
    TUnit(_) -> { d: d, ty: unit_type() },
    TBad(_) -> panic("the prelude does not parse"),
    TRecord(r) -> {
      let fs = r.fields.fold(
        { d: d, fs: [] },
        |acc: { d: Declaring, fs: List<Field> }, f: { name: Ident, ty: TypeExpr }| {
          let o = declared_type(acc.d, f.ty);
          { d: o.d, fs: acc.fs.push({ name: f.name.name, ty: o.ty }) }
        },
      );
      { d: fs.d, ty: TyRecord(fields_sorted(fs.fs)) }
    },
    TFn(f) -> {
      let ps = declared_types(d, f.params);
      let r = declared_type(ps.d, f.ret);
      { d: r.d, ty: fn_type(ps.tys, r.ty, declared_row(r.d, f.effects)) }
    },
    TCon(c) -> {
      let name = c.name.name.name;
      match d.tys.get(name) {
        Some(t) -> { d: d, ty: t },
        None -> match d.imported.get(name) {
          Some(full) -> {
            let args = declared_types(d, c.args);
            { d: args.d, ty: TyCon({ name: full, args: args.tys }) }
          },
          None -> {
            let args = declared_types(d, c.args);
            if builtin_type_arity(name) != Some(args.tys.len()) {
              panic(misdeclared(b"names a type that is not the language's own at that arity", name))
            } else if name == b"Hold" {
              match c.labels {
                [l] -> match args.d.labels.get(l.name) {
                  Some(label) ->
                    { d: args.d, ty: TyCon({ name: name, args: [label, args.tys.get(0)] }) },
                  None -> panic(misdeclared(b"names a label no generic list binds", l.name)),
                },
                _ -> panic(misdeclared(b"names a hold without its region's label", name)),
              }
            } else if is_region_type(name) {
              let region = fresh_ty(args.d.fresh);
              {
                d: { ..args.d, fresh: region.fresh },
                ty: TyCon({ name: name, args: [region.ty, args.tys.get(0)] }),
              }
            } else { { d: args.d, ty: TyCon({ name: name, args: args.tys }) } }
          },
        },
      }
    },
  }

/// A declaration's row: `abort.raise`, a `hold.read` of a label it binds, a row variable, or none of them.
fn declared_row(d: Declaring, row: Option<RowExpr>) -> Row / {abort.raise} =
  match row {
    None -> row_empty(),
    Some(r) ->
      {
        atoms: r.atoms.fold([], |acc: List<Atom>, a: AtomExpr|
          if is_bare(a.eff) && a.eff.name.name == b"abort"
              && (match a.op { Some(op) -> op.name == b"raise", None -> false }) {
            atoms_insert(acc, abort_atom())
          } else if is_bare(a.eff) && a.eff.name.name == hold()
              && (match a.op { Some(_) -> false, None -> mode_eq(a.mode, MRead) }) {
            match a.resource {
              Some(l) -> match d.labels.get(l.name) {
                Some(TyVar(v)) -> atoms_insert(acc, hold_atom(RVar(v))),
                _ ->
                  panic(misdeclared(b"reads a hold under a label no generic list binds", l.name)),
              },
              None -> panic(misdeclared(b"reads a hold without its region's label", hold())),
            }
          } else {
            panic(misdeclared(b"performs more than `abort.raise` and `hold.read`", a.eff.name.name))
          }),
        tail: match r.tail {
          None -> None,
          Some(v) -> match d.rows.get(v.name) {
            Some(var) -> Some(var),
            None -> panic(misdeclared(b"names a row variable no generic list binds", v.name)),
          },
        },
      },
  }

/// Each type the prelude imports by name, under the name its module declares it by.
fn prelude_imports(imports: List<ImportDecl>) -> Map<Bytes, Bytes> =
  imports.fold(Map::new(), |acc: Map<Bytes, Bytes>, decl: ImportDecl|
    match decl.kind {
      INames(names) -> {
        let module = decl.path.fold(b"", |path: Bytes, segment: Ident|
          Bytes::concat_all([path, segment.name, b"."]));
        names.fold(acc, |m: Map<Bytes, Bytes>, n: Ident| m.insert(n.name, module.concat(n.name)))
      },
      _ -> acc,
    })

/// The conditions `&&` joins, each with the text it is written as.
fn conjuncts(def: ExternDef, e: Expr) -> List<Clause> / {abort.raise} =
  match e {
    EBinary(b) -> if b.op != b"and" { [written_clause(def, e)] }
    else { conjuncts(def, b.lhs).concat(conjuncts(def, b.rhs)) },
    _ -> [written_clause(def, e)],
  }

fn written_clause(def: ExternDef, e: Expr) -> Clause / {abort.raise} =
  { holds: e, text: written_at(def, expr_span(e)) }

/// What `span`, inside the declaration, is written as.
fn written_at(def: ExternDef, span: Span) -> Bytes / {abort.raise} =
  def.written.slice(span.start - def.span.start, span.end - def.span.start)

/// What a call's answer is a function of: no parameter is a function or a cell.
fn answers_by_value(params: List<Type>) -> Bool =
  params.fold(true, |ok: Bool, ty: Type|
    ok && (match ty { TyFn(_) -> false, TyCon(c) -> c.name != b"Cell", _ -> true }))

fn contract_of(
  def: ExternDef,
  params: List<Type>,
  ret: Type,
  row: Row,
) -> Contract / {abort.raise} =
  {
    params: def.params.map(|p: Param| p.name.name),
    requires: def.spec.fold([], |acc: List<Clause>, c: SpecClause|
      match c.kind {
        SRequires -> acc.concat(conjuncts(def, c.expr)),
        SEnsures -> acc,
        SCost -> panic(misdeclared(b"states a `cost`", def.name.name)),
        SSpace -> panic(misdeclared(b"states a `space`", def.name.name)),
      }),
    ensures: def.spec.fold([], |acc: List<Clause>, c: SpecClause|
      match c.kind { SEnsures -> acc.push(written_clause(def, c.expr)), _ -> acc }),
    raises: row.atoms.contains(abort_atom()),
    pure: answers_by_value(params),
    number: ret == int_type(),
    like: match ret {
      TyVar(v) ->
        range(0, params.len()).fold(None, |acc: Option<Int>, i: Int|
          match acc {
            Some(_) -> acc,
            None -> if params.get(i) == TyVar(v) { Some(i) } else { None },
          }),
      _ -> None,
    },
  }

fn declared(name: Bytes, imported: Map<Bytes, Bytes>, def: ExternDef) -> Builtin / {abort.raise} = {
  let tys = def.generics.types.fold(
    { fresh: fresh_new(), tys: Map::new() },
    |acc: { fresh: Fresh, tys: Map<Bytes, Type> }, p: Ident| {
      let o = fresh_ty(acc.fresh);
      { fresh: o.fresh, tys: acc.tys.insert(p.name, o.ty) }
    },
  );
  // A label a declaration binds is what an argument's type fixes, so it is a variable like the rest.
  let labels = def.generics.labels.fold(
    { fresh: tys.fresh, tys: Map::new() },
    |acc: { fresh: Fresh, tys: Map<Bytes, Type> }, p: Ident| {
      let o = fresh_ty(acc.fresh);
      { fresh: o.fresh, tys: acc.tys.insert(p.name, o.ty) }
    },
  );
  let rows = def.generics.effects.fold(
    { fresh: labels.fresh, rows: Map::new() },
    |acc: { fresh: Fresh, rows: Map<Bytes, Int> }, p: Ident| {
      let o = fresh_row_var(acc.fresh);
      { fresh: o.fresh, rows: acc.rows.insert(p.name, o.var) }
    },
  );
  let params = declared_types(
    { fresh: rows.fresh, tys: tys.tys, labels: labels.tys, rows: rows.rows, imported: imported },
    def.params.map(|p: Param|
      match p.ty {
        Some(t) -> t,
        None -> panic(misdeclared(b"leaves a parameter untyped", p.name.name)),
      }),
  );
  let ret = declared_type(params.d, def.ret);
  let row = declared_row(ret.d, def.effects);
  let found = def.constraints.fold([], |acc: List<DefConstraint>, c: Constraint| {
    let param = range(0, def.generics.types.len()).fold(0 - 1, |p: Int, i: Int|
      if p >= 0 { p } else if def.generics.types.get(i).name == c.param.name { i } else { p });
    if param < 0 { panic(misdeclared(b"constrains what no generic list binds", c.param.name)) }
    else { insert_constraint(acc, { deriver: c.deriver, param: param }) }
  });
  {
    name: name,
    scheme: {
      ty_vars: range(0, ret.d.fresh.next_ty),
      row_vars: range(0, ret.d.fresh.next_row),
      label_vars: [],
      ty: fn_type(params.tys, ret.ty, row),
    },
    params: def.params.map(|p: Param| p.name.name),
    doc: match def.doc { Some(d) -> d.lines, None -> [] },
    constraints: dedup_constraints(found),
    clauses: def.spec.map(|c: SpecClause| written_at(def, c.span)),
    contract: contract_of(def, params.tys, ret.ty, row),
  }
}

/// Every function the prelude declares, in its order. Pure and nullary, so the runtime reads the
/// prelude once.
pub fn builtins() -> List<Builtin> / {abort.raise} = {
  let source = prelude_source::text();
  let parsed = parse(source);
  if parsed.parser.diags.len() > 0 { panic("the prelude does not parse") } else {
    let imported = prelude_imports(parsed.node.imports);
    parsed.node.items.fold([], |acc: List<Builtin>, item: Item|
      match item { IExtern(def) -> acc.push(declared(def.name.name, imported, def)), _ -> acc })
  }
}

pub fn builtin_named(name: Bytes) -> Option<Builtin> / {abort.raise} =
  builtins().fold(None, |acc: Option<Builtin>, b: Builtin|
    match acc { Some(_) -> acc, None -> if b.name == name { Some(b) } else { None } })

/// A builtin's scheme is over variables numbered from zero, so `fresh` starts past every one.
fn install_prelude(bare: Checker) -> Checker / {abort.raise} = {
  let bound: Checker = builtins().fold(install_prelude_adts(bare), builtin_bound);
  prelude_effects().fold(bound, |c2: Checker, effect_info: EffectInfo| add_effect(c2, effect_info))
}

/// The name the shipped modules hold the prelude under, which no project's module can take.
fn prelude_module() -> Bytes = b"compiler.prelude"

/// Only a shipped module declares what the toolchain implements.
fn refuse_externs(checker: Checker, parsed: ParsedModule) -> Checker =
  List::fold(
    if is_shipped(parsed.name) { [] } else { parsed.module.items },
    checker,
    |c: Checker, item: Item|
      match item {
        IExtern(def) ->
          report_error_at(
            c,
            b"E0151",
            def.name.span,
            Bytes::concat_all([
              b"`extern fn ",
              def.name.name,
              b"` declares a function the runtime implements",
            ]),
            b"only a module the toolchain ships declares one",
            [
              b"the toolchain implements the functions its own modules declare and nothing else, so a declaration here has nothing to name",
              b"write the function's body, or reach what it needs through an `effect` a handler answers",
            ],
          ),
        _ -> c,
      },
  )

// --- Names ------------------------------------------------------------------------------

type ValueKey = { name: Bytes, prelude: Bool }

/// A bare name through this module's scope, a qualified one through the resolver.
fn global(
  checker: Checker,
  namespace: Namespace,
  qname: QName,
) -> { checker: Checker, name: Option<Bytes> } / {abort.raise} =
  if is_bare(qname) {
    match lookup(scope_of(checker).bound, namespace, qname.name.name) {
      Some(b) -> { checker: checker, name: Some(b.qualified) },
      None -> { checker: checker, name: None },
    }
  } else {
    match find(checker.resolved, checker.module, namespace, qname) {
      Some(b) -> { checker: checker, name: Some(b.qualified) },
      None ->
        {
          checker: match checker.derived {
            Some(_) ->
              unresolved_in_derived(checker, qname, match namespace {
                TypeSpace -> b"type",
                _ -> b"definition",
              }),
            None -> lookup_failure(checker, namespace, qname),
          },
          name: None,
        },
    }
  }

/// A name a generated body cannot see is the field type's missing `derive`, not the user's bug.
fn unresolved_in_derived(checker: Checker, qname: QName, what: Bytes) -> Checker / {abort.raise} =
  report(checker, derived_unresolved(checker, qname, what))

fn derived_unresolved(checker: Checker, qname: QName, what: Bytes) -> Diag / {abort.raise} = {
  let d = match checker.derived {
    Some(d) -> d,
    None -> panic("only a generated body reaches this"),
  };
  let dv = deriver_text(d.deriver);
  error_at(
    b"E0206",
    checker.module,
    qname.span,
    Bytes::concat_all([b"`", dv, b"` cannot be derived for `", d.target, b"`"]),
    Bytes::concat_all([
      b"the generated body needs the ",
      what,
      b" `",
      qname_text(qname),
      b"`, which is not in scope",
    ]),
    [
      Bytes::concat_all([
        b"a derivation composes through named types by calling their own dictionaries, so every field type needs `derive ",
        dv,
        b" for` it in the module that declares it",
      ]),
      Bytes::concat_all([
        b"`",
        qname_text(qname),
        b"` is what `derive ",
        dv,
        b" for <that type>` generates",
      ]),
    ],
  )
}

fn lookup_failure(checker: Checker, namespace: Namespace, qname: QName) -> Checker / {abort.raise} =
  match qname.module {
    None -> checker,
    Some(binder) -> if namespace == ValueSpace
        && declaring_type(checker.resolved, checker.module, binder.name) != None {
      no_function_of(checker, binder.name, qname.name)
    } else {
      let scope = scope_of(checker);
      match scope.modules.fold(
          None,
          |acc: Option<Int>, binding: { binder: Bytes, target: Int, span: Span }|
            match acc {
              Some(_) -> acc,
              None -> if binding.binder == binder.name { Some(binding.target) } else { None },
            },
        ) {
        // One note either way, plus a secondary when a selective import bound it.
        None -> {
          let selective = scope.selective.fold(
            None,
            |acc: Option<{ binder: Bytes, target: Int, span: Span }>, binding: { binder: Bytes, target: Int, span: Span }|
              match acc {
                Some(_) -> acc,
                None -> if binding.binder == binder.name { Some(binding) } else { None },
              },
          );
          let message = Bytes::concat_all([b"no module is imported as `", binder.name, b"`"]);
          let label = b"not a module imported by this file";
          match selective {
            Some(sel) -> {
              let module = checker.resolved.scopes.get(sel.target).module;
              err_labels(
                checker,
                b"E0106",
                message,
                [
                  label_at(checker.module, binder.span, true, label),
                  label_at(
                    checker.module,
                    sel.span,
                    false,
                    Bytes::concat_all([b"this import brings in names from `", module, b"`"]),
                  ),
                ],
                [
                  Bytes::concat_all([
                    b"a selective import binds no module name: add `import ",
                    module,
                    b"` as well, or write `",
                    qname.name.name,
                    b"` unqualified",
                  ]),
                ],
              )
            },
            None -> {
              // A module of the program named like the binder, else what this file does import.
              let candidate = checker.resolved.names.fold(
                None,
                |acc: Option<Bytes>, e: ModuleEntry|
                  match acc {
                    Some(_) -> acc,
                    None -> if e.name == binder.name || default_binder(e.name) == binder.name {
                      Some(e.name)
                    } else { None },
                  },
              );
              let note = match candidate {
                Some(name) ->
                  Bytes::concat_all([
                    b"`",
                    name,
                    b"` is a module in this program: add `import ",
                    name,
                    b"` above the first item",
                  ]),
                None -> {
                  let imported = scope.modules.filter(written_binder);
                  if imported.len() == 0 {
                    Bytes::concat_all([
                      b"`",
                      scope.module,
                      b"` imports no modules; add `import <module>` above the first item",
                    ])
                  } else {
                    b"modules imported here: ".concat(
                      backticked(imported.map(|binding: ModuleBinding| binding.binder), b", "),
                    )
                  }
                },
              };
              report_error_at(checker, b"E0106", binder.span, message, label, [note])
            },
          }
        },
        Some(owner) -> {
          let decls = checker.resolved.declarations.get(owner);
          let module = checker.resolved.scopes.get(owner).module;
          match lookup_declared(decls, namespace, qname.name.name) {
            None -> {
              let exported = space(decls, namespace).fold(
                [],
                |acc: List<Bytes>, declared: Declared|
                  if declared.public { acc.push(declared.name) } else { acc },
              );
              report_error_at(
                checker,
                b"E0101",
                qname.span,
                Bytes::concat_all([
                  b"module `",
                  module,
                  b"` has no ",
                  describe_namespace(namespace),
                  b" `",
                  qname.name.name,
                  b"`",
                ]),
                Bytes::concat_all([b"not declared in `", module, b"`"]),
                [
                  if exported.len() == 0 {
                    Bytes::concat_all([
                      b"`",
                      module,
                      b"` exports no ",
                      describe_namespace(namespace),
                      b"s",
                    ])
                  } else {
                    Bytes::concat_all([b"`", module, b"` exports: ", backticked(exported, b", ")])
                  },
                ],
              )
            },
            Some(d) -> if !d.public {
              report(checker, match kept_ctor(checker, namespace, qname, [owner]) {
                Some(closed) -> closed,
                None ->
                  private_name(
                    checker.module,
                    qname.span,
                    owner,
                    d.span,
                    namespace,
                    qname.name.name,
                    module,
                  ),
              })
            } else { checker },
          }
        },
      }
    },
  }

fn value_key(
  checker: Checker,
  qname: QName,
) -> { checker: Checker, key: Option<ValueKey> } / {abort.raise} =
  if !is_bare(qname) {
    match of_language_type(checker, qname) {
      Found(m) ->
        { checker: checker, key: Some({ name: m.callee, prelude: m.qname.module == None }) },
      // A capital no import binds and no module declares is a type of the language's.
      Unnamed(of) -> { checker: no_function_of(checker, of.name, qname.name), key: None },
      Elsewise -> {
        let g: WithName = global(checker, ValueSpace, qname);
        match g.name {
          Some(n) -> { checker: g.checker, key: Some({ name: n, prelude: false }) },
          None -> { checker: g.checker, key: None },
        }
      },
    }
  } else {
    let name = qname.name.name;
    match env_depth_of(checker.env, name) {
      Some(depth) -> if depth > 0 {
        { checker: checker, key: Some({ name: name, prelude: false }) }
      } else { value_key_global(checker, qname) },
      None -> value_key_global(checker, qname),
    }
  }

/// What a name written `T::name` is where `T` is a type of the language's, one no import binds
/// as a module and no module in scope declares: its function so named, a builtin's `qname` with no
/// module, or none it has.
type OfLanguageType = | Found({ qname: QName, callee: Bytes }) | Unnamed(Ident) | Elsewise

fn of_language_type(checker: Checker, qname: QName) -> OfLanguageType / {abort.raise} =
  match qname.module {
    None -> Elsewise,
    Some(of) -> if !starts_upper(of.name) || of_module(of.name) != None
        || find_module_binding(scope_of(checker).modules, of.name) != None
        || declaring_type(checker.resolved, checker.module, of.name) != None { Elsewise } else {
      match language_function(checker, of.name, qname.name, false) {
        Some(m) -> Found(m),
        None -> Unnamed(of),
      }
    },
  }

fn value_key_global(
  checker: Checker,
  qname: QName,
) -> { checker: Checker, key: Option<ValueKey> } / {abort.raise} = {
  let name = qname.name.name;
  match lookup(scope_of(checker).bound, ValueSpace, name) {
    Some(b) -> { checker: checker, key: Some({ name: b.qualified, prelude: false }) },
    None -> match env_depth_of(checker.env, name) {
      Some(0) -> { checker: checker, key: Some({ name: name, prelude: true }) },
      _ -> { checker: unknown_name(checker, qname), key: None },
    },
  }
}

fn is_cell_builtin(name: Bytes) -> Bool =
  name == b"cell_get" || name == b"cell_set" || name == b"cell_update"

type CellForm = | CellGet | CellSet | CellUpdate

fn cell_form(checker: Checker, qname: QName) -> Option<CellForm> / {abort.raise} =
  if !is_bare(qname) { None }
  else if env_depth_of(checker.env, qname.name.name) != Some(0) { None } else {
    match lookup(scope_of(checker).bound, ValueSpace, qname.name.name) {
      Some(_) -> None,
      None -> if qname.name.name == b"cell_get" { Some(CellGet) }
      else if qname.name.name == b"cell_set" { Some(CellSet) }
      else if qname.name.name == b"cell_update" { Some(CellUpdate) }
      else { None },
    }
  }

fn declared_value(checker: Checker, qname: QName) -> Option<Bytes> / {abort.raise} =
  if is_bare(qname) {
    match lookup(scope_of(checker).bound, ValueSpace, qname.name.name) {
      Some(b) -> Some(b.qualified),
      None -> None,
    }
  } else {
    match find(checker.resolved, checker.module, ValueSpace, qname) {
      Some(b) -> Some(b.qualified),
      None -> None,
    }
  }

fn prelude_ctor(checker: Checker, qname: QName) -> Option<Bytes> / {abort.raise} =
  if is_bare(qname) {
    match ctor_of(checker, qname.name.name) { Some(_) -> Some(qname.name.name), None -> None }
  } else { None }

fn ctor_name(
  checker: Checker,
  qname: QName,
) -> { checker: Checker, name: Option<Bytes> } / {abort.raise} = {
  let g: WithName = global(checker, ValueSpace, qname);
  match g.name {
    Some(n) -> g,
    None -> { checker: g.checker, name: prelude_ctor(g.checker, qname) },
  }
}

fn covered_ctor(checker: Checker, qname: QName) -> Option<Bytes> / {abort.raise} =
  match declared_value(checker, qname) { Some(n) -> Some(n), None -> prelude_ctor(checker, qname) }

/// Another module that declares `name` publicly in `namespace`.
fn exporter(checker: Checker, namespace: Namespace, name: Bytes) -> Option<Int> / {abort.raise} =
  range(0, checker.resolved.declarations.len()).fold(None, |acc: Option<Int>, i: Int|
    match acc {
      Some(_) -> acc,
      None -> if i == checker.module { None } else {
        match lookup_declared(checker.resolved.declarations.get(i), namespace, name) {
          Some(d) -> if d.public { Some(i) } else { None },
          None -> None,
        }
      },
    })

/// The name in scope a slip of the hand makes `name` of: an edit for every three characters.
fn nearest_name(checker: Checker, name: Bytes) -> Option<Bytes> / {abort.raise} = {
  let written = String::of_bytes_lossy(name);
  let others = scope_of(checker).bound.values.map(|binding: Binding|
    String::of_bytes_lossy(binding.name)).filter(|other: String| other != written);
  match closest(written, others, name.len() / 3) {
    Some(near) -> Some(Bytes::of_string(near)),
    None -> None,
  }
}

/// The modules this one imports, whether by a binder or for some of their names.
fn imported(checker: Checker) -> List<Int> / {abort.raise} = {
  let scope = scope_of(checker);
  scope.selective.concat(scope.modules).map(|binding: ModuleBinding| binding.target)
}

/// What to say of a name that is a constructor one of `owners` keeps, its type being `opaque`.
fn kept_ctor(
  checker: Checker,
  namespace: Namespace,
  qname: QName,
  owners: List<Int>,
) -> Option<Diag> / {abort.raise} =
  match namespace {
    ValueSpace ->
      owners.fold(None, |found: Option<Diag>, owner: Int|
        match found {
          Some(_) -> found,
          None -> if owner == checker.module { None }
          else { closed_ctor(checker.modules, checker.module, qname.span, owner, qname.name.name) },
        }),
    _ -> None,
  }

fn unknown_name(checker: Checker, qname: QName) -> Checker / {abort.raise} =
  report(checker, unknown_name_said(checker, qname))

fn unknown_name_said(checker: Checker, qname: QName) -> Diag / {abort.raise} =
  match checker.derived {
    Some(_) -> derived_unresolved(checker, qname, b"definition"),
    None -> match kept_named(checker, qname) {
      Some(closed) -> closed,
      None -> unknown_name_here(checker, qname),
    },
  }

/// What to say of a name no scope binds where its type's module keeps it: a bare name's may be any
/// module imported here, a qualified one's is the module it names.
fn kept_named(checker: Checker, qname: QName) -> Option<Diag> / {abort.raise} =
  match qname.module {
    None -> kept_ctor(checker, ValueSpace, qname, imported(checker)),
    Some(binder) -> match find_module_binding(scope_of(checker).modules, binder.name) {
      Some(binding) -> kept_ctor(checker, ValueSpace, qname, [binding.target]),
      None -> None,
    },
  }

fn unknown_name_here(checker: Checker, qname: QName) -> Diag / {abort.raise} = {
  let n = qname.name.name;
  let result = if !is_bare(qname) || n != result_name() { [] } else {
    match checker.spec_kind {
      Some(SRequires) ->
        [
          b"`result` is bound only in an `ensures`: a precondition that could name the result would be a claim about a value the call has not produced yet",
        ],
      Some(SCost) ->
        [
          b"`result` is bound only in an `ensures`: a `cost` bound is over the parameters a call is given",
        ],
      Some(SSpace) ->
        [
          b"`result` is bound only in an `ensures`: a `space` bound is over the parameters a call is given",
        ],
      _ -> [],
    }
  };
  let near = match nearest_name(checker, n) {
    Some(x) -> result.push(Bytes::concat_all([b"a name in scope looks similar: `", x, b"`"])),
    None -> result,
  };
  let exported = if is_bare(qname) {
    match exporter(checker, ValueSpace, n) {
      Some(i) ->
        near.push(
          Bytes::concat_all([
            b"module `",
            module_name(checker, i),
            b"` exports it: add `import ",
            module_name(checker, i),
            b" (",
            n,
            b")`",
          ]),
        ),
      None -> near,
    }
  } else { near };
  error_at(
    b"E0101",
    checker.module,
    qname.span,
    Bytes::concat_all([b"unknown name `", n, b"`"]),
    b"not found in this scope",
    exported,
  )
}

// --- Types from type expressions ----------------------------------------------------------

fn type_param(checker: Checker, ident: Ident) -> { checker: Checker, ty: Type } =
  match checker.ty_params.get(ident.name) {
    Some(t) -> { checker: checker, ty: t },
    None -> if checker.auto_ty_params {
      let o: WithTy = new_ty(checker);
      {
        checker: { ..o.checker, ty_params: o.checker.ty_params.insert(ident.name, o.ty) },
        ty: o.ty,
      }
    } else {
      let o: WithTy = new_ty(
        report_error_at(
          checker,
          b"E0102",
          ident.span,
          Bytes::concat_all([b"unknown type variable `", ident.name, b"`"]),
          b"not declared",
          [
            Bytes::concat_all([
              b"add `",
              ident.name,
              b"` to the generic list, e.g. `fn f<",
              ident.name,
              b">(..)`",
            ]),
          ],
        ),
      );
      o
    },
  }

fn conv_type(checker: Checker, ty: TypeExpr) -> { checker: Checker, ty: Type } / {abort.raise} =
  conv_within(checker, ty, alias_room(checker))

/// How many more aliases a conversion may expand inside one another: an alias already being
/// expanded is refused, so each is a declared alias not yet on the stack.
fn alias_room(checker: Checker) -> Int = checker.types.len() - checker.alias_stack.len()

fn conv_within(
  checker: Checker,
  ty: TypeExpr,
  room: Int,
) -> { checker: Checker, ty: Type } / {abort.raise} =
  match ty {
    TVar(id) -> type_param(checker, id),
    TUnit(_) -> { checker: checker, ty: unit_type() },
    TBad(_) -> new_ty(checker),
    TRecord(r) -> {
      let fs = r.fields.fold(
        { checker: checker, fs: [] },
        |acc: { checker: Checker, fs: List<Field> }, f: { name: Ident, ty: TypeExpr }| {
          let o: WithTy = conv_within(acc.checker, f.ty, room);
          { checker: o.checker, fs: acc.fs.push({ name: f.name.name, ty: o.ty }) }
        },
      );
      { checker: fs.checker, ty: TyRecord(fields_sorted(fs.fs)) }
    },
    TFn(f) -> {
      let ps: WithTys = conv_all_within(checker, f.params, room);
      let r: WithTy = conv_within(ps.checker, f.ret, room);
      let eff = match f.effects {
        Some(row) -> conv_row(r.checker, row),
        None -> { checker: r.checker, row: row_empty() },
      };
      { checker: eff.checker, ty: fn_type(ps.tys, r.ty, eff.row) }
    },
    TCon(c) -> conv_con(checker, c.name, c.args, c.labels, c.rows, c.span, room),
  }

/// The label and row arguments a use of a declared type writes.
type Over = { labels: List<Type>, rows: List<Row> }

fn conv_over(
  checker: Checker,
  labels: List<Ident>,
  rows: List<RowExpr>,
) -> { checker: Checker, over: Over } / {abort.raise} = {
  let converted = rows.fold(
    { checker: checker, rows: [] },
    |acc: { checker: Checker, rows: List<Row> }, row: RowExpr| {
      let o = conv_row(acc.checker, row);
      { checker: o.checker, rows: acc.rows.push(o.row) }
    },
  );
  {
    checker: converted.checker,
    over: {
      // A name a binder holds is that label parameter, as it is inside a row; anything else is a resource.
      labels: labels.map(|label: Ident|
        match checker.label_params.get(label.name) {
          Some(v) -> TyVar(v),
          None -> label_type(label.name),
        }),
      rows: converted.rows,
    },
  }
}

/// A declaration's own label and row binders, each a fresh variable, in place of whatever was in
/// scope: a declared type is closed, so nothing in it names a parameter of the signature using it.
fn bind_own(
  checker: Checker,
  decl: TypeDecl,
) -> { checker: Checker, labels: List<Int>, rows: List<Int> } = {
  let closed: Checker = { ..checker, label_params: Map::new(), row_params: Map::new() };
  let labels = decl.labels.fold(
    { checker: closed, vars: [] },
    |acc: { checker: Checker, vars: List<Int> }, name: Bytes| {
      let o: WithVar = new_ty_var(acc.checker);
      {
        checker: { ..o.checker, label_params: o.checker.label_params.insert(name, o.var) },
        vars: acc.vars.push(o.var),
      }
    },
  );
  let rows = decl.rows.fold(
    { checker: labels.checker, vars: [] },
    |acc: { checker: Checker, vars: List<Int> }, name: Bytes| {
      let o: WithVar = new_row_var(acc.checker);
      {
        checker: { ..o.checker, row_params: o.checker.row_params.insert(name, o.var) },
        vars: acc.vars.push(o.var),
      }
    },
  );
  { checker: rows.checker, labels: labels.vars, rows: rows.vars }
}

fn conv_types(
  checker: Checker,
  tys: List<TypeExpr>,
) -> { checker: Checker, tys: List<Type> } / {abort.raise} =
  conv_all_within(checker, tys, alias_room(checker))

fn conv_all_within(
  checker: Checker,
  tys: List<TypeExpr>,
  room: Int,
) -> { checker: Checker, tys: List<Type> } / {abort.raise} =
  tys.fold(
    { checker: checker, tys: [] },
    |acc: { checker: Checker, tys: List<Type> }, ty: TypeExpr| {
      let o: WithTy = conv_within(acc.checker, ty, room);
      { checker: o.checker, tys: acc.tys.push(o.ty) }
    },
  )

/// `what` loses its `s` when one was expected.
fn arity_error(
  checker: Checker,
  span: Span,
  name: Bytes,
  expected: Int,
  found: Int,
  what: Bytes,
  notes: List<Bytes>,
) -> Checker / {abort.raise} = {
  let w = if expected == 1 { what.slice(0, what.len() - 1) } else { what };
  report_error_at(
    checker,
    b"E0202",
    span,
    Bytes::concat_all([
      b"`",
      name,
      b"` takes ",
      ascii_of_int(expected),
      b" ",
      w,
      b", but ",
      supplied(found),
    ]),
    Bytes::concat_all([b"expected ", ascii_of_int(expected), b", found ", ascii_of_int(found)]),
    notes,
  )
}

/// A use whose label or row arguments are not as many as the declaration binds, told of the first.
fn over_refused(
  checker: Checker,
  span: Span,
  name: Bytes,
  labels: Int,
  rows: Int,
  over: Over,
) -> Checker / {abort.raise} =
  if over.labels.len() != labels {
    arity_error(checker, span, name, labels, over.labels.len(), b"label arguments", [
      b"a label argument is bracketed among the type arguments, where a binder writes `[l]`: `T<a, [conn]>`",
    ])
  } else {
    arity_error(checker, span, name, rows, over.rows.len(), b"row arguments", [
      b"a row argument follows `|`, where a binder writes its row parameter: `T<a | {}>` holds functions that perform nothing",
    ])
  }

fn conv_con(
  checker: Checker,
  name: QName,
  args: List<TypeExpr>,
  labels: List<Ident>,
  rows: List<RowExpr>,
  span: Span,
  room: Int,
) -> { checker: Checker, ty: Type } / {abort.raise} =
  if is_bare(name) && args.len() == 0 && labels.len() == 0 && rows.len() == 0
      && checker.ty_params.contains(name.name.name) {
    {
      checker: checker,
      ty: match checker.ty_params.get(name.name.name) { Some(t) -> t, None -> unit_type() },
    }
  } else {
    let converted: WithTys = conv_all_within(checker, args, room);
    let written = conv_over(converted.checker, labels, rows);
    let c: Checker = written.checker;
    let over: Over = written.over;
    match if is_bare(name) { builtin_type_arity(name.name.name) } else { None } {
      Some(arity) -> if converted.tys.len() != arity {
        new_ty(
          arity_error(c, span, name.name.name, arity, converted.tys.len(), b"type arguments", []),
        )
      } else if name.name.name == b"Hold" {
        // A hold's type names its region's label, as its reads do.
        if over.labels.len() != 1 || over.rows.len() != 0 {
          new_ty(over_refused(c, span, name.name.name, 1, 0, over))
        } else {
          let label = match c.label_params.get(labels.get(0).name) {
            Some(v) -> TyVar(v),
            None -> label_type(region_named(c, hold(), labels.get(0).name)),
          };
          { checker: c, ty: TyCon({ name: name.name.name, args: [label, converted.tys.get(0)] }) }
        }
      } else if labels.len() > 0 || rows.len() > 0 {
        new_ty(over_refused(c, span, name.name.name, 0, 0, over))
      } else if name.name.name == b"Cell" {
        new_ty(
          report_error_at(
            c,
            b"E0446",
            span,
            b"`Cell` is no type a program writes",
            b"a cell is a name, not a value",
            cell_is_a_name(),
          ),
        )
      } else {
        let built = TyCon({ name: name.name.name, args: converted.tys });
        { checker: note_map_keys(c, span, built), ty: built }
      },
      None -> {
        let g: WithName = global(c, TypeSpace, name);
        match g.name {
          None -> if is_bare(name) { new_ty(unknown_type(g.checker, name)) }
          else { new_ty(g.checker) },
          Some(qualified) -> match g.checker.types.get(qualified) {
            None -> new_ty(g.checker),
            Some(decl) -> if converted.tys.len() != decl.params.len() {
              new_ty(
                arity_error(
                  g.checker,
                  span,
                  name.name.name,
                  decl.params.len(),
                  converted.tys.len(),
                  b"type arguments",
                  [],
                ),
              )
            } else if over.labels.len() != decl.labels.len() || over.rows.len() != decl.rows.len() {
              new_ty(
                over_refused(
                  g.checker,
                  span,
                  name.name.name,
                  decl.labels.len(),
                  decl.rows.len(),
                  over,
                ),
              )
            } else {
              match decl.declared {
                DeclaredSum ->
                  {
                    checker: g.checker,
                    ty: TyCon({
                      name: qualified,
                      args: applied_args(converted.tys, over.labels, over.rows),
                    }),
                  },
                DeclaredRecord(body) -> {
                  let o = declared_record(g.checker, name.name, qualified, decl, body, room);
                  match o.record {
                    None -> new_ty(o.checker),
                    Some(r) -> {
                      let built = at_arguments(
                        r.ty,
                        r.ty_vars,
                        r.row_vars,
                        applied_args(converted.tys, over.labels, over.rows),
                      );
                      { checker: note_map_keys(o.checker, span, built), ty: built }
                    },
                  }
                },
                DeclaredAlias(alias) -> if g.checker.alias_stack.contains(qualified) {
                  new_ty(
                    report_error_at(
                      g.checker,
                      b"E0102",
                      name.span,
                      Bytes::concat_all([
                        b"type alias `",
                        name.name.name,
                        b"` expands into itself",
                      ]),
                      b"cyclic alias",
                      [b"break the cycle, or make this a `type` with variants"],
                    ),
                  )
                } else if room <= 0 { panic("an alias expanded past the aliases there are") } else {
                  let outermost = g.checker.alias_stack.len() == 0;
                  let before = g.checker.map_keys.len();
                  // A `Map` key's order is the using signature's to promise, so a refusal names the use.
                  let placed = |sites: List<MapKeySite>|
                    if outermost {
                      relocated_keys(sites, before, g.checker.module, span, name.name.name)
                    } else { sites };
                  let memo = decl.params.len() == 0 && decl.labels.len() == 0
                    && decl.rows.len() == 0;
                  match if memo { g.checker.aliases.get(qualified) } else { None } {
                    Some(m) -> {
                      let assumed = assumed_for(g.checker, DOrd);
                      let keys = m.keys.map(|s: MapKeySite|
                        { ..s, scope: g.checker.scope, assumed: assumed });
                      {
                        checker: { ..g.checker, map_keys: placed(g.checker.map_keys.concat(keys)) },
                        ty: m.t,
                      }
                    },
                    None -> {
                      let saved = g.checker.ty_params;
                      let bound: Map<Bytes, Type> = range(0, decl.params.len()).fold(
                        Map::new(),
                        |m: Map<Bytes, Type>, i: Int|
                          m.insert(decl.params.get(i), converted.tys.get(i)),
                      );
                      let own = bind_own(
                        {
                          ..g.checker,
                          ty_params: bound,
                          alias_stack: g.checker.alias_stack.push(qualified),
                          module: decl.owner,
                        },
                        decl,
                      );
                      let body: WithTy = conv_within(own.checker, alias, room - 1);
                      let o: WithTy = if own.labels.len() == 0 && own.rows.len() == 0 { body }
                      else {
                        {
                          checker: body.checker,
                          ty: at_arguments(
                            body.ty,
                            own.labels,
                            own.rows,
                            applied_args([], over.labels, over.rows),
                          ),
                        }
                      };
                      // Kept only when the expansion touched nothing but the keys it noted: a
                      // fresh variable, a diagnostic or a refused atom belongs to the one use.
                      let kept = memo && o.checker.fresh == g.checker.fresh
                        && o.checker.diags.len() == g.checker.diags.len()
                        && o.checker.refused_atoms.len() == g.checker.refused_atoms.len();
                      {
                        checker: {
                          ..o.checker,
                          ty_params: saved,
                          row_params: g.checker.row_params,
                          label_params: g.checker.label_params,
                          alias_stack: o.checker.alias_stack.take(o.checker.alias_stack.len() - 1),
                          module: g.checker.module,
                          map_keys: placed(o.checker.map_keys),
                          aliases: if kept {
                            o.checker.aliases.insert(qualified, {
                              t: o.ty,
                              keys: from_index(o.checker.map_keys, before),
                            })
                          } else { o.checker.aliases },
                        },
                        ty: o.ty,
                      }
                    },
                  }
                },
              }
            },
          },
        }
      },
    }
  }

/// A `new` record over fresh variables for its parameters, or nothing where it holds itself. Its
/// declaration is converted once, in its own module, so what it refuses it refuses once; `named` is
/// the name that asked for it.
fn declared_record(
  checker: Checker,
  named: Ident,
  qualified: Bytes,
  decl: TypeDecl,
  body: TypeExpr,
  room: Int,
) -> { checker: Checker, record: Option<RecordDecl> } / {abort.raise} =
  match checker.nominals.get(qualified) {
    Some(r) -> { checker: checker, record: Some(r) },
    None -> if checker.alias_stack.contains(qualified) {
      {
        checker: report_error_at(
          checker,
          b"E0214",
          named.span,
          Bytes::concat_all([b"`", simple_name_of(qualified), b"` holds itself"]),
          b"this field's type reaches the record it is a field of",
          [
            b"what reads a `new` record's shape reads its fields whole, as it reads an alias's, so the declaration cannot reach itself",
            b"a sum can hold itself: put the recursion in one, as `type T = | Leaf | Node(..)`",
          ],
        ),
        record: None,
      }
    } else if room <= 0 { panic("a declaration expanded past the declarations there are") } else {
      let vars: { checker: Checker, vars: List<Int>, params: Map<Bytes, Type> } = decl.params.fold(
        { checker: checker, vars: [], params: Map::new() },
        |acc: { checker: Checker, vars: List<Int>, params: Map<Bytes, Type> }, p: Bytes| {
          let o: WithVar = new_ty_var(acc.checker);
          {
            checker: o.checker,
            vars: acc.vars.push(o.var),
            params: acc.params.insert(p, TyVar(o.var)),
          }
        },
      );
      let own = bind_own(
        {
          ..vars.checker,
          ty_params: vars.params,
          alias_stack: checker.alias_stack.push(qualified),
          module: decl.owner,
        },
        decl,
      );
      let o: WithTy = conv_within(own.checker, body, room - 1);
      let fields = match o.ty { TyRecord(fs) -> fs, _ -> [] };
      let written = match body { TRecord(r) -> r.fields, _ -> [] };
      // A row its functions perform is read off its fields wherever one escapes, so only what
      // names no region of its own, a `Cell`, a `Task` or a `Chan`, is refused here.
      let checked: Checker = written.fold(
        o.checker,
        |c: Checker, f: { name: Ident, ty: TypeExpr }|
          match field_get(fields, f.name.name) {
            Some(t) ->
              reject_declared_brand(
                c,
                t,
                ty_span(f.ty),
                simple_name_of(qualified),
                Bytes::concat_all([b"field `", f.name.name, b"`"]),
              ),
            None -> c,
          },
      );
      let record = {
        ty: TyNominal({
          name: qualified,
          args: applied_args(
            vars.vars.map(|v: Int| TyVar(v)),
            own.labels.map(|v: Int| TyVar(v)),
            own.rows.map(row_open),
          ),
          fields: fields,
        }),
        ty_vars: vars.vars.concat(own.labels),
        row_vars: own.rows,
      };
      {
        checker: {
          ..checked,
          ty_params: checker.ty_params,
          row_params: checker.row_params,
          label_params: checker.label_params,
          alias_stack: checker.alias_stack,
          module: checker.module,
          nominals: checked.nominals.insert(qualified, record),
        },
        record: Some(record),
      }
    },
  }

/// Each `new` record is declared here whether or not anything names it.
fn collect_nominals(checker: Checker, parsed: ParsedModule) -> Checker / {abort.raise} =
  parsed.module.items.fold(checker, |c: Checker, item: Item|
    match item {
      IType(def) -> {
        let qualified = qualify(parsed.name, def.name.name);
        match c.types.get(qualified) {
          Some(decl) -> match decl.declared {
            DeclaredRecord(body) ->
              declared_record(c, def.name, qualified, decl, body, alias_room(c)).checker,
            _ -> c,
          },
          None -> c,
        }
      },
      _ -> c,
    })

fn unknown_type(checker: Checker, qname: QName) -> Checker / {abort.raise} =
  match checker.derived {
    Some(_) -> unresolved_in_derived(checker, qname, b"type"),
    None -> {
      let n = qname.name.name;
      let notes = [b"declare it with `type`, or check the spelling"];
      let exported = if is_bare(qname) {
        match exporter(checker, TypeSpace, n) {
          Some(i) ->
            notes.push(
              Bytes::concat_all([
                b"module `",
                module_name(checker, i),
                b"` exports it: `import ",
                module_name(checker, i),
                b" (",
                n,
                b")`",
              ]),
            ),
          None -> notes,
        }
      } else { notes };
      report_error_at(
        checker,
        b"E0102",
        qname.span,
        Bytes::concat_all([b"unknown type `", n, b"`"]),
        b"not found",
        exported,
      )
    },
  }

fn row_param(checker: Checker, ident: Ident) -> { checker: Checker, v: Option<Int> } =
  match checker.row_params.get(ident.name) {
    Some(v) -> { checker: checker, v: Some(v) },
    None ->
      {
        checker: report_error_at(
          checker,
          b"E0301",
          ident.span,
          Bytes::concat_all([b"unknown effect variable `", ident.name, b"`"]),
          b"not declared",
          [
            Bytes::concat_all([
              b"declare it after `|` in the generic list of the `fn` or `type` that writes this row: `<| ",
              ident.name,
              b">`",
            ]),
          ],
        ),
        v: None,
      },
  }

fn conv_row(checker: Checker, row: RowExpr) -> { checker: Checker, row: Row } / {abort.raise} = {
  let o = conv_marked(checker, row);
  { checker: refuse_marks(o.checker, row), row: o.r }
}

/// A row with the atoms it marks `bounded`.
fn conv_marked(
  checker: Checker,
  row: RowExpr,
) -> { checker: Checker, r: Row, bounded: List<Atom> } / {abort.raise} = {
  let atoms = row.atoms.fold(
    { checker: checker, atoms: [], bounded: [] },
    |acc: { checker: Checker, atoms: List<Atom>, bounded: List<Atom> }, atom: AtomExpr| {
      let o: WithAtom = conv_atom(acc.checker, atom);
      match o.atom {
        Some(x) ->
          {
            checker: o.checker,
            atoms: atoms_insert(acc.atoms, x),
            bounded: if atom.bounded { atoms_insert(acc.bounded, x) } else { acc.bounded },
          },
        None -> { ..acc, checker: o.checker },
      }
    },
  );
  let tail = match row.tail {
    Some(t) -> row_param(atoms.checker, t),
    None -> { checker: atoms.checker, v: None },
  };
  { checker: tail.checker, r: { atoms: atoms.atoms, tail: tail.v }, bounded: atoms.bounded }
}

/// `bounded` is a promise a definition makes of its own row; a function type's row makes none.
fn refuse_marks(checker: Checker, row: RowExpr) -> Checker = {
  let marked = row.atoms.fold(checker, |c: Checker, atom: AtomExpr|
    if atom.bounded { refuse_mark(c, atom.span) } else { c });
  if row.tail_bounded { refuse_mark(marked, row.span) } else { marked }
}

fn refuse_mark(checker: Checker, span: Span) -> Checker =
  report_error_at(
    checker,
    b"E0466",
    span,
    b"`bounded` is a promise a definition makes of its own row",
    b"this row belongs to a type, not to a definition",
    [
      b"write `bounded` in the row after a `fn` signature's `->`, where the body is checked against it",
    ],
  )

fn refused(checker: Checker, s: Span) -> Bool =
  checker.refused_atoms.fold(false, |acc: Bool, x: Location|
    acc || (x.module == checker.module && x.span == s))

fn refusing(checker: Checker, s: Span) -> Checker =
  { ..checker, refused_atoms: checker.refused_atoms.push({ module: checker.module, span: s }) }

/// `[*]` on an operation declared without a label names nothing: the atom is refused where it is
/// written, and dropped so the row does not carry a label the operation has no room for.
fn refuse_every(
  checker: Checker,
  span: Span,
  eff: Bytes,
  op: Bytes,
  location: Location,
) -> Checker = {
  let reported: Checker = report_error_at_and(
    checker,
    b"E0304",
    span,
    Bytes::concat_all([b"`", eff, b".", op, b"` is not resource-parameterized"]),
    b"`[*]` names no label",
    location,
    b"declared without `[r]`",
    [],
  );
  refusing(reported, span)
}

fn conv_atom(
  checker: Checker,
  a: AtomExpr,
) -> { checker: Checker, atom: Option<Atom> } / {abort.raise} =
  if refused(checker, a.span) { { checker: checker, atom: None } } else {
    let e: WithName = effect_name(checker, a.eff);
    match e.name {
      None -> { checker: refusing(e.checker, a.span), atom: None },
      Some(eff) -> {
        // `[*]` is every label, which no label variable can stand for.
        let resource = if a.every { RAny } else {
          match a.resource {
            Some(r) -> match checker.label_params.get(r.name) {
              Some(v) -> RVar(v),
              None -> RNamed(region_named(checker, eff, r.name)),
            },
            None -> RSingleton,
          }
        };
        let info = effect_of(e.checker, eff);
        // `[*]` on an operation declared without a label names nothing, so the atom is refused
        // where it is written and dropped: the row must not carry a label it has no room for.
        let label_less: { checker: Checker, refused: Bool } = match a.op {
          Some(op) -> match info {
            Some(i) -> match op_named(i, op.name) {
              Some(o) -> if a.every && !o.resource_param {
                { checker: refuse_every(e.checker, a.span, eff, o.name, o.at), refused: true }
              } else { { checker: e.checker, refused: false } },
              None -> { checker: e.checker, refused: false },
            },
            None -> { checker: e.checker, refused: false },
          },
          None -> { checker: e.checker, refused: false },
        };
        let named_cx: Checker = label_less.checker;
        // An operation atom takes the declared operation's mode; the parser wrote a placeholder.
        let atom: Option<Atom> = if label_less.refused { None } else {
          match a.op {
            Some(op) -> match info {
              Some(i) -> match op_named(i, op.name) {
                Some(o) ->
                  Some({ effect: eff, resource: resource, mode: o.mode, op: Some(o.name) }),
                None -> None,
              },
              None -> None,
            },
            None -> {
              // `diverges` names no operation: it is written bare and stands for itself.
              let declares_mode = eff == b"diverges"
                || (match info {
                  Some(i) ->
                    i.ops.fold(false, |acc: Bool, o: OpInfo| acc || mode_eq(o.mode, a.mode)),
                  None -> true,
                });
              if declares_mode { Some({ effect: eff, resource: resource, mode: a.mode, op: None }) }
              else { None }
            },
          }
        };
        match atom {
          Some(_) -> { checker: named_cx, atom: atom },
          None -> {
            let known = match info {
              Some(i) -> match a.op {
                Some(_) -> known_modes(i).concat(known_moded_ops(i)),
                None -> known_modes(i),
              },
              None -> [],
            };
            let help = if known.len() == 0 { [] } else {
              [Bytes::concat_all([b"`", eff, b"` can perform: ", Bytes::join(known, b", ")])]
            };
            let (message, label) = match a.op {
              Some(op) ->
                (
                  Bytes::concat_all([
                    b"effect `",
                    eff,
                    b"` declares no operation `",
                    op.name,
                    b"`",
                  ]),
                  b"no such operation",
                ),
              None ->
                (
                  Bytes::concat_all([
                    b"effect `",
                    eff,
                    b"` declares no `",
                    mode_text(a.mode),
                    b"` operation",
                  ]),
                  Bytes::concat_all([b"no `", mode_text(a.mode), b"` operation to perform"]),
                ),
            };
            let reported: Checker = report_error_at(
              named_cx,
              b"E0104",
              a.span,
              message,
              label,
              help,
            );
            { checker: refusing(reported, a.span), atom: None }
          },
        }
      },
    }
  }

/// No mode atom stands for a raise, so each one is named.
fn known_modes(info: EffectInfo) -> List<Bytes> =
  info.ops.fold([], |acc: List<Bytes>, op_info: OpInfo| {
    let k = Bytes::concat_all([
      info.simple_name,
      b".",
      if is_raise(op_info.mode) { op_info.name } else { mode_text(op_info.mode) },
    ]);
    if acc.contains(k) { acc } else { acc.push(k) }
  })

fn known_moded_ops(info: EffectInfo) -> List<Bytes> =
  known_ops({ ..info, ops: info.ops.filter(|op_info: OpInfo| !is_raise(op_info.mode)) })

fn known_ops(info: EffectInfo) -> List<Bytes> =
  info.ops.map(|op_info: OpInfo| Bytes::concat_all([info.simple_name, b".", op_info.name]))

fn op_named(info: EffectInfo, name: Bytes) -> Option<OpInfo> =
  info.ops.fold(None, |acc: Option<OpInfo>, op_info: OpInfo|
    match acc { Some(_) -> acc, None -> if op_info.name == name { Some(op_info) } else { None } })

fn mode_eq(a: Mode, b: Mode) -> Bool =
  match a {
    MRead -> match b { MRead -> true, _ -> false },
    MWrite -> match b { MWrite -> true, _ -> false },
    MBad -> false,
    MRaise -> is_raise(b),
  }

fn effect_name(
  checker: Checker,
  qname: QName,
) -> { checker: Checker, name: Option<Bytes> } / {abort.raise} =
  if is_bare(qname) && is_region_effect(qname.name.name) {
    { checker: checker, name: Some(qname.name.name) }
  } else {
    let g: WithName = global(checker, EffectSpace, qname);
    match g.name {
      Some(n) -> match effect_of(g.checker, n) {
        Some(_) -> { checker: g.checker, name: Some(n) },
        None -> { checker: g.checker, name: None },
      },
      None -> if is_bare(qname) && is_prelude_effect(qname.name.name) {
        { checker: g.checker, name: Some(qname.name.name) }
      } else if is_bare(qname) { { checker: unknown_effect(g.checker, qname), name: None } }
      else { { checker: g.checker, name: None } },
    }
  }

fn unknown_effect(checker: Checker, qname: QName) -> Checker / {abort.raise} = {
  let n = qname.name.name;
  let message = Bytes::concat_all([b"unknown effect `", n, b"`"]);
  if is_bare(qname) && (match env_depth_of(checker.env, n) { Some(_) -> true, None -> false }) {
    report_error_at(checker, b"E0103", qname.span, message, b"not declared", [
      Bytes::concat_all([
        b"`",
        n,
        b"` is a value in scope, so this looks like a field call rather than a perform: write `(",
        n,
        b".<field>)(..)` to call a function held in a record",
      ]),
      b"`a.b(c)` is an effect operation; parentheses make it a field access",
    ])
  } else {
    let known = scope_of(checker).bound.effects.map(|binding: Binding| binding.name);
    let first = if known.len() == 0 { b"declare it with `effect <name> { .. }`" }
    else { b"effects in scope: ".concat(backticked(known, b", ")) };
    let notes = match exporter(checker, EffectSpace, n) {
      Some(i) ->
        [
          first,
          Bytes::concat_all([
            b"module `",
            module_name(checker, i),
            b"` declares it: `import ",
            module_name(checker, i),
            b"` and write `",
            default_binder(module_name(checker, i)),
            b"::",
            n,
            b"`",
          ]),
        ],
      None -> [first],
    };
    report_error_at(checker, b"E0103", qname.span, message, b"not declared", notes)
  }
}

// --- Declarations ------------------------------------------------------------------------

fn duplicate(checker: Checker, name: Ident, prev: Location, what: Bytes) -> Checker =
  report_error_at_and(
    checker,
    b"E0105",
    name.span,
    Bytes::concat_all([what, b" `", name.name, b"` is defined more than once"]),
    b"redefined here",
    prev,
    b"first defined here",
    [b"rename one of them"],
  )

fn record_type(checker: Checker, parsed: ParsedModule, def: TypeDef) -> Checker = {
  let name = qualify(parsed.name, def.name.name);
  match checker.types.get(name) {
    Some(prev) -> duplicate(checker, def.name, { module: prev.owner, span: prev.span }, b"type"),
    None -> match builtin_type_arity(def.name.name) {
      Some(_) ->
        report_error_at(
          checker,
          b"E0105",
          def.name.span,
          Bytes::concat_all([b"`", def.name.name, b"` is a builtin type"]),
          b"cannot be redefined",
          [b"choose a different name for this type"],
        ),
      None -> {
        let declared = match def.body {
          TDAlias(t) -> DeclaredAlias(t),
          TDNominal(t) -> DeclaredRecord(t),
          TDSum(_) -> DeclaredSum,
        };
        {
          ..checker,
          types: checker.types.insert(name, {
            params: ident_names(def.generics.types),
            labels: ident_names(def.generics.labels),
            rows: ident_names(def.generics.effects),
            declared: declared,
            opaque: def.opaque,
            owner: checker.module,
            span: def.span,
          }),
        }
      },
    },
  }
}

fn collect_types(checker: Checker, parsed: ParsedModule) -> Checker =
  parsed.module.items.fold(checker, |c: Checker, item: Item|
    match item { IType(d) -> record_type(c, parsed, d), _ -> c })

/// The first `Cell`, `Hold`, `Task` or `Chan` in `ty`: each is a key into the region that made it.
fn region_brand(ty: Type) -> Option<Bytes> =
  match ty {
    TyCon(c) -> if is_region_type(c.name) || scheduler_handle(c.name) { Some(c.name) }
    else { first_reason(c.args, region_brand) },
    TyFn(f) -> match first_reason(f.params, region_brand) {
      Some(b) -> Some(b),
      None -> region_brand(f.ret),
    },
    TyRecord(fs) -> first_reason(fs, |f: Field| region_brand(f.ty)),
    TyNominal(n) -> first_reason(n.fields, |f: Field| region_brand(f.ty)),
    TyVar(_) -> None,
  }

fn reject_declared_brand(
  checker: Checker,
  ty: Type,
  span: Span,
  owner: Bytes,
  what: Bytes,
) -> Checker =
  match region_brand(ty) {
    None -> checker,
    Some(brand) ->
      report_error_at(
        checker,
        b"E0446",
        span,
        Bytes::concat_all([b"`", owner, b"`'s ", what, b" mentions a `", brand, b"`"]),
        b"a declaration is outside every region there is",
        [
          Bytes::concat_all([
            b"a declaration is fixed once for the whole program, so it cannot say which region a `",
            brand,
            b"` in it came from, and no later check could tell that the `",
            brand,
            b"` had outlived its region",
          ]),
          Bytes::concat_all([
            b"take the `",
            brand,
            b"` as a type parameter instead, so it stays in the type argument, where the escape check can see it",
          ]),
        ],
      ),
  }

/// What the row of a function in `ty` reaches of a region: a cell, or a task or a channel.
fn region_reach(ty: Type) -> Option<Bytes> =
  match ty {
    TyVar(_) -> None,
    TyCon(c) -> first_reason(c.args, region_reach),
    TyRecord(fs) -> first_reason(fs, |f: Field| region_reach(f.ty)),
    TyNominal(n) -> first_reason(n.fields, |f: Field| region_reach(f.ty)),
    TyFn(f) -> if f.effects.atoms.fold(false, |b: Bool, atom: Atom| b || atom.effect == cell()) {
      Some(b"`Cell`")
    } else if f.effects.atoms.fold(false, |b: Bool, atom: Atom| b || atom.effect == hold()) {
      Some(b"`Hold`")
    } else if row_brands(f.effects, Tasks) { Some(b"`Task` or a `Chan`") } else {
      match first_reason(f.params, region_reach) { Some(b) -> Some(b), None -> region_reach(f.ret) }
    },
  }

/// A sum type hides the rows of the functions it holds, so one that reaches a region would leave it
/// unseen: only a row the type takes as an argument is where the escape checks look.
fn reject_declared_reach(
  checker: Checker,
  ty: Type,
  span: Span,
  owner: Bytes,
  field: Int,
) -> Checker =
  match region_reach(ty) {
    None -> checker,
    Some(reached) ->
      report_error_at(
        checker,
        b"E0446",
        span,
        Bytes::concat_all([
          b"`",
          owner,
          b"`'s field ",
          ascii_of_int(field),
          b" holds a function whose row reaches a ",
          reached,
        ]),
        b"a declaration is outside every region there is",
        [
          b"a declared type hides the rows of the functions it holds, so no later check could tell that this one had outlived the region it reaches",
          b"take the row as a row parameter instead, `type T<| e> = ..`, so it stays in the type argument, where the escape check can see it",
        ],
      ),
  }

fn collect_effects(checker: Checker, parsed: ParsedModule) -> Checker / {abort.raise} =
  parsed.module.items.fold(checker, |c: Checker, item: Item|
    match item {
      IEffect(def) -> {
        let name = qualify(parsed.name, def.name.name);
        if is_region_effect(def.name.name) {
          report_error_at(
            c,
            b"E0105",
            def.name.span,
            Bytes::concat_all([b"`", def.name.name, b"` is a builtin effect"]),
            Bytes::concat_all([b"reserved for `with_", def.name.name, b"` regions"]),
            [b"rename this effect"],
          )
        } else if is_prelude_effect(name) {
          report_error_at(
            c,
            b"E0105",
            def.name.span,
            Bytes::concat_all([b"`", name, b"` is a prelude effect"]),
            b"declared by the language",
            [
              b"the language declares `task`, `clock`, `random`, `sim` and `abort`; `simulate { .. }` handles the first three",
              Bytes::concat_all([
                b"rename this effect, or put it in a named module, where its program-wide name would be `<module>.",
                def.name.name,
                b"` and would shadow the prelude",
              ]),
            ],
          )
        } else {
          match effect_of(c, name) {
            Some(prev) -> duplicate(c, def.name, prev.at, b"effect"),
            None -> {
              let ops = def.ops.fold(
                { checker: c, ops: [] },
                |acc: { checker: Checker, ops: List<OpInfo> }, op: OpDef|
                  if acc.ops.fold(false, |b: Bool, op_info: OpInfo|
                      b || op_info.name == op.name.name) {
                    let prev = acc.ops.fold(dummy_span(), |span: Span, op_info: OpInfo|
                      if op_info.name == op.name.name { op_info.at.span } else { span });
                    {
                      checker: duplicate(
                        acc.checker,
                        op.name,
                        { module: acc.checker.module, span: prev },
                        b"operation",
                      ),
                      ops: acc.ops,
                    }
                  } else {
                    let c1: Checker = bind_ty_params(
                      { ..acc.checker, ty_params: Map::new() },
                      op.ty_params,
                    );
                    let ps: WithTys = conv_types(c1, op.params);
                    // A raise answers nothing, so each perform of it has the type asked of it.
                    let r: WithTy = if is_raise(op.mode) { new_ty(ps.checker) }
                    else { conv_type(ps.checker, op.ret) };
                    let c2: Checker = { ..r.checker, ty_params: Map::new() };
                    let c3: Checker = range(0, ps.tys.len()).fold(c2, |cc: Checker, i: Int|
                      reject_declared_brand(
                        cc,
                        ps.tys.get(i),
                        ty_span(op.params.get(i)),
                        op.name.name,
                        b"parameter ".concat(ascii_of_int(i + 1)),
                      ));
                    let c4 = reject_declared_brand(
                      c3,
                      r.ty,
                      ty_span(op.ret),
                      op.name.name,
                      b"result",
                    );
                    {
                      checker: c4,
                      ops: acc.ops.push({
                        name: op.name.name,
                        mode: op.mode,
                        resource_param: op.resource_param,
                        params: ps.tys,
                        ret: r.ty,
                        at: location_of(c4, op.span),
                        scheme: None,
                      }),
                    }
                  },
              );
              add_effect(ops.checker, {
                name: name,
                module: parsed.name,
                simple_name: def.name.name,
                nondet: def.is_nondet,
                ops: ops.ops,
                at: location_of(ops.checker, def.span),
              })
            },
          }
        }
      },
      _ -> c,
    })

fn collect_ctors(checker: Checker, parsed: ParsedModule) -> Checker / {abort.raise} =
  parsed.module.items.fold(checker, |c: Checker, item: Item|
    match item {
      IType(def) -> match def.body {
        TDAlias(_) -> c,
        TDNominal(_) -> c,
        TDSum(variants) -> {
          let type_name = qualify(parsed.name, def.name.name);
          match c.types.get(type_name) {
            None -> c,
            Some(decl) -> {
              let vars: { checker: Checker, vars: List<Int>, params: Map<Bytes, Type> } = decl.params.fold(
                { checker: c, vars: [], params: Map::new() },
                |acc: { checker: Checker, vars: List<Int>, params: Map<Bytes, Type> }, p: Bytes| {
                  let o: WithVar = new_ty_var(acc.checker);
                  {
                    checker: o.checker,
                    vars: acc.vars.push(o.var),
                    params: acc.params.insert(p, TyVar(o.var)),
                  }
                },
              );
              let own = bind_own({ ..vars.checker, ty_params: vars.params }, decl);
              let c1: Checker = own.checker;
              let result = TyCon({
                name: type_name,
                args: applied_args(
                  vars.vars.map(|v: Int| TyVar(v)),
                  own.labels.map(|v: Int| TyVar(v)),
                  own.rows.map(row_open),
                ),
              });
              let walked: Checker = range(0, variants.len()).fold(c1, |cc: Checker, index: Int| {
                let variant = variants.get(index);
                let ctor = qualify(parsed.name, variant.name.name);
                match ctor_of(cc, ctor) {
                  Some(prev) -> duplicate(cc, variant.name, prev.at, b"constructor"),
                  None -> {
                    let fs: WithTys = conv_types(cc, variant.fields);
                    let checked: Checker = range(0, fs.tys.len()).fold(
                      fs.checker,
                      |c3: Checker, i: Int|
                        reject_declared_reach(
                          reject_declared_brand(
                            c3,
                            fs.tys.get(i),
                            ty_span(variant.fields.get(i)),
                            variant.name.name,
                            b"field ".concat(ascii_of_int(i + 1)),
                          ),
                          fs.tys.get(i),
                          ty_span(variant.fields.get(i)),
                          variant.name.name,
                          i + 1,
                        ),
                    );
                    let ty = if fs.tys.len() == 0 { result }
                    else { fn_type(fs.tys, result, row_empty()) };
                    let sc = {
                      ty_vars: vars.vars,
                      row_vars: own.rows,
                      label_vars: own.labels,
                      ty: ty,
                    };
                    add_ctor({ ..checked, env: env_bind_global(checked.env, ctor, sc) }, {
                      name: ctor,
                      module: parsed.name,
                      simple_name: variant.name.name,
                      type_name: type_name,
                      index: index,
                      arity: fs.tys.len(),
                      fields: fs.tys,
                      scheme: sc,
                      at: location_of(checked, variant.span),
                    })
                  },
                }
              });
              { ..walked, ty_params: Map::new(), row_params: Map::new(), label_params: Map::new() }
            },
          }
        },
      },
      _ -> c,
    })

/// A function and a constructor of one name in one module.
fn check_value_namespace(checker: Checker, parsed: ParsedModule) -> Checker = {
  let walked = parsed.module.items.fold(
    { checker: checker, seen: [] },
    |acc: { checker: Checker, seen: List<{ name: Bytes, span: Span, is_fn: Bool }> }, item: Item| {
      let declared = match item {
        IFn(d) -> [{ name: d.name, is_fn: true }],
        IType(d) -> match d.body {
          TDSum(vs) -> vs.map(|variant: VariantDef| { name: variant.name, is_fn: false }),
          TDAlias(_) -> [],
          TDNominal(_) -> [],
        },
        _ -> [],
      };
      declared.fold(
        acc,
        |a: { checker: Checker, seen: List<{ name: Bytes, span: Span, is_fn: Bool }> }, x: { name: Ident, is_fn: Bool }| {
          let prev = a.seen.fold(
            None,
            |p: Option<{ name: Bytes, span: Span, is_fn: Bool }>, s: { name: Bytes, span: Span, is_fn: Bool }|
              match p { Some(_) -> p, None -> if s.name == x.name.name { Some(s) } else { None } },
          );
          match prev {
            None ->
              { ..a, seen: a.seen.push({ name: x.name.name, span: x.name.span, is_fn: x.is_fn }) },
            Some(first) -> if first.is_fn == x.is_fn { a } else {
              let later = if x.is_fn { b"function" } else { b"constructor" };
              let earlier = if x.is_fn { b"constructor" } else { b"function" };
              let where_ = if parsed.name.len() == 0 { b"" }
              else { Bytes::concat_all([b" in module `", parsed.name, b"`"]) };
              {
                ..a,
                checker: report_error_at_and(
                  a.checker,
                  b"E0105",
                  x.name.span,
                  Bytes::concat_all([b"`", x.name.name, b"` is defined twice", where_]),
                  Bytes::concat_all([b"redefined here as a ", later]),
                  { module: a.checker.module, span: first.span },
                  Bytes::concat_all([b"first defined here as a ", earlier]),
                  [
                    Bytes::concat_all([
                      b"functions and constructors share one namespace: nothing written `",
                      x.name.name,
                      b"` could say which of the two it means",
                    ]),
                    b"rename one of them",
                  ],
                ),
              }
            },
          }
        },
      )
    },
  );
  walked.checker
}

// --- Signatures ---------------------------------------------------------------------------

fn constraints_in_force(checker: Checker, cs: List<Constraint>) -> List<Assumed> / {abort.raise} =
  cs.fold([], |acc: List<Assumed>, c: Constraint|
    match checker.ty_params.get(c.param.name) {
      Some(TyVar(v)) -> assume(acc, c.deriver, v),
      _ -> acc,
    })

fn assume(xs: List<Assumed>, deriver: Deriver, v: Int) -> List<Assumed> / {abort.raise} = {
  let hit = range(0, xs.len()).fold(None, |acc: Option<Int>, i: Int|
    match acc {
      Some(_) -> acc,
      None -> if same_deriver(xs.get(i).deriver, deriver) { Some(i) } else { None },
    });
  match hit {
    Some(i) -> {
      let x = xs.get(i);
      xs.set(i, { deriver: x.deriver, vars: ints_insert(x.vars, v) })
    },
    None -> xs.push({ deriver: deriver, vars: [v] }),
  }
}

fn check_where(checker: Checker, def: FnDef) -> Checker / {abort.raise} =
  def.constraints.fold(checker, |c: Checker, k: Constraint|
    if c.ty_params.contains(k.param.name) { c } else {
      let bound = def.generics.types.map(|ident: Ident| ident.name);
      report_error_at(
        c,
        b"E0102",
        k.param.span,
        Bytes::concat_all([b"`", k.param.name, b"` is not a type parameter of this signature"]),
        b"not bound by the generic list",
        [
          if bound.len() == 0 {
            Bytes::concat_all([
              b"`",
              def.name.name,
              b"` takes no type parameters, and a constraint on a concrete type is either already true or already an error",
            ])
          } else { b"this signature binds ".concat(backticked(bound, b", ")) },
        ],
      )
    })

/// A signature's type parameters: only these names are type variables in it, each rigid.
fn bind_ty_params(checker: Checker, names: List<Ident>) -> Checker =
  names.fold(checker, |c: Checker, ident: Ident| {
    let o: WithVar = new_ty_var(c);
    {
      ..o.checker,
      subst: mark_rigid_ty(o.checker.subst, o.var),
      ty_params: o.checker.ty_params.insert(ident.name, TyVar(o.var)),
    }
  })

/// A member of the group being walked as a call inside the group reads it: each call fills its own
/// type, row and label parameters, as a call from outside does.
fn member_scheme(checker: Checker, def: FnDef, sig: Signature) -> Scheme / {abort.raise} = {
  let free = free_vars(checker.subst, sig.fn_ty, { tys: [], rows: [] });
  {
    ty_vars: def.generics.types.fold([], |vs: List<Int>, ident: Ident|
      match sig.ty_params.get(ident.name) {
        Some(TyVar(v)) -> if free.tys.contains(v) { vs.push(v) } else { vs },
        _ -> vs,
      }),
    row_vars: def.generics.effects.fold([], |vs: List<Int>, ident: Ident|
      match sig.row_params.get(ident.name) {
        Some(v) -> if free.rows.contains(v) { vs.push(v) } else { vs },
        None -> vs,
      }),
    label_vars: def.generics.labels.fold([], |vs: List<Int>, ident: Ident|
      match sig.label_params.get(ident.name) { Some(v) -> vs.push(v), None -> vs }),
    ty: sig.fn_ty,
  }
}

/// A definition's signature as it is written, each of its type, row and label parameters rigid.
fn written_signature(
  outer: Checker,
  def: FnDef,
) -> { checker: Checker, sig: Signature } / {abort.raise} = {
  let checker: Checker = {
    ..outer,
    scope: outer.scope + 1,
    ty_params: Map::new(),
    row_params: Map::new(),
    label_params: Map::new(),
  };
  let tys: Checker = bind_ty_params(checker, def.generics.types);
  let rows: Checker = def.generics.effects.fold(tys, |c: Checker, p: Ident| {
    let o: WithVar = new_row_var(c);
    {
      ..o.checker,
      subst: mark_rigid_row(o.checker.subst, o.var),
      row_params: o.checker.row_params.insert(p.name, o.var),
    }
  });
  // A label parameter is a type variable, rigid in the body, that the row's atoms name.
  let labels: Checker = def.generics.labels.fold(rows, |c: Checker, p: Ident| {
    let o: WithVar = new_ty_var(c);
    {
      ..o.checker,
      subst: mark_rigid_ty(o.checker.subst, o.var),
      label_params: o.checker.label_params.insert(p.name, o.var),
    }
  });
  let assumed: Checker = witnessing(
    { ..labels, assumed: constraints_in_force(labels, def.constraints) },
    def.constraints,
  );
  let checked: Checker = check_where(assumed, def);
  let params = def.params.fold(
    { checker: checked, tys: [] },
    |acc: { checker: Checker, tys: List<Type> }, p: Param|
      match p.ty {
        Some(t) -> {
          let o: WithTy = conv_type(acc.checker, t);
          { checker: hold_written(o.checker, t, o.ty, true), tys: acc.tys.push(o.ty) }
        },
        None -> {
          let o: WithTy = new_ty(acc.checker);
          { checker: o.checker, tys: acc.tys.push(o.ty) }
        },
      },
  );
  let ret: WithTy = match def.ret {
    Some(t) -> {
      let o: WithTy = conv_type(params.checker, t);
      { checker: hold_written(o.checker, t, o.ty, false), ty: o.ty }
    },
    None -> new_ty(params.checker),
  };
  // A function's row is what its signature writes: with no `/`, the empty one.
  let declared: { checker: Checker, r: Option<Row>, bounded: List<Atom> } = match def.effects {
    Some(r) -> {
      let o = conv_marked(ret.checker, r);
      { checker: o.checker, r: Some(o.r), bounded: o.bounded }
    },
    None -> { checker: ret.checker, r: Some(row_empty()), bounded: [] },
  };
  let row: WithRow = match declared.r {
    Some(r) -> { checker: declared.checker, row: r },
    None -> new_row(declared.checker),
  };
  let c: Checker = row.checker;
  {
    checker: { ..c, ty_params: Map::new(), row_params: Map::new(), label_params: Map::new() },
    sig: {
      ty_params: c.ty_params,
      row_params: c.row_params,
      label_params: c.label_params,
      fn_ty: fn_type(params.tys, ret.ty, row.row),
      params: params.tys,
      ret: ret.ty,
      declared: declared.r,
      published_row: row.row,
      bounded: declared.bounded,
      tail_bounded: match def.effects { Some(r) -> r.tail_bounded, None -> false },
      scope: c.scope,
    },
  }
}

// --- Expressions ------------------------------------------------------------------------------

fn lit_type(literal: Lit) -> Type / {abort.raise} =
  match literal {
    LInt(_) -> int_type(),
    LFixed(ty, _) -> named_type(Bytes::of_string(String::of_bytes(ty).ascii_upper())),
    LWide(ty, _, _) -> named_type(Bytes::of_string(String::of_bytes(ty).ascii_upper())),
    LBool(_) -> bool_type(),
    LStr(_) -> string_type(),
    LBytes(_) -> bytes_type(),
    LFloat(_) -> float_type(),
    LDec(_) -> decimal_type(),
    LChar(_) -> named_type(b"Char"),
    _ -> unit_type(),
  }

fn record_site(checker: Checker, atom: Atom, span: Span, source: PerformSource) -> Checker =
  record_over(checker, atom, span, source, checker.over, checker.maybe)

fn record_over(
  checker: Checker,
  atom: Atom,
  span: Span,
  source: PerformSource,
  over: Option<Span>,
  maybe: List<Maybe>,
) -> Checker =
  if span.start == 0 && span.end == 0 { checker } else {
    {
      ..checker,
      performs: checker.performs.push({
        atom: atom,
        module: checker.module,
        span: span,
        source: source,
        over: over,
        maybe: maybe,
      }),
    }
  }

fn is_direct(site: PerformSite) -> Bool = match site.source { DirectPerform -> true, _ -> false }

// --- What the conditions on the way hold -----------------------------------------------------------

fn reader_of(checker: Checker) -> Reader =
  {
    name: |q: QName|
      if !is_bare(q) { Elsewhere } else {
        match env_local(checker.env, q.name.name) {
          Some(b) -> Local({ stamp: b.stamp, ty: b.scheme.ty }),
          None -> Elsewhere,
        }
      },
    head: |ty: Type| shallow(checker.subst, ty),
    builtin: |f: Expr| prelude_named(checker, f),
    on_value: |span: Span|
      match checker.builtins_on.get(span_key(span)) { Some(name) -> name, None -> b"" },
    contract: |name: Bytes| checker.contracts.get(name),
  }

fn assuming(checker: Checker, cond: Expr, truth: Bool) -> Checker / {abort.raise} =
  { ..checker, guards: guards::assume(reader_of(checker), checker.guards, cond, truth) }

fn leaving(checker: Checker, before: Guards) -> Checker =
  { ..checker, guards: guards::left(checker.guards, before) }

/// A `let` of one name is known as what its value reads as where the value was written.
fn known_as(before: Checker, bound: Checker, pat: Pattern, value: Expr) -> Checker / {abort.raise} =
  match pat {
    PVar(v) -> match env_local(bound.env, v.name.name) {
      None -> bound,
      Some(b) -> {
        // The names are those before the `let`, and the calls those its value made.
        let r = guards::read(
          { ..reader_of(before), on_value: reader_of(bound).on_value },
          bound.guards,
          value,
        );
        { ..bound, guards: guards::bind(r.g, b.stamp, r.value) }
      },
    },
    _ -> bound,
  }

/// The lambda `List::map`, `List::filter` or `List::fold` calls with each element of a `range` it is handed, by its
/// place among the arguments, and the range's bounds.
type Ranged = { at: Int, lo: Expr, hi: Expr }

fn ranged_lambda(
  checker: Checker,
  builtin: Bytes,
  args: List<Expr>,
) -> Option<Ranged> / {abort.raise} = {
  let place = if builtin == b"List::map" || builtin == b"List::filter" { 1 }
  else if builtin == b"List::fold" { 2 }
  else { 0 - 1 };
  if place < 0 { None } else {
    match args.at(0) {
      Some(EApp(r)) -> match r.args {
        [lo, hi] -> if prelude_named(checker, r.func) != b"range" { None }
        else { Some({ at: place, lo: lo, hi: hi }) },
        _ -> None,
      },
      _ -> None,
    }
  }
}

fn note_raise(checker: Checker, span: Span, why: RaiseWhy) -> Checker =
  { ..checker, raise_notes: checker.raise_notes.push({ span: span, why: why }) }

/// Whether a call of a builtin shows every clause of its `requires`, so that it cannot raise; one
/// that does not is noted with the clause it misses.
fn requires_shown(
  checker: Checker,
  builtin: Bytes,
  args: List<Expr>,
  span: Span,
) -> { checker: Checker, shown: Bool } / {abort.raise} =
  match checker.contracts.get(builtin) {
    None -> { checker: checker, shown: false },
    Some(st) -> if st.requires.len() == 0 { { checker: checker, shown: false } } else {
      let o = guards::unshown(reader_of(checker), checker.guards, st, args);
      let read: Checker = { ..checker, guards: o.g };
      match o.needs {
        None -> { checker: read, shown: true },
        Some(needs) ->
          {
            checker: note_raise(read, span, Unshown({ callee: builtin, needs: needs })),
            shown: false,
          },
      }
    },
  }

fn callee_source(checker: Checker, func: Expr) -> PerformSource / {abort.raise} =
  match func {
    EVar(v) -> {
      let depth = if is_bare(v.name) { env_depth_of(checker.env, v.name.name.name) } else { None };
      match depth {
        Some(d) -> if d > 0 { OpaquePerform } else {
          // A builtin is bound in no module, so it is named as written.
          match declared_value(checker, v.name) {
            Some(n) -> PerformVia(n),
            None -> PerformVia(v.name.name.name),
          }
        },
        None -> match declared_value(checker, v.name) {
          Some(n) -> PerformVia(n),
          None -> PerformThroughArgs,
        },
      }
    },
    _ -> OpaquePerform,
  }

/// Drops the sites recorded from `mark` to `until` whose atom `handled` covers.
fn discharge(
  checker: Checker,
  mark: Int,
  until: Int,
  handled: List<Atom>,
) -> Checker / {abort.raise} = {
  let kept = checker.performs.drop(mark).take(until - mark).filter(|site: PerformSite|
    !atoms_covered(handled, resolve_atom(checker.subst, site.atom)));
  {
    ..checker,
    performs: checker.performs.take(mark).concat(kept).concat(checker.performs.drop(until)),
  }
}

/// The clause's resource covers the performed one: `[*]` is a clause for every label.
fn key_named(keys: List<OpKey>, atom: Atom) -> Bool =
  keys.fold(false, |acc: Bool, k: OpKey|
    acc
      || (k.effect == atom.effect && resource_covers(k.resource, atom.resource)
      && Some(k.op) == atom.op))

/// The operation atoms a mode atom stands for: the effect's operations of that mode, under the atom's resource.
fn mode_ops(checker: Checker, atom: Atom) -> List<Atom> / {abort.raise} = {
  let named = match atom.resource {
    RNamed(_) -> true,
    RVar(_) -> true,
    RSingleton -> false,
    RAny -> true,
  };
  match effect_of(checker, atom.effect) {
    Some(info) ->
      info.ops.fold([], |acc: List<Atom>, op_info: OpInfo|
        if mode_eq(op_info.mode, atom.mode) && op_info.resource_param == named {
          acc.push({
            effect: atom.effect,
            resource: atom.resource,
            mode: atom.mode,
            op: Some(op_info.name),
          })
        } else { acc }),
    None -> [],
  }
}

/// A clause discharges the operation it names; a mode atom is discharged by a clause for each of its operations.
/// `handled` holds the clauses' mode atoms, and a clause written `[*]` covers every label.
fn clause_discharges(
  checker: Checker,
  handled: List<Atom>,
  keys: List<OpKey>,
  a: Atom,
) -> Bool / {abort.raise} =
  match a.op {
    Some(_) -> key_named(keys, a),
    None ->
      atoms_covered(handled, a)
        && mode_ops(checker, a).fold(true, |acc: Bool, o: Atom| acc && key_named(keys, o)),
  }

fn site_for(checker: Checker, atom: Atom) -> Option<PerformSite> / {abort.raise} =
  site_among(resolved_sites(checker.subst, checker.performs), atom)

fn resolved_sites(subst: Subst, sites: List<PerformSite>) -> List<PerformSite> / {abort.raise} =
  sites.map(|site: PerformSite| { ..site, atom: resolve_atom(subst, site.atom) })

fn site_among(sites: List<PerformSite>, atom: Atom) -> Option<PerformSite> =
  sites.fold(None, |acc: Option<PerformSite>, site: PerformSite|
    match acc { Some(_) -> acc, None -> if site.atom == atom { Some(site) } else { None } })

fn join(
  checker: Checker,
  span: Span,
  a: Row,
  b: Row,
) -> { checker: Checker, row: Row } / {abort.raise} =
  match a.tail {
    Some(x) -> match b.tail {
      Some(y) -> if x != y {
        let u = unify_row(checker.subst, checker.fresh, row_open(x), row_open(y));
        let c = with_unified(checker, u);
        match u.error {
          Some(e) ->
            {
              checker: report_unify(c, e, span, b"this expression combines two effect variables"),
              row: row_union(a, b),
            },
          None -> { checker: c, row: row_union(a, b) },
        }
      } else { { checker: checker, row: row_union(a, b) } },
      None -> { checker: checker, row: row_union(a, b) },
    },
    None -> { checker: checker, row: row_union(a, b) },
  }

/// The message and both sides of the primary label are what dedup compares, so both go into `text`.
fn report_unify(
  checker: Checker,
  error: UnifyError,
  span: Span,
  context: Bytes,
) -> Checker / {abort.raise} =
  match error {
    Mismatch(m) -> {
      let expected = resolve(checker, m.expected);
      let found = resolve(checker, m.found);
      let pe = print_ty(printer_new(), expected);
      let pf = print_ty(pe.printer, found);
      report_text(
        checker,
        b"E0201",
        span,
        Bytes::concat_all([context, b"|", pe.text, b"|", pf.text]),
        b"type mismatch: ".concat(context),
        Bytes::concat_all([b"expected `", pe.text, b"`, found `", pf.text, b"`"]),
        declared_apart(checker, expected, found),
      )
    },
    Arity(a) ->
      report_text(
        checker,
        b"E0202",
        span,
        Bytes::concat_all([context, b"|", ascii_of_int(a.expected), b"|", ascii_of_int(a.found)]),
        b"function arity mismatch: ".concat(context),
        Bytes::concat_all([
          b"expected ",
          ascii_of_int(a.expected),
          b" parameter(s), found ",
          ascii_of_int(a.found),
        ]),
        [],
      ),
    OccursTy(o) -> {
      let pv = print_ty(printer_new(), TyVar(o.v));
      let pt = print_ty(pv.printer, o.ty);
      report_text(
        checker,
        b"E0203",
        span,
        Bytes::concat_all([context, b"|", pv.text, b"|", pt.text]),
        b"infinite type: ".concat(context),
        Bytes::concat_all([b"`", pv.text, b"` would have to equal `", pt.text, b"`"]),
        [b"this usually means a recursive value is missing a constructor"],
      )
    },
    OccursRow(o) -> {
      let pv = print_row(printer_new(), row_open(o.v));
      let pr = print_row(pv.printer, o.row);
      report_text(
        checker,
        b"E0203",
        span,
        Bytes::concat_all([context, b"|", pv.text, b"|", pr.text]),
        b"infinite effect row: ".concat(context),
        Bytes::concat_all([b"`", pv.text, b"` would have to equal `", pr.text, b"`"]),
        [b"an effect row cannot contain itself"],
      )
    },
    RowMismatch(m) -> {
      let expected = resolve_row_in(checker, m.expected);
      let found = resolve_row_in(checker, m.found);
      let extra = atoms_difference(found.atoms, expected.atoms);
      let pe = print_row(printer_new(), expected);
      let pf = print_row(pe.printer, found);
      report_text(
        checker,
        b"E0302",
        span,
        Bytes::concat_all([context, b"|", pe.text, b"|", pf.text]),
        b"effect row mismatch: ".concat(context),
        Bytes::concat_all([b"expected ", pe.text, b", found ", pf.text]),
        List::concat(
          if extra.len() > 0 {
            [b"not permitted here: ".concat(backticked(extra.map(atom_text), b", "))]
          } else { [] },
          region_apart(expected, found),
        ),
      )
    },
  }

/// An atom of `row` that names a region where `other` names the resource the region is written as.
fn region_twin(row: Row, other: Row) -> Option<Atom> / {abort.raise} =
  row.atoms.fold(None, |acc: Option<Atom>, a: Atom|
    match acc {
      Some(_) -> acc,
      None -> match a.resource {
        RNamed(n) -> if written_label(n) != n
            && other.atoms.contains({ ..a, resource: RNamed(written_label(n)) }) { Some(a) }
        else { None },
        _ -> None,
      },
    })

/// Two rows that print alike and differ: one names a region, the other a resource of its name.
fn region_apart(expected: Row, found: Row) -> List<Bytes> / {abort.raise} =
  match match region_twin(found, expected) {
      Some(a) -> Some(a),
      None -> region_twin(expected, found),
    } {
    None -> [],
    Some(a) -> {
      let name = match a.resource { RNamed(n) -> written_label(n), _ -> b"" };
      [
        Bytes::concat_all([
          b"one `",
          name,
          b"` is the region `with_",
          a.effect,
          b"[",
          name,
          b"]` opens and the other is the resource of that name, which is all a row written outside the region names",
        ]),
        if a.effect == hold() {
          b"take the hold with its region as a label parameter, `<[r]>(h: Hold<T, [r]>)`, or what reads it through a row parameter, `<| e>`"
        } else { b"take what reads or writes the cell through a row parameter, `<| e>`" },
      ]
    },
  }

/// The module that declared the type `name` `opaque`, where that is not this one, and what it
/// publishes for the type.
fn closed_to(
  checker: Checker,
  name: Bytes,
) -> Option<{ home: Bytes, opaque: Opaque }> / {abort.raise} =
  match checker.types.get(name) {
    None -> None,
    Some(decl) -> match decl.opaque {
      None -> None,
      Some(opaque) -> if decl.owner == checker.module { None }
      else { Some({ home: module_name(checker, decl.owner), opaque: opaque }) },
    },
  }

/// What to say of a mismatch where one side is a `new` record and the other a record of any fields.
fn declared_apart(checker: Checker, expected: Type, found: Type) -> List<Bytes> / {abort.raise} = {
  let apart = |name: Bytes|
    Bytes::concat_all([
      b"`",
      name,
      b"` is declared with `new`, so no other record is one whatever its fields",
    ]);
  let note = |name: Bytes|
    match closed_to(checker, name) {
      Some(closed) ->
        prepend(
          Bytes::concat_all([
            apart(name),
            b", and it is opaque, so only `",
            closed.home,
            b"` builds one",
          ]),
          closed_notes(closed.home, closed.opaque),
        ),
      None ->
        [
          Bytes::concat_all([
            apart(name),
            b"; a record literal is one where a `",
            name,
            b"` is expected",
          ]),
        ],
    };
  match expected {
    TyNominal(n) -> match found { TyRecord(_) -> note(n.name), _ -> [] },
    TyRecord(_) -> match found { TyNominal(n) -> note(n.name), _ -> [] },
    _ -> [],
  }
}

fn report_text(
  checker: Checker,
  code: Bytes,
  span: Span,
  text: Bytes,
  message: Bytes,
  label: Bytes,
  notes: List<Bytes>,
) -> Checker =
  report(checker, {
    code: code,
    notes: notes.len(),
    labels: [label_at(checker.module, span, true, label)],
    text: text,
    message: message,
    notes_text: notes,
    severity: b"error",
    fixes: [],
  })

fn bits_text(op: Bytes) -> Bytes =
  if op == b"bitand" { b"&" }
  else if op == b"bitor" { b"|" }
  else if op == b"bitxor" { b"^" }
  else if op == b"shl" { b"<<" }
  else if op == b"shr" { b">>" }
  else { b">>>" }

fn expect(
  checker: Checker,
  span: Span,
  expected: Type,
  found: Type,
  context: Bytes,
) -> { checker: Checker, ok: Bool } / {abort.raise} = {
  let u = unify(checker.subst, checker.fresh, expected, found);
  let c = with_unified(checker, u);
  match u.error {
    Some(e) -> { checker: report_unify(c, e, span, context), ok: false },
    None -> { checker: c, ok: true },
  }
}

/// A bit operand's type is often still a variable here, so the obligation waits for `settle_bit_ops`.
fn note_bits(checker: Checker, span: Span, found: Type, what: Bytes) -> Checker =
  {
    ..checker,
    bit_ops: checker.bit_ops.push({ span: span, what: what, ty: found, builtin: false }),
  }

/// Resolved once the whole program is checked, so a variable here is read as what it settled to.
fn note_operand(checker: Checker, span: Span, ty: Type) -> Checker =
  {
    ..checker,
    operands: checker.operands.push({
      module: checker.module,
      span: span,
      ty: ty,
      owner: checker.walking,
    }),
  }

/// Resolved once the whole program is checked, as an operand is. What the program does not write has
/// no place a site could be found at, so none is noted for it.
fn note_typed(checker: Checker, span: Span, ty: Type, args: List<Type>) -> Checker =
  if span == dummy_span() { checker } else {
    {
      ..checker,
      typed: checker.typed.push({
        module: checker.module,
        span: span,
        ty: ty,
        args: args,
        owner: checker.walking,
      }),
    }
  }

fn settle_bit_ops(checker: Checker) -> Checker / {abort.raise} = {
  let entries = checker.bit_ops;
  entries.fold({ ..checker, bit_ops: [] }, |c: Checker, entry: BitOp| {
    let ty = resolve(c, entry.ty);
    let witnessed = match ty {
      TyVar(v) -> match c.witnessed.get(v) {
        Some(w) -> w.integer && !entry.builtin,
        None -> false,
      },
      _ -> false,
    };
    if witnessed { c } else {
      match ty {
        TyVar(_) ->
          report_error_at(
            c,
            b"E0210",
            entry.span,
            Bytes::concat_all([b"the integer type of ", entry.what, b" is not determined"]),
            b"nothing here says which integer type this is",
            [
              b"`Int` and the eight fixed-width types are the integer types",
              b"annotate the operand, or write a literal that pins it",
              if entry.builtin {
                b"a builtin over an integer type needs the type written where it is called, not a type parameter"
              } else { b"a type parameter takes the bit operators under `where integer(a)`" },
            ],
          ),
        TyCon(k) -> if k.args.len() == 0 && is_int_name(k.name) { c }
        else { bits_mismatch(c, entry, ty) },
        _ -> bits_mismatch(c, entry, ty),
      }
    }
  })
}

fn bits_mismatch(checker: Checker, entry: BitOp, ty: Type) -> Checker / {abort.raise} = {
  let name = type_text(ty);
  let notes = [b"`Int` and the eight fixed-width types are the integer types"];
  let stated = match ty {
    TyCon(k) -> match numeric_of(checker.numeric_types, k.name) { Some(_) -> true, None -> false },
    _ -> false,
  };
  if entry.builtin && stated {
    report_error_at(
      checker,
      b"E0223",
      entry.span,
      Bytes::concat_all([
        entry.what,
        b" is the builtin integers', and `",
        name,
        b"` states its own arithmetic",
      ]),
      Bytes::concat_all([b"has type `", name, b"`"]),
      [
        b"wrapping, saturating and checked arithmetic and the rotations act at a width, which a type that states `numeric` has not",
        b"its `numeric` gives it `+`, `-`, `*` and unary `-`; its module has a function for anything else",
      ],
    )
  } else {
    report_error_at(
      checker,
      b"E0201",
      entry.span,
      Bytes::concat_all([entry.what, b" is not defined on `", name, b"`"]),
      Bytes::concat_all([b"has type `", name, b"`"]),
      if name == b"Bool" { notes.push(bool_bits_note()) } else { notes },
    )
  }
}

fn bool_bits_note() -> Bytes = b"`Bool` has `&&`, `||` and `!`; the bit operators are integers only"

/// Both sides of a `++` are one type by then; which of the two joinable ones it is waits for `settle_concats`.
fn settle_concats(checker: Checker) -> Checker / {abort.raise} = {
  let entries = checker.concats;
  entries.fold({ ..checker, concats: [] }, |c: Checker, entry: ConcatSite| {
    let in_module: Checker = { ..c, module: entry.module };
    let ty = resolve(in_module, entry.ty);
    let judged: Checker = match concat_name(ty) {
      Some(_) -> in_module,
      None -> match ty {
        TyVar(_) ->
          report_error_at(
            in_module,
            b"E0210",
            entry.span,
            b"the type of this `++` is not determined",
            b"nothing here says whether this joins `String`s or `Bytes`",
            [b"annotate an operand, or write a literal that pins it"],
          ),
        other ->
          report_error_at(
            in_module,
            b"E0201",
            entry.span,
            Bytes::concat_all([b"`++` is not defined on `", type_text(other), b"`"]),
            b"joined here",
            [b"`++` joins two `String`s or two `Bytes`"],
          ),
      },
    };
    { ..judged, module: c.module }
  })
}

/// Whether `ty` names a `Columns` anywhere in it.
fn mentions_columns(ty: Type) -> Bool =
  match ty {
    TyVar(_) -> false,
    TyCon(c) ->
      c.name == b"Columns" || c.args.fold(false, |any: Bool, a: Type| any || mentions_columns(a)),
    TyFn(f) ->
      mentions_columns(f.ret)
        || f.params.fold(false, |any: Bool, p: Type| any || mentions_columns(p)),
    TyRecord(fs) -> fs.fold(false, |any: Bool, f: Field| any || mentions_columns(f.ty)),
    TyNominal(x) -> x.args.fold(false, |any: Bool, a: Type| any || mentions_columns(a)),
  }

/// The element types of the `Columns` `ty` names, outermost first.
fn columns_elements(ty: Type) -> List<Type> =
  match ty {
    TyVar(_) -> [],
    TyCon(c) ->
      c.args.fold(
        if c.name == b"Columns" && c.args.len() == 1 { c.args } else { [] },
        |acc: List<Type>, a: Type| acc.concat(columns_elements(a)),
      ),
    TyFn(f) ->
      f.params.fold(columns_elements(f.ret), |acc: List<Type>, p: Type|
        acc.concat(columns_elements(p))),
    TyRecord(fs) -> fs.fold([], |acc: List<Type>, f: Field| acc.concat(columns_elements(f.ty))),
    TyNominal(x) -> x.args.fold([], |acc: List<Type>, a: Type| acc.concat(columns_elements(a))),
  }

/// A `Columns` holds each field of its records apart, so wherever a call answers one, the element
/// must settle to a record of at least one field, or stay a type parameter, which the definition's
/// own callers settle.
fn settle_columns(checker: Checker) -> Checker / {abort.raise} = {
  let entries = checker.columns;
  entries.fold({ ..checker, columns: [] }, |c: Checker, entry: ColumnsSite| {
    let in_module: Checker = { ..c, module: entry.module };
    let judged: Checker = columns_elements(resolve(in_module, entry.ty)).fold(
      in_module,
      |k: Checker, elem: Type|
        match elem {
          TyVar(_) -> k,
          TyRecord(fs) -> if fs.len() > 0 { k } else {
            columns_refused(k, entry.span, b"a record of no fields has no column to count it by")
          },
          TyNominal(x) -> if x.fields.len() > 0 { k } else {
            columns_refused(
              k,
              entry.span,
              Bytes::concat_all([b"`", type_text(elem), b"` is not a record of fields"]),
            )
          },
          other ->
            columns_refused(
              k,
              entry.span,
              Bytes::concat_all([b"`", type_text(other), b"` is not a record"]),
            ),
        },
    );
    { ..judged, module: c.module }
  })
}

fn columns_refused(checker: Checker, span: Span, why: Bytes) -> Checker =
  report_error_at(checker, b"E0224", span, b"a `Columns` holds records, each field apart", why, [
    b"a `Columns<T>` lays out every field of `T` as an array of its own; `T` is a record type of at least one field",
    b"an `Array<T>` holds any type",
  ])

fn bind_all(
  checker: Checker,
  bindings: List<{ name: Bytes, ty: Type }>,
) -> Checker / {abort.raise} =
  bindings.fold(checker, |c: Checker, b: { name: Bytes, ty: Type }|
    { ..c, env: env_bind(c.env, b.name, monomorphic(b.ty)) })

// --- What a place expects ----------------------------------------------------------------------

/// What the place an expression sits in says of its type before the expression is checked, which is
/// all that makes a record literal a `new` record: the type, and what it has had to agree with.
type Hint = { ty: Type, met: Meetings }

/// A type beside one it has to agree with: a callee's parameter and the argument handed it, its
/// answer and what the call is expected to be, a list's element and the one before it. A variable
/// in `expected` stands for what `found` has in its place. `before` is what met before that.
type Meetings = | NothingMet | Meeting({ expected: Type, found: Type, before: Meetings })

fn hint_of(ty: Type) -> Option<Hint> = Some({ ty: ty, met: NothingMet })

/// The hint of an element, a branch or an arm after the first: what the place says has by then met
/// the type of those before it.
fn hint_after(hint: Option<Hint>, earlier: Type) -> Option<Hint> =
  match hint {
    Some(h) -> Some({ ty: h.ty, met: Meeting({ expected: h.ty, found: earlier, before: h.met }) }),
    None -> hint_of(earlier),
  }

fn met_of(hint: Option<Hint>) -> Meetings = match hint { Some(h) -> h.met, None -> NothingMet }

/// A hint's type as far as its head. A variable there is whatever it has met, if anything.
fn hinted(checker: Checker, hint: Option<Hint>) -> Option<Type> / {abort.raise} =
  match hint {
    None -> None,
    Some(h) -> match shallow(checker.subst, h.ty) {
      TyVar(v) -> found_for(checker, h.met, [v]),
      t -> Some(t),
    },
  }

/// How deep in an expected type a hint looks for the variable it stands on.
fn hint_room() -> Int = 16

/// What was found where one of `wanted` was expected. A variable found there is wanted in its turn.
fn found_for(checker: Checker, met: Meetings, wanted: List<Int>) -> Option<Type> / {abort.raise} =
  match met {
    NothingMet -> None,
    Meeting(m) -> match partner_of(checker, m.expected, m.found, wanted, hint_room()) {
      Some(TyVar(w)) -> found_for(checker, m.before, wanted.push(w)),
      None -> found_for(checker, m.before, wanted),
      found -> found,
    },
  }

/// The part of `found` that sits where one of `wanted` sits in `expected`, within `room` levels.
fn partner_of(
  checker: Checker,
  expected: Type,
  found: Type,
  wanted: List<Int>,
  room: Int,
) -> Option<Type> / {abort.raise} =
  if room <= 0 { None } else {
    match shallow(checker.subst, expected) {
      TyVar(v) -> if wanted.contains(v) { Some(shallow(checker.subst, found)) } else { None },
      TyCon(e) -> match shallow(checker.subst, found) {
        TyCon(f) -> if e.name != f.name { None }
        else { partners_of(checker, e.args, f.args, wanted, room - 1) },
        _ -> None,
      },
      TyNominal(e) -> match shallow(checker.subst, found) {
        TyNominal(f) -> if e.name != f.name { None }
        else { partners_of(checker, e.args, f.args, wanted, room - 1) },
        _ -> None,
      },
      TyFn(e) -> match shallow(checker.subst, found) {
        TyFn(f) ->
          partners_of(checker, e.params.push(e.ret), f.params.push(f.ret), wanted, room - 1),
        _ -> None,
      },
      TyRecord(es) -> match shallow(checker.subst, found) {
        TyRecord(fs) ->
          es.fold(None, |got: Option<Type>, field: Field|
            match got {
              Some(_) -> got,
              None -> match field_get(fs, field.name) {
                Some(t) -> partner_of(checker, field.ty, t, wanted, room - 1),
                None -> None,
              },
            }),
        _ -> None,
      },
    }
  }

fn partners_of(
  checker: Checker,
  expected: List<Type>,
  found: List<Type>,
  wanted: List<Int>,
  room: Int,
) -> Option<Type> / {abort.raise} =
  expected.fold({ at: 0, got: None }, |acc: { at: Int, got: Option<Type> }, e: Type|
    {
      at: acc.at + 1,
      got: match acc.got {
        Some(_) -> acc.got,
        None -> match found.at(acc.at) {
          Some(f) -> partner_of(checker, e, f, wanted, room),
          None -> None,
        },
      },
    }).got

/// The hint a field of a record that is itself expected takes.
fn field_hint(fields: List<Field>, name: Bytes, met: Meetings) -> Option<Hint> =
  match field_get(fields, name) { Some(t) -> Some({ ty: t, met: met }), None -> None }

/// A call's arguments; a lambda the callee calls once per element of its input is inferred under the
/// call, which is the iteration its body repeats with. Each is expected at its parameter's type:
/// `params` are the callee's, and `met` what its answer has met. `ranged` is the lambda called
/// with each element of a `range`. `waits` is the callee where its counts are not in yet: each
/// lambda may be one it repeats. `first` is the callee's first argument where it is typed
/// already, the value a call is made on: `exprs` are then the arguments after it.
fn infer_args(
  checker: Checker,
  exprs: List<Expr>,
  span: Span,
  repeats: List<Int>,
  waits: Option<Bytes>,
  params: List<Type>,
  met: Meetings,
  ranged: Option<Ranged>,
  first: Option<Type> = None,
) -> { checker: Checker, tys: List<Type>, row: Row } / {abort.raise} = {
  let before = match first { Some(_) -> 1, None -> 0 };
  let walked = range(before, before + exprs.len()).fold(
    {
      checker: checker,
      tys: match first { Some(ty) -> [ty], None -> [] },
      row: row_empty(),
      met: match ((first, params.at(0))) {
        (Some(ty), Some(p)) -> Meeting({ expected: p, found: ty, before: met }),
        _ -> met,
      },
    },
    |acc: { checker: Checker, tys: List<Type>, row: Row, met: Meetings }, i: Int| {
      let x = exprs.get(i - before);
      let param = params.at(i);
      let hint = match param { Some(p) -> Some({ ty: p, met: acc.met }), None -> None };
      let lambda = match x { ELambda(_) -> true, _ -> false };
      let looped = repeats.contains(i) && lambda;
      let ranging: Checker = match ranged {
        Some(r) -> if r.at != i || !lambda { acc.checker } else {
          {
            ..acc.checker,
            guards: guards::over_range(reader_of(acc.checker), acc.checker.guards, r.lo, r.hi),
          }
        },
        None -> acc.checker,
      };
      let o: Inferred = if looped {
        let inner: Inferred = infer({ ..ranging, over: Some(span), maybe: [] }, x, hint);
        { ..inner, checker: { ..inner.checker, over: acc.checker.over, maybe: acc.checker.maybe } }
      } else {
        match waits {
          Some(g) -> if !lambda { infer(ranging, x, hint) } else {
            let inner: Inferred = infer(
              {
                ..ranging,
                maybe: [{ callee: g, param: Some(i), span: span }].concat(ranging.maybe),
              },
              x,
              hint,
            );
            { ..inner, checker: { ..inner.checker, maybe: acc.checker.maybe } }
          },
          None -> infer(ranging, x, hint),
        }
      };
      let j: WithRow = join(o.checker, span, acc.row, o.row);
      {
        checker: j.checker,
        tys: acc.tys.push(o.ty),
        row: j.row,
        met: match param {
          Some(p) -> Meeting({ expected: p, found: o.ty, before: acc.met }),
          None -> acc.met,
        },
      }
    },
  );
  { checker: walked.checker, tys: walked.tys, row: walked.row }
}

/// An expression nothing encloses, typed with each default its calls on values copied: a default
/// is no part of the expression a walk reads, so it is typed where the walk ends.
fn infer_whole(
  checker: Checker,
  expr: Expr,
  hint: Option<Hint> = None,
) -> Inferred / {abort.raise} = {
  let o: Inferred = infer(checker, expr, hint);
  {
    ..o,
    checker: o.checker.copied_defaults.fold(
      { ..o.checker, copied_defaults: [] },
      |c: Checker, d: { expr: Expr, ty: Type }| {
        let typed: Inferred = infer(c, d.expr, hint_of(d.ty));
        expect_met(typed.checker, expr_span(d.expr), d.ty, typed.ty, b"a parameter's default")
      },
    ),
  }
}

/// The parameters a callee calls a number of times that grows with its input. A builtin's count is
/// fixed when the argument it iterates over is written out; a function value's is unknown, so each
/// of its parameters is taken to. `waits` is the callee where it is a definition: its counts are
/// read when the caller's group is settled, never by a walk.
fn callee_repeats(
  checker: Checker,
  func: Expr,
  args: List<Expr>,
) -> { params: List<Int>, waits: Option<Bytes> } / {abort.raise} = {
  let builtin = prelude_named(checker, func);
  if builtin != b"" {
    let r = builtin_repeats(builtin);
    {
      params: match args.at(r.over) {
        Some(x) -> if fixed_size(checker, x) { [] } else { r.params },
        None -> r.params,
      },
      waits: None,
    }
  } else {
    match callee_source(checker, func) {
      PerformVia(name) -> { params: [], waits: Some(name) },
      OpaquePerform -> { params: range(0, args.len()), waits: None },
      _ -> { params: [], waits: None },
    }
  }
}

/// The parameters of the definition `name` whose types hold a function, read off its signature
/// the first time it is called.
fn fn_holding(
  checker: Checker,
  name: Bytes,
) -> { checker: Checker, params: List<Int> } / {abort.raise} =
  match checker.fn_holding.get(name) {
    Some(params) -> { checker: checker, params: params },
    None -> {
      let params = match env_lookup(checker.env, name) {
        Some(scheme) -> match scheme.ty {
          TyFn(f) -> range(0, f.params.len()).filter(|i: Int| holds_fn(f.params.get(i))),
          _ -> [],
        },
        None -> [],
      };
      {
        checker: { ..checker, fn_holding: checker.fn_holding.insert(name, params) },
        params: params,
      }
    },
  }

/// The parameters a builtin calls once per element of its argument at `over`.
fn builtin_repeats(name: Bytes) -> { params: List<Int>, over: Int } =
  if name == b"List::map" || name == b"List::filter" { { params: [1], over: 0 } }
  else if name == b"List::fold" || name == b"Map::fold" || name == b"Bytes::position" {
    { params: [2], over: 0 }
  } else if name == b"iterate" { { params: [2], over: 1 } }
  else { { params: [], over: 0 } }

/// A literal, a list literal, or a `range` between two literals: a size the text fixes.
fn fixed_size(checker: Checker, e: Expr) -> Bool / {abort.raise} =
  match e {
    ELit(_) -> true,
    EList(_) -> true,
    EApp(a) ->
      prelude_named(checker, a.func) == b"range"
        && a.args.fold(true, |ok: Bool, x: Expr| ok && (match x { ELit(_) -> true, _ -> false })),
    _ -> false,
  }

/// Every row a repeated parameter's type holds: what its functions perform, once per call.
fn repeated_rows(
  checker: Checker,
  params: List<Type>,
  repeats: List<Int>,
) -> { atoms: List<Atom>, vars: List<Int> } / {abort.raise} =
  repeats.fold({ atoms: [], vars: [] }, |acc: { atoms: List<Atom>, vars: List<Int> }, i: Int|
    match params.at(i) { Some(t) -> rows_in(checker, t, acc), None -> acc })

fn rows_in(
  checker: Checker,
  t: Type,
  acc: { atoms: List<Atom>, vars: List<Int> },
) -> { atoms: List<Atom>, vars: List<Int> } / {abort.raise} =
  rows_of(checker, resolve(checker, t), acc)

fn rows_of(
  checker: Checker,
  t: Type,
  acc: { atoms: List<Atom>, vars: List<Int> },
) -> { atoms: List<Atom>, vars: List<Int> } / {abort.raise} =
  match t {
    TyFn(f) -> {
      let r = resolve_row_in(checker, f.effects);
      let own = {
        atoms: acc.atoms.concat(r.atoms),
        vars: match r.tail { Some(v) -> acc.vars.push(v), None -> acc.vars },
      };
      f.params.fold(
        rows_of(checker, f.ret, own),
        |a: { atoms: List<Atom>, vars: List<Int> }, p: Type| rows_of(checker, p, a),
      )
    },
    TyCon(c) ->
      c.args.fold(acc, |a: { atoms: List<Atom>, vars: List<Int> }, x: Type| rows_of(checker, x, a)),
    TyRecord(fs) ->
      fs.fold(acc, |a: { atoms: List<Atom>, vars: List<Int> }, f: Field| rows_of(checker, f.ty, a)),
    TyNominal(n) ->
      n.fields.fold(acc, |a: { atoms: List<Atom>, vars: List<Int> }, f: Field|
        rows_of(checker, f.ty, a)),
    TyVar(_) -> acc,
  }

/// A callee's own scaling atom, as its call performs it: a label variable stands for any label.
fn scales_like(scales: List<Atom>, a: Atom) -> Bool =
  scales.fold(false, |found: Bool, s: Atom|
    found
      || (s.effect == a.effect && mode_eq(s.mode, a.mode) && s.op == a.op
      && (s.resource == a.resource || (match s.resource { RVar(_) -> true, _ -> false }))))

/// A row variable a call performs under an iteration: the callee's own, or the one around the call.
/// `maybe` are the callee's own where its counts are not in yet.
fn repeat_tail(
  checker: Checker,
  tail: Option<Int>,
  vars: List<Int>,
  maybe: List<Maybe>,
  span: Span,
) -> Checker =
  match tail {
    None -> checker,
    Some(v) -> if vars.contains(v) {
      {
        ..checker,
        repeated_vars: checker.repeated_vars.push({ var: v, over: Some(span), maybe: [] }),
      }
    } else {
      let waits = maybe.concat(checker.maybe);
      if checker.over == None && waits.len() == 0 { checker } else {
        {
          ..checker,
          repeated_vars: checker.repeated_vars.push({ var: v, over: checker.over, maybe: waits }),
        }
      }
    },
  }

fn infer_all(
  checker: Checker,
  exprs: List<Expr>,
  span: Span,
) -> { checker: Checker, tys: List<Type>, row: Row } / {abort.raise} =
  exprs.fold(
    { checker: checker, tys: [], row: row_empty() },
    |acc: { checker: Checker, tys: List<Type>, row: Row }, expr: Expr| {
      let o: Inferred = infer(acc.checker, expr);
      let j: WithRow = join(o.checker, span, acc.row, o.row);
      { checker: j.checker, tys: acc.tys.push(o.ty), row: j.row }
    },
  )

/// `hint` is what the place `expr` sits in says its type is, which a record literal reads.
/// What `infer_here` answers, with a record literal's or update's type filed where it is written, so
/// the record is laid out as its type says.
fn infer(checker: Checker, expr: Expr, hint: Option<Hint> = None) -> Inferred / {abort.raise} = {
  let o: Inferred = infer_here(checker, expr, hint);
  match expr {
    ERecord(r) -> { ..o, checker: note_typed(o.checker, r.span, o.ty, []) },
    ERecordUpdate(r) -> { ..o, checker: note_typed(o.checker, r.span, o.ty, []) },
    _ -> o,
  }
}

fn infer_here(checker: Checker, expr: Expr, hint: Option<Hint>) -> Inferred / {abort.raise} =
  match expr {
    ELit(l) -> { checker: checker, ty: lit_type(l.lit), row: row_empty() },
    EBad(_) -> {
      let o: WithTy = new_ty(checker);
      { checker: o.checker, ty: o.ty, row: row_empty() }
    },
    EVar(v) -> {
      let o: Inferred = infer_var(checker, v.name);
      // Called or passed as a value, a wrapping builtin wraps at its first parameter's type.
      if !is_int_builtin(expr) { o } else {
        match o.ty {
          TyFn(f) -> match f.params.at(0) {
            Some(t) -> { checker: note_operand(o.checker, v.span, t), ty: o.ty, row: o.row },
            None -> o,
          },
          _ -> o,
        }
      }
    },
    EUnary(u) -> {
      let o: Inferred = infer(checker, u.operand);
      if u.op == b"neg" {
        {
          checker: note_operand(
            {
              ..o.checker,
              numerics: o.checker.numerics.push({ span: u.span, op: b"neg", ty: o.ty }),
            },
            u.span,
            o.ty,
          ),
          ty: o.ty,
          row: o.row,
        }
      } else if u.op == b"bitnot" {
        {
          checker: note_operand(
            note_bits(o.checker, expr_span(u.operand), o.ty, b"the operand of `~`"),
            u.span,
            o.ty,
          ),
          ty: o.ty,
          row: o.row,
        }
      } else {
        let x: Expected = expect(
          o.checker,
          expr_span(u.operand),
          bool_type(),
          o.ty,
          b"operand of a unary operator",
        );
        { checker: x.checker, ty: bool_type(), row: o.row }
      }
    },
    EBinary(b) -> infer_binary(checker, b.span, b.op, b.lhs, b.rhs),
    ELambda(l) -> {
      let outer = checker;
      let checker = barred(outer, b"a lambda");
      let pushed: Checker = { ..checker, env: env_push(checker.env) };
      let expected = match hinted(checker, hint) { Some(TyFn(f)) -> f.params, _ -> [] };
      let ps = l.params.fold(
        { checker: pushed, tys: [] },
        |acc: { checker: Checker, tys: List<Type> }, p: Param| {
          let t: WithTy = match p.ty {
            Some(te) -> {
              let o: WithTy = conv_type(acc.checker, te);
              { checker: hold_written(o.checker, te, o.ty, true), ty: o.ty }
            },
            // Unwritten, it is what the place expects there, where that is settled by now.
            None -> match expected.at(acc.tys.len()) {
              Some(e) -> match hinted(acc.checker, Some({ ty: e, met: met_of(hint) })) {
                Some(settled) -> { checker: acc.checker, ty: settled },
                None -> new_ty(acc.checker),
              },
              None -> new_ty(acc.checker),
            },
          };
          {
            checker: { ..t.checker, env: env_bind(t.checker.env, p.name.name, monomorphic(t.ty)) },
            tys: acc.tys.push(t.ty),
          }
        },
      );
      let entered: Checker = match ps.checker.guards.ranged {
        None -> ps.checker,
        Some(_) -> {
          let reader = reader_of(ps.checker);
          {
            ..ps.checker,
            guards: guards::entered(
              reader,
              ps.checker.guards,
              match l.params.at(l.params.len() - 1) {
                Some(p) -> (reader.name)({ module: None, name: p.name, span: p.name.span }),
                None -> Elsewhere,
              },
            ),
          }
        },
      };
      let written: { checker: Checker, ty: Option<Type> } = match l.ret {
        Some(te) -> {
          let w: WithTy = conv_type(entered, te);
          { checker: hold_written(w.checker, te, w.ty, false), ty: Some(w.ty) }
        },
        None -> { checker: entered, ty: None },
      };
      let answer = match written.ty {
        Some(t) -> hint_of(t),
        None -> match hinted(written.checker, hint) {
          Some(TyFn(f)) -> Some({ ty: f.ret, met: met_of(hint) }),
          _ -> None,
        },
      };
      let body: Inferred = infer(written.checker, l.body, answer);
      let checked: Checker = match written.ty {
        Some(t) ->
          expect_met(
            body.checker,
            expr_span(l.body),
            t,
            body.ty,
            b"the lambda's written return type",
          ),
        None -> body.checker,
      };
      let made: Inferred = {
        checker: note_typed(
          leaving({ ..checked, env: env_pop(checked.env) }, checker.guards),
          l.span,
          fn_type(ps.tys, body.ty, row_empty()),
          [],
        ),
        ty: fn_type(ps.tys, body.ty, body.row),
        row: row_empty(),
      };
      unbarred(outer, made)
    },
    EApp(a) -> match a.func {
      EField(f) -> {
        let b: Inferred = infer(checker, f.base);
        let d = dotted_callee(a.span, b, f.base, f.field, a.args, a.named, a.labels);
        // A named value is typed as an argument is, expected at its parameter's type.
        let taken: Took = range(0, d.rest.len()).fold(
          { checker: d.checker, rest: [], row: row_empty() },
          |acc: Took, k: Int|
            match d.rest.get(k) {
              FromName(j) -> {
                let x = a.named.get(j).value;
                let i = d.before + a.args.len() + k;
                let expected = match d.params.at(i) {
                  Some(p) -> Some({ ty: p, met: d.met }),
                  None -> None,
                };
                let o: Inferred = match ((d.waits, x)) {
                  (Some(g), ELambda(_)) -> {
                    let inner: Inferred = infer(
                      {
                        ..acc.checker,
                        maybe: [{ callee: g, param: Some(i), span: a.span }].concat(
                          acc.checker.maybe,
                        ),
                      },
                      x,
                      expected,
                    );
                    { ..inner, checker: { ..inner.checker, maybe: acc.checker.maybe } }
                  },
                  _ -> infer(acc.checker, x, expected),
                };
                let j1: WithRow = join(o.checker, a.span, acc.row, o.row);
                {
                  checker: j1.checker,
                  rest: acc.rest.push(Settled({ written: x, ty: o.ty })),
                  row: j1.row,
                }
              },
              FromDefault(copied) -> { ..acc, rest: acc.rest.push(Copied(copied)) },
              _ -> acc,
            },
        );
        dotted(a.span, d, taken, b, f.base, f.field, a.args, a.labels, hint, false)
      },
      _ -> infer_app(checker, a.span, a.func, a.args, a.labels, hint),
    },
    EIf(i) -> {
      let c: Inferred = infer(checker, i.cond);
      let cc: Checker = expect(
        c.checker,
        expr_span(i.cond),
        bool_type(),
        c.ty,
        b"condition of `if`",
      ).checker;
      let t: Inferred = infer(assuming(cc, i.cond, true), i.then_branch, hint);
      let el: Inferred = infer(
        assuming(leaving(t.checker, cc.guards), i.cond, false),
        i.else_branch,
        hint_after(hint, t.ty),
      );
      let agreed: { checker: Checker, ty: Type } = agree(
        leaving(el.checker, cc.guards),
        expr_span(i.else_branch),
        t.ty,
        el.ty,
        b"branches of `if` must agree",
      );
      let j1: WithRow = join(agreed.checker, i.span, c.row, t.row);
      let j2: WithRow = join(j1.checker, i.span, j1.row, el.row);
      { checker: j2.checker, ty: agreed.ty, row: j2.row }
    },
    EMatch(m) -> infer_match(checker, m.span, m.scrutinee, m.arms, hint),
    EBlock(b) -> {
      let pushed: Checker = { ..checker, env: env_push(checker.env) };
      let stmts: { checker: Checker, row: Row, fallbacks: List<Fallback> } = b.stmts.fold(
        { checker: pushed, row: row_empty(), fallbacks: [] },
        |acc: { checker: Checker, row: Row, fallbacks: List<Fallback> }, s: Stmt| {
          let o: StmtOut = infer_stmt(acc.checker, s, hint);
          let j: WithRow = join(o.checker, b.span, acc.row, o.row);
          {
            checker: j.checker,
            row: j.row,
            fallbacks: match o.fallback { Some(f) -> acc.fallbacks.push(f), None -> acc.fallbacks },
          }
        },
      );
      let tail: Inferred = match b.tail {
        Some(t) -> {
          let o: Inferred = infer(stmts.checker, t, hint);
          let j: WithRow = join(o.checker, b.span, stmts.row, o.row);
          { checker: j.checker, ty: o.ty, row: j.row }
        },
        None -> { checker: stmts.checker, ty: unit_type(), row: stmts.row },
      };
      let agreed: Joined = stmts.fallbacks.fold(
        { checker: tail.checker, ty: tail.ty, tails: [] },
        |acc: Joined, f: Fallback|
          join_next(acc, f.span, f.ty, b"the `else` of a `let ... else` is its block's value"),
      );
      let closed: Checker = close_tails(agreed.checker, agreed.tails);
      {
        checker: leaving({ ..closed, env: env_pop(closed.env) }, checker.guards),
        ty: agreed.ty,
        row: tail.row,
      }
    },
    ERecord(r) -> {
      let met = met_of(hint);
      match hinted(checker, hint) {
        Some(TyNominal(n)) if !tuple_apart(r.fields, n.fields) -> match closed_record(
            checker,
            r.span,
            n.name,
            b"this literal would be one",
          ) {
          // Its values are still walked, and nothing more is said of the record they would make.
          Some(refused) -> {
            let values = infer_all(refused, r.fields.map(|f: RecField| f.value), r.span);
            { checker: values.checker, ty: TyNominal(n), row: values.row }
          },
          None -> infer_nominal(checker, r.span, r.fields, n, met),
        },
        expected -> {
          let known = match expected { Some(TyRecord(fs)) -> fs, _ -> [] };
          let fs = r.fields.fold(
            { checker: checker, fs: [], row: row_empty() },
            |acc: { checker: Checker, fs: List<Field>, row: Row }, f: RecField| {
              let o: Inferred = infer(acc.checker, f.value, field_hint(known, f.name.name, met));
              let j: WithRow = join(o.checker, r.span, acc.row, o.row);
              { checker: j.checker, fs: acc.fs.push({ name: f.name.name, ty: o.ty }), row: j.row }
            },
          );
          { checker: fs.checker, ty: TyRecord(fields_sorted(fs.fs)), row: fs.row }
        },
      }
    },
    ERecordUpdate(r) -> infer_record_update(checker, r.span, r.base, r.fields),
    ETry(_) -> panic("`e?` is expanded away before the checker runs"),
    EField(f) -> {
      let b: Inferred = infer(checker, f.base);
      let base = resolve(b.checker, b.ty);
      match record_fields(base) {
        Some(fs) -> match field_get(fs, f.field.name) {
          Some(t) -> { checker: b.checker, ty: t, row: b.row },
          None -> {
            let known = fs.map(|x: Field| x.name);
            let o: WithTy = new_ty(
              report_error_at(
                b.checker,
                b"E0101",
                f.field.span,
                Bytes::concat_all([b"no field `", f.field.name, b"` on this record"]),
                b"unknown field",
                [
                  if known.len() == 0 { b"the record has no fields" }
                  else { b"available fields: ".concat(backticked(known, b", ")) },
                ],
              ),
            );
            { checker: o.checker, ty: o.ty, row: b.row }
          },
        },
        None -> {
          let o: WithTy = new_ty(
            report_error_at(
              b.checker,
              b"E0201",
              expr_span(f.base),
              Bytes::concat_all([b"cannot read field `", f.field.name, b"` here"]),
              Bytes::concat_all([b"this has type `", type_text(base), b"`, not a record"]),
              [b"annotate the value so its record type is known"],
            ),
          );
          { checker: o.checker, ty: o.ty, row: b.row }
        },
      }
    },
    EList(l) -> {
      let elem: WithTy = new_ty(checker);
      let each = match hinted(checker, hint) {
        Some(TyCon(c)) -> match c.args {
          [t] -> if c.name == b"List" { Some({ ty: t, met: met_of(hint) }) } else { None },
          _ -> None,
        },
        _ -> None,
      };
      let items = l.items.fold(
        { checker: elem.checker, row: row_empty(), ty: elem.ty, tails: [] },
        |acc: { checker: Checker, row: Row, ty: Type, tails: List<Int> }, x: Expr| {
          let o: Inferred = infer(acc.checker, x, hint_after(each, acc.ty));
          let j: WithRow = join(o.checker, l.span, acc.row, o.row);
          let n: Joined = join_next(
            { checker: j.checker, ty: acc.ty, tails: acc.tails },
            expr_span(x),
            o.ty,
            b"list elements must agree",
          );
          { checker: n.checker, row: j.row, ty: n.ty, tails: n.tails }
        },
      );
      let closed: Checker = close_tails(items.checker, items.tails);
      {
        checker: if l.items.len() == 0 { note_typed(closed, l.span, list_type(items.ty), []) }
        else { closed },
        ty: list_type(items.ty),
        row: items.row,
      }
    },
    EPerform(p) -> if !on_a_local(checker, p.eff) {
      infer_perform(checker, p.span, p.eff, p.op, p.resource, p.args)
    } else if names_effect(checker, p.eff) {
      let said = both_named(checker, p.eff);
      // Read as a perform only where the effect has the operation: a call meant for the binding
      // would otherwise be refused twice.
      match resolve_op(said, p.eff, p.op).hit {
        Some(_) -> infer_perform(said, p.span, p.eff, p.op, p.resource, p.args),
        None -> {
          let o: WithTy = new_ty(said);
          { checker: o.checker, ty: o.ty, row: row_empty() }
        },
      }
    } else {
      let b: Inferred = infer_var(checker, p.eff);
      let on = EVar({ span: p.eff.span, name: p.eff });
      let labels = match p.resource { Some(r) -> [r], None -> [] };
      let d = dotted_callee(p.span, b, on, p.op, p.args, [], labels);
      dotted(p.span, d, defaults_taken(d), b, on, p.op, p.args, labels, hint, true)
    },
    EHandle(h) -> infer_handle(checker, h.span, h.body, h.clauses, h.ret, h.vars, hint),
    EWithCell(c) ->
      unbarred(
        checker,
        infer_with_cell(
          barred(checker, b"a `with_cell` region"),
          c.span,
          c.resource,
          c.init,
          c.binder,
          c.body,
          hint,
        ),
      ),
    EWithHold(c) ->
      unbarred(
        checker,
        infer_with_hold(
          barred(checker, b"a `with_hold` region"),
          c.span,
          c.resource,
          c.acquire,
          c.release,
          c.binder,
          c.body,
          hint,
        ),
      ),
    ESimulate(s) ->
      unbarred(
        checker,
        infer_simulate(barred(checker, b"a `simulate` body"), s.span, s.body, hint),
      ),
    EParallel(v) ->
      unbarred(
        checker,
        infer_parallel(barred(checker, b"a `parallel` branch"), v.span, v.branches),
      ),
    ETryBlock(t) ->
      unbarred(
        checker,
        infer_try_block(barred(checker, b"a `try` body"), t.span, t.raise, t.body, hint),
      ),
    ETagged(t) -> infer_tagged(checker, t),
  }

/// What a tag answers of a text it refuses: why, and where in the text, in characters. Of the
/// texts around holes it says which one too.
fn refusal_type(holed: Bool) -> Type / {abort.raise} = {
  let said = [{ name: b"message", ty: string_type() }, { name: b"offset", ty: int_type() }];
  TyRecord(fields_sorted(if holed { said.push({ name: b"part", ty: int_type() }) } else { said }))
}

fn tag_rule(t: Tagged) -> Bytes =
  if t.holes.len() == 0 {
    Bytes::concat_all([
      b"`",
      t.tag.name,
      b"\"..\"` is the call `",
      t.tag.name,
      b"::literal(\"..\")`, which the check runs: a function of one `String` answering `Result<T, {message: String, offset: Int}>`, with no parameters of its own and a row that holds nothing but raises",
    ])
  } else {
    Bytes::concat_all([
      b"`",
      t.tag.name,
      b"\"..{h}..\"` is the call `",
      t.tag.name,
      b"::fill(c, [h])` of what `",
      t.tag.name,
      b"::compile([\"..\", \"..\"])` answered the check: `compile` a function of one `List<String>` answering `Result<C, {message: String, offset: Int, part: Int}>` and `fill` one of a `C` and a `List<H>`, each with no parameters of its own and a row that holds nothing but raises",
    ])
  }

fn not_a_tag(checker: Checker, t: Tagged, callee: QName, message: Bytes, label: Bytes) -> Checker =
  report_error_at(
    checker,
    b"E0152",
    t.tag.span,
    Bytes::concat_all([b"`", t.tag.name, b"::", callee.name.name, b"` ", message]),
    label,
    [tag_rule(t)],
  )

/// What a tagged literal calls of its tag, held to what a tag's function is: `takes` in and
/// `answers` out, with no parameter of its own, nothing performed but raises, and no recursion
/// with what holds the literal. `row` is what it raises, and `name` what it is declared as.
fn tag_fn(
  checker: Checker,
  t: Tagged,
  callee: QName,
  takes: List<Type>,
  answers: Type,
) -> { checker: Checker, row: Row, name: Bytes } / {abort.raise} = {
  let f: Inferred = infer_var(checker, callee);
  let named: Checker = called(f.checker, t.tag.span);
  match declared_value(named, callee) {
    // A name that names nothing is said by the lookup.
    None -> { checker: named, row: row_empty(), name: b"" },
    Some(name) -> {
      let refused = |cc: Checker, message: Bytes, label: Bytes|
        { checker: not_a_tag(cc, t, callee, message, label), row: row_empty(), name: name };
      let generic = match env_lookup(named.env, name) {
        Some(sc) -> sc.ty_vars.len() + sc.row_vars.len() + sc.label_vars.len() > 0,
        None -> false,
      };
      // Whether it is in a recursion with what holds the literal is its group's to say.
      let c: Checker = if !named.own_fns.contains(name) { named } else {
        {
          ..named,
          tag_uses: named.tag_uses.push({ owner: named.walking, name: name, t: t, callee: callee }),
        }
      };
      match resolve(c, f.ty) {
        TyFn(fn_) -> {
          let unified = unify(c.subst, c.fresh, fn_type(takes, answers, fn_.effects), f.ty);
          let u: Checker = with_unified(c, unified);
          let row = resolve_row_in(u, fn_.effects);
          if generic { refused(u, b"takes parameters of its own", b"a literal gives it none") }
          else if unified.error != None {
            refused(
              u,
              Bytes::concat_all([b"has type `", type_text(resolve(u, f.ty)), b"`"]),
              b"not what a tagged literal calls",
            )
          } else if !row_is_pure_but_raise(row) {
            refused(
              u,
              Bytes::concat_all([b"performs `", row_text(row), b"`"]),
              b"a tag's function only raises",
            )
          } else { { checker: u, row: row, name: name } }
        },
        other ->
          refused(
            c,
            Bytes::concat_all([b"has type `", type_text(other), b"`"]),
            b"not what a tagged literal calls",
          ),
      }
    },
  }
}

/// `tag"text"` is the call `tag::literal("text")`, whose answer the check reads before anything
/// runs: its value is what the call answers `Ok` of, and nothing is left for it to perform. With
/// holes it is `tag::fill` called on what `tag::compile` answers `Ok` of for the texts, and on the
/// holes, each of the one type `fill` takes: it performs what they perform, and raises as `fill` does.
fn infer_tagged(checker: Checker, t: Tagged) -> Inferred / {abort.raise} = {
  let holed = t.holes.len() > 0;
  let value: WithTy = new_ty(checker);
  let parsed = tag_fn(
    value.checker,
    t,
    tagged_parser(t),
    [if holed { list_type(string_type()) } else { string_type() }],
    TyCon({ name: b"Result", args: [value.ty, refusal_type(holed)] }),
  );
  if !holed { { checker: parsed.checker, ty: value.ty, row: row_empty() } } else {
    let hole: WithTy = new_ty(parsed.checker);
    let answer: WithTy = new_ty(hole.checker);
    // A tag with no parser is said once, by the lookup of the parser.
    let filled = if parsed.name == b"" { { checker: answer.checker, row: row_empty(), name: b"" } }
    else { tag_fn(answer.checker, t, tagged_filler(t), [value.ty, list_type(hole.ty)], answer.ty) };
    let held: WithRow = t.holes.fold(
      { checker: filled.checker, row: row_empty() },
      |acc: WithRow, h: Hole| {
        let o: Inferred = infer(acc.checker, h.value, hint_of(hole.ty));
        let met: Checker = expect_met(
          o.checker,
          expr_span(h.value),
          hole.ty,
          o.ty,
          b"a hole of a tagged literal",
        );
        join(met, t.span, acc.row, o.row)
      },
    );
    let recorded: Checker = filled.row.atoms.fold(held.checker, |cc: Checker, atom: Atom|
      record_site(cc, atom, t.span, PerformVia(filled.name)));
    let j: WithRow = join(recorded, t.span, held.row, filled.row);
    { checker: j.checker, ty: answer.ty, row: j.row }
  }
}

/// The branches' answers as a tuple, which is what evaluating them left to right answers.
fn infer_parallel(checker: Checker, span: Span, branches: List<Expr>) -> Inferred / {abort.raise} = {
  let out = range(0, branches.len()).fold(
    { checker: checker, fs: [], row: row_empty(), rows: [] },
    |acc: { checker: Checker, fs: List<Field>, row: Row, rows: List<{ span: Span, row: Row }> }, i: Int| {
      let b = branches.get(i);
      let o: Inferred = infer(acc.checker, b);
      let j: WithRow = join(o.checker, span, acc.row, o.row);
      {
        checker: j.checker,
        fs: acc.fs.push({ name: b"_".concat(ascii_of_int(i)), ty: o.ty }),
        row: j.row,
        rows: acc.rows.push({ span: expr_span(b), row: o.row }),
      }
    },
  );
  let site = { module: out.checker.module, span: span, branches: out.rows };
  {
    checker: { ..out.checker, parallels: out.checker.parallels.push(site) },
    ty: TyRecord(fields_sorted(out.fs)),
    row: out.row,
  }
}

/// A tuple written where a record with no positional field is expected is another type, not that
/// record with its fields misnamed.
fn tuple_apart(written: List<RecField>, fields: List<Field>) -> Bool =
  match written {
    [first, ..] -> first.name.name == b"_0" && field_get(fields, b"_0") == None,
    [] -> false,
  }

/// The refusal of a literal or an update that would make a value of the `opaque` record `name`
/// outside the module that declares it, or in a `pub fn`'s default, which each caller that omits
/// the argument is handed. `None` where the record may be built here.
fn closed_record(
  checker: Checker,
  span: Span,
  name: Bytes,
  how: Bytes,
) -> Option<Checker> / {abort.raise} =
  match checker.types.get(name) {
    None -> None,
    Some(decl) -> match decl.opaque {
      None -> None,
      Some(opaque) -> if decl.owner != checker.module {
        let home = module_name(checker, decl.owner);
        Some(
          report_error_at_and(
            checker,
            b"E0220",
            span,
            Bytes::concat_all([b"only `", home, b"` builds a `", name, b"`"]),
            how,
            { module: decl.owner, span: opaque.span },
            b"declared `opaque` here",
            closed_notes(home, opaque),
          ),
        )
      } else if checker.copied {
        Some(
          report_error_at(
            checker,
            b"E0122",
            span,
            Bytes::concat_all([
              b"a default on a `pub fn` cannot build `",
              simple_name_of(name),
              b"`",
            ]),
            b"an opaque type, built only in this module",
            [
              b"the default is copied into every call site that omits the argument, and a caller in another module may not build one",
            ],
          ),
        )
      } else { None },
    },
  }

/// A record literal where a `new` record is expected is one: it names each of that record's fields,
/// and each value meets the type the declaration gives its field.
fn infer_nominal(
  checker: Checker,
  span: Span,
  written: List<RecField>,
  n: { name: Bytes, args: List<Type>, fields: List<Field> },
  met: Meetings,
) -> Inferred / {abort.raise} = {
  let known = backticked(n.fields.map(|field: Field| field.name), b", ");
  let walked: WithRow = written.fold(
    { checker: checker, row: row_empty() },
    |acc: WithRow, f: RecField| {
      let o: Inferred = infer(acc.checker, f.value, field_hint(n.fields, f.name.name, met));
      let met: Checker = match field_get(n.fields, f.name.name) {
        Some(t) -> expect_met(o.checker, expr_span(f.value), t, o.ty, b"a field of a `new` record"),
        None ->
          report_error_at(
            o.checker,
            b"E0101",
            f.name.span,
            Bytes::concat_all([b"no field `", f.name.name, b"` on `", n.name, b"`"]),
            b"unknown field",
            [
              Bytes::concat_all([
                b"a `",
                n.name,
                b"` is expected here, and its fields are ",
                known,
              ]),
            ],
          ),
      };
      join(met, span, acc.row, o.row)
    },
  );
  let named = written.map(|f: RecField| f.name.name);
  let omitted = n.fields.filter(|field: Field| !named.contains(field.name));
  let whole: Checker = if omitted.len() == 0 { walked.checker } else {
    report_error_at(
      walked.checker,
      b"E0201",
      span,
      Bytes::concat_all([b"this record does not name every field of `", n.name, b"`"]),
      b"missing: ".concat(backticked(omitted.map(|field: Field| field.name), b", ")),
      [
        Bytes::concat_all([
          b"a `",
          n.name,
          b"` is expected here; write every field, or change some of one you hold with `{ ..base, field: value }`",
        ]),
      ],
    )
  };
  // A key the declaration left to a parameter is judged here, as a constructor's is at its use.
  let keyed: Checker = if n.args.len() == 0 { whole }
  else { n.fields.fold(whole, |c: Checker, field: Field| note_map_keys(c, span, field.ty)) };
  { checker: keyed, ty: TyNominal(n), row: walked.row }
}

/// `{..b, f: e}` answers the base's own record type with the written fields replaced, and publishes the
/// base's field list for the lowering. A base whose type the substitution does not hold yet waits for
/// `settle_updates`, so a lambda parameter the callee only types later still has a shape.
fn infer_record_update(
  checker: Checker,
  span: Span,
  base: Expr,
  written: List<RecField>,
) -> Inferred / {abort.raise} = {
  let b: Inferred = infer(checker, base);
  let known = match record_fields(shallow(b.checker.subst, b.ty)) { Some(fs) -> fs, None -> [] };
  let fs = written.fold(
    { checker: b.checker, fs: [], row: b.row },
    |acc: { checker: Checker, fs: List<UpdateField>, row: Row }, field: RecField| {
      let o: Inferred = infer(
        acc.checker,
        field.value,
        field_hint(known, field.name.name, NothingMet),
      );
      let j: WithRow = join(o.checker, span, acc.row, o.row);
      {
        checker: j.checker,
        fs: acc.fs.push({ name: field.name.name, span: field.name.span, ty: o.ty }),
        row: j.row,
      }
    },
  );
  let base_span = expr_span(base);
  match resolve(fs.checker, b.ty) {
    TyVar(_) -> {
      let t: WithTy = new_ty(fs.checker);
      let c: Checker = t.checker;
      {
        checker: {
          ..c,
          updates: c.updates.push({
            module: c.module,
            span: span,
            base_span: base_span,
            base: b.ty,
            written: fs.fs,
            result: t.ty,
            owner: c.walking,
          }),
        },
        ty: t.ty,
        row: fs.row,
      }
    },
    shape -> {
      let o: WithTy = update_shape(fs.checker, span, base_span, shape, fs.fs);
      { checker: o.checker, ty: o.ty, row: fs.row }
    },
  }
}

/// Each written field is one of the base's, and where `kept`, of the type the base has for it.
fn update_fields(
  checker: Checker,
  base_span: Span,
  fs: List<Field>,
  written: List<UpdateField>,
  kept: Bool,
) -> Checker / {abort.raise} = {
  let known = backticked(fs.map(|field: Field| field.name), b", ");
  written.fold(checker, |c: Checker, w: UpdateField|
    match field_get(fs, w.name) {
      Some(t) -> if !kept { c }
      else { expect_met(c, w.span, t, w.ty, b"an updated field of a `new` record") },
      None ->
        report_error_at_and(
          c,
          b"E0117",
          w.span,
          Bytes::concat_all([b"the record being updated has no field `", w.name, b"`"]),
          b"not a field of the base",
          location_of(c, base_span),
          b"this is the record being updated",
          [b"an update replaces fields, it does not add them; available fields: ".concat(known)],
        ),
    })
}

/// The base's field list, published for the lowering.
fn update_shaped(checker: Checker, span: Span, fs: List<Field>) -> Checker =
  {
    ..checker,
    update_shapes: checker.update_shapes.push({
      module: checker.module,
      span: span,
      names: fs.map(|field: Field| field.name),
      owner: checker.walking,
    }),
  }

/// The type an update answers, and the field list the lowering copies from, once the base's type is known.
fn update_shape(
  checker: Checker,
  span: Span,
  base_span: Span,
  base: Type,
  written: List<UpdateField>,
) -> WithTy / {abort.raise} =
  match base {
    TyRecord(fs) -> {
      let checked: Checker = update_fields(checker, base_span, fs, written, false);
      // A name the base lacks is reported, not added: the answer is the base's record either way.
      let kept = written.filter(|w: UpdateField|
        match field_get(fs, w.name) { Some(_) -> true, None -> false });
      {
        checker: update_shaped(checked, span, fs),
        ty: TyRecord(
          fields_sorted(fs.concat(kept.map(|w: UpdateField| { name: w.name, ty: w.ty }))),
        ),
      }
    },
    // A `new` record stays the one it was, so a written field keeps the type declared for it.
    TyNominal(n) ->
      {
        checker: update_shaped(
          match closed_record(checker, span, n.name, b"this update would answer a new one") {
            Some(refused) -> refused,
            None -> update_fields(checker, base_span, n.fields, written, true),
          },
          span,
          n.fields,
        ),
        ty: base,
      },
    TyVar(_) ->
      new_ty(
        report_error_at(
          checker,
          b"E0116",
          base_span,
          b"the type of the record being updated is not known here",
          b"nothing here says which record this is",
          [b"annotate the binder, the lambda parameter or the function this call answers from"],
        ),
      ),
    other ->
      new_ty(
        report_error_at(
          checker,
          b"E0116",
          base_span,
          b"the value being updated is not a record",
          Bytes::concat_all([b"this has type `", type_text(other), b"`"]),
          [b"`{..b, f: e}` replaces fields of a record, and only a record has fields"],
        ),
      ),
  }

/// An update whose base was still a variable where it stood: the substitution is complete here.
fn settle_updates(checker: Checker) -> Checker / {abort.raise} = {
  let entries = checker.updates;
  entries.fold({ ..checker, updates: [] }, |c: Checker, entry: UpdateSite| {
    let in_module: Checker = { ..c, module: entry.module, walking: entry.owner };
    let o: WithTy = update_shape(
      in_module,
      entry.span,
      entry.base_span,
      resolve(in_module, entry.base),
      entry.written,
    );
    let unified: Checker = expect(
      o.checker,
      entry.span,
      entry.result,
      o.ty,
      b"record update",
    ).checker;
    { ..unified, module: c.module, walking: c.walking }
  })
}

/// `checker` with the type of a read of `name` at `span` filed where the name is a variable of the
/// handler whose clause is walked: the read is written out as one of the runtime's, which no
/// binding's layout describes.
fn held_read(checker: Checker, name: Bytes, span: Span, ty: Type) -> Checker =
  if checker.assignable.vars.len() == 0 { checker } else {
    match env_local(checker.env, name) {
      Some(l) -> if checker.assignable.vars.fold(
          false,
          |found: Bool, v: { stamp: Int, name: Bytes, ty: Type }| found || v.stamp == l.stamp,
        ) { note_typed(checker, read_site(span), ty, []) }
      else { checker },
      None -> checker,
    }
  }

fn infer_var(checker: Checker, qname: QName) -> Inferred / {abort.raise} = {
  let k: WithKey = value_key(checker, qname);
  match k.key {
    None -> {
      let o: WithTy = new_ty(k.checker);
      { checker: o.checker, ty: o.ty, row: row_empty() }
    },
    Some(key) -> if key.prelude && is_cell_builtin(key.name) {
      let o: WithTy = new_ty(
        report_error_at(
          k.checker,
          b"E0304",
          qname.span,
          Bytes::concat_all([b"`", key.name, b"` must be called directly"]),
          b"used as a value",
          [
            b"the atom it performs names the region of the cell it is given, so it cannot be passed around as a first-class function",
          ],
        ),
      );
      { checker: o.checker, ty: o.ty, row: row_empty() }
    } else {
      match env_lookup(k.checker.env, key.name) {
        Some(sc) -> {
          let inst = instantiate_with(sc, k.checker.fresh);
          let c: Checker = crossed({ ..k.checker, fresh: inst.fresh }, key.name, qname.span);
          let constrained: Checker = note_constraints(
            note_map_keys(c, qname.span, inst.ty),
            qname.span,
            key.name,
            inst.args,
          );
          let own = constrained.own_fns.contains(key.name);
          let through = match qname.module {
            Some(binder) -> if of_module(binder.name) != None
                || find_module_binding(scope_of(constrained).modules, binder.name) != None { None }
            else { declaring_type(constrained.resolved, constrained.module, binder.name) },
            None -> None,
          };
          let named: Checker = match through {
            // A language type's function its home module declares is written out as that
            // module's. The prelude's is its own name as written.
            None -> if is_bare(qname) { constrained } else if !key.prelude {
              match of_language_type(constrained, qname) {
                Found(m) -> if m.qname.module == None { constrained } else {
                  {
                    ..constrained,
                    member_sites: sited(constrained, {
                      reaches: [],
                      named: [],
                      module: constrained.module,
                      span: qname.span,
                      qualifier: match m.qname.module { Some(q) -> q.name, None -> b"" },
                      name: m.qname.name.name,
                      callee: b"",
                      owner: constrained.walking,
                    }),
                  }
                },
                _ -> constrained,
              }
            } else { constrained },
            Some(t) ->
              {
                ..constrained,
                member_sites: sited(constrained, {
                  reaches: [],
                  named: [],
                  module: constrained.module,
                  span: qname.span,
                  qualifier: of_binder(constrained.resolved.scopes.get(t.owner).module),
                  name: member_name(t.simple, qname.name.name),
                  callee: b"",
                  owner: constrained.walking,
                }),
              },
          };
          let referred: Checker = if !own { named }
          else { { ..named, refs: named.refs.push(key.name) } };
          let noted: Checker = if inst.args.len() == 0 || !own { referred } else {
            {
              ..referred,
              group_fills: referred.group_fills.push({
                module: referred.module,
                span: qname.span,
                callee: key.name,
                args: inst.args,
              }),
            }
          };
          // A constructor's labels are its type's arguments, which no call fills.
          let ls = if inst.labels.len() > 0 && noted.ctor_index.contains(key.name) { [] }
          else { inst.labels };
          // Every `Columns` is made by a call that answers one, so its element is judged there.
          let made = match inst.ty { TyFn(f) -> f.ret, other -> other };
          let columned: Checker = if mentions_columns(made) {
            {
              ..noted,
              columns: noted.columns.push({ module: noted.module, span: qname.span, ty: made }),
            }
          } else { noted };
          let typed: Checker = match env_depth_of(columned.env, key.name) {
            Some(d) -> if d > 0 { held_read(columned, key.name, qname.span, inst.ty) }
            else { note_typed(columned, qname.span, inst.ty, inst.args) },
            None -> note_typed(columned, qname.span, inst.ty, inst.args),
          };
          let named: Checker = if typed.cell_named || !is_cell(resolve(typed, inst.ty)) { typed }
          else {
            report_error_at(
              typed,
              b"E0446",
              qname.span,
              Bytes::concat_all([b"the cell `", qname.name.name, b"` is used as a value"]),
              b"a cell is a name, not a value",
              cell_is_a_name(),
            )
          };
          {
            checker: note_labels(named, qname.span, key.name, ls, inst.ty),
            ty: inst.ty,
            row: row_empty(),
          }
        },
        None -> {
          let o: WithTy = new_ty(unknown_name(k.checker, qname));
          { checker: o.checker, ty: o.ty, row: row_empty() }
        },
      }
    },
  }
}

fn crossed(checker: Checker, name: Bytes, span: Span) -> Checker / {abort.raise} =
  if checker.sim_scope == 0 { checker } else {
    match env_depth_of(checker.env, name) {
      Some(d) -> if d > 0 && d < checker.sim_scope {
        { ..checker, crossings: checker.crossings.push({ name: name, span: span }) }
      } else { checker },
      None -> checker,
    }
  }

/// `Int` and the eight widths are the integer types; the bit operators are defined at those nine only.
fn is_int_name(n: Bytes) -> Bool =
  n == b"Int" || n == b"U8" || n == b"U16" || n == b"U32" || n == b"U64" || n == b"I8"
    || n == b"I16"
    || n == b"I32"
    || n == b"I64"
    || n == b"U128"
    || n == b"I128"

/// Whether a `/` or `%` can meet a zero divisor: a `Float` answers one, and a literal other than zero
/// is never one. An operand type not settled yet may still be an integer's.
fn divides_by_zero(checker: Checker, op: Bytes, ty: Type, divisor: Expr) -> Bool / {abort.raise} =
  (op == b"div" || op == b"rem") && !nonzero_literal(divisor)
    && (match resolve(checker, ty) { TyCon(k) -> k.name != b"Float", _ -> true })

fn nonzero_literal(e: Expr) -> Bool =
  match e {
    ELit(l) -> match l.lit {
      LInt(v) -> v != 0,
      LFixed(_, v) -> v != 0,
      LWide(_, hi, lo) -> hi != 0 || lo != 0,
      _ -> false,
    },
    EUnary(u) -> u.op == b"neg" && nonzero_literal(u.operand),
    _ -> false,
  }

fn is_bits(op: Bytes) -> Bool =
  op == b"bitand" || op == b"bitor" || op == b"bitxor" || op == b"shl" || op == b"shr"
    || op == b"ushr"

/// The two types `++` joins, when the substitution already says which one this is.
fn concat_name(ty: Type) -> Option<Bytes> =
  match ty {
    TyCon(k) -> if k.args.len() == 0 && (k.name == b"String" || k.name == b"Bytes") { Some(k.name) }
    else { None },
    _ -> None,
  }

/// `String ++ Bytes` names both sides rather than reporting one against the other; there is no coercion.
fn mixed_concat(checker: Checker, lspan: Span, lt: Type, rspan: Span, rt: Type) -> Option<Checker> =
  match concat_name(lt) {
    None -> None,
    Some(ln) -> match concat_name(rt) {
      None -> None,
      Some(rn) -> if ln == rn { None } else {
        Some(
          err_labels(
            checker,
            b"E0201",
            Bytes::concat_all([b"`++` cannot join `", ln, b"` and `", rn, b"`"]),
            [
              label_at(checker.module, lspan, true, Bytes::concat_all([b"this is a `", ln, b"`"])),
              label_at(checker.module, rspan, false, Bytes::concat_all([b"this is a `", rn, b"`"])),
            ],
            [b"there is no coercion between them: `Bytes::of_string` and `String::of_bytes` cross"],
          ),
        )
      },
    },
  }

fn infer_binary(
  checker: Checker,
  span: Span,
  op: Bytes,
  lhs: Expr,
  rhs: Expr,
) -> Inferred / {abort.raise} = {
  let l: Inferred = infer(checker, lhs);
  // The right of `&&` runs where the left held, and the right of `||` where it did not.
  let r: Inferred = if op == b"and" || op == b"or" {
    let o: Inferred = infer(assuming(l.checker, lhs, op == b"and"), rhs, hint_of(l.ty));
    { ..o, checker: leaving(o.checker, l.checker.guards) }
  } else { infer(l.checker, rhs, hint_of(l.ty)) };
  let j: WithRow = join(r.checker, span, l.row, r.row);
  // A shift's operand is its left; every other operator here reads both sides at one type.
  let c: Checker = if op == b"and" || op == b"or" || op == b"concat" { j.checker }
  else { note_operand(j.checker, span, l.ty) };
  if is_arithmetic(op) || is_ordered(op) {
    let x: Expected = expect(
      c,
      expr_span(rhs),
      l.ty,
      r.ty,
      b"both sides of a comparison must have one type",
    );
    let noted: Checker = if x.ok {
      { ..x.checker, numerics: x.checker.numerics.push({ span: span, op: op, ty: l.ty }) }
    } else { x.checker };
    let divisor: { checker: Checker, zero: Bool } = if !divides_by_zero(noted, op, l.ty, rhs) {
      { checker: noted, zero: false }
    } else {
      let o = guards::nonzero(reader_of(noted), noted.guards, rhs);
      { checker: { ..noted, guards: o.g }, zero: !o.ok }
    };
    if divisor.zero {
      {
        checker: record_site(
          note_raise(divisor.checker, span, ZeroDivisor),
          abort_atom(),
          span,
          DirectPerform,
        ),
        ty: l.ty,
        row: { ..j.row, atoms: atoms_insert(j.row.atoms, abort_atom()) },
      }
    } else {
      {
        checker: divisor.checker,
        ty: if is_arithmetic(op) { l.ty } else { bool_type() },
        row: j.row,
      }
    }
  } else if is_bits(op) {
    // A shift's right operand is a count: an `Int` whatever the word is.
    let shifting = op == b"shl" || op == b"shr" || op == b"ushr";
    let c1: Checker = note_bits(
      c,
      expr_span(lhs),
      l.ty,
      Bytes::concat_all([b"the left operand of `", bits_text(op), b"`"]),
    );
    let c2: Checker = if shifting {
      expect(
        c1,
        expr_span(rhs),
        int_type(),
        r.ty,
        Bytes::concat_all([b"the count of a `", bits_text(op), b"` is an `Int`"]),
      ).checker
    } else {
      let c1b: Checker = note_bits(
        c1,
        expr_span(rhs),
        r.ty,
        Bytes::concat_all([b"the right operand of `", bits_text(op), b"`"]),
      );
      expect(
        c1b,
        expr_span(rhs),
        l.ty,
        r.ty,
        Bytes::concat_all([b"both operands of `", bits_text(op), b"` have one type"]),
      ).checker
    };
    { checker: c2, ty: l.ty, row: j.row }
  } else if op == b"and" || op == b"or" {
    let c1: Checker = expect(c, expr_span(lhs), bool_type(), l.ty, b"left operand").checker;
    let c2: Checker = expect(c1, expr_span(rhs), bool_type(), r.ty, b"right operand").checker;
    { checker: c2, ty: bool_type(), row: j.row }
  } else if op == b"concat" {
    match mixed_concat(c, expr_span(lhs), resolve(c, l.ty), expr_span(rhs), resolve(c, r.ty)) {
      Some(reported) -> { checker: reported, ty: l.ty, row: j.row },
      None -> {
        let x: Expected = expect(
          c,
          expr_span(rhs),
          l.ty,
          r.ty,
          b"both operands of `++` have one type",
        );
        let noted: Checker = if x.ok {
          {
            ..x.checker,
            concats: x.checker.concats.push({ module: x.checker.module, span: span, ty: l.ty }),
          }
        } else { x.checker };
        { checker: noted, ty: l.ty, row: j.row }
      },
    }
  } else {
    let c1: Checker = expect(
      c,
      expr_span(rhs),
      l.ty,
      r.ty,
      b"both sides of a comparison must have one type",
    ).checker;
    {
      checker: {
        ..c1,
        comparisons: c1.comparisons.push({ module: c1.module, span: span, ty: l.ty }),
      },
      ty: bool_type(),
      row: j.row,
    }
  }
}

/// A `let ... else` block, whose value the enclosing block's tail must agree with.
type Fallback = { span: Span, ty: Type }

type StmtOut = { checker: Checker, row: Row, fallback: Option<Fallback> }

/// `hint` is the enclosing block's, which a `let ... else` block answers in its place.
fn infer_stmt(checker: Checker, stmt: Stmt, hint: Option<Hint>) -> StmtOut / {abort.raise} =
  match stmt {
    SExpr(e) -> {
      let o: Inferred = infer(checker, e);
      { checker: o.checker, row: o.row, fallback: None }
    },
    SLet(l) -> {
      let b: LetBound = let_bound(checker, l.pat, l.ty, l.value);
      let bound: Checker = known_as(
        b.checker,
        bind_all(or_let_covers(b.checker, l.pat), b.out),
        l.pat,
        l.value,
      );
      // A pattern that can miss raises where it does, and past it the pattern matched.
      if refutable(b.checker, l.pat) {
        let matched: Checker = {
          ..bound,
          guards: guards::matched(reader_of(b.checker), bound.guards, l.value, l.pat),
        };
        {
          checker: record_site(
            note_raise(matched, pat_span(l.pat), Misses),
            abort_atom(),
            pat_span(l.pat),
            DirectPerform,
          ),
          row: { ..b.row, atoms: atoms_insert(b.row.atoms, abort_atom()) },
          fallback: None,
        }
      } else { { checker: bound, row: b.row, fallback: None } }
    },
    SAssign(a) -> {
      // The binding the name stands for here, which a `let` or a parameter of the same name hides.
      let target = match env_local(checker.env, a.name.name) {
        Some(l) ->
          checker.assignable.vars.fold(
            None,
            |found: Option<{ stamp: Int, name: Bytes, ty: Type }>, v: { stamp: Int, name: Bytes, ty: Type }|
              if v.stamp == l.stamp { Some(v) } else { found },
          ),
        None -> None,
      };
      match target {
        None -> {
          let o: Inferred = infer(checker, a.value);
          {
            checker: report_error_at(
              o.checker,
              b"E0314",
              a.name.span,
              Bytes::concat_all([
                b"`",
                a.name.name,
                b"` is not a variable of the handler whose clause this is",
              ]),
              b"assigned here",
              [
                b"a handler declares its variables with `var` in its `with` block, and only its clauses assign them; bind a new name with `let` instead",
              ],
            ),
            row: o.row,
            fallback: None,
          }
        },
        Some(v) -> match checker.assignable.barred {
          Some(place) -> {
            let o: Inferred = infer(checker, a.value, hint_of(v.ty));
            {
              checker: report_error_at(
                o.checker,
                b"E0315",
                a.span,
                Bytes::concat_all([b"`", a.name.name, b"` is assigned in ", place]),
                b"assigned here",
                [
                  b"what runs there may run after the clause has returned: assign the variable in the clause's own blocks, from the value this answers",
                ],
              ),
              row: o.row,
              fallback: None,
            }
          },
          None -> {
            let o: Inferred = infer(checker, a.value, hint_of(v.ty));
            {
              checker: expect(
                o.checker,
                expr_span(a.value),
                v.ty,
                o.ty,
                b"a handler's variable keeps the type it was declared with",
              ).checker,
              row: o.row,
              fallback: None,
            }
          },
        },
      }
    },
    // The `else` block runs where the pattern matched nothing, so it sees none of its names.
    SLetElse(l) -> {
      let b: LetBound = let_bound(checker, l.pat, l.ty, l.value);
      let f: Inferred = infer(b.checker, l.fallback, hint);
      let j: WithRow = join(f.checker, expr_span(l.fallback), b.row, f.row);
      let bound: Checker = bind_all(j.checker, b.out);
      {
        checker: {
          ..bound,
          guards: guards::matched(reader_of(b.checker), bound.guards, l.value, l.pat),
        },
        row: j.row,
        fallback: Some({ span: expr_span(l.fallback), ty: f.ty }),
      }
    },
  }

type LetBound = { checker: Checker, row: Row, out: List<{ name: Bytes, ty: Type }> }

fn refutable(checker: Checker, pat: Pattern) -> Bool / {abort.raise} =
  uncovered(checker, [[coverage_pat(checker, pat)]], 1).len() > 0

/// Its alternatives are the arms of the `match` it becomes, and a plain `let` has no arm to spare.
fn or_let_covers(checker: Checker, pat: Pattern) -> Checker / {abort.raise} =
  if !has_or(pat) { checker } else {
    let missing = uncovered(checker, [[coverage_pat(checker, pat)]], 1);
    if missing.len() == 0 { checker } else {
      report_error_at(
        checker,
        b"E0213",
        pat_span(pat),
        b"a `let` whose or-pattern can fail needs an `else`",
        b"not covered: ".concat(
          Bytes::join(
            missing.map(|patterns: List<CoveragePattern>| backticked_text(shown(patterns.get(0)))),
            b", ",
          ),
        ),
        [
          b"write `let <pattern> = <value> else { .. };` to say what happens when no alternative matches",
        ],
      )
    }
  }

/// The initializer, its annotation and what the pattern binds, not yet in scope.
fn let_bound(
  checker: Checker,
  pat: Pattern,
  annotation: Option<TypeExpr>,
  value: Expr,
) -> LetBound / {abort.raise} = {
  let annotated: { checker: Checker, ty: Type, row: Row } = match annotation {
    Some(te) -> {
      let w: WithTy = conv_type(checker, te);
      let v: Inferred = infer(hold_written(w.checker, te, w.ty, false), value, hint_of(w.ty));
      {
        checker: expect_met(v.checker, expr_span(value), w.ty, v.ty, b"`let` annotation"),
        ty: w.ty,
        row: v.row,
      }
    },
    None -> {
      let v: Inferred = infer(checker, value);
      { checker: v.checker, ty: v.ty, row: v.row }
    },
  };
  let b: Bound = bind_pattern(annotated.checker, pat, annotated.ty, []);
  { checker: b.checker, row: annotated.row, out: b.out }
}

fn infer_app(
  checker: Checker,
  span: Span,
  func: Expr,
  args: List<Expr>,
  labels: List<Ident>,
  hint: Option<Hint>,
) -> Inferred / {abort.raise} =
  match func {
    EVar(v) -> match cell_form(checker, v.name) {
      Some(form) -> infer_cell_op(fill_labels(checker, span, labels, None), span, args, form),
      None ->
        infer_app_general(operator_hidden(checker, func, args), span, func, args, labels, hint),
    },
    _ -> infer_app_general(checker, span, func, args, labels, hint),
  }

/// The function a call on a value names in full, `value.m::f(..)`: `m::f`, whatever the value's
/// type, or nothing where `name` is one name.
fn written_function(name: Ident) -> Option<QName> / {abort.raise} =
  match member_of(name.name) {
    None -> None,
    Some(m) ->
      Some({
        module: Some({ name: m.of, span: name.span }),
        name: { name: m.member, span: name.span },
        span: name.span,
      }),
  }

/// `q` as later passes read it: a function named through its type is written through the binder
/// of the type's module, as a call on a value of the type writes it.
fn through_module(checker: Checker, q: QName) -> QName / {abort.raise} =
  match q.module {
    None -> q,
    Some(binder) -> if of_module(binder.name) != None
        || find_module_binding(scope_of(checker).modules, binder.name) != None { q } else {
      match declaring_type(checker.resolved, checker.module, binder.name) {
        None -> q,
        Some(t) ->
          {
            module: Some({
              name: of_binder(checker.resolved.scopes.get(t.owner).module),
              span: binder.span,
            }),
            name: { name: member_name(t.simple, q.name.name), span: q.name.span },
            span: q.span,
          },
      }
    },
  }

/// What `of`, the head of a receiver's type, has for a function `name`: the name a call of it is
/// written with and what it is declared as.
fn member_function(
  checker: Checker,
  of: Bytes,
  name: Ident,
) -> Option<{ qname: QName, callee: Bytes }> / {abort.raise} =
  match ((
      find_of_type(checker.resolved, checker.module, of, name.name),
      declaring_type(checker.resolved, checker.module, of),
    )) {
    (Some(b), Some(t)) ->
      Some({
        qname: {
          module: Some({
            name: of_binder(checker.resolved.scopes.get(t.owner).module),
            span: name.span,
          }),
          name: { name: member_name(t.simple, name.name), span: name.span },
          span: name.span,
        },
        callee: b.qualified,
      }),
    _ -> if module_declares(checker, of) { None }
    else { language_function(checker, of, name, true) },
  }

/// The function `name` of `of`, a type of the language's: a builtin the prelude declares under it,
/// or what its home module declares where this module sees that module. `on_value` asks for one a
/// value of the type is called on, so a builtin whose first parameter is another type is none.
fn language_function(
  checker: Checker,
  of: Bytes,
  name: Ident,
  on_value: Bool,
) -> Option<{ qname: QName, callee: Bytes }> / {abort.raise} = {
  let declared = member_name(of, name.name);
  let takes = !on_value
    || (match env_lookup(checker.env, declared) {
      Some(scheme) -> match scheme.ty {
        TyFn(f) -> match f.params.at(0) {
          Some(TyCon(c)) -> c.name == of,
          Some(TyNominal(n)) -> n.name == of,
          _ -> false,
        },
        _ -> false,
      },
      None -> false,
    });
  if takes && env_depth_of(checker.env, declared) == Some(0) {
    Some({
      qname: { module: None, name: { name: declared, span: name.span }, span: name.span },
      callee: declared,
    })
  } else { home_function(checker, of, name) }
}

/// The sites of `checker` with `site`, a call the checker writes out, among them. Every node of
/// a derived definition stands at its statement's span, so a site there that names a function would
/// be read by each call of the definition: none is ever filed.
fn sited(checker: Checker, site: MemberSite) -> List<MemberSite> / {abort.raise} =
  if checker.derived != None && site.name != b"" {
    panic("a derived definition calls a function the checker writes out, at the one span it has")
  } else { checker.member_sites.push(site) }

/// The function `name` the home module of the language's type `of` declares for it, where this
/// module can see that module: every module can but those beneath the homes, which see what they
/// import, directly or through others.
fn home_function(
  checker: Checker,
  of: Bytes,
  name: Ident,
) -> Option<{ qname: QName, callee: Bytes }> / {abort.raise} = {
  let home = home_module(of);
  let seen = match checker.resolved.sees.at(checker.module) { Some(ks) -> ks, None -> [] };
  if !seen.fold(false, |found: Bool, k: Int|
      found || checker.resolved.scopes.get(k).module == home) { None } else {
    let qname = {
      module: Some({ name: of_binder(home), span: name.span }),
      name: { name: member_name(of, name.name), span: name.span },
      span: name.span,
    };
    match find(checker.resolved, checker.module, ValueSpace, qname) {
      Some(b) -> Some({ qname: qname, callee: b.qualified }),
      None -> None,
    }
  }
}

/// Whether `of` is a type a module declares, which the prelude has no function of.
fn module_declares(checker: Checker, of: Bytes) -> Bool =
  checker.types.contains(of) || checker.nominals.contains(of)

fn no_function_of(checker: Checker, of: Bytes, name: Ident) -> Checker / {abort.raise} =
  report(checker, no_function_said(checker, of, name))

fn no_function_said(checker: Checker, of: Bytes, name: Ident) -> Diag / {abort.raise} =
  error_at(
    b"E0101",
    checker.module,
    name.span,
    Bytes::concat_all([b"`", simple_name_of(of), b"` has no function `", name.name, b"`"]),
    b"not a function of the type",
    [
      if module_declares(checker, of) {
        Bytes::concat_all([
          b"a function of a type is declared `fn ",
          simple_name_of(of),
          b"::",
          name.name,
          b"(..)` in the module that declares the type",
        ])
      } else {
        Bytes::concat_all([
          b"`",
          of,
          b"` has the builtins named for it, and the functions `",
          home_module(of),
          if sees_homes(checker.resolved.scopes.get(checker.module).module) { b"` declares for it" }
          else {
            b"` declares for it where this module imports that one, itself or through another"
          },
        ])
      },
    ],
  )

/// What each parameter of `callee` after those a call on a value fills with the value and `args`
/// takes: one of `named`, or its default, as a call by name is filled; and the modules those
/// defaults name. Nothing where the call is refused.
fn member_args(
  checker: Checker,
  span: Span,
  callee: Bytes,
  base: Expr,
  args: List<Expr>,
  named: List<NamedArg>,
) -> { checker: Checker, rest: List<Slot>, reaches: List<Bytes> } / {abort.raise} =
  match checker.resolved.signatures.get(callee) {
    None -> { checker: unnamed(checker, named), rest: [], reaches: [] },
    // Over-application is `E0202`'s to report, with the callee's own type in hand.
    Some(signature) -> if 1 + args.len() > signature.params.len() {
      { checker: checker, rest: [], reaches: [] }
    } else {
      let filled = filled_args(checker.module, span, signature, [base].concat(args), named);
      {
        checker: filled.diags.fold(checker, report),
        rest: filled.slots.drop(1 + args.len()),
        reaches: filled.imports.map(|b: ModuleBinding|
          checker.resolved.scopes.get(b.target).module),
      }
    },
  }

/// A named argument where the callee is a value: it names no parameter.
fn unnamed(checker: Checker, named: List<NamedArg>) -> Checker =
  named.fold(checker, |c: Checker, arg: NamedArg|
    report_error_at(
      c,
      b"E0123",
      arg.name.span,
      Bytes::concat_all([b"`", arg.name.name, b"` names no parameter here"]),
      b"no signature to match this against",
      [
        b"a named argument needs a callee reached by name or by the type of the value it is called on; a call through a value, a lambda or a constructor is positional",
      ],
    ))

/// What a call on a value calls: a function its value holds in a field, a function of the value's
/// type, typed, with its labels filled already where a named value is typed before the call is,
/// or nothing, with the error that says why: there is no calling nothing without one.
type DottedCallee =
  | HeldInField(Type)
  | OfType({ qname: QName, callee: Bytes, ty: Type, row: Row, labelled: Bool })
  | NoCallee(Diag)

/// A call on a value read as far as its callee: the callee's parameters, what the value met of
/// them, the callee itself where a lambda handed it may be one it repeats, what each parameter
/// after the written arguments takes, and the modules the defaults among those name.
type Dotted = {
  checker: Checker,
  callee: DottedCallee,
  params: List<Type>,
  /// How many of `params` come before the call's written arguments: the value, for a function
  /// of its type.
  before: Int,
  met: Meetings,
  waits: Option<Bytes>,
  rest: List<Slot>,
  reaches: List<Bytes>,
}

/// What the parameters after a call's written arguments take, typed.
type Took = { checker: Checker, rest: List<Taken>, row: Row }

/// What `d` takes where no argument is named: each default.
fn defaults_taken(d: Dotted) -> Took =
  {
    checker: d.checker,
    rest: d.rest.fold([], |acc: List<Taken>, slot: Slot|
      match slot { FromDefault(copied) -> acc.push(Copied(copied)), _ -> acc }),
    row: row_empty(),
  }

/// A call on a value, `base.name(args)`, as far as its callee: a function a record holds in its
/// field `name`, or the function `name` of the head of the value's type; `base.m::f(args)` calls
/// `m::f`. `b` is the value as its caller typed it and `base` as it is written.
fn dotted_callee(
  span: Span,
  b: Inferred,
  base: Expr,
  name: Ident,
  args: List<Expr>,
  named: List<NamedArg>,
  labels: List<Ident>,
) -> Dotted / {abort.raise} = {
  let ty = resolve(b.checker, b.ty);
  let none = |c: Checker, callee: DottedCallee|
    {
      checker: c,
      callee: callee,
      params: [],
      before: 0,
      met: NothingMet,
      waits: None,
      rest: [],
      reaches: [],
    };
  let of_type = |m: { qname: QName, callee: Bytes }| {
    let filled = member_args(b.checker, span, m.callee, base, args, named);
    let func = EVar({ span: name.span, name: m.qname });
    let f0: Inferred = infer_var(filled.checker, m.qname);
    let params = match shallow(f0.checker.subst, f0.ty) { TyFn(fn_) -> fn_.params, _ -> [] };
    // A named value is typed after the callee's labels are filled, as any argument is, and
    // before another use of a label-generic definition hides the callee's.
    let names = filled.rest.fold(false, |any: Bool, slot: Slot|
      any || (match slot { FromName(_) -> true, _ -> false }));
    let ready: Checker = if !names { f0.checker } else {
      fill_labels(called(f0.checker, name.span), span, labels, callee_labels(f0.checker, name.span))
    };
    {
      checker: ready,
      callee: OfType({ qname: m.qname, callee: m.callee, ty: f0.ty, row: f0.row, labelled: names }),
      params: params,
      before: 1,
      met: match params.at(0) {
        Some(p) -> Meeting({ expected: p, found: b.ty, before: NothingMet }),
        None -> NothingMet,
      },
      waits: if names { callee_repeats(ready, func, [base].concat(args)).waits } else { None },
      rest: filled.rest,
      reaches: filled.reaches,
    }
  };
  let field = match record_fields(ty) { Some(fs) -> field_get(fs, name.name), None -> None };
  match ((written_function(name), field)) {
    (Some(q), _) -> match find(b.checker.resolved, b.checker.module, ValueSpace, q) {
      Some(found) -> of_type({ qname: through_module(b.checker, q), callee: found.qualified }),
      None -> match of_language_type(b.checker, q) {
        Found(m) -> of_type(m),
        Unnamed(of) -> none(b.checker, NoCallee(no_function_said(b.checker, of.name, q.name))),
        Elsewise -> none(b.checker, NoCallee(unknown_name_said(b.checker, q))),
      },
    },
    // A function a field holds has no parameter to name: each named value is refused, and typed
    // as the argument it would be after those written.
    (None, Some(held)) ->
      {
        ..none(unnamed(b.checker, named), HeldInField(held)),
        params: match shallow(b.checker.subst, held) { TyFn(fn_) -> fn_.params, _ -> [] },
        rest: range(0, named.len()).map(|j: Int| FromName(j)),
      },
    (None, None) -> {
      let head = match ty { TyCon(c) -> Some(c.name), TyNominal(n) -> Some(n.name), _ -> None };
      match head {
        None ->
          none(
            b.checker,
            NoCallee(
              error_at(
                b"E0201",
                b.checker.module,
                expr_span(base),
                Bytes::concat_all([b"cannot call `", name.name, b"` on this value"]),
                Bytes::concat_all([b"this has type `", type_text(ty), b"`"]),
                [
                  b"`value.name(..)` calls the function `name` of the value's type, or a function a record holds in a field `name`: a type parameter, a function and a record with no such field have neither",
                  b"annotate the value where its type is not yet known",
                ],
              ),
            ),
          ),
        Some(of) -> match member_function(b.checker, of, name) {
          None -> none(b.checker, NoCallee(no_function_said(b.checker, of, name))),
          Some(m) -> of_type(m),
        },
      }
    },
  }
}

/// The call on a value `d` reads, typed: `taken` is what the parameters after its written
/// arguments take, and `b` the value, so nothing of the call is walked twice.
fn dotted(
  span: Span,
  d: Dotted,
  taken: Took,
  b: Inferred,
  base: Expr,
  name: Ident,
  args: List<Expr>,
  labels: List<Ident>,
  hint: Option<Hint>,
  performed: Bool,
) -> Inferred / {abort.raise} = {
  let answered = |o: Inferred, noted: Checker| {
    let j: WithRow = join(noted, span, b.row, o.row);
    let k: WithRow = join(j.checker, span, j.row, taken.row);
    { checker: k.checker, ty: o.ty, row: k.row }
  };
  match d.callee {
    NoCallee(said) -> {
      let o: WithTy = new_ty(report(taken.checker, said));
      { checker: o.checker, ty: o.ty, row: b.row }
    },
    HeldInField(held) -> {
      let o: Inferred = applied_call(
        span,
        EField({ span: span_to(expr_span(base), name.span), base: base, field: name }),
        { checker: taken.checker, ty: held, row: row_empty() },
        None,
        args,
        labels,
        hint,
        rest: taken.rest,
      );
      // Written as a perform, it is filed for the rewrite to write as the call of a field.
      answered(o, if !performed { o.checker } else {
        {
          ..o.checker,
          member_sites: sited(o.checker, {
            module: o.checker.module,
            span: span,
            qualifier: b"",
            name: b"",
            callee: b"",
            owner: o.checker.walking,
            reaches: [],
            named: [],
          }),
        }
      })
    },
    OfType(m) -> {
      let o: Inferred = applied_call(
        span,
        EVar({ span: name.span, name: m.qname }),
        { checker: taken.checker, ty: m.ty, row: m.row },
        Some({ written: base, ty: b.ty }),
        args,
        if m.labelled { [] } else { labels },
        hint,
        rest: taken.rest,
      );
      answered(o, {
        ..o.checker,
        member_sites: sited(o.checker, {
          module: o.checker.module,
          span: span,
          // A builtin is the prelude's: the call is written out through the prelude's binder,
          // and what reads the call as it stands asks for the builtin by name.
          qualifier: match m.qname.module { Some(q) -> q.name, None -> prelude_binder() },
          name: m.qname.name.name,
          callee: m.callee,
          owner: o.checker.walking,
          reaches: d.reaches,
          named: range(0, d.rest.len()).fold(
            [],
            |acc: List<{ arg: Int, at: Int }>, k: Int|
              match d.rest.get(k) {
                FromName(j) -> acc.push({ arg: j, at: 1 + args.len() + k }),
                _ -> acc,
              },
          ).sort_by(|a: { arg: Int, at: Int }, b: { arg: Int, at: Int }| a.arg <= b.arg).map(
            |x: { arg: Int, at: Int }| x.at,
          ),
        }),
        builtins_on: if m.qname.module != None { o.checker.builtins_on }
        else { o.checker.builtins_on.insert(span_key(span), m.qname.name.name) },
      })
    },
  }
}

/// The prelude's name for a callee written bare or through a type of the language's, or nothing
/// for one the program declares.
fn prelude_named(checker: Checker, func: Expr) -> Bytes / {abort.raise} =
  match func {
    EVar(v) -> if !is_bare(v.name) {
      match of_language_type(checker, v.name) {
        Found(m) -> if m.qname.module == None { m.callee } else { b"" },
        _ -> b"",
      }
    } else {
      match value_key(checker, v.name).key {
        Some(k) -> if !k.prelude { b"" } else { k.name },
        None -> b"",
      }
    },
    _ -> b"",
  }

/// The closures `bracket` is handed run as one, so each is taken to perform what all of them do: a
/// body generic over its caller's row still admits the release's operations.
fn joined_callbacks(
  checker: Checker,
  span: Span,
  tys: List<Type>,
) -> { checker: Checker, tys: List<Type> } / {abort.raise} = {
  let j: WithRow = tys.fold({ checker: checker, row: row_empty() }, |acc: WithRow, ty: Type|
    match resolve(acc.checker, ty) {
      TyFn(f) -> join(acc.checker, span, acc.row, f.effects),
      _ -> acc,
    });
  {
    checker: j.checker,
    tys: tys.map(|ty: Type|
      match resolve(j.checker, ty) { TyFn(f) -> TyFn({ ..f, effects: j.row }), _ -> ty }),
  }
}

fn group_member(checker: Checker, name: Bytes) -> Bool =
  checker.group_defs.fold(false, |acc: Bool, g: GroupDef| acc || g.name == name)

/// Every use of a label-generic definition, so a call can fill its labels and a settled component
/// can say which ones it filled them with.
fn note_labels(
  checker: Checker,
  span: Span,
  callee: Bytes,
  labels: List<Type>,
  ty: Type,
) -> Checker / {abort.raise} =
  if labels.len() == 0 { checker } else {
    let vars = labels.map(|l: Type| match l { TyVar(v) -> v, _ -> 0 - 1 });
    let regions = region_labels(ty, []);
    {
      ..checker,
      label_apps: checker.label_apps.push({
        module: checker.module,
        span: span,
        named: span.end,
        callee: callee,
        vars: vars,
        written: vars.filter(|v: Int| !regions.contains(v)),
        params: checker.label_params,
        called: false,
        owner: checker.walking,
      }),
    }
  }

/// The label variables `ty` names a region by: a hold's, and those of the `cell` and `hold` atoms
/// its rows write.
fn region_labels(ty: Type, acc: List<Int>) -> List<Int> / {abort.raise} =
  match ty {
    TyVar(_) -> acc,
    TyCon(c) -> {
      let own = if c.name == b"Hold" {
        match c.args.at(0) { Some(TyVar(v)) -> ints_insert(acc, v), _ -> acc }
      } else { acc };
      c.args.fold(own, |a: List<Int>, x: Type| region_labels(x, a))
    },
    TyFn(f) ->
      f.effects.atoms.fold(
        f.params.fold(region_labels(f.ret, acc), |a: List<Int>, p: Type| region_labels(p, a)),
        |a: List<Int>, atom: Atom|
          match atom.resource {
            RVar(v) -> if is_region_effect(atom.effect) { ints_insert(a, v) } else { a },
            _ -> a,
          },
      ),
    TyRecord(fs) -> fs.fold(acc, |a: List<Int>, f: Field| region_labels(f.ty, a)),
    TyNominal(n) -> n.args.fold(acc, |a: List<Int>, x: Type| region_labels(x, a)),
  }

/// The use recorded for the name this call applies, when the callee is label-generic.
fn callee_labels(checker: Checker, span: Span) -> Option<LabelApplication> =
  match checker.label_apps.at(checker.label_apps.len() - 1) {
    Some(a) -> if a.module == checker.module && a.span == span { Some(a) } else { None },
    None -> None,
  }

/// The labels written at a call fill, left to right, the callee's label parameters that name no
/// region: a region's is filled by the argument that carries it.
fn fill_labels(
  checker: Checker,
  span: Span,
  labels: List<Ident>,
  app: Option<LabelApplication>,
) -> Checker / {abort.raise} =
  match app {
    None -> if labels.len() == 0 { checker } else { wrong_labels(checker, labels, None, 0, 0) },
    // A count that does not match is reported here, and the use dropped rather than reported twice.
    Some(a) -> if labels.len() > 0 && labels.len() != a.written.len() {
      wrong_labels(
        { ..checker, label_apps: checker.label_apps.take(checker.label_apps.len() - 1) },
        labels,
        Some(a.callee),
        a.written.len(),
        a.vars.len() - a.written.len(),
      )
    } else {
      let marked: Checker = {
        ..checker,
        label_apps: checker.label_apps.set(checker.label_apps.len() - 1, {
          ..a,
          span: span,
          called: true,
        }),
      };
      // A name a binder holds is that label parameter, as it is inside a row; anything else is a resource.
      range(0, labels.len()).fold(marked, |c: Checker, i: Int| {
        let want = match c.label_params.get(labels.get(i).name) {
          Some(w) -> TyVar(w),
          None -> label_type(labels.get(i).name),
        };
        with_unified(c, unify(c.subst, c.fresh, TyVar(a.written.get(i)), want))
      })
    },
  }

/// `want` is how many labels a call of the callee writes, and `regions` how many more it binds
/// for a region.
fn wrong_labels(
  checker: Checker,
  labels: List<Ident>,
  callee: Option<Bytes>,
  want: Int,
  regions: Int,
) -> Checker / {abort.raise} = {
  let span = span_to(labels.get(0).span, labels.get(labels.len() - 1).span);
  let who = match callee {
    Some(n) -> Bytes::concat_all([b"`", simple_name_of(n), b"`"]),
    None -> b"this callee",
  };
  let message = if want == 0 {
    Bytes::concat_all([
      who,
      if regions == 0 { b" takes no label parameters" } else { b" takes no label a call writes" },
    ])
  } else {
    Bytes::concat_all([
      who,
      b" takes ",
      ascii_of_int(want),
      b" label parameter",
      plural(want),
      b", but ",
      ascii_of_int(labels.len()),
      b" ",
      if labels.len() == 1 { b"is" } else { b"are" },
      b" written",
    ])
  };
  let help = [
    b"the labels at a call fill the `[l]` binders of the definition's generic list, left to right",
  ].concat(if regions == 0 { [] } else {
    [
      b"a binder that names a hold's or a cell's region is filled by the argument that carries the region, and is not written",
    ]
  });
  match callee {
    Some(n) -> match def_of(checker, n) {
      Some(d) ->
        report_error_at_and(
          checker,
          b"E0306",
          span,
          message,
          b"label instantiation",
          d.at,
          b"declared here",
          help,
        ),
      None -> report_error_at(checker, b"E0306", span, message, b"label instantiation", help),
    },
    None -> report_error_at(checker, b"E0306", span, message, b"label instantiation", help),
  }
}

/// Builtins whose first parameter must be an integer type, checked per call: a scheme cannot say "an integer".
fn int_builtin_name(func: Expr) -> Bytes =
  match func { EVar(v) -> if is_bare(v.name) { v.name.name.name } else { b"" }, _ -> b"" }

fn is_int_builtin(func: Expr) -> Bool = {
  let n = int_builtin_name(func);
  n == b"wrap_add" || n == b"wrap_sub" || n == b"wrap_mul" || n == b"rotr" || n == b"rotl"
    || n == b"checked_add"
    || n == b"checked_sub"
    || n == b"checked_mul"
    || n == b"checked_neg"
    || call_operator(n) != None
}

/// A call as its diagnostics name it: the operator it was written as, or the builtin called.
fn int_builtin_text(func: Expr, args: List<Expr>) -> Bytes =
  Bytes::concat_all([
    b"`",
    match written_operator(func, args) { Some(o) -> o.text, None -> int_builtin_name(func) },
    b"`",
  ])

/// An operator the parser wrote as a call of a builtin means that builtin, so a binding of the
/// builtin's name around one is refused rather than called.
fn operator_hidden(checker: Checker, func: Expr, args: List<Expr>) -> Checker / {abort.raise} =
  match ((func, written_operator(func, args))) {
    (EVar(v), Some(o)) -> match env_depth_of(checker.env, o.name) {
      Some(depth) -> if depth == 0 { checker } else {
        report_error_at(
          checker,
          b"E0105",
          v.span,
          Bytes::concat_all([
            b"`",
            o.text,
            b"` is the builtin `",
            o.name,
            b"`, which a binding here hides",
          ]),
          Bytes::concat_all([b"this would call the local `", o.name, b"`"]),
          [
            Bytes::concat_all([
              b"`a ",
              o.text,
              b" b` is written in the name `",
              o.name,
              b"`; give the binding another name",
            ]),
          ],
        )
      },
      None -> checker,
    },
    _ -> checker,
  }

type Met = { checker: Checker, tails: List<Int> }

type Widened = { checker: Checker, ty: Type, tails: List<Int> }

type Items<a> = { checker: Checker, items: List<a>, tails: List<Int> }

fn unwidened(checker: Checker, ty: Type) -> Widened = { checker: checker, ty: ty, tails: [] }

/// `g`'s closed row given a fresh tail, after its result came back widened as `r`.
fn widen_fn(
  r: Widened,
  ty: Type,
  g: { params: List<Type>, ret: Type, effects: Row },
) -> Widened / {abort.raise} = {
  let row = resolve_row_in(r.checker, g.effects);
  match row.tail {
    Some(_) -> if r.tails.len() == 0 { unwidened(r.checker, ty) }
    else { { checker: r.checker, ty: fn_type(g.params, r.ty, g.effects), tails: r.tails } },
    None -> {
      let v: WithVar = new_row_var(r.checker);
      {
        checker: v.checker,
        ty: fn_type(g.params, r.ty, { atoms: row.atoms, tail: Some(v.var) }),
        tails: r.tails.push(v.var),
      }
    },
  }
}

/// A fresh tail on each closed row of a function the value holds where a narrower one may stand.
fn open_rows(checker: Checker, ty: Type) -> Widened / {abort.raise} =
  opened(checker, ty, checker.subst.ty.len())

/// `room` as in `types::resolved_ty`: opening binds no type, so the bindings stay as they were.
fn opened(checker: Checker, ty: Type, room: Int) -> Widened / {abort.raise} =
  match ty {
    TyVar(v) -> match checker.subst.ty.get(v) {
      None -> unwidened(checker, ty),
      Some(bound) -> if room <= 0 { panic("a type bound to itself") } else {
        let w: Widened = opened(checker, bound, room - 1);
        if w.tails.len() == 0 { unwidened(w.checker, ty) } else { w }
      },
    },
    TyFn(g) -> widen_fn(opened(checker, g.ret, room), ty, g),
    TyRecord(fs) -> {
      let o: Items<Field> = range(0, fs.len()).fold(
        { checker: checker, items: fs, tails: [] },
        |acc: Items<Field>, i: Int| {
          let x = fs.get(i);
          let w: Widened = opened(acc.checker, x.ty, room);
          if w.tails.len() == 0 { acc } else {
            {
              checker: w.checker,
              items: acc.items.set(i, { name: x.name, ty: w.ty }),
              tails: acc.tails.concat(w.tails),
            }
          }
        },
      );
      if o.tails.len() == 0 { unwidened(checker, ty) }
      else { { checker: o.checker, ty: TyRecord(o.items), tails: o.tails } }
    },
    TyNominal(_) -> unwidened(checker, ty),
    TyCon(c) -> if !covariant_con(c.name) { unwidened(checker, ty) } else {
      let o: Items<Type> = range(0, c.args.len()).fold(
        { checker: checker, items: c.args, tails: [] },
        |acc: Items<Type>, i: Int| {
          let w: Widened = opened(acc.checker, c.args.get(i), room);
          if w.tails.len() == 0 { acc } else {
            { checker: w.checker, items: acc.items.set(i, w.ty), tails: acc.tails.concat(w.tails) }
          }
        },
      );
      if o.tails.len() == 0 { unwidened(checker, ty) }
      else { { checker: o.checker, ty: TyCon({ name: c.name, args: o.items }), tails: o.tails } }
    },
  }

/// What will not meet its type as written meets it again widened, which costs a walk, so only then.
fn expect_met(
  checker: Checker,
  span: Span,
  expected: Type,
  found: Type,
  context: Bytes,
) -> Checker / {abort.raise} = {
  let u = unify(checker.subst, checker.fresh, expected, found);
  match u.error {
    None -> with_unified(checker, u),
    Some(_) -> {
      let o: Widened = open_rows(checker, found);
      let w = unify(o.checker.subst, o.checker.fresh, expected, o.ty);
      match w.error {
        None -> close_tails(with_unified(o.checker, w), o.tails),
        Some(_) -> expect(checker, span, expected, found, context).checker,
      }
    },
  }
}

type Joined = { checker: Checker, ty: Type, tails: List<Int> }

/// List elements or `match` arms: as written while they agree, else widened with the join so far.
fn join_next(acc: Joined, span: Span, found: Type, context: Bytes) -> Joined / {abort.raise} = {
  let u = unify(acc.checker.subst, acc.checker.fresh, acc.ty, found);
  match u.error {
    None -> { checker: with_unified(acc.checker, u), ty: acc.ty, tails: acc.tails },
    Some(_) -> {
      let a: Widened = open_rows(acc.checker, acc.ty);
      let b: Widened = open_rows(a.checker, found);
      let w = unify(b.checker.subst, b.checker.fresh, a.ty, b.ty);
      match w.error {
        None ->
          {
            checker: with_unified(b.checker, w),
            ty: a.ty,
            tails: acc.tails.concat(a.tails.concat(b.tails)),
          },
        Some(_) ->
          {
            checker: expect(
              close_tails(acc.checker, acc.tails),
              span,
              acc.ty,
              found,
              context,
            ).checker,
            ty: acc.ty,
            tails: [],
          },
      }
    },
  }
}

fn agree(
  checker: Checker,
  span: Span,
  first: Type,
  second: Type,
  context: Bytes,
) -> { checker: Checker, ty: Type } / {abort.raise} = {
  let j: Joined = join_next({ checker: checker, ty: first, tails: [] }, span, second, context);
  { checker: close_tails(j.checker, j.tails), ty: j.ty }
}

/// As written; a refusal retries the call with every argument widened, and stands if that fails.
fn expect_arguments<| e>(
  checker: Checker,
  params: List<Type>,
  found: List<Type>,
  expect_one: (Checker, Int) -> Checker / e,
) -> Checker / {abort.raise | e} = {
  let written: Checker = range(0, params.len()).fold(checker, |c: Checker, i: Int|
    expect_one(c, i));
  if written.diags.len() == checker.diags.len() { written }
  else { match arguments_widened(checker, params, found) { Some(c) -> c, None -> written } }
}

fn arguments_widened(
  checker: Checker,
  params: List<Type>,
  found: List<Type>,
) -> Option<Checker> / {abort.raise} = {
  let m: Option<Met> = range(0, params.len()).fold(
    Some({ checker: checker, tails: [] }),
    |acc: Option<Met>, i: Int|
      match acc {
        None -> None,
        Some(a) -> {
          let o: Widened = open_rows(a.checker, found.get(i));
          let u = unify(o.checker.subst, o.checker.fresh, params.get(i), o.ty);
          match u.error {
            None -> Some({ checker: with_unified(o.checker, u), tails: a.tails.concat(o.tails) }),
            Some(_) -> None,
          }
        },
      },
  );
  match m { None -> None, Some(a) -> Some(close_tails(a.checker, a.tails)) }
}

/// After everything that must agree has met, so a row the values share holds just their union.
fn close_tails(checker: Checker, tails: List<Int>) -> Checker / {abort.raise} =
  tails.fold(checker, close_tail)

fn close_tail(checker: Checker, tail: Int) -> Checker / {abort.raise} =
  match resolved_tail(checker.subst, row_open(tail)) {
    Some(v) -> if is_rigid_row(checker.subst, v) { checker } else {
      with_unified(checker, unify_row(checker.subst, checker.fresh, row_empty(), row_open(v)))
    },
    None -> checker,
  }

fn expect_argument(
  checker: Checker,
  span: Span,
  expected: Type,
  found: Type,
) -> Checker / {abort.raise} = {
  let u = unify(checker.subst, checker.fresh, expected, found);
  let c: Checker = with_unified(checker, u);
  match u.error { None -> c, Some(e) -> report_unify(c, e, span, b"argument type") }
}

/// Each of `fills`, calls a body makes, that fills a type parameter of a member of its own group
/// `members` with a type built from the caller's own: each round of the recursion would call for
/// the member at a larger type, so no finite set of copies of it serves the group. A parameter
/// passed along as it is, and a type that names none, do not grow.
fn refuse_growth(
  checker: Checker,
  members: List<GroupDef>,
  fills: List<Fill>,
) -> Checker / {abort.raise} =
  fills.fold(checker, |c: Checker, f: Fill|
    match members.fold(None, |acc: Option<List<RigidParam>>, g: GroupDef|
        if g.name == f.callee { Some(g.types) } else { acc }) {
      None -> c,
      Some(params) ->
        f.grows.fold(c, |inner: Checker, grown: { param: Int, ty: Bytes }|
          match params.at(grown.param) {
            None -> inner,
            Some(p) -> {
              let name = simple_name_of(f.callee);
              let refused = report_error_at(
                { ..inner, module: f.module },
                b"E0308",
                f.span,
                Bytes::concat_all([
                  b"a call to `",
                  name,
                  b"` inside its own recursive group gives `",
                  p.name,
                  b"` a type that grows",
                ]),
                Bytes::concat_all([b"`", p.name, b"` would be `", grown.ty, b"` here"]),
                [
                  Bytes::concat_all([
                    b"each time round the recursion `",
                    name,
                    b"` would be called at a larger type, so no finite set of copies of it serves the group: that is polymorphic recursion",
                  ]),
                  Bytes::concat_all([
                    b"pass a type parameter along as it is, or a type that names none; or break the cycle so `",
                    name,
                    b"` is checked on its own before this call",
                  ]),
                ],
              );
              { ..refused, module: inner.module }
            },
          }),
    })

fn infer_app_general(
  checker: Checker,
  span: Span,
  func: Expr,
  args: List<Expr>,
  labels: List<Ident>,
  hint: Option<Hint>,
) -> Inferred / {abort.raise} =
  applied_call(span, func, infer(checker, func), None, args, labels, hint)

/// What a parameter after a call's written arguments takes: a named value, typed already, or its
/// default.
type Taken = | Settled({ written: Expr, ty: Type }) | Copied(Expr)

/// A call of a callee typed already, `f0`, which `func` only writes: `on` is the value a call is
/// made on, the callee's first argument, typed already too, `given` the arguments after it, and
/// `rest` what the parameters after those take.
fn applied_call(
  span: Span,
  func: Expr,
  f0: Inferred,
  on: Option<{ written: Expr, ty: Type }>,
  given: List<Expr>,
  labels: List<Ident>,
  hint: Option<Hint>,
  rest: List<Taken> = [],
) -> Inferred / {abort.raise} = {
  // Every argument in its parameter's place, for what reads the arguments without typing them.
  let args = List::concat(
    match on { Some(x) -> [x.written].concat(given), None -> given },
    rest.map(|t: Taken| match t { Settled(x) -> x.written, Copied(d) -> d }),
  );
  // Before the arguments, so a written label is what an argument's row is checked against.
  let f: Inferred = {
    checker: fill_labels(
      called(f0.checker, expr_span(func)),
      span,
      labels,
      callee_labels(f0.checker, expr_span(func)),
    ),
    ty: f0.ty,
    row: f0.row,
  };
  let repeats = callee_repeats(f.checker, func, args);
  // What the callee's answer is expected to be says what its type variables are, for the arguments.
  let called: { params: List<Type>, met: Meetings } = match shallow(f.checker.subst, f.ty) {
    TyFn(fn_) ->
      {
        params: fn_.params,
        met: match hint {
          Some(h) ->
            Meeting({
              expected: fn_.ret,
              found: match hinted(f.checker, hint) { Some(t) -> t, None -> h.ty },
              before: h.met,
            }),
          None -> NothingMet,
        },
      },
    _ -> { params: [], met: NothingMet },
  };
  let builtin = prelude_named(f.checker, func);
  let written: { checker: Checker, tys: List<Type>, row: Row } = infer_args(
    f.checker,
    given,
    span,
    repeats.params,
    repeats.waits,
    called.params,
    called.met,
    ranged_lambda(f.checker, builtin, args),
    first: match on { Some(x) -> Some(x.ty), None -> None },
  );
  // A default is typed where the walk of the body ends: it is no part of the call.
  let as_: { checker: Checker, tys: List<Type>, row: Row } = range(0, rest.len()).fold(
    written,
    |acc: { checker: Checker, tys: List<Type>, row: Row }, k: Int|
      match ((rest.get(k), called.params.at(written.tys.len() + k))) {
        (Settled(x), _) -> { ..acc, tys: acc.tys.push(x.ty) },
        (Copied(d), Some(p)) ->
          {
            ..acc,
            checker: {
              ..acc.checker,
              copied_defaults: acc.checker.copied_defaults.push({ expr: d, ty: p }),
            },
            tys: acc.tys.push(p),
          },
        _ -> acc,
      },
  );
  let j0: WithRow = join(as_.checker, span, f.row, as_.row);
  let c: Checker = j0.checker;
  match resolve(c, f.ty) {
    TyFn(fn_) -> if fn_.params.len() != args.len() {
      let n = fn_.params.len();
      let reported: Checker = err_labels(
        c,
        b"E0202",
        Bytes::concat_all([
          b"this function takes ",
          ascii_of_int(n),
          b" argument",
          plural(n),
          b", but ",
          supplied(args.len()),
        ]),
        [
          label_at(
            c.module,
            span,
            true,
            Bytes::concat_all([
              b"expected ",
              ascii_of_int(n),
              b", found ",
              ascii_of_int(args.len()),
            ]),
          ),
          label_at(c.module, expr_span(func), false, b"this is the function being called"),
        ],
        [],
      );
      let j: WithRow = join(reported, span, j0.row, fn_.effects);
      { checker: j.checker, ty: fn_.ret, row: j.row }
    } else {
      let source = callee_source(c, func);
      let handed: { checker: Checker, tys: List<Type> } = if builtin == b"bracket" {
        joined_callbacks(c, span, as_.tys)
      } else { { checker: c, tys: as_.tys } };
      let checked: Checker = expect_arguments(
        handed.checker,
        fn_.params,
        handed.tys,
        |cc: Checker, i: Int|
          expect_argument(cc, expr_span(args.get(i)), fn_.params.get(i), handed.tys.get(i)),
      );
      // `forall a.` alone would admit two `String`s, so the integer obligation goes on the instantiated variable here.
      let noted: Checker = if is_int_builtin(func) && fn_.params.len() > 0 {
        {
          ..checked,
          bit_ops: checked.bit_ops.push({
            span: span,
            what: int_builtin_text(func, args),
            ty: fn_.params.get(0),
            builtin: true,
          }),
        }
      } else { checked };
      let resolved = resolve_row_in(noted, fn_.effects);
      let required: { checker: Checker, shown: Bool } = if builtin == b""
          || !resolved.atoms.contains(abort_atom()) { { checker: noted, shown: false } }
      else { requires_shown(noted, builtin, args, span) };
      let obliged: Checker = required.checker;
      let effects = if required.shown { { ..resolved, atoms: without_raises(resolved.atoms) } }
      else { resolved };
      let scaled = repeated_rows(obliged, fn_.params, repeats.params);
      // What each parameter's functions perform, for a callee whose counts are not in yet: read
      // only where the call performs something a parameter could be the source of.
      let holding: { checker: Checker, params: List<Int> } = match repeats.waits {
        Some(g) -> if effects.atoms.len() == 0 && effects.tail == None {
          { checker: obliged, params: [] }
        } else { fn_holding(obliged, g) },
        None -> { checker: obliged, params: [] },
      };
      let held = holding.params.map(|i: Int|
        {
          param: i,
          rows: match fn_.params.at(i) {
            Some(p) -> rows_in(holding.checker, p, { atoms: [], vars: [] }),
            None -> { atoms: [], vars: [] },
          },
        });
      let waiting = |g: Bytes, has: ({ atoms: List<Atom>, vars: List<Int> }) -> Bool|
        held.fold(
          [],
          |acc: List<Maybe>, h: { param: Int, rows: { atoms: List<Atom>, vars: List<Int> } }|
            if has(h.rows) { acc.push({ callee: g, param: Some(h.param), span: span }) }
            else { acc },
        );
      let entered: Checker = match repeats.waits {
        Some(g) -> if !holding.checker.own_fns.contains(g) { holding.checker } else {
          { ..holding.checker, calls: holding.checker.calls.push({ callee: g, span: span }) }
        },
        None -> holding.checker,
      };
      let recorded: Checker = effects.atoms.fold(entered, |cc: Checker, atom: Atom|
        if scaled.atoms.contains(atom) { record_over(cc, atom, span, source, Some(span), []) }
        else {
          let own = match repeats.waits {
            None -> [],
            Some(g) ->
              [{ callee: g, param: None, span: span }].concat(
                waiting(g, |h: { atoms: List<Atom>, vars: List<Int> }| h.atoms.contains(atom)),
              ),
          };
          record_over(cc, atom, span, source, cc.over, own.concat(cc.maybe))
        });
      let tail_waits = match ((repeats.waits, effects.tail)) {
        (Some(g), Some(v)) ->
          waiting(g, |h: { atoms: List<Atom>, vars: List<Int> }| h.vars.contains(v)),
        _ -> [],
      };
      let j: WithRow = join(
        repeat_tail(recorded, effects.tail, scaled.vars, tail_waits, span),
        span,
        j0.row,
        effects,
      );
      { checker: j.checker, ty: fn_.ret, row: j.row }
    },
    TyVar(_) -> {
      let ret: WithTy = new_ty(c);
      let eff: WithRow = new_row(ret.checker);
      let want = fn_type(as_.tys, ret.ty, eff.row);
      let x: Expected = expect(eff.checker, expr_span(func), want, f.ty, b"callee type");
      let j: WithRow = join(
        repeat_tail(x.checker, eff.row.tail, [], [], span),
        span,
        j0.row,
        eff.row,
      );
      { checker: j.checker, ty: ret.ty, row: j.row }
    },
    other -> {
      let o: WithTy = new_ty(
        report_error_at(
          c,
          b"E0204",
          expr_span(func),
          b"this is not a function",
          Bytes::concat_all([b"has type `", type_text(other), b"`"]),
          [b"only function values can be applied"],
        ),
      );
      { checker: o.checker, ty: o.ty, row: j0.row }
    },
  }
}

fn is_cell(ty: Type) -> Bool = match ty { TyCon(c) -> c.name == b"Cell", _ -> false }

fn cell_is_a_name() -> List<Bytes> =
  [
    b"a cell is read and written where its `with_cell` binds it, by `cell_get`, `cell_set` and `cell_update`, and a closure may capture it",
    b"to let other code reach it, pass a closure that reads or writes it, or declare an effect the region's handler answers",
  ]

/// The arguments of a cell builtin. The first names the cell, which is all a cell's name does.
fn infer_cell_args(
  checker: Checker,
  args: List<Expr>,
  span: Span,
) -> { checker: Checker, tys: List<Type>, row: Row } / {abort.raise} =
  range(0, args.len()).fold(
    { checker: checker, tys: [], row: row_empty() },
    |acc: { checker: Checker, tys: List<Type>, row: Row }, i: Int| {
      let names = i == 0 && (match args.get(i) { EVar(_) -> true, _ -> false });
      let o: Inferred = infer({ ..acc.checker, cell_named: names }, args.get(i));
      let j: WithRow = join({ ..o.checker, cell_named: false }, span, acc.row, o.row);
      { checker: j.checker, tys: acc.tys.push(o.ty), row: j.row }
    },
  )

/// Whether `ty` names a hold anywhere but as a parameter: its own, where `passed`, or one of a
/// function type it holds.
fn keeps_hold(ty: Type, passed: Bool) -> Bool =
  match ty {
    TyVar(_) -> false,
    TyCon(c) ->
      (c.name == b"Hold" && !passed)
        || c.args.fold(false, |b: Bool, a: Type| b || keeps_hold(a, false)),
    TyFn(f) ->
      f.params.fold(false, |b: Bool, p: Type| b || keeps_hold(p, true)) || keeps_hold(f.ret, false),
    TyRecord(fs) -> fs.fold(false, |b: Bool, f: Field| b || keeps_hold(f.ty, false)),
    TyNominal(n) -> n.args.fold(false, |b: Bool, a: Type| b || keeps_hold(a, false)),
  }

/// A hold is passed down and never kept, so `Hold` is written only as a parameter's type.
fn hold_written(
  checker: Checker,
  written: TypeExpr,
  ty: Type,
  passed: Bool,
) -> Checker / {abort.raise} =
  if !keeps_hold(resolve(checker, ty), passed) { checker } else {
    report_error_at(
      checker,
      b"E0446",
      ty_span(written),
      b"a `Hold` is written where it would be kept",
      b"a hold is passed down, never kept",
      [
        b"a hold is a parameter of a definition, a lambda or a function type: it is not answered, held in another value or bound by an annotation",
        b"read it where it is passed, with `Hold::get`, and keep what the read answers",
      ],
    )
  }

fn cell_form_name(form: CellForm) -> Bytes =
  match form { CellGet -> b"cell_get", CellSet -> b"cell_set", CellUpdate -> b"cell_update" }

fn infer_cell_op(
  checker: Checker,
  span: Span,
  args: List<Expr>,
  form: CellForm,
) -> Inferred / {abort.raise} = {
  let expected = match form { CellGet -> 1, CellSet -> 2, CellUpdate -> 2 };
  let as_: { checker: Checker, tys: List<Type>, row: Row } = infer_cell_args(checker, args, span);
  if args.len() != expected {
    let o: WithTy = new_ty(
      arity_error(as_.checker, span, cell_form_name(form), expected, args.len(), b"arguments", []),
    );
    { checker: o.checker, ty: o.ty, row: as_.row }
  } else {
    let region: WithTy = new_ty(as_.checker);
    let elem: WithTy = new_ty(region.checker);
    let cell_ty = TyCon({ name: b"Cell", args: [region.ty, elem.ty] });
    let c0: Checker = expect(
      elem.checker,
      expr_span(args.get(0)),
      cell_ty,
      as_.tys.get(0),
      b"cell argument",
    ).checker;
    let after = match form {
      CellGet -> { checker: c0, row: as_.row },
      CellSet ->
        {
          checker: expect(
            c0,
            expr_span(args.get(1)),
            elem.ty,
            as_.tys.get(1),
            b"value stored into the cell",
          ).checker,
          row: as_.row,
        },
      CellUpdate -> {
        let eff: WithRow = new_row(c0);
        let f = fn_type([elem.ty], elem.ty, eff.row);
        let x: Checker = expect(
          eff.checker,
          expr_span(args.get(1)),
          f,
          as_.tys.get(1),
          b"function applied to the cell's contents",
        ).checker;
        let j: WithRow = join(x, span, as_.row, eff.row);
        { checker: j.checker, row: j.row }
      },
    };
    let ret = match form { CellGet -> elem.ty, _ -> unit_type() };
    match label_of(resolve(after.checker, region.ty)) {
      None ->
        {
          checker: report_error_at(
            after.checker,
            b"E0304",
            expr_span(args.get(0)),
            Bytes::concat_all([
              b"cannot tell which `with_cell` region `",
              cell_form_name(form),
              b"` acts on",
            ]),
            b"this cell's region is unknown here",
            [
              b"call it on the binder introduced by `with_cell[r](..) { c -> .. }`, so the `cell.read[r]` / `cell.write[r]` atoms can be discharged at the region boundary",
            ],
          ),
          ty: ret,
          row: after.row,
        },
      Some(resource) -> {
        let modes = match form {
          CellGet -> [MRead],
          CellSet -> [MWrite],
          CellUpdate -> [MRead, MWrite],
        };
        let out = modes.fold(
          { checker: after.checker, row: after.row },
          |acc: { checker: Checker, row: Row }, mode: Mode| {
            let atom = { effect: cell(), resource: RNamed(resource), mode: mode, op: None };
            let j: WithRow = join(
              record_site(acc.checker, atom, span, DirectPerform),
              span,
              acc.row,
              row_singleton(atom),
            );
            { checker: j.checker, row: j.row }
          },
        );
        // What a cell holds is read off no reference, so the read's own type is filed.
        {
          checker: match form {
            CellGet -> note_typed(out.checker, span, ret, []),
            _ -> out.checker,
          },
          ty: ret,
          row: out.row,
        }
      },
    }
  }
}

// --- Patterns and matches -----------------------------------------------------------------------

type Bound = { checker: Checker, out: List<{ name: Bytes, ty: Type }> }

/// A pattern on a constructor its type's module keeps. A bare name's refusal is said here and a
/// qualified one's where it was looked up; what the pattern binds is bound all the same, so that
/// is all that is said of it.
fn bind_kept(
  checker: Checker,
  name: QName,
  args: List<Pattern>,
  closed: Diag,
  out: List<{ name: Bytes, ty: Type }>,
) -> Bound / {abort.raise} =
  args.fold(
    { checker: if is_bare(name) { report(checker, closed) } else { checker }, out: out },
    |acc: Bound, arg: Pattern| {
      let t: WithTy = new_ty(acc.checker);
      bind_pattern(t.checker, arg, t.ty, acc.out)
    },
  )

fn bind_pattern(
  checker: Checker,
  p: Pattern,
  scrutinee: Type,
  out: List<{ name: Bytes, ty: Type }>,
) -> Bound / {abort.raise} =
  match p {
    PWild(_) -> { checker: checker, out: out },
    PBad(_) -> { checker: checker, out: out },
    PVar(v) ->
      {
        checker: note_typed(checker, v.span, scrutinee, []),
        out: out.push({ name: v.name.name, ty: scrutinee }),
      },
    PLit(l) ->
      {
        checker: expect(checker, l.span, scrutinee, lit_type(l.lit), b"pattern literal").checker,
        out: out,
      },
    PRange(r) -> { checker: bind_range(checker, r.span, r.lo, r.hi, scrutinee), out: out },
    PCtor(c) -> {
      let n: WithName = ctor_name(checker, c.name);
      let info = match n.name { Some(q) -> ctor_of(n.checker, q), None -> None };
      let kept = match info { Some(_) -> None, None -> kept_named(n.checker, c.name) };
      match ((info, kept)) {
        (None, Some(closed)) -> bind_kept(n.checker, c.name, c.args, closed, out),
        (None, None) -> if is_bare(c.name)
            || (match declared_value(n.checker, c.name) { Some(_) -> true, None -> false }) {
          let nm = c.name.name.name;
          let base = [b"constructors come from a `type` declaration with variants"];
          let notes = match builtin_type_arity(nm) {
            None -> base,
            Some(_) -> {
              let with_builtin = base.push(
                Bytes::concat_all([b"`", nm, b"` is a builtin type and declares none"]),
              );
              if nm == b"Secret" {
                with_builtin.push(
                  b"that is deliberate: a pattern binding the payload would be a one-line escape from every guarantee `Secret` makes",
                ).push(
                  b"use `Secret::verify` to check a candidate, `Secret::is_empty` to check presence, or hand the whole `Secret` to a handler clause",
                )
              } else { with_builtin }
            },
          };
          {
            checker: report_error_at(
              n.checker,
              b"E0101",
              c.name.span,
              Bytes::concat_all([b"unknown constructor `", nm, b"`"]),
              b"not found",
              notes,
            ),
            out: out,
          }
        } else { { checker: n.checker, out: out } },
        (Some(ci), _) -> {
          let inst = instantiate(ci.scheme, n.checker.fresh);
          let c1: Checker = { ..n.checker, fresh: inst.fresh };
          let shape = match inst.ty {
            TyFn(f) -> { fields: f.params, result: f.ret },
            other -> { fields: [], result: other },
          };
          let c2: Checker = expect(
            c1,
            c.span,
            scrutinee,
            shape.result,
            b"pattern constructor",
          ).checker;
          let nf = shape.fields.len();
          if nf != c.args.len() {
            {
              checker: report_error_at_and(
                c2,
                b"E0202",
                c.span,
                Bytes::concat_all([
                  b"constructor `",
                  ci.name,
                  b"` takes ",
                  ascii_of_int(nf),
                  b" field",
                  plural(nf),
                  b", but the pattern binds ",
                  ascii_of_int(c.args.len()),
                ]),
                Bytes::concat_all([b"expected ", ascii_of_int(nf), b" fields"]),
                ci.at,
                b"declared here",
                [],
              ),
              out: out,
            }
          } else {
            range(0, c.args.len()).fold({ checker: c2, out: out }, |acc: Bound, i: Int|
              bind_pattern(acc.checker, c.args.get(i), shape.fields.get(i), acc.out))
          }
        },
      }
    },
    PList(l) -> {
      let elem: WithTy = new_ty(checker);
      let c1: Checker = expect(
        elem.checker,
        l.span,
        scrutinee,
        list_type(elem.ty),
        b"list pattern",
      ).checker;
      let items = l.items.fold({ checker: c1, out: out }, |acc: Bound, x: Pattern|
        bind_pattern(acc.checker, x, elem.ty, acc.out));
      match l.rest {
        Some(r) -> bind_pattern(items.checker, r, list_type(elem.ty), items.out),
        None -> items,
      }
    },
    // Each alternative binds against the scrutinee alone; the first one's names are the arm's.
    POr(o) -> match o.alts {
      [] -> panic("an or-pattern with no alternatives"),
      [head, ..rest] -> {
        let first: Bound = bind_pattern(checker, head, scrutinee, []);
        let agreed: Checker = rest.fold(first.checker, |c: Checker, alt: Pattern| {
          let b: Bound = bind_pattern(c, alt, scrutinee, []);
          same_binders(b.checker, pat_span(alt), first.out, b.out)
        });
        { checker: agreed, out: out.concat(first.out) }
      },
    },
    PRecord(r) -> match record_fields(resolve(checker, scrutinee)) {
      Some(known) -> {
        let bound: Bound = r.fields.fold(
          { checker: checker, out: out },
          |acc: Bound, f: { name: Ident, pat: Pattern }|
            match field_get(known, f.name.name) {
              Some(t) -> bind_pattern(acc.checker, f.pat, t, acc.out),
              None ->
                {
                  checker: report_error_at(
                    acc.checker,
                    b"E0101",
                    f.name.span,
                    Bytes::concat_all([b"no field `", f.name.name, b"` on this record"]),
                    b"unknown field",
                    [],
                  ),
                  out: acc.out,
                },
            },
        );
        if r.rest { bound } else {
          let named = r.fields.map(|f: { name: Ident, pat: Pattern }| f.name.name);
          let omitted = known.filter(|field: Field| !named.contains(field.name));
          if omitted.len() > 0 {
            {
              checker: report_error_at(
                bound.checker,
                b"E0201",
                r.span,
                b"record pattern does not name every field",
                b"missing: ".concat(backticked(omitted.map(|field: Field| field.name), b", ")),
                [b"add the missing fields, or end the pattern with `..`"],
              ),
              out: bound.out,
            }
          } else { bound }
        }
      },
      None -> if r.rest {
        {
          checker: report_error_at(
            checker,
            b"E0201",
            r.span,
            b"cannot infer the record type of this pattern",
            b"a `..` pattern needs the record type to be known",
            [b"annotate the matched value"],
          ),
          out: out,
        }
      } else {
        let fs = r.fields.fold(
          { checker: checker, fs: [], out: out },
          |acc: { checker: Checker, fs: List<Field>, out: List<{ name: Bytes, ty: Type }> }, f: { name: Ident, pat: Pattern }| {
            let t: WithTy = new_ty(acc.checker);
            let b: Bound = bind_pattern(t.checker, f.pat, t.ty, acc.out);
            { checker: b.checker, fs: acc.fs.push({ name: f.name.name, ty: t.ty }), out: b.out }
          },
        );
        {
          checker: expect(
            fs.checker,
            r.span,
            scrutinee,
            TyRecord(fields_sorted(fs.fs)),
            b"record pattern",
          ).checker,
          out: fs.out,
        }
      },
    },
  }

/// An alternative binds the first one's names, each at the type the first gives it.
fn same_binders(
  checker: Checker,
  span: Span,
  want: List<{ name: Bytes, ty: Type }>,
  got: List<{ name: Bytes, ty: Type }>,
) -> Checker / {abort.raise} = {
  let wanted = want.map(|w: { name: Bytes, ty: Type }| w.name);
  let found = got.map(|g: { name: Bytes, ty: Type }| g.name);
  let missing = wanted.filter(|n: Bytes| !found.contains(n));
  let extra = found.filter(|n: Bytes| !wanted.contains(n));
  let typed = got.fold(checker, |c: Checker, g: { name: Bytes, ty: Type }|
    match binder_ty(want, g.name) {
      Some(t) -> expect(c, span, t, g.ty, b"an or-pattern binds each name at one type").checker,
      None -> c,
    });
  if missing.len() == 0 && extra.len() == 0 { typed } else {
    let label = if extra.len() == 0 {
      Bytes::concat_all([
        b"does not bind ",
        backticked(missing, b", "),
        b", which the first alternative does",
      ])
    } else if missing.len() == 0 {
      Bytes::concat_all([
        b"binds ",
        backticked(extra, b", "),
        b", which the first alternative does not",
      ])
    } else {
      Bytes::concat_all([
        b"binds ",
        backticked(extra, b", "),
        b" where the first alternative binds ",
        backticked(missing, b", "),
      ])
    };
    report_error_at(
      typed,
      b"E0212",
      span,
      b"the alternatives of an or-pattern bind different names",
      label,
      [b"every alternative binds the same names, so the arm can use each whichever one matched"],
    )
  }
}

/// The integer type a literal is of, by its name.
fn integer_of(literal: Lit) -> Option<Bytes> / {abort.raise} =
  match literal {
    LInt(_) -> Some(b"Int"),
    LFixed(ty, _) -> Some(Bytes::of_string(String::of_bytes(ty).ascii_upper())),
    LWide(ty, _, _) -> Some(Bytes::of_string(String::of_bytes(ty).ascii_upper())),
    _ -> None,
  }

/// `a <= b` over the 64-bit patterns two unsigned values are held as.
fn unsigned_le(a: Int, b: Int) -> Bool = {
  let top = 0 - 9223372036854775807 - 1;
  a ^ top <= b ^ top
}

/// Whether one integer literal is no greater than another of its type.
fn literal_le(ty: Bytes, lo: Lit, hi: Lit) -> Bool =
  match ((lo, hi)) {
    (LInt(a), LInt(b)) -> a <= b,
    (LFixed(_, a), LFixed(_, b)) -> if ty == b"U64" { unsigned_le(a, b) } else { a <= b },
    (LWide(_, ah, al), LWide(_, bh, bl)) -> if ah == bh { unsigned_le(al, bl) }
    else if ty == b"U128" { unsigned_le(ah, bh) }
    else { ah <= bh },
    _ -> false,
  }

/// A range's bounds are two integer literals of one type, the first no greater than the second.
fn bind_range(
  checker: Checker,
  span: Span,
  lo: Lit,
  hi: Lit,
  scrutinee: Type,
) -> Checker / {abort.raise} = {
  let form = [
    b"a range is written `lo..=hi`, as in `0..=9` or `b'a'..=b'z'`, and holds both bounds",
  ];
  match ((integer_of(lo), integer_of(hi))) {
    (Some(a), Some(b)) -> if a != b {
      report_error_at(
        checker,
        b"E0222",
        span,
        b"a range pattern's bounds are of one integer type",
        Bytes::concat_all([b"from a `", a, b"` to a `", b, b"`"]),
        form,
      )
    } else {
      let typed: Checker = expect(
        checker,
        span,
        scrutinee,
        lit_type(lo),
        b"pattern literal",
      ).checker;
      if literal_le(a, lo, hi) { typed } else {
        report_error_at(
          typed,
          b"E0222",
          span,
          b"a range pattern's first bound is greater than its second",
          b"no value is in this range",
          form,
        )
      }
    },
    _ ->
      report_error_at(
        checker,
        b"E0222",
        span,
        b"a range pattern's bounds are integer literals",
        b"one of these is not an integer",
        form,
      ),
  }
}

fn binder_ty(bs: List<{ name: Bytes, ty: Type }>, name: Bytes) -> Option<Type> =
  bs.fold(None, |acc: Option<Type>, b: { name: Bytes, ty: Type }|
    match acc { Some(_) -> acc, None -> if b.name == name { Some(b.ty) } else { None } })

fn infer_match(
  checker: Checker,
  span: Span,
  scrutinee: Expr,
  arms: List<MatchArm>,
  hint: Option<Hint>,
) -> Inferred / {abort.raise} = {
  let s: Inferred = infer(checker, scrutinee);
  let result: WithTy = new_ty(s.checker);
  // An arm is reached past every arm before it: `acc.checker`'s guards hold what those missing says.
  let walked: { checker: Checker, row: Row, ty: Type, tails: List<Int> } = arms.fold(
    { checker: result.checker, row: s.row, ty: result.ty, tails: [] },
    |acc: { checker: Checker, row: Row, ty: Type, tails: List<Int> }, arm: MatchArm| {
      let outside = reader_of(acc.checker);
      let pushed: Checker = { ..acc.checker, env: env_push(acc.checker.env) };
      let b: Bound = bind_pattern(pushed, arm.pat, s.ty, []);
      let bound: Checker = bind_all(b.checker, b.out);
      let inside: Checker = {
        ..bound,
        guards: guards::matched(outside, bound.guards, scrutinee, arm.pat),
      };
      let guarded: WithBodyRow = match arm.guard {
        Some(g) -> {
          let o: Inferred = infer(inside, g);
          let c: Checker = expect(
            o.checker,
            expr_span(g),
            bool_type(),
            o.ty,
            b"match guard",
          ).checker;
          let j: WithRow = join(c, span, acc.row, o.row);
          { checker: assuming(j.checker, g, true), row: j.row }
        },
        None -> { checker: inside, row: acc.row },
      };
      let body: Inferred = infer(guarded.checker, arm.body, hint_after(hint, acc.ty));
      let j: WithRow = join(body.checker, span, guarded.row, body.row);
      let left: Checker = leaving(j.checker, acc.checker.guards);
      let missed: Checker = match arm.guard {
        None -> { ..left, guards: guards::unmatched(outside, left.guards, scrutinee, arm.pat) },
        Some(_) -> left,
      };
      let popped: Checker = { ..missed, env: env_pop(missed.env) };
      let n: Joined = join_next(
        { checker: popped, ty: acc.ty, tails: acc.tails },
        expr_span(arm.body),
        body.ty,
        b"match arms must agree",
      );
      { checker: n.checker, row: j.row, ty: n.ty, tails: n.tails }
    },
  );
  {
    checker: check_exhaustive(
      close_tails(leaving(walked.checker, s.checker.guards), walked.tails),
      span,
      arms,
    ),
    ty: walked.ty,
    row: walked.row,
  }
}

// --- Exhaustiveness: usefulness over a matrix with one row per unguarded arm ---------------------

/// `CoverNothing` is a constructor that does not resolve: it matches nothing, so its arm covers nothing.
type CoveragePattern =
  | CoverAny
  | CoverNothing
  | CoverCtor({ family: Bytes, key: Bytes, name: Bytes, args: List<CoveragePattern> })
  | CoverRecord(List<{ name: Bytes, pat: CoveragePattern }>)
  /// The integers of the type `family` names from `lo` through `hi`: a literal's one, or a range's.
  | CoverSpan({ family: Bytes, lo: Int, hi: Int })
  /// Never a row's head inside the search: `uncovered` splits it into a row per alternative first.
  | CoverEither(List<CoveragePattern>)

/// `lo` and `hi` are the integers a cell of an integer column holds, and zero for a constructor.
type CoverageCtor = { key: Bytes, name: Bytes, arity: Int, lo: Int, hi: Int }

fn check_exhaustive(checker: Checker, span: Span, arms: List<MatchArm>) -> Checker / {abort.raise} = {
  let rows = arms.fold([], |acc: List<List<CoveragePattern>>, arm: MatchArm|
    match arm.guard { None -> acc.push([coverage_pat(checker, arm.pat)]), Some(_) -> acc });
  let missing = uncovered(checker, rows, 1);
  if missing.len() == 0 { checker } else {
    report_error_at(
      checker,
      b"E0205",
      span,
      b"match does not cover every case",
      b"not covered: ".concat(
        Bytes::join(
          missing.map(|patterns: List<CoveragePattern>| backticked_text(shown(patterns.get(0)))),
          b", ",
        ),
      ),
      [b"add the missing arms, or a `_` arm"],
    )
  }
}

fn coverage_pat(checker: Checker, p: Pattern) -> CoveragePattern / {abort.raise} =
  match p {
    PCtor(c) -> {
      let info = match covered_ctor(checker, c.name) {
        Some(q) -> ctor_of(checker, q),
        None -> None,
      };
      match info {
        Some(k) ->
          CoverCtor({
            family: k.type_name,
            key: k.name,
            name: k.simple_name,
            args: c.args.map(|a: Pattern| coverage_pat(checker, a)),
          }),
        // A constructor its type's module keeps is refused where it is named, and said once.
        None -> match kept_named(checker, c.name) { Some(_) -> CoverAny, None -> CoverNothing },
      }
    },
    PLit(l) -> match l.lit {
      LBool(b) -> {
        let k = if b { b"true" } else { b"false" };
        CoverCtor({ family: b"#bool", key: k, name: k, args: [] })
      },
      LUnit -> CoverCtor({ family: b"#unit", key: b"()", name: b"()", args: [] }),
      other -> cover_span(other, other),
    },
    PRange(r) -> cover_span(r.lo, r.hi),
    PList(l) -> {
      let n = l.items.len();
      let last = match l.rest { Some(r) -> coverage_pat(checker, r), None -> list_con(b"[]", []) };
      range(0, n).fold(last, |tail: CoveragePattern, i: Int|
        list_con(b"::", [coverage_pat(checker, l.items.get(n - 1 - i)), tail]))
    },
    PRecord(r) ->
      CoverRecord(
        r.fields.map(|f: { name: Ident, pat: Pattern }|
          { name: f.name.name, pat: coverage_pat(checker, f.pat) }),
      ),
    POr(o) -> CoverEither(o.alts.map(|a: Pattern| coverage_pat(checker, a))),
    PWild(_) -> CoverAny,
    PVar(_) -> CoverAny,
    PBad(_) -> CoverAny,
  }

/// The values from one literal through another. Over `U8`, `U16` or `U32` they are a span of the
/// type; no other integer type's least and greatest values are both literals, so no list of arms
/// exhausts one and its literals stand as any other literal does.
fn cover_span(lo: Lit, hi: Lit) -> CoveragePattern / {abort.raise} = {
  let literal = CoverCtor({ family: b"#lit", key: b"", name: b"", args: [] });
  match ((lo, hi)) {
    (LFixed(_, a), LFixed(_, b)) -> match ((integer_of(lo), integer_of(hi))) {
      (Some(ty), Some(other)) -> if ty != other { CoverNothing }
      else if ty != b"U8" && ty != b"U16" && ty != b"U32" { literal }
      else if a > b { CoverNothing }
      else { CoverSpan({ family: int_family().concat(ty), lo: a, hi: b }) },
      _ -> literal,
    },
    _ -> literal,
  }
}

fn int_family() -> Bytes = b"#int:"

/// The greatest value of the unsigned width an integer column is of; its least is zero.
fn int_top(family: Bytes) -> Int / {abort.raise} = {
  let ty = family.slice(int_family().len(), family.len());
  if ty == b"U8" { 255 } else if ty == b"U16" { 65535 } else { 4294967295 }
}

/// A cell as a pattern writes it: `7u8`, `0u8..=9u8`.
fn span_text(family: Bytes, lo: Int, hi: Int) -> Bytes / {abort.raise} = {
  let suffix = Bytes::of_string(
    String::of_bytes(family.slice(int_family().len(), family.len())).ascii_lower(),
  );
  if lo == hi { ascii_of_int(lo).concat(suffix) }
  else { Bytes::concat_all([ascii_of_int(lo), suffix, b"..=", ascii_of_int(hi), suffix]) }
}

/// The cells an integer column's heads cut its type into, least first. Each head holds whole cells
/// and nothing else, so the cells stand for every value of the type as its constructors do a sum's.
fn int_cells(
  rows: List<List<CoveragePattern>>,
  family: Bytes,
) -> List<CoverageCtor> / {abort.raise} = {
  let top = int_top(family);
  let starts = rows.fold([0], |acc: List<Int>, r: List<CoveragePattern>|
    match r.get(0) {
      CoverSpan(s) -> if s.family != family { acc } else {
        let from = acc.push_unique(s.lo);
        if s.hi < top { from.push_unique(s.hi + 1) } else { from }
      },
      _ -> acc,
    }).sort(
  );
  range(0, starts.len()).map(|i: Int| {
    let lo = starts.get(i);
    let hi = if i + 1 < starts.len() { starts.get(i + 1) - 1 } else { top };
    let text = span_text(family, lo, hi);
    { key: text, name: text, arity: 0, lo: lo, hi: hi }
  })
}

/// Whether a row's head is this constructor; a span is every cell it holds.
fn heads(pattern: CoveragePattern, family: Bytes, k: CoverageCtor) -> Bool =
  match pattern {
    CoverCtor(c) -> c.family == family && c.key == k.key,
    CoverSpan(s) -> s.family == family && s.lo <= k.lo && k.hi <= s.hi,
    _ -> false,
  }

fn list_con(key: Bytes, args: List<CoveragePattern>) -> CoveragePattern =
  CoverCtor({ family: b"#list", key: key, name: key, args: args })

fn wilds(n: Int) -> List<CoveragePattern> = range(0, n).map(|_: Int| CoverAny)

fn family_of(pattern: CoveragePattern) -> Bytes =
  match pattern {
    CoverCtor(c) -> c.family,
    CoverSpan(s) -> s.family,
    CoverRecord(_) -> b"#rec",
    _ -> b"",
  }

fn heads_ctor(
  rows: List<List<CoveragePattern>>,
  family: Bytes,
  k: CoverageCtor,
) -> Bool / {abort.raise} =
  rows.fold(false, |b: Bool, r: List<CoveragePattern>| b || heads(r.get(0), family, k))

/// `None` for a family no list of arms exhausts: literals, and a column that names no constructor.
fn family_ctors(
  checker: Checker,
  rows: List<List<CoveragePattern>>,
  family: Bytes,
) -> Option<List<CoverageCtor>> / {abort.raise} = {
  let named = |key: Bytes, arity: Int| { key: key, name: key, arity: arity, lo: 0, hi: 0 };
  if family == b"#bool" { Some([named(b"true", 0), named(b"false", 0)]) }
  else if family == b"#unit" { Some([named(b"()", 0)]) }
  else if family == b"#list" { Some([named(b"[]", 0), named(b"::", 2)]) }
  else if family == b"#lit" || family == b"" { None }
  else if family.starts_with(int_family()) { Some(int_cells(rows, family)) } else {
    Some(
      checker.ctors.filter(|ctor_info: CtorInfo| ctor_info.type_name == family).map(
        |ctor_info: CtorInfo|
          {
            key: ctor_info.name,
            name: ctor_info.simple_name,
            arity: ctor_info.arity,
            lo: 0,
            hi: 0,
          },
      ),
    )
  }
}

/// Rows of values no row matches, each `n` wide; empty when the rows are exhaustive.
fn uncovered(
  checker: Checker,
  rows: List<List<CoveragePattern>>,
  n: Int,
) -> List<List<CoveragePattern>> / {abort.raise} =
  uncovered_within(checker, rows, n, search_room(checker, rows, n))

/// Each step of the search puts the columns of what heads the first column in its place, and a path
/// steps through each place once: so the columns there are, and those each pattern can bring (a
/// constructor at most as many as any has), are room enough.
fn search_room(checker: Checker, rows: List<List<CoveragePattern>>, n: Int) -> Int = {
  let most = checker.ctors.fold(2, |m: Int, c: CtorInfo| if c.arity > m { c.arity } else { m });
  rows.fold(n + 1, |acc: Int, r: List<CoveragePattern>|
    r.fold(acc, |a: Int, p: CoveragePattern| a + brought(p, most)))
}

fn brought(p: CoveragePattern, most: Int) -> Int =
  match p {
    CoverAny -> 0,
    CoverNothing -> 0,
    CoverCtor(c) -> c.args.fold(most, |n: Int, a: CoveragePattern| n + brought(a, most)),
    CoverSpan(_) -> 0,
    CoverRecord(fs) ->
      fs.fold(fs.len(), |n: Int, f: { name: Bytes, pat: CoveragePattern }|
        n + brought(f.pat, most)),
    CoverEither(alts) -> alts.fold(0, |n: Int, a: CoveragePattern| n + brought(a, most)),
  }

fn uncovered_within(
  checker: Checker,
  rows: List<List<CoveragePattern>>,
  n: Int,
  room: Int,
) -> List<List<CoveragePattern>> / {abort.raise} =
  if room <= 0 { panic("a coverage search past its columns") } else {
    uncovered_split(
      checker,
      rows.fold([], |acc: List<List<CoveragePattern>>, patterns: List<CoveragePattern>|
        acc.concat(split_or(patterns))),
      n,
      room - 1,
    )
  }

/// A row headed by an or-pattern is one row per alternative, nested ones included.
fn split_or(patterns: List<CoveragePattern>) -> List<List<CoveragePattern>> =
  match patterns {
    [CoverEither(alts), ..rest] ->
      alternatives(CoverEither(alts)).map(|pattern: CoveragePattern| prepend(pattern, rest)),
    _ -> [patterns],
  }

fn alternatives(pattern: CoveragePattern) -> List<CoveragePattern> =
  match pattern {
    CoverEither(alts) ->
      alts.fold([], |acc: List<CoveragePattern>, alt: CoveragePattern|
        acc.concat(alternatives(alt))),
    _ -> [pattern],
  }

fn uncovered_split(
  checker: Checker,
  rows: List<List<CoveragePattern>>,
  n: Int,
  room: Int,
) -> List<List<CoveragePattern>> / {abort.raise} =
  if rows.len() == 0 { [wilds(n)] }
  else if n == 0 { [] } else {
    let family = rows.fold(b"", |acc: Bytes, r: List<CoveragePattern>|
      if acc.len() > 0 { acc } else { family_of(r.get(0)) });
    if family == b"#rec" { uncovered_record(checker, rows, n, room) } else {
      match family_ctors(checker, rows, family) {
        None ->
          uncovered_within(checker, default_rows(rows, family), n - 1, room).map(
            |w: List<CoveragePattern>| prepend(CoverAny, w),
          ),
        Some(all) -> if all.fold(true, |b: Bool, k: CoverageCtor|
            b && heads_ctor(rows, family, k)) {
          all.fold([], |acc: List<List<CoveragePattern>>, k: CoverageCtor|
            acc.concat(through(checker, rows, n, family, k, room)))
        } else {
          // A constructor no arm names is left uncovered exactly when the default rows are; then the named ones are searched too.
          match uncovered_within(checker, default_rows(rows, family), n - 1, room).at(0) {
            None -> [],
            Some(w) ->
              all.fold([], |acc: List<List<CoveragePattern>>, k: CoverageCtor|
                if heads_ctor(rows, family, k) {
                  acc.concat(through(checker, rows, n, family, k, room))
                } else {
                  acc.push(
                    prepend(
                      CoverCtor({ family: family, key: k.key, name: k.name, args: wilds(k.arity) }),
                      w,
                    ),
                  )
                }),
          }
        },
      }
    }
  }

fn through(
  checker: Checker,
  rows: List<List<CoveragePattern>>,
  n: Int,
  family: Bytes,
  k: CoverageCtor,
  room: Int,
) -> List<List<CoveragePattern>> / {abort.raise} =
  uncovered_within(checker, specialize(rows, family, k), k.arity + n - 1, room).map(
    |patterns: List<CoveragePattern>|
      prepend(
        CoverCtor({ family: family, key: k.key, name: k.name, args: patterns.take(k.arity) }),
        patterns.drop(k.arity),
      ),
  )

/// A head of another family, or of the wrong arity, counts as a wildcard: its error is already reported.
fn specialize(
  rows: List<List<CoveragePattern>>,
  family: Bytes,
  k: CoverageCtor,
) -> List<List<CoveragePattern>> / {abort.raise} =
  rows.fold([], |acc: List<List<CoveragePattern>>, patterns: List<CoveragePattern>|
    match patterns.get(0) {
      CoverNothing -> acc,
      CoverCtor(c) -> if c.family != family { acc.push(wilds(k.arity).concat(patterns.drop(1))) }
      else if c.key != k.key { acc }
      else if c.args.len() == k.arity { acc.push(c.args.concat(patterns.drop(1))) }
      else { acc.push(wilds(k.arity).concat(patterns.drop(1))) },
      CoverSpan(s) -> if s.family == family && !heads(patterns.get(0), family, k) { acc }
      else { acc.push(wilds(k.arity).concat(patterns.drop(1))) },
      _ -> acc.push(wilds(k.arity).concat(patterns.drop(1))),
    })

fn default_rows(
  rows: List<List<CoveragePattern>>,
  family: Bytes,
) -> List<List<CoveragePattern>> / {abort.raise} =
  rows.fold([], |acc: List<List<CoveragePattern>>, patterns: List<CoveragePattern>|
    match patterns.get(0) {
      CoverNothing -> acc,
      CoverCtor(c) -> if c.family == family { acc } else { acc.push(patterns.drop(1)) },
      CoverSpan(s) -> if s.family == family { acc } else { acc.push(patterns.drop(1)) },
      _ -> acc.push(patterns.drop(1)),
    })

/// A record is one constructor over every field some arm names; the rest are wildcards everywhere.
fn uncovered_record(
  checker: Checker,
  rows: List<List<CoveragePattern>>,
  n: Int,
  room: Int,
) -> List<List<CoveragePattern>> / {abort.raise} = {
  let names = rows.fold([], |acc: List<Bytes>, r: List<CoveragePattern>|
    match r.get(0) {
      CoverRecord(fs) ->
        fs.fold(acc, |a: List<Bytes>, f: { name: Bytes, pat: CoveragePattern }|
          if a.contains(f.name) { a } else { a.push(f.name) }),
      _ -> acc,
    });
  let k = names.len();
  let spread = rows.fold([], |acc: List<List<CoveragePattern>>, r: List<CoveragePattern>|
    match r.get(0) {
      CoverNothing -> acc,
      CoverRecord(fs) -> acc.push(names.map(|nm: Bytes| field_pat(fs, nm)).concat(r.drop(1))),
      _ -> acc.push(wilds(k).concat(r.drop(1))),
    });
  uncovered_within(checker, spread, k + n - 1, room).map(|w: List<CoveragePattern>|
    prepend(
      CoverRecord(range(0, k).map(|i: Int| { name: names.get(i), pat: w.get(i) })),
      w.drop(k),
    ))
}

fn field_pat(fs: List<{ name: Bytes, pat: CoveragePattern }>, name: Bytes) -> CoveragePattern =
  fs.fold(CoverAny, |acc: CoveragePattern, f: { name: Bytes, pat: CoveragePattern }|
    if f.name == name { f.pat } else { acc })

fn shown(x: CoveragePattern) -> Bytes / {abort.raise} =
  match x {
    CoverCtor(c) -> if c.family == b"#list" { shown_list(x, []) }
    else if c.args.len() == 0 { c.name } else {
      Bytes::concat_all([
        c.name,
        b"(",
        Bytes::join(c.args.map(|a: CoveragePattern| shown(a)), b", "),
        b")",
      ])
    },
    CoverRecord(fs) -> shown_record(fs),
    _ -> b"_",
  }

fn shown_list(pattern: CoveragePattern, items: List<Bytes>) -> Bytes / {abort.raise} =
  match pattern {
    CoverCtor(c) -> if c.key == b"::" && c.args.len() == 2 {
      shown_list(c.args.get(1), items.push(shown(c.args.get(0))))
    } else { Bytes::concat_all([b"[", Bytes::join(items, b", "), b"]"]) },
    _ -> Bytes::concat_all([b"[", Bytes::join(items.push(b".."), b", "), b"]"]),
  }

/// A tuple is the record `{_0, _1, ..}` and is shown as one; a record's other fields may be unnamed, so it ends in `..`.
fn shown_record(fs: List<{ name: Bytes, pat: CoveragePattern }>) -> Bytes / {abort.raise} = {
  let parts = fs.map(|f: { name: Bytes, pat: CoveragePattern }| shown(f.pat));
  let tuple = fs.len() > 1
    && range(0, fs.len()).fold(true, |b: Bool, i: Int|
      b && fs.get(i).name == b"_".concat(ascii_of_int(i)));
  if !parts.fold(false, |b: Bool, t: Bytes| b || t != b"_") { b"_" }
  else if tuple { Bytes::concat_all([b"(", Bytes::join(parts, b", "), b")"]) } else {
    let named = range(0, fs.len()).filter(|i: Int| parts.get(i) != b"_");
    Bytes::concat_all([
      b"{",
      Bytes::join(
        named.map(|i: Int| Bytes::concat_all([fs.get(i).name, b": ", parts.get(i)])).push(b".."),
        b", ",
      ),
      b"}",
    ])
  }
}

// --- Effects ----------------------------------------------------------------------------------

fn resolve_op(
  checker: Checker,
  eff: QName,
  ident: Ident,
) -> { checker: Checker, hit: Option<{ info: EffectInfo, op: OpInfo }> } / {abort.raise} = {
  let e: WithName = effect_name(checker, eff);
  match e.name {
    None -> { checker: e.checker, hit: None },
    Some(name) -> match effect_of(e.checker, name) {
      None -> if name == cell() {
        {
          checker: report_error_at(
            e.checker,
            b"E0103",
            eff.span,
            b"`cell` is a builtin effect and cannot be performed directly",
            b"not a declared effect",
            [
              b"read and write a region's cell with `cell_get(c)` and `cell_set(c, v)` inside `with_cell[r](..) { c -> .. }`",
            ],
          ),
          hit: None,
        }
      } else if name == hold() {
        {
          checker: report_error_at(
            e.checker,
            b"E0103",
            eff.span,
            b"`hold` is a builtin effect and cannot be performed directly",
            b"not a declared effect",
            [
              b"read what a hold holds with `h.get()`, inside `with_hold[r](..) { h -> .. }` or in a function it hands the hold to",
            ],
          ),
          hit: None,
        }
      } else { { checker: e.checker, hit: None } },
      Some(info) -> match op_named(info, ident.name) {
        Some(o) -> { checker: e.checker, hit: Some({ info: info, op: o }) },
        None -> {
          let known = info.ops.map(|o: OpInfo| o.name);
          {
            checker: report_error_at_and(
              e.checker,
              b"E0104",
              ident.span,
              Bytes::concat_all([
                b"effect `",
                eff.name.name,
                b"` has no operation `",
                ident.name,
                b"`",
              ]),
              b"not declared",
              info.at,
              Bytes::concat_all([b"`", info.name, b"` is declared here"]),
              [
                if known.len() == 0 {
                  Bytes::concat_all([b"`", info.name, b"` declares no operations"])
                } else {
                  Bytes::concat_all([
                    b"operations of `",
                    info.name,
                    b"`: ",
                    backticked(known, b", "),
                  ])
                },
              ],
            ),
            hit: None,
          }
        },
      },
    },
  }
}

/// The effect as this module can write it, so a suggestion parses.
/// How this module's source names an effect: by its imported name or through a module binder; none
/// when it names it neither way, and a row it writes must import it first.
fn written_as(checker: Checker, eff: Bytes) -> Option<Bytes> / {abort.raise} =
  if is_prelude_effect(eff) || is_region_effect(eff) { Some(eff) } else {
    let scope = scope_of(checker);
    match scope.bound.effects.fold(None, |acc: Option<Bytes>, b: Binding|
        match acc {
          Some(_) -> acc,
          None -> if b.qualified == eff { Some(b.name) } else { None },
        }) {
      Some(n) -> Some(n),
      None -> {
        let simple = match effect_of(checker, eff) { Some(info) -> info.simple_name, None -> eff };
        scope.modules.filter(written_binder).fold(None, |acc: Option<Bytes>, mb: ModuleBinding|
          match acc {
            Some(_) -> acc,
            None -> match lookup_declared(
                checker.resolved.declarations.get(mb.target),
                EffectSpace,
                simple,
              ) {
              Some(d) -> if d.qualified == eff {
                Some(Bytes::concat_all([mb.binder, b"::", simple]))
              } else { None },
              None -> None,
            },
          })
      },
    }
  }

/// A binder an import wrote; one the resolver added for a spliced default or an expanded set has no
/// span, and no source can spell it.
fn written_binder(binding: ModuleBinding) -> Bool = binding.span.end > binding.span.start

fn as_written(checker: Checker, eff: Bytes) -> Bytes / {abort.raise} =
  match written_as(checker, eff) {
    Some(w) -> w,
    None -> match effect_of(checker, eff) { Some(info) -> info.simple_name, None -> eff },
  }

fn resource_for(
  checker: Checker,
  info: EffectInfo,
  op_info: OpInfo,
  resource: Option<Ident>,
  span: Span,
) -> WithResource / {abort.raise} =
  match resource {
    Some(r) -> if op_info.resource_param {
      {
        checker: checker,
        resource: Some(match checker.label_params.get(r.name) {
          Some(v) -> RVar(v),
          None -> RNamed(r.name),
        }),
      }
    } else {
      {
        checker: report_error_at_and(
          checker,
          b"E0304",
          r.span,
          Bytes::concat_all([
            b"`",
            info.name,
            b".",
            op_info.name,
            b"` is not resource-parameterized",
          ]),
          b"unexpected resource label",
          op_info.at,
          b"declared without `[r]`",
          [
            Bytes::concat_all([
              b"drop the label, or declare it as `",
              mode_text(op_info.mode),
              b" ",
              op_info.name,
              b"[r](..)`",
            ]),
          ],
        ),
        resource: None,
      }
    },
    None -> if op_info.resource_param {
      {
        checker: report_error_at_and(
          checker,
          b"E0304",
          span,
          Bytes::concat_all([
            b"`",
            info.name,
            b".",
            op_info.name,
            b"` is declared with a resource parameter",
          ]),
          b"missing the `[resource]` label",
          op_info.at,
          Bytes::concat_all([b"declared as `", op_info.name, b"[r](..)`"]),
          [
            Bytes::concat_all([
              b"write `",
              as_written(checker, info.name),
              b".",
              op_info.name,
              b"[<resource>](..)`; the label is what lets two tests be scheduled together",
            ]),
          ],
        ),
        resource: None,
      }
    } else { { checker: checker, resource: Some(RSingleton) } },
  }

/// A clause's resource: a written label, or `RAny` when the clause is written `[*]` and so
/// answers the operation on every label. A clause that names no label at all and a `[*]` clause
/// are different things, which is why the caller passes the clause rather than its `resource`.
fn clause_resource_for(
  checker: Checker,
  info: EffectInfo,
  op_info: OpInfo,
  clause: HandleClause,
  span: Span,
) -> WithResource / {abort.raise} =
  if !clause.every_label { resource_for(checker, info, op_info, clause.resource, span) }
  else if op_info.resource_param { { checker: checker, resource: Some(RAny) } } else {
    {
      checker: report_error_at_and(
        checker,
        b"E0304",
        span,
        Bytes::concat_all([
          b"`",
          info.name,
          b".",
          op_info.name,
          b"` is not resource-parameterized",
        ]),
        b"`[*]` names no label",
        op_info.at,
        b"declared without `[r]`",
        [
          Bytes::concat_all([
            b"drop it, or declare it as `",
            mode_text(op_info.mode),
            b" ",
            op_info.name,
            b"[r](..)`",
          ]),
        ],
      ),
      resource: None,
    }
  }

fn op_free_vars(op_info: OpInfo) -> List<Int> / {abort.raise} = {
  let fv = op_info.params.fold({ tys: [], rows: [] }, |acc: Free, ty: Type|
    free_vars(subst_new(), ty, acc));
  free_vars(subst_new(), op_info.ret, fv).tys
}

fn op_scheme(op_info: OpInfo) -> Scheme / {abort.raise} =
  match op_info.scheme {
    Some(sc) -> sc,
    None ->
      {
        ty_vars: op_free_vars(op_info),
        row_vars: [],
        label_vars: [],
        ty: fn_type(op_info.params, op_info.ret, row_empty()),
      },
  }

type OpShape = { checker: Checker, params: List<Type>, ret: Type, row: Row }

fn instantiate_op(checker: Checker, op_info: OpInfo) -> OpShape / {abort.raise} = {
  let inst = instantiate(op_scheme(op_info), checker.fresh);
  let c: Checker = { ..checker, fresh: inst.fresh };
  match inst.ty {
    TyFn(f) -> { checker: c, params: f.params, ret: f.ret, row: f.effects },
    _ -> panic("operation schemes are function types"),
  }
}

fn instantiate_op_for_clause(checker: Checker, op_info: OpInfo) -> OpShape / {abort.raise} = {
  let sc = op_scheme(op_info);
  let tys: { checker: Checker, vs: List<Int> } = sc.ty_vars.fold(
    { checker: checker, vs: [] },
    |acc: { checker: Checker, vs: List<Int> }, v: Int| {
      let o: WithVar = new_ty_var(acc.checker);
      {
        checker: { ..o.checker, subst: mark_rigid_ty(o.checker.subst, o.var) },
        vs: acc.vs.push(o.var),
      }
    },
  );
  let rows: { checker: Checker, vs: List<Int> } = sc.row_vars.fold(
    { checker: tys.checker, vs: [] },
    |acc: { checker: Checker, vs: List<Int> }, v: Int| {
      let o: WithVar = new_row_var(acc.checker);
      {
        checker: { ..o.checker, subst: mark_rigid_row(o.checker.subst, o.var) },
        vs: acc.vs.push(o.var),
      }
    },
  );
  match rename_scheme(sc, tys.vs, rows.vs, []) {
    TyFn(f) -> { checker: rows.checker, params: f.params, ret: f.ret, row: f.effects },
    _ -> panic("operation schemes are function types"),
  }
}

/// Whether `x` in `x.name(..)` is a local binding, so the call is one on its value and no perform.
fn on_a_local(checker: Checker, x: QName) -> Bool / {abort.raise} =
  is_bare(x) && (match env_depth_of(checker.env, x.name.name) { Some(d) -> d > 0, None -> false })

fn names_effect(checker: Checker, x: QName) -> Bool / {abort.raise} =
  lookup(scope_of(checker).bound, EffectSpace, x.name.name) != None

/// A local and an effect of one name leave `x.name(..)` with two readings, which is refused: the
/// call is then read as the perform.
fn both_named(checker: Checker, x: QName) -> Checker =
  report_error_at(
    checker,
    b"E0105",
    x.span,
    Bytes::concat_all([b"`", x.name.name, b"` is a binding here and an effect"]),
    b"a call on the binding, or a perform of the effect",
    [
      b"`x.name(..)` calls a function on the value `x` where `x` is a binding, and performs an operation of the effect `x` otherwise; give the binding another name",
    ],
  )

fn infer_perform(
  checker: Checker,
  span: Span,
  eff: QName,
  ident: Ident,
  resource: Option<Ident>,
  args: List<Expr>,
) -> Inferred / {abort.raise} = {
  // Read ahead for what the arguments are expected to be; an unknown operation is reported below.
  let wanted = match resolve_op(checker, eff, ident).hit { Some(hit) -> hit.op.params, None -> [] };
  let as_: { checker: Checker, tys: List<Type>, row: Row } = infer_args(
    checker,
    args,
    span,
    [],
    None,
    wanted,
    NothingMet,
    None,
  );
  let r: WithHit = resolve_op(as_.checker, eff, ident);
  match r.hit {
    None -> {
      let o: WithTy = new_ty(r.checker);
      { checker: o.checker, ty: o.ty, row: as_.row }
    },
    Some(hit) -> {
      let res: WithResource = resource_for(r.checker, hit.info, hit.op, resource, span);
      match res.resource {
        None -> {
          let o: WithTy = new_ty(res.checker);
          { checker: o.checker, ty: o.ty, row: as_.row }
        },
        Some(resource_) -> {
          let shape: OpShape = instantiate_op(res.checker, hit.op);
          if shape.params.len() != args.len() {
            let n = shape.params.len();
            {
              checker: report_error_at_and(
                shape.checker,
                b"E0202",
                span,
                Bytes::concat_all([
                  b"`",
                  hit.info.simple_name,
                  b".",
                  hit.op.name,
                  b"` takes ",
                  ascii_of_int(n),
                  b" argument",
                  plural(n),
                  b", but ",
                  supplied(args.len()),
                ]),
                Bytes::concat_all([
                  b"expected ",
                  ascii_of_int(n),
                  b", found ",
                  ascii_of_int(args.len()),
                ]),
                hit.op.at,
                b"declared here",
                [],
              ),
              ty: shape.ret,
              row: as_.row,
            }
          } else {
            let checked: Checker = expect_arguments(
              shape.checker,
              shape.params,
              as_.tys,
              |c: Checker, i: Int|
                expect(
                  c,
                  expr_span(args.get(i)),
                  shape.params.get(i),
                  as_.tys.get(i),
                  b"operation argument",
                ).checker,
            );
            let atom = {
              effect: hit.info.name,
              resource: resource_,
              mode: hit.op.mode,
              op: Some(hit.op.name),
            };
            let noted: Checker = note_handoff(
              note_spawn(checked, hit.info, hit.op, args, as_.tys),
              hit.info,
              hit.op,
              args,
              as_.tys,
            );
            let c1: Checker = record_site(noted, atom, span, DirectPerform);
            let op_row = resolve_row_in(c1, shape.row);
            let c2: Checker = op_row.atoms.fold(c1, |c: Checker, a: Atom|
              record_site(c, a, span, PerformThroughArgs));
            let j1: WithRow = join(c2, span, as_.row, op_row);
            let j2: WithRow = join(j1.checker, span, j1.row, row_singleton(atom));
            let taken: { checker: Checker, short: Bool } = match ((
                least_taken(hit.info, hit.op),
                args.at(0),
              )) {
              (Some(least), Some(a)) -> {
                let o = guards::at_least(reader_of(j2.checker), j2.checker.guards, a, least);
                { checker: { ..j2.checker, guards: o.g }, short: !o.ok }
              },
              _ -> { checker: j2.checker, short: false },
            };
            // An operation's answer is read off no reference, so the perform's own type is filed.
            let typed: Checker = note_typed(taken.checker, span, shape.ret, []);
            if taken.short {
              {
                checker: record_site(typed, abort_atom(), span, DirectPerform),
                ty: shape.ret,
                row: { ..j2.row, atoms: atoms_insert(j2.row.atoms, abort_atom()) },
              }
            } else { { checker: typed, ty: shape.ret, row: j2.row } }
          }
        },
      }
    },
  }
}

/// The least a channel's capacity and a draw's bound may be: below it the operation raises.
fn least_taken(info: EffectInfo, op: OpInfo) -> Option<Int> =
  if info.module != b"" { None }
  else if info.name == b"task" && op.name == b"channel" { Some(0) }
  else if info.name == b"random" && op.name == b"below" { Some(1) }
  else { None }

type HandleAcc = {
  checker: Checker,
  handled: List<Atom>,
  selected: List<OpKey>,
  clause_rows: Row,
  around: List<ClauseSite>,
}

fn spawn_counts(checker: Checker) -> List<Int> =
  checker.open_regions.map(|region: OpenRegion| region.spawns.len())

/// A raise does not come back, so a clause for it answers for the whole `handle`, as one that binds
/// `resume` does.
fn answers_raise(checker: Checker, clause: HandleClause) -> Bool / {abort.raise} =
  match resolve_op(checker, clause.eff, clause.op).hit {
    Some(hit) -> is_raise(hit.op.mode),
    None -> false,
  }

/// The variables a `handle` declares, typed where it stands: what each holds, and what making them
/// performs.
type MadeVars = { checker: Checker, row: Row, vars: List<{ name: Ident, ty: Type }> }

/// Each initializer sees the variables above it, as values: none of them is assignable there.
fn made_vars(checker: Checker, vars: List<HandlerVar>) -> MadeVars / {abort.raise} = {
  let pushed: Checker = { ..checker, env: env_push(checker.env) };
  let made = vars.fold(
    { checker: pushed, row: row_empty(), vars: [] },
    |acc: MadeVars, v: HandlerVar| {
      let written: { checker: Checker, ty: Option<Type> } = match v.ty {
        Some(te) -> {
          let w: WithTy = conv_type(acc.checker, te);
          { checker: hold_written(w.checker, te, w.ty, false), ty: Some(w.ty) }
        },
        None -> { checker: acc.checker, ty: None },
      };
      let o: Inferred = infer(written.checker, v.init, match written.ty {
        Some(t) -> hint_of(t),
        None -> None,
      });
      let ty = match written.ty { Some(t) -> t, None -> o.ty };
      let checked: Checker = match written.ty {
        Some(t) ->
          expect(o.checker, expr_span(v.init), t, o.ty, b"the variable's written type").checker,
        None -> o.checker,
      };
      let j: WithRow = join(checked, v.span, acc.row, o.row);
      let once: Checker = match acc.vars.filter(|x: { name: Ident, ty: Type }|
          x.name.name == v.name.name) {
        [first, ..] ->
          duplicate(j.checker, v.name, location_of(j.checker, first.name.span), b"variable"),
        [] -> j.checker,
      };
      let noted: Checker = note_typed(
        note_typed(once, v.name.span, ty, []),
        read_site(v.name.span),
        ty,
        [],
      );
      {
        checker: { ..noted, env: env_bind(noted.env, v.name.name, monomorphic(ty)) },
        row: j.row,
        vars: acc.vars.push({ name: v.name, ty: ty }),
      }
    },
  );
  { ..made, checker: { ..made.checker, env: env_pop(made.checker.env) } }
}

/// `checker` with a handler's variables bound in a new scope, each its own type: what a clause or
/// the `return` clause starts from. An assignment may give them new values unless `barred`.
fn with_vars(
  checker: Checker,
  vars: List<{ name: Ident, ty: Type }>,
  barred: Option<Bytes>,
) -> Checker / {abort.raise} = {
  let pushed: Checker = { ..checker, env: env_push(checker.env) };
  let bound = vars.fold(
    { checker: pushed, stamps: [] },
    |acc: { checker: Checker, stamps: List<{ stamp: Int, name: Bytes, ty: Type }> }, v: { name: Ident, ty: Type }|
      {
        checker: { ..acc.checker, env: env_bind(acc.checker.env, v.name.name, monomorphic(v.ty)) },
        stamps: acc.stamps.push({ stamp: acc.checker.env.binds, name: v.name.name, ty: v.ty }),
      },
  );
  { ..bound.checker, assignable: { vars: bound.stamps, barred: barred } }
}

fn infer_handle(
  checker: Checker,
  span: Span,
  body: Expr,
  clauses: List<HandleClause>,
  ret: Option<ReturnClause>,
  vars: List<HandlerVar>,
  hint: Option<Hint>,
) -> Inferred / {abort.raise} = {
  // The variables are made where the `handle` stands, before its body runs, outside the handler.
  let made: MadeVars = made_vars(checker, vars);
  let around: Assignable = checker.assignable;
  let mark = made.checker.performs.len();
  // The `handle` answers what its `return` clause does, and without one what its body does.
  let b: Inferred = unbarred(
    made.checker,
    infer(barred(made.checker, b"the body of a `handle` inside the clause"), body, match ret {
      Some(_) -> None,
      None -> hint,
    }),
  );
  let spawned = { before: spawn_counts(made.checker), after: spawn_counts(b.checker) };
  let general = clauses.fold(false, |acc: Bool, c: HandleClause|
    acc || (match c.resume { Some(_) -> true, None -> false }));
  let escapes = clauses.fold(general, |acc: Bool, c: HandleClause|
    acc || answers_raise(checker, c));
  let cont: { checker: Checker, v: Option<Int> } = if general {
    let o: WithVar = new_row_var(b.checker);
    { checker: o.checker, v: Some(o.var) }
  } else { { checker: b.checker, v: None } };
  let result_var: { checker: Checker, t: Option<Type> } = if escapes {
    let o: WithTy = new_ty(cont.checker);
    { checker: o.checker, t: Some(o.ty) }
  } else { { checker: cont.checker, t: None } };
  let walked: HandleAcc = clauses.fold(
    {
      checker: result_var.checker,
      handled: [],
      selected: [],
      clause_rows: row_empty(),
      around: [],
    },
    |acc: HandleAcc, clause: HandleClause| {
      let r: WithHit = resolve_op(acc.checker, clause.eff, clause.op);
      match r.hit {
        None -> { ..acc, checker: r.checker },
        Some(hit) -> {
          let res: WithResource = clause_resource_for(
            r.checker,
            hit.info,
            hit.op,
            clause,
            clause.span,
          );
          match res.resource {
            None -> { ..acc, checker: res.checker },
            Some(resource_) -> {
              let shape: OpShape = instantiate_op_for_clause(res.checker, hit.op);
              if shape.params.len() != clause.params.len() {
                let bound = clause.params.len();
                {
                  ..acc,
                  checker: report_error_at_and(
                    shape.checker,
                    b"E0202",
                    clause.span,
                    Bytes::concat_all([
                      b"the clause for `",
                      hit.info.name,
                      b".",
                      hit.op.name,
                      b"` binds ",
                      ascii_of_int(bound),
                      b" parameter",
                      plural(bound),
                      b", but the operation takes ",
                      ascii_of_int(shape.params.len()),
                    ]),
                    Bytes::concat_all([
                      b"expected ",
                      ascii_of_int(shape.params.len()),
                      b" parameters",
                    ]),
                    hit.op.at,
                    b"declared here",
                    [],
                  ),
                }
              } else {
                let atom = {
                  effect: hit.info.name,
                  resource: resource_,
                  mode: hit.op.mode,
                  op: None,
                };
                let key = { effect: hit.info.name, op: hit.op.name, resource: resource_ };
                let dup = acc.selected.fold(false, |d: Bool, k: OpKey| d || k == key);
                let c0: Checker = if dup {
                  let res_text = match clause.resource {
                    Some(r) -> Bytes::concat_all([b"[", r.name, b"]"]),
                    None -> b"",
                  };
                  report(shape.checker, {
                    code: b"E0105",
                    notes: 1,
                    labels: [
                      label_at(
                        shape.checker.module,
                        clause.span,
                        true,
                        b"this clause is unreachable",
                      ),
                    ],
                    text: b"",
                    message: Bytes::concat_all([
                      b"`",
                      hit.info.name,
                      b".",
                      hit.op.name,
                      res_text,
                      b"` is handled more than once",
                    ]),
                    notes_text: [b"the first matching clause wins at run time"],
                    severity: b"warning",
                    fixes: [],
                  })
                } else { shape.checker };
                // What a clause's parameters hold is its operation's, filed where the clause is.
                // A clause's parameters bind after the handler's variables, so one of a variable's
                // name is the parameter.
                let pushed: Checker = with_vars(
                  note_typed(c0, clause.span, fn_type(shape.params, shape.ret, row_empty()), []),
                  made.vars,
                  None,
                );
                let bound: Checker = range(0, clause.params.len()).fold(
                  pushed,
                  |c: Checker, i: Int|
                    {
                      ..c,
                      env: env_bind(
                        c.env,
                        clause.params.get(i).name,
                        monomorphic(shape.params.get(i)),
                      ),
                    },
                );
                // The label the call site named, as the clause body's own `String`: a clause that
                // answers every label could not otherwise tell which one it answered.
                let with_label: Checker = match clause.label_binder {
                  Some(t) ->
                    { ..bound, env: env_bind(bound.env, t.name, monomorphic(string_type())) },
                  None -> bound,
                };
                let raise = is_raise(hit.op.mode);
                let raised = Bytes::concat_all([
                  b"`",
                  as_written(with_label, hit.info.name),
                  b".",
                  hit.op.name,
                  b"`",
                ]);
                let with_resume: Checker = match clause.resume {
                  Some(k) -> {
                    let result = match result_var.t {
                      Some(t) -> t,
                      None -> panic("a general clause is present"),
                    };
                    let row = match cont.v {
                      Some(v) -> v,
                      None -> panic("a general clause is present"),
                    };
                    let bound_k: Checker = {
                      ..with_label,
                      env: env_bind(
                        with_label.env,
                        k.name,
                        monomorphic(fn_type([shape.ret], result, row_open(row))),
                      ),
                    };
                    if !raise { bound_k } else {
                      report_error_at(
                        bound_k,
                        b"E0201",
                        k.span,
                        Bytes::concat_all([b"a clause for ", raised, b" cannot bind `resume`"]),
                        b"a raise does not come back to be resumed",
                        [b"drop `resume`: the clause's value is the `handle`'s"],
                      )
                    }
                  },
                  None -> with_label,
                };
                let whole = raise || (match clause.resume { Some(_) -> true, None -> false });
                let answer = if !whole { hint_of(shape.ret) }
                else { match ret { Some(_) -> hint, None -> hint_after(hint, b.ty) } };
                let body_: Inferred = infer(with_resume, clause.body, answer);
                let popped: Checker = {
                  ..body_.checker,
                  env: env_pop(body_.checker.env),
                  assignable: around,
                };
                let checked: Checker = match clause.resume {
                  Some(_) ->
                    expect(
                      popped,
                      expr_span(clause.body),
                      match result_var.t { Some(t) -> t, None -> shape.ret },
                      body_.ty,
                      b"a clause that binds a continuation returns the `handle`'s result",
                    ).checker,
                  None -> if raise {
                    expect(
                      popped,
                      expr_span(clause.body),
                      match result_var.t { Some(t) -> t, None -> shape.ret },
                      body_.ty,
                      Bytes::concat_all([
                        b"a clause for ",
                        raised,
                        b" answers for the whole `handle`",
                      ]),
                    ).checker
                  } else {
                    let x: Expected = expect(
                      popped,
                      expr_span(clause.body),
                      shape.ret,
                      body_.ty,
                      b"a handler clause returns the operation's result",
                    );
                    if !x.ok && op_free_vars(hit.op).len() > 0 {
                      note_universal_clause(x.checker, hit.info, hit.op)
                    } else { x.checker }
                  },
                };
                let j: WithRow = join(checked, span, acc.clause_rows, body_.row);
                {
                  checker: j.checker,
                  // No mode atom stands for a raise, so a clause for one leaves the effect's others be.
                  handled: if raise { acc.handled } else { atoms_insert(acc.handled, atom) },
                  selected: acc.selected.push(key),
                  clause_rows: j.row,
                  around: acc.around.push({
                    span: clause.span,
                    op: { ..atom, op: Some(hit.op.name) },
                    ty: fn_type(shape.params, shape.ret, body_.row),
                  }),
                }
              }
            },
          }
        },
      }
    },
  );
  let body_mark = b.checker.performs.len();
  let under: Checker = spawned_under(walked.checker, spawned.before, spawned.after, walked.around);
  let returned = match ret {
    Some(rc) -> {
      let pushed: Checker = with_vars(under, made.vars, Some(b"the `return` clause"));
      let bound: Checker = {
        ..pushed,
        env: env_bind(pushed.env, rc.binder.name, monomorphic(b.ty)),
      };
      let o: Inferred = infer(bound, rc.body, hint);
      {
        checker: { ..o.checker, env: env_pop(o.checker.env), assignable: around },
        ty: o.ty,
        row: o.row,
      }
    },
    None -> { checker: under, ty: b.ty, row: row_empty() },
  };
  let agreed: Checker = match result_var.t {
    Some(t) ->
      expect(
        returned.checker,
        span,
        t,
        returned.ty,
        b"every clause of a `handle` produces its result",
      ).checker,
    None -> returned.checker,
  };
  let body_row = resolve_row_in(agreed, b.row);
  let remaining = body_row.atoms.filter(|a: Atom|
    !clause_discharges(agreed, walked.handled, walked.selected, a));
  // An atom the clauses leave under a handled mode atom runs past this `handle`: refused unless the
  // enclosing definition's written row forwards it to the caller's handler.
  let missing = remaining.filter(|a: Atom|
    atoms_covered(walked.handled, a) && !atoms_covered(agreed.declared_atoms, a));
  let sites = resolved_sites(agreed.subst, agreed.performs.drop(mark).take(body_mark - mark));
  let after = clauses.fold(span.start, |acc: Int, cl: HandleClause|
    max(acc, expr_span(cl.body).end));
  let judged: Checker = if missing.len() == 0 { agreed }
  else { incomplete(agreed, span, after, sites, walked.handled, walked.selected, missing) };
  // A refused atom leaves the row with its report, so the signature is not told about it twice.
  let kept = atoms_difference(remaining, missing);
  let discharged: Checker = discharge(
    judged,
    mark,
    body_mark,
    atoms_difference(body_row.atoms, kept),
  );
  let j1: WithRow = join(
    discharged,
    span,
    { atoms: kept, tail: body_row.tail },
    walked.clause_rows,
  );
  let j2: WithRow = join(j1.checker, span, j1.row, returned.row);
  let solved = match cont.v {
    Some(v) -> { ..j2.checker, subst: solve_continuation_row(j2.checker.subst, v, j2.row) },
    None -> j2.checker,
  };
  // What making the variables performs is the `handle`'s, outside its own clauses' reach.
  let j3: WithRow = join(solved, span, j2.row, made.row);
  { checker: j3.checker, ty: returned.ty, row: j3.row }
}

/// The raise a `try` names.
fn named_raise(checker: Checker, name: RaiseName) -> WithHit / {abort.raise} = {
  let r: WithHit = resolve_op(checker, name.eff, name.op);
  match r.hit {
    None -> r,
    Some(hit) -> if is_raise(hit.op.mode) { r } else {
      {
        checker: report_error_at_and(
          r.checker,
          b"E0313",
          span_to(name.eff.span, name.op.span),
          Bytes::concat_all([
            b"`",
            qname_text(name.eff),
            b".",
            name.op.name,
            b"` is not a `raise` operation",
          ]),
          b"a `try` answers a raise",
          hit.op.at,
          Bytes::concat_all([b"declared `", mode_text(hit.op.mode), b"` here"]),
          [
            b"a `read` or `write` operation comes back to where it was performed, so there is nothing for a `try` to turn into an `Err`: answer it with a `handle` clause",
          ],
        ),
        hit: None,
      }
    },
  }
}

/// The one raise a body's row names, `abort.raise` aside: what can fail on a value raises that, so a
/// `try` answers it only by name.
fn one_raise(checker: Checker, span: Span, row: Row) -> WithHit / {abort.raise} = {
  let raises = row.atoms.filter(|a: Atom| is_raise(a.mode) && a != abort_atom());
  let found = |a: Atom|
    match effect_of(checker, a.effect) {
      None -> None,
      Some(info) -> match a.op {
        None -> None,
        Some(op) -> match op_named(info, op) {
          Some(o) -> Some({ info: info, op: o }),
          None -> None,
        },
      },
    };
  match raises {
    [one] -> { checker: checker, hit: found(one) },
    [] -> {
      let aborts = row.atoms.contains(abort_atom());
      let notes = List::concat(
        if aborts {
          [
            b"what can fail on a value raises `abort.raise`, so a `try` answers it only by name: `try[abort.raise] { .. }`",
          ]
        } else { [] },
        match row.tail {
          Some(_) ->
            [
              b"what a row variable carries is named by the caller, not here, so it passes through: name the operation, `try[effect.op] { .. }`",
            ],
          None -> [],
        },
      );
      {
        checker: report_error_at(
          checker,
          b"E0311",
          span,
          b"this `try` has no raise to answer",
          b"its body names no `raise` operation",
          if notes.len() == 0 { [b"drop the `try`, or raise in its body"] } else { notes },
        ),
        hit: None,
      }
    },
    _ -> {
      let names = raises.map(|a: Atom| backticked_text(atom_written(checker, a)));
      let d = error_with_labels(
        b"E0312",
        Bytes::concat_all([
          b"this `try` could answer ",
          Bytes::join(names.take(names.len() - 1), b", "),
          b" or ",
          names.get(names.len() - 1),
        ]),
        [
          label_at(
            checker.module,
            span,
            true,
            Bytes::concat_all([
              b"its body names ",
              ascii_of_int(raises.len()),
              b" `raise` operations",
            ]),
          ),
        ],
        [b"name the one to answer, `try[effect.op] { .. }`; the others pass through"],
      );
      let fixed = raises.fold(d, |acc: Diag, a: Atom|
        match written_as(checker, a.effect) {
          None -> acc,
          Some(_) -> {
            let written = atom_written(checker, a);
            with_fix(acc, b"answer ".concat(backticked_text(written)), [
              insertion(checker.module, span.start + 3, Bytes::concat_all([b"[", written, b"]"])),
            ])
          },
        });
      { checker: report(checker, fixed), hit: None }
    },
  }
}

fn carried_type(params: List<Type>) -> Type / {abort.raise} =
  match params {
    [] -> unit_type(),
    [one] -> one,
    _ ->
      TyRecord(
        fields_sorted(
          range(0, params.len()).map(|i: Int|
            { name: b"_".concat(ascii_of_int(i)), ty: params.get(i) }),
        ),
      ),
  }

/// `try { body }` is the `handle` whose clause for one raise answers `Err` of what it carried and
/// whose `return` answers `Ok`: the body's row loses that raise and keeps the rest.
fn infer_try_block(
  checker: Checker,
  span: Span,
  raise: Option<RaiseName>,
  body: Expr,
  hint: Option<Hint>,
) -> Inferred / {abort.raise} = {
  let mark = checker.performs.len();
  // Where a `Result` is expected of the `try`, its body is expected to be what the `Ok` holds.
  let answer = match hinted(checker, hint) {
    Some(TyCon(c)) -> match c.args {
      [ok, _] -> if c.name == b"Result" { Some({ ty: ok, met: met_of(hint) }) } else { None },
      _ -> None,
    },
    _ -> None,
  };
  let b: Inferred = infer(checker, body, answer);
  let body_mark = b.checker.performs.len();
  let body_row = resolve_row_in(b.checker, b.row);
  let chosen: WithHit = match raise {
    Some(name) -> named_raise(b.checker, name),
    None -> one_raise(b.checker, span, body_row),
  };
  match chosen.hit {
    // A `try` that could not say which raise it answers takes each it might have, so the refusal
    // is the one report.
    None -> {
      let o: WithTy = new_ty(chosen.checker);
      let might = match raise {
        Some(_) -> [],
        None -> body_row.atoms.filter(|a: Atom| is_raise(a.mode) && a != abort_atom()),
      };
      {
        checker: discharge(o.checker, mark, body_mark, might),
        ty: TyCon({ name: b"Result", args: [b.ty, o.ty] }),
        row: { atoms: atoms_difference(body_row.atoms, might), tail: body_row.tail },
      }
    },
    Some(hit) -> {
      let atom = {
        effect: hit.info.name,
        resource: RSingleton,
        mode: hit.op.mode,
        op: Some(hit.op.name),
      };
      let c: Checker = chosen.checker;
      let filed: Checker = {
        ..c,
        try_sites: c.try_sites.push({
          module: c.module,
          span: span,
          effect: hit.info.name,
          op: hit.op.name,
          arity: hit.op.params.len(),
          owner: c.walking,
        }),
      };
      {
        checker: discharge(filed, mark, body_mark, [atom]),
        ty: TyCon({ name: b"Result", args: [b.ty, carried_type(hit.op.params)] }),
        row: { atoms: body_row.atoms.filter(|a: Atom| a != atom), tail: body_row.tail },
      }
    },
  }
}

fn reach_label(checker: Checker, site: PerformSite) -> Bytes / {abort.raise} = {
  let a = backticked_text(atom_written(checker, site.atom));
  match site.source {
    DirectPerform -> b"performs ".concat(a),
    PerformVia(name) ->
      Bytes::concat_all([b"reaches ", a, b" through ", backticked_text(simple_name_of(name))]),
    OpaquePerform -> Bytes::concat_all([b"reaches ", a, b" through a function value"]),
    PerformThroughArgs -> b"reaches ".concat(a),
  }
}

/// `E0305`: the operations named, and for a mode atom the operations it stands for, each with the clause to add.
fn incomplete(
  checker: Checker,
  span: Span,
  after: Int,
  sites: List<PerformSite>,
  handled: List<Atom>,
  keys: List<OpKey>,
  missing: List<Atom>,
) -> Checker / {abort.raise} = {
  let names = missing.map(|a: Atom| backticked_text(atom_written(checker, a)));
  let listed = if names.len() == 1 { names.get(0) } else {
    Bytes::concat_all([
      Bytes::join(names.take(names.len() - 1), b", "),
      b" and ",
      names.get(names.len() - 1),
    ])
  };
  let labels = missing.fold([], |acc: List<Label>, a: Atom|
    match site_among(sites, a) {
      Some(s) -> acc.push(label_at(s.module, s.span, true, reach_label(checker, s))),
      None -> acc,
    });
  let notes = missing.fold([], |acc: List<Bytes>, a: Atom|
    match a.op {
      Some(_) -> acc,
      None -> {
        let through = match site_among(sites, a) {
          Some(s) -> match s.source {
            PerformVia(name) -> backticked_text(simple_name_of(name)),
            OpaquePerform -> b"a function value",
            _ -> b"the body",
          },
          None -> b"the body",
        };
        acc.push(
          Bytes::concat_all([
            through,
            b" may perform any `",
            mode_text(a.mode),
            b"` operation of `",
            as_written(checker, a.effect),
            b"`; a clause for each of them discharges ",
            backticked_text(atom_written(checker, a)),
          ]),
        )
      },
    });
  let handled_text = Bytes::join(handled.map(|a: Atom| backticked_text(atom_text(a))), b", ");
  let d = error_with_labels(
    b"E0305",
    Bytes::concat_all([b"this `handle` has no clause for ", listed, b", which its body performs"]),
    labels.push(
      label_at(
        checker.module,
        span,
        false,
        Bytes::concat_all([
          b"handles ",
          handled_text,
          b" here, so the operation would run past it",
        ]),
      ),
    ),
    notes,
  );
  let wanted = missing.fold([], |acc: List<Atom>, a: Atom|
    match a.op {
      Some(_) -> acc.push(a),
      None -> acc.concat(mode_ops(checker, a).filter(|o: Atom| !key_named(keys, o))),
    });
  let fixed = wanted.fold(d, |acc: Diag, a: Atom|
    with_fix(
      acc,
      Bytes::concat_all([b"add a clause for ", backticked_text(atom_written(checker, a))]),
      [insertion(checker.module, after, b", ".concat(clause_for(checker, a)))],
    ));
  report(checker, fixed)
}

/// A clause for the operation that checks as it is and raises where the operation was skipped before.
fn clause_for(checker: Checker, atom: Atom) -> Bytes / {abort.raise} = {
  let written = atom_written(checker, atom);
  let params = match effect_of(checker, atom.effect) {
    Some(info) -> match atom.op {
      Some(op) -> match op_named(info, op) { Some(o) -> o.params.len(), None -> 0 },
      None -> 0,
    },
    None -> 0,
  };
  Bytes::concat_all([
    written,
    b"(",
    Bytes::join(range(0, params).map(|i: Int| b"a".concat(ascii_of_int(i))), b", "),
    b") -> panic(\"",
    written,
    b" is not handled here\")",
  ])
}

fn simple_name_of(name: Bytes) -> Bytes / {abort.raise} =
  match range(0, name.len()).fold(None, |acc: Option<Int>, i: Int|
      if name.at(i) == 46 { Some(i) } else { acc }) {
    Some(i) -> name.slice(i + 1, name.len()),
    None -> name,
  }

/// The mismatch just reported gains a secondary at the declaration and three notes.
fn note_universal_clause(
  checker: Checker,
  info: EffectInfo,
  op_info: OpInfo,
) -> Checker / {abort.raise} = {
  let n = checker.diags.len();
  if n == 0 { checker } else {
    let last: Diag = checker.diags.get(n - 1);
    let notes = [
      Bytes::concat_all([
        b"`",
        as_written(checker, info.name),
        b".",
        op_info.name,
        b"` is declared with a type variable, so a clause for it has to answer every type a perform site could ask for",
      ]),
      b"a row carries atoms and no types, so the `handle` cannot see which type a perform site picked \xe2\x80\x94 answering a concrete one would be a value of a type the caller never asked for",
      b"declare the operation at the type it actually answers, or produce the result from one of the clause's own parameters",
    ];
    {
      ..checker,
      diags: checker.diags.set(n - 1, {
        code: last.code,
        notes: last.notes + 3,
        labels: last.labels.push(
          label_at(op_info.at.module, op_info.at.span, false, b"declared here"),
        ),
        text: last.text,
        message: last.message,
        notes_text: last.notes_text.concat(notes),
        severity: last.severity,
        fixes: last.fixes,
      }),
    }
  }
}

fn cell_atoms(resource: Bytes) -> List<Atom> =
  [
    { effect: cell(), resource: RNamed(resource), mode: MRead, op: None },
    { effect: cell(), resource: RNamed(resource), mode: MWrite, op: None },
  ]

fn region_is_open(checker: Checker, name: Bytes) -> Bool =
  checker.open_regions.fold(false, |acc: Bool, region: OpenRegion| acc || region.name == name)

/// The open region of this name, when there is one.
fn open_region_named(checker: Checker, name: Bytes) -> Option<OpenRegion> =
  checker.open_regions.fold(None, |acc: Option<OpenRegion>, region: OpenRegion|
    if region.name == name { Some(region) } else { acc })

/// A hold is let go at its own region's `}`, so that region is the one that brands it: a region
/// of the name already open would brand it instead, and let it outlive its release.
fn region_reopened(checker: Checker, resource: Ident, outer: OpenRegion, form: Bytes) -> Checker =
  err_labels(
    checker,
    b"E0330",
    Bytes::concat_all([
      b"`",
      form,
      b"[",
      resource.name,
      b"]` opens a region named `",
      resource.name,
      b"` inside one of that name",
    ]),
    [
      label_at(checker.module, resource.span, true, b"this name is already a region's"),
      label_at(
        checker.module,
        outer.span,
        false,
        Bytes::concat_all([b"`", resource.name, b"` opens here and is still open"]),
      ),
    ],
    [
      b"a hold is let go at the `}` of the `with_hold` that made it, so the region that brands it has to be that one and no other",
      b"give this region a name no region around it has",
    ],
  )

/// The label a region's cells and atoms carry: its written name beside the definition that opens it.
/// No source can write it, so no other definition's row or region names this one's.
fn region_label(checker: Checker, name: Bytes) -> Bytes =
  Bytes::concat_all([name, region_mark(), checker.walking])

/// What `name` stands for where an atom of the effect `eff` or a hold's type writes it: an open
/// region's own label for its cells and holds, and for any other effect the resource of that name.
fn region_named(checker: Checker, eff: Bytes, name: Bytes) -> Bytes =
  if !is_region_effect(eff) { name }
  else { match open_region_named(checker, name) { Some(region) -> region.label, None -> name } }

fn open_region(checker: Checker, name: Bytes, label: Bytes, span: Span, hold: Bool) -> Checker =
  {
    ..checker,
    open_regions: checker.open_regions.push({
      name: name,
      label: label,
      span: span,
      hold: hold,
      simulate_depth: checker.simulate_depth,
      spawns: [],
      handoffs: [],
    }),
  }

type ClosedRegion = { checker: Checker, spawns: List<SpawnSite>, handoffs: List<HandoffSite> }

fn close_region(checker: Checker) -> ClosedRegion / {abort.raise} = {
  let n = checker.open_regions.len();
  let last = checker.open_regions.get(n - 1);
  {
    checker: { ..checker, open_regions: checker.open_regions.take(n - 1) },
    spawns: last.spawns,
    handoffs: last.handoffs,
  }
}

fn sites_of(args: List<Expr>, tys: List<Type>) -> List<SpawnSite> / {abort.raise} =
  range(0, args.len()).map(|i: Int| { span: expr_span(args.get(i)), ty: tys.get(i), around: [] })

/// The spawns each open region filed while a `handle`'s body ran perform against its clauses.
fn spawned_under(
  checker: Checker,
  before: List<Int>,
  after: List<Int>,
  clauses: List<ClauseSite>,
) -> Checker / {abort.raise} =
  if clauses.len() == 0 || before == after { checker } else {
    {
      ..checker,
      open_regions: range(0, checker.open_regions.len()).map(|i: Int| {
        let r = checker.open_regions.get(i);
        {
          ..r,
          spawns: range(0, r.spawns.len()).map(|j: Int| {
            let s = r.spawns.get(j);
            if j >= before.get(i) && j < after.get(i) { { ..s, around: s.around.concat(clauses) } }
            else { s }
          }),
        }
      }),
    }
  }

/// A `task.spawn` argument is filed against every open region with no `simulate` of its own between
/// the open and the spawn: that scheduler outlives the region, so its task can run past the close.
fn note_spawn(
  checker: Checker,
  info: EffectInfo,
  op_info: OpInfo,
  args: List<Expr>,
  tys: List<Type>,
) -> Checker / {abort.raise} =
  if info.name != b"task" || op_info.name != b"spawn" { checker } else {
    {
      ..checker,
      open_regions: checker.open_regions.map(|region: OpenRegion|
        if region.simulate_depth < checker.simulate_depth { region }
        else { { ..region, spawns: region.spawns.concat(sites_of(args, tys)) } }),
    }
  }

/// Every argument of a user-declared operation, against every open region: its handler can be installed anywhere.
fn note_handoff(
  checker: Checker,
  info: EffectInfo,
  op_info: OpInfo,
  args: List<Expr>,
  tys: List<Type>,
) -> Checker / {abort.raise} =
  if info.name == b"task" || checker.open_regions.len() == 0 { checker } else {
    let name = Bytes::concat_all([info.simple_name, b".", op_info.name]);
    let sites = range(0, args.len()).map(|i: Int|
      { span: expr_span(args.get(i)), ty: tys.get(i), op: name });
    {
      ..checker,
      open_regions: checker.open_regions.map(|region: OpenRegion|
        { ..region, handoffs: region.handoffs.concat(sites) }),
    }
  }

/// What is in scope when a region opens, paired with where its body first names each.
fn outer_bindings(checker: Checker, body: Expr) -> List<OuterBinding> / {abort.raise} = {
  let kept = env_locals(checker.env).fold(
    [],
    |acc: List<{ name: Bytes, ty: Type }>, l: { name: Bytes, sc: Scheme }| {
      let fv = free_vars(checker.subst, l.sc.ty, { tys: [], rows: [] });
      let tys = ints_difference(fv.tys, l.sc.ty_vars);
      let rows = ints_difference(fv.rows, l.sc.row_vars);
      if tys.len() > 0 || rows.len() > 0 { acc.push({ name: l.name, ty: l.sc.ty }) } else { acc }
    },
  );
  if kept.len() == 0 { [] } else {
    let refs = refs_of(body, []);
    let first = refs.names.fold([], |acc: List<{ name: Bytes, span: Span }>, qname: QName|
      if !is_bare(qname)
          || acc.fold(false, |b: Bool, x: { name: Bytes, span: Span }|
            b || x.name == qname.name.name) { acc }
      else { acc.push({ name: qname.name.name, span: qname.span }) });
    kept.fold([], |acc: List<OuterBinding>, k: { name: Bytes, ty: Type }|
      match first.fold(None, |span: Option<Span>, x: { name: Bytes, span: Span }|
          match span {
            Some(_) -> span,
            None -> if x.name == k.name { Some(x.span) } else { None },
          }) {
        Some(site) -> acc.push({ name: k.name, ty: k.ty, site: site }),
        None -> acc,
      })
  }
}

fn region_exits(expr: Expr, out: List<Span>) -> List<Span> =
  match expr {
    EBlock(b) -> match b.tail { Some(t) -> region_exits(t, out), None -> out },
    EIf(i) -> region_exits(i.else_branch, region_exits(i.then_branch, out)),
    EMatch(m) -> m.arms.fold(out, |acc: List<Span>, arm: MatchArm| region_exits(arm.body, acc)),
    EWithCell(c) -> region_exits(c.body, out),
    EWithHold(c) -> region_exits(c.body, out),
    ESimulate(s) -> region_exits(s.body, out),
    EHandle(h) -> {
      let through = match h.ret {
        Some(rc) -> region_exits(rc.body, out),
        None -> region_exits(h.body, out),
      };
      h.clauses.fold(through, |acc: List<Span>, c: HandleClause|
        match c.resume { Some(_) -> region_exits(c.body, acc), None -> acc })
    },
    _ -> out.push(expr_span(expr)),
  }

fn infer_with_cell(
  checker: Checker,
  span: Span,
  resource: Ident,
  init: Expr,
  binder: Ident,
  body: Expr,
  hint: Option<Hint>,
) -> Inferred / {abort.raise} = {
  let i: Inferred = infer(checker, init);
  let label = match open_region_named(i.checker, resource.name) {
    Some(around) -> around.label,
    None -> region_label(i.checker, resource.name),
  };
  let cell_ty = TyCon({ name: b"Cell", args: [label_type(label), i.ty] });
  if region_is_open(i.checker, resource.name) {
    let nested: Checker = match open_region_named(i.checker, resource.name) {
      Some(outer) -> if outer.hold { region_reopened(i.checker, resource, outer, b"with_cell") }
      else { i.checker },
      None -> i.checker,
    };
    let pushed: Checker = {
      ..nested,
      env: env_bind(env_push(nested.env), binder.name, monomorphic(cell_ty)),
    };
    let b: Inferred = infer(pushed, body, hint);
    let j: WithRow = join({ ..b.checker, env: env_pop(b.checker.env) }, span, i.row, b.row);
    { checker: j.checker, ty: b.ty, row: j.row }
  } else {
    let outer = outer_bindings(i.checker, body);
    let opened: Checker = open_region(i.checker, resource.name, label, resource.span, false);
    let mark = opened.performs.len();
    let pushed: Checker = {
      ..opened,
      env: env_bind(env_push(opened.env), binder.name, monomorphic(cell_ty)),
    };
    let b: Inferred = infer(pushed, body, hint);
    let closed: ClosedRegion = close_region({ ..b.checker, env: env_pop(b.checker.env) });
    let handled = cell_atoms(label);
    let discharged: Checker = discharge(
      closed.checker,
      mark,
      closed.checker.performs.len(),
      handled,
    );
    let site: RegionSite = {
      module: discharged.module,
      name: resource.name,
      label: label,
      span: resource.span,
      hold: false,
      body_span: expr_span(body),
      body_ty: b.ty,
      exits: region_exits(body, []),
      outer: outer,
      spawns: closed.spawns,
      handoffs: closed.handoffs,
    };
    let recorded: Checker = { ..discharged, regions: discharged.regions.push(site) };
    let j: WithRow = join(recorded, span, i.row, row_without(b.row, handled));
    { checker: j.checker, ty: leaving_type(resolve(j.checker, b.ty), label), row: j.row }
  }
}

/// `release` is read as a value: a function of what `acquire` answered, whose row the form performs
/// when it lets the hold go. The body's reads of a hold end at the region's `}`.
fn infer_with_hold(
  checker: Checker,
  span: Span,
  resource: Ident,
  acquire: Expr,
  release: Expr,
  binder: Ident,
  body: Expr,
  hint: Option<Hint>,
) -> Inferred / {abort.raise} = {
  let a: Inferred = infer(checker, acquire);
  let r: Inferred = infer(a.checker, release);
  let eff: WithRow = new_row(r.checker);
  let typed: Checker = expect(
    eff.checker,
    expr_span(release),
    fn_type([a.ty], unit_type(), eff.row),
    r.ty,
    b"function that releases what the hold acquired",
  ).checker;
  let let_go = resolve_row_in(typed, eff.row);
  let source = callee_source(typed, release);
  let performed: Checker = let_go.atoms.fold(typed, |c: Checker, atom: Atom|
    record_site(c, atom, expr_span(release), source));
  let before: WithRow = join(performed, span, a.row, r.row);
  let entering: WithRow = join(before.checker, span, before.row, let_go);
  let label = region_label(entering.checker, resource.name);
  let hold_ty = TyCon({ name: b"Hold", args: [label_type(label), a.ty] });
  match open_region_named(entering.checker, resource.name) {
    Some(around) -> {
      let refused: Checker = region_reopened(entering.checker, resource, around, b"with_hold");
      let b: Inferred = infer(
        { ..refused, env: env_bind(env_push(refused.env), binder.name, monomorphic(hold_ty)) },
        body,
        hint,
      );
      let j: WithRow = join(
        { ..b.checker, env: env_pop(b.checker.env) },
        span,
        entering.row,
        b.row,
      );
      { checker: j.checker, ty: b.ty, row: j.row }
    },
    None -> {
      let outer = outer_bindings(entering.checker, body);
      let opened: Checker = open_region(
        entering.checker,
        resource.name,
        label,
        resource.span,
        true,
      );
      let mark = opened.performs.len();
      let b: Inferred = infer(
        { ..opened, env: env_bind(env_push(opened.env), binder.name, monomorphic(hold_ty)) },
        body,
        hint,
      );
      let closed: ClosedRegion = close_region({ ..b.checker, env: env_pop(b.checker.env) });
      let handled = [hold_atom(RNamed(label))];
      let discharged: Checker = discharge(
        closed.checker,
        mark,
        closed.checker.performs.len(),
        handled,
      );
      let site: RegionSite = {
        module: discharged.module,
        name: resource.name,
        label: label,
        span: resource.span,
        hold: true,
        body_span: expr_span(body),
        body_ty: b.ty,
        exits: region_exits(body, []),
        outer: outer,
        spawns: closed.spawns,
        handoffs: closed.handoffs,
      };
      let recorded: Checker = { ..discharged, regions: discharged.regions.push(site) };
      let j: WithRow = join(
        recorded,
        span,
        entering.row,
        row_without_covered(resolve_row_in(recorded, b.row), handled),
      );
      { checker: j.checker, ty: leaving_type(resolve(j.checker, b.ty), label), row: j.row }
    },
  }
}

fn holds_cell(t: Type) -> Bool =
  match t {
    TyCon(c) -> c.name == b"Cell" || c.args.fold(false, |b: Bool, a: Type| b || holds_cell(a)),
    TyRecord(fs) -> fs.fold(false, |b: Bool, field: Field| b || holds_cell(field.ty)),
    TyNominal(n) -> n.fields.fold(false, |b: Bool, field: Field| b || holds_cell(field.ty)),
    TyFn(_) -> false,
    TyVar(_) -> false,
  }

/// Every perform site of `mode` on a cell of a region in `older`, the direct and the called alike.
fn older_cells(
  checker: Checker,
  sites: List<PerformSite>,
  older: List<Opened>,
  mode: Mode,
) -> List<CellAccess> / {abort.raise} =
  sites.fold([], |acc: List<CellAccess>, site: PerformSite| {
    let a = resolve_atom(checker.subst, site.atom);
    match a.resource {
      RNamed(r) -> if a.effect == cell() && mode_eq(a.mode, mode)
          && older.fold(false, |b: Bool, opened: Opened| b || opened.label == r) {
        acc.push({ span: site.span, region: r })
      } else { acc },
      _ -> acc,
    }
  })

/// By the types at the open: a binding whose type mentions a task only inside the region holds none.
fn task_carriers(checker: Checker) -> List<{ name: Bytes, ty: Type }> / {abort.raise} =
  env_locals(checker.env).fold(
    [],
    |acc: List<{ name: Bytes, ty: Type }>, l: { name: Bytes, sc: Scheme }|
      match env_lookup(checker.env, l.name) {
        Some(sc) -> {
          let ty = resolve(checker, sc.ty);
          if holds_task(ty)
              && !acc.fold(false, |b: Bool, x: { name: Bytes, ty: Type }| b || x.name == l.name) {
            acc.push({ name: l.name, ty: ty })
          } else { acc }
        },
        None -> acc,
      },
  )

/// A name the body takes from outside is the innermost binding of it, the one the open saw.
fn carried_in(
  xs: List<Crossing>,
  carriers: List<{ name: Bytes, ty: Type }>,
) -> List<{ name: Bytes, span: Span, ty: Type }> =
  xs.fold([], |acc: List<{ name: Bytes, span: Span, ty: Type }>, x: Crossing|
    if acc.fold(false, |b: Bool, y: { name: Bytes, span: Span, ty: Type }| b || y.name == x.name) {
      acc
    } else {
      match carriers.fold(None, |found: Option<Type>, k: { name: Bytes, ty: Type }|
          match found {
            Some(_) -> found,
            None -> if k.name == x.name { Some(k.ty) } else { None },
          }) {
        Some(ty) -> acc.push({ name: x.name, span: x.span, ty: ty }),
        None -> acc,
      }
    })

fn infer_simulate(
  checker: Checker,
  span: Span,
  body: Expr,
  hint: Option<Hint>,
) -> Inferred / {abort.raise} = {
  let mark = checker.performs.len();
  let crossed_at = checker.crossings.len();
  let older = checker.open_regions.map(|region: OpenRegion|
    { name: region.name, label: region.label, span: region.span });
  let cells = env_locals(checker.env).map(|l: { name: Bytes, sc: Scheme }|
    { name: l.name, ty: l.sc.ty }).filter(|l: { name: Bytes, ty: Type }|
    holds_cell(resolve(checker, l.ty)));
  let carriers = task_carriers(checker);
  let b: Inferred = infer(
    { ..checker, simulate_depth: checker.simulate_depth + 1, sim_scope: checker.env.scopes.len() },
    body,
    hint,
  );
  let c: Checker = {
    ..b.checker,
    simulate_depth: b.checker.simulate_depth - 1,
    sim_scope: checker.sim_scope,
    crossings: b.checker.crossings.take(crossed_at),
  };
  let handled = simulated_atoms();
  let discharged: Checker = discharge(c, mark, c.performs.len(), handled);
  let inside = discharged.performs.drop(mark);
  let noted: Checker = {
    ..discharged,
    simulations: discharged.simulations.push({
      module: discharged.module,
      span: span,
      body_span: expr_span(body),
      body_ty: b.ty,
      body_row: b.row,
      exits: region_exits(body, []),
      older: older,
      cells: cells,
      writes: older_cells(discharged, inside, older, MWrite),
      reads: older_cells(discharged, inside, older, MRead),
      entering: carried_in(b.checker.crossings.drop(crossed_at), carriers),
    }),
  };
  let seed = seed_atom();
  let recorded: Checker = record_site(noted, seed, span, DirectPerform);
  let j: WithRow = join(
    recorded,
    span,
    row_without_covered(resolve_row_in(recorded, b.row), handled),
    row_singleton(seed),
  );
  { checker: j.checker, ty: b.ty, row: j.row }
}

// --- Definitions ----------------------------------------------------------------------------------

type Refs = { names: List<QName> }

/// Every name a body reads that no binder inside it shadows: a parameter or a `let` named like a
/// top-level definition reads the binder, not the definition.
fn refs_of(expr: Expr, bound: List<Bytes>) -> Refs = collect_refs(expr, bound, { names: [] })

fn param_names(params: List<Param>) -> List<Bytes> = params.map(|param: Param| param.name.name)

fn collect_refs(e: Expr, bound: List<Bytes>, out: Refs) -> Refs =
  match e {
    ELit(_) -> out,
    ETagged(t) ->
      t.holes.fold(
        {
          names: if t.holes.len() == 0 { out.names.push(tagged_parser(t)) }
          else { out.names.push(tagged_parser(t)).push(tagged_filler(t)) },
        },
        |acc: Refs, h: Hole| collect_refs(h.value, bound, acc),
      ),
    EBad(_) -> out,
    EVar(v) -> if is_bare(v.name) && bound.contains(v.name.name.name) { out }
    else { { names: out.names.push(v.name) } },
    EBinary(b) -> collect_refs(b.rhs, bound, collect_refs(b.lhs, bound, out)),
    EUnary(u) -> collect_refs(u.operand, bound, out),
    ELambda(l) -> collect_refs(l.body, bound.concat(param_names(l.params)), out),
    EApp(a) ->
      a.args.fold(collect_refs(a.func, bound, out), |acc: Refs, x: Expr|
        collect_refs(x, bound, acc)),
    EIf(i) ->
      collect_refs(
        i.else_branch,
        bound,
        collect_refs(i.then_branch, bound, collect_refs(i.cond, bound, out)),
      ),
    EMatch(m) ->
      m.arms.fold(collect_refs(m.scrutinee, bound, out), |acc: Refs, arm: MatchArm| {
        let inner = pattern_binders(arm.pat, bound);
        collect_refs(arm.body, inner, match arm.guard {
          Some(g) -> collect_refs(g, inner, acc),
          None -> acc,
        })
      }),
    EBlock(b) -> {
      let ss = b.stmts.fold(
        { bound: bound, out: out },
        |acc: { bound: List<Bytes>, out: Refs }, s: Stmt|
          match s {
            SExpr(x) -> { ..acc, out: collect_refs(x, acc.bound, acc.out) },
            SAssign(x) -> { ..acc, out: collect_refs(x.value, acc.bound, acc.out) },
            SLet(l) ->
              {
                bound: pattern_binders(l.pat, acc.bound),
                out: collect_refs(l.value, acc.bound, acc.out),
              },
            SLetElse(l) ->
              {
                bound: pattern_binders(l.pat, acc.bound),
                out: collect_refs(l.fallback, acc.bound, collect_refs(l.value, acc.bound, acc.out)),
              },
          },
      );
      match b.tail { Some(t) -> collect_refs(t, ss.bound, ss.out), None -> ss.out }
    },
    ERecord(r) -> r.fields.fold(out, |acc: Refs, f: RecField| collect_refs(f.value, bound, acc)),
    ERecordUpdate(r) ->
      r.fields.fold(collect_refs(r.base, bound, out), |acc: Refs, f: RecField|
        collect_refs(f.value, bound, acc)),
    EField(f) -> collect_refs(f.base, bound, out),
    ETry(t) -> collect_refs(t.operand, bound, out),
    EList(l) -> l.items.fold(out, |acc: Refs, x: Expr| collect_refs(x, bound, acc)),
    EPerform(p) -> p.args.fold(out, |acc: Refs, x: Expr| collect_refs(x, bound, acc)),
    EHandle(h) -> {
      // Each initializer sees the variables above it.
      let inits = h.vars.fold(
        { refs: out, bound: bound },
        |acc: { refs: Refs, bound: List<Bytes> }, v: HandlerVar|
          { refs: collect_refs(v.init, acc.bound, acc.refs), bound: acc.bound.push(v.name.name) },
      );
      let b = collect_refs(h.body, bound, inits.refs);
      let held = bound.concat(h.vars.map(|v: HandlerVar| v.name.name));
      let cs = h.clauses.fold(b, |acc: Refs, c: HandleClause| {
        let named = held.concat(c.params.map(|i: Ident| i.name));
        let labelled = match c.label_binder { Some(t) -> named.push(t.name), None -> named };
        let inner = match c.resume { Some(k) -> labelled.push(k.name), None -> labelled };
        collect_refs(c.body, inner, acc)
      });
      match h.ret { Some(rc) -> collect_refs(rc.body, held.push(rc.binder.name), cs), None -> cs }
    },
    EWithCell(c) ->
      collect_refs(c.body, bound.push(c.binder.name), collect_refs(c.init, bound, out)),
    EWithHold(c) ->
      collect_refs(
        c.body,
        bound.push(c.binder.name),
        collect_refs(c.release, bound, collect_refs(c.acquire, bound, out)),
      ),
    ESimulate(s) -> collect_refs(s.body, bound, out),
    EParallel(v) -> v.branches.fold(out, |acc: Refs, x: Expr| collect_refs(x, bound, acc)),
    ETryBlock(t) -> collect_refs(t.body, bound, out),
  }

/// A module's functions as their signatures bind them, for the walk of its bodies.
type SignedModule = {
  fns: List<FnDef>,
  names: List<Bytes>,
  sigs: List<Signature>,
  members: List<GroupDef>,
}

/// The module's functions bound by what they declare. Every module's are, before any body of
/// the program is walked: a body calls a function of a type in whichever module declares it,
/// which its own need not import.
fn signed_fns(
  checker: Checker,
  parsed: ParsedModule,
) -> { checker: Checker, signed: SignedModule } / {abort.raise} = {
  let collected = parsed.module.items.fold(
    { checker: refuse_externs(checker, parsed), fns: [], names: [] },
    |acc: { checker: Checker, fns: List<FnDef>, names: List<Bytes> }, item: Item|
      match item {
        IFn(def) -> if acc.names.contains(def.name.name) {
          let prev = acc.fns.fold(dummy_span(), |span: Span, f: FnDef|
            if f.name.name == def.name.name { f.name.span } else { span });
          {
            ..acc,
            checker: duplicate(
              acc.checker,
              def.name,
              { module: acc.checker.module, span: prev },
              b"function",
            ),
          }
        } else if is_cell_builtin(def.name.name) {
          {
            ..acc,
            checker: report_error_at(
              acc.checker,
              b"E0105",
              def.name.span,
              Bytes::concat_all([b"`", def.name.name, b"` is a builtin"]),
              b"cannot be redefined",
              [b"region-scoped cell access is a call form, not an ordinary function"],
            ),
          }
        } else if def.name.name == compare_values_name() {
          {
            ..acc,
            checker: report_error_at(
              acc.checker,
              b"E0105",
              def.name.span,
              b"`compare_values` is a builtin",
              b"cannot be redefined",
              [
                b"it is the order `Map` iterates in, and `derive ord` builds a dictionary out of it \xe2\x80\x94 a module that could redefine it would give one type two orders",
                b"`compare` is the same operation under a name you may shadow",
              ],
            ),
          }
        } else if call_operator(def.name.name) != None {
          {
            ..acc,
            checker: report_error_at(
              acc.checker,
              b"E0105",
              def.name.span,
              Bytes::concat_all([b"`", def.name.name, b"` is a builtin"]),
              b"cannot be redefined",
              [
                Bytes::concat_all([
                  b"the operator `",
                  match call_operator(def.name.name) { Some(o) -> o.text, None -> b"" },
                  b"` is written in its name, so a module that redefined it would change what the operator means",
                ]),
              ],
            ),
          }
        } else {
          { checker: acc.checker, fns: acc.fns.push(def), names: acc.names.push(def.name.name) }
        },
        _ -> acc,
      },
  );
  let fns = collected.fns.map(|d: FnDef| carried(collected.checker, d));
  let names = fns.map(|d: FnDef| qualify(parsed.name, d.name.name));
  let placed: Checker = fns.fold(collected.checker, |c: Checker, d: FnDef|
    member_declared(c, parsed, d));
  let signed: Signed = range(0, fns.len()).fold(
    { checker: placed, sigs: [], members: [] },
    |acc: Signed, i: Int| signed_fn(acc, parsed, fns.get(i), names.get(i)),
  );
  {
    checker: externs_bound(signed.checker, parsed),
    signed: { fns: fns, names: names, sigs: signed.sigs, members: signed.members },
  }
}

/// A shipped module's own externs bound as builtins under its name; the prelude's are bound before
/// any module is checked.
fn externs_bound(checker: Checker, parsed: ParsedModule) -> Checker / {abort.raise} =
  if !is_shipped(parsed.name) || parsed.name == prelude_module() { checker } else {
    // A type its declarations name is one the module declares or imports by name.
    let own = parsed.module.items.fold(
      prelude_imports(parsed.module.imports),
      |acc: Map<Bytes, Bytes>, item: Item|
        match item {
          IType(t) -> acc.insert(t.name.name, qualify(parsed.name, t.name.name)),
          _ -> acc,
        },
    );
    parsed.module.items.fold(checker, |c: Checker, item: Item|
      match item {
        IExtern(def) -> builtin_bound(c, declared(qualify(parsed.name, def.name.name), own, def)),
        _ -> c,
      })
  }

/// `b` bound where a call finds it, with what its declaration states.
fn builtin_bound(c: Checker, b: Builtin) -> Checker / {abort.raise} =
  {
    ..c,
    env: env_bind_global(c.env, b.name, b.scheme),
    constraints: if b.constraints.len() == 0 { c.constraints }
    else { c.constraints.insert(b.name, b.constraints) },
    contracts: c.contracts.insert(b.name, b.contract),
    fresh: {
      next_ty: max(c.fresh.next_ty, b.scheme.ty_vars.len()),
      next_row: max(c.fresh.next_row, b.scheme.row_vars.len()),
    },
  }

/// The module's bodies walked against what every module's functions declare, and its groups
/// settled; a check that walks only some of its functions settles none.
fn walked_fns(
  checker: Checker,
  parsed: ParsedModule,
  signed: SignedModule,
) -> Checker / {abort.raise} = {
  let fns = signed.fns;
  let names = signed.names;
  let own = range(0, names.len()).fold(Map::new(), |m: Map<Bytes, Int>, i: Int|
    m.insert(names.get(i), i));
  let stated = stated_of(parsed);
  // What a key answers is compared in its turn, so a comparison reads through it.
  let answers = |f: Bytes|
    match own.get(f) { Some(i) -> Some(signed.sigs.get(i).ret), None -> None };
  let walked = walked_first(fns).fold(
    { checker: { ..checker, own_fns: own }, bodies: Map::new(), signed: Map::new() },
    |acc: { checker: Checker, bodies: Map<Int, Body>, signed: Map<Int, Bool> }, i: Int| {
      let o = walked_fn(
        acc.checker,
        parsed,
        fns.get(i),
        names.get(i),
        signed.sigs.get(i),
        signed.members.get(i),
        stated,
        answers,
      );
      {
        checker: if o.left != Walked { o.checker } else {
          {
            ..o.checker,
            bodies: o.checker.bodies.push(
              kept_walk(names.get(i), signed.members.get(i).labels, o.body),
            ),
          }
        },
        bodies: acc.bodies.insert(i, o.body),
        signed: if o.left == Signed { acc.signed.insert(i, true) } else { acc.signed },
      }
    },
  );
  let bodies = range(0, fns.len()).map(|i: Int|
    match walked.bodies.get(i) {
      Some(b) -> b,
      None -> panic("a function of the module was not walked"),
    });
  let out = bodies.map(|b: Body|
    b.refs.concat(b.calls.concat(b.stated).map(|c: OwnCall| c.callee)).fold(
      [],
      |acc: List<Int>, n: Bytes|
        match own.get(n) {
          Some(i) -> if acc.contains(i) { acc } else { acc.push(i) },
          None -> acc,
        },
    ));
  let module: ModuleFns = {
    fns: fns,
    names: names,
    members: signed.members,
    bodies: bodies,
    written: members_in(
      walked.checker.member_sites,
      walked.checker.module,
      walked.checker.resolved.signatures,
    ),
  };
  let done: Checker = { ..walked.checker, own_fns: Map::new() };
  match checker.known.walks {
    Only(_) -> done,
    // Groups come callees first, so a callee is counted before its callers.
    _ ->
      graph::components({ out: out }).fold(done, |c: Checker, comp: List<Int>|
        if comp.any(|i: Int| walked.signed.contains(i)) { c } else {
          // What a group reads of a function it calls is what that function's group settled.
          comp.fold((), |_: Unit, i: Int|
            if out.get(i).any(|k: Int| walked.signed.contains(k)) {
              panic(
                "a group is settled before a function it calls: "
                  ++ String::of_bytes_lossy(names.get(i)),
              )
            });
          settle_group(c, module, comp)
        }),
  }
}

/// Whether a check walks the function `name`'s body.
fn walks(checker: Checker, name: Bytes) -> Bool =
  match checker.known.walks {
    Every -> true,
    Only(names) -> names.contains(name),
    Given(_, _) -> false,
  }

/// The body another check walked of the function `name`, where this check is handed one.
fn handed_body(checker: Checker, name: Bytes) -> Option<HandedBody> =
  match checker.known.walks { Given(bodies, _) -> bodies.get(name), _ -> None }

/// What `body`, walked as the function `name` whose label parameters are `labels`, leaves for
/// another check.
fn kept_walk(name: Bytes, labels: List<Int>, body: Body) -> WalkedBody =
  {
    name: name,
    atoms: filed_atoms(body.row.atoms, labels),
    through: body.row.tail != None,
    performs: body.performs.map(|s: PerformSite|
      { ..s, atom: List::at_or(filed_atoms([s.atom], labels), 0, s.atom) }),
    repeated: body.repeated,
    raise_notes: body.raise_notes,
    refs: body.refs,
    calls: body.calls,
    stated: body.stated,
    tags: body.tags,
    fills: body.fills,
    names: body.names,
  }

/// The module that declares the functions of the language's type `of` beside the prelude's.
fn home_module(of: Bytes) -> Bytes / {abort.raise} =
  b"std.".concat(Bytes::of_string(String::of_bytes(of).ascii_lower()))

/// A function of a type, `fn T::name`, is declared by the module that declares `T`, a sum or a
/// `new` record, under no name a field of the record has: a call on a value finds it by the type
/// alone, and reads a record's fields first. A type of the language's has its home module's,
/// under no name the prelude declares for it.
fn member_declared(checker: Checker, parsed: ParsedModule, def: FnDef) -> Checker / {abort.raise} =
  match member_of(def.name.name) {
    None -> checker,
    Some(m) -> {
      let type_name = qualify(parsed.name, m.of);
      match checker.types.get(type_name) {
        None -> if builtin_type_arity(m.of) != None && home_module(m.of) == parsed.name {
          if env_depth_of(checker.env, def.name.name) != Some(0) { checker } else {
            report_error_at(
              checker,
              b"E0105",
              def.name.span,
              Bytes::concat_all([b"`", def.name.name, b"` is a builtin"]),
              b"cannot be redefined",
              [b"a type has one function of a name, and the prelude declares this one"],
            )
          }
        } else {
          report_error_at(
            checker,
            b"E0208",
            def.name.span,
            Bytes::concat_all([b"`", m.of, b"` is not a type this module declares"]),
            b"declared in another module, or not at all",
            [
              b"a function of a type is found by the type alone, with no search, so only the module that declares the type declares one",
            ],
          )
        },
        Some(decl) -> match decl.declared {
          DeclaredAlias(_) ->
            report_error_at_and(
              checker,
              b"E0217",
              def.name.span,
              Bytes::concat_all([
                b"`",
                m.of,
                b"` is an alias, and a function of a type is of a sum or a `new` record",
              ]),
              b"no type of its own",
              { module: decl.owner, span: decl.span },
              b"declared here",
              [
                b"an alias is the type it names, so a function of one would be of every value of that type",
              ],
            ),
          DeclaredRecord(_) -> match checker.nominals.get(type_name) {
            Some(r) -> match record_fields(r.ty) {
              Some(fs) -> if field_get(fs, m.member) == None { checker } else {
                report_error_at_and(
                  checker,
                  b"E0105",
                  def.name.span,
                  Bytes::concat_all([
                    b"`",
                    m.of,
                    b"` has a field `",
                    m.member,
                    b"` and a function of that name",
                  ]),
                  b"declared again here",
                  { module: decl.owner, span: decl.span },
                  b"the field is declared here",
                  [
                    b"`value.name` reads a record's field and `value.name(..)` calls it, so a function of the record under the same name could never be called on a value; rename one",
                  ],
                )
              },
              None -> checker,
            },
            None -> checker,
          },
          DeclaredSum -> checker,
        },
      }
    },
  }

/// The order a module's bodies are walked in: each after those its body names, where the names
/// alone say. Nothing a module that checks means turns on it. A body that performs more than its
/// unwritten row is read by the bodies walked after it as performing that, so one check names
/// every row the program has to write.
fn walked_first(fns: List<FnDef>) -> List<Int> / {abort.raise} = {
  let index = range(0, fns.len()).fold(Map::new(), |acc: Map<Bytes, Int>, i: Int|
    acc.insert(fns.get(i).name.name, i));
  let adj = fns.map(|d: FnDef|
    refs_of(d.body, param_names(d.params)).names.fold([], |acc: List<Int>, qname: QName|
      if !is_bare(qname) { acc } else {
        match index.get(qname.name.name) {
          Some(i) -> if acc.contains(i) { acc } else { acc.push(i) },
          None -> acc,
        }
      }));
  graph::components({ out: adj }).fold([], |acc: List<Int>, comp: List<Int>| acc.concat(comp))
}

/// The functions of `parsed` a check walks, each by its program-wide name, in the order it files
/// them, which is the order they are written in: a function named twice, or by a name a builtin
/// holds, is refused rather than walked.
pub fn walk_order(parsed: ParsedModule) -> List<Bytes> =
  parsed.module.items.fold([], |acc: List<Bytes>, item: Item|
    match item {
      IFn(def) -> if acc.contains(qualify(parsed.name, def.name.name))
          || is_cell_builtin(def.name.name)
          || def.name.name == compare_values_name()
          || call_operator(def.name.name) != None { acc }
      else { acc.push(qualify(parsed.name, def.name.name)) },
      _ -> acc,
    })

/// What each type of `parsed` states, by the type's qualified name.
fn stated_of(parsed: ParsedModule) -> Map<Bytes, StatedFns> = {
  let none: StatedFns = { key: None, show: None, numeric: [] };
  let of = |m: Map<Bytes, StatedFns>, target: Ident|
    match m.get(qualify(parsed.name, target.name)) { Some(x) -> x, None -> none };
  parsed.module.items.fold(Map::new(), |acc: Map<Bytes, StatedFns>, item: Item|
    match item {
      IInstance(def) -> {
        let by = Some(qualify(parsed.name, def.by.name));
        let was = of(acc, def.target);
        acc.insert(qualify(parsed.name, def.target.name), if is_key(def.kind) { { ..was, key: by } }
        else { { ..was, show: by } })
      },
      INumeric(def) ->
        acc.insert(qualify(parsed.name, def.target.name), {
          ..of(acc, def.target),
          numeric: numeric_ops().map(|op: Bytes|
            match numeric_by(def, op) { Some(by) -> qualify(parsed.name, by.name), None -> b"" }),
        }),
      _ -> acc,
    })
}

/// The functions `stated` names that comparing a value of `ty`, or with `key` false showing one,
/// calls: a type that states one is read through it, a key's answer compared in its turn, and any
/// other type through what it holds. `room` is how many more declarations the walk may enter.
fn stated_in(
  checker: Checker,
  stated: Map<Bytes, StatedFns>,
  answers: (Bytes) -> Option<Type> / {abort.raise},
  ty: Type,
  key: Bool,
  room: Int,
  acc: Reached,
) -> Reached / {abort.raise} =
  match ty {
    TyVar(_) -> acc,
    TyFn(_) -> acc,
    TyRecord(fs) ->
      fs.fold(acc, |a: Reached, f: Field| stated_in(checker, stated, answers, f.ty, key, room, a)),
    TyNominal(n) ->
      n.fields.fold(acc, |a: Reached, f: Field|
        stated_in(checker, stated, answers, f.ty, key, room, a)),
    TyCon(c) -> {
      let args = c.args.fold(acc, |a: Reached, x: Type|
        stated_in(checker, stated, answers, x, key, room, a));
      if room <= 0 || args.seen.contains(c.name) { args } else {
        let within: Reached = { seen: args.seen.push(c.name), fns: args.fns };
        let said = match stated.get(c.name) {
          Some(x) -> if key { x.key } else { x.show },
          None -> None,
        };
        match said {
          Some(f) -> {
            let called: Reached = {
              seen: within.seen,
              fns: if within.fns.contains(f) { within.fns } else { within.fns.push(f) },
            };
            match ((key, answers(f))) {
              (true, Some(t)) ->
                stated_in(checker, stated, answers, resolve(checker, t), key, room - 1, called),
              _ -> called,
            }
          },
          None ->
            checker.ctors.filter(|k: CtorInfo| k.type_name == c.name).fold(
              within,
              |a: Reached, k: CtorInfo|
                k.fields.fold(a, |b: Reached, f: Type|
                  stated_in(checker, stated, answers, f, key, room - 1, b)),
            ),
        }
      }
    },
  }

/// The calls `body` makes of what the module's types state, each at the expression that makes it:
/// an operator at a type that states its arithmetic, and a comparison, a `Map` or a constrained
/// parameter at a type that holds one stating a key or a show.
fn stated_calls(
  checker: Checker,
  stated: Map<Bytes, StatedFns>,
  answers: (Bytes) -> Option<Type> / {abort.raise},
  body: TypedSites,
) -> List<OwnCall> / {abort.raise} = {
  let reached = |ty: Type, key: Bool|
    stated_in(checker, stated, answers, resolve(checker, ty), key, keyed_room(checker), {
      seen: [],
      fns: [],
    }).fns;
  let arithmetic = |ty: Type|
    match resolve(checker, ty) {
      TyCon(c) -> match stated.get(c.name) { Some(x) -> x.numeric, None -> [] },
      _ -> [],
    };
  let at_ = |acc: List<OwnCall>, span: Span, fns: List<Bytes>|
    fns.fold(acc, |a: List<OwnCall>, f: Bytes|
      if f == b"" { a } else { a.push({ callee: f, span: span }) });
  let operators = body.numerics.fold([], |acc: List<OwnCall>, n: Numeric|
    at_(acc, n.span, if is_ordered(n.op) { reached(n.ty, true) } else {
      match numeric_slot(n.op) {
        Some(i) -> match arithmetic(n.ty).at(i) { Some(f) -> [f], None -> [] },
        None -> [],
      }
    }));
  let compared = body.comparisons.fold(
    operators,
    |acc: List<OwnCall>, x: { module: Int, span: Span, ty: Type }|
      at_(acc, x.span, reached(x.ty, true)),
  );
  let keyed = body.map_keys.fold(compared, |acc: List<OwnCall>, x: MapKeySite|
    at_(acc, x.span, reached(x.key, true)));
  body.constrained.fold(keyed, |acc: List<OwnCall>, x: ConstraintSite|
    at_(acc, x.span, match x.deriver {
      DShow -> reached(x.ty, false),
      DEq -> reached(x.ty, true),
      DOrd -> reached(x.ty, true),
      DHash -> reached(x.ty, true),
      DNumeric -> arithmetic(x.ty).concat(reached(x.ty, true)),
      DInteger -> arithmetic(x.ty).concat(reached(x.ty, true)),
      _ -> [],
    }))
}

/// An operation atom's mode is its declaration's; a row read back from text does not carry it.
fn settled_atom(checker: Checker, atom: Atom) -> Atom / {abort.raise} =
  match atom.op {
    None -> atom,
    Some(name) -> match effect_of(checker, atom.effect) {
      None -> atom,
      Some(info) -> match op_named(info, name) {
        Some(o) -> { ..atom, mode: o.mode },
        None -> atom,
      },
    },
  }

fn settled_row(checker: Checker, atoms: List<Atom>) -> Row / {abort.raise} =
  { atoms: atoms_sorted(atoms.map(|atom: Atom| settled_atom(checker, atom))), tail: None }

/// The rows handed in for a definition.
fn seeded_rows(checker: Checker, name: Bytes) -> Option<KnownDef> = checker.known.defs.get(name)

/// What a name the termination walk leaves free refers to.
fn group_callee_kind(
  checker: Checker,
  qualified: List<Bytes>,
  qname: QName,
) -> Callee / {abort.raise} =
  if starts_upper(qname.name.name) { ConstructorCallee } else {
    match declared_value(checker, qname) {
      Some(n) ->
        range(0, qualified.len()).fold(DefinedCallee(n), |acc: Callee, i: Int|
          if qualified.get(i) == n { GroupMember(i) } else { acc }),
      None -> match of_language_type(checker, qname) {
        Found(m) -> if m.qname.module == None { BuiltinCallee(m.callee) } else { OtherCallee },
        _ -> if is_bare(qname) && env_depth_of(checker.env, qname.name.name) == Some(0) {
          BuiltinCallee(qname.name.name)
        } else { OtherCallee },
      },
    }
  }

/// Where `op` stands among the operations a `numeric` names.
fn numeric_slot(op: Bytes) -> Option<Int> / {abort.raise} =
  range(0, numeric_ops().len()).fold(None, |found: Option<Int>, i: Int|
    match found {
      Some(_) -> found,
      None -> if numeric_ops().get(i) == op { Some(i) } else { None },
    })

/// Binds `def` by what its signature writes, for every body of its module to call it by, and files
/// what the signature alone says of it. The constraints it writes stand for each walk, so a call
/// from its own module answers for them as a call from outside will.
fn signed_fn(acc: Signed, parsed: ParsedModule, def: FnDef, name: Bytes) -> Signed / {abort.raise} = {
  let s: WithSig = written_signature({ ..acc.checker, derived: derived_of(parsed, def) }, def);
  let scheme = member_scheme(s.checker, def, s.sig);
  let labels = def.generics.labels.fold([], |vs: List<Int>, ident: Ident|
    match s.sig.label_params.get(ident.name) { Some(v) -> vs.push(v), None -> vs });
  let types = def.generics.types.fold([], |ps: List<RigidParam>, ident: Ident|
    match s.sig.ty_params.get(ident.name) {
      Some(TyVar(v)) -> if scheme.ty_vars.contains(v) { ps.push({ name: ident.name, var: v }) }
      else { ps },
      _ -> ps,
    });
  let constraints = published_constraints({ ..s.checker, ty_params: s.sig.ty_params }, def, scheme);
  let bound: Checker = {
    ..s.checker,
    derived: None,
    env: env_bind_global(s.checker.env, name, scheme),
    constraints: s.checker.constraints.insert(name, constraints),
  };
  {
    checker: set_def(bound, {
      name: name,
      module: parsed.name,
      simple_name: def.name.name,
      scheme: scheme,
      footprint: resolve_row_in(bound, s.sig.published_row).atoms,
      performed: [],
      scaling: [],
      repeats: [],
      bounded: s.sig.bounded.map(|a: Atom| resolve_atom(bound.subst, a)),
      tail_bounded: s.sig.tail_bounded,
      ending: Ends,
      summary: unknown_summary(),
      raises: [],
      row_aliases: row_aliases(def),
      constraints: constraints,
      spec: [],
      at: location_of(bound, def.span),
    }),
    sigs: acc.sigs.push(s.sig),
    members: acc.members.push({ name: name, labels: labels, types: types }),
  }
}

/// How a check came by what a function leaves its group: it walked the body; it took a body
/// another check walked, or the rows one filed; or it read the signature alone, which leaves
/// nothing a group can be settled from.
type Left = | Walked | Taken | Signed

/// What `def` leaves its group: its body walked ([`walked_or_filed`]), or the body another check
/// walked where one is handed in, or what its signature alone says where the check walks only
/// other functions.
fn walked_fn(
  checker: Checker,
  parsed: ParsedModule,
  def: FnDef,
  name: Bytes,
  sig: Signature,
  member: GroupDef,
  stated: Map<Bytes, StatedFns>,
  answers: (Bytes) -> Option<Type> / {abort.raise},
) -> { checker: Checker, body: Body, left: Left } / {abort.raise} =
  match handed_body(checker, name) {
    Some(kept) -> {
      let o = handed_fn(checker, parsed, def, name, sig, member, kept);
      { checker: o.checker, body: o.body, left: Taken }
    },
    None -> if !walks(checker, name) && seeded_rows(checker, name) == None {
      let filed: Checker = {
        ..checker,
        seeded: checker.seeded.push(name),
        kept: checker.kept.push({ name: name, facts: b"" }),
      };
      let p = published_fn(filed, parsed, def, name, sig, resolve_row_in(filed, sig.published_row));
      { checker: p.checker, body: signed_body(p.checker, sig, p.row, p.written), left: Signed }
    } else { walked_or_filed(checker, parsed, def, name, sig, member, stated, answers) },
  }

/// A function another check walked, published from its signature and the row that walk found,
/// with the body that walk left for its group read as this check binds the definition.
fn handed_fn(
  checker: Checker,
  parsed: ParsedModule,
  def: FnDef,
  name: Bytes,
  sig: Signature,
  member: GroupDef,
  kept: HandedBody,
) -> { checker: Checker, body: Body } / {abort.raise} =
  match ((
      placed_labels(kept.body.atoms, member.labels),
      placed_labels(kept.body.performs.map(|s: PerformSite| s.atom), member.labels),
    )) {
    (Some(atoms), Some(performed)) -> {
      let filed: Checker = {
        ..checker,
        seeded: checker.seeded.push(name),
        kept: checker.kept.push({ name: name, facts: kept.facts }),
      };
      let row = {
        ..settled_row(filed, atoms),
        tail: if kept.body.through { resolve_row_in(filed, sig.published_row).tail } else { None },
      };
      let p = published_fn(filed, parsed, def, name, sig, row);
      {
        checker: p.checker,
        body: {
          ..signed_body(p.checker, sig, p.row, p.written),
          performs: range(0, performed.len()).map(|i: Int|
            { ..kept.body.performs.get(i), atom: performed.get(i) }),
          repeated: kept.body.repeated,
          raise_notes: kept.body.raise_notes,
          refs: kept.body.refs,
          calls: kept.body.calls,
          stated: kept.body.stated,
          tags: kept.body.tags,
          fills: kept.body.fills,
          names: kept.body.names,
        },
      }
    },
    _ -> panic("a body handed in names a label parameter its definition does not write"),
  }

/// Walks `def`'s body against the signatures of its module, holds it to what its signature writes,
/// publishes what no group decides of it, and closes what its group reads. A definition whose rows
/// are handed in is published from its written signature and them instead. A row that will not
/// unify is one the caller should never have filed, which is nothing this program's author can act
/// on, so the body is walked: slower, and right whatever the row said. `stated` is what the
/// module's types state, and `answers` what a function of the module answers.
fn walked_or_filed(
  checker: Checker,
  parsed: ParsedModule,
  def: FnDef,
  name: Bytes,
  sig: Signature,
  member: GroupDef,
  stated: Map<Bytes, StatedFns>,
  answers: (Bytes) -> Option<Type> / {abort.raise},
) -> { checker: Checker, body: Body, left: Left } / {abort.raise} = {
  let handed = seeded_rows(checker, name);
  let taken: Option<{ checker: Checker, row: Row, count: Count }> = match handed {
    None -> None,
    Some(rows) -> match ((
        placed_labels(rows.footprint, member.labels),
        placed_labels(rows.performed, member.labels),
        placed_labels(rows.scaling, member.labels),
      )) {
      (Some(footprint), Some(performed), Some(scaling)) -> {
        // The rows handed in carry atoms alone; a row ends in what the signature writes, the
        // definition's own row parameter when it is generic over one.
        let u = unify_row(checker.subst, checker.fresh, sig.published_row, {
          ..settled_row(checker, footprint),
          tail: resolve_row_in(checker, sig.published_row).tail,
        });
        // Left uninstalled when it failed, so a walk starts from the substitution it would have.
        match u.error {
          Some(_) -> None,
          None -> {
            let c: Checker = with_unified(checker, u);
            Some({
              checker: c,
              row: settled_row(c, performed),
              count: {
                scaling: settled_row(c, scaling).atoms,
                sites: [],
                repeats: rows.repeats,
                tail_over: None,
                recursed: None,
                raises: rows.raises,
              },
            })
          },
        }
      },
      _ -> None,
    },
  };
  let stepped: { checker: Checker, body: Body } = match taken {
    Some(x) -> {
      let filed: Checker = {
        ..x.checker,
        seeded: x.checker.seeded.push(name),
        kept: x.checker.kept.push({
          name: name,
          facts: match handed { Some(rows) -> rows.facts, None -> b"" },
        }),
      };
      let p = published_fn(filed, parsed, def, name, sig, x.row);
      {
        checker: p.checker,
        body: {
          ..signed_body(p.checker, sig, p.row, p.written),
          filed: handed,
          count: Some(x.count),
        },
      }
    },
    None -> {
      let o: Walk = check_fn_body(
        { ..checker, derived: derived_of(parsed, def), walking: name },
        def,
        sig,
      );
      let walked: Checker = { ..o.checker, derived: None, walking: b"" };
      // Typed, its operators and comparisons say which of the module's functions they call, as
      // its calls on values do.
      let members = walked.member_sites.drop(checker.member_sites.len()).fold(
        [],
        |acc: List<OwnCall>, m: MemberSite|
          if m.callee.len() == 0 { acc } else { acc.push({ callee: m.callee, span: m.span }) },
      );
      let calls = if stated.len() == 0 { members } else {
        members.concat(
          stated_calls(walked, stated, answers, {
            numerics: walked.numerics.drop(checker.numerics.len()),
            comparisons: walked.comparisons.drop(checker.comparisons.len()),
            map_keys: walked.map_keys.drop(checker.map_keys.len()),
            constrained: walked.constrained_uses.drop(checker.constrained_uses.len()),
          }),
        )
      };
      let settled: Checker = settle_columns(
        settle_bit_ops(settle_numerics(settle_concats(settle_updates(walked)))),
      );
      let judged: Checker = close_unreachable_row(
        bounded_row(require_written_signature(settled, def, sig), def, sig),
        sig,
      );
      let p = published_fn(judged, parsed, def, name, sig, o.row);
      let c = p.checker;
      let published = resolve_row_in(c, sig.published_row);
      let held = sig.params.map(|ty: Type| rows_in(c, ty, { atoms: [], vars: [] }).vars);
      let own = member.types.map(|t: RigidParam| t.var);
      let naming = member.types.fold(printer_new(), |printer: Printer, t: RigidParam|
        printer_naming(printer, t.var, t.name));
      {
        checker: c,
        body: {
          ..signed_body(c, sig, p.row, p.written),
          performs: o.performs.map(|site: PerformSite|
            { ..site, atom: resolve_atom(c.subst, site.atom) }),
          repeated: o.repeated_vars.map(|r: Repeated| {
            let v = match resolve_row_in(c, row_open(r.var)).tail { Some(v) -> v, None -> r.var };
            {
              params: range(0, held.len()).filter(|i: Int| held.get(i).contains(v)),
              tail: published.tail == Some(v),
              over: r.over,
              maybe: r.maybe,
            }
          }),
          raise_notes: o.raise_notes,
          refs: o.refs,
          calls: o.calls,
          stated: calls,
          tags: o.tag_uses.map(|u: TagUse|
            {
              name: u.name,
              refusal: error_at(
                b"E0152",
                c.module,
                u.t.tag.span,
                Bytes::concat_all([
                  b"`",
                  u.t.tag.name,
                  b"::",
                  u.callee.name.name,
                  b"` is in a recursion with what holds the literal",
                ]),
                b"a tag is whole before a literal of it is checked",
                [tag_rule(u.t)],
              ),
            }),
          fills: o.fills.map(|f: GroupFill|
            {
              module: f.module,
              span: f.span,
              callee: f.callee,
              grows: range(0, f.args.len()).fold([], |acc: List<Growth>, i: Int| {
                let ty = resolve(c, f.args.get(i));
                let grows = match ty {
                  TyVar(_) -> false,
                  _ ->
                    free_vars(c.subst, ty, { tys: [], rows: [] }).tys.fold(
                      false,
                      |b: Bool, v: Int| b || own.contains(v),
                    ),
                };
                if grows { acc.push({ param: i, ty: print_ty(naming, ty).text }) } else { acc }
              }),
            }),
          names: named_callees(c, def),
        },
      }
    },
  };
  {
    checker: record_spec_env(stepped.checker, def, name, sig),
    body: stepped.body,
    left: match taken { None -> Walked, Some(_) -> Taken },
  }
}

/// Publishes of `def` what no group decides: its scheme, the row a caller reads and what its
/// signature alone says of its counts. `row` is what its body performs. An unwritten row the body
/// overran is reported already; its callers are checked against what the body performs, so one
/// check names every row the program has to write. A `const` publishes the empty row whatever its
/// body raises: the build saw it raise nothing.
fn published_fn(
  checker: Checker,
  parsed: ParsedModule,
  def: FnDef,
  name: Bytes,
  sig: Signature,
  row: Row,
) -> { checker: Checker, row: Row, written: { scaling: List<Atom>, repeats: List<Int> } } / {abort.raise} = {
  let c: Checker = { ..checker, env: env_remove_global(checker.env, name) };
  let body_row = resolve_row_in(c, row);
  let overran = match def.effects {
    Some(_) -> false,
    None -> def.baked == None && (body_row.atoms.len() > 0 || body_row.tail != None),
  };
  let fn_ty = if overran { fn_type(sig.params, sig.ret, body_row) } else { sig.fn_ty };
  let g: Generalized = generalize(c.subst, c.env, fn_ty);
  let sc: Scheme = split_labels(g.scheme, def, sig);
  let footprint = if overran { body_row } else { resolve_row_in(c, sig.published_row) };
  let bounded = sig.bounded.map(|a: Atom| resolve_atom(c.subst, a));
  let bound: Checker = { ..c, env: env_bind_global(g.env, name, sc), ty_params: sig.ty_params };
  let constraints = published_constraints(bound, def, sc);
  let ordered: Checker = witness_order(bound, def, sc);
  {
    checker: set_def(
      {
        ..ordered,
        ty_params: Map::new(),
        constraints: ordered.constraints.insert(name, constraints),
      },
      {
        name: name,
        module: parsed.name,
        simple_name: def.name.name,
        scheme: sc,
        footprint: footprint.atoms,
        performed: body_row.atoms,
        scaling: [],
        repeats: [],
        bounded: bounded,
        tail_bounded: sig.tail_bounded,
        ending: Ends,
        summary: unknown_summary(),
        raises: [],
        row_aliases: row_aliases(def),
        constraints: constraints,
        spec: [],
        at: location_of(bound, def.span),
      },
    ),
    row: body_row,
    written: written_counts(fn_ty, footprint.atoms, bounded, sig.tail_bounded),
  }
}

/// What a group reads of a function's signature, closed, around the row its body performs.
fn signed_body(
  checker: Checker,
  sig: Signature,
  row: Row,
  written: { scaling: List<Atom>, repeats: List<Int> },
) -> Body / {abort.raise} = {
  let published = resolve_row_in(checker, sig.published_row);
  {
    row: row,
    filed: None,
    count: None,
    params: sig.params.map(|ty: Type| resolve(checker, ty)),
    tail: published.tail,
    bounded: sig.bounded.map(|a: Atom| {
      let atom = resolve_atom(checker.subst, a);
      { atom: atom, written: atom_written(checker, atom) }
    }),
    tail_bounded: sig.tail_bounded,
    tail_name: match published.tail {
      Some(v) ->
        sig.row_params.fold(None, |found: Option<Bytes>, n: Bytes, w: Int|
          match found { Some(_) -> found, None -> if w == v { Some(n) } else { None } }),
      None -> None,
    },
    says_diverges: published.atoms.fold(false, |found: Bool, a: Atom| found || is_diverges(a)),
    written: written,
    performs: [],
    repeated: [],
    raise_notes: [],
    refs: [],
    calls: [],
    stated: [],
    tags: [],
    fills: [],
    names: [],
  }
}

/// What each name `def` reads refers to, as the termination walk asks of a name it did not bind:
/// read once here, where the module's scope is at hand.
fn named_callees(checker: Checker, def: FnDef) -> List<NamedCallee> / {abort.raise} = {
  let read = def.params.fold(refs_of(def.body, []).names, |acc: List<QName>, p: Param|
    match p.default { Some(d) -> acc.concat(refs_of(d, []).names), None -> acc });
  read.fold(
    { seen: Map::new(), out: [] },
    |acc: { seen: Map<Bytes, Bool>, out: List<NamedCallee> }, q: QName| {
      let module = match q.module { Some(m) -> m.name, None -> b"" };
      let key = member_name(module, q.name.name);
      if acc.seen.contains(key) { acc } else {
        {
          seen: acc.seen.insert(key, true),
          out: acc.out.push({
            module: module,
            name: q.name.name,
            callee: group_callee_kind(checker, [], q),
          }),
        }
      }
    },
  ).out
}

/// `callee`, or the slot it has in the group `qualified` where it is a member.
fn member_or(qualified: List<Bytes>, callee: Callee) -> Callee / {abort.raise} =
  match callee {
    DefinedCallee(n) ->
      range(0, qualified.len()).fold(callee, |kind: Callee, i: Int|
        if qualified.get(i) == n { GroupMember(i) } else { kind }),
    other -> other,
  }

/// Settles one group of a module's functions, `comp`, whose bodies call one another round a cycle:
/// what each performs and calls a number of times that grows, whether its calls end, where it can
/// raise, and what its signature promised of those. It reads what each walk left closed and what
/// the groups it calls, each settled before it, published; nothing of the walks' substitution.
fn settle_group(checker: Checker, m: ModuleFns, comp: List<Int>) -> Checker / {abort.raise} = {
  let qualified = comp.map(|i: Int| m.names.get(i));
  let defs = comp.map(|i: Int| m.fns.get(i));
  let members = comp.map(|i: Int| m.members.get(i));
  let bodies = comp.map(|i: Int| m.bodies.get(i));
  let grouped: Checker = { ..checker, group_defs: members };
  let tagged: Checker = bodies.fold(grouped, |c: Checker, b: Body|
    b.tags.fold(c, |cc: Checker, u: TagRefusal|
      if qualified.contains(u.name) { report(cc, u.refusal) } else { cc }));
  let counts = range(0, comp.len()).map(|slot: Int|
    match bodies.get(slot).count {
      Some(count) -> count,
      None -> counted_body(tagged, defs.get(slot), bodies.get(slot)),
    });
  // A definition published from its rows answers what they say. A group published wholly so has no
  // body walked to read an ending from.
  let filed = bodies.map(|b: Body| b.filed);
  let walked = filed.fold(false, |any: Bool, k: Option<KnownDef>| any || k == None);
  let names = bodies.fold(Map::new(), |acc: Map<Bytes, Callee>, b: Body|
    b.names.fold(acc, |held: Map<Bytes, Callee>, x: NamedCallee|
      held.insert(member_name(x.module, x.name), member_or(qualified, x.callee))));
  // A body is read with its calls on values written out: one of a builtin through the prelude's
  // binder, one of a function of a type through its module's.
  let named = |qname: QName| {
    let through = match qname.module { Some(x) -> x.name, None -> b"" };
    if through == prelude_binder() { BuiltinCallee(qname.name.name) } else {
      match of_module(through) {
        Some(home) -> member_or(qualified, DefinedCallee(qualify(home, qname.name.name))),
        None -> match names.get(member_name(through, qname.name.name)) {
          Some(callee) -> callee,
          None -> OtherCallee,
        },
      }
    }
  };
  let stated = bodies.fold(Map::new(), |acc: Map<Bytes, List<Callee>>, b: Body|
    b.stated.fold(acc, |held: Map<Bytes, List<Callee>>, call: OwnCall| {
      let key = span_key(call.span);
      held.insert(
        key,
        List::push(
          match held.get(key) { Some(cs) -> cs, None -> [] },
          member_or(qualified, DefinedCallee(call.callee)),
        ),
      )
    }));
  let read: Verdict = if !walked { { endings: [], summaries: [] } } else {
    verdict({
      defs: defs.map(|d: FnDef| with_member_calls(d, m.written)),
      names: qualified,
      params: bodies.map(|b: Body| b.params),
      resolve: named,
      stated: |span: Span| match stated.get(span_key(span)) { Some(cs) -> cs, None -> [] },
      ending_of: |n: Bytes| match def_of(tagged, n) { Some(d) -> d.ending, None -> Ends },
      summary_of: |n: Bytes| tagged.summaries.get(n),
    })
  };
  let ending_of = |slot: Int|
    match filed.get(slot) { Some(k) -> k.ending, None -> read.endings.get(slot) };
  let summary_of = |slot: Int|
    match filed.get(slot) { Some(k) -> k.summary, None -> read.summaries.get(slot) };
  let summarized: Checker = {
    ..tagged,
    summaries: range(0, comp.len()).fold(tagged.summaries, |acc: Map<Bytes, Summary>, slot: Int|
      acc.insert(qualified.get(slot), summary_of(slot))),
  };
  let grown: Checker = bodies.fold(summarized, |c: Checker, b: Body|
    refuse_growth(c, members, b.fills));
  // Only the run's own definitions are counted off their bodies, so only they are held to `bounded`.
  let kept: Checker = range(0, comp.len()).fold(grown, |c: Checker, slot: Int|
    unwritten_divergence(
      if c.module >= c.known.root { c }
      else { kept_promises(c, bodies.get(slot), counts.get(slot)) },
      defs.get(slot),
      bodies.get(slot).says_diverges,
      ending_of(slot),
      |caller: Bytes|
        range(0, comp.len()).fold(0, |start: Int, k: Int|
          if qualified.get(k) == caller { defs.get(k).span.start } else { start }),
    ));
  // A group whose every raise is a call back into it has no place a raise starts.
  let raised_inside = counts.fold(false, |any: Bool, count: Count| any || count.raises.len() > 0)
    && counts.fold(true, |inside: Bool, count: Count|
      inside && count.raises.fold(true, |ok: Bool, r: Raise| ok && raised_within(qualified, r)));
  let published: Checker = range(0, comp.len()).fold(kept, |c: Checker, slot: Int|
    match def_of(c, qualified.get(slot)) {
      None -> c,
      Some(info) -> {
        let def = defs.get(slot);
        let count = counts.get(slot);
        // Another package's definition is read by what its row writes, whatever its body does.
        let counted = if c.module >= c.known.root { bodies.get(slot).written } else {
          {
            scaling: info.footprint.fold([], |acc: List<Atom>, w: Atom|
              if count.scaling.fold(false, |b: Bool, a: Atom| b || atoms_covered([w], a)) {
                acc.push(w)
              } else { acc }),
            repeats: count.repeats,
          }
        };
        set_def(c, {
          ..info,
          performed: if raised_inside { info.performed.filter(|a: Atom| !is_abort(a)) }
          else { info.performed },
          scaling: counted.scaling,
          repeats: counted.repeats,
          ending: ending_of(slot),
          summary: summary_of(slot),
          // A `const` raised nothing when the build evaluated it, so no place in it is one to guard.
          raises: if raised_inside || def.baked != None { [] } else { count.raises },
        })
      },
    });
  { ..published, group_defs: [] }
}

/// The signature's label parameters generalize among the type variables; they belong in their own
/// list, in the order the generic list wrote them, and a phantom one is still a parameter.
fn split_labels(scheme: Scheme, def: FnDef, signature: Signature) -> Scheme = {
  let ids = def.generics.labels.fold([], |acc: List<Int>, ident: Ident|
    match signature.label_params.get(ident.name) { Some(v) -> acc.push(v), None -> acc });
  if ids.len() == 0 { scheme } else {
    {
      ty_vars: ints_difference(scheme.ty_vars, ids),
      row_vars: scheme.row_vars,
      label_vars: ids,
      ty: scheme.ty,
    }
  }
}

/// A generated definition carries its `derive` item's span and nothing hand-written does.
fn derived_of(parsed: ParsedModule, def: FnDef) -> Option<Derived> =
  parsed.derived.fold(None, |acc: Option<Derived>, d: Derived|
    match acc { Some(_) -> acc, None -> if d.span == def.span { Some(d) } else { None } })

fn published_constraints(
  checker: Checker,
  def: FnDef,
  scheme: Scheme,
) -> List<DefConstraint> / {abort.raise} = {
  let found = def.constraints.fold([], |acc: List<DefConstraint>, c: Constraint|
    match checker.ty_params.get(c.param.name) {
      Some(TyVar(v)) -> {
        let param = range(0, scheme.ty_vars.len()).fold(0 - 1, |p: Int, i: Int|
          if p >= 0 { p } else if scheme.ty_vars.get(i) == v { i } else { p });
        if param < 0 { acc } else { acc.push({ deriver: c.deriver, param: param }) }
      },
      _ -> acc,
    });
  dedup_constraints(
    found.fold([], |acc: List<DefConstraint>, c: DefConstraint| insert_constraint(acc, c)),
  )
}

/// The parameters a definition's `numeric` and `integer` constraints are about, in its scheme's
/// order. One its signature never mentions is refused: no call fixes it, so none could pass it.
fn witness_order(checker: Checker, def: FnDef, scheme: Scheme) -> Checker / {abort.raise} = {
  let found = def.constraints.fold(
    { checker: checker, ranked: [] },
    |acc: { checker: Checker, ranked: List<{ at: Int, name: Bytes }> }, c: Constraint|
      if !is_predicate(c.deriver)
          || acc.ranked.fold(false, |b: Bool, r: { at: Int, name: Bytes }|
            b || r.name == c.param.name) { acc } else {
        match acc.checker.ty_params.get(c.param.name) {
          Some(TyVar(v)) -> {
            let position = range(0, scheme.ty_vars.len()).fold(0 - 1, |p: Int, i: Int|
              if p >= 0 { p } else if scheme.ty_vars.get(i) == v { i } else { p });
            if position >= 0 {
              let n = acc.ranked.len();
              let i = range(0, n).fold(n, |k: Int, j: Int|
                if k < n { k } else if position < acc.ranked.get(j).at { j } else { k });
              {
                checker: acc.checker,
                ranked: acc.ranked.take(i).push({ at: position, name: c.param.name }).concat(
                  acc.ranked.drop(i),
                ),
              }
            } else {
              {
                checker: report_error_at(
                  acc.checker,
                  b"E0310",
                  c.param.span,
                  Bytes::concat_all([
                    b"`",
                    c.param.name,
                    b"` appears in no parameter or answer of `",
                    def.name.name,
                    b"`",
                  ]),
                  Bytes::concat_all([
                    b"`",
                    deriver_text(c.deriver),
                    b"` is about a type each call fixes",
                  ]),
                  [
                    b"a call passes the type its arguments or answer give the parameter, and nothing here gives it one",
                  ],
                ),
                ranked: acc.ranked,
              }
            }
          },
          _ -> acc,
        }
      },
  );
  if found.ranked.len() == 0 { found.checker } else {
    {
      ..found.checker,
      witness_orders: found.checker.witness_orders.push({
        module: found.checker.module,
        name: def.name.name,
        params: found.ranked.map(|r: { at: Int, name: Bytes }| r.name),
      }),
    }
  }
}

fn constraint_lt(a: DefConstraint, b: DefConstraint) -> Bool =
  a.param < b.param || (a.param == b.param && deriver_tag(a.deriver) < deriver_tag(b.deriver))

fn insert_constraint(
  sorted: List<DefConstraint>,
  c: DefConstraint,
) -> List<DefConstraint> / {abort.raise} = {
  let n = sorted.len();
  let i = range(0, n).fold(n, |acc: Int, j: Int|
    if acc < n { acc } else if constraint_lt(c, sorted.get(j)) { j } else { acc });
  sorted.take(i).push(c).concat(sorted.drop(i))
}

fn dedup_constraints(xs: List<DefConstraint>) -> List<DefConstraint> / {abort.raise} =
  xs.fold([], |acc: List<DefConstraint>, c: DefConstraint|
    if acc.len() > 0 && acc.get(acc.len() - 1).param == c.param
        && same_deriver(acc.get(acc.len() - 1).deriver, c.deriver) { acc }
    else { acc.push(c) })

fn check_fn_body(outer: Checker, def: FnDef, signature: Signature) -> Walk / {abort.raise} = {
  let checker: Checker = {
    ..outer,
    scope: signature.scope,
    ty_params: signature.ty_params,
    row_params: signature.row_params,
    label_params: signature.label_params,
    performs: [],
    over: None,
    maybe: [],
    repeated_vars: [],
    recursed: None,
    refs: [],
    calls: [],
    tag_uses: [],
    group_fills: [],
    declared_atoms: match signature.declared {
      Some(r) -> resolve_row_in(outer, r).atoms,
      None -> [],
    },
    guards: guards::none(),
    raise_notes: [],
  };
  let assumed: Checker = witnessing(
    { ..checker, assumed: constraints_in_force(checker, def.constraints) },
    def.constraints,
  );
  let defaults: Checker = range(0, def.params.len()).fold(assumed, |c: Checker, i: Int|
    match def.params.get(i).default {
      None -> c,
      Some(d) -> {
        let o: Inferred = infer_whole(
          { ..c, copied: is_pub(def.vis) },
          d,
          hint_of(signature.params.get(i)),
        );
        expect(
          { ..o.checker, copied: false },
          expr_span(d),
          signature.params.get(i),
          o.ty,
          b"parameter default",
        ).checker
      },
    });
  let pushed: Checker = { ..defaults, env: env_push(defaults.env) };
  let bound: Checker = range(0, def.params.len()).fold(pushed, |c: Checker, i: Int|
    {
      ..c,
      env: env_bind(c.env, def.params.get(i).name.name, monomorphic(signature.params.get(i))),
    });
  let body: Inferred = infer_whole(bound, def.body, hint_of(signature.ret));
  let checked: Checker = expect_met(
    body.checker,
    expr_span(def.body),
    signature.ret,
    body.ty,
    match schema_of(bound.modules.get(bound.module).module, def) {
      Some(schema) -> if def.name.name == schema.name.name { b"a law states a proposition" }
      else { b"a `where` guard states a proposition" },
      None -> b"function body type",
    },
  );
  let popped: Checker = { ..checked, env: env_pop(checked.env) };
  let shaped: Checker = match def.baked {
    Some(at) -> check_const_shape(popped, def, at, signature),
    None -> popped,
  };
  let left = leaving_row(resolve_row_in(shaped, body.row));
  let rowed: Checker = match signature.declared {
    Some(declared) -> check_upper_bound(shaped, def, declared, left),
    None -> {
      let u = unify_row(shaped.subst, shaped.fresh, signature.published_row, left);
      let c = with_unified(shaped, u);
      match u.error {
        Some(e) -> report_unify(c, e, expr_span(def.body), b"inferred effect row"),
        None -> c,
      }
    },
  };
  {
    checker: {
      ..rowed,
      ty_params: Map::new(),
      row_params: Map::new(),
      label_params: Map::new(),
      assumed: [],
      over: None,
      maybe: [],
      repeated_vars: [],
      guards: guards::none(),
      raise_notes: [],
      refs: [],
      calls: [],
      tag_uses: [],
      group_fills: [],
    },
    row: left,
    performs: rowed.performs,
    repeated_vars: rowed.repeated_vars,
    raise_notes: rowed.raise_notes,
    refs: rowed.refs,
    calls: rowed.calls,
    tag_uses: rowed.tag_uses,
    fills: rowed.group_fills,
  }
}

/// The iteration a site stands under now that every definition outside its group is counted:
/// the innermost of `maybe` that holds, or else `over`. A callee of the site's own group is not
/// asked: a body that calls into its group performs everything again there.
fn iteration(
  checker: Checker,
  atom: Atom,
  over: Option<Span>,
  maybe: List<Maybe>,
) -> Option<Span> / {abort.raise} =
  match maybe.fold(None, |found: Option<Span>, m: Maybe|
      match found {
        Some(_) -> found,
        None -> if group_member(checker, m.callee) { None } else {
          match def_of(checker, m.callee) {
            None -> None,
            Some(d) -> if match m.param {
                Some(i) -> d.repeats.contains(i),
                None -> scales_like(d.scaling, atom),
              } { Some(m.span) }
            else { None },
          }
        },
      }) {
    Some(span) -> Some(span),
    None -> over,
  }

/// What a walked body performs and calls a number of times that grows with its input, and where it
/// can raise, read with its group `checker.group_defs` known.
fn counted_body(checker: Checker, def: FnDef, body: Body) -> Count / {abort.raise} = {
  let again = body.calls.concat(body.stated).fold(None, |acc: Option<Span>, call: OwnCall|
    match acc {
      Some(_) -> acc,
      None -> if group_member(checker, call.callee) { Some(call.span) } else { None },
    });
  let view: Checker = {
    ..checker,
    performs: body.performs.map(|site: PerformSite|
      { ..site, over: iteration(checker, site.atom, site.over, site.maybe), maybe: [] }),
    raise_notes: body.raise_notes,
    recursed: again,
  };
  let repeated = body.repeated.fold([], |acc: List<RepeatedRow>, r: RepeatedRow|
    match iteration(checker, no_atom(), r.over, r.maybe) {
      Some(o) -> acc.push({ ..r, over: Some(o), maybe: [] }),
      None -> acc,
    });
  let counted = counts_of(view, body.params, body.tail != None, body.row, repeated);
  {
    scaling: counted.scaling.map(|site: PerformSite| site.atom),
    sites: counted.scaling,
    repeats: counted.repeats,
    tail_over: counted.tail_over,
    recursed: again,
    raises: raises_of(view, def.span.start),
  }
}

fn is_abort(a: Atom) -> Bool = a.effect == b"abort" && a.op == Some(b"raise")

/// Why a call of `name` raises: by its own row, or, where that names no raise, by a function it
/// was handed.
fn raise_through(checker: Checker, name: Bytes) -> RaiseWhy / {abort.raise} =
  if group_member(checker, name) { Calls(name) } else {
    match checker.contracts.get(name) {
      Some(c) -> if c.raises { Unguarded(name) } else { Handed },
      None -> match def_of(checker, name) {
        Some(d) -> if d.footprint.fold(false, |any: Bool, a: Atom| any || is_abort(a)) {
          Calls(name)
        } else { Handed },
        None -> Calls(name),
      },
    }
  }

/// Where the body just walked can raise `abort.raise`, each place counted from `start`: every
/// place it is performed, a definition whose row names it once, where it is first called, and a
/// call that raises only as a function it is handed does where no raise inside it says more.
fn raises_of(checker: Checker, start: Int) -> List<Raise> / {abort.raise} = {
  let found = checker.performs.fold(
    { out: [], called: [] },
    |acc: { out: List<Raise>, called: List<Bytes> }, site: PerformSite|
      if !is_abort(site.atom) || site.module != checker.module { acc } else {
        let noted = checker.raise_notes.fold(None, |known: Option<RaiseWhy>, n: RaiseNote|
          match known {
            Some(_) -> known,
            None -> if n.span == site.span { Some(n.why) } else { None },
          });
        let why = match noted {
          Some(w) -> w,
          None -> match site.source {
            PerformVia(name) -> raise_through(checker, name),
            DirectPerform -> Performed,
            _ -> Handed,
          },
        };
        let raise = {
          span: span_between(site.span.start - start, site.span.end - start),
          why: why,
        };
        match why {
          Calls(name) -> if acc.called.contains(name) { acc }
          else { { out: acc.out.push(raise), called: acc.called.push(name) } },
          _ -> { ..acc, out: acc.out.push(raise) },
        }
      },
  ).out;
  found.filter(|r: Raise|
    match r.why {
      Handed ->
        !found.fold(false, |inside: Bool, other: Raise|
          inside
            || (other.span != r.span && other.span.start >= r.span.start
            && other.span.end <= r.span.end)),
      _ -> true,
    })
}

/// Whether a raise is only a call back into the group `names`.
fn raised_within(names: List<Bytes>, raise: Raise) -> Bool =
  match raise.why { Calls(name) -> names.contains(name), _ -> false }

/// What a body performs a number of times that grows with its input: what it performs under an
/// iteration, or everything, when it calls back into its own group. A parameter is called so when a
/// row variable its type holds is: `repeated` are those the body performs under an iteration, and
/// `tailed` whether the definition has a row parameter of its own.
fn counts_of(
  checker: Checker,
  params: List<Type>,
  tailed: Bool,
  body: Row,
  repeated: List<RepeatedRow>,
) -> { scaling: List<PerformSite>, repeats: List<Int>, tail_over: Option<Span> } / {abort.raise} = {
  let row = resolve_row_in(checker, body);
  let sites = resolved_sites(checker.subst, checker.performs);
  let scaling = match checker.recursed {
    Some(again) ->
      row.atoms.fold([], |acc: List<PerformSite>, atom: Atom| {
        let s = match site_among(sites, atom) {
          Some(x) -> x,
          None ->
            {
              atom: atom,
              module: checker.module,
              span: again,
              source: DirectPerform,
              over: None,
              maybe: [],
            },
        };
        acc.push({ ..s, over: Some(again) })
      }),
    None ->
      row.atoms.fold([], |acc: List<PerformSite>, atom: Atom|
        match sites.fold(None, |found: Option<PerformSite>, s: PerformSite|
            match found {
              Some(_) -> found,
              None -> if s.atom == atom && s.over != None { Some(s) } else { None },
            }) {
          Some(s) -> acc.push(s),
          None -> acc,
        }),
  };
  let repeats = range(0, params.len()).fold([], |acc: List<Int>, i: Int| {
    let called = match checker.recursed {
      Some(_) -> {
        let held = rows_in(checker, params.get(i), { atoms: [], vars: [] });
        held.vars.len() > 0 || held.atoms.len() > 0
      },
      None -> repeated.fold(false, |b: Bool, r: RepeatedRow| b || r.params.contains(i)),
    };
    if called { acc.push(i) } else { acc }
  });
  let tail_over = if !tailed { None } else {
    match checker.recursed {
      Some(again) -> Some(again),
      None ->
        repeated.fold(None, |found: Option<Span>, r: RepeatedRow|
          match found { Some(_) -> found, None -> if r.tail { r.over } else { None } }),
    }
  };
  { scaling: scaling, repeats: repeats, tail_over: tail_over }
}

/// A written row's `bounded` atoms and variable, held to what the body performs: an atom that grows
/// with the input is refused where it is performed, naming the iteration that repeats it.
fn kept_promises(checker: Checker, body: Body, count: Count) -> Checker / {abort.raise} = {
  let atoms: Checker = body.bounded.fold(
    checker,
    |c: Checker, w: { atom: Atom, written: Bytes }|
      match count.sites.fold(None, |found: Option<PerformSite>, s: PerformSite|
          match found {
            Some(_) -> found,
            None -> if atoms_covered([w.atom], s.atom) { Some(s) } else { None },
          }) {
        None -> c,
        Some(s) -> broken_promise(c, backticked_text(w.written), s, count.recursed),
      },
  );
  if !body.tail_bounded { atoms } else {
    match count.tail_over {
      None -> atoms,
      Some(over) ->
        broken_promise(
          atoms,
          match body.tail_name {
            Some(n) -> backticked_text(n).concat(b"'s operations"),
            None -> b"the row variable",
          },
          {
            atom: no_atom(),
            module: atoms.module,
            span: over,
            source: PerformThroughArgs,
            over: Some(over),
            maybe: [],
          },
          count.recursed,
        ),
    }
  }
}

fn no_atom() -> Atom = { effect: b"", resource: RSingleton, mode: MRead, op: None }

/// What a signature alone says of its counts: an atom not promised `bounded` may grow with the input,
/// and each parameter holding a function is called so unless the row variable is promised.
pub fn written_counts(
  fn_ty: Type,
  footprint: List<Atom>,
  bounded: List<Atom>,
  tail_bounded: Bool,
) -> { scaling: List<Atom>, repeats: List<Int> } / {abort.raise} =
  {
    scaling: footprint.filter(|atom: Atom| !atoms_covered(bounded, atom)),
    repeats: if tail_bounded { [] } else {
      match fn_ty {
        TyFn(f) ->
          range(0, f.params.len()).fold([], |acc: List<Int>, i: Int|
            if holds_fn(f.params.get(i)) { acc.push(i) } else { acc }),
        _ -> [],
      }
    },
  }

fn holds_fn(t: Type) -> Bool =
  match t {
    TyFn(_) -> true,
    TyCon(c) -> c.args.fold(false, |b: Bool, x: Type| b || holds_fn(x)),
    TyRecord(fs) -> fs.fold(false, |b: Bool, field: Field| b || holds_fn(field.ty)),
    TyNominal(n) -> n.fields.fold(false, |b: Bool, field: Field| b || holds_fn(field.ty)),
    TyVar(_) -> false,
  }

/// Where the promise breaks: the operation, and the iteration that repeats it, which is the call
/// itself when the callee iterates.
fn broken_promise(
  checker: Checker,
  what: Bytes,
  site: PerformSite,
  recursed: Option<Span>,
) -> Checker / {abort.raise} = {
  let again = site.over != None && site.over == recursed;
  let here = if again { b"performed here, and again at each call back into its own group" }
  else if site.over != Some(site.span) { b"performed here" } else {
    match site.source {
      PerformVia(name) ->
        Bytes::concat_all([
          backticked_text(simple_name_of(name)),
          b" performs it once per element of its input",
        ]),
      _ -> b"performed once for each element this iterates over",
    }
  };
  let iteration = match site.over {
    Some(o) -> if o == site.span || again { [] }
    else { [label_at(site.module, o, false, b"once for each element this iterates over")] },
    None -> [],
  };
  err_labels(
    checker,
    b"E0465",
    Bytes::concat_all([
      what,
      if what.ends_with(b"operations") {
        b" grow with the input, and the signature promises them `bounded`"
      } else { b" grows with the input, and the signature promises it `bounded`" },
    ]),
    [label_at(site.module, site.span, true, here)].concat(iteration),
    [
      b"a `bounded` operation runs a number of times no input decides",
      b"batch the operation over the whole input into one, or move it out of the iteration",
    ],
  )
}

type Offence = { atom: Atom, site: Option<PerformSite> }

/// Each inferred atom the written row does not cover, with the first site that contributed it.
fn offences(checker: Checker, dec: List<Atom>, inf: List<Atom>) -> List<Offence> / {abort.raise} =
  inf.fold([], |acc: List<Offence>, atom: Atom|
    if atoms_covered(dec, atom) { acc }
    else { acc.push({ atom: atom, site: site_for(checker, atom) }) })

/// The written atoms of the same effect and resource as `a`.
fn named_for(dec: List<Atom>, a: Atom) -> List<Atom> =
  dec.filter(|d: Atom| d.effect == a.effect && d.resource == a.resource)

/// A mode atom reached through a call, where the row names operations of its effect: the callee may perform any of them.
fn narrowed_site(dec: List<Atom>, site: PerformSite) -> Bool =
  !is_direct(site)
    && (match site.atom.op { None -> named_for(dec, site.atom).len() > 0, Some(_) -> false })

fn site_label(dec: List<Atom>, site: PerformSite) -> Bytes / {abort.raise} = {
  let a = atom_text(site.atom);
  let through = match site.source {
    PerformVia(name) -> backticked_text(simple_name_of(name)),
    OpaquePerform -> b"a function value",
    _ -> b"its arguments",
  };
  match site.source {
    DirectPerform -> Bytes::concat_all([b"performs `", a, b"`"]),
    PerformThroughArgs -> Bytes::concat_all([b"reaches `", a, b"`"]),
    _ -> if narrowed_site(dec, site) {
      Bytes::concat_all([
        b"reaches `",
        a,
        b"` through ",
        through,
        b", which may perform any of its operations; this row names only ",
        backticked(named_for(dec, site.atom).map(atom_text), b", "),
      ])
    } else { Bytes::concat_all([b"reaches `", a, b"` through ", through]) },
  }
}

fn narrowed_by_row(dec: List<Atom>, o: Offence) -> Bool =
  match o.site { Some(s) -> narrowed_site(dec, s), None -> false }

fn atom_written(checker: Checker, atom: Atom) -> Bytes / {abort.raise} =
  if is_diverges(atom) { b"diverges" } else {
    Bytes::concat_all([
      as_written(checker, atom.effect),
      b".",
      match atom.op { Some(op) -> op, None -> mode_text(atom.mode) },
      resource_text(atom.resource),
    ])
  }

/// Where an atom joins a written row: before `}`, after `{` when a tail follows, or braces around a
/// bare variable, its `bounded` inside them.
fn row_edit(checker: Checker, row: RowExpr, text: Bytes) -> Edit =
  match row.tail {
    None ->
      insertion(checker.module, row.span.end - 1, if row.atoms.len() + row.aliases.len() == 0 {
        text
      } else { b", ".concat(text) }),
    Some(t) -> if t.span.start == row.span.start {
      {
        module: checker.module,
        start: row.span.start,
        end: row.span.end,
        text: Bytes::concat_all([
          b"{",
          text,
          b" | ",
          t.name,
          if row.tail_bounded { b" bounded" } else { b"" },
          b"}",
        ]),
      }
    } else { insertion(checker.module, row.span.start + 1, text.concat(b", ")) },
  }

fn check_upper_bound(
  checker: Checker,
  def: FnDef,
  declared: Row,
  inferred: Row,
) -> Checker / {abort.raise} =
  match def.effects {
    None -> match def.baked {
      Some(at) -> check_const_row(checker, def, at, inferred),
      None -> check_unwritten(checker, def, inferred),
    },
    Some(_) -> match schema_of(checker.modules.get(checker.module).module, def) {
      None -> check_written(checker, def, declared, inferred),
      // A schema's guard and body are a law's: what they may not perform is said as it is of one.
      Some(schema) -> {
        let row = resolve_row_in(checker, inferred);
        check_written(
          check_spec_purity(
            checker,
            if def.name.name == schema.name.name { InSchemaBody } else { InWhere },
            [],
            expr_span(def.body),
            { atoms: row.atoms, tail: None },
          ),
          def,
          declared,
          { atoms: [], tail: row.tail },
        )
      },
    },
  }

/// The name a forwarded row variable is written under: the signature's own row parameter.
fn row_param_named(checker: Checker, v: Int) -> Option<Bytes> =
  checker.row_params.fold(None, |found: Option<Bytes>, name: Bytes, w: Int|
    match found { Some(_) -> found, None -> if w == v { Some(name) } else { None } })

/// A set this module can name, as it names it, and the atoms it stands for.
type Nameable = { name: Bytes, atoms: List<Atom> }

/// The atoms of `owner`'s set `name`, resolved where they were written; none when one does not resolve.
fn set_atoms_of(checker: Checker, owner: Int, name: Bytes) -> Option<List<Atom>> / {abort.raise} =
  match checker.modules.at(owner) {
    None -> None,
    Some(md) ->
      md.module.items.fold(None, |found: Option<List<Atom>>, item: Item|
        match found {
          Some(_) -> found,
          None -> match item {
            IEffectSet(d) -> if d.name.name == name {
              let there: Checker = {
                ..checker,
                module: owner,
                label_params: Map::new(),
                diags: [],
              };
              Option::traverse(d.expansion, |a: AtomExpr| conv_atom(there, a).atom)
            } else { None },
            _ -> None,
          },
        }),
  }

/// Every set this module names: its own and those it imports by name, then those of each module it
/// imports, through the binder.
fn nameable_sets(checker: Checker) -> List<Nameable> / {abort.raise} = {
  let scope = scope_of(checker);
  let bound = scope.bound.sets.fold([], |acc: List<Nameable>, b: Binding|
    match set_atoms_of(checker, b.owner, b.name) {
      Some(xs) -> acc.push({ name: b.name, atoms: xs }),
      None -> acc,
    });
  scope.modules.filter(written_binder).fold(bound, |acc: List<Nameable>, mb: ModuleBinding|
    checker.resolved.declarations.get(mb.target).sets.fold(
      acc,
      |a: List<Nameable>, declared: Declared|
        if !declared.public { a } else {
          match set_atoms_of(checker, mb.target, declared.name) {
            Some(xs) ->
              a.push({ name: Bytes::concat_all([mb.binder, b"::", declared.name]), atoms: xs }),
            None -> a,
          }
        },
    ))
}

fn set_before(a: Nameable, b: Nameable) -> Bool =
  a.atoms.len() > b.atoms.len()
    || (a.atoms.len() == b.atoms.len()
    && (match compare(a.name, b.name) { Less -> true, _ -> false }))

/// The sets a written row can name in place of `atoms`: each set every atom of which the row holds,
/// the largest first, and one only when it holds an atom no earlier one does; and the atoms nothing
/// else written covers.
fn folded(
  checker: Checker,
  atoms: List<Atom>,
) -> { sets: List<Bytes>, rest: List<Atom> } / {abort.raise} = {
  let fits = nameable_sets(checker).filter(|c: Nameable|
    c.atoms.len() > 0 && c.atoms.fold(true, |all: Bool, a: Atom| all && atoms.contains(a)));
  let sorted = fits.fold([], |acc: List<Nameable>, c: Nameable| {
    let n = acc.len();
    let i = range(0, n).fold(n, |found: Int, j: Int|
      if found < n { found } else if set_before(c, acc.get(j)) { j } else { found });
    range(i, n).fold(acc.take(i).push(c), |out: List<Nameable>, j: Int| out.push(acc.get(j)))
  });
  let picked = sorted.fold(
    { sets: [], covered: [] },
    |acc: { sets: List<Bytes>, covered: List<Atom> }, c: Nameable|
      if c.atoms.fold(true, |all: Bool, a: Atom| all && atoms_covered(acc.covered, a)) { acc }
      else { { sets: acc.sets.push(c.name), covered: acc.covered.concat(c.atoms) } },
  );
  let rest = atoms.filter(|a: Atom| !atoms_covered(picked.covered, a));
  {
    sets: picked.sets,
    rest: rest.filter(|a: Atom|
      !rest.fold(false, |hit: Bool, x: Atom| hit || (x != a && atom_covers(x, a)))),
  }
}

fn const_refused(
  checker: Checker,
  def: FnDef,
  at: Span,
  what: Bytes,
  primary: Label,
  notes: List<Bytes>,
) -> Checker =
  err_labels(
    checker,
    b"E0156",
    Bytes::concat_all([b"`", def.name.name, b"` is `const`, and ", what]),
    [primary, label_at(checker.module, at, false, b"a build evaluates this and keeps its value")],
    notes,
  )

/// What a build can evaluate once and keep as data: a definition nothing is handed to, that writes
/// no row, and answers no function, `Cell`, `Task`, `Chan` or `Secret`.
fn check_const_shape(
  checker: Checker,
  def: FnDef,
  at: Span,
  sig: Signature,
) -> Checker / {abort.raise} = {
  let handed = [
    b"a build evaluates a `const fn` once, before any call of it, so nothing can be handed to it",
  ];
  let binders = def.generics.types.concat(def.generics.labels).concat(def.generics.effects);
  let bound: Checker = match binders.at(0) {
    None -> checker,
    Some(b) ->
      const_refused(
        checker,
        def,
        at,
        b"binds a parameter of its own",
        label_at(checker.module, b.span, true, b"a `const fn` binds no type, label or row"),
        handed,
      ),
  };
  let taken: Checker = match def.params.at(0) {
    None -> bound,
    Some(p) ->
      const_refused(
        bound,
        def,
        at,
        b"takes a parameter",
        label_at(bound.module, p.span, true, b"a `const fn` takes none"),
        handed,
      ),
  };
  let rowed: Checker = match def.effects {
    None -> taken,
    Some(r) ->
      const_refused(
        taken,
        def,
        at,
        b"writes a row",
        label_at(taken.module, r.span, true, b"a `const fn` writes none"),
        [
          b"a `const fn` performs nothing: what its body could raise, the build that evaluates it sees it not raise",
        ],
      ),
  };
  // A type parameter is refused above; the type it leaves open says nothing more.
  match derivable(DBin, resolve(rowed, sig.ret), algebraic_shapes(rowed), []) {
    None -> rowed,
    Some(b) -> match b.why {
      Unconstrained(_) -> rowed,
      why ->
        const_refused(
          rowed,
          def,
          at,
          b"answers a value a build cannot keep",
          label_at(
            rowed.module,
            match def.ret { Some(t) -> ty_span(t), None -> def.name.span },
            true,
            Bytes::concat_all([
              b"holds `",
              print_ty(printer_new(), b.ty).text,
              b"`, ",
              match why {
                HoldsFunction -> b"a function",
                HoldsHandle -> b"which names a location rather than a value",
                HoldsSecret -> b"a credential",
                _ -> b"which has no stored form",
              },
            ]),
          ),
          [
            b"a build keeps a `const fn`'s value as data, which a function, a `Cell`, a `Task`, a `Chan` and a `Secret` are not",
          ],
        ),
    },
  }
}

/// A build evaluates a `const fn` where nothing answers an effect: its body may raise, which the
/// build sees it not do, and performs nothing else, a call that may not return included.
fn check_const_row(
  unclosed: Checker,
  def: FnDef,
  at: Span,
  inferred: Row,
) -> Checker / {abort.raise} = {
  let checker: Checker = match resolve_row_in(unclosed, inferred).tail {
    None -> unclosed,
    Some(v) -> {
      let u = unify_row(unclosed.subst, unclosed.fresh, row_empty(), row_open(v));
      match u.error { Some(_) -> unclosed, None -> with_unified(unclosed, u) }
    },
  };
  resolve_row_in(checker, inferred).atoms.filter(|atom: Atom| !is_raise(atom.mode)).fold(
    checker,
    |c: Checker, atom: Atom| {
      let site = site_for(c, atom);
      let (module, span) = match site {
        Some(s) -> (s.module, s.span),
        None -> (c.module, expr_span(def.body)),
      };
      if is_diverges(atom) {
        const_refused(
          c,
          def,
          at,
          b"may not return",
          label_at(module, span, true, b"this call may not return"),
          [b"a build evaluates a `const fn`, so it ends: call only what ends"],
        )
      } else {
        const_refused(
          c,
          def,
          at,
          Bytes::concat_all([b"its body performs `", atom_text(atom), b"`"]),
          label_at(module, span, true, match site {
            Some(s) -> site_label([], s),
            None -> b"performed in this body",
          }),
          [
            b"a build evaluates a `const fn` before the program runs, where nothing answers an effect: its body may raise, and performs nothing else",
            b"read a file with `embed`, and handle any other effect inside the body",
          ],
        )
      }
    },
  )
}

/// With no `/` the row is empty: what the body performs or forwards is reported at once, with the
/// row that would write it, naming a set wherever the module can.
fn check_unwritten(unclosed: Checker, def: FnDef, inferred: Row) -> Checker / {abort.raise} = {
  let unclosed_row = resolve_row_in(unclosed, inferred);
  // A tail nothing constrains closes on the empty row; only a row parameter is forwarded.
  let closed: { checker: Checker, forwarded: Bool } = match unclosed_row.tail {
    None -> { checker: unclosed, forwarded: false },
    Some(v) -> {
      let u = unify_row(unclosed.subst, unclosed.fresh, row_empty(), row_open(v));
      match u.error {
        Some(_) -> { checker: unclosed, forwarded: true },
        None -> { checker: with_unified(unclosed, u), forwarded: false },
      }
    },
  };
  let checker = closed.checker;
  let closed_row = resolve_row_in(checker, inferred);
  let forwarded = closed.forwarded;
  if closed_row.atoms.len() == 0 && !forwarded { checker } else {
    let grouped = folded(checker, closed_row.atoms);
    let atoms = grouped.sets.concat(grouped.rest.map(|atom: Atom| atom_written(checker, atom)));
    let tail: Option<Bytes> = match closed_row.tail {
      None -> None,
      Some(v) -> row_param_named(checker, v),
    };
    let row = if atoms.len() == 0 { match tail { Some(name) -> name, None -> b"e" } } else {
      Bytes::concat_all([
        b"{",
        Bytes::join(atoms, b", "),
        match tail { Some(name) -> b" | ".concat(name), None -> b"" },
        b"}",
      ])
    };
    let sites = offences(checker, [], closed_row.atoms).fold([], |acc: List<Label>, o: Offence|
      match o.site {
        Some(s) -> acc.push(label_at(s.module, s.span, true, site_label([], s))),
        None -> acc,
      });
    let primaries = if sites.len() == 0 {
      [
        label_at(
          checker.module,
          expr_span(def.body),
          true,
          b"body has row ".concat(row_text(closed_row)),
        ),
      ]
    } else { sites };
    let d: Diag = error_with_labels(
      b"E0302",
      Bytes::concat_all([
        b"`",
        def.name.name,
        b"` writes no `/`, so its row is empty, and its body ",
        if forwarded && atoms.len() == 0 { b"forwards a row" } else { b"performs effects" },
      ]),
      primaries.push(
        label_at(checker.module, def.name.span, false, b"no `/` written: the row is empty"),
      ),
      [
        if closed_row.atoms.len() > 0 && closed_row.tail == None
            && closed_row.atoms.fold(true, |all: Bool, a: Atom| all && is_diverges(a)) {
          Bytes::concat_all([
            b"a call that may not return makes `",
            def.name.name,
            b"` one too: write `/ ",
            row,
            b"` after the return type, or call only what ends",
          ])
        } else {
          Bytes::concat_all([
            b"a function performs only what its signature writes: write `/ ",
            row,
            b"` after the return type, or handle the effects inside `",
            def.name.name,
            b"`",
          ])
        },
      ],
    );
    let nameable = grouped.rest.fold(true, |all: Bool, atom: Atom|
      all && written_as(checker, atom.effect) != None);
    let fixable = nameable && (!forwarded || tail != None);
    let fixed: Diag = match def.ret {
      Some(t) -> if fixable {
        with_fix(d, Bytes::concat_all([b"write the row `/ ", row, b"`"]), [
          insertion(checker.module, ty_span(t).end, b" / ".concat(row)),
        ])
      } else { d },
      None -> d,
    };
    report(checker, fixed)
  }
}

/// A bound on the steps a call takes says the call ends, which a row writing `diverges` denies; and
/// a bound on its steps or its space is read from the body, which a handler of anything but a raise
/// could change. A row variable is what a function parameter performs, whose steps its cost name
/// stands for.
fn bounded_row(checker: Checker, def: FnDef, sig: Signature) -> Checker / {abort.raise} = {
  let row = resolve_row_in(checker, sig.published_row);
  let diverges = row.atoms.fold(false, |found: Bool, a: Atom| found || is_diverges(a));
  let performs = run_needs(row.atoms).len() > 0;
  let written = match def.effects { Some(r) -> r.span, None -> def.name.span };
  def.spec.filter(|c: SpecClause| c.kind == SCost || c.kind == SSpace).fold(
    checker,
    |c: Checker, clause: SpecClause| {
      let what = if clause.kind == SCost { b"steps" } else { b"space" };
      if diverges && clause.kind == SCost {
        report(
          c,
          error_with_labels(
            b"E0468",
            Bytes::concat_all([
              b"`",
              def.name.name,
              b"` bounds its steps, and its row says it may not return",
            ]),
            [
              label_at(c.module, clause.span, true, b"this bound says every call ends"),
              label_at(c.module, written, false, b"`diverges` is written here"),
            ],
            [b"make its recursion descend and drop `diverges`, or drop the bound"],
          ),
        )
      } else if performs {
        report(
          c,
          error_with_labels(
            b"E0463",
            Bytes::concat_all([
              b"`",
              def.name.name,
              b"` bounds its ",
              what,
              b", and performs more than a raise",
            ]),
            [
              label_at(c.module, clause.span, true, b"this bound is proved from the body alone"),
              label_at(c.module, written, false, b"its row is written here"),
            ],
            [
              Bytes::concat_all([
                b"a handler could change the ",
                what,
                b" a call takes, so only a definition that performs nothing but raises states a bound",
              ]),
            ],
          ),
        )
      } else { c }
    },
  )
}

/// A definition whose own recursion is not seen to descend may not return, which its row has to say.
/// Nothing is offered to write: the fix is usually a recursion that descends.
fn unwritten_divergence(
  checker: Checker,
  def: FnDef,
  says_diverges: Bool,
  ending: Ending,
  start_of: (Bytes) -> Int / {abort.raise},
) -> Checker / {abort.raise} =
  match ending {
    Diverges(d) -> if d.through != None || says_diverges { checker } else if def.baked != None {
      const_refused(
        checker,
        def,
        match def.baked { Some(at) -> at, None -> def.name.span },
        b"may not return",
        label_at(
          checker.module,
          span_between(
            start_of(d.at.caller) + d.at.span.start,
            start_of(d.at.caller) + d.at.span.end,
          ),
          true,
          b"this call back into its group is not seen to descend",
        ),
        [b"a build evaluates a `const fn`, so it ends: call only what ends"],
      )
    } else {
      report(
        checker,
        error_with_labels(
          b"E0302",
          Bytes::concat_all([
            b"`",
            def.name.name,
            b"` may not return, and its row does not say so",
          ]),
          [
            label_at(
              checker.module,
              span_between(
                start_of(d.at.caller) + d.at.span.start,
                start_of(d.at.caller) + d.at.span.end,
              ),
              true,
              if d.loop.len() > 0 { b"this call back into its group is not seen to descend" }
              else { b"this recursion is past what the termination check follows" },
            ),
            label_at(
              checker.module,
              match def.effects { Some(r) -> r.span, None -> def.name.span },
              false,
              b"no `diverges` written",
            ),
          ],
          [
            b"a call back into the group descends when it hands on a part of an argument, or an `Int` moved toward a bound a guard on the way holds it beyond",
            b"a loop with no such measure can spend a budget, with `iterate`, or state a `decreases` a proof shows falls",
            b"write `diverges` in the row only of a loop that waits on something outside, such as a stream or a peer",
          ],
        ),
      )
    },
    _ -> checker,
  }

fn check_written(
  checker: Checker,
  def: FnDef,
  declared: Row,
  inferred: Row,
) -> Checker / {abort.raise} = {
  let ann_span = match def.effects { Some(r) -> r.span, None -> def.span };
  let inf = resolve_row_in(checker, inferred);
  let dec = resolve_row_in(checker, declared);
  let extra = offences(checker, dec.atoms, inf.atoms);
  let c1: Checker = if extra.len() == 0 { checker } else {
    let names = backticked(extra.map(|o: Offence| atom_text(o.atom)), b", ");
    let sites = extra.fold([], |acc: List<Label>, o: Offence|
      match o.site {
        Some(s) -> acc.push(label_at(s.module, s.span, true, site_label(dec.atoms, s))),
        None -> acc,
      });
    let primaries = if sites.len() == 0 {
      [
        label_at(
          checker.module,
          expr_span(def.body),
          true,
          b"this body performs more than it declares",
        ),
      ]
    } else { sites };
    let notes = if extra.fold(true, |all: Bool, o: Offence| all && is_diverges(o.atom)) {
      [
        Bytes::concat_all([
          b"a call that may not return makes `",
          def.name.name,
          b"` one too: add `diverges` to its row, or call only what ends",
        ]),
      ]
    } else {
      [
        Bytes::concat_all([
          b"add ",
          names,
          b" to the `/ {..}` annotation, or handle ",
          if extra.len() == 1 { b"it" } else { b"them" },
          b" inside `",
          def.name.name,
          b"`",
        ]),
      ]
    };
    let narrowed = extra.fold(false, |acc: Bool, o: Offence| acc || narrowed_by_row(dec.atoms, o));
    let d: Diag = error_with_labels(
      b"E0302",
      Bytes::concat_all([
        b"effect",
        plural(extra.len()),
        b" not permitted by the signature of `",
        def.name.name,
        b"`: ",
        names,
      ]),
      primaries.push(
        label_at(checker.module, ann_span, false, b"declared row is ".concat(row_text(dec))),
      ),
      if narrowed {
        notes.push(
          b"a row that names operations permits a call only when the callee's row names them too: widen this row to the mode atom, or narrow the callee's row",
        )
      } else { notes },
    );
    // An atom this module cannot name has no text that would parse, so it gets no fix.
    let fixed: Diag = match def.effects {
      Some(r) ->
        extra.fold(d, |acc: Diag, o: Offence|
          if written_as(checker, o.atom.effect) == None { acc } else {
            let text = atom_written(checker, o.atom);
            with_fix(acc, Bytes::concat_all([b"add `", text, b"` to the row"]), [
              row_edit(checker, r, text),
            ])
          }),
      None -> d,
    };
    report(checker, fixed)
  };
  match inf.tail {
    None -> c1,
    Some(v) -> if dec.tail == Some(v) { c1 } else {
      let u = unify_row(c1.subst, c1.fresh, { atoms: [], tail: dec.tail }, row_open(v));
      let c2: Checker = with_unified(c1, u);
      match u.error {
        Some(_) ->
          err_labels(
            c2,
            b"E0302",
            Bytes::concat_all([
              b"the signature of `",
              def.name.name,
              b"` does not permit the effects its body forwards",
            ]),
            [
              label_at(
                c2.module,
                expr_span(def.body),
                true,
                b"body has row ".concat(row_text(inf)),
              ),
              label_at(c2.module, ann_span, false, b"declared row cannot absorb it"),
            ],
            [b"add the missing effect variable to the generic list, or widen the annotation"],
          ),
        None -> c2,
      }
    },
  }
}

fn settle_numerics(checker: Checker) -> Checker / {abort.raise} = {
  let entries = checker.numerics;
  entries.fold({ ..checker, numerics: [] }, |c: Checker, entry: Numeric| {
    let ty = resolve(c, entry.ty);
    let what = if is_ordered(entry.op) { b"ordered comparison" } else { b"arithmetic" };
    match ty {
      TyVar(v) -> match c.witnessed.get(v) {
        Some(w) -> if (entry.op == b"div" || entry.op == b"rem") && !w.integer {
          report_error_at(
            c,
            b"E0209",
            entry.span,
            Bytes::concat_all([
              b"`",
              op_text(entry.op),
              b"` is not defined on every `numeric` type, so not on `",
              w.param,
              b"`",
            ]),
            if entry.op == b"div" { b"divided here" } else { b"the remainder taken here" },
            [
              Bytes::concat_all([
                b"`integer(",
                w.param,
                b")` admits `/` and `%`; a `Decimal` has no `/`, since its exact quotient is not a decimal, and a type that states its own arithmetic has neither",
              ]),
            ],
          )
        } else { c },
        None ->
          report_error_at(
            c,
            b"E0210",
            entry.span,
            Bytes::concat_all([b"the numeric type of this ", what, b" is not determined"]),
            b"nothing here says which numeric type this is",
            [
              b"the numeric types are `Int`, the eight fixed-width integers, `Float` and `Decimal`, and there is no tower",
              b"annotate the operand, or write a literal that pins it (`1`, `1.0`, `1m`)",
              b"a type parameter takes arithmetic under `where numeric(a)`, and `/`, `%` and the bit operators under `where integer(a)`",
            ],
          ),
      },
      TyCon(k) -> if k.args.len() != 0 { numeric_mismatch(c, entry, ty, what) }
      else if is_int_name(k.name) || k.name == b"Float" { c }
      // Characters order by scalar value, which is what a range test such as `c >= 'a'` reads.
      else if k.name == b"Char" && is_ordered(entry.op) { c } else if k.name == b"Decimal" {
        if entry.op == b"div" {
          report_error_at(
            c,
            b"E0209",
            entry.span,
            b"`/` is not defined on `Decimal`",
            b"the exact quotient of two decimals is not a decimal",
            [
              b"an operator would have to round, and a rounding nobody wrote down is the defect `Decimal` exists to prevent",
              b"call `Decimal::div(a, b, 2, HalfEven)` and say how to round",
            ],
          )
        } else { c }
      } else {
        match numeric_of(c.numeric_types, k.name) {
          Some(_) -> stated_operator(c, entry, ty, k.name),
          None -> numeric_mismatch(c, entry, ty, what),
        }
      },
      _ -> numeric_mismatch(c, entry, ty, what),
    }
  })
}

fn numeric_of(stated: List<NumericInfo>, type_name: Bytes) -> Option<NumericInfo> =
  stated.fold(None, |acc: Option<NumericInfo>, x: NumericInfo|
    match acc { Some(_) -> acc, None -> if x.type_name == type_name { Some(x) } else { None } })

/// An operator at a type that states `numeric`: `+`, `-` and `*` are its functions, the ordered
/// comparisons its `key`'s where it states one, and `/` and `%` are no operator of it.
fn stated_operator(
  checker: Checker,
  entry: Numeric,
  ty: Type,
  type_name: Bytes,
) -> Checker / {abort.raise} =
  if entry.op == b"add" || entry.op == b"sub" || entry.op == b"mul" || entry.op == b"neg" {
    checker
  } else if is_ordered(entry.op) {
    if checker.keyed_names.contains(type_name) { checker } else {
      report_error_at(
        checker,
        b"E0201",
        entry.span,
        Bytes::concat_all([b"`", op_text(entry.op), b"` is not defined on `", type_text(ty), b"`"]),
        b"ordered comparison here",
        [
          Bytes::concat_all([
            b"`",
            simple_name_of(type_name),
            b"` states `numeric` and no `key`, and a type is ordered by its `key`",
          ]),
        ],
      )
    }
  } else {
    report_error_at(
      checker,
      b"E0201",
      entry.span,
      Bytes::concat_all([b"`", op_text(entry.op), b"` is not defined on `", type_text(ty), b"`"]),
      b"arithmetic here",
      [
        Bytes::concat_all([
          b"a type that states `numeric` takes `+`, `-`, `*` and unary `-`; `",
          op_text(entry.op),
          b"` has no answer at every pair of its values, so its module has a function for it instead",
        ]),
      ],
    )
  }

fn op_text(op: Bytes) -> Bytes =
  if op == b"add" { b"+" }
  else if op == b"sub" || op == b"neg" { b"-" }
  else if op == b"mul" { b"*" }
  else if op == b"div" { b"/" }
  else if op == b"rem" { b"%" }
  else if op == b"lt" { b"<" }
  else if op == b"le" { b"<=" }
  else if op == b"gt" { b">" }
  else if op == b"ge" { b">=" }
  else { op }

fn numeric_mismatch(
  checker: Checker,
  entry: Numeric,
  ty: Type,
  what: Bytes,
) -> Checker / {abort.raise} =
  report_error_at(
    checker,
    b"E0201",
    entry.span,
    Bytes::concat_all([b"`", op_text(entry.op), b"` is not defined on `", type_text(ty), b"`"]),
    what.concat(b" here"),
    [
      b"the numeric types are `Int`, the eight fixed-width integers, `Float` and `Decimal`, and a type whose module states `numeric` for it takes `+`, `-` and `*`",
    ],
  )

/// The resolved type, rendered, when the signature's generics bind every variable in it, so the author can paste it.
fn writable(checker: Checker, signature: Signature, t: Type) -> Option<Bytes> / {abort.raise} = {
  let resolved = resolve(checker, t);
  let bound = signature.ty_params.fold([], |acc: List<Int>, k: Bytes, p: Type|
    match resolve(checker, p) { TyVar(v) -> acc.push(v), _ -> acc });
  let found = free_vars(subst_new(), resolved, { tys: [], rows: [] }).tys;
  if found.fold(false, |b: Bool, v: Int| b || !bound.contains(v)) { None }
  else { Some(type_text(resolved)) }
}

fn require_written_signature(
  checker: Checker,
  def: FnDef,
  signature: Signature,
) -> Checker / {abort.raise} = {
  let why = b"a signature is a claim about what a definition means, so it is written rather than inferred; the effect row is the exception and stays inferred";
  let params = range(0, def.params.len()).fold(checker, |c: Checker, i: Int| {
    let p = def.params.get(i);
    match p.ty {
      Some(_) -> c,
      None -> {
        let label = match writable(c, signature, signature.params.get(i)) {
          Some(shown) -> Bytes::concat_all([b"write `", p.name.name, b": ", shown, b"`"]),
          None -> b"write a type here",
        };
        report_error_at(
          c,
          b"E0126",
          p.span,
          Bytes::concat_all([b"parameter `", p.name.name, b"` has no written type"]),
          label,
          [why],
        )
      },
    }
  });
  match def.ret {
    Some(_) -> params,
    None -> {
      let label = match writable(params, signature, signature.ret) {
        Some(shown) -> Bytes::concat_all([b"write `-> ", shown, b"`"]),
        None -> b"write a return type here",
      };
      report_error_at(
        params,
        b"E0126",
        def.name.span,
        Bytes::concat_all([b"`", def.name.name, b"` has no written return type"]),
        label,
        [why],
      )
    },
  }
}

fn close_unreachable_row(checker: Checker, signature: Signature) -> Checker / {abort.raise} =
  match resolve(checker, signature.fn_ty) {
    TyFn(f) -> match f.effects.tail {
      None -> checker,
      Some(tail) -> if is_rigid_row(checker.subst, tail) { checker } else {
        let fv = f.params.fold({ tys: [], rows: [] }, |acc: Free, ty: Type|
          free_vars(checker.subst, ty, acc));
        let all = free_vars(checker.subst, f.ret, fv);
        if all.rows.contains(tail) { checker } else {
          let u = unify_row(checker.subst, checker.fresh, row_empty(), row_open(tail));
          with_unified(checker, u)
        }
      },
    },
    _ -> checker,
  }

// --- Tests and laws --------------------------------------------------------------------------------

/// A cached footprint carries the determinism verdict: an effect's `nondet` marker is part of its declaration's hash.
/// The first of `labels` named `name`, where one is.
fn labelled(labels: List<{ name: Bytes, span: Span }>, name: Bytes) -> Option<Span> =
  labels.fold(None, |span: Option<Span>, l: { name: Bytes, span: Span }|
    match span { Some(_) -> span, None -> if l.name == name { Some(l.span) } else { None } })

fn check_tests(checker: Checker, parsed: ParsedModule) -> Checker / {abort.raise} = {
  let walked = parsed.module.items.fold(
    { checker: checker, labels: [] },
    |acc: { checker: Checker, labels: List<{ name: Bytes, span: Span }> }, item: Item|
      match item {
        ITest(def) -> {
          let seen: Checker = match labelled(acc.labels, def.name) {
            None -> acc.checker,
            Some(first) ->
              report_error_at_and(
                acc.checker,
                b"E0105",
                def.name_span,
                Bytes::concat_all([b"two tests are labelled ", debug_quoted(def.name)]),
                b"relabelled here",
                { module: acc.checker.module, span: first },
                b"first labelled here",
                [
                  b"a test is keyed `<module>.<label>`, so one label names one test; a test over cases that shares another's body and case type can range over both tables at once",
                ],
              ),
          };
          let c: Checker = { ..seen, scope: seen.scope + 1 };
          let owner = test_owner(parsed.name, def.name);
          let footprint: WithAtoms = match c.known.tests.get(qualify(parsed.name, def.name)) {
            Some(cached) ->
              {
                checker: {
                  ..c,
                  seeded_tests: c.seeded_tests.push(qualify(parsed.name, def.name)),
                  kept: c.kept.push({ name: owner, facts: cached.facts }),
                },
                atoms: settled_row(c, cached.footprint).atoms,
              },
            None -> {
              let c1: Checker = {
                ..c,
                ty_params: Map::new(),
                row_params: Map::new(),
                label_params: Map::new(),
                performs: [],
                declared_atoms: [],
                guards: guards::none(),
                raise_notes: [],
                walking: owner,
              };
              let pushed: Checker = { ..c1, env: env_push(c1.env) };
              let entered: Checker = match def.cases {
                None -> pushed,
                Some(_) ->
                  {
                    ..pushed,
                    env: env_bind(
                      env_bind(pushed.env, case_at(), monomorphic(int_type())),
                      case_identity(),
                      monomorphic(bytes_type()),
                    ),
                  },
              };
              let o: Inferred = infer_whole(entered, test_run(def), hint_of(unit_type()));
              let answered: Checker = check_test_answer(o.checker, def, o.ty);
              let listed: Checker = match def.cases {
                None -> answered,
                Some(cases) -> check_listing(answered, def, cases),
              };
              let popped: Checker = { ..listed, env: env_pop(listed.env) };
              let row = leaving_row(resolve_row_in(popped, o.row));
              // A table refused for what it performs is not also held to the test's determinism.
              let unlisted = listed.diags.len() > answered.diags.len();
              {
                checker: if def.is_nondet || unlisted { popped }
                else { check_determinism(popped, def, row.atoms) },
                atoms: run_needs(row.atoms),
              }
            },
          };
          let checked: Checker = footprint.checker;
          {
            checker: {
              ..checked,
              tests: checked.tests.push({
                name: def.name,
                module: parsed.name,
                key: qualify(parsed.name, def.name),
                index: checked.tests.len(),
                nondet: def.is_nondet,
                cases: def.cases != None,
                footprint: footprint.atoms,
                at: location_of(checked, def.span),
              }),
              walking: b"",
            },
            labels: acc.labels.push({ name: def.name, span: def.name_span }),
          }
        },
        _ -> acc,
      },
  );
  walked.checker
}

fn check_test_answer(checker: Checker, def: TestDef, ty: Type) -> Checker / {abort.raise} = {
  let u = unify(checker.subst, checker.fresh, unit_type(), ty);
  let c = with_unified(checker, u);
  match u.error {
    None -> c,
    Some(_) -> {
      let span = expr_span(tail_value(def.body));
      let found = resolve(c, ty);
      let shown = print_ty(printer_new(), found).text;
      let d = error_at(
        b"E0201",
        c.module,
        span,
        Bytes::concat_all([b"type mismatch: the body of test `", def.name, b"`"]),
        Bytes::concat_all([b"expected `Unit`, found `", shown, b"`"]),
        [b"a test passes when its body finishes, so a value it ends on is never read"],
      );
      report(c, if found == bool_type() {
        with_fix(d, b"wrap it in `assert`", [
          insertion(c.module, span.start, b"assert("),
          insertion(c.module, span.end, b")"),
        ])
      } else { with_fix(d, b"end the body with `()`", [insertion(c.module, span.end, b"; ()")]) })
    },
  }
}

fn tail_value(expr: Expr) -> Expr =
  match expr { EBlock(b) -> match b.tail { Some(t) -> tail_value(t), None -> expr }, _ -> expr }

/// A test's cases are listed before any of them runs, where nothing answers an effect: the table
/// and the label may raise, and perform nothing else.
fn check_listing(checker: Checker, def: TestDef, cases: Cases) -> Checker / {abort.raise} = {
  let o: Inferred = infer_whole(checker, test_listing(cases), hint_of(listing_ty()));
  let c = o.checker;
  match run_needs(resolve_row_in(c, o.row).atoms).at(0) {
    None -> c,
    Some(atom) ->
      err_labels(
        c,
        b"E0469",
        Bytes::concat_all([
          b"the cases of test `",
          def.name,
          b"` perform `",
          atom_text(atom),
          b"`",
        ]),
        [
          label_at(
            c.module,
            match site_for(c, atom) { Some(s) -> s.span, None -> expr_span(cases.table) },
            true,
            b"performed while the cases are listed",
          ),
        ],
        [
          b"a test's cases are listed before any test runs, to decide which of them run: its table and its label may raise, and perform nothing else",
          b"handle the effect inside the table, or build the table from what `embed_dir` read",
        ],
      ),
  }
}

type WithAtoms = { checker: Checker, atoms: List<Atom> }

fn check_determinism(
  checker: Checker,
  def: TestDef,
  footprint: List<Atom>,
) -> Checker / {abort.raise} =
  footprint.fold(checker, |c: Checker, atom: Atom|
    match effect_of(c, atom.effect) {
      None -> c,
      Some(info) -> if !info.nondet { c } else {
        let site = site_for(c, atom);
        let (span, direct) = match site {
          Some(s) -> (s.span, is_direct(s)),
          None -> (expr_span(def.body), false),
        };
        let a = atom_text(atom);
        let remedy = if simulated_names().contains(atom.effect) {
          b"handle it here, e.g. `simulate { <body> }`"
        } else {
          Bytes::concat_all([
            b"handle it here, e.g. `handle <body> with { ",
            example_clause(c, info, atom),
            b" }`",
          ])
        };
        let indirect = if direct { [] } else {
          [Bytes::concat_all([b"`", a, b"` is performed inside something this expression calls"])]
        };
        err_labels(
          c,
          b"E0412",
          b"nondeterministic effect in a deterministic test",
          [
            label_at(
              c.module,
              span,
              true,
              Bytes::concat_all([
                if direct { b"performs `" } else { b"reaches `" },
                a,
                b"`, and `",
                atom.effect,
                b"` is declared `nondet`",
              ]),
            ),
            label_at(
              c.module,
              def.name_span,
              false,
              Bytes::concat_all([b"test `", def.name, b"` is deterministic"]),
            ),
          ],
          indirect.concat([
            remedy,
            b"or declare this `test/nondet`, which opts out of the cache and re-runs every time",
          ]),
        )
      },
    })

/// A clause the reader could paste, for the operation the atom names.
fn example_clause(checker: Checker, info: EffectInfo, atom: Atom) -> Bytes / {abort.raise} = {
  let written = as_written(checker, info.name);
  let named = match atom.resource {
    RNamed(_) -> true,
    RVar(_) -> true,
    RSingleton -> false,
    RAny -> true,
  };
  let first = |ok: (OpInfo) -> Bool|
    info.ops.fold(None, |acc: Option<OpInfo>, o: OpInfo|
      match acc { Some(_) -> acc, None -> if ok(o) { Some(o) } else { None } });
  let op = match atom.op {
    Some(name) -> op_named(info, name),
    None -> match first(|o: OpInfo| mode_eq(o.mode, atom.mode) && named == o.resource_param) {
      Some(o) -> Some(o),
      None -> match first(|o: OpInfo| mode_eq(o.mode, atom.mode)) {
        Some(o) -> Some(o),
        None -> info.ops.at(0),
      },
    },
  };
  match op {
    Some(o) -> {
      let resource = if o.resource_param { resource_text(atom.resource) } else { b"" };
      let args = Bytes::join(
        range(0, o.params.len()).map(|i: Int| b"a".concat(ascii_of_int(i))),
        b", ",
      );
      Bytes::concat_all([written, b".", o.name, resource, b"(", args, b") -> <value>"])
    },
    None -> written.concat(b".<op>() -> <value>"),
  }
}

fn check_laws(checker: Checker, parsed: ParsedModule) -> Checker / {abort.raise} = {
  let walked = parsed.module.items.fold(
    { checker: checker, labels: [] },
    |acc: { checker: Checker, labels: List<{ name: Bytes, span: Span }> }, item: Item|
      match item {
        ILaw(def) -> {
          let c: Checker = { ..acc.checker, scope: acc.checker.scope + 1 };
          match labelled(acc.labels, def.name) {
            Some(first) ->
              {
                ..acc,
                checker: report_error_at_and(
                  c,
                  b"E0105",
                  def.name_span,
                  Bytes::concat_all([b"two laws are labelled ", debug_quoted(def.name)]),
                  b"relabelled here",
                  { module: c.module, span: first },
                  b"first labelled here",
                  [b"a law is keyed `<module>.<label>`, so one label names one claim"],
                ),
              },
            None ->
              {
                checker: check_law(c, parsed, def),
                labels: acc.labels.push({ name: def.name, span: def.name_span }),
              },
          }
        },
        _ -> acc,
      },
  );
  walked.checker
}

/// `{:?}` over a label: quoted, with `"` and `\` escaped.
fn debug_quoted(s: Bytes) -> Bytes =
  Bytes::concat_all([
    b"\"",
    Bytes::concat_all(
      range(0, s.len()).map(|i: Int| {
        let c = s.at(i);
        if c == 34 { b"\\\"" }
        else if c == 92 { b"\\\\" }
        else if c == 10 { b"\\n" }
        else if c == 9 { b"\\t" }
        else { s.slice(i, i + 1) }
      }),
    ),
    b"\"",
  ])

fn check_law(outer: Checker, parsed: ParsedModule, def: LawDef) -> Checker / {abort.raise} = {
  let checker: Checker = {
    ..outer,
    ty_params: Map::new(),
    row_params: Map::new(),
    label_params: Map::new(),
    performs: [],
    declared_atoms: [],
    guards: guards::none(),
    raise_notes: [],
    auto_ty_params: true,
  };
  let types: WithTys = def.binders.fold(
    { checker: checker, tys: [] },
    |acc: { checker: Checker, tys: List<Type> }, b: Binder| {
      // An instantiation's binders are typed by what its schema's definitions take them at.
      let o: WithTy = if def.of != None { new_ty(acc.checker) } else { law_binder(acc.checker, b) };
      { checker: o.checker, tys: acc.tys.push(o.ty) }
    },
  );
  let c1: Checker = { ..types.checker, auto_ty_params: false };
  let sorts = c1.ty_params.fold([], |acc: List<Int>, k: Bytes, ty: Type|
    match ty { TyVar(v) -> acc.push(v), _ -> acc });
  let rigid: Checker = sorts.fold(c1, |c: Checker, v: Int|
    { ..c, subst: mark_rigid_ty(c.subst, v) });
  let pushed: Checker = { ..rigid, env: env_push(rigid.env) };
  let bound: Checker = range(0, def.binders.len()).fold(pushed, |c: Checker, i: Int|
    {
      ..note_typed(c, def.binders.get(i).name.span, types.tys.get(i), []),
      env: env_bind(c.env, def.binders.get(i).name.name, monomorphic(types.tys.get(i))),
    });
  let guarded: Checker = match def.guard {
    Some(g) -> {
      let o: Inferred = infer_whole({ ..bound, performs: [] }, g);
      let c: Checker = unfilled(
        expect(
          o.checker,
          expr_span(g),
          bool_type(),
          o.ty,
          b"a `where` guard states a proposition",
        ).checker,
        def,
        o.row,
      );
      check_spec_purity(c, InWhere, [], expr_span(g), resolve_row_in(c, o.row))
    },
    None -> bound,
  };
  let body: Inferred = infer_whole({ ..guarded, performs: [] }, def.body);
  let stated: Checker = expect(
    body.checker,
    expr_span(def.body),
    bool_type(),
    body.ty,
    b"a law states a proposition",
  ).checker;
  let c2: Checker = unfilled(stated, def, body.row);
  let row = resolve_row_in(c2, body.row);
  let c3: Checker = check_spec_purity(c2, InLawBody, [seed_atom()], expr_span(def.body), row);
  let closed: Checker = { ..c3, env: env_pop(c3.env) };
  let shown = |i: Int|
    match def.of {
      Some(u) -> match u.shown.at(i) { Some(n) -> n, None -> def.binders.get(i).name.name },
      None -> def.binders.get(i).name.name,
    };
  let popped: Checker = match def.of {
    None -> closed,
    Some(u) -> if closed.diags.len() != outer.diags.len() { closed } else {
      range(0, def.binders.len()).fold(closed, |c: Checker, i: Int|
        instantiable(c, u, shown(i), resolve(c, types.tys.get(i))))
    },
  };
  let binders = range(0, def.binders.len()).map(|i: Int|
    { name: shown(i), ty: resolve(popped, types.tys.get(i)), span: def.binders.get(i).span });
  {
    ..popped,
    ty_params: Map::new(),
    row_params: Map::new(),
    laws: popped.laws.push({
      name: def.name,
      module: parsed.name,
      key: qualify(parsed.name, def.name),
      index: popped.laws.len(),
      binders: binders,
      has_guard: match def.guard { Some(_) -> true, None -> false },
      footprint: run_needs(row.atoms),
      at: location_of(popped, def.span),
    }),
  }
}

/// A schema's row parameter that nothing an instantiation gave it fills is empty there: a law
/// names no row of its own, so it states what its arguments raise and no more.
fn unfilled(checker: Checker, def: LawDef, row: Row) -> Checker / {abort.raise} =
  match ((def.of, resolve_row_in(checker, row).tail)) {
    (Some(_), Some(v)) -> {
      let u = unify_row(checker.subst, checker.fresh, row_empty(), row_open(v));
      match u.error { Some(_) -> checker, None -> with_unified(checker, u) }
    },
    _ -> checker,
  }

/// A schema's binder at the type an instantiation gives it, which the generator must inhabit as it
/// must a written binder's.
fn instantiable(
  checker: Checker,
  of: OfSchema,
  binder: Bytes,
  ty: Type,
) -> Checker / {abort.raise} =
  match ungeneratable(checker, ty) {
    None -> checker,
    Some(reason) ->
      report_error_at(
        checker,
        b"E0418",
        of.span,
        Bytes::concat_all([b"`forall` cannot quantify over `", binder, b"`"]),
        reason,
        [
          Bytes::concat_all([
            b"the schema `",
            of.schema.name.name,
            b"` binds `",
            binder,
            b"`, which is a `",
            type_text(ty),
            b"` here",
          ]),
          b"a law over a type nothing can produce is a claim nothing can ever check, so it is refused here rather than reported as a gap at discharge time",
        ],
      ),
  }

/// A schema's binders are quantified as a law's are. What else is wrong with a binder's type is said
/// of the definitions made of the schema.
fn check_schemas(outer: Checker, parsed: ParsedModule) -> Checker / {abort.raise} =
  parsed.module.items.fold(outer, |acc: Checker, item: Item|
    match item {
      ISchema(d) -> {
        let typed: Checker = d.binders.fold(
          { ..acc, ty_params: Map::new(), auto_ty_params: true },
          |c: Checker, b: Binder| law_binder(c, b).checker,
        );
        {
          ..typed,
          ty_params: acc.ty_params,
          auto_ty_params: acc.auto_ty_params,
          diags: acc.diags.concat(
            typed.diags.drop(acc.diags.len()).filter(|diag: Diag| diag.code == b"E0418"),
          ),
        }
      },
      _ -> acc,
    })

/// A binder's type must be one the generator can inhabit: no handler, written row beyond a raise,
/// `Cell`, `Task` or `Secret`.
fn law_binder(checker: Checker, binder: Binder) -> { checker: Checker, ty: Type } / {abort.raise} =
  match handler_mention(checker, binder.ty) {
    Some(span) ->
      new_ty(
        report_error_at(
          checker,
          b"E0418",
          span,
          b"`forall` cannot quantify over a handler",
          b"a handler is syntax, not a value",
          [
            b"`handle body with { .. }` is an expression form: there is no type a handler inhabits and no value for a binder to range over",
            b"a handler-parametric law would take a handler type, a `Value::Handler` and a normalization story, and what such a law could prove is too little to be worth that yet",
            b"quantify over the values the handler would answer with instead",
          ],
        ),
      ),
    None -> match written_row_reason(binder.ty) {
      Some(reason) -> new_ty(unquantifiable(checker, binder, reason)),
      None -> {
        let o: WithTy = conv_type(checker, binder.ty);
        match ungeneratable(o.checker, o.ty) {
          Some(reason) -> { checker: unquantifiable(o.checker, binder, reason), ty: o.ty },
          None -> o,
        }
      },
    },
  }

fn unquantifiable(checker: Checker, binder: Binder, reason: Bytes) -> Checker =
  report_error_at(
    checker,
    b"E0418",
    ty_span(binder.ty),
    Bytes::concat_all([b"`forall` cannot quantify over `", binder.name.name, b"`"]),
    reason,
    [
      b"a law over a type nothing can produce is a claim nothing can ever check, so it is refused here rather than reported as a gap at discharge time",
    ],
  )

/// The raw variable, not the printer's letter.
fn row_display(row: Row) -> Bytes / {abort.raise} = {
  let atoms = Bytes::join(row.atoms.map(atom_text), b", ");
  match row.tail {
    None -> Bytes::concat_all([b"{", atoms, b"}"]),
    Some(v) -> if row.atoms.len() == 0 { Bytes::concat_all([b"{| e", ascii_of_int(v), b"}"]) }
    else { Bytes::concat_all([b"{", atoms, b" | e", ascii_of_int(v), b"}"]) },
  }
}

fn handler_named(checker: Checker, name: Bytes, span: Span) -> Option<Span> / {abort.raise} = {
  let is_handler = name == b"Handler" || name == b"handler";
  let declared = match find(checker.resolved, checker.module, TypeSpace, {
      module: None,
      name: { name: name, span: span },
      span: span,
    }) {
    Some(_) -> true,
    None -> false,
  };
  if is_handler && !declared { Some(span) } else { None }
}

fn handler_mention(checker: Checker, ty: TypeExpr) -> Option<Span> / {abort.raise} =
  match ty {
    TUnit(_) -> None,
    TBad(_) -> None,
    TVar(id) -> handler_named(checker, id.name, id.span),
    TCon(c) -> {
      let own = if is_bare(c.name) { handler_named(checker, c.name.name.name, c.span) }
      else { None };
      match own { Some(_) -> own, None -> first_handler_mention(checker, c.args) }
    },
    TFn(f) -> match first_handler_mention(checker, f.params) {
      Some(s) -> Some(s),
      None -> handler_mention(checker, f.ret),
    },
    TRecord(r) ->
      r.fields.fold(None, |acc: Option<Span>, f: { name: Ident, ty: TypeExpr }|
        match acc { Some(_) -> acc, None -> handler_mention(checker, f.ty) }),
  }

fn first_handler_mention(checker: Checker, tys: List<TypeExpr>) -> Option<Span> / {abort.raise} =
  tys.fold(None, |acc: Option<Span>, ty: TypeExpr|
    match acc { Some(_) -> acc, None -> handler_mention(checker, ty) })

fn first_reason<a | e>(xs: List<a>, f: (a) -> Option<Bytes> / e) -> Option<Bytes> / e =
  xs.fold(None, |acc: Option<Bytes>, x: a| match acc { Some(_) -> acc, None -> f(x) })

fn raises(atom: AtomExpr) -> Bool = is_bare(atom.eff) && atom.eff.name.name == b"abort"

/// A function's row, or the row a declared type is given for the functions it holds.
fn law_row_reason(row: RowExpr) -> Option<Bytes> =
  match row.tail {
    Some(_) ->
      Some(
        b"an effect variable has no binder here, and a law quantifies over values rather than over rows",
      ),
    None -> match row.atoms.filter(|a: AtomExpr| !raises(a)).at(0) {
      Some(a) ->
        Some(
          Bytes::concat_all([
            b"applying this inside the body would perform `",
            qname_text(a.eff),
            b"`, and a law body is pure",
          ]),
        ),
      None -> None,
    },
  }

fn written_row_reason(ty: TypeExpr) -> Option<Bytes> =
  match ty {
    TVar(_) -> None,
    TUnit(_) -> None,
    TBad(_) -> None,
    TCon(c) -> match first_reason(c.rows, law_row_reason) {
      Some(r) -> Some(r),
      None -> first_reason(c.args, written_row_reason),
    },
    TRecord(r) ->
      first_reason(r.fields, |f: { name: Ident, ty: TypeExpr }| written_row_reason(f.ty)),
    TFn(f) -> {
      let own = match f.effects { Some(row) -> law_row_reason(row), None -> None };
      match own {
        Some(_) -> own,
        None -> match first_reason(f.params, written_row_reason) {
          Some(r) -> Some(r),
          None -> written_row_reason(f.ret),
        },
      }
    },
  }

fn ungeneratable(checker: Checker, ty: Type) -> Option<Bytes> / {abort.raise} =
  ungeneratable_within(checker, ty, [], checker.ctors.len())

/// `room` is how many more declared types the walk may enter: a path enters each one once, and each
/// has a constructor.
fn ungeneratable_within(
  checker: Checker,
  ty: Type,
  seen: List<Bytes>,
  room: Int,
) -> Option<Bytes> / {abort.raise} =
  match ty {
    TyVar(_) -> None,
    TyCon(c) -> if c.name == b"Cell" {
      Some(b"a `Cell` is created by `with_cell` and exists only inside its region")
    } else if c.name == b"Hold" {
      Some(b"a `Hold` is created by `with_hold` and exists only inside its region")
    } else if c.name == b"Task" {
      Some(b"a `Task` is a key into the scheduler of the `simulate` region that spawned it")
    } else if c.name == b"Chan" {
      Some(b"a `Chan` is a key into the scheduler of the `simulate` region that made it")
    } else if c.name == b"Secret" {
      Some(
        b"a `Secret` is a credential: quantifying over one would have the prover mint credentials and print them in counterexamples",
      )
    } else {
      match first_reason(c.args, |a: Type| ungeneratable_within(checker, a, seen, room)) {
        Some(r) -> Some(r),
        None -> if seen.contains(c.name) { None } else {
          let ctors = checker.ctors.filter(|ctor_info: CtorInfo| ctor_info.type_name == c.name);
          if ctors.len() == 0 { None }
          else if room <= 0 { panic("a type entered twice on one path") } else {
            let inner = seen.push(c.name);
            first_reason(ctors, |ctor_info: CtorInfo|
              first_reason(ctor_info.fields, |f: Type|
                ungeneratable_within(checker, f, inner, room - 1)))
          }
        },
      }
    },
    // A binder writes no row variable, so one here is a declared type's own row parameter.
    TyFn(f) -> if f.effects.tail != None {
      Some(
        b"a function a declared type holds under its row parameter is not generated, whatever row the type is given",
      )
    } else if !row_is_pure_but_raise(f.effects) {
      Some(
        Bytes::concat_all([
          b"a function with row ",
          row_display(f.effects),
          b" cannot be applied inside a pure body",
        ]),
      )
    } else {
      match first_reason(f.params, |p: Type| ungeneratable_within(checker, p, seen, room)) {
        Some(r) -> Some(r),
        None -> ungeneratable_within(checker, f.ret, seen, room),
      }
    },
    TyRecord(fs) -> first_reason(fs, |f: Field| ungeneratable_within(checker, f.ty, seen, room)),
    TyNominal(n) ->
      first_reason(n.fields, |f: Field| ungeneratable_within(checker, f.ty, seen, room)),
  }

type SpecSite =
  | InRequires
  | InEnsures
  | InCost
  | InSpace
  | SSDecreases
  | InWhere
  | InLawBody
  | InSchemaBody

fn site_phrase(s: SpecSite) -> Bytes =
  match s {
    InRequires -> b"a `requires` clause",
    InEnsures -> b"an `ensures` clause",
    InCost -> b"a `cost` bound",
    InSpace -> b"a `space` bound",
    SSDecreases -> b"a `decreases` measure",
    InWhere -> b"a `where` guard",
    InLawBody -> b"a law body",
    InSchemaBody -> b"a law schema's body",
  }

fn site_short(s: SpecSite) -> Bytes =
  match s {
    InRequires -> b"`requires`",
    InEnsures -> b"`ensures`",
    InCost -> b"`cost` bound",
    InSpace -> b"`space` bound",
    SSDecreases -> b"`decreases` measure",
    InWhere -> b"`where` guard",
    InLawBody -> b"law body",
    InSchemaBody -> b"schema body",
  }

/// Every atom past the allowed set is `E0417`, and an open row too.
fn check_spec_purity(
  checker: Checker,
  site: SpecSite,
  allowed: List<Atom>,
  body_span: Span,
  row: Row,
) -> Checker / {abort.raise} = {
  let law_body = match site { InLawBody -> true, _ -> false };
  let c1: Checker = run_needs(row.atoms).filter(|a: Atom| !atoms_covered(allowed, a)).fold(
    checker,
    |c: Checker, atom: Atom| {
      let found = site_for(c, atom);
      let (span, direct) = match found {
        Some(s) -> (s.span, is_direct(s)),
        None -> (body_span, false),
      };
      let fixed = [
        b"a claim that can perform an effect can change what it observes: an obligation that writes to the resource it judges reports the post-state it caused",
        b"and a discharge evaluates it hundreds of times, against a world nothing set up",
      ];
      let carried = allowed.fold(fixed, |acc: List<Bytes>, a: Atom|
        acc.push(
          Bytes::concat_all([
            b"a law body may carry `",
            atom_text(a),
            b"` \xe2\x80\x94 the seed a `simulate` region reads \xe2\x80\x94 and nothing else",
          ]),
        ));
      let hosted = if law_body {
        carried.push(
          b"what reaches the world is no claim a proof closes: check it in a test, under the handlers or the host it needs",
        )
      } else { carried };
      err_labels(
        c,
        b"E0417",
        site_phrase(site).concat(b" cannot perform an effect"),
        [
          label_at(
            c.module,
            span,
            true,
            Bytes::concat_all([
              if direct { b"performs `" } else { b"reaches `" },
              atom_text(atom),
              b"`",
            ]),
          ),
          label_at(
            c.module,
            body_span,
            false,
            Bytes::concat_all([b"this ", site_short(site), b" must be pure"]),
          ),
        ],
        hosted.push(
          Bytes::concat_all([
            b"compute this with a pure function, or handle `",
            atom.effect,
            b"` inside the definition and state a claim about its result",
          ]),
        ),
      )
    },
  );
  match row.tail {
    Some(_) ->
      report_error_at(
        c1,
        b"E0417",
        body_span,
        Bytes::concat_all([b"the row of this ", site_short(site), b" is not known to be empty"]),
        b"has row ".concat(row_text(row)),
        [
          b"an effect variable is pure for some instantiations and not for others, and a claim has to hold for every one",
          b"call something whose row is closed and empty here",
        ],
      ),
    None -> c1,
  }
}

// --- Spec clauses ------------------------------------------------------------------------------
// Typed after the whole module is published: a clause may name anything the module can reach.

fn has_spec(def: FnDef) -> Bool =
  def.spec.len() > 0 || (match def.decreases { Some(_) -> true, None -> false })

fn record_spec_env(checker: Checker, def: FnDef, name: Bytes, signature: Signature) -> Checker =
  if !has_spec(def) { checker } else {
    {
      ..checker,
      spec_envs: checker.spec_envs.push({
        name: name,
        ty_params: signature.ty_params,
        row_params: signature.row_params,
        params: signature.params,
        ret: signature.ret,
      }),
    }
  }

fn spec_env_of(checker: Checker, name: Bytes) -> Option<SpecEnv> =
  checker.spec_envs.fold(None, |acc: Option<SpecEnv>, e: SpecEnv|
    match acc { Some(_) -> acc, None -> if e.name == name { Some(e) } else { None } })

fn check_specs(checker: Checker, parsed: ParsedModule) -> Checker / {abort.raise} = {
  let walked: Checker = parsed.module.items.fold(checker, |c: Checker, item: Item|
    match item {
      IFn(def) -> if !has_spec(def) { c } else {
        let name = qualify(parsed.name, def.name.name);
        match spec_env_of(c, name) {
          None -> c,
          Some(env) -> {
            let shadowed: Checker = check_cost_names(check_result_shadow(c, def), def);
            let walked = range(0, def.spec.len()).fold(
              { checker: shadowed, specs: [] },
              |acc: { checker: Checker, specs: List<SpecInfo> }, i: Int| {
                let clause = def.spec.get(i);
                let o: WithAtoms = check_clause(acc.checker, def, clause, env);
                {
                  checker: o.checker,
                  specs: acc.specs.push({
                    kind: clause.kind,
                    index: i,
                    footprint: o.atoms,
                    span: clause.span,
                  }),
                }
              },
            );
            let measured: Checker = match def.decreases {
              Some(e) -> check_measure(walked.checker, def, e, env),
              None -> walked.checker,
            };
            match def_of(measured, name) {
              Some(d) -> {
                let info: DefInfo = d;
                set_def(measured, { ..info, spec: walked.specs })
              },
              None -> measured,
            }
          },
        }
      },
      _ -> c,
    });
  { ..walked, ty_params: Map::new(), row_params: Map::new() }
}

/// A clause's scope: the parameters, and what the body assumes, its definition's constraints.
fn spec_scope(checker: Checker, written: FnDef, env: SpecEnv) -> Checker / {abort.raise} = {
  let def = carried(checker, written);
  let c0: Checker = {
    ..checker,
    ty_params: env.ty_params,
    row_params: env.row_params,
    performs: [],
    declared_atoms: [],
    guards: guards::none(),
    raise_notes: [],
  };
  let assumed: Checker = witnessing(
    { ..c0, assumed: constraints_in_force(c0, def.constraints) },
    def.constraints,
  );
  let pushed: Checker = { ..assumed, env: env_push(assumed.env) };
  range(0, def.params.len()).fold(pushed, |c: Checker, i: Int|
    if i >= env.params.len() { c } else {
      { ..c, env: env_bind(c.env, def.params.get(i).name.name, monomorphic(env.params.get(i))) }
    })
}

fn check_measure(
  checker: Checker,
  def: FnDef,
  expr: Expr,
  env: SpecEnv,
) -> Checker / {abort.raise} = {
  let o: Inferred = infer_whole(spec_scope(checker, def, env), expr);
  let popped: Checker = { ..o.checker, env: env_pop(o.checker.env) };
  let c1: Checker = expect(
    popped,
    expr_span(expr),
    int_type(),
    o.ty,
    b"a `decreases` measure is an `Int`",
  ).checker;
  check_spec_purity(
    { ..c1, assumed: checker.assumed },
    SSDecreases,
    [],
    expr_span(expr),
    resolve_row_in(c1, o.row),
  )
}

fn check_clause(
  checker: Checker,
  def: FnDef,
  clause: SpecClause,
  env: SpecEnv,
) -> WithAtoms / {abort.raise} = {
  let bound: Checker = spec_scope(checker, def, env);
  let with_result: Checker = match clause.kind {
    SEnsures -> { ..bound, env: env_bind(bound.env, result_name(), monomorphic(env.ret)) },
    SRequires -> bound,
    SSpace -> bound,
    // A cost name is the steps one call of its parameter takes.
    SCost ->
      def.params.fold(bound, |c: Checker, param: Param|
        match param.cost {
          Some(k) -> { ..c, env: env_bind(c.env, k.name, monomorphic(int_type())) },
          None -> c,
        }),
  };
  let outer = with_result.spec_kind;
  let o: Inferred = infer_whole(
    {
      ..with_result,
      spec_kind: Some(clause.kind),
      walking: if clause.kind == SCost || clause.kind == SSpace { unlowered() }
      else { with_result.walking },
    },
    clause.expr,
  );
  let popped: Checker = {
    ..o.checker,
    spec_kind: outer,
    walking: with_result.walking,
    env: env_pop(o.checker.env),
  };
  let c1: Checker = match clause.kind {
    SCost ->
      expect(
        popped,
        expr_span(clause.expr),
        int_type(),
        o.ty,
        b"a `cost` bound is an `Int`",
      ).checker,
    SSpace ->
      expect(
        popped,
        expr_span(clause.expr),
        int_type(),
        o.ty,
        b"a `space` bound is an `Int`",
      ).checker,
    _ ->
      expect(
        popped,
        expr_span(clause.expr),
        bool_type(),
        o.ty,
        b"a spec clause states a proposition",
      ).checker,
  };
  let row = resolve_row_in(c1, o.row);
  {
    checker: check_spec_purity(
      { ..c1, assumed: checker.assumed },
      match clause.kind {
        SRequires -> InRequires,
        SEnsures -> InEnsures,
        SCost -> InCost,
        SSpace -> InSpace,
      },
      [],
      clause.span,
      row,
    ),
    atoms: run_needs(row.atoms),
  }
}

/// A cost name is introduced beside the parameters, so one named like a parameter or another is reported.
fn check_cost_names(checker: Checker, def: FnDef) -> Checker / {abort.raise} =
  range(0, def.params.len()).fold(checker, |c: Checker, i: Int|
    match def.params.get(i).cost {
      None -> c,
      Some(k) -> match range(0, def.params.len()).fold(None, |found: Option<Span>, j: Int|
          match found {
            Some(_) -> found,
            None -> {
              let other = def.params.get(j);
              if other.name.name == k.name { Some(other.name.span) }
              else if j < i && (match other.cost { Some(o) -> o.name == k.name, None -> false }) {
                match other.cost { Some(o) -> Some(o.span), None -> None }
              } else { None }
            },
          }) {
        None -> c,
        Some(first) ->
          err_labels(
            c,
            b"E0105",
            Bytes::concat_all([b"`", k.name, b"` is bound twice on `", def.name.name, b"`"]),
            [
              label_at(c.module, k.span, true, b"this names a parameter's cost"),
              label_at(c.module, first, false, b"and this is named alike"),
            ],
            [b"a `cost` clause reads parameters and cost names alike, so each needs its own name"],
          ),
      },
    })

/// `result` is introduced beside the parameters, so a definition that has both is reported.
fn check_result_shadow(checker: Checker, def: FnDef) -> Checker =
  match def.spec.fold(None, |acc: Option<Span>, c: SpecClause|
      match acc { Some(_) -> acc, None -> match c.kind { SEnsures -> Some(c.span), _ -> None } }) {
    None -> checker,
    Some(ensures) ->
      def.params.fold(checker, |c: Checker, param: Param|
        if param.name.name != result_name() { c } else {
          err_labels(
            c,
            b"E0105",
            Bytes::concat_all([b"`result` is bound twice on `", def.name.name, b"`"]),
            [
              label_at(c.module, param.name.span, true, b"this parameter is named `result`"),
              label_at(c.module, ensures, false, b"`ensures` binds `result` to the return value"),
            ],
            [b"rename the parameter; a definition with no `ensures` may still call one `result`"],
          )
        }),
  }

// --- Derivability ------------------------------------------------------------------------------
// The one predicate a `where` clause, a `Map` key type and a `derive` ask.

type Blocked = { ty: Type, why: DeriveRefusal }
/// `params` are the type's type and label variables and `rows` its row variables, in the order a
/// use's arguments ride.
type AlgebraicShape = { name: Bytes, params: List<Int>, rows: List<Int>, fields: List<Type> }

/// Each sum type's shape by the type's name.
type Shapes = Map<Bytes, AlgebraicShape>

/// Every sum type this run declared, flattened: its parameters and every field of every variant.
fn algebraic_shapes(checker: Checker) -> Shapes =
  checker.ctors.fold(Map::new(), |acc: Shapes, ctor_info: CtorInfo|
    match acc.get(ctor_info.type_name) {
      None -> {
        let scheme = ctor_info.scheme;
        acc.insert(ctor_info.type_name, {
          name: ctor_info.type_name,
          params: if scheme.label_vars.len() == 0 { scheme.ty_vars }
          else { scheme.ty_vars.concat(scheme.label_vars) },
          rows: scheme.row_vars,
          fields: ctor_info.fields,
        })
      },
      Some(a) ->
        acc.insert(ctor_info.type_name, { ..a, fields: a.fields.concat(ctor_info.fields) }),
    })

fn find_adt(adts: Shapes, name: Bytes) -> Option<AlgebraicShape> = adts.get(name)

fn json_null_encoded(ty: Type) -> Bool =
  match ty { TyCon(c) -> null_encoded_name(c.name), _ -> false }

fn derivable(
  deriver: Deriver,
  ty: Type,
  adts: Shapes,
  assumed: List<Int>,
) -> Option<Blocked> / {abort.raise} = derivable_within(deriver, ty, adts, assumed, [], adts.len())

fn first_blocked(
  deriver: Deriver,
  tys: List<Type>,
  adts: Shapes,
  assumed: List<Int>,
  visiting: List<Bytes>,
  room: Int,
) -> Option<Blocked> / {abort.raise} =
  tys.fold(None, |acc: Option<Blocked>, ty: Type|
    match acc {
      Some(_) -> acc,
      None -> derivable_within(deriver, ty, adts, assumed, visiting, room),
    })

/// `room` is how many more declared types the walk may enter: a path enters each one once.
fn derivable_within(
  deriver: Deriver,
  ty: Type,
  adts: Shapes,
  assumed: List<Int>,
  visiting: List<Bytes>,
  room: Int,
) -> Option<Blocked> / {abort.raise} =
  match ty {
    TyVar(v) -> if assumed.contains(v) { None } else { Some({ ty: ty, why: Unconstrained(v) }) },
    TyFn(_) -> Some({ ty: ty, why: HoldsFunction }),
    TyRecord(fs) -> first_blocked(deriver, fs.map(|f: Field| f.ty), adts, assumed, visiting, room),
    TyNominal(n) ->
      first_blocked(deriver, n.fields.map(|f: Field| f.ty), adts, assumed, visiting, room),
    TyCon(c) -> match constructor_shape(deriver, c.name) {
      Leaf -> None,
      Refused(why) -> Some({ ty: ty, why: why }),
      Structural -> if same_deriver(deriver, DJson) && c.name == b"Option" && c.args.len() > 0
          && json_null_encoded(c.args.get(0)) { Some({ ty: ty, why: NullInsideOption }) }
      else { first_blocked(deriver, c.args, adts, assumed, visiting, room) },
      Nominal ->        // A recursive type is derivable exactly when its non-recursive parts are.
        if visiting.contains(c.name) { None } else {
          match find_adt(adts, c.name) {
            None -> None,
            Some(adt) -> if room <= 0 { panic("a type entered twice on one path") } else {
              first_blocked(
                deriver,
                adt.fields.map(|f: Type| at_arguments(f, adt.params, adt.rows, c.args)),
                adts,
                assumed,
                visiting.push(c.name),
                room - 1,
              )
            },
          }
        },
    },
  }

/// A flexible variable is a type argument nothing pinned rather than one that is wrong.
fn skipped_flexible(checker: Checker, b: Blocked) -> Bool =
  match b.why { Unconstrained(v) -> !is_rigid_ty(checker.subst, v), _ -> false }

fn secret_notes(deriver: Deriver) -> List<Bytes> =
  match refusal_note(HoldsSecret, deriver) {
    Some(n) -> [secret_reason(deriver), n],
    None -> [secret_reason(deriver)],
  }

/// The simple name of the handle type a `HoldsHandle` refused: `Cell` or `Task`.
fn handle_what(ty: Type) -> Bytes = match ty { TyCon(c) -> c.name, _ -> b"" }

/// The parameter name a refused rigid variable was declared under, else the rendered variable.
fn param_name(params: List<RigidParam>, v: Int, fallback: Bytes) -> Bytes =
  params.fold(fallback, |acc: Bytes, p: RigidParam| if p.var == v { p.name } else { acc })

fn why_notes_for_map_key(
  w: DeriveRefusal,
  b: Blocked,
  blocker: Bytes,
  params: List<RigidParam>,
) -> List<Bytes> =
  match w {
    HoldsFloat ->
      [
        b"`Float` has no total order: `NaN` is not equal to itself, so a key would have no position the next lookup could find it at",
        b"use `Decimal` for exact numbers, or key on something else",
      ],
    HoldsFunction -> [b"a function has no order to sort keys by"],
    HoldsHandle ->
      [
        Bytes::concat_all([
          b"a `",
          handle_what(b.ty),
          b"` names a location rather than a value, so two of them have no order",
        ]),
      ],
    NullInsideOption -> [],
    HoldsSecret -> secret_notes(DOrd),
    Unconstrained(v) ->
      [
        Bytes::concat_all([
          b"add `where derivable(ord, ",
          param_name(params, v, blocker),
          b")` to this signature; the body may then                          assume it",
        ]),
      ],
  }

fn why_notes_for_constraint(
  w: DeriveRefusal,
  deriver: Deriver,
  b: Blocked,
  blocker: Bytes,
  params: List<RigidParam>,
) -> List<Bytes> =
  match w {
    HoldsFunction ->
      [
        Bytes::concat_all([
          b"`",
          blocker,
          b"` is a function, and a function has no ",
          what_of(deriver),
        ]),
      ],
    HoldsHandle ->
      [
        Bytes::concat_all([
          b"a `",
          handle_what(b.ty),
          b"` names a location rather than a value, so it has no encoding",
        ]),
      ],
    HoldsFloat -> [float_reason(deriver), b"use `Decimal` for exact numbers"],
    NullInsideOption ->
      [
        Bytes::concat_all([b"`", blocker, b"` writes `None` and its payload alike"]),
        null_in_option_note(),
      ],
    HoldsSecret -> secret_notes(deriver),
    Unconstrained(v) ->
      [
        Bytes::concat_all([
          b"add `where derivable(",
          deriver_text(deriver),
          b", ",
          param_name(params, v, blocker),
          b")` to the signature this call sits in; the body may then assume it",
        ]),
      ],
  }

fn rigid_params(checker: Checker) -> List<RigidParam> =
  checker.ty_params.fold([], |acc: List<RigidParam>, k: Bytes, ty: Type|
    match ty { TyVar(v) -> acc.push({ name: k, var: v }), _ -> acc })

/// `integer(a)` implies `numeric(a)`, so a numeric obligation also holds of an integer parameter.
fn assumed_for(checker: Checker, deriver: Deriver) -> List<Int> / {abort.raise} =
  checker.assumed.fold([], |acc: List<Int>, a: Assumed|
    if same_deriver(a.deriver, deriver)
        || (same_deriver(deriver, DNumeric) && same_deriver(a.deriver, DInteger)) {
      a.vars.fold(acc, |b: List<Int>, v: Int| ints_insert(b, v))
    } else { acc })

/// `def` with `where derivable(ord, a)` for each type parameter `a` its signature writes inside an
/// argument a declared type keys a `Map` by: the type carries the constraint, so callers meet it
/// and the body assumes it as though the signature wrote it.
fn carried(checker: Checker, def: FnDef) -> FnDef / {abort.raise} = {
  let names = def.generics.types.map(|g: Ident| g.name);
  if names.len() == 0 { def } else {
    let written = def.params.fold(
      match def.ret { Some(t) -> [t], None -> [] },
      |acc: List<TypeExpr>, p: Param| match p.ty { Some(t) -> acc.push(t), None -> acc },
    );
    let found = written.fold([], |acc: List<KeyedMention>, t: TypeExpr|
      keyed_mentions(checker, t, names, acc));
    found.fold(def, |d: FnDef, k: KeyedMention|
      if d.constraints.fold(false, |has: Bool, c: Constraint|
          has || (c.param.name == k.param.name && same_deriver(c.deriver, DOrd))) { d } else {
        {
          ..d,
          constraints: d.constraints.push({
            deriver: DOrd,
            deriver_span: k.at,
            param: k.param,
            span: k.at,
          }),
        }
      })
  }
}

/// A type parameter written inside an argument a declared type keys a `Map` by, and the type's use.
type KeyedMention = { at: Span, param: Ident }

fn keyed_mentions(
  checker: Checker,
  t: TypeExpr,
  names: List<Bytes>,
  out: List<KeyedMention>,
) -> List<KeyedMention> / {abort.raise} =
  match t {
    TCon(c) -> {
      let inner = c.args.fold(out, |acc: List<KeyedMention>, a: TypeExpr|
        keyed_mentions(checker, a, names, acc));
      if is_bare(c.name)
          && (builtin_type_arity(c.name.name.name) != None || names.contains(c.name.name.name)) {
        inner
      } else {
        match global(checker, TypeSpace, c.name).name {
          None -> inner,
          Some(q) ->
            keyed_positions(checker, q, [], keyed_room(checker)).fold(
              inner,
              |acc: List<KeyedMention>, j: Int|
                match c.args.at(j) {
                  Some(a) ->
                    params_written(a, names).fold(acc, |b: List<KeyedMention>, p: Ident|
                      b.push({ at: c.span, param: p })),
                  None -> acc,
                },
            ),
        }
      }
    },
    TFn(f) ->
      f.params.fold(
        keyed_mentions(checker, f.ret, names, out),
        |acc: List<KeyedMention>, p: TypeExpr| keyed_mentions(checker, p, names, acc),
      ),
    TRecord(r) ->
      r.fields.fold(out, |acc: List<KeyedMention>, f: { name: Ident, ty: TypeExpr }|
        keyed_mentions(checker, f.ty, names, acc)),
    _ -> out,
  }

/// The type parameters among `names` that `t` writes anywhere in it.
fn params_written(t: TypeExpr, names: List<Bytes>) -> List<Ident> =
  match t {
    TVar(id) -> if names.contains(id.name) { [id] } else { [] },
    TCon(c) ->
      c.args.fold(
        if is_bare(c.name) && c.args.len() == 0 && names.contains(c.name.name.name) {
          [c.name.name]
        } else { [] },
        |acc: List<Ident>, a: TypeExpr| acc.concat(params_written(a, names)),
      ),
    TFn(f) ->
      f.params.fold(params_written(f.ret, names), |acc: List<Ident>, p: TypeExpr|
        acc.concat(params_written(p, names))),
    TRecord(r) ->
      r.fields.fold([], |acc: List<Ident>, f: { name: Ident, ty: TypeExpr }|
        acc.concat(params_written(f.ty, names))),
    _ -> [],
  }

/// The positions of the declared type `name`'s parameters a value of it keys a `Map` by, through
/// anything it holds; `seen` are the types being walked, so a recursive one ends, and `room` is
/// how many more declarations a walk may enter.
fn keyed_positions(
  checker: Checker,
  name: Bytes,
  seen: List<Bytes>,
  room: Int,
) -> List<Int> / {abort.raise} =
  if room <= 0 || seen.contains(name) { [] } else {
    let within = seen.push(name);
    match checker.nominals.get(name) {
      Some(r) -> positions_among(r.ty_vars, keyed_vars(checker, r.ty, within, room - 1)),
      None -> match checker.ctors.filter(|c: CtorInfo| c.type_name == name) {
        [] -> [],
        [first, ..rest] ->
          positions_among(
            first.scheme.ty_vars,
            rest.push(first).fold([], |acc: List<Int>, c: CtorInfo|
              c.fields.fold(acc, |held: List<Int>, f: Type|
                ints_union(held, keyed_vars(checker, f, within, room - 1)))),
          ),
      },
    }
  }

/// Enough room for a walk to enter every declaration there is.
fn keyed_room(checker: Checker) -> Int = checker.ctors.len() + checker.nominals.len() + 1

fn positions_among(vars: List<Int>, keyed: List<Int>) -> List<Int> =
  range(0, vars.len()).filter(|i: Int|
    match vars.at(i) { Some(v) -> keyed.contains(v), None -> false })

/// The variables a value of `t` needs ordered: a `Map` key's, and those of an argument a declared
/// type it holds keys a `Map` by.
fn keyed_vars(
  checker: Checker,
  t: Type,
  seen: List<Bytes>,
  room: Int,
) -> List<Int> / {abort.raise} =
  match t {
    TyCon(c) -> {
      let inner = c.args.fold([], |acc: List<Int>, a: Type|
        ints_union(acc, keyed_vars(checker, a, seen, room)));
      if c.name == b"Map" && c.args.len() == 2 { ints_union(inner, vars_of_type(c.args.get(0))) }
      else if builtin_type_arity(c.name) != None { inner } else {
        keyed_positions(checker, c.name, seen, room).fold(inner, |acc: List<Int>, j: Int|
          match c.args.at(j) { Some(a) -> ints_union(acc, vars_of_type(a)), None -> acc })
      }
    },
    TyNominal(n) ->
      n.fields.fold([], |acc: List<Int>, f: Field|
        ints_union(acc, keyed_vars(checker, f.ty, seen, room))),
    TyRecord(fs) ->
      fs.fold([], |acc: List<Int>, f: Field|
        ints_union(acc, keyed_vars(checker, f.ty, seen, room))),
    TyFn(f) ->
      f.params.fold(keyed_vars(checker, f.ret, seen, room), |acc: List<Int>, p: Type|
        ints_union(acc, keyed_vars(checker, p, seen, room))),
    TyVar(_) -> [],
  }

fn vars_of_type(t: Type) -> List<Int> / {abort.raise} =
  free_vars(subst_new(), t, { tys: [], rows: [] }).tys

fn map_key_types(t: Type, out: List<Type>) -> List<Type> / {abort.raise} =
  match t {
    TyCon(c) -> {
      let own = if c.name == b"Map" && c.args.len() == 2 { out.push(c.args.get(0)) } else { out };
      c.args.fold(own, |acc: List<Type>, a: Type| map_key_types(a, acc))
    },
    TyFn(f) ->
      map_key_types(f.ret, f.params.fold(out, |acc: List<Type>, p: Type| map_key_types(p, acc))),
    TyRecord(fs) -> fs.fold(out, |acc: List<Type>, f: Field| map_key_types(f.ty, acc)),
    TyNominal(n) -> n.args.fold(out, |acc: List<Type>, a: Type| map_key_types(a, acc)),
    TyVar(_) -> out,
  }

/// Every `Map` in a type as it was written or instantiated, judged once the module is solved.
fn note_map_keys(checker: Checker, span: Span, ty: Type) -> Checker / {abort.raise} = {
  let found = map_key_types(ty, []);
  if found.len() == 0 { checker } else {
    let assumed = assumed_for(checker, DOrd);
    let params = rigid_params(checker);
    {
      ..checker,
      map_keys: checker.map_keys.concat(
        found.map(|k: Type|
          {
            module: checker.module,
            span: span,
            scope: checker.scope,
            key: k,
            assumed: assumed,
            params: params,
            via: b"",
          }),
      ),
    }
  }
}

fn from_index(sites: List<MapKeySite>, from: Int) -> List<MapKeySite> / {abort.raise} =
  range(from, sites.len()).fold([], |acc: List<MapKeySite>, i: Int| acc.push(sites.get(i)))

/// The sites an alias expansion recorded from `from` on, moved to where the alias was named.
fn relocated_keys(
  sites: List<MapKeySite>,
  from: Int,
  module: Int,
  span: Span,
  alias: Bytes,
) -> List<MapKeySite> / {abort.raise} =
  range(from, sites.len()).fold(sites, |acc: List<MapKeySite>, i: Int| {
    let s = acc.get(i);
    acc.set(i, { ..s, module: module, span: span, via: alias })
  })

/// A reference that instantiated a parameter its callee constrained.
fn note_constraints(
  checker: Checker,
  span: Span,
  callee: Bytes,
  args: List<Type>,
) -> Checker / {abort.raise} =
  match checker.constraints.get(callee) {
    None -> checker,
    Some(cs) -> if cs.len() == 0 { checker } else {
      let callee_at = match def_of(checker, callee) {
        Some(d) -> d.at,
        None -> { module: checker.module, span: span },
      };
      let params = rigid_params(checker);
      let sites = cs.fold([], |acc: List<ConstraintSite>, c: DefConstraint|
        if c.param >= args.len() { acc } else {
          acc.push({
            module: checker.module,
            span: span,
            deriver: c.deriver,
            param: c.param,
            ty: args.get(c.param),
            callee: callee,
            callee_at: callee_at,
            assumed: assumed_for(checker, c.deriver),
            params: params,
            called: false,
            owner: checker.walking,
          })
        });
      { ..checker, constrained_uses: checker.constrained_uses.concat(sites) }
    },
  }

/// The reference a call applies was a call, not a value: its constraint sites, the last ones
/// recorded, say so.
fn called(checker: Checker, span: Span) -> Checker / {abort.raise} = {
  let n = checker.constrained_uses.len();
  let marked = iterate(
    { i: n - 1, uses: checker.constrained_uses },
    n + 1,
    |s: { i: Int, uses: List<ConstraintSite> }|
      match s.uses.at(s.i) {
        Some(u) -> if u.module == checker.module && u.span == span {
          Continue({ i: s.i - 1, uses: s.uses.set(s.i, { ..u, called: true }) })
        } else { Stop(s) },
        None -> Stop(s),
      },
  );
  { ..checker, constrained_uses: marked.uses }
}

/// The type parameters a definition's `numeric` and `integer` constraints make witnesses of.
fn witnessing(checker: Checker, cs: List<Constraint>) -> Checker =
  cs.fold(checker, |c: Checker, k: Constraint|
    if !is_predicate(k.deriver) { c } else {
      match c.ty_params.get(k.param.name) {
        Some(TyVar(v)) -> {
          let integer = same_deriver(k.deriver, DInteger)
            || (match c.witnessed.get(v) { Some(w) -> w.integer, None -> false });
          { ..c, witnessed: c.witnessed.insert(v, { param: k.param.name, integer: integer }) }
        },
        _ -> c,
      }
    })

fn check_map_keys(checker: Checker) -> Checker / {abort.raise} = {
  let ordered = instance_shapes(checker.instances, algebraic_shapes(checker), DOrd);
  let walked = checker.map_keys.fold(
    { checker: { ..checker, map_keys: [] }, seen: [] },
    |acc: { checker: Checker, seen: List<{ scope: Int, text: Bytes }> }, site: MapKeySite| {
      let key = resolve(acc.checker, site.key);
      match derivable(DOrd, key, ordered, site.assumed) {
        None -> acc,
        Some(blocked) -> if skipped_flexible(acc.checker, blocked) { acc } else {
          let pr = print_ty(printer_new(), key);
          let rendered = pr.text;
          let dup = acc.seen.fold(false, |b: Bool, s: { scope: Int, text: Bytes }|
            b || (s.scope == site.scope && s.text == rendered));
          if dup { acc } else {
            let blocker = print_ty(pr.printer, blocked.ty).text;
            {
              checker: report(
                acc.checker,
                error_at(
                  b"E0206",
                  site.module,
                  site.span,
                  Bytes::concat_all([
                    b"`",
                    blocker,
                    b"` is not an ordered type, so it cannot be a `Map` key",
                  ]),
                  Bytes::concat_all([b"this map's key type is `", rendered, b"`"]),
                  alias_noted(
                    why_notes_for_map_key(blocked.why, blocked, blocker, site.params),
                    site.via,
                  ),
                ),
              ),
              seen: acc.seen.push({ scope: site.scope, text: rendered }),
            }
          }
        },
      }
    },
  );
  walked.checker
}

fn alias_noted(notes: List<Bytes>, via: Bytes) -> List<Bytes> =
  if via == b"" { notes } else {
    notes.push(
      Bytes::concat_all([b"`", via, b"` is a type alias, and the `Map` is in what it names"]),
    )
  }

/// A case is told from another by what it holds, so its type is read through no `key`.
fn of_case(site: ConstraintSite) -> Bool =
  site.callee == b"std.cases.listed" || site.callee == b"std.cases.chosen"

fn check_constraints(checker: Checker) -> Checker / {abort.raise} = {
  let adts = algebraic_shapes(checker);
  let shapes = deriver_shapes(checker.instances, adts);
  let walked = checker.constrained_uses.fold(
    { checker: { ..checker, constrained_uses: [] }, seen: [] },
    |acc: { checker: Checker, seen: List<{ span: Span, text: Bytes, tag: Int }> }, site: ConstraintSite| {
      let ty = resolve(acc.checker, site.ty);
      if is_predicate(site.deriver) {
        { checker: check_predicate(acc.checker, site, ty), seen: acc.seen }
      } else {
        let through = shapes_for(shapes, site.deriver);
        match derivable(
            site.deriver,
            ty,
            if of_case(site) { adts } else { through },
            site.assumed,
          ) {
          None -> acc,
          Some(blocked) -> if skipped_flexible(acc.checker, blocked) { acc } else {
            let pr = print_ty(printer_new(), ty);
            let rendered = pr.text;
            let tag = deriver_tag(site.deriver);
            let dup = acc.seen.fold(false, |b: Bool, s: { span: Span, text: Bytes, tag: Int }|
              b || (s.span == site.span && s.text == rendered && s.tag == tag));
            if dup { acc } else {
              let blocker = print_ty(pr.printer, blocked.ty).text;
              let callee = default_binder(site.callee);
              let dv = deriver_text(site.deriver);
              {
                checker: err_labels(
                  acc.checker,
                  b"E0206",
                  Bytes::concat_all([b"`", rendered, b"` cannot be derived for `", dv, b"`"]),
                  [
                    label_at(
                      site.module,
                      site.span,
                      true,
                      Bytes::concat_all([
                        b"`",
                        callee,
                        b"` requires `derivable(",
                        dv,
                        b", \xc2\xb7)` here",
                      ]),
                    ),
                    label_at(
                      site.callee_at.module,
                      site.callee_at.span,
                      false,
                      Bytes::concat_all([
                        b"`",
                        callee,
                        b"` declares the constraint on its signature",
                      ]),
                    ),
                  ],
                  why_notes_for_constraint(
                    blocked.why,
                    site.deriver,
                    blocked,
                    blocker,
                    site.params,
                  ).concat(
                    if of_case(site) && derivable(site.deriver, ty, through, site.assumed) == None {
                      [
                        b"a case is told from another by what it holds, so a `key` does not stand in for the type that states it",
                      ]
                    } else { [] },
                  ),
                ),
                seen: acc.seen.push({ span: site.span, text: rendered, tag: tag }),
              }
            }
          },
        }
      }
    },
  );
  walked.checker
}

/// What `numeric(a)` or `integer(a)` was instantiated at, as the witness the call passes.
fn predicate_witness(checker: Checker, site: ConstraintSite, ty: Type) -> Option<NumericWitness> =
  match ty {
    TyCon(k) -> if k.args.len() != 0 { None }
    else if is_int_name(k.name) { Some(ConcreteWitness(k.name)) }
    else if same_deriver(site.deriver, DNumeric) && (k.name == b"Float" || k.name == b"Decimal") {
      Some(ConcreteWitness(k.name))
    }
    // `numeric(a)` holds the ordered comparisons, which a type takes from its `key`.
    else if same_deriver(site.deriver, DNumeric) {
      match numeric_of(checker.numeric_types, k.name) {
        Some(x) -> match instance_of(checker.instances, k.name, true) {
          Some(_) -> Some(StatedWitness(x.ctor)),
          None -> None,
        },
        None -> None,
      }
    } else { None },
    TyVar(v) -> if !site.assumed.contains(v) { None } else {
      match site.params.fold(None, |acc: Option<Bytes>, r: RigidParam|
          if r.var == v { Some(r.name) } else { acc }) {
        Some(name) -> Some(ParamWitness(name)),
        None -> None,
      }
    },
    _ -> None,
  }

/// A predicate's site: the callee is called, the type admits the predicate, and the witness it
/// passes joins the others the same call passes, in the callee's order and once per parameter.
fn check_predicate(checker: Checker, site: ConstraintSite, ty: Type) -> Checker / {abort.raise} = {
  let callee = default_binder(site.callee);
  let dv = deriver_text(site.deriver);
  if !site.called {
    if checker.diags.fold(false, |b: Bool, diag: Diag|
        b || (diag.code == b"E0310" && primary_is(diag, site))) { checker } else {
      report_error_at(
        { ..checker, module: site.module },
        b"E0310",
        site.span,
        Bytes::concat_all([b"`", callee, b"` must be called directly"]),
        b"used as a value",
        [
          Bytes::concat_all([
            b"`",
            callee,
            b"` takes the type its `",
            dv,
            b"` constraint is about as a hidden argument each call fills",
          ]),
          b"wrap it in a lambda that calls it",
        ],
      )
    }
  } else {
    match predicate_witness(checker, site, ty) {
      Some(w) -> {
        let n = checker.witness_refs.len();
        let fresh = {
          module: site.module,
          span: site.span,
          witnesses: [w],
          params: [site.param],
          owner: site.owner,
        };
        match checker.witness_refs.at(n - 1) {
          Some(r) -> if r.module == site.module && r.span == site.span && r.owner == site.owner {
            if r.params.contains(site.param) { checker } else {
              {
                ..checker,
                witness_refs: checker.witness_refs.set(n - 1, {
                  ..r,
                  witnesses: r.witnesses.push(w),
                  params: r.params.push(site.param),
                }),
              }
            }
          } else { { ..checker, witness_refs: checker.witness_refs.push(fresh) } },
          None -> { ..checker, witness_refs: checker.witness_refs.push(fresh) },
        }
      },
      None -> match ty {
        TyVar(v) -> if is_rigid_ty(checker.subst, v) {
          report_error_at(
            { ..checker, module: site.module },
            b"E0201",
            site.span,
            Bytes::concat_all([
              b"`",
              callee,
              b"` needs `",
              dv,
              b"(\xc2\xb7)` of a type parameter that has none",
            ]),
            Bytes::concat_all([b"`", callee, b"` requires `", dv, b"(\xc2\xb7)` here"]),
            [b"add the constraint to this signature's `where`; the body may then assume it"],
          )
        } else {
          report_error_at(
            { ..checker, module: site.module },
            b"E0210",
            site.span,
            Bytes::concat_all([b"the numeric type `", callee, b"` is called at is not determined"]),
            b"nothing here says which numeric type this is",
            [b"annotate an argument, or write a literal that pins it (`1`, `1.0`, `1m`)"],
          )
        },
        _ ->
          report_error_at(
            { ..checker, module: site.module },
            b"E0201",
            site.span,
            Bytes::concat_all([
              b"`",
              type_text(ty),
              if same_deriver(site.deriver, DInteger) { b"` is not an integer type" }
              else { b"` is not a numeric type" },
            ]),
            Bytes::concat_all([b"`", callee, b"` requires `", dv, b"(\xc2\xb7)` here"]),
            if same_deriver(site.deriver, DInteger) {
              [b"the integer types are `Int` and the eight fixed-width integers"]
            } else {
              [
                b"the numeric types are `Int`, the eight fixed-width integers, `Float`, `Decimal`, and a type that states `numeric` and a `key`",
              ].concat(match ty {
                TyCon(k) -> match numeric_of(checker.numeric_types, k.name) {
                  Some(_) ->
                    [
                      Bytes::concat_all([
                        b"`",
                        simple_name_of(k.name),
                        b"` states `numeric` and no `key`: `numeric(\xc2\xb7)` holds `<` and the rest, which a type takes from its `key`",
                      ]),
                    ],
                  None -> [],
                },
                _ -> [],
              })
            },
          ),
      },
    }
  }
}

fn primary_is(diag: Diag, site: ConstraintSite) -> Bool =
  diag.labels.fold(false, |b: Bool, label: Label|
    b
      || (label.primary && label.module == site.module && label.start == site.span.start
      && label.end == site.span.end))

// --- The two passes that read what expansion produced --------------------------------------------

fn expanded_here(parsed: ParsedModule, def: DeriveDef) -> Bool =
  parsed.derived.fold(false, |acc: Bool, d: Derived|
    acc || (same_deriver(d.deriver, def.deriver) && d.target == def.target.name))

/// The target as a solved type when it has no parameters; an alias's reports are dropped, already made at its declaration.
fn derive_target(
  checker: Checker,
  parsed: ParsedModule,
  target: Bytes,
) -> Option<WithTy> / {abort.raise} = {
  let qualified = qualify(parsed.name, target);
  match checker.types.get(qualified) {
    None -> None,
    Some(decl) -> if decl.params.len() > 0 || decl.labels.len() > 0 || decl.rows.len() > 0 { None }
    else {
      match decl.declared {
        DeclaredSum -> Some({ checker: checker, ty: TyCon({ name: qualified, args: [] }) }),
        DeclaredRecord(_) -> match checker.nominals.get(qualified) {
          Some(r) -> Some({ checker: checker, ty: r.ty }),
          None -> None,
        },
        DeclaredAlias(alias) -> {
          let mark = checker.diags.len();
          let inner: Checker = {
            ..checker,
            ty_params: Map::new(),
            row_params: Map::new(),
            label_params: Map::new(),
            alias_stack: checker.alias_stack.push(qualified),
            module: decl.owner,
          };
          let o: WithTy = conv_type(inner, alias);
          Some({
            checker: {
              ..o.checker,
              ty_params: checker.ty_params,
              row_params: checker.row_params,
              label_params: checker.label_params,
              alias_stack: checker.alias_stack,
              module: checker.module,
              diags: o.checker.diags.take(mark),
            },
            ty: o.ty,
          })
        },
      }
    },
  }
}

fn why_notes_for_derive(
  w: DeriveRefusal,
  deriver: Deriver,
  b: Blocked,
  blocker: Bytes,
) -> List<Bytes> =
  match w {
    NullInsideOption ->
      [
        Bytes::concat_all([b"`", blocker, b"` writes `None` and its payload alike"]),
        null_in_option_note(),
      ],
    HoldsFloat -> [float_reason(deriver)],
    HoldsFunction -> [b"a function has no encoding to derive"],
    HoldsHandle ->
      [
        Bytes::concat_all([
          b"a `",
          handle_what(b.ty),
          b"` names a location rather than a value, so it has no encoding",
        ]),
      ],
    HoldsSecret -> secret_notes(deriver),
    Unconstrained(_) -> [],
  }

/// `derivable(D, T)` over each `derive`'s target as a solved type.
fn check_derives(checker: Checker) -> Checker / {abort.raise} = {
  let shapes = deriver_shapes(checker.instances, algebraic_shapes(checker));
  range(0, checker.modules.len()).fold(checker, |c: Checker, i: Int| {
    let m = c.modules.get(i);
    m.module.items.fold(c, |cc: Checker, item: Item|
      match item {
        IDerive(def) -> if !expanded_here(m, def) { cc } else {
          match derive_target({ ..cc, module: i }, m, def.target.name) {
            None -> cc,
            Some(o) -> match derivable(def.deriver, o.ty, shapes_for(shapes, def.deriver), []) {
              None -> o.checker,
              Some(blocked) -> match blocked.why {
                Unconstrained(_) -> o.checker,
                _ -> {
                  let blocker = type_text(blocked.ty);
                  let dv = deriver_text(def.deriver);
                  report(
                    o.checker,
                    error_at(
                      b"E0206",
                      i,
                      def.span,
                      Bytes::concat_all([
                        b"`",
                        dv,
                        b"` cannot be derived for `",
                        def.target.name,
                        b"`",
                      ]),
                      Bytes::concat_all([b"`", blocker, b"` has no ", what_of(def.deriver)]),
                      why_notes_for_derive(blocked.why, def.deriver, blocked, blocker).push(
                        Bytes::concat_all([
                          b"write the dictionary for `",
                          def.target.name,
                          b"` by hand, or change the field",
                        ]),
                      ),
                    ),
                  )
                },
              },
            },
          }
        },
        _ -> cc,
      })
  })
}

// --- What a type's module states of it ----------------------------------------------------------

fn is_key(kind: InstanceKind) -> Bool = match kind { NKey -> true, NShow -> false }

fn instance_of(instances: List<InstanceInfo>, type_name: Bytes, key: Bool) -> Option<InstanceInfo> =
  instances.fold(None, |acc: Option<InstanceInfo>, x: InstanceInfo|
    match acc {
      Some(_) -> acc,
      None -> if x.type_name == type_name && is_key(x.kind) == key { Some(x) } else { None },
    })

/// Whether a type that states a `key` is read through it for `deriver`: compared, ordered and hashed
/// as what its key answers is, whatever it holds.
fn through_key(deriver: Deriver) -> Bool =
  same_deriver(deriver, DEq) || same_deriver(deriver, DOrd) || same_deriver(deriver, DHash)

/// Each type's first statement of one kind, by the type's name.
fn stated_by_type(instances: List<InstanceInfo>, key: Bool) -> Map<Bytes, InstanceInfo> =
  instances.fold(Map::new(), |acc: Map<Bytes, InstanceInfo>, x: InstanceInfo|
    if is_key(x.kind) != key || acc.contains(x.type_name) { acc }
    else { acc.insert(x.type_name, x) })

/// The shapes `derivable` reads for one deriver. A type that states a `key` is compared, ordered and
/// hashed as what its key answers is, whatever it holds, and one that states a `show` is always shown.
fn instance_shapes(instances: List<InstanceInfo>, adts: Shapes, deriver: Deriver) -> Shapes =
  if instances.len() == 0 { adts } else {
    let keyed = through_key(deriver);
    if !keyed && !same_deriver(deriver, DShow) { adts } else {
      let stated = stated_by_type(instances, keyed);
      adts.fold(adts, |acc: Shapes, name: Bytes, shape: AlgebraicShape|
        match stated.get(name) {
          Some(x) ->
            acc.insert(name, {
              name: shape.name,
              params: x.params,
              rows: x.rows,
              fields: if keyed { [x.answers] } else { [] },
            }),
          None -> acc,
        })
    }
  }

/// The shapes each deriver reads, worked out once for a pass that asks `derivable` of many sites.
type DeriverShapes = { plain: Shapes, keyed: Shapes, shown: Shapes }

fn deriver_shapes(instances: List<InstanceInfo>, adts: Shapes) -> DeriverShapes =
  {
    plain: adts,
    keyed: instance_shapes(instances, adts, DEq),
    shown: instance_shapes(instances, adts, DShow),
  }

fn shapes_for(shapes: DeriverShapes, deriver: Deriver) -> Shapes =
  if through_key(deriver) { shapes.keyed }
  else if same_deriver(deriver, DShow) { shapes.shown }
  else { shapes.plain }

type OwnParams = { params: List<Int>, rows: List<Int> }

/// The variables of `T<a | e>` when `ty` is `type_name` at parameters of its own: each type argument
/// a variable and each row argument a bare one, none of them twice.
fn own_params(ty: Type, type_name: Bytes) -> Option<OwnParams> =
  match ty {
    TyCon(c) -> if c.name != type_name { None } else {
      c.args.fold(Some({ params: [], rows: [] }), |acc: Option<OwnParams>, a: Type|
        match acc {
          None -> None,
          Some(own) -> match arg_row(a) {
            Some(row) -> match row.tail {
              Some(v) -> if row.atoms.len() > 0 || own.rows.contains(v) { None }
              else { Some({ ..own, rows: own.rows.push(v) }) },
              None -> None,
            },
            None -> match arg_label(a) {
              Some(_) -> None,
              None -> match a {
                TyVar(v) -> if own.params.contains(v) { None }
                else { Some({ ..own, params: own.params.push(v) }) },
                _ -> None,
              },
            },
          },
        })
    },
    _ -> None,
  }

fn unfit(checker: Checker, def: InstanceDef, f: DefInfo, why: Bytes, note: Bytes) -> Checker =
  err_labels(
    checker,
    b"E0218",
    Bytes::concat_all([
      b"`",
      def.by.name,
      b"` cannot be the `",
      instance_text(def.kind),
      b"` of `",
      def.target.name,
      b"`",
    ]),
    [
      label_at(checker.module, def.by.span, true, why),
      label_at(f.at.module, f.at.span, false, b"the function it names"),
    ],
    [
      note,
      match def.kind {
        NKey ->
          Bytes::concat_all([
            b"a `key` takes one `",
            def.target.name,
            b"` and answers what `==`, `compare`, `digest` and a `Map` read in its place",
          ]),
        NShow ->
          Bytes::concat_all([
            b"a `show` takes one `",
            def.target.name,
            b"` and answers the `String` that `show` and an interpolated string write",
          ]),
      },
    ],
  )

/// One `key for T by f` or `show for T by f`: the type is a sum of this module's own, it states
/// each once, and `f` is a function of this module that takes the value alone and only answers.
fn check_instance(checker: Checker, m: ParsedModule, def: InstanceDef) -> Checker / {abort.raise} = {
  let what = instance_text(def.kind);
  let type_name = qualify(m.name, def.target.name);
  match checker.types.get(type_name) {
    None ->
      report_error_at(
        checker,
        b"E0208",
        def.target.span,
        Bytes::concat_all([b"`", def.target.name, b"` is not a type this module declares"]),
        b"declared in another module, or not at all",
        [
          Bytes::concat_all([
            b"a `",
            what,
            b"` may only name a type its own module declares, so that a type means one thing wherever its values are compared or shown",
          ]),
        ],
      ),
    Some(decl) -> {
      match decl.declared {
        DeclaredAlias(_) ->
          not_a_sum(
            checker,
            def.target,
            decl,
            Bytes::concat_all([
              b"`",
              def.target.name,
              b"` is not a sum, and a `",
              what,
              b"` is for one",
            ]),
            b"an alias is the type it names, so a `key` or a `show` for one would be for every value of that type",
          ),
        DeclaredRecord(_) ->
          not_a_sum(
            checker,
            def.target,
            decl,
            Bytes::concat_all([
              b"`",
              def.target.name,
              b"` is a `new` record, which cannot state a `",
              what,
              b"` yet",
            ]),
            b"a `new` record runs as the record it is written as, so nothing in a value says which type it is of where it is compared or shown",
          ),
        DeclaredSum -> match instance_of(checker.instances, type_name, is_key(def.kind)) {
          Some(first) ->
            report_error_at_and(
              checker,
              b"E0105",
              def.span,
              Bytes::concat_all([b"`", def.target.name, b"` states its `", what, b"` twice"]),
              b"stated again here",
              first.at,
              b"first stated here",
              [b"a type has one, so that nothing has to choose between two; remove one"],
            ),
          None -> match def_of(checker, qualify(m.name, def.by.name)) {
            None ->
              report_error_at(
                checker,
                b"E0101",
                def.by.span,
                Bytes::concat_all([b"`", def.by.name, b"` is not a function this module declares"]),
                Bytes::concat_all([b"a `", what, b"` names a function of its type's own module"]),
                [],
              ),
            Some(f) -> fitted(checker, def, type_name, f, writes_where(m, def.by.name)),
          },
        },
      }
    },
  }
}

/// Whether the function `name` of `m` writes a `where`; what its signature's types carry is none.
fn writes_where(m: ParsedModule, name: Bytes) -> Bool =
  m.module.items.fold(false, |found: Bool, item: Item|
    found || (match item { IFn(d) -> d.name.name == name && d.constraints.len() > 0, _ -> false }))

fn not_a_sum(
  checker: Checker,
  target: Ident,
  decl: TypeDecl,
  message: Bytes,
  why: Bytes,
) -> Checker =
  report_error_at_and(
    checker,
    b"E0217",
    target.span,
    message,
    b"this type has no constructor",
    { module: decl.owner, span: decl.span },
    b"declared here",
    [
      why,
      Bytes::concat_all([
        b"declare a sum, as `type ",
        target.name,
        b" = | ",
        target.name,
        b"(..)`, whose constructor a value carries",
      ]),
    ],
  )

fn fitted(
  checker: Checker,
  def: InstanceDef,
  type_name: Bytes,
  f: DefInfo,
  where_written: Bool,
) -> Checker / {abort.raise} =
  match resolve(checker, f.scheme.ty) {
    TyFn(sig) -> if where_written {
      unfit(
        checker,
        def,
        f,
        b"this function has a `where` clause",
        b"it is called with the value alone, wherever two are compared or one is shown, so no call fills a constraint",
      )
    } else if sig.params.len() != 1 {
      unfit(
        checker,
        def,
        f,
        Bytes::concat_all([
          b"this function takes ",
          ascii_of_int(sig.params.len()),
          b" parameters",
        ]),
        b"it is called with the value alone",
      )
    } else if f.scheme.label_vars.len() > 0 {
      unfit(
        checker,
        def,
        f,
        b"this function binds a resource label",
        b"it is called with the value alone, and a value does not carry the label its type was given, so a type that binds a label states no `key` and no `show`",
      )
    } else {
      match own_params(sig.params.get(0), type_name) {
        None ->
          unfit(
            checker,
            def,
            f,
            Bytes::concat_all([b"this function takes `", type_text(sig.params.get(0)), b"`"]),
            Bytes::concat_all([
              b"its parameter is `",
              def.target.name,
              b"` at the type's own parameters, so it reads every `",
              def.target.name,
              b"` there is",
            ]),
          ),
        Some(own) -> if !row_is_pure(sig.effects) {
          unfit(
            checker,
            def,
            f,
            Bytes::concat_all([b"this function's row is `", row_text(sig.effects), b"`"]),
            b"`==`, `compare` and `show` perform nothing, cannot raise and always return, so the function they read through does the same",
          )
        } else if !answers_over(free_vars(checker.subst, sig.ret, { tys: [], rows: [] }), own) {
          unfit(
            checker,
            def,
            f,
            Bytes::concat_all([b"this function answers `", type_text(sig.ret), b"`"]),
            b"what it answers is over the type's own parameters and no others",
          )
        } else if !is_key(def.kind) && sig.ret != string_type() {
          unfit(
            checker,
            def,
            f,
            Bytes::concat_all([b"this function answers `", type_text(sig.ret), b"`"]),
            b"what is shown is text",
          )
        } else {
          {
            ..checker,
            instances: checker.instances.push({
              type_name: type_name,
              kind: def.kind,
              by: f.name,
              params: own.params,
              rows: own.rows,
              answers: sig.ret,
              at: { module: checker.module, span: def.span },
            }),
          }
        },
      }
    },
    _ -> checker,
  }

/// Whether every variable an answer's type holds is one of the type's own parameters.
fn answers_over(free: Free, own: OwnParams) -> Bool =
  free.tys.fold(true, |all: Bool, v: Int| all && own.params.contains(v))
    && free.rows.fold(true, |all: Bool, v: Int| all && own.rows.contains(v))

/// What a module states of its types, read before any body is: the first `numeric` each type is
/// given, as written, and each type given a `key`. `check_instances` judges them.
fn collect_stated(checker: Checker, parsed: ParsedModule) -> Checker =
  parsed.module.items.fold(checker, |c: Checker, item: Item|
    match item {
      IInstance(def) -> match def.kind {
        NKey -> { ..c, keyed_names: c.keyed_names.push(qualify(parsed.name, def.target.name)) },
        NShow -> c,
      },
      INumeric(def) -> {
        let type_name = qualify(parsed.name, def.target.name);
        match numeric_of(c.numeric_types, type_name) {
          Some(_) -> c,
          None ->
            {
              ..c,
              numeric_types: c.numeric_types.push({
                type_name: type_name,
                ctor: c.ctors.fold(b"", |found: Bytes, k: CtorInfo|
                  if found.len() == 0 && k.type_name == type_name { k.name } else { found }),
                fns: numeric_ops().map(|op: Bytes|
                  match numeric_by(def, op) {
                    Some(by) -> qualify(parsed.name, by.name),
                    None -> b"",
                  }),
                at: { module: c.module, span: def.span },
              }),
            },
        }
      },
      _ -> c,
    })

/// One `numeric for T by { .. }`: the type is a sum of this module's own that takes no parameters
/// and states it once, the record names each operation once, and each function is one of this
/// module's that takes and answers the type alone and only answers.
fn check_numeric(checker: Checker, m: ParsedModule, def: NumericDef) -> Checker / {abort.raise} = {
  let type_name = qualify(m.name, def.target.name);
  let named = |text: Bytes| Bytes::concat_all([b"`", def.target.name, text]);
  match checker.types.get(type_name) {
    None ->
      report_error_at(
        checker,
        b"E0208",
        def.target.span,
        named(b"` is not a type this module declares"),
        b"declared in another module, or not at all",
        [
          b"a `numeric` may only name a type its own module declares, so that an operator means one thing wherever the type's values meet it",
        ],
      ),
    Some(decl) -> match decl.declared {
      DeclaredAlias(_) ->
        not_a_sum(
          checker,
          def.target,
          decl,
          named(b"` is not a sum, and a `numeric` is for one"),
          b"an alias is the type it names, so a `numeric` for one would be for every value of that type",
        ),
      DeclaredRecord(_) ->
        not_a_sum(
          checker,
          def.target,
          decl,
          named(b"` is a `new` record, which cannot state a `numeric` yet"),
          b"a `new` record runs as the record it is written as, so nothing in a value says which type's arithmetic an operator over it is",
        ),
      DeclaredSum -> if decl.params.len() + decl.labels.len() + decl.rows.len() > 0 {
        report_error_at_and(
          checker,
          b"E0216",
          def.target.span,
          named(b"` takes parameters, and a `numeric` is for a type that takes none"),
          b"a type with parameters",
          { module: decl.owner, span: decl.span },
          b"declared here",
          [
            b"an operator calls the type's functions with its values alone, and `numeric_of_int` with none: nothing there says what a parameter is, or fills a constraint on one",
          ],
        )
      } else {
        match numeric_of(checker.numeric_types, type_name) {
          Some(first) -> if first.at.span != def.span {
            report_error_at_and(
              checker,
              b"E0105",
              def.span,
              named(b"` states its `numeric` twice"),
              b"stated again here",
              first.at,
              b"first stated here",
              [b"a type has one, so that nothing has to choose between two; remove one"],
            )
          } else {
            let listed: Checker = numeric_listed(checker, def);
            if listed.diags.len() > checker.diags.len() { listed } else {
              def.ops.fold(listed, |c: Checker, x: NumericOp|
                numeric_fitted(c, m, def, type_name, x))
            }
          },
          None -> checker,
        }
      },
    },
  }
}

/// The record names each operation once, and nothing else.
fn numeric_listed(checker: Checker, def: NumericDef) -> Checker / {abort.raise} = {
  let why = b"a `numeric` names a function for each of `add`, `sub`, `mul`, `neg` and `of_int`, once: `+`, binary `-`, `*`, unary `-`, and what `numeric_of_int` calls";
  let named = range(0, def.ops.len()).fold(checker, |c: Checker, i: Int| {
    let x = def.ops.get(i);
    if !numeric_ops().contains(x.op.name) {
      report_error_at(
        c,
        b"E0215",
        x.op.span,
        Bytes::concat_all([b"`", x.op.name, b"` is no operation a `numeric` states"]),
        b"not one of the five",
        [why],
      )
    } else if range(0, i).fold(false, |seen: Bool, j: Int|
        seen || def.ops.get(j).op.name == x.op.name) {
      report_error_at(
        c,
        b"E0215",
        x.op.span,
        Bytes::concat_all([b"this `numeric` names `", x.op.name, b"` twice"]),
        b"named again here",
        [why],
      )
    } else { c }
  });
  let missing = numeric_ops().filter(|op: Bytes| numeric_by(def, op) == None);
  if missing.len() == 0 { named } else {
    report_error_at(
      named,
      b"E0215",
      def.span,
      Bytes::concat_all([
        b"this `numeric` names no function for ",
        Bytes::join(missing.map(backticked_text), b", "),
      ]),
      b"an operation is missing",
      [why],
    )
  }
}

/// What `x`'s function takes, and that it answers the type: `(T, T) -> T`, `(T) -> T` for `neg`,
/// `(Int) -> T` for `of_int`.
fn numeric_fitted(
  checker: Checker,
  m: ParsedModule,
  def: NumericDef,
  type_name: Bytes,
  x: NumericOp,
) -> Checker / {abort.raise} =
  match def_of(checker, qualify(m.name, x.by.name)) {
    None ->
      report_error_at(
        checker,
        b"E0101",
        x.by.span,
        Bytes::concat_all([b"`", x.by.name, b"` is not a function this module declares"]),
        b"a `numeric` names functions of its type's own module",
        [],
      ),
    Some(f) -> {
      let own = named_type(type_name);
      let takes = if x.op.name == b"of_int" { [int_type()] }
      else if x.op.name == b"neg" { [own] }
      else { [own, own] };
      let unfit = |why: Bytes, note: Bytes|
        err_labels(
          checker,
          b"E0218",
          Bytes::concat_all([
            b"`",
            x.by.name,
            b"` cannot be the `",
            x.op.name,
            b"` of `",
            def.target.name,
            b"`",
          ]),
          [
            label_at(checker.module, x.by.span, true, why),
            label_at(f.at.module, f.at.span, false, b"the function it names"),
          ],
          [
            note,
            Bytes::concat_all([
              b"`",
              x.op.name,
              b"` is `",
              type_text(TyFn({ params: takes, ret: own, effects: row_empty() })),
              b"`",
            ]),
          ],
        );
      match resolve(checker, f.scheme.ty) {
        TyFn(sig) -> if f.constraints.len() > 0 || f.scheme.ty_vars.len() > 0
            || f.scheme.row_vars.len() > 0
            || f.scheme.label_vars.len() > 0 {
          unfit(
            b"this function binds a parameter of its own",
            b"an operator calls it with the values alone, so no call fills a type, a row, a label or a constraint",
          )
        } else if sig.params != takes || sig.ret != own {
          unfit(
            Bytes::concat_all([
              b"this function is `",
              type_text(resolve(checker, f.scheme.ty)),
              b"`",
            ]),
            b"an operator takes and answers the type it is at",
          )
        } else if !row_is_pure(sig.effects) {
          unfit(
            Bytes::concat_all([b"this function's row is `", row_text(sig.effects), b"`"]),
            b"an operator at a number performs nothing, cannot raise and always returns, as `+` does at `Int`, so `a + b` gains no row where the type is this one",
          )
        } else { checker },
        _ -> checker,
      }
    },
  }

fn first_key_loop(
  tys: List<Type>,
  instances: List<InstanceInfo>,
  adts: Shapes,
  path: List<Bytes>,
  room: Int,
) -> Option<List<Bytes>> / {abort.raise} =
  tys.fold(None, |acc: Option<List<Bytes>>, ty: Type|
    match acc { Some(_) -> acc, None -> key_loop(ty, instances, adts, path, room) })

/// The declared types a comparison of `ty` reads on the way back to a keyed one it is already
/// inside: a type that states a `key` is read as what the key answers, and any other as its fields.
/// `path` is the types entered, and `room` how many more the walk may enter.
fn key_loop(
  ty: Type,
  instances: List<InstanceInfo>,
  adts: Shapes,
  path: List<Bytes>,
  room: Int,
) -> Option<List<Bytes>> / {abort.raise} =
  match ty {
    TyVar(_) -> None,
    TyFn(_) -> None,
    TyRecord(fs) -> first_key_loop(fs.map(|f: Field| f.ty), instances, adts, path, room),
    TyNominal(n) -> first_key_loop(n.fields.map(|f: Field| f.ty), instances, adts, path, room),
    TyCon(c) -> match instance_of(instances, c.name, true) {
      Some(x) -> if path.contains(c.name) { Some(path.push(c.name)) } else {
        if room <= 0 { None } else {
          key_loop(
            at_arguments(x.answers, x.params, x.rows, c.args),
            instances,
            adts,
            path.push(c.name),
            room - 1,
          )
        }
      },
      None -> match find_adt(adts, c.name) {
        None -> first_key_loop(c.args, instances, adts, path, room),
        Some(adt) -> if path.contains(c.name) { None } else {
          if room <= 0 { None } else {
            first_key_loop(
              adt.fields.map(|f: Type| at_arguments(f, adt.params, adt.rows, c.args)),
              instances,
              adts,
              path.push(c.name),
              room - 1,
            )
          }
        },
      },
    },
  }

/// Every `key` and `show` the program states. A key's type is ordered and hashed, so one function
/// decides `==`, `compare` and `digest` alike, and is not read through its own type again.
fn check_instances(checker: Checker) -> Checker / {abort.raise} = {
  let stated: Checker = range(0, checker.modules.len()).fold(checker, |c: Checker, i: Int| {
    let m = c.modules.get(i);
    m.module.items.fold(c, |cc: Checker, item: Item|
      match item {
        IInstance(def) -> check_instance({ ..cc, module: i }, m, def),
        INumeric(def) -> check_numeric({ ..cc, module: i }, m, def),
        _ -> cc,
      })
  });
  if stated.instances.len() == 0 { { ..stated, module: checker.module } } else {
    let adts = algebraic_shapes(stated);
    let shapes = deriver_shapes(stated.instances, adts);
    let judged: Checker = stated.instances.fold(stated, |c: Checker, x: InstanceInfo|
      if !is_key(x.kind) { c } else {
        let simple = simple_name_of(x.type_name);
        match key_loop(x.answers, stated.instances, adts, [x.type_name], adts.len() + 1) {
          Some(path) ->
            report(
              c,
              error_at(
                b"E0219",
                x.at.module,
                x.at.span,
                Bytes::concat_all([
                  b"`",
                  simple,
                  b"` is compared through a key that holds `",
                  simple,
                  b"`",
                ]),
                Bytes::concat_all([b"this key answers `", type_text(x.answers), b"`"]),
                [
                  Bytes::concat_all([
                    b"comparing two of them reads ",
                    Bytes::join(
                      path.map(|n: Bytes| backticked_text(simple_name_of(n))),
                      b", then ",
                    ),
                    b", and so never ends",
                  ]),
                  Bytes::concat_all([b"answer a type that holds no `", simple, b"`"]),
                ],
              ),
            ),
          None ->
            [DOrd, DHash].fold(c, |cc: Checker, deriver: Deriver|
              if cc.diags.len() > c.diags.len() { cc } else {
                match derivable(deriver, x.answers, shapes_for(shapes, deriver), x.params) {
                  None -> cc,
                  Some(blocked) -> {
                    let blocker = type_text(blocked.ty);
                    report(
                      cc,
                      error_at(
                        b"E0206",
                        x.at.module,
                        x.at.span,
                        Bytes::concat_all([
                          b"`",
                          blocker,
                          b"` has no ",
                          what_of(deriver),
                          b", so it cannot be the key of `",
                          simple,
                          b"`",
                        ]),
                        Bytes::concat_all([b"this key answers `", type_text(x.answers), b"`"]),
                        why_notes_for_derive(blocked.why, deriver, blocked, blocker).push(
                          b"one key decides `==`, `compare`, `digest` and a `Map`'s order, so what it answers is ordered and hashed",
                        ),
                      ),
                    )
                  },
                }
              }),
        }
      });
    { ..judged, module: checker.module }
  }
}

/// Anything a generated definition failed on, other than a name it could not see, is Ply's fault.
fn attribute_generated(checker: Checker) -> Checker / {abort.raise} = {
  let spans = range(0, checker.modules.len()).fold([], |acc: List<Label>, i: Int|
    checker.modules.get(i).derived.fold(acc, |labels: List<Label>, d: Derived|
      labels.push(label_at(i, d.span, true, b""))));
  if spans.len() == 0 { checker } else {
    {
      ..checker,
      diags: checker.diags.map(|d: Diag| {
        let primary = d.labels.fold(None, |acc: Option<Label>, l: Label|
          match acc { Some(_) -> acc, None -> if l.primary { Some(l) } else { None } });
        let generated = match primary {
          Some(p) ->
            spans.fold(false, |b: Bool, s: Label|
              b || (s.module == p.module && s.start == p.start && s.end == p.end)),
          None -> false,
        };
        if d.code == b"E0206" || !generated { d } else {
          {
            code: b"E0505",
            notes: d.notes + 2,
            labels: d.labels,
            text: d.text,
            message: b"a derived definition does not typecheck",
            notes_text: push_front_bytes(
              b"this is a compiler bug in the deriver: ".concat(d.message),
              d.notes_text,
            ).push(
              b"derivation is total, so a generated body that fails to check is Ply's fault rather than yours",
            ),
            severity: d.severity,
            fixes: d.fixes,
          }
        }
      }),
    }
  }
}

// --- Comparisons, simulations and regions, once the module is solved ------------------------------

/// A row a declared type is given is no function: the ones it holds are its fields'.
fn contains_fn(t: Type) -> Bool =
  match t {
    TyFn(_) -> !over_arg(t),
    TyCon(c) -> c.args.fold(false, |b: Bool, a: Type| b || contains_fn(a)),
    TyRecord(fs) -> fs.fold(false, |b: Bool, field: Field| b || contains_fn(field.ty)),
    TyNominal(n) -> n.fields.fold(false, |b: Bool, field: Field| b || contains_fn(field.ty)),
    TyVar(_) -> false,
  }

fn push_front_bytes(x: Bytes, xs: List<Bytes>) -> List<Bytes> =
  xs.fold([x], |acc: List<Bytes>, y: Bytes| acc.push(y))

fn check_comparisons(checker: Checker) -> Checker / {abort.raise} =
  checker.comparisons.fold(
    { ..checker, comparisons: [] },
    |c: Checker, site: { module: Int, span: Span, ty: Type }| {
      let resolved = resolve(c, site.ty);
      if contains_fn(resolved) {
        report(
          c,
          error_at(
            b"E0201",
            site.module,
            site.span,
            b"functions cannot be compared for equality",
            Bytes::concat_all([b"both sides have type `", type_text(resolved), b"`"]),
            [b"compare the results of calling them instead"],
          ),
        )
      } else if holds_con(resolved, b"Hold") {
        report(
          c,
          error_at(
            b"E0201",
            site.module,
            site.span,
            b"a hold cannot be compared for equality",
            Bytes::concat_all([b"both sides have type `", type_text(resolved), b"`"]),
            [
              b"a hold is a key to what its region will release, not a value: compare what `Hold::get` reads of each instead",
            ],
          ),
        )
      } else { c }
    },
  )

fn is_dummy(span: Span) -> Bool = span.start == 0 && span.end == 0

fn encloses(outer: Span, inner: Span) -> Bool =
  !is_dummy(outer) && !is_dummy(inner) && outer.start <= inner.start && inner.end <= outer.end

/// Branches run at once, so no two may touch one resource where either writes. A label parameter or
/// `[*]` may be any label, and a row variable any row.
fn check_parallels(checker: Checker) -> Checker / {abort.raise} =
  checker.parallels.fold({ ..checker, parallels: [] }, |c: Checker, site: ParallelSite| {
    let rows = site.branches.map(|b: { span: Span, row: Row }|
      { span: b.span, row: resolve_row_in(c, b.row) });
    match refusal(rows) {
      None -> c,
      Some(r) ->
        err_labels(
          c,
          b"E0309",
          r.message,
          r.labels.map(|l: { span: Span, primary: Bool, text: Bytes }|
            label_at(site.module, l.span, l.primary, l.text)),
          r.notes,
        ),
    }
  })

type Refusal = {
  message: Bytes,
  labels: List<{ span: Span, primary: Bool, text: Bytes }>,
  notes: List<Bytes>,
}

/// What keeps a block's branches from running at once: a region's schedule, a task's scheduler, or
/// a resource two of them touch.
fn refusal(rows: List<Branch>) -> Option<Refusal> / {abort.raise} = {
  let seed = seed_atom();
  let performing = |pick: (Atom) -> Bool|
    rows.fold(None, |acc: Option<{ branch: Branch, atom: Atom }>, b: Branch|
      match acc {
        Some(_) -> acc,
        None -> match b.row.atoms.filter(pick) {
          [atom, ..] -> Some({ branch: b, atom: atom }),
          [] -> None,
        },
      });
  let one = |p: { branch: Branch, atom: Atom }, message: Bytes, why: Bytes|
    Some({
      message: message,
      labels: [
        {
          span: p.branch.span,
          primary: true,
          text: b"this branch performs ".concat(backticked_text(atom_text(p.atom))),
        },
      ],
      notes: [why],
    });
  match performing(|atom: Atom| atom == seed) {
    Some(p) ->
      one(
        p,
        b"a `parallel` branch may not open a `simulate` region",
        b"a region's schedule is drawn from its entry's seed, in the order its regions open, which branches running at once do not have",
      ),
    None -> match performing(|atom: Atom| atom.effect == b"task") {
      Some(p) ->
        one(
          p,
          b"a `parallel` branch may not spawn, join or yield a task",
          b"a task is scheduled by the thread that spawned it, and a branch may run on another; spawn the tasks outside the block",
        ),
      None -> {
        let n = rows.len();
        let found = range(0, n).fold(None, |acc: Option<Clash>, j: Int|
          range(0, j).fold(acc, |inner: Option<Clash>, i: Int|
            match inner { Some(_) -> inner, None -> clash(rows.get(i), rows.get(j)) }));
        match found {
          None -> None,
          Some(k) ->
            Some({
              message: b"two branches of this `parallel` block may touch one resource",
              labels: [
                {
                  span: k.later.span,
                  primary: true,
                  text: b"this branch performs ".concat(k.later_does),
                },
                {
                  span: k.earlier.span,
                  primary: false,
                  text: b"and this one performs ".concat(k.earlier_does),
                },
              ],
              notes: [
                b"branches run at once, so two of them may not perform operations of one effect on one resource where either is a `write`",
                b"bind the branches with `let` in the order they must run, or move what they share out of the block",
              ],
            }),
        }
      },
    },
  }
}

type Branch = { span: Span, row: Row }

type Clash = { earlier: Branch, earlier_does: Bytes, later: Branch, later_does: Bytes }

fn may_alias(a: Resource, b: Resource) -> Bool =
  a == b || (match a { RVar(_) -> true, RAny -> true, _ -> false })
    || (match b { RVar(_) -> true, RAny -> true, _ -> false })

fn clash(x: Branch, y: Branch) -> Option<Clash> / {abort.raise} = {
  let atoms = x.row.atoms.fold(None, |acc: Option<Clash>, a: Atom|
    y.row.atoms.fold(acc, |inner: Option<Clash>, b: Atom|
      match inner {
        Some(_) -> inner,
        None -> if atom_conflicts({ ..a, resource: b.resource }, b)
            && may_alias(a.resource, b.resource) {
          Some({
            earlier: x,
            earlier_does: backticked_text(atom_text(a)),
            later: y,
            later_does: backticked_text(atom_text(b)),
          })
        } else { None },
      }));
  match atoms {
    Some(_) -> atoms,
    None -> {
      let open = |row: Row| row.tail != None;
      let busy = |row: Row| row.atoms.len() > 0 || row.tail != None;
      if (open(x.row) && busy(y.row)) || (open(y.row) && busy(x.row)) {
        Some({
          earlier: x,
          earlier_does: backticked_text(row_text(x.row)),
          later: y,
          later_does: backticked_text(row_text(y.row)),
        })
      } else { None }
    },
  }
}

fn check_simulations(checker: Checker) -> Checker / {abort.raise} = {
  let seed = seed_atom();
  let sites = checker.simulations;
  sites.fold({ ..checker, simulations: [] }, |c: Checker, site: Simulation| {
    let nested: Checker = if resolve_row_in(c, site.body_row).atoms.contains(seed) {
      nested_simulation(c, site, sites)
    } else { c };
    check_older_reads(
      check_entering(check_older_writes(check_simulation_exits(nested, site), site), site),
      site,
    )
  })
}

/// A task and a channel are keys into the scheduler of the region that made them.
fn scheduler_handle(name: Bytes) -> Bool = name == b"Task" || name == b"Chan"

/// A closure's captures are not in its type, and a cell's contents enter a region only when read.
fn holds_task(t: Type) -> Bool =
  match t {
    TyCon(c) ->
      scheduler_handle(c.name)
        || (c.name != b"Cell" && c.args.fold(false, |b: Bool, a: Type| b || holds_task(a))),
    TyRecord(fs) -> fs.fold(false, |b: Bool, field: Field| b || holds_task(field.ty)),
    TyNominal(n) -> n.fields.fold(false, |b: Bool, field: Field| b || holds_task(field.ty)),
    TyFn(_) -> false,
    TyVar(_) -> false,
  }

/// What a refusal says of the scheduler key `t` holds: a task, or else a channel.
type Keyed = { noun: Bytes, made: Bytes, numbered: Bytes, kept: Bytes }

fn keyed(ty: Type) -> Keyed =
  if holds_con(ty, b"Task") || !holds_con(ty, b"Chan") {
    {
      noun: b"task",
      made: b"spawned",
      numbered: b"a `Task` is a key into the scheduler that spawned it, and this region's scheduler numbers its own tasks, so the key names one of them or none",
      kept: b"`join` the task inside the region and return its value instead",
    }
  } else {
    {
      noun: b"channel",
      made: b"made",
      numbered: b"a `Chan` is a key into the scheduler that made it, and this region's scheduler numbers its own channels, so the key names one of them or none",
      kept: b"receive from the channel inside the region and return what it held instead",
    }
  }

/// Whether `t` holds a `name`, in its shape or as the operations a closure's row shows for one.
fn holds_con(t: Type, name: Bytes) -> Bool =
  match t {
    TyCon(c) -> c.name == name || c.args.fold(false, |b: Bool, a: Type| b || holds_con(a, name)),
    TyRecord(fs) -> fs.fold(false, |b: Bool, f: Field| b || holds_con(f.ty, name)),
    TyNominal(n) -> n.fields.fold(false, |b: Bool, f: Field| b || holds_con(f.ty, name)),
    TyFn(f) ->
      List::fold(
        if name == b"Task" { [b"join", b"await", b"cancel"] } else { channel_ops() },
        f.params.fold(holds_con(f.ret, name), |b: Bool, p: Type| b || holds_con(p, name)),
        |b: Bool, op: Bytes| b || atoms_covered(f.effects.atoms, task_op(op)),
      ),
    TyVar(_) -> false,
  }

fn entered(ty: Type) -> Bytes = {
  let k = keyed(ty);
  Bytes::concat_all([
    b"a ",
    k.noun,
    b" enters a `simulate` region that did not ",
    made_verb(k),
    b" it",
  ])
}

fn made_verb(k: Keyed) -> Bytes = if k.noun == b"task" { b"spawn" } else { b"make" }

fn own_scheduler(site: Simulation) -> Label =
  label_at(
    site.module,
    site.span,
    false,
    b"the `simulate` region opens here, with a scheduler of its own",
  )

fn check_entering(checker: Checker, site: Simulation) -> Checker / {abort.raise} =
  site.entering.fold(checker, |c: Checker, x: { name: Bytes, span: Span, ty: Type }|
    err_labels(
      c,
      b"E0413",
      entered(x.ty),
      [
        label_at(
          site.module,
          x.span,
          true,
          Bytes::concat_all([
            b"`",
            x.name,
            b"` has type `",
            type_text(x.ty),
            b"`, and it was bound outside the region",
          ]),
        ),
        own_scheduler(site),
      ],
      [
        keyed(x.ty).numbered,
        if keyed(x.ty).noun == b"task" {
          b"spawn the task inside the region, or join it where it was spawned and pass in what it answers"
        } else { b"make the channel inside the region, or pass in what was received from it" },
      ],
    ))

/// A region that also writes the cell is refused for the write, whose remedy covers the read.
fn check_older_reads(checker: Checker, site: Simulation) -> Checker / {abort.raise} =
  site.older.fold(checker, |c: Checker, opened: Opened|
    match first_access(site.reads, opened.label) {
      None -> c,
      Some(read_span) -> if first_access(site.writes, opened.label) != None { c } else {
        match task_holder(c, site.cells, opened.label) {
          None -> c,
          Some(b) ->
            err_labels(
              c,
              b"E0413",
              entered(b.ty),
              [
                label_at(
                  site.module,
                  read_span,
                  true,
                  Bytes::concat_all([
                    b"this reads `",
                    opened.name,
                    b"`, where `",
                    b.name,
                    b"` has type `",
                    type_text(b.ty),
                    b"`",
                  ]),
                ),
                label_at(
                  site.module,
                  opened.span,
                  false,
                  Bytes::concat_all([b"`", opened.name, b"` opens here, before the region"]),
                ),
                own_scheduler(site),
              ],
              [
                Bytes::concat_all([
                  b"`",
                  opened.name,
                  b"` outlives the region, so a ",
                  keyed(b.ty).noun,
                  b" its cells hold was ",
                  keyed(b.ty).made,
                  b" outside it",
                ]),
                keyed(b.ty).numbered,
                b"open the cell inside the `simulate` region, or keep what the tasks answered in it instead of the tasks",
              ],
            ),
        }
      },
    })

fn check_simulation_exits(checker: Checker, site: Simulation) -> Checker / {abort.raise} = {
  let ty = resolve(checker, site.body_ty);
  if !brand_in(ty, Tasks) { checker } else {
    let k = keyed(ty);
    let key = if k.noun == b"task" {
      b"a `Task` is a key into the region's scheduler, and the scheduler ends with the region"
    } else {
      b"a `Chan` is a key into the region's scheduler, and the scheduler ends with the region"
    };
    let fix = k.kept;
    err_labels(
      checker,
      b"E0413",
      Bytes::concat_all([b"a ", k.noun, b" escapes the `simulate` region that ", k.made, b" it"]),
      exit_labels(site.module, site.exits, site.body_span, ty),
      if carries_brand_in_row(ty, Tasks) {
        [
          key,
          b"the closure's row still carries a `task` operation or `sim.read`, so calling it after the region reaches a scheduler that has ended",
          fix,
        ]
      } else { [key, fix] },
    )
  }
}

/// `Task` is written in types, so a store into a cell typed to hold one shows only as the write.
fn check_older_writes(checker: Checker, site: Simulation) -> Checker / {abort.raise} =
  site.older.fold(checker, |c: Checker, opened: Opened|
    match first_access(site.writes, opened.label) {
      None -> c,
      Some(write_span) -> match task_holder(c, site.cells, opened.label) {
        None -> c,
        Some(b) ->
          err_labels(
            c,
            b"E0446",
            Bytes::concat_all([
              b"a ",
              keyed(b.ty).noun,
              b" ",
              keyed(b.ty).made,
              b" in a `simulate` region is stored where it outlives the region",
            ]),
            [
              label_at(
                site.module,
                write_span,
                true,
                Bytes::concat_all([
                  b"this writes to `",
                  opened.name,
                  b"`, where `",
                  b.name,
                  b"` has type `",
                  type_text(b.ty),
                  b"`",
                ]),
              ),
              label_at(
                site.module,
                opened.span,
                false,
                Bytes::concat_all([b"`", opened.name, b"` opens here, before the region"]),
              ),
              label_at(
                site.module,
                site.span,
                false,
                b"the `simulate` region opens here, and its scheduler ends at its `}`",
              ),
            ],
            [
              Bytes::concat_all([
                b"`",
                opened.name,
                b"` outlives the region's scheduler, so what the region stores in its cells may not mention a `Task` or a `Chan`",
              ]),
              if keyed(b.ty).noun == b"task" {
                b"open the cell inside the `simulate` region, or join the task there and store what it answers"
              } else {
                b"open the cell inside the `simulate` region, or receive from the channel there and store what it gives"
              },
            ],
          ),
      },
    })

fn first_access(xs: List<CellAccess>, region: Bytes) -> Option<Span> =
  xs.fold(None, |acc: Option<Span>, w: CellAccess|
    match acc { Some(_) -> acc, None -> if w.region == region { Some(w.span) } else { None } })

fn task_holder(
  checker: Checker,
  cells: List<{ name: Bytes, ty: Type }>,
  region: Bytes,
) -> Option<{ name: Bytes, ty: Type }> / {abort.raise} =
  cells.fold(None, |acc: Option<{ name: Bytes, ty: Type }>, b: { name: Bytes, ty: Type }|
    match acc {
      Some(_) -> acc,
      None -> {
        let ty = resolve(checker, b.ty);
        if holds_tasks(ty, region) { Some({ name: b.name, ty: ty }) } else { None }
      },
    })

fn holds_tasks(t: Type, region: Bytes) -> Bool / {abort.raise} =
  match t {
    TyCon(c) ->
      (c.name == b"Cell" && c.args.len() == 2 && label_of(c.args.get(0)) == Some(region)
        && brand_in(c.args.get(1), Tasks))
        || c.args.fold(false, |b: Bool, a: Type| b || holds_tasks(a, region)),
    TyRecord(fs) -> fs.fold(false, |b: Bool, field: Field| b || holds_tasks(field.ty, region)),
    TyNominal(n) ->
      n.fields.fold(false, |b: Bool, field: Field| b || holds_tasks(field.ty, region)),
    TyFn(_) -> false,
    TyVar(_) -> false,
  }

fn exit_labels(
  module: Int,
  exits: List<Span>,
  body_span: Span,
  ty: Type,
) -> List<Label> / {abort.raise} = {
  let shown = type_text(ty);
  List::map(if exits.len() == 0 { [body_span] } else { exits }, |span: Span|
    label_at(module, span, true, Bytes::concat_all([b"this has type `", shown, b"`"])))
}

fn nested_simulation(checker: Checker, site: Simulation, sites: List<Simulation>) -> Checker = {
  let inner = sites.fold(None, |acc: Option<Simulation>, other: Simulation|
    match acc {
      Some(_) -> acc,
      None -> if other.module == site.module && other.span != site.span
          && encloses(site.body_span, other.span) { Some(other) }
      else { None },
    });
  let message = b"a `simulate` region inside another `simulate` region";
  let primary = label_at(site.module, site.span, true, b"this region's body reaches `sim.read`");
  let tail = [
    b"two schedulers means two notions of `runnable`, and a task in the inner region blocking the outer one",
    b"hoist the inner region out, or drop it and let the outer one schedule",
  ];
  match inner {
    Some(o) ->
      err_labels(
        checker,
        b"E0416",
        message,
        [primary, label_at(o.module, o.span, false, b"the region it reaches is here")],
        tail,
      ),
    None ->
      report(
        checker,
        error_with_labels(
          b"E0416",
          message,
          [primary],
          push_front_bytes(
            b"something this body calls carries `sim.read`, so it enters a region too",
            tail,
          ),
        ),
      ),
  }
}

fn task_op(op: Bytes) -> Atom =
  { effect: b"task", resource: RSingleton, mode: MWrite, op: Some(op) }

/// A cell is reached by atoms naming its region; a task only by a join, an await or a cancel, a
/// channel by a send, a receive, a close or a select, and either by a `simulate` around one.
fn row_brands(row: Row, brand: Brand) -> Bool =
  match brand {
    CellsOf(r) ->
      row.atoms.fold(false, |b: Bool, atom: Atom|
        b || (atom.effect == cell() && atom.resource == RNamed(r))),
    HoldsOf(r) ->
      row.atoms.fold(false, |b: Bool, atom: Atom|
        b || (atom.effect == hold() && atom.resource == RNamed(r))),
    Tasks ->
      [b"join", b"await", b"cancel"].concat(channel_ops()).fold(
        atoms_covered(row.atoms, seed_atom()),
        |b: Bool, op: Bytes| b || atoms_covered(row.atoms, task_op(op)),
      ),
  }

/// Whether a resolved type carries a region's brand, by either route a brand travels.
fn brand_in(t: Type, brand: Brand) -> Bool / {abort.raise} =
  match t {
    TyVar(_) -> false,
    TyCon(c) ->
      (match brand {
          CellsOf(r) -> label_of(t) == Some(r),
          HoldsOf(r) -> label_of(t) == Some(r),
          Tasks -> scheduler_handle(c.name),
        })
        || c.args.fold(false, |b: Bool, a: Type| b || brand_in(a, brand)),
    TyFn(f) ->
      row_brands(f.effects, brand)
        || f.params.fold(false, |b: Bool, p: Type| b || brand_in(p, brand))
        || brand_in(f.ret, brand),
    TyRecord(fs) -> fs.fold(false, |b: Bool, f: Field| b || brand_in(f.ty, brand)),
    TyNominal(n) -> n.fields.fold(false, |b: Bool, f: Field| b || brand_in(f.ty, brand)),
  }

/// Whether the brand reached this type through a function's row rather than through its shape.
fn carries_brand_in_row(t: Type, brand: Brand) -> Bool =
  match t {
    TyVar(_) -> false,
    TyCon(c) -> c.args.fold(false, |b: Bool, a: Type| b || carries_brand_in_row(a, brand)),
    TyFn(f) ->
      row_brands(f.effects, brand)
        || f.params.fold(false, |b: Bool, p: Type| b || carries_brand_in_row(p, brand))
        || carries_brand_in_row(f.ret, brand),
    TyRecord(fs) -> fs.fold(false, |b: Bool, f: Field| b || carries_brand_in_row(f.ty, brand)),
    TyNominal(n) ->
      n.fields.fold(false, |b: Bool, f: Field| b || carries_brand_in_row(f.ty, brand)),
  }

fn check_regions(checker: Checker) -> Checker / {abort.raise} =
  checker.regions.fold({ ..checker, regions: [] }, |c: Checker, site: RegionSite|
    check_region_handoffs(
      check_region_spawns(check_region_stores(check_region_exits(c, site), site), site),
      site,
    ))

fn brand_of(site: RegionSite) -> Brand =
  if site.hold { HoldsOf(site.label) } else { CellsOf(site.label) }

fn region_form(site: RegionSite) -> Bytes = if site.hold { b"with_hold" } else { b"with_cell" }

/// The value the region evaluates to; a `with_cell` reports the escape as `E0201`.
fn check_region_exits(checker: Checker, site: RegionSite) -> Checker / {abort.raise} = {
  let ty = resolve(checker, site.body_ty);
  let n = site.name;
  if !brand_in(ty, brand_of(site)) { checker } else if site.hold {
    err_labels(
      checker,
      b"E0446",
      Bytes::concat_all([b"a hold escapes its `with_hold[", n, b"]` region"]),
      exit_labels(site.module, site.exits, site.body_span, ty),
      if carries_brand_in_row(ty, brand_of(site)) {
        [
          b"the closure's row still carries `hold.read`, so calling it after the region reads a hold the region has let go",
          b"call the closure inside the region and return what it answers instead",
        ]
      } else {
        [
          Bytes::concat_all([
            b"the region releases what the hold holds at its `}`, so the hold names nothing after it",
          ]),
          b"read the hold inside the region and return what the body made of it instead",
        ]
      },
    )
  } else {
    let carries = if carries_brand_in_row(ty, brand_of(site)) {
      [
        Bytes::concat_all([
          b"the closure's row still carries `cell.read[",
          n,
          b"]` or `cell.write[",
          n,
          b"]`, so it reads or writes a cell the region frees",
        ]),
      ]
    } else { [] };
    err_labels(
      checker,
      b"E0201",
      Bytes::concat_all([b"the cell escapes its `with_cell[", n, b"]` region"]),
      exit_labels(site.module, site.exits, site.body_span, ty),
      carries.push(b"read the cell inside the region and return the value instead"),
    )
  }
}

fn opens_here(n: Bytes) -> Bytes =
  Bytes::concat_all([b"`", n, b"` opens here and is freed at its `}`"])

fn check_region_stores(checker: Checker, site: RegionSite) -> Checker / {abort.raise} =
  site.outer.fold(checker, |c: Checker, b: OuterBinding| {
    let ty = resolve(c, b.ty);
    if brand_in(ty, brand_of(site)) {
      err_labels(
        c,
        b"E0446",
        Bytes::concat_all([
          b"a value allocated in region `",
          site.name,
          b"` is stored where it outlives the region",
        ]),
        [
          label_at(
            site.module,
            b.site,
            true,
            Bytes::concat_all([
              b"`",
              b.name,
              b"` has type `",
              type_text(ty),
              b"`, and it was bound before `",
              site.name,
              b"` opened",
            ]),
          ),
          label_at(site.module, site.span, false, opens_here(site.name)),
        ],
        [
          Bytes::concat_all([
            b"storing into `",
            b.name,
            b"` outlives the region, so what is stored may not mention `",
            site.name,
            b"`",
          ]),
        ],
      )
    } else { c }
  })

fn outlived() -> List<Bytes> =
  [
    b"the scheduler that runs the task was installed outside the region, so the task can still be running when the region's memory is gone",
    b"a `join` inside the region is not enough: nothing in the types says the task was joined, and a task nobody joins runs on after the region's `}`",
  ]

fn check_region_spawns(checker: Checker, site: RegionSite) -> Checker / {abort.raise} =
  site.spawns.fold(checker, |c: Checker, s: SpawnSite| {
    let ty = resolve(c, s.ty);
    if brand_in(ty, brand_of(site)) {
      err_labels(
        c,
        b"E0446",
        Bytes::concat_all([
          b"a value allocated in region `",
          site.name,
          b"` is sent to another task",
        ]),
        [
          label_at(
            site.module,
            s.span,
            true,
            Bytes::concat_all([b"this has type `", type_text(ty), b"`"]),
          ),
          label_at(site.module, site.span, false, opens_here(site.name)),
        ],
        outlived().push(
          Bytes::concat_all([
            b"open the `simulate` region inside `",
            region_form(site),
            b"[",
            site.name,
            b"]`, or pass the task something that does not mention `",
            site.name,
            b"`",
          ]),
        ),
      )
    } else {
      match reaching_clause(c, ty, s.around, brand_of(site)) {
        None -> c,
        Some(cl) -> {
          let op = backticked_text(
            Bytes::concat_all([
              as_written({ ..c, module: site.module }, cl.op.effect),
              b".",
              match cl.op.op { Some(o) -> o, None -> mode_text(cl.op.mode) },
            ]),
          );
          err_labels(
            c,
            b"E0446",
            Bytes::concat_all([
              b"a value allocated in region `",
              site.name,
              b"` reaches another task through a handler around its spawn",
            ]),
            [
              label_at(
                site.module,
                s.span,
                true,
                Bytes::concat_all([
                  b"this task performs ",
                  op,
                  b", which a handler around the spawn answers",
                ]),
              ),
              label_at(
                site.module,
                cl.span,
                false,
                Bytes::concat_all([b"this clause answers it, and reaches `", site.name, b"`"]),
              ),
              label_at(site.module, site.span, false, opens_here(site.name)),
            ],
            [
              b"a task performs against the handlers around its `task.spawn`, so the clause runs on the task's behalf, whenever the task runs",
            ].concat(
              outlived().push(
                Bytes::concat_all([
                  b"open the `simulate` region inside `",
                  region_form(site),
                  b"[",
                  site.name,
                  b"]`, or answer ",
                  op,
                  b" without touching `",
                  site.name,
                  b"`",
                ]),
              ),
            ),
          )
        },
      }
    }
  })

/// The first clause around a spawn that its task can perform against and that reaches the region.
fn reaching_clause(
  checker: Checker,
  task: Type,
  around: List<ClauseSite>,
  brand: Brand,
) -> Option<ClauseSite> / {abort.raise} =
  around.fold(None, |acc: Option<ClauseSite>, cl: ClauseSite|
    match acc {
      Some(_) -> acc,
      None -> if may_perform(task, cl.op) && brand_in(resolve(checker, cl.ty), brand) { Some(cl) }
      else { None },
    })

/// On any label: an open row may perform anything.
fn may_perform(task: Type, op: Atom) -> Bool =
  match task {
    TyFn(f) ->
      f.effects.tail != None
        || f.effects.atoms.fold(false, |b: Bool, a: Atom|
          b
            || (a.effect == op.effect
            && (a.op == op.op || (a.op == None && mode_eq(a.mode, op.mode))))),
    _ -> true,
  }

fn check_region_handoffs(checker: Checker, site: RegionSite) -> Checker / {abort.raise} =
  site.handoffs.fold(checker, |c: Checker, h: HandoffSite| {
    let ty = resolve(c, h.ty);
    if !brand_in(ty, brand_of(site)) { c } else {
      let n = site.name;
      let carries = if site.hold {
        if carries_brand_in_row(ty, brand_of(site)) {
          [
            b"the closure's row still carries `hold.read`, so whoever handles the operation can read a hold the region has let go",
          ]
        } else { [] }
      } else if carries_brand_in_row(ty, brand_of(site)) {
        [
          Bytes::concat_all([
            b"the closure's row still carries `cell.read[",
            n,
            b"]` or `cell.write[",
            n,
            b"]`, so whoever handles the operation can read or write a value the region frees",
          ]),
        ]
      } else { [] };
      err_labels(
        c,
        b"E0446",
        Bytes::concat_all([b"a value allocated in region `", n, b"` is handed to `", h.op, b"`"]),
        [
          label_at(
            site.module,
            h.span,
            true,
            Bytes::concat_all([b"this has type `", type_text(ty), b"`"]),
          ),
          label_at(site.module, site.span, false, opens_here(n)),
        ],
        carries.concat([
          Bytes::concat_all([
            b"`",
            h.op,
            b"` is declared outside every region, so its type cannot say the value belongs to `",
            n,
            b"`, and the handler \xe2\x80\x94 which may be installed anywhere, and may outlive the region \xe2\x80\x94 receives it at a type variable that mentions no region at all",
          ]),
          Bytes::concat_all([
            b"read the value inside the region and perform the operation with something that does not mention `",
            n,
            b"`",
          ]),
        ]),
      )
    }
  })

/// What the prelude declares that a program's check tables hold ahead of its own modules': its
/// effects and its constructors, in that order.
pub fn prelude_tables() -> { effects: List<EffectInfo>, ctors: List<CtorInfo> } / {abort.raise} = {
  let c = fresh_cx(
    {
      names: [],
      scopes: [],
      declarations: [],
      declared: [],
      order: [],
      imports: [],
      signatures: Map::new(),
      sees: [],
    },
    [],
    no_known(),
  );
  { effects: c.effects, ctors: c.ctors }
}

// --- `check_program` --------------------------------------------------------------------------------------

fn fresh_cx(resolved: Resolved, mods: List<ParsedModule>, known: Known) -> Checker / {abort.raise} =
  install_prelude({
    resolved: resolved,
    modules: mods,
    module: 0,
    subst: subst_new(),
    fresh: fresh_new(),
    env: env_new(),
    diags: [],
    types: Map::new(),
    effects: [],
    effect_index: Map::new(),
    ctors: [],
    ctor_index: Map::new(),
    defs: [],
    def_index: Map::new(),
    tests: [],
    laws: [],
    ty_params: Map::new(),
    row_params: Map::new(),
    label_params: Map::new(),
    label_apps: [],
    label_sites: [],
    group_defs: [],
    own_fns: Map::new(),
    refs: [],
    calls: [],
    tag_uses: [],
    fn_holding: Map::new(),
    auto_ty_params: false,
    alias_stack: [],
    aliases: Map::new(),
    nominals: Map::new(),
    refused_atoms: [],
    performs: [],
    over: None,
    maybe: [],
    repeated_vars: [],
    recursed: None,
    declared_atoms: [],
    guards: guards::none(),
    contracts: Map::new(),
    raise_notes: [],
    comparisons: [],
    scope: 0,
    constraints: Map::new(),
    numerics: [],
    bit_ops: [],
    operands: [],
    typed: [],
    witnessed: Map::new(),
    witness_refs: [],
    witness_orders: [],
    group_fills: [],
    summaries: Map::new(),
    concats: [],
    columns: [],
    updates: [],
    update_shapes: [],
    try_sites: [],
    member_sites: match known.walks { Given(_, sites) -> sites, _ -> [] },
    copied_defaults: [],
    builtins_on: Map::new(),
    simulate_depth: 0,
    sim_scope: 0,
    crossings: [],
    open_regions: [],
    regions: [],
    simulations: [],
    parallels: [],
    map_keys: [],
    constrained_uses: [],
    spec_kind: None,
    spec_envs: [],
    derived: None,
    known: known,
    seeded: [],
    seeded_tests: [],
    walking: b"",
    kept: [],
    bodies: [],
    assumed: [],
    instances: [],
    numeric_types: [],
    keyed_names: [],
    copied: false,
    cell_named: false,
    assignable: { vars: [], barred: None },
  })

/// `ok` is `false` when the program has an *error* in it. A warning is not one: the program
/// compiles and runs, and the warning is the reader's.
type Checked = { checker: Checker, ok: Bool }

pub fn check_program(resolved: Resolved, mods: List<ParsedModule>) -> Checked / {abort.raise} =
  check_program_with(resolved, mods, no_known())

/// Every diagnostic, deduplicated, when any is an error; a warning alone is not one.
pub fn check_diagnostics(
  resolved: Resolved,
  mods: List<ParsedModule>,
) -> List<Diag> / {abort.raise} = {
  let out = check_program(resolved, mods);
  if has_error(out.checker.diags) { dedup_diags(out.checker.diags) } else { [] }
}

/// What `check_program` publishes, prelude entries included, or the diagnostics when any is an error.
pub type CheckOutput = {
  ok: Bool,
  diags: List<Diag>,
  defs: List<DefInfo>,
  tests: List<TestInfo>,
  laws: List<LawInfo>,
  effects: List<EffectInfo>,
  ctors: List<CtorInfo>,
  /// The definitions published from the rows handed in rather than from a walk of their bodies.
  seeded: List<Bytes>,
  /// The same for tests, by key.
  seeded_tests: List<Bytes>,
  /// What the emitter reads of the bodies walked, and of each body published from its rows what
  /// those rows held, so no body it lowers is walked again.
  facts: EmitFacts,
  kept: List<KeptFacts>,
  instances: List<InstanceInfo>,
  numeric_types: List<NumericInfo>,
}

/// What a check of the program publishes, beside each body it walked as another check reads it.
pub fn check_front_with(
  resolved: Resolved,
  mods: List<ParsedModule>,
  known: Known,
) -> { checked: CheckOutput, bodies: List<WalkedBody> } / {abort.raise} = {
  let out = check_program_with(resolved, mods, known);
  let failed = has_error(out.checker.diags);
  {
    checked: {
      ok: !failed,
      diags: if failed { dedup_diags(out.checker.diags) } else { [] },
      defs: out.checker.defs.map(canonical_def),
      tests: out.checker.tests,
      laws: out.checker.laws,
      effects: out.checker.effects,
      ctors: out.checker.ctors,
      seeded: out.checker.seeded,
      seeded_tests: out.checker.seeded_tests,
      facts: facts_of(out.checker),
      kept: out.checker.kept,
      instances: out.checker.instances,
      numeric_types: out.checker.numeric_types,
    },
    bodies: out.checker.bodies,
  }
}

/// `d` with its variables numbered as its scheme's text names them: two checks that met them in
/// another order answer one value.
fn canonical_def(d: DefInfo) -> DefInfo / {abort.raise} = {
  let c = canonical_beside(
    d.scheme,
    [d.footprint, d.performed, d.scaling, d.bounded].concat(d.spec.map(|s: SpecInfo| s.footprint)),
  );
  {
    ..d,
    scheme: c.scheme,
    footprint: c.rows.get(0),
    performed: c.rows.get(1),
    scaling: c.rows.get(2),
    bounded: c.rows.get(3),
    spec: range(0, d.spec.len()).map(|i: Int| { ..d.spec.get(i), footprint: c.rows.get(4 + i) }),
  }
}

/// The one purity the root keys, the emitter's constant table and the seam's memo all read.
pub fn published_pure(def_info: DefInfo) -> Bool =
  without_raises(def_info.footprint).len() == 0 && def_info.constraints.len() == 0

/// What the emitter needs from the checker: the definitions published pure, for its constant table,
/// the labels every call fills, the shape of every record update, and every operator's operand type.
pub type EmitFacts = {
  pure: List<Bytes>,
  label_sites: List<LabelSite>,
  elaboration: Elaboration,
  operands: List<OperandSite>,
  typed: List<TypedSite>,
  types: TypeTable,
}

/// What lowering reads that only the checker knows: the shape of every record update, the raise
/// every `try` answers, and where a `numeric` or `integer` parameter's witness is read and what each
/// call passes for it.
pub type Elaboration = {
  updates: List<UpdateShape>,
  ops: List<WitnessOp>,
  refs: List<WitnessRef>,
  orders: List<WitnessOrder>,
  tries: List<TrySite>,
  members: List<MemberSite>,
}

fn elaboration_of(checker: Checker) -> Elaboration / {abort.raise} =
  if checker.copied_defaults.len() > 0 {
    panic("a default a call on a value copied was left untyped")
  } else { elaboration_in(lowered_only(checker)) }

fn elaboration_in(checker: Checker) -> Elaboration / {abort.raise} =
  {
    tries: checker.try_sites,
    members: checker.member_sites,
    updates: checker.update_shapes,
    ops: checker.operands.fold([], |acc: List<WitnessOp>, o: OperandAt|
      match resolve(checker, o.ty) {
        TyVar(v) -> match checker.witnessed.get(v) {
          Some(w) -> acc.push({ module: o.module, span: o.span, param: w.param, owner: o.owner }),
          None -> acc,
        },
        _ -> acc,
      }),
    refs: checker.witness_refs,
    orders: checker.witness_orders,
  }

// The facts cross from the program that checked to the one that lowers as bytes: a constructor's
// name is each program's own, its index in its type is not.
derive bin for UpdateShape
derive bin for TrySite
derive bin for MemberSite
derive bin for LabelSite
derive bin for OperandSite
derive bin for TypedSite
derive bin for WitnessOp
derive bin for WitnessRef
derive bin for WitnessOrder
derive bin for Elaboration
derive bin for EmitFacts

/// What the emitter reads of one body: the sites a walk of it recorded.
pub type RootFacts = {
  label_sites: List<LabelSite>,
  updates: List<UpdateShape>,
  ops: List<WitnessOp>,
  refs: List<WitnessRef>,
  operands: List<OperandSite>,
  tries: List<TrySite>,
  members: List<MemberSite>,
  typed: List<TypedSite>,
  types: TypeTable,
}

derive bin for RootFacts

pub fn no_root_facts() -> RootFacts =
  {
    label_sites: [],
    updates: [],
    ops: [],
    refs: [],
    operands: [],
    tries: [],
    members: [],
    typed: [],
    types: Map::new(),
  }

/// The nodes of `all` the types `sites` name are made of, which is all a table of them needs.
pub fn types_named(all: TypeTable, sites: List<TypedSite>) -> TypeTable =
  table_of(all, sites.fold([], |acc: List<Bytes>, s: TypedSite| acc.concat(s.args).push(s.ty)))

/// Both tables of types, as one.
pub fn types_joined(a: TypeTable, b: TypeTable) -> TypeTable = tables_joined(a, b)

fn owned(m: Map<Bytes, RootFacts>, owner: Bytes) -> RootFacts =
  match m.get(owner) { Some(f) -> f, None -> no_root_facts() }

/// Every site a walk recorded, under the definition or test whose body it was walking; a clause's
/// and a law's are under the empty name.
pub fn facts_by_owner(facts: EmitFacts) -> Map<Bytes, RootFacts> = {
  let labelled = facts.label_sites.fold(Map::new(), |m: Map<Bytes, RootFacts>, x: LabelSite| {
    let f = owned(m, x.owner);
    m.insert(x.owner, { ..f, label_sites: f.label_sites.push(x) })
  });
  let updated = facts.elaboration.updates.fold(
    labelled,
    |m: Map<Bytes, RootFacts>, x: UpdateShape| {
      let f = owned(m, x.owner);
      m.insert(x.owner, { ..f, updates: f.updates.push(x) })
    },
  );
  let witnessed = facts.elaboration.ops.fold(updated, |m: Map<Bytes, RootFacts>, x: WitnessOp| {
    let f = owned(m, x.owner);
    m.insert(x.owner, { ..f, ops: f.ops.push(x) })
  });
  let referenced = facts.elaboration.refs.fold(
    witnessed,
    |m: Map<Bytes, RootFacts>, x: WitnessRef| {
      let f = owned(m, x.owner);
      m.insert(x.owner, { ..f, refs: f.refs.push(x) })
    },
  );
  let tried = facts.elaboration.tries.fold(referenced, |m: Map<Bytes, RootFacts>, x: TrySite| {
    let f = owned(m, x.owner);
    m.insert(x.owner, { ..f, tries: f.tries.push(x) })
  });
  let called = facts.elaboration.members.fold(tried, |m: Map<Bytes, RootFacts>, x: MemberSite| {
    let f = owned(m, x.owner);
    m.insert(x.owner, { ..f, members: f.members.push(x) })
  });
  let operated = facts.operands.fold(called, |m: Map<Bytes, RootFacts>, x: OperandSite| {
    let f = owned(m, x.owner);
    m.insert(x.owner, { ..f, operands: f.operands.push(x) })
  });
  let typed = facts.typed.fold(operated, |m: Map<Bytes, RootFacts>, x: TypedSite| {
    let f = owned(m, x.owner);
    m.insert(x.owner, { ..f, typed: f.typed.push(x) })
  });
  typed.fold(Map::new(), |m: Map<Bytes, RootFacts>, owner: Bytes, f: RootFacts|
    m.insert(owner, { ..f, types: types_named(facts.types, f.typed) }))
}

fn moved_span(span: Span, by: Int) -> Span = { ..span, start: span.start + by, end: span.end + by }

/// `facts` with every span moved by `by` and filed under `owner` in `module`.
fn placed_facts(facts: RootFacts, module: Int, by: Int, owner: Bytes) -> RootFacts =
  {
    label_sites: facts.label_sites.map(|x: LabelSite|
      { ..x, module: module, span: moved_span(x.span, by), owner: owner }),
    updates: facts.updates.map(|x: UpdateShape|
      { ..x, module: module, span: moved_span(x.span, by), owner: owner }),
    ops: facts.ops.map(|x: WitnessOp|
      { ..x, module: module, span: moved_span(x.span, by), owner: owner }),
    refs: facts.refs.map(|x: WitnessRef|
      { ..x, module: module, span: moved_span(x.span, by), owner: owner }),
    operands: facts.operands.map(|x: OperandSite|
      { ..x, module: module, span: moved_span(x.span, by), owner: owner }),
    tries: facts.tries.map(|x: TrySite|
      { ..x, module: module, span: moved_span(x.span, by), owner: owner }),
    members: facts.members.map(|x: MemberSite|
      { ..x, module: module, span: moved_span(x.span, by), owner: owner }),
    typed: facts.typed.map(|x: TypedSite|
      { ..x, module: module, span: moved_span(x.span, by), owner: owner }),
    types: facts.types,
  }

fn within(span: Span, at: Span) -> Bool = span.start >= at.start && span.end <= at.end

fn all_within(facts: RootFacts, at: Span) -> Bool =
  facts.label_sites.fold(true, |b: Bool, x: LabelSite| b && within(x.span, at))
    && facts.updates.fold(true, |b: Bool, x: UpdateShape| b && within(x.span, at))
    && facts.ops.fold(true, |b: Bool, x: WitnessOp| b && within(x.span, at))
    && facts.refs.fold(true, |b: Bool, x: WitnessRef| b && within(x.span, at))
    && facts.operands.fold(true, |b: Bool, x: OperandSite| b && within(x.span, at))
    && facts.tries.fold(true, |b: Bool, x: TrySite| b && within(x.span, at))
    && facts.members.fold(true, |b: Bool, x: MemberSite| b && within(x.span, at))
    && facts.typed.fold(true, |b: Bool, x: TypedSite| b && within(x.span, at))

/// One body's sites as its row files them, behind a byte that says how. Each span is counted from
/// where the body's definition starts, so they hold wherever the definition moves to. A site
/// outside the definition's own text is foreign: a default argument is written at its callee's
/// positions and stands in the caller's body at those. A body that holds one is filed as it
/// stands, and holds only while neither module's text moves.
pub fn filed_facts(facts: RootFacts, at: Span) -> Bytes / {abort.raise} = {
  // A row names its types by key; the table they are read from goes with the rows, held once.
  let keyed = { ..facts, types: Map::new() };
  if all_within(keyed, at) {
    b"\x00".concat(bin::encode(placed_facts(keyed, 0, 0 - at.start, b""), root_facts_bin()))
  } else { b"\x01".concat(bin::encode(placed_facts(keyed, 0, 0, b""), root_facts_bin())) }
}

/// Whether a row's facts are of a body that holds a foreign site, or are no facts at all.
pub fn foreign_facts(filed: Bytes) -> Bool = filed.len() == 0 || filed.at(0) != 0

/// A row's facts read back for the definition that now starts at `start` in `module`; none for
/// bytes that are no facts.
pub fn facts_at(
  filed: Bytes,
  module: Int,
  start: Int,
  owner: Bytes,
) -> Option<RootFacts> / {abort.raise} =
  if filed.len() == 0 { None } else {
    match bin::decode(filed.slice(1, filed.len()), root_facts_bin()) {
      Ok(f) -> Some(placed_facts(f, module, if filed.at(0) == 0 { start } else { 0 }, owner)),
      Err(_) -> None,
    }
  }

/// The owner a `cost` clause's walk with its definition's header records under: the law the clause
/// makes is walked again, and only that walk is lowered.
fn unlowered() -> Bytes = b"#"

/// `checker` without the sites of a walk that is never lowered. A call on a value stays, among
/// the sites no body owns: it says how the clause is written out, and a claim lowers the clause
/// as written out.
fn lowered_only(checker: Checker) -> Checker = {
  let kept = |owner: Bytes| owner != unlowered();
  {
    ..checker,
    label_sites: checker.label_sites.filter(|x: LabelSite| kept(x.owner)),
    try_sites: checker.try_sites.filter(|x: TrySite| kept(x.owner)),
    member_sites: checker.member_sites.map(|x: MemberSite|
      if kept(x.owner) { x } else { { ..x, owner: b"" } }),
    update_shapes: checker.update_shapes.filter(|x: UpdateShape| kept(x.owner)),
    operands: checker.operands.filter(|x: OperandAt| kept(x.owner)),
    witness_refs: checker.witness_refs.filter(|x: WitnessRef| kept(x.owner)),
    typed: checker.typed.filter(|x: TypedAt| kept(x.owner)),
  }
}

fn facts_of(all: Checker) -> EmitFacts / {abort.raise} = {
  let checker = lowered_only(all);
  let settled = settled_sites(checker);
  {
    pure: checker.defs.fold([], |acc: List<Bytes>, def_info: DefInfo|
      if published_pure(def_info) { acc.push(def_info.name) } else { acc }),
    label_sites: checker.label_sites,
    elaboration: elaboration_in(checker),
    operands: checker.operands.map(|o: OperandAt|
      {
        module: o.module,
        span: o.span,
        ty: operand_name(resolve(checker, o.ty), quantified_of(checker, o.owner)),
        owner: o.owner,
      }),
    typed: settled.sites,
    types: settled.types,
  }
}

/// Each typed site resolved and read in its owner's numbering, beside the table of what they name.
/// A body's are only those in its own text: a default is walked in each call that omits it at its
/// callee's positions, which a check reading the callee from an entry lays elsewhere.
fn settled_sites(checker: Checker) -> { sites: List<TypedSite>, types: TypeTable } / {abort.raise} = {
  let tests = checker.tests.fold(Map::new(), |m: Map<Bytes, Location>, t: TestInfo|
    m.insert(test_owner(t.module, t.name), t.at));
  let in_own_text = |t: TypedAt|
    match match def_of(checker, t.owner) { Some(d) -> Some(d.at), None -> tests.get(t.owner) } {
      Some(at) ->
        at.module == t.module && t.span.start >= at.span.start && t.span.end <= at.span.end,
      None -> true,
    };
  checker.typed.filter(in_own_text).fold(
    // The rows a body is published from name their types in the table handed in with them.
    { sites: [], types: checker.known.types },
    |acc: { sites: List<TypedSite>, types: TypeTable }, t: TypedAt| {
      let quantified = match def_of(checker, t.owner) { Some(d) -> d.scheme.ty_vars, None -> [] };
      let numbering = range(0, quantified.len()).fold(Map::new(), |m: Map<Int, Int>, i: Int|
        m.insert(quantified.get(i), i));
      let read = |ty: Type| numbered(resolve(checker, ty), numbering);
      let args = t.args.fold(
        { table: acc.types, keys: [] },
        |h: { table: TypeTable, keys: List<Bytes> }, ty: Type| {
          let held = held_type(h.table, read(ty));
          { table: held.table, keys: h.keys.push(held.key) }
        },
      );
      let own = held_type(args.table, read(t.ty));
      {
        sites: acc.sites.push({
          module: t.module,
          span: t.span,
          ty: own.key,
          args: args.keys,
          owner: t.owner,
        }),
        types: own.table,
      }
    },
  )
}

/// `ty` with each variable `numbering` holds numbered by it and every other `-1`, and every
/// function type's row left out: what a value is laid out by, which a row never decides.
fn numbered(ty: Type, numbering: Map<Int, Int>) -> Type =
  match ty {
    TyVar(v) -> TyVar(match numbering.get(v) { Some(i) -> i, None -> 0 - 1 }),
    TyCon(c) -> TyCon({ ..c, args: c.args.map(|a: Type| numbered(a, numbering)) }),
    TyFn(f) ->
      TyFn({
        params: f.params.map(|p: Type| numbered(p, numbering)),
        ret: numbered(f.ret, numbering),
        effects: row_empty(),
      }),
    TyRecord(fs) -> TyRecord(fs.map(|f: Field| { ..f, ty: numbered(f.ty, numbering) })),
    TyNominal(x) ->
      TyNominal({
        ..x,
        args: x.args.map(|a: Type| numbered(a, numbering)),
        fields: x.fields.map(|f: Field| { ..f, ty: numbered(f.ty, numbering) }),
      }),
  }

/// A nullary type's name, or `'` and the number its owner's scheme gives a variable it quantifies,
/// which a specialisation reads as the type it is at; empty for any other type.
fn operand_name(ty: Type, quantified: List<Int>) -> Bytes =
  match ty {
    TyCon(k) -> if k.args.len() == 0 { k.name } else { b"" },
    TyVar(v) -> match range(0, quantified.len()).fold(None, |found: Option<Int>, i: Int|
        match found {
          Some(_) -> found,
          None -> if quantified.at(i) == Some(v) { Some(i) } else { None },
        }) {
      Some(i) -> b"'".concat(ascii_of_int(i)),
      None -> b"",
    },
    _ -> b"",
  }

fn quantified_of(checker: Checker, owner: Bytes) -> List<Int> / {abort.raise} =
  match def_of(checker, owner) { Some(d) -> d.scheme.ty_vars, None -> [] }

/// The elaboration, and the definitions whose calls the checker saw end, which are the recursive
/// ones a proof may unroll.
pub type Elaborated = { elaboration: Elaboration, ends: Map<Bytes, Bool>, stated: Map<Bytes, Bool> }

pub fn elaborated(
  resolved: Resolved,
  mods: List<ParsedModule>,
) -> Option<Elaborated> / {abort.raise} = {
  let out = check_program(resolved, mods);
  if has_error(out.checker.diags) { None } else {
    Some({
      elaboration: elaboration_of(out.checker),
      ends: ended(out.checker.defs),
      stated: stated(out.checker.defs),
    })
  }
}

pub fn ended(defs: List<DefInfo>) -> Map<Bytes, Bool> =
  defs.fold(Map::new(), |acc: Map<Bytes, Bool>, def_info: DefInfo|
    match def_info.ending { Ends -> acc.insert(def_info.name, true), _ -> acc })

/// The ones whose group descends only once the measures it states are counted: a proof owes those.
pub fn stated(defs: List<DefInfo>) -> Map<Bytes, Bool> =
  defs.fold(Map::new(), |acc: Map<Bytes, Bool>, def_info: DefInfo|
    match def_info.ending { Stated -> acc.insert(def_info.name, true), _ -> acc })

/// The same, with the definitions `known` holds rows for published from them rather than walked: only
/// a walked body's updates are shaped.
pub fn elaboration_with(
  resolved: Resolved,
  mods: List<ParsedModule>,
  known: Known,
) -> Option<Elaboration> / {abort.raise} = {
  let out = check_program_with(resolved, mods, known);
  if has_error(out.checker.diags) { None } else { Some(elaboration_of(out.checker)) }
}

/// One module's shapes, keyed by the update's span, as `expand_record_updates` reads them.
fn shapes_in(all: List<UpdateShape>, module: Int) -> Map<Bytes, List<Bytes>> =
  all.fold(Map::new(), |acc: Map<Bytes, List<Bytes>>, s: UpdateShape|
    if s.module != module { acc } else { acc.insert(span_key(s.span), s.names) })

/// One module's `try` blocks, keyed by span, as `expand_try_blocks` reads them.
fn answered_in(all: List<TrySite>, module: Int) -> Map<Bytes, Answered> =
  all.fold(Map::new(), |acc: Map<Bytes, Answered>, s: TrySite|
    if s.module != module { acc }
    else { acc.insert(span_key(s.span), { effect: s.effect, op: s.op, arity: s.arity }) })

/// One module's calls on values that call a function of the value's type, keyed by span, as
/// `expand_member_calls` reads them, each with its callee's parameters out of `signatures`.
fn members_in(
  all: List<MemberSite>,
  module: Int,
  signatures: Map<Bytes, Parameters>,
) -> Map<Bytes, MemberCallee> =
  all.fold(Map::new(), |acc: Map<Bytes, MemberCallee>, s: MemberSite|
    if s.module != module { acc } else {
      let params = match signatures.get(s.callee) { Some(g) -> g.params, None -> [] };
      acc.insert(span_key(s.span), {
        qualifier: s.qualifier,
        name: s.name,
        names: params.map(|p: ParamInfo| p.name),
        defaults: params.map(|p: ParamInfo| p.default),
      })
    })

/// A module with every tagged literal written out as the call it runs as, every call on a value
/// as the call of its type's function, every record update as the literal it stands for, and
/// every `try` as its `handle`. The tagged literals go first: they need nothing of the checker,
/// and what they become is forms the others already walk. A handler's variables go last, so what
/// reads them is in the forms it is lowered in.
fn written_out(
  module: Module,
  elaboration: Elaboration,
  i: Int,
  signatures: Map<Bytes, Parameters>,
) -> Module =
  expand_handler_vars(
    expand_holds(
      expand_try_blocks(
        expand_record_updates(
          expand_member_calls(
            expand_tagged(module),
            members_in(elaboration.members, i, signatures),
          ),
          shapes_in(elaboration.updates, i),
        ),
        answered_in(elaboration.tries, i),
      ),
    ),
  )

/// The modules written out, and every `numeric` or `integer` parameter's witness passed and read:
/// what the emitter lowers, and what only the checker knows. `signatures` are the resolver's of
/// these modules, which say what a call on a value fills.
pub fn expanded_mods(
  mods: List<ParsedModule>,
  elaboration: Elaboration,
  signatures: Map<Bytes, Parameters>,
) -> List<ParsedModule> / {abort.raise} =
  range(0, mods.len()).map(|i: Int| {
    let m: ParsedModule = mods.get(i);
    {
      name: m.name,
      module: expand_witnesses(
        written_out(m.module, elaboration, i, signatures),
        ops_in(elaboration.ops, i),
        refs_in(elaboration.refs, i),
        orders_in(elaboration.orders, i),
      ),
      derived: m.derived,
    }
  })

/// The modules written out and no witness passed: what a claim lowers, since the prover draws every
/// type parameter as `Int` and reads an operator over one as `Int`'s.
pub fn updated_mods(
  mods: List<ParsedModule>,
  elaboration: Elaboration,
  signatures: Map<Bytes, Parameters>,
) -> List<ParsedModule> / {abort.raise} =
  range(0, mods.len()).map(|i: Int| {
    let m: ParsedModule = mods.get(i);
    { name: m.name, module: written_out(m.module, elaboration, i, signatures), derived: m.derived }
  })

fn ops_in(all: List<WitnessOp>, module: Int) -> Map<Bytes, Bytes> =
  all.fold(Map::new(), |acc: Map<Bytes, Bytes>, o: WitnessOp|
    if o.module != module { acc } else { acc.insert(span_key(o.span), o.param) })

/// A call's witnesses in its callee's scheme order, the order its witness parameters take.
fn refs_in(all: List<WitnessRef>, module: Int) -> Map<Bytes, List<NumericWitness>> / {abort.raise} =
  all.fold(Map::new(), |acc: Map<Bytes, List<NumericWitness>>, r: WitnessRef|
    if r.module != module { acc } else {
      let ranked = range(0, r.params.len()).fold([], |sorted: List<Int>, k: Int| {
        let n = sorted.len();
        let i = range(0, n).fold(n, |p: Int, j: Int|
          if p < n { p } else if r.params.get(k) < r.params.get(sorted.get(j)) { j } else { p });
        sorted.take(i).push(k).concat(sorted.drop(i))
      });
      acc.insert(span_key(r.span), ranked.map(|k: Int| r.witnesses.get(k)))
    })

fn orders_in(all: List<WitnessOrder>, module: Int) -> Map<Bytes, List<Bytes>> =
  all.fold(Map::new(), |acc: Map<Bytes, List<Bytes>>, o: WitnessOrder|
    if o.module != module { acc } else { acc.insert(o.name, o.params) })

/// Every use of a label-generic definition is a call, and every call fills its labels.
fn check_label_apps(checker: Checker) -> Checker / {abort.raise} = {
  let out: Checker = checker.label_apps.fold(checker, |c: Checker, a: LabelApplication| {
    let in_module: Checker = { ..c, module: a.module };
    let judged: Checker = if !a.called {
      report_error_at(
        in_module,
        b"E0306",
        a.span,
        Bytes::concat_all([b"`", simple_name_of(a.callee), b"` must be called directly"]),
        b"used as a value",
        [
          b"its row names a label the caller fills, so it has no meaning until a call says which resource it touches",
        ],
      )
    } else {
      // A region's label reaches a callee as the name its body writes, as its clauses name it.
      let names = a.vars.fold([], |acc: List<Bytes>, v: Int|
        match label_named(in_module, a, v) { Some(n) -> acc.push(written_label(n)), None -> acc });
      if names.len() < a.vars.len() {
        let unfilled = error_at(
          b"E0306",
          a.module,
          a.span,
          Bytes::concat_all([
            b"this call leaves a label of `",
            simple_name_of(a.callee),
            b"` unfilled",
          ]),
          b"no resource to perform under",
          [
            Bytes::concat_all([
              b"write it at the call, as `",
              simple_name_of(a.callee),
              b"[<label>](..)`, or pass an argument whose row or type names it",
            ]),
          ],
        );
        // One binder for one label is the only label this definition can pass along.
        report(in_module, match ((a.params.keys(), a.written)) {
          ([own], [w]) -> if label_named(in_module, a, w) != None { unfilled } else {
            with_fix(unfilled, Bytes::concat_all([b"pass `", own, b"` along"]), [
              insertion(a.module, a.named, Bytes::concat_all([b"[", own, b"]"])),
            ])
          },
          _ -> unfilled,
        })
      } else {
        {
          ..in_module,
          label_sites: in_module.label_sites.push({
            module: a.module,
            span: a.span,
            labels: names,
            owner: a.owner,
          }),
        }
      }
    };
    { ..judged, module: c.module }
  });
  { ..out, module: checker.module }
}

/// A settled label is the resource it names, or the enclosing definition's own label parameter.
fn label_named(checker: Checker, a: LabelApplication, v: Int) -> Option<Bytes> / {abort.raise} =
  if v < 0 { None } else {
    let t = shallow(checker.subst, TyVar(v));
    match label_of(t) {
      Some(n) -> Some(n),
      None -> match t { TyVar(w) -> param_named(a.params, w), _ -> None },
    }
  }

fn param_named(params: Map<Bytes, Int>, v: Int) -> Option<Bytes> =
  params.fold(None, |acc: Option<Bytes>, k: Bytes, w: Int|
    match acc { Some(_) -> acc, None -> if w == v { Some(k) } else { None } })

pub fn check_program_with(
  resolved: Resolved,
  mods: List<ParsedModule>,
  known: Known,
) -> Checked / {abort.raise} = {
  let c0 = fresh_cx(resolved, mods, known);
  let declared: Checker = resolved.order.fold(c0, |checker: Checker, i: Int| {
    let m = mods.get(i);
    let c1: Checker = { ..checker, module: i };
    let typed: Checker = collect_nominals(collect_effects(collect_types(c1, m), m), m);
    collect_stated(check_value_namespace(collect_ctors(typed, m), m), m)
  });
  let signed = resolved.order.fold(
    { checker: declared, by: Map::new() },
    |acc: { checker: Checker, by: Map<Int, SignedModule> }, i: Int| {
      let o = signed_fns({ ..acc.checker, module: i }, mods.get(i));
      { checker: o.checker, by: acc.by.insert(i, o.signed) }
    },
  );
  // A module read wholly from rows waits on none, and one calling into it on a value need not
  // import it, so no order of imports puts it first.
  let read = |i: Int|
    match signed.by.get(i) {
      Some(s) -> s.names.len() > 0 && s.names.all(|n: Bytes| known.defs.contains(n)),
      None -> false,
    };
  let checked: Checker = resolved.order.filter(read).concat(
    resolved.order.filter(|i: Int| !read(i)),
  ).fold(signed.checker, |checker: Checker, i: Int| {
    let m = mods.get(i);
    match signed.by.get(i) {
      Some(s) -> check_specs(walked_fns({ ..checker, module: i }, m, s), m),
      None -> panic("a module of the program was not signed"),
    }
  });
  let tested: Checker = range(0, mods.len()).fold(checked, |checker: Checker, i: Int|
    check_laws(
      check_schemas(check_tests({ ..checker, module: i }, mods.get(i)), mods.get(i)),
      mods.get(i),
    ));
  // Whatever `check_fns` did not drain: a spec clause, a test body, a law.
  let settled: Checker = settle_columns(
    settle_bit_ops(settle_numerics(settle_concats(settle_updates(check_instances(tested))))),
  );
  let constrained: Checker = check_constraints(
    check_map_keys(check_comparisons(check_label_apps(settled))),
  );
  let solved: Checker = check_parallels(
    check_regions(check_simulations(attribute_generated(check_derives(constrained)))),
  );
  { checker: solved, ok: !has_error(solved.diags) }
}

// --- The dump -----------------------------------------------------------------------------------------------

fn footprint_text(atoms: List<Atom>) -> Bytes / {abort.raise} = atoms_text(atoms, b",")

pub fn dump_flag(b: Bool) -> Bytes = if b { b"1" } else { b"0" }

fn dump_def(def_info: DefInfo) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"F;",
    def_info.name,
    b";",
    scheme_text(def_info.scheme),
    b";",
    footprint_text(def_info.footprint),
    b";",
    footprint_text(def_info.performed),
    b";",
    Bytes::join(
      def_info.constraints.map(|c: DefConstraint|
        deriver_text(c.deriver).concat(ascii_of_int(c.param))),
      b",",
    ),
    b";",
  ])

fn dump_op(op_info: OpInfo) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    op_info.name,
    b":",
    mode_text(op_info.mode),
    b":",
    dump_flag(op_info.resource_param),
    b":",
    Bytes::join(op_info.params.map(type_text), b"+"),
    b":",
    type_text(op_info.ret),
  ])

fn dump_checked(checker: Checker) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    Bytes::concat_all(checker.defs.map(dump_def)),
    Bytes::concat_all(
      checker.tests.map(|test_info: TestInfo|
        Bytes::concat_all([
          b"T;",
          test_info.key,
          b";",
          dump_flag(test_info.nondet),
          b";",
          footprint_text(test_info.footprint),
          b";",
        ])),
    ),
    Bytes::concat_all(
      checker.laws.map(|law_info: LawInfo|
        Bytes::concat_all([
          b"L;",
          law_info.key,
          b";",
          Bytes::join(
            law_info.binders.map(|b: LawBinder| Bytes::concat_all([b.name, b":", type_text(b.ty)])),
            b",",
          ),
          b";",
          dump_flag(law_info.has_guard),
          b";",
          footprint_text(law_info.footprint),
          b";",
        ])),
    ),
    Bytes::concat_all(
      checker.effects.filter(|effect_info: EffectInfo| effect_info.module.len() > 0).map(
        |effect_info: EffectInfo|
          Bytes::concat_all([
            b"E;",
            effect_info.name,
            b";",
            dump_flag(effect_info.nondet),
            b";",
            Bytes::join(effect_info.ops.map(dump_op), b","),
            b";",
          ]),
      ),
    ),
    Bytes::concat_all(
      checker.ctors.filter(|ctor_info: CtorInfo| ctor_info.module.len() > 0).map(
        |ctor_info: CtorInfo|
          Bytes::concat_all([
            b"C;",
            ctor_info.name,
            b";",
            ctor_info.type_name,
            b";",
            ascii_of_int(ctor_info.index),
            b";",
            ascii_of_int(ctor_info.arity),
            b";",
            scheme_text(ctor_info.scheme),
            b";",
          ]),
      ),
    ),
  ])

/// The first of each diagnostic that would render alike: the same code, labels and note count.
fn dedup_diags(diags: List<Diag>) -> List<Diag> =
  diags.fold(
    { seen: Map::new(), kept: [] },
    |acc: { seen: Map<Diag, Bool>, kept: List<Diag> }, diag: Diag|
      if acc.seen.contains(diag) { acc }
      else { { seen: acc.seen.insert(diag, true), kept: acc.kept.push(diag) } },
  ).kept

type Parsed = { name: Bytes, module: Module, derived: List<Derived>, diags: List<Diag> }

/// Each source parsed with the rewrites and every `derive` expanded, with no embed read for it.
fn parsed_all(sources: List<Source>) -> List<Parsed> / {abort.raise} =
  range(0, sources.len()).map(|i: Int| {
    let s = sources.get(i);
    let r = parse(s.src);
    let x = expand(r.node, r.parser.diags);
    let d: Expansion = expand_derives(i, s.name, x.module);
    {
      name: s.name,
      module: rewritten(Map::new(), s.name, d.module).module,
      derived: d.derived,
      diags: d.diags,
    }
  })

/// The driver's order: parse with the rewrites, expand every `derive`, resolve. The dump of the
/// stage that reported, where one did.
fn resolved_all(sources: List<Source>) -> Result<Expanded, Bytes> / {abort.raise} = {
  let parsed = parsed_all(sources);
  let expansion = parsed.fold([], |acc: List<Diag>, p: Parsed| acc.concat(p.diags));
  let mods = parsed.map(|p: Parsed| { name: p.name, module: p.module, derived: p.derived });
  if expansion.len() > 0 { Err(b"X;".concat(dump_diags(expansion))) } else {
    match resolve_modules(mods) {
      ResolveFailed(ds) -> Err(b"X;".concat(dump_diags(ds))),
      ResolveSucceeded(x) -> Ok(x),
    }
  }
}

fn dump_head(sources: List<Source>) -> Bytes =
  Bytes::concat_all([b"K;", ascii_of_int(sources.len()), b";"])

/// The driver's order, then the check.
pub fn check_dump(sources: List<Source>) -> String / {abort.raise} =
  String::of_bytes(
    dump_head(sources).concat(match resolved_all(sources) {
      Err(refused) -> refused,
      Ok(x) -> dump_outcome(check_program(x.r, x.mods)),
    }),
  )

fn dump_outcome(out: Checked) -> Bytes / {abort.raise} =
  if out.ok { dump_checked(out.checker) }
  else { b"X;".concat(dump_diags(dedup_diags(out.checker.diags))) }

/// What a checked program publishes, as the interfaces a second check of it would be handed.
fn known_of(checker: Checker) -> Known = {
  let defs = checker.defs.fold(Map::new(), |acc: Map<Bytes, KnownDef>, def_info: DefInfo|
    acc.insert(def_info.name, {
      footprint: def_info.footprint,
      performed: def_info.performed,
      scaling: def_info.scaling,
      repeats: def_info.repeats,
      ending: def_info.ending,
      summary: def_info.summary,
      raises: def_info.raises,
      facts: b"",
    }));
  let tests = checker.tests.fold(Map::new(), |acc: Map<Bytes, KnownTest>, t: TestInfo|
    acc.insert(t.key, { footprint: t.footprint, facts: b"" }));
  { ..no_known(), defs: defs, tests: tests, root: checker.known.root, types: checker.known.types }
}

/// `check_dump`'s answer, and the program's checked a second time from the interfaces the first
/// published. The two agree wherever those interfaces are all a caller reads of a definition.
pub type Dumps = { walked: String, seeded: String }

/// The program walked once and checked again from what that walk published; a program that does not
/// check is not checked again.
pub fn check_dumps(sources: List<Source>) -> Dumps / {abort.raise} = {
  let head = dump_head(sources);
  let both = match resolved_all(sources) {
    Err(refused) -> { walked: refused, seeded: refused },
    Ok(x) -> {
      let first = check_program(x.r, x.mods);
      let walked = dump_outcome(first);
      {
        walked: walked,
        seeded: if !first.ok { walked }
        else { dump_outcome(check_program_with(x.r, x.mods, known_of(first.checker))) },
      }
    },
  };
  {
    walked: String::of_bytes(head.concat(both.walked)),
    seeded: String::of_bytes(head.concat(both.seeded)),
  }
}

// --- Tests ------------------------------------------------------------------

test "a definition's scheme is generalized and its footprint inferred" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"pub fn id<a>(x: a) -> a = x\nfn two() -> Int = id(2)\neffect log { write emit(Bytes) -> Unit }\nfn say(b: Bytes) -> Unit / { log.write } = log.emit(b)",
    },
  ]);
  assert_eq(
    dump,
    "K;1;F;m.id;<a>(a) -> a;;;;F;m.two;() -> Int;;;;F;m.say;(Bytes) -> Unit / {m.log.write};m.log.write;m.log.emit;;E;m.log;0;emit:write:0:Bytes:Unit;",
  )
}

test "a definition may be generic over a resource label, and a call fills it" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"effect net { write send[r](Bytes) -> Unit }\npub fn relay<[l]>(b: Bytes) -> Unit / {net.send[l]} = net.send[l](b)\npub fn go(b: Bytes) -> Unit / {net.send[conn]} = relay[conn](b)",
    },
  ]);
  assert_eq(
    dump,
    "K;1;F;m.relay;<[l]>(Bytes) -> Unit / {m.net.send[l]};<[l]>m.net.send[l];<[l]>m.net.send[l];;"
      ++ "F;m.go;(Bytes) -> Unit / {m.net.send[conn]};m.net.send[conn];m.net.send[conn];;"
      ++ "E;m.net;0;send:write:1:Bytes:Unit;",
  )
}

test "an argument's row fills a label the call does not write" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"effect net { write send[r](Bytes) -> Unit }\nfn relay<[l]>(f: () -> Unit / {net.send[l]}) -> Unit / {net.send[l]} = f()\nfn go(f: () -> Unit / {net.send[conn]}) -> Unit / {net.send[conn]} = relay(f)",
    },
  ]);
  assert_eq(
    dump,
    "K;1;F;m.relay;<[l]>(() -> Unit / {m.net.send[l]}) -> Unit / {m.net.send[l]};<[l]>m.net.send[l];<[l]>m.net.send[l];;"
      ++ "F;m.go;(() -> Unit / {m.net.send[conn]}) -> Unit / {m.net.send[conn]};m.net.send[conn];m.net.send[conn];;"
      ++ "E;m.net;0;send:write:1:Bytes:Unit;",
  )
}

test "a clause on a label parameter discharges what the generic body performs" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"effect net { write send[r](Bytes) -> Unit }\nfn relay<[l]>(b: Bytes) -> Unit / {net.send[l]} = net.send[l](b)\nfn quiet<[l]>(b: Bytes) -> Unit = handle relay[l](b) with { net.send[l](x) -> () }",
    },
  ]);
  assert_eq(
    dump,
    "K;1;F;m.relay;<[l]>(Bytes) -> Unit / {m.net.send[l]};<[l]>m.net.send[l];<[l]>m.net.send[l];;"
      ++ "F;m.quiet;<[l]>(Bytes) -> Unit;;;;"
      ++ "E;m.net;0;send:write:1:Bytes:Unit;",
  )
}

test "an unknown name is told the name in scope a slip of the hand would make it" {
  let noted = |call: Bytes|
    check_dump([
      { name: b"m", src: b"fn count(n: Int) -> Int = n\nfn go() -> Int = ".concat(call) },
    ]);
  assert(noted(b"cuont(2)").contains("!E0101:0:45:50:1:1;"));
  assert(noted(b"counts(2)").contains("!E0101:0:45:51:1:1;"));
  assert(noted(b"breadth(2)").contains("!E0101:0:45:52:1:0;"));
  assert(noted(b"cnt(2)").contains("!E0101:0:45:48:1:0;"))
}

test "`[*]` on an operation that takes no resource is refused" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"effect log { write note(line: String) -> Unit }\nfn go() -> Unit = handle { log.note(\"x\") } with { log.note[*](line) -> () }",
    },
  ]);
  assert(dump.contains("E0304"))
}

test "`[*]` in a row on an operation that takes no resource is refused" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"effect log { write note(line: String) -> Unit }\nfn go() -> Unit / {log.note[*]} = log.note(\"x\")",
    },
  ]);
  assert(dump.contains("E0304"))
}

test "a label a call cannot fill, a count that does not match, and a use as a value" {
  let unfilled = check_dump([
    {
      name: b"m",
      src: b"effect net { write send[r](Bytes) -> Unit }\nfn relay<[l]>(b: Bytes) -> Unit / {net.send[l]} = net.send[l](b)\nfn go(b: Bytes) -> Unit / {net.send[conn]} = relay(b)",
    },
  ]);
  assert(unfilled.contains("E0306"));
  let counted = check_dump([
    {
      name: b"m",
      src: b"effect net { write send[r](Bytes) -> Unit }\nfn relay<[l]>(b: Bytes) -> Unit / {net.send[l]} = net.send[l](b)\nfn go(b: Bytes) -> Unit / {net.send[conn]} = relay[conn, other](b)",
    },
  ]);
  assert(counted.contains("E0306"));
  let valued = check_dump([
    {
      name: b"m",
      src: b"effect net { write send[r](Bytes) -> Unit }\nfn relay<[l]>(b: Bytes) -> Unit / {net.send[l]} = net.send[l](b)\nfn go() -> (Bytes) -> Unit / {net.send[conn]} = relay",
    },
  ]);
  assert(valued.contains("E0306"));
  let plain = check_dump([
    { name: b"m", src: b"fn id(x: Int) -> Int = x\nfn go(n: Int) -> Int = id[conn](n)" },
  ]);
  assert(plain.contains("E0306"))
}

test "two label parameters stay apart, and each names its own atom" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"effect net { write send[r](Bytes) -> Unit }\nfn pipe<[l, k]>(b: Bytes) -> Unit / {net.send[l], net.send[k]} = { net.send[l](b); net.send[k](b) }",
    },
  ]);
  assert_eq(
    dump,
    "K;1;F;m.pipe;<[l], [m]>(Bytes) -> Unit / {m.net.send[l], m.net.send[m]};<[l],[m]>m.net.send[l],m.net.send[m];<[l],[m]>m.net.send[l],m.net.send[m];;"
      ++ "E;m.net;0;send:write:1:Bytes:Unit;",
  )
}

test "a call inside a recursive group fills its callee's labels as any call does" {
  let alone = |call: Bytes, row: Bytes|
    Bytes::concat_all([
      b"effect net { write send[r](Bytes) -> Unit }\n",
      b"fn walk<[l]>(n: Int, b: Bytes) -> Unit / {",
      row,
      b"} = if n <= 0 { net.send[l](b) } else { ",
      call,
      b" }",
    ]);
  assert_eq(check_codes(alone(b"walk[l](n - 1, b)", b"net.send[l]")), []);
  // Another label than its own is what the call performs, which the caller's row must hold.
  assert_eq(check_codes(alone(b"walk[conn](n - 1, b)", b"net.send[l], net.send[conn]")), []);
  assert_eq(check_codes(alone(b"walk[conn](n - 1, b)", b"net.send[l]")), [b"E0302"]);
  // No argument names the label, so the call writes it, and the one binder in scope is offered.
  let bare = alone(b"walk(n - 1, b)", b"net.send[l]");
  let unfilled = check_diags(bare).filter(|diag: Diag| diag.code == b"E0306");
  assert_eq(unfilled.map(|diag: Diag| diag.message), [
    b"this call leaves a label of `walk` unfilled",
  ]);
  assert_eq(fixes_of(unfilled).map(|fix: Fix| fix.title), [b"pass `l` along"]);
  assert_eq(fixes_of(unfilled).map(|fix: Fix| fixed_by(bare, fix)), [
    alone(b"walk[l](n - 1, b)", b"net.send[l]"),
  ]);
  // Each member keeps its own binder, whatever it calls it and however many it binds.
  let pair = Bytes::concat_all([
    b"effect net { write send[r](Bytes) -> Unit }\n",
    b"fn ping<[l]>(n: Int, b: Bytes) -> Unit / {net.send[l]} = if n <= 0 { net.send[l](b) } else { pong[l](n - 1, b) }\n",
    b"fn pong<[k]>(n: Int, b: Bytes) -> Unit / {net.send[k]} = ping[k](n - 1, b)",
  ]);
  assert_eq(check_codes(pair), []);
  let uneven = Bytes::concat_all([
    b"effect net { write send[r](Bytes) -> Unit }\n",
    b"fn ping<[l, k]>(n: Int, b: Bytes) -> Unit / {net.send[l], net.send[k]} = if n <= 0 { net.send[l](b) } else { pong[k](n - 1, b) }\n",
    b"fn pong<[l]>(n: Int, b: Bytes) -> Unit / {net.send[l]} = if n <= 0 { net.send[l](b) } else { ping[l, l](n - 1, b) }",
  ]);
  assert_eq(check_codes(uneven), [])
}

test "a call inside a recursive group fills its callee's row as any call does" {
  let alone = |row: Bytes, handed: Bytes|
    Bytes::concat_all([
      b"effect tick { write now() -> Unit }\n",
      b"fn each<|e>(n: Int, f: () -> Unit / e) -> Unit / ",
      row,
      b" = if n <= 0 { f() } else { each(n - 1, ",
      handed,
      b") }",
    ]);
  assert_eq(check_codes(alone(b"e", b"f")), []);
  // A callback of another row is what the call performs, which the caller's row must hold.
  assert_eq(check_codes(alone(b"{tick.now | e}", b"|| tick.now()")), []);
  assert_eq(check_codes(alone(b"e", b"|| tick.now()")), [b"E0302"]);
  // Each member keeps its own binder, and one that takes no row calls one that does.
  let pair = Bytes::concat_all([
    b"fn ping<|e>(n: Int, f: () -> Unit / e) -> Unit / e = if n <= 0 { f() } else { pong(n - 1, f) }\n",
    b"fn pong<|t>(n: Int, f: () -> Unit / t) -> Unit / t = ping(n - 1, f)",
  ]);
  assert_eq(check_codes(pair), []);
  let mixed = Bytes::concat_all([
    b"fn each<|e>(n: Int, f: () -> Unit / e) -> Unit / e = if n <= 0 { f() } else { plain(n - 1) }\n",
    b"fn plain(n: Int) -> Unit = if n <= 0 { () } else { each(n - 1, || ()) }",
  ]);
  assert_eq(check_codes(mixed), [])
}

test "two callbacks that perform different things fill one row variable with both" {
  let src = Bytes::concat_all([
    b"effect a { write x() -> Unit }\n",
    b"effect b { write y() -> Unit }\n",
    b"fn both<|e>(f: () -> Unit / e, g: () -> Unit / e) -> Unit / e = { f(); g() }\n",
    b"fn fa() -> Unit / {a.x} = a.x()\n",
    b"fn go() -> Unit / {a.x, b.y} = both(|| a.x(), || b.y())\n",
    b"fn named() -> Unit / {a.x} = both(fa, || ())\n",
    b"fn apart() -> (Unit, Unit) / {a.x, b.y} = parallel { both(|| a.x(), || a.x()), b.y() }",
  ]);
  assert_eq(check_codes(src), []);
  let dump = check_dump([{ name: b"m", src: src }]);
  assert(dump.contains("F;m.go;() -> Unit / {m.a.x, m.b.y};"));
  assert(dump.contains("F;m.named;() -> Unit / {m.a.x};"));
  assert(dump.contains("F;m.apart;() -> (Unit, Unit) / {m.a.x, m.b.y};"));
  let clash = Bytes::concat_all([
    b"effect a { write x() -> Unit }\n",
    b"effect b { write y() -> Unit }\n",
    b"fn both<|e>(f: () -> Unit / e, g: () -> Unit / e) -> Unit / e = { f(); g() }\n",
    b"fn shared() -> (Unit, Unit) / {a.x, b.y} = parallel { both(|| a.x(), || b.y()), b.y() }",
  ]);
  assert_eq(check_codes(clash), [b"E0309"])
}

test "a callback may perform less than its parameter's row permits, and nothing it does not permit" {
  let ops = b"effect a { write x() -> Unit\n write z() -> Unit }\n";
  let run = ops.concat(b"fn run(k: () -> Unit / {a.x, a.z}) -> Unit / {a.x, a.z} = k()\n");
  assert_eq(check_codes(run.concat(b"fn go() -> Unit / {a.x, a.z} = run(|| a.x())")), []);
  assert_eq(check_codes(run.concat(b"fn go() -> Unit / {a.x, a.z} = run(|| ())")), []);
  let narrow = ops.concat(
    b"fn run(k: () -> Unit / {a.x}) -> Unit / {a.x} = k()\nfn go() -> Unit / {a.x} = run(|| a.z())",
  );
  let diags = check_diags(narrow);
  assert_eq(diags.map(|diag: Diag| diag.code), [b"E0302"]);
  assert_eq(diags.map(|diag: Diag| diag.labels.get(0).text), [b"expected {m.a.x}, found {m.a.z}"]);
  let held = |body: Bytes|
    Bytes::concat_all([
      ops,
      b"fn go<|e>(k: (() -> Unit / {a.x | e}) -> Unit / {a.x | e}) -> Unit / {a.x | e} = k(",
      body,
      b")",
    ]);
  assert_eq(check_codes(held(b"|| a.x()")), []);
  assert_eq(check_codes(held(b"|| a.z()")), [b"E0302"]);
  let handed = ops.concat(
    b"effect ctl { write run(k: () -> Unit / {a.x, a.z}) -> Unit }\nfn go() -> Unit / {ctl.write} = ctl.run(|| a.x())",
  );
  assert_eq(check_codes(handed), [])
}

test "a claim may hand a pure callback to a function generic over its row" {
  assert_eq(
    check_codes(
      Bytes::concat_all([
        b"fn total(xs: List<Int>) -> Int\n",
        b"  requires xs.fold(0, |s: Int, x: Int| s + x) < 100\n",
        b"= xs.fold(0, |s: Int, x: Int| s + x)\n",
        b"law \"a fold over nothing is its seed\" { [].fold(7, |s: Int, x: Int| s + x) == 7 }",
      ]),
    ),
    [],
  )
}

test "a list, a branch, a return, an annotation and a value's fields take functions that perform less" {
  let src = Bytes::concat_all([
    b"effect a { write x() -> Unit\n write z() -> Unit }\n",
    b"effect b { write y() -> Unit }\n",
    b"fn each<|e>(fs: List<() -> Unit / e>) -> Unit / e = ()\n",
    b"fn pair<|e>(h: { ok: () -> Unit / e, err: () -> Unit / e }) -> Unit / e = ()\n",
    b"fn listed() -> Unit / {a.x, b.y} = each([|| a.x(), || b.y()])\n",
    b"fn paired() -> Unit / {a.x, b.y} = pair({ ok: || a.x(), err: || b.y() })\n",
    b"fn branched(c: Bool) -> () -> Unit / {a.x, b.y} = if c { || a.x() } else { || b.y() }\n",
    b"fn matched(n: Int) -> () -> Unit / {a.x, b.y} = match n { 0 -> || a.x(), _ -> || b.y() }\n",
    b"fn fell(o: Option<Int>) -> () -> Unit / {a.x, b.y} = { let Some(_) = o else { || b.y() }; || a.x() }\n",
    b"fn returned() -> () -> Unit / {a.x, a.z} = || a.x()\n",
    b"fn annotated() -> Unit / {a.x, a.z} = { let f: () -> Unit / {a.x, a.z} = || a.x(); f() }\n",
    b"fn held() -> Option<() -> Unit / {a.x, a.z}> = Some(|| a.x())",
  ]);
  assert_eq(check_codes(src), []);
  let dump = check_dump([{ name: b"m", src: src }]);
  assert(dump.contains("F;m.listed;() -> Unit / {m.a.x, m.b.y};"));
  assert(dump.contains("F;m.paired;() -> Unit / {m.a.x, m.b.y};"))
}

test "a function's parameter and a declared type hold their rows exactly" {
  let net = b"effect net { write send[s](p: Bytes) -> Unit\n write recv[s](n: Int) -> Bytes }\n";
  // `sender` handles what its parameter's row names, so a callback that may receive would escape it.
  let escaping = Bytes::concat_all([
    net,
    b"fn sender(f: () -> Unit / {net.send[x]}) -> Unit = handle { f() } with { net.send[x](p) -> () }\n",
    b"fn run(k: (() -> Unit / {net.write[x]}) -> Unit) -> Unit = k(|| { let _ = net.recv[x](1); () })\n",
    b"fn go() -> Unit = run(sender)",
  ]);
  assert_eq(check_codes(escaping), [b"E0302"]);
  let boxed = Bytes::concat_all([
    net,
    b"type Box<a> = Box(a)\n",
    b"fn open(b: Box<() -> Unit / {net.write[x]}>) -> Unit / {net.write[x]} = match b { Box(f) -> f() }\n",
    b"fn go(f: () -> Unit / {net.send[x]}) -> Unit / {net.write[x]} = open(Box(f))",
  ]);
  assert_eq(check_codes(boxed), [b"E0302"])
}

test "a call inside a recursive group fills its callee's type parameters, and may not grow one" {
  // A member called at a type that names no parameter.
  let concrete = Bytes::concat_all([
    b"fn ping<a>(n: Int, x: a) -> Int = if n <= 0 { 0 } else { pong(n - 1) }\n",
    b"fn pong(n: Int) -> Int = ping(n - 1, 0)",
  ]);
  assert_eq(check_codes(concrete), []);
  // Members that pass their own parameter to each other, each writing its parameters its own way.
  let crossed = Bytes::concat_all([
    b"fn even<a>(xs: List<a>, n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1, 0, xs) }\n",
    b"fn odd<k, b>(n: Int, key: k, xs: List<b>) -> Bool = if n <= 0 { false } else { even(xs, n - 1) }",
  ]);
  assert_eq(check_codes(crossed), []);
  // Each time round, `ping` would be called at a list of what it was called at.
  let both = Bytes::concat_all([
    b"fn ping<a>(n: Int, x: a) -> Int = if n <= 0 { 0 } else { pong(n - 1, [x]) }\n",
    b"fn pong<b>(n: Int, xs: List<b>) -> Int = ping(n - 1, xs)",
  ]);
  let diags = check_diags(both);
  assert_eq(diags.map(|diag: Diag| diag.code), [b"E0308"]);
  assert_eq(diags.map(|diag: Diag| diag.message), [
    b"a call to `ping` inside its own recursive group gives `a` a type that grows",
  ]);
  assert_eq(diags.get(0).labels.map(|label: Label| label.text), [b"`a` would be `List<b>` here"]);
  assert_eq(
    diags.get(0).notes_text.get(0),
    b"each time round the recursion `ping` would be called at a larger type, so no finite set of copies of it serves the group: that is polymorphic recursion",
  );
  // The same of a definition that calls itself.
  assert_eq(
    check_diags(b"fn grow<a>(x: a, n: Int) -> Int = if n <= 0 { 0 } else { grow([x], n - 1) }").map(
      |diag: Diag| diag.message,
    ),
    [b"a call to `grow` inside its own recursive group gives `a` a type that grows"],
  )
}

test "a call inside a recursive group answers for its callee's constraints as any call does" {
  let cycle = |up: Bytes|
    Bytes::concat_all([
      b"fn up<a>(x: a, n: Int) -> a",
      up,
      b" = if n <= 0 { x } else { down(n - 1, x) }\n",
      b"fn down<b>(n: Int, x: b) -> b where numeric(b) = if n <= 0 { x } else { up(x + x, n - 1) }\n",
      b"fn go() -> U8 = up(1u8, 3)",
    ]);
  let checker = checked_cx(cycle(b" where numeric(a)"));
  let passed = refs_in(checker.witness_refs, 0).values();
  assert_eq(passed.len(), 3);
  let passes = |w: NumericWitness|
    passed.fold(false, |b: Bool, ws: List<NumericWitness>| b || ws == [w]);
  assert(passes(ParamWitness(b"a")));
  assert(passes(ParamWitness(b"b")));
  assert(passes(ConcreteWitness(b"U8")));
  // A member that does not hold the constraint cannot pass its parameter to one that needs it.
  assert_eq(check_codes(cycle(b"")), [b"E0201"])
}

test "a unit pattern covers its type" {
  assert_eq(
    check_dump([{ name: b"m", src: b"fn f(u: Unit) -> Int = match u { () -> 1 }" }]),
    "K;1;F;m.f;(Unit) -> Int;;;;",
  )
}

test "a numeric constraint is refused where no call could pass its type" {
  assert_eq(check_codes(b"fn twice<a>(x: a) -> a where numeric(a) = x + x"), []);
  let phantom = check_diags(b"fn f<a>(n: Int) -> Int where numeric(a) = n");
  assert_eq(phantom.map(|diag: Diag| diag.code), [b"E0310"]);
  assert_eq(phantom.map(|diag: Diag| diag.message), [
    b"`a` appears in no parameter or answer of `f`",
  ]);
  assert_eq(
    check_codes(b"fn twice<a>(x: a) -> a where numeric(a) = x + x\nfn g() -> (Int) -> Int = twice"),
    [b"E0310"],
  );
  assert_eq(
    check_codes(
      b"fn d<a>(x: a, n: Int) -> a / {diverges} where numeric(a) = if n <= 0 { x } else { let f = d; f(x, n - 1) }",
    ),
    [b"E0310"],
  );
  // A call from another member of its group is a call like any other: here nothing says what `b` is.
  assert_eq(
    check_codes(
      Bytes::concat_all([
        b"fn ping<b>(n: Int) -> b where numeric(b) =\n",
        b"  if n <= 0 { numeric_of_int(0) } else { let _ = pong(n - 1); numeric_of_int(1) }\n",
        b"fn pong(n: Int) -> Int = { let _ = ping(n); n }",
      ]),
    ),
    [b"E0210"],
  )
}

test "a definition's witnesses take its scheme's order, which its calls pass them in" {
  let checker = checked_cx(
    Bytes::concat_all([
      b"fn mixed<a, b>(x: a, y: b) -> a where numeric(b), numeric(a) = x\n",
      b"fn deep<a>(x: a, n: Int) -> a where numeric(a) = if n == 0 { x } else { deep(x, n - 1) }\n",
      b"fn go() -> U8 = mixed(1u8, 2.5)",
    ]),
  );
  assert_eq(checker.witness_orders.map(|o: WitnessOrder| { name: o.name, params: o.params }), [
    { name: b"mixed", params: [b"a", b"b"] },
    { name: b"deep", params: [b"a"] },
  ]);
  let passed = refs_in(checker.witness_refs, 0).values();
  assert_eq(passed.len(), 2);
  assert(
    passed.fold(false, |b: Bool, ws: List<NumericWitness>|
      b || ws == [ConcreteWitness(b"U8"), ConcreteWitness(b"Float")]),
  );
  assert(passed.fold(false, |b: Bool, ws: List<NumericWitness>| b || ws == [ParamWitness(b"a")]))
}

/// A one-module program as the checker leaves it.
fn checked_cx(src: Bytes) -> Checker / {abort.raise} = {
  let r = parse(src);
  let x = expand(r.node, r.parser.diags);
  let d: Expansion = expand_derives(0, b"m", x.module);
  match resolve_modules([{ name: b"m", module: d.module, derived: d.derived }]) {
    ResolveFailed(_) -> panic("a source the test wrote does not resolve"),
    ResolveSucceeded(y) -> check_program(y.r, y.mods).checker,
  }
}

fn held_io(body: Bytes) -> Bytes =
  b"effect io {\n  write open(n: Int) -> Int\n  write close(h: Int) -> Unit\n  write pull(h: Int) -> Int\n}\n".concat(
    body,
  )

test "a hold is read inside its region, whose row is its acquire's, its release's and its body's" {
  assert_eq(
    check_codes(
      held_io(
        b"fn f() -> Int / {io.open, io.close, io.pull} = with_hold[file](io.open(1), |h: Int| io.close(h)) { h -> io.pull(h.get()) }",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      held_io(
        b"fn f() -> Int / {io.open, io.pull} = with_hold[file](io.open(1), |h: Int| io.close(h)) { h -> io.pull(h.get()) }",
      ),
    ),
    [b"E0302"],
  );
  // The release is a function of what was acquired, answering nothing.
  assert_eq(check_codes(b"fn f() -> Int = with_hold[file](1, |h: String| ()) { h -> h.get() }"), [
    b"E0201",
  ]);
  assert_eq(check_codes(b"fn f() -> Int = with_hold[file](1, |h: Int| h) { h -> h.get() }"), [
    b"E0201",
  ])
}

test "a function handed a hold reads it under its region's label, which the region answers" {
  let peek = b"fn peek<[r]>(h: Hold<Int, [r]>) -> Int / {hold.read[r]} = h.get()\n";
  assert_eq(
    check_codes(
      peek.concat(b"fn f() -> Int = with_hold[file](1, |x: Int| ()) { h -> peek(h) + peek(h) }"),
    ),
    [],
  );
  assert_eq(check_codes(b"fn peek<[r]>(h: Hold<Int, [r]>) -> Int = h.get()"), [b"E0302"]);
  // A hold's type names its region's label, as its reads do.
  assert_eq(check_codes(b"fn kept(h: Hold<Int>) -> Int = 0"), [b"E0202"]);
  // A region answers the reads of its own hold and of no other: one inside a closure that reads an
  // outer hold too leaves that read in the closure's row, where the outer region sees it leave.
  assert_eq(
    refusals(
      b"fn f() -> Int = { let k = with_hold[outer](41, |x: Int| ()) { h -> || with_hold[inner](1, |x: Int| ()) { g -> h.get() + g.get() } }; 0 }",
    ),
    [
      [
        b"E0446",
        b"a hold escapes its `with_hold[outer]` region",
        b"|| with_hold[inner](1, |x: Int| ()) { g -> h.get() + g.get() }",
      ],
    ],
  );
  assert_eq(check_codes(b"fn f() -> Unit / {hold.read} = hold.read()"), [b"E0103"]);
  assert_eq(check_codes(b"effect hold { read get() -> Int }"), [b"E0105"])
}

test "the labels a call writes fill those that name no region, which the hold passed fills" {
  let noted = b"effect log { write say[l](n: Int) -> Unit }\nfn noted<[l], [r]>(h: Hold<Int, [r]>) -> Unit / {log.write[l], hold.read[r]} = log.say[l](h.get())\n";
  let inside = |call: Bytes|
    Bytes::concat_all([
      noted,
      b"fn f() -> Unit / {log.write[out]} = with_hold[file](1, |x: Int| ()) { h -> ",
      call,
      b" }",
    ]);
  assert_eq(check_codes(inside(b"noted[out](h)")), []);
  assert(
    refused_with(
      inside(b"noted[out, file](h)"),
      b"E0306",
      b"`noted` takes 1 label parameter, but 2 are written",
    ),
  );
  assert(
    refused_with(inside(b"noted(h)"), b"E0306", b"this call leaves a label of `noted` unfilled"),
  );
  let peek = b"fn peek<[r]>(h: Hold<Int, [r]>) -> Int / {hold.read[r]} = h.get()\n";
  assert(
    refused_with(
      peek.concat(b"fn f() -> Int = with_hold[file](1, |x: Int| ()) { h -> peek[file](h) }"),
      b"E0306",
      b"`peek` takes no label a call writes",
    ),
  );
  // A callback's row names the region as a hold's type does.
  let through = b"fn through<[l], [r] | e>(k: () -> Int / {hold.read[r] | e}) -> Unit / {log.write[l], hold.read[r] | e} = log.say[l](k())\n";
  assert_eq(
    check_codes(
      Bytes::concat_all([
        noted,
        through,
        b"fn f() -> Unit / {log.write[out]} = with_hold[file](1, |x: Int| ()) { h -> through[out](|| h.get()) }",
      ]),
    ),
    [],
  )
}

test "a hold that leaves its region is refused where it leaves" {
  assert_eq(refusals(b"fn f() -> Int = { let k = with_hold[r](1, |x: Int| ()) { h -> h }; 0 }"), [
    [b"E0446", b"a hold escapes its `with_hold[r]` region", b"h"],
  ]);
  assert_eq(
    refusals(b"fn f() -> Int = { let k = with_hold[r](1, |x: Int| ()) { h -> || h.get() }; 0 }"),
    [[b"E0446", b"a hold escapes its `with_hold[r]` region", b"|| h.get()"]],
  );
  // A function that answers a closure over a hold says `hold.read` in the closure's row.
  assert_eq(
    check_codes(
      b"fn later<[l]>(h: Hold<Int, [l]>) -> () -> Int / {hold.read[l]} = || h.get()\nfn f() -> Int = { let k = with_hold[r](1, |x: Int| ()) { h -> later(h) }; 0 }",
    ),
    [b"E0446"],
  );
  assert_eq(check_codes(b"fn later<[l]>(h: Hold<Int, [l]>) -> () -> Int = || h.get()"), [b"E0302"])
}

test "a hold kept in an older cell, handed to an operation, or given an older scheduler's task is refused" {
  assert_eq(
    check_codes(
      b"fn f() -> Int = with_cell[o](None) { c -> { with_hold[r](1, |x: Int| ()) { h -> cell_set(c, Some(h)) }; 0 } }",
    ),
    [b"E0446"],
  );
  assert_eq(
    check_codes(
      b"effect box { write put<a>(x: a) -> Unit }\nfn f() -> Unit / {box.put} = with_hold[r](1, |x: Int| ()) { h -> box.put(h) }",
    ),
    [b"E0446"],
  );
  assert_eq(
    check_codes(
      b"fn f() -> Int / {task.spawn} = with_hold[r](1, |x: Int| ()) { h -> { let t = task.spawn(|| h.get()); 0 } }",
    ),
    [b"E0446"],
  );
  assert_eq(
    check_codes(
      b"fn f() -> Int / {sim.read, abort.raise} = with_hold[r](1, |x: Int| ()) { h -> simulate { task.join(task.spawn(|| h.get())) } }",
    ),
    [],
  )
}

test "a hold's region is its own: neither it nor a cell's reuses a name that is open" {
  let nested = |outer: Bytes, inner: Bytes|
    check_codes(
      Bytes::concat_all([b"fn f() -> Int = ", outer, b" { a -> ", inner, b" { b -> 0 } }"]),
    );
  assert_eq(nested(b"with_hold[r](1, |x: Int| ())", b"with_hold[r](2, |x: Int| ())"), [b"E0330"]);
  assert_eq(nested(b"with_cell[r](1)", b"with_hold[r](2, |x: Int| ())"), [b"E0330"]);
  assert_eq(nested(b"with_hold[r](1, |x: Int| ())", b"with_cell[r](2)"), [b"E0330"]);
  assert_eq(nested(b"with_hold[r](1, |x: Int| ())", b"with_hold[s](2, |x: Int| ())"), []);
  assert_eq(nested(b"with_cell[r](1)", b"with_cell[r](2)"), [])
}

// A definition that opened a region of a caller's name used to answer for the caller's cell, and
// hand back a closure whose row no longer said it read one.
test "a region's label is its own: a row another definition writes names no region" {
  let wrap = b"fn wrap(k: () -> Int / {cell.read[work]}) -> () -> Int = || with_cell[work](0) { d -> cell_get(d) + k() }\n";
  let leak = b"fn leak() -> () -> Int = with_cell[work](41) { c -> wrap(|| cell_get(c)) }";
  // Its region answers none of what `k` reads, so the closure it hands back still reads a cell.
  assert(check_codes(wrap).contains(b"E0302"));
  // And a closure over this region's cell is no `cell.read[work]` a parameter could ask for.
  let asked = b"fn wrap(k: () -> Int / {cell.read[work]}) -> Int = 0\n".concat(leak);
  // The two rows print alike, so the refusal says which `work` each is.
  assert_eq(
    check_diags(asked).filter(|diag: Diag| diag.code == b"E0302").map(|diag: Diag|
      diag.notes_text.at(1)),
    [
      Some(
        b"one `work` is the region `with_cell[work]` opens and the other is the resource of that name, which is all a row written outside the region names",
      ),
    ],
  );
  // A callee generic over the row takes the closure, and its own region answers none of it.
  let generic = Bytes::concat_all([
    b"fn each<| e>(k: () -> Int / e) -> Int / e = with_cell[work](0) { d -> cell_get(d) + k() }\n",
    b"fn held() -> Int = with_cell[work](41) { c -> each(|| cell_get(c)) }",
  ]);
  assert_eq(check_codes(generic), []);
  // What reads an outer region leaves an inner one, and the outer region still answers it.
  assert_eq(
    check_codes(
      b"fn f() -> Int = with_cell[a](40) { x -> { let k = with_cell[b](2) { y -> { let n = cell_get(y); || cell_get(x) + n } }; k() } }",
    ),
    [],
  );
  assert_eq(
    check_codes(
      b"fn f() -> Int = with_hold[a](40, |x: Int| ()) { h -> { let k = with_hold[b](2, |x: Int| ()) { g -> { let n = g.get(); || h.get() + n } }; k() } }",
    ),
    [],
  );
  // The name is the region's for its cells alone: another effect's label of that name is the
  // resource it always was, so a clause inside the region answers what a callee performs on it.
  let other = Bytes::concat_all([
    b"effect tally { write note[r](n: Int) -> Unit }\n",
    b"fn noted(n: Int) -> Unit / {tally.write[log]} = tally.note[log](n)\n",
    b"fn held(n: Int) -> Int = with_cell[log](0) { c -> { handle { noted(n) } with { tally.note[log](what) -> cell_set(c, what) }; cell_get(c) } }",
  ]);
  assert_eq(check_codes(other), [])
}

test "a declaration that mentions a `Hold`, or a function that reads one, is refused" {
  assert_eq(refusals(b"type Kept<[r]> = Kept(Hold<Int, [r]>)"), [
    [b"E0446", b"`Kept`'s field 1 mentions a `Hold`", b"Hold<Int, [r]>"],
  ]);
  assert_eq(check_codes(b"effect io { write put[r](h: Hold<Int, [r]>) -> Unit }"), [b"E0446"]);
  assert_eq(check_codes(b"type Hidden<[r]> = Hidden(() -> Int / {hold.read[r]})"), [b"E0446"])
}

// A cell is a name and no value: stored inside its own contents it asks for an infinite type, and
// a declared field that holds one is refused like one holding a `Hold`.
test "a cell can be stored neither in what it holds nor in a declared field" {
  assert(
    check_codes(
      b"fn f() -> Int = with_cell[log]([]) { c -> {\n  cell_set(c, [c]);\n  1\n} }\n",
    ).contains(
      b"E0203",
    ),
    Some("a cell stored in a list it holds"),
  );
  assert(
    check_codes(
      b"type Loop = Nil | Node(Cell<Loop>)\nfn f() -> Int = with_cell[log](Nil) { c -> {\n  cell_set(c, Node(c));\n  1\n} }\n",
    ).contains(
      b"E0446",
    ),
    Some("a declared field holding a cell"),
  )
}

// A constructor's own row check sees through the closure it is handed, so wrapping a closure that
// reads a cell is no way to carry the cell out of its region; the refusal names the region.
test "a constructor does not launder a cell inside the closure it holds" {
  let diags = check_diags(
    b"type Boxed = Empty | Wrap(() -> Int)\nfn boxed() -> Boxed = with_cell[log](41) { c -> Wrap(|| cell_get(c)) }\n",
  );
  match diags.filter(|diag: Diag| diag.code == b"E0302") {
    [] -> panic("the constructor's own row check refuses it"),
    [d, ..] ->
      assert(
        d.message.index_of(b"log") != None
          || d.notes_text.filter(|n: Bytes| n.index_of(b"log") != None).len() > 0,
        Some(String::of_bytes_lossy(d.message)),
      ),
  }
}

// A generator cannot inhabit a handle, so a law over a record that holds one is refused where the
// law is written and no generated value can carry a cell.
test "a law cannot quantify over a record that reaches a region" {
  assert(
    check_codes(b"law \"no\" forall (r: {h: Hold<Int, [x]>}) { true }\n").contains(b"E0418"),
    None,
  )
}

fn escapes(src: Bytes) -> Bool / {abort.raise} =
  check_diags(src).filter(|diag: Diag| diag.message.index_of(b"escapes its") != None).len() > 0

// A cell is reached only inside its region, so no carrier takes it out: a closure, a record of
// closures, one that only writes, a list or a record field.
test "no closure, list or record carries a cell out of its region" {
  assert(
    escapes(
      b"test \"smuggle\" {\n  let read = with_cell[log](41) { c -> || cell_get(c) };\n  assert_eq(read(), 41)\n}\n",
    ),
    Some("a closure"),
  );
  assert(
    escapes(
      b"test \"smuggle\" {\n  let ops = with_cell[log](1) { c -> {get: || cell_get(c), put: |v| cell_set(c, v)} };\n  let get = ops.get;\n  let put = ops.put;\n  put(9);\n  assert_eq(get(), 9)\n}\n",
    ),
    Some("a record of closures"),
  );
  assert(
    escapes(
      b"test \"smuggle\" {\n  let bump = with_cell[log](0) { c -> || cell_set(c, cell_get(c) + 1) };\n  bump()\n}\n",
    ),
    Some("a closure that only writes"),
  );
  assert(
    escapes(
      b"test \"smuggle\" {\n  let xs = with_cell[log](1) { c -> [c] };\n  assert_eq(xs.len(), 1)\n}\n",
    ),
    Some("a list"),
  );
  assert(
    escapes(
      b"test \"smuggle\" {\n  let r = with_cell[log](1) { c -> {cell: c} };\n  assert_eq(cell_get(r.cell), 1)\n}\n",
    ),
    Some("a record field"),
  )
}

// A declared `Cell` field is a brand with nowhere to appear, and its region variable is fixed by the
// first region that fills it.
test "a declared cell field is refused, and one variant cannot hold cells of two regions" {
  assert(
    check_codes(
      b"type Held = Held(Cell<Int>)\n\ntest \"out\" {\n  let h = with_cell[log](1) { c -> Held(c) };\n  match h { Held(c) -> { cell_set(c, 2); assert_eq(cell_get(c), 2) } }\n}\n",
    ).contains(
      b"E0446",
    ),
    Some("a cell in a constructor argument"),
  );
  assert(
    check_codes(
      b"type Held = Held(Cell<Int>)\n\ntest \"two\" {\n  let a = with_cell[log](1) { c -> Held(c) };\n  let b = with_cell[audit](2) { c -> Held(c) };\n  match a { Held(c) -> match b { Held(d) -> assert_eq(cell_get(c) + cell_get(d), 3) } }\n}\n",
    ).contains(
      b"E0201",
    ),
    Some("two regions through one variant"),
  )
}

// A credential has no order, no place as a map key and no digest, whatever it holds; that it has no
// text is the CLI suite's `derivable`, since interpolating imports `std.show`.
test "a secret of bytes is no more ordered, keyed or digested than one of a string" {
  [
    b"fn f(a: Secret<Bytes>, b: Secret<Bytes>) -> Ordering = compare(a, b)\n",
    b"fn f(m: Map<Secret<Bytes>, Int>) -> Int = m.len()\n",
    b"fn f(s: Secret<Bytes>) -> Bytes = digest(s)\n",
  ].fold((), |u: Unit, src: Bytes|
    assert(check_codes(src).contains(b"E0206"), Some(String::of_bytes_lossy(src))))
}

// A clause answers every perform site of a polymorphic operation at once, so it cannot pick a type:
// neither a concrete one, which would launder a secret into a string, nor a wrong one.
test "a clause may not answer a polymorphic operation with a type of its choosing" {
  let laundering = check_diags(
    b"effect vault { read fetch[k]<a>(s: Secret<String>) -> a }\nfn launder(s: Secret<String>) -> String / {vault.read[k]} = vault.fetch[k](s)\ntest \"launder\" {\n  handle {\n    assert_eq(launder(Secret::of_string(\"hunter2\")).len(), 7)\n  } with {\n    vault.fetch[k](s) -> s,\n  }\n}\n",
  );
  assert(
    laundering.filter(|diag: Diag|
        diag.code == b"E0201"
          && diag.notes_text.filter(|n: Bytes|
            n.index_of(b"every type a perform site could ask for") != None).len(
          )
          > 0).len(
      )
      > 0,
    Some("the mismatch says why a clause cannot pick"),
  );
  assert(
    check_codes(
      b"effect box { read take[k]<a>() -> a }\nfn as_string() -> String / {box.read[k]} = box.take[k]()\ntest \"confuse\" {\n  handle {\n    assert_eq(as_string().len(), 1)\n  } with {\n    box.take[k]() -> 7,\n  }\n}\n",
    ).contains(
      b"E0201",
    ),
    Some("a wrong type"),
  )
}

// A `simulate` region answers the clock and randomness itself, from its seed, so an operation
// declared here and not answered there is refused inside every region; `tests/lang` performs each of
// these inside one.
test "the clock and randomness declare exactly the operations a region answers itself" {
  let ops_of = |name: Bytes|
    match prelude_effects().filter(|e: EffectInfo| e.name == name) {
      [e, ..] -> e.ops.map(|o: OpInfo| o.name),
      [] -> [],
    };
  assert_eq(ops_of(b"clock"), [b"now", b"sleep"]);
  assert_eq(ops_of(b"random"), [b"next", b"below"])
}

fn refused_with(src: Bytes, code: Bytes, said: Bytes) -> Bool / {abort.raise} =
  check_diags(src).filter(|diag: Diag|
      diag.code == code && diag.message.index_of(said) != None).len(
    )
    > 0

// A cell carried out of its region would dangle once the region handed its slot back, so every
// carrier is refused before it can: an element, a map key or value, a field, a generic
// constructor's field, a record inside a list, and a closure that reads it.
test "every carrier of a cell out of its region is refused before it can dangle" {
  [
    b"fn leak() = with_cell[k](0) { c -> [c] }\n",
    b"fn leak() = with_cell[k](0) { c -> Map::new().insert(c, 1) }\n",
    b"fn leak() = with_cell[k](0) { c -> Map::new().insert(1, c) }\n",
    b"fn leak() = with_cell[k](0) { c -> {held: c} }\n",
    b"type Box<a> = | B(a)\nfn leak() = with_cell[k](0) { c -> B(c) }\n",
    b"fn leak() = with_cell[k](0) { c -> [{held: [c]}] }\n",
    b"fn leak() = with_cell[k](0) { c -> || cell_get(c) }\n",
  ].fold((), |u: Unit, src: Bytes| {
    let codes = check_codes(src);
    assert(codes.contains(b"E0201") || codes.contains(b"E0446"), Some(String::of_bytes_lossy(src)))
  })
}

test "a cell is a name: read and written where it is bound, captured by a closure, and no value" {
  let bound = |body: Bytes|
    check_codes(Bytes::concat_all([b"fn f() -> Int = with_cell[k](1) { c -> ", body, b" }"]));
  assert_eq(bound(b"{ cell_set(c, 2); cell_update(c, |n: Int| n + 1); cell_get(c) }"), []);
  assert_eq(bound(b"{ let bump = || cell_set(c, cell_get(c) + 1); bump(); cell_get(c) }"), []);
  assert(bound(b"{ let x = c; 0 }").contains(b"E0446"));
  assert(bound(b"{ let x = [c]; 0 }").contains(b"E0446"));
  assert(bound(b"{ let x = Some(c); 0 }").contains(b"E0446"));
  assert(bound(b"cell_get(match 0 { _ -> c })").contains(b"E0446"));
  assert(
    refused_with(
      b"fn f() -> Int = with_cell[k](1) { c -> { let x = c; 0 } }",
      b"E0446",
      b"the cell `c` is used as a value",
    ),
  );
  assert_eq(check_codes(b"fn peek(c: Cell<Int>) -> Int = 0"), [b"E0446"])
}

test "a region in a law's body reports its escape" {
  assert(
    refused_with(
      b"law \"leak\" forall (n: Int) { with_cell[r](n) { c -> c } == 0 }\n",
      b"E0201",
      b"escapes its `with_cell[r]` region",
    ),
    None,
  )
}

// A scheduler older than the region drains what nobody joined after the region's close, and no type
// records a join, so a cell may reach a task only where the scheduler is opened inside its region.
test "a cell handed to a task the region outlives is refused, and one inside its scheduler is not" {
  [
    b"pub fn attack() -> Int / {sim.read, abort.raise} = simulate {\n  { let t = with_cell[s](11) { c -> task.spawn(|| cell_get(c)) };\n    task.join(t) }\n}\n",
    b"pub fn attack() -> Int / {sim.read, abort.raise} = simulate {\n  with_cell[s](11) { c -> { let t = task.spawn(|| cell_get(c)); task.join(t) } }\n}\n",
  ].fold((), |u: Unit, src: Bytes|
    assert(
      refused_with(src, b"E0446", b"sent to another task"),
      Some(String::of_bytes_lossy(src)),
    ));
  assert_eq(
    check_codes(
      b"pub fn guarded() -> Int / {sim.read, abort.raise} =\n  with_cell[s](11) { c -> simulate { task.join(task.spawn(|| cell_get(c))) } }\n",
    ),
    [],
  )
}

// A law or a clause of a contract is judged at points the prover picks, so it performs nothing: a
// specification never reaches the host.
test "a specification can never perform, so it never reaches the host" {
  let net = b"nondet effect net {\n  write send[s](payload: Int) -> Int\n}\n";
  assert(
    check_codes(
      net.concat(b"law \"sends agree\" forall (n: Int) {\n  net.send[socket](n) == n\n}\n"),
    ).contains(
      b"E0417",
    ),
    Some("a law"),
  );
  assert(
    check_codes(
      net.concat(
        b"fn relay(n: Int) -> Int / {net.write[socket]}\n  ensures result == net.send[socket](n)\n= net.send[socket](n)\n",
      ),
    ).contains(
      b"E0417",
    ),
    Some("an ensures clause"),
  )
}

// A host operation's signature is no way across the boundary for a handle: a cell in it names no
// resource, and a closure over a cell carries the region's atoms out with it.
test "a cell crosses no host operation's signature, bare or in a closure" {
  assert(
    check_codes(
      b"nondet effect net {\n  write send[s](c: Cell<Int>) -> Cell<Int>\n}\n\ntest/nondet \"smuggle a cell\" {\n  with_cell[users](5) { c -> assert_eq(cell_get(net.send[socket](c)), 5) }\n}\n",
    ).contains(
      b"E0304",
    ),
    Some("a bare cell"),
  );
  assert(
    check_codes(
      b"nondet effect net {\n  write send[s](f: () -> Int) -> () -> Int\n}\n\ntest/nondet \"smuggle a closure over a cell\" {\n  with_cell[users](5) { c -> {\n    let g = net.send[socket](|| cell_get(c));\n    assert_eq(g(), 5)\n  } }\n}\n",
    ).contains(
      b"E0302",
    ),
    Some("a closure over a cell"),
  )
}

test "a bracket's closures run as one, so a body generic over its row admits the release's" {
  let effect_io = b"effect io { write close(h: Int) -> Unit }\n";
  assert_eq(
    check_codes(
      effect_io.concat(
        b"fn served<| e>(h: Int, app: () -> Unit / e) -> Unit / {io.close | e} = bracket(|| h, |x: Int| io.close(x), |x: Int| app())",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      effect_io.concat(
        b"fn served<| e>(h: Int, app: () -> Unit / e) -> Unit / e = bracket(|| h, |x: Int| io.close(x), |x: Int| app())",
      ),
    ),
    [b"E0302"],
  )
}

/// A one-module program's diagnostics, in order; empty when it checks.
fn check_diags(src: Bytes) -> List<Diag> / {abort.raise} = {
  let r = parse(src);
  let x = expand(r.node, r.parser.diags);
  let d: Expansion = expand_derives(0, b"m", x.module);
  match resolve_modules([{ name: b"m", module: d.module, derived: d.derived }]) {
    ResolveFailed(ds) -> ds,
    ResolveSucceeded(y) -> dedup_diags(check_program(y.r, y.mods).checker.diags),
  }
}

fn check_codes(src: Bytes) -> List<Bytes> / {abort.raise} =
  check_diags(src).map(|diag: Diag| diag.code)

test "a declared type is closed: a label in it is its own parameter or a resource, never a user's binder" {
  let uses = |decl: Bytes, t: Bytes|
    Bytes::concat_all([
      b"effect net { write send[r](Bytes) -> Unit }\n",
      decl,
      b"\npub fn plain(f: ",
      t,
      b") -> Int = 1\npub fn relay<[l]>(f: ",
      t,
      b") -> Int = 1",
    ]);
  // Under `relay`'s binder the alias still names the resource `l`, so the binder prints apart from it.
  assert_eq(
    check_dump([
      { name: b"m", src: uses(b"type Sender = (Bytes) -> Unit / {net.send[l]}", b"Sender") },
    ]),
    "K;1;F;m.plain;((Bytes) -> Unit / {m.net.send[l]}) -> Int;;;;"
      ++ "F;m.relay;<[m]>((Bytes) -> Unit / {m.net.send[l]}) -> Int;;;;"
      ++ "E;m.net;0;send:write:1:Bytes:Unit;",
  );
  let own = check_dump([
    {
      name: b"m",
      src: uses(b"type Sender<[k]> = (Bytes) -> Unit / {net.send[k]}", b"Sender<[l]>"),
    },
  ]);
  assert(own.contains("F;m.plain;((Bytes) -> Unit / {m.net.send[l]}) -> Int;"));
  assert(own.contains("F;m.relay;<[l]>((Bytes) -> Unit / {m.net.send[l]}) -> Int;"));
  // A row variable has no resource to fall back on.
  assert_eq(check_codes(b"type Cb = () -> Unit / e\nfn run<| e>(c: Cb) -> Unit / e = c()"), [
    b"E0301",
  ])
}

test "a sum is printed with the labels and rows it is given, and its constructor binds them" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"effect net { write send[r](Bytes) -> Unit }\npub type Sink<a, [l] | e> = | Sink((a) -> Unit / {net.send[l] | e})\npub fn held<[l] | e>(s: Sink<Int, [l] | {net.send[conn] | e}>) -> Sink<Int, [l] | {net.send[conn] | e}> = s\npub fn kept(s: Sink<Int, [conn] | {}>) -> Sink<Int, [conn] | {}> = s",
    },
  ]);
  assert(
    dump.contains(
      "F;m.held;<[l] | e>(m.Sink<Int, [l] | {m.net.send[conn] | e}>) -> m.Sink<Int, [l] | {m.net.send[conn] | e}>;;;;",
    ),
  );
  assert(dump.contains("F;m.kept;(m.Sink<Int, [conn] | {}>) -> m.Sink<Int, [conn] | {}>;;;;"));
  assert(
    dump.contains(
      "C;m.Sink;m.Sink;0;1;<a, [l] | e>((a) -> Unit / {m.net.send[l] | e}) -> m.Sink<a, [l] | e>;",
    ),
  )
}

test "a sum's row argument is exact, and an alias's lands in a function type a narrower one meets" {
  let net = b"effect net { write send[s](p: Bytes) -> Unit\n write recv[s](n: Int) -> Bytes }\n";
  let boxed = |made: Bytes|
    Bytes::concat_all([
      net,
      b"type Box<| e> = | Box(() -> Unit / e)\n",
      b"fn open(b: Box<| {net.write[x]}>) -> Unit / {net.write[x]} = match b { Box(f) -> f() }\n",
      b"fn go(f: () -> Unit / {net.send[x]}) -> Unit / {net.write[x]} = ",
      made,
    ]);
  assert_eq(check_codes(boxed(b"open(Box(f))")), [b"E0302"]);
  // The annotation is where the narrower function meets the row the sum is given.
  assert_eq(check_codes(boxed(b"{ let g: () -> Unit / {net.write[x]} = f; open(Box(g)) }")), []);
  let aliased = Bytes::concat_all([
    net,
    b"type Thunk<| e> = () -> Unit / e\n",
    b"fn open(f: Thunk<| {net.write[x]}>) -> Unit / {net.write[x]} = f()\n",
    b"fn go(f: Thunk<| {net.send[x]}>) -> Unit / {net.write[x]} = open(f)",
  ]);
  assert_eq(check_codes(aliased), []);
  // Two labels are two types, as two rows are.
  let labelled = Bytes::concat_all([
    net,
    b"type Sink<[l]> = | Sink((Bytes) -> Unit / {net.send[l]})\n",
    b"fn to(s: Sink<[a]>) -> Int = 1\n",
    b"fn go(s: Sink<[b]>) -> Int = to(s)",
  ]);
  assert_eq(check_diags(labelled).map(|diag: Diag| { code: diag.code, text: diag.text }), [
    { code: b"E0201", text: b"argument type|[a]|[b]" },
  ])
}

test "a use fills as many labels and rows as its type binds, and a declaration's row variable is its own" {
  let decls = b"effect net { write send[s](p: Bytes) -> Unit }\ntype Box<| e> = | Box(() -> Unit / e)\ntype Sink<[l]> = | Sink(() -> Unit / {net.send[l]})\ntype Thunk<| e> = () -> Unit / e\n";
  let used = |ty: Bytes| Bytes::concat_all([decls, b"fn f(x: ", ty, b") -> Int = 1"]);
  let messages = |ty: Bytes| check_diags(used(ty)).map(|diag: Diag| diag.message);
  assert_eq(messages(b"Box"), [b"`Box` takes 1 row argument, but 0 were supplied"]);
  assert_eq(messages(b"Thunk"), [b"`Thunk` takes 1 row argument, but 0 were supplied"]);
  assert_eq(messages(b"Box<| {}, {}>"), [b"`Box` takes 1 row argument, but 2 were supplied"]);
  assert_eq(messages(b"Sink"), [b"`Sink` takes 1 label argument, but 0 were supplied"]);
  assert_eq(messages(b"Sink<[a, b]>"), [b"`Sink` takes 1 label argument, but 2 were supplied"]);
  assert_eq(messages(b"List<Int | {}>"), [b"`List` takes 0 row arguments, but 1 was supplied"]);
  assert_eq(check_codes(used(b"Box<| {}, {}>")), [b"E0202"]);
  assert_eq(check_codes(used(b"Box<| {net.send[x] | e}>")), [b"E0301"]);
  assert_eq(check_codes(b"type Bad<a> = | Bad((a) -> Unit / e)"), [b"E0301"]);
  // Among the type parameters a name binds a type, so the row that names it is still unbound.
  assert_eq(check_codes(b"type Bad<a, e> = | Bad((a) -> Unit / e)"), [b"E0301"]);
  assert_eq(check_codes(used(b"Box<| {net.send[x] bounded}>")), [b"E0466"])
}

test "a row a declared field writes may not reach a region, and one the type is given is seen leaving" {
  let hidden = check_diags(b"type Hidden = | Hidden(Int, () -> Int / {cell.read[work]})");
  assert_eq(hidden.map(|diag: Diag| [diag.code, diag.message]), [
    [b"E0446", b"`Hidden`'s field 2 holds a function whose row reaches a `Cell`"],
  ]);
  assert_eq(check_codes(b"type Joined<| e> = | Joined(() -> Int / {task.join | e})"), [b"E0446"]);
  assert_eq(
    check_codes(
      b"type Box<| e> = | Box(() -> Int / e)\ntype Hidden = | Hidden(Box<| {cell.write[work]}>)",
    ),
    [b"E0446"],
  );
  let given = b"type Box<| e> = | Box(() -> Int / e)\n";
  assert_eq(
    check_codes(
      given.concat(
        b"fn leak() -> Box<| {cell.read[work]}> = with_cell[work](7) { c -> Box(|| cell_get(c)) }",
      ),
    ),
    [b"E0201"],
  );
  assert_eq(
    check_codes(
      given.concat(
        b"fn kept() -> Int = with_cell[work](7) { c -> match Box(|| cell_get(c)) { Box(f) -> f() } }",
      ),
    ),
    [],
  )
}

test "a law does not quantify over a sum whose function performs the type's row parameter" {
  let src = |binder: Bytes|
    Bytes::concat_all([
      b"type Box<| e> = | Box(() -> Int / e)\ntype Thunk<| e> = () -> Int / e\n",
      b"effect log { write note() -> Unit }\n",
      b"law \"held\" forall (b: ",
      binder,
      b") { true }",
    ]);
  assert_eq(check_codes(src(b"Box<| {}>")), [b"E0418"]);
  assert_eq(check_codes(src(b"Box<| {log.note}>")), [b"E0418"]);
  assert_eq(check_codes(src(b"Thunk<| {log.note}>")), [b"E0418"]);
  assert_eq(check_codes(src(b"Thunk<| {}>")), [])
}

test "a `Map` key an alias leaves unordered is refused at every signature naming the alias" {
  let src = b"type Keyed = Map<(Int) -> Int, Int>\nfn first(m: Keyed) -> Int = m.len()\nfn second(m: Keyed) -> Int = m.len()";
  let primary = |diag: Diag|
    diag.labels.fold(b"", |acc: Bytes, label: Label|
      if label.primary { src.slice(label.start, label.end) } else { acc });
  assert_eq(check_diags(src).map(primary), [b"Keyed", b"Keyed"])
}

fn fixes_of(diags: List<Diag>) -> List<Fix> =
  diags.fold([], |acc: List<Fix>, diag: Diag| acc.concat(diag.fixes))

/// Last edit first, so each offset still points where it did.
fn fixed_by(src: Bytes, fix: Fix) -> Bytes / {abort.raise} = {
  let n = fix.edits.len();
  range(0, n).fold(src, |s: Bytes, i: Int| {
    let e = fix.edits.get(n - 1 - i);
    Bytes::concat_all([s.slice(0, e.start), e.text, s.slice(e.end, s.len())])
  })
}

fn refuses_a_value(form: Bytes) -> Unit / {abort.raise} = {
  let src = |body: Bytes| Bytes::concat_all([form, b" \"t\" { ", body, b" }"]);
  let start = form.len() + 7;
  assert_eq(check_codes(src(b"assert(true)")), []);
  assert_eq(check_codes(src(b"let x = 1; ()")), []);
  let valued = check_diags(src(b"1"));
  assert_eq(valued.map(|diag: Diag| diag.code), [b"E0201"]);
  assert_eq(valued.map(|diag: Diag| diag.message), [b"type mismatch: the body of test `t`"]);
  assert_eq(valued.map(|diag: Diag| diag.labels), [
    [
      {
        module: 0,
        start: start,
        end: start + 1,
        primary: true,
        text: b"expected `Unit`, found `Int`",
      },
    ],
  ]);
  assert_eq(fixes_of(valued).map(|fix: Fix| fix.title), [b"end the body with `()`"]);
  assert_eq(fixes_of(valued).map(|fix: Fix| fixed_by(src(b"1"), fix)), [src(b"1; ()")]);
  assert_eq(check_codes(src(b"1; ()")), []);
  let compared = check_diags(src(b"let x = 1; x == 2"));
  assert_eq(
    compared.map(|diag: Diag| diag.labels.map(|label: Label| (label.start, label.end, label.text))),
    [[(start + 11, start + 17, b"expected `Unit`, found `Bool`")]],
  );
  assert_eq(fixes_of(compared).map(|fix: Fix| fix.title), [b"wrap it in `assert`"]);
  assert_eq(fixes_of(compared).map(|fix: Fix| fixed_by(src(b"let x = 1; x == 2"), fix)), [
    src(b"let x = 1; assert(x == 2)"),
  ]);
  assert_eq(check_codes(src(b"let x = 1; assert(x == 2)")), [])
}

test "a test body is `Unit`, so one that ends on a value is refused with a fix that makes it check" {
  refuses_a_value(b"test");
  refuses_a_value(b"test/nondet")
}

fn net_src(rest: Bytes) -> Bytes =
  b"effect net { write send[s](payload: Bytes) -> Unit\n write recv[s](max: Int) -> Bytes\n write close[s]() -> Unit\n read peek[s]() -> Int }\n".concat(
    rest,
  )

/// Each diagnostic a one-module program draws: its code, its message, and whether its first label
/// spans the first place `src` writes `name`.
fn refused_at(
  src: Bytes,
  name: Bytes,
) -> List<{ code: Bytes, message: Bytes, on_name: Bool }> / {abort.raise} = {
  let start = match src.index_of(name) {
    Some(i) -> i,
    None -> panic("the source names what it is refused for"),
  };
  check_diags(src).map(|diag: Diag| {
    let l: Label = diag.labels.get(0);
    {
      code: diag.code,
      message: diag.message,
      on_name: l.start == start && l.end == start + name.len(),
    }
  })
}

test "an operation naming a type nothing declares is refused at the name" {
  let unknown = [{ code: b"E0102", message: b"unknown type `Frnt`", on_name: true }];
  assert_eq(
    refused_at(b"effect prover { write configure(front: Frnt) -> Unit }", b"Frnt"),
    unknown,
  );
  assert_eq(refused_at(b"effect prover { read collected() -> Frnt }", b"Frnt"), unknown);
  assert_eq(refused_at(b"effect prover { read collected() -> List<Frnt> }", b"Frnt"), unknown)
}

test "an unknown type in an operation is the error it is in a function's signature" {
  let unlabelled = |diags: List<Diag>| diags.map(|diag: Diag| { ..diag, labels: [] });
  assert_eq(
    unlabelled(check_diags(b"effect e { write put(x: Frnt) -> Unit }")),
    unlabelled(check_diags(b"fn put(x: Frnt) -> Unit = ()")),
  )
}

test "an operation's type variables are the ones its own list declares" {
  assert_eq(refused_at(b"effect box { read take[k]() -> elem }", b"elem"), [
    { code: b"E0102", message: b"unknown type variable `elem`", on_name: true },
  ]);
  assert_eq(
    check_codes(
      b"effect box { read take[k]<elem>(xs: List<elem>) -> elem }\nfn first(xs: List<Int>) -> Int / {box.read[k]} = box.take[k](xs)\nfn named(xs: List<String>) -> String / {box.read[k]} = box.take[k](xs)",
    ),
    [],
  )
}

test "a `cost` clause bounds a definition that ends and only raises, by an `Int` over its parameters" {
  assert_eq(
    check_codes(b"fn f(xs: List<Int>) -> Int cost xs.len() * (xs.len() + 1) = xs.len()"),
    [],
  );
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Int / {abort.raise} cost 1 = 100 / xs.len()"), []);
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Int cost xs.len() > 0 = 0"), [b"E0201"]);
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Int cost result = 0"), [b"E0101"]);
  assert_eq(check_codes(b"fn f(n: Int) -> Int / {diverges} cost n = f(n + 1)"), [b"E0468"]);
  assert_eq(
    check_codes(
      b"effect tally { write bump() -> Unit }\nfn f(xs: List<Int>) -> Unit / {tally.bump} cost xs.len() = tally.bump()",
    ),
    [b"E0463"],
  );
  assert_eq(check_codes(b"fn f<| e>(g: () -> Int / e cost k) -> Int / e cost k = g()"), []);
  assert_eq(
    check_codes(b"fn f(g: (Int) -> Int cost k, xs: List<Int>) -> Int cost xs.len() * k = 0"),
    [],
  );
  // A cost name is read by `cost` clauses alone, and only a function parameter has one.
  assert_eq(check_codes(b"fn f(g: (Int) -> Int cost k) -> Int requires k > 0 = 0"), [b"E0101"]);
  assert_eq(check_codes(b"fn f(g: (Int) -> Int cost k) -> Int = k"), [b"E0101"]);
  assert_eq(check_codes(b"fn f(g: (Int) -> Int cost g) -> Int cost g = 0"), [b"E0105"]);
  assert_eq(check_codes(b"fn f(g: () -> Int cost k, h: () -> Int cost k) -> Int cost k = 0"), [
    b"E0105",
  ])
}

test "a law binder naming a type nothing declares is refused, and a lowercase one is a variable" {
  assert_eq(refused_at(b"law \"l\" forall (x: Acount) { true }", b"Acount"), [
    { code: b"E0102", message: b"unknown type `Acount`", on_name: true },
  ]);
  assert_eq(check_codes(b"law \"l\" forall (x: a, y: List<a>) { true }"), [])
}

test "an instantiation is checked where it is written: what it is given, and what its schema quantifies there" {
  let over = |law: Bytes|
    b"law schema same<a>(f: (a) -> a) forall (x: a) where x == x { f(x) == x }\nfn id(n: Int) -> Int = n\nfn show(n: Int) -> String = n.to_string()\nfn held(t: Task<Int>) -> Task<Int> = t\nfn x(n: Int) -> Int = n\n".concat(
      law,
    );
  assert_eq(check_codes(over(b"law \"l\" = same(id)")), []);
  // A binder no argument settles stays a variable, and a definition named as a binder is not it.
  assert_eq(check_codes(over(b"law \"l\" = same(|v| v)")), []);
  assert_eq(check_codes(over(b"law \"l\" = same(x)")), []);
  assert_eq(check_codes(over(b"law \"l\" = same(show)")), [b"E0201"]);
  assert_eq(refused_at(over(b"law \"l\" = same(held)"), b"same(held)"), [
    { code: b"E0418", message: b"`forall` cannot quantify over `x`", on_name: true },
  ]);
  assert_eq(check_codes(over(b"law \"l\" = sam(id)")).at(0), Some(b"E0101"))
}

test "a schema's guard and body are a law's: pure but for a raise, over binders a law could quantify" {
  let logged = |schema: Bytes|
    b"effect log { write emit(Bytes) -> Unit }\nfn noisy(n: Int) -> Int / {log.write} = { log.emit(b\"x\"); n }\nfn spin(n: Int) -> Int / {diverges} = spin(n + 1)\n".concat(
      schema,
    );
  let messages = |src: Bytes| check_diags(src).map(|diag: Diag| diag.message);
  assert_eq(
    messages(logged(b"law schema s(f: (Int) -> Int) forall (x: Int) { noisy(f(x)) == x }")),
    [b"a law schema's body cannot perform an effect"],
  );
  assert_eq(
    messages(
      logged(b"law schema s(f: (Int) -> Int) forall (x: Int) where noisy(x) > 0 { f(x) == x }"),
    ),
    [b"a `where` guard cannot perform an effect"],
  );
  assert_eq(
    check_codes(
      logged(b"law schema s(f: (Int) -> Int / {log.write}) forall (x: Int) { f(x) == x }"),
    ),
    [b"E0417"],
  );
  assert_eq(
    check_codes(
      logged(
        b"law schema s(f: (Int) -> Int / {abort.raise}) forall (x: Int) { f(x) / x == spin(x) }",
      ),
    ),
    [],
  );
  assert_eq(check_codes(b"law schema s(f: (Int) -> Int) forall (t: Task<Int>) { f(1) == 1 }"), [
    b"E0418",
  ]);
  assert_eq(messages(b"law schema s(f: (Int) -> Int) forall (x: Int) { f(x) }"), [
    b"type mismatch: a law states a proposition",
  ])
}

test "a schema's row parameter is what it is given may raise: any raise fills it, and nothing else" {
  let over = |law: Bytes|
    b"effect reader { raise refused(at: Int) }\neffect log { write emit(Bytes) -> Unit }\nlaw schema settles<a | e>(f: (a) -> a / e) forall (x: a) { f(f(x)) == f(x) }\nfn digit(n: Int) -> Int / {reader.refused} = if n < 0 { reader.refused(n) } else { n % 10 }\nfn half(n: Int) -> Int / {abort.raise} = 10 / n\nfn noisy(n: Int) -> Int / {log.emit} = { log.emit(b\"x\"); n }\nfn clamp(n: Int) -> Int = if n > 9 { 9 } else { n }\n".concat(
      law,
    );
  assert_eq(check_codes(over(b"law \"l\" = settles(clamp)")), []);
  assert_eq(check_codes(over(b"law \"l\" = settles(half)")), []);
  assert_eq(check_codes(over(b"law \"l\" = settles(digit)")), []);
  assert_eq(refused_at(over(b"law \"l\" = settles(noisy)"), b"settles(noisy)"), [
    { code: b"E0417", message: b"a law body cannot perform an effect", on_name: true },
  ]);
  // A parameter whose row writes a raise takes that raise and no other.
  let fixed = |law: Bytes|
    over(
      b"law schema reads(f: (Int) -> Int / {reader.refused}) forall (x: Int) { f(x) == f(x) }\n".concat(
        law,
      ),
    );
  assert_eq(check_codes(fixed(b"law \"l\" = reads(digit)")), []);
  assert_eq(check_codes(fixed(b"law \"l\" = reads(half)")), [b"E0302"]);
  // A row parameter no argument fills is empty where the schema is instantiated.
  assert_eq(
    check_codes(
      b"law schema fixed<a | e>(unit: a) forall (x: a) where x == unit { x == unit }\nlaw \"l\" = fixed(0)",
    ),
    [],
  )
}

test "an instantiation's binder settles to the `new` record what it is given takes" {
  let src = b"type Sign = new { negative: Bool }\ntype Bare = { negative: Bool }\nfn shown(s: Sign) -> String = if s.negative { \"-\" } else { \"+\" }\nfn read(t: String) -> Option<Sign> = if t == \"-\" { Some({ negative: true }) } else { Some({ negative: false }) }\nfn plain(t: String) -> Option<Bare> = Some({ negative: t == \"-\" })\nlaw schema reads_back<a>(f: (a) -> String, g: (String) -> Option<a>) forall (x: a) { g(f(x)) == Some(x) }\n";
  let c = checked_cx(src.concat(b"law \"l\" = reads_back(shown, read)"));
  assert_eq(c.diags, []);
  assert_eq(
    c.laws.map(|l: LawInfo|
      l.binders.map(|b: LawBinder| match b.ty { TyNominal(n) -> n.name, _ -> b"" })),
    [[b"m.Sign"]],
  );
  // A record of the same fields is not the `new` one.
  assert_eq(check_codes(src.concat(b"law \"l\" = reads_back(shown, plain)")), [b"E0201"])
}

test "a handle must have a clause for every operation its body performs on an atom it handles" {
  assert_eq(
    check_codes(
      net_src(
        b"fn f() -> Bytes = handle { net.send[c](b\"x\"); net.recv[c](4) } with { net.recv[c](n) -> b\"\" }",
      ),
    ),
    [b"E0305"],
  );
  assert_eq(
    check_codes(
      net_src(
        b"fn f() -> Bytes = handle { net.send[c](b\"x\"); net.recv[c](4) } with { net.recv[c](n) -> b\"\", net.send[c](p) -> () }",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      net_src(
        b"fn f() -> Int / {net.write[c]} = handle { net.send[c](b\"x\"); net.peek[c]() } with { net.peek[c]() -> 1 }",
      ),
    ),
    [],
  )
}

test "the operations a called definition performs count, through any number of calls" {
  let calls = b"fn push_all(p: Bytes) -> Unit / {net.send[c]} = net.send[c](p)\nfn relay(p: Bytes) -> Unit / {net.send[c]} = push_all(p)\n";
  assert_eq(
    check_codes(
      net_src(
        calls.concat(b"fn f() -> Unit = handle { relay(b\"x\") } with { net.recv[c](n) -> b\"\" }"),
      ),
    ),
    [b"E0305"],
  );
  assert_eq(
    check_codes(
      net_src(
        calls.concat(b"fn f() -> Unit = handle { relay(b\"x\") } with { net.send[c](p) -> () }"),
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      net_src(
        calls.concat(
          b"fn g() -> Unit / {net.send[c]} = relay(b\"y\")\nfn f() -> Unit = handle { g() } with { net.close[c]() -> () }",
        ),
      ),
    ),
    [b"E0305"],
  );
  let diags = check_diags(
    net_src(
      calls.concat(b"fn f() -> Unit = handle { relay(b\"x\") } with { net.recv[c](n) -> b\"\" }"),
    ),
  );
  assert_eq(diags.map(|diag: Diag| diag.labels.map(|label: Label| label.text)), [
    [
      b"reaches `net.send[c]` through `relay`",
      b"handles `m.net.write[c]` here, so the operation would run past it",
    ],
  ])
}

test "an operation a definition handles itself does not reach its callers' handles" {
  let src = net_src(
    b"fn quiet() -> Unit / {net.close[c]} = { handle { net.send[c](b\"x\") } with { net.send[c](p) -> () }; net.close[c]() }\nfn f() -> Unit = handle { quiet() } with { net.close[c]() -> () }",
  );
  assert_eq(check_codes(src), [])
}

test "a handle over a function value or a lambda is judged by its type" {
  let all = b"net.send[c](p) -> (), net.recv[c](n) -> b\"\", net.close[c]() -> ()";
  assert_eq(
    check_codes(
      net_src(
        b"fn run(f: () -> Unit / {net.write[c]}) -> Unit = handle { f() } with { net.recv[c](n) -> b\"\" }",
      ),
    ),
    [b"E0305"],
  );
  assert_eq(
    check_codes(
      net_src(
        Bytes::concat_all([
          b"fn run(f: () -> Unit / {net.write[c]}) -> Unit = handle { f() } with { ",
          all,
          b" }",
        ]),
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      net_src(
        b"fn run(f: () -> Unit / {net.send[c]}) -> Unit = handle { f() } with { net.send[c](p) -> () }",
      ),
    ),
    [],
  );
  let folded = b"fn f() -> Int = handle { [1, 2].fold(0, |acc: Int, x: Int| { net.send[c](b\"x\"); acc + x }) } with { ";
  assert_eq(check_codes(net_src(folded.concat(b"net.recv[c](n) -> b\"\" }"))), [b"E0305"]);
  assert_eq(check_codes(net_src(folded.concat(b"net.send[c](p) -> () }"))), []);
  let diags = check_diags(net_src(folded.concat(b"net.recv[c](n) -> b\"\" }")));
  assert_eq(diags.map(|diag: Diag| diag.message), [
    b"this `handle` has no clause for `net.send[c]`, which its body performs",
  ]);
  assert_eq(diags.map(|diag: Diag| diag.labels.get(0).text), [b"performs `net.send[c]`"])
}

test "a callee written with a mode atom may perform any of its operations, so every one needs a clause" {
  let calls = b"fn relay(p: Bytes) -> Unit / {net.write[c]} = net.send[c](p)\n";
  let diags = check_diags(
    net_src(
      calls.concat(b"fn f() -> Unit = handle { relay(b\"x\") } with { net.send[c](p) -> () }"),
    ),
  );
  assert_eq(diags.map(|diag: Diag| diag.code), [b"E0305"]);
  assert_eq(diags.map(|diag: Diag| diag.message), [
    b"this `handle` has no clause for `net.write[c]`, which its body performs",
  ]);
  assert_eq(diags.map(|diag: Diag| diag.labels.get(0).text), [
    b"reaches `net.write[c]` through `relay`",
  ]);
  assert_eq(diags.map(|diag: Diag| diag.notes_text), [
    [
      b"`relay` may perform any `write` operation of `net`; a clause for each of them discharges `net.write[c]`",
    ],
  ]);
  assert_eq(fixes_of(diags).map(|fix: Fix| fix.title), [
    b"add a clause for `net.recv[c]`",
    b"add a clause for `net.close[c]`",
  ]);
  assert_eq(
    check_codes(
      net_src(
        calls.concat(
          b"fn f() -> Unit = handle { relay(b\"x\") } with { net.send[c](p) -> (), net.recv[c](n) -> b\"\", net.close[c]() -> () }",
        ),
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      net_src(
        calls.concat(
          b"fn f() -> Unit / {net.write[c]} = handle { relay(b\"x\") } with { net.send[c](p) -> () }",
        ),
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      net_src(
        calls.concat(
          b"fn f() -> Int / {net.write[c]} = handle { relay(b\"x\"); 1 } with { net.peek[c]() -> 1 }",
        ),
      ),
    ),
    [],
  )
}

test "an operation the written row keeps is forwarded rather than missing" {
  assert_eq(
    check_codes(
      net_src(
        b"fn f() -> Unit / {net.write[c]} = handle { net.send[c](b\"x\"); net.close[c]() } with { net.send[c](p) -> () }",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      net_src(
        b"fn f() -> Unit / {net.read[c]} = handle { net.send[c](b\"x\"); net.close[c]() } with { net.send[c](p) -> () }",
      ),
    ),
    [b"E0305"],
  )
}

test "the missing clause is named as the module would write it" {
  let src = net_src(
    b"fn f() -> Unit = handle { net.send[c](b\"x\"); net.close[c]() } with { net.recv[c](n) -> b\"\" }",
  );
  let diags = check_diags(src);
  assert_eq(diags.map(|diag: Diag| diag.message), [
    b"this `handle` has no clause for `net.close[c]` and `net.send[c]`, which its body performs",
  ]);
  let fixes = fixes_of(diags);
  assert_eq(fixes.map(|fix: Fix| fix.title), [
    b"add a clause for `net.close[c]`",
    b"add a clause for `net.send[c]`",
  ]);
  assert_eq(fixes.map(|fix: Fix| fix.edits.map(|edit: Edit| edit.text)), [
    [b", net.close[c]() -> panic(\"net.close[c] is not handled here\")"],
    [b", net.send[c](a0) -> panic(\"net.send[c] is not handled here\")"],
  ]);
  assert_eq(
    fixes.map(|fix: Fix| fix.edits.map(|edit: Edit| src.slice(edit.start - 1, edit.end))),
    [[b"\""], [b"\""]],
  )
}

test "a written row may name an operation, which permits that operation alone" {
  assert_eq(check_codes(net_src(b"fn f() -> Unit / {net.send[c]} = net.send[c](b\"x\")")), []);
  assert_eq(check_codes(net_src(b"fn f() -> Bytes / {net.send[c]} = net.recv[c](4)")), [b"E0302"]);
  assert_eq(
    check_codes(
      net_src(b"fn f() -> Bytes / {net.write[c]} = { net.send[c](b\"x\"); net.recv[c](4) }"),
    ),
    [],
  );
  assert_eq(check_codes(net_src(b"fn f() -> Int / {net.peek[c]} = net.peek[c]()")), []);
  assert_eq(check_codes(net_src(b"fn f() -> Unit / {net.emit[c]} = ()")), [b"E0104"])
}

test "an operation the written row does not name is refused by name, with the atom to add" {
  let src = net_src(b"fn f() -> Bytes / {net.send[c]} = net.recv[c](4)");
  let diags = check_diags(src);
  assert_eq(diags.map(|diag: Diag| diag.message), [
    b"effect not permitted by the signature of `f`: `m.net.recv[c]`",
  ]);
  assert_eq(diags.map(|diag: Diag| diag.labels.map(|label: Label| label.text)), [
    [b"performs `m.net.recv[c]`", b"declared row is {m.net.send[c]}"],
  ]);
  let fixes = fixes_of(diags);
  assert_eq(fixes.map(|fix: Fix| fix.title), [b"add `net.recv[c]` to the row"]);
  assert_eq(fixes.map(|fix: Fix| fix.edits.map(|edit: Edit| edit.text)), [[b", net.recv[c]"]]);
  assert_eq(
    fixes.map(|fix: Fix| fix.edits.map(|edit: Edit| src.slice(edit.start, edit.end + 1))),
    [[b"}"]],
  )
}

test "a function that writes no `/` performs nothing, and one whose body does is given its row" {
  let src = net_src(b"fn f() -> Bytes = net.recv[c](4)");
  let diags = check_diags(src);
  assert_eq(diags.map(|diag: Diag| diag.message), [
    b"`f` writes no `/`, so its row is empty, and its body performs effects",
  ]);
  let fixes = fixes_of(diags);
  assert_eq(fixes.map(|fix: Fix| fix.title), [b"write the row `/ {net.recv[c]}`"]);
  let written = net_src(b"fn f() -> Bytes / {net.recv[c]} = net.recv[c](4)");
  assert_eq(fixes.map(|fix: Fix| fixed_by(src, fix)), [written]);
  assert_eq(check_codes(written), []);
  let forwards = b"fn apply<| e>(f: () -> Int / e) -> Int = f()";
  let forwarded = check_diags(forwards);
  assert_eq(forwarded.map(|diag: Diag| diag.message), [
    b"`apply` writes no `/`, so its row is empty, and its body forwards a row",
  ]);
  assert_eq(fixes_of(forwarded).map(|fix: Fix| fixed_by(forwards, fix)), [
    b"fn apply<| e>(f: () -> Int / e) -> Int / e = f()",
  ])
}

test "the row a fix writes names a set wherever the row holds the whole of it" {
  let src = net_src(
    b"effect set Io = {net.send[c], net.peek[c]}\nfn a() -> Int / {Io} = 1\nfn b() -> Int = a()\nfn c() -> Int = net.peek[c]()",
  );
  assert_eq(fixes_of(check_diags(src)).map(|fix: Fix| fix.title), [
    b"write the row `/ {Io}`",
    b"write the row `/ {net.peek[c]}`",
  ]);
  // An operation a named set's mode atom covers is not written again.
  let modes = net_src(
    b"effect set Wire = {net.write[c], net.read[c]}\nfn a() -> Int / {Wire} = 1\nfn b() -> Int = { net.send[c](b\"x\"); a() }",
  );
  assert_eq(fixes_of(check_diags(modes)).map(|fix: Fix| fix.title), [b"write the row `/ {Wire}`"]);
  let covered = net_src(
    b"fn a() -> Int / {net.write[c]} = 1\nfn b() -> Int = { net.send[c](b\"x\"); a() }",
  );
  assert_eq(fixes_of(check_diags(covered)).map(|fix: Fix| fix.title), [
    b"write the row `/ {net.write[c]}`",
  ])
}

test "a row variable nothing constrains closes on an unwritten row, and only a parameter is forwarded" {
  assert_eq(check_codes(b"fn two(x: Int) -> Int = one(x) + 1"), [b"E0101"]);
  assert_eq(check_codes(b"fn h() -> Int = { let f = |x: Int| x; f(1) }"), [])
}

test "a caller is checked against what an overrunning body performs, so one check names each row" {
  let src = net_src(
    b"fn leaf() -> Bytes = net.recv[c](4)\nfn mid() -> Bytes = leaf()\nfn top() -> Bytes / {net.recv[c]} = mid()",
  );
  let diags = check_diags(src);
  assert_eq(diags.map(|diag: Diag| diag.message), [
    b"`leaf` writes no `/`, so its row is empty, and its body performs effects",
    b"`mid` writes no `/`, so its row is empty, and its body performs effects",
  ]);
  // The later fix first, so the earlier one's offset still points where it did.
  let fixes = fixes_of(diags);
  let n = fixes.len();
  assert_eq(
    check_codes(range(0, n).fold(src, |s: Bytes, i: Int| fixed_by(s, fixes.get(n - 1 - i)))),
    [],
  )
}

test "a caller's mode atom covers a callee's operation atom, and not the reverse" {
  let narrow = b"fn f() -> Unit / {net.send[c]} = net.send[c](b\"x\")\n";
  let wide = b"fn f() -> Unit / {net.write[c]} = net.send[c](b\"x\")\n";
  assert_eq(check_codes(net_src(narrow.concat(b"fn g() -> Unit / {net.write[c]} = f()"))), []);
  assert_eq(check_codes(net_src(narrow.concat(b"fn g() -> Unit / {net.send[c]} = f()"))), []);
  assert_eq(
    check_codes(
      net_src(
        narrow.concat(
          b"fn g() -> Unit / {net.send[c]} = f()\nfn h() -> Unit / {net.write[c]} = g()",
        ),
      ),
    ),
    [],
  );
  let diags = check_diags(net_src(wide.concat(b"fn g() -> Unit / {net.send[c]} = f()")));
  assert_eq(diags.map(|diag: Diag| diag.code), [b"E0302"]);
  assert_eq(diags.map(|diag: Diag| diag.labels.map(|label: Label| label.text)), [
    [
      b"reaches `m.net.write[c]` through `f`, which may perform any of its operations; this row names only `m.net.send[c]`",
      b"declared row is {m.net.send[c]}",
    ],
  ]);
  assert_eq(fixes_of(diags).map(|fix: Fix| fix.title), [b"add `net.write[c]` to the row"])
}

test "a clause for an operation discharges that operation's atom" {
  let narrow = b"fn f() -> Unit / {net.send[c]} = net.send[c](b\"x\")\n";
  assert_eq(
    check_codes(
      net_src(narrow.concat(b"fn g() -> Unit / {} = handle { f() } with { net.send[c](p) -> () }")),
    ),
    [],
  );
  assert_eq(
    check_codes(
      net_src(
        narrow.concat(b"fn g() -> Unit / {} = handle { f() } with { net.recv[c](n) -> b\"\" }"),
      ),
    ),
    [b"E0305"],
  );
  assert_eq(
    check_codes(
      net_src(
        b"fn f() -> Unit / {net.send[c]} = handle { net.send[c](b\"x\"); net.close[c]() } with { net.close[c]() -> () }",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      net_src(
        b"fn f() -> Unit / {net.close[c]} = handle { net.send[c](b\"x\"); net.close[c]() } with { net.close[c]() -> () }",
      ),
    ),
    [b"E0305"],
  )
}

test "the prelude's effect names are the effects it declares" {
  assert_eq(
    prelude_effect_names(),
    prelude_effects().map(|effect_info: EffectInfo| effect_info.name),
  )
}

test "a clause for `abort.raise` answers for the whole `handle`, and binds no `resume`" {
  let raises = b"fn digit(b: Int) -> Int / {abort.raise} = if b >= 48 && b <= 57 { b - 48 } else { abort.raise(\"not a digit\") }\n";
  assert_eq(
    check_codes(
      raises.concat(
        b"fn digit_or(b: Int) -> Result<Int, String> / {} = handle { digit(b) } with { abort.raise(m) -> Err(m), return v -> Ok(v) }",
      ),
    ),
    [],
  );
  assert_eq(check_codes(b"fn f() -> Int / {} = handle { 1 } with { abort.raise(m) -> m }"), [
    b"E0201",
  ]);
  assert_eq(
    check_codes(
      b"fn f() -> Int / {} = handle { abort.raise(\"x\") } with { abort.raise(m) resume k -> 0 }",
    ),
    [b"E0201"],
  )
}

fn raising(rest: Bytes) -> List<Bytes> / {abort.raise} =
  check_codes(
    b"effect p { raise bad(n: Int) raise eof() read get() -> Int }\nfn digit(b: Int) -> Int / {p.bad} = if b < 48 { p.bad(b) } else { b - 48 }\nfn end() -> Int / {p.eof} = p.eof()\n".concat(
      rest,
    ),
  )

test "a `raise` operation is in the row, and its clause answers for the whole `handle`" {
  assert_eq(raising(b"fn f(b: Int) -> Int / {} = digit(b)"), [b"E0302"]);
  assert_eq(raising(b"fn f(b: Int) -> Int / {p.read} = digit(b)"), [b"E0302"]);
  assert_eq(
    raising(
      b"fn f(b: Int) -> Result<Int, Int> / {} = handle { digit(b) } with { p.bad(n) -> Err(n), return v -> Ok(v) }",
    ),
    [],
  );
  assert_eq(
    raising(b"fn f(b: Int) -> Int / {} = handle { digit(b) } with { p.bad(n) -> \"x\" }"),
    [b"E0201"],
  );
  assert_eq(
    raising(b"fn f(b: Int) -> Int / {} = handle { digit(b) } with { p.bad(n) resume k -> 0 }"),
    [b"E0201"],
  );
  assert_eq(raising(b"fn f() -> String / {p.eof} = p.eof()"), [])
}

test "a clause for one raise leaves the effect's other operations to the row" {
  assert_eq(
    raising(b"fn f(b: Int) -> Int / {p.eof} = handle { digit(b) + end() } with { p.bad(n) -> n }"),
    [],
  );
  assert_eq(
    raising(b"fn f(b: Int) -> Int / {p.bad} = handle { digit(b) + p.get() } with { p.get() -> 1 }"),
    [],
  );
  assert_eq(
    raising(b"fn f(b: Int) -> Int / {} = handle { digit(b) + end() } with { p.bad(n) -> n }"),
    [b"E0302"],
  )
}

test "a `try` answers the one raise its body's row names, as an `Err` of what it carried" {
  assert_eq(raising(b"fn f(b: Int) -> Result<Int, Int> / {} = try { digit(b) }"), []);
  assert_eq(raising(b"fn f() -> Result<Int, Unit> / {} = try { end() }"), []);
  assert_eq(raising(b"fn f(b: Int) -> Result<Int, String> / {} = try { digit(b) }"), [b"E0201"]);
  assert_eq(raising(b"fn f() -> Result<Int, Int> / {} = try { 1 }"), [b"E0311"]);
  assert_eq(
    raising(b"fn f(xs: List<Int>) -> Result<Int, String> / {abort.raise} = try { 1 / xs.len() }"),
    [b"E0311"],
  );
  assert_eq(
    raising(b"fn f(xs: List<Int>) -> Result<Int, String> / {} = try[abort.raise] { 1 / xs.len() }"),
    [],
  );
  assert_eq(raising(b"fn f(b: Int) -> Result<Int, Int> / {abort.raise} = try { digit(b) / b }"), [])
}

fn tallied(rest: Bytes) -> List<Bytes> / {abort.raise} =
  check_codes(
    b"effect tally { write add(n: Int) -> Unit read total() -> Int }\nfn run(xs: List<Int>) -> Int / {tally.add, tally.total} = { xs.fold((), |u: Unit, x: Int| tally.add(x)); tally.total() }\n".concat(
      rest,
    ),
  )

test "a handler's variables are typed by their first values, and a clause assigns them in its branches" {
  assert_eq(
    tallied(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum = 0, var big: Bool = false, tally.add(n) -> { sum = sum + n; if n > 9 { big = true } }, tally.total() -> if big { 0 } else { sum } }",
    ),
    [],
  );
  assert_eq(
    tallied(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum = 0, tally.add(n) -> { sum = \"no\" }, tally.total() -> sum }",
    ),
    [b"E0201"],
  );
  assert_eq(
    tallied(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum: Int = \"no\", tally.add(n) -> (), tally.total() -> sum }",
    ),
    [b"E0201"],
  );
  // What making a variable performs is the `handle`'s, which the handler's own clauses do not answer.
  assert_eq(
    tallied(
      b"fn f(xs: List<Int>) -> Int / {} = handle { run(xs) } with { var sum = tally.total(), tally.add(n) -> (), tally.total() -> sum }",
    ),
    [b"E0302"],
  );
  // Each first value sees the variables above it, and none of them twice.
  assert_eq(
    tallied(
      b"fn f(n: Bool) -> Int = handle { run([]) } with { var n = 10, var m = n + 1, tally.add(k) -> (), tally.total() -> m }",
    ),
    [],
  );
  assert_eq(
    tallied(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var n = 0, var n = 1, tally.add(k) -> (), tally.total() -> n }",
    ),
    [b"E0105"],
  )
}

test "only a variable of the handler whose clause it is in is assigned" {
  // A body sees none of its handler's variables.
  assert(
    tallied(
      b"fn f(xs: List<Int>) -> Int = handle { sum = 1; run(xs) } with { var sum = 0, tally.add(n) -> (), tally.total() -> sum }",
    ).contains(
      b"E0314",
    ),
  );
  // A parameter or a `let` of the variable's name hides it.
  assert_eq(
    tallied(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var n = 0, tally.add(n) -> { n = 1 }, tally.total() -> n }",
    ),
    [b"E0314"],
  );
  assert_eq(
    tallied(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum = 0, tally.add(n) -> { let sum = 2; sum = n }, tally.total() -> sum }",
    ),
    [b"E0314"],
  );
  // An inner handler's clause assigns its own variables, not those of a handler around it.
  assert_eq(
    tallied(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum = 0, tally.add(n) -> { handle { run([n]) } with { var m = 0, tally.add(k) -> { sum = k }, tally.total() -> m }; () }, tally.total() -> sum }",
    ),
    [b"E0314"],
  );
  assert_eq(tallied(b"fn f(n: Int) -> Int = { n = 2; n }"), [b"E0314"])
}

test "a clause does not assign its handler's variables where what runs may run after it returns" {
  assert_eq(
    tallied(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum = 0, tally.add(n) -> { let g = || { sum = n }; g() }, tally.total() -> sum }",
    ),
    [b"E0315"],
  );
  assert_eq(
    tallied(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum = 0, tally.add(n) -> { handle { sum = n; run([n]) } with { tally.add(k) -> (), tally.total() -> 0 }; () }, tally.total() -> sum }",
    ),
    [b"E0315"],
  );
  assert_eq(
    tallied(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum = 0, tally.add(n) -> (), tally.total() -> sum, return x -> { sum = x; sum } }",
    ),
    [b"E0315"],
  );
  // A lambda reads them.
  assert_eq(
    tallied(
      b"fn f(xs: List<Int>) -> Int = handle { run(xs) } with { var sum = 0, tally.add(n) -> { let g = || sum + n; sum = g() }, tally.total() -> sum }",
    ),
    [],
  )
}

test "a `try` over several raises names the one it answers, and the others stay in the row" {
  assert_eq(raising(b"fn f(b: Int) -> Result<Int, Int> / {} = try { digit(b) + end() }"), [
    b"E0312",
  ]);
  assert_eq(
    raising(b"fn f(b: Int) -> Result<Int, Int> / {p.eof} = try[p.bad] { digit(b) + end() }"),
    [],
  );
  assert_eq(raising(b"fn f(b: Int) -> Result<Int, Int> / {} = try[p.bad] { digit(b) + end() }"), [
    b"E0302",
  ]);
  assert_eq(raising(b"fn f() -> Result<Int, Int> / {p.get} = try[p.get] { p.get() }"), [b"E0313"]);
  assert_eq(raising(b"fn f() -> Result<Int, Int> / {} = try[p.nope] { 1 }"), [b"E0104"])
}

test "the lowering reads which raise a `try` answers, by its effect's program-wide name" {
  let out = checked_cx(
    b"effect p { raise bad(n: Int, why: String) }\nfn f(n: Int) -> Result<Int, (Int, String)> / {} = try { p.bad(n, \"no\") }",
  );
  assert_eq(out.try_sites.map(|s: TrySite| (s.effect, s.op, s.arity, s.owner)), [
    (b"m.p", b"bad", 2, b"m.f"),
  ])
}

test "a raise is in the row, and a clause for it discharges it" {
  assert_eq(check_codes(b"fn f() -> Int / {} = abort.raise(\"x\")"), [b"E0302"]);
  assert_eq(
    check_codes(b"fn f() -> Int / {} = handle { abort.raise(\"x\") } with { abort.raise(m) -> 0 }"),
    [],
  )
}

test "a spec may raise, and a function type that only raises can be generated" {
  assert_eq(
    check_codes(
      b"fn safe(n: Int) -> Int / {abort.raise} = if n < 0 { abort.raise(\"negative\") } else { n }\nfn f(n: Int) -> Int requires safe(n) >= 0 = n\nlaw \"applies\" forall (g: (Int) -> Int / {abort.raise}) { g(1) == g(1) }",
    ),
    [],
  )
}

test "a partial builtin, a division that may meet zero and a refutable let raise" {
  assert_eq(check_codes(b"fn f() -> Int / {} = panic(\"no\")"), [b"E0302"]);
  assert_eq(check_codes(b"fn f(b: Bytes) -> Int / {} = b.at(0)"), [b"E0302"]);
  assert_eq(check_codes(b"fn f(a: Int, b: Int) -> Int / {} = a / b"), [b"E0302"]);
  assert_eq(check_codes(b"fn f(a: Int) -> Int / {} = a % 0"), [b"E0302"]);
  assert_eq(check_codes(b"fn f(a: U8, b: U8) -> U8 / {} = a % b"), [b"E0302"]);
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Int / {} = { let [x, ..] = xs; x }"), [b"E0302"]);
  assert_eq(check_codes(b"fn f(n: Int) -> U8 / {} = U8::of_int(n)"), [b"E0302"])
}

test "a narrowing of a literal its type holds does not raise, and one of any other value does" {
  assert_eq(check_codes(b"fn f() -> U8 / {} = U8::of_int(200)"), []);
  assert_eq(check_codes(b"fn f() -> I8 / {} = I8::of_int(-128)"), []);
  assert_eq(check_codes(b"fn f() -> U8 / {} = U8::of_int(300)"), [b"E0302"]);
  assert_eq(check_codes(b"fn f() -> U16 / {} = U16::of_int(-1)"), [b"E0302"]);
  assert_eq(check_codes(b"fn f<a>(x: a) -> a / {} where numeric(a) = x + numeric_of_int(1)"), []);
  assert_eq(check_codes(b"fn f<a>(x: a) -> a / {} where numeric(a) = x + numeric_of_int(128)"), [
    b"E0302",
  ])
}

/// Whether each of `bodies`, a function over `b: Bytes`, `s: String`, `xs: List<Int>`,
/// `a: Array<Int>` and `i`, `j`, `n: Int`, checks with a row that names nothing.
fn total(bodies: List<Bytes>) -> List<Bool> / {abort.raise} =
  bodies.map(|body: Bytes|
    check_codes(
        b"fn f(b: Bytes, s: String, xs: List<Int>, a: Array<Int>, i: Int, j: Int, n: Int) -> Int / {} = ".concat(
          body,
        ),
      )
      == [])

test "an indexed read on the far side of both of its bounds does not raise" {
  assert_eq(
    total([
      b"if i < 0 || i >= b.len() { 0 } else { b.at(i) }",
      b"if i >= 0 && i < b.len() { b.at(i) } else { 0 }",
      b"if 0 <= i && i + 3 < b.len() { b.at(i) + b.at(i + 3) } else { 0 }",
      b"if i < 0 || i > b.len() - 4 { 0 } else { Int::of_u32(b.u32_le(i)) }",
      b"if 0 <= i && i < a.len() { a.get(i) } else { 0 }",
      b"if 0 <= i && i < a.len() { a.set(i, 1).len() } else { 0 }",
      b"if 0 <= i && i < xs.len() { xs.set(i, 1).len() } else { 0 }",
      b"{ let size = b.len(); if i >= 0 && i < size { b.at(i) } else { 0 } }",
      b"match i { k if k >= 0 && k < b.len() -> b.at(k), _ -> 0 }",
      b"if (0 <= i && i < b.len()) && b.at(i) == 0 { 1 } else { 0 }",
      b"if i < 0 || i >= b.len() || b.at(i) == 0 { 1 } else { 0 }",
    ]),
    [true, true, true, true, true, true, true, true, true, true, true],
  );
  assert_eq(
    total([
      b"b.at(i)",
      b"if i < b.len() { b.at(i) } else { 0 }",
      b"if i >= 0 { b.at(i) } else { 0 }",
      b"if i >= 0 && i <= b.len() { b.at(i) } else { 0 }",
      b"if i >= 0 && i < b.len() { b.at(i + 1) } else { 0 }",
      b"if i >= 0 && i < b.len() { 0 } else { b.at(i) }",
      b"if i >= 0 && i < s.len() { b.at(i) } else { 0 }",
      b"if i >= 0 || i < b.len() { b.at(i) } else { 0 }",
      b"if 0 <= i && i < a.len() { a.get(j) } else { 0 }",
      b"if 0 <= i && i < xs.len() { xs.set(i + n, 1).len() } else { 0 }",
      b"{ let ok = if i >= 0 && i < b.len() { 1 } else { 0 }; b.at(i) + ok }",
    ]),
    [false, false, false, false, false, false, false, false, false, false, false],
  )
}

test "a slice whose ends a condition holds in order and inside the value does not raise" {
  assert_eq(
    total([
      b"if i < 0 || n < 0 || i > b.len() || n > b.len() - i { 0 } else { b.slice(i, i + n).len() }",
      b"if 0 <= i && i <= j && j <= s.len() { s.slice(i, j).len() } else { 0 }",
      b"{ let size = s.len(); if size == 0 { 0 } else { s.slice(size - 1, size).len() } }",
      b"if n < 0 || n > 15 { 0 } else { \"0123456789abcdef\".slice(n, n + 1).len() }",
      b"{ let digits = b\"0123456789\"; if 0 <= n && n < 10 { digits.slice(n, n + 1).len() } else { 0 } }",
      b"if 0 <= i && i <= b.len() { b.slice(b.scan(i, b\" \", b.len()), b.len()).len() } else { 0 }",
      b"s.split(\",\").len() + b.split(b\"\\r\\n\").len()",
    ]),
    [true, true, true, true, true, true, true],
  );
  assert_eq(
    total([
      b"s.slice(i, j).len()",
      b"if 0 <= i && j <= s.len() { s.slice(i, j).len() } else { 0 }",
      b"if n < 0 || n > 16 { 0 } else { \"0123456789abcdef\".slice(n, n + 1).len() }",
      b"b.slice(b.scan(i, b\" \", b.len()), b.len()).len()",
      b"s.split(s).len()",
      b"b.split(b\"\").len()",
    ]),
    [false, false, false, false, false, false],
  )
}

test "a lambda called with each element of a range reads within the range's bounds" {
  assert_eq(
    total([
      b"range(0, b.len()).fold(0, |acc: Int, k: Int| acc + b.at(k))",
      b"range(0, b.len()).map(|k: Int| b.at(k)).len()",
      b"range(0, a.len()).filter(|k: Int| a.get(k) > 0).len()",
      b"range(0, b.len() / 4).fold(0, |acc: Int, k: Int| acc + b.at(k * 4 + 3))",
      b"range(0, min(b.len(), n)).fold(0, |acc: Int, k: Int| acc + b.at(k))",
      b"range(1, b.len()).fold(0, |acc: Int, k: Int| acc + b.at(k - 1))",
    ]),
    [true, true, true, true, true, true],
  );
  assert_eq(
    total([
      b"range(0, n).fold(0, |acc: Int, k: Int| acc + b.at(k))",
      b"range(0, b.len()).fold(0, |acc: Int, k: Int| acc + b.at(acc))",
      b"range(0, b.len() + 1).fold(0, |acc: Int, k: Int| acc + b.at(k))",
      b"range(0 - 1, b.len()).fold(0, |acc: Int, k: Int| acc + b.at(k))",
      b"range(0, b.len()).fold(0, |acc: Int, k: Int| [k + 1].fold(acc, |x: Int, k: Int| x + b.at(k)))",
      b"xs.fold(0, |acc: Int, k: Int| acc + b.at(k))",
    ]),
    [false, false, false, false, false, false],
  )
}

test "a narrowing of a value its type is shown to hold does not raise" {
  assert_eq(
    total([
      b"byte_of_int(n & 0xFF).len()",
      b"byte_of_int(n >>> 24 & 0xFF).len()",
      b"byte_of_int(n >>> 56).len()",
      b"Int::of_u16(U16::of_int(n & 0xFFFF)) + Int::of_u32(U32::of_int(n & 0xFFFF_FFFF))",
      b"if 0 <= n && n < 256 { Int::of_u8(U8::of_int(n)) } else { 0 }",
      b"if i < 0 || i >= b.len() { 0 } else { byte_of_int(b.at(i)).len() }",
      b"if 0 <= i && i < b.len() && 0 <= j && j < b.len() { byte_of_int(b.at(i) ^ b.at(j)).len() } else { 0 }",
      b"if n < 0 { 0 } else { byte_of_int(n % 256).len() + byte_of_int(128 + n % 64).len() }",
      b"if 0 <= n && n < 2048 { byte_of_int(192 + n / 64).len() } else { 0 }",
      b"Int::of_i8(I8::of_int(-128)) + byte_of_int(Int::of_u8(U8::of_int(7))).len()",
    ]),
    [true, true, true, true, true, true, true, true, true, true],
  );
  assert_eq(
    total([
      b"byte_of_int(n).len()",
      b"byte_of_int(n & 0x1FF).len()",
      b"byte_of_int(n >>> 55).len()",
      b"byte_of_int(n >> 56).len()",
      b"byte_of_int(n % 256).len()",
      b"if 0 <= n && n <= 256 { Int::of_u8(U8::of_int(n)) } else { 0 }",
      b"if 0 <= i && i < b.len() { byte_of_int(b.at(i) ^ n).len() } else { 0 }",
      b"if 0 <= n && n < 2048 { byte_of_int(225 + n / 64).len() } else { 0 }",
      b"Int::of_u64(U64::of_int(n))",
    ]),
    [false, false, false, false, false, false, false, false, false],
  )
}

test "a division by a divisor a condition holds off zero does not raise" {
  assert_eq(
    total([
      b"if n == 0 { 0 } else { i / n }",
      b"if n != 0 { i % n } else { 0 }",
      b"if n > 0 { i / n + i % n } else { 0 }",
      b"match n { 0 -> 0, _ -> i / n }",
      b"if xs.len() == 0 { 0 } else { i / xs.len() }",
      b"match xs { [] -> 0, _ -> i % xs.len() }",
      b"i / (b.len() + 1)",
      b"if 0 <= i && xs.len() > 0 { xs.set(i % xs.len(), 0).len() } else { 0 }",
      b"if i < 0 || xs.len() == 0 { 0 } else { xs.set(i % xs.len(), 0).len() }",
    ]),
    [true, true, true, true, true, true, true, true, true],
  );
  assert_eq(
    total([
      b"i / n",
      b"if i != 0 { i / n } else { 0 }",
      b"if n >= 0 { i / n } else { 0 }",
      b"match n { 1 -> 0, _ -> i / n }",
      b"i / b.len()",
      b"if xs.len() > 0 { xs.set(i % xs.len(), 0).len() } else { 0 }",
    ]),
    [false, false, false, false, false, false],
  )
}

test "a pattern that matched says what a condition would" {
  assert_eq(
    total([
      b"match xs.at(i) { Some(_) -> xs.set(i, 0).len(), None -> 0 }",
      b"match a.at(i) { Some(_) -> a.get(i), None -> 0 }",
      b"match xs { [_, _, ..] -> xs.set(1, 0).len(), _ -> 0 }",
      b"match xs { [] -> 0, _ -> xs.set(0, 0).len() }",
      b"match i >= 0 && i < b.len() { true -> b.at(i), false -> 0 }",
      b"{ let Some(_) = xs.at(i) else { 0 }; xs.set(i, 0).len() }",
    ]),
    [true, true, true, true, true, true],
  );
  assert_eq(
    total([
      b"match xs.at(i) { Some(_) -> xs.set(i + 1, 0).len(), None -> 0 }",
      b"match xs.at(i) { Some(_) -> 0, None -> xs.set(i, 0).len() }",
      b"match xs { [_, ..] -> xs.set(1, 0).len(), _ -> 0 }",
      b"match xs { [_] -> 0, _ -> xs.set(0, 0).len() }",
      b"match i >= 0 && i < b.len() { true -> 0, false -> b.at(i) }",
      b"{ let _ = { let Some(_) = xs.at(i) else { 0 }; 1 }; xs.set(i, 0).len() }",
    ]),
    [false, false, false, false, false, false],
  )
}

test "a range pattern holds an integer between its ends, and alternatives between the least and greatest" {
  assert_eq(
    total([
      b"match n { 0..=9 -> byte_of_int(n + 48).len(), _ -> 0 }",
      b"match n { b'0'..=b'9' -> \"0123456789\".slice(n - 48, n - 47).len(), _ -> 0 }",
      b"match n { b'a'..=b'f' | b'A'..=b'F' -> byte_of_int(n).len(), _ -> 0 }",
      b"match n { b'-' | b'0'..=b'9' -> 255 / n, _ -> 0 }",
      b"if i < 0 || i >= b.len() { 0 } else { match b.at(i) { b'a'..=b'z' -> byte_of_int(b.at(i) - 32).len(), _ -> 0 } }",
      b"if n < 0 { 0 } else { match n { 0..=9 -> 0, _ -> 100 / (n - 9) } }",
      b"if n > 9 { 0 } else { match n { 0..=9 -> 0, _ -> 100 / n } }",
      b"match n { 0 | 1 -> 0, _ -> 10 / n + 10 / (n - 1) }",
    ]),
    [true, true, true, true, true, true, true, true],
  );
  assert_eq(
    total([
      b"match n { 0..=9 -> byte_of_int(n + 247).len(), _ -> 0 }",
      b"match n { b'0'..=b'9' -> 0, _ -> byte_of_int(n).len() }",
      b"match n { b'a'..=b'f' | b'A'..=b'F' -> byte_of_int(n + 154).len(), _ -> 0 }",
      b"match n { 0..=9 -> 0, _ -> 100 / (n - 9) }",
      b"match n { 0 | 2 -> 0, _ -> 10 / (n - 1) }",
      b"match i { 0..=9 -> byte_of_int(n).len(), _ -> 0 }",
    ]),
    [false, false, false, false, false, false],
  )
}

test "a name bound again is not the one a condition read" {
  assert_eq(
    total([
      b"if i >= 0 && i < b.len() { let i = i + 1; b.at(i) } else { 0 }",
      b"if i >= 0 && i < b.len() { [j].map(|i: Int| b.at(i)).len() } else { 0 }",
      b"if i >= 0 && i < b.len() { match j { i -> b.at(i) } } else { 0 }",
      b"if i >= 0 && i < b.len() { let b = b\"\"; b.at(i) } else { 0 }",
      b"if i >= 0 && i < b.len() { handle { 0 } with { return i -> b.at(i) } } else { 0 }",
      b"{ let k = i; let i = j; if k >= 0 && k < b.len() { b.at(i) } else { 0 } }",
    ]),
    [false, false, false, false, false, false],
  );
  assert_eq(
    total([
      b"{ let k = i; if k >= 0 && k < b.len() { b.at(i) } else { 0 } }",
      b"{ let c = b; if i >= 0 && i < c.len() { b.at(i) } else { 0 } }",
      b"if i >= 0 && i < b.len() { let i = i; b.at(i) } else { 0 }",
    ]),
    [true, true, true],
  )
}

test "a field read through records is one value wherever it is read" {
  let over = |body: Bytes|
    check_codes(
      b"type Cursor = { src: Bytes, at: Int }\nfn f(c: Cursor, d: Cursor) -> Int / {} = ".concat(
        body,
      ),
    );
  assert_eq(over(b"if c.at >= 0 && c.at < c.src.len() { c.src.at(c.at) } else { 0 }"), []);
  assert_eq(over(b"if c.at >= 0 && c.at < c.src.len() { d.src.at(c.at) } else { 0 }"), [b"E0302"]);
  assert_eq(over(b"if c.at >= 0 && c.at < c.src.len() { c.src.at(d.at) } else { 0 }"), [b"E0302"])
}

test "what a call that can raise ensures of its answer holds only past the call" {
  let unshown = |body: Bytes|
    match def_of(
        checked_cx(b"fn f(b: Bytes, i: Int, n: Int) -> Int / {abort.raise} = ".concat(body)),
        b"m.f",
      ) {
      Some(d) -> d.raises.map(|r: Raise| r.why),
      None -> [],
    };
  // A scan that answered started inside the bytes, which says nothing where it never ran.
  assert_eq(
    unshown(
      b"if n > 0 { let stop = b.scan(i, b\" \", 0); stop } else if i >= 0 { b.slice(i, b.len()).len() } else { 0 }",
    ),
    [
      Unshown({ callee: b"Bytes::scan", needs: b"0 <= from" }),
      Unshown({ callee: b"Bytes::slice", needs: b"start <= end" }),
    ],
  );
  assert_eq(
    unshown(
      b"if i < 0 { 0 } else { let stop = b.scan(i, b\" \", 0); b.slice(i, stop).len() + b.slice(i, b.len()).len() }",
    ),
    [Unshown({ callee: b"Bytes::scan", needs: b"from <= Bytes::len(hay)" })],
  )
}

test "a body's raises are filed with why each was kept, and a group that raises only by recursing has none" {
  let out = checked_cx(
    b"fn at(b: Bytes, i: Int) -> Int / {abort.raise} = if i < b.len() { b.at(i) } else { 0 }\nfn both(b: Bytes, n: Int) -> Int / {abort.raise} = at(b, n) + at(b, 0) + 7 / n + panic(\"no\")\nfn walk(b: Bytes, i: Int) -> Int / {abort.raise} = if i < 0 || i >= b.len() { 0 } else { b.at(i) + walk(b, i + 1) }\nfn each(b: Bytes, f: (Int) -> Int / {abort.raise}) -> Int / {abort.raise} = range(0, b.len()).fold(0, |acc: Int, k: Int| acc + f(b.at(k)))\n",
  );
  let raises = |name: Bytes|
    match def_of(out, name) { Some(d) -> d.raises.map(|r: Raise| r.why), None -> [] };
  assert_eq(raises(b"m.at"), [Unshown({ callee: b"Bytes::at", needs: b"0 <= i" })]);
  assert_eq(raises(b"m.both"), [Calls(b"m.at"), ZeroDivisor, Unguarded(b"panic")]);
  assert_eq(raises(b"m.walk"), []);
  assert_eq(raises(b"m.each"), [Handed]);
  let performed = |name: Bytes|
    match def_of(out, name) { Some(d) -> d.performed.len(), None -> 0 - 1 };
  assert_eq(performed(b"m.walk"), 0);
  assert_eq(performed(b"m.at"), 1);
  match def_of(out, b"m.at") {
    Some(d) -> assert_eq(d.raises.map(|r: Raise| r.span), [span_between(66, 73)]),
    None -> panic("`at` is defined"),
  }
}

test "a channel's capacity and a draw's bound raise, unless a literal or a condition holds them in range" {
  assert_eq(
    check_codes(b"fn f(n: Int) -> Int / {sim.read} = simulate { let _ = task.channel(n); 0 }"),
    [b"E0302"],
  );
  assert_eq(
    check_codes(b"fn f() -> Int / {sim.read} = simulate { let _ = task.channel(0); 0 }"),
    [],
  );
  assert_eq(check_codes(b"fn f(n: Int) -> Int / {sim.read} = simulate { random.below(n) }"), [
    b"E0302",
  ]);
  assert_eq(check_codes(b"fn f() -> Int / {sim.read} = simulate { random.below(0) }"), [b"E0302"]);
  assert_eq(check_codes(b"fn f() -> Int / {sim.read} = simulate { random.below(6) }"), []);
  assert_eq(
    check_codes(
      b"fn f(n: Int) -> Int / {sim.read} = simulate { if n > 0 { random.below(n) } else { 0 } }",
    ),
    [],
  );
  assert_eq(
    check_codes(
      b"fn f(n: Int) -> Int / {sim.read} = simulate { if n >= 0 { random.below(n) } else { 0 } }",
    ),
    [b"E0302"],
  )
}

test "what cannot fail does not raise, and overflow is the machine's limit" {
  assert_eq(
    check_codes(b"fn f(a: Int, b: U8) -> Int / {} = a / 2 + a % -3 + Int::of_u8(b % 7u8)"),
    [],
  );
  assert_eq(check_codes(b"fn f(a: Float, b: Float) -> Float / {} = a / b"), []);
  assert_eq(check_codes(b"fn f(a: Int, b: Int) -> Int / {} = a * b + a - b"), []);
  assert_eq(check_codes(b"fn f(a: Int, n: Int) -> Int / {} = a << n"), []);
  assert_eq(check_codes(b"fn f(p: { a: Int }) -> Int / {} = { let { a } = p; a }"), []);
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Option<Int> / {} = xs.at(0)"), [])
}

test "a raise the row admits, or a clause answers, is no refusal" {
  assert_eq(check_codes(b"fn f(b: Bytes) -> Int / {abort.raise} = b.at(0)"), []);
  assert_eq(
    check_codes(
      b"fn f(b: Bytes) -> Int / {} = handle { b.at(0) } with { abort.raise(m) -> 0 - 1 }",
    ),
    [],
  )
}

test "a raise through a builtin is reported at the call, naming the builtin" {
  let diags = check_diags(b"fn f(b: Bytes) -> Int / {} = b.at(0)");
  assert_eq(diags.map(|dg: Diag| dg.code), [b"E0302"]);
  assert(
    diags.get(0).labels.fold(false, |found: Bool, l: Label|
      found || l.text == b"reaches `abort.raise` through `Bytes::at`"),
  )
}

test "a callback that raises meets a parameter only where the parameter's row admits it" {
  let caller = b"\nfn g(b: Bytes) -> Int / {abort.raise} = run(|| b.at(0))";
  assert_eq(check_codes(b"fn run(f: () -> Int) -> Int = f()".concat(caller)), [b"E0302"]);
  assert_eq(check_codes(b"fn run<| e>(f: () -> Int / e) -> Int / e = f()".concat(caller)), [])
}

test "a binder named like a definition reads the binder, so it ties no definitions into a group" {
  assert_eq(
    check_codes(
      b"fn words(xs: List<String>) -> Int / {abort.raise} = match xs { [] -> 0, [w, ..rest] -> joined([w.slice(0, 1)]).len() + words(rest) }\nfn joined(words: List<String>) -> String = List::fold(words, \"\", |acc: String, w: String| acc ++ w)",
    ),
    [],
  )
}

test "a `const fn` takes nothing, binds nothing and writes no row" {
  assert_eq(check_codes(b"const fn table() -> List<Int> = [1, 2]"), []);
  assert_eq(check_codes(b"const fn table(n: Int) -> List<Int> = [n]"), [b"E0156"]);
  assert_eq(check_codes(b"const fn table<a>() -> List<a> = []"), [b"E0156"]);
  assert_eq(check_codes(b"const fn table() -> Int / {abort.raise} = 1"), [b"E0156"])
}

test "a `const fn` may raise, and its callers read no raise of it" {
  let halved = |head: Bytes|
    check_codes(
      Bytes::concat_all([
        head,
        b" half() -> Int = 10 / zero()\nfn zero() -> Int = 0\nfn twice() -> Int = half() + half()",
      ]),
    );
  assert_eq(halved(b"const fn"), []);
  // Written without `const`, the raise is its own to write, and its caller's.
  assert_eq(halved(b"fn"), [b"E0302", b"E0302"])
}

test "a `const fn` files no place it can raise" {
  let out = checked_cx(
    b"const fn third() -> Int = 10 / zero()\nfn zero() -> Int = 3\nfn plain() -> Int / {abort.raise} = 10 / zero()",
  );
  let raises = |name: Bytes| match def_of(out, name) { Some(d) -> d.raises.len(), None -> 0 - 1 };
  assert_eq(raises(b"m.third"), 0);
  assert_eq(raises(b"m.plain"), 1)
}

test "a `const fn` performs nothing but a raise, and ends" {
  assert_eq(
    check_codes(
      b"effect log { write emit(Bytes) -> Unit }\nconst fn noisy() -> Int = { log.emit(b\"x\"); 1 }",
    ),
    [b"E0156"],
  );
  assert_eq(
    check_codes(
      b"fn spin(n: Int) -> Int / {diverges} = spin(n + 1)\nconst fn never() -> Int = spin(0)",
    ),
    [b"E0156"],
  );
  assert_eq(check_codes(b"const fn never() -> Int = never()"), [b"E0156"])
}

test "a `const fn` answers a value a build can keep" {
  assert_eq(check_codes(b"const fn f() -> (Int) -> Int = |x: Int| x"), [b"E0156"]);
  assert_eq(
    check_codes(
      b"type Held = | Held((Int) -> Int)\nconst fn f() -> List<Held> = [Held(|x: Int| x)]",
    ),
    [b"E0156"],
  );
  assert_eq(check_codes(b"const fn f() -> Option<Secret<String>> = None"), [b"E0156"]);
  assert_eq(
    check_codes(
      b"type Row = { name: String, at: Int }\nconst fn rows() -> Array<Row> = Array::of_list([{ name: \"a\", at: 1 }])",
    ),
    [],
  )
}

test "a body that performs more than its signature permits is refused" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"effect log { write emit(Bytes) -> Unit }\nfn quiet() -> Unit / {} = log.emit(b\"x\")",
    },
  ]);
  assert_eq(dump, "K;1;X;D;1;!E0302:0:67:81:2:1;=0:67:81:1;=0:62:64:0;")
}

test "a function that performs is refused where a pure one is expected" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"effect log { write emit(Bytes) -> Unit }\nfn noisy(x: Int) -> Int / { log.write } = { log.emit(b\"x\"); x }\nfn apply(f: (Int) -> Int) -> Int = f(1)\nfn go() -> Int = apply(noisy)",
    },
  ]);
  assert_eq(dump, "K;1;X;D;1;!E0302:0:168:173:1:1;=0:168:173:1;")
}

test "an operator over a lambda parameter nothing types is refused" {
  let dump = check_dump([{ name: b"m", src: b"fn f() -> Bool = { let g = |x| x + x; true }" }]);
  assert_eq(dump, "K;1;X;D;1;!E0210:0:31:36:1:3;=0:31:36:1;")
}

test "a test's footprint holds the row of what it calls and the operation it performs itself" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"effect log { write emit(Bytes) -> Unit }\nfn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\ntest \"a test performs through a call\" { say(b\"x\") }\ntest \"a test performs directly\" { log.emit(b\"y\") }",
    },
  ]);
  assert_eq(
    dump,
    "K;1;F;m.say;(Bytes) -> Unit / {m.log.write};m.log.write;m.log.emit;;"
      ++ "T;m.a test performs through a call;0;m.log.write;T;m.a test performs directly;0;m.log.emit;"
      ++ "E;m.log;0;emit:write:0:Bytes:Unit;",
  )
}

test "a function parameter's types and row generalize" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"pub fn twice<a, b>(f: (a) -> b, x: a) -> b = f(x)\npub fn each<a | e>(f: (a) -> Unit / e, xs: List<a>) -> Unit / e = xs.fold((), |acc: Unit, x: a| f(x))",
    },
  ]);
  assert_eq(
    dump,
    "K;1;F;m.twice;<a, b>((a) -> b, a) -> b;;;;F;m.each;<a | e>((a) -> Unit / e, List<a>) -> Unit / e;;;;",
  )
}

test "a derivable constraint is published on the type parameter it names" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"pub fn show<a>(x: a) -> Int where derivable(eq, a) = 1\npub fn keyed<k, v>(m: Map<k, v>) -> Int where derivable(ord, k) = m.len()\nfn used() -> Int = show(2) + keyed(Map::new())",
    },
  ]);
  assert_eq(
    dump,
    "K;1;F;m.show;<a>(a) -> Int;;;eq0;F;m.keyed;<a, b>(Map<a, b>) -> Int;;;ord0;F;m.used;() -> Int;;;;",
  )
}

test "an atom a row writes twice is published once" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"effect log { write emit(Bytes) -> Unit }\neffect audit { write note(Bytes) -> Unit }\nfn twice() -> Unit / { log.write, log.write } = log.emit(b\"x\")\nfn both() -> Unit / { audit.write, log.write, audit.write } = { log.emit(b\"x\"); audit.note(b\"y\") }",
    },
  ]);
  assert_eq(
    dump,
    "K;1;F;m.twice;() -> Unit / {m.log.write};m.log.write;m.log.emit;;"
      ++ "F;m.both;() -> Unit / {m.audit.write, m.log.write};m.audit.write,m.log.write;m.audit.note,m.log.emit;;"
      ++ "E;m.log;0;emit:write:0:Bytes:Unit;E;m.audit;0;note:write:0:Bytes:Unit;",
  )
}

test "a program checked from its own published interfaces publishes the same thing" {
  let src = [
    {
      name: b"m",
      src: b"pub fn id<a>(x: a) -> a = x\nfn two() -> Int = id(2)\neffect log { write emit(Bytes) -> Unit }\nfn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\nfn show<a>(x: a) -> Int where derivable(eq, a) = 1\ntest \"says\" { say(b\"x\") }",
    },
  ];
  let dumps = check_dumps(src);
  assert_eq(dumps.seeded, dumps.walked);
  assert_eq(dumps.walked, check_dump(src))
}

test "a spec clause that reaches an effect through a call is refused at the call" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"effect log { write emit(Bytes) -> Unit }\nfn noisy() -> Bool / { log.write } = { log.emit(b\"x\"); true }\nfn f(x: Int) -> Int requires noisy() = x",
    },
  ]);
  assert_eq(dump, "K;1;X;D;1;!E0417:0:132:139:2:3;=0:132:139:1;=0:123:139:0;")
}

test "functions cannot be compared and a Float cannot key a Map, judged once the module is solved" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"fn keyed() -> Map<Float, Int> = Map::new()\nfn same(f: (Int) -> Int, g: (Int) -> Int) -> Bool = f == g",
    },
  ]);
  assert_eq(dump, "K;1;X;D;2;!E0201:0:95:101:1:1;=0:95:101:1;!E0206:0:14:29:1:2;=0:14:29:1;")
}

test "a cell leaving its region is reported at the exit, under the code its form has always used" {
  assert_eq(
    refusals(b"fn escape() -> Int = { let k = with_cell[r](1) { c -> || cell_get(c) }; 0 }"),
    [[b"E0201", b"the cell escapes its `with_cell[r]` region", b"|| cell_get(c)"]],
  )
}

test "a cell reaches a task only where the scheduler cannot outlive the region" {
  assert_eq(
    check_codes(
      b"fn leak() -> Int / {task.spawn} = { let t = with_cell[s](0) { c -> task.spawn(|| cell_get(c)) }; 0 }",
    ),
    [b"E0446"],
  );
  assert_eq(
    check_codes(
      b"fn joined() -> Int / {sim.read, abort.raise} = simulate { with_cell[s](0) { c -> { let t = task.spawn(|| cell_get(c)); task.join(t) } } }",
    ),
    [b"E0446"],
  );
  assert_eq(
    check_codes(
      b"fn inside() -> Int / {sim.read, abort.raise} = with_cell[s](0) { c -> simulate { let t = task.spawn(|| cell_get(c)); task.join(t) } }",
    ),
    [],
  );
  assert_eq(
    check_codes(
      b"fn data() -> Int / {sim.read, abort.raise} = simulate { with_cell[s](0) { c -> { let t = task.spawn(|| 1); cell_get(c) + task.join(t) } } }",
    ),
    [],
  )
}

/// Each diagnostic as its code, its message and the source its primary label covers.
fn refusals(src: Bytes) -> List<List<Bytes>> / {abort.raise} =
  check_diags(src).map(|diag: Diag|
    [
      diag.code,
      diag.message,
      diag.labels.fold(b"", |acc: Bytes, label: Label|
        if label.primary { src.slice(label.start, label.end) } else { acc }),
    ])

// A test is keyed `<module>.<label>` wherever a run names it: what it reaches, its check, its pass
// and the body its cases are listed by. Two of one label would be one name for two tests.
test "a test, as a law, is keyed by its label, so a module's second test of one label is refused by name" {
  let prefix = b"fn one() -> Int = 1\n";
  assert_eq(
    refusals(
      prefix.concat(
        b"test \"one is one\" { assert_eq(one(), 1) }\ntest \"one is one\" { assert(one() > 0) }",
      ),
    ),
    [[b"E0105", b"two tests are labelled \"one is one\"", b"\"one is one\""]],
  );
  assert_eq(
    refusals(
      prefix.concat(
        b"law \"alike\" forall (n: Int) { one() + n == n + 1 }\nlaw \"alike\" forall (b: Bool) { b || !b }",
      ),
    ),
    [[b"E0105", b"two laws are labelled \"alike\"", b"\"alike\""]],
  );
  assert_eq(
    refusals(
      prefix.concat(
        b"test \"one is one\" { assert_eq(one(), 1) }\ntest \"one is positive\" { assert(one() > 0) }\nlaw \"one is one\" forall (n: Int) { one() + n == n + 1 }",
      ),
    ),
    [],
  )
}

test "a declaration that mentions a `Cell` or a `Task` is refused at the type that mentions it" {
  assert_eq(refusals(b"type Held = Held(Task<Int>)"), [
    [b"E0446", b"`Held`'s field 1 mentions a `Task`", b"Task<Int>"],
  ]);
  assert_eq(refusals(b"type Held = Held(Cell<Int>)"), [
    [b"E0446", b"`Cell` is no type a program writes", b"Cell<Int>"],
  ]);
  assert_eq(refusals(b"type Pool = Idle | Busy(Int, List<Task<Unit>>)"), [
    [b"E0446", b"`Busy`'s field 2 mentions a `Task`", b"List<Task<Unit>>"],
  ]);
  assert_eq(refusals(b"type Box<a> = Box(a)\ntype Held = Held(Box<Task<Int>>)"), [
    [b"E0446", b"`Held`'s field 1 mentions a `Task`", b"Box<Task<Int>>"],
  ]);
  assert_eq(refusals(b"type Pending = Task<Int>\ntype Held = Held(Pending)"), [
    [b"E0446", b"`Held`'s field 1 mentions a `Task`", b"Pending"],
  ]);
  assert_eq(
    refusals(b"effect pool { write give(t: Task<Int>) -> Unit\n write take() -> Task<Int> }"),
    [
      [b"E0446", b"`give`'s parameter 1 mentions a `Task`", b"Task<Int>"],
      [b"E0446", b"`take`'s result mentions a `Task`", b"Task<Int>"],
    ],
  )
}

test "a `Task` in a parameter or a type argument is left to the escape check" {
  assert_eq(check_codes(b"fn serve(running: List<Task<Unit>>) -> Int = running.len()"), []);
  assert_eq(
    check_codes(b"type Box<a> = Box(a)\nfn boxed(t: Task<Int>) -> Box<Task<Int>> = Box(t)"),
    [],
  );
  assert_eq(
    check_codes(
      b"type Box<a> = Box(a)\nfn spawned() -> Box<Task<Int>> / {sim.read} = simulate { Box(task.spawn(|| 1)) }",
    ),
    [b"E0413"],
  )
}

test "a closure that captured a task leaves its `simulate` region by its row, and not otherwise" {
  assert_eq(
    refusals(
      b"fn spawned() -> () -> Int / {task.join, abort.raise} / {sim.read} = simulate { let t = task.spawn(|| 1); || task.join(t) }",
    ),
    [[b"E0413", b"a task escapes the `simulate` region that spawned it", b"|| task.join(t)"]],
  );
  // The region the closure opens is entered by the task as well.
  assert_eq(
    refusals(
      b"fn later() -> () -> Int / {sim.read, abort.raise} / {sim.read} = simulate { let t = task.spawn(|| 1); || simulate { task.join(t) } }",
    ),
    [
      [b"E0413", b"a task enters a `simulate` region that did not spawn it", b"t"],
      [
        b"E0413",
        b"a task escapes the `simulate` region that spawned it",
        b"|| simulate { task.join(t) }",
      ],
    ],
  );
  assert_eq(
    check_codes(
      b"fn joined() -> Int / {sim.read, abort.raise} = simulate { let t = task.spawn(|| 1); let f = || task.join(t); f() }",
    ),
    [],
  )
}

test "a task stored in a cell older than its `simulate` region is refused, and in a younger one kept" {
  assert_eq(
    refusals(
      b"fn stored() -> Option<Task<Int>> / {sim.read} = with_cell[r](None) { c -> { simulate { cell_set(c, Some(task.spawn(|| 1))); 0 }; cell_get(c) } }",
    ),
    [
      [
        b"E0446",
        b"a task spawned in a `simulate` region is stored where it outlives the region",
        b"cell_set(c, Some(task.spawn(|| 1)))",
      ],
    ],
  );
  assert_eq(
    check_codes(
      b"fn nothing() -> Option<Task<Int>> = None\nfn kept() -> Int / {sim.read} = with_cell[r](nothing()) { c -> { let keep = |t: Task<Int>| cell_set(c, Some(t)); simulate { keep(task.spawn(|| 1)); 0 } } }",
    ),
    [b"E0446"],
  );
  assert_eq(
    check_codes(
      b"fn inside() -> Int / {sim.read, abort.raise} = simulate { with_cell[r](None) { c -> { cell_set(c, Some(task.spawn(|| 1))); match cell_get(c) { Some(t) -> task.join(t), None -> 0 } } } }",
    ),
    [],
  );
  assert_eq(
    check_codes(
      b"fn listed() -> Int / {sim.read, abort.raise} = { let none = []; let wait = |t| task.join(t); simulate { none.push(task.spawn(|| 1)).fold(0, |n: Int, t: Task<Int>| n + wait(t)) } }",
    ),
    [],
  )
}

test "a channel keeps to its `simulate` region as a task does" {
  assert_eq(refusals(b"fn made() -> Chan<Int> / {sim.read} = simulate { task.channel(1) }"), [
    [b"E0413", b"a channel escapes the `simulate` region that made it", b"task.channel(1)"],
  ]);
  assert_eq(
    refusals(
      b"fn sender() -> (Int) -> Bool / {task.send} / {sim.read} = simulate { let c = task.channel(1); |x: Int| task.send(c, x) }",
    ),
    [
      [
        b"E0413",
        b"a channel escapes the `simulate` region that made it",
        b"|x: Int| task.send(c, x)",
      ],
    ],
  );
  assert_eq(
    refusals(b"fn taken(c: Chan<Int>) -> Option<Int> / {sim.read} = simulate { task.recv(c) }"),
    [[b"E0413", b"a channel enters a `simulate` region that did not make it", b"c"]],
  );
  assert_eq(
    refusals(
      b"fn stored() -> Option<Chan<Int>> / {sim.read} = with_cell[r](None) { c -> { simulate { cell_set(c, Some(task.channel(0))); 0 }; cell_get(c) } }",
    ),
    [
      [
        b"E0446",
        b"a channel made in a `simulate` region is stored where it outlives the region",
        b"cell_set(c, Some(task.channel(0)))",
      ],
    ],
  );
  assert_eq(refusals(b"type Mailbox = Mailbox(Chan<Int>)"), [
    [b"E0446", b"`Mailbox`'s field 1 mentions a `Chan`", b"Chan<Int>"],
  ]);
  assert_eq(
    check_codes(
      b"fn own() -> Option<Int> / {sim.read} = simulate { let c = task.channel(1); task.send(c, 1); task.recv(c) }",
    ),
    [],
  );
  assert_eq(check_codes(b"fn keyed(m: Map<Chan<Int>, Int>) -> Int = m.len()"), [b"E0206"])
}

test "a task from outside a `simulate` region is refused where the region names it or reads it" {
  assert_eq(
    refusals(
      b"fn joined(t: Task<Int>) -> Int / {sim.read, abort.raise} = simulate { task.join(t) }",
    ),
    [[b"E0413", b"a task enters a `simulate` region that did not spawn it", b"t"]],
  );
  assert_eq(
    check_codes(
      b"fn captured(t: Task<Int>) -> Int / {sim.read, abort.raise} = simulate { let wait = || task.join(t); wait() }",
    ),
    [b"E0413"],
  );
  assert_eq(
    check_codes(
      b"fn listed(ts: List<Task<Int>>) -> Int / {sim.read, abort.raise} = simulate { ts.fold(0, |n: Int, t: Task<Int>| n + task.join(t)) }",
    ),
    [b"E0413"],
  );
  assert_eq(
    refusals(
      b"fn read(t: Task<Int>) -> Int / {sim.read, abort.raise} = with_cell[r](Some(t)) { c -> simulate { match cell_get(c) { Some(x) -> task.join(x), None -> 0 } } }",
    ),
    [[b"E0413", b"a task enters a `simulate` region that did not spawn it", b"cell_get(c)"]],
  )
}

test "a `simulate` region keeps its own tasks, a name it shadows, and a function that only takes one" {
  assert_eq(
    check_codes(
      b"fn own() -> Int / {sim.read, abort.raise} = simulate { let t = task.spawn(|| 1); task.join(t) }",
    ),
    [],
  );
  assert_eq(
    check_codes(
      b"fn shadowed(t: Task<Int>) -> Int / {sim.read, task.join, abort.raise} = task.join(t) + simulate { let t = task.spawn(|| 1); task.join(t) }",
    ),
    [],
  );
  assert_eq(
    check_codes(
      b"fn handed(wait: (Task<Int>) -> Int / {task.join}) -> Int / {sim.read} = simulate { wait(task.spawn(|| 1)) }",
    ),
    [],
  )
}

fn noted(body: Bytes) -> Bytes =
  b"effect note { read say() -> Int }\nfn work() -> Int / {note.read} = note.say()\n".concat(body)

test "a task reaching a younger region's cell through a handler around its spawn is refused" {
  let leak = noted(
    b"fn leak() -> Task<Int> / {task.write} = with_cell[s](5) { c -> handle { task.spawn(|| work()) } with { note.say() -> cell_get(c) } }",
  );
  assert_eq(refusals(leak), [
    [
      b"E0446",
      b"a value allocated in region `s` reaches another task through a handler around its spawn",
      b"|| work()",
    ],
  ]);
  assert_eq(
    check_codes(
      noted(
        b"fn cycle() -> Int / {sim.read, abort.raise} = simulate { with_cell[s](5) { c -> handle { task.join(task.spawn(|| work())) } with { note.say() -> cell_get(c) } } }",
      ),
    ),
    [b"E0446"],
  )
}

test "a handler around a spawn may answer from a cell the task cannot outlive, or for the spawner alone" {
  assert_eq(
    check_codes(
      noted(
        b"fn kept() -> Task<Int> / {task.write} = with_cell[s](5) { c -> handle { task.spawn(|| work()) } with { note.say() -> 7 } }",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      noted(
        b"fn root() -> Int / {task.write, abort.raise} = with_cell[s](5) { c -> handle { let t = task.spawn(|| 1); note.say() + task.join(t) } with { note.say() -> cell_get(c) } }",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      noted(
        b"fn inside() -> Int / {sim.read, abort.raise} = with_cell[s](5) { c -> simulate { handle { task.join(task.spawn(|| work())) } with { note.say() -> cell_get(c) } } }",
      ),
    ),
    [],
  );
  // A spawn a callee performs is judged where the callee opens regions of its own.
  assert_eq(
    check_codes(
      noted(
        b"fn spawned(n: Int, running: List<Task<Int>>) -> List<Task<Int>> / {task.write, note.read} = if n <= 0 { running } else { spawned(n - 1, running.push(task.spawn(|| work()))) }\nfn joined(ts: List<Task<Int>>) -> Int / {task.write, abort.raise} = ts.fold(0, |n: Int, t: Task<Int>| n + task.join(t))\nfn serve() -> Int / {task.write, abort.raise} = with_cell[store](1) { c -> handle { joined(spawned(2, [])) } with { note.say() -> cell_get(c) } }",
      ),
    ),
    [],
  )
}

test "a call instantiating a constrained parameter with a function is refused at the call" {
  let dump = check_dump([
    {
      name: b"m",
      src: b"fn show<a>(x: a) -> String where derivable(json, a) = \"\"\nfn bad() -> String = show(|y: Int| y)",
    },
  ]);
  assert_eq(dump, "K;1;X;D;1;!E0206:0:78:82:2:1;=0:78:82:1;=0:0:56:0;")
}

/// Each error a program raises, in the order the checker reports them.
fn errors_across(sources: List<Source>) -> List<Diag> / {abort.raise} = {
  let parsed = range(0, sources.len()).map(|i: Int| {
    let s = sources.get(i);
    let r = parse(s.src);
    let x = expand(r.node, r.parser.diags);
    let d: Expansion = expand_derives(i, s.name, x.module);
    { name: s.name, module: d.module, derived: d.derived, diags: d.diags }
  });
  let early = parsed.fold([], |acc: List<Diag>, p: Parsed| acc.concat(p.diags));
  if early.len() > 0 { early } else {
    match resolve_modules(
        parsed.map(|p: Parsed| { name: p.name, module: p.module, derived: p.derived }),
      ) {
      ResolveFailed(ds) -> ds,
      ResolveSucceeded(x) ->
        dedup_diags(check_program(x.r, x.mods).checker.diags).filter(|diag: Diag|
          diag.severity == b"error"),
    }
  }
}

fn codes_across(sources: List<Source>) -> List<Bytes> / {abort.raise} =
  errors_across(sources).map(|diag: Diag| diag.code)

// The two atoms sit at the same offsets of their files.
test "an atom refused in one module refuses nothing written at the same place in another" {
  assert_eq(
    codes_across([
      { name: b"a", src: b"fn sender(f: () -> Unit / {net.send[x]}) -> Unit = f()\n" },
      { name: b"b", src: b"fn digit(b: Int) -> Int / {abort.raise} = abort.raise(\"x\")\n" },
    ]),
    [b"E0103"],
  )
}

test "a fix that braces a bare row variable keeps its `bounded` inside the braces" {
  let src = b"fn f<| e>(g: () -> Int / e) -> Int / e bounded = g() / g()";
  let ds = check_diags(src);
  assert_eq(ds.map(|dg: Diag| dg.code), [b"E0302"]);
  let fixed = fixed_by(src, fixes_of(ds).get(0));
  assert(fixed.index_of(b"/ {abort.raise | e bounded} =") != None, Some(String::of_bytes(fixed)));
  assert_eq(check_codes(fixed), [])
}

test "a fix spells only what the module can name, so a row it cannot write gets none" {
  let ds = errors_across([
    {
      name: b"base",
      src: b"pub effect net { write send[c](p: Bytes) -> Unit }\npub fn push() -> Unit / {net.send[c]} = net.send[c](b\"x\")\n",
    },
    {
      name: b"app",
      src: b"import base (push)\nfn run() -> Unit / {clock.read} = push()\nfn quiet() -> Unit = push()",
    },
  ]);
  assert_eq(ds.map(|diag: Diag| diag.code), [b"E0302", b"E0302"]);
  assert_eq(fixes_of(ds), [])
}

test "a record update takes its shape from the base's inferred type, not from where it was written" {
  let p = b"type P = { a: Int, b: Int }\nfn mk() -> P = { a: 1, b: 2 }\n";
  assert_eq(
    codes_across([{ name: b"m", src: p.concat(b"fn f() -> P = { let q = mk(); {..q, b: 3} }") }]),
    [],
  );
  assert_eq(
    codes_across([
      {
        name: b"m",
        src: p.concat(
          b"fn g(ps: List<P>) -> P = match ps.at(0) { Some(q) -> {..q, b: 3}, None -> mk() }",
        ),
      },
    ]),
    [],
  );
  assert_eq(
    codes_across([
      {
        name: b"m",
        src: p.concat(b"fn h(xs: List<Int>) -> P = xs.fold(mk(), |acc, x| {..acc, a: x})"),
      },
    ]),
    [],
  )
}

test "a record update may name a record type another module declares" {
  assert_eq(
    codes_across([
      {
        name: b"shapes",
        src: b"pub type P = { a: Int, b: Int }\npub fn mk() -> P = { a: 1, b: 2 }",
      },
      {
        name: b"m",
        src: b"import shapes\nfn f() -> shapes::P = { let q = shapes::mk(); {..q, b: 3} }",
      },
    ]),
    [],
  )
}

test "a record update is refused where the base is not a record, or where nothing says what it is" {
  let p = b"type P = { a: Int, b: Int }\n";
  assert_eq(
    codes_across([
      { name: b"m", src: p.concat(b"fn f(n: Int) -> Int = { let q = {..n, a: 1}; 0 }") },
    ]),
    [b"E0116"],
  );
  assert_eq(
    codes_across([
      { name: b"m", src: p.concat(b"fn f() -> Int = { let g = |s| {..s, a: 1}; 0 }") },
    ]),
    [b"E0116"],
  );
  assert_eq(codes_across([{ name: b"m", src: p.concat(b"fn f(q: P) -> P = {..q, c: 1}") }]), [
    b"E0117",
  ])
}

test "`++` joins two Strings or two Bytes, and refuses one of each" {
  assert_eq(
    codes_across([{ name: b"m", src: b"fn f(a: String, b: String) -> String = a ++ b" }]),
    [],
  );
  assert_eq(codes_across([{ name: b"m", src: b"fn f(a: Bytes, b: Bytes) -> Bytes = a ++ b" }]), []);
  assert_eq(
    codes_across([
      {
        name: b"m",
        src: b"fn f(xs: List<Bytes>) -> Bytes = xs.fold(b\"\", |acc: Bytes, x: Bytes| acc ++ x)",
      },
    ]),
    [],
  );
  assert_eq(
    codes_across([{ name: b"m", src: b"fn f(a: String, b: Bytes) -> String = a ++ b" }]),
    [b"E0201"],
  );
  assert_eq(codes_across([{ name: b"m", src: b"fn f(a: Int, b: Int) -> Int = a ++ b" }]), [
    b"E0201",
  ]);
  assert_eq(codes_across([{ name: b"m", src: b"fn f() -> Int = { let g = |a, b| a ++ b; 0 }" }]), [
    b"E0210",
  ])
}

/// The label of each `E0205` a one-module program raises.
fn not_covered(src: Bytes) -> List<Bytes> / {abort.raise} = {
  let r = parse(src);
  let x = expand(r.node, r.parser.diags);
  let d: Expansion = expand_derives(0, b"m", x.module);
  match resolve_modules([{ name: b"m", module: d.module, derived: d.derived }]) {
    ResolveFailed(_) -> [b"does not resolve"],
    ResolveSucceeded(ok) ->
      check_program(ok.r, ok.mods).checker.diags.filter(|diag: Diag| diag.code == b"E0205").map(
        |diag: Diag| diag.labels.get(0).text,
      ),
  }
}

/// The first label of each diagnostic of `code` a one-module program raises.
fn labels_of(src: Bytes, code: Bytes) -> List<Bytes> / {abort.raise} =
  check_diags(src).filter(|diag: Diag| diag.code == code).map(|diag: Diag| diag.labels.get(0).text)

test "an or-pattern's alternatives bind the same names at one type" {
  let t = b"type T = | A(Int) | B(Int) | C(String) | D\n";
  assert_eq(check_codes(t.concat(b"fn f(x: T) -> Int = match x { A(n) | B(n) -> n, _ -> 0 }")), []);
  assert_eq(
    labels_of(t.concat(b"fn f(x: T) -> Int = match x { A(n) | D -> n, _ -> 0 }"), b"E0212"),
    [b"does not bind `n`, which the first alternative does"],
  );
  assert_eq(
    labels_of(t.concat(b"fn f(x: T) -> Int = match x { D | A(n) -> 0, _ -> 1 }"), b"E0212"),
    [b"binds `n`, which the first alternative does not"],
  );
  assert_eq(
    labels_of(t.concat(b"fn f(x: T) -> Int = match x { A(n) | B(m) -> 0, _ -> 1 }"), b"E0212"),
    [b"binds `m` where the first alternative binds `n`"],
  );
  assert_eq(check_codes(t.concat(b"fn f(x: T) -> Int = match x { A(n) | C(n) -> 0, _ -> 1 }")), [
    b"E0201",
  ])
}

test "a match is exhausted through its or-patterns, nested ones included" {
  let t = b"type T = | A | B | C\n";
  assert_eq(not_covered(t.concat(b"fn f(x: T) -> Int = match x { A | B -> 1, C -> 2 }")), []);
  assert_eq(not_covered(t.concat(b"fn f(x: T) -> Int = match x { A | B -> 1 }")), [
    b"not covered: `C`",
  ]);
  assert_eq(
    not_covered(t.concat(b"fn f(o: Option<T>) -> Int = match o { Some(A | C) -> 1, None -> 2 }")),
    [b"not covered: `Some(B)`"],
  );
  assert_eq(
    not_covered(
      t.concat(b"fn f(p: (T, Bool)) -> Int = match p { (A | B, _) -> 1, (C, true | false) -> 2 }"),
    ),
    [],
  )
}

test "a plain `let` whose or-pattern can fail is refused, and one that covers its type is not" {
  assert_eq(check_codes(b"fn f(r: Result<Int, Int>) -> Int = { let Ok(v) | Err(v) = r; v }"), []);
  assert_eq(
    labels_of(
      b"fn f(r: Option<Int>) -> Int / {abort.raise} = { let Some(1) | Some(2) = r; 0 }",
      b"E0213",
    ),
    [b"not covered: `None`, `Some(_)`"],
  );
  // Without an or-pattern a refutable `let` is still the runtime's to refuse.
  assert_eq(check_codes(b"fn f(r: Option<Int>) -> Int / {abort.raise} = { let Some(v) = r; v }"), [
  ])
}

test "literals and ranges exhaust an unsigned width they cover, and a match names what they miss" {
  assert_eq(
    not_covered(b"fn f(b: U8) -> Int = match b { 0u8..=127u8 -> 0, 128u8..=255u8 -> 1 }"),
    [],
  );
  assert_eq(
    not_covered(b"fn f(b: U8) -> Int = match b { 0u8..=200u8 -> 0, 100u8..=255u8 -> 1 }"),
    [],
  );
  assert_eq(not_covered(b"fn f(b: U8) -> Int = match b { 0u8..=9u8 -> 0, 20u8..=255u8 -> 1 }"), [
    b"not covered: `10u8..=19u8`",
  ]);
  assert_eq(
    not_covered(b"fn f(b: U8) -> Int = match b { 0u8..=9u8 -> 0, 10u8 -> 1, 12u8..=255u8 -> 2 }"),
    [b"not covered: `11u8`"],
  );
  assert_eq(not_covered(b"fn f(c: Int) -> Int = match c { 0..=9 -> 1, 5..=20 -> 2, _ -> 0 }"), []);
  assert_eq(
    not_covered(b"fn f(o: Option<U8>) -> Int = match o { Some(0u8..=254u8) -> 0, None -> 1 }"),
    [b"not covered: `Some(255u8)`"],
  );
  assert_eq(
    not_covered(
      b"fn f(p: (U8, Bool)) -> Int = match p { (0u8..=9u8, true) -> 0, (_, false) -> 1 }",
    ),
    [b"not covered: `(10u8..=255u8, true)`"],
  );
  // No other integer type's least and greatest values are both literals, so only a `_` ends one.
  assert_eq(not_covered(b"fn f(c: Int) -> Int = match c { b'0'..=b'9' -> 1 }"), [
    b"not covered: `_`",
  ]);
  assert_eq(not_covered(b"fn f(t: I8) -> Int = match t { -127i8..=127i8 -> 1 }"), [
    b"not covered: `_`",
  ]);
  assert_eq(
    not_covered(b"fn f(n: U64) -> Int = match n { 0u64..=0xFFFF_FFFF_FFFF_FFFFu64 -> 0 }"),
    [b"not covered: `_`"],
  )
}

test "a range pattern's bounds are integer literals of one type, the first no greater" {
  assert_eq(check_codes(b"fn f(n: Int) -> Int = match n { 0..=9 -> 1, 7..=7 -> 2, _ -> 0 }"), []);
  assert_eq(check_codes(b"fn f(n: Int) -> Int = match n { 9..=0 -> 1, _ -> 0 }"), [b"E0222"]);
  assert_eq(check_codes(b"fn f(n: Int) -> Int = match n { 0..=9u8 -> 1, _ -> 0 }"), [b"E0222"]);
  assert_eq(check_codes(b"fn f(c: Char) -> Int = match c { 'a'..='z' -> 1, _ -> 0 }"), [b"E0222"]);
  assert_eq(check_codes(b"fn f(s: String) -> Int = match s { \"a\"..=\"z\" -> 1, _ -> 0 }"), [
    b"E0222",
  ]);
  assert_eq(check_codes(b"fn f(n: U8) -> Int = match n { 0..=9 -> 1, _ -> 0 }"), [b"E0201"]);
  assert_eq(
    check_codes(b"fn f(n: U64) -> Int = match n { 0xFFFF_FFFF_FFFF_FFFFu64..=1u64 -> 1, _ -> 0 }"),
    [b"E0222"],
  );
  assert_eq(
    check_codes(b"fn f(n: U64) -> Int = match n { 1u64..=0xFFFF_FFFF_FFFF_FFFFu64 -> 1, _ -> 0 }"),
    [],
  );
  assert_eq(
    check_codes(
      b"fn f(n: I128) -> Int = match n { -1i128..=1i128 -> 1, 2i128..=1i128 -> 2, _ -> 0 }",
    ),
    [b"E0222"],
  )
}

test "a `let ... else` checks its `else` against its block's value, without the pattern's names" {
  assert_eq(check_codes(b"fn f(o: Option<Int>) -> Int = { let Some(v) = o else { 0 }; v }"), []);
  assert_eq(
    check_codes(b"fn f(o: Option<Int>) -> Int = { let Some(v) = o else { \"none\" }; v }"),
    [b"E0201"],
  );
  assert_eq(check_codes(b"fn f(o: Option<Int>) -> Int = { let Some(v) = o else { v }; v }"), [
    b"E0101",
  ]);
  // With no tail the block is `Unit`, and so is its `else`.
  assert_eq(check_codes(b"fn f(o: Option<Int>) -> Unit = { let Some(v) = o else { () }; }"), [])
}

test "a match is exhaustive through nested constructors, and names the inner case it misses" {
  let t = b"type T = | A | B\n";
  assert_eq(
    not_covered(
      t.concat(b"fn f(o: Option<T>) -> Int = match o { Some(A) -> 1, Some(B) -> 2, None -> 3 }"),
    ),
    [],
  );
  assert_eq(
    not_covered(t.concat(b"fn f(o: Option<T>) -> Int = match o { Some(A) -> 1, None -> 3 }")),
    [b"not covered: `Some(B)`"],
  );
  assert_eq(
    not_covered(
      t.concat(
        b"fn f(r: Result<Option<T>, T>) -> Int = match r { Ok(Some(A)) -> 1, Ok(None) -> 2, Err(_) -> 3 }",
      ),
    ),
    [b"not covered: `Ok(Some(B))`"],
  );
  assert_eq(not_covered(t.concat(b"fn f(r: Result<T, T>) -> Int = match r { Ok(A) -> 1 }")), [
    b"not covered: `Ok(B)`, `Err(_)`",
  ])
}

test "a guarded arm covers nothing, and a constructor that does not resolve covers nothing" {
  let t = b"type T = | A | B\n";
  assert_eq(
    not_covered(
      t.concat(
        b"fn f(o: Option<T>, n: Int) -> Int = match o { Some(A) if n > 0 -> 1, Some(B) -> 2, None -> 3 }",
      ),
    ),
    [b"not covered: `Some(A)`"],
  );
  assert_eq(
    not_covered(
      t.concat(
        b"fn f(o: Option<T>, n: Int) -> Int = match o { Some(A) if n > 0 -> 1, Some(_) -> 2, None -> 3 }",
      ),
    ),
    [],
  );
  assert_eq(
    not_covered(t.concat(b"fn f(o: Option<T>) -> Int = match o { Some(C) -> 1, None -> 3 }")),
    [b"not covered: `Some(_)`"],
  )
}

test "booleans are exhausted by both literals, a unit by its one, and other literals never" {
  assert_eq(
    not_covered(
      b"fn f(p: (Bool, Bool)) -> Int = match p { (true, _) -> 1, (_, true) -> 2, (false, false) -> 3 }",
    ),
    [],
  );
  assert_eq(
    not_covered(b"fn f(p: (Bool, Bool)) -> Int = match p { (true, _) -> 1, (false, true) -> 2 }"),
    [b"not covered: `(false, false)`"],
  );
  assert_eq(not_covered(b"fn f(u: Unit) -> Int = match u { () -> 1 }"), []);
  assert_eq(not_covered(b"fn f(n: Int) -> Int = match n { 0 -> 1, 1 -> 2 }"), [
    b"not covered: `_`",
  ]);
  assert_eq(not_covered(b"fn f(o: Option<Int>) -> Int = match o { Some(0) -> 1, None -> 2 }"), [
    b"not covered: `Some(_)`",
  ])
}

test "list patterns are exhausted by exact lengths and prefixes, element patterns included" {
  assert_eq(
    not_covered(
      b"fn f(xs: List<Int>) -> Int = match xs { [] -> 0, [x] -> x, [x, y, ..rest] -> x + y }",
    ),
    [],
  );
  assert_eq(
    not_covered(b"fn f(xs: List<Int>) -> Int = match xs { [] -> 0, [x, y, ..rest] -> x + y }"),
    [b"not covered: `[_]`"],
  );
  assert_eq(not_covered(b"fn f(xs: List<Int>) -> Int = match xs { [x, ..rest] -> x }"), [
    b"not covered: `[]`",
  ]);
  assert_eq(
    not_covered(
      b"fn f(xs: List<Option<Int>>) -> Int = match xs { [] -> 0, [None, ..] -> 1, [Some(x), ..rest] -> x }",
    ),
    [],
  );
  assert_eq(
    not_covered(
      b"fn f(xs: List<Option<Int>>) -> Int = match xs { [] -> 0, [Some(x), ..rest] -> x }",
    ),
    [b"not covered: `[None, ..]`"],
  )
}

test "record patterns are exhausted field by field" {
  let t = b"type T = | A | B\n";
  assert_eq(
    not_covered(
      t.concat(b"fn f(p: { t: T, n: Int }) -> Int = match p { {t: A, n} -> n, {t: B, ..} -> 0 }"),
    ),
    [],
  );
  assert_eq(
    not_covered(t.concat(b"fn f(p: { t: T, n: Int }) -> Int = match p { {t: A, n} -> n }")),
    [b"not covered: `{t: B, ..}`"],
  )
}

test "a `parallel` block is the tuple of its branches, and branches may share what none of them writes" {
  assert_eq(check_codes(b"fn f(n: Int) -> (Int, Bool) = parallel { n + 1, n > 0 }"), []);
  assert_eq(check_codes(b"fn f(n: Int) -> (Int, Int, Int) = parallel { n, n, n }"), []);
  assert_eq(check_codes(b"fn f(n: Int) -> (Bool, Int) = parallel { n + 1, n > 0 }"), [b"E0201"]);
  assert_eq(
    check_codes(
      net_src(b"fn f() -> (Int, Int) / {net.read[c]} = parallel { net.peek[c](), net.peek[c]() }"),
    ),
    [],
  );
  assert_eq(
    check_codes(
      net_src(
        b"fn f() -> (Unit, Int) / {net.write[c], net.read[d]} = parallel { net.close[c](), net.peek[d]() }",
      ),
    ),
    [],
  )
}

test "two branches that touch one resource where either writes are refused" {
  let diags = check_diags(
    net_src(
      b"fn f() -> (Unit, Int) / {net.write[c], net.read[c]} = parallel { net.close[c](), net.peek[c]() }",
    ),
  );
  assert_eq(diags.map(|diag: Diag| diag.code), [b"E0309"]);
  assert(
    diags.fold(false, |b: Bool, diag: Diag|
      b
        || diag.labels.fold(false, |c: Bool, label: Label|
          c || label.text.index_of(b"net.close[c]") != None)),
  );
  // A label parameter may be any label.
  assert_eq(
    check_codes(
      net_src(
        b"fn f<[l]>() -> (Unit, Int) / {net.write[l], net.read[c]} = parallel { net.close[l](), net.peek[c]() }",
      ),
    ),
    [b"E0309"],
  );
  // A cell of a region opened outside the block is one resource the branches share.
  assert_eq(
    check_codes(
      b"fn f() -> Int = with_cell[w](0) { c -> { let p = parallel { cell_set(c, 1), cell_get(c) }; p._1 } }",
    ),
    [b"E0309"],
  );
  assert_eq(
    check_codes(
      b"fn f() -> (Int, Int) = parallel { with_cell[w](0) { c -> cell_get(c) }, with_cell[w](1) { c -> { cell_set(c, 2); cell_get(c) } } }",
    ),
    [],
  )
}

test "a branch whose row is open may perform anything, so it shares with no branch that performs" {
  assert_eq(check_codes(b"fn f<| e>(g: () -> Int / e) -> (Int, Int) / e = parallel { g(), 1 }"), [
  ]);
  assert_eq(
    check_codes(b"fn f<| e>(g: () -> Int / e) -> (Int, Int) / e = parallel { g(), g() }"),
    [b"E0309"],
  )
}

test "a branch may not open a `simulate` region, whose schedule is its entry's, nor spawn a task" {
  assert_eq(check_codes(b"fn f() -> (Int, Int) / {sim.read} = parallel { simulate { 1 }, 2 }"), [
    b"E0309",
  ]);
  assert_eq(
    check_codes(
      b"fn f() -> (Int, Int) / {task.write, abort.raise} = parallel { task.join(task.spawn(|| 1)), 2 }",
    ),
    [b"E0309"],
  )
}

// --- How many times a body performs what its row names --------------------------------------

fn db_source(body: Bytes) -> Bytes =
  b"effect db { read query[c](sql: Bytes) -> Int }\nfn lookup(id: Int) -> Int / {db.query[conn]} = db.query[conn](b\"one\")\n".concat(
    body,
  )

/// Whether `name`'s row names its atoms as growing with the input, and which callbacks it calls so.
fn counted(src: Bytes, name: Bytes) -> { scaling: Bool, repeats: List<Int> } / {abort.raise} =
  match def_of(checked_cx(src), b"m.".concat(name)) {
    Some(d) -> { scaling: d.scaling.len() > 0, repeats: d.repeats },
    None -> panic("the definition the test names"),
  }

test "a lookup performs its query a bounded number of times, and the same lookup mapped over its input scales" {
  assert_eq(counted(db_source(b""), b"lookup"), { scaling: false, repeats: [] });
  let mapped = db_source(
    b"fn all(ids: List<Int>) -> List<Int> / {db.query[conn]} = ids.map(lookup)\n",
  );
  assert_eq(counted(mapped, b"all"), { scaling: true, repeats: [] });
  let lambda = db_source(
    b"fn all(ids: List<Int>) -> List<Int> / {db.query[conn]} = ids.map(|id: Int| lookup(id))\n",
  );
  assert_eq(counted(lambda, b"all"), { scaling: true, repeats: [] });
  // A list the text writes out is a size no input decides.
  let three = db_source(
    b"fn three() -> List<Int> / {db.query[conn]} = [1, 2, 3].map(|id: Int| lookup(id))\n",
  );
  assert_eq(counted(three, b"three"), { scaling: false, repeats: [] });
  // What a mapped callback evaluates once, before the iteration, does not scale with it.
  let once = db_source(
    b"fn first(ids: List<Int>) -> List<Int> / {db.query[conn]} = { let n = lookup(0); ids.map(|id: Int| id + n) }\n",
  );
  assert_eq(counted(once, b"first"), { scaling: false, repeats: [] })
}

test "recursion repeats everything its body performs, and a callback's count composes through its caller" {
  let walked = db_source(
    b"fn walk(ids: List<Int>) -> Int / {db.query[conn]} = match ids { [] -> 0, [id, ..rest] -> lookup(id) + walk(rest) }\n",
  );
  assert_eq(counted(walked, b"walk"), { scaling: true, repeats: [] });
  let each = db_source(
    b"fn each<a | e>(xs: List<a>, f: (a) -> Unit / e) -> Unit / e = xs.fold((), |u: Unit, x: a| f(x))\nfn once<a | e>(f: () -> a / e) -> a / e = f()\nfn looked(ids: List<Int>) -> Unit / {db.query[conn]} = each(ids, |id: Int| { lookup(id); () })\nfn one() -> Int / {db.query[conn]} = once(|| lookup(1))\n",
  );
  assert_eq(counted(each, b"each"), { scaling: false, repeats: [1] });
  assert_eq(counted(each, b"once"), { scaling: false, repeats: [] });
  assert_eq(counted(each, b"looked"), { scaling: true, repeats: [] });
  assert_eq(counted(each, b"one"), { scaling: false, repeats: [] })
}

test "a row's `bounded` promise is held to the body, and only a definition's own row makes one" {
  assert_eq(
    check_codes(
      db_source(
        b"fn batched(ids: List<Int>) -> Int / {db.query[conn] bounded} = db.query[conn](b\"in\")\n",
      ),
    ),
    [],
  );
  assert_eq(
    check_codes(
      db_source(
        b"fn per_item(ids: List<Int>) -> Int / {db.query[conn] bounded} = ids.fold(0, |n: Int, id: Int| n + lookup(id))\n",
      ),
    ),
    [b"E0465"],
  );
  assert_eq(
    check_codes(
      b"fn each<a | e>(xs: List<a>, f: (a) -> Unit / e) -> Unit / e bounded = xs.fold((), |u: Unit, x: a| f(x))\n",
    ),
    [b"E0465"],
  );
  assert_eq(
    check_codes(
      db_source(
        b"fn take(f: () -> Int / {db.query[conn] bounded}) -> Int / {db.query[conn]} = f()\n",
      ),
    ),
    [b"E0466"],
  )
}

fn diverges(src: Bytes, name: Bytes) -> Bool / {abort.raise} =
  match def_of(checked_cx(src), b"m.".concat(name)) {
    Some(d) -> match d.ending { Diverges(_) -> true, _ -> false },
    None -> panic("the definition the test names"),
  }

test "a definition that may not return writes `diverges`, which its callers inherit and a fix writes for them" {
  // At the root no fix is offered: what usually fixes it is a recursion that descends.
  let root = check_diags(b"fn spin(n: Int) -> Int = spin(n + 1)\n");
  assert_eq(root.map(|diag: Diag| diag.code), [b"E0302"]);
  assert_eq(root.map(|diag: Diag| diag.message), [
    b"`spin` may not return, and its row does not say so",
  ]);
  assert_eq(root.map(|diag: Diag| diag.fixes.len()), [0]);
  assert_eq(check_codes(b"fn spin(n: Int) -> Int / {diverges} = spin(n + 1)\n"), []);
  // A caller writes it as it writes any effect it performs, and here the fix is the whole answer.
  let caller = check_diags(
    b"fn spin(n: Int) -> Int / {diverges} = spin(n + 1)\nfn wait(n: Int) -> Int = spin(n)\n",
  );
  assert_eq(caller.map(|diag: Diag| diag.code), [b"E0302"]);
  assert_eq(caller.map(|diag: Diag| diag.notes_text), [
    [
      b"a call that may not return makes `wait` one too: write `/ {diverges}` after the return type, or call only what ends",
    ],
  ]);
  assert_eq(caller.map(|diag: Diag| diag.fixes.len()), [1]);
  assert_eq(
    check_codes(
      b"fn spin(n: Int) -> Int / {diverges} = spin(n + 1)\nfn wait(n: Int) -> Int / {diverges} = spin(n)\n",
    ),
    [],
  );
  // A row that says more than the body does is allowed, as for any effect.
  assert_eq(
    check_codes(b"fn down(n: Int) -> Int / {diverges} = if n <= 0 { 0 } else { down(n - 1) }\n"),
    [],
  );
  // A stated measure is read by the checker, and judged where the program is loaded.
  assert_eq(
    check_codes(
      b"fn climb(a: Int, b: Int) -> Int decreases a + b = if a + b <= 0 { 0 } else { climb(a + 1, b - 2) }\n",
    ),
    [],
  )
}

test "a test or law that may not return supplies nothing for it: its steps bound it" {
  let src = b"fn spin(n: Int) -> Int / {diverges} = spin(n + 1)\ntest \"spins\" { assert_eq(spin(0), 0) }\nlaw \"spins too\" forall (n: Int) { spin(n) == spin(n) }\n";
  assert_eq(check_codes(src), []);
  let c = checked_cx(src);
  assert_eq(c.tests.map(|t: TestInfo| t.footprint.len()), [0]);
  assert_eq(c.laws.map(|l: LawInfo| l.footprint.len()), [0])
}

test "recursion on a part of an argument terminates, and recursion on the argument itself may not" {
  assert(
    !diverges(
      b"fn count(xs: List<Int>) -> Int = match xs { [] -> 0, [x, ..rest] -> 1 + count(rest) }\n",
      b"count",
    ),
  );
  let tree = b"type T = | Leaf | Node(T, Int, T)\n";
  assert(
    !diverges(
      tree.concat(
        b"fn size(t: T) -> Int = match t { Leaf -> 0, Node(l, v, r) -> size(l) + 1 + size(r) }\n",
      ),
      b"size",
    ),
  );
  assert(diverges(b"fn spin(n: Int) -> Int = spin(n)\n", b"spin"));
  assert(
    diverges(
      b"fn keep(xs: List<Int>) -> Int = match xs { [] -> 0, [x, ..rest] -> keep(xs) }\n",
      b"keep",
    ),
  );
  // A field of a record the call rebuilds is a measure of its own.
  assert(
    !diverges(
      b"fn drain(s: { todo: List<Int>, done: List<Int> }) -> List<Int> = match s.todo { [] -> s.done, [x, ..rest] -> drain({ todo: rest, done: s.done.push(x) }) }\n",
      b"drain",
    ),
  )
}

test "an integer terminates descending toward a bound a guard holds it above" {
  assert(!diverges(b"fn down(n: Int) -> Int = if n <= 0 { 0 } else { down(n - 1) }\n", b"down"));
  // `n == 0` holds nothing below: from `-1` the descent never meets it.
  assert(diverges(b"fn down(n: Int) -> Int = if n == 0 { 0 } else { down(n - 1) }\n", b"down"));
  assert(
    !diverges(
      b"fn walk(xs: List<Int>, i: Int) -> Int = if i >= xs.len() { 0 } else { walk(xs, i + 1) }\n",
      b"walk",
    ),
  );
  assert(
    diverges(
      b"fn climb(xs: List<Int>, i: Int) -> Int = if i >= xs.len() { 0 } else { climb(xs.push(i), i + 1) }\n",
      b"climb",
    ),
  );
  assert(
    !diverges(
      b"fn ack(m: Int, n: Int) -> Int = if m <= 0 { n + 1 } else if n <= 0 { ack(m - 1, 1) } else { ack(m - 1, ack(m, n - 1)) }\n",
      b"ack",
    ),
  )
}

test "a group terminates when every loop through it descends, through a builtin's callback too" {
  let src = b"type T = | Node(Int, List<T>)\nfn size(t: T) -> Int = match t { Node(v, kids) -> v + total(sizes(kids)) }\nfn sizes(ts: List<T>) -> List<Int> = ts.map(size)\nfn total(xs: List<Int>) -> Int = xs.fold(0, |a: Int, x: Int| a + x)\nfn deep(t: T) -> Int = match t { Node(v, kids) -> kids.fold(v, |a: Int, k: T| a + deep(k)) }\n";
  assert(!diverges(src, b"size"));
  assert(!diverges(src, b"sizes"));
  assert(!diverges(src, b"deep"));
  // A map's entries are made of its parts.
  let doc = b"type J = | Leaf | Obj(Map<String, J>)\nfn count(j: J) -> Int = match j { Leaf -> 1, Obj(m) -> m.entries().fold(0, |n: Int, e: { key: String, value: J }| n + count(e.value)) }\n";
  assert(!diverges(doc, b"count"));
  // Handed to a function the check does not read, a member is called with nothing known.
  assert(
    diverges(
      b"fn twice(f: (Int) -> Int, n: Int) -> Int = f(f(n))\nfn down(n: Int) -> Int = if n <= 0 { 0 } else { twice(down, n - 1) }\n",
      b"down",
    ),
  );
  assert(
    diverges(
      b"fn ping(n: Int) -> Int = pong(n)\nfn pong(n: Int) -> Int = if n <= 0 { 0 } else { ping(n) }\n",
      b"ping",
    ),
  )
}

test "a callback a recursion hands on in its own place is called as that recursion calls it" {
  let tree = b"type T = | Node(Int, List<T>)\n";
  let trav = b"fn trav(xs: List<T>, f: (T) -> Option<Int>, done: List<Int>) -> Option<List<Int>> = match xs { [] -> Some(done), [x, ..rest] -> match f(x) { None -> None, Some(y) -> trav(rest, f, done.push(y)) } }\n";
  let total = b"fn total(t: T) -> Option<Int> = match t { Node(v, kids) -> match trav(kids, |k: T| total(k), []) { None -> None, Some(ys) -> Some(ys.fold(v, |a: Int, y: Int| a + y)) } }\n";
  let src = Bytes::concat_all([tree, trav, total]);
  assert(!diverges(src, b"trav"));
  assert(!diverges(src, b"total"));
  // Handed on beside what is not a part of what this call was handed, it is called with that.
  let grown = b"fn grown(xs: List<T>, ys: List<T>, f: (T) -> Int, n: Int) -> Int = if n <= 0 { 0 } else { match ys { [] -> 0, [y, ..] -> f(y) + grown(xs, xs.fold(ys, |acc: List<T>, x: T| acc.push(x)), f, n - 1) } }\nfn through(t: T) -> Int = match t { Node(v, kids) -> v + grown(kids, kids, |k: T| through(k), 2) }\n";
  assert(diverges(tree.concat(grown), b"through"));
  // Handed on in another callback's place, it goes where the check does not follow.
  let swapped = b"fn swapped(xs: List<T>, f: (T) -> Int, g: (T) -> Int) -> Int = match xs { [] -> 0, [x, ..rest] -> f(x) + swapped(rest, g, f) }\nfn through(t: T) -> Int = match t { Node(v, kids) -> v + swapped(kids, |k: T| through(k), |k: T| 0) }\n";
  assert(diverges(tree.concat(swapped), b"through"));
  // Called with a count that grows at every call, it is called with nothing known.
  assert(
    diverges(
      b"fn counted(i: Int, n: Int, f: (Int) -> Int) -> Int = if i >= n { 0 } else { f(i) + counted(i + 1, n, f) }\nfn down(n: Int) -> Int = if n <= 0 { 0 } else { counted(0, n, |i: Int| down(i)) }\n",
      b"down",
    ),
  )
}

test "a guard an earlier arm failed, an index found, and a write that keeps the length bound a walk" {
  assert(
    !diverges(
      b"fn down(p: { left: Int, seen: Int }) -> Int = match p { { left, seen } if left <= 0 -> seen, { left, seen } -> down({ left: left - 1, seen: seen + 1 }) }\n",
      b"down",
    ),
  );
  assert(
    diverges(
      b"fn down(p: { left: Int, seen: Int }) -> Int = match p { { left, seen } if left > 9 -> seen, { left, seen } -> down({ left: left - 1, seen: seen + 1 }) }\n",
      b"down",
    ),
  );
  assert(
    !diverges(
      b"fn last(xs: List<Int>, i: Int, seen: Option<Int>) -> Option<Int> = match xs.at(i) { None -> seen, Some(x) -> last(xs, i + 1, Some(x)) }\n",
      b"last",
    ),
  );
  assert(
    !diverges(
      b"fn fill(a: Array<Int>, i: Int) -> Array<Int> = if i >= a.len() { a } else { fill(a.set(i, i * 2), i + 1) }\n",
      b"fill",
    ),
  );
  assert(
    !diverges(
      b"fn zero(xs: List<Int>, i: Int) -> List<Int> = if i >= xs.len() { xs } else { zero(xs.set(i, 0), i + 1) }\n",
      b"zero",
    ),
  )
}

fn declared_as(name: Bytes) -> Builtin / {abort.raise} =
  match builtin_named(name) {
    Some(b) -> b,
    None -> panic("the prelude declares `" ++ String::of_bytes(name) ++ "`"),
  }

test "a builtin is what the prelude declares: its scheme, its parameters' names and its doc" {
  let slice = declared_as(b"Bytes::slice");
  assert_eq(slice.params, [b"b", b"start", b"end"]);
  assert_eq(slice.doc, [b"Raises out of range."]);
  assert_eq(slice.scheme, {
    ty_vars: [],
    row_vars: [],
    label_vars: [],
    ty: fn_type([bytes_type(), int_type(), int_type()], bytes_type(), row_singleton(abort_atom())),
  });
  assert_eq(declared_as(b"List::len").doc, [b"How many items the list holds."]);
  assert_eq(declared_as(b"reflect").doc, [
    b"The value as a `std.value.Value`; a width below 64 bits the program does not fix reads as its",
    b"`Int`.",
  ])
}

test "every function the prelude declares has a doc" {
  assert_eq(builtins().filter(|b: Builtin| b.doc.len() == 0).map(|b: Builtin| b.name), [])
}

test "a declaration's generic list is its scheme's variables, numbered from zero" {
  assert_eq(declared_as(b"List::map").scheme, {
    ty_vars: [0, 1],
    row_vars: [0],
    label_vars: [],
    ty: fn_type(
      [list_type(TyVar(0)), fn_type([TyVar(0)], TyVar(1), row_open(0))],
      list_type(TyVar(1)),
      row_open(0),
    ),
  });
  assert_eq(
    declared_as(b"iterate").scheme.ty,
    fn_type(
      [TyVar(0), int_type(), fn_type([TyVar(0)], iter_type(TyVar(0), TyVar(1)), row_open(0))],
      TyVar(1),
      { atoms: [abort_atom()], tail: Some(0) },
    ),
  )
}

test "a declaration's `where` is what a call must show, by the parameter's place" {
  assert_eq(declared_as(b"compare").constraints, [{ deriver: DOrd, param: 0 }]);
  assert_eq(declared_as(b"numeric_of_int").constraints, [{ deriver: DNumeric, param: 0 }]);
  assert_eq(declared_as(b"List::push").constraints, [])
}

test "a cell's region is a variable of the declaration's own, after the ones it writes" {
  assert_eq(declared_as(b"cell_get").scheme, {
    ty_vars: [0, 1],
    row_vars: [],
    label_vars: [],
    ty: fn_type([TyCon({ name: b"Cell", args: [TyVar(1), TyVar(0)] })], TyVar(0), row_empty()),
  })
}

test "a type the prelude imports is the one its module declares" {
  assert_eq(
    declared_as(b"reflect").scheme.ty,
    fn_type([TyVar(0)], named_type(b"std.value.Value"), row_empty()),
  )
}

test "every builtin is in reach of a module that imports nothing" {
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Int = xs.push(1).len()\n"), [])
}

test "an `extern fn` outside a shipped module is refused" {
  assert_eq(check_codes(b"extern fn secret(x: Int) -> Int\nfn f() -> Int = 1\n"), [b"E0151"]);
  assert_eq(codes_of([{ name: b"tools.native", src: b"pub extern fn secret(x: Int) -> Int\n" }]), [
    b"E0151",
  ])
}

test "a shipped module's extern is called as its module's, and a private one only there" {
  let native = {
    name: b"std.native",
    src: b"pub type Pair<a> = | Pair(a, a)\npub extern fn doubled(x: Int) -> Int\nextern fn hidden(x: Int) -> Int\npub fn twice(x: Int) -> Int = hidden(x) + hidden(x)\npub extern fn first<a>(p: Pair<a>) -> a\n",
  };
  assert_eq(
    codes_of([
      native,
      {
        name: b"m",
        src: b"import std.native (doubled)\nimport std.native as n\nfn f() -> Int = doubled(2) + n::doubled(3) + n::twice(4)\n",
      },
    ]),
    [],
  );
  assert_eq(
    codes_of([
      native,
      { name: b"m", src: b"import std.native (hidden)\nfn f() -> Int = hidden(1)\n" },
    ]),
    [b"E0107"],
  );
  assert_eq(
    codes_of([
      native,
      { name: b"m", src: b"import std.native (doubled)\nfn f() -> Int = doubled(true)\n" },
    ]),
    [b"E0201"],
  );
  let pairs = |src: Bytes| codes_of([native, { name: b"m", src: src }]);
  assert_eq(
    pairs(b"import std.native (Pair, first)\nfn f(p: Pair<String>) -> String = first(p)\n"),
    [],
  );
  assert_eq(pairs(b"import std.native (Pair, first)\nfn f(p: Pair<String>) -> Int = first(p)\n"), [
    b"E0201",
  ])
}

test "a constant past Int's range leaves the termination check unsure rather than broken" {
  assert_eq(
    check_codes(
      b"fn up() -> Int = 9223372036854775807 + 1\nfn down() -> Int = 0 - 9223372036854775807 - 1 - 1\n",
    ),
    [],
  );
  assert(
    diverges(
      b"fn far(n: Int) -> Int = if n <= 0 { 0 } else { far(n + 9223372036854775807 + 1) }\n",
      b"far",
    ),
  )
}

test "a bound one member of a group guards holds for the loops through the others" {
  let src = b"fn nest(n: Int, d: Int) -> Int = if d >= 10 { 0 } else { inner(n, d + 1) }\nfn inner(n: Int, d: Int) -> Int = nest(n, d) + 1\n";
  assert(!diverges(src, b"nest"));
  assert(!diverges(src, b"inner"));
  assert(
    diverges(
      b"fn nest(n: Int, d: Int) -> Int = if d >= 10 { 0 } else { inner(n, d + 1) }\nfn inner(n: Int, d: Int) -> Int = nest(n, d - 1)\n",
      b"nest",
    ),
  )
}

test "a lookup folded to the part it finds answers a part, however the start holds nothing" {
  let src = |found: Bytes|
    Bytes::concat_all([
      b"type T = | Leaf | Node(List<{ key: Int, kid: T }>)\n",
      b"fn find(fs: List<{ key: Int, kid: T }>, k: Int) -> Option<T> =\n  fs.fold(None, |acc: Option<T>, f: { key: Int, kid: T }| if f.key == k { Some(",
      found,
      b") } else { acc })\n",
      b"fn depth(t: T) -> Int = match t { Leaf -> 0, Node(fs) -> match find(fs, 0) { Some(kid) -> 1 + depth(kid), None -> 0 } }\n",
    ]);
  assert(!diverges(src(b"f.kid"), b"depth"));
  assert(diverges(src(b"Node(fs)"), b"depth"))
}

test "a list written of parts, pushed or filtered or mapped to parts, is made of parts" {
  let tree = b"type T = | Leaf | Node(T, T) | Many(List<T>) | Named(List<{ name: String, value: T }>)\n";
  let walked = |name: Bytes, arms: Bytes|
    Bytes::concat_all([
      tree,
      b"fn ",
      name,
      b"(t: T) -> Bool = {\n  let any = |xs: List<T>| xs.fold(false, |acc: Bool, x: T| acc || ",
      name,
      b"(x));\n  match t { Leaf -> true, ",
      arms,
      b" }\n}\n",
    ]);
  assert(!diverges(walked(b"listed", b"Node(l, r) -> any([l, r]), _ -> false"), b"listed"));
  assert(!diverges(walked(b"pushed", b"Node(l, r) -> any([l].push(r)), _ -> false"), b"pushed"));
  assert(
    !diverges(walked(b"kept", b"Many(xs) -> any(xs.filter(|x: T| true)), _ -> false"), b"kept"),
  );
  assert(
    !diverges(
      walked(
        b"projected",
        b"Named(fs) -> any(fs.map(|f: { name: String, value: T }| f.value)), _ -> false",
      ),
      b"projected",
    ),
  );
  // Pushing the value itself makes a list one of whose elements is not smaller.
  assert(diverges(walked(b"again", b"Many(xs) -> any(xs.push(t)), _ -> false"), b"again"))
}

/// Where a site's call is in the source the checker read, as an offset.
fn offset_of(cx: Checker, s: Site) -> Int / {abort.raise} =
  match def_of(cx, s.caller) {
    Some(d) -> d.at.span.start + s.span.start,
    None -> panic("the definition the site names"),
  }

/// Where the call is by which a definition of `src` may not return, as an offset.
fn diverging_at(src: Bytes, name: Bytes) -> Option<Int> / {abort.raise} = {
  let cx = checked_cx(src);
  match def_of(cx, b"m.".concat(name)) {
    Some(d) -> match d.ending { Diverges(x) -> Some(offset_of(cx, x.at)), _ -> None },
    None -> panic("the definition the test names"),
  }
}

test "a member of a group that may not return is told first by its own call out" {
  let src = b"fn spin(n: Int) -> Int = spin(n)\nfn a(n: Int) -> Int = if n <= 0 { spin(n) } else { b(n - 1) }\nfn b(n: Int) -> Int = if n <= 0 { a(n) } else { c(n) }\nfn c(n: Int) -> Int = b(n)\n";
  assert_eq(diverging_at(src, b"a"), src.index_of(b"spin(n) }"));
  // `b` and `c` loop, and are told by that loop rather than by `a`'s call out.
  assert(diverging_at(src, b"b") != diverging_at(src, b"a"));
  assert_eq(diverging_at(src, b"b"), diverging_at(src, b"c"))
}

test "a list rebuilt of parts, a fallback a block takes, and a failure `?` passes on are no smaller" {
  // `List::map` rebuilds a list of one part a hundred times, and a tail of it is no part of `xs`.
  assert(
    diverges(
      b"fn copies(xs: List<List<Int>>) -> Int = match xs { [h, ..] -> match range(0, 100).map(|i: Int| h) { [_, ..rest] -> copies(rest), [] -> 0 }, [] -> 0 }\n",
      b"copies",
    ),
  );
  let second = b"fn second(xs: List<List<Int>>) -> List<List<Int>> / {abort.raise} = match xs { [_, ..r] -> r, [] -> panic(\"empty\") }\n";
  assert(
    diverges(
      second.concat(
        b"fn copies(xs: List<List<Int>>) -> Int / {abort.raise} = match xs { [h, ..] -> copies(second(range(0, 100).map(|i: Int| h))), [] -> 0 }\n",
      ),
      b"copies",
    ),
  );
  assert(
    !diverges(
      second.concat(
        b"fn walk(xs: List<List<Int>>) -> Int / {abort.raise} = match xs { [] -> 0, [_, ..] -> walk(second(xs)) }\n",
      ),
      b"walk",
    ),
  );
  // Where the pattern fails the block answers `xs` itself.
  assert(
    diverges(
      b"fn skip(xs: List<Int>) -> Int = if xs.len() == 0 { 0 } else { skip({ let [_, _, ..rest] = xs else { xs }; rest }) }\n",
      b"skip",
    ),
  );
  assert(
    diverges(
      b"fn drop2(xs: List<Int>) -> List<Int> = { let [_, _, ..rest] = xs else { xs }; rest }\nfn skip(xs: List<Int>) -> Int = if xs.len() == 0 { 0 } else { skip(drop2(xs)) }\n",
      b"skip",
    ),
  );
  assert(
    !diverges(
      b"fn drop2(xs: List<Int>) -> List<Int> / {abort.raise} = { let [_, _, ..rest] = xs else { panic(\"short\") }; rest }\nfn skip(xs: List<Int>) -> Int / {abort.raise} = if xs.len() < 2 { 0 } else { skip(drop2(xs)) }\n",
      b"skip",
    ),
  );
  // `r?` answers `r`'s failure, which is no part of `xs`, through the arm it is expanded to.
  assert(
    diverges(
      b"fn pick(r: Result<Int, List<Int>>, xs: List<Int>) -> Result<Int, List<Int>> / {abort.raise} = { let _ = r?; match xs { [_, ..rest] -> Err(rest), [] -> panic(\"empty\") } }\nfn spin(xs: List<Int>) -> Int / {abort.raise} = match pick(Err(xs), xs) { Err(e) -> spin(e), Ok(_) -> 0 }\n",
      b"spin",
    ),
  );
  // A remainder by `m` is one term whatever it divides, so it measures nothing.
  assert(
    diverges(
      b"fn slide(a: Int, m: Int, n: Int) -> Int / {abort.raise} = if a % m < n { slide(a - 1, m, n - 1) } else { 0 }\n",
      b"slide",
    ),
  )
}

test "a value an `if` chooses, an element a helper finds, and a list made of parts descend" {
  let tree = b"type T = | Leaf | Node(T, T) | Many(List<T>)\n";
  // The value an `if` answers is a part on either branch.
  assert(
    !diverges(
      tree.concat(
        b"fn left(t: T) -> Int = match t { Node(l, r) -> left(if l == Leaf { r } else { l }), _ -> 0 }\n",
      ),
      b"left",
    ),
  );
  // A helper that answers an element answers an element of a list rebuilt of parts, too.
  let pick = b"fn pick(xs: List<T>, i: Int) -> T / {abort.raise} = match xs.at(i) { Some(x) -> x, None -> panic(\"none\") }\n";
  assert(
    !diverges(
      Bytes::concat_all([
        tree,
        pick,
        b"fn first(t: T) -> Int / {abort.raise} = match t { Many(kids) -> if kids.len() == 0 { 0 } else { first(pick(kids.map(|k: T| k), 0)) }, _ -> 0 }\n",
      ]),
      b"first",
    ),
  );
  // Each element of a list written or mapped of parts is smaller than the value they are parts of.
  let shapes = b"fn shape(t: T) -> Int = match t { Leaf -> 1, Node(a, b) -> shapes([a, b]), Many(ts) -> shapes(ts.map(|x: T| x)) }\nfn shapes(ts: List<T>) -> Int = ts.fold(0, |n: Int, x: T| n + shape(x))\n";
  assert(!diverges(tree.concat(shapes), b"shape"));
  assert(!diverges(tree.concat(shapes), b"shapes"));
  // A list holding the value itself has an element no smaller.
  assert(
    diverges(
      tree.concat(
        b"fn shape(t: T) -> Int = match t { Leaf -> 1, Node(a, b) -> shapes([a, t]), Many(ts) -> shapes(ts) }\nfn shapes(ts: List<T>) -> Int = ts.fold(0, |n: Int, x: T| n + shape(x))\n",
      ),
      b"shape",
    ),
  )
}

test "a map's keys and values handed to `Map::fold`'s callback are parts of the map" {
  let tree = b"type T = | Leaf | Node(Map<Int, T>)\n";
  assert(
    !diverges(
      tree.concat(
        b"fn size(t: T) -> Int = match t { Node(kids) -> kids.fold(1, |n: Int, k: Int, c: T| n + size(c)), Leaf -> 1 }\n",
      ),
      b"size",
    ),
  );
  // What the callback is handed besides is no part of it.
  assert(
    diverges(
      tree.concat(
        b"fn worse(t: T) -> Int = match t { Node(kids) -> kids.fold(0, |n: Int, k: Int, c: T| n + worse(t)), Leaf -> 0 }\n",
      ),
      b"worse",
    ),
  )
}

test "lambdas bound by `let` are read where they are called, so many deep and no deeper" {
  // `l0` calls `down`; each later lambda calls the one before it, and `down` calls the last.
  let chain = |n: Int|
    Bytes::concat_all([
      b"fn down(n: Int) -> Int = {\n  let l0 = |x: Int| down(x);\n",
      Bytes::concat_all(
        range(1, n).map(|i: Int|
          Bytes::concat_all([
            b"  let l",
            ascii_of_int(i),
            b" = |x: Int| l",
            ascii_of_int(i - 1),
            b"(x);\n",
          ])),
      ),
      b"  if n <= 0 { 0 } else { l",
      ascii_of_int(n - 1),
      b"(n - 1) }\n}\n",
    ]);
  assert(!diverges(chain(8), b"down"));
  assert(diverges(chain(9), b"down"))
}

test "a function an `if` chooses is handed on as each branch is, and a loop that does not descend is told by its calls" {
  let each = b"type In = { room: Int }\nfn each(i: In, n: Int, f: (In, Int) -> Int) -> Int = range(0, n).fold(0, |acc: Int, k: Int| acc + f(i, k))\nfn top(i: In, k: Int) -> Int = if i.room <= 0 { 0 } else { inner({ ..i, room: i.room - 1 }, k) }\n";
  assert(
    !diverges(
      each.concat(
        b"fn inner(i: In, k: Int) -> Int = each(i, 3, if k > 1 { top } else { other })\nfn other(i: In, k: Int) -> Int = top(i, k)\n",
      ),
      b"top",
    ),
  );
  // Each call of the loop, in order from where it starts.
  let src = b"fn ping(n: Int) -> Int = pong(n)\nfn pong(n: Int) -> Int = if n <= 0 { 0 } else { ping(n) }\n";
  let cx = checked_cx(src);
  match def_of(cx, b"m.ping") {
    Some(d) -> match d.ending {
      Diverges(x) ->
        assert_eq(x.loop.map(|s: Site| offset_of(cx, s)), [
          match src.index_of(b"pong(n)\n") { Some(i) -> i, None -> -1 },
          match src.index_of(b"ping(n) }") { Some(i) -> i, None -> -1 },
        ]),
      _ -> assert(false),
    },
    None -> assert(false),
  }
}

test "a value with no parts is no larger than any" {
  // `step` is only ever handed `None`, so its `Some` arm adds nothing a loop could grow by.
  assert(
    !diverges(
      b"type T = | Leaf | Node(T, T)\nfn walk(t: T) -> Int = match t { Node(l, r) -> step(l, None), Leaf -> 0 }\nfn step(t: T, extra: Option<T>) -> Int = match extra { Some(e) -> walk(e), None -> walk(t) }\n",
      b"walk",
    ),
  )
}

test "a constructor of one field around a part is no larger than what that is a part of" {
  let tree = b"type T = | Leaf | Node(List<T>)\n";
  assert(
    !diverges(
      tree.concat(
        b"fn kind(t: Option<T>) -> Int = match t { Some(Node(ts)) -> kinds(ts), _ -> 0 }\nfn kinds(ts: List<T>) -> Int = ts.fold(0, |n: Int, x: T| n + kind(Some(x)))\n",
      ),
      b"kind",
    ),
  );
  // Wrapping the value in more than it was grows it.
  assert(
    diverges(
      tree.concat(
        b"fn grow(t: Option<T>) -> Int = match t { Some(x) -> grow(Some(Node([x]))), None -> 0 }\n",
      ),
      b"grow",
    ),
  )
}

test "what a recursive definition answers is read to a fixed point over its group" {
  let tree = b"type T = | Leaf | Node(List<T>)\nfn last(xs: List<T>) -> T / {abort.raise} = match xs { [x] -> x, [_, ..rest] -> last(rest), [] -> panic(\"empty\") }\n";
  assert(
    !diverges(
      tree.concat(
        b"fn depth(t: T) -> Int / {abort.raise} = match t { Node(kids) -> if kids.len() == 0 { 0 } else { 1 + depth(last(kids)) }, Leaf -> 0 }\n",
      ),
      b"depth",
    ),
  );
  // A definition that answers its argument whole answers nothing smaller.
  assert(
    diverges(
      b"type T = | Leaf | Node(List<T>)\nfn same(t: T, n: Int) -> T = if n <= 0 { t } else { same(t, n - 1) }\nfn spin(t: T) -> Int = match t { Node(_) -> spin(same(t, 3)), Leaf -> 0 }\n",
      b"spin",
    ),
  )
}

test "a row may write diverges, the atom of a call that may not return" {
  assert_eq(check_codes(b"fn spin(n: Int) -> Int / {diverges} = spin(n)\n"), []);
  assert_eq(
    check_codes(
      b"fn spin(n: Int) -> Int / {diverges} = spin(n)\nfn use(n: Int) -> Int / {diverges} = spin(n)\n",
    ),
    [],
  );
  // `div` names an effect set like any other name, and none is declared.
  assert_eq(check_codes(b"fn spin(n: Int) -> Int / {div} = spin(n)\n"), [b"E0114"])
}

test "a numeric names a total function of its own sum for each operation, once" {
  let ops = b"fn add(a: N, b: N) -> N = a\nfn neg(a: N) -> N = a\nfn of(n: Int) -> N = N(n)\nfn bad(a: N, b: N) -> N / {abort.raise} = panic(\"no\")\n";
  let stated = |record: Bytes|
    check_codes(
      Bytes::concat_all([b"type N = | N(Int)\n", ops, b"numeric for N by ", record, b"\n"]),
    );
  let all = b"{ add: add, sub: add, mul: add, neg: neg, of_int: of }";
  assert_eq(stated(all), []);
  assert_eq(stated(Bytes::concat_all([all, b"\nnumeric for N by ", all])), [b"E0105"]);
  assert_eq(stated(b"{ add: add, sub: add, mul: add, neg: neg }"), [b"E0215"]);
  assert_eq(stated(b"{ add: add, sub: add, mul: add, neg: neg, of_int: of, div: add }"), [
    b"E0215",
  ]);
  assert_eq(stated(b"{ add: add, add: add, sub: add, mul: add, neg: neg, of_int: of }"), [
    b"E0215",
  ]);
  assert_eq(stated(b"{ add: add, sub: add, mul: add, neg: neg, of_int: gone }"), [b"E0101"]);
  // Each operation has one shape, and a row that is empty: `a + b` gains none.
  assert_eq(stated(b"{ add: neg, sub: add, mul: add, neg: neg, of_int: of }"), [b"E0218"]);
  assert_eq(stated(b"{ add: add, sub: add, mul: add, neg: neg, of_int: neg }"), [b"E0218"]);
  assert_eq(stated(b"{ add: bad, sub: add, mul: add, neg: neg, of_int: of }"), [b"E0218"]);
  // The type is this module's own sum, and takes no parameter a value could not say.
  assert_eq(check_codes(b"numeric for Option by { add: f }\n"), [b"E0208"]);
  assert_eq(check_codes(b"type N = Int\nnumeric for N by { add: f }\n"), [b"E0217"]);
  assert_eq(check_codes(b"type N = new { n: Int }\nnumeric for N by { add: f }\n"), [b"E0217"]);
  assert_eq(check_codes(b"type N<a> = | N(a)\nnumeric for N by { add: f }\n"), [b"E0216"])
}

test "an operator at a type that states numeric is its function, and what it does not state is refused" {
  let n = b"type N = | N(Int)\nfn add(a: N, b: N) -> N = a\nfn neg(a: N) -> N = a\nfn of(n: Int) -> N = N(n)\nnumeric for N by { add: add, sub: add, mul: add, neg: neg, of_int: of }\n";
  let keyed = n.concat(b"fn k(a: N) -> Int = 0\nkey for N by k\n");
  let over = |src: Bytes, body: Bytes| check_codes(src.concat(body));
  assert_eq(over(n, b"fn f(a: N, b: N) -> N = a + b * a - -b"), []);
  assert_eq(over(n, b"fn f(a: N, b: N) -> N / {abort.raise} = a / b"), [b"E0201"]);
  assert_eq(over(n, b"fn f(a: N, b: N) -> N / {abort.raise} = a % b"), [b"E0201"]);
  // A type is ordered by its `key`.
  assert_eq(over(n, b"fn f(a: N, b: N) -> Bool = a < b"), [b"E0201"]);
  assert_eq(over(keyed, b"fn f(a: N, b: N) -> Bool = a < b && a >= b"), []);
  // A literal is an `Int`, and nothing converts it.
  assert_eq(over(n, b"fn f(a: N) -> N = a + 1"), [b"E0201"]);
  // `numeric(a)` holds the ordered comparisons, so it takes the type that states a `key` too.
  let sum = b"fn sum<a>(xs: List<a>) -> a where numeric(a) = xs.fold(numeric_of_int(0), |s: a, x: a| s + x)\n";
  assert_eq(over(keyed.concat(sum), b"fn f(xs: List<N>) -> N = sum(xs)"), []);
  assert_eq(over(n.concat(sum), b"fn f(xs: List<N>) -> N = sum(xs)"), [b"E0201"]);
  assert_eq(
    over(
      keyed,
      b"fn half<a>(x: a) -> a / {abort.raise} where integer(a) = x / numeric_of_int(2)\nfn f(a: N) -> N / {abort.raise} = half(a)",
    ),
    [b"E0201"],
  );
  // `%` is no operator of every numeric type, as `/` is none.
  assert_eq(check_codes(b"fn f<a>(x: a) -> a / {abort.raise} where numeric(a) = x % x"), [
    b"E0209",
  ]);
  assert_eq(check_codes(b"fn f<a>(x: a) -> a / {abort.raise} where integer(a) = x % x"), [])
}

test "a wrapping or saturating operator is its builtin, over a builtin integer type and no other" {
  assert_eq(check_codes(b"fn f(a: U8, b: U8) -> U8 = a +% b *| a -| b -% a *% b +| a"), []);
  assert_eq(check_codes(b"fn f(a: Int, b: Int) -> Int = a +| b *% a"), []);
  assert_eq(check_codes(b"fn f(a: U8, b: U16) -> U8 = a +% b"), [b"E0201"]);
  assert_eq(
    check_diags(b"fn f(a: Float, b: Float) -> Float = a +% b").map(|diag: Diag| diag.message),
    [b"`+%` is not defined on `Float`"],
  );
  assert_eq(
    check_diags(b"fn f(a: Float, b: Float) -> Float = wrap_add(a, b)").map(|diag: Diag|
      diag.message),
    [b"`wrap_add` is not defined on `Float`"],
  );
  // The builtin is called at a type the call settles, never at a type parameter.
  assert_eq(check_codes(b"fn f<a>(x: a, y: a) -> a where integer(a) = x *| y"), [b"E0210"]);
  let n = b"type N = | N(Int)\nfn add(a: N, b: N) -> N = a\nfn neg(a: N) -> N = a\nfn of(n: Int) -> N = N(n)\nnumeric for N by { add: add, sub: add, mul: add, neg: neg, of_int: of }\n";
  let over = |body: Bytes| check_codes(n.concat(body));
  assert_eq(over(b"fn f(a: N, b: N) -> N = a +% b"), [b"E0223"]);
  assert_eq(over(b"fn f(a: N, b: N) -> N = a -| b"), [b"E0223"]);
  assert_eq(over(b"fn f(a: N, b: N) -> N = wrap_mul(a, b)"), [b"E0223"]);
  assert_eq(over(b"fn f(a: N, b: N) -> Option<N> = checked_add(a, b)"), [b"E0223"]);
  assert_eq(over(b"fn f(a: N) -> N = rotl(a, 1)"), [b"E0223"]);
  // The bit operators are no builtin's call, and stay a mismatch.
  assert_eq(over(b"fn f(a: N, b: N) -> N = a & b"), [b"E0201", b"E0201"])
}

test "the builtins the operators are written in belong to no module and no binding around one" {
  assert_eq(check_codes(b"fn wrap_add(a: Int, b: Int) -> Int = 0"), [b"E0105"]);
  assert_eq(check_codes(b"fn saturating_mul(a: Int, b: Int) -> Int = 0"), [b"E0105"]);
  assert_eq(
    check_codes(b"fn rotl(a: Int, b: Int) -> Int = 0\nfn checked_add(a: Int) -> Int = a"),
    [],
  );
  let hidden = b"fn f(wrap_add: (Int, Int) -> Int, a: Int) -> Int = ";
  assert_eq(check_codes(hidden.concat(b"a +% a")), [b"E0105"]);
  assert_eq(check_codes(hidden.concat(b"wrap_add(a, a)")), []);
  assert_eq(check_codes(hidden.concat(b"a -% a")), []);
  assert_eq(
    check_codes(b"fn f(a: Int) -> Int = { let saturating_sub = 1; a -| saturating_sub }"),
    [b"E0105", b"E0204"],
  )
}

test "to_int reads any integer type, and no other" {
  assert_eq(
    check_codes(
      b"fn f(a: U8, b: I128, c: Int) -> List<Option<Int>> = [to_int(a), to_int(b), to_int(c)]",
    ),
    [],
  );
  assert_eq(check_codes(b"fn f<a>(x: a) -> Option<Int> where integer(a) = to_int(x)"), []);
  assert_eq(check_codes(b"fn f(a: Float) -> Option<Int> = to_int(a)"), [b"E0201"]);
  assert_eq(check_codes(b"fn f<a>(x: a) -> Option<Int> where numeric(a) = to_int(x)"), [b"E0201"]);
  assert_eq(check_codes(b"fn f<a>(x: a) -> Option<Int> = to_int(x)"), [b"E0201"])
}

test "a key is stated once, by its type's own module, for a sum" {
  let box = b"type Box = | Box(Int, Int)\nfn area(b: Box) -> Int = match b { Box(w, h) -> w * h }\n";
  assert_eq(check_codes(box.concat(b"key for Box by area\n")), []);
  assert_eq(check_codes(box.concat(b"key for Box by area\nkey for Box by area\n")), [b"E0105"]);
  assert_eq(check_codes(box.concat(b"key for Box by size\n")), [b"E0101"]);
  assert_eq(check_codes(b"fn f(o: Option<Int>) -> Int = 0\nkey for Option by f\n"), [b"E0208"]);
  assert_eq(check_codes(b"fn f(n: Int) -> Int = n\ntype Id = Int\nkey for Id by f\n"), [b"E0217"]);
  assert_eq(check_codes(b"type P = { x: Int }\nfn f(p: P) -> Int = p.x\nshow for P by f\n"), [
    b"E0217",
  ]);
  // A `new` record is a type of its own that a value does not carry the name of.
  let record = b"type P = new { x: Int }\nfn f(p: P) -> Int = p.x\nfn g(p: P) -> String = \"p\"\n";
  assert_eq(check_codes(record.concat(b"key for P by f\n")), [b"E0217"]);
  assert_eq(check_codes(record.concat(b"show for P by g\n")), [b"E0217"]);
  // A type takes a key and a show, each once.
  assert_eq(
    check_codes(
      box.concat(
        b"fn text(b: Box) -> String = \"box\"\nkey for Box by area\nshow for Box by text\n",
      ),
    ),
    [],
  )
}

test "the function a key or a show names takes the value alone and only answers" {
  let over = |f: Bytes, stated: Bytes|
    check_codes(Bytes::concat_all([b"type Box<a> = | Box(a, Int)\n", f, b"\n", stated, b"\n"]));
  assert_eq(
    over(b"fn k<a>(b: Box<a>) -> Int = match b { Box(_, n) -> n }", b"key for Box by k"),
    [],
  );
  assert_eq(
    over(b"fn k<a>(b: Box<a>) -> List<a> = match b { Box(x, _) -> [x] }", b"key for Box by k"),
    [],
  );
  assert_eq(over(b"fn k<a>(b: Box<a>, n: Int) -> Int = n", b"key for Box by k"), [b"E0218"]);
  assert_eq(over(b"fn k(b: Box<Int>) -> Int = 0", b"key for Box by k"), [b"E0218"]);
  assert_eq(over(b"fn k<a>(b: List<a>) -> Int = 0", b"key for Box by k"), [b"E0218"]);
  assert_eq(over(b"fn k<a, b>(x: Box<a>) -> List<b> = []", b"key for Box by k"), [b"E0218"]);
  assert_eq(
    over(b"fn k<a>(b: Box<a>) -> Int / {abort.raise} = panic(\"no\")", b"key for Box by k"),
    [b"E0218"],
  );
  assert_eq(over(b"fn k<a>(b: Box<a>) -> Int / {diverges} = k(b)", b"key for Box by k"), [
    b"E0218",
  ]);
  // A raise of its own is a row as `abort.raise` is: where two keys are compared, it has no handler.
  assert_eq(
    over(
      b"effect odd {\n  raise found(n: Int)\n}\nfn k<a>(b: Box<a>) -> Int / {odd.found} = match b { Box(_, n) -> if n > 0 { n } else { odd.found(n) } }",
      b"key for Box by k",
    ),
    [b"E0218"],
  );
  assert_eq(
    over(
      b"fn k<a>(b: Box<a>) -> a where numeric(a) = match b { Box(x, _) -> x + x }",
      b"key for Box by k",
    ),
    [b"E0218"],
  );
  assert_eq(over(b"fn s<a>(b: Box<a>) -> String = \"box\"", b"show for Box by s"), []);
  assert_eq(over(b"fn s<a>(b: Box<a>) -> Int = 0", b"show for Box by s"), [b"E0218"])
}

test "a key's function is at the type's own rows, and a type that binds a label states none" {
  let keyed = |ty: Bytes, f: Bytes|
    check_codes(Bytes::concat_all([ty, b"\n", f, b"\nkey for T by k\n"]));
  let hook = b"type T<a | e> = | T(Int, (a) -> Unit / e)";
  assert_eq(keyed(hook, b"fn k<a | e>(t: T<a | e>) -> Int = match t { T(n, _) -> n }"), []);
  assert_eq(keyed(hook, b"fn k<a>(t: T<a | {}>) -> Int = 0"), [b"E0218"]);
  let pipe = b"type T<| e, f> = | T(() -> Unit / e, () -> Unit / f)";
  assert_eq(keyed(pipe, b"fn k<| e, f>(t: T<| e, f>) -> Int = 0"), []);
  assert_eq(keyed(pipe, b"fn k<| e>(t: T<| e, e>) -> Int = 0"), [b"E0218"]);
  // A value does not carry the label its type was given, so nothing could call `k` at it.
  let sink = b"effect log {\n  write note[l](line: String) -> Unit\n}\ntype T<[l]> = | T((String) -> Unit / {log.note[l]}) | Quiet";
  assert_eq(keyed(sink, b"fn k<[l]>(t: T<[l]>) -> Int = 0"), [b"E0218"]);
  assert_eq(keyed(sink, b"fn k(t: T<[app]>) -> Int = 0"), [b"E0218"])
}

test "a declared type that keys a `Map` by its parameter carries the parameter's order into each signature naming it" {
  let bag = b"type Bag<a> = | Bag(Map<a, Int>)\n";
  // Taken, the order is assumed in the body; answered, a caller is held to it.
  assert_eq(
    check_codes(bag.concat(b"fn size<a>(b: Bag<a>) -> Int = match b { Bag(m) -> m.len() }\n")),
    [],
  );
  assert_eq(
    check_codes(
      bag.concat(b"fn none<a>() -> Bag<a> = Bag(Map::new())\nfn floats() -> Bag<Float> = none()\n"),
    ),
    [b"E0206"],
  );
  // Through a `new` record, and through a declaration holding one in a list.
  assert_eq(
    check_codes(
      b"type Ranked<a> = new { by: Map<a, Int> }\ntype Held<a> = | Held(List<Ranked<a>>)\nfn first<a>(h: Held<a>) -> Int = match h { Held(rs) -> match rs.at(0) { Some(r) -> r.by.len(), None -> 0 } }\n",
    ),
    [],
  );
  // A parameter a declaration holds without keying a `Map` by it carries nothing.
  assert_eq(
    check_codes(b"type Box<a> = | Box(a)\nfn keyed<a>(b: Box<a>) -> Map<a, Int> = Map::new()\n"),
    [b"E0206"],
  );
  // A `key` and a `show` name functions the type's order is carried into, with no `where`.
  assert_eq(
    check_codes(
      bag.concat(
        b"key for Bag by items\nshow for Bag by shown\nfn items<a>(b: Bag<a>) -> Map<a, Int> = match b { Bag(m) -> m }\nfn shown<a>(b: Bag<a>) -> String = items(b).len().to_string()\n",
      ),
    ),
    [],
  )
}

test "a key answers a type that is ordered and hashed, and that does not hold its own" {
  let keyed = |ret: Bytes, body: Bytes|
    check_codes(
      Bytes::concat_all([
        b"type T = | T(Int)\ntype Holder = | Holder(T)\nfn k(t: T) -> ",
        ret,
        b" = ",
        body,
        b"\nkey for T by k\n",
      ]),
    );
  assert_eq(keyed(b"Int", b"0"), []);
  assert_eq(keyed(b"Float", b"0.0"), [b"E0206"]);
  assert_eq(keyed(b"(Int) -> Int", b"|n: Int| n"), [b"E0206"]);
  assert_eq(keyed(b"T", b"t"), [b"E0219"]);
  assert_eq(keyed(b"List<Holder>", b"[Holder(t)]"), [b"E0219"]);
  // Through another type's key.
  assert_eq(
    check_codes(
      b"type A = | A(Int)\ntype B = | B(Int)\nfn a(x: A) -> B = B(0)\nfn b(x: B) -> A = A(0)\nkey for A by a\nkey for B by b\n",
    ),
    [b"E0219", b"E0219"],
  );
  // Through a `new` record, which is compared field by field.
  assert_eq(
    check_codes(
      b"type T = | T(Int)\ntype Kept = new { t: T }\nfn k(t: T) -> Kept = { t: t }\nkey for T by k\n",
    ),
    [b"E0219"],
  );
  // A key that answers a keyed type is read through both, which is no loop.
  assert_eq(
    check_codes(
      b"type A = | A(Int)\ntype B = | B(A)\nfn a(x: A) -> Int = 0\nfn b(x: B) -> A = A(0)\nkey for A by a\nkey for B by b\n",
    ),
    [],
  )
}

test "a type that states a key is ordered, hashed and derived as its key is, whatever it holds" {
  let held = |stated: Bytes, used: Bytes|
    check_codes(
      Bytes::concat_all([
        b"type Reading = | Reading(Float, Int)\nfn tick(r: Reading) -> Int = match r { Reading(_, n) -> n }\n",
        stated,
        b"\n",
        used,
        b"\n",
      ]),
    );
  let keyed = b"key for Reading by tick";
  assert_eq(held(b"", b"fn m(r: Reading) -> Map<Reading, Int> = #{r: 1}"), [b"E0206"]);
  assert_eq(held(keyed, b"fn m(r: Reading) -> Map<Reading, Int> = #{r: 1}"), []);
  assert_eq(held(b"", b"fn c(r: Reading) -> Ordering = compare(r, r)"), [b"E0206"]);
  assert_eq(held(keyed, b"fn c(r: Reading) -> Ordering = compare(r, r)"), []);
  assert_eq(held(keyed, b"fn d(r: Reading) -> Bytes = digest([Some(r)])"), []);
  assert_eq(
    held(keyed, b"derive ord for Reading\nderive hash for Reading\nderive eq for Reading"),
    [],
  );
  // A show is no key.
  assert_eq(
    held(
      b"fn text(r: Reading) -> String = \"r\"\nshow for Reading by text",
      b"fn c(r: Reading) -> Ordering = compare(r, r)",
    ),
    [b"E0206"],
  )
}

test "a `forall` ranges over an opaque type another module declares" {
  let vault = {
    name: b"vault",
    src: b"pub opaque type Coin = | Heads | Tails\npub opaque type Purse<a> = | Purse(List<a>)\n",
  };
  let over = |law: Bytes|
    codes_across([vault, { name: b"app", src: b"import vault (Coin, Purse)\n".concat(law) }]);
  assert_eq(over(b"law \"l\" forall (c: Coin, cs: List<Coin>) { c == c }"), []);
  assert_eq(over(b"law \"l\" forall (p: Purse<Coin>) { p == p }"), []);
  // A binder's type opens nothing: the constructor is still its module's alone.
  assert_eq(over(b"law \"l\" forall (c: Coin) { c == Heads }"), [b"E0107"])
}

test "a `forall` never ranges over a `Hold`, alone or inside another type" {
  assert_eq(check_codes(b"law \"l\" forall (h: Hold<Int, [r]>) { true }"), [b"E0418"]);
  assert_eq(check_codes(b"law \"l\" forall (hs: List<Hold<Int, [r]>>) { hs.len() >= 0 }"), [
    b"E0418",
  ]);
  assert_eq(
    check_codes(b"type Kept<t> = | Kept(t)\nlaw \"l\" forall (k: Kept<Hold<Int, [r]>>) { true }"),
    [b"E0418"],
  )
}

test "a hold of an opaque value is read where the value's module is called, and released by it" {
  let over = |app: Bytes|
    codes_across([
      {
        name: b"vault",
        src: b"pub opaque type Token = | Token(Int)\npub fn mint(n: Int) -> Token = Token(n)\npub fn spend(t: Token) -> Unit = ()\npub fn worth(t: Token) -> Int = match t { Token(n) -> n }\n",
      },
      { name: b"app", src: b"import vault (Token, mint, spend, worth)\n".concat(app) },
    ]);
  assert_eq(
    over(b"fn spent(n: Int) -> Int = with_hold[t](mint(n), spend) { h -> worth(h.get()) }"),
    [],
  );
  assert_eq(over(b"fn peek<[r]>(h: Hold<Token, [r]>) -> Int / {hold.read[r]} = worth(h.get())"), [
  ]);
  // Holding one opens nothing: its constructor is still its module's alone.
  assert_eq(
    over(
      b"fn opened(n: Int) -> Int = with_hold[t](mint(n), spend) { h -> match h.get() { Token(k) -> k } }",
    ),
    [b"E0107"],
  );
  // What `Hold::get` answers is a value like any other, so it may leave where the hold may not: a
  // module that must not see its value used after the release keeps the value's uses to itself.
  assert_eq(over(b"fn kept(n: Int) -> Token = with_hold[t](mint(n), spend) { h -> h.get() }"), [])
}

test "a `Columns` holds a record type of at least one field wherever its type settles" {
  assert_eq(
    check_codes(
      b"type P = { x: Float, y: Float }\nfn f(xs: List<P>) -> Columns<P> = Columns::of_list(xs)\n",
    ),
    [],
  );
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Columns<Int> = Columns::of_list(xs)\n"), [
    b"E0224",
  ]);
  assert_eq(check_codes(b"fn f(xs: List<{}>) -> Columns<{}> = Columns::of_list(xs)\n"), [b"E0224"]);
  // A type parameter is its callers' to settle.
  let generic = b"fn f<a>(xs: List<a>) -> Columns<a> = Columns::of_list(xs)\n";
  assert_eq(check_codes(generic), []);
  assert_eq(check_codes(generic.concat(b"fn g(xs: List<Int>) -> Int = f(xs).len()\n")), [b"E0224"])
}

/// A type `N` whose `+`, `-` and `*` are `add`, written as `add`, and what follows it.
fn stating_add(add: Bytes, rest: Bytes) -> Bytes =
  Bytes::concat_all([
    b"type N = | Z | S(N)\nfn add(a: N, b: N) -> N = ",
    add,
    b"\nfn neg(a: N) -> N = a\nfn of(n: Int) -> N = Z\nnumeric for N by { add: add, sub: add, mul: add, neg: neg, of_int: of }\n",
    rest,
  ])

test "an operator at a type that states its arithmetic is a call of the function it states" {
  // A recursion through `+` descends as one through the name does.
  assert_eq(check_codes(stating_add(b"match a { Z -> b, S(m) -> S(m + b) }", b"")), []);
  assert_eq(check_codes(stating_add(b"match a { Z -> b, S(m) -> S(add(m, b)) }", b"")), []);
  assert(
    refused_with(
      stating_add(b"a + b", b""),
      b"E0302",
      b"`add` may not return, and its row does not say so",
    ),
  );
  assert_eq(check_codes(stating_add(b"a - b", b"")), [b"E0302"]);
  // `-a` is `neg`, which is another function and ends.
  assert_eq(check_codes(stating_add(b"match a { Z -> -b, S(m) -> m }", b"")), [])
}

test "a comparison, a `Map` and a constrained parameter at a type that states a key or a show call it" {
  let keyed = |k: Bytes|
    check_codes(
      Bytes::concat_all([b"type T = | T(Int)\nfn k(t: T) -> Int = ", k, b"\nkey for T by k\n"]),
    );
  assert_eq(keyed(b"match t { T(n) -> n }"), []);
  assert_eq(keyed(b"if t == t { 1 } else { 0 }"), [b"E0302"]);
  // Through what holds one, and through a builtin that orders or keys by one.
  assert_eq(keyed(b"if [t] == [t] { 1 } else { 0 }"), [b"E0302"]);
  assert_eq(keyed(b"match compare(t, t) { Equal -> 1, _ -> 0 }"), [b"E0302"]);
  assert_eq(keyed(b"Map::new().insert(t, 1).len()"), [b"E0302"]);
  let shown = |s: Bytes|
    check_codes(
      Bytes::concat_all([
        b"type T = | T(Int)\nfn written<a>(x: a) -> String where derivable(show, a) = \"\"\nfn s(t: T) -> String = ",
        s,
        b"\nshow for T by s\n",
      ]),
    );
  assert_eq(shown(b"match t { T(n) -> written(n) }"), []);
  assert_eq(shown(b"written([t])"), [b"E0302"]);
  // A definition that only uses the operator is in no recursion with what the type states.
  assert_eq(
    check_codes(
      b"type T = | T(Int)\nfn k(t: T) -> Int = 0\nkey for T by k\nfn same(a: T, b: T) -> Bool = a == b\n",
    ),
    [],
  )
}

test "a body in a recursion through an operator performs everything again there" {
  // `add` answers `noted`'s query itself, and `noted` adds: the two call one another through `+`.
  let through = db_source(
    stating_add(
      b"match a { Z -> b, S(m) -> handle { noted(m, b) } with { db.query[conn](sql) -> 0 } }",
      b"fn noted(a: N, b: N) -> N / {db.query[conn] bounded} = { lookup(1); a + b }\n",
    ),
  );
  assert_eq(check_codes(through), [b"E0465"]);
  // Called by name the recursion is the same one.
  let named = db_source(
    stating_add(
      b"match a { Z -> b, S(m) -> handle { noted(m, b) } with { db.query[conn](sql) -> 0 } }",
      b"fn noted(a: N, b: N) -> N / {db.query[conn] bounded} = { lookup(1); add(a, b) }\n",
    ),
  );
  assert_eq(check_codes(named), [b"E0465"])
}

/// A type `Stack` with a function `size` of it, and what follows.
fn with_stack(rest: Bytes) -> Bytes =
  b"type Stack = | Stack(List<Int>)\nfn Stack::size(s: Stack) -> Int = match s { Stack(xs) -> xs.len() }\nfn Stack::of(xs: List<Int>) -> Stack = Stack(xs)\n".concat(
    rest,
  )

test "a function of a type is declared `fn T::name` and named through the type" {
  assert_eq(check_codes(with_stack(b"fn f() -> Int = Stack::size(Stack::of([1, 2]))")), []);
  assert_eq(check_codes(with_stack(b"fn f() -> Int = Stack::depth(Stack([1]))")), [b"E0101"]);
  assert_eq(check_codes(with_stack(b"fn f() -> Int = size(Stack([1]))")), [b"E0101"])
}

test "a call on a value is a call of its type's function with the value first" {
  assert_eq(check_codes(with_stack(b"fn f() -> Int = Stack([1, 2]).size()")), []);
  assert_eq(check_codes(with_stack(b"fn f() -> Int = { let s = Stack([1, 2]); s.size() }")), []);
  assert_eq(
    check_codes(with_stack(b"fn f(s: Stack) -> Int = s.size() + Stack::of([3]).size()")),
    [],
  );
  assert_eq(check_codes(with_stack(b"fn f(s: Stack) -> Int = s.depth()")), [b"E0101"]);
  assert_eq(check_codes(with_stack(b"fn f(s: Stack) -> Int = s.size(1)")), [b"E0202"])
}

test "a function of a type is declared by the type's module, for a sum or a `new` record" {
  assert_eq(check_codes(b"fn Option::size(o: Option<Int>) -> Int = 0"), [b"E0208"]);
  assert_eq(check_codes(b"fn Missing::size(n: Int) -> Int = n"), [b"E0208"]);
  assert_eq(
    check_codes(b"type Pair = { a: Int, b: Int }\nfn Pair::sum(p: Pair) -> Int = p.a + p.b"),
    [b"E0217"],
  );
  let date = b"type Date = new { year: Int, day: Int }\n";
  assert_eq(
    check_codes(
      date.concat(
        b"fn Date::next(d: Date) -> Date = { year: d.year, day: d.day + 1 }\nfn f(d: Date) -> Int = d.next().day",
      ),
    ),
    [],
  );
  // A field is read first, so a function under a field's name could never be called on a value.
  assert(
    refused_with(
      date.concat(b"fn Date::year(d: Date) -> Int = d.year"),
      b"E0105",
      b"`Date` has a field `year` and a function of that name",
    ),
  )
}

test "a binding and an effect of one name are refused once, where the effect has no such operation" {
  assert_eq(
    check_codes(
      b"effect log { write say(n: Int) -> Unit }\nfn f(log: List<Int>) -> Int / {log.say} = log.len()",
    ),
    [b"E0105"],
  )
}

test "a free name is read with no import, where the module declares and imports none of it" {
  let console = { name: b"std.console", src: b"pub fn print(text: String) -> Int = text.len()\n" };
  assert_eq(codes_of([console, { name: b"m", src: b"fn f() -> Int = print(\"x\")\n" }]), []);
  // Its own is the one it reads, and an import is too.
  assert_eq(
    codes_of([
      console,
      { name: b"m", src: b"fn print(n: Int) -> Int = n\nfn f() -> Int = print(1)\n" },
    ]),
    [],
  );
  assert_eq(
    codes_of([
      console,
      { name: b"other", src: b"pub fn print(b: Bool) -> Bool = b\n" },
      { name: b"m", src: b"import other (print)\nfn f() -> Bool = print(true)\n" },
    ]),
    [],
  )
}

test "a function of a type another module declares is named through that module" {
  let shapes = {
    name: b"shapes",
    src: b"pub type Shape = | Sq(Int)\npub fn Shape::make(n: Int) -> Shape = Sq(n)\npub fn Shape::area(s: Shape) -> Int = match s { Sq(n) -> n * n }\n",
  };
  assert_eq(
    codes_of([
      shapes,
      {
        name: b"m",
        src: b"import shapes\nfn f(n: Int) -> Int = shapes::Shape::make(n).area() + shapes::Shape::make(n).shapes::Shape::area()\n",
      },
    ]),
    [],
  );
  assert_eq(
    codes_of([
      shapes,
      { name: b"m", src: b"import shapes\nfn f(n: Int) -> Int = shapes::Shape::nope(n)\n" },
    ]),
    [b"E0101"],
  );
  // Only a type sits between a module and a function.
  assert(parse(b"fn f() -> Int = a::b::c()").parser.diags.len() > 0, None)
}

test "a call on a value reads a record's field, a binding before an effect, and a known type" {
  // A record that holds a function is called through its field.
  assert_eq(check_codes(b"fn f(codec: { decode: (Int) -> Int }) -> Int = codec.decode(1)"), []);
  // A binding and an effect of one name leave the call two readings.
  assert(
    refused_with(
      with_stack(b"effect s { read size() -> Int }\nfn f(s: Stack) -> Int = s.size()"),
      b"E0105",
      b"`s` is a binding here and an effect",
    ),
  );
  assert_eq(
    check_codes(
      with_stack(
        b"effect log { write say(n: Int) -> Unit }\nfn f(s: Stack) -> Unit / {log.say} = log.say(s.size())",
      ),
    ),
    [],
  );
  // A type parameter has no function: the receiver's type is known where the call stands.
  assert(
    refused_with(
      with_stack(b"fn f<a>(x: a) -> Int = x.size()"),
      b"E0201",
      b"cannot call `size` on this value",
    ),
  )
}

test "a call on a value names its arguments and leaves the rest to their defaults" {
  let grown = |rest: Bytes|
    check_codes(
      with_stack(
        b"type Mode = | Fast | Slow\nfn Stack::grown(s: Stack, by: Int = 1, mode: Mode = Fast) -> Stack = s\n".concat(
          rest,
        ),
      ),
    );
  assert_eq(grown(b"fn f(s: Stack) -> Int = s.grown().size() + s.grown(2).size()"), []);
  assert_eq(grown(b"fn f(s: Stack) -> Int = s.grown(mode: Slow).size()"), []);
  assert_eq(grown(b"fn f() -> Int = Stack([1]).grown(mode: Slow, by: 3).size()"), []);
  assert_eq(grown(b"fn f(s: Stack) -> Int = s.grown(depth: 1).size()"), [b"E0123"]);
  assert_eq(grown(b"fn f(s: Stack) -> Int = s.grown(2, by: 3).size()"), [b"E0123"]);
  assert_eq(grown(b"fn f(s: Stack) -> Int = s.grown(by: true).size()"), [b"E0201"]);
  // A function a record holds in a field has no parameter to name.
  assert_eq(check_codes(b"fn f(codec: { decode: (Int) -> Int }) -> Int = codec.decode(from: 1)"), [
    b"E0123",
  ])
}

test "`value.m::f(..)` calls the function it names with the value first" {
  assert_eq(
    check_codes(
      with_stack(
        b"fn deep(s: Stack, by: Int) -> Int = by\nfn f(s: Stack) -> Int = s.Stack::size() + Stack([1]).Stack::size()",
      ),
    ),
    [],
  );
  assert_eq(check_codes(with_stack(b"fn f(s: Stack) -> Int = s.Stack::depth()")), [b"E0101"])
}

test "a lambda's unwritten parameter is what the arguments before it settle" {
  assert_eq(
    check_codes(
      with_stack(
        b"type P = { side: Int }\nfn sides(ps: List<P>) -> List<Int> = ps.map(|p| p.side)\nfn sizes(ss: List<Stack>) -> List<Int> = ss.map(|s| s.size())",
      ),
    ),
    [],
  );
  // Nothing settles it where the lambda stands alone.
  assert_eq(check_codes(b"type P = { side: Int }\nfn f() -> Int = { let g = |p| p.side; 1 }"), [
    b"E0201",
  ])
}

test "a builtin the prelude declares under a type is a function of that type" {
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Int = xs.len() + xs.push(1).len()"), []);
  assert_eq(check_codes(b"fn f(m: Map<Int, Int>) -> Option<Int> = m.get(1)"), []);
  assert_eq(check_codes(b"fn f(b: Bytes, s: String) -> Int = b.len() + s.trim().len()"), []);
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> List<Int> = xs.map(|x| x + 1)"), []);
  // One named for a type it does not take is no call on a value of that type, and is named
  // through the type as any of its functions is.
  assert_eq(check_codes(b"fn f(b: Bytes) -> Bytes = b.of_string()"), [b"E0101"]);
  assert_eq(
    check_codes(
      b"fn f(s: String) -> Int = Bytes::len(Bytes::of_string(s)) + Map::len(Map::insert(Map::new(), 1, s))",
    ),
    [],
  );
  assert_eq(check_codes(b"fn f(s: String) -> Int = Bytes::size(s)"), [b"E0101"]);
  // Written through its type it is the same builtin: what it ensures lets its caller raise nothing.
  assert_eq(check_codes(b"fn f(n: U8) -> Bytes = byte_of_int(Int::of_u8(n))"), []);
  // The name alone is no function: a module's own may take it, and is another function.
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Int = len(xs)"), [b"E0101"]);
  assert_eq(
    check_codes(
      b"fn len(n: Int) -> Int = n\nfn f(xs: List<Int>) -> Int = len(xs.len()) + List::len(xs)",
    ),
    [],
  );
  // One that is no type's keeps its name, and is no function of what it takes.
  assert_eq(check_codes(b"fn f(n: Int) -> List<Int> = range(0, n)"), []);
  assert_eq(check_codes(b"fn f(s: String) -> Int = s.panic()"), [b"E0101"])
}

test "a guard written on a value's own length lets a builtin that needs it raise nothing" {
  assert_eq(
    check_codes(b"fn f(b: Bytes) -> Bytes = if b.len() >= 1 { b.slice(0, 1) } else { b }"),
    [],
  );
  assert_eq(check_codes(b"fn f(b: Bytes) -> Bytes = b.slice(0, 1)"), [b"E0302"])
}

/// The codes a check of `sources` answers, each parsed as its own module.
fn codes_of(sources: List<Source>) -> List<Bytes> / {abort.raise} =
  match resolve_modules(
      sources.map(|source: Source|
        { name: source.name, module: parse(source.src).node, derived: [] }),
    ) {
    ResolveFailed(ds) -> ds.map(|diag: Diag| diag.code),
    ResolveSucceeded(y) ->
      dedup_diags(check_program(y.r, y.mods).checker.diags).map(|diag: Diag| diag.code),
  }

test "a language type's other functions are its home module's, which every module sees but those beneath the homes" {
  let home = {
    name: b"std.list",
    src: b"pub fn List::second<a>(xs: List<a>) -> Option<a> = xs.at(1)\n",
  };
  let calls = b"fn f(xs: List<Int>) -> Option<Int> = xs.second()\nfn g(xs: List<Int>) -> Option<Int> = List::second(xs)\n";
  assert_eq(codes_of([home, { name: b"m", src: b"import std.list\n".concat(calls) }]), []);
  assert_eq(
    codes_of([
      home,
      { name: b"mid", src: b"import std.list\npub fn one() -> Int = 1\n" },
      { name: b"m", src: b"import mid\n".concat(calls) },
    ]),
    [],
  );
  // A module sees it with no import, one of the library too; one a home imports, what it imports.
  assert_eq(codes_of([home, { name: b"m", src: calls }]), []);
  assert_eq(codes_of([home, { name: b"std.other", src: calls }]), []);
  assert_eq(codes_of([home, { name: b"std.gen", src: calls }]), [b"E0101", b"E0101"]);
  // The prelude's function of a name is the type's one function of it.
  assert_eq(
    codes_of([{ name: b"std.list", src: b"pub fn List::len<a>(xs: List<a>) -> Int = 0\n" }]),
    [b"E0105"],
  )
}

test "every way a function of a type is written calls it, a declared type's or a language type's alike" {
  let home = {
    name: b"std.list",
    src: b"pub fn List::second<a>(xs: List<a>) -> Option<a> = xs.at(1)\n",
  };
  // A function of a type the program declares, a builtin of a language type, and a function a
  // language type's home module declares, each with the type of a value of it and its answer.
  let kinds = [
    { ty: b"Box", f: b"Box::size", answer: b"Int" },
    { ty: b"String", f: b"String::len", answer: b"Int" },
    { ty: b"List<Int>", f: b"List::second", answer: b"Option<Int>" },
  ];
  let forms = |f: Bytes|
    [
      Bytes::concat_all([b"x.", f.slice(f.index_of(b"::").unwrap_or(0) + 2, f.len()), b"()"]),
      Bytes::concat_all([f, b"(x)"]),
      Bytes::concat_all([b"x.", f, b"()"]),
      Bytes::concat_all([b"pass(x).", f, b"()"]),
      Bytes::concat_all([b"{ let g = ", f, b"; g(x) }"]),
    ];
  let module = |body: Bytes|
    [
      home,
      {
        name: b"m",
        src: Bytes::concat_all([
          b"import std.list\ntype Box = | Box(Int)\nfn Box::size(b: Box) -> Int = match b { Box(n) -> n }\n",
          b"fn pass<a>(v: a) -> a = v\n",
          body,
        ]),
      },
    ];
  kinds.fold((), |_: Unit, k: { ty: Bytes, f: Bytes, answer: Bytes }|
    forms(k.f).fold((), |_: Unit, form: Bytes| {
      let fine = Bytes::concat_all([b"fn f(x: ", k.ty, b") -> ", k.answer, b" = ", form, b"\n"]);
      assert(codes_of(module(fine)) == [], Some(String::of_bytes_lossy(fine)));
      // Its answer is the function's, not the function itself.
      let wrong = Bytes::concat_all([b"fn f(x: ", k.ty, b") -> Bool = ", form, b"\n"]);
      assert(codes_of(module(wrong)) == [b"E0201"], Some(String::of_bytes_lossy(wrong)))
    }));
  // An argument the function does not take is refused, and one written is typed.
  kinds.fold((), |_: Unit, k: { ty: Bytes, f: Bytes, answer: Bytes }| {
    let extra = Bytes::concat_all([b"fn f(x: ", k.ty, b") -> ", k.answer, b" = x.", k.f, b"(1)\n"]);
    assert(codes_of(module(extra)) != [], Some(String::of_bytes_lossy(extra)))
  });
  assert_eq(codes_of(module(b"fn f(s: String) -> Int = s.String::nope()\n")), [b"E0101"]);
  assert_eq(codes_of(module(b"fn f(s: String) -> Int = s.Nowhere::len()\n")), [b"E0101"])
}

test "a recursion a builtin called on a value bounds, or runs a lambda of, is seen to end" {
  assert_eq(
    check_codes(
      b"fn f(xs: List<Int>, i: Int) -> Int = if i >= xs.len() { 0 } else { match xs.at(i) { Some(x) -> x + f(xs, i + 1), None -> 0 } }",
    ),
    [],
  );
  assert_eq(
    check_codes(
      b"type Tree = | Leaf(Int) | Node(List<Tree>)\nfn total(t: Tree) -> Int = match t { Leaf(n) -> n, Node(ts) -> ts.fold(0, |acc, c| acc + total(c)) }",
    ),
    [],
  );
  // One that hands itself the same list back does not descend.
  assert_eq(check_codes(b"fn f(xs: List<Int>) -> Int = if xs.len() == 0 { 0 } else { f(xs) }"), [
    b"E0302",
  ])
}

test "a recursion through a call on a value is a recursion, and a type states its own functions" {
  let list = b"type Chain = | End | Link(Int, Chain)\nfn Chain::len(c: Chain) -> Int = match c { End -> 0, Link(_, rest) -> 1 + rest.len() }\n";
  assert_eq(check_codes(list), []);
  // It does not descend, so it may not return.
  assert_eq(
    check_codes(
      b"type Chain = | End | Link(Int, Chain)\nfn Chain::len(c: Chain) -> Int = 1 + c.len()\n",
    ),
    [b"E0302"],
  );
  assert_eq(
    check_codes(
      list.concat(b"key for Chain by Chain::len\nfn same(a: Chain, b: Chain) -> Bool = a == b\n"),
    ),
    [],
  )
}
