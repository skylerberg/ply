  bdoc(b"int_of_i32", [b"n"], b"total"),
  bdoc(b"int_of_i64", [b"n"], b"total"),
  bdoc(b"min", [b"a", b"b"], b""),
  bdoc(b"max", [b"a", b"b"], b""),
  bdoc(b"byte_of_int", [b"n"], b"one byte; raises outside `0..=255`"),
  bdoc(b"int_to_string", [b"n"], b""),
  bdoc(b"string_concat", [b"a", b"b"], b"`a ++ b`"),
  bdoc(b"bytes_len", [b"b"], b""),
  bdoc(b"bytes_at", [b"b", b"i"], b"`0..=255`; raises out of range"),
  bdoc(b"bytes_u32_le", [b"b", b"i"], b"four bytes at `i`, little-endian"),
  bdoc(b"bytes_slice", [b"b", b"start", b"end"], b"raises out of range"),
  bdoc(b"bytes_concat", [b"a", b"b"], b"`a ++ b`"),
  bdoc(b"bytes_concat_all", [b"bs"], b"one allocation"),
  bdoc(b"bytes_of_string", [b"s"], b"UTF-8"),
  bdoc(b"bytes_is_utf8", [b"b"], b""),
  bdoc(b"bytes_index_of", [b"hay", b"needle"], b""),
