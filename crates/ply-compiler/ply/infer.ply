  bdoc(b"map_get", [b"m", b"key"], b""),
  bdoc(b"map_contains", [b"m", b"key"], b""),
  bdoc(b"map_remove", [b"m", b"key"], b""),
  bdoc(b"map_len", [b"m"], b""),
  bdoc(b"map_keys", [b"m"], b"ascending"),
  bdoc(b"map_values", [b"m"], b"key order"),
  bdoc(b"map_entries", [b"m"], b"key order"),
  bdoc(b"map_of_entries", [b"es"], b"a later entry wins"),
  bdoc(b"map_merge", [b"a", b"b"], b"`b` wins"),
  bdoc(b"map_fold", [b"m", b"init", b"f"], b"key order"),
  bdoc(b"decimal_div", [b"a", b"b", b"scale", b"mode"], b"raises on a zero divisor"),
  bdoc(b"decimal_round", [b"d", b"scale", b"mode"], b""),
  bdoc(b"decimal_of_int", [b"n"], b""),
  bdoc(b"int_of_decimal", [b"d", b"mode"], b"`None` if the rounded value does not fit an `Int`"),
  bdoc(b"float_of_decimal", [b"d"], b"nearest"),
  bdoc(b"decimal_of_float", [b"f"], b"`None` for `inf` or `NaN`"),
  bdoc(b"decimal_of_string", [b"s"], b""),
  bdoc(b"float_of_string", [b"s"], b"`Float` literal syntax with a sign; `None` for `inf` or `NaN`"),
  bdoc(b"decimal_to_string", [b"d"], b""),
  bdoc(b"bits_of_float", [b"f"], b"the IEEE-754 bit pattern; total"),
  bdoc(b"float_of_bits", [b"n"], b"the IEEE-754 bit pattern; total"),
  bdoc(b"panic", [b"message"], b"E0502"),
  bdoc(b"secret_of_string", [b"s"], b""),
  bdoc(b"secret_verify", [b"stored", b"supplied"], b"constant-time; not rate-limited"),
  bdoc(b"secret_is_empty", [b"s"], b""),
  bdoc(b"cell_get", [b"c"], b""),
  bdoc(b"cell_set", [b"c", b"v"], b""),
  bdoc(b"cell_update", [b"c", b"f"], b"the cell is unreadable while `f` runs"),
]

pub fn find_doc(docs: List<BuiltinDoc>, name: Bytes) -> Option<BuiltinDoc> =
  fold(docs, None, |acc: Option<BuiltinDoc>, d: BuiltinDoc| match acc { Some(_) -> acc, None -> if d.name == name { Some(d) } else { None } })

fn fn_arity(t: Type) -> Int = match t { TyFn(f) -> len(f.params), _ -> -1 }

test "every builtin is documented with one name per parameter" {
  let schemes = builtin_schemes(0, 1, 2, 0);
  let docs = builtin_docs();
  assert_eq(len(docs), len(schemes));
  fold(schemes, (), |acc: Unit, x: { name: Bytes, sc: Scheme }|
    match find_doc(docs, x.name) {
      None -> panic("undocumented builtin: " ++ string_of_bytes(x.name)),
      Some(d) -> assert_eq(len(d.params), fn_arity(x.sc.ty)),
    })
}

// The builtin signatures use the first three type variables and the first row variable, so `fresh` starts past them.
fn install_prelude(cx0: Cx) -> Cx = {
  let cx = install_prelude_adts(cx0);
  let a: WithVar = new_ty_var(cx);
  let b: WithVar = new_ty_var(a.cx);
  let c: WithVar = new_ty_var(b.cx);
  let e: WithVar = new_row_var(c.cx);
  let bound: Cx = fold(builtin_schemes(a.v, b.v, c.v, e.v), e.cx, |c2: Cx, x: { name: Bytes, sc: Scheme }|
    {..c2, env: env_bind_global(c2.env, x.name, x.sc)});
  let ord = [{ deriver: DOrd, param: 0 }];
  let constrained: Cx = {..bound, constraints: map_insert(map_insert(bound.constraints, b"compare", ord), b"compare_values", ord)};
  fold(prelude_effects(), constrained, |c2: Cx, ef: EffectInfo| add_effect(c2, ef))
}

// --- Names ------------------------------------------------------------------------------

type ValueKey = { name: Bytes, prelude: Bool }

// A bare name through this module's scope, a qualified one through the resolver.
fn global(cx: Cx, ns: Ns, q: QName) -> { cx: Cx, name: Option<Bytes> } =
  if is_bare(q) {
    match lookup(scope_of(cx).bound, ns, q.name.name) {
      Some(b) -> { cx: cx, name: Some(b.qualified) },
      None -> { cx: cx, name: None },
    }
  } else {
    match find(cx.r, cx.module, ns, q) {
      Some(b) -> { cx: cx, name: Some(b.qualified) },
      None -> { cx: match cx.derived {
                      Some(_) -> unresolved_in_derived(cx, q, match ns { NType -> b"type", _ -> b"definition" }),
                      None -> lookup_failure(cx, ns, q),
                    },
                name: None },
    }
  }

// A name a generated body cannot see is the field type's missing `derive`, not the user's bug.
fn unresolved_in_derived(cx: Cx, q: QName, what: Bytes) -> Cx = {
  let d = match cx.derived { Some(d) -> d, None -> panic("only a generated body reaches this") };
  let dv = deriver_text(d.deriver);
  err1(cx, b"E0206", q.span, bytes_concat_all([b"`", dv, b"` cannot be derived for `", d.target, b"`"]),
       bytes_concat_all([b"the generated body needs the ", what, b" `", qname_text(q), b"`, which is not in scope"]),
       [bytes_concat_all([b"a derivation composes through named types by calling their own dictionaries, so every field type needs `derive ", dv, b" for` it in the module that declares it"]),
        bytes_concat_all([b"`", qname_text(q), b"` is what `derive ", dv, b" for <that type>` generates"])])
}

fn lookup_failure(cx: Cx, ns: Ns, q: QName) -> Cx =
  match q.module {
    None -> cx,
    Some(binder) -> {
      let scope = scope_of(cx);
      match fold(scope.modules, None, |acc: Option<Int>, mb: { binder: Bytes, target: Int, span: Span }|
                 match acc { Some(_) -> acc, None -> if mb.binder == binder.name { Some(mb.target) } else { None } }) {
        // One note either way, plus a secondary when a selective import bound it.
        None -> {
          let selective = fold(scope.selective, None, |acc: Option<{ binder: Bytes, target: Int, span: Span }>, mb: { binder: Bytes, target: Int, span: Span }|
            match acc { Some(_) -> acc, None -> if mb.binder == binder.name { Some(mb) } else { None } });
          let message = bytes_concat_all([b"no module is imported as `", binder.name, b"`"]);
          let label = b"not a module imported by this file";
          match selective {
            Some(sel) -> {
              let module = at(cx.r.scopes, sel.target).module;
              err_labels(cx, b"E0106", message,
                         [lab(cx.module, binder.span, true, label),
                          lab(cx.module, sel.span, false, bytes_concat_all([b"this import brings in names from `", module, b"`"]))],
                         [bytes_concat_all([b"a selective import binds no module name: add `import ", module, b"` as well, or write `", q.name.name, b"` unqualified"])])
            },
            None -> {
              // A module of the program named like the binder, else what this file does import.
              let candidate = fold(cx.r.names, None, |acc: Option<Bytes>, e: Entry|
                match acc { Some(_) -> acc, None -> if e.name == binder.name || default_binder(e.name) == binder.name { Some(e.name) } else { None } });
              let note = match candidate {
                Some(name) -> bytes_concat_all([b"`", name, b"` is a module in this program: add `import ", name, b"` above the first item"]),
                None ->
                  if len(scope.modules) == 0 {
                    bytes_concat_all([b"`", scope.module, b"` imports no modules; add `import <module>` above the first item"])
                  } else {
                    bytes_concat(b"modules imported here: ", backticked(map(scope.modules, |mb: ModBind| mb.binder), b", "))
                  },
              };
              err1(cx, b"E0106", binder.span, message, label, [note])
            },
          }
        },
        Some(owner) -> {
          let decls = at(cx.r.declarations, owner);
          let module = at(cx.r.scopes, owner).module;
          match dlookup(decls, ns, q.name.name) {
            None -> {
              let exported = fold(space(decls, ns), [], |acc: List<Bytes>, x: Declared| if x.public { push(acc, x.name) } else { acc });
              err1(cx, b"E0101", q.span,
                   bytes_concat_all([b"module `", module, b"` has no ", ns_describe(ns), b" `", q.name.name, b"`"]),
                   bytes_concat_all([b"not declared in `", module, b"`"]),
                   [if len(exported) == 0 { bytes_concat_all([b"`", module, b"` exports no ", ns_describe(ns), b"s"]) }
                    else { bytes_concat_all([b"`", module, b"` exports: ", backticked(exported, b", ")]) }])
            },
            Some(d) -> if !d.public { report(cx, private_name(cx.module, q.span, owner, d.span, ns, q.name.name, module)) } else { cx },
          }
        },
      }
    },
  }

fn value_key(cx: Cx, q: QName) -> { cx: Cx, key: Option<ValueKey> } =
  if !is_bare(q) {
    let g: WithName = global(cx, NValue, q);
    match g.name { Some(n) -> { cx: g.cx, key: Some({ name: n, prelude: false }) }, None -> { cx: g.cx, key: None } }
  } else {
    let name = q.name.name;
    match env_depth_of(cx.env, name) {
      Some(depth) -> if depth > 0 { { cx: cx, key: Some({ name: name, prelude: false }) } } else { value_key_global(cx, q) },
      None -> value_key_global(cx, q),
    }
  }

fn value_key_global(cx: Cx, q: QName) -> { cx: Cx, key: Option<ValueKey> } = {
  let name = q.name.name;
  match lookup(scope_of(cx).bound, NValue, name) {
    Some(b) -> { cx: cx, key: Some({ name: b.qualified, prelude: false }) },
    None ->
      match env_depth_of(cx.env, name) {
        Some(0) -> { cx: cx, key: Some({ name: name, prelude: true }) },
        _ -> { cx: unknown_name(cx, q), key: None },
      },
  }
}

fn is_cell_builtin(name: Bytes) -> Bool = name == b"cell_get" || name == b"cell_set" || name == b"cell_update"

type CellForm = | CGet | CSet | CUpdate

fn cell_form(cx: Cx, q: QName) -> Option<CellForm> =
  if !is_bare(q) { None }
  else if env_depth_of(cx.env, q.name.name) != Some(0) { None }
  else {
    match lookup(scope_of(cx).bound, NValue, q.name.name) {
      Some(_) -> None,
      None -> if q.name.name == b"cell_get" { Some(CGet) } else if q.name.name == b"cell_set" { Some(CSet) }
              else if q.name.name == b"cell_update" { Some(CUpdate) } else { None },
    }
  }

fn declared_value(cx: Cx, q: QName) -> Option<Bytes> =
  if is_bare(q) {
    match lookup(scope_of(cx).bound, NValue, q.name.name) { Some(b) -> Some(b.qualified), None -> None }
  } else {
    match find(cx.r, cx.module, NValue, q) { Some(b) -> Some(b.qualified), None -> None }
  }

fn prelude_ctor(cx: Cx, q: QName) -> Option<Bytes> =
  if is_bare(q) { match ctor_of(cx, q.name.name) { Some(_) -> Some(q.name.name), None -> None } } else { None }

fn ctor_name(cx: Cx, q: QName) -> { cx: Cx, name: Option<Bytes> } = {
  let g: WithName = global(cx, NValue, q);
  match g.name { Some(n) -> g, None -> { cx: g.cx, name: prelude_ctor(g.cx, q) } }
}

fn covered_ctor(cx: Cx, q: QName) -> Option<Bytes> =
  match declared_value(cx, q) { Some(n) -> Some(n), None -> prelude_ctor(cx, q) }

// Another module that declares `name` publicly in `ns`.
fn exporter(cx: Cx, ns: Ns, name: Bytes) -> Option<Int> =
  fold(range(0, len(cx.r.declarations)), None, |acc: Option<Int>, i: Int|
    match acc {
      Some(_) -> acc,
      None -> if i == cx.module { None } else {
        match dlookup(at(cx.r.declarations, i), ns, name) { Some(d) -> if d.public { Some(i) } else { None }, None -> None }
      },
    })

fn nearest_name(cx: Cx, name: Bytes) -> Option<Bytes> = {
  let n = bytes_len(name);
  let best = fold(scope_of(cx).bound.values, None, |acc: Option<{ d: Int, name: Bytes }>, b: Binding| {
    let d = edit_distance(name, b.name);
    if d > 0 && d * 3 <= max(n, 1) && (match acc { None -> true, Some(x) -> d < x.d }) { Some({ d: d, name: b.name }) } else { acc }
  });
  match best { Some(x) -> Some(x.name), None -> None }
}

fn edit_distance(a: Bytes, b: Bytes) -> Int = {
  let n = bytes_len(a);
  let m = bytes_len(b);
  let first = range(0, m + 1);
  let final = fold(range(0, n), first, |prev: List<Int>, i: Int|
    fold(range(0, m), [i + 1], |cur: List<Int>, j: Int| {
      let cost = if bytes_at(a, i) == bytes_at(b, j) { 0 } else { 1 };
      let v = min(min(at(prev, j + 1) + 1, at(cur, j) + 1), at(prev, j) + cost);
      push(cur, v)
    }));
  at(final, m)
}

fn unknown_name(cx: Cx, q: QName) -> Cx =
  match cx.derived { Some(_) -> unresolved_in_derived(cx, q, b"definition"), None -> unknown_name_here(cx, q) }

fn unknown_name_here(cx: Cx, q: QName) -> Cx = {
  let n = q.name.name;
  let in_requires = match cx.spec_kind { Some(SRequires) -> true, _ -> false };
  let result = if is_bare(q) && n == result_name() && in_requires {
    [b"`result` is bound only in an `ensures`: a precondition that could name the result would be a claim about a value the call has not produced yet"]
  } else { [] };
  let near = match nearest_name(cx, n) { Some(x) -> push(result, bytes_concat_all([b"a name in scope looks similar: `", x, b"`"])), None -> result };
  let exported = if is_bare(q) {
    match exporter(cx, NValue, n) {
      Some(i) -> push(near, bytes_concat_all([b"module `", module_name(cx, i), b"` exports it: add `import ", module_name(cx, i), b" (", n, b")`"])),
      None -> near,
    }
  } else { near };
  err1(cx, b"E0101", q.span, bytes_concat_all([b"unknown name `", n, b"`"]), b"not found in this scope", exported)
}

// --- Types from type expressions ----------------------------------------------------------

fn type_param(cx: Cx, id: Ident) -> { cx: Cx, t: Type } =
  match map_get(cx.ty_params, id.name) {
    Some(t) -> { cx: cx, t: t },
    None ->
      if cx.auto_ty_params {
        let o: WithTy = new_ty(cx);
        { cx: {..o.cx, ty_params: map_insert(o.cx.ty_params, id.name, o.t)}, t: o.t }
      } else {
        let o: WithTy = new_ty(err1(cx, b"E0102", id.span, bytes_concat_all([b"unknown type variable `", id.name, b"`"]), b"not declared",
                                    [bytes_concat_all([b"add `", id.name, b"` to the generic list, e.g. `fn f<", id.name, b">(..)`"])]));
        o
      },
  }

fn conv_type(cx: Cx, te: TypeExpr) -> { cx: Cx, t: Type } =
  match te {
    TVar(id) -> type_param(cx, id),
    TUnit(_) -> { cx: cx, t: t_unit() },
    TBad(_) -> new_ty(cx),
    TRecord(r) -> {
      let fs = fold(r.fields, { cx: cx, fs: [] }, |acc: { cx: Cx, fs: List<Field> }, f: { name: Ident, ty: TypeExpr }| {
        let o: WithTy = conv_type(acc.cx, f.ty);
        { cx: o.cx, fs: push(acc.fs, { name: f.name.name, ty: o.t }) }
      });
      { cx: fs.cx, t: TyRecord(fields_sorted(fs.fs)) }
    },
    TFn(f) -> {
      let ps: WithTys = conv_types(cx, f.params);
      let r: WithTy = conv_type(ps.cx, f.ret);
      let eff = match f.effects { Some(row) -> conv_row(r.cx, row), None -> { cx: r.cx, r: row_empty() } };
      { cx: eff.cx, t: t_fn(ps.ts, r.t, eff.r) }
    },
    TCon(c) -> conv_con(cx, c.name, c.args, c.span),
  }

fn conv_types(cx: Cx, ts: List<TypeExpr>) -> { cx: Cx, ts: List<Type> } =
  fold(ts, { cx: cx, ts: [] }, |acc: { cx: Cx, ts: List<Type> }, t: TypeExpr| {
    let o: WithTy = conv_type(acc.cx, t);
    { cx: o.cx, ts: push(acc.ts, o.t) }
  })

// `what` loses its `s` when one was expected.
fn arity_error(cx: Cx, span: Span, name: Bytes, expected: Int, found: Int, what: Bytes) -> Cx = {
  let w = if expected == 1 { bytes_slice(what, 0, bytes_len(what) - 1) } else { what };
  err1(cx, b"E0202", span, bytes_concat_all([b"`", name, b"` takes ", num(expected), b" ", w, b", but ", supplied(found)]),
       bytes_concat_all([b"expected ", num(expected), b", found ", num(found)]), [])
}

fn conv_con(cx: Cx, name: QName, args: List<TypeExpr>, span: Span) -> { cx: Cx, t: Type } =
  if is_bare(name) && len(args) == 0 && map_contains(cx.ty_params, name.name.name) {
    { cx: cx, t: match map_get(cx.ty_params, name.name.name) { Some(t) -> t, None -> t_unit() } }
  } else {
    let converted: WithTys = conv_types(cx, args);
    let cx1: Cx = converted.cx;
    match (if is_bare(name) { builtin_type_arity(name.name.name) } else { None }) {
      Some(arity) ->
        if len(converted.ts) != arity { new_ty(arity_error(cx1, span, name.name.name, arity, len(converted.ts), b"type arguments")) }
        else if name.name.name == b"Cell" {
          let region: WithTy = new_ty(cx1);
          { cx: region.cx, t: TyCon({ name: b"Cell", args: [region.t, at(converted.ts, 0)] }) }
        } else {
          let built = TyCon({ name: name.name.name, args: converted.ts });
          { cx: note_map_keys(cx1, span, built), t: built }
        },
      None -> {
        let g: WithName = global(cx1, NType, name);
        match g.name {
          None ->
            if is_bare(name) {
              if len(args) == 0 && g.cx.auto_ty_params { type_param(g.cx, name.name) }
              else { new_ty(unknown_type(g.cx, name)) }
            } else { new_ty(g.cx) },
          Some(qualified) ->
            match map_get(g.cx.types, qualified) {
              None -> new_ty(g.cx),
              Some(decl) ->
                if len(converted.ts) != len(decl.params) { new_ty(arity_error(g.cx, span, name.name.name, len(decl.params), len(converted.ts), b"type arguments")) }
                else {
                  match decl.alias {
                    None -> { cx: g.cx, t: TyCon({ name: qualified, args: converted.ts }) },
                    Some(alias) ->
                      if contains_bytes(g.cx.alias_stack, qualified) {
                        new_ty(err1(g.cx, b"E0102", name.span, bytes_concat_all([b"type alias `", name.name.name, b"` expands into itself"]),
                                    b"cyclic alias", [b"break the cycle, or make this a `type` with variants"]))
                      }
                      else {
                        let saved = g.cx.ty_params;
                        let bound: Map<Bytes, Type> = fold(range(0, len(decl.params)), map_new(), |m: Map<Bytes, Type>, i: Int| map_insert(m, at(decl.params, i), at(converted.ts, i)));
                        let inner: Cx = {..g.cx, ty_params: bound, alias_stack: push(g.cx.alias_stack, qualified), module: decl.owner};
                        let o: WithTy = conv_type(inner, alias);
                        { cx: {..o.cx, ty_params: saved, alias_stack: take(o.cx.alias_stack, len(o.cx.alias_stack) - 1), module: g.cx.module}, t: o.t }
                      },
                  }
                },
            },
        }
      },
    }
  }

fn unknown_type(cx: Cx, q: QName) -> Cx =
  match cx.derived {
    Some(_) -> unresolved_in_derived(cx, q, b"type"),
    None -> {
      let n = q.name.name;
      let notes = [b"declare it with `type`, or check the spelling"];
      let exported = if is_bare(q) {
        match exporter(cx, NType, n) {
          Some(i) -> push(notes, bytes_concat_all([b"module `", module_name(cx, i), b"` exports it: `import ", module_name(cx, i), b" (", n, b")`"])),
          None -> notes,
        }
      } else { notes };
      err1(cx, b"E0102", q.span, bytes_concat_all([b"unknown type `", n, b"`"]), b"not found", exported)
    },
  }

fn row_param(cx: Cx, id: Ident) -> { cx: Cx, v: Option<Int> } =
  match map_get(cx.row_params, id.name) {
    Some(v) -> { cx: cx, v: Some(v) },
    None -> { cx: err1(cx, b"E0301", id.span, bytes_concat_all([b"unknown effect variable `", id.name, b"`"]), b"not declared",
                       [bytes_concat_all([b"declare it in the generic list, e.g. `fn f<| ", id.name, b">(..) / {| ", id.name, b"}`"])]),
              v: None },
  }

fn conv_row(cx: Cx, row: RowExpr) -> { cx: Cx, r: Row } = {
  let atoms = fold(row.atoms, { cx: cx, atoms: [] }, |acc: { cx: Cx, atoms: List<Atom> }, a: AtomExpr| {
    let o: WithAtom = conv_atom(acc.cx, a);
    match o.atom { Some(x) -> { cx: o.cx, atoms: atoms_insert(acc.atoms, x) }, None -> { cx: o.cx, atoms: acc.atoms } }
  });
  let tail = match row.tail { Some(t) -> row_param(atoms.cx, t), None -> { cx: atoms.cx, v: None } };
  { cx: tail.cx, r: { atoms: atoms.atoms, tail: tail.v } }
}

fn refused(cx: Cx, s: Span) -> Bool = fold(cx.refused_atoms, false, |acc: Bool, x: Span| acc || x == s)

fn conv_atom(cx: Cx, a: AtomExpr) -> { cx: Cx, atom: Option<Atom> } =
  if refused(cx, a.span) { { cx: cx, atom: None } } else {
    let e: WithName = effect_name(cx, a.eff);
    match e.name {
      None -> { cx: {..e.cx, refused_atoms: push(e.cx.refused_atoms, a.span)}, atom: None },
      Some(eff) -> {
        let resource = match a.resource {
          Some(r) -> match map_get(cx.label_params, r.name) { Some(v) -> RVar(v), None -> RNamed(r.name) },
          None -> RSingleton,
        };
        let info = effect_of(e.cx, eff);
        // An operation atom takes the declared operation's mode; the parser wrote a placeholder.
        let atom: Option<Atom> = match a.op {
          Some(op) -> match info {
            Some(i) -> match op_named(i, op.name) {
              Some(o) -> Some({ effect: eff, resource: resource, mode: o.mode, op: Some(o.name) }),
              None -> None,
            },
            None -> None,
          },
          None -> {
            let declares_mode = match info {
              Some(i) -> fold(i.ops, false, |acc: Bool, o: OpInfo| acc || mode_eq(o.mode, a.mode)),
              None -> true,
            };
            if declares_mode { Some({ effect: eff, resource: resource, mode: a.mode, op: None }) } else { None }
          },
        };
        match atom {
          Some(_) -> { cx: e.cx, atom: atom },
          None -> {
            let known = match info {
              Some(i) -> match a.op { Some(_) -> append(known_modes(i), known_ops(i)), None -> known_modes(i) },
              None -> [],
            };
            let help = if len(known) == 0 { [] } else { [bytes_concat_all([b"`", eff, b"` can perform: ", join_with(known, b", ")])] };
            let (message, label) = match a.op {
              Some(op) -> (bytes_concat_all([b"effect `", eff, b"` declares no operation `", op.name, b"`"]), b"no such operation"),
              None -> (bytes_concat_all([b"effect `", eff, b"` declares no `", mode_key(a.mode), b"` operation"]),
                       bytes_concat_all([b"no `", mode_key(a.mode), b"` operation to perform"])),
            };
            let reported: Cx = err1(e.cx, b"E0104", a.span, message, label, help);
            { cx: {..reported, refused_atoms: push(reported.refused_atoms, a.span)}, atom: None }
          },
        }
      },
    }
  }

fn known_modes(info: EffectInfo) -> List<Bytes> =
  fold(info.ops, [], |acc: List<Bytes>, op: OpInfo| {
    let k = bytes_concat_all([info.simple_name, b".", mode_key(op.mode)]);
    if contains_bytes(acc, k) { acc } else { push(acc, k) }
  })

fn known_ops(info: EffectInfo) -> List<Bytes> =
  map(info.ops, |op: OpInfo| bytes_concat_all([info.simple_name, b".", op.name]))

fn op_named(info: EffectInfo, name: Bytes) -> Option<OpInfo> =
  fold(info.ops, None, |acc: Option<OpInfo>, o: OpInfo| match acc { Some(_) -> acc, None -> if o.name == name { Some(o) } else { None } })

fn mode_eq(a: Mode, b: Mode) -> Bool = match a { MRead -> (match b { MRead -> true, _ -> false }), MWrite -> (match b { MWrite -> true, _ -> false }), MBad -> false }

fn mode_key(m: Mode) -> Bytes = match m { MRead -> b"read", MWrite -> b"write", MBad -> b"" }

fn effect_name(cx: Cx, q: QName) -> { cx: Cx, name: Option<Bytes> } =
  if is_bare(q) && q.name.name == cell() { { cx: cx, name: Some(cell()) } } else {
    let g: WithName = global(cx, NEffect, q);
    match g.name {
      Some(n) -> match effect_of(g.cx, n) { Some(_) -> { cx: g.cx, name: Some(n) }, None -> { cx: g.cx, name: None } },
      None ->
        if is_bare(q) && is_prelude_effect(q.name.name) { { cx: g.cx, name: Some(q.name.name) } }
        else if is_bare(q) { { cx: unknown_effect(g.cx, q), name: None } }
        else { { cx: g.cx, name: None } },
    }
  }

fn unknown_effect(cx: Cx, q: QName) -> Cx = {
  let n = q.name.name;
  let message = bytes_concat_all([b"unknown effect `", n, b"`"]);
  if is_bare(q) && (match env_depth_of(cx.env, n) { Some(_) -> true, None -> false }) {
    err1(cx, b"E0103", q.span, message, b"not declared",
         [bytes_concat_all([b"`", n, b"` is a value in scope, so this looks like a field call rather than a perform: write `(", n, b".<field>)(..)` to call a function held in a record"]),
          b"`a.b(c)` is an effect operation; parentheses make it a field access"])
  } else {
    let known = map(scope_of(cx).bound.effects, |b: Binding| b.name);
    let first = if len(known) == 0 { b"declare it with `effect <name> { .. }`" } else { bytes_concat(b"effects in scope: ", backticked(known, b", ")) };
    let notes = match exporter(cx, NEffect, n) {
      Some(i) -> [first, bytes_concat_all([b"module `", module_name(cx, i), b"` declares it: `import ", module_name(cx, i), b"` and write `", default_binder(module_name(cx, i)), b"::", n, b"`"])],
      None -> [first],
    };
    err1(cx, b"E0103", q.span, message, b"not declared", notes)
  }
}

// --- Declarations ------------------------------------------------------------------------

fn duplicate(cx: Cx, name: Ident, prev: Loc, what: Bytes) -> Cx =
  err2(cx, b"E0105", name.span, bytes_concat_all([what, b" `", name.name, b"` is defined more than once"]), b"redefined here",
       prev, b"first defined here", [b"rename one of them"])

fn record_type(cx: Cx, m: Mod, def: TypeDef) -> Cx = {
  let name = qualify(m.name, def.name.name);
  match map_get(cx.types, name) {
    Some(prev) -> duplicate(cx, def.name, { module: prev.owner, span: prev.span }, b"type"),
    None ->
      match builtin_type_arity(def.name.name) {
        Some(_) -> err1(cx, b"E0105", def.name.span, bytes_concat_all([b"`", def.name.name, b"` is a builtin type"]), b"cannot be redefined",
                        [b"choose a different name for this type"]),
        None -> {
          let alias = match def.body { TDAlias(t) -> Some(t), TDSum(_) -> None };
          {..cx, types: map_insert(cx.types, name, { params: map(def.params, |p: Ident| p.name), alias: alias, owner: cx.module, span: def.span })}
        },
      },
  }
}

fn collect_types(cx: Cx, m: Mod) -> Cx =
  fold(m.module.items, cx, |c: Cx, it: Item| match it { IType(d) -> record_type(c, m, d), _ -> c })

fn mentions_cell(t: Type) -> Bool =
  match t {
    TyCon(c) -> c.name == b"Cell" || fold(c.args, false, |acc: Bool, a: Type| acc || mentions_cell(a)),
    TyFn(f) -> fold(f.params, false, |acc: Bool, p: Type| acc || mentions_cell(p)) || mentions_cell(f.ret),
    TyRecord(fs) -> fold(fs, false, |acc: Bool, f: Field| acc || mentions_cell(f.ty)),
    TyVar(_) -> false,
  }

fn ty_expr_span(t: TypeExpr) -> Span = ty_span(t)

fn reject_declared_cell(cx: Cx, t: Type, span: Span, owner: Bytes, what: Bytes) -> Cx =
  if mentions_cell(t) {
    err1(cx, b"E0446", span, bytes_concat_all([b"`", owner, b"` declares ", what, b" that mentions a `Cell`"]),
         b"a declaration is outside every region there is",
         [b"a declared type is fixed once for the whole program, so the region a cell that reached it came from would be pinned by whichever value got there first, and no later check could tell that the cell had outlived it",
          b"take the cell as a type parameter instead, so the region stays in the type argument and the escape check can see it"])
  } else { cx }

fn collect_effects(cx: Cx, m: Mod) -> Cx =
  fold(m.module.items, cx, |c: Cx, it: Item|
    match it {
      IEffect(def) -> {
        let name = qualify(m.name, def.name.name);
        if def.name.name == cell() {
          err1(c, b"E0105", def.name.span, b"`cell` is a builtin effect", b"reserved for `with_cell` regions", [b"rename this effect"])
        }
        else if is_prelude_effect(name) {
          err1(c, b"E0105", def.name.span, bytes_concat_all([b"`", name, b"` is a prelude effect"]), b"declared by the language",
               [b"the language declares `task`, `clock`, `random` and `sim`; `simulate { .. }` handles the first three",
                bytes_concat_all([b"rename this effect, or put it in a named module, where its program-wide name would be `<module>.", def.name.name, b"` and would shadow the prelude"])])
        }
        else {
          match effect_of(c, name) {
            Some(prev) -> duplicate(c, def.name, prev.at, b"effect"),
            None -> {
              let ops = fold(def.ops, { cx: c, ops: [] }, |acc: { cx: Cx, ops: List<OpInfo> }, op: OpDef|
                if fold(acc.ops, false, |b: Bool, o: OpInfo| b || o.name == op.name.name) {
                  let prev = fold(acc.ops, dummy_span(), |s: Span, o: OpInfo| if o.name == op.name.name { o.at.span } else { s });
                  { cx: duplicate(acc.cx, op.name, { module: acc.cx.module, span: prev }, b"operation"), ops: acc.ops }
                } else {
                  let c1: Cx = {..acc.cx, ty_params: map_new(), auto_ty_params: true};
                  let ps: WithTys = conv_types(c1, op.params);
                  let r: WithTy = conv_type(ps.cx, op.ret);
                  let c2: Cx = {..r.cx, auto_ty_params: false, ty_params: map_new()};
                  let c3: Cx = fold(range(0, len(ps.ts)), c2, |cc: Cx, i: Int| reject_declared_cell(cc, at(ps.ts, i), ty_expr_span(at(op.params, i)), op.name.name, b"a parameter"));
                  let c4 = reject_declared_cell(c3, r.t, ty_expr_span(op.ret), op.name.name, b"a result");
                  { cx: c4, ops: push(acc.ops, { name: op.name.name, mode: op.mode, resource_param: op.resource_param, params: ps.ts, ret: r.t, at: here(c4, op.span), scheme: None }) }
                });
              add_effect(ops.cx, { name: name, module: m.name, simple_name: def.name.name, nondet: def.is_nondet, ops: ops.ops, at: here(ops.cx, def.span) })
            },
          }
        }
      },
      _ -> c,
    })

fn collect_ctors(cx: Cx, m: Mod) -> Cx =
  fold(m.module.items, cx, |c: Cx, it: Item|
    match it {
      IType(def) ->
        match def.body {
          TDAlias(_) -> c,
          TDSum(variants) -> {
            let type_name = qualify(m.name, def.name.name);
            match map_get(c.types, type_name) {
              None -> c,
              Some(decl) -> {
                let vars: { cx: Cx, vars: List<Int>, params: Map<Bytes, Type> } = fold(decl.params, { cx: c, vars: [], params: map_new() }, |acc: { cx: Cx, vars: List<Int>, params: Map<Bytes, Type> }, p: Bytes| {
                  let o: WithVar = new_ty_var(acc.cx);
                  { cx: o.cx, vars: push(acc.vars, o.v), params: map_insert(acc.params, p, TyVar(o.v)) }
                });
                let c1: Cx = {..vars.cx, ty_params: vars.params};
                let result = TyCon({ name: type_name, args: map(vars.vars, |v: Int| TyVar(v)) });
                let walked: Cx = fold(range(0, len(variants)), c1, |cc: Cx, index: Int| {
                  let variant = at(variants, index);
                  let ctor = qualify(m.name, variant.name.name);
                  match ctor_of(cc, ctor) {
                    Some(prev) -> duplicate(cc, variant.name, prev.at, b"constructor"),
                    None -> {
                      let fs: WithTys = conv_types(cc, variant.fields);
                      let checked: Cx = fold(range(0, len(fs.ts)), fs.cx, |c3: Cx, i: Int| reject_declared_cell(c3, at(fs.ts, i), ty_expr_span(at(variant.fields, i)), variant.name.name, b"a field"));
                      let ty = if len(fs.ts) == 0 { result } else { t_fn(fs.ts, result, row_empty()) };
                      let sc = { ty_vars: vars.vars, row_vars: [], label_vars: [], ty: ty };
                      add_ctor({..checked, env: env_bind_global(checked.env, ctor, sc)},
                               { name: ctor, module: m.name, simple_name: variant.name.name, type_name: type_name, index: index,
                                 arity: len(fs.ts), fields: fs.ts, scheme: sc, at: here(checked, variant.span) })
                    },
                  }
                });
                {..walked, ty_params: map_new()}
              },
            }
          },
        },
      _ -> c,
    })

// A function and a constructor of one name in one module.
fn check_value_namespace(cx: Cx, m: Mod) -> Cx = {
  let walked = fold(m.module.items, { cx: cx, seen: [] }, |acc: { cx: Cx, seen: List<{ name: Bytes, span: Span, is_fn: Bool }> }, it: Item| {
    let declared = match it {
      IFn(d) -> [{ name: d.name, is_fn: true }],
      IType(d) -> match d.body { TDSum(vs) -> map(vs, |v: VariantDef| { name: v.name, is_fn: false }), TDAlias(_) -> [] },
      _ -> [],
    };
    fold(declared, acc, |a: { cx: Cx, seen: List<{ name: Bytes, span: Span, is_fn: Bool }> }, x: { name: Ident, is_fn: Bool }| {
      let prev = fold(a.seen, None, |p: Option<{ name: Bytes, span: Span, is_fn: Bool }>, s: { name: Bytes, span: Span, is_fn: Bool }|
        match p { Some(_) -> p, None -> if s.name == x.name.name { Some(s) } else { None } });
      match prev {
        None -> {..a, seen: push(a.seen, { name: x.name.name, span: x.name.span, is_fn: x.is_fn })},
        Some(first) -> if first.is_fn == x.is_fn { a } else {
          let later = if x.is_fn { b"function" } else { b"constructor" };
          let earlier = if x.is_fn { b"constructor" } else { b"function" };
          let where_ = if bytes_len(m.name) == 0 { b"" } else { bytes_concat_all([b" in module `", m.name, b"`"]) };
          {..a, cx: err2(a.cx, b"E0105", x.name.span, bytes_concat_all([b"`", x.name.name, b"` is defined twice", where_]),
                         bytes_concat_all([b"redefined here as a ", later]), { module: a.cx.module, span: first.span },
                         bytes_concat_all([b"first defined here as a ", earlier]),
                         [bytes_concat_all([b"functions and constructors share one namespace: nothing written `", x.name.name, b"` could say which of the two it means"]),
                          b"rename one of them"])}
        },
      }
    })
  });
  walked.cx
}

// --- Signatures ---------------------------------------------------------------------------

fn constraints_in_force(cx: Cx, cs: List<Constraint>) -> List<Assumed> =
  fold(cs, [], |acc: List<Assumed>, c: Constraint|
    match map_get(cx.ty_params, c.param.name) {
      Some(TyVar(v)) -> assume(acc, c.deriver, v),
      _ -> acc,
    })

fn assume(xs: List<Assumed>, d: Deriver, v: Int) -> List<Assumed> = {
  let hit = fold(range(0, len(xs)), None, |acc: Option<Int>, i: Int| match acc { Some(_) -> acc, None -> if same_deriver(at(xs, i).deriver, d) { Some(i) } else { None } });
  match hit {
    Some(i) -> { let x = at(xs, i); set_at(xs, i, { deriver: x.deriver, vars: ints_insert(x.vars, v) }) },
    None -> push(xs, { deriver: d, vars: [v] }),
  }
}

fn check_where(cx: Cx, def: FnDef) -> Cx =
  fold(def.constraints, cx, |c: Cx, k: Constraint|
    if map_contains(c.ty_params, k.param.name) { c } else {
      let bound = map(def.generics.types, |g: Ident| g.name);
      err1(c, b"E0102", k.param.span, bytes_concat_all([b"`", k.param.name, b"` is not a type parameter of this signature"]),
           b"not bound by the generic list",
           [if len(bound) == 0 {
              bytes_concat_all([b"`", def.name.name, b"` takes no type parameters, and a constraint on a concrete type is either already true or already an error"])
            } else { bytes_concat(b"this signature binds ", backticked(bound, b", ")) }])
    })

fn signature(cx0: Cx, def: FnDef) -> { cx: Cx, sig: Sig } = signature_sharing(cx0, def, [])

// `shared` holds the label variables the recursive group is checked with: a member's binders take
// them in order, so a call inside the group passes the caller's labels along.
fn signature_sharing(cx0: Cx, def: FnDef, shared: List<Int>) -> { cx: Cx, sig: Sig } = {
  let cx: Cx = {..cx0, scope: cx0.scope + 1, ty_params: map_new(), row_params: map_new(), label_params: map_new()};
  let tys: Cx = fold(def.generics.types, cx, |c: Cx, p: Ident| {
    let o: WithVar = new_ty_var(c);
    {..o.cx, subst: mark_rigid_ty(o.cx.subst, o.v), ty_params: map_insert(o.cx.ty_params, p.name, TyVar(o.v))}
  });
  let rows: Cx = fold(def.generics.effects, tys, |c: Cx, p: Ident| {
    let o: WithVar = new_row_var(c);
    {..o.cx, subst: mark_rigid_row(o.cx.subst, o.v), row_params: map_insert(o.cx.row_params, p.name, o.v)}
  });
  // A label parameter is a type variable, rigid in the body, that the row's atoms name.
  let labels: Cx = fold(range(0, len(def.generics.labels)), rows, |c: Cx, i: Int|
    match list_at(shared, i) {
      Some(v) -> {..c, label_params: map_insert(c.label_params, at(def.generics.labels, i).name, v)},
      None -> {
        let o: WithVar = new_ty_var(c);
        {..o.cx, subst: mark_rigid_ty(o.cx.subst, o.v),
                 label_params: map_insert(o.cx.label_params, at(def.generics.labels, i).name, o.v)}
      },
    });
  let assumed: Cx = {..labels, assumed: constraints_in_force(labels, def.constraints)};
  let checked: Cx = check_where(assumed, def);
  let params = fold(def.params, { cx: checked, ts: [] }, |acc: { cx: Cx, ts: List<Type> }, p: Param|
    match p.ty {
      Some(t) -> { let o: WithTy = conv_type(acc.cx, t); { cx: o.cx, ts: push(acc.ts, o.t) } },
      None -> { let o: WithTy = new_ty(acc.cx); { cx: o.cx, ts: push(acc.ts, o.t) } },
    });
  let ret = match def.ret { Some(t) -> conv_type(params.cx, t), None -> new_ty(params.cx) };
  let declared: { cx: Cx, r: Option<Row> } = match def.effects { Some(r) -> { let o: WithRow = conv_row(ret.cx, r); { cx: o.cx, r: Some(o.r) } }, None -> { cx: ret.cx, r: None } };
  let row: WithRow = match declared.r { Some(r) -> { cx: declared.cx, r: r }, None -> new_row(declared.cx) };
  let c: Cx = row.cx;
  { cx: {..c, ty_params: map_new(), row_params: map_new(), label_params: map_new()},
    sig: { ty_params: c.ty_params, row_params: c.row_params, label_params: c.label_params,
           fn_ty: t_fn(params.ts, ret.t, row.r), params: params.ts,
           ret: ret.t, declared: declared.r, published_row: row.r, scope: c.scope } }
}

// --- Expressions ------------------------------------------------------------------------------

fn lit_type(l: Lit) -> Type =
  match l { LInt(_) -> t_int(), LFixed(ty, _) -> con(bytes_of_string(string_upper(string_of_bytes(ty)))), LBool(_) -> t_bool(), LStr(_) -> t_string(), LBytes(_) -> t_bytes(), LFloat(_) -> t_float(), LDec(_) -> t_decimal(), _ -> t_unit() }

fn record_site(cx: Cx, atom: Atom, span: Span, source: Src) -> Cx =
  if span.start == 0 && span.end == 0 { cx } else { {..cx, performs: push(cx.performs, { atom: atom, module: cx.module, span: span, source: source })} }

fn is_direct(s: PerformSite) -> Bool = match s.source { SDirect -> true, _ -> false }

fn callee_source(cx: Cx, func: Expr) -> Src =
  match func {
    EVar(v) ->
      if is_bare(v.name) && (match env_depth_of(cx.env, v.name.name.name) { Some(d) -> d > 0, None -> false }) { SOpaque }
      else { match declared_value(cx, v.name) { Some(n) -> SVia(n), None -> SArgs } },
    _ -> SOpaque,
  }

// Drops the sites recorded from `mark` to `until` whose atom `handled` covers.
fn discharge(cx: Cx, mark: Int, until: Int, handled: List<Atom>) -> Cx = {
  let kept = filter(take(drop(cx.performs, mark), until - mark), |s: PerformSite| !atoms_covered(handled, resolve_atom(cx.subst, s.atom)));
  {..cx, performs: append(append(take(cx.performs, mark), kept), drop(cx.performs, until))}
}

fn key_named(keys: List<OpKey>, a: Atom) -> Bool =
  fold(keys, false, |acc: Bool, k: OpKey| acc || (k.effect == a.effect && k.res == a.resource && Some(k.op) == a.op))

// The operation atoms a mode atom stands for: the effect's operations of that mode, under the atom's resource.
fn mode_ops(cx: Cx, a: Atom) -> List<Atom> = {
  let named = match a.resource { RNamed(_) -> true, RVar(_) -> true, RSingleton -> false };
  match effect_of(cx, a.effect) {
    Some(info) -> fold(info.ops, [], |acc: List<Atom>, o: OpInfo|
      if mode_eq(o.mode, a.mode) && o.resource_param == named { push(acc, { effect: a.effect, resource: a.resource, mode: a.mode, op: Some(o.name) }) } else { acc }),
    None -> [],
  }
}

// A clause discharges the operation it names; a mode atom is discharged by a clause for each of its operations.
// `handled` holds the clauses' mode atoms.
fn clause_discharges(cx: Cx, handled: List<Atom>, keys: List<OpKey>, a: Atom) -> Bool =
  match a.op {
    Some(_) -> key_named(keys, a),
    None -> atoms_contains(handled, a) && fold(mode_ops(cx, a), true, |acc: Bool, o: Atom| acc && key_named(keys, o)),
  }

fn site_for(cx: Cx, atom: Atom) -> Option<PerformSite> = site_among(resolved_sites(cx.subst, cx.performs), atom)

fn resolved_sites(s: Subst, sites: List<PerformSite>) -> List<PerformSite> =
  map(sites, |x: PerformSite| { atom: resolve_atom(s, x.atom), module: x.module, span: x.span, source: x.source })

fn site_among(sites: List<PerformSite>, atom: Atom) -> Option<PerformSite> =
  fold(sites, None, |acc: Option<PerformSite>, s: PerformSite| match acc { Some(_) -> acc, None -> if s.atom == atom { Some(s) } else { None } })

fn join(cx: Cx, span: Span, a: Row, b: Row) -> { cx: Cx, r: Row } =
  match a.tail {
    Some(x) ->
      match b.tail {
        Some(y) ->
          if x != y {
            let u = unify_row(cx.subst, cx.fresh, row_open(x), row_open(y));
            let c = with_unified(cx, u);
            match u.err {
              Some(e) -> { cx: report_unify(c, e, span, b"this expression combines two effect variables"), r: row_union(a, b) },
              None -> { cx: c, r: row_union(a, b) },
            }
          } else { { cx: cx, r: row_union(a, b) } },
        None -> { cx: cx, r: row_union(a, b) },
      },
    None -> { cx: cx, r: row_union(a, b) },
  }

// The message and both sides of the primary label are what dedup compares, so both go into `text`.
fn report_unify(cx: Cx, e: UnifyError, span: Span, context: Bytes) -> Cx =
  match e {
    Mismatch(m) -> {
      let pe = print_ty(printer_new(), resolve(cx, m.expected));
      let pf = print_ty(pe.p, resolve(cx, m.found));
      report_text(cx, b"E0201", span, bytes_concat_all([context, b"|", pe.s, b"|", pf.s]),
                  bytes_concat(b"type mismatch: ", context),
                  bytes_concat_all([b"expected `", pe.s, b"`, found `", pf.s, b"`"]), [])
    },
    Arity(a) -> report_text(cx, b"E0202", span, bytes_concat_all([context, b"|", num(a.expected), b"|", num(a.found)]),
                            bytes_concat(b"function arity mismatch: ", context),
                            bytes_concat_all([b"expected ", num(a.expected), b" parameter(s), found ", num(a.found)]), []),
    OccursTy(o) -> {
      let pv = print_ty(printer_new(), TyVar(o.v));
      let pt = print_ty(pv.p, o.ty);
      report_text(cx, b"E0203", span, bytes_concat_all([context, b"|", pv.s, b"|", pt.s]),
                  bytes_concat(b"infinite type: ", context),
                  bytes_concat_all([b"`", pv.s, b"` would have to equal `", pt.s, b"`"]),
                  [b"this usually means a recursive value is missing a constructor"])
    },
    OccursRow(o) -> {
      let pv = print_row(printer_new(), row_open(o.v));
      let pr = print_row(pv.p, o.row);
      report_text(cx, b"E0203", span, bytes_concat_all([context, b"|", pv.s, b"|", pr.s]),
                  bytes_concat(b"infinite effect row: ", context),
                  bytes_concat_all([b"`", pv.s, b"` would have to equal `", pr.s, b"`"]),
                  [b"an effect row cannot contain itself"])
    },
    RowMismatch(m) -> {
      let expected = resolve_r(cx, m.expected);
      let found = resolve_r(cx, m.found);
      let extra = atoms_difference(found.atoms, expected.atoms);
      let pe = print_row(printer_new(), expected);
      let pf = print_row(pe.p, found);
      report_text(cx, b"E0302", span, bytes_concat_all([context, b"|", pe.s, b"|", pf.s]),
                  bytes_concat(b"effect row mismatch: ", context),
                  bytes_concat_all([b"expected ", pe.s, b", found ", pf.s]),
                  if len(extra) > 0 { [bytes_concat(b"not permitted here: ", backticked(map(extra, atom_text), b", "))] } else { [] })
    },
  }

fn report_text(cx: Cx, code: Bytes, span: Span, text: Bytes, message: Bytes, label: Bytes, notes: List<Bytes>) -> Cx =
  report(cx, { code: code, notes: len(notes), labels: [lab(cx.module, span, true, label)], text: text,
               message: message, notes_text: notes, severity: b"error", fixes: [] })

fn bits_text(op: Bytes) -> Bytes =
  if op == b"bitand" { b"&" } else if op == b"bitor" { b"|" } else if op == b"bitxor" { b"^" }
  else if op == b"shl" { b"<<" } else if op == b"shr" { b">>" } else { b">>>" }

fn expect(cx: Cx, span: Span, expected: Type, found: Type, context: Bytes) -> { cx: Cx, ok: Bool } = {
  let u = unify(cx.subst, cx.fresh, expected, found);
  let c = with_unified(cx, u);
  match u.err { Some(e) -> { cx: report_unify(c, e, span, context), ok: false }, None -> { cx: c, ok: true } }
}

// A bit operand's type is often still a variable here, so the obligation waits for `settle_bit_ops`.
fn note_bits(cx: Cx, span: Span, found: Type, what: Bytes) -> Cx =
  {..cx, bit_ops: push(cx.bit_ops, { span: span, what: what, ty: found })}

fn settle_bit_ops(cx: Cx) -> Cx = {
  let entries = cx.bit_ops;
  fold(entries, {..cx, bit_ops: []}, |c: Cx, entry: BitOp| {
    let ty = resolve(c, entry.ty);
    match ty {
      TyVar(_) -> err1(c, b"E0210", entry.span, bytes_concat_all([b"the integer type of ", entry.what, b" is not determined"]),
                       b"nothing here says which integer type this is",
                       [b"`Int` and the eight fixed-width types are the integer types", b"annotate the operand, or write a literal that pins it"]),
      TyCon(k) -> if len(k.args) == 0 && is_int_name(k.name) { c } else { bits_mismatch(c, entry, ty) },
      _ -> bits_mismatch(c, entry, ty),
    }
  })
}

fn bits_mismatch(cx: Cx, entry: BitOp, ty: Type) -> Cx = {
  let name = type_text(ty);
  let notes = [b"`Int` and the eight fixed-width types are the integer types"];
  err1(cx, b"E0201", entry.span, bytes_concat_all([entry.what, b" is not defined on `", name, b"`"]),
       bytes_concat_all([b"has type `", name, b"`"]),
       if name == b"Bool" { push(notes, bool_bits_note()) } else { notes })
}

fn bool_bits_note() -> Bytes = b"`Bool` has `&&`, `||` and `!`; the bit operators are integers only"

// Both sides of a `++` are one type by then; which of the two joinable ones it is waits for `settle_concats`.
fn settle_concats(cx: Cx) -> Cx = {
  let entries = cx.concats;
  fold(entries, {..cx, concats: []}, |c: Cx, entry: ConcatSite| {
    let at_: Cx = {..c, module: entry.module};
    let ty = resolve(at_, entry.ty);
    let judged: Cx = match concat_name(ty) {
      Some(_) -> at_,
      None -> match ty {
        TyVar(_) -> err1(at_, b"E0210", entry.span, b"the type of this `++` is not determined",
                         b"nothing here says whether this joins `String`s or `Bytes`",
                         [b"annotate an operand, or write a literal that pins it"]),
        other -> err1(at_, b"E0201", entry.span,
                      bytes_concat_all([b"`++` is not defined on `", type_text(other), b"`"]), b"joined here",
                      [b"`++` joins two `String`s or two `Bytes`"]),
      },
    };
    {..judged, module: c.module}
  })
}

fn bind_all(cx: Cx, bindings: List<{ name: Bytes, ty: Type }>) -> Cx =
  fold(bindings, cx, |c: Cx, b: { name: Bytes, ty: Type }| {..c, env: env_bind(c.env, b.name, mono(b.ty))})

fn infer_all(cx: Cx, xs: List<Expr>, span: Span) -> { cx: Cx, tys: List<Type>, row: Row } =
  fold(xs, { cx: cx, tys: [], row: row_empty() }, |acc: { cx: Cx, tys: List<Type>, row: Row }, x: Expr| {
    let o: Inferred = infer(acc.cx, x);
    let j: WithRow = join(o.cx, span, acc.row, o.row);
    { cx: j.cx, tys: push(acc.tys, o.ty), row: j.r }
  })

fn infer(cx: Cx, e: Expr) -> Inferred =
  match e {
    ELit(l) -> { cx: cx, ty: lit_type(l.lit), row: row_empty() },
    EBad(_) -> { let o: WithTy = new_ty(cx); { cx: o.cx, ty: o.t, row: row_empty() } },
    EVar(v) -> infer_var(cx, v.name),
    EUnary(u) -> {
      let o: Inferred = infer(cx, u.operand);
      if u.op == b"neg" { { cx: {..o.cx, numerics: push(o.cx.numerics, { span: u.span, op: b"sub", ty: o.ty })}, ty: o.ty, row: o.row } }
      else if u.op == b"bitnot" { { cx: note_bits(o.cx, expr_span(u.operand), o.ty, b"the operand of `~`"), ty: o.ty, row: o.row } }
      else { let x: Expected = expect(o.cx, expr_span(u.operand), t_bool(), o.ty, b"operand of a unary operator"); { cx: x.cx, ty: t_bool(), row: o.row } }
    },
    EBinary(b) -> infer_binary(cx, b.span, b.op, b.lhs, b.rhs),
    ELambda(l) -> {
      let pushed: Cx = {..cx, env: env_push(cx.env)};
      let ps = fold(l.params, { cx: pushed, ts: [] }, |acc: { cx: Cx, ts: List<Type> }, p: Param| {
        let t: WithTy = match p.ty { Some(te) -> conv_type(acc.cx, te), None -> new_ty(acc.cx) };
        { cx: {..t.cx, env: env_bind(t.cx.env, p.name.name, mono(t.t))}, ts: push(acc.ts, t.t) }
      });
      let body: Inferred = infer(ps.cx, l.body);
      let checked: Cx = match l.ret {
        Some(written) -> { let w: WithTy = conv_type(body.cx, written); expect(w.cx, expr_span(l.body), w.t, body.ty, b"the lambda's written return type").cx },
        None -> body.cx,
      };
      { cx: {..checked, env: env_pop(checked.env)}, ty: t_fn(ps.ts, body.ty, body.row), row: row_empty() }
    },
    EApp(a) -> infer_app(cx, a.span, a.func, a.args, a.labels),
    EIf(i) -> {
      let c: Inferred = infer(cx, i.cond);
      let cc: Cx = expect(c.cx, expr_span(i.cond), t_bool(), c.ty, b"condition of `if`").cx;
      let t: Inferred = infer(cc, i.then_branch);
      let el: Inferred = infer(t.cx, i.else_branch);
      let agreed: Cx = expect(el.cx, expr_span(i.else_branch), t.ty, el.ty, b"branches of `if` must agree").cx;
      let j1: WithRow = join(agreed, i.span, c.row, t.row);
      let j2: WithRow = join(j1.cx, i.span, j1.r, el.row);
      { cx: j2.cx, ty: t.ty, row: j2.r }
    },
    EMatch(m) -> infer_match(cx, m.span, m.scrutinee, m.arms),
    EBlock(b) -> {
      let pushed: Cx = {..cx, env: env_push(cx.env)};
      let stmts: WithBodyRow = fold(b.stmts, { cx: pushed, row: row_empty() }, |acc: { cx: Cx, row: Row }, s: Stmt| {
        let o: WithBodyRow = infer_stmt(acc.cx, s);
        let j: WithRow = join(o.cx, b.span, acc.row, o.row);
        { cx: j.cx, row: j.r }
      });
      let tail: Inferred = match b.tail {
        Some(t) -> { let o: Inferred = infer(stmts.cx, t); let j: WithRow = join(o.cx, b.span, stmts.row, o.row); { cx: j.cx, ty: o.ty, row: j.r } },
        None -> { cx: stmts.cx, ty: t_unit(), row: stmts.row },
      };
      { cx: {..tail.cx, env: env_pop(tail.cx.env)}, ty: tail.ty, row: tail.row }
    },
    ERecord(r) -> {
      let fs = fold(r.fields, { cx: cx, fs: [], row: row_empty() }, |acc: { cx: Cx, fs: List<Field>, row: Row }, f: RecField| {
        let o: Inferred = infer(acc.cx, f.value);
        let j: WithRow = join(o.cx, r.span, acc.row, o.row);
        { cx: j.cx, fs: push(acc.fs, { name: f.name.name, ty: o.ty }), row: j.r }
      });
      { cx: fs.cx, ty: TyRecord(fields_sorted(fs.fs)), row: fs.row }
    },
    ERecordUpdate(r) -> infer_record_update(cx, r.span, r.base, r.fields),
    ETry(_) -> panic("`e?` is expanded away before the checker runs"),
    EField(f) -> {
      let b: Inferred = infer(cx, f.base);
      match resolve(b.cx, b.ty) {
        TyRecord(fs) ->
          match field_get(fs, f.field.name) {
            Some(t) -> { cx: b.cx, ty: t, row: b.row },
            None -> {
              let known = map(fs, |x: Field| x.name);
              let o: WithTy = new_ty(err1(b.cx, b"E0101", f.field.span, bytes_concat_all([b"no field `", f.field.name, b"` on this record"]), b"unknown field",
                                          [if len(known) == 0 { b"the record has no fields" } else { bytes_concat(b"available fields: ", backticked(known, b", ")) }]));
              { cx: o.cx, ty: o.t, row: b.row }
            },
          },
        other -> {
          let o: WithTy = new_ty(err1(b.cx, b"E0201", expr_span(f.base), bytes_concat_all([b"cannot read field `", f.field.name, b"` here"]),
                                      bytes_concat_all([b"this has type `", type_text(other), b"`, not a record"]),
                                      [b"annotate the value so its record type is known"]));
          { cx: o.cx, ty: o.t, row: b.row }
        },
      }
    },
    EList(l) -> {
      let elem: WithTy = new_ty(cx);
      let items = fold(l.items, { cx: elem.cx, row: row_empty() }, |acc: { cx: Cx, row: Row }, x: Expr| {
        let o: Inferred = infer(acc.cx, x);
        let j: WithRow = join(o.cx, l.span, acc.row, o.row);
        { cx: expect(j.cx, expr_span(x), elem.t, o.ty, b"list elements must agree").cx, row: j.r }
      });
      { cx: items.cx, ty: t_list(elem.t), row: items.row }
    },
    EPerform(p) -> infer_perform(cx, p.span, p.eff, p.op, p.resource, p.args),
    EHandle(h) -> infer_handle(cx, h.span, h.body, h.clauses, h.ret),
    EWithCell(c) -> infer_with_cell(cx, c.span, c.resource, c.init, c.binder, c.body),
    EWithRegion(w) -> infer_with_region(cx, w.region, w.body),
    ESimulate(s) -> infer_simulate(cx, s.span, s.body),
  }

// `{..b, f: e}` answers the base's own record type with the written fields replaced, and publishes the
// base's field list for the lowering. A base whose type the substitution does not hold yet waits for
// `settle_updates`, so a lambda parameter the callee only types later still has a shape.
fn infer_record_update(cx: Cx, span: Span, base: Expr, written: List<RecField>) -> Inferred = {
  let b: Inferred = infer(cx, base);
  let fs = fold(written, { cx: b.cx, fs: [], row: b.row }, |acc: { cx: Cx, fs: List<UpdField>, row: Row }, f: RecField| {
    let o: Inferred = infer(acc.cx, f.value);
    let j: WithRow = join(o.cx, span, acc.row, o.row);
    { cx: j.cx, fs: push(acc.fs, { name: f.name.name, span: f.name.span, ty: o.ty }), row: j.r }
  });
  let base_span = expr_span(base);
  match resolve(fs.cx, b.ty) {
    TyVar(_) -> {
      let t: WithTy = new_ty(fs.cx);
      let c: Cx = t.cx;
      { cx: {..c, updates: push(c.updates, { module: c.module, span: span, base_span: base_span,
                                             base: b.ty, written: fs.fs, result: t.t })},
        ty: t.t, row: fs.row }
    },
    shape -> {
      let o: WithTy = update_shape(fs.cx, span, base_span, shape, fs.fs);
      { cx: o.cx, ty: o.t, row: fs.row }
    },
  }
}

// The type an update answers, and the field list the lowering copies from, once the base's type is known.
fn update_shape(cx: Cx, span: Span, base_span: Span, base: Type, written: List<UpdField>) -> WithTy =
  match base {
    TyRecord(fs) -> {
      let known = backticked(map(fs, |f: Field| f.name), b", ");
      let checked: Cx = fold(written, cx, |c: Cx, w: UpdField|
        match field_get(fs, w.name) {
          Some(_) -> c,
          None -> err2(c, b"E0117", w.span,
                       bytes_concat_all([b"the record being updated has no field `", w.name, b"`"]),
                       b"not a field of the base", here(c, base_span), b"this is the record being updated",
                       [bytes_concat(b"an update replaces fields, it does not add them; available fields: ", known)]),
        });
      // A name the base lacks is reported, not added: the answer is the base's record either way.
      let kept = filter(written, |w: UpdField| match field_get(fs, w.name) { Some(_) -> true, None -> false });
      { cx: {..checked, update_shapes: push(checked.update_shapes,
                                            { module: checked.module, span: span, names: map(fs, |f: Field| f.name) })},
        t: TyRecord(fields_sorted(append(fs, map(kept, |w: UpdField| { name: w.name, ty: w.ty })))) }
    },
    TyVar(_) -> new_ty(err1(cx, b"E0116", base_span, b"the type of the record being updated is not known here",
                            b"nothing here says which record this is",
                            [b"annotate the binder, the lambda parameter or the function this call answers from"])),
    other -> new_ty(err1(cx, b"E0116", base_span, b"the value being updated is not a record",
                         bytes_concat_all([b"this has type `", type_text(other), b"`"]),
                         [b"`{..b, f: e}` replaces fields of a record, and only a record has fields"])),
  }

// An update whose base was still a variable where it stood: the substitution is complete here.
fn settle_updates(cx: Cx) -> Cx = {
  let entries = cx.updates;
  fold(entries, {..cx, updates: []}, |c: Cx, entry: UpdateSite| {
    let at_: Cx = {..c, module: entry.module};
    let o: WithTy = update_shape(at_, entry.span, entry.base_span, resolve(at_, entry.base), entry.written);
    let unified: Cx = expect(o.cx, entry.span, entry.result, o.t, b"record update").cx;
    {..unified, module: c.module}
  })
}

fn infer_var(cx: Cx, q: QName) -> Inferred = {
  let k: WithKey = value_key(cx, q);
  match k.key {
    None -> { let o: WithTy = new_ty(k.cx); { cx: o.cx, ty: o.t, row: row_empty() } },
    Some(key) ->
      if key.prelude && is_cell_builtin(key.name) {
        let o: WithTy = new_ty(err1(k.cx, b"E0304", q.span, bytes_concat_all([b"`", key.name, b"` must be called directly"]), b"used as a value",
                                    [b"the atom it performs names the region of the cell it is given, so it cannot be passed around as a first-class function"]));
        { cx: o.cx, ty: o.t, row: row_empty() }
      } else {
        match env_lookup(k.cx.env, key.name) {
          Some(sc) -> {
            let inst = instantiate_with(sc, k.cx.fresh);
            let c: Cx = {..k.cx, fresh: inst.f};
            let noted: Cx = note_constraints(note_map_keys(c, q.span, inst.ty), q.span, key.name, inst.args);
            let group = group_label_vars(noted, key.name);
            let ls = if len(group) > 0 { map(group, |v: Int| TyVar(v)) } else { inst.labels };
            { cx: note_labels(noted, q.span, key.name, ls), ty: inst.ty, row: row_empty() }
          },
          None -> { let o: WithTy = new_ty(unknown_name(k.cx, q)); { cx: o.cx, ty: o.t, row: row_empty() } },
        }
      },
  }
}

// `Int` and the eight widths are the integer types; the bit operators are defined at those nine only.
fn is_int_name(n: Bytes) -> Bool =
  n == b"Int" || n == b"U8" || n == b"U16" || n == b"U32" || n == b"U64"
  || n == b"I8" || n == b"I16" || n == b"I32" || n == b"I64"

fn is_arithmetic(op: Bytes) -> Bool = op == b"add" || op == b"sub" || op == b"mul" || op == b"div" || op == b"rem"
fn is_ordered(op: Bytes) -> Bool = op == b"lt" || op == b"le" || op == b"gt" || op == b"ge"
fn is_bits(op: Bytes) -> Bool = op == b"bitand" || op == b"bitor" || op == b"bitxor" || op == b"shl" || op == b"shr" || op == b"ushr"

// The two types `++` joins, when the substitution already says which one this is.
fn concat_name(t: Type) -> Option<Bytes> =
  match t {
    TyCon(k) -> if len(k.args) == 0 && (k.name == b"String" || k.name == b"Bytes") { Some(k.name) } else { None },
    _ -> None,
  }

// `String ++ Bytes` names both sides rather than reporting one against the other; there is no coercion.
fn mixed_concat(cx: Cx, lspan: Span, lt: Type, rspan: Span, rt: Type) -> Option<Cx> =
  match concat_name(lt) {
    None -> None,
    Some(ln) -> match concat_name(rt) {
      None -> None,
      Some(rn) ->
        if ln == rn { None } else {
          Some(err_labels(cx, b"E0201", bytes_concat_all([b"`++` cannot join `", ln, b"` and `", rn, b"`"]),
                          [lab(cx.module, lspan, true, bytes_concat_all([b"this is a `", ln, b"`"])),
                           lab(cx.module, rspan, false, bytes_concat_all([b"this is a `", rn, b"`"]))],
                          [b"there is no coercion between them: `bytes_of_string` and `string_of_bytes` cross"]))
        },
    },
  }

fn infer_binary(cx: Cx, span: Span, op: Bytes, lhs: Expr, rhs: Expr) -> Inferred = {
  let l: Inferred = infer(cx, lhs);
  let r: Inferred = infer(l.cx, rhs);
  let j: WithRow = join(r.cx, span, l.row, r.row);
  let c: Cx = j.cx;
  if is_arithmetic(op) || is_ordered(op) {
    let x: Expected = expect(c, expr_span(rhs), l.ty, r.ty, b"both sides of a comparison must have one type");
    let noted: Cx = if x.ok { {..x.cx, numerics: push(x.cx.numerics, { span: span, op: op, ty: l.ty })} } else { x.cx };
    { cx: noted, ty: if is_arithmetic(op) { l.ty } else { t_bool() }, row: j.r }
  } else if is_bits(op) {
    // A shift's right operand is a count: an `Int` whatever the word is.
    let shifting = op == b"shl" || op == b"shr" || op == b"ushr";
    let c1: Cx = note_bits(c, expr_span(lhs), l.ty, bytes_concat_all([b"the left operand of `", bits_text(op), b"`"]));
    let c2: Cx =
      if shifting {
        expect(c1, expr_span(rhs), t_int(), r.ty,
          bytes_concat_all([b"the count of a `", bits_text(op), b"` is an `Int`"])).cx
      } else {
        let c1b: Cx = note_bits(c1, expr_span(rhs), r.ty, bytes_concat_all([b"the right operand of `", bits_text(op), b"`"]));
        expect(c1b, expr_span(rhs), l.ty, r.ty,
          bytes_concat_all([b"both operands of `", bits_text(op), b"` have one type"])).cx
      };
    { cx: c2, ty: l.ty, row: j.r }
  } else if op == b"and" || op == b"or" {
    let c1: Cx = expect(c, expr_span(lhs), t_bool(), l.ty, b"left operand").cx;
    let c2: Cx = expect(c1, expr_span(rhs), t_bool(), r.ty, b"right operand").cx;
    { cx: c2, ty: t_bool(), row: j.r }
  } else if op == b"concat" {
    match mixed_concat(c, expr_span(lhs), resolve(c, l.ty), expr_span(rhs), resolve(c, r.ty)) {
      Some(reported) -> { cx: reported, ty: l.ty, row: j.r },
      None -> {
        let x: Expected = expect(c, expr_span(rhs), l.ty, r.ty, b"both operands of `++` have one type");
        let noted: Cx = if x.ok { {..x.cx, concats: push(x.cx.concats, { module: x.cx.module, span: span, ty: l.ty })} } else { x.cx };
        { cx: noted, ty: l.ty, row: j.r }
      },
    }
  } else {
    let c1: Cx = expect(c, expr_span(rhs), l.ty, r.ty, b"both sides of a comparison must have one type").cx;
    { cx: {..c1, comparisons: push(c1.comparisons, { module: c1.module, span: span, ty: l.ty })}, ty: t_bool(), row: j.r }
  }
}

fn infer_stmt(cx: Cx, s: Stmt) -> { cx: Cx, row: Row } =
  match s {
    SExpr(e) -> { let o: Inferred = infer(cx, e); { cx: o.cx, row: o.row } },
    SLet(l) -> {
      let v: Inferred = infer(cx, l.value);
      let annotated: { cx: Cx, ty: Type } = match l.ty {
        Some(te) -> { let w: WithTy = conv_type(v.cx, te); let x: Expected = expect(w.cx, expr_span(l.value), w.t, v.ty, b"`let` annotation"); { cx: x.cx, ty: w.t } },
        None -> { cx: v.cx, ty: v.ty },
      };
      let b: Bound = bind_pattern(annotated.cx, l.pat, annotated.ty, []);
      { cx: bind_all(b.cx, b.out), row: v.row }
    },
  }

fn infer_app(cx: Cx, span: Span, func: Expr, args: List<Expr>, labels: List<Ident>) -> Inferred =
  match func {
    EVar(v) ->
      match cell_form(cx, v.name) {
        Some(form) -> infer_cell_op(fill_labels(cx, span, labels, None), span, args, form),
        None -> infer_app_general(cx, span, func, args, labels),
      },
    _ -> infer_app_general(cx, span, func, args, labels),
  }

fn group_label_vars(cx: Cx, name: Bytes) -> List<Int> =
  fold(cx.group_labels, [], |acc: List<Int>, g: { name: Bytes, vars: List<Int> }| if g.name == name { g.vars } else { acc })

// Every use of a label-generic definition, so a call can fill its labels and a settled component
// can say which ones it filled them with.
fn note_labels(cx: Cx, span: Span, callee: Bytes, labels: List<Type>) -> Cx =
  if len(labels) == 0 { cx } else {
    {..cx, label_apps: push(cx.label_apps,
      { module: cx.module, span: span, callee: callee,
        vars: map(labels, |t: Type| match t { TyVar(v) -> v, _ -> 0 - 1 }),
        params: cx.label_params, called: false })}
  }

// The use recorded for the name this call applies, when the callee is label-generic.
fn callee_labels(cx: Cx, span: Span) -> Option<LabelApp> =
  match list_at(cx.label_apps, len(cx.label_apps) - 1) {
    Some(a) -> if a.module == cx.module && a.span == span { Some(a) } else { None },
    None -> None,
  }

// The labels written at a call fill the callee's label parameters left to right.
fn fill_labels(cx: Cx, span: Span, labels: List<Ident>, app: Option<LabelApp>) -> Cx =
  match app {
    None -> if len(labels) == 0 { cx } else { wrong_labels(cx, labels, None, 0) },
    // A count that does not match is reported here, and the use dropped rather than reported twice.
    Some(a) ->
      if len(labels) > 0 && len(labels) != len(a.vars) {
        wrong_labels({..cx, label_apps: take(cx.label_apps, len(cx.label_apps) - 1)}, labels, Some(a.callee), len(a.vars))
      } else {
        let marked: Cx = {..cx, label_apps: set_at(cx.label_apps, len(cx.label_apps) - 1,
          { module: a.module, span: span, callee: a.callee, vars: a.vars, params: a.params, called: true })};
        if len(labels) > 0 && is_sibling(marked, a.callee) { group_labels_written(marked, a, labels) } else {
          // A name a binder holds is that label parameter, as it is inside a row; anything else is a resource.
          fold(range(0, len(labels)), marked, |c: Cx, i: Int| {
            let want = match map_get(c.label_params, at(labels, i).name) { Some(w) -> TyVar(w), None -> label_type(at(labels, i).name) };
            with_unified(c, unify(c.subst, c.fresh, TyVar(at(a.vars, i)), want))
          })
        }
      },
  }

// A callee checked in the same recursive group as the body calling it: its labels are the group's.
fn is_sibling(cx: Cx, name: Bytes) -> Bool = len(group_label_vars(cx, name)) > 0

// A call inside a recursive group keeps the labels the group was called with, so a label written
// there names the caller's own binder in that place, and anything else is refused.
fn group_labels_written(cx: Cx, a: LabelApp, labels: List<Ident>) -> Cx =
  fold(range(0, len(labels)), cx, |c: Cx, i: Int|
    match map_get(c.label_params, at(labels, i).name) {
      Some(v) -> if v == at(a.vars, i) { c } else { group_label_refused(c, a, at(labels, i)) },
      None -> group_label_refused(c, a, at(labels, i)),
    })

fn group_label_refused(cx: Cx, a: LabelApp, written: Ident) -> Cx = {
  let own = fold(a.vars, [], |acc: List<Bytes>, v: Int|
    match param_named(a.params, v) { Some(n) -> push(acc, n), None -> acc });
  let callee = simple_name_of(a.callee);
  let help =
    if len(own) < len(a.vars) { b"a call inside a recursive group passes the caller's labels along, so it writes none of its own" }
    else { bytes_concat_all([b"write `", callee, b"(..)`, or name this definition's own binders in order, as `",
                             callee, b"[", join_with(own, b", "), b"](..)`"]) };
  err1(cx, b"E0306", written.span,
       bytes_concat_all([b"a call to `", callee, b"` inside its own recursive group keeps the labels the group was called with"]),
       bytes_concat_all([b"`", written.name, b"` is written here"]), [help])
}

fn wrong_labels(cx: Cx, labels: List<Ident>, callee: Option<Bytes>, want: Int) -> Cx = {
  let at_ = span_to(at(labels, 0).span, at(labels, len(labels) - 1).span);
  let who = match callee { Some(n) -> bytes_concat_all([b"`", simple_name_of(n), b"`"]), None -> b"this callee" };
  let message = if want == 0 { bytes_concat_all([who, b" takes no label parameters"]) }
                else { bytes_concat_all([who, b" takes ", num(want), b" label parameter", plural(want),
                                         b", but ", num(len(labels)), b" ", if len(labels) == 1 { b"is" } else { b"are" }, b" written"]) };
  let help = [b"the labels at a call fill the `[l]` binders of the definition's generic list, left to right"];
  match callee {
    Some(n) -> match def_of(cx, n) {
      Some(d) -> err2(cx, b"E0306", at_, message, b"label instantiation", d.at, b"declared here", help),
      None -> err1(cx, b"E0306", at_, message, b"label instantiation", help),
    },
    None -> err1(cx, b"E0306", at_, message, b"label instantiation", help),
  }
}

// Builtins whose first parameter must be an integer type, checked per call: a scheme cannot say "an integer".
fn int_builtin_name(func: Expr) -> Bytes =
  match func {
    EVar(v) -> if is_bare(v.name) { v.name.name.name } else { b"" },
    _ -> b"",
  }

fn is_int_builtin(func: Expr) -> Bool = {
  let n = int_builtin_name(func);
  n == b"wrap_add" || n == b"wrap_sub" || n == b"wrap_mul" || n == b"rotr"
}

fn infer_app_general(cx: Cx, span: Span, func: Expr, args: List<Expr>, labels: List<Ident>) -> Inferred = {
  let f0: Inferred = infer(cx, func);
  // Before the arguments, so a written label is what an argument's row is checked against.
  let f: Inferred = { cx: fill_labels(f0.cx, span, labels, callee_labels(f0.cx, expr_span(func))), ty: f0.ty, row: f0.row };
  let as_: { cx: Cx, tys: List<Type>, row: Row } = infer_all(f.cx, args, span);
  let j0: WithRow = join(as_.cx, span, f.row, as_.row);
  let c: Cx = j0.cx;
  match resolve(c, f.ty) {
    TyFn(fn_) ->
      if len(fn_.params) != len(args) {
        let n = len(fn_.params);
        let reported: Cx = err_labels(c, b"E0202",
          bytes_concat_all([b"this function takes ", num(n), b" argument", plural(n), b", but ", supplied(len(args))]),
          [lab(c.module, span, true, bytes_concat_all([b"expected ", num(n), b", found ", num(len(args))])),
           lab(c.module, expr_span(func), false, b"this is the function being called")], []);
        let j: WithRow = join(reported, span, j0.r, fn_.effects);
        { cx: j.cx, ty: fn_.ret, row: j.r }
      } else {
        let checked: Cx = fold(range(0, len(args)), c, |cc: Cx, i: Int| expect(cc, expr_span(at(args, i)), at(fn_.params, i), at(as_.tys, i), b"argument type").cx);
        // `forall a.` alone would admit two `String`s, so the integer obligation goes on the instantiated variable here.
        let obliged: Cx =
          if is_int_builtin(func) && len(fn_.params) > 0 {
            note_bits(checked, span, at(fn_.params, 0), bytes_concat_all([b"`", int_builtin_name(func), b"`"]))
          } else { checked };
        let effects = resolve_r(obliged, fn_.effects);
        let source = callee_source(obliged, func);
        let recorded: Cx = fold(effects.atoms, obliged, |cc: Cx, a: Atom| record_site(cc, a, span, source));
        let j: WithRow = join(recorded, span, j0.r, effects);
        { cx: j.cx, ty: fn_.ret, row: j.r }
      },
    TyVar(_) -> {
      let ret: WithTy = new_ty(c);
      let eff: WithRow = new_row(ret.cx);
      let want = t_fn(as_.tys, ret.t, eff.r);
      let x: Expected = expect(eff.cx, expr_span(func), want, f.ty, b"callee type");
      let j: WithRow = join(x.cx, span, j0.r, eff.r);
      { cx: j.cx, ty: ret.t, row: j.r }
    },
    other -> {
      let o: WithTy = new_ty(err1(c, b"E0204", expr_span(func), b"this is not a function",
                                  bytes_concat_all([b"has type `", type_text(other), b"`"]), [b"only function values can be applied"]));
      { cx: o.cx, ty: o.t, row: j0.r }
    },
  }
}

fn cell_form_name(form: CellForm) -> Bytes = match form { CGet -> b"cell_get", CSet -> b"cell_set", CUpdate -> b"cell_update" }

fn infer_cell_op(cx: Cx, span: Span, args: List<Expr>, form: CellForm) -> Inferred = {
  let expected = match form { CGet -> 1, CSet -> 2, CUpdate -> 2 };
  let as_: { cx: Cx, tys: List<Type>, row: Row } = infer_all(cx, args, span);
  if len(args) != expected {
    let o: WithTy = new_ty(arity_error(as_.cx, span, cell_form_name(form), expected, len(args), b"arguments"));
    { cx: o.cx, ty: o.t, row: as_.row }
  } else {
    let region: WithTy = new_ty(as_.cx);
    let elem: WithTy = new_ty(region.cx);
    let cell_ty = TyCon({ name: b"Cell", args: [region.t, elem.t] });
    let c0: Cx = expect(elem.cx, expr_span(at(args, 0)), cell_ty, at(as_.tys, 0), b"cell argument").cx;
    let after = match form {
      CGet -> { cx: c0, row: as_.row },
      CSet -> { cx: expect(c0, expr_span(at(args, 1)), elem.t, at(as_.tys, 1), b"value stored into the cell").cx, row: as_.row },
      CUpdate -> {
        let eff: WithRow = new_row(c0);
        let f = t_fn([elem.t], elem.t, eff.r);
        let x: Cx = expect(eff.cx, expr_span(at(args, 1)), f, at(as_.tys, 1), b"function applied to the cell's contents").cx;
        let j: WithRow = join(x, span, as_.row, eff.r);
        { cx: j.cx, row: j.r }
      },
    };
    let ret = match form { CGet -> elem.t, _ -> t_unit() };
    match region_of(resolve(after.cx, region.t)) {
      None -> { cx: err1(after.cx, b"E0304", expr_span(at(args, 0)),
                         bytes_concat_all([b"cannot tell which `with_cell` region `", cell_form_name(form), b"` acts on"]),
                         b"this cell's region is unknown here",
                         [b"call it on the binder introduced by `with_cell[r](..) { c -> .. }`, so the `cell.read[r]` / `cell.write[r]` atoms can be discharged at the region boundary"]),
                ty: ret, row: after.row },
      Some(resource) -> {
        let modes = match form { CGet -> [MRead], CSet -> [MWrite], CUpdate -> [MRead, MWrite] };
        let out = fold(modes, { cx: after.cx, row: after.row }, |acc: { cx: Cx, row: Row }, m: Mode| {
          let atom = { effect: cell(), resource: RNamed(resource), mode: m, op: None };
          let j: WithRow = join(record_site(acc.cx, atom, span, SDirect), span, acc.row, row_singleton(atom));
          { cx: j.cx, row: j.r }
        });
        { cx: out.cx, ty: ret, row: out.row }
      },
    }
  }
}

// --- Patterns and matches -----------------------------------------------------------------------

type Bound = { cx: Cx, out: List<{ name: Bytes, ty: Type }> }

fn bind_pattern(cx: Cx, p: Pattern, scrutinee: Type, out: List<{ name: Bytes, ty: Type }>) -> Bound =
  match p {
    PWild(_) -> { cx: cx, out: out },
    PBad(_) -> { cx: cx, out: out },
    PVar(v) -> { cx: cx, out: push(out, { name: v.name.name, ty: scrutinee }) },
    PLit(l) -> { cx: expect(cx, l.span, scrutinee, lit_type(l.lit), b"pattern literal").cx, out: out },
    PCtor(c) -> {
      let n: WithName = ctor_name(cx, c.name);
      let info = match n.name { Some(q) -> ctor_of(n.cx, q), None -> None };
      match info {
        None ->
          if is_bare(c.name) || (match declared_value(n.cx, c.name) { Some(_) -> true, None -> false }) {
            let nm = c.name.name.name;
            let base = [b"constructors come from a `type` declaration with variants"];
            let notes = match builtin_type_arity(nm) {
              None -> base,
              Some(_) -> {
                let with_builtin = push(base, bytes_concat_all([b"`", nm, b"` is a builtin type and declares none"]));
                if nm == b"Secret" {
                  push(push(with_builtin, b"that is deliberate: a pattern binding the payload would be a one-line escape from every guarantee `Secret` makes"),
                       b"use `secret_verify` to check a candidate, `secret_is_empty` to check presence, or hand the whole `Secret` to a handler clause")
                } else { with_builtin }
              },
            };
            { cx: err1(n.cx, b"E0101", c.name.span, bytes_concat_all([b"unknown constructor `", nm, b"`"]), b"not found", notes), out: out }
          } else { { cx: n.cx, out: out } },
        Some(ci) -> {
          let inst = instantiate(ci.scheme, n.cx.fresh);
          let c1: Cx = {..n.cx, fresh: inst.f};
          let shape = match inst.ty { TyFn(f) -> { fields: f.params, result: f.ret }, other -> { fields: [], result: other } };
          let c2: Cx = expect(c1, c.span, scrutinee, shape.result, b"pattern constructor").cx;
          let nf = len(shape.fields);
          if nf != len(c.args) {
            { cx: err2(c2, b"E0202", c.span,
                       bytes_concat_all([b"constructor `", ci.name, b"` takes ", num(nf), b" field", plural(nf), b", but the pattern binds ", num(len(c.args))]),
                       bytes_concat_all([b"expected ", num(nf), b" fields"]), ci.at, b"declared here", []),
              out: out }
          }
          else {
            fold(range(0, len(c.args)), { cx: c2, out: out }, |acc: Bound, i: Int| bind_pattern(acc.cx, at(c.args, i), at(shape.fields, i), acc.out))
          }
        },
      }
    },
    PList(l) -> {
      let elem: WithTy = new_ty(cx);
      let c1: Cx = expect(elem.cx, l.span, scrutinee, t_list(elem.t), b"list pattern").cx;
      let items = fold(l.items, { cx: c1, out: out }, |acc: Bound, x: Pattern| bind_pattern(acc.cx, x, elem.t, acc.out));
      match l.rest { Some(r) -> bind_pattern(items.cx, r, t_list(elem.t), items.out), None -> items }
    },
    PRecord(r) ->
      match resolve(cx, scrutinee) {
        TyRecord(known) -> {
          let bound: Bound = fold(r.fields, { cx: cx, out: out }, |acc: Bound, f: { name: Ident, pat: Pattern }|
            match field_get(known, f.name.name) {
              Some(t) -> bind_pattern(acc.cx, f.pat, t, acc.out),
              None -> { cx: err1(acc.cx, b"E0101", f.name.span, bytes_concat_all([b"no field `", f.name.name, b"` on this record"]), b"unknown field", []), out: acc.out },
            });
          if r.rest { bound } else {
            let named = map(r.fields, |f: { name: Ident, pat: Pattern }| f.name.name);
            let omitted = filter(known, |k: Field| !contains_bytes(named, k.name));
            if len(omitted) > 0 {
              { cx: err1(bound.cx, b"E0201", r.span, b"record pattern does not name every field",
                         bytes_concat(b"missing: ", backticked(map(omitted, |k: Field| k.name), b", ")),
                         [b"add the missing fields, or end the pattern with `..`"]),
                out: bound.out }
            } else { bound }
          }
        },
        _ ->
          if r.rest {
            { cx: err1(cx, b"E0201", r.span, b"cannot infer the record type of this pattern",
                       b"a `..` pattern needs the record type to be known", [b"annotate the matched value"]),
              out: out }
          } else {
            let fs = fold(r.fields, { cx: cx, fs: [], out: out }, |acc: { cx: Cx, fs: List<Field>, out: List<{ name: Bytes, ty: Type }> }, f: { name: Ident, pat: Pattern }| {
              let t: WithTy = new_ty(acc.cx);
              let b: Bound = bind_pattern(t.cx, f.pat, t.t, acc.out);
              { cx: b.cx, fs: push(acc.fs, { name: f.name.name, ty: t.t }), out: b.out }
            });
            { cx: expect(fs.cx, r.span, scrutinee, TyRecord(fields_sorted(fs.fs)), b"record pattern").cx, out: fs.out }
          },
      },
  }

fn infer_match(cx: Cx, span: Span, scrutinee: Expr, arms: List<MatchArm>) -> Inferred = {
  let s: Inferred = infer(cx, scrutinee);
  let result: WithTy = new_ty(s.cx);
  let walked: WithBodyRow = fold(arms, { cx: result.cx, row: s.row }, |acc: { cx: Cx, row: Row }, arm: MatchArm| {
    let pushed: Cx = {..acc.cx, env: env_push(acc.cx.env)};
    let b: Bound = bind_pattern(pushed, arm.pat, s.ty, []);
    let bound: Cx = bind_all(b.cx, b.out);
    let guarded: WithBodyRow = match arm.guard {
      Some(g) -> {
        let o: Inferred = infer(bound, g);
        let c: Cx = expect(o.cx, expr_span(g), t_bool(), o.ty, b"match guard").cx;
        let j: WithRow = join(c, span, acc.row, o.row);
        { cx: j.cx, row: j.r }
      },
      None -> { cx: bound, row: acc.row },
    };
    let body: Inferred = infer(guarded.cx, arm.body);
    let j: WithRow = join(body.cx, span, guarded.row, body.row);
    let popped: Cx = {..j.cx, env: env_pop(j.cx.env)};
    { cx: expect(popped, expr_span(arm.body), result.t, body.ty, b"match arms must agree").cx, row: j.r }
  });
  { cx: check_exhaustive(walked.cx, span, arms), ty: result.t, row: walked.row }
}

// --- Exhaustiveness: usefulness over a matrix with one row per unguarded arm ---------------------

// `XNone` is a constructor that does not resolve: it matches nothing, so its arm covers nothing.
type XPat =
  | XAny
  | XNone
  | XCon({ family: Bytes, key: Bytes, name: Bytes, args: List<XPat> })
  | XRec(List<{ name: Bytes, pat: XPat }>)

type XCtor = { key: Bytes, name: Bytes, arity: Int }

fn check_exhaustive(cx: Cx, span: Span, arms: List<MatchArm>) -> Cx = {
  let rows = fold(arms, [], |acc: List<List<XPat>>, a: MatchArm| match a.guard { None -> push(acc, [coverage_pat(cx, a.pat)]), Some(_) -> acc });
  let missing = uncovered(cx, rows, 1);
  if len(missing) == 0 { cx } else {
    err1(cx, b"E0205", span, b"match does not cover every case",
         bytes_concat(b"not covered: ", join_with(map(missing, |w: List<XPat>| tick(shown(at(w, 0)))), b", ")),
         [b"add the missing arms, or a `_` arm"])
  }
}

fn coverage_pat(cx: Cx, p: Pattern) -> XPat =
  match p {
    PCtor(c) -> {
      let info = match covered_ctor(cx, c.name) { Some(q) -> ctor_of(cx, q), None -> None };
      match info {
        Some(k) -> XCon({ family: k.type_name, key: k.name, name: k.simple_name, args: map(c.args, |a: Pattern| coverage_pat(cx, a)) }),
        None -> XNone,
      }
    },
    PLit(l) ->
      match l.lit {
        LBool(b) -> { let k = if b { b"true" } else { b"false" }; XCon({ family: b"#bool", key: k, name: k, args: [] }) },
        LUnit -> XCon({ family: b"#unit", key: b"()", name: b"()", args: [] }),
        _ -> XCon({ family: b"#lit", key: b"", name: b"", args: [] }),
      },
    PList(l) -> {
      let n = len(l.items);
      let last = match l.rest { Some(r) -> coverage_pat(cx, r), None -> list_con(b"[]", []) };
      fold(range(0, n), last, |tail: XPat, i: Int| list_con(b"::", [coverage_pat(cx, at(l.items, n - 1 - i)), tail]))
    },
    PRecord(r) -> XRec(map(r.fields, |f: { name: Ident, pat: Pattern }| { name: f.name.name, pat: coverage_pat(cx, f.pat) })),
    _ -> XAny,
  }

fn list_con(key: Bytes, args: List<XPat>) -> XPat = XCon({ family: b"#list", key: key, name: key, args: args })

fn wilds(n: Int) -> List<XPat> = map(range(0, n), |_i: Int| XAny)

fn family_of(x: XPat) -> Bytes = match x { XCon(c) -> c.family, XRec(_) -> b"#rec", _ -> b"" }

fn heads_ctor(rows: List<List<XPat>>, family: Bytes, key: Bytes) -> Bool =
  fold(rows, false, |b: Bool, r: List<XPat>| b || (match at(r, 0) { XCon(c) -> c.family == family && c.key == key, _ -> false }))

// `None` for a family no list of arms exhausts: literals, and a column that names no constructor.
fn family_ctors(cx: Cx, family: Bytes) -> Option<List<XCtor>> =
  if family == b"#bool" { Some([{ key: b"true", name: b"true", arity: 0 }, { key: b"false", name: b"false", arity: 0 }]) }
  else if family == b"#unit" { Some([{ key: b"()", name: b"()", arity: 0 }]) }
  else if family == b"#list" { Some([{ key: b"[]", name: b"[]", arity: 0 }, { key: b"::", name: b"::", arity: 2 }]) }
  else if family == b"#lit" || family == b"" { None }
  else { Some(map(filter(cx.ctors, |k: CtorInfo| k.type_name == family), |k: CtorInfo| { key: k.name, name: k.simple_name, arity: k.arity })) }

// Rows of values no row matches, each `n` wide; empty when the rows are exhaustive.
fn uncovered(cx: Cx, rows: List<List<XPat>>, n: Int) -> List<List<XPat>> =
  if len(rows) == 0 { [wilds(n)] }
  else if n == 0 { [] }
  else {
    let family = fold(rows, b"", |acc: Bytes, r: List<XPat>| if bytes_len(acc) > 0 { acc } else { family_of(at(r, 0)) });
    if family == b"#rec" { uncovered_record(cx, rows, n) } else {
      match family_ctors(cx, family) {
        None -> map(uncovered(cx, default_rows(rows, family), n - 1), |w: List<XPat>| push_front(XAny, w)),
        Some(all) ->
          if fold(all, true, |b: Bool, k: XCtor| b && heads_ctor(rows, family, k.key)) {
            fold(all, [], |acc: List<List<XPat>>, k: XCtor| append(acc, through(cx, rows, n, family, k)))
          } else {
            // A constructor no arm names is left uncovered exactly when the default rows are; then the named ones are searched too.
            match list_at(uncovered(cx, default_rows(rows, family), n - 1), 0) {
              None -> [],
              Some(w) -> fold(all, [], |acc: List<List<XPat>>, k: XCtor|
                if heads_ctor(rows, family, k.key) { append(acc, through(cx, rows, n, family, k)) }
                else { push(acc, push_front(XCon({ family: family, key: k.key, name: k.name, args: wilds(k.arity) }), w)) }),
            }
          },
      }
    }
  }

fn through(cx: Cx, rows: List<List<XPat>>, n: Int, family: Bytes, k: XCtor) -> List<List<XPat>> =
  map(uncovered(cx, specialize(rows, family, k), k.arity + n - 1), |w: List<XPat>|
    push_front(XCon({ family: family, key: k.key, name: k.name, args: take(w, k.arity) }), drop(w, k.arity)))

// A head of another family, or of the wrong arity, counts as a wildcard: its error is already reported.
fn specialize(rows: List<List<XPat>>, family: Bytes, k: XCtor) -> List<List<XPat>> =
  fold(rows, [], |acc: List<List<XPat>>, r: List<XPat>|
    match at(r, 0) {
      XNone -> acc,
      XCon(c) ->
        if c.family != family { push(acc, append(wilds(k.arity), drop(r, 1))) }
        else if c.key != k.key { acc }
        else if len(c.args) == k.arity { push(acc, append(c.args, drop(r, 1))) }
        else { push(acc, append(wilds(k.arity), drop(r, 1))) },
      _ -> push(acc, append(wilds(k.arity), drop(r, 1))),
    })

fn default_rows(rows: List<List<XPat>>, family: Bytes) -> List<List<XPat>> =
  fold(rows, [], |acc: List<List<XPat>>, r: List<XPat>|
    match at(r, 0) {
      XNone -> acc,
      XCon(c) -> if c.family == family { acc } else { push(acc, drop(r, 1)) },
      _ -> push(acc, drop(r, 1)),
    })

// A record is one constructor over every field some arm names; the rest are wildcards everywhere.
fn uncovered_record(cx: Cx, rows: List<List<XPat>>, n: Int) -> List<List<XPat>> = {
  let names = fold(rows, [], |acc: List<Bytes>, r: List<XPat>|
    match at(r, 0) {
      XRec(fs) -> fold(fs, acc, |a: List<Bytes>, f: { name: Bytes, pat: XPat }| if contains_bytes(a, f.name) { a } else { push(a, f.name) }),
      _ -> acc,
    });
  let k = len(names);
  let spread = fold(rows, [], |acc: List<List<XPat>>, r: List<XPat>|
    match at(r, 0) {
      XNone -> acc,
      XRec(fs) -> push(acc, append(map(names, |nm: Bytes| field_pat(fs, nm)), drop(r, 1))),
      _ -> push(acc, append(wilds(k), drop(r, 1))),
    });
  map(uncovered(cx, spread, k + n - 1), |w: List<XPat>|
    push_front(XRec(map(range(0, k), |i: Int| { name: at(names, i), pat: at(w, i) })), drop(w, k)))
}

fn field_pat(fs: List<{ name: Bytes, pat: XPat }>, name: Bytes) -> XPat =
  fold(fs, XAny, |acc: XPat, f: { name: Bytes, pat: XPat }| if f.name == name { f.pat } else { acc })

fn shown(x: XPat) -> Bytes =
  match x {
    XCon(c) ->
      if c.family == b"#list" { shown_list(x, []) }
      else if len(c.args) == 0 { c.name }
      else { bytes_concat_all([c.name, b"(", join_with(map(c.args, |a: XPat| shown(a)), b", "), b")"]) },
    XRec(fs) -> shown_record(fs),
    _ -> b"_",
  }

fn shown_list(x: XPat, items: List<Bytes>) -> Bytes =
  match x {
    XCon(c) ->
      if c.key == b"::" && len(c.args) == 2 { shown_list(at(c.args, 1), push(items, shown(at(c.args, 0)))) }
      else { bytes_concat_all([b"[", join_with(items, b", "), b"]"]) },
    _ -> bytes_concat_all([b"[", join_with(push(items, b".."), b", "), b"]"]),
  }

// A tuple is the record `{_0, _1, ..}` and is shown as one; a record's other fields may be unnamed, so it ends in `..`.
fn shown_record(fs: List<{ name: Bytes, pat: XPat }>) -> Bytes = {
  let parts = map(fs, |f: { name: Bytes, pat: XPat }| shown(f.pat));
  let tuple = len(fs) > 1 && fold(range(0, len(fs)), true, |b: Bool, i: Int| b && at(fs, i).name == bytes_concat(b"_", num(i)));
  if !fold(parts, false, |b: Bool, t: Bytes| b || t != b"_") { b"_" }
  else if tuple { bytes_concat_all([b"(", join_with(parts, b", "), b")"]) }
  else {
    let named = filter(range(0, len(fs)), |i: Int| at(parts, i) != b"_");
    bytes_concat_all([b"{", join_with(push(map(named, |i: Int| bytes_concat_all([at(fs, i).name, b": ", at(parts, i)])), b".."), b", "), b"}"])
  }
}

// --- Effects ----------------------------------------------------------------------------------

fn resolve_op(cx: Cx, eff: QName, op: Ident) -> { cx: Cx, hit: Option<{ info: EffectInfo, op: OpInfo }> } = {
  let e: WithName = effect_name(cx, eff);
  match e.name {
    None -> { cx: e.cx, hit: None },
    Some(name) ->
      match effect_of(e.cx, name) {
        None -> if name == cell() {
                  { cx: err1(e.cx, b"E0103", eff.span, b"`cell` is a builtin effect and cannot be performed directly", b"not a declared effect",
                             [b"read and write a region's cell with `cell_get(c)` and `cell_set(c, v)` inside `with_cell[r](..) { c -> .. }`"]),
                    hit: None }
                } else { { cx: e.cx, hit: None } },
        Some(info) ->
          match op_named(info, op.name) {
            Some(o) -> { cx: e.cx, hit: Some({ info: info, op: o }) },
            None -> {
              let known = map(info.ops, |o: OpInfo| o.name);
              { cx: err2(e.cx, b"E0104", op.span, bytes_concat_all([b"effect `", eff.name.name, b"` has no operation `", op.name, b"`"]), b"not declared",
                         info.at, bytes_concat_all([b"`", info.name, b"` is declared here"]),
                         [if len(known) == 0 { bytes_concat_all([b"`", info.name, b"` declares no operations"]) }
                          else { bytes_concat_all([b"operations of `", info.name, b"`: ", backticked(known, b", ")]) }]),
                hit: None }
            },
          },
      },
  }
}

// The effect as this module can write it, so a suggestion parses.
fn as_written(cx: Cx, eff: Bytes) -> Bytes = {
  let scope = scope_of(cx);
  match fold(scope.bound.effects, None, |acc: Option<Bytes>, b: Binding| match acc { Some(_) -> acc, None -> if b.qualified == eff { Some(b.name) } else { None } }) {
    Some(n) -> n,
    None -> {
      let simple = match effect_of(cx, eff) { Some(info) -> info.simple_name, None -> eff };
      match fold(scope.modules, None, |acc: Option<Bytes>, mb: ModBind|
                 match acc {
                   Some(_) -> acc,
                   None -> match dlookup(at(cx.r.declarations, mb.target), NEffect, simple) {
                     Some(d) -> if d.qualified == eff { Some(bytes_concat_all([mb.binder, b"::", simple])) } else { None },
                     None -> None,
                   },
                 }) {
        Some(w) -> w,
        None -> simple,
      }
    },
  }
}

fn resource_for(cx: Cx, info: EffectInfo, op: OpInfo, resource: Option<Ident>, span: Span) -> { cx: Cx, res: Option<Resource> } =
  match resource {
    Some(r) -> if op.resource_param { { cx: cx, res: Some(match map_get(cx.label_params, r.name) { Some(v) -> RVar(v), None -> RNamed(r.name) }) } } else {
      { cx: err2(cx, b"E0304", r.span, bytes_concat_all([b"`", info.name, b".", op.name, b"` is not resource-parameterized"]),
                 b"unexpected resource label", op.at, b"declared without `[r]`",
                 [bytes_concat_all([b"drop the label, or declare it as `", mode_key(op.mode), b" ", op.name, b"[r](..)`"])]),
        res: None }
    },
    None -> if op.resource_param {
      { cx: err2(cx, b"E0304", span, bytes_concat_all([b"`", info.name, b".", op.name, b"` is declared with a resource parameter"]),
                 b"missing the `[resource]` label", op.at, bytes_concat_all([b"declared as `", op.name, b"[r](..)`"]),
                 [bytes_concat_all([b"write `", as_written(cx, info.name), b".", op.name, b"[<resource>](..)`; the label is what lets two tests be scheduled together"])]),
        res: None }
    } else { { cx: cx, res: Some(RSingleton) } },
  }

fn op_free_vars(op: OpInfo) -> List<Int> = {
  let fv = fold(op.params, { tys: [], rows: [] }, |acc: Free, p: Type| free_vars(subst_new(), p, acc));
  free_vars(subst_new(), op.ret, fv).tys
}

fn op_scheme(op: OpInfo) -> Scheme =
  match op.scheme { Some(sc) -> sc, None -> { ty_vars: op_free_vars(op), row_vars: [], label_vars: [], ty: t_fn(op.params, op.ret, row_empty()) } }

type OpShape = { cx: Cx, params: List<Type>, ret: Type, row: Row }

fn instantiate_op(cx: Cx, op: OpInfo) -> OpShape = {
  let inst = instantiate(op_scheme(op), cx.fresh);
  let c: Cx = {..cx, fresh: inst.f};
  match inst.ty { TyFn(f) -> { cx: c, params: f.params, ret: f.ret, row: f.effects }, _ -> panic("operation schemes are function types") }
}

fn instantiate_op_for_clause(cx: Cx, op: OpInfo) -> OpShape = {
  let sc = op_scheme(op);
  let tys: { cx: Cx, vs: List<Int> } = fold(sc.ty_vars, { cx: cx, vs: [] }, |acc: { cx: Cx, vs: List<Int> }, v: Int| { let o: WithVar = new_ty_var(acc.cx); { cx: {..o.cx, subst: mark_rigid_ty(o.cx.subst, o.v)}, vs: push(acc.vs, o.v) } });
  let rows: { cx: Cx, vs: List<Int> } = fold(sc.row_vars, { cx: tys.cx, vs: [] }, |acc: { cx: Cx, vs: List<Int> }, v: Int| { let o: WithVar = new_row_var(acc.cx); { cx: {..o.cx, subst: mark_rigid_row(o.cx.subst, o.v)}, vs: push(acc.vs, o.v) } });
  match rename_scheme(sc, tys.vs, rows.vs, []) { TyFn(f) -> { cx: rows.cx, params: f.params, ret: f.ret, row: f.effects }, _ -> panic("operation schemes are function types") }
}

fn infer_perform(cx: Cx, span: Span, eff: QName, op: Ident, resource: Option<Ident>, args: List<Expr>) -> Inferred = {
  let as_: { cx: Cx, tys: List<Type>, row: Row } = infer_all(cx, args, span);
  let r: WithHit = resolve_op(as_.cx, eff, op);
  match r.hit {
    None -> { let o: WithTy = new_ty(r.cx); { cx: o.cx, ty: o.t, row: as_.row } },
    Some(hit) -> {
      let res: WithRes = resource_for(r.cx, hit.info, hit.op, resource, span);
      match res.res {
        None -> { let o: WithTy = new_ty(res.cx); { cx: o.cx, ty: o.t, row: as_.row } },
        Some(resource_) -> {
          let shape: OpShape = instantiate_op(res.cx, hit.op);
          if len(shape.params) != len(args) {
            let n = len(shape.params);
            { cx: err2(shape.cx, b"E0202", span,
                       bytes_concat_all([b"`", hit.info.simple_name, b".", hit.op.name, b"` takes ", num(n), b" argument", plural(n), b", but ", supplied(len(args))]),
                       bytes_concat_all([b"expected ", num(n), b", found ", num(len(args))]), hit.op.at, b"declared here", []),
              ty: shape.ret, row: as_.row }
          } else {
            let checked: Cx = fold(range(0, len(args)), shape.cx, |c: Cx, i: Int| expect(c, expr_span(at(args, i)), at(shape.params, i), at(as_.tys, i), b"operation argument").cx);
            let atom = { effect: hit.info.name, resource: resource_, mode: hit.op.mode, op: Some(hit.op.name) };
            let noted: Cx = note_handoff(note_spawn(checked, hit.info, hit.op, args, as_.tys), hit.info, hit.op, args, as_.tys);
            let c1: Cx = record_site(noted, atom, span, SDirect);
            let op_row = resolve_r(c1, shape.row);
            let c2: Cx = fold(op_row.atoms, c1, |c: Cx, a: Atom| record_site(c, a, span, SArgs));
            let j1: WithRow = join(c2, span, as_.row, op_row);
            let j2: WithRow = join(j1.cx, span, j1.r, row_singleton(atom));
            { cx: j2.cx, ty: shape.ret, row: j2.r }
          }
        },
      }
    },
  }
}

type HandleAcc = { cx: Cx, handled: List<Atom>, selected: List<OpKey>, clause_rows: Row }

fn infer_handle(cx: Cx, span: Span, body: Expr, clauses: List<HandleClause>, ret: Option<ReturnClause>) -> Inferred = {
  let mark = len(cx.performs);
  let b: Inferred = infer(cx, body);
  let general = fold(clauses, false, |acc: Bool, c: HandleClause| acc || (match c.resume { Some(_) -> true, None -> false }));
  let cont: { cx: Cx, v: Option<Int> } = if general { let o: WithVar = new_row_var(b.cx); { cx: o.cx, v: Some(o.v) } } else { { cx: b.cx, v: None } };
  let result_var: { cx: Cx, t: Option<Type> } = if general { let o: WithTy = new_ty(cont.cx); { cx: o.cx, t: Some(o.t) } } else { { cx: cont.cx, t: None } };
  let walked: HandleAcc = fold(clauses, { cx: result_var.cx, handled: [], selected: [], clause_rows: row_empty() }, |acc: HandleAcc, clause: HandleClause| {
    let r: WithHit = resolve_op(acc.cx, clause.eff, clause.op);
    match r.hit {
      None -> {..acc, cx: r.cx},
      Some(hit) -> {
        let res: WithRes = resource_for(r.cx, hit.info, hit.op, clause.resource, clause.span);
        match res.res {
          None -> {..acc, cx: res.cx},
          Some(resource_) -> {
            let shape: OpShape = instantiate_op_for_clause(res.cx, hit.op);
            if len(shape.params) != len(clause.params) {
              let bound = len(clause.params);
              {..acc, cx: err2(shape.cx, b"E0202", clause.span,
                 bytes_concat_all([b"the clause for `", hit.info.name, b".", hit.op.name, b"` binds ", num(bound), b" parameter", plural(bound), b", but the operation takes ", num(len(shape.params))]),
                 bytes_concat_all([b"expected ", num(len(shape.params)), b" parameters"]), hit.op.at, b"declared here", [])}
            } else {
              let atom = { effect: hit.info.name, resource: resource_, mode: hit.op.mode, op: None };
              let key = { effect: hit.info.name, op: hit.op.name, res: resource_ };
              let dup = fold(acc.selected, false, |d: Bool, k: OpKey| d || k == key);
              let c0: Cx = if dup {
                let res_text = match clause.resource { Some(r) -> bytes_concat_all([b"[", r.name, b"]"]), None -> b"" };
                report(shape.cx, { code: b"E0105", notes: 1, labels: [lab(shape.cx.module, clause.span, true, b"this clause is unreachable")], text: b"",
                                   message: bytes_concat_all([b"`", hit.info.name, b".", hit.op.name, res_text, b"` is handled more than once"]),
                                   notes_text: [b"the first matching clause wins at run time"], severity: b"warning", fixes: [] })
              } else { shape.cx };
              let pushed: Cx = {..c0, env: env_push(c0.env)};
              let bound: Cx = fold(range(0, len(clause.params)), pushed, |c: Cx, i: Int| {..c, env: env_bind(c.env, at(clause.params, i).name, mono(at(shape.params, i)))});
              let with_resume: Cx = match clause.resume {
                Some(k) -> {
                  let result = match result_var.t { Some(t) -> t, None -> panic("a general clause is present") };
                  let row = match cont.v { Some(v) -> v, None -> panic("a general clause is present") };
                  {..bound, env: env_bind(bound.env, k.name, mono(t_fn([shape.ret], result, row_open(row))))}
                },
                None -> bound,
              };
              let body_: Inferred = infer(with_resume, clause.body);
              let popped: Cx = {..body_.cx, env: env_pop(body_.cx.env)};
              let checked: Cx = match clause.resume {
                Some(_) -> expect(popped, expr_span(clause.body), match result_var.t { Some(t) -> t, None -> shape.ret }, body_.ty,
                                  b"a clause that binds a continuation returns the `handle`'s result").cx,
                None -> {
                  let x: Expected = expect(popped, expr_span(clause.body), shape.ret, body_.ty, b"a handler clause returns the operation's result");
                  if !x.ok && len(op_free_vars(hit.op)) > 0 { note_universal_clause(x.cx, hit.info, hit.op) } else { x.cx }
                },
              };
              let j: WithRow = join(checked, span, acc.clause_rows, body_.row);
              { cx: j.cx, handled: atoms_insert(acc.handled, atom), selected: push(acc.selected, key), clause_rows: j.r }
            }
          },
        }
      },
    }
  });
  let body_mark = len(b.cx.performs);
  let returned = match ret {
    Some(rc) -> {
      let pushed: Cx = {..walked.cx, env: env_push(walked.cx.env)};
      let bound: Cx = {..pushed, env: env_bind(pushed.env, rc.binder.name, mono(b.ty))};
      let o: Inferred = infer(bound, rc.body);
      { cx: {..o.cx, env: env_pop(o.cx.env)}, ty: o.ty, row: o.row }
    },
    None -> { cx: walked.cx, ty: b.ty, row: row_empty() },
  };
  let agreed: Cx = match result_var.t { Some(t) -> expect(returned.cx, span, t, returned.ty, b"every clause of a `handle` produces its result").cx, None -> returned.cx };
  let body_row = resolve_r(agreed, b.row);
  let remaining = filter(body_row.atoms, |a: Atom| !clause_discharges(agreed, walked.handled, walked.selected, a));
  // An atom the clauses leave under a handled mode atom runs past this `handle`: refused unless the
  // enclosing definition's written row forwards it to the caller's handler.
  let missing = filter(remaining, |a: Atom| atoms_covered(walked.handled, a) && !atoms_covered(agreed.declared_atoms, a));
  let sites = resolved_sites(agreed.subst, take(drop(agreed.performs, mark), body_mark - mark));
  let after = fold(clauses, span.start, |acc: Int, cl: HandleClause| max(acc, expr_span(cl.body).end));
  let judged: Cx = if len(missing) == 0 { agreed } else { incomplete(agreed, span, after, sites, walked.handled, walked.selected, missing) };
  // A refused atom leaves the row with its report, so the signature is not told about it twice.
  let kept = atoms_difference(remaining, missing);
  let discharged: Cx = discharge(judged, mark, body_mark, atoms_difference(body_row.atoms, kept));
  let j1: WithRow = join(discharged, span, { atoms: kept, tail: body_row.tail }, walked.clause_rows);
  let j2: WithRow = join(j1.cx, span, j1.r, returned.row);
  let solved = match cont.v { Some(v) -> {..j2.cx, subst: solve_continuation_row(j2.cx.subst, v, j2.r)}, None -> j2.cx };
  { cx: solved, ty: returned.ty, row: j2.r }
}

fn reach_label(cx: Cx, s: PerformSite) -> Bytes = {
  let a = tick(atom_written(cx, s.atom));
  match s.source {
    SDirect -> bytes_concat(b"performs ", a),
    SVia(name) -> bytes_concat_all([b"reaches ", a, b" through ", tick(simple_name_of(name))]),
    SOpaque -> bytes_concat_all([b"reaches ", a, b" through a function value"]),
    SArgs -> bytes_concat(b"reaches ", a),
  }
}

// `E0305`: the operations named, and for a mode atom the operations it stands for, each with the clause to add.
fn incomplete(cx: Cx, span: Span, after: Int, sites: List<PerformSite>, handled: List<Atom>, keys: List<OpKey>, missing: List<Atom>) -> Cx = {
  let names = map(missing, |a: Atom| tick(atom_written(cx, a)));
  let listed = if len(names) == 1 { at(names, 0) }
               else { bytes_concat_all([join_with(take(names, len(names) - 1), b", "), b" and ", at(names, len(names) - 1)]) };
  let labels = fold(missing, [], |acc: List<Label>, a: Atom|
    match site_among(sites, a) { Some(s) -> push(acc, lab(s.module, s.span, true, reach_label(cx, s))), None -> acc });
  let notes = fold(missing, [], |acc: List<Bytes>, a: Atom|
    match a.op {
      Some(_) -> acc,
      None -> {
        let through = match site_among(sites, a) {
          Some(s) -> match s.source { SVia(name) -> tick(simple_name_of(name)), SOpaque -> b"a function value", _ -> b"the body" },
          None -> b"the body",
        };
        push(acc, bytes_concat_all([through, b" may perform any `", mode_key(a.mode), b"` operation of `", as_written(cx, a.effect),
                                    b"`; a clause for each of them discharges ", tick(atom_written(cx, a))]))
      },
    });
  let handled_text = join_with(map(handled, |a: Atom| tick(atom_text(a))), b", ");
  let d = diag(b"E0305",
    bytes_concat_all([b"this `handle` has no clause for ", listed, b", which its body performs"]),
    push(labels, lab(cx.module, span, false, bytes_concat_all([b"handles ", handled_text, b" here, so the operation would run past it"]))),
    notes);
  let wanted = fold(missing, [], |acc: List<Atom>, a: Atom|
    match a.op { Some(_) -> push(acc, a), None -> append(acc, filter(mode_ops(cx, a), |o: Atom| !key_named(keys, o))) });
  let fixed = fold(wanted, d, |acc: Diag, a: Atom|
    with_fix(acc, bytes_concat_all([b"add a clause for ", tick(atom_written(cx, a))]), [insertion(cx.module, after, bytes_concat(b", ", clause_for(cx, a)))]));
  report(cx, fixed)
}

// A clause for the operation that checks as it is and raises where the operation was skipped before.
fn clause_for(cx: Cx, a: Atom) -> Bytes = {
  let written = atom_written(cx, a);
  let params = match effect_of(cx, a.effect) {
    Some(info) -> match a.op { Some(op) -> match op_named(info, op) { Some(o) -> len(o.params), None -> 0 }, None -> 0 },
    None -> 0,
  };
  bytes_concat_all([written, b"(", join_with(map(range(0, params), |i: Int| bytes_concat(b"a", num(i))), b", "),
                    b") -> panic(\"", written, b" is not handled here\")"])
}

fn simple_name_of(name: Bytes) -> Bytes =
  match fold(range(0, bytes_len(name)), None, |acc: Option<Int>, i: Int| if bytes_at(name, i) == 46 { Some(i) } else { acc }) {
    Some(i) -> bytes_slice(name, i + 1, bytes_len(name)),
    None -> name,
  }

// The mismatch just reported gains a secondary at the declaration and three notes.
fn note_universal_clause(cx: Cx, info: EffectInfo, op: OpInfo) -> Cx = {
  let n = len(cx.diags);
  if n == 0 { cx } else {
    let last: Diag = at(cx.diags, n - 1);
    let notes = [bytes_concat_all([b"`", as_written(cx, info.name), b".", op.name, b"` is declared with a type variable, so a clause for it has to answer every type a perform site could ask for"]),
                 b"a row carries atoms and no types, so the `handle` cannot see which type a perform site picked \xe2\x80\x94 answering a concrete one would be a value of a type the caller never asked for",
                 b"declare the operation at the type it actually answers, or produce the result from one of the clause's own parameters"];
    {..cx, diags: set_at(cx.diags, n - 1, { code: last.code, notes: last.notes + 3, labels: push(last.labels, lab(op.at.module, op.at.span, false, b"declared here")),
                                           text: last.text, message: last.message, notes_text: append(last.notes_text, notes), severity: last.severity, fixes: last.fixes })}
  }
}

fn region_type(name: Bytes) -> Type = con(bytes_concat(region_prefix(), name))

fn cell_atoms(resource: Bytes) -> List<Atom> =
  [{ effect: cell(), resource: RNamed(resource), mode: MRead, op: None }, { effect: cell(), resource: RNamed(resource), mode: MWrite, op: None }]

fn region_is_open(cx: Cx, name: Bytes) -> Bool = fold(cx.open_regions, false, |acc: Bool, r: OpenRegion| acc || r.name == name)

fn open_region_span(cx: Cx, name: Bytes) -> Option<Span> =
  fold(cx.open_regions, None, |acc: Option<Span>, r: OpenRegion| match acc { Some(_) -> acc, None -> if r.name == name { Some(r.span) } else { None } })

fn open_region(cx: Cx, name: Bytes, with_cell: Bool, span: Span) -> Cx =
  {..cx, open_regions: push(cx.open_regions, { name: name, with_cell: with_cell, span: span, simulate_depth: cx.simulate_depth, spawns: [], handoffs: [] })}

type ClosedRegion = { cx: Cx, spawns: List<SpawnSite>, handoffs: List<HandoffSite> }

fn close_region(cx: Cx) -> ClosedRegion = {
  let n = len(cx.open_regions);
  let last = at(cx.open_regions, n - 1);
  { cx: {..cx, open_regions: take(cx.open_regions, n - 1)}, spawns: last.spawns, handoffs: last.handoffs }
}

fn sites_of(args: List<Expr>, tys: List<Type>) -> List<SpawnSite> =
  map(range(0, len(args)), |i: Int| { span: expr_span(at(args, i)), ty: at(tys, i) })

// A `task.spawn` argument is filed against every open `with_region` the task could outlive.
fn note_spawn(cx: Cx, info: EffectInfo, op: OpInfo, args: List<Expr>, tys: List<Type>) -> Cx =
  if info.name != b"task" || op.name != b"spawn" { cx } else {
    {..cx, open_regions: map(cx.open_regions, |r: OpenRegion|
      if r.simulate_depth < cx.simulate_depth || r.with_cell { r } else { {..r, spawns: append(r.spawns, sites_of(args, tys))} })}
  }

// Every argument of a user-declared operation, against every open region: its handler can be installed anywhere.
fn note_handoff(cx: Cx, info: EffectInfo, op: OpInfo, args: List<Expr>, tys: List<Type>) -> Cx =
  if info.name == b"task" || len(cx.open_regions) == 0 { cx } else {
    let name = bytes_concat_all([info.simple_name, b".", op.name]);
    let sites = map(range(0, len(args)), |i: Int| { span: expr_span(at(args, i)), ty: at(tys, i), op: name });
    {..cx, open_regions: map(cx.open_regions, |r: OpenRegion| {..r, handoffs: append(r.handoffs, sites)})}
  }

// What is in scope when a region opens, paired with where its body first names each.
fn outer_bindings(cx: Cx, body: Expr) -> List<OuterBinding> = {
  let kept = fold(env_locals(cx.env), [], |acc: List<{ name: Bytes, ty: Type }>, l: { name: Bytes, sc: Scheme }| {
    let fv = free_vars(cx.subst, l.sc.ty, { tys: [], rows: [] });
    let tys = ints_difference(fv.tys, l.sc.ty_vars);
    let rows = ints_difference(fv.rows, l.sc.row_vars);
    if len(tys) > 0 || len(rows) > 0 { push(acc, { name: l.name, ty: l.sc.ty }) } else { acc }
  });
  if len(kept) == 0 { [] } else {
    let refs = refs_of(body);
    let first = fold(refs.names, [], |acc: List<{ name: Bytes, span: Span }>, q: QName|
      if !is_bare(q) || fold(acc, false, |b: Bool, x: { name: Bytes, span: Span }| b || x.name == q.name.name) { acc }
      else { push(acc, { name: q.name.name, span: q.span }) });
    fold(kept, [], |acc: List<OuterBinding>, k: { name: Bytes, ty: Type }|
      match fold(first, None, |p: Option<Span>, x: { name: Bytes, span: Span }| match p { Some(_) -> p, None -> if x.name == k.name { Some(x.span) } else { None } }) {
        Some(site) -> push(acc, { name: k.name, ty: k.ty, site: site }),
        None -> acc,
      })
  }
}

fn region_exits(e: Expr, out: List<Span>) -> List<Span> =
  match e {
    EBlock(b) -> match b.tail { Some(t) -> region_exits(t, out), None -> out },
    EIf(i) -> region_exits(i.else_branch, region_exits(i.then_branch, out)),
    EMatch(m) -> fold(m.arms, out, |acc: List<Span>, arm: MatchArm| region_exits(arm.body, acc)),
    EWithCell(c) -> region_exits(c.body, out),
    EWithRegion(w) -> region_exits(w.body, out),
    ESimulate(s) -> region_exits(s.body, out),
    EHandle(h) -> {
      let through = match h.ret { Some(rc) -> region_exits(rc.body, out), None -> region_exits(h.body, out) };
      fold(h.clauses, through, |acc: List<Span>, c: HandleClause| match c.resume { Some(_) -> region_exits(c.body, acc), None -> acc })
    },
    _ -> push(out, expr_span(e)),
  }

fn infer_with_cell(cx: Cx, span: Span, resource: Ident, init: Expr, binder: Ident, body: Expr) -> Inferred = {
  let i: Inferred = infer(cx, init);
  let cell_ty = TyCon({ name: b"Cell", args: [region_type(resource.name), i.ty] });
  if region_is_open(i.cx, resource.name) {
    let pushed: Cx = {..i.cx, env: env_bind(env_push(i.cx.env), binder.name, mono(cell_ty))};
    let b: Inferred = infer(pushed, body);
    let j: WithRow = join({..b.cx, env: env_pop(b.cx.env)}, span, i.row, b.row);
    { cx: j.cx, ty: b.ty, row: j.r }
  } else {
    let outer = outer_bindings(i.cx, body);
    let opened: Cx = open_region(i.cx, resource.name, true, resource.span);
    let mark = len(opened.performs);
    let pushed: Cx = {..opened, env: env_bind(env_push(opened.env), binder.name, mono(cell_ty))};
    let b: Inferred = infer(pushed, body);
    let closed: ClosedRegion = close_region({..b.cx, env: env_pop(b.cx.env)});
    let handled = cell_atoms(resource.name);
    let discharged: Cx = discharge(closed.cx, mark, len(closed.cx.performs), handled);
    let site: RegionSite = { module: discharged.module, name: resource.name, with_cell: true, span: resource.span, body_span: expr_span(body),
                             body_ty: b.ty, exits: region_exits(body, []), outer: outer, spawns: closed.spawns, handoffs: closed.handoffs };
    let recorded: Cx = {..discharged, regions: push(discharged.regions, site)};
    let j: WithRow = join(recorded, span, i.row, row_without(b.row, handled));
    { cx: j.cx, ty: b.ty, row: j.r }
  }
}

fn infer_with_region(cx: Cx, region: Ident, body: Expr) -> Inferred = {
  let c0: Cx = match open_region_span(cx, region.name) {
    Some(open) -> err2(cx, b"E0447", region.span, bytes_concat_all([b"region `", region.name, b"` is already open here"]),
                       b"a second region under the same name", { module: cx.module, span: open },
                       bytes_concat_all([b"`", region.name, b"` opens here and is still open"]),
                       [b"the brand is the name, so the two regions' values would have one type and closing the inner one would free what the outer one still holds",
                        b"give the inner region a different name"]),
    None -> cx,
  };
  let outer = outer_bindings(c0, body);
  let opened: Cx = open_region(c0, region.name, false, region.span);
  let mark = len(opened.performs);
  let b: Inferred = infer(opened, body);
  let closed: ClosedRegion = close_region(b.cx);
  let handled = cell_atoms(region.name);
  let discharged: Cx = discharge(closed.cx, mark, len(closed.cx.performs), handled);
  let site: RegionSite = { module: discharged.module, name: region.name, with_cell: false, span: region.span, body_span: expr_span(body),
                           body_ty: b.ty, exits: region_exits(body, []), outer: outer, spawns: closed.spawns, handoffs: closed.handoffs };
  let recorded: Cx = {..discharged, regions: push(discharged.regions, site)};
  { cx: recorded, ty: b.ty, row: row_without(resolve_r(recorded, b.row), handled) }
}

fn infer_simulate(cx: Cx, span: Span, body: Expr) -> Inferred = {
  let mark = len(cx.performs);
  let b: Inferred = infer({..cx, simulate_depth: cx.simulate_depth + 1}, body);
  let c: Cx = {..b.cx, simulate_depth: b.cx.simulate_depth - 1};
  let handled = simulated_atoms();
  let discharged: Cx = discharge(c, mark, len(c.performs), handled);
  let noted: Cx = {..discharged, simulations: push(discharged.simulations, { module: discharged.module, span: span, body_span: expr_span(body), body_ty: b.ty, body_row: b.row })};
  let seed = seed_atom();
  let recorded: Cx = record_site(noted, seed, span, SDirect);
  let j: WithRow = join(recorded, span, row_without_covered(resolve_r(recorded, b.row), handled), row_singleton(seed));
  { cx: j.cx, ty: b.ty, row: j.r }
}

// --- Definitions ----------------------------------------------------------------------------------

type Refs = { names: List<QName>, effects: Bool }

fn refs_of(e: Expr) -> Refs = collect_refs(e, { names: [], effects: false })

fn collect_refs(e: Expr, out: Refs) -> Refs =
  match e {
    ELit(_) -> out,
    EBad(_) -> out,
    EVar(v) -> {..out, names: push(out.names, v.name)},
    EBinary(b) -> collect_refs(b.rhs, collect_refs(b.lhs, out)),
    EUnary(u) -> collect_refs(u.operand, out),
    ELambda(l) -> collect_refs(l.body, out),
    EApp(a) -> fold(a.args, collect_refs(a.func, out), |acc: Refs, x: Expr| collect_refs(x, acc)),
    EIf(i) -> collect_refs(i.else_branch, collect_refs(i.then_branch, collect_refs(i.cond, out))),
    EMatch(m) -> fold(m.arms, collect_refs(m.scrutinee, out), |acc: Refs, arm: MatchArm|
                   collect_refs(arm.body, match arm.guard { Some(g) -> collect_refs(g, acc), None -> acc })),
    EBlock(b) -> {
      let ss = fold(b.stmts, out, |acc: Refs, s: Stmt| match s { SExpr(x) -> collect_refs(x, acc), SLet(l) -> collect_refs(l.value, acc) });
      match b.tail { Some(t) -> collect_refs(t, ss), None -> ss }
    },
    ERecord(r) -> fold(r.fields, out, |acc: Refs, f: RecField| collect_refs(f.value, acc)),
    ERecordUpdate(r) -> fold(r.fields, collect_refs(r.base, out), |acc: Refs, f: RecField| collect_refs(f.value, acc)),
    EField(f) -> collect_refs(f.base, out),
    ETry(t) -> collect_refs(t.operand, out),
    EList(l) -> fold(l.items, out, |acc: Refs, x: Expr| collect_refs(x, acc)),
    EPerform(p) -> fold(p.args, {..out, effects: true}, |acc: Refs, x: Expr| collect_refs(x, acc)),
    EHandle(h) -> {
      let b = collect_refs(h.body, {..out, effects: true});
      let cs = fold(h.clauses, b, |acc: Refs, c: HandleClause| collect_refs(c.body, acc));
      match h.ret { Some(rc) -> collect_refs(rc.body, cs), None -> cs }
    },
    EWithCell(c) -> collect_refs(c.body, collect_refs(c.init, out)),
    EWithRegion(w) -> collect_refs(w.body, out),
    ESimulate(s) -> collect_refs(s.body, out),
  }

// Tarjan's components; the goldens fix the order they come out in.
type Tarjan = { index: List<Int>, low: List<Int>, on_stack: List<Bool>, stack: List<Int>,
                call: List<{ v: Int, edge: Int }>, out: List<List<Int>>, next: Int }

pub fn sccs(n: Int, adj: List<List<Int>>) -> List<List<Int>> = {
  let unvisited = 0 - 1;
  let start = { index: map(range(0, n), |i: Int| unvisited), low: map(range(0, n), |i: Int| 0), on_stack: map(range(0, n), |i: Int| false),
                stack: [], call: [], out: [], next: 0 };
  let edges = fold(adj, 0, |acc: Int, es: List<Int>| acc + len(es));
  let done = fold(range(0, n), start, |t: Tarjan, root: Int|
    if at(t.index, root) != unvisited { t } else {
      let opened: Tarjan = {..t, index: set_at(t.index, root, t.next), low: set_at(t.low, root, t.next), next: t.next + 1,
                            stack: push(t.stack, root), on_stack: set_at(t.on_stack, root, true), call: [{ v: root, edge: 0 }]};
      iterate(opened, 2 * (n + edges) + 4, |x: Tarjan| if len(x.call) == 0 { Stop(x) } else { Continue(tarjan_step(adj, x)) })
    });
  done.out
}

fn tarjan_step(adj: List<List<Int>>, t: Tarjan) -> Tarjan = {
  let top = at(t.call, len(t.call) - 1);
  let rest = take(t.call, len(t.call) - 1);
  let out = at(adj, top.v);
  if top.edge < len(out) {
    let again = push(rest, { v: top.v, edge: top.edge + 1 });
    let w = at(out, top.edge);
    if at(t.index, w) == 0 - 1 {
      {..t, index: set_at(t.index, w, t.next), low: set_at(t.low, w, t.next), next: t.next + 1,
            stack: push(t.stack, w), on_stack: set_at(t.on_stack, w, true), call: push(again, { v: w, edge: 0 })}
    } else if at(t.on_stack, w) {
      {..t, low: set_at(t.low, top.v, min(at(t.low, top.v), at(t.index, w))), call: again}
    } else { {..t, call: again} }
  } else {
    let popped: Tarjan = if at(t.low, top.v) == at(t.index, top.v) {
      let split = iterate({ stack: t.stack, on: t.on_stack, comp: [] }, len(t.stack) + 1, |s: { stack: List<Int>, on: List<Bool>, comp: List<Int> }| {
        let w = at(s.stack, len(s.stack) - 1);
        let next = { stack: take(s.stack, len(s.stack) - 1), on: set_at(s.on, w, false), comp: push(s.comp, w) };
        if w == top.v { Stop(next) } else { Continue(next) }
      });
      {..t, stack: split.stack, on_stack: split.on, out: push(t.out, reverse_ints(split.comp))}
    } else { t };
    let lowered: Tarjan = if len(rest) > 0 {
      let parent = at(rest, len(rest) - 1).v;
      {..popped, low: set_at(popped.low, parent, min(at(popped.low, parent), at(popped.low, top.v)))}
    } else { popped };
    {..lowered, call: rest}
  }
}

fn reverse_ints(xs: List<Int>) -> List<Int> = map(range(0, len(xs)), |i: Int| at(xs, len(xs) - 1 - i))

fn check_fns(cx: Cx, m: Mod) -> Cx = {
  let collected = fold(m.module.items, { cx: cx, fns: [], names: [] }, |acc: { cx: Cx, fns: List<FnDef>, names: List<Bytes> }, it: Item|
    match it {
      IFn(def) ->
        if contains_bytes(acc.names, def.name.name) {
          let prev = fold(acc.fns, dummy_span(), |s: Span, f: FnDef| if f.name.name == def.name.name { f.name.span } else { s });
          {..acc, cx: duplicate(acc.cx, def.name, { module: acc.cx.module, span: prev }, b"function")}
        } else if is_cell_builtin(def.name.name) {
          {..acc, cx: err1(acc.cx, b"E0105", def.name.span, bytes_concat_all([b"`", def.name.name, b"` is a builtin"]), b"cannot be redefined",
                           [b"region-scoped cell access is a call form, not an ordinary function"])}
        }
        else if def.name.name == compare_values_name() {
          {..acc, cx: err1(acc.cx, b"E0105", def.name.span, b"`compare_values` is a builtin", b"cannot be redefined",
                           [b"it is the order `Map` iterates in, and `derive ord` builds a dictionary out of it \xe2\x80\x94 a module that could redefine it would give one type two orders",
                            b"`compare` is the same operation under a name you may shadow"])}
        }
        else { { cx: acc.cx, fns: push(acc.fns, def), names: push(acc.names, def.name.name) } },
      _ -> acc,
    });
  let fns = collected.fns;
  let names = collected.names;
  let adj = map(fns, |d: FnDef| {
    let refs = refs_of(d.body);
    fold(refs.names, [], |acc: List<Int>, q: QName|
      if !is_bare(q) { acc } else {
        let i = position_bytes(names, q.name.name);
        if i < 0 || contains_int(acc, i) { acc } else { push(acc, i) }
      })
  });
  fold(sccs(len(fns), adj), collected.cx, |c: Cx, comp: List<Int>| check_component(c, m, fns, comp))
}

fn known_def(cx: Cx, name: Bytes) -> Option<KnownDef> =
  fold(cx.known.defs, None, |acc: Option<KnownDef>, d: KnownDef| match acc { Some(_) -> acc, None -> if d.name == name { Some(d) } else { None } })

fn known_test(cx: Cx, module: Bytes, position: Int) -> Option<List<Atom>> =
  fold(cx.known.tests, None, |acc: Option<List<Atom>>, t: KnownTests|
    match acc {
      Some(_) -> acc,
      None -> if t.module != module { None } else { match list_at(t.slots, position) { Some(slot) -> slot, None -> None } },
    })

// The same scheme with its quantified variables drawn from this run.
fn adopt(cx: Cx, sc: Scheme) -> { cx: Cx, sc: Scheme } =
  if len(sc.ty_vars) == 0 && len(sc.row_vars) == 0 && len(sc.label_vars) == 0 { { cx: cx, sc: sc } } else {
    let tys = fold(sc.ty_vars, { cx: cx, vs: [] }, |acc: { cx: Cx, vs: List<Int> }, v: Int| { let o: WithVar = new_ty_var(acc.cx); { cx: o.cx, vs: push(acc.vs, o.v) } });
    let rows = fold(sc.row_vars, { cx: tys.cx, vs: [] }, |acc: { cx: Cx, vs: List<Int> }, v: Int| { let o: WithVar = new_row_var(acc.cx); { cx: o.cx, vs: push(acc.vs, o.v) } });
    let labels = fold(sc.label_vars, { cx: rows.cx, vs: [] }, |acc: { cx: Cx, vs: List<Int> }, v: Int| { let o: WithVar = new_ty_var(acc.cx); { cx: o.cx, vs: push(acc.vs, o.v) } });
    { cx: labels.cx, sc: { ty_vars: tys.vs, row_vars: rows.vs, label_vars: labels.vs, ty: rename_scheme(sc, tys.vs, rows.vs, labels.vs) } }
  }

// Unifying a restored scheme with the fresh signature says which of its variables each constrained parameter is.
fn recovered_constraints(cx: Cx, def: FnDef, sig: Sig, args: List<Type>) -> List<DefConstraint> = {
  let found = fold(def.constraints, [], |acc: List<DefConstraint>, c: Constraint|
    match map_get(sig.ty_params, c.param.name) {
      Some(TyVar(v)) -> {
        let param = fold(range(0, len(args)), 0 - 1, |p: Int, i: Int|
          if p >= 0 { p } else { match resolve(cx, at(args, i)) { TyVar(w) -> if w == v { i } else { p }, _ -> p } });
        if param < 0 { acc } else { push(acc, { deriver: c.deriver, param: param }) }
      },
      _ -> acc,
    });
  dedup_constraints(fold(found, [], |acc: List<DefConstraint>, c: DefConstraint| insert_constraint(acc, c)))
}

// A recursive group published from the supplied interfaces without walking a body; specs are not hashed, so clauses are still typed.
fn publish_known(cx: Cx, m: Mod, fns: List<FnDef>, comp: List<Int>, qualified: List<Bytes>) -> Cx =
  fold(range(0, len(comp)), cx, |c: Cx, slot: Int| {
    let def = at(fns, at(comp, slot));
    let name = at(qualified, slot);
    let entry = match known_def(c, name) { Some(e) -> e, None -> panic("every member of the group is known") };
    let a: { cx: Cx, sc: Scheme } = adopt(c, entry.scheme);
    let recovered: { cx: Cx, cs: List<DefConstraint> } =
      if len(def.spec) > 0 || len(def.constraints) > 0 {
        let s: WithSig = signature(a.cx, def);
        let inst = instantiate_with(a.sc, s.cx.fresh);
        let c1: Cx = {..s.cx, fresh: inst.f};
        let c2: Cx = with_unified(c1, unify(c1.subst, c1.fresh, s.sig.fn_ty, inst.ty));
        { cx: record_spec_env(c2, def, name, s.sig), cs: recovered_constraints(c2, def, s.sig, inst.args) }
      } else { { cx: a.cx, cs: [] } };
    let c3: Cx = recovered.cx;
    let bound: Cx = {..c3, env: env_bind_global(c3.env, name, a.sc), constraints: map_insert(c3.constraints, name, recovered.cs)};
    set_def(bound, { name: name, module: m.name, simple_name: def.name.name, scheme: a.sc, footprint: entry.footprint,
                     performed: entry.performed, row_aliases: row_aliases(def), constraints: recovered.cs, spec: [],
                     internally_effectful: true, at: here(bound, def.span) })
  })

fn check_component(cx: Cx, m: Mod, fns: List<FnDef>, comp: List<Int>) -> Cx = {
  let qualified = map(comp, |i: Int| qualify(m.name, at(fns, i).name.name));
  let all_known = fold(qualified, true, |acc: Bool, q: Bytes| acc && (match known_def(cx, q) { Some(_) -> true, None -> false }));
  if all_known { publish_known(cx, m, fns, comp, qualified) } else { check_component_walked(cx, m, fns, comp, qualified) }
}

fn binders_text(def: FnDef) -> Bytes = {
  let n = len(def.generics.labels);
  if n == 0 { b"binds no label parameters" } else { bytes_concat_all([b"binds ", num(n), b" label parameter", plural(n)]) }
}

fn label_binders_differ(cx: Cx, def: FnDef, first: FnDef) -> Cx =
  err2(cx, b"E0307", def.name.span,
       bytes_concat_all([b"`", def.name.name, b"` and `", first.name.name,
                         b"` are mutually recursive, so they are checked with one set of label parameters"]),
       binders_text(def), here(cx, first.name.span), binders_text(first),
       [b"a call inside a recursive group passes the caller's labels along, so every member binds the same number, in the same order"])

// The label variables a recursive group is checked with: the first member's binders, taken by
// every member in order. A member that binds another number of them is refused.
fn component_labels(cx0: Cx, fns: List<FnDef>, comp: List<Int>) -> { cx: Cx, vars: List<Int> } = {
  let first: FnDef = at(fns, fold(comp, at(comp, 0), |acc: Int, i: Int| if i < acc { i } else { acc }));
  let want = len(first.generics.labels);
  let judged: Cx =
    if len(comp) < 2 { cx0 } else {
      fold(comp, cx0, |c: Cx, i: Int|
        if len(at(fns, i).generics.labels) == want { c } else { label_binders_differ(c, at(fns, i), first) })
    };
  fold(first.generics.labels, { cx: judged, vars: [] }, |acc: { cx: Cx, vars: List<Int> }, p: Ident| {
    let o: WithVar = new_ty_var(acc.cx);
    { cx: {..o.cx, subst: mark_rigid_ty(o.cx.subst, o.v)}, vars: push(acc.vars, o.v) }
  })
}

fn check_component_walked(cx: Cx, m: Mod, fns: List<FnDef>, comp: List<Int>, qualified: List<Bytes>) -> Cx = {
  let shared: { cx: Cx, vars: List<Int> } = component_labels(cx, fns, comp);
  let sigs: { cx: Cx, sigs: List<Sig> } = fold(range(0, len(comp)), { cx: shared.cx, sigs: [] }, |acc: { cx: Cx, sigs: List<Sig> }, slot: Int| {
    let def = at(fns, at(comp, slot));
    let s: WithSig = signature_sharing({..acc.cx, derived: derived_of(m, def)}, def, shared.vars);
    { cx: {..s.cx, derived: None, env: env_bind_global(s.cx.env, at(qualified, slot), mono(s.sig.fn_ty))}, sigs: push(acc.sigs, s.sig) }
  });
  let grouped: Cx = {..sigs.cx, group_labels: fold(range(0, len(comp)), [], |acc: List<{ name: Bytes, vars: List<Int> }>, slot: Int| {
    let def = at(fns, at(comp, slot));
    let sig = at(sigs.sigs, slot);
    let vars = fold(def.generics.labels, [], |vs: List<Int>, p: Ident|
      match map_get(sig.label_params, p.name) { Some(v) -> push(vs, v), None -> vs });
    if len(vars) == 0 { acc } else { push(acc, { name: at(qualified, slot), vars: vars }) }
  })};
  let bodies: { cx: Cx, rows: List<Row> } = fold(range(0, len(comp)), { cx: grouped, rows: [] }, |acc: { cx: Cx, rows: List<Row> }, slot: Int| {
    let def = at(fns, at(comp, slot));
    let sig = at(sigs.sigs, slot);
    let o: WithBodyRow = check_fn_body({..acc.cx, derived: derived_of(m, def)}, def, sig);
    let walked: Cx = {..o.cx, derived: None};
    { cx: record_spec_env(walked, def, at(qualified, slot), sig), rows: push(acc.rows, o.row) }
  });
  let settled: Cx = settle_bit_ops(settle_numerics(settle_concats(settle_updates({..bodies.cx, group_labels: []}))));
  let required: Cx = fold(range(0, len(comp)), settled, |c: Cx, slot: Int| require_written_signature(c, at(fns, at(comp, slot)), at(sigs.sigs, slot)));
  let closed: Cx = fold(sigs.sigs, required, |c: Cx, s: Sig| close_unreachable_row(c, s));
  let removed: Cx = fold(qualified, closed, |c: Cx, name: Bytes| {..c, env: env_remove_global(c.env, name)});
  fold(range(0, len(comp)), removed, |c: Cx, slot: Int| {
    let def = at(fns, at(comp, slot));
    let sig = at(sigs.sigs, slot);
    let g: Generalized = generalize(c.subst, c.env, sig.fn_ty);
    let sc: Scheme = split_labels(g.sc, def, sig);
    let row = resolve_r(c, sig.published_row);
    let bound: Cx = {..c, env: env_bind_global(g.e, at(qualified, slot), sc), ty_params: sig.ty_params};
    let constraints = published_constraints(bound, def, sc);
    let performed = resolve_r(bound, at(bodies.rows, slot));
    set_def({..bound, ty_params: map_new(), constraints: map_insert(bound.constraints, at(qualified, slot), constraints)},
            { name: at(qualified, slot), module: m.name, simple_name: def.name.name, scheme: sc, footprint: row.atoms,
              performed: performed.atoms, row_aliases: row_aliases(def), constraints: constraints, spec: [],
              internally_effectful: true, at: here(bound, def.span) })
  })
}

// The signature's label parameters generalize among the type variables; they belong in their own
// list, in the order the generic list wrote them, and a phantom one is still a parameter.
fn split_labels(sc: Scheme, def: FnDef, sig: Sig) -> Scheme = {
  let ids = fold(def.generics.labels, [], |acc: List<Int>, p: Ident|
    match map_get(sig.label_params, p.name) { Some(v) -> push(acc, v), None -> acc });
  if len(ids) == 0 { sc } else {
    { ty_vars: ints_difference(sc.ty_vars, ids), row_vars: sc.row_vars, label_vars: ids, ty: sc.ty }
  }
}

// A generated definition carries its `derive` item's span and nothing hand-written does.
fn derived_of(m: Mod, def: FnDef) -> Option<Derived> =
  fold(m.derived, None, |acc: Option<Derived>, d: Derived| match acc { Some(_) -> acc, None -> if d.span == def.span { Some(d) } else { None } })

fn published_constraints(cx: Cx, def: FnDef, sc: Scheme) -> List<DefConstraint> = {
  let found = fold(def.constraints, [], |acc: List<DefConstraint>, c: Constraint|
    match map_get(cx.ty_params, c.param.name) {
      Some(TyVar(v)) -> {
        let param = fold(range(0, len(sc.ty_vars)), 0 - 1, |p: Int, i: Int| if p >= 0 { p } else if at(sc.ty_vars, i) == v { i } else { p });
        if param < 0 { acc } else { push(acc, { deriver: c.deriver, param: param }) }
      },
      _ -> acc,
    });
  dedup_constraints(fold(found, [], |acc: List<DefConstraint>, c: DefConstraint| insert_constraint(acc, c)))
}

fn constraint_lt(a: DefConstraint, b: DefConstraint) -> Bool =
  a.param < b.param || (a.param == b.param && deriver_tag(a.deriver) < deriver_tag(b.deriver))

fn insert_constraint(sorted: List<DefConstraint>, c: DefConstraint) -> List<DefConstraint> = {
  let n = len(sorted);
  let i = fold(range(0, n), n, |acc: Int, j: Int| if acc < n { acc } else if constraint_lt(c, at(sorted, j)) { j } else { acc });
  append(push(take(sorted, i), c), drop(sorted, i))
}

fn dedup_constraints(xs: List<DefConstraint>) -> List<DefConstraint> =
  fold(xs, [], |acc: List<DefConstraint>, c: DefConstraint|
    if len(acc) > 0 && at(acc, len(acc) - 1).param == c.param && same_deriver(at(acc, len(acc) - 1).deriver, c.deriver) { acc } else { push(acc, c) })

fn check_fn_body(cx0: Cx, def: FnDef, sig: Sig) -> { cx: Cx, row: Row } = {
  let cx: Cx = {..cx0, scope: sig.scope, ty_params: sig.ty_params, row_params: sig.row_params,
                label_params: sig.label_params, performs: [],
                declared_atoms: match sig.declared { Some(r) -> resolve_r(cx0, r).atoms, None -> [] }};
  let assumed: Cx = {..cx, assumed: constraints_in_force(cx, def.constraints)};
  let defaults: Cx = fold(range(0, len(def.params)), assumed, |c: Cx, i: Int|
    match at(def.params, i).default {
      None -> c,
      Some(d) -> { let o: Inferred = infer(c, d); expect(o.cx, expr_span(d), at(sig.params, i), o.ty, b"parameter default").cx },
    });
  let pushed: Cx = {..defaults, env: env_push(defaults.env)};
  let bound: Cx = fold(range(0, len(def.params)), pushed, |c: Cx, i: Int| {..c, env: env_bind(c.env, at(def.params, i).name.name, mono(at(sig.params, i)))});
  let body: Inferred = infer(bound, def.body);
  let checked: Cx = expect(body.cx, expr_span(def.body), sig.ret, body.ty, b"function body type").cx;
  let popped: Cx = {..checked, env: env_pop(checked.env)};
  let rowed: Cx = match sig.declared {
    Some(declared) -> check_upper_bound(popped, def, declared, body.row),
    None -> {
      let u = unify_row(popped.subst, popped.fresh, sig.published_row, body.row);
      let c = with_unified(popped, u);
      match u.err { Some(e) -> report_unify(c, e, expr_span(def.body), b"inferred effect row"), None -> c }
    },
  };
  { cx: {..rowed, ty_params: map_new(), row_params: map_new(), label_params: map_new(), assumed: []}, row: body.row }
}

type Offence = { atom: Atom, site: Option<PerformSite> }

// Each inferred atom the written row does not cover, with the first site that contributed it.
fn offences(cx: Cx, dec: List<Atom>, inf: List<Atom>) -> List<Offence> =
  fold(inf, [], |acc: List<Offence>, a: Atom| if atoms_covered(dec, a) { acc } else { push(acc, { atom: a, site: site_for(cx, a) }) })

// The written atoms of the same effect and resource as `a`.
fn named_for(dec: List<Atom>, a: Atom) -> List<Atom> =
  filter(dec, |d: Atom| d.effect == a.effect && d.resource == a.resource)

// A mode atom reached through a call, where the row names operations of its effect: the callee may perform any of them.
fn narrowed_site(dec: List<Atom>, s: PerformSite) -> Bool =
  !is_direct(s) && (match s.atom.op { None -> len(named_for(dec, s.atom)) > 0, Some(_) -> false })

fn site_label(dec: List<Atom>, s: PerformSite) -> Bytes = {
  let a = atom_text(s.atom);
  let through = match s.source { SVia(name) -> tick(simple_name_of(name)), SOpaque -> b"a function value", _ -> b"its arguments" };
  match s.source {
    SDirect -> bytes_concat_all([b"performs `", a, b"`"]),
    SArgs -> bytes_concat_all([b"reaches `", a, b"`"]),
    _ ->
      if narrowed_site(dec, s) {
        bytes_concat_all([b"reaches `", a, b"` through ", through, b", which may perform any of its operations; this row names only ",
                          backticked(map(named_for(dec, s.atom), atom_text), b", ")])
      } else { bytes_concat_all([b"reaches `", a, b"` through ", through]) },
  }
}

fn narrowed_by_row(dec: List<Atom>, o: Offence) -> Bool =
  match o.site { Some(s) -> narrowed_site(dec, s), None -> false }

fn atom_written(cx: Cx, a: Atom) -> Bytes =
  bytes_concat_all([as_written(cx, a.effect), b".", match a.op { Some(op) -> op, None -> mode_key(a.mode) }, resource_text(a.resource)])

// Where an atom joins a written row: before `}`, after `{` when a tail follows, or braces around a bare variable.
fn row_edit(cx: Cx, r: RowExpr, text: Bytes) -> Edit =
  match r.tail {
    None -> insertion(cx.module, r.span.end - 1, if len(r.atoms) + len(r.aliases) == 0 { text } else { bytes_concat(b", ", text) }),
    Some(t) ->
      if t.span == r.span { { module: cx.module, start: r.span.start, end: r.span.end, text: bytes_concat_all([b"{", text, b" | ", t.name, b"}"]) } }
      else { insertion(cx.module, r.span.start + 1, bytes_concat(text, b", ")) },
  }

fn check_upper_bound(cx: Cx, def: FnDef, declared: Row, inferred: Row) -> Cx = {
  let ann_span = match def.effects { Some(r) -> r.span, None -> def.span };
  let inf = resolve_r(cx, inferred);
  let dec = resolve_r(cx, declared);
  let extra = offences(cx, dec.atoms, inf.atoms);
  let c1: Cx = if len(extra) == 0 { cx } else {
    let names = backticked(map(extra, |o: Offence| atom_text(o.atom)), b", ");
    let sites = fold(extra, [], |acc: List<Label>, o: Offence|
      match o.site { Some(s) -> push(acc, lab(s.module, s.span, true, site_label(dec.atoms, s))), None -> acc });
    let primaries = if len(sites) == 0 { [lab(cx.module, expr_span(def.body), true, b"this body performs more than it declares")] } else { sites };
    let notes = [bytes_concat_all([b"add ", names, b" to the `/ {..}` annotation, or handle ", if len(extra) == 1 { b"it" } else { b"them" }, b" inside `", def.name.name, b"`"])];
    let narrowed = fold(extra, false, |acc: Bool, o: Offence| acc || narrowed_by_row(dec.atoms, o));
    let d: Diag = diag(b"E0302",
                       bytes_concat_all([b"effect", plural(len(extra)), b" not permitted by the signature of `", def.name.name, b"`: ", names]),
                       push(primaries, lab(cx.module, ann_span, false, bytes_concat(b"declared row is ", row_text(dec)))),
                       if narrowed { push(notes, b"a row that names operations permits a call only when the callee's row names them too: widen this row to the mode atom, or narrow the callee's row") } else { notes });
    let fixed: Diag = match def.effects {
      Some(r) -> fold(extra, d, |acc: Diag, o: Offence| {
        let text = atom_written(cx, o.atom);
        with_fix(acc, bytes_concat_all([b"add `", text, b"` to the row"]), [row_edit(cx, r, text)])
      }),
      None -> d,
    };
    report(cx, fixed)
  };
  match inf.tail {
    None -> c1,
    Some(v) ->
      if dec.tail == Some(v) { c1 } else {
        let u = unify_row(c1.subst, c1.fresh, { atoms: [], tail: dec.tail }, row_open(v));
        let c2: Cx = with_unified(c1, u);
        match u.err {
          Some(_) -> err_labels(c2, b"E0302",
                       bytes_concat_all([b"the signature of `", def.name.name, b"` does not permit the effects its body forwards"]),
                       [lab(c2.module, expr_span(def.body), true, bytes_concat(b"body has row ", row_text(inf))),
                        lab(c2.module, ann_span, false, b"declared row cannot absorb it")],
                       [b"add the missing effect variable to the generic list, or widen the annotation"]),
          None -> c2,
        }
      },
  }
}

fn settle_numerics(cx: Cx) -> Cx = {
  let entries = cx.numerics;
  fold(entries, {..cx, numerics: []}, |c: Cx, entry: Numeric| {
    let ty = resolve(c, entry.ty);
    let what = if is_ordered(entry.op) { b"ordered comparison" } else { b"arithmetic" };
    match ty {
      TyVar(_) -> err1(c, b"E0210", entry.span, bytes_concat_all([b"the numeric type of this ", what, b" is not determined"]),
                       b"nothing here says which numeric type this is",
                       [b"the numeric types are `Int`, the eight fixed-width integers, `Float` and `Decimal`, and there is no tower",
                        b"annotate the operand, or write a literal that pins it (`1`, `1.0`, `1m`)"]),
      TyCon(k) ->
        if len(k.args) != 0 { numeric_mismatch(c, entry, ty, what) }
        else if is_int_name(k.name) || k.name == b"Float" { c }
        else if k.name == b"Decimal" {
          if entry.op == b"div" {
            err1(c, b"E0209", entry.span, b"`/` is not defined on `Decimal`", b"the exact quotient of two decimals is not a decimal",
                 [b"an operator would have to round, and a rounding nobody wrote down is the defect `Decimal` exists to prevent",
                  b"call `decimal_div(a, b, 2, HalfEven)` and say how to round"])
          } else { c }
        }
        else { numeric_mismatch(c, entry, ty, what) },
      _ -> numeric_mismatch(c, entry, ty, what),
    }
  })
}

fn op_text(op: Bytes) -> Bytes =
  if op == b"add" { b"+" } else if op == b"sub" { b"-" } else if op == b"mul" { b"*" } else if op == b"div" { b"/" }
  else if op == b"rem" { b"%" } else if op == b"lt" { b"<" } else if op == b"le" { b"<=" } else if op == b"gt" { b">" }
  else if op == b"ge" { b">=" } else { op }

fn numeric_mismatch(cx: Cx, entry: Numeric, ty: Type, what: Bytes) -> Cx =
  err1(cx, b"E0201", entry.span, bytes_concat_all([b"`", op_text(entry.op), b"` is not defined on `", type_text(ty), b"`"]),
       bytes_concat(what, b" here"), [b"the numeric types are `Int`, the eight fixed-width integers, `Float` and `Decimal`"])

// The resolved type, rendered, when the signature's generics bind every variable in it, so the author can paste it.
fn writable(cx: Cx, sig: Sig, t: Type) -> Option<Bytes> = {
  let resolved = resolve(cx, t);
  let bound = map_fold(sig.ty_params, [], |acc: List<Int>, k: Bytes, p: Type| match resolve(cx, p) { TyVar(v) -> push(acc, v), _ -> acc });
  let found = free_vars(subst_new(), resolved, { tys: [], rows: [] }).tys;
  if fold(found, false, |b: Bool, v: Int| b || !contains_int(bound, v)) { None } else { Some(type_text(resolved)) }
}

fn require_written_signature(cx: Cx, def: FnDef, sig: Sig) -> Cx = {
  let why = b"a signature is a claim about what a definition means, so it is written rather than inferred; the effect row is the exception and stays inferred";
  let params = fold(range(0, len(def.params)), cx, |c: Cx, i: Int| {
    let p = at(def.params, i);
    match p.ty {
      Some(_) -> c,
      None -> {
        let label = match writable(c, sig, at(sig.params, i)) {
          Some(shown) -> bytes_concat_all([b"write `", p.name.name, b": ", shown, b"`"]),
          None -> b"write a type here",
        };
        err1(c, b"E0126", p.span, bytes_concat_all([b"parameter `", p.name.name, b"` has no written type"]), label, [why])
      },
    }
  });
  match def.ret {
    Some(_) -> params,
    None -> {
      let label = match writable(params, sig, sig.ret) {
        Some(shown) -> bytes_concat_all([b"write `-> ", shown, b"`"]),
        None -> b"write a return type here",
      };
      err1(params, b"E0126", def.name.span, bytes_concat_all([b"`", def.name.name, b"` has no written return type"]), label, [why])
    },
  }
}

fn close_unreachable_row(cx: Cx, sig: Sig) -> Cx =
  match resolve(cx, sig.fn_ty) {
    TyFn(f) ->
      match f.effects.tail {
        None -> cx,
        Some(tail) ->
          if is_rigid_row(cx.subst, tail) { cx } else {
            let fv = fold(f.params, { tys: [], rows: [] }, |acc: Free, p: Type| free_vars(cx.subst, p, acc));
            let all = free_vars(cx.subst, f.ret, fv);
            if contains_int(all.rows, tail) { cx } else {
              let u = unify_row(cx.subst, cx.fresh, row_empty(), row_open(tail));
              with_unified(cx, u)
            }
          },
      },
    _ -> cx,
  }

// --- Tests and laws --------------------------------------------------------------------------------

// A cached footprint carries the determinism verdict: an effect's `nondet` marker is part of its declaration's hash.
fn check_tests(cx: Cx, m: Mod) -> Cx = {
  let walked = fold(m.module.items, { cx: cx, position: 0 }, |acc: { cx: Cx, position: Int }, it: Item|
    match it {
      ITest(def) -> {
        let c: Cx = {..acc.cx, scope: acc.cx.scope + 1};
        let footprint: WithAtoms = match known_test(c, m.name, acc.position) {
          Some(cached) -> { cx: c, atoms: cached },
          None -> {
            let c1: Cx = {..c, ty_params: map_new(), row_params: map_new(), label_params: map_new(), performs: [], declared_atoms: []};
            let pushed: Cx = {..c1, env: env_push(c1.env)};
            let o: Inferred = infer(pushed, def.body);
            let popped: Cx = {..o.cx, env: env_pop(o.cx.env)};
            let row = resolve_r(popped, o.row);
            { cx: if def.is_nondet { popped } else { check_determinism(popped, def, row.atoms) }, atoms: row.atoms }
          },
        };
        let checked: Cx = footprint.cx;
        { cx: {..checked, tests: push(checked.tests, { name: def.name, module: m.name, key: qualify(m.name, def.name), index: len(checked.tests),
                                                       nondet: def.is_nondet, footprint: footprint.atoms, at: here(checked, def.span) })},
          position: acc.position + 1 }
      },
      _ -> acc,
    });
  walked.cx
}

type WithAtoms = { cx: Cx, atoms: List<Atom> }

fn check_determinism(cx: Cx, def: TestDef, footprint: List<Atom>) -> Cx =
  fold(footprint, cx, |c: Cx, atom: Atom|
    match effect_of(c, atom.effect) {
      None -> c,
      Some(info) ->
        if !info.nondet { c } else {
          let site = site_for(c, atom);
          let (span, direct) = match site { Some(s) -> (s.span, is_direct(s)), None -> (expr_span(def.body), false) };
          let a = atom_text(atom);
          let remedy = if contains_bytes(simulated_names(), atom.effect) { b"handle it here, e.g. `simulate { <body> }`" }
                       else { bytes_concat_all([b"handle it here, e.g. `handle <body> with { ", example_clause(c, info, atom), b" }`"]) };
          let indirect = if direct { [] } else { [bytes_concat_all([b"`", a, b"` is performed inside something this expression calls"])] };
          err_labels(c, b"E0412", b"nondeterministic effect in a deterministic test",
                     [lab(c.module, span, true, bytes_concat_all([if direct { b"performs `" } else { b"reaches `" }, a, b"`, and `", atom.effect, b"` is declared `nondet`"])),
                      lab(c.module, def.name_span, false, bytes_concat_all([b"test `", def.name, b"` is deterministic"]))],
                     append(indirect, [remedy, b"or declare this `test/nondet`, which opts out of the cache and re-runs every time"]))
        },
    })

// A clause the reader could paste, for the operation the atom names.
fn example_clause(cx: Cx, info: EffectInfo, atom: Atom) -> Bytes = {
  let written = as_written(cx, info.name);
  let named = match atom.resource { RNamed(_) -> true, RVar(_) -> true, RSingleton -> false };
  let first = |ok: (OpInfo) -> Bool| fold(info.ops, None, |acc: Option<OpInfo>, o: OpInfo| match acc { Some(_) -> acc, None -> if ok(o) { Some(o) } else { None } });
  let op = match atom.op {
    Some(name) -> op_named(info, name),
    None -> match first(|o: OpInfo| mode_eq(o.mode, atom.mode) && named == o.resource_param) {
      Some(o) -> Some(o),
      None -> match first(|o: OpInfo| mode_eq(o.mode, atom.mode)) { Some(o) -> Some(o), None -> list_at(info.ops, 0) },
    },
  };
  match op {
    Some(o) -> {
      let resource = if o.resource_param { resource_text(atom.resource) } else { b"" };
      let args = join_with(map(range(0, len(o.params)), |i: Int| bytes_concat(b"a", num(i))), b", ");
      bytes_concat_all([written, b".", o.name, resource, b"(", args, b") -> <value>"])
    },
    None -> bytes_concat(written, b".<op>() -> <value>"),
  }
}

fn check_laws(cx: Cx, m: Mod) -> Cx = {
  let walked = fold(m.module.items, { cx: cx, labels: [] }, |acc: { cx: Cx, labels: List<{ name: Bytes, span: Span }> }, it: Item|
    match it {
      ILaw(def) -> {
        let c: Cx = {..acc.cx, scope: acc.cx.scope + 1};
        match fold(acc.labels, None, |p: Option<Span>, l: { name: Bytes, span: Span }| match p { Some(_) -> p, None -> if l.name == def.name { Some(l.span) } else { None } }) {
          Some(first) -> {..acc, cx: err2(c, b"E0105", def.name_span, bytes_concat_all([b"two laws are labelled ", debug_quoted(def.name)]),
                                          b"relabelled here", { module: c.module, span: first }, b"first labelled here",
                                          [b"a law is keyed `<module>.<label>`, so one label names one claim"])},
          None -> { cx: check_law(c, m, def), labels: push(acc.labels, { name: def.name, span: def.name_span }) },
        }
      },
      _ -> acc,
    });
  walked.cx
}

// `{:?}` over a label: quoted, with `"` and `\` escaped.
fn debug_quoted(s: Bytes) -> Bytes =
  bytes_concat_all([b"\"",
    bytes_concat_all(map(range(0, bytes_len(s)), |i: Int| {
      let c = bytes_at(s, i);
      if c == 34 { b"\\\"" } else if c == 92 { b"\\\\" } else if c == 10 { b"\\n" } else if c == 9 { b"\\t" } else { bytes_slice(s, i, i + 1) }
    })),
    b"\""])

fn check_law(cx0: Cx, m: Mod, def: LawDef) -> Cx = {
  let cx: Cx = {..cx0, ty_params: map_new(), row_params: map_new(), label_params: map_new(), performs: [], declared_atoms: [], auto_ty_params: true};
  let types: WithTys = fold(def.binders, { cx: cx, ts: [] }, |acc: { cx: Cx, ts: List<Type> }, b: Binder| {
    let o: WithTy = law_binder(acc.cx, b);
    { cx: o.cx, ts: push(acc.ts, o.t) }
  });
  let c1: Cx = {..types.cx, auto_ty_params: false};
  let sorts = map_fold(c1.ty_params, [], |acc: List<Int>, k: Bytes, t: Type| match t { TyVar(v) -> push(acc, v), _ -> acc });
  let rigid: Cx = fold(sorts, c1, |c: Cx, v: Int| {..c, subst: mark_rigid_ty(c.subst, v)});
  let pushed: Cx = {..rigid, env: env_push(rigid.env)};
  let bound: Cx = fold(range(0, len(def.binders)), pushed, |c: Cx, i: Int| {..c, env: env_bind(c.env, at(def.binders, i).name.name, mono(at(types.ts, i)))});
  let guarded: Cx = match def.guard {
    Some(g) -> {
      let o: Inferred = infer({..bound, performs: []}, g);
      let c: Cx = expect(o.cx, expr_span(g), t_bool(), o.ty, b"a `where` guard states a proposition").cx;
      check_spec_purity(c, SSWhere, [], expr_span(g), resolve_r(c, o.row))
    },
    None -> bound,
  };
  let body: Inferred = infer({..guarded, performs: []}, def.body);
  let c2: Cx = expect(body.cx, expr_span(def.body), t_bool(), body.ty, b"a law states a proposition").cx;
  let row = resolve_r(c2, body.row);
  let c3: Cx = if def.host { c2 } else { check_spec_purity(c2, SSLawBody, [seed_atom()], expr_span(def.body), row) };
  let popped: Cx = {..c3, env: env_pop(c3.env)};
  let binders = map(range(0, len(def.binders)), |i: Int| {
    let b = at(def.binders, i);
    { name: b.name.name, ty: resolve(popped, at(types.ts, i)), span: b.span }
  });
  {..popped, ty_params: map_new(), row_params: map_new(),
    laws: push(popped.laws, { name: def.name, module: m.name, key: qualify(m.name, def.name), index: len(popped.laws), binders: binders,
                              has_guard: match def.guard { Some(_) -> true, None -> false },
                              host: def.host, footprint: row.atoms, at: here(popped, def.span) })}
}

// A binder's type must be one the generator can inhabit: no handler, written row, `Cell`, `Task` or `Secret`.
fn law_binder(cx: Cx, b: Binder) -> { cx: Cx, t: Type } =
  match handler_mention(cx, b.ty) {
    Some(span) -> new_ty(err1(cx, b"E0418", span, b"`forall` cannot quantify over a handler", b"a handler is syntax, not a value",
                              [b"`handle body with { .. }` is an expression form: there is no type a handler inhabits and no value for a binder to range over",
                               b"a handler-parametric law would take a handler type, a `Value::Handler`, a normalization story and a generator, and the evidence such a law could produce is too weak to be worth that yet",
                               b"quantify over the values the handler would answer with instead"])),
    None ->
      match written_row_reason(b.ty) {
        Some(reason) -> new_ty(unquantifiable(cx, b, reason)),
        None -> {
          let o: WithTy = conv_type(cx, b.ty);
          match ungeneratable(o.cx, o.t, []) { Some(reason) -> { cx: unquantifiable(o.cx, b, reason), t: o.t }, None -> o }
        },
      },
  }

fn unquantifiable(cx: Cx, b: Binder, reason: Bytes) -> Cx =
  err1(cx, b"E0418", ty_span(b.ty), bytes_concat_all([b"`forall` cannot quantify over `", b.name.name, b"`"]), reason,
       [b"a law over a type nothing can produce is a claim nothing can ever check, so it is refused here rather than reported as a gap at discharge time"])

// The raw variable, not the printer's letter.
fn row_display(r: Row) -> Bytes = {
  let atoms = join_with(map(r.atoms, atom_text), b", ");
  match r.tail {
    None -> bytes_concat_all([b"{", atoms, b"}"]),
    Some(v) -> if len(r.atoms) == 0 { bytes_concat_all([b"{| e", num(v), b"}"]) } else { bytes_concat_all([b"{", atoms, b" | e", num(v), b"}"]) },
  }
}

fn handler_named(cx: Cx, name: Bytes, span: Span) -> Option<Span> = {
  let is_handler = name == b"Handler" || name == b"handler";
  let declared = match find(cx.r, cx.module, NType, { module: None, name: { name: name, span: span }, span: span }) { Some(_) -> true, None -> false };
  if is_handler && !declared { Some(span) } else { None }
}

fn handler_mention(cx: Cx, te: TypeExpr) -> Option<Span> =
  match te {
    TUnit(_) -> None,
    TBad(_) -> None,
    TVar(id) -> handler_named(cx, id.name, id.span),
    TCon(c) -> {
      let own = if is_bare(c.name) { handler_named(cx, c.name.name.name, c.span) } else { None };
      match own { Some(_) -> own, None -> first_handler_mention(cx, c.args) }
    },
    TFn(f) -> match first_handler_mention(cx, f.params) { Some(s) -> Some(s), None -> handler_mention(cx, f.ret) },
    TRecord(r) -> fold(r.fields, None, |acc: Option<Span>, f: { name: Ident, ty: TypeExpr }| match acc { Some(_) -> acc, None -> handler_mention(cx, f.ty) }),
  }

fn first_handler_mention(cx: Cx, ts: List<TypeExpr>) -> Option<Span> =
  fold(ts, None, |acc: Option<Span>, t: TypeExpr| match acc { Some(_) -> acc, None -> handler_mention(cx, t) })

fn first_reason<a>(xs: List<a>, f: (a) -> Option<Bytes>) -> Option<Bytes> =
  fold(xs, None, |acc: Option<Bytes>, x: a| match acc { Some(_) -> acc, None -> f(x) })

fn written_row_reason(te: TypeExpr) -> Option<Bytes> =
  match te {
    TVar(_) -> None,
    TUnit(_) -> None,
    TBad(_) -> None,
    TCon(c) -> first_reason(c.args, written_row_reason),
    TRecord(r) -> first_reason(r.fields, |f: { name: Ident, ty: TypeExpr }| written_row_reason(f.ty)),
    TFn(f) -> {
      let own = match f.effects {
        Some(row) -> match row.tail {
          Some(_) -> Some(b"an effect variable has no binder here, and a law quantifies over values rather than over rows"),
          None -> match list_at(row.atoms, 0) {
            Some(a) -> Some(bytes_concat_all([b"applying this inside the body would perform `", qname_text(a.eff), b"`, and a law body is pure"])),
            None -> None,
          },
        },
        None -> None,
      };
      match own { Some(_) -> own, None -> match first_reason(f.params, written_row_reason) { Some(r) -> Some(r), None -> written_row_reason(f.ret) } }
    },
  }

fn ungeneratable(cx: Cx, ty: Type, seen: List<Bytes>) -> Option<Bytes> =
  match ty {
    TyVar(_) -> None,
    TyCon(c) ->
      if c.name == b"Cell" { Some(b"a `Cell` is created by `with_cell` and exists only inside its region") }
      else if c.name == b"Task" { Some(b"a `Task` is a key into the scheduler of the `simulate` region that spawned it") }
      else if c.name == b"Secret" { Some(b"a `Secret` is a credential: quantifying over one would have the generator mint credentials and the shrinker print counterexamples") }
      else {
        match first_reason(c.args, |a: Type| ungeneratable(cx, a, seen)) {
          Some(r) -> Some(r),
          None ->
            if contains_bytes(seen, c.name) { None } else {
              let inner = push(seen, c.name);
              first_reason(filter(cx.ctors, |k: CtorInfo| k.type_name == c.name), |k: CtorInfo| first_reason(k.fields, |f: Type| ungeneratable(cx, f, inner)))
            },
        }
      },
    TyFn(f) ->
      if !row_is_pure(f.effects) { Some(bytes_concat_all([b"a function with row ", row_display(f.effects), b" cannot be applied inside a pure body"])) }
      else { match first_reason(f.params, |p: Type| ungeneratable(cx, p, seen)) { Some(r) -> Some(r), None -> ungeneratable(cx, f.ret, seen) } },
    TyRecord(fs) -> first_reason(fs, |f: Field| ungeneratable(cx, f.ty, seen)),
  }

type SpecSite = | SSRequires | SSEnsures | SSWhere | SSLawBody

fn site_phrase(s: SpecSite) -> Bytes =
  match s { SSRequires -> b"a `requires` clause", SSEnsures -> b"an `ensures` clause", SSWhere -> b"a `where` guard", SSLawBody -> b"a law body" }

fn site_short(s: SpecSite) -> Bytes =
  match s { SSRequires -> b"`requires`", SSEnsures -> b"`ensures`", SSWhere -> b"`where` guard", SSLawBody -> b"law body" }

// Every atom past the allowed set is `E0417`, and an open row too.
fn check_spec_purity(cx: Cx, site: SpecSite, allowed: List<Atom>, at_: Span, row: Row) -> Cx = {
  let law_body = match site { SSLawBody -> true, _ -> false };
  let c1: Cx = fold(filter(row.atoms, |a: Atom| !atoms_covered(allowed, a)), cx, |c: Cx, atom: Atom| {
    let found = site_for(c, atom);
    let (span, direct) = match found { Some(s) -> (s.span, is_direct(s)), None -> (at_, false) };
    let fixed = [b"a claim that can perform an effect can change what it observes: an obligation that writes to the resource it judges reports the post-state it caused",
                 b"and a discharge evaluates it hundreds of times, against a world nothing set up"];
    let carried = fold(allowed, fixed, |acc: List<Bytes>, a: Atom|
      push(acc, bytes_concat_all([b"a law body may carry `", atom_text(a), b"` \xe2\x80\x94 the seed a `simulate` region reads \xe2\x80\x94 and nothing else"])));
    let hosted = if law_body { push(carried, b"a law whose body reaches the world is written `law/host`, which declares the relaxation rather than taking it silently, and can never be `proved`") } else { carried };
    err_labels(c, b"E0417", bytes_concat(site_phrase(site), b" cannot perform an effect"),
               [lab(c.module, span, true, bytes_concat_all([if direct { b"performs `" } else { b"reaches `" }, atom_text(atom), b"`"])),
                lab(c.module, at_, false, bytes_concat_all([b"this ", site_short(site), b" must be pure"]))],
               push(hosted, bytes_concat_all([b"compute this with a pure function, or handle `", atom.effect, b"` inside the definition and state a claim about its result"])))
  });
  match row.tail {
    Some(_) -> err1(c1, b"E0417", at_, bytes_concat_all([b"the row of this ", site_short(site), b" is not known to be empty"]),
                    bytes_concat(b"has row ", row_text(row)),
                    [b"an effect variable is pure for some instantiations and not for others, and a claim has to hold for every one",
                     b"call something whose row is closed and empty here"]),
    None -> c1,
  }
}

// --- Spec clauses ------------------------------------------------------------------------------
// Typed after the whole module is published: a clause may name anything the module can reach.

fn record_spec_env(cx: Cx, def: FnDef, name: Bytes, sig: Sig) -> Cx =
  if len(def.spec) == 0 { cx } else {
    {..cx, spec_envs: push(cx.spec_envs, { name: name, ty_params: sig.ty_params, row_params: sig.row_params, params: sig.params, ret: sig.ret })}
  }

fn spec_env_of(cx: Cx, name: Bytes) -> Option<SpecEnv> =
  fold(cx.spec_envs, None, |acc: Option<SpecEnv>, e: SpecEnv| match acc { Some(_) -> acc, None -> if e.name == name { Some(e) } else { None } })

fn check_specs(cx: Cx, m: Mod) -> Cx = {
  let walked: Cx = fold(m.module.items, cx, |c: Cx, it: Item|
    match it {
      IFn(def) ->
        if len(def.spec) == 0 { c } else {
          let name = qualify(m.name, def.name.name);
          match spec_env_of(c, name) {
            None -> c,
            Some(env) -> {
              let shadowed: Cx = check_result_shadow(c, def);
              let walked = fold(range(0, len(def.spec)), { cx: shadowed, specs: [] }, |acc: { cx: Cx, specs: List<SpecInfo> }, i: Int| {
                let clause = at(def.spec, i);
                let o: WithAtoms = check_clause(acc.cx, def, clause, env);
                { cx: o.cx, specs: push(acc.specs, { kind: clause.kind, index: i, footprint: o.atoms, span: clause.span }) }
              });
              match def_of(walked.cx, name) {
                Some(d) -> { let info: DefInfo = d; set_def(walked.cx, {..info, spec: walked.specs}) },
                None -> walked.cx,
              }
            },
          }
        },
      _ -> c,
    });
  {..walked, ty_params: map_new(), row_params: map_new()}
}

fn check_clause(cx: Cx, def: FnDef, clause: SpecClause, env: SpecEnv) -> WithAtoms = {
  let c0: Cx = {..cx, ty_params: env.ty_params, row_params: env.row_params, performs: [], declared_atoms: []};
  let pushed: Cx = {..c0, env: env_push(c0.env)};
  let bound: Cx = fold(range(0, len(def.params)), pushed, |c: Cx, i: Int|
    if i >= len(env.params) { c } else { {..c, env: env_bind(c.env, at(def.params, i).name.name, mono(at(env.params, i)))} });
  let with_result: Cx = match clause.kind {
    SEnsures -> {..bound, env: env_bind(bound.env, result_name(), mono(env.ret))},
    SRequires -> bound,
  };
  let outer = with_result.spec_kind;
  let o: Inferred = infer({..with_result, spec_kind: Some(clause.kind)}, clause.expr);
  let popped: Cx = {..o.cx, spec_kind: outer, env: env_pop(o.cx.env)};
  let c1: Cx = expect(popped, expr_span(clause.expr), t_bool(), o.ty, b"a spec clause states a proposition").cx;
  let row = resolve_r(c1, o.row);
  { cx: check_spec_purity(c1, match clause.kind { SRequires -> SSRequires, SEnsures -> SSEnsures }, [], clause.span, row), atoms: row.atoms }
}

// `result` is introduced beside the parameters, so a definition that has both is reported.
fn check_result_shadow(cx: Cx, def: FnDef) -> Cx =
  match fold(def.spec, None, |acc: Option<Span>, c: SpecClause| match acc { Some(_) -> acc, None -> match c.kind { SEnsures -> Some(c.span), SRequires -> None } }) {
    None -> cx,
    Some(ensures) -> fold(def.params, cx, |c: Cx, p: Param|
      if p.name.name != result_name() { c } else {
        err_labels(c, b"E0105", bytes_concat_all([b"`result` is bound twice on `", def.name.name, b"`"]),
                   [lab(c.module, p.name.span, true, b"this parameter is named `result`"),
                    lab(c.module, ensures, false, b"`ensures` binds `result` to the return value")],
                   [b"rename the parameter; a definition with no `ensures` may still call one `result`"])
      }),
  }

// --- Derivability ------------------------------------------------------------------------------
// The one predicate a `where` clause, a `Map` key type and a `derive` ask.

type Blocked = { ty: Type, why: Why }
type AdtShape = { name: Bytes, params: List<Int>, fields: List<Type> }

// Every sum type this run declared, flattened: its parameters and every field of every variant.
fn adt_shapes(cx: Cx) -> List<AdtShape> =
  fold(cx.ctors, [], |acc: List<AdtShape>, k: CtorInfo| {
    let i = fold(range(0, len(acc)), 0 - 1, |p: Int, j: Int| if p >= 0 { p } else if at(acc, j).name == k.type_name { j } else { p });
    if i < 0 { push(acc, { name: k.type_name, params: k.scheme.ty_vars, fields: k.fields }) }
    else { let a = at(acc, i); set_at(acc, i, { name: a.name, params: a.params, fields: append(a.fields, k.fields) }) }
  })

fn find_adt(adts: List<AdtShape>, name: Bytes) -> Option<AdtShape> =
  fold(adts, None, |acc: Option<AdtShape>, a: AdtShape| match acc { Some(_) -> acc, None -> if a.name == name { Some(a) } else { None } })

fn substitute_ty(t: Type, params: List<Int>, args: List<Type>) -> Type =
  match t {
    TyVar(v) -> {
      let i = fold(range(0, len(params)), 0 - 1, |p: Int, j: Int| if p >= 0 { p } else if at(params, j) == v { j } else { p });
      if i < 0 || i >= len(args) { t } else { at(args, i) }
    },
    TyCon(c) -> TyCon({ name: c.name, args: map(c.args, |a: Type| substitute_ty(a, params, args)) }),
    TyFn(f) -> TyFn({ params: map(f.params, |p: Type| substitute_ty(p, params, args)), ret: substitute_ty(f.ret, params, args), effects: f.effects }),
    TyRecord(fs) -> TyRecord(map(fs, |f: Field| { name: f.name, ty: substitute_ty(f.ty, params, args) })),
  }

fn json_null_encoded(t: Type) -> Bool = match t { TyCon(c) -> null_encoded_name(c.name), _ -> false }

fn first_blocked(d: Deriver, tys: List<Type>, adts: List<AdtShape>, assumed: List<Int>, visiting: List<Bytes>) -> Option<Blocked> =
  fold(tys, None, |acc: Option<Blocked>, t: Type| match acc { Some(_) -> acc, None -> derivable(d, t, adts, assumed, visiting) })

fn derivable(d: Deriver, ty: Type, adts: List<AdtShape>, assumed: List<Int>, visiting: List<Bytes>) -> Option<Blocked> =
  match ty {
    TyVar(v) -> if contains_int(assumed, v) { None } else { Some({ ty: ty, why: WUnconstrained(v) }) },
    TyFn(_) -> Some({ ty: ty, why: WFunction }),
    TyRecord(fs) -> first_blocked(d, map(fs, |f: Field| f.ty), adts, assumed, visiting),
    TyCon(c) ->
      match con_shape(d, c.name) {
        Leaf -> None,
        Refused(why) -> Some({ ty: ty, why: why }),
        Structural ->
          if same_deriver(d, DJson) && c.name == b"Option" && len(c.args) > 0 && json_null_encoded(at(c.args, 0)) { Some({ ty: ty, why: WNullInsideOption }) }
          else { first_blocked(d, c.args, adts, assumed, visiting) },
        Nominal ->
          // A recursive type is derivable exactly when its non-recursive parts are.
          if contains_bytes(visiting, c.name) { None } else {
            match find_adt(adts, c.name) {
              None -> None,
              Some(adt) -> first_blocked(d, map(adt.fields, |f: Type| substitute_ty(f, adt.params, c.args)), adts, assumed, push(visiting, c.name)),
            }
          },
      },
  }

// A flexible variable is a type argument nothing pinned rather than one that is wrong.
fn skipped_flexible(cx: Cx, b: Blocked) -> Bool = match b.why { WUnconstrained(v) -> !is_rigid_ty(cx.subst, v), _ -> false }

fn secret_notes(d: Deriver) -> List<Bytes> =
  match refusal_note(WSecret, d) { Some(n) -> [secret_reason(d), n], None -> [secret_reason(d)] }

// The simple name of the handle type a `WHandle` refused: `Cell` or `Task`.
fn handle_what(t: Type) -> Bytes = match t { TyCon(c) -> c.name, _ -> b"" }

// The parameter name a refused rigid variable was declared under, else the rendered variable.
fn param_name(params: List<RigidParam>, v: Int, fallback: Bytes) -> Bytes =
  fold(params, fallback, |acc: Bytes, p: RigidParam| if p.v == v { p.name } else { acc })

fn why_notes_for_map_key(w: Why, b: Blocked, blocker: Bytes, params: List<RigidParam>) -> List<Bytes> =
  match w {
    WFloatIsNotOrdered -> [b"`Float` has no total order: `NaN` is not equal to itself, so a key would have no position the next lookup could find it at",
                           b"use `Decimal` for exact numbers, or key on something else"],
    WFunction -> [b"a function has no order to sort keys by"],
    WHandle -> [bytes_concat_all([b"a `", handle_what(b.ty), b"` names a location rather than a value, so two of them have no order"])],
    WNullInsideOption -> [],
    WSecret -> secret_notes(DOrd),
    WUnconstrained(v) -> [bytes_concat_all([b"add `where derivable(ord, ", param_name(params, v, blocker), b")` to this signature; the body may then                          assume it"])],
  }

fn why_notes_for_constraint(w: Why, d: Deriver, b: Blocked, blocker: Bytes, params: List<RigidParam>) -> List<Bytes> =
  match w {
    WFunction -> [bytes_concat_all([b"`", blocker, b"` is a function, and a function has no ", what_of(d)])],
    WHandle -> [bytes_concat_all([b"a `", handle_what(b.ty), b"` names a location rather than a value, so it has no encoding"])],
    WFloatIsNotOrdered -> [b"`Float` has no total order: `NaN` is not equal to itself", b"use `Decimal` for exact numbers"],
    WNullInsideOption -> [bytes_concat_all([b"`", blocker, b"` writes `None` and its payload alike"]), null_in_option_note()],
    WSecret -> secret_notes(d),
    WUnconstrained(v) -> [bytes_concat_all([b"add `where derivable(", deriver_text(d), b", ", param_name(params, v, blocker), b")` to the signature this call sits in; the body may then assume it"])],
  }

fn rigid_params(cx: Cx) -> List<RigidParam> =
  map_fold(cx.ty_params, [], |acc: List<RigidParam>, k: Bytes, t: Type| match t { TyVar(v) -> push(acc, { name: k, v: v }), _ -> acc })

fn assumed_for(cx: Cx, d: Deriver) -> List<Int> =
  fold(cx.assumed, [], |acc: List<Int>, a: Assumed| if same_deriver(a.deriver, d) { a.vars } else { acc })

fn map_key_types(t: Type, out: List<Type>) -> List<Type> =
  match t {
    TyCon(c) -> {
      let own = if c.name == b"Map" && len(c.args) == 2 { push(out, at(c.args, 0)) } else { out };
      fold(c.args, own, |acc: List<Type>, a: Type| map_key_types(a, acc))
    },
    TyFn(f) -> map_key_types(f.ret, fold(f.params, out, |acc: List<Type>, p: Type| map_key_types(p, acc))),
    TyRecord(fs) -> fold(fs, out, |acc: List<Type>, f: Field| map_key_types(f.ty, acc)),
    TyVar(_) -> out,
  }

// Every `Map` in a type as it was written or instantiated, judged once the module is solved.
fn note_map_keys(cx: Cx, span: Span, ty: Type) -> Cx = {
  let found = map_key_types(ty, []);
  if len(found) == 0 { cx } else {
    let assumed = assumed_for(cx, DOrd);
    let params = rigid_params(cx);
    {..cx, map_keys: append(cx.map_keys, map(found, |k: Type| { module: cx.module, span: span, scope: cx.scope, key: k, assumed: assumed, params: params }))}
  }
}

// A reference that instantiated a parameter its callee constrained.
fn note_constraints(cx: Cx, span: Span, callee: Bytes, args: List<Type>) -> Cx =
  match map_get(cx.constraints, callee) {
    None -> cx,
    Some(cs) ->
      if len(cs) == 0 { cx } else {
        let callee_at = match def_of(cx, callee) { Some(d) -> d.at, None -> { module: cx.module, span: span } };
        let params = rigid_params(cx);
        let sites = fold(cs, [], |acc: List<ConstraintSite>, c: DefConstraint|
          if c.param >= len(args) { acc }
          else { push(acc, { module: cx.module, span: span, deriver: c.deriver, ty: at(args, c.param), callee: callee, callee_at: callee_at, assumed: assumed_for(cx, c.deriver), params: params }) });
        {..cx, constrained_uses: append(cx.constrained_uses, sites)}
      },
  }

fn check_map_keys(cx: Cx) -> Cx = {
  let adts = adt_shapes(cx);
  let walked = fold(cx.map_keys, { cx: {..cx, map_keys: []}, seen: [] }, |acc: { cx: Cx, seen: List<{ scope: Int, text: Bytes }> }, site: MapKeySite| {
    let key = resolve(acc.cx, site.key);
    match derivable(DOrd, key, adts, site.assumed, []) {
      None -> acc,
      Some(blocked) ->
        if skipped_flexible(acc.cx, blocked) { acc } else {
          let pr = print_ty(printer_new(), key);
          let rendered = pr.s;
          let dup = fold(acc.seen, false, |b: Bool, s: { scope: Int, text: Bytes }| b || (s.scope == site.scope && s.text == rendered));
          if dup { acc } else {
            let blocker = print_ty(pr.p, blocked.ty).s;
            { cx: report(acc.cx, diag1(b"E0206", site.module, site.span,
                     bytes_concat_all([b"`", blocker, b"` is not an ordered type, so it cannot be a `Map` key"]),
                     bytes_concat_all([b"this map's key type is `", rendered, b"`"]),
                     why_notes_for_map_key(blocked.why, blocked, blocker, site.params))),
              seen: push(acc.seen, { scope: site.scope, text: rendered }) }
          }
        },
    }
  });
  walked.cx
}

fn check_constraints(cx: Cx) -> Cx = {
  let adts = adt_shapes(cx);
  let walked = fold(cx.constrained_uses, { cx: {..cx, constrained_uses: []}, seen: [] },
    |acc: { cx: Cx, seen: List<{ span: Span, text: Bytes, tag: Int }> }, site: ConstraintSite| {
      let ty = resolve(acc.cx, site.ty);
      match derivable(site.deriver, ty, adts, site.assumed, []) {
        None -> acc,
        Some(blocked) ->
          if skipped_flexible(acc.cx, blocked) { acc } else {
            let pr = print_ty(printer_new(), ty);
            let rendered = pr.s;
            let tag = deriver_tag(site.deriver);
            let dup = fold(acc.seen, false, |b: Bool, s: { span: Span, text: Bytes, tag: Int }| b || (s.span == site.span && s.text == rendered && s.tag == tag));
            if dup { acc } else {
              let blocker = print_ty(pr.p, blocked.ty).s;
              let callee = default_binder(site.callee);
              let dv = deriver_text(site.deriver);
              { cx: err_labels(acc.cx, b"E0206", bytes_concat_all([b"`", rendered, b"` cannot be derived for `", dv, b"`"]),
                               [lab(site.module, site.span, true, bytes_concat_all([b"`", callee, b"` requires `derivable(", dv, b", \xc2\xb7)` here"])),
                                lab(site.callee_at.module, site.callee_at.span, false, bytes_concat_all([b"`", callee, b"` declares the constraint on its signature"]))],
                               why_notes_for_constraint(blocked.why, site.deriver, blocked, blocker, site.params)),
                seen: push(acc.seen, { span: site.span, text: rendered, tag: tag }) }
            }
          },
      }
    });
  walked.cx
}

// --- The two passes that read what expansion produced --------------------------------------------

fn expanded_here(m: Mod, def: DeriveDef) -> Bool =
  fold(m.derived, false, |acc: Bool, d: Derived| acc || (same_deriver(d.deriver, def.deriver) && d.target == def.target.name))

// The target as a solved type when it has no parameters; an alias's reports are dropped, already made at its declaration.
fn derive_target(cx: Cx, m: Mod, target: Bytes) -> Option<WithTy> = {
  let qualified = qualify(m.name, target);
  match map_get(cx.types, qualified) {
    None -> None,
    Some(decl) ->
      if len(decl.params) > 0 { None } else {
        match decl.alias {
          None -> Some({ cx: cx, t: TyCon({ name: qualified, args: [] }) }),
          Some(alias) -> {
            let mark = len(cx.diags);
            let inner: Cx = {..cx, ty_params: map_new(), alias_stack: push(cx.alias_stack, qualified), module: decl.owner};
            let o: WithTy = conv_type(inner, alias);
            Some({ cx: {..o.cx, ty_params: cx.ty_params, alias_stack: cx.alias_stack, module: cx.module, diags: take(o.cx.diags, mark)}, t: o.t })
          },
        }
      },
  }
}

fn why_notes_for_derive(w: Why, d: Deriver, b: Blocked, blocker: Bytes) -> List<Bytes> =
  match w {
    WNullInsideOption -> [bytes_concat_all([b"`", blocker, b"` writes `None` and its payload alike"]), null_in_option_note()],
    WFloatIsNotOrdered -> [b"`Float` has no total order: `NaN` is not equal to itself"],
    WFunction -> [b"a function has no encoding to derive"],
    WHandle -> [bytes_concat_all([b"a `", handle_what(b.ty), b"` names a location rather than a value, so it has no encoding"])],
    WSecret -> secret_notes(d),
    WUnconstrained(_) -> [],
  }

// `derivable(D, T)` over each `derive`'s target as a solved type.
fn check_derives(cx: Cx) -> Cx = {
  let adts = adt_shapes(cx);
  fold(range(0, len(cx.mods)), cx, |c: Cx, i: Int| {
    let m = at(c.mods, i);
    fold(m.module.items, c, |cc: Cx, it: Item|
      match it {
        IDerive(def) ->
          if !expanded_here(m, def) { cc } else {
            match derive_target({..cc, module: i}, m, def.target.name) {
              None -> cc,
              Some(o) ->
                match derivable(def.deriver, o.t, adts, [], []) {
                  None -> o.cx,
                  Some(blocked) ->
                    match blocked.why {
                      WUnconstrained(_) -> o.cx,
                      _ -> {
                        let blocker = type_text(blocked.ty);
                        let dv = deriver_text(def.deriver);
                        report(o.cx, diag1(b"E0206", i, def.span, bytes_concat_all([b"`", dv, b"` cannot be derived for `", def.target.name, b"`"]),
                                           bytes_concat_all([b"`", blocker, b"` has no ", what_of(def.deriver)]),
                                           push(why_notes_for_derive(blocked.why, def.deriver, blocked, blocker),
                                                bytes_concat_all([b"write the dictionary for `", def.target.name, b"` by hand, or change the field"]))))
                      },
                    },
                }
            }
          },
        _ -> cc,
      })
  })
}

// Anything a generated definition failed on, other than a name it could not see, is Ply's fault.
fn attribute_generated(cx: Cx) -> Cx = {
  let spans = fold(range(0, len(cx.mods)), [], |acc: List<Label>, i: Int|
    fold(at(cx.mods, i).derived, acc, |a: List<Label>, d: Derived| push(a, lab(i, d.span, true, b""))));
  if len(spans) == 0 { cx } else {
    {..cx, diags: map(cx.diags, |d: Diag| {
      let primary = fold(d.labels, None, |acc: Option<Label>, l: Label| match acc { Some(_) -> acc, None -> if l.primary { Some(l) } else { None } });
      let generated = match primary { Some(p) -> fold(spans, false, |b: Bool, s: Label| b || (s.module == p.module && s.start == p.start && s.end == p.end)), None -> false };
      if d.code == b"E0206" || !generated { d } else {
        { code: b"E0505", notes: d.notes + 2, labels: d.labels, text: d.text, message: b"a derived definition does not typecheck",
          notes_text: push(push_front_bytes(bytes_concat(b"this is a compiler bug in the deriver: ", d.message), d.notes_text),
                           b"derivation is total, so a generated body that fails to check is Ply's fault rather than yours"),
          severity: d.severity, fixes: d.fixes }
      }
    })}
  }
}

// --- Comparisons, simulations and regions, once the module is solved ------------------------------

fn contains_fn(t: Type) -> Bool =
  match t {
    TyFn(_) -> true,
    TyCon(c) -> fold(c.args, false, |b: Bool, a: Type| b || contains_fn(a)),
    TyRecord(fs) -> fold(fs, false, |b: Bool, f: Field| b || contains_fn(f.ty)),
    TyVar(_) -> false,
  }

fn push_front_bytes(x: Bytes, xs: List<Bytes>) -> List<Bytes> = fold(xs, [x], |acc: List<Bytes>, y: Bytes| push(acc, y))

fn check_comparisons(cx: Cx) -> Cx =
  fold(cx.comparisons, {..cx, comparisons: []}, |c: Cx, site: { module: Int, span: Span, ty: Type }| {
    let resolved = resolve(c, site.ty);
    if contains_fn(resolved) {
      report(c, diag1(b"E0201", site.module, site.span, b"functions cannot be compared for equality",
                      bytes_concat_all([b"both sides have type `", type_text(resolved), b"`"]), [b"compare the results of calling them instead"]))
    } else { c }
  })

fn mentions_task(t: Type) -> Bool =
  match t {
    TyCon(c) -> c.name == b"Task" || fold(c.args, false, |b: Bool, a: Type| b || mentions_task(a)),
    TyFn(f) -> fold(f.params, false, |b: Bool, p: Type| b || mentions_task(p)) || mentions_task(f.ret),
    TyRecord(fs) -> fold(fs, false, |b: Bool, f: Field| b || mentions_task(f.ty)),
    TyVar(_) -> false,
  }

fn is_dummy(s: Span) -> Bool = s.start == 0 && s.end == 0

fn encloses(outer: Span, inner: Span) -> Bool =
  !is_dummy(outer) && !is_dummy(inner) && outer.start <= inner.start && inner.end <= outer.end

fn check_simulations(cx: Cx) -> Cx = {
  let seed = seed_atom();
  let sites = cx.simulations;
  fold(sites, {..cx, simulations: []}, |c: Cx, site: Simulation| {
    let nested: Cx = if atoms_contains(resolve_r(c, site.body_row).atoms, seed) { nested_simulation(c, site, sites) } else { c };
    let ty = resolve(nested, site.body_ty);
    if mentions_task(ty) {
      report(nested, diag1(b"E0413", site.module, site.body_span, b"a task escapes the `simulate` region that spawned it",
                           bytes_concat_all([b"this has type `", type_text(ty), b"`"]),
                           [b"a `Task` is a key into the region's scheduler, and the scheduler ends with the region",
                            b"`join` the task inside the region and return its value instead"]))
    } else { nested }
  })
}

fn nested_simulation(cx: Cx, site: Simulation, sites: List<Simulation>) -> Cx = {
  let inner = fold(sites, None, |acc: Option<Simulation>, other: Simulation|
    match acc {
      Some(_) -> acc,
      None -> if other.module == site.module && other.span != site.span && encloses(site.body_span, other.span) { Some(other) } else { None },
    });
  let message = b"a `simulate` region inside another `simulate` region";
  let primary = lab(site.module, site.span, true, b"this region's body reaches `sim.read`");
  let tail = [b"two schedulers means two notions of `runnable`, and a task in the inner region blocking the outer one",
              b"hoist the inner region out, or drop it and let the outer one schedule"];
  match inner {
    Some(o) -> err_labels(cx, b"E0416", message, [primary, lab(o.module, o.span, false, b"the region it reaches is here")], tail),
    None -> report(cx, diag(b"E0416", message, [primary], push_front_bytes(b"something this body calls carries `sim.read`, so it enters a region too", tail))),
  }
}

fn row_brands(row: Row, region: Bytes) -> Bool =
  fold(row.atoms, false, |b: Bool, a: Atom| b || (a.effect == cell() && a.resource == RNamed(region)))

// Whether a resolved type carries region `r`'s brand, by either route a brand travels.
fn brand_in(t: Type, region: Bytes) -> Bool =
  match t {
    TyVar(_) -> false,
    TyCon(c) -> region_of(t) == Some(region) || fold(c.args, false, |b: Bool, a: Type| b || brand_in(a, region)),
    TyFn(f) -> row_brands(f.effects, region) || fold(f.params, false, |b: Bool, p: Type| b || brand_in(p, region)) || brand_in(f.ret, region),
    TyRecord(fs) -> fold(fs, false, |b: Bool, f: Field| b || brand_in(f.ty, region)),
  }

// Whether the brand reached this type through a function's row rather than through its shape.
fn carries_brand_in_row(t: Type, region: Bytes) -> Bool =
  match t {
    TyVar(_) -> false,
    TyCon(c) -> fold(c.args, false, |b: Bool, a: Type| b || carries_brand_in_row(a, region)),
    TyFn(f) -> row_brands(f.effects, region) || fold(f.params, false, |b: Bool, p: Type| b || carries_brand_in_row(p, region)) || carries_brand_in_row(f.ret, region),
    TyRecord(fs) -> fold(fs, false, |b: Bool, f: Field| b || carries_brand_in_row(f.ty, region)),
  }

fn check_regions(cx: Cx) -> Cx =
  fold(cx.regions, {..cx, regions: []}, |c: Cx, site: RegionSite|
    check_region_handoffs(check_region_spawns(check_region_stores(check_region_exits(c, site), site), site), site))

// The value the region evaluates to; a bare `with_cell` reports the same escape as `E0201`.
fn check_region_exits(cx: Cx, site: RegionSite) -> Cx = {
  let ty = resolve(cx, site.body_ty);
  if !brand_in(ty, site.name) { cx } else {
    let n = site.name;
    let spans = if len(site.exits) == 0 { [site.body_span] } else { site.exits };
    let shown = type_text(ty);
    let primaries = map(spans, |s: Span| lab(site.module, s, true, bytes_concat_all([b"this has type `", shown, b"`"])));
    if site.with_cell {
      let carries = if carries_brand_in_row(ty, n) {
        [bytes_concat_all([b"the closure's row still carries `cell.read[", n, b"]` or `cell.write[", n, b"]`, so it reads or writes a cell the region frees"])]
      } else { [] };
      err_labels(cx, b"E0201", bytes_concat_all([b"the cell escapes its `with_cell[", n, b"]` region"]), primaries,
                 push(carries, b"read the cell inside the region and return the value instead"))
    } else {
      let carries = if carries_brand_in_row(ty, n) {
        [bytes_concat_all([b"the closure's row still carries `cell.read[", n, b"]` or `cell.write[", n, b"]`, so it reads or writes a value the region frees"])]
      } else { [] };
      err_labels(cx, b"E0446", bytes_concat_all([b"a value allocated in region `", n, b"` escapes the region"]),
                 push(primaries, lab(site.module, site.span, false, bytes_concat_all([b"`", n, b"` opens here, and everything allocated in it is freed at the region's `}`"]))),
                 push(carries, bytes_concat_all([b"read the value inside the region and answer with something that does not mention `", n, b"`"])))
    }
  }
}

fn opens_here(n: Bytes) -> Bytes = bytes_concat_all([b"`", n, b"` opens here and is freed at its `}`"])

fn check_region_stores(cx: Cx, site: RegionSite) -> Cx =
  fold(site.outer, cx, |c: Cx, b: OuterBinding| {
    let ty = resolve(c, b.ty);
    if brand_in(ty, site.name) {
      err_labels(c, b"E0446", bytes_concat_all([b"a value allocated in region `", site.name, b"` is stored where it outlives the region"]),
                 [lab(site.module, b.site, true, bytes_concat_all([b"`", b.name, b"` has type `", type_text(ty), b"`, and it was bound before `", site.name, b"` opened"])),
                  lab(site.module, site.span, false, opens_here(site.name))],
                 [bytes_concat_all([b"storing into `", b.name, b"` outlives the region, so what is stored may not mention `", site.name, b"`"])])
    } else { c }
  })

fn check_region_spawns(cx: Cx, site: RegionSite) -> Cx =
  fold(site.spawns, cx, |c: Cx, s: SpawnSite| {
    let ty = resolve(c, s.ty);
    if brand_in(ty, site.name) {
      err_labels(c, b"E0446", bytes_concat_all([b"a value allocated in region `", site.name, b"` is sent to another task"]),
                 [lab(site.module, s.span, true, bytes_concat_all([b"this has type `", type_text(ty), b"`"])),
                  lab(site.module, site.span, false, opens_here(site.name))],
                 [b"the scheduler that runs the task was installed outside the region, so the task can still be running when the region's memory is gone",
                  bytes_concat_all([b"open the `simulate` region inside `with_region[", site.name, b"]`, or pass the task something that does not mention `", site.name, b"`"])])
    } else { c }
  })

fn check_region_handoffs(cx: Cx, site: RegionSite) -> Cx =
  fold(site.handoffs, cx, |c: Cx, h: HandoffSite| {
    let ty = resolve(c, h.ty);
    if !brand_in(ty, site.name) { c } else {
      let n = site.name;
      let carries = if carries_brand_in_row(ty, n) {
        [bytes_concat_all([b"the closure's row still carries `cell.read[", n, b"]` or `cell.write[", n, b"]`, so whoever handles the operation can read or write a value the region frees"])]
      } else { [] };
      err_labels(c, b"E0446", bytes_concat_all([b"a value allocated in region `", n, b"` is handed to `", h.op, b"`"]),
                 [lab(site.module, h.span, true, bytes_concat_all([b"this has type `", type_text(ty), b"`"])),
                  lab(site.module, site.span, false, opens_here(n))],
                 append(carries,
                   [bytes_concat_all([b"`", h.op, b"` is declared outside every region, so its type cannot say the value belongs to `", n, b"`, and the handler \xe2\x80\x94 which may be installed anywhere, and may outlive the region \xe2\x80\x94 receives it at a type variable that mentions no region at all"]),
                    bytes_concat_all([b"read the value inside the region and perform the operation with something that does not mention `", n, b"`"])]))
    }
  })

// --- Internal effects ---------------------------------------------------------------------------------

fn mark_internal_effects(cx: Cx) -> Cx = {
  // The list and its index are built in one pass; scanning the list per definition and per call edge is quadratic.
  let indexed = fold(range(0, len(cx.mods)), { names: [], index: map_new() },
    |acc: { names: List<Bytes>, index: Map<Bytes, Int> }, mi: Int|
      fold(at(cx.mods, mi).module.items, acc,
        |a: { names: List<Bytes>, index: Map<Bytes, Int> }, it: Item|
          match it {
            IFn(def) -> {
              let nm = qualify(module_name(cx, mi), def.name.name);
              match map_get(a.index, nm) {
                Some(_) -> a,
                None -> { names: push(a.names, nm), index: map_insert(a.index, nm, len(a.names)) },
              }
            },
            _ -> a,
          }));
  let names = indexed.names;
  let index = indexed.index;
  let n = len(names);
  let seeded = fold(range(0, len(cx.mods)), { cx: cx, effects: map(range(0, n), |i: Int| false), callers: map(range(0, n), |i: Int| []) },
    |acc: { cx: Cx, effects: List<Bool>, callers: List<List<Int>> }, mi: Int| {
      let c: Cx = {..acc.cx, module: mi};
      fold(at(c.mods, mi).module.items, {..acc, cx: c}, |a: { cx: Cx, effects: List<Bool>, callers: List<List<Int>> }, it: Item|
        match it {
          IFn(def) -> {
            let at_ = match map_get(index, qualify(module_name(a.cx, mi), def.name.name)) { Some(i) -> i, None -> 0 - 1 };
            if at_ < 0 { a } else {
              let refs = refs_of(def.body);
              let flagged = if refs.effects { set_at(a.effects, at_, true) } else { a.effects };
              let params = map(def.params, |p: Param| p.name.name);
              let callers = fold(refs.names, a.callers, |cs: List<List<Int>>, q: QName|
                if is_bare(q) && contains_bytes(params, q.name.name) { cs } else {
                  match declared_value(a.cx, q) {
                    None -> cs,
                    Some(callee) -> { let to = match map_get(index, callee) { Some(i) -> i, None -> 0 - 1 }; if to < 0 { cs } else { set_at(cs, to, push(at(cs, to), at_)) } },
                  }
                });
              { cx: a.cx, effects: flagged, callers: callers }
            }
          },
          _ -> a,
        })
    });
  let propagated = iterate({ effects: seeded.effects, pending: filter(range(0, n), |i: Int| at(seeded.effects, i)) }, n * n + n + 2,
    |st: { effects: List<Bool>, pending: List<Int> }|
      if len(st.pending) == 0 { Stop(st.effects) } else {
        let node = at(st.pending, len(st.pending) - 1);
        let rest = take(st.pending, len(st.pending) - 1);
        let out = fold(at(seeded.callers, node), { effects: st.effects, pending: rest }, |a: { effects: List<Bool>, pending: List<Int> }, caller: Int|
          if at(a.effects, caller) { a } else { { effects: set_at(a.effects, caller, true), pending: push(a.pending, caller) } });
        Continue(out)
      });
  let c: Cx = seeded.cx;
  fold(range(0, n), c, |cc: Cx, i: Int|
    match def_of(cc, at(names, i)) {
      Some(d) -> { let info: DefInfo = d; set_def(cc, {..info, internally_effectful: at(propagated, i)}) },
      None -> cc,
    })
}

// --- `check_program` --------------------------------------------------------------------------------------

fn fresh_cx(r: Resolved, mods: List<Mod>, known: Known) -> Cx =
  install_prelude({ r: r, mods: mods, module: 0, subst: subst_new(), fresh: fresh_new(), env: env_new(), diags: [],
                    types: map_new(), effects: [], effect_index: map_new(), ctors: [], ctor_index: map_new(),
                    defs: [], def_index: map_new(), tests: [], laws: [], ty_params: map_new(), row_params: map_new(),
                    label_params: map_new(), label_apps: [], label_sites: [], group_labels: [],
                    auto_ty_params: false, alias_stack: [], refused_atoms: [], performs: [], declared_atoms: [], comparisons: [], scope: 0,
                    constraints: map_new(), numerics: [], bit_ops: [], concats: [], updates: [], update_shapes: [],
                    simulate_depth: 0, open_regions: [], regions: [], simulations: [],
                    map_keys: [], constrained_uses: [], spec_kind: None, spec_envs: [], derived: None, known: known, assumed: [] })

type Checked = { cx: Cx, ok: Bool }

pub fn check_program(r: Resolved, mods: List<Mod>) -> Checked = check_program_with(r, mods, no_known())

// Every diagnostic, deduplicated, when any is an error; a warning alone is not one.
pub fn check_diagnostics(r: Resolved, mods: List<Mod>) -> List<Diag> = {
  let out = check_program(r, mods);
  if fold(out.cx.diags, false, |b: Bool, d: Diag| b || d.severity == b"error") { dedup_diags(out.cx.diags) } else { [] }
}

// What `check_program` publishes, prelude entries included, or the diagnostics when any is an error.
pub type Front = { ok: Bool, diags: List<Diag>, defs: List<DefInfo>, tests: List<TestInfo>, laws: List<LawInfo>,
                   effects: List<EffectInfo>, ctors: List<CtorInfo> }

pub fn check_front(r: Resolved, mods: List<Mod>) -> Front = {
  let out = check_program(r, mods);
  let failed = fold(out.cx.diags, false, |b: Bool, d: Diag| b || d.severity == b"error");
  { ok: !failed, diags: if failed { dedup_diags(out.cx.diags) } else { [] },
    defs: out.cx.defs, tests: out.cx.tests, laws: out.cx.laws, effects: out.cx.effects, ctors: out.cx.ctors }
}

// What the emitter needs from the checker: the definitions published as pure (empty footprint, no
// constraint), for its constant table, the labels every call fills, and the shape of every record
// update. `None` if the program fails.
pub type EmitFacts = { pure: List<Bytes>, label_sites: List<LabelSite>, updates: List<UpdateShape> }

pub fn emit_facts(r: Resolved, mods: List<Mod>) -> Option<EmitFacts> = {
  let out = check_program(r, mods);
  if !out.ok { None } else {
    Some({ pure: fold(out.cx.defs, [], |acc: List<Bytes>, d: DefInfo|
             if len(d.footprint) == 0 && len(d.constraints) == 0 { push(acc, d.name) } else { acc }),
           label_sites: out.cx.label_sites, updates: out.cx.update_shapes })
  }
}

// The record-update shapes of a checked program, for a caller that lowers bodies but emits no C.
pub fn update_shapes(r: Resolved, mods: List<Mod>) -> Option<List<UpdateShape>> = {
  let out = check_program(r, mods);
  if fold(out.cx.diags, false, |b: Bool, d: Diag| b || d.severity == b"error") { None } else { Some(out.cx.update_shapes) }
}

// One module's shapes, keyed by the update's span, as `expand_record_updates` reads them.
fn shapes_in(all: List<UpdateShape>, module: Int) -> Map<Bytes, List<Bytes>> =
  fold(all, map_new(), |acc: Map<Bytes, List<Bytes>>, s: UpdateShape|
    if s.module != module { acc } else { map_insert(acc, span_key(s.span), s.names) })

// The modules with every record update written out as the literal it stands for: what the lowering
// reads, and what only the checker knows.
pub fn expanded_mods(mods: List<Mod>, shapes: List<UpdateShape>) -> List<Mod> =
  map(range(0, len(mods)), |i: Int| {
    let m: Mod = at(mods, i);
    { name: m.name, module: expand_record_updates(m.module, shapes_in(shapes, i)), derived: m.derived }
  })

// Every use of a label-generic definition is a call, and every call fills its labels.
fn check_label_apps(cx0: Cx) -> Cx = {
  let out: Cx = fold(cx0.label_apps, cx0, |c: Cx, a: LabelApp| {
    let at_: Cx = {..c, module: a.module};
    let judged: Cx =
      if !a.called {
        err1(at_, b"E0306", a.span,
             bytes_concat_all([b"`", simple_name_of(a.callee), b"` must be called directly"]),
             b"used as a value",
             [b"its row names a label the caller fills, so it has no meaning until a call says which resource it touches"])
      } else {
        let names = fold(a.vars, [], |acc: List<Bytes>, v: Int|
          match label_named(at_, a, v) { Some(n) -> push(acc, n), None -> acc });
        if len(names) < len(a.vars) {
          err1(at_, b"E0306", a.span,
               bytes_concat_all([b"this call leaves a label of `", simple_name_of(a.callee), b"` unfilled"]),
               b"no resource to perform under",
               [bytes_concat_all([b"write it at the call, as `", simple_name_of(a.callee), b"[<label>](..)`, or pass an argument whose row names it"])])
        } else {
          {..at_, label_sites: push(at_.label_sites, { module: a.module, span: a.span, labels: names })}
        }
      };
    {..judged, module: c.module}
  });
  {..out, module: cx0.module}
}

// A settled label is the resource it names, or the enclosing definition's own label parameter.
fn label_named(cx: Cx, a: LabelApp, v: Int) -> Option<Bytes> =
  if v < 0 { None } else {
    let t = shallow(cx.subst, TyVar(v));
    match label_of(t) {
      Some(n) -> Some(n),
      None -> match t { TyVar(w) -> param_named(a.params, w), _ -> None },
    }
  }

fn param_named(params: Map<Bytes, Int>, v: Int) -> Option<Bytes> =
  map_fold(params, None, |acc: Option<Bytes>, k: Bytes, w: Int|
    match acc { Some(_) -> acc, None -> if w == v { Some(k) } else { None } })

pub fn check_program_with(r: Resolved, mods: List<Mod>, known: Known) -> Checked = {
  let c0 = fresh_cx(r, mods, known);
  let declared: Cx = fold(r.order, c0, |c: Cx, i: Int| {
    let m = at(mods, i);
    let c1: Cx = {..c, module: i};
    check_value_namespace(collect_ctors(collect_effects(collect_types(c1, m), m), m), m)
  });
  let checked: Cx = fold(r.order, declared, |c: Cx, i: Int| { let m = at(mods, i); check_specs(check_fns({..c, module: i}, m), m) });
  let tested: Cx = fold(range(0, len(mods)), checked, |c: Cx, i: Int| check_laws(check_tests({..c, module: i}, at(mods, i)), at(mods, i)));
  // Whatever `check_fns` did not drain: a spec clause, a test body, a law.
  let settled: Cx = settle_bit_ops(settle_numerics(settle_concats(settle_updates(tested))));
  let constrained: Cx = check_constraints(check_map_keys(check_comparisons(check_label_apps(settled))));
  let solved: Cx = check_regions(check_simulations(attribute_generated(check_derives(constrained))));
  let marked: Cx = mark_internal_effects(solved);
  { cx: marked, ok: len(marked.diags) == 0 }
}

// --- The dump -----------------------------------------------------------------------------------------------

fn n(v: Int) -> Bytes = num(v)

fn footprint_text(atoms: List<Atom>) -> Bytes = atoms_text(atoms, b",")

fn join_with(xs: List<Bytes>, sep: Bytes) -> Bytes =
  fold(range(0, len(xs)), b"", |acc: Bytes, i: Int| if i == 0 { at(xs, i) } else { bytes_concat_all([acc, sep, at(xs, i)]) })

fn flag(b: Bool) -> Bytes = if b { b"1" } else { b"0" }

fn dump_def(d: DefInfo) -> Bytes =
  bytes_concat_all([b"F;", d.name, b";", scheme_text(d.scheme), b";", footprint_text(d.footprint), b";", footprint_text(d.performed), b";",
                    join_with(map(d.constraints, |c: DefConstraint| bytes_concat(deriver_text(c.deriver), n(c.param))), b","), b";",
                    flag(d.internally_effectful), b";"])

fn dump_op(o: OpInfo) -> Bytes =
  bytes_concat_all([o.name, b":", match o.mode { MRead -> b"read", MWrite -> b"write", MBad -> b"" }, b":", flag(o.resource_param), b":",
                    join_with(map(o.params, type_text), b"+"), b":", type_text(o.ret)])

fn dump_checked(c: Cx) -> Bytes =
  bytes_concat_all([
    bytes_concat_all(map(c.defs, dump_def)),
    bytes_concat_all(map(c.tests, |t: TestInfo| bytes_concat_all([b"T;", t.key, b";", flag(t.nondet), b";", footprint_text(t.footprint), b";"]))),
    bytes_concat_all(map(c.laws, |l: LawInfo| bytes_concat_all([b"L;", l.key, b";",
      join_with(map(l.binders, |b: LawBinder| bytes_concat_all([b.name, b":", type_text(b.ty)])), b","), b";",
      flag(l.has_guard), b";", flag(l.host), b";", footprint_text(l.footprint), b";"]))),
    bytes_concat_all(map(filter(c.effects, |e: EffectInfo| bytes_len(e.module) > 0), |e: EffectInfo|
      bytes_concat_all([b"E;", e.name, b";", flag(e.nondet), b";", join_with(map(e.ops, dump_op), b","), b";"]))),
    bytes_concat_all(map(filter(c.ctors, |k: CtorInfo| bytes_len(k.module) > 0), |k: CtorInfo|
      bytes_concat_all([b"C;", k.name, b";", k.type_name, b";", n(k.index), b";", n(k.arity), b";", scheme_text(k.scheme), b";"]))),
  ])

// Diagnostics that would render alike are one: the same code, labels and note count.
fn dedup_diags(ds: List<Diag>) -> List<Diag> =
  fold(ds, [], |acc: List<Diag>, d: Diag| if fold(acc, false, |b: Bool, x: Diag| b || x == d) { acc } else { push(acc, d) })

type Parsed = { name: Bytes, module: Module, derived: List<Derived>, diags: List<Diag> }

// The driver's order: parse with the rewrites, expand every `derive`, resolve, check. A reporting expansion stops there.
pub fn check_dump(sources: List<Source>) -> String = {
  let parsed = map(range(0, len(sources)), |i: Int| {
    let s = at(sources, i);
    let r = parse(s.src);
    let x = expand(r.node, r.p.uses_sets, r.p.diags);
    let d: Expansion = expand_derives(i, x.module);
    { name: s.name, module: d.module, derived: d.derived, diags: d.diags }
  });
  let expansion = fold(parsed, [], |acc: List<Diag>, p: Parsed| append(acc, p.diags));
  let mods = map(parsed, |p: Parsed| { name: p.name, module: p.module, derived: p.derived });
  let head = bytes_concat_all([b"K;", n(len(sources)), b";"]);
  let body = if len(expansion) > 0 { bytes_concat(b"X;", dump_diags(expansion)) } else {
    match resolve_modules(mods) {
      Failed(ds) -> bytes_concat(b"X;", dump_diags(ds)),
      Resolved_(x) -> dump_outcome(check_program(x.r, x.mods)),
    }
  };
  string_of_bytes(bytes_concat(head, body))
}

fn dump_outcome(out: Checked) -> Bytes =
  if out.ok { dump_checked(out.cx) } else { bytes_concat(b"X;", dump_diags(dedup_diags(out.cx.diags))) }

// What a checked program publishes, as the interfaces a second check of it would be handed.
fn known_of(cx: Cx) -> Known = {
  let defs = map(cx.defs, |d: DefInfo| { name: d.name, scheme: d.scheme, footprint: d.footprint, performed: d.performed });
  // Tests are in load order, then source order, so each `test` item takes the next entry.
  let walked = fold(cx.mods, { next: 0, tests: [] }, |acc: { next: Int, tests: List<KnownTests> }, m: Mod| {
    let slots = fold(m.module.items, { next: acc.next, slots: [] }, |a: { next: Int, slots: List<Option<List<Atom>>> }, it: Item|
      match it { ITest(_) -> { next: a.next + 1, slots: push(a.slots, Some(at(cx.tests, a.next).footprint)) }, _ -> a });
    { next: slots.next, tests: push(acc.tests, { module: m.name, slots: slots.slots }) }
  });
  { defs: defs, tests: walked.tests }
}

// The program checked twice, the second time from what the first published.
pub fn check_dump_known(sources: List<Source>) -> String = {
  let parsed = map(range(0, len(sources)), |i: Int| {
    let s = at(sources, i);
    let r = parse(s.src);
    let x = expand(r.node, r.p.uses_sets, r.p.diags);
    let d: Expansion = expand_derives(i, x.module);
    { name: s.name, module: d.module, derived: d.derived, diags: d.diags }
  });
  let expansion = fold(parsed, [], |acc: List<Diag>, p: Parsed| append(acc, p.diags));
  let mods = map(parsed, |p: Parsed| { name: p.name, module: p.module, derived: p.derived });
  let head = bytes_concat_all([b"K;", n(len(sources)), b";"]);
  let body = if len(expansion) > 0 { bytes_concat(b"X;", dump_diags(expansion)) } else {
    match resolve_modules(mods) {
      Failed(ds) -> bytes_concat(b"X;", dump_diags(ds)),
      Resolved_(x) -> {
        let first = check_program(x.r, x.mods);
        if !first.ok { dump_outcome(first) } else { dump_outcome(check_program_with(x.r, x.mods, known_of(first.cx))) }
      },
    }
  };
  string_of_bytes(bytes_concat(head, body))
}

// --- Tests ------------------------------------------------------------------

test "a definition's scheme is generalized and its footprint inferred" {
  let dump = check_dump([{ name: b"m", src: b"pub fn id<a>(x: a) -> a = x\nfn two() -> Int = id(2)\neffect log { write emit(Bytes) -> Unit }\nfn say(b: Bytes) -> Unit / { log.write } = log.emit(b)" }]);
  assert_eq(dump, "K;1;F;m.id;<a>(a) -> a;;;;0;F;m.two;() -> Int;;;;0;F;m.say;(Bytes) -> Unit / {m.log.write};m.log.write;m.log.emit;;1;E;m.log;0;emit:write:0:Bytes:Unit;")
}

test "a definition may be generic over a resource label, and a call fills it" {
  let dump = check_dump([{ name: b"m", src: b"effect net { write send[r](Bytes) -> Unit }\npub fn relay<[l]>(b: Bytes) -> Unit / {net.send[l]} = net.send[l](b)\npub fn go(b: Bytes) -> Unit / {net.send[conn]} = relay[conn](b)" }]);
  assert_eq(dump, "K;1;F;m.relay;<[l]>(Bytes) -> Unit / {m.net.send[l]};<[l]>m.net.send[l];<[l]>m.net.send[l];;1;"
            ++ "F;m.go;(Bytes) -> Unit / {m.net.send[conn]};m.net.send[conn];m.net.send[conn];;1;"
            ++ "E;m.net;0;send:write:1:Bytes:Unit;")
}

test "an argument's row fills a label the call does not write" {
  let dump = check_dump([{ name: b"m", src: b"effect net { write send[r](Bytes) -> Unit }\nfn relay<[l]>(f: () -> Unit / {net.send[l]}) -> Unit / {net.send[l]} = f()\nfn go(f: () -> Unit / {net.send[conn]}) -> Unit / {net.send[conn]} = relay(f)" }]);
  assert_eq(dump, "K;1;F;m.relay;<[l]>(() -> Unit / {m.net.send[l]}) -> Unit / {m.net.send[l]};<[l]>m.net.send[l];<[l]>m.net.send[l];;0;"
            ++ "F;m.go;(() -> Unit / {m.net.send[conn]}) -> Unit / {m.net.send[conn]};m.net.send[conn];m.net.send[conn];;0;"
            ++ "E;m.net;0;send:write:1:Bytes:Unit;")
}

test "a clause on a label parameter discharges what the generic body performs" {
  let dump = check_dump([{ name: b"m", src: b"effect net { write send[r](Bytes) -> Unit }\nfn relay<[l]>(b: Bytes) -> Unit / {net.send[l]} = net.send[l](b)\nfn quiet<[l]>(b: Bytes) -> Unit = handle relay[l](b) with { net.send[l](x) -> () }" }]);
  assert_eq(dump, "K;1;F;m.relay;<[l]>(Bytes) -> Unit / {m.net.send[l]};<[l]>m.net.send[l];<[l]>m.net.send[l];;1;"
            ++ "F;m.quiet;<[l]>(Bytes) -> Unit;;;;1;"
            ++ "E;m.net;0;send:write:1:Bytes:Unit;")
}

test "a label a call cannot fill, a count that does not match, and a use as a value" {
  let unfilled = check_dump([{ name: b"m", src: b"effect net { write send[r](Bytes) -> Unit }\nfn relay<[l]>(b: Bytes) -> Unit / {net.send[l]} = net.send[l](b)\nfn go(b: Bytes) -> Unit / {net.send[conn]} = relay(b)" }]);
  assert(string_contains(unfilled, "E0306"));
  let counted = check_dump([{ name: b"m", src: b"effect net { write send[r](Bytes) -> Unit }\nfn relay<[l]>(b: Bytes) -> Unit / {net.send[l]} = net.send[l](b)\nfn go(b: Bytes) -> Unit / {net.send[conn]} = relay[conn, other](b)" }]);
  assert(string_contains(counted, "E0306"));
  let valued = check_dump([{ name: b"m", src: b"effect net { write send[r](Bytes) -> Unit }\nfn relay<[l]>(b: Bytes) -> Unit / {net.send[l]} = net.send[l](b)\nfn go() -> (Bytes) -> Unit / {net.send[conn]} = relay" }]);
  assert(string_contains(valued, "E0306"));
  let plain = check_dump([{ name: b"m", src: b"fn id(x: Int) -> Int = x\nfn go(n: Int) -> Int = id[conn](n)" }]);
  assert(string_contains(plain, "E0306"))
}

test "two label parameters stay apart, and each names its own atom" {
  let dump = check_dump([{ name: b"m", src: b"effect net { write send[r](Bytes) -> Unit }\nfn pipe<[l, k]>(b: Bytes) -> Unit / {net.send[l], net.send[k]} = { net.send[l](b); net.send[k](b) }" }]);
  assert_eq(dump, "K;1;F;m.pipe;<[l], [m]>(Bytes) -> Unit / {m.net.send[l], m.net.send[m]};<[l],[m]>m.net.send[l],m.net.send[m];<[l],[m]>m.net.send[l],m.net.send[m];;1;"
            ++ "E;m.net;0;send:write:1:Bytes:Unit;")
}

// The group's binders are positional, so `pong` takes `ping`'s first, whatever it calls it.
test "mutually recursive definitions are checked with one set of label binders" {
  let src = bytes_concat_all([b"effect net { write send[r](Bytes) -> Unit }\n",
    b"fn ping<[l]>(n: Int, b: Bytes) -> Unit / {net.send[l]} = if n == 0 { net.send[l](b) } else { pong(n - 1, b) }\n",
    b"fn pong<[k]>(n: Int, b: Bytes) -> Unit / {net.send[k]} = ping(n - 1, b)\n",
    b"fn go(b: Bytes) -> Unit / {net.send[conn]} = ping[conn](2, b)"]);
  let dump = check_dump([{ name: b"m", src: src }]);
  assert(string_contains(dump, "F;m.ping;<[l]>(Int, Bytes) -> Unit / {m.net.send[l]};<[l]>m.net.send[l];"));
  assert(string_contains(dump, "F;m.pong;<[l]>(Int, Bytes) -> Unit / {m.net.send[l]};<[l]>m.net.send[l];"));
  assert(string_contains(dump, "F;m.go;(Bytes) -> Unit / {m.net.send[conn]};m.net.send[conn];"))
}

test "a call inside a recursive group writes no labels, or the caller's own binders" {
  let pair = |call: Bytes| bytes_concat_all([b"effect net { write send[r](Bytes) -> Unit }\n",
    b"fn ping<[l]>(n: Int, b: Bytes) -> Unit / {net.send[l]} = if n == 0 { net.send[l](b) } else { ", call, b" }\n",
    b"fn pong<[l]>(n: Int, b: Bytes) -> Unit / {net.send[l]} = ping(n - 1, b)"]);
  assert_eq(check_codes(pair(b"pong(n - 1, b)")), []);
  assert_eq(check_codes(pair(b"pong[l](n - 1, b)")), []);
  assert_eq(check_codes(pair(b"pong[conn](n - 1, b)")), [b"E0306"]);
  let diags = check_diags(pair(b"pong[conn](n - 1, b)"));
  assert_eq(map(diags, |dg: Diag| dg.message),
            [b"a call to `pong` inside its own recursive group keeps the labels the group was called with"]);
  assert_eq(map(diags, |dg: Diag| dg.notes_text),
            [[b"write `pong(..)`, or name this definition's own binders in order, as `pong[l](..)`"]]);
  // A self call is the same rule: its own binder, or nothing.
  let alone = |call: Bytes| bytes_concat_all([b"effect net { write send[r](Bytes) -> Unit }\n",
    b"fn walk<[l]>(n: Int, b: Bytes) -> Unit / {net.send[l]} = if n == 0 { net.send[l](b) } else { ", call, b" }"]);
  assert_eq(check_codes(alone(b"walk(n - 1, b)")), []);
  assert_eq(check_codes(alone(b"walk[l](n - 1, b)")), []);
  assert_eq(check_codes(alone(b"walk[conn](n - 1, b)")), [b"E0306"])
}

test "the members of a recursive group bind the same label parameters" {
  let group = |first: Bytes, second: Bytes| bytes_concat_all([b"effect net { write send[r](Bytes) -> Unit }\n",
    b"fn ping", first, b"(n: Int, b: Bytes) -> Unit / {net.send[l]} = if n == 0 { net.send[l](b) } else { pong(n - 1, b) }\n",
    b"fn pong", second, b"(n: Int, b: Bytes) -> Unit / {net.send[l]} = ping(n - 1, b)"]);
  assert_eq(check_codes(group(b"<[l]>", b"<[l]>")), []);
  assert(contains_bytes(check_codes(group(b"<[l]>", b"")), b"E0307"));
  assert(contains_bytes(check_codes(group(b"<[l]>", b"<[l, k]>")), b"E0307"));
  assert(contains_bytes(check_codes(group(b"", b"<[l]>")), b"E0307"));
  let diags = check_diags(group(b"<[l]>", b""));
  assert_eq(at(map(diags, |dg: Diag| dg.message), 0),
            b"`pong` and `ping` are mutually recursive, so they are checked with one set of label parameters");
  assert_eq(map(at(diags, 0).labels, |l: Label| l.text), [b"binds no label parameters", b"binds 1 label parameter"])
}

test "a unit pattern covers its type" {
  assert_eq(check_dump([{ name: b"m", src: b"fn f(u: Unit) -> Int = match u { () -> 1 }" }]), "K;1;F;m.f;(Unit) -> Int;;;;0;")
}

// A one-module program's diagnostics, in order; empty when it checks.
fn check_diags(src: Bytes) -> List<Diag> = {
  let r = parse(src);
  let x = expand(r.node, r.p.uses_sets, r.p.diags);
  let d: Expansion = expand_derives(0, x.module);
  match resolve_modules([{ name: b"m", module: d.module, derived: d.derived }]) {
    Failed(ds) -> ds,
    Resolved_(y) -> dedup_diags(check_program(y.r, y.mods).cx.diags),
  }
}

fn check_codes(src: Bytes) -> List<Bytes> = map(check_diags(src), |dg: Diag| dg.code)

fn fixes_of(diags: List<Diag>) -> List<Fix> = fold(diags, [], |acc: List<Fix>, dg: Diag| append(acc, dg.fixes))

fn net_src(rest: Bytes) -> Bytes =
  bytes_concat(b"effect net { write send[s](payload: Bytes) -> Unit\n write recv[s](max: Int) -> Bytes\n write close[s]() -> Unit\n read peek[s]() -> Int }\n", rest)

test "a handle must have a clause for every operation its body performs on an atom it handles" {
  assert_eq(check_codes(net_src(b"fn f() -> Bytes = handle { net.send[c](b\"x\"); net.recv[c](4) } with { net.recv[c](n) -> b\"\" }")), [b"E0305"]);
  assert_eq(check_codes(net_src(b"fn f() -> Bytes = handle { net.send[c](b\"x\"); net.recv[c](4) } with { net.recv[c](n) -> b\"\", net.send[c](p) -> () }")), []);
  assert_eq(check_codes(net_src(b"fn f() -> Int / {net.write[c]} = handle { net.send[c](b\"x\"); net.peek[c]() } with { net.peek[c]() -> 1 }")), [])
}

test "the operations a called definition performs count, through any number of calls" {
  let calls = b"fn push_all(p: Bytes) -> Unit = net.send[c](p)\nfn relay(p: Bytes) -> Unit = push_all(p)\n";
  assert_eq(check_codes(net_src(bytes_concat(calls, b"fn f() -> Unit = handle { relay(b\"x\") } with { net.recv[c](n) -> b\"\" }"))), [b"E0305"]);
  assert_eq(check_codes(net_src(bytes_concat(calls, b"fn f() -> Unit = handle { relay(b\"x\") } with { net.send[c](p) -> () }"))), []);
  assert_eq(check_codes(net_src(bytes_concat(calls, b"fn g() -> Unit / {net.send[c]} = relay(b\"y\")\nfn f() -> Unit = handle { g() } with { net.close[c]() -> () }"))), [b"E0305"]);
  let diags = check_diags(net_src(bytes_concat(calls, b"fn f() -> Unit = handle { relay(b\"x\") } with { net.recv[c](n) -> b\"\" }")));
  assert_eq(map(diags, |dg: Diag| map(dg.labels, |l: Label| l.text)),
            [[b"reaches `net.send[c]` through `relay`", b"handles `m.net.write[c]` here, so the operation would run past it"]])
}

test "an operation a definition handles itself does not reach its callers' handles" {
  let src = net_src(b"fn quiet() -> Unit / {net.close[c]} = { handle { net.send[c](b\"x\") } with { net.send[c](p) -> () }; net.close[c]() }\nfn f() -> Unit = handle { quiet() } with { net.close[c]() -> () }");
  assert_eq(check_codes(src), [])
}

test "a handle over a function value or a lambda is judged by its type" {
  let all = b"net.send[c](p) -> (), net.recv[c](n) -> b\"\", net.close[c]() -> ()";
  assert_eq(check_codes(net_src(b"fn run(f: () -> Unit / {net.write[c]}) -> Unit = handle { f() } with { net.recv[c](n) -> b\"\" }")), [b"E0305"]);
  assert_eq(check_codes(net_src(bytes_concat_all([b"fn run(f: () -> Unit / {net.write[c]}) -> Unit = handle { f() } with { ", all, b" }"]))), []);
  assert_eq(check_codes(net_src(b"fn run(f: () -> Unit / {net.send[c]}) -> Unit = handle { f() } with { net.send[c](p) -> () }")), []);
  let folded = b"fn f() -> Int = handle { fold([1, 2], 0, |acc: Int, x: Int| { net.send[c](b\"x\"); acc + x }) } with { ";
  assert_eq(check_codes(net_src(bytes_concat(folded, b"net.recv[c](n) -> b\"\" }"))), [b"E0305"]);
  assert_eq(check_codes(net_src(bytes_concat(folded, b"net.send[c](p) -> () }"))), []);
  let diags = check_diags(net_src(bytes_concat(folded, b"net.recv[c](n) -> b\"\" }")));
  assert_eq(map(diags, |dg: Diag| dg.message), [b"this `handle` has no clause for `net.send[c]`, which its body performs"]);
  assert_eq(map(diags, |dg: Diag| at(dg.labels, 0).text), [b"performs `net.send[c]`"])
}

test "a callee written with a mode atom may perform any of its operations, so every one needs a clause" {
  let calls = b"fn relay(p: Bytes) -> Unit / {net.write[c]} = net.send[c](p)\n";
  let diags = check_diags(net_src(bytes_concat(calls, b"fn f() -> Unit = handle { relay(b\"x\") } with { net.send[c](p) -> () }")));
  assert_eq(map(diags, |dg: Diag| dg.code), [b"E0305"]);
  assert_eq(map(diags, |dg: Diag| dg.message), [b"this `handle` has no clause for `net.write[c]`, which its body performs"]);
  assert_eq(map(diags, |dg: Diag| at(dg.labels, 0).text), [b"reaches `net.write[c]` through `relay`"]);
  assert_eq(map(diags, |dg: Diag| dg.notes_text),
            [[b"`relay` may perform any `write` operation of `net`; a clause for each of them discharges `net.write[c]`"]]);
  assert_eq(map(fixes_of(diags), |f: Fix| f.title), [b"add a clause for `net.recv[c]`", b"add a clause for `net.close[c]`"]);
  assert_eq(check_codes(net_src(bytes_concat(calls, b"fn f() -> Unit = handle { relay(b\"x\") } with { net.send[c](p) -> (), net.recv[c](n) -> b\"\", net.close[c]() -> () }"))), []);
  assert_eq(check_codes(net_src(bytes_concat(calls, b"fn f() -> Unit / {net.write[c]} = handle { relay(b\"x\") } with { net.send[c](p) -> () }"))), []);
  assert_eq(check_codes(net_src(bytes_concat(calls, b"fn f() -> Int = handle { relay(b\"x\"); 1 } with { net.peek[c]() -> 1 }"))), [])
}

test "an operation the written row keeps is forwarded rather than missing" {
  assert_eq(check_codes(net_src(b"fn f() -> Unit / {net.write[c]} = handle { net.send[c](b\"x\"); net.close[c]() } with { net.send[c](p) -> () }")), []);
  assert_eq(check_codes(net_src(b"fn f() -> Unit / {net.read[c]} = handle { net.send[c](b\"x\"); net.close[c]() } with { net.send[c](p) -> () }")), [b"E0305"])
}

test "the missing clause is named as the module would write it" {
  let src = net_src(b"fn f() -> Unit = handle { net.send[c](b\"x\"); net.close[c]() } with { net.recv[c](n) -> b\"\" }");
  let diags = check_diags(src);
  assert_eq(map(diags, |dg: Diag| dg.message), [b"this `handle` has no clause for `net.close[c]` and `net.send[c]`, which its body performs"]);
  let fixes = fixes_of(diags);
  assert_eq(map(fixes, |f: Fix| f.title), [b"add a clause for `net.close[c]`", b"add a clause for `net.send[c]`"]);
  assert_eq(map(fixes, |f: Fix| map(f.edits, |e: Edit| e.text)),
            [[b", net.close[c]() -> panic(\"net.close[c] is not handled here\")"], [b", net.send[c](a0) -> panic(\"net.send[c] is not handled here\")"]]);
  assert_eq(map(fixes, |f: Fix| map(f.edits, |e: Edit| bytes_slice(src, e.start - 1, e.end))), [[b"\""], [b"\""]])
}

test "a written row may name an operation, which permits that operation alone" {
  assert_eq(check_codes(net_src(b"fn f() -> Unit / {net.send[c]} = net.send[c](b\"x\")")), []);
  assert_eq(check_codes(net_src(b"fn f() -> Bytes / {net.send[c]} = net.recv[c](4)")), [b"E0302"]);
  assert_eq(check_codes(net_src(b"fn f() -> Bytes / {net.write[c]} = { net.send[c](b\"x\"); net.recv[c](4) }")), []);
  assert_eq(check_codes(net_src(b"fn f() -> Int / {net.peek[c]} = net.peek[c]()")), []);
  assert_eq(check_codes(net_src(b"fn f() -> Unit / {net.emit[c]} = ()")), [b"E0104"])
}

test "an operation the written row does not name is refused by name, with the atom to add" {
  let src = net_src(b"fn f() -> Bytes / {net.send[c]} = net.recv[c](4)");
  let diags = check_diags(src);
  assert_eq(map(diags, |dg: Diag| dg.message), [b"effect not permitted by the signature of `f`: `m.net.recv[c]`"]);
  assert_eq(map(diags, |dg: Diag| map(dg.labels, |l: Label| l.text)), [[b"performs `m.net.recv[c]`", b"declared row is {m.net.send[c]}"]]);
  let fixes = fixes_of(diags);
  assert_eq(map(fixes, |f: Fix| f.title), [b"add `net.recv[c]` to the row"]);
  assert_eq(map(fixes, |f: Fix| map(f.edits, |e: Edit| e.text)), [[b", net.recv[c]"]]);
  assert_eq(map(fixes, |f: Fix| map(f.edits, |e: Edit| bytes_slice(src, e.start, e.end + 1))), [[b"}"]])
}

test "a caller's mode atom covers a callee's operation atom, and not the reverse" {
  let narrow = b"fn f() -> Unit / {net.send[c]} = net.send[c](b\"x\")\n";
  let wide = b"fn f() -> Unit / {net.write[c]} = net.send[c](b\"x\")\n";
  assert_eq(check_codes(net_src(bytes_concat(narrow, b"fn g() -> Unit / {net.write[c]} = f()"))), []);
  assert_eq(check_codes(net_src(bytes_concat(narrow, b"fn g() -> Unit / {net.send[c]} = f()"))), []);
  assert_eq(check_codes(net_src(bytes_concat(narrow, b"fn g() -> Unit = f()\nfn h() -> Unit / {net.write[c]} = g()"))), []);
  let diags = check_diags(net_src(bytes_concat(wide, b"fn g() -> Unit / {net.send[c]} = f()")));
  assert_eq(map(diags, |dg: Diag| dg.code), [b"E0302"]);
  assert_eq(map(diags, |dg: Diag| map(dg.labels, |l: Label| l.text)),
            [[b"reaches `m.net.write[c]` through `f`, which may perform any of its operations; this row names only `m.net.send[c]`",
              b"declared row is {m.net.send[c]}"]]);
  assert_eq(map(fixes_of(diags), |f: Fix| f.title), [b"add `net.write[c]` to the row"])
}

test "a clause for an operation discharges that operation's atom" {
  let narrow = b"fn f() -> Unit / {net.send[c]} = net.send[c](b\"x\")\n";
  assert_eq(check_codes(net_src(bytes_concat(narrow, b"fn g() -> Unit / {} = handle { f() } with { net.send[c](p) -> () }"))), []);
  assert_eq(check_codes(net_src(bytes_concat(narrow, b"fn g() -> Unit / {} = handle { f() } with { net.recv[c](n) -> b\"\" }"))), [b"E0305"]);
  assert_eq(check_codes(net_src(b"fn f() -> Unit / {net.send[c]} = handle { net.send[c](b\"x\"); net.close[c]() } with { net.close[c]() -> () }")), []);
  assert_eq(check_codes(net_src(b"fn f() -> Unit / {net.close[c]} = handle { net.send[c](b\"x\"); net.close[c]() } with { net.close[c]() -> () }")), [b"E0305"])
}

test "a body that performs more than its signature permits is refused" {
  let dump = check_dump([{ name: b"m", src: b"effect log { write emit(Bytes) -> Unit }\nfn quiet() -> Unit / {} = log.emit(b\"x\")" }]);
  assert_eq(dump, "K;1;X;D;1;!E0302:0:67:81:2:1;=0:67:81:1;=0:62:64:0;")
}

test "a program checked from its own published interfaces publishes the same thing" {
  let src = [{ name: b"m", src: b"pub fn id<a>(x: a) -> a = x\nfn two() -> Int = id(2)\neffect log { write emit(Bytes) -> Unit }\nfn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\nfn show<a>(x: a) -> Int where derivable(eq, a) = 1\ntest \"says\" { say(b\"x\") }" }];
  assert_eq(check_dump_known(src), check_dump(src))
}

test "a spec clause that reaches an effect through a call is refused at the call" {
  let dump = check_dump([{ name: b"m", src: b"effect log { write emit(Bytes) -> Unit }\nfn noisy() -> Bool / { log.write } = { log.emit(b\"x\"); true }\nfn f(x: Int) -> Int requires noisy() = x" }]);
  assert_eq(dump, "K;1;X;D;1;!E0417:0:132:139:2:3;=0:132:139:1;=0:123:139:0;")
}

test "functions cannot be compared and a Float cannot key a Map, judged once the module is solved" {
  let dump = check_dump([{ name: b"m", src: b"fn keyed() -> Map<Float, Int> = map_new()\nfn same(f: (Int) -> Int, g: (Int) -> Int) -> Bool = f == g" }]);
  assert_eq(dump, "K;1;X;D;2;!E0201:0:94:100:1:1;=0:94:100:1;!E0206:0:14:29:1:2;=0:14:29:1;")
}

test "a cell leaving its region is reported at the exit, under the code its form has always used" {
  let dump = check_dump([{ name: b"m", src: b"fn escape() -> Int = { let k = with_cell[r](1) { c -> c }; 0 }\nfn leak() -> Int = { let k = with_region[r] { with_cell[r](1) { c -> c } }; 0 }" }]);
  assert_eq(dump, "K;1;X;D;2;!E0201:0:54:55:1:1;=0:54:55:1;!E0446:0:132:133:2:1;=0:132:133:1;=0:104:105:0;")
}

test "a call instantiating a constrained parameter with a function is refused at the call" {
  let dump = check_dump([{ name: b"m", src: b"fn show<a>(x: a) -> String where derivable(json, a) = \"\"\nfn bad() -> String = show(|y: Int| y)" }]);
  assert_eq(dump, "K;1;X;D;1;!E0206:0:78:82:2:1;=0:78:82:1;=0:0:56:0;")
}

// The code of each error a program raises, in the order the checker reports them.
fn check_codes(sources: List<Source>) -> List<Bytes> = {
  let parsed = map(range(0, len(sources)), |i: Int| {
    let s = at(sources, i);
    let r = parse(s.src);
    let x = expand(r.node, r.p.uses_sets, r.p.diags);
    let d: Expansion = expand_derives(i, x.module);
    { name: s.name, module: d.module, derived: d.derived, diags: d.diags }
  });
  let early = fold(parsed, [], |acc: List<Diag>, p: Parsed| append(acc, p.diags));
  if len(early) > 0 { map(early, |g: Diag| g.code) } else {
    match resolve_modules(map(parsed, |p: Parsed| { name: p.name, module: p.module, derived: p.derived })) {
      Failed(ds) -> map(ds, |g: Diag| g.code),
      Resolved_(x) ->
        map(filter(dedup_diags(check_program(x.r, x.mods).cx.diags), |g: Diag| g.severity == b"error"), |g: Diag| g.code),
    }
  }
}

test "a record update takes its shape from the base's inferred type, not from where it was written" {
  let p = b"type P = { a: Int, b: Int }\nfn mk() -> P = { a: 1, b: 2 }\n";
  assert_eq(check_codes([{ name: b"m", src: bytes_concat(p, b"fn f() -> P = { let q = mk(); {..q, b: 3} }") }]), []);
  assert_eq(check_codes([{ name: b"m", src: bytes_concat(p, b"fn g(ps: List<P>) -> P = match list_at(ps, 0) { Some(q) -> {..q, b: 3}, None -> mk() }") }]), []);
  assert_eq(check_codes([{ name: b"m", src: bytes_concat(p, b"fn h(xs: List<Int>) -> P = fold(xs, mk(), |acc, x| {..acc, a: x})") }]), [])
}

test "a record update may name a record type another module declares" {
  assert_eq(check_codes([{ name: b"shapes", src: b"pub type P = { a: Int, b: Int }\npub fn mk() -> P = { a: 1, b: 2 }" },
                         { name: b"m", src: b"import shapes\nfn f() -> shapes::P = { let q = shapes::mk(); {..q, b: 3} }" }]), [])
}

test "a record update is refused where the base is not a record, or where nothing says what it is" {
  let p = b"type P = { a: Int, b: Int }\n";
  assert_eq(check_codes([{ name: b"m", src: bytes_concat(p, b"fn f(n: Int) -> Int = { let q = {..n, a: 1}; 0 }") }]), [b"E0116"]);
  assert_eq(check_codes([{ name: b"m", src: bytes_concat(p, b"fn f() -> Int = { let g = |s| {..s, a: 1}; 0 }") }]), [b"E0116"]);
  assert_eq(check_codes([{ name: b"m", src: bytes_concat(p, b"fn f(q: P) -> P = {..q, c: 1}") }]), [b"E0117"])
}

test "`++` joins two Strings or two Bytes, and refuses one of each" {
  assert_eq(check_codes([{ name: b"m", src: b"fn f(a: String, b: String) -> String = a ++ b" }]), []);
  assert_eq(check_codes([{ name: b"m", src: b"fn f(a: Bytes, b: Bytes) -> Bytes = a ++ b" }]), []);
  assert_eq(check_codes([{ name: b"m", src: b"fn f(xs: List<Bytes>) -> Bytes = fold(xs, b\"\", |acc: Bytes, x: Bytes| acc ++ x)" }]), []);
  assert_eq(check_codes([{ name: b"m", src: b"fn f(a: String, b: Bytes) -> String = a ++ b" }]), [b"E0201"]);
  assert_eq(check_codes([{ name: b"m", src: b"fn f(a: Int, b: Int) -> Int = a ++ b" }]), [b"E0201"]);
  assert_eq(check_codes([{ name: b"m", src: b"fn f() -> Int = { let g = |a, b| a ++ b; 0 }" }]), [b"E0210"])
}

// The label of each `E0205` a one-module program raises.
fn not_covered(src: Bytes) -> List<Bytes> = {
  let r = parse(src);
  let x = expand(r.node, r.p.uses_sets, r.p.diags);
  let d: Expansion = expand_derives(0, x.module);
  match resolve_modules([{ name: b"m", module: d.module, derived: d.derived }]) {
    Failed(_) -> [b"does not resolve"],
    Resolved_(ok) -> map(filter(check_program(ok.r, ok.mods).cx.diags, |g: Diag| g.code == b"E0205"), |g: Diag| at(g.labels, 0).text),
  }
}

test "a match is exhaustive through nested constructors, and names the inner case it misses" {
  let t = b"type T = | A | B\n";
  assert_eq(not_covered(bytes_concat(t, b"fn f(o: Option<T>) -> Int = match o { Some(A) -> 1, Some(B) -> 2, None -> 3 }")), []);
  assert_eq(not_covered(bytes_concat(t, b"fn f(o: Option<T>) -> Int = match o { Some(A) -> 1, None -> 3 }")), [b"not covered: `Some(B)`"]);
  assert_eq(not_covered(bytes_concat(t, b"fn f(r: Result<Option<T>, T>) -> Int = match r { Ok(Some(A)) -> 1, Ok(None) -> 2, Err(_) -> 3 }")),
            [b"not covered: `Ok(Some(B))`"]);
  assert_eq(not_covered(bytes_concat(t, b"fn f(r: Result<T, T>) -> Int = match r { Ok(A) -> 1 }")),
            [b"not covered: `Ok(B)`, `Err(_)`"])
}

test "a guarded arm covers nothing, and a constructor that does not resolve covers nothing" {
  let t = b"type T = | A | B\n";
  assert_eq(not_covered(bytes_concat(t, b"fn f(o: Option<T>, n: Int) -> Int = match o { Some(A) if n > 0 -> 1, Some(B) -> 2, None -> 3 }")),
            [b"not covered: `Some(A)`"]);
  assert_eq(not_covered(bytes_concat(t, b"fn f(o: Option<T>, n: Int) -> Int = match o { Some(A) if n > 0 -> 1, Some(_) -> 2, None -> 3 }")), []);
  assert_eq(not_covered(bytes_concat(t, b"fn f(o: Option<T>) -> Int = match o { Some(C) -> 1, None -> 3 }")), [b"not covered: `Some(_)`"])
}

test "booleans are exhausted by both literals, a unit by its one, and other literals never" {
  assert_eq(not_covered(b"fn f(p: (Bool, Bool)) -> Int = match p { (true, _) -> 1, (_, true) -> 2, (false, false) -> 3 }"), []);
  assert_eq(not_covered(b"fn f(p: (Bool, Bool)) -> Int = match p { (true, _) -> 1, (false, true) -> 2 }"), [b"not covered: `(false, false)`"]);
  assert_eq(not_covered(b"fn f(u: Unit) -> Int = match u { () -> 1 }"), []);
  assert_eq(not_covered(b"fn f(n: Int) -> Int = match n { 0 -> 1, 1 -> 2 }"), [b"not covered: `_`"]);
  assert_eq(not_covered(b"fn f(o: Option<Int>) -> Int = match o { Some(0) -> 1, None -> 2 }"), [b"not covered: `Some(_)`"])
}

test "list patterns are exhausted by exact lengths and prefixes, element patterns included" {
  assert_eq(not_covered(b"fn f(xs: List<Int>) -> Int = match xs { [] -> 0, [x] -> x, [x, y, ..rest] -> x + y }"), []);
  assert_eq(not_covered(b"fn f(xs: List<Int>) -> Int = match xs { [] -> 0, [x, y, ..rest] -> x + y }"), [b"not covered: `[_]`"]);
  assert_eq(not_covered(b"fn f(xs: List<Int>) -> Int = match xs { [x, ..rest] -> x }"), [b"not covered: `[]`"]);
  assert_eq(not_covered(b"fn f(xs: List<Option<Int>>) -> Int = match xs { [] -> 0, [None, ..] -> 1, [Some(x), ..rest] -> x }"), []);
  assert_eq(not_covered(b"fn f(xs: List<Option<Int>>) -> Int = match xs { [] -> 0, [Some(x), ..rest] -> x }"), [b"not covered: `[None, ..]`"])
}

test "record patterns are exhausted field by field" {
  let t = b"type T = | A | B\n";
  assert_eq(not_covered(bytes_concat(t, b"fn f(p: { t: T, n: Int }) -> Int = match p { {t: A, n} -> n, {t: B, ..} -> 0 }")), []);
  assert_eq(not_covered(bytes_concat(t, b"fn f(p: { t: T, n: Int }) -> Int = match p { {t: A, n} -> n }")), [b"not covered: `{t: B, ..}`"])
}
