//! A program read from a directory, checked and emitted: what a program that drives another hands
//! the machine, which compiles the C it is handed and loads no source of its own, and what the
//! builder makes a program the launcher ships from. Its modules are the `.ply` files below the
//! root, named by their paths; a `ply.pkg` there names the packages it depends on, each read from
//! the directory its manifest names; what a module embeds is read beside it; the shipped modules
//! they import are the binary's own shipped modules.

import front (Dump, EmitterRoot, Embedded, AnalysisOutcome, Analysed, Refused, Rows, Shipping,
              ShippedView, analyse_pulling_std_with, checked_staged, dump_of, embeds_wanted,
              module_of, pulls_of, shipped_pulled, staged_pulling_std_with, viewed_text,
              ModuleFacts, answered_load, view_dump)
import embed (EmbedAt, EmbedRead, EmbedFile)
import hash (HashOutput, Fixing, no_fixing, hex)
import interface (imported)
import memo (Query, Run, memo, memo_keep)
import memo_files
import checking (Answered, OwnPackage, World, asked_all, entry_hash, evaluator_of, hashed_all,
                 identity_of, looked, packages_refused, queries, refused_first, registry,
                 root_warnings, world_of)
import pkg (PackageSources, Supplied, closure, git_spec, wants)
import resolve (Source, Diag, Label, error_at)
import unit (Runtime, shipped, compiled)
import std.hash (blake3)
import std.fs
import std.fs (fs, File, Dir, Missing, Symlink)
import std.path (is_absolute, join, normalize, parent)
import std.list (at, concat, contains)
import parsing (no_module)

/// One source a front end's answer names: where it was read, the module it is, and its text.
pub type SourceFile = { path: String, name: String, text: Bytes }

/// What a machine is handed for a program: the front end's answer, every source its ids run over in
/// that order, and what its load cost.
pub type LoadedAnalysis = {
  dump: Dump,
  files: List<SourceFile>,
  read_ms: Int,
  front_ms: Int,
  file_ms: Int,
  cached: Bool,
}

/// A program a machine can load: its front end's answer and the C of its unit.
pub type Loaded = { front: LoadedAnalysis, unit: Bytes }

/// A program's front end, and the hashing it published, which says what each definition reaches.
pub type Checked = { front: LoadedAnalysis, hashes: HashOutput }

/// Why a program did not load, with every source its diagnostics' module indices run over, as far as
/// the load got.
pub type Unloaded = { diags: List<Diag>, files: List<SourceFile> }

fn unloaded(diags: List<Diag>) -> Unloaded = { diags: diags, files: [] }

/// A directory a walk does not enter: a hidden one holds caches and VCS metadata, and `target`
/// build output.
pub fn skipped(name: String) -> Bool = string_starts_with(name, ".") || name == "target"

fn joined(dir: String, name: String) -> String =
  if dir == "" || dir == "." { name } else if name == "" { dir } else { dir ++ "/" ++ name }

fn nowhere(message: String) -> Diag =
  error_at(
    b"E0502",
    no_module(),
    { start: 0, end: 0 },
    bytes_of_string(message),
    b"nothing to load",
    [],
  )

// --- Reading -------------------------------------------------------------------

/// How many directories deep a walk goes: a path the system opens is at most 4096 bytes, and each
/// level adds at least two, so a deeper directory could not be listed anyway.
fn walk_room() -> Int = 2048

/// Every `.ply` file below `dir`, by its path below it: keyed, so a walk reads them in path order as
/// `ply` reads a project. A symlink is not followed.
fn below<[r]>(
  dir: String,
  under: String,
  found: Map<String, Bool>,
  room: Int,
) -> Map<String, Bool> / {fs.list_dir[r], fs.kind[r]} =
  match fs.list_dir[r](joined(dir, under)) {
    None -> found,
    Some(names) ->
      fold(names, found, |acc: Map<String, Bool>, name: String| {
        let path = joined(under, name);
        match fs.kind[r](joined(dir, path)) {
          Dir -> if skipped(name) || room <= 0 { acc } else { below[r](dir, path, acc, room - 1) },
          File -> if string_ends_with(name, ".ply") { map_insert(acc, path, true) } else { acc },
          _ -> acc,
        }
      }),
  }

/// One package as it lies below its root: its manifest when it holds one, and its modules, each
/// named by its path below the root.
pub type Package = { root: String, manifest: Option<Bytes>, files: List<SourceFile> }

fn package_at<[r]>(
  root: String,
) -> Result<Package, List<Diag>> / {fs.list_dir[r], fs.kind[r], fs.read_file[r], abort.raise} = {
  let read = fold(
    map_keys(below[r](root, "", map_new(), walk_room())),
    Ok([]),
    |acc: Result<List<SourceFile>, List<Diag>>, p: String|
      match acc {
        Err(e) -> Err(e),
        Ok(done) -> match module_of(p) {
          Err(why) -> Err([nowhere("`" ++ joined(root, p) ++ "` cannot be a module: " ++ why)]),
          Ok(name) -> match fs.read_file[r](joined(root, p)) {
            None -> Err([nowhere("could not read `" ++ joined(root, p) ++ "`")]),
            Some(text) -> Ok(push(done, { path: joined(root, p), name: name, text: text })),
          },
        },
      },
  );
  match read {
    Err(diags) -> Err(diags),
    Ok(files) ->
      Ok({ root: root, manifest: fs.read_file[r](joined(root, "ply.pkg")), files: files }),
  }
}

fn sources_of(files: List<SourceFile>) -> List<Source> =
  map(files, |f: SourceFile| { name: bytes_of_string(f.name), src: f.text })

fn supplied_of(package: Package) -> Supplied =
  {
    root: bytes_of_string(package.root),
    manifest: package.manifest,
    modules: sources_of(package.files),
  }

fn unfetched(key: Bytes) -> Diag =
  nowhere(
    "`" ++ string_of_bytes_lossy(key)
      ++ "` is a git dependency, which `ply` fetches; a program's own load reads path dependencies",
  )

/// Every package the root's manifest reaches, round by round as `wants` names them, in the order
/// they were read: what the front end judges the graph from.
fn packages_of<[r]>(
  root: Package,
) -> Result<List<Package>, List<Diag>> / {fs.list_dir[r], fs.kind[r], fs.read_file[r], abort.raise} =
  iterate(Ok([]), 4096, |acc: Result<List<Package>, List<Diag>>|
    match acc {
      Err(e) -> Stop(Err(e)),
      Ok(read) -> {
        let known = map(push(read, root), |p: Package| bytes_of_string(p.root));
        match wants(known, map(concat([root], read), supplied_of)) {
          [] -> Stop(Ok(read)),
          next ->
            Continue(
              fold(next, Ok(read), |got: Result<List<Package>, List<Diag>>, key: Bytes|
                match got {
                  Err(e) -> Err(e),
                  Ok(so_far) -> match git_spec(key) {
                    Some(_) -> Err([unfetched(key)]),
                    None -> match package_at[r](string_of_bytes(key)) {
                      Err(e) -> Err(e),
                      Ok(p) -> Ok(push(so_far, p)),
                    },
                  },
                }),
            ),
        }
      },
    })

/// A path an embed names, relative to the directory of the module's own file.
fn embed_target(file: String, path: String) -> String = normalize(join(parent(file), path))

fn unread(target: String, what: String) -> EmbedRead =
  Err(bytes_of_string("`" ++ target ++ "` " ++ what))

/// Every file under `dir`, by its path below it and in that order; nothing under a name starting
/// with `.` is read.
fn listed<[r]>(
  dir: String,
  under: String,
  found: Map<String, String>,
  room: Int,
) -> Result<Map<String, String>, Bytes> / {fs.list_dir[r], fs.kind[r]} =
  match fs.list_dir[r](joined(dir, under)) {
    None -> Err(bytes_of_string("`" ++ joined(dir, under) ++ "` could not be listed")),
    Some(names) ->
      fold(names, Ok(found), |acc: Result<Map<String, String>, Bytes>, n: String|
        match acc {
          Err(_) -> acc,
          Ok(m) -> if string_starts_with(n, ".") { acc } else {
            let path = joined(under, n);
            match fs.kind[r](joined(dir, path)) {
              Dir -> if room <= 0 {
                Err(bytes_of_string("`" ++ joined(dir, path) ++ "` is deeper than a path can name"))
              } else { listed[r](dir, path, m, room - 1) },
              _ -> Ok(map_insert(m, path, joined(dir, path))),
            }
          },
        }),
  }

fn read_dir<[r]>(dir: String) -> EmbedRead / {fs.list_dir[r], fs.kind[r], fs.read_file[r]} =
  match listed[r](dir, "", map_new(), walk_room()) {
    Err(why) -> Err(why),
    Ok(found) ->
      map_fold(found, Ok([]), |acc: EmbedRead, name: String, path: String|
        match acc {
          Err(_) -> acc,
          Ok(files) -> match fs.read_file[r](path) {
            Some(b) -> Ok(push(files, { name: bytes_of_string(name), bytes: b })),
            None -> unread(path, "could not be read"),
          },
        }),
  }

fn read_embed<[r]>(
  file: String,
  path: String,
  dir: Bool,
) -> EmbedRead / {fs.list_dir[r], fs.kind[r], fs.read_file[r]} =
  if is_absolute(path) {
    unread(path, "is absolute, and a program's own load reads below its root")
  } else {
    let target = embed_target(file, path);
    match fs.kind[r](target) {
      Missing -> unread(target, "does not exist"),
      Dir -> if dir { read_dir[r](target) }
      else { unread(target, "is a directory, and `embed` takes a file") },
      File -> if dir { unread(target, "is a file, and `embed_dir` takes a directory") } else {
        match fs.read_file[r](target) {
          Some(b) -> Ok([{ name: b"", bytes: b }]),
          None -> unread(target, "could not be read"),
        }
      },
      Symlink -> unread(target, "is a symlink, which a load does not follow"),
    }
  }

/// What each module of the package asks to embed, read.
fn embeds_of<[r]>(
  package: Package,
) -> List<Embedded> / {fs.list_dir[r], fs.kind[r], fs.read_file[r], abort.raise} =
  fold(package.files, [], |acc: List<Embedded>, f: SourceFile|
    fold(
      embeds_wanted(bytes_of_string(package.root), [
        { name: bytes_of_string(f.name), src: f.text },
      ]),
      acc,
      |a: List<Embedded>, embed: Embedded|
        push(a, {
          ..embed,
          read: read_embed[r](f.path, string_of_bytes_lossy(embed.want.path), embed.want.dir),
        }),
    ))

// --- The front end --------------------------------------------------------------

/// `std.json` is `<std>/json.ply`, as a rendered span names a shipped module.
fn shipped_path(name: String) -> String / {abort.raise} = {
  let segments = string_split(name, ".");
  match list_at(segments, 0) {
    None -> name,
    Some(root) ->
      "<" ++ root ++ ">/"
        ++ fold(range(1, len(segments)), "", |acc: String, i: Int|
          if i == 1 { at(segments, i) } else { acc ++ "/" ++ at(segments, i) })
        ++ ".ply",
  }
}

/// Every source the answer's module indices run over, in their order: the root package's modules,
/// each dependency's in the order they were read, the shipped modules it pulled, then the manifests.
fn placed(
  own: Package,
  deps: List<Package>,
  pulled: List<Bytes>,
  shipped: Map<Bytes, Bytes>,
) -> List<SourceFile> / {abort.raise} = {
  let modules = fold(deps, own.files, |acc: List<SourceFile>, package: Package|
    concat(acc, package.files));
  let shipped_sources = concat(
    modules,
    map(pulled, |n: Bytes|
      {
        path: shipped_path(string_of_bytes(n)),
        name: string_of_bytes(n),
        text: match map_get(shipped, n) { Some(t) -> t, None -> b"" },
      }),
  );
  fold(concat([own], deps), shipped_sources, |acc: List<SourceFile>, package: Package|
    match package.manifest {
      None -> acc,
      Some(text) -> push(acc, { path: joined(package.root, "ply.pkg"), name: "pkg", text: text }),
    })
}

/// What a read takes in before it loads anything: the program's packages, the shipped modules they
/// pull, and what each of its modules embeds.
pub type Prepared = {
  own: Package,
  deps: List<Package>,
  pkgs: PackageSources,
  shipping: Shipping,
  embeds: List<Embedded>,
}

/// The program below `root` as a load takes it in. A file that cannot be a module and a dependency
/// `ply` would have to fetch are each a refusal.
pub fn prepared<[r]>(
  root: String,
) -> Result<Prepared, Unloaded> / {fs.list_dir[r], fs.kind[r], fs.read_file[r], shipped.names, shipped.module, abort.raise} =
  match package_at[r](root) {
    Err(diags) -> Err(unloaded(diags)),
    Ok(own) -> if len(own.files) == 0 {
      Err(unloaded([nowhere("no `.ply` files under `" ++ root ++ "`")]))
    } else {
      match packages_of[r](own) {
        Err(diags) -> Err(unloaded(diags)),
        Ok(deps) -> {
          let pkgs = {
            root: bytes_of_string(own.root),
            manifest: own.manifest,
            supplied: map(deps, supplied_of),
          };
          Ok({
            own: own,
            deps: deps,
            pkgs: pkgs,
            shipping: shipped_for(sources_of(own.files), pkgs),
            embeds: fold(deps, embeds_of[r](own), |acc: List<Embedded>, package: Package|
              concat(acc, embeds_of[r](package))),
          })
        },
      }
    },
  }

fn own_package(root: Bytes, p: Package) -> OwnPackage =
  {
    root: root,
    manifest: p.manifest,
    files: map(p.files, |f: SourceFile| { module: bytes_of_string(f.name), text: f.text }),
  }

/// The world the queries of a load of `p` read.
fn world_for(p: Prepared) -> World / {abort.raise} =
  world_of(
    own_package(p.pkgs.root, p.own),
    map(range(0, len(p.deps)), |i: Int| own_package(at(p.pkgs.supplied, i).root, at(p.deps, i))),
    p.embeds,
  )

fn held_module(name: Bytes) -> Option<Bytes> / {shipped.module} =
  shipped.module(string_of_bytes_lossy(name))

/// `work` over a load of `p`, through the memo store in the stage `dir` names for the queries that
/// answer, or over none where `dir` is empty.
fn in_store<a, [r]>(
  p: Prepared,
  dir: String,
  work: (Map<Bytes, Query>, World, Run) -> { run: Run, value: a } / {memo_keep.read, memo_keep.write, abort.raise},
) -> a / {shipped.answer, shipped.names, fs.read[r], fs.write[r], shipped.module, shipped.definitions, shipped.stamps, abort.raise} = {
  let w = world_for(p);
  let qs = running();
  let look = |kind: Bytes, at: Bytes|
    looked(w, held_module, held_module, || map(shipped.names(), bytes_of_string), kind, at);
  if dir == "" {
    memo_files::fresh(|path: String| shipped.answer(path), look, |run: Run| work(qs, w, run)).value
  } else {
    let at = dir ++ "-" ++ identity_of(qs);
    if fs.create_dir[r](at) {
      fs.write_file[r](at ++ "/.used", b"");
      ()
    };
    memo_files::kept[r](at, |path: String| shipped.answer(path), look, |run: Run|
      work(qs, w, run)).value
  }
}

/// The queries, each under the hash this program gives its definition and the evaluator it runs on:
/// the hashes the answers the toolchain ships are kept under.
fn running() -> Map<Bytes, Query> / {shipped.definitions, shipped.stamps, abort.raise} =
  registry(shipped.definitions(), evaluator_of(bytes_of_string(shipped.stamps())))

/// What each module of a load answered checked and, where none refuses, what hashing fixed of each.
pub type Asked = { answers: List<Answered>, fixing: Fixing }

/// What each module of `w`, a load of `p`, and each shipped module `p` pulls answers, asked of `qs`
/// over a run.
fn asked(
  qs: Map<Bytes, Query>,
  w: World,
  p: Prepared,
  run: Run,
) -> { run: Run, value: Asked } / {memo_keep.read, memo_keep.write, abort.raise} = {
  let all = asked_all(qs, w.own, shipped_of(p), false, run);
  // A program some module refuses has nothing to hash.
  if len(refused_first(all.value)) > 0 {
    { run: all.run, value: { answers: all.value, fixing: no_fixing() } }
  } else {
    let fixed = hashed_all(qs, w.own, shipped_of(p), false, all.run);
    { run: fixed.run, value: { answers: all.value, fixing: fixed.value } }
  }
}

/// What each module of `p` and each shipped module it pulls answers, through the memo store in the
/// stage `dir` names (none where `dir` is empty).
pub fn answers_of<[r]>(
  p: Prepared,
  dir: String,
) -> Asked / {shipped.answer, shipped.names, fs.read[r], fs.write[r], shipped.module, shipped.definitions, shipped.stamps, abort.raise} =
  in_store[r](p, dir, |qs: Map<Bytes, Query>, w: World, run: Run| asked(qs, w, p, run))

/// The hash of `entry` as hashing its module fixed it, through the memo store in the stage `dir`
/// names: nothing where its module does not define it or does not hash. No other module is asked,
/// so one beside it that no longer parses is not read.
pub fn entry_hash_of<[r]>(
  p: Prepared,
  dir: String,
  entry: Bytes,
) -> Option<Bytes> / {shipped.answer, shipped.names, fs.read[r], fs.write[r], shipped.module, shipped.definitions, shipped.stamps, abort.raise} =
  in_store[r](p, dir, |qs: Map<Bytes, Query>, w: World, run: Run| {
    let h = entry_hash(qs, run, entry_module(entry), entry);
    { run: h.run, value: h.hash }
  })

/// [`answers_of`] with nothing kept: what the toolchain ships answered for the shipped modules is
/// still read.
pub fn answers_afresh(
  p: Prepared,
) -> Asked / {shipped.answer, shipped.names, shipped.module, shipped.definitions, shipped.stamps, abort.raise} = {
  let w = world_for(p);
  let qs = running();
  memo_files::fresh(
    |path: String| shipped.answer(path),
    |kind: Bytes, at: Bytes|
      looked(w, held_module, held_module, || map(shipped.names(), bytes_of_string), kind, at),
    |run: Run| asked(qs, w, p, run),
  ).value
}

fn shipped_of(p: Prepared) -> List<Bytes> = map(p.shipping.read, |s: Source| s.name)

/// The module that defines `entry`.
fn entry_module(entry: Bytes) -> Bytes / {abort.raise} = {
  let k = fold(range(0, bytes_len(entry)), 0 - 1, |acc: Int, i: Int|
    if bytes_at(entry, i) == 46 { i } else { acc });
  if k < 0 { b"" } else { bytes_slice(entry, 0, k) }
}

/// The errors of each module `answers` refuses that no refusal of a module it imports explains,
/// each labelled at its module's place among `files`; nothing where none refuses.
fn refusals(answers: List<Answered>, files: List<SourceFile>) -> List<Diag> / {abort.raise} = {
  let placed_at = fold(range(0, len(files)), map_new(), |acc: Map<Bytes, Int>, i: Int|
    map_insert(acc, bytes_of_string(at(files, i).name), i));
  fold(refused_first(answers), [], |acc: List<Diag>, a: Answered| {
    let i = match map_get(placed_at, a.module) { Some(k) -> k, None -> 0 };
    concat(
      acc,
      map(a.answer.refused, |d: Diag|
        { ..d, labels: map(d.labels, |l: Label| { ..l, module: i }) }),
    )
  })
}

/// The program `p` as its modules' answers in `asked` say it checked and hashed, or what refuses it.
/// `tested` reads its tests and laws, which a program to ship has none of.
pub fn assembled(
  p: Prepared,
  asked: Asked,
  tested: Bool,
) -> Result<Checked, Unloaded> / {shipped.reached, abort.raise} = {
  let mine = placed(p.own, p.deps, shipped_of(p), texts_of(p.shipping.read));
  let answers = asked.answers;
  let modules = fold(p.deps, len(p.own.files), |n: Int, d: Package| n + len(d.files))
    + len(p.shipping.read);
  let packaged = packages_refused(
    p.pkgs,
    map(p.own.files, |f: SourceFile| bytes_of_string(f.name)),
    modules,
    concat(shipped_of(p), p.shipping.unread),
  );
  match if len(packaged) > 0 { packaged } else { refusals(answers, mine) } {
    [] -> {
      let loaded = answered_load(
        map(p.own.files, |f: SourceFile| bytes_of_string(f.name)),
        p.pkgs,
        fold(answers, map_new(), |acc: Map<Bytes, ModuleFacts>, a: Answered|
          map_insert(acc, a.module, a.answer.facts)),
        asked.fixing,
        p.shipping.read,
        p.shipping.unread,
        [],
        tested,
        true,
        root_warnings(answers, len(p.own.files)),
      );
      let program = loaded.program;
      let pulled = loaded.pulled;
      let texts = texts_of(p.shipping.read);
      tell_viewed(program.views, true);
      Ok({
        front: {
          dump: view_dump(program.view, None),
          files: placed(p.own, p.deps, pulled, texts),
          read_ms: 0,
          front_ms: 0,
          file_ms: 0,
          cached: false,
        },
        hashes: program.view.hashes,
      })
    },
    ds -> Err({ diags: ds, files: mine }),
  }
}

/// The shipped modules a load of `user` and `pkgs` pulls, each as an importer reads it, and the data
/// files those embed, each asked of the binary when it is pulled.
pub fn shipped_for(
  user: List<Source>,
  pkgs: PackageSources,
) -> Shipping / {shipped.names, shipped.module, abort.raise} = {
  let held = |name: Bytes| shipped.module(string_of_bytes_lossy(name));
  let read = |name: Bytes| match held(name) { Some(text) -> Some(imported(text)), None -> None };
  shipped_pulled(user, pkgs, map(shipped.names(), bytes_of_string), read, held, pulls_of)
}

/// What a load read of the shipped modules it pulled, told to whatever observes the run. `pulled` is
/// whether the load read them itself, rather than re-analysing a load that did.
pub fn tell_viewed(viewed: List<ShippedView>, pulled: Bool) -> Unit / {shipped.reached} =
  if len(viewed) == 0 { () } else { shipped.reached(viewed_text(viewed), pulled) }

fn texts_of(shipped_sources: List<Source>) -> Map<Bytes, Bytes> =
  fold(shipped_sources, map_new(), |acc: Map<Bytes, Bytes>, source: Source|
    map_insert(acc, source.name, source.src))

/// What the front end answered for a program held in memory, with every source its module indices
/// run over, in their order.
pub type Held = { out: AnalysisOutcome, files: List<SourceFile> }

/// A program held in memory, one package with no manifest, analysed against the shipped modules.
pub fn analysed(
  files: List<SourceFile>,
) -> Held / {shipped.names, shipped.module, shipped.reached, abort.raise} = {
  let pkgs = { root: b"", manifest: None, supplied: [] };
  let shipping = shipped_for(sources_of(files), pkgs);
  let own = { root: "", manifest: None, files: files };
  let pulled = analyse_pulling_std_with(
    sources_of(files),
    shipping.read,
    [],
    [],
    pkgs,
    unread: shipping.unread,
    data: shipping.data,
  );
  tell_viewed(pulled.viewed, true);
  { out: pulled.out, files: placed(own, [], pulled.pulled, texts_of(shipping.read)) }
}

/// A program held in memory, one package with no manifest, checked against the shipped modules.
pub fn held(
  files: List<SourceFile>,
) -> Result<LoadedAnalysis, Unloaded> / {shipped.names, shipped.module, shipped.reached, abort.raise} = {
  let answered = analysed(files);
  match answered.out {
    Refused(diags) -> Err({ diags: diags, files: answered.files }),
    Analysed(w) ->
      Ok({
        dump: dump_of(Analysed(w)),
        files: answered.files,
        read_ms: 0,
        front_ms: 0,
        file_ms: 0,
        cached: false,
      }),
  }
}

/// Every root a program's answer offers: each `fn` in source order, then its tests, laws and clauses.
pub fn every_root(front: LoadedAnalysis) -> List<Bytes> =
  map(front.dump.emitter_roots, |root: EmitterRoot| root.root)

/// The program below `root`: read, checked, and emitted afresh. A definition the emitter refuses is
/// a refusal too.
pub fn load<[r]>(
  root: String,
) -> Result<Loaded, List<Diag>> / {fs.list_dir[r], fs.kind[r], fs.read_file[r], shipped.answer, shipped.names, shipped.module, shipped.reached, shipped.runtime, shipped.definitions, shipped.stamps, abort.raise} =
  match prepared[r](root) {
    Err(u) -> Err(u.diags),
    Ok(p) -> match assembled(p, answers_afresh(p), true) {
      Err(u) -> Err(u.diags),
      Ok(c) -> match compiled(
          shipped.runtime(),
          c.front.dump,
          map(c.front.files, |f: SourceFile| f.text),
          every_root(c.front),
          b"",
          |_: Bytes| None,
          |_: Bytes, _: Bytes| (),
        ) {
        Err(diags) -> Err(diags),
        Ok(unit) -> Ok({ front: c.front, unit: unit }),
      },
    },
  }

// --- Tests ------------------------------------------------------------------

fn no_runtime() -> Runtime = { head: b"", tail: b"", helpers: [], builtins: [], identity: b"" }

/// What a program holding every query's definition lists, each under a hash of its own.
fn listed_queries() -> Bytes / {abort.raise} =
  bytes_concat_all(
    map(
      queries(),
      |q: { name: Bytes, definition: Bytes, body: (Bytes) -> Bytes / {memo.read, abort.raise} }|
        bytes_concat_all([q.definition, b" ", hex(blake3(q.definition)), b"\n"]),
    ),
  )

/// `load` over a tree held in memory, with no shipped modules.
fn loaded_from(
  files: List<{ path: String, body: Bytes }>,
  names: List<String> = [],
) -> Result<Loaded, List<Diag>> / {abort.raise} = {
  let tree = fs::mem_of(files);
  handle {
    load[t]("p")
  } with {
    fs.list_dir[t](path) -> fs::mem_list(tree, path),
    fs.kind[t](path) -> fs::mem_kind(tree, path),
    fs.read_file[t](path) -> fs::mem_read(tree, path),
    shipped.names() -> names,
    shipped.module(name) -> None,
    shipped.reached(view, pulled) -> (),
    shipped.runtime() -> no_runtime(),
    shipped.answer(path) -> None,
    shipped.definitions() -> listed_queries(),
    shipped.stamps() -> "",
  }
}

fn codes(r: Result<Loaded, List<Diag>>) -> List<Bytes> =
  match r { Ok(_) -> [], Err(diags) -> map(diags, |diag: Diag| diag.code) }

fn said(diags: List<Diag>) -> String / {abort.raise} =
  string_of_bytes(fold(diags, b"", |acc: Bytes, diag: Diag| bytes_concat(acc, diag.message)))

test "a program is the `.ply` files below its root, in path order, each the module its path names" {
  match loaded_from([
      { path: "p/b.ply", body: b"import a.c (two)\n\nfn main() -> Int = two()\n" },
      { path: "p/a/c.ply", body: b"pub fn two() -> Int = 2\n" },
      { path: "p/.cache/x.ply", body: b"not ply" },
      { path: "p/target/y.ply", body: b"not ply" },
      { path: "p/notes.txt", body: b"not ply" },
    ]) {
    Err(diags) -> panic(said(diags)),
    Ok(l) -> {
      assert_eq(map(l.front.files, |f: SourceFile| f.path), ["p/a/c.ply", "p/b.ply"]);
      assert_eq(map(l.front.files, |f: SourceFile| f.name), ["a.c", "b"]);
      assert(bytes_len(l.unit) > 0)
    },
  }
}

test "a module's path sorts before a directory's that it prefixes, as `ply` reads a project" {
  match loaded_from([
      { path: "p/a/b.ply", body: b"pub fn two() -> Int = 2\n" },
      { path: "p/a.ply", body: b"import a.b (two)\n\nfn main() -> Int = two()\n" },
    ]) {
    Err(diags) -> panic(said(diags)),
    Ok(l) -> assert_eq(map(l.front.files, |f: SourceFile| f.path), ["p/a.ply", "p/a/b.ply"]),
  }
}

fn manifest(name: String, deps: String) -> Bytes =
  bytes_of_string(
    "import std.pkg (Manifest)\n\nfn package() -> Manifest = {\n  name: \"" ++ name
      ++ "\",\n  version: { major: 0, minor: 1, patch: 0 },\n  prefix: None,\n  runtime: { major: 0, minor: 16, patch: 0 },\n  dependencies: ["
      ++ deps
      ++ "],\n  entry: None,\n}\n",
  )

fn path_dep(name: String, path: String) -> String =
  "{ name: \"" ++ name ++ "\", prefix: None, min: { major: 0, minor: 1, patch: 0 }, source: Path(\""
    ++ path
    ++ "\") }"

test "a path dependency is read from the directory its manifest names, its modules placed after the root's" {
  match loaded_from([
      { path: "p/ply.pkg", body: manifest("app", path_dep("lib", "../lib")) },
      { path: "p/m.ply", body: b"import lib.deep (seven)\n\nfn main() -> Int = seven()\n" },
      { path: "lib/ply.pkg", body: manifest("lib", "") },
      { path: "lib/deep.ply", body: b"pub fn seven() -> Int = 7\n" },
    ]) {
    Err(diags) -> panic(said(diags)),
    Ok(l) ->
      assert_eq(map(l.front.files, |f: SourceFile| f.path), [
        "p/m.ply",
        "lib/deep.ply",
        "p/ply.pkg",
        "lib/ply.pkg",
      ]),
  }
}

test "a module embeds a file beside it" {
  match loaded_from([
      {
        path: "p/m.ply",
        body: b"fn greeting() -> Bytes = embed(\"hello.txt\")\n\nfn main() -> Int = bytes_len(greeting())\n",
      },
      { path: "p/hello.txt", body: b"hello" },
    ]) {
    Err(diags) -> panic(said(diags)),
    Ok(l) -> assert(bytes_len(l.unit) > 0),
  }
}

test "a shipped module a program imports embeds a data file the binary holds" {
  let tree = fs::mem_of([
    { path: "p/m.ply", body: b"import std.words (list)\n\nfn main() -> Int = bytes_len(list())\n" },
  ]);
  let over = |data: Option<Bytes>|
    handle {
      load[t]("p")
    } with {
      fs.list_dir[t](path) -> fs::mem_list(tree, path),
      fs.kind[t](path) -> fs::mem_kind(tree, path),
      fs.read_file[t](path) -> fs::mem_read(tree, path),
      shipped.names() -> ["std.words"],
      shipped.module(name) -> if name == "std.words" {
        Some(b"pub fn list() -> Bytes = embed(\"words/list.txt\")\n")
      } else if name == "std/words/list.txt" { data }
      else { None },
      shipped.reached(view, pulled) -> (),
      shipped.runtime() -> no_runtime(),
      shipped.answer(path) -> None,
      shipped.definitions() -> listed_queries(),
      shipped.stamps() -> "",
    };
  match over(Some(b"one\ntwo\n")) {
    Err(diags) -> panic(said(diags)),
    Ok(l) -> {
      assert(bytes_len(l.unit) > 0);
      assert_eq(map(l.front.dump.embeds, |e: EmbedAt| e.read), [
        Ok([{ name: b"", bytes: b"one\ntwo\n" }]),
      ])
    },
  };
  assert_eq(codes(over(None)), [b"E0146"])
}

// The emitter parses a shipped module's placed text, so the place is the text the front end read.
test "a shipped module is placed as the load read it, what a module importing it reads in place" {
  let whole = b"/// Two.\npub fn count() -> Int = 2\n\ntest \"two\" {\n  assert_eq(count(), 2)\n}\n";
  let tree = fs::mem_of([
    { path: "p/m.ply", body: b"import std.words (count)\n\nfn main() -> Int = count()\n" },
  ]);
  let loaded = handle {
    load[t]("p")
  } with {
    fs.list_dir[t](path) -> fs::mem_list(tree, path),
    fs.kind[t](path) -> fs::mem_kind(tree, path),
    fs.read_file[t](path) -> fs::mem_read(tree, path),
    shipped.names() -> ["std.words"],
    shipped.module(name) -> if name == "std.words" { Some(whole) } else { None },
    shipped.reached(view, pulled) -> (),
    shipped.runtime() -> no_runtime(),
    shipped.answer(path) -> None,
    shipped.definitions() -> listed_queries(),
    shipped.stamps() -> "",
  };
  match loaded {
    Err(diags) -> panic(said(diags)),
    Ok(l) ->
      assert_eq(
        map(filter(l.front.files, |f: SourceFile| f.name == "std.words"), |f: SourceFile| f.text),
        [imported(whole)],
      ),
  }
}

test "a root with nothing to load, and a file that cannot be a module, are refused" {
  assert_eq(codes(loaded_from([{ path: "p/notes.txt", body: b"" }])), [b"E0502"]);
  assert_eq(codes(loaded_from([{ path: "p/a-b.ply", body: b"fn main() -> Int = 1\n" }])), [
    b"E0502",
  ])
}

test "a program that does not check is refused with what the checker said" {
  let said = codes(loaded_from([{ path: "p/m.ply", body: b"fn main() -> Int = \"one\"\n" }]));
  assert(len(said) > 0 && len(filter(said, |c: Bytes| c == b"E0502")) == 0)
}

test "a root module that claims a built-in package's prefix is refused, the bare root among them" {
  fold(
    ["p/std.ply", "p/std/json.ply", "p/compiler.ply", "p/compiler/front.ply"],
    (),
    |u: Unit, path: String|
      assert(
        contains(
          codes(loaded_from([{ path: path, body: b"pub fn f() -> Int = 1\n" }], ["std.list"])),
          b"E0133",
        ),
        Some(path),
      ),
  );
  assert_eq(
    codes(loaded_from([{ path: "p/stdx.ply", body: b"pub fn f() -> Int = 1\n" }], ["std.list"])),
    [],
  )
}
