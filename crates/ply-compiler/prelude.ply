// The prelude: the functions every module calls without importing them. Each is the runtime's to
// implement, so it is declared and has no body, and the comment above one is what `ply doc` says
// of it.

import std.value (Value)

// E0501 when `cond` is false; `message` defaults to `None`
extern fn assert(cond: Bool, message: Option<String>) -> Unit / {abort.raise}

// E0501 when they differ
extern fn assert_eq<a>(actual: a, expected: a) -> Unit / {abort.raise}

extern fn len<a>(xs: List<a>) -> Int

// a new list with `x` at the end
extern fn push<a>(xs: List<a>, x: a) -> List<a>

// `None` if `i` is negative or past the end
extern fn list_at<a>(xs: List<a>, i: Int) -> Option<a>

// raises if `i` is out of range
extern fn list_set<a>(xs: List<a>, i: Int, v: a) -> List<a> / {abort.raise}

// `n` of `x`; raises if `n` is negative or past `2^26`
extern fn array_new<a>(n: Int, x: a) -> Array<a> / {abort.raise}

extern fn array_of_list<a>(xs: List<a>) -> Array<a>

extern fn array_to_list<a>(xs: Array<a>) -> List<a>

extern fn array_len<a>(xs: Array<a>) -> Int

// `None` if `i` is negative or past the end
extern fn array_at<a>(xs: Array<a>, i: Int) -> Option<a>

// raises if `i` is out of range
extern fn array_get<a>(xs: Array<a>, i: Int) -> a / {abort.raise}

// in place when the caller holds the last reference; raises if `i` is out of range
extern fn array_set<a>(xs: Array<a>, i: Int, v: a) -> Array<a> / {abort.raise}

// the value as a `std.value.Value`; a width below 64 bits the program does not fix reads as its
// `Int`
extern fn reflect<a>(x: a) -> Value

// BLAKE3 of the value's canonical encoding: equal values, equal digests; needs
// `derivable(hash, a)`
extern fn digest<a>(x: a) -> Bytes
  where derivable(hash, a)

// `n` as the `numeric` type the call is at; raises past a width's range
extern fn numeric_of_int<a>(n: Int) -> a / {abort.raise}
  where numeric(a)

extern fn map<a, b | e>(xs: List<a>, f: (a) -> b / e) -> List<b> / e

extern fn filter<a | e>(xs: List<a>, f: (a) -> Bool / e) -> List<a> / e

// left to right
extern fn fold<a, b | e>(xs: List<a>, init: b, f: (b, a) -> b / e) -> b / e

// `step` answers `Continue(next)` or `Stop(result)`; the budget bounds the steps
extern fn iterate<a, b | e>(
  seed: a,
  budget: Int,
  step: (a) -> Iter<a, b> / e,
) -> b / {abort.raise | e}

// what `body` answers for what `acquire` answered, with `release` run on it however `body` ends
// but a failure
extern fn bracket<a, b | e>(
  acquire: () -> a / e,
  release: (a) -> Unit / e,
  body: (a) -> b / e,
) -> b / e

// `f()` and what it cost: the calls it made, the objects it allocated, and how many times it
// performed each atom
extern fn metered<a | e>(
  f: () -> a / e,
) -> { value: a, steps: Int, allocations: Int, performs: List<{ atom: String, count: Int }> } / e

// `[lo, hi)`
extern fn range(lo: Int, hi: Int) -> List<Int>

// any integer type; wraps at its width
extern fn wrap_add<a>(a: a, b: a) -> a

// any integer type; wraps at its width
extern fn wrap_sub<a>(a: a, b: a) -> a

// any integer type; wraps at its width
extern fn wrap_mul<a>(a: a, b: a) -> a

// any integer type; rotated right by `n` bits at its width
extern fn rotr<a>(x: a, n: Int) -> a

// the low thirty-two bits of `x`, rotated right by `n`
extern fn rotr32(x: Int, n: Int) -> Int

// any integer type; `None` where the sum leaves it
extern fn checked_add<a>(a: a, b: a) -> Option<a>

// any integer type; `None` where the difference leaves it
extern fn checked_sub<a>(a: a, b: a) -> Option<a>

// any integer type; `None` where the product leaves it
extern fn checked_mul<a>(a: a, b: a) -> Option<a>

// any integer type; `None` where the negation leaves it
extern fn checked_neg<a>(a: a) -> Option<a>

// raises if out of range
extern fn u8_of_int(n: Int) -> U8 / {abort.raise}

// raises if out of range
extern fn u16_of_int(n: Int) -> U16 / {abort.raise}

// raises if out of range
extern fn u32_of_int(n: Int) -> U32 / {abort.raise}

// raises if out of range
extern fn u64_of_int(n: Int) -> U64 / {abort.raise}

// raises if out of range
extern fn i8_of_int(n: Int) -> I8 / {abort.raise}

// raises if out of range
extern fn i16_of_int(n: Int) -> I16 / {abort.raise}

// raises if out of range
extern fn i32_of_int(n: Int) -> I32 / {abort.raise}

// raises if out of range
extern fn i64_of_int(n: Int) -> I64 / {abort.raise}

// raises if negative
extern fn u128_of_int(n: Int) -> U128 / {abort.raise}

// total
extern fn i128_of_int(n: Int) -> I128 / {abort.raise}

// total
extern fn int_of_u8(n: U8) -> Int

// total
extern fn int_of_u16(n: U16) -> Int

// total
extern fn int_of_u32(n: U32) -> Int

// raises above `Int`'s maximum
extern fn int_of_u64(n: U64) -> Int / {abort.raise}

// total
extern fn int_of_i8(n: I8) -> Int

// total
extern fn int_of_i16(n: I16) -> Int

// total
extern fn int_of_i32(n: I32) -> Int

// total
extern fn int_of_i64(n: I64) -> Int

// raises above `Int`'s maximum
extern fn int_of_u128(n: U128) -> Int / {abort.raise}

// raises outside `Int`'s range
extern fn int_of_i128(n: I128) -> Int / {abort.raise}

// decimal
extern fn u128_to_string(n: U128) -> String

// decimal, with a leading `-` when negative
extern fn i128_to_string(n: I128) -> String

// decimal digits only; `None` otherwise or out of range
extern fn u128_of_string(s: String) -> Option<U128>

// an optional `-` and decimal digits; `None` otherwise or out of range
extern fn i128_of_string(s: String) -> Option<I128>

// in `compare`'s order, `a` when they are equal; needs `derivable(ord, a)`
extern fn min<a>(a: a, b: a) -> a
  where derivable(ord, a)

// in `compare`'s order, `a` when they are equal; needs `derivable(ord, a)`
extern fn max<a>(a: a, b: a) -> a
  where derivable(ord, a)

// one byte; raises outside `0..=255`
extern fn byte_of_int(n: Int) -> Bytes / {abort.raise}

extern fn int_to_string(n: Int) -> String

// shortest round-trip; `Infinity` and `NaN`
extern fn float_to_string(f: Float) -> String

// `a ++ b`
extern fn string_concat(a: String, b: String) -> String

extern fn bytes_len(b: Bytes) -> Int

// `0..=255`; raises out of range
extern fn bytes_at(b: Bytes, i: Int) -> Int / {abort.raise}

// four bytes at `i`, little-endian
extern fn bytes_u32_le(b: Bytes, i: Int) -> U32 / {abort.raise}

// raises out of range
extern fn bytes_slice(b: Bytes, start: Int, end: Int) -> Bytes / {abort.raise}

// `a ++ b`
extern fn bytes_concat(a: Bytes, b: Bytes) -> Bytes

// the 32-byte BLAKE3 digest of `b`
extern fn bytes_blake3(b: Bytes) -> Bytes

// gzip at the best level, the same bytes on every machine
extern fn bytes_gzip(b: Bytes) -> Bytes

// `None` when `b` is not gzip
extern fn bytes_gunzip(b: Bytes) -> Option<Bytes>

// one allocation
extern fn bytes_concat_all(bs: List<Bytes>) -> Bytes

// UTF-8
extern fn bytes_of_string(s: String) -> Bytes

extern fn bytes_is_utf8(b: Bytes) -> Bool

extern fn bytes_index_of(hay: Bytes, needle: Bytes) -> Option<Int>

extern fn bytes_index_of_from(hay: Bytes, needle: Bytes, from: Int) -> Option<Int> / {abort.raise}

extern fn bytes_index_of_byte(hay: Bytes, byte: Int) -> Option<Int> / {abort.raise}

extern fn bytes_starts_with(b: Bytes, prefix: Bytes) -> Bool

extern fn bytes_ends_with(b: Bytes, suffix: Bytes) -> Bool

extern fn bytes_split(b: Bytes, sep: Bytes) -> List<Bytes> / {abort.raise}

// the first index at or after `from` whose byte is not in `class`; `from + budget` if none
extern fn bytes_scan(hay: Bytes, from: Int, class: Bytes, budget: Int) -> Int / {abort.raise}

// the first index at or after `from` whose byte is in `class`; `from + budget` if none
extern fn bytes_scan_until(hay: Bytes, from: Int, class: Bytes, budget: Int) -> Int / {abort.raise}

// the first index at or after `from` whose byte satisfies `f`
extern fn bytes_position<| e>(
  b: Bytes,
  from: Int,
  f: (Int) -> Bool / e,
) -> Option<Int> / {abort.raise | e}

// raises on invalid UTF-8
extern fn string_of_bytes(b: Bytes) -> String / {abort.raise}

// U+FFFD for invalid UTF-8
extern fn string_of_bytes_lossy(b: Bytes) -> String

// in characters
extern fn string_len(s: String) -> Int

// character indexes; raises out of range
extern fn string_slice(s: String, start: Int, end: Int) -> String / {abort.raise}

extern fn string_split(s: String, sep: String) -> List<String> / {abort.raise}

extern fn string_trim(s: String) -> String

extern fn string_lower(s: String) -> String

extern fn string_upper(s: String) -> String

extern fn string_starts_with(s: String, prefix: String) -> Bool

extern fn string_ends_with(s: String, suffix: String) -> Bool

extern fn string_contains(s: String, t: String) -> Bool

// raises if absent
extern fn string_find(s: String, needle: String) -> Int / {abort.raise}

// `None` for a surrogate, a negative or past `U+10FFFF`
extern fn char_of_int(n: Int) -> Option<Char>

// the Unicode scalar value
extern fn int_of_char(c: Char) -> Int

// each character in order
extern fn string_chars(s: String) -> List<Char>

extern fn string_of_chars(cs: List<Char>) -> String

// a total order; needs `derivable(ord, a)`
extern fn compare<a>(x: a, y: a) -> Ordering
  where derivable(ord, a)

// `compare` under a name no module may shadow
extern fn compare_values<a>(x: a, y: a) -> Ordering
  where derivable(ord, a)

extern fn map_new<a, b>() -> Map<a, b>

// replaces
extern fn map_insert<a, b>(m: Map<a, b>, key: a, value: b) -> Map<a, b>

// no-op if `key` is absent
extern fn map_update<a, b | e>(m: Map<a, b>, key: a, f: (b) -> b / e) -> Map<a, b> / e

extern fn map_get<a, b>(m: Map<a, b>, key: a) -> Option<b>

extern fn map_contains<a, b>(m: Map<a, b>, key: a) -> Bool

extern fn map_remove<a, b>(m: Map<a, b>, key: a) -> Map<a, b>

extern fn map_len<a, b>(m: Map<a, b>) -> Int

// ascending
extern fn map_keys<a, b>(m: Map<a, b>) -> List<a>

// key order
extern fn map_values<a, b>(m: Map<a, b>) -> List<b>

// key order
extern fn map_entries<a, b>(m: Map<a, b>) -> List<{ key: a, value: b }>

// a later entry wins
extern fn map_of_entries<a, b>(es: List<{ key: a, value: b }>) -> Map<a, b>

// `b` wins
extern fn map_merge<a, b>(a: Map<a, b>, b: Map<a, b>) -> Map<a, b>

// key order
extern fn map_fold<a, b, c | e>(m: Map<a, b>, init: c, f: (c, a, b) -> c / e) -> c / e

// raises on a zero divisor
extern fn decimal_div(a: Decimal, b: Decimal, scale: Int, mode: Rounding) -> Decimal / {abort.raise}

extern fn decimal_round(d: Decimal, scale: Int, mode: Rounding) -> Decimal / {abort.raise}

extern fn decimal_of_int(n: Int) -> Decimal

// `None` if the rounded value does not fit an `Int`
extern fn int_of_decimal(d: Decimal, mode: Rounding) -> Option<Int>

// nearest
extern fn float_of_decimal(d: Decimal) -> Float

// `None` for `inf` or `NaN`
extern fn decimal_of_float(f: Float) -> Option<Decimal>

extern fn decimal_of_string(s: String) -> Option<Decimal>

// `Float` literal syntax with a sign; `None` for `inf` or `NaN`
extern fn float_of_string(s: String) -> Option<Float>

// nearest; exact up to `2^53`
extern fn float_of_int(n: Int) -> Float

// `x` rounded to a whole number by `mode`; `None` for `NaN`, an infinity, or one past `Int`
extern fn int_of_float(x: Float, mode: Rounding) -> Option<Int>

// `x` at a whole number, chosen as `mode` chooses
extern fn round(x: Float, mode: Rounding) -> Float

// the greatest whole number at or below `x`
extern fn floor(x: Float) -> Float

// the least whole number at or above `x`
extern fn ceil(x: Float) -> Float

// correctly rounded; `NaN` below zero
extern fn sqrt(x: Float) -> Float

extern fn exp(x: Float) -> Float

// the natural logarithm; `-inf` at zero, `NaN` below it
extern fn ln(x: Float) -> Float

extern fn log2(x: Float) -> Float

extern fn log10(x: Float) -> Float

// of `x` radians
extern fn sin(x: Float) -> Float

// of `x` radians
extern fn cos(x: Float) -> Float

// of `x` radians
extern fn tan(x: Float) -> Float

// radians in `[-pi/2, pi/2]`; `NaN` outside `[-1, 1]`
extern fn asin(x: Float) -> Float

// radians in `[0, pi]`; `NaN` outside `[-1, 1]`
extern fn acos(x: Float) -> Float

// radians in `[-pi/2, pi/2]`
extern fn atan(x: Float) -> Float

// `x` to the power `y`
extern fn pow(x: Float, y: Float) -> Float

// the angle of `(x, y)` in radians, in `[-pi, pi]`
extern fn atan2(y: Float, x: Float) -> Float

// `sqrt(x * x + y * y)` without overflow on the way
extern fn hypot(x: Float, y: Float) -> Float

extern fn decimal_to_string(d: Decimal) -> String

// the IEEE-754 bit pattern; total
extern fn bits_of_float(f: Float) -> Int

// the IEEE-754 bit pattern; total
extern fn float_of_bits(n: Int) -> Float

// raises `message`; unanswered, E0502
extern fn panic<a>(message: String) -> a / {abort.raise}

// the value, kept
extern fn observe<a>(value: a) -> a

extern fn secret_of_string(s: String) -> Secret<String>

// constant-time; not rate-limited
extern fn secret_verify(stored: Secret<String>, supplied: String) -> Bool

extern fn secret_is_empty<a>(s: Secret<a>) -> Bool

extern fn cell_get<a>(c: Cell<a>) -> a

extern fn cell_set<a>(c: Cell<a>, v: a) -> Unit

// the cell is unreadable while `f` runs
extern fn cell_update<a | e>(c: Cell<a>, f: (a) -> a / e) -> Unit
