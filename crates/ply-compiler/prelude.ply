//! The prelude: the functions every module calls without importing them. Each is the runtime's to
//! implement, so it is declared and has no body, and its doc is what `ply doc` says of it.
//!
//! A module may shadow any of them except `compare_values` and `map_of_entries`, which the map and set
//! literals are written in (`E0105`). Out-of-range indexes and slices raise unless a doc says
//! otherwise; nothing is clamped, and a builtin that can raise carries `abort.raise` in its row.
//! One that states a `requires` raises only where a clause of it fails, so a call the conditions on
//! the way to it show every clause of adds no `abort.raise`; an `ensures` is what the checker knows
//! of the answer, `result`, when it reads a later clause.
//! Strings are indexed by character and bytes by byte. The float functions answer the same bits on
//! every machine: they are computed by Ply rather than asked of the platform, and every `NaN` they
//! answer is the one `std.float.nan()` is, since a result is cached and the prover evaluates ground
//! terms.

import std.value (Value)

/// E0501 when `cond` is false; `message` defaults to `None`.
extern fn assert(cond: Bool, message: Option<String>) -> Unit / {abort.raise}

/// E0501 when they differ.
extern fn assert_eq<a>(actual: a, expected: a) -> Unit / {abort.raise}

/// How many items the list holds.
extern fn len<a>(xs: List<a>) -> Int
  ensures 0 <= result

/// A new list with `x` at the end.
extern fn push<a>(xs: List<a>, x: a) -> List<a>

/// `None` if `i` is negative or past the end.
extern fn list_at<a>(xs: List<a>, i: Int) -> Option<a>

/// Raises if `i` is out of range.
extern fn list_set<a>(xs: List<a>, i: Int, v: a) -> List<a> / {abort.raise}
  requires 0 <= i && i < len(xs)

/// `n` of `x`; raises if `n` is negative or past `2^26`.
extern fn array_new<a>(n: Int, x: a) -> Array<a> / {abort.raise}
  requires 0 <= n && n <= 67108864

/// The list's items as an array.
extern fn array_of_list<a>(xs: List<a>) -> Array<a>

/// The array's items as a list.
extern fn array_to_list<a>(xs: Array<a>) -> List<a>

/// How many items the array holds.
extern fn array_len<a>(xs: Array<a>) -> Int
  ensures 0 <= result

/// `None` if `i` is negative or past the end.
extern fn array_at<a>(xs: Array<a>, i: Int) -> Option<a>

/// Raises if `i` is out of range.
extern fn array_get<a>(xs: Array<a>, i: Int) -> a / {abort.raise}
  requires 0 <= i && i < array_len(xs)

/// In place when the caller holds the last reference; raises if `i` is out of range.
extern fn array_set<a>(xs: Array<a>, i: Int, v: a) -> Array<a> / {abort.raise}
  requires 0 <= i && i < array_len(xs)

/// The value as a `std.value.Value`; a width below 64 bits the program does not fix reads as its
/// `Int`.
extern fn reflect<a>(x: a) -> Value

/// As `reflect`, but a value whose type states a `show` is `VShown` of what that function writes,
/// at any depth.
extern fn shown<a>(x: a) -> Value

/// BLAKE3 of the value's canonical encoding, 32 bytes: values `==` calls equal have one digest
/// (`1.50m` and `1.5m`, two orders of one map, two values of a type whose `key` answers the same),
/// a constructor counts by the name its module declares, and a `new` record is the record it is
/// written as; needs `derivable(hash, a)`.
extern fn digest<a>(x: a) -> Bytes
  where derivable(hash, a)

/// `n` as the `numeric` type the call is at, which is its `of_int(n)` at a type that states
/// `numeric`; raises past a width's range, which a value in `0..=127` never is.
extern fn numeric_of_int<a>(n: Int) -> a / {abort.raise}
  where numeric(a)
  requires 0 <= n && n <= 127

/// `f` of each item, in order.
extern fn map<a, b | e>(xs: List<a>, f: (a) -> b / e) -> List<b> / e

/// The items `f` keeps, in order.
extern fn filter<a | e>(xs: List<a>, f: (a) -> Bool / e) -> List<a> / e

/// Left to right.
extern fn fold<a, b | e>(xs: List<a>, init: b, f: (b, a) -> b / e) -> b / e

/// `step` answers `Continue(next)` or `Stop(result)`; the budget bounds the steps.
extern fn iterate<a, b | e>(
  seed: a,
  budget: Int,
  step: (a) -> Iter<a, b> / e,
) -> b / {abort.raise | e}

/// What `body` answers for what `acquire` answered, with `release` run on it however `body` ends but a
/// failure. The three run as one, so each may perform what the others do.
extern fn bracket<a, b | e>(
  acquire: () -> a / e,
  release: (a) -> Unit / e,
  body: (a) -> b / e,
) -> b / e

/// What the hold holds. A hold its region has already let go, which only a continuation resumed
/// after the release still reaches, ends the run with E0331.
extern fn hold_get<a>(h: Hold<a>) -> a / {hold.read}

/// `f()` and what it cost: the calls it made, the objects it allocated, and how many times it
/// performed each atom.
extern fn metered<a | e>(
  f: () -> a / e,
) -> { value: a, steps: Int, allocations: Int, performs: List<{ atom: String, count: Int }> } / e

/// `[lo, hi)`.
extern fn range(lo: Int, hi: Int) -> List<Int>

/// Any integer type; wraps at its width. `a +% b` is this call.
extern fn wrap_add<a>(a: a, b: a) -> a

/// Any integer type; wraps at its width. `a -% b` is this call.
extern fn wrap_sub<a>(a: a, b: a) -> a

/// Any integer type; wraps at its width. `a *% b` is this call.
extern fn wrap_mul<a>(a: a, b: a) -> a

/// Any integer type; its greatest value where the sum passes it and its least where the sum falls
/// below. `a +| b` is this call.
extern fn saturating_add<a>(a: a, b: a) -> a

/// Any integer type; its least value where the difference falls below it, which is zero for an
/// unsigned one, and its greatest where the difference passes it. `a -| b` is this call.
extern fn saturating_sub<a>(a: a, b: a) -> a

/// Any integer type; its greatest or least value where the product leaves it. `a *| b` is this
/// call.
extern fn saturating_mul<a>(a: a, b: a) -> a

/// Any integer type; rotated right by `n` bits at its width, any `n` counted around it.
extern fn rotr<a>(x: a, n: Int) -> a

/// Any integer type; rotated left by `n` bits at its width, any `n` counted around it.
extern fn rotl<a>(x: a, n: Int) -> a

/// The low thirty-two bits of `x`, rotated right by `n`.
extern fn rotr32(x: Int, n: Int) -> Int
  ensures 0 <= result && result <= 4294967295

/// Any integer type; `None` where the sum leaves it.
extern fn checked_add<a>(a: a, b: a) -> Option<a>

/// Any integer type; `None` where the difference leaves it.
extern fn checked_sub<a>(a: a, b: a) -> Option<a>

/// Any integer type; `None` where the product leaves it.
extern fn checked_mul<a>(a: a, b: a) -> Option<a>

/// Any integer type; `None` for an unsigned nonzero `a` and a signed type's least value.
extern fn checked_neg<a>(a: a) -> Option<a>

/// `x` as an `Int`, from any integer type; `None` where `Int` does not hold it. With
/// `numeric_of_int` it converts between any two.
extern fn to_int<a>(x: a) -> Option<Int>
  where integer(a)

/// Raises if out of range.
extern fn u8_of_int(n: Int) -> U8 / {abort.raise}
  requires 0 <= n && n <= 255

/// Raises if out of range.
extern fn u16_of_int(n: Int) -> U16 / {abort.raise}
  requires 0 <= n && n <= 65535

/// Raises if out of range.
extern fn u32_of_int(n: Int) -> U32 / {abort.raise}
  requires 0 <= n && n <= 4294967295

/// Raises if out of range.
extern fn u64_of_int(n: Int) -> U64 / {abort.raise}
  requires 0 <= n

/// Raises if out of range.
extern fn i8_of_int(n: Int) -> I8 / {abort.raise}
  requires -128 <= n && n <= 127

/// Raises if out of range.
extern fn i16_of_int(n: Int) -> I16 / {abort.raise}
  requires -32768 <= n && n <= 32767

/// Raises if out of range.
extern fn i32_of_int(n: Int) -> I32 / {abort.raise}
  requires -2147483648 <= n && n <= 2147483647

/// Total.
extern fn i64_of_int(n: Int) -> I64

/// Raises if negative.
extern fn u128_of_int(n: Int) -> U128 / {abort.raise}
  requires 0 <= n

/// Total.
extern fn i128_of_int(n: Int) -> I128

/// Total.
extern fn int_of_u8(n: U8) -> Int
  ensures 0 <= result && result <= 255

/// Total.
extern fn int_of_u16(n: U16) -> Int
  ensures 0 <= result && result <= 65535

/// Total.
extern fn int_of_u32(n: U32) -> Int
  ensures 0 <= result && result <= 4294967295

/// Raises above `Int`'s maximum.
extern fn int_of_u64(n: U64) -> Int / {abort.raise}
  ensures 0 <= result

/// Total.
extern fn int_of_i8(n: I8) -> Int
  ensures -128 <= result && result <= 127

/// Total.
extern fn int_of_i16(n: I16) -> Int
  ensures -32768 <= result && result <= 32767

/// Total.
extern fn int_of_i32(n: I32) -> Int
  ensures -2147483648 <= result && result <= 2147483647

/// Total.
extern fn int_of_i64(n: I64) -> Int

/// Raises above `Int`'s maximum.
extern fn int_of_u128(n: U128) -> Int / {abort.raise}
  ensures 0 <= result

/// Raises outside `Int`'s range.
extern fn int_of_i128(n: I128) -> Int / {abort.raise}

/// Decimal.
extern fn u128_to_string(n: U128) -> String

/// Decimal, with a leading `-` when negative.
extern fn i128_to_string(n: I128) -> String

/// Decimal digits only; `None` otherwise or out of range.
extern fn u128_of_string(s: String) -> Option<U128>

/// An optional `-` and decimal digits; `None` otherwise or out of range.
extern fn i128_of_string(s: String) -> Option<I128>

/// In `compare`'s order, `a` when they are equal; needs `derivable(ord, a)`.
extern fn min<a>(a: a, b: a) -> a
  where derivable(ord, a)
  ensures result <= a && result <= b

/// In `compare`'s order, `a` when they are equal; needs `derivable(ord, a)`.
extern fn max<a>(a: a, b: a) -> a
  where derivable(ord, a)
  ensures a <= result && b <= result

/// One byte; raises outside `0..=255`.
extern fn byte_of_int(n: Int) -> Bytes / {abort.raise}
  requires 0 <= n && n <= 255

/// `n` in decimal, with a leading `-` when negative.
extern fn int_to_string(n: Int) -> String

/// The shortest text that reads back to `f`; `Infinity`, `-Infinity` and `NaN`.
extern fn float_to_string(f: Float) -> String

/// `a ++ b`.
extern fn string_concat(a: String, b: String) -> String

/// How many bytes `b` holds.
extern fn bytes_len(b: Bytes) -> Int
  ensures 0 <= result

/// `0..=255`; raises out of range.
extern fn bytes_at(b: Bytes, i: Int) -> Int / {abort.raise}
  requires 0 <= i && i < bytes_len(b)
  ensures 0 <= result && result <= 255

/// Four bytes at `i`, little-endian.
extern fn bytes_u32_le(b: Bytes, i: Int) -> U32 / {abort.raise}
  requires 0 <= i && i + 4 <= bytes_len(b)

/// Raises out of range.
extern fn bytes_slice(b: Bytes, start: Int, end: Int) -> Bytes / {abort.raise}
  requires 0 <= start && start <= end && end <= bytes_len(b)

/// `a ++ b`.
extern fn bytes_concat(a: Bytes, b: Bytes) -> Bytes

/// The 32-byte BLAKE3 digest of `b`.
extern fn bytes_blake3(b: Bytes) -> Bytes

/// Gzip at the best level, the same bytes on every machine.
extern fn bytes_gzip(b: Bytes) -> Bytes

/// `None` when `b` is not gzip.
extern fn bytes_gunzip(b: Bytes) -> Option<Bytes>

/// One allocation.
extern fn bytes_concat_all(bs: List<Bytes>) -> Bytes

/// UTF-8.
extern fn bytes_of_string(s: String) -> Bytes

/// Whether `b` is valid UTF-8.
extern fn bytes_is_utf8(b: Bytes) -> Bool

/// Where `needle` first occurs in `hay`.
extern fn bytes_index_of(hay: Bytes, needle: Bytes) -> Option<Int>

/// Where `needle` first occurs in `hay` at or after `from`; raises on a `from` outside `hay`.
extern fn bytes_index_of_from(hay: Bytes, needle: Bytes, from: Int) -> Option<Int> / {abort.raise}
  requires 0 <= from && from <= bytes_len(hay)

/// Where the byte `byte` first occurs in `hay`; raises on a `byte` outside `0..=255`.
extern fn bytes_index_of_byte(hay: Bytes, byte: Int) -> Option<Int> / {abort.raise}
  requires 0 <= byte && byte <= 255

/// Whether `b` begins with `prefix`.
extern fn bytes_starts_with(b: Bytes, prefix: Bytes) -> Bool

/// Whether `b` ends with `suffix`.
extern fn bytes_ends_with(b: Bytes, suffix: Bytes) -> Bool

/// The pieces between each occurrence of `sep`; raises on an empty `sep`.
extern fn bytes_split(b: Bytes, sep: Bytes) -> List<Bytes> / {abort.raise}
  requires 0 < bytes_len(sep)

/// The first index at or after `from` whose byte is not in `class`; `from + budget`, or the end of
/// `hay` if that comes first, if none. Raises on a `from` outside `hay` or a negative `budget`.
extern fn bytes_scan(hay: Bytes, from: Int, class: Bytes, budget: Int) -> Int / {abort.raise}
  requires 0 <= from && from <= bytes_len(hay) && 0 <= budget
  ensures from <= result && result <= bytes_len(hay)

/// The first index at or after `from` whose byte is in `class`; `from + budget`, or the end of `hay`
/// if that comes first, if none. Raises on a `from` outside `hay` or a negative `budget`.
extern fn bytes_scan_until(hay: Bytes, from: Int, class: Bytes, budget: Int) -> Int / {abort.raise}
  requires 0 <= from && from <= bytes_len(hay) && 0 <= budget
  ensures from <= result && result <= bytes_len(hay)

/// The first index at or after `from` whose byte satisfies `f`; raises on a `from` outside `b`.
extern fn bytes_position<| e>(
  b: Bytes,
  from: Int,
  f: (Int) -> Bool / e,
) -> Option<Int> / {abort.raise | e}
  requires 0 <= from && from <= bytes_len(b)

/// Raises on invalid UTF-8.
extern fn string_of_bytes(b: Bytes) -> String / {abort.raise}

/// U+FFFD for invalid UTF-8.
extern fn string_of_bytes_lossy(b: Bytes) -> String

/// In characters.
extern fn string_len(s: String) -> Int
  ensures 0 <= result

/// Character indexes; raises out of range.
extern fn string_slice(s: String, start: Int, end: Int) -> String / {abort.raise}
  requires 0 <= start && start <= end && end <= string_len(s)

/// The pieces between each occurrence of `sep`; raises on an empty `sep`.
extern fn string_split(s: String, sep: String) -> List<String> / {abort.raise}
  requires 0 < string_len(sep)

/// `s` without the characters Unicode calls white space at either end, a no-break space and an em
/// space among them: for text a person wrote. A token or a value in a protocol's text takes
/// `std.string`'s `ascii_trim`.
extern fn string_trim(s: String) -> String

/// `s` in lower case by Unicode's full mapping, the same under every locale: for text a person
/// reads. The answer can be longer than `s` (`İ` is two characters), a final `Σ` is `ς`, and a
/// character outside ASCII can become an ASCII letter (the Kelvin sign `U+212A` is `k`), so a name
/// that is compared takes `std.string`'s `ascii_lower`.
extern fn string_lower(s: String) -> String

/// `s` in upper case by Unicode's full mapping, as `string_lower` is in lower: `ß` is `SS`, and
/// `ſ` is `S`. A name that is compared takes `std.string`'s `ascii_upper`.
extern fn string_upper(s: String) -> String

/// Whether `s` begins with `prefix`.
extern fn string_starts_with(s: String, prefix: String) -> Bool

/// Whether `s` ends with `suffix`.
extern fn string_ends_with(s: String, suffix: String) -> Bool

/// Whether `t` occurs in `s`; an empty `t` occurs in every string.
extern fn string_contains(s: String, t: String) -> Bool

/// Raises if absent.
extern fn string_find(s: String, needle: String) -> Int / {abort.raise}
  ensures 0 <= result

/// `None` for a surrogate, a negative or past `U+10FFFF`.
extern fn char_of_int(n: Int) -> Option<Char>

/// The Unicode scalar value.
extern fn int_of_char(c: Char) -> Int
  ensures 0 <= result && result <= 1114111

/// Each character in order.
extern fn string_chars(s: String) -> List<Char>

/// The characters as a string.
extern fn string_of_chars(cs: List<Char>) -> String

/// A total order, a value of a type that states a `key` standing as its key; needs
/// `derivable(ord, a)`.
extern fn compare<a>(x: a, y: a) -> Ordering
  where derivable(ord, a)

/// `compare` under a name no module may shadow.
extern fn compare_values<a>(x: a, y: a) -> Ordering
  where derivable(ord, a)

/// The map with no entries.
extern fn map_new<a, b>() -> Map<a, b>

/// Replaces.
extern fn map_insert<a, b>(m: Map<a, b>, key: a, value: b) -> Map<a, b>

/// No-op if `key` is absent.
extern fn map_update<a, b | e>(m: Map<a, b>, key: a, f: (b) -> b / e) -> Map<a, b> / e

/// The value under `key`.
extern fn map_get<a, b>(m: Map<a, b>, key: a) -> Option<b>

/// Whether the map holds `key`.
extern fn map_contains<a, b>(m: Map<a, b>, key: a) -> Bool

/// The map without `key`; the same map when it was absent.
extern fn map_remove<a, b>(m: Map<a, b>, key: a) -> Map<a, b>

/// How many entries the map holds.
extern fn map_len<a, b>(m: Map<a, b>) -> Int
  ensures 0 <= result

/// Ascending.
extern fn map_keys<a, b>(m: Map<a, b>) -> List<a>

/// Key order.
extern fn map_values<a, b>(m: Map<a, b>) -> List<b>

/// Key order.
extern fn map_entries<a, b>(m: Map<a, b>) -> List<{ key: a, value: b }>

/// A later entry wins.
extern fn map_of_entries<a, b>(es: List<{ key: a, value: b }>) -> Map<a, b>

/// `b` wins.
extern fn map_merge<a, b>(a: Map<a, b>, b: Map<a, b>) -> Map<a, b>

/// Key order.
extern fn map_fold<a, b, c | e>(m: Map<a, b>, init: c, f: (c, a, b) -> c / e) -> c / e

/// The entry with the least key; `None` for the empty map.
extern fn map_first<a, b>(m: Map<a, b>) -> Option<{ key: a, value: b }>

/// The entry with the greatest key; `None` for the empty map.
extern fn map_last<a, b>(m: Map<a, b>) -> Option<{ key: a, value: b }>

/// The entry with the greatest key at or below `key`.
extern fn map_floor<a, b>(m: Map<a, b>, key: a) -> Option<{ key: a, value: b }>

/// The entry with the least key at or above `key`.
extern fn map_ceiling<a, b>(m: Map<a, b>, key: a) -> Option<{ key: a, value: b }>

/// The entry with the greatest key below `key`.
extern fn map_below<a, b>(m: Map<a, b>, key: a) -> Option<{ key: a, value: b }>

/// The entry with the least key above `key`.
extern fn map_above<a, b>(m: Map<a, b>, key: a) -> Option<{ key: a, value: b }>

/// The entry with the least key and the map without it, in place when the caller holds the last
/// reference; `None` for the empty map.
extern fn map_pop_first<a, b>(m: Map<a, b>) -> Option<{ key: a, value: b, rest: Map<a, b> }>

/// The entry with the greatest key and the map without it, in place when the caller holds the last
/// reference; `None` for the empty map.
extern fn map_pop_last<a, b>(m: Map<a, b>) -> Option<{ key: a, value: b, rest: Map<a, b> }>

/// The first `limit` entries, in key order, whose keys lie from `lo` to `hi`. `None` is no bound on
/// its side; a bound that is not inclusive leaves its own key out; bounds that cross admit nothing,
/// and so does a `limit` below one.
extern fn map_range<a, b>(
  m: Map<a, b>,
  lo: Option<a>,
  lo_inclusive: Bool,
  hi: Option<a>,
  hi_inclusive: Bool,
  limit: Int,
) -> List<{ key: a, value: b }>

/// The map of the entries below `key`, the value at `key`, and the map of the entries above it,
/// sharing what they can with `m`.
extern fn map_split<a, b>(
  m: Map<a, b>,
  key: a,
) -> { below: Map<a, b>, at: Option<b>, above: Map<a, b> }

/// `a / b` with exactly `scale` digits after the point: the exact quotient, rounded once, there,
/// by `mode`. Raises on a zero divisor, on a `scale` outside `0..=28`, and on a quotient that
/// with that many digits is past the 96 bits a `Decimal` holds.
extern fn decimal_div(a: Decimal, b: Decimal, scale: Int, mode: Rounding) -> Decimal / {abort.raise}

/// The digits `d` has after its point: `2` for `1.50m`.
extern fn decimal_scale(d: Decimal) -> Int
  ensures 0 <= result && result <= 28

/// `d` with exactly `scale` digits after the point: rounded there by `mode` where it has more,
/// and filled with zeros where it has fewer. Raises on a `scale` outside `0..=28`, and on a `d`
/// that with that many digits is past the 96 bits a `Decimal` holds, which filling alone can do:
/// to no more digits than `d` has, it cannot raise.
extern fn decimal_round(d: Decimal, scale: Int, mode: Rounding) -> Decimal / {abort.raise}
  requires 0 <= scale && scale <= decimal_scale(d)

/// `n` as a `Decimal` at scale zero.
extern fn decimal_of_int(n: Int) -> Decimal

/// `None` if the rounded value does not fit an `Int`.
extern fn int_of_decimal(d: Decimal, mode: Rounding) -> Option<Int>

/// Nearest.
extern fn float_of_decimal(d: Decimal) -> Float

/// `None` for `inf` or `NaN`.
extern fn decimal_of_float(f: Float) -> Option<Decimal>

/// A decimal number, optionally signed or in scientific notation, read exactly; `None` for any other
/// text or one past what a `Decimal` holds.
extern fn decimal_of_string(s: String) -> Option<Decimal>

/// `Float` literal syntax with a sign; `None` for `inf` or `NaN`.
extern fn float_of_string(s: String) -> Option<Float>

/// Nearest; exact up to `2^53`.
extern fn float_of_int(n: Int) -> Float

/// `x` rounded to a whole number by `mode`; `None` for `NaN`, an infinity, or one past `Int`.
extern fn int_of_float(x: Float, mode: Rounding) -> Option<Int>

/// `x` at a whole number, chosen as `mode` chooses.
extern fn round(x: Float, mode: Rounding) -> Float

/// The greatest whole number at or below `x`.
extern fn floor(x: Float) -> Float

/// The least whole number at or above `x`.
extern fn ceil(x: Float) -> Float

/// Correctly rounded; `NaN` below zero.
extern fn sqrt(x: Float) -> Float

/// `e` to the power `x`.
extern fn exp(x: Float) -> Float

/// The natural logarithm; `-inf` at zero, `NaN` below it.
extern fn ln(x: Float) -> Float

/// The base-2 logarithm; `-inf` at zero, `NaN` below it.
extern fn log2(x: Float) -> Float

/// The base-10 logarithm; `-inf` at zero, `NaN` below it.
extern fn log10(x: Float) -> Float

/// Of `x` radians.
extern fn sin(x: Float) -> Float

/// Of `x` radians.
extern fn cos(x: Float) -> Float

/// Of `x` radians.
extern fn tan(x: Float) -> Float

/// Radians in `[-pi/2, pi/2]`; `NaN` outside `[-1, 1]`.
extern fn asin(x: Float) -> Float

/// Radians in `[0, pi]`; `NaN` outside `[-1, 1]`.
extern fn acos(x: Float) -> Float

/// Radians in `[-pi/2, pi/2]`.
extern fn atan(x: Float) -> Float

/// `x` to the power `y`.
extern fn pow(x: Float, y: Float) -> Float

/// The angle of `(x, y)` in radians, in `[-pi, pi]`.
extern fn atan2(y: Float, x: Float) -> Float

/// `sqrt(x * x + y * y)` without overflow on the way.
extern fn hypot(x: Float, y: Float) -> Float

/// `d` in decimal at its scale, so `1.50m` prints `1.50`.
extern fn decimal_to_string(d: Decimal) -> String

/// The IEEE-754 bit pattern; total.
extern fn bits_of_float(f: Float) -> Int

/// The IEEE-754 bit pattern; total.
extern fn float_of_bits(n: Int) -> Float

/// Raises `message`; unanswered, E0502.
extern fn panic<a>(message: String) -> a / {abort.raise}

/// The identity, through a call the C backend cannot see into: a pure computation whose value is only
/// observed still runs.
extern fn observe<a>(value: a) -> a

/// The string as a secret, which renders as `Secret(****)`.
extern fn secret_of_string(s: String) -> Secret<String>

/// Constant-time; not rate-limited.
extern fn secret_verify(stored: Secret<String>, supplied: String) -> Bool

/// Whether the secret holds nothing.
extern fn secret_is_empty<a>(s: Secret<a>) -> Bool

/// The bytes as a secret.
extern fn secret_of_bytes(b: Bytes) -> Secret<Bytes>

/// The string's UTF-8, still a secret.
extern fn secret_bytes(s: Secret<String>) -> Secret<Bytes>

/// How many bytes the secret holds. A length is not kept secret by anything here.
extern fn secret_len(s: Secret<Bytes>) -> Int

/// `a` then `b`, still a secret.
extern fn secret_concat(a: Secret<Bytes>, b: Secret<Bytes>) -> Secret<Bytes>

/// The bytes a secret text encodes, read without opening it: `encoding` is `"hex"`, `"base64"`,
/// `"base64url"`, `"base32"` or `"base32-typed"`, each what the `std` module of its name reads.
/// `None` for a text the encoding does not write, which is all a refusal says of it; raises for
/// any other encoding.
extern fn secret_decode(
  encoding: String,
  text: Secret<String>,
) -> Option<Secret<Bytes>> / {abort.raise}

/// The private key a DER document holds, and the scheme `crypto_sign` or `crypto_agree` takes it
/// under: PKCS #8 for `"ed25519"`, `"x25519"`, `"p256"` and `"rsa"`, a SEC 1 key on P-256, or a
/// PKCS #1 RSA key. `None` for anything else.
extern fn secret_private_key(der: Secret<Bytes>) -> Option<{ key: Secret<Bytes>, scheme: String }>

/// HMAC under a secret key, over the hash a `std.hash.Hash` of that name is: `"SHA-1"`,
/// `"SHA-256"`, `"SHA-384"` or `"SHA-512"`. `None` for any other.
extern fn secret_hmac(hash: String, key: Secret<Bytes>, message: Bytes) -> Option<Bytes>

/// HKDF's first step, RFC 5869, over the hashes `secret_hmac` takes.
extern fn secret_hkdf_extract(
  hash: String,
  salt: Bytes,
  key: Secret<Bytes>,
) -> Option<Secret<Bytes>>

/// HKDF's second step: `length` bytes. `None` for a length below zero or past 255 digests, too.
extern fn secret_hkdf_expand(
  hash: String,
  key: Secret<Bytes>,
  info: Bytes,
  length: Int,
) -> Option<Secret<Bytes>>

/// PBKDF2, RFC 8018, over HMAC over the hashes `secret_hmac` takes. `None` as well for an
/// iteration count below one, and for a length below one or past `2^20` bytes.
extern fn secret_pbkdf2(
  hash: String,
  password: Secret<Bytes>,
  salt: Bytes,
  iterations: Int,
  length: Int,
) -> Option<Secret<Bytes>>

/// `plaintext` sealed under a 32-byte key and a nonce, bound to `associated`: the ciphertext and
/// then its 16-byte tag. `cipher` is `"aes-256-gcm"` or `"chacha20-poly1305"`, whose nonce is 12
/// bytes, or `"xchacha20-poly1305"`, whose nonce is 24. Raises for any other cipher or length.
/// Sealing two messages under one key and nonce gives both away: `std.crypto` is what keeps a
/// nonce from being used twice.
extern fn crypto_seal(
  cipher: String,
  key: Secret<Bytes>,
  nonce: Bytes,
  associated: Bytes,
  plaintext: Bytes,
) -> Bytes / {abort.raise}

/// What `crypto_seal` sealed; `None` when the key, the nonce, `associated` or a byte of `sealed`
/// is not what it was sealed with. Raises as `crypto_seal` does.
extern fn crypto_open(
  cipher: String,
  key: Secret<Bytes>,
  nonce: Bytes,
  associated: Bytes,
  sealed: Bytes,
) -> Option<Bytes> / {abort.raise}

/// A private key's public key. `scheme` is `"ed25519"` (a 32-byte seed to 32 bytes), `"x25519"`
/// (32 bytes to 32), `"p256"` (a 32-byte big-endian scalar to the 65-byte uncompressed point) or
/// `"rsa"` (a PKCS #8 or PKCS #1 document, of 2048 to 4096 bits, to its PKCS #1 public key).
/// `None` for a key that is none of its scheme; raises for any other scheme.
extern fn crypto_public(scheme: String, key: Secret<Bytes>) -> Option<Bytes> / {abort.raise}

/// A signature over `message`, a function of the key and the message alone. `scheme` is
/// `"ed25519"` (RFC 8032, 64 bytes), `"ecdsa-p256-sha256"` (the nonce RFC 6979's, the signature
/// `r` then `s` in 32 bytes each) or `"rsa-pkcs1-sha256"`, `-sha384` or `-sha512`. The keys are
/// `crypto_public`'s; `None` for one that is none of its scheme, and raises for any other scheme.
extern fn crypto_sign(
  scheme: String,
  key: Secret<Bytes>,
  message: Bytes,
) -> Option<Bytes> / {abort.raise}

/// Whether `signature` is `message` signed by the key `public` is, under `crypto_sign`'s schemes,
/// `"rsa-pss-sha256"`, `-sha384` and `-sha512`, whose salt is as long as the digest, and
/// `"ecdsa-p256-sha384"`, `"ecdsa-p384-sha256"` and `"ecdsa-p384-sha384"`, whose signature is DER
/// and whose key is the uncompressed point. `false`
/// for a key or a signature that is not one: an Ed25519 `S` at or past the group order, an ECDSA
/// `r` or `s` out of range, a point off the curve, an RSA key under 2048 bits. Raises for any
/// other scheme.
extern fn crypto_verify(
  scheme: String,
  public: Bytes,
  message: Bytes,
  signature: Bytes,
) -> Bool / {abort.raise}

/// The secret two keys share: `"x25519"` (RFC 7748) or `"p256"` (the shared point's 32-byte `x`).
/// `None` for a key that is none of its scheme, a peer that is no point of the curve, and an
/// X25519 result of all zeros. Raises for any other scheme. What it answers is not uniform: derive
/// keys from it with HKDF.
extern fn crypto_agree(
  scheme: String,
  key: Secret<Bytes>,
  peer: Bytes,
) -> Option<Secret<Bytes>> / {abort.raise}

/// One SQL statement run by SQLite over the database `image` holds, a database file's bytes or
/// none for an empty one, and the image it leaves: the one handed in where the statement failed
/// or only read. A function of its arguments: the engine is the one every `ply` of this version
/// carries, and a statement that would read a clock, entropy or another file is refused. A
/// parameter and a column's value are `kind` 0 for null, 1 an integer in `int`, 2 a float in
/// `real`, 3 text and 4 bytes, both in `bytes`. `reads_only` refuses a statement that could
/// write, and `strict` a table that is not `STRICT`. `wrote` is whether the statement could have
/// changed the database, `changed` the rows it wrote itself, and `last_row_id` the row id it last
/// inserted, or 0. `failure` says why it did not run: `kind` is what `std.sqlite` types, and
/// `name` the constraint, limit or engine code. `std.sqlite` is how a program runs one.
extern fn sqlite_run(
  image: Bytes,
  sql: String,
  params: List<{ kind: Int, int: Int, real: Float, bytes: Bytes }>,
  reads_only: Bool,
  strict: Bool,
  limits: { sql_bytes: Int, params: Int, rows: Int, bytes: Int, steps: Int },
) -> { image: Bytes, columns: List<String>, rows: List<List<{ kind: Int, int: Int, real: Float, bytes: Bytes }>>, wrote: Bool, changed: Int, last_row_id: Int, failure: Option<{ kind: String, name: String, detail: String }> }

/// The SQL functions a statement `sqlite_run` runs may call, in order: any other is refused.
extern fn sqlite_functions() -> List<String>

/// The value the cell holds.
extern fn cell_get<a>(c: Cell<a>) -> a

/// Puts `v` in the cell.
extern fn cell_set<a>(c: Cell<a>, v: a) -> Unit

/// The cell is unreadable while `f` runs.
extern fn cell_update<a | e>(c: Cell<a>, f: (a) -> a / e) -> Unit
