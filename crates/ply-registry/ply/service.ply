//! The registry over HTTP: the static layout a resolve reads, and the two writes a publisher makes.
//!
//!   GET  /<name>/index.json                     every version of <name>, newest last
//!   GET  /<name>/<version>/package.plyz         the archive
//!   GET  /<name>/<version>/package.plyz.b3      its digest, one `b3:<hex>` line
//!   GET  /<name>/<version>/interface/<sem>      the interface cut under the semantics <sem>
//!   GET  /<name>/<version>/attestation/<sem>    what the registry's attester found of it
//!   PUT  /<name>/<version>                      publish: the archive as the body
//!   PUT  /<name>/<version>/interface/<sem>      the interface beside it
//!   PUT  /<name>/<version>/attestation/<sem>    an attestation the attester's key signed
//!   POST /<name>/<version>/yank                 mark the version yanked
//!
//! With `attester` the attester's public key, `attest.key` its secret key file, `url` where it
//! reaches the registry and `--exec attest=` a `ply`, every version published is attested in turn by
//! that `ply` between connections.
//! A write carries `Authorization: Bearer <token>`, and the token is the one `token.<name>` maps the
//! package to in the run's configuration. It is served over `--tls` when `tls` names a credential,
//! and as plain HTTP otherwise: behind a proxy that terminates TLS, or on this machine alone.

import compiler.interface (enveloped)
import std.bin
import std.bytes (hex_of)
import std.ed25519
import std.pkg (Attestation, attestation_bin, release_at)
import std.signed (countersigned, signed_bytes)
import compiler.pkg (is_dotted_path)
import std.bytes (bytes_of_hex)
import std.config (config)
import std.process (process, Discard, Var)
import std.fs
import std.fs (fs)
import std.http
import std.http (Delete, Get, Limits, Post, Put, Request, Response, default_limits,
                 method_not_allowed, request_to, set_header, text_response)
import std.net (net)
import std.json (decode_bytes)
import std.pkg (Index, Release, Version, index_json, parse_version, render_version)
import std.router
import std.router (Found, Literal, MethodNotAllowed, NotFound, Param, Route, param)
import std.list (at)
import store (Absent, Busy, Exists, Pending, Trouble, Unreadable, Unwritten, archive_path,
              attestation_kept, attestation_path, digest_path, index_of, index_path, interface_path,
              interfaced, marked, pending, published, served, unmarked, yank)
import twin
import upload (Refusal, allowed, is_semantics, judged, judged_attestation, judged_interface)
import compiler.plyx (archive_digest)

type Endpoint =
  | IndexOf
  | ArchiveOf
  | DigestOf
  | InterfaceOf
  | AttestationOf
  | Publish
  | Interface
  | Attest
  | Yank

fn table() -> List<Route<Endpoint>> =
  [
    { method: Get, path: [Param("name"), Literal("index.json")], endpoint: IndexOf },
    {
      method: Get,
      path: [Param("name"), Param("version"), Literal("package.plyz")],
      endpoint: ArchiveOf,
    },
    {
      method: Get,
      path: [Param("name"), Param("version"), Literal("package.plyz.b3")],
      endpoint: DigestOf,
    },
    {
      method: Get,
      path: [Param("name"), Param("version"), Literal("interface"), Param("semantics")],
      endpoint: InterfaceOf,
    },
    {
      method: Get,
      path: [Param("name"), Param("version"), Literal("attestation"), Param("semantics")],
      endpoint: AttestationOf,
    },
    {
      method: Put,
      path: [Param("name"), Param("version"), Literal("attestation"), Param("semantics")],
      endpoint: Attest,
    },
    { method: Put, path: [Param("name"), Param("version")], endpoint: Publish },
    {
      method: Put,
      path: [Param("name"), Param("version"), Literal("interface"), Param("semantics")],
      endpoint: Interface,
    },
    { method: Post, path: [Param("name"), Param("version"), Literal("yank")], endpoint: Yank },
  ]

/// One request, answered from the store and the run's configuration and from nothing else. A
/// write's body is read whole, and refused past the bound `limits` sets.
pub fn answer<| e>(
  req: Request,
) -> Response<| e> / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], config.secret[tokens], config.get[server], http::Reading} =
  match router::route(table(), req.method, req.path) {
    NotFound -> text_response(404, "no such resource\n"),
    MethodNotAllowed(ms) -> method_not_allowed(ms),
    Found(hit) -> {
      let name = match param(hit.params, "name") { Some(n) -> n, None -> "" };
      let version = match param(hit.params, "version") {
        Some(v) -> parse_version(v),
        None -> None,
      };
      let semantics = match param(hit.params, "semantics") { Some(x) -> x, None -> "" };
      if !is_dotted_path(name) { text_response(404, "`" ++ name ++ "` is not a package name\n") }
      else if (hit.endpoint == InterfaceOf || hit.endpoint == Interface)
          && !is_semantics(semantics) {
        text_response(404, "`" ++ semantics ++ "` is not a semantics version\n")
      } else {
        match hit.endpoint {
          IndexOf -> file(served(index_path(name)), "application/json"),
          ArchiveOf -> match version {
            None -> not_a_version(),
            Some(v) ->
              file(served(archive_path(name, render_version(v))), "application/octet-stream"),
          },
          DigestOf -> match version {
            None -> not_a_version(),
            Some(v) ->
              file(served(digest_path(name, render_version(v))), "text/plain; charset=utf-8"),
          },
          InterfaceOf -> match version {
            None -> not_a_version(),
            Some(v) ->
              file(
                served(interface_path(name, render_version(v), semantics)),
                "application/octet-stream",
              ),
          },
          AttestationOf -> match version {
            None -> not_a_version(),
            Some(v) ->
              file(
                served(attestation_path(name, render_version(v), semantics)),
                "application/octet-stream",
              ),
          },
          Attest -> match version {
            None -> not_a_version(),
            Some(v) -> attestation(req, name, v, semantics),
          },
          Publish -> match version { None -> not_a_version(), Some(v) -> publish(req, name, v) },
          Interface -> match version {
            None -> not_a_version(),
            Some(v) -> interface(req, name, v, semantics),
          },
          Yank -> match version { None -> not_a_version(), Some(v) -> yanked(req, name, v) },
        }
      }
    },
  }

fn not_a_version<| e>() -> Response<| e> =
  text_response(404, "that is not a version such as `0.1.0`\n")

fn file<| e>(body: Option<Bytes>, kind: String) -> Response<| e> =
  match body {
    None -> text_response(404, "no such resource\n"),
    Some(b) ->
      {
        status: 200,
        headers: set_header(http::empty_headers(), "content-type", kind),
        body: http::Whole(b),
      },
  }

fn refusal<| e>(r: Refusal) -> Response<| e> = {
  let base = text_response(r.status, r.reason ++ "\n");
  if r.status == 401 { { ..base, headers: set_header(base.headers, "www-authenticate", "Bearer") } }
  else { base }
}

fn trouble<| e>(t: Trouble, name: String, version: Version) -> Response<| e> =
  match t {
    Busy -> text_response(503, "another write to `" ++ name ++ "` holds its lock; try again\n"),
    Unreadable(why) -> text_response(500, why ++ "\n"),
    Unwritten(path) -> text_response(500, "`" ++ path ++ "` could not be written\n"),
    Exists ->
      text_response(
        409,
        "`" ++ name ++ "` " ++ render_version(version)
          ++ " is already published, and a published version never changes\n",
      ),
    Absent ->
      text_response(404, "`" ++ name ++ "` " ++ render_version(version) ++ " is not published\n"),
  }

fn publish<| e>(
  req: Request,
  name: String,
  version: Version,
) -> Response<| e> / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], config.secret[tokens], config.get[server], http::Reading} =
  match allowed(name, req.headers) {
    Err(r) -> refusal(r),
    Ok(_) -> {
      let body = http::request_body(req, limits().max_body);
      match judged(name, version, http::header(req.headers, "x-ply-digest"), body) {
        Err(r) -> refusal(r),
        Ok(release) -> match published(name, release, body) {
          Err(t) -> trouble(t, name, version),
          Ok(kept) -> if kept.fresh {
            let _ = config.get[server]("attest.key") != None
              && marked(name, render_version(version));
            text_response(
              201,
              "published `" ++ name ++ "` " ++ render_version(version) ++ " as " ++ release.digest
                ++ "\n",
            )
          } else {
            text_response(
              200,
              "`" ++ name ++ "` " ++ render_version(version) ++ " is already published as "
                ++ release.digest
                ++ "\n",
            )
          },
        },
      }
    },
  }

fn interface<| e>(
  req: Request,
  name: String,
  version: Version,
  semantics: String,
) -> Response<| e> / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], config.secret[tokens], http::Reading} =
  match allowed(name, req.headers) {
    Err(r) -> refusal(r),
    Ok(_) -> match index_of(name) {
      Err(why) -> text_response(500, why ++ "\n"),
      Ok(None) -> trouble(Absent, name, version),
      Ok(Some(x)) -> match release_at(x, version) {
        None -> trouble(Absent, name, version),
        Some(r) -> {
          let body = http::request_body(req, limits().max_body);
          match judged_interface(semantics, r.digest, body) {
            Err(refused) -> refusal(refused),
            Ok(_) -> match interfaced(name, version, semantics, body) {
              Err(Exists) ->
                text_response(
                  409,
                  "`" ++ name ++ "` " ++ render_version(version)
                    ++ " already has another interface under "
                    ++ semantics
                    ++ ", and an interface is what its archive and semantics make\n",
                ),
              Err(t) -> trouble(t, name, version),
              Ok(fresh) ->
                text_response(
                  if fresh { 201 } else { 200 },
                  "the interface of `" ++ name ++ "` " ++ render_version(version) ++ " under "
                    ++ semantics
                    ++ (if fresh { " is kept" } else { " is already kept" })
                    ++ "\n",
                ),
            },
          }
        },
      },
    },
  }

fn attestation<| e>(
  req: Request,
  name: String,
  version: Version,
  semantics: String,
) -> Response<| e> / {config.get[server], fs.read_file[store], fs.create_dir[store], fs.lock[store], fs.rename[store], fs.unlock[store], fs.write_file[store], http::Reading} =
  match config.get[server]("attester") {
    None -> text_response(403, "this registry keeps no attestations: it names no `attester`\n"),
    Some(hex) -> match index_of(name) {
      Err(why) -> text_response(500, why ++ "\n"),
      Ok(None) -> trouble(Absent, name, version),
      Ok(Some(x)) -> match release_at(x, version) {
        None -> trouble(Absent, name, version),
        Some(r) -> {
          let body = http::request_body(req, limits().max_body);
          match judged_attestation(name, version, semantics, r.digest, bytes_of_hex(hex), body) {
            Err(refused) -> refusal(refused),
            Ok(_) -> match attestation_kept(name, version, semantics, body) {
              Err(t) -> trouble(t, name, version),
              Ok(_) ->
                text_response(
                  201,
                  "the attestation of `" ++ name ++ "` " ++ render_version(version) ++ " under "
                    ++ semantics
                    ++ " is kept\n",
                ),
            },
          }
        },
      },
    },
  }

fn yanked<| e>(
  req: Request,
  name: String,
  version: Version,
) -> Response<| e> / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], config.secret[tokens], abort.raise} =
  match allowed(name, req.headers) {
    Err(r) -> refusal(r),
    Ok(_) -> match yank(name, version) {
      Err(t) -> trouble(t, name, version),
      Ok(_) -> text_response(200, "yanked `" ++ name ++ "` " ++ render_version(version) ++ "\n"),
    },
  }

// --- The service ------------------------------------------------------------------

/// An archive is a package's sources and its compiled unit: larger than a page, bounded all the same.
fn limits() -> Limits = {
  let base = default_limits();
  { ..base, max_body: 67108864 }
}

fn port() -> Int / {config.get[server], abort.raise} =
  match config.get[server]("port") {
    None -> 8080,
    Some(text) -> match router::int_of_text(text) {
      Some(n) -> n,
      None -> panic("the registry will not start: `port` is `" ++ text ++ "`, which is not a port"),
    },
  }

/// Every connection, one at a time, until accepting stops: a signal to the run ends it there.
/// Between two, the attester that ran is reaped and the next version waiting for one is started.
fn accepting(
  listener: Int,
  running: Option<Int>,
) -> Unit / {config.get[server], config.secret[tokens], fs.read_file[store], fs.create_dir[store], fs.lock[store], fs.rename[store], fs.unlock[store], fs.write_file[store], net.close[conn], net.peer_address[conn], net.peer_certificate[conn], net.recv[conn], net.send[conn], net.accept[listener], process.wait[attest], fs.list_dir[store], fs.remove[store], process.bound[attest], process.start[attest], config.get[env], abort.raise, diverges} = {
  let c = net.accept[listener](listener);
  if c == 0 { () } else {
    http::serve_connection[conn](c, limits(), answer);
    accepting(listener, attended(running))
  }
}

/// What a `ply` started for the attester inherits of the registry's environment, beside where it
/// reaches the registry.
fn inherited() -> List<String> = ["PATH", "HOME", "TMPDIR"]

fn attester_env(url: String) -> List<Var> / {config.get[server], config.get[env]} =
  fold(inherited(), [{ name: "PLY_REGISTRY", value: url }], |acc: List<Var>, name: String|
    match config.get[env](name) { Some(v) -> push(acc, { name: name, value: v }), None -> acc })

fn attended(
  running: Option<Int>,
) -> Option<Int> / {config.get[server], process.wait[attest], fs.list_dir[store], fs.remove[store], process.bound[attest], process.start[attest], config.get[env], abort.raise} =
  match running {
    Some(child) -> match process.wait[attest](child, 0) { None -> running, Some(_) -> started() },
    None -> started(),
  }

fn started() -> Option<Int> / {config.get[server], fs.list_dir[store], fs.remove[store], process.bound[attest], process.start[attest], config.get[env], abort.raise} =
  match ((config.get[server]("attest.key"), config.get[server]("url"))) {
    (Some(key), Some(url)) -> if !process.bound[attest]() { None } else {
      match pending() {
        [] -> None,
        [p, ..] -> {
          unmarked(p);
          match process.start[attest](
              ["attest", p.name, p.version, "--sign", key, "--json"],
              "",
              attester_env(url),
              { input: false, out: Discard, err: Discard },
            ) {
            Ok(child) -> Some(child),
            Err(_) -> None,
          }
        },
      }
    },
    _ -> None,
  }

fn main() -> Unit / {config.get[server], config.secret[tokens], net.listen[listener], net.listen_tls[listener], net.accept[listener], net.close[listener], net.peer_address[conn], net.peer_certificate[conn], net.recv[conn], net.send[conn], net.close[conn], fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], config.get[env], fs.list_dir[store], fs.remove[store], process.bound[attest], process.start[attest], process.wait[attest], abort.raise, diverges} = {
  let listener = match config.get[server]("tls") {
    None -> net.listen[listener](port()),
    Some(credential) -> net.listen_tls[listener](port(), credential),
  };
  accepting(listener, None);
  net.close[listener](listener)
}

// --- Tests ------------------------------------------------------------------

fn get(target: String) -> Request / {abort.raise} = request_to(Get, "registry.test", target, b"")

fn written(
  method: http::Method,
  target: String,
  token: String,
  digest: String,
  body: Bytes,
) -> Request / {abort.raise} = {
  let req = request_to(method, "registry.test", target, body);
  let authed = if token == "" { req.headers }
  else { set_header(req.headers, "authorization", "Bearer " ++ token) };
  { ..req, headers: if digest == "" { authed } else { set_header(authed, "x-ply-digest", digest) } }
}

/// An answer with its body read whole.
type Answered = { status: Int, headers: http::Headers, body: Bytes }

/// What `answer` answers `req` with, called as a server calls it on a request whose body is whole.
fn asked(
  req: Request,
) -> Answered / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], config.secret[tokens], config.get[server], abort.raise} =
  match http::read_whole(http::empty_headers(), || answer(req)) {
    Ok(r) -> { status: r.status, headers: r.headers, body: http::whole_bytes(r.body) },
    Err(refused) ->
      {
        status: refused.status,
        headers: http::empty_headers(),
        body: bytes_of_string(refused.reason),
      },
  }

fn statuses(rs: List<Answered>) -> List<Int> = map(rs, |r: Answered| r.status)

fn index_in(r: Answered) -> Index / {abort.raise} =
  match decode_bytes(r.body, index_json()) {
    Ok(x) -> x,
    Err(_) -> panic("the index does not read"),
  }

test "a publish is served back as the static layout a resolve reads" {
  let body = twin::archive(twin::library("orders", 2));
  let d = archive_digest(body);
  let ran = twin::over(fs::mem_empty(), ||
    twin::configured(||
      [
        asked(written(Put, "/orders/0.2.0", "t0k", d, body)),
        asked(get("/orders/index.json")),
        asked(get("/orders/0.2.0/package.plyz")),
        asked(get("/orders/0.2.0/package.plyz.b3")),
        asked(written(Put, "/orders/0.2.0", "t0k", d, body)),
      ]));
  assert_eq(statuses(ran.value), [201, 200, 200, 200, 200]);
  let listed = index_in(at(ran.value, 1));
  assert_eq(listed.name, "orders");
  assert_eq(map(listed.versions, |release: Release| release.digest), [d]);
  assert_eq(at(ran.value, 2).body, body);
  assert_eq(at(ran.value, 3).body, bytes_of_string(d ++ "\n"));
  assert_eq(http::header(at(ran.value, 1).headers, "content-type"), Some("application/json"))
}

test "an interface is kept beside its version under its semantics, and served back" {
  let body = twin::archive(twin::library("orders", 2));
  let d = archive_digest(body);
  let framed = |payload: Bytes|
    enveloped({ semantics: b"ab12", archive: bytes_of_string(d), payload: payload });
  let ran = twin::over(fs::mem_empty(), ||
    twin::configured(||
      [
        asked(written(Put, "/orders/0.2.0/interface/ab12", "t0k", d, framed(b"one"))),
        asked(written(Put, "/orders/0.2.0", "t0k", d, body)),
        asked(written(Put, "/orders/0.2.0/interface/ab12", "", d, framed(b"one"))),
        asked(written(Put, "/orders/0.2.0/interface/ab12", "t0k", d, framed(b"one"))),
        asked(get("/orders/0.2.0/interface/ab12")),
        asked(written(Put, "/orders/0.2.0/interface/ab12", "t0k", d, framed(b"one"))),
        asked(written(Put, "/orders/0.2.0/interface/ab12", "t0k", d, framed(b"two"))),
        asked(written(Put, "/orders/0.2.0/interface/cd34", "t0k", d, framed(b"one"))),
        asked(get("/orders/0.2.0/interface/..")),
        asked(get("/orders/0.2.0/interface/cd34")),
      ]));
  assert_eq(statuses(ran.value), [404, 201, 401, 201, 200, 200, 409, 422, 404, 404]);
  assert_eq(at(ran.value, 4).body, framed(b"one"))
}

fn a_seed(n: Int) -> Bytes / {abort.raise} =
  bytes_concat_all(map(range(0, 32), |i: Int| byte_of_int((i + n) % 256)))

fn an_attestation(digest: String) -> Attestation =
  {
    name: "orders",
    version: { major: 0, minor: 2, patch: 0 },
    archive: digest,
    semantics: "ab12",
    builder: "ply 0.0.0",
    checked: true,
    promises: true,
    tests: { passed: 1, failed: 0 },
    proofs: { proved: 0, property: 0, example: 0, fitted: 0, refuted: 0, unattempted: 0 },
  }

fn signed_by(seed: Bytes, a: Attestation) -> Bytes / {abort.raise} =
  signed_bytes(
    countersigned(
      { payload: bin::encode(a, attestation_bin()), signatures: [] },
      secret_of_bytes(seed),
    ),
  )

test "an attestation is kept when the registry's attester signed it, and a publish waits for one" {
  let body = twin::archive(twin::library("orders", 2));
  let d = archive_digest(body);
  let attester = hex_of(ed25519::public_key(secret_of_bytes(a_seed(1))));
  let ran = twin::over(fs::mem_empty(), ||
    twin::configured_with(
      [{ key: "attester", value: attester }, { key: "attest.key", value: "attester.key" }],
      ||
        [
          asked(written(Put, "/orders/0.2.0", "t0k", d, body)),
          asked(
            written(
              Put,
              "/orders/0.2.0/attestation/ab12",
              "",
              d,
              signed_by(a_seed(2), an_attestation(d)),
            ),
          ),
          asked(
            written(
              Put,
              "/orders/0.2.0/attestation/ab12",
              "",
              d,
              signed_by(a_seed(1), an_attestation("b3:other")),
            ),
          ),
          asked(
            written(
              Put,
              "/orders/0.2.0/attestation/ab12",
              "",
              d,
              signed_by(a_seed(1), an_attestation(d)),
            ),
          ),
          asked(get("/orders/0.2.0/attestation/ab12")),
        ],
    ));
  assert_eq(statuses(ran.value), [201, 403, 422, 201, 200]);
  assert_eq(at(ran.value, 4).body, signed_by(a_seed(1), an_attestation(d)));
  assert_eq(fs::mem_read(ran.tree, ".attest/orders@0.2.0"), Some(b""));
  let bare = twin::over(fs::mem_empty(), ||
    twin::configured(||
      [
        asked(written(Put, "/orders/0.2.0", "t0k", d, body)),
        asked(
          written(
            Put,
            "/orders/0.2.0/attestation/ab12",
            "",
            d,
            signed_by(a_seed(1), an_attestation(d)),
          ),
        ),
      ]));
  assert_eq(statuses(bare.value), [201, 403]);
  assert_eq(fs::mem_read(bare.tree, ".attest/orders@0.2.0"), None)
}

test "a write without a token, under another's, or with a digest its body does not seal changes nothing" {
  let body = twin::archive(twin::library("orders", 2));
  let d = archive_digest(body);
  let ran = twin::over(fs::mem_empty(), ||
    twin::configured(||
      [
        asked(written(Put, "/orders/0.2.0", "", d, body)),
        asked(written(Put, "/orders/0.2.0", "m0n", d, body)),
        asked(written(Put, "/orders/0.2.0", "t0k", "b3:00", body)),
        asked(written(Put, "/orders/0.2.0", "t0k", "", body)),
        asked(written(Put, "/orders/0.3.0", "t0k", d, body)),
      ]));
  assert_eq(statuses(ran.value), [401, 403, 422, 400, 422]);
  assert_eq(http::header(at(ran.value, 0).headers, "www-authenticate"), Some("Bearer"));
  assert_eq(fs::mem_read(ran.tree, "orders/index.json"), None)
}

test "a yank is one field of the index, made under the package's token" {
  let body = twin::archive(twin::library("orders", 2));
  let ran = twin::over(fs::mem_empty(), ||
    twin::configured(||
      [
        asked(written(Put, "/orders/0.2.0", "t0k", archive_digest(body), body)),
        asked(written(Post, "/orders/0.2.0/yank", "m0n", "", b"")),
        asked(written(Post, "/orders/0.2.0/yank", "t0k", "", b"")),
        asked(written(Post, "/orders/0.9.0/yank", "t0k", "", b"")),
        asked(get("/orders/index.json")),
        asked(get("/orders/0.2.0/package.plyz")),
      ]));
  assert_eq(statuses(ran.value), [201, 403, 200, 404, 200, 200]);
  assert_eq(map(index_in(at(ran.value, 4)).versions, |release: Release| release.yanked), [true]);
  assert_eq(at(ran.value, 5).body, body)
}

test "a path the layout does not hold is 404, and a method it does not take is 405" {
  let ran = twin::over(fs::mem_empty(), ||
    twin::configured(||
      [
        asked(get("/orders/index.json")),
        asked(get("/orders")),
        asked(get("/Orders/index.json")),
        asked(get("/orders/latest/package.plyz")),
        asked(written(Delete, "/orders/0.2.0", "t0k", "", b"")),
      ]));
  assert_eq(statuses(ran.value), [404, 404, 404, 404, 405])
}
