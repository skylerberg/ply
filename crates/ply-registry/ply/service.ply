// The registry over HTTP: the static layout a resolve reads, and the two writes a publisher makes.
//
//   GET  /<name>/index.json                     every version of <name>, newest last
//   GET  /<name>/<version>/package.plyz         the archive
//   GET  /<name>/<version>/package.plyz.b3      its digest, one `b3:<hex>` line
//   PUT  /<name>/<version>                      publish: the archive as the body
//   POST /<name>/<version>/yank                 mark the version yanked
//
// A write carries `Authorization: Bearer <token>`, and the token is the one `token.<name>` maps the
// package to in the run's configuration. It is served over `--tls` when `tls` names a credential,
// and as plain HTTP otherwise: behind a proxy that terminates TLS, or on this machine alone.

import compiler.pkg (is_dotted_path)
import std.config (config)
import std.fs
import std.fs (fs)
import std.http
import std.http (Delete, Get, Limits, Post, Put, Request, Response, default_limits,
                 method_not_allowed, request_to, set_header, text_response)
import std.net (net)
import std.json (decode_bytes)
import std.pkg (Index, Release, Version, index_json, parse_version, render_version)
import std.router
import std.router (Found, Literal, MethodNotAllowed, NotFound, Param, Route, param)
import store (Absent, Busy, Exists, Trouble, Unreadable, Unwritten, archive_path, digest_path,
              index_path, published, served, yank)
import twin
import upload (Refusal, allowed, judged)

type Endpoint = | IndexOf | ArchiveOf | DigestOf | Publish | Yank

fn table() -> List<Route<Endpoint>> =
  [
    { method: Get, path: [Param("name"), Literal("index.json")], endpoint: IndexOf },
    {
      method: Get,
      path: [Param("name"), Param("version"), Literal("package.plyz")],
      endpoint: ArchiveOf,
    },
    {
      method: Get,
      path: [Param("name"), Param("version"), Literal("package.plyz.b3")],
      endpoint: DigestOf,
    },
    { method: Put, path: [Param("name"), Param("version")], endpoint: Publish },
    { method: Post, path: [Param("name"), Param("version"), Literal("yank")], endpoint: Yank },
  ]

/// One request, answered from the store and the run's configuration and from nothing else.
pub fn answer(
  req: Request,
) -> Response / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], config.secret[tokens], abort.raise} =
  match router::route(table(), req.method, req.path) {
    NotFound -> text_response(404, "no such resource\n"),
    MethodNotAllowed(ms) -> method_not_allowed(ms),
    Found(hit) -> {
      let name = match param(hit.params, "name") { Some(n) -> n, None -> "" };
      let version = match param(hit.params, "version") {
        Some(v) -> parse_version(v),
        None -> None,
      };
      if !is_dotted_path(name) { text_response(404, "`" ++ name ++ "` is not a package name\n") }
      else {
        match hit.endpoint {
          IndexOf -> file(served(index_path(name)), "application/json"),
          ArchiveOf -> match version {
            None -> not_a_version(),
            Some(v) ->
              file(served(archive_path(name, render_version(v))), "application/octet-stream"),
          },
          DigestOf -> match version {
            None -> not_a_version(),
            Some(v) ->
              file(served(digest_path(name, render_version(v))), "text/plain; charset=utf-8"),
          },
          Publish -> match version { None -> not_a_version(), Some(v) -> publish(req, name, v) },
          Yank -> match version { None -> not_a_version(), Some(v) -> yanked(req, name, v) },
        }
      }
    },
  }

fn not_a_version() -> Response = text_response(404, "that is not a version such as `0.1.0`\n")

fn file(body: Option<Bytes>, kind: String) -> Response =
  match body {
    None -> text_response(404, "no such resource\n"),
    Some(b) ->
      { status: 200, headers: set_header(http::empty_headers(), "content-type", kind), body: b },
  }

fn refusal(r: Refusal) -> Response = {
  let base = text_response(r.status, r.reason ++ "\n");
  if r.status == 401 { { ..base, headers: set_header(base.headers, "www-authenticate", "Bearer") } }
  else { base }
}

fn trouble(t: Trouble, name: String, v: Version) -> Response =
  match t {
    Busy -> text_response(503, "another write to `" ++ name ++ "` holds its lock; try again\n"),
    Unreadable(why) -> text_response(500, why ++ "\n"),
    Unwritten(path) -> text_response(500, "`" ++ path ++ "` could not be written\n"),
    Exists ->
      text_response(
        409,
        "`" ++ name ++ "` " ++ render_version(v)
          ++ " is already published, and a published version never changes\n",
      ),
    Absent -> text_response(404, "`" ++ name ++ "` " ++ render_version(v) ++ " is not published\n"),
  }

fn publish(
  req: Request,
  name: String,
  v: Version,
) -> Response / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], config.secret[tokens], abort.raise} =
  match allowed(name, req.headers) {
    Err(r) -> refusal(r),
    Ok(_) -> match judged(name, v, http::header(req.headers, "x-ply-digest"), req.body) {
      Err(r) -> refusal(r),
      Ok(release) -> match published(name, release, req.body) {
        Err(t) -> trouble(t, name, v),
        Ok(_) ->
          text_response(
            201,
            "published `" ++ name ++ "` " ++ render_version(v) ++ " as " ++ release.digest ++ "\n",
          ),
      },
    },
  }

fn yanked(
  req: Request,
  name: String,
  v: Version,
) -> Response / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], config.secret[tokens], abort.raise} =
  match allowed(name, req.headers) {
    Err(r) -> refusal(r),
    Ok(_) -> match yank(name, v) {
      Err(t) -> trouble(t, name, v),
      Ok(_) -> text_response(200, "yanked `" ++ name ++ "` " ++ render_version(v) ++ "\n"),
    },
  }

// --- The service ------------------------------------------------------------------

// An archive is a package's sources and its compiled unit: larger than a page, bounded all the same.
fn limits() -> Limits = {
  let base = default_limits();
  { ..base, max_body: 67108864 }
}

fn port() -> Int / {config.get[server], abort.raise} =
  match config.get[server]("port") {
    None -> 8080,
    Some(text) -> match router::int_of_text(text) {
      Some(n) -> n,
      None -> panic("the registry will not start: `port` is `" ++ text ++ "`, which is not a port"),
    },
  }

// Every connection, one at a time, until accepting stops: a signal to the run ends it there.
fn accepting(
  listener: Int,
) -> Unit / {net.accept[listener], net.recv[conn], net.send[conn], net.close[conn], fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], config.secret[tokens], abort.raise} = {
  let c = net.accept[listener](listener);
  if c == 0 { () } else {
    http::serve_connection[conn](c, limits(), answer);
    accepting(listener)
  }
}

fn main() -> Unit / {config.get[server], config.secret[tokens], net.listen[listener], net.listen_tls[listener], net.accept[listener], net.close[listener], net.recv[conn], net.send[conn], net.close[conn], fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], abort.raise} = {
  let listener = match config.get[server]("tls") {
    None -> net.listen[listener](port()),
    Some(credential) -> net.listen_tls[listener](port(), credential),
  };
  accepting(listener);
  net.close[listener](listener)
}

// --- Tests ------------------------------------------------------------------

fn get(target: String) -> Request / {abort.raise} = request_to(Get, "registry.test", target, b"")

fn written(
  method: http::Method,
  target: String,
  token: String,
  digest: String,
  body: Bytes,
) -> Request / {abort.raise} = {
  let req = request_to(method, "registry.test", target, body);
  let authed = if token == "" { req.headers }
  else { set_header(req.headers, "authorization", "Bearer " ++ token) };
  { ..req, headers: if digest == "" { authed } else { set_header(authed, "x-ply-digest", digest) } }
}

fn statuses(rs: List<Response>) -> List<Int> = map(rs, |r: Response| r.status)

fn nth(rs: List<Response>, i: Int) -> Response / {abort.raise} =
  match list_at(rs, i) { Some(r) -> r, None -> panic("an answer the test did not ask for") }

fn index_in(r: Response) -> Index / {abort.raise} =
  match decode_bytes(r.body, index_json()) {
    Ok(x) -> x,
    Err(_) -> panic("the index does not read"),
  }

test "a publish is served back as the static layout a resolve reads" {
  let body = twin::archive(twin::library("orders", 2));
  let d = twin::digest(body);
  let ran = twin::over(fs::mem_empty(), ||
    twin::configured(||
      [
        answer(written(Put, "/orders/0.2.0", "t0k", d, body)),
        answer(get("/orders/index.json")),
        answer(get("/orders/0.2.0/package.plyz")),
        answer(get("/orders/0.2.0/package.plyz.b3")),
        answer(written(Put, "/orders/0.2.0", "t0k", d, body)),
      ]));
  assert_eq(statuses(ran.value), [201, 200, 200, 200, 409]);
  let listed = index_in(nth(ran.value, 1));
  assert_eq(listed.name, "orders");
  assert_eq(map(listed.versions, |r: Release| r.digest), [d]);
  assert_eq(nth(ran.value, 2).body, body);
  assert_eq(nth(ran.value, 3).body, bytes_of_string(d ++ "\n"));
  assert_eq(http::header(nth(ran.value, 1).headers, "content-type"), Some("application/json"))
}

test "a write without a token, under another's, or with a digest its body does not seal changes nothing" {
  let body = twin::archive(twin::library("orders", 2));
  let d = twin::digest(body);
  let ran = twin::over(fs::mem_empty(), ||
    twin::configured(||
      [
        answer(written(Put, "/orders/0.2.0", "", d, body)),
        answer(written(Put, "/orders/0.2.0", "m0n", d, body)),
        answer(written(Put, "/orders/0.2.0", "t0k", "b3:00", body)),
        answer(written(Put, "/orders/0.2.0", "t0k", "", body)),
        answer(written(Put, "/orders/0.3.0", "t0k", d, body)),
      ]));
  assert_eq(statuses(ran.value), [401, 403, 422, 400, 422]);
  assert_eq(http::header(nth(ran.value, 0).headers, "www-authenticate"), Some("Bearer"));
  assert_eq(fs::mem_read(ran.tree, "orders/index.json"), None)
}

test "a yank is one field of the index, made under the package's token" {
  let body = twin::archive(twin::library("orders", 2));
  let ran = twin::over(fs::mem_empty(), ||
    twin::configured(||
      [
        answer(written(Put, "/orders/0.2.0", "t0k", twin::digest(body), body)),
        answer(written(Post, "/orders/0.2.0/yank", "m0n", "", b"")),
        answer(written(Post, "/orders/0.2.0/yank", "t0k", "", b"")),
        answer(written(Post, "/orders/0.9.0/yank", "t0k", "", b"")),
        answer(get("/orders/index.json")),
        answer(get("/orders/0.2.0/package.plyz")),
      ]));
  assert_eq(statuses(ran.value), [201, 403, 200, 404, 200, 200]);
  assert_eq(map(index_in(nth(ran.value, 4)).versions, |r: Release| r.yanked), [true]);
  assert_eq(nth(ran.value, 5).body, body)
}

test "a path the layout does not hold is 404, and a method it does not take is 405" {
  let ran = twin::over(fs::mem_empty(), ||
    twin::configured(||
      [
        answer(get("/orders/index.json")),
        answer(get("/orders")),
        answer(get("/Orders/index.json")),
        answer(get("/orders/latest/package.plyz")),
        answer(written(Delete, "/orders/0.2.0", "t0k", "", b"")),
      ]));
  assert_eq(statuses(ran.value), [404, 404, 404, 404, 405])
}
