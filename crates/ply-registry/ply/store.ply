// The registry's tree, under the root `--fs store=DIR` binds: a directory per package holding its
// `index.json`, and a directory per version holding the archive, the line naming its digest, and
// the interface its publisher cut under each semantics.
//
//   <name>/index.json
//   <name>/<version>/package.plyz
//   <name>/<version>/package.plyz.b3
//   <name>/<version>/interface/<semantics>
//   <name>/<version>/attestation/<semantics>
//   .attest/<name>@<version>                 a version published since an attester last ran
//
// Every write goes through here, and a version is published by the index write that lists it: an
// archive the index does not list is one a publish did not finish, and the next publish of that
// version writes over it.

import std.fs
import std.fs (fs)
import std.json (decode_bytes, error_to_string, to_bytes)
import std.pkg (Index, Release, Version, index_json, parse_version, render_version, release_at)
import twin
import std.option (option_expect)

pub fn index_path(name: String) -> String = name ++ "/index.json"

pub fn archive_path(name: String, version: String) -> String =
  name ++ "/" ++ version ++ "/package.plyz"

pub fn digest_path(name: String, version: String) -> String = archive_path(name, version) ++ ".b3"

fn interface_dir(name: String, version: String) -> String = name ++ "/" ++ version ++ "/interface"

pub fn interface_path(name: String, version: String, semantics: String) -> String =
  interface_dir(name, version) ++ "/" ++ semantics

fn attestation_dir(name: String, version: String) -> String =
  name ++ "/" ++ version ++ "/attestation"

pub fn attestation_path(name: String, version: String, semantics: String) -> String =
  attestation_dir(name, version) ++ "/" ++ semantics

// Beside the index, so a lock never needs a directory of its own; no route reads it.
fn lock_path(name: String) -> String = name ++ "/index.lock"

/// A file as the static layout serves it, or `None` for one that is not there.
pub fn served(path: String) -> Option<Bytes> / {fs.read_file[store]} = fs.read_file[store](path)

/// The package's index: `None` for a name nothing was published under, `Err` for an index that does
/// not read, which a write must not paper over with a fresh one.
pub fn index_of(
  name: String,
) -> Result<Option<Index>, String> / {fs.read_file[store], abort.raise} =
  match fs.read_file[store](index_path(name)) {
    None -> Ok(None),
    Some(bytes) -> match decode_bytes(bytes, index_json()) {
      Err(e) -> Err("`" ++ index_path(name) ++ "` does not read: " ++ error_to_string(e)),
      Ok(x) -> Ok(Some(x)),
    },
  }

/// The index with one more version, newest last: publication order, which is what a reader of
/// the index can rely on, whatever the version numbers say.
pub fn appended(index: Index, release: Release) -> Index =
  { ..index, versions: push(index.versions, release) }

/// The index with one version yanked, every other field of every version as it was.
pub fn yanked(index: Index, version: Version) -> Index =
  {
    ..index,
    versions: map(index.versions, |release: Release|
      if release.version == version { { ..release, yanked: true } } else { release }),
  }

// --- Writing ------------------------------------------------------------------------

pub type Trouble = | Busy | Unreadable(String) | Unwritten(String) | Exists | Absent

// Written beside its place and renamed into it, so a reader sees the old file or the new one.
fn replaced(path: String, body: Bytes) -> Bool / {fs.write_file[store], fs.rename[store]} = {
  let staged = path ++ ".tmp";
  fs.write_file[store](staged, body) && fs.rename[store](staged, path)
}

// One writer of a package at a time, whichever process it is.
fn locked<a | e>(
  name: String,
  f: () -> Result<a, Trouble> / e,
) -> Result<a, Trouble> / {fs.create_dir[store], fs.lock[store], fs.unlock[store] | e} =
  if !fs.create_dir[store](name) { Err(Unwritten(name)) }
  else if !fs.lock[store](lock_path(name)) { Err(Busy) } else {
    let answer = f();
    fs.unlock[store](lock_path(name));
    answer
  }

/// A version published: the archive and its digest line written, then the index that lists it.
/// A version the index already lists is refused unless it is these bytes again, which is the
/// publish it already holds: a version never changes. `fresh` says whether this one wrote it.
pub fn published(
  name: String,
  release: Release,
  archive: Bytes,
) -> Result<{ index: Index, fresh: Bool }, Trouble> / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], abort.raise} =
  locked(name, || {
    let version = render_version(release.version);
    match index_of(name) {
      Err(why) -> Err(Unreadable(why)),
      Ok(held) -> {
        let before = match held { Some(x) -> x, None -> { name: name, versions: [] } };
        match release_at(before, release.version) {
          Some(listed) -> if listed.digest == release.digest { Ok({ index: before, fresh: false }) }
          else { Err(Exists) },
          None -> {
            let after = appended(before, release);
            if !fs.create_dir[store](name ++ "/" ++ version) {
              Err(Unwritten(name ++ "/" ++ version))
            } else if !replaced(archive_path(name, version), archive) {
              Err(Unwritten(archive_path(name, version)))
            } else if !replaced(
                digest_path(name, version),
                bytes_of_string(release.digest ++ "\n"),
              ) { Err(Unwritten(digest_path(name, version))) }
            else if !replaced(index_path(name), to_bytes(index_json().encode(after))) {
              Err(Unwritten(index_path(name)))
            } else { Ok({ index: after, fresh: true }) }
          },
        }
      },
    }
  })

/// The interface of a published version under one semantics. It is a function of the archive and
/// the semantics, so the same bytes again are the one it holds and other bytes are refused.
pub fn interfaced(
  name: String,
  v: Version,
  semantics: String,
  body: Bytes,
) -> Result<Bool, Trouble> / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], abort.raise} =
  locked(name, ||
    match index_of(name) {
      Err(why) -> Err(Unreadable(why)),
      Ok(None) -> Err(Absent),
      Ok(Some(x)) -> match release_at(x, v) {
        None -> Err(Absent),
        Some(_) -> {
          let version = render_version(v);
          let path = interface_path(name, version, semantics);
          match fs.read_file[store](path) {
            Some(held) -> if held == body { Ok(false) } else { Err(Exists) },
            None -> if !fs.create_dir[store](interface_dir(name, version)) {
              Err(Unwritten(interface_dir(name, version)))
            } else if replaced(path, body) { Ok(true) }
            else { Err(Unwritten(path)) },
          }
        },
      },
    })

/// A published version's attestation under one semantics. A later one stands in for an earlier: an
/// attester's run of the same version again is its newer word.
pub fn attestation_kept(
  name: String,
  v: Version,
  semantics: String,
  body: Bytes,
) -> Result<Unit, Trouble> / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], abort.raise} =
  locked(name, ||
    match index_of(name) {
      Err(why) -> Err(Unreadable(why)),
      Ok(None) -> Err(Absent),
      Ok(Some(x)) -> match release_at(x, v) {
        None -> Err(Absent),
        Some(_) -> {
          let version = render_version(v);
          let path = attestation_path(name, version, semantics);
          if !fs.create_dir[store](attestation_dir(name, version)) {
            Err(Unwritten(attestation_dir(name, version)))
          } else if replaced(path, body) { Ok(()) }
          else { Err(Unwritten(path)) }
        },
      },
    })

// --- Versions waiting for an attester ---------------------------------------------------

fn pending_dir() -> String = ".attest"

/// A version marked for the attester, which the accept loop starts on it in its turn.
pub fn marked(
  name: String,
  version: String,
) -> Bool / {fs.create_dir[store], fs.write_file[store]} =
  fs.create_dir[store](pending_dir())
    && fs.write_file[store](pending_dir() ++ "/" ++ name ++ "@" ++ version, b"")

pub type Pending = { name: String, version: String }

/// Every version waiting for the attester, in the order the directory lists them.
pub fn pending() -> List<Pending> / {fs.list_dir[store], abort.raise} =
  match fs.list_dir[store](pending_dir()) {
    None -> [],
    Some(names) ->
      fold(names, [], |acc: List<Pending>, n: String|
        match string_split(n, "@") {
          [name, version] -> push(acc, { name: name, version: version }),
          _ -> acc,
        }),
  }

pub fn unmarked(p: Pending) -> Bool / {fs.remove[store]} =
  fs.remove[store](pending_dir() ++ "/" ++ p.name ++ "@" ++ p.version)

/// A version yanked. Yanking one already yanked is the same answer, and the archive is untouched.
pub fn yank(
  name: String,
  version: Version,
) -> Result<Index, Trouble> / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], abort.raise} =
  locked(name, ||
    match index_of(name) {
      Err(why) -> Err(Unreadable(why)),
      Ok(None) -> Err(Absent),
      Ok(Some(x)) -> match release_at(x, version) {
        None -> Err(Absent),
        Some(_) -> {
          let after = yanked(x, version);
          if replaced(index_path(name), to_bytes(index_json().encode(after))) { Ok(after) }
          else { Err(Unwritten(index_path(name))) }
        },
      },
    })

// --- Tests ------------------------------------------------------------------

fn a_release(version: String) -> Release / {abort.raise} =
  {
    version: option_expect(parse_version(version), "a fixture's version"),
    digest: "b3:" ++ version,
    yanked: false,
    runtime: option_expect(parse_version("0.16.0"), "a fixture's version"),
  }

fn versions_of(index: Index) -> List<String> =
  map(index.versions, |release: Release|
    render_version(release.version) ++ (if release.yanked { " yanked" } else { "" }))

test "a publish writes the archive and its digest line, and the index lists it newest last" {
  let ran = twin::over(fs::mem_empty(), || {
    let first = published("orders", a_release("0.2.0"), b"two");
    let second = published("orders", a_release("0.1.1"), b"backport");
    (first, second)
  });
  match ran.value {
    (Ok(_), Ok(x)) -> {
      assert_eq(versions_of(x.index), ["0.2.0", "0.1.1"]);
      assert(x.fresh)
    },
    _ -> panic("two new versions were refused"),
  };
  assert_eq(fs::mem_read(ran.tree, "orders/0.2.0/package.plyz"), Some(b"two"));
  assert_eq(fs::mem_read(ran.tree, "orders/0.1.1/package.plyz.b3"), Some(b"b3:0.1.1\n"));
  match fs::mem_read(ran.tree, "orders/index.json") {
    None -> panic("no index was written"),
    Some(bytes) -> assert(string_contains(string_of_bytes_lossy(bytes), "\"version\":\"0.1.1\"")),
  }
}

test "a version is published once: the same bytes again are what it holds, other bytes are refused" {
  let ran = twin::over(fs::mem_empty(), || {
    let first = published("orders", a_release("0.2.0"), b"two");
    let same = published("orders", a_release("0.2.0"), b"two");
    let other = published("orders", { ..a_release("0.2.0"), digest: "b3:other" }, b"other");
    (first, same, other)
  });
  match ran.value {
    (Ok(a), Ok(b), Err(Exists)) -> {
      assert(a.fresh);
      assert(!b.fresh);
      assert_eq(a.index, b.index)
    },
    _ -> panic("a published version was published again"),
  };
  assert_eq(fs::mem_read(ran.tree, "orders/0.2.0/package.plyz"), Some(b"two"))
}

test "an interface is kept beside a published version, once per semantics" {
  let ran = twin::over(fs::mem_empty(), || {
    let unpublished = interfaced(
      "orders",
      option_expect(parse_version("0.2.0"), "a fixture's version"),
      "s1",
      b"iface",
    );
    published("orders", a_release("0.2.0"), b"two");
    let first = interfaced(
      "orders",
      option_expect(parse_version("0.2.0"), "a fixture's version"),
      "s1",
      b"iface",
    );
    let same = interfaced(
      "orders",
      option_expect(parse_version("0.2.0"), "a fixture's version"),
      "s1",
      b"iface",
    );
    let other = interfaced(
      "orders",
      option_expect(parse_version("0.2.0"), "a fixture's version"),
      "s1",
      b"other",
    );
    let later = interfaced(
      "orders",
      option_expect(parse_version("0.2.0"), "a fixture's version"),
      "s2",
      b"later",
    );
    (unpublished, first, same, other, later)
  });
  match ran.value {
    (Err(Absent), Ok(true), Ok(false), Err(Exists), Ok(true)) -> (),
    _ -> panic("an interface was not kept as it should be"),
  };
  assert_eq(fs::mem_read(ran.tree, "orders/0.2.0/interface/s1"), Some(b"iface"));
  assert_eq(fs::mem_read(ran.tree, "orders/0.2.0/interface/s2"), Some(b"later"))
}

test "a yank sets one field and keeps the archive; a version never published cannot be yanked" {
  let ran = twin::over(fs::mem_empty(), || {
    published("orders", a_release("0.1.0"), b"one");
    published("orders", a_release("0.2.0"), b"two");
    let once = yank("orders", option_expect(parse_version("0.1.0"), "a fixture's version"));
    let twice = yank("orders", option_expect(parse_version("0.1.0"), "a fixture's version"));
    let absent = yank("orders", option_expect(parse_version("9.9.9"), "a fixture's version"));
    let unknown = yank("billing", option_expect(parse_version("0.1.0"), "a fixture's version"));
    (once, twice, absent, unknown)
  });
  match ran.value {
    (Ok(x), Ok(y), Err(Absent), Err(Absent)) -> {
      assert_eq(versions_of(x), ["0.1.0 yanked", "0.2.0"]);
      assert_eq(x, y)
    },
    _ -> panic("a yank did not answer as it should"),
  };
  assert_eq(fs::mem_read(ran.tree, "orders/0.1.0/package.plyz"), Some(b"one"))
}

test "an index that does not read is never written over" {
  let start = fs::mem_of([{ path: "orders/index.json", body: b"{ not json" }]);
  let ran = twin::over(start, || published("orders", a_release("0.2.0"), b"two"));
  match ran.value {
    Err(Unreadable(why)) -> assert(string_contains(why, "orders/index.json")),
    _ -> panic("an unreadable index was replaced"),
  };
  assert_eq(fs::mem_read(ran.tree, "orders/index.json"), Some(b"{ not json"))
}
