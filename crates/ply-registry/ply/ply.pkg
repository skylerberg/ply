import std.pkg (Manifest)

// The registry: the service `ply publish`, `ply yank` and `ply resolve` talk to. A directory of
// files behind an HTTP server — every package's `index.json`, and each version's archive and its
// digest — which a publish appends to and nothing rewrites.
fn package() -> Manifest = {
  name: "registry",
  version: { major: 0, minor: 1, patch: 0 },
  prefix: None,
  runtime: { major: 0, minor: 16, patch: 0 },
  dependencies: [],
  entry: None,
}
