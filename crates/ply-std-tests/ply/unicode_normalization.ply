//! `std.unicode`'s normalization against `NormalizationTest.txt`, the database's conformance test
//! of the four forms: every line of every part, a few hundred lines to a case, and the rule the
//! file states for the code points it does not list. The quick checks are held to
//! `DerivedNormalizationProps.txt` over every code point, since a check that says `Yes` too often
//! answers a text unchanged.

import std.list
import std.unicode
import std.unicode (Form, Maybe, Nfc, Nfd, Nfkc, Nfkd, No, Quick, Yes)
import ucd_files
import ucd_files (Block, Row, Span, Stretch, hexes, rows_under, spelled, text, unlike, unlisted)

/// A line of the test: a source text and what each form makes of it.
pub type Line = { source: String, nfc: String, nfd: String, nfkc: String, nfkd: String }

/// Every line of every part of the test.
pub fn lines() -> List<Line> / {abort.raise} =
  ucd_files::normalization_test().split(b"\n").fold([], |found: List<Line>, line: Bytes|
    if line.len() == 0 || line.at(0) == b'#' || line.at(0) == b'@' { found } else {
      match line.split(b";").take(5).map(|column: Bytes| text(hexes(column))) {
        [source, nfc, nfd, nfkc, nfkd] ->
          found.push({ source: source, nfc: nfc, nfd: nfd, nfkc: nfkc, nfkd: nfkd }),
        _ -> panic(f"`{String::of_bytes_lossy(line)}` is no line of the test"),
      }
    })

/// Whether the four forms of a line's five texts are what the test's conformance clause says.
fn conforms(l: Line) -> Bool = {
  let all = [l.source, l.nfc, l.nfd, l.nfkc, l.nfkd];
  [l.source, l.nfc, l.nfd].map(unicode::nfc) == [l.nfc, l.nfc, l.nfc]
    && [l.nfkc, l.nfkd].map(unicode::nfc) == [l.nfkc, l.nfkc]
    && [l.source, l.nfc, l.nfd].map(unicode::nfd) == [l.nfd, l.nfd, l.nfd]
    && [l.nfkc, l.nfkd].map(unicode::nfd) == [l.nfkd, l.nfkd]
    && all.map(unicode::nfkc) == all.map(|_: String| l.nfkc)
    && all.map(unicode::nfkd) == all.map(|_: String| l.nfkd)
}

fn blocks() -> List<Block<Line>> / {abort.raise} =
  ucd_files::blocks(lines(), 256, |l: Line| spelled(l.source))

test "the {b.lines.len()} lines of NormalizationTest.txt from {b.from} normalize as they say" for b: Block<Line> in blocks(
  ) { assert_eq(b.lines.filter(|l: Line| !conforms(l)).map(|l: Line| spelled(l.source)), []) }

// Nothing composes with `U+0000` or is ordered across it, so a text of them is normal when each is.
test "a code point the test does not list is its own normal form in all four" {
  let listed = lines().fold(Map::new(), |seen: Map<Int, Unit>, c: Line|
    match c.source.chars() { [one] -> seen.insert(Int::of_char(one), ()), _ -> seen }).keys(
  ).map(|cp: Int| { first: cp, last: cp, said: () });
  assert(listed.len() > 10000);
  let moved = unlisted(listed, 4096).filter(|span: Span| {
    let apart = text(range(span.first, span.last + 1).flat_map(|cp: Int| [0, cp]));
    unicode::nfc(apart) != apart || unicode::nfd(apart) != apart || unicode::nfkc(apart) != apart
      || unicode::nfkd(apart) != apart
  });
  assert_eq(moved, [])
}

type Check = { property: String, form: Form }

fn checks() -> List<Check> =
  [
    { property: "NFC_QC", form: Nfc },
    { property: "NFD_QC", form: Nfd },
    { property: "NFKC_QC", form: Nfkc },
    { property: "NFKD_QC", form: Nfkd },
  ]

test "the quick check of every one-character text is the database's {c.property}" for c: Check in checks(
  ) {
  let props = ucd_files::derived_normalization_props();
  let valued = |value: String, said: Quick|
    rows_under(props, [c.property, value]).map(|row: Row|
      { first: row.first, last: row.last, said: said });
  let stretches = valued("M", Maybe).fold(
    valued("N", No),
    |all: List<Stretch<Quick>>, s: Stretch<Quick>| all.push(s),
  ).sort_by(|a: Stretch<Quick>, b: Stretch<Quick>| a.first < b.first);
  assert(stretches.len() > 0);
  // A surrogate is in no text.
  let wrong = unlike(stretches, |cp: Int, said: Option<Quick>|
    (cp >= 0xD800 && cp <= 0xDFFF)
      || unicode::quick_check(text([cp]), c.form)
      == (match said { Some(quick) -> quick, None -> Yes }));
  assert_eq(wrong, [])
}
