//! `std.xml` against the W3C XML Conformance Test Suite (xmlts20130923): the cases its catalogs list
//! for XML 1.0 Fifth Edition, under `xml/` by what a reader that refuses a document type declaration
//! owes each. James Clark's `xmltest` collection is not among them: it may be passed on only whole.
//!
//! `not_wf` is what the suite calls not well formed, which is refused however it is read; `wf` is the
//! rest, what it calls valid or invalid and the errors it lets a reader pass over, all of it well
//! formed. `plain` holds no declaration. `declared` holds one, and a well-formed document that does
//! is refused as `Doctype` and for nothing else. `cut` holds one that declares only elements and
//! CDATA attributes with no default, so the document reads the same without it: each is read again
//! with the declaration cut out, where a well-formed one must be read and a `not_wf` one must still
//! be refused. `encoded` is in an encoding the module names and does not read, and `unnamespaced` is
//! well formed as XML 1.0 and not as Namespaces in XML.
//!
//! `canonical` is no file of the suite. It holds, for each well-formed `plain` and `cut` case and
//! under the same path, the suite's first canonical form of the document as another parser reads
//! it: expat, through Python's `xml.parsers.expat`, with the declaration cut out first as it is
//! here. That form is James Clark's Canonical XML: no XML declaration and no comment, each start tag
//! with its attributes in the order of their names, a namespace declaration among them as the
//! attribute it is written as, an empty element as a start tag and an end tag, and `&`, `<`, `>`
//! and `"` written as `&amp;`, `&lt;`, `&gt;` and `&quot;`, tab, line feed and carriage return as
//! `&#9;`, `&#10;` and `&#13;`. Expat reads a name as the editions before the fifth do, so the cases
//! that turn on a fifth-edition name have no such file, and are read and written back all the same.
//!
//! `ours` are documents written for this module: the mistakes that only a case of `xmltest` made.

import std.bytes
import std.bytes (scan)
import std.list (sort)
import std.xml
import std.xml (Aside, Attribute, BadAttribute, BadMarkup, BadName, BadReference, BadTag, Binding,
                CDataEnd, Characters, Comment, Compact, Doctype, DoubleHyphen, DuplicateAttribute,
                Encoding, EndElement, Event, IllegalChar, IllegalReference, Instruction,
                LessThanInValue, Mismatched, Name, NotUtf8, OutsideRoot, Start, StartElement,
                Truncated, UnknownEntity, Why, XmlDeclaration, xml)

type Case = { name: String, bytes: Bytes }

type Formed = { name: String, bytes: Bytes, canonical: Option<Bytes> }

type Ours = { name: String, text: Bytes, why: Why }

fn not_wf_plain() -> List<Case> = embed_dir("xml/not_wf/plain")

fn not_wf_cut() -> List<Case> = embed_dir("xml/not_wf/cut")

fn not_wf_declared() -> List<Case> = embed_dir("xml/not_wf/declared")

fn wf_plain() -> List<Formed> = with_canonical(embed_dir("xml/wf/plain"))

fn wf_cut() -> List<Formed> = with_canonical(embed_dir("xml/wf/cut"))

fn wf_declared() -> List<Case> = embed_dir("xml/wf/declared")

fn wf_encoded() -> List<Case> = embed_dir("xml/wf/encoded")

fn wf_unnamespaced() -> List<Case> = embed_dir("xml/wf/unnamespaced")

fn canonical_forms() -> Map<String, Bytes> = {
  let forms: List<Case> = embed_dir("xml/canonical");
  map_of_entries(map(forms, |c: Case| { key: c.name, value: c.bytes }))
}

fn with_canonical(cases: List<Case>) -> List<Formed> = {
  let forms = canonical_forms();
  map(cases, |c: Case| { name: c.name, bytes: c.bytes, canonical: map_get(forms, c.name) })
}

fn ours() -> List<Ours> =
  [
    { name: "an attribute with no value", text: b"<a b></a>", why: BadAttribute },
    {
      name: "an attribute with an equals sign and no value",
      text: b"<a b=></a>",
      why: BadAttribute,
    },
    { name: "a value with no quotes", text: b"<a b=c></a>", why: BadAttribute },
    { name: "a less-than sign before a space in text", text: b"<a>1 < 2</a>", why: BadMarkup },
    { name: "a quoted value with no name before it", text: b"<a b=\"1\" \"2\"></a>", why: BadName },
    { name: "an instruction with no target", text: b"<a><? ?></a>", why: BadName },
    { name: "a question mark where an attribute's name stands", text: b"<a ?></a>", why: BadName },
    { name: "an attribute named from a digit", text: b"<a 1b=\"c\"/>", why: BadName },
    {
      name: "an ampersand and a name with no semicolon, in a value",
      text: b"<a b=\"c&d\"/>",
      why: BadReference,
    },
    { name: "a numbered reference ended by a colon", text: b"<a b=\"&#65:\"/>", why: BadReference },
    { name: "an entity named from a full stop", text: b"<a>&.b;</a>", why: BadReference },
    {
      name: "an entity reference with a space for its semicolon",
      text: b"<a>&amp b</a>",
      why: BadReference,
    },
    { name: "an ampersand alone in text", text: b"<a>b & c</a>", why: BadReference },
    { name: "an ampersand alone in a value", text: b"<a b=\"c & d\"/>", why: BadReference },
    { name: "an empty-element tag cut short by another tag", text: b"<a><b/</b></a>", why: BadTag },
    { name: "an empty-element tag cut short by a line end", text: b"<a><b/\n</a>", why: BadTag },
    { name: "attributes with no space between", text: b"<a b=\"1\"c=\"2\"/>", why: BadTag },
    { name: "a space inside the end of an empty-element tag", text: b"<a><b / ></a>", why: BadTag },
    { name: "a CDATA end as the whole of an element's text", text: b"<a>]]></a>", why: CDataEnd },
    {
      name: "three brackets and a greater-than sign in text",
      text: b"<a>b]]]>c</a>",
      why: CDataEnd,
    },
    { name: "two hyphens inside a comment", text: b"<a><!-- b -- c --></a>", why: DoubleHyphen },
    { name: "a comment ended by three hyphens", text: b"<!-- b ---><a/>", why: DoubleHyphen },
    {
      name: "an attribute written twice with another between",
      text: b"<a b=\"1\" c=\"2\" b=\"3\"/>",
      why: DuplicateAttribute("b"),
    },
    { name: "U+FFFF in a comment", text: b"<!-- \xef\xbf\xbf --><a/>", why: IllegalChar(0xFFFF) },
    { name: "U+FFFF in a value", text: b"<a b=\"\xef\xbf\xbf\"/>", why: IllegalChar(0xFFFF) },
    { name: "U+FFFF in text", text: b"<a>b\xef\xbf\xbf</a>", why: IllegalChar(0xFFFF) },
    {
      name: "U+FFFF in a CDATA section",
      text: b"<a><![CDATA[\xef\xbf\xbf]]></a>",
      why: IllegalChar(0xFFFF),
    },
    { name: "U+FFFF in an instruction", text: b"<?b \xef\xbf\xbf?><a/>", why: IllegalChar(0xFFFF) },
    { name: "a form feed in text", text: b"<a>b\x0cc</a>", why: IllegalChar(12) },
    { name: "a form feed in an instruction", text: b"<?b c\x0cd?><a/>", why: IllegalChar(12) },
    { name: "a form feed in a comment", text: b"<!--b\x0cc--><a/>", why: IllegalChar(12) },
    { name: "a form feed for the space in a tag", text: b"<a\x0cb=\"c\"/>", why: IllegalChar(12) },
    { name: "an escape character in text", text: b"<a>b\x1bc</a>", why: IllegalChar(27) },
    { name: "a reference to a surrogate", text: b"<a>&#xD800;</a>", why: IllegalReference(0xD800) },
    { name: "a value closed by the other quote", text: b"<a b=\"c'></a>", why: LessThanInValue },
    {
      name: "a value closed by a reference to its quote",
      text: b"<a b=\"&#34;></a>",
      why: LessThanInValue,
    },
    { name: "a tag in a value", text: b"<a b=\"<c>\"/>", why: LessThanInValue },
    {
      name: "an end tag for an element never opened, after an empty CDATA section",
      text: b"<a><![CDATA[]]></b></a>",
      why: Mismatched("a"),
    },
    {
      name: "four bytes that encode past U+10FFFF",
      text: b"<a>\xf7\x80\x80\x80</a>",
      why: NotUtf8,
    },
    { name: "an end tag after an empty-element root", text: b"<a/></a>", why: OutsideRoot },
    { name: "a CDATA section never closed", text: b"<a><![CDATA[b</a>", why: Truncated },
    {
      name: "an instruction ended by a greater-than sign alone",
      text: b"<a><?b c></a>",
      why: Truncated,
    },
    {
      name: "an instruction ended by a question mark alone",
      text: b"<a><?b c?</a>",
      why: Truncated,
    },
    { name: "an entity nothing declares, in text", text: b"<a>&b;</a>", why: UnknownEntity("b") },
    {
      name: "an entity nothing declares, in a value",
      text: b"<a c=\"&b;\"/>",
      why: UnknownEntity("b"),
    },
  ]

fn limits() -> xml::Limits = xml::default_limits()

fn why(data: Bytes) -> Option<Why> / {abort.raise} =
  match xml::parse(data, limits()) { Ok(_) -> None, Err(refusal) -> Some(refusal.why) }

fn refused(data: Bytes) -> Bool / {abort.raise} = why(data) != None

/// `data` without its document type declaration: up to the `>` after its `]` where it has an
/// internal subset, and up to its first `>` where it has none.
fn cut(data: Bytes) -> Bytes / {abort.raise} =
  match bytes_index_of(data, b"<!DOCTYPE") {
    None -> data,
    Some(i) -> {
      let n = bytes_len(data);
      let opening = match bytes_index_of_from(data, b"[", i) { Some(at) -> at, None -> n };
      let closing = match bytes_index_of_from(data, b">", i) { Some(at) -> at, None -> n };
      let end = if opening < closing {
        match bytes_index_of_from(data, b"]", opening) {
          Some(at) -> scan(data, at + 1, b" \t\n\r") + 1,
          None -> n,
        }
      } else { closing + 1 };
      bytes_concat(bytes_slice(data, 0, i), bytes_slice(data, min(end, n), n))
    },
  }

/// What the suite's first canonical form escapes, in text and in a value alike.
fn datachars(text: String) -> Bytes / {abort.raise} =
  fold(
    [
      { raw: b"&", written: b"&amp;" },
      { raw: b"<", written: b"&lt;" },
      { raw: b">", written: b"&gt;" },
      { raw: b"\"", written: b"&quot;" },
      { raw: b"\t", written: b"&#9;" },
      { raw: b"\n", written: b"&#10;" },
      { raw: b"\r", written: b"&#13;" },
    ],
    bytes_of_string(text),
    |b: Bytes, e: { raw: Bytes, written: Bytes }| bytes::replace(b, e.raw, e.written),
  )

fn as_written(n: Name) -> String =
  if xml::spelled(n.prefix) == "" { n.local } else { xml::spelled(n.prefix) ++ ":" ++ n.local }

/// A start tag as the canonical form has it: its attributes and its namespace declarations, which
/// that form knows only as attributes, in the order of their names as written.
fn start_tag(s: Start) -> Bytes / {abort.raise} = {
  let declared = map(s.declared, |b: Binding|
    (if b.prefix == "" { "xmlns" } else { "xmlns:" ++ b.prefix }, b.namespace));
  let attributes = map(s.attributes, |a: Attribute| (as_written(a.name), a.value));
  bytes_concat_all([
    b"<",
    bytes_of_string(as_written(s.name)),
    bytes_concat_all(
      map(
        sort(
          fold(attributes, declared, |all: List<(String, String)>, a: (String, String)|
            push(all, a)),
        ),
        |a: (String, String)|
          bytes_concat_all([b" ", bytes_of_string(a._0), b"=\"", datachars(a._1), b"\""]),
      ),
    ),
    b">",
  ])
}

/// The suite's first canonical form of a document, from its events.
fn canonical(data: Bytes) -> Bytes / {xml.refused, abort.raise} =
  bytes_concat_all(
    map(xml::events(data, limits()), |e: Event|
      match e {
        XmlDeclaration(_) -> b"",
        StartElement(s) -> start_tag(s),
        EndElement(n) -> bytes_concat_all([b"</", bytes_of_string(as_written(n)), b">"]),
        Characters(text) -> datachars(text),
        Aside(Comment(_)) -> b"",
        Aside(Instruction(target, text)) ->
          bytes_concat_all([b"<?", bytes_of_string(target), b" ", bytes_of_string(text), b"?>"]),
      }),
  )

/// Whether a document that reads is one `write` writes, reads back as the same tree, and writes
/// again as the same bytes.
fn round_trips(data: Bytes) -> Bool / {abort.raise} =
  match xml::parse(data, limits()) {
    Err(_) -> false,
    Ok(d) -> match xml::encode(d, Compact) {
      Err(_) -> false,
      Ok(written) -> match xml::parse(written, limits()) {
        Err(_) -> false,
        Ok(again) -> again == d && xml::encode(again, Compact) == Ok(written),
      },
    },
  }

/// Holds where `data` reads as the canonical form another parser made of it, or where none did.
fn reads_as(data: Bytes, expected: Option<Bytes>) -> Unit / {abort.raise} =
  match expected { Some(form) -> assert_eq(try { canonical(data) }, Ok(form)), None -> () }

test "refuses {c.name}" for c: Case in not_wf_plain() { assert(refused(c.bytes)) }

test "refuses {c.name} under its declaration" for c: Case in not_wf_declared() {
  assert(refused(c.bytes))
}

test "refuses {c.name}, with its declaration and without" for c: Case in not_wf_cut() {
  assert(refused(c.bytes));
  assert(refused(cut(c.bytes)))
}

test "refuses {c.name}, a document of our own" for c: Ours in ours() {
  assert_eq(why(c.text), Some(c.why))
}

test "reads {c.name} as another parser does, and writes what reads back as it" for c: Formed in wf_plain(
  ) {
  assert_eq(why(c.bytes), None);
  assert(round_trips(c.bytes));
  reads_as(c.bytes, c.canonical)
}

test "refuses the declaration of {c.name}" for c: Case in wf_declared() {
  assert_eq(why(c.bytes), Some(Doctype))
}

test "refuses the declaration of {c.name}, and reads it without as another parser does" for c: Formed in wf_cut(
  ) {
  assert_eq(why(c.bytes), Some(Doctype));
  assert_eq(why(cut(c.bytes)), None);
  assert(round_trips(cut(c.bytes)));
  reads_as(cut(c.bytes), c.canonical)
}

test "refuses the encoding of {c.name}" for c: Case in wf_encoded() {
  assert(match why(c.bytes) { Some(Encoding(_)) -> true, _ -> false })
}

test "refuses {c.name}, which no namespace reading admits" for c: Case in wf_unnamespaced() {
  assert(refused(c.bytes))
}
