// The hazard the compute-kernel record states as "no `Float` path", at its real width.
//
// Ordering on `String` is **not here**: it does not typecheck. `E0201` refuses
// `a < b` on `String` before any backend sees it, so the run-time support in
// `interp.rs` is unreachable from a well-typed program.
// `tests/fixtures/string_ordering/` holds the program and the refusal.

pub fn fadd(a: Float, b: Float) -> Float = a + b

pub fn fless(a: Float, b: Float) -> Bool = a < b

pub fn dadd(a: Decimal, b: Decimal) -> Decimal = a + b

pub fn dless(a: Decimal, b: Decimal) -> Bool = a < b

pub fn float_inside(n: Int) -> Int = if 1.5 + 1.5 > 2.0 { n } else { n * 2 }

pub fn decimal_inside(n: Int) -> Int = if 1.5m + 1.5m > 2.0m { n } else { n * 2 }

pub fn float_arith_inside(n: Int) -> Int = if 0.1 + 0.2 == 0.3 { n } else { n * 2 }
