// The arena hazard: a builtin called from compiled code would run against the
// fragment's private `TaskRegions` and skip `record_cell_access`.
//
// The shape the hazard audit names — `fn bump(c) = cell_set(c, cell_get(c) + 1)`,
// a `Cell` parameter and two bare-name builtins — **does not typecheck**. `E0304`
// refuses `cell_get`/`cell_set` anywhere but on the binder `with_cell[r](..) { c
// -> .. }` introduces, so a cell cannot be a parameter of a function that reads
// it, and the smallest program that reaches a cell at all opens the region
// itself. `tests/fixtures/cell_parameter/` holds that program and the refusal.
//
// What is left is this: an `Int` -> `Int` definition with an empty *published*
// row that opens its own region. `ply_eval::memo::pure_by_published_row` admits
// it and the machine offers it to a backend, which is exactly what `memo.rs`
// says out loud.

import pure

pub fn counted(n: Int) -> Int =
  with_cell[tally](0) { c -> {
    cell_set(c, pure::step(n));
    cell_set(c, cell_get(c) + pure::mix(n, 2));
    cell_get(c)
  } }

// The two abrupt exits from a `with_cell`, both of which jump past the close the
// emitter puts after the body: a failure that leaves the entry, and an unwind to
// a clause that binds `resume` and answers without it, after which the entry
// runs on and has to be balanced when it answers.

effect abort {
  write stop(code: Int) -> Int
}

pub fn failing(n: Int) -> Int =
  with_cell[held](n) { c -> {
    cell_set(c, pure::share(n, 0));
    cell_get(c)
  } }

pub fn abandoned(n: Int) -> Int =
  handle {
    with_cell[gone](n) { c -> {
      cell_set(c, cell_get(c) + 1);
      abort.stop(cell_get(c))
    } }
  } with {
    abort.stop(code) resume k -> 0 - code,
  }
