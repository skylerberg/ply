// Two classes the fragment used to accept at compile time and fail on at run
// time, and one it must never carry at all.
//
// `each` takes a callback and hands it to a builtin that calls user code;
// `total` builds its own lambda; `tripled` is `Int` -> `Int`, so nothing in its
// signature says a higher-order builtin is under it. `keyed` mints a
// `Value::Secret`, which is the value the secret invariant arms `argv`'s pool against
// and which the fragment's own `Ctx::slots` would retain for the life of the
// provider.

import pure

pub fn each(xs: List<Int>, f: (Int) -> Int) -> List<Int> = map(xs, f)

pub fn total(xs: List<Int>) -> Int = fold(xs, 0, |a, b| a + b)

pub fn tripled(n: Int) -> Int = total(each([n, n + 1], |x| pure::step(x)))

pub fn keyed(text: String) -> Secret<String> = secret_of_string(text)
