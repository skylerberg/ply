// A `simulate` region with a real race in it, and one compiled call outside it.

import pure

pub fn raced(n: Int) -> Int / {sim.read} = {
  let base = pure::step(n);
  with_cell[shared](base) { c -> {
    simulate {
      let a = task.spawn(|| cell_set(c, cell_get(c) + pure::step(n)));
      let b = task.spawn(|| cell_set(c, cell_get(c) + pure::mix(n, 3)));
      task.join(a);
      task.join(b);
      cell_get(c)
    }
  } }
}
