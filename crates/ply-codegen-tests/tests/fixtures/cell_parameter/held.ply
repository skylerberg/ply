// Not a program. The hazard audit's fourth case is
// `fn bump(c) = cell_set(c, cell_get(c) + 1)` — a `Cell` parameter, two
// bare-name builtins, locals and `Int` addition, and therefore "wholly inside
// the fragment". It is not a program: `E0304` refuses a `cell_get`/`cell_set`
// whose region cannot be named, which is every call not made on a `with_cell`
// binder.
//
// Kept as a fixture rather than as a sentence, per `CONTRIBUTING.md` §"Do not
// state a guarantee you have not armed". `tests/hazards.rs` loads it and asserts
// the refusal.

pub fn bump(c: Cell<Int>) -> Int = {
  cell_set(c, cell_get(c) + 1);
  cell_get(c)
}
