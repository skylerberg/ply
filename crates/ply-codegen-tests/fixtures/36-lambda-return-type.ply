// A lambda may write its return type and then takes a block body; `?` inside it reads that
// type. A written type with an expression body is E0001. (A `?` in a lambda without a written
// type is E0118, raised by the rewrite this comparison gives up on, so it is not exercised here.)
fn bump(r: Result<Int, String>) -> Result<Int, String> = {
  let inc = |x: Result<Int, String>| -> Result<Int, String> { Ok(x? + 1) };
  inc(r)
}
fn plain(xs: List<Int>) -> List<Int> = map(xs, |x| -> Int { x * 2 })
fn unbraced(x: Int) -> Int = (|y| -> Int y + 1)(x)
