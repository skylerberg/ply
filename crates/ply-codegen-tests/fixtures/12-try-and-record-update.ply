// `?` and `{..b, f: e}`, which became syntax after this spike was taken.
// Nothing here is expanded on either side: the comparison is against
// `ply_syntax::parse_unexpanded`, so an `ETry` meets an `ExprKind::Try`.
type E = {msg: String}
type A = Result<Int, E>

fn g(n: Int) -> A = Ok(n)
fn h(n: Int) -> Option<Int> = Some(n)

fn one(n: Int) -> A = Ok(g(n)?)
fn chained(n: Int) -> A = { let x = g(n)?; let y = g(x)?; Ok(x + y) }
fn option(n: Int) -> Option<Int> = { let x = h(n)?; Some(x) }
fn nested(n: Int) -> A = g(g(n)?)
fn branch(n: Int, c: Bool) -> A = if c { Ok(g(n)?) } else { Ok(0) }

// `?` binds tighter than a unary and tighter than any binary, and a call and a
// field access sit in the same loop with it.
fn under_unary(n: Int) -> A = Ok(-g(n)?)
fn under_binary(n: Int) -> A = Ok(g(n)? + g(n)?)
fn twice(n: Int) -> A = Ok(g(n)??)
fn then_field(r: {inner: A}) -> Int = 0

type R = {x: Int, y: Int}
type S = {inner: R}

fn replace(r: R) -> R = {..r, x: 1}
fn copy(r: R) -> R = {..r}
fn path(s: S) -> R = {..s.inner, y: 2, x: 3}
fn from_field(r: R) -> R = {..r, x: r.y}
fn shorthand(r: R, x: Int) -> R = {..r, x}
fn nested_update(s: S) -> S = {..s, inner: {..s.inner, x: 9}}

// Both at once, and inside every construct that has its own `no_brace` rule.
fn in_a_match(r: R, n: Int) -> R = match n { 0 -> {..r, x: 0}, _ -> r }
fn in_a_scrutinee(r: R) -> Int = if r.x == 1 { 1 } else { 2 }
fn in_a_list(r: R) -> List<R> = [{..r, x: 1}, {..r, y: 2}]
fn in_an_argument(r: R) -> R = path({inner: {..r, x: 4}})
