// `parallel { .. }` answers its branches as a tuple. `parallel` is a name where no `{` follows it,
// and in a scrutinee, where the `{` opens the arms. One branch is an error.
fn both(n: Int) -> (Int, Int) = parallel { n + 1, n * 2 }
fn three(n: Int) -> (Int, Bool, Int) = parallel {
  n,
  n > 0,
  parallel { n, n }._0,
}
fn named(parallel: Int) -> Int = parallel + 1
fn scrutinee(parallel: Bool) -> Int = if parallel { 1 } else { 0 }
fn alone(n: Int) -> Int = parallel { n }
