pub fn dep_json() -> json::JsonCodec<Dep> = {encode: |dv: Dep| json::object([{key: "name", value: (json::string_json().encode)(dv.name)}, {key: "prefix", value: (json::option_json(json::string_json()).encode)(dv.prefix)}, {key: "min", value: (version_json().encode)(dv.min)}, {key: "source", value: (source_json().encode)(dv.source)}]), decode: |dj: json::Json| match json::field(dj, "name", json::string_json()) {Err(de) -> Err(de), Ok(d0) -> match json::field(dj, "prefix", json::option_json(json::string_json())) {Err(de) -> Err(de), Ok(d1) -> match json::field(dj, "min", version_json()) {Err(de) -> Err(de), Ok(d2) -> match json::field(dj, "source", source_json()) {Err(de) -> Err(de), Ok(d3) -> Ok({name: d0, prefix: d1, min: d2, source: d3})}}}}}S;
