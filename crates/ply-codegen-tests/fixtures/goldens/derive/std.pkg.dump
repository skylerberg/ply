pub fn source_json() -> json::JsonCodec<Source> = {encode: |dv: Source| match dv {Path(d0) -> json::variant("Path", [(json::string_json().encode)(d0)]), Git(d0, d1) -> json::variant("Git", [(json::string_json().encode)(d0), (json::string_json().encode)(d1)]), Registry -> json::variant("Registry", [])}, decode: |dj: json::Json| match json::variant_of(dj) {Err(de) -> Err(de), Ok(dt) -> if dt.tag == "Path" {match json::decode_and_then(json::variant_value(dt, 0), json::string_json().decode) {Err(de) -> Err(de), Ok(d0) -> Ok(Path(d0))}} else {if dt.tag == "Git" {match json::decode_and_then(json::variant_value(dt, 0), json::string_json().decode) {Err(de) -> Err(de), Ok(d0) -> match json::decode_and_then(json::variant_value(dt, 1), json::string_json().decode) {Err(de) -> Err(de), Ok(d1) -> Ok(Git(d0, d1))}}} else {if dt.tag == "Registry" {Ok(Registry)} else {json::unknown_variant(dt.tag, ["Path", "Git", "Registry"])}}}}}S;
