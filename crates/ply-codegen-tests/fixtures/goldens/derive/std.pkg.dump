pub fn version_json() -> json::JsonCodec<Version> = {encode: |dv: Version| json::object([{key: "major", value: (json::int_json().encode)(dv.major)}, {key: "minor", value: (json::int_json().encode)(dv.minor)}, {key: "patch", value: (json::int_json().encode)(dv.patch)}]), decode: |dj: json::Json| match json::field(dj, "major", json::int_json()) {Err(de) -> Err(de), Ok(d0) -> match json::field(dj, "minor", json::int_json()) {Err(de) -> Err(de), Ok(d1) -> match json::field(dj, "patch", json::int_json()) {Err(de) -> Err(de), Ok(d2) -> Ok({major: d0, minor: d1, patch: d2})}}}}S;
