fn pair_json<x, y>(x: json::JsonCodec<x>, y: json::JsonCodec<y>) -> json::JsonCodec<Pair<x, y>> where derivable(json, x), derivable(json, y) = {encode: |dv: Pair<x, y>| json::object([{key: "left", value: (x.encode)(dv.left)}, {key: "right", value: (y.encode)(dv.right)}]), decode: |dj: json::Json| match json::field(dj, "left", x) {Err(de) -> Err(de), Ok(d0) -> match json::field(dj, "right", y) {Err(de) -> Err(de), Ok(d1) -> Ok({left: d0, right: d1})}}}D;
