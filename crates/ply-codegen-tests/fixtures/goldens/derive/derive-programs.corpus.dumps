fn order_json() -> json::JsonCodec<Order> = {encode: |dv: Order| json::object([{key: "id", value: (json::int_json().encode)(dv.id)}, {key: "name", value: (json::string_json().encode)(dv.name)}]), decode: |dj: json::Json| match json::field(dj, "id", json::int_json()) {Err(de) -> Err(de), Ok(d0) -> match json::field(dj, "name", json::string_json()) {Err(de) -> Err(de), Ok(d1) -> Ok({id: d0, name: d1})}}}D;
