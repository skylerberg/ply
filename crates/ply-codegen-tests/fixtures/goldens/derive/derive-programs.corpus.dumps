fn box_json<d>(d: json::JsonCodec<d>) -> json::JsonCodec<Box<d>> where derivable(json, d) = {encode: |d_v: Box<d>| json::object([{key: "item", value: (d.encode)(d_v.item)}]), decode: |d_j: json::Json| match json::field(d_j, "item", d) {Err(d_e) -> Err(d_e), Ok(d_0) -> Ok({item: d_0})}}D;
