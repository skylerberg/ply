fn shape_json() -> json::JsonCodec<Shape> = {encode: |dv: Shape| match dv {Circle(d0) -> json::variant("Circle", [(json::int_json().encode)(d0)]), Rect(d0, d1) -> json::variant("Rect", [(json::int_json().encode)(d0), (json::int_json().encode)(d1)]), Point -> json::variant("Point", [])}, decode: |dj: json::Json| match json::variant_of(dj) {Err(de) -> Err(de), Ok(dt) -> if dt.tag == "Circle" {match json::decode_and_then(json::variant_value(dt, 0), json::int_json().decode) {Err(de) -> Err(de), Ok(d0) -> Ok(Circle(d0))}} else {if dt.tag == "Rect" {match json::decode_and_then(json::variant_value(dt, 0), json::int_json().decode) {Err(de) -> Err(de), Ok(d0) -> match json::decode_and_then(json::variant_value(dt, 1), json::int_json().decode) {Err(de) -> Err(de), Ok(d1) -> Ok(Rect(d0, d1))}}} else {if dt.tag == "Point" {Ok(Point)} else {json::unknown_variant(dt.tag, ["Circle", "Rect", "Point"])}}}}}D;
0;

