// A comma inside parentheses makes a tuple: the record `{_0: a, _1: b}` in a type, an expression
// and a pattern. `(x)` still groups, two or more elements make a tuple, and `(A, B) -> C` is still a
// function.
fn divmod(a: Int, b: Int) -> (Int, Int) = (a / b, a % b)
fn swap(p: (Int, Bool)) -> (Bool, Int) = match p { (n, flag) -> (flag, n) }
fn grouped(x: Int) -> Int = (x + 1) * 2
fn apply(f: (Int, Int) -> Int, p: (Int, Int)) -> Int = match p { (a, b) -> f(a, b) }
fn unclosed(x: Int) -> (Int, Int) = (x, x
