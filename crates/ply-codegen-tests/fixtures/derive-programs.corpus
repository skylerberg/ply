Hand-written modules for the derive differential: every shape `crates/ply-derive/src/tests.rs`
exercises, each one module on its own. Modules are separated by a line holding exactly `%%`, and
the newline immediately before a separator belongs to the separator.

%%
import std.json
type Order = {id: Int, name: String}
derive json for Order
%%
import std.json
type Shape = Circle(Int) | Rect(Int, Int) | Point
derive json for Shape
%%
import std.json
type Line = {qty: Int}
type Order = {lines: List<Line>}
derive json for Order
%%
import std.json
import users
type Order = {who: users::User}
derive json for Order
%%
import std.json
type Pair<x, y> = {left: x, right: y}
derive json for Pair
%%
import std.json
pub type Order = {id: Int}
derive json for Order
%%
type Order = {id: Int}
derive eq for Order
derive ord for Order
%%
import std.json
type Box<d> = {item: d}
derive json for Box
%%
import std.json
type Bag = {a: Int, b: List<String>, c: Map<Int, Bytes>, d: Option<Int>}
type Shape = Circle(Int) | Rect(Int, Int)
derive json for Bag
derive eq for Bag
derive ord for Bag
derive json for Shape
