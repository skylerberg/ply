// Rows braced and bare, with a tail variable, resources, and a qualified effect.
fn a() -> Int / {} = 1
fn b() -> Int / {db.read} = 1
fn c() -> Int / {db.read[users], log.write} = 1
fn d<|e>() -> Int / {db.write[t] | e} = 1
fn e2<|e>() -> Int / e = 1
effect db { read read[r]() -> Int, put write(Int) -> () }
effect log { write write(Str) -> () }
